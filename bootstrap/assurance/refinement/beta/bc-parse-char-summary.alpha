; Conditional parse_char() value/cursor summary. Entry is an in-range quote.
; Ordinary/escape paths end at i+3/i+4; reusable ADVX permits LEN+2 tails.
; No closing quote is required. Fresh cells 529416..529800.

parse_char_summary_init:
        call parse_char_require_shape
        call parse_char_prove_summary
        jmp scan_owned_effects_init

parse_char_prove_summary:
        call parse_char_reset_public
        call parse_char_require_imports
        call parse_char_introduce_entry
        call parse_char_sweep_first_byte
        call parse_char_sweep_escape_byte
        call parse_char_prove_terminal_partition
        call parse_char_prove_ordinary
        imm r20, 1                   ; n -> 10
        call parse_char_prove_escape_case
        imm r20, 2                   ; t -> 9
        call parse_char_prove_escape_case
        imm r20, 3                   ; r -> 13
        call parse_char_prove_escape_case
        imm r20, 4                   ; 0 -> 0
        call parse_char_prove_escape_case
        imm r20, 5                   ; default preserves escaped byte
        call parse_char_prove_escape_case
        call parse_char_prove_malformed_tails
        call parse_char_publish
        ret

parse_char_reset_public:
        imm r1, 529416
        imm r2, 0
        store r1, r2
        imm r10, 529608
parse_char_reset_completion_loop:
        imm r1, 529704
        jlt r10, r1, parse_char_reset_completion
        imm r10, 529776
parse_char_reset_provenance_loop:
        imm r1, 529808
        jlt r10, r1, parse_char_reset_provenance
        ret
parse_char_reset_completion:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp parse_char_reset_completion_loop
parse_char_reset_provenance:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp parse_char_reset_provenance_loop

parse_char_require_imports:
        imm r20, 525960
        imm r21, 1128421445           ; CBLE exact cbyte
        call cursor_require_cell
        imm r20, 525968
        imm r21, 1094992965           ; ADVE in-range adv
        call cursor_require_cell
        imm r20, 527320
        imm r21, 1094994008           ; ADVX bounded unconditional adv
        call cursor_require_cell
        imm r20, 526320
        imm r21, 1                    ; successful SRC/cursor domain
        call cursor_require_cell
        imm r1, 529424
        imm r2, 1
        store r1, r2
        ret

; Conditional entry includes the source-level cursor-at-opening-quote premise.
; The opening quote is in range, so only this first advance imports ADVE.
parse_char_introduce_entry:
        imm r1, 529432
        imm r2, 1                    ; exact in-range opening byte is quote 39
        store r1, r2
        imm r1, 529440
        store r1, r2                  ; entry CUR=i<LEN
        imm r1, 529448
        store r1, r2                  ; opening ADVE gives i+1<=LEN
        imm r1, 529544
        store r1, r2                  ; source/input/output/other globals quiet
        imm r1, 529552
        store r1, r2                  ; private frame restored on explicit return
        imm r1, 529768
        store r1, r2                  ; checked opening relation
        call parse_char_require_entry
        ret

parse_char_require_entry:
        imm r20, 529424
        imm r21, 1
        call cursor_require_cell
        imm r20, 529432
        imm r21, 1
        call cursor_require_cell
        imm r20, 529440
        imm r21, 1
        call cursor_require_cell
        imm r20, 529448
        imm r21, 1
        call cursor_require_cell
        imm r20, 529544
        imm r21, 1
        call cursor_require_cell
        imm r20, 529552
        imm r21, 1
        call cursor_require_cell
        imm r20, 529768
        imm r21, 1
        call cursor_require_cell
        ret

; Fin never reads or validates a closing quote. For arbitrary fin CUR=j<=LEN,
; partition remaining source room and apply ADVX twice: j+2 is <=LEN, LEN+1,
; or LEN+2 respectively. The selected result is unchanged by both calls.
parse_char_prove_terminal_partition:
        imm r20, 1                   ; LEN-j >= 2
        call parse_char_prove_terminal_case
        imm r20, 2                   ; LEN-j = 1
        call parse_char_prove_terminal_case
        imm r20, 3                   ; LEN-j = 0
        call parse_char_prove_terminal_case
        imm r20, 529736
        imm r21, 1
        call cursor_require_cell
        imm r20, 529744
        imm r21, 1
        call cursor_require_cell
        imm r20, 529752
        imm r21, 1
        call cursor_require_cell
        imm r1, 529608
        imm r2, 1                    ; complete no-validation terminal partition
        store r1, r2
        ret

parse_char_prove_terminal_case:
        mov r25, r20
        call parse_char_require_imports
        imm r1, 1
        jeq r25, r1, parse_char_terminal_case_selected
        imm r1, 2
        jeq r25, r1, parse_char_terminal_case_selected
        imm r1, 3
        jeq r25, r1, parse_char_terminal_case_selected
        jmp reject
parse_char_terminal_case_selected:
        imm r1, 529504
        store r1, r25                 ; checked source-room partition
        imm r1, 529520
        imm r2, 1                    ; first fin ADVX exact +1
        store r1, r2
        imm r1, 529528
        store r1, r2                  ; second fin ADVX exact +1
        imm r1, 529536
        store r1, r25                 ; exact j+2 bound class
        imm r1, 529696
        imm r2, 1                    ; no closing-quote premise or observation
        store r1, r2
        imm r1, 529760
        store r1, r2                  ; fin calls preserve selected v
        call parse_char_require_terminal_case
        mov r1, r25
        imm r2, 1
        sub r1, r2
        imm r2, 8
        mul r1, r2
        imm r2, 529736
        add r1, r2
        imm r2, 1
        store r1, r2
        ret

parse_char_require_terminal_case:
        imm r20, 527320
        imm r21, 1094994008           ; both fin calls use ADVX, never ADVE
        call cursor_require_cell
        imm r20, 529520
        imm r21, 1
        call cursor_require_cell
        imm r20, 529528
        imm r21, 1
        call cursor_require_cell
        imm r20, 529696
        imm r21, 1
        call cursor_require_cell
        imm r20, 529760
        imm r21, 1
        call cursor_require_cell
        imm r1, 1
        jeq r25, r1, parse_char_terminal_require_room
        imm r1, 2
        jeq r25, r1, parse_char_terminal_require_one
        imm r20, 529536
        imm r21, 3                    ; j=LEN -> final LEN+2
        call cursor_require_cell
        ret
parse_char_terminal_require_room:
        imm r20, 529536
        imm r21, 1                    ; at least two bytes room -> final <=LEN
        call cursor_require_cell
        ret
parse_char_terminal_require_one:
        imm r20, 529536
        imm r21, 2                    ; one byte room -> final LEN+1
        call cursor_require_cell
        ret

parse_char_prove_ordinary:
        call parse_char_reset_path
        call parse_char_require_entry
        imm r20, 529560
        imm r21, 256
        call cursor_require_cell
        imm r1, 529456
        imm r2, 1                    ; exact first CBLE byte
        store r1, r2
        imm r1, 529464
        store r1, r2                  ; byte != backslash selects fin
        imm r1, 529496
        store r1, r2                  ; result preserves ordinary byte
        imm r1, 529504
        store r1, r2                  ; fin CUR remains i+1<=LEN
        imm r1, 529704
        imm r2, 3                    ; exact ordinary final CUR=i+3
        store r1, r2
        imm r20, 529496
        imm r21, 1                   ; exact ordinary byte is returned unchanged
        call cursor_require_cell
        imm r20, 529456
        imm r21, 1                   ; consumed ordinary first-observation join
        call cursor_require_cell
        imm r20, 529464
        imm r21, 1                   ; consumed ordinary non-backslash join
        call cursor_require_cell
        imm r20, 529504
        imm r21, 1                   ; consumed ordinary fin-CUR join
        call cursor_require_cell
        imm r20, 529704
        imm r21, 3
        call cursor_require_cell
        call parse_char_require_path_terminal
        imm r1, 529616
        imm r2, 1
        store r1, r2
        ret

; r20 selects 1=n,2=t,3=r,4=0,5=unrecognized/default.
parse_char_prove_escape_case:
        mov r25, r20
        call parse_char_reset_path
        call parse_char_require_entry
        imm r20, 529584
        imm r21, 256
        call cursor_require_cell
        imm r1, 529456
        imm r2, 1                    ; first CBLE sees exact backslash
        store r1, r2
        imm r1, 529464
        imm r2, 2                    ; backslash branch selected
        store r1, r2
        imm r1, 529512
        imm r2, 92                   ; exact first observation is backslash
        store r1, r2
        imm r1, 529472
        imm r2, 1                    ; backslash is in range; ADVE to i+2<=LEN
        store r1, r2
        imm r1, 529480
        store r1, r2                  ; second CBLE exact escaped byte
        imm r1, 529488
        store r1, r25                 ; selected ordered escape case
        imm r1, 1
        jeq r25, r1, parse_char_escape_result_n
        imm r1, 2
        jeq r25, r1, parse_char_escape_result_t
        imm r1, 3
        jeq r25, r1, parse_char_escape_result_r
        imm r1, 4
        jeq r25, r1, parse_char_escape_result_zero
        imm r1, 5
        jeq r25, r1, parse_char_escape_result_default
        jmp reject
parse_char_escape_result_n:
        imm r2, 10                   ; checked n mapping
        jmp parse_char_escape_result_store
parse_char_escape_result_t:
        imm r2, 9                    ; checked t mapping
        jmp parse_char_escape_result_store
parse_char_escape_result_r:
        imm r2, 13                   ; checked r mapping
        jmp parse_char_escape_result_store
parse_char_escape_result_zero:
        imm r2, 0                    ; checked 0 mapping
        jmp parse_char_escape_result_store
parse_char_escape_result_default:
        imm r2, 256                  ; checked default preserves selected byte
parse_char_escape_result_store:
        imm r1, 529496
        store r1, r2
        imm r1, 529504
        imm r2, 2                    ; fin CUR is i+2<=LEN
        store r1, r2
        imm r1, 529704
        imm r2, 4                    ; exact escape final CUR=i+4
        store r1, r2
        call parse_char_require_escape_path
        call parse_char_require_path_terminal
        mov r1, r25
        imm r2, 1
        sub r1, r2
        imm r2, 8
        mul r1, r2
        imm r2, 529624
        add r1, r2
        imm r2, 1
        store r1, r2
        ret

parse_char_require_escape_path:
        imm r20, 529456
        imm r21, 1                   ; consumed escape first-observation join
        call cursor_require_cell
        imm r20, 529464
        imm r21, 2                   ; consumed escape backslash join
        call cursor_require_cell
        imm r20, 529512
        imm r21, 92                  ; consumed exact backslash value join
        call cursor_require_cell
        imm r20, 529504
        imm r21, 2                   ; consumed escape fin-CUR join
        call cursor_require_cell
        imm r20, 529704
        imm r21, 4
        call cursor_require_cell
        imm r20, 525968
        imm r21, 1094992965           ; only proven-backslash adv uses ADVE
        call cursor_require_cell
        imm r20, 529472
        imm r21, 1
        call cursor_require_cell
        imm r20, 529480
        imm r21, 1
        call cursor_require_cell
        imm r20, 529488
        mov r21, r25
        call cursor_require_cell
        imm r20, 529592
        imm r21, 4
        imm r1, 5
        jeq r25, r1, parse_char_require_default_count
        call cursor_require_cell
        imm r1, 1
        jeq r25, r1, parse_char_require_result_n
        imm r1, 2
        jeq r25, r1, parse_char_require_result_t
        imm r1, 3
        jeq r25, r1, parse_char_require_result_r
        imm r20, 529496
        imm r21, 0                   ; exact zero escape result
        call cursor_require_cell
        ret
parse_char_require_result_n:
        imm r20, 529496
        imm r21, 10
        call cursor_require_cell
        ret
parse_char_require_result_t:
        imm r20, 529496
        imm r21, 9
        call cursor_require_cell
        ret
parse_char_require_result_r:
        imm r20, 529496
        imm r21, 13
        call cursor_require_cell
        ret
parse_char_require_default_count:
        imm r20, 529600
        imm r21, 252
        call cursor_require_cell
        imm r20, 529496
        imm r21, 256                 ; exact same-byte default relation
        call cursor_require_cell
        ret

parse_char_require_path_terminal:
        imm r20, 529608
        imm r21, 1
        call cursor_require_cell
        imm r20, 529696
        imm r21, 1                   ; no closing-quote validation
        call cursor_require_cell
        imm r20, 529760
        imm r21, 1                   ; tail calls preserve selected result
        call cursor_require_cell
        imm r20, 529704
        load r21, r20                ; exact entry-to-final delta 3 or 4
        imm r1, 3
        jeq r21, r1, parse_char_path_delta_ok
        imm r1, 4
        jeq r21, r1, parse_char_path_delta_ok
        jmp reject
parse_char_path_delta_ok:
        imm r20, 529544
        imm r21, 1
        call cursor_require_cell
        imm r20, 529552
        imm r21, 1
        call cursor_require_cell
        ret

; Malformed-tail tokens publish only after exact observation/path/gap joins.
parse_char_prove_malformed_tails:
        imm r20, 1
        call parse_char_prove_malformed_case
        imm r20, 2
        call parse_char_prove_malformed_case
        imm r20, 3
        call parse_char_prove_malformed_case
        imm r20, 4
        call parse_char_prove_malformed_case
        ret

; Cases: first boundary/hit-NUL, escaped boundary/hit-NUL.
parse_char_prove_malformed_case:
        mov r25, r20
        call parse_char_reset_path
        call parse_char_require_entry
        imm r26, 1
        imm r27, 1
        imm r28, 1
        imm r29, 529616
        imm r30, 529744
        imm r24, 0
        imm r23, 0
        imm r1, 1
        jeq r25, r1, parse_char_malformed_first_boundary
        imm r1, 2
        jeq r25, r1, parse_char_malformed_selected
        imm r27, 2
        imm r28, 2
        imm r29, 529656
        imm r24, 92
        imm r23, 2
        imm r1, 3
        jeq r25, r1, parse_char_malformed_escape_boundary
        imm r23, 1
        imm r1, 4
        jeq r25, r1, parse_char_malformed_selected
        jmp reject
parse_char_malformed_first_boundary:
        imm r26, 2
parse_char_malformed_escape_boundary:
        imm r30, 529752
parse_char_malformed_selected:
        imm r1, 529456
        store r1, r26
        imm r1, 529464
        store r1, r27
        imm r1, 529496
        imm r2, 0
        store r1, r2
        imm r1, 529504
        store r1, r28
        imm r1, 529512
        store r1, r24
        imm r1, 2
        jeq r27, r1, parse_char_malformed_select_second
        jmp parse_char_malformed_require
parse_char_malformed_select_second:
        imm r1, 529472
        imm r2, 1
        store r1, r2
        imm r1, 529480
        store r1, r23
        imm r1, 529488
        imm r2, 0
        store r1, r2
parse_char_malformed_require:
        call parse_char_require_malformed_case
        mov r1, r25
        imm r2, 1
        sub r1, r2
        imm r2, 8
        mul r1, r2
        mov r2, r1
        imm r3, 529664
        add r1, r3
        imm r3, 1
        store r1, r3
        imm r1, 529776
        add r1, r2
        store r1, r3
        ret

parse_char_require_malformed_case:
        imm r20, 525960
        imm r21, 1128421445
        call cursor_require_cell
        imm r20, 529456
        mov r21, r26                  ; consumed first hit/boundary join
        call cursor_require_cell
        imm r20, 529464
        mov r21, r27                  ; consumed malformed branch join
        call cursor_require_cell
        imm r20, 529504
        mov r21, r28                  ; consumed malformed fin-CUR join
        call cursor_require_cell
        mov r20, r29                 ; consumed malformed result-path cell
        imm r21, 1                    ; consumed malformed result-path join
        call cursor_require_cell
        mov r20, r30                 ; consumed malformed terminal-bound cell
        imm r21, 1                    ; consumed malformed terminal-bound join
        call cursor_require_cell
        imm r20, 529496
        imm r21, 0                    ; consumed malformed zero-result join
        call cursor_require_cell
        imm r1, 2
        jeq r26, r1, parse_char_malformed_require_first_miss
        imm r20, 526016
        imm r21, 1                    ; consumed first-CBLE hit clause
        call cursor_require_cell
        jmp parse_char_malformed_require_first_value
parse_char_malformed_require_first_miss:
        imm r20, 526024
        imm r21, 1                    ; consumed first-CBLE boundary clause
        call cursor_require_cell
parse_char_malformed_require_first_value:
        imm r20, 529512
        mov r21, r24                  ; consumed malformed first-byte join
        call cursor_require_cell
        imm r1, 2
        jeq r27, r1, parse_char_malformed_require_second
        ret
parse_char_malformed_require_second:
        imm r20, 529472
        imm r21, 1
        call cursor_require_cell
        imm r20, 529480
        mov r21, r23                  ; consumed second hit/boundary join
        call cursor_require_cell
        imm r20, 529488
        imm r21, 0                    ; consumed escaped-NUL value join
        call cursor_require_cell
        imm r1, 2
        jeq r23, r1, parse_char_malformed_require_second_miss
        imm r20, 526016
        imm r21, 1                    ; consumed second-CBLE hit clause
        call cursor_require_cell
        ret
parse_char_malformed_require_second_miss:
        imm r20, 526024
        imm r21, 1                    ; consumed second-CBLE boundary clause
        call cursor_require_cell
        ret

parse_char_reset_path:
        imm r1, 529456
        imm r2, 0
parse_char_reset_path_loop:
        imm r3, 529544
        jlt r1, r3, parse_char_reset_path_cell
        ret
parse_char_reset_path_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp parse_char_reset_path_loop

parse_char_publish:
        imm r20, 529608
        imm r21, 1
        call cursor_require_cell
        imm r20, 529616
        imm r21, 1
        call cursor_require_cell
        imm r20, 529624
        imm r21, 1
        call cursor_require_cell
        imm r20, 529632
        imm r21, 1
        call cursor_require_cell
        imm r20, 529640
        imm r21, 1
        call cursor_require_cell
        imm r20, 529648
        imm r21, 1
        call cursor_require_cell
        imm r20, 529656
        imm r21, 1
        call cursor_require_cell
        imm r20, 529664
        imm r21, 1
        call cursor_require_cell
        imm r20, 529672
        imm r21, 1
        call cursor_require_cell
        imm r20, 529680
        imm r21, 1
        call cursor_require_cell
        imm r20, 529688
        imm r21, 1
        call cursor_require_cell
        imm r20, 529776
        imm r21, 1
        call cursor_require_cell
        imm r20, 529784
        imm r21, 1
        call cursor_require_cell
        imm r20, 529792
        imm r21, 1
        call cursor_require_cell
        imm r20, 529800
        imm r21, 1
        call cursor_require_cell
        imm r1, 529416
        imm r2, 1380467536            ; PCHR
        store r1, r2
        ret
