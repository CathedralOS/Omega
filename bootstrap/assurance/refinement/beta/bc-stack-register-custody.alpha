; Unified explicit-stack register custody for exact bc.
;
; Earlier phases validate each constituent macro against independently parsed
; source tables.  This phase transfers those results into one fresh per-PC map,
; rejecting duplicate owners, then independently scans every decoded Alpha
; instruction.  The map must equal precisely the union of instructions which
; write r14/r15 or access memory through r15.
;
; Owner map: 10354688 (one byte per tape pc).
; Counters: 525104 owner/union, 525120 writes-r14, 525128 writes-r15,
; 525136 memory-through-r15.

stack_register_custody_init:
        imm r0, 0
        imm r1, 525104
        store r1, r0
        imm r1, 525112
        store r1, r0
        imm r1, 525120
        store r1, r0
        imm r1, 525128
        store r1, r0
        imm r1, 525136
        store r1, r0

        ; Compiler prelude: explicit stack pointer and frame pointer.
        imm r0, 0
        call stack_owner_mark
        imm r0, 10
        call stack_owner_mark
        jmp stack_owner_prologues_init

; Derive the three base prologue effects and optional allocation from each
; independently validated source entry block.
stack_owner_prologues_init:
        imm r10, 0
stack_owner_prologues_loop:
        imm r1, 355
        jlt r10, r1, stack_owner_prologue_candidate
        jmp stack_owner_fallthrough_init
stack_owner_prologue_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, stack_owner_prologue_entry
        jmp stack_owner_prologue_next
stack_owner_prologue_entry:
        imm r1, 3235840
        add r1, r12
        load r6, r1
        mov r0, r6
        imm r1, 10
        add r0, r1
        call stack_owner_mark           ; sub r15,r5
        mov r0, r6
        imm r1, 13
        add r0, r1
        call stack_owner_mark           ; store r15,r14
        mov r0, r6
        imm r1, 16
        add r0, r1
        call stack_owner_mark           ; mov r14,r15

        imm r1, 3145728
        add r1, r12
        load r2, r1                     ; source procedure index
        imm r1, 8
        mul r2, r1
        imm r1, 7159808
        add r1, r2
        load r3, r1                     ; total slots
        imm r1, 0
        jeq r3, r1, stack_owner_prologue_next
        mov r0, r6
        imm r1, 29
        add r0, r1
        call stack_owner_mark           ; optional sub r15,r5
stack_owner_prologue_next:
        imm r1, 1
        add r10, r1
        jmp stack_owner_prologues_loop

; Derive the compiler-synthesized final epilogue for each procedure region.
stack_owner_fallthrough_init:
        imm r10, 0
stack_owner_fallthrough_loop:
        imm r1, 355
        jlt r10, r1, stack_owner_fallthrough_candidate
        jmp stack_owner_return_events_init
stack_owner_fallthrough_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, stack_owner_find_next_proc_init
        jmp stack_owner_fallthrough_next
stack_owner_find_next_proc_init:
        mov r11, r10
        imm r1, 1
        add r11, r1
stack_owner_find_next_proc:
        imm r1, 355
        jlt r11, r1, stack_owner_find_next_proc_candidate
        imm r1, 524296
        load r14, r1
        jmp stack_owner_fallthrough_end
stack_owner_find_next_proc_candidate:
        mov r13, r11
        imm r1, 8
        mul r13, r1
        imm r1, 3178496
        add r1, r13
        load r2, r1
        imm r3, 0
        jeq r2, r3, stack_owner_next_proc_found
        imm r1, 1
        add r11, r1
        jmp stack_owner_find_next_proc
stack_owner_next_proc_found:
        imm r1, 3235840
        add r1, r13
        load r14, r1
stack_owner_fallthrough_end:
        imm r1, 1
        sub r14, r1                    ; final ret pc
        call stack_owner_mark_epilogue
stack_owner_fallthrough_next:
        imm r1, 1
        add r10, r1
        jmp stack_owner_fallthrough_loop

; Source return events supply the other 183 checked epilogues.
stack_owner_return_events_init:
        imm r10, 0
stack_owner_return_events_loop:
        imm r1, 613
        jlt r10, r1, stack_owner_return_event
        jmp stack_owner_pushes_init
stack_owner_return_event:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7086080
        add r1, r12
        load r2, r1
        imm r3, 5
        jeq r2, r3, stack_owner_return_event_mark
        jmp stack_owner_return_event_next
stack_owner_return_event_mark:
        imm r1, 7135232
        add r1, r12
        load r14, r1                   ; ret pc
        call stack_owner_mark_epilogue
stack_owner_return_event_next:
        imm r1, 1
        add r10, r1
        jmp stack_owner_return_events_loop

; Every previously owned push contributes its sub and store starts.
stack_owner_pushes_init:
        imm r10, 0
stack_owner_pushes_loop:
        imm r1, 403
        jlt r10, r1, stack_owner_push
        jmp stack_owner_binary_pops_init
stack_owner_push:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 9453568
        add r1, r12
        load r6, r1
        mov r0, r6
        imm r1, 9461760
        call stack_require_existing_owner
        mov r0, r6
        imm r1, 10
        add r0, r1
        call stack_owner_mark           ; sub r15,r2
        mov r0, r6
        imm r1, 13
        add r0, r1
        call stack_owner_mark           ; store r15,r0
        imm r1, 1
        add r10, r1
        jmp stack_owner_pushes_loop

; Arithmetic/comparison primitive roots contribute their load/add pop pair.
stack_owner_binary_pops_init:
        imm r10, 0
stack_owner_binary_pops_loop:
        imm r1, 816
        jlt r10, r1, stack_owner_binary_pop_candidate
        jmp stack_owner_call_pops_init
stack_owner_binary_pop_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 8396800
        add r1, r12
        load r2, r1
        imm r3, 2
        jeq r2, r3, stack_owner_binary_pop
        imm r3, 3
        jeq r2, r3, stack_owner_binary_pop
        jmp stack_owner_binary_pop_next
stack_owner_binary_pop:
        imm r1, 8413184
        add r1, r12
        load r6, r1
        mov r0, r6
        imm r1, 8421376
        call stack_require_existing_owner
        mov r0, r6
        imm r1, 3
        add r0, r1
        call stack_owner_mark           ; load r0,r15
        mov r0, r6
        imm r1, 16
        add r0, r1
        call stack_owner_mark           ; add r15,r5
stack_owner_binary_pop_next:
        imm r1, 1
        add r10, r1
        jmp stack_owner_binary_pops_loop

; Ordinary call event roots and checked arities determine every pre-call pop.
stack_owner_call_pops_init:
        imm r10, 0
stack_owner_call_pops_loop:
        imm r1, 613
        jlt r10, r1, stack_owner_call_pop_candidate
        jmp stack_owner_store_pops_init
stack_owner_call_pop_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7086080
        add r1, r12
        load r2, r1
        imm r3, 1
        jeq r2, r3, stack_owner_call_pop_setup
        jmp stack_owner_call_pop_next
stack_owner_call_pop_setup:
        imm r1, 7143424
        add r1, r12
        load r11, r1                   ; arity
        imm r1, 7135232
        add r1, r12
        load r6, r1                     ; call pc
        mov r0, r6
        imm r1, 6815744
        call stack_require_existing_owner
        mov r7, r11
        imm r1, 16
        mul r7, r1
        sub r6, r7                     ; first pop pc
stack_owner_call_pop_loop:
        imm r1, 0
        jlt r1, r11, stack_owner_call_pop
        jmp stack_owner_call_pop_next
stack_owner_call_pop:
        mov r0, r6
        call stack_owner_mark           ; load rK,r15
        mov r0, r6
        imm r1, 13
        add r0, r1
        call stack_owner_mark           ; add r15,r5
        imm r1, 16
        add r6, r1
        imm r1, 1
        sub r11, r1
        jmp stack_owner_call_pop_loop
stack_owner_call_pop_next:
        imm r1, 1
        add r10, r1
        jmp stack_owner_call_pops_loop

; Raw store roots determine the 34 address-pop pairs.
stack_owner_store_pops_init:
        imm r10, 0
stack_owner_store_pops_loop:
        imm r1, 95
        jlt r10, r1, stack_owner_store_pop_candidate
        jmp stack_owner_count
stack_owner_store_pop_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7610368
        add r1, r12
        load r2, r1
        imm r3, 2
        jeq r2, r3, stack_owner_store_pop
        jmp stack_owner_store_pop_next
stack_owner_store_pop:
        imm r1, 7626752
        add r1, r12
        load r6, r1
        mov r0, r6
        imm r1, 7634944
        call stack_require_existing_owner
        imm r1, 16
        sub r6, r1
        mov r0, r6
        call stack_owner_mark           ; load r1,r15
        mov r0, r6
        imm r1, 13
        add r0, r1
        call stack_owner_mark           ; add r15,r5
stack_owner_store_pop_next:
        imm r1, 1
        add r10, r1
        jmp stack_owner_store_pops_loop

stack_owner_count:
        imm r1, 525104
        load r2, r1
        imm r3, 2630
        jeq r2, r3, stack_scan_init
        jmp reject

; r14 is a checked ret pc. Mark mov/load/add instruction starts.
stack_owner_mark_epilogue:
        mov r0, r14
        imm r1, 19
        sub r0, r1
        call stack_owner_mark
        mov r0, r14
        imm r1, 16
        sub r0, r1
        call stack_owner_mark
        mov r0, r14
        imm r1, 3
        sub r0, r1
        call stack_owner_mark
        ret

; Mark decoded instruction start r0 exactly once.
stack_owner_mark:
        imm r1, 524296
        load r2, r1
        jlt r0, r2, stack_owner_mark_covered
        jmp reject
stack_owner_mark_covered:
        imm r1, 4194304
        add r1, r0
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, stack_owner_mark_unique
        jmp reject
stack_owner_mark_unique:
        imm r1, 10354688
        add r1, r0
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, stack_owner_mark_store
        jmp reject
stack_owner_mark_store:
        imm r2, 1
        storeb r1, r2
        imm r1, 525104
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Require that an earlier responsibility-specific phase owned pc r0 in map r1.
stack_require_existing_owner:
        add r1, r0
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, stack_existing_owner_ok
        jmp reject
stack_existing_owner_ok:
        ret

; Used only by the focused gate's underreported-owner diagnostic projection.
stack_owner_skip_mark:
        ret

; Independently classify every decoded start. Flags are r20 writes-r14,
; r21 writes-r15, and r22 memory-through-r15.
stack_scan_init:
        imm r10, 0
stack_scan_loop:
        imm r1, 524296
        load r2, r1
        jlt r10, r2, stack_scan_pc
        jmp stack_scan_counts
stack_scan_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, stack_scan_start
        jmp stack_scan_next
stack_scan_start:
        imm r20, 0
        imm r21, 0
        imm r22, 0
        imm r1, 2097152
        add r1, r10
        loadb r7, r1                   ; opcode
        imm r1, 1
        jeq r7, r1, stack_scan_imm
        imm r1, 2
        jeq r7, r1, stack_scan_rr
        imm r1, 3
        jeq r7, r1, stack_scan_rr
        imm r1, 4
        jeq r7, r1, stack_scan_rr
        imm r1, 5
        jeq r7, r1, stack_scan_rr
        imm r1, 6
        jeq r7, r1, stack_scan_rr
        imm r1, 7
        jeq r7, r1, stack_scan_rr
        imm r1, 8
        jeq r7, r1, stack_scan_rr
        imm r1, 9
        jeq r7, r1, stack_scan_store
        imm r1, 10
        jeq r7, r1, stack_scan_rr
        imm r1, 11
        jeq r7, r1, stack_scan_store
        imm r1, 17
        jeq r7, r1, stack_scan_read
        jmp stack_scan_classified
stack_scan_imm:
        call stack_scan_load_operand_one
        call stack_scan_write_register
        jmp stack_scan_classified
stack_scan_read:
        call stack_scan_load_operand_one
        call stack_scan_write_register
        jmp stack_scan_classified
stack_scan_rr:
        call stack_scan_load_operands
        mov r4, r8
        call stack_scan_write_register
        imm r1, 8
        jeq r7, r1, stack_scan_load_address
        imm r1, 10
        jeq r7, r1, stack_scan_load_address
        jmp stack_scan_classified
stack_scan_load_address:
        imm r1, 15
        jeq r9, r1, stack_scan_set_memory
        jmp stack_scan_classified
stack_scan_store:
        call stack_scan_load_operand_one
        imm r1, 15
        jeq r8, r1, stack_scan_set_memory
        jmp stack_scan_classified
stack_scan_set_memory:
        imm r22, 1
        jmp stack_scan_classified

; r4 is the destination register.
stack_scan_write_register:
        imm r1, 14
        jeq r4, r1, stack_scan_set_write14
        imm r1, 15
        jeq r4, r1, stack_scan_set_write15
        ret
stack_scan_set_write14:
        imm r20, 1
        ret
stack_scan_set_write15:
        imm r21, 1
        ret

stack_scan_load_operand_one:
        imm r1, 2097153
        add r1, r10
        loadb r8, r1
        mov r4, r8
        ret
stack_scan_load_operands:
        call stack_scan_load_operand_one
        imm r1, 2097154
        add r1, r10
        loadb r9, r1
        ret

stack_scan_classified:
        imm r1, 10354688
        add r1, r10
        loadb r8, r1                   ; derived owner bit
        imm r1, 0
        jlt r1, r20, stack_scan_relevant
        jlt r1, r21, stack_scan_relevant
        jlt r1, r22, stack_scan_relevant
        jeq r8, r1, stack_scan_next
        jmp reject                     ; owner for an irrelevant instruction
stack_scan_relevant:
        imm r1, 1
        jeq r8, r1, stack_scan_count_union
        jmp reject                     ; orphan stack effect
stack_scan_count_union:
        imm r1, 525112
        call stack_scan_increment
        imm r1, 0
        jlt r1, r20, stack_scan_count_write14
        jmp stack_scan_maybe_write15
stack_scan_count_write14:
        imm r1, 525120
        call stack_scan_increment
stack_scan_maybe_write15:
        imm r1, 0
        jlt r1, r21, stack_scan_count_write15
        jmp stack_scan_maybe_memory
stack_scan_count_write15:
        imm r1, 525128
        call stack_scan_increment
stack_scan_maybe_memory:
        imm r1, 0
        jlt r1, r22, stack_scan_count_memory
        jmp stack_scan_next
stack_scan_count_memory:
        imm r1, 525136
        call stack_scan_increment
stack_scan_next:
        imm r1, 1
        add r10, r1
        jmp stack_scan_loop

stack_scan_increment:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

stack_scan_counts:
        imm r1, 525112
        load r2, r1
        imm r3, 2630
        jeq r2, r3, stack_scan_write14_count
        jmp reject
stack_scan_write14_count:
        imm r1, 525120
        load r2, r1
        imm r3, 324
        jeq r2, r3, stack_scan_write15_count
        jmp reject
stack_scan_write15_count:
        imm r1, 525128
        load r2, r1
        imm r3, 1430
        jeq r2, r3, stack_scan_memory_count
        jmp reject
stack_scan_memory_count:
        imm r1, 525136
        load r2, r1
        imm r3, 1129
        jeq r2, r3, ranged_bounds_init
        jmp reject
