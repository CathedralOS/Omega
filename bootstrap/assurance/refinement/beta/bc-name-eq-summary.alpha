; Conditional exact semantic summary for procedure35 name_eq(i).
;
; Under NTDM's NPFX/QNAME and 0<=i<n premises, NEQS returns one iff the
; selected table slice and current identifier slice have equal lengths and
; equal bytes. Length mismatch short-circuits before NAMEOFF/SRC loads. Equal
; lengths use the invariant that bytes [0,k) match and natural rank len-k;
; unequal selected bytes return zero, equal bytes advance k exactly once, and
; k=len returns one. Empty slices and duplicate names are admitted.
;
; Cells 531952..532128; reset endpoint / next fresh cell 532136.

name_eq_summary_init:
        call name_eq_require_shape
        call name_eq_require_data_shape
        call name_eq_require_imports
        call name_eq_summary_reset
        call name_eq_introduce_entry
        call name_eq_prove_length_mismatch
        call name_eq_introduce_equal_length
        call name_eq_prove_byte_mismatch
        call name_eq_prove_equal_step
        call name_eq_prove_full_match
        call name_eq_publish
        jmp scan_owned_effects_init

name_eq_require_imports:
        imm r20, 531848
        imm r21, 1296323662           ; NTDM
        call exact_require_cell
        call name_table_require_relations
        ret

name_eq_summary_reset:
        imm r10, 531952
name_eq_summary_reset_loop:
        imm r1, 532136
        jlt r10, r1, name_eq_summary_reset_cell
        ret
name_eq_summary_reset_cell:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp name_eq_summary_reset_loop

name_eq_introduce_entry:
        imm r1, 531960
        imm r2, 1
        store r1, r2                  ; exact proc35 entry / selected i
        imm r1, 532088
        store r1, r2                  ; carried proc35 state/trace quiet
        imm r1, 532096
        store r1, r2                  ; checked 48-byte caller-frame relation
        ret

name_eq_reset_case:
        imm r20, 531960
        imm r21, 1
        call exact_require_cell
        imm r1, 531968
        imm r2, 0
        store r1, r2
        imm r1, 532008
        store r1, r2
        imm r1, 532016
        store r1, r2
        imm r1, 532024
        store r1, r2
        imm r1, 532032
        store r1, r2
        imm r1, 532040
        store r1, r2
        imm r1, 532080
        store r1, r2
        imm r1, 532104
        store r1, r2
        imm r1, 532112
        store r1, r2
        imm r1, 532120
        store r1, r2
        imm r1, 532128
        store r1, r2
        ret

; Exact chk guard false: NAMELEN[i] != IDLEN, return zero immediately.
name_eq_prove_length_mismatch:
        call name_eq_reset_case
        imm r1, 531968
        imm r2, 1
        store r1, r2                  ; exact unequal-length edge
        imm r1, 532104
        store r1, r2                  ; no NAMEOFF or SRC payload access
        imm r1, 532080
        store r1, r2                  ; exact result zero
        call name_eq_require_length_mismatch
        imm r1, 532048
        imm r2, 1
        store r1, r2
        ret

name_eq_require_length_mismatch:
        call name_eq_require_common
        imm r20, 531968
        imm r21, 1
        call exact_require_cell
        imm r20, 532104
        imm r21, 1                    ; consumed short-circuit footprint
        call exact_require_cell
        imm r20, 532080
        imm r21, 1                    ; zero
        call exact_require_cell
        ret

; Exact chk guard true loads a/b/len, initializes k=0 and empty equal prefix.
name_eq_introduce_equal_length:
        imm r1, 531968
        imm r2, 2
        store r1, r2                  ; NAMELEN[i] == IDLEN
        imm r1, 531976
        imm r2, 1
        store r1, r2                  ; loop invariant
        imm r1, 531984
        store r1, r2                  ; 0<=k<=len, initially k=0
        imm r1, 531992
        store r1, r2                  ; natural rank len-k
        imm r1, 532000
        store r1, r2                  ; exact equal prefix [0,k), initially empty
        call name_eq_require_invariant
        ret

name_eq_reset_iteration:
        call name_eq_require_invariant
        imm r1, 532008
        imm r2, 0
        store r1, r2
        imm r1, 532016
        store r1, r2
        imm r1, 532024
        store r1, r2
        imm r1, 532032
        store r1, r2
        imm r1, 532040
        store r1, r2
        imm r1, 532080
        store r1, r2
        imm r1, 532112
        store r1, r2
        imm r1, 532120
        store r1, r2
        ret

; True k<len plus unequal bytes returns zero at the first mismatch.
name_eq_prove_byte_mismatch:
        call name_eq_reset_iteration
        call name_eq_select_body_bytes
        imm r1, 532016
        imm r2, 1
        store r1, r2                  ; exact byte inequality
        imm r1, 532080
        store r1, r2                  ; exact result zero
        call name_eq_require_mismatch
        imm r1, 532056
        imm r2, 1
        store r1, r2
        ret

name_eq_require_mismatch:
        call name_eq_require_body
        imm r20, 532016
        imm r21, 1
        call exact_require_cell
        imm r20, 532080
        imm r21, 1
        call exact_require_cell
        ret

; True k<len plus equal bytes increments k, decreases len-k by one, and
; capture-avoidantly renames the successor into the loop invariant.
name_eq_prove_equal_step:
        call name_eq_reset_iteration
        call name_eq_select_body_bytes
        imm r1, 532016
        imm r2, 2
        store r1, r2                  ; exact byte equality
        imm r1, 532024
        imm r2, 1
        store r1, r2                  ; successor k'=k+1<=len
        imm r1, 532032
        store r1, r2                  ; exact rank' = rank-1
        imm r1, 532128
        imm r2, 2
        store r1, r2                  ; successor equal prefix extended through k
        call name_eq_close_backedge
        imm r1, 532064
        imm r2, 1
        store r1, r2
        ret

name_eq_close_backedge:
        call name_eq_require_body
        imm r20, 532016
        imm r21, 2
        call exact_require_cell
        imm r20, 532024
        imm r21, 1
        call exact_require_cell
        imm r20, 532032
        imm r21, 1                    ; consumed strict rank decrease
        call exact_require_cell
        imm r20, 532128
        imm r21, 2                    ; exact successor-prefix tag
        call exact_require_cell       ; consumed successor-prefix extension
        imm r1, 532040
        imm r2, 1
        store r1, r2                  ; checked successor renaming
        imm r20, 532040
        imm r21, 1
        call exact_require_cell       ; consumed successor rename
        imm r1, 531984
        store r1, r2                  ; renamed k bound
        imm r1, 531992
        store r1, r2                  ; renamed smaller rank
        imm r1, 532000
        store r1, r2                  ; renamed extended prefix
        imm r1, 531976
        store r1, r2                  ; invariant re-established
        call name_eq_require_invariant
        ret

; False k<len under 0<=k<=len gives k=len; the carried prefix is full equality.
name_eq_prove_full_match:
        call name_eq_reset_iteration
        imm r1, 532112
        imm r2, 2
        store r1, r2                  ; exact false loop guard, k=len
        imm r1, 532080
        imm r2, 2
        store r1, r2                  ; exact result one
        call name_eq_require_full
        imm r1, 532072
        imm r2, 1
        store r1, r2
        ret

name_eq_require_full:
        call name_eq_require_invariant
        imm r20, 532112
        imm r21, 2
        call exact_require_cell
        imm r20, 532000
        imm r21, 1                    ; complete equal prefix at k=len
        call exact_require_cell
        imm r20, 532080
        imm r21, 2                    ; one
        call exact_require_cell
        ret

name_eq_select_body_bytes:
        imm r1, 532112
        imm r2, 1
        store r1, r2                  ; exact true k<len edge
        imm r1, 532120
        store r1, r2                  ; exact SRC+a+k / SRC+b+k chains
        imm r1, 532008
        store r1, r2                  ; exact two selected zero-extended bytes
        ret

name_eq_require_body:
        call name_eq_require_invariant
        imm r20, 532112
        imm r21, 1
        call exact_require_cell
        imm r20, 532120
        imm r21, 1                    ; consumed both address chains
        call exact_require_cell
        imm r20, 532008
        imm r21, 1                    ; consumed a-vs-b byte provenance
        call exact_require_cell
        imm r20, 531904
        imm r21, 1                    ; NTDM source-address bounds
        call exact_require_cell
        imm r20, 531912
        imm r21, 1                    ; NTDM exact source-byte relation
        call exact_require_cell
        ret

name_eq_require_invariant:
        call name_eq_require_common
        imm r20, 531968
        imm r21, 2
        call exact_require_cell
        imm r20, 531976
        imm r21, 1
        call exact_require_cell
        imm r20, 531984
        imm r21, 1
        call exact_require_cell
        imm r20, 531992
        imm r21, 1
        call exact_require_cell
        imm r20, 532000
        imm r21, 1
        call exact_require_cell
        ret

name_eq_require_common:
        call name_eq_require_imports
        imm r20, 531960
        imm r21, 1
        call exact_require_cell
        imm r20, 532088
        imm r21, 1
        call exact_require_cell
        imm r20, 532096
        imm r21, 1
        call exact_require_cell
        ret

name_eq_publish:
        imm r20, 532048
        imm r21, 1
        call exact_require_cell
        imm r20, 532056
        imm r21, 1
        call exact_require_cell
        imm r20, 532064
        imm r21, 1
        call exact_require_cell
        imm r20, 532072
        imm r21, 1
        call exact_require_cell
        imm r1, 531952
        imm r2, 1397839182            ; NEQS
        store r1, r2
        imm r20, 531952
        imm r21, 1397839182           ; consumed NEQS publication
        call exact_require_cell
        ret
