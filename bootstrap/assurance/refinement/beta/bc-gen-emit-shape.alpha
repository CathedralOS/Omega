; Exact source/artifact shape for gen_emit().
;
; Procedure 28 is one straight-line block.  It composes permissive expect and
; whitespace normalization, two new_label calls, eleven exact fixed-string
; helpers, four label references, emit_str_body, full-Word emit_dec, a final
; permissive expect, and an explicit zero return.  This module binds their
; source rows to exact artifact PCs, arguments, targets and continuations, the
; three-slot frame, every local/literal/push row, both epilogues, and the whole
; decoded-region footprint.  The adjacent summary owns values and trace order.
;
; Private publication cell: 536680 = GESH.

gen_emit_require_shape:
        call gen_emit_require_proc
        call gen_emit_require_block
        call gen_emit_require_events
        call gen_emit_require_locals
        call gen_emit_require_primitives
        call gen_emit_require_pushes
        call gen_emit_require_censuses
        call gen_emit_require_decoded
        imm r1, 536680
        imm r2, 1213416775            ; GESH
        store r1, r2
        imm r20, 536680
        imm r21, 1213416775
        call exact_require_cell
        ret

gen_emit_require_proc:
        imm r20, 7151616
        imm r21, 28
        imm r22, 0                    ; no parameters
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 28
        imm r22, 3                    ; slbl, albl, len
        call transfer_require_cell
        imm r20, 28
        call call_bounds_frame_bytes
        imm r1, 32
        jeq r0, r1, gen_emit_shape_ok
        jmp reject

gen_emit_require_block:
