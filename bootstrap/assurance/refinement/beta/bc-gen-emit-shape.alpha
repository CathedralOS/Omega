        imm r20, 146
        imm r21, 146
        imm r22, 28
        call exact_require_proc_blocks
        ret

; r20=row, r21=PC, r22=arity, r23=target, r24=continuation.  All ordinary
; calls in this straight-line block have zero ambient expression words.
