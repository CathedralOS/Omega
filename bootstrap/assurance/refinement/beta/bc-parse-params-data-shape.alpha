; Exact local/memory/expression shape for parse_proc blocks 339..344.
;
; The adjacent control module owns CFG, calls, returns, and frame. This module
; rejoins four local rows, five fixed memory sites, primitive rows 779..800,
; six binary pushes, the expect argument, two store-address pushes, and the
; exhaustive expression census for the parameter/capacity slice.

parse_params_shape_init:
        call parse_params_require_control_shape
        call parse_params_require_data_shape
        jmp parse_parameter_summary_init

parse_params_require_data_shape:
        call parse_params_require_locals
        call parse_params_require_memory
        call parse_params_require_primitives
        call parse_params_require_pushes
        call parse_params_require_expr_census
        ret

parse_params_require_locals:
        imm r20, 227
        imm r21, 344
        imm r22, 2
        imm r23, 2
        imm r24, 50037              ; nparams = NLOC
        call transfer_require_local
        imm r20, 228
        imm r21, 344
        imm r22, 2
        imm r23, 3
        imm r24, 50173              ; nslots = nparams+count
        call transfer_require_local
        imm r20, 229
        imm r21, 344
        imm r22, 1
        imm r23, 2
        imm r24, 50107              ; checked nparams payload
        call transfer_require_local
        imm r20, 230
        imm r21, 344
        imm r22, 1
        imm r23, 3
        imm r24, 50192              ; checked nslots guard payload
        call transfer_require_local
        ret

parse_params_require_memory:
        imm r20, 88
        imm r21, 340
        imm r22, 1
        imm r23, 8
        imm r24, 49500              ; parameter-room NLOC
        call transfer_require_memory
        imm r20, 89
        imm r21, 340
        imm r22, 2
        imm r23, 8
        imm r24, 49659              ; fifth-parameter status 252
        call transfer_require_memory
        imm r20, 90
        imm r21, 341
        imm r22, 1
        imm r23, 8
        imm r24, 49720              ; declare status test
        call transfer_require_memory
        imm r20, 91
        imm r21, 344
        imm r22, 1
        imm r23, 8
        imm r24, 50034              ; nparams NLOC snapshot
        call transfer_require_memory
        imm r20, 92
        imm r21, 344
        imm r22, 2
        imm r23, 8
        imm r24, 50367              ; slot-capacity status 252
        call transfer_require_memory
        ret

parse_params_require_primitives:
        ; row/block/kind/value-or-opcode/PC.
        imm r20, 779
        imm r21, 339
        imm r22, 3
        imm r23, 11                  ; cbyte != ')'
        imm r24, 49403
        call transfer_require_primitive
        imm r20, 780
        imm r21, 339
        imm r22, 1
        imm r23, 41                  ; checked close parenthesis
        imm r24, 49393
        call transfer_require_primitive
        imm r20, 781
        imm r21, 340
        imm r22, 1
        imm r23, 2097128             ; NLOC
        imm r24, 49490
        call transfer_require_primitive
        imm r20, 782
        imm r21, 340
        imm r22, 3
        imm r23, 8                   ; signed NLOC<4
        imm r24, 49529
        call transfer_require_primitive
        imm r20, 783
        imm r21, 340
        imm r22, 1
        imm r23, 4                   ; checked parameter limit
        imm r24, 49519
        call transfer_require_primitive
        imm r20, 784
        imm r21, 340
        imm r22, 1
        imm r23, 2097072             ; RESOURCE_FAIL
        imm r24, 49607
        call transfer_require_primitive
        imm r20, 785
        imm r21, 340
        imm r22, 1
        imm r23, 252                 ; checked fifth-parameter status
        imm r24, 49633
        call transfer_require_primitive
        imm r20, 786
        imm r21, 340
        imm r22, 1
        imm r23, 0
        imm r24, 49662
        call transfer_require_primitive

        imm r20, 787
        imm r21, 341
        imm r22, 1
        imm r23, 2097072
        imm r24, 49710
        call transfer_require_primitive
        imm r20, 788
        imm r21, 341
        imm r22, 3
        imm r23, 11                  ; status != 0
        imm r24, 49749
        call transfer_require_primitive
        imm r20, 789
        imm r21, 341
        imm r22, 1
        imm r23, 0
        imm r24, 49739
        call transfer_require_primitive
        imm r20, 790
        imm r21, 341
        imm r22, 3
        imm r23, 10                  ; cbyte == ','
        imm r24, 49871
        call transfer_require_primitive
        imm r20, 791
        imm r21, 341
        imm r22, 1
        imm r23, 44                  ; checked comma byte
        imm r24, 49861
        call transfer_require_primitive
        imm r20, 792
        imm r21, 342
        imm r22, 1
        imm r23, 0
        imm r24, 49958
        call transfer_require_primitive

        imm r20, 793
        imm r21, 344
        imm r22, 1
        imm r23, 2097128
        imm r24, 50024
        call transfer_require_primitive
        imm r20, 794
        imm r21, 344
        imm r22, 1
        imm r23, 123                 ; checked expect-open argument
        imm r24, 50056
        call transfer_require_primitive
        imm r20, 795
        imm r21, 344
        imm r22, 2
        imm r23, 3                   ; nparams + count_lets
        imm r24, 50151
        call transfer_require_primitive
        imm r20, 796
        imm r21, 344
        imm r22, 3
        imm r23, 12                  ; nslots <= 1024
        imm r24, 50237
        call transfer_require_primitive
        imm r20, 797
        imm r21, 344
        imm r22, 1
        imm r23, 1024                ; checked total slot limit
        imm r24, 50227
        call transfer_require_primitive
        imm r20, 798
        imm r21, 344
        imm r22, 1
        imm r23, 2097072
        imm r24, 50315
        call transfer_require_primitive
        imm r20, 799
        imm r21, 344
        imm r22, 1
        imm r23, 252                 ; checked slot-capacity status
        imm r24, 50341
        call transfer_require_primitive
        imm r20, 800
        imm r21, 344
        imm r22, 1
        imm r23, 0
        imm r24, 50370
        call transfer_require_primitive
        ret

parse_params_require_pushes:
        imm r20, 224
        imm r21, 339
        imm r22, 1
        imm r23, 49377
        call transfer_require_push
        imm r20, 225
        imm r21, 340
        imm r22, 1
        imm r23, 49503
        call transfer_require_push
        imm r20, 226
        imm r21, 341
        imm r22, 1
        imm r23, 49723
        call transfer_require_push
        imm r20, 227
        imm r21, 341
        imm r22, 1
        imm r23, 49845
        call transfer_require_push
        imm r20, 228
        imm r21, 344
        imm r22, 1
        imm r23, 50126              ; nparams held across count_lets call
        call transfer_require_push
        imm r20, 229
        imm r21, 344
        imm r22, 1
        imm r23, 50211
        call transfer_require_push
        imm r20, 364
        imm r21, 344
        imm r22, 2
        imm r23, 50066              ; checked '{' argument push
        call transfer_require_push
        imm r20, 401
        imm r21, 340
        imm r22, 3
        imm r23, 49617
        call transfer_require_push
        imm r20, 402
        imm r21, 344
        imm r22, 3
        imm r23, 50325
        call transfer_require_push
        ret

parse_params_require_expr_census:
        imm r20, 339
        imm r21, 344
        imm r22, 779
        imm r23, 801                 ; checked exclusive params primitive row
        imm r24, 224
        imm r25, 230
        imm r26, 364
        imm r27, 365
        imm r28, 401
        imm r29, 403
        call summary_require_expr_census
        ret
