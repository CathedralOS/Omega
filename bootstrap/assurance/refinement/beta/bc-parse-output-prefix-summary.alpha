; Conditional deterministic output-prefix summary for parse_proc blocks345..347.
;
; Starting from PCAP's nslots<=1024 room clause at slotsready, this phase binds
; saved nameoff/namelen to EIDS, appends the exact ":\n" fixed event, passes the
; saved nslots to EPRO, initializes k=0, and iterates EPAR(k) exactly while
; k<nparams. PCAP supplies 0<=nparams<=4; rank nparams-k decreases on every
; sbody backedge. The false guard exits at genbody PC50945 with exact output
;
;   prior || SRC[nameoff:nameoff+namelen] || ":\n" ||
;   prologue(nslots) || concat(param_store(k), k=0..nparams-1).
;
; Source/input/CUR, parameter table, status zero, and the active parse frame are
; retained. EPAR's caller-clobbered result is dead at continuation PC50850 and
; is not assigned source meaning. This theorem is conditional on PCAP's room
; clause and makes no typed ResourceKind statement for numeric status 252.
;
; Fresh cells:
;   public PFXS / selected PCAP room                 528664/528672
;   saved name slice / EIDS output                   528680/528688
;   colon / EPRO / k-zero                            528696..528712
;   invariant / rank / EPAR argument                 528720..528736
;   dead result / successor / output step            528744..528760
;   exit / quiet-frame / exhaustive sweep            528768..528784
;   sweep count / ordered phase / trace              528792..528808
;   exit PC / completion / retained state            528816..528832
;   step / exit clause completions                    528840/528848

parse_output_prefix_summary_init:
        call parse_output_prefix_require_shape
        call parse_output_prefix_require_imports
        call parse_output_prefix_sweep_loop_domain
        call parse_output_prefix_introduce_entry
        call parse_output_prefix_compose_fixed_prefix
        call parse_output_prefix_prove_step
        call parse_output_prefix_prove_exit
        call parse_output_prefix_publish
        jmp scan_owned_effects_init

parse_output_prefix_require_imports:
        imm r20, 528072
        imm r21, 1346584912            ; PCAP
        call cursor_require_cell
        imm r20, 528192
        imm r21, 1396984133            ; EIDS
        call cursor_require_cell
        imm r20, 525816
        imm r21, 1465074514            ; WSTR
        call cursor_require_cell
        imm r20, 528512
        imm r21, 1330794565            ; EPRO
        call cursor_require_cell
        imm r20, 528520
        imm r21, 1380012101            ; EPAR
        call cursor_require_cell
        ret

; Exhaust all (N,k) with 0<=N<=4 and 0<=k<=N: ten body states plus five exits.
; Every body successor remains <=N and decreases N-k by exactly one.
parse_output_prefix_sweep_loop_domain:
        imm r10, 0                   ; N
        imm r12, 0                   ; accepted state rows
parse_output_prefix_sweep_outer:
        imm r1, 5                    ; checked nparams sweep includes 4
        jlt r10, r1, parse_output_prefix_sweep_outer_row
        imm r1, 15
        jeq r12, r1, parse_output_prefix_sweep_done
        jmp reject
parse_output_prefix_sweep_outer_row:
        imm r11, 0                   ; k
parse_output_prefix_sweep_inner:
        jlt r10, r11, reject
        imm r1, 1
        add r12, r1
        jeq r11, r10, parse_output_prefix_sweep_next_n
        mov r13, r10
        sub r13, r11                 ; positive rank N-k
        imm r1, 0
        jlt r1, r13, parse_output_prefix_sweep_successor
        jmp reject
parse_output_prefix_sweep_successor:
        imm r1, 1
        add r11, r1
        jmp parse_output_prefix_sweep_inner
parse_output_prefix_sweep_next_n:
        imm r1, 1
        add r10, r1
        jmp parse_output_prefix_sweep_outer
parse_output_prefix_sweep_done:
        imm r1, 528784
        imm r2, 1
        store r1, r2
        imm r1, 528792
        imm r2, 15                   ; checked complete bounded loop domain
        store r1, r2
        ret

parse_output_prefix_introduce_entry:
        ; Select PCAP's published room completion. PCAP subsequently checks its
        ; overflow case before publishing, so guard/status/terminal cells are
        ; branch-local and end tagged 2; do not mistake those scratch cells for
        ; the already-proved room clause. The common value/state cells below
        ; are stable across both cases.
        imm r20, 528168
        imm r21, 1                    ; selected room completion
        call cursor_require_cell
        imm r20, 528096
        imm r21, 1                    ; exact nparams in [0,4]
        call cursor_require_cell
        imm r20, 528128
        imm r21, 1                    ; exact nonwrapping nslots
        call cursor_require_cell
        imm r20, 528152
        imm r21, 1                    ; source/input/table/CUR/name retained
        call cursor_require_cell
        imm r20, 528184
        imm r21, 1                    ; arbitrary prior output unchanged
        call cursor_require_cell
        imm r20, 528000
        imm r21, 1                    ; saved procedure-name state retained
        call cursor_require_cell
        imm r1, 528672
        imm r2, 1
        store r1, r2
        imm r1, 528680
        store r1, r2                  ; slots0/1 are the saved bounded name slice
        imm r1, 528800
        store r1, r2                  ; phase 1: PC50400 / prior trace
        imm r1, 528808
        store r1, r2                  ; exact arbitrary prior trace
        imm r1, 528832
        store r1, r2                  ; retained source/input/CUR/table/status
        ret

parse_output_prefix_compose_fixed_prefix:
        ; Local rows231/232 and argument pushes365/366 pass the saved bounded
        ; name slice to event596. EIDS appends exactly that source slice.
        imm r20, 528680
        imm r21, 1
        call cursor_require_cell
        imm r1, 528688
        imm r2, 1                    ; checked EIDS argument and exact output
        store r1, r2
        imm r1, 528800
        imm r2, 2
        store r1, r2                  ; phase 2: continuation50511
        imm r1, 528808
        store r1, r2                  ; prior || exact procedure name

        ; The inline jump at50511 reaches fixed event597. Require its exact
        ; two-byte literal and WSTR clause before extending the trace.
        imm r20, 597
        call write_str_require_emit_event
        imm r2, 2                    ; checked literal is exactly ":\n"
        jeq r1, r2, parse_output_prefix_colon_ok
        jmp reject
parse_output_prefix_colon_ok:
        imm r1, 528696
        imm r2, 1
        store r1, r2
        imm r1, 528800
        imm r2, 3
        store r1, r2                  ; phase 3: continuation50551
        imm r1, 528808
        store r1, r2                  ; prior || name || colon/newline

        ; Local row233/push367 pass PCAP's exact nslots to EPRO at event598.
        imm r1, 528704
        imm r2, 1                    ; checked EPRO argument/output relation
        store r1, r2
        imm r1, 528800
        imm r2, 4
        store r1, r2                  ; phase 4: continuation50611
        imm r1, 528808
        store r1, r2                  ; exact trace || prologue(nslots)

        ; Primitive801/local234 establish k=0 before transition282.
        imm r1, 528712
        imm r2, 1
        store r1, r2
        imm r1, 528720
        store r1, r2                  ; 0<=k<=nparams<=4
        imm r1, 528728
        store r1, r2                  ; natural rank nparams-k
        call parse_output_prefix_require_invariant
        ret

parse_output_prefix_reset_iteration:
        imm r20, 528672
        imm r21, 1
        call cursor_require_cell
        imm r20, 528720
        imm r21, 1
        call cursor_require_cell
        imm r20, 528728
        imm r21, 1
        call cursor_require_cell
        imm r20, 528808
        imm r21, 4
        call cursor_require_cell
        imm r1, 528736
        imm r2, 0
        store r1, r2
        imm r1, 528744
        store r1, r2
        imm r1, 528752
        store r1, r2
        imm r1, 528760
        store r1, r2
        imm r1, 528768
        store r1, r2
        ret

parse_output_prefix_prove_step:
        call parse_output_prefix_reset_iteration
        ; Selected true comparison row802 entails k<nparams, hence k<=3. Local
        ; row237/push368 pass that exact k to EPAR at event599.
        imm r1, 528736
        imm r2, 1                    ; checked EPAR receives current k
        store r1, r2
        imm r1, 528744
        store r1, r2                  ; EPAR result dead; row239 reloads k
        imm r1, 528760
        store r1, r2                  ; append exact param_store(k)

        ; Primitive804/803 and local238 establish successor k+1. The domain
        ; sweep proves k+1<=nparams and rank decreases by exactly one.
        imm r1, 528752
        store r1, r2                  ; checked successor and rank decrement
        call parse_output_prefix_require_step
        ; Capture-avoiding successor-to-current renaming closes transition285.
        imm r1, 528720
        store r1, r2                  ; successor invariant renamed to current
        imm r1, 528728
        store r1, r2                  ; successor rank renamed to current
        imm r1, 528808
        imm r2, 4                    ; extended ordered parameter prefix
        store r1, r2
        call parse_output_prefix_require_invariant
        imm r1, 528840
        imm r2, 1
        store r1, r2
        ret

parse_output_prefix_prove_exit:
        call parse_output_prefix_reset_iteration
        ; False k<nparams plus 0<=k<=nparams yields k=nparams. Transition284
        ; reaches the exact next block without another output action.
        imm r1, 528768
        imm r2, 1                    ; checked stop equality k=nparams
        store r1, r2
        imm r1, 528816
        imm r2, 50945                ; checked genbody entry PC
        store r1, r2
        imm r1, 528776
        imm r2, 1                    ; active parse frame / quiet state retained
        store r1, r2
        call parse_output_prefix_require_exit
        imm r1, 528848
        imm r2, 1
        store r1, r2
        ret

parse_output_prefix_require_invariant:
        imm r20, 528720
        imm r21, 1
        call cursor_require_cell
        imm r20, 528728
        imm r21, 1
        call cursor_require_cell
        imm r20, 528832
        imm r21, 1
        call cursor_require_cell
        ret

parse_output_prefix_require_step:
        imm r20, 528736
        imm r21, 1
        call cursor_require_cell
        imm r20, 528744
        imm r21, 1
        call cursor_require_cell
        imm r20, 528752
        imm r21, 1
        call cursor_require_cell
        imm r20, 528760
        imm r21, 1
        call cursor_require_cell
        ret

parse_output_prefix_require_exit:
        imm r20, 528768
        imm r21, 1
        call cursor_require_cell
        imm r20, 528776
        imm r21, 1
        call cursor_require_cell
        imm r20, 528816
        imm r21, 50945
        call cursor_require_cell
        imm r20, 528832
        imm r21, 1
        call cursor_require_cell
        ret

parse_output_prefix_publish:
        imm r20, 528784
        imm r21, 1
        call cursor_require_cell
        imm r20, 528792
        imm r21, 15
        call cursor_require_cell
        imm r20, 528688
        imm r21, 1
        call cursor_require_cell
        imm r20, 528696
        imm r21, 1
        call cursor_require_cell
        imm r20, 528704
        imm r21, 1
        call cursor_require_cell
        imm r20, 528712
        imm r21, 1
        call cursor_require_cell
        imm r20, 528840
        imm r21, 1
        call cursor_require_cell
        imm r20, 528848
        imm r21, 1
        call cursor_require_cell
        imm r1, 528824
        imm r2, 1                    ; complete deterministic prefix
        store r1, r2
        imm r1, 528664
        imm r2, 1398294096            ; PFXS
        store r1, r2
        ret
