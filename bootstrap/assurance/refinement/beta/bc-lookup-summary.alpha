; Conditional exact semantic summary for procedure36 lookup().
;
; Under NTDM and NEQS, snapshot n0=NLOC once, then carry
;   0<=i<=n0<=1024, rank n0-i, and forall j<i: NEQS(j)=0.
; A matching current i returns that least index; a nonmatch extends the exact
; prefix and decreases rank; i=n0 returns numeric zero. Hit at slot zero and
; exhausted no-match retain distinct provenance although both return zero.
;
; Bridge cell532136. Summary cells532144..532368; next fresh cell532376.

lookup_summary_init:
        imm r20, 532136
        imm r21, 1112887120           ; LUPB lookup continuation
        call exact_require_cell
        call lookup_require_shape
        call lookup_require_data_shape
        call lookup_require_imports
        call lookup_summary_reset
        call lookup_introduce_entry
        call lookup_prove_hit_zero
        call lookup_prove_hit_positive
        call lookup_prove_miss_step
        call lookup_prove_exhausted
        call lookup_publish
        jmp scan_owned_effects_init

lookup_require_imports:
        imm r20, 531848
        imm r21, 1296323662           ; NTDM
        call exact_require_cell
        call name_table_require_relations
        imm r20, 531952
        imm r21, 1397839182           ; NEQS
        call exact_require_cell
        ret

lookup_summary_reset:
        imm r10, 532144
lookup_summary_reset_loop:
        imm r1, 532376
        jlt r10, r1, lookup_summary_reset_cell
        ret
lookup_summary_reset_cell:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp lookup_summary_reset_loop

lookup_introduce_entry:
        imm r1, 532152
        imm r2, 1
        store r1, r2                  ; exact proc36 entry
        imm r1, 532168
        store r1, r2                  ; immutable snapshot n0=NLOC, n0<=1024
        imm r1, 532176
        store r1, r2                  ; initial i=0 and 0<=i<=n0
        imm r1, 532184
        store r1, r2                  ; exact natural rank n0-i
        imm r1, 532192
        store r1, r2                  ; exact forall j<i NEQS(j)=0, initially empty
        imm r1, 532296
        store r1, r2                  ; source/input/output/CUR/globals quiet
        imm r1, 532304
        store r1, r2                  ; checked 24-byte caller-frame relation
        imm r1, 532312
        store r1, r2                  ; n local written once and never reread NLOC
        imm r1, 532352
        store r1, r2                  ; NTDM prefix n is this same snapshot n0
        imm r1, 532160
        store r1, r2                  ; loop invariant established
        call lookup_require_invariant
        ret

lookup_reset_case:
        call lookup_require_invariant
        imm r1, 532200
        imm r2, 0
        store r1, r2
        imm r1, 532208
        store r1, r2
        imm r1, 532216
        store r1, r2
        imm r1, 532224
        store r1, r2
        imm r1, 532232
        store r1, r2
        imm r1, 532240
        store r1, r2
        imm r1, 532248
        store r1, r2
        imm r1, 532280
        store r1, r2
        imm r1, 532288
        store r1, r2
        imm r1, 532320
        store r1, r2
        imm r1, 532344
        store r1, r2
        imm r1, 532360
        store r1, r2
        imm r1, 532368
        store r1, r2
        ret

; True i<n0 instantiates the exact current-i argument/NEQS call relation.
lookup_select_call:
        imm r1, 532200
        imm r2, 1
        store r1, r2                  ; exact true i<n0 edge
        imm r1, 532208
        store r1, r2                  ; local i -> arg313 -> call26420/cont26429
        imm r1, 532320
        store r1, r2                  ; i is selected in-range NPFX index
        imm r1, 532360
        store r1, r2                  ; selected index reinstantiated from current local i
        imm r1, 532368
        store r1, r2                  ; NEQS total zero/one and quiet/frame-restoring
        call lookup_require_selected_call
        ret

lookup_require_selected_call:
        call lookup_require_invariant
        imm r20, 532200
        imm r21, 1
        call exact_require_cell
        imm r20, 532208
        imm r21, 1
        call exact_require_cell
        imm r20, 532320
        imm r21, 1
        call exact_require_cell
        imm r20, 532360
        imm r21, 1
        call exact_require_cell       ; consumed current-i selection join
        imm r20, 532368
        imm r21, 1
        call exact_require_cell       ; consumed total/quiet NEQS call clause
        call lookup_require_imports
        ret

; NEQS(i)=1 and i=0. Numeric result zero retains hit provenance.
lookup_prove_hit_zero:
        call lookup_reset_case
        call lookup_select_call
        imm r1, 532216
        imm r2, 2
        store r1, r2                  ; exact NEQS(i)=1 result
        imm r1, 532344
        store r1, r2                  ; partition i=0
        imm r1, 532280
        imm r2, 1
        store r1, r2                  ; exact numeric result zero
        imm r1, 532288
        store r1, r2                  ; provenance hit-slot-zero
        call lookup_require_hit_zero
        imm r1, 532256
        imm r2, 1
        store r1, r2                  ; published hit-zero clause
        ret

lookup_require_hit_zero:
        call lookup_require_hit_common
        imm r20, 532344
        imm r21, 2
        call exact_require_cell       ; consumed i=0 partition
        imm r20, 532280
        imm r21, 1
        call exact_require_cell       ; consumed numeric zero result
        imm r20, 532288
        imm r21, 1
        call exact_require_cell       ; consumed hit-zero provenance
        ret

; NEQS(i)=1 and 0<i<n0. The carried exact false prefix makes i the least hit,
; so duplicate table entries cannot select a later index.
lookup_prove_hit_positive:
        call lookup_reset_case
        call lookup_select_call
        imm r1, 532216
        imm r2, 2
        store r1, r2                  ; exact NEQS(i)=1 result
        imm r1, 532344
        imm r2, 3
        store r1, r2                  ; partition 0<i<n0
        imm r1, 532280
        imm r2, 2
        store r1, r2                  ; exact result equals positive i
        imm r1, 532288
        store r1, r2                  ; provenance positive least hit
        call lookup_require_hit_positive
        imm r1, 532264
        imm r2, 1
        store r1, r2                  ; published positive-hit clause
        ret

lookup_require_hit_positive:
        call lookup_require_hit_common
        imm r20, 532344
        imm r21, 3
        call exact_require_cell       ; consumed positive-i partition
        imm r20, 532280
        imm r21, 2
        call exact_require_cell       ; consumed exact result=i relation
        imm r20, 532288
        imm r21, 2
        call exact_require_cell       ; consumed positive-hit provenance
        ret

lookup_require_hit_common:
        call lookup_require_selected_call
        imm r20, 532216
        imm r21, 2
        call exact_require_cell       ; consumed exact NEQS match
        imm r20, 532192
        imm r21, 1                    ; exact prior-false-prefix tag
        call exact_require_cell       ; consumed forall prior indices nonmatch
        ret

; NEQS(i)=0 extends the exact false prefix and advances the immutable snapshot
; loop by one, decreasing rank n0-i exactly once.
lookup_prove_miss_step:
        call lookup_reset_case
        call lookup_select_call
        imm r1, 532216
        imm r2, 1
        store r1, r2                  ; exact NEQS(i)=0 result
        imm r1, 532224
        store r1, r2                  ; successor i'=i+1<=n0
        imm r1, 532232
        store r1, r2                  ; exact successor rank=rank-1
        imm r1, 532240
        store r1, r2                  ; successor exact prior-index nonmatch prefix
        call lookup_close_backedge
        imm r1, 532328
        imm r2, 1
        store r1, r2                  ; published miss-step clause
        ret

lookup_close_backedge:
        call lookup_require_selected_call
        imm r20, 532216
        imm r21, 1
        call exact_require_cell       ; consumed exact NEQS nonmatch
        imm r20, 532224
        imm r21, 1
        call exact_require_cell       ; consumed i successor
        imm r20, 532232
        imm r21, 1
        call exact_require_cell       ; consumed strict rank decrease
        imm r20, 532240
        imm r21, 1
        call exact_require_cell       ; consumed extended false prefix
        imm r1, 532248
        imm r2, 1
        store r1, r2                  ; checked capture-avoiding rename
        imm r20, 532248
        imm r21, 1
        call exact_require_cell       ; consumed backedge rename
        imm r1, 532176
        store r1, r2                  ; renamed i bound
        imm r1, 532184
        store r1, r2                  ; renamed smaller rank
        imm r1, 532192
        store r1, r2                  ; renamed extended false prefix
        imm r1, 532160
        store r1, r2                  ; invariant re-established
        call lookup_require_invariant
        ret

; False i<n0 under i<=n0 gives i=n0. No call occurs and the complete exact
; nonmatch prefix returns numeric zero with no-match provenance.
lookup_prove_exhausted:
        call lookup_reset_case
        imm r1, 532200
        imm r2, 2
        store r1, r2                  ; exact false i<n0 edge, hence i=n0
        imm r1, 532208
        store r1, r2                  ; exact no-call exhausted path
        imm r1, 532280
        imm r2, 1
        store r1, r2                  ; exact numeric result zero
        imm r1, 532288
        imm r2, 3
        store r1, r2                  ; provenance exhausted no-match
        call lookup_require_exhausted
        imm r1, 532272
        imm r2, 1
        store r1, r2                  ; published exhausted clause
        ret

lookup_require_exhausted:
        call lookup_require_invariant
        imm r20, 532200
        imm r21, 2
        call exact_require_cell
        imm r20, 532208
        imm r21, 2
        call exact_require_cell       ; consumed no-call path
        imm r20, 532192
        imm r21, 1
        call exact_require_cell       ; complete forall j<n0 nonmatch
        imm r20, 532280
        imm r21, 1
        call exact_require_cell       ; consumed numeric zero result
        imm r20, 532288
        imm r21, 3
        call exact_require_cell       ; consumed no-match provenance
        ret

lookup_require_invariant:
        call lookup_require_common
        imm r20, 532160
        imm r21, 1
        call exact_require_cell
        imm r20, 532168
        imm r21, 1
        call exact_require_cell       ; immutable n0 snapshot
        imm r20, 532176
        imm r21, 1
        call exact_require_cell       ; 0<=i<=n0<=1024
        imm r20, 532184
        imm r21, 1
        call exact_require_cell       ; exact rank n0-i
        imm r20, 532192
        imm r21, 1
        call exact_require_cell       ; exact prior-false prefix
        imm r20, 532312
        imm r21, 1
        call exact_require_cell       ; no live-NLOC reread
        imm r20, 532352
        imm r21, 1
        call exact_require_cell       ; consumed NPFX/snapshot identity
        ret

lookup_require_common:
        call lookup_require_imports
        imm r20, 532152
        imm r21, 1
        call exact_require_cell
        imm r20, 532296
        imm r21, 1
        call exact_require_cell
        imm r20, 532304
        imm r21, 1
        call exact_require_cell
        ret

lookup_publish:
        imm r20, 532256
        imm r21, 1
        call exact_require_cell
        imm r20, 532264
        imm r21, 1
        call exact_require_cell
        imm r20, 532272
        imm r21, 1
        call exact_require_cell
        imm r20, 532328
        imm r21, 1
        call exact_require_cell
        imm r1, 532336
        imm r2, 1
        store r1, r2                  ; all result/provenance partitions joined
        imm r20, 532336
        imm r21, 1
        call exact_require_cell
        imm r1, 532144
        imm r2, 1263488844            ; LOOK
        store r1, r2
        imm r20, 532144
        imm r21, 1263488844           ; consumed LOOK publication
        call exact_require_cell
        ret
