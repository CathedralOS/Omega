        imm r22, 50098
        imm r23, 1
        imm r24, 0
        imm r25, 17441
        imm r26, 50107              ; checked expect-open continuation
        call summary_require_call_site
        imm r20, 594
        imm r21, 344
        imm r22, 50142
        imm r23, 0
        imm r24, 1
        imm r25, 27433
        imm r26, 50151              ; checked count_lets continuation
        call summary_require_call_site
        imm r20, 595
        imm r21, 344
        imm r22, 5
        imm r23, 50399
        call slurp_summary_require_event

        imm r20, 49672
        imm r21, 49691
        call slurp_summary_require_epilogue
        imm r20, 49968
        imm r21, 49987
        call slurp_summary_require_epilogue
        imm r20, 50380
        imm r21, 50399
        call slurp_summary_require_epilogue
        ret

