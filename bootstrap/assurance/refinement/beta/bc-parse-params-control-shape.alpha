; Exact control/effect shape for parse_proc's parameter and capacity slice.
;
; This module owns blocks 339..344 semantically while rejoining all procedure-68
; block PCs to bind their ownership. It closes transitions 274..281, ten calls,
; three pre-output returns/epilogues, the 48-byte frame, exhaustive effect rows,
; and decoded region [49368,50400). Local/memory/expression payloads are kept in
; bc-parse-params-data-shape.alpha.

parse_params_require_control_shape:
        imm r20, 7151616
        imm r21, 68
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 68
        imm r22, 5
        call transfer_require_cell
        imm r20, 68
        call call_bounds_frame_bytes
        imm r1, 48
        jeq r0, r1, parse_params_shape_blocks
        jmp reject

parse_params_shape_blocks:
        imm r20, 338
        imm r21, 48993
        call slurp_summary_require_block_pc
        imm r20, 339
        imm r21, 49368
        call slurp_summary_require_block_pc
        imm r20, 340
        imm r21, 49490
        call slurp_summary_require_block_pc
        imm r20, 341
        imm r21, 49692
        call slurp_summary_require_block_pc
        imm r20, 342
        imm r21, 49958
        call slurp_summary_require_block_pc
        imm r20, 343
        imm r21, 49988
        call slurp_summary_require_block_pc
        imm r20, 344
        imm r21, 50015
        call slurp_summary_require_block_pc
        imm r20, 345
        imm r21, 50400
        call slurp_summary_require_block_pc
        imm r20, 346
        imm r21, 50649
        call slurp_summary_require_block_pc
        imm r20, 347
        imm r21, 50790
        call slurp_summary_require_block_pc
        imm r20, 348
        imm r21, 50945
        call slurp_summary_require_block_pc
        imm r20, 338
        imm r21, 348
        imm r22, 68
        call cursor_require_proc_blocks
        call parse_params_require_transitions
        call parse_params_require_events
        call parse_params_require_control_census
        ret

parse_params_require_transitions:
        imm r20, 274
        imm r21, 339
        imm r22, 1
        imm r23, 340
        imm r24, 49462              ; checked non-close parameter guard
        call slurp_summary_require_transition
        imm r20, 275
        imm r21, 339
        imm r22, 0
        imm r23, 344
        imm r24, 49481
        call slurp_summary_require_transition
        imm r20, 276
        imm r21, 340
        imm r22, 1
        imm r23, 341
        imm r24, 49588              ; checked NLOC<4 guard
        call slurp_summary_require_transition
        imm r20, 277
        imm r21, 341
        imm r22, 1
        imm r23, 342
        imm r24, 49808              ; checked declaration-status guard
        call slurp_summary_require_transition
        imm r20, 278
        imm r21, 341
        imm r22, 1
        imm r23, 343
        imm r24, 49930              ; checked comma guard
        call slurp_summary_require_transition
        imm r20, 279
        imm r21, 341
        imm r22, 0
        imm r23, 339
        imm r24, 49949
        call slurp_summary_require_transition
        imm r20, 280
        imm r21, 343
        imm r22, 0
        imm r23, 339
        imm r24, 50006
        call slurp_summary_require_transition
        imm r20, 281
        imm r21, 344
        imm r22, 1
        imm r23, 345
        imm r24, 50296              ; checked nslots<=1024 guard
        call slurp_summary_require_transition
        ret

parse_params_require_events:
        imm r20, 583
        imm r21, 339
