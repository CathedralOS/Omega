; Responsibility-neutral exact shape/table helpers shared by semantic tranches.
; This file has no initialization edge and publishes no theorem token.

; Exhaust all expression primitive/push rows for selected blocks [r20,r21].
; The four supplied half-open row intervals must contain every matching row
; and no row owned by another block.
summary_require_expr_census:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r36, r26
        mov r37, r27
        mov r38, r28
        mov r39, r29
        imm r10, 0
        imm r11, 0
summary_primitive_census_loop:
        imm r1, 816                  ; exact expression primitive-row universe
        jlt r10, r1, summary_primitive_census_row
        mov r2, r33
        sub r2, r32
        jeq r11, r2, summary_push_census_init
        jmp reject
summary_primitive_census_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 8388608
        add r1, r2
        load r3, r1
        jlt r3, r30, summary_primitive_census_next
        jlt r31, r3, summary_primitive_census_next
        jlt r10, r32, reject
        jlt r10, r33, summary_primitive_census_count
        jmp reject
summary_primitive_census_count:
        imm r1, 1
        add r11, r1
summary_primitive_census_next:
        imm r1, 1
        add r10, r1
        jmp summary_primitive_census_loop

summary_push_census_init:
        imm r10, 0
        imm r11, 0
summary_push_census_loop:
        imm r1, 403                  ; exact expression push-row universe
        jlt r10, r1, summary_push_census_row
        mov r2, r35
        sub r2, r34
        mov r4, r37
        sub r4, r36
        add r2, r4
        mov r4, r39
        sub r4, r38
        add r2, r4
        jeq r11, r2, exact_shape_ok
        jmp reject
summary_push_census_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 9437184
        add r1, r2
        load r3, r1
        jlt r3, r30, summary_push_census_next
        jlt r31, r3, summary_push_census_next
        jlt r10, r34, summary_push_census_argument
        jlt r10, r35, summary_push_census_count
summary_push_census_argument:
        jlt r10, r36, summary_push_census_store
        jlt r10, r37, summary_push_census_count
summary_push_census_store:
        jlt r10, r38, reject
        jlt r10, r39, summary_push_census_count
        jmp reject
summary_push_census_count:
        imm r1, 1
        add r11, r1
summary_push_census_next:
        imm r1, 1
        add r10, r1
        jmp summary_push_census_loop

; Block row/PC in r20/r21.
exact_require_block_pc:
        imm r1, 8
        mul r20, r1
        imm r1, 3235840
        add r1, r20
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; Transition row/source-block/guarded/target/control-pc in r20..r24.
exact_require_transition:
        mov r25, r20
        imm r1, 8
        mul r25, r1
        imm r1, 3215360
        add r1, r25
        load r2, r1
        jeq r2, r21, exact_transition_guard
        jmp reject
exact_transition_guard:
        imm r1, 3227648
        add r1, r25
        load r2, r1
        jeq r2, r22, exact_transition_target
        jmp reject
exact_transition_target:
        imm r1, 3231744
        add r1, r25
        load r2, r1
        jeq r2, r23, exact_transition_pc
        jmp reject
exact_transition_pc:
        imm r1, 3239936
        add r1, r25
        load r2, r1
        jeq r2, r24, exact_shape_ok
        jmp reject

; Event row/block/kind/pc in r20..r23.
exact_require_event:
        mov r25, r20
        imm r1, 8
        mul r25, r1
        imm r1, 7077888
        add r1, r25
        load r2, r1
        jeq r2, r21, exact_event_kind
        jmp reject
exact_event_kind:
        imm r1, 7086080
        add r1, r25
        load r2, r1
        jeq r2, r22, exact_event_pc
        jmp reject
exact_event_pc:
        imm r1, 7135232
        add r1, r25
        load r2, r1
        jeq r2, r23, exact_shape_ok
        jmp reject

; Exact 19-byte canonical epilogue at [r20,r21], with r21=r20+19.
exact_require_epilogue:
        mov r25, r20
        mov r26, r21
        mov r2, r25
        imm r1, 19
        add r2, r1
        jeq r2, r26, exact_epilogue_ret_linked
        jmp reject
exact_epilogue_ret_linked:
        mov r20, r25
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 10
        call require_tape_byte
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 5
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 6
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r25
        imm r1, 7
        add r20, r1
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 8
        add r20, r1
        imm r21, 8
        call require_tape_word
        mov r20, r25
        imm r1, 16
        add r20, r1
        imm r21, 3
        call require_tape_byte
        mov r20, r25
        imm r1, 17
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 18
        add r20, r1
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 19
        add r20, r1
        imm r21, 20
        call require_tape_byte
        ret

; Exhaust local/memory/transition/event rows for blocks [r20,r21].
exact_require_effect_census:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r36, r26
        mov r37, r27
        mov r38, r28
        mov r39, r29
        imm r10, 0
        imm r11, 0
exact_effect_local_loop:
        imm r1, 242
        jlt r10, r1, exact_effect_local_row
        mov r2, r33
        sub r2, r32
        jeq r11, r2, exact_effect_memory_init
        jmp reject
exact_effect_local_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7168000
        add r1, r2
        load r3, r1
        jlt r3, r30, exact_effect_local_next
        jlt r31, r3, exact_effect_local_next
        jlt r10, r32, reject
        jlt r10, r33, exact_effect_local_match
        jmp reject
exact_effect_local_match:
        imm r1, 1
        add r11, r1
exact_effect_local_next:
        imm r1, 1
        add r10, r1
        jmp exact_effect_local_loop

exact_effect_memory_init:
        imm r10, 0
        imm r11, 0
exact_effect_memory_loop:
        imm r1, 95
        jlt r10, r1, exact_effect_memory_row
        mov r2, r35
        sub r2, r34
        jeq r11, r2, exact_effect_transition_init
        jmp reject
exact_effect_memory_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7602176
        add r1, r2
        load r3, r1
        jlt r3, r30, exact_effect_memory_next
        jlt r31, r3, exact_effect_memory_next
        jlt r10, r34, reject
        jlt r10, r35, exact_effect_memory_match
        jmp reject
exact_effect_memory_match:
        imm r1, 1
        add r11, r1
exact_effect_memory_next:
        imm r1, 1
        add r10, r1
        jmp exact_effect_memory_loop

exact_effect_transition_init:
        imm r10, 0
        imm r11, 0
exact_effect_transition_loop:
        imm r1, 291
        jlt r10, r1, exact_effect_transition_row
        mov r2, r37
        sub r2, r36
        jeq r11, r2, exact_effect_event_init
        jmp reject
exact_effect_transition_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 3215360
        add r1, r2
        load r3, r1
        jlt r3, r30, exact_effect_transition_next
        jlt r31, r3, exact_effect_transition_next
        jlt r10, r36, reject
        jlt r10, r37, exact_effect_transition_match
        jmp reject
exact_effect_transition_match:
        imm r1, 1
        add r11, r1
exact_effect_transition_next:
        imm r1, 1
        add r10, r1
        jmp exact_effect_transition_loop

exact_effect_event_init:
        imm r10, 0
        imm r11, 0
exact_effect_event_loop:
        imm r1, 613
        jlt r10, r1, exact_effect_event_row
        mov r2, r39
        sub r2, r38
        jeq r11, r2, exact_shape_ok
        jmp reject
exact_effect_event_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7077888
        add r1, r2
        load r3, r1
        jlt r3, r30, exact_effect_event_next
        jlt r31, r3, exact_effect_event_next
        jlt r10, r38, reject
        jlt r10, r39, exact_effect_event_match
        jmp reject
exact_effect_event_match:
        imm r1, 1
        add r11, r1
exact_effect_event_next:
        imm r1, 1
        add r10, r1
        jmp exact_effect_event_loop

; Blocks [r20,r21] inclusive all and only belong to procedure r22.
exact_require_proc_blocks:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        imm r10, 0
        imm r11, 0
exact_proc_block_loop:
        imm r1, 355
        jlt r10, r1, exact_proc_block_row
        mov r2, r26
        sub r2, r25
        imm r1, 1
        add r2, r1
        jeq r11, r2, exact_shape_ok
        jmp reject
exact_proc_block_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 3145728
        add r1, r2
        load r3, r1
        jeq r3, r27, exact_proc_block_match
        jmp exact_proc_block_next
exact_proc_block_match:
        jlt r10, r25, reject
        jlt r26, r10, reject
        imm r1, 1
        add r11, r1
exact_proc_block_next:
        imm r1, 1
        add r10, r1
        jmp exact_proc_block_loop

; Exact decoded census for [r20,r21), rejecting I/O, halt, byte memory,
; division, and remainder. r22/r23/r24 are call/ret/store totals.
exact_quiet_scan_region:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        imm r10, 0
        imm r11, 0
        imm r12, 0
exact_quiet_scan_loop:
        jlt r25, r26, exact_quiet_scan_pc
        jeq r10, r27, exact_quiet_scan_rets
        jmp reject
exact_quiet_scan_rets:
        jeq r11, r28, exact_quiet_scan_stores
        jmp reject
exact_quiet_scan_stores:
        jeq r12, r29, exact_shape_ok
        jmp reject
exact_quiet_scan_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, exact_quiet_scan_start
        jmp exact_quiet_scan_next
exact_quiet_scan_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, exact_quiet_scan_call
        imm r3, 20
        jeq r2, r3, exact_quiet_scan_ret
        imm r3, 11
        jeq r2, r3, exact_quiet_scan_store
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 8
        jeq r2, r3, reject
        imm r3, 9
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        jmp exact_quiet_scan_next
exact_quiet_scan_call:
        imm r1, 1
        add r10, r1
        jmp exact_quiet_scan_next
exact_quiet_scan_ret:
        imm r1, 1
        add r11, r1
        jmp exact_quiet_scan_next
exact_quiet_scan_store:
        imm r1, 1
        add r12, r1
exact_quiet_scan_next:
        imm r1, 1
        add r25, r1
        jmp exact_quiet_scan_loop

; Require the call at r20 to target r21 and have exact fallthrough r22.
; This was originally private to the main/slurp bridge, but its contract and
; implementation are responsibility-neutral and are also needed by Checker C.
exact_require_call:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r2, r25
        imm r1, 9
        add r2, r1
        jeq r2, r27, exact_require_call_opcode
        jmp reject
exact_require_call_opcode:
        mov r20, r25
        imm r21, 19
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        mov r21, r26
        call require_tape_word
        ret

; Exact event-row argument arity at r20 must equal r21.
exact_require_event_arity:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7143424
        add r1, r2
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; Exact expression-height table entry for event row r20 must equal r21.
exact_require_ambient_height:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 10035200
        add r1, r2
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; Rejoin one ordinary source call across the event, arity, expression-height,
; and decoded-call tables. Inputs are event/block/pc/arity/ambient/target/
; continuation in r20..r26.
summary_require_call_site:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r36, r26
        mov r20, r30
        mov r21, r31
        imm r22, 1
        mov r23, r32
        call exact_require_event
        mov r20, r30
        mov r21, r33
        call exact_require_event_arity
        mov r20, r30
        mov r21, r34
        call exact_require_ambient_height
        mov r20, r32
        mov r21, r35
        mov r22, r36
        call exact_require_call
        ret

exact_require_cell:
        load r2, r20
        jeq r2, r21, exact_shape_ok
        jmp reject
exact_shape_ok:
        ret
