; Conjunction of exact shape for p26, p46, and p62..p67 over one independently
; decoded canonical source/artifact/witness bundle. Procedure62's existing
; module contributes shape only here; its GSBD semantic token is process-local
; to Checker A and is not transferred into this executable.

statement_family_shape_init:
        imm r20, 546000
        imm r21, 1414681427             ; SSRT
        call exact_require_cell
        call statement_emit_epilogue_require_shape
        call statement_gen_store_require_shape
        call gen_stmts_boundary_require_shape
        call statement_gen_block_require_shape
        call statement_emit_state_label_require_shape
        call statement_gen_state_require_shape
        call statement_gen_to_require_shape
        call statement_gen_stmt_require_shape
        imm r1, 546008
        imm r2, 8                       ; exact procedure family cardinality
        store r1, r2
        imm r20, 546008
        imm r21, 8
        call exact_require_cell
        imm r1, 546016
        imm r2, 1279808339              ; SSHL
        store r1, r2
        imm r20, 546016
        imm r21, 1279808339
        call exact_require_cell
        jmp scan_owned_effects_init
