; Cross-scan remaining-let induction.
;
; Let N=nparams, C=CNTS's exact count, P=the number of earlier distinct let
; occurrences already discharged through a room declaration, and R=C-P.
; PCAP room supplies nslots=N+C<=1024. At every real declaration the current
; SREL let branch has custody of the next occurrence, so R>=1, P<=C-1, and
; NLOC=N+P<=N+C-1=nslots-1<=1023. DCLS therefore takes its room branch.
;
; The induction is over occurrence custody, not cursor or output productivity.
; Non-let finite steps preserve P/R/NLOC. An unknown token may make SREL take
; infinitely many completed backedges with no cursor/output progress; that is
; Diverge with the invariant retained, not an escape from the budget.

declaration_budget_rules_init:
        imm r20, 632008
        imm r21, 1312903748             ; DRAN
        call exact_require_cell
        imm r20, 632016
        imm r21, 1213420100             ; DRSH
        call exact_require_cell
        imm r20, 634192
        imm r21, 4
        call exact_require_cell
        call declaration_budget_build_parameter_rows
        call declaration_budget_build_induction_rows
        call declaration_budget_require_parameter_rows
        call declaration_budget_require_induction_rows
        call declaration_budget_close_origin3
        imm r1, 632032
        imm r2, 1280660036             ; DRUL completed rule family
        store r1, r2
        jmp declaration_budget_publication_init

; Five interval-endpoint rows, one for every admitted N=0..4.
; Fields: N, max C, max P before declaration, max NLOC, nslots limit,
; universal interval law, completion. Rows at636000, stride56.
declaration_budget_build_parameter_rows:
        imm r10, 0
declaration_budget_build_parameter_loop:
        imm r1, 5
        jlt r10, r1, declaration_budget_build_parameter_row
        imm r1, 635000
        imm r2, 5                      ; exact N=0..4 row count
        store r1, r2
        ret
declaration_budget_build_parameter_row:
        imm r11, 1024
        sub r11, r10                   ; max C admitted by N+C<=1024
        mov r12, r11
        imm r1, 1
        sub r12, r1                    ; max P while R=C-P>=1
        mov r13, r10
        add r13, r12                   ; max NLOC
        imm r14, 1024
        imm r1, 1023                   ; universal pre-declare NLOC maximum
        jeq r13, r1, declaration_budget_store_parameter_row
        jmp reject
declaration_budget_store_parameter_row:
        mov r20, r10
        imm r1, 56
        mul r20, r1
        imm r1, 636000
        add r20, r1
        store r20, r10
        imm r1, 8
        add r20, r1
        store r20, r11
        add r20, r1
        store r20, r12
        add r20, r1
        store r20, r13
        add r20, r1
        store r20, r14
        add r20, r1
        imm r2, 1
        store r20, r2                  ; endpoint monotonicity covers 0<=C<=max
        add r20, r1
        store r20, r2                  ; row complete
        imm r1, 1
        add r10, r1
        jmp declaration_budget_build_parameter_loop

; Six rule rows at637000, stride80. Fields: id, premise class, P relation,
; R relation, NLOC relation, declaration?, productivity premise?, custody,
; greatest-fixed-point compatibility, completion. Relation codes are
; 0=preserve, 1=unit declaration step, 2=lift the same finite child amount,
; and 3=retain the invariant along a divergent child prefix.
declaration_budget_build_induction_rows:
        imm r10, 1                    ; initialization
        imm r11, 1
        imm r12, 0
        imm r13, 0
        imm r14, 0
        imm r15, 0
        call declaration_budget_store_induction_row
        imm r10, 2                    ; real let / declaration step
        imm r11, 2
        imm r12, 1                    ; P advances once for real let
        imm r13, 1                    ; R decreases by exactly one
        imm r14, 1
        imm r15, 1
        call declaration_budget_store_induction_row
        imm r10, 3                    ; finite non-let statement
        imm r11, 3
        imm r12, 0
        imm r13, 0
        imm r14, 0
        imm r15, 0
        call declaration_budget_store_induction_row
        imm r10, 4                    ; nested Ret lift
        imm r11, 4
        imm r12, 2                    ; P advances by child's finite amount
        imm r13, 2                    ; R decreases by that same amount
        imm r14, 2                    ; NLOC advances by that same amount
        imm r15, 0
        call declaration_budget_store_induction_row
        imm r10, 5                    ; child divergence lift
        imm r11, 5
        imm r12, 3                    ; retain relation on every child prefix
        imm r13, 3
        imm r14, 3
        imm r15, 0
        call declaration_budget_store_induction_row
        imm r10, 6                    ; unknown-token no-progress divergence
        imm r11, 6
        imm r12, 0
        imm r13, 0
        imm r14, 0
        imm r15, 0
        call declaration_budget_store_induction_row
        imm r1, 635008
        imm r2, 6
        store r1, r2
        ret

declaration_budget_store_induction_row:
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 80
        mul r20, r1
        imm r1, 637000
        add r20, r1
        store r20, r10
        imm r1, 8
        add r20, r1
        store r20, r11
        add r20, r1
        store r20, r12
        add r20, r1
        store r20, r13
        add r20, r1
        store r20, r14
        add r20, r1
        store r20, r15
        add r20, r1
        imm r2, 1
        store r20, r2                  ; no cursor/output productivity premise
        add r20, r1
        store r20, r2                  ; occurrence identity retained
        add r20, r1
        store r20, r2                  ; compatible with SREL/PBOD nu outcomes
        add r20, r1
        store r20, r2                  ; row complete
        ret

declaration_budget_require_parameter_rows:
        imm r20, 635000
        imm r21, 5
        call exact_require_cell
        imm r10, 0
declaration_budget_require_parameter_loop:
        imm r1, 5
        jlt r10, r1, declaration_budget_require_parameter_row
        ret
declaration_budget_require_parameter_row:
        imm r11, 1024
        sub r11, r10
        mov r12, r11
        imm r1, 1
        sub r12, r1
        mov r13, r10
        add r13, r12
        mov r20, r10
        imm r1, 56
        mul r20, r1
        imm r1, 636000
        add r20, r1
        mov r21, r10
        call exact_require_cell
        imm r1, 8
        add r20, r1
        mov r21, r11
        call exact_require_cell
        add r20, r1
        mov r21, r12
        call exact_require_cell
        add r20, r1
        mov r21, r13
        call exact_require_cell
        add r20, r1
        imm r21, 1024
        call exact_require_cell
        add r20, r1
        imm r21, 1
        call exact_require_cell
        add r20, r1
        call exact_require_cell
        imm r1, 1
        add r10, r1
        jmp declaration_budget_require_parameter_loop

declaration_budget_require_induction_rows:
        imm r20, 635008
        imm r21, 6
        call exact_require_cell
        imm r10, 0
declaration_budget_require_induction_loop:
        imm r1, 6
        jlt r10, r1, declaration_budget_require_induction_row
        ret
declaration_budget_require_induction_row:
        mov r19, r10
        imm r1, 1
        add r19, r1
        mov r10, r19
        call declaration_budget_select_induction
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 80
        mul r20, r1
        imm r1, 637000
        add r20, r1
        mov r21, r10
        call exact_require_cell
        imm r1, 8
        add r20, r1
        mov r21, r11
        call exact_require_cell
        add r20, r1
        mov r21, r12
        call exact_require_cell
        add r20, r1
        mov r21, r13
        call exact_require_cell
        add r20, r1
        mov r21, r14
        call exact_require_cell
        add r20, r1
        mov r21, r15
        call exact_require_cell
        ; No productivity premise, occurrence identity, nu compatibility, and
        ; row completion are all mandatory rather than producer assertions.
        add r20, r1
        imm r21, 1
        call exact_require_cell
        add r20, r1
        call exact_require_cell
        add r20, r1
        call exact_require_cell
        add r20, r1
        call exact_require_cell
        mov r10, r19
        jmp declaration_budget_require_induction_loop

declaration_budget_select_induction:
        imm r1, 1
        jeq r10, r1, declaration_budget_induction_init
        imm r1, 2
        jeq r10, r1, declaration_budget_induction_let
        imm r1, 3
        jeq r10, r1, declaration_budget_induction_nonlet
        imm r1, 4
        jeq r10, r1, declaration_budget_induction_child_ret
        imm r1, 5
        jeq r10, r1, declaration_budget_induction_child_div
        imm r1, 6
        jeq r10, r1, declaration_budget_induction_unknown
        jmp reject
declaration_budget_induction_init:
        imm r11, 1
        imm r12, 0
        imm r13, 0
        imm r14, 0
        imm r15, 0
        ret
declaration_budget_induction_let:
        imm r11, 2
        imm r12, 1
        imm r13, 1
        imm r14, 1
        imm r15, 1
        ret
declaration_budget_induction_nonlet:
        imm r11, 3
        imm r12, 0
        imm r13, 0
        imm r14, 0
        imm r15, 0
        ret
declaration_budget_induction_child_ret:
        imm r11, 4
        imm r12, 2
        imm r13, 2
        imm r14, 2
        imm r15, 0
        ret
declaration_budget_induction_child_div:
        imm r11, 5
        imm r12, 3
        imm r13, 3
        imm r14, 3
        imm r15, 0
        ret
declaration_budget_induction_unknown:
        imm r11, 6
        imm r12, 0
        imm r13, 0
        imm r14, 0
        imm r15, 0
        ret

declaration_budget_close_origin3:
        ; Rejoin the exact implication schemas rather than a numeric status.
        imm r20, 633016               ; DCLS tag field
        imm r21, 1397506884
        call exact_require_cell
        imm r20, 633064               ; CNTS tag field
        imm r21, 1129206867
        call exact_require_cell
        imm r20, 633112               ; PCAP tag field
        imm r21, 1346584912
        call exact_require_cell
        imm r20, 633208               ; SREL tag field
        imm r21, 1279611475
        call exact_require_cell
        imm r20, 633256               ; STBR tag field
        imm r21, 1380078675
        call exact_require_cell
        imm r20, 633304               ; PBOD tag field
        imm r21, 1146045008
        call exact_require_cell
        imm r1, 635016
        imm r2, 1                    ; every dynamic declaration has remaining>=1
        store r1, r2
        imm r1, 635024
        store r1, r2                  ; NLOC=nparams+processed occurrences
        imm r1, 635032
        store r1, r2                  ; NLOC<=nslots-1<=1023 before DCLS
        imm r1, 635040
        store r1, r2                  ; DCLS full branch impossible
        imm r1, 635048
        store r1, r2                  ; origin3 root-unreachable
        imm r1, 635056
        store r1, r2                  ; malformed no-progress remains Diverge
        imm r1, 635064
        store r1, r2                  ; no ResourceKind/status inversion
        ret
