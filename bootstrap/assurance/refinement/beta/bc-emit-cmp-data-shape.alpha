        imm r21, 295
        imm r22, 41967
        call emit_cmp_require_fixed_event
        imm r20, 474
        imm r21, 297
        imm r22, 42156
        call emit_cmp_require_fixed_event

        ; set label, newline, and fall-through materialization.
        imm r20, 475
        imm r21, 298
        imm r22, 42225
        imm r23, 1
        imm r24, 1366                ; emit_lref
        imm r25, 42234
        call emit_cmp_require_call_event
        imm r20, 476
        imm r21, 298
        imm r22, 42264
        call emit_cmp_require_fixed_event
        imm r20, 477
        imm r21, 298
        imm r22, 42434
        call emit_cmp_require_fixed_event
        imm r20, 478
        imm r21, 299
        imm r22, 42490
        call emit_cmp_require_fixed_event

        ; Jump, done/set labels, and branch-taken materialization.
        imm r20, 479
        imm r21, 300
        imm r22, 42541
        call emit_cmp_require_fixed_event
        imm r20, 480
        imm r21, 300
        imm r22, 42601
        imm r23, 1
        imm r24, 1366
        imm r25, 42610
        call emit_cmp_require_call_event
        imm r20, 481
        imm r21, 300
        imm r22, 42640
        call emit_cmp_require_fixed_event
        imm r20, 482
        imm r21, 300
        imm r22, 42700
        imm r23, 1
        imm r24, 1366
        imm r25, 42709
        call emit_cmp_require_call_event
        imm r20, 483
        imm r21, 300
        imm r22, 42740
        call emit_cmp_require_fixed_event
        imm r20, 484
        imm r21, 300
        imm r22, 42910
        call emit_cmp_require_fixed_event
        imm r20, 485
        imm r21, 301
        imm r22, 42966
        call emit_cmp_require_fixed_event

        ; Final repeated done label and explicit return.
        imm r20, 486
        imm r21, 302
        imm r22, 43035
        imm r23, 1
        imm r24, 1366
        imm r25, 43044
        call emit_cmp_require_call_event
        imm r20, 487
        imm r21, 302
        imm r22, 43075
        call emit_cmp_require_fixed_event
        imm r20, 488
        imm r21, 302
        imm r22, 5
        imm r23, 43113
        call exact_require_event
        ret

