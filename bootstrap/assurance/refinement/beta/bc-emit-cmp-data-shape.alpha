; Exact effect/data shape and decoded census for emit_cmp(code), procedure60.

emit_cmp_require_data_shape:
        call emit_cmp_require_events
        call emit_cmp_require_locals
        call emit_cmp_require_primitives
        call emit_cmp_require_pushes
        call emit_cmp_require_censuses
        call emit_cmp_require_epilogues
        call emit_cmp_require_decoded
        ret

; r20=row, r21=block, r22=PC.
emit_cmp_require_fixed_event:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r20, r30
        mov r21, r31
        imm r22, 4                    ; source emit("...")
        mov r23, r32
        call exact_require_event
        ret

; r20=row, r21=block, r22=PC, r23=arity, r24=target, r25=continuation.
emit_cmp_require_call_event:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r20, r30
        mov r21, r31
        mov r22, r32
        mov r23, r33
        imm r24, 0                    ; no ambient staged word at call
        mov r25, r34
        mov r26, r35
        call summary_require_call_site
        ret

emit_cmp_require_events:
        ; Fixed stack-pop text and the two label allocations.
        imm r20, 463
        imm r21, 285
        imm r22, 40829
        call emit_cmp_require_fixed_event
        imm r20, 464
        imm r21, 285
        imm r22, 40879
        call emit_cmp_require_fixed_event
        imm r20, 465
        imm r21, 285
        imm r22, 40926
        call emit_cmp_require_fixed_event
        imm r20, 466
        imm r21, 285
        imm r22, 40975
        call emit_cmp_require_fixed_event
        imm r20, 467
        imm r21, 285
        imm r22, 40984
        imm r23, 0
        imm r24, 1131                ; new_label
        imm r25, 40993
        call emit_cmp_require_call_event
        imm r20, 468
        imm r21, 285
        imm r22, 41012
        imm r23, 0
        imm r24, 1131
        imm r25, 41021
        call emit_cmp_require_call_event

        ; The six exact comparison-opcode spellings.
        imm r20, 469
        imm r21, 287
        imm r22, 41211
        call emit_cmp_require_fixed_event
        imm r20, 470
        imm r21, 289
        imm r22, 41400
        call emit_cmp_require_fixed_event
