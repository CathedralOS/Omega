; Exact control/frame/effect shape for procedure35 name_eq(i).
; Data-expression ownership lives in bc-name-eq-data-shape.alpha.

name_eq_require_shape:
        imm r20, 7151616
        imm r21, 35
        imm r22, 1                    ; parameter i
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 35
        imm r22, 5                    ; i,a,b,len,k
        call transfer_require_cell
        imm r20, 35
        call call_bounds_frame_bytes
        imm r1, 48                   ; exact proc35 frame bytes
        jeq r0, r1, name_eq_shape_blocks
        jmp reject

name_eq_shape_blocks:
        imm r20, 173
        imm r21, 24914                ; exact proc35 entry block
        call exact_require_block_pc
        imm r20, 174
        imm r21, 24965
        call exact_require_block_pc
        imm r20, 175
        imm r21, 25220
        call exact_require_block_pc
        imm r20, 176
        imm r21, 25459
        call exact_require_block_pc
        imm r20, 177
        imm r21, 25621
        call exact_require_block_pc
        imm r20, 178
        imm r21, 26064
        call exact_require_block_pc
        imm r20, 173
        imm r21, 178
        imm r22, 35
        call exact_require_proc_blocks
        call name_eq_require_transitions
        call name_eq_require_events
        ret

name_eq_require_transitions:
        imm r20, 129
        imm r21, 174
        imm r22, 1
        imm r23, 175
        imm r24, 25171                ; selected NAMELEN equals IDLEN
        call exact_require_transition
        imm r20, 130
        imm r21, 175
        imm r22, 0
        imm r23, 176
        imm r24, 25450
        call exact_require_transition
        imm r20, 131
        imm r21, 176
        imm r22, 1
        imm r23, 177
        imm r24, 25572                ; k < len
        call exact_require_transition
        imm r20, 132
        imm r21, 177
        imm r22, 1
        imm r23, 178
        imm r24, 25950                ; source bytes differ
        call exact_require_transition
        imm r20, 133
        imm r21, 177
        imm r22, 0
        imm r23, 176
        imm r24, 26055
        call exact_require_transition
        ret

name_eq_require_events:
        imm r20, 275
        imm r21, 174
        imm r22, 5
        imm r23, 25219                ; length mismatch returns zero
        call exact_require_event
        imm r20, 276
        imm r21, 176
        imm r22, 5
        imm r23, 25620                ; complete match returns one
        call exact_require_event
        imm r20, 277
        imm r21, 178
        imm r22, 5
        imm r23, 26093                ; byte mismatch returns zero
        call exact_require_event
        imm r20, 25200
        imm r21, 25219
        call exact_require_epilogue
        imm r20, 25601
        imm r21, 25620
        call exact_require_epilogue
        imm r20, 26074
        imm r21, 26093
        call exact_require_epilogue
        imm r20, 26094
        imm r21, 26113
        call exact_require_epilogue
        ret

name_eq_require_control_census:
        imm r20, 173
        imm r21, 178
        imm r22, 76
        imm r23, 90                  ; exclusive local row
        imm r24, 44
        imm r25, 51                  ; exclusive memory row
        imm r26, 129
        imm r27, 134                 ; exclusive transition row
        imm r28, 275
        imm r29, 278                 ; exclusive event row
        call exact_require_effect_census
        imm r20, 24914
        imm r21, 26114
        imm r22, 0                   ; no calls
        imm r23, 4                   ; three explicit plus synthetic return
        imm r24, 19                  ; prologue/local/temporary stores
        imm r30, 2                   ; the two bound SRC byte loads
        call name_eq_readonly_scan_region
        ret

; Exact decoded census for proc35. Unlike the generic quiet scanner this
; procedure necessarily performs two loadb operations, already bound to raw
; memory rows49/50 by the data-shape module. It remains output/input/halt-free,
; has no storeb, division, or remainder, and otherwise preserves the same
; call/return/store census contract.
name_eq_readonly_scan_region:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        mov r31, r30
        imm r10, 0
        imm r11, 0
        imm r12, 0
        imm r13, 0
name_eq_readonly_scan_loop:
        jlt r25, r26, name_eq_readonly_scan_pc
        jeq r10, r27, name_eq_readonly_scan_rets
        jmp reject
name_eq_readonly_scan_rets:
        jeq r11, r28, name_eq_readonly_scan_stores
        jmp reject
name_eq_readonly_scan_stores:
        jeq r12, r29, name_eq_readonly_scan_loadbs
        jmp reject
name_eq_readonly_scan_loadbs:
        jeq r13, r31, exact_shape_ok
        jmp reject
name_eq_readonly_scan_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, name_eq_readonly_scan_start
        jmp name_eq_readonly_scan_next
name_eq_readonly_scan_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, name_eq_readonly_scan_call
        imm r3, 20
        jeq r2, r3, name_eq_readonly_scan_ret
        imm r3, 11
        jeq r2, r3, name_eq_readonly_scan_store
        imm r3, 8                   ; loadb
        jeq r2, r3, name_eq_readonly_scan_loadb
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7                   ; mod
        jeq r2, r3, reject
        imm r3, 9
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        jmp name_eq_readonly_scan_next
name_eq_readonly_scan_call:
        imm r1, 1
        add r10, r1
        jmp name_eq_readonly_scan_next
name_eq_readonly_scan_ret:
        imm r1, 1
        add r11, r1
        jmp name_eq_readonly_scan_next
name_eq_readonly_scan_store:
        imm r1, 1
        add r12, r1
        jmp name_eq_readonly_scan_next
name_eq_readonly_scan_loadb:
        imm r1, 1
        add r13, r1
name_eq_readonly_scan_next:
        imm r1, 1
        add r25, r1
        jmp name_eq_readonly_scan_loop
