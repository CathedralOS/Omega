; Generic byte equality partition for every byte position in the nine keyword
; descriptors. Each descriptor byte is checked against all 256 possible IDCH
; results in source order and an independently reversed singleton test.
; Exact counts are 1 equal / 255 unequal. Cells 531208..531664; endpoint531672.

fixed_keyword_prove_byte_cases:
	call fixed_keyword_cases_reset
	imm r1, 531216
	imm r2, 15
	store r1, r2
fixed_keyword_cases_proc_loop:
	imm r1, 531216
	load r20, r1
	imm r2, 24
	jlt r20, r2, fixed_keyword_cases_proc
	jeq r20, r2, fixed_keyword_cases_publish
	jmp reject
fixed_keyword_cases_proc:
	call fixed_keyword_select_proc
	imm r1, 531224
	imm r2, 0
	store r1, r2
fixed_keyword_cases_position_loop:
	imm r1, 531224
	load r25, r1
	imm r1, 530368
	load r2, r1
	jlt r25, r2, fixed_keyword_cases_position
	jeq r25, r2, fixed_keyword_cases_next_proc
	jmp reject

fixed_keyword_cases_position:
	imm r1, 530440
	load r2, r1
	add r2, r25
	loadb r2, r2
	imm r1, 531240
	store r1, r2                  ; exact selected descriptor byte
	imm r1, 531232
	imm r2, 0
	store r1, r2
	imm r1, 531264
	store r1, r2
	imm r1, 531272
	store r1, r2
fixed_keyword_cases_byte_loop:
	imm r1, 531232
	load r25, r1
	imm r2, 256
	jlt r25, r2, fixed_keyword_cases_byte
	jeq r25, r2, fixed_keyword_cases_finish_position
	jmp reject

fixed_keyword_cases_byte:
	imm r1, 531240
	load r26, r1
	jeq r25, r26, fixed_keyword_cases_source_equal
	imm r27, 0
	jmp fixed_keyword_cases_source_store
fixed_keyword_cases_source_equal:
	imm r27, 1
fixed_keyword_cases_source_store:
	; Independent singleton orientation: descriptor first, IDCH byte second.
	jeq r26, r25, fixed_keyword_cases_spec_equal
	imm r28, 0
	jmp fixed_keyword_cases_spec_store
fixed_keyword_cases_spec_equal:
	imm r28, 1
fixed_keyword_cases_spec_store:
	jeq r27, r28, fixed_keyword_cases_results_equal
	jmp reject
fixed_keyword_cases_results_equal:
	mov r2, r27
	imm r3, 1
	jeq r2, r3, fixed_keyword_cases_count_equal
	imm r1, 531272
	load r2, r1
	add r2, r3
	store r1, r2
	jmp fixed_keyword_cases_next_byte
fixed_keyword_cases_count_equal:
	imm r1, 531264
	load r2, r1
	add r2, r3
	store r1, r2
fixed_keyword_cases_next_byte:
	imm r1, 531232
	load r2, r1
	imm r3, 1
	add r2, r3
	store r1, r2
	jmp fixed_keyword_cases_byte_loop

fixed_keyword_cases_finish_position:
	imm r20, 531264
	imm r21, 1                    ; singleton descriptor byte
	call cursor_require_cell
	imm r20, 531272
	imm r21, 255                  ; exact byte complement
	call cursor_require_cell
	call fixed_keyword_cases_select_position_base
	imm r1, 531224
	load r2, r1
	add r4, r2
	imm r3, 8
	mul r4, r3
	imm r3, 531288
	add r4, r3
	load r5, r4
	imm r3, 0
	jeq r5, r3, fixed_keyword_cases_position_fresh
	jmp reject
fixed_keyword_cases_position_fresh:
	imm r3, 1
	store r4, r3                  ; persistent descriptor-position proof
	imm r1, 531280
	load r2, r1
	add r2, r3
	store r1, r2
	imm r1, 531224
	load r2, r1
	add r2, r3
	store r1, r2
	jmp fixed_keyword_cases_position_loop

fixed_keyword_cases_next_proc:
	imm r1, 531216
	load r2, r1
	imm r3, 1
	add r2, r3
	store r1, r2
	jmp fixed_keyword_cases_proc_loop

fixed_keyword_cases_reset:
	imm r1, 531208
	imm r2, 0
fixed_keyword_cases_reset_loop:
	imm r3, 531672
	jlt r1, r3, fixed_keyword_cases_reset_cell
	ret
fixed_keyword_cases_reset_cell:
	store r1, r2
	imm r3, 8
	add r1, r3
	jmp fixed_keyword_cases_reset_loop

; Prefix byte counts for return/state/to/when/byte/word/read_byte/write_byte/emit.
fixed_keyword_cases_select_position_base:
	imm r1, 531216
	load r2, r1
	imm r3, 15
	imm r4, 0
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 16
	imm r4, 6                    ; state position-table base
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 17
	imm r4, 11
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 18
	imm r4, 13
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 19
	imm r4, 17
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 20
	imm r4, 21
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 21
	imm r4, 25
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 22
	imm r4, 34
	jeq r2, r3, fixed_keyword_cases_base_ok
	imm r3, 23
	imm r4, 44
	jeq r2, r3, fixed_keyword_cases_base_ok
	jmp reject
fixed_keyword_cases_base_ok:
	ret

fixed_keyword_cases_publish:
	imm r20, 531280
	imm r21, 48                   ; every descriptor position
	call cursor_require_cell
	imm r20, 531288
fixed_keyword_cases_publish_loop:
	imm r1, 531672
	jlt r20, r1, fixed_keyword_cases_publish_position
	imm r1, 531208
	imm r2, 1363888966           ; FKEQ
	store r1, r2
	ret
fixed_keyword_cases_publish_position:
	imm r21, 1
	call cursor_require_cell
	imm r1, 8
	add r20, r1
	jmp fixed_keyword_cases_publish_loop
