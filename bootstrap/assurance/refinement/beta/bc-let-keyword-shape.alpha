; Exact source/artifact shape for id_char(k) and is_let().
;
; This module owns only the identifier byte-load leaf and the four-stage `let`
; keyword recognizer: CFG, calls/arguments, locals, memory, primitives, pushes,
; frames, epilogues, and exhaustive row/decoded-region censuses. Relational
; identifier-slice and keyword meaning lives in the adjacent module.

let_keyword_require_shape:
        ; id_char has one parameter; is_let has none.
        imm r20, 7151616
        imm r21, 13
        imm r22, 1
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 13
        imm r22, 1
        call transfer_require_cell
        imm r20, 13
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, let_keyword_shape_is_let_frame
        jmp reject
let_keyword_shape_is_let_frame:
        imm r20, 7151616
        imm r21, 14
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 14
        imm r22, 0
        call transfer_require_cell
        imm r20, 14
        call call_bounds_frame_bytes
        imm r1, 8
        jeq r0, r1, let_keyword_shape_blocks
        jmp reject

let_keyword_shape_blocks:
