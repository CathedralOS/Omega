; Static frame-layout and call-unstaging extension for the whole-bc checker.
;
; The common source scan calls these routines while its exact proc/let/call
; tokens are live.  Procedure parameter/slot tables start at 7151616; call
; arities are stored beside the BCT3 event table at 7143424.

scan_proc_signature:
        call skip_trivia
        call current_byte
        imm r1, 40
        jeq r0, r1, proc_signature_open
        jmp reject
proc_signature_open:
        call advance_one
        call skip_trivia
        imm r8, 0                       ; parameter count
        call current_byte
        imm r1, 41
        jeq r0, r1, proc_signature_done
proc_signature_param:
        call current_byte
        mov r20, r0
        call is_ident_start
        imm r1, 1
        jeq r0, r1, proc_signature_ident
        jmp reject
proc_signature_ident:
        call read_ident
        mov r7, r8
        call add_source_local_decl
        imm r1, 1
        add r8, r1
        imm r2, 4
        jlt r2, r8, reject
        call skip_trivia
        call current_byte
        imm r1, 44
        jeq r0, r1, proc_signature_comma
        imm r1, 41
        jeq r0, r1, proc_signature_done
        jmp reject
proc_signature_comma:
        call advance_one
        call skip_trivia
        jmp proc_signature_param
proc_signature_done:
        call advance_one
        imm r1, 524344
        load r2, r1                     ; current procedure index
        imm r3, 8
        mul r2, r3
        imm r3, 7151616
        add r3, r2
        store r3, r8                    ; parameter count
        imm r3, 7159808
        add r3, r2
        store r3, r8                    ; slots begin with parameters
        imm r1, 524552
        load r2, r1
        add r2, r8
        store r1, r2
        ret

record_source_let:
        call next_ident
        imm r1, 524344
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r3, 7159808
        add r3, r2
        load r4, r3
        mov r8, r4
        mov r7, r8
        call add_source_local_decl
        mov r7, r8
        imm r6, 2
        call add_local_access
        imm r5, 1
        add r8, r5
        imm r6, 1025
        jlt r8, r6, source_let_room
        jmp reject
source_let_room:
        imm r1, 524344
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r3, 7159808
        add r3, r2
        store r3, r8
        imm r1, 524560
        load r2, r1
        add r2, r5
        store r1, r2
        ret

; Append current IOFF/ILEN as slot r7 in the current source procedure.
add_source_local_decl:
        imm r1, 524632
        load r2, r1
        imm r3, 1024
        jlt r2, r3, source_local_decl_room
        jmp reject
source_local_decl_room:
        mov r4, r2
        imm r5, 8
        mul r4, r5
        imm r5, 524344
        load r6, r5
        imm r5, 7200768
        add r5, r4
        store r5, r6                    ; procedure index
        imm r5, 524360
        load r6, r5
        imm r5, 7208960
        add r5, r4
        store r5, r6                    ; source name offset
        imm r5, 524368
        load r6, r5
        imm r5, 7217152
        add r5, r4
        store r5, r6                    ; source name length
        imm r5, 7225344
        add r5, r4
        store r5, r7                    ; source frame slot
        imm r3, 1
        add r2, r3
        imm r1, 524632
        store r1, r2
        ret

; Parse the current call's top-level arity, restoring the cursor so nested calls
; are still encountered independently by the outer lexical scan.
record_call_arity:
        imm r1, 524304
        load r2, r1
        imm r1, 524568
        store r1, r2
        call current_byte
        imm r1, 40
        jeq r0, r1, call_arity_open
        jmp reject
call_arity_open:
        call advance_one
        call skip_trivia
        call current_byte
        imm r1, 41
        jeq r0, r1, call_arity_zero
        imm r8, 1
        imm r9, 1                       ; parenthesis depth
        jmp call_arity_scan
call_arity_zero:
        imm r8, 0
        jmp call_arity_done
call_arity_scan:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 34
        jeq r0, r1, call_arity_string
        imm r1, 39
        jeq r0, r1, call_arity_char
        imm r1, 59
        jeq r0, r1, call_arity_comment
        imm r1, 40
        jeq r0, r1, call_arity_nested_open
        imm r1, 41
        jeq r0, r1, call_arity_close
        imm r1, 44
        jeq r0, r1, call_arity_comma
        call advance_one
        jmp call_arity_scan
call_arity_nested_open:
        imm r1, 1
        add r9, r1
        call advance_one
        jmp call_arity_scan
call_arity_close:
        imm r1, 1
        sub r9, r1
        imm r2, 0
        jeq r9, r2, call_arity_done
        call advance_one
        jmp call_arity_scan
call_arity_comma:
        imm r1, 1
        jeq r9, r1, call_arity_top_comma
        call advance_one
        jmp call_arity_scan
call_arity_top_comma:
        add r8, r1
        imm r2, 4
        jlt r2, r8, reject
        call advance_one
        jmp call_arity_scan
call_arity_string:
        call advance_one
call_arity_string_loop:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 92
        jeq r0, r1, call_arity_string_escape
        imm r1, 34
        jeq r0, r1, call_arity_string_end
        call advance_one
        jmp call_arity_string_loop
call_arity_string_escape:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
        jmp call_arity_string_loop
call_arity_string_end:
        call advance_one
        jmp call_arity_scan
call_arity_char:
        call advance_one
        call current_byte
        imm r1, 92
        jeq r0, r1, call_arity_char_escape
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
        jmp call_arity_char_close
call_arity_char_escape:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
call_arity_char_close:
        call current_byte
        imm r1, 39
        jeq r0, r1, call_arity_char_end
        jmp reject
call_arity_char_end:
        call advance_one
        jmp call_arity_scan
call_arity_comment:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 10
        jeq r0, r1, call_arity_scan
        call advance_one
        jmp call_arity_comment
call_arity_done:
        imm r1, 524528
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r3, 7143424
        add r3, r2
        store r3, r8
        imm r1, 524568
        load r2, r1
        imm r1, 524304
        store r1, r2
        mov r0, r8
        ret

count_ordinary_call_arity:
        imm r1, 0
        jeq r0, r1, count_ordinary_zero
        imm r1, 1
        jeq r0, r1, count_ordinary_one
        imm r1, 2
        jeq r0, r1, count_ordinary_two
        jmp reject
count_ordinary_zero:
        imm r1, 524576
        jmp increment_ordinary_arity
count_ordinary_one:
        imm r1, 524584
        jmp increment_ordinary_arity
count_ordinary_two:
        imm r1, 524592
increment_ordinary_arity:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

ident_is_let:
        imm r20, 3
        imm r21, literal_let
        jmp current_ident_equals_literal

literal_let:
        db "let"

; Check every source procedure's exact frame prologue, allocation, and ordered
; parameter stores at its already-validated entry block pc.
validate_frame_shapes_init:
        imm r10, 0                     ; block index
        imm r11, 0                     ; procedure count
        imm r26, 0                     ; total slots
        imm r27, 0                     ; zero-slot procedures
validate_frame_shapes_loop:
        imm r1, 355
        jlt r10, r1, validate_frame_block
        jmp validate_frame_shape_counts
validate_frame_block:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, validate_frame_entry
        jmp validate_frame_next
validate_frame_entry:
        imm r1, 3145728
        add r1, r12
        load r13, r1                    ; source procedure index
        mov r2, r13
        imm r1, 8
        mul r2, r1
        imm r1, 7151616
        add r1, r2
        load r8, r1                     ; parameters
        imm r1, 7159808
        add r1, r2
        load r9, r1                     ; total frame slots
        add r26, r9
        imm r1, 0
        jeq r9, r1, validate_frame_zero_slot
        jmp validate_frame_pc
validate_frame_zero_slot:
        imm r1, 1
        add r27, r1
validate_frame_pc:
        imm r1, 3235840
        add r1, r12
        load r6, r1                     ; prologue pc cursor

        mov r20, r6
        imm r21, 1
        call require_tape_byte
        mov r20, r6
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r6
        imm r1, 2
        add r20, r1
        imm r21, 8
        call require_tape_word
        mov r20, r6
        imm r1, 10
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r6
        imm r1, 11
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r6
        imm r1, 12
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r6
        imm r1, 13
        add r20, r1
        imm r21, 11
        call require_tape_byte
        mov r20, r6
        imm r1, 14
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r6
        imm r1, 15
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r6
        imm r1, 16
        add r20, r1
        imm r21, 2
        call require_tape_byte
        mov r20, r6
        imm r1, 17
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r6
        imm r1, 18
        add r20, r1
        imm r21, 15
        call require_tape_byte
        imm r1, 19
        add r6, r1
        imm r1, 0
        jeq r9, r1, validate_param_stores_init

        ; sub r15, slots*8 via r5
        mov r20, r6
        imm r21, 1
        call require_tape_byte
        mov r20, r6
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r6
        imm r1, 2
        add r20, r1
        mov r21, r9
        imm r1, 8
        mul r21, r1
        call require_tape_word
        mov r20, r6
        imm r1, 10
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r6
        imm r1, 11
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r6
        imm r1, 12
        add r20, r1
        imm r21, 5
        call require_tape_byte
        imm r1, 13
        add r6, r1

validate_param_stores_init:
        imm r7, 0                       ; parameter index
validate_param_store_loop:
        jlt r7, r8, validate_param_store
        imm r1, 1
        add r11, r1
        jmp validate_frame_next
validate_param_store:
        ; mov r5,r14
        mov r20, r6
        imm r21, 2
        call require_tape_byte
        mov r20, r6
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r6
        imm r1, 2
        add r20, r1
        imm r21, 14
        call require_tape_byte
        ; imm r4,8+8*k
        mov r20, r6
        imm r1, 3
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r6
        imm r1, 4
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r6
        imm r1, 5
        add r20, r1
        mov r21, r7
        imm r1, 1
        add r21, r1
        imm r1, 8
        mul r21, r1
        call require_tape_word
        ; sub r5,r4; store r5,r<k>
        mov r20, r6
        imm r1, 13
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r6
        imm r1, 14
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r6
        imm r1, 15
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r6
        imm r1, 16
        add r20, r1
        imm r21, 11
        call require_tape_byte
        mov r20, r6
        imm r1, 17
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r6
        imm r1, 18
        add r20, r1
        mov r21, r7
        call require_tape_byte
        imm r1, 19
        add r6, r1
        imm r1, 1
        add r7, r1
        jmp validate_param_store_loop

validate_frame_next:
        imm r1, 1
        add r10, r1
        jmp validate_frame_shapes_loop
validate_frame_shape_counts:
        imm r1, 70
        jeq r11, r1, validate_frame_slot_total
        jmp reject
validate_frame_slot_total:
        imm r1, 78
        jeq r26, r1, validate_frame_zero_total
        jmp reject
validate_frame_zero_total:
        imm r1, 23
        jeq r27, r1, validate_fallthrough_init
        jmp reject

; At an ordinary call pc, validate the contiguous top..bottom unstage into
; r(n-1)..r0.  Argument expression values and their earlier pushes remain open.
check_call_unstage:
        imm r1, 524544
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r3, 7143424
        add r3, r2
        load r8, r3                     ; arity
        imm r1, 3
        jlt r8, r1, call_unstage_arity_ok
        jmp reject
call_unstage_arity_ok:
        imm r1, 0
        jeq r8, r1, call_unstage_done
        mov r6, r8
        imm r1, 16
        mul r6, r1
        mov r7, r14
        sub r7, r6                      ; first pop macro
        mov r9, r8
        imm r1, 1
        sub r9, r1                      ; expected destination register
call_unstage_loop:
        ; load r<k>,r15
        mov r20, r7
        imm r21, 10
        call require_tape_byte
        mov r20, r7
        imm r1, 1
        add r20, r1
        mov r21, r9
        call require_tape_byte
        mov r20, r7
        imm r1, 2
        add r20, r1
        imm r21, 15
        call require_tape_byte
        ; imm r5,8
        mov r20, r7
        imm r1, 3
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r7
        imm r1, 4
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r7
        imm r1, 5
        add r20, r1
        imm r21, 8
        call require_tape_word
        ; add r15,r5
        mov r20, r7
        imm r1, 13
        add r20, r1
        imm r21, 3
        call require_tape_byte
        mov r20, r7
        imm r1, 14
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r7
        imm r1, 15
        add r20, r1
        imm r21, 5
        call require_tape_byte
        imm r1, 16
        add r7, r1
        imm r1, 0
        jeq r9, r1, call_unstage_done
        imm r1, 1
        sub r9, r1
        jmp call_unstage_loop
call_unstage_done:
        ret

check_resolved_call_arity:
        imm r1, 524544
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r3, 7143424
        add r3, r2
        load r4, r3                     ; source call arity
        imm r1, 524600
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r3, 7151616
        add r3, r2
        load r2, r3                     ; source callee parameter count
        jeq r4, r2, resolved_call_arity_ok
        jmp reject
resolved_call_arity_ok:
        ret

require_tape_byte:
        imm r1, 524296
        load r2, r1
        jlt r20, r2, require_tape_byte_range
        jmp reject
require_tape_byte_range:
        imm r1, 2097152
        add r1, r20
        loadb r2, r1
        jeq r2, r21, require_tape_ok
        jmp reject
require_tape_word:
        mov r1, r20
        imm r2, 8
        add r1, r2
        imm r2, 524296
        load r3, r2
        jlt r3, r1, reject
        imm r1, 2097152
        add r1, r20
        load r2, r1
        jeq r2, r21, require_tape_ok
        jmp reject
require_tape_ok:
        ret
