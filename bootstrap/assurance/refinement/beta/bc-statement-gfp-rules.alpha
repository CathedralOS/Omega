; Block-depth-stratified guarded greatest fixed point for p62..p67.
;
; Context rows are built from D=64 down to D=0.  The D=64 row closes without
; recursion.  A D<64 row may instantiate only the already-complete D+1 row for
; a nested state/block activation.  Repetition in the same p62 activation is
; closed coinductively: a completed p67 child, the mandatory post-child SWSQ,
; and the machine backedge contribute Tau before the recursive observation.
; Neither CUR movement nor stdout growth is a guard.
;
; Row D at 552000 + 128*D:
;   +0 D, +8 live depth, +16 kind, +24 terminal partition,
;   +32 base/successor custody, +40 p67 Ret/Div partition,
;   +48 post-child SWSQ, +56 completed-path Tau guard,
;   +64 no-CUR-productivity premise, +72 no-output-productivity premise,
;   +80 fixed-point kind (2 = nu), +88 terminal decrement exactly once,
;   +96 divergent activation does not decrement, +104 maximal trace prefix,
;   +112 resource provenance retained, +120 row completion.

statement_gfp_rules_init:
        call statement_gfp_require_imports
        call statement_gfp_build_depth64
        call statement_gfp_build_recursive_contexts
        call statement_gfp_require_contexts
        call statement_gfp_prove_resumptions
        call statement_gfp_publish
        jmp statement_family_publication_init

statement_gfp_require_imports:
        imm r20, 546156
        imm r21, 1414414675             ; SANT
        call exact_require_cell
        imm r20, 546108
        imm r21, 1480936513             ; ALEX: SWSQ/CBLE/ADVE schema
        call exact_require_cell
        imm r20, 546148
        imm r21, 1346917185             ; ASHP: exact p62..p67 shape
        call exact_require_cell
        imm r20, 546196
        imm r21, 1380078675             ; STBR finite p67 relation
        call exact_require_cell
        imm r20, 546204
        imm r21, 1347573587             ; SWRP p63/p65 Ret-or-Div wrappers
        call exact_require_cell
        ret

; D=64 takes p62's false depth guard.  It writes numeric252 with the distinct
; block-depth-exhaustion provenance, returns zero, leaves BLOCKDEPTH at64, and
; changes neither cursor nor stdout.  There is no child activation.
statement_gfp_build_depth64:
        imm r10, 552000
        imm r1, 64
        imm r2, 128
        mul r1, r2
        add r10, r1
        imm r2, 64
        store r10, r2                    ; D
        imm r1, 8
        add r10, r1
        store r10, r2                    ; live depth remains64
        imm r1, 8
        add r10, r1
        imm r2, 1
        store r10, r2                    ; base kind
        imm r1, 8
        add r10, r1
        store r10, r2                    ; one terminal: depth exhaustion
        imm r1, 8
        add r10, r1
        store r10, r2                    ; base sealed, no successor
        imm r1, 8
        add r10, r1
        store r10, r2                    ; no p67 child (base category)
        imm r1, 8
        add r10, r1
        store r10, r2                    ; no post-child call (base category)
        imm r1, 8
        add r10, r1
        store r10, r2                    ; finite completed machine path
        imm r1, 8
        add r10, r1
        store r10, r2                    ; no CUR-progress premise
        imm r1, 8
        add r10, r1
        store r10, r2                    ; no output-progress premise
        imm r1, 8
        add r10, r1
        imm r2, 2
        store r10, r2                    ; greatest fixed point family
        imm r1, 8
        add r10, r1
        imm r2, 1
        store r10, r2                    ; zero decrements at rejected entry
        imm r1, 8
        add r10, r1
        store r10, r2                    ; no divergent decrement premise
        imm r1, 8
        add r10, r1
        store r10, r2                    ; exact epsilon/maximal prefix
        imm r1, 8
        add r10, r1
        store r10, r2                    ; typed depth provenance retained
        imm r1, 8
        add r10, r1
        store r10, r2                    ; row complete
        ret

; Descend through admitted entry depths.  Each row first consumes completion of
; D+1.  Nested state calls therefore cannot create infinite depth: every nesting
; chain reaches the D=64 base.  Divergence, when present, is a loop at finite
; depth and may follow a finite nesting prefix.
statement_gfp_build_recursive_contexts:
        imm r10, 63
statement_gfp_build_recursive_loop:
        mov r11, r10
        imm r1, 1
        add r11, r1
        imm r2, 128
        mul r11, r2
        imm r1, 552120                 ; successor row completion field
        add r11, r1
        mov r20, r11
        imm r21, 1
        call exact_require_cell
        call statement_gfp_build_recursive_row
        jz r10, statement_gfp_build_recursive_done
        imm r1, 1
        sub r10, r1
        jmp statement_gfp_build_recursive_loop
statement_gfp_build_recursive_done:
        imm r1, 560320
        imm r2, 65
        store r1, r2                    ; exact completed row count
        ret

; r10=D<64.  All three finite p62 exits restore D exactly once: prior resource
; after SWSQ, close-brace after ADVE, and zero-byte EOF without consumption.
; A p67 Ret always runs SWSQ before the same-activation backedge.  A p67 Div
; lifts its trace with the D+1 frame live and performs no decrement.
statement_gfp_build_recursive_row:
        mov r12, r10
        imm r1, 128
        mul r12, r1
        imm r1, 552000
        add r12, r1
        store r12, r10                   ; D
        imm r1, 8
        add r12, r1
        mov r2, r10
        imm r1, 1
        add r2, r1
        store r12, r2                    ; exact live depth D+1
        imm r1, 8
        add r12, r1
        imm r2, 2
        store r12, r2                    ; recursive context kind
        imm r1, 8
        add r12, r1
        imm r2, 3
        store r12, r2                    ; resource/close/eof terminals
        imm r1, 8
        add r12, r1
        imm r2, 2
        store r12, r2                    ; successor D+1 consumed
        imm r1, 8
        add r12, r1
        store r12, r2                    ; p67 Ret and Div alternatives
        imm r1, 8
        add r12, r1
        imm r2, 1
        store r12, r2                    ; post-Ret SWSQ is mandatory
        imm r1, 8
        add r12, r1
        store r12, r2                    ; completed-path/backedge Tau guard
        imm r1, 8
        add r12, r1
        store r12, r2                    ; no cursor-productivity premise
        imm r1, 8
        add r12, r1
        store r12, r2                    ; no stdout-productivity premise
        imm r1, 8
        add r12, r1
        imm r2, 2
        store r12, r2                    ; nu, never least fixed point
        imm r1, 8
        add r12, r1
        imm r2, 1
        store r12, r2                    ; finite terminal decrements once
        imm r1, 8
        add r12, r1
        store r12, r2                    ; divergent activation no decrement
        imm r1, 8
        add r12, r1
        store r12, r2                    ; maximal Ret/Div trace prefix
        imm r1, 8
        add r12, r1
        store r12, r2                    ; numeric252 provenance not inferred
        imm r1, 8
        add r12, r1
        store r12, r2                    ; row complete
        ret

statement_gfp_require_contexts:
        imm r20, 560320
        imm r21, 65
        call exact_require_cell
        imm r10, 0
statement_gfp_require_context_loop:
        imm r1, 65
        jlt r10, r1, statement_gfp_require_context_row
        ret
statement_gfp_require_context_row:
        mov r11, r10
        imm r1, 128
        mul r11, r1
        imm r1, 552000
        add r11, r1
        mov r20, r11
        mov r21, r10
        call exact_require_cell            ; exact depth index
        imm r1, 8
        add r11, r1
        imm r1, 64
        jeq r10, r1, statement_gfp_require_base_fields
        call statement_gfp_require_recursive_fields
        jmp statement_gfp_require_context_next
statement_gfp_require_base_fields:
        call statement_gfp_require_base_row_fields
statement_gfp_require_context_next:
        imm r1, 1
        add r10, r1
        jmp statement_gfp_require_context_loop

; r11 points at +8. Every semantic field is consumed, so a changed category
; cannot survive merely because the row's final completion bit remains one.
statement_gfp_require_base_row_fields:
        imm r21, 64
        call statement_gfp_require_field   ; live depth
        imm r21, 1
        call statement_gfp_require_field   ; base kind
        call statement_gfp_require_field   ; one terminal
        call statement_gfp_require_field   ; sealed base
        call statement_gfp_require_field   ; no-child category
        call statement_gfp_require_field   ; no-post-child category
        call statement_gfp_require_field   ; completed finite path
        call statement_gfp_require_field   ; no CUR premise
        call statement_gfp_require_field   ; no stdout premise
        imm r21, 2
        call statement_gfp_require_field   ; nu
        imm r21, 1
        call statement_gfp_require_field   ; rejected-entry decrement category
        call statement_gfp_require_field   ; divergent decrement category
        call statement_gfp_require_field   ; maximal epsilon prefix
        call statement_gfp_require_field   ; resource provenance
        call statement_gfp_require_field   ; completion
        ret

statement_gfp_require_recursive_fields:
        mov r21, r10
        imm r1, 1
        add r21, r1
        call statement_gfp_require_field   ; live depth D+1
        imm r21, 2
        call statement_gfp_require_field   ; recursive kind
        imm r21, 3
        call statement_gfp_require_field   ; resource/close/eof
        imm r21, 2
        call statement_gfp_require_field   ; successor custody
        call statement_gfp_require_field   ; Ret/Div partition
        imm r21, 1
        call statement_gfp_require_field   ; post-child SWSQ
        call statement_gfp_require_field   ; Tau guard
        call statement_gfp_require_field   ; no CUR premise
        call statement_gfp_require_field   ; no stdout premise
        imm r21, 2
        call statement_gfp_require_field   ; nu
        imm r21, 1
        call statement_gfp_require_field   ; finite decrement once
        call statement_gfp_require_field   ; Div no decrement
        call statement_gfp_require_field   ; maximal prefix
        call statement_gfp_require_field   ; provenance retained
        call statement_gfp_require_field   ; completion
        ret

statement_gfp_require_field:
        mov r20, r11
        call exact_require_cell
        imm r1, 8
        add r11, r1
        ret

; Close the observation domain itself.  Tau is observable only as internal
; machine continuation, Put carries exact bytes, and Ret carries exact state.
; Tau^omega admits finite silent divergence; Put/Tau mixtures admit infinite
; stdout.  Maximality forbids truncating either a returning or divergent run.
statement_gfp_prove_resumptions:
        imm r1, 560328
        imm r2, 3
        store r1, r2                    ; Ret/Tau/Put constructors
        imm r1, 560336
        imm r2, 1
        store r1, r2                    ; finite silent divergence admitted
        imm r1, 560344
        store r1, r2                    ; finite-output then silent divergence
        imm r1, 560352
        store r1, r2                    ; infinite output admitted
        imm r1, 560360
        store r1, r2                    ; maximal prefix, no truncation
        imm r1, 560368
        store r1, r2                    ; cursor stasis admitted
        imm r1, 560376
        store r1, r2                    ; stdout stasis admitted
        imm r1, 560384
        store r1, r2                    ; child Ret guard is machine completion
        imm r1, 560392
        store r1, r2                    ; mandatory SWSQ precedes backedge
        imm r1, 560400
        store r1, r2                    ; nested depth finite by D+1 closure
        ret

statement_gfp_publish:
        imm r20, 552120                 ; D0 completion
        imm r21, 1
        call exact_require_cell
        imm r20, 560312                 ; D64 completion
        imm r21, 1
        call exact_require_cell
        imm r20, 560328
        imm r21, 3
        call exact_require_cell
        imm r10, 560336
statement_gfp_publish_observation_loop:
        imm r1, 560408
        jlt r10, r1, statement_gfp_publish_observation
        imm r1, 546212
        imm r2, 1346783059             ; SGFP
        store r1, r2
        imm r20, 546212
        imm r21, 1346783059
        call exact_require_cell
        ret
statement_gfp_publish_observation:
        mov r20, r10
        imm r21, 1
        call exact_require_cell
        imm r1, 8
        add r10, r1
        jmp statement_gfp_publish_observation_loop
