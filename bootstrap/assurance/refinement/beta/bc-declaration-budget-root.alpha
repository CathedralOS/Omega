; Root of the independent declaration-budget implication checker.
;
; DREM is proved only conditionally on exact publications reconstructed by
; Checker A, the statement implication, and PBOD over one immutable bundle.
; This executable records those publications as proposition schemas; it never
; imports another process's theorem cells as established facts.

stack_register_custody_init:
        imm r1, 632000
        imm r2, 1480938052             ; DREX identical-bundle implication root
        store r1, r2
        jmp declaration_budget_antecedent_init
