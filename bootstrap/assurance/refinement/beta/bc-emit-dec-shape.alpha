; Exact source/artifact shape for emit_dec(n).
;
; Procedure 40 owns four blocks, the n>=10 split, one recursive call, one
; direct digit write, explicit/synthetic returns, one parameter slot, exact
; arithmetic/comparison primitives and pushes, and exhaustive table/decoded
; censuses. The adjacent meaning module owns bounded quotient/remainder and
; canonical decimal-output induction.

emit_dec_require_shape:
        imm r20, 7151616
        imm r21, 40
        imm r22, 1                    ; n parameter
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 40
        imm r22, 1                    ; n parameter slot
        call transfer_require_cell
        imm r20, 40
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, emit_dec_shape_blocks
        jmp reject

emit_dec_shape_blocks:
        imm r20, 204
        imm r21, 29152
        call slurp_summary_require_block_pc
        imm r20, 205
        imm r21, 29203
        call slurp_summary_require_block_pc
        imm r20, 206
        imm r21, 29335
        call slurp_summary_require_block_pc
        imm r20, 207
        imm r21, 29452
        call slurp_summary_require_block_pc
        imm r20, 204
        imm r21, 207
        imm r22, 40
        call cursor_require_proc_blocks
        call emit_dec_require_transitions
        call emit_dec_require_events
        call emit_dec_require_locals
        call emit_dec_require_primitives
        call emit_dec_require_pushes
        call emit_dec_require_censuses
        ret

emit_dec_require_transitions:
        imm r20, 163
        imm r21, 205
        imm r22, 1
        imm r23, 206
        imm r24, 29307              ; checked n>=10 recursive guard
        call slurp_summary_require_transition
        imm r20, 164
        imm r21, 205
        imm r22, 0
        imm r23, 207
        imm r24, 29326              ; checked direct digit edge
        call slurp_summary_require_transition
        imm r20, 165
        imm r21, 206
        imm r22, 0
        imm r23, 207
        imm r24, 29443              ; checked post-recursion digit edge
        call slurp_summary_require_transition
        ret

emit_dec_require_events:
        imm r20, 308
        imm r21, 206
        imm r22, 29434
        imm r23, 1                   ; q argument
        imm r24, 0                   ; no ambient temporary
        imm r25, 29152               ; recursive emit_dec target
        imm r26, 29443               ; checked child continuation
        call summary_require_call_site
        imm r20, 309
        imm r21, 207
        imm r22, 3
        imm r23, 29567              ; checked direct digit write
        call slurp_summary_require_event
        imm r20, 310
        imm r21, 207
        imm r22, 5
        imm r23, 29598              ; checked source return zero
        call slurp_summary_require_event
        imm r20, 29579
        imm r21, 29598
        call slurp_summary_require_epilogue
        imm r20, 29599
        imm r21, 29618
        call slurp_summary_require_epilogue
        ret

emit_dec_require_locals:
        imm r20, 118
        imm r21, 205
        imm r22, 1
        imm r23, 0
        imm r24, 29203              ; guard n
        call transfer_require_local
        imm r20, 119
        imm r21, 206
        imm r22, 1
        imm r23, 0
        imm r24, 29335              ; quotient n
        call transfer_require_local
        imm r20, 120
        imm r21, 207
        imm r22, 1
        imm r23, 0
        imm r24, 29452              ; remainder n
        call transfer_require_local
        ret

emit_dec_require_primitives:
        imm r20, 523
        imm r21, 205
        imm r22, 3
        imm r23, 13                  ; n>=10
        imm r24, 29248
        call transfer_require_primitive
        imm r20, 524
        imm r21, 205
        imm r22, 1
        imm r23, 10
        imm r24, 29238
        call transfer_require_primitive
        imm r20, 525
        imm r21, 206
        imm r22, 2
        imm r23, 6                   ; n/10
        imm r24, 29380
        call transfer_require_primitive
        imm r20, 526
        imm r21, 206
        imm r22, 1
        imm r23, 10
        imm r24, 29370
        call transfer_require_primitive
        imm r20, 527
        imm r21, 207
        imm r22, 2
        imm r23, 7                   ; n%10
        imm r24, 29497
        call transfer_require_primitive
        imm r20, 528
        imm r21, 207
        imm r22, 1
        imm r23, 10
        imm r24, 29487
        call transfer_require_primitive
        imm r20, 529
        imm r21, 207
        imm r22, 2
        imm r23, 3                   ; remainder+'0'
        imm r24, 29545
        call transfer_require_primitive
        imm r20, 530
        imm r21, 207
        imm r22, 1
        imm r23, 48                  ; decimal digit zero
        imm r24, 29535
        call transfer_require_primitive
        imm r20, 531
        imm r21, 207
        imm r22, 1
        imm r23, 0
        imm r24, 29569
        call transfer_require_primitive
        ret

emit_dec_require_pushes:
        imm r20, 148
        imm r21, 205
        imm r22, 1
        imm r23, 29222              ; comparison-left n
        call transfer_require_push
        imm r20, 149
        imm r21, 206
        imm r22, 1
        imm r23, 29354              ; division-left n
        call transfer_require_push
        imm r20, 150
        imm r21, 207
        imm r22, 1
        imm r23, 29471              ; remainder-left n
        call transfer_require_push
        imm r20, 151
        imm r21, 207
        imm r22, 1
        imm r23, 29519              ; addition-left remainder
        call transfer_require_push
        imm r20, 315
        imm r21, 206
        imm r22, 2
        imm r23, 29402              ; recursive q argument
        call transfer_require_push
        ret

emit_dec_require_censuses:
        imm r20, 204
        imm r21, 207
        imm r22, 118
        imm r23, 121                 ; exclusive local row
        imm r24, 54
        imm r25, 54                  ; no raw-memory rows
        imm r26, 163
        imm r27, 166                 ; exclusive transition row
        imm r28, 308
        imm r29, 311                 ; exclusive event row
        call cursor_require_effect_census

        imm r20, 204
        imm r21, 207
        imm r22, 523
        imm r23, 532                 ; exclusive primitive row
        imm r24, 148
        imm r25, 152                 ; exclusive binary-push row
        imm r26, 315
        imm r27, 316                 ; exclusive argument-push row
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census

        imm r20, 29152
        imm r21, 29619
        imm r22, 1                   ; recursive call count
        imm r23, 2                   ; explicit and synthetic returns
        imm r24, 1                   ; direct write count
        imm r25, 1                   ; division count
        imm r26, 1                   ; remainder count
        call emit_dec_scan_region
        ret

; Full decoded census for the arithmetic/output leaf. Besides exact counts for
; its intentional call, returns, write, division and remainder, direct input or
; halt is forbidden. Source/table censuses above close all remaining effects.
emit_dec_scan_region:
        mov r27, r20                 ; cursor
        mov r28, r21                 ; exclusive end
        mov r29, r22                 ; expected calls
        imm r10, 0                   ; calls
        imm r11, 0                   ; returns
        imm r12, 0                   ; writes
        imm r13, 0                   ; divisions
        imm r14, 0                   ; remainders
        imm r15, 0                   ; frame/parameter/push stores
emit_dec_scan_loop:
        jlt r27, r28, emit_dec_scan_pc
        jeq r10, r29, emit_dec_scan_returns
        jmp reject
emit_dec_scan_returns:
        jeq r11, r23, emit_dec_scan_writes
        jmp reject
emit_dec_scan_writes:
        jeq r12, r24, emit_dec_scan_divisions
        jmp reject
emit_dec_scan_divisions:
        jeq r13, r25, emit_dec_scan_remainders
        jmp reject
emit_dec_scan_remainders:
        jeq r14, r26, emit_dec_scan_stores
        jmp reject
emit_dec_scan_stores:
        imm r1, 7                    ; checked exact target store count
        jeq r15, r1, emit_dec_scan_done
        jmp reject
emit_dec_scan_pc:
        imm r1, 4194304
        add r1, r27
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, emit_dec_scan_start
        jmp emit_dec_scan_next
emit_dec_scan_start:
        imm r1, 2097152
        add r1, r27
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, emit_dec_scan_call
        imm r3, 20
        jeq r2, r3, emit_dec_scan_return
        imm r3, 18
        jeq r2, r3, emit_dec_scan_write
        imm r3, 6
        jeq r2, r3, emit_dec_scan_div
        imm r3, 7
        jeq r2, r3, emit_dec_scan_mod
        imm r3, 11
        jeq r2, r3, emit_dec_scan_store
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 8
        jeq r2, r3, reject
        imm r3, 9
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        jmp emit_dec_scan_next
emit_dec_scan_call:
        imm r1, 1
        add r10, r1
        jmp emit_dec_scan_next
emit_dec_scan_return:
        imm r1, 1
        add r11, r1
        jmp emit_dec_scan_next
emit_dec_scan_write:
        imm r1, 1
        add r12, r1
        jmp emit_dec_scan_next
emit_dec_scan_div:
        imm r1, 1
        add r13, r1
        jmp emit_dec_scan_next
emit_dec_scan_mod:
        imm r1, 1
        add r14, r1
        jmp emit_dec_scan_next
emit_dec_scan_store:
        imm r1, 1
        add r15, r1
emit_dec_scan_next:
        imm r1, 1
        add r27, r1
        jmp emit_dec_scan_loop
emit_dec_scan_done:
        ret
