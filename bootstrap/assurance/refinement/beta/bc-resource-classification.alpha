; Typed checked-resource classification for exact bc under B_bc1.
;
; Seven origin rows are derived from exact guard schemas and the profile before
; their numeric process projection is recorded.  The two repeated kind pairs
; keep distinct origins.  PCAP retains Requested(nslots) through provenance
; cell528128 and the exact failure interval [1025,1048580]; it is never replaced
; by the lower bound.  RCLS classifies direct checked origins and their sticky
; ghost provenance.  The following root-loop theorem remains responsible for
; composing that provenance to maximal stdout and terminal Exhaust.
;
; Row at 604000 + 112*origin:
;   +0 origin, +8 ResourceKind, +16 limit, +24 request mode,
;   +32 request lower, +40 request upper, +48 request token/provenance,
;   +56 exact guard schema, +64 process projection,
;   +72 pre-overlap admission, +80 sticky provenance,
;   +88 owner trace/state custody, +96 guard/profile/request basis,
;   +104 completion.
; Request mode 1 is an exact literal (lower=upper=token). Mode 2 is the exact
; symbolic nslots expression named by token528128.

resource_classification_init:
        call resource_classification_require_imports
        call resource_classification_reset
        call resource_classification_build_rows
        call resource_classification_require_rows
        call resource_classification_require_census
        call resource_classification_require_metadata
        imm r1, 600024
        imm r2, 1397506898             ; RCLS
        store r1, r2
        imm r20, 600024
        imm r21, 1397506898
        call exact_require_cell
        imm r0, 0
        halt r0

resource_classification_require_imports:
        imm r20, 600000
        imm r21, 1481786194             ; RCRX
        call exact_require_cell
        imm r20, 600008
        imm r21, 1414414930             ; RANT
        call exact_require_cell
        imm r20, 600016
        imm r21, 827347522              ; BRP1
        call exact_require_cell
        ret

resource_classification_reset:
        imm r10, 604000
        imm r2, 0
resource_classification_reset_loop:
        imm r1, 604784
        jlt r10, r1, resource_classification_reset_one
        ret
resource_classification_reset_one:
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp resource_classification_reset_loop

resource_classification_build_rows:
        imm r10, 1                    ; source oversize origin
        imm r11, 1                    ; SourceBytes
        imm r12, 1048576
        imm r13, 1                    ; literal request
        imm r14, 1048577               ; first inadmissible source byte
        imm r15, 1048577
        imm r16, 1048577
        imm r17, 1                    ; exact source guard schema
        imm r18, 253                  ; separate process projection
        call resource_classification_store_row

        imm r10, 2                    ; gen_call fifth argument origin
        imm r11, 3                    ; CallArity / actual arguments
        imm r12, 4
        imm r13, 1
        imm r14, 5                     ; fifth actual argument
        imm r15, 5
        imm r16, 5
        imm r17, 2                    ; exact GCAL guard schema
        imm r18, 252
        call resource_classification_store_row

        imm r10, 3                    ; declare full-table origin
        imm r11, 2                    ; ProcedureLocalSlots / declare
        imm r12, 1024
        imm r13, 1
        imm r14, 1025                  ; first unavailable declaration slot
        imm r15, 1025
        imm r16, 1025
        imm r17, 3                    ; exact DCLS guard schema
        imm r18, 252
        call resource_classification_store_row

        imm r10, 4                    ; gen_expr depth origin
        imm r11, 4                    ; ExpressionCodegenDepth
        imm r12, 64
        imm r13, 1
        imm r14, 65                    ; first unavailable expression depth
        imm r15, 65
        imm r16, 65
        imm r17, 4                    ; exact GEXP D64 schema
        imm r18, 252
        call resource_classification_store_row

        imm r10, 5                    ; gen_stmts depth origin
        imm r11, 5                    ; BlockCodegenDepth
        imm r12, 64
        imm r13, 1
        imm r14, 65                    ; first unavailable block depth
        imm r15, 65
        imm r16, 65
        imm r17, 5                    ; exact GSBD D64 schema
        imm r18, 252
        call resource_classification_store_row

        imm r10, 6                    ; parse_proc fifth parameter origin
        imm r11, 3                    ; CallArity / formal parameters
        imm r12, 4
        imm r13, 1
        imm r14, 5                     ; fifth formal parameter
        imm r15, 5
        imm r16, 5
        imm r17, 6                    ; exact PLOP guard schema
        imm r18, 252
        call resource_classification_store_row

        imm r10, 7                    ; parse_proc nslots preflight origin
        imm r11, 2                    ; ProcedureLocalSlots / preflight
        imm r12, 1024
        imm r13, 2                    ; exact symbolic request
        imm r14, 1025
        imm r15, 1048580               ; proved nonwrapping nslots upper bound
        imm r16, 528128               ; Requested(nparams+count_lets())
        imm r17, 7                    ; exact PCAP guard schema
        imm r18, 252
        call resource_classification_store_row
        ret

; r10 origin,r11 kind,r12 limit,r13 mode,r14 lower,r15 upper,r16 token,
; r17 guard schema,r18 process projection.
resource_classification_store_row:
        call resource_classification_require_guard
        call resource_classification_require_profile
        call resource_classification_require_request
        mov r20, r10
        imm r1, 112
        mul r20, r1
        imm r1, 603888               ; origin1 begins at604000
        add r20, r1
        store r20, r10
        imm r1, 8
        add r20, r1
        store r20, r11
        add r20, r1
        store r20, r12
        add r20, r1
        store r20, r13
        add r20, r1
        store r20, r14
        add r20, r1
        store r20, r15
        add r20, r1
        store r20, r16
        add r20, r1
        store r20, r17
        add r20, r1
        store r20, r18                 ; projection follows classification
        add r20, r1
        imm r2, 1
        store r20, r2                  ; checked before overlapping write
        add r20, r1
        store r20, r2                  ; exact origin remains sticky
        add r20, r1
        store r20, r2                  ; owner trace/state/request custody
        add r20, r1
        store r20, r2                  ; basis is guard+profile+request
        add r20, r1
        store r20, r2                  ; row complete
        ret

resource_classification_require_guard:
        imm r1, 1
        jlt r10, r1, reject
        imm r1, 8
        jlt r10, r1, resource_classification_guard_address
        jmp reject
resource_classification_guard_address:
        mov r20, r10
        imm r1, 32
        mul r20, r1
        imm r1, 600968               ; origin1 row is601000
        add r20, r1
        load r2, r20
        imm r1, 0
        jeq r2, r1, reject
        imm r1, 8
        add r20, r1
        load r2, r20
        imm r3, 0
        jeq r2, r3, reject
        imm r1, 8
        add r20, r1
        load r2, r20
        jeq r2, r3, reject
        add r20, r1
        load r2, r20
        jeq r2, r3, reject
        ret

resource_classification_require_profile:
        imm r1, 1
        jlt r11, r1, reject
        imm r1, 6
        jlt r11, r1, resource_classification_profile_address
        jmp reject
resource_classification_profile_address:
        mov r20, r11
        imm r1, 16
        mul r20, r1
        imm r1, 601984               ; kind1 row is602000
        add r20, r1
        load r2, r20
        jeq r2, r11, resource_classification_profile_limit
        jmp reject
resource_classification_profile_limit:
        imm r1, 8
        add r20, r1
        load r2, r20
        jeq r2, r12, resource_classification_profile_ok
        jmp reject
resource_classification_profile_ok:
        ret

resource_classification_require_request:
        ; Every failure request is strictly greater than its profile limit.
        jlt r12, r14, resource_classification_request_order
        jmp reject
resource_classification_request_order:
        jlt r15, r14, reject
        imm r1, 1
        jeq r13, r1, resource_classification_literal_request
        imm r1, 2
        jeq r13, r1, resource_classification_symbolic_request
        jmp reject
resource_classification_literal_request:
        jeq r14, r15, resource_classification_literal_token
        jmp reject
resource_classification_literal_token:
        jeq r14, r16, resource_classification_request_ok
        jmp reject
resource_classification_symbolic_request:
        imm r1, 7
        jeq r10, r1, resource_classification_symbolic_token
        jmp reject
resource_classification_symbolic_token:
        imm r1, 528128
        jeq r16, r1, resource_classification_request_ok
        jmp reject
resource_classification_request_ok:
        ret

resource_classification_require_rows:
        imm r10, 1
resource_classification_require_rows_loop:
        imm r1, 8
        jlt r10, r1, resource_classification_require_expected
        ret
resource_classification_require_expected:
        call resource_classification_select_expected
        call resource_classification_require_expected_row
        imm r1, 1
        add r10, r1
        jmp resource_classification_require_rows_loop

; Reconstruct expected row r10 into r11..r18 independently of the build table.
resource_classification_select_expected:
        imm r1, 1
        jeq r10, r1, resource_expected_source
        imm r1, 2
        jeq r10, r1, resource_expected_call
        imm r1, 3
        jeq r10, r1, resource_expected_declare
        imm r1, 4
        jeq r10, r1, resource_expected_expr
        imm r1, 5
        jeq r10, r1, resource_expected_block
        imm r1, 6
        jeq r10, r1, resource_expected_params
        imm r1, 7
        jeq r10, r1, resource_expected_slots
        jmp reject
resource_expected_source:
        imm r11, 1
        imm r12, 1048576
        imm r13, 1
        imm r14, 1048577
        imm r15, 1048577
        imm r16, 1048577
        imm r17, 1
        imm r18, 253
        ret
resource_expected_call:
        imm r11, 3
        imm r12, 4
        imm r13, 1
        imm r14, 5
        imm r15, 5
        imm r16, 5
        imm r17, 2
        imm r18, 252
        ret
resource_expected_declare:
        imm r11, 2
        imm r12, 1024
        imm r13, 1
        imm r14, 1025
        imm r15, 1025
        imm r16, 1025
        imm r17, 3
        imm r18, 252
        ret
resource_expected_expr:
        imm r11, 4
        imm r12, 64
        imm r13, 1
        imm r14, 65
        imm r15, 65
        imm r16, 65
        imm r17, 4
        imm r18, 252
        ret
resource_expected_block:
        imm r11, 5
        imm r12, 64
        imm r13, 1
        imm r14, 65
        imm r15, 65
        imm r16, 65
        imm r17, 5
        imm r18, 252
        ret
resource_expected_params:
        imm r11, 3
        imm r12, 4
        imm r13, 1
        imm r14, 5
        imm r15, 5
        imm r16, 5
        imm r17, 6
        imm r18, 252
        ret
resource_expected_slots:
        imm r11, 2
        imm r12, 1024
        imm r13, 2
        imm r14, 1025
        imm r15, 1048580
        imm r16, 528128
        imm r17, 7
        imm r18, 252
        ret

resource_classification_require_expected_row:
        mov r20, r10
        imm r1, 112
        mul r20, r1
        imm r1, 603888
        add r20, r1
        mov r21, r10
        call exact_require_cell
        imm r1, 8
        add r20, r1
        mov r21, r11
        call exact_require_cell
        add r20, r1
        mov r21, r12
        call exact_require_cell
        add r20, r1
        mov r21, r13
        call exact_require_cell
        add r20, r1
        mov r21, r14
        call exact_require_cell
        add r20, r1
        mov r21, r15
        call exact_require_cell
        add r20, r1
        mov r21, r16
        call exact_require_cell
        add r20, r1
        mov r21, r17
        call exact_require_cell
        add r20, r1
        mov r21, r18
        call exact_require_cell
        imm r21, 1
        imm r22, 0
resource_classification_require_tail_loop:
        imm r1, 5
        jlt r22, r1, resource_classification_require_tail_field
        ret
resource_classification_require_tail_field:
        imm r1, 8
        add r20, r1
        call exact_require_cell
        imm r1, 1
        add r22, r1
        jmp resource_classification_require_tail_loop

resource_classification_require_census:
        ; Seven direct guard origins: six status252 writers plus source status253.
        imm r20, 601248               ; XRSC writer-count antecedent value
        imm r21, 7                    ; zero root + six literal252 writers
        call exact_require_cell

        ; Scan the completed rows rather than publishing expected constants as
        ; though they were an exhaustive census. r10 is origin; r11..r15 count
        ; kinds1..5, r16/r17 count projections252/253, and r18 counts origins.
        imm r10, 1
        imm r11, 0
        imm r12, 0
        imm r13, 0
        imm r14, 0
        imm r15, 0
        imm r16, 0
        imm r17, 0
        imm r18, 0
resource_classification_census_loop:
        imm r1, 8
        jlt r10, r1, resource_classification_census_row
        jmp resource_classification_census_done
resource_classification_census_row:
        mov r20, r10
        imm r1, 112
        mul r20, r1
        imm r1, 603896               ; origin1 ResourceKind is604008
        add r20, r1
        load r2, r20
        imm r1, 1
        jeq r2, r1, resource_classification_census_kind1
        imm r1, 2
        jeq r2, r1, resource_classification_census_kind2
        imm r1, 3
        jeq r2, r1, resource_classification_census_kind3
        imm r1, 4
        jeq r2, r1, resource_classification_census_kind4
        imm r1, 5
        jeq r2, r1, resource_classification_census_kind5
        jmp reject
resource_classification_census_kind1:
        imm r1, 1
        add r11, r1
        jmp resource_classification_census_projection
resource_classification_census_kind2:
        imm r1, 1
        add r12, r1
        jmp resource_classification_census_projection
resource_classification_census_kind3:
        imm r1, 1
        add r13, r1
        jmp resource_classification_census_projection
resource_classification_census_kind4:
        imm r1, 1
        add r14, r1
        jmp resource_classification_census_projection
resource_classification_census_kind5:
        imm r1, 1
        add r15, r1
resource_classification_census_projection:
        imm r1, 56                    ; kind+56 is projection
        add r20, r1
        load r2, r20
        imm r1, 252
        jeq r2, r1, resource_classification_census_projection252
        imm r1, 253
        jeq r2, r1, resource_classification_census_projection253
        jmp reject
resource_classification_census_projection252:
        imm r1, 1
        add r16, r1
        jmp resource_classification_census_next
resource_classification_census_projection253:
        imm r1, 1
        add r17, r1
resource_classification_census_next:
        imm r1, 1
        add r18, r1
        add r10, r1
        jmp resource_classification_census_loop
resource_classification_census_done:
        imm r1, 1
        jeq r11, r1, resource_census_local
        jmp reject
resource_census_local:
        imm r1, 2
        jeq r12, r1, resource_census_call
        jmp reject
resource_census_call:
        jeq r13, r1, resource_census_expr
        jmp reject
resource_census_expr:
        imm r1, 1
        jeq r14, r1, resource_census_block
        jmp reject
resource_census_block:
        jeq r15, r1, resource_census_252
        jmp reject
resource_census_252:
        imm r1, 6
        jeq r16, r1, resource_census_253
        jmp reject
resource_census_253:
        imm r1, 1
        jeq r17, r1, resource_census_total
        jmp reject
resource_census_total:
        imm r1, 7
        jeq r18, r1, resource_census_publish
        jmp reject
resource_census_publish:
        imm r1, 600032
        imm r2, 7                    ; exact checked origin count
        store r1, r2
        imm r1, 600040
        imm r2, 5                    ; exact ResourceKind count
        store r1, r2
        imm r1, 600048
        imm r2, 1                    ; never infer kind from projection
        store r1, r2
        ret

resource_classification_require_metadata:
        imm r20, 600032
        imm r21, 7                    ; exact checked origin count
        call exact_require_cell
        imm r20, 600040
        imm r21, 5                    ; exact ResourceKind count
        call exact_require_cell
        imm r20, 600048
        imm r21, 1                    ; classification basis excludes status
        call exact_require_cell
        ret
