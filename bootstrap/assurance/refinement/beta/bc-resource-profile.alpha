; Frozen B_bc1 checked-resource registry used by RCLS.
;
; ResourceKind tags are semantic profile identities, not status codes:
;   1 SourceBytes
;   2 ProcedureLocalSlots (paired local-name metadata / generated frame slots)
;   3 CallArity (formal parameters and actual arguments sharing r0..r3)
;   4 ExpressionCodegenDepth
;   5 BlockCodegenDepth
;
; Rows at 602000, stride16: kind, limit.

resource_profile_init:
        imm r20, 600008
        imm r21, 1414414930             ; RANT
        call exact_require_cell
        imm r10, 602000
        imm r11, 1
        imm r12, 1048576                ; SourceBytes
        call resource_profile_store_row
        imm r11, 2
        imm r12, 1024                   ; ProcedureLocalSlots
        call resource_profile_store_row
        imm r11, 3
        imm r12, 4                      ; CallArity
        call resource_profile_store_row
        imm r11, 4
        imm r12, 64                     ; ExpressionCodegenDepth
        call resource_profile_store_row
        imm r11, 5
        imm r12, 64                     ; BlockCodegenDepth
        call resource_profile_store_row
        imm r1, 602080
        jeq r10, r1, resource_profile_rows_done
        jmp reject
resource_profile_rows_done:
        call resource_profile_require_rows
        imm r1, 600016
        imm r2, 827347522              ; BRP1
        store r1, r2
        jmp resource_classification_init

resource_profile_store_row:
        store r10, r11
        imm r1, 8
        add r10, r1
        store r10, r12
        add r10, r1
        ret

resource_profile_require_rows:
        imm r10, 602000
        imm r11, 1
        imm r12, 1048576
        call resource_profile_require_row
        imm r11, 2
        imm r12, 1024
        call resource_profile_require_row
        imm r11, 3
        imm r12, 4
        call resource_profile_require_row
        imm r11, 4
        imm r12, 64
        call resource_profile_require_row
        imm r11, 5
        imm r12, 64
        call resource_profile_require_row
        imm r1, 602080
        jeq r10, r1, resource_profile_require_done
        jmp reject
resource_profile_require_done:
        ret

resource_profile_require_row:
        mov r20, r10
        mov r21, r11
        call exact_require_cell
        imm r1, 8
        add r10, r1
        mov r20, r10
        mov r21, r12
        call exact_require_cell
        add r10, r1
        ret
