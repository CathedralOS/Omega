ranged_schema_slurp:
        db "proc slurp() {\n"
        db "    let n = 0\n"
        db "    let c = read_byte()\n"
        db "    state loop { to body when (c >= 0)  to done }\n"
        db "    state body { to full when (n == 1048576)  byte[2097152 + n] = c  n = n + 1  c = read_byte()  to loop }\n"
        db "    state full { return 0 }\n"
        db "    state done {\n"
        db "        word[2097136] = n        ; LEN\n"
        db "        word[2097144] = 0        ; CUR\n"
        db "        word[2097128] = 0        ; NLOC\n"
        db "        word[2097104] = 0        ; LBL (label counter)\n"
        db "        word[2097080] = 0        ; EXPRDEPTH\n"
        db "        word[2097072] = 0        ; RESOURCE_FAIL\n"
        db "        word[2097064] = 0        ; BLOCKDEPTH\n"
        db "        return 1\n"
        db "    }\n"
        db "}\n"
        db "\n"
ranged_schema_declare:
        db "proc declare() {             ; declare a local named by IDOFF/IDLEN; return its slot\n"
        db "    let s = word[2097128]                          ; NLOC\n"
        db "    state room { to write when (s < 1024)  word[2097072] = 252  return 0 }\n"
        db "    state write {\n"
        db "    word[3145728 + s * 8] = word[2097120]          ; NAMEOFF[s] = IDOFF\n"
        db "    word[3153920 + s * 8] = word[2097112]          ; NAMELEN[s] = IDLEN\n"
        db "    word[2097128] = s + 1\n"
        db "    return s\n"
        db "    }\n"
        db "}\n"
        db "\n"
