; Beta-source bounds and separation premises for bc's three ranged raw stores.
;
; The preceding grammar-composition phase records only address classes which it
; independently proved from the exact source.  This phase exhaustively joins
; those records to all 95 source memory rows, freezes the two small induction
; schemas, checks their complete source and decoded CFG edge sets, and validates
; inductive interval facts for slurp.n and declare.s/NLOC. No witness field
; supplies value facts. Transfer through Alpha frame slots remains a later
; selective forward-simulation obligation.
;
; Address class: 10616832, fixed address: 10618880 (95 word rows).
; Eight interval rows [lo,hi], 16 bytes each: 10620928.

ranged_bounds_init:
        imm r0, 0
        imm r1, 525152
        store r1, r0                    ; fixed class count
        imm r1, 525160
        store r1, r0                    ; source range count
        imm r1, 525168
        store r1, r0                    ; nameoff range count
        imm r1, 525176
        store r1, r0                    ; namelen range count
        imm r1, 525184
        store r1, r0                    ; fixed NLOC writers
        imm r1, 525192
        store r1, r0                    ; fixed EXPRDEPTH writers
        imm r1, 525200
        store r1, r0                    ; fixed BLOCKDEPTH writers
        imm r1, 525208
        store r1, r0                    ; interval row cursor
        imm r10, 0
ranged_class_loop:
        imm r1, 101
        jlt r10, r1, ranged_class_row
        jmp ranged_class_counts
ranged_class_row:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7610368
        add r1, r12
        load r6, r1                     ; source memory kind
        imm r1, 10616832
        add r1, r12
        load r7, r1                     ; checked address class
        imm r1, 1
        jeq r6, r1, ranged_class_load
        imm r1, 2
        jeq r6, r1, ranged_class_store
        jmp reject
ranged_class_load:
        imm r1, 0
        jeq r7, r1, ranged_class_next
        jmp reject
ranged_class_store:
        imm r1, 1
        jeq r7, r1, ranged_class_fixed
        imm r1, 2
        jeq r7, r1, ranged_class_source
        imm r1, 3
        jeq r7, r1, ranged_class_nameoff
        imm r1, 4
        jeq r7, r1, ranged_class_namelen
        jmp reject
ranged_class_fixed:
        imm r1, 525152
        call ranged_increment
        imm r1, 10618880
        add r1, r12
        load r8, r1
        ; Recheck the fixed word interval and alignment before using it for the
        ; protected-writer inventory.
        imm r1, 2097064
        jlt r8, r1, reject
        imm r1, 2097145
        jlt r8, r1, ranged_class_fixed_aligned
        jmp reject
ranged_class_fixed_aligned:
        mov r0, r8
        imm r1, 8
        mod r0, r1
        imm r1, 0
        jeq r0, r1, ranged_class_fixed_protected
        jmp reject
ranged_class_fixed_protected:
        imm r1, 2097128
        jeq r8, r1, ranged_class_nloc_writer
        imm r1, 2097080
        jeq r8, r1, ranged_class_expr_writer
        imm r1, 2097064
        jeq r8, r1, ranged_class_block_writer
        jmp ranged_class_next
ranged_class_nloc_writer:
        imm r1, 525184
        call ranged_increment
        jmp ranged_class_next
ranged_class_expr_writer:
        imm r1, 525192
        call ranged_increment
        jmp ranged_class_next
ranged_class_block_writer:
        imm r1, 525200
        call ranged_increment
        jmp ranged_class_next
ranged_class_source:
        imm r1, 525160
        call ranged_increment
        jmp ranged_class_next
ranged_class_nameoff:
        imm r1, 525168
        call ranged_increment
        jmp ranged_class_next
ranged_class_namelen:
        imm r1, 525176
        call ranged_increment
ranged_class_next:
        imm r1, 1
        add r10, r1
        jmp ranged_class_loop

ranged_class_counts:
        imm r1, 525152
        load r2, r1
        imm r3, 33
        jeq r2, r3, ranged_source_count
        jmp reject
ranged_source_count:
        imm r1, 525160
        load r2, r1
        imm r3, 1
        jeq r2, r3, ranged_nameoff_count
        jmp reject
ranged_nameoff_count:
        imm r1, 525168
        load r2, r1
        imm r3, 1
        jeq r2, r3, ranged_namelen_count
        jmp reject
ranged_namelen_count:
        imm r1, 525176
        load r2, r1
        imm r3, 1
        jeq r2, r3, ranged_nloc_writer_count
        jmp reject
ranged_nloc_writer_count:
        imm r1, 525184
        load r2, r1
        imm r3, 3
        jeq r2, r3, ranged_expr_writer_count
        jmp reject
ranged_expr_writer_count:
        imm r1, 525192
        load r2, r1
        imm r3, 4
        jeq r2, r3, ranged_block_writer_count
        jmp reject
ranged_block_writer_count:
        imm r1, 525200
        load r2, r1
        imm r3, 5
        jeq r2, r3, ranged_require_schemas
        jmp reject

ranged_increment:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

ranged_require_schemas:
        imm r20, ranged_schema_slurp
        imm r21, 594
        call call_bounds_require_source_once
        imm r20, ranged_schema_declare
        imm r21, 428
        call call_bounds_require_source_once
        imm r20, ranged_schema_parse_proc_reset
        imm r21, 86
        call call_bounds_require_source_once
        jmp ranged_require_blocks

; Pin the complete target block partition before checking abstract edges.
ranged_require_blocks:
        imm r20, 0
        imm r21, 0
        imm r22, 0
        imm r23, ranged_literal_slurp
        imm r24, 5
        call ranged_require_block
        imm r20, 1
        imm r21, 0
        imm r22, 1
        imm r23, ranged_literal_loop
        imm r24, 4
        call ranged_require_block
        imm r20, 2
        imm r21, 0
        imm r22, 1
        imm r23, ranged_literal_body
        imm r24, 4
        call ranged_require_block
        imm r20, 3
        imm r21, 0
        imm r22, 1
        imm r23, ranged_literal_full
        imm r24, 4
        call ranged_require_block
        imm r20, 4
        imm r21, 0
        imm r22, 1
        imm r23, ranged_literal_done
        imm r24, 4
        call ranged_require_block
        imm r20, 170
        imm r21, 34
        imm r22, 0
        imm r23, ranged_literal_declare
        imm r24, 7
        call ranged_require_block
        imm r20, 171
        imm r21, 34
        imm r22, 1
        imm r23, ranged_literal_room
        imm r24, 4
        call ranged_require_block
        imm r20, 172
        imm r21, 34
        imm r22, 1
        imm r23, ranged_literal_write
        imm r24, 5
        call ranged_require_block
        jmp ranged_require_edges

; Block row r20, expected proc r21/kind r22/name literal r23/r24.
ranged_require_block:
        mov r12, r20
        imm r1, 8
        mul r12, r1
        imm r1, 3145728
        add r1, r12
        load r2, r1
        jeq r2, r21, ranged_require_block_kind
        jmp reject
ranged_require_block_kind:
        imm r1, 3178496
        add r1, r12
        load r2, r1
        jeq r2, r22, ranged_require_block_name
        jmp reject
ranged_require_block_name:
        imm r1, 3149824
        add r1, r12
        load r20, r1
        imm r1, 3153920
        add r1, r12
        load r21, r1
        mov r22, r24
        call source_name_equals_literal
        imm r1, 1
        jeq r0, r1, ranged_require_block_ok
        jmp reject
ranged_require_block_ok:
        ret

; Require the five target-procedure transitions and reject any additional one.
ranged_require_edges:
        imm r10, 0
ranged_edge_loop:
        imm r1, 293
        jlt r10, r1, ranged_edge_row
        jmp ranged_predecessor_boundaries
ranged_edge_row:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3215360
        add r1, r12
        load r6, r1
        imm r1, 1
        jeq r6, r1, ranged_edge_slurp_loop
        imm r1, 2
        jeq r6, r1, ranged_edge_slurp_body
        imm r1, 171
        jeq r6, r1, ranged_edge_declare_room
        ; No other block in either target procedure may own a transition.
        imm r1, 5
        jlt r6, r1, reject
        imm r1, 170
        jeq r6, r1, reject
        imm r1, 172
        jeq r6, r1, reject
        jmp ranged_edge_next
ranged_edge_slurp_loop:
        imm r1, 0
        jeq r10, r1, ranged_edge_expect_body_guard
        imm r1, 1
        jeq r10, r1, ranged_edge_expect_done_plain
        jmp reject
ranged_edge_slurp_body:
        imm r1, 2
        jeq r10, r1, ranged_edge_expect_full_guard
        imm r1, 3
        jeq r10, r1, ranged_edge_expect_loop_plain
        jmp reject
ranged_edge_declare_room:
        imm r1, 128
        jeq r10, r1, ranged_edge_expect_write_guard
        jmp reject
ranged_edge_expect_body_guard:
        imm r20, 2
        imm r21, 1
        jmp ranged_edge_expect_target_guard
ranged_edge_expect_done_plain:
        imm r20, 4
        imm r21, 0
        jmp ranged_edge_expect_target_guard
ranged_edge_expect_full_guard:
        imm r20, 3
        imm r21, 1
        jmp ranged_edge_expect_target_guard
ranged_edge_expect_loop_plain:
        imm r20, 1
        imm r21, 0
        jmp ranged_edge_expect_target_guard
ranged_edge_expect_write_guard:
        imm r20, 172
        imm r21, 1
ranged_edge_expect_target_guard:
        imm r1, 3231744
        add r1, r12
        load r2, r1
        jeq r2, r20, ranged_edge_expect_guard
        jmp reject
ranged_edge_expect_guard:
        imm r1, 3227648
        add r1, r12
        load r2, r1
        jeq r2, r21, ranged_edge_next
        jmp reject
ranged_edge_next:
        imm r1, 1
        add r10, r1
        jmp ranged_edge_loop

; Close the artifact predecessor side of the targeted induction.  The two
; procedure entries initialize their tracked locals immediately before the
; first state.  All other physical predecessors are terminating transfers, so
; none creates an unmodelled sequential edge into a target state.
ranged_predecessor_boundaries:
        imm r20, 1                    ; slurp c local-store row
        imm r21, 1                    ; slurp__loop block
        call ranged_require_local_store_boundary
        imm r20, 70                   ; declare s local-store row
        imm r21, 171                  ; declare__room block
        call ranged_require_local_store_boundary

        imm r20, 2                    ; slurp__body
        imm r21, 9
        imm r22, 12                   ; preceding jmp
        call ranged_require_physical_predecessor
        imm r20, 3                    ; slurp__full
        imm r21, 9
        imm r22, 12                   ; preceding jmp
        call ranged_require_physical_predecessor
        imm r20, 4                    ; slurp__done
        imm r21, 1
        imm r22, 20                   ; preceding ret
        call ranged_require_physical_predecessor
        imm r20, 172                  ; declare__write
        imm r21, 1
        imm r22, 20                   ; preceding ret
        call ranged_require_physical_predecessor
        jmp ranged_branch_scan_init

; Canonical local-store row r20 has exact 19-byte extent ending at block r21.
ranged_require_local_store_boundary:
        mov r12, r20
        imm r1, 8
        mul r12, r1
        imm r1, 7168000
        add r1, r12
        load r2, r1
        mov r3, r21
        imm r1, 1
        sub r3, r1
        jeq r2, r3, ranged_local_boundary_kind
        jmp reject
ranged_local_boundary_kind:
        imm r1, 7176192
        add r1, r12
        load r2, r1
        imm r3, 2
        jeq r2, r3, ranged_local_boundary_pc
        jmp reject
ranged_local_boundary_pc:
        imm r1, 7192576
        add r1, r12
        load r2, r1
        imm r1, 19
        add r2, r1
        mov r12, r21
        imm r1, 8
        mul r12, r1
        imm r1, 3235840
        add r1, r12
        load r3, r1
        jeq r2, r3, ranged_local_boundary_ok
        jmp reject
ranged_local_boundary_ok:
        ret

; Block r20 begins exactly r21 bytes after a decoded opcode-r22 predecessor.
ranged_require_physical_predecessor:
        mov r12, r20
        imm r1, 8
        mul r12, r1
        imm r1, 3235840
        add r1, r12
        load r6, r1
        sub r6, r21
        imm r1, 4194304
        add r1, r6
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, ranged_physical_predecessor_opcode
        jmp reject
ranged_physical_predecessor_opcode:
        imm r1, 2097152
        add r1, r6
        loadb r2, r1
        jeq r2, r22, ranged_physical_predecessor_ok
        jmp reject
ranged_physical_predecessor_ok:
        ret

; Independently inspect every decoded direct branch.  Any target equal to one
; of the six induction-state roots must be the already checked transition macro
; which owns that edge.  State 171 is entry-fallthrough-only and admits none.
ranged_branch_scan_init:
        imm r10, 0
ranged_branch_scan_loop:
        imm r1, 524296
        load r2, r1
        jlt r10, r2, ranged_branch_scan_pc
        jmp ranged_intervals_init
ranged_branch_scan_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, ranged_branch_scan_start
        jmp ranged_branch_scan_next
ranged_branch_scan_start:
        imm r1, 2097152
        add r1, r10
        loadb r7, r1
        imm r1, 12
        jeq r7, r1, ranged_branch_target_at_one
        imm r1, 13
        jeq r7, r1, ranged_branch_target_at_two
        imm r1, 14
        jeq r7, r1, ranged_branch_target_at_two
        imm r1, 15
        jeq r7, r1, ranged_branch_target_at_three
        imm r1, 16
        jeq r7, r1, ranged_branch_target_at_three
        jmp ranged_branch_scan_next
ranged_branch_target_at_one:
        imm r1, 2097153
        add r1, r10
        load r8, r1
        jmp ranged_branch_check_target
ranged_branch_target_at_two:
        imm r1, 2097154
        add r1, r10
        load r8, r1
        jmp ranged_branch_check_target
ranged_branch_target_at_three:
        imm r1, 2097155
        add r1, r10
        load r8, r1

ranged_branch_check_target:
        imm r20, 1
        call ranged_load_block_pc
        jeq r8, r0, ranged_branch_expect_loop
        imm r20, 2
        call ranged_load_block_pc
        jeq r8, r0, ranged_branch_expect_body
        imm r20, 3
        call ranged_load_block_pc
        jeq r8, r0, ranged_branch_expect_full
        imm r20, 4
        call ranged_load_block_pc
        jeq r8, r0, ranged_branch_expect_done
        imm r20, 171
        call ranged_load_block_pc
        jeq r8, r0, reject
        imm r20, 172
        call ranged_load_block_pc
        jeq r8, r0, ranged_branch_expect_write
        jmp ranged_branch_scan_next
ranged_branch_expect_loop:
        imm r20, 3
        imm r21, 0
        jmp ranged_branch_require_transition_pc
ranged_branch_expect_body:
        imm r20, 0
        imm r21, 10
        jmp ranged_branch_require_transition_pc
ranged_branch_expect_full:
        imm r20, 2
        imm r21, 10
        jmp ranged_branch_require_transition_pc
ranged_branch_expect_done:
        imm r20, 1
        imm r21, 0
        jmp ranged_branch_require_transition_pc
ranged_branch_expect_write:
        imm r20, 128
        imm r21, 10
ranged_branch_require_transition_pc:
        imm r1, 8
        mul r20, r1
        imm r1, 3239936
        add r1, r20
        load r2, r1
        add r2, r21
        jeq r10, r2, ranged_branch_scan_next
        jmp reject
ranged_branch_scan_next:
        imm r1, 1
        add r10, r1
        jmp ranged_branch_scan_loop

; Block row r20 -> artifact pc r0.
ranged_load_block_pc:
        imm r1, 8
        mul r20, r1
        imm r1, 3235840
        add r1, r20
        load r0, r1
        ret

; Candidate inductive facts. Rows 0..4 are slurp entry/loop/body/full/done;
; rows 5..7 are declare entry/room/write.
ranged_intervals_init:
        imm r20, 0
        imm r21, 0
        imm r22, 0
        call ranged_interval_store
ranged_interval_loop_candidate:
        imm r20, 1
        imm r21, 0
        imm r22, 1048576
        call ranged_interval_store
        imm r20, 2
        imm r21, 0
        imm r22, 1048576
        call ranged_interval_store
        imm r20, 3
        imm r21, 1048576
        imm r22, 1048576
        call ranged_interval_store
        imm r20, 4
        imm r21, 0
        imm r22, 1048576
        call ranged_interval_store
        imm r20, 5
        imm r21, 0
        imm r22, 1024
        call ranged_interval_store
        imm r20, 6
        imm r21, 0
        imm r22, 1024
        call ranged_interval_store
        imm r20, 7
        imm r21, 0
        imm r22, 1023
        call ranged_interval_store
        jmp ranged_check_induction

; row r20 <- [r21,r22], requiring a nonnegative ordered interval.
ranged_interval_store:
        mov r25, r20
        mov r23, r21
        mov r24, r22
        imm r1, 0
        jlt r23, r1, reject
        mov r20, r23
        mov r21, r24
        call ranged_require_le
        ; ranged_require_le preserves r25, the caller-selected row.
        mov r12, r25
        imm r1, 16
        mul r12, r1
        imm r1, 10620928
        add r1, r12
        store r1, r23
        imm r2, 8
        add r1, r2
        store r1, r24
        imm r1, 525208
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

ranged_check_induction:
        ; Fresh memory makes the interval-row counter zero initially; exactly
        ; eight stores above must have advanced it to eight.
        imm r1, 525208
        load r2, r1
        imm r3, 8
        jeq r2, r3, ranged_check_slurp_entry
        jmp reject
ranged_check_slurp_entry:
        ; n := 0; entry fallthrough is contained by loop invariant.
        imm r20, 0
        call ranged_interval_load
        imm r22, 1
        call ranged_interval_load_target
        call ranged_require_subset
        ; loop condition does not change n: both body and done receive it.
        imm r20, 1
        call ranged_interval_load
        imm r22, 2
        call ranged_interval_load_target
        call ranged_require_subset
        imm r20, 1
        call ranged_interval_load
        imm r22, 4
        call ranged_interval_load_target
        call ranged_require_subset
        ; Equality-taken edge refines to exactly the capacity.
        imm r20, 1048576
        imm r21, 1048576
        imm r22, 3
        call ranged_interval_load_target
        call ranged_require_subset
        ; Equality-false store edge is [0,capacity-1]; +1 closes the backedge.
        imm r20, 0
        imm r21, 1048575
        call ranged_check_source_store_interval
        ; The bound helper converts its inputs to addresses; restore the
        ; post-increment value interval before checking the loop backedge.
        imm r20, 1
        imm r21, 1048576
        imm r22, 1
        call ranged_interval_load_target
        call ranged_require_subset
        ; Initial zero memory and all three NLOC writers preserve [0,1024].
        imm r20, 0
        imm r21, 1024
        imm r22, 5
        call ranged_interval_load_target
        call ranged_require_subset
        imm r20, 5
        call ranged_interval_load
        imm r22, 6
        call ranged_interval_load_target
        call ranged_require_subset
        ; Taken signed guard is sound because s is already nonnegative.
        imm r20, 0
        imm r21, 1023
        imm r22, 7
        call ranged_interval_load_target
        call ranged_require_subset
        call ranged_check_name_store_intervals
        ; declare writes s+1, which remains inside global NLOC [0,1024].
        imm r20, 1
        imm r21, 1024
        imm r22, 0
        imm r23, 1024
        call ranged_require_subset
        jmp ranged_separation_profile

; Load source interval row r20 into r20/r21.
ranged_interval_load:
        mov r12, r20
        imm r1, 16
        mul r12, r1
        imm r1, 10620928
        add r1, r12
        load r20, r1
        imm r2, 8
        add r1, r2
        load r21, r1
        ret

; Load target row r22 into r22/r23.
ranged_interval_load_target:
        mov r12, r22
        imm r1, 16
        mul r12, r1
        imm r1, 10620928
        add r1, r12
        load r22, r1
        imm r2, 8
        add r1, r2
        load r23, r1
        ret

; [r20,r21] subset [r22,r23].
ranged_require_subset:
        mov r24, r20
        mov r25, r21
        mov r20, r22
        mov r21, r24
        call ranged_require_le
        mov r20, r25
        mov r21, r23
        call ranged_require_le
        ret

; Require signed nonnegative r20 <= r21.
ranged_require_le:
        jeq r20, r21, ranged_require_le_ok
        jlt r20, r21, ranged_require_le_ok
        jmp reject
ranged_require_le_ok:
        ret

; Source interval r20/r21 -> exact byte address interval and boundary check.
ranged_check_source_store_interval:
        imm r1, 2097152
        add r20, r1
        add r21, r1
        imm r1, 2097152
        jeq r20, r1, ranged_source_store_hi
        jmp reject
ranged_source_store_hi:
        imm r1, 3145728
        jlt r21, r1, ranged_source_store_ok
        jmp reject
ranged_source_store_ok:
        ret

ranged_check_name_store_intervals:
        ; s is [0,1023]. Multiplication/addition cannot wrap in this range.
        imm r20, 0
        imm r21, 1023
        imm r1, 8
        mul r20, r1
        mul r21, r1
        imm r1, 3145728
        add r20, r1
        add r21, r1
        imm r1, 7
        add r21, r1
        imm r1, 3145728
        jeq r20, r1, ranged_nameoff_hi
        jmp reject
ranged_nameoff_hi:
        imm r1, 3153920
        jlt r21, r1, ranged_namelen_interval
        jmp reject
ranged_namelen_interval:
        imm r20, 0
        imm r21, 1023
        imm r1, 8
        mul r20, r1
        mul r21, r1
        imm r1, 3153920
        add r20, r1
        add r21, r1
        imm r1, 7
        add r21, r1
        imm r1, 3153920
        jeq r20, r1, ranged_namelen_hi
        jmp reject
ranged_namelen_hi:
        imm r1, 3162112
        jlt r21, r1, ranged_name_intervals_ok
        jmp reject
ranged_name_intervals_ok:
        ret

ranged_separation_profile:
        ; Address-family regions are numerically disjoint. This does not prove
        ; that live r14/r15 or the hidden return pointer inhabit their reserved
        ; regions; those carried machine values remain a simulation obligation.
        imm r20, 2097144
        imm r1, 8
        add r20, r1
        imm r21, 2097152
        call ranged_require_le
        imm r20, 1048576
        imm r21, 2097064
        call ranged_require_le
        imm r20, 3162112
        imm r21, 67043328
        call ranged_require_le
        jmp frame_summary_init

ranged_literal_slurp:
        db "slurp"
ranged_literal_loop:
        db "loop"
ranged_literal_body:
