        imm r23, 3
        imm r24, 28216
        call transfer_require_local
        imm r20, 108
        imm r21, 195
        imm r22, 1
        imm r23, 3
        imm r24, 28339              ; c handed to is_alpha
        call transfer_require_local
        imm r20, 109
        imm r21, 196
        imm r22, 2
        imm r23, 1
        imm r24, 28531              ; eof depth = 0
        call transfer_require_local
        imm r20, 110
        imm r21, 199
        imm r22, 2
        imm r23, 1
        imm r24, 28662              ; open depth store
        call transfer_require_local
        imm r20, 111
        imm r21, 199
        imm r22, 1
        imm r23, 1
        imm r24, 28595              ; open depth load
        call transfer_require_local
        imm r20, 112
        imm r21, 200
        imm r22, 2
        imm r23, 1
        imm r24, 28766              ; close depth store
        call transfer_require_local
        imm r20, 113
        imm r21, 200
        imm r22, 1
        imm r23, 1
        imm r24, 28699              ; close depth load
        call transfer_require_local
        imm r20, 114
        imm r21, 202
        imm r22, 2
        imm r23, 2
        imm r24, 29001              ; count increment store
        call transfer_require_local
        imm r20, 115
        imm r21, 202
        imm r22, 1
        imm r23, 2
        imm r24, 28934
        call transfer_require_local
        imm r20, 116
        imm r21, 203
        imm r22, 1
        imm r23, 0
