; Exact local/memory/expression shape for count_lets().
;
; Procedure 39's control and calls live in the adjacent control-shape module.
; This phase rejoins all twenty locals, two fixed CUR memory sites, twenty-seven
; primitive rows, eleven binary pushes, one argument push, one store-address
; push, and closes the exhaustive expression census for blocks 193..203.

count_lets_shape_init:
        call count_lets_require_control_shape
        call count_lets_require_data_shape
        jmp count_lets_cases_init

count_lets_require_data_shape:
        call count_lets_require_locals
        call count_lets_require_memory
        call count_lets_require_primitives
        call count_lets_require_pushes
        call count_lets_require_expr_census
        ret

