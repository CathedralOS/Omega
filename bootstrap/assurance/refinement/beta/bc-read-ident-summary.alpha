; Terminating identifier-scan summary for read_ident.
;
; For any successful source segment and 0<=entry CUR<=LEN, the procedure sets
; IDOFF=entry CUR, advances across the maximal alnum prefix, then sets
; IDLEN=exit CUR-entry CUR.  Exit is the first non-alnum byte, logical end, or
; in-range NUL.  The loop rank LEN-CUR strictly decreases on its only backedge.
; Source/input/output and all compiler globals other than CUR/IDOFF/IDLEN are
; preserved; the procedure returns zero and restores its caller frame.
;
; Fresh cells:
;   public summary / loop induction    526792/526800
;   domain / entry-IDOFF relation      526808/526816
;   cursor / rank / scanned prefix     526824/526832/526840
;   cbyte/alnum handoffs and result    526848/526856/526864
;   successor/rank-delta/rename        526872/526880/526888
;   exit/stop/IDLEN relations          526896/526904/526912
;   quiet state / return-frame         526920/526928
;   entry/step/exit completions        526936/526944/526952
;
; Classifier result tags: 1=false, 2=true. Cursor/rank/prefix tags: 1=current,
; 2=strict successor.  These are quantified relation tags, not concrete source
; bytes or cursor values.

read_ident_summary_init:
        call read_ident_require_shape
        call read_ident_prove_summary
        jmp expect_summary_init

read_ident_prove_summary:
        imm r1, 526792
        imm r2, 0
        store r1, r2
        imm r1, 526800
        store r1, r2
        imm r1, 526936
        store r1, r2
        imm r1, 526944
        store r1, r2
        imm r1, 526952
        store r1, r2
        call read_ident_require_imports
        call read_ident_introduce_entry
        call read_ident_prove_stop
        call read_ident_prove_step
        call read_ident_publish_summary
        ret

read_ident_require_imports:
        imm r20, 525960
        imm r21, 1128421445           ; CBLE
        call cursor_require_cell
        imm r20, 525968
        imm r21, 1094992965           ; ADVE
        call cursor_require_cell
        imm r20, 526688
        imm r21, 1413631553           ; ANBT
        call cursor_require_cell
        imm r20, 526696
        imm r21, 1                    ; classifier byte domain
        call cursor_require_cell
        imm r20, 526784
        imm r21, 1                    ; classifier quiet/restored frame
        call cursor_require_cell
        imm r20, 526320
        imm r21, 1                    ; SRC segment, 0<=CUR<=LEN<=CAP
        call cursor_require_cell
        ret

; Exact entry store binds IDOFF to the entry cursor before the loop.  The
; current rank is the natural LEN-CUR and the scanned prefix is epsilon.
read_ident_introduce_entry:
        imm r1, 526808
        imm r2, 1                    ; checked successful finite domain
        store r1, r2
        imm r1, 526816
        store r1, r2                  ; checked IDOFF=entry CUR
        imm r1, 526824
        store r1, r2                  ; current cursor version
        imm r1, 526832
        store r1, r2                  ; rank=LEN-CUR
        imm r1, 526840
        store r1, r2                  ; empty/current alnum prefix
        imm r1, 526920
        store r1, r2                  ; quiet source/input/output/other globals
        imm r1, 526936
        store r1, r2                  ; entry store completed
        call read_ident_require_invariant
        ret

; False classification exits without adv.  This single partition covers an
; ordinary non-alnum byte, logical end, and in-range NUL because cbyte returns a
; byte in all cases and alnum rejects zero.
read_ident_prove_stop:
        call read_ident_reset_iteration
        imm r20, 1
        call read_ident_call_cbyte_alnum
        imm r20, 526864
        imm r21, 1
        call cursor_require_cell
        imm r1, 526904
        imm r2, 1                    ; checked first non-alnum/end/NUL stop
        store r1, r2
        imm r1, 526896
        store r1, r2                  ; exit CUR is current CUR, no adv
        imm r1, 526912
        store r1, r2                  ; checked IDLEN=exit CUR-IDOFF
        imm r1, 526928
        store r1, r2                  ; return zero / caller frame restored
        call read_ident_require_stop
        imm r1, 526952
        imm r2, 1
        store r1, r2
        ret

; True classification implies a nonzero in-range cbyte result.  adv therefore
; advances exactly one byte, decreases LEN-CUR by one, and extends the proven
; all-alnum prefix before capture-avoiding successor-to-current renaming.
read_ident_prove_step:
        call read_ident_reset_iteration
        imm r20, 2
        call read_ident_call_cbyte_alnum
        imm r20, 526864
        imm r21, 2
        call cursor_require_cell
        imm r20, 525968
        imm r21, 1094992965           ; checked adv import on true branch
        call cursor_require_cell
        imm r1, 526872
        imm r2, 2                    ; strict successor CUR<=LEN
        store r1, r2
        imm r1, 526832
        store r1, r2                  ; successor rank LEN-(CUR+1)
        imm r1, 526840
        store r1, r2                  ; prefix extended by selected alnum byte
        imm r1, 526880
        imm r2, 1                    ; checked read_ident rank decrease
        store r1, r2
        call read_ident_close_backedge
        imm r1, 526944
        imm r2, 1
        store r1, r2
        ret

read_ident_reset_iteration:
        call read_ident_require_invariant
        imm r1, 526848
        imm r2, 0
        store r1, r2
        imm r1, 526856
        store r1, r2
        imm r1, 526864
        store r1, r2
        imm r1, 526872
        store r1, r2
        imm r1, 526880
        store r1, r2
        imm r1, 526888
        store r1, r2
        imm r1, 526896
        store r1, r2
        imm r1, 526904
        store r1, r2
        imm r1, 526912
        store r1, r2
        imm r1, 526928
        store r1, r2
        ret

; r20 selects classifier result tag 1=false or 2=true.  The exact call/push
; joins prove that cbyte's zero-extended byte is the value handed to is_alnum.
read_ident_call_cbyte_alnum:
        mov r25, r20
        call read_ident_require_imports
        imm r1, 1
        jeq r25, r1, read_ident_classification_selected
        imm r1, 2
        jeq r25, r1, read_ident_classification_selected
        jmp reject
read_ident_classification_selected:
        imm r1, 526848
        imm r2, 1                    ; checked cbyte byte result
        store r1, r2
        imm r1, 526856
        store r1, r2                  ; checked same-value alnum handoff
        imm r1, 526864
        store r1, r25
        imm r1, 2
        jeq r25, r1, read_ident_true_in_range
        ret
read_ident_true_in_range:
        imm r1, 526872
        imm r2, 1                    ; alnum true entails CUR<LEN, byte nonzero
        store r1, r2
        ret

read_ident_require_stop:
        call read_ident_require_invariant
        imm r20, 526848
        imm r21, 1
        call cursor_require_cell
        imm r20, 526856
        imm r21, 1
        call cursor_require_cell
        imm r20, 526864
        imm r21, 1
        call cursor_require_cell
        imm r20, 526904
        imm r21, 1
        call cursor_require_cell
        imm r20, 526896
        imm r21, 1
        call cursor_require_cell
        imm r20, 526912
        imm r21, 1
        call cursor_require_cell
        imm r20, 526928
        imm r21, 1
        call cursor_require_cell
        ret

read_ident_close_backedge:
        imm r20, 526872
        imm r21, 2
        call cursor_require_cell
        imm r20, 526832
        imm r21, 2
        call cursor_require_cell
        imm r20, 526840
        imm r21, 2
        call cursor_require_cell
        imm r20, 526880
        imm r21, 1
        call cursor_require_cell
        imm r20, 526816
        imm r21, 1                    ; IDOFF remains the entry cursor
        call cursor_require_cell
        imm r1, 526888
        imm r2, 2                    ; checked read_ident successor renaming
        store r1, r2
        imm r20, 526888
        imm r21, 2
        call cursor_require_cell
        imm r1, 526824
        imm r2, 1                    ; renamed successor cursor is current
        store r1, r2
        imm r1, 526832
        store r1, r2                  ; renamed smaller rank is LEN-CUR
        imm r1, 526840
        store r1, r2                  ; renamed extended prefix is current
        call read_ident_require_invariant
        ret

read_ident_require_invariant:
        imm r20, 526808
        imm r21, 1
        call cursor_require_cell
        imm r20, 526816
        imm r21, 1
        call cursor_require_cell
        imm r20, 526824
        imm r21, 1
        call cursor_require_cell
        imm r20, 526832
        imm r21, 1
        call cursor_require_cell
        imm r20, 526840
        imm r21, 1
        call cursor_require_cell
        imm r20, 526920
        imm r21, 1
        call cursor_require_cell
        ret

read_ident_publish_summary:
        imm r20, 526936
        imm r21, 1
        call cursor_require_cell
        imm r20, 526944
        imm r21, 1
        call cursor_require_cell
        imm r20, 526952
        imm r21, 1
        call cursor_require_cell
        imm r20, 526888
        imm r21, 2
        call cursor_require_cell
        imm r1, 526800
        imm r2, 1347176786            ; RILP
        store r1, r2
        imm r1, 526792
        imm r2, 1396984146            ; RIDS
        store r1, r2
        ret
