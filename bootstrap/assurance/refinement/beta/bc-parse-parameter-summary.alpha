; Conditional bounded-parameter-loop summary for parse_proc.
;
; Entry is the post-`expect('('); skip_ws()` cutpoint with NLOC=0,
; RESOURCE_FAIL=0, a successful source segment, normalized CUR<=LEN, and saved
; procedure-name locals/globals. The loop accepts at most four parameter
; iterations. read_ident may scan an empty name and a comma is optional; declare
; still increments NLOC, so rank 4-NLOC decreases on every backedge. A close
; parenthesis exits successfully with 0<=NLOC<=4. Any fifth non-close item stores
; numeric status 252 and returns zero before output. Under NLOC<4, DCLS selects
; its room path, so the source paramfailed return is unreachable from this clean
; entry. Parameter table entries are the exact scanned IDOFF/IDLEN slices.
;
; Fresh cells:
;   public PLOP                                  527928
;   entry / loop invariant / NLOC / rank         527936..527960
;   parameter table / status / cursor / ID       527968..527992
;   quiet/frame                                  528000
;   close / full / comma / no-comma completions  528008..528032
;   declare-room fact / success / failure        528040..528056
;   separator classification                     528064
;
parse_parameter_summary_init:
        call parse_parameter_prove_summary
        jmp parse_capacity_summary_init

parse_parameter_prove_summary:
        imm r1, 527928
        imm r2, 0
        store r1, r2
        imm r1, 528008
        store r1, r2
        imm r1, 528016
        store r1, r2
        imm r1, 528024
        store r1, r2
        imm r1, 528032
        store r1, r2
        imm r1, 528040
        store r1, r2
        imm r1, 528048
        store r1, r2
        imm r1, 528056
        store r1, r2
        imm r1, 528064
        store r1, r2
        call parse_parameter_introduce_entry
        call parse_parameter_case_close
        call parse_parameter_case_full
        call parse_parameter_case_comma
        call parse_parameter_case_no_comma
        call parse_parameter_publish_summary
        ret

parse_parameter_introduce_entry:
        call parse_parameter_require_imports
        imm r1, 527936
        imm r2, 1                    ; checked clean post-open entry
        store r1, r2                  ; NLOC=0/status=0/CUR normalized
        imm r1, 527944
        store r1, r2                  ; loop invariant, 0<=NLOC<=4
        imm r1, 527952
        store r1, r2                  ; current NLOC parameter count
        imm r1, 527960
        store r1, r2                  ; natural rank 4-NLOC
        imm r1, 527968
        store r1, r2                  ; first NLOC table entries are parameters
        imm r1, 527976
        store r1, r2                  ; RESOURCE_FAIL remains zero
        imm r1, 527984
        store r1, r2                  ; current normalized cursor
        imm r1, 527992
        store r1, r2                  ; current identifier state
        imm r1, 528000
        store r1, r2                  ; output/source/input/name state quiet
        call parse_parameter_require_invariant
        ret

parse_parameter_reset_loop:
        imm r20, 527936
        imm r21, 1
        call cursor_require_cell
        imm r1, 527944
        imm r2, 1
        store r1, r2
        imm r1, 527952
        store r1, r2
        imm r1, 527960
        store r1, r2
        imm r1, 527968
        store r1, r2
        imm r1, 527976
        store r1, r2
        imm r1, 527984
        store r1, r2
        imm r1, 527992
        store r1, r2
        imm r1, 528064
        imm r2, 0
        store r1, r2
        call parse_parameter_require_invariant
        ret

; cbyte==')' is nonzero and therefore in range. ploop transfers to pdone
; without consuming it; NLOC/status/table/name snapshots are retained.
parse_parameter_case_close:
        call parse_parameter_reset_loop
        call parse_parameter_call_cbyte
        imm r1, 527984
        imm r2, 2                    ; checked exact close byte 41 at CUR<LEN
        store r1, r2
        imm r1, 528048
        imm r2, 1                    ; successful loop exit at close
        store r1, r2
        imm r20, 527952
        imm r21, 1
        call cursor_require_cell
        imm r20, 527968
        imm r21, 1
        call cursor_require_cell
        imm r20, 527976
        imm r21, 1
        call cursor_require_cell
        imm r20, 527984
        imm r21, 2                    ; close cursor/result preserved
        call cursor_require_cell
        imm r20, 527992
        imm r21, 1
        call cursor_require_cell
        imm r20, 528000
        imm r21, 1
        call cursor_require_cell
        imm r1, 528008
        imm r2, 1
        store r1, r2
        ret

; Non-close with NLOC=4 takes pbody's false room edge, stores numeric 252,
; returns zero, emits nothing, and restores the parse_proc caller frame.
parse_parameter_case_full:
        call parse_parameter_reset_loop
        call parse_parameter_call_cbyte
        imm r1, 527984
        imm r2, 3                    ; checked non-close byte/result
        store r1, r2
        imm r1, 527952
        imm r2, 4                    ; checked NLOC==4 on false NLOC<4 edge
        store r1, r2
        imm r1, 527976
        imm r2, 2                    ; RESOURCE_FAIL becomes numeric 252
        store r1, r2
        imm r1, 528056
        imm r2, 1                    ; return zero / output unchanged / frame
        store r1, r2
        imm r20, 527952
        imm r21, 4
        call cursor_require_cell
        imm r20, 527976
        imm r21, 2
        call cursor_require_cell
        imm r20, 527968
        imm r21, 1                    ; full path retains parameter prefix
        call cursor_require_cell
        imm r20, 527984
        imm r21, 3                    ; full path retains non-close cursor
        call cursor_require_cell
        imm r20, 527992
        imm r21, 1                    ; full path retains identifier state
        call cursor_require_cell
        imm r20, 528056
        imm r21, 1
        call cursor_require_cell
        imm r20, 528000
        imm r21, 1
        call cursor_require_cell
        imm r1, 528016
        imm r2, 1
        store r1, r2
        ret

parse_parameter_case_comma:
        imm r20, 1                    ; comma continuation
        imm r21, 528024
        call parse_parameter_case_room
        ret

parse_parameter_case_no_comma:
        imm r20, 2                    ; direct ploop continuation
        imm r21, 528032
        call parse_parameter_case_room
        ret

parse_parameter_case_room:
        mov r25, r20
        mov r26, r21
        call parse_parameter_reset_loop
        call parse_parameter_call_cbyte
        imm r1, 527984
        imm r2, 3                    ; non-close enters pbody
        store r1, r2
        imm r1, 527952
        imm r2, 2                    ; checked 0<=NLOC<4 room premise
        store r1, r2
        ; RIDS records the maximal (possibly empty) identifier. DCLS room stores
        ; that slice at table[NLOC], increments NLOC, and preserves status zero.
        imm r20, 526792
        imm r21, 1396984146           ; RIDS
        call cursor_require_cell
        imm r20, 527064
        imm r21, 1397506884           ; DCLS room theorem
        call cursor_require_cell
        imm r1, 528040
        imm r2, 1                    ; checked declare room, failure guard false
        store r1, r2
        imm r1, 527952
        imm r2, 2                    ; checked parameter-count successor
        store r1, r2                  ; exact NLOC successor <=4
        imm r1, 527968
        store r1, r2                  ; appended exact parameter slice
        imm r1, 527976
        imm r2, 1
        store r1, r2                  ; status remains zero
        imm r1, 527992
        imm r2, 2                    ; current ID is scanned parameter
        store r1, r2
        imm r1, 527960
        store r1, r2                  ; checked rank decrease by one
        mov r20, r25
        call parse_parameter_finish_separator
        call parse_parameter_close_backedge
        mov r1, r26
        imm r2, 1
        store r1, r2
        ret

parse_parameter_finish_separator:
        ; skip_ws leaves a normalized cursor. Exact comma cbyte is in range;
        ; comma mode consumes it and normalizes once more. No-comma mode may
        ; preserve CUR, but NLOC/rank has already progressed.
        mov r25, r20
        call parse_parameter_call_skip_ws
        call parse_parameter_call_cbyte
        mov r20, r25
        imm r1, 1
        jeq r20, r1, parse_parameter_separator_comma
        imm r1, 2
        jeq r20, r1, parse_parameter_separator_none
        jmp reject
parse_parameter_separator_comma:
        imm r1, 528064
        imm r2, 1                    ; checked cbyte result is exact comma 44
        store r1, r2
        imm r1, 527984
        imm r2, 5                    ; comma is nonzero, hence CUR<LEN
        store r1, r2
        call parse_parameter_call_adv
        call parse_parameter_call_skip_ws
        imm r1, 527984
        imm r2, 2                    ; checked comma consumed / normalized
        store r1, r2
        imm r20, 528064
        imm r21, 1
        call cursor_require_cell
        ret
parse_parameter_separator_none:
        imm r1, 528064
        imm r2, 2                    ; checked cbyte result is not comma
        store r1, r2
        imm r1, 527984
        imm r2, 2                    ; checked direct normalized cursor
        store r1, r2
        imm r20, 528064
        imm r21, 2
        call cursor_require_cell
        ret

parse_parameter_close_backedge:
        imm r20, 528040
        imm r21, 1
        call cursor_require_cell
        imm r20, 527952
        imm r21, 2
        call cursor_require_cell
        imm r20, 527960
        imm r21, 2
        call cursor_require_cell
        imm r20, 527968
        imm r21, 2
        call cursor_require_cell
        imm r20, 527976
        imm r21, 1
        call cursor_require_cell
        imm r20, 527984
        imm r21, 2
        call cursor_require_cell
        imm r20, 527992
        imm r21, 2
        call cursor_require_cell
        imm r20, 528000
        imm r21, 1
        call cursor_require_cell
        ; Rename successor NLOC, smaller rank, extended parameter-table prefix,
        ; normalized cursor, and current identifier state to loop-head variables.
        imm r1, 527952
        imm r2, 1                    ; checked NLOC successor renamed
        store r1, r2
        imm r1, 527960
        store r1, r2                  ; checked smaller 4-NLOC rank renamed
        imm r1, 527968
        store r1, r2                  ; parameter prefix renamed
        imm r1, 527984
        store r1, r2                  ; normalized cursor renamed
        imm r1, 527992
        store r1, r2                  ; current identifier state renamed
        imm r1, 527944
        store r1, r2                  ; loop invariant re-established
        call parse_parameter_require_invariant
        ret

parse_parameter_publish_summary:
        imm r20, 528008
        imm r21, 1
        call cursor_require_cell
        imm r20, 528016
        imm r21, 1
        call cursor_require_cell
        imm r20, 528024
        imm r21, 1
        call cursor_require_cell
        imm r20, 528032
        imm r21, 1
        call cursor_require_cell
        imm r20, 528040
        imm r21, 1
        call cursor_require_cell
        imm r20, 528048
        imm r21, 1
        call cursor_require_cell
        imm r20, 528056
        imm r21, 1
        call cursor_require_cell
        imm r1, 527928
        imm r2, 1347178320            ; PLOP
        store r1, r2
        ret

parse_parameter_require_invariant:
        imm r20, 527936
        imm r21, 1
        call cursor_require_cell
        imm r20, 527944
        imm r21, 1
        call cursor_require_cell
        imm r20, 527952
        imm r21, 1
        call cursor_require_cell
        imm r20, 527960
        imm r21, 1
        call cursor_require_cell
        imm r20, 527968
        imm r21, 1
        call cursor_require_cell
        imm r20, 527976
        imm r21, 1
        call cursor_require_cell
        imm r20, 527984
        imm r21, 1
        call cursor_require_cell
        imm r20, 527992
        imm r21, 1
        call cursor_require_cell
        imm r20, 528000
        imm r21, 1
        call cursor_require_cell
        ret

parse_parameter_require_imports:
        imm r20, 526320
        imm r21, 1                    ; checked successful slurp source segment
        call cursor_require_cell
        imm r20, 525960
        imm r21, 1128421445           ; CBYE
        call cursor_require_cell
        imm r20, 525968
        imm r21, 1094992965           ; ADVE
        call cursor_require_cell
        imm r20, 526216
        imm r21, 1398231888           ; SWSQ
        call cursor_require_cell
        imm r20, 526792
        imm r21, 1396984146           ; RIDS
        call cursor_require_cell
        imm r20, 527064
        imm r21, 1397506884           ; DCLS summary import
        call cursor_require_cell
        ret

parse_parameter_call_cbyte:
        imm r20, 525960
        imm r21, 1128421445
        call cursor_require_cell
        imm r20, 527984
        imm r21, 1
        call cursor_require_cell
        ret

parse_parameter_call_adv:
        imm r20, 525968
        imm r21, 1094992965
        call cursor_require_cell
        imm r20, 527984
        imm r21, 5                    ; checked in-range comma premise
        call cursor_require_cell
        ret

parse_parameter_call_skip_ws:
        imm r20, 526216
        imm r21, 1398231888
        call cursor_require_cell
        imm r1, 527984
        imm r2, 1                    ; normalized cursor in 0..LEN
        store r1, r2
        ret
