; Checker-C continuation after the shared absolute stack-potential theorem.
; The later WSTR-to-cursor bridge consumes SPOU, so this branch cannot silently
; inherit a process-local theorem from Checker A or Checker B.
bc_post_stack_potential:
        imm r1, 531840
        imm r2, 1431261267             ; SPOU
        store r1, r2
        jmp write_str_summary_init
