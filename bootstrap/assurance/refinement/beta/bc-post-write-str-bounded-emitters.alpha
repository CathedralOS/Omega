; Checker-C bridge from the independently re-executed WSTR theorem into the
; cursor leaves needed by gen_read_byte.  Cell525744 is introduced here as the
; tranche's explicit successful bounded source-segment premise; this does not
; claim or import a dynamic slurp execution from Checker A.
bc_post_write_str:
        imm r20, 531840
        imm r21, 1481003091             ; SPFX
        call exact_require_cell
        imm r20, 525816
        imm r21, 1465074514             ; WSTR
        call exact_require_cell
        imm r1, 525744
        imm r2, 1                       ; conditional successful source segment
        store r1, r2
        imm r1, 531848
        imm r2, 1430467159               ; W2CU
        store r1, r2
        jmp cursor_leaf_summary_init
