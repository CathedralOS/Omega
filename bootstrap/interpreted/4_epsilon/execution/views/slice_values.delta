
; A slice of a view keeps its ultimate backing. A slice of a non-place array
; shares the existing immutable value; it does not establish an array place.
(def epsilon_evaluator_slice_base ((value EpsilonRuntimeValue)
  (place EpsilonRuntimeOptionalPlace) (store EpsilonRuntimeStore)
  (output Bytes)) EpsilonEvaluatorOutcome
  (match value
    ((EpsilonRuntimeInteger integer) (EpsilonEvaluatorInternal 0))
    ((EpsilonRuntimeSumValue owner caseValue payloads) (EpsilonEvaluatorInternal 0))
    ((EpsilonRuntimeViewValue view)
      (EpsilonEvaluatorValue value NoEpsilonRuntimePlace store output))
    ((EpsilonRuntimeAggregate typeValue children)
      (match typeValue
        ((EpsilonArrayType start end element lengthValue)
          (let backing EpsilonRuntimeViewBacking
            (match place
              (NoEpsilonRuntimePlace (EpsilonRuntimeSnapshotBacking value))
              ((SomeEpsilonRuntimePlace arrayPlace)
                (EpsilonRuntimePlaceBacking arrayPlace)))
            (EpsilonEvaluatorValue
              (EpsilonRuntimeViewValue
                (EpsilonRuntimeViewAt backing element 0
                  (epsilon_integer_literal_value lengthValue)))
              NoEpsilonRuntimePlace store output)))
        ((EpsilonI32Type start end) (EpsilonEvaluatorInternal start))
        ((EpsilonU8Type start end) (EpsilonEvaluatorInternal start))
        ((EpsilonNeverType start end) (EpsilonEvaluatorInternal start))
        ((EpsilonNamedType start end name) (EpsilonEvaluatorInternal start))
        ((EpsilonViewType start end element) (EpsilonEvaluatorInternal start))))))

(def epsilon_evaluator_slice_bounds ((view EpsilonRuntimeView)
  (low Int) (high Int) (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorOutcome
  (if (if (lt low 0) 1
        (if (lt high low) 1
          (lt (epsilon_runtime_view_length view) high)))
    (EpsilonEvaluatorTrap 6 output)
    (match view
      ((EpsilonRuntimeViewAt backing element baseLow baseHigh)
        (EpsilonEvaluatorValue
          (EpsilonRuntimeViewValue
            (EpsilonRuntimeViewAt backing element (+ baseLow low)
              (+ baseLow high)))
          NoEpsilonRuntimePlace store output)))))
