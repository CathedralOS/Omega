
(def epsilon_runtime_projections_equal ((left EpsilonRuntimeProjection)
  (right EpsilonRuntimeProjection)) Int
  (match left
    ((EpsilonRuntimeField ownerStart ownerEnd memberStart memberEnd typeValue)
      (match right
        ((EpsilonRuntimeField otherOwnerStart otherOwnerEnd otherStart otherEnd
          otherType)
          (if (eq memberStart otherStart)
            (if (eq memberEnd otherEnd)
              (if (eq ownerStart otherOwnerStart) (eq ownerEnd otherOwnerEnd) 0)
              0)
            0))
        ((EpsilonRuntimeIndex index) 0)))
    ((EpsilonRuntimeIndex index)
      (match right
        ((EpsilonRuntimeField ownerStart ownerEnd memberStart memberEnd typeValue) 0)
        ((EpsilonRuntimeIndex otherIndex) (eq index otherIndex))))))

; The checked field ledger supplies owner/member custody. No source spelling
; lookup or declaration unpacking occurs during child comparison. Sum cases
; cannot enter this representation through the checked projection entrance.
(def epsilon_runtime_find_field_child ((projection EpsilonRuntimeProjection)
  (children EpsilonRuntimeFieldChildren)) EpsilonRuntimeValueLookup
  (match children
    (NoEpsilonRuntimeFieldChildren NoEpsilonRuntimeValue)
    ((MoreEpsilonRuntimeFieldChildren current value rest)
      (if (epsilon_runtime_projections_equal projection current)
        (SomeEpsilonRuntimeValue value)
        (epsilon_runtime_find_field_child projection rest)))))

(def epsilon_runtime_read_field_child ((projection EpsilonRuntimeProjection)
  (children EpsilonRuntimeChildren) (defaultValue EpsilonRuntimeValue))
  EpsilonRuntimeValueLookup
  (match children
    (NoEpsilonRuntimeChildren (SomeEpsilonRuntimeValue defaultValue))
    ((EpsilonRuntimeIndexedChildren extent tree) NoEpsilonRuntimeValue)
    ((EpsilonRuntimeRecordChildren fields)
      (match (epsilon_runtime_find_field_child projection fields)
        (NoEpsilonRuntimeValue (SomeEpsilonRuntimeValue defaultValue))
        ((SomeEpsilonRuntimeValue storedValue)
          (SomeEpsilonRuntimeValue storedValue))))))

(def epsilon_runtime_reverse_field_children ((input EpsilonRuntimeFieldChildren)
  (output EpsilonRuntimeFieldChildren)) EpsilonRuntimeFieldChildren
  (match input
    (NoEpsilonRuntimeFieldChildren output)
    ((MoreEpsilonRuntimeFieldChildren projection value rest)
      (epsilon_runtime_reverse_field_children rest
        (MoreEpsilonRuntimeFieldChildren projection value output)))))

(def epsilon_runtime_replace_field_child ((projection EpsilonRuntimeProjection)
  (value EpsilonRuntimeValue) (children EpsilonRuntimeFieldChildren)
  (prefix EpsilonRuntimeFieldChildren)) EpsilonRuntimeFieldChildren
  (match children
    (NoEpsilonRuntimeFieldChildren
      (epsilon_runtime_reverse_field_children prefix
        (MoreEpsilonRuntimeFieldChildren projection value NoEpsilonRuntimeFieldChildren)))
    ((MoreEpsilonRuntimeFieldChildren current previous rest)
      (if (epsilon_runtime_projections_equal projection current)
        (epsilon_runtime_reverse_field_children prefix
          (MoreEpsilonRuntimeFieldChildren current value rest))
        (epsilon_runtime_replace_field_child projection value rest
          (MoreEpsilonRuntimeFieldChildren current previous prefix))))))

(def epsilon_runtime_write_field_child ((typeValue EpsilonType)
  (projection EpsilonRuntimeProjection) (value EpsilonRuntimeValue)
  (children EpsilonRuntimeChildren))
  EpsilonRuntimeValueLookup
  (match children
    (NoEpsilonRuntimeChildren
      (SomeEpsilonRuntimeValue
        (EpsilonRuntimeAggregate typeValue
          (EpsilonRuntimeRecordChildren
            (MoreEpsilonRuntimeFieldChildren projection value NoEpsilonRuntimeFieldChildren)))))
    ((EpsilonRuntimeIndexedChildren extent tree) NoEpsilonRuntimeValue)
    ((EpsilonRuntimeRecordChildren fields)
      (SomeEpsilonRuntimeValue
        (EpsilonRuntimeAggregate typeValue
          (EpsilonRuntimeRecordChildren
            (epsilon_runtime_replace_field_child projection value fields
              NoEpsilonRuntimeFieldChildren)))))))
