(def $application () Int 1)

; Canonical DCREQ entry. Admission precedes every Delta-source observation.
(def main () Int
  (let admission Int (validate_compilation_request)
    (if (eq (first admission) 0)
      (let compilation Int (compile_admitted_source (second admission))
        (if (eq (first compilation) 0)
          (let published Int (write (second compilation))
            (pair 0 1))
          (publish_compiler_failure compilation)))
      (publish_compiler_failure admission))))

(def source_length () Int
  ; Exact-end admission established this immutable body extent: the sealed
  ; input ends with the bound support section after the declared source.
  (- (input) (+ 16 (support_packed_extent))))

(def source_read ((index Int)) Int
  (read (+ 16 index)))

(def compilation_profile () Int 1)
