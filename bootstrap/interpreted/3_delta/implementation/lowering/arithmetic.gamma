; Checked arithmetic retains the emitted l/r/z custody and guard shape. The
; operands are already lowered values; this layer neither walks source children
; nor publishes bytes. Shared generated atoms have the same source coordinate.
(def lowering_arithmetic ((node Int) (left_gamma Int) (right_gamma Int)) Int
  (let ((coordinate Int (syntax_start node))
        (left Int (gamma_generated 108 coordinate))
        (right Int (gamma_generated 114 coordinate))
        (result Int (gamma_generated 122 coordinate))
        (head Int (syntax_child node 0))
        (operation Int (gamma_call (gamma_literal head) 2 (pair left (pair right 0))))
        (byte Int (source_read (syntax_start head)))
        (guard Int (if (eq byte 42)
            (lowering_multiply_guard left right result)
            (lowering_add_sub_guard left right result (eq byte 45)))))
    (gamma_let left left_gamma
      (gamma_let right right_gamma
        (gamma_let result operation guard)))))

(def lowering_add_sub_guard
  ((left Int) (right Int) (result Int) (subtract Int)) Int
  (let ((zero Int (gamma_integer 0))
        (trap Int (gamma_trap))
        (result_below_left Int (gamma_if (gamma_lt result left) trap result))
        (left_below_result Int (gamma_if (gamma_lt left result) trap result)))
    (gamma_if (gamma_lt zero right)
      (if subtract left_below_result result_below_left)
      (gamma_if (gamma_lt right zero)
        (if subtract result_below_left left_below_result)
        result))))

(def lowering_multiply_guard ((left Int) (right Int) (result Int)) Int
  (let ((zero Int (gamma_integer 0))
        (quotient Int (gamma_call (gamma_word 47 1) 2 (pair result (pair left 0)))))
    (gamma_if (gamma_eq left zero) result
      (gamma_if (gamma_eq quotient right) result (gamma_trap)))))
