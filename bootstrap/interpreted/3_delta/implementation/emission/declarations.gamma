(def emit_definition ((definition Int) (publish Int) (written Int)) Int
  (let ((prefix Int (emit_ascii 139156874280 5 publish written))
        (name Int (emit_gamma_atom (gamma_definition_name definition) publish prefix))
        (separator Int (emit_character '\s' publish name))
        (open Int (emit_character '(' publish separator))
        (parameters Int (emit_parameters (gamma_definition_parameter_count definition)
            (gamma_definition_parameters definition) publish open))
        (close Int (emit_character ')' publish parameters))
        (result_space Int (emit_character '\s' publish close))
        (result_type Int (emit_int_word publish result_space))
        (body_space Int (emit_character '\s' publish result_type))
        (body Int (emit_expression (gamma_definition_body definition)
            publish body_space)))
    (emit_character ')' publish body)))

(def emit_parameters
  ((count Int) (parameters Int) (publish Int) (written Int)) Int
  (if (eq count 0)
    written
    (let ((open Int (emit_character '(' publish written))
          (name Int (emit_gamma_atom (first parameters) publish open))
          (separator Int (emit_character '\s' publish name))
          (annotation Int (emit_int_word publish separator))
          (close Int (emit_character ')' publish annotation)))
      (if (eq count 1)
        close
        (let next_space Int (emit_character '\s' publish close)
          (emit_parameters (- count 1) (second parameters)
            publish next_space))))))
