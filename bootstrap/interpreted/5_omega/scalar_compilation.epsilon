// Every checked expression chooses one realization. The named form carries
// its expression/operand handle in value_payloads; no emitter guesses meaning
// from a numeric tag or from the source spelling.
data OmegaCheckedValueKind {
    case Unchecked;
    case Literal;
    case Call;
    case BooleanBinary;
    case LogicalNot;
    case RepresentationCast;
    case Place;
    case Borrow;
    case RecordLiteral;
    case IndexedRead;
    case ForwardedReference;
    case ExactAddition;
    case TrappingArithmetic;
    case NullaryCase;
}

data OmegaScalarCompilationStatus {
    case Pending;
    case Complete;
    case Reject;
    case Incomplete;
    case ResourceFailure;
    case InternalFailure;
}

// This source-owned, toolchain-core catalog realizes the fixed-u8 subset of
// the normative sealed indexing family. Its version-1 identities are schema
// 1: copy-read (&[u8; N], u64) -> u8, requiring index < N and shared readable
// backing; schema 2: indexed place (&mut [u8; N], u64) -> exclusive writable
// u8 storage at that exact collection/index, requiring index < N and a valid
// exclusive parent loan. Both instantiate Element=u8 (copy) and the exact N;
// neither adds reach/crash routes. Schema 2 returns a place, never a copy-read
// value dressed as storage. The scoped loan must close and restore the owner's
// original qualification. Only explicit Trapping removal views are admitted;
// their known empty establishment debt does not erase backing/loan duties.
// Array-shell adaptation preserves element type and domains. Authored names or
// signatures cannot mint these core identities. This closed catalog is not a
// claim that general package/operator declaration admission has been built.
// Plans retain concrete selection, capture sites, parent lineage and standing
// bound evidence. Occurrence coordinates are not general mutable-value facts:
// proofs below use immutable snapshots or predicates preserved by every write.
// This is internal checked lowering, not a published Terminal Psi certificate.
data OmegaByteIndexPlan {
    schema: i32;
    array_type: i32;
    element_type: i32;
    extent: i32;
    collection: i32;
    selector: i32;
    owner_state: i32;
    before: i32;
    parent_root: i32;
    parent_offset: i32;
    parent_extent: i32;
    access: i32;
    removed_trapping: i32;
    bound_kind: i32;
    bound_source: i32;
    bound_limit: i32;
}

data OmegaScalarCompiler {
    import_bindings: [OmegaImportBinding; 4096];
    query_path: OmegaNamePath;
    address_path: OmegaNamePath;
    entry_unit: i32;
    parser: OmegaParser;
    tape: AlphaTapeBuffer;
    status: OmegaScalarCompilationStatus;
    // Durable current declaration anchor; scanners never overwrite it.
    diagnostic_offset: i32;
    // Decimal scanning cursor, used only for an unsupported digit diagnostic.
    literal_offset: i32;
    // Durable first-arrow anchor for the current transition block.
    transition_anchor: i32;
    selected_machine: i32;
    machine_labels: [i32; 4096];
    // Checked terminal forms: 3 = selected transition row, 4 = value
    // expression result, 5 = dynamic Boolean or nullary-sum transition, 6 = Unit
    // completion after every statement. state_targets
    // holds the row/expression/first-statement index; state_values is the
    // exclusive statement end for kind 5.
    state_labels: [i32; 4096];
    state_terminal_kind: [i32; 4096];
    state_values: [i32; 4096];
    state_targets: [i32; 4096];
    // Resolved callee machine index for each admitted non-terminal call
    // statement, indexed by the statement's arena position.
    call_targets: [i32; 16384];
    // Each value retains its named realization and its operand/row handle.
    // Parameters, locals, pending arguments and expression scratch own
    // disjoint regions. Source integers never manufacture reference authority.
    value_kinds: [OmegaCheckedValueKind; 16384];
    value_payloads: [i32; 16384];
    // Primitive codes retain carrier and policy: 1 bool, 2 Unit, 8 plain u8,
    // 32 plain u32, 64 plain u64, 288 Trapping u32, 320 Trapping u64. Compound codes below
    // retain their declaration/type-row identity. Zero is never admitted.
    state_types: [i32; 4096];
    state_owners: [i32; 4096];
    // Authored entry predicates retain exact formal/projected subjects. Bodies
    // may use these bounds only while the corresponding storage is unchanged;
    // every call discharges them against its captured actual arguments.
    bound_first: [i32; 4096];
    bound_count: [i32; 4096];
    bound_total: i32;
    bound_roots: [i32; 16384];
    bound_offsets: [i32; 16384];
    bound_limits: [i32; 16384];
    bound_fields: [i32; 16384];
    value_states: [i32; 16384];
    value_befores: [i32; 16384];
    local_befores: [i32; 16384];
    effect_count: i32;
    effect_states: [i32; 16384];
    effect_befores: [i32; 16384];
    effect_roots: [i32; 16384];
    effect_offsets: [i32; 16384];
    effect_sizes: [i32; 16384];
    parameter_types: [i32; 16384];
    transition_targets: [i32; 16384];
    // Case lookup and duplicate checking share a declaration-scoped name census.
    // Heads/links store arena index + 1; zero is empty. Retained bucket IDs let
    // the next compile clear only inserted entries, including failed requests.
    case_name_heads: [i32; 1024];
    case_name_next: [i32; 16384];
    case_name_buckets: [i32; 16384];
    case_name_count: i32;
    case_guard_ordinals: [i32; 16384];
    case_coverage: [i32; 16384];
    // Compound identities are canonical within this single-source adapter:
    // nominal records/sums 100000+declaration, arrays 200000+type-row, qualified arrays
    // 300000+type-row, shared/mutable record refs 400000/500000+declaration.
    // Reference identity never contains a snapshot of its referent.
    data_colors: [i32; 4096];
    data_sizes: [i32; 4096];
    data_copy: [i32; 4096];
    field_types: [i32; 16384];
    field_offsets: [i32; 16384];
    field_extents: [i32; 16384];
    field_upper_bounds: [i32; 16384];
    layout_depth: i32;
    // Storage keeps scalar cells and compound values in one bounded arena.
    // Every region is word aligned; array elements retain their own stride.
    cell_types: [i32; 65536];
    cell_ids: [i32; 65536];
    cell_count: i32;
    cell_sizes: [i32; 65536];
    cell_offsets: [i32; 65536];
    storage_size: i32;
    // Structural places retain their root and exact projected byte range.
    // A reference root is dereferenced once when its location is captured.
    struct_field_slots: [i32; 16384];
    place_roots: [i32; 16384];
    place_offsets: [i32; 16384];
    place_types: [i32; 16384];
    place_extent: [i32; 16384];
    place_indirect: [i32; 16384];
    place_writable: [i32; 16384];
    place_fields: [i32; 16384];
    loan_access: [i32; 16384];
    // 0 ordinary argument loan; 1 indexed-access adaptation/reborrow scope.
    loan_context: [i32; 16384];
    loan_roots: [i32; 16384];
    loan_offsets: [i32; 16384];
    loan_sizes: [i32; 16384];
    loan_count: i32;
    index_plans: [OmegaByteIndexPlan; 16384];
    assignment_loan_base: i32;
    literal_value: i32;
    literal_status: i32;
    // Every ordinary call in every state contributes an edge. State transfers
    // stay inside their owner machine. Refusing cycles therefore prevents a
    // live invocation's private cells from being re-entered or overwritten.
    call_edge_heads: [i32; 4096];
    call_edge_targets: [i32; 32768];
    call_edge_next: [i32; 32768];
    call_edge_offsets: [i32; 32768];
    call_edge_count: i32;
    // Core Trapping comparisons retain their published Trap ceiling even
    // though the emitted comparison is total. Private bodies infer it; a
    // public body without a supported crash clause cannot admit that ceiling.
    machine_may_trap: [i32; 4096];
    call_colors: [i32; 4096];
    call_walk: [i32; 4096];
    call_cursors: [i32; 4096];
    // Expression folding scratch. eval_order collects one terminal
    // expression's subtree in preorder (children always carry larger slot
    // positions than their parent), then a reverse scan folds children
    // before their consumers; operand_values holds each visited node's
    // folded value (0..255) or -2 for an unsupported form, and
    // operand_classes tags every folded node - 0 for an anonymous exact
    // number, 1 for a Boolean. fold_value receives the completed root
    // value and fold_class its class. Refusal anchors belong to the checking
    // context; neither evaluation nor literal scanning may replace them.
    operand_values: [i32; 16384];
    operand_classes: [i32; 16384];
    eval_order: [i32; 16384];
    eval_count: i32;
    eval_scan: i32;
    fold_value: i32;
    fold_class: i32;
    // The folded transition subject under the arm scan: subject_class is 0
    // for an anonymous numeric value and 1 for a Boolean in subject_value.
    subject_class: i32;
    subject_value: i32;
    // Canonical outcome tuple for the eventual OCOUT publication
    // (outcome.epsilon). The contract assigns Reject codes 1..12; producers
    // here record the lexical codes 2..9 through the scanner diagnostic
    // projection, duplicate_name, missing_entry, and
    // integer_literal_out_of_range. outcome_code stays -1 where the syntax
    // and checking Reject inventory and the coverage provisions are still
    // unassigned; the frame encoder refuses every unassigned code, so these
    // fields cannot publish a noncanonical frame. This diagnostic adapter's
    // single anonymous source unit reports zero canonical ordinals.
    outcome_tag: i32;
    outcome_space: i32;
    outcome_code: i32;
    outcome_coordinate: i32;
    outcome_package_ordinal: i32;
    outcome_unit_ordinal: i32;
    outcome_limit: i32;
    outcome_requested: i32;
    emission_resource: i32;
}

machine OmegaScalarCompiler::span_equals(
    &mut self, source: &[u8], start: i32, end: i32, expected: &[u8]
) -> i32 {
    transition end - start == expected.len {
        true -> compare(0)
        _ -> return 0
    }

    state compare(index: i32) {
        transition index < expected.len {
            true -> byte(index)
            _ -> return 1
        }
    }

    state byte(index: i32) {
        transition source[start + index] == expected[index] {
            true -> compare(index + 1)
            _ -> return 0
        }
    }
}

// Refusal recorders own the status and canonical outcome tuple so the check
// states and the expression fold share one write site each.
machine OmegaScalarCompiler::record_reject(
    &mut self, code: i32, space: i32, coordinate: i32
) {
    self.status = OmegaScalarCompilationStatus::Reject;
    self.outcome_tag = 1;
    self.outcome_space = space;
    self.outcome_code = code;
    self.outcome_coordinate = coordinate;
    self.outcome_limit = 0;
    self.outcome_requested = 0;
    return;
}

machine OmegaScalarCompiler::record_incomplete(
    &mut self, space: i32, coordinate: i32
) {
    // Type inference may already have diagnosed a bad name or storage path.
    // An unknown result cannot replace that failure with a coverage refusal.
    transition self.status {
        OmegaScalarCompilationStatus::Pending -> retain(space, coordinate)
        _ -> return
    }
    state retain(failure_space: i32, failure_coordinate: i32) {
        self.status = OmegaScalarCompilationStatus::Incomplete;
        self.outcome_tag = 2;
        self.outcome_space = failure_space;
        self.outcome_code = -1;
        self.outcome_coordinate = failure_coordinate;
        self.outcome_limit = 0;
        self.outcome_requested = 0;
        return;
    }
}

machine OmegaScalarCompiler::record_internal(&mut self) {
    self.status = OmegaScalarCompilationStatus::InternalFailure;
    self.outcome_tag = 3;
    self.outcome_space = 3;
    self.outcome_code = 1;
    self.outcome_coordinate = 0;
    self.outcome_limit = 0;
    self.outcome_requested = 0;
    return;
}

// Folds an exact decimal literal span to its u8 value. Returns the value,
// 256 when a byte is not a decimal digit (self.literal_offset holds that
// byte), or 257 when the literal exceeds the u8 carrier; the caller anchors
// an out-of-range refusal at the span's first byte.
machine OmegaScalarCompiler::scan_u8(
    &mut self, source: &[u8], start: i32, end: i32
) -> i32 {
    transition true { true -> walk(start, 0) }

    state walk(cursor: i32, value: i32) {
        transition cursor < end {
            true -> digit(cursor, value)
            _ -> return value
        }
    }

    state digit(cursor: i32, value: i32) {
        self.literal_offset = cursor;
        let next: i32 = source[cursor] - 48;
        transition (next >= 0) && (next <= 9) {
            true -> bounded(cursor, value, next)
            _ -> return 256
        }
    }

    state bounded(cursor: i32, value: i32, next: i32) {
        transition value <= (255 - next) / 10 {
            true -> walk(cursor + 1, value * 10 + next)
            _ -> return 257
        }
    }
}

// Resolve a call-target name to the index of a free machine declaring that
// exact path member, or -1 when no admitted machine carries the name.
// Machines with qualified paths own no plain name and are skipped.
machine OmegaScalarCompiler::resolve_machine(
    &mut self, source: &[u8], start: i32, end: i32
) -> i32 {
    return self.resolve_declaration(source, start, end, OmegaDeclarationKind::Machine);
}

// Resolve a transition-target name to the index of an authored state owned
// by machine_index, or -1 when the machine declares no such state.
machine OmegaScalarCompiler::resolve_state(
    &mut self, source: &[u8], machine_index: i32, start: i32, end: i32
) -> i32 {
    let item: OmegaMachineSyntax = self.parser.machine_items[machine_index];
    transition true {
        true -> scan(item.first_state, item.first_state + item.state_count)
    }

    state scan(state_index: i32, last: i32) {
        transition state_index < last {
            true -> candidate(state_index, last)
            _ -> return -1
        }
    }

    state candidate(state_index: i32, last: i32) {
        transition self.parser.machine_states[state_index].name_kind {
            OmegaMachineStateNameKind::Authored -> compare(state_index, last)
            _ -> scan(state_index + 1, last)
        }
    }

    state compare(state_index: i32, last: i32) {
        let name: OmegaRelativeSpan = self.parser.machine_states[state_index].name;
        transition self.span_equals(source, name.start, name.end,
            source[start..end]) {
            1 -> return state_index
            _ -> scan(state_index + 1, last)
        }
    }
}

// Fold a bounded subset of anonymous exact arithmetic and Boolean expressions.
// Anonymous nodes do not acquire u8 meaning from their destination. This
// implementation retains only integral intermediate values in 0..255; a wider
// or fractional intermediate is unsupported, never silently narrowed. Returns
// 0 with self.fold_value and self.fold_class (0 = anonymous number, 1 = Boolean),
// 1 when any node is an unsupported form, or 2 after the
// source's refusal tuple has been recorded through the shared recorders.
// Children always precede their parents in eval_order, so one preorder
// collect followed by a reverse scan evaluates every operand before its
// consumer without recursion.
machine OmegaScalarCompiler::fold_expression(
    &mut self, source: &[u8], root: i32
) -> i32 {
    self.eval_order[0] = root;
    self.eval_count = 1;
    self.eval_scan = 0;
    transition true { true -> collect() }

    state collect() {
        transition self.eval_scan < self.eval_count {
            true -> collect_node()
            _ -> fold_start()
        }
    }

    state collect_node() {
        let expression: i32 = self.eval_order[self.eval_scan];
        self.eval_scan = self.eval_scan + 1;
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Binary -> collect_binary(expression)
            OmegaExpressionKind::Unary -> collect_unary(expression)
            _ -> collect()
        }
    }

    // The subtree is bounded by the parser's expression arena, so the collect
    // worklist can never exceed its capacity; the guard is the bounded form.
    state collect_binary(expression: i32) {
        transition self.eval_count + 2 <= 16384 {
            true -> collect_binary_bounded(expression)
            _ -> fail_internal()
        }
    }

    state collect_binary_bounded(expression: i32) {
        let row: OmegaBinaryExpressionSyntax = self.parser.binary_expressions[
            self.parser.expressions[expression].payload0];
        self.eval_order[self.eval_count] = row.left;
        self.eval_order[self.eval_count + 1] = row.right;
        self.eval_count = self.eval_count + 2;
        transition true { true -> collect() }
    }

    state collect_unary(expression: i32) {
        transition self.eval_count < 16384 {
            true -> collect_unary_bounded(expression)
            _ -> fail_internal()
        }
    }

    state collect_unary_bounded(expression: i32) {
        self.eval_order[self.eval_count] = self.parser.unary_expressions[
            self.parser.expressions[expression].payload0].operand;
        self.eval_count = self.eval_count + 1;
        transition true { true -> collect() }
    }

    state fold_start() {
        self.eval_scan = self.eval_count;
        transition true { true -> fold_next() }
    }

    state fold_next() {
        transition self.eval_scan > 0 {
            true -> fold_node()
            _ -> finish()
        }
    }

    state fold_node() {
        self.eval_scan = self.eval_scan - 1;
        let expression: i32 = self.eval_order[self.eval_scan];
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Integer -> integer(expression)
            OmegaExpressionKind::Boolean -> boolean(expression)
            OmegaExpressionKind::Binary -> fold_binary(expression)
            OmegaExpressionKind::Unary -> fold_unary(expression)
            _ -> mark_unsupported(expression)
        }
    }

    // A Boolean literal folds to its 0/1 payload under the Boolean class.
    state boolean(expression: i32) {
        self.operand_values[expression] =
            self.parser.expressions[expression].payload0;
        self.operand_classes[expression] = 1;
        transition true { true -> fold_next() }
    }

    // Width-dependent anonymous complement and signed intermediate values
    // are outside this bounded folder. Boolean negation retains its class.
    state fold_unary(expression: i32) {
        let row: OmegaUnaryExpressionSyntax = self.parser.unary_expressions[
            self.parser.expressions[expression].payload0];
        transition self.operand_values[row.operand] >= 0 {
            true -> fold_unary_operator(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_unary_operator(expression: i32, row: OmegaUnaryExpressionSyntax) {
        transition row.operator {
            OmegaUnaryOperatorKind::LogicalNot -> fold_logical_not(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    // `!x` complements a Boolean operand; a u8 operand is a carrier-class
    // rejection at the operator.
    state fold_logical_not(expression: i32, row: OmegaUnaryExpressionSyntax) {
        transition self.operand_classes[row.operand] == 1 {
            true -> fold_logical_not_value(expression, row)
            _ -> reject_unary_operator(row)
        }
    }

    state fold_logical_not_value(expression: i32, row: OmegaUnaryExpressionSyntax) {
        transition self.operand_values[row.operand] == 1 {
            true -> store_folded(expression, 0, 1)
            _ -> store_folded(expression, 1, 1)
        }
    }

    state reject_unary_operator(row: OmegaUnaryExpressionSyntax) {
        self.record_reject(-1, 4, row.operator_start);
        return 2;
    }

    state integer(expression: i32) {
        let value: i32 = self.scan_u8(source,
            self.parser.expressions[expression].payload0,
            self.parser.expressions[expression].payload1);
        transition value < 256 {
            true -> store(expression, value)
            _ -> integer_failed(expression, value)
        }
    }

    state integer_failed(expression: i32, value: i32) {
        transition value == 256 {
            true -> non_digit()
            _ -> out_of_range(expression)
        }
    }

    state non_digit() {
        self.record_incomplete(4, self.literal_offset);
        return 2;
    }

    state out_of_range(expression: i32) {
        transition expression == root {
            true -> reject_literal(expression)
            _ -> mark_unsupported(expression)
        }
    }

    state reject_literal(expression: i32) {
        self.record_reject(12, 4,
            self.parser.expressions[expression].payload0);
        return 2;
    }

    state store(expression: i32, value: i32) {
        self.operand_values[expression] = value;
        self.operand_classes[expression] = 0;
        transition true { true -> fold_next() }
    }

    state fold_binary(expression: i32) {
        let row: OmegaBinaryExpressionSyntax = self.parser.binary_expressions[
            self.parser.expressions[expression].payload0];
        transition (self.operand_values[row.left] >= 0) &&
            (self.operand_values[row.right] >= 0) {
            true -> fold_class_route(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    // Arithmetic consumes anonymous exact numbers; ordering compares them.
    // Neither operation introduces a computational carrier. Equality
    // compares same-class operands; the logical operators take Boolean
    // operands to a Boolean result. A class mismatch is a carrier-class
    // rejection at the operator, not an unsupported form.
    state fold_class_route(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> fold_equality(expression, row)
            OmegaBinaryOperatorKind::NotEqual -> fold_equality(expression, row)
            OmegaBinaryOperatorKind::Less -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::LessEqual -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::Greater -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::GreaterEqual -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::And -> fold_logical(expression, row)
            OmegaBinaryOperatorKind::Or -> fold_logical(expression, row)
            _ -> fold_u8_operands(expression, row)
        }
    }

    state fold_u8_operands(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_classes[row.left] == 0) &&
            (self.operand_classes[row.right] == 0) {
            true -> fold_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> fold_add(expression, row)
            OmegaBinaryOperatorKind::Subtract -> fold_subtract(expression, row)
            OmegaBinaryOperatorKind::Multiply -> fold_multiply(expression, row)
            OmegaBinaryOperatorKind::Divide -> fold_divide(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_add(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <=
            255 - self.operand_values[row.right] {
            true -> store_folded(expression,
                self.operand_values[row.left] + self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_subtract(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] >= self.operand_values[row.right] {
            true -> store_folded(expression,
                self.operand_values[row.left] - self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_multiply(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.right] == 0 {
            true -> store_folded(expression, 0, 0)
            _ -> fold_multiply_bounded(expression, row)
        }
    }

    state fold_multiply_bounded(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <=
            255 / self.operand_values[row.right] {
            true -> store_folded(expression,
                self.operand_values[row.left] * self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    // A zero divisor is an undefined operand under every arithmetic policy,
    // not a representability failure.
    state fold_divide(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.right] == 0 {
            true -> reject_operator(row)
            _ -> fold_integral_divide(expression, row)
        }
    }

    state fold_integral_divide(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] % self.operand_values[row.right] == 0 {
            true -> store_folded(expression,
                self.operand_values[row.left] / self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    // Equality admits same-class operands: two anonymous numbers or Booleans,
    // and produces a Boolean result; mixed classes are a carrier-class
    // rejection at the operator.
    state fold_equality(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_classes[row.left] ==
            self.operand_classes[row.right] {
            true -> fold_equality_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_equality_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> fold_equal(expression, row)
            _ -> fold_not_equal(expression, row)
        }
    }

    state fold_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] ==
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_not_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] !=
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    // Ordering compares anonymous numbers and produces a Boolean result.
    state fold_ordered(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_classes[row.left] == 0) &&
            (self.operand_classes[row.right] == 0) {
            true -> fold_ordered_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_ordered_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Less -> fold_less(expression, row)
            OmegaBinaryOperatorKind::LessEqual -> fold_less_equal(expression, row)
            OmegaBinaryOperatorKind::Greater -> fold_greater(expression, row)
            _ -> fold_greater_equal(expression, row)
        }
    }

    state fold_less(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_less_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <=
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_greater(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] >
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_greater_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] >=
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    // The logical operators combine Boolean operands into a Boolean result.
    state fold_logical(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_classes[row.left] == 1) &&
            (self.operand_classes[row.right] == 1) {
            true -> fold_logical_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_logical_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::And -> fold_and(expression, row)
            _ -> fold_or(expression, row)
        }
    }

    state fold_and(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_values[row.left] == 1) &&
            (self.operand_values[row.right] == 1) {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_or(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_values[row.left] == 1) ||
            (self.operand_values[row.right] == 1) {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state reject_operator(row: OmegaBinaryExpressionSyntax) {
        self.record_reject(-1, 4, row.operator_start);
        return 2;
    }

    state store_folded(expression: i32, value: i32, class: i32) {
        self.operand_values[expression] = value;
        self.operand_classes[expression] = class;
        transition true { true -> fold_next() }
    }

    state mark_unsupported(expression: i32) {
        self.operand_values[expression] = -2;
        transition true { true -> fold_next() }
    }

    state finish() {
        transition self.operand_values[root] >= 0 {
            true -> complete()
            _ -> return 1
        }
    }

    state complete() {
        self.fold_value = self.operand_values[root];
        self.fold_class = self.operand_classes[root];
        return 0;
    }

    state fail_internal() {
        self.record_internal();
        return 2;
    }
}

// Preserve the complete supported scalar type, including policy. Unknown
// constraints stay unsupported; a domain is never erased to reach its carrier.
machine OmegaScalarCompiler::primitive_type(
    &mut self, source: &[u8], type_index: i32
) -> i32 {
    let row: OmegaTypeReferenceSyntax = self.parser.type_references[type_index];
    transition row.kind {
        OmegaTypeReferenceKind::Named -> named(row)
        OmegaTypeReferenceKind::Constrained -> constrained(row)
        _ -> return 0
    }
    state named(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "u8") {
            1 -> return 8
            _ -> boolean(row)
        }
    }
    state boolean(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "bool") {
            1 -> return 1
            _ -> plain_word(row)
        }
    }
    state plain_word(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "u32") {
            1 -> return 32
            _ -> wide_word(row)
        }
    }
    state wide_word(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "u64") {
            1 -> return 64
            _ -> return 0
        }
    }
    state constrained(row: OmegaTypeReferenceSyntax) {
        transition row.payload2 == 1 {
            true -> constraint(row, self.parser.type_constraints[row.payload1])
            _ -> return 0
        }
    }
    state constraint(row: OmegaTypeReferenceSyntax, constraint: OmegaTypeConstraintSyntax) {
        transition constraint.path_member_count == 1 {
            true -> policy(row, self.parser.members[constraint.first_path_member])
            _ -> return 0
        }
    }
    state policy(row: OmegaTypeReferenceSyntax, name: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, "Trapping") {
            1 -> base(self.parser.type_references[row.payload0])
            _ -> return 0
        }
    }
    state base(row: OmegaTypeReferenceSyntax) {
        transition row.kind {
            OmegaTypeReferenceKind::Named -> unsigned_word(row)
            _ -> return 0
        }
    }
    state unsigned_word(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "u32") {
            1 -> return 288
            _ -> unsigned_wide(row)
        }
    }
    state unsigned_wide(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "u64") {
            1 -> return 320
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::parameter_type(
    &mut self, source: &[u8], parameter_index: i32
) -> i32 {
    let parameter: OmegaMachineParameterSyntax =
        self.parser.machine_parameters[parameter_index];
    let kind: i32 = self.scalar_type(source, parameter.type_reference);
    // The parser's legacy mutable flag also marks exclusive reference access.
    // Referent authority comes from the Reference type, not carrier mutability;
    // rebinding a reference carrier remains unsupported by place checking.
    transition (parameter.is_const == 0) && (parameter.is_self == 0) &&
        ((parameter.is_mutable == 0) || ((kind >= 400000) && (kind < 504096))) {
        true -> return kind
        _ -> return 0
    }
}

// Two 16-bit limbs keep decimal scanning inside Epsilon's checked i32
// arithmetic. The successful payload is the exact low-word bit pattern;
// Alpha emission zero-extends it, even when its i32 representation is negative.
machine OmegaScalarCompiler::scan_scalar_literal(
    &mut self, source: &[u8], start: i32, end: i32, expected: i32
) {
    self.literal_status = 0;
    transition true { true -> digit(start, 0, 0) }
    state digit(cursor: i32, high: i32, low: i32) {
        transition cursor < end {
            true -> decimal(cursor, high, low, source[cursor] - 48)
            _ -> finish(high, low)
        }
    }
    state decimal(cursor: i32, high: i32, low: i32, value: i32) {
        transition (value >= 0) && (value <= 9) {
            true -> accumulate(cursor, high, low * 10 + value)
            _ -> unsupported()
        }
    }
    state accumulate(cursor: i32, high: i32, low: i32) {
        let next: i32 = high * 10 + low / 65536;
        transition next <= 65535 {
            true -> digit(cursor + 1, next, low % 65536)
            _ -> out_of_range()
        }
    }
    state finish(high: i32, low: i32) {
        transition (expected == 32) || (expected == 64) || ((expected == 8) && (high == 0) && (low < 256)) {
            true -> encode(high, low)
            _ -> out_of_range()
        }
    }
    state encode(high: i32, low: i32) {
        transition high < 32768 {
            true -> store(high * 65536 + low)
            _ -> store((high - 65536) * 65536 + low)
        }
    }
    state store(value: i32) { self.literal_value = value; self.literal_status = 1; }
    state unsupported() { self.literal_status = 2; }
    state out_of_range() {
        transition expected == 64 {
            true -> unsupported()
            _ -> range_failure()
        }
    }
    state range_failure() { self.literal_status = 3; }
}

// Lookup sees this state's parameters and only already completed local
// declarations. Initializers cannot read their own not-yet-created binding;
// nested states never capture another state's values.
machine OmegaScalarCompiler::value_cell(
    &mut self, source: &[u8], state_index: i32, before: i32,
    start: i32, end: i32
) -> i32 {
    transition true { true -> parameter(0) }
    state parameter(offset: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[state_index];
        transition offset < body.parameter_count {
            true -> parameter_name(offset)
            _ -> local(0)
        }
    }
    state parameter_name(offset: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[state_index];
        let slot: i32 = body.first_parameter + offset;
        let name: OmegaRelativeSpan = self.parser.machine_parameters[slot].name;
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return slot
            _ -> parameter(offset + 1)
        }
    }
    state local(offset: i32) {
        transition offset < before {
            true -> local_kind(offset)
            _ -> return -1
        }
    }
    state local_kind(offset: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[state_index];
        let row: OmegaStatementSyntax = self.parser.statements[body.first_statement + offset];
        transition row.kind {
            OmegaStatementKind::LocalData -> local_name(offset, row.item_index)
            _ -> local(offset + 1)
        }
    }
    state local_name(offset: i32, local_index: i32) {
        let name: OmegaRelativeSpan = self.parser.local_data_statements[local_index].name;
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return 16384 + local_index
            _ -> local(offset + 1)
        }
    }
}

machine OmegaScalarCompiler::retain_edge(
    &mut self, caller: i32, callee: i32, coordinate: i32
) -> i32 {
    transition self.call_edge_count < 32768 {
        true -> retain()
        _ -> fail()
    }
    state retain() {
        let edge: i32 = self.call_edge_count;
        self.call_edge_targets[edge] = callee;
        self.call_edge_offsets[edge] = coordinate;
        self.call_edge_next[edge] = self.call_edge_heads[caller];
        self.call_edge_heads[caller] = edge;
        self.call_edge_count = edge + 1;
        return 1;
    }
    state fail() { self.record_internal(); return 0; }
}

// An inferred zero denotes anonymous numeric syntax, not a chosen carrier.
// The complete destination or a typed comparison peer chooses its landing.
machine OmegaScalarCompiler::expression_type(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    expression: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Integer -> return 0
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Indexed -> return self.byte_index_result_type(source, state_index, before, expression)
        OmegaExpressionKind::Path -> path(row)
        OmegaExpressionKind::Call -> call(self.parser.call_expressions[row.payload0])
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        OmegaExpressionKind::Unary -> unary(self.parser.unary_expressions[row.payload0])
        OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[row.payload0])
        _ -> return -1
    }
    state path(row: OmegaExpressionSyntax) {
        transition row.payload3 > 1 {
            true -> return self.case_value_type(source, row)
            _ -> place()
        }
    }
    state place() {
        transition self.check_place(source, state_index, before, expression) {
            1 -> return self.place_types[expression]
            _ -> return -1
        }
    }
    state call(call: OmegaCallExpressionSyntax) {
        let callee: i32 = self.resolve_call_machine(source, call);
        transition callee >= 0 {
            true -> return self.state_types[self.parser.machine_items[callee].first_state]
            _ -> return -1
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> arithmetic(row)
            OmegaBinaryOperatorKind::Subtract -> arithmetic(row)
            OmegaBinaryOperatorKind::Multiply -> arithmetic(row)
            OmegaBinaryOperatorKind::Equal -> return 1
            OmegaBinaryOperatorKind::NotEqual -> return 1
            OmegaBinaryOperatorKind::Less -> return 1
            OmegaBinaryOperatorKind::LessEqual -> return 1
            OmegaBinaryOperatorKind::Greater -> return 1
            OmegaBinaryOperatorKind::GreaterEqual -> return 1
            OmegaBinaryOperatorKind::And -> return 1
            OmegaBinaryOperatorKind::Or -> return 1
            _ -> return 0
        }
    }
    state arithmetic(row: OmegaBinaryExpressionSyntax) {
        let left: i32 = self.expression_type(source, owner, state_index, before, row.left);
        let right: i32 = self.expression_type(source, owner, state_index, before, row.right);
        transition (left == 288) || (left == 320) {
            true -> return left
            _ -> right_policy(left, right)
        }
    }
    state right_policy(left: i32, right: i32) {
        transition (right == 288) || (right == 320) || (left == 0) {
            true -> return right
            _ -> return left
        }
    }
    state unary(row: OmegaUnaryExpressionSyntax) {
        transition row.operator {
            OmegaUnaryOperatorKind::LogicalNot -> return 1
            _ -> return 0
        }
    }
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::Carrier -> return self.scalar_type(source, row.target_type)
            _ -> cast_domain(row)
        }
    }
    state cast_domain(row: OmegaCastExpressionSyntax) {
        transition self.span_equals(source, row.domain.start, row.domain.end, "Trapping") {
            1 -> cast_operand(row, self.expression_type(source, owner, state_index, before, row.value))
            _ -> return -1
        }
    }
    state cast_operand(row: OmegaCastExpressionSyntax, kind: i32) {
        transition row.kind {
            OmegaCastKind::AddDomain -> added(kind)
            _ -> removed(kind)
        }
    }
    state added(kind: i32) {
        // A domain-only cast of an anonymous operand still needs a carrier
        // from its receiving context. Do not guess one during peer inference.
        transition kind {
            32 -> return 288
            64 -> return 320
            _ -> return -1
        }
    }
    state removed(kind: i32) {
        transition kind {
            288 -> return 32
            320 -> return 64
            _ -> return -1
        }
    }

}

machine OmegaScalarCompiler::check_value_arguments(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    first_argument: i32, count: i32, first_parameter: i32, transfer: i32
) -> i32 {
    transition true { true -> next(0, self.loan_count) }
    state next(offset: i32, first_loan: i32) {
        transition offset < count {
            true -> storage(offset, first_loan)
            _ -> complete(first_loan)
        }
    }
    state storage(offset: i32, first_loan: i32) {
        transition self.require_cell(source, 32768 + first_argument + offset,
            self.parameter_types[first_parameter + offset]) {
            1 -> value(offset, first_loan)
            _ -> failed(first_loan)
        }
    }
    state value(offset: i32, first_loan: i32) {
        transition (transfer == 1) && (self.parameter_types[first_parameter + offset] >= 400000) {
            true -> forward(offset, first_loan)
            _ -> ordinary(offset, first_loan)
        }
    }
    state forward(offset: i32, first_loan: i32) {
        transition self.check_forward_reference(source, state_index, before,
            self.parser.call_arguments[first_argument + offset],
            self.parameter_types[first_parameter + offset]) {
            1 -> next(offset + 1, first_loan)
            _ -> failed(first_loan)
        }
    }
    state ordinary(offset: i32, first_loan: i32) {
        transition self.check_value(source, owner, state_index, before,
            self.parser.call_arguments[first_argument + offset],
            self.parameter_types[first_parameter + offset]) {
            1 -> next(offset + 1, first_loan)
            _ -> failed(first_loan)
        }
    }
    state complete(first_loan: i32) { self.loan_count = first_loan; return 1; }
    state failed(first_loan: i32) { self.loan_count = first_loan; return 0; }
}

// Check one representation across locals, parameters, calls and expressions.
// Exact unsigned addition needs a bound proof; policy arithmetic retains its
// explicit carrier and checked crash route. Comparisons produce canonical bools.
machine OmegaScalarCompiler::check_value(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    expression: i32, expected: i32
) -> i32 {
    self.value_states[expression] = state_index;
    self.value_befores[expression] = before;
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition self.require_cell(source, 49152 + expression, expected) {
        1 -> expression_kind(row)
        _ -> return 0
    }
    state expression_kind(row: OmegaExpressionSyntax) {
    transition row.kind {
        OmegaExpressionKind::Path -> path()
        OmegaExpressionKind::Indexed -> indexed()
        OmegaExpressionKind::Borrow -> return self.check_borrow(source, state_index, before, expression, expected)
        OmegaExpressionKind::StructLiteral -> return self.check_record_literal(source, owner, state_index, before, expression, expected)
        OmegaExpressionKind::Call -> call(self.parser.call_expressions[row.payload0])
        OmegaExpressionKind::Integer -> integer(row)
        OmegaExpressionKind::Boolean -> boolean(row)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        OmegaExpressionKind::Unary -> unary(self.parser.unary_expressions[row.payload0])
        OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[row.payload0])
        _ -> constant()
    }
    }
    state path() {
        transition self.parser.expressions[expression].payload3 > 1 {
            true -> return self.check_case_value(source, expression, expected)
            _ -> ordinary_path()
        }
    }
    state ordinary_path() {
        transition expected >= 400000 {
            true -> return self.check_forward_reference(source, state_index, before, expression, expected)
            _ -> return self.check_place_value(source, state_index, before, expression, expected)
        }
    }
    state indexed() {
        transition expected == 8 {
            true -> indexed_place()
            _ -> unsupported(self.diagnostic_offset)
        }
    }
    state indexed_place() {
        transition self.check_byte_index(source, state_index, before, expression, 0) {
            1 -> retain(OmegaCheckedValueKind::IndexedRead, expression)
            _ -> return 0
        }
    }
    state integer(row: OmegaExpressionSyntax) {
        transition (expected == 8) || (expected == 32) || (expected == 64) {
            true -> integer_scan(row)
            _ -> rejected(row.payload0)
        }
    }
    state integer_scan(row: OmegaExpressionSyntax) {
        self.scan_scalar_literal(source, row.payload0, row.payload1, expected);
        transition self.literal_status {
            1 -> retain(OmegaCheckedValueKind::Literal, self.literal_value)
            2 -> unsupported(row.payload0)
            _ -> literal_range(row.payload0)
        }
    }
    state literal_range(coordinate: i32) {
        self.record_reject(12, 4, coordinate);
        return 0;
    }
    state boolean(row: OmegaExpressionSyntax) {
        transition expected == 1 {
            true -> retain(OmegaCheckedValueKind::Literal, row.payload0)
            _ -> rejected(row.payload1)
        }
    }
    state call(call: OmegaCallExpressionSyntax) {
        transition (self.call_has_static_target(call) == 1) && (call.machine_argument_count == 0) {
            true -> target(call)
            _ -> unsupported(call.start)
        }
    }
    state target(call: OmegaCallExpressionSyntax) {
        transition (call.has_receiver != 0) ||
            (self.resolve_state(source, owner, call.target.start, call.target.end) < 0) {
            true -> global_target(call)
            _ -> unsupported(call.target.start)
        }
    }
    state global_target(call: OmegaCallExpressionSyntax) {
        let callee: i32 = self.resolve_call_machine(source, call);
        transition callee >= 0 {
            true -> arity(call, callee)
            _ -> rejected(call.target.start)
        }
    }
    state arity(call: OmegaCallExpressionSyntax, callee: i32) {
        transition call.argument_count == self.parser.machine_states[
            self.parser.machine_items[callee].first_state].parameter_count {
            true -> result_type(call, callee)
            _ -> rejected(call.start)
        }
    }
    state result_type(call: OmegaCallExpressionSyntax, callee: i32) {
        transition self.state_types[self.parser.machine_items[callee].first_state] == expected {
            true -> arguments(call, callee)
            _ -> rejected(call.start)
        }
    }
    state arguments(call: OmegaCallExpressionSyntax, callee: i32) {
        transition self.check_value_arguments(source, owner, state_index, before,
            call.first_argument, call.argument_count, self.parser.machine_states[
            self.parser.machine_items[callee].first_state].first_parameter, 0) {
            1 -> contract(call, callee)
            _ -> return 0
        }
    }
    state contract(call: OmegaCallExpressionSyntax, callee: i32) {
        transition self.check_call_bounds(source, state_index, before, call.first_argument, call.argument_count,
            self.parser.machine_items[callee].first_state, -1, 0) {
            1 -> edge(call, callee)
            _ -> return 0
        }
    }
    state edge(call: OmegaCallExpressionSyntax, callee: i32) {
        transition (self.retain_edge(owner, callee, call.start) == 1) &&
            (self.retain_call_effects(state_index, before, call.first_argument, call.argument_count,
                self.parser.machine_states[self.parser.machine_items[callee].first_state].first_parameter) == 1) {
            true -> retain(OmegaCheckedValueKind::Call, callee)
            _ -> return 0
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> arithmetic(row)
            OmegaBinaryOperatorKind::Subtract -> arithmetic(row)
            OmegaBinaryOperatorKind::Multiply -> arithmetic(row)
            OmegaBinaryOperatorKind::And -> logical(row)
            OmegaBinaryOperatorKind::Or -> logical(row)
            OmegaBinaryOperatorKind::Equal -> comparison(row)
            OmegaBinaryOperatorKind::NotEqual -> comparison(row)
            OmegaBinaryOperatorKind::Less -> comparison(row)
            OmegaBinaryOperatorKind::LessEqual -> comparison(row)
            OmegaBinaryOperatorKind::Greater -> comparison(row)
            OmegaBinaryOperatorKind::GreaterEqual -> comparison(row)
            _ -> constant()
        }
    }
    state arithmetic(row: OmegaBinaryExpressionSyntax) {
        transition true {
            true -> arithmetic_types(row,
                self.expression_type(source, owner, state_index, before, row.left),
                self.expression_type(source, owner, state_index, before, row.right))
        }
    }
    state arithmetic_types(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left >= 0) && (right >= 0) {
            true -> arithmetic_known(row, left, right)
            _ -> unsupported(row.operator_start)
        }
    }
    state arithmetic_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left == 288) || (left == 320) {
            true -> policy_result(row, left, right, left)
            _ -> arithmetic_right_policy(row, left, right)
        }
    }
    state arithmetic_right_policy(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (right == 288) || (right == 320) {
            true -> policy_result(row, left, right, right)
            _ -> exact_operator(row)
        }
    }
    state exact_operator(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> addition(row)
            _ -> constant()
        }
    }
    // A receiving qualification never selects policy arithmetic. An actual
    // qualified operand selects the core family; its peer must carry that
    // same policy/carrier or the plain carrier. Anonymous peers land plainly.
    state policy_result(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition expected == policy {
            true -> policy_left(row, left, right, policy)
            _ -> rejected(row.operator_start)
        }
    }
    state policy_left(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition left == 0 {
            true -> policy_right(row, policy - 256, right, policy)
            _ -> policy_left_known(row, left, right, policy)
        }
    }
    state policy_left_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition (left == policy) || (left == policy - 256) {
            true -> policy_right(row, left, right, policy)
            _ -> rejected(row.operator_start)
        }
    }
    state policy_right(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition right == 0 {
            true -> policy_operator(row, left, policy - 256, policy)
            _ -> policy_right_known(row, left, right, policy)
        }
    }
    state policy_right_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition (right == policy) || (right == policy - 256) {
            true -> policy_operator(row, left, right, policy)
            _ -> rejected(row.operator_start)
        }
    }
    state policy_operator(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition row.operator {
            OmegaBinaryOperatorKind::Multiply -> policy_multiply(row, left, right, policy)
            _ -> policy_operands(row, left, right)
        }
    }
    state policy_multiply(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition policy == 288 {
            true -> policy_operands(row, left, right)
            _ -> unsupported(row.operator_start)
        }
    }
    state policy_operands(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        self.machine_may_trap[owner] = 1;
        transition (self.check_value(source, owner, state_index, before, row.left, left) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, right) == 1) {
            true -> retain(OmegaCheckedValueKind::TrappingArithmetic, self.parser.expressions[expression].payload0)
            _ -> return 0
        }
    }
    state addition(row: OmegaBinaryExpressionSyntax) {
        transition self.expression_type(source, owner, state_index, before, row.left) == 64 {
            true -> unsigned_add(row)
            _ -> constant()
        }
    }
    state unsigned_add(row: OmegaBinaryExpressionSyntax) {
        transition expected == 64 {
            true -> add_right(row)
            _ -> unsupported(row.operator_start)
        }
    }
    state add_right(row: OmegaBinaryExpressionSyntax) {
        transition self.parser.expressions[row.right].kind {
            OmegaExpressionKind::Integer -> add_operands(row)
            _ -> unsupported(row.operator_start)
        }
    }
    state add_operands(row: OmegaBinaryExpressionSyntax) {
        transition (self.check_value(source, owner, state_index, before, row.left, 64) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, 64) == 1) {
            true -> add_limit(row, self.value_payloads[row.right])
            _ -> return 0
        }
    }
    state add_limit(row: OmegaBinaryExpressionSyntax, amount: i32) {
        transition (amount >= 0) &&
            (self.prove_upper(source, state_index, before, row.left, 2147483647 - amount, -1, 0) == 1) {
            true -> retain(OmegaCheckedValueKind::ExactAddition, self.parser.expressions[expression].payload0)
            _ -> unsupported(row.operator_start)
        }
    }
    state logical(row: OmegaBinaryExpressionSyntax) {
        transition expected == 1 {
            true -> operands(row, 1)
            _ -> rejected(row.operator_start)
        }
    }
    state comparison(row: OmegaBinaryExpressionSyntax) {
        transition expected == 1 {
            true -> comparison_types(row,
                self.expression_type(source, owner, state_index, before, row.left),
                self.expression_type(source, owner, state_index, before, row.right))
            _ -> rejected(row.operator_start)
        }
    }
    state comparison_types(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left == 0) && (right == 0) {
            true -> constant()
            _ -> comparison_known(row, left, right)
        }
    }
    state comparison_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left >= 0) && (right >= 0) && (left < 100000) && (right < 100000) &&
            (left != 2) && (right != 2) {
            true -> comparison_peer(row, left, right)
            _ -> unsupported(row.operator_start)
        }
    }
    // Core policy comparisons explicitly admit a plain peer of the same
    // carrier. This does not qualify that operand or relax call admission.
    state comparison_peer(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition left == 0 {
            true -> anonymous_left(row, right)
            _ -> comparison_right(row, left, right)
        }
    }
    state anonymous_left(row: OmegaBinaryExpressionSyntax, right: i32) {
        transition (right == 8) || (right == 32) || (right == 64) || (right == 288) || (right == 320) {
            true -> operands_types(row, right % 256, right)
            _ -> rejected(row.operator_start)
        }
    }
    state comparison_right(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition right == 0 {
            true -> anonymous_right(row, left)
            _ -> comparison_same(row, left, right)
        }
    }
    state anonymous_right(row: OmegaBinaryExpressionSyntax, left: i32) {
        transition (left == 8) || (left == 32) || (left == 64) || (left == 288) || (left == 320) {
            true -> operands_types(row, left, left % 256)
            _ -> rejected(row.operator_start)
        }
    }
    state comparison_same(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition left == right {
            true -> comparison_operator(row, left)
            _ -> comparison_policy(row, left, right)
        }
    }
    state comparison_policy(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        // Plain computational integers compare by value without a common
        // carrier. Both supported unsigned carriers are zero-extended.
        transition ((left == 8) || (left == 32) || (left == 64)) && ((right == 8) || (right == 32) || (right == 64)) {
            true -> operands_types(row, left, right)
            _ -> comparison_policy_pair(row, left, right)
        }
    }
    state comparison_policy_pair(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition ((left == 32) && (right == 288)) || ((left == 288) && (right == 32)) ||
            ((left == 64) && (right == 320)) || ((left == 320) && (right == 64)) {
            true -> operands_types(row, left, right)
            _ -> rejected(row.operator_start)
        }
    }

    state comparison_operator(row: OmegaBinaryExpressionSyntax, operand_type: i32) {
        transition operand_type == 1 {
            true -> boolean_comparison(row)
            _ -> operands(row, operand_type)
        }
    }
    state boolean_comparison(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> operands(row, 1)
            OmegaBinaryOperatorKind::NotEqual -> operands(row, 1)
            _ -> rejected(row.operator_start)
        }
    }
    state operands(row: OmegaBinaryExpressionSyntax, operand_type: i32) {
        transition true { true -> operands_types(row, operand_type, operand_type) }
    }
    state operands_types(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left == 288) || (right == 288) || (left == 320) || (right == 320) {
            true -> trapping_operands(row, left, right)
            _ -> check_operands(row, left, right)
        }
    }
    state trapping_operands(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        self.machine_may_trap[owner] = 1;
        transition true { true -> check_operands(row, left, right) }
    }
    state check_operands(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (self.check_value(source, owner, state_index, before, row.left, left) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, right) == 1) {
            true -> retain(OmegaCheckedValueKind::BooleanBinary, self.parser.expressions[expression].payload0)
            _ -> return 0
        }
    }
    state unary(row: OmegaUnaryExpressionSyntax) {
        transition row.operator {
            OmegaUnaryOperatorKind::LogicalNot -> logical_not(row)
            _ -> constant()
        }
    }
    state logical_not(row: OmegaUnaryExpressionSyntax) {
        transition expected == 1 {
            true -> logical_operand(row)
            _ -> rejected(row.operator_start)
        }
    }
    state logical_operand(row: OmegaUnaryExpressionSyntax) {
        transition self.check_value(source, owner, state_index, before, row.operand, 1) {
            1 -> retain(OmegaCheckedValueKind::LogicalNot, row.operand)
            _ -> return 0
        }
    }
    // Written domain changes preserve the stored value. Expected types never
    // add or remove a qualification. Anonymous operands receive only a plain
    // carrier from the destination before the explicit addition is checked.
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::Carrier -> carrier_cast(row, self.scalar_type(source, row.target_type))
            _ -> domain_cast(row)
        }
    }
    state carrier_cast(row: OmegaCastExpressionSyntax, target: i32) {
        transition (target == 8) || (target == 32) {
            true -> carrier_result(row, target)
            _ -> unsupported(row.start)
        }
    }
    state carrier_result(row: OmegaCastExpressionSyntax, target: i32) {
        transition expected == target {
            true -> carrier_operand(row, target,
                self.expression_type(source, owner, state_index, before, row.value))
            _ -> rejected(row.start)
        }
    }
    state carrier_operand(row: OmegaCastExpressionSyntax, target: i32, kind: i32) {
        transition (kind == 0) || (kind == target) {
            true -> cast_value(row.value, target)
            _ -> carrier_widen(row, target, kind)
        }
    }
    state carrier_widen(row: OmegaCastExpressionSyntax, target: i32, kind: i32) {
        transition (kind == 8) && (target == 32) {
            true -> cast_value(row.value, 8)
            _ -> unsupported(row.start)
        }
    }
    state domain_cast(row: OmegaCastExpressionSyntax) {
        transition self.span_equals(source, row.domain.start, row.domain.end, "Trapping") {
            1 -> domain_operation(row)
            _ -> unsupported(row.domain.start)
        }
    }
    state domain_operation(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::AddDomain -> domain_add(row)
            OmegaCastKind::RemoveDomain -> domain_remove(row)
            _ -> unsupported(row.start)
        }
    }
    state domain_add(row: OmegaCastExpressionSyntax) {
        transition (expected == 288) || (expected == 320) {
            true -> cast_value(row.value, expected - 256)
            _ -> rejected(row.start)
        }
    }
    state domain_remove(row: OmegaCastExpressionSyntax) {
        transition (expected == 32) || (expected == 64) {
            true -> cast_value(row.value, expected + 256)
            _ -> rejected(row.start)
        }
    }
    state cast_value(value: i32, kind: i32) {
        transition self.check_value(source, owner, state_index, before, value, kind) {
            1 -> retain(OmegaCheckedValueKind::RepresentationCast, value)
            _ -> return 0
        }
    }

    state constant() {
        transition (expected != 288) && (expected != 320) && (self.is_bounded_constant(source, expression) == 1) {
            true -> fold_constant()
            _ -> unsupported(self.diagnostic_offset)
        }
    }
    state fold_constant() {
        transition self.fold_expression(source, expression) {
            0 -> constant_class()
            1 -> unsupported(self.diagnostic_offset)
            _ -> return 0
        }
    }
    state constant_class() {
        transition ((self.fold_class == 1) && (expected == 1)) ||
            ((self.fold_class == 0) && ((expected == 8) || (expected == 32) || (expected == 64))) {
            true -> retain(OmegaCheckedValueKind::Literal, self.fold_value)
            _ -> rejected(self.diagnostic_offset)
        }
    }
    state retain(kind: OmegaCheckedValueKind, value: i32) {
        self.value_kinds[expression] = kind;
        self.value_payloads[expression] = value;
        return 1;
    }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Three-color DFS over every state-owned ordinary call. All admitted state
// transfers remain inside that same owner machine, so they cannot evade this
// reentrancy check. The explicit walk is bounded by the machine arena.
machine OmegaScalarCompiler::check_call_graph(&mut self) -> i32 {
    transition true { true -> root(0) }
    state root(index: i32) {
        transition index < self.parser.machine_count {
            true -> root_color(index)
            _ -> return 1
        }
    }
    state root_color(index: i32) {
        transition self.call_colors[index] {
            0 -> begin(index)
            _ -> root(index + 1)
        }
    }
    state begin(index: i32) {
        self.call_walk[0] = index;
        self.call_cursors[0] = self.call_edge_heads[index];
        self.call_colors[index] = 1;
        transition true { true -> walk(index, 0) }
    }
    state walk(root_index: i32, depth: i32) {
        transition self.call_cursors[depth] >= 0 {
            true -> edge(root_index, depth, self.call_cursors[depth])
            _ -> finish(root_index, depth)
        }
    }
    state edge(root_index: i32, depth: i32, edge_index: i32) {
        self.call_cursors[depth] = self.call_edge_next[edge_index];
        let callee: i32 = self.call_edge_targets[edge_index];
        transition self.call_colors[callee] {
            0 -> descend(root_index, depth, callee)
            1 -> cycle(edge_index)
            _ -> inherit(root_index, depth, callee)
        }
    }
    state inherit(root_index: i32, depth: i32, callee: i32) {
        self.machine_may_trap[self.call_walk[depth]] =
            self.machine_may_trap[self.call_walk[depth]] | self.machine_may_trap[callee];
        transition true { true -> walk(root_index, depth) }
    }
    state descend(root_index: i32, depth: i32, callee: i32) {
        transition depth + 1 < 4096 {
            true -> enter(root_index, depth + 1, callee)
            _ -> internal()
        }
    }
    state enter(root_index: i32, depth: i32, callee: i32) {
        self.call_walk[depth] = callee;
        self.call_cursors[depth] = self.call_edge_heads[callee];
        self.call_colors[callee] = 1;
        transition true { true -> walk(root_index, depth) }
    }
    state finish(root_index: i32, depth: i32) {
        self.call_colors[self.call_walk[depth]] = 2;
        transition depth {
            0 -> root(root_index + 1)
            _ -> inherit(root_index, depth - 1, self.call_walk[depth])
        }
    }
    state cycle(edge_index: i32) {
        self.record_incomplete(4, self.call_edge_offsets[edge_index]);
        return 0;
    }
    state internal() { self.record_internal(); return 0; }
}

// The anonymous folder has a deliberately smaller implementation range.
// Exceeding it is coverage refusal, not a claim that Omega rejects the value.
machine OmegaScalarCompiler::is_bounded_constant(&mut self, source: &[u8], expression: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Integer -> integer(row)
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Unary -> return self.is_bounded_constant(source, self.parser.unary_expressions[row.payload0].operand)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        _ -> return 0
    }
    state integer(row: OmegaExpressionSyntax) {
        transition self.scan_u8(source, row.payload0, row.payload1) < 256 {
            true -> return 1
            _ -> return 0
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition (self.is_bounded_constant(source, row.left) == 1) &&
            (self.is_bounded_constant(source, row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Constant specialization is permitted only when no runtime binding or call
// occurs anywhere in the subject. Dynamic Boolean subjects use checked values.
machine OmegaScalarCompiler::is_constant_expression(&mut self, expression: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Integer -> return 1
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Unary -> return self.is_constant_expression(self.parser.unary_expressions[row.payload0].operand)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        _ -> return 0
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition (self.is_constant_expression(row.left) == 1) &&
            (self.is_constant_expression(row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::check_transition_target(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32, row_index: i32
) -> i32 {
    let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
    self.transition_targets[row_index] = -1;
    transition row.target_kind {
        OmegaTransitionTargetKind::Result -> return self.check_value(source, owner, state_index,
            before, row.result_expression, self.state_types[state_index])
        OmegaTransitionTargetKind::Machine -> target(row)
    }
    state target(row: OmegaTransitionStatementSyntax) {
        let target: i32 = self.resolve_state(source, owner, row.target.start, row.target.end);
        transition target >= 0 {
            true -> signature(row, target)
            _ -> outside_owner(row)
        }
    }
    // Ordinary terminal calls may name globals, but this static-cell slice
    // only emits transfers within one owner. A visible global is outside
    // coverage, not a missing machine; do not misreport a valid terminal call.
    state outside_owner(row: OmegaTransitionStatementSyntax) {
        transition self.resolve_machine(source, row.target.start, row.target.end) >= 0 {
            true -> unsupported(row.target.start)
            _ -> reject(row.target.start)
        }
    }
    state signature(row: OmegaTransitionStatementSyntax, target: i32) {
        transition (row.argument_count == self.parser.machine_states[target].parameter_count) &&
            (self.state_types[state_index] == self.state_types[target]) {
            true -> arguments(row, target)
            _ -> reject(row.start)
        }
    }
    state arguments(row: OmegaTransitionStatementSyntax, target: i32) {
        transition self.check_value_arguments(source, owner, state_index, before,
            row.first_argument, row.argument_count, self.parser.machine_states[target].first_parameter, 1) {
            1 -> contract(row, target)
            _ -> return 0
        }
    }
    state contract(row: OmegaTransitionStatementSyntax, target: i32) {
        transition row.has_subject {
            1 -> guard(row, target)
            _ -> prove(row, target, -1, 0)
        }
    }
    state guard(row: OmegaTransitionStatementSyntax, target: i32) {
        transition row.guard_kind {
            OmegaTransitionGuardKind::Boolean -> prove(row, target, row.subject, row.guard_boolean)
            _ -> prove(row, target, -1, 0)
        }
    }
    state prove(row: OmegaTransitionStatementSyntax, target: i32, guard: i32, truth: i32) {
        transition self.check_call_bounds(source, state_index, before, row.first_argument, row.argument_count,
            target, guard, truth) {
            1 -> retain(target)
            _ -> return 0
        }
    }
    state retain(target: i32) { self.transition_targets[row_index] = target; return 1; }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
    state reject(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Alpha code uses r0 for a scalar result and r1 only as an address scratch.
// Checked cells occupy at most 16 MiB in [0x02000000, 0x03000000).
// Every checked binding owns a bounded private arena region. Scalar cells
// load their word; aggregate values are represented during emission by the
// address of established copyable backing and copied at each value boundary.
machine OmegaScalarCompiler::emit_value_load(&mut self, cell: i32) -> i32 {
    transition self.tape.emit_imm(0, 33554432 + self.cell_offsets[cell], 0) {
        1 -> value()
        _ -> return 0
    }
    state value() {
        transition (self.cell_types[cell] >= 100000) && (self.cell_types[cell] < 400000) {
            true -> return 1
            _ -> return self.tape.emit_rr(10, 0, 0)
        }
    }
}
machine OmegaScalarCompiler::emit_value_store(&mut self, cell: i32) -> i32 {
    transition self.tape.emit_imm(1, 33554432 + self.cell_offsets[cell], 0) {
        1 -> return self.emit_store_at(self.cell_types[cell], self.cell_sizes[cell])
        _ -> return 0
    }
}
// Values retain checked words, places or copy-record backing until their next boundary.
machine OmegaScalarCompiler::emit_value(&mut self, expression: i32) -> i32 {
    transition self.value_kinds[expression] {
        OmegaCheckedValueKind::Literal -> return self.tape.emit_imm(0, self.value_payloads[expression], 0)
        OmegaCheckedValueKind::NullaryCase -> return self.emit_case_value(expression)
        OmegaCheckedValueKind::Call -> call(self.parser.call_expressions[self.parser.expressions[expression].payload0])
        OmegaCheckedValueKind::BooleanBinary -> return self.emit_boolean_binary(expression,
            self.parser.binary_expressions[self.value_payloads[expression]])
        OmegaCheckedValueKind::LogicalNot -> logical_not()
        OmegaCheckedValueKind::RepresentationCast -> return self.emit_value(self.value_payloads[expression])
        OmegaCheckedValueKind::Place -> return self.emit_place_value(expression)
        OmegaCheckedValueKind::Borrow -> return self.emit_place_address(self.value_payloads[expression])
        OmegaCheckedValueKind::RecordLiteral -> return self.emit_record_literal(expression)
        OmegaCheckedValueKind::IndexedRead -> indexed()
        OmegaCheckedValueKind::ForwardedReference -> return self.emit_value_load(self.value_payloads[expression])
        OmegaCheckedValueKind::ExactAddition -> addition(self.parser.binary_expressions[self.value_payloads[expression]])
        OmegaCheckedValueKind::TrappingArithmetic -> return self.emit_trapping_arithmetic(expression,
            self.parser.binary_expressions[self.value_payloads[expression]])
        _ -> return self.tape.fail_internal(expression)
    }
    state indexed() {
        transition self.emit_index_address(expression) {
            1 -> return self.tape.emit_rr(10, 0, 0)
            _ -> return 0
        }
    }
    state call(call: OmegaCallExpressionSyntax) {
        return self.emit_value_call(self.value_payloads[expression],
            call.first_argument, call.argument_count);
    }
    state addition(row: OmegaBinaryExpressionSyntax) {
        transition (self.emit_value(row.left) == 1) &&
            (self.tape.emit_imm(1, self.value_payloads[row.right], 0) == 1) &&
            (self.tape.emit_rr(3, 0, 1) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state logical_not() {
        // Checked Booleans are exactly 0 or 1, so negation is 1 - value.
        transition (self.emit_value(self.value_payloads[expression]) == 1) &&
            (self.tape.emit_imm(1, 1, 0) == 1) &&
            (self.tape.emit_rr(4, 1, 0) == 1) &&
            (self.tape.emit_rr(2, 0, 1) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_boolean_binary(
    &mut self, expression: i32, row: OmegaBinaryExpressionSyntax
) -> i32 {
    transition row.operator {
        OmegaBinaryOperatorKind::And -> return self.emit_short_circuit(row, 13)
        OmegaBinaryOperatorKind::Or -> return self.emit_short_circuit(row, 14)
        _ -> comparison_operands()
    }
    state comparison_operands() {
        // An expression owns one scratch word, disjoint from parameters,
        // locals and staged arguments. No ordinary call cycle is admitted,
        // so a nested right operand cannot re-enter this expression's owner.
        transition (self.emit_value(row.left) == 1) &&
            (self.emit_value_store(49152 + expression) == 1) &&
            (self.emit_value(row.right) == 1) &&
            (self.tape.emit_rr(2, 2, 0) == 1) &&
            (self.emit_value_load(49152 + expression) == 1) &&
            (self.tape.emit_imm(3, 0, -2147483648) == 1) &&
            (self.tape.emit_rr(3, 0, 3) == 1) &&
            (self.tape.emit_rr(3, 2, 3) == 1) {
            true -> comparison()
            _ -> return 0
        }
    }
    state comparison() {
        // r0 and r2 carry unsigned operands biased by 2^63. Alpha's signed
        // comparison now preserves their order across the entire u64 range;
        // equality is unchanged by this bijection.
        transition row.operator {
            OmegaBinaryOperatorKind::Equal ->
                return self.emit_comparison_result(16, 0, 2, 1)
            OmegaBinaryOperatorKind::NotEqual ->
                return self.emit_comparison_result(16, 0, 2, 0)
            OmegaBinaryOperatorKind::Less ->
                return self.emit_comparison_result(15, 0, 2, 1)
            OmegaBinaryOperatorKind::LessEqual ->
                return self.emit_comparison_result(15, 2, 0, 0)
            OmegaBinaryOperatorKind::Greater ->
                return self.emit_comparison_result(15, 2, 0, 1)
            OmegaBinaryOperatorKind::GreaterEqual ->
                return self.emit_comparison_result(15, 0, 2, 0)
            _ -> return self.tape.fail_internal(expression)
        }
    }
}

// The early branch leaves the already canonical Boolean left value in r0.
// Otherwise the right operand executes once and supplies the whole result.
machine OmegaScalarCompiler::emit_short_circuit(
    &mut self, row: OmegaBinaryExpressionSyntax, opcode: i32
) -> i32 {
    self.emission_resource = 14;
    let end: i32 = self.tape.new_label();
    transition end >= 0 {
        true -> emit(end)
        _ -> return 0
    }
    state emit(end: i32) {
        self.emission_resource = 12;
        transition (self.emit_value(row.left) == 1) &&
            (self.tape.emit_rx_label(opcode, 0, end) == 1) &&
            (self.emit_value(row.right) == 1) &&
            (self.tape.define_label(end) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_comparison_result(
    &mut self, opcode: i32, left: i32, right: i32, taken_value: i32
) -> i32 {
    self.emission_resource = 14;
    let taken: i32 = self.tape.new_label();
    transition taken >= 0 {
        true -> end_label(taken)
        _ -> return 0
    }
    state end_label(taken: i32) {
        let end: i32 = self.tape.new_label();
        transition end >= 0 {
            true -> emit(taken, end)
            _ -> return 0
        }
    }
    state emit(taken: i32, end: i32) {
        self.emission_resource = 12;
        transition (self.tape.emit_rrx_label(opcode, left, right, taken) == 1) &&
            (self.tape.emit_imm(0, 1 - taken_value, 0) == 1) &&
            (self.tape.emit_jump_label(12, end) == 1) &&
            (self.tape.define_label(taken) == 1) &&
            (self.tape.emit_imm(0, taken_value, 0) == 1) &&
            (self.tape.define_label(end) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_value_call(
    &mut self, callee: i32, first_argument: i32, count: i32
) -> i32 {
    return self.emit_arguments(first_argument, count,
        self.parser.machine_states[self.parser.machine_items[callee].first_state].first_parameter,
        self.machine_labels[callee], 19);
}

// Stage every operand before overwriting any destination parameter. This
// applies equally to ordinary calls, same-state loops and sibling transfers.
machine OmegaScalarCompiler::emit_arguments(
    &mut self, first_argument: i32, count: i32, first_parameter: i32,
    label: i32, opcode: i32
) -> i32 {
    transition true { true -> evaluate(0) }
    state evaluate(offset: i32) {
        transition offset < count {
            true -> argument(offset)
            _ -> transfer(0)
        }
    }
    state argument(offset: i32) {
        let slot: i32 = first_argument + offset;
        transition (self.emit_value(self.parser.call_arguments[slot]) == 1) &&
            (self.emit_value_store(32768 + slot) == 1) {
            true -> evaluate(offset + 1)
            _ -> return 0
        }
    }
    state transfer(offset: i32) {
        transition offset < count {
            true -> parameter(offset)
            _ -> return self.tape.emit_jump_label(opcode, label)
        }
    }
    state parameter(offset: i32) {
        transition (self.emit_value_load(32768 + first_argument + offset) == 1) &&
            (self.emit_value_store(first_parameter + offset) == 1) {
            true -> transfer(offset + 1)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_transition_target(&mut self, row_index: i32) -> i32 {
    let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
    transition row.target_kind {
        OmegaTransitionTargetKind::Result -> result(row.result_expression)
        OmegaTransitionTargetKind::Machine -> target(row, self.transition_targets[row_index])
    }
    state result(expression: i32) {
        transition (self.emit_value(expression) == 1) && (self.tape.emit_ret() == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state target(row: OmegaTransitionStatementSyntax, target: i32) {
        return self.emit_arguments(row.first_argument, row.argument_count,
            self.parser.machine_states[target].first_parameter, self.state_labels[target], 12);
    }
}

// Nullary sum patterns retain exact declaration identity. Coverage is checked
// for every case, while source order determines the first selected arm. Even
// arms following a wildcard still have their patterns and targets checked.
machine OmegaScalarCompiler::check_case_transition(
    &mut self, source: &[u8], owner: i32, state_index: i32,
    first: i32, last: i32, declaration: i32
) -> i32 {
    let subject: i32 = self.parser.transition_statements[self.parser.statements[
        self.parser.machine_states[state_index].first_statement + first].item_index].subject;
    transition self.check_value(source, owner, state_index, first, subject, 100000 + declaration) {
        1 -> clear(0)
        _ -> return 0
    }
    state clear(offset: i32) {
        transition offset < self.parser.data_items[declaration].case_count {
            true -> clear_case(offset, self.parser.data_items[declaration].first_case + offset)
            _ -> arm(first, 0)
        }
    }
    state clear_case(offset: i32, slot: i32) {
        self.case_coverage[slot] = 0;
        transition true { true -> clear(offset + 1) }
    }
    state arm(cursor: i32, wildcard: i32) {
        transition cursor < last {
            true -> row(cursor, wildcard, self.parser.statements[
                self.parser.machine_states[state_index].first_statement + cursor].item_index)
            _ -> coverage(wildcard)
        }
    }
    state row(cursor: i32, wildcard: i32, row_index: i32) {
        let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always -> target(cursor, 1, row_index)
            OmegaTransitionGuardKind::Path -> path(cursor, wildcard, row_index, row)
            _ -> unsupported(row.guard_start)
        }
    }
    state path(cursor: i32, wildcard: i32, row_index: i32, row: OmegaTransitionStatementSyntax) {
        transition row.guard_path_member_count == 2 {
            true -> carrier(cursor, wildcard, row_index, row,
                self.parser.members[row.guard_first_path_member])
            _ -> unsupported(row.guard_start)
        }
    }
    state carrier(cursor: i32, wildcard: i32, row_index: i32, row: OmegaTransitionStatementSyntax,
        name: OmegaRelativeSpan) {
        transition self.resolve_data(source, name.start, name.end) == declaration {
            true -> member(cursor, wildcard, row_index,
                self.parser.members[row.guard_first_path_member + 1])
            _ -> rejected(name.start)
        }
    }
    state member(cursor: i32, wildcard: i32, row_index: i32, name: OmegaRelativeSpan) {
        let slot: i32 = self.resolve_case(source, declaration, name.start, name.end);
        transition slot >= 0 {
            true -> retain(cursor, wildcard, row_index, slot)
            _ -> rejected(name.start)
        }
    }
    state retain(cursor: i32, wildcard: i32, row_index: i32, slot: i32) {
        self.case_guard_ordinals[row_index] = slot - self.parser.data_items[declaration].first_case;
        self.case_coverage[slot] = 1;
        transition true { true -> target(cursor, wildcard, row_index) }
    }
    state target(cursor: i32, wildcard: i32, row_index: i32) {
        transition self.check_transition_target(source, owner, state_index, first, row_index) {
            1 -> arm(cursor + 1, wildcard)
            _ -> return 0
        }
    }
    state coverage(wildcard: i32) {
        transition wildcard {
            1 -> return 1
            _ -> covered(0)
        }
    }
    state covered(offset: i32) {
        transition offset < self.parser.data_items[declaration].case_count {
            true -> covered_case(offset, self.parser.data_items[declaration].first_case + offset)
            _ -> return 1
        }
    }
    state covered_case(offset: i32, slot: i32) {
        transition self.case_coverage[slot] {
            1 -> covered(offset + 1)
            _ -> rejected(self.transition_anchor)
        }
    }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
}

// Evaluate a dynamic subject once. Every target terminates the current
// activation; later guards are reached only by the preceding failed guard.
machine OmegaScalarCompiler::emit_dynamic_transition(
    &mut self, state_index: i32, first: i32, last: i32
) -> i32 {
    let subject: i32 = self.parser.transition_statements[self.parser.statements[
        self.parser.machine_states[state_index].first_statement + first].item_index].subject;
    transition (self.emit_value(subject) == 1) && (self.emit_value_store(49152 + subject) == 1) {
        true -> arm(first, subject)
        _ -> return 0
    }
    state arm(cursor: i32, subject: i32) {
        transition cursor < last {
            true -> row(cursor, subject, self.parser.statements[
                self.parser.machine_states[state_index].first_statement + cursor].item_index)
            _ -> return 1
        }
    }
    state row(cursor: i32, subject: i32, row_index: i32) {
        transition cursor + 1 == last {
            true -> return self.emit_transition_target(row_index)
            _ -> guard(cursor, subject, row_index)
        }
    }
    state guard(cursor: i32, subject: i32, row_index: i32) {
        transition self.parser.transition_statements[row_index].guard_kind {
            OmegaTransitionGuardKind::Always -> return self.emit_transition_target(row_index)
            _ -> label(cursor, subject, row_index)
        }
    }
    state label(cursor: i32, subject: i32, row_index: i32) {
        self.emission_resource = 14;
        let next: i32 = self.tape.new_label();
        transition next >= 0 {
            true -> compare(cursor, subject, row_index, next)
            _ -> return 0
        }
    }
    state compare(cursor: i32, subject: i32, row_index: i32, next: i32) {
        self.emission_resource = 12;
        transition self.emit_value_load(49152 + subject) {
            1 -> subject_kind(cursor, subject, row_index, next)
            _ -> return 0
        }
    }
    state subject_kind(cursor: i32, subject: i32, row_index: i32, next: i32) {
        transition self.cell_types[49152 + subject] >= 100000 {
            true -> case_guard(cursor, subject, row_index, next)
            _ -> branch(cursor, subject, row_index, next,
                self.parser.transition_statements[row_index].guard_boolean)
        }
    }
    state case_guard(cursor: i32, subject: i32, row_index: i32, next: i32) {
        // The subject has already been copied once. Read its captured case,
        // not the original place, and compare against the checked owner ordinal.
        transition (self.tape.emit_rr(10, 0, 0) == 1) &&
            (self.tape.emit_imm(2, self.case_guard_ordinals[row_index], 0) == 1) &&
            (self.emit_comparison_result(16, 0, 2, 1) == 1) {
            true -> branch(cursor, subject, row_index, next, 1)
            _ -> return 0
        }
    }
    state branch(cursor: i32, subject: i32, row_index: i32, next: i32, value: i32) {
        transition self.tape.emit_rx_label(14 - value, 0, next) {
            1 -> target(cursor, subject, row_index, next)
            _ -> return 0
        }
    }
    state target(cursor: i32, subject: i32, row_index: i32, next: i32) {
        transition (self.emit_transition_target(row_index) == 1) &&
            (self.tape.define_label(next) == 1) {
            true -> arm(cursor + 1, subject)
            _ -> return 0
        }
    }
}

// Complete the scalar signature census before any body resolves a call or
// transfer. Unsupported overload families cannot silently select a row.
machine OmegaScalarCompiler::check_signatures(&mut self, source: &[u8], owner: i32) -> i32 {
    transition true { true -> next(self.parser.machine_items[owner].first_state) }
    state next(index: i32) {
        transition index < self.parser.machine_items[owner].first_state + self.parser.machine_items[owner].state_count {
            true -> result(index)
            _ -> return 1
        }
    }
    state result(index: i32) {
        self.state_owners[index] = owner;
        transition self.parser.machine_states[index].has_return_type {
            1 -> explicit_result(index, self.scalar_type(source, self.parser.machine_states[index].return_type))
            _ -> retain_result(index, 2)
        }
    }
    state explicit_result(index: i32, kind: i32) {
        transition (kind > 0) && (kind < 200000) && (self.type_copy(source, kind) == 1) {
            true -> retain_result(index, kind)
            _ -> unsupported(self.parser.machine_items[owner].start)
        }
    }
    state retain_result(index: i32, kind: i32) {
        self.state_types[index] = kind;
        transition true { true -> parameter(index, 0) }
    }
    state parameter(index: i32, offset: i32) {
        transition offset < self.parser.machine_states[index].parameter_count {
            true -> parameter_type(index, offset, self.parser.machine_states[index].first_parameter + offset)
            _ -> names(index, self.parser.machine_items[owner].first_state + 1)
        }
    }
    state parameter_type(index: i32, offset: i32, slot: i32) {
        let kind: i32 = self.parameter_type(source, slot);
        self.parameter_types[slot] = kind;
        transition ((kind > 0) && (kind != 2) && (kind < 200000) &&
            (self.type_copy(source, kind) == 1)) ||
            ((kind >= 400000) && (kind < 404096)) ||
            ((kind >= 500000) && (kind < 504096)) {
            true -> parameter_storage(index, offset, slot, kind)
            _ -> unsupported(self.parser.machine_parameters[slot].name.start)
        }
    }
    state parameter_storage(index: i32, offset: i32, slot: i32, kind: i32) {
        transition self.reference_signature(owner, index, kind) {
            1 -> allocate_parameter(index, offset, slot, kind)
            _ -> unsupported(self.parser.machine_parameters[slot].name.start)
        }
    }
    state allocate_parameter(index: i32, offset: i32, slot: i32, kind: i32) {
        transition self.require_cell(source, slot, kind) {
            1 -> parameter_reference(index, offset, slot, kind, 0)
            _ -> return 0
        }
    }
    // One reference parameter per callable excludes unknown inter-parameter
    // aliasing in this first profile. Borrowed argument evaluation still owns
    // its independent overlap checks; this signature bound is not a loan proof.
    state parameter_reference(index: i32, offset: i32, slot: i32, kind: i32, prior: i32) {
        transition (kind >= 400000) && (prior < offset) {
            true -> previous_reference(index, offset, slot, kind, prior)
            _ -> parameter_scope(index, offset, self.parser.machine_parameters[slot].name)
        }
    }
    state previous_reference(index: i32, offset: i32, slot: i32, kind: i32, prior: i32) {
        transition self.parameter_types[self.parser.machine_states[index].first_parameter + prior] >= 400000 {
            true -> unsupported(self.parser.machine_parameters[slot].name.start)
            _ -> parameter_reference(index, offset, slot, kind, prior + 1)
        }
    }
    state parameter_scope(index: i32, offset: i32, name: OmegaRelativeSpan) {
        transition (self.resolve_machine(source, name.start, name.end) < 0) &&
            (self.resolve_state(source, owner, name.start, name.end) < 0) {
            true -> parameter_names(index, offset, name, 0)
            _ -> unsupported(name.start)
        }
    }
    state parameter_names(index: i32, offset: i32, name: OmegaRelativeSpan, previous: i32) {
        transition previous < offset {
            true -> parameter_compare(index, offset, name, previous,
                self.parser.machine_parameters[self.parser.machine_states[index].first_parameter + previous].name)
            _ -> parameter(index, offset + 1)
        }
    }
    state parameter_compare(index: i32, offset: i32, name: OmegaRelativeSpan,
        previous: i32, other: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, source[other.start..other.end]) {
            1 -> duplicate(name.start)
            _ -> parameter_names(index, offset, name, previous + 1)
        }
    }
    state names(index: i32, previous: i32) {
        transition previous < index {
            true -> compare_name(index, previous, self.parser.machine_states[index].name,
                self.parser.machine_states[previous].name)
            _ -> next(index + 1)
        }
    }
    state compare_name(index: i32, previous: i32, name: OmegaRelativeSpan, other: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, source[other.start..other.end]) {
            1 -> same_name(index, previous, name.start)
            _ -> names(index, previous + 1)
        }
    }
    state same_name(index: i32, previous: i32, coordinate: i32) {
        transition self.parser.machine_states[index].parameter_count == self.parser.machine_states[previous].parameter_count {
            true -> same_parameters(index, previous, coordinate, 0)
            _ -> unsupported(coordinate)
        }
    }
    state same_parameters(index: i32, previous: i32, coordinate: i32, offset: i32) {
        transition offset < self.parser.machine_states[index].parameter_count {
            true -> same_parameter(index, previous, coordinate, offset)
            _ -> duplicate(coordinate)
        }
    }
    state same_parameter(index: i32, previous: i32, coordinate: i32, offset: i32) {
        transition self.parameter_types[self.parser.machine_states[index].first_parameter + offset] ==
            self.parameter_types[self.parser.machine_states[previous].first_parameter + offset] {
            true -> same_parameters(index, previous, coordinate, offset + 1)
            _ -> unsupported(coordinate)
        }
    }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
    state duplicate(coordinate: i32) { self.record_reject(10, 4, coordinate); return 0; }
}

machine OmegaScalarCompiler::compile(&mut self, source: &[u8], entry: &[u8]) {
    self.parser.sources.single(source.len);
    self.compile_set(source, 0, entry);
}

// The caller supplies only immutable bytes, package edges and source ranges.
// Parsing and declaration selection remain inside the compiler. This internal
// construction entry does not claim full OCREQ admission.
machine OmegaScalarCompiler::compile_set(&mut self, source: &[u8], entry_unit: i32, entry: &[u8]) {
    self.entry_unit = entry_unit;
    self.status = OmegaScalarCompilationStatus::Pending;
    self.diagnostic_offset = 0;
    self.literal_offset = 0;
    self.transition_anchor = 0;
    self.selected_machine = -1;
    self.outcome_tag = 0;
    self.outcome_space = 0;
    self.outcome_code = -1;
    self.outcome_coordinate = 0;
    self.outcome_package_ordinal = 0;
    self.outcome_unit_ordinal = 0;
    self.outcome_limit = 0;
    self.outcome_requested = 0;
    self.emission_resource = 12;
    self.call_edge_count = 0;
    self.loan_count = 0;
    self.layout_depth = 0;
    self.tape.initialize();
    self.parser.parse_set(source);
    transition self.parser.status {
        OmegaParserStatus::Complete -> check_roots()
        OmegaParserStatus::LexicalFailure -> lexical_reject()
        OmegaParserStatus::SyntaxFailure -> reject(-1, 4, self.parser.diagnostic_start)
        OmegaParserStatus::Incomplete -> incomplete(4, self.parser.incomplete_start)
        OmegaParserStatus::ResourceFailure -> resource()
        _ -> internal()
    }

    // The scanner retains the exact lexical diagnostic on LexicalFailure;
    // its code projects onto the contract's Reject codes 2..9 at the first
    // byte of the retained diagnostic span under canonical-source
    // coordinates.
    state lexical_reject() {
        let code: i32 = omega_lexical_reject_code(
            self.parser.scan.diagnostic_code);
        transition true {
            true -> reject(code, 4, self.parser.diagnostic_start)
        }
    }

    state check_roots() {
        transition (self.parser.root_count == self.parser.machine_count + self.parser.data_count + self.parser.use_count) &&
            (self.parser.machine_count > 0) && (self.entry_unit >= 0) &&
            (self.entry_unit < self.parser.sources.unit_count) {
            true -> imports()
            _ -> non_machine_root(0)
        }
    }
    state imports() {
        transition self.validate_imports(source) {
            1 -> reset_storage(0)
            _ -> return
        }
    }
    state reset_storage(index: i32) {
        transition index < self.cell_count {
            true -> clear_cell(index)
            _ -> storage_empty()
        }
    }
    state clear_cell(index: i32) {
        self.cell_sizes[self.cell_ids[index]] = 0;
        transition true { true -> reset_storage(index + 1) }
    }
    state storage_empty() {
        self.cell_count = 0;
        self.storage_size = 0;
        self.bound_total = 0;
        self.effect_count = 0;
        transition true { true -> reset_case_names(0) }
    }
    state reset_case_names(index: i32) {
        transition index < self.case_name_count {
            true -> clear_case_bucket(index)
            _ -> case_names_empty()
        }
    }
    state clear_case_bucket(index: i32) {
        self.case_name_heads[self.case_name_buckets[index]] = 0;
        transition true { true -> reset_case_names(index + 1) }
    }
    state case_names_empty() {
        self.case_name_count = 0;
        transition true { true -> reset_data(0) }
    }
    state reset_data(index: i32) {
        transition index < self.parser.data_count {
            true -> clear_data(index)
            _ -> data_names(0)
        }
    }
    state clear_data(index: i32) {
        self.data_colors[index] = 0;
        transition true { true -> reset_data(index + 1) }
    }
    state data_names(index: i32) {
        transition index < self.parser.data_count {
            true -> data_name(index, self.parser.data_items[index].name)
            _ -> layouts(0)
        }
    }
    state data_name(index: i32, name: OmegaRelativeSpan) {
        transition self.resolve_data(source, name.start, name.end) == index {
            true -> data_namespace(index, name)
            _ -> reject(10, 4, name.start)
        }
    }
    state data_namespace(index: i32, name: OmegaRelativeSpan) {
        transition (self.resolve_machine(source, name.start, name.end) < 0) &&
            (self.span_equals(source, name.start, name.end, "u8") == 0) &&
            (self.span_equals(source, name.start, name.end, "u32") == 0) &&
            (self.span_equals(source, name.start, name.end, "u64") == 0) &&
            (self.span_equals(source, name.start, name.end, "bool") == 0) &&
            (self.span_equals(source, name.start, name.end, "Trapping") == 0) {
            true -> data_names(index + 1)
            _ -> incomplete(4, name.start)
        }
    }
    state layouts(index: i32) {
        transition index < self.parser.data_count {
            true -> layout(index)
            _ -> reset_call_graph(0)
        }
    }
    state layout(index: i32) {
        transition self.layout_data(source, index) {
            1 -> layouts(index + 1)
            _ -> return
        }
    }

    state reset_call_graph(index: i32) {
        transition index < self.parser.machine_count {
            true -> reset_call_node(index)
            _ -> check_declarations(0)
        }
    }

    state reset_call_node(index: i32) {
        self.call_edge_heads[index] = -1;
        self.call_colors[index] = 0;
        self.machine_may_trap[index] = 0;
        transition true { true -> reset_call_graph(index + 1) }
    }

    // A non-machine root is valid Omega this slice does not implement; the
    // coverage refusal anchors at the first such root's item start. A source
    // with no roots at all has no source position and reports space 0.
    state non_machine_root(index: i32) {
        transition index < self.parser.root_count {
            true -> root_kind(index)
            _ -> incomplete(0, 0)
        }
    }

    state root_kind(index: i32) {
        transition self.parser.roots[index].kind {
            OmegaRootKind::Machine -> non_machine_root(index + 1)
            OmegaRootKind::Data -> non_machine_root(index + 1)
            _ -> incomplete(4, self.parser.uses[
                self.parser.roots[index].item_index].start)
        }
    }

    // Census all declaration identities before any body can resolve a call.
    // Otherwise an earlier caller could select the first member of a later
    // overload family and falsely reject its arity before coverage is known.
    state check_declarations(index: i32) {
        transition index < self.parser.machine_count {
            true -> machine_shape(index)
            _ -> public_interfaces()
        }
    }
    state public_interfaces() {
        transition self.check_public_interfaces(source) {
            1 -> check_entry_bounds(0)
            _ -> return
        }
    }
    state check_entry_bounds(state_index: i32) {
        transition state_index < self.parser.machine_state_count {
            true -> decode_entry_bounds(state_index)
            _ -> check_machine(0)
        }
    }
    state decode_entry_bounds(state_index: i32) {
        transition self.decode_entry_bounds(source, state_index) {
            1 -> check_entry_bounds(state_index + 1)
            _ -> return
        }
    }

    state check_machine(index: i32) {
        transition index < self.parser.machine_count {
            true -> begin_states(index)
            _ -> check_entry()
        }
    }

    state machine_shape(index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        self.diagnostic_offset = item.start;
        transition (item.path_member_count == 1) && (item.state_count >= 1) &&
            (item.clause_count == 0) && (item.is_bodyless == 0) &&
            (item.has_target == 0) {
            true -> machine_signatures(index)
            _ -> incomplete(4, self.diagnostic_offset)
        }
    }

    // An empty unannotated outer body may have no generated entry row.
    // Its first nested declaration must never become the outer callable.
    state machine_signatures(index: i32) {
        transition self.parser.machine_states[
            self.parser.machine_items[index].first_state].name_kind {
            OmegaMachineStateNameKind::GeneratedEntry -> machine_types(index)
            _ -> incomplete(4, self.diagnostic_offset)
        }
    }

    state machine_types(index: i32) {
        transition self.check_signatures(source, index) {
            1 -> check_duplicate(index, 0)
            _ -> return
        }
    }

    state check_duplicate(index: i32, previous: i32) {
        transition previous < index {
            true -> compare_name(index, previous)
            _ -> check_declarations(index + 1)
        }
    }

    state compare_name(index: i32, previous: i32) {
        let name: OmegaRelativeSpan = self.parser.members[
            self.parser.machine_items[index].first_path_member];
        let other: OmegaRelativeSpan = self.parser.members[
            self.parser.machine_items[previous].first_path_member];
        transition (self.same_module(source, self.parser.sources.unit_at(name.start),
            self.parser.sources.unit_at(other.start)) == 1) &&
            (self.span_equals(source, name.start, name.end, source[other.start..other.end]) == 1) {
            true -> duplicate_arity(index, previous, name.start)
            _ -> check_duplicate(index, previous + 1)
        }
    }

    // Structural identity ignores parameter spelling. Differing arity or an
    // unimplemented operand type denotes an unsupported overload family.
    state duplicate_arity(index: i32, previous: i32, coordinate: i32) {
        transition self.parser.machine_states[
            self.parser.machine_items[index].first_state].parameter_count ==
            self.parser.machine_states[
            self.parser.machine_items[previous].first_state].parameter_count {
            true -> duplicate_parameter(index, previous, 0, coordinate)
            _ -> incomplete(4, coordinate)
        }
    }

    state duplicate_parameter(index: i32, previous: i32, offset: i32, coordinate: i32) {
        transition offset < self.parser.machine_states[
            self.parser.machine_items[index].first_state].parameter_count {
            true -> duplicate_parameter_type(index, previous, offset, coordinate)
            _ -> reject(10, 4, coordinate)
        }
    }

    state duplicate_parameter_type(index: i32, previous: i32,
        offset: i32, coordinate: i32) {
        transition self.parameter_types[self.parser.machine_states[
            self.parser.machine_items[index].first_state].first_parameter + offset] ==
            self.parameter_types[self.parser.machine_states[
            self.parser.machine_items[previous].first_state].first_parameter + offset] {
            true -> duplicate_parameter(index, previous, offset + 1, coordinate)
            _ -> incomplete(4, coordinate)
        }
    }

    // A free machine owns a contiguous run of machine_states rows; the first
    // is its generated top-level entry and the rest are authored states.
    state begin_states(index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        self.diagnostic_offset = item.start;
        transition true { true -> check_states(index, item.first_state) }
    }

    state check_states(index: i32, state_index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        transition state_index < item.first_state + item.state_count {
            true -> state_body(index, state_index)
            _ -> finish_machine(index)
        }
    }

    state state_body(index: i32, state_index: i32) {
        transition self.parser.machine_states[state_index].statement_count {
            0 -> missing_terminal(index, state_index)
            _ -> check_statement(index, state_index, 0)
        }
    }

    // A body ending after its last statement completes with Unit. That is
    // its own result, never an inherited result from an enclosing machine.
    state missing_terminal(index: i32, state_index: i32) {
        transition self.state_types[state_index] == 2 {
            true -> unit_terminal(index, state_index)
            _ -> missing_scalar_terminal(index, state_index)
        }
    }
    state unit_terminal(index: i32, state_index: i32) {
        self.state_terminal_kind[state_index] = 6;
        transition true { true -> check_states(index, state_index + 1) }
    }
    state missing_scalar_terminal(index: i32, state_index: i32) {
        transition state_index ==
            self.parser.machine_items[index].first_state {
            true -> reject(-1, 4, self.diagnostic_offset)
            _ -> reject(-1, 4,
                self.parser.machine_states[state_index].name.start)
        }
    }

    state check_statement(index: i32, state_index: i32, statement_offset: i32) {
        let statement: i32 =
            self.parser.machine_states[state_index].first_statement +
            statement_offset;
        transition self.parser.statements[statement].kind {
            OmegaStatementKind::Call -> check_call(index, state_index, statement)
            OmegaStatementKind::Expression ->
                check_terminal(index, state_index, statement_offset, statement)
            OmegaStatementKind::Transition ->
                check_transition(index, state_index, statement_offset)
            OmegaStatementKind::Assignment ->
                check_assignment(index, state_index, statement_offset,
                    self.parser.assignment_statements[self.parser.statements[statement].item_index])
            OmegaStatementKind::LocalData ->
                check_local(index, state_index, statement_offset,
                    self.parser.local_data_statements[self.parser.statements[statement].item_index])
            _ -> internal()
        }
    }

    state check_local(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        let kind: i32 = self.scalar_type(source, local.type_reference);
        transition (kind > 0) && (kind != 2) && (kind < 200000) {
            true -> local_name(index, state_index, statement_offset, local)
            _ -> incomplete(4, local.start)
        }
    }

    state local_name(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition self.value_cell(source, state_index, statement_offset,
            local.name.start, local.name.end) < 0 {
            true -> local_scope(index, state_index, statement_offset, local)
            _ -> reject(10, 4, local.name.start)
        }
    }

    state local_scope(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition (self.resolve_machine(source, local.name.start, local.name.end) < 0) &&
            (self.resolve_state(source, index, local.name.start, local.name.end) < 0) {
            true -> local_value(index, state_index, statement_offset, local)
            _ -> incomplete(4, local.name.start)
        }
    }

    state local_value(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        let local_index: i32 = self.parser.statements[
            self.parser.machine_states[state_index].first_statement + statement_offset].item_index;
        self.local_befores[local_index] = statement_offset;
        transition self.require_cell(source, 16384 + local_index, self.scalar_type(source, local.type_reference)) {
            1 -> local_initial_value(index, state_index, statement_offset, local)
            _ -> return
        }
    }
    state local_initial_value(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition local.has_initial_value {
            0 -> next_statement(index, state_index, statement_offset + 1)
            _ -> local_check_initial(index, state_index, statement_offset, local)
        }
    }
    state local_check_initial(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition self.check_value(source, index, state_index, statement_offset,
            local.initial_value, self.scalar_type(source, local.type_reference)) {
            1 -> next_statement(index, state_index, statement_offset + 1)
            _ -> return
        }
    }
    state check_assignment(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        self.assignment_loan_base = self.loan_count;
        transition self.check_place(source, state_index, statement_offset, row.target) {
            1 -> assignment_access(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_access(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.place_writable[row.target] == 1 {
            true -> assignment_available(index, state_index, statement_offset, row)
            _ -> reject(-1, 4, row.start)
        }
    }
    state assignment_available(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition (self.place_available(source, row.target, 1) == 1) &&
            (self.require_cell(source, 49152 + row.target, 32) == 1) {
            true -> assignment_copy(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_copy(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.type_copy(source, self.place_types[row.target]) {
            1 -> assignment_loan(index, state_index, statement_offset, row)
            _ -> incomplete(4, row.start)
        }
    }
    state assignment_loan(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.parser.expressions[row.target].kind {
            OmegaExpressionKind::Indexed -> indexed_assignment_loan(index, state_index, statement_offset, row)
            _ -> assignment_value(index, state_index, statement_offset, row)
        }
    }
    state indexed_assignment_loan(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.retain_index_loan(row.target) {
            1 -> assignment_value(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_value(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.check_value(source, index, state_index, statement_offset,
            row.value, self.place_types[row.target]) {
            1 -> assignment_bound(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_bound(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.place_fields[row.target] >= 0 {
            true -> assignment_field_bound(index, state_index, statement_offset, row)
            _ -> assignment_done(index, state_index, statement_offset)
        }
    }
    state assignment_field_bound(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.check_field_bound(source, self.place_fields[row.target], row.value) {
            1 -> assignment_done(index, state_index, statement_offset)
            _ -> return
        }
    }
    state assignment_done(index: i32, state_index: i32, statement_offset: i32) {
        self.loan_count = self.assignment_loan_base;
        transition true { true -> next_statement(index, state_index, statement_offset + 1) }
    }

    state next_statement(index: i32, state_index: i32, statement_offset: i32) {
        transition statement_offset <
            self.parser.machine_states[state_index].statement_count {
            true -> check_statement(index, state_index, statement_offset)
            _ -> missing_terminal(index, state_index)
        }
    }

    // Non-terminal statements are ordinary calls into free machines. Receiver
    // paths and static machine arguments remain coverage boundaries.
    state check_call(index: i32, state_index: i32, statement: i32) {
        let call: OmegaCallStatementSyntax = self.parser.call_statements[
            self.parser.statements[statement].item_index];
        transition (call.receiver_member_count + 1 == call.name_member_count) &&
            (call.receiver_starts_at_self == 0) &&
            (call.machine_argument_count == 0) {
            true -> call_target(index, state_index, statement, call)
            _ -> incomplete(4, call.start)
        }
    }

    state call_target(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax) {
        let name: OmegaRelativeSpan = self.parser.members[call.target_member];
        transition (call.receiver_member_count > 0) ||
            (self.resolve_state(source, index, name.start, name.end) < 0) {
            true -> global_call_target(index, state_index, statement, call, name)
            _ -> incomplete(4, name.start)
        }
    }

    state global_call_target(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, name: OmegaRelativeSpan) {
        let callee: i32 = self.resolve_machine(source,
            self.parser.members[call.first_receiver_member].start, name.end);
        transition callee >= 0 {
            true -> call_arity(index, state_index, statement, call, callee)
            _ -> reject(-1, 4, name.start)
        }
    }

    // Every ordinary argument must match the callee's declared scalar parameter
    // list; a mismatched arity is a checking refusal.
    state call_arity(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition call.argument_count == self.parser.machine_states[
            self.parser.machine_items[callee].first_state].parameter_count {
            true -> call_values(index, state_index, statement, call, callee)
            _ -> reject(-1, 4, call.start)
        }
    }

    state call_values(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition self.check_value_arguments(source, index, state_index,
            statement - self.parser.machine_states[state_index].first_statement,
            call.first_argument, call.argument_count,
            self.parser.machine_states[self.parser.machine_items[callee].first_state].first_parameter, 0) {
            1 -> call_contract(index, state_index, statement, call, callee)
            _ -> return
        }
    }

    state call_contract(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition self.check_call_bounds(source, state_index,
            statement - self.parser.machine_states[state_index].first_statement,
            call.first_argument, call.argument_count, self.parser.machine_items[callee].first_state, -1, 0) {
            1 -> call_edge(index, state_index, statement, call, callee)
            _ -> return
        }
    }
    state call_edge(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition (self.retain_edge(index, callee, call.start) == 1) &&
            (self.retain_call_effects(state_index,
                statement - self.parser.machine_states[state_index].first_statement,
                call.first_argument, call.argument_count,
                self.parser.machine_states[self.parser.machine_items[callee].first_state].first_parameter) == 1) {
            true -> retain_call(index, state_index, statement, callee)
            _ -> return
        }
    }

    state retain_call(index: i32, state_index: i32, statement: i32, callee: i32) {
        self.call_targets[statement] = callee;
        let next: i32 = statement + 1 -
            self.parser.machine_states[state_index].first_statement;
        transition true {
            true -> next_statement(index, state_index, next)
        }
    }

    // The parser retains an expression statement only as a state's terminal.
    state check_terminal(index: i32, state_index: i32, statement_offset: i32,
        statement: i32) {
        transition statement_offset ==
            self.parser.machine_states[state_index].statement_count - 1 {
            true -> terminal_kind(index, state_index,
                self.parser.statements[statement].item_index)
            _ -> internal()
        }
    }

    state terminal_kind(index: i32, state_index: i32, expression: i32) {
        transition self.check_value(source, index, state_index,
            self.parser.machine_states[state_index].statement_count - 1, expression,
            self.state_types[state_index]) {
            1 -> retain_value_terminal(index, state_index, expression)
            _ -> return
        }
    }

    state retain_value_terminal(index: i32, state_index: i32, expression: i32) {
        self.state_terminal_kind[state_index] = 4;
        self.state_targets[state_index] = expression;
        transition true { true -> check_states(index, state_index + 1) }
    }

    // A transition block is the consecutive run of transition rows sharing
    // one subject; the parser expands every arm into its own row, so the run
    // boundary is the first row whose subject differs or whose kind is not
    // Transition. The block must close the state: a row after the run would
    // be unreachable, a coverage boundary this slice refuses as Incomplete.
    state check_transition(index: i32, state_index: i32, statement_offset: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[state_index].first_statement +
                    statement_offset].item_index];
        self.transition_anchor = row.start;
        transition true {
            true -> transition_run_end(index, state_index, statement_offset,
                statement_offset + 1, row.has_subject, row.subject)
        }
    }

    state transition_run_end(index: i32, state_index: i32, statement_offset: i32,
        cursor: i32, has_subject: i32, subject: i32) {
        transition cursor <
            self.parser.machine_states[state_index].statement_count {
            true -> transition_run_row(index, state_index, statement_offset,
                cursor, has_subject, subject)
            _ -> transition_subject(index, state_index, statement_offset,
                cursor, has_subject, subject)
        }
    }

    state transition_run_row(index: i32, state_index: i32, statement_offset: i32,
        cursor: i32, has_subject: i32, subject: i32) {
        transition self.parser.statements[
            self.parser.machine_states[state_index].first_statement +
            cursor].kind {
            OmegaStatementKind::Transition ->
                transition_run_signature(index, state_index, statement_offset,
                    cursor, has_subject, subject)
            _ -> incomplete(4, self.transition_anchor)
        }
    }

    state transition_run_signature(index: i32, state_index: i32,
        statement_offset: i32, cursor: i32, has_subject: i32, subject: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[state_index].first_statement +
                    cursor].item_index];
        transition (row.has_subject == has_subject) && (row.subject == subject) {
            true -> transition_run_end(index, state_index, statement_offset,
                cursor + 1, has_subject, subject)
            _ -> incomplete(4, self.transition_anchor)
        }
    }

    state transition_subject(index: i32, state_index: i32,
        statement_offset: i32, run_end: i32, has_subject: i32, subject: i32) {
        transition has_subject {
            0 -> subjectless(index, state_index, statement_offset, run_end)
            1 -> subject_kind(index, state_index, statement_offset, run_end,
                subject)
            _ -> internal()
        }
    }

    // The admitted subjectless block is exactly one wildcard arm.
    state subjectless(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32) {
        transition run_end == statement_offset + 1 {
            true -> subjectless_guard(index, state_index, statement_offset)
            _ -> incomplete(4, self.transition_anchor)
        }
    }

    state subjectless_guard(index: i32, state_index: i32,
        statement_offset: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[state_index].first_statement +
                    statement_offset].item_index];
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always ->
                subjectless_target(index, state_index, statement_offset)
            _ -> incomplete(4, row.start)
        }
    }

    state subjectless_target(index: i32, state_index: i32,
        statement_offset: i32) {
        let row_index: i32 = self.parser.statements[
            self.parser.machine_states[state_index].first_statement + statement_offset].item_index;
        transition self.check_transition_target(source, index, state_index, statement_offset, row_index) {
            1 -> retain_transition(index, state_index, row_index)
            _ -> return
        }
    }

    // A subject transition folds its subject once: a Boolean literal keeps
    // its Boolean class, and any other admitted spelling folds to a u8 under
    // the same Exact policy as a terminal expression.
    state subject_kind(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition self.is_constant_expression(subject) {
            1 -> subject_fold(index, state_index, statement_offset, run_end, subject)
            _ -> dynamic_subject(index, state_index, statement_offset, run_end, subject)
        }
    }

    state dynamic_subject(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition true { true -> dynamic_type(index, state_index, statement_offset, run_end, subject,
            self.expression_type(source, index, state_index, statement_offset, subject)) }
    }
    state dynamic_type(index: i32, state_index: i32, first: i32, last: i32, subject: i32, kind: i32) {
        transition kind {
            1 -> dynamic_value(index, state_index, first, last, subject)
            _ -> dynamic_sum(index, state_index, first, last, kind)
        }
    }
    state dynamic_sum(index: i32, state_index: i32, first: i32, last: i32, kind: i32) {
        transition (kind >= 100000) && (kind < 104096) {
            true -> dynamic_sum_shape(index, state_index, first, last, kind - 100000)
            _ -> incomplete(4, self.transition_anchor)
        }
    }
    state dynamic_sum_shape(index: i32, state_index: i32, first: i32, last: i32, declaration: i32) {
        transition self.parser.data_items[declaration].case_count > 0 {
            true -> dynamic_sum_check(index, state_index, first, last, declaration)
            _ -> incomplete(4, self.transition_anchor)
        }
    }
    state dynamic_sum_check(index: i32, state_index: i32, first: i32, last: i32, declaration: i32) {
        transition self.check_case_transition(source, index, state_index, first, last, declaration) {
            1 -> retain_dynamic(index, state_index, first, last)
            _ -> return
        }
    }

    state dynamic_value(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition self.check_value(source, index, state_index, statement_offset, subject, 1) {
            1 -> dynamic_arm(index, state_index, statement_offset, run_end, statement_offset, 0)
            _ -> return
        }
    }

    state dynamic_arm(index: i32, state_index: i32, first: i32, last: i32, arm: i32, covered: i32) {
        transition arm < last {
            true -> dynamic_guard(index, state_index, first, last, arm, covered,
                self.parser.transition_statements[self.parser.statements[
                    self.parser.machine_states[state_index].first_statement + arm].item_index])
            _ -> dynamic_covered(index, state_index, first, last, covered)
        }
    }
    state dynamic_guard(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row: OmegaTransitionStatementSyntax) {
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always -> dynamic_target(index, state_index, first, last, arm, 3)
            OmegaTransitionGuardKind::Boolean -> dynamic_boolean(index, state_index, first, last, arm, covered, row.guard_boolean)
            _ -> incomplete(4, row.guard_start)
        }
    }
    state dynamic_boolean(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, value: i32) {
        transition value {
            0 -> dynamic_target(index, state_index, first, last, arm, covered | 1)
            _ -> dynamic_target(index, state_index, first, last, arm, covered | 2)
        }
    }
    state dynamic_target(index: i32, state_index: i32, first: i32, last: i32, arm: i32, covered: i32) {
        transition self.check_transition_target(source, index, state_index, first,
            self.parser.statements[self.parser.machine_states[state_index].first_statement + arm].item_index) {
            1 -> dynamic_arm(index, state_index, first, last, arm + 1, covered)
            _ -> return
        }
    }
    state dynamic_covered(index: i32, state_index: i32, first: i32, last: i32, covered: i32) {
        transition covered == 3 {
            true -> retain_dynamic(index, state_index, first, last)
            _ -> reject(-1, 4, self.transition_anchor)
        }
    }
    state retain_dynamic(index: i32, state_index: i32, first: i32, last: i32) {
        self.state_terminal_kind[state_index] = 5;
        self.state_targets[state_index] = first;
        self.state_values[state_index] = last;
        transition true { true -> check_states(index, state_index + 1) }
    }

    state subject_fold(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition self.is_bounded_constant(source, subject) {
            1 -> subject_fold_value(index, state_index, statement_offset, run_end, subject)
            _ -> incomplete(4, self.transition_anchor)
        }
    }
    state subject_fold_value(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition self.fold_expression(source, subject) {
            0 -> subject_folded(index, state_index, statement_offset, run_end)
            1 -> incomplete(4, self.transition_anchor)
            _ -> return
        }
    }

    state subject_folded(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32) {
        self.subject_class = self.fold_class;
        self.subject_value = self.fold_value;
        transition true {
            true -> scan_arm(index, state_index, run_end, statement_offset, -1)
        }
    }

    // Arms are checked in source order: each guard either proves it matches
    // the folded subject or stays a coverage refusal, every arm's target
    // resolves and binds, and the first matching arm owns the transition.
    state scan_arm(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32) {
        transition arm < run_end {
            true -> arm_guard(index, state_index, run_end, arm, selected)
            _ -> transition_covered(index, state_index, selected)
        }
    }

    state arm_guard(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[state_index].first_statement +
                    arm].item_index];
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always ->
                arm_target(index, state_index, run_end, arm, selected, 1)
            OmegaTransitionGuardKind::Integer ->
                arm_integer(index, state_index, run_end, arm, selected)
            OmegaTransitionGuardKind::Boolean ->
                arm_boolean(index, state_index, run_end, arm, selected, row)
            _ -> incomplete(4, row.guard_start)
        }
    }

    // An integer guard can only match a u8 subject; its literal folds under
    // the same bounds as an expression literal.
    state arm_integer(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[state_index].first_statement +
                    arm].item_index];
        transition self.subject_class {
            0 -> arm_integer_literal(index, state_index, run_end, arm,
                selected, row)
            _ -> incomplete(4, row.guard_start)
        }
    }

    state arm_integer_literal(index: i32, state_index: i32, run_end: i32,
        arm: i32, selected: i32, row: OmegaTransitionStatementSyntax) {
        let literal: i32 = self.scan_u8(source, row.guard_start, row.guard_end);
        transition literal < 256 {
            true -> arm_integer_compare(index, state_index, run_end, arm,
                selected, row, literal)
            _ -> arm_integer_failed(row, literal)
        }
    }

    state arm_integer_failed(row: OmegaTransitionStatementSyntax, literal: i32) {
        transition literal == 256 {
            true -> incomplete(4, row.guard_start)
            _ -> reject(12, 4, row.guard_start)
        }
    }

    state arm_integer_compare(index: i32, state_index: i32, run_end: i32,
        arm: i32, selected: i32, row: OmegaTransitionStatementSyntax,
        literal: i32) {
        transition literal == self.subject_value {
            true -> arm_target(index, state_index, run_end, arm, selected, 1)
            _ -> arm_target(index, state_index, run_end, arm, selected, 0)
        }
    }

    // A Boolean guard can only match a Boolean subject.
    state arm_boolean(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32, row: OmegaTransitionStatementSyntax) {
        transition self.subject_class == 1 {
            true -> arm_boolean_compare(index, state_index, run_end, arm,
                selected, row)
            _ -> incomplete(4, row.guard_start)
        }
    }

    state arm_boolean_compare(index: i32, state_index: i32, run_end: i32,
        arm: i32, selected: i32, row: OmegaTransitionStatementSyntax) {
        transition row.guard_boolean == self.subject_value {
            true -> arm_target(index, state_index, run_end, arm, selected, 1)
            _ -> arm_target(index, state_index, run_end, arm, selected, 0)
        }
    }

    state arm_target(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32, matched: i32) {
        let row_index: i32 = self.parser.statements[
            self.parser.machine_states[state_index].first_statement + arm].item_index;
        transition self.check_transition_target(source, index, state_index,
            arm, row_index) {
            1 -> arm_advance(index, state_index, run_end, arm, selected, matched, row_index)
            _ -> return
        }
    }
    state arm_advance(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32, matched: i32, row_index: i32) {
        transition (matched == 1) && (selected < 0) {
            true -> scan_arm(index, state_index, run_end, arm + 1, row_index)
            _ -> scan_arm(index, state_index, run_end, arm + 1, selected)
        }
    }

    // A subjectful block that matched no arm has no transfer for its subject
    // value, a checking refusal anchored at the block's first arrow.
    state transition_covered(index: i32, state_index: i32, selected: i32) {
        transition selected >= 0 {
            true -> retain_transition(index, state_index, selected)
            _ -> reject(-1, 4, self.transition_anchor)
        }
    }

    state retain_transition(index: i32, state_index: i32, target: i32) {
        self.state_terminal_kind[state_index] = 3;
        self.state_targets[state_index] = target;
        transition true { true -> check_states(index, state_index + 1) }
    }

    state finish_machine(index: i32) {
        let name: OmegaRelativeSpan = self.parser.members[
            self.parser.machine_items[index].first_path_member];
        transition (self.parser.sources.unit_at(name.start) == self.entry_unit) &&
            (self.span_equals(source, name.start, name.end, entry) == 1) {
            true -> select(index)
            _ -> check_machine(index + 1)
        }
    }

    state select(index: i32) {
        self.selected_machine = index;
        transition true { true -> check_machine(index + 1) }
    }

    state check_entry() {
        transition self.selected_machine >= 0 {
            true -> entry_arity()
            _ -> reject(11, 0, 0)
        }
    }

    state entry_arity() {
        transition self.parser.machine_states[
            self.parser.machine_items[self.selected_machine].first_state].parameter_count {
            0 -> entry_result()
            _ -> incomplete(4, self.parser.machine_items[self.selected_machine].start)
        }
    }

    state entry_result() {
        transition self.state_types[self.parser.machine_items[self.selected_machine].first_state] == 8 {
            true -> call_graph()
            _ -> incomplete(4, self.parser.machine_items[self.selected_machine].start)
        }
    }

    state call_graph() {
        transition self.check_call_graph() {
            1 -> public_crashes(0)
            _ -> return
        }
    }

    // Authored effect clauses remain outside this slice. Preserve the core
    // may-summary through every call and refuse a public no-crash promise
    // rather than shrinking that summary because our implementation is total.
    state public_crashes(index: i32) {
        transition index < self.parser.machine_count {
            true -> public_crash_bound(index)
            _ -> labels(0)
        }
    }
    state public_crash_bound(index: i32) {
        transition (self.parser.machine_items[index].is_public != 0) &&
            (self.machine_may_trap[index] != 0) {
            true -> incomplete(4, self.parser.machine_items[index].start)
            _ -> public_crashes(index + 1)
        }
    }

    // One Alpha label per parsed state and per machine entry; a machine's
    // label is its entry state's label, so calls and adapter entry reach the
    // top-level body exactly as the state contract specifies.
    state labels(index: i32) {
        transition index < self.parser.machine_state_count {
            true -> label(index)
            _ -> machine_entry_labels(0)
        }
    }

    state label(index: i32) {
        self.emission_resource = 14;
        self.state_labels[index] = self.tape.new_label();
        transition self.state_labels[index] >= 0 {
            true -> labels(index + 1)
            _ -> emission_failure()
        }
    }

    state machine_entry_labels(index: i32) {
        transition index < self.parser.machine_count {
            true -> machine_entry_label(index)
            _ -> adapter()
        }
    }

    state machine_entry_label(index: i32) {
        self.machine_labels[index] = self.state_labels[
            self.parser.machine_items[index].first_state];
        transition true { true -> machine_entry_labels(index + 1) }
    }

    state adapter() {
        self.emission_resource = 12;
        transition (self.tape.emit_jump_label(19,
            self.machine_labels[self.selected_machine]) == 1) &&
            (self.tape.emit_r(0, 0) == 1) {
            true -> emit_machine(0)
            _ -> emission_failure()
        }
    }

    state emit_machine(index: i32) {
        transition index < self.parser.machine_count {
            true -> emit_first_state(index)
            _ -> finalize()
        }
    }

    state emit_first_state(index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        transition true {
            true -> emit_state(index, item.first_state)
        }
    }

    // States emit in declared order: each defines its label, runs its
    // non-terminal calls, then its single terminal exit.
    state emit_state(index: i32, state_index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        transition state_index < item.first_state + item.state_count {
            true -> emit_state_body(index, state_index)
            _ -> emit_machine(index + 1)
        }
    }

    state emit_state_body(index: i32, state_index: i32) {
        self.emission_resource = 12;
        transition self.tape.define_label(self.state_labels[state_index]) {
            1 -> emit_statements(index, state_index, 0)
            _ -> emission_failure()
        }
    }

    state emit_statements(index: i32, state_index: i32,
        statement_offset: i32) {
        transition (statement_offset < self.parser.machine_states[state_index].statement_count) &&
            ((self.state_terminal_kind[state_index] == 6) ||
            (statement_offset < self.parser.machine_states[state_index].statement_count - 1)) {
            true -> emit_nonterminal(index, state_index, statement_offset)
            _ -> emit_terminal(index, state_index)
        }
    }

    // Non-terminal transition rows are the arms of the state's tail block;
    // their single selected target emits once at the terminal.
    state emit_nonterminal(index: i32, state_index: i32,
        statement_offset: i32) {
        transition self.parser.statements[
            self.parser.machine_states[state_index].first_statement +
            statement_offset].kind {
            OmegaStatementKind::Call ->
                emit_call_statement(index, state_index, statement_offset)
            OmegaStatementKind::Transition ->
                emit_statements(index, state_index, statement_offset + 1)
            OmegaStatementKind::LocalData ->
                emit_local(index, state_index, statement_offset)
            OmegaStatementKind::Assignment ->
                emit_assignment_statement(index, state_index, statement_offset)
            _ -> internal()
        }
    }

    state emit_local(index: i32, state_index: i32, statement_offset: i32) {
        let local_index: i32 = self.parser.statements[
            self.parser.machine_states[state_index].first_statement + statement_offset].item_index;
        self.local_befores[local_index] = statement_offset;
        transition self.parser.local_data_statements[local_index].has_initial_value {
            0 -> emit_local_zero(index, state_index, statement_offset, local_index)
            _ -> emit_local_value(index, state_index, statement_offset, local_index)
        }
    }
    state emit_local_zero(index: i32, state_index: i32, statement_offset: i32, local_index: i32) {
        transition self.emit_zero_cell(16384 + local_index) {
            1 -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }
    state emit_local_value(index: i32, state_index: i32, statement_offset: i32, local_index: i32) {
        transition (self.emit_value(self.parser.local_data_statements[local_index].initial_value) == 1) &&
            (self.emit_value_store(16384 + local_index) == 1) {
            true -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }
    state emit_assignment_statement(index: i32, state_index: i32, statement_offset: i32) {
        let row: OmegaAssignmentStatementSyntax = self.parser.assignment_statements[
            self.parser.statements[self.parser.machine_states[state_index].first_statement + statement_offset].item_index];
        transition (self.emit_place_address(row.target) == 1) &&
            (self.emit_value_store(49152 + row.target) == 1) &&
            (self.emit_value(row.value) == 1) &&
            (self.tape.emit_rr(2, 2, 0) == 1) &&
            (self.emit_value_load(49152 + row.target) == 1) &&
            (self.tape.emit_rr(2, 1, 0) == 1) &&
            (self.tape.emit_rr(2, 0, 2) == 1) &&
            (self.emit_store_at(self.place_types[row.target], self.place_extent[row.target]) == 1) {
            true -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }

    state emit_call_statement(index: i32, state_index: i32,
        statement_offset: i32) {
        let callee: i32 = self.call_targets[
            self.parser.machine_states[state_index].first_statement +
            statement_offset];
        let call: OmegaCallStatementSyntax = self.parser.call_statements[
            self.parser.statements[self.parser.machine_states[state_index].first_statement +
                statement_offset].item_index];
        transition self.emit_value_call(callee, call.first_argument, call.argument_count) {
            1 -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }

    state emit_terminal(index: i32, state_index: i32) {
        transition self.state_terminal_kind[state_index] {
            3 -> emit_jump_terminal(index, state_index)
            4 -> emit_value_terminal(index, state_index)
            5 -> emit_dynamic_terminal(index, state_index)
            6 -> emit_unit_terminal(index, state_index)
            _ -> internal()
        }
    }
    state emit_unit_terminal(index: i32, state_index: i32) {
        transition (self.tape.emit_imm(0, 0, 0) == 1) && (self.tape.emit_ret() == 1) {
            true -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }

    state emit_value_terminal(index: i32, state_index: i32) {
        transition (self.emit_value(self.state_targets[state_index]) == 1) &&
            (self.tape.emit_ret() == 1) {
            true -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }

    // A transition is a direct jump: no call frame, no return edge, and the
    // departed state never resumes.
    state emit_jump_terminal(index: i32, state_index: i32) {
        transition self.emit_transition_target(self.state_targets[state_index]) {
            1 -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }
    state emit_dynamic_terminal(index: i32, state_index: i32) {
        transition self.emit_dynamic_transition(state_index,
            self.state_targets[state_index], self.state_values[state_index]) {
            1 -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }

    state finalize() {
        transition self.tape.finalize() {
            1 -> complete()
            _ -> emission_failure()
        }
    }

    state emission_failure() {
        transition self.tape.status {
            1 -> emission_resource()
            _ -> emission_internal()
        }
    }

    // Tape construction capacity reports under space 2 with the resource the
    // refused operation was drawing on; coordinates are payload-relative.
    state emission_resource() {
        self.status = OmegaScalarCompilationStatus::ResourceFailure;
        self.outcome_tag = 2;
        self.outcome_space = 2;
        self.outcome_code = self.emission_resource;
        self.outcome_coordinate = self.tape.failure_offset;
        self.outcome_limit = omega_compiler_resource_limit(
            self.emission_resource);
        transition self.emission_resource {
            12 -> emission_payload_requested()
            _ -> emission_generic_requested()
        }
    }

    // tape_payload_bytes exhaustion requests the committed payload length
    // plus the refused write, normalized for publication.
    state emission_payload_requested() {
        self.outcome_requested = omega_saturating_i32_sum(
            self.tape.failure_offset, self.tape.failure_requested);
        return;
    }

    state emission_generic_requested() {
        self.outcome_requested = self.tape.failure_requested;
        return;
    }

    state emission_internal() {
        self.status = OmegaScalarCompilationStatus::InternalFailure;
        self.outcome_tag = 3;
        self.outcome_space = 3;
        self.outcome_code = 1;
        self.outcome_coordinate = 0;
        self.outcome_limit = 0;
        self.outcome_requested = 0;
    }

    state complete() { self.status = OmegaScalarCompilationStatus::Complete; }

    // Source-anchored refusals report space 4; space 0 marks a refusal with
    // no single source anchor, such as a missing selected entry. The code is
    // the contract's assigned Reject code, or -1 for a syntax or checking
    // refusal whose inventory is still unassigned.
    state reject(code: i32, space: i32, coordinate: i32) {
        self.record_reject(code, space, coordinate);
    }

    // Unsupported valid Omega is an Incomplete coverage refusal until the
    // request contract assigns its provision codes.
    state incomplete(space: i32, coordinate: i32) {
        self.record_incomplete(space, coordinate);
    }

    // Parser exhaustion already carries its assigned wire fields.
    state resource() {
        self.status = OmegaScalarCompilationStatus::ResourceFailure;
        self.outcome_tag = 2;
        self.outcome_space = 4;
        self.outcome_code = omega_parser_resource_code(self.parser.resource);
        self.outcome_coordinate = self.parser.diagnostic_start;
        self.outcome_limit = self.parser.resource_limit;
        self.outcome_requested = self.parser.resource_requested;
    }

    state internal() {
        self.record_internal();
    }
}

// Resolve named records independently of their physical layout. Reference
// cycles do not require recursive layout, but stored references remain outside
// this first aggregate profile because their lifetime/cleanup ledger is absent.
machine OmegaScalarCompiler::resolve_data(
    &mut self, source: &[u8], start: i32, end: i32
) -> i32 {
    return self.resolve_declaration(source, start, end, OmegaDeclarationKind::Data);
}

machine OmegaScalarCompiler::scalar_type(
    &mut self, source: &[u8], type_index: i32
) -> i32 {
    let primitive: i32 = self.primitive_type(source, type_index);
    transition primitive > 0 {
        true -> return primitive
        _ -> compound(self.parser.type_references[type_index])
    }
    state compound(row: OmegaTypeReferenceSyntax) {
        transition row.kind {
            OmegaTypeReferenceKind::Named -> record(row)
            OmegaTypeReferenceKind::Unit -> return 2
            OmegaTypeReferenceKind::Reference -> reference(row)
            OmegaTypeReferenceKind::FixedArray -> return 200000 + type_index
            OmegaTypeReferenceKind::Constrained -> qualified(row)
            _ -> return 0
        }
    }
    state record(row: OmegaTypeReferenceSyntax) {
        let index: i32 = self.resolve_data(source, row.payload0, row.payload1);
        transition index >= 0 {
            true -> return 100000 + index
            _ -> return 0
        }
    }
    state reference(row: OmegaTypeReferenceSyntax) {
        transition (row.payload2 == 0) && (row.payload1 < 2) {
            true -> referent(row, self.parser.type_references[row.payload0])
            _ -> return 0
        }
    }
    state referent(row: OmegaTypeReferenceSyntax, target: OmegaTypeReferenceSyntax) {
        transition target.kind {
            OmegaTypeReferenceKind::Named -> reference_name(row, target)
            _ -> return 0
        }
    }
    state reference_name(row: OmegaTypeReferenceSyntax, target: OmegaTypeReferenceSyntax) {
        let index: i32 = self.resolve_data(source, target.payload0, target.payload1);
        transition index >= 0 {
            true -> return 400000 + row.payload1 * 100000 + index
            _ -> return 0
        }
    }
    state qualified(row: OmegaTypeReferenceSyntax) {
        transition row.payload2 == 1 {
            true -> constraint(row, self.parser.type_constraints[row.payload1])
            _ -> return 0
        }
    }
    state constraint(row: OmegaTypeReferenceSyntax, item: OmegaTypeConstraintSyntax) {
        transition item.path_member_count == 1 {
            true -> domain(row, self.parser.members[item.first_path_member])
            _ -> return 0
        }
    }
    state domain(row: OmegaTypeReferenceSyntax, name: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, "Trapping") {
            1 -> array_base(row)
            _ -> return 0
        }
    }
    state array_base(row: OmegaTypeReferenceSyntax) {
        transition self.parser.type_references[row.payload0].kind {
            OmegaTypeReferenceKind::FixedArray -> return 300000 + row.payload0
            _ -> return 0
        }
    }
}

// This private target layout gives every scalar one word. Fixed arrays use
// that element stride; their declared element count and qualification remain
// semantic properties. No native ABI, size query or external representation is
// admitted by the diagnostic executable adapter.
machine OmegaScalarCompiler::type_size_inner(&mut self, source: &[u8], kind: i32) -> i32 {
    transition kind {
        1 -> return 8
        2 -> return 8
        8 -> return 8
        32 -> return 8
        64 -> return 8
        288 -> return 8
        320 -> return 8
        _ -> compound()
    }
    state compound() {
        transition (kind >= 100000) && (kind < 104096) {
            true -> record(kind - 100000)
            _ -> array()
        }
    }
    state record(index: i32) {
        transition self.layout_data(source, index) {
            1 -> return self.data_sizes[index]
            _ -> return 0
        }
    }
    state array() {
        transition (kind >= 200000) && (kind < 216384) {
            true -> array_row(self.parser.type_references[kind - 200000])
            _ -> qualified_array()
        }
    }
    state qualified_array() {
        transition (kind >= 300000) && (kind < 316384) {
            true -> array_row(self.parser.type_references[kind - 300000])
            _ -> reference()
        }
    }
    state reference() {
        transition ((kind >= 400000) && (kind < 404096)) ||
            ((kind >= 500000) && (kind < 504096)) {
            true -> return 8
            _ -> return 0
        }
    }
    state array_row(row: OmegaTypeReferenceSyntax) {
        self.scan_scalar_literal(source, row.payload1, row.payload2, 32);
        transition (self.literal_status == 1) && (self.literal_value >= 0) {
            true -> element(row, self.literal_value)
            _ -> return 0
        }
    }
    state element(row: OmegaTypeReferenceSyntax, count: i32) {
        let element_kind: i32 = self.scalar_type(source, row.payload0);
        transition (element_kind > 0) && (element_kind < 400000) && (element_kind != 2) {
            true -> extent(count, self.type_size(source, element_kind))
            _ -> return 0
        }
    }
    state extent(count: i32, stride: i32) {
        transition stride > 0 {
            true -> bounded(count, stride)
            _ -> return 0
        }
    }
    state bounded(count: i32, stride: i32) {
        transition (count > 0) && (count <= 16777216 / stride) {
            true -> return count * stride
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::type_copy(&mut self, source: &[u8], kind: i32) -> i32 {
    transition kind {
        1 -> return 1
        2 -> return 1
        8 -> return 1
        32 -> return 1
        64 -> return 1
        288 -> return 1
        320 -> return 1
        _ -> compound()
    }
    state compound() {
        transition (kind >= 100000) && (kind < 104096) {
            true -> return self.data_copy[kind - 100000]
            _ -> array()
        }
    }
    state array() {
        transition (kind >= 200000) && (kind < 216384) {
            true -> element(self.parser.type_references[kind - 200000].payload0)
            _ -> qualified_array()
        }
    }
    state qualified_array() {
        transition (kind >= 300000) && (kind < 316384) {
            true -> element(self.parser.type_references[kind - 300000].payload0)
            _ -> return 0
        }
    }
    state element(index: i32) {
        return self.type_copy(source, self.scalar_type(source, index));
    }
}

machine OmegaScalarCompiler::resolve_field(
    &mut self, source: &[u8], owner: i32, start: i32, end: i32
) -> i32 {
    transition true { true -> next(0) }
    state next(offset: i32) {
        transition offset < self.parser.data_items[owner].field_count {
            true -> name(offset, self.parser.data_items[owner].first_field + offset)
            _ -> return -1
        }
    }
    state name(offset: i32, slot: i32) {
        let name: OmegaRelativeSpan = self.parser.data_fields[slot].name;
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return slot
            _ -> next(offset + 1)
        }
    }
}

// A bounded hash-chain census serves both duplicate checking and lookup.
// Collision checks retain full spelling and declaration scope; hashes never
// establish identity. Bucket arithmetic is at most 34014 before reduction.
machine OmegaScalarCompiler::case_name_bucket(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    transition true { true -> byte(start, 0) }
    state byte(cursor: i32, hash: i32) {
        transition cursor < end {
            true -> byte(cursor + 1, (hash * 33 + source[cursor]) % 1024)
            _ -> return hash
        }
    }
}

machine OmegaScalarCompiler::resolve_case(&mut self, source: &[u8], declaration: i32, start: i32, end: i32) -> i32 {
    let bucket: i32 = self.case_name_bucket(source, start, end);
    transition true { true -> link(self.case_name_heads[bucket]) }
    state link(value: i32) {
        transition value > 0 {
            true -> scope(value - 1)
            _ -> return -1
        }
    }
    state scope(slot: i32) {
        let owner: OmegaDataSyntax = self.parser.data_items[declaration];
        transition (slot >= owner.first_case) && (slot < owner.first_case + owner.case_count) {
            true -> name(slot, self.parser.data_cases[slot].name)
            _ -> link(self.case_name_next[slot])
        }
    }
    state name(slot: i32, name: OmegaRelativeSpan) {
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return slot
            _ -> link(self.case_name_next[slot])
        }
    }
}

// Only a complete carrier-qualified nullary case is a value in this slice.
// Expected type never supplies a missing owner or changes nominal identity.
machine OmegaScalarCompiler::case_value_type(&mut self, source: &[u8], row: OmegaExpressionSyntax) -> i32 {
    transition (row.payload1 == 2) && (row.payload2 == 0) && (row.payload3 == 2) {
        true -> owner(self.parser.members[row.payload0])
        _ -> return -1
    }
    state owner(name: OmegaRelativeSpan) {
        let declaration: i32 = self.resolve_data(source, name.start, name.end);
        transition declaration >= 0 {
            true -> sum(declaration)
            _ -> return -1
        }
    }
    state sum(declaration: i32) {
        transition self.parser.data_items[declaration].case_count > 0 {
            true -> member(declaration, self.parser.members[row.payload0 + 1])
            _ -> return -1
        }
    }
    state member(declaration: i32, name: OmegaRelativeSpan) {
        transition self.resolve_case(source, declaration, name.start, name.end) >= 0 {
            true -> return 100000 + declaration
            _ -> missing(name.start)
        }
    }
    state missing(coordinate: i32) { self.record_reject(-1, 4, coordinate); return -1; }
}

machine OmegaScalarCompiler::check_case_value(&mut self, source: &[u8], expression: i32, expected: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    let kind: i32 = self.case_value_type(source, row);
    transition kind > 0 {
        true -> identity(row, kind)
        _ -> unsupported()
    }
    state identity(row: OmegaExpressionSyntax, kind: i32) {
        transition kind == expected {
            true -> member(kind - 100000, self.parser.members[row.payload0 + 1])
            _ -> rejected()
        }
    }
    state member(declaration: i32, name: OmegaRelativeSpan) {
        let slot: i32 = self.resolve_case(source, declaration, name.start, name.end);
        self.value_kinds[expression] = OmegaCheckedValueKind::NullaryCase;
        self.value_payloads[expression] = slot - self.parser.data_items[declaration].first_case;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

// Nullary sums use the same copy-backed value boundaries as records. The
// emitter stores the selected ordinal and returns its established backing.
machine OmegaScalarCompiler::emit_case_value(&mut self, expression: i32) -> i32 {
    let address: i32 = 33554432 + self.cell_offsets[49152 + expression];
    transition (self.tape.emit_imm(0, self.value_payloads[expression], 0) == 1) &&
        (self.tape.emit_imm(1, address, 0) == 1) &&
        (self.tape.emit_rr(11, 1, 0) == 1) &&
        (self.tape.emit_imm(0, address, 0) == 1) {
        true -> return 1
        _ -> return 0
    }
}

// A bounded layout DFS rejects by-value cycles and unsupported contained
// authority before any storage is allocated or emitted. Each admitted default
// predicate is also proved for zero, so zero storage establishes these values.
machine OmegaScalarCompiler::layout_data(&mut self, source: &[u8], index: i32) -> i32 {
    transition self.data_colors[index] {
        2 -> return 1
        1 -> unsupported()
        _ -> shape()
    }
    state shape() {
        transition self.parser.data_items[index].case_count > 0 {
            true -> sum_shape()
            _ -> record_depth()
        }
    }
    state record_depth() {
        transition self.layout_depth < 64 {
            true -> begin()
            _ -> unsupported()
        }
    }
    state sum_shape() {
        // Ratified Omega data is a record or a sum; mixed bodies are invalid.
        transition self.parser.data_items[index].field_count == 0 {
            true -> sum_requirements()
            _ -> invalid_sum()
        }
    }
    state invalid_sum() {
        self.record_reject(-1, 4, self.parser.data_items[index].start);
        return 0;
    }
    state sum_requirements() {
        transition self.parser.data_items[index].requirement_count == 0 {
            true -> sum_copy()
            _ -> unsupported()
        }
    }
    state sum_copy() {
        transition self.parser.data_items[index].multiplicity {
            OmegaDataMultiplicity::Unrestricted -> sum_case(0)
            _ -> unsupported()
        }
    }
    state sum_case(offset: i32) {
        transition offset < self.parser.data_items[index].case_count {
            true -> sum_payload(offset, self.parser.data_items[index].first_case + offset)
            _ -> sum_finish()
        }
    }
    state sum_payload(offset: i32, slot: i32) {
        transition self.parser.data_cases[slot].payload_field_count == 0 {
            true -> sum_name(offset, slot, self.parser.data_cases[slot].name)
            _ -> unsupported()
        }
    }
    state sum_name(offset: i32, slot: i32, name: OmegaRelativeSpan) {
        transition self.resolve_case(source, index, name.start, name.end) < 0 {
            true -> sum_retain(offset, slot, self.case_name_bucket(source, name.start, name.end))
            _ -> duplicate(name.start)
        }
    }
    state sum_retain(offset: i32, slot: i32, bucket: i32) {
        self.case_name_next[slot] = self.case_name_heads[bucket];
        self.case_name_heads[bucket] = slot + 1;
        self.case_name_buckets[self.case_name_count] = bucket;
        self.case_name_count = self.case_name_count + 1;
        transition true { true -> sum_case(offset + 1) }
    }
    state sum_finish() {
        // Zero names the first declared case. Nominal identity remains the
        // declaration ID; this private word never becomes a source integer.
        self.data_sizes[index] = 8;
        self.data_copy[index] = 1;
        self.data_colors[index] = 2;
        return 1;
    }
    state begin() {
        self.data_colors[index] = 1;
        self.data_copy[index] = 0;
        self.layout_depth = self.layout_depth + 1;
        transition true { true -> field(0, 0) }
    }
    state field(offset: i32, size: i32) {
        transition offset < self.parser.data_items[index].field_count {
            true -> field_type(offset, size, self.parser.data_items[index].first_field + offset)
            _ -> requirements(0, size)
        }
    }
    state field_type(offset: i32, size: i32, slot: i32) {
        let kind: i32 = self.scalar_type(source, self.parser.data_fields[slot].type_reference);
        self.field_types[slot] = kind;
        self.field_offsets[slot] = size;
        self.field_upper_bounds[slot] = -1;
        transition (kind > 0) && (kind != 2) && (kind < 400000) {
            true -> field_size(offset, size, slot, self.type_size(source, kind))
            _ -> unsupported()
        }
    }
    state field_size(offset: i32, size: i32, slot: i32, extent: i32) {
        transition (extent > 0) && (extent <= 16777216 - size) {
            true -> field_name(offset, size, slot, extent)
            _ -> unsupported()
        }
    }
    state field_name(offset: i32, size: i32, slot: i32, extent: i32) {
        self.field_extents[slot] = extent;
        let name: OmegaRelativeSpan = self.parser.data_fields[slot].name;
        transition self.resolve_field(source, index, name.start, name.end) == slot {
            true -> multiplicity(offset, size, slot, extent)
            _ -> duplicate(name.start)
        }
    }
    state multiplicity(offset: i32, size: i32, slot: i32, extent: i32) {
        transition self.parser.data_items[index].multiplicity {
            OmegaDataMultiplicity::Unrestricted -> copy_field(offset, size, slot, extent)
            _ -> field(offset + 1, size + extent)
        }
    }
    state copy_field(offset: i32, size: i32, slot: i32, extent: i32) {
        transition self.type_copy(source, self.field_types[slot]) {
            1 -> field(offset + 1, size + extent)
            _ -> unsupported()
        }
    }
    state requirements(offset: i32, size: i32) {
        transition offset < self.parser.data_items[index].requirement_count {
            true -> requirement(offset, size, self.parser.requirements[
                self.parser.data_items[index].first_requirement + offset].expression)
            _ -> finish(size)
        }
    }
    state requirement(offset: i32, size: i32, expression: i32) {
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Binary -> predicate(offset, size,
                self.parser.binary_expressions[self.parser.expressions[expression].payload0])
            _ -> unsupported()
        }
    }
    state predicate(offset: i32, size: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::LessEqual -> operands(offset, size,
                self.parser.expressions[row.left], self.parser.expressions[row.right])
            _ -> unsupported()
        }
    }
    state operands(offset: i32, size: i32, left: OmegaExpressionSyntax, right: OmegaExpressionSyntax) {
        transition left.kind {
            OmegaExpressionKind::Path -> left_path(offset, size, left, right)
            _ -> unsupported()
        }
    }
    state left_path(offset: i32, size: i32, left: OmegaExpressionSyntax, right: OmegaExpressionSyntax) {
        transition (left.payload1 == 1) && (left.payload2 == 0) {
            true -> field_bound(offset, size, self.parser.members[left.payload0], right)
            _ -> unsupported()
        }
    }
    state field_bound(offset: i32, size: i32, name: OmegaRelativeSpan, right: OmegaExpressionSyntax) {
        let field: i32 = self.resolve_field(source, index, name.start, name.end);
        transition field >= 0 {
            true -> bound_type(offset, size, field, right)
            _ -> unsupported()
        }
    }
    state bound_type(offset: i32, size: i32, field: i32, right: OmegaExpressionSyntax) {
        let kind: i32 = self.field_types[field];
        transition (kind == 8) || (kind == 32) || (kind == 64) {
            true -> bound_literal(offset, size, field, right)
            _ -> unsupported()
        }
    }
    state bound_literal(offset: i32, size: i32, field: i32, right: OmegaExpressionSyntax) {
        transition right.kind {
            OmegaExpressionKind::Integer -> scan_bound(offset, size, field, right)
            _ -> unsupported()
        }
    }
    state scan_bound(offset: i32, size: i32, field: i32, right: OmegaExpressionSyntax) {
        self.scan_scalar_literal(source, right.payload0, right.payload1, self.field_types[field]);
        transition (self.literal_status == 1) && (self.literal_value >= 0) {
            true -> retain_bound(offset, size, field, self.literal_value)
            _ -> unsupported()
        }
    }
    state retain_bound(offset: i32, size: i32, field: i32, bound: i32) {
        transition (self.field_upper_bounds[field] < 0) || (bound < self.field_upper_bounds[field]) {
            true -> replace_bound(offset, size, field, bound)
            _ -> requirements(offset + 1, size)
        }
    }
    state replace_bound(offset: i32, size: i32, field: i32, bound: i32) {
        self.field_upper_bounds[field] = bound;
        transition true { true -> requirements(offset + 1, size) }
    }
    state finish(size: i32) {
        transition size > 0 {
            true -> sized(size)
            _ -> sized(8)
        }
    }
    state sized(size: i32) {
        self.data_sizes[index] = size;
        self.data_colors[index] = 2;
        self.layout_depth = self.layout_depth - 1;
        transition self.parser.data_items[index].multiplicity {
            OmegaDataMultiplicity::Unrestricted -> copy()
            _ -> return 1
        }
    }
    state copy() { self.data_copy[index] = 1; return 1; }
    state unsupported() { self.record_incomplete(4, self.parser.data_items[index].start); return 0; }
    state duplicate(coordinate: i32) { self.record_reject(10, 4, coordinate); return 0; }
}

machine OmegaScalarCompiler::require_cell(
    &mut self, source: &[u8], cell: i32, kind: i32
) -> i32 {
    transition self.cell_sizes[cell] > 0 {
        true -> return 1
        _ -> extent(self.type_size(source, kind))
    }
    state extent(size: i32) {
        transition (size > 0) && (size <= 16777216 - self.storage_size) {
            true -> retain(size)
            _ -> unsupported()
        }
    }
    state retain(size: i32) {
        self.cell_ids[self.cell_count] = cell;
        self.cell_count = self.cell_count + 1;
        self.cell_types[cell] = kind;
        self.cell_sizes[cell] = size;
        self.cell_offsets[cell] = self.storage_size;
        self.storage_size = self.storage_size + size;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// Resolve a structural place without reading it. The root identifies one
// binding; each projection retains its declared field and offset. This never
// manufactures an address from source integers or erases a field qualification.
machine OmegaScalarCompiler::check_place(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Path -> path(row)
        OmegaExpressionKind::Indexed -> return self.check_byte_index(source, state_index, before, expression, 1)
        _ -> unsupported()
    }
    state path(row: OmegaExpressionSyntax) {
        transition (row.payload1 > 0) && (row.payload2 == 0) && (row.payload3 <= 1) {
            true -> root(row, self.parser.members[row.payload0])
            _ -> unsupported()
        }
    }
    state root(row: OmegaExpressionSyntax, name: OmegaRelativeSpan) {
        let cell: i32 = self.value_cell(source, state_index, before, name.start, name.end);
        transition cell >= 0 {
            true -> binding(row, cell)
            _ -> missing(name.start)
        }
    }
    state binding(row: OmegaExpressionSyntax, cell: i32) {
        self.place_roots[expression] = cell;
        self.place_offsets[expression] = 0;
        self.place_indirect[expression] = 0;
        self.place_writable[expression] = 0;
        self.place_fields[expression] = -1;
        transition cell < 16384 {
            true -> type(row, self.parameter_types[cell])
            _ -> local(row, self.parser.local_data_statements[cell - 16384])
        }
    }
    state local(row: OmegaExpressionSyntax, local: OmegaLocalDataStatementSyntax) {
        self.place_writable[expression] = local.is_mutable;
        transition true { true -> type(row, self.scalar_type(source, local.type_reference)) }
    }
    state type(row: OmegaExpressionSyntax, kind: i32) {
        transition (kind >= 400000) && (kind < 404096) {
            true -> referent(row, kind - 400000, 0)
            _ -> mutable_reference(row, kind)
        }
    }
    state mutable_reference(row: OmegaExpressionSyntax, kind: i32) {
        transition (kind >= 500000) && (kind < 504096) {
            true -> referent(row, kind - 500000, 1)
            _ -> members(row, 1, kind)
        }
    }
    state referent(row: OmegaExpressionSyntax, declaration: i32, writable: i32) {
        transition row.payload1 > 1 {
            true -> referenced_fields(row, declaration, writable)
            _ -> unsupported()
        }
    }
    state referenced_fields(row: OmegaExpressionSyntax, declaration: i32, writable: i32) {
        self.place_indirect[expression] = 1;
        self.place_writable[expression] = writable;
        transition true { true -> members(row, 1, 100000 + declaration) }
    }
    state members(row: OmegaExpressionSyntax, offset: i32, kind: i32) {
        transition offset < row.payload1 {
            true -> record(row, offset, kind)
            _ -> retain(kind)
        }
    }
    state record(row: OmegaExpressionSyntax, offset: i32, kind: i32) {
        transition (kind >= 100000) && (kind < 104096) {
            true -> member(row, offset, kind - 100000, self.parser.members[row.payload0 + offset])
            _ -> unsupported()
        }
    }
    state member(row: OmegaExpressionSyntax, offset: i32, declaration: i32, name: OmegaRelativeSpan) {
        let field: i32 = self.resolve_field(source, declaration, name.start, name.end);
        transition field >= 0 {
            true -> project(row, offset, field)
            _ -> missing(name.start)
        }
    }
    state project(row: OmegaExpressionSyntax, offset: i32, field: i32) {
        self.place_offsets[expression] = self.place_offsets[expression] + self.field_offsets[field];
        self.place_fields[expression] = field;
        transition true { true -> members(row, offset + 1, self.field_types[field]) }
    }
    state retain(kind: i32) {
        self.place_types[expression] = kind;
        self.place_extent[expression] = self.type_size(source, kind);
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state missing(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Each live call-argument loan freezes its exact backing range while later
// arguments evaluate. One reference parameter alone would not prevent an
// overlapping by-value read in a later argument.
machine OmegaScalarCompiler::place_available(
    &mut self, source: &[u8], expression: i32, access: i32
) -> i32 {
    transition true { true -> next(0, self.place_extent[expression]) }
    state next(index: i32, size: i32) {
        transition index < self.loan_count {
            true -> root(index, size)
            _ -> return 1
        }
    }
    state root(index: i32, size: i32) {
        transition (self.loan_roots[index] == self.place_roots[expression]) &&
            ((access == 1) || (self.loan_access[index] == 1)) {
            true -> overlap(index, size)
            _ -> next(index + 1, size)
        }
    }
    state overlap(index: i32, size: i32) {
        transition (self.loan_offsets[index] < self.place_offsets[expression] + size) &&
            (self.place_offsets[expression] < self.loan_offsets[index] + self.loan_sizes[index]) {
            true -> refused(index)
            _ -> next(index + 1, size)
        }
    }
    state refused(index: i32) {
        transition self.loan_context[index] {
            1 -> reborrow_unsupported()
            _ -> rejected()
        }
    }
    state reborrow_unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::check_place_value(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32, expected: i32
) -> i32 {
    transition self.check_place(source, state_index, before, expression) {
        1 -> type()
        _ -> return 0
    }
    state type() {
        transition self.place_types[expression] == expected {
            true -> copy()
            _ -> array_identity()
        }
    }
    // Array layout custody uses the authored type row. Separate spellings can
    // denote the same structural type; decline until their equivalence is
    // checked instead of rejecting valid array-to-array value transport.
    state array_identity() {
        transition (expected >= 200000) && (expected < 400000) &&
            (self.place_types[expression] >= 200000) && (self.place_types[expression] < 400000) {
            true -> unsupported()
            _ -> implicit_shared()
        }
    }
    // Ordinary call admission may lend an owned record implicitly to a
    // shared parameter. This explicit-borrow profile declines that valid
    // route; it must not classify it as a mismatched Omega value.
    state implicit_shared() {
        transition (expected >= 400000) && (expected < 404096) &&
            (self.place_types[expression] == expected - 300000) {
            true -> unsupported()
            _ -> rejected()
        }
    }
    state copy() {
        transition self.type_copy(source, expected) {
            1 -> available()
            _ -> unsupported()
        }
    }
    state available() {
        transition self.place_available(source, expression, 0) {
            1 -> retain()
            _ -> return 0
        }
    }
    state retain() { self.value_kinds[expression] = OmegaCheckedValueKind::Place; return 1; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::check_borrow(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32, expected: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition ((expected >= 400000) && (expected < 404096) && (row.payload1 == 0)) ||
        ((expected >= 500000) && (expected < 504096) && (row.payload1 == 1)) {
        true -> place(row)
        _ -> unsupported(row)
    }
    state place(row: OmegaExpressionSyntax) {
        transition self.check_place(source, state_index, before, row.payload0) {
            1 -> type(row)
            _ -> return 0
        }
    }
    state type(row: OmegaExpressionSyntax) {
        transition self.place_types[row.payload0] == 100000 + expected % 100000 {
            true -> access(row)
            _ -> rejected(row)
        }
    }
    state access(row: OmegaExpressionSyntax) {
        transition (row.payload1 == 0) || (self.place_writable[row.payload0] == 1) {
            true -> available(row)
            _ -> rejected(row)
        }
    }
    state available(row: OmegaExpressionSyntax) {
        transition self.place_available(source, row.payload0, row.payload1) {
            1 -> loan(row)
            _ -> return 0
        }
    }
    state loan(row: OmegaExpressionSyntax) {
        transition self.loan_count < 16384 {
            true -> retain(row)
            _ -> unsupported(row)
        }
    }
    state retain(row: OmegaExpressionSyntax) {
        self.loan_access[self.loan_count] = row.payload1;
        self.loan_context[self.loan_count] = 0;
        self.loan_roots[self.loan_count] = self.place_roots[row.payload0];
        self.loan_offsets[self.loan_count] = self.place_offsets[row.payload0];
        self.loan_sizes[self.loan_count] = self.type_size(source, self.place_types[row.payload0]);
        self.loan_count = self.loan_count + 1;
        self.value_kinds[expression] = OmegaCheckedValueKind::Borrow;
        self.value_payloads[expression] = row.payload0;
        return 1;
    }
    state rejected(row: OmegaExpressionSyntax) { self.record_reject(-1, 4, row.payload2); return 0; }
    state unsupported(row: OmegaExpressionSyntax) { self.record_incomplete(4, row.payload2); return 0; }
}

// The first predicate solver discharges only a literal upper bound or a read
// of a field with an equal/stronger declared bound. No mutable flow snapshot is
// retained across a call; all admitted writes preserve these declared facts.
machine OmegaScalarCompiler::check_field_bound(
    &mut self, source: &[u8], field: i32, expression: i32
) -> i32 {
    transition (self.field_upper_bounds[field] < 0) ||
        (self.prove_upper(source, self.value_states[expression], self.value_befores[expression],
            expression, self.field_upper_bounds[field], -1, 0) == 1) {
        true -> return 1
        _ -> unsupported()
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::check_record_literal(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    expression: i32, expected: i32
) -> i32 {
    let row: OmegaStructLiteralSyntax = self.parser.struct_literals[self.parser.expressions[expression].payload0];
    transition (expected >= 100000) && (expected < 104096) && (row.type_member_count > 0) &&
        (self.type_copy(source, expected) == 1) {
        true -> record_shape(row)
        _ -> unsupported()
    }
    state record_shape(row: OmegaStructLiteralSyntax) {
        transition self.parser.data_items[expected - 100000].case_count == 0 {
            true -> name(row, self.parser.members[row.first_type_member])
            _ -> rejected(row.start)
        }
    }
    state name(row: OmegaStructLiteralSyntax, name: OmegaRelativeSpan) {
        transition self.resolve_data(source, name.start,
            self.parser.members[row.first_type_member + row.type_member_count - 1].end) == expected - 100000 {
            true -> count(row)
            _ -> rejected(name.start)
        }
    }
    state count(row: OmegaStructLiteralSyntax) {
        transition row.field_count == self.parser.data_items[expected - 100000].field_count {
            true -> fields(row, 0)
            _ -> rejected(row.start)
        }
    }
    state fields(row: OmegaStructLiteralSyntax, offset: i32) {
        transition offset < row.field_count {
            true -> field(row, offset, self.parser.struct_literal_fields[row.first_field + offset])
            _ -> retain()
        }
    }
    state field(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax) {
        let slot: i32 = self.resolve_field(source, expected - 100000, field.name.start, field.name.end);
        transition slot >= 0 {
            true -> unique(row, offset, field, slot, 0)
            _ -> rejected(field.name.start)
        }
    }
    state unique(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax,
        slot: i32, previous: i32) {
        transition previous < offset {
            true -> compare(row, offset, field, slot, previous,
                self.parser.struct_literal_fields[row.first_field + previous].name)
            _ -> value(row, offset, field, slot)
        }
    }
    state compare(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax,
        slot: i32, previous: i32, other: OmegaRelativeSpan) {
        transition self.span_equals(source, field.name.start, field.name.end, source[other.start..other.end]) {
            1 -> rejected(field.name.start)
            _ -> unique(row, offset, field, slot, previous + 1)
        }
    }
    state value(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax, slot: i32) {
        transition self.check_value(source, owner, state_index, before, field.value, self.field_types[slot]) {
            1 -> bound(row, offset, field, slot)
            _ -> return 0
        }
    }
    state bound(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax, slot: i32) {
        transition self.check_field_bound(source, slot, field.value) {
            1 -> retained_field(row, offset, slot)
            _ -> return 0
        }
    }
    state retained_field(row: OmegaStructLiteralSyntax, offset: i32, slot: i32) {
        self.struct_field_slots[row.first_field + offset] = slot;
        transition true { true -> fields(row, offset + 1) }
    }
    state retain() { self.value_kinds[expression] = OmegaCheckedValueKind::RecordLiteral; return 1; }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// Copy one checked value: r0 is its scalar word or aggregate source address;
// r1 is the already captured destination. No source expression is reevaluated.
machine OmegaScalarCompiler::emit_store_at(&mut self, kind: i32, size: i32) -> i32 {
    transition (kind >= 100000) && (kind < 400000) {
        true -> return self.emit_copy_words(size)
        _ -> return self.tape.emit_rr(11, 1, 0)
    }
}

machine OmegaScalarCompiler::emit_copy_words(&mut self, size: i32) -> i32 {
    self.emission_resource = 14;
    let loop: i32 = self.tape.new_label();
    transition loop >= 0 {
        true -> emit(loop)
        _ -> return 0
    }
    state emit(loop: i32) {
        self.emission_resource = 12;
        transition (self.tape.emit_rr(2, 3, 0) == 1) &&
            (self.tape.emit_rr(2, 4, 1) == 1) &&
            (self.tape.emit_imm(5, size, 0) == 1) &&
            (self.tape.emit_imm(6, 8, 0) == 1) &&
            (self.tape.define_label(loop) == 1) &&
            (self.tape.emit_rr(10, 7, 3) == 1) &&
            (self.tape.emit_rr(11, 4, 7) == 1) &&
            (self.tape.emit_rr(3, 3, 6) == 1) &&
            (self.tape.emit_rr(3, 4, 6) == 1) &&
            (self.tape.emit_rr(4, 5, 6) == 1) &&
            (self.tape.emit_rx_label(14, 5, loop) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_zero_cell(&mut self, cell: i32) -> i32 {
    self.emission_resource = 14;
    let loop: i32 = self.tape.new_label();
    transition loop >= 0 {
        true -> emit(loop)
        _ -> return 0
    }
    state emit(loop: i32) {
        self.emission_resource = 12;
        transition (self.tape.emit_imm(0, 0, 0) == 1) &&
            (self.tape.emit_imm(1, 33554432 + self.cell_offsets[cell], 0) == 1) &&
            (self.tape.emit_imm(5, self.cell_sizes[cell], 0) == 1) &&
            (self.tape.emit_imm(6, 8, 0) == 1) &&
            (self.tape.define_label(loop) == 1) &&
            (self.tape.emit_rr(11, 1, 0) == 1) &&
            (self.tape.emit_rr(3, 1, 6) == 1) &&
            (self.tape.emit_rr(4, 5, 6) == 1) &&
            (self.tape.emit_rx_label(14, 5, loop) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_place_address(&mut self, expression: i32) -> i32 {
    transition self.parser.expressions[expression].kind {
        OmegaExpressionKind::Indexed -> return self.emit_index_address(expression)
        _ -> address()
    }
    state address() {
        transition self.tape.emit_imm(0,
            33554432 + self.cell_offsets[self.place_roots[expression]], 0) {
            1 -> root()
            _ -> return 0
        }
    }
    state root() {
        transition self.place_indirect[expression] {
            1 -> indirect()
            _ -> offset()
        }
    }
    state indirect() {
        transition self.tape.emit_rr(10, 0, 0) {
            1 -> offset()
            _ -> return 0
        }
    }
    state offset() {
        transition (self.tape.emit_imm(1, self.place_offsets[expression], 0) == 1) &&
            (self.tape.emit_rr(3, 0, 1) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_place_value(&mut self, expression: i32) -> i32 {
    transition self.emit_place_address(expression) {
        1 -> value()
        _ -> return 0
    }
    state value() {
        transition (self.place_types[expression] >= 100000) && (self.place_types[expression] < 400000) {
            true -> return 1
            _ -> return self.tape.emit_rr(10, 0, 0)
        }
    }
}

machine OmegaScalarCompiler::emit_record_literal(&mut self, expression: i32) -> i32 {
    let row: OmegaStructLiteralSyntax = self.parser.struct_literals[self.parser.expressions[expression].payload0];
    transition true { true -> field(row, 0) }
    state field(row: OmegaStructLiteralSyntax, offset: i32) {
        transition offset < row.field_count {
            true -> value(row, offset, row.first_field + offset)
            _ -> return self.tape.emit_imm(0, 33554432 + self.cell_offsets[49152 + expression], 0)
        }
    }
    state value(row: OmegaStructLiteralSyntax, offset: i32, slot: i32) {
        transition self.emit_value(self.parser.struct_literal_fields[slot].value) {
            1 -> store(row, offset, self.struct_field_slots[slot])
            _ -> return 0
        }
    }
    state store(row: OmegaStructLiteralSyntax, offset: i32, field: i32) {
        transition (self.tape.emit_imm(1, 33554432 + self.cell_offsets[49152 + expression] +
            self.field_offsets[field], 0) == 1) &&
            (self.emit_store_at(self.field_types[field], self.field_extents[field]) == 1) {
            true -> field(row, offset + 1)
            _ -> return 0
        }
    }
}

// Bound the whole type/layout traversal, including nested arrays, rather than
// bounding record depth alone while recursively unwrapping unlimited arrays.
machine OmegaScalarCompiler::type_size(&mut self, source: &[u8], kind: i32) -> i32 {
    transition self.layout_depth < 64 {
        true -> enter()
        _ -> return 0
    }
    state enter() {
        self.layout_depth = self.layout_depth + 1;
        let size: i32 = self.type_size_inner(source, kind);
        self.layout_depth = self.layout_depth - 1;
        return size;
    }
}

// Infer only the byte-index family this compiler can select. This inspects
// collection type without evaluating a selector or acquiring a loan. Other
// indexed results are unknown coverage, never an invented u8 that could cause
// a false operator mismatch before the indexing checker runs.
machine OmegaScalarCompiler::byte_index_result_type(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32
) -> i32 {
    let row: OmegaIndexedExpressionSyntax = self.parser.indexed_expressions[
        self.parser.expressions[expression].payload0];
    transition true { true -> collection(row.base) }
    state collection(base: i32) {
        let value: OmegaExpressionSyntax = self.parser.expressions[base];
        transition value.kind {
            OmegaExpressionKind::Path -> place(base, 0)
            OmegaExpressionKind::Borrow -> place(value.payload0, 0)
            OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[value.payload0])
            _ -> return -1
        }
    }
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::RemoveDomain -> domain(row)
            _ -> return -1
        }
    }
    state domain(row: OmegaCastExpressionSyntax) {
        transition self.span_equals(source, row.domain.start, row.domain.end, "Trapping") {
            1 -> borrowed(self.parser.expressions[row.value])
            _ -> return -1
        }
    }
    state borrowed(row: OmegaExpressionSyntax) {
        transition row.kind {
            OmegaExpressionKind::Borrow -> place(row.payload0, 1)
            _ -> return -1
        }
    }
    state place(base: i32, removed: i32) {
        transition self.parser.expressions[base].kind {
            OmegaExpressionKind::Path -> resolve(base, removed)
            _ -> return -1
        }
    }
    state resolve(base: i32, removed: i32) {
        transition self.check_place(source, state_index, before, base) {
            1 -> array(self.place_types[base], removed)
            _ -> return -1
        }
    }
    state array(kind: i32, removed: i32) {
        transition ((removed == 0) && (kind >= 200000) && (kind < 216384)) ||
            ((removed == 1) && (kind >= 300000) && (kind < 316384)) {
            true -> element(self.parser.type_references[kind % 100000])
            _ -> return -1
        }
    }
    state element(row: OmegaTypeReferenceSyntax) {
        transition self.scalar_type(source, row.payload0) == 8 {
            true -> return 8
            _ -> return -1
        }
    }
}

// Select the sealed fixed-byte-array schema from checked types and access,
// never from a source helper name. Only explicit reference-domain removal
// changes a qualified array into the plain collection admitted by this schema.
machine OmegaScalarCompiler::check_byte_index(
    &mut self, source: &[u8], state_index: i32, before: i32,
    expression: i32, access: i32
) -> i32 {
    // Every payload field is overwritten before the schema is published.
    self.index_plans[expression].schema = 0;
    let row: OmegaIndexedExpressionSyntax = self.parser.indexed_expressions[
        self.parser.expressions[expression].payload0];
    self.index_plans[expression].selector = row.index;
    self.index_plans[expression].owner_state = state_index;
    self.index_plans[expression].before = before;
    self.index_plans[expression].access = access;
    transition self.require_cell(source, 49152 + expression, 8) {
        1 -> collection(row.base)
        _ -> return 0
    }
    state collection(base: i32) {
        let value: OmegaExpressionSyntax = self.parser.expressions[base];
        transition value.kind {
            OmegaExpressionKind::Path -> place(base, 0)
            OmegaExpressionKind::Borrow -> borrowed(value, 0)
            OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[value.payload0])
            _ -> unsupported()
        }
    }
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::RemoveDomain -> removed(row)
            _ -> unsupported()
        }
    }
    state removed(row: OmegaCastExpressionSyntax) {
        transition self.span_equals(source, row.domain.start, row.domain.end, "Trapping") {
            1 -> view(self.parser.expressions[row.value])
            _ -> unsupported()
        }
    }
    state view(value: OmegaExpressionSyntax) {
        transition value.kind {
            OmegaExpressionKind::Borrow -> borrowed(value, 1)
            _ -> unsupported()
        }
    }
    state borrowed(value: OmegaExpressionSyntax, removed: i32) {
        // A shared view cannot yield writable storage. Other attenuation or
        // parent/child reborrow schedules stay outside this initial schema.
        transition value.payload1 == access {
            true -> place(value.payload0, removed)
            _ -> borrowed_access(value)
        }
    }
    state borrowed_access(value: OmegaExpressionSyntax) {
        transition (access == 1) && (value.payload1 == 0) {
            true -> rejected()
            _ -> unsupported()
        }
    }
    state place(base: i32, removed: i32) {
        transition self.parser.expressions[base].kind {
            OmegaExpressionKind::Path -> resolve(base, removed)
            _ -> unsupported()
        }
    }
    state resolve(base: i32, removed: i32) {
        transition self.check_place(source, state_index, before, base) {
            1 -> collection_type(base, removed, self.place_types[base])
            _ -> return 0
        }
    }
    state collection_type(base: i32, removed: i32, kind: i32) {
        transition ((removed == 0) && (kind >= 200000) && (kind < 216384)) ||
            ((removed == 1) && (kind >= 300000) && (kind < 316384)) {
            true -> array(base, removed, kind, self.parser.type_references[kind % 100000])
            _ -> unsupported()
        }
    }
    state array(base: i32, removed: i32, kind: i32, row: OmegaTypeReferenceSyntax) {
        transition self.scalar_type(source, row.payload0) == 8 {
            true -> count(base, removed, kind, row)
            _ -> unsupported()
        }
    }
    state count(base: i32, removed: i32, kind: i32, row: OmegaTypeReferenceSyntax) {
        self.scan_scalar_literal(source, row.payload1, row.payload2, 32);
        transition (self.literal_status == 1) && (self.literal_value > 0) &&
            (self.literal_value <= 2097152) {
            true -> authority(base, removed, kind, self.literal_value)
            _ -> unsupported()
        }
    }
    state authority(base: i32, removed: i32, kind: i32, count: i32) {
        transition (access == 0) || (self.place_writable[base] == 1) {
            true -> available(base, removed, kind, count)
            _ -> rejected()
        }
    }
    state available(base: i32, removed: i32, kind: i32, count: i32) {
        transition self.place_available(source, base, access) {
            1 -> capture(base, removed, kind, count)
            _ -> return 0
        }
    }
    state capture(base: i32, removed: i32, kind: i32, count: i32) {
        self.index_plans[expression].array_type = kind;
        self.index_plans[expression].element_type = 8;
        self.index_plans[expression].extent = count;
        self.index_plans[expression].collection = base;
        self.index_plans[expression].removed_trapping = removed;
        self.index_plans[expression].parent_root = self.place_roots[base];
        self.index_plans[expression].parent_offset = self.place_offsets[base];
        self.index_plans[expression].parent_extent = self.place_extent[base];
        transition true { true -> selector_loan(self.loan_count) }
    }
    state selector_loan(first_loan: i32) {
        transition self.retain_index_loan(expression) {
            1 -> selector(first_loan)
            _ -> return 0
        }
    }
    state selector(first_loan: i32) {
        transition self.check_value(source, self.state_owners[state_index], state_index, before,
            self.index_plans[expression].selector, 64) {
            1 -> selector_bound(first_loan)
            _ -> failed(first_loan)
        }
    }
    state selector_bound(first_loan: i32) {
        transition self.check_index_bound(source, expression, self.index_plans[expression].selector) {
            1 -> retain(first_loan)
            _ -> failed(first_loan)
        }
    }
    state retain(first_loan: i32) {
        self.loan_count = first_loan;
        self.index_plans[expression].schema = access + 1;
        self.place_roots[expression] = self.index_plans[expression].parent_root;
        self.place_offsets[expression] = self.index_plans[expression].parent_offset;
        self.place_extent[expression] = self.index_plans[expression].parent_extent;
        self.place_types[expression] = 8;
        self.place_indirect[expression] = self.place_indirect[self.index_plans[expression].collection];
        self.place_writable[expression] = access;
        self.place_fields[expression] = -1;
        return 1;
    }
    state failed(first_loan: i32) { self.loan_count = first_loan; return 0; }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

// This first bounds realization uses only immutable literal meaning or a
// declared scalar-field predicate preserved by every admitted write. No stale
// flow fact or caller-specific assumption survives a mutation here. Richer
// inferred private requirements remain a separate, explicit coverage boundary.
machine OmegaScalarCompiler::check_index_bound(
    &mut self, source: &[u8], expression: i32, selector: i32
) -> i32 {
    transition self.value_kinds[selector] {
        OmegaCheckedValueKind::Literal -> literal(self.value_payloads[selector])
        OmegaCheckedValueKind::RepresentationCast -> return self.check_index_bound(source, expression, self.value_payloads[selector])
        _ -> contextual()
    }
    state literal(value: i32) {
        transition (value >= 0) && (value < self.index_plans[expression].extent) {
            true -> retain(1, selector, value)
            _ -> rejected()
        }
    }
    state contextual() {
        let plan: OmegaByteIndexPlan = self.index_plans[expression];
        transition self.prove_upper(source, plan.owner_state, plan.before, selector, plan.extent - 1, -1, 0) {
            1 -> retain(3, selector, plan.extent - 1)
            _ -> unsupported()
        }
    }
    state retain(kind: i32, origin: i32, bound: i32) {
        self.index_plans[expression].bound_kind = kind;
        self.index_plans[expression].bound_source = origin;
        self.index_plans[expression].bound_limit = bound;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::retain_index_loan(&mut self, expression: i32) -> i32 {
    transition self.loan_count < 16384 {
        true -> retain()
        _ -> unsupported()
    }
    state retain() {
        let plan: OmegaByteIndexPlan = self.index_plans[expression];
        self.loan_access[self.loan_count] = plan.access;
        self.loan_context[self.loan_count] = 1;
        self.loan_roots[self.loan_count] = plan.parent_root;
        self.loan_offsets[self.loan_count] = plan.parent_offset;
        self.loan_sizes[self.loan_count] = plan.parent_extent;
        self.loan_count = self.loan_count + 1;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// The checked plan captures backing before evaluating its selector. An indexed
// assignment saves this resulting address again before its RHS, so a later
// selector-field mutation cannot redirect the pending store.
machine OmegaScalarCompiler::emit_index_address(&mut self, expression: i32) -> i32 {
    let plan: OmegaByteIndexPlan = self.index_plans[expression];
    transition ((plan.schema == 1) || (plan.schema == 2)) &&
        (plan.element_type == 8) && (plan.extent > 0) &&
        ((plan.bound_kind == 1) || (plan.bound_kind == 2) || (plan.bound_kind == 3)) &&
        (plan.bound_limit >= 0) && (plan.bound_limit < plan.extent) &&
        (plan.parent_root == self.place_roots[plan.collection]) &&
        (plan.parent_offset == self.place_offsets[plan.collection]) &&
        (plan.parent_extent == self.place_extent[plan.collection]) {
        true -> capture(plan)
        _ -> return self.tape.fail_internal(expression)
    }
    state capture(plan: OmegaByteIndexPlan) {
        transition (self.emit_place_address(plan.collection) == 1) &&
            (self.emit_value_store(49152 + expression) == 1) &&
            (self.emit_value(plan.selector) == 1) &&
            (self.tape.emit_rr(2, 2, 0) == 1) &&
            (self.emit_value_load(49152 + expression) == 1) &&
            (self.tape.emit_imm(1, 8, 0) == 1) &&
            (self.tape.emit_rr(5, 2, 1) == 1) &&
            (self.tape.emit_rr(3, 0, 2) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Nested transfers may carry only the enclosing invocation's original reference.
// No nested reference can begin from an owned local whose static cell a later
// transfer reuses. Kinds retain the exact referent declaration and access mode.
machine OmegaScalarCompiler::reference_signature(&mut self, owner: i32, state_index: i32, kind: i32) -> i32 {
    transition (kind < 400000) || (state_index == self.parser.machine_items[owner].first_state) {
        true -> return 1
        _ -> original(self.parser.machine_items[owner].first_state, 0)
    }
    state original(entry: i32, offset: i32) {
        transition offset < self.parser.machine_states[entry].parameter_count {
            true -> parameter(entry, offset, self.parameter_types[self.parser.machine_states[entry].first_parameter + offset])
            _ -> return 0
        }
    }
    state parameter(entry: i32, offset: i32, incoming: i32) {
        transition incoming == kind {
            true -> return 1
            _ -> original(entry, offset + 1)
        }
    }
}

// Ordinary calls and nested transfers forward the incoming loan carrier,
// never its referent. Terminal arguments separately require this original
// incoming-reference form; an explicit borrow of a reused local cannot enter.
// The referent's
// full range stays lent while later arguments evaluate, so a bare forwarding
// spelling cannot evade ordinary argument-order alias checks.
machine OmegaScalarCompiler::check_forward_reference(
    &mut self, source: &[u8], state_index: i32, before: i32,
    expression: i32, expected: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Path -> path(row)
        _ -> unsupported()
    }
    state path(row: OmegaExpressionSyntax) {
        transition (row.payload1 == 1) && (row.payload2 == 0) && (row.payload3 == 1) {
            true -> name(self.parser.members[row.payload0])
            _ -> unsupported()
        }
    }
    state name(name: OmegaRelativeSpan) {
        let slot: i32 = self.value_cell(source, state_index, before, name.start, name.end);
        let entry: OmegaMachineStateSyntax = self.parser.machine_states[state_index];
        transition (slot >= entry.first_parameter) && (slot < entry.first_parameter + entry.parameter_count) {
            true -> type(slot)
            _ -> unsupported()
        }
    }
    state type(slot: i32) {
        transition self.parameter_types[slot] == expected {
            true -> place(slot)
            _ -> unsupported()
        }
    }
    state place(slot: i32) {
        self.place_roots[expression] = slot;
        self.place_offsets[expression] = 0;
        self.place_extent[expression] = self.data_sizes[expected % 100000];
        self.place_types[expression] = 100000 + expected % 100000;
        self.place_indirect[expression] = 1;
        self.place_writable[expression] = expected / 100000 - 4;
        self.place_fields[expression] = -1;
        transition self.place_available(source, expression, expected / 100000 - 4) {
            1 -> capacity(slot)
            _ -> return 0
        }
    }
    state capacity(slot: i32) {
        transition self.loan_count < 16384 {
            true -> retain(slot)
            _ -> unsupported()
        }
    }
    state retain(slot: i32) {
        self.loan_access[self.loan_count] = expected / 100000 - 4;
        self.loan_context[self.loan_count] = 0;
        self.loan_roots[self.loan_count] = slot;
        self.loan_offsets[self.loan_count] = 0;
        self.loan_sizes[self.loan_count] = self.place_extent[expression];
        self.loan_count = self.loan_count + 1;
        self.value_kinds[expression] = OmegaCheckedValueKind::ForwardedReference;
        self.value_payloads[expression] = slot;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// Contracts use the same parsed predicate expressions as data defaults. This
// profile supports unsigned formal/field bounds and conjunction, not arbitrary
// contracts. An unsupported predicate cannot disappear into an empty contract.
machine OmegaScalarCompiler::decode_entry_bounds(&mut self, source: &[u8], state_index: i32) -> i32 {
    self.diagnostic_offset = self.parser.machine_items[self.state_owners[state_index]].start;
    self.bound_first[state_index] = self.bound_total;
    self.bound_count[state_index] = 0;
    transition true { true -> next(0) }
    state next(offset: i32) {
        transition offset < self.parser.machine_states[state_index].requirement_count {
            true -> predicate(offset, self.parser.requirements[
                self.parser.machine_states[state_index].first_requirement + offset].expression)
            _ -> complete()
        }
    }
    state predicate(offset: i32, expression: i32) {
        transition self.decode_entry_predicate(source, state_index, expression) {
            1 -> next(offset + 1)
            _ -> return 0
        }
    }
    state complete() {
        self.bound_count[state_index] = self.bound_total - self.bound_first[state_index];
        return 1;
    }
}

machine OmegaScalarCompiler::decode_entry_predicate(
    &mut self, source: &[u8], state_index: i32, expression: i32
) -> i32 {
    let value: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition value.kind {
        OmegaExpressionKind::Boolean -> truth(value.payload0)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[value.payload0])
        _ -> unsupported()
    }
    state truth(value: i32) { transition value == 1 { true -> return 1 _ -> unsupported() } }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::And -> conjunction(row)
            OmegaBinaryOperatorKind::Less -> subject(row, 1)
            OmegaBinaryOperatorKind::LessEqual -> subject(row, 0)
            _ -> unsupported()
        }
    }
    state conjunction(row: OmegaBinaryExpressionSyntax) {
        transition (self.decode_entry_predicate(source, state_index, row.left) == 1) &&
            (self.decode_entry_predicate(source, state_index, row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state subject(row: OmegaBinaryExpressionSyntax, strict: i32) {
        transition self.parser.expressions[row.left].kind {
            OmegaExpressionKind::Path -> place(row, strict)
            _ -> unsupported()
        }
    }
    state place(row: OmegaBinaryExpressionSyntax, strict: i32) {
        transition self.check_place(source, state_index, 0, row.left) {
            1 -> formal(row, strict, self.place_roots[row.left])
            _ -> return 0
        }
    }
    state formal(row: OmegaBinaryExpressionSyntax, strict: i32, root: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[state_index];
        transition (root >= body.first_parameter) && (root < body.first_parameter + body.parameter_count) &&
            ((self.parameter_types[root] < 100000) || (self.parameter_types[root] >= 400000)) {
            true -> carrier(row, strict, self.place_types[row.left])
            _ -> unsupported()
        }
    }
    state carrier(row: OmegaBinaryExpressionSyntax, strict: i32, kind: i32) {
        transition (kind == 8) || (kind == 32) || (kind == 64) || (kind == 288) || (kind == 320) {
            true -> literal(row, strict, kind % 256, self.parser.expressions[row.right])
            _ -> unsupported()
        }
    }
    state literal(row: OmegaBinaryExpressionSyntax, strict: i32, kind: i32, right: OmegaExpressionSyntax) {
        transition right.kind {
            OmegaExpressionKind::Integer -> scan(row, strict, kind, right)
            _ -> unsupported()
        }
    }
    state scan(row: OmegaBinaryExpressionSyntax, strict: i32, kind: i32, right: OmegaExpressionSyntax) {
        self.scan_scalar_literal(source, right.payload0, right.payload1, kind);
        transition (self.literal_status == 1) && (self.literal_value >= strict) && (self.bound_total < 16384) {
            true -> retain(row, self.literal_value - strict)
            _ -> unsupported()
        }
    }
    state retain(row: OmegaBinaryExpressionSyntax, limit: i32) {
        self.bound_roots[self.bound_total] = self.place_roots[row.left];
        self.bound_offsets[self.bound_total] = self.place_offsets[row.left];
        self.bound_limits[self.bound_total] = limit;
        self.bound_fields[self.bound_total] = self.place_fields[row.left];
        self.bound_total = self.bound_total + 1;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}
// Unsigned upper bounds have one meaning across entry contracts, indexed
// access and invariant-preserving stores. Missing evidence is not a runtime
// check or an inferred precondition. A copied immutable initializer keeps its
// earlier snapshot; mutable referents use exact root/projection versions.
machine OmegaScalarCompiler::prove_upper(
    &mut self, source: &[u8], state_index: i32, before: i32,
    expression: i32, limit: i32, guard: i32, truth: i32
) -> i32 {
    transition limit >= 0 {
        true -> value()
        _ -> return 0
    }
    state value() {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::Literal -> literal(self.value_payloads[expression])
            OmegaCheckedValueKind::RepresentationCast -> return self.prove_upper(source, state_index, before, self.value_payloads[expression], limit, guard, truth)
            OmegaCheckedValueKind::Place -> place()
            OmegaCheckedValueKind::ExactAddition -> addition(self.parser.binary_expressions[self.value_payloads[expression]])
            _ -> return 0
        }
    }
    state literal(value: i32) {
        transition (value >= 0) && (value <= limit) { true -> return 1 _ -> return 0 }
    }
    state place() {
        transition self.prove_place_upper(source, state_index, before,
            self.place_roots[expression], self.place_offsets[expression],
            self.place_fields[expression], self.place_types[expression], limit, guard, truth) {
            1 -> return 1
            _ -> local(self.place_roots[expression])
        }
    }
    state local(root: i32) {
        transition (root >= 16384) && (self.place_offsets[expression] == 0) && (self.place_fields[expression] < 0) {
            true -> initializer(root - 16384, self.parser.local_data_statements[root - 16384])
            _ -> return 0
        }
    }
    state initializer(index: i32, row: OmegaLocalDataStatementSyntax) {
        transition (row.is_mutable == 0) && (row.has_initial_value == 1) {
            true -> return self.prove_upper(source, state_index, self.local_befores[index], row.initial_value, limit, -1, 0)
            _ -> return 0
        }
    }
    state addition(row: OmegaBinaryExpressionSyntax) {
        transition self.value_kinds[row.right] {
            OmegaCheckedValueKind::Literal -> added(row, self.value_payloads[row.right])
            _ -> return 0
        }
    }
    state added(row: OmegaBinaryExpressionSyntax, amount: i32) {
        transition (amount >= 0) && (amount <= limit) {
            true -> return self.prove_upper(source, state_index, before, row.left, limit - amount, guard, truth)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::prove_place_upper(
    &mut self, source: &[u8], state_index: i32, before: i32,
    root: i32, offset: i32, field: i32, kind: i32,
    limit: i32, guard: i32, truth: i32
) -> i32 {
    transition (kind == 8) && (limit >= 255) {
        true -> return 1
        _ -> declared()
    }
    state declared() {
        transition field >= 0 {
            true -> field_bound(self.field_upper_bounds[field])
            _ -> guarded()
        }
    }
    state field_bound(known: i32) {
        transition (known >= 0) && (known <= limit) { true -> return 1 _ -> guarded() }
    }
    state guarded() {
        transition self.guard_upper(root, offset, limit, guard, truth) {
            1 -> return 1
            _ -> preserved()
        }
    }
    state preserved() {
        transition self.preserve_entry_place(state_index, before, root, offset) {
            1 -> contract(0)
            _ -> return 0
        }
    }
    state contract(index: i32) {
        transition index < self.bound_count[state_index] {
            true -> bound(index, self.bound_first[state_index] + index)
            _ -> return 0
        }
    }
    state bound(index: i32, bound: i32) {
        transition (self.bound_roots[bound] == root) && (self.bound_offsets[bound] == offset) &&
            (self.bound_limits[bound] <= limit) {
            true -> return 1
            _ -> contract(index + 1)
        }
    }
}

// Only pure expressions contribute reusable guard facts. In particular,
// `bound && mutating_call()` cannot retain the earlier bound at the call edge.
machine OmegaScalarCompiler::pure_value(&mut self, expression: i32) -> i32 {
    transition self.parser.expressions[expression].kind {
        OmegaExpressionKind::Path -> return 1
        OmegaExpressionKind::Integer -> return 1
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Borrow -> return self.pure_value(self.parser.expressions[expression].payload0)
        OmegaExpressionKind::Cast -> return self.pure_value(self.parser.cast_expressions[self.parser.expressions[expression].payload0].value)
        OmegaExpressionKind::Unary -> return self.pure_value(self.parser.unary_expressions[self.parser.expressions[expression].payload0].operand)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[self.parser.expressions[expression].payload0])
        OmegaExpressionKind::Indexed -> indexed(self.parser.indexed_expressions[self.parser.expressions[expression].payload0])
        _ -> return 0
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition (self.pure_value(row.left) == 1) && (self.pure_value(row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state indexed(row: OmegaIndexedExpressionSyntax) {
        transition (self.pure_value(row.base) == 1) && (self.pure_value(row.index) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::preserve_entry_place(&mut self, state_index: i32, before: i32, root: i32, offset: i32) -> i32 {
    transition self.entry_effects_preserve(state_index, before, root, offset) {
        1 -> next(0)
        _ -> return 0
    }
    state next(cursor: i32) {
        transition cursor < before {
            true -> statement(cursor, self.parser.statements[self.parser.machine_states[state_index].first_statement + cursor])
            _ -> return 1
        }
    }
    state statement(cursor: i32, row: OmegaStatementSyntax) {
        transition row.kind {
            OmegaStatementKind::LocalData -> next(cursor + 1)
            OmegaStatementKind::Call -> next(cursor + 1)
            OmegaStatementKind::Assignment -> target(cursor, self.parser.assignment_statements[row.item_index].target)
            _ -> return 0
        }
    }
    state target(cursor: i32, target: i32) {
        transition (self.place_roots[target] != root) ||
            (self.place_offsets[target] + self.place_extent[target] <= offset) ||
            (offset + 8 <= self.place_offsets[target]) {
            true -> next(cursor + 1)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::guard_place(&mut self, expression: i32, root: i32, offset: i32) -> i32 {
    transition self.value_kinds[expression] {
        OmegaCheckedValueKind::RepresentationCast -> return self.guard_place(self.value_payloads[expression], root, offset)
        OmegaCheckedValueKind::Place -> place()
        _ -> return 0
    }
    state place() {
        transition (self.place_roots[expression] == root) && (self.place_offsets[expression] == offset) &&
            (self.place_extent[expression] == 8) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::guard_upper(&mut self, root: i32, offset: i32, limit: i32, expression: i32, truth: i32) -> i32 {
    transition expression >= 0 {
        true -> value()
        _ -> return 0
    }
    state value() {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::LogicalNot -> return self.guard_upper(root, offset, limit, self.value_payloads[expression], 1 - truth)
            OmegaCheckedValueKind::BooleanBinary -> binary(self.parser.binary_expressions[self.value_payloads[expression]])
            _ -> return 0
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::And -> conjunction(row)
            OmegaBinaryOperatorKind::Or -> disjunction(row)
            OmegaBinaryOperatorKind::Less -> less(row)
            OmegaBinaryOperatorKind::LessEqual -> less_equal(row)
            OmegaBinaryOperatorKind::Greater -> greater(row)
            OmegaBinaryOperatorKind::GreaterEqual -> greater_equal(row)
            OmegaBinaryOperatorKind::Equal -> equality(row, truth)
            OmegaBinaryOperatorKind::NotEqual -> equality(row, 1 - truth)
            _ -> return 0
        }
    }
    state conjunction(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> either(row, 1) _ -> both(row, 0) }
    }
    state disjunction(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> both(row, 1) _ -> either(row, 0) }
    }
    state either(row: OmegaBinaryExpressionSyntax, value: i32) {
        transition (self.guard_upper(root, offset, limit, row.left, value) == 1) ||
            (self.guard_upper(root, offset, limit, row.right, value) == 1) {
            true -> return 1 _ -> return 0
        }
    }
    state both(row: OmegaBinaryExpressionSyntax, value: i32) {
        transition (self.guard_upper(root, offset, limit, row.left, value) == 1) &&
            (self.guard_upper(root, offset, limit, row.right, value) == 1) {
            true -> return 1 _ -> return 0
        }
    }
    state less(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.left, row.right, 1) _ -> compare(row.right, row.left, 0) }
    }
    state less_equal(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.left, row.right, 0) _ -> compare(row.right, row.left, 1) }
    }
    state greater(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.right, row.left, 1) _ -> compare(row.left, row.right, 0) }
    }
    state greater_equal(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.right, row.left, 0) _ -> compare(row.left, row.right, 1) }
    }
    state equality(row: OmegaBinaryExpressionSyntax, matched: i32) {
        transition matched { 1 -> equal_sides(row) _ -> return 0 }
    }
    state equal_sides(row: OmegaBinaryExpressionSyntax) {
        transition self.guard_upper_pair(root, offset, limit, row.left, row.right, 0) {
            1 -> return 1 _ -> compare(row.right, row.left, 0)
        }
    }
    state compare(subject: i32, other: i32, strict: i32) {
        return self.guard_upper_pair(root, offset, limit, subject, other, strict);
    }
}

machine OmegaScalarCompiler::guard_upper_pair(&mut self, root: i32, offset: i32, limit: i32, subject: i32, other: i32, strict: i32) -> i32 {
    transition self.guard_place(subject, root, offset) {
        1 -> other_kind()
        _ -> return 0
    }
    state other_kind() {
        transition self.value_kinds[other] {
            OmegaCheckedValueKind::Literal -> literal(self.value_payloads[other])
            _ -> return 0
        }
    }
    state literal(value: i32) {
        transition (value >= strict) && (value - strict <= limit) { true -> return 1 _ -> return 0 }
    }
}

// Contract-bearing calls currently require pure actual expressions and a pure
// guard. This explicit coverage boundary prevents later argument evaluation
// from invalidating a referenced field after its guard was observed. Copied
// snapshots remain independent; broader effect summaries are not guessed.
machine OmegaScalarCompiler::check_call_bounds(
    &mut self, source: &[u8], state_index: i32, before: i32,
    first_argument: i32, count: i32, target: i32, guard: i32, truth: i32
) -> i32 {
    transition self.bound_count[target] == 0 {
        true -> return 1
        _ -> guarded()
    }
    state guarded() {
        transition (guard < 0) || (self.pure_value(guard) == 1) {
            true -> pure_argument(0)
            _ -> unsupported()
        }
    }
    state pure_argument(index: i32) {
        transition index < count {
            true -> pure(index, self.parser.call_arguments[first_argument + index])
            _ -> requirement(0)
        }
    }
    state pure(index: i32, argument: i32) {
        transition self.pure_value(argument) {
            1 -> pure_argument(index + 1)
            _ -> unsupported()
        }
    }
    state requirement(index: i32) {
        transition index < self.bound_count[target] {
            true -> actual(index, self.bound_first[target] + index)
            _ -> return 1
        }
    }
    state actual(index: i32, bound: i32) {
        let offset: i32 = self.bound_roots[bound] - self.parser.machine_states[target].first_parameter;
        transition (offset >= 0) && (offset < count) {
            true -> argument(index, bound, self.parser.call_arguments[first_argument + offset])
            _ -> unsupported()
        }
    }
    state argument(index: i32, bound: i32, argument: i32) {
        transition self.parameter_types[self.bound_roots[bound]] >= 400000 {
            true -> reference(index, bound, argument)
            _ -> scalar(index, bound, argument)
        }
    }
    state scalar(index: i32, bound: i32, argument: i32) {
        transition self.prove_upper(source, state_index, before, argument, self.bound_limits[bound], guard, truth) {
            1 -> requirement(index + 1)
            _ -> unsupported()
        }
    }
    state reference(index: i32, bound: i32, argument: i32) {
        transition self.value_kinds[argument] {
            OmegaCheckedValueKind::Borrow -> referent(index, bound, self.value_payloads[argument])
            OmegaCheckedValueKind::ForwardedReference -> referent(index, bound, argument)
            _ -> unsupported()
        }
    }
    state referent(index: i32, bound: i32, place: i32) {
        let field: i32 = self.bound_fields[bound];
        transition field >= 0 {
            true -> field_bound(index, bound, place, field)
            _ -> unsupported()
        }
    }
    state field_bound(index: i32, bound: i32, place: i32, field: i32) {
        transition self.prove_place_upper(source, state_index, before,
            self.place_roots[place], self.place_offsets[place] + self.bound_offsets[bound],
            field, self.field_types[field], self.bound_limits[bound], guard, truth) {
            1 -> requirement(index + 1)
            _ -> unsupported()
        }
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// Ordinary calls cannot mutate ambient storage in this profile. Each admitted
// exclusive argument identifies its complete possible mutation range. Retain
// that event as soon as the call finishes checking, so later operands in the
// same expression cannot reuse an earlier entry fact about that range.
machine OmegaScalarCompiler::retain_call_effects(
    &mut self, state_index: i32, before: i32, first_argument: i32, count: i32, first_parameter: i32
) -> i32 {
    transition true { true -> next(0) }
    state next(index: i32) {
        transition index < count {
            true -> argument(index, self.parser.call_arguments[first_argument + index])
            _ -> return 1
        }
    }
    state argument(index: i32, expression: i32) {
        transition self.parameter_types[first_parameter + index] >= 500000 {
            true -> borrowed(index, expression)
            _ -> next(index + 1)
        }
    }
    state borrowed(index: i32, expression: i32) {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::Borrow -> capacity(index, self.value_payloads[expression])
            OmegaCheckedValueKind::ForwardedReference -> capacity(index, expression)
            _ -> unsupported()
        }
    }
    state capacity(index: i32, place: i32) {
        transition self.effect_count < 16384 {
            true -> retain(index, place)
            _ -> unsupported()
        }
    }
    state retain(index: i32, place: i32) {
        self.effect_states[self.effect_count] = state_index;
        self.effect_befores[self.effect_count] = before;
        self.effect_roots[self.effect_count] = self.place_roots[place];
        self.effect_offsets[self.effect_count] = self.place_offsets[place];
        self.effect_sizes[self.effect_count] = self.place_extent[place];
        self.effect_count = self.effect_count + 1;
        transition true { true -> next(index + 1) }
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::entry_effects_preserve(
    &mut self, state_index: i32, before: i32, root: i32, offset: i32
) -> i32 {
    transition true { true -> next(0) }
    state next(index: i32) {
        transition index < self.effect_count {
            true -> event(index)
            _ -> return 1
        }
    }
    state event(index: i32) {
        transition (self.effect_states[index] == state_index) &&
            (self.effect_befores[index] <= before) && (self.effect_roots[index] == root) &&
            (self.effect_offsets[index] < offset + 8) &&
            (offset < self.effect_offsets[index] + self.effect_sizes[index]) {
            true -> return 0
            _ -> next(index + 1)
        }
    }
}

// Each admitted Trapping primitive owns its overflow check and trap site.
// Operands evaluate once, left to right; the expression's private scratch saves
// the left value across a call or mutation in the right operand. u32 products
// fit a full Alpha word before the explicit u32 range check. Wider multiply
// has no selected realization and is refused by checking.
machine OmegaScalarCompiler::emit_trapping_arithmetic(
    &mut self, expression: i32, row: OmegaBinaryExpressionSyntax
) -> i32 {
    self.emission_resource = 14;
    let trap: i32 = self.tape.new_label();
    let complete: i32 = self.tape.new_label();
    transition (trap >= 0) && (complete >= 0) {
        true -> operands(trap, complete)
        _ -> return 0
    }
    state operands(trap: i32, complete: i32) {
        self.emission_resource = 12;
        transition (self.emit_value(row.left) == 1) &&
            (self.emit_value_store(49152 + expression) == 1) &&
            (self.emit_value(row.right) == 1) &&
            (self.tape.emit_rr(2, 2, 0) == 1) &&
            (self.emit_value_load(49152 + expression) == 1) {
            true -> operation(trap, complete)
            _ -> return 0
        }
    }
    state operation(trap: i32, complete: i32) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> add(trap, complete)
            OmegaBinaryOperatorKind::Subtract -> subtract(trap, complete)
            OmegaBinaryOperatorKind::Multiply -> multiply(trap, complete)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state add(trap: i32, complete: i32) {
        // Save the original left word; a wrapped u64 sum is less than it.
        transition (self.tape.emit_rr(2, 4, 0) == 1) &&
            (self.tape.emit_rr(3, 0, 2) == 1) {
            true -> add_carrier(trap, complete, self.cell_types[49152 + expression])
            _ -> return 0
        }
    }
    state add_carrier(trap: i32, complete: i32, kind: i32) {
        transition kind {
            288 -> u32_result(trap, complete)
            320 -> u64_sum(trap, complete)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state u64_sum(trap: i32, complete: i32) {
        transition (self.tape.emit_rr(2, 2, 4) == 1) &&
            (self.emit_unsigned_less_to(0, 2, trap) == 1) {
            true -> finish(trap, complete)
            _ -> return 0
        }
    }
    state subtract(trap: i32, complete: i32) {
        // Underflow is exactly left < right for either unsigned carrier.
        transition (self.emit_unsigned_less_to(0, 2, trap) == 1) &&
            (self.tape.emit_rr(4, 0, 2) == 1) {
            true -> finish(trap, complete)
            _ -> return 0
        }
    }
    state multiply(trap: i32, complete: i32) {
        transition self.cell_types[49152 + expression] == 288 {
            true -> u32_product(trap, complete)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state u32_product(trap: i32, complete: i32) {
        transition self.tape.emit_rr(5, 0, 2) {
            1 -> u32_result(trap, complete)
            _ -> return 0
        }
    }
    state u32_result(trap: i32, complete: i32) {
        // The low immediate word is all ones; its high word remains zero.
        transition (self.tape.emit_imm(2, -1, 0) == 1) &&
            (self.emit_unsigned_less_to(2, 0, trap) == 1) {
            true -> finish(trap, complete)
            _ -> return 0
        }
    }
    state finish(trap: i32, complete: i32) {
        // Alpha division by zero realizes its abnormal Trap. This check has
        // no fabricated normal return, diagnostic exit or wrapped value.
        transition (self.tape.emit_jump_label(12, complete) == 1) &&
            (self.tape.define_label(trap) == 1) &&
            (self.tape.emit_imm(1, 0, 0) == 1) &&
            (self.tape.emit_rr(6, 0, 1) == 1) &&
            (self.tape.define_label(complete) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Branch on unsigned left < right without changing either operand. Callers
// supply r0/r2; r3/r4/r5 are private scratch. Adding 2^63 to each word maps
// unsigned order bijectively to Alpha's signed comparison order.
machine OmegaScalarCompiler::emit_unsigned_less_to(
    &mut self, left: i32, right: i32, target: i32
) -> i32 {
    transition (self.tape.emit_imm(3, 0, -2147483648) == 1) &&
        (self.tape.emit_rr(2, 4, left) == 1) &&
        (self.tape.emit_rr(2, 5, right) == 1) &&
        (self.tape.emit_rr(3, 4, 3) == 1) &&
        (self.tape.emit_rr(3, 5, 3) == 1) &&
        (self.tape.emit_rrx_label(15, 4, 5, target) == 1) {
        true -> return 1
        _ -> return 0
    }
}
