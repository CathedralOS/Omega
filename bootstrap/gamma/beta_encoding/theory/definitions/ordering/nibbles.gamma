; Functions 37..52 compare a fixed left Nibble against all right Nibbles.
; The emitter's comparison selects literal constructors in finite case tables;
; the emitted theory contains no arithmetic or comparison primitive.
(def beta_ordering_nibble_helpers ((left Int)) Int
  (if (eq left 16) 0
    (let length Int (beta_theory_word 134)
      (let signature Int (beta_theory_fields3 8 1 3)
        (let mode Int (beta_theory_fields3 1 0 16)
          (let cases Int (beta_ordering_nibble_helper_cases left 0)
            (beta_ordering_nibble_helpers (+ left 1))))))))

(def beta_ordering_nibble_helper_cases ((left Int) (right Int)) Int
  (if (eq right 16) 0
    (let clause Int (beta_constant_clause (+ 259 right)
      (if (lt left right) 282 (if (eq left right) 283 284)))
      (beta_ordering_nibble_helper_cases left (+ right 1)))))

; Function 53: nibble_compare(left, right). Slot 0 is matched and unbound;
; slot 1 supplies the right Nibble to the earlier fixed-left helper.
(def beta_ordering_nibble_definition () Int
  (let length Int (beta_theory_word 199)
    (let signature Int (beta_theory_fields3 8 2 3)
      (let right_sort Int (beta_theory_word 3)
        (let mode Int (beta_theory_fields3 1 0 16)
          (beta_ordering_nibble_cases 0))))))

(def beta_ordering_nibble_cases ((left Int)) Int
  (if (eq left 16) 0
    (let header Int (beta_theory_fields3 11 (+ 259 left) 2)
      (let variable Int (beta_variable_template 1)
        (let application Int (beta_unary_template 2 (+ 37 left) 1)
          (let body Int (beta_theory_word 2)
            (beta_ordering_nibble_cases (+ left 1))))))))
