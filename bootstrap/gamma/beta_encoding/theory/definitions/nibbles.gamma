; Functions 5..20 map a low Nibble to Byte with a fixed high nibble 0..15.
; Arithmetic here authors finite clauses; no arithmetic operation enters GTH1.
(def beta_nibble_helpers ((high Int)) Int
  (if (eq high 16) 0
    (let length Int (beta_theory_word 134)
      (let signature Int (beta_theory_fields3 1 1 3)
        (let mode Int (beta_theory_fields3 1 0 16)
          (let cases Int (beta_nibble_helper_cases high 0)
            (beta_nibble_helpers (+ high 1))))))))

(def beta_nibble_helper_cases ((high Int) (low Int)) Int
  (if (eq low 16) 0
    (let clause Int
      (beta_constant_clause (+ 259 low) (+ 1 (+ (* 16 high) low)))
      (beta_nibble_helper_cases high (+ low 1)))))

; Function 21: byte_from_nibbles(high, low). Slot 0 is matched and unbound;
; slot 1 is the other argument, passed to the earlier fixed-high helper.
(def beta_join_nibbles_definition () Int
  (let length Int (beta_theory_word 199)
    (let signature Int (beta_theory_fields3 1 2 3)
      (let low_sort Int (beta_theory_word 3)
        (let mode Int (beta_theory_fields3 1 0 16)
          (beta_join_nibbles_cases 0))))))

(def beta_join_nibbles_cases ((high Int)) Int
  (if (eq high 16) 0
    (let header Int (beta_theory_fields3 11 (+ 259 high) 2)
      (let variable Int (beta_variable_template 1)
        (let application Int (beta_theory_fields3 4 2 (+ 5 high))
          (let argument Int (beta_theory_fields3 1 1 2)
            (beta_join_nibbles_cases (+ high 1))))))))

; Functions 22 and 23: high_nibble and low_nibble, respectively.
(def beta_split_nibble_definition ((high Int)) Int
  (let length Int (beta_theory_word 2054)
    (let signature Int (beta_theory_fields3 3 1 1)
      (let mode Int (beta_theory_fields3 1 0 256)
        (beta_split_nibble_cases high 0)))))

(def beta_split_nibble_cases ((high Int) (byte Int)) Int
  (if (eq byte 256) 0
    (let clause Int (beta_constant_clause (+ byte 1)
      (+ 259 (if high (/ byte 16) (% byte 16))))
      (beta_split_nibble_cases high (+ byte 1)))))
