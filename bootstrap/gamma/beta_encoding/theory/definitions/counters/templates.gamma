; These bounded emitter walks emit fixed template syntax, never proof evidence.
(def beta_counter_repeated_word ((value Int) (remaining Int)) Int
  (if (eq remaining 0) 0
    (let field Int (beta_theory_word value)
      (beta_counter_repeated_word value (- remaining 1)))))

(def beta_counter_variables ((slot Int) (remaining Int)) Int
  (if (eq remaining 0) 0
    (let variable Int (beta_variable_template slot)
      (beta_counter_variables (+ slot 1) (- remaining 1)))))

(def beta_counter_unary_template ((tag Int) (symbol Int) (child Int)) Int
  (let header Int (beta_theory_fields3 4 tag symbol)
    (let arity Int (beta_theory_word 1)
      (beta_theory_word child))))

; Emit an eight-child application, optionally replacing one byte row.
; Position -1 retains every byte; all actual row references are 1..13.
(def beta_counter_word_template ((tag Int) (symbol Int) (position Int)
  (replacement Int)) Int
  (let header Int (beta_theory_fields3 11 tag symbol)
    (let arity Int (beta_theory_word 8)
      (beta_counter_word_children position replacement 0))))

(def beta_counter_word_children ((position Int) (replacement Int) (byte Int)) Int
  (if (eq byte 8) 0
    (let child Int (beta_theory_word
      (if (eq byte position) replacement (+ byte 1)))
      (beta_counter_word_children position replacement (+ byte 1)))))
