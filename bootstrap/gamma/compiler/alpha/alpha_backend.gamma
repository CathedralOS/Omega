; Alpha register operands are consecutive bytes after the opcode. Pack those
; bytes into one little-endian field. Immediate words and label addresses
; follow their prefix as separate eight-byte fields.
(def alpha_reg ((s Int) (opcode Int) (reg Int)) Int
  (i_field s 2 (+ opcode (* 256 reg))))
(def alpha_regs ((s Int) (opcode Int) (a Int) (b Int)) Int
  (i_field s 3 (+ opcode (* 256 (+ a (* 256 b))))))

(def i_halt ((s Int) (reg Int)) Int (alpha_reg s 0 reg))
(def i_imm ((s Int) (reg Int) (value Int)) Int
  (i_field (alpha_reg s 1 reg) 8 value))
(def i_mov ((s Int) (a Int) (b Int)) Int (alpha_regs s 2 a b))
(def i_add ((s Int) (a Int) (b Int)) Int (alpha_regs s 3 a b))
(def i_sub ((s Int) (a Int) (b Int)) Int (alpha_regs s 4 a b))
(def i_mul ((s Int) (a Int) (b Int)) Int (alpha_regs s 5 a b))
(def i_div ((s Int) (a Int) (b Int)) Int (alpha_regs s 6 a b))
(def i_mod ((s Int) (a Int) (b Int)) Int (alpha_regs s 7 a b))
(def i_loadb ((s Int) (dst Int) (addr Int)) Int (alpha_regs s 8 dst addr))
(def i_storeb ((s Int) (addr Int) (src Int)) Int (alpha_regs s 9 addr src))
(def i_load ((s Int) (dst Int) (addr Int)) Int (alpha_regs s 10 dst addr))
(def i_store ((s Int) (addr Int) (src Int)) Int (alpha_regs s 11 addr src))
(def i_jmp ((s Int) (label Int)) Int (i_address (i_field s 1 12) label))
(def i_jz ((s Int) (reg Int) (label Int)) Int
  (i_address (alpha_reg s 13 reg) label))
(def i_jnz ((s Int) (reg Int) (label Int)) Int
  (i_address (alpha_reg s 14 reg) label))
(def i_jlt ((s Int) (a Int) (b Int) (label Int)) Int
  (i_address (alpha_regs s 15 a b) label))
(def i_jeq ((s Int) (a Int) (b Int) (label Int)) Int
  (i_address (alpha_regs s 16 a b) label))
(def i_read ((s Int) (reg Int)) Int (alpha_reg s 17 reg))
(def i_write ((s Int) (reg Int)) Int (alpha_reg s 18 reg))
(def i_call ((s Int) (label Int)) Int (i_address (i_field s 1 19) label))
(def i_ret ((s Int)) Int (i_field s 1 20))

; Pair operations pop tagged operands, check or allocate the pair, then
; jump to the stack push. The push returns directly to the caller, so even
; at the last admitted Gamma frame the operation needs one return address.
(def alpha_project ((s Int) (kind Int) (label Int)) Int
  (i_jmp (e_project (e_pop_body (s_mark s label) 0) kind) 14))
(def alpha_pair_runtime ((s Int)) Int
  (let ((right Int (e_pop_body (s_mark (e_stack_helpers s) 17) 2))
        (both Int (e_pop_body right 0))
        (allocated Int (i_jmp (e_pair both) 14))
        (left Int (alpha_project allocated 17 18)))
    (alpha_project left 18 19)))
(def e_primitive ((s Int) (kind Int)) Int
  (if (eq kind 14) (i_call s 17)
    (if (eq kind 17) (i_call s 18)
      (if (eq kind 18) (i_call s 19) (e_primitive_body s kind)))))
; Register 10 carries the frame offset into a single tagged load or store.
(def i_stack_runtime ((s Int)) Int
  (let ((load Int (s_mark (alpha_pair_runtime s) 20))
        (loaded Int (i_ret (e_slot_at (i_add load 10 247) 0)))
        (store Int (s_mark loaded 21)))
    (i_ret (e_slot_at (i_add store 10 247) 1))))
(def e_slot ((s Int) (offset Int) (store Int)) Int
  (i_call (i_imm s 10 (* offset 16)) (if store 21 20)))
(def e_move_args ((s Int) (words Int)) Int
  (if words (e_move_args (e_move_arg_word s) (- words 1)) s))

; Alpha jumps and calls carry an absolute byte offset from the first opcode.
(def i_target_width () Int 8)
(def i_target_value ((size Int) (following Int) (suffix Int)) Int (- size suffix))

; A small program is already a stampable Alpha tape. For a larger program
; keep the same instructions, using one byte for a repeated instruction.
; The tape's entry copies them into the unused interval between the output
; buffer end and the pair heap, then enters the ordinary compiled program.
(def i_limit () Int 16777213)
(def alpha_code_base () Int (+ (e_output_base) (e_output_capacity)))
(def alpha_code_capacity () Int (- (e_pair_heap_base) (alpha_code_base)))

; Each assembled instruction begins with a field containing its opcode and
; registers. Only imm, branches and call have a second (eight-byte) field.
(def alpha_prefix ((fields Int)) Int (first (second (first fields))))
(def alpha_has_word ((prefix Int)) Int
  (let op Int (% prefix 256)
    (if (eq op 1) 1 (if (eq op 19) 1 (* (lt 11 op) (lt op 17))))))

; AVL keys carry the 24-bit opcode/register prefix and a signed int32
; operand. Larger immediates pass through literally. Labels remain symbolic
; until publication, so repeated calls to one function share a key.
(def alpha_instruction_key ((prefix Int) (word Int)) Int
  (if (lt word -2147483648) -9223372036854775808
    (if (lt 2147483647 word) -9223372036854775808 (+ (* word 16777216) prefix))))
(def alpha_token ((index Int) (key Int)) Int
  (if (m_height index)
    (let here Int (m_key index)
      (if (eq key here) (m_value index)
        (alpha_token (if (lt key here) (m_left index) (m_right index)) key))) 0))

; Take the first 240 instructions seen twice in a bounded prefix. The table
; can be empty. Its contents affect only the length of the encoded stream.
(def alpha_dictionary ((fields Int) (remaining Int) (sample Int) (seen Int)
                       (index Int) (entries Int)) Int
  (if (* sample (* (lt 0 remaining) (lt (p_length entries) 240)))
    (let ((prefix Int (alpha_prefix fields)) (wide Int (alpha_has_word prefix))
          (rest Int (second fields))
          (key Int (alpha_instruction_key prefix (if wide (alpha_prefix rest) 0)))
          (next Int (if wide (second rest) rest))
          (left Int (- remaining (+ (first (first fields)) (* wide 8)))))
      (if (eq key -9223372036854775808)
        (alpha_dictionary next left (- sample 1) seen index entries)
        (if (alpha_token seen key)
          (if (alpha_token index key)
            (alpha_dictionary next left (- sample 1) seen index entries)
            (alpha_dictionary next left (- sample 1) seen
              (m_put index key (+ 16 (p_length entries)) 0) (p_cons fields entries)))
          (alpha_dictionary next left (- sample 1) (m_put seen key 1 0) index entries))))
    (pair index (p_reverse entries))))

; Unlike user immediates, branch and call addresses refer to the expanded
; code interval. Dictionary entries and literal instructions use this same
; resolution. Their other bytes are identical to the plain Alpha encoding.
(def alpha_emit_instruction ((fields Int) (wide Int) (labels Int) (size Int)) Int
  (let header Int (i_word (alpha_prefix fields) (first (first fields)))
    (if wide
      (let ((field Int (first (second fields))) (v Int (first (second field))))
        (i_word (if (eq (first field) -1)
          (+ (alpha_code_base) (- size (m_get labels v 0))) v) 8)) 0)))
(def alpha_zeroes ((n Int)) Int
  (if n (let byte Int (write 0) (alpha_zeroes (- n 1))) 0))
(def alpha_emit_table ((entries Int) (labels Int) (size Int)) Int
  (if (p_length entries)
    (let ((fields Int (p_head entries)) (wide Int (alpha_has_word (alpha_prefix fields)))
          (width Int (+ (first (first fields)) (* wide 8))) (length Int (write width))
          (code Int (alpha_emit_instruction fields wide labels size))
          (padding Int (alpha_zeroes (- 15 width))))
      (alpha_emit_table (p_tail entries) labels size)) 0))

; Count and write with the same instruction walk. Literal commands carry
; their byte length (1..11). Commands 16..255 copy one dictionary entry.
(def alpha_stream ((fields Int) (remaining Int) (labels Int) (size Int)
                   (index Int) (used Int) (emit Int)) Int
  (if remaining
    (let ((prefix Int (alpha_prefix fields)) (wide Int (alpha_has_word prefix))
          (rest Int (second fields)) (width Int (+ (first (first fields)) (* wide 8)))
          (word Int (if wide (alpha_prefix rest) 0))
          (token Int (alpha_token index (alpha_instruction_key prefix word)))
          (length Int (+ used (if token 1 (+ 1 width))))
          (fit Int (c_check (lt length (i_limit)) 0))
          (output Int (if emit (if token (write token)
            (let marker Int (write width) (alpha_emit_instruction fields wide labels size))) 0)))
      (alpha_stream (if wide (second rest) rest) (- remaining width) labels size index length emit))
    used))

; Decoder registers: 0 stream cursor, 1 destination, 2 destination end,
; 3 dictionary, 4 token, 5 byte count, 6 copy source, 7 byte or bound,
; 8 one, 9 record width (16), 10 stream end, 11 first invalid table token.
; The ordinary immediate-add sequence also uses scratch register 12.
; Labels: 1 next token, 2 literal, 3 check copy, 4 copy byte, 5 finish,
; 6 malformed tape, 7 dictionary, 8 valid entry, 9 enter the program.
; The decoder never reads guest stdin.
(def alpha_decoder ((size Int) (entries Int) (packed Int)) Int
  (let ((start Int (pair (pair 8 0) (pair 0 0)))
        (table Int (i_address (alpha_reg start 1 3) 7))
        (input Int (e_add (i_mov table 0 3) 0 (* 16 entries)))
        (ends Int (e_add (i_mov input 10 0) 10 packed))
        (base Int (i_imm ends 1 (alpha_code_base)))
        (extent Int (i_imm base 2 (+ (alpha_code_base) size)))
        (one Int (i_imm extent 8 1)) (record Int (i_imm one 9 16))
        (ready Int (i_imm record 11 (+ 16 entries)))
        (done Int (i_jeq (s_mark ready 1) 1 2 5))
        (available Int (i_jeq done 0 10 6))
        (token Int (i_add (i_loadb available 4 0) 0 8))
        (literal Int (i_jlt token 4 9 2))
        (valid Int (i_jlt literal 4 11 8)) (invalid Int (i_jmp valid 6))
        (offset Int (i_mul (i_sub (s_mark invalid 8) 4 9) 4 9))
        (entry Int (i_add (i_mov offset 6 3) 6 4))
        (width Int (i_loadb entry 5 6)) (body Int (i_add width 6 8))
        (copy Int (i_jmp body 3))
        (raw Int (i_mov (i_mov (s_mark copy 2) 5 4) 6 0))
        (advance Int (i_add raw 0 5)) (raw_bound Int (i_jlt advance 10 0 6))
        (nonzero Int (i_jz (s_mark raw_bound 3) 5 6))
        (width_bound Int (i_imm nonzero 7 11)) (valid_width Int (i_jlt width_bound 7 5 6))
        (last Int (i_add (i_mov valid_width 7 1) 7 5)) (bounded Int (i_jlt last 2 7 6))
        (byte Int (i_loadb (s_mark bounded 4) 7 6)) (stored Int (i_storeb byte 1 7))
        (next Int (i_add (i_add stored 6 8) 1 8)) (count Int (i_sub next 5 8))
        (more Int (i_jnz count 5 4)) (loop Int (i_jmp more 1))
        (complete Int (i_jeq (s_mark loop 5) 0 10 9))
        (trap Int (i_field (s_mark complete 6) 1 255))
        (restore Int (alpha_clear (s_mark trap 9) 12))
        (enter Int (i_field (i_field restore 1 12) 8 (alpha_code_base))))
    (s_mark enter 7)))
(def alpha_clear ((s Int) (reg Int)) Int
  (if (lt reg 0) s (alpha_clear (i_mov s reg 240) (- reg 1))))
(def alpha_field_size ((fields Int) (size Int)) Int
  (let width Int (first fields)
    (if width (alpha_field_size (second (second fields))
      (+ size (if (eq width -2) 0 (i_width width)))) size)))

(def alpha_publish_packed ((fields Int) (size Int) (labels Int)) Int
  (let ((within Int (c_check (lt size (+ 1 (alpha_code_capacity))) 0))
        (dictionary Int (alpha_dictionary fields size 4096 (m_empty) (m_empty) (p_empty)))
        (index Int (first dictionary)) (entries Int (second dictionary))
        (count Int (p_length entries))
        (packed Int (alpha_stream fields size labels size index 0 0))
        (decoder Int (second (alpha_decoder size count packed)))
        (total Int (+ (alpha_field_size decoder 0) (+ (* 16 count) packed)))
        (fit Int (c_check (lt total (i_limit)) 0))
        (entry Int (i_layout decoder 0 0 (m_empty)))
        (table Int (alpha_emit_table entries labels size))
        (written Int (alpha_stream fields size labels size index 0 1)))
    (c_check (eq written packed) (pair 0 1))))
(def i_publish ((fields Int) (size Int) (labels Int)) Int
  (if (lt size (i_limit)) (i_output fields size labels size)
    (alpha_publish_packed fields size labels)))
