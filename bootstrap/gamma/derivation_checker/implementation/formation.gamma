(def form_derivation_theory () Int
  (let admitted Int (admit_derivation_layout)
    (if (eq (first admitted) 3)
      (let frame Int (second admitted)
        (let sorts Int (layout_word 28)
          (if (eq sorts 0)
            (admission_rejected 7 28)
            (if (lt 65536 sorts)
              (admission_incomplete 2 28 65536 sorts)
              (formation_census frame sorts (layout_word 32)
                36 (layout_word 32) 0)))))
      admitted)))
