(def admission_identity_byte_failure ((index Int) (expected Int)) Int
  (if (eq (read index) expected) -1 index))

(def admission_identity_failure () Int
  (let first_failure Int (admission_identity_byte_failure 0 71)
    (if (lt first_failure 0)
      (let second_failure Int (admission_identity_byte_failure 1 68)
        (if (lt second_failure 0)
          (let third_failure Int (admission_identity_byte_failure 2 82)
            (if (lt third_failure 0)
              (let fourth_failure Int (admission_identity_byte_failure 3 69)
                (if (lt fourth_failure 0)
                  (let fifth_failure Int (admission_identity_byte_failure 4 81)
                    (if (lt fifth_failure 0)
                      (let sixth_failure Int (admission_identity_byte_failure 5 1)
                        (if (lt sixth_failure 0)
                          (let seventh_failure Int (admission_identity_byte_failure 6 0)
                            (if (lt seventh_failure 0)
                              (admission_identity_byte_failure 7 0)
                              seventh_failure))
                          sixth_failure))
                      fifth_failure))
                  fourth_failure))
              third_failure))
          second_failure))
      first_failure)))

(def admission_reserved_failure () Int
  (let first_failure Int (admission_identity_byte_failure 20 0)
    (if (lt first_failure 0)
      (let second_failure Int (admission_identity_byte_failure 21 0)
        (if (lt second_failure 0)
          (let third_failure Int (admission_identity_byte_failure 22 0)
            (if (lt third_failure 0)
              (admission_identity_byte_failure 23 0)
              third_failure))
          second_failure))
      first_failure)))
