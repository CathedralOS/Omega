(def formation_template ((record Int) (identity Int) (context Int)) Int
  (if (eq (layout_word (+ record 4)) 0)
    (if (eq (formation_slot_sort (layout_word (+ record 8)) context) 0)
      (layout_failure (+ record 8)) 0)
    (let symbol Int (formation_template_symbol record context)
      (if (eq symbol 0)
        (layout_failure (+ record 8))
        (formation_application record identity symbol context)))))

(def formation_application ((record Int) (identity Int) (symbol Int)
  (context Int)) Int
  (let order Int (formation_call_order record context)
    (if (lt order 0) order
      (if (eq (layout_word (+ record 12)) (formation_arity symbol))
        (let children Int
          (formation_children (+ record 16) (+ symbol 12)
            (formation_arity symbol) identity context)
          (if (lt children 0) children
            (formation_self_decrease record context)))
        (layout_failure (+ record 12))))))

(def formation_call_order ((record Int) (context Int)) Int
  (if (eq (layout_word (+ record 4)) 1) 0
    (let function Int (formation_clause_function context)
      (let called Int (layout_word (+ record 8))
        (let current Int (formation_function_identity function)
          (if (lt current called)
            (layout_failure (+ record 8))
            (if (if (eq current called)
              (eq (formation_mode (formation_function_record function)) 0) 0)
              (layout_failure (+ record 8)) 0)))))))

(def formation_children ((cursor Int) (signature Int) (remaining Int)
  (identity Int) (context Int)) Int
  (if (eq remaining 0) 0
    (let child Int (layout_word cursor)
      (if (if (lt child 1) 1 (lt (- identity 1) child))
        (layout_failure cursor)
        (let record Int
          (formation_index_lookup (formation_clause_templates context) child)
          (if (eq (formation_template_sort record context) (layout_word signature))
            (formation_children (+ cursor 4) (+ signature 4)
              (- remaining 1) identity context)
            (layout_failure cursor)))))))
