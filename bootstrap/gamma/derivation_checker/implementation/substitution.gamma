(def compare_unfolded_terms ((session Int) (left Int) (right Int) (clause Int)
  (left_coordinate Int) (right_coordinate Int) (clause_coordinate Int)) Int
  (let grounded Int (comparison_grounded (comparison_context session))
    (let record Int (grounded_term_lookup grounded left)
      (if (eq record 0)
        (admission_rejected 9 left_coordinate)
        (if (eq (grounded_term_lookup grounded right) 0)
          (admission_rejected 9 right_coordinate)
          (if (eq (layout_word (+ record 4)) 2)
            (substitution_select session record right clause
              left_coordinate clause_coordinate)
            (admission_rejected 10 left_coordinate)))))))
