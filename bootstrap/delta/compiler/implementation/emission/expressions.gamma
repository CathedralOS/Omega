; Gamma-only serialization: frames retain arguments, a let body, or one close.
; No source classification, constructor lookup, or lowering rule runs here.
(def emission_frame ((kind Int) (payload Int) (previous Int)) Int
  (pair kind (pair payload previous)))

(def emission_visit ((node Int) (depth Int) (frames Int)) Int
  (let kind Int (gamma_kind node)
    (let payload Int (gamma_payload node)
      (if (eq kind 7)
        (let open Int (write '(')
          (let head Int (emit_gamma_atom (first payload))
            (emission_arguments (first (second payload)) (second (second payload))
              depth frames)))
        (if (eq kind 8)
          (let prefix Int (emit_ascii 139391757352 5)
            (let binder Int (emit_gamma_atom (first payload))
              (let separator Int (write '\s')
                (let annotation Int (emit_int_word)
                  (let initializer_space Int (write '\s')
                    (emission_visit (first (second payload)) (+ depth 1)
                      (emission_frame 2 (second (second payload)) frames)))))))
          (let atom Int (emit_gamma_atom node)
            (emission_resume depth frames)))))))

(def emission_arguments
  ((count Int) (arguments Int) (depth Int) (frames Int)) Int
  (if (eq count 0)
    (let close Int (write ')')
      (emission_resume depth frames))
    (let separator Int (write '\s')
      (emission_visit (first arguments) (+ depth 1)
        (emission_frame 1 (pair (- count 1) (second arguments)) frames)))))

(def emission_resume ((depth Int) (frames Int)) Int
  (if (eq depth 0)
    0
    (let kind Int (first frames)
      (let retained Int (second frames)
        (let payload Int (first retained)
          (let previous Int (second retained)
            (let next_depth Int (- depth 1)
              (if (eq kind 1)
                (emission_arguments (first payload) (second payload)
                  next_depth previous)
                (if (eq kind 2)
                  (let separator Int (write '\s')
                    (emission_visit payload (+ next_depth 1)
                      (emission_frame 3 0 previous)))
                  (if (eq kind 3)
                    (let close Int (write ')')
                      (emission_resume next_depth previous))
                    (fail)))))))))))
