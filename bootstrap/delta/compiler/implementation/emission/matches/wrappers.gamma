; Kind 0 binds the tag, kind 1 the complete sum, and kind 2 its payload.
(def emit_match_binding_prefix ((match_start Int) (kind Int)) Int
  (let opened Int (write '(')
    (let letter_l Int (write 'l')
      (let letter_e Int (write 'e')
        (let letter_t Int (write 't')
          (let separated Int (write '\s')
            (let name Int
              (if (eq kind 0)
                (emit_match_name match_start)
                (if (eq kind 1)
                  (emit_match_value_name match_start)
                  (emit_match_payload_name match_start)))
              (let before_type Int (write '\s')
                (let annotation Int (emit_int_word)
                  (write '\s'))))))))))

(def emit_match_unpack ((match_start Int)) Int
  (let tag_binding Int (emit_match_binding_prefix match_start 0)
    (let tag_projection Int (emit_first_prefix)
      (let tag_source Int (emit_match_value_name match_start)
        (let tag_close Int (write ')')
          (let separated Int (write '\s')
            (let payload_binding Int (emit_match_binding_prefix match_start 2)
              (let payload_projection Int (emit_second_prefix)
                (let payload_source Int (emit_match_value_name match_start)
                  (let payload_close Int (write ')')
                    (write '\s')))))))))))

(def emit_match_test ((match_start Int) (tag Int)) Int
  (let conditional Int (emit_if_prefix)
    (let opened Int (write '(')
      (let letter_e Int (write 'e')
        (let letter_q Int (write 'q')
          (let separated Int (write '\s')
            (let name Int (emit_match_name match_start)
              (let before_tag Int (write '\s')
                (let value Int (emit_decimal (- tag 1))
                  (let closed Int (write ')')
                    (write '\s')))))))))))
