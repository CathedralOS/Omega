(def emit_span ((index Int) (end Int)) Int
  (if (eq index end)
    0
    (let ignored Int (write (source_read index))
      (emit_span (+ index 1) end))))

; The readable emitted runtime is pinned verbatim in the staged compiler gate.
; Packed eight-byte writes keep this transformer small without making the
; generated helper closure an implicit host input.
(def emit_ascii ((packed Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let ignored Int (write (% packed 256))
      (emit_ascii (/ packed 256) (- remaining 1)))))

(def emit_application_marker () Int
  (let ignored0 Int (emit_ascii 8097793326564336680 8)
    (let ignored1 Int (emit_ascii 8028075772393122928 8)
      (let ignored2 Int (emit_ascii 8389723558316089454 8)
        (let ignored3 Int (emit_ascii 170471712 4)
          0)))))

(def emit_prefixed_function_name ((start Int) (end Int)) Int
  (let ignored0 Int (write '_')
    (let ignored1 Int (write '_')
      (let ignored2 Int (write 'd')
        (let ignored3 Int (write '_')
          (emit_span start end))))))

(def emit_function_name ((start Int) (end Int)) Int
  (if (if (token_main start end) (eq (compilation_profile) 0) 0)
    (emit_span start end)
    (emit_prefixed_function_name start end)))

(def emit_int_word () Int
  (let ignored0 Int (write 'I')
    (let ignored1 Int (write 'n')
      (write 't'))))

(def emit_decimal ((value Int)) Int
  (if (lt value 10)
    (write (+ 48 value))
    (let ignored Int (emit_decimal (/ value 10))
      (write (+ 48 (% value 10))))))

(def emit_match_name ((match_start Int)) Int
  (let ignored0 Int (write '$')
    (let ignored1 Int (write 'm')
      (emit_decimal match_start))))

(def emit_match_payload_name ((match_start Int)) Int
  (let ignored0 Int (write '$')
    (let ignored1 Int (write 'p')
      (emit_decimal match_start))))

(def emit_match_value_name ((match_start Int)) Int
  (let ignored0 Int (write '$')
    (let ignored1 Int (write 'v')
      (emit_decimal match_start))))

