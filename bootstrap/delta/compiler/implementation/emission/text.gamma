; Both modes return the running byte count. Count mode never writes.
(def emit_advance ((written Int) (amount Int)) Int
  (if (if (lt written 0) 1 (lt amount 0))
    (fail)
    (if (lt (- 9223372036854775807 written) amount)
      (fail)
      (+ written amount))))

(def emit_character ((byte Int) (publish Int) (written Int)) Int
  (if publish
    (let effect Int (write byte) (+ written 1))
    (emit_advance written 1)))

(def emit_span ((index Int) (end Int) (publish Int) (written Int)) Int
  (if publish
    (let effect Int (emit_span_bytes index end)
      (+ written (- end index)))
    (emit_advance written (- end index))))

(def emit_span_bytes ((index Int) (end Int)) Int
  (if (eq index end)
    0
    (let effect Int (write (source_read index))
      (emit_span_bytes (+ index 1) end))))

; The readable emitted runtime is pinned verbatim in the staged compiler gate.
; Packed eight-byte writes keep this transformer small without making the
; generated helper closure an implicit host input.
(def emit_ascii
  ((packed Int) (remaining Int) (publish Int) (written Int)) Int
  (if publish
    (let effect Int (emit_ascii_bytes packed remaining)
      (+ written remaining))
    (emit_advance written remaining)))

(def emit_ascii_bytes ((packed Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let effect Int (write (% packed 256))
      (emit_ascii_bytes (/ packed 256) (- remaining 1)))))

(def emit_application_marker ((publish Int) (written Int)) Int
  (let first_chunk Int (emit_ascii 8097793326564336680 8 publish written)
    (let second_chunk Int (emit_ascii 8028075772393122928 8 publish first_chunk)
      (let third_chunk Int (emit_ascii 8389723558316089454 8 publish second_chunk)
        (emit_ascii 170471712 4 publish third_chunk)))))

(def emit_prefixed_function_name
  ((start Int) (end Int) (publish Int) (written Int)) Int
  (let prefix Int (emit_ascii 1600413535 4 publish written)
    (emit_span start end publish prefix)))

(def emit_function_name
  ((start Int) (end Int) (publish Int) (written Int)) Int
  (if (if (token_main start end) (eq (compilation_profile) 0) 0)
    (emit_span start end publish written)
    (emit_prefixed_function_name start end publish written)))

(def emit_int_word ((publish Int) (written Int)) Int
  (emit_ascii 7630409 3 publish written))

(def emit_decimal ((value Int) (publish Int) (written Int)) Int
  (if (lt value 10)
    (emit_character (+ 48 value) publish written)
    (let prefix Int (emit_decimal (/ value 10) publish written)
      (emit_character (+ 48 (% value 10)) publish prefix))))

; Final-child chains retain a scalar suffix, not one pair per close.
(def emit_closes ((count Int) (publish Int) (written Int)) Int
  (if publish
    (let effect Int (emit_close_bytes count)
      (+ written count))
    (emit_advance written count)))

(def emit_close_bytes ((count Int)) Int
  (if (eq count 0)
    0
    (let effect Int (write ')')
      (emit_close_bytes (- count 1)))))
