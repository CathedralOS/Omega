(def emit_pair_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 'p')
      (let ignored2 Int (write 'a')
        (let ignored3 Int (write 'i')
          (let ignored4 Int (write 'r')
            (write '\s')))))))

(def emit_first_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 'f')
      (let ignored2 Int (write 'i')
        (let ignored3 Int (write 'r')
          (let ignored4 Int (write 's')
            (let ignored5 Int (write 't')
              (write '\s'))))))))

(def emit_second_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 's')
      (let ignored2 Int (write 'e')
        (let ignored3 Int (write 'c')
          (let ignored4 Int (write 'o')
            (let ignored5 Int (write 'n')
              (let ignored6 Int (write 'd')
                (write '\s')))))))))

(def emit_parameter ((name Int) (name_end Int)) Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (emit_span name name_end)
      (let ignored2 Int (write '\s')
        (let ignored3 Int (emit_int_word)
          (write ')'))))))
