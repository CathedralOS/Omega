(def emit_definition ((definition Int)) Int
  (let prefix Int (emit_ascii 139156874280 5)
    (let name Int (emit_gamma_atom (gamma_definition_name definition))
      (let separator Int (write '\s')
        (let open Int (write '(')
          (let parameters Int
            (emit_parameters (gamma_definition_parameter_count definition)
              (gamma_definition_parameters definition))
            (let close Int (write ')')
              (let result_space Int (write '\s')
                (let result_type Int (emit_int_word)
                  (let body_space Int (write '\s')
                    (let body Int
                      (emission_visit (gamma_definition_body definition) 0 0)
                      (write ')'))))))))))))

(def emit_parameters ((count Int) (parameters Int)) Int
  (if (eq count 0)
    0
    (let open Int (write '(')
      (let name Int (emit_gamma_atom (first parameters))
        (let separator Int (write '\s')
          (let annotation Int (emit_int_word)
            (let close Int (write ')')
              (if (eq count 1)
                0
                (let next_space Int (write '\s')
                  (emit_parameters (- count 1) (second parameters)))))))))))
