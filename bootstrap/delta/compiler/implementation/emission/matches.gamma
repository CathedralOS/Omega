; A checked match retains its subject and authored arm order. Subject and arm
; bodies enter the shared expression machine; no source subtree is reparsed.
(def emission_match ((node Int) (depth Int) (frames Int) (globals Int)) Int
  (let metadata Int (emission_match_metadata node globals)
    (let payload Int
      (type_metadata_has_payload (constructor_metadata_type metadata))
      (let prefix Int
        (emit_match_binding_prefix (syntax_start node) (if payload 1 0))
        (emission_visit (syntax_child node 1) (+ depth 1)
          (emission_frame 6 node frames) globals)))))

; Kind 6 has already been popped. One close frame owns the match's binding
; wrappers and every remaining authored-order conditional wrapper.
(def emission_match_subject_done
  ((node Int) (depth Int) (frames Int) (globals Int)) Int
  (let metadata Int (emission_match_metadata node globals)
    (let payload Int
      (type_metadata_has_payload (constructor_metadata_type metadata))
      (let separated Int (write '\s')
        (let unpacked Int
          (if payload (emit_match_unpack (syntax_start node)) 0)
          (let count Int (- (syntax_count node) 2)
            (emission_match_arms count
              (second (second (syntax_children node))) (syntax_start node)
              (+ depth 1)
              (emission_frame 2 (+ (- count 1) (if payload 3 1)) frames)
              globals)))))))

(def emission_match_constructor ((pattern Int)) Int
  (if (eq (syntax_count pattern) -1)
    pattern
    (syntax_child pattern 0)))

(def emission_match_metadata ((node Int) (globals Int)) Int
  (let constructor Int
    (emission_match_constructor (syntax_child (syntax_child node 2) 0))
    (require_constructor_metadata
      (syntax_start constructor) (syntax_after constructor) globals)))
