(def pattern_constructor ((pattern Int)) Int
  (if (eq (source_read pattern) 40)
    (skip (token_end pattern))
    pattern))

(def pattern_body ((pattern Int) (constructor_end Int) (arity Int)) Int
  (if (eq (source_read pattern) 40)
    (let after_pattern Int (pattern_after_binders constructor_end arity)
      (if (eq after_pattern 0)
        (fail)
        (skip after_pattern)))
    (if (eq arity 0)
      (skip constructor_end)
      (fail))))

(def pattern_after_binders ((index Int) (remaining Int)) Int
  (if (eq remaining 0)
    (let close Int (skip index)
      (if (eq (source_read close) 41)
        (token_end close)
        0))
    (let binder Int (skip index)
      (if (eq (source_read binder) 41)
        0
        (pattern_after_binders (token_end binder) (- remaining 1))))))

(def pattern_shape_valid ((pattern Int) (constructor_end Int) (arity Int)) Int
  (if (eq (source_read pattern) 40)
    (if (eq (pattern_after_binders constructor_end arity) 0) 0 1)
    (if (eq arity 0) 1 0)))

(def emit_second_prefixes ((remaining Int)) Int
