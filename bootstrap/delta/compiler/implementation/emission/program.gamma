; Publication consumes the complete expanded Gamma plan in declaration order.
(def emit_program ((program Int)) Int
  (emit_program_definitions (first program) (second program)))

(def emit_program_definitions ((count Int) (definitions Int)) Int
  (if (eq count 0)
    (if (eq (compilation_profile) 0)
      10
      (if (eq (compilation_profile) 1) (emit_conformance_adapter) (fail)))
    (let definition Int (emit_definition (first definitions))
      (let newline Int (write '\n')
        (emit_program_definitions (- count 1) (second definitions))))))
