; Only admitted atom spans reach source bytes. All expression structure and
; binding/function identity have already been selected by lowering.
(def emit_gamma_atom ((node Int)) Int
  (let kind Int (gamma_kind node)
    (let payload Int (gamma_payload node)
      (if (if (eq kind 1) 1 (eq kind 2))
        (emit_span (syntax_start payload) (syntax_after payload))
        (if (eq kind 3)
          (emit_function_name (syntax_start payload) (syntax_after payload))
          (if (eq kind 4)
            (let prefix Int (write '$')
              (let marker Int (write (first payload))
                (emit_decimal (second payload))))
            (if (eq kind 5)
              (emit_decimal payload)
              (if (eq kind 6)
                (emit_ascii (first payload) (second payload))
                (fail)))))))))
