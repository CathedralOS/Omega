; Common DCOUT V1 value: tag, space, code, coordinate, limit, requested.
; No output is written while deciding admission. Publication owns the frame.
(def compiler_complete ((value Int)) Int
  (pair 0 value))

(def compiler_source_rejection ((code Int) (coordinate Int)) Int
  (compiler_failure 1 1 code coordinate 0 0))

; Internal code 1: retained_frontend_contradiction. The caller supplies a
; nonnegative zero-based active continuation row, not a Gamma pair address.
(def compiler_retained_frontend_contradiction ((row Int)) Int
  (compiler_failure 3 3 1 row 0 0))

(def compiler_failure ((tag Int) (space Int) (code Int) (coordinate Int)
  (limit Int) (requested Int)) Int
  (pair tag (pair space (pair code (pair coordinate (pair limit requested))))))

(def write_unsigned_little_endian ((value Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let published Int (write (% value 256))
      (write_unsigned_little_endian (/ value 256) (- remaining 1)))))

(def publish_compiler_failure ((failure Int)) Int
  (let tag Int (first failure)
    (let fields Int (second failure)
      (let location Int (second (second fields))
        (let resource Int (second location)
          (let magic Int (write_unsigned_little_endian 374200355472639 8)
            (let outcome Int (write tag)
              (let space Int (write (first fields))
                (let reserved Int (write_unsigned_little_endian 0 2)
                  (let code Int (write_unsigned_little_endian
                    (first (second fields)) 4)
                    (let coordinate Int (write_unsigned_little_endian
                      (first location) 8)
                      (let limit Int (write_unsigned_little_endian
                        (first resource) 8)
                        (let requested Int (write_unsigned_little_endian
                          (second resource) 8)
                          (pair tag 1))))))))))))))
