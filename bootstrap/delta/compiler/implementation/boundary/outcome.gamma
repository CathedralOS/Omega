; Common DCOUT V1 value: tag, space, code, coordinate, limit, requested.
; No output is written while deciding admission. Publication owns the frame.
(def compiler_complete ((value Int)) Int
  (pair 0 value))

(def compiler_source_rejection ((code Int) (coordinate Int)) Int
  (compiler_failure 1 1 code coordinate 0 0))

; Internal code 1: retained_frontend_contradiction. The caller supplies a
; nonnegative zero-based active continuation row, not a Gamma pair address.
(def compiler_retained_frontend_contradiction ((row Int)) Int
  (compiler_failure 3 3 1 row 0 0))

; Internal code 2: emission_metadata_contradiction. Row zero is the singleton
; complete-program emission record, not a source offset or a corrupt node ID.
(def compiler_emission_metadata_contradiction () Int
  (compiler_failure 3 3 2 0 0 0))

(def compiler_failure ((tag Int) (space Int) (code Int) (coordinate Int)
  (limit Int) (requested Int)) Int
  (pair tag (pair space (pair code (pair coordinate (pair limit requested))))))

; The compiler and direct interpreter share these wire words and the DCOUT writer.
(def little_endian4 ((a Int) (b Int) (c Int) (d Int)) Int
  (+ (+ a (* 256 b)) (* 65536 (+ c (* 256 d)))))

(def little_endian8 ((a Int) (b Int) (c Int) (d Int)
                     (e Int) (f Int) (g Int) (h Int)) Int
  (+ (little_endian4 a b c d) (* 4294967296 (little_endian4 e f g h))))

(def write_unsigned_little_endian ((value Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let published Int (write (% value 256))
      (write_unsigned_little_endian (/ value 256) (- remaining 1)))))

(def publish_compiler_failure ((failure Int)) Int
  (let ((tag Int (first failure))
        (fields Int (second failure))
        (location Int (second (second fields)))
        (resource Int (second location))
        (magic Int (write_unsigned_little_endian
          (little_endian8 255 'D' 'C' 'O' 'U' 'T' 1 0) 8))
        (outcome Int (write tag))
        (space Int (write (first fields)))
        (reserved Int (write_unsigned_little_endian 0 2))
        (code Int (write_unsigned_little_endian
          (first (second fields)) 4))
        (coordinate Int (write_unsigned_little_endian
          (first location) 8))
        (limit Int (write_unsigned_little_endian
          (first resource) 8))
        (requested Int (write_unsigned_little_endian
          (second resource) 8)))
    (pair tag 1)))
