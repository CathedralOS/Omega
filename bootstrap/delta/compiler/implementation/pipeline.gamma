; Phase outcomes preserve owned failures; no emitter runs before full checking.
(def compile_admitted_source ((profile Int)) Int
  (let envelope Int (validate_source_envelope 0)
    (if (eq (first envelope) 0)
      (let collected Int
        (collect_global_identities 0 0 0
          (empty_name_trie) (empty_name_trie) (empty_name_trie))
        (if (eq (first collected) 0)
          (compile_collected_source profile (second collected))
          collected))
      envelope)))

(def compile_collected_source ((profile Int) (collected Int)) Int
  (let resolution Int
    (resolve_collected_declarations 0 collected (empty_name_trie))
    (if (eq (first resolution) 0)
      (let checked Int (second resolution)
        (let bodies Int (check_program_types 0 checked)
          (let schema Int (validate_application_profile profile checked)
            (if (eq (first schema) 0)
              (compiler_complete (emit_checked_program profile checked))
              schema))))
      resolution)))

(def emit_checked_program ((profile Int) (checked Int)) Int
  (let marker Int
    (if (eq profile 0) 0 (emit_application_marker))
    (let runtime Int
      (if (if (eq profile 1) 1 (source_uses_bytes_builtin 0))
        (emit_bytes_runtime)
        0)
      (let profile_runtime Int
        (if (eq profile 1) (emit_conformance_runtime) 0)
        (emit_program 0 checked)))))
