; Phase outcomes preserve owned failures; no emitter runs before full checking.
(def compile_admitted_source ((profile Int)) Int
  (let prepared Int (prepare_admitted_source profile)
    (if (eq (first prepared) 0)
      (let normalized Int (normalize_program (second prepared))
        (publish_checked_program profile normalized))
      prepared)))

(def prepare_admitted_source ((profile Int)) Int
  (let envelope Int (validate_source_envelope 0)
    (if (eq (first envelope) 0)
      (let tokens Int (validate_source_tokens 0)
        (if (eq (first tokens) 0)
          (let syntax Int (parse_source_syntax)
            (if (eq (first syntax) 0)
              (prepare_parsed_source profile (second syntax))
              syntax))
          tokens))
      envelope)))

(def prepare_parsed_source ((profile Int) (parsed Int)) Int
  (let grammar Int (validate_program_syntax (first parsed) (second parsed))
    (if (eq (first grammar) 0)
      (let collected Int (collect_global_identities (second grammar))
        (if (eq (first collected) 0)
          (prepare_collected_source profile (second grammar) (second collected))
          collected))
      grammar)))

(def prepare_collected_source
  ((profile Int) (program Int) (collected Int)) Int
  (let resolution Int
    (resolve_collected_declarations program collected)
    (if (eq (first resolution) 0)
      (let checked Int (second resolution)
        (let bodies Int (check_program_types program checked)
          (if (eq (first bodies) 0)
            (let schema Int (validate_application_profile profile checked)
              (if (eq (first schema) 0)
                (lower_program program checked)
                schema))
            bodies)))
      resolution)))

(def publish_checked_program ((profile Int) (program Int)) Int
  ; Both entries own the final LF: canonical main writes Complete's byte;
  ; the development transformer returns it through Gamma's scalar convention.
  (let requested Int (emit_advance (emit_checked_program profile program 0) 1)
    (if (lt requested 0)
      (compiler_emission_metadata_contradiction)
      (if (lt 16777212 requested)
        (compiler_failure 2 2 12 16777212 16777212 requested)
        (let published Int (+ (emit_checked_program profile program 1) 1)
          (if (eq published requested)
            (compiler_complete 10)
            (fail)))))))

(def emit_checked_program ((profile Int) (program Int) (publish Int)) Int
  (let marker Int
    (if (eq profile 0) 0 (emit_application_marker publish 0))
    (let runtime Int
      (if (if (eq profile 1) 1 (source_uses_bytes_builtin 0))
        (emit_bytes_runtime publish marker)
        marker)
      (let profile_runtime Int
        (if (eq profile 1) (emit_conformance_runtime publish runtime) runtime)
        (emit_program program publish profile_runtime)))))
