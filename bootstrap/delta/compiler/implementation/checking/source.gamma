(def fail () Int
  (read (input)))

; Gamma has literals for LF and space; HT is 9 and CR is 13.
(def source_byte_allowed ((byte Int)) Int
  (if (lt byte '\s')
    (if (eq byte 9) 1
      (if (eq byte '\n') 1 (eq byte 13)))
    (lt byte 127)))

(def validate_source_envelope ((index Int)) Int
  (if (eq index (source_length))
    (compiler_complete 0)
    (if (source_byte_allowed (source_read index))
      (validate_source_envelope (+ index 1))
      (compiler_source_rejection 3 index))))

(def is_space ((byte Int)) Int
  (lt byte 33))

(def skip_comment ((index Int)) Int
  (if (eq index (source_length))
    index
    (let byte Int (source_read index)
      (if (eq byte '\n')
        (+ index 1)
        (if (eq byte 13)
          (+ index 1)
          (skip_comment (+ index 1)))))))

(def skip ((index Int)) Int
  (if (eq index (source_length))
    index
    (let byte Int (source_read index)
      (if (is_space byte)
        (skip (+ index 1))
        (if (eq byte ';')
          (skip (skip_comment (+ index 1)))
          index)))))

(def token_end ((index Int)) Int
  (if (eq index (source_length))
    index
    (let byte Int (source_read index)
      (if (eq byte '(')
        (+ index 1)
        (if (eq byte ')')
          (+ index 1)
          (if (eq byte '"')
            (let after Int (byte_literal_scan (+ index 1))
              (if after after (source_length)))
            (token_word_end index)))))))

(def token_word_end ((index Int)) Int
  (if (eq index (source_length))
    index
    (let byte Int (source_read index)
      (if (is_space byte)
        index
        (if (eq byte '(')
          index
          (if (eq byte ')')
            index
            (if (eq byte ';')
              index
              (token_word_end (+ index 1)))))))))

; Callers check the token length before comparing its bytes.
(def source_chars2 ((at Int) (a Int) (b Int)) Int
  (if (eq (source_read at) a) (eq (source_read (+ at 1)) b) 0))

(def source_chars3 ((at Int) (a Int) (b Int) (c Int)) Int
  (if (eq (source_read at) a) (source_chars2 (+ at 1) b c) 0))

(def source_chars4 ((at Int) (a Int) (b Int) (c Int) (d Int)) Int
  (if (eq (source_read at) a) (source_chars3 (+ at 1) b c d) 0))

(def source_chars5 ((at Int) (a Int) (b Int) (c Int) (d Int) (e Int)) Int
  (if (eq (source_read at) a) (source_chars4 (+ at 1) b c d e) 0))

(def source_chars6 ((at Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int)) Int
  (if (eq (source_read at) a) (source_chars5 (+ at 1) b c d e f) 0))

(def token_data ((start Int) (end Int)) Int
  (if (eq (- end start) 4) (source_chars4 start 'd' 'a' 't' 'a') 0))

(def token_def ((start Int) (end Int)) Int
  (if (eq (- end start) 3) (source_chars3 start 'd' 'e' 'f') 0))

(def token_main ((start Int) (end Int)) Int
  (if (eq (- end start) 4) (source_chars4 start 'm' 'a' 'i' 'n') 0))

(def token_match ((start Int) (end Int)) Int
  (if (eq (- end start) 5) (source_chars5 start 'm' 'a' 't' 'c' 'h') 0))

(def token_let ((start Int) (end Int)) Int
  (if (eq (- end start) 3) (source_chars3 start 'l' 'e' 't') 0))

(def token_int ((start Int) (end Int)) Int
  (if (eq (- end start) 3) (source_chars3 start 'I' 'n' 't') 0))

(def token_if ((start Int) (end Int)) Int
  (if (eq (- end start) 2) (source_chars2 start 'i' 'f') 0))

(def token_eq ((start Int) (end Int)) Int
  (if (eq (- end start) 2) (source_chars2 start 'e' 'q') 0))

(def token_lt ((start Int) (end Int)) Int
  (if (eq (- end start) 2) (source_chars2 start 'l' 't') 0))

(def token_bytes ((start Int) (end Int)) Int
  (if (eq (- end start) 5) (source_chars5 start 'B' 'y' 't' 'e' 's') 0))

(def bytes_builtin_kind ((start Int) (end Int)) Int
  (let length Int (- end start)
    (if (lt length 9) 0
      (if (source_chars6 start 'b' 'y' 't' 'e' 's' '_')
        (bytes_suffix_kind (+ start 6) (- length 6)) 0))))

(def bytes_suffix_kind ((at Int) (length Int)) Int
  (if (eq length 3) (if (source_chars3 at 'g' 'e' 't') 4 0)
    (if (eq length 5) (if (source_chars5 at 'e' 'm' 'p' 't' 'y') 1 0)
      (if (eq length 6)
        (if (source_chars6 at 's' 'i' 'n' 'g' 'l' 'e') 2
          (if (source_chars6 at 'l' 'e' 'n' 'g' 't' 'h') 3
            (if (source_chars6 at 'c' 'o' 'n' 'c' 'a' 't') 5 0)))
        0))))

(def bytes_builtin_arity_plus_one ((start Int) (end Int)) Int
  (let kind Int (bytes_builtin_kind start end)
    (if (eq kind 1)
      1
      (if (eq kind 2)
        2
        (if (eq kind 3)
          2
          (if (eq kind 4)
            3
            (if (eq kind 5) 3 0)))))))

(def token_bytes_builtin ((start Int) (end Int)) Int
  (lt 0 (bytes_builtin_kind start end)))

(def source_uses_bytes_builtin ((index Int)) Int
  (let start Int (skip index)
    (if (eq start (source_length))
      0
      (let end Int (token_end start)
        (if (if (eq (source_read start) '"') 1 (token_bytes_builtin start end))
          1
          (source_uses_bytes_builtin end))))))

(def byte_between ((byte Int) (low Int) (high Int)) Int
  (if (lt byte low) 0 (if (lt high byte) 0 1)))

(def is_upper ((byte Int)) Int (byte_between byte 'A' 'Z'))
(def is_digit ((byte Int)) Int (byte_between byte '0' '9'))
(def is_lower ((byte Int)) Int (byte_between byte 'a' 'z'))

(def is_identifier_start ((byte Int)) Int
  (if (is_upper byte)
    1
    (if (is_lower byte) 1 (eq byte '_'))))

(def is_identifier_continue ((byte Int)) Int
  (if (is_identifier_start byte) 1 (is_digit byte)))

; Only lower/underscore name roles call this after lexical admission.
(def reserved_value_name ((start Int) (end Int)) Int
  (if (token_data start end) 1
    (if (token_def start end) 1
      (if (token_match start end) 1
        (if (token_let start end) 1
          (if (token_if start end) 1
            (if (token_eq start end) 1
              (if (token_lt start end) 1
                (token_bytes_builtin start end)))))))))

; These role checks consume complete tokens admitted by validate_source_tokens.
; Lexical admission alone validates identifier tails; roles check category and
; exact reserved spelling without scanning those same identifier bytes again.
(def value_name_valid ((start Int) (end Int)) Int
  (if (eq start end)
    0
    (let byte Int (source_read start)
      (if (if (is_lower byte) 1 (eq byte '_'))
        (if (reserved_value_name start end) 0 1)
        0))))

(def upper_name_valid ((start Int) (end Int)) Int
  (if (eq start end)
    0
    (if (is_upper (source_read start))
      (if (token_int start end) 0
        (if (token_bytes start end) 0 1))
      0)))

(def form_head ((form Int)) Int
  (skip (token_end form)))

(def form_head_end ((form Int)) Int
  (token_end (form_head form)))

(def field_type_shape_valid ((start Int) (end Int)) Int
  (if (eq start end) 0 (is_upper (source_read start))))
