; Entry existence is an option, not a declaration-collection requirement.
; Only an accepted ordinary frontend reaches this profile-specific phase.
(def find_main_metadata ((globals Int)) Int
  ; Little-endian bytes m a i n.
  (name_trie_find_packed_option (global_functions globals) 4 1852399981))

(def reject_entry_schema ((metadata Int)) Int
  (let declaration Int (- (function_metadata_owner metadata) 1)
    (let name Int (skip (form_head_end declaration))
      (compiler_source_rejection 20 name))))

(def validate_conformance_profile ((metadata Int)) Int
  (if (eq (function_metadata_arity metadata) 1)
    (if (eq (function_metadata_result_type metadata) (bytes_type))
      (if (eq (first (function_metadata_parameter_types metadata)) (bytes_type))
        (compiler_complete 0)
        (reject_entry_schema metadata))
      (reject_entry_schema metadata))
    (reject_entry_schema metadata)))

(def validate_application_profile ((profile Int) (globals Int)) Int
  (let entry Int (find_main_metadata globals)
    (if (eq (first entry) 0)
      (compiler_failure 1 0 19 0 0 0)
      (if (eq profile 0)
        (compiler_complete 0)
        (if (eq profile 1)
          (validate_conformance_profile (second entry))
          (fail))))))
