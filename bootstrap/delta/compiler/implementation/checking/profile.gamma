(def find_main_metadata ((index Int) (globals Int)) Int
  (let form Int (skip index)
    (if (eq form (source_length))
      (fail)
      (let head Int (form_head form)
        (let head_end Int (token_end head)
          (if (token_data head head_end)
            (find_main_metadata (skip_expression form) globals)
            (if (token_def head head_end)
              (let name Int (skip head_end)
                (let name_end Int (token_end name)
                  (if (token_main name name_end)
                    (require_function_metadata name name_end globals)
                    (find_main_metadata (skip_expression form) globals))))
              (fail))))))))

(def validate_conformance_profile ((globals Int)) Int
  (let metadata Int (find_main_metadata 0 globals)
    (if (eq (function_metadata_arity metadata) 1)
      (if (eq (function_metadata_result_type metadata) (bytes_type))
        (if (eq (first (function_metadata_parameter_types metadata))
                (bytes_type))
          0
          (fail))
        (fail))
      (fail))))

(def validate_application_profile ((profile Int) (globals Int)) Int
  (if (eq profile 0)
    0
    (if (eq profile 1)
      (validate_conformance_profile globals)
      (fail))))

