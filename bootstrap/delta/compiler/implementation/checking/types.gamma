; Negative types are exact builtins. Positive types are exact nominal
; declaration owners. Zero is reserved as an absent lookup or as the first-arm
; result sentinel.
(def int_type () Int
  -1)

(def bytes_type () Int
  -2)

(def resolve_type ((start Int) (end Int) (type_rows Int)) Int
  (if (token_int start end)
    (int_type)
    (if (token_bytes start end)
      (bytes_type)
      (if (upper_name_valid start end)
        (let found Int (name_trie_find_option type_rows end start)
          (if (first found)
            (type_metadata_owner (second found))
            (fail)))
        (fail)))))

(def typed_after ((typed Int)) Int
  (first typed))

(def typed_value ((typed Int)) Int
  (second typed))

; Local environments reuse the exact immutable name trie. Extending a scope
; returns a new root; sibling branches and match arms retain the outer root.
(def collect_pattern_locals
  ((binder_index Int) (field_index Int) (remaining Int) (locals Int)
   (type_rows Int)) Int
  (if (eq remaining 0)
    locals
    (let binder Int (skip binder_index)
      (let binder_end Int (token_end binder)
        (let field_type Int (skip field_index)
          (let field_end Int (token_end field_type)
            (let checked Int (require_value_name binder binder_end)
              (collect_pattern_locals
                binder_end field_end (- remaining 1)
                (name_trie_insert
                  locals binder_end binder
                  (resolve_type field_type field_end type_rows))
                type_rows))))))))

(def check_type_arguments
  ((index Int) (remaining Int) (expected Int)
   (globals Int) (locals Int)) Int
  (let next Int (skip index)
    (if (eq remaining 0)
      (if (eq (source_read next) 41)
        (token_end next)
        (fail))
      (if (eq (source_read next) 41)
        (fail)
        (let typed Int (check_type_expression next globals locals)
          (if (eq (typed_value typed) expected)
            (check_type_arguments
              (typed_after typed) (- remaining 1) expected globals locals)
            (fail)))))))

(def check_constructor_arguments
  ((index Int) (field_index Int) (remaining Int)
   (globals Int) (locals Int)) Int
  (let next Int (skip index)
    (if (eq remaining 0)
      (if (eq (source_read next) 41)
        (token_end next)
        (fail))
      (if (eq (source_read next) 41)
        (fail)
        (let field_type Int (skip field_index)
          (let field_end Int (token_end field_type)
            (let typed Int (check_type_expression next globals locals)
              (if (eq (typed_value typed)
                      (resolve_type
                        field_type field_end (global_types globals)))
                (check_constructor_arguments
                  (typed_after typed) field_end (- remaining 1)
                  globals locals)
                (fail)))))))))

(def check_function_arguments
  ((index Int) (parameter_types Int) (remaining Int)
   (globals Int) (locals Int)) Int
  (let next Int (skip index)
    (if (eq remaining 0)
      (if (eq (source_read next) 41)
        (token_end next)
        (fail))
      (if (eq (source_read next) 41)
        (fail)
        (let typed Int (check_type_expression next globals locals)
          (if (eq (typed_value typed) (first parameter_types))
              (check_function_arguments
              (typed_after typed) (second parameter_types) (- remaining 1)
              globals locals)
            (fail)))))))

; Lexical admission established every numeric token's spelling and range.
; A bare minus remains an operator token, not a valid expression atom.
(def check_type_atom ((start Int) (globals Int) (locals Int)) Int
  (let end Int (token_end start)
    (let first Int (source_read start)
      (if (is_upper first)
        (let metadata Int (require_constructor_metadata start end globals)
          (if (eq (constructor_metadata_arity metadata) 0)
            (pair end (constructor_metadata_owner metadata))
            (fail)))
        (if (is_digit first)
          (pair end (int_type))
          (if (eq first 45)
            (if (lt (+ start 1) end)
              (pair end (int_type))
              (fail))
            (if (value_name_valid start end)
              (let local_type Int (name_trie_find locals end start)
                (if local_type (pair end local_type) (fail)))
              (fail))))))))

(def check_type_if
  ((index Int) (globals Int) (locals Int)) Int
  (let condition Int (check_type_expression index globals locals)
    (if (eq (typed_value condition) (int_type))
      (let when_true Int
        (check_type_expression (skip (typed_after condition)) globals locals)
        (let when_false Int
          (check_type_expression (skip (typed_after when_true)) globals locals)
          (if (eq (typed_value when_true) (typed_value when_false))
            (let close Int (skip (typed_after when_false))
              (if (eq (source_read close) 41)
                (pair (token_end close) (typed_value when_true))
                (fail)))
            (fail))))
      (fail))))

(def check_type_let
  ((index Int) (globals Int) (locals Int)) Int
  (let name Int (skip index)
    (let name_end Int (token_end name)
      (let type_name Int (skip name_end)
        (let type_end Int (token_end type_name)
          (let checked Int
            (validate_local_declaration
              name name_end type_name type_end (global_types globals))
            (let declared_type Int
              (resolve_type type_name type_end (global_types globals))
              (let body_locals Int
                (name_trie_insert locals name_end name declared_type)
                (let initializer Int
                  (check_type_expression (skip type_end) globals locals)
                  (if (eq (typed_value initializer) declared_type)
                    (let body Int
                      (check_type_expression
                        (skip (typed_after initializer)) globals body_locals)
                      (let close Int (skip (typed_after body))
                        (if (eq (source_read close) 41)
                          (pair (token_end close) (typed_value body))
                          (fail))))
                    (fail)))))))))))

(def check_type_arms
  ((index Int) (owner Int) (globals Int) (locals Int) (arm_type Int)
   (seen Int) (arm_count Int)) Int
  (let arm Int (skip index)
    (if (eq (source_read arm) 40)
      (let pattern Int (skip (token_end arm))
        (let constructor Int (pattern_constructor pattern)
          (let constructor_end Int (token_end constructor)
            (let metadata Int
              (require_constructor_metadata constructor constructor_end globals)
              (let actual_owner Int (constructor_metadata_owner metadata)
              (let arity Int (constructor_metadata_arity metadata)
                (if (eq actual_owner owner)
                  (if (pattern_shape_valid pattern constructor_end arity)
                    (let next_seen Int
                      (name_trie_insert seen constructor_end constructor 1)
                      (let arm_locals Int
                        (if (eq arity 0)
                          locals
                          (collect_pattern_locals
                            (skip constructor_end)
                            (constructor_metadata_declaration_end metadata)
                            arity locals (global_types globals)))
                        (let body Int
                          (check_type_expression
                            (pattern_body pattern constructor_end arity)
                            globals arm_locals)
                          (let result_type Int
                            (if (eq arm_type 0)
                              (typed_value body)
                              (if (eq arm_type (typed_value body))
                                arm_type
                                (fail)))
                            (let arm_close Int (skip (typed_after body))
                              (if (eq (source_read arm_close) 41)
                                (let next Int (skip (token_end arm_close))
                                  (if (eq (source_read next) 41)
                                    (if (eq (+ arm_count 1)
                                            (type_metadata_constructor_count
                                              (constructor_metadata_type metadata)))
                                      (pair (token_end next) result_type)
                                      (fail))
                                    (check_type_arms
                                      next owner globals locals result_type
                                      next_seen (+ arm_count 1))))
                                (fail)))))))
                    (fail))
                  (fail))))))))
      (fail))))

(def check_type_match
  ((scrutinee Int) (globals Int) (locals Int)) Int
  (let typed Int (check_type_expression scrutinee globals locals)
    (if (lt 0 (typed_value typed))
      (check_type_arms
        (typed_after typed) (typed_value typed) globals locals 0
        (empty_name_trie) 0)
      (fail))))

(def check_type_call
  ((head Int) (head_end Int) (args Int) (globals Int) (locals Int)) Int
  (let metadata Int (require_function_metadata head head_end globals)
    (let after Int
      (check_function_arguments
        args (function_metadata_parameter_types metadata)
        (function_metadata_arity metadata) globals locals)
      (pair after (function_metadata_result_type metadata)))))

(def check_type_two_arguments
  ((index Int) (first_type Int) (second_type Int)
   (globals Int) (locals Int)) Int
  (let first_value Int (check_type_expression index globals locals)
    (if (eq (typed_value first_value) first_type)
      (let second_value Int
        (check_type_expression
          (skip (typed_after first_value)) globals locals)
        (if (eq (typed_value second_value) second_type)
          (let close Int (skip (typed_after second_value))
            (if (eq (source_read close) 41)
              (token_end close)
              (fail)))
          (fail)))
      (fail))))

(def check_type_bytes_builtin
  ((head Int) (head_end Int) (args Int) (globals Int) (locals Int)) Int
  (let kind Int (bytes_builtin_kind head head_end)
    (if (eq kind 1)
      (let after Int
        (check_type_arguments args 0 (bytes_type) globals locals)
        (pair after (bytes_type)))
      (if (eq kind 2)
        (let after Int
          (check_type_arguments args 1 (int_type) globals locals)
          (pair after (bytes_type)))
        (if (eq kind 3)
          (let after Int
            (check_type_arguments args 1 (bytes_type) globals locals)
            (pair after (int_type)))
          (if (eq kind 4)
            (let after Int
              (check_type_two_arguments
                args (bytes_type) (int_type) globals locals)
              (pair after (int_type)))
            (if (eq kind 5)
              (let after Int
                (check_type_arguments args 2 (bytes_type) globals locals)
                (pair after (bytes_type)))
              (fail))))))))

(def check_type_list
  ((open Int) (globals Int) (locals Int)) Int
  (let head Int (skip (token_end open))
    (let head_end Int (token_end head)
      (if (token_match head head_end)
        (check_type_match (skip head_end) globals locals)
        (if (token_let head head_end)
          (check_type_let (skip head_end) globals locals)
          (if (token_if head head_end)
            (check_type_if (skip head_end) globals locals)
            (if (is_upper (source_read head))
              (let metadata Int
                (require_constructor_metadata head head_end globals)
                (let arity Int (constructor_metadata_arity metadata)
                  (let after Int
                    (check_constructor_arguments
                      (skip head_end)
                      (constructor_metadata_declaration_end metadata)
                      arity globals locals)
                    (pair after (constructor_metadata_owner metadata)))))
              (if (token_bytes_builtin head head_end)
                (check_type_bytes_builtin
                  head head_end (skip head_end) globals locals)
                (if (token_eq head head_end)
                  (let after Int
                    (check_type_arguments
                      (skip head_end) 2 (int_type) globals locals)
                    (pair after (int_type)))
                  (if (token_lt head head_end)
                    (let after Int
                      (check_type_arguments
                        (skip head_end) 2 (int_type) globals locals)
                      (pair after (int_type)))
                    (if (operator_arity_plus_one head head_end)
                      (let after Int
                        (check_type_arguments
                          (skip head_end) 2 (int_type) globals locals)
                        (pair after (int_type)))
                      (if (value_name_valid head head_end)
                        (check_type_call
                          head head_end (skip head_end) globals locals)
                        (fail)))))))))))))

(def check_type_expression
  ((index Int) (globals Int) (locals Int)) Int
  (let start Int (skip index)
    (if (eq (source_read start) 40)
      (check_type_list start globals locals)
      (check_type_atom start globals locals))))

(def check_definition_type ((form Int) (globals Int)) Int
  (let head Int (form_head form)
    (let name Int (skip (token_end head))
      (let name_end Int (token_end name)
        (let metadata Int
          (require_function_metadata name name_end globals)
          (let body Int
            (check_type_expression
              (function_metadata_body_start metadata) globals
              (function_metadata_parameter_locals metadata))
            (if (eq (typed_value body)
                    (function_metadata_result_type metadata))
              (let close Int (skip (typed_after body))
                (if (eq (source_read close) 41)
                  (token_end close)
                  (fail)))
              (fail))))))))

; Reuse the parsed declaration order and exact boundaries. Expression typing
; still consumes checked source coordinates while its node migration proceeds.
(def check_program_types ((program Int) (globals Int)) Int
  (check_program_nodes (first program) (second program) globals))

(def check_program_nodes ((count Int) (forms Int) (globals Int)) Int
  (if (eq count 0)
    0
    (let form Int (first forms)
      (let head Int (syntax_child form 0)
        (if (token_data (syntax_start head) (syntax_after head))
          (check_program_nodes (- count 1) (second forms) globals)
          (let after Int (check_definition_type (syntax_start form) globals)
            (if (eq after (syntax_after form))
              (check_program_nodes (- count 1) (second forms) globals)
              (fail))))))))
