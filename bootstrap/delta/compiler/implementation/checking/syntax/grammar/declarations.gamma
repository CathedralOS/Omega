(def grammar_program
  ((program Int) (count Int) (forms Int) (saw_function Int)) Int
  (if (eq count 0)
    (if saw_function
      (compiler_complete program)
      (compiler_source_rejection 4 (source_length)))
    (let node Int (first forms)
      (let shape Int (grammar_minimum_count node 1)
        (if (eq shape -1)
          (let head Int (first (syntax_children node))
            (if (eq (syntax_count head) -1)
              (grammar_declaration program count forms saw_function node head)
              (grammar_reject head)))
          (compiler_source_rejection 4 shape))))))

(def grammar_declaration
  ((program Int) (count Int) (forms Int) (saw_function Int)
   (node Int) (head Int)) Int
  (let start Int (syntax_start head)
    (let after Int (syntax_after head)
      (if (token_data start after)
        (if saw_function
          (grammar_reject node)
          (grammar_finish_declaration program count forms 0
            (grammar_data node)))
        (if (token_def start after)
          (grammar_finish_declaration program count forms 1
            (grammar_function node))
          (grammar_reject head))))))

; A single declaration-level continuation consumes the final grammar outcome.
; Nested roles never retain a Gamma return context per syntax node.
(def grammar_finish_declaration
  ((program Int) (count Int) (forms Int) (saw_function Int)
   (checked Int)) Int
  (if (eq (first checked) 0)
    (grammar_program program (- count 1) (second forms) saw_function)
    checked))

(def grammar_data ((node Int)) Int
  (let shape Int (grammar_minimum_count node 3)
    (if (eq shape -1)
      (let tail Int (second (syntax_children node))
        (grammar_atom_role 3 (first tail) 1
          (grammar_pending 7 0 (- (syntax_count node) 2) (second tail) 0)))
      (compiler_source_rejection 4 shape))))

(def grammar_function ((node Int)) Int
  (let shape Int (grammar_exact_count node 5)
    (if (eq shape -1)
      (let tail Int (second (syntax_children node))
        (grammar_atom_role 2 (first tail) 3
          (grammar_pending 5 0 1 (second tail)
            (grammar_pending 4 0 1 (second (second tail))
              (grammar_pending 1 1 1 (second (second (second tail))) 0)))))
      (compiler_source_rejection 4 shape))))

(def grammar_parameters ((node Int) (count Int) (work Int)) Int
  (let shape Int (grammar_minimum_count node 0)
    (if (eq shape -1)
      (grammar_sequence 6 (syntax_count node) (syntax_children node) 0 count work)
      (compiler_source_rejection 4 shape))))

(def grammar_parameter ((node Int) (count Int) (work Int)) Int
  (let shape Int (grammar_exact_count node 2)
    (if (eq shape -1)
      (let children Int (syntax_children node)
        (grammar_atom_role 2 (first children) (+ count 1)
          (grammar_pending 4 0 1 (second children) work)))
      (compiler_source_rejection 4 shape))))

(def grammar_constructor ((node Int) (count Int) (work Int)) Int
  (let shape Int (grammar_minimum_count node 1)
    (if (eq shape -1)
      (let children Int (syntax_children node)
        (if (eq (syntax_count node) 1)
          (grammar_atom_role 3 (first children) count work)
          (grammar_atom_role 3 (first children) (+ count 1)
            (grammar_pending 4 0 (- (syntax_count node) 1)
              (second children) work))))
      (compiler_source_rejection 4 shape))))
