; Grammar has accepted the complete counted syntax program. This phase owns
; global identity only; it resolves no declaration type or expression. Its
; three private cursors become ordinary global tries only after completion.
(def collect_global_identities ((program Int)) Int
  (collect_global_nodes (first program) (second program)
    (pair (empty_identity_cursor)
      (pair (empty_identity_cursor) (empty_identity_cursor))) 0 0 2))

(def collect_global_nodes
  ((remaining Int) (forms Int) (globals Int) (function_count Int)
   (constructor_count Int) (type_count Int)) Int
  (if (eq remaining 0)
    (compiler_complete
      (pair (identity_cursor_finish (global_types globals))
        (pair (identity_cursor_finish (global_constructors globals))
          (identity_cursor_finish (global_functions globals)))))
    (let form Int (first forms)
      (let head Int (syntax_child form 0)
        (let is_data Int (token_data (syntax_start head) (syntax_after head))
          (let collected Int
            (if is_data
              (collect_data_identity form globals constructor_count type_count)
              (collect_function_identity form globals function_count))
            (if (eq (first collected) 0)
              (collect_global_nodes
                (- remaining 1) (second forms) (second collected)
                (if is_data function_count (+ function_count 1))
                (if is_data (+ constructor_count (- (syntax_count form) 2))
                  constructor_count)
                (if is_data (+ type_count 1) type_count))
              collected)))))))

(def count_constructor_payloads
  ((remaining Int) (constructors Int) (total Int)) Int
  (if (eq remaining 0)
    total
    (count_constructor_payloads
      (- remaining 1) (second constructors)
      (+ total (- (syntax_count (first constructors)) 1)))))

; Total type rows include Int and Bytes, whose identities are not trie rows.
; A fresh nominal provisions its row before metadata or constructor collection.
(def collect_data_identity
  ((form Int) (globals Int) (constructor_count Int) (type_count Int)) Int
  (let name Int (syntax_child form 1)
    (let start Int (syntax_start name)
      (let after Int (syntax_after name)
        (let cursor Int (identity_cursor_seek (global_types globals) start after)
          (if (identity_cursor_present cursor after)
            (compiler_source_rejection 6 start)
            (if (lt type_count 65536)
              (let count Int (- (syntax_count form) 2)
                (let constructors Int (syntax_drop_children (syntax_children form) 2)
                  (let metadata Int
                    (pair (+ (syntax_start form) 1)
                      (pair count (count_constructor_payloads count constructors 0)))
                    (let collected Int
                      (collect_constructor_identities count constructors metadata
                        (global_constructors globals) 1 constructor_count)
                      (if (eq (first collected) 0)
                        (compiler_complete
                          (pair
                            (identity_cursor_commit cursor after metadata)
                            (pair (second collected) (global_functions globals))))
                        collected)))))
              (compiler_failure 2 1 2 start 65536 (+ type_count 1)))))))))

; D30 counts fresh authored constructors globally, not per data declaration.
; Duplicate lookup precedes provision; a refused row allocates no metadata.
(def collect_constructor_identities
  ((remaining Int) (constructors Int) (type_metadata Int)
   (constructor_rows Int) (tag Int) (constructor_count Int)) Int
  (if (eq remaining 0)
    (compiler_complete constructor_rows)
    (let constructor Int (first constructors)
      (let name Int (syntax_child constructor 0)
        (let start Int (syntax_start name)
          (let after Int (syntax_after name)
            (let cursor Int (identity_cursor_seek constructor_rows start after)
              (if (identity_cursor_present cursor after)
                (compiler_source_rejection 7 start)
                (if (lt constructor_count 65536)
                  (let metadata Int
                    (pair type_metadata
                      (pair tag
                        (pair (- (syntax_count constructor) 1) (pair after 0))))
                    (collect_constructor_identities
                      (- remaining 1) (second constructors) type_metadata
                      (identity_cursor_commit cursor after metadata)
                      (+ tag 1) (+ constructor_count 1)))
                  (compiler_failure 2 1 3 start 65536
                    (+ constructor_count 1)))))))))))

; The raw row retains its exact function node instead of a rescanned body end.
; Typed metadata is constructed only after the whole global census succeeds.
; D30 counts authored function rows, not resolved copies or generated helpers.
; Duplicate lookup precedes provision: only a new identity requests a new row.
(def collect_function_identity
  ((form Int) (globals Int) (function_count Int)) Int
  (let name Int (syntax_child form 1)
    (let start Int (syntax_start name)
      (let after Int (syntax_after name)
        (let cursor Int
          (identity_cursor_seek (global_functions globals) start after)
          (if (identity_cursor_present cursor after)
            (compiler_source_rejection 8 start)
            (if (lt function_count 32768)
              (compiler_complete
                (pair (global_types globals)
                  (pair (global_constructors globals)
                    (identity_cursor_commit cursor after
                      (pair (+ (syntax_start form) 1) (pair after form))))))
              (compiler_failure 2 1 4 start 32768 (+ function_count 1)))))))))
