(def require_constructor_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (let found Int
    (name_trie_find_option (global_constructors globals) name_end name)
    (if (first found) (second found) (fail))))

(def catalog_function_parameters
  ((index Int) (locals Int) (type_rows Int) (count Int)
   (reversed_types Int)) Int
  (let item Int (skip index)
    (if (eq (source_read item) 41)
      (pair (token_end item)
        (pair count (pair reversed_types locals)))
      (if (eq (source_read item) 40)
        (let name Int (skip (token_end item))
          (let name_end Int (token_end name)
            (let type_name Int (skip name_end)
              (let type_end Int (token_end type_name)
                (let close Int (skip type_end)
                  (if (eq (source_read close) 41)
                    (let checked Int
                      (validate_local_declaration
                        name name_end type_name type_end type_rows)
                      (let declared_type Int
                        (resolve_type type_name type_end type_rows)
                        (catalog_function_parameters
                          (token_end close)
                          (name_trie_insert
                            locals name_end name declared_type)
                          type_rows (+ count 1)
                          (parameter_types_prepend
                            declared_type reversed_types))))
                    (fail)))))))
        (fail)))))

(def catalog_function_signature
  ((form Int) (name_end Int) (type_rows Int)) Int
  (let open Int (skip name_end)
    (if (eq (source_read open) 40)
      (let parameters Int
        (catalog_function_parameters
          (token_end open) (empty_name_trie) type_rows 0
          (empty_parameter_types))
        (let details Int (second parameters)
          (let tail Int (second details)
            (let result_name Int (skip (first parameters))
              (let result_end Int (token_end result_name)
                (let result_type Int
                  (resolve_type result_name result_end type_rows)
                  (pair (+ form 1)
                    (pair (first details)
                      (pair result_type
                        (pair
                          (reverse_parameter_types
                            (first tail) (first details)
                            (empty_parameter_types))
                          (pair (second tail) (skip result_end))))))))))))
      (fail))))

(def resolve_collected_data ((form Int) (globals Int)) Int
  (let head Int (form_head form)
    (let type_name Int (skip (token_end head))
      (let type_end Int (token_end type_name)
        (let found Int
          (name_trie_find_option (global_types globals) type_end type_name)
          (if (first found)
            (if (eq (type_metadata_owner (second found)) (+ form 1))
              (resolve_collected_constructors
                (skip type_end) (second found) globals 0)
              (fail))
            (fail)))))))

; Collection established exact owner, tag, arity, and declaration custody.
; Only this phase resolves payload type spellings against all collected types.
(def resolve_collected_constructors
  ((index Int) (type_metadata Int) (globals Int) (count Int)) Int
  (let item Int (skip index)
    (if (eq (source_read item) 41)
      (if (eq count (type_metadata_constructor_count type_metadata))
        (token_end item)
        (fail))
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (let metadata Int
            (require_constructor_metadata constructor constructor_end globals)
            (if (eq (constructor_metadata_owner metadata)
                    (type_metadata_owner type_metadata))
              (if (eq (constructor_metadata_tag metadata) (+ count 1))
                (if (eq (constructor_metadata_declaration_end metadata) constructor_end)
                  (let arity Int
                    (constructor_arity_at constructor_end (global_types globals))
                    (if (eq arity (constructor_metadata_arity metadata))
                      (resolve_collected_constructors
                        (constructor_after constructor_end (global_types globals))
                        type_metadata globals (+ count 1))
                      (fail)))
                  (fail))
                (fail))
              (fail))))))))

; Raw rows retain (pair declaration-owner (pair name-end after-form)).
; Validate declaration custody, then return the census boundary beside the
; resolved signature; declaration resolution never rescans a function body.
(def resolve_collected_function ((form Int) (globals Int)) Int
  (let name Int (skip (token_end (form_head form)))
    (let name_end Int (token_end name)
      (let found Int (find_function_metadata name name_end globals)
        (if (first found)
          (let raw Int (second found)
            (if (eq (first raw) (+ form 1))
              (if (eq (first (second raw)) name_end)
                (pair (second (second raw))
                  (catalog_function_signature
                    (- (first raw) 1) (first (second raw))
                    (global_types globals)))
                (fail))
              (fail)))
          (fail))))))

(def resolve_collected_declarations
  ((index Int) (collected_globals Int) (resolved_function_rows Int)) Int
  (let form Int (skip index)
    (if (eq form (source_length))
      (compiler_complete
        (pair (global_types collected_globals)
          (pair (global_constructors collected_globals) resolved_function_rows)))
      (let head Int (form_head form)
        (let head_end Int (token_end head)
          (if (token_data head head_end)
            (resolve_collected_declarations
              (resolve_collected_data form collected_globals)
              collected_globals resolved_function_rows)
            (if (token_def head head_end)
              (let name Int (skip head_end)
                (let name_end Int (token_end name)
                  (let resolved Int
                    (resolve_collected_function form collected_globals)
                    (resolve_collected_declarations
                      (first resolved) collected_globals
                      (name_trie_insert resolved_function_rows name_end name
                        (second resolved))))))
              (fail))))))))
