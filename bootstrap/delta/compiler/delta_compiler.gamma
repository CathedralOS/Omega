                          (let ignored7 Int
                            (if (eq byte 42)
                              (emit_multiply_guard open)
                              (emit_add_sub_guard open (eq byte 45)))
                            (let ignored8 Int (write ')')
                              (let ignored9 Int (write ')')
                                (let ignored10 Int (write ')')
                                  (token_end close))))))))))
                (fail)))))))))

(def emit_pair_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 'p')
      (let ignored2 Int (write 'a')
        (let ignored3 Int (write 'i')
          (let ignored4 Int (write 'r')
            (write '\s')))))))

(def emit_first_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 'f')
      (let ignored2 Int (write 'i')
        (let ignored3 Int (write 'r')
          (let ignored4 Int (write 's')
            (let ignored5 Int (write 't')
              (write '\s'))))))))

(def emit_second_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 's')
      (let ignored2 Int (write 'e')
        (let ignored3 Int (write 'c')
          (let ignored4 Int (write 'o')
            (let ignored5 Int (write 'n')
              (let ignored6 Int (write 'd')
                (write '\s')))))))))

(def emit_tag_name ((name Int) (name_end Int)) Int
  (let ignored0 Int (emit_span name name_end)
    (let ignored1 Int (write '_')
      (let ignored2 Int (write '_')
        (let ignored3 Int (write 't')
          (let ignored4 Int (write 'a')
            (write 'g')))))))

(def emit_field_name ((name Int) (name_end Int)) Int
  (let ignored0 Int (emit_span name name_end)
    (let ignored1 Int (write '_')
      (let ignored2 Int (write '_')
        (let ignored3 Int (write 'f')
          (let ignored4 Int (write 'i')
            (let ignored5 Int (write 'e')
              (let ignored6 Int (write 'l')
                (let ignored7 Int (write 'd')
                  (write '0'))))))))))

(def emit_parameter ((name Int) (name_end Int)) Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (emit_span name name_end)
      (let ignored2 Int (write '\s')
        (let ignored3 Int (emit_int_word)
          (write ')'))))))

(def emit_payload_parameters ((name Int) (name_end Int)) Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (emit_tag_name name name_end)
      (let ignored2 Int (write '\s')
        (let ignored3 Int (emit_int_word)
          (let ignored4 Int (write ')')
            (let ignored5 Int (write '\s')
              (let ignored6 Int (write '(')
                (let ignored7 Int (emit_field_name name name_end)
                  (let ignored8 Int (write '\s')
                    (let ignored9 Int (emit_int_word)
                      (write ')'))))))))))))

; A name trie option is (pair present node). Each node is
; (pair terminal-option children), and each terminal option is
; (pair present payload). Children are an immutable list of present byte edges;
; absent bytes allocate no tree. Exact byte comparison means duplicate
; detection has no hash collision and name recursion advances once per byte.
(def empty_name_trie () Int
  (pair 0 0))

(def empty_name_children () Int
  (pair 0 0))

; A child row is (pair byte (pair child rest)). The outer option keeps empty
; distinct from a pair reference without using pair provenance in a condition.
(def name_child ((children Int) (byte Int)) Int
  (if (eq (first children) 0)
    (empty_name_trie)
    (let row Int (second children)
      (let child_and_rest Int (second row)
        (if (eq (first row) byte)
          (first child_and_rest)
          (name_child (second child_and_rest) byte))))))

(def name_children_prepend
  ((children Int) (byte Int) (child Int)) Int
  (pair 1 (pair byte (pair child children))))

(def name_children_replace
  ((children Int) (byte Int) (child Int)) Int
  (if (eq (first children) 0)
    (fail)
    (let row Int (second children)
      (let stored_byte Int (first row)
        (let child_and_rest Int (second row)
          (if (eq stored_byte byte)
            (pair 1 (pair stored_byte (pair child (second child_and_rest))))
            (pair 1
              (pair stored_byte
                (pair (first child_and_rest)
                  (name_children_replace
                    (second child_and_rest) byte child))))))))))

(def name_trie_new_path ((end Int) (index Int) (payload Int)) Int
  (if (eq index end)
    (pair 1 (pair (pair 1 payload) (empty_name_children)))
    (let child Int (name_trie_new_path end (+ index 1) payload)
      (let children Int
        (name_children_prepend (empty_name_children) (source_read index) child)
        (pair 1 (pair (pair 0 0) children))))))

(def name_trie_insert
  ((trie Int) (end Int) (index Int) (payload Int)) Int
  (if (eq (first trie) 0)
    (name_trie_new_path end index payload)
    (let node Int (second trie)
      (let terminal Int (first node)
        (let children Int (second node)
          (if (eq index end)
            (if (first terminal)
              (fail)
              (pair 1 (pair (pair 1 payload) children)))
            (let byte Int (source_read index)
              (let child Int (name_child children byte)
                (let next_child Int
                  (name_trie_insert child end (+ index 1) payload)
                  (let next_children Int
                    (if (first child)
                      (name_children_replace children byte next_child)
                      (name_children_prepend children byte next_child))
                    (pair 1 (pair terminal next_children))))))))))))

(def name_trie_find_option ((trie Int) (end Int) (index Int)) Int
  (if (eq (first trie) 0)
    (pair 0 0)
    (let node Int (second trie)
      (if (eq index end)
        (first node)
        (name_trie_find_option
          (name_child (second node) (source_read index))
          end (+ index 1))))))

(def name_trie_find ((trie Int) (end Int) (index Int)) Int
  (let result Int (name_trie_find_option trie end index)
    (if (first result) (second result) 0)))

; Type metadata is (pair owner (pair constructor-count has-payload)).
; Constructor metadata is
; (pair type-metadata (pair tag-plus-one (pair arity declaration-end))).
(def type_metadata_owner ((metadata Int)) Int
  (first metadata))

(def type_metadata_constructor_count ((metadata Int)) Int
  (first (second metadata)))

(def type_metadata_has_payload ((metadata Int)) Int
  (second (second metadata)))

(def constructor_metadata_type ((metadata Int)) Int
  (first metadata))

(def constructor_metadata_owner ((metadata Int)) Int
  (type_metadata_owner (constructor_metadata_type metadata)))

(def constructor_metadata_tag ((metadata Int)) Int
  (first (second metadata)))

(def constructor_metadata_arity ((metadata Int)) Int
  (first (second (second metadata))))

(def constructor_metadata_declaration_end ((metadata Int)) Int
  (second (second (second metadata))))

(def global_types ((globals Int)) Int
  (first globals))

(def global_constructors ((globals Int)) Int
  (first (second globals)))

(def global_functions ((globals Int)) Int
  (second (second globals)))

; Parameter types form a raw right-nested pair list. Cached arity governs every
; traversal, so no condition or comparison observes the pair reference.
; Function metadata is
; (pair owner (pair arity (pair result-type
;   (pair parameter-types (pair parameter-locals body-start))))).
(def empty_parameter_types () Int
  0)

(def parameter_types_prepend ((type Int) (rest Int)) Int
  (pair type rest))

(def reverse_parameter_types
  ((input Int) (remaining Int) (output Int)) Int
  (if (eq remaining 0)
    output
    (reverse_parameter_types
      (second input) (- remaining 1)
      (parameter_types_prepend (first input) output))))

(def function_metadata_owner ((metadata Int)) Int
  (first metadata))

(def function_metadata_arity ((metadata Int)) Int
  (first (second metadata)))

(def function_metadata_result_type ((metadata Int)) Int
  (first (second (second metadata))))

(def function_metadata_parameter_types ((metadata Int)) Int
  (first (second (second (second metadata)))))

(def function_metadata_parameter_locals ((metadata Int)) Int
  (first (second (second (second (second metadata))))))

(def function_metadata_body_start ((metadata Int)) Int
  (second (second (second (second (second metadata))))))

(def find_function_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (name_trie_find_option (global_functions globals) name_end name))

(def require_function_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (let found Int (find_function_metadata name name_end globals)
    (if (first found) (second found) (fail))))

(def find_main_metadata ((index Int) (globals Int)) Int
  (let form Int (skip index)
    (if (eq form (source_length))
      (fail)
      (let head Int (form_head form)
        (let head_end Int (token_end head)
          (if (token_data head head_end)
            (find_main_metadata (skip_expression form) globals)
            (if (token_def head head_end)
              (let name Int (skip head_end)
                (let name_end Int (token_end name)
                  (if (token_main name name_end)
                    (require_function_metadata name name_end globals)
                    (find_main_metadata (skip_expression form) globals))))
              (fail))))))))

(def validate_conformance_profile ((globals Int)) Int
  (let metadata Int (find_main_metadata 0 globals)
    (if (eq (function_metadata_arity metadata) 1)
      (if (eq (function_metadata_result_type metadata) (bytes_type))
        (if (eq (first (function_metadata_parameter_types metadata))
                (bytes_type))
          0
          (fail))
        (fail))
      (fail))))

(def validate_application_profile ((profile Int) (globals Int)) Int
  (if (eq profile 0)
    0
    (if (eq profile 1)
      (validate_conformance_profile globals)
      (fail))))

(def require_constructor_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (let found Int
    (name_trie_find_option (global_constructors globals) name_end name)
    (if (first found) (second found) (fail))))

(def catalog_type_constructors
  ((index Int) (count Int) (has_payload Int)) Int
  (let item Int (skip index)
    (if (eq (source_read item) 41)
      (if (eq count 0)
        (fail)
        (pair (token_end item) (pair count has_payload)))
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (if (upper_name_valid constructor constructor_end)
            (let arity Int (constructor_shape_arity_at constructor_end)
              (catalog_type_constructors
                (constructor_shape_after constructor_end)
                (+ count 1) (+ has_payload arity)))
            (fail)))))))

(def catalog_global_data ((form Int) (type_rows Int)) Int
  (let head Int (form_head form)
    (let type_name Int (skip (token_end head))
      (let type_end Int (token_end type_name)
        (if (upper_name_valid type_name type_end)
          (let result Int
            (catalog_type_constructors (skip type_end) 0 0)
            (let summary Int (second result)
              (let metadata Int
                (pair (+ form 1) (pair (first summary) (second summary)))
                (pair (first result)
                  (name_trie_insert
                    type_rows type_end type_name metadata)))))
          (fail))))))

(def catalog_global_types
  ((index Int) (type_rows Int)) Int
  (let form Int (skip index)
    (if (eq form (source_length))
      type_rows
      (if (eq (source_read form) 40)
        (let head Int (form_head form)
          (let head_end Int (token_end head)
            (if (token_data head head_end)
              (let result Int (catalog_global_data form type_rows)
                (catalog_global_types (first result) (second result)))
              (if (token_def head head_end)
                type_rows
                (fail)))))
        (fail)))))

(def catalog_function_parameters
  ((index Int) (locals Int) (type_rows Int) (count Int)
   (reversed_types Int)) Int
  (let item Int (skip index)
    (if (eq (source_read item) 41)
      (pair (token_end item)
        (pair count (pair reversed_types locals)))
      (if (eq (source_read item) 40)
        (let name Int (skip (token_end item))
          (let name_end Int (token_end name)
            (let type_name Int (skip name_end)
              (let type_end Int (token_end type_name)
                (let close Int (skip type_end)
                  (if (eq (source_read close) 41)
                    (let checked Int
                      (validate_local_declaration
                        name name_end type_name type_end type_rows)
                      (let declared_type Int
                        (resolve_type type_name type_end type_rows)
                        (catalog_function_parameters
                          (token_end close)
                          (name_trie_insert
                            locals name_end name declared_type)
                          type_rows (+ count 1)
                          (parameter_types_prepend
                            declared_type reversed_types))))
                    (fail)))))))
        (fail)))))

(def catalog_function_signature
  ((form Int) (name_end Int) (type_rows Int)) Int
  (let open Int (skip name_end)
    (if (eq (source_read open) 40)
      (let parameters Int
        (catalog_function_parameters
          (token_end open) (empty_name_trie) type_rows 0
          (empty_parameter_types))
        (let details Int (second parameters)
          (let tail Int (second details)
            (let result_name Int (skip (first parameters))
              (let result_end Int (token_end result_name)
                (let result_type Int
                  (resolve_type result_name result_end type_rows)
                  (pair (+ form 1)
                    (pair (first details)
                      (pair result_type
                        (pair
                          (reverse_parameter_types
                            (first tail) (first details)
                            (empty_parameter_types))
                          (pair (second tail) (skip result_end))))))))))))
      (fail))))

(def validate_global_data
  ((form Int) (type_rows Int) (constructor_rows Int)) Int
  (let head Int (form_head form)
    (let type_name Int (skip (token_end head))
      (let type_end Int (token_end type_name)
        (let found Int (name_trie_find_option type_rows type_end type_name)
          (if (first found)
            (validate_global_constructors
              (skip type_end) (second found) type_rows constructor_rows 0)
            (fail)))))))

(def validate_global_constructors
  ((index Int) (type_metadata Int) (type_rows Int)
   (constructor_rows Int) (count Int)) Int
  (let item Int (skip index)
    (if (eq (source_read item) 41)
      (if (eq count (type_metadata_constructor_count type_metadata))
        (pair (token_end item) constructor_rows)
        (fail))
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (if (upper_name_valid constructor constructor_end)
            (let arity Int
              (constructor_arity_at constructor_end type_rows)
              (let metadata Int
                (pair type_metadata
                  (pair (+ count 1) (pair arity constructor_end)))
                (validate_global_constructors
                  (constructor_after constructor_end type_rows)
                  type_metadata type_rows
                  (name_trie_insert
                    constructor_rows constructor_end constructor metadata)
                  (+ count 1))))
            (fail)))))))

(def validate_global_program
  ((index Int) (saw_function Int) (function_count Int) (main_count Int)
   (type_rows Int) (constructor_rows Int) (function_rows Int)) Int
  (let form Int (skip index)
    (if (eq form (source_length))
      (if (eq function_count 0)
        (fail)
        (if (eq main_count 1)
          (pair type_rows (pair constructor_rows function_rows))
          (fail)))
      (if (eq (source_read form) 40)
        (let head Int (form_head form)
          (let head_end Int (token_end head)
            (if (token_data head head_end)
              (if saw_function
                (fail)
                (let result Int
                  (validate_global_data form type_rows constructor_rows)
                  (validate_global_program
                    (first result) 0 function_count main_count
                    type_rows (second result) function_rows)))
              (if (token_def head head_end)
                (let name Int (skip head_end)
                  (let name_end Int (token_end name)
                    (if (value_name_valid name name_end)
                      (let metadata Int
                        (catalog_function_signature form name_end type_rows)
                        (validate_global_program
                          (skip_expression form) 1 (+ function_count 1)
                          (+ main_count (token_main name name_end))
                          type_rows constructor_rows
                          (name_trie_insert
                            function_rows name_end name metadata)))
                      (fail))))
                (fail)))))
        (fail)))))

; Negative types are exact builtins. Positive types are exact nominal
; declaration owners. Zero is reserved as an absent lookup or as the first-arm
; result sentinel.
(def int_type () Int
  -1)

(def bytes_type () Int
  -2)

(def resolve_type ((start Int) (end Int) (type_rows Int)) Int
  (if (token_int start end)
    (int_type)
    (if (token_bytes start end)
      (bytes_type)
      (if (upper_name_valid start end)
        (let found Int (name_trie_find_option type_rows end start)
          (if (first found)
            (type_metadata_owner (second found))
            (fail)))
        (fail)))))

(def typed_after ((typed Int)) Int
  (first typed))

(def typed_value ((typed Int)) Int
  (second typed))

; Local environments reuse the exact immutable name trie. Extending a scope
; returns a new root; sibling branches and match arms retain the outer root.
(def collect_pattern_locals
  ((binder_index Int) (field_index Int) (remaining Int) (locals Int)
   (type_rows Int)) Int
  (if (eq remaining 0)
    locals
    (let binder Int (skip binder_index)
      (let binder_end Int (token_end binder)
        (let field_type Int (skip field_index)
          (let field_end Int (token_end field_type)
            (let checked Int (require_value_name binder binder_end)
              (collect_pattern_locals
                binder_end field_end (- remaining 1)
                (name_trie_insert
                  locals binder_end binder
                  (resolve_type field_type field_end type_rows))
                type_rows))))))))

(def check_type_arguments
  ((index Int) (remaining Int) (expected Int)
   (globals Int) (locals Int)) Int
  (let next Int (skip index)
    (if (eq remaining 0)
      (if (eq (source_read next) 41)
        (token_end next)
        (fail))
      (if (eq (source_read next) 41)
        (fail)
        (let typed Int (check_type_expression next globals locals)
          (if (eq (typed_value typed) expected)
            (check_type_arguments
              (typed_after typed) (- remaining 1) expected globals locals)
            (fail)))))))

(def check_constructor_arguments
  ((index Int) (field_index Int) (remaining Int)
   (globals Int) (locals Int)) Int
  (let next Int (skip index)
    (if (eq remaining 0)
      (if (eq (source_read next) 41)
        (token_end next)
        (fail))
      (if (eq (source_read next) 41)
        (fail)
        (let field_type Int (skip field_index)
          (let field_end Int (token_end field_type)
            (let typed Int (check_type_expression next globals locals)
              (if (eq (typed_value typed)
                      (resolve_type
                        field_type field_end (global_types globals)))
                (check_constructor_arguments
                  (typed_after typed) field_end (- remaining 1)
                  globals locals)
                (fail)))))))))

(def check_function_arguments
  ((index Int) (parameter_types Int) (remaining Int)
   (globals Int) (locals Int)) Int
  (let next Int (skip index)
    (if (eq remaining 0)
      (if (eq (source_read next) 41)
        (token_end next)
        (fail))
      (if (eq (source_read next) 41)
        (fail)
        (let typed Int (check_type_expression next globals locals)
          (if (eq (typed_value typed) (first parameter_types))
              (check_function_arguments
              (typed_after typed) (second parameter_types) (- remaining 1)
              globals locals)
            (fail)))))))

(def check_type_atom ((start Int) (globals Int) (locals Int)) Int
  (let end Int (token_end start)
    (let first Int (source_read start)
      (if (is_upper first)
        (let metadata Int (require_constructor_metadata start end globals)
          (if (eq (constructor_metadata_arity metadata) 0)
            (pair end (constructor_metadata_owner metadata))
            (fail)))
        (if (is_digit first)
          (if (integer_literal_valid start end)
            (pair end (int_type))
            (fail))
          (if (eq first 45)
            (if (integer_literal_valid start end)
              (pair end (int_type))
              (fail))
            (if (value_name_valid start end)
              (let local_type Int (name_trie_find locals end start)
                (if local_type (pair end local_type) (fail)))
              (fail))))))))

(def check_type_if
  ((index Int) (globals Int) (locals Int)) Int
  (let condition Int (check_type_expression index globals locals)
    (if (eq (typed_value condition) (int_type))
      (let when_true Int
        (check_type_expression (skip (typed_after condition)) globals locals)
        (let when_false Int
          (check_type_expression (skip (typed_after when_true)) globals locals)
          (if (eq (typed_value when_true) (typed_value when_false))
            (let close Int (skip (typed_after when_false))
              (if (eq (source_read close) 41)
                (pair (token_end close) (typed_value when_true))
                (fail)))
            (fail))))
      (fail))))

(def check_type_let
  ((index Int) (globals Int) (locals Int)) Int
  (let name Int (skip index)
    (let name_end Int (token_end name)
      (let type_name Int (skip name_end)
        (let type_end Int (token_end type_name)
          (let checked Int
            (validate_local_declaration
              name name_end type_name type_end (global_types globals))
            (let declared_type Int
              (resolve_type type_name type_end (global_types globals))
              (let body_locals Int
                (name_trie_insert locals name_end name declared_type)
                (let initializer Int
                  (check_type_expression (skip type_end) globals locals)
                  (if (eq (typed_value initializer) declared_type)
                    (let body Int
                      (check_type_expression
                        (skip (typed_after initializer)) globals body_locals)
                      (let close Int (skip (typed_after body))
                        (if (eq (source_read close) 41)
                          (pair (token_end close) (typed_value body))
                          (fail))))
                    (fail)))))))))))

(def check_type_arms
  ((index Int) (owner Int) (globals Int) (locals Int) (arm_type Int)
