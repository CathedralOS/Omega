          (let ignored4 Int (write '\s')
            (let ignored5 Int (emit_if_prefix)
              (let ignored6 Int (emit_zero_comparison open 114 0 0)
                (let ignored7 Int (write '\s')
                  (let ignored8 Int
                    (if subtract
                      (emit_overflow_branch open 122 108)
                      (emit_overflow_branch open 108 122))
                    (let ignored9 Int (write '\s')
                      (let ignored10 Int (emit_arithmetic_name open 122)
                        (let ignored11 Int (write ')')
                          (write ')'))))))))))))))

(def emit_product_check ((open Int)) Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 'e')
      (let ignored2 Int (write 'q')
        (let ignored3 Int (write '\s')
          (let ignored4 Int (write '(')
            (let ignored5 Int (write '/')
              (let ignored6 Int (write '\s')
                (let ignored7 Int (emit_arithmetic_name open 122)
                  (let ignored8 Int (write '\s')
                    (let ignored9 Int (emit_arithmetic_name open 108)
                      (let ignored10 Int (write ')')
                        (let ignored11 Int (write '\s')
                          (let ignored12 Int
                            (emit_arithmetic_name open 114)
                            (write ')')))))))))))))))

(def emit_multiply_guard ((open Int)) Int
  (let ignored0 Int (emit_if_prefix)
    (let ignored1 Int (emit_zero_comparison open 108 0 1)
      (let ignored2 Int (write '\s')
        (let ignored3 Int (emit_arithmetic_name open 122)
          (let ignored4 Int (write '\s')
            (let ignored5 Int (emit_if_prefix)
              (let ignored6 Int (emit_product_check open)
                (let ignored7 Int (write '\s')
                  (let ignored8 Int (emit_arithmetic_name open 122)
                    (let ignored9 Int (write '\s')
                      (let ignored10 Int (emit_trap)
                        (let ignored11 Int (write ')')
                          (write ')'))))))))))))))

(def emit_raw_arithmetic
  ((open Int) (head Int) (head_end Int)) Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (emit_span head head_end)
      (let ignored2 Int (write '\s')
        (let ignored3 Int (emit_arithmetic_name open 108)
          (let ignored4 Int (write '\s')
            (let ignored5 Int (emit_arithmetic_name open 114)
              (write ')'))))))))

(def emit_checked_arithmetic
  ((open Int) (head Int) (head_end Int) (args Int) (globals Int)) Int
  (let ignored0 Int (emit_binding_prefix open 108)
    (let after_left Int (emit_expression args globals)
      (let ignored1 Int (write '\s')
        (let ignored2 Int (emit_binding_prefix open 114)
          (let after_right Int (emit_expression (skip after_left) globals)
            (let close Int (skip after_right)
              (if (eq (source_read close) 41)
                (let ignored3 Int (write '\s')
                  (let ignored4 Int (emit_binding_prefix open 122)
                    (let ignored5 Int (emit_raw_arithmetic open head head_end)
                      (let ignored6 Int (write '\s')
