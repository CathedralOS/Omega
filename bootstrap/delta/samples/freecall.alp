// SELF-HOSTING / CODEGEN: the FREE-machine CALL (Call) -- m(args) on a machine WITHOUT self.
// With the args already lowered onto the stack, the call pops them into x0.. (top-down, no self),
// branches to the callee's label, and pushes the return value -- exactly the backend's Expr::Call
// (src/aarch64.rs), the self-less variant of SelfCall:
//     ldr x<argc-1>, [sp], #16 ... ldr x0, [sp], #16   pop args, top arg into the highest reg (no self)
//     bl <callee label>
//     str x0, [sp, #-16]!                               push the return value
// Input: "<arg_count> <callee-label>" (the label resolved by the caller; cf. branches' label
// resolution). Reads the count and the label string on stdin.
//   printf '1 Lmachine3' | freecall   ->  pop x0, bl Lmachine3, push
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; argc: i32; ls: i32; le: i32; i: i32; v: i32; di: i32; ek: i32;
    dig: [i32; 16];
    buf: [u8; 256];
}
machine Main::emit_int(&mut self) {
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::p_ldrx(&mut self) {        // "    ldr x"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(108); transition 0 { _ -> b4() } }
    state b4(){ write_byte(100); transition 0 { _ -> b5() } }
    state b5(){ write_byte(114); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(120); }
}
machine Main::p_spsuf(&mut self) {        // ", [sp], #16"
    write_byte(44);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(91);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(112); transition 0 { _ -> b5() } }
    state b5(){ write_byte(93);  transition 0 { _ -> b6() } }
    state b6(){ write_byte(44);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(35);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(49);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(54); }
}
machine Main::p_bl(&mut self) {           // "    bl "
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(98);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(108); transition 0 { _ -> b5() } }
    state b5(){ write_byte(32); }
}
machine Main::emit_label(&mut self) {     // buf[ls..le)
    self.ek = self.ls;
    transition 0 { _ -> el() }
    state el() { transition self.ek < self.le { true -> ew()  false -> done() } }
    state ew() { write_byte(self.buf[self.ek]); self.ek = self.ek + 1; transition 0 { _ -> el() } }
    state done(){ }
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> parse()  false -> st() } }
    state st()    { transition self.n < 256 { true -> st2()  false -> rd() } }
    state st2()   { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // parse: leading number = arg_count, then (after spaces) the label span [ls,le)
    state parse() { self.argc = 0; self.pos = 0; transition 0 { _ -> pnum() } }
    state pnum()  { transition self.buf[self.pos] < 48 { true -> pdone()  false -> pn2() } }
    state pn2()   { transition self.buf[self.pos] > 57 { true -> pdone()  false -> pacc() } }
    state pacc()  { self.argc = self.argc * 10 + self.buf[self.pos] - 48; self.pos = self.pos + 1; transition 0 { _ -> pnum() } }
    state pdone() { transition self.buf[self.pos] <= 32 { true -> psk()  false -> plab() } }   // skip ws
    state psk()   { self.pos = self.pos + 1; transition 0 { _ -> pdone() } }
    state plab()  { self.ls = self.pos; transition 0 { _ -> plr() } }
    state plr()   { transition self.pos < self.n { true -> plc()  false -> plab2() } }
    state plc()   { transition self.buf[self.pos] <= 32 { true -> plab2()  false -> pla() } }  // label ends at ws/EOF
    state pla()   { self.pos = self.pos + 1; transition 0 { _ -> plr() } }
    state plab2() { self.le = self.pos; self.i = self.argc - 1; transition 0 { _ -> pops() } }
    // emit: pop args x<argc>..x1, self x0, bl label, push
    state pops()  { transition self.i < 0 { true -> blp()  false -> pop1() } }
    state pop1()  { self.p_ldrx(); self.v = self.i; self.emit_int(); self.p_spsuf(); write_byte(10); self.i = self.i - 1; transition 0 { _ -> pops() } }
    state blp()   { self.p_bl(); self.emit_label(); write_byte(10); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> done() } }
    state done()  { self.console.exit_process(0) }
}
