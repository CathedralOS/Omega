// CERTIFYING COMPUTATION of a real ALGORITHM. Earlier correctness certifiers handle
// trivial results (max, sort of two); this runs EUCLID'S ALGORITHM to compute g =
// gcd(a,b) and emits a proof certificate that g is a common divisor of the inputs:
//   g | a   AND   g | b
// = (& (exists w. w*g = a) (exists w. w*g = b)), proved with the cofactors a/g and b/g
//   (pair (wit ... (a/g) (refl a)) (wit ... (b/g) (refl b))).
// The trust anchor checks that (a/g)*g really reduces to a and (b/g)*g to b -- so the
// output of a non-trivial loop (repeated mod until zero) is certified correct. (This
// proves g divides both; the "greatest" half would need a universal, omitted here.)
//   printf '12 8' | certify-gcd | check.exe   ->  accept   (gcd=4, 4|12 and 4|8)
// Contract: a or b nonzero (so g>0); a==b==0 handled (g=0, 0|0 with cofactor 0).
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    nums: [i32; 2]; ni: i32; cur: i32;
    ga: i32; gb: i32; q: i32; r: i32; g: i32; wa: i32; wb: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// the proposition body  (= (m (v 0) g) av)   -- g divides av, with cofactor v 0
machine Main::emit_body(&mut self, gv: i32, av: i32) {
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(109); write_byte(32);
    write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(32);   // "(= (m (v 0) "
    self.emit_nat(gv);
    write_byte(41); write_byte(32);                                                                    // ") "
    self.emit_nat(av);
    write_byte(41);                                                                                    // ")"
}
machine Main::main(&mut self) {
    self.n = 0; self.ni = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> nxt() } }
    state nxt()   { transition self.ni < 2 { true -> sk()  false -> compute() } }
    state sk()    { transition self.pos < self.n { true -> skc()  false -> compute() } }
    state skc()   { transition self.buf[self.pos] < 48 { true -> ad()  false -> skh() } }
    state skh()   { transition self.buf[self.pos] > 57 { true -> ad()  false -> pn() } }
    state ad()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state pn()    { self.cur = 0; transition 0 { _ -> pd() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> pv()  false -> pdh() } }
    state pdh()   { transition self.buf[self.pos] > 57 { true -> pv()  false -> pa() } }
    state pa()    { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    state pv()    { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; transition 0 { _ -> nxt() } }
    // EUCLID: gcd by repeated remainder until zero
    state compute(){ self.ga = self.nums[0]; self.gb = self.nums[1]; transition 0 { _ -> gloop() } }
    state gloop()  { transition self.gb > 0 { true -> gstep()  false -> gdone() } }
    state gstep()  { self.q = self.ga / self.gb; self.r = self.ga - self.q * self.gb; transition 0 { _ -> gstep2() } }
    state gstep2() { self.ga = self.gb; self.gb = self.r; transition 0 { _ -> gloop() } }
    state gdone()  { self.g = self.ga; transition self.g > 0 { true -> exact()  false -> zero() } }
    state exact()  { self.wa = self.nums[0] / self.g; self.wb = self.nums[1] / self.g; transition 0 { _ -> emit() } }
    state zero()   { self.wa = 0; self.wb = 0; transition 0 { _ -> emit() } } // a==b==0: 0|0 cofactor 0
    state emit() {
        // goal:  (& (Exists g|a) (Exists g|b))
        write_byte(40); write_byte(38); write_byte(32); write_byte(40); write_byte(69); write_byte(120);
        write_byte(105); write_byte(115); write_byte(116); write_byte(115); write_byte(32);            // "(& (Exists "
        self.emit_body(self.g, self.nums[0]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(69); write_byte(120); write_byte(105);
        write_byte(115); write_byte(116); write_byte(115); write_byte(32);                             // ") (Exists "
        self.emit_body(self.g, self.nums[1]);
        write_byte(41); write_byte(41); write_byte(32);                                                // ")) "
        // proof:  (pair (wit g|a (a/g) (refl a)) (wit g|b (b/g) (refl b)))
        write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32);
        write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32);             // "(pair (wit "
        self.emit_body(self.g, self.nums[0]);
        write_byte(32);
        self.emit_nat(self.wa);
        write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // " (refl "
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(41); write_byte(32); write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32); // ")) (wit "
        self.emit_body(self.g, self.nums[1]);
        write_byte(32);
        self.emit_nat(self.wb);
        write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // " (refl "
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(41); write_byte(41);                                                // ")))"
        self.console.exit_process(0)
    }
}
