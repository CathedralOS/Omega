// Construction application for the bootstrap compiler; separate from public OCREQ.
// Integer rows frame exact bytes and invocation ownership. The compiler alone
// derives namespaces from logical paths and resolves imports.
// Exit 0 publishes Alpha bytes. Compiler refusals exit 1 (invalid), 2 (outside
// the supported subset), or 3 (capacity), publishing the absolute source-byte
// coordinate as four little-endian bytes. Malformed framing exits 3 without
// a coordinate. V2 carries separate Build sources and selects each package's
// Build file. Build execution is required before publishing a v2 tape.
// This application does not claim public OCREQ admission.
boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}

// A Build source is retained in its supplying package's separate scope.
data ConstructionBuildSource {
    supplier: i32;
    start: i32;
    end: i32;
    path: OmegaRelativeSpan;
}

data Main {
    console: Console;
    compiler: OmegaScalarCompiler;
    length: i32;
    entry_unit: i32;
    entry_name: OmegaRelativeSpan;
    build_count: i32;
    has_builds: i32;
    // Build and Product file ordinals belong to separate scopes.
    build_units: [ConstructionBuildSource; 512];
    build_entries: [i32; 64];
    package_roots: [OmegaRelativeSpan; 64];
}

machine Main::word(&mut self) -> i32 {
    transition true { true -> byte(0, 1, 0) }
    state byte(index: i32, scale: i32, value: i32) {
        let next: i32 = self.console.read_byte();
        transition (next >= 0) && ((index < 3) || (next < 128)) {
            true -> retain(index, scale, value + next * scale)
            _ -> self.console.exit_process(3)
        }
    }
    state retain(index: i32, scale: i32, value: i32) {
        transition index {
            3 -> return value
            _ -> byte(index + 1, scale * 256, value)
        }
    }
}

// The product's ModulePath holds 256 bytes. A long basename uses no namespace space.
machine Main::namespace_fits(&mut self, source: &[u8], path: OmegaRelativeSpan) -> i32 {
    transition true { true -> suffix(path.end - 1) }
    state suffix(index: i32) {
        transition index - path.start > 256 {
            true -> byte(index)
            _ -> return 1
        }
    }
    state byte(index: i32) {
        transition source[index] == '/' {
            true -> return 0
            _ -> suffix(index - 1)
        }
    }
}

machine Main::main(&mut self) {
    self.construct_standalone("");
}

// An empty deployment is the default embedded environment. To delegate its
// one Alpha process, a standalone host supplies the independently authorized
// immutable request as this argument, separate from the guest input stream.
// Compare the entire frame before reading its header. This rejoins every
// owner, source, path, Build selection and root and preserves their custody.
machine Main::construct_standalone(&mut self, deployment: &[u8]) {
    self.construct_deployment(deployment, "");
}

// Roots are supplied by the embedding alongside the exact deployment. Each
// root owns its verified Product and Build source bytes in the fixed snapshot.
machine Main::construct_deployment(&mut self, deployment: &[u8], roots: &[u8]) {
    self.has_builds = 0;
    self.build_count = 0;
    self.compiler.build.location_length = 0;
    transition deployment.len == 0 {
        true -> guest_only()
        _ -> custody(self.console.remaining_input)
    }
    state guest_only() {
        transition roots.len == 0 { true -> frame() _ -> self.console.exit_process(3) }
    }
    state custody(request: &[u8]) {
        transition self.compiler.span_equals(request, 0, request.len, deployment) {
            1 -> frame()
            _ -> self.console.exit_process(3)
        }
    }
    state frame() {
        let first: i32 = self.word();
        transition first {
            0 -> version(self.word())
            _ -> self.console.exit_process(3)
        }
    }
    state version(number: i32) {
        transition number {
            1 -> header(self.word())
            2 -> build_header()
            _ -> self.console.exit_process(3)
        }
    }
    state build_header() {
        self.has_builds = 1;
        transition true { true -> header(self.word()) }
    }
    state header(packages: i32) {
        self.compiler.parser.sources.package_count = packages;
        self.compiler.parser.sources.dependency_count = self.word();
        self.compiler.parser.sources.unit_count = self.word();
        self.entry_unit = self.word();
        self.entry_name.start = self.word();
        self.entry_name.end = self.word();
        self.length = self.word();
        transition (packages > 0) && (packages <= 64) &&
            (self.compiler.parser.sources.dependency_count <= 256) &&
            (self.compiler.parser.sources.unit_count <= 512) && (self.length <= 8388608) {
            true -> build_layout()
            _ -> self.console.exit_process(3)
        }
    }
    state build_layout() {
        transition self.has_builds {
            1 -> build_count(self.word())
            _ -> package(0)
        }
    }
    state build_count(count: i32) {
        self.build_count = count;
        transition (count > 0) && (count <= 512) && (self.entry_unit < self.compiler.parser.sources.unit_count) {
            true -> package(0)
            _ -> self.console.exit_process(3)
        }
    }
    state package(index: i32) {
        transition index < self.compiler.parser.sources.package_count {
            true -> package_row(index)
            _ -> dependency(0)
        }
    }
    state package_row(index: i32) {
        self.compiler.parser.sources.packages[index].name.start = self.word();
        self.compiler.parser.sources.packages[index].name.end = self.word();
        self.compiler.parser.sources.packages[index].role = self.word();
        transition true { true -> package(index + 1) }
    }
    state dependency(index: i32) {
        transition index < self.compiler.parser.sources.dependency_count {
            true -> dependency_row(index)
            _ -> unit(0)
        }
    }
    state dependency_row(index: i32) {
        self.compiler.parser.sources.dependencies[index].requester = self.word();
        self.compiler.parser.sources.dependencies[index].target = self.word();
        self.compiler.parser.sources.dependencies[index].alias.start = self.word();
        self.compiler.parser.sources.dependencies[index].alias.end = self.word();
        transition true { true -> dependency(index + 1) }
    }
    state unit(index: i32) {
        transition index < self.compiler.parser.sources.unit_count {
            true -> unit_row(index)
            _ -> selection(0)
        }
    }
    state unit_row(index: i32) {
        self.compiler.parser.sources.units[index].package = self.word();
        self.compiler.parser.sources.units[index].start = self.word();
        self.compiler.parser.sources.units[index].end = self.word();

        let start: i32 = self.word();
        let end: i32 = self.word();
        transition (start < end) && (end <= self.length) {
            true -> retain_path(index, start, end)
            _ -> self.console.exit_process(3)
        }
    }
    state retain_path(index: i32, start: i32, end: i32) {
        self.compiler.parser.sources.units[index].path.start = start;
        self.compiler.parser.sources.units[index].path.end = end;
        transition true { true -> unit(index + 1) }
    }
    state selection(requester: i32) {
        transition (self.has_builds == 1) && (requester < self.compiler.parser.sources.package_count) {
            true -> selected(requester, self.word(), self.word())
            _ -> build_unit(0)
        }
    }
    state selected(requester: i32, owner: i32, unit: i32) {
        transition (owner == requester) && (unit < self.build_count) {
            true -> retain_selection(requester, unit)
            _ -> self.console.exit_process(3)
        }
    }
    state retain_selection(requester: i32, unit: i32) {
        self.build_entries[requester] = unit;
        transition true { true -> selection(requester + 1) }
    }
    state build_unit(index: i32) {
        transition index < self.build_count {
            true -> build_row(index)
            _ -> arena(self.console.remaining_input)
        }
    }
    state build_row(index: i32) {
        self.build_units[index].supplier = self.word();
        self.build_units[index].start = self.word();
        self.build_units[index].end = self.word();
        self.build_units[index].path.start = self.word();
        self.build_units[index].path.end = self.word();
        let row: ConstructionBuildSource = self.build_units[index];
        transition (row.supplier < self.compiler.parser.sources.package_count) && (row.start <= row.end) &&
            (row.end <= self.length) && (row.path.start < row.path.end) && (row.path.end <= self.length) {
            true -> build_unit(index + 1)
            _ -> self.console.exit_process(3)
        }
    }
    state arena(source: &[u8]) {
        transition source.len == self.length {
            true -> entry(source)
            _ -> self.console.exit_process(3)
        }
    }
    state entry(source: &[u8]) {
        transition self.compiler.parser.sources.identifier(source, self.entry_name) {
            1 -> path_limit(source, 0)
            _ -> self.console.exit_process(3)
        }
    }
    state path_limit(source: &[u8], index: i32) {
        transition index < self.compiler.parser.sources.unit_count {
            true -> unit_path(source, index)
            _ -> scoped(source)
        }
    }
    state scoped(source: &[u8]) {
        transition self.has_builds {
            1 -> check_builds(source)
            _ -> product_entry(source)
        }
    }
    state product_entry(source: &[u8]) {
        transition deployment.len == 0 {
            true -> compile(source)
            _ -> self.console.exit_process(3)
        }
    }
    state check_builds(source: &[u8]) {
        transition (self.compiler.parser.sources.valid(source) == 1) && (self.valid_builds(source) == 1) {
            true -> replay(source, self.compiler.parser.sources.units[self.entry_unit].package)
            _ -> self.console.exit_process(3)
        }
    }
    state replay(source: &[u8], requester: i32) {
        transition self.replay_deployment(source, requester, roots) {
            1 -> resolved(source, self.compiler.build.entry_definition)
            _ -> pending(requester)
        }
    }
    state resolved(source: &[u8], entry: OmegaRelativeSpan) {
        self.entry_unit = self.compiler.parser.sources.unit_at(entry.start);
        self.entry_name = entry;
        transition deployment.len == 0 {
            true -> compile(source)
            _ -> process(source)
        }
    }
    state process(source: &[u8]) {
        self.compiler.compile_process_entry(source, self.entry_unit);
        transition true { true -> result() }
    }
    state pending(requester: i32) {
        // A valid Build inventory still needs admitted execution. Anchor the
        // missing coverage at this entry package's selected Build source.
        transition true { true -> refusal(2, self.build_units[self.build_entries[requester]].start, 0) }
    }
    state unit_path(source: &[u8], index: i32) {
        transition self.namespace_fits(source, self.compiler.parser.sources.units[index].path) {
            1 -> path_limit(source, index + 1)
            _ -> self.console.exit_process(3)
        }
    }
    state compile(source: &[u8]) {
        self.compiler.compile_set(source, self.entry_unit,
            source[self.entry_name.start..self.entry_name.end]);
        transition true { true -> result() }
    }
    state result() {
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Complete -> publish(0)
            OmegaScalarCompilationStatus::Reject -> refusal(1, self.compiler.outcome_coordinate, 0)
            OmegaScalarCompilationStatus::Incomplete -> refusal(2, self.compiler.outcome_coordinate, 0)
            OmegaScalarCompilationStatus::ResourceFailure -> refusal(3, self.compiler.outcome_coordinate, 0)
            _ -> self.console.exit_process(4)
        }
    }
    state refusal(code: i32, coordinate: i32, index: i32) {
        transition index < 4 {
            true -> refusal_byte(code, coordinate, index)
            _ -> self.console.exit_process(code)
        }
    }
    state refusal_byte(code: i32, coordinate: i32, index: i32) {
        self.console.write_byte(coordinate & 255);
        transition true { true -> refusal(code, coordinate >> 8, index + 1) }
    }
    state publish(index: i32) {
        transition index < self.compiler.tape.payload_length() {
            true -> byte(index)
            _ -> return
        }
    }
    state byte(index: i32) {
        self.console.write_byte(self.compiler.tape.bytes[index]);
        transition true { true -> publish(index + 1) }
    }
}

// This is a canonical package-relative file path, not a runtime module name.
// Each component is nonempty and cannot be a traversal. NUL and backslash
// cannot enter the captured path. Source acquisition supplies its exact bytes.
machine Main::valid_build_path(&mut self, path: &[u8]) -> i32 {
    transition true { true -> scan(0, 0) }
    state scan(start: i32, cursor: i32) {
        transition cursor < path.len {
            true -> byte(start, cursor, path[cursor])
            _ -> component(start, cursor, 0)
        }
    }
    state byte(start: i32, cursor: i32, value: i32) {
        transition value {
            0 -> return 0
            '\\' -> return 0
            '/' -> component(start, cursor, 1)
            _ -> scan(start, cursor + 1)
        }
    }
    state component(start: i32, end: i32, more: i32) {
        transition (start < end) && (self.compiler.span_equals(path, start, end, ".") == 0) &&
            (self.compiler.span_equals(path, start, end, "..") == 0) {
            true -> next(end, more)
            _ -> return 0
        }
    }
    state next(end: i32, more: i32) {
        transition more { 1 -> scan(end + 1, end + 1) _ -> return 1 }
    }
}

machine Main::has_build_file(&mut self, source: &[u8], limit: i32, supplier: i32, path: &[u8]) -> i32 {
    transition true { true -> scan(0) }
    state scan(index: i32) {
        transition index < limit {
            true -> file(index, self.build_units[index])
            _ -> return 0
        }
    }
    state file(index: i32, row: ConstructionBuildSource) {
        transition (row.supplier == supplier) && (self.compiler.span_equals(source, row.path.start, row.path.end, path) == 1) {
            true -> return 1
            _ -> scan(index + 1)
        }
    }
}

machine Main::valid_builds(&mut self, source: &[u8]) -> i32 {
    transition true { true -> unit(0) }
    state unit(index: i32) {
        transition index < self.build_count {
            true -> file(index, self.build_units[index])
            _ -> entry(0)
        }
    }
    state file(index: i32, row: ConstructionBuildSource) {
        let path: &[u8] = source[row.path.start..row.path.end];
        transition (self.valid_build_path(path) == 1) && (self.has_build_file(source, index, row.supplier, path) == 0) {
            true -> unit(index + 1)
            _ -> return 0
        }
    }
    state entry(requester: i32) {
        transition requester < self.compiler.parser.sources.package_count {
            true -> selected(requester, self.build_units[self.build_entries[requester]])
            _ -> return 1
        }
    }
    state selected(requester: i32, row: ConstructionBuildSource) {
        transition (row.supplier == requester) && (self.compiler.span_equals(source, row.path.start, row.path.end, "build.omg") == 1) {
            true -> entry(requester + 1)
            _ -> fallback(requester, row)
        }
    }
    // The already checked source set has at most one role-1 core package.
    state fallback(requester: i32, row: ConstructionBuildSource) {
        transition (self.compiler.parser.sources.packages[row.supplier].role == 1) &&
            (self.compiler.span_equals(source, row.path.start, row.path.end, "defaults/build.omg") == 1) &&
            (self.has_build_file(source, self.build_count, requester, "build.omg") == 0) {
            true -> entry(requester + 1)
            _ -> return 0
        }
    }
}
// The supported graph has one authored application. Other packages can
// contribute the ordinary, empty core default. Check each selected Build
// and require complete scope coverage before publishing any Product code.
machine Main::checked_application_build(&mut self, source: &[u8], owner: i32) -> i32 {
    transition (self.compiler.parser.sources.dependency_count == 0) &&
        (self.compiler.parser.sources.packages[owner].role == 0) &&
        (self.compiler.parser.sources.unit_count < 512) {
        true -> source_file(0)
        _ -> return 0
    }
    state source_file(index: i32) {
        transition index < self.build_count {
            true -> file(index, self.build_units[index])
            _ -> activation(0)
        }
    }
    // Helpers and additional Build files cannot be skipped without checking
    // their declarations. Covered non-root files are evaluated empty defaults.
    state file(index: i32, row: ConstructionBuildSource) {
        transition index == self.build_entries[owner] {
            true -> root(index, row)
            _ -> default_source(index, row)
        }
    }
    state root(index: i32, row: ConstructionBuildSource) {
        transition (row.supplier == owner) && (self.compiler.span_equals(source, row.path.start, row.path.end, "build.omg") == 1) {
            true -> source_file(index + 1)
            _ -> return 0
        }
    }
    state default_source(index: i32, row: ConstructionBuildSource) {
        transition (self.compiler.parser.sources.packages[row.supplier].role == 1) &&
            (self.compiler.span_equals(source, row.path.start, row.path.end, "defaults/build.omg") == 1) &&
            (index == self.build_entries[row.supplier]) && (self.compiler.empty_build(source, row.start, row.end) == 1) {
            true -> source_file(index + 1)
            _ -> return 0
        }
    }
    state activation(package: i32) {
        transition package < self.compiler.parser.sources.package_count {
            true -> activated(package, self.build_units[self.build_entries[package]])
            _ -> scope(self.build_units[self.build_entries[owner]])
        }
    }
    state activated(package: i32, row: ConstructionBuildSource) {
        transition (package == owner) || ((self.compiler.parser.sources.packages[package].role == 1) && (row.supplier == package)) {
            true -> activation(package + 1)
            _ -> return 0
        }
    }
    state scope(row: ConstructionBuildSource) {
        return self.run_scoped_build(source, row, 1);
    }
}

// One registered Product dependency is covered. The other activated package is
// the trusted core's empty default. Each authored Build runs in its own scope.
machine Main::replay_deployment(&mut self, source: &[u8], owner: i32, roots: &[u8]) -> i32 {
    transition self.compiler.parser.sources.dependency_count {
        0 -> return self.checked_application_build(source, owner)
        1 -> graph(self.compiler.parser.sources.dependencies[0])
        _ -> return 0
    }
    state graph(edge: OmegaSourceDependency) {
        transition (self.compiler.parser.sources.package_count == 3) && (self.build_count == 3) &&
            (self.compiler.parser.sources.unit_count < 512) && (self.compiler.parser.sources.packages[owner].role == 0) &&
            (edge.requester == owner) && (edge.target != owner) && (self.compiler.parser.sources.packages[edge.target].role != 1) &&
            (self.compiler.parser.sources.equal_name(source, edge.alias, self.compiler.parser.sources.packages[edge.target].name) == 1) &&
            (self.read_package_roots(roots) == 1) && (self.relative_location(roots, self.package_roots[owner], self.package_roots[edge.target]) == 1) {
            true -> files(edge.target, 0)
            _ -> return 0
        }
    }
    state files(supplier: i32, index: i32) {
        transition index < 3 {
            true -> file(supplier, index, self.build_units[self.build_entries[index]])
            _ -> application(supplier)
        }
    }
    state file(supplier: i32, index: i32, row: ConstructionBuildSource) {
        transition row.supplier == index {
            true -> owner_file(supplier, index, row)
            _ -> return 0
        }
    }
    state owner_file(supplier: i32, index: i32, row: ConstructionBuildSource) {
        transition (index == owner) || (index == supplier) {
            true -> root(supplier, index, row)
            _ -> core(supplier, index, row)
        }
    }
    state root(supplier: i32, index: i32, row: ConstructionBuildSource) {
        transition self.compiler.span_equals(source, row.path.start, row.path.end, "build.omg") {
            1 -> files(supplier, index + 1)
            _ -> return 0
        }
    }
    state core(supplier: i32, index: i32, row: ConstructionBuildSource) {
        transition (self.compiler.parser.sources.packages[index].role == 1) &&
            (self.compiler.span_equals(source, row.path.start, row.path.end, "defaults/build.omg") == 1) &&
            (self.compiler.empty_build(source, row.start, row.end) == 1) {
            true -> files(supplier, index + 1)
            _ -> return 0
        }
    }
    state application(supplier: i32) {
        transition self.run_scoped_build(source, self.build_units[self.build_entries[owner]], 1) {
            1 -> dependency(supplier, self.compiler.build.entry_definition, self.compiler.build.slot_definition,
                self.compiler.build.provider_definition, self.compiler.build.primitive_definition, self.chosen_targets())
            _ -> return 0
        }
    }
    state dependency(supplier: i32, entry: OmegaRelativeSpan, slot: OmegaRelativeSpan,
        provider: OmegaRelativeSpan, primitive: OmegaRelativeSpan, app_targets: i32) {
        self.compiler.build.location_length = 0;
        transition self.run_scoped_build(source, self.build_units[self.build_entries[supplier]], 0) {
            1 -> overlap(entry, slot, provider, primitive, app_targets)
            _ -> return 0
        }
    }
    state overlap(entry: OmegaRelativeSpan, slot: OmegaRelativeSpan, provider: OmegaRelativeSpan,
        primitive: OmegaRelativeSpan, app_targets: i32) {
        // Overlapping package choices need the general composition judgment.
        transition (self.chosen_targets() & app_targets) == 0 {
            true -> compose(entry, slot, provider, primitive)
            _ -> return 0
        }
    }
    state compose(entry: OmegaRelativeSpan, slot: OmegaRelativeSpan, provider: OmegaRelativeSpan, primitive: OmegaRelativeSpan) {
        self.compiler.build.entry_definition = entry;
        transition slot.end > 0 { true -> retain(slot, provider, primitive) _ -> return 1 }
    }
    state retain(slot: OmegaRelativeSpan, provider: OmegaRelativeSpan, primitive: OmegaRelativeSpan) {
        self.compiler.build.slot_definition = slot;
        self.compiler.build.provider_definition = provider;
        self.compiler.build.primitive_definition = primitive;
        return 1;
    }
}

machine Main::chosen_targets(&mut self) -> i32 {
    transition true { true -> next(0, 1, 0) }
    state next(target: i32, bit: i32, chosen: i32) {
        transition target < 6 {
            true -> next(target + 1, bit * 2, chosen + self.compiler.build.selected_targets[target] * bit)
            _ -> return chosen
        }
    }
}

machine Main::run_scoped_build(&mut self, source: &[u8], row: ConstructionBuildSource, application: i32) -> i32 {
    let count: i32 = self.compiler.parser.sources.unit_count;
    self.compiler.parser.sources.units[count].package = row.supplier;
    self.compiler.parser.sources.units[count].path = row.path;
    self.compiler.parser.sources.units[count].start = row.start;
    self.compiler.parser.sources.units[count].end = row.end;
    self.compiler.parser.sources.unit_count = count + 1;
    let result: i32 = self.compiler.check_ground_application(source, count, self.entry_unit, self.entry_name, application);
    self.compiler.parser.sources.unit_count = count;
    return result;
}

// External roots use one NUL-terminated canonical relative path per package,
// in the approved request's package order. An empty or repeated root refuses.
machine Main::read_package_roots(&mut self, roots: &[u8]) -> i32 {
    transition true { true -> root(0, 0) }
    state root(index: i32, start: i32) {
        transition index == self.compiler.parser.sources.package_count {
            true -> return start == roots.len
            _ -> component(index, start, start, start)
        }
    }
    state component(index: i32, start: i32, first: i32, cursor: i32) {
        transition cursor < roots.len { true -> byte(index, start, first, cursor, roots[cursor]) _ -> return 0 }
    }
    state byte(index: i32, start: i32, first: i32, cursor: i32, value: i32) {
        transition (value == 0) || (value == '/') { true -> end(index, start, first, cursor, value) _ -> letter(index, start, first, cursor, value) }
    }
    state letter(index: i32, start: i32, first: i32, cursor: i32, value: i32) {
        transition ((value >= 'a') && (value <= 'z')) || ((value >= 'A') && (value <= 'Z')) ||
            ((value >= '0') && (value <= '9')) || (value == '-') || (value == '_') || (value == '.') {
            true -> component(index, start, first, cursor + 1)
            _ -> return 0
        }
    }
    state end(index: i32, start: i32, first: i32, cursor: i32, value: i32) {
        transition (cursor > first) && (self.compiler.span_equals(roots, first, cursor, ".") == 0) &&
            (self.compiler.span_equals(roots, first, cursor, "..") == 0) {
            true -> separator(index, start, cursor, value)
            _ -> return 0
        }
    }
    state separator(index: i32, start: i32, cursor: i32, value: i32) {
        transition value { 0 -> unique(index, start, cursor, 0) _ -> component(index, start, cursor + 1, cursor + 1) }
    }
    state unique(index: i32, start: i32, end: i32, previous: i32) {
        transition previous < index {
            true -> earlier(index, start, end, previous, self.package_roots[previous])
            _ -> save(index, start, end)
        }
    }
    state earlier(index: i32, start: i32, end: i32, previous: i32, row: OmegaRelativeSpan) {
        transition self.compiler.span_equals(roots, start, end, roots[row.start..row.end]) {
            1 -> return 0
            _ -> unique(index, start, end, previous + 1)
        }
    }
    state save(index: i32, start: i32, end: i32) {
        self.package_roots[index].start = start; self.package_roots[index].end = end;
        transition true { true -> root(index + 1, end + 1) }
    }
}

machine Main::root_component_end(&mut self, roots: &[u8], start: i32, end: i32) -> i32 {
    transition true { true -> next(start) }
    state next(cursor: i32) {
        transition (cursor < end) && (roots[cursor] != '/') {
            true -> next(cursor + 1)
            _ -> return cursor
        }
    }
}

// The canonical relative locator traverses the remaining requester components
// with ".." and then copies the supplier suffix. The spelling must agree with
// the authored path. Other valid path normalizations remain outside this subset.
machine Main::relative_location(&mut self, roots: &[u8], from: OmegaRelativeSpan, to: OmegaRelativeSpan) -> i32 {
    self.compiler.build.location_length = 0;
    transition true { true -> common(from.start, to.start) }
    state common(a: i32, b: i32) {
        transition (a < from.end) && (b < to.end) {
            true -> compare(a, b, self.root_component_end(roots, a, from.end), self.root_component_end(roots, b, to.end))
            _ -> ascend(a, b)
        }
    }
    state compare(a: i32, b: i32, ae: i32, be: i32) {
        transition self.compiler.span_equals(roots, a, ae, roots[b..be]) {
            1 -> common(ae + 1, be + 1)
            _ -> ascend(a, b)
        }
    }
    state ascend(a: i32, b: i32) {
        transition a < from.end { true -> parent(a, b) _ -> suffix(b) }
    }
    state parent(a: i32, b: i32) {
        transition self.location_component("..") { 1 -> ascend(self.root_component_end(roots, a, from.end) + 1, b) _ -> return 0 }
    }
    state suffix(b: i32) {
        transition b < to.end { true -> return self.location_component(roots[b..to.end]) _ -> return self.compiler.build.location_length > 0 }
    }
}

machine Main::location_component(&mut self, bytes: &[u8]) -> i32 {
    let count: i32 = self.compiler.build.location_length;
    transition (bytes.len > 0) && (bytes.len <= 4096 - count) { true -> separator(count) _ -> return 0 }
    state separator(count: i32) {
        transition count > 0 { true -> slash(count) _ -> copy(0, 0) }
    }
    state slash(count: i32) {
        transition bytes.len < 4096 - count { true -> append_slash(count) _ -> return 0 }
    }
    state append_slash(count: i32) { self.compiler.build.location[count] = '/'; transition true { true -> copy(count + 1, 0) } }
    state copy(start: i32, cursor: i32) {
        transition cursor < bytes.len { true -> append(start, cursor) _ -> done(start + cursor) }
    }
    state append(start: i32, cursor: i32) { self.compiler.build.location[start + cursor] = bytes[cursor]; transition true { true -> copy(start, cursor + 1) } }
    state done(end: i32) { self.compiler.build.location_length = end; return 1; }
}
