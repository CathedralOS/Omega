
machine omega_is_whitespace(byte: i32) -> i32 {
    return (byte == '\t') || (byte == '\n') || (byte == '\r') || (byte == ' ');
}

machine omega_is_identifier_start(byte: i32) -> i32 {
    transition byte == '_' {
        true -> return 1
        _ -> upper()
    }

    state upper() {
        transition (byte >= 'A') && (byte <= 'Z') {
            true -> return 1
            _ -> lower()
        }
    }

    state lower() {
        transition (byte >= 'a') && (byte <= 'z') {
            true -> return 1
            _ -> return 0
        }
    }
}

machine omega_is_identifier_continue(byte: i32) -> i32 {
    transition omega_is_identifier_start(byte) {
        1 -> return 1
        _ -> digit()
    }

    state digit() {
        transition (byte >= '0') && (byte <= '9') {
            true -> return 1
            _ -> return 0
        }
    }
}

machine omega_hex_value(byte: i32) -> i32 {
    transition (byte >= '0') && (byte <= '9') {
        true -> return byte - '0'
        _ -> lower()
    }

    state lower() {
        transition (byte >= 'a') && (byte <= 'f') {
            true -> return byte - 'a' + 10
            _ -> upper()
        }
    }

    state upper() {
        transition (byte >= 'A') && (byte <= 'F') {
            true -> return byte - 'A' + 10
            _ -> return -1
        }
    }
}

machine omega_digit_in_base(byte: i32, base: OmegaNumericBase) -> i32 {
    transition base {
        OmegaNumericBase::Binary -> return (byte >= '0') && (byte <= '1')
        OmegaNumericBase::Octal -> return (byte >= '0') && (byte <= '7')
        OmegaNumericBase::Decimal -> return (byte >= '0') && (byte <= '9')
        OmegaNumericBase::Hexadecimal -> return omega_hex_value(byte) >= 0
    }
}
