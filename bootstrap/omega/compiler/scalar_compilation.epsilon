// Every checked expression chooses one realization. The named form carries
// its expression/operand handle in value_payloads; no emitter guesses meaning
// from a numeric tag or from the source spelling.
data OmegaCheckedValueKind {
    case Unchecked;
    case Literal;
    case Call;
    case NestedCall;
    case BooleanBinary;
    case LogicalNot;
    case RepresentationCast;
    case Place;
    case Borrow;
    case RecordLiteral;
    case ArrayLiteral;
    case IndexedRead;
    case ForwardedReference;
    case ExactAddition;
    case ExactWordArithmetic;
    case TrappingArithmetic;
    case WrappingArithmetic;
    case NullaryCase;
    case CaseLiteral;
    case ProjectedRead;
    case WideLiteral;
    case NegativeI32Literal;
    case SignedComparison;
    case ProcessTerminal;
    case LowBits;
    case SharedByteRange;
    case QuotedBytes;
    case SharedByteSubrange;
    case SharedByteRead;
    case ExactSubtraction;
    case NullarySumComparison;
}

// Each call or terminal transfer has one resolved target. Its incoming list
// carries the source state and the marker written at that invocation.
data OmegaCastPolicyStatus {
    case Complete;
    case UnsupportedDomain;
    case ConflictingEntries;
}

data OmegaStateInvocation {
    caller: i32;
    target: i32;
    nested_call: i32;
    // Exact checked operands are retained for deferred private-entry obligations.
    before: i32;
    first_argument: i32;
    argument_count: i32;
    guard: i32;
    truth: i32;
    next: i32;
    coordinate: i32;
    acknowledgements: i32;
}

data OmegaEntryBoundKind {
    case Interval;
    case StrictOrder;
    case InclusiveOrder;
}

data OmegaEntryBound {
    kind: OmegaEntryBoundKind;
    // An ordered pair relates two unsigned parameters of the same type
    // (offset zero), or a u64 index to a shared byte-slice length (offset eight).
    right: i32;
    right_offset: i32;
    root: i32;
    offset: i32;
    field: i32;
    // -1 leaves a signed lower endpoint open.
    minimum: i32;
    // -1 leaves the upper end open.
    maximum: i32;
}

data OmegaScalarCompilationStatus {
    case Pending;
    case Complete;
    case Reject;
    case Incomplete;
    case ResourceFailure;
    case InternalFailure;
}

data OmegaIndexBoundKind {
    case Unproved;
    case Literal;
    case ValueInterval;
    case BooleanArm;
}

// The closed core catalog selects a by-copy read (schema 1) or an exclusive
// indexed place (schema 2) at the exact fixed-array type, element and length.
// This compiler realizes u8 and copy-record elements with admitted layouts.
// Both schemas require a u64 selector proven less than the array length. A
// write also requires writable backing. Neither introduces a reach/crash
// route. Explicit Trapping removal views retain the underlying array shape;
// their known empty establishment debt does not erase backing/loan duties.
// Array-shell adaptation preserves element type and domains. Authored names or
// signatures cannot mint these core identities. This closed catalog is not a
// claim that general package/operator declaration admission has been built.
// Plans retain concrete selection, capture sites, parent lineage and standing
// bound evidence. Occurrence coordinates are not general mutable-value facts:
// proofs below use immutable snapshots or predicates preserved by every write.
// This is internal checked lowering, not a published Terminal Psi certificate.
data OmegaFixedIndexPlan {
    schema: i32;
    array_type: i32;
    element_type: i32;
    stride: i32;
    extent: i32;
    collection: i32;
    selector: i32;
    owner_state: i32;
    before: i32;
    parent_root: i32;
    parent_offset: i32;
    parent_extent: i32;
    access: i32;
    removed_trapping: i32;
    bound_kind: OmegaIndexBoundKind;
    // A branch cites its transition row (predicate and truth). Other bounds
    // cite the checked selector expression.
    bound_source: i32;
    bound_limit: i32;
}

// The Alpha tape stores each checked scalar value as two little-endian words.
data OmegaIntegerGuard {
    low: i32;
    high: i32;
}

data OmegaScalarCompiler {
    build: ConstructionBuildResult;
    // A nonempty site belongs to the independently supplied standalone
    // deployment. It is scoped to this compilation and cleared on return.
    process_entry: OmegaRelativeSpan;
    terminal_calls: [i32; 4096];
    byte_ranges: [OmegaByteRange; 16384];
    byte_subranges: [OmegaByteSubrange; 16384];
    construction: OmegaConstructionDirectory;
    entry_unit: i32;
    exit_service: i32;
    exit_result: i32;
    exit_primitive: i32;
    parser: OmegaParser;
    tape: AlphaTapeBuffer;
    status: OmegaScalarCompilationStatus;
    // Durable current declaration anchor; scanners never overwrite it.
    diagnostic_offset: i32;
    // Decimal scanning cursor, used only for an unsupported digit diagnostic.
    literal_offset: i32;
    // Durable first-arrow anchor for the current transition block.
    transition_anchor: i32;
    selected_machine: i32;
    machine_labels: [i32; 4096];
    // Checked terminal forms: 3 = selected transition row, 4 = value
    // expression result, 5 = dynamic Boolean or nullary-sum transition, 6 = Unit
    // completion after every statement, 7 = explicit Trap, 8 = no-return
    // call as the last statement. state_targets
    // holds the row/expression/first-statement index; state_values is the
    // exclusive statement end for kind 5.
    state_labels: [i32; 16384];
    state_terminal_kind: [i32; 4096];
    state_values: [i32; 4096];
    state_targets: [i32; 4096];
    // Resolved callee machine index for each admitted non-terminal call
    // statement, indexed by the statement's arena position.
    call_targets: [i32; 16384];
    // Each value retains its named realization and its operand/row handle.
    // Parameters, locals, pending arguments and expression scratch own
    // disjoint regions. Source integers never manufacture reference authority.
    value_kinds: [OmegaCheckedValueKind; 16384];
    value_payloads: [i32; 16384];
    // Only a WideLiteral uses a second word. Its low bits are never a complete bound.
    wide_literal_highs: [i32; 16384];
    // Primitive codes retain carrier and policy: 1 bool, 2 Unit, 8 plain u8,
    // 32 plain u32, 33 plain i32, 64 plain u64, 288 Trapping u32, 320 Trapping u64,
    // 576 Wrapping u64. Compound codes below
    // retain their declaration/type-row identity. Zero is never admitted.
    state_types: [i32; 16384];
    state_owners: [i32; 16384];
    // Authored entry predicates retain exact formal/projected subjects. Bodies
    // may use these bounds only while the corresponding storage is unchanged;
    // every call discharges them against its captured actual arguments.
    bound_first: [i32; 16384];
    bound_count: [i32; 16384];
    // One inferred fixed-index interval per private nested state, never authored.
    inferred_index_bound: [i32; 16384];
    bound_total: i32;
    entry_bounds: [OmegaEntryBound; 16384];
    value_states: [i32; 16384];
    value_befores: [i32; 16384];
    local_befores: [i32; 16384];
    effect_count: i32;
    effect_states: [i32; 16384];
    effect_befores: [i32; 16384];
    effect_roots: [i32; 16384];
    effect_offsets: [i32; 16384];
    effect_sizes: [i32; 16384];
    parameter_types: [i32; 16384];
    transition_targets: [i32; 16384];
    // Case lookup and duplicate checking share a declaration-scoped name census.
    // Heads/links store arena index + 1; zero is empty. Retained bucket IDs let
    // the next compile clear only inserted entries, including failed requests.
    case_name_heads: [i32; 1024];
    case_name_next: [i32; 16384];
    case_name_buckets: [i32; 16384];
    case_name_count: i32;
    case_guard_ordinals: [i32; 16384];
    integer_guards: [OmegaIntegerGuard; 16384];
    case_coverage: [i32; 16384];
    // Each pattern field retains its case-owned slot. Only the current
    // arm's target can resolve its binding names (zero means no arm).
    pattern_field_slots: [i32; 16384];
    pattern_scope: i32;
    // Set only while checking one target of a checked Boolean transition.
    active_boolean_arm: i32;
    // Compound identities are canonical within this single-source adapter:
    // nominal records/sums 100000+declaration, arrays 200000+type-row, qualified arrays
    // 300000+type-row, shared/mutable record refs 400000/500000+declaration.
    // Reference identity never contains a snapshot of its referent.
    // A finished record with zero size has a proved-empty default domain.
    // Every realizable value in this profile has strictly positive storage.
    data_colors: [i32; 4096];
    data_sizes: [i32; 4096];
    data_copy: [i32; 4096];
    // Slots 0..16384 name record fields; the upper half names case payload fields.
    field_types: [i32; 32768];
    field_offsets: [i32; 32768];
    field_extents: [i32; 32768];
    field_upper_bounds: [i32; 32768];
    layout_depth: i32;
    // Storage keeps scalar cells and compound values in one bounded arena.
    // Every region is word aligned; array elements retain their own stride.
    cell_types: [i32; 65536];
    cell_ids: [i32; 65536];
    cell_count: i32;
    cell_sizes: [i32; 65536];
    cell_offsets: [i32; 65536];
    storage_size: i32;
    // Structural places retain their root and exact projected byte range.
    // A reference root is dereferenced once when its location is captured.
    struct_field_slots: [i32; 16384];
    place_roots: [i32; 16384];
    place_offsets: [i32; 16384];
    place_types: [i32; 16384];
    place_extent: [i32; 16384];
    place_indirect: [i32; 16384];
    place_writable: [i32; 16384];
    place_fields: [i32; 16384];
    loan_access: [i32; 16384];
    // 0 ordinary argument loan; 1 indexed-access adaptation/reborrow scope.
    loan_context: [i32; 16384];
    loan_roots: [i32; 16384];
    loan_offsets: [i32; 16384];
    loan_sizes: [i32; 16384];
    loan_count: i32;
    index_plans: [OmegaFixedIndexPlan; 16384];
    assignment_loan_base: i32;
    literal_value: i32;
    literal_high: i32;
    // 1 is a complete low word, 5 a full u64 needing its nonzero high word.
    // 2 lies outside the subset, 3 exceeds the carrier, and 4 has a different carrier.
    literal_status: i32;
    // A domain-only cast describes each end of one representation-preserving operation.
    cast_operand: i32;
    cast_input_policy: i32;
    cast_output_policy: i32;
    cast_policy_error: i32;
    // Ordinary calls to free machines contribute owner edges. Nested ordinary
    // calls retain their exact state identity in state_invocations instead;
    // both checks prevent a suspended invocation's cells from being re-entered.
    call_edge_heads: [i32; 4096];
    call_edge_targets: [i32; 32768];
    call_edge_next: [i32; 32768];
    call_edge_offsets: [i32; 32768];
    call_edge_count: i32;
    // A declared crash ceiling admits Trap and publishes it to callers.
    machine_allows_trap: [i32; 4096];
    // -1 = omitted, 0 = blocks false, 1 = blocks. A private omitted
    // bound infers. The published envelope is distinct from its call marker.
    block_bounds: [i32; 4096];
    // The published and inferred state effects use bit 1 for blocking, bit 2 for Trap.
    state_effects: [i32; 16384];
    state_incoming: [i32; 16384];
    // 32,768 ordinary calls plus 16,384 transition arms.
    state_invocations: [OmegaStateInvocation; 49152];
    state_invocation_count: i32;
    effect_work: [i32; 16384];
    invocation_seen: [i32; 16384];
    call_colors: [i32; 4096];
    // Completed DFS order places every admitted callee before its callers.
    call_order: [i32; 4096];
    call_order_count: i32;
    // An omitted ceiling is -1. Each resolved service member is a trait row.
    reach_clauses: [i32; 4096];
    reach_members: [i32; 16384];
    // Reused for one service identity at a time in call order.
    published_reach: [i32; 4096];
    call_walk: [i32; 4096];
    call_cursors: [i32; 4096];
    // Expression folding scratch. eval_order collects one terminal
    // expression's subtree in preorder (children always carry larger slot
    // positions than their parent), then a reverse scan folds children
    // before their consumers; operand_values holds each visited node's
    // folded value (0..255) or -2 for an unsupported form, and
    // operand_classes tags every folded node - 0 for an anonymous exact
    // number, 1 for a Boolean. fold_value receives the completed root
    // value and fold_class its class. Refusal anchors belong to the checking
    // context; neither evaluation nor literal scanning may replace them.
    operand_values: [i32; 16384];
    operand_classes: [i32; 16384];
    eval_order: [i32; 16384];
    eval_count: i32;
    eval_scan: i32;
    fold_value: i32;
    fold_class: i32;
    // The folded transition subject under the arm scan: subject_class is 0
    // for an anonymous numeric value and 1 for a Boolean in subject_value.
    subject_class: i32;
    subject_value: i32;
    // Canonical outcome tuple for the eventual OCOUT publication
    // (outcome.epsilon). The contract assigns Reject codes 1..12; producers
    // here record the lexical codes 2..9 through the scanner diagnostic
    // projection, duplicate_name, missing_entry, and
    // integer_literal_out_of_range. outcome_code stays -1 where the syntax
    // and checking Reject inventory and the coverage provisions are still
    // unassigned; the frame encoder refuses every unassigned code, so these
    // fields cannot publish a noncanonical frame. This diagnostic adapter's
    // single anonymous source unit reports zero canonical ordinals.
    outcome_tag: i32;
    outcome_space: i32;
    outcome_code: i32;
    outcome_coordinate: i32;
    outcome_package_ordinal: i32;
    outcome_unit_ordinal: i32;
    outcome_limit: i32;
    outcome_requested: i32;
    emission_resource: i32;
}

machine OmegaScalarCompiler::span_equals(
    &mut self, source: &[u8], start: i32, end: i32, expected: &[u8]
) -> i32 {
    transition end - start == expected.len {
        true -> compare(0)
        _ -> return 0
    }

    state compare(index: i32) {
        transition index < expected.len {
            true -> byte(index)
            _ -> return 1
        }
    }

    state byte(index: i32) {
        transition source[start + index] == expected[index] {
            true -> compare(index + 1)
            _ -> return 0
        }
    }
}

// Refusal recorders own the status and canonical outcome tuple so the check
// states and the expression fold share one write site each.
machine OmegaScalarCompiler::record_reject(
    &mut self, code: i32, space: i32, coordinate: i32
) {
    self.status = OmegaScalarCompilationStatus::Reject;
    self.outcome_tag = 1;
    self.outcome_space = space;
    self.outcome_code = code;
    self.outcome_coordinate = coordinate;
    self.outcome_limit = 0;
    self.outcome_requested = 0;
    return;
}

machine OmegaScalarCompiler::record_incomplete(
    &mut self, space: i32, coordinate: i32
) {
    // Type inference may already have diagnosed a bad name or storage path.
    // An unknown result cannot replace that failure with a coverage refusal.
    transition self.status {
        OmegaScalarCompilationStatus::Pending -> retain(space, coordinate)
        _ -> return
    }
    state retain(failure_space: i32, failure_coordinate: i32) {
        self.status = OmegaScalarCompilationStatus::Incomplete;
        self.outcome_tag = 2;
        self.outcome_space = failure_space;
        self.outcome_code = -1;
        self.outcome_coordinate = failure_coordinate;
        self.outcome_limit = 0;
        self.outcome_requested = 0;
        return;
    }
}

machine OmegaScalarCompiler::record_internal(&mut self) {
    self.status = OmegaScalarCompilationStatus::InternalFailure;
    self.outcome_tag = 3;
    self.outcome_space = 3;
    self.outcome_code = 1;
    self.outcome_coordinate = 0;
    self.outcome_limit = 0;
    self.outcome_requested = 0;
    return;
}

// The anonymous folder and integer guards use the same radix and range rules
// as typed expressions. Their result codes retain their original public shape.
machine OmegaScalarCompiler::scan_u8(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    self.scan_scalar_literal(source, start, end, 8);
    transition self.literal_status {
        1 -> return self.literal_value
        2 -> return 256
        _ -> return 257
    }
}


// Resolve a call-target name to the index of a free machine declaring that
// exact path member, or -1 when no admitted machine carries the name.
// Machines with qualified paths own no plain name and are skipped.
machine OmegaScalarCompiler::resolve_machine(
    &mut self, source: &[u8], start: i32, end: i32
) -> i32 {
    return self.resolve_declaration(source, start, end, OmegaDeclarationKind::Machine);
}

// Each declaration owns the direct children in its lexical scope. Skip a
// child's subtree when comparing siblings, then continue in the parent scope.
machine OmegaScalarCompiler::resolve_state(
    &mut self, source: &[u8], caller: i32, start: i32, end: i32
) -> i32 {
    transition true { true -> scan(caller, caller + 1) }

    state scan(scope: i32, candidate: i32) {
        transition candidate < self.parser.machine_states[self.local_state_row(scope)].subtree_end {
            true -> compare(scope, candidate)
            _ -> ascend(self.parser.machine_states[self.local_state_row(scope)].lexical_parent)
        }
    }

    state compare(scope: i32, candidate: i32) {
        let name: OmegaRelativeSpan = self.parser.machine_states[self.local_state_row(candidate)].name;
        transition self.span_equals(source, name.start, name.end, source[start..end]) {
            1 -> return candidate
            _ -> scan(scope, self.parser.machine_states[self.local_state_row(candidate)].subtree_end)
        }
    }

    state ascend(parent: i32) {
        transition parent < 0 {
            true -> return -1
            _ -> scan(parent, parent + 1)
        }
    }
}

// Fold a bounded subset of anonymous exact arithmetic and Boolean expressions.
// Anonymous nodes do not acquire u8 meaning from their destination. This
// implementation retains only integral intermediate values in 0..255; a wider
// or fractional intermediate is unsupported, never silently narrowed. Returns
// 0 with self.fold_value and self.fold_class (0 = anonymous number, 1 = Boolean),
// 1 when any node is an unsupported form, or 2 after the
// source's refusal tuple has been recorded through the shared recorders.
// Children always precede their parents in eval_order, so one preorder
// collect followed by a reverse scan evaluates every operand before its
// consumer without recursion.
machine OmegaScalarCompiler::fold_expression(
    &mut self, source: &[u8], root: i32
) -> i32 {
    self.eval_order[0] = root;
    self.eval_count = 1;
    self.eval_scan = 0;
    transition true { true -> collect() }

    state collect() {
        transition self.eval_scan < self.eval_count {
            true -> collect_node()
            _ -> fold_start()
        }
    }

    state collect_node() {
        let expression: i32 = self.eval_order[self.eval_scan];
        self.eval_scan = self.eval_scan + 1;
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Binary -> collect_binary(expression)
            OmegaExpressionKind::Unary -> collect_unary(expression)
            _ -> collect()
        }
    }

    // The subtree is bounded by the parser's expression arena, so the collect
    // worklist can never exceed its capacity; the guard is the bounded form.
    state collect_binary(expression: i32) {
        transition self.eval_count + 2 <= 16384 {
            true -> collect_binary_bounded(expression)
            _ -> fail_internal()
        }
    }

    state collect_binary_bounded(expression: i32) {
        let row: OmegaBinaryExpressionSyntax = self.parser.binary_expressions[
            self.parser.expressions[expression].payload0];
        self.eval_order[self.eval_count] = row.left;
        self.eval_order[self.eval_count + 1] = row.right;
        self.eval_count = self.eval_count + 2;
        transition true { true -> collect() }
    }

    state collect_unary(expression: i32) {
        transition self.eval_count < 16384 {
            true -> collect_unary_bounded(expression)
            _ -> fail_internal()
        }
    }

    state collect_unary_bounded(expression: i32) {
        self.eval_order[self.eval_count] = self.parser.unary_expressions[
            self.parser.expressions[expression].payload0].operand;
        self.eval_count = self.eval_count + 1;
        transition true { true -> collect() }
    }

    state fold_start() {
        self.eval_scan = self.eval_count;
        transition true { true -> fold_next() }
    }

    state fold_next() {
        transition self.eval_scan > 0 {
            true -> fold_node()
            _ -> finish()
        }
    }

    state fold_node() {
        self.eval_scan = self.eval_scan - 1;
        let expression: i32 = self.eval_order[self.eval_scan];
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Integer -> integer(expression)
            OmegaExpressionKind::Boolean -> boolean(expression)
            OmegaExpressionKind::Binary -> fold_binary(expression)
            OmegaExpressionKind::Unary -> fold_unary(expression)
            _ -> mark_unsupported(expression)
        }
    }

    // A Boolean literal folds to its 0/1 payload under the Boolean class.
    state boolean(expression: i32) {
        self.operand_values[expression] =
            self.parser.expressions[expression].payload0;
        self.operand_classes[expression] = 1;
        transition true { true -> fold_next() }
    }

    // Width-dependent anonymous complement and signed intermediate values
    // are outside this bounded folder. Boolean negation retains its class.
    state fold_unary(expression: i32) {
        let row: OmegaUnaryExpressionSyntax = self.parser.unary_expressions[
            self.parser.expressions[expression].payload0];
        transition self.operand_values[row.operand] >= 0 {
            true -> fold_unary_operator(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_unary_operator(expression: i32, row: OmegaUnaryExpressionSyntax) {
        transition row.operator {
            OmegaUnaryOperatorKind::LogicalNot -> fold_logical_not(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    // `!x` complements a Boolean operand; a u8 operand is a carrier-class
    // rejection at the operator.
    state fold_logical_not(expression: i32, row: OmegaUnaryExpressionSyntax) {
        transition self.operand_classes[row.operand] == 1 {
            true -> fold_logical_not_value(expression, row)
            _ -> reject_unary_operator(row)
        }
    }

    state fold_logical_not_value(expression: i32, row: OmegaUnaryExpressionSyntax) {
        transition self.operand_values[row.operand] == 1 {
            true -> store_folded(expression, 0, 1)
            _ -> store_folded(expression, 1, 1)
        }
    }

    state reject_unary_operator(row: OmegaUnaryExpressionSyntax) {
        self.record_reject(-1, 4, row.operator_start);
        return 2;
    }

    state integer(expression: i32) {
        let value: i32 = self.scan_u8(source,
            self.parser.expressions[expression].payload0,
            self.parser.expressions[expression].payload1);
        transition value < 256 {
            true -> store(expression, value)
            _ -> integer_failed(expression, value)
        }
    }

    state integer_failed(expression: i32, value: i32) {
        transition value == 256 {
            true -> non_digit()
            _ -> out_of_range(expression)
        }
    }

    state non_digit() {
        self.record_incomplete(4, self.literal_offset);
        return 2;
    }

    state out_of_range(expression: i32) {
        transition expression == root {
            true -> reject_literal(expression)
            _ -> mark_unsupported(expression)
        }
    }

    state reject_literal(expression: i32) {
        self.record_reject(12, 4,
            self.parser.expressions[expression].payload0);
        return 2;
    }

    state store(expression: i32, value: i32) {
        self.operand_values[expression] = value;
        self.operand_classes[expression] = 0;
        transition true { true -> fold_next() }
    }

    state fold_binary(expression: i32) {
        let row: OmegaBinaryExpressionSyntax = self.parser.binary_expressions[
            self.parser.expressions[expression].payload0];
        transition (self.operand_values[row.left] >= 0) &&
            (self.operand_values[row.right] >= 0) {
            true -> fold_class_route(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    // Arithmetic consumes anonymous exact numbers; ordering compares them.
    // Neither operation introduces a computational carrier. Equality
    // compares same-class operands; the logical operators take Boolean
    // operands to a Boolean result. A class mismatch is a carrier-class
    // rejection at the operator, not an unsupported form.
    state fold_class_route(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> fold_equality(expression, row)
            OmegaBinaryOperatorKind::NotEqual -> fold_equality(expression, row)
            OmegaBinaryOperatorKind::Less -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::LessEqual -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::Greater -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::GreaterEqual -> fold_ordered(expression, row)
            OmegaBinaryOperatorKind::And -> fold_logical(expression, row)
            OmegaBinaryOperatorKind::Or -> fold_logical(expression, row)
            _ -> fold_u8_operands(expression, row)
        }
    }

    state fold_u8_operands(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_classes[row.left] == 0) &&
            (self.operand_classes[row.right] == 0) {
            true -> fold_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> fold_add(expression, row)
            OmegaBinaryOperatorKind::Subtract -> fold_subtract(expression, row)
            OmegaBinaryOperatorKind::Multiply -> fold_multiply(expression, row)
            OmegaBinaryOperatorKind::Divide -> fold_divide(expression, row)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_add(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <=
            255 - self.operand_values[row.right] {
            true -> store_folded(expression,
                self.operand_values[row.left] + self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_subtract(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] >= self.operand_values[row.right] {
            true -> store_folded(expression,
                self.operand_values[row.left] - self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    state fold_multiply(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.right] == 0 {
            true -> store_folded(expression, 0, 0)
            _ -> fold_multiply_bounded(expression, row)
        }
    }

    state fold_multiply_bounded(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <=
            255 / self.operand_values[row.right] {
            true -> store_folded(expression,
                self.operand_values[row.left] * self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    // A zero divisor is an undefined operand under every arithmetic policy,
    // not a representability failure.
    state fold_divide(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.right] == 0 {
            true -> reject_operator(row)
            _ -> fold_integral_divide(expression, row)
        }
    }

    state fold_integral_divide(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] % self.operand_values[row.right] == 0 {
            true -> store_folded(expression,
                self.operand_values[row.left] / self.operand_values[row.right], 0)
            _ -> mark_unsupported(expression)
        }
    }

    // Equality admits same-class operands: two anonymous numbers or Booleans,
    // and produces a Boolean result; mixed classes are a carrier-class
    // rejection at the operator.
    state fold_equality(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_classes[row.left] ==
            self.operand_classes[row.right] {
            true -> fold_equality_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_equality_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> fold_equal(expression, row)
            _ -> fold_not_equal(expression, row)
        }
    }

    state fold_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] ==
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_not_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] !=
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    // Ordering compares anonymous numbers and produces a Boolean result.
    state fold_ordered(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_classes[row.left] == 0) &&
            (self.operand_classes[row.right] == 0) {
            true -> fold_ordered_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_ordered_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Less -> fold_less(expression, row)
            OmegaBinaryOperatorKind::LessEqual -> fold_less_equal(expression, row)
            OmegaBinaryOperatorKind::Greater -> fold_greater(expression, row)
            _ -> fold_greater_equal(expression, row)
        }
    }

    state fold_less(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_less_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] <=
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_greater(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] >
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_greater_equal(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition self.operand_values[row.left] >=
            self.operand_values[row.right] {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    // The logical operators combine Boolean operands into a Boolean result.
    state fold_logical(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_classes[row.left] == 1) &&
            (self.operand_classes[row.right] == 1) {
            true -> fold_logical_operator(expression, row)
            _ -> reject_operator(row)
        }
    }

    state fold_logical_operator(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::And -> fold_and(expression, row)
            _ -> fold_or(expression, row)
        }
    }

    state fold_and(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_values[row.left] == 1) &&
            (self.operand_values[row.right] == 1) {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state fold_or(expression: i32, row: OmegaBinaryExpressionSyntax) {
        transition (self.operand_values[row.left] == 1) ||
            (self.operand_values[row.right] == 1) {
            true -> store_folded(expression, 1, 1)
            _ -> store_folded(expression, 0, 1)
        }
    }

    state reject_operator(row: OmegaBinaryExpressionSyntax) {
        self.record_reject(-1, 4, row.operator_start);
        return 2;
    }

    state store_folded(expression: i32, value: i32, class: i32) {
        self.operand_values[expression] = value;
        self.operand_classes[expression] = class;
        transition true { true -> fold_next() }
    }

    state mark_unsupported(expression: i32) {
        self.operand_values[expression] = -2;
        transition true { true -> fold_next() }
    }

    state finish() {
        transition self.operand_values[root] >= 0 {
            true -> complete()
            _ -> return 1
        }
    }

    state complete() {
        self.fold_value = self.operand_values[root];
        self.fold_class = self.operand_classes[root];
        return 0;
    }

    state fail_internal() {
        self.record_internal();
        return 2;
    }
}

// Preserve the complete supported scalar type, including policy. Unknown
// constraints stay unsupported; a domain is never erased to reach its carrier.
machine OmegaScalarCompiler::primitive_type(
    &mut self, source: &[u8], type_index: i32
) -> i32 {
    let row: OmegaTypeReferenceSyntax = self.parser.type_references[type_index];
    transition row.kind {
        OmegaTypeReferenceKind::Named -> named(row)
        OmegaTypeReferenceKind::Constrained -> constrained(row)
        _ -> return 0
    }
    state named(row: OmegaTypeReferenceSyntax) {
        return self.scalar_name(source, row.payload0, row.payload1);
    }
    state constrained(row: OmegaTypeReferenceSyntax) {
        let base: OmegaTypeReferenceSyntax = self.parser.type_references[row.payload0];
        transition base.kind {
            OmegaTypeReferenceKind::Named -> return self.policy_word(self.primitive_type(source, row.payload0),
                self.word_policy(source, row.payload1, row.payload2))
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::scalar_name(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    transition self.span_equals(source, start, end, "bool") {
        1 -> return 1
        _ -> return self.integer_carrier(source, start, end)
    }
}

// Type names and integer suffixes share these executable carrier identities.
// A retained suffix outside this subset cannot become an anonymous integer.
machine OmegaScalarCompiler::integer_carrier(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    transition self.span_equals(source, start, end, "u8") {
        1 -> return 8
        _ -> word()
    }
    state word() {
        transition self.span_equals(source, start, end, "u32") {
            1 -> return 32
            _ -> signed_word()
        }
    }
    state signed_word() {
        transition self.span_equals(source, start, end, "i32") {
            1 -> return 33
            _ -> wide()
        }
    }
    state wide() {
        transition self.span_equals(source, start, end, "u64") {
            1 -> return 64
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::literal_carrier(&mut self, source: &[u8], row: OmegaExpressionSyntax) -> i32 {
    transition row.payload2 == 0 {
        true -> return 0
        _ -> landed(self.integer_carrier(source, row.payload2, row.payload1))
    }
    state landed(carrier: i32) {
        transition carrier == 0 { true -> return -1 _ -> return carrier }
    }
}

// The low byte is the carrier width. Only these carrier/policy pairs have
// checking, storage and emission rules in this compiler.
machine OmegaScalarCompiler::word_policy(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    transition self.span_equals(source, start, end, "Trapping") {
        1 -> return 256
        _ -> wrapping()
    }
    state wrapping() {
        transition self.span_equals(source, start, end, "Wrapping") {
            1 -> return 512
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::policy_word(&mut self, carrier: i32, policy: i32) -> i32 {
    transition ((policy == 256) && ((carrier == 32) || (carrier == 64))) ||
        ((policy == 512) && (carrier == 64)) {
        true -> return policy + carrier
        _ -> return 0
    }
}

machine OmegaScalarCompiler::is_policy_word(&mut self, kind: i32) -> i32 {
    transition (kind == 288) || (kind == 320) || (kind == 576) { true -> return 1 _ -> return 0 }
}

// Read every entry of the same 'as' before choosing the operand's type.
// Trapping and Wrapping are mutually exclusive. An unrecognized domain needs
// its own establishment rules and cannot be accounted for as either policy.
machine OmegaScalarCompiler::read_cast_policies(&mut self, source: &[u8],
    last: i32) -> OmegaCastPolicyStatus {
    let first: i32 = self.parser.cast_expressions[last].first_entry;
    self.cast_operand = self.parser.cast_expressions[first].value;
    transition true { true -> entry(first, 0, 0) }
    state entry(index: i32, incoming: i32, outgoing: i32) {
        let current: OmegaCastExpressionSyntax = self.parser.cast_expressions[index];
        self.cast_policy_error = current.domain.start;
        let policy: i32 = self.word_policy(source, current.domain.start, current.domain.end);
        transition policy == 0 {
            true -> return OmegaCastPolicyStatus::UnsupportedDomain
            _ -> unique(index, incoming, outgoing, policy)
        }
    }
    state unique(index: i32, incoming: i32, outgoing: i32, policy: i32) {
        transition (policy == incoming) || (policy == outgoing) {
            true -> return OmegaCastPolicyStatus::ConflictingEntries
            _ -> operation(index, incoming, outgoing, policy)
        }
    }
    state operation(index: i32, incoming: i32, outgoing: i32, policy: i32) {
        transition self.parser.cast_expressions[index].kind {
            OmegaCastKind::AddDomain -> add(index, incoming, outgoing, policy)
            OmegaCastKind::RemoveDomain -> remove(index, incoming, outgoing, policy)
            OmegaCastKind::KeepDomain -> keep(index, incoming, outgoing, policy)
            _ -> return OmegaCastPolicyStatus::UnsupportedDomain
        }
    }
    state add(index: i32, incoming: i32, outgoing: i32, policy: i32) {
        transition outgoing == 0 {
            true -> next(index, incoming, policy)
            _ -> return OmegaCastPolicyStatus::ConflictingEntries
        }
    }
    state remove(index: i32, incoming: i32, outgoing: i32, policy: i32) {
        transition incoming == 0 {
            true -> next(index, policy, outgoing)
            _ -> return OmegaCastPolicyStatus::ConflictingEntries
        }
    }
    state keep(index: i32, incoming: i32, outgoing: i32, policy: i32) {
        transition (incoming == 0) && (outgoing == 0) {
            true -> next(index, policy, policy)
            _ -> return OmegaCastPolicyStatus::ConflictingEntries
        }
    }
    state next(index: i32, incoming: i32, outgoing: i32) {
        transition index < last {
            true -> entry(index + 1, incoming, outgoing)
            _ -> finish(incoming, outgoing)
        }
    }
    state finish(incoming: i32, outgoing: i32) {
        self.cast_input_policy = incoming;
        self.cast_output_policy = outgoing;
        return OmegaCastPolicyStatus::Complete;
    }
}

machine OmegaScalarCompiler::cast_word(&mut self, carrier: i32, policy: i32) -> i32 {
    transition policy == 0 { true -> return carrier _ -> return self.policy_word(carrier, policy) }
}

machine OmegaScalarCompiler::parameter_type(
    &mut self, source: &[u8], parameter_index: i32
) -> i32 {
    let parameter: OmegaMachineParameterSyntax =
        self.parser.machine_parameters[self.parameter_syntax_row(parameter_index)];
    let kind: i32 = self.scalar_type(source, parameter.type_reference);
    // The parser's legacy mutable flag also marks exclusive reference access.
    // Referent authority comes from the Reference type, not carrier mutability;
    // rebinding a reference carrier remains unsupported by place checking.
    transition (parameter.is_const == 0) && (parameter.is_self == 0) &&
        ((parameter.is_mutable == 0) || ((kind >= 400000) && (kind < 504096)) ||
            (omega_array_reference_row(kind) >= 0)) {
        true -> retain(kind)
        _ -> return 0
    }
    state retain(kind: i32) {
        let array: i32 = omega_array_reference_row(kind);
        transition (array >= 0) && (self.construction.active == 1) {
            true -> parameter_array(kind, array)
            _ -> return kind
        }
    }
    state parameter_array(kind: i32, array: i32) {
        let slot: i32 = 32768 + parameter_index;
        self.construction.arrays[slot].count = self.array_count(source, array);
        self.construction.arrays[slot].element = self.array_element_kind(source, array);
        return omega_array_reference(16384 + slot, kind / 100000 - 4);
    }
}

// A suffix fixes the carrier before storage, arguments, returns and bounds.
// Status 4 reports a different destination at the authored literal.
machine OmegaScalarCompiler::scan_integer(&mut self, source: &[u8], row: OmegaExpressionSyntax, expected: i32) {
    transition row.payload2 == 0 {
        true -> self.scan_scalar_literal(source, row.payload0, row.payload1, expected)
        _ -> fixed(self.integer_carrier(source, row.payload2, row.payload1))
    }
    state fixed(carrier: i32) {
        transition carrier == 0 { true -> unsupported() _ -> destination(carrier) }
    }
    state destination(carrier: i32) {
        transition carrier == expected {
            true -> self.scan_scalar_literal(source, row.payload0, row.payload2, expected)
            _ -> mismatched()
        }
    }
    state unsupported() { self.literal_status = 2; }
    state mismatched() { self.literal_status = 4; }
}

// Accumulate four base-65536 digits. Each multiplication fits Epsilon's i32.
// The upper pair becomes Alpha's high word only for a full u64 destination.
machine OmegaScalarCompiler::scan_scalar_literal(
    &mut self, source: &[u8], start: i32, end: i32, expected: i32
) {
    self.literal_status = 0;
    self.literal_high = 0;
    transition (start + 1 < end) && (source[start] == '0') {
        true -> prefix(source[start + 1])
        _ -> digit(start, 10, 0, 0, 0, 0)
    }
    state prefix(letter: i32) {
        transition letter {
            'x' -> digit(start + 2, 16, 0, 0, 0, 0)
            'X' -> digit(start + 2, 16, 0, 0, 0, 0)
            'o' -> digit(start + 2, 8, 0, 0, 0, 0)
            'O' -> digit(start + 2, 8, 0, 0, 0, 0)
            'b' -> digit(start + 2, 2, 0, 0, 0, 0)
            'B' -> digit(start + 2, 2, 0, 0, 0, 0)
            _ -> digit(start, 10, 0, 0, 0, 0)
        }
    }
    state digit(cursor: i32, radix: i32, high: i32, midhigh: i32, midlow: i32, low: i32) {
        transition cursor < end {
            true -> byte(cursor, radix, high, midhigh, midlow, low, source[cursor])
            _ -> finish(high, midhigh, midlow, low)
        }
    }
    state byte(cursor: i32, radix: i32, high: i32, midhigh: i32, midlow: i32, low: i32, value: i32) {
        transition value == '_' {
            true -> digit(cursor + 1, radix, high, midhigh, midlow, low)
            _ -> value_digit(cursor, radix, high, midhigh, midlow, low, omega_hex_value(value))
        }
    }
    state value_digit(cursor: i32, radix: i32, high: i32, midhigh: i32, midlow: i32, low: i32, value: i32) {
        transition (value >= 0) && (value < radix) {
            true -> accumulate(cursor, radix, high, midhigh, midlow, low * radix + value)
            _ -> invalid_digit(cursor)
        }
    }
    state invalid_digit(cursor: i32) { self.literal_offset = cursor; self.literal_status = 2; }
    state accumulate(cursor: i32, radix: i32, high: i32, midhigh: i32, midlow: i32, low: i32) {
        let second: i32 = midlow * radix + low / 65536;
        let third: i32 = midhigh * radix + second / 65536;
        let fourth: i32 = high * radix + third / 65536;
        transition fourth < 65536 {
            true -> digit(cursor + 1, radix, fourth, third % 65536, second % 65536, low % 65536)
            _ -> out_of_range()
        }
    }
    state finish(high: i32, midhigh: i32, midlow: i32, low: i32) {
        self.literal_value = omega_literal_word(midlow, low);
        transition (high == 0) && (midhigh == 0) {
            true -> low_word(midlow, low)
            _ -> upper_word(high, midhigh)
        }
    }
    state low_word(midlow: i32, low: i32) {
        transition (expected == 32) || (expected == 64) ||
            ((expected == 33) && (midlow < 32768)) ||
            ((expected == 8) && (midlow == 0) && (low < 256)) {
            true -> narrow()
            _ -> out_of_range()
        }
    }
    state upper_word(high: i32, midhigh: i32) {
        transition expected == 64 {
            true -> wide(high, midhigh)
            _ -> out_of_range()
        }
    }
    state wide(high: i32, midhigh: i32) {
        self.literal_high = omega_literal_word(high, midhigh);
        self.literal_status = 5;
    }
    state narrow() { self.literal_status = 1; }
    state out_of_range() { self.literal_status = 3; }
}

// Keep the bit pattern of the entire word even when its i32 representation is negative.
machine omega_literal_word(high: i32, low: i32) -> i32 {
    transition high < 32768 {
        true -> return high * 65536 + low
        _ -> return (high - 65536) * 65536 + low
    }
}

// Lookup sees this state's parameters and only already completed local
// declarations. Initializers cannot read their own not-yet-created binding;
// nested states never capture another state's values.
machine OmegaScalarCompiler::value_cell(
    &mut self, source: &[u8], state_index: i32, before: i32,
    start: i32, end: i32
) -> i32 {
    transition true { true -> parameter(0) }
    state parameter(offset: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
        transition offset < body.parameter_count {
            true -> parameter_name(offset)
            _ -> local(0)
        }
    }
    state parameter_name(offset: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
        let slot: i32 = body.first_parameter + offset;
        let name: OmegaRelativeSpan = self.parser.machine_parameters[self.parameter_syntax_row(slot)].name;
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return slot
            _ -> parameter(offset + 1)
        }
    }
    state local(offset: i32) {
        transition offset < before {
            true -> local_kind(offset)
            _ -> return -1
        }
    }
    state local_kind(offset: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
        let row: OmegaStatementSyntax = self.parser.statements[body.first_statement + offset];
        transition row.kind {
            OmegaStatementKind::LocalData -> local_name(offset, row.item_index)
            _ -> local(offset + 1)
        }
    }
    state local_name(offset: i32, local_index: i32) {
        let name: OmegaRelativeSpan = self.parser.local_data_statements[local_index].name;
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return 16384 + local_index
            _ -> local(offset + 1)
        }
    }
}

machine OmegaScalarCompiler::retain_edge(
    &mut self, caller: i32, state_index: i32, callee: i32, coordinate: i32, acknowledgements: i32
) -> i32 {
    transition self.call_edge_count < 32768 {
        true -> retain()
        _ -> fail()
    }
    state retain() {
        let edge: i32 = self.call_edge_count;
        self.call_edge_targets[edge] = callee;
        self.call_edge_offsets[edge] = coordinate;
        self.call_edge_next[edge] = self.call_edge_heads[caller];
        self.call_edge_heads[caller] = edge;
        self.call_edge_count = edge + 1;
        return self.retain_state_invocation(state_index, self.parser.machine_items[callee].first_state,
            coordinate, acknowledgements);
    }
    state fail() { self.record_internal(); return 0; }
}

machine OmegaScalarCompiler::retain_state_invocation(
    &mut self, caller: i32, target: i32, coordinate: i32, acknowledgements: i32
) -> i32 {
    transition self.state_invocation_count < 49152 {
        true -> retain(self.state_invocation_count)
        _ -> fail()
    }
    state retain(edge: i32) {
        self.state_invocations[edge].caller = caller;
        self.state_invocations[edge].target = target;
        self.state_invocations[edge].nested_call = 0;
        self.state_invocations[edge].before = -1;
        self.state_invocations[edge].first_argument = -1;
        self.state_invocations[edge].argument_count = -1;
        self.state_invocations[edge].guard = -1;
        self.state_invocations[edge].truth = 0;
        self.state_invocations[edge].next = self.state_incoming[target];
        self.state_invocations[edge].coordinate = coordinate;
        self.state_invocations[edge].acknowledgements = acknowledgements;
        self.state_incoming[target] = edge;
        self.state_invocation_count = edge + 1;
        return 1;
    }
    state fail() { self.record_internal(); return 0; }
}

// Invocation operands remain tied to their checked source state. Global calls
// cannot target private nested entries; their rows keep the absent context.
machine OmegaScalarCompiler::retain_arrival_context(
    &mut self, before: i32, first: i32, count: i32, guard: i32, truth: i32
) {
    let edge: i32 = self.state_invocation_count - 1;
    self.state_invocations[edge].before = before;
    self.state_invocations[edge].first_argument = first;
    self.state_invocations[edge].argument_count = count;
    self.state_invocations[edge].guard = guard;
    self.state_invocations[edge].truth = truth;
}

// A missing private entry contract may propose one fixed-index interval.
// It is an assumption for checking this body until every arrival discharges it.
// Explicit contracts and externally callable entries never acquire requirements.
machine OmegaScalarCompiler::infer_private_index(
    &mut self, source: &[u8], state_index: i32, before: i32,
    expression: i32, extent: i32
) -> i32 {
    let row: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
    transition (row.lexical_parent >= 0) && (row.requirement_count == 0) && (extent > 0) {
        true -> parameter(self.u64_index_parameter(source, state_index, before, expression))
        _ -> return 0
    }
    state parameter(index: i32) {
        transition (index >= 0) && (self.preserve_entry_place(state_index, before, index, 0) == 1) {
            true -> existing(index)
            _ -> return 0
        }
    }
    state existing(index: i32) {
        transition self.inferred_index_bound[state_index] {
            0 -> capacity(index)
            _ -> same(index, self.entry_bounds[self.bound_first[state_index]])
        }
    }
    state capacity(index: i32) {
        transition (self.bound_count[state_index] == 0) && (self.bound_total < 16384) {
            true -> retain(index)
            _ -> return 0
        }
    }
    state retain(index: i32) {
        let bound: i32 = self.bound_total;
        self.bound_first[state_index] = bound;
        self.bound_count[state_index] = 1;
        self.entry_bounds[bound].kind = OmegaEntryBoundKind::Interval;
        self.entry_bounds[bound].root = index;
        self.entry_bounds[bound].offset = 0;
        self.entry_bounds[bound].field = -1;
        self.entry_bounds[bound].minimum = 0;
        self.entry_bounds[bound].maximum = extent - 1;
        self.inferred_index_bound[state_index] = 1;
        self.bound_total = bound + 1;
        return 1;
    }
    state same(index: i32, bound: OmegaEntryBound) {
        transition bound.root == index {
            true -> tighten()
            _ -> return 0
        }
    }
    state tighten() {
        let bound: i32 = self.bound_first[state_index];
        transition self.entry_bounds[bound].maximum > extent - 1 {
            true -> narrower(bound)
            _ -> return 1
        }
    }
    state narrower(bound: i32) {
        self.entry_bounds[bound].maximum = extent - 1;
        return 1;
    }
}

// Incoming-edge cycles cannot prove their own proposed entry assumptions.
// Stop at this owner's boundary; ordinary cross-owner recursion is separately
// refused by the existing call graph. Shared predecessors are not cycles.
machine OmegaScalarCompiler::private_arrival_acyclic(&mut self, owner: i32, target: i32) -> i32 {
    transition true { true -> clear(self.parser.machine_items[owner].first_state) }
    state clear(index: i32) {
        transition index < self.parser.machine_items[owner].first_state + self.parser.machine_items[owner].state_count {
            true -> cleared(index)
            _ -> seed()
        }
    }
    state cleared(index: i32) {
        self.invocation_seen[index] = 0;
        transition true { true -> clear(index + 1) }
    }
    state seed() {
        self.call_walk[0] = target;
        self.call_cursors[0] = self.state_incoming[target];
        self.invocation_seen[target] = 1;
        transition true { true -> walk(0) }
    }
    state walk(depth: i32) {
        let edge: i32 = self.call_cursors[depth];
        transition edge >= 0 {
            true -> incoming(depth, self.state_invocations[edge])
            _ -> leave(depth)
        }
    }
    state incoming(depth: i32, row: OmegaStateInvocation) {
        self.call_cursors[depth] = row.next;
        transition self.state_owners[row.caller] == owner {
            true -> color(depth, row)
            _ -> walk(depth)
        }
    }
    state color(depth: i32, row: OmegaStateInvocation) {
        transition self.invocation_seen[row.caller] {
            0 -> push(depth, row.caller)
            1 -> cycle(row.coordinate)
            _ -> walk(depth)
        }
    }
    state push(depth: i32, caller: i32) {
        transition depth + 1 < 4096 {
            true -> entered(depth + 1, caller)
            _ -> cycle(self.diagnostic_offset)
        }
    }
    state entered(depth: i32, caller: i32) {
        self.invocation_seen[caller] = 1;
        self.call_walk[depth] = caller;
        self.call_cursors[depth] = self.state_incoming[caller];
        transition true { true -> walk(depth) }
    }
    state leave(depth: i32) {
        self.invocation_seen[self.call_walk[depth]] = 2;
        transition depth { 0 -> return 1 _ -> walk(depth - 1) }
    }
    state cycle(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
}

// This owner is checked completely before it can emit. Revisit every ordinary
// and terminal arrival, including earlier calls checked before the body proposed
// its requirement. No sampled caller or inferred cycle can stand for the rest.
machine OmegaScalarCompiler::check_private_arrivals(&mut self, source: &[u8], owner: i32) -> i32 {
    transition true { true -> next_state(self.parser.machine_items[owner].first_state) }
    state next_state(index: i32) {
        transition index < self.parser.machine_items[owner].first_state + self.parser.machine_items[owner].state_count {
            true -> inferred(index)
            _ -> return 1
        }
    }
    state inferred(index: i32) {
        transition self.inferred_index_bound[index] {
            1 -> acyclic(index)
            _ -> next_state(index + 1)
        }
    }
    state acyclic(index: i32) {
        transition (self.state_incoming[index] >= 0) && (self.private_arrival_acyclic(owner, index) == 1) {
            true -> incoming(index, self.state_incoming[index])
            _ -> unsupported(self.parser.machine_states[self.local_state_row(index)].name.start)
        }
    }
    state incoming(index: i32, edge: i32) {
        transition edge >= 0 {
            true -> context(index, self.state_invocations[edge])
            _ -> next_state(index + 1)
        }
    }
    state context(index: i32, row: OmegaStateInvocation) {
        self.diagnostic_offset = row.coordinate;
        transition (self.state_owners[row.caller] == owner) && (row.before >= 0) &&
            (row.first_argument >= 0) && (row.argument_count == self.state_parameter_count(index)) {
            true -> prove(index, row)
            _ -> unsupported(row.coordinate)
        }
    }
    state prove(index: i32, row: OmegaStateInvocation) {
        transition self.check_call_bounds(source, row.caller, row.before,
            row.first_argument, row.argument_count, index, row.guard, row.truth) {
            1 -> incoming(index, row.next)
            _ -> return 0
        }
    }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
}

// An inferred zero denotes anonymous numeric syntax, not a chosen carrier.
// The complete destination or a typed comparison peer chooses its landing.
machine OmegaScalarCompiler::expression_type(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    expression: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::String -> return omega_shared_byte_slice()
        OmegaExpressionKind::Integer -> return self.literal_carrier(source, row)
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Indexed -> return self.index_result_type(source, state_index, before, expression)
        OmegaExpressionKind::Projection -> member(row, self.expression_type(source, owner, state_index, before, row.payload0))
        OmegaExpressionKind::StructLiteral -> literal(self.parser.struct_literals[row.payload0])
        OmegaExpressionKind::Path -> path(row)
        OmegaExpressionKind::Call -> call(self.parser.call_expressions[row.payload0])
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        OmegaExpressionKind::Unary -> unary(self.parser.unary_expressions[row.payload0])
        OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[row.payload0])
        _ -> return -1
    }
    state member(row: OmegaExpressionSyntax, kind: i32) {
        transition (kind >= 100000) && (kind < 104096) {
            true -> field(self.resolve_field(source, kind - 100000, row.payload1, row.payload2))
            _ -> return -1
        }
    }
    state field(slot: i32) {
        transition slot >= 0 {
            true -> return self.field_types[slot]
            _ -> return -1
        }
    }
    state path(row: OmegaExpressionSyntax) {
        transition row.payload3 > 1 {
            true -> return self.case_value_type(source, row)
            _ -> place()
        }
    }
    state literal(row: OmegaStructLiteralSyntax) {
        transition row.type_member_count > 1 {
            true -> return self.qualified_case_type(source, row.first_type_member, row.type_member_count)
            _ -> return -1
        }
    }
    state place() {
        transition self.check_place(source, state_index, before, expression) {
            1 -> return self.place_types[expression]
            _ -> return -1
        }
    }
    state call(call: OmegaCallExpressionSyntax) {
        transition call.has_receiver {
            0 -> nested_call(call, self.resolve_state(source, state_index, call.target.start, call.target.end))
            _ -> global_call(call)
        }
    }
    state nested_call(call: OmegaCallExpressionSyntax, target: i32) {
        transition target >= 0 { true -> return self.state_types[target] _ -> global_call(call) }
    }
    state global_call(call: OmegaCallExpressionSyntax) {
        let callee: i32 = self.resolve_call_machine(source, call);
        transition callee >= 0 {
            true -> return self.state_types[self.parser.machine_items[callee].first_state]
            _ -> return -1
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::BitwiseAnd -> arithmetic(row)
            OmegaBinaryOperatorKind::Add -> arithmetic(row)
            OmegaBinaryOperatorKind::Subtract -> arithmetic(row)
            OmegaBinaryOperatorKind::Multiply -> arithmetic(row)
            OmegaBinaryOperatorKind::Equal -> return 1
            OmegaBinaryOperatorKind::NotEqual -> return 1
            OmegaBinaryOperatorKind::Less -> return 1
            OmegaBinaryOperatorKind::LessEqual -> return 1
            OmegaBinaryOperatorKind::Greater -> return 1
            OmegaBinaryOperatorKind::GreaterEqual -> return 1
            OmegaBinaryOperatorKind::And -> return 1
            OmegaBinaryOperatorKind::Or -> return 1
            _ -> return 0
        }
    }
    state arithmetic(row: OmegaBinaryExpressionSyntax) {
        let left: i32 = self.expression_type(source, owner, state_index, before, row.left);
        let right: i32 = self.expression_type(source, owner, state_index, before, row.right);
        transition (self.is_policy_word(left) == 1) {
            true -> return left
            _ -> right_policy(left, right)
        }
    }
    state right_policy(left: i32, right: i32) {
        transition (self.is_policy_word(right) == 1) || (left == 0) {
            true -> return right
            _ -> return left
        }
    }
    state unary(row: OmegaUnaryExpressionSyntax) {
        transition row.operator {
            OmegaUnaryOperatorKind::LogicalNot -> return 1
            OmegaUnaryOperatorKind::Dereference -> place()
            OmegaUnaryOperatorKind::Negate -> magnitude_type(self.parser.expressions[row.operand])
            _ -> return 0
        }
    }
    state magnitude_type(row: OmegaExpressionSyntax) {
        transition row.kind {
            OmegaExpressionKind::Integer -> return self.literal_carrier(source, row)
            _ -> return 0
        }
    }
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::Carrier -> return self.scalar_type(source, row.target_type)
            _ -> cast_domain(row)
        }
    }
    state cast_domain(row: OmegaCastExpressionSyntax) {
        transition self.read_cast_policies(source, self.parser.expressions[expression].payload0) {
            OmegaCastPolicyStatus::Complete -> cast_source(self.cast_operand, self.cast_input_policy, self.cast_output_policy)
            _ -> return -1
        }
    }
    state cast_source(operand: i32, incoming: i32, outgoing: i32) {
        let kind: i32 = self.expression_type(source, owner, state_index, before, operand);
        transition (kind > 0) && (kind == self.cast_word(kind % 256, incoming)) {
            true -> cast_result(self.cast_word(kind % 256, outgoing))
            _ -> return -1
        }
    }
    state cast_result(kind: i32) { transition kind > 0 { true -> return kind _ -> return -1 } }

}

machine OmegaScalarCompiler::check_value_arguments(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    first_argument: i32, count: i32, first_parameter: i32, transfer: i32
) -> i32 {
    transition true { true -> next(0, self.loan_count) }
    state next(offset: i32, first_loan: i32) {
        transition offset < count {
            true -> storage(offset, first_loan)
            _ -> complete(first_loan)
        }
    }
    state storage(offset: i32, first_loan: i32) {
        transition self.require_cell(source, 32768 + first_argument + offset,
            self.parameter_types[first_parameter + offset]) {
            1 -> value(offset, first_loan)
            _ -> failed(first_loan)
        }
    }
    state value(offset: i32, first_loan: i32) {
        transition (transfer == 1) && (self.parameter_types[first_parameter + offset] >= 400000) {
            true -> forward(offset, first_loan)
            _ -> ordinary(offset, first_loan)
        }
    }
    state forward(offset: i32, first_loan: i32) {
        transition self.check_forward_reference(source, state_index, before,
            self.parser.call_arguments[first_argument + offset],
            self.parameter_types[first_parameter + offset]) {
            1 -> next(offset + 1, first_loan)
            _ -> failed(first_loan)
        }
    }
    state ordinary(offset: i32, first_loan: i32) {
        transition self.check_value(source, owner, state_index, before,
            self.parser.call_arguments[first_argument + offset],
            self.parameter_types[first_parameter + offset]) {
            1 -> next(offset + 1, first_loan)
            _ -> failed(first_loan)
        }
    }
    state complete(first_loan: i32) { self.loan_count = first_loan; return 1; }
    state failed(first_loan: i32) { self.loan_count = first_loan; return 0; }
}

// Check one representation across locals, parameters, calls and expressions.
// Exact unsigned addition needs a bound proof; policy arithmetic retains its
// explicit carrier and checked crash route. Comparisons produce canonical bools.
machine OmegaScalarCompiler::check_value(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    expression: i32, expected: i32
) -> i32 {
    self.value_states[expression] = state_index;
    self.value_befores[expression] = before;
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition self.uninhabited_type(expected) {
        1 -> uninhabited_result(row)
        _ -> value_storage(row)
    }
    state uninhabited_result(row: OmegaExpressionSyntax) {
        transition row.kind {
            OmegaExpressionKind::Call -> call(self.parser.call_expressions[row.payload0])
            OmegaExpressionKind::StructLiteral -> rejected(self.parser.struct_literals[row.payload0].start)
            OmegaExpressionKind::Integer -> rejected(row.payload0)
            OmegaExpressionKind::Boolean -> rejected(row.payload1)
            _ -> unsupported(self.diagnostic_offset)
        }
    }
    state value_storage(row: OmegaExpressionSyntax) {
        transition self.require_cell(source, 49152 + expression, expected) {
            1 -> expression_kind(row)
            _ -> return 0
        }
    }
    state expression_kind(row: OmegaExpressionSyntax) {
    transition row.kind {
        OmegaExpressionKind::String -> return self.check_quoted_bytes(expression, expected)
        OmegaExpressionKind::Path -> path()
        OmegaExpressionKind::Indexed -> indexed()
        OmegaExpressionKind::Projection -> member(row, self.expression_type(source, owner, state_index, before, row.payload0))
        OmegaExpressionKind::Borrow -> borrow(row)
        OmegaExpressionKind::ArrayLiteral -> return self.check_array_literal(source, owner, state_index, before, expression, expected)
        OmegaExpressionKind::StructLiteral -> return self.check_record_literal(source, owner, state_index, before, expression, expected)
        OmegaExpressionKind::Call -> call(self.parser.call_expressions[row.payload0])
        OmegaExpressionKind::Integer -> integer(row)
        OmegaExpressionKind::Boolean -> boolean(row)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        OmegaExpressionKind::Unary -> unary(self.parser.unary_expressions[row.payload0])
        OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[row.payload0])
        _ -> constant()
    }
    }
    state path() {
        transition self.parser.expressions[expression].payload3 > 1 {
            true -> return self.check_case_value(source, expression, expected)
            _ -> ordinary_path()
        }
    }
    state ordinary_path() {
        transition expected >= 400000 {
            true -> return self.check_forward_reference(source, state_index, before, expression, expected)
            _ -> return self.check_place_value(source, state_index, before, expression, expected)
        }
    }
    state borrow(row: OmegaExpressionSyntax) {
        transition expected == omega_shared_byte_slice() {
            true -> explicit_range(row)
            _ -> return self.check_borrow(source, state_index, before, expression, expected)
        }
    }
    state explicit_range(row: OmegaExpressionSyntax) {
        transition row.payload1 == 0 {
            true -> return self.check_byte_range(source, state_index, before, expression, row.payload0)
            _ -> unsupported(row.payload2)
        }
    }
    state indexed() {
        transition expected == omega_shared_byte_slice() {
            true -> return self.check_byte_range(source, state_index, before, expression, expression)
            _ -> indexed_element()
        }
    }
    state indexed_element() {
        let row: OmegaIndexedExpressionSyntax = self.parser.indexed_expressions[self.parser.expressions[expression].payload0];
        let slot: i32 = self.byte_slice_parameter(source, state_index, before, row.base);
        transition slot >= 0 {
            true -> byte_read(row, slot)
            _ -> fixed_element()
        }
    }
    state byte_read(row: OmegaIndexedExpressionSyntax, slot: i32) {
        transition expected == 8 {
            true -> return self.check_shared_byte_read(source, state_index, before, expression, row, slot)
            _ -> rejected(row.start)
        }
    }
    state fixed_element() {
        transition self.copy_index_element(source, expected) > 0 {
            true -> indexed_place()
            _ -> unsupported(self.diagnostic_offset)
        }
    }
    state indexed_place() {
        transition self.check_index(source, state_index, before, expression, 0) {
            1 -> indexed_type()
            _ -> return 0
        }
    }
    state indexed_type() {
        transition self.place_types[expression] == expected {
            true -> retain(OmegaCheckedValueKind::IndexedRead, expression)
            _ -> rejected(self.diagnostic_offset)
        }
    }
    state member(row: OmegaExpressionSyntax, kind: i32) {
        transition (kind >= 100000) && (kind < 104096) {
            true -> member_base(row, kind)
            _ -> unsupported(row.payload1)
        }
    }
    state member_base(row: OmegaExpressionSyntax, kind: i32) {
        transition self.check_value(source, owner, state_index, before, row.payload0, kind) {
            1 -> member_field(row, self.resolve_field(source, kind - 100000, row.payload1, row.payload2))
            _ -> return 0
        }
    }
    state member_field(row: OmegaExpressionSyntax, field: i32) {
        transition field >= 0 {
            true -> member_type(row, field)
            _ -> rejected(row.payload1)
        }
    }
    state member_type(row: OmegaExpressionSyntax, field: i32) {
        transition self.field_types[field] == expected {
            true -> member_copy(row, field)
            _ -> rejected(row.payload1)
        }
    }
    state member_copy(row: OmegaExpressionSyntax, field: i32) {
        transition self.type_copy(source, expected) {
            1 -> retain(OmegaCheckedValueKind::ProjectedRead, field)
            _ -> unsupported(row.payload1)
        }
    }
    state integer(row: OmegaExpressionSyntax) {
        transition (expected == 8) || (expected == 32) || (expected == 33) || (expected == 64) {
            true -> integer_scan(row)
            _ -> rejected(row.payload0)
        }
    }
    state integer_scan(row: OmegaExpressionSyntax) {
        self.scan_integer(source, row, expected);
        transition self.literal_status {
            1 -> retain(OmegaCheckedValueKind::Literal, self.literal_value)
            5 -> wide_literal()
            2 -> unsupported(row.payload0)
            4 -> rejected(row.payload0)
            _ -> literal_range(row.payload0)
        }
    }
    state wide_literal() {
        self.wide_literal_highs[expression] = self.literal_high;
        transition true { true -> retain(OmegaCheckedValueKind::WideLiteral, self.literal_value) }
    }
    state literal_range(coordinate: i32) {
        self.record_reject(12, 4, coordinate);
        return 0;
    }
    state boolean(row: OmegaExpressionSyntax) {
        transition expected == 1 {
            true -> retain(OmegaCheckedValueKind::Literal, row.payload0)
            _ -> rejected(row.payload1)
        }
    }
    state call(call: OmegaCallExpressionSyntax) {
        transition (self.call_has_static_target(call) == 1) && (call.machine_argument_count == 0) {
            true -> target(call)
            _ -> unsupported(call.start)
        }
    }
    state target(call: OmegaCallExpressionSyntax) {
        transition (call.has_receiver != 0) ||
            (self.resolve_state(source, state_index, call.target.start, call.target.end) < 0) {
            true -> global_target(call)
            _ -> nested(call)
        }
    }
    state nested(call: OmegaCallExpressionSyntax) {
        transition self.check_helper_name(source, state_index, before, call.target) {
            1 -> nested_arity(call, self.resolve_state(source, state_index, call.target.start, call.target.end))
            _ -> return 0
        }
    }
    state nested_arity(call: OmegaCallExpressionSyntax, target: i32) {
        transition call.argument_count == self.state_parameter_count(target) {
            true -> nested_result(call, target)
            _ -> rejected(call.start)
        }
    }
    state nested_result(call: OmegaCallExpressionSyntax, target: i32) {
        transition (self.state_types[target] == expected) || (self.uninhabited_type(self.state_types[target]) == 1) {
            true -> nested_arguments(call, target)
            _ -> rejected(call.start)
        }
    }
    state nested_arguments(call: OmegaCallExpressionSyntax, target: i32) {
        transition self.check_value_arguments(source, owner, state_index, before,
            call.first_argument, call.argument_count, self.state_first_parameter(target), 0) {
            1 -> nested_contract(call, target)
            _ -> return 0
        }
    }
    state nested_contract(call: OmegaCallExpressionSyntax, target: i32) {
        transition self.check_call_bounds(source, state_index, before, call.first_argument,
            call.argument_count, target, -1, 0) {
            1 -> nested_edge(call, target)
            _ -> return 0
        }
    }
    state nested_edge(call: OmegaCallExpressionSyntax, target: i32) {
        transition self.retain_state_invocation(state_index, target, call.start, call.acknowledgements) {
            1 -> nested_effects(call, target)
            _ -> return 0
        }
    }
    state nested_effects(call: OmegaCallExpressionSyntax, target: i32) {
        self.state_invocations[self.state_invocation_count - 1].nested_call = 1;
        self.retain_arrival_context(before, call.first_argument, call.argument_count, -1, 0);
        transition self.retain_call_effects(state_index, before, call.first_argument,
            call.argument_count, self.state_first_parameter(target)) {
            1 -> retain(OmegaCheckedValueKind::NestedCall, target)
            _ -> return 0
        }
    }
    state global_target(call: OmegaCallExpressionSyntax) {
        let callee: i32 = self.resolve_call_machine(source, call);
        transition callee >= 0 {
            true -> arity(call, callee)
            _ -> unresolved_call(call)
        }
    }
    state unresolved_call(call: OmegaCallExpressionSyntax) {
        transition call.has_receiver {
            1 -> unresolved_receiver(call, self.parser.expressions[call.receiver])
            _ -> bare_call(call)
        }
    }
    state bare_call(call: OmegaCallExpressionSyntax) {
        transition self.check_terminal_invocation(source, owner, state_index, before, call.first_argument,
            call.argument_count, self.terminal_declaration_coordinate(source, 0, 0, call.target), call.start, call.target) {
            1 -> physical(call)
            _ -> return 0
        }
    }
    state unresolved_receiver(call: OmegaCallExpressionSyntax, receiver: OmegaExpressionSyntax) {
        transition receiver.kind {
            OmegaExpressionKind::Path -> named_receiver(call, receiver)
            _ -> rejected(call.target.start)
        }
    }
    state named_receiver(call: OmegaCallExpressionSyntax, receiver: OmegaExpressionSyntax) {
        transition self.check_terminal_invocation(source, owner, state_index, before, call.first_argument,
            call.argument_count, self.terminal_declaration_coordinate(source, receiver.payload0, receiver.payload1, call.target),
            call.start, call.target) {
            1 -> physical(call)
            _ -> return 0
        }
    }
    state physical(call: OmegaCallExpressionSyntax) {
        transition call.acknowledgements == 0 {
            true -> retain(OmegaCheckedValueKind::ProcessTerminal, self.parser.call_arguments[call.first_argument])
            _ -> unsupported(call.start)
        }
    }
    state arity(call: OmegaCallExpressionSyntax, callee: i32) {
        transition call.argument_count == self.state_parameter_count(
            self.parser.machine_items[callee].first_state) {
            true -> result_type(call, callee)
            _ -> rejected(call.start)
        }
    }
    state result_type(call: OmegaCallExpressionSyntax, callee: i32) {
        let result: i32 = self.state_types[self.parser.machine_items[callee].first_state];
        transition (result == expected) || (self.uninhabited_type(result) == 1) {
            true -> arguments(call, callee)
            _ -> rejected(call.start)
        }
    }
    state arguments(call: OmegaCallExpressionSyntax, callee: i32) {
        transition self.check_value_arguments(source, owner, state_index, before,
            call.first_argument, call.argument_count, self.state_first_parameter(
            self.parser.machine_items[callee].first_state), 0) {
            1 -> contract(call, callee)
            _ -> return 0
        }
    }
    state contract(call: OmegaCallExpressionSyntax, callee: i32) {
        transition self.check_call_bounds(source, state_index, before, call.first_argument, call.argument_count,
            self.parser.machine_items[callee].first_state, -1, 0) {
            1 -> edge(call, callee)
            _ -> return 0
        }
    }
    state edge(call: OmegaCallExpressionSyntax, callee: i32) {
        transition (self.retain_edge(owner, state_index, callee, call.start, call.acknowledgements) == 1) &&
            (self.retain_call_effects(state_index, before, call.first_argument, call.argument_count,
                self.state_first_parameter(self.parser.machine_items[callee].first_state)) == 1) {
            true -> retain(OmegaCheckedValueKind::Call, callee)
            _ -> return 0
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::BitwiseAnd -> bitmask(row)
            OmegaBinaryOperatorKind::Add -> arithmetic(row)
            OmegaBinaryOperatorKind::Subtract -> arithmetic(row)
            OmegaBinaryOperatorKind::Multiply -> arithmetic(row)
            OmegaBinaryOperatorKind::And -> logical(row)
            OmegaBinaryOperatorKind::Or -> logical(row)
            OmegaBinaryOperatorKind::Equal -> comparison(row)
            OmegaBinaryOperatorKind::NotEqual -> comparison(row)
            OmegaBinaryOperatorKind::Less -> comparison(row)
            OmegaBinaryOperatorKind::LessEqual -> comparison(row)
            OmegaBinaryOperatorKind::Greater -> comparison(row)
            OmegaBinaryOperatorKind::GreaterEqual -> comparison(row)
            _ -> constant()
        }
    }
    state bitmask(row: OmegaBinaryExpressionSyntax) {
        transition expected == 33 {
            true -> bit_operands(row)
            _ -> constant()
        }
    }
    state bit_operands(row: OmegaBinaryExpressionSyntax) {
        transition (self.check_value(source, owner, state_index, before, row.left, expected) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, expected) == 1) {
            true -> mask_right(row)
            _ -> return 0
        }
    }
    state mask_right(row: OmegaBinaryExpressionSyntax) {
        transition self.is_low_mask(row.right) {
            1 -> retain(OmegaCheckedValueKind::LowBits, row.left)
            _ -> mask_left(row)
        }
    }
    state mask_left(row: OmegaBinaryExpressionSyntax) {
        transition self.is_low_mask(row.left) {
            1 -> retain(OmegaCheckedValueKind::LowBits, row.right)
            _ -> unsupported(row.operator_start)
        }
    }
    state arithmetic(row: OmegaBinaryExpressionSyntax) {
        transition true {
            true -> arithmetic_types(row,
                self.expression_type(source, owner, state_index, before, row.left),
                self.expression_type(source, owner, state_index, before, row.right))
        }
    }
    state arithmetic_types(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left >= 0) && (right >= 0) {
            true -> arithmetic_known(row, left, right)
            _ -> unsupported(row.operator_start)
        }
    }
    state arithmetic_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (self.is_policy_word(left) == 1) {
            true -> policy_result(row, left, right, left)
            _ -> arithmetic_right_policy(row, left, right)
        }
    }
    state arithmetic_right_policy(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (self.is_policy_word(right) == 1) {
            true -> policy_result(row, left, right, right)
            _ -> plain_operator(row, left, right)
        }
    }
    state plain_operator(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (expected == 32) && ((left == 32) || (right == 32)) &&
            ((left == 0) || (left == 32)) && ((right == 0) || (right == 32)) {
            true -> word_operator(row)
            _ -> exact_operator(row, left, right)
        }
    }
    state word_operator(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> word_operands(row)
            OmegaBinaryOperatorKind::Multiply -> word_operands(row)
            _ -> constant()
        }
    }
    state word_operands(row: OmegaBinaryExpressionSyntax) {
        transition (self.check_value(source, owner, state_index, before, row.left, 32) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, 32) == 1) {
            true -> word_proof(row)
            _ -> return 0
        }
    }
    state word_proof(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> word_sum(row)
            _ -> return self.check_exact_word(expression, row)
        }
    }
    state word_sum(row: OmegaBinaryExpressionSyntax) {
        transition (self.interval_literal(row.right) == 1) &&
            (self.formal_successor_bound(source, state_index, before, row.left) == 1) {
            true -> retain(OmegaCheckedValueKind::ExactAddition, self.parser.expressions[expression].payload0)
            _ -> return self.check_exact_word(expression, row)
        }
    }
    state exact_operator(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> addition(row)
            OmegaBinaryOperatorKind::Subtract -> subtraction(row, left, right)
            _ -> constant()
        }
    }
    // A receiving qualification never selects policy arithmetic. An actual
    // qualified operand selects the core family; its peer must carry that
    // same policy/carrier or the plain carrier. Anonymous peers land plainly.
    state policy_result(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition expected == policy {
            true -> policy_left(row, left, right, policy)
            _ -> rejected(row.operator_start)
        }
    }
    state policy_left(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition left == 0 {
            true -> policy_right(row, policy % 256, right, policy)
            _ -> policy_left_known(row, left, right, policy)
        }
    }
    state policy_left_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition (left == policy) || (left == policy % 256) {
            true -> policy_right(row, left, right, policy)
            _ -> rejected(row.operator_start)
        }
    }
    state policy_right(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition right == 0 {
            true -> policy_operator(row, left, policy % 256, policy)
            _ -> policy_right_known(row, left, right, policy)
        }
    }
    state policy_right_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition (right == policy) || (right == policy % 256) {
            true -> policy_operator(row, left, right, policy)
            _ -> rejected(row.operator_start)
        }
    }
    state policy_operator(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, policy: i32) {
        transition policy == 576 {
            true -> policy_operands(row, left, right, OmegaCheckedValueKind::WrappingArithmetic)
            _ -> policy_operands(row, left, right, OmegaCheckedValueKind::TrappingArithmetic)
        }
    }
    state policy_operands(row: OmegaBinaryExpressionSyntax, left: i32, right: i32, kind: OmegaCheckedValueKind) {
        transition (self.check_value(source, owner, state_index, before, row.left, left) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, right) == 1) {
            true -> policy_kind(row, kind)
            _ -> return 0
        }
    }
    state policy_kind(row: OmegaBinaryExpressionSyntax, kind: OmegaCheckedValueKind) {
        transition kind {
            OmegaCheckedValueKind::TrappingArithmetic -> policy_effect(row)
            _ -> retain(kind, self.parser.expressions[expression].payload0)
        }
    }
    state policy_effect(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Subtract -> subtract_effect(row)
            _ -> possible_trap()
        }
    }
    state subtract_effect(row: OmegaBinaryExpressionSyntax) {
        transition self.value_kinds[row.right] {
            OmegaCheckedValueKind::Literal -> subtract_literal(row, self.value_payloads[row.right])
            _ -> possible_trap()
        }
    }
    // For unsigned x - k, underflow is impossible exactly when x >= k.
    // Keep the checked operation in the tape even when its route is discharged.
    state subtract_literal(row: OmegaBinaryExpressionSyntax, amount: i32) {
        transition (amount >= 0) &&
            (self.prove_bound(source, state_index, before, row.left, amount, -1, -1, 0) == 1) {
            true -> checked_arithmetic()
            _ -> possible_trap()
        }
    }
    state possible_trap() {
        self.state_effects[state_index] = self.state_effects[state_index] | 2;
        transition true { true -> checked_arithmetic() }
    }
    state checked_arithmetic() {
        transition true { true -> retain(OmegaCheckedValueKind::TrappingArithmetic, self.parser.expressions[expression].payload0) }
    }
    // A plain unsigned difference needs evidence that its right operand
    // cannot exceed its left operand. Only a small checked constant can
    // become an endpoint in the interval proof.
    state subtraction(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (expected == 64) && ((left == 64) || (right == 64)) {
            true -> subtract_operands(row)
            _ -> constant()
        }
    }
    state subtract_operands(row: OmegaBinaryExpressionSyntax) {
        transition (self.check_value(source, owner, state_index, before, row.left, 64) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, 64) == 1) {
            true -> subtract_bounds(row, self.interval_literal(row.left), self.interval_literal(row.right))
            _ -> return 0
        }
    }
    state subtract_bounds(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition ((left >= 0) && (self.prove_ceiling(source, state_index, before, row.right, left) == 1)) ||
            ((right >= 0) && ((right == 0) ||
                (self.prove_bound(source, state_index, before, row.left, right, -1, -1, 0) == 1))) {
            true -> retain(OmegaCheckedValueKind::ExactSubtraction, self.parser.expressions[expression].payload0)
            _ -> unsupported(row.operator_start)
        }
    }
    state addition(row: OmegaBinaryExpressionSyntax) {
        let kind: i32 = self.expression_type(source, owner, state_index, before, row.left);
        transition (kind == 64) || ((kind == 8) &&
            (self.unsigned_formal(source, state_index, before, row.left, 1) >= 0)) {
            true -> unsigned_add(row, kind)
            _ -> constant()
        }
    }
    state unsigned_add(row: OmegaBinaryExpressionSyntax, kind: i32) {
        transition expected == kind { true -> add_right(row) _ -> unsupported(row.operator_start) }
    }
    state add_right(row: OmegaBinaryExpressionSyntax) {
        transition self.parser.expressions[row.right].kind {
            OmegaExpressionKind::Integer -> add_operands(row)
            _ -> unsupported(row.operator_start)
        }
    }
    state add_operands(row: OmegaBinaryExpressionSyntax) {
        transition (self.check_value(source, owner, state_index, before, row.left, expected) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, expected) == 1) {
            true -> add_limit(row, self.interval_literal(row.right))
            _ -> return 0
        }
    }
    state add_limit(row: OmegaBinaryExpressionSyntax, amount: i32) {
        transition ((expected == 64) && (amount >= 0) &&
            (self.prove_ceiling(source, state_index, before, row.left, 2147483647 - amount) == 1)) ||
            ((amount == 1) && (self.formal_successor_bound(source, state_index, before, row.left) == 1)) {
            true -> retain(OmegaCheckedValueKind::ExactAddition, self.parser.expressions[expression].payload0)
            _ -> unsupported(row.operator_start)
        }
    }
    state logical(row: OmegaBinaryExpressionSyntax) {
        transition expected == 1 {
            true -> operands(row, 1)
            _ -> rejected(row.operator_start)
        }
    }
    state comparison(row: OmegaBinaryExpressionSyntax) {
        transition expected == 1 {
            true -> comparison_types(row,
                self.expression_type(source, owner, state_index, before, row.left),
                self.expression_type(source, owner, state_index, before, row.right))
            _ -> rejected(row.operator_start)
        }
    }
    state comparison_types(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left == 0) && (right == 0) {
            true -> constant()
            _ -> comparison_known(row, left, right)
        }
    }
    state comparison_known(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition ((left >= 100000) && (left < 104096)) ||
            ((right >= 100000) && (right < 104096)) {
            true -> nominal_comparison(row, left, right)
            _ -> primitive_comparison(row, left, right)
        }
    }
    state nominal_comparison(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        // Case ordinals belong to their nominal declaration. Equal ordinals
        // from different declarations never acquire an implicit comparison.
        transition left == right {
            true -> nominal_equality(row, left)
            _ -> rejected(row.operator_start)
        }
    }
    state nominal_equality(row: OmegaBinaryExpressionSyntax, kind: i32) {
        // A nullary case inside a payload-bearing sum is not enough: the
        // complete carrier must qualify for intrinsic equality.
        transition self.payload_free_sum(kind - 100000) {
            1 -> nominal_operator(row, kind)
            _ -> unsupported(row.operator_start)
        }
    }
    state nominal_operator(row: OmegaBinaryExpressionSyntax, kind: i32) {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> nominal_operands(row, kind)
            OmegaBinaryOperatorKind::NotEqual -> nominal_operands(row, kind)
            _ -> rejected(row.operator_start)
        }
    }
    state nominal_operands(row: OmegaBinaryExpressionSyntax, kind: i32) {
        // Keep the ordinary operand admission, including copy, loan and
        // effect checks. The intrinsic grants no resource permission.
        transition (self.check_value(source, owner, state_index, before, row.left, kind) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, kind) == 1) {
            true -> retain(OmegaCheckedValueKind::NullarySumComparison,
                self.parser.expressions[expression].payload0)
            _ -> return 0
        }
    }
    state primitive_comparison(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left >= 0) && (right >= 0) && (left < 100000) && (right < 100000) &&
            (left != 2) && (right != 2) {
            true -> comparison_peer(row, left, right)
            _ -> unsupported(row.operator_start)
        }
    }
    // Core policy comparisons explicitly admit a plain peer of the same
    // carrier. This does not qualify that operand or relax call admission.
    state comparison_peer(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition left == 0 {
            true -> anonymous_left(row, right)
            _ -> comparison_right(row, left, right)
        }
    }
    state anonymous_left(row: OmegaBinaryExpressionSyntax, right: i32) {
        transition (right == 8) || (right == 32) || (right == 33) || (right == 64) || (self.is_policy_word(right) == 1) {
            true -> operands_types(row, right % 256, right)
            _ -> rejected(row.operator_start)
        }
    }
    state comparison_right(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition right == 0 {
            true -> anonymous_right(row, left)
            _ -> comparison_same(row, left, right)
        }
    }
    state anonymous_right(row: OmegaBinaryExpressionSyntax, left: i32) {
        transition (left == 8) || (left == 32) || (left == 33) || (left == 64) || (self.is_policy_word(left) == 1) {
            true -> operands_types(row, left, left % 256)
            _ -> rejected(row.operator_start)
        }
    }
    state comparison_same(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition left == right {
            true -> comparison_operator(row, left)
            _ -> mixed_comparison(row, left, right)
        }
    }
    state mixed_comparison(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (left == 33) || (right == 33) {
            true -> signed_peer(row, left, right)
            _ -> comparison_policy(row, left, right)
        }
    }
    state signed_peer(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        // u8 and u32 fit Alpha's signed comparison after zero extension.
        transition (left == 8) || (left == 32) || (right == 8) || (right == 32) {
            true -> operands_types(row, left, right)
            _ -> unsupported(row.operator_start)
        }
    }
    state comparison_policy(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        // Plain computational integers compare by value without a common
        // carrier. Both supported unsigned carriers are zero-extended.
        transition ((left == 8) || (left == 32) || (left == 64)) && ((right == 8) || (right == 32) || (right == 64)) {
            true -> operands_types(row, left, right)
            _ -> comparison_policy_pair(row, left, right)
        }
    }
    state comparison_policy_pair(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition ((self.is_policy_word(left) == 1) && (right == left % 256)) ||
            ((self.is_policy_word(right) == 1) && (left == right % 256)) {
            true -> operands_types(row, left, right)
            _ -> rejected(row.operator_start)
        }
    }

    state comparison_operator(row: OmegaBinaryExpressionSyntax, operand_type: i32) {
        transition operand_type == 1 {
            true -> boolean_comparison(row)
            _ -> operands(row, operand_type)
        }
    }
    state boolean_comparison(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> operands(row, 1)
            OmegaBinaryOperatorKind::NotEqual -> operands(row, 1)
            _ -> rejected(row.operator_start)
        }
    }
    state operands(row: OmegaBinaryExpressionSyntax, operand_type: i32) {
        transition true { true -> operands_types(row, operand_type, operand_type) }
    }
    // A comparison adds no crash effect. Check each operand for its own effects.
    state operands_types(row: OmegaBinaryExpressionSyntax, left: i32, right: i32) {
        transition (self.check_value(source, owner, state_index, before, row.left, left) == 1) &&
            (self.check_value(source, owner, state_index, before, row.right, right) == 1) {
            true -> comparison_kind(left, right)
            _ -> return 0
        }
    }
    state comparison_kind(left: i32, right: i32) {
        transition (left == 33) || (right == 33) {
            true -> retain(OmegaCheckedValueKind::SignedComparison, self.parser.expressions[expression].payload0)
            _ -> retain(OmegaCheckedValueKind::BooleanBinary, self.parser.expressions[expression].payload0)
        }
    }
    state unary(row: OmegaUnaryExpressionSyntax) {
        transition row.operator {
            OmegaUnaryOperatorKind::LogicalNot -> logical_not(row)
            OmegaUnaryOperatorKind::Dereference -> return self.check_place_value(source, state_index, before, expression, expected)
            OmegaUnaryOperatorKind::Negate -> negate(row)
            _ -> constant()
        }
    }
    state negate(row: OmegaUnaryExpressionSyntax) {
        transition expected == 33 {
            true -> signed_magnitude(row, self.parser.expressions[row.operand])
            _ -> constant()
        }
    }
    state signed_magnitude(row: OmegaUnaryExpressionSyntax, operand: OmegaExpressionSyntax) {
        transition operand.kind {
            OmegaExpressionKind::Integer -> magnitude(row.operator_start, operand)
            _ -> unsupported(row.operator_start)
        }
    }
    state magnitude(start: i32, operand: OmegaExpressionSyntax) {
        transition self.literal_carrier(source, operand) {
            0 -> digits(start, operand.payload0, operand.payload1)
            33 -> digits(start, operand.payload0, operand.payload2)
            _ -> wrong_carrier(operand)
        }
    }
    state wrong_carrier(operand: OmegaExpressionSyntax) {
        transition self.literal_carrier(source, operand) < 0 {
            true -> unsupported(operand.payload0)
            _ -> rejected(operand.payload0)
        }
    }
    state digits(start: i32, first: i32, end: i32) {
        self.scan_scalar_literal(source, first, end, 32);
        transition self.literal_status {
            1 -> negate_word(start, self.literal_value)
            2 -> unsupported(start)
            _ -> literal_range(start)
        }
    }
    state negate_word(start: i32, magnitude: i32) {
        // scan_scalar_literal returns the raw u32 pattern. 2^31 is the sole
        // negative in-range pattern and already encodes the desired minimum.
        transition magnitude == -2147483648 {
            true -> retain(OmegaCheckedValueKind::NegativeI32Literal, magnitude)
            _ -> negate_small(start, magnitude)
        }
    }
    state negate_small(start: i32, magnitude: i32) {
        transition magnitude {
            0 -> retain(OmegaCheckedValueKind::Literal, 0)
            _ -> nonzero_magnitude(start, magnitude)
        }
    }
    state nonzero_magnitude(start: i32, magnitude: i32) {
        transition magnitude > 0 {
            true -> retain(OmegaCheckedValueKind::NegativeI32Literal, 0 - magnitude)
            _ -> literal_range(start)
        }
    }
    state logical_not(row: OmegaUnaryExpressionSyntax) {
        transition expected == 1 {
            true -> logical_operand(row)
            _ -> rejected(row.operator_start)
        }
    }
    state logical_operand(row: OmegaUnaryExpressionSyntax) {
        transition self.check_value(source, owner, state_index, before, row.operand, 1) {
            1 -> retain(OmegaCheckedValueKind::LogicalNot, row.operand)
            _ -> return 0
        }
    }
    // Written domain changes preserve the stored value. Expected types never
    // add or remove a qualification. Anonymous operands receive only a plain
    // carrier from the destination before the explicit addition is checked.
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::Carrier -> carrier_cast(row, self.scalar_type(source, row.target_type))
            _ -> domain_cast(row)
        }
    }
    state carrier_cast(row: OmegaCastExpressionSyntax, target: i32) {
        transition (target == 8) || (target == 32) || (target == 33) || (target == 64) {
            true -> carrier_result(row, target)
            _ -> unsupported(row.start)
        }
    }
    state carrier_result(row: OmegaCastExpressionSyntax, target: i32) {
        transition expected == target {
            true -> carrier_operand(row, target,
                self.expression_type(source, owner, state_index, before, row.value))
            _ -> rejected(row.start)
        }
    }
    state carrier_operand(row: OmegaCastExpressionSyntax, target: i32, kind: i32) {
        transition (kind == 0) || (kind == target) {
            true -> cast_value(row.value, target)
            _ -> carrier_widen(row, target, kind)
        }
    }
    state carrier_widen(row: OmegaCastExpressionSyntax, target: i32, kind: i32) {
        // Every u8 fits i32, u32 and u64. Only u64 contains every u32.
        transition ((kind == 8) && ((target == 32) || (target == 33) || (target == 64))) ||
            ((kind == 32) && (target == 64)) {
            true -> cast_value(row.value, kind)
            _ -> byte_bound(row, target, kind)
        }
    }
    state byte_bound(row: OmegaCastExpressionSyntax, target: i32, kind: i32) {
        transition (target == 8) && (kind == 33) {
            true -> byte_operand(row)
            _ -> carrier_source_domain(row, kind)
        }
    }
    state byte_operand(row: OmegaCastExpressionSyntax) {
        transition self.check_value(source, owner, state_index, before, row.value, 33) {
            1 -> byte_bits(row, self.possible_word_bits(row.value))
            _ -> return 0
        }
    }
    state byte_bits(row: OmegaCastExpressionSyntax, bits: i32) {
        transition (bits >= 0) && (bits <= 255) {
            true -> retain(OmegaCheckedValueKind::RepresentationCast, row.value)
            _ -> unsupported(row.start)
        }
    }
    state carrier_source_domain(row: OmegaCastExpressionSyntax, kind: i32) {
        transition (self.is_policy_word(kind) == 1) {
            true -> rejected(row.start)
            _ -> unsupported(row.start)
        }
    }
    state domain_cast(row: OmegaCastExpressionSyntax) {
        transition self.read_cast_policies(source, self.parser.expressions[expression].payload0) {
            OmegaCastPolicyStatus::Complete -> cast_policies(row, self.cast_operand, self.cast_input_policy, self.cast_output_policy)
            OmegaCastPolicyStatus::ConflictingEntries -> rejected(self.cast_policy_error)
            OmegaCastPolicyStatus::UnsupportedDomain -> unsupported(self.cast_policy_error)
        }
    }
    state cast_policies(row: OmegaCastExpressionSyntax, operand: i32, incoming: i32, outgoing: i32) {
        let source_type: i32 = self.cast_word(expected % 256, incoming);
        transition (source_type > 0) && (self.cast_word(expected % 256, outgoing) == expected) {
            true -> cast_value(operand, source_type)
            _ -> rejected(row.start)
        }
    }
    state cast_value(value: i32, kind: i32) {
        transition self.check_value(source, owner, state_index, before, value, kind) {
            1 -> retain(OmegaCheckedValueKind::RepresentationCast, value)
            _ -> return 0
        }
    }

    state constant() {
        transition (self.is_policy_word(expected) == 0) && (self.is_bounded_constant(source, expression) == 1) {
            true -> fold_constant()
            _ -> unsupported(self.diagnostic_offset)
        }
    }
    state fold_constant() {
        transition self.fold_expression(source, expression) {
            0 -> constant_class()
            1 -> unsupported(self.diagnostic_offset)
            _ -> return 0
        }
    }
    state constant_class() {
        transition ((self.fold_class == 1) && (expected == 1)) ||
            ((self.fold_class == 0) && ((expected == 8) || (expected == 32) || (expected == 64))) {
            true -> retain(OmegaCheckedValueKind::Literal, self.fold_value)
            _ -> rejected(self.diagnostic_offset)
        }
    }
    state retain(kind: OmegaCheckedValueKind, value: i32) {
        self.value_kinds[expression] = kind;
        self.value_payloads[expression] = value;
        return 1;
    }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Each set bit may occur in a checked unsigned value. Unknown words use all
// bits; only immutable scalar locals retain facts about their initializers.
machine OmegaScalarCompiler::possible_word_bits(&mut self, expression: i32) -> i32 {
    transition self.value_kinds[expression] {
        OmegaCheckedValueKind::Literal -> return self.value_payloads[expression]
        OmegaCheckedValueKind::ExactWordArithmetic -> return self.value_payloads[expression]
        OmegaCheckedValueKind::LowBits -> return self.low_mask(expression)
        OmegaCheckedValueKind::RepresentationCast -> return self.possible_word_bits(self.value_payloads[expression])
        OmegaCheckedValueKind::Place -> place(self.place_roots[expression])
        _ -> carrier()
    }
    state place(root: i32) {
        transition (root >= 16384) && (root < 32768) &&
            (self.place_offsets[expression] == 0) && (self.place_fields[expression] < 0) {
            true -> local(self.parser.local_data_statements[root - 16384])
            _ -> carrier()
        }
    }
    state local(row: OmegaLocalDataStatementSyntax) {
        transition (row.is_mutable == 0) && (row.has_initial_value == 1) {
            true -> return self.possible_word_bits(row.initial_value)
            _ -> carrier()
        }
    }
    state carrier() {
        transition self.cell_types[49152 + expression] == 8 {
            true -> return 255
            _ -> return -1
        }
    }
}

// A nonnegative mask contains only a contiguous run of low ones exactly
// when shifting it right by one introduces no bit that was absent before.
machine OmegaScalarCompiler::is_low_mask(&mut self, expression: i32) -> i32 {
    transition self.value_kinds[expression] {
        OmegaCheckedValueKind::Literal -> bits(self.value_payloads[expression])
        _ -> return 0
    }
    state bits(mask: i32) { return (mask >= 0) && ((mask | (mask >> 1)) == mask); }
}

machine OmegaScalarCompiler::low_mask(&mut self, expression: i32) -> i32 {
    let row: OmegaBinaryExpressionSyntax = self.parser.binary_expressions[self.parser.expressions[expression].payload0];
    transition self.value_payloads[expression] == row.left {
        true -> return self.value_payloads[row.right]
        _ -> return self.value_payloads[row.left]
    }
}

// x & (2^n-1) is the nonnegative remainder modulo 2^n. Alpha's signed
// remainder follows the dividend, so normalize it after the one evaluation
// of x. All intermediates fit a signed Alpha word, including n=31.
machine OmegaScalarCompiler::emit_low_bits(&mut self, expression: i32) -> i32 {
    transition self.emit_value(self.value_payloads[expression]) {
        1 -> scale(self.low_mask(expression))
        _ -> return 0
    }
    state scale(mask: i32) {
        transition mask == 2147483647 {
            true -> remainder(-2147483648)
            _ -> remainder(mask + 1)
        }
    }
    state remainder(low: i32) {
        return (self.tape.emit_imm(2, low, 0) == 1) && (self.tape.emit_rr(7, 0, 2) == 1) &&
            (self.tape.emit_rr(3, 0, 2) == 1) && (self.tape.emit_rr(7, 0, 2) == 1);
    }
}

// Disjoint possible bits prove that an exact sum cannot carry. A factor
// with just one possible bit is zero or a power of two; its product fits
// only if every possible source bit survives the corresponding left shift.
machine OmegaScalarCompiler::check_exact_word(
    &mut self, expression: i32, row: OmegaBinaryExpressionSyntax
) -> i32 {
    let left: i32 = self.possible_word_bits(row.left);
    let right: i32 = self.possible_word_bits(row.right);
    transition row.operator {
        OmegaBinaryOperatorKind::Add -> sum(left, right)
        _ -> product(left, right)
    }
    state sum(left: i32, right: i32) {
        transition (left & right) == 0 {
            true -> retain(left | right)
            _ -> unsupported()
        }
    }
    state product(left: i32, right: i32) {
        transition (left == 0) || (right == 0) {
            true -> retain(0)
            _ -> scale(left, right, 1, 0)
        }
    }
    state scale(left: i32, right: i32, bit: i32, amount: i32) {
        transition left == bit {
            true -> shift(right, amount)
            _ -> other(left, right, bit, amount)
        }
    }
    state other(left: i32, right: i32, bit: i32, amount: i32) {
        transition right == bit {
            true -> shift(left, amount)
            _ -> advance(left, right, bit, amount)
        }
    }
    state advance(left: i32, right: i32, bit: i32, amount: i32) {
        transition amount < 31 {
            true -> scale(left, right, bit << 1, amount + 1)
            _ -> unsupported()
        }
    }
    state shift(bits: i32, amount: i32) {
        transition amount == 0 {
            true -> retain(bits)
            _ -> shift_one(bits, amount)
        }
    }
    state shift_one(bits: i32, amount: i32) {
        transition bits >= 0 {
            true -> shift(bits << 1, amount - 1)
            _ -> unsupported()
        }
    }
    state retain(bits: i32) {
        self.value_kinds[expression] = OmegaCheckedValueKind::ExactWordArithmetic;
        self.value_payloads[expression] = bits;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, row.operator_start); return 0; }
}

// Three-color DFS over every state-owned ordinary call. All admitted state
// transfers remain inside that same owner machine, so they cannot evade this
// reentrancy check. The explicit walk is bounded by the machine arena.
machine OmegaScalarCompiler::check_call_graph(&mut self) -> i32 {
    transition true { true -> root(0) }
    state root(index: i32) {
        transition index < self.parser.machine_count {
            true -> root_color(index)
            _ -> return 1
        }
    }
    state root_color(index: i32) {
        transition self.call_colors[index] {
            0 -> begin(index)
            _ -> root(index + 1)
        }
    }
    state begin(index: i32) {
        self.call_walk[0] = index;
        self.call_cursors[0] = self.call_edge_heads[index];
        self.call_colors[index] = 1;
        transition true { true -> walk(index, 0) }
    }
    state walk(root_index: i32, depth: i32) {
        transition self.call_cursors[depth] >= 0 {
            true -> edge(root_index, depth, self.call_cursors[depth])
            _ -> finish(root_index, depth)
        }
    }
    state edge(root_index: i32, depth: i32, edge_index: i32) {
        self.call_cursors[depth] = self.call_edge_next[edge_index];
        let callee: i32 = self.call_edge_targets[edge_index];
        transition self.call_colors[callee] {
            0 -> descend(root_index, depth, callee)
            1 -> cycle(edge_index)
            _ -> walk(root_index, depth)
        }
    }
    state descend(root_index: i32, depth: i32, callee: i32) {
        transition depth + 1 < 4096 {
            true -> enter(root_index, depth + 1, callee)
            _ -> internal()
        }
    }
    state enter(root_index: i32, depth: i32, callee: i32) {
        self.call_walk[depth] = callee;
        self.call_cursors[depth] = self.call_edge_heads[callee];
        self.call_colors[callee] = 1;
        transition true { true -> walk(root_index, depth) }
    }
    state finish(root_index: i32, depth: i32) {
        self.call_colors[self.call_walk[depth]] = 2;
        self.call_order[self.call_order_count] = self.call_walk[depth];
        self.call_order_count = self.call_order_count + 1;
        transition depth {
            0 -> root(root_index + 1)
            _ -> walk(root_index, depth - 1)
        }
    }
    state cycle(edge_index: i32) {
        self.record_incomplete(4, self.call_edge_offsets[edge_index]);
        return 0;
    }
    state internal() { self.record_internal(); return 0; }
}

// A nested ordinary call suspends its caller, unlike a terminal transfer.
// Walk incoming calls and transfers from that caller: reaching the callee means
// it can re-enter the suspended invocation and overwrite its static cells.
// Terminal-only cycles remain admitted. Each state enters this bounded worklist
// once per nested call; generation marks avoid clearing the arena between calls.
machine OmegaScalarCompiler::check_nested_call_graph(&mut self) -> i32 {
    transition true { true -> next(0) }
    state next(edge: i32) {
        transition edge < self.state_invocation_count {
            true -> kind(edge, self.state_invocations[edge])
            _ -> return 1
        }
    }
    state kind(edge: i32, row: OmegaStateInvocation) {
        transition row.nested_call { 1 -> seed(edge, row) _ -> next(edge + 1) }
    }
    state seed(edge: i32, row: OmegaStateInvocation) {
        self.effect_work[0] = row.caller;
        self.invocation_seen[row.caller] = edge + 1;
        transition true { true -> walk(edge, row.target, 0, 1) }
    }
    state walk(edge: i32, target: i32, cursor: i32, count: i32) {
        transition cursor < count {
            true -> current(edge, target, cursor, count, self.effect_work[cursor])
            _ -> next(edge + 1)
        }
    }
    state current(edge: i32, target: i32, cursor: i32, count: i32, state_index: i32) {
        transition state_index == target {
            true -> cycle(edge)
            _ -> incoming(edge, target, cursor, count, self.state_incoming[state_index])
        }
    }
    state incoming(edge: i32, target: i32, cursor: i32, count: i32, predecessor: i32) {
        transition predecessor >= 0 {
            true -> predecessor_row(edge, target, cursor, count, self.state_invocations[predecessor])
            _ -> walk(edge, target, cursor + 1, count)
        }
    }
    state predecessor_row(edge: i32, target: i32, cursor: i32, count: i32, row: OmegaStateInvocation) {
        transition self.invocation_seen[row.caller] == edge + 1 {
            true -> incoming(edge, target, cursor, count, row.next)
            _ -> enqueue(edge, target, cursor, count, row)
        }
    }
    state enqueue(edge: i32, target: i32, cursor: i32, count: i32, row: OmegaStateInvocation) {
        transition count < self.program_state_count() {
            true -> retain(edge, target, cursor, count, row)
            _ -> internal()
        }
    }
    state retain(edge: i32, target: i32, cursor: i32, count: i32, row: OmegaStateInvocation) {
        self.invocation_seen[row.caller] = edge + 1;
        self.effect_work[count] = row.caller;
        transition true { true -> incoming(edge, target, cursor, count + 1, row.next) }
    }
    state cycle(edge: i32) { self.record_incomplete(4, self.state_invocations[edge].coordinate); return 0; }
    state internal() { self.record_internal(); return 0; }
}

// The anonymous folder has a deliberately smaller implementation range.
// Exceeding it is coverage refusal, not a claim that Omega rejects the value.
machine OmegaScalarCompiler::is_bounded_constant(&mut self, source: &[u8], expression: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Integer -> integer(row)
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Unary -> return self.is_bounded_constant(source, self.parser.unary_expressions[row.payload0].operand)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        _ -> return 0
    }
    state integer(row: OmegaExpressionSyntax) {
        transition (row.payload2 == 0) && (self.scan_u8(source, row.payload0, row.payload1) < 256) {
            true -> return 1
            _ -> return 0
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition (self.is_bounded_constant(source, row.left) == 1) &&
            (self.is_bounded_constant(source, row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Constant specialization is permitted only when no runtime binding or call
// occurs anywhere in the subject. Dynamic Boolean subjects use checked values.
machine OmegaScalarCompiler::is_constant_expression(&mut self, expression: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Integer -> return row.payload2 == 0
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Unary -> return self.is_constant_expression(self.parser.unary_expressions[row.payload0].operand)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[row.payload0])
        _ -> return 0
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition (self.is_constant_expression(row.left) == 1) &&
            (self.is_constant_expression(row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// A visible value binding takes precedence over a nested machine of the
// same name. A scalar cannot be called. Other indirect calls need a checked
// callable representation before this compiler can emit them.
machine OmegaScalarCompiler::check_helper_name(
    &mut self, source: &[u8], state_index: i32, before: i32, name: OmegaRelativeSpan
) -> i32 {
    transition self.pattern_binding(source, name) >= 0 {
        true -> unsupported()
        _ -> binding(self.value_cell(source, state_index, before, name.start, name.end))
    }
    state binding(cell: i32) {
        transition cell >= 0 {
            true -> type(self.cell_types[cell])
            _ -> return 1
        }
    }
    state type(kind: i32) {
        transition (kind > 0) && (kind < 100000) {
            true -> noncallable()
            _ -> unsupported()
        }
    }
    state noncallable() { self.record_reject(-1, 4, name.start); return 0; }
    state unsupported() { self.record_incomplete(4, name.start); return 0; }
}

machine OmegaScalarCompiler::check_transition_target(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32, row_index: i32
) -> i32 {
    let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
    self.transition_targets[row_index] = -1;
    transition row.target_kind {
        OmegaTransitionTargetKind::Result -> return self.check_value(source, owner, state_index,
            before, row.result_expression, self.state_types[state_index])
        OmegaTransitionTargetKind::Machine -> target(row)
        OmegaTransitionTargetKind::Terminal -> unit(row.target.start)
    }
    state unit(coordinate: i32) {
        transition self.state_types[state_index] == 2 { true -> return 1 _ -> reject(coordinate) }
    }
    state target(row: OmegaTransitionStatementSyntax) {
        let target: i32 = self.resolve_state(source, state_index, row.target.start, row.target.end);
        transition target >= 0 {
            true -> helper(row, target)
            _ -> outside_owner(row)
        }
    }
    state helper(row: OmegaTransitionStatementSyntax, target: i32) {
        transition self.check_helper_name(source, state_index, before, row.target) {
            1 -> signature(row, target)
            _ -> return 0
        }
    }
    // Ordinary terminal calls may name globals, but this static-cell slice
    // only emits transfers within one owner. A visible global is outside
    // coverage, not a missing machine; do not misreport a valid terminal call.
    state outside_owner(row: OmegaTransitionStatementSyntax) {
        transition self.resolve_machine(source, row.target.start, row.target.end) >= 0 {
            true -> unsupported(row.target.start)
            _ -> reject(row.target.start)
        }
    }
    state signature(row: OmegaTransitionStatementSyntax, target: i32) {
        transition (row.argument_count == self.state_parameter_count(target)) &&
            (self.state_types[state_index] == self.state_types[target]) {
            true -> arguments(row, target)
            _ -> reject(row.start)
        }
    }
    state arguments(row: OmegaTransitionStatementSyntax, target: i32) {
        transition self.check_value_arguments(source, owner, state_index, before,
            row.first_argument, row.argument_count, self.state_first_parameter(target), 1) {
            1 -> contract(row, target)
            _ -> return 0
        }
    }
    state contract(row: OmegaTransitionStatementSyntax, target: i32) {
        transition row.guard_kind {
            OmegaTransitionGuardKind::Predicate -> prove(row, target, row.guard_expression, 1)
            _ -> subject_contract(row, target)
        }
    }
    state subject_contract(row: OmegaTransitionStatementSyntax, target: i32) {
        transition row.has_subject {
            1 -> guard(row, target)
            _ -> prove(row, target, -1, 0)
        }
    }
    state guard(row: OmegaTransitionStatementSyntax, target: i32) {
        transition row.guard_kind {
            OmegaTransitionGuardKind::Boolean -> prove(row, target, row.subject, row.guard_boolean)
            _ -> prove(row, target, -1, 0)
        }
    }
    state prove(row: OmegaTransitionStatementSyntax, target: i32, guard: i32, truth: i32) {
        transition self.check_call_bounds(source, state_index, before, row.first_argument, row.argument_count,
            target, guard, truth) {
            1 -> retain(row, target, guard, truth)
            _ -> return 0
        }
    }
    state retain(row: OmegaTransitionStatementSyntax, target: i32, guard: i32, truth: i32) {
        self.transition_targets[row_index] = target;
        transition self.retain_state_invocation(state_index, target, row.target.start, row.acknowledgements) {
            1 -> context(row, guard, truth)
            _ -> return 0
        }
    }
    state context(row: OmegaTransitionStatementSyntax, guard: i32, truth: i32) {
        self.retain_arrival_context(before, row.first_argument, row.argument_count, guard, truth);
        return 1;
    }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
    state reject(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Alpha code uses r0 for a scalar result and r1 only as an address scratch.
// The checked backing window is above the downward-growing Alpha stack
// (origin 0x10000000), disjoint from the tape/literals below 0x01000000.
// Its end 0x60000000 remains within positive i32 arithmetic and AlphaV5 memory.
// Layout and allocation use subtraction/division before addition/multiplication;
// no source count, compound extent or accumulated arena can cross this window.
machine omega_storage_base() -> i32 { return 536870912; }
machine omega_storage_capacity() -> i32 { return 1073741824; }

// Checked cells occupy [omega_storage_base(), base + capacity).
// Every checked binding owns a bounded private arena region. Scalar cells
// load their word; aggregate values are represented during emission by the
// address of established copyable backing and copied at each value boundary.
machine OmegaScalarCompiler::emit_value_load(&mut self, cell: i32) -> i32 {
    transition self.tape.emit_imm(0, omega_storage_base() + self.cell_offsets[cell], 0) {
        1 -> value()
        _ -> return 0
    }
    state value() {
        transition ((self.cell_types[cell] >= 100000) && (self.cell_types[cell] < 400000)) ||
            (self.cell_types[cell] == omega_shared_byte_slice()) {
            true -> return 1
            _ -> return self.tape.emit_rr(10, 0, 0)
        }
    }
}
// Address capture uses one word, even when this expression's eventual value fills a record.
machine OmegaScalarCompiler::emit_save_address(&mut self, cell: i32) -> i32 {
    return (self.tape.emit_imm(1, omega_storage_base() + self.cell_offsets[cell], 0) == 1) &&
        (self.tape.emit_rr(11, 1, 0) == 1);
}
machine OmegaScalarCompiler::emit_restore_address(&mut self, cell: i32) -> i32 {
    return (self.tape.emit_imm(0, omega_storage_base() + self.cell_offsets[cell], 0) == 1) &&
        (self.tape.emit_rr(10, 0, 0) == 1);
}
machine OmegaScalarCompiler::emit_value_store(&mut self, cell: i32) -> i32 {
    transition self.tape.emit_imm(1, omega_storage_base() + self.cell_offsets[cell], 0) {
        1 -> return self.emit_store_at(self.cell_types[cell], self.cell_sizes[cell])
        _ -> return 0
    }
}
// Values retain checked words, places or copy-record backing until their next boundary.
machine OmegaScalarCompiler::emit_value(&mut self, expression: i32) -> i32 {
    transition self.value_kinds[expression] {
        OmegaCheckedValueKind::Literal -> return self.tape.emit_imm(0, self.value_payloads[expression], 0)
        OmegaCheckedValueKind::WideLiteral -> return self.tape.emit_imm(0,
            self.value_payloads[expression], self.wide_literal_highs[expression])
        OmegaCheckedValueKind::NegativeI32Literal -> return self.tape.emit_imm(0, self.value_payloads[expression], -1)
        OmegaCheckedValueKind::NullaryCase -> return self.emit_case_value(expression)
        OmegaCheckedValueKind::CaseLiteral -> return self.emit_record_literal(expression)
        OmegaCheckedValueKind::Call -> call(self.parser.call_expressions[self.parser.expressions[expression].payload0])
        OmegaCheckedValueKind::NestedCall -> nested_call(self.parser.call_expressions[self.parser.expressions[expression].payload0])
        OmegaCheckedValueKind::BooleanBinary -> return self.emit_boolean_binary(expression,
            self.parser.binary_expressions[self.value_payloads[expression]], 0)
        OmegaCheckedValueKind::ProcessTerminal -> return self.emit_process_terminal(self.value_payloads[expression])
        OmegaCheckedValueKind::NullarySumComparison -> return self.emit_nullary_sum_comparison(expression,
            self.parser.binary_expressions[self.value_payloads[expression]])
        OmegaCheckedValueKind::SignedComparison -> return self.emit_boolean_binary(expression,
            self.parser.binary_expressions[self.value_payloads[expression]], 1)
        OmegaCheckedValueKind::LogicalNot -> logical_not()
        OmegaCheckedValueKind::RepresentationCast -> return self.emit_value(self.value_payloads[expression])
        OmegaCheckedValueKind::Place -> return self.emit_place_value(expression)
        OmegaCheckedValueKind::Borrow -> return self.emit_place_address(self.value_payloads[expression])
        OmegaCheckedValueKind::ArrayLiteral -> return self.emit_array_literal(expression)
        OmegaCheckedValueKind::RecordLiteral -> return self.emit_record_literal(expression)
        OmegaCheckedValueKind::IndexedRead -> return self.emit_place_value(expression)
        OmegaCheckedValueKind::ProjectedRead -> member(self.value_payloads[expression])
        OmegaCheckedValueKind::ForwardedReference -> return self.emit_value_load(self.value_payloads[expression])
        OmegaCheckedValueKind::QuotedBytes -> return self.tape.emit_imm(0, self.value_payloads[expression], 0)
        OmegaCheckedValueKind::SharedByteRange -> return self.emit_byte_range(expression)
        OmegaCheckedValueKind::SharedByteSubrange -> return self.emit_byte_subrange(expression)
        OmegaCheckedValueKind::SharedByteRead -> return self.emit_shared_byte_read(expression)
        OmegaCheckedValueKind::LowBits -> return self.emit_low_bits(expression)
        OmegaCheckedValueKind::ExactSubtraction -> word(self.parser.binary_expressions[self.value_payloads[expression]])
        OmegaCheckedValueKind::ExactWordArithmetic -> word(self.parser.binary_expressions[self.parser.expressions[expression].payload0])
        OmegaCheckedValueKind::WrappingArithmetic -> word(self.parser.binary_expressions[self.parser.expressions[expression].payload0])
        OmegaCheckedValueKind::ExactAddition -> addition(self.parser.binary_expressions[self.value_payloads[expression]])
        OmegaCheckedValueKind::TrappingArithmetic -> return self.emit_trapping_arithmetic(expression,
            self.parser.binary_expressions[self.value_payloads[expression]])
        _ -> return self.tape.fail_internal(expression)
    }
    state member(field: i32) {
        transition (self.emit_value(self.parser.expressions[expression].payload0) == 1) &&
            (self.tape.emit_imm(1, self.field_offsets[field], 0) == 1) &&
            (self.tape.emit_rr(3, 0, 1) == 1) {
            true -> return self.emit_address_value(self.field_types[field], self.field_extents[field])
            _ -> return 0
        }
    }
    state nested_call(call: OmegaCallExpressionSyntax) {
        let target: i32 = self.value_payloads[expression];
        transition self.uninhabited_type(self.state_types[target]) {
            1 -> return self.emit_arguments(call.first_argument, call.argument_count,
                self.state_first_parameter(target), self.state_labels[target], 12)
            _ -> return self.emit_arguments(call.first_argument, call.argument_count,
                self.state_first_parameter(target), self.state_labels[target], 19)
        }
    }
    state call(call: OmegaCallExpressionSyntax) {
        return self.emit_value_call(self.value_payloads[expression],
            call.first_argument, call.argument_count);
    }
    state word(row: OmegaBinaryExpressionSyntax) {
        transition self.emit_word_operands(expression, row) {
            1 -> word_operation(row.operator)
            _ -> return 0
        }
    }
    state word_operation(operator: OmegaBinaryOperatorKind) {
        transition operator {
            OmegaBinaryOperatorKind::Add -> return self.tape.emit_rr(3, 0, 2)
            OmegaBinaryOperatorKind::Subtract -> return self.tape.emit_rr(4, 0, 2)
            OmegaBinaryOperatorKind::Multiply -> return self.tape.emit_rr(5, 0, 2)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state addition(row: OmegaBinaryExpressionSyntax) {
        transition (self.emit_value(row.left) == 1) &&
            (self.tape.emit_imm(1, self.value_payloads[row.right], 0) == 1) &&
            (self.tape.emit_rr(3, 0, 1) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state logical_not() {
        // Checked Booleans are exactly 0 or 1, so negation is 1 - value.
        transition (self.emit_value(self.value_payloads[expression]) == 1) &&
            (self.tape.emit_imm(1, 1, 0) == 1) &&
            (self.tape.emit_rr(4, 1, 0) == 1) &&
            (self.tape.emit_rr(2, 0, 1) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Evaluation order is shared by exact arithmetic, policy arithmetic and
// comparisons. A nested call on the right cannot overwrite the left value.
machine OmegaScalarCompiler::emit_word_operands(
    &mut self, expression: i32, row: OmegaBinaryExpressionSyntax
) -> i32 {
    return (self.emit_value(row.left) == 1) &&
            (self.emit_value_store(49152 + expression) == 1) &&
            (self.emit_value(row.right) == 1) &&
            (self.tape.emit_rr(2, 2, 0) == 1) &&
            (self.emit_value_load(49152 + expression) == 1);
}

// Sum operands produce addresses, unlike scalar operands. Observe each tag
// at its evaluation point; a right-side call can mutate the left place or
// reuse a callee's result backing. Never retain that address as the value.
machine OmegaScalarCompiler::emit_nullary_sum_comparison(
    &mut self, expression: i32, row: OmegaBinaryExpressionSyntax
) -> i32 {
    transition (self.emit_value(row.left) == 1) &&
        (self.tape.emit_rr(10, 0, 0) == 1) &&
        (self.emit_value_store(49152 + expression) == 1) &&
        (self.emit_value(row.right) == 1) &&
        (self.tape.emit_rr(10, 0, 0) == 1) &&
        (self.tape.emit_rr(2, 2, 0) == 1) &&
        (self.emit_value_load(49152 + expression) == 1) {
        true -> compare()
        _ -> return 0
    }
    state compare() {
        transition row.operator {
            OmegaBinaryOperatorKind::Equal -> return self.emit_comparison_result(16, 0, 2, 1)
            OmegaBinaryOperatorKind::NotEqual -> return self.emit_comparison_result(16, 0, 2, 0)
            _ -> return self.tape.fail_internal(expression)
        }
    }
}

machine OmegaScalarCompiler::emit_boolean_binary(
    &mut self, expression: i32, row: OmegaBinaryExpressionSyntax, signed_order: i32
) -> i32 {
    transition row.operator {
        OmegaBinaryOperatorKind::And -> return self.emit_short_circuit(row, 13)
        OmegaBinaryOperatorKind::Or -> return self.emit_short_circuit(row, 14)
        _ -> comparison_operands()
    }
    state comparison_operands() {
        // An expression owns one scratch word, disjoint from parameters,
        // locals and staged arguments. No ordinary call cycle is admitted,
        // so a nested right operand cannot re-enter this expression's owner.
        transition self.emit_word_operands(expression, row) {
            1 -> ordering()
            _ -> return 0
        }
    }
    state ordering() {
        transition signed_order {
            1 -> comparison()
            _ -> unsigned_bias()
        }
    }
    state unsigned_bias() {
        transition (self.tape.emit_imm(3, 0, -2147483648) == 1) &&
            (self.tape.emit_rr(3, 0, 3) == 1) &&
            (self.tape.emit_rr(3, 2, 3) == 1) {
            true -> comparison()
            _ -> return 0
        }
    }
    state comparison() {
        // r0 and r2 carry unsigned operands biased by 2^63. Alpha's signed
        // comparison now preserves their order across the entire u64 range;
        // equality is unchanged by this bijection.
        transition row.operator {
            OmegaBinaryOperatorKind::Equal ->
                return self.emit_comparison_result(16, 0, 2, 1)
            OmegaBinaryOperatorKind::NotEqual ->
                return self.emit_comparison_result(16, 0, 2, 0)
            OmegaBinaryOperatorKind::Less ->
                return self.emit_comparison_result(15, 0, 2, 1)
            OmegaBinaryOperatorKind::LessEqual ->
                return self.emit_comparison_result(15, 2, 0, 0)
            OmegaBinaryOperatorKind::Greater ->
                return self.emit_comparison_result(15, 2, 0, 1)
            OmegaBinaryOperatorKind::GreaterEqual ->
                return self.emit_comparison_result(15, 0, 2, 0)
            _ -> return self.tape.fail_internal(expression)
        }
    }
}

// The early branch leaves the already canonical Boolean left value in r0.
// Otherwise the right operand executes once and supplies the whole result.
machine OmegaScalarCompiler::emit_short_circuit(
    &mut self, row: OmegaBinaryExpressionSyntax, opcode: i32
) -> i32 {
    self.emission_resource = 14;
    let end: i32 = self.tape.new_label();
    transition end >= 0 {
        true -> emit(end)
        _ -> return 0
    }
    state emit(end: i32) {
        self.emission_resource = 12;
        transition (self.emit_value(row.left) == 1) &&
            (self.tape.emit_rx_label(opcode, 0, end) == 1) &&
            (self.emit_value(row.right) == 1) &&
            (self.tape.define_label(end) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_comparison_result(
    &mut self, opcode: i32, left: i32, right: i32, taken_value: i32
) -> i32 {
    self.emission_resource = 14;
    let taken: i32 = self.tape.new_label();
    transition taken >= 0 {
        true -> end_label(taken)
        _ -> return 0
    }
    state end_label(taken: i32) {
        let end: i32 = self.tape.new_label();
        transition end >= 0 {
            true -> emit(taken, end)
            _ -> return 0
        }
    }
    state emit(taken: i32, end: i32) {
        self.emission_resource = 12;
        transition (self.tape.emit_rrx_label(opcode, left, right, taken) == 1) &&
            (self.tape.emit_imm(0, 1 - taken_value, 0) == 1) &&
            (self.tape.emit_jump_label(12, end) == 1) &&
            (self.tape.define_label(taken) == 1) &&
            (self.tape.emit_imm(0, taken_value, 0) == 1) &&
            (self.tape.define_label(end) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_value_call(
    &mut self, callee: i32, first_argument: i32, count: i32
) -> i32 {
    let entry: i32 = self.parser.machine_items[callee].first_state;
    transition self.uninhabited_type(self.state_types[entry]) {
        // A no-return transfer stages the same checked arguments but has no
        // return address or result. Calls to returning machines retain both.
        1 -> return self.emit_arguments(first_argument, count,
            self.state_first_parameter(entry), self.machine_labels[callee], 12)
        _ -> return self.emit_arguments(first_argument, count,
            self.state_first_parameter(entry), self.machine_labels[callee], 19)
    }
}

// Stage every operand before overwriting any destination parameter. This
// applies equally to ordinary calls, same-state loops and sibling transfers.
machine OmegaScalarCompiler::emit_arguments(
    &mut self, first_argument: i32, count: i32, first_parameter: i32,
    label: i32, opcode: i32
) -> i32 {
    transition true { true -> evaluate(0) }
    state evaluate(offset: i32) {
        transition offset < count {
            true -> argument(offset)
            _ -> transfer(0)
        }
    }
    state argument(offset: i32) {
        let slot: i32 = first_argument + offset;
        transition (self.emit_value(self.parser.call_arguments[slot]) == 1) &&
            (self.emit_value_store(32768 + slot) == 1) {
            true -> evaluate(offset + 1)
            _ -> return 0
        }
    }
    state transfer(offset: i32) {
        transition offset < count {
            true -> parameter(offset)
            _ -> return self.tape.emit_jump_label(opcode, label)
        }
    }
    state parameter(offset: i32) {
        transition (self.emit_value_load(32768 + first_argument + offset) == 1) &&
            (self.emit_value_store(first_parameter + offset) == 1) {
            true -> transfer(offset + 1)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_unit_return(&mut self) -> i32 {
    transition (self.tape.emit_imm(0, 0, 0) == 1) && (self.tape.emit_ret() == 1) {
        true -> return 1
        _ -> return 0
    }
}

machine OmegaScalarCompiler::emit_transition_target(&mut self, row_index: i32) -> i32 {
    let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
    transition row.target_kind {
        OmegaTransitionTargetKind::Result -> result(row.result_expression)
        OmegaTransitionTargetKind::Machine -> target(row, self.transition_targets[row_index])
        OmegaTransitionTargetKind::Terminal -> return self.emit_unit_return()
    }
    state result(expression: i32) {
        transition (self.emit_value(expression) == 1) && (self.tape.emit_ret() == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state target(row: OmegaTransitionStatementSyntax, target: i32) {
        return self.emit_arguments(row.first_argument, row.argument_count,
            self.state_first_parameter(target), self.state_labels[target], 12);
    }
}

// A case arm that only binds or waives fields covers the whole selected case.
// Payload equality tests require a conditional guard and stay unsupported.
machine OmegaScalarCompiler::check_case_fields(
    &mut self, source: &[u8], row: OmegaTransitionStatementSyntax, case_slot: i32
) -> i32 {
    transition true { true -> field(0) }
    state field(offset: i32) {
        transition offset < row.guard_pattern_field_count {
            true -> resolve(offset, self.parser.transition_pattern_fields[row.guard_first_pattern_field + offset])
            _ -> complete()
        }
    }
    state resolve(offset: i32, item: OmegaTransitionPatternFieldSyntax) {
        let name: OmegaRelativeSpan = self.parser.members[item.member];
        let slot: i32 = self.resolve_payload_field(source, case_slot, name.start, name.end);
        transition slot >= 0 {
            true -> action(offset, item, slot)
            _ -> rejected(name.start)
        }
    }
    state action(offset: i32, item: OmegaTransitionPatternFieldSyntax, slot: i32) {
        transition item.kind {
            OmegaTransitionPatternFieldKind::Bind -> unique(offset, item, slot, 0)
            OmegaTransitionPatternFieldKind::Waive -> unique(offset, item, slot, 0)
            _ -> unsupported(item.start)
        }
    }
    state unique(offset: i32, item: OmegaTransitionPatternFieldSyntax, slot: i32, previous: i32) {
        transition previous < offset {
            true -> compare(offset, item, slot, previous, row.guard_first_pattern_field + previous)
            _ -> retain(offset, slot)
        }
    }
    state compare(offset: i32, item: OmegaTransitionPatternFieldSyntax, slot: i32, previous: i32, prior: i32) {
        transition self.pattern_field_slots[prior] == slot {
            true -> rejected(item.start)
            _ -> binding(offset, item, slot, previous, self.parser.transition_pattern_fields[prior].binding)
        }
    }
    state binding(offset: i32, item: OmegaTransitionPatternFieldSyntax, slot: i32, previous: i32, prior: OmegaRelativeSpan) {
        transition (item.binding.end > item.binding.start) && (prior.end > prior.start) &&
            (self.parser.sources.equal_name(source, item.binding, prior) == 1) {
            true -> duplicate(item.binding.start)
            _ -> unique(offset, item, slot, previous + 1)
        }
    }
    state retain(offset: i32, slot: i32) {
        self.pattern_field_slots[row.guard_first_pattern_field + offset] = slot;
        transition true { true -> field(offset + 1) }
    }
    state complete() {
        transition (row.guard_has_rest == 1) ||
            (row.guard_pattern_field_count == self.parser.data_cases[case_slot].payload_field_count) {
            true -> return 1
            _ -> rejected(row.guard_start)
        }
    }
    state duplicate(coordinate: i32) { self.record_reject(10, 4, coordinate); return 0; }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
}

// Sum patterns retain exact declaration identity. Coverage is checked
// for every case, while source order determines the first selected arm. Even
// arms following a wildcard still have their patterns and targets checked.
machine OmegaScalarCompiler::check_case_transition(
    &mut self, source: &[u8], owner: i32, state_index: i32,
    first: i32, last: i32, declaration: i32
) -> i32 {
    let subject: i32 = self.parser.transition_statements[self.parser.statements[
        self.parser.machine_states[self.local_state_row(state_index)].first_statement + first].item_index].subject;
    transition self.check_case_subject(source, owner, state_index, first, subject, 100000 + declaration) {
        1 -> clear(0)
        _ -> return 0
    }
    state clear(offset: i32) {
        transition offset < self.parser.data_items[declaration].case_count {
            true -> clear_case(offset, self.parser.data_items[declaration].first_case + offset)
            _ -> arm(first, 0)
        }
    }
    state clear_case(offset: i32, slot: i32) {
        self.case_coverage[slot] = 0;
        transition true { true -> clear(offset + 1) }
    }
    state arm(cursor: i32, wildcard: i32) {
        transition cursor < last {
            true -> row(cursor, wildcard, self.parser.statements[
                self.parser.machine_states[self.local_state_row(state_index)].first_statement + cursor].item_index)
            _ -> coverage(wildcard)
        }
    }
    state row(cursor: i32, wildcard: i32, row_index: i32) {
        let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always -> target(cursor, 1, row_index)
            OmegaTransitionGuardKind::Path -> path(cursor, wildcard, row_index, row)
            OmegaTransitionGuardKind::Destructure -> path(cursor, wildcard, row_index, row)
            _ -> unsupported(row.guard_start)
        }
    }
    state path(cursor: i32, wildcard: i32, row_index: i32, row: OmegaTransitionStatementSyntax) {
        transition row.guard_path_member_count == 2 {
            true -> carrier(cursor, wildcard, row_index, row,
                self.parser.members[row.guard_first_path_member])
            _ -> unsupported(row.guard_start)
        }
    }
    state carrier(cursor: i32, wildcard: i32, row_index: i32, row: OmegaTransitionStatementSyntax,
        name: OmegaRelativeSpan) {
        transition self.resolve_data(source, name.start, name.end) == declaration {
            true -> member(cursor, wildcard, row_index,
                self.parser.members[row.guard_first_path_member + 1])
            _ -> rejected(name.start)
        }
    }
    state member(cursor: i32, wildcard: i32, row_index: i32, name: OmegaRelativeSpan) {
        let slot: i32 = self.resolve_case(source, declaration, name.start, name.end);
        transition slot >= 0 {
            true -> pattern(cursor, wildcard, row_index, slot)
            _ -> rejected(name.start)
        }
    }
    state pattern(cursor: i32, wildcard: i32, row_index: i32, slot: i32) {
        let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
        transition row.guard_kind {
            OmegaTransitionGuardKind::Destructure -> fields(cursor, wildcard, row_index, slot, row)
            _ -> retain(cursor, wildcard, row_index, slot)
        }
    }
    state fields(cursor: i32, wildcard: i32, row_index: i32, slot: i32, row: OmegaTransitionStatementSyntax) {
        transition self.check_case_fields(source, row, slot) {
            1 -> scope(cursor, wildcard, row_index, slot)
            _ -> return 0
        }
    }
    state scope(cursor: i32, wildcard: i32, row_index: i32, slot: i32) {
        self.pattern_scope = row_index + 1;
        transition true { true -> retain(cursor, wildcard, row_index, slot) }
    }
    state retain(cursor: i32, wildcard: i32, row_index: i32, slot: i32) {
        self.case_guard_ordinals[row_index] = slot - self.parser.data_items[declaration].first_case;
        self.case_coverage[slot] = 1;
        transition true { true -> target(cursor, wildcard, row_index) }
    }
    state target(cursor: i32, wildcard: i32, row_index: i32) {
        // Every target terminates this activation. A sibling starts with the
        // effects already incurred by the subject and preceding statements.
        let entry_effects: i32 = self.effect_count;
        let checked: i32 = self.check_transition_target(source, owner, state_index, first, row_index);
        self.effect_count = entry_effects;
        self.pattern_scope = 0;
        transition checked {
            1 -> arm(cursor + 1, wildcard)
            _ -> return 0
        }
    }
    state coverage(wildcard: i32) {
        transition wildcard {
            1 -> return 1
            _ -> covered(0)
        }
    }
    state covered(offset: i32) {
        transition offset < self.parser.data_items[declaration].case_count {
            true -> covered_case(offset, self.parser.data_items[declaration].first_case + offset)
            _ -> return 1
        }
    }
    state covered_case(offset: i32, slot: i32) {
        transition self.case_coverage[slot] {
            1 -> covered(offset + 1)
            _ -> rejected(self.transition_anchor)
        }
    }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
}

// A bare literal guard takes its magnitude from the same scanner and carrier
// as an expression. Preserve the complete word for ordered comparisons.
machine OmegaScalarCompiler::check_integer_guard(&mut self, source: &[u8], index: i32,
    row: OmegaTransitionStatementSyntax, kind: i32) -> i32 {
    transition kind == 1 {
        true -> rejected()
        _ -> scan()
    }
    state scan() {
        self.scan_scalar_literal(source, row.guard_start, row.guard_end, kind);
        transition self.literal_status {
            1 -> checked()
            5 -> checked()
            3 -> rejected()
            _ -> incomplete()
        }
    }
    state checked() {
        self.integer_guards[index].low = self.literal_value;
        self.integer_guards[index].high = self.literal_high;
        return 1;
    }
    state rejected() { self.record_reject(-1, 4, row.guard_start); return 0; }
    state incomplete() { self.record_incomplete(4, row.guard_start); return 0; }
}

// A literal true is an unconditional predicate with no evaluation effects.
// Other predicates retain ordinary value checking and ordered execution.
machine OmegaScalarCompiler::predicate_is_true(&mut self, expression: i32) -> i32 {
    transition self.parser.expressions[expression].kind {
        OmegaExpressionKind::Boolean -> return self.parser.expressions[expression].payload0
        _ -> return 0
    }
}

// This plan has checked coverage through a wildcard or literal true. Refuse
// an exhausted plan rather than emit an implicit fallthrough to another state.
machine OmegaScalarCompiler::emit_predicate_transition(
    &mut self, state_index: i32, first: i32, last: i32
) -> i32 {
    transition true { true -> arm(first) }
    state arm(cursor: i32) {
        transition cursor < last {
            true -> guard(cursor, self.parser.statements[self.parser.machine_states[
                self.local_state_row(state_index)].first_statement + cursor].item_index)
            _ -> return 0
        }
    }
    state guard(cursor: i32, row_index: i32) {
        transition self.parser.transition_statements[row_index].guard_kind {
            OmegaTransitionGuardKind::Always -> return self.emit_transition_target(row_index)
            OmegaTransitionGuardKind::Predicate -> predicate(cursor, row_index,
                self.parser.transition_statements[row_index].guard_expression)
            _ -> return 0
        }
    }
    state predicate(cursor: i32, row_index: i32, expression: i32) {
        transition self.predicate_is_true(expression) {
            1 -> return self.emit_transition_target(row_index)
            _ -> label(cursor, row_index, expression)
        }
    }
    state label(cursor: i32, row_index: i32, expression: i32) {
        self.emission_resource = 14;
        let next: i32 = self.tape.new_label();
        transition next >= 0 {
            true -> value(cursor, row_index, expression, next)
            _ -> return 0
        }
    }
    state value(cursor: i32, row_index: i32, expression: i32, next: i32) {
        self.emission_resource = 12;
        transition (self.emit_value(expression) == 1) &&
            (self.tape.emit_rx_label(13, 0, next) == 1) &&
            (self.emit_transition_target(row_index) == 1) &&
            (self.tape.define_label(next) == 1) {
            true -> arm(cursor + 1)
            _ -> return 0
        }
    }
}

// Evaluate a dynamic subject once. Every target terminates the current
// activation; later guards are reached only by the preceding failed guard.
machine OmegaScalarCompiler::emit_dynamic_transition(
    &mut self, state_index: i32, first: i32, last: i32
) -> i32 {
    let subject: i32 = self.parser.transition_statements[self.parser.statements[
        self.parser.machine_states[self.local_state_row(state_index)].first_statement + first].item_index].subject;
    transition self.parser.transition_statements[self.parser.statements[
        self.parser.machine_states[self.local_state_row(state_index)].first_statement + first].item_index].has_subject {
        0 -> return self.emit_predicate_transition(state_index, first, last)
        _ -> subject_value(subject)
    }
    state subject_value(subject: i32) {
        transition (self.emit_value(subject) == 1) && (self.emit_value_store(49152 + subject) == 1) {
            true -> arm(first, subject)
            _ -> return 0
        }
    }
    state arm(cursor: i32, subject: i32) {
        transition cursor < last {
            true -> row(cursor, subject, self.parser.statements[
                self.parser.machine_states[self.local_state_row(state_index)].first_statement + cursor].item_index)
            _ -> return 1
        }
    }
    state row(cursor: i32, subject: i32, row_index: i32) {
        transition cursor + 1 == last {
            true -> return self.emit_transition_target(row_index)
            _ -> guard(cursor, subject, row_index)
        }
    }
    state guard(cursor: i32, subject: i32, row_index: i32) {
        transition self.parser.transition_statements[row_index].guard_kind {
            OmegaTransitionGuardKind::Always -> return self.emit_transition_target(row_index)
            _ -> label(cursor, subject, row_index)
        }
    }
    state label(cursor: i32, subject: i32, row_index: i32) {
        self.emission_resource = 14;
        let next: i32 = self.tape.new_label();
        transition next >= 0 {
            true -> compare(cursor, subject, row_index, next)
            _ -> return 0
        }
    }
    state compare(cursor: i32, subject: i32, row_index: i32, next: i32) {
        self.emission_resource = 12;
        transition self.emit_value_load(49152 + subject) {
            1 -> subject_kind(cursor, subject, row_index, next)
            _ -> return 0
        }
    }
    state subject_kind(cursor: i32, subject: i32, row_index: i32, next: i32) {
        transition self.parser.transition_statements[row_index].guard_kind {
            OmegaTransitionGuardKind::Boolean -> branch(cursor, subject, row_index, next,
                self.parser.transition_statements[row_index].guard_boolean)
            OmegaTransitionGuardKind::Integer -> integer_guard(cursor, subject, row_index, next,
                self.integer_guards[row_index])
            _ -> case_guard(cursor, subject, row_index, next)
        }
    }
    state integer_guard(cursor: i32, subject: i32, row_index: i32, next: i32, value: OmegaIntegerGuard) {
        transition (self.tape.emit_imm(2, value.low, value.high) == 1) &&
            (self.emit_comparison_result(16, 0, 2, 1) == 1) {
            true -> branch(cursor, subject, row_index, next, 1)
            _ -> return 0
        }
    }
    state case_guard(cursor: i32, subject: i32, row_index: i32, next: i32) {
        // The subject has already been copied once. Read its captured case,
        // not the original place, and compare against the checked owner ordinal.
        transition (self.tape.emit_rr(10, 0, 0) == 1) &&
            (self.tape.emit_imm(2, self.case_guard_ordinals[row_index], 0) == 1) &&
            (self.emit_comparison_result(16, 0, 2, 1) == 1) {
            true -> branch(cursor, subject, row_index, next, 1)
            _ -> return 0
        }
    }
    state branch(cursor: i32, subject: i32, row_index: i32, next: i32, value: i32) {
        transition self.tape.emit_rx_label(14 - value, 0, next) {
            1 -> target(cursor, subject, row_index, next)
            _ -> return 0
        }
    }
    state target(cursor: i32, subject: i32, row_index: i32, next: i32) {
        transition (self.emit_transition_target(row_index) == 1) &&
            (self.tape.define_label(next) == 1) {
            true -> arm(cursor + 1, subject)
            _ -> return 0
        }
    }
}

// Complete the scalar signature census before any body resolves a call or
// transfer. Unsupported overload families cannot silently select a row.
machine OmegaScalarCompiler::check_signatures(&mut self, source: &[u8], owner: i32) -> i32 {
    transition true { true -> next(self.parser.machine_items[owner].first_state) }
    state next(index: i32) {
        transition index < self.parser.machine_items[owner].first_state + self.parser.machine_items[owner].state_count {
            true -> result(index)
            _ -> return 1
        }
    }
    state result(index: i32) {
        self.state_owners[index] = owner;
        transition self.parser.machine_states[self.local_state_row(index)].has_return_type {
            1 -> explicit_result(index, self.scalar_type(source, self.parser.machine_states[self.local_state_row(index)].return_type))
            _ -> retain_result(index, 2)
        }
    }
    state explicit_result(index: i32, kind: i32) {
        transition (kind > 0) && (kind < 200000) &&
            ((self.type_copy(source, kind) == 1) || (self.uninhabited_type(kind) == 1) || (self.inhabited_sum(kind) == 1)) {
            true -> retain_result(index, kind)
            _ -> unsupported(self.parser.machine_items[owner].start)
        }
    }
    state retain_result(index: i32, kind: i32) {
        self.state_types[index] = kind;
        transition true { true -> parameter(index, 0) }
    }
    state parameter(index: i32, offset: i32) {
        transition offset < self.state_parameter_count(index) {
            true -> parameter_type(index, offset, self.state_first_parameter(index) + offset)
            _ -> sibling_names(index, self.parser.machine_states[self.local_state_row(index)].lexical_parent)
        }
    }
    state parameter_type(index: i32, offset: i32, slot: i32) {
        let kind: i32 = self.parameter_type(source, slot);
        self.parameter_types[slot] = kind;
        transition ((kind > 0) && (kind != 2) && (kind < 200000) &&
            (self.type_copy(source, kind) == 1)) ||
            ((kind >= 400000) && (kind < 404096)) ||
            ((kind >= 500000) && (kind < 504096)) || (omega_array_reference_row(kind) >= 0) ||
            (kind == omega_shared_byte_slice()) {
            true -> parameter_storage(index, offset, slot, kind)
            _ -> unsupported(self.parser.machine_parameters[self.parameter_syntax_row(slot)].name.start)
        }
    }
    state parameter_storage(index: i32, offset: i32, slot: i32, kind: i32) {
        transition self.reference_signature(source, owner, index, kind) {
            1 -> allocate_parameter(index, offset, slot, kind)
            _ -> unsupported(self.parser.machine_parameters[self.parameter_syntax_row(slot)].name.start)
        }
    }
    // Every call and transfer checks its arguments from left to right.
    // The caller keeps each reference loan live while it checks later
    // arguments, so an exclusive parameter cannot alias another parameter.
    state allocate_parameter(index: i32, offset: i32, slot: i32, kind: i32) {
        transition (self.construction.compact_parameters == 1) && (slot >= self.construction.total.root_parameters) {
            true -> parameter_scope(index, offset, self.parser.machine_parameters[self.parameter_syntax_row(slot)].name)
            _ -> permanent_parameter(index, offset, slot, kind)
        }
    }
    state permanent_parameter(index: i32, offset: i32, slot: i32, kind: i32) {
        transition self.require_cell(source, slot, kind) {
            1 -> parameter_scope(index, offset, self.parser.machine_parameters[self.parameter_syntax_row(slot)].name)
            _ -> return 0
        }
    }
    state parameter_scope(index: i32, offset: i32, name: OmegaRelativeSpan) {
        transition self.resolve_machine(source, name.start, name.end) < 0 {
            true -> parameter_names(index, offset, name, 0)
            _ -> unsupported(name.start)
        }
    }
    state parameter_names(index: i32, offset: i32, name: OmegaRelativeSpan, previous: i32) {
        transition previous < offset {
            true -> parameter_compare(index, offset, name, previous,
                self.parser.machine_parameters[self.parameter_syntax_row(self.state_first_parameter(index) + previous)].name)
            _ -> parameter(index, offset + 1)
        }
    }
    state parameter_compare(index: i32, offset: i32, name: OmegaRelativeSpan,
        previous: i32, other: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, source[other.start..other.end]) {
            1 -> duplicate(name.start)
            _ -> parameter_names(index, offset, name, previous + 1)
        }
    }
    state sibling_names(index: i32, parent: i32) {
        transition parent < 0 {
            true -> next(index + 1)
            _ -> names(index, parent + 1)
        }
    }
    state names(index: i32, previous: i32) {
        transition previous < index {
            true -> compare_name(index, previous, self.parser.machine_states[self.local_state_row(index)].name,
                self.parser.machine_states[self.local_state_row(previous)].name)
            _ -> next(index + 1)
        }
    }
    state compare_name(index: i32, previous: i32, name: OmegaRelativeSpan, other: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, source[other.start..other.end]) {
            1 -> same_name(index, previous, name.start)
            _ -> names(index, self.parser.machine_states[self.local_state_row(previous)].subtree_end)
        }
    }
    state same_name(index: i32, previous: i32, coordinate: i32) {
        transition self.state_parameter_count(index) == self.state_parameter_count(previous) {
            true -> same_parameters(index, previous, coordinate, 0)
            _ -> unsupported(coordinate)
        }
    }
    state same_parameters(index: i32, previous: i32, coordinate: i32, offset: i32) {
        transition offset < self.state_parameter_count(index) {
            true -> same_parameter(index, previous, coordinate, offset)
            _ -> duplicate(coordinate)
        }
    }
    state same_parameter(index: i32, previous: i32, coordinate: i32, offset: i32) {
        transition self.same_reference_type(source,
            self.parameter_types[self.state_first_parameter(index) + offset],
            self.parameter_types[self.state_first_parameter(previous) + offset]) {
            true -> same_parameters(index, previous, coordinate, offset + 1)
            _ -> unsupported(coordinate)
        }
    }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
    state duplicate(coordinate: i32) { self.record_reject(10, 4, coordinate); return 0; }
}

machine OmegaScalarCompiler::compile(&mut self, source: &[u8], entry: &[u8]) {
    self.parser.sources.single(source.len);
    self.compile_set(source, 0, entry);
}

// The caller supplies only immutable bytes, package edges and source ranges.
// Parsing and declaration selection remain inside the compiler. This internal
// construction entry does not claim full OCREQ admission.
machine OmegaScalarCompiler::compile_set(&mut self, source: &[u8], entry_unit: i32, entry: &[u8]) {
    self.process_entry.end = 0;
    self.compile_prepared_set(source, entry_unit, entry);
}

// The host has already compared the whole invocation with its own exact
// deployment; the complete source-owned Build rejoined this root on this call.
// A selected provider can justify lowering only inside that standalone process.
machine OmegaScalarCompiler::compile_process_entry(&mut self, source: &[u8], entry_unit: i32) {
    let entry: OmegaRelativeSpan = self.build.entry_definition;
    self.process_entry = entry;
    self.compile_prepared_set(source, entry_unit, source[entry.start..entry.end]);
    self.process_entry.end = 0;
}

machine OmegaScalarCompiler::compile_prepared_set(&mut self, source: &[u8], entry_unit: i32, entry: &[u8]) {
    self.compile_closed_units(source, entry_unit, entry);
    transition self.status {
        OmegaScalarCompilationStatus::Complete -> return
        _ -> failed()
    }
    state failed() {
        transition self.construction.active {
            1 -> discard()
            _ -> return
        }
    }
    // A later file or the final call graph can refuse after an earlier file
    // emitted code. No unfinished tape survives that failed invocation.
    state discard() { self.tape.initialize(); }
}

machine OmegaScalarCompiler::compile_closed_units(&mut self, source: &[u8], entry_unit: i32, entry: &[u8]) {
    self.exit_service = -1;
    self.exit_primitive = -1;
    self.exit_result = -1;
    self.entry_unit = entry_unit;
    self.status = OmegaScalarCompilationStatus::Pending;
    self.diagnostic_offset = 0;
    self.literal_offset = 0;
    self.transition_anchor = 0;
    self.active_boolean_arm = -1;
    self.pattern_scope = 0;
    self.selected_machine = -1;
    self.outcome_tag = 0;
    self.outcome_space = 0;
    self.outcome_code = -1;
    self.outcome_coordinate = 0;
    self.outcome_package_ordinal = 0;
    self.outcome_unit_ordinal = 0;
    self.outcome_limit = 0;
    self.outcome_requested = 0;
    self.emission_resource = 12;
    self.call_edge_count = 0;
    self.call_order_count = 0;
    self.state_invocation_count = 0;
    self.loan_count = 0;
    self.layout_depth = 0;
    self.tape.initialize();
    self.prepare_construction(source, entry);
    transition self.parser.status {
        OmegaParserStatus::Complete -> check_roots()
        OmegaParserStatus::LexicalFailure -> lexical_reject()
        OmegaParserStatus::SyntaxFailure -> reject(-1, 4, self.parser.diagnostic_start)
        OmegaParserStatus::Incomplete -> incomplete(4, self.parser.incomplete_start)
        OmegaParserStatus::ResourceFailure -> resource()
        _ -> internal()
    }

    // The scanner retains the exact lexical diagnostic on LexicalFailure;
    // its code projects onto the contract's Reject codes 2..9 at the first
    // byte of the retained diagnostic span under canonical-source
    // coordinates.
    state lexical_reject() {
        let code: i32 = omega_lexical_reject_code(
            self.parser.scan.diagnostic_code);
        transition true {
            true -> reject(code, 4, self.parser.diagnostic_start)
        }
    }

    // A memberless service names an effect. An operation-bearing boundary
    // also needs checked requirements and selection, outside this profile.
    state check_roots() {
        transition self.check_service_declarations(source) {
            1 -> check_ordinary_roots()
            _ -> return
        }
    }
    state check_ordinary_roots() {
        // A parsed domain owns a carrier and proof obligations. Until the
        // checker resolves them it cannot publish a tape for the package.
        transition self.parser.domain_count > 0 {
            true -> incomplete(4, self.parser.domains[0].keyword_start)
            _ -> check_known_roots()
        }
    }
    state check_known_roots() {
        transition (self.parser.root_count == self.parser.machine_count + self.parser.data_count + self.parser.use_count +
            self.parser.boundary_trait_count + self.parser.implementation_count + self.parser.boundary_machine_count) &&
            (self.parser.machine_count > 0) && (self.entry_unit >= 0) &&
            (self.entry_unit < self.parser.sources.unit_count) {
            true -> imports()
            _ -> non_machine_root(0)
        }
    }
    state imports() {
        transition self.construction.active {
            1 -> unit_imports(0)
            _ -> pooled_imports()
        }
    }
    state pooled_imports() {
        transition self.validate_imports(source, -1) {
            1 -> terminal_suppliers()
            _ -> return
        }
    }
    state terminal_suppliers() {
        transition self.check_terminal_suppliers(source) {
            1 -> reset_storage(0)
            _ -> return
        }
    }
    state reset_storage(index: i32) {
        transition index < self.cell_count {
            true -> clear_cell(index)
            _ -> storage_empty()
        }
    }
    state clear_cell(index: i32) {
        self.cell_sizes[self.cell_ids[index]] = 0;
        transition true { true -> reset_storage(index + 1) }
    }
    state storage_empty() {
        self.cell_count = 0;
        self.storage_size = 0;
        self.bound_total = 0;
        self.effect_count = 0;
        transition true { true -> reset_case_names(0) }
    }
    state reset_case_names(index: i32) {
        transition index < self.case_name_count {
            true -> clear_case_bucket(index)
            _ -> case_names_empty()
        }
    }
    state clear_case_bucket(index: i32) {
        self.case_name_heads[self.case_name_buckets[index]] = 0;
        transition true { true -> reset_case_names(index + 1) }
    }
    state case_names_empty() {
        self.case_name_count = 0;
        transition true { true -> reset_data(0) }
    }
    state reset_data(index: i32) {
        transition index < self.parser.data_count {
            true -> clear_data(index)
            _ -> data_names(0)
        }
    }
    state clear_data(index: i32) {
        self.data_colors[index] = 0;
        transition true { true -> reset_data(index + 1) }
    }
    state data_names(index: i32) {
        transition index < self.parser.data_count {
            true -> data_name(index, self.parser.data_items[index].name)
            _ -> data_lifetimes()
        }
    }
    state data_lifetimes() {
        transition self.parser.first_data_lifetime < 0 {
            true -> layouts(0)
            _ -> check_lifetime_fields()
        }
    }
    state check_lifetime_fields() {
        transition self.check_data_lifetimes(source) {
            1 -> incomplete(4, self.parser.first_data_lifetime)
            _ -> return
        }
    }
    state data_name(index: i32, name: OmegaRelativeSpan) {
        transition self.select_construction_unit(source, self.construction.types[index].unit) {
            1 -> loaded_data_name(index, name)
            _ -> return
        }
    }
    state loaded_data_name(index: i32, name: OmegaRelativeSpan) {
        transition self.resolve_data(source, name.start, name.end) == index {
            true -> data_namespace(index, name)
            _ -> reject(10, 4, name.start)
        }
    }
    state data_namespace(index: i32, name: OmegaRelativeSpan) {
        transition (self.resolve_machine(source, name.start, name.end) < 0) &&
            (self.span_equals(source, name.start, name.end, "u8") == 0) &&
            (self.span_equals(source, name.start, name.end, "u32") == 0) &&
            (self.span_equals(source, name.start, name.end, "i32") == 0) &&
            (self.span_equals(source, name.start, name.end, "u64") == 0) &&
            (self.span_equals(source, name.start, name.end, "bool") == 0) &&
            (self.word_policy(source, name.start, name.end) == 0) {
            true -> finish_data_name(index)
            _ -> incomplete(4, name.start)
        }
    }
    state finish_data_name(index: i32) {
        transition (self.construction.active == 1) &&
            (index + 1 == self.construction.units[self.parser.unit_index + 1].data_count) {
            true -> retain_field_types(index)
            _ -> data_names(index + 1)
        }
    }
    state retain_field_types(index: i32) {
        self.retain_construction_field_types(source, self.parser.unit_index);
        transition true { true -> data_names(index + 1) }
    }
    state layouts(index: i32) {
        transition index < self.parser.data_count {
            true -> layout(index)
            _ -> reset_call_graph(0)
        }
    }
    state layout(index: i32) {
        transition self.layout_data(source, index) {
            1 -> layouts(index + 1)
            _ -> return
        }
    }

    state reset_call_graph(index: i32) {
        transition index < self.parser.machine_count {
            true -> reset_call_node(index)
            _ -> reset_state_graph(0)
        }
    }

    state reset_call_node(index: i32) {
        self.call_edge_heads[index] = -1;
        self.call_colors[index] = 0;
        self.block_bounds[index] = -1;
        self.reach_clauses[index] = -1;
        self.terminal_calls[index] = -1;
        transition true { true -> reset_call_graph(index + 1) }
    }

    state reset_state_graph(index: i32) {
        transition index < self.program_state_count() {
            true -> reset_state_node(index)
            _ -> check_declarations(0)
        }
    }
    state reset_state_node(index: i32) {
        self.state_incoming[index] = -1;
        self.inferred_index_bound[index] = 0;
        self.invocation_seen[index] = 0;
        self.state_effects[index] = self.state_crash_bound(index) & 2;
        transition self.state_block_bound(index) {
            1 -> seed_nested_block(index)
            _ -> reset_state_graph(index + 1)
        }
    }
    state seed_nested_block(index: i32) {
        self.state_effects[index] = self.state_effects[index] | 1;
        transition true { true -> reset_state_graph(index + 1) }
    }

    // A non-machine root is valid Omega this slice does not implement; the
    // coverage refusal anchors at the first such root's item start. A source
    // with no roots at all has no source position and reports space 0.
    state non_machine_root(index: i32) {
        transition index < self.parser.root_count {
            true -> root_kind(index)
            _ -> incomplete(0, 0)
        }
    }

    state root_kind(index: i32) {
        transition self.parser.roots[index].kind {
            OmegaRootKind::Machine -> non_machine_root(index + 1)
            OmegaRootKind::Implementation -> incomplete(4, self.parser.implementations[self.parser.roots[index].item_index].start)
            OmegaRootKind::BoundaryMachine -> incomplete(4,
                self.parser.owned_machines[self.parser.boundary_machines[self.parser.roots[index].item_index]].start)
            OmegaRootKind::Data -> non_machine_root(index + 1)
            OmegaRootKind::Domain -> incomplete(4, self.parser.domains[self.parser.roots[index].item_index].keyword_start)
            OmegaRootKind::Trait -> incomplete(4, self.parser.ordinary_traits[self.parser.roots[index].item_index].keyword.start)
            OmegaRootKind::BoundaryTrait -> incomplete(4, self.parser.boundary_traits[self.parser.roots[index].item_index].boundary_keyword.start)
            OmegaRootKind::Use -> incomplete(4, self.parser.uses[
                self.parser.roots[index].item_index].start)
        }
    }

    // Census all declaration identities before any body can resolve a call.
    // Otherwise an earlier caller could select the first member of a later
    // overload family and falsely reject its arity before coverage is known.
    state check_declarations(index: i32) {
        transition index < self.parser.machine_count {
            true -> declaration_unit(index)
            _ -> check_interfaces()
        }
    }
    state declaration_unit(index: i32) {
        transition self.select_construction_unit(source, self.construction.machines[index].unit) {
            1 -> machine_shape(index)
            _ -> return
        }
    }
    // The staged route validates every file's imports before any signature or
    // body. This pass installs disjoint machine/state/parameter header rows.
    state unit_imports(unit: i32) {
        transition unit < self.parser.sources.unit_count {
            true -> unit_import_view(unit)
            _ -> reset_storage(0)
        }
    }
    state unit_import_view(unit: i32) {
        self.load_construction_unit(source, unit);
        transition self.parser.status {
            OmegaParserStatus::Complete -> unit_import_check(unit)
            _ -> internal()
        }
    }
    state unit_import_check(unit: i32) {
        transition self.validate_imports(source, -1) {
            1 -> unit_imports(unit + 1)
            _ -> return
        }
    }
    state check_interfaces() {
        transition self.check_public_interfaces(source) {
            1 -> check_entry_bounds(0)
            _ -> return
        }
    }
    state check_entry_bounds(state_index: i32) {
        transition state_index < self.program_state_count() {
            true -> decode_entry_bounds(state_index)
            _ -> signatures_ready()
        }
    }
    state signatures_ready() {
        transition self.construction.active {
            1 -> parameter_storage_ready()
            _ -> check_machine(0)
        }
    }
    state parameter_storage_ready() {
        self.construction.parameter_cells = self.cell_count;
        transition true { true -> labels(0) }
    }
    state decode_entry_bounds(state_index: i32) {
        // Read predicates in the state owner's source file. Their checked
        // bounds then use stable parameter and field IDs across files.
        transition self.select_construction_unit(source, self.construction.machines[self.state_owners[state_index]].unit) {
            1 -> loaded_entry_bounds(state_index)
            _ -> return
        }
    }
    state loaded_entry_bounds(state_index: i32) {
        let row: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
        transition (self.construction.compact_parameters == 1) && (row.lexical_parent >= 0) &&
            (row.requirement_count > 0) {
            true -> bound_parameters(state_index, row.first_parameter, row.parameter_count)
            _ -> checked_entry_bounds(state_index)
        }
    }
    // A nested parameter slot can denote a different type in each file.
    // Resolve types now for the predicate. Body preparation assigns storage.
    state bound_parameters(state_index: i32, slot: i32, count: i32) {
        transition count > 0 {
            true -> bound_parameter(state_index, slot, count)
            _ -> checked_entry_bounds(state_index)
        }
    }
    state bound_parameter(state_index: i32, slot: i32, count: i32) {
        self.parameter_types[slot] = self.parameter_type(source, slot);
        transition true { true -> bound_parameters(state_index, slot + 1, count - 1) }
    }
    state checked_entry_bounds(state_index: i32) {
        transition self.decode_entry_bounds(source, state_index) {
            1 -> check_entry_bounds(state_index + 1)
            _ -> return
        }
    }

    state check_machine(index: i32) {
        transition (self.construction.active == 1) && (index == self.construction.unit_end) {
            true -> emit_unit_literals(self.construction.unit_first)
            _ -> next_machine(index)
        }
    }
    state next_machine(index: i32) {
        transition index < self.parser.machine_count {
            true -> begin_states(index)
            _ -> check_entry()
        }
    }

    state machine_shape(index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        self.diagnostic_offset = item.start;
        transition (item.path_member_count == 1) && (item.state_count >= 1) &&
            (item.is_bodyless == 0) &&
            (item.has_target == 0) {
            true -> machine_clauses(index, item.first_clause, item.first_clause + item.clause_count, 0, 0)
            _ -> incomplete(4, self.diagnostic_offset)
        }
    }

    // Private bodies infer an omitted crash ceiling. Public bodies and
    // explicit empty ceilings must discharge every propagated Trap route.
    state machine_clauses(index: i32, cursor: i32, end: i32, empty: i32, trap: i32) {
        transition cursor < end {
            true -> crash_ceiling(index, cursor, end, empty, trap)
            _ -> retain_crash_ceiling(index, empty, trap)
        }
    }
    state crash_ceiling(index: i32, cursor: i32, end: i32, empty: i32, trap: i32) {
        let clause: OmegaMachineClauseSyntax = self.parser.machine_clauses[cursor];
        transition clause.kind {
            OmegaMachineClauseKind::Reaches -> reach_ceiling(index, cursor, end, empty, trap)
            OmegaMachineClauseKind::Blocks -> block_ceiling(index, cursor, end, empty, trap, 1)
            OmegaMachineClauseKind::BlocksFalse -> block_ceiling(index, cursor, end, empty, trap, 0)
            OmegaMachineClauseKind::CrashesNone -> merge_crash_ceiling(index, cursor, end, 1, trap)
            OmegaMachineClauseKind::CrashesTrap -> merge_crash_ceiling(index, cursor, end, empty, 1)
            _ -> incomplete(4, clause.start)
        }
    }
    state reach_ceiling(index: i32, cursor: i32, end: i32, empty: i32, trap: i32) {
        transition self.check_reach_clause(source, index, cursor) {
            1 -> machine_clauses(index, cursor + 1, end, empty, trap)
            _ -> return
        }
    }
    state block_ceiling(index: i32, cursor: i32, end: i32, empty: i32, trap: i32, bound: i32) {
        transition self.block_bounds[index] < 0 {
            true -> retain_block_ceiling(index, cursor, end, empty, trap, bound)
            _ -> reject(-1, 4, self.parser.machine_clauses[cursor].start)
        }
    }
    state retain_block_ceiling(index: i32, cursor: i32, end: i32, empty: i32, trap: i32, bound: i32) {
        self.block_bounds[index] = bound;
        let entry_state: i32 = self.parser.machine_items[index].first_state;
        self.state_effects[entry_state] = self.state_effects[entry_state] | bound;
        transition true { true -> machine_clauses(index, cursor + 1, end, empty, trap) }
    }
    state merge_crash_ceiling(index: i32, cursor: i32, end: i32, empty: i32, trap: i32) {
        transition (empty == 1) && (trap == 1) {
            true -> reject(-1, 4, self.parser.machine_clauses[cursor].start)
            _ -> machine_clauses(index, cursor + 1, end, empty, trap)
        }
    }
    state retain_crash_ceiling(index: i32, empty: i32, trap: i32) {
        // Callers may rely on the declaration across a package edge. Carry its
        // published route even when this particular body happens to be total.
        let entry_state: i32 = self.parser.machine_items[index].first_state;
        self.state_effects[entry_state] = self.state_effects[entry_state] | (trap * 2);
        transition (trap == 1) || ((empty == 0) && (self.parser.machine_items[index].is_public == 0)) {
            true -> set_crash_ceiling(index, 1)
            _ -> set_crash_ceiling(index, 0)
        }
    }
    state set_crash_ceiling(index: i32, allows: i32) {
        self.machine_allows_trap[index] = allows;
        transition true { true -> machine_signatures(index) }
    }

    // An empty unannotated outer body may have no generated entry row.
    // Its first nested declaration must never become the outer callable.
    state machine_signatures(index: i32) {
        transition self.parser.machine_states[self.local_state_row(
            self.parser.machine_items[index].first_state)].name_kind {
            OmegaMachineStateNameKind::GeneratedEntry -> machine_types(index)
            _ -> incomplete(4, self.diagnostic_offset)
        }
    }

    state machine_types(index: i32) {
        transition self.check_signatures(source, index) {
            1 -> check_duplicate(index, 0)
            _ -> return
        }
    }

    state check_duplicate(index: i32, previous: i32) {
        transition previous < index {
            true -> compare_name(index, previous)
            _ -> check_declarations(index + 1)
        }
    }

    state compare_name(index: i32, previous: i32) {
        let name: OmegaRelativeSpan = self.declaration_name(OmegaDeclarationKind::Machine, index);
        let other: OmegaRelativeSpan = self.declaration_name(OmegaDeclarationKind::Machine, previous);
        transition (self.parser.sources.unit_at(name.start) == self.parser.sources.unit_at(other.start)) &&
            (self.span_equals(source, name.start, name.end, source[other.start..other.end]) == 1) {
            true -> duplicate_arity(index, previous, name.start)
            _ -> check_duplicate(index, previous + 1)
        }
    }

    // Structural identity ignores parameter spelling. Differing arity or an
    // unimplemented operand type denotes an unsupported overload family.
    state duplicate_arity(index: i32, previous: i32, coordinate: i32) {
        transition self.state_parameter_count(
            self.parser.machine_items[index].first_state) ==
            self.state_parameter_count(
            self.parser.machine_items[previous].first_state) {
            true -> duplicate_parameter(index, previous, 0, coordinate)
            _ -> incomplete(4, coordinate)
        }
    }

    state duplicate_parameter(index: i32, previous: i32, offset: i32, coordinate: i32) {
        transition offset < self.state_parameter_count(
            self.parser.machine_items[index].first_state) {
            true -> duplicate_parameter_type(index, previous, offset, coordinate)
            _ -> reject(10, 4, coordinate)
        }
    }

    state duplicate_parameter_type(index: i32, previous: i32,
        offset: i32, coordinate: i32) {
        transition self.parameter_types[self.state_first_parameter(
            self.parser.machine_items[index].first_state) + offset] ==
            self.parameter_types[self.state_first_parameter(
            self.parser.machine_items[previous].first_state) + offset] {
            true -> duplicate_parameter(index, previous, offset + 1, coordinate)
            _ -> incomplete(4, coordinate)
        }
    }

    // A free machine owns a contiguous run of machine_states rows; the first
    // is its generated top-level entry and the rest are authored states.
    state begin_states(index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        self.diagnostic_offset = item.start;
        transition true { true -> check_states(index, item.first_state) }
    }

    state check_states(index: i32, state_index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        transition state_index < item.first_state + item.state_count {
            true -> state_body(index, state_index)
            _ -> finish_machine(index)
        }
    }

    state state_body(index: i32, state_index: i32) {
        transition self.parser.machine_states[self.local_state_row(state_index)].statement_count {
            0 -> missing_terminal(index, state_index)
            _ -> check_statement(index, state_index, 0)
        }
    }

    // A body ending after its last statement completes with Unit. That is
    // its own result, never an inherited result from an enclosing machine.
    state missing_terminal(index: i32, state_index: i32) {
        transition self.state_types[state_index] == 2 {
            true -> unit_terminal(index, state_index)
            _ -> missing_scalar_terminal(index, state_index)
        }
    }
    state unit_terminal(index: i32, state_index: i32) {
        self.state_terminal_kind[self.local_state_row(state_index)] = 6;
        transition true { true -> check_states(index, state_index + 1) }
    }
    state missing_scalar_terminal(index: i32, state_index: i32) {
        transition state_index ==
            self.parser.machine_items[index].first_state {
            true -> reject(-1, 4, self.diagnostic_offset)
            _ -> reject(-1, 4,
                self.state_name_start(state_index))
        }
    }

    state check_statement(index: i32, state_index: i32, statement_offset: i32) {
        let statement: i32 =
            self.parser.machine_states[self.local_state_row(state_index)].first_statement +
            statement_offset;
        transition self.parser.statements[statement].kind {
            OmegaStatementKind::Call -> check_call(index, state_index, statement)
            OmegaStatementKind::CrashTrap -> check_crash(index, state_index, statement_offset,
                self.parser.statements[statement].item_index)
            OmegaStatementKind::Expression ->
                check_terminal(index, state_index, statement_offset, statement)
            OmegaStatementKind::Transition ->
                check_transition(index, state_index, statement_offset)
            OmegaStatementKind::Assignment ->
                check_assignment(index, state_index, statement_offset,
                    self.parser.assignment_statements[self.parser.statements[statement].item_index])
            OmegaStatementKind::LocalData ->
                check_local(index, state_index, statement_offset,
                    self.parser.local_data_statements[self.parser.statements[statement].item_index])
            _ -> internal()
        }
    }

    state check_crash(index: i32, state_index: i32, offset: i32, coordinate: i32) {
        transition offset + 1 == self.parser.machine_states[self.local_state_row(state_index)].statement_count {
            true -> check_crash_route(index, state_index, offset, coordinate)
            _ -> incomplete(4, coordinate)
        }
    }
    state check_crash_route(index: i32, state_index: i32, offset: i32, coordinate: i32) {
        // An unconditional first operation in an unconstrained initial state
        // needs no path analysis. Other possible routes use the call summary.
        transition ((self.state_crash_bound(state_index) == 1) ||
            ((state_index == self.parser.machine_items[index].first_state) &&
             (self.machine_allows_trap[index] == 0))) && (offset == 0) &&
            (self.parser.machine_states[self.local_state_row(state_index)].requirement_count == 0) {
            true -> reject(-1, 4, coordinate)
            _ -> retain_trap_terminal(index, state_index)
        }
    }
    state retain_trap_terminal(index: i32, state_index: i32) {
        self.state_effects[state_index] = self.state_effects[state_index] | 2;
        self.state_terminal_kind[self.local_state_row(state_index)] = 7;
        transition true { true -> check_states(index, state_index + 1) }
    }

    state check_local(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        let kind: i32 = self.scalar_type(source, local.type_reference);
        let array_row: i32 = self.indexable_array_row(kind, 0);
        let array_local: i32 = (array_row >= 0) && ((local.has_initial_value == 1) ||
            (self.array_element_kind(source, array_row) == 64));
        transition ((kind > 0) && (kind != 2) && (kind < 200000)) || array_local {
            true -> local_name(index, state_index, statement_offset, local)
            _ -> incomplete(4, local.start)
        }
    }

    state local_name(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition self.value_cell(source, state_index, statement_offset,
            local.name.start, local.name.end) < 0 {
            true -> local_scope(index, state_index, statement_offset, local)
            _ -> reject(10, 4, local.name.start)
        }
    }

    state local_scope(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition self.resolve_machine(source, local.name.start, local.name.end) < 0 {
            true -> local_value(index, state_index, statement_offset, local)
            _ -> incomplete(4, local.name.start)
        }
    }

    state local_value(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        let local_index: i32 = self.parser.statements[
            self.parser.machine_states[self.local_state_row(state_index)].first_statement + statement_offset].item_index;
        self.local_befores[local_index] = statement_offset;
        let kind: i32 = self.scalar_type(source, local.type_reference);
        transition (local.has_initial_value == 0) && (self.uninhabited_type(kind) == 1) {
            true -> reject(-1, 4, local.start)
            _ -> local_storage(index, state_index, statement_offset, local, local_index, kind)
        }
    }
    state local_storage(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax, local_index: i32, kind: i32) {
        transition self.require_cell(source, 16384 + local_index, kind) {
            1 -> local_initial_value(index, state_index, statement_offset, local)
            _ -> return
        }
    }
    state local_initial_value(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition local.has_initial_value {
            0 -> next_statement(index, state_index, statement_offset + 1)
            _ -> local_check_initial(index, state_index, statement_offset, local)
        }
    }
    state local_check_initial(index: i32, state_index: i32, statement_offset: i32,
        local: OmegaLocalDataStatementSyntax) {
        transition self.check_value(source, index, state_index, statement_offset,
            local.initial_value, self.scalar_type(source, local.type_reference)) {
            1 -> next_statement(index, state_index, statement_offset + 1)
            _ -> return
        }
    }
    state check_assignment(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        self.assignment_loan_base = self.loan_count;
        transition self.check_place(source, state_index, statement_offset, row.target) {
            1 -> assignment_access(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_access(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.place_writable[row.target] == 1 {
            true -> assignment_available(index, state_index, statement_offset, row)
            _ -> reject(-1, 4, row.start)
        }
    }
    state assignment_available(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition (self.place_available(source, row.target, 1) == 1) &&
            (self.require_cell(source, 49152 + row.target, 32) == 1) {
            true -> assignment_copy(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_copy(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.type_copy(source, self.place_types[row.target]) {
            1 -> assignment_loan(index, state_index, statement_offset, row)
            _ -> incomplete(4, row.start)
        }
    }
    state assignment_loan(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.parser.expressions[row.target].kind {
            OmegaExpressionKind::Indexed -> indexed_assignment_loan(index, state_index, statement_offset, row)
            _ -> assignment_value(index, state_index, statement_offset, row)
        }
    }
    state indexed_assignment_loan(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.retain_index_loan(row.target) {
            1 -> assignment_value(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_value(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.check_value(source, index, state_index, statement_offset,
            row.value, self.place_types[row.target]) {
            1 -> assignment_bound(index, state_index, statement_offset, row)
            _ -> return
        }
    }
    state assignment_bound(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.place_fields[row.target] >= 0 {
            true -> assignment_field_bound(index, state_index, statement_offset, row)
            _ -> assignment_done(index, state_index, statement_offset)
        }
    }
    state assignment_field_bound(index: i32, state_index: i32, statement_offset: i32,
        row: OmegaAssignmentStatementSyntax) {
        transition self.check_field_bound(source, self.place_fields[row.target], row.value) {
            1 -> assignment_done(index, state_index, statement_offset)
            _ -> return
        }
    }
    state assignment_done(index: i32, state_index: i32, statement_offset: i32) {
        self.loan_count = self.assignment_loan_base;
        transition true { true -> next_statement(index, state_index, statement_offset + 1) }
    }

    state next_statement(index: i32, state_index: i32, statement_offset: i32) {
        transition statement_offset <
            self.parser.machine_states[self.local_state_row(state_index)].statement_count {
            true -> check_statement(index, state_index, statement_offset)
            _ -> missing_terminal(index, state_index)
        }
    }

    // Non-terminal statements are ordinary calls into free machines. Receiver
    // paths and static machine arguments remain coverage boundaries.
    state check_call(index: i32, state_index: i32, statement: i32) {
        let call: OmegaCallStatementSyntax = self.parser.call_statements[
            self.parser.statements[statement].item_index];
        transition (call.receiver_member_count + 1 == call.name_member_count) &&
            (call.receiver_starts_at_self == 0) &&
            (call.machine_argument_count == 0) {
            true -> call_target(index, state_index, statement, call)
            _ -> incomplete(4, call.start)
        }
    }

    state call_target(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax) {
        let name: OmegaRelativeSpan = self.parser.members[call.target_member];
        transition (call.receiver_member_count > 0) ||
            (self.resolve_state(source, state_index, name.start, name.end) < 0) {
            true -> global_call_target(index, state_index, statement, call, name)
            _ -> nested_call(state_index, statement, name)
        }
    }

    state nested_call(state_index: i32, statement: i32, name: OmegaRelativeSpan) {
        let before: i32 = statement - self.parser.machine_states[self.local_state_row(state_index)].first_statement;
        transition self.check_helper_name(source, state_index, before, name) {
            1 -> incomplete(4, name.start)
            _ -> return
        }
    }

    state global_call_target(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, name: OmegaRelativeSpan) {
        let callee: i32 = self.resolve_machine(source,
            self.parser.members[call.first_receiver_member].start, name.end);
        transition callee >= 0 {
            true -> call_arity(index, state_index, statement, call, callee)
            _ -> unresolved_call(index, state_index, statement, call, name)
        }
    }
    state unresolved_call(index: i32, state_index: i32, statement: i32, call: OmegaCallStatementSyntax,
        name: OmegaRelativeSpan) {
        transition self.check_terminal_invocation(source, index, state_index, statement - self.parser.machine_states[self.local_state_row(state_index)].first_statement,
            call.first_argument, call.argument_count, self.terminal_declaration_coordinate(source, call.first_receiver_member,
                call.receiver_member_count, name), call.start, name) {
            1 -> process_tail(index, state_index, statement, call)
            _ -> return
        }
    }

    state process_tail(index: i32, state_index: i32, statement: i32, call: OmegaCallStatementSyntax) {
        let state_row: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
        transition (call.acknowledgements == 0) && (statement + 1 == state_row.first_statement + state_row.statement_count) {
            true -> process_terminal(index, state_index, self.parser.call_arguments[call.first_argument])
            _ -> incomplete(4, call.start)
        }
    }
    state process_terminal(index: i32, state_index: i32, argument: i32) {
        self.state_terminal_kind[state_index] = 9;
        self.state_targets[state_index] = argument;
        transition true { true -> check_states(index, state_index + 1) }
    }

    // Every ordinary argument must match the callee's declared scalar parameter
    // list; a mismatched arity is a checking refusal.
    state call_arity(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition call.argument_count == self.state_parameter_count(
            self.parser.machine_items[callee].first_state) {
            true -> call_values(index, state_index, statement, call, callee)
            _ -> reject(-1, 4, call.start)
        }
    }

    state call_values(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition self.check_value_arguments(source, index, state_index,
            statement - self.parser.machine_states[self.local_state_row(state_index)].first_statement,
            call.first_argument, call.argument_count,
            self.state_first_parameter(self.parser.machine_items[callee].first_state), 0) {
            1 -> call_contract(index, state_index, statement, call, callee)
            _ -> return
        }
    }

    state call_contract(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition self.check_call_bounds(source, state_index,
            statement - self.parser.machine_states[self.local_state_row(state_index)].first_statement,
            call.first_argument, call.argument_count, self.parser.machine_items[callee].first_state, -1, 0) {
            1 -> call_edge(index, state_index, statement, call, callee)
            _ -> return
        }
    }
    state call_edge(index: i32, state_index: i32, statement: i32,
        call: OmegaCallStatementSyntax, callee: i32) {
        transition (self.retain_edge(index, state_index, callee, call.start, call.acknowledgements) == 1) &&
            (self.retain_call_effects(state_index,
                statement - self.parser.machine_states[self.local_state_row(state_index)].first_statement,
                call.first_argument, call.argument_count,
                self.state_first_parameter(self.parser.machine_items[callee].first_state)) == 1) {
            true -> retain_call(index, state_index, statement, callee)
            _ -> return
        }
    }

    state retain_call(index: i32, state_index: i32, statement: i32, callee: i32) {
        self.call_targets[statement] = callee;
        let next: i32 = statement + 1 -
            self.parser.machine_states[self.local_state_row(state_index)].first_statement;
        transition self.uninhabited_type(self.state_types[self.parser.machine_items[callee].first_state]) {
            1 -> no_return_tail(index, state_index, statement, next)
            _ -> next_statement(index, state_index, next)
        }
    }
    state no_return_tail(index: i32, state_index: i32, statement: i32, next: i32) {
        transition next == self.parser.machine_states[self.local_state_row(state_index)].statement_count {
            true -> no_return_checked(index, state_index)
            _ -> incomplete(4, self.parser.call_statements[self.parser.statements[statement].item_index].start)
        }
    }
    state no_return_checked(index: i32, state_index: i32) {
        self.state_terminal_kind[self.local_state_row(state_index)] = 8;
        transition true { true -> check_states(index, state_index + 1) }
    }

    // The parser retains an expression statement only as a state's terminal.
    state check_terminal(index: i32, state_index: i32, statement_offset: i32,
        statement: i32) {
        transition statement_offset ==
            self.parser.machine_states[self.local_state_row(state_index)].statement_count - 1 {
            true -> terminal_kind(index, state_index,
                self.parser.statements[statement].item_index)
            _ -> internal()
        }
    }

    state terminal_kind(index: i32, state_index: i32, expression: i32) {
        transition self.check_value(source, index, state_index,
            self.parser.machine_states[self.local_state_row(state_index)].statement_count - 1, expression,
            self.state_types[state_index]) {
            1 -> retain_value_terminal(index, state_index, expression)
            _ -> return
        }
    }

    state retain_value_terminal(index: i32, state_index: i32, expression: i32) {
        self.state_terminal_kind[self.local_state_row(state_index)] = 4;
        self.state_targets[self.local_state_row(state_index)] = expression;
        transition true { true -> check_states(index, state_index + 1) }
    }

    // A transition block is the consecutive run of transition rows sharing
    // one subject; the parser expands every arm into its own row, so the run
    // boundary is the first row whose subject differs or whose kind is not
    // Transition. The block must close the state: a row after the run would
    // be unreachable, a coverage boundary this slice refuses as Incomplete.
    state check_transition(index: i32, state_index: i32, statement_offset: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[self.local_state_row(state_index)].first_statement +
                    statement_offset].item_index];
        self.transition_anchor = row.start;
        transition true {
            true -> transition_run_end(index, state_index, statement_offset,
                statement_offset + 1, row.has_subject, row.subject)
        }
    }

    state transition_run_end(index: i32, state_index: i32, statement_offset: i32,
        cursor: i32, has_subject: i32, subject: i32) {
        transition cursor <
            self.parser.machine_states[self.local_state_row(state_index)].statement_count {
            true -> transition_run_row(index, state_index, statement_offset,
                cursor, has_subject, subject)
            _ -> transition_subject(index, state_index, statement_offset,
                cursor, has_subject, subject)
        }
    }

    state transition_run_row(index: i32, state_index: i32, statement_offset: i32,
        cursor: i32, has_subject: i32, subject: i32) {
        transition self.parser.statements[
            self.parser.machine_states[self.local_state_row(state_index)].first_statement +
            cursor].kind {
            OmegaStatementKind::Transition ->
                transition_run_signature(index, state_index, statement_offset,
                    cursor, has_subject, subject)
            _ -> incomplete(4, self.transition_anchor)
        }
    }

    state transition_run_signature(index: i32, state_index: i32,
        statement_offset: i32, cursor: i32, has_subject: i32, subject: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[self.local_state_row(state_index)].first_statement +
                    cursor].item_index];
        transition (row.has_subject == has_subject) && (row.subject == subject) {
            true -> transition_run_end(index, state_index, statement_offset,
                cursor + 1, has_subject, subject)
            _ -> incomplete(4, self.transition_anchor)
        }
    }

    state transition_subject(index: i32, state_index: i32,
        statement_offset: i32, run_end: i32, has_subject: i32, subject: i32) {
        transition has_subject {
            0 -> subjectless(index, state_index, statement_offset, run_end)
            1 -> subject_kind(index, state_index, statement_offset, run_end,
                subject)
            _ -> internal()
        }
    }

    // Every predicate and target is checked, including arms after a wildcard.
    // Possible call effects remain conservatively retained across arms: a
    // later guard cannot reuse an entry fact invalidated on an earlier path.
    state subjectless(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32) {
        transition true { true -> predicate_arm(index, state_index,
            statement_offset, run_end, statement_offset, 0) }
    }
    state predicate_arm(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32) {
        transition arm < last {
            true -> predicate_guard(index, state_index, first, last, arm, covered,
                self.parser.statements[self.parser.machine_states[
                    self.local_state_row(state_index)].first_statement + arm].item_index)
            _ -> predicate_covered(index, state_index, first, last, covered)
        }
    }
    state predicate_guard(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row_index: i32) {
        let row: OmegaTransitionStatementSyntax = self.parser.transition_statements[row_index];
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always ->
                predicate_target(index, state_index, first, last, arm, 1, row_index)
            OmegaTransitionGuardKind::Predicate ->
                predicate_value(index, state_index, first, last, arm, covered, row_index, row)
            _ -> incomplete(4, row.guard_start)
        }
    }
    state predicate_value(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row_index: i32, row: OmegaTransitionStatementSyntax) {
        transition self.check_value(source, index, state_index, first, row.guard_expression, 1) {
            1 -> predicate_coverage(index, state_index, first, last, arm, covered, row_index, row.guard_expression)
            _ -> return
        }
    }
    state predicate_coverage(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row_index: i32, expression: i32) {
        transition self.predicate_is_true(expression) {
            1 -> predicate_target(index, state_index, first, last, arm, 1, row_index)
            _ -> predicate_target(index, state_index, first, last, arm, covered, row_index)
        }
    }
    state predicate_target(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row_index: i32) {
        self.active_boolean_arm = row_index;
        let checked: i32 = self.check_transition_target(source, index, state_index, first, row_index);
        self.active_boolean_arm = -1;
        transition checked {
            1 -> predicate_arm(index, state_index, first, last, arm + 1, covered)
            _ -> return
        }
    }
    state predicate_covered(index: i32, state_index: i32, first: i32, last: i32,
        covered: i32) {
        transition covered {
            1 -> retain_dynamic(index, state_index, first, last)
            // Complementary guards may prove coverage in Omega, but this
            // slice requires a wildcard or a literal true, not guessed proof.
            _ -> incomplete(4, self.transition_anchor)
        }
    }

    // A subject transition folds its subject once: a Boolean literal keeps
    // its Boolean class, and any other admitted spelling folds to a u8 under
    // the same Exact policy as a terminal expression.
    state subject_kind(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition self.is_constant_expression(subject) {
            1 -> subject_fold(index, state_index, statement_offset, run_end, subject)
            _ -> dynamic_subject(index, state_index, statement_offset, run_end, subject)
        }
    }

    state dynamic_subject(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition true { true -> dynamic_type(index, state_index, statement_offset, run_end, subject,
            self.expression_type(source, index, state_index, statement_offset, subject)) }
    }
    state dynamic_type(index: i32, state_index: i32, first: i32, last: i32, subject: i32, kind: i32) {
        transition kind {
            1 -> dynamic_value(index, state_index, first, last, subject, kind)
            8 -> dynamic_value(index, state_index, first, last, subject, kind)
            32 -> dynamic_value(index, state_index, first, last, subject, kind)
            64 -> dynamic_value(index, state_index, first, last, subject, kind)
            _ -> dynamic_sum(index, state_index, first, last, kind)
        }
    }
    state dynamic_sum(index: i32, state_index: i32, first: i32, last: i32, kind: i32) {
        transition (kind >= 100000) && (kind < 104096) {
            true -> dynamic_sum_shape(index, state_index, first, last, kind - 100000)
            _ -> incomplete(4, self.transition_anchor)
        }
    }
    state dynamic_sum_shape(index: i32, state_index: i32, first: i32, last: i32, declaration: i32) {
        transition self.parser.data_items[declaration].case_count > 0 {
            true -> dynamic_sum_check(index, state_index, first, last, declaration)
            _ -> incomplete(4, self.transition_anchor)
        }
    }
    state dynamic_sum_check(index: i32, state_index: i32, first: i32, last: i32, declaration: i32) {
        transition self.check_case_transition(source, index, state_index, first, last, declaration) {
            1 -> retain_dynamic(index, state_index, first, last)
            _ -> return
        }
    }

    state dynamic_value(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32, kind: i32) {
        transition self.check_value(source, index, state_index, statement_offset, subject, kind) {
            1 -> dynamic_arm(index, state_index, statement_offset, run_end, statement_offset, 0)
            _ -> return
        }
    }

    state dynamic_arm(index: i32, state_index: i32, first: i32, last: i32, arm: i32, covered: i32) {
        transition arm < last {
            true -> dynamic_guard(index, state_index, first, last, arm, covered,
                self.parser.transition_statements[self.parser.statements[
                    self.parser.machine_states[self.local_state_row(state_index)].first_statement + arm].item_index])
            _ -> dynamic_covered(index, state_index, first, last, covered)
        }
    }
    state dynamic_guard(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row: OmegaTransitionStatementSyntax) {
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always -> dynamic_target(index, state_index, first, last, arm, 3)
            OmegaTransitionGuardKind::Boolean -> dynamic_boolean_type(index, state_index, first, last, arm, covered, row)
            OmegaTransitionGuardKind::Integer -> dynamic_integer(index, state_index, first, last, arm, covered, row)
            _ -> incomplete(4, row.guard_start)
        }
    }
    state dynamic_boolean_type(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row: OmegaTransitionStatementSyntax) {
        transition self.cell_types[49152 + row.subject] == 1 {
            true -> dynamic_boolean(index, state_index, first, last, arm, covered, row.guard_boolean)
            _ -> reject(-1, 4, row.guard_start)
        }
    }
    state dynamic_integer(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, row: OmegaTransitionStatementSyntax) {
        let row_index: i32 = self.parser.statements[self.parser.machine_states[self.local_state_row(state_index)].first_statement + arm].item_index;
        transition self.check_integer_guard(source, row_index, row, self.cell_types[49152 + row.subject]) {
            1 -> dynamic_target(index, state_index, first, last, arm, covered)
            _ -> return
        }
    }
    state dynamic_boolean(index: i32, state_index: i32, first: i32, last: i32,
        arm: i32, covered: i32, value: i32) {
        transition value {
            0 -> dynamic_target(index, state_index, first, last, arm, covered | 1)
            _ -> dynamic_target(index, state_index, first, last, arm, covered | 2)
        }
    }
    state dynamic_target(index: i32, state_index: i32, first: i32, last: i32, arm: i32, covered: i32) {
        let statement: i32 = self.parser.machine_states[self.local_state_row(state_index)].first_statement + arm;
        self.active_boolean_arm = self.parser.statements[statement].item_index;
        let checked: i32 = self.check_transition_target(source, index, state_index, first, self.active_boolean_arm);
        self.active_boolean_arm = -1;
        transition checked {
            1 -> dynamic_arm(index, state_index, first, last, arm + 1, covered)
            _ -> return
        }
    }
    state dynamic_covered(index: i32, state_index: i32, first: i32, last: i32, covered: i32) {
        transition covered == 3 {
            true -> retain_dynamic(index, state_index, first, last)
            _ -> reject(-1, 4, self.transition_anchor)
        }
    }
    state retain_dynamic(index: i32, state_index: i32, first: i32, last: i32) {
        self.state_terminal_kind[self.local_state_row(state_index)] = 5;
        self.state_targets[self.local_state_row(state_index)] = first;
        self.state_values[self.local_state_row(state_index)] = last;
        transition true { true -> check_states(index, state_index + 1) }
    }

    state subject_fold(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition self.is_bounded_constant(source, subject) {
            1 -> subject_fold_value(index, state_index, statement_offset, run_end, subject)
            _ -> incomplete(4, self.transition_anchor)
        }
    }
    state subject_fold_value(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32, subject: i32) {
        transition self.fold_expression(source, subject) {
            0 -> subject_folded(index, state_index, statement_offset, run_end)
            1 -> incomplete(4, self.transition_anchor)
            _ -> return
        }
    }

    state subject_folded(index: i32, state_index: i32, statement_offset: i32,
        run_end: i32) {
        self.subject_class = self.fold_class;
        self.subject_value = self.fold_value;
        transition true {
            true -> scan_arm(index, state_index, run_end, statement_offset, -1)
        }
    }

    // Arms are checked in source order: each guard either proves it matches
    // the folded subject or stays a coverage refusal, every arm's target
    // resolves and binds, and the first matching arm owns the transition.
    state scan_arm(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32) {
        transition arm < run_end {
            true -> arm_guard(index, state_index, run_end, arm, selected)
            _ -> transition_covered(index, state_index, selected)
        }
    }

    state arm_guard(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[self.local_state_row(state_index)].first_statement +
                    arm].item_index];
        transition row.guard_kind {
            OmegaTransitionGuardKind::Always ->
                arm_target(index, state_index, run_end, arm, selected, 1)
            OmegaTransitionGuardKind::Integer ->
                arm_integer(index, state_index, run_end, arm, selected)
            OmegaTransitionGuardKind::Boolean ->
                arm_boolean(index, state_index, run_end, arm, selected, row)
            _ -> incomplete(4, row.guard_start)
        }
    }

    // An integer guard can only match a u8 subject; its literal folds under
    // the same bounds as an expression literal.
    state arm_integer(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32) {
        let row: OmegaTransitionStatementSyntax =
            self.parser.transition_statements[
                self.parser.statements[
                    self.parser.machine_states[self.local_state_row(state_index)].first_statement +
                    arm].item_index];
        transition self.subject_class {
            0 -> arm_integer_literal(index, state_index, run_end, arm,
                selected, row)
            _ -> incomplete(4, row.guard_start)
        }
    }

    state arm_integer_literal(index: i32, state_index: i32, run_end: i32,
        arm: i32, selected: i32, row: OmegaTransitionStatementSyntax) {
        let literal: i32 = self.scan_u8(source, row.guard_start, row.guard_end);
        transition literal < 256 {
            true -> arm_integer_compare(index, state_index, run_end, arm,
                selected, row, literal)
            _ -> arm_integer_failed(row, literal)
        }
    }

    state arm_integer_failed(row: OmegaTransitionStatementSyntax, literal: i32) {
        transition literal == 256 {
            true -> incomplete(4, row.guard_start)
            _ -> reject(12, 4, row.guard_start)
        }
    }

    state arm_integer_compare(index: i32, state_index: i32, run_end: i32,
        arm: i32, selected: i32, row: OmegaTransitionStatementSyntax,
        literal: i32) {
        transition literal == self.subject_value {
            true -> arm_target(index, state_index, run_end, arm, selected, 1)
            _ -> arm_target(index, state_index, run_end, arm, selected, 0)
        }
    }

    // A Boolean guard can only match a Boolean subject.
    state arm_boolean(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32, row: OmegaTransitionStatementSyntax) {
        transition self.subject_class == 1 {
            true -> arm_boolean_compare(index, state_index, run_end, arm,
                selected, row)
            _ -> incomplete(4, row.guard_start)
        }
    }

    state arm_boolean_compare(index: i32, state_index: i32, run_end: i32,
        arm: i32, selected: i32, row: OmegaTransitionStatementSyntax) {
        transition row.guard_boolean == self.subject_value {
            true -> arm_target(index, state_index, run_end, arm, selected, 1)
            _ -> arm_target(index, state_index, run_end, arm, selected, 0)
        }
    }

    state arm_target(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32, matched: i32) {
        let row_index: i32 = self.parser.statements[
            self.parser.machine_states[self.local_state_row(state_index)].first_statement + arm].item_index;
        transition self.check_transition_target(source, index, state_index,
            arm, row_index) {
            1 -> arm_advance(index, state_index, run_end, arm, selected, matched, row_index)
            _ -> return
        }
    }
    state arm_advance(index: i32, state_index: i32, run_end: i32, arm: i32,
        selected: i32, matched: i32, row_index: i32) {
        transition (matched == 1) && (selected < 0) {
            true -> scan_arm(index, state_index, run_end, arm + 1, row_index)
            _ -> scan_arm(index, state_index, run_end, arm + 1, selected)
        }
    }

    // A subjectful block that matched no arm has no transfer for its subject
    // value, a checking refusal anchored at the block's first arrow.
    state transition_covered(index: i32, state_index: i32, selected: i32) {
        transition selected >= 0 {
            true -> retain_transition(index, state_index, selected)
            _ -> reject(-1, 4, self.transition_anchor)
        }
    }

    state retain_transition(index: i32, state_index: i32, target: i32) {
        self.state_terminal_kind[self.local_state_row(state_index)] = 3;
        self.state_targets[self.local_state_row(state_index)] = target;
        transition true { true -> check_states(index, state_index + 1) }
    }

    state finish_machine(index: i32) {
        transition self.check_private_arrivals(source, index) {
            1 -> finished_private_arrivals(index)
            _ -> return
        }
    }
    state finished_private_arrivals(index: i32) {
        let name: OmegaRelativeSpan = self.declaration_name(OmegaDeclarationKind::Machine, index);
        transition (self.parser.sources.unit_at(name.start) == self.entry_unit) &&
            (self.span_equals(source, name.start, name.end, entry) == 1) {
            true -> select(index)
            _ -> check_machine(index + 1)
        }
    }

    state select(index: i32) {
        self.selected_machine = index;
        transition true { true -> check_machine(index + 1) }
    }

    state check_entry() {
        transition self.selected_machine >= 0 {
            true -> chosen_entry(self.declaration_name(OmegaDeclarationKind::Machine, self.selected_machine))
            _ -> reject(11, 0, 0)
        }
    }
    state chosen_entry(name: OmegaRelativeSpan) {
        transition (self.process_entry.end == 0) || ((self.process_entry.start == name.start) && (self.process_entry.end == name.end)) {
            true -> entry_arity()
            _ -> reject(11, 4, name.start)
        }
    }

    state entry_arity() {
        transition self.state_parameter_count(
            self.parser.machine_items[self.selected_machine].first_state) {
            0 -> entry_result()
            _ -> incomplete(4, self.parser.machine_items[self.selected_machine].start)
        }
    }

    // The isolated Alpha adapter calls a parameterless entry. A returned byte
    // is its process status; normal Unit completion already returns zero.
    state entry_result() {
        let result: i32 = self.state_types[self.parser.machine_items[self.selected_machine].first_state];
        transition (result == 8) || (result == 2) {
            true -> call_graph()
            _ -> incomplete(4, self.parser.machine_items[self.selected_machine].start)
        }
    }

    state call_graph() {
        transition self.check_call_graph() {
            1 -> nested_call_graph()
            _ -> return
        }
    }
    state nested_call_graph() {
        transition self.check_nested_call_graph() { 1 -> service_reach() _ -> return }
    }
    state service_reach() {
        transition self.check_service_calls() {
            1 -> seed_effect(1, 0, 0)
            _ -> return
        }
    }

    // Each effect follows the same incoming calls and transitions. A state
    // enters the bounded worklist once per effect, including cycles.
    state seed_effect(effect: i32, index: i32, count: i32) {
        transition index < self.program_state_count() {
            true -> check_seed(effect, index, count)
            _ -> propagate_effect(effect, 0, count)
        }
    }
    state check_seed(effect: i32, index: i32, count: i32) {
        transition (self.state_effects[index] & effect) != 0 {
            true -> enqueue_seed(effect, index, count)
            _ -> seed_effect(effect, index + 1, count)
        }
    }
    state enqueue_seed(effect: i32, index: i32, count: i32) {
        self.effect_work[count] = index;
        transition true { true -> seed_effect(effect, index + 1, count + 1) }
    }
    state propagate_effect(effect: i32, cursor: i32, count: i32) {
        transition cursor < count {
            true -> predecessors(effect, cursor, count, self.state_incoming[self.effect_work[cursor]])
            _ -> next_effect(effect)
        }
    }
    state next_effect(effect: i32) {
        transition effect {
            1 -> seed_effect(2, 0, 0)
            _ -> check_state_bounds(0)
        }
    }
    state predecessors(effect: i32, cursor: i32, count: i32, edge: i32) {
        transition edge >= 0 {
            true -> predecessor(effect, cursor, count, self.state_invocations[edge])
            _ -> propagate_effect(effect, cursor + 1, count)
        }
    }
    state predecessor(effect: i32, cursor: i32, count: i32, edge: OmegaStateInvocation) {
        transition (self.state_effects[edge.caller] & effect) != 0 {
            true -> predecessors(effect, cursor, count, edge.next)
            _ -> enqueue_predecessor(effect, cursor, count, edge)
        }
    }
    state enqueue_predecessor(effect: i32, cursor: i32, count: i32, edge: OmegaStateInvocation) {
        self.state_effects[edge.caller] = self.state_effects[edge.caller] | effect;
        self.effect_work[count] = edge.caller;
        transition true { true -> predecessors(effect, cursor, count + 1, edge.next) }
    }
    state check_state_bounds(index: i32) {
        transition index < self.program_state_count() {
            true -> check_state_bound(index)
            _ -> check_crash_bounds(0)
        }
    }
    state check_state_bound(index: i32) {
        transition ((self.state_effects[index] & 1) != 0) && (self.state_block_bound(index) == 0) {
            true -> reject(-1, 4, self.state_name_start(index))
            _ -> check_nested_crash_bound(index)
        }
    }
    state check_nested_crash_bound(index: i32) {
        transition ((self.state_effects[index] & 2) != 0) && (self.state_crash_bound(index) == 1) {
            true -> incomplete(4, self.state_name_start(index))
            _ -> check_acknowledgements(index, self.state_incoming[index])
        }
    }
    state check_acknowledgements(target: i32, edge: i32) {
        transition edge >= 0 {
            true -> check_block_marker(target, self.state_invocations[edge])
            _ -> check_state_bounds(target + 1)
        }
    }
    state check_block_marker(target: i32, edge: OmegaStateInvocation) {
        transition ((self.state_effects[target] & 1) != 0) && ((edge.acknowledgements & 1) == 0) {
            true -> reject(-1, 4, edge.coordinate)
            _ -> check_suspend_marker(target, edge)
        }
    }
    state check_suspend_marker(target: i32, edge: OmegaStateInvocation) {
        transition (edge.acknowledgements & 2) != 0 {
            true -> incomplete(4, edge.coordinate)
            _ -> check_acknowledgements(target, edge.next)
        }
    }
    // The graph includes nested states and unused declarations. A possible
    // route that would need path-proof discharges remains outside this slice.
    state check_crash_bounds(index: i32) {
        transition index < self.parser.machine_count {
            true -> check_crash_bound(index)
            _ -> checked_graph()
        }
    }
    state checked_graph() {
        transition self.construction.active {
            1 -> finalize()
            _ -> labels(0)
        }
    }
    state check_crash_bound(index: i32) {
        transition (self.machine_allows_trap[index] == 0) &&
            ((self.state_effects[self.parser.machine_items[index].first_state] & 2) != 0) {
            true -> incomplete(4, self.parser.machine_items[index].start)
            _ -> check_block_bound(index)
        }
    }

    state check_block_bound(index: i32) {
        let bound: i32 = self.block_bounds[index];
        transition ((self.state_effects[self.parser.machine_items[index].first_state] & 1) != 0) && ((bound == 0) ||
            ((bound < 0) && (self.parser.machine_items[index].is_public != 0))) {
            true -> reject(-1, 4, self.parser.machine_items[index].start)
            _ -> check_crash_bounds(index + 1)
        }
    }

    // One Alpha label per parsed state and per machine entry; a machine's
    // label is its entry state's label, so calls and adapter entry reach the
    // top-level body exactly as the state contract specifies.
    state labels(index: i32) {
        transition index < self.program_state_count() {
            true -> label(index)
            _ -> machine_entry_labels(0)
        }
    }

    state label(index: i32) {
        self.emission_resource = 14;
        self.state_labels[index] = self.tape.new_label();
        transition self.state_labels[index] >= 0 {
            true -> labels(index + 1)
            _ -> emission_failure()
        }
    }

    state machine_entry_labels(index: i32) {
        transition index < self.parser.machine_count {
            true -> machine_entry_label(index)
            _ -> adapter()
        }
    }

    state machine_entry_label(index: i32) {
        self.machine_labels[index] = self.state_labels[
            self.parser.machine_items[index].first_state];
        transition true { true -> machine_entry_labels(index + 1) }
    }

    state adapter() {
        // A missing entry is diagnosed after all bodies have been checked.
        transition self.selected_machine < 0 {
            true -> start_unit(0)
            _ -> emit_adapter()
        }
    }
    state emit_adapter() {
        self.emission_resource = 12;
        transition (self.tape.emit_jump_label(19,
            self.machine_labels[self.selected_machine]) == 1) &&
            (self.tape.emit_r(0, 0) == 1) {
            true -> adapter_ready()
            _ -> emission_failure()
        }
    }
    state adapter_ready() {
        transition self.construction.active {
            1 -> start_unit(0)
            _ -> emit_unit_literals(0)
        }
    }
    state start_unit(unit: i32) {
        transition unit < self.parser.sources.unit_count {
            true -> start_unit_bodies(unit)
            _ -> check_entry()
        }
    }
    state start_unit_bodies(unit: i32) {
        self.load_construction_unit(source, unit);
        transition self.parser.status {
            OmegaParserStatus::Complete -> nested_parameters(unit)
            _ -> internal()
        }
    }
    state nested_parameters(unit: i32) {
        transition self.prepare_nested_parameters(source, unit) {
            1 -> check_machine(self.construction.unit_first)
            _ -> return
        }
    }

    state emit_unit_literals(first: i32) {
        self.emission_resource = 12;
        transition self.emit_quoted_image(source) {
            1 -> emit_machine(first)
            _ -> emission_failure()
        }
    }

    state emit_machine(index: i32) {
        transition (self.construction.active == 1) && (index == self.construction.unit_end) {
            true -> release_unit_cells(self.construction.parameter_cells)
            _ -> next_emitted_machine(index)
        }
    }
    // Emitted instructions retain physical offsets. Local row numbers may be
    // reused by the next file; its storage must not overwrite a live caller.
    state release_unit_cells(index: i32) {
        transition index < self.cell_count {
            true -> release_unit_cell(index)
            _ -> released_unit()
        }
    }
    state release_unit_cell(index: i32) {
        self.cell_sizes[self.cell_ids[index]] = 0;
        transition true { true -> release_unit_cells(index + 1) }
    }
    state released_unit() {
        self.cell_count = self.construction.parameter_cells;
        self.effect_count = 0;
        transition true { true -> start_unit(self.parser.unit_index + 1) }
    }
    state next_emitted_machine(index: i32) {
        transition index < self.parser.machine_count {
            true -> emit_first_state(index)
            _ -> finalize()
        }
    }

    state emit_first_state(index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        transition true {
            true -> emit_state(index, item.first_state)
        }
    }

    // States emit in declared order: each defines its label, runs its
    // non-terminal calls, then its single terminal exit.
    state emit_state(index: i32, state_index: i32) {
        let item: OmegaMachineSyntax = self.parser.machine_items[index];
        transition state_index < item.first_state + item.state_count {
            true -> emit_state_body(index, state_index)
            _ -> emit_machine(index + 1)
        }
    }

    state emit_state_body(index: i32, state_index: i32) {
        self.emission_resource = 12;
        transition self.tape.define_label(self.state_labels[state_index]) {
            1 -> emit_statements(index, state_index, 0)
            _ -> emission_failure()
        }
    }

    state emit_statements(index: i32, state_index: i32,
        statement_offset: i32) {
        transition (statement_offset < self.parser.machine_states[self.local_state_row(state_index)].statement_count) &&
            ((self.state_terminal_kind[self.local_state_row(state_index)] == 6) || (self.state_terminal_kind[self.local_state_row(state_index)] == 8) ||
            (statement_offset < self.parser.machine_states[self.local_state_row(state_index)].statement_count - 1)) {
            true -> emit_nonterminal(index, state_index, statement_offset)
            _ -> emit_terminal(index, state_index)
        }
    }

    // Non-terminal transition rows are the arms of the state's tail block;
    // their single selected target emits once at the terminal.
    state emit_nonterminal(index: i32, state_index: i32,
        statement_offset: i32) {
        transition self.parser.statements[
            self.parser.machine_states[self.local_state_row(state_index)].first_statement +
            statement_offset].kind {
            OmegaStatementKind::Call ->
                emit_call_statement(index, state_index, statement_offset)
            OmegaStatementKind::Transition ->
                emit_statements(index, state_index, statement_offset + 1)
            OmegaStatementKind::LocalData ->
                emit_local(index, state_index, statement_offset)
            OmegaStatementKind::Assignment ->
                emit_assignment_statement(index, state_index, statement_offset)
            _ -> internal()
        }
    }

    state emit_local(index: i32, state_index: i32, statement_offset: i32) {
        let local_index: i32 = self.parser.statements[
            self.parser.machine_states[self.local_state_row(state_index)].first_statement + statement_offset].item_index;
        self.local_befores[local_index] = statement_offset;
        transition self.parser.local_data_statements[local_index].has_initial_value {
            0 -> emit_local_zero(index, state_index, statement_offset, local_index)
            _ -> emit_local_value(index, state_index, statement_offset, local_index)
        }
    }
    state emit_local_zero(index: i32, state_index: i32, statement_offset: i32, local_index: i32) {
        transition self.emit_zero_cell(16384 + local_index) {
            1 -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }
    state emit_local_value(index: i32, state_index: i32, statement_offset: i32, local_index: i32) {
        transition (self.emit_value(self.parser.local_data_statements[local_index].initial_value) == 1) &&
            (self.emit_value_store(16384 + local_index) == 1) {
            true -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }
    state emit_assignment_statement(index: i32, state_index: i32, statement_offset: i32) {
        let row: OmegaAssignmentStatementSyntax = self.parser.assignment_statements[
            self.parser.statements[self.parser.machine_states[self.local_state_row(state_index)].first_statement + statement_offset].item_index];
        transition (self.emit_place_address(row.target) == 1) &&
            (self.emit_save_address(49152 + row.target) == 1) &&
            (self.emit_value(row.value) == 1) &&
            (self.tape.emit_rr(2, 2, 0) == 1) &&
            (self.emit_restore_address(49152 + row.target) == 1) &&
            (self.tape.emit_rr(2, 1, 0) == 1) &&
            (self.tape.emit_rr(2, 0, 2) == 1) &&
            (self.emit_store_at(self.place_types[row.target], self.place_value_size(row.target)) == 1) {
            true -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }

    state emit_call_statement(index: i32, state_index: i32,
        statement_offset: i32) {
        let callee: i32 = self.call_targets[
            self.parser.machine_states[self.local_state_row(state_index)].first_statement +
            statement_offset];
        let call: OmegaCallStatementSyntax = self.parser.call_statements[
            self.parser.statements[self.parser.machine_states[self.local_state_row(state_index)].first_statement +
                statement_offset].item_index];
        transition self.emit_value_call(callee, call.first_argument, call.argument_count) {
            1 -> emit_statements(index, state_index, statement_offset + 1)
            _ -> emission_failure()
        }
    }

    state emit_terminal(index: i32, state_index: i32) {
        transition self.state_terminal_kind[self.local_state_row(state_index)] {
            3 -> emit_jump_terminal(index, state_index)
            4 -> emit_value_terminal(index, state_index)
            5 -> emit_dynamic_terminal(index, state_index)
            6 -> emit_unit_terminal(index, state_index)
            7 -> emit_trap_terminal(index, state_index)
            // A selected process terminal consumes its one signed status.
            9 -> emit_process_terminal(index, state_index)
            // The last statement already transferred to its no-return callee.
            8 -> emit_state(index, state_index + 1)
            _ -> internal()
        }
    }
    state emit_process_terminal(index: i32, state_index: i32) {
        transition self.emit_process_terminal(self.state_targets[state_index]) {
            1 -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }
    state emit_trap_terminal(index: i32, state_index: i32) {
        transition self.emit_trap() {
            1 -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }
    state emit_unit_terminal(index: i32, state_index: i32) {
        transition self.emit_unit_return() {
            1 -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }

    state emit_value_terminal(index: i32, state_index: i32) {
        transition (self.emit_value(self.state_targets[self.local_state_row(state_index)]) == 1) &&
            (self.tape.emit_ret() == 1) {
            true -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }

    // A transition is a direct jump: no call frame, no return edge, and the
    // departed state never resumes.
    state emit_jump_terminal(index: i32, state_index: i32) {
        transition self.emit_transition_target(self.state_targets[self.local_state_row(state_index)]) {
            1 -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }
    state emit_dynamic_terminal(index: i32, state_index: i32) {
        transition self.emit_dynamic_transition(state_index,
            self.state_targets[self.local_state_row(state_index)], self.state_values[self.local_state_row(state_index)]) {
            1 -> emit_state(index, state_index + 1)
            _ -> emission_failure()
        }
    }

    state finalize() {
        transition self.tape.finalize() {
            1 -> complete()
            _ -> emission_failure()
        }
    }

    state emission_failure() {
        transition self.tape.status {
            1 -> emission_resource()
            _ -> emission_internal()
        }
    }

    // Tape construction capacity reports under space 2 with the resource the
    // refused operation was drawing on; coordinates are payload-relative.
    state emission_resource() {
        self.status = OmegaScalarCompilationStatus::ResourceFailure;
        self.outcome_tag = 2;
        self.outcome_space = 2;
        self.outcome_code = self.emission_resource;
        self.outcome_coordinate = self.tape.failure_offset;
        self.outcome_limit = omega_compiler_resource_limit(
            self.emission_resource);
        transition self.emission_resource {
            12 -> emission_payload_requested()
            _ -> emission_generic_requested()
        }
    }

    // tape_payload_bytes exhaustion requests the committed payload length
    // plus the refused write, normalized for publication.
    state emission_payload_requested() {
        self.outcome_requested = omega_saturating_i32_sum(
            self.tape.failure_offset, self.tape.failure_requested);
        return;
    }

    state emission_generic_requested() {
        self.outcome_requested = self.tape.failure_requested;
        return;
    }

    state emission_internal() {
        self.status = OmegaScalarCompilationStatus::InternalFailure;
        self.outcome_tag = 3;
        self.outcome_space = 3;
        self.outcome_code = 1;
        self.outcome_coordinate = 0;
        self.outcome_limit = 0;
        self.outcome_requested = 0;
    }

    state complete() { self.status = OmegaScalarCompilationStatus::Complete; }

    // Source-anchored refusals report space 4; space 0 marks a refusal with
    // no single source anchor, such as a missing selected entry. The code is
    // the contract's assigned Reject code, or -1 for a syntax or checking
    // refusal whose inventory is still unassigned.
    state reject(code: i32, space: i32, coordinate: i32) {
        self.record_reject(code, space, coordinate);
    }

    // Unsupported valid Omega is an Incomplete coverage refusal until the
    // request contract assigns its provision codes.
    state incomplete(space: i32, coordinate: i32) {
        self.record_incomplete(space, coordinate);
    }

    // Parser exhaustion already carries its assigned wire fields.
    state resource() {
        self.status = OmegaScalarCompilationStatus::ResourceFailure;
        self.outcome_tag = 2;
        self.outcome_space = 4;
        self.outcome_code = omega_parser_resource_code(self.parser.resource);
        self.outcome_coordinate = self.parser.diagnostic_start;
        self.outcome_limit = self.parser.resource_limit;
        self.outcome_requested = self.parser.resource_requested;
    }

    state internal() {
        self.record_internal();
    }
}

// Resolve named records independently of their physical layout. Reference
// cycles do not require recursive layout, but stored references remain outside
// this first aggregate profile because their lifetime/cleanup ledger is absent.
machine OmegaScalarCompiler::resolve_data(
    &mut self, source: &[u8], start: i32, end: i32
) -> i32 {
    return self.resolve_declaration(source, start, end, OmegaDeclarationKind::Data);
}

// Arrays use one band of 100000 syntax rows per qualification. Reject a row
// outside the band before it can name another array or a record reference.
machine omega_fixed_array_type(row: i32, trapping: i32) -> i32 {
    transition (row >= 0) && (row < 100000) {
        true -> qualify()
        _ -> return 0
    }
    state qualify() {
        transition trapping {
            0 -> return 200000 + row
            1 -> return 300000 + row
            _ -> return 0
        }
    }
}

// Fixed-array reference parameters use the ordinary shared/exclusive bands.
// The first 4096 indices in each band belong to records and 4096 to a slice.
// Adding 10000 leaves room for every local, field and parameter array row.
machine omega_array_reference(array: i32, access: i32) -> i32 { return 410000 + access * 100000 + array; }
machine omega_array_reference_row(kind: i32) -> i32 {
    let row: i32 = kind % 100000 - 10000;
    transition (kind >= 400000) && (kind < 600000) && (row >= 0) && (row < 65536) {
        true -> return row
        _ -> return -1
    }
}
machine omega_reference_target(kind: i32) -> i32 {
    let array: i32 = omega_array_reference_row(kind);
    transition array >= 0 {
        true -> return omega_fixed_array_type(array, 0)
        _ -> record()
    }
    state record() {
        transition ((kind >= 400000) && (kind < 404096)) || ((kind >= 500000) && (kind < 504096)) {
            true -> return 100000 + kind % 100000
            _ -> return -1
        }
    }
}

// Separately authored array types agree on extent, element and outer policy.
// Cross-file parameters carry these facts independently of the caller's syntax.
machine OmegaScalarCompiler::matches_array_or_value(&mut self, source: &[u8], left: i32, right: i32) -> i32 {
    transition left == right {
        true -> return 1
        _ -> arrays(self.fixed_array_row(left), self.fixed_array_row(right))
    }
    state arrays(a: i32, b: i32) {
        transition (a >= 0) && (b >= 0) && (left / 100000 == right / 100000) {
            true -> return (self.array_count(source, a) == self.array_count(source, b)) &&
                (self.array_element_kind(source, a) == self.array_element_kind(source, b))
            _ -> return 0
        }
    }
}
machine OmegaScalarCompiler::same_reference_type(&mut self, source: &[u8], left: i32, right: i32) -> i32 {
    transition left == right {
        true -> return 1
        _ -> arrays()
    }
    state arrays() {
        transition (omega_array_reference_row(left) >= 0) && (omega_array_reference_row(right) >= 0) &&
            (left / 100000 == right / 100000) {
            true -> return self.matches_array_or_value(source, omega_reference_target(left), omega_reference_target(right))
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::fixed_array_row(&mut self, kind: i32) -> i32 {
    let row: i32 = kind % 100000;
    transition (kind >= 200000) && (kind < 400000) {
        true -> local_or_retained(row)
        _ -> return -1
    }
    state local_or_retained(row: i32) {
        transition (row < self.parser.type_reference_count) || ((self.construction.active == 1) &&
            (row >= 16384) && (row < 65536)) {
            true -> return row
            _ -> return -1
        }
    }
}

// Rows below 16384 refer to local array syntax. A field declared in another
// unit uses its checked metadata, with no name lookup in the caller.
machine OmegaScalarCompiler::array_element_kind(&mut self, source: &[u8], array: i32) -> i32 {
    transition array >= 16384 {
        true -> return self.construction.arrays[array - 16384].element
        _ -> return self.scalar_type(source, self.parser.type_references[array].payload0)
    }
}

machine OmegaScalarCompiler::array_count(&mut self, source: &[u8], array: i32) -> i32 {
    transition array >= 16384 {
        true -> return self.construction.arrays[array - 16384].count
        _ -> literal(self.parser.type_references[array])
    }
    state literal(row: OmegaTypeReferenceSyntax) {
        self.scan_scalar_literal(source, row.payload1, row.payload2, 32);
        transition (self.literal_status == 1) && (self.literal_value > 0) {
            true -> return self.literal_value
            _ -> return -1
        }
    }
}

// Plain arrays index directly. A Trapping array requires explicit removal.
machine OmegaScalarCompiler::indexable_array_row(&mut self, kind: i32, removed: i32) -> i32 {
    let row: i32 = self.fixed_array_row(kind);
    transition (row >= 0) && (kind == omega_fixed_array_type(row, removed)) {
        true -> return row
        _ -> return -1
    }
}

machine OmegaScalarCompiler::scalar_type(
    &mut self, source: &[u8], type_index: i32
) -> i32 {
    let primitive: i32 = self.primitive_type(source, type_index);
    transition primitive > 0 {
        true -> return primitive
        _ -> compound(self.parser.type_references[type_index])
    }
    state compound(row: OmegaTypeReferenceSyntax) {
        transition row.kind {
            OmegaTypeReferenceKind::Named -> record(row)
            OmegaTypeReferenceKind::Unit -> return 2
            OmegaTypeReferenceKind::Reference -> reference(row)
            OmegaTypeReferenceKind::FixedArray -> return omega_fixed_array_type(type_index, 0)
            OmegaTypeReferenceKind::Constrained -> qualified(row)
            _ -> return 0
        }
    }
    state record(row: OmegaTypeReferenceSyntax) {
        let index: i32 = self.resolve_data(source, row.payload0, row.payload1);
        transition index >= 0 {
            true -> return 100000 + index
            _ -> return 0
        }
    }
    state reference(row: OmegaTypeReferenceSyntax) {
        transition (row.payload2 == 0) && (row.payload1 < 2) {
            true -> referent(row, self.parser.type_references[row.payload0])
            _ -> return 0
        }
    }
    state referent(row: OmegaTypeReferenceSyntax, target: OmegaTypeReferenceSyntax) {
        transition target.kind {
            OmegaTypeReferenceKind::Named -> reference_name(row, target)
            OmegaTypeReferenceKind::FixedArray -> array_reference(row, target)
            OmegaTypeReferenceKind::Slice -> slice(row, target)
            _ -> return 0
        }
    }
    state array_reference(row: OmegaTypeReferenceSyntax, target: OmegaTypeReferenceSyntax) {
        let element: i32 = self.primitive_type(source, target.payload0);
        transition (element > 0) && (element != 2) && (self.array_count(source, row.payload0) > 0) {
            true -> return omega_array_reference(row.payload0, row.payload1)
            _ -> return 0
        }
    }
    state slice(row: OmegaTypeReferenceSyntax, target: OmegaTypeReferenceSyntax) {
        transition (row.payload1 == 0) && (self.primitive_type(source, target.payload0) == 8) {
            true -> return omega_shared_byte_slice()
            _ -> return 0
        }
    }
    state reference_name(row: OmegaTypeReferenceSyntax, target: OmegaTypeReferenceSyntax) {
        let index: i32 = self.resolve_data(source, target.payload0, target.payload1);
        transition index >= 0 {
            true -> return 400000 + row.payload1 * 100000 + index
            _ -> return 0
        }
    }
    state qualified(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload1, row.payload2, "Trapping") {
            1 -> array_base(row)
            _ -> return 0
        }
    }
    state array_base(row: OmegaTypeReferenceSyntax) {
        transition self.parser.type_references[row.payload0].kind {
            OmegaTypeReferenceKind::FixedArray -> return omega_fixed_array_type(row.payload0, 1)
            _ -> return 0
        }
    }
}

// A scalar cell holds a word. Inside a fixed array, u8 takes one byte.
// Round the complete array up to a word so copies and zeroing can operate
// on whole words without crossing into the next field or cell.
machine OmegaScalarCompiler::array_element_stride(&mut self, source: &[u8], kind: i32) -> i32 {
    transition kind {
        8 -> return 1
        _ -> return self.type_size(source, kind)
    }
}

// A field may contain a record declared later, including as an array's
// element. Form that record before reading the field's size. Array headers
// for fields retain their declaring types across source-unit changes.
machine OmegaScalarCompiler::field_type_size(&mut self, source: &[u8], kind: i32) -> i32 {
    transition true { true -> visit(kind, self.layout_depth) }
    state visit(element: i32, depth: i32) {
        transition depth < 64 {
            true -> inspect(element, depth + 1)
            _ -> return 0
        }
    }
    state inspect(element: i32, depth: i32) {
        transition (element >= 100000) && (element - 100000 < self.parser.data_count) {
            true -> form(element - 100000, depth, self.layout_depth)
            _ -> array(self.fixed_array_row(element), depth)
        }
    }
    state array(row: i32, depth: i32) {
        transition row >= 0 {
            true -> child(self.array_element_kind(source, row), self.array_count(source, row), depth)
            _ -> return self.type_size(source, kind)
        }
    }
    state child(element: i32, count: i32, depth: i32) {
        transition (count > 0) && (element != 8) {
            true -> visit(element, depth)
            _ -> return self.type_size(source, kind)
        }
    }
    state form(index: i32, depth: i32, outer_depth: i32) {
        self.layout_depth = depth;
        let ready: i32 = self.layout_data(source, index);
        self.layout_depth = outer_depth;
        transition ready {
            1 -> return self.type_size(source, kind)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::type_size_inner(&mut self, source: &[u8], kind: i32) -> i32 {
    transition kind {
        1 -> return 8
        2 -> return 8
        8 -> return 8
        32 -> return 8
        33 -> return 8
        64 -> return 8
        288 -> return 8
        320 -> return 8
        576 -> return 8
        _ -> compound()
    }
    state compound() {
        transition (kind >= 100000) && (kind < 104096) {
            true -> record(kind - 100000)
            _ -> array()
        }
    }
    state record(index: i32) {
        transition (index < self.parser.data_count) && (self.data_colors[index] == 2) {
            true -> return self.data_sizes[index]
            _ -> return 0
        }
    }
    state array() {
        let row: i32 = self.fixed_array_row(kind);
        transition row >= 0 {
            true -> element(self.array_element_kind(source, row), self.array_count(source, row))
            _ -> reference()
        }
    }
    state reference() {
        transition kind == omega_shared_byte_slice() {
            true -> return 16
            _ -> record_reference()
        }
    }
    state record_reference() {
        transition ((kind >= 400000) && (kind < 404096)) ||
            ((kind >= 500000) && (kind < 504096)) || (omega_array_reference_row(kind) >= 0) {
            true -> return 8
            _ -> return 0
        }
    }
    state element(element_kind: i32, count: i32) {
        transition (count > 0) && (element_kind > 0) && (element_kind < 400000) && (element_kind != 2) {
            true -> extent(count, self.array_element_stride(source, element_kind))
            _ -> return 0
        }
    }
    state extent(count: i32, stride: i32) {
        transition stride > 0 {
            true -> bounded(count, stride)
            _ -> return 0
        }
    }
    state bounded(count: i32, stride: i32) {
        transition (count > 0) && (count <= omega_storage_capacity() / stride) {
            true -> return ((count * stride + 7) / 8) * 8
            _ -> return 0
        }
    }
}

// Only completed layout evidence identifies an uninhabited type. The name
// (including the spelling Never) and an unresolved or failed layout cannot.
machine OmegaScalarCompiler::uninhabited_type(&mut self, kind: i32) -> i32 {
    transition (kind >= 100000) && (kind - 100000 < self.parser.data_count) {
        true -> record(kind - 100000)
        _ -> return 0
    }
    state record(index: i32) {
        return (self.data_colors[index] == 2) && (self.data_sizes[index] == 0);
    }
}

machine OmegaScalarCompiler::type_copy(&mut self, source: &[u8], kind: i32) -> i32 {
    transition kind {
        1 -> return 1
        2 -> return 1
        8 -> return 1
        32 -> return 1
        33 -> return 1
        64 -> return 1
        288 -> return 1
        320 -> return 1
        576 -> return 1
        _ -> compound()
    }
    state compound() {
        transition (kind >= 100000) && (kind < 104096) {
            true -> return self.data_copy[kind - 100000]
            _ -> array()
        }
    }
    state array() {
        let row: i32 = self.fixed_array_row(kind);
        transition row >= 0 {
            true -> return self.type_copy(source, self.array_element_kind(source, row))
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::resolve_field(
    &mut self, source: &[u8], owner: i32, start: i32, end: i32
) -> i32 {
    transition true { true -> next(0) }
    state next(offset: i32) {
        transition offset < self.parser.data_items[owner].field_count {
            true -> name(offset, self.parser.data_items[owner].first_field + offset)
            _ -> return -1
        }
    }
    state name(offset: i32, slot: i32) {
        let name: OmegaRelativeSpan = self.parser.data_fields[slot].name;
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return slot
            _ -> next(offset + 1)
        }
    }
}

// Case payloads have their own parser ledger. A layout slot can be used for
// both construction and matching, while field names remain local to their case.
machine OmegaScalarCompiler::resolve_payload_field(
    &mut self, source: &[u8], case_slot: i32, start: i32, end: i32
) -> i32 {
    let row: OmegaDataCaseSyntax = self.parser.data_cases[case_slot];
    transition true { true -> next(row.first_payload_field, row.first_payload_field + row.payload_field_count) }
    state next(slot: i32, limit: i32) {
        transition slot < limit {
            true -> compare(slot, limit, self.parser.data_payload_fields[slot].name)
            _ -> return -1
        }
    }
    state compare(slot: i32, limit: i32, name: OmegaRelativeSpan) {
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return 16384 + slot
            _ -> next(slot + 1, limit)
        }
    }
}

// A bounded hash-chain census serves both duplicate checking and lookup.
// Collision checks retain full spelling and declaration scope; hashes never
// establish identity. Bucket arithmetic is at most 34014 before reduction.
machine OmegaScalarCompiler::case_name_bucket(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    transition true { true -> byte(start, 0) }
    state byte(cursor: i32, hash: i32) {
        transition cursor < end {
            true -> byte(cursor + 1, (hash * 33 + source[cursor]) % 1024)
            _ -> return hash
        }
    }
}

machine OmegaScalarCompiler::resolve_case(&mut self, source: &[u8], declaration: i32, start: i32, end: i32) -> i32 {
    let bucket: i32 = self.case_name_bucket(source, start, end);
    transition true { true -> link(self.case_name_heads[bucket]) }
    state link(value: i32) {
        transition value > 0 {
            true -> scope(value - 1)
            _ -> return -1
        }
    }
    state scope(slot: i32) {
        let owner: OmegaDataSyntax = self.parser.data_items[declaration];
        transition (slot >= owner.first_case) && (slot < owner.first_case + owner.case_count) {
            true -> name(slot, self.parser.data_cases[slot].name)
            _ -> link(self.case_name_next[slot])
        }
    }
    state name(slot: i32, name: OmegaRelativeSpan) {
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return slot
            _ -> link(self.case_name_next[slot])
        }
    }
}

// A case-valued path names its carrier and member. Its payload arity is
// checked at the point of construction.
// Expected type never supplies a missing owner or changes nominal identity.
machine OmegaScalarCompiler::case_value_type(&mut self, source: &[u8], row: OmegaExpressionSyntax) -> i32 {
    transition (row.payload1 == 2) && (row.payload2 == 0) && (row.payload3 == 2) {
        true -> return self.qualified_case_type(source, row.payload0, row.payload1)
        _ -> return -1
    }
}

machine OmegaScalarCompiler::qualified_case_type(&mut self, source: &[u8], first: i32, count: i32) -> i32 {
    let declaration: i32 = self.resolve_data(source, self.parser.members[first].start,
        self.parser.members[first + count - 2].end);
    transition declaration >= 0 {
        true -> sum(declaration)
        _ -> return -1
    }
    state sum(declaration: i32) {
        transition self.parser.data_items[declaration].case_count > 0 {
            true -> member(declaration, self.parser.members[first + count - 1])
            _ -> return -1
        }
    }
    state member(declaration: i32, name: OmegaRelativeSpan) {
        transition self.resolve_case(source, declaration, name.start, name.end) >= 0 {
            true -> return 100000 + declaration
            _ -> missing(name.start)
        }
    }
    state missing(coordinate: i32) { self.record_reject(-1, 4, coordinate); return -1; }
}

machine OmegaScalarCompiler::check_case_value(&mut self, source: &[u8], expression: i32, expected: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    let kind: i32 = self.case_value_type(source, row);
    transition kind > 0 {
        true -> identity(row, kind)
        _ -> unsupported()
    }
    state identity(row: OmegaExpressionSyntax, kind: i32) {
        transition kind == expected {
            true -> member(kind - 100000, self.parser.members[row.payload0 + 1])
            _ -> rejected()
        }
    }
    state member(declaration: i32, name: OmegaRelativeSpan) {
        let slot: i32 = self.resolve_case(source, declaration, name.start, name.end);
        transition self.parser.data_cases[slot].payload_field_count == 0 {
            true -> retain(declaration, slot)
            _ -> rejected()
        }
    }
    state retain(declaration: i32, slot: i32) {
        self.value_kinds[expression] = OmegaCheckedValueKind::NullaryCase;
        self.value_payloads[expression] = slot - self.parser.data_items[declaration].first_case;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

// Both bare cases and case literals begin with their checked ordinal. A literal
// then establishes its active fields in authored order before returning the value.
machine OmegaScalarCompiler::emit_case_value(&mut self, expression: i32) -> i32 {
    let address: i32 = omega_storage_base() + self.cell_offsets[49152 + expression];
    transition (self.tape.emit_imm(0, self.value_payloads[expression], 0) == 1) &&
        (self.tape.emit_imm(1, address, 0) == 1) &&
        (self.tape.emit_rr(11, 1, 0) == 1) &&
        (self.tape.emit_imm(0, address, 0) == 1) {
        true -> return 1
        _ -> return 0
    }
}

// Each case starts at byte eight, following the tag. The sum occupies the
// maximum case extent, so independent value copies retain their active payload.
machine OmegaScalarCompiler::layout_case_payload(&mut self, source: &[u8], case_slot: i32) -> i32 {
    let row: OmegaDataCaseSyntax = self.parser.data_cases[case_slot];
    transition true { true -> field(row.first_payload_field, row.first_payload_field + row.payload_field_count, 8) }
    state field(slot: i32, limit: i32, size: i32) {
        transition slot < limit {
            true -> name(slot, limit, size, self.parser.data_payload_fields[slot])
            _ -> return size
        }
    }
    state name(slot: i32, limit: i32, size: i32, item: OmegaDataFieldSyntax) {
        transition self.resolve_payload_field(source, case_slot, item.name.start, item.name.end) == 16384 + slot {
            true -> payload_type(slot, limit, size, item.type_reference)
            _ -> duplicate(item.name.start)
        }
    }
    state payload_type(slot: i32, limit: i32, size: i32, type_index: i32) {
        transition self.construction.active {
            1 -> kind(slot, limit, size, self.field_types[16384 + slot])
            _ -> kind(slot, limit, size, self.scalar_type(source, type_index))
        }
    }
    state kind(slot: i32, limit: i32, size: i32, kind: i32) {
        transition (kind > 0) && (kind != 2) && (kind < 400000) {
            true -> extent(slot, limit, size, kind, self.field_type_size(source, kind))
            _ -> unsupported(slot)
        }
    }
    state extent(slot: i32, limit: i32, size: i32, kind: i32, extent: i32) {
        transition (extent > 0) && (extent <= omega_storage_capacity() - size) && (self.type_copy(source, kind) == 1) {
            true -> retain(slot, limit, size, kind, extent)
            _ -> unsupported(slot)
        }
    }
    state retain(slot: i32, limit: i32, size: i32, kind: i32, extent: i32) {
        self.field_types[16384 + slot] = kind;
        self.field_offsets[16384 + slot] = size;
        self.field_extents[16384 + slot] = extent;
        self.field_upper_bounds[16384 + slot] = -1;
        transition true { true -> field(slot + 1, limit, size + extent) }
    }
    state duplicate(coordinate: i32) { self.record_reject(10, 4, coordinate); return 0; }
    state unsupported(slot: i32) { self.record_incomplete(4, self.parser.data_payload_fields[slot].start); return 0; }
}

// Intrinsic sum equality is a declaration-wide property, not a property of
// the currently active case or the size of its default representation.
machine OmegaScalarCompiler::payload_free_sum(&mut self, index: i32) -> i32 {
    transition (index >= 0) && (index < self.parser.data_count) {
        true -> shape(self.parser.data_items[index])
        _ -> return 0
    }
    state shape(row: OmegaDataSyntax) {
        transition (row.case_count > 0) && (row.field_count == 0) {
            true -> item(row.first_case, row.case_count, 0)
            _ -> return 0
        }
    }
    state item(first: i32, count: i32, offset: i32) {
        transition offset < count {
            true -> payload(first, count, offset)
            _ -> return 1
        }
    }
    state payload(first: i32, count: i32, offset: i32) {
        transition self.parser.data_cases[first + offset].payload_field_count == 0 {
            true -> item(first, count, offset + 1)
            _ -> return 0
        }
    }
}

// A bounded layout DFS rejects by-value cycles and unsupported contained
// authority before any storage is allocated or emitted. Each admitted default
// predicate is also proved for zero, so zero storage establishes these values.
machine OmegaScalarCompiler::layout_data(&mut self, source: &[u8], index: i32) -> i32 {
    transition self.data_colors[index] {
        2 -> return 1
        1 -> unsupported()
        _ -> shape()
    }
    state shape() {
        let row: OmegaDataSyntax = self.parser.data_items[index];
        transition row.case_count > 0 {
            true -> sum_shape()
            _ -> record_shape(row)
        }
    }
    state record_shape(row: OmegaDataSyntax) {
        transition self.empty_record(row) {
            1 -> uninhabited()
            _ -> record_depth()
        }
    }
    state uninhabited() {
        self.data_sizes[index] = 0;
        self.data_copy[index] = 0;
        self.data_colors[index] = 2;
        return 1;
    }
    state record_depth() {
        transition self.layout_depth < 64 {
            true -> begin()
            _ -> unsupported()
        }
    }
    state sum_shape() {
        // Ratified Omega data is a record or a sum; mixed bodies are invalid.
        transition self.parser.data_items[index].field_count == 0 {
            true -> sum_begin()
            _ -> invalid_sum()
        }
    }
    state invalid_sum() {
        self.record_reject(-1, 4, self.parser.data_items[index].start);
        return 0;
    }
    state sum_begin() {
        self.data_colors[index] = 1;
        self.data_copy[index] = 0;
        self.data_sizes[index] = 8;
        transition true { true -> sum_case(0) }
    }
    state sum_case(offset: i32) {
        transition offset < self.parser.data_items[index].case_count {
            true -> sum_payload(offset, self.parser.data_items[index].first_case + offset)
            _ -> sum_finish()
        }
    }
    state sum_payload(offset: i32, slot: i32) {
        let size: i32 = self.layout_case_payload(source, slot);
        transition size > 0 {
            true -> sum_size(offset, slot, size)
            _ -> return 0
        }
    }
    state sum_size(offset: i32, slot: i32, size: i32) {
        transition size > self.data_sizes[index] {
            true -> sum_grow(offset, slot, size)
            _ -> sum_name(offset, slot, self.parser.data_cases[slot].name)
        }
    }
    state sum_grow(offset: i32, slot: i32, size: i32) {
        self.data_sizes[index] = size;
        transition true { true -> sum_name(offset, slot, self.parser.data_cases[slot].name) }
    }
    state sum_name(offset: i32, slot: i32, name: OmegaRelativeSpan) {
        transition self.resolve_case(source, index, name.start, name.end) < 0 {
            true -> sum_retain(offset, slot, self.case_name_bucket(source, name.start, name.end))
            _ -> duplicate(name.start)
        }
    }
    state sum_retain(offset: i32, slot: i32, bucket: i32) {
        self.case_name_next[slot] = self.case_name_heads[bucket];
        self.case_name_heads[bucket] = slot + 1;
        self.case_name_buckets[self.case_name_count] = bucket;
        self.case_name_count = self.case_name_count + 1;
        transition true { true -> sum_case(offset + 1) }
    }
    state sum_finish() {
        // Zero names the first declared case. Nominal identity remains the
        // declaration ID; this private word never becomes a source integer.
        transition self.check_case_requirement(source, index) {
            1 -> sum_multiplicity()
            _ -> unsupported()
        }
    }
    state sum_multiplicity() {
        transition self.parser.data_items[index].multiplicity {
            OmegaDataMultiplicity::Unrestricted -> complete_sum(1)
            OmegaDataMultiplicity::Affine -> complete_sum(0)
            _ -> unsupported()
        }
    }
    state complete_sum(copyable: i32) {
        self.data_copy[index] = copyable;
        self.data_colors[index] = 2;
        return 1;
    }
    state begin() {
        self.data_colors[index] = 1;
        self.data_copy[index] = 0;
        self.layout_depth = self.layout_depth + 1;
        transition true { true -> field(0, 0) }
    }
    state field(offset: i32, size: i32) {
        transition offset < self.parser.data_items[index].field_count {
            true -> field_type(offset, size, self.parser.data_items[index].first_field + offset)
            _ -> field_bounds(size)
        }
    }
    // Laying out a nested record can load another file. A requirement's
    // expression index belongs to this record's file even when the nested
    // record has a field with the same name.
    state field_bounds(size: i32) {
        transition self.parser.data_items[index].requirement_count > 0 {
            true -> load_bounds(size)
            _ -> finish(size)
        }
    }
    state load_bounds(size: i32) {
        transition self.select_construction_unit(source, self.construction.types[index].unit) {
            1 -> requirements(0, size)
            _ -> return 0
        }
    }
    state field_type(offset: i32, size: i32, slot: i32) {
        transition self.construction.active {
            1 -> field_kind(offset, size, slot, self.field_types[slot])
            _ -> field_kind(offset, size, slot, self.scalar_type(source, self.parser.data_fields[slot].type_reference))
        }
    }
    state field_kind(offset: i32, size: i32, slot: i32, kind: i32) {
        self.field_types[slot] = kind;
        self.field_offsets[slot] = size;
        self.field_upper_bounds[slot] = -1;
        transition (kind > 0) && (kind != 2) && (kind < 400000) {
            true -> field_size(offset, size, slot, self.field_type_size(source, kind))
            _ -> unsupported()
        }
    }
    state field_size(offset: i32, size: i32, slot: i32, extent: i32) {
        transition (extent > 0) && (extent <= omega_storage_capacity() - size) {
            true -> field_name(offset, size, slot, extent)
            _ -> unsupported()
        }
    }
    state field_name(offset: i32, size: i32, slot: i32, extent: i32) {
        self.field_extents[slot] = extent;
        let name: OmegaRelativeSpan = self.parser.data_fields[slot].name;
        transition self.resolve_field(source, index, name.start, name.end) == slot {
            true -> multiplicity(offset, size, slot, extent)
            _ -> duplicate(name.start)
        }
    }
    state multiplicity(offset: i32, size: i32, slot: i32, extent: i32) {
        transition self.parser.data_items[index].multiplicity {
            OmegaDataMultiplicity::Unrestricted -> copy_field(offset, size, slot, extent)
            _ -> field(offset + 1, size + extent)
        }
    }
    state copy_field(offset: i32, size: i32, slot: i32, extent: i32) {
        transition self.type_copy(source, self.field_types[slot]) {
            1 -> field(offset + 1, size + extent)
            _ -> unsupported()
        }
    }
    state requirements(offset: i32, size: i32) {
        transition offset < self.parser.data_items[index].requirement_count {
            true -> requirement(offset, size, self.parser.requirements[
                self.parser.data_items[index].first_requirement + offset].expression)
            _ -> finish(size)
        }
    }
    state requirement(offset: i32, size: i32, expression: i32) {
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Binary -> predicate(offset, size,
                self.parser.binary_expressions[self.parser.expressions[expression].payload0])
            _ -> unsupported()
        }
    }
    state predicate(offset: i32, size: i32, row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::LessEqual -> operands(offset, size,
                self.parser.expressions[row.left], self.parser.expressions[row.right])
            _ -> unsupported()
        }
    }
    state operands(offset: i32, size: i32, left: OmegaExpressionSyntax, right: OmegaExpressionSyntax) {
        transition left.kind {
            OmegaExpressionKind::Path -> left_path(offset, size, left, right)
            _ -> unsupported()
        }
    }
    state left_path(offset: i32, size: i32, left: OmegaExpressionSyntax, right: OmegaExpressionSyntax) {
        transition (left.payload1 == 1) && (left.payload2 == 0) {
            true -> field_bound(offset, size, self.parser.members[left.payload0], right)
            _ -> unsupported()
        }
    }
    state field_bound(offset: i32, size: i32, name: OmegaRelativeSpan, right: OmegaExpressionSyntax) {
        let field: i32 = self.resolve_field(source, index, name.start, name.end);
        transition field >= 0 {
            true -> bound_type(offset, size, field, right)
            _ -> unsupported()
        }
    }
    state bound_type(offset: i32, size: i32, field: i32, right: OmegaExpressionSyntax) {
        let kind: i32 = self.field_types[field];
        transition (kind == 8) || (kind == 32) || (kind == 64) {
            true -> bound_literal(offset, size, field, right)
            _ -> unsupported()
        }
    }
    state bound_literal(offset: i32, size: i32, field: i32, right: OmegaExpressionSyntax) {
        transition right.kind {
            OmegaExpressionKind::Integer -> scan_bound(offset, size, field, right)
            _ -> unsupported()
        }
    }
    state scan_bound(offset: i32, size: i32, field: i32, right: OmegaExpressionSyntax) {
        self.scan_integer(source, right, self.field_types[field]);
        transition (self.literal_status == 1) && (self.literal_value >= 0) {
            true -> retain_bound(offset, size, field, self.literal_value)
            _ -> unsupported()
        }
    }
    state retain_bound(offset: i32, size: i32, field: i32, bound: i32) {
        transition (self.field_upper_bounds[field] < 0) || (bound < self.field_upper_bounds[field]) {
            true -> replace_bound(offset, size, field, bound)
            _ -> requirements(offset + 1, size)
        }
    }
    state replace_bound(offset: i32, size: i32, field: i32, bound: i32) {
        self.field_upper_bounds[field] = bound;
        transition true { true -> requirements(offset + 1, size) }
    }
    state finish(size: i32) {
        transition size > 0 {
            true -> sized(size)
            _ -> sized(8)
        }
    }
    state sized(size: i32) {
        self.data_sizes[index] = size;
        self.data_colors[index] = 2;
        self.layout_depth = self.layout_depth - 1;
        transition self.parser.data_items[index].multiplicity {
            OmegaDataMultiplicity::Unrestricted -> copy()
            _ -> return 1
        }
    }
    state copy() { self.data_copy[index] = 1; return 1; }
    state unsupported() { self.record_incomplete(4, self.parser.data_items[index].start); return 0; }
    state duplicate(coordinate: i32) { self.record_reject(10, 4, coordinate); return 0; }
}

machine OmegaScalarCompiler::require_cell(
    &mut self, source: &[u8], cell: i32, kind: i32
) -> i32 {
    transition self.cell_sizes[cell] > 0 {
        true -> return 1
        _ -> extent(self.type_size(source, kind))
    }
    state extent(size: i32) {
        transition (size > 0) && (size <= omega_storage_capacity() - self.storage_size) {
            true -> retain(size)
            _ -> unsupported()
        }
    }
    state retain(size: i32) {
        self.cell_ids[self.cell_count] = cell;
        self.cell_count = self.cell_count + 1;
        self.cell_types[cell] = kind;
        self.cell_sizes[cell] = size;
        self.cell_offsets[cell] = self.storage_size;
        self.storage_size = self.storage_size + size;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// An arm-local name selects a field of the saved subject. Waivers have an
// empty binding span, so only Bind entries participate in name resolution.
machine OmegaScalarCompiler::pattern_binding(&mut self, source: &[u8], name: OmegaRelativeSpan) -> i32 {
    transition self.pattern_scope > 0 {
        true -> field(self.parser.transition_statements[self.pattern_scope - 1], 0)
        _ -> return -1
    }
    state field(row: OmegaTransitionStatementSyntax, offset: i32) {
        transition offset < row.guard_pattern_field_count {
            true -> action(row, offset, row.guard_first_pattern_field + offset)
            _ -> return -1
        }
    }
    state action(row: OmegaTransitionStatementSyntax, offset: i32, index: i32) {
        let item: OmegaTransitionPatternFieldSyntax = self.parser.transition_pattern_fields[index];
        transition item.kind {
            OmegaTransitionPatternFieldKind::Bind -> compare(row, offset, index, item.binding)
            _ -> field(row, offset + 1)
        }
    }
    state compare(row: OmegaTransitionStatementSyntax, offset: i32, index: i32, binding: OmegaRelativeSpan) {
        transition self.parser.sources.equal_name(source, name, binding) {
            1 -> return self.pattern_field_slots[index]
            _ -> field(row, offset + 1)
        }
    }
}

// Resolve a structural place without reading it. The root identifies one
// binding; each projection retains its declared field and offset. This never
// manufactures an address from source integers or erases a field qualification.
machine OmegaScalarCompiler::check_place(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::Unary -> unary(self.parser.unary_expressions[row.payload0])
        OmegaExpressionKind::Path -> path(row)
        OmegaExpressionKind::Indexed -> return self.check_index(source, state_index, before, expression, 1)
        _ -> unsupported()
    }
    state unary(row: OmegaUnaryExpressionSyntax) {
        transition row.operator {
            OmegaUnaryOperatorKind::Dereference -> dereference(self.parser.expressions[row.operand])
            _ -> unsupported()
        }
    }
    // Only a named reference cell is available in this subset. Following it
    // selects the whole record and uses the same access as field selection.
    state dereference(operand: OmegaExpressionSyntax) {
        transition operand.kind {
            OmegaExpressionKind::Path -> reference_name(operand)
            _ -> unsupported()
        }
    }
    state reference_name(operand: OmegaExpressionSyntax) {
        transition (operand.payload1 == 1) && (operand.payload2 == 0) && (operand.payload3 == 1) {
            true -> reference_binding(operand, self.parser.members[operand.payload0])
            _ -> unsupported()
        }
    }
    state reference_binding(operand: OmegaExpressionSyntax, name: OmegaRelativeSpan) {
        transition self.pattern_binding(source, name) >= 0 {
            true -> unsupported()
            _ -> ordinary(operand, name)
        }
    }
    state path(row: OmegaExpressionSyntax) {
        transition (row.payload1 > 0) && (row.payload2 == 0) && (row.payload3 <= 1) {
            true -> root(row, self.parser.members[row.payload0])
            _ -> unsupported()
        }
    }
    state root(row: OmegaExpressionSyntax, name: OmegaRelativeSpan) {
        let field: i32 = self.pattern_binding(source, name);
        transition field >= 0 {
            true -> payload(row, field)
            _ -> ordinary(row, name)
        }
    }
    state payload(row: OmegaExpressionSyntax, field: i32) {
        let subject: i32 = self.parser.transition_statements[self.pattern_scope - 1].subject;
        self.place_roots[expression] = 49152 + subject;
        self.place_offsets[expression] = self.field_offsets[field];
        self.place_fields[expression] = field;
        self.place_indirect[expression] = 0;
        self.place_writable[expression] = 0;
        transition true { true -> members(row, 1, self.field_types[field]) }
    }
    state ordinary(row: OmegaExpressionSyntax, name: OmegaRelativeSpan) {
        let cell: i32 = self.value_cell(source, state_index, before, name.start, name.end);
        transition cell >= 0 {
            true -> binding(row, cell)
            _ -> missing(name.start)
        }
    }
    state binding(row: OmegaExpressionSyntax, cell: i32) {
        self.place_roots[expression] = cell;
        self.place_offsets[expression] = 0;
        self.place_indirect[expression] = 0;
        self.place_writable[expression] = 0;
        self.place_fields[expression] = -1;
        transition cell < 16384 {
            true -> type(row, self.parameter_types[cell])
            _ -> local(row, self.parser.local_data_statements[cell - 16384])
        }
    }
    state local(row: OmegaExpressionSyntax, local: OmegaLocalDataStatementSyntax) {
        self.place_writable[expression] = local.is_mutable;
        transition true { true -> type(row, self.scalar_type(source, local.type_reference)) }
    }
    state type(row: OmegaExpressionSyntax, kind: i32) {
        transition (kind >= 400000) && (kind < 404096) {
            true -> referent(row, kind - 400000, 0)
            _ -> mutable_reference(row, kind)
        }
    }
    state mutable_reference(row: OmegaExpressionSyntax, kind: i32) {
        transition kind == omega_shared_byte_slice() {
            true -> slice(row)
            _ -> record_reference(row, kind)
        }
    }
    state slice(row: OmegaExpressionSyntax) {
        transition row.payload1 == 2 {
            true -> metadata(self.parser.members[row.payload0 + 1])
            _ -> unsupported()
        }
    }
    state metadata(name: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, "length") {
            1 -> length()
            _ -> unsupported()
        }
    }
    state length() {
        self.place_offsets[expression] = 8;
        self.place_writable[expression] = 0;
        transition true { true -> retain(64) }
    }
    state record_reference(row: OmegaExpressionSyntax, kind: i32) {
        transition (kind >= 500000) && (kind < 504096) {
            true -> referent(row, kind - 500000, 1)
            _ -> owned(row, kind)
        }
    }
    state owned(row: OmegaExpressionSyntax, kind: i32) {
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Unary -> invalid_reference(kind, self.parser.members[row.payload0].start)
            _ -> members(row, 1, kind)
        }
    }
    state invalid_reference(kind: i32, coordinate: i32) {
        transition (kind > 0) && (kind < 400000) {
            true -> missing(coordinate)
            _ -> unsupported()
        }
    }
    state referent(row: OmegaExpressionSyntax, declaration: i32, writable: i32) {
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Unary -> referenced_fields(row, declaration, writable)
            _ -> implicit_reference(row, declaration, writable)
        }
    }
    state implicit_reference(row: OmegaExpressionSyntax, declaration: i32, writable: i32) {
        transition row.payload1 > 1 {
            true -> referenced_fields(row, declaration, writable)
            _ -> unsupported()
        }
    }
    state referenced_fields(row: OmegaExpressionSyntax, declaration: i32, writable: i32) {
        self.place_indirect[expression] = 1;
        self.place_writable[expression] = writable;
        transition true { true -> members(row, 1, 100000 + declaration) }
    }
    state members(row: OmegaExpressionSyntax, offset: i32, kind: i32) {
        transition offset < row.payload1 {
            true -> record(row, offset, kind)
            _ -> retain(kind)
        }
    }
    state record(row: OmegaExpressionSyntax, offset: i32, kind: i32) {
        transition (kind >= 100000) && (kind < 104096) {
            true -> member(row, offset, kind - 100000, self.parser.members[row.payload0 + offset])
            _ -> unsupported()
        }
    }
    state member(row: OmegaExpressionSyntax, offset: i32, declaration: i32, name: OmegaRelativeSpan) {
        let field: i32 = self.resolve_field(source, declaration, name.start, name.end);
        transition field >= 0 {
            true -> project(row, offset, field)
            _ -> missing(name.start)
        }
    }
    state project(row: OmegaExpressionSyntax, offset: i32, field: i32) {
        self.place_offsets[expression] = self.place_offsets[expression] + self.field_offsets[field];
        self.place_fields[expression] = field;
        transition true { true -> members(row, offset + 1, self.field_types[field]) }
    }
    state retain(kind: i32) {
        self.place_types[expression] = kind;
        self.place_extent[expression] = self.type_size(source, kind);
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state missing(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Shared loans permit overlapping reads. An exclusive loan covers its
// backing range while later arguments are checked, including by-value reads.
machine OmegaScalarCompiler::place_available(
    &mut self, source: &[u8], expression: i32, access: i32
) -> i32 {
    transition true { true -> next(0, self.place_extent[expression]) }
    state next(index: i32, size: i32) {
        transition index < self.loan_count {
            true -> root(index, size)
            _ -> return 1
        }
    }
    state root(index: i32, size: i32) {
        transition (self.loan_roots[index] == self.place_roots[expression]) &&
            ((access == 1) || (self.loan_access[index] == 1)) {
            true -> overlap(index, size)
            _ -> next(index + 1, size)
        }
    }
    state overlap(index: i32, size: i32) {
        transition (self.loan_offsets[index] < self.place_offsets[expression] + size) &&
            (self.place_offsets[expression] < self.loan_offsets[index] + self.loan_sizes[index]) {
            true -> refused(index)
            _ -> next(index + 1, size)
        }
    }
    state refused(index: i32) {
        transition self.loan_context[index] {
            1 -> reborrow_unsupported()
            _ -> rejected()
        }
    }
    state reborrow_unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::check_place_value(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32, expected: i32
) -> i32 {
    transition self.check_place(source, state_index, before, expression) {
        1 -> type()
        _ -> return 0
    }
    state type() {
        transition self.place_types[expression] == expected {
            true -> copy()
            _ -> array_identity()
        }
    }
    // Array layout custody uses the authored type row. Separate spellings can
    // denote the same structural type; decline until their equivalence is
    // checked instead of rejecting valid array-to-array value transport.
    state array_identity() {
        transition (expected >= 200000) && (expected < 400000) &&
            (self.place_types[expression] >= 200000) && (self.place_types[expression] < 400000) {
            true -> unsupported()
            _ -> implicit_shared()
        }
    }
    // Ordinary call admission may lend an owned record implicitly to a
    // shared parameter. This explicit-borrow profile declines that valid
    // route; it must not classify it as a mismatched Omega value.
    state implicit_shared() {
        transition (expected >= 400000) && (expected < 404096) &&
            (self.place_types[expression] == expected - 300000) {
            true -> unsupported()
            _ -> rejected()
        }
    }
    state copy() {
        transition self.type_copy(source, expected) {
            1 -> available()
            _ -> unsupported()
        }
    }
    state available() {
        transition self.place_available(source, expression, 0) {
            1 -> retain()
            _ -> return 0
        }
    }
    state retain() { self.value_kinds[expression] = OmegaCheckedValueKind::Place; return 1; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::check_borrow(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32, expected: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition (omega_reference_target(expected) > 0) && (row.payload1 == expected / 100000 - 4) {
        true -> place(row)
        _ -> unsupported(row)
    }
    state place(row: OmegaExpressionSyntax) {
        transition self.check_place(source, state_index, before, row.payload0) {
            1 -> type(row)
            _ -> return 0
        }
    }
    state type(row: OmegaExpressionSyntax) {
        transition self.matches_array_or_value(source, self.place_types[row.payload0], omega_reference_target(expected)) {
            true -> access(row)
            _ -> rejected(row)
        }
    }
    state access(row: OmegaExpressionSyntax) {
        transition (row.payload1 == 0) || (self.place_writable[row.payload0] == 1) {
            true -> available(row)
            _ -> rejected(row)
        }
    }
    state available(row: OmegaExpressionSyntax) {
        transition self.place_available(source, row.payload0, row.payload1) {
            1 -> loan(row)
            _ -> return 0
        }
    }
    state loan(row: OmegaExpressionSyntax) {
        transition self.loan_count < 16384 {
            true -> retain(row)
            _ -> unsupported(row)
        }
    }
    state retain(row: OmegaExpressionSyntax) {
        self.loan_access[self.loan_count] = row.payload1;
        self.loan_context[self.loan_count] = 0;
        self.loan_roots[self.loan_count] = self.place_roots[row.payload0];
        self.loan_offsets[self.loan_count] = self.place_offsets[row.payload0];
        self.loan_sizes[self.loan_count] = self.type_size(source, self.place_types[row.payload0]);
        self.loan_count = self.loan_count + 1;
        self.value_kinds[expression] = OmegaCheckedValueKind::Borrow;
        self.value_payloads[expression] = row.payload0;
        return 1;
    }
    state rejected(row: OmegaExpressionSyntax) { self.record_reject(-1, 4, row.payload2); return 0; }
    state unsupported(row: OmegaExpressionSyntax) { self.record_incomplete(4, row.payload2); return 0; }
}

// The first predicate solver discharges only a literal upper bound or a read
// of a field with an equal/stronger declared bound. No mutable flow snapshot is
// retained across a call; all admitted writes preserve these declared facts.
machine OmegaScalarCompiler::check_field_bound(
    &mut self, source: &[u8], field: i32, expression: i32
) -> i32 {
    transition self.field_upper_bounds[field] < 0 {
        true -> return 1
        _ -> prove()
    }
    state prove() {
        transition self.prove_ceiling(source, self.value_states[expression], self.value_befores[expression],
            expression, self.field_upper_bounds[field]) {
            1 -> return 1
            _ -> failed(self.parser.expressions[expression])
        }
    }
    state failed(row: OmegaExpressionSyntax) {
        transition (field >= 16384) && (self.field_types[field] == 33) {
            true -> signed_literal(row)
            _ -> unsupported()
        }
    }
    state signed_literal(row: OmegaExpressionSyntax) {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::NegativeI32Literal -> rejected(self.parser.unary_expressions[row.payload0].operator_start)
            OmegaCheckedValueKind::Literal -> positive_literal(row)
            _ -> unsupported()
        }
    }
    state positive_literal(row: OmegaExpressionSyntax) {
        transition row.kind {
            OmegaExpressionKind::Integer -> rejected(row.payload0)
            _ -> unsupported()
        }
    }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// An expected array supplies each element's exact type and the required count.
// Domain qualification on the element still requires an authored cast.
machine OmegaScalarCompiler::check_array_literal(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    expression: i32, expected: i32
) -> i32 {
    let literal: OmegaExpressionSyntax = self.parser.expressions[expression];
    let array: i32 = self.fixed_array_row(expected);
    transition (array >= 0) && (expected == omega_fixed_array_type(array, 0)) {
        true -> count(literal, array)
        _ -> rejected(literal.payload2)
    }
    state count(literal: OmegaExpressionSyntax, array: i32) {
        transition self.array_count(source, array) == literal.payload1 {
            true -> layout(literal, self.array_element_kind(source, array))
            _ -> rejected(literal.payload2)
        }
    }
    state layout(literal: OmegaExpressionSyntax, element: i32) {
        self.value_payloads[expression] = element;
        self.index_plans[expression].stride = self.array_element_stride(source, element);
        transition (self.index_plans[expression].stride > 0) && (self.type_copy(source, element) == 1) {
            true -> values(literal, element, 0)
            _ -> unsupported(literal.payload2)
        }
    }
    state values(literal: OmegaExpressionSyntax, element: i32, index: i32) {
        transition index < literal.payload1 {
            true -> value(literal, element, index)
            _ -> complete()
        }
    }
    state value(literal: OmegaExpressionSyntax, element: i32, index: i32) {
        transition self.check_value(source, owner, state_index, before,
            self.parser.call_arguments[literal.payload0 + index], element) {
            1 -> values(literal, element, index + 1)
            _ -> return 0
        }
    }
    state complete() { self.value_kinds[expression] = OmegaCheckedValueKind::ArrayLiteral; return 1; }
    state rejected(at: i32) { self.record_reject(-1, 4, at); return 0; }
    state unsupported(at: i32) { self.record_incomplete(4, at); return 0; }
}

machine OmegaScalarCompiler::emit_array_literal(&mut self, expression: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    let home: i32 = omega_storage_base() + self.cell_offsets[49152 + expression];
    transition true { true -> elements(row, home, self.index_plans[expression].stride, 0) }
    state elements(row: OmegaExpressionSyntax, home: i32, stride: i32, index: i32) {
        transition index < row.payload1 {
            true -> value(row, home, stride, index)
            _ -> return self.tape.emit_imm(0, home, 0)
        }
    }
    state value(row: OmegaExpressionSyntax, home: i32, stride: i32, index: i32) {
        transition (self.emit_value(self.parser.call_arguments[row.payload0 + index]) == 1) &&
            (self.tape.emit_imm(1, home + index * stride, 0) == 1) &&
            (self.emit_store_at(self.value_payloads[expression], stride) == 1) {
            true -> elements(row, home, stride, index + 1)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::check_record_literal(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32,
    expression: i32, expected: i32
) -> i32 {
    let row: OmegaStructLiteralSyntax = self.parser.struct_literals[self.parser.expressions[expression].payload0];
    transition (expected >= 100000) && (expected < 104096) && (row.type_member_count > 0) &&
        ((self.type_copy(source, expected) == 1) || (self.inhabited_sum(expected) == 1)) {
        true -> record_shape(row)
        _ -> unsupported()
    }
    state record_shape(row: OmegaStructLiteralSyntax) {
        transition self.parser.data_items[expected - 100000].case_count == 0 {
            true -> name(row, self.parser.members[row.first_type_member])
            _ -> case_path(row)
        }
    }
    state case_path(row: OmegaStructLiteralSyntax) {
        transition row.type_member_count > 1 {
            true -> case_owner(row)
            _ -> rejected(row.start)
        }
    }
    state case_owner(row: OmegaStructLiteralSyntax) {
        transition self.resolve_data(source, self.parser.members[row.first_type_member].start,
            self.parser.members[row.first_type_member + row.type_member_count - 2].end) == expected - 100000 {
            true -> case_name(row, self.parser.members[row.first_type_member + row.type_member_count - 1])
            _ -> rejected(row.start)
        }
    }
    state case_name(row: OmegaStructLiteralSyntax, name: OmegaRelativeSpan) {
        let slot: i32 = self.resolve_case(source, expected - 100000, name.start, name.end);
        transition slot >= 0 {
            true -> case_count(row, slot)
            _ -> rejected(name.start)
        }
    }
    state case_count(row: OmegaStructLiteralSyntax, slot: i32) {
        self.value_payloads[expression] = slot;
        transition true { true -> coverage(row, self.parser.data_cases[slot].payload_field_count) }
    }
    state name(row: OmegaStructLiteralSyntax, name: OmegaRelativeSpan) {
        transition self.resolve_data(source, name.start,
            self.parser.members[row.first_type_member + row.type_member_count - 1].end) == expected - 100000 {
            true -> count(row)
            _ -> rejected(name.start)
        }
    }
    state count(row: OmegaStructLiteralSyntax) {
        self.value_payloads[expression] = -1;
        transition true { true -> coverage(row, self.parser.data_items[expected - 100000].field_count) }
    }
    state coverage(row: OmegaStructLiteralSyntax, declared: i32) {
        // Completed copy layouts admit only fields with established zero values.
        // Each authored initializer still has to prove its own field bound.
        transition (row.field_count == declared) ||
            ((row.has_omission == 1) && (row.field_count < declared)) {
            true -> fields(row, 0)
            _ -> rejected(row.start)
        }
    }
    state fields(row: OmegaStructLiteralSyntax, offset: i32) {
        transition offset < row.field_count {
            true -> field(row, offset, self.parser.struct_literal_fields[row.first_field + offset])
            _ -> retain()
        }
    }
    state field(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax) {
        transition self.value_payloads[expression] >= 0 {
            true -> resolved(row, offset, field, self.resolve_payload_field(source,
                self.value_payloads[expression], field.name.start, field.name.end))
            _ -> resolved(row, offset, field, self.resolve_field(source,
                expected - 100000, field.name.start, field.name.end))
        }
    }
    state resolved(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax, slot: i32) {
        transition slot >= 0 {
            true -> unique(row, offset, field, slot, 0)
            _ -> rejected(field.name.start)
        }
    }
    state unique(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax,
        slot: i32, previous: i32) {
        transition previous < offset {
            true -> compare(row, offset, field, slot, previous,
                self.parser.struct_literal_fields[row.first_field + previous].name)
            _ -> value(row, offset, field, slot)
        }
    }
    state compare(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax,
        slot: i32, previous: i32, other: OmegaRelativeSpan) {
        transition self.span_equals(source, field.name.start, field.name.end, source[other.start..other.end]) {
            1 -> rejected(field.name.start)
            _ -> unique(row, offset, field, slot, previous + 1)
        }
    }
    state value(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax, slot: i32) {
        transition self.check_value(source, owner, state_index, before, field.value, self.field_types[slot]) {
            1 -> bound(row, offset, field, slot)
            _ -> return 0
        }
    }
    state bound(row: OmegaStructLiteralSyntax, offset: i32, field: OmegaStructLiteralFieldSyntax, slot: i32) {
        transition self.check_field_bound(source, slot, field.value) {
            1 -> retained_field(row, offset, slot)
            _ -> return 0
        }
    }
    state retained_field(row: OmegaStructLiteralSyntax, offset: i32, slot: i32) {
        self.struct_field_slots[row.first_field + offset] = slot;
        transition true { true -> fields(row, offset + 1) }
    }
    state retain() {
        transition self.value_payloads[expression] >= 0 {
            true -> retain_case()
            _ -> retain_record()
        }
    }
    state retain_case() {
        self.value_payloads[expression] = self.value_payloads[expression] -
            self.parser.data_items[expected - 100000].first_case;
        self.value_kinds[expression] = OmegaCheckedValueKind::CaseLiteral;
        return 1;
    }
    state retain_record() { self.value_kinds[expression] = OmegaCheckedValueKind::RecordLiteral; return 1; }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// Copy one checked value: r0 is its scalar word or aggregate source address;
// r1 is the already captured destination. No source expression is reevaluated.
machine OmegaScalarCompiler::emit_store_at(&mut self, kind: i32, size: i32) -> i32 {
    transition ((kind >= 100000) && (kind < 400000)) || (kind == omega_shared_byte_slice()) {
        true -> return self.emit_copy_words(size)
        _ -> scalar()
    }
    state scalar() {
        transition size {
            1 -> return self.tape.emit_rr(9, 1, 0)
            _ -> return self.tape.emit_rr(11, 1, 0)
        }
    }
}

machine OmegaScalarCompiler::emit_copy_words(&mut self, size: i32) -> i32 {
    self.emission_resource = 14;
    let loop: i32 = self.tape.new_label();
    transition loop >= 0 {
        true -> emit(loop)
        _ -> return 0
    }
    state emit(loop: i32) {
        self.emission_resource = 12;
        transition (self.tape.emit_rr(2, 3, 0) == 1) &&
            (self.tape.emit_rr(2, 4, 1) == 1) &&
            (self.tape.emit_imm(5, size, 0) == 1) &&
            (self.tape.emit_imm(6, 8, 0) == 1) &&
            (self.tape.define_label(loop) == 1) &&
            (self.tape.emit_rr(10, 7, 3) == 1) &&
            (self.tape.emit_rr(11, 4, 7) == 1) &&
            (self.tape.emit_rr(3, 3, 6) == 1) &&
            (self.tape.emit_rr(3, 4, 6) == 1) &&
            (self.tape.emit_rr(4, 5, 6) == 1) &&
            (self.tape.emit_rx_label(14, 5, loop) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_zero_cell(&mut self, cell: i32) -> i32 {
    self.emission_resource = 14;
    let loop: i32 = self.tape.new_label();
    transition loop >= 0 {
        true -> emit(loop)
        _ -> return 0
    }
    state emit(loop: i32) {
        self.emission_resource = 12;
        transition (self.tape.emit_imm(0, 0, 0) == 1) &&
            (self.tape.emit_imm(1, omega_storage_base() + self.cell_offsets[cell], 0) == 1) &&
            (self.tape.emit_imm(5, self.cell_sizes[cell], 0) == 1) &&
            (self.tape.emit_imm(6, 8, 0) == 1) &&
            (self.tape.define_label(loop) == 1) &&
            (self.tape.emit_rr(11, 1, 0) == 1) &&
            (self.tape.emit_rr(3, 1, 6) == 1) &&
            (self.tape.emit_rr(4, 5, 6) == 1) &&
            (self.tape.emit_rx_label(14, 5, loop) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::emit_place_address(&mut self, expression: i32) -> i32 {
    transition self.parser.expressions[expression].kind {
        OmegaExpressionKind::Indexed -> return self.emit_index_address(expression)
        _ -> address()
    }
    state address() {
        transition self.tape.emit_imm(0,
            omega_storage_base() + self.cell_offsets[self.place_roots[expression]], 0) {
            1 -> root()
            _ -> return 0
        }
    }
    state root() {
        transition self.place_indirect[expression] {
            1 -> indirect()
            _ -> offset()
        }
    }
    state indirect() {
        transition self.tape.emit_rr(10, 0, 0) {
            1 -> offset()
            _ -> return 0
        }
    }
    state offset() {
        transition (self.tape.emit_imm(1, self.place_offsets[expression], 0) == 1) &&
            (self.tape.emit_rr(3, 0, 1) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// A loan covers the parent array. Reads and writes use the selected element width.
machine OmegaScalarCompiler::place_value_size(&mut self, target: i32) -> i32 {
    transition self.parser.expressions[target].kind {
        OmegaExpressionKind::Indexed -> return self.index_plans[target].stride
        _ -> return self.place_extent[target]
    }
}

machine OmegaScalarCompiler::emit_place_value(&mut self, expression: i32) -> i32 {
    transition self.emit_place_address(expression) {
        1 -> return self.emit_address_value(self.place_types[expression], self.place_value_size(expression))
        _ -> return 0
    }
}

machine OmegaScalarCompiler::emit_address_value(&mut self, kind: i32, size: i32) -> i32 {
    transition (kind >= 100000) && (kind < 400000) {
        true -> return 1
        _ -> scalar()
    }
    state scalar() {
        transition size {
            1 -> return self.tape.emit_rr(8, 0, 0)
            _ -> return self.tape.emit_rr(10, 0, 0)
        }
    }
}

machine OmegaScalarCompiler::emit_record_literal(&mut self, expression: i32) -> i32 {
    let row: OmegaStructLiteralSyntax = self.parser.struct_literals[self.parser.expressions[expression].payload0];
    transition row.has_omission {
        1 -> zero(row)
        _ -> select_case(row)
    }
    state zero(row: OmegaStructLiteralSyntax) {
        transition self.emit_zero_cell(49152 + expression) {
            1 -> select_case(row)
            _ -> return 0
        }
    }
    state select_case(row: OmegaStructLiteralSyntax) {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::CaseLiteral -> tag(row)
            _ -> field(row, 0)
        }
    }
    state tag(row: OmegaStructLiteralSyntax) {
        transition self.emit_case_value(expression) {
            1 -> field(row, 0)
            _ -> return 0
        }
    }
    state field(row: OmegaStructLiteralSyntax, offset: i32) {
        transition offset < row.field_count {
            true -> value(row, offset, row.first_field + offset)
            _ -> return self.tape.emit_imm(0, omega_storage_base() + self.cell_offsets[49152 + expression], 0)
        }
    }
    state value(row: OmegaStructLiteralSyntax, offset: i32, slot: i32) {
        transition self.emit_value(self.parser.struct_literal_fields[slot].value) {
            1 -> store(row, offset, self.struct_field_slots[slot])
            _ -> return 0
        }
    }
    state store(row: OmegaStructLiteralSyntax, offset: i32, field: i32) {
        transition (self.tape.emit_imm(1, omega_storage_base() + self.cell_offsets[49152 + expression] +
            self.field_offsets[field], 0) == 1) &&
            (self.emit_store_at(self.field_types[field], self.field_extents[field]) == 1) {
            true -> field(row, offset + 1)
            _ -> return 0
        }
    }
}

// Bound the whole type/layout traversal, including nested arrays, rather than
// bounding record depth alone while recursively unwrapping unlimited arrays.
machine OmegaScalarCompiler::type_size(&mut self, source: &[u8], kind: i32) -> i32 {
    transition self.layout_depth < 64 {
        true -> enter()
        _ -> return 0
    }
    state enter() {
        self.layout_depth = self.layout_depth + 1;
        let size: i32 = self.type_size_inner(source, kind);
        self.layout_depth = self.layout_depth - 1;
        return size;
    }
}

// Infer only element types realized by the checked fixed-array catalog.
// This pass leaves the selector and its loan to the indexing checker.
machine OmegaScalarCompiler::index_result_type(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32
) -> i32 {
    let row: OmegaIndexedExpressionSyntax = self.parser.indexed_expressions[
        self.parser.expressions[expression].payload0];
    transition self.byte_slice_parameter(source, state_index, before, row.base) >= 0 {
        true -> return 8
        _ -> collection(row.base)
    }
    state collection(base: i32) {
        let value: OmegaExpressionSyntax = self.parser.expressions[base];
        transition value.kind {
            OmegaExpressionKind::Path -> place(base, 0)
            OmegaExpressionKind::Borrow -> place(value.payload0, 0)
            OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[value.payload0])
            _ -> return -1
        }
    }
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::RemoveDomain -> domain(row)
            _ -> return -1
        }
    }
    state domain(row: OmegaCastExpressionSyntax) {
        transition self.span_equals(source, row.domain.start, row.domain.end, "Trapping") {
            1 -> borrowed(self.parser.expressions[row.value])
            _ -> return -1
        }
    }
    state borrowed(row: OmegaExpressionSyntax) {
        transition row.kind {
            OmegaExpressionKind::Borrow -> place(row.payload0, 1)
            _ -> return -1
        }
    }
    state place(base: i32, removed: i32) {
        transition self.parser.expressions[base].kind {
            OmegaExpressionKind::Path -> resolve(base, removed)
            _ -> return -1
        }
    }
    state resolve(base: i32, removed: i32) {
        transition self.check_index_base(source, state_index, before, base) {
            1 -> array(self.place_types[base], removed)
            _ -> return -1
        }
    }
    state array(kind: i32, removed: i32) {
        let row: i32 = self.indexable_array_row(kind, removed);
        transition row >= 0 {
            true -> return self.copy_index_element(source, self.array_element_kind(source, row))
            _ -> return -1
        }
    }
}

// Use the existing checked record layout and multiplicity for both read and
// whole-element assignment. A sum, reference or other array element remains
// outside the fixed-array index families this compiler realizes.
machine OmegaScalarCompiler::copy_index_element(&mut self, source: &[u8], kind: i32) -> i32 {
    transition (kind > 0) && (kind < 100000) && (kind != 2) && (self.type_copy(source, kind) == 1) {
        true -> return kind
        _ -> record()
    }
    state record() {
        transition (kind >= 100000) && (kind < 104096) {
            true -> shape(kind - 100000)
            _ -> return -1
        }
    }
    state shape(declaration: i32) {
        transition (self.parser.data_items[declaration].case_count == 0) &&
            (self.type_size(source, kind) > 0) && (self.type_copy(source, kind) == 1) {
            true -> return kind
            _ -> return -1
        }
    }
}

// Indexing a reference parameter addresses its pointee. A bare reference in
// an ordinary value position still uses the call's existing loan carrier.
machine OmegaScalarCompiler::check_index_base(&mut self, source: &[u8], state_index: i32,
    before: i32, base: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[base];
    transition row.kind {
        OmegaExpressionKind::Path -> path(row)
        _ -> ordinary()
    }
    state path(row: OmegaExpressionSyntax) {
        transition (row.payload1 == 1) && (row.payload2 == 0) && (row.payload3 == 1) {
            true -> name(self.parser.members[row.payload0])
            _ -> ordinary()
        }
    }
    state name(name: OmegaRelativeSpan) {
        transition self.pattern_binding(source, name) < 0 {
            true -> cell(self.value_cell(source, state_index, before, name.start, name.end))
            _ -> ordinary()
        }
    }
    state cell(slot: i32) {
        transition (slot >= 0) && (slot < 16384) {
            true -> parameter(slot, self.parameter_types[slot])
            _ -> ordinary()
        }
    }
    state parameter(slot: i32, kind: i32) {
        transition omega_array_reference_row(kind) >= 0 {
            true -> referent(slot, kind, omega_reference_target(kind))
            _ -> ordinary()
        }
    }
    state referent(slot: i32, kind: i32, target: i32) {
        self.place_roots[base] = slot;
        self.place_offsets[base] = 0;
        self.place_fields[base] = -1;
        self.place_indirect[base] = 1;
        self.place_writable[base] = kind / 100000 - 4;
        self.place_types[base] = target;
        self.place_extent[base] = self.type_size(source, target);
        return 1;
    }
    state ordinary() { return self.check_place(source, state_index, before, base); }
}

machine OmegaScalarCompiler::check_index(
    &mut self, source: &[u8], state_index: i32, before: i32,
    expression: i32, access: i32
) -> i32 {
    // Every payload field is overwritten before the schema is published.
    self.index_plans[expression].schema = 0;
    let row: OmegaIndexedExpressionSyntax = self.parser.indexed_expressions[
        self.parser.expressions[expression].payload0];
    self.index_plans[expression].selector = row.index;
    self.index_plans[expression].owner_state = state_index;
    self.index_plans[expression].before = before;
    self.index_plans[expression].access = access;
    transition (access == 1) && (self.byte_slice_parameter(source, state_index, before, row.base) >= 0) {
        true -> read_only(row)
        _ -> storage(row)
    }
    state read_only(row: OmegaIndexedExpressionSyntax) { self.record_reject(-1, 4, row.start); return 0; }
    state storage(row: OmegaIndexedExpressionSyntax) {
        transition self.require_cell(source, 49152 + expression, 8) {
            1 -> collection(row.base)
            _ -> return 0
        }
    }
    state collection(base: i32) {
        let value: OmegaExpressionSyntax = self.parser.expressions[base];
        transition value.kind {
            OmegaExpressionKind::Path -> place(base, 0)
            OmegaExpressionKind::Borrow -> borrowed(value, 0)
            OmegaExpressionKind::Cast -> cast(self.parser.cast_expressions[value.payload0])
            _ -> unsupported()
        }
    }
    state cast(row: OmegaCastExpressionSyntax) {
        transition row.kind {
            OmegaCastKind::RemoveDomain -> removed(row)
            _ -> unsupported()
        }
    }
    state removed(row: OmegaCastExpressionSyntax) {
        transition self.span_equals(source, row.domain.start, row.domain.end, "Trapping") {
            1 -> view(self.parser.expressions[row.value])
            _ -> unsupported()
        }
    }
    state view(value: OmegaExpressionSyntax) {
        transition value.kind {
            OmegaExpressionKind::Borrow -> borrowed(value, 1)
            _ -> unsupported()
        }
    }
    state borrowed(value: OmegaExpressionSyntax, removed: i32) {
        // A shared view cannot yield writable storage. Other attenuation or
        // parent/child reborrow schedules stay outside this initial schema.
        transition value.payload1 == access {
            true -> place(value.payload0, removed)
            _ -> borrowed_access(value)
        }
    }
    state borrowed_access(value: OmegaExpressionSyntax) {
        transition (access == 1) && (value.payload1 == 0) {
            true -> rejected()
            _ -> unsupported()
        }
    }
    state place(base: i32, removed: i32) {
        transition self.parser.expressions[base].kind {
            OmegaExpressionKind::Path -> resolve(base, removed)
            _ -> unsupported()
        }
    }
    state resolve(base: i32, removed: i32) {
        transition self.check_index_base(source, state_index, before, base) {
            1 -> collection_type(base, removed, self.place_types[base])
            _ -> return 0
        }
    }
    state collection_type(base: i32, removed: i32, kind: i32) {
        let row: i32 = self.indexable_array_row(kind, removed);
        transition row >= 0 {
            true -> array(base, removed, kind, row)
            _ -> unsupported()
        }
    }
    state array(base: i32, removed: i32, kind: i32, row: i32) {
        let element: i32 = self.copy_index_element(source, self.array_element_kind(source, row));
        transition element > 0 {
            true -> element_stride(base, removed, kind, row, element)
            _ -> unsupported()
        }
    }
    state element_stride(base: i32, removed: i32, kind: i32, row: i32, element: i32) {
        self.index_plans[expression].element_type = element;
        self.index_plans[expression].stride = self.array_element_stride(source, element);
        transition self.index_plans[expression].stride > 0 {
            true -> count(base, removed, kind, self.array_count(source, row))
            _ -> unsupported()
        }
    }
    state count(base: i32, removed: i32, kind: i32, size: i32) {
        transition (size > 0) && (size <= omega_storage_capacity() / self.index_plans[expression].stride) {
            true -> authority(base, removed, kind, size)
            _ -> unsupported()
        }
    }
    state authority(base: i32, removed: i32, kind: i32, count: i32) {
        transition (access == 0) || (self.place_writable[base] == 1) {
            true -> available(base, removed, kind, count)
            _ -> rejected()
        }
    }
    state available(base: i32, removed: i32, kind: i32, count: i32) {
        transition self.place_available(source, base, access) {
            1 -> capture(base, removed, kind, count)
            _ -> return 0
        }
    }
    state capture(base: i32, removed: i32, kind: i32, count: i32) {
        self.index_plans[expression].array_type = kind;
        self.index_plans[expression].extent = count;
        self.index_plans[expression].collection = base;
        self.index_plans[expression].removed_trapping = removed;
        self.index_plans[expression].parent_root = self.place_roots[base];
        self.index_plans[expression].parent_offset = self.place_offsets[base];
        self.index_plans[expression].parent_extent = self.place_extent[base];
        transition true { true -> selector_loan(self.loan_count) }
    }
    state selector_loan(first_loan: i32) {
        transition self.retain_index_loan(expression) {
            1 -> selector(first_loan)
            _ -> return 0
        }
    }
    state selector(first_loan: i32) {
        transition self.check_value(source, self.state_owners[state_index], state_index, before,
            self.index_plans[expression].selector, 64) {
            1 -> selector_bound(first_loan)
            _ -> failed(first_loan)
        }
    }
    state selector_bound(first_loan: i32) {
        transition self.check_index_bound(source, expression, self.index_plans[expression].selector) {
            1 -> retain(first_loan)
            _ -> failed(first_loan)
        }
    }
    state retain(first_loan: i32) {
        self.loan_count = first_loan;
        self.index_plans[expression].schema = access + 1;
        self.place_roots[expression] = self.index_plans[expression].parent_root;
        self.place_offsets[expression] = self.index_plans[expression].parent_offset;
        self.place_extent[expression] = self.index_plans[expression].parent_extent;
        self.place_types[expression] = self.index_plans[expression].element_type;
        self.place_indirect[expression] = self.place_indirect[self.index_plans[expression].collection];
        self.place_writable[expression] = access;
        self.place_fields[expression] = -1;
        return 1;
    }
    state failed(first_loan: i32) { self.loan_count = first_loan; return 0; }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

// A fixed index must fit on every path that evaluates it. Keep the branch
// proof inside the selected arm and match the index by its parameter identity.
machine OmegaScalarCompiler::check_index_bound(
    &mut self, source: &[u8], expression: i32, selector: i32
) -> i32 {
    transition self.value_kinds[selector] {
        OmegaCheckedValueKind::Literal -> literal(self.value_payloads[selector])
        OmegaCheckedValueKind::RepresentationCast -> return self.check_index_bound(source, expression, self.value_payloads[selector])
        _ -> contextual()
    }
    state literal(value: i32) {
        transition (value >= 0) && (value < self.index_plans[expression].extent) {
            true -> retain(OmegaIndexBoundKind::Literal, selector, value)
            _ -> rejected()
        }
    }
    state contextual() {
        let plan: OmegaFixedIndexPlan = self.index_plans[expression];
        transition self.prove_ceiling(source, plan.owner_state, plan.before, selector, plan.extent - 1) {
            1 -> retain(OmegaIndexBoundKind::ValueInterval, selector, plan.extent - 1)
            _ -> branch(plan)
        }
    }
    state branch(plan: OmegaFixedIndexPlan) {
        transition self.active_boolean_arm >= 0 {
            true -> guarded(plan, self.parser.transition_statements[self.active_boolean_arm],
                self.u64_index_parameter(source, plan.owner_state, plan.before, plan.selector))
            _ -> unsupported()
        }
    }
    state guarded(plan: OmegaFixedIndexPlan, row: OmegaTransitionStatementSyntax, index: i32) {
        transition row.guard_kind {
            OmegaTransitionGuardKind::Boolean -> target(plan, row, index, row.subject, row.guard_boolean)
            OmegaTransitionGuardKind::Predicate -> target(plan, row, index, row.guard_expression, 1)
            _ -> unsupported()
        }
    }
    state target(plan: OmegaFixedIndexPlan, row: OmegaTransitionStatementSyntax, index: i32,
        guard: i32, truth: i32) {
        transition (index >= 0) && (self.pure_value(guard) == 1) &&
            (self.pure_transition_target(row) == 1) &&
            (self.guard_bound(index, 0, 0, plan.extent - 1,
                guard, truth) == 1) {
            true -> retain(OmegaIndexBoundKind::BooleanArm, self.active_boolean_arm, plan.extent - 1)
            _ -> unsupported()
        }
    }
    state retain(kind: OmegaIndexBoundKind, origin: i32, bound: i32) {
        self.index_plans[expression].bound_kind = kind;
        self.index_plans[expression].bound_source = origin;
        self.index_plans[expression].bound_limit = bound;
        return 1;
    }
    state unsupported() {
        let plan: OmegaFixedIndexPlan = self.index_plans[expression];
        transition self.infer_private_index(source, plan.owner_state, plan.before, selector, plan.extent) {
            1 -> retain(OmegaIndexBoundKind::ValueInterval, selector, plan.extent - 1)
            _ -> failed_inference()
        }
    }
    state failed_inference() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
    state rejected() { self.record_reject(-1, 4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::retain_index_loan(&mut self, expression: i32) -> i32 {
    transition self.loan_count < 16384 {
        true -> retain()
        _ -> unsupported()
    }
    state retain() {
        let plan: OmegaFixedIndexPlan = self.index_plans[expression];
        self.loan_access[self.loan_count] = plan.access;
        self.loan_context[self.loan_count] = 1;
        self.loan_roots[self.loan_count] = plan.parent_root;
        self.loan_offsets[self.loan_count] = plan.parent_offset;
        self.loan_sizes[self.loan_count] = plan.parent_extent;
        self.loan_count = self.loan_count + 1;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// The checked plan captures backing before evaluating its selector. An indexed
// assignment saves this resulting address again before its RHS, so a later
// selector-field mutation cannot redirect the pending store.
machine OmegaScalarCompiler::emit_index_address(&mut self, expression: i32) -> i32 {
    let plan: OmegaFixedIndexPlan = self.index_plans[expression];
    transition plan.bound_kind {
        OmegaIndexBoundKind::Unproved -> return self.tape.fail_internal(expression)
        _ -> layout(plan)
    }
    state layout(plan: OmegaFixedIndexPlan) {
        transition ((plan.schema == 1) || (plan.schema == 2)) &&
            (plan.element_type == self.place_types[expression]) && (plan.stride > 0) &&
            (plan.extent > 0) && (plan.extent <= omega_storage_capacity() / plan.stride) &&
            (plan.bound_limit >= 0) && (plan.bound_limit < plan.extent) &&
            (plan.parent_root == self.place_roots[plan.collection]) &&
            (plan.parent_offset == self.place_offsets[plan.collection]) &&
            (plan.parent_extent == self.place_extent[plan.collection]) {
            true -> capture(plan)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state capture(plan: OmegaFixedIndexPlan) {
        transition (self.emit_place_address(plan.collection) == 1) &&
            (self.emit_save_address(49152 + expression) == 1) &&
            (self.emit_value(plan.selector) == 1) &&
            (self.tape.emit_rr(2, 2, 0) == 1) &&
            (self.emit_restore_address(49152 + expression) == 1) &&
            (self.tape.emit_imm(1, plan.stride, 0) == 1) &&
            (self.tape.emit_rr(5, 2, 1) == 1) &&
            (self.tape.emit_rr(3, 0, 2) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Nested transfers may carry only the enclosing invocation's original reference.
// No nested reference can begin from an owned local whose static cell a later
// transfer reuses. Kinds retain the exact referent declaration and access mode.
machine OmegaScalarCompiler::reference_signature(&mut self, source: &[u8], owner: i32, state_index: i32, kind: i32) -> i32 {
    transition (kind < 400000) || (state_index == self.parser.machine_items[owner].first_state) {
        true -> return 1
        _ -> original(self.parser.machine_items[owner].first_state, 0)
    }
    state original(entry: i32, offset: i32) {
        transition offset < self.state_parameter_count(entry) {
            true -> parameter(entry, offset, self.parameter_types[self.state_first_parameter(entry) + offset])
            _ -> return 0
        }
    }
    state parameter(entry: i32, offset: i32, incoming: i32) {
        transition self.same_reference_type(source, incoming, kind) {
            true -> return 1
            _ -> original(entry, offset + 1)
        }
    }
}

// Ordinary calls and nested transfers forward the incoming loan carrier,
// never its referent. Terminal arguments separately require this original
// incoming-reference form; an explicit borrow of a reused local cannot enter.
// The referent's
// full range stays lent while later arguments evaluate, so a bare forwarding
// spelling cannot evade ordinary argument-order alias checks.
machine OmegaScalarCompiler::check_forward_reference(
    &mut self, source: &[u8], state_index: i32, before: i32,
    expression: i32, expected: i32
) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition row.kind {
        OmegaExpressionKind::String -> return self.check_quoted_bytes(expression, expected)
        OmegaExpressionKind::Path -> path(row)
        OmegaExpressionKind::Borrow -> subrange_borrow(row)
        OmegaExpressionKind::Indexed -> subrange(expression)
        _ -> unsupported()
    }
    state subrange_borrow(row: OmegaExpressionSyntax) {
        transition row.payload1 == 0 { true -> subrange(row.payload0) _ -> unsupported() }
    }
    state subrange(indexed: i32) {
        transition expected == omega_shared_byte_slice() {
            true -> return self.check_forward_byte_subrange(source, state_index, before, expression, indexed)
            _ -> unsupported()
        }
    }
    state path(row: OmegaExpressionSyntax) {
        transition (row.payload1 == 1) && (row.payload2 == 0) && (row.payload3 == 1) {
            true -> name(self.parser.members[row.payload0])
            _ -> unsupported()
        }
    }
    state name(name: OmegaRelativeSpan) {
        transition self.pattern_binding(source, name) >= 0 {
            true -> unsupported()
            _ -> parameter(name)
        }
    }
    state parameter(name: OmegaRelativeSpan) {
        let slot: i32 = self.value_cell(source, state_index, before, name.start, name.end);
        let entry: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
        transition (slot >= entry.first_parameter) && (slot < entry.first_parameter + entry.parameter_count) {
            true -> type(slot, name.start)
            _ -> unsupported()
        }
    }
    state type(slot: i32, at: i32) {
        transition self.same_reference_type(source, self.parameter_types[slot], expected) {
            true -> place(slot)
            _ -> mismatch(self.parameter_types[slot], at)
        }
    }
    state mismatch(actual: i32, at: i32) {
        transition (omega_array_reference_row(actual) >= 0) && (omega_array_reference_row(expected) >= 0) &&
            (actual / 100000 == expected / 100000) {
            true -> rejected(at)
            _ -> unsupported()
        }
    }
    state rejected(at: i32) { self.record_reject(-1, 4, at); return 0; }
    state place(slot: i32) {
        self.place_roots[expression] = slot;
        self.place_offsets[expression] = 0;
        transition expected == omega_shared_byte_slice() {
            true -> slice(slot)
            _ -> record(slot)
        }
    }
    state slice(slot: i32) {
        self.place_extent[expression] = 16;
        self.place_types[expression] = expected;
        self.place_indirect[expression] = 0;
        self.place_writable[expression] = 0;
        self.place_fields[expression] = -1;
        transition true { true -> capacity(slot) }
    }
    state record(slot: i32) {
        let target: i32 = omega_reference_target(expected);
        self.place_extent[expression] = self.type_size(source, target);
        self.place_types[expression] = target;
        self.place_indirect[expression] = 1;
        self.place_writable[expression] = expected / 100000 - 4;
        self.place_fields[expression] = -1;
        transition self.place_available(source, expression, expected / 100000 - 4) {
            1 -> capacity(slot)
            _ -> return 0
        }
    }
    state capacity(slot: i32) {
        transition self.loan_count < 16384 {
            true -> retain(slot)
            _ -> unsupported()
        }
    }
    state retain(slot: i32) {
        self.loan_access[self.loan_count] = expected / 100000 - 4;
        self.loan_context[self.loan_count] = 0;
        self.loan_roots[self.loan_count] = slot;
        self.loan_offsets[self.loan_count] = 0;
        self.loan_sizes[self.loan_count] = self.place_extent[expression];
        self.loan_count = self.loan_count + 1;
        self.value_kinds[expression] = OmegaCheckedValueKind::ForwardedReference;
        self.value_payloads[expression] = slot;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// Contracts use the same parsed predicate expressions as data defaults. This
// profile supports unsigned formal/field bounds and conjunction, not arbitrary
// contracts. An unsupported predicate cannot disappear into an empty contract.
machine OmegaScalarCompiler::decode_entry_bounds(&mut self, source: &[u8], state_index: i32) -> i32 {
    self.diagnostic_offset = self.parser.machine_items[self.state_owners[state_index]].start;
    self.bound_first[state_index] = self.bound_total;
    self.bound_count[state_index] = 0;
    transition true { true -> next(0) }
    state next(offset: i32) {
        transition offset < self.parser.machine_states[self.local_state_row(state_index)].requirement_count {
            true -> predicate(offset, self.parser.requirements[
                self.parser.machine_states[self.local_state_row(state_index)].first_requirement + offset].expression)
            _ -> complete()
        }
    }
    state predicate(offset: i32, expression: i32) {
        transition self.decode_entry_predicate(source, state_index, expression) {
            1 -> next(offset + 1)
            _ -> return 0
        }
    }
    state complete() {
        self.bound_count[state_index] = self.bound_total - self.bound_first[state_index];
        return 1;
    }
}

machine OmegaScalarCompiler::decode_entry_predicate(
    &mut self, source: &[u8], state_index: i32, expression: i32
) -> i32 {
    let value: OmegaExpressionSyntax = self.parser.expressions[expression];
    transition value.kind {
        OmegaExpressionKind::Boolean -> truth(value.payload0)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[value.payload0])
        _ -> unsupported()
    }
    state truth(value: i32) { transition value == 1 { true -> return 1 _ -> unsupported() } }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::And -> conjunction(row)
            OmegaBinaryOperatorKind::Less -> subject(row)
            OmegaBinaryOperatorKind::LessEqual -> subject(row)
            OmegaBinaryOperatorKind::Greater -> subject(row)
            OmegaBinaryOperatorKind::GreaterEqual -> subject(row)
            _ -> unsupported()
        }
    }
    state conjunction(row: OmegaBinaryExpressionSyntax) {
        transition (self.decode_entry_predicate(source, state_index, row.left) == 1) &&
            (self.decode_entry_predicate(source, state_index, row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state subject(row: OmegaBinaryExpressionSyntax) {
        transition self.parser.expressions[row.left].kind {
            OmegaExpressionKind::Path -> place(row)
            _ -> unsupported()
        }
    }
    state place(row: OmegaBinaryExpressionSyntax) {
        transition self.check_place(source, state_index, 0, row.left) {
            1 -> formal(row, self.place_roots[row.left])
            _ -> return 0
        }
    }
    state formal(row: OmegaBinaryExpressionSyntax, root: i32) {
        let body: OmegaMachineStateSyntax = self.parser.machine_states[self.local_state_row(state_index)];
        transition (root >= body.first_parameter) && (root < body.first_parameter + body.parameter_count) &&
            ((self.parameter_types[root] < 100000) || (self.parameter_types[root] >= 400000)) {
            true -> carrier(row, self.place_types[row.left])
            _ -> unsupported()
        }
    }
    state carrier(row: OmegaBinaryExpressionSyntax, kind: i32) {
        transition (kind == 8) || (kind == 32) || (kind == 33) || (kind == 64) || (self.is_policy_word(kind) == 1) {
            true -> literal(row, kind % 256, self.parser.expressions[row.right])
            _ -> unsupported()
        }
    }
    state literal(row: OmegaBinaryExpressionSyntax, kind: i32, right: OmegaExpressionSyntax) {
        transition right.kind {
            OmegaExpressionKind::Integer -> scan(row, kind, right)
            OmegaExpressionKind::Path -> ordered(row)
            _ -> unsupported()
        }
    }
    state ordered(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Less -> pair(row.left, row.right, OmegaEntryBoundKind::StrictOrder)
            OmegaBinaryOperatorKind::LessEqual -> pair(row.left, row.right, OmegaEntryBoundKind::InclusiveOrder)
            OmegaBinaryOperatorKind::Greater -> pair(row.right, row.left, OmegaEntryBoundKind::StrictOrder)
            OmegaBinaryOperatorKind::GreaterEqual -> pair(row.right, row.left, OmegaEntryBoundKind::InclusiveOrder)
            _ -> unsupported()
        }
    }
    state pair(left: i32, right: i32, kind: OmegaEntryBoundKind) {
        transition self.bound_total < 16384 {
            true -> destination(left, right, kind, self.slice_length_parameter(source, state_index, 0, right))
            _ -> unsupported()
        }
    }
    state destination(left: i32, right: i32, kind: OmegaEntryBoundKind, slice: i32) {
        transition slice >= 0 {
            true -> slice_pair(self.u64_index_parameter(source, state_index, 0, left), slice, kind)
            _ -> scalar_pair(self.unsigned_formal(source, state_index, 0, left, 1),
                self.unsigned_formal(source, state_index, 0, right, 1), kind)
        }
    }
    state slice_pair(index: i32, slice: i32, kind: OmegaEntryBoundKind) {
        transition index >= 0 { true -> retain_order(index, slice, 8, kind) _ -> unsupported() }
    }
    state scalar_pair(left: i32, right: i32, kind: OmegaEntryBoundKind) {
        transition (left >= 0) && (right >= 0) && (self.parameter_types[left] == self.parameter_types[right]) &&
            ((self.parameter_types[left] == 8) || (self.parameter_types[left] == 32) || (self.parameter_types[left] == 64)) {
            true -> retain_order(left, right, 0, kind)
            _ -> unsupported()
        }
    }
    state retain_order(left: i32, right: i32, offset: i32, kind: OmegaEntryBoundKind) {
        self.entry_bounds[self.bound_total].kind = kind;
        self.entry_bounds[self.bound_total].root = left;
        self.entry_bounds[self.bound_total].right = right;
        self.entry_bounds[self.bound_total].right_offset = offset;
        self.bound_total = self.bound_total + 1;
        return 1;
    }
    state scan(row: OmegaBinaryExpressionSyntax, kind: i32, right: OmegaExpressionSyntax) {
        self.scan_integer(source, right, kind);
        transition (self.literal_status == 1) && (self.literal_value >= 0) && (self.bound_total < 16384) {
            true -> relation(row, self.literal_value)
            _ -> unsupported()
        }
    }
    state relation(row: OmegaBinaryExpressionSyntax, value: i32) {
        transition row.operator {
            OmegaBinaryOperatorKind::Less -> strict_ceiling(row, value)
            OmegaBinaryOperatorKind::LessEqual -> ceiling(row, value)
            OmegaBinaryOperatorKind::Greater -> strict_floor(row, value)
            OmegaBinaryOperatorKind::GreaterEqual -> retain(row, value, -1)
            _ -> unsupported()
        }
    }
    state strict_floor(row: OmegaBinaryExpressionSyntax, value: i32) {
        transition value < 2147483647 {
            true -> retain(row, value + 1, -1)
            _ -> unsupported()
        }
    }
    state strict_ceiling(row: OmegaBinaryExpressionSyntax, value: i32) {
        transition value > 0 {
            true -> ceiling(row, value - 1)
            _ -> unsupported()
        }
    }
    state ceiling(row: OmegaBinaryExpressionSyntax, maximum: i32) {
        transition self.place_types[row.left] == 33 {
            true -> retain(row, -1, maximum)
            _ -> retain(row, 0, maximum)
        }
    }
    state retain(row: OmegaBinaryExpressionSyntax, minimum: i32, maximum: i32) {
        self.entry_bounds[self.bound_total].kind = OmegaEntryBoundKind::Interval;
        self.entry_bounds[self.bound_total].root = self.place_roots[row.left];
        self.entry_bounds[self.bound_total].offset = self.place_offsets[row.left];
        self.entry_bounds[self.bound_total].field = self.place_fields[row.left];
        self.entry_bounds[self.bound_total].minimum = minimum;
        self.entry_bounds[self.bound_total].maximum = maximum;
        self.bound_total = self.bound_total + 1;
        return 1;
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}
// WideLiteral stores its high word separately. The low word alone cannot
// establish a constant endpoint for the i32 interval proof.
machine OmegaScalarCompiler::interval_literal(&mut self, expression: i32) -> i32 {
    transition self.value_kinds[expression] {
        OmegaCheckedValueKind::Literal -> return self.value_payloads[expression]
        _ -> return -1
    }
}

// Unsigned intervals have one meaning across entry contracts, indexed
// access and invariant-preserving stores. Missing evidence is not a runtime
// check or an inferred precondition. A copied immutable initializer keeps its
// earlier snapshot; mutable referents use exact root/projection versions.
machine OmegaScalarCompiler::prove_ceiling(
    &mut self, source: &[u8], state_index: i32, before: i32, expression: i32, maximum: i32
) -> i32 {
    transition maximum >= 0 {
        true -> return self.prove_bound(source, state_index, before, expression, 0, maximum, -1, 0)
        _ -> return 0
    }
}

machine OmegaScalarCompiler::prove_bound(
    &mut self, source: &[u8], state_index: i32, before: i32,
    expression: i32, minimum: i32, maximum: i32, guard: i32, truth: i32
) -> i32 {
    transition (minimum >= -1) && ((minimum >= 0) || (maximum >= 0)) &&
        ((maximum == -1) || (minimum <= maximum)) {
        true -> value()
        _ -> return 0
    }
    state value() {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::Literal -> literal(self.value_payloads[expression])
            OmegaCheckedValueKind::NegativeI32Literal -> negative(self.value_payloads[expression])
            OmegaCheckedValueKind::RepresentationCast -> return self.prove_bound(source, state_index, before, self.value_payloads[expression], minimum, maximum, guard, truth)
            OmegaCheckedValueKind::Place -> place()
            OmegaCheckedValueKind::ExactAddition -> addition(self.parser.binary_expressions[self.value_payloads[expression]])
            OmegaCheckedValueKind::ExactSubtraction -> difference(self.parser.binary_expressions[self.value_payloads[expression]])
            OmegaCheckedValueKind::TrappingArithmetic -> trapping(self.parser.binary_expressions[self.value_payloads[expression]])
            _ -> return 0
        }
    }
    state literal(value: i32) {
        return (value >= 0) && (value >= minimum) && ((maximum < 0) || (value <= maximum));
    }
    state negative(value: i32) { return (minimum < 0) && (maximum >= 0) && (value <= maximum); }
    state place() {
        transition self.prove_place_bound(source, state_index, before,
            self.place_roots[expression], self.place_offsets[expression],
            self.place_fields[expression], self.place_types[expression], minimum, maximum, guard, truth) {
            1 -> return 1
            _ -> local(self.place_roots[expression])
        }
    }
    state local(root: i32) {
        transition (root >= 16384) && (root < 32768) &&
            (self.place_offsets[expression] == 0) && (self.place_fields[expression] < 0) {
            true -> initializer(root - 16384, self.parser.local_data_statements[root - 16384])
            _ -> return 0
        }
    }
    state initializer(index: i32, row: OmegaLocalDataStatementSyntax) {
        transition (row.is_mutable == 0) && (row.has_initial_value == 1) {
            true -> return self.prove_bound(source, state_index, self.local_befores[index], row.initial_value, minimum, maximum, -1, 0)
            _ -> return 0
        }
    }
    // A successful unsigned Trapping operation returns its mathematical result.
    // The generated code still checks the operation for overflow or underflow.
    state trapping(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> addition(row)
            OmegaBinaryOperatorKind::Subtract -> difference(row)
            _ -> return 0
        }
    }
    // Whenever unsigned subtraction returns, 0 <= left - right <= left.
    state difference(row: OmegaBinaryExpressionSyntax) {
        transition minimum <= 0 {
            true -> return self.prove_bound(source, state_index, before, row.left, 0, maximum, guard, truth)
            _ -> return 0
        }
    }
    state addition(row: OmegaBinaryExpressionSyntax) {
        transition self.value_kinds[row.right] {
            OmegaCheckedValueKind::Literal -> added(row, self.value_payloads[row.right])
            _ -> return 0
        }
    }
    state added(row: OmegaBinaryExpressionSyntax, amount: i32) {
        transition (minimum == 0) && (amount >= 0) && (amount <= maximum) {
            true -> return self.prove_bound(source, state_index, before, row.left, 0, maximum - amount, guard, truth)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::prove_place_bound(
    &mut self, source: &[u8], state_index: i32, before: i32,
    root: i32, offset: i32, field: i32, kind: i32,
    minimum: i32, maximum: i32, guard: i32, truth: i32
) -> i32 {
    transition (kind == 33) && (minimum >= 0) && (maximum >= 0) {
        true -> signed_interval()
        _ -> carrier()
    }
    state signed_interval() {
        return (self.prove_place_bound(source, state_index, before, root, offset, field, kind,
            minimum, -1, guard, truth) == 1) &&
            (self.prove_place_bound(source, state_index, before, root, offset, field, kind,
                -1, maximum, guard, truth) == 1);
    }
    state carrier() {
        transition (kind != 33) && (minimum == 0) && ((maximum < 0) || ((kind == 8) && (maximum >= 255))) {
            true -> return 1
            _ -> declared()
        }
    }
    state declared() {
        // Only the current case's checked payload field confers this floor.
        transition (kind == 33) && (field >= 16384) && (minimum == 0) && (maximum < 0) {
            true -> signed_payload()
            _ -> upper_bound()
        }
    }
    state signed_payload() {
        transition self.field_upper_bounds[field] >= 0 { true -> return 1 _ -> guarded() }
    }
    state upper_bound() {
        transition (minimum <= 0) && (maximum >= 0) && (field >= 0) {
            true -> field_bound(self.field_upper_bounds[field])
            _ -> guarded()
        }
    }
    state field_bound(known: i32) {
        transition (known >= 0) && (known <= maximum) { true -> return 1 _ -> guarded() }
    }
    state guarded() {
        transition self.guard_bound(root, offset, minimum, maximum, guard, truth) {
            1 -> return 1
            _ -> preserved()
        }
    }
    state preserved() {
        transition self.preserve_entry_place(state_index, before, root, offset) {
            1 -> contract(0)
            _ -> return 0
        }
    }
    state contract(index: i32) {
        transition index < self.bound_count[state_index] {
            true -> bound(index, self.entry_bounds[self.bound_first[state_index] + index])
            _ -> return 0
        }
    }
    state bound(index: i32, bound: OmegaEntryBound) {
        transition bound.kind {
            OmegaEntryBoundKind::Interval -> interval(index, bound)
            _ -> contract(index + 1)
        }
    }
    state interval(index: i32, bound: OmegaEntryBound) {
        transition (bound.root == root) && (bound.offset == offset) &&
            (bound.minimum >= minimum) &&
            ((maximum < 0) || ((bound.maximum >= 0) && (bound.maximum <= maximum))) {
            true -> return 1
            _ -> contract(index + 1)
        }
    }
}

// Only pure expressions contribute reusable guard facts. In particular,
// `bound && mutating_call()` cannot retain the earlier bound at the call edge.
machine OmegaScalarCompiler::pure_value(&mut self, expression: i32) -> i32 {
    transition self.parser.expressions[expression].kind {
        OmegaExpressionKind::Path -> return 1
        OmegaExpressionKind::String -> return 1
        OmegaExpressionKind::Integer -> return 1
        OmegaExpressionKind::Boolean -> return 1
        OmegaExpressionKind::Borrow -> return self.pure_value(self.parser.expressions[expression].payload0)
        OmegaExpressionKind::Cast -> return self.pure_value(self.parser.cast_expressions[self.parser.expressions[expression].payload0].value)
        OmegaExpressionKind::Unary -> return self.pure_value(self.parser.unary_expressions[self.parser.expressions[expression].payload0].operand)
        OmegaExpressionKind::Binary -> binary(self.parser.binary_expressions[self.parser.expressions[expression].payload0])
        OmegaExpressionKind::Indexed -> indexed(self.parser.indexed_expressions[self.parser.expressions[expression].payload0])
        OmegaExpressionKind::Range -> range(self.parser.range_expressions[self.parser.expressions[expression].payload0])
        _ -> return 0
    }
    state range(row: OmegaRangeExpressionSyntax) {
        return ((row.has_start == 0) || (self.pure_value(row.start) == 1)) &&
            ((row.has_end == 0) || (self.pure_value(row.end) == 1));
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition (self.pure_value(row.left) == 1) && (self.pure_value(row.right) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
    state indexed(row: OmegaIndexedExpressionSyntax) {
        transition (self.pure_value(row.base) == 1) && (self.pure_value(row.index) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Reusing the guard requires every expression evaluated in this target
// to preserve it, including arguments evaluated before the indexed read.
machine OmegaScalarCompiler::pure_transition_target(&mut self, row: OmegaTransitionStatementSyntax) -> i32 {
    transition row.target_kind {
        OmegaTransitionTargetKind::Result -> return self.pure_value(row.result_expression)
        OmegaTransitionTargetKind::Machine -> return self.pure_arguments(row.first_argument, row.argument_count)
        OmegaTransitionTargetKind::Terminal -> return 1
    }
}
machine OmegaScalarCompiler::pure_arguments(&mut self, first: i32, count: i32) -> i32 {
    transition true { true -> next(0) }
    state next(offset: i32) {
        transition offset < count {
            true -> argument(offset)
            _ -> return 1
        }
    }
    state argument(offset: i32) {
        transition self.pure_value(self.parser.call_arguments[first + offset]) {
            1 -> next(offset + 1)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::preserve_entry_place(&mut self, state_index: i32, before: i32, root: i32, offset: i32) -> i32 {
    transition self.entry_effects_preserve(state_index, before, root, offset) {
        1 -> next(0)
        _ -> return 0
    }
    state next(cursor: i32) {
        transition cursor < before {
            true -> statement(cursor, self.parser.statements[self.parser.machine_states[self.local_state_row(state_index)].first_statement + cursor])
            _ -> return 1
        }
    }
    state statement(cursor: i32, row: OmegaStatementSyntax) {
        transition row.kind {
            OmegaStatementKind::LocalData -> next(cursor + 1)
            OmegaStatementKind::Call -> next(cursor + 1)
            OmegaStatementKind::Assignment -> target(cursor, self.parser.assignment_statements[row.item_index].target)
            _ -> return 0
        }
    }
    state target(cursor: i32, target: i32) {
        transition (self.place_roots[target] != root) ||
            (self.place_offsets[target] + self.place_extent[target] <= offset) ||
            (offset + 8 <= self.place_offsets[target]) {
            true -> next(cursor + 1)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::guard_place(&mut self, expression: i32, root: i32, offset: i32) -> i32 {
    transition self.value_kinds[expression] {
        OmegaCheckedValueKind::RepresentationCast -> return self.guard_place(self.value_payloads[expression], root, offset)
        OmegaCheckedValueKind::Place -> place()
        _ -> return 0
    }
    state place() {
        transition (self.place_roots[expression] == root) && (self.place_offsets[expression] == offset) &&
            (self.place_extent[expression] == 8) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::guard_bound(&mut self, root: i32, offset: i32, minimum: i32, maximum: i32, expression: i32, truth: i32) -> i32 {
    transition expression >= 0 {
        true -> value()
        _ -> return 0
    }
    state value() {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::LogicalNot -> return self.guard_bound(root, offset, minimum, maximum, self.value_payloads[expression], 1 - truth)
            OmegaCheckedValueKind::SignedComparison -> binary(self.parser.binary_expressions[self.value_payloads[expression]])
            OmegaCheckedValueKind::BooleanBinary -> binary(self.parser.binary_expressions[self.value_payloads[expression]])
            _ -> return 0
        }
    }
    state binary(row: OmegaBinaryExpressionSyntax) {
        transition row.operator {
            OmegaBinaryOperatorKind::And -> conjunction(row)
            OmegaBinaryOperatorKind::Or -> disjunction(row)
            OmegaBinaryOperatorKind::Less -> less(row)
            OmegaBinaryOperatorKind::LessEqual -> less_equal(row)
            OmegaBinaryOperatorKind::Greater -> greater(row)
            OmegaBinaryOperatorKind::GreaterEqual -> greater_equal(row)
            OmegaBinaryOperatorKind::Equal -> equality(row, truth)
            OmegaBinaryOperatorKind::NotEqual -> equality(row, 1 - truth)
            _ -> return 0
        }
    }
    state conjunction(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> either(row, 1) _ -> both(row, 0) }
    }
    state disjunction(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> both(row, 1) _ -> either(row, 0) }
    }
    state either(row: OmegaBinaryExpressionSyntax, value: i32) {
        transition (self.guard_bound(root, offset, minimum, maximum, row.left, value) == 1) ||
            (self.guard_bound(root, offset, minimum, maximum, row.right, value) == 1) {
            true -> return 1 _ -> return 0
        }
    }
    state both(row: OmegaBinaryExpressionSyntax, value: i32) {
        transition (self.guard_bound(root, offset, minimum, maximum, row.left, value) == 1) &&
            (self.guard_bound(root, offset, minimum, maximum, row.right, value) == 1) {
            true -> return 1 _ -> return 0
        }
    }
    state less(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.left, row.right, 1) _ -> compare(row.right, row.left, 0) }
    }
    state less_equal(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.left, row.right, 0) _ -> compare(row.right, row.left, 1) }
    }
    state greater(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.right, row.left, 1) _ -> compare(row.left, row.right, 0) }
    }
    state greater_equal(row: OmegaBinaryExpressionSyntax) {
        transition truth { 1 -> compare(row.right, row.left, 0) _ -> compare(row.left, row.right, 1) }
    }
    state equality(row: OmegaBinaryExpressionSyntax, matched: i32) {
        transition matched { 1 -> equal_sides(row) _ -> return 0 }
    }
    state equal_sides(row: OmegaBinaryExpressionSyntax) {
        transition self.guard_bound_pair(root, offset, minimum, maximum, row.left, row.right, 0) {
            1 -> return 1 _ -> compare(row.right, row.left, 0)
        }
    }
    state compare(subject: i32, other: i32, strict: i32) {
        return self.guard_bound_pair(root, offset, minimum, maximum, subject, other, strict);
    }
}

machine OmegaScalarCompiler::guard_bound_pair(&mut self, root: i32, offset: i32, minimum: i32, maximum: i32, subject: i32, other: i32, strict: i32) -> i32 {
    // Normal form: subject < other (strict = 1) or subject <= other.
    transition self.guard_place(subject, root, offset) {
        1 -> ceiling()
        _ -> right_place()
    }
    state ceiling() {
        transition self.value_kinds[other] {
            OmegaCheckedValueKind::Literal -> ceiling_literal(self.value_payloads[other])
            OmegaCheckedValueKind::Place -> ceiling_field(self.place_fields[other])
            OmegaCheckedValueKind::ProjectedRead -> ceiling_field(self.value_payloads[other])
            _ -> return 0
        }
    }
    state ceiling_literal(value: i32) {
        transition (minimum <= 0) && (maximum >= 0) && (value >= strict) &&
            (value - strict <= maximum) { true -> return 1 _ -> return 0 }
    }
    // A live unsigned field remains below its checked data invariant. This
    // projects that upper bound through the current pure comparison guard.
    state ceiling_field(field: i32) {
        let kind: i32 = self.cell_types[49152 + other];
        transition (field >= 0) && ((kind == 64) ||
            ((self.is_policy_word(kind) == 1) && (kind % 256 == 64))) {
            true -> ceiling_literal(self.field_upper_bounds[field])
            _ -> return 0
        }
    }
    state right_place() {
        transition self.guard_place(other, root, offset) {
            1 -> floor()
            _ -> return 0
        }
    }
    state floor() {
        transition self.value_kinds[subject] {
            OmegaCheckedValueKind::Literal -> floor_literal(self.value_payloads[subject])
            _ -> return 0
        }
    }
    state floor_literal(value: i32) {
        // Compare before adding one, including at INT_MAX.
        transition (maximum < 0) && (value >= 0) && (value >= minimum - strict) {
            true -> return 1 _ -> return 0
        }
    }
}

// Actual arguments must preserve every fact used to prove this arrival. A
// call in the selected condition may already have run. Discard its Boolean
// evidence; each entry-bound proof still checks the writes recorded so far.
machine OmegaScalarCompiler::check_call_bounds(
    &mut self, source: &[u8], state_index: i32, before: i32,
    first_argument: i32, count: i32, target: i32, guard: i32, truth: i32
) -> i32 {
    transition self.bound_count[target] == 0 { true -> return 1 _ -> arguments() }
    state arguments() {
        transition self.pure_arguments(first_argument, count) {
            1 -> condition()
            _ -> unsupported()
        }
    }
    state condition() {
        transition (guard >= 0) && (self.pure_value(guard) == 0) {
            true -> return self.prove_call_bounds(source, state_index, before, first_argument, count, target, -1, 0)
            _ -> return self.prove_call_bounds(source, state_index, before, first_argument, count, target, guard, truth)
        }
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::prove_call_bounds(
    &mut self, source: &[u8], state_index: i32, before: i32,
    first_argument: i32, count: i32, target: i32, guard: i32, truth: i32
) -> i32 {
    transition true { true -> requirement(0) }
    state requirement(index: i32) {
        transition index < self.bound_count[target] {
            true -> actual(index, self.entry_bounds[self.bound_first[target] + index])
            _ -> return 1
        }
    }
    state actual(index: i32, bound: OmegaEntryBound) {
        let offset: i32 = bound.root - self.state_first_parameter(target);
        transition (offset >= 0) && (offset < count) {
            true -> argument(index, bound, self.parser.call_arguments[first_argument + offset])
            _ -> unsupported()
        }
    }
    state argument(index: i32, bound: OmegaEntryBound, argument: i32) {
        transition bound.kind {
            OmegaEntryBoundKind::Interval -> scalar_or_reference(index, bound, argument)
            OmegaEntryBoundKind::StrictOrder -> pair(index, bound, argument, 1)
            OmegaEntryBoundKind::InclusiveOrder -> pair(index, bound, argument, 0)
        }
    }
    state pair(index: i32, bound: OmegaEntryBound, argument: i32, strict: i32) {
        let offset: i32 = bound.right - self.state_first_parameter(target);
        transition (offset >= 0) && (offset < count) {
            true -> order(index, argument, self.parser.call_arguments[first_argument + offset], bound.right_offset, strict)
            _ -> unsupported()
        }
    }
    state order(index: i32, left: i32, right: i32, offset: i32, strict: i32) {
        transition offset {
            0 -> proved_order(index, self.prove_actual_scalar_order(source, state_index, before, left, right, guard, truth, strict))
            8 -> proved_order(index, self.prove_actual_slice_index(source, state_index, before, left, right, guard, truth, strict))
            _ -> unsupported()
        }
    }
    state proved_order(index: i32, proved: i32) {
        transition proved { 1 -> requirement(index + 1) _ -> unsupported() }
    }
    state scalar_or_reference(index: i32, bound: OmegaEntryBound, argument: i32) {
        transition self.parameter_types[bound.root] >= 400000 {
            true -> reference(index, bound, argument)
            _ -> scalar(index, bound, argument)
        }
    }
    state scalar(index: i32, bound: OmegaEntryBound, argument: i32) {
        transition self.prove_bound(source, state_index, before, argument, bound.minimum, bound.maximum, guard, truth) {
            1 -> requirement(index + 1)
            _ -> unsupported()
        }
    }
    state reference(index: i32, bound: OmegaEntryBound, argument: i32) {
        transition self.parameter_types[bound.root] == omega_shared_byte_slice() {
            true -> slice(index, bound, argument)
            _ -> record(index, bound, argument)
        }
    }
    state slice(index: i32, bound: OmegaEntryBound, argument: i32) {
        transition bound.offset == 8 {
            true -> length(index, bound, argument)
            _ -> unsupported()
        }
    }
    state length(index: i32, bound: OmegaEntryBound, argument: i32) {
        transition self.value_kinds[argument] {
            OmegaCheckedValueKind::QuotedBytes -> known(index, bound, self.parser.expressions[argument].payload2)
            OmegaCheckedValueKind::SharedByteRange -> known(index, bound, self.byte_ranges[argument].length)
            OmegaCheckedValueKind::ForwardedReference -> forward(index, bound, self.value_payloads[argument])
            _ -> unsupported()
        }
    }
    state known(index: i32, bound: OmegaEntryBound, length: i32) {
        transition (length >= bound.minimum) && ((bound.maximum < 0) || (length <= bound.maximum)) {
            true -> requirement(index + 1)
            _ -> unsupported()
        }
    }
    state forward(index: i32, bound: OmegaEntryBound, slot: i32) {
        transition self.prove_place_bound(source, state_index, before, slot, 8, -1, 64,
            bound.minimum, bound.maximum, guard, truth) {
            1 -> requirement(index + 1)
            _ -> unsupported()
        }
    }
    state record(index: i32, bound: OmegaEntryBound, argument: i32) {
        transition self.value_kinds[argument] {
            OmegaCheckedValueKind::Borrow -> referent(index, bound, self.value_payloads[argument])
            OmegaCheckedValueKind::ForwardedReference -> referent(index, bound, argument)
            _ -> unsupported()
        }
    }
    state referent(index: i32, bound: OmegaEntryBound, place: i32) {
        let field: i32 = bound.field;
        transition field >= 0 {
            true -> field_bound(index, bound, place, field)
            _ -> unsupported()
        }
    }
    state field_bound(index: i32, bound: OmegaEntryBound, place: i32, field: i32) {
        transition self.prove_place_bound(source, state_index, before,
            self.place_roots[place], self.place_offsets[place] + bound.offset,
            field, self.field_types[field], bound.minimum, bound.maximum, guard, truth) {
            1 -> requirement(index + 1)
            _ -> unsupported()
        }
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

// Ordinary calls cannot mutate ambient storage in this profile. Each admitted
// exclusive argument identifies its complete possible mutation range. Retain
// that event as soon as the call finishes checking, so later operands in the
// same expression cannot reuse an earlier entry fact about that range.
machine OmegaScalarCompiler::retain_call_effects(
    &mut self, state_index: i32, before: i32, first_argument: i32, count: i32, first_parameter: i32
) -> i32 {
    transition true { true -> next(0) }
    state next(index: i32) {
        transition index < count {
            true -> argument(index, self.parser.call_arguments[first_argument + index])
            _ -> return 1
        }
    }
    state argument(index: i32, expression: i32) {
        transition self.parameter_types[first_parameter + index] >= 500000 {
            true -> borrowed(index, expression)
            _ -> next(index + 1)
        }
    }
    state borrowed(index: i32, expression: i32) {
        transition self.value_kinds[expression] {
            OmegaCheckedValueKind::Borrow -> capacity(index, self.value_payloads[expression])
            OmegaCheckedValueKind::ForwardedReference -> capacity(index, expression)
            _ -> unsupported()
        }
    }
    state capacity(index: i32, place: i32) {
        transition self.effect_count < 16384 {
            true -> retain(index, place)
            _ -> unsupported()
        }
    }
    state retain(index: i32, place: i32) {
        self.effect_states[self.effect_count] = state_index;
        self.effect_befores[self.effect_count] = before;
        self.effect_roots[self.effect_count] = self.place_roots[place];
        self.effect_offsets[self.effect_count] = self.place_offsets[place];
        self.effect_sizes[self.effect_count] = self.place_extent[place];
        self.effect_count = self.effect_count + 1;
        transition true { true -> next(index + 1) }
    }
    state unsupported() { self.record_incomplete(4, self.diagnostic_offset); return 0; }
}

machine OmegaScalarCompiler::entry_effects_preserve(
    &mut self, state_index: i32, before: i32, root: i32, offset: i32
) -> i32 {
    transition true { true -> next(0) }
    state next(index: i32) {
        transition index < self.effect_count {
            true -> event(index)
            _ -> return 1
        }
    }
    state event(index: i32) {
        transition (self.effect_states[index] == state_index) &&
            (self.effect_befores[index] <= before) && (self.effect_roots[index] == root) &&
            (self.effect_offsets[index] < offset + 8) &&
            (offset < self.effect_offsets[index] + self.effect_sizes[index]) {
            true -> return 0
            _ -> next(index + 1)
        }
    }
}

// Inputs are a in r0 and b in r2. Zero and one always fit. Once those
// cases are excluded, a set sign bit on either unsigned factor means overflow.
machine OmegaScalarCompiler::emit_checked_u64_product(&mut self, trap: i32) -> i32 {
    let multiply: i32 = self.tape.new_label();
    let compare: i32 = self.tape.new_label();
    transition (multiply >= 0) && (compare >= 0) &&
        (self.tape.emit_rx_label(13, 0, multiply) == 1) &&
        (self.tape.emit_rx_label(13, 2, multiply) == 1) &&
        (self.tape.emit_imm(1, 1, 0) == 1) &&
        (self.tape.emit_rrx_label(16, 0, 1, multiply) == 1) &&
        (self.tape.emit_rrx_label(16, 2, 1, multiply) == 1) &&
        (self.tape.emit_rrx_label(15, 0, 1, trap) == 1) &&
        (self.tape.emit_rrx_label(15, 2, 1, trap) == 1) {
        true -> limit(multiply, compare)
        _ -> return 0
    }
    // Alpha divides signed words. For M = 2^63-1, let M = q*b + r.
    // Then (2*M+1)/b rounds down to 2*q plus one if r >= floor(b/2).
    // Both factors now lie in [2,M], so that limit also fits a signed word.
    state limit(multiply: i32, compare: i32) {
        transition (self.tape.emit_imm(3, -1, 2147483647) == 1) &&
            (self.tape.emit_rr(2, 4, 3) == 1) &&
            (self.tape.emit_rr(6, 3, 2) == 1) &&
            (self.tape.emit_rr(7, 4, 2) == 1) &&
            (self.tape.emit_rr(3, 3, 3) == 1) &&
            (self.tape.emit_rr(2, 5, 2) == 1) &&
            (self.tape.emit_imm(1, 2, 0) == 1) &&
            (self.tape.emit_rr(6, 5, 1) == 1) &&
            (self.tape.emit_rrx_label(15, 4, 5, compare) == 1) &&
            (self.tape.emit_imm(1, 1, 0) == 1) &&
            (self.tape.emit_rr(3, 3, 1) == 1) {
            true -> product(multiply, compare)
            _ -> return 0
        }
    }
    state product(multiply: i32, compare: i32) {
        return (self.tape.define_label(compare) == 1) &&
            (self.tape.emit_rrx_label(15, 3, 0, trap) == 1) &&
            (self.tape.define_label(multiply) == 1) &&
            (self.tape.emit_rr(5, 0, 2) == 1);
    }
}

// Each admitted Trapping primitive owns its overflow check and trap site.
// Operands evaluate once, left to right; the expression's private scratch saves
// the left value across a call or mutation in the right operand. u32 products
// fit a full Alpha word before the explicit u32 range check. For u64, check
// the maximum permitted factor before emitting the modular Alpha multiply.
machine OmegaScalarCompiler::emit_trapping_arithmetic(
    &mut self, expression: i32, row: OmegaBinaryExpressionSyntax
) -> i32 {
    self.emission_resource = 14;
    let trap: i32 = self.tape.new_label();
    let complete: i32 = self.tape.new_label();
    transition (trap >= 0) && (complete >= 0) {
        true -> operands(trap, complete)
        _ -> return 0
    }
    state operands(trap: i32, complete: i32) {
        self.emission_resource = 12;
        transition (self.emit_word_operands(expression, row) == 1) {
            true -> operation(trap, complete)
            _ -> return 0
        }
    }
    state operation(trap: i32, complete: i32) {
        transition row.operator {
            OmegaBinaryOperatorKind::Add -> add(trap, complete)
            OmegaBinaryOperatorKind::Subtract -> subtract(trap, complete)
            OmegaBinaryOperatorKind::Multiply -> multiply(trap, complete)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state add(trap: i32, complete: i32) {
        // Save the original left word; a wrapped u64 sum is less than it.
        transition (self.tape.emit_rr(2, 4, 0) == 1) &&
            (self.tape.emit_rr(3, 0, 2) == 1) {
            true -> add_carrier(trap, complete, self.cell_types[49152 + expression])
            _ -> return 0
        }
    }
    state add_carrier(trap: i32, complete: i32, kind: i32) {
        transition kind {
            288 -> u32_result(trap, complete)
            320 -> u64_sum(trap, complete)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state u64_sum(trap: i32, complete: i32) {
        transition (self.tape.emit_rr(2, 2, 4) == 1) &&
            (self.emit_unsigned_less_to(0, 2, trap) == 1) {
            true -> finish(trap, complete)
            _ -> return 0
        }
    }
    state subtract(trap: i32, complete: i32) {
        // Underflow is exactly left < right for either unsigned carrier.
        transition (self.emit_unsigned_less_to(0, 2, trap) == 1) &&
            (self.tape.emit_rr(4, 0, 2) == 1) {
            true -> finish(trap, complete)
            _ -> return 0
        }
    }
    state multiply(trap: i32, complete: i32) {
        transition self.cell_types[49152 + expression] {
            288 -> u32_product(trap, complete)
            320 -> u64_product(trap, complete)
            _ -> return self.tape.fail_internal(expression)
        }
    }
    state u64_product(trap: i32, complete: i32) {
        transition self.emit_checked_u64_product(trap) {
            1 -> finish(trap, complete)
            _ -> return 0
        }
    }
    state u32_product(trap: i32, complete: i32) {
        transition self.tape.emit_rr(5, 0, 2) {
            1 -> u32_result(trap, complete)
            _ -> return 0
        }
    }
    state u32_result(trap: i32, complete: i32) {
        // The low immediate word is all ones; its high word remains zero.
        transition (self.tape.emit_imm(2, -1, 0) == 1) &&
            (self.emit_unsigned_less_to(2, 0, trap) == 1) {
            true -> finish(trap, complete)
            _ -> return 0
        }
    }
    state finish(trap: i32, complete: i32) {
        transition (self.tape.emit_jump_label(12, complete) == 1) &&
            (self.tape.define_label(trap) == 1) &&
            (self.emit_trap() == 1) &&
            (self.tape.define_label(complete) == 1) {
            true -> return 1
            _ -> return 0
        }
    }
}

// Alpha division by zero realizes an abnormal Trap with no normal return.
machine OmegaScalarCompiler::emit_trap(&mut self) -> i32 {
    transition self.tape.emit_imm(1, 0, 0) {
        1 -> return self.tape.emit_rr(6, 0, 1)
        _ -> return 0
    }
}

// Branch on unsigned left < right without changing either operand. Callers
// supply r0/r2; r3/r4/r5 are private scratch. Adding 2^63 to each word maps
// unsigned order bijectively to Alpha's signed comparison order.
machine OmegaScalarCompiler::emit_unsigned_less_to(
    &mut self, left: i32, right: i32, target: i32
) -> i32 {
    transition (self.tape.emit_imm(3, 0, -2147483648) == 1) &&
        (self.tape.emit_rr(2, 4, left) == 1) &&
        (self.tape.emit_rr(2, 5, right) == 1) &&
        (self.tape.emit_rr(3, 4, 3) == 1) &&
        (self.tape.emit_rr(3, 5, 3) == 1) &&
        (self.tape.emit_rrx_label(15, 4, 5, target) == 1) {
        true -> return 1
        _ -> return 0
    }
}

// Alpha HALT ends this one simulated process with the low 32 bits of its signed
// status. Its operand is evaluated once and has no normal successor.
machine OmegaScalarCompiler::emit_process_terminal(&mut self, argument: i32) -> i32 {
    return (self.emit_value(argument) == 1) && (self.tape.emit_r(0, 0) == 1);
}
