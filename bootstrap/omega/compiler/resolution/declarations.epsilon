// Declarations retain their syntax-arena identity across source units. Lookup
// uses exact file names, direct package edges and declaration visibility.
// The admitted profile still has free machines and copy records: attached declarations and overload families remain unsupported.
machine OmegaScalarCompiler::declaration_count(&mut self, kind: OmegaDeclarationKind) -> i32 {
    transition kind {
        OmegaDeclarationKind::Data -> return self.parser.data_count
        OmegaDeclarationKind::Machine -> return self.parser.machine_count
        OmegaDeclarationKind::Service -> return self.parser.boundary_trait_count
        OmegaDeclarationKind::BoundaryMachine -> return self.parser.boundary_machine_count
        OmegaDeclarationKind::Implementation -> return self.parser.implementation_count
    }
}

machine OmegaScalarCompiler::declaration_name(
    &mut self, kind: OmegaDeclarationKind, index: i32
) -> OmegaRelativeSpan {
    transition kind {
        OmegaDeclarationKind::Data -> record_name()
        OmegaDeclarationKind::Service -> return self.parser.boundary_traits[index].name
        OmegaDeclarationKind::BoundaryMachine -> return self.parser.members[self.parser.owned_machines[self.parser.boundary_machines[index]].first_path_member]
        OmegaDeclarationKind::Implementation -> return self.parser.implementations[index].name
        OmegaDeclarationKind::Machine -> machine_name()
    }
    state record_name() {
        transition self.construction.active {
            1 -> return self.construction.types[index].name
            _ -> return self.parser.data_items[index].name
        }
    }
    state machine_name() {
        transition self.construction.active {
            1 -> return self.construction.machines[index].name
            _ -> return self.parser.members[self.parser.machine_items[index].first_path_member]
        }
    }
}

machine OmegaScalarCompiler::declaration_public(
    &mut self, kind: OmegaDeclarationKind, index: i32
) -> i32 {
    transition kind {
        OmegaDeclarationKind::Data -> record_visibility()
        OmegaDeclarationKind::Service -> return self.parser.boundary_traits[index].is_public
        OmegaDeclarationKind::BoundaryMachine -> return self.parser.owned_machines[self.parser.boundary_machines[index]].is_public
        OmegaDeclarationKind::Implementation -> return self.parser.implementations[index].is_public
        OmegaDeclarationKind::Machine -> machine_visibility()
    }
    state record_visibility() {
        transition self.construction.active {
            1 -> return self.construction.types[index].is_public
            _ -> return self.parser.data_items[index].is_public
        }
    }
    state machine_visibility() {
        transition self.construction.active {
            1 -> return self.construction.machines[index].is_public
            _ -> return self.parser.machine_items[index].is_public
        }
    }
}

// Classify a parsed declaration reference for the construction Build checker.
// A file-qualified name occupies a single member before any static selection.
machine OmegaScalarCompiler::read_query(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    transition (start >= 0) && (start < end) && (end <= source.len) {
        true -> first()
        _ -> return 0
    }
    state first() {
        self.parser.cursor = start;
        transition self.parser.scan_significant_token(source[0..end]) {
            OmegaParserScanResult::Token -> named()
            _ -> return 0
        }
    }
    state named() {
        transition self.parser.reference_token(source[0..end]) {
            OmegaTokenKind::Identifier -> suffix()
            OmegaTokenKind::Keyword -> suffix()
            _ -> return 0
        }
    }
    state suffix() {
        self.parser.cursor = self.parser.scan.next_cursor;
        transition self.parser.scan_significant_token(source[0..end]) {
            OmegaParserScanResult::Token -> separator()
            OmegaParserScanResult::End -> return 1
            _ -> return 0
        }
    }
    state separator() {
        transition self.parser.scan.span_equals(source, self.parser.scan.token_start, self.parser.scan.token_end, "::") {
            1 -> return 2
            _ -> return 0
        }
    }
}

// File qualifiers select from the exact imported file. A bare declaration
// name belongs to the source unit containing that occurrence.
machine OmegaScalarCompiler::resolve_declaration(
    &mut self, source: &[u8], start: i32, end: i32, kind: OmegaDeclarationKind
) -> i32 {
    let unit: i32 = self.parser.sources.unit_at(start);
    transition (unit >= 0) && (start >= 0) && (start < end) && (end <= source.len) {
        true -> reference(unit)
        _ -> return -1
    }
    state reference(unit: i32) {
        transition source[start] == '|' {
            true -> selected_file(unit)
            _ -> bare(unit)
        }
    }
    state selected_file(unit: i32) {
        transition (self.parser.file_selected_name(source[0..end], start) == 1) && (self.parser.scan.token_end == end) {
            true -> return self.file_declaration(source, unit, self.parser.selector_alias, self.parser.selector_member, kind)
            _ -> return -1
        }
    }
    state bare(unit: i32) {
        return self.unit_declaration(source, unit, unit, start, end, kind);
    }
}

machine OmegaScalarCompiler::validate_imports(&mut self, source: &[u8], build_unit: i32) -> i32 {
    transition true { true -> import(0) }
    state import(index: i32) {
        transition index < self.parser.use_count {
            true -> address(index, self.parser.uses[index])
            _ -> return 1
        }
    }
    state address(index: i32, row: OmegaUseSyntax) {
        let owner: i32 = self.parser.sources.unit_at(row.start);
        transition (owner >= 0) && ((self.imported_file(source, row, owner) >= 0) ||
            ((owner == build_unit) && (self.build_dependency_import(source, row) == 1))) {
            true -> prior(index, row, 0)
            _ -> fail(row.start)
        }
    }
    state prior(index: i32, row: OmegaUseSyntax, previous: i32) {
        transition previous < index {
            true -> prior_name(index, row, previous, self.parser.uses[previous])
            _ -> import(index + 1)
        }
    }
    state prior_name(index: i32, row: OmegaUseSyntax, previous: i32, other: OmegaUseSyntax) {
        transition (self.parser.sources.unit_at(row.start) == self.parser.sources.unit_at(other.start)) &&
            (self.parser.sources.equal_name(source,
                self.parser.members[row.first_member + row.member_count - 1],
                self.parser.members[other.first_member + other.member_count - 1]) == 1) {
            true -> fail(row.start)
            _ -> prior(index, row, previous + 1)
        }
    }
    state fail(offset: i32) { self.record_reject(-1, 4, offset); return 0; }
}

machine OmegaScalarCompiler::call_has_static_target(&mut self, call: OmegaCallExpressionSyntax) -> i32 {
    transition call.has_receiver {
        0 -> return 1
        _ -> receiver(self.parser.expressions[call.receiver])
    }
    state receiver(row: OmegaExpressionSyntax) {
        transition row.path_kind {
            OmegaPathExpressionKind::Name -> return call.name_member_count == row.payload1 + 1
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::resolve_call_machine(
    &mut self, source: &[u8], call: OmegaCallExpressionSyntax
) -> i32 {
    transition call.has_receiver {
        0 -> return self.resolve_machine(source, call.target.start, call.target.end)
        _ -> receiver(self.parser.expressions[call.receiver])
    }
    state receiver(row: OmegaExpressionSyntax) {
        transition row.path_kind {
            OmegaPathExpressionKind::Name -> named(row)
            _ -> return -1
        }
    }
    state named(row: OmegaExpressionSyntax) {
        transition call.name_member_count == row.payload1 + 1 {
            true -> return self.resolve_machine(source,
                self.parser.members[row.payload0].start, call.target.end)
            _ -> return -1
        }
    }
}

// Exported signatures cannot make private nominal declarations into a public
// naming surface. Qualifier/body proof machinery is still checked in its owner;
// this additional boundary concerns structural field and call-interface types.
machine OmegaScalarCompiler::public_type(&mut self, source: &[u8], index: i32) -> i32 {
    let row: OmegaTypeReferenceSyntax = self.parser.type_references[index];
    transition row.kind {
        OmegaTypeReferenceKind::Named -> named(row)
        OmegaTypeReferenceKind::Unit -> return 1
        OmegaTypeReferenceKind::Reference -> return self.public_type(source, row.payload0)
        OmegaTypeReferenceKind::FixedArray -> return self.public_type(source, row.payload0)
        OmegaTypeReferenceKind::Slice -> return self.public_type(source, row.payload0)
        OmegaTypeReferenceKind::Constrained -> return self.public_type(source, row.payload0)
        _ -> return 0
    }
    state named(row: OmegaTypeReferenceSyntax) {
        transition self.primitive_type(source, index) > 0 {
            true -> return 1
            _ -> record(self.resolve_data(source, row.payload0, row.payload1))
        }
    }
    state record(data_index: i32) {
        transition data_index >= 0 {
            true -> return self.parser.data_items[data_index].is_public
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::check_public_interfaces(&mut self, source: &[u8]) -> i32 {
    transition true { true -> record(0) }
    state record(index: i32) {
        transition index < self.parser.data_count {
            true -> record_visibility(index)
            _ -> machine_item(0)
        }
    }
    state record_visibility(index: i32) {
        transition self.select_construction_unit(source, self.construction.types[index].unit) {
            1 -> loaded_record(index)
            _ -> return 0
        }
    }
    state loaded_record(index: i32) {
        transition self.parser.data_items[index].is_public {
            1 -> field(index, 0)
            _ -> record(index + 1)
        }
    }
    state field(index: i32, offset: i32) {
        transition offset < self.parser.data_items[index].field_count {
            true -> field_type(index, offset, self.parser.data_fields[self.parser.data_items[index].first_field + offset])
            _ -> public_cases(index, 0)
        }
    }
    state field_type(index: i32, offset: i32, row: OmegaDataFieldSyntax) {
        transition self.public_type(source, row.type_reference) {
            1 -> field(index, offset + 1)
            _ -> fail(row.start)
        }
    }
    state public_cases(index: i32, offset: i32) {
        transition offset < self.parser.data_items[index].case_count {
            true -> public_case(index, offset, self.parser.data_cases[self.parser.data_items[index].first_case + offset])
            _ -> record(index + 1)
        }
    }
    state public_case(index: i32, offset: i32, row: OmegaDataCaseSyntax) {
        transition true { true -> payloads(index, offset, row.first_payload_field, row.first_payload_field + row.payload_field_count) }
    }
    state payloads(index: i32, offset: i32, slot: i32, limit: i32) {
        transition slot < limit {
            true -> payload_type(index, offset, slot, limit, self.parser.data_payload_fields[slot])
            _ -> public_cases(index, offset + 1)
        }
    }
    state payload_type(index: i32, offset: i32, slot: i32, limit: i32, row: OmegaDataFieldSyntax) {
        transition self.public_type(source, row.type_reference) {
            1 -> payloads(index, offset, slot + 1, limit)
            _ -> fail(row.start)
        }
    }
    state machine_item(index: i32) {
        transition index < self.parser.machine_count {
            true -> machine_visibility(index)
            _ -> return 1
        }
    }
    state machine_visibility(index: i32) {
        transition self.select_construction_unit(source, self.construction.machines[index].unit) {
            1 -> loaded_machine(index)
            _ -> return 0
        }
    }
    state loaded_machine(index: i32) {
        transition self.parser.machine_items[index].is_public {
            1 -> signature(index, self.parser.machine_items[index].first_state)
            _ -> machine_item(index + 1)
        }
    }
    state signature(index: i32, state_index: i32) {
        transition self.parser.machine_states[self.local_state_row(state_index)].has_return_type {
            1 -> result(index, state_index)
            _ -> parameter(index, state_index, 0)
        }
    }
    state result(index: i32, state_index: i32) {
        transition self.public_type(source, self.parser.machine_states[self.local_state_row(state_index)].return_type) {
            1 -> parameter(index, state_index, 0)
            _ -> fail(self.parser.machine_items[index].start)
        }
    }
    state parameter(index: i32, state_index: i32, offset: i32) {
        transition offset < self.state_parameter_count(state_index) {
            true -> parameter_type(index, state_index, offset,
                self.parser.machine_parameters[self.parameter_syntax_row(self.state_first_parameter(state_index) + offset)])
            _ -> machine_item(index + 1)
        }
    }
    state parameter_type(index: i32, state_index: i32, offset: i32, row: OmegaMachineParameterSyntax) {
        transition self.public_type(source, row.type_reference) {
            1 -> parameter(index, state_index, offset + 1)
            _ -> fail(row.name.start)
        }
    }
    state fail(offset: i32) { self.record_reject(-1, 4, offset); return 0; }
}

// Explicit field lifetimes belong to the declaring data, including those in
// sum payloads. Match the target's arity separately from each tag's owner.
machine OmegaScalarCompiler::check_data_lifetimes(&mut self, source: &[u8]) -> i32 {
    transition true { true -> item(0) }
    state item(index: i32) {
        transition index < self.parser.data_count {
            true -> direct(index, self.parser.data_items[index], 0)
            _ -> return 1
        }
    }
    state direct(index: i32, owner: OmegaDataSyntax, offset: i32) {
        transition offset < owner.field_count {
            true -> direct_type(index, owner, offset)
            _ -> cases(index, owner, 0)
        }
    }
    state direct_type(index: i32, owner: OmegaDataSyntax, offset: i32) {
        transition self.check_field_lifetimes(source, owner, self.parser.data_fields[owner.first_field + offset].type_reference) {
            1 -> direct(index, owner, offset + 1)
            _ -> return 0
        }
    }
    state cases(index: i32, owner: OmegaDataSyntax, offset: i32) {
        transition offset < owner.case_count {
            true -> payload(index, owner, offset, self.parser.data_cases[owner.first_case + offset], 0)
            _ -> item(index + 1)
        }
    }
    state payload(index: i32, owner: OmegaDataSyntax, offset: i32, row: OmegaDataCaseSyntax, field: i32) {
        transition field < row.payload_field_count {
            true -> payload_type(index, owner, offset, row, field)
            _ -> cases(index, owner, offset + 1)
        }
    }
    state payload_type(index: i32, owner: OmegaDataSyntax, offset: i32, row: OmegaDataCaseSyntax, field: i32) {
        transition self.check_field_lifetimes(source, owner, self.parser.data_payload_fields[row.first_payload_field + field].type_reference) {
            1 -> payload(index, owner, offset, row, field + 1)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::check_field_lifetimes(
    &mut self, source: &[u8], owner: OmegaDataSyntax, type_index: i32
) -> i32 {
    transition true { true -> visit(self.parser.type_references[type_index]) }
    state visit(row: OmegaTypeReferenceSyntax) {
        transition row.kind {
            OmegaTypeReferenceKind::NamedWithLifetimes -> arguments(row, 0)
            OmegaTypeReferenceKind::Named -> named(row, 0)
            OmegaTypeReferenceKind::Constrained -> inner(row)
            OmegaTypeReferenceKind::FixedArray -> inner(row)
            OmegaTypeReferenceKind::Slice -> inner(row)
            OmegaTypeReferenceKind::Reference -> reference(row)
            _ -> return 1
        }
    }
    state inner(row: OmegaTypeReferenceSyntax) {
        transition true { true -> visit(self.parser.type_references[row.payload0]) }
    }
    state reference(row: OmegaTypeReferenceSyntax) {
        transition row.payload2 {
            1 -> reference_name(row)
            _ -> inner(row)
        }
    }
    state reference_name(row: OmegaTypeReferenceSyntax) {
        transition self.field_lifetime_bound(source, owner, row.payload3, row.payload4) {
            1 -> inner(row)
            _ -> return 0
        }
    }
    state arguments(row: OmegaTypeReferenceSyntax, offset: i32) {
        transition offset < row.payload3 {
            true -> argument(row, offset, self.parser.members[row.payload2 + offset])
            _ -> named(row, row.payload3)
        }
    }
    state argument(row: OmegaTypeReferenceSyntax, offset: i32, name: OmegaRelativeSpan) {
        transition self.field_lifetime_bound(source, owner, name.start, name.end) {
            1 -> arguments(row, offset + 1)
            _ -> return 0
        }
    }
    state named(row: OmegaTypeReferenceSyntax, arity: i32) {
        transition self.scalar_name(source, row.payload0, row.payload1) > 0 {
            true -> declared_arity(row, arity, 0)
            _ -> target(row, arity, self.resolve_data(source, row.payload0, row.payload1))
        }
    }
    state target(row: OmegaTypeReferenceSyntax, arity: i32, index: i32) {
        transition index >= 0 {
            true -> declared_arity(row, arity, self.parser.data_items[index].lifetime_count)
            _ -> unknown(row, arity)
        }
    }
    state unknown(row: OmegaTypeReferenceSyntax, arity: i32) {
        transition arity == 0 {
            true -> return 1
            _ -> unsupported(row.payload0)
        }
    }
    state declared_arity(row: OmegaTypeReferenceSyntax, arity: i32, expected: i32) {
        transition arity == expected {
            true -> return 1
            _ -> invalid(row.payload0)
        }
    }
    state invalid(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
}

machine OmegaScalarCompiler::field_lifetime_bound(
    &mut self, source: &[u8], owner: OmegaDataSyntax, start: i32, end: i32
) -> i32 {
    transition true { true -> binder(0) }
    state binder(offset: i32) {
        transition offset < owner.lifetime_count {
            true -> compare(offset, self.parser.members[owner.first_lifetime + offset])
            _ -> invalid()
        }
    }
    state compare(offset: i32, name: OmegaRelativeSpan) {
        transition self.span_equals(source, start, end, source[name.start..name.end]) {
            1 -> return 1
            _ -> binder(offset + 1)
        }
    }
    state invalid() { self.record_reject(-1, 4, start); return 0; }
}
