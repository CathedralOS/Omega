// Relative filenames start at the requesting package. A braced root names
// one of its direct dependencies or the toolchain's designated core files.
machine OmegaScalarCompiler::imported_file(&mut self, source: &[u8], row: OmegaUseSyntax, owner: i32) -> i32 {
    let requester: i32 = self.parser.sources.units[owner].package;
    transition row.package_root.end > row.package_root.start {
        true -> root(requester)
        _ -> file(0, requester, row.file_path, -1)
    }
    state root(requester: i32) {
        transition self.span_equals(source, row.package_root.start, row.package_root.end, "omega") {
            1 -> toolchain()
            _ -> dependency(0, requester)
        }
    }
    state toolchain() {
        let start: i32 = row.file_path.start;
        transition (row.file_path.end - start > 14) &&
            (self.span_equals(source, start, start + 14, "language/core/") == 1) {
            true -> core(0)
            _ -> return -1
        }
    }
    state core(index: i32) {
        transition index < self.parser.sources.package_count {
            true -> role(index)
            _ -> return -1
        }
    }
    state role(index: i32) {
        transition self.parser.sources.packages[index].role == 1 {
            true -> core_file(index)
            _ -> core(index + 1)
        }
    }
    state core_file(package: i32) {
        let path: OmegaRelativeSpan = row.file_path;
        path.start = path.start + 14;
        transition true { true -> file(0, package, path, -1) }
    }
    state dependency(index: i32, requester: i32) {
        transition index < self.parser.sources.dependency_count {
            true -> edge(index, requester, self.parser.sources.dependencies[index])
            _ -> return -1
        }
    }
    state edge(index: i32, requester: i32, edge: OmegaSourceDependency) {
        transition (edge.requester == requester) && (self.parser.sources.equal_name(source, row.package_root, edge.alias) == 1) {
            true -> file(0, edge.target, row.file_path, -1)
            _ -> dependency(index + 1, requester)
        }
    }
    state file(index: i32, package: i32, path: OmegaRelativeSpan, selected: i32) {
        transition index < self.parser.sources.unit_count {
            true -> candidate(index, package, path, selected, self.parser.sources.units[index])
            _ -> return selected
        }
    }
    state candidate(index: i32, package: i32, path: OmegaRelativeSpan, selected: i32, unit: OmegaSourceUnit) {
        transition (unit.package == package) && (self.parser.sources.equal_name(source, path, unit.path) == 1) {
            true -> found(index, package, path, selected)
            _ -> file(index + 1, package, path, selected)
        }
    }
    state found(index: i32, package: i32, path: OmegaRelativeSpan, selected: i32) {
        transition selected < 0 {
            true -> file(index + 1, package, path, index)
            _ -> return -2
        }
    }
}

machine OmegaScalarCompiler::file_declaration(
    &mut self, source: &[u8], owner: i32, alias: OmegaRelativeSpan, member: OmegaRelativeSpan, kind: OmegaDeclarationKind
) -> i32 {
    transition true { true -> imports(0) }
    state imports(index: i32) {
        transition index < self.parser.use_count {
            true -> binding(index, self.parser.uses[index])
            _ -> return -1
        }
    }
    state binding(index: i32, row: OmegaUseSyntax) {
        transition (row.file_path.end > row.file_path.start) && (self.parser.sources.unit_at(row.start) == owner) &&
            (self.parser.sources.equal_name(source, alias, self.parser.members[row.first_member]) == 1) {
            true -> target(self.imported_file(source, row, owner))
            _ -> imports(index + 1)
        }
    }
    state target(unit: i32) {
        transition unit >= 0 {
            true -> declarations(0, unit, -1)
            _ -> return unit
        }
    }
    state declarations(index: i32, unit: i32, selected: i32) {
        transition index < self.declaration_count(kind) {
            true -> named(index, unit, selected, self.declaration_name(kind, index))
            _ -> return selected
        }
    }
    state named(index: i32, unit: i32, selected: i32, name: OmegaRelativeSpan) {
        transition (self.parser.sources.unit_at(name.start) == unit) && (self.parser.sources.equal_name(source, name, member) == 1) &&
            ((self.parser.sources.units[unit].package == self.parser.sources.units[owner].package) || (self.declaration_public(kind, index) == 1)) {
            true -> found(index, unit, selected)
            _ -> declarations(index + 1, unit, selected)
        }
    }
    state found(index: i32, unit: i32, selected: i32) {
        transition selected < 0 {
            true -> declarations(index + 1, unit, index)
            _ -> return -2
        }
    }
}
