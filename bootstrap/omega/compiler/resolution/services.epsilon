// A memberless boundary is a service identity. The source unit and declaration,
// including its package, determine that identity. No provider is needed to name it.
machine OmegaScalarCompiler::check_service_declarations(&mut self, source: &[u8]) -> i32 {
    transition true { true -> item(0) }
    state item(index: i32) {
        transition index < self.parser.boundary_trait_count {
            true -> shape(index, self.parser.boundary_traits[index])
            _ -> return 1
        }
    }
    state shape(index: i32, row: OmegaBoundaryTraitSyntax) {
        transition (row.requirement_count == 0) || (self.declares_terminal_requirement(source, index) == 1) {
            true -> name(index, row.name)
            _ -> unsupported(row.boundary_keyword.start)
        }
    }
    state name(index: i32, name: OmegaRelativeSpan) {
        transition self.parser.reserved_namespace(source, name.start, name.end) {
            1 -> rejected(name.start)
            _ -> previous(index, name, self.parser.sources.unit_at(name.start), 0)
        }
    }
    state previous(index: i32, name: OmegaRelativeSpan, unit: i32, other: i32) {
        transition other < index {
            true -> compare(index, name, unit, other, self.parser.boundary_traits[other].name)
            _ -> record_name(index, name, unit, 0)
        }
    }
    state compare(index: i32, name: OmegaRelativeSpan, unit: i32, other: i32, prior: OmegaRelativeSpan) {
        transition (self.parser.sources.equal_name(source, name, prior) == 1) &&
            (unit == self.parser.sources.unit_at(prior.start)) {
            true -> rejected(name.start)
            _ -> previous(index, name, unit, other + 1)
        }
    }
    state record_name(index: i32, name: OmegaRelativeSpan, unit: i32, record: i32) {
        transition record < self.parser.data_count {
            true -> compare_record(index, name, unit, record, self.parser.data_items[record].name)
            _ -> item(index + 1)
        }
    }
    state compare_record(index: i32, name: OmegaRelativeSpan, unit: i32, record: i32, other: OmegaRelativeSpan) {
        transition (self.parser.sources.equal_name(source, name, other) == 1) &&
            (unit == self.parser.sources.unit_at(other.start)) {
            true -> rejected(name.start)
            _ -> record_name(index, name, unit, record + 1)
        }
    }
    state unsupported(coordinate: i32) { self.record_incomplete(4, coordinate); return 0; }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Retain the selected trait for each occurrence. Repeated occurrences have
// the same identity; an explicit empty row has the sole member handle -1.
machine OmegaScalarCompiler::check_reach_clause(
    &mut self, source: &[u8], owner: i32, clause: i32
) -> i32 {
    let row: OmegaMachineClauseSyntax = self.parser.machine_clauses[clause];
    self.reach_clauses[owner] = clause;
    transition true { true -> member(row, 0) }
    state member(row: OmegaMachineClauseSyntax, index: i32) {
        transition index < row.member_count {
            true -> name(row, index, self.parser.members[row.first_member + index])
            _ -> return 1
        }
    }
    state name(row: OmegaMachineClauseSyntax, index: i32, name: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, "none") {
            1 -> empty(row, name)
            _ -> service_name(row, index, name)
        }
    }
    state service_name(row: OmegaMachineClauseSyntax, index: i32, name: OmegaRelativeSpan) {
        // Operational markers have their own axes and cannot name services.
        transition (self.span_equals(source, name.start, name.end, "Suspend") == 1) ||
            (self.span_equals(source, name.start, name.end, "Block") == 1) ||
            (self.span_equals(source, name.start, name.end, "thread_block") == 1) ||
            (self.span_equals(source, name.start, name.end, "sync_wait") == 1) {
            true -> rejected(name.start)
            _ -> resolved(row, index, name,
                self.resolve_declaration(source, name.start, name.end, OmegaDeclarationKind::Service))
        }
    }
    state empty(row: OmegaMachineClauseSyntax, name: OmegaRelativeSpan) {
        self.reach_members[row.first_member] = -1;
        transition row.member_count == 1 {
            true -> return 1
            _ -> rejected(name.start)
        }
    }
    state resolved(row: OmegaMachineClauseSyntax, index: i32, name: OmegaRelativeSpan, service: i32) {
        transition service >= 0 {
            true -> visibility(row, index, name, service)
            _ -> rejected(name.start)
        }
    }
    state visibility(row: OmegaMachineClauseSyntax, index: i32, name: OmegaRelativeSpan, service: i32) {
        transition (self.parser.machine_items[owner].is_public == 0) ||
            (self.parser.boundary_traits[service].is_public == 1) {
            true -> retain(row, index, service)
            _ -> rejected(name.start)
        }
    }
    state retain(row: OmegaMachineClauseSyntax, index: i32, service: i32) {
        self.reach_members[row.first_member + index] = service;
        transition true { true -> member(row, index + 1) }
    }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// -1 means infer from calls. An authored clause publishes its upper bound
// even when this implementation uses fewer services.
machine OmegaScalarCompiler::authored_reach(&mut self, owner: i32, service: i32) -> i32 {
    let last: i32 = self.reach_clauses[owner];
    transition last >= 0 {
        true -> clause(self.parser.machine_items[owner].first_clause, last)
        _ -> return -1
    }
    state clause(cursor: i32, last: i32) {
        transition cursor <= last {
            true -> kind(cursor, last, self.parser.machine_clauses[cursor])
            _ -> return 0
        }
    }
    state kind(cursor: i32, last: i32, row: OmegaMachineClauseSyntax) {
        transition row.kind {
            OmegaMachineClauseKind::Reaches -> member(cursor, last, row, 0)
            _ -> clause(cursor + 1, last)
        }
    }
    state member(cursor: i32, last: i32, row: OmegaMachineClauseSyntax, index: i32) {
        transition index < row.member_count {
            true -> compare(cursor, last, row, index)
            _ -> clause(cursor + 1, last)
        }
    }
    state compare(cursor: i32, last: i32, row: OmegaMachineClauseSyntax, index: i32) {
        transition self.reach_members[row.first_member + index] == service {
            true -> return 1
            _ -> member(cursor, last, row, index + 1)
        }
    }
}

// The admitted ordinary-call graph is acyclic. Compute one membership bit
// per machine, visiting callees before callers. Keeping just the current
// service uses linear storage regardless of the number of service identities.
machine OmegaScalarCompiler::check_service_calls(&mut self) -> i32 {
    transition true { true -> service(0) }
    state service(index: i32) {
        transition index < self.parser.boundary_trait_count {
            true -> machine_at(index, 0)
            _ -> return 1
        }
    }
    state machine_at(index: i32, position: i32) {
        transition position < self.call_order_count {
            true -> owner(index, position, self.call_order[position])
            _ -> service(index + 1)
        }
    }
    state owner(index: i32, position: i32, owner: i32) {
        let authored: i32 = self.authored_reach(owner, index);
        transition authored == 1 {
            true -> publish(index, position, owner, 1)
            _ -> direct(index, position, owner, authored)
        }
    }
    state direct(index: i32, position: i32, owner: i32, authored: i32) {
        transition (index == self.exit_service) && (self.terminal_calls[owner] >= 0) {
            true -> allowed(index, position, owner, authored)
            _ -> call(index, position, owner, authored, self.call_edge_heads[owner])
        }
    }
    state allowed(index: i32, position: i32, owner: i32, authored: i32) {
        transition authored == 0 {
            true -> rejected(self.terminal_calls[owner])
            _ -> publish(index, position, owner, 1)
        }
    }
    state call(index: i32, position: i32, owner: i32, authored: i32, edge: i32) {
        transition edge >= 0 {
            true -> callee(index, position, owner, authored, edge)
            _ -> publish(index, position, owner, 0)
        }
    }
    state callee(index: i32, position: i32, owner: i32, authored: i32, edge: i32) {
        transition self.published_reach[self.call_edge_targets[edge]] {
            1 -> contribution(index, position, owner, authored, edge)
            _ -> call(index, position, owner, authored, self.call_edge_next[edge])
        }
    }
    state contribution(index: i32, position: i32, owner: i32, authored: i32, edge: i32) {
        transition authored == 0 {
            true -> rejected(self.call_edge_offsets[edge])
            _ -> publish(index, position, owner, 1)
        }
    }
    state publish(index: i32, position: i32, owner: i32, reaches: i32) {
        self.published_reach[owner] = reaches;
        transition true { true -> machine_at(index, position + 1) }
    }
    state rejected(coordinate: i32) { self.record_reject(-1, 4, coordinate); return 0; }
}

// Default-domain evidence belongs to the selected data declaration. Only a
// fieldless record with the single literal predicate false is covered here.
machine OmegaScalarCompiler::empty_record(&mut self, row: OmegaDataSyntax) -> i32 {
    transition (row.case_count == 0) && (row.field_count == 0) && (row.requirement_count == 1) {
        true -> literal(self.parser.expressions[self.parser.requirements[row.first_requirement].expression])
        _ -> return 0
    }
    state literal(value: OmegaExpressionSyntax) {
        transition value.kind {
            OmegaExpressionKind::Boolean -> return value.payload0 == 0
            _ -> return 0
        }
    }
}

// Terminal contracts share one i32 parameter and an uninhabited result.
// Return the resolved data declaration. A negative result is outside the profile.
machine OmegaScalarCompiler::terminal_signature(
    &mut self, source: &[u8], first_parameter: i32, parameter_count: i32,
    has_result: i32, return_type: i32, predicate_count: i32, is_public: i32
) -> i32 {
    transition (parameter_count == 1) && (has_result == 1) && (predicate_count == 0) {
        true -> parameter(self.parser.machine_parameters[self.parameter_syntax_row(first_parameter)])
        _ -> return -1
    }
    state parameter(row: OmegaMachineParameterSyntax) {
        transition (row.is_const == 0) && (row.is_mutable == 0) && (row.is_self == 0) {
            true -> parameter_type(self.parser.type_references[row.type_reference])
            _ -> return -1
        }
    }
    state parameter_type(row: OmegaTypeReferenceSyntax) {
        transition row.kind {
            OmegaTypeReferenceKind::Named -> integer(row)
            _ -> return -1
        }
    }
    state integer(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "i32") {
            1 -> result(self.parser.type_references[return_type])
            _ -> return -1
        }
    }
    state result(row: OmegaTypeReferenceSyntax) {
        transition row.kind {
            OmegaTypeReferenceKind::Named -> record(self.resolve_data(source, row.payload0, row.payload1))
            _ -> return -1
        }
    }
    state record(index: i32) {
        transition (index >= 0) && (self.empty_record(self.parser.data_items[index]) == 1) &&
            ((is_public == 0) || (self.parser.data_items[index].is_public == 1)) {
            true -> return index
            _ -> return -1
        }
    }
}

// A terminal declaration promises its own reach, no crash and eventual
// termination. A primitive additionally supplies the exact qualified requirement.
machine OmegaScalarCompiler::terminal_promises(
    &mut self, source: &[u8], service: i32, first: i32, count: i32, supplies: i32
) -> i32 {
    transition count == 3 + supplies {
        true -> clause(0, 0)
        _ -> return 0
    }
    state clause(offset: i32, seen: i32) {
        transition offset < count {
            true -> kind(offset, seen, self.parser.machine_clauses[first + offset])
            _ -> return seen == 7 + 8 * supplies
        }
    }
    state kind(offset: i32, seen: i32, row: OmegaMachineClauseSyntax) {
        transition row.kind {
            OmegaMachineClauseKind::Reaches -> reach(offset, seen, row)
            OmegaMachineClauseKind::CrashesNone -> clause(offset + 1, seen | 2)
            OmegaMachineClauseKind::EventualTermination -> clause(offset + 1, seen | 4)
            OmegaMachineClauseKind::Satisfies -> requirement(offset, seen, row)
            _ -> return 0
        }
    }
    state reach(offset: i32, seen: i32, row: OmegaMachineClauseSyntax) {
        transition row.member_count == 1 {
            true -> reach_name(offset, seen, self.parser.members[row.first_member])
            _ -> return 0
        }
    }
    state reach_name(offset: i32, seen: i32, name: OmegaRelativeSpan) {
        transition (self.span_equals(source, name.start, name.end, "none") == 0) &&
            (self.resolve_declaration(source, name.start, name.end, OmegaDeclarationKind::Service) == service) {
            true -> clause(offset + 1, seen | 1)
            _ -> return 0
        }
    }
    state requirement(offset: i32, seen: i32, row: OmegaMachineClauseSyntax) {
        transition (supplies == 1) && (row.member_count == 2) && (row.has_external_binding == 0) {
            true -> requirement_name(offset, seen, self.parser.members[row.first_member],
                self.parser.members[row.first_member + 1])
            _ -> return 0
        }
    }
    state requirement_name(offset: i32, seen: i32, owner_name: OmegaRelativeSpan, member_name: OmegaRelativeSpan) {
        let requirement: i32 = self.parser.boundary_traits[service].first_requirement;
        transition (self.resolve_declaration(source, owner_name.start, owner_name.end, OmegaDeclarationKind::Service) == service) &&
            (self.parser.sources.equal_name(source, member_name, self.parser.boundary_requirements[requirement].name) == 1) {
            true -> clause(offset + 1, seen | 8)
            _ -> return 0
        }
    }
}

machine OmegaScalarCompiler::declares_terminal_requirement(
    &mut self, source: &[u8], service: i32
) -> i32 {
    let row: OmegaBoundaryTraitSyntax = self.parser.boundary_traits[service];
    transition row.requirement_count == 1 {
        true -> requirement(row.is_public, self.parser.boundary_requirements[row.first_requirement])
        _ -> return 0
    }
    state requirement(is_public: i32, row: OmegaBoundaryRequirementSyntax) {
        transition self.terminal_signature(source, row.first_parameter, row.parameter_count,
            row.has_return_type, row.return_type, row.predicate_count, is_public) >= 0 {
            true -> return self.terminal_promises(source, service, row.first_clause, row.clause_count, 0)
            _ -> return 0
        }
    }
}

// A checked supplier is still uninstalled in a v1 construction invocation.
// A bare or qualified primitive and a static provider member have distinct
// declaration identities. The final name must belong to the resolved owner.
machine OmegaScalarCompiler::terminal_declaration_coordinate(
    &mut self, source: &[u8], first: i32, count: i32, name: OmegaRelativeSpan
) -> i32 {
    transition count > 0 {
        true -> path(self.parser.members[first].start, self.parser.members[first + count - 1].end)
        _ -> primitive(name.start)
    }
    state path(start: i32, end: i32) {
        transition self.read_query(source, start, name.end) {
            1 -> primitive(start)
            2 -> owner(start, end, self.resolve_declaration(source, start, end, OmegaDeclarationKind::Service))
            _ -> return -1
        }
    }
    state primitive(start: i32) {
        transition (self.exit_primitive >= 0) &&
            (self.resolve_declaration(source, start, name.end, OmegaDeclarationKind::BoundaryMachine) == self.exit_primitive) {
            true -> located(self.parser.owned_machines[self.parser.boundary_machines[self.exit_primitive]].start)
            _ -> return -1
        }
    }
    state owner(start: i32, end: i32, index: i32) {
        transition index >= 0 {
            true -> requirement(self.parser.boundary_traits[index])
            _ -> implementation(self.resolve_declaration(source, start, end, OmegaDeclarationKind::Implementation))
        }
    }
    state requirement(row: OmegaBoundaryTraitSyntax) {
        transition (row.requirement_count == 1) &&
            (self.parser.sources.equal_name(source, name, self.parser.boundary_requirements[row.first_requirement].name) == 1) {
            true -> located(row.boundary_keyword.start)
            _ -> return -1
        }
    }
    state implementation(index: i32) {
        transition (index >= 0) && (self.exit_primitive >= 0) {
            true -> supplied(self.parser.implementations[index])
            _ -> return -1
        }
    }
    state supplied(row: OmegaImplementationSyntax) {
        let member: OmegaMachineSyntax = self.parser.owned_machines[row.first_member];
        transition self.parser.sources.equal_name(source, name, self.parser.members[member.first_path_member]) {
            1 -> located(row.name.start)
            _ -> return -1
        }
    }
    state located(coordinate: i32) { return coordinate; }
}

// First check the terminal call as an ordinary typed invocation. Even an
// uninstalled v1 target cannot turn another type into a signed exit status.
// All supported terminal declarations share one i32 input and no predicates.
machine OmegaScalarCompiler::check_terminal_invocation(
    &mut self, source: &[u8], owner: i32, state_index: i32, before: i32, first: i32,
    count: i32, coordinate: i32, call_start: i32, name: OmegaRelativeSpan
) -> i32 {
    transition coordinate >= 0 {
        true -> arity()
        _ -> rejected(name.start)
    }
    state arity() {
        transition count == 1 {
            true -> status_value()
            _ -> rejected(call_start)
        }
    }
    state status_value() {
        transition self.check_value(source, owner, state_index, before, self.parser.call_arguments[first], 33) {
            1 -> domain()
            _ -> return 0
        }
    }
    state domain() {
        transition (self.process_entry.end > 0) && (self.exit_service >= 0) {
            true -> requirement(self.parser.boundary_traits[self.exit_service])
            _ -> uninstalled()
        }
    }
    state requirement(row: OmegaBoundaryTraitSyntax) {
        transition (coordinate == row.boundary_keyword.start) && (row.name.start == self.build.slot_definition.start) &&
            (self.build.slot_definition.end > 0) && (self.build.provider_definition.end > 0) &&
            (self.exit_primitive >= 0) {
            true -> primitive(self.declaration_name(OmegaDeclarationKind::BoundaryMachine, self.exit_primitive))
            _ -> uninstalled()
        }
    }
    state primitive(site: OmegaRelativeSpan) {
        transition (site.start == self.build.primitive_definition.start) && (site.end == self.build.primitive_definition.end) {
            true -> reached()
            _ -> uninstalled()
        }
    }
    state reached() {
        transition self.terminal_calls[owner] < 0 {
            true -> first_call()
            _ -> return 1
        }
    }
    state first_call() { self.terminal_calls[owner] = call_start; return 1; }
    state uninstalled() { self.record_incomplete(4, coordinate); return 0; }
    state rejected(offset: i32) { self.record_reject(-1, 4, offset); return 0; }
}
