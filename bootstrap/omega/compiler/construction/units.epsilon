// Ordinary declarations keep their position in the whole program. Each
// file's first row is also the end of the preceding file's range.
data OmegaConstructionUnit {
    machine_count: i32;
    state_count: i32;
    parameter_count: i32;
    root_parameters: i32;
    data_count: i32;
    field_count: i32;
    case_count: i32;
    payload_count: i32;
}

data OmegaConstructionDeclaration {
    name: OmegaRelativeSpan;
    unit: i32;
    is_public: i32;
}

// Header arrays outlive the declaring file. Store a resolved element kind and
// the logical count, indexed by the same field ID used by layout.
data OmegaConstructionArray {
    element: i32;
    count: i32;
}

// Program-wide state identity is needed for forward jumps, caller checks and
// effect propagation. The state name and body syntax remain local to a file.
data OmegaConstructionState {
    first_parameter: i32;
    parameter_count: i32;
    block_bound: i32;
    crash_bound: i32;
    name_start: i32;
}

data OmegaConstructionDirectory {
    states: [OmegaConstructionState; 16384];
    state_first: i32;
    // Root parameters have permanent argument homes across files. For larger
    // packages the remaining parameter slots describe only the loaded file.
    compact_parameters: i32;
    unit_root_parameters: i32;
    max_nested_parameters: i32;
    parameter_rows: [i32; 16384];
    // The field, payload field and parameter each own a disjoint range of 16384 rows.
    arrays: [OmegaConstructionArray; 49152];
    machines: [OmegaConstructionDeclaration; 4096];
    types: [OmegaConstructionDeclaration; 4096];
    units: [OmegaConstructionUnit; 513];
    total: OmegaConstructionUnit;
    active: i32;
    unit_first: i32;
    unit_end: i32;
    parameter_cells: i32;
}

machine OmegaScalarCompiler::prepare_construction(&mut self, source: &[u8], entry: &[u8]) {
    self.construction.active = 0;
    self.construction.total.machine_count = 0;
    self.construction.total.state_count = 0;
    self.construction.total.parameter_count = 0;
    self.construction.total.root_parameters = 0;
    self.construction.max_nested_parameters = 0;
    self.construction.compact_parameters = 0;
    self.construction.total.data_count = 0;
    self.construction.total.field_count = 0;
    self.construction.total.case_count = 0;
    self.construction.total.payload_count = 0;
    transition (self.parser.sources.unit_count > 1) && (self.parser.sources.valid(source) == 1) {
        true -> units(0, 1)
        _ -> pooled()
    }
    state units(unit: i32, eligible: i32) {
        self.construction.units[unit] = self.construction.total;
        transition unit < self.parser.sources.unit_count {
            true -> parse(unit, eligible)
            _ -> finish(eligible)
        }
    }
    state parse(unit: i32, eligible: i32) {
        self.parser.reset_syntax();
        self.construction.unit_root_parameters = 0;
        self.parser.unit_index = unit;
        self.parser.retain_unit_namespace(source, unit, self.parser.sources.units[unit].path);
        transition self.parser.status {
            OmegaParserStatus::Complete -> declarations(unit, eligible)
            _ -> return
        }
    }
    state declarations(unit: i32, eligible: i32) {
        self.parser.append_unit(source[0..self.parser.sources.units[unit].end], self.parser.sources.units[unit].start);
        transition self.parser.status {
            OmegaParserStatus::Complete -> index_unit(unit, eligible)
            _ -> return
        }
    }
    state index_unit(unit: i32, eligible: i32) {
        transition (eligible == 1) && (self.parser.root_count == self.parser.machine_count + self.parser.use_count + self.parser.data_count) &&
            (self.parser.data_count <= 4096 - self.construction.total.data_count) &&
            (self.parser.data_member_count <= 16384 - self.construction.total.field_count - self.construction.total.case_count) &&
            (self.parser.data_payload_field_count <= 16384 - self.construction.total.payload_count) &&
            (self.parser.machine_count <= 4096 - self.construction.total.machine_count) &&
            (self.parser.machine_state_count <= 16384 - self.construction.total.state_count) {
            true -> data_item(unit, 0)
            _ -> units(unit + 1, 0)
        }
    }
    // Each retained declaration has scalar or named fields. Keep its name even
    // when an earlier file's import is checked before these fields are loaded.
    state data_item(unit: i32, index: i32) {
        transition index < self.parser.data_count {
            true -> data_shape(unit, index, self.parser.data_items[index])
            _ -> field(unit, 0)
        }
    }
    state data_shape(unit: i32, index: i32, row: OmegaDataSyntax) {
        // Records and sums check their predicates in the declaring file.
        // A constrained fieldless, caseless data item still needs the pooled checker.
        transition (row.requirement_count == 0) || (row.field_count > 0) || (row.case_count > 0) {
            true -> retain_data(unit, index, self.construction.total.data_count + index, row)
            _ -> units(unit + 1, 0)
        }
    }
    state retain_data(unit: i32, index: i32, global: i32, row: OmegaDataSyntax) {
        self.construction.types[global].name = row.name;
        self.construction.types[global].unit = unit;
        self.construction.types[global].is_public = row.is_public;
        transition true { true -> data_item(unit, index + 1) }
    }
    state field(unit: i32, index: i32) {
        transition index < self.parser.data_field_count {
            true -> field_type(unit, index, self.parser.data_fields[index].type_reference)
            _ -> payload(unit, 0)
        }
    }
    state field_type(unit: i32, index: i32, type_index: i32) {
        transition self.construction_field_type_supported(source, type_index) == 1 {
            true -> field(unit, index + 1)
            _ -> units(unit + 1, 0)
        }
    }
    state payload(unit: i32, index: i32) {
        transition index < self.parser.data_payload_field_count {
            true -> payload_type(unit, index, self.parser.data_payload_fields[index].type_reference)
            _ -> parameter(unit, 0)
        }
    }
    state payload_type(unit: i32, index: i32, type_index: i32) {
        transition self.construction_field_type_supported(source, type_index) == 1 {
            true -> payload(unit, index + 1)
            _ -> units(unit + 1, 0)
        }
    }
    state parameter(unit: i32, index: i32) {
        transition index < self.parser.machine_parameter_count {
            true -> parameter_type(unit, index)
            _ -> state_item(unit, 0)
        }
    }
    state parameter_type(unit: i32, index: i32) {
        let type_index: i32 = self.parser.machine_parameters[index].type_reference;
        transition self.construction_value_type(source, type_index) {
            1 -> parameter(unit, index + 1)
            _ -> reference_parameter(unit, index, self.scalar_type(source, type_index))
        }
    }
    state reference_parameter(unit: i32, index: i32, kind: i32) {
        transition (kind == omega_shared_byte_slice()) || (omega_array_reference_row(kind) >= 0) {
            true -> parameter(unit, index + 1)
            _ -> units(unit + 1, 0)
        }
    }
    state state_item(unit: i32, index: i32) {
        transition index < self.parser.machine_state_count {
            true -> signature(unit, index, self.parser.machine_states[index])
            _ -> machine_item(unit, 0)
        }
    }
    state signature(unit: i32, index: i32, row: OmegaMachineStateSyntax) {
        transition (row.has_return_type == 0) || (self.construction_value_type(source, row.return_type) == 1) {
            true -> retain_state(unit, index, self.construction.total.state_count + index, row)
            _ -> units(unit + 1, 0)
        }
    }
    state retain_state(unit: i32, index: i32, global: i32, row: OmegaMachineStateSyntax) {
        self.construction.states[global].first_parameter = self.construction.total.parameter_count + row.first_parameter;
        self.construction.states[global].parameter_count = row.parameter_count;
        self.construction.states[global].block_bound = row.block_bound;
        self.construction.states[global].crash_bound = row.crash_bound;
        self.construction.states[global].name_start = row.name.start;
        transition row.lexical_parent < 0 {
            true -> root_parameters(unit, index, row.parameter_count)
            _ -> state_item(unit, index + 1)
        }
    }
    state root_parameters(unit: i32, index: i32, count: i32) {
        self.construction.unit_root_parameters = self.construction.unit_root_parameters + count;
        transition true { true -> state_item(unit, index + 1) }
    }
    state machine_item(unit: i32, local: i32) {
        transition local < self.parser.machine_count {
            true -> name(unit, local, self.parser.machine_items[local])
            _ -> next(unit)
        }
    }
    state name(unit: i32, local: i32, row: OmegaMachineSyntax) {
        transition (row.path_member_count == 1) && (row.state_count >= 1) &&
            (row.is_bodyless == 0) && (row.has_target == 0) {
            true -> clauses(unit, local, row, 0)
            _ -> units(unit + 1, 0)
        }
    }
    // Checked crash ceilings survive as per-machine and per-state effect facts.
    // Clauses that retain file-local names still require the pooled checker.
    state clauses(unit: i32, local: i32, row: OmegaMachineSyntax, offset: i32) {
        transition offset < row.clause_count {
            true -> clause(unit, local, row, offset, self.parser.machine_clauses[row.first_clause + offset].kind)
            _ -> retain(unit, local, row, self.construction.total.machine_count + local)
        }
    }
    state clause(unit: i32, local: i32, row: OmegaMachineSyntax, offset: i32, kind: OmegaMachineClauseKind) {
        transition kind {
            OmegaMachineClauseKind::CrashesTrap -> clauses(unit, local, row, offset + 1)
            OmegaMachineClauseKind::CrashesNone -> clauses(unit, local, row, offset + 1)
            _ -> units(unit + 1, 0)
        }
    }
    state retain(unit: i32, local: i32, row: OmegaMachineSyntax, global: i32) {
        self.construction.machines[global].name = self.parser.members[row.first_path_member];
        self.construction.machines[global].unit = unit;
        self.construction.machines[global].is_public = row.is_public;
        transition true { true -> machine_item(unit, local + 1) }
    }
    state next(unit: i32) {
        self.construction.total.machine_count = self.construction.total.machine_count + self.parser.machine_count;
        self.construction.total.state_count = self.construction.total.state_count + self.parser.machine_state_count;
        self.construction.total.data_count = self.construction.total.data_count + self.parser.data_count;
        self.construction.total.field_count = self.construction.total.field_count + self.parser.data_field_count;
        self.construction.total.case_count = self.construction.total.case_count + self.parser.data_case_count;
        self.construction.total.payload_count = self.construction.total.payload_count + self.parser.data_payload_field_count;
        self.construction.total.parameter_count = self.construction.total.parameter_count + self.parser.machine_parameter_count;
        self.construction.total.root_parameters = self.construction.total.root_parameters + self.construction.unit_root_parameters;
        let nested: i32 = self.parser.machine_parameter_count - self.construction.unit_root_parameters;
        transition nested > self.construction.max_nested_parameters {
            true -> largest_unit(unit, nested)
            _ -> units(unit + 1, 1)
        }
    }
    state largest_unit(unit: i32, count: i32) {
        self.construction.max_nested_parameters = count;
        transition true { true -> units(unit + 1, 1) }
    }
    state finish(eligible: i32) {
        transition (eligible == 1) && (self.construction.total.machine_count > 0) &&
            (self.entry_unit >= 0) && (self.entry_unit < self.parser.sources.unit_count) &&
            (self.construction.total.root_parameters <= 16384 - self.construction.max_nested_parameters) {
            true -> install()
            _ -> pooled()
        }
    }
    state pooled() { self.parser.parse_set(source); }
    state install() {
        self.parser.reset_syntax();
        self.construction.active = 1;
        self.construction.compact_parameters = self.construction.total.parameter_count > 16384;
        self.parser.root_count = self.construction.total.machine_count + self.construction.total.data_count;
        self.parser.data_count = self.construction.total.data_count;
        self.parser.machine_count = self.construction.total.machine_count;
        transition true { true -> entry_machine(self.construction.units[self.entry_unit].machine_count) }
    }
    state entry_machine(index: i32) {
        transition index < self.construction.units[self.entry_unit + 1].machine_count {
            true -> entry_name(index, self.construction.machines[index].name)
            _ -> return
        }
    }
    state entry_name(index: i32, name: OmegaRelativeSpan) {
        transition self.span_equals(source, name.start, name.end, entry) {
            1 -> select(index)
            _ -> entry_machine(index + 1)
        }
    }
    state select(index: i32) { self.selected_machine = index; }
}

// Machine/state/parameter ordinal ranges are disjoint across units. Checking
// another file may use those rows' names, typed signatures or assigned labels.
// All expression, type, statement and path rows belong to the current file.
machine OmegaScalarCompiler::load_construction_unit(&mut self, source: &[u8], unit: i32) {
    let first: OmegaConstructionUnit = self.construction.units[unit];
    let end: OmegaConstructionUnit = self.construction.units[unit + 1];
    self.parser.reset_syntax();
    self.construction.unit_first = first.machine_count;
    self.construction.unit_end = end.machine_count;
    self.parser.machine_count = first.machine_count;
    self.construction.state_first = first.state_count;
    self.parser.machine_parameter_count = self.parameter_row_base(first.parameter_count);
    self.parser.data_count = first.data_count;
    self.parser.data_field_count = first.field_count;
    self.parser.data_member_count = first.field_count + first.case_count;
    self.parser.data_case_count = first.case_count;
    self.parser.data_payload_field_count = first.payload_count;
    self.parser.unit_index = unit;
    self.parser.append_unit(source[0..self.parser.sources.units[unit].end], self.parser.sources.units[unit].start);
    transition (self.parser.machine_count == end.machine_count) && (self.parser.machine_state_count == end.state_count - first.state_count) &&
        (self.parser.machine_parameter_count == self.parameter_row_base(first.parameter_count) + end.parameter_count - first.parameter_count) && (self.parser.data_count == end.data_count) &&
        (self.parser.data_field_count == end.field_count) && (self.parser.data_case_count == end.case_count) &&
        (self.parser.data_payload_field_count == end.payload_count) {
        true -> machine_states(first.machine_count)
        _ -> internal()
    }
    // The parser wrote only this file's state rows. Rebase links, including
    // nested lexical scopes, onto the program's source-ordered label IDs.
    state machine_states(index: i32) {
        transition index < self.construction.unit_end {
            true -> machine_range(index)
            _ -> state_links(0)
        }
    }
    state machine_range(index: i32) {
        self.parser.machine_items[index].first_state = self.construction.state_first + self.parser.machine_items[index].first_state;
        transition true { true -> machine_states(index + 1) }
    }
    state state_links(row: i32) {
        transition row < self.parser.machine_state_count {
            true -> state_end(row)
            _ -> parameter_layout()
        }
    }
    state state_end(row: i32) {
        self.parser.machine_states[row].subtree_end = self.construction.state_first + self.parser.machine_states[row].subtree_end;
        transition self.parser.machine_states[row].lexical_parent >= 0 {
            true -> parent(row)
            _ -> state_links(row + 1)
        }
    }
    state parent(row: i32) {
        self.parser.machine_states[row].lexical_parent = self.construction.state_first + self.parser.machine_states[row].lexical_parent;
        transition true { true -> state_links(row + 1) }
    }
    state parameter_layout() {
        transition self.construction.compact_parameters {
            1 -> parameter_state(0, self.construction.units[unit].root_parameters, self.construction.total.root_parameters)
            _ -> expose_signatures()
        }
    }
    state parameter_state(row: i32, root: i32, nested: i32) {
        transition row < self.parser.machine_state_count {
            true -> parameter_owner(row, root, nested, self.parser.machine_states[row])
            _ -> expose_signatures()
        }
    }
    state parameter_owner(row: i32, root: i32, nested: i32, state_row: OmegaMachineStateSyntax) {
        transition state_row.lexical_parent < 0 {
            true -> parameter_range(row, root + state_row.parameter_count, nested, root, state_row)
            _ -> parameter_range(row, root, nested + state_row.parameter_count, nested, state_row)
        }
    }
    state parameter_range(row: i32, root: i32, nested: i32, slot: i32, state_row: OmegaMachineStateSyntax) {
        self.construction.states[self.construction.state_first + row].first_parameter = slot;
        self.parser.machine_states[row].first_parameter = slot;
        transition true { true -> parameter_row(row, root, nested, slot, state_row.first_parameter, state_row.parameter_count) }
    }
    state parameter_row(row: i32, root: i32, nested: i32, slot: i32, syntax: i32, count: i32) {
        transition count > 0 {
            true -> bind_parameter(row, root, nested, slot, syntax, count)
            _ -> parameter_state(row + 1, root, nested)
        }
    }
    state bind_parameter(row: i32, root: i32, nested: i32, slot: i32, syntax: i32, count: i32) {
        self.construction.parameter_rows[slot] = syntax;
        transition true { true -> parameter_row(row, root, nested, slot + 1, syntax + 1, count - 1) }
    }

    state expose_signatures() {
        self.parser.machine_count = self.construction.total.machine_count;
        self.parser.data_count = self.construction.total.data_count;
        self.parser.data_field_count = self.construction.total.field_count;
        self.parser.data_case_count = self.construction.total.case_count;
        self.parser.data_payload_field_count = self.construction.total.payload_count;
        transition self.construction.compact_parameters { 1 -> return _ -> all_parameters() }
    }
    state all_parameters() { self.parser.machine_parameter_count = self.construction.total.parameter_count; }
    state internal() { self.parser.status = OmegaParserStatus::InternalFailure; }
}

// All declarations in this file are known. Resolve its fields while its
// imports and type references are loaded. The layout checker can then follow
// a nested or forward type, including a by-value cycle, from any other file.
// Direct fields and case payloads have separate, disjoint checked field IDs.
machine OmegaScalarCompiler::retain_construction_field_types(&mut self, source: &[u8], unit: i32) {
    transition true { true -> fields(self.construction.units[unit].field_count, self.construction.units[unit + 1].field_count) }
    state fields(index: i32, limit: i32) {
        transition index < limit {
            true -> field(index, limit)
            _ -> payloads(self.construction.units[unit].payload_count, self.construction.units[unit + 1].payload_count)
        }
    }
    state field(index: i32, limit: i32) {
        self.retain_construction_field(source, index, self.parser.data_fields[index].type_reference);
        transition true { true -> fields(index + 1, limit) }
    }
    state payloads(index: i32, limit: i32) {
        transition index < limit {
            true -> payload(index, limit)
            _ -> return
        }
    }
    state payload(index: i32, limit: i32) {
        self.retain_construction_field(source, 16384 + index, self.parser.data_payload_fields[index].type_reference);
        transition true { true -> payloads(index + 1, limit) }
    }
}

// An array stored in a nominal field receives a persistent row. Local
// arrays still use the current file's type references. Nested array headers
// require a further retained row and continue through the pooled checker.
machine OmegaScalarCompiler::construction_field_array(&mut self, source: &[u8], index: i32) -> i32 {
    let row: OmegaTypeReferenceSyntax = self.parser.type_references[index];
    transition row.kind {
        OmegaTypeReferenceKind::FixedArray -> return index
        OmegaTypeReferenceKind::Constrained -> qualification(row)
        _ -> return -1
    }
    state qualification(row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload1, row.payload2, "Trapping") {
            1 -> base(row.payload0)
            _ -> return -1
        }
    }
    state base(array: i32) {
        transition self.parser.type_references[array].kind {
            OmegaTypeReferenceKind::FixedArray -> return array
            _ -> return -1
        }
    }
}

machine OmegaScalarCompiler::construction_field_type_supported(&mut self, source: &[u8], index: i32) -> i32 {
    let array: i32 = self.construction_field_array(source, index);
    transition array >= 0 {
        true -> return self.construction_value_type(source, self.parser.type_references[array].payload0)
        _ -> return self.construction_value_type(source, index)
    }
}

machine OmegaScalarCompiler::retain_construction_field(&mut self, source: &[u8], slot: i32, index: i32) {
    let array: i32 = self.construction_field_array(source, index);
    transition array >= 0 {
        true -> retain(array)
        _ -> ordinary()
    }
    state retain(array: i32) {
        self.construction.arrays[slot].element = self.array_element_kind(source, array);
        self.construction.arrays[slot].count = self.array_count(source, array);
        self.field_types[slot] = omega_fixed_array_type(16384 + slot, index != array);
    }
    state ordinary() { self.field_types[slot] = self.scalar_type(source, index); }
}

// Named data types are resolved by their declaring package and imports during
// signature checking. An unresolved spelling still receives the normal error.
machine OmegaScalarCompiler::construction_value_type(&mut self, source: &[u8], index: i32) -> i32 {
    transition self.parser.type_references[index].kind {
        OmegaTypeReferenceKind::Named -> return 1
        _ -> return self.primitive_type(source, index) > 0
    }
}

// Type-reference handles belong to the unit that wrote them. Revisiting an
// interface or layout restores that file before following its type references.
machine OmegaScalarCompiler::select_construction_unit(&mut self, source: &[u8], unit: i32) -> i32 {
    transition (self.construction.active == 1) && (self.parser.unit_index != unit) {
        true -> load()
        _ -> return 1
    }
    state load() {
        self.load_construction_unit(source, unit);
        transition self.parser.status {
            OmegaParserStatus::Complete -> return 1
            _ -> internal()
        }
    }
    state internal() { self.record_internal(); return 0; }
}

// Global signatures and effect proofs use retained state facts. Body, source
// type and statement rows are read only while that state's unit is loaded.
machine OmegaScalarCompiler::program_state_count(&mut self) -> i32 {
    transition self.construction.active {
        1 -> return self.construction.total.state_count
        _ -> return self.parser.machine_state_count
    }
}

machine OmegaScalarCompiler::local_state_row(&mut self, index: i32) -> i32 {
    transition self.construction.active {
        1 -> return index - self.construction.state_first
        _ -> return index
    }
}

machine OmegaScalarCompiler::state_first_parameter(&mut self, index: i32) -> i32 {
    transition self.construction.active {
        1 -> return self.construction.states[index].first_parameter
        _ -> return self.parser.machine_states[index].first_parameter
    }
}

machine OmegaScalarCompiler::state_parameter_count(&mut self, index: i32) -> i32 {
    transition self.construction.active {
        1 -> return self.construction.states[index].parameter_count
        _ -> return self.parser.machine_states[index].parameter_count
    }
}

machine OmegaScalarCompiler::state_block_bound(&mut self, index: i32) -> i32 {
    transition self.construction.active {
        1 -> return self.construction.states[index].block_bound
        _ -> return self.parser.machine_states[index].block_bound
    }
}

machine OmegaScalarCompiler::state_crash_bound(&mut self, index: i32) -> i32 {
    transition self.construction.active {
        1 -> return self.construction.states[index].crash_bound
        _ -> return self.parser.machine_states[index].crash_bound
    }
}

machine OmegaScalarCompiler::state_name_start(&mut self, index: i32) -> i32 {
    transition self.construction.active {
        1 -> return self.construction.states[index].name_start
        _ -> return self.parser.machine_states[index].name.start
    }
}

machine OmegaScalarCompiler::parameter_row_base(&mut self, previous: i32) -> i32 {
    transition self.construction.compact_parameters { 1 -> return 0 _ -> return previous }
}

machine OmegaScalarCompiler::parameter_syntax_row(&mut self, slot: i32) -> i32 {
    transition self.construction.compact_parameters {
        1 -> return self.construction.parameter_rows[slot]
        _ -> return slot
    }
}

// Restore nested signatures while their syntax is loaded. Physical offsets
// survive in the emitted tape, so a nested caller cannot alias the next file's
// arguments even though both use the same temporary parameter slot numbers.
machine OmegaScalarCompiler::prepare_nested_parameters(&mut self, source: &[u8], unit: i32) -> i32 {
    transition self.construction.compact_parameters {
        1 -> slots(self.construction.total.root_parameters,
            self.construction.total.root_parameters + self.parser.machine_parameter_count -
            (self.construction.units[unit + 1].root_parameters - self.construction.units[unit].root_parameters))
        _ -> return 1
    }
    state slots(slot: i32, limit: i32) {
        transition slot < limit {
            true -> assign(slot, limit, self.parameter_type(source, slot))
            _ -> return 1
        }
    }
    state assign(slot: i32, limit: i32, kind: i32) {
        self.parameter_types[slot] = kind;
        transition self.require_cell(source, slot, kind) {
            1 -> slots(slot + 1, limit)
            _ -> return 0
        }
    }
}
