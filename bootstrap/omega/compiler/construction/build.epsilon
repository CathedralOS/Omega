// One fully evaluated ground Build. Its Product operands keep their authored
// source sites until the Product resolver supplies the declaration identities.
// Unsupported statements cannot produce a partial set of choices.
data ConstructionBuildResult {
    name: OmegaRelativeSpan;
    // Build-local machines occupy a suffix of parser storage. Product
    // lookup sees only the prefix; helpers retain their original lexical file.
    first_machine: i32;
    is_application: i32;
    // Populated from the embedding's two verified roots before Build execution.
    // Only the registered Product path can activate the selected supplier.
    location: [u8; 4096];
    location_length: i32;
    registered: i32;
    machine_end: i32;
    calls_active: [i32; 4096];
    selected_targets: [i32; 6];
    entry: OmegaRelativeSpan;
    entry_definition: OmegaRelativeSpan;
    slot_definition: OmegaRelativeSpan;
    provider_definition: OmegaRelativeSpan;
    primitive_definition: OmegaRelativeSpan;
}

machine OmegaScalarCompiler::build_spelling(&mut self, source: &[u8], span: OmegaRelativeSpan, text: &[u8]) -> i32 {
    return self.span_equals(source, span.start, span.end, text);
}

// Closed target prelude for this construction profile. Each target has an
// independent selection. Only Alpha contributes the standalone process.
machine OmegaScalarCompiler::build_target(&mut self, source: &[u8], name: OmegaRelativeSpan) -> i32 {
    transition self.build_spelling(source, name, "alpha_bootstrap") { 1 -> return 0 _ -> windows() }
    state windows() { transition self.build_spelling(source, name, "windows_x86_64") { 1 -> return 1 _ -> linux_x64() } }
    state linux_x64() { transition self.build_spelling(source, name, "linux_x86_64") { 1 -> return 2 _ -> linux_arm() } }
    state linux_arm() { transition self.build_spelling(source, name, "linux_arm64") { 1 -> return 3 _ -> mac_arm() } }
    state mac_arm() { transition self.build_spelling(source, name, "macos_arm64") { 1 -> return 4 _ -> mac_x64() } }
    state mac_x64() { transition self.build_spelling(source, name, "macos_x86_64") { 1 -> return 5 _ -> return -1 } }
}

// The accepted activation must have the ordinary ground Build signature and
// no additional promises or states. The parser has already checked its body.
machine OmegaScalarCompiler::ground_builder(&mut self, source: &[u8], machine_id: i32) -> i32 {
    let row: OmegaMachineSyntax = self.parser.machine_items[machine_id];
    transition (row.path_member_count == 1) && (row.is_bodyless == 0) && (row.has_target == 0) &&
        (row.clause_count == 0) && (row.state_count == 1) {
        true -> state_row(self.parser.machine_states[row.first_state])
        _ -> return -1
    }
    state state_row(row: OmegaMachineStateSyntax) {
        transition (row.has_return_type == 0) && (row.requirement_count == 0) && (row.parameter_count == 1) {
            true -> parameter(row.first_parameter, self.parser.machine_parameters[row.first_parameter])
            _ -> return -1
        }
    }
    state parameter(id: i32, row: OmegaMachineParameterSyntax) {
        transition (row.is_const == 0) && (row.is_self == 0) && (self.build_prelude_name(source, row.name) == 0) &&
            (self.build_target(source, row.name) < 0) &&
            (self.file_import_named(source, self.parser.sources.unit_at(row.name.start), row.name) < 0) {
            true -> reference(id, self.parser.type_references[row.type_reference])
            _ -> return -1
        }
    }
    state reference(id: i32, row: OmegaTypeReferenceSyntax) {
        transition row.kind { OmegaTypeReferenceKind::Reference -> access(id, row) _ -> return -1 }
    }
    state access(id: i32, row: OmegaTypeReferenceSyntax) {
        transition (row.payload1 == 1) && (row.payload2 == 0) {
            true -> builder(id, self.parser.type_references[row.payload0])
            _ -> return -1
        }
    }
    state builder(id: i32, row: OmegaTypeReferenceSyntax) {
        transition row.kind { OmegaTypeReferenceKind::Named -> prelude(id, row) _ -> return -1 }
    }
    state prelude(id: i32, row: OmegaTypeReferenceSyntax) {
        transition self.span_equals(source, row.payload0, row.payload1, "BuildPlan") {
            1 -> return id
            _ -> return -1
        }
    }
}

// Accept an exact ground path expression with the required arity. Returning
// its first path member preserves the occurrence rather than inventing a name.
machine OmegaScalarCompiler::build_path_argument(&mut self, index: i32, width: i32) -> i32 {
    let row: OmegaExpressionSyntax = self.parser.expressions[self.parser.call_arguments[index]];
    transition row.kind { OmegaExpressionKind::Path -> path(row) _ -> return -1 }
    state path(row: OmegaExpressionSyntax) {
        transition row.path_kind { OmegaPathExpressionKind::Name -> members(row) _ -> return -1 }
    }
    state members(row: OmegaExpressionSyntax) {
        transition (row.payload1 == width) && (row.payload3 == width) {
            true -> return row.payload0
            _ -> return -1
        }
    }
}

// The ground Build selects its product by assigning the builder's product field.
machine OmegaScalarCompiler::assign_build_product(&mut self, source: &[u8], handle: OmegaRelativeSpan,
    package: i32, assignment: OmegaAssignmentStatementSyntax, execute: i32) -> i32 {
    let target: OmegaExpressionSyntax = self.parser.expressions[assignment.target];
    transition target.kind { OmegaExpressionKind::Path -> path(target) _ -> return 0 }
    state path(target: OmegaExpressionSyntax) {
        transition target.path_kind { OmegaPathExpressionKind::Member -> field(target) _ -> return 0 }
    }
    state field(target: OmegaExpressionSyntax) {
        transition (target.payload1 == 2) && (target.payload3 == 1) &&
            (self.parser.sources.equal_name(source, self.parser.members[target.payload0], handle) == 1) &&
            (self.build_spelling(source, self.parser.members[target.payload0 + 1], "product") == 1) &&
            ((execute == 0) || (self.build.name.end == 0)) {
            true -> value(self.parser.expressions[assignment.value])
            _ -> return 0
        }
    }
    state value(row: OmegaExpressionSyntax) {
        transition row.kind { OmegaExpressionKind::StructLiteral -> product(self.parser.struct_literals[row.payload0]) _ -> return 0 }
    }
    state product(row: OmegaStructLiteralSyntax) {
        transition (row.type_member_count == 2) && (row.field_count == 1) && (row.has_omission == 0) &&
            (self.build_spelling(source, self.parser.members[row.first_type_member], "BuildProduct") == 1) {
            true -> variant(self.parser.members[row.first_type_member + 1], self.parser.struct_literal_fields[row.first_field])
            _ -> return 0
        }
    }
    state variant(name: OmegaRelativeSpan, field: OmegaStructLiteralFieldSyntax) {
        transition (self.build_spelling(source, field.name, "name") == 1) &&
            (((self.build.is_application == 1) && (self.build_spelling(source, name, "Application") == 1)) ||
             ((self.build.is_application == 0) && (self.build_spelling(source, name, "Package") == 1))) {
            true -> literal(self.parser.expressions[field.value])
            _ -> return 0
        }
    }
    state literal(row: OmegaExpressionSyntax) {
        transition row.kind { OmegaExpressionKind::String -> named(row.payload0 + 1, row.payload1 - 1) _ -> return 0 }
    }
    state named(start: i32, end: i32) {
        let name: OmegaRelativeSpan = self.parser.sources.packages[package].name;
        transition (self.parser.sources.identifier_range(source, start, end) == 1) &&
            (self.span_equals(source, start, end, source[name.start..name.end]) == 1) {
            true -> retain_name(start, end)
            _ -> return 0
        }
    }
    state retain_name(start: i32, end: i32) {
        transition execute { 1 -> save_name(start, end) _ -> return 1 }
    }
    state save_name(start: i32, end: i32) { self.build.name.start = start; self.build.name.end = end; return 1; }
}

machine OmegaScalarCompiler::run_build_operation(&mut self, source: &[u8], handle: OmegaRelativeSpan,
    call: OmegaCallStatementSyntax, execute: i32) -> i32 {
    transition (call.acknowledgements == 0) && (call.name_member_count == 2) &&
        (call.receiver_member_count == 1) && (call.receiver_starts_at_self == 0) && (call.argument_count > 0) {
        true -> receiver(self.parser.members[call.first_receiver_member], self.parser.members[call.target_member])
        _ -> return 0
    }
    state receiver(first: OmegaRelativeSpan, name: OmegaRelativeSpan) {
        transition (self.build_spelling(source, first, "Build") == 1) && (self.read_query(source, first.start, name.end) == 2) {
            true -> builder(name, self.build_path_argument(call.first_argument, 1))
            _ -> return 0
        }
    }
    state builder(name: OmegaRelativeSpan, member: i32) {
        transition (member >= 0) && (self.parser.sources.equal_name(source, handle, self.parser.members[member]) == 1) {
            true -> operation(name)
            _ -> return 0
        }
    }
    state operation(name: OmegaRelativeSpan) {
        transition self.build_spelling(source, name, "bind") {
            1 -> bind()
            _ -> selection(name)
        }
    }
    state bind() {
        transition (self.build.is_application == 1) && ((execute == 0) || (self.build.entry.end == 0)) &&
            (call.argument_count == 3) && (call.machine_argument_count == 0) {
            true -> target(self.build_path_argument(call.first_argument + 1, 2), self.build_path_argument(call.first_argument + 2, 1))
            _ -> return 0
        }
    }
    state target(id: i32, implementation: i32) {
        transition (id >= 0) && (implementation >= 0) &&
            (self.parser.sources.equal_name(source, handle, self.parser.members[implementation]) == 0) &&
            (self.build_spelling(source, self.parser.members[id], "alpha_bootstrap") == 1) &&
            (self.build_spelling(source, self.parser.members[id + 1], "ProgramEntry") == 1) &&
            (self.read_query(source, self.parser.members[id].start, self.parser.members[id + 1].end) == 2) {
            true -> retain_entry(implementation)
            _ -> return 0
        }
    }
    state retain_entry(implementation: i32) {
        let site: OmegaRelativeSpan = self.parser.members[implementation];
        transition self.resolve_declaration(source, site.start, site.end, OmegaDeclarationKind::Machine) >= 0 {
            true -> keep_entry(site)
            _ -> return 0
        }
    }
    state keep_entry(site: OmegaRelativeSpan) { transition execute { 1 -> save_entry(site) _ -> return 1 } }
    state save_entry(site: OmegaRelativeSpan) { self.build.entry = site; return 1; }
    state selection(name: OmegaRelativeSpan) {
        transition (self.build_spelling(source, name, "select_provider") == 1) &&
            (call.argument_count == 2) && (call.machine_argument_count == 2) {
            true -> selected(self.build_path_argument(call.first_argument + 1, 1))
            _ -> return 0
        }
    }
    state selected(target_id: i32) {
        transition target_id >= 0 {
            true -> target_choice(self.build_target(source, self.parser.members[target_id]))
            _ -> return 0
        }
    }
    state target_choice(target: i32) {
        transition (target >= 0) && ((execute == 0) || (self.build.selected_targets[target] == 0)) {
            true -> choice(target, self.parser.static_machine_arguments[call.first_machine_argument],
                self.parser.static_machine_arguments[call.first_machine_argument + 1])
            _ -> return 0
        }
    }
    state choice(target: i32, slot: OmegaStaticMachineArgumentSyntax, provider: OmegaStaticMachineArgumentSyntax) {
        transition (self.parser.sources.equal_name(source, handle, self.parser.members[slot.first_path_member]) == 0) &&
            (self.parser.sources.equal_name(source, handle, self.parser.members[provider.first_path_member]) == 0) &&
            (self.exit_service >= 0) && (self.exit_primitive >= 0) &&
            (self.resolve_declaration(source, slot.start, slot.end, OmegaDeclarationKind::Service) == self.exit_service) {
            true -> provider_id(target, self.resolve_declaration(source, provider.start, provider.end,
                OmegaDeclarationKind::Implementation))
            _ -> return 0
        }
    }
    state provider_id(target: i32, implementation: i32) {
        transition implementation >= 0 {
            true -> supplies(target, implementation, self.parser.implementations[implementation].trait_name)
            _ -> return 0
        }
    }
    state supplies(target: i32, implementation: i32, name: OmegaRelativeSpan) {
        transition self.resolve_declaration(source, name.start, name.end, OmegaDeclarationKind::Service) == self.exit_service {
            true -> checked(target, implementation)
            _ -> return 0
        }
    }
    state checked(target: i32, implementation: i32) {
        transition execute { 1 -> selected_target(target, implementation) _ -> return 1 }
    }
    state selected_target(target: i32, implementation: i32) {
        self.build.selected_targets[target] = 1;
        transition target { 0 -> alpha(implementation) _ -> return 1 }
    }
    state alpha(implementation: i32) {
        self.build.slot_definition = self.declaration_name(OmegaDeclarationKind::Service, self.exit_service);
        self.build.provider_definition = self.declaration_name(OmegaDeclarationKind::Implementation, implementation);
        self.build.primitive_definition = self.declaration_name(OmegaDeclarationKind::BoundaryMachine, self.exit_primitive);
        return 1;
    }
}

// An empty activated Build still has to be parsed and typed. Uncalled helpers
// and additional scope units require the more general Build evaluator.
machine OmegaScalarCompiler::empty_build(&mut self, source: &[u8], start: i32, end: i32) -> i32 {
    self.parser.reset_syntax();
    self.parser.append_unit(source[0..end], start);
    transition self.parser.status {
        OmegaParserStatus::Complete -> declaration()
        _ -> return 0
    }
    state declaration() {
        transition (self.parser.root_count == 1) && (self.parser.machine_count == 1) &&
            (self.ground_builder(source, 0) >= 0) &&
            (self.build_spelling(source, self.parser.members[self.parser.machine_items[0].first_path_member], "build") == 1) {
            true -> return self.parser.machine_states[self.parser.machine_items[0].first_state].statement_count == 0
            _ -> return 0
        }
    }
}

// The invocation supplies a validated temporary scope row at config. Parse
// the Product and Build separately, then rejoin each inert occurrence using
// the ordinary Product visibility resolver in the Build's file scope.
machine OmegaScalarCompiler::check_ground_application(&mut self, source: &[u8], config: i32,
    entry_unit: i32, requested: OmegaRelativeSpan, application: i32) -> i32 {
    self.construction.active = 0;
    self.build.is_application = application;
    self.build.registered = 0;
    self.build.name.end = 0;
    self.build.entry.end = 0;
    self.build.entry_definition.end = 0;
    self.build.slot_definition.end = 0;
    self.build.provider_definition.end = 0;
    self.build.primitive_definition.end = 0;
    transition (config > 0) && (config < 512) && (entry_unit >= 0) && (entry_unit < config) &&
        (self.parser.sources.unit_count == config + 1) && (self.parser.sources.valid(source) == 1) {
        true -> products()
        _ -> return 0
    }
    state products() {
        self.parser.sources.unit_count = config;
        self.parser.parse_set(source);
        self.parser.sources.unit_count = config + 1;
        transition self.parser.status {
            OmegaParserStatus::Complete -> scope(self.parser.machine_count, self.parser.use_count, self.parser.root_count)
            _ -> return 0
        }
    }
    state scope(machines: i32, imports: i32, roots: i32) {
        self.parser.unit_index = config;
        self.parser.retain_unit_namespace(source, config, self.parser.sources.units[config].path);
        transition self.parser.status {
            OmegaParserStatus::Complete -> parse(machines, imports, roots, self.parser.sources.units[config])
            _ -> return 0
        }
    }
    state parse(machines: i32, imports: i32, roots: i32, row: OmegaSourceUnit) {
        self.parser.append_unit(source[0..row.end], row.start);
        transition self.parser.status {
            OmegaParserStatus::Complete -> configuration(machines, imports, roots)
            _ -> return 0
        }
    }
    state configuration(machines: i32, imports: i32, roots: i32) {
        self.build.first_machine = machines;
        self.build.machine_end = self.parser.machine_count;
        // Exclude Build helpers from the Product resolver. Their parser rows
        // remain available to the separate local-call resolver below.
        self.parser.machine_count = machines;
        transition (self.build.machine_end > machines) &&
            (self.parser.root_count - roots == self.parser.use_count - imports + self.build.machine_end - machines) &&
            (self.validate_imports(source, config) == 1) && (self.check_service_declarations(source) == 1) &&
            (self.check_terminal_suppliers(source) == 1) {
            true -> imports_safe(imports)
            _ -> return 0
        }
    }
    state imports_safe(index: i32) {
        transition index < self.parser.use_count {
            true -> imported(index, self.parser.uses[index])
            _ -> definitions(self.build.first_machine, -1)
        }
    }
    state imported(index: i32, row: OmegaUseSyntax) {
        let name: OmegaRelativeSpan = self.parser.members[row.first_member + row.member_count - 1];
        transition (self.build_prelude_name(source, name) == 0) && (self.build_target(source, name) < 0) &&
            (self.local_build_machine(source, name) == -1) {
            true -> imports_safe(index + 1)
            _ -> return 0
        }
    }
    state definitions(index: i32, entry: i32) {
        transition index < self.build.machine_end {
            true -> definition(index, entry, self.parser.members[self.parser.machine_items[index].first_path_member])
            _ -> reset_choices(entry, 0)
        }
    }
    state definition(index: i32, entry: i32, name: OmegaRelativeSpan) {
        self.build.calls_active[index] = 0;
        transition (self.ground_builder(source, index) >= 0) && (self.local_build_machine(source, name) == index) &&
            (self.build_target(source, name) < 0) && (self.build_prelude_name(source, name) == 0) {
            true -> validate(index, entry, name)
            _ -> return 0
        }
    }
    state validate(index: i32, entry: i32, name: OmegaRelativeSpan) {
        transition self.run_build_body(source, self.parser.sources.units[config].package, index, 0) {
            1 -> is_entry(index, entry, name)
            _ -> return 0
        }
    }
    state is_entry(index: i32, entry: i32, name: OmegaRelativeSpan) {
        transition self.build_spelling(source, name, "build") {
            1 -> definitions(index + 1, index)
            _ -> definitions(index + 1, entry)
        }
    }
    state reset_choices(entry: i32, target: i32) {
        transition target < 6 { true -> reset(entry, target) _ -> activate(entry) }
    }
    state reset(entry: i32, target: i32) {
        self.build.selected_targets[target] = 0;
        transition true { true -> reset_choices(entry, target + 1) }
    }
    state activate(entry: i32) {
        transition (entry >= 0) && (self.run_build_body(source, self.parser.sources.units[config].package, entry, 1) == 1) &&
            (self.build.name.end > 0) {
            true -> role()
            _ -> return 0
        }
    }
    state role() {
        transition application { 1 -> application_root() _ -> return self.build.entry.end == 0 }
    }
    state application_root() {
        transition ((self.build.location_length == 0) || (self.build.registered == 1)) &&
            (self.build.entry.end > 0) {
            true -> entry(self.resolve_declaration(source, self.build.entry.start, self.build.entry.end, OmegaDeclarationKind::Machine))
            _ -> return 0
        }
    }
    state entry(index: i32) {
        transition index >= 0 {
            true -> owner(self.declaration_name(OmegaDeclarationKind::Machine, index))
            _ -> return 0
        }
    }
    state owner(name: OmegaRelativeSpan) {
        transition (self.parser.sources.unit_at(name.start) == entry_unit) &&
            (self.parser.sources.equal_name(source, name, requested) == 1) {
            true -> bound(name)
            _ -> return 0
        }
    }
    state bound(name: OmegaRelativeSpan) { self.build.entry_definition = name; return 1; }
}

// Search only the activated Build file. A repeated spelling is ambiguous.
machine OmegaScalarCompiler::local_build_machine(&mut self, source: &[u8], name: OmegaRelativeSpan) -> i32 {
    transition true { true -> scan(self.build.first_machine, -1) }
    state scan(index: i32, found: i32) {
        transition index < self.build.machine_end {
            true -> candidate(index, found, self.parser.machine_items[index])
            _ -> return found
        }
    }
    state candidate(index: i32, found: i32, row: OmegaMachineSyntax) {
        transition self.parser.sources.equal_name(source, name, self.parser.members[row.first_path_member]) {
            1 -> match_name(index, found)
            _ -> scan(index + 1, found)
        }
    }
    state match_name(index: i32, found: i32) {
        transition found < 0 { true -> scan(index + 1, index) _ -> return -2 }
    }
}

// Check every body's calls once. Only an activated call executes a helper and
// publishes its choices. Active calls are cleared on every return, including
// failure, so a recursive activation cannot loop or leak a partial resolution.
machine OmegaScalarCompiler::run_build_body(&mut self, source: &[u8], package: i32,
    machine_id: i32, execute: i32) -> i32 {
    let body: OmegaMachineStateSyntax = self.parser.machine_states[self.parser.machine_items[machine_id].first_state];
    return self.visit_build_statements(source, package, machine_id, execute, body,
        self.parser.machine_parameters[body.first_parameter].name);
}

machine OmegaScalarCompiler::visit_build_statements(&mut self, source: &[u8], package: i32,
    machine_id: i32, execute: i32, body: OmegaMachineStateSyntax, handle: OmegaRelativeSpan) -> i32 {
    transition (execute == 0) || (self.build.calls_active[machine_id] == 0) {
        true -> enter()
        _ -> return 0
    }
    state enter() {
        self.build.calls_active[machine_id] = execute;
        transition true { true -> next(0) }
    }
    state next(offset: i32) {
        transition offset < body.statement_count {
            true -> statement(offset, self.parser.statements[body.first_statement + offset])
            _ -> finish(1)
        }
    }
    state statement(offset: i32, row: OmegaStatementSyntax) {
        transition row.kind {
            OmegaStatementKind::Call -> call(offset, self.parser.call_statements[row.item_index])
            OmegaStatementKind::LocalData -> registration(offset, self.parser.local_data_statements[row.item_index])
            OmegaStatementKind::Assignment -> after(offset, self.assign_build_product(source, handle, package,
                self.parser.assignment_statements[row.item_index], execute))
            _ -> finish(0)
        }
    }
    // This profile consumes the registration result in a final immutable local.
    // A later statement using the registration needs ordinary local execution.
    state registration(offset: i32, row: OmegaLocalDataStatementSyntax) {
        transition (offset + 1 == body.statement_count) && (self.build.is_application == 1) &&
            (self.build.location_length > 0) && (self.parser.sources.equal_name(source, row.name, handle) == 0) &&
            (row.is_mutable == 0) && (row.has_initial_value == 1) && (self.check_path_registration(source, handle, row) == 1) {
            true -> registration_result(offset)
            _ -> finish(0)
        }
    }
    state registration_result(offset: i32) {
        transition execute { 0 -> next(offset + 1) _ -> register(offset) }
    }
    state register(offset: i32) {
        transition self.build.registered == 0 { true -> recorded(offset) _ -> finish(0) }
    }
    state recorded(offset: i32) { self.build.registered = 1; transition true { true -> next(offset + 1) } }
    state call(offset: i32, site: OmegaCallStatementSyntax) {
        transition site.name_member_count {
            1 -> local(offset, site, self.parser.members[site.target_member])
            _ -> after(offset, self.run_build_operation(source, handle, site, execute))
        }
    }
    state local(offset: i32, site: OmegaCallStatementSyntax, name: OmegaRelativeSpan) {
        transition (site.receiver_member_count == 0) && (site.receiver_starts_at_self == 0) &&
            (site.acknowledgements == 0) && (site.machine_argument_count == 0) && (site.argument_count == 1) &&
            (self.parser.sources.equal_name(source, handle, name) == 0) {
            true -> argument(offset, self.local_build_machine(source, name), self.build_path_argument(site.first_argument, 1))
            _ -> finish(0)
        }
    }
    state argument(offset: i32, callee: i32, member: i32) {
        transition (callee >= 0) && (member >= 0) &&
            (self.parser.sources.equal_name(source, handle, self.parser.members[member]) == 1) {
            true -> dispatch(offset, callee)
            _ -> finish(0)
        }
    }
    state dispatch(offset: i32, callee: i32) {
        transition execute { 1 -> after(offset, self.run_build_body(source, package, callee, 1)) _ -> next(offset + 1) }
    }
    state after(offset: i32, result: i32) { transition result { 1 -> next(offset + 1) _ -> finish(0) } }
    state finish(result: i32) { self.build.calls_active[machine_id] = 0; return result; }
}
