// GRAMMAR.md: each @ forms one reference or borrow, including adjacent tokens.
machine f(a: @@u8, b: @@mutable u8, out: @'a write u8, write: @write) {
    _ = @@a;
    _ = @ @a;
    _ = @mutable a;
    _ = @write a;
    _ = @write;
    _ = check::<@u8>(@a, mask & bits) && enabled;
    _ = mask&@a;
    _ = enabled&&@b;
    _ = check::<@@u8, (@a)>(@b);
    _ = a && b;
}
