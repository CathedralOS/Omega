// Policy-qualified integers compare their stored values. Every comparison returns bool.
use core;

public machine == equal<const N:u64>(left:u<N> in Wrapping, right:u<N> in Wrapping) -> bool
    requires N > 0 crashes none
{ (left as -u<N>::Wrapping) == (right as -u<N>::Wrapping) }

public machine == equal<const N:u64>(left:u<N> in Wrapping, right:u<N>) -> bool
    requires N > 0 crashes none
{ (left as -u<N>::Wrapping) == right }

public machine == equal<const N:u64>(left:u<N>, right:u<N> in Wrapping) -> bool
    requires N > 0 crashes none
{ left == (right as -u<N>::Wrapping) }

public machine == equal<const N:u64>(left:u<N> in Saturating, right:u<N> in Saturating) -> bool
    requires N > 0 crashes none
