public machine [] read<Element [copy]>(items: @[Element], index: u64) -> Element
    requires index < items.length
    reaches none crashes none;

public machine [] element<Element>(items: @[Element], index: u64) -> @Element
    requires index < items.length
    reaches none crashes none;

public machine [] element_mut<Element>(items: @mutable [Element], index: u64) -> @mutable Element
    requires index < items.length
    reaches none crashes none;

public machine [..] range<Element>(items: @[Element], start: u64, end: u64) -> @[Element]
    requires start <= end
    requires end <= items.length
    ensures result.length == end - start
    reaches none crashes none;

public machine [..] range_mut<Element>(items: @mutable [Element], start: u64, end: u64) -> @mutable [Element]
    requires start <= end
    requires end <= items.length
    ensures result.length == end - start
    reaches none crashes none;
