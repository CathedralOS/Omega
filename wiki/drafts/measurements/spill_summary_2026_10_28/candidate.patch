+use super::*;
+use std::collections::BTreeMap;
+
+fn raw_candidate(
+    block_count: usize,
+    accesses: Vec<(usize, usize, Event)>,
+    terminal_loads: Vec<usize>,
+) -> RawCandidateSlots {
+    RawCandidateSlots {
+        block_count,
+        invalid: vec![false],
+        accesses: vec![accesses],
+        terminal_loads: vec![terminal_loads],
+        finalized: vec![None],
+    }
+}
+
+#[test]
+fn candidate_summary_preserves_last_events_and_empty_blocks() {
+    for block_count in [0, 1, 4, 17] {
+        for event_count in [0, 1, 64, 257] {
+            if block_count == 0 && event_count != 0 {
+                continue;
+            }
+            let mut accesses = Vec::new();
+            let mut expected = BTreeMap::new();
+            for sequence in 0..event_count {
+                let block = (sequence * 7 + sequence / 3) % block_count;
+                let instruction = (sequence * 11 + sequence / 5) % 13;
+                let event = if sequence % 3 == 0 {
+                    Event::ExistingStore
+                } else {
+                    Event::ExistingLoad
+                };
+                accesses.push((block, instruction, event));
+                expected.insert((block, instruction), event);
+            }
+            let terminal_loads = if block_count == 0 {
+                vec![]
+            } else {
+                vec![block_count - 1; 2]
+            };
+            let mut raw = raw_candidate(block_count, accesses, terminal_loads.clone());
+            let candidate = raw.get(0).unwrap();
+            let mut expected_store_blocks = Vec::new();
+            let mut expected_load_blocks = Vec::new();
+            let mut expected_entry_insensitive = true;
+            for block in 0..block_count {
+                let row: Vec<_> = expected
+                    .iter()
+                    .filter_map(|(&(owner, instruction), &event)| {
+                        (owner == block).then_some((block, instruction, event))
+                    })
+                    .collect();
+                assert_eq!(candidate.block_accesses(block), row);
+                let last_store = row.iter().rev().find_map(|&(_, instruction, event)| {
+                    (event == Event::ExistingStore).then_some(instruction)
+                });
+                assert_eq!(candidate.last_existing_store[block], last_store);
+                assert_eq!(
+                    candidate.terminal_loads[block],
+                    terminal_loads.contains(&block)
+                );
+                if last_store.is_some() {
+                    expected_store_blocks.push(block);
+                }
+                if terminal_loads.contains(&block)
+                    || row.iter().any(|entry| entry.2 == Event::ExistingLoad)
+                {
+                    expected_load_blocks.push(block);
+                    expected_entry_insensitive &= row
+                        .first()
+                        .is_some_and(|entry| entry.2 == Event::ExistingStore);
+                }
+            }
+            assert_eq!(candidate.store_blocks, expected_store_blocks);
+            assert_eq!(candidate.load_blocks, expected_load_blocks);
+            assert_eq!(candidate.is_entry_insensitive, expected_entry_insensitive);
+            raw.invalid[0] = true;
+            assert!(
+                raw.get(0).is_none(),
+                "invalidated slots must not expose a cached summary"
+            );
+        }
+    }
+}
+
+#[test]
+fn candidate_summary_distinguishes_disjoint_and_destructive_windows() {
+    let mut raw = raw_candidate(
+        1,
+        vec![(0, 4, Event::ExistingLoad), (0, 0, Event::ExistingStore)],
+        vec![],
+    );
+    let candidate = raw.get(0).unwrap();
+    for (store, load, expected) in [(5, 6, true), (2, 3, false)] {
+        let window = WindowSummary {
+            boundary_store: vec![false],
+            anchored_stores: vec![vec![store]],
+            last_store: vec![Some(StorePosition::Instruction(store))],
+            has_loads: vec![true],
+            store_blocks: vec![0],
+            load_blocks: vec![0],
+            active_blocks: vec![0],
+            is_entry_insensitive: true,
+        };
+        assert_eq!(
+            shareable(
+                candidate,
+                &window,
+                &[vec![]],
+                &[vec![load]],
+                &[false],
+                &mut ShareableScratch::new(1)
+            ),
+            expected
+        );
+    }
+}
