+/// Temporary whole-compile attribution. Removed after the profile capture.
+pub mod measurement_probe {
+    use std::sync::OnceLock;
+
+    fn enabled() -> bool {
+        static FLAG: OnceLock<bool> = OnceLock::new();
+        *FLAG.get_or_init(|| std::env::var_os("OMEGA_RESOLUTION_MEASURE").is_some())
+    }
+
+    pub struct Scope {
+        label: &'static str,
+        start: Option<std::time::Instant>,
+    }
+
+    impl Scope {
+        pub fn begin(label: &'static str) -> Self {
+            Self {
+                label,
+                start: enabled().then(std::time::Instant::now),
+            }
+        }
+    }
+
+    impl Drop for Scope {
+        fn drop(&mut self) {
+            if let Some(start) = self.start {
+                eprintln!(
+                    "RESMEASURE\t{:?}\tscope\t{}\t{}",
+                    std::thread::current().id(),
+                    self.label,
+                    start.elapsed().as_nanos()
+                );
+            }
+        }
+    }
+
+    pub fn observe_clone(label: &'static str, rows: usize, started: std::time::Instant) {
+        if enabled() {
+            eprintln!(
+                "RESMEASURE\t{:?}\tclone\t{}\t{}\trows={}",
+                std::thread::current().id(),
+                label,
+                started.elapsed().as_nanos(),
+                rows
+            );
+        }
+    }
+
+    pub fn start() -> Option<std::time::Instant> {
+        enabled().then(std::time::Instant::now)
+    }
+}
