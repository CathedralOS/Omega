+                        }
+                        .ok_or(())
+                    })
+                    .collect::<Result<Vec<_>, _>>()?;
+                Ok((index >= expression_frontier).then_some(occurrences))
+            })
+            .collect::<Result<Vec<_>, _>>()?;
