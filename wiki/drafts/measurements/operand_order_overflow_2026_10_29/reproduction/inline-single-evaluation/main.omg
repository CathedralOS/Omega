public machine abs_i32(value: i32) -> i32
requires value > -2147483648
ensures result >= 0 &&
    ((value < 0 && result == 0 - value) || (value >= 0 && result == value))
{
    transition { value < 0 -> (0 - value) _ -> (value) }
}



data Counter { calls: u32 in Wrapping; }

machine step(counter: &mut Counter) -> i32 ensures result >= -2 && result <= -2 {
    counter.calls = counter.calls + 1u32;
    -2i32
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { calls: 0u32 };
    let observed: i32 = abs_i32(step(&mut counter) + 1i32);
    let calls: u32 in Wrapping = counter.calls;
    transition observed == 1i32 && calls == 1u32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
