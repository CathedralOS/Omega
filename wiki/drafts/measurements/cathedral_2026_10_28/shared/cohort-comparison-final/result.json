    "main.omg": "use native::main;\nuse native::native_state;\nmachine main() reaches UiNativeLayout, UiNativeFrame {\n    let size: u64 = UiNativeLayout::query(0);\n    let alignment: u64 = UiNativeLayout::query(1);\n    let mut surface: NativeUiState;\n    let mut packet: [i32; 4096];\n    packet[4081] = 480;\n    packet[4082] = 300;\n    let result: u64 = UiNativeFrame::apply(&mut surface, &mut packet);\n}\n",
    "build.omg": "machine build(builder: &mut Build) {\n    Build::application(builder, \"omega_ui_native_exports\");\n    Build::depend_as(builder, \"native\", Source::Path { location: \"../../../platform/native\" });\n    Build::select_provider<native::UiNativeLayout, native::UiNativeLayoutProvider>(builder, linux_x86_64, CompositionMode::Independent);\n    Build::select_provider<native::UiNativeFrame, native::UiNativeFrameProvider>(builder, linux_x86_64, CompositionMode::Independent);\n    Build::bind(builder, linux_x86_64::ProgramEntry, main);\n}\n"
  },
