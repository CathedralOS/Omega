    "build.omg": "machine build(builder: &mut Build) {\n    Build::application(builder, \"omega_ui_native_exports\");\n    Build::depend_as(builder, \"native\", Source::Path { location: \"C:/SoftwareDevelopmentKits/Omega/.agents/worktree/perf-spill-round/build/cathedral-baseline/Cathedral-syntax-migration/source/distribution/libraries/omega-ui/platform/native\" });\n    Build::select_provider<native::UiNativeLayout, native::UiNativeLayoutProvider>(builder, linux_x86_64, CompositionMode::Independent);\n    Build::select_provider<native::UiNativeFrame, native::UiNativeFrameProvider>(builder, linux_x86_64, CompositionMode::Independent);\n    Build::bind(builder, linux_x86_64::ProgramEntry, main);\n}\n"
