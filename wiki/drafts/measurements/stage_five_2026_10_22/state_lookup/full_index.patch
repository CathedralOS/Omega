+    /// Resolve storage membership without scanning unrelated machines. Parent
+    /// provenance wins only when the first machine declaring that parent stores
+    /// the state. Otherwise preserve the old roster search's eligibility and
+    /// exclusion of every machine carrying the parent symbol, even on malformed
+    /// duplicate input. The index retains full generations and authored order;
+    /// its freshness includes both arenas and the visible machine roster.
+    pub(super) fn stored_state_position(
+        &self,
+        state_symbol: SymbolHandle,
+    ) -> Option<(usize, usize)> {
+        if !state_symbol.is_valid() {
+            return None;
+        }
+        let symbol = self.symbols.get(state_symbol);
+        let parent = symbol.parent;
+        let parent_position = self.machine_position_by_symbol(parent);
+        let eligible = self.may_name_stored_state(symbol);
+        if parent_position.is_none() && !eligible {
+            return None;
+        }
+        self.with_state_position_index(|index| {
+            let occurrences = relationships::symbol_rows(&index.rows, state_symbol);
+            let preferred = parent_position.and_then(|parent_position| {
+                occurrences.iter().find(|(_, (machine_position, _))| {
+                    *machine_position as usize == parent_position
+                })
+            });
+            preferred
+                .or_else(|| {
+                    eligible
+                        .then(|| {
+                            occurrences.iter().find(|(_, (machine_position, _))| {
+                                self.machines()[*machine_position as usize].symbol != parent
+                            })
+                        })
+                        .flatten()
+                })
+                .map(|(_, (machine_position, state_position))| {
+                    (*machine_position as usize, *state_position as usize)
+                })
+        })
+    }
