+    /// First stored owner outside the excluded machine symbol. State rows
+    /// retain authored order among duplicate symbols; search only that group
+    /// instead of visiting every machine after a parent-membership miss.
+    pub(super) fn machine_storing_state_outside(
+        &self,
+        state_symbol: SymbolHandle,
+        excluded_machine: SymbolHandle,
+    ) -> Option<&machine::Machine> {
+        let position = self.with_state_position_index(|index| {
+            relationships::symbol_rows(&index.rows, state_symbol)
+                .iter()
+                .find(|(_, (machine_position, _))| {
+                    self.machines()[*machine_position as usize].symbol != excluded_machine
+                })
+                .map(|(_, (machine_position, _))| *machine_position as usize)
+        })?;
+        Some(&self.machines()[position])
+    }
