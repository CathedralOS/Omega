+    #[test]
+    fn stored_state_lookup_preserves_parent_preference_and_symbol_eligibility() {
+        use symbols::{SymbolKind, SymbolNameRef, SymbolTableBuilder};
+        let mut builder = SymbolTableBuilder::new();
+        let root = builder.insert_root(SymbolKind::Root, SymbolNameRef::Static("root"));
+        let owners = builder.insert_children(
+            root,
+            [
+                (SymbolKind::Machine, SymbolNameRef::Static("first")),
+                (SymbolKind::Machine, SymbolNameRef::Static("parent")),
+                (SymbolKind::Trait, SymbolNameRef::Static("trait")),
+            ],
+        );
+        let first = owners.handle_at(0);
+        let parent = owners.handle_at(1);
+        let trait_symbol = owners.handle_at(2);
+        let children = builder.insert_children(
+            parent,
+            [
+                (SymbolKind::State, SymbolNameRef::Static("state")),
+                (SymbolKind::Unknown, SymbolNameRef::Static("unknown")),
+                (SymbolKind::Machine, SymbolNameRef::Static("not_state")),
+            ],
+        );
+        let state_symbol = children.handle_at(0);
+        let unknown = children.handle_at(1);
+        let non_state = children.handle_at(2);
+        let requirement = builder
+            .insert_children(
+                trait_symbol,
+                [(SymbolKind::State, SymbolNameRef::Static("requirement"))],
+            )
+            .handle_at(0);
+        let mut program = TypedTrees::default();
+        program.symbols = builder.finish();
+        let queries = [
+            state_symbol,
+            unknown,
+            non_state,
+            requirement,
+            parent,
+            SymbolHandle::invalid(),
+        ];
+        for (owner, states) in [
+            (first, vec![state_symbol, unknown, non_state, requirement]),
+            (parent, vec![state_symbol, non_state]),
+            (parent, vec![unknown]),
+        ] {
+            let mut machine = Machine {
+                symbol: owner,
+                ..Machine::default()
+            };
+            for symbol in states {
+                program.push_machine_state(
+                    &mut machine,
+                    State {
+                        symbol,
+                        ..State::default()
+                    },
+                );
+            }
+            program.push_machine(machine);
+            assert_state_lookups_match_roster(&program, &queries);
+        }
+        assert_eq!(
+            program.machine_holding_state(state_symbol).unwrap().symbol,
+            parent
+        );
+        assert_eq!(
+            program.machine_holding_state(unknown).unwrap().symbol,
+            first
+        );
+        assert!(program.machine_holding_state(requirement).is_none());
+        // Hiding the earlier fallback must not admit the duplicate parent row.
+        let roster = program.roots.machines;
+        program.roots.machines = HandleSpan::from_parts(roster.handle_at(1), 2);
+        assert_state_lookups_match_roster(&program, &queries);
+        assert!(program.machine_holding_state(unknown).is_none());
+        let frozen = crate::FrozenTypedTrees::from(program);
+        assert_state_lookups_match_roster(&frozen, &queries);
+    }
