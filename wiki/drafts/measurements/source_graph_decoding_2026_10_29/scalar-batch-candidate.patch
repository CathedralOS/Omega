@@ -11,6 +11,28 @@ pub use compiler_storage_derive::Record;
 pub trait Record: Sized {
     fn write(&self, output: &mut RecordWriter) -> Result<(), RecordError>;
     fn read<Context>(input: &mut RecordReader<'_, Context>) -> Result<Self, RecordError>;
+
+    /// Collection owners have already charged the element/allocation budgets.
+    /// Fixed-width scalars can consume one bounded byte span; other records
+    /// retain their per-element decoding and validation.
+    fn read_sequence<Context>(
+        input: &mut RecordReader<'_, Context>,
+        length: usize,
+    ) -> Result<Vec<Self>, RecordError> {
+        let mut values = Vec::with_capacity(length);
+        for _ in 0..length {
+            values.push(Self::read(input)?);
+        }
+        Ok(values)
+    }
+
+    fn read_array<Context, const N: usize>(
+        input: &mut RecordReader<'_, Context>,
+    ) -> Result<[Self; N], RecordError> {
+        Self::read_sequence(input, N)?
+            .try_into()
+            .map_err(|_| input.error("fixed array construction failed"))
+    }
 }
 
