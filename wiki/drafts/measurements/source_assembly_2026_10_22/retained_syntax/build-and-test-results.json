[
  {
    "label": "final-check",
    "command": [
      "mbx",
      "check",
      "-p",
      "omega",
      "--all-targets",
      "--message-format=json"
    ],
    "exit": 0
  },
  {
    "label": "final-tests",
    "command": [
      "mbx",
      "nextest",
      "run",
      "--no-fail-fast",
      "-p",
      "arena",
      "-p",
      "build-declarations",
      "-p",
      "build-evaluation",
      "-p",
      "build-time-evaluation",
      "-p",
      "checked-trees",
      "-p",
      "package-compilation",
      "-p",
      "package-manager",
      "-p",
      "proof",
      "-p",
      "source",
      "-p",
      "symbol-resolved-trees",
      "-p",
      "syntax-trees",
      "-p",
      "syntax-trees-derive",
      "-p",
      "syntax-trees-to-symbol-resolved-trees",
      "-p",
      "tokens",
      "-p",
      "tokens-to-syntax-trees",
      "-p",
      "typed-trees",
      "-p",
      "validation",
      "-p",
      "source-files-to-tokens",
      "-p",
      "psi-compiler"
    ],
    "exit": 100
  },
  {
    "label": "final-clippy",
    "command": [
      "mbx",
      "clippy",
      "-p",
      "arena",
      "-p",
      "build-declarations",
      "-p",
      "build-evaluation",
      "-p",
      "build-time-evaluation",
      "-p",
      "checked-trees",
      "-p",
      "package-compilation",
      "-p",
      "package-manager",
      "-p",
      "proof",
      "-p",
      "source",
      "-p",
      "symbol-resolved-trees",
      "-p",
      "syntax-trees",
      "-p",
      "syntax-trees-derive",
      "-p",
      "syntax-trees-to-symbol-resolved-trees",
      "-p",
      "tokens",
      "-p",
      "tokens-to-syntax-trees",
      "-p",
      "typed-trees",
      "-p",
      "validation",
      "--all-targets",
      "--message-format=json"
    ],
    "exit": 0
  },
  {
    "label": "syntax-probe",
    "command": [
      "mbx",
      "build",
      "--manifest-path",
      "build/retained-syntax-ownership/syntax-probe/Cargo.toml"
    ],
    "exit": 0
  },
  {
    "label": "candidate-binaries",
    "command": [
      "python3",
      "build/retained-syntax-ownership/build_measure.py",
      "candidate"
    ],
    "exit": 0
  },
  {
    "label": "candidate-corpus",
    "command": [
      "mbx",
      "build",
      "-p",
      "compiler",
      "--test",
      "corpus_runner",
      "--message-format=json"
    ],
    "exit": 0
  }
]
