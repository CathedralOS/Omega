// Dependency-free measurable subject: no depend() edges at all, so
// `omega update` settles the review with no dependency findings and
// tools/benchmark can measure compile-time, peak-memory, code-size, and
// runtime rows on any hosted target without settling a dependency graph.

machine build(builder: &mut Build) {
    Build::application(builder, "wrapping_square_sum");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    // The staged Psi-phase promotion records cite this subject's benchmark
    // rows as measurement evidence; enabling the complete six-rule selection
    // here lets each rule's `disabled` row measure its marginal cost.
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::SparseConditionalConstantPropagation,
    );
    Optimizations::enable(&mut builder.optimizations, Optimization::CopyPropagation);
    Optimizations::enable(&mut builder.optimizations, Optimization::GlobalValueNumbering);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::DeadPureScalarElimination,
    );
    Optimizations::enable(&mut builder.optimizations, Optimization::ProofCheckElision);
}
