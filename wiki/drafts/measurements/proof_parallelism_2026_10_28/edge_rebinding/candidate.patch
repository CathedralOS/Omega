 use semantic_vocabulary::{Proposition, ScalarTerm, ValueId};
 use std::borrow::Borrow;
 use std::collections::BTreeMap;
+use std::sync::Arc;
+
+/// One edge's fixed substitution, retaining only its last immutable input.
+pub(super) struct ScalarArrivalRebinding {
+    bindings: Vec<(ValueId, ScalarTerm)>,
+    parameters: Vec<ValueId>,
+    incoming: Arc<Vec<Arc<Proposition>>>,
+    rebound: Vec<Arc<Proposition>>,
+}
+
+impl ScalarArrivalRebinding {
+    pub(super) fn new(
+        bindings: &[(ValueId, ScalarTerm)],
+        parameters: &[ValueId],
+        incoming: &Arc<Vec<Arc<Proposition>>>,
+    ) -> Self {
+        Self {
+            bindings: bindings.to_vec(),
+            parameters: parameters.to_vec(),
+            incoming: incoming.clone(),
+            rebound: arrival_requirements(incoming, bindings, parameters)
+                .into_iter()
+                .map(Arc::new)
+                .collect(),
+        }
+    }
+
+    pub(super) fn requirements(
+        &mut self,
+        incoming: &Arc<Vec<Arc<Proposition>>>,
+    ) -> &[Arc<Proposition>] {
+        // Holding the input keeps its allocation immutable and prevents address reuse.
+        if !Arc::ptr_eq(&self.incoming, incoming) {
+            self.rebound = arrival_requirements(incoming, &self.bindings, &self.parameters)
+                .into_iter()
+                .map(Arc::new)
+                .collect();
+            self.incoming = incoming.clone();
+        }
+        &self.rebound
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use semantic_vocabulary::ScalarType;
+
+    #[test]
+    fn payload_scalar_rebinding_reuses_only_the_exact_immutable_input() {
+        let identity = |value| ValueId::new(value).unwrap();
+        let value = |value| ScalarTerm::value(identity(value), ScalarType::Boolean);
+        let bindings = vec![(identity(1), value(2)), (identity(2), value(1))];
+        let parameters = vec![identity(1), identity(2), identity(3)];
+        for mask in 0..16 {
+            let mut incoming = Arc::new(
+                (1..=4)
+                    .filter(|index| mask & (1 << (index - 1)) != 0)
+                    .map(|index| {
+                        Arc::new(Proposition::Equal(value(index), ScalarTerm::Boolean(true)))
+                    })
+                    .collect::<Vec<_>>(),
+            );
+            let mut cache = ScalarArrivalRebinding::new(&bindings, &parameters, &incoming);
+            let expected = arrival_requirements(&incoming, &bindings, &parameters);
+            assert_eq!(
+                cache
+                    .requirements(&incoming)
+                    .iter()
+                    .map(Arc::as_ref)
+                    .collect::<Vec<_>>(),
+                expected.iter().collect::<Vec<_>>()
+            );
+            let retained = cache.requirements(&incoming).to_vec();
+            assert!(
+                cache
+                    .requirements(&incoming)
+                    .iter()
+                    .zip(&retained)
+                    .all(|(left, right)| Arc::ptr_eq(left, right))
+            );
+
+            Arc::make_mut(&mut incoming).push(Arc::new(Proposition::Falsehood));
+            let expected = arrival_requirements(&incoming, &bindings, &parameters);
+            assert_eq!(
+                cache
+                    .requirements(&incoming)
+                    .iter()
+                    .map(Arc::as_ref)
+                    .collect::<Vec<_>>(),
+                expected.iter().collect::<Vec<_>>()
+            );
+
+            let equal_allocation = Arc::new(incoming.as_ref().clone());
+            assert!(!Arc::ptr_eq(&incoming, &equal_allocation));
+            assert_eq!(
+                cache
+                    .requirements(&equal_allocation)
+                    .iter()
+                    .map(Arc::as_ref)
+                    .collect::<Vec<_>>(),
+                expected.iter().collect::<Vec<_>>()
+            );
+            assert!(Arc::ptr_eq(&cache.incoming, &equal_allocation));
+        }
+    }
+}
 
