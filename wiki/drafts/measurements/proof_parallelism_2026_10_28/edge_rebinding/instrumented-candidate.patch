+}
+
+impl Probe {
+    pub(crate) fn new(operation: &'static str, machines: usize) -> Self {
+        static MODE: OnceLock<String> = OnceLock::new();
+        let mode = MODE.get_or_init(|| std::env::var("OMEGA_RECONCILE_PROBE").unwrap_or_default());
+        Self {
+            operation,
+            machines,
+            started: matches!(mode.as_str(), "timing" | "counts").then(Instant::now),
+            counting: mode == "counts",
+            values: BTreeMap::new(),
+        }
+    }
+
+    pub(crate) fn count(&mut self, name: &'static str, amount: usize) {
+        if self.counting {
+            *self.values.entry(name).or_default() += amount as u64;
+        }
+    }
+
+    pub(crate) fn clock(&self) -> Option<Instant> {
+        self.started.map(|_| Instant::now())
+    }
+
+    pub(crate) fn elapsed(&mut self, name: &'static str, started: Option<Instant>) {
+        if let Some(started) = started {
+            *self.values.entry(name).or_default() +=
+                u64::try_from(started.elapsed().as_nanos()).unwrap_or(u64::MAX);
+        }
+    }
+}
+
+impl Drop for Probe {
+    fn drop(&mut self) {
+        let Some(started) = self.started else {
+            return;
+        };
+        let elapsed = started.elapsed().as_nanos();
+        let values = self
+            .values
+            .iter()
+            .map(|(name, value)| format!("\t{name}={value}"))
+            .collect::<String>();
+        eprintln!(
+            "RECONCILE\t{}\t{}\t{}{}",
+            self.operation, self.machines, elapsed, values
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn counts_are_local_and_disabled_without_counting() {
+        let mut probe = Probe {
+            operation: "calibration",
+            machines: 0,
+            started: None,
+            counting: false,
+            values: BTreeMap::new(),
+        };
+        probe.count("visits", 2);
+        assert!(probe.values.is_empty());
+        probe.counting = true;
+        probe.count("visits", 2);
+        probe.count("visits", 3);
+        assert_eq!(probe.values["visits"], 5);
+        probe.elapsed("time_ns", None);
+        assert!(!probe.values.contains_key("time_ns"));
+    }
+}
