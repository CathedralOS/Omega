+/// Scalar terms rebuild without normalization. Mathematical embeddings and
+/// symmetric IEEE propositions can normalize even when no value is replaced.
+pub(super) fn value_substitution_may_normalize(proposition: &Proposition) -> bool {
+    match proposition {
+        Proposition::IntegerMathEqual(..)
+        | Proposition::IntegerMathLessThan(..)
+        | Proposition::IntegerMathLessOrEqual(..) => true,
+        Proposition::ScalarIeeeFloatComparison {
+            kind, left, right, ..
+        } => kind.is_symmetric() && left > right,
+        Proposition::Conjunction(parts) | Proposition::Disjunction(parts) => {
+            parts.iter().any(value_substitution_may_normalize)
+        }
+        Proposition::Implication {
+            premise,
+            conclusion,
+        } => {
+            value_substitution_may_normalize(premise)
+                || value_substitution_may_normalize(conclusion)
+        }
+        Proposition::Truth
+        | Proposition::Falsehood
+        | Proposition::Atom(_)
+        | Proposition::Equal(..)
+        | Proposition::LessThan(..)
+        | Proposition::LessOrEqual(..)
+        | Proposition::IeeeFloatComparison { .. }
+        | Proposition::ByteSequenceEqual { .. }
+        | Proposition::StructuralIdentity { .. }
+        | Proposition::StructuralCaseMembership { .. }
+        | Proposition::ContentConservation(_) => false,
+    }
+}
