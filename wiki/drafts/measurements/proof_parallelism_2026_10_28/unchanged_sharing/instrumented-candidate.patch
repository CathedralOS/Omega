+            Proposition::Falsehood,
+            condition.clone(),
+            Proposition::LessOrEqual(integer_value.clone(), integer_value),
+            math.clone(),
+            ieee.clone(),
+            Proposition::ScalarIeeeFloatComparison {
+                kind: IeeeFloatComparisonKind::LessThan,
+                format: IeeeFloatFormat::Binary64,
+                left: float(2),
+                right: float(1),
+            },
+            Proposition::Conjunction(vec![condition.clone(), math.clone()]),
+            Proposition::Disjunction(vec![condition.clone(), ieee.clone()]),
+            Proposition::Implication {
+                premise: Box::new(condition.clone()),
+                conclusion: Box::new(ieee.clone()),
+            },
+            Proposition::Equal(
+                ScalarTerm::BooleanNot {
+                    operand: Box::new(boolean(3)),
+                },
+                boolean(2),
+            ),
+        ]
+        .into_iter()
+        .map(Arc::new)
+        .collect::<Vec<_>>();
+        assert_ne!(
+            crate::substitution::substitute_proposition_values(&math, &BTreeMap::new()),
+            math
+        );
+        assert_ne!(
+            crate::substitution::substitute_proposition_values(&ieee, &BTreeMap::new()),
+            ieee
+        );
+        let binding_sets = vec![
+            vec![],
+            vec![(identity(2), boolean(1))],
+            vec![(identity(1), boolean(1))],
+            vec![(identity(2), boolean(1)), (identity(3), boolean(1))],
+            vec![(identity(1), boolean(2)), (identity(2), boolean(1))],
+            vec![(
+                identity(2),
+                ScalarTerm::BooleanNot {
+                    operand: Box::new(boolean(1)),
+                },
+            )],
+            vec![(identity(3), float(1))],
+        ];
+        for bindings in &binding_sets {
+            for retired_mask in 0..8 {
+                let parameters = (1..=3)
+                    .filter(|value| retired_mask & (1 << (value - 1)) != 0)
+                    .map(identity)
+                    .collect::<Vec<_>>();
+                let actual = arrival_requirements(&requirements, bindings, &parameters);
+                let expected = original_arrival(&requirements, bindings, &parameters);
+                assert_eq!(
+                    actual.iter().map(Arc::as_ref).collect::<Vec<_>>(),
+                    expected.iter().collect::<Vec<_>>()
+                );
+            }
+        }
+        let untouched = vec![Arc::new(condition)];
+        assert!(Arc::ptr_eq(
+            &arrival_requirements(&untouched, &[], &[])[0],
+            &untouched[0]
+        ));
+        for normalizing in [math, ieee] {
+            let input = vec![Arc::new(normalizing)];
+            let result = arrival_requirements(&input, &[], &[]);
+            assert!(!Arc::ptr_eq(&input[0], &result[0]));
+        }
+        assert!(arrival_requirements(&[], &[], &[]).is_empty());
+    }
+}
