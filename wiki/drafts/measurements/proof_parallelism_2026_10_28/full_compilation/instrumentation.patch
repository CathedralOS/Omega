+// Temporary coarse timeline. Existing fine counters remain disabled.
+fn full_enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("OMEGA_FULL_COMPILE_PROFILE").is_some_and(|v| v != "0"))
+}
+fn full_epoch() -> &'static Instant {
+    static EPOCH: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+    EPOCH.get_or_init(Instant::now)
+}
+pub struct FullGuard {
+    name: &'static str,
+    start: Option<(u128, std::thread::ThreadId)>,
+}
+pub fn full_guard(name: &'static str) -> FullGuard {
+    let start = full_enabled().then(|| {
+        let thread = std::thread::current().id();
+        (full_epoch().elapsed().as_nanos(), thread)
+    });
+    FullGuard { name, start }
+}
+fn selected_full_guard(name: &'static str) -> FullGuard {
+    let selected = full_enabled()
+        && ((name.starts_with("06.") && name.bytes().filter(|byte| *byte == b'.').count() <= 3)
+            || matches!(
+                name,
+                "psi.source.prepare"
+                    | "pre_resolution.constant_expressions"
+                    | "pre_resolution.constant_initializers"
+                    | "05"
+                    | "05.c.prepare_typed_trees"
+                    | "05.d.lower_typed_trees"
+                    | "05.d.2.prepare_typed_program"
+                    | "05.d.3.build_check_facts"
+                    | "05.d.3.a.pre_flow_facts"
+                    | "05.d.3.b.flow_fixed_point"
+                    | "05.d.3.b.flow_fixed_point.build_flow_facts"
+                    | "05.d.3.b.flow_fixed_point.prepare_permission_events"
+                    | "05.d.3.b.flow_fixed_point.bind_call_spans"
+                    | "05.d.3.b.flow_fixed_point.infer_entry_requirements"
+                    | "05.d.3.c.post_flow_facts"
+                    | "05.d.4_6.quotients_borrows_identities"
+                    | "05.d.7.check_checked_facts"
+                    | "05.d.7.3b.check_flow_call_contracts"
+                    | "05.d.8_10.finalize_execution_identities"
+                    | "05.d.8_10.a.finalize_execution"
+                    | "05.d.8_10.a.3.unit_effect_plans"
+                    | "05.d.8_10.a.3.2.candidate_bodies"
+                    | "05.d.11_13.selections_custody_types_boundaries"
+                    | "05.lower_terminal_selection"
+                    | "05.01_lower_selected_machine"
+                    | "05.01.a_discover_call_catalog"
+                    | "05.01.g1_emit_composed_body"
+                    | "05.10_reconcile_and_residences"
+            ));
+    if selected {
+        full_guard(name)
+    } else {
+        FullGuard { name, start: None }
+    }
+}
+impl Drop for FullGuard {
+    fn drop(&mut self) {
+        if let Some((start, thread)) = self.start {
+            let end = full_epoch().elapsed().as_nanos();
+            assert!(end >= start);
+            eprintln!(
+                "FULL\t{:?}\t{}\tstart_ns={}\tend_ns={}\tend_thread={:?}",
+                thread,
+                self.name,
+                start,
+                end,
+                std::thread::current().id()
+            );
+        }
+    }
+}
