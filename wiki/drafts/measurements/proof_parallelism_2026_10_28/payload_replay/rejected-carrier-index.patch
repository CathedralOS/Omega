+#[test]
+fn carrier_catalog_keeps_input_order_duplicates_and_missing_carriers() {
+    let declaration = |raw, carrier| StructuralDomainDeclaration {
+        required_memberships: None,
+        complete_predicate_theory: false,
+        predicate: None,
+        id: semantic_vocabulary::StructuralDomainId::new(raw).unwrap(),
+        semantic_domain: semantic_vocabulary::DomainSemanticId::new(raw).unwrap(),
+        identity: TerminalIdentityIndex(raw as u32),
+        carrier: StructuralTypeId::new(carrier).unwrap(),
+        content_projection: None,
+        byte_predicate: None,
+        establishment_routes: Vec::new(),
+    };
+    let domains = vec![
+        declaration(3, 1),
+        declaration(2, 2),
+        declaration(1, 1),
+        declaration(3, 1),
+    ];
+    let catalog = PayloadPredicateCatalog::new(&domains);
+    for raw in [1, 2, 9] {
+        let carrier = StructuralTypeId::new(raw).unwrap();
+        let expected = domains
+            .iter()
+            .filter(|domain| domain.carrier == carrier)
+            .collect::<Vec<_>>();
+        let actual = catalog
+            .by_carrier
+            .get(&carrier)
+            .into_iter()
+            .flatten()
+            .copied()
+            .collect::<Vec<_>>();
+        assert_eq!(actual, expected);
+    }
+}
 
