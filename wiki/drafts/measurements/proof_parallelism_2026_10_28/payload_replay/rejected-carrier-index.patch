+/// Carrier selection is immutable metadata. Each bucket retains catalog order;
+/// predicate admission still reads the complete domain catalog and current facts.
+pub(super) struct PayloadPredicateCatalog<'catalog> {
+    domains: &'catalog [StructuralDomainDeclaration],
+    by_carrier:
+        BTreeMap<semantic_vocabulary::StructuralTypeId, Vec<&'catalog StructuralDomainDeclaration>>,
+}
+
+impl<'catalog> PayloadPredicateCatalog<'catalog> {
+    pub(super) fn new(domains: &'catalog [StructuralDomainDeclaration]) -> Self {
+        let mut by_carrier: BTreeMap<_, Vec<_>> = BTreeMap::new();
+        for domain in domains {
+            by_carrier.entry(domain.carrier).or_default().push(domain);
+        }
+        Self {
+            domains,
+            by_carrier,
+        }
+    }
+
+    pub(super) fn close<Shared: Borrow<Proposition>>(
+        &self,
+        types: &[StructuralTypeDeclaration],
+        contract: &mut PayloadMembershipContract,
+        shared: &[Shared],
+        edge_predicate: Option<&Proposition>,
+    ) {
+        let candidates = self.by_carrier.get(&contract.carrier);
+        close_candidates(
+            types,
+            self.domains,
+            candidates.into_iter().flatten().copied(),
+            contract,
+            shared,
+            edge_predicate,
+        );
+    }
+}
