+//! Temporary query-scoped attribution. No semantic objects or locks are retained.
+//! Exclusive wall spans partition each source root; counts run without timers.
+use std::cell::RefCell;
+use std::sync::OnceLock;
+use std::time::Instant;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Mode {
+    Off,
+    Coarse,
+    Fine,
+    Counts,
+}
+impl Mode {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Off => "off",
+            Self::Coarse => "coarse",
+            Self::Fine => "fine",
+            Self::Counts => "counts",
+        }
+    }
+    fn timed(self) -> bool {
+        matches!(self, Self::Coarse | Self::Fine)
+    }
+}
+fn mode() -> Mode {
+    static MODE: OnceLock<Mode> = OnceLock::new();
+    *MODE.get_or_init(
+        || match std::env::var("OMEGA_REPLAY_SCAN_PROFILE").as_deref() {
+            Ok("coarse") => Mode::Coarse,
+            Ok("fine") => Mode::Fine,
+            Ok("counts") => Mode::Counts,
+            _ => Mode::Off,
+        },
+    )
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(usize)]
+pub(super) enum Label {
+    Source,
+    Replay,
+    Position,
+    Edge,
+    Meet,
+    RetainSnapshot,
+    CowShared,
+    CowUnique,
+    CowWeak,
+    SnapshotFilter,
+    Count,
+}
+const LABELS: [&str; Label::Count as usize] = [
+    "source",
+    "replay",
+    "position",
+    "edge",
+    "meet",
+    "retain_snapshot",
+    "cow_shared",
+    "cow_unique",
+    "cow_weak",
+    "snapshot_filter",
+];
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub(super) enum Metric {
+    A,
+    B,
+    C,
+    Visited,
+    Compared,
+    Advanced,
+    Cloned,
+    Removed,
+    Detached,
+    Changed,
+    Rosters,
+    Shrinks,
+    Same,
+    Alias,
+    Count,
+}
+const METRICS: [&str; Metric::Count as usize] = [
+    "rows_a", "rows_b", "rows_c", "visited", "compared", "advanced", "cloned", "removed",
+    "detached", "changed", "rosters", "shrinks", "same", "alias",
+];
+#[derive(Clone, Copy, Default)]
+struct Entry {
+    calls: u64,
+    inclusive: u128,
+    exclusive: u128,
+    work: [u64; Metric::Count as usize],
+    minimum: u128,
+    maximum: u128,
+    histogram: [u64; 16],
+}
+const LIMITS: [u128; 15] = [
+    100, 250, 500, 1000, 2000, 4000, 8000, 16000, 32000, 64000, 128000, 256000, 1000000, 4000000,
+    16000000,
+];
+struct Frame {
+    label: Label,
+    started: Instant,
+    children: u128,
+}
+struct Query {
+    machine: u64,
+    block: usize,
+    operation: usize,
+    ns: u128,
+    steps: u64,
+    edges: u64,
+    meets: u64,
+    replayed: bool,
+}
+struct Record {
+    mode: Mode,
+    machines: usize,
+    active: bool,
+    stack: Vec<Frame>,
+    entries: [Entry; Label::Count as usize],
+    queries: Vec<Query>,
+}
+impl Record {
+    fn new(mode: Mode, machines: usize) -> Self {
+        Self {
+            mode,
+            machines,
+            active: false,
+            stack: Vec::with_capacity(16),
+            entries: [Entry::default(); Label::Count as usize],
+            queries: Vec::new(),
+        }
+    }
+    fn finish_timed(&mut self, label: Label, elapsed: u128) {
+        let frame = self.stack.pop().expect("profile scope owns its frame");
+        assert_eq!(frame.label, label);
+        let entry = &mut self.entries[label as usize];
+        entry.calls += 1;
+        entry.inclusive += elapsed;
+        entry.minimum = if entry.calls == 1 {
+            elapsed
+        } else {
+            entry.minimum.min(elapsed)
+        };
+        entry.maximum = entry.maximum.max(elapsed);
+        let bin = LIMITS
+            .iter()
+            .position(|limit| elapsed <= *limit)
+            .unwrap_or(15);
+        entry.histogram[bin] += 1;
+        entry.exclusive += elapsed
+            .checked_sub(frame.children)
+            .expect("nested wall intervals do not overlap");
+        if let Some(parent) = self.stack.last_mut() {
+            parent.children += elapsed;
+        }
+    }
+}
+thread_local! { static STATE: RefCell<Option<Record>> = const { RefCell::new(None) }; }
+
+pub struct Batch(bool);
+impl Batch {
+    pub fn begin(machines: usize) -> Self {
+        let mode = mode();
+        if mode == Mode::Off {
+            return Self(false);
+        }
+        if mode.timed() {
+            static CALIBRATED: OnceLock<()> = OnceLock::new();
+            CALIBRATED.get_or_init(calibrate);
+        }
+        Self(STATE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            if slot.is_some() {
+                return false;
+            }
+            *slot = Some(Record::new(mode, machines));
+            true
+        }))
+    }
+}
+impl Drop for Batch {
+    fn drop(&mut self) {
+        if !self.0 {
+            return;
+        }
+        let Some(mut record) = STATE.with(|slot| slot.borrow_mut().take()) else {
+            return;
+        };
+        assert!(!record.active && record.stack.is_empty());
+        let root = record.entries[Label::Source as usize];
+        if record.mode.timed() {
+            assert_eq!(
+                record.entries.iter().map(|e| e.exclusive).sum::<u128>(),
+                root.inclusive
+            );
+        }
+        eprintln!(
+            "SCAN_BATCH\t{}\t{}\troots={}\treplays={}\twall_ns={}",
+            record.mode.name(),
+            record.machines,
+            record.queries.len(),
+            record.queries.iter().filter(|q| q.replayed).count(),
+            root.inclusive
+        );
+        for (name, entry) in LABELS.iter().zip(record.entries) {
+            if entry.calls == 0 {
+                continue;
+            }
+            let counters = METRICS
+                .iter()
+                .zip(entry.work)
+                .map(|(key, value)| format!("\t{key}={value}"))
+                .collect::<String>();
+            eprintln!(
+                "SCAN\t{}\t{}\t{}\tcalls={}\tinclusive_ns={}\texclusive_ns={}{}",
+                record.mode.name(),
+                record.machines,
+                name,
+                entry.calls,
+                entry.inclusive,
+                entry.exclusive,
+                counters
+            );
+            if record.mode.timed() {
+                let bins = entry
+                    .histogram
+                    .iter()
+                    .enumerate()
+                    .map(|(i, count)| format!("\tb{}={}", i, count))
+                    .collect::<String>();
+                eprintln!(
+                    "COPY_HIST\t{}\t{}\t{}\tmin_ns={}\tmax_ns={}{}",
+                    record.mode.name(),
+                    record.machines,
+                    name,
+                    entry.minimum,
+                    entry.maximum,
+                    bins
+                );
+            }
+        }
+        record
+            .queries
+            .sort_by_key(|q| std::cmp::Reverse((q.ns, q.edges)));
+        for query in record.queries.iter().filter(|q| q.replayed).take(8) {
+            eprintln!(
+                "SCAN_QUERY\t{}\t{}\tmachine={}\tblock={}\toperation={}\twall_ns={}\tsteps={}\tedges={}\tmeets={}",
+                record.mode.name(),
+                record.machines,
+                query.machine,
+                query.block,
+                query.operation,
+                query.ns,
+                query.steps,
+                query.edges,
+                query.meets
+            );
+        }
+    }
+}
+
+pub struct Source {
+    active: bool,
+    machine: u64,
+    block: usize,
+    operation: usize,
+    previous: [u64; 4],
+}
+impl Source {
+    pub fn begin(machine: u64, block: usize, operation: usize) -> Self {
+        let mut result = Self {
+            active: false,
+            machine,
+            block,
+            operation,
+            previous: [0; 4],
+        };
+        STATE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            let Some(record) = slot.as_mut().filter(|record| !record.active) else {
+                return;
+            };
+            result.previous = [Label::Replay, Label::Position, Label::Edge, Label::Meet]
+                .map(|label| record.entries[label as usize].calls);
+            record.active = true;
+            result.active = true;
+            if record.mode.timed() {
+                record.stack.push(Frame {
+                    label: Label::Source,
+                    started: Instant::now(),
+                    children: 0,
+                });
+            }
+        });
+        result
+    }
+}
+impl Drop for Source {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        STATE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            let record = slot.as_mut().unwrap();
+            let elapsed = if record.mode.timed() {
+                assert_eq!(record.stack.len(), 1);
+                let elapsed = record.stack.last().unwrap().started.elapsed().as_nanos();
+                record.finish_timed(Label::Source, elapsed);
+                elapsed
+            } else {
+                record.entries[Label::Source as usize].calls += 1;
+                0
+            };
+            let current = [Label::Replay, Label::Position, Label::Edge, Label::Meet]
+                .map(|label| record.entries[label as usize].calls);
+            record.queries.push(Query {
+                machine: self.machine,
+                block: self.block,
+                operation: self.operation,
+                ns: elapsed,
+                steps: current[1] - self.previous[1],
+                edges: current[2] - self.previous[2],
+                meets: current[3] - self.previous[3],
+                replayed: current[0] > self.previous[0],
+            });
+            record.active = false;
+        });
+    }
+}
+
+pub(super) struct Scope {
+    label: Label,
+    timed: bool,
+    counting: bool,
+    work: [u64; Metric::Count as usize],
+}
+impl Scope {
+    pub(super) fn coarse(label: Label) -> Self {
+        Self::new(label, false)
+    }
+    pub(super) fn fine(label: Label) -> Self {
+        Self::new(label, true)
+    }
+    fn new(label: Label, detail: bool) -> Self {
+        let mut result = Self {
+            label,
+            timed: false,
+            counting: false,
+            work: [0; Metric::Count as usize],
+        };
+        STATE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            let Some(record) = slot.as_mut().filter(|record| record.active) else {
+                return;
+            };
+            result.counting = record.mode == Mode::Counts;
+            result.timed = record.mode.timed() && (!detail || record.mode == Mode::Fine);
+            if result.timed {
+                record.stack.push(Frame {
+                    label,
+                    started: Instant::now(),
+                    children: 0,
+                });
+            }
+        });
+        result
+    }
+    pub(super) fn active(&self) -> bool {
+        self.timed || self.counting
+    }
+    pub(super) fn counting(&self) -> bool {
+        self.counting
+    }
+    #[inline]
+    pub(super) fn add(&mut self, metric: Metric, value: usize) {
+        if self.counting {
+            self.work[metric as usize] += value as u64;
+        }
+    }
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if !self.timed && !self.counting {
+            return;
+        }
+        STATE.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            let record = slot.as_mut().expect("source scope owns profile state");
+            if self.timed {
+                let elapsed = record.stack.last().unwrap().started.elapsed().as_nanos();
+                record.finish_timed(self.label, elapsed);
+            }
+            if self.counting {
+                let entry = &mut record.entries[self.label as usize];
+                entry.calls += 1;
+                for (total, value) in entry.work.iter_mut().zip(self.work) {
+                    *total += value;
+                }
+            }
+        });
+    }
+}
+
+fn calibrate() {
+    const ITERATIONS: usize = 20000;
+    STATE.with(|slot| {
+        assert!(slot.borrow().is_none());
+        let mut record = Record::new(Mode::Fine, 0);
+        record.active = true;
+        *slot.borrow_mut() = Some(record);
+    });
+    let started = Instant::now();
+    for _ in 0..ITERATIONS {
+        drop(Scope::fine(Label::CowShared));
+    }
+    let gross = started.elapsed().as_nanos();
+    let record = STATE.with(|slot| slot.borrow_mut().take().unwrap());
+    assert!(record.stack.is_empty());
+    let entry = record.entries[Label::CowShared as usize];
+    assert_eq!(entry.calls, ITERATIONS as u64);
+    eprintln!(
+        "COPY_CALIBRATION\titerations={}\twall_ns={}\tinterval_ns={}\tmin_ns={}\tmax_ns={}",
+        ITERATIONS, gross, entry.inclusive, entry.minimum, entry.maximum
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn payload_profile_exclusive_spans_partition_nested_time() {
+        let mut record = Record::new(Mode::Fine, 0);
+        for label in [Label::Source, Label::Meet, Label::RetainSnapshot] {
+            record.stack.push(Frame {
+                label,
+                started: Instant::now(),
+                children: 0,
+            });
+        }
+        record.finish_timed(Label::RetainSnapshot, 20);
+        record.finish_timed(Label::Meet, 50);
+        record.finish_timed(Label::Source, 80);
+        assert_eq!(
+            record
+                .entries
+                .iter()
+                .map(|entry| entry.exclusive)
+                .sum::<u128>(),
+            80
+        );
+        assert_eq!(record.entries[Label::Meet as usize].exclusive, 30);
+        assert_eq!(record.entries[Label::Source as usize].exclusive, 30);
+        assert!(record.stack.is_empty());
+        let entry = record.entries[Label::RetainSnapshot as usize];
+        assert_eq!((entry.minimum, entry.maximum), (20, 20));
+        assert_eq!(entry.histogram.iter().sum::<u64>(), entry.calls);
+        assert_eq!(entry.histogram[0], 1);
+    }
+}
