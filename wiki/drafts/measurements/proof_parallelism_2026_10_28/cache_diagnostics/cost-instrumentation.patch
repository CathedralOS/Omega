+    #[test]
+    fn payload_scalar_rebinding_reuses_only_the_exact_immutable_input() {
+        let identity = |value| ValueId::new(value).unwrap();
+        let value = |value| ScalarTerm::value(identity(value), ScalarType::Boolean);
+        let bindings = vec![(identity(1), value(2)), (identity(2), value(1))];
+        let parameters = vec![identity(1), identity(2), identity(3)];
+        for mask in 0..16 {
+            let mut incoming = Arc::new(
+                (1..=4)
+                    .filter(|index| mask & (1 << (index - 1)) != 0)
+                    .map(|index| {
+                        Arc::new(Proposition::Equal(value(index), ScalarTerm::Boolean(true)))
+                    })
+                    .collect::<Vec<_>>(),
+            );
+            let mut cache = ScalarArrivalRebinding::new(
+                &bindings,
+                &parameters,
+                &incoming,
+                &mut Probe::new("test"),
+            );
+            let expected = arrival_requirements(&incoming, &bindings, &parameters);
+            assert_eq!(
