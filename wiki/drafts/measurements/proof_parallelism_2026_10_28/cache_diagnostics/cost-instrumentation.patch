+//! Temporary, query-owned diagnostics; no global lock or proof-result cache.
+use semantic_vocabulary::Proposition;
+use std::collections::BTreeMap;
+use std::sync::{Arc, OnceLock};
+use std::time::Instant;
+
+pub(super) struct Probe {
+    kind: &'static str,
+    mode: u8,
+    started: Option<Instant>,
+    metrics: BTreeMap<&'static str, u128>,
+}
+
+impl Probe {
+    pub(super) fn new(kind: &'static str) -> Self {
+        static MODE: OnceLock<u8> = OnceLock::new();
+        let mode =
+            *MODE.get_or_init(
+                || match std::env::var("OMEGA_EDGE_REBIND_PROFILE").as_deref() {
+                    Ok("counts") => 1,
+                    Ok("timing") => 2,
+                    _ => 0,
+                },
+            );
+        Self {
+            kind,
+            mode,
+            started: (mode == 2).then(Instant::now),
+            metrics: BTreeMap::new(),
+        }
+    }
+
+    pub(super) fn cache_enabled() -> bool {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        *ENABLED.get_or_init(|| std::env::var("OMEGA_EDGE_CACHE").as_deref() != Ok("off"))
+    }
+
+    pub(super) fn active(&self) -> bool {
+        self.mode != 0
+    }
+    pub(super) fn counts(&self) -> bool {
+        self.mode == 1
+    }
+    pub(super) fn clock(&self) -> Option<Instant> {
+        (self.mode == 2).then(Instant::now)
+    }
+    pub(super) fn count(&mut self, name: &'static str, value: u128) {
+        if self.active() {
+            *self.metrics.entry(name).or_default() += value;
+        }
+    }
+    pub(super) fn elapsed(&mut self, name: &'static str, started: Option<Instant>) {
+        if let Some(started) = started {
+            self.count(name, started.elapsed().as_nanos());
+        }
+    }
+    pub(super) fn detach(&mut self, name: &'static str, rows: &Arc<Vec<Arc<Proposition>>>) {
+        if self.active() && Arc::strong_count(rows) > 1 {
+            self.count(name, 1);
+            self.count("cow_row_handles", rows.len() as u128);
+        }
+    }
+}
+
+impl Drop for Probe {
+    fn drop(&mut self) {
+        if !self.active() {
+            return;
+        }
+        let elapsed = self
+            .started
+            .map_or(0, |started| started.elapsed().as_nanos());
+        let mut row = format!(
+            "REBIND\t{}\t{:?}\t{}",
+            self.kind,
+            std::thread::current().id(),
+            elapsed
+        );
+        for (name, value) in &self.metrics {
+            row.push_str(&format!("\t{name}={value}"));
+        }
+        eprintln!("{row}");
+    }
+}
