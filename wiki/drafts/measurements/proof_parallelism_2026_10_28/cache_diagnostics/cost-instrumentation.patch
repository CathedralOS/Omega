 //! the payload owner resolves backing and invalidates them after mutation.
 //! Call adapters supply exact typed formal/result bindings from the current
 //! checked signature, never implementation-private facts or receiving domains.
+use super::edge_rebinding_probe::Probe;
 use semantic_vocabulary::{Proposition, ScalarTerm, ValueId};
 use std::borrow::Borrow;
 use std::collections::BTreeMap;
+use std::sync::Arc;
+
+/// One edge's fixed substitution, retaining only its last immutable input.
+pub(super) struct ScalarArrivalRebinding {
+    pub(super) bindings: Vec<(ValueId, ScalarTerm)>,
+    pub(super) parameters: Vec<ValueId>,
+    pub(super) incoming: Arc<Vec<Arc<Proposition>>>,
+    pub(super) rebound: Vec<Arc<Proposition>>,
+}
+
+impl ScalarArrivalRebinding {
+    pub(super) fn new(
+        bindings: &[(ValueId, ScalarTerm)],
+        parameters: &[ValueId],
+        incoming: &Arc<Vec<Arc<Proposition>>>,
+        probe: &mut Probe,
+    ) -> Self {
+        probe.count("cold_entries", 1);
+        probe.count("cold_input_rows", incoming.len() as u128);
+        let started = probe.clock();
+        let bindings = bindings.to_vec();
+        let parameters = parameters.to_vec();
+        let captured = incoming.clone();
+        probe.elapsed("capture_ns", started);
+        let started = probe.clock();
+        let rebound = arrival_requirements(incoming, &bindings, &parameters);
+        probe.elapsed("transform_ns", started);
+        probe.count("transform_calls", 1);
+        probe.count("wrapped_output_rows", rebound.len() as u128);
+        let started = probe.clock();
+        let rebound = rebound.into_iter().map(Arc::new).collect();
+        probe.elapsed("wrap_ns", started);
+        Self {
+            bindings,
+            parameters,
+            incoming: captured,
+            rebound,
+        }
+    }
+
+    pub(super) fn requirements(
+        &mut self,
+        incoming: &Arc<Vec<Arc<Proposition>>>,
+        probe: &mut Probe,
+    ) -> &[Arc<Proposition>] {
+        probe.count("requests", 1);
+        probe.count("requested_input_rows", incoming.len() as u128);
+        let started = probe.clock();
+        let same = Arc::ptr_eq(&self.incoming, incoming);
+        probe.elapsed("identity_ns", started);
+        if same {
+            // Includes the constructor's immediate check; the analyzer subtracts cold entries.
+            probe.count("same_allocation_checks", 1);
+            probe.count("same_allocation_input_rows", incoming.len() as u128);
+        } else {
+            probe.count("changed_allocation_misses", 1);
+            if probe.counts() {
+                let equal = self.incoming.as_ref() == incoming.as_ref();
+                probe.count("equal_contents_misses", u128::from(equal));
+                probe.count("different_contents_misses", u128::from(!equal));
+            }
+            let started = probe.clock();
+            let rebound = arrival_requirements(incoming, &self.bindings, &self.parameters);
+            probe.elapsed("transform_ns", started);
+            probe.count("transform_calls", 1);
+            probe.count("wrapped_output_rows", rebound.len() as u128);
+            let started = probe.clock();
+            let rebound = rebound.into_iter().map(Arc::new).collect();
+            probe.elapsed("wrap_ns", started);
+            probe.count("replaced_output_rows", self.rebound.len() as u128);
+            let started = probe.clock();
+            self.rebound = rebound;
+            self.incoming = incoming.clone();
+            probe.elapsed("replace_ns", started);
+        }
+        &self.rebound
+    }
+}
