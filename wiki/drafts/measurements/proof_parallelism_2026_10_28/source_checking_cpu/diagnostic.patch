@@ -0,0 +1,85 @@
+//! Temporary host CPU snapshots; never an input to compilation.
+use std::ffi::c_void;
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct FileTime {
+    low: u32,
+    high: u32,
+}
+impl FileTime {
+    fn ticks(self) -> u64 {
+        (u64::from(self.high) << 32) | u64::from(self.low)
+    }
+}
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn GetCurrentProcess() -> *mut c_void;
+    fn GetCurrentThread() -> *mut c_void;
+    fn GetProcessTimes(
+        handle: *mut c_void,
+        created: *mut FileTime,
+        exited: *mut FileTime,
+        kernel: *mut FileTime,
+        user: *mut FileTime,
+    ) -> i32;
+    fn GetThreadTimes(
+        handle: *mut c_void,
+        created: *mut FileTime,
+        exited: *mut FileTime,
+        kernel: *mut FileTime,
+        user: *mut FileTime,
+    ) -> i32;
+}
+pub fn snapshot() -> [u64; 4] {
+    let mut created = FileTime::default();
+    let mut exited = FileTime::default();
+    let mut pk = FileTime::default();
+    let mut pu = FileTime::default();
+    let mut tk = FileTime::default();
+    let mut tu = FileTime::default();
+    // Pseudohandles identify this process/thread; all output buffers are live and correctly aligned.
+    let process = unsafe {
+        GetProcessTimes(
+            GetCurrentProcess(),
+            &mut created,
+            &mut exited,
+            &mut pk,
+            &mut pu,
+        )
+    };
+    assert_ne!(
+        process,
+        0,
+        "process CPU observation failed: {}",
+        std::io::Error::last_os_error()
+    );
+    let thread = unsafe {
+        GetThreadTimes(
+            GetCurrentThread(),
+            &mut created,
+            &mut exited,
+            &mut tk,
+            &mut tu,
+        )
+    };
+    assert_ne!(
+        thread,
+        0,
+        "thread CPU observation failed: {}",
+        std::io::Error::last_os_error()
+    );
+    [pk.ticks(), pu.ticks(), tk.ticks(), tu.ticks()]
+}
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn filetime_and_monotonic_snapshots() {
+        assert_eq!(
+            super::FileTime { low: 7, high: 3 }.ticks(),
+            (3u64 << 32) + 7
+        );
+        let a = super::snapshot();
+        let b = super::snapshot();
+        assert!(a.into_iter().zip(b).all(|(a, b)| b >= a));
+    }
+}
