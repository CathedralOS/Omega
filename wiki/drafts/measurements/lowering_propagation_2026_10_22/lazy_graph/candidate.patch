@@ -0,0 +1,67 @@
+//! Descriptor replay is prepared only when retention observes backing storage.
+//! Plain constructors transfer their operands' declared memberships directly;
+//! building the complete descriptor graph for those transfers is wasted work.
+//!
+//! The invocation owns a single-assignment graph and reusable descriptor analysis.
+//! Query entrances depend on operation kinds, carriers and paths, which retention
+//! does not change: any demanded graph is therefore built in the first read sweep,
+//! before publishing new memberships. This preserves the original graph snapshot.
+//! Payload history instead borrows one machine's current membership rows and is
+//! discarded before each sweep publishes changes. No cached history crosses that
+//! mutation boundary, and no empty graph stands in for an unprepared analysis.
+
+use std::cell::OnceCell;
+use terminal_psi::{StructuralTypeDeclaration, TerminalMachine, TerminalModule};
+use terminal_semantics::descriptor_results::{
+    self as descriptors, DescriptorAnalysis, DescriptorMachine, PayloadMembershipHistory,
+};
+
+pub(super) struct PayloadQueries<'input, 'graph> {
+    pub(super) module: &'input TerminalModule,
+    pub(super) machine: &'input TerminalMachine,
+    types: &'graph [StructuralTypeDeclaration],
+    graph: &'graph OnceCell<Vec<DescriptorMachine>>,
+    analysis: &'input mut Option<DescriptorAnalysis<'graph>>,
+    history: Option<PayloadMembershipHistory<'input>>,
+}
+
+impl<'input, 'graph: 'input> PayloadQueries<'input, 'graph> {
+    pub(super) fn new(
+        module: &'input TerminalModule,
+        machine: &'input TerminalMachine,
+        types: &'graph [StructuralTypeDeclaration],
+        graph: &'graph OnceCell<Vec<DescriptorMachine>>,
+        analysis: &'input mut Option<DescriptorAnalysis<'graph>>,
+    ) -> Self {
+        Self {
+            module,
+            machine,
+            types,
+            graph,
+            analysis,
+            history: None,
+        }
+    }
+
+    pub(super) fn descriptors(&mut self) -> &mut DescriptorAnalysis<'graph> {
+        self.analysis.get_or_insert_with(|| {
+            DescriptorAnalysis::new(
+                self.types,
+                self.graph
+                    .get_or_init(|| descriptors::terminal_graph(self.module)),
+            )
+        })
+    }
+
+    pub(super) fn history(&mut self) -> &mut PayloadMembershipHistory<'input> {
+        self.history.get_or_insert_with(|| {
+            PayloadMembershipHistory::new(
+                self.types,
+                &self.module.structural_domains,
+                self.graph
+                    .get_or_init(|| descriptors::terminal_graph(self.module)),
+                self.machine,
+            )
+        })
+    }
+}
