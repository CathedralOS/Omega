diff --git a/omega-rust/psi/compilation/pipeline/05_checked-trees-to-lowered-psi/src/retention/copied_memberships/payload_queries.rs b/omega-rust/psi/compilation/pipeline/05_checked-trees-to-lowered-psi/src/retention/copied_memberships/payload_queries.rs
