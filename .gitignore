# Build output directories
/target/
/omega-rust/omega/target/
/dist/
/build/
/samples/**/build/
/samples/*/build_win/
/tests/omega/*/*/build/

# Package-manager state is host-local: a project's omega.lock names its
# absolute checkout path, so a committed one fails in every other checkout
# (tools/benchmark/README.md).
/samples/**/omega.lock
/samples/**/omega.admissions
/tests/omega/**/omega.lock
/tests/omega/**/omega.admissions
/tests/psi/**/build/
/tests/psi/**/omega.lock
/tests/psi/**/omega.admissions
/source/**/build/
/source/**/omega.lock
/source/**/omega.admissions

# Claude Code local worktrees, settings, and skill link; canonical skills are in .agents
.claude/*

# Codex temporary worktrees are repository-local and never versioned
.codex/worktrees/

# Local agent worktrees are repository-local and never versioned
.agents/worktree/

# These are backup files generated by rustfmt
**/*.rs.bk

# Python bytecode caches
__pycache__/
*.pyc

*.DS_Store
.idea/
.vscode/

# Place for repos that we need to look at but don't want to include.
/examples/

# Local compiler crash reports are diagnostic artifacts, not source.
rustc-ice-*.txt
/.omega-pinned/
