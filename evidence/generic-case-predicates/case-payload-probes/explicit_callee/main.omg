data Command<const Maximum: i32> [copy]
    requires ((self in Command::SetLevel) && (self.level >= 0 && self.level <= Maximum))
        || ((self in Command::Dim) && (self.amount >= 0 && self.amount <= 10))
        || (self in Command::Off)
{
    case SetLevel(level: i32);
    case Dim(amount: i32);
    case Off;
}
data Storage { command: Command<100>; }
machine apply(target: i32) -> i32 requires target >= 0 && target <= 100 { target }
machine evaluate(command: Command<100>) -> i32 {
match command {
 Command::SetLevel { level } -> apply(level)
 Command::Dim { amount } -> scale(amount)
 Command::Off -> apply(0)
}
}
machine main() crashes Trap {
let command: Command<100> = Command::Dim { amount: 10 };
let result: i32 = evaluate(command);
transition result == 100 { true -> done() false -> bad() }
machine done() {}
machine bad() { crash Trap; }
}

machine scale(amount: i32) -> i32 requires amount >= 0 && amount <= 10 { apply(amount * 10) }
