// Expected exit: 0
// Selected<Base + 4> at Base = 3 supplies at least seven before exact value - 7.
trait Reading<const Minimum: u64> {
    machine read() -> u64 ensures result >= Minimum;
}
Selected<const Value: u64> satisfies Reading<Value> {
    machine read() -> u64 ensures result == Value { Value }
}
machine selected<const Minimum: u64, Implementation satisfies Reading<Minimum>>() -> u64
ensures result >= Minimum
{ Implementation::read() }
machine construct<const Base: u64>() -> u64
requires Base <= 100
ensures result >= Base + 4
{ selected<Base + 4, Selected<Base + 4>>() }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTargetValue {
    machine target_value() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result >= 7;
}

X86TargetValue satisfies SelectedTargetValue {
    machine target_value() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result >= 7
    {
        SelectedBodyCheck::require_tag(17u64);
     construct<3>() 
    }
}

ArmTargetValue satisfies SelectedTargetValue {
    machine target_value() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result >= 7
    {
        SelectedBodyCheck::require_tag(29u64);
     construct<3>() 
    }
}


machine main() crashes Trap {
    let value: u64 = SelectedTargetValue::target_value();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
