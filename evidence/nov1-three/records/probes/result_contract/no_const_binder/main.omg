// Expected exit: 0
// Selected<Base + 4> at Base = 3 supplies at least seven before exact value - 7.
trait Reading {
    machine read() -> u64 ensures result >= 7;
}
Selected satisfies Reading {
    machine read() -> u64 ensures result == 7 { 7 }
}
machine selected<Implementation satisfies Reading>() -> u64
ensures result >= 7
{ Implementation::read() }
machine construct<const Base: u64>() -> u64
requires Base == 3
ensures result >= Base + 4
{ selected<Selected>() }
machine main() crashes Trap {
    let value: u64 = construct<3>();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
