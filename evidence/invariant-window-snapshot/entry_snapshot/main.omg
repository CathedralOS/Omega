// Expected exit: 0
// A valid entry snapshot stays nonnegative; a legal open-window snapshot stays negative after restoration.
public data Pair
requires self.start >= 0 && self.start <= self.end,
{
    start: i32;
    end: i32;
}
machine require_nonnegative(value: i32)
requires value >= 0
{
}
public machine inspect(pair: &mut Pair) -> i32 {
    let initial: i32 = pair.start;
    pair.start = -1;
    let saved: i32 = pair.start;
    pair.end = 10;
    pair.start = 0;
    require_nonnegative(initial);
    require_negative(saved);
    saved
}
machine require_negative(value: i32) requires value < 0 {}
machine main() crashes Trap {
    let mut pair: Pair = Pair { start: 3, end: 10 };
    let observed: i32 = inspect(&mut pair);
    transition observed == -1 && pair.start == 0 && pair.end == 10 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
