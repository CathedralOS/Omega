+fn normal_return_atom(
+    invocation: &Invocation<'_>,
+    primitive: PrimitiveType,
+    length: bool,
+    storage: &validation::CanonicalPlace,
+) -> ScopedArithmeticValue {
+    ScopedArithmeticValue::Atom {
+        identity: format!(
+            "\0call-guarantee:return:{:?}:{}:{}:{primitive:?}:{length}:{storage:?}",
+            invocation.caller_state, invocation.statement, invocation.ordinal,
+        ),
+        unsigned: matches!(
+            primitive,
+            typed_trees::unsigned_integer_primitive_pattern!()
+        ),
+    }
+}
+
+/// Join a returned observation to one authenticated, unmodified call output.
+pub(in crate::checks) fn value_at_normal_return(
+    program: &dyn ::validation::CheckingInput,
+    facts: &CheckFacts,
+    caller: &FlowStateFact,
+    statement: usize,
+    contexts: &[FactContextHandle],
+    frames: &validation::CallFrameResolver<'_>,
+    place: validation::CanonicalPlace,
+    primitive: PrimitiveType,
+) -> Option<ScopedArithmeticValue> {
+    let machine = program.machine_by_symbol(caller.machine_symbol)?;
+    let current = facts.flow.state_statement(caller, statement);
+    if std::env::var_os("OMEGA_DEBUG_STATEMENT_GUARANTEE").is_some() {
+        eprintln!(
+            "normal return query caller={:?} statement={statement} place={place:?} current_present={}",
+            caller.machine_symbol,
+            current.is_some()
+        );
+    }
+    let current = current?;
+    if !crate::flow::entry_origin_is_stable(
+        program,
+        &facts.flow.control,
+        current.completed_content_writes,
+        current.completed_content_unknown_write,
+        &place,
+    ) {
+        return None;
+    }
+    let mut found = None;
+    for guarantee in super::available(
+        program,
+        facts,
+        caller,
+        super::GuaranteeUse::StatementEntry(statement),
+        contexts,
+        frames,
+    ) {
+        let Some(writes) = guarantee.post_return_writes.as_deref() else {
+            continue;
+        };
+        let Some(call) = invocation_fact(facts, caller, &guarantee.invocation) else {
+            continue;
+        };
+        let mut occurrences = Vec::new();
+        crate::facts::contract_occurrences::append_expression_occurrences(
+            program,
+            guarantee.expression,
+            &mut occurrences,
+        );
+        for occurrence in occurrences {
+            let observed = guarantee
+                .invocation
+                .callable
+                .scalar_reference(program, occurrence)
+                .and_then(|reference| {
+                    validation::field_domains::readable_type_reference(program, reference)
+                })
+                .and_then(|reference| program.primitive_type_reference(reference));
+            if observed != Some(primitive) {
+                continue;
+            }
+            let Some(actual) = bound_place(program, &guarantee.invocation, occurrence) else {
+                continue;
+            };
+            if !matches!(actual.root, facts::PlaceRoot::Symbol(_)) {
+                continue;
+            }
+            let Some(storage) = crate::flow::rebase_exact_local_place(
+                program,
+                guarantee.invocation.caller_state,
+                guarantee.invocation.statement,
+                actual,
+                Some(frames),
+            ) else {
+                continue;
+            };
+            let written = writes
+                .iter()
+                .any(|write| ValueObservation::Contents.changed_by(program, &storage, write));
+            let matches = written
+                && crate::flow::value_origin_matches_call_return(
+                    program,
+                    &facts.flow,
+                    machine,
+                    caller,
+                    statement,
+                    place.clone(),
+                    call,
+                    &storage,
+                    frames,
+                );
+            if std::env::var_os("OMEGA_DEBUG_STATEMENT_GUARANTEE").is_some() {
+                eprintln!(
+                    "normal return candidate storage={storage:?} written={written} matches={matches}"
+                );
+            }
+            if !matches {
+                continue;
+            }
+            let value = normal_return_atom(&guarantee.invocation, primitive, false, &storage);
+            if found.as_ref().is_some_and(|prior| prior != &value) {
+                return None;
+            }
+            found = Some(value);
+        }
+    }
+    found
+}
