+/// Exact carrier of each physical result leaf. Borrowed backing and the
+/// descriptor which names it have different lifetimes, even when both are
+/// represented by reference shells. Consumers use this same declared frontier.
+pub fn carried_reference_types(
+    program: &dyn crate::CheckingInput,
+    type_reference: TypeReferenceHandle,
+) -> Option<Vec<(Vec<BorrowOwnerSegment>, TypeReferenceHandle)>> {
+    carried_lifetimes(program, type_reference).map(|leaves| {
+        leaves
+            .into_iter()
+            .filter(|leaf| !leaf.lifetime_only)
+            .map(|leaf| (leaf.owner_path, leaf.reference))
+            .collect()
+    })
+}
+
