// Each recurrent arrival owns a new affine Cell while its body reads it shared.
// The old home must retire after the successor operands complete; the final
// named exit leaves the chain. A stale or missing home changes the result.
data Cell { value: u32; }

machine countdown(remaining: u32) -> u32
requires remaining <= 3
terminates by remaining in 0..=3
{
    transition { _ -> observe(&Cell { value: remaining }, remaining) }

    machine observe(cell: &Cell, remaining_steps: u32) -> u32
    requires remaining_steps <= 3
    terminates by remaining_steps in 0..=3
    {
        let matches: bool = cell.value == remaining_steps;
        transition matches &&mut remaining_steps > 0 {
            true -> observe(&Cell { value: remaining_steps - 1 }, remaining_steps - 1)
            false -> finish(matches, cell.value)
        }
    }
    machine finish(matches: bool, value: u32) -> u32 {
        transition matches {
            true -> value
            false -> 99
        }
    }
}

machine main() crashes Trap {
    let replaced: u32 = countdown(3);
    let immediate: u32 = countdown(0);
    transition replaced == 0 && immediate == 0 {
        true -> done()
        false -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
