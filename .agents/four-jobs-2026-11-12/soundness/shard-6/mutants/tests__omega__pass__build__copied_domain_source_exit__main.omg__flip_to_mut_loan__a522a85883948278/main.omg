// Expected exit: 0. A copied field keeps its declared domain when Build imports the same record.
use contracts::Parcel;
use contracts::consume;

domain u64::Seventeen requires self == 19;
machine consume_foreign(value: u64 in Seventeen) -> u64 { value - 16 }

machine main() crashes Trap {
    let parcel: Parcel<u64> = Parcel { before: 101, value: 17, payload: 29, after: 103 };
    let selected: u64 = consume(parcel.value);
    transition selected == 1 &&mut parcel.before == 101 && parcel.value == 17 && parcel.payload == 29 && parcel.after == 103 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
