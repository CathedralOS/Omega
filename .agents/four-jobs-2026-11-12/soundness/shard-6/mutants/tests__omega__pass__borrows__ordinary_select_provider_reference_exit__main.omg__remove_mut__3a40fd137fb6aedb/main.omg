// Expected exit: 0.
data Holder<'storage> { before: u64; reference: &'storage i32; after: u64; }
machine select_provider<'storage>(holder: &mut Holder<'storage>, incoming: &'storage i32) {
    holder.reference = incoming;
}
machine main() crashes Trap {
    let before: i32 = 11;
    let mut after: i32 = 29;
    let holder: Holder = Holder { before: 37, reference: &before, after: 91 };
    select_provider(&mut holder, &after);
    transition holder.reference == 29 && holder.before == 37 && holder.after == 91 {
        true -> done() false -> failed()
    }
    machine done() { }
    machine failed() { crash Trap; }
}
