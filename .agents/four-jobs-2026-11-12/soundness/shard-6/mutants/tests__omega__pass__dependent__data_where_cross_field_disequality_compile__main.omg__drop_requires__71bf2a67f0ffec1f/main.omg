// A `data where` clause may require two fields to differ: `Pair` is valid
// only while `first != second` — the pair carries distinct slots and equal
// construction is rejected.
data Pair

    first: u64;
    second: u64;
}

data Main { pair: Pair; }

machine Main::main(main: &mut Main) {
    main.pair = Pair { first: 3, second: 7 };
}
