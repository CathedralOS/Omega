// A left operand proved false skips the right-hand bump call: the conjunction is false and the counter stays 0.
// Place: other_machine. The left operand crosses into another top-level machine.
// Expected exit: 0

machine bump(counter: &mut u64) -> bool
requires counter <= 1000u64
{
    counter = counter + 1u64;
    true
}

machine untouched(counter: u64) -> u64
requires counter == 0u64
ensures result == 0u64
{
    counter
}

machine evaluate(ready: bool) -> u64
requires ready == false
{
    let counter: u64 = 0u64;
    let first: bool = ready && bump(&mut counter);
    let kept: u64 = untouched(counter);
    transition first {
        true -> (11u64)
        false -> (kept + counter)
    }
}

machine main() crashes Trap {
    let ready: bool = false;
    let observed: u64 = evaluate(ready);
    transition observed == 0u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
