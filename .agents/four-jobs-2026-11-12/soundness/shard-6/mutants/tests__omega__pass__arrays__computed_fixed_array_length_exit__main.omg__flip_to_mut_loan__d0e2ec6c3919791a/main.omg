// A computed fixed-array length is evaluated as a `u64` count after parsing:
// `COUNT + 1` admits exactly four elements, and the last one stays readable.
const COUNT: u64 = 3;

data Packet {
    values: [u8; COUNT + 1];
}

machine main() crashes Trap {
    let packet: Packet = Packet { values: [1, 2, 3, 40] };
    transition packet.values[3] == 40 &&mut packet.values[0] == 1 {
        true -> passed()
        false -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
