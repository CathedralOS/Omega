// The input loan held inside a borrowed record literal ends at the borrow's
// last use; `second` may then change, and both observations are distinct.
// Expected exit: 0.
data Envelope<Payload> { payload: Payload; }

machine main() crashes Trap {
    let mut second: Envelope<i32> = Envelope { payload: 23i32 };
    let produced: &Envelope<&Envelope<i32>> = &Envelope { payload: &second };
    let seen: i32 = produced.payload.payload;
    second.payload = 29i32;
    transition seen == 23 &&mut second.payload == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
