// Fixed-token declaration heads: `operator +` binds a fixture-owned `Cell`
// operator (primitive `i32 +` belongs to the core semantic home), and
// `boundary machine []` and `boundary machine [..]` bind fixture-owned
// collection operators — generic over `T`, with requires contracts that stay
// provider-agnostic.
data Cell { value: i32; }

operator + Cell::add(left: Cell, right: Cell) -> Cell;

data Table<T> {
    cells: [T; 8];
}

boundary machine [] Table::at<T>(items: &Table<T>, index: u64) -> T
requires
    index < 8;

boundary machine [..] Table::window<T>(items: &Table<T>, start: u64, end: u64) -> &Table<T>
requires
    start <= end && end <= 8;

data Main {}

machine Main::main(main: & Main) {
}
