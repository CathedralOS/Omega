machine build(builder: &mut Build) {
 Build::application(builder, "retained_const_application");
 let mut shapes_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "shapes" });
 dependency::with_alias(&mut shapes_dependency, "shapes");
 let shapes_registration: DependencyRegistration = Build::dependency(builder, shapes_dependency);
 Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
}
