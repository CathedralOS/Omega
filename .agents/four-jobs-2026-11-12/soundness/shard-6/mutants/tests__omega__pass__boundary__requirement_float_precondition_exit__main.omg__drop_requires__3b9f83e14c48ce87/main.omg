// A boundary requirement's own `requires value == 7.0` is proved at the call
// from the captured actual, as an ordinary machine's float precondition is.
// The selected implementation returns its input plus 0.5; the caller checks
// for 7.5, so a skipped call or a wrong result traps.
// Expected exit: 0
boundary trait Observe {
    machine observe(value: f64) -> f64 reaches requires value == 7.0;
}
Code satisfies Observe {
    machine observe(value: f64) -> f64  value + 0.5 }
}
machine main() crashes Trap {
    transition Observe::observe(7.0) == 7.5 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
