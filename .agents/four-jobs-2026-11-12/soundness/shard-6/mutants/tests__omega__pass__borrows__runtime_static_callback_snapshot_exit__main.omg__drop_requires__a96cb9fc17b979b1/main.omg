// Expected exit: 0
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
machine overwrite<'storage>(slot: &mut View<'storage>, replacement: &'storage [u8]) -> u64 { slot.bytes = replacement; 0 }
machine keep<'storage>(source: View<'storage>) -> View<'storage>
ensures result.bytes.len == source.bytes.len, result.sibling.len == source.sibling.len
{ source }
machine counter_tick(value: &mut u64) -> u64
 value = value + 1; 0 }
// record_tick has no zero clause. Its callable interface supplies that
// input condition; call_counter must establish it independently.
machine record_tick(visits: &mut u64) -> u64 { counter_tick(visits) }
public machine call_counter<machine Step>(counter: &mut u64) -> u64
requires machine Step(input: &mut u64) -> u64
requires input == 0;
requires counter == 0
{ Step(counter) }
machine apply<'storage, machine Callback>(source: View<'storage>) -> View<'storage>
requires machine Callback<'fresh>(source: View<'fresh>) -> View<'fresh>
ensures result.bytes.len == source.bytes.len, result.sibling.len == source.sibling.len;
ensures result.bytes.len == source.bytes.len, result.sibling.len == source.sibling.len
{ Callback(source) }
machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
requires selected.bytes.len == 7
ensures result == 7
{ selected.bytes.len }
machine main() crashes Trap {
    let mut visits: u64 = 0;
    let tick_index: u64 = call_counter<record_tick>(&mut visits);
    let storage: [u8; 7] = [49, 50, 51, 52, 53, 54, 55];
    let mut original: View = View { bytes: &storage[..], sibling: "tail" };
    let observed: u64 = receive(apply<keep>(original), overwrite(&mut original, "123456789"));
    let difference: u64 = observed - 7;
    transition difference == 0 && original.bytes.len == 9 && original.sibling.len == 4
        && visits == 1 && tick_index == 0 {
        true -> done() false -> wrong()
    }
    machine done() {} machine wrong() { crash Trap; }
}
