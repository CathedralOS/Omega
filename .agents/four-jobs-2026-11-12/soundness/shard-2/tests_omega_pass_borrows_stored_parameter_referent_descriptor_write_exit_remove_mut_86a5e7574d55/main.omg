// A mutable reference parameter keeps write authority after the program
// stores it inside a local record, or when the program reaches it through a
// reference field nested inside the parameter's referent. Each access loads
// the stored descriptor; those loads resolve against the incoming leaf
// instead of minting fresh borrows that conflict with it. Exits 0 once
// stored-reference retirement lowers; today the witness checks.
// Expected exit: 0
data Leaf { count: u64 in Wrapping }
data Payload { guard: &mut Leaf }
data Box { child: &mut Payload }
data Pending { value: &mut Leaf }
data Remaining { child: &mut Pending }

machine probe(payload: &mut Payload) -> u64 in Wrapping {
    let b: Box = Box { child: payload };
    b.child.guard.count = b.child.guard.count + 1;
    b.child.guard.count
}

machine probe_nested(pending: &mut Remaining) -> u64 in Wrapping {
    pending.child.value.count = pending.child.value.count + 1;
    pending.child.value.count
}

machine main() crashes Trap {
    let mut leaf: Leaf = Leaf { count: 41 };
    let mut payload: Payload = Payload { guard: &mut leaf };
    let first: u64 in Wrapping = probe(&mut payload);
    let mut leaf_two: Leaf = Leaf { count: 11 };
    let mut inner: Pending = Pending { value: &mut leaf_two };
    let mut remaining: Remaining = Remaining { child: &mut inner };
    let second: u64 in Wrapping = probe_nested(&mut remaining);
    transition first == 42 && second == 12 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
