data Token dropped by drop_token { value: u64; }

machine drop_token(token: &mut Token)
{
    token.value = 0;
}

machine main() crashes Trap {
    let mut token: Token = Token { value: 7 };
    token = Token { value: 7 };
    let observed: u64 = token.value;
    transition { _ -> observe(observed) }
    machine observe(observed: u64) {
        transition observed == 7 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
