// Deployable native canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "boundary_trait_effects_host_call");
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, linux_arm64);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, linux_x86_64);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, macos_arm64);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, macos_x86_64);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, windows_x86_64);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, uefi_x86_64);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, cross_platform_cli);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, local_unchecked);
    Build::select_provider<Console, ConsoleProviderConsoleImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
