// Expected exit: 0
// The same shared atomic cell is read-and-cleared on the initial and repeated loop edges.
data Wake { before: u64; pending: AtomicU32; after: u64; }

machine main() crashes Trap {
    let mut wake: Wake;
    wake.before = 37;
    wake.after = 91;
    wake.pending.store(1, Publish);
    run(&mut wake);
}

machine run(wake: &Wake) crashes Trap {
    transition { _ -> wait(wake, 0u64, 1u32) }
    machine wait(wake: &Wake, count: u64, expected: u32)
    requires count < 8 {
        let prior: u32 = wake.pending.fetch_and(0, Receive);
        transition prior == expected {
            true -> checked(wake, count)
            _ -> bad()
        }
    }
    machine checked(wake: &Wake, count: u64)
    requires count < 8 {
        let next: u64 = count + 1;
        transition next == 8 {
            true -> done(wake)
            _ -> wait(wake, next, 0u32)
        }
    }
    machine done(wake: &Wake) {
        let resident: u32 = wake.pending.load(Receive);
        transition resident == 0 && wake.before == 37 && wake.after == 91 {
            true -> accepted()
            _ -> bad()
        }
    }
    machine accepted() {}
    machine bad() { crash Trap; }
}
