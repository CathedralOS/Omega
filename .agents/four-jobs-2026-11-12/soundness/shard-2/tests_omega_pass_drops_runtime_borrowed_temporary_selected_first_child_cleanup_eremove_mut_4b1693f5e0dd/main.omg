// Expected exit: 0. The current activation retains the anonymous owner through every admitted child use.
data Receipt [linear] dropped by drop_receipt { code: u64; }
machine drop_receipt(receipt: &mut Receipt) {}
data Pair dropped by drop_pair { first: Receipt; second: Receipt; }
machine drop_pair(pair: &mut Pair) {}
machine retain(receipt: &Receipt) -> &Receipt { receipt }
machine observe(receipt: &Receipt, expected: u64) crashes Trap {
    transition receipt.code == expected { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    let code: u64 = 17;
    let selected: &Receipt = match code == 23 {
        true -> retain(&Pair { first: Receipt { code: 17 }, second: Receipt { code: 23 } }.second)
        false -> retain(&Pair { first: Receipt { code: 17 }, second: Receipt { code: 23 } }.first)
    };
    observe(selected, code);
}
