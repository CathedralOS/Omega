machine build(builder: &mut Build) {
    Build::application(builder, "finite_input_index_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<InputIndexRelay, PortableInputIndexRelay>(builder, windows_x86_64);
    Build::select_provider<InputIndexRelay, PortableInputIndexRelay>(builder, linux_x86_64);
    Build::select_provider<InputIndexRelay, PortableInputIndexRelay>(builder, macos_arm64);
    Build::select_provider<InputIndexRelay, PortableInputIndexRelay>(builder, linux_arm64);
}
