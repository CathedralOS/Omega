machine build(builder: &mut Build) {
    Build::application(builder, "applied_calling_surface");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::select_provider<LocalEntry<u64>, LocalMap>(builder, macos_arm64);
    Build::select_provider<LocalEntry<u64>, LocalMap>(builder, linux_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
