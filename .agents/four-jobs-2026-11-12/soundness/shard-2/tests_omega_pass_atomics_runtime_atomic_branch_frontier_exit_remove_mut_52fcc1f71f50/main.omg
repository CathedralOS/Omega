// Expected exit: 0
// Both branch writes reach one atomic load; each call must observe its own branch.
data Cell { before: u64; value: AtomicU32; after: u64; }

machine choose(cell: &Cell, take_left: bool) -> u32 {
    transition take_left {
        true -> left(cell)
        false -> right(cell)
    }
    machine left(cell: &Cell) -> u32 {
        cell.value.store(37, Publish);
        transition { _ -> joined(cell) }
    }
    machine right(cell: &Cell) -> u32 {
        cell.value.store(91, Publish);
        transition { _ -> joined(cell) }
    }
    machine joined(cell: &Cell) -> u32 {
        cell.value.load(Receive)
    }
}

machine main() crashes Trap {
    let cell: Cell;
    cell.before = 13;
    cell.after = 29;
    cell.value.store(5, Publish);
    let first: u32 = choose(&cell, true);
    let second: u32 = choose(&cell, false);
    let resident: u32 = cell.value.load(Receive);
    transition first == 37 && second == 91 && resident == 91
        && cell.before == 13 && cell.after == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
