// A boundary requirement that takes a callback machine can write only what its
// parameters reach, whichever machine the caller forwards to it. With a shared
// reference argument, what the caller proved about the cell still holds after
// the call.
public boundary trait Read {}
public boundary trait Handler {
    machine read() -> u64 reaches Read;
}

public boundary trait Registry {
    machine register<machine Callback>(cell: &u64) -> u64
    requires machine Callback satisfies Handler::read;
    reaches
    invokes Handler;
}

machine positive(cell: &u64) -> u64 requires cell > 0 { cell }

machine caller<machine Selected>(value: u64) -> u64
requires machine Selected satisfies Handler::read;
requires value > 0
reaches Registry + Read
invokes Registry
{
    let cell: u64 = value;
    let atom: u64 = Registry::register<Selected>(&cell);
    positive(&cell)
}
