// Expected exit: 0
// The view forms its helper call for every admitted input, including zero.
machine bounded_rank(value: u64) -> u64
ensures result == value
{ value }

data Countdown {}
measure Countdown::Remaining(value: u64) -> u64 { bounded_rank(value) }

machine walk(remaining: u64) -> u64
requires remaining <= 5
terminates by remaining -> Countdown::Remaining in 0..=5 {
    transition remaining > 0 {
        true -> walk(remaining - 1)
        false -> remaining
    }
}

machine main() crashes Trap {
    let counted: u64 = walk(5);
    let empty: u64 = walk(0);
    transition counted == 0 && empty == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}


machine __soundness_probe_violation__() -> u64
{
    bounded_rank(6)
}
