// The selected provider makes limit() equal to 7; requires value <= limit() preserves the bound needed to prove 7 - value.
// Expected exit: 0
public boundary trait Endpoint {
    machine upper<const Nonce: u64>() -> u64 reaches terminates;
}
public Actual satisfies Endpoint {
    machine upper<const Nonce: u64>() -> u64 { 7 }
}
machine independent_limit() -> u64 invokes Endpoint {
    Endpoint::upper<19u64>()
}
machine need(value: u64) -> u64 invokes Endpoint
{ value }
machine limit() -> u64 {
    let admitted: u64 = need(7u64);
    Endpoint::upper<13u64>()
}
machine bounded(value: u64) -> u64
requires value <= limit()
ensures result <= limit()
{ value }
machine subtract(value: u64) -> u64
requires value <= limit()
{ 7u64 - value }
public machine main() invokes Endpoint crashes Trap {
    let produced: u64 = bounded(7);
    let difference: u64 = subtract(produced);
    transition difference == 0 && limit() == 7u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}


machine __soundness_probe_violation__() -> u64
{
    need(independent_limit)
}
