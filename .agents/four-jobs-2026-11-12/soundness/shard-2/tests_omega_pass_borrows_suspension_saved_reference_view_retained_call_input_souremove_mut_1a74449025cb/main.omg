// Expected exit: 0
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
data Cell { value: i32; }
data Message { body: &Cell; }
machine read(message: Message) -> i32 { message.body.value }
data Pair { first: i32; second: i32; }
machine identity(source: &mut Pair) -> &mut Pair { source }
machine main() reaches Scheduler crashes Trap {
    let backing: Pair = Pair { first: 73, second: 11 };
    let source: &mut Pair = &mut backing;
    let mut other: Pair = Pair { first: 11, second: 13 };
    let mut whole: &mut Pair = identity(source);
    let narrow: &i32 = &whole.first;
    let copied: &i32 = narrow;
    let reference: &Cell = copied as &Cell;
    whole = &mut other;
    let message: Message = Message { body: reference };
    suspend Scheduler::park();
    let observed: i32 = read(message);
    source.second = 19;
    transition observed == 73 && source.second == 19 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
