// Expected exit: 0
// Proving the payload absent discharges its conditional custody, including
// obligations inside a closed generic field. Missing tag evidence cannot.
use omega::language::core::content;
use omega::language::core::drop;
data Units {}
data Ticket dropped by drop_ticket { value: u64; }
machine drop_ticket(ticket: &mut Ticket) {}
data Box<T> { value: T; }
data Envelope [linear] dropped by drop_envelope {
    quantity: u64;
    case Occupied(storage: Box<Ticket>);
    case Empty;
}
domain Envelope::Accounted;
machine Accounted::content(value: &Envelope) -> CountedQuantity<Units>
satisfies Content<Envelope, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(value.quantity) as Nat }
}
machine renew_empty(whole: Envelope in Accounted) -> Envelope in Accounted
ensures core::Identity<CountedQuantity<Units>>(
    Accounted::content(old(&whole)),
    Accounted::content(&result)
) {
    Envelope::Empty { quantity: whole.quantity }
}

machine drop_envelope(value: &mut Envelope) {}
machine main() crashes Trap {
    let whole: Envelope in Accounted = Envelope::Empty { quantity: 19 };
    let renewed: Envelope in Accounted = renew_empty(whole);
    let correct: bool = renewed.quantity == 19;
    drop(renewed);
    transition correct { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
