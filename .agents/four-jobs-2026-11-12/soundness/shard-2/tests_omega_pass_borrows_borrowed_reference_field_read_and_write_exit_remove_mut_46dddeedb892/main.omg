// Expected exit: 0
// Reading or writing a pointee through an incoming record must load its stored
// reference, even though replacing the reference field itself does not.
data Cell { value: i64; }
data Held { target: &mut Cell; }

machine read(held: &Held) -> i64 { held.target.value }
machine store(held: &mut Held, value: i64) { held.target.value = value; }

machine main() crashes Trap {
    let cell: Cell = Cell { value: 11 };
    let mut held: Held = Held { target: &mut cell };
    let before: i64 = read(&held);
    store(&mut held, 85);
    let after: i64 = read(&held);
    transition before == 11 && after == 85 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
