// A callee that promises `bytes in Ascii` at return may store an ASCII byte
// into the lent array; the caller reads the stored byte and its neighbor.
// Expected exit: 0.
domain [u8; 2]::Ascii requires ascii_only(self);
machine mutate(bytes: &mut [u8; 2] in Ascii)
ensures bytes in Ascii
{ bytes[0] = 65u8; }

machine main() crashes Trap {
    let bytes: [u8; 2] in Ascii = "zb";
    mutate(&mut bytes);
    transition bytes[0] == 65 && bytes[1] == 98 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
