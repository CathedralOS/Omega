use omega::language::core::drop;

data Evidence {
    tag: i32;
}

data Guard dropped by drop_guard {
    handle: i32;
}

machine drop_guard(guard: &Guard) {
}

// A record needs no `dropped by` hook of its own: the cleanup edge
// selects member hooks for live storage, and an erased member carries no
// runtime representation to clean — even though its type has no hook at all.
data Carrier {
    payload: i32;
    guard: Guard;
    proof [erased]: Evidence;
}

machine main() {
    let carrier: Carrier = Carrier {
        payload: 1,
        guard: Guard { handle: 7 },
        proof: Evidence { tag: 0 },
    };
    drop(carrier);
}
