// Expected exit: 0
data Token dropped by drop_token { ready: bool; value: u64; }
machine drop_token(token: &mut Token) requires token.ready { token.ready = false; }
machine make_token() -> Token ensures result.ready == true { Token { ready: true, value: 7 } }
machine read(token: &Token) -> u64 { token.value }
machine main() { let old: Token = Token { ready: true, value: 1 }; old = make_token(); }
