// Expected exit: 0
// An indexed value keeps the limit captured before the source variable changes.
data Indexed<Limit: u32> { value: u32; }
machine read<Count: u32>(item: Indexed<Count>) -> u32 { item.Limit }
machine probe(start: u32) crashes Trap {
    let mut limit: u32 = start;
    let saved: u32 = limit;
    let item: Indexed<limit> = Indexed { value: 29 };
    limit = 13;
    let observed: u32 = read<saved>(item);
    transition observed == saved && limit == 13 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap { probe(7); probe(8); }
