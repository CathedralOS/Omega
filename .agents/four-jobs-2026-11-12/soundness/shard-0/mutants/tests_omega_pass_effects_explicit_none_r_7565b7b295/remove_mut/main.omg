// `reaches none` and `crashes none` are the explicit empty promises; a body
// that reaches nothing and cannot crash satisfies both.
// Expected exit: 0
public machine quiet() -> u64 reaches none crashes none {
    let value: u64 = 0;
    value = 7;
    value
}
machine main() reaches none crashes Trap {
    let value: u64 = quiet();
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
