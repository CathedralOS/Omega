// Expected exit: 0
// A rebound reference local reads its new referent, and facts about that
// referent apply through it. `s` starts at the unbounded `b`, then names `a`,
// whose entry requirement proves `s - 5` cannot underflow. At run time `a` is
// 9 and `b` is 0: reading the new referent yields 4, while a lowering that kept
// the old binding would underflow and trap, or return a value other than 4.
machine observe(a: &mut u64, b: &u64) -> u64
requires a >= 5 {
    let mut s: &u64 = b;
    s = a;
    s - 5
}

machine main() crashes Trap {
    let a: u64 = 9;
    let b: u64 = 0;
    let r: u64 = observe(&a, &b);
    transition r == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
