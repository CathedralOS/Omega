// Expected exit: 0
// A selected record keeps the integer bound of its field through both match arms.
public const Zero: i32 = 0;
data Cell { value: i32; }
public trait Reader<const Limit: i32> {
    machine read(value: i32) -> i32 crashes Trap value < Limit;
}
Provider<const Bound: i32> satisfies Reader<Bound> {
    machine read(value: i32) -> i32 { value }
}
public machine safe<Implementation satisfies Reader<Zero>>(value: i32) -> i32

{
    let selected: Cell = match value == 0 {
        true -> Cell { value: value },
        _ -> Cell { value: 7 },
    };
    Implementation::read(selected.value)
}
machine main() crashes Trap {
    transition safe<Provider<Zero>>(0) == 0 && safe<Provider<Zero>>(5) == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
