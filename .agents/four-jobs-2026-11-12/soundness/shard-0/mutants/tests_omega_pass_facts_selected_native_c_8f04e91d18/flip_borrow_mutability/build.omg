machine build(builder: &mut Build) {
    Build::application(builder, "selected_native_code_layout_target_body");
    Build::select_provider<SelectedLayoutCheck, CheckedLayoutProbe>(builder, linux_x86_64);
    Build::select_provider<SelectedLayoutCheck, CheckedLayoutProbe>(builder, linux_arm64);
    Build::select_provider<SelectedLayoutCheck, CheckedLayoutProbe>(builder, macos_arm64);
    Build::select_provider<SelectedLayoutCheck, CheckedLayoutProbe>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
