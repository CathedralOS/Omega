// A fixed-token boundary operator whose `requires` names its right operand runs
// through a selected checked satisfier. `prepare(&held)` stores 1, returns
// 1 and ensures `value >= 0`, so the right operand read after the effect both
// discharges `right >= 0` and equals the left operand. Reading `held` before
// the effect would compare 1 with 5; a builtin comparison in place of the
// satisfier's body would ignore the selection. The operator is used directly,
// in a later state and through locals, and every use must hold. The same
// program without a satisfier is
// `fail/providers/boundary_operator_without_provider`.
// The operator's declared home: bare primitive operands would join the
// core's primitive operator family, which only the core may publish. Each use
// borrows a mutable local copy of the qualified argument.
domain i32::Counted requires self >= -1000000; self <= 1000000;

boundary machine == Integer::equal(left: i32 in Counted, right: i32 in Counted) -> bool
requires right >= 0;

data CheckedEquality {}

machine CheckedEquality::equal(left: i32 in Counted, right: i32 in Counted) -> bool
satisfies Integer::equal
requires right >= 0
{
    left <= right && left >= right
}

machine prepare(value: &mut i32 in Counted) -> i32 in Counted
ensures value >= 0 {
    value = 1;
    1
}

machine direct(value: i32 in Counted) -> bool {
    let mut held: i32 in Counted = value;
    prepare(&mut held) == held
}

machine deferred(value: i32 in Counted) -> bool {
    transition { _ -> later(value) }
    machine later(value: i32 in Counted) -> bool {
        let mut held: i32 in Counted = value;
        prepare(&mut held) == held
    }
}

machine through_locals(value: i32 in Counted) -> bool {
    let mut held: i32 in Counted = value;
    let prepared: i32 in Counted = prepare(&mut held);
    let equal: bool = prepared == held;
    equal
}

machine main() crashes Trap {
    let first: bool = direct(5);
    let second: bool = deferred(5);
    let third: bool = through_locals(5);
    transition first && second && third {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
