// Every hosted target selects its exact entry and the checked satisfier.

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_selected_operator_requires_after_effects_exit");
    Build::select_provider<Integer::equal, CheckedEquality>(builder, linux_arm64);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, linux_x86_64);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, macos_arm64);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, macos_x86_64);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, windows_x86_64);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, uefi_x86_64);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, cross_platform_cli);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, local_unchecked);
    Build::select_provider<Integer::equal, CheckedEquality>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
