// A finite-family method on a borrowed record returns a descriptor of the original backing, and reading its first byte yields 11.
// Expected exit: 0
// Place: match_join.
data Returned<'bytes> [copy] { case Narrow(packet: Packet<'bytes>); case Wide(packet: Packet<'bytes>); }
data Packet<'bytes> [copy] { bytes: &'bytes [u8]; }
trait Windowing<Input, Output> {
    machine window<Width: u32>(source: &mut Input) -> Output
    requires Width == 16 || Width == 32;
}
Header<'bytes> satisfies Windowing<Packet<'bytes>, Returned<'bytes>> {
    machine window<Width: u32>(source: &Packet<'bytes>) -> Returned<'bytes>
    requires Width == 16 || Width == 32 {
        transition Width == 16 {
            true -> Returned::Narrow { packet: Packet { bytes: source.bytes } }
            false -> Returned::Wide { packet: Packet { bytes: source.bytes } }
        }
    }
}
machine dispatch<'bytes>(selected: dyn Windowing<Packet<'bytes>, Returned<'bytes>>, source: &Packet<'bytes>, width: u32) -> Returned<'bytes>
requires width == 16 || width == 32 {
    Windowing::window<width>(selected, source)
}
machine unwrap<'bytes>(returned: Returned<'bytes>, width: u32) -> Packet<'bytes> crashes Trap {
    transition returned {
        Returned::Narrow { packet } -> confirm(packet, 16, width)
        Returned::Wide { packet } -> confirm(packet, 32, width)
    }
}
machine confirm<'bytes>(packet: Packet<'bytes>, actual: u32, expected: u32) -> Packet<'bytes> crashes Trap {
    transition actual == expected { true -> (packet) false -> bad(packet) }
    machine bad(packet: Packet<'bytes>) -> Packet<'bytes> { crash Trap; }
}
machine check<'bytes>(packet: &Packet<'bytes>, width: u32, last: u8) crashes Trap
requires width == 16 || width == 32
{
    let selected: dyn Windowing<Packet<'bytes>, Returned<'bytes>> = Header as dyn Windowing<Packet<'bytes>, Returned<'bytes>>;
    let returned: Returned = dispatch(selected, packet, width);
    let result: Packet = unwrap(returned, width);
    transition result.bytes.len == 3 { true -> read(result, last) false -> bad() }
    machine read(result: Packet, last: u8) requires result.bytes.len == 3 {
        transition result.bytes[0] == 11 && result.bytes[2] == last { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine exercise(choice: bool, last: u8) crashes Trap {
    let backing: [u8; 3] = [11, 22, 33];
    let alternate: [u8; 3] = [11, 44, 55];
    let packet: Packet = match choice {
        true -> Packet { bytes: &backing[..] },
        false -> Packet { bytes: &alternate[..] }
    };
    check(&packet, 16, last);
    check(&packet, 32, last);
}
machine main() crashes Trap {
    exercise(true, 33);
    exercise(false, 55);
}
