// A data `requires` that relates two fields is owed again by a store to one
// of them. The clause is proved over the stored value and the value the
// other field already holds: `high` was written once, by the literal, so
// `5 <= 9` is what the store to `low` must establish.
// The failing twin differs only in the stored value.
data Span [copy] requires low <= high { low: u32; high: u32; }

machine width(span: Span) -> u32 { span.high }

machine main() {
    let span: Span = Span { low: 1, high: 9 };
    span.low = 5;
    let high: u32 = width(span);
}
