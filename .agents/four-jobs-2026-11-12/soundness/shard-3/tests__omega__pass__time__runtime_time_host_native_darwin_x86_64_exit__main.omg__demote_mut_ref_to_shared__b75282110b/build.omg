// Darwin time-host canary: select only the target whose calibration it asserts.

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_time_host_native_darwin_x86_64_exit");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../../source/library/std"
    }));
    Build::bind(builder, macos_x86_64::ProgramEntry, entry_start);
}
