machine build(builder: &mut Build) {
    Build::select_provider<Observation, ObservationImplementation>(builder, linux_arm64);
    Build::select_provider<Observation, ObservationImplementation>(builder, linux_x86_64);
    Build::select_provider<Observation, ObservationImplementation>(builder, macos_arm64);
    Build::select_provider<Observation, ObservationImplementation>(builder, macos_x86_64);
    Build::select_provider<Observation, ObservationImplementation>(builder, windows_x86_64);
    Build::select_provider<Observation, ObservationImplementation>(builder, uefi_x86_64);
    Build::select_provider<Observation, ObservationImplementation>(builder, cross_platform_cli);
    Build::select_provider<Observation, ObservationImplementation>(builder, local_unchecked);
    Build::select_provider<Observation, ObservationImplementation>(builder, alpha_bootstrap);
    Build::application(builder, "selected_native_code_layout_local");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
