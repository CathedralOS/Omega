machine build(builder: &mut Build) {
    Build::application(builder, "boolean_policy_record");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Check<Cell, accepts>, Selected>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<Check<Cell, accepts>, Selected>(builder, linux_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<Check<Cell, accepts>, Selected>(builder, macos_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Check<Cell, accepts>, Selected>(builder, linux_arm64);
}
