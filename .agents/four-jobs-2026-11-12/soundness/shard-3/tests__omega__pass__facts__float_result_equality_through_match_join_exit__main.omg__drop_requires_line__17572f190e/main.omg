// A returned f64 equals the live field it came from.
// Expected exit: 0
data Ends { kept: f64; other: f64; }

machine read_kept(item: &Ends, flag: bool) -> f64
ensures result == item.kept && result == 7.0
{
    item.kept
}

machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}

data Observed [copy] { saved: f64; route: u64; }
machine marked_read(item: &Ends, flag: bool) -> Observed
requires item.kept == 7.0
ensures result.saved == item.kept && result.saved == 7.0
{
    match flag {
        true -> Observed { saved: read_kept(item, true), route: 17 },
        false -> Observed { saved: read_kept(item, false), route: 23 }
    }
}

machine main() crashes Trap {
    let item: Ends = Ends { kept: 7.0, other: 1.0 };
    let left: Observed = marked_read(&item, true);
    let right: Observed = marked_read(&item, false);
    let first: f64 = agree(left.saved, item.kept);
    let second: f64 = agree(right.saved, item.kept);
    transition first == 7.0 && second == 7.0 && left.route == 17 && right.route == 23 && item.other == 1.0 {
        true -> done()
        _ -> bad()
    }

    machine done() {}
    machine bad() { crash Trap; }
}
