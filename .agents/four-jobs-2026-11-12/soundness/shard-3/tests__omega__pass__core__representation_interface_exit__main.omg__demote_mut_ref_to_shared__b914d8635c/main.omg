// Expected exit: 0
use omega::language::core::conversion;
use omega::language::core::representation;

data NoResources [copy] { }
data Frame [copy] { tag: u8; value: u8; }
data WriteError [copy] { case Unsupported; }
data ReadError [copy] { case InvalidTag; }

OwnedModel satisfies RepresentationModel<u8, Frame> {
    machine valid<'view>(frame: &'view Frame) -> bool
    reaches none terminates { frame.tag == 165u8 }
    machine represents<'view, 'value>(frame: &'view Frame, value: &'value u8) -> bool
    reaches none terminates { frame.value == value }
    machine unique<'view, 'left, 'right>(frame: &'view Frame, left: &'left u8, right: &'right u8)
    reaches none terminates
    requires represents(frame, left)
    requires represents(frame, right)
    ensures core::Identity<u8>(left, right) { }
}
Write<'value> satisfies TryFrom<RepresentationRequest<&'value u8, NoResources>, Frame, WriteError> {
    machine try_from(source: RepresentationRequest<&'value u8, NoResources>) -> Result<Frame, WriteError>
    terminates
    ensures result in Result::Ok
    ensures OwnedModel::valid(&result.value)
    ensures OwnedModel::represents(&result.value, source.value)
    { Result::Ok { value: Frame { tag: 165u8, value: source.value } } }
}
Read<'frame> satisfies TryFrom<RepresentationDecodeRequest<'frame, Frame, NoResources>,
    RepresentationRequest<u8, NoResources>, ReadError>
{
    machine try_from(source: RepresentationDecodeRequest<'frame, Frame, NoResources>)
        -> Result<RepresentationRequest<u8, NoResources>, ReadError>
    terminates
    ensures OwnedModel::valid(source.frame) == (result in Result::Ok)
    ensures (result in Result::Err) || OwnedModel::represents(source.frame, &result.value.value)
    {
        transition source.frame.tag == 165u8 {
            true -> Result::Ok { value: RepresentationRequest { value: source.frame.value, resources: source.resources } }
            false -> Result::Err { error: ReadError::InvalidTag }
        }
    }
}
OwnedRepresentation<'value, 'frame> satisfies Representation<'value, 'frame, u8,
    NoResources, NoResources, Frame, WriteError, ReadError, OwnedModel, Write<'value>, Read<'frame>> { }

// This echo establishes its own preservation promise, independently of any
// codec. The invalid control shows that it cannot certify unsupported maps.
machine echo<'value>(request: RepresentationRequest<&'value u8, NoResources>)
    -> Result<RepresentationRequest<u8, NoResources>, RepresentationError<WriteError, ReadError>>
terminates
ensures result in Result::Ok
ensures core::Identity<u8>(result.value.value, request.value)
{ Result::Ok { value: RepresentationRequest { value: request.value, resources: request.resources } } }

// This consumer receives only the public selected-map contracts. It proves
// preservation from the encoder's model fact and the actual decoder result.
machine selected_decode<'value, 'frame, EncodingResources, Frame, EncodingError,
    Model satisfies RepresentationModel<u8, Frame>,
    Encode satisfies RepresentationEncoding<'value, u8, EncodingResources, Frame, EncodingError, Model>,
    Decode satisfies RepresentationDecoding<'frame, u8, NoResources, Frame, ReadError, Model>,
    Agreement satisfies Representation<'value, 'frame, u8, EncodingResources, NoResources, Frame,
        EncodingError, ReadError, Model, Encode, Decode>>
    (before: &'value u8, frame: &'frame Frame) -> Result<RepresentationRequest<u8, NoResources>, ReadError>
terminates
requires Model::valid(frame)
requires Model::represents(frame, before)
ensures result in Result::Ok
ensures core::Identity<u8>(result.value.value, before)
{
    let decoded: Result<RepresentationRequest<u8, NoResources>, ReadError> =
        Decode::try_from(RepresentationDecodeRequest { frame: frame, resources: NoResources { } });
    transition decoded {
        Result::Err { error as error } -> Result::Err { error: error }
        Result::Ok { value as restored } -> proved(frame, before, restored)
    }
    machine proved(frame: &'frame Frame, before: &'value u8, restored: RepresentationRequest<u8, NoResources>)
        -> Result<RepresentationRequest<u8, NoResources>, ReadError>
    terminates
    requires Model::represents(frame, before)
    requires Model::represents(frame, &restored.value)
    ensures result in Result::Ok
    ensures core::Identity<u8>(result.value.value, before)
    {
        Model::unique(frame, &restored.value, before);
        Result::Ok { value: restored }
    }
}

machine owned_read<'value, 'frame>(before: &'value u8, frame: &'frame Frame)
    -> Result<RepresentationRequest<u8, NoResources>, ReadError>
requires OwnedModel::valid(frame)
requires OwnedModel::represents(frame, before)
ensures result in Result::Ok
ensures core::Identity<u8>(result.value.value, before)
{
    selected_decode<NoResources, Frame, WriteError, OwnedModel, Write<'value>, Read<'frame>,
        OwnedRepresentation<'value, 'frame>>(before, frame)
}
machine observe<'value>(value: &'value u8, expected: u8) -> bool {
    let request: RepresentationRequest<&'value u8, NoResources> = RepresentationRequest {
        value: value, resources: NoResources { }
    };
    let echoed: Result<RepresentationRequest<u8, NoResources>, RepresentationError<WriteError, ReadError>> = echo(RepresentationRequest { value: value, resources: NoResources { } });
    let echo_same: bool = echoed.value.value == expected;
    let encoded: Result<Frame, WriteError> = Write<'value>::try_from(request);
    transition encoded {
        Result::Err { error as error } -> false
        Result::Ok { value as frame } -> inspect(value, &frame, expected, echo_same)
    }
    machine inspect<'frame>(value: &'value u8, frame: &'frame Frame, expected: u8, echo_same: bool) -> bool
    requires OwnedModel::valid(frame)
    requires OwnedModel::represents(frame, value)
    {
        transition owned_read(value, frame) {
            Result::Err { error as error } -> false
            Result::Ok { value as restored } -> (echo_same && reject_malformed(restored.value, expected))
        }
    }
}
machine reject_malformed(value: u8, expected: u8) -> bool {
    let malformed: Frame = Frame { tag: 0u8, value: value };
    inspect(&malformed, value, expected)
    machine inspect<'frame>(malformed: &'frame Frame, value: u8, expected: u8) -> bool {
        transition Read<'frame>::try_from(RepresentationDecodeRequest { frame: malformed, resources: NoResources { } }) {
            Result::Err { error as error } -> (value == expected)
            Result::Ok { value as unexpected } -> false
        }
    }
}

// The caller supplies the output buffer, and keeps its owner while decoding.
data Buffer<'buffer> requires self.output.len >= 2u64 { output: &'buffer mut [u8]; }
data BufferedFrame<'buffer> requires self.output.len >= 2u64 { output: &'buffer mut [u8]; }
data BufferFailure<'buffer> { output: &'buffer mut [u8]; }
BufferModel<'buffer> satisfies RepresentationModel<u8, BufferedFrame<'buffer>> {
    machine valid<'view>(frame: &'view BufferedFrame<'buffer>) -> bool
    reaches none terminates { frame.output[0u64] == 165u8 }
    machine represents<'view, 'value>(frame: &'view BufferedFrame<'buffer>, value: &'value u8) -> bool
    reaches none terminates { frame.output[1u64] == value }
    machine unique<'view, 'left, 'right>(frame: &'view BufferedFrame<'buffer>, left: &'left u8, right: &'right u8)
    reaches none terminates
    requires represents(frame, left)
    requires represents(frame, right)
    ensures core::Identity<u8>(left, right) { }
}
WriteBuffer<'value, 'buffer> satisfies TryFrom<RepresentationRequest<&'value u8, Buffer<'buffer>>,
    BufferedFrame<'buffer>, BufferFailure<'buffer>>
{
    machine try_from(source: RepresentationRequest<&'value u8, Buffer<'buffer>>)
        -> Result<BufferedFrame<'buffer>, BufferFailure<'buffer>>
    terminates
    ensures result in Result::Ok
    ensures BufferModel<'buffer>::valid(&result.value)
    ensures BufferModel<'buffer>::represents(&result.value, source.value)
    {
        source.resources.output[0u64] = 165u8;
        source.resources.output[1u64] = source.value;
        Result::Ok { value: BufferedFrame { output: source.resources.output } }
    }
}
ReadBuffer<'frame, 'buffer> satisfies TryFrom<RepresentationDecodeRequest<'frame, BufferedFrame<'buffer>, NoResources>,
    RepresentationRequest<u8, NoResources>, ReadError>
{
    machine try_from(source: RepresentationDecodeRequest<'frame, BufferedFrame<'buffer>, NoResources>)
        -> Result<RepresentationRequest<u8, NoResources>, ReadError>
    terminates
    ensures BufferModel<'buffer>::valid(source.frame) == (result in Result::Ok)
    ensures (result in Result::Err) || BufferModel<'buffer>::represents(source.frame, &result.value.value)
    {
        transition source.frame.output[0u64] == 165u8 {
            true -> Result::Ok { value: RepresentationRequest { value: source.frame.output[1u64], resources: source.resources } }
            false -> Result::Err { error: ReadError::InvalidTag }
        }
    }
}
BufferedRepresentation<'value, 'frame, 'buffer> satisfies Representation<'value, 'frame, u8,
    Buffer<'buffer>, NoResources, BufferedFrame<'buffer>, BufferFailure<'buffer>, ReadError,
    BufferModel<'buffer>, WriteBuffer<'value, 'buffer>, ReadBuffer<'frame, 'buffer>> { }

machine buffered_read<'value, 'frame, 'buffer>(before: &'value u8, frame: &'frame BufferedFrame<'buffer>)
    -> Result<RepresentationRequest<u8, NoResources>, ReadError>
requires BufferModel<'buffer>::valid(frame)
requires BufferModel<'buffer>::represents(frame, before)
ensures result in Result::Ok
ensures core::Identity<u8>(result.value.value, before)
{
    selected_decode<Buffer<'buffer>, BufferedFrame<'buffer>, BufferFailure<'buffer>,
        BufferModel<'buffer>, WriteBuffer<'value, 'buffer>, ReadBuffer<'frame, 'buffer>,
        BufferedRepresentation<'value, 'frame, 'buffer>>(before, frame)
}
machine buffered<'value, 'buffer>(output: &'buffer mut [u8], value: &'value u8, expected: u8) -> bool
requires output.len >= 2u64
{
    let encoded: Result<BufferedFrame<'buffer>, BufferFailure<'buffer>> =
        WriteBuffer<'value, 'buffer>::try_from(RepresentationRequest {
            value: value, resources: Buffer { output: output }
        });
    transition encoded {
        Result::Err { error as error } -> false
        Result::Ok { value as frame } -> inspect(frame, value, expected)
    }
    machine inspect(frame: BufferedFrame<'buffer>, value: &'value u8, expected: u8) -> bool
    requires BufferModel<'buffer>::valid(&frame)
    requires BufferModel<'buffer>::represents(&frame, value)
    {
        let decoded: Result<RepresentationRequest<u8, NoResources>, ReadError> = buffered_read(value, &frame);
        let same: bool = checked(decoded, expected);
        frame.output[0u64] = 166u8;
        same
    }
    machine checked(decoded: Result<RepresentationRequest<u8, NoResources>, ReadError>, expected: u8) -> bool {
        transition decoded {
            Result::Err { error as error } -> false
            Result::Ok { value as restored } -> (restored.value == expected)
        }
    }
}

machine main() crashes Trap {
    let first: u8 = 17u8;
    let edge: u8 = 255u8;
    let buffer_value: u8 = 42u8;
    let ordinary: bool = observe(&first, 17u8);
    let endpoint: bool = observe(&edge, 255u8);
    let mut storage: [u8; 4] = [81u8, 1u8, 2u8, 82u8];
    let restored: bool = buffered(&storage[1u64..3u64], &buffer_value, 42u8);
    let canaries: bool = storage[0u64] == 81u8 && storage[1u64] == 166u8
        && storage[2u64] == 42u8 && storage[3u64] == 82u8;
    transition ordinary && endpoint && restored && canaries {
        true -> done()
        false -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
