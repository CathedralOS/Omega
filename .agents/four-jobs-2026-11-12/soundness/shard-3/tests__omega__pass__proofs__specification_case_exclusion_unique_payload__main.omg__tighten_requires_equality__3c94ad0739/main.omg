// Excluding both alternatives leaves exactly the First payload.
data Choice<Value> {
    case Empty;
    case First(first: Value);
    case Second(second: Value);
}

trait Observe {
    machine read(value: Choice<u32>) -> u32
    requires (value in Choice::Empty) || ((value in Choice::Second) || value.first == 1u32);
}

machine main() {}
