// Chapter 17: a resource-owning type defines cleanup
// through the reserved `drop` machine shape. `drop_guard(guard: &Guard)` is the
// teardown obligation; when a `Guard` local stops being live the compiler is
// responsible for the structural cleanup. Defining the drop machine and letting
// an owned local die at end of state type-checks cleanly.
//
// A non-empty `drop` body is an ordinary Unit machine body: a source-ordered
// list of ordinary calls to attached helpers runs at the cleanup edge.

data Guard dropped by drop_guard {
    handle: i32;
}

// Marker carrier for the ordered teardown helpers.
data Teardown {
}

machine Teardown::unlock() {
}

machine Teardown::flush() {
}

machine drop_guard(guard: &mut Guard) {
    Teardown::unlock();
    Teardown::flush();
}

machine main() {
    let g: Guard = Guard { handle: 7 };
}
