// Expected exit: 0
// A selected handler keeps the restricted service access of its refined requirement.
boundary trait External { machine touch() reaches; }
trait Reading { machine value(input: u64) -> u64 reaches External; }
trait Immediate = Reading { machine * reaches; }
machine selected(input: u64) -> u64
satisfies Reading::value
reaches
{ input ^ 9u64 }
machine forward<machine Handler>(input: u64) -> u64
reaches
{ Handler(input) }
machine start() reaches crashes Trap {
    transition forward<selected>(2) == 11 && forward<selected>(4) == 13 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
