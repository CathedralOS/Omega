// Fact: align_of(value) observes the storage location of a live u64 place, the referent of a &mut u64, or the first element of a nonempty [u64] slice, and reports that location's guaranteed alignment, at least 8u64 on every hosted target, discharging exact subtraction alignment - 8u64 across all nine places.
// Place: const name. A const names the required alignment that the observed location's alignment is subtracted against.
// Expected exit: 0

const REQUIRED_ALIGNMENT: u64 = 8u64;

machine main() crashes Trap {
    let cell: u64 = 41u64;
    let tag: u8 = 3u8;
    let alignment: u64 = align_of(cell);
    let slack: u64 = alignment - REQUIRED_ALIGNMENT;
    let tag_alignment: u64 = align_of(tag);
    transition alignment == 8u64 && slack == 0u64 && tag_alignment == 1u64 && cell == 41u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
