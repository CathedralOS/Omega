// Expected exit: 0
// A write through a `&mut` reference local changes only the storage it names.
// `alias` names `counter.other`, so the read of `counter.value` before the
// store still equals the read after it, and `demand_same` checks. Reject twin:
// fail/proofs/scalar_field_snapshot_after_alias_store, where `alias` names
// `counter.value` itself. At run time the store must land in `other` (3 -> 7)
// and leave `value` at 11; a store into the wrong field traps.
data Counter { value: u64; other: u64; }

machine demand_same(left: u64, right: u64) requires left == right {}

machine inspect(counter: &Counter) -> u64 {
    let before: u64 = counter.value;
    let alias: &mut u64 = &mut counter.other;
    alias = 7;
    let after: u64 = counter.value;
    demand_same(before, after);
    after
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { value: 11, other: 3 };
    let seen: u64 = inspect(&mut counter);
    transition seen == 11 && counter.value == 11 && counter.other == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
