// Expected exit: 0.
// Execute the complete admitted ordering canary and check each actual snapshot.
// This serial witness does not prove concurrent global-order or publication laws.

machine main() -> u32 crashes Trap {
    let counter: AtomicU32;
    let mut wide: AtomicU64;
    let mut flag: AtomicBool;
    counter.store(10, GlobalOrder);
    let observed_atomic_observed: u32 = counter.load(GlobalOrder);
    let observed: u32 in Wrapping = observed_atomic_observed as u32 in Wrapping;
    let prior: u32 in Wrapping = counter.fetch_add(5, ReceivePublish);
    let displaced: u32 in Wrapping = counter.swap(20, GlobalOrder);
    let cas_prior: u32 in Wrapping = counter.compare_exchange(20, 30, GlobalOrder, Receive);

    // AtomicU64: the same admitted ordering surface at a second width —
    // GlobalOrder load/store, ReceivePublish fetch and swap, and a
    // GlobalOrder read-only failure beneath GlobalOrder success.
    wide.store(7, GlobalOrder);
    let wide_observed_atomic_observed: u64 = wide.load(GlobalOrder);
    let wide_observed: u64 in Wrapping = wide_observed_atomic_observed as u64 in Wrapping;
    let wide_prior: u64 in Wrapping = wide.fetch_sub(3, ReceivePublish);
    let wide_displaced: u64 in Wrapping = wide.swap(20, ReceivePublish);
    let wide_cas: u64 in Wrapping = wide.compare_exchange(20, 30, GlobalOrder, GlobalOrder);

    // AtomicBool: the non-arithmetic ordering pair — a Publish store observed
    // through a Receive load. Fetch, swap, and compare-exchange arithmetic
    // carriers do not apply to a boolean resident.
    flag.store(true, Publish);
    let flag_seen: bool = flag.load(Receive);

    // Remaining legal ordering pairings on the u32 cell: Publish store
    // ordered before a Receive observation, ReceivePublish swap, and
    // compare-exchange success/failure beneath ReceivePublish and NoOrdering.
    counter.store(77, Publish);
    let received_atomic_observed: u32 = counter.load(Receive);
    let received: u32 in Wrapping = received_atomic_observed as u32 in Wrapping;
    let republished: u32 in Wrapping = counter.swap(55, ReceivePublish);
    let cas_relaxed_failure: u32 in Wrapping =
        counter.compare_exchange(55, 1, ReceivePublish, NoOrdering);
    let cas_relaxed: u32 in Wrapping =
        counter.compare_exchange(1, 2, NoOrdering, NoOrdering);
    // These are runtime oracles after the events, not static admission premises.
    transition observed == 10 && prior == 10 && displaced == 15 && cas_prior == 20
        && wide_observed == 7 && wide_prior == 7 && wide_displaced == 4 && wide_cas == 20
        && flag_seen && received == 77 && republished == 77
        && cas_relaxed_failure == 55 && cas_relaxed == 1
        && counter.load(NoOrdering) == 2 && wide.load(NoOrdering) == 30 {
        true -> ((observed + prior + displaced + cas_prior + received + republished + cas_relaxed_failure + cas_relaxed) as u32)
        _ -> bad()
    }
    machine bad() -> u32 crashes Trap { crash Trap; }
}

// The entry also checks the original returned sum.
machine global_order_entry() crashes Trap {
    let total: u32 = main();
    transition total == 265 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
