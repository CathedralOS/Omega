// Expected exit: 0
// The copied argument keeps its nonnegative bound when a later argument overwrites its source.
public const Zero: i32 = 0;
public trait Reader<const Limit: i32> {
    machine read(value: i32, ignored: i32) -> i32 crashes Trap value < Limit;
}
Provider<const Bound: i32> satisfies Reader<Bound> {
    machine read(value: i32, ignored: i32) -> i32 { value }
}
machine clear(value: &i32) -> i32 { value = 0; 0 }
public machine safe<Implementation satisfies Reader<Zero>>(value: &mut i32) -> i32
requires value >= 0
{ Implementation::read(value, clear(&mut value)) }
machine main() crashes Trap {
    let mut input: i32 = 7;
    let observed: i32 = safe<Provider<Zero>>(&mut input);
    transition observed == 7 && input == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
