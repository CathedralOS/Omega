// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0

data Index<Limit:u32> [copy] requires value<Limit {value:u32;}
data Observation [copy] {payload:u32;limit:u32;}

machine bound<Count:u32>()->u32 ensures result==Count { transition Count {9 -> 9 _ -> Count} }
machine choose<Created:u32>()->Index<(bound<Created>())> { Index{value:8} }
machine construct(limit: u32)->Observation requires limit >= 9 && limit <= 10 {
 let indexed:Index<limit> = choose<limit>();
 Observation{payload:indexed.value,limit:indexed.Limit}
}

const Minimum:u32=9;
const Maximum:u32=10;
machine probe(limit: u32)->Observation requires limit >= Minimum && limit <= Maximum {construct(limit)}
machine main() crashes Trap {
 let first:Observation=probe(9);
 let second:Observation=probe(10);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 {true->done() _->bad()}
 machine done() {}
 machine bad() crashes Trap {crash Trap;}
}
