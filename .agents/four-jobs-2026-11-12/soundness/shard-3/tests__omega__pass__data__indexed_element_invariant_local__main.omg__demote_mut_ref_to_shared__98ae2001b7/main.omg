// A value read from an array element at a runtime index still satisfies its
// data type's requires, so a local bound to it carries that invariant.
data Vitality [copy]
requires maximum >= 0, current >= 0 && current <= maximum {
    current: i32;
    maximum: i32;
}

data Actor [copy] {
    vitality: Vitality;
}

data Set {
    items: [Actor; 2];
}

machine heal(set: &Set, selected: u64) requires selected < 2 {
    let vitality: Vitality = set.items[selected].vitality;
    set.items[selected].vitality = Vitality { current: vitality.maximum, maximum: vitality.maximum };
}

machine main() {}
