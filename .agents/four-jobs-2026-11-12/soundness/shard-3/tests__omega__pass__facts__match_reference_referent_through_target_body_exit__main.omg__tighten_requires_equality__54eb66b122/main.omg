// A match selects one of two references, the join records that reference, and the consumer reads through the recorded reference.
// Place: target_body.
// Expected exit: 0

machine choose() -> bool
ensures result == true
{
    true
}

machine read_through(place: &i64) -> i64
requires place == 18
{
    place
}

machine apply(chosen: &i64, spare: &i64) -> i64
requires chosen == 17
{
    let joined: &i64 = match choose() {
        true -> chosen
        false -> spare
    };
    read_through(joined)
}

boundary trait SelectedReference {
    machine read(chosen: &i64, spare: &i64) -> i64
    requires chosen == 17
    reaches;
}

LinuxX86Reference satisfies SelectedReference {
    machine read(chosen: &i64, spare: &i64) -> i64
    requires chosen == 17
    reaches {
        apply(chosen, spare)
    }
}

LinuxArmReference satisfies SelectedReference {
    machine read(chosen: &i64, spare: &i64) -> i64
    requires chosen == 17
    reaches {
        apply(chosen, spare)
    }
}

MacReference satisfies SelectedReference {
    machine read(chosen: &i64, spare: &i64) -> i64
    requires chosen == 17
    reaches {
        apply(chosen, spare)
    }
}

WindowsReference satisfies SelectedReference {
    machine read(chosen: &i64, spare: &i64) -> i64
    requires chosen == 17
    reaches {
        apply(chosen, spare)
    }
}

machine main() crashes Trap {
    let chosen: i64 = 17;
    let spare: i64 = 5;
    let observed: i64 = SelectedReference::read(&chosen, &spare);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
