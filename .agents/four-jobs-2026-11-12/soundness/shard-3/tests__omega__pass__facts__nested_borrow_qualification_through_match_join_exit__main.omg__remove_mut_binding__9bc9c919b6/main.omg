// A nested borrowed record preserves the final-word-is-zero qualification for a consuming call.
// Place: match_join.
// Expected exit: 0
public domain [u16; 4]::Terminated requires self[3] == 0;
public data Name<'scope> { words: &'scope [u16; 4] in Terminated; }
public data Attributes<'scope> { name: &'scope Name<'scope>; }
machine final_word(word: u16) -> u16 requires word == 0 { word }
public machine consume<'scope>(attributes: &Attributes<'scope>) -> u16 {
    final_word(attributes.name.words[3])
}

// Nonzero neighbors make an incorrect nested pointer or element offset observable.
machine neighbors_valid<'scope>(attributes: &Attributes<'scope>, expected_first: u16) -> bool {
    attributes.name.words[0] == expected_first
        && attributes.name.words[1] == 23
        && attributes.name.words[2] == 37
}
machine consume_with_neighbor_checks<'scope>(attributes: &Attributes<'scope>, expected_first: u16) -> u16 {
    let result: u16 = consume(attributes);
    transition neighbors_valid(attributes, expected_first) { true -> result false -> 1 }
}

machine choose<'scope>(first: bool, left: &'scope Attributes<'scope>, right: &'scope Attributes<'scope>) -> &'scope Attributes<'scope> {
    transition first { true -> left false -> right }
}

data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    let words: [u16; 4];
    words[0] = 11;
    words[1] = 23;
    words[2] = 37;
    words[3] = 0;
    let name: Name = Name { words: &words };
    let attributes: Attributes = Attributes { name: &name };
    let mut other_words: [u16; 4];
    other_words[0] = 41;
    other_words[1] = 23;
    other_words[2] = 37;
    other_words[3] = 0;
    let other_name: Name = Name { words: &other_words };
    let other_attributes: Attributes = Attributes { name: &other_name };
    let view: &Attributes = choose(true, &attributes, &other_attributes);
    let result: u16 = consume_with_neighbor_checks(view, 11);
    let other_view: &Attributes = choose(false, &attributes, &other_attributes);
    let other_result: u16 = consume_with_neighbor_checks(other_view, 41);
    transition result == 0 && other_result == 0 { true -> done() false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
