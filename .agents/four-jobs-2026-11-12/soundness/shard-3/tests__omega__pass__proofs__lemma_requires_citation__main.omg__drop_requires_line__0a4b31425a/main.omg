// Citing a REQUIRES-bearing lemma works when the citer's own
// hypotheses establish the instantiated requires: `cite_with_requires`
// carries the same `(x) == (add(y, Zero))` shape, the site discharge
// proves it, then `minus_swap`'s injected ensures settles the goal.
// `minus` is unlicensed — the library's `add_zero_right` is package-private (gap: proof lemmas can't be cited cross-package); a user-authored axiom supplies it here, and the lemma's ensures links
// `minus(x,z)` to `minus(y,z)`.
use omega::language::core::nat;
boundary machine unit_right(a: Nat) -> Nat
ensures
    core::Identity<Nat>(a, add(a, Nat::Zero {}));
machine minus(a: Nat, b: Nat) -> Nat {
    transition { _ -> (a) }
}
machine minus_swap(a: Nat, b: Nat, c: Nat) -> Nat
    core::Identity<Nat>(a, add(b, Nat::Zero {}))
ensures
    core::Identity<Nat>(minus(a, c), minus(b, c))
{
    unit_right(b);
    transition { _ -> (minus(a, c)) }
}
machine cite_with_requires(x: Nat, y: Nat, z: Nat) -> Nat
requires
    core::Identity<Nat>(x, add(y, Nat::Zero {}))
ensures
    core::Identity<Nat>(minus(x, z), minus(y, z))
{
    _ = minus_swap(x, y, z);
    transition { _ -> (minus(x, z)) }
}
data Main {}
machine Main::main(main: &mut Main) { }
