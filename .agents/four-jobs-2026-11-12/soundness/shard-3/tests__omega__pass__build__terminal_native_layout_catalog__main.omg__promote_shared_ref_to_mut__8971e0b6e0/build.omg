machine build(builder: &mut Build) {
    Build::application(builder, "terminal_native_layout_catalog");
    Build::select_provider<ExpectedSize, HostedSize>(builder, macos_arm64);
    Build::select_provider<ExpectedSize, HostedSize>(builder, linux_x86_64);
    Build::select_provider<ExpectedSize, HostedSize>(builder, linux_arm64);
    Build::select_provider<ExpectedSize, WindowsSize>(builder, windows_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
