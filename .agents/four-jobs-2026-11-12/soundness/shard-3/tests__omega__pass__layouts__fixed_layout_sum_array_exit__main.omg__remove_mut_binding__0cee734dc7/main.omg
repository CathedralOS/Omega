// A selected layout reorders a canary beside two sum cells. Each cell's
// footprint must include its tag, payload and padding, not just its active value.
use omega::language::core::layout;

public data Choice [copy] { case Empty; case Held(value: u64); }
public data Envelope [copy] { choices: [Choice; 2]; canary: u64; }

EnvelopeLayout satisfies FixedLayout<Envelope> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
        let entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 8 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 0 } };
        LayoutPlan { entries: entries, entry_count: 2, size_fixed: 40, size_is_dynamic: false, align: 8 }
    }
}

machine main() crashes Trap {
    let mut value: LayoutStorage<Envelope, EnvelopeLayout>;
    value.choices[0] = Choice::Held { value: 41u64 };
    value.choices[1] = Choice::Held { value: 101u64 };
    value.canary = 73u64;
    let first: Choice = value.choices[0];
    let second: Choice = value.choices[1];
    value.choices[1] = Choice::Empty;
    let emptied: Choice = value.choices[1];
    let retained: Choice = value.choices[0];
    let canary: u64 = value.canary;
    transition emptied {
        Choice::Empty -> inspect(first, second, retained, canary)
        Choice::Held { value } -> bad()
    }
    machine inspect(first: Choice, second: Choice, retained: Choice, canary: u64) {
        transition first {
            Choice::Held { value } -> first_held(value, second, retained, canary)
            Choice::Empty -> bad()
        }
    }
    machine first_held(first: u64, second: Choice, retained: Choice, canary: u64) {
        transition second {
            Choice::Held { value } -> second_held(first, value, retained, canary)
            Choice::Empty -> bad()
        }
    }
    machine second_held(first: u64, second: u64, retained: Choice, canary: u64) {
        transition retained {
            Choice::Held { value } -> check(first, second, value, canary)
            Choice::Empty -> bad()
        }
    }
    machine check(first: u64, second: u64, retained: u64, canary: u64) {
        transition first == 41u64 && second == 101u64 && retained == 41u64 && canary == 73u64 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
