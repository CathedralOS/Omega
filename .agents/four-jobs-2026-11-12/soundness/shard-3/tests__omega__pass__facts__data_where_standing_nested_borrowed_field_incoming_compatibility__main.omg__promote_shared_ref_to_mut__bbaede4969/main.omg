// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
public machine bounded(value: &mut i32) -> bool { value <= 60 }
public data Counter<'storage> [copy] requires bounded(self.value) == true { before: i32; value: &'storage i32; after: i32; marker: i32; }
public data Holder<'counter, 'storage> [copy] { prefix: i32; counter: &'counter Counter<'storage>; suffix: i32; }
data Backing { before: i32; value: i32; after: i32; }
machine read(value: &i32) -> i32 ensures result == value, { value }
public machine compute<'counter, 'storage>(holder: &Holder<'counter, 'storage>, destination: &mut i32) -> i32 {
    let old: &'storage i32 = holder.counter.value;
    destination = 3;
    let kept: i32 = read(old);
    70 + kept
}
machine main() crashes Trap {
    let mut left: Backing = Backing { before: 17, value: 60, after: 53 };
    let mut right: Backing = Backing { before: 19, value: -17, after: 23 };
    let counter: Counter = Counter { before: 29, value: &left.value, after: 37, marker: 41 };
    let holder: Holder = Holder { prefix: 31, counter: &counter, suffix: 47 };
    let total: i32 = compute(&holder, &mut right.value);
    transition total == 130 && left.value == 60 && right.value == 3
        && left.before == 17 && left.after == 53
        && right.before == 19 && right.after == 23
        && counter.before == 29 && counter.after == 37 && counter.marker == 41
        && holder.prefix == 31 && holder.suffix == 47 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
