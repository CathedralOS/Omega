use omega::language::core::layout;
// Expected exit: 0. Expected output contains: A.
// A foreign scalar snapshot checks the original signed
// predicate through its captured codec, not against the observed u8 carrier.


SignedByte satisfies FixedLayout<NarrowByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    LayoutPlan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}


data NarrowByte [copy] requires -128 <= value, value <= 127 { value: i64; }
data ByteView { value: u8; }
public boundary trait ByteOutput {
    machine write(descriptor: i32, value: &u8, count: u64) -> i64 reaches;
}

data Main { encoded: LayoutStorage<NarrowByte, SignedByte>; }

machine read_byte(value: &u8) -> u8 { value }
machine identity(value: &u8) -> &u8 { value }
machine write_byte(value: &u8) { value = 255u8; }

machine Main::main(main: &mut Main) reaches ByteOutput crashes Trap {
    main.encoded.value = -9i64;
    let view: &mut ByteView = &mut main.encoded as &mut ByteView;
    let before: u8 = read_byte(&view.value);
    write_byte(&mut view.value);
    let returned: &u8 = identity(&view.value);
    let after: u8 = read_byte(returned);
    view.value = 65u8;
    let written: i64 = ByteOutput::write(1, &view.value, 1);
    view.value = 10u8;
    let newline: i64 = ByteOutput::write(1, &view.value, 1);
    write_byte(&mut view.value);
    let empty: i64 = ByteOutput::write(1, &view.value, 0);
    transition written == 1 && newline == 1 && empty == 0 && before == 247u8 && after == 255u8 && main.encoded.value == -1i64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ByteOutput crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
