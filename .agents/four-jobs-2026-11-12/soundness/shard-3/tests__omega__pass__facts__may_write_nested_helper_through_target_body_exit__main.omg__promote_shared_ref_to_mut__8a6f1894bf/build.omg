machine build(builder: &mut Build) {
    Build::application(builder, "may_write_nested_helper_through_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<SelectedProbe, NestedProbe>(builder, linux_x86_64);
    Build::select_provider<SelectedProbe, NestedProbe>(builder, linux_arm64);
    Build::select_provider<SelectedProbe, NestedProbe>(builder, macos_arm64);
    Build::select_provider<SelectedProbe, NestedProbe>(builder, windows_x86_64);
}
