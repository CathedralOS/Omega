// Expected exit: 0
// Content-independent field stores retain their owning data predicates.
// Limited's two historical u8 [0..=10] fields use ordinary data requirements;
// depth's old suffix is a callable requirement. A write-only loan supplies
// no stored-value observation. Policy-only fields and the intentionally named
// Utf8 membership keep their independent operation and store obligations.

domain [u8; 8]::Utf8
requires
    valid_utf8(self);

data Limited requires value <= 10 && next <= 10 {
    value: u8;
    next: u8;
}

data Policy {
    damage: i32 in Wrapping;
    count: u32 in Wrapping;
}

data Tagged {
    label: [u8; 8] in Utf8;
}

data Outer {
    inner: Limited;
    policy: Policy;
    tagged: Tagged;
}

machine replace(limited: &mut write Limited, depth: u8) requires depth <= 10
{
    limited.value = depth;
    limited.next = 4;
}

machine rename(tagged: &write Tagged, label: [u8; 8] in Utf8)
{
    tagged.label = label;
}

machine fill(
    outer: &write Outer,
    depth: u8,
    damage: i32 in Wrapping,
    label: [u8; 8] in Utf8
) requires depth <= 10
{
    outer.inner.value = depth;
    outer.policy.damage = damage;
    outer.policy.count = 4;
    outer.tagged.label = label;
}

machine forward(limited: &write Limited, depth: u8) requires depth <= 10
{
    replace(&write limited, depth);
}

machine main() crashes Trap
{
    let mut limited: Limited = Limited { value: 1, next: 2 };
    forward(&write limited, 7);
    transition limited.value == 7 && limited.next == 4 {
        true -> again(&mut limited)
        false -> bad()
    }
    machine again(limited: &mut Limited) crashes Trap {
        replace(&write limited, 3);
        transition limited.value == 3 && limited.next == 4 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
