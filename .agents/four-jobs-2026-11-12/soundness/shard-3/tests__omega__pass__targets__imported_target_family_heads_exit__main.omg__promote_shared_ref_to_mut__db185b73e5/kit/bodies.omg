use carrier;

// There is no authored portable head and no module declaration anywhere in
// this package. Every body calls its own private target sibling.
linux_x86_64 machine Carrier::private_value(carrier: &Carrier) -> u64 { 101 }
windows_x86_64 machine Carrier::private_value(carrier: &Carrier) -> u64 { 202 }
macos_arm64 machine Carrier::private_value(carrier: &Carrier) -> u64 { 303 }
linux_arm64 machine Carrier::private_value(carrier: &Carrier) -> u64 { 404 }

public linux_x86_64 machine Carrier::value(carrier: &Carrier) -> u64 { Carrier::private_value(carrier) }
public windows_x86_64 machine Carrier::value(carrier: &Carrier) -> u64 { Carrier::private_value(carrier) }
public macos_arm64 machine Carrier::value(carrier: &Carrier) -> u64 { Carrier::private_value(carrier) }
public linux_arm64 machine Carrier::value(carrier: &Carrier) -> u64 { Carrier::private_value(carrier) }
