// Expected exit: 0.
data Main {}
machine read(buffer: &[u8; 16], offset: u64 in Trapping) -> u64
{
    transition { _ -> inspect(buffer, offset) }
    machine inspect(buffer: &[u8; 16], offset: u64 in Trapping) -> u64
    {
        let word: &u64 = &buffer[offset] as &u64;
        word
    }
}
machine Main::main(context: &mut Main) crashes Trap
{
    let bytes: [u8; 16] = [0, 0, 0, 0, 0, 0, 0, 0, 42, 0, 0, 0, 0, 0, 0, 0];
    let word: u64 = read(&bytes, 8);
    transition word == 42 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
