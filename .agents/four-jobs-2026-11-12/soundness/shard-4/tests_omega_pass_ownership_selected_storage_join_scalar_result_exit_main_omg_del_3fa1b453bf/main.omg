// Expected exit: 0
use borrowed_partition_support::main;
use omega::language::core::drop;
machine carve_count(strategy: &mut Strategy, available: u64, requested: u64) -> u64
requires strategy.tail.length == available && requested <= available
ensures strategy.tail.length == available - requested, strategy.remaining == available - requested, result == requested
{
    let taken: Region in Owned = carve(strategy, available, requested);
    let length: u64 = taken.length;
    drop(taken);
    length
}
machine consume(strategy: Strategy, first: u64) -> bool
requires first == 16 && strategy.tail.length == 32 && strategy.remaining == 32
{
    let correct: bool = first == 16 && strategy.tail.length == 32 && strategy.remaining == 32;
    drop(strategy.tail);
    correct
}
machine exercise(select: bool) -> bool {
    let mut strategy: Strategy = Strategy { tail: issue(), remaining: 48 };
    let first: u64 = match select {
        true -> carve_count(&mut strategy, 48, 16),
        false -> carve_count(&mut strategy, 48, 16),
    };
    consume(strategy, first)
}
machine main() crashes Trap {
    let correct: bool = exercise(true) && exercise(false);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
