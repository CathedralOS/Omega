// Expected exit: 0
// A u16 value is a member of the u16 domain Small (self <= 10) only on its own u16 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

machine main() crashes Trap {
    transition {
        true -> done()
        _ -> bad()
    }
    machine headroom(value: u16) -> u16 requires value in Small {
        10 - value
    }
    machine done() {}
    machine bad() { crash Trap; }
}
