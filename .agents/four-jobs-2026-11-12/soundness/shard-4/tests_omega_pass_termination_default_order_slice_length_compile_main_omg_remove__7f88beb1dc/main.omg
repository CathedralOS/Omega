data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine main(main: &mut Main) -> u64 {
    let view: &[Entry] = &main.entries[..];

    transition {
        _ -> walk(main, view)
    }
}

machine walk(main: &Main, entries: &[Entry]) -> u64
terminates by entries
{
    transition {
        true -> walk(main, entries[1..])
        false -> 0
    }
}
