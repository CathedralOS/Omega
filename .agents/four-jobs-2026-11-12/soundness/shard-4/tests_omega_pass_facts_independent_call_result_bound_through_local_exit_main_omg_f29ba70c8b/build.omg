machine build(builder: &mut Build) {
    Build::application(builder, "independent_call_result_bound");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<IndependentSource, WindowsSource>(builder, windows_x86_64);
    Build::select_provider<IndependentSource, LinuxSource>(builder, linux_x86_64);
    Build::select_provider<IndependentSource, MacosSource>(builder, macos_arm64);
    Build::select_provider<IndependentSource, LinuxArmSource>(builder, linux_arm64);
}
