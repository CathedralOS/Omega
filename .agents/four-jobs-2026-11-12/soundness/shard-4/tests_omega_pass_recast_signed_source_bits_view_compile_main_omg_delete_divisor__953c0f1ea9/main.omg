// The signed→unsigned direction views the same bits too: `&word as &u64`
// on an i64 holding -1 observes 18446744073709551615 — every bit set,
// reinterpreted as the unsigned maximum.
data Main {
    word: i64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.word = 0 - 1;
    transition (&main.word as &u64) == 18446744073709551615 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
