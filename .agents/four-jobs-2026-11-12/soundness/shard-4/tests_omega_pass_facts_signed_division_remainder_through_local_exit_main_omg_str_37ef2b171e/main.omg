// Fact: computing the signed remainder (%) of a non-negative bounded i64 dividend by a positive bounded i64 divisor (divisor == 4i64) establishes the remainder bound (0 <= rem < 4) to safely index a 4-element array across all nine places.
// Place: local. The dividend and divisor are held in local variables before computing remainder and indexing.
// Expected exit: 0

machine compute_local(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 4i64
{
    let local_dividend: i64 = dividend;
    let local_divisor: i64 = divisor;
    let rem: i64 = local_dividend % local_divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

machine probe() -> u8 {
    compute_local(14i64, 4i64)
}

machine main() crashes Trap {
    transition probe() == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
