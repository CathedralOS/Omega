// Expected exit: 0
// A callee can return fewer cases than its result type permits. Unused case
// slots stay inactive and do not own additional values.
use omega::language::core::drop;
data Token [linear] dropped by drop_token { value: u64; }
machine drop_token(token: &mut Token) {}
data Choice { case Left(token: Token); case Right(token: Token); case Unused(token: Token); }
machine retire(token: Token) -> u64 {
    let value: u64 = token.value;
    drop(token);
    value
}
machine right(token: Token) -> u64 {
    let value: u64 = retire(token);
    value ^ 100
}
machine unused(token: Token) -> u64 {
    let value: u64 = retire(token);
    value ^ 200
}
machine choose(left: bool) -> Choice {
    transition {
        true -> Choice::Left { token: Token { value: 41 } }
        false -> Choice::Left { token: Token { value: 73 } }
    }
}
data Driver {}
machine Driver::run(left: bool, spare: bool) -> Choice {
    transition spare {
        true -> Choice::Unused { token: whole(Token { value: 109 }) }
        false -> dispatch(left)
    }
    machine dispatch(left: bool) -> Choice {
        transition left { true -> selected(true) false -> selected(false) }
    }
    machine selected(left: bool) -> Choice { choose(left) }
}
machine whole(token: Token) -> Token { token }
machine consume(value: Choice) -> u64 {
    transition value {
        Choice::Left { token } -> retire(token)
        Choice::Right { token } -> right(token)
        Choice::Unused { token } -> unused(token)
    }
}
machine inspect(left: bool) -> u64 {
    let value: Choice = Driver::run(left, false);
    let selected: u64 = consume(value);
    selected
}
machine main() crashes Trap {
    let left: u64 = inspect(true);
    let right: u64 = inspect(false);
    let alternate: u64 = consume(Choice::Right { token: Token { value: 73 } });
    let spare: u64 = consume(Driver::run(true, true));
    transition left == 41 && right == 73 && alternate == 45 && spare == 165 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
