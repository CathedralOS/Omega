// A named map binds a portable family, not one lexical target body. Both
// explicit maps must retain their exact family through requirement calls.
data Item { code: u64; }
trait Reader<Value> {
    machine read(value: &Value) -> bool;
}

First satisfies Reader<Item> { machine read(value: &Item) -> bool { first(value) } }
Second satisfies Reader<Item> { machine read(value: &Item) -> bool { second(value) } }

linux_x86_64 machine first(value: &Item) -> bool { true }
windows_x86_64 machine first(value: &Item) -> bool { true }
linux_arm64 machine first(value: &Item) -> bool { true }
macos_arm64 machine first(value: &Item) -> bool { true }
linux_x86_64 machine second(value: &Item) -> bool { false }
windows_x86_64 machine second(value: &Item) -> bool { false }
linux_arm64 machine second(value: &Item) -> bool { false }
macos_arm64 machine second(value: &Item) -> bool { false }

machine main() crashes Trap {
    let item: Item = Item { code: 17 };
    let first: bool = First::read(&item);
    let second: bool = Second::read(&item);
    transition (first, second) {
        (true, false) -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
