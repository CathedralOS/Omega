// Layout queries fold a sum of record cases: `Choice`'s widest payload
// is `Pair` (two u64s, 16 bytes) plus the discriminant — the sum's
// extent covers the largest case's geometry.
data Pair {
    a: u64;
    b: u64;
}

data Choice {
    case Empty;
    case Single(v: u64);
    case Both(pair: Pair);
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Choice>();
}
