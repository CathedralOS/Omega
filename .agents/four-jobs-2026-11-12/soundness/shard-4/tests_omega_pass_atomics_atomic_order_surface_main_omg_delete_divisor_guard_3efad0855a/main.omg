// The normalized atomic operations carry their memory ordering as
// checked source data on every call: GlobalOrder on load, store,
// fetch, swap, and compare-exchange success; ReceivePublish on
// read-modify-write; Receive on a read-only failure ordering.
// Width-generic: AtomicU64 admits the same family; AtomicBool admits
// only the non-arithmetic load/store pair.
data Main {
    counter: AtomicU32;
    wide: AtomicU64;
    flag: AtomicBool;
}
machine Main::main(main: &mut Main) {
    main.counter.store(10, GlobalOrder);
    let observed_atomic_observed: u32 = main.counter.load(GlobalOrder);
    let observed: u32 in Wrapping = observed_atomic_observed as u32 in Wrapping;
    let prior: u32 in Wrapping = main.counter.fetch_add(5, ReceivePublish);
    let displaced: u32 in Wrapping = main.counter.swap(20, GlobalOrder);
    let cas_prior: u32 in Wrapping = main.counter.compare_exchange(20, 30, GlobalOrder, Receive);
    main.wide.store(7, GlobalOrder);
    let wide_observed_atomic_observed: u64 = main.wide.load(GlobalOrder);
    let wide_observed: u64 in Wrapping = wide_observed_atomic_observed as u64 in Wrapping;
    let wide_prior: u64 in Wrapping = main.wide.fetch_sub(3, ReceivePublish);
    main.flag.store(true, Publish);
    let flag_seen: bool = main.flag.load(Receive);
    main.counter.store(77, Publish);
    let received_atomic_observed: u32 = main.counter.load(Receive);
    let received: u32 in Wrapping = received_atomic_observed as u32 in Wrapping;
    let cas_relaxed: u32 in Wrapping = main.counter.compare_exchange(1, 2, NoOrdering, NoOrdering);
}
