// Expected exit: 0
// Repeated data requirements share one exact subject and remain ordered.
machine guarded(value: u64) -> bool requires value != 0 { true }
data Bounded<const Limit: u64> [copy]
requires self.value >= 1
requires value <= Limit
requires guarded(self.value)
requires requires == 0
{
    value: u64;
    requires: u64;
}

machine main() crashes Trap {
    let first: Bounded<10> = Bounded { value: 1, requires: 0 };
    let second: Bounded<10> = Bounded { value: 10, requires: 0 };
    transition first.value == 1 && second.value == 10 && first.requires == 0 && second.requires == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
