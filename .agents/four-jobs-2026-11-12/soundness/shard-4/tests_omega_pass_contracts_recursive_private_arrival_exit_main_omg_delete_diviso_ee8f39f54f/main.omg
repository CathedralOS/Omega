// Repeated subtraction produces valid decimal digits and suppresses leading zeros.
// Expected exit: 0
machine decimal(rest: u64 in Trapping, count: u64 in Trapping, printed: u64) -> u64
requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
{
    transition rest >= 10 {
        true -> decimal(rest - 10, count + 1, printed)
        _ -> emit(rest, count, printed)
    }
    machine emit(rest: u64 in Trapping, count: u64 in Trapping, printed: u64) -> u64 {
        transition count == 0 && printed == 0 {
            true -> ones(48 + rest)
            _ -> digit(rest, 48 + count)
        }
    }
    machine digit(rest: u64 in Trapping, value: u64 in Trapping) -> u64
    requires 48 <= value && value <= 57
    {
        let byte: u8 = value as u8;
        let tail: u64 = ones(48 + rest);
        ((byte as u64 in Wrapping) * 100 + (tail as u64 in Wrapping)) as u64
    }
    machine ones(value: u64 in Trapping) -> u64
    requires 48 <= value && value <= 57
    { value as u64 }
}
machine main() crashes Trap {
    let repeated: u64 = decimal(37, 0, 0);
    let skipped: u64 = decimal(7, 0, 0);
    let zero: u64 = decimal(0, 0, 0);
    let boundary: u64 = decimal(10, 0, 0);
    let largest: u64 = decimal(99, 0, 0);
    transition repeated == 5155 && skipped == 55 && zero == 48
        && boundary == 4948 && largest == 5757 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
