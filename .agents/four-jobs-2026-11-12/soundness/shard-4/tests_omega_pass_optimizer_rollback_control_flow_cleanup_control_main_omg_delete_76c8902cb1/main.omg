// `ControlFlowCleanup` folds a constant conditional branch and removes the
// region its untaken edge strands. `decided` binds a literal `true`, so
// the branch always jumps `taken` and `untaken` is unreachable. This
// control build selects no rule, so its semantic module is the one the
// selected fixture's rolled-back module must rejoin byte-for-byte; the
// check leg records the pair's fingerprints side by side so the golden
// pins that equality.

machine main() {
    let decided: bool = true;

    transition decided {
        true -> taken()
        _ -> untaken()
    }

    machine taken() { }
    machine untaken() { }
}
