use omega::language::core::float_operations;
use physics::model;

// The complete private scattering module reproduces the application's exact
// nested float boundary occurrences without the formatter's state contracts.
machine main() crashes Trap {
    let line: LineModel = preset(2);
    let mut tree: ReflectionTree;
    let updated: bool = propagate(&mut tree, &line, 0);
    transition updated && tree.record.source_out == 1.0 && tree.supplied == 0.02 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
