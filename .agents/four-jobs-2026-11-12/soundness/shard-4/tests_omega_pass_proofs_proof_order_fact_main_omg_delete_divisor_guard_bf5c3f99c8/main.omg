// "Machines as proofs": a machine used only to establish a fact emits
// no runtime code. `distinct_indices` proves `i != j` follows from the
// precondition `i < j` via built-in order rules — the empty body is
// valid because the guarantee is discharged from the requirement.
machine distinct_indices(i: u64, j: u64)
requires
    i < j
ensures
    i != j
{
}
machine caller(i: u64)
requires
    i < 10
{
    let smaller: u64 = i;
    let larger: u64 = i + 1;
    distinct_indices(smaller, larger);
}

data Main {}
machine Main::main(main: &mut Main) { }
