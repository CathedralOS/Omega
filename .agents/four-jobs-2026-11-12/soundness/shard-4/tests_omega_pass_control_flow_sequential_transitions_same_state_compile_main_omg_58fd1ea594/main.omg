// A state body may run more than one `transition` in sequence: the first
// dispatch selects a nested decision point, and the arm it reaches carries
// its own `transition`. Control flow between the two is ordinary statement
// order — the second subject reads a field the first arm stored.
data Main {
    flag: u64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.flag = 1;
    transition main.flag {
        0 -> zero(main)
        _ -> further(main)
    }

    machine zero(main: &mut Main) { main.answer = 70; }

    machine further(main: &mut Main) {
        main.flag = 2;
        transition main.flag {
            2 -> two(main)
            _ -> zero(main)
        }
    }

    machine two(main: &mut Main) { main.answer = 71; }
}
