// Expected exit: 0. Arithmetic endpoints retain the original captured values.
use omega::language::core::content;
use omega::language::core::drop;
use omega::language::core::nat;
data Region [linear] dropped by drop_region { base: u64; length: u64; }
machine drop_region(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet {
        start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat
    }
}
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, length: u64) -> Pieces
ensures core::Identity<IntervalSet<Nat>>(
    Owned::content(old(&whole)),
    separate(
        Owned::content(&result.right), Owned::content(&result.left))
)
{
    let left: Region in Owned = Region { base: whole.base, length: length };
    let right: Region in Owned = Region { base: whole.base + length, length: whole.length - length };
    drop(whole);
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let whole: Region in Owned = Region { base: 10, length: 80 };
    let pieces: Pieces = split(whole, 20);
    let correct: bool = pieces.left.base == 10 && pieces.left.length == 20
        && pieces.right.base == 30 && pieces.right.length == 60;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
