// Fact: a 3-level nested structural record Outer { mid: Middle { inner: Inner { val: u64 } } } preserves the leaf field bound 40u64 <= outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: match join. Both match arms yield a 3-level nested record and join before leaf projection and interval discharge.
// Expected exit: 0

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

machine choose_outer(first: Outer, second: Outer, flag: bool) -> Outer
requires first.mid.inner.val >= 40 && first.mid.inner.val <= 80
    && second.mid.inner.val >= 40 && second.mid.inner.val <= 80
ensures result.mid.inner.val >= 40 && result.mid.inner.val <= 80
{
    match flag {
        true -> first
        false -> second
    }
}

machine probe(first: Outer, second: Outer, flag: bool) -> u64
requires first.mid.inner.val >= 40 && first.mid.inner.val <= 80
    && second.mid.inner.val >= 40 && second.mid.inner.val <= 80
{
    let outer: Outer = choose_outer(first, second, flag);
    let res: u64 = outer.mid.inner.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine main() crashes Trap {
    let o1: Outer = Outer { mid: Middle { inner: Inner { val: 60u64 } } };
    let o2: Outer = Outer { mid: Middle { inner: Inner { val: 50u64 } } };
    transition probe(o1, o2, true) == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
