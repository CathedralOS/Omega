// R5 state-arrival contract: the transition guard proves the target state's
// explicit `requires`, which is then available as an assumption in its body.
data Main {
    value: i32;
}

machine Main::main(main: &mut Main) {
    transition {
        true -> positive(main.value)
        false -> done()
    }

    machine positive(value: i32)
    requires
        value > 0
    {
        consume(value);
    }

    machine done() { }
}

machine consume(value: i32)
requires
    value > 0
{
}
