// Expected exit: 0.
// A non-observing single attempt returns the proposed u32 on failure and the displaced u32 on commit.
use omega::language::core::layout;
const EXPECTED_MATCH: u32 = 10;
const EXPECTED_MISMATCH: u32 = 9;
const REPLACEMENT: u32 = 99;
const SIBLING_INIT: u32 = 17;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine probe(cells: &Cells) -> bool {
    cells.selected.store(EXPECTED_MATCH, NoOrdering);
    cells.untouched.store(SIBLING_INIT, NoOrdering);
    let outcome: AtomicTryExchangeOnceOutcome<u32> = cells.selected.try_exchange_once(EXPECTED_MATCH, REPLACEMENT, ReceivePublish, Receive);
    transition {
        AtomicTryExchangeOnceOutcome::Exchanged { displaced } -> (displaced == EXPECTED_MATCH && cells.selected.load(NoOrdering) == REPLACEMENT && cells.untouched.load(NoOrdering) == SIBLING_INIT)
        AtomicTryExchangeOnceOutcome::Mismatched { proposed } -> (false)
        AtomicTryExchangeOnceOutcome::Uncommitted { proposed } -> (proposed == REPLACEMENT && cells.selected.load(NoOrdering) == EXPECTED_MATCH && cells.untouched.load(NoOrdering) == SIBLING_INIT)
    }
}
machine mismatch(cells: &Cells) -> bool {
    cells.selected.store(EXPECTED_MATCH, NoOrdering);
    cells.untouched.store(SIBLING_INIT, NoOrdering);
    let outcome: AtomicTryExchangeOnceOutcome<u32> = cells.selected.try_exchange_once(EXPECTED_MISMATCH, REPLACEMENT, ReceivePublish, Receive);
    transition outcome {
        AtomicTryExchangeOnceOutcome::Mismatched { proposed } -> (proposed == REPLACEMENT && cells.selected.load(NoOrdering) == EXPECTED_MATCH && cells.untouched.load(NoOrdering) == SIBLING_INIT)
        AtomicTryExchangeOnceOutcome::Exchanged { displaced } -> (false)
        AtomicTryExchangeOnceOutcome::Uncommitted { proposed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) && mismatch(&cells) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
