// Fact: projecting a nested inner record field through a shared borrow preserves its exact static upper bound without moving either record, discharging exact subtraction 72u64 - quota across all nine places.
// Place: target_body. Each hosted target body computes the nested shared borrow field projection and exact subtraction.
// Expected exit: 0
data Inner requires quota <= 72, {
    quota: u64;
    tag: u64;
}

data Outer {
    inner: Inner;
    header: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEvaluate {
    machine evaluate() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Evaluate satisfies SelectedEvaluate {
    machine evaluate() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let outer: Outer = Outer {
            inner: Inner { quota: 30, tag: 7 },
            header: 10,
        };
        let view: &Outer = &outer;
        let quota: u64 = view.inner.quota;
        let diff: u64 = 72u64 - quota;
        diff
    }
}

ArmEvaluate satisfies SelectedEvaluate {
    machine evaluate() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let outer: Outer = Outer {
            inner: Inner { quota: 30, tag: 7 },
            header: 10,
        };
        let view: &Outer = &outer;
        let quota: u64 = view.inner.quota;
        let diff: u64 = 72u64 - quota;
        diff
    }
}

machine main() crashes Trap {
    let diff: u64 = SelectedEvaluate::evaluate();
    transition diff == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
