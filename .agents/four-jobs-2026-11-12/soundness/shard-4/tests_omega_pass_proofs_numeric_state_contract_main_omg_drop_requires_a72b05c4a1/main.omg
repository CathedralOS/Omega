machine digit(value: u64 in Trapping)
{ }

data Counter { value: u64 in Trapping; }

machine stored_digit(counter: &Counter)
{
    digit(48 + counter.value);
}

machine captured_digit(count: u64 in Trapping)
{
    let code: u64 in Trapping = count + 48;
    digit(code);
}

machine upper(value: i64) requires value <= 9 { }
machine lower(value: i64) requires value >= -9 { }

machine rounded_upper(value: i64)
{ upper(value); }

machine rounded_lower(value: i64)
{ lower(value); }

machine swap(first: u64 in Trapping, second: u64 in Trapping)
{
    transition { _ -> swapped(second, first) }
    machine swapped(first: u64 in Trapping, second: u64 in Trapping)
    { }
}

machine decimal(value: u64 in Trapping) {
    transition value <= 99 {
        true -> loop(value, 0)
        _ -> done()
    }
    machine loop(rest: u64 in Trapping, count: u64 in Trapping)
    {
        transition rest >= 10 {
            true -> loop(rest - 10, count + 1)
            _ -> emit(rest, count)
        }
    }
    machine emit(rest: u64 in Trapping, count: u64 in Trapping)
    {
        let first: u64 in Trapping = 48 + count;
        digit(first);
        digit(48 + rest);
        transition { _ -> done() }
    }
    machine done() { }
}
