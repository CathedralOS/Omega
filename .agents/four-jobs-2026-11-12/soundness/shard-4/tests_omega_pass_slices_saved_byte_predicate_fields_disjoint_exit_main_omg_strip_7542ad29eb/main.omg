// A saved byte predicate certifies the same bytes after a disjoint write, but not after an overlapping write.
// Expected exit: 0
// Place: local.
machine inspect(bytes: &[u8]) -> u8
requires ascii_only(bytes) && bytes.len >= 1
{ bytes[0] }
data Pair { bytes: [u8; 1]; other: [u8; 1]; }
machine probe() -> u8 {
    let mut pair: Pair = Pair { bytes: [65u8], other: [65u8] };
    let view: &mut [u8] = &mut pair.bytes[0..1];
    let saved: bool = ascii_only(view);
    pair.other[0] = 255u8;
    transition saved { true -> inspect(view) false -> 0u8 }
}
machine main() crashes Trap {
    transition probe() == 65u8 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
