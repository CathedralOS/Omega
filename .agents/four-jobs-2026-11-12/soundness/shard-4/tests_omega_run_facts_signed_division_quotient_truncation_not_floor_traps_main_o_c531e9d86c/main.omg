// RUN CANARY: signed division truncates toward zero, it does not floor.
// -7i64 / 2i64 is -3i64 (truncation), not -4i64 (floor). This program asserts
// the FLOOR result by requiring q + 4 == 0. Because the compiler must produce
// truncation, that assertion is false and the program takes its Trap route:
// expected_native_exit.txt requires the exact target trap, not merely a
// nonzero exit. A compiler that floors negative quotients would instead exit 0
// here, which is precisely the regression this canary detects. The sibling
// positive row (signed_division_quotient_through_*_exit) uses an exactly
// divisible positive quotient (+100), which is identical under both roundings
// and therefore cannot discriminate; this canary exists for that reason.
//
// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Expected exit: 0

machine floor_claim() -> i32 {
    let quotient: i64 = (-7i64) / (2i64);
    let asserted_floor: i64 = quotient + 4i64;
    asserted_floor as i32
}

machine main() crashes Trap {
    transition floor_claim() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
