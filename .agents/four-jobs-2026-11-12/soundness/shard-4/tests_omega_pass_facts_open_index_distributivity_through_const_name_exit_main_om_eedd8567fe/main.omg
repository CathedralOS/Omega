// A selected open index operation records the distributivity law its trait declares, so a
// generic body takes a value indexed `A * (B + C)` as `A * B + A * C`, and the call records
// that identity.
// Place: const_name.
// Expected exit: 0
domain<T, const I: u64> T::Indexed<I>;

trait IndexSemiring {
    machine + add(a: u64, b: u64) -> u64 terminates;
    machine * multiply(a: u64, b: u64) -> u64 terminates;
    machine distribute(a: u64, b: u64, c: u64)
    ensures multiply(a, add(b, c)) == add(multiply(a, b), multiply(a, c));
}

// Both selected operations are constant three: normalization consumes the laws the
// conformance proves, not integer arithmetic.
machine plus_index(a: u64, b: u64) -> u64
satisfies IndexSemiring::add as Canonical
ensures result == 3
{
    transition { _ -> 3 }
}

machine times_index(a: u64, b: u64) -> u64
satisfies IndexSemiring::multiply as Canonical
ensures result == 3
{
    transition { _ -> 3 }
}

machine times_index_distribute(a: u64, b: u64, c: u64)
satisfies IndexSemiring::distribute as Canonical
requires times_index(a, plus_index(b, c)) == plus_index(times_index(a, b), times_index(a, c))
ensures times_index(a, plus_index(b, c)) == plus_index(times_index(a, b), times_index(a, c))
{
}

Canonical satisfies IndexSemiring
{
    machine add(a: u64, b: u64) -> u64
    terminates {
        plus_index(a, b)
    }
    machine multiply(a: u64, b: u64) -> u64
    terminates {
        times_index(a, b)
    }
    machine distribute(a: u64, b: u64, c: u64)
    ensures times_index(a, plus_index(b, c)) == plus_index(times_index(a, b), times_index(a, c)) {
        times_index_distribute(a, b, c);
    }
}

// The body needs `Indexed<A * (B + C)>` to be `Indexed<A * B + A * C>` for every
// conformance of the trait, so only the declared law can establish it.
machine rearrange<const A: u64, const B: u64, const C: u64, Algebra satisfies IndexSemiring>(
    raw: i64
) -> i64 {
    let source: i64 in Indexed<A * (B + C)> = raw as i64 in Indexed<A * (B + C)>;
    let moved: i64 in Indexed<A * B + A * C> = source;
    moved as i64
}

const FACTOR: u64 = 2;
const LEFT: u64 = 3;
const RIGHT: u64 = 4;

machine main() crashes Trap {
    let moved: i64 = rearrange<FACTOR, LEFT, RIGHT, Canonical>(41);
    transition moved == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
