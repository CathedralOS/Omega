machine build(builder: &mut Build) {
    Build::application(builder, "closed_boundary_layout");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
    Build::select_provider<ReadValue, DefaultRead>(builder, macos_arm64);
    Build::select_provider<ReadValue, DefaultRead>(builder, windows_x86_64);
    Build::select_provider<ReadValue, DefaultRead>(builder, linux_x86_64);
    Build::select_provider<ReadValue, DefaultRead>(builder, linux_arm64);
    Build::select_provider<ReadValue, DefaultRead>(builder, macos_x86_64);
}
