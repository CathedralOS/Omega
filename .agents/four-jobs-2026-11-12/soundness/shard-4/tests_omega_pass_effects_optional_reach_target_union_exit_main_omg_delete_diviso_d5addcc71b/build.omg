machine build(builder: &mut Build) {
    Build::application(builder, "reach_target_union");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Mark, MarkerMark>(builder, macos_arm64);
    Build::select_provider<Mark, MarkerMark>(builder, windows_x86_64);
    Build::select_provider<Mark, MarkerMark>(builder, linux_x86_64);
    Build::select_provider<Mark, MarkerMark>(builder, linux_arm64);
    Build::select_provider<Forbidden, ForbiddenMark>(builder, macos_arm64);
    Build::select_provider<Forbidden, ForbiddenMark>(builder, windows_x86_64);
    Build::select_provider<Forbidden, ForbiddenMark>(builder, linux_x86_64);
    Build::select_provider<Forbidden, ForbiddenMark>(builder, linux_arm64);
}
