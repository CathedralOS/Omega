// Expected exit: 0
// A mutable slice local reads through the view it currently holds. Before the
// rebind `s` views `a` ([1, 2]); after `s = replacement` it views `b`
// ([7, 8, 9]), so index 1 reads 8 and the length is 3. A lowering that kept
// the first view would read 2 and length 2, and the program would trap.
machine observe_view(selected: &[u64], replacement: &[u64]) -> bool
requires selected.len > 0 && replacement.len > 1 {
    let mut s: &[u64] = selected;
    let first: u64 = s[0];
    s = replacement;
    let second: u64 = s[1];
    let length: u64 = s.len;
    first == 1 && second == 8 && length == 3
}

machine main() crashes Trap {
    let a: [u64; 2] = [1, 2];
    let b: [u64; 3] = [7, 8, 9];
    let r: bool = observe_view(&a[..], &b[..]);
    transition r {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
