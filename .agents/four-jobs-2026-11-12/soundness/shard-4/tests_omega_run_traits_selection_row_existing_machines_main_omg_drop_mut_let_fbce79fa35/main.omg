// Expected exit: 0.
// An implementation is a record of selected operations. `WireCodec` fills both
// `Codec` slots with machines that already exist, so no forwarding member is
// declared: calls through the implementation and through a static evidence
// binder run `encode_message` and `decode_message` themselves. The fail twin
// `fail/traits/selection_row_contract_not_refined` differs only in the machine
// its `decode` row selects.
data Message { value: u64; }
trait Codec<T> {
    machine encode(value: &T) -> u64 terminates;
    machine decode(input: u64, out: &mut T) terminates;
}
machine encode_message(value: &Message) -> u64 terminates { value.value }
machine decode_message(input: u64, out: &mut Message) terminates { out.value = input; }
machine decode_nonzero(input: u64, out: &mut Message) terminates
requires input > 0
{
    out.value = input;
}
WireCodec satisfies Codec<Message> {
    Codec::encode = encode_message;
    Codec::decode = decode_message;
}
machine save<T, Format satisfies Codec<T>>(value: &T) -> u64 { Format::encode(value) }
machine main() crashes Trap {
    let message: Message = Message { value: 0 };
    WireCodec::decode(8, &mut message);
    let observed: u64 = save<Message, WireCodec>(&message);
    transition observed == 8 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
