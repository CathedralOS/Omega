// Anonymous division preserves fractions until the actual typed destination;
// a whole-expression `as` acknowledges the fractional intermediate.
machine exact_return() -> i32
ensures result == 7
{
    (7 / 2 * 2) as i32
}

machine exact_local() -> u32
ensures result == 4097
{
    let value: u32 = ((4097 / 4096) * 4096) as u32;
    value
}

machine typed_quotient() -> i32
ensures result == 6
{
    7i32 / 2 * 2
}

machine mixed_operand(input: i32) -> i32
{
    input * ((4097 / 2 * 2) as i32)
}
