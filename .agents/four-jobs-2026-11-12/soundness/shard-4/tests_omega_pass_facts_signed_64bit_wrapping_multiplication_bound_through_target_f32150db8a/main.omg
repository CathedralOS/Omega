// Fact: 64-bit signed wrapping multiplication lhs *% rhs with bounded interval 50i64 <= prod <= 200i64 establishes 50i64 <= prod <= 200i64 across all nine places so exact subtractions 200i64 - prod and prod - 50i64 are safe.
// Place: another target body. Each of four target-scoped machine bodies multiplies bounded 64-bit operands with wrapping and discharges interval.
// Expected exit: 0

machine verify_prod(value: i64) -> i64 requires value >= 50i64 && value <= 200i64 {
    let headroom: i64 = 200i64 - value;
    let margin: i64 = value - 50i64;
    headroom + margin
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSatTarget {
    machine sat_target(lhs: i64, rhs: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10;
}

X86SatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: i64, rhs: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: i64 in Wrapping = lhs as i64 in Wrapping;
        let b: i64 in Wrapping = rhs as i64 in Wrapping;
        let wrap_prod: i64 in Wrapping = a * b;
        let prod: i64 = wrap_prod as i64;
        verify_prod(prod)
    }
}

ArmSatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: i64, rhs: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: i64 in Wrapping = lhs as i64 in Wrapping;
        let b: i64 in Wrapping = rhs as i64 in Wrapping;
        let wrap_prod: i64 in Wrapping = a * b;
        let prod: i64 = wrap_prod as i64;
        verify_prod(prod)
    }
}

machine probe() -> i64 {
    SelectedSatTarget::sat_target(15i64, 8i64)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
