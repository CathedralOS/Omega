// A `&` view may name a plain local: `read(&count)` lends read access to
// a local slot — loans don't require a member path, only a named place.
data Main { answer: u64; }

machine Main::read(value: &u64) -> u64 {
    value
}

machine Main::main(main: &mut Main) {
    let count: u64 = 6;
    let seen: u64 = Main::read(&count);
    transition seen {
        6 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
