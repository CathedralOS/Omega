// Disjoint `&mut` field loans coexist: `&mut main.x` and `&mut main.y`
// borrow different members of the same record at once — each view writes
// only its own slot, and the record stays whole around them.
data Main {
    x: u64;
    y: u64;
}

machine Main::main(main: &mut Main) {
    main.x = 1;
    main.y = 2;
    let left: &mut u64 = &mut main.x;
    let right: &mut u64 = &mut main.y;
    left = 10;
    right = 20;
}
