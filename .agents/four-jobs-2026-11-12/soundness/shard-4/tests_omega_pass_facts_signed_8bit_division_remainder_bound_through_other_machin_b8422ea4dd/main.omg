// Fact: an 8-bit signed i8 remainder operation (dividend % divisor where dividend >= 0i8 && dividend <= 100i8, divisor >= 16i8 && divisor <= 16i8) establishes rem >= 0i8 && rem <= 15i8 so exact 8-bit signed subtraction 15i8 - rem is proved overflow-free across all nine places.
// Place: other_machine. A forwarding machine transports the remainder result through an intermediate machine call.
// Expected exit: 0
machine verify_rem(rem: i8) -> i32
    requires rem >= 0 && rem <= 15
{
    let headroom: i8 = 15 - rem;
    (headroom - 4) as i32
}

machine target_machine(val: i8) -> i8
    ensures result == val
{
    val
}

machine forwarder(val: i8) -> i8
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(dividend: i8, divisor: i8) -> i32
    requires dividend >= 0 && dividend <= 100 && divisor >= 16 && divisor <= 16
{
    let rem: i8 = forwarder(dividend % divisor);
    verify_rem(rem)
}

machine evaluate() -> i32 {
    compute_other_machine(43, 16)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
