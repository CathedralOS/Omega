// A qualified scalar element view preserves its declared disjunction without gaining a stronger one.
// Expected exit: 0

domain i32::Declared requires self < 1 || self < 2;
domain i32::Observed requires self < 2 || self < 1;

machine observe(value: i32 in Observed) -> i32 { value }

machine main() crashes Trap {
    let mut items: [i32 in Declared; 1];
    items[0] = 1;
    let view: &[i32 in Declared] = &items[..];
    let result: i32 = observe(view[0]);
    transition result == 1 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
