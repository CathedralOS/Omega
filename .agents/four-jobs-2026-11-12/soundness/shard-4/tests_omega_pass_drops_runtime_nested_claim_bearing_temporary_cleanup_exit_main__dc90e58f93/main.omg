data Receipt [linear] dropped by drop_receipt { code: u64; }

machine drop_receipt(receipt: &Receipt) {
    receipt.code = 0;
}

data Pair { first: Receipt; second: Receipt; }
data Stamp dropped by drop_stamp { marked: bool; }

machine drop_stamp(stamp: &mut Stamp) requires stamp.marked {
    stamp.marked = false;
}

data Envelope { pair: Pair; stamp: Stamp; }
data Package { contents: Envelope; }

machine inspect(package: &Package) -> bool {
    package.contents.pair.first.code == 7
        && package.contents.pair.second.code == 13
        && package.contents.stamp.marked
}

machine selected(enabled: bool) -> bool {
    enabled && inspect(Package {
        contents: Envelope {
            pair: Pair {
                first: Receipt { code: 7 },
                second: Receipt { code: 13 }
            },
            stamp: Stamp { marked: true }
        }
    })
}

machine main() crashes Trap {
    let skipped: bool = selected(false);
    let observed: bool = selected(true);
    transition skipped == false && observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
