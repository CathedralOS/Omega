// Matching Choice<u64> retains its exact payload type beside Choice<bool>, so the selected payload returns as u64.
// Expected exit: 0

data Choice<T [copy]> [copy] { case Value(value: T); case Empty; }
data Other [copy] { case Value(value: u64); case Empty; }

machine wrap<T [copy]>(value: T) -> Choice<T> { Choice::Value { value: value } }
machine word() -> Choice<u64> { wrap(17u64) }
machine empty() -> Choice<u64> { Choice::Empty {} }
machine flag() -> Choice<bool> { wrap(true) }
machine observe_flag() -> bool {
    transition flag() {
        Choice::Value { value } -> value
        Choice::Empty -> false
    }
}

boundary trait CaseObservation {
    machine observe() -> u64 reaches;
}

WindowsChoiceObservation satisfies CaseObservation {
    machine observe() -> u64 {
        transition word() {
            Choice::Value { value } -> value
            Choice::Empty -> 0
            _ -> 0
        }
    }
}

LinuxChoiceObservation satisfies CaseObservation {
    machine observe() -> u64 {
        transition word() {
            Choice::Value { value } -> value
            Choice::Empty -> 0
        }
    }
}

ArmChoiceObservation satisfies CaseObservation {
    machine observe() -> u64 {
        transition word() {
            Choice::Value { value } -> value
            Choice::Empty -> 0
        }
    }
}

DarwinChoiceObservation satisfies CaseObservation {
    machine observe() -> u64 {
        transition word() {
            Choice::Value { value } -> value
            Choice::Empty -> 0
        }
    }
}

machine main() crashes Trap {
    let number: u64 = CaseObservation::observe();
    let flag: bool = observe_flag();
    transition number == 17 && flag && observe_empty() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine observe_empty() -> u64 {
    transition empty() {
        Choice::Value { value } -> value
        Choice::Empty -> 0
    }
}
