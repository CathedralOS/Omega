// An entry requirement `count >= 10` and the branch condition `count < 5`
// cannot both hold, so the subtraction on that branch closes by contradiction
// elimination even though nothing bounds `count` by 100. The compiler warns
// that the branch is unreachable; the live branch still runs.
machine pick(count: u64) -> u64
requires count >= 10
{
    transition {
        true -> (count - 100u64)
        false -> (count - 10u64)
    }
}
machine main() crashes Trap {
    transition pick(12) == 2 && pick(60) == 50 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
