// A match on one evaluation of a copyable flag selects an element view whose length is known only at run time, the join records the selected view's extent, and the consumer stores 41 at the last element of that recorded extent, leaving the unselected view and the neighbor canaries unchanged.
// Place: target_body.
// Expected exit: 0
data Outcome [copy] { chosen_last: i64; other_last: i64; }

machine choose(counter: &mut u64, flag: bool) -> bool
{
    counter = 1;
    flag
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedApply {
    machine apply(chosen: &mut [i64; 4], other: &mut [i64; 6], visits: &mut u64, flag: bool)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Apply satisfies SelectedApply {
    machine apply(chosen: &mut [i64; 4], other: &mut [i64; 6], visits: &mut u64, flag: bool)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let selected: &mut [i64] = match choose(visits, flag) {
            true -> &mut chosen
            false -> &mut other
        };
        let last: u64 = selected.len - 1;
        selected[last] = 41;
    }
}

ArmApply satisfies SelectedApply {
    machine apply(chosen: &mut [i64; 4], other: &mut [i64; 6], visits: &mut u64, flag: bool)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let selected: &mut [i64] = match choose(visits, flag) {
            true -> &mut chosen
            false -> &mut other
        };
        let last: u64 = selected.len - 1;
        selected[last] = 41;
    }
}

machine store(flag: bool) -> Outcome crashes Trap {
    let mut chosen: [i64; 4] = [3, 17, 18, 19];
    let mut other: [i64; 6] = [7, 23, 24, 25, 26, 27];
    let mut visits: u64 = 0;
    SelectedApply::apply(&mut chosen, &mut other, &mut visits, flag);
    transition visits == 1 && chosen[0] == 3 && chosen[2] == 18 && other[0] == 7 && other[4] == 26 {
        true -> report(Outcome { chosen_last: chosen[3], other_last: other[5] })
        false -> wrong()
    }
    machine report(outcome: Outcome) -> Outcome { outcome }
    machine wrong() -> Outcome crashes Trap { crash Trap; }
}

machine main() crashes Trap {
    let taken: Outcome = store(true);
    let fallback: Outcome = store(false);
    transition taken.chosen_last == 41 && taken.other_last == 27
        && fallback.chosen_last == 19 && fallback.other_last == 41 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}

machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}

machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
