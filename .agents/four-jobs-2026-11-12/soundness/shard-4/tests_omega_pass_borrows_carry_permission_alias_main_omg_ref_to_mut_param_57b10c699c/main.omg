// A domain may ALIAS a compiler-owned carry permission:
// `public domain Token::SuspensionSafe = Carry::AcrossSuspend` names
// the suspend-carry authority as a package-local fact, and a
// provider's `ensures result in Token::SuspensionSafe` grants it —
// the claim is born strict, relaxing suspension without relaxing
// CPU, thread, or address.
public data Token [linear] dropped by drop_token {
    id: u64;
}
machine drop_token(token: &Token) { }
use omega::language::core::drop;
public domain Token::SuspensionSafe = Carry::AcrossSuspend;
boundary trait ClaimProvider {
    machine grant(token: Token) -> Token
    reaches
    ensures
        result in Token::SuspensionSafe;
}
data ClaimProviderImpl {}
machine ClaimProviderImpl::grant_claim(token: Token) -> Token
satisfies ClaimProvider::grant
{
    token
}
data Main {}
machine Main::main(main: &mut Main) { }
