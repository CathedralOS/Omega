// Expected exit: 0
// A requirement's public guarantee reaches the caller of a static dispatch.
trait Pick { machine pick(left: i32, right: i32) -> i32 ensures result >= 7; }
Seven satisfies Pick {
    machine pick(left: i32, right: i32) -> i32 ensures result >= 7 { 7 }
}
machine choose<Implementation satisfies Pick>(left: i32, right: i32) -> i32
ensures result >= 7
{
    Implementation::pick(left, right)
}
machine hold(picked: i32) -> bool
{ true }
machine main() crashes Trap {
    let picked: i32 = choose<Seven>(1, 2);
    transition hold(picked) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
