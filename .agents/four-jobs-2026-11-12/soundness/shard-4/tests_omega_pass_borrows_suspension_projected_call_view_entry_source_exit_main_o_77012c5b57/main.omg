// Expected exit: 0
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
data Cell { value: i32; }
data Backing { left: i32; values: [i32; 1]; right: i32; }
data Message { body: &Cell; }
machine project(source: &Backing) -> &[i32; 1] { &source.values }
machine read(message: Message) -> i32 { message.body.value }
machine exercise(source: &Backing) -> i32 suspends reaches Scheduler {
 let saved: &[i32; 1] = project(source);
 let reference: &Cell = saved as &Cell;
 let message: Message = Message { body: reference };
 suspend Scheduler::park();
 read(message)
}
machine main() reaches Scheduler crashes Trap {
 let backing: Backing = Backing { left: 101, values: [73], right: 103 };
 let observed: i32 = suspend exercise(&backing);
 transition { true -> done() _ -> bad() }
 machine done() {}
 machine bad() crashes Trap { crash Trap; }
}
