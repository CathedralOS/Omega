data Main { observed: u64; }

machine Main::main() {}

machine Main::first(main: &mut Main, remaining: u64, cap: u64, step: u64, spare: u64) -> u64
terminates by remaining in 0..(cap / step + 6) {
    transition remaining > 0 {
        true -> Main::second(main, cap, remaining - 1, step, cap % step)
        false -> remaining
    }
}

machine Main::second(main: &mut Main, limit: u64, pending: u64, width: u64, extra: u64) -> u64
terminates by pending in 0..(limit / width + 6) {
    transition pending > 0 {
        true -> Main::first(main, pending, limit, width, extra)
        false -> pending
    }
}
