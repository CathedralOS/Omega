data Token { value: u64; }
data Pair { first: Token; second: Token; }

machine make() -> Pair {
    Pair { first: Token { value: 42 }, second: Token { value: 99 } }
}

// The consumer transfers one child and mutates its caller. The anonymous
// producer's residual sibling dies at this call's continuation, not at the
// enclosing return, regardless of whether the consumer body has effects.
machine consume(token: Token, observed: &mut u64) {
    observed = token.value;
}

machine main() crashes Trap {
    let mut observed: u64 = 0;
    consume(make().first, &mut observed);
    transition observed == 42 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
