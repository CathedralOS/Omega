data Layout { origin: u64; }

machine checked(backing: &[i32], index: u64) -> i32
requires index < backing.len {
    backing[index]
}

machine last(backing: &[i32], left: &Layout, right: &Layout) -> i32
requires backing.len == 6
requires left.origin == 0 && right.origin == 5 {
    let offset: u64 = left.origin + right.origin;
    checked(backing, offset)
}

machine main() -> i32 {
    let backing: [i32; 6] = [1, 4, 2, 5, 3, 6];
    let left: Layout = Layout { origin: 0 };
    let right: Layout = Layout { origin: 5 };
    last(&backing, &left, &right)
}
