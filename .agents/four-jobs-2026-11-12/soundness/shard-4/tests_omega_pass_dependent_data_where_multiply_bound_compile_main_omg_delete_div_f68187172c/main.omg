// A `data where` bound may multiply fields: `Area` is valid only while
// `wide * tall <= 24` — the fact reasons over a product operand, not just
// sums or bare comparisons.
data Area
requires
    wide * tall <= 24,
{
    wide: u64;
    tall: u64;
}

data Main { area: Area; }

machine Main::main(main: &mut Main) {
    main.area = Area { wide: 4, tall: 5 };
}
