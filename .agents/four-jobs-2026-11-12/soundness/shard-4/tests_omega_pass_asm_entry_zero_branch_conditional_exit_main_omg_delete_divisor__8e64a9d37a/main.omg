// Expected exit: 0.
machine countdown() -> u32 ensures result == 0 {
    let mut output: u32 = 99;
    asm {
    entry:
        mov eax, 2;
        sub eax, 1;
        jz done;
    loop requires eax > 0:
        sub eax, 1;
        jnz loop;
    done requires eax == 0 ensures output == 0:
        mov output, eax
    }
    output
}
machine main() crashes Trap {
    let value: u32 = countdown();
    transition value == 0 { true -> finished() false -> failed() }
}
machine finished() {}
machine failed() crashes Trap { crash Trap; }
