use omega::language::core::drop;

data Token [linear] dropped by drop_token { value: u64; }
data Holder { guard: u64; token: Token; }

machine drop_token(token: &Token) {}

machine abandon(holder: &mut Holder) crashes Trap {
    let detached: Token = holder.token;
    // Crash abandons both the detached value and the original restoration debt.
    // It returns neither a complete owner nor a successful cleanup receipt.
    crash Trap;
}

machine main() crashes Trap {
    let mut holder: Holder = Holder { guard: 19, token: Token { value: 41 } };
    abandon(&mut holder);
    let remaining: Token = holder.token;
    drop(remaining);
}
