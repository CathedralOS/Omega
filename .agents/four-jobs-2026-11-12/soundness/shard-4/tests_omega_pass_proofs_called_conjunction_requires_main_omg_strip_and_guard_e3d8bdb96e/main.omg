// A `requires` that calls a boolean machine means what that machine's body
// means. `represents` returns a conjunction, so a caller that requires it
// holds both comparisons, exactly as if it had written `a && b` itself.
// `unique` needs the first comparison from each premise to conclude.
data Pair [copy] { first: u8; last: u8; }
data Frame [copy] { tag: u8; first: u8; last: u8; }

machine represents<'view, 'value>(frame: &'view Frame, value: &'value Pair) -> bool
reaches none terminates { frame.first == value.first && frame.last == value.last }

machine unique<'view, 'left, 'right>(frame: &'view Frame, left: &'left Pair, right: &'right Pair)
reaches none terminates
requires represents(frame, left)
requires represents(frame, right)
ensures left.first == right.first
ensures left.last == right.last { }

machine main() { }
