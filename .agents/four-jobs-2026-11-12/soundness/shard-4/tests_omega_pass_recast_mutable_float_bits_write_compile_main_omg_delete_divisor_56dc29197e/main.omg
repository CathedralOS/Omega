// A mutable equal-width recast view writes through: `&mut main.rate as
// &mut u64` stores raw bits into the f64's storage, and reading the float
// afterward observes the reinterpreted pattern — bit 63 sets the sign.
data Main {
    rate: f64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 1.5;
    let bits: &mut u64 = &mut main.rate as &mut u64;
    bits = 13830554455654793216;
    transition main.rate == -1.5 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
