// Exact subtraction discharged by requires + guard: `remaining - 2`
// is exact u64 arithmetic because the entry `requires remaining <= 5`
// bounds the value and the `remaining >= 2` transition guard proves
// the operand order. No domain, no `as`.
//
// Place: another target body.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedDeduct {
    machine deduct(remaining: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires remaining <= 5 && remaining >= 2;
}

X86Deduct satisfies SelectedDeduct {
    machine deduct(remaining: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires remaining <= 5 && remaining >= 2
    {
        SelectedBodyCheck::require_tag(17u64);
        remaining - 2
    }
}

ArmDeduct satisfies SelectedDeduct {
    machine deduct(remaining: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires remaining <= 5 && remaining >= 2
    {
        SelectedBodyCheck::require_tag(29u64);
        remaining - 2
    }
}

machine walk(remaining: u64) -> u64
requires
    remaining <= 5
{
    transition remaining >= 2 {
        true -> SelectedDeduct::deduct(remaining)
        false -> remaining
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    transition walk(4) == 2 && walk(1) == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    entry_start();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    entry_start();
}
