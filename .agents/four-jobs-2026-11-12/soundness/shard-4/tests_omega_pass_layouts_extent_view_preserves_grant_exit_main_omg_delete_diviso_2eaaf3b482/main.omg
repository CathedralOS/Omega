// Expected exit: 0
// Accessing external words preserves the exact grant for their descriptor.
use omega::language::core::extent;
use omega::language::core::layout;
use omega::language::core::process_exit;

data TestMemory {}
RootProvider satisfies ExtentRootProvider {
 machine grant(geometry: Extent) -> Extent { geometry }
}
boundary trait NativeAllocation {
 machine allocate(count:u64,width:u64)->addr reaches;
}
data Roots { before:u64; storage:Extent in Granted; after:u64; }

// Each slot owns its original descriptor. A write through one selected external
// view must leave the qualifications of both descriptors available on return.
data Slot { case Empty; case Held(storage:Extent in Granted); }
data ArrayRoots { before:u64; slots:[Slot;2]; after:u64; }

machine exchange_slot(slot:&mut Slot,value:u64)->u64 crashes Trap {
 transition slot in Slot::Held {
  true -> held(slot,value)
  _ -> bad()
 }
 machine held(slot:&mut Slot,value:u64)->u64
 requires slot in Slot::Held
 { exchange(&mut slot.storage,value) }
 machine bad()->u64 { crash Trap; }
}

machine exchange_selected(roots:&mut ArrayRoots,next:u64,value:u64)->u64
requires next < 2
crashes Trap
{ exchange_slot(&mut roots.slots[next],value) }

machine observe_slot(slot:&Slot)->bool crashes Trap {
 transition slot in Slot::Held {
  true -> held(slot)
  _ -> false
 }
 machine held(slot:&Slot)->bool
 requires slot in Slot::Held
 { observe(&slot.storage) }
}

machine observe_selected(roots:&ArrayRoots,next:u64)->bool
requires next < 2
crashes Trap
{ observe_slot(&roots.slots[next]) }

machine seed(storage:&mut Extent in Granted) crashes Trap {
 transition Access::view_extent_mut<WordPlacement,Words,TestMemory>(storage) {
  AccessOutcome::Ready { view } -> initialize(view)
  AccessOutcome::Rejected { returned,reason } -> bad()
 }
 machine initialize(view:&mut Access<WordPlacement,Words>) {
  write(&mut view.entries[0],17u64);
  write(&mut view.entries[1],41u64);
  write(&mut view.entries[2],29u64);
 }
 machine bad() { crash Trap; }
}

machine exchange(storage:&mut Extent in Granted,value:u64)->u64 crashes Trap {
 transition Access::view_extent_mut<WordPlacement,Words,TestMemory>(storage) {
  AccessOutcome::Ready { view } -> change(view,value)
  AccessOutcome::Rejected { returned,reason } -> bad()
 }
 machine change(view:&mut Access<WordPlacement,Words>,value:u64)->u64 {
  let previous:u64=read(&view.entries[1]);
  write(&mut view.entries[1],value);
  previous
 }
 machine bad()->u64 { crash Trap; }
}

machine observe(storage:&Extent in Granted)->bool crashes Trap {
 transition Access::view_extent<WordPlacement,Words,TestMemory>(storage) {
  AccessOutcome::Ready { view } -> check(view)
  AccessOutcome::Rejected { returned,reason } -> bad()
 }
 machine check(view:&Access<WordPlacement,Words>)->bool {
  let before:u64=read(&view.entries[0]);
  let value:u64=read(&view.entries[1]);
  let after:u64=read(&view.entries[2]);
  before==17 && value==97 && after==29
 }
 machine bad()->bool { crash Trap; }
}

machine select_write(first:&mut Access<WordPlacement,Words>,second:&mut Access<WordPlacement,Words>,choose:bool,value:u64)->u64 {
 let selected:&mut Access<WordPlacement,Words> = match choose {
  true -> first,
  false -> second,
 };
 let previous:u64=read(&selected.entries[1]);
 write(&mut selected.entries[1],value);
 previous
}
machine alias_paths()->bool {
 let mut first:Words=Words {entries:[13,17,19]};
 let mut second:Words=Words {entries:[23,29,31]};
 let before_first:u64=select_write(Access::view_mut<WordPlacement,Words>(&mut first),Access::view_mut<WordPlacement,Words>(&mut second),true,73);
 let before_second:u64=select_write(Access::view_mut<WordPlacement,Words>(&mut first),Access::view_mut<WordPlacement,Words>(&mut second),false,97);
 before_first==17 && before_second==29 && first.entries[0]==13 && first.entries[1]==73 && first.entries[2]==19 && second.entries[0]==23 && second.entries[1]==97 && second.entries[2]==31
}

machine main() crashes Trap {
 let aliases:bool=alias_paths();
 let address:addr=NativeAllocation::allocate(3,8);
 transition address!=0 && aliases { true -> allocated(address) false -> bad() }
 machine allocated(address:addr) {
  let mut storage:Extent in Granted=ExtentRootProvider::grant(Extent {base:address,length:24});
  seed(&mut storage);
  let first:u64=exchange(&mut storage,73);
  let mut roots:Roots=Roots {before:991,storage:storage,after:997};
  let second:u64=exchange(&mut roots.storage,97);
  let contents:bool=observe(&roots.storage);
  transition first==41 && second==73 && contents && roots.before==991 && roots.after==997 && roots.storage.base==address && roots.storage.length==24 {
   true -> arrays(roots)
   false -> bad()
  }
 }
 machine arrays(original:Roots) {
  let first_address:addr=NativeAllocation::allocate(3,8);
  let second_address:addr=NativeAllocation::allocate(3,8);
  transition first_address!=0 {
   true -> allocated(original,first_address,second_address)
   _ -> bad()
  }
  machine allocated(original:Roots,first_address:addr,second_address:addr) {
   let mut first:Extent in Granted=ExtentRootProvider::grant(Extent {base:first_address,length:24});
   let mut second:Extent in Granted=ExtentRootProvider::grant(Extent {base:second_address,length:24});
   seed(&mut first);
   seed(&mut second);
   let mut roots:ArrayRoots=ArrayRoots {before:881,slots:[Slot::Held {storage:first},Slot::Held {storage:second}],after:887};
   let first_previous:u64=exchange_selected(&mut roots,1,73);
   let second_previous:u64=exchange_selected(&mut roots,0,97);
   let third_previous:u64=exchange_selected(&mut roots,1,97);
   let first_contents:bool=observe_selected(&roots,0);
   let second_contents:bool=observe_selected(&roots,1);
   transition first_previous==41 && second_previous==41 && third_previous==73 && first_contents && second_contents && roots.before==881 && roots.after==887 {
    true -> finish(original,roots)
    _ -> bad()
   }
  }
 }
 machine finish(roots:Roots,array_roots:ArrayRoots) { ProcessExit::exit_process(0); }
 machine bad() { crash Trap; }
}

public data Words { entries: [u64; 3]; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    let layout: LayoutPlan = LayoutPlan { entries: fields, entry_count: 1, size_fixed: 24, size_is_dynamic: false, align: 8 };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::with(AccessPlan::inaccessible(layout), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: true, exposure: Exposure::Exported }),
        BoundaryReach { services: services, service_count: 0 }
    )
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut transfers: [TransferRule; 16];
        transfers[0] = TransferRule { width_bits: 64, alignment_bytes: 8 };
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::HostileShared,
            stable: StableCapability::None,
            external: ExternalCapability::Access {
                read: ExternalReadBehavior::Repeatable, write: true,
                transfers: TransferRules { entries: transfers, rule_count: 1 },
            },
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

