// Expected exit: 0. An additional input qualification may expire after a call.
domain [u16; 4]::Terminated requires self[3] == 0;
machine corrupt(value: &mut [u16; 4] in Terminated, fail: bool) -> u64 {
    transition fail { true -> broken(value) false -> 0 }
    machine broken(value: &mut [u16; 4] in Terminated) -> u64 {
        value[3] = 1;
        transition value[0] == 0 { true -> 0 false -> 3 }
    }
}
machine main() crashes Trap {
    let changed: [u16; 4] = [1, 2, 3, 0];
    let mut zero_first: [u16; 4] = [0, 5, 6, 0];
    let mut untouched: [u16; 4] = [7, 8, 9, 0];
    let changed_result: u64 = corrupt(&mut changed, true);
    let zero_result: u64 = corrupt(&mut zero_first, true);
    let untouched_result: u64 = corrupt(&mut untouched, false);
    transition changed_result == 3 && changed[0] == 1 && changed[1] == 2
        && changed[2] == 3 && changed[3] == 1
        && zero_result == 0 && zero_first[0] == 0 && zero_first[1] == 5
        && zero_first[2] == 6 && zero_first[3] == 1
        && untouched_result == 0 && untouched[0] == 7 && untouched[1] == 8
        && untouched[2] == 9 && untouched[3] == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
