// A match subject call installs a fresh token in the slot it borrows, the selected arm's branch-local call takes custody of that installed token or of the other token, and every token the arms leave behind is cleaned up exactly once.
// Place: parameter.
// Expected exit: 0
data Counter { count: u64 in Wrapping; }
data Token<'c> dropped by drop_token<'c> { counter: &'c mut Counter; mark: u64; }

machine drop_token<'c>(token: &mut Token<'c>) {
    token.counter.count = token.counter.count + (token.mark as u64 in Wrapping);
}

machine relay<'c>(token: Token<'c>) -> Token<'c> {
    let kept: Token<'c> = token;
    kept.mark = 40;
    kept
}

machine refill<'c>(slot: &mut Token<'c>, counter: &'c mut Counter, flag: bool) -> bool {
    slot = Token { counter: counter, mark: 5 };
    flag
}

machine apply<'c>(mut slot: Token<'c>, other: Token<'c>, c: &'c mut Counter, flag: bool) -> u64 {
    let held: Token = match refill(&mut slot, c, flag) {
        true -> relay(slot),
        false -> relay(other)
    };
    held.mark
}

machine exercise(a: &mut Counter, b: &mut Counter, c: &mut Counter, flag: bool) -> u64 {
    apply(Token { counter: a, mark: 11 }, Token { counter: b, mark: 13 }, c, flag)
}

machine main() crashes Trap {
    let mut a1: Counter = Counter { count: 0 };
    let mut b1: Counter = Counter { count: 0 };
    let mut c1: Counter = Counter { count: 0 };
    let mut a2: Counter = Counter { count: 0 };
    let mut b2: Counter = Counter { count: 0 };
    let mut c2: Counter = Counter { count: 0 };
    let m1: u64 = exercise(&mut a1, &mut b1, &mut c1, true);
    let m2: u64 = exercise(&mut a2, &mut b2, &mut c2, false);
    transition m1 == 40 && a1.count == 11 && b1.count == 13 && c1.count == 40
        && m2 == 40 && a2.count == 11 && b2.count == 40 && c2.count == 5 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
