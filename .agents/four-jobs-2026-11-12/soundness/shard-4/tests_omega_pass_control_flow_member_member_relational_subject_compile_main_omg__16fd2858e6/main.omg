// A `transition` subject may compare two members relationally:
// `main.left >= main.right` reads both and dispatches on the ordering —
// the subject is any expression over the record's live fields.
data Main {
    left: u64;
    right: u64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.left = 9;
    main.right = 4;
    transition main.left >= main.right {
        true -> leads(main)
        _ -> trails(main)
    }

    machine leads(main: &mut Main) { main.answer = 70; }
    machine trails(main: &mut Main) { main.answer = 71; }
}
