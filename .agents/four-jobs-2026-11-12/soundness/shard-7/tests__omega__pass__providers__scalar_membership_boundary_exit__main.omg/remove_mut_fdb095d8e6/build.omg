machine build(builder: &mut Build) {
    Build::application(builder, "scalar_membership_boundary_exit");
    Build::select_provider<Gate, ProviderGateImplementation>(builder, linux_arm64);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, linux_x86_64);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, macos_arm64);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, macos_x86_64);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, windows_x86_64);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, uefi_x86_64);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, cross_platform_cli);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, local_unchecked);
    Build::select_provider<Gate, ProviderGateImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
