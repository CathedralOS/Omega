machine build(builder: &mut Build) {
    Build::application(builder, "suspension_transported_loan_projected_call_source_local");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Scheduler, Immediate>(builder, linux_x86_64);
    Build::select_provider<Scheduler, Immediate>(builder, linux_arm64);
    Build::select_provider<Scheduler, Immediate>(builder, macos_arm64);
    Build::select_provider<Scheduler, Immediate>(builder, windows_x86_64);
}
