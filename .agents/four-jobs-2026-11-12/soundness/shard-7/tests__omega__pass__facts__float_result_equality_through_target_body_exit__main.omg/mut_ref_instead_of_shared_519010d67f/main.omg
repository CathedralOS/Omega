// A returned f64 equals the live field it came from.
// Expected exit: 0
data Ends { kept: f64; other: f64; }
machine read_kept(item: &mut Ends) -> f64
requires item.kept == 7.0
ensures result == item.kept && result == 7.0
{
    item.kept
}

machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}
boundary trait FloatObservation {
    machine observe(item: &Ends) -> f64
    requires item.kept == 7.0
    reaches;
}
SelectedFloatObservation satisfies FloatObservation {
    machine observe(item: &Ends) -> f64
    requires item.kept == 7.0
    {
        let saved: f64 = read_kept(item);
        let agreed: f64 = agree(saved, item.kept);
        transition { _ -> agreed }
    }
}

machine main() crashes Trap {
    let item: Ends = Ends { kept: 7.0, other: 1.0 };
    transition FloatObservation::observe(&item) == 7.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
