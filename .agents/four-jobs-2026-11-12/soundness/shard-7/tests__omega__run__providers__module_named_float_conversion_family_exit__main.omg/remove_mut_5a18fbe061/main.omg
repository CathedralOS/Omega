module conversion_probe;
use omega::language::core::float_operations;
use omega_language_std::console;

public data Main { }
// Named modules must not make unchanged core provider families disappear.
// The byte is runtime input so the conversion also crosses native/Terminal.
public machine main(application: &mut Main) reaches Console
invokes Console
blocks
crashes Trap
{
    transition block Console::read_byte() {
        ByteRead::Byte { value } -> convert(application, value)
        _ -> missing(application)
    }
    machine convert(application: &mut Main, value: i32) {
        let floating: f64 = F64::from_i32(value) + 0.75;
        let converted: i32 in Saturating = I32::from_f64(floating);
        transition converted == 65 {
            true -> done(application)
            false -> wrong(application)
        }
    }
    machine done(application: &mut Main) {
        Console::write_line("converted=65");
        Console::exit_process(0);
    }
    machine missing(application: &mut Main) { Console::exit_process(2); }
    machine wrong(application: &mut Main) { Console::exit_process(3); }
}

// The hosted entry takes no arrival parameters; it owns the program's
// storage and passes it to `main` explicitly.
public machine entry_start() reaches Console
invokes Console
blocks
crashes Trap
{
    let entry_storage: Main;
    block main(&mut entry_storage);
}
