machine build(builder: &mut Build) {
    Build::application(builder, "module_named_float_conversion_family_exit");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, conversion_probe::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, conversion_probe::entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, conversion_probe::entry_start);
}
