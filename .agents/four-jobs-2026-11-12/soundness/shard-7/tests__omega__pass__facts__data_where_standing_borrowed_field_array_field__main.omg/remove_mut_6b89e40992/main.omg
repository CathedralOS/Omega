// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
public machine bounded(value: &i32) -> bool { value <= 60 }
public data Counter<'storage> [copy] requires bounded(self.value) == true { before: i32; value: &'storage i32; after: i32; marker: i32; }
machine read(value: &i32) -> i32 ensures result == value, { value }
public data Holder<'counter, 'storage> [copy] { prefix: i32; counters: [&'counter Counter<'storage>; 2]; suffix: i32; }
public data Envelope<'counter, 'storage> { holder: Holder<'counter, 'storage>; }
public machine compute(envelope: &Envelope, index: u64) -> i32 requires index < 2 {
    let value: i32 = read(envelope.holder.counters[index].value);
    let total: i32 = 70 + value;
    transition envelope.holder.prefix == 31 && envelope.holder.suffix == 47 { true -> total false -> -99 }
}
machine main() crashes Trap {
    let high: i32 = 60;
    let low: i32 = -17;
    let first: Counter = Counter { before: 17, value: &high, after: 53, marker: 19 };
    let mut second: Counter = Counter { before: 17, value: &low, after: 53, marker: 23 };
    let first_holder: Holder = Holder { prefix: 31, counters: [&first, &second], suffix: 47 };
    let second_holder: Holder = Holder { prefix: 31, counters: [&second, &first], suffix: 47 };
    let first_envelope: Envelope = Envelope { holder: first_holder };
    let second_envelope: Envelope = Envelope { holder: second_holder };
    transition compute(&first_envelope, 0) == 130 && compute(&first_envelope, 1) == 53 && compute(&second_envelope, 0) == 53 && compute(&second_envelope, 1) == 130
        && first.before == 17 && first.after == 53 && first.marker == 19
        && second.before == 17 && second.after == 53 && second.marker == 23
        && first_holder.prefix == 31 && first_holder.suffix == 47
        && second_holder.prefix == 31 && second_holder.suffix == 47
        && first_envelope.holder.prefix == 31 && first_envelope.holder.suffix == 47
        && second_envelope.holder.prefix == 31 && second_envelope.holder.suffix == 47
        && high == 60 && low == -17 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
