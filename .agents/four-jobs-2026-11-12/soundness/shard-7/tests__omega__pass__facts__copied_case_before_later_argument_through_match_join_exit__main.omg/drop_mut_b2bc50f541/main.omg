// A copied Present payload of 7 stays readable after a later argument replaces its source with Absent.
// Place: match_join.
// Expected exit: 0
data Slot [copy] { case Absent; case Present(value: u64); }

machine set_to_absent(slot: &mut Slot) -> u64 {
    slot = Slot::Absent {};
    0
}

machine read_payload(before: Slot, marker: u64) -> u64
requires before in Slot::Present
{
    before.value
}

data Joined [copy] { chosen: Slot; route: u64; }

machine main() crashes Trap {
    exercise(true);
    exercise(false);
}

machine exercise(flag: bool) crashes Trap {
    let joined: Joined = match flag {
        true -> Joined { chosen: Slot::Present { value: 7 }, route: 17 }
        false -> Joined { chosen: Slot::Present { value: 7 }, route: 23 }
    };
    let chosen: Slot = joined.chosen;
    let observed: u64 = read_payload(chosen, set_to_absent(&mut chosen));
    transition observe_replacement(observed, chosen) == 7
        && ((flag == true && joined.route == 17) || (flag == false && joined.route == 23)) {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

// Observe the activation that owns the later replacement, after the payload read.
machine observe_replacement(observed: u64, after: Slot) -> u64 {
    match after in Slot::Absent {
        true -> observed
        false -> 99
    }
}
