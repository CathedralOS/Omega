machine build(builder: &mut Build) {
    Build::application(builder, "phantom_local_calling_applications");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::select_provider<Probe<u8>, ProbeMap>(builder, macos_arm64);
    Build::select_provider<Probe<u8>, ProbeMap>(builder, linux_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
