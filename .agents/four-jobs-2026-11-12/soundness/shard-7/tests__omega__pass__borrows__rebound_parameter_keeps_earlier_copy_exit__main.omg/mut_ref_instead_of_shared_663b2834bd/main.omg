// Expected exit: 0
// A copy taken from a shared-reference parameter before the parameter is
// rebound keeps naming the caller's referent. Rebinding `selected` to a local
// afterwards does not change what `saved` points to, so returning `saved` is
// valid. At run time the caller's value is 9 and the local is 7: the caller
// must read 9 through the returned view.
machine observe<'a>(mut selected: &'a u64) -> &'a u64 {
    let saved: &'a u64 = selected;
    let local: u64 = 7;
    selected = &mut local;
    saved
}

machine main() crashes Trap {
    let original: u64 = 9;
    let r: &u64 = observe(&original);
    transition r == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
