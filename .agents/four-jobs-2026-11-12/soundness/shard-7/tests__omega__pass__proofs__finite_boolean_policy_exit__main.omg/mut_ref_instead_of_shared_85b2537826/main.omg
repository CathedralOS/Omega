    table.vector32 = InterruptGate { selector: 8u16, ist: 4u8, attributes: 142u8, reserved: 0u32 };
}
public data RetainedTable { before: u64; table: BootstrapIdt; after: u64; }
machine main() crashes Trap {
    let mut owner: RetainedTable;
    owner.before = 0x13579BDF2468ACE0u64;
    owner.after = 0xFEDCBA9876543210u64;
    initialize(&mut owner.table);
    let matching: bool = validate(&owner.table);
    owner.table.vector00.selector = 9u16;
    let first_wrong: bool = validate(&owner.table);
    owner.table.vector00.selector = 8u16;
    owner.table.vector16.attributes = 0u8;
    let middle_wrong: bool = validate(&owner.table);
    owner.table.vector16.attributes = 142u8;
    owner.table.vector32.reserved = 1u32;
    let last_wrong: bool = validate(&owner.table);
    transition matching && !first_wrong && !middle_wrong && !last_wrong
        && owner.before == 0x13579BDF2468ACE0u64
        && owner.after == 0xFEDCBA9876543210u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
