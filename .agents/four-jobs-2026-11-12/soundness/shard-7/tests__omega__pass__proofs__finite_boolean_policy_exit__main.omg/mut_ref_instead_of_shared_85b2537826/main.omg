machine validate(table: &BootstrapIdt) -> bool
ensures table_policy(result, table) { table_policy(true, table) }
machine initialize(table: &mut BootstrapIdt) {
    table.vector00 = InterruptGate { selector: 8u16, ist: 0u8, attributes: 142u8, reserved: 0u32 };
    table.vector01 = InterruptGate { selector: 8u16, ist: 0u8, attributes: 142u8, reserved: 0u32 };
    table.vector02 = InterruptGate { selector: 8u16, ist: 2u8, attributes: 142u8, reserved: 0u32 };
