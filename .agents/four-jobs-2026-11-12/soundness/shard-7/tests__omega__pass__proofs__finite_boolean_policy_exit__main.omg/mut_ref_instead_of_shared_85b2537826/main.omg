        table.vector18.selector == 8u16 && table.vector18.ist == 3u8
        && table.vector18.attributes == 142u8 && table.vector18.reserved == 0u32 &&
        table.vector19.selector == 8u16 && table.vector19.ist == 0u8
        && table.vector19.attributes == 142u8 && table.vector19.reserved == 0u32 &&
        table.vector20.selector == 8u16 && table.vector20.ist == 0u8
        && table.vector20.attributes == 142u8 && table.vector20.reserved == 0u32 &&
        table.vector21.selector == 8u16 && table.vector21.ist == 0u8
