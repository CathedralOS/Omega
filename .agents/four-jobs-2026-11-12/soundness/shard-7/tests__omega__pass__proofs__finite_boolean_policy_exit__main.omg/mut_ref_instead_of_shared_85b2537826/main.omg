    vector30: InterruptGate;
    vector31: InterruptGate;
    vector32: InterruptGate;
}
public machine table_policy(accepted: bool, table: &mut BootstrapIdt) -> bool reaches terminates {
    !accepted || (
        table.vector00.selector == 8u16 && table.vector00.ist == 0u8
        && table.vector00.attributes == 142u8 && table.vector00.reserved == 0u32 &&
