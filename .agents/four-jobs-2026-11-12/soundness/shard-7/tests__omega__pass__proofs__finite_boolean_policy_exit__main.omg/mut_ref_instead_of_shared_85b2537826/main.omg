// Expected exit: 0
// Preserve every table-field check through a returned Boolean policy.
public data InterruptGate { selector: u16; ist: u8; attributes: u8; reserved: u32; }
public data BootstrapIdt {
    vector00: InterruptGate;
    vector01: InterruptGate;
    vector02: InterruptGate;
