// Expected exit: 0
// Array length evaluation preserves identity contracts on ordinary calls.
machine pair_size() -> u64 { 2 }
machine keep(value: u8) -> u8
ensures core::Identity<u8>(result, value)
{ value }
machine main() crashes Trap {
    let values: [u8; pair_size()];
    values[0] = keep(7u8);
    values[1] = keep(11u8);
    transition values[0] == 7u8 && values[1] == 11u8 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
