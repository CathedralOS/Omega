// Expected exit: 0
// Fact: a write-only representation view writes 73 to the original record without granting observation.
data Original { value: u32; }
data Viewed { value: u32; }

// Only this branch writes the marker, so the caller can detect a wrong selection.
machine marked<'storage>(storage: &'storage write Original, marker: &mut write u32) -> &'storage write Viewed {
    marker = 1;
    storage as &write Viewed
}

machine overwrite(storage: &write Original, choose: bool, marker: &write u32) {
    let view: &write Viewed = match choose {
        true -> marked(storage, marker),
        false -> storage as &write Viewed
    };
    view.value = 73;
}

machine exercise(choose: bool, expected_marker: u32) crashes Trap {
    let mut original: Original = Original { value: 0 };
    let mut marker: u32 = 0;
    overwrite(&write original, choose, &write marker);
    transition original.value == 73 && marker == expected_marker { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    exercise(true, 1);
    exercise(false, 0);
}
