machine build(builder: &mut Build) {
    Build::application(builder, "runtime_named_unit_statement_effects_exit");
    Build::select_provider<Actions::set, Setter>(builder, linux_x86_64);
    Build::select_provider<Actions::set, Setter>(builder, windows_x86_64);
    Build::select_provider<Actions::set, Setter>(builder, macos_arm64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
