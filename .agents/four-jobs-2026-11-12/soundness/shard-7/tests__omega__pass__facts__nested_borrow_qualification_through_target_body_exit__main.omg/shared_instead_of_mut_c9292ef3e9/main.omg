// A nested borrowed record preserves the final-word-is-zero qualification for a consuming call.
// Place: target_body.
// Expected exit: 0
public domain [u16; 4]::Terminated requires self[3] == 0;
public data Name<'scope> { words: &'scope [u16; 4] in Terminated; }
public data Attributes<'scope> { name: &'scope Name<'scope>; }
machine final_word(word: u16) -> u16 requires word == 0 { word }
public machine consume<'scope>(attributes: &Attributes<'scope>) -> u16 {
    final_word(attributes.name.words[3])
}

// Nonzero neighbors make an incorrect nested pointer or element offset observable.
machine neighbors_valid<'scope>(attributes: &Attributes<'scope>) -> bool {
    attributes.name.words[0] == 11
        && attributes.name.words[1] == 23
        && attributes.name.words[2] == 37
}
machine consume_with_neighbor_checks<'scope>(attributes: &Attributes<'scope>) -> u16 {
    let result: u16 = consume(attributes);
    transition neighbors_valid(attributes) { true -> result false -> 1 }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTargetConsume {
    machine target_consume<'scope>(attributes: &Attributes<'scope>) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86TargetConsume satisfies SelectedTargetConsume {
    machine target_consume<'scope>(attributes: &Attributes<'scope>) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     consume_with_neighbor_checks(attributes)
    }
}

ArmTargetConsume satisfies SelectedTargetConsume {
    machine target_consume<'scope>(attributes: &Attributes<'scope>) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     consume_with_neighbor_checks(attributes)
    }
}


data Main {}
machine Main::main(main: & Main) crashes Trap {
    let mut words: [u16; 4];
    words[0] = 11;
    words[1] = 23;
    words[2] = 37;
    words[3] = 0;
    let name: Name = Name { words: &words };
    let attributes: Attributes = Attributes { name: &name };
    let result: u16 = SelectedTargetConsume::target_consume(&attributes);
    transition result == 0 { true -> done() false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    entry_start();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    entry_start();
}
