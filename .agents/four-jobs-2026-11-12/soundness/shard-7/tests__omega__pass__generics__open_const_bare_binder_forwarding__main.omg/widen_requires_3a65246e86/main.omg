// Expected exit: 0
// A generic body may forward its own const binder unchanged: Selected<Base>
// satisfies the bound Reading<Base> for every admitted Base, so the open body
// is valid, and construct<7> supplies at least seven before exact value - 7.
trait Reading<const Minimum: u64> {
    machine read() -> u64 ensures result >= Minimum;
}
Selected<const Value: u64> satisfies Reading<Value> {
    machine read() -> u64 ensures result == Value { Value }
}
machine selected<const Minimum: u64, Implementation satisfies Reading<Minimum>>() -> u64
ensures result >= Minimum
{ Implementation::read() }
machine construct<const Base: u64>() -> u64
requires Base > 100
ensures result >= Base
{ selected<Base, Selected<Base>>() }
machine main() crashes Trap {
    let value: u64 = construct<7>();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
