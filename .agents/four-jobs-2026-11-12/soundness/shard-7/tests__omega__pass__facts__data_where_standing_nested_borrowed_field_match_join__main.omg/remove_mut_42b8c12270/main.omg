// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
public machine bounded(value: &i32) -> bool { value <= 60 }
public data Counter<'storage> [copy] requires bounded(self.value) == true { before: i32; value: &'storage i32; after: i32; marker: i32; }
machine read(value: &i32) -> i32 ensures result == value, { value }
public data Holder<'counter, 'storage> [copy] { prefix: i32; counter: &'counter Counter<'storage>; suffix: i32; }
public data SourceCounter<'storage> [copy] requires bounded(self.value) == true { before: i32; value: &'storage i32; after: i32; marker: i32; }
public data SourceHolder<'counter, 'storage> [copy] { prefix: i32; counter: &'counter SourceCounter<'storage>; suffix: i32; }
machine require_same(left: i32, right: i32) requires left == right, {}
public machine capture<'counter, 'storage>(holder: &mut SourceHolder<'counter, 'storage>, replacement: &'counter SourceCounter<'storage>) -> Counter<'storage> {
    let old: &'storage i32 = holder.counter.value;
    let observed: i32 = read(old);
    let before: i32 = holder.counter.before;
    let after: i32 = holder.counter.after;
    let marker: i32 = holder.counter.marker;
    holder.counter = replacement;
    let kept: i32 = read(old);
    require_same(observed, kept);
    Counter { before: before, value: old, after: after, marker: marker }
}
public machine compute(left: Holder, right: Holder, flag: bool) -> i32 {
    let holder: Holder = match flag { true -> left false -> right };
    let value: i32 = read(holder.counter.value);
    70 + value
}
machine main() crashes Trap {
    let high: i32 = 60;
    let low: i32 = -17;
    let source_first: SourceCounter = SourceCounter { before: 17, value: &high, after: 53, marker: 19 };
    let source_second: SourceCounter = SourceCounter { before: 17, value: &low, after: 53, marker: 23 };
    let source_first_holder: SourceHolder = SourceHolder { prefix: 31, counter: &source_first, suffix: 47 };
    let mut source_second_holder: SourceHolder = SourceHolder { prefix: 31, counter: &source_second, suffix: 47 };
    let mut first: Counter = capture(&mut source_first_holder, &source_second);
    let mut second: Counter = capture(&mut source_second_holder, &source_first);
    let first_holder: Holder = Holder { prefix: 31, counter: &first, suffix: 47 };
    let second_holder: Holder = Holder { prefix: 31, counter: &second, suffix: 47 };
    transition compute(first_holder, second_holder, true) == 130 && compute(first_holder, second_holder, false) == 53
        && first.before == 17 && first.after == 53 && first.marker == 19
        && second.before == 17 && second.after == 53 && second.marker == 23
        && first_holder.prefix == 31 && first_holder.suffix == 47
        && second_holder.prefix == 31 && second_holder.suffix == 47
        && source_first.before == 17 && source_first.after == 53 && source_first.marker == 19
        && source_second.before == 17 && source_second.after == 53 && source_second.marker == 23
        && read(source_first.value) == 60 && read(source_second.value) == -17
        && source_first_holder.prefix == 31 && source_first_holder.suffix == 47
        && source_second_holder.prefix == 31 && source_second_holder.suffix == 47
        && source_first_holder.counter.marker == 23 && source_second_holder.counter.marker == 19
        && read(source_first_holder.counter.value) == -17 && read(source_second_holder.counter.value) == 60
        && high == 60 && low == -17 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
