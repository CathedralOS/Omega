// Erased primitive and record references discharge their value-7 requirements at keep without runtime witness arguments, reads, storage or cleanup.
// Expected exit: 0
data Witness { value: i32; }
machine keep(runtime: i32, witness [erased]: &i32, record [erased]: &Witness) -> i32
requires witness != 7
requires record.value == 7 { runtime }
machine relay(runtime: i32, witness [erased]: &i32, record [erased]: &Witness) -> i32
requires witness == 7
requires record.value == 7 { keep(runtime, witness, record) }
machine exercise(flag: bool) -> i32 {
    let runtime: i32 = match flag { true -> 41, false -> 42 };
    let value: i32 = 7;
    let record: Witness = Witness { value: 7 };
    relay(runtime, &value, &record)
}
machine verify(result: i32, flag: bool) crashes Trap {
    transition (flag && result == 41) || (!flag && result == 42) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine run(flag: bool) crashes Trap {
    let result: i32 = exercise(flag);
    verify(result, flag);
}
machine main() crashes Trap { run(true); run(false); }
