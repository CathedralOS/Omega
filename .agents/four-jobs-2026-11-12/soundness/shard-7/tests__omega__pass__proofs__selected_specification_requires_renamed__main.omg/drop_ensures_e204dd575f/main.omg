use omega::language::core::nat;
machine selected_identity<machine Modulus>(value: Nat) -> Nat
requires machine Modulus(value: Nat) -> Nat terminates;
requires core::Identity<Nat>(saturating_sub(Modulus(value), value), Nat::Zero)
{
    value
}
machine identity<machine Choice>(subject: Nat)
requires machine Choice(input: Nat) -> Nat terminates;
requires core::Identity<Nat>(saturating_sub(Choice(subject), subject), Nat::Zero)
{
}
