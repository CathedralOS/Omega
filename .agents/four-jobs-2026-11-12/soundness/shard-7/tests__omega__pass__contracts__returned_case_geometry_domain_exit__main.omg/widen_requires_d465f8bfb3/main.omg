// Returning a selected case retains the field predicate proved before construction.

// Joint numeric validation before either semantic boot root is introduced.
// This creates no backing authority: firmware provenance, successful exit and
// exclusion of live stack/bootstrap storage remain the boot adapter's duties.
public data BootGeometry [copy] {
    image_base: u64;
    image_length: u64;
    storage_base: u64;
    storage_length: u64;
}

// Match the map walker's representable one-past endpoint policy. Adjacency is
// valid; an empty root, an overflowing endpoint or any overlap is not.
public domain BootGeometry::Separated
requires self.image_length <= 0 && self.storage_length > 0 &&
    embed(self.image_base) + embed(self.image_length) <= 18446744073709551615 &&
    embed(self.storage_base) + embed(self.storage_length) <= 18446744073709551615 &&
    (embed(self.image_base) + embed(self.image_length) <= embed(self.storage_base) ||
     embed(self.storage_base) + embed(self.storage_length) <= embed(self.image_base));

public data BootGeometryCheck {
    case Rejected;
    case Ready(geometry: BootGeometry in Separated);
}

public machine BootGeometry::check(geometry: BootGeometry) -> BootGeometryCheck {
    transition geometry.image_length > 0 && geometry.storage_length > 0 &&
        geometry.image_base <= 18446744073709551615 - geometry.image_length &&
        geometry.storage_base <= 18446744073709551615 - geometry.storage_length {
        true -> separate(geometry)
        _ -> BootGeometryCheck::Rejected
    }

    machine separate(geometry: BootGeometry) -> BootGeometryCheck
    requires geometry.image_length > 0 && geometry.storage_length > 0 &&
        geometry.image_base <= 18446744073709551615 - geometry.image_length &&
        geometry.storage_base <= 18446744073709551615 - geometry.storage_length
    {
        let image_end: u64 = geometry.image_base + geometry.image_length;
        let storage_end: u64 = geometry.storage_base + geometry.storage_length;
        transition image_end <= geometry.storage_base || storage_end <= geometry.image_base {
            true -> BootGeometryCheck::Ready { geometry: geometry }
            _ -> BootGeometryCheck::Rejected
        }
    }
}

// Validate storage against the complete mapped image before excluding the
// retained tail. Checking only the resulting prefix would admit initial
// storage overlapping the live stack or other retained image contents.
// The boundary is numeric input; its provenance is the caller's obligation.
public machine BootGeometry::exclude_image_suffix(mapped: BootGeometry, retained_start: u64) -> BootGeometryCheck {
    let checked: BootGeometryCheck = BootGeometry::check(mapped);
    transition checked {
        BootGeometryCheck::Ready { geometry } -> locate(geometry, retained_start)
        BootGeometryCheck::Rejected -> BootGeometryCheck::Rejected
    }

    machine locate(mapped: BootGeometry, retained_start: u64) -> BootGeometryCheck {
        transition retained_start > mapped.image_base {
            true -> partition(mapped, retained_start)
            _ -> BootGeometryCheck::Rejected
        }
    }

    machine partition(mapped: BootGeometry, retained_start: u64) -> BootGeometryCheck
    requires retained_start > mapped.image_base
    {
        let prefix: u64 = retained_start - mapped.image_base;
        let residual: BootGeometry = BootGeometry {
            image_base: mapped.image_base,
            image_length: prefix,
            storage_base: mapped.storage_base,
            storage_length: mapped.storage_length,
        };
        transition prefix < mapped.image_length {
            true -> (BootGeometry::check(residual))
            _ -> BootGeometryCheck::Rejected
        }
    }
}

// Expected exit: 0. Check separated, overlapping, empty and overflowing ranges.
// This validates numeric geometry only, not backing authority or UEFI handoff.

machine accepted(geometry: BootGeometry) -> bool {
    let checked: BootGeometryCheck = BootGeometry::check(geometry);
    transition checked {
        BootGeometryCheck::Rejected -> (false)
        BootGeometryCheck::Ready { geometry } -> (true)
    }
}

machine partition_matches(mapped: BootGeometry, retained_start: u64, expected_length: u64) -> bool {
    let checked: BootGeometryCheck = BootGeometry::exclude_image_suffix(mapped, retained_start);
    transition checked {
        BootGeometryCheck::Rejected -> (expected_length == 0)
        BootGeometryCheck::Ready { geometry } -> (
            expected_length != 0 && geometry.image_base == mapped.image_base &&
            geometry.image_length == expected_length &&
            geometry.storage_base == mapped.storage_base &&
            geometry.storage_length == mapped.storage_length
        )
    }
}

machine main() crashes Trap {
    let ordered: bool = accepted(BootGeometry { image_base: 4096, image_length: 4096, storage_base: 16384, storage_length: 8192 });
    let reversed: bool = accepted(BootGeometry { image_base: 16384, image_length: 8192, storage_base: 4096, storage_length: 4096 });
    let adjacent: bool = accepted(BootGeometry { image_base: 4096, image_length: 4096, storage_base: 8192, storage_length: 4096 });
    let reversed_adjacent: bool = accepted(BootGeometry { image_base: 8192, image_length: 4096, storage_base: 4096, storage_length: 4096 });
    let overlap: bool = accepted(BootGeometry { image_base: 4096, image_length: 8192, storage_base: 8192, storage_length: 4096 });
    let contained: bool = accepted(BootGeometry { image_base: 4096, image_length: 8192, storage_base: 8192, storage_length: 1024 });
    let equal: bool = accepted(BootGeometry { image_base: 4096, image_length: 4096, storage_base: 4096, storage_length: 4096 });
    let empty: bool = accepted(BootGeometry { image_base: 4096, image_length: 0, storage_base: 8192, storage_length: 4096 });
    let storage_empty: bool = accepted(BootGeometry { image_base: 4096, image_length: 4096, storage_base: 8192, storage_length: 0 });
    let wrapped: bool = accepted(BootGeometry { image_base: 18446744073709551615, image_length: 1, storage_base: 8192, storage_length: 4096 });
    let storage_wrapped: bool = accepted(BootGeometry { image_base: 4096, image_length: 4096, storage_base: 18446744073709551615, storage_length: 2 });
    let last_endpoint: bool = accepted(BootGeometry { image_base: 0, image_length: 4096, storage_base: 18446744073709551614, storage_length: 1 });
    transition ordered && reversed && adjacent && reversed_adjacent &&
        !overlap && !contained && !equal && !empty && !storage_empty &&
        !wrapped && !storage_wrapped && last_endpoint {
        true -> image_partition()
        _ -> wrong()
    }
    machine image_partition() {
        let mapped: BootGeometry = BootGeometry { image_base: 4096, image_length: 8192, storage_base: 16384, storage_length: 4096 };
        let middle: bool = partition_matches(mapped, 8192, 4096);
        let first: bool = partition_matches(mapped, 4097, 1);
        let last: bool = partition_matches(mapped, 12287, 8191);
        let before: bool = partition_matches(mapped, 4095, 0);
        let empty: bool = partition_matches(mapped, 4096, 0);
        let end: bool = partition_matches(mapped, 12288, 0);
        let beyond: bool = partition_matches(mapped, 12289, 0);
        let overlapping_tail: bool = partition_matches(BootGeometry {
            image_base: 4096, image_length: 8192, storage_base: 8192, storage_length: 4096
        }, 8192, 0);
        transition middle && first && last && before && empty && end && beyond && overlapping_tail {
            true -> done()
            _ -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
