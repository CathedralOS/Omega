// Expected exit: 0
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
data Cell { value: i32; }
data Message { body: &Cell; }
machine read(message: Message) -> i32 { message.body.value }
data Backing { values: [i32; 1]; }
data Slot<'storage> { source: &'storage [i32; 1]; }
machine replace<'storage>(slot: &mut Slot<'storage>, replacement: &'storage [i32; 1]) -> bool {
    slot.source = replacement;
    true
}
machine complete<'storage>(source: &'storage [i32; 1], changed: bool) -> &'storage Cell { source as &Cell }
machine main() reaches Scheduler crashes Trap {
    let first: Backing = Backing { values: [73] };
    let second: [i32; 1] = [11];
    let slot: Slot = Slot { source: &first.values };
    let reference: &Cell = complete(slot.source, replace(&mut slot, &second));
    let message: Message = Message { body: reference };
    let replacement: i32 = slot.source[0u64];
    suspend Scheduler::park();
    let observed: i32 = read(message);
    transition observed == 73 && replacement == 11 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
