// Expected exit: 0
// Selected<[Base, Base + 4]> at Base = 3 supplies at least seven before exact value - 7.
trait Reading<const Required: [u64; 2]> {
    machine read() -> u64 ensures result >= Required[1];
}
Selected<const Setting: [u64; 2]> satisfies Reading<Setting> {
    machine read() -> u64 ensures result == Setting[1] { Setting[1] }
}
machine selected<const Required: [u64; 2], Implementation satisfies Reading<Required>>() -> u64
{ Implementation::read() }
machine construct<const Base: u64>() -> u64
requires Base <= 100
ensures result >= Base + 4
{
    selected<([Base, Base + 4]), Selected<([Base, Base + 4])>>()
}
machine main() crashes Trap {
    let value: u64 = construct<3>();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
