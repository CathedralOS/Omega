// Renamed member lifetimes preserve the exact public evidence promise.
// Expected exit: 0
trait Reading<'borrow> {
    machine read(value: &'borrow i32) -> i32;
}
Reader<'held> satisfies Reading<'held> {
    machine read(value: &'held i32) -> i32 { value as i32 }
}
boundary trait SelectedReading {
    machine read<'required, 'other, Evidence satisfies Reading<'required>>(
        value: &'required i32, other: &'other i32
    ) -> i32 reaches;
}
SelectedReader satisfies SelectedReading {
    machine read<'supplied, 'unused, Evidence satisfies Reading<'supplied>>(
        value: &'supplied i32, other: &'unused i32
    ) -> i32 { value as i32 }
}
machine observe<'entry>(value: &'entry i32, other: &'entry i32) -> i32
reaches SelectedReading {
    SelectedReading::read<Reader<'entry>>(value, other)
}
data Storage { value: i32; neighbor: i32; }
machine Storage::run(storage: &mut Storage) reaches SelectedReading crashes Trap {
    storage.value = 37;
    storage.neighbor = 91;
    let answer: i32 = observe(&mut storage.value, &storage.neighbor);
    transition answer == 37 && storage.value == 37 && storage.neighbor == 91 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() reaches SelectedReading crashes Trap {
    let mut storage: Storage;
    Storage::run(&mut storage);
}
