// Expected exit: 0
// A granted vacant extent retains actual backing through transport, initialization, permitted writes, and extraction.
// Recurrent forwarding retains both allocation descriptors before their contents change.
use omega::language::core::extent;
use omega::language::core::content;
use omega::language::core::layout;
use omega::language::core::process_exit;
use omega::language::core::nat;


data TestMemory {}
public data Word { value: u32; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 };
    AccessPlan::with(AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported })
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

boundary trait NativeAllocation {
    machine allocate(count: u64, width: u64) -> addr reaches;
}
TestRoots satisfies ExtentRootProvider {
    machine grant(root: Extent) -> Extent { root }
}
TestVacant satisfies VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
        ensures result in Granted,
            core::Identity<IntervalSet<Nat>>(
                Granted::content(old(&storage)),
                Granted::content(&result)
            )
    { storage as Extent }
}

data Observed { storage: Extent in Granted & Vacant; value: u32; }

machine exchange_cell(storage: &mut Extent in Granted & Vacant, value: u32) -> u32
crashes Trap
{
    transition Access::view_extent_mut<WordPlacement, Word, TestMemory>(storage as &mut Extent in Granted) {
        AccessOutcome::Ready { view } -> change(view, value)
        AccessOutcome::Rejected { returned, reason } -> bad()
    }
    machine change(view: &mut Access<WordPlacement, Word>, value: u32) -> u32 {
        let previous: u32 = read(&view.value);
        write(&mut view.value, value);
        previous
    }
    machine bad() -> u32 { crash Trap; }
}

machine exchange(storage: Extent in Granted & Vacant, offset: u64, value: u32) -> Observed
requires storage.length >= 4, offset <= storage.length - 4
ensures result.storage.base == storage.base, result.storage.length == storage.length
crashes Trap
{
    let prefix: VacantExtentParts = split_vacant_extent(storage, offset);
    let element: VacantExtentParts = split_vacant_extent(prefix.rest, 4);
    let mut cell: Extent in Granted & Vacant = element.taken;
    let previous: u32 = exchange_cell(&mut cell, value);
    let suffix: Extent in Granted & Vacant = merge_vacant_extents(cell, element.rest);
    let whole: Extent in Granted & Vacant = merge_vacant_extents(prefix.taken, suffix);
    Observed { storage: whole, value: previous }
}

data BackingPair {
    first: Extent in Granted & Vacant;
    second: Extent in Granted & Vacant;
}

machine carry_pair(first: Extent in Granted & Vacant, second: Extent in Granted & Vacant,
    remaining: u64) -> BackingPair
ensures result.first.base == first.base, result.first.length == first.length,
    result.second.base == second.base, result.second.length == second.length
terminates by remaining
{
    transition remaining > 0 {
        true -> carry_pair(first, second, remaining - 1)
        false -> BackingPair { first: first, second: second }
    }
}

machine main() crashes Trap {
    let address: addr = NativeAllocation::allocate(1, 48);
    transition address != 0 { true -> allocated(address) false -> bad() }
    machine allocated(address: addr) {
        let grant: Extent in Granted = ExtentRootProvider::grant(Extent { base: address, length: 48 });
        let storage: Extent in Granted & Vacant = VacantContentTransfer::transfer(grant);
        transition storage.length == 48 { true -> exercise(storage) false -> bad() }
    }
    machine exercise(storage: Extent in Granted & Vacant)
    requires storage.length == 48 {
        let parts: VacantExtentParts = split_vacant_extent(storage, 16);
        let immediate: BackingPair = carry_pair(parts.taken, parts.rest, 0);
        let repeated: BackingPair = carry_pair(immediate.first, immediate.second, 3);
        let restored: Extent in Granted & Vacant = merge_vacant_extents(repeated.first, repeated.second);
        let base: addr = restored.base;
        let zero: Observed = exchange(restored, 0, 11);
        let first: Observed = exchange(zero.storage, 8, 73);
        let second: Observed = exchange(first.storage, 8, 97);
        let neighbor: Observed = exchange(second.storage, 12, 41);
        let third: Observed = exchange(neighbor.storage, 8, 101);
        let fourth: Observed = exchange(third.storage, 0, 13);
        transition zero.value == 0 && first.value == 0 && second.value == 73 && neighbor.value == 0 && third.value == 97 && fourth.value == 11 && fourth.storage.base == base && fourth.storage.length == 48 {
            true -> finish(fourth.storage)
            false -> bad()
        }
    }
    machine finish(storage: Extent in Granted & Vacant) { ProcessExit::exit_process(0); }
    machine bad() { crash Trap; }
}
