// The operator's declared home: bare primitive operands would join the
// core's primitive operator family, which only the core may publish.
domain u64::Marker;
boundary machine == Integer::touch(value: &mut u64, marker: u64 in Marker) -> bool;
data Writer {}
machine Writer::touch(value: &mut u64, marker: u64 in Marker) -> bool satisfies Integer::touch { value = marker; true }
machine keep(mut index: u64) -> u8 requires index < 4 {
    let items: [u8; 4] = [4, 7, 8, 9];
    let other: u64 = 1;
    let flag: bool = Integer::touch(&mut other, 9);
    items[index]
}
machine main() { let result: u8 = keep(1); }
