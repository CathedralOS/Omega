// Fact: a selected const call establishes Capacity=2 before an exact array equation and inferred consumer tuple.
// Expected exit: 0
data Ready [copy] requires value <= 7 { value: u64; }
const READY: Ready = Ready { value: 7 };
machine extent() -> u64 { 2 }
data IndexedPacket<Value [copy], const Capacity: u64> [copy]
{ items: Value; }
const ITEMS: IndexedPacket<[u8; 2], extent()> = IndexedPacket { items: [7, 11] };
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
requires Length == [u8; Capacity]
{ Capacity }
data Envelope<Value [copy]> [copy] { value: Value; }
machine forward<Value [copy]>(value: Value) -> Envelope<Value> { Envelope { value: value } }
trait SizedHook<const Count: u64> { machine read(items: [u8; Count]) -> u64; }
machine consume(items: [u8; 2]) -> u64 satisfies SizedHook<extent()>::read {
    capacity(items)
}
machine main() crashes Trap {
    let observed: u64 = consume(forward(ITEMS).value.items);
    transition observed == 2 && READY.value == 7 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
