// Expected exit: 0
// Borrowing the case view keeps its payload and the original backing intact.
data Message [copy] {
    stamp: u64;
    case Received(value: u64);
    case Empty;
}

machine inspect(message: &Message) -> u64 {
    match message {
        Message { stamp as _, case as operation } -> match &operation {
            Message::Received { value } -> value
            _ -> 99
        }
    }
}

// A final match completes Unit work on the selected arm only.
machine record(selected: bool, observed: &mut u64) {
    match selected {
        true -> write_observation(observed, 17)
        false -> write_observation(observed, 29)
    }
}
machine write_observation(observed: &mut u64, value: u64) {
    observed = value;
}

machine main() crashes Trap {
    let received: Message = Message::Received { stamp: 11, value: 7 };
    let empty: Message = Message::Empty { stamp: 19 };
    let payload: u64 = inspect(&received);
    let fallback: u64 = inspect(&empty);
    let matching: u64 = 3;
    let mut remaining: u64 = 5;
    record(true, &mut matching);
    record(false, &mut remaining);
    transition payload == 7 && fallback == 99 && received.stamp == 11 && empty.stamp == 19
        && matching == 17 && remaining == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
