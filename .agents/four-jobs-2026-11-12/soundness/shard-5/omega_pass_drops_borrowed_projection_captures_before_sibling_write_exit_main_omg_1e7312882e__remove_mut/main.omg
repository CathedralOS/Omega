data Seed [copy] { code: u64; }
data Receipt [linear] dropped by drop_receipt { code: u64; }
machine drop_receipt(receipt: &mut Receipt) requires receipt.code == 7 {}
data Pair dropped by drop_pair { first: Receipt; second: Receipt; }
machine drop_pair(pair: &mut Pair) {}
machine observe(receipt: &Receipt) {}
machine produced() -> Seed ensures result.code == 7 { Seed { code: 7 } }
machine clear(seed: &mut Seed) -> Receipt ensures result.code == 7 {
    seed.code = 0;
    Receipt { code: 7 }
}
machine main() {
    let seed: Seed = produced();
    observe(&Pair {
        first: Receipt { code: seed.code }, second: clear(&mut seed)
    }.first);
}
