// An erasing cast drops only the whole value's issued meaning. The copy
// keeps what was known about its fields, so a later write to `t` does not
// change what `u.number` satisfies.
// Expected exit: 0.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
domain u64::Big requires self > 20;
machine need(n: u64 in Big) -> u64 { n }
machine main() crashes Trap {
    let t: Ticket in Ticket::Held = issue();
    t.number = 30;
    let u: Ticket = t as Ticket;
    t.number = 5;
    let r: u64 = need(u.number);
    transition r == 30 && t.number == 5 { true -> good() _ -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}
