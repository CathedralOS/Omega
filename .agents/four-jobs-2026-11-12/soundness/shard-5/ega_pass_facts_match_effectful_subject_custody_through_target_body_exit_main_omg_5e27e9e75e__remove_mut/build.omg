machine build(builder: &mut Build) {
    Build::application(builder, "match_effectful_subject_custody_through_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedApply, X86Apply>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedApply, ArmApply>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedApply, ArmApply>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedApply, X86Apply>(builder, windows_x86_64);
}
