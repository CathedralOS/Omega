// A returned write-only loan permits replacing caller storage 7 with 42 while preserving neighboring 19.
// Expected exit: 0.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedLendWrite {
    machine lend_write(destination: &write i32) -> &write i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86LendWrite satisfies SelectedLendWrite {
    machine lend_write(destination: &write i32) -> &write i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        &write destination
    }
}
ArmLendWrite satisfies SelectedLendWrite {
    machine lend_write(destination: &write i32) -> &write i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        &write destination
    }
}
machine main() crashes Trap {
 let value: i32 = 7;
 let neighbor: i32 = 19;
 let destination: &write i32 = SelectedLendWrite::lend_write(&write value);
 destination = 42;
 transition value == 42 && neighbor == 19 { true -> done() false -> wrong() }
 machine done() {} machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
