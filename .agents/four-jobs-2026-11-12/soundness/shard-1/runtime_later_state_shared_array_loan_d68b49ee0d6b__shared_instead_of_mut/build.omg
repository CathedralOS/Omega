// Deployable native canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_later_state_shared_array_loan");
    Build::bind(builder, windows_x86_64::ProgramEntry, Workshop::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Workshop::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Workshop::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Workshop::main);
}
