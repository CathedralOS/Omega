use omega::language::core::drop;

data Token [linear] dropped by drop_token { value: u64; }
data Holder { guard: u64; token: Token; }
machine drop_token(token: &mut Token) {}

machine abandon(token: &mut Token) -> u64 crashes Trap {
    let retained: &mut Token = token;
    let detached: Token = retained;
    // A scalar result type does not create a return value on the crash path.
    crash Trap;
}

machine main() crashes Trap {
    let : Holder = Holder { guard: 19, token: Token { value: 41 } };
    let unreachable: u64 = abandon(&mut holder.token);
    let remaining: Token = holder.token;
    drop(remaining);
}
