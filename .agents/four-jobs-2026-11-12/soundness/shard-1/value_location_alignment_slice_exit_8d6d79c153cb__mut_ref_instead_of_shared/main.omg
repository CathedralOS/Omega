// Fact: align_of(value) observes the storage location of a live u64 place, the referent of a &mutu64, or the first element of a nonempty [u64] slice, and reports that location's guaranteed alignment, at least 8u64 on every hosted target, discharging exact subtraction alignment - 8u64 across all nine places.
// Place: borrowed slice parameter. The query observes the first element of a slice whose contract proves it nonempty.
// Expected exit: 0

machine first_slack(items: &[u64]) -> u64
requires items.len >= 1
{
    let alignment: u64 = align_of(items);
    alignment - 8u64
}

machine first_tag_alignment(tags: &[u8]) -> u64
requires tags.len >= 1
{
    align_of(tags)
}

machine main() crashes Trap {
    let items: [u64; 3] = [5u64, 6u64, 7u64];
    let tags: [u8; 2] = [1u8, 2u8];
    let slack: u64 = first_slack(&items[..]);
    let tag_alignment: u64 = first_tag_alignment(&tags[..]);
    transition slack == 0u64 && tag_alignment == 1u64 && items[0] == 5u64 && items[2] == 7u64 && tags[1] == 2u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
