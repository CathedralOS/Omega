use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::application(builder, "foreign_reference_result_match_join");
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::bind<Memory::fill>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memset" } });
 Build::bind<Memory::fill>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "memset", version: "GLIBC_2.2.5" } });
 Build::bind<Memory::fill>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "memset", version: "GLIBC_2.17" } });
 Build::bind<Memory::fill>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "api-ms-win-crt-string-l1-1-0.dll", export: "memset" } });
}
