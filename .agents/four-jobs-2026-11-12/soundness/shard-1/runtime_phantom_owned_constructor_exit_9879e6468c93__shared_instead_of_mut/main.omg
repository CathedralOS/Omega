// Expected exit: 0
// A constructor retains its exact generic application while receiving nested
// owned values; expected types do not establish the record's predicate.
data Token [linear] dropped by finish_token { value: u64; }
machine finish_token(token: & Token) {}

data Owner<P, T> [linear] dropped by finish_owner<P, T>
requires self.count == 1
{
    prefix: u64;
    token: Token;
    count: u64;
    suffix: u64;
}
machine finish_owner<P, T>(owner: &mut Owner<P, T>) {}

machine make<P, T>(value: u64) -> Owner<P, T> {
    Owner { prefix: 101, token: Token { value: value }, count: 1, suffix: 103 }
}

machine consume<P, T>(owner: Owner<P, T>) -> u64 crashes Trap {
    let count: u64 = owner.count;
    let value: u64 = owner.token.value;
    transition count == 1 && owner.prefix == 101 && owner.suffix == 103 {
        true -> value
        _ -> bad()
    }
    machine bad() -> u64 { crash Trap; }
}

machine inline_owner<A, B>(value: u64) -> u64 crashes Trap {
    consume<A, B>(Owner {
        prefix: 101, token: Token { value: value }, count: 1, suffix: 103
    })
}

machine main() crashes Trap {
    let first: u64 = consume<u8, bool>(make<u8, bool>(17));
    let second: u64 = consume<bool, u32>(make<bool, u32>(91));
    let third: u64 = inline_owner<u8, bool>(29);
    let fourth: u64 = inline_owner<bool, u32>(73);
    transition first == 17 && second == 91 && third == 29 && fourth == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
