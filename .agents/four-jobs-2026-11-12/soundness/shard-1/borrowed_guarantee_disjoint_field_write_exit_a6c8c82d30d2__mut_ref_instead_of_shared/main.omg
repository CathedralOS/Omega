// Expected exit: 0
// A disjoint field write preserves the exact guarantee of a completed borrow.
data Amount { value: u64; }
data Reply { value: u64; tag: u64; }
data Envelope { cell: Amount; marker: u64; }
data CycleTrace { before: u64; visits: u64 in Wrapping; tag: u64; after: u64; }
machine set(cell: &mutmut Amount, tag: u64) -> Reply
ensures cell.value == 32, result.value == 16, result.tag == tag {
    cell.value = 32;
    Reply { value: 16, tag: tag }
}
machine consume(cell: Amount, first: Reply) -> bool
requires cell.value == 32, first.value == 16 {
    cell.value == 32 && first.value == 16
}
machine direct() -> bool {
    let mut envelope: Envelope = Envelope { cell: Amount { value: 48 }, marker: 29 };
    let held: &mut u64 = &mut envelope.marker;
    let first: Reply = set(&mut envelope.cell, 37);
    held = 73;
    let tag_correct: bool = first.tag == 37;
    consume(envelope.cell, first) && envelope.marker == 73 && tag_correct
}
machine selected(select: bool, inner: bool, expected_tag: u64) -> bool {
    let mut envelope: Envelope = Envelope { cell: Amount { value: 48 }, marker: 29 };
    let held: &mut u64 = &mut envelope.marker;
    let first: Reply = match select {
        true -> match inner {
            true -> set(&mut envelope.cell, 41),
            false -> set(&mut envelope.cell, 43),
        },
        false -> set(&mut envelope.cell, 47),
    };
    held = 73;
    let tag_correct: bool = first.tag == expected_tag;
    consume(envelope.cell, first) && envelope.marker == 73 && tag_correct
}
machine refresh(cell: &mut Amount, trace: &mut CycleTrace, tag: u64) -> u64
ensures cell.value == 32, result == 0 {
    cell.value = 32;
    trace.visits = trace.visits + 1;
    trace.tag = tag;
    0
}
machine cycle(cell: &mut Amount, trace: &mut CycleTrace, select: bool, count: u64) -> bool
requires cell.value == 32
ensures cell.value == 32 {
    transition { _ -> again(cell, trace, select, count) }
    machine again(cell: &mut Amount, trace: &mut CycleTrace, select: bool, count: u64) -> bool
    requires cell.value == 32 {
        // Count every refresh and retain its branch tag for the caller.
        cell.value = 31;
        let zero: u64 = match select {
            true -> refresh(cell, trace, 53),
            false -> refresh(cell, trace, 59),
        };
        transition count == 0 { true -> complete(cell, zero) _ -> again(cell, trace, !select, count - 1) }
    }
    machine complete(cell: &mut Amount, zero: u64) -> bool
    requires cell.value == 32, zero == 0 {
        cell.value == 32 && zero == 0
    }
}
machine repeated(select: bool, expected_visits: u64, expected_tag: u64) -> bool {
    let mut cell: Amount = Amount { value: 32 };
    let mut trace: CycleTrace = CycleTrace { before: 61, visits: 0, tag: 71, after: 67 };
    let correct: bool = cycle(&mut cell, &mut trace, select, 3);
    let visits: u64 = trace.visits as u64;
    correct && cell.value == 32 && visits == expected_visits && trace.tag == expected_tag
        && trace.before == 61 && trace.after == 67
}
machine main() crashes Trap {
    let correct: bool = direct() && selected(true, true, 41) && selected(true, false, 43)
        && selected(false, true, 47) && selected(false, false, 47) && repeated(true, 4, 59) && repeated(false, 4, 53);
    transition correct { true -> done() _ -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
