machine build(builder: &mut Build) {
    Build::application(builder, "generic_requirement_statement_call_field");
    Build::select_provider<Mark, Counting>(builder, linux_x86_64);
    Build::select_provider<Mark, Counting>(builder, linux_arm64);
    Build::select_provider<Mark, Counting>(builder, macos_arm64);
    Build::select_provider<Mark, Counting>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
