// PASS CANARY. `walk` issues `audit(main, remaining)` before its recursive
// edge. The checked-body callee's complete write frame covers only
// `main.audits`, disjoint from every premise carrier (`remaining` and the
// pinned `ceiling`), so the entry-relative rank still describes the
// transition actuals.
data Main { audits: u64 }

machine main(main: & Main) -> u32 {
    transition { _ -> walk(main, 4, 9) }
}

machine audit(main: &mut Main, value: u32) {
    main.audits = 0;
}

machine walk(main: &mut Main, remaining: u32, ceiling: u32) -> u32
requires
    5 <= ceiling && ceiling <= 10,
    remaining <= ceiling
terminates by remaining in 0..=ceiling {
    audit(main, remaining);
    transition remaining > 0 {
        true -> walk(main, remaining - 1, ceiling)
        false -> remaining
    }
}
