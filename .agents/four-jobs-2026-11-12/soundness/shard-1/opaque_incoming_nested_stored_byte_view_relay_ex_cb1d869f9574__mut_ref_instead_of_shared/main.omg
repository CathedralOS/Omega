// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: call_result. `relay` publishes no `ensures`, but it returns its
// argument unchanged and the call substitutes that exact actual, so the
// one-byte extent `observe` requires survives the call. This was a reject
// fixture expecting the uncontracted call to hide the extent.
// Expected exit: 0
data Bundle<'storage> { windows: [&'storage mut [u8]; 1]; }
data Wrapper<'bundle, 'storage> { bundle: &'bundle Bundle<'storage>; }
machine observe(wrapper: &mutWrapper) -> bool
requires wrapper.bundle.windows[0].len == 1
{
    wrapper.bundle.windows[0].len == 1 && wrapper.bundle.windows[0][0] == 19
}
machine relay<'bundle, 'storage>(wrapper: Wrapper<'bundle, 'storage>) -> Wrapper<'bundle, 'storage>
{ wrapper }
machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let bundle: Bundle = Bundle { windows: [&mut backing[..]] };
    let wrapper: Wrapper = Wrapper { bundle: &bundle };
    let selected: Wrapper = relay(wrapper);
    let observed: bool = observe(&selected);
    transition observed { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
