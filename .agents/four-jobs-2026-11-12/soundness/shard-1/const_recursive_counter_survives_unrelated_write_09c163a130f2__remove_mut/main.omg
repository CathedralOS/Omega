// Expected exit: 0
// An unrelated call and record write preserve the recursion counter.
data Audit { left: u64; value: u64; right: u64; }
machine identity(value: u64) -> u64 { value }
machine count(remaining: u64) -> u64
terminates by remaining {
    transition { _ -> forward(remaining) }
    machine forward(pending: u64) -> u64 {
        let : Audit = Audit { left: 41, value: 0, right: 67 };
        audit.value = identity(7);
        transition pending > 0 {
            true -> count(pending - 1)
            false -> finish(audit)
        }
    }
    machine finish(audit: Audit) -> u64 {
        match audit.left == 41 && audit.right == 67 {
            true -> audit.value
            false -> 1
        }
    }
}
machine extent() -> u64 { count(5) }
data Observed { bytes: [u8; extent()]; }
machine main() crashes Trap {
    let mut observed: Observed;
    transition observed.bytes.len == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
