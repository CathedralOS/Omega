machine build(builder: &mut Build) {
    Build::application(builder, "runtime_clock_out_parameter_loans_exit");
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, linux_arm64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, linux_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, macos_arm64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, macos_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, windows_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, uefi_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, cross_platform_cli);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, local_unchecked);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
