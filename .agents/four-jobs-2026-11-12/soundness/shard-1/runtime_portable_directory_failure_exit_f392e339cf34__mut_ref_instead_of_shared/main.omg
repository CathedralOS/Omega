// Expected exit: 0. A traversal deeper than the bounded stack fails closed,
// releases every acquired descriptor, and leaves the unvisited subtree intact.
use omega_language_std::filesystem;
use omega_language_std::console;
data Main {
    filesystem: Filesystem;
    acquisitions: [File; 17];
    acquisition_count: u64 in Wrapping;
    release_index: u64 in Wrapping;
}
machine Main::main(main: &mutmut Main) reaches Console + DirectoryEnumeration + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let result: UnitResult = block Filesystem::create_dir_all(&mut main.filesystem, "omega_directory_depth/a/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q");
    transition result { UnitResult::Ok -> block refuse(main) _ -> bad(10) }
    machine refuse(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove_dir_all(&mut main.filesystem, "omega_directory_depth");
        transition result { UnitResult::Error { kind } -> block released(main) _ -> bad(11) }
    }
    machine released(main: &mut Main) {
        // Keep all 17 acquisitions live: merely reopening descriptor 3 would
        // not detect a leak of a higher stack slot or the unpushed child.
        transition main.acquisition_count < 17 { true -> block acquire(main) _ -> block release_batch(main) }
    }
    machine acquire(main: &mut Main) {
        let result: OpenResult = block Filesystem::open(&mut main.filesystem, "/dev/null");
        transition result { OpenResult::Ok { file } -> block acquired(main, file) _ -> bad(12) }
    }
    machine acquired(main: &mut Main, file: File) {
        transition main.acquisition_count < 17 && file.handle == ((main.acquisition_count + 4) as u64) {
            true -> block store(main, file) _ -> bad(12)
        }
    }
    machine store(main: &mut Main, file: File) {
        main.acquisitions[main.acquisition_count] = file;
        main.acquisition_count = main.acquisition_count + 1;
        transition { _ -> block released(main) }
    }
    machine release_batch(main: &mut Main) {
        transition main.release_index < 17 { true -> block release_one(main) _ -> block intact(main) }
    }
    machine release_one(main: &mut Main) {
        let file: File = main.acquisitions[main.release_index];
        let result: UnitResult = block Filesystem::close(&mut main.filesystem, file);
        transition result { UnitResult::Ok -> block next_release(main) _ -> bad(12) }
    }
    machine next_release(main: &mut Main) {
        main.release_index = main.release_index + 1;
        transition { _ -> block release_batch(main) }
    }
    machine intact(main: &mut Main) {
        let present: bool = block Filesystem::exists(&mut main.filesystem, "omega_directory_depth/a/b/c/d/e/f/g/h/i/j/k/l/m/n/o/p/q");
        transition present { true -> block subtree(main) _ -> bad(13) }
    }
    machine subtree(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove_dir_all(&mut main.filesystem, "omega_directory_depth/a/b/c");
        transition result { UnitResult::Ok -> block cleanup(main) _ -> bad(14) }
    }
    machine cleanup(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove_dir_all(&mut main.filesystem, "omega_directory_depth");
        transition result { UnitResult::Ok -> good() _ -> bad(15) }
    }
    machine good() { Console::exit_process(0); }
    machine bad(code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + DirectoryEnumeration + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
