// Fact: a crash-entry u64 equal to 7 reached through a field of a field discharges maybe_zero's value == 0 Trap crash guard without a caller crash ceiling.
// Expected exit: 0
machine maybe_zero(value: u64) -> u64
crashes Trap value == 0
{
    transition value == 0 { true -> bad() false -> (value) }
    machine bad() -> u64 { crash Trap; }
}
public data Leaf { bits: u64; marker: u64; }
public data Packet { leaf: Leaf; tag: u64; }

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedForward {
    machine forward(value: u64) -> u64 reaches crashes Trap value == 0;
}
X86Forward satisfies SelectedForward {
    machine forward(value: u64) -> u64
    crashes Trap value == 0
    {
        maybe_zero(value)
    }
}
ArmForward satisfies SelectedForward {
    machine forward(value: u64) -> u64
    crashes Trap value == 0
    {
        maybe_zero(value)
    }
}
public machine read_bits(packet: &mutPacket) -> u64
reaches SelectedForward invokes SelectedForward
requires packet.leaf.bits == 7
{
    let observed: u64 = packet.leaf.bits;
    SelectedForward::forward(observed)
}
machine main() crashes Trap {
    let packet: Packet = Packet { leaf: Leaf { bits: 7, marker: 3 }, tag: 11 };
    let observed: u64 = read_bits(&packet);
    transition observed == 7 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
