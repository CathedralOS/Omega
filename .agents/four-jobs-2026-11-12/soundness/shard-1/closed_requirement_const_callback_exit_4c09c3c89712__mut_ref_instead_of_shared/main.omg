// Expected exit: 0
// A selected implementation calls the supplied reader with fixed array lengths.
public boundary trait Reader<T> { machine read(value: &mutT) -> u64 reaches; }
machine read(value: &u64) -> u64 satisfies Reader<u64>::read { value }
public boundary trait Runner<T> {
    machine run<machine Read, const First: u64, const Second: u64>(
        value: &T, first: &[u8; First], second: &[u8; Second]
    ) -> u64
    requires machine Read satisfies Reader<T>::read;
    requires First >= 1 && First <= 8192 && Second >= 1 && Second <= 8192
    reaches invokes Reader;
}
public Selected satisfies Runner<u64> {
    machine run<machine Read, const First: u64, const Second: u64>(
        value: &u64, first: &[u8; First], second: &[u8; Second]
    ) -> u64
    requires machine Read satisfies Reader<u64>::read;
    requires First >= 1 && First <= 8192 && Second >= 1 && Second <= 8192
    { Read(value) }
}
machine main() reaches Runner crashes Trap {
    let first: [u8; 5];
    let second: [u8; 4096];
    let value: u64 = 37;
    let other: u64 = 91;
    let a: u64 = Runner<u64>::run<read, 5, 4096>(&value, &first, &second);
    let b: u64 = Runner<u64>::run<read, 5, 4096>(&other, &first, &second);
    transition a == 37 && b == 91 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
