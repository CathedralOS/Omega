// The shared Seed.ready == true observation survives each place into make_token(&mutseed), whose completed result is ready for normal shared-call cleanup.
// Expected exit: 0
data Seed [copy] { ready: bool; }
data Token dropped by drop_token { ready: bool; value: u64; }
machine drop_token(token: &mut Token)
requires token.ready { token.ready = false; }
machine make_token(seed: &Seed) -> Token
ensures result.ready == seed.ready { Token { ready: seed.ready, value: 7 } }
machine read(token: &Token) -> u64 { token.value }
machine through_parameter(seed: Seed) -> u64
requires seed.ready { read(&make_token(&seed)) }
machine main() crashes Trap {
    let answer: u64 = through_parameter(Seed { ready: true });
    transition answer == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
