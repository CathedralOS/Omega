// seq_map_filter build file: depend-free compile-scope probe — no
// standard-library package, so no ProcessExit authority; compile-checked
// only (same posture as cli/basics/standalone). `Seq<T>` is recursive by
// value, so it has no finite runtime representation and stays proof-only
// (wiki/spec/proofs/contracts.md, "Recursive mathematical data without a
// finite runtime representation remain proof-only"): no program entry is
// bound.

machine build(builder: &mut Build) {
    Build::application(builder, "seq_map_filter");
    builder.freestanding = true;
}
