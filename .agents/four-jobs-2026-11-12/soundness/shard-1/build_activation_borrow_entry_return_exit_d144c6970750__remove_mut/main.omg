// A borrowed configuration preserves exclusive access to the original Build activation, so binding through its stored view selects the authored entry without copying or replacing the activation.
// Composition: a call mutates the selected original Cell before returning its loan to the host.
// Expected exit: 0
data Cell { before: u64; value: u64; after: u64; }
data Carrier<'storage> { cell: &'storage mut Cell; }
machine selected<'storage>(left: &'storage mut Cell, right: &'storage mut Cell, first: bool) -> Carrier<'storage> {
    transition first {
        true -> Carrier { cell: left }
        false -> Carrier { cell: right }
    }
}
machine update(carrier: &mut Carrier, incoming: u64) { carrier.cell.value = incoming; }
machine apply(carrier: &mut Carrier) -> bool {
    update(carrier, 41);
    let observed: bool = carrier.cell.value == 41;
    update(carrier, 73);
    observed
}
machine host_selected<'storage>(left: &'storage mut Cell, right: &'storage mut Cell, first: bool) -> Carrier<'storage> {
    let : Carrier = selected(left, right, first);
    update(&mut carrier, 41);
    carrier
}
data OptionalCarrier<'storage> { case Present(carrier: Carrier<'storage>); case Missing; }
machine host_optional<'storage>(left: &'storage mut Cell, right: &'storage mut Cell, present: bool) -> OptionalCarrier<'storage> {
    transition present {
        true -> OptionalCarrier::Present { carrier: host_selected(left, right, true) }
        false -> OptionalCarrier::Missing
    }
}
data WriteCarrier<'storage> { cell: &'storage write Cell; }
machine host_write_only<'storage>(left: &'storage mut Cell, right: &'storage mut Cell, first: bool) -> WriteCarrier<'storage> {
    transition first {
        true -> WriteCarrier { cell: &write left }
        false -> WriteCarrier { cell: &write right }
    }
}
machine journey(left: &mut Cell, right: &mut Cell, first: bool) -> bool {
    let mut carrier: Carrier = host_selected(left, right, first);
    let observed: bool = carrier.cell.value == 41;
    update(&mut carrier, 73);
    observed
}
machine main() crashes Trap {
    let mut left: Cell = Cell { before: 11, value: 5, after: 17 };
    let mut right: Cell = Cell { before: 23, value: 9, after: 29 };
    let first: bool = journey(&mut left, &mut right, true);
    let first_correct: bool = first && left.value == 73 && right.value == 9
        && left.before == 11 && left.after == 17 && right.before == 23 && right.after == 29;
    let second: bool = journey(&mut left, &mut right, false);
    transition first_correct && second && left.value == 73 && right.value == 73
        && left.before == 11 && left.after == 17 && right.before == 23 && right.after == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
