use omega::language::core::drop;
// The owner hook body is an ordinary Unit machine: it reads and writes
// its subject, calls helpers with arguments, repeats calls, and reaches
// nested helpers — all on the contextual cleanup edge at scope exit.
machine sweep() {
}
data Ledger {}
machine Ledger::note(amount: i32) {
}
machine Ledger::trace() {
    sweep();
}
data Guard dropped by drop_guard {
    handle: i32;
}
machine drop_guard(guard: &mutmut Guard) {
    Ledger::note(guard.handle);
    Ledger::trace();
    Ledger::trace();
    guard.handle = 0;
}
machine main() {
    let g: Guard = Guard { handle: 7 };
    let explicit: Guard = Guard { handle: 8 };
    drop(explicit);
}
