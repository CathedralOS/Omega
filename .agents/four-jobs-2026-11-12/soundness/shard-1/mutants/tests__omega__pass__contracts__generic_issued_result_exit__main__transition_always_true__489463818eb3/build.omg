machine build(builder: &mut Build) {
    Build::application(builder, "selected_issued_result");
    Build::accept_boundary<Supply>(builder);
    Build::select_provider<Supply<Word>, Provider>(builder, windows_x86_64);
    Build::select_provider<Supply<Word>, Provider>(builder, linux_x86_64);
    Build::select_provider<Supply<Word>, Provider>(builder, macos_arm64);
    Build::select_provider<Supply<Word>, Provider>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
