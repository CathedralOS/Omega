// Expected exit: 0
// A private forwarding helper keeps the selected Reader's public crash condition.
public const Zero: i32 = 0;
public trait Reader<const Limit: i32> {
    machine read(value: i32) -> i32 crashes Trap value < Limit;
}
Provider satisfies Reader<Zero> {
    machine read(value: i32) -> i32 { value }
}
machine forward<Implementation satisfies Reader<Zero>>(value: i32) -> i32
{ Implementation::read(value) }
public machine safe(value: i32) -> i32
requires value > 0
{ forward<Provider>(value) }
machine main() crashes Trap {
    let observed: i32 = safe(7);
    transition observed == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
