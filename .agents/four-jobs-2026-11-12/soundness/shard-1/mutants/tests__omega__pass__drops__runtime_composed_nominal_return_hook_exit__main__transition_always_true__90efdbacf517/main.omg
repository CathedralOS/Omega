data Token dropped by drop_token { value: u64; }

machine drop_token(token: &mut Token) {
    transition { _ -> finish(token) }
    machine finish(token: &mut Token) { token.value = 0; }
}

machine evaluate() -> u64 {
    let token: Token = Token { value: 7 };
    // Materialize the outgoing scalar before the composed hook changes its
    // owner. Cleanup before this read would change the authored result.
    token.value
}

machine main() crashes Trap {
    let answer: u64 = evaluate();
    transition true {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
