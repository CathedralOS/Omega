// Dispatching a trait method through a dynamic trait carrier (dyn / trait conformance) whose contract establishes result <= 88u64 preserves the return bound across the selector and data lanes, discharging exact subtraction 88u64 - result.
// Expected exit: 0
trait PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 88u64;
}

ActualEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 88u64
    {
        transition true { true -> 38u64 _ -> 28u64 }
    }
}

machine alternate_value(base: u64) -> u64
ensures result <= 88u64
{
    transition base == 10u64 { true -> 48u64 _ -> 58u64 }
}

AlternateEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 88u64
    { alternate_value(base) }
}

machine forward(selector: dyn PayloadEvaluator, base: u64) -> u64 {
    let result: u64 = PayloadEvaluator::compute(selector, base);
    88u64 - result
}

machine main() crashes Trap {
    let first: dyn PayloadEvaluator = ActualEvaluator as dyn PayloadEvaluator;
    let second: dyn PayloadEvaluator = AlternateEvaluator as dyn PayloadEvaluator;
    let first_at_ten: u64 = forward(first, 10u64);
    let first_at_twenty: u64 = forward(first, 20u64);
    let second_at_ten: u64 = forward(second, 10u64);
    let second_at_twenty: u64 = forward(second, 20u64);
    transition first_at_ten == 50u64 && first_at_twenty == 60u64
        && second_at_ten == 40u64 && second_at_twenty == 30u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
