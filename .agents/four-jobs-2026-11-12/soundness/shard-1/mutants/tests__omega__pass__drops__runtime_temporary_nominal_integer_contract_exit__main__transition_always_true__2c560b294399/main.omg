data Token dropped by drop_token { value: u64; }
machine drop_token(token: &mut Token)
requires token.value == 7
{
    token.value = 0;
}
machine read(token: &Token) -> u64 { token.value }
machine main() crashes Trap {
    let answer: u64 = read(&Token { value: 7 });
    transition true {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
