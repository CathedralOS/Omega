// A callee dispatches on a requires-bounded parameter: `check(n)`
// declares `n <= 5`, then `transition true { answer: u64; }

machine Main::check(n: u64) -> u64
requires n <= 5
{
    transition n {
        5 -> top()
        _ -> low()
    }
    machine top() -> u64 { 70 }
    machine low() -> u64 { 71 }
}

machine Main::main(main: &mut Main) {
    main.answer = Main::check(5);
}
