machine build(builder: @mut Build) {
    Build::member(builder, "source/library/std");
    Build::member(builder, "source/library/alloc");
    Build::member(builder, "source/foundation/wire");
    Build::member(builder, "source/subsystems/compiler/source_to_psi");
    Build::member(builder, "source/subsystems/compiler/alpha");
    Build::member(builder, "source/subsystems/compiler/driver");
    Build::member(builder, "source/subsystems/compiler/request");
    Build::member(builder, "source/application/construction");
    Build::member(builder, "source/application/ocreq");
}
