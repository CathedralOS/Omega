use {omega}/build/workspace.omg;

machine build(plan: @mutable BuildPlan) {
    let mutable members: WorkspaceMembers = WorkspaceMembers {};
    members = |workspace|::with_member(plan, members, "source/library/system");
    members = |workspace|::with_member(plan, members, "source/library/allocation");
    members = |workspace|::with_member(plan, members, "source/library/simd");
    members = |workspace|::with_member(plan, members, "source/foundation/wire");
    members = |workspace|::with_member(plan, members, "source/subsystems/compiler/source_to_psi");
    members = |workspace|::with_member(plan, members, "source/subsystems/compiler/alpha");
    members = |workspace|::with_member(plan, members, "source/subsystems/compiler/driver");
    members = |workspace|::with_member(plan, members, "source/subsystems/compiler/request");
    members = |workspace|::with_member(plan, members, "source/application/construction");
    members = |workspace|::with_member(plan, members, "source/application/ocreq");
    plan.product = BuildProduct::Workspace { members: members };
}
