// LAYOUT POLICIES (chapter 19/20; design_briefs/programmable_layouts.md):
// layout is a library, not a language axiom. A policy is ordinary data
// satisfying `Layout`; its `plan(schema)` machine runs at BUILD TIME (no
// keyword -- the position makes the evaluation build-time, the effect system
// makes it legal, and this trait's effect-free signature is the stability
// contract). The compiler materializes `Schema` from a data definition,
// validates the returned `Plan` (a bad plan is a compile error, never
// unsafety), and derives codecs / projections / value types from it.
//
// v1 SHAPES: plan entries carry compiler-issued field keys rather than using
// array position as identity. Repeating a key permits fragmented placement of
// one logical source. Keys are opaque handles copied from SchemaField; the
// compiler normalizes them back to field names before identity/reporting.
//
// COUNT CARRIERS: nonnegative byte sizes, alignments, offsets, widths, counts,
// indices, tags, and opaque compiler keys use u64, distinct from addr. Signed
// carriers remain only where a value is genuinely signed or an explicitly
// retained sentinel requires one.

use omega::language::core::option;

// One field of a schema, target-resolved by the compiler: byte size,
// alignment, and the declared identity number (-1 when unnumbered). Ranges
// keep policy arithmetic Exact: a field is at most 4 KiB wide and its
// alignment is a nonzero power of two at most 16. (Schema is compiler-built
// and passed BY VALUE into plan() -- it is never zero-initialized machine
// state, so the 0-excluding alignment range is sound.)
data SchemaField {
    key: u64;
    size: u64 [0..=4096];
    align: u64 [1..=16];
    identity: Optional<u64>;
    // Transitional compatibility mirror; -1 means unnumbered. New policies
    // consume `identity`.
    number: i64;
    kind: FieldKind;
}

// A schema: the fields of one data definition, in declaration order. At most
// 32 fields in the pilot slice (plan validation rejects more).
// A schema field's SHAPE fact -- what a grammar policy needs to choose a
// placement (a scalar varint-encodes; text/nested/repeated payloads are
// length-prefixed). ZII: the zero case is Scalar.
data FieldKind {
    case Scalar;
    case Text;
    case Nested;
    case Repeated;
}

// One reflected sum case. Stable identity is schema metadata; declaration
// position remains the independent home-layout discriminant. Payload fields
// have their own numbered scope and tombstones.
data SchemaCase {
    key: u64;
    identity: Optional<u64>;
    payload_fields: [SchemaField; 32];
    payload_field_count: u64 [0..=32];
    retired_payload_identities: [u64; 32];
    retired_payload_identity_count: u64 [0..=32];
}

data Schema {
    fields: [SchemaField; 32];
    field_count: u64 [0..=32];
    retired_field_identities: [u64; 32];
    retired_field_identity_count: u64 [0..=32];
    cases: [SchemaCase; 32];
    case_count: u64 [0..=32];
    retired_case_identities: [u64; 32];
    retired_case_identity_count: u64 [0..=32];
}

// One field's PLACEMENT -- the closed vocabulary the compiler knows how to
// read and lower (programmable_layouts §3). Policies CHOOSE placements from
// this sum; a new placement KIND is a compiler release, never user-invented.
// The validator walks `At` and `Bits`. Ordinary plan-laid value types require
// exactly one `At` per field; repeated `Bits` entries are for materializers and
// other consumers that understand fragmented geometry. Tagged/wire placements
// remain consumers of the wire-plan path today.
data FieldPlan {
    case At(offset: u64);
    case Bits(
        container: u64,
        container_width: u64,
        destination_lsb: u64,
        source_lsb: u64,
        width: u64
    );
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}

data FieldEntry {
    key: u64;
    placement: FieldPlan;
}

// A validated placement plan. Entries may appear in any order; `key` names
// the schema field and may repeat only for `Bits` fragments. Positions past
// `entry_count` are meaningless. The compiler checks field coverage, exact
// source tiling for fragments, destination bounds/overlap, and fixed-plan
// size/alignment before anything trusts the plan.
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

// Placed-access policy vocabulary (chapter 20). `Plan` above is the current
// source spelling of LayoutPlan. These records are ordinary library data: the
// compiler evaluates policy machines and validates their returned values, but
// source code cannot construct lowering authority from the records alone.

data Exposure {
    case Exported;
    case BindingPrivate;
}

data Observation {
    case Stable;
    case External;
    case Atomic;
}

data ExternalRead {
    case None;
    case Read;
    case Take;
}

data AtomicOperations [copy] {
    load: bool;
    store: bool;
    fetch_add: bool;
    fetch_sub: bool;
    fetch_xor: bool;
    fetch_or: bool;
    fetch_and: bool;
    swap: bool;
    compare_exchange: bool;
}

// Transfer width and alignment are byte-count facts. Access authors do not
// choose offsets; validated layout geometry supplies those.
data TransferRule [copy] {
    width_bits: u64;
    alignment_bytes: u64;
}

// Invalid observation/operation cross-products are unrepresentable. The
// effective transfer rule comes from the validated layout/resource join.
data FieldAccess {
    case Inaccessible;
    case Stable(
        read: bool,
        write: bool,
        exposure: Exposure
    );
    case External(
        read: ExternalRead,
        write: bool,
        exposure: Exposure
    );
    case Atomic(
        operations: AtomicOperations,
        exposure: Exposure
    );
}

data AccessFieldEntry {
    key: u64;
    access: FieldAccess;
}

// Fixed capacity is a bootstrap carrier only. The compiler requires exactly
// `field_count` canonical schema decisions and ignores the zero tail.
data AccessPlan {
    entries: [AccessFieldEntry; 32];
    field_count: u64 [0..=32];
}

// A normalized static set of boundary-service keys. Suspension and blocking
// are independent contract axes and never enter this record.
data BoundaryReach {
    services: [u64; 32];
    service_count: u64 [0..=32];
}

data PlacementPlan {
    layout: Plan;
    access: AccessPlan;
    reach: BoundaryReach;
}

data RelativeRange [copy] {
    offset: u64;
    length: u64;
}

data StableCapability {
    case None;
    case Read;
    case Write;
    case ReadWrite;
}

data ExternalReadBehavior {
    case None;
    case Repeatable;
    case Destructive;
}

data TransferRules {
    entries: [TransferRule; 16];
    rule_count: u64 [0..=16];
}

data ExternalCapability {
    case None;
    case Access(
        read: ExternalReadBehavior,
        write: bool,
        transfers: TransferRules
    );
}

data AtomicTransferRule {
    transfer: TransferRule;
    operations: AtomicOperations;
}

data AtomicTransferRules {
    entries: [AtomicTransferRule; 16];
    rule_count: u64 [0..=16];
}

data AtomicCapability {
    case None;
    case Access(transfers: AtomicTransferRules);
}

data ResourceRegion {
    range: RelativeRange;
    stable: StableCapability;
    external: ExternalCapability;
    atomic: AtomicCapability;
    reach: BoundaryReach;
}

data ResourceProfile {
    regions: [ResourceRegion; 32];
    region_count: u64 [0..=32];
}

// The policy interface. plan() declares no effects, so implementations HAVE
// none -- that absence is what makes them build-time-evaluable.
trait Layout {
    machine plan(schema: Schema) -> Plan;
}

trait Access {
    machine plan(schema: Schema, layout: Plan) -> AccessPlan;
}

trait Placement {
    machine plan(schema: Schema) -> PlacementPlan;
}
