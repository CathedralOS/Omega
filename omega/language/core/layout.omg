// LAYOUT POLICIES (chapter 19/20; design_briefs/programmable_layouts.md):
// layout is a library, not a language axiom. A policy is ordinary data
// satisfying `Layout`; its `plan(schema)` machine runs at BUILD TIME (no
// keyword -- the position makes the evaluation build-time, the effect system
// makes it legal, and this trait's effect-free signature is the stability
// contract). The compiler materializes `Schema` from a data definition,
// validates the returned `Plan` (a bad plan is a compile error, never
// unsafety), and derives codecs / projections / value types from it.
//
// v1 SHAPES: plan entries carry compiler-issued field keys rather than using
// array position as identity. Repeating a key permits fragmented placement of
// one logical source. Keys are opaque handles copied from SchemaField; the
// compiler normalizes them back to field names before identity/reporting.
//
// COUNT CARRIERS: nonnegative byte sizes, alignments, offsets, widths, counts,
// indices, tags, and opaque compiler keys use u64, distinct from addr. Signed
// carriers remain only where a value is genuinely signed or an explicitly
// retained sentinel requires one.

use omega::language::core::option;

// One field of a schema, target-resolved by the compiler: byte size,
// alignment, shape, and declared identity (-1 in the numeric mirror when
// unnumbered). Recursively nested fixed arrays composed of supported primitive
// elements are one Repeated field. Ranges keep policy arithmetic Exact: a field is at most 4 KiB wide
// and its alignment is a nonzero power of two at most 16. (Schema is
// compiler-built and passed BY VALUE into plan() -- it is never
// zero-initialized machine state, so the 0-excluding alignment range is sound.)
pub data SchemaField {
    key: u64;
    size: u64 [0..=4096];
    align: u64 [1..=16];
    identity: Optional<u64>;
    // Transitional compatibility mirror; -1 means unnumbered. New policies
    // consume `identity`.
    number: i64;
    kind: FieldKind;
}

// A schema: the fields of one data definition, in declaration order. At most
// 32 fields in the pilot slice (plan validation rejects more).
// A schema field's SHAPE fact -- what a grammar policy needs to choose a
// placement (a scalar varint-encodes; text/nested/repeated payloads are
// length-prefixed). ZII: the zero case is Scalar.
pub data FieldKind {
    case Scalar;
    case Text;
    case Nested;
    case Repeated;
}

// One reflected sum case. Stable identity is schema metadata; declaration
// position remains the independent home-layout discriminant. Payload fields
// have their own numbered scope and tombstones.
pub data SchemaCase {
    key: u64;
    identity: Optional<u64>;
    payload_fields: [SchemaField; 32];
    payload_field_count: u64 [0..=32];
    retired_payload_identities: [u64; 32];
    retired_payload_identity_count: u64 [0..=32];
}

pub data Schema {
    fields: [SchemaField; 32];
    field_count: u64 [0..=32];
    retired_field_identities: [u64; 32];
    retired_field_identity_count: u64 [0..=32];
    cases: [SchemaCase; 32];
    case_count: u64 [0..=32];
    retired_case_identities: [u64; 32];
    retired_case_identity_count: u64 [0..=32];
}

// One field's PLACEMENT -- the closed vocabulary the compiler knows how to
// read and lower (programmable_layouts §3). Policies CHOOSE placements from
// this sum; a new placement KIND is a compiler release, never user-invented.
// The validator walks `At`, `Bits`, and `IntegerAt`. `stored_width` is a bit
// width; `offset` remains byte-denominated. `At` or a complete repeated `Bits`
// tiling has live direct plan-laid projection. A fixed primitive array admits
// one whole-extent `At`, not scalar `Bits` or `IntegerAt`. `IntegerAt` is normalized for
// consumers and is the only fixed-layout spelling for a foreign integer whose
// stored width differs from its semantic carrier. Direct owned/reference-backed
// and runtime-indexed projection widen according to `interpretation`. Direct
// stable-owned mutation is live when the compiler derives total-write evidence;
// read-only interpreter record views use the same decode. Concrete proved-fit
// mutation remains fail-closed. Tagged/wire placements remain consumers of the
// wire-plan path today.
pub data IntegerInterpretation {
    case Signed;
    case Unsigned;
}

pub data FieldPlan {
    case At(offset: u64);
    case IntegerAt(
        offset: u64,
        stored_width: u64,
        interpretation: IntegerInterpretation
    );
    case Bits(
        container: u64,
        container_width: u64,
        destination_lsb: u64,
        source_lsb: u64,
        width: u64
    );
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}

pub data FieldEntry {
    key: u64;
    placement: FieldPlan;
}

// A validated placement plan. Entries may appear in any order; `key` names
// the schema field and may repeat only for `Bits` fragments. Positions past
// `entry_count` are meaningless. The compiler checks field coverage, exact
// source tiling for fragments, destination bounds/overlap, and fixed-plan
// size/alignment before anything trusts the plan. The settled native-layout
// extension adds a bounded private-materialization catalog whose entries cite
// exact named `PrivateCallbackSlot<Requirement>` conformance applications.
// That source ABI and its `Plan::place_private` constructor remain engineering
// work; neither raw slot identities nor callback addresses enter this record
// in the interim.
pub data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

// Placed-access policy vocabulary (chapter 20). `Plan` above is the current
// source spelling of LayoutPlan. These records are ordinary library data: the
// compiler evaluates policy machines and validates their returned values, but
// source code cannot construct lowering authority from the records alone.

pub data Exposure {
    case Exported;
    case BindingPrivate;
}

pub data Observation {
    case Stable;
    case External;
    case Atomic;
}

pub data ExternalRead {
    case None;
    case Read;
    case Take;
}

pub data AtomicOperations [copy] {
    load: bool;
    store: bool;
    fetch_add: bool;
    fetch_sub: bool;
    fetch_xor: bool;
    fetch_or: bool;
    fetch_and: bool;
    swap: bool;
    compare_exchange: bool;
    compare_exchange_once: bool;
    try_exchange: bool;
    try_exchange_once: bool;
}

// Transfer width and alignment are byte-count facts. Access authors do not
// choose offsets; validated layout geometry supplies those.
pub data TransferRule [copy] {
    width_bits: u64;
    alignment_bytes: u64;
}

// Invalid observation/operation cross-products are unrepresentable. The
// effective transfer rule comes from the validated layout/resource join.
pub data FieldAccess {
    case Inaccessible;
    case Stable(
        read: bool,
        write: bool,
        exposure: Exposure
    );
    case External(
        read: ExternalRead,
        write: bool,
        exposure: Exposure
    );
    case Atomic(
        operations: AtomicOperations,
        exposure: Exposure
    );
}

pub data AccessFieldEntry {
    key: u64;
    access: FieldAccess;
}

// Fixed capacity is a bootstrap carrier only. The compiler requires exactly
// `field_count` canonical schema decisions and ignores the zero tail.
pub data AccessPlan {
    entries: [AccessFieldEntry; 32];
    field_count: u64 [0..=32];
}

// The inaccessible seed is the only source constructor for a fresh access
// decision set. Every live slot copies its compiler-issued Schema key; the
// fixed-capacity tail is semantically absent because field_count excludes it.
pub machine AccessPlan::inaccessible(schema: Schema) -> AccessPlan {
    AccessPlan {
        entries: [
            AccessFieldEntry { key: schema.fields[0].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[1].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[2].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[3].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[4].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[5].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[6].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[7].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[8].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[9].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[10].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[11].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[12].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[13].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[14].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[15].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[16].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[17].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[18].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[19].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[20].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[21].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[22].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[23].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[24].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[25].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[26].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[27].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[28].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[29].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[30].key, access: FieldAccess::Inaccessible },
            AccessFieldEntry { key: schema.fields[31].key, access: FieldAccess::Inaccessible }
        ],
        field_count: schema.field_count
    }
}

// Functional replacement keeps policy construction expression-oriented.
// A key outside the seed is deliberately retained as an extra/overwriting
// entry so compiler validation rejects it rather than silently ignoring an
// authored mistake.
pub machine AccessPlan::with(self, key: u64, access: FieldAccess) -> AccessPlan {
    AccessPlan::with_bounded(self, key, access, 128)
}

// The helper makes the finite search's ordinary termination witness explicit.
// Fuel is compiler/library policy, not part of the public access-plan surface.
machine AccessPlan::with_bounded(
    plan: AccessPlan,
    key: u64,
    access: FieldAccess,
    fuel: u64 [1..=128]
) -> AccessPlan
terminates by fuel;
{
    transition { _ -> seek(plan, key, access, 0, fuel) }

    state seek(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64 [0..=32],
        fuel: u64 [1..=128]
    ) -> AccessPlan {
        transition fuel > 1 && index < plan.field_count && index < 32 {
            true -> inspect(plan, key, access, index, fuel - 1)
            _ -> invalid(plan, key, access)
        }
    }

    state inspect(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64 [0..=31],
        fuel: u64 [1..=128]
    ) -> AccessPlan {
        transition {
            fuel > 1 && plan.entries[index].key == key -> replace(plan, key, access, index)
            fuel > 1 -> advance(plan, key, access, index, fuel - 1)
            _ -> invalid(plan, key, access)
        }
    }

    state replace(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64 [0..=31]
    ) -> AccessPlan {
        let mut updated: AccessPlan = plan;
        updated.entries[index] = AccessFieldEntry { key: key, access: access };
        updated
    }

    state advance(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64 [0..=31],
        fuel: u64 [1..=128]
    ) -> AccessPlan {
        transition fuel > 1 {
            true -> seek(plan, key, access, index + 1, fuel - 1)
            _ -> invalid(plan, key, access)
        }
    }

    state invalid(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess
    ) -> AccessPlan {
        let mut rejected: AccessPlan = plan;
        rejected.entries[0] = AccessFieldEntry { key: key, access: access };
        transition rejected.field_count < 32 {
            true -> grow_invalid(rejected, rejected.field_count)
            _ -> (rejected)
        }
    }

    state grow_invalid(
        plan: AccessPlan,
        field_count: u64 [0..=31]
    ) -> AccessPlan {
        let mut rejected: AccessPlan = plan;
        rejected.field_count = field_count + 1;
        rejected
    }
}

// A normalized static set of boundary-service keys. Suspension and blocking
// are independent contract axes and never enter this record.
pub data BoundaryReach {
    services: [u64; 32];
    service_count: u64 [0..=32];
}

pub data PlacementPlan {
    layout: Plan;
    access: AccessPlan;
    reach: BoundaryReach;
}

pub data RelativeRange [copy] {
    offset: u64;
    length: u64;
}

pub data StableCapability {
    case None;
    case Read;
    case Write;
    case ReadWrite;
}

pub data ExternalReadBehavior {
    case None;
    case Repeatable;
    case Destructive;
}

pub data TransferRules {
    entries: [TransferRule; 16];
    rule_count: u64 [0..=16];
}

pub data ExternalCapability {
    case None;
    case Access(
        read: ExternalReadBehavior,
        write: bool,
        transfers: TransferRules
    );
}

pub data AtomicTransferRule {
    transfer: TransferRule;
    operations: AtomicOperations;
}

pub data AtomicTransferRules {
    entries: [AtomicTransferRule; 16];
    rule_count: u64 [0..=16];
}

pub data AtomicCapability {
    case None;
    case Access(transfers: AtomicTransferRules);
}

pub data ResourceRegion {
    range: RelativeRange;
    stable: StableCapability;
    external: ExternalCapability;
    atomic: AtomicCapability;
    reach: BoundaryReach;
}

pub data ResourceProfile {
    regions: [ResourceRegion; 32];
    region_count: u64 [0..=32];
}

// Granular placed-field requirements. These are ordinary generic contracts so
// helpers can accept one accessor without receiving the whole placed view.
// The compiler derives conforming accessor types from a normalized placement;
// source cannot construct the opaque template or use it as placement evidence.
pub trait Readable<T> {
    machine read(&self) -> T;
}

pub trait DestructiveRead<T> {
    machine take(&mut self) -> T;
}

pub trait Writable<T> {
    machine write(&mut self, value: T);
}

pub boundary data PlacedField<T>;

boundary machine PlacedField::read<T>(&self) -> T
satisfies Readable<T>::read;

boundary machine PlacedField::take<T>(&mut self) -> T
satisfies DestructiveRead<T>::take;

boundary machine PlacedField::write<T>(&mut self, value: T)
satisfies Writable<T>::write;

pub trait PrivateCallbackSlot<machine Requirement> {
}

// The policy interface. plan() declares no effects, so implementations HAVE
// none -- that absence is what makes them build-time-evaluable.
pub trait Layout {
    machine plan(schema: Schema) -> Plan;
}

pub trait Access {
    machine plan(schema: Schema, layout: Plan) -> AccessPlan;
}

pub trait Placement {
    machine plan(schema: Schema) -> PlacementPlan;
}
