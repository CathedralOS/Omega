// --- Signed 16 -> 8 -------------------------------------------------------

pub machine narrow_i16_to_i8_exact(value: i16 [-128..=127]) -> i8
requires
    value >= -128 && value <= 127;
{
    value as i8
}

pub machine narrow_i16_to_i8_wrapping(value: i16) -> i8 {
    value as i8 in Wrapping
}

pub machine narrow_i16_to_i8_saturating(value: i16) -> i8 {
    transition value < -128 {
        true -> (-128)
    }
    transition value > 127 {
        true -> (127)
        _ -> (value as i8)
    }
}

pub machine narrow_i16_to_i8_trapping(value: i16) -> i8 {
    let below: bool = value < -128;
    numeric_conversion_trap_if(below);
    let above: bool = value > 127;
    numeric_conversion_trap_if(above);
    value as i8
}

pub machine widen_i8_to_i16(value: i8) -> i16 {
    value as i16
}

pub machine widen_i8_to_i32(value: i8) -> i32 {
    value as i32
}

pub machine widen_i8_to_i64(value: i8) -> i64 {
    value as i64
}

