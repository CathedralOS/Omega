// Linux/x86-64 realizations for F7's primitive spelling provider-plan slice.
linux_x64 machine FloatNativeProvider::add32(left: f32, right: f32) -> f32
    satisfies Float::add
    via Binding::CompilerIntrinsic("Float::add.f32");

linux_x64 machine FloatNativeProvider::add64(left: f64, right: f64) -> f64
    satisfies Float::add
    via Binding::CompilerIntrinsic("Float::add.f64");

linux_x64 machine FloatNativeProvider::subtract32(left: f32, right: f32) -> f32
    satisfies Float::subtract
    via Binding::CompilerIntrinsic("Float::subtract.f32");

linux_x64 machine FloatNativeProvider::subtract64(left: f64, right: f64) -> f64
    satisfies Float::subtract
    via Binding::CompilerIntrinsic("Float::subtract.f64");

linux_x64 machine FloatNativeProvider::multiply32(left: f32, right: f32) -> f32
    satisfies Float::multiply
    via Binding::CompilerIntrinsic("Float::multiply.f32");

linux_x64 machine FloatNativeProvider::multiply64(left: f64, right: f64) -> f64
    satisfies Float::multiply
    via Binding::CompilerIntrinsic("Float::multiply.f64");

linux_x64 machine FloatNativeProvider::divide32(left: f32, right: f32) -> f32
    satisfies Float::divide
    via Binding::CompilerIntrinsic("Float::divide.f32");

linux_x64 machine FloatNativeProvider::divide64(left: f64, right: f64) -> f64
    satisfies Float::divide
    via Binding::CompilerIntrinsic("Float::divide.f64");

linux_x64 machine FloatNativeProvider::equal32(left: f32, right: f32) -> bool
    satisfies Float::equal
    via Binding::CompilerIntrinsic("Float::equal.f32");

linux_x64 machine FloatNativeProvider::equal64(left: f64, right: f64) -> bool
    satisfies Float::equal
    via Binding::CompilerIntrinsic("Float::equal.f64");

linux_x64 machine FloatNativeProvider::not_equal32(left: f32, right: f32) -> bool
