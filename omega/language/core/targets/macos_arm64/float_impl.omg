// macOS/AArch64 realizations for F7's primitive spelling provider-plan slice.
macos_arm64 machine FloatNativeProvider::add32(left: f32, right: f32) -> f32
    satisfies Float::add
    via Binding::CompilerIntrinsic("Float::add.f32");

macos_arm64 machine FloatNativeProvider::add64(left: f64, right: f64) -> f64
    satisfies Float::add
    via Binding::CompilerIntrinsic("Float::add.f64");

macos_arm64 machine FloatNativeProvider::subtract32(left: f32, right: f32) -> f32
    satisfies Float::subtract
    via Binding::CompilerIntrinsic("Float::subtract.f32");

macos_arm64 machine FloatNativeProvider::subtract64(left: f64, right: f64) -> f64
    satisfies Float::subtract
    via Binding::CompilerIntrinsic("Float::subtract.f64");

macos_arm64 machine FloatNativeProvider::multiply32(left: f32, right: f32) -> f32
    satisfies Float::multiply
    via Binding::CompilerIntrinsic("Float::multiply.f32");

macos_arm64 machine FloatNativeProvider::multiply64(left: f64, right: f64) -> f64
    satisfies Float::multiply
    via Binding::CompilerIntrinsic("Float::multiply.f64");

macos_arm64 machine FloatNativeProvider::divide32(left: f32, right: f32) -> f32
    satisfies Float::divide
    via Binding::CompilerIntrinsic("Float::divide.f32");

macos_arm64 machine FloatNativeProvider::divide64(left: f64, right: f64) -> f64
    satisfies Float::divide
    via Binding::CompilerIntrinsic("Float::divide.f64");

macos_arm64 machine FloatNativeProvider::equal32(left: f32, right: f32) -> bool
    satisfies Float::equal
    via Binding::CompilerIntrinsic("Float::equal.f32");

macos_arm64 machine FloatNativeProvider::equal64(left: f64, right: f64) -> bool
    satisfies Float::equal
    via Binding::CompilerIntrinsic("Float::equal.f64");

macos_arm64 machine FloatNativeProvider::not_equal32(left: f32, right: f32) -> bool
    satisfies Float::not_equal
    via Binding::CompilerIntrinsic("Float::not_equal.f32");

macos_arm64 machine FloatNativeProvider::not_equal64(left: f64, right: f64) -> bool
    satisfies Float::not_equal
    via Binding::CompilerIntrinsic("Float::not_equal.f64");

macos_arm64 machine FloatNativeProvider::less32(left: f32, right: f32) -> bool
    satisfies Float::less
    via Binding::CompilerIntrinsic("Float::less.f32");

macos_arm64 machine FloatNativeProvider::less64(left: f64, right: f64) -> bool
    satisfies Float::less
    via Binding::CompilerIntrinsic("Float::less.f64");

macos_arm64 machine FloatNativeProvider::less_or_equal32(left: f32, right: f32) -> bool
    satisfies Float::less_or_equal
    via Binding::CompilerIntrinsic("Float::less_or_equal.f32");

macos_arm64 machine FloatNativeProvider::less_or_equal64(left: f64, right: f64) -> bool
    satisfies Float::less_or_equal
    via Binding::CompilerIntrinsic("Float::less_or_equal.f64");

macos_arm64 machine FloatNativeProvider::greater32(left: f32, right: f32) -> bool
    satisfies Float::greater
    via Binding::CompilerIntrinsic("Float::greater.f32");

macos_arm64 machine FloatNativeProvider::greater64(left: f64, right: f64) -> bool
    satisfies Float::greater
    via Binding::CompilerIntrinsic("Float::greater.f64");

macos_arm64 machine FloatNativeProvider::greater_or_equal32(left: f32, right: f32) -> bool
    satisfies Float::greater_or_equal
    via Binding::CompilerIntrinsic("Float::greater_or_equal.f32");

macos_arm64 machine FloatNativeProvider::greater_or_equal64(left: f64, right: f64) -> bool
    satisfies Float::greater_or_equal
    via Binding::CompilerIntrinsic("Float::greater_or_equal.f64");

macos_arm64 machine FloatNativeProvider::minimum32(left: f32, right: f32) -> f32
    satisfies F32::minimum
    via Binding::CompilerIntrinsic("F32::minimum.f32");

macos_arm64 machine FloatNativeProvider::minimum64(left: f64, right: f64) -> f64
    satisfies F64::minimum
    via Binding::CompilerIntrinsic("F64::minimum.f64");

macos_arm64 machine FloatNativeProvider::maximum32(left: f32, right: f32) -> f32
    satisfies F32::maximum
    via Binding::CompilerIntrinsic("F32::maximum.f32");

macos_arm64 machine FloatNativeProvider::maximum64(left: f64, right: f64) -> f64
    satisfies F64::maximum
    via Binding::CompilerIntrinsic("F64::maximum.f64");

macos_arm64 machine FloatNativeProvider::square_root32(value: f32) -> f32
    satisfies F32::square_root
    via Binding::CompilerIntrinsic("F32::square_root.f32");

macos_arm64 machine FloatNativeProvider::square_root64(value: f64) -> f64
    satisfies F64::square_root
    via Binding::CompilerIntrinsic("F64::square_root.f64");

macos_arm64 machine FloatNativeProvider::negate32(value: f32) -> f32
    satisfies F32::negate
    via Binding::CompilerIntrinsic("F32::negate.f32");

macos_arm64 machine FloatNativeProvider::negate64(value: f64) -> f64
    satisfies F64::negate
    via Binding::CompilerIntrinsic("F64::negate.f64");

macos_arm64 machine FloatNativeProvider::is_nan32(value: f32) -> bool
    satisfies F32::is_nan
    via Binding::CompilerIntrinsic("F32::is_nan.f32");

macos_arm64 machine FloatNativeProvider::is_nan64(value: f64) -> bool
    satisfies F64::is_nan
    via Binding::CompilerIntrinsic("F64::is_nan.f64");

macos_arm64 machine FloatNativeProvider::multiply_then_add32(
    left: f32,
    right: f32,
    addend: f32
) -> f32
    satisfies F32::multiply_then_add
    via Binding::CompilerIntrinsic("F32::multiply_then_add.f32");

macos_arm64 machine FloatNativeProvider::multiply_then_add64(
    left: f64,
    right: f64,
    addend: f64
) -> f64
    satisfies F64::multiply_then_add
    via Binding::CompilerIntrinsic("F64::multiply_then_add.f64");
