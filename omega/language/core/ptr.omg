// Core pointer primitive surface.
//
// `Ptr` is not intended to be ordinary application-facing data. It names the
// low-level compiler/runtime boundary that safe core views such as `Slice`,
// `Array`, `Vec`, and future text views lower through after proof checking.
//
// Public core types should expose contracts over views and owners. Boundary
// operators are the implementation edges for the unsafe representation work
// beneath those contracts.

// Boundary primitive providers for the pointer edge (Wave 0 #4).
provider omega::language::core::ptr_offset : PointerOffset;
provider omega::language::core::ptr_access : PointerAccess;

boundary operator Ptr::offset<T>(ptr: Ptr<T>, count: usize) -> Ptr<T>
provider omega::language::core::ptr_offset;

boundary operator Ptr::read<T>(ptr: Ptr<T>) -> T
provider omega::language::core::ptr_access;

boundary operator Ptr::write<T>(ptr: Ptr<T>, value: T) -> ()
provider omega::language::core::ptr_access;

boundary operator Ptr::range<T>(ptr: Ptr<T>, len: usize) -> PtrRange<T>
provider omega::language::core::ptr_offset;
