// Math roster N4 (2026-07-11): Seq<T> as ordinary GENERIC RECURSIVE DATA
// -- proof-only by N1's computed classification (recursive through
// `tail`; no runtime layout). The proof views (Seq/Bag/Range atoms)
// dissolve into this type as the extraction-lemma rungs land; Bag ships
// as a canonical-representative domain over sorted sequences (no
// quotient dependency -- N4 is decoupled from N6), which rides R2's
// where-clauses.
data Seq<T> {
    case Empty;
    case Cons(head: T, tail: Seq<T>);
}

use omega::language::core::nat;

// N4 Seq operations (2026-07-11): length as a structurally-recursive
// proof machine returning core Nat -- the generic twin of nat's own
// ladder, and the roster's first PROVEN lemma over a GENERIC recursive
// type. The structural entailment judge (N3) is parametric over
// constructor names, so it discharges Seq lemmas exactly as it does Nat's.
machine length(s: Seq<u64>) -> Nat
terminates {
    decreases s;
}
{
    transition s {
        Seq::Empty -> Nat::Zero
        Seq::Cons { head, tail } -> Nat::Succ { prev: length(tail) }
    }
}

// length of the empty sequence is Zero (compute-mode: unfold the Empty arm).
machine length_empty()
ensures
    (length(Seq::Empty)) == Nat::Zero
{
}

// length's recursive step: length(Cons(x, s)) == Succ(length(s)) -- one
// unfold of the Cons arm, the tail's length staying symbolic on both sides.
// Lean analog: `List.length_cons`.
machine length_cons(x: u64, s: Seq<u64>)
ensures
    (length(Seq::Cons { head: x, tail: s })) == (Nat::Succ { prev: length(s) })
{
}

// Concatenation, structurally recursive on the first sequence.
machine append(s: Seq<u64>, t: Seq<u64>) -> Seq<u64>
terminates {
    decreases s;
}
{
    transition s {
        Seq::Empty -> (t)
        Seq::Cons { head, tail } -> Seq::Cons { head: head, tail: append(tail, t) }
    }
}

// append's right identity, by induction on `s`. Lean analog:
// `List.append_nil`.
machine append_empty_right(s: Seq<u64>) -> Seq<u64>
terminates {
    decreases s;
}
ensures
    (append(s, Seq::Empty)) == s
{
    transition s {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> Seq::Cons { head: head, tail: append_empty_right(tail) }
    }
}

// append associates, by induction on the outermost first sequence. Lean
// analog: `List.append_assoc`.
machine append_assoc(s: Seq<u64>, t: Seq<u64>, u: Seq<u64>) -> Seq<u64>
terminates {
    decreases s;
}
ensures
    (append(append(s, t), u)) == (append(s, append(t, u)))
{
    transition s {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> Seq::Cons { head: head, tail: append_assoc(tail, t, u) }
    }
}

// The Seq zoo's first COMPOSED law: length distributes over append, by
// induction on the first sequence -- cross-machine unfolding (append
// inside length inside add) plus the inductive hypothesis; no citations
// needed. Lean analog: `List.length_append`.
machine length_append(s: Seq<u64>, t: Seq<u64>) -> Nat
terminates {
    decreases s;
}
ensures
    (length(append(s, t))) == (add(length(s), length(t)))
{
    transition s {
        Seq::Empty -> Nat::Zero
        Seq::Cons { head, tail } -> Nat::Succ { prev: length_append(tail, t) }
    }
}

// Reversal, structurally recursive (the naive quadratic form: each step
// appends the head as a singleton on the right). Lean analog:
// `List.reverse` (the non-accumulator spelling).
machine reverse(s: Seq<u64>) -> Seq<u64>
terminates {
    decreases s;
}
{
    transition s {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } ->
            (append(reverse(tail), Seq::Cons { head: head, tail: Seq::Empty }))
    }
}

// Reversal preserves length, by induction on `s` -- the zoo's deepest
// citation chain yet: the step case rewrites through length_append (at
// the reversed tail and the singleton), then lands the arithmetic with
// nat's add_succ_law + add_zero_right, plus the inductive hypothesis.
// Landing this lemma required the state-values simplifier hardening
// (boolean depth budget + distribution size gate + the helper-expansion
// fuel budget): the backend used to crash, then hang, expanding the
// proof machine's recursion. Lean analog: `List.length_reverse`.
machine length_reverse(s: Seq<u64>) -> Nat
terminates {
    decreases s;
}
ensures
    (length(reverse(s))) == (length(s))
{
    transition s {
        Seq::Empty -> Nat::Zero
        Seq::Cons { head, tail } -> lr_step(head, tail)
    }

    state lr_step(head: u64, tail: Seq<u64>) -> Nat {
        length_append(reverse(tail), Seq::Cons { head: head, tail: Seq::Empty });
        add_succ_law(length(tail), Nat::Zero);
        add_zero_right(length(tail));
        transition { _ -> Nat::Succ { prev: length_reverse(tail) } }
    }
}



// Reversal anti-distributes over append, by induction on `s`: the base
// case needs append's RIGHT identity; the step case rewrites the appended
// singleton through append_assoc, with the inductive self-application
// BOUND TO A LOCAL (the nested value-call fence's own hint) -- landing
// this shape took the recognizer's let-binding rung (a sub-proof `let`,
// spelled or the lowering's own __hoist_N of a call terminal, termifies
// its initializer and joins the arm environment). Lean analog:
// `List.reverse_append`.
machine reverse_append(s: Seq<u64>, t: Seq<u64>) -> Seq<u64>
terminates {
    decreases s;
}
ensures
    (reverse(append(s, t))) == (append(reverse(t), reverse(s)))
{
    transition s {
        Seq::Empty -> ra_base(t)
        Seq::Cons { head, tail } -> ra_step(head, tail, t)
    }

    state ra_base(t: Seq<u64>) -> Seq<u64> {
        append_empty_right(reverse(t));
        transition { _ -> (reverse(t)) }
    }

    state ra_step(head: u64, tail: Seq<u64>, t: Seq<u64>) -> Seq<u64> {
        let ih: Seq<u64> = reverse_append(tail, t);
        append_assoc(reverse(t), reverse(tail), Seq::Cons { head: head, tail: Seq::Empty });
        transition { _ -> (append(ih, Seq::Cons { head: head, tail: Seq::Empty })) }
    }
}
