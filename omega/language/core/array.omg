// Core Array surface.
//
// Fixed-size arrays are owned contiguous storage with a compile-time length.
// `Array::Length` exposes that extent as a proof-facing measure, and the
// `as_slice` / `as_mut_slice` operators adapt an owned array into a borrowed
// `Slice` view whose length matches the array. They are the owned-array
// counterpart to `Vec::as_slice` and mirror the borrowed `Slice` surface.
//
// The element layout is backend-owned and the borrowed-view descriptors are a
// runtime concern; only the proof-facing length/view contracts and the boundary
// provider binding live in this module.

// Boundary primitive provider for constructing borrowed slice views over an
// owned fixed array (Wave 0 decision #4). `as_slice` / `as_mut_slice` lower
// through this descriptor-construction edge, consistent with the Vec view and
// slice/pointer provider bindings already in core.
provider omega::language::core::array_views : DescriptorConstruction;

// Length in elements: the static extent of the array. Cheap O(1) measure.
boundary operator Array::Length<T>(items: &Array<T>) -> usize;

boundary operator Array::index<T>(items: &Array<T>, index: usize) -> T
requires
    index < items.len;

boundary operator Array::index_mut<T>(items: &mut Array<T>, index: usize) -> &mut T
requires
    index < items.len;

// Borrow the elements as a slice view; the view length matches the array.
boundary operator Array::as_slice<T>(items: &Array<T>) -> &[T]
provider omega::language::core::array_views
ensures
    result.len == items.len;

boundary operator Array::as_mut_slice<T>(items: &mut Array<T>) -> &mut [T]
provider omega::language::core::array_views
ensures
    result.len == items.len;
