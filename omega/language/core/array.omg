// Core Array surface.
//
// Fixed-size arrays are owned contiguous storage with a compile-time length.
// They should eventually expose Slice-producing borrow operators and length
// facts that the proof checker can use for safe indexing and subslicing.
//
// The element layout is backend-owned, but the array's proof-facing length and
// view conversion contracts belong in this module.

boundary operator Array::Length<T>(items: &Array<T>) -> usize;

boundary operator Array::index<T>(items: &Array<T>, index: usize) -> T
requires
    index < items.len;

boundary operator Array::index_mut<T>(items: &mut Array<T>, index: usize) -> &mut T
requires
    index < items.len;

boundary operator Array::as_slice<T>(items: &Array<T>) -> &[T];

boundary operator Array::as_mut_slice<T>(items: &mut Array<T>) -> &mut [T];
