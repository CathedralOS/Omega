// Core Array surface.
//
// Fixed-size arrays are owned contiguous storage with a compile-time length.
// `Array::Length` exposes that extent as a proof-facing measure, and the
// `as_slice` / `as_mut_slice` operators adapt an owned array into a borrowed
// `Slice` view whose length matches the array. They are the owned-array
// counterpart to `Vec::as_slice` and mirror the borrowed `Slice` surface.
//
// The element layout is backend-owned and the borrowed-view descriptors are a
// runtime concern; only the proof-facing length/view contracts and
// provider-agnostic boundary requirements live in this module.

// Length in elements: the static extent of the array. Cheap O(1) measure.
// `N` stays in the semantic type; there is no length-erasing `Array<T>`
// carrier distinct from Omega's native `[T; N]` value.
boundary operator Array::Length<T, const N: u64>(items: &[T; N]) -> u64;

boundary operator Array::index<T, const N: u64>(items: &[T; N], index: u64) -> T
requires
    index < items.len;

boundary operator Array::index_mut<T, const N: u64>(items: &mut [T; N], index: u64) -> &mut T
requires
    index < items.len;

// Borrow the elements as a slice view; the view length matches the array.
boundary operator Array::as_slice<T, const N: u64>(items: &[T; N]) -> &[T]
ensures
    result.len == items.len;

boundary operator Array::as_mut_slice<T, const N: u64>(items: &mut [T; N]) -> &mut [T]
ensures
    result.len == items.len;
