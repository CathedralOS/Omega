// Core natural-number ranking surface.
//
// `Nat::Descending` is the default well-founded ranking for unsigned natural
// values in termination proofs. The checker still recognizes the name
// internally today, but the semantic home should be browsable here alongside
// other core rankings.
//
// Planned public surface:
// - plain `decreases value` resolves here when the value has an unambiguous
//   natural-number ranking
// - `decreases value -> Nat::Descending` spells the ranking explicitly
// - custom numeric-like domains can define their own named rankings instead of
//   pretending every ordering belongs directly to the data type

operator Nat::Descending(value: u64) -> u64;

// The core algebraic conformance surface: Nat EARNS ring canonicalization
// (rearrange-mode) by conforming `CommutativeSemiring` machine-by-machine
// below -- ops via `satisfies CommutativeSemiring::<op>`, laws via the lemma
// machines binding the law slots (each proof machine-checked against the
// declared law, forall-to-forall).
use omega::language::core::algebra;

// Math roster N4, first slice (2026-07-11): Nat as ORDINARY RECURSIVE
// DATA -- legal to declare and proof-only by N1's computed
// classification (recursive data has no layout; every runtime
// consumption face refuses with the classification named). N2's exact
// engine evaluates Nat facts; the structural bridge (n > 0 => n ==
// Succ(n - 1)) and the fact-position operator routing are N2(d)/N3.
data Nat {
    case Zero;
    case Succ(prev: Nat);
}

// N4 roster operations (2026-07-11): the Peano ring surface as ordinary
// PROOF MACHINES -- free machines over proof-only data (machine-stratum
// contagion), structurally recursive, every self-call descending by the
// arm-bound case-payload subterm. `mul` composes `add` by an ordinary
// cross-machine call (no cycle; only self-calls need the measure).
// Extraction lemmas (add_zero, add_succ, commutativity) ride N3/N4's
// ensures-extraction rung.
machine add(a: Nat, b: Nat) -> Nat
satisfies CommutativeSemiring::add
terminates by a;
{
    transition a {
        Nat::Zero -> (b)
        Nat::Succ { prev } -> Nat::Succ { prev: add(prev, b) }
    }
}

machine mul(a: Nat, b: Nat) -> Nat
satisfies CommutativeSemiring::mul
terminates by a;
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> (add(b, mul(prev, b)))
    }
}

// The semiring constants -- trivial one-transition machines (the settle's
// zero/one rule: no constructor-binding surface).
machine zero() -> Nat
satisfies CommutativeSemiring::zero
{
    transition { _ -> Nat::Zero }
}

machine one() -> Nat
satisfies CommutativeSemiring::one
{
    transition { _ -> Nat::Succ { prev: Nat::Zero } }
}

// N4 extraction lemmas (2026-07-11): the first PROVEN library lemmas --
// the structural entailment judge (N3) discharges each ensures at
// compile time, so every program importing this module carries machine-
// checked Peano facts. add_zero_left unfolds add's Zero arm
// (compute-mode); add_zero_right is STRUCTURAL INDUCTION on `a` (each
// case arm judged with the self-application assuming this machine's own
// ensures -- the inductive hypothesis, licensed by the structural
// descent the recursion check enforces).
machine add_zero_left(b: Nat) -> Nat
ensures
    result == b
{
    transition { _ -> (add(Nat::Zero, b)) }
}

// Two conjuncts, one induction: the functional form (`result == a`,
// consumed by per-call fact extraction) and the LAW form
// (`add(a, Zero) == a`, the statement a CITATION delivers -- ch10 "Citing
// Proofs": `add_zero_right(b);` in a consumer proof injects
// `add(b, Zero) == b` at those operands). Both are discharged per arm
// with the machine's own ensures as the inductive hypothesis.
machine add_zero_right(a: Nat) -> Nat
terminates by a;
ensures
    result == a;
    (add(a, Nat::Zero)) == a
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: add_zero_right(prev) }
    }
}

// add's one-step successor: add(a, Succ(Zero)) == Succ(a) -- structural
// induction on `a`, the add_zero_right pattern shifted by one (the Zero
// arm computes; each Succ arm's ensures is the inductive hypothesis).
// Bridges length_append's trailing `add(length(s), Succ(Zero))` to
// `Succ(length(s))` in seq.omg's length_snoc. Lean analog: `Nat.add_one`.
machine add_one_right(a: Nat) -> Nat
terminates by a;
ensures
    (add(a, Nat::Succ { prev: Nat::Zero })) == (Nat::Succ { prev: a })
{
    transition a {
        Nat::Zero -> Nat::Succ { prev: Nat::Zero }
        Nat::Succ { prev } -> Nat::Succ { prev: add_one_right(prev) }
    }
}

// mul's left annihilator: mul(Zero, b) == Zero (compute-mode, unfolds the
// Zero arm).
machine mul_zero_left(b: Nat) -> Nat
ensures
    result == Nat::Zero
{
    transition { _ -> (mul(Nat::Zero, b)) }
}

// The successor-shift LAW: add(a, Succ(b)) == Succ(add(a, b)), by
// induction on `a` -- an ensures that is an EQUATION BETWEEN
// APPLICATIONS (not `result == term`), each arm discharged by unfolding
// add plus this machine's own ensures as the inductive hypothesis. This
// and add_zero_right are the rewrite material COMMUTATIVITY needs; the
// missing rung is a global PATTERN-MATCHING rewrite theory (each proven
// `lhs == rhs` law rewriting matching applications everywhere), not the
// laws themselves.
machine add_succ_law(a: Nat, b: Nat) -> Nat
terminates by a;
ensures
    (add(a, Nat::Succ { prev: b })) == (Nat::Succ { prev: add(a, b) })
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: add_succ_law(prev, b) }
    }
}

// COMMUTATIVITY (N3 rung 2, 2026-07-12): induction on `a` with PER-ARM
// SUB-STATE proofs -- each case arm transitions to its own state carrying
// exactly the citations that case needs (ch10 "Citing Proofs", explicit
// fact injection). The base case cites add_zero_right's law at `b`; the
// step case cites add_succ_law AT THE CASE PAYLOAD (a frame only the
// sub-state sees) and takes the inductive hypothesis from its
// self-application, whose descent flows through the sub-state parameter
// (provenance: every transition into comm_step binds it from `a`'s Succ
// payload).
machine add_comm(a: Nat, b: Nat) -> Nat
satisfies CommutativeSemiring::add_comm
terminates by a;
ensures
    (add(a, b)) == (add(b, a))
{
    transition a {
        Nat::Zero -> comm_base(b)
        Nat::Succ { prev } -> comm_step(prev, b)
    }

    state comm_base(b: Nat) -> Nat {
        add_zero_right(b);
        transition { _ -> (b) }
    }

    state comm_step(prev: Nat, b: Nat) -> Nat {
        add_succ_law(b, prev);
        transition { _ -> Nat::Succ { prev: add_comm(prev, b) } }
    }
}

// ASSOCIATIVITY: pure induction on `a`, no citations -- both sides
// normalize by unfolding plus the inductive hypothesis.
machine add_assoc(a: Nat, b: Nat, c: Nat) -> Nat
satisfies CommutativeSemiring::add_assoc
terminates by a;
ensures
    (add(add(a, b), c)) == (add(a, add(b, c)))
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: add_assoc(prev, b, c) }
    }
}

// mul's RIGHT annihilator (the left one is compute-mode; this one is the
// induction).
machine mul_zero_right(a: Nat) -> Nat
terminates by a;
ensures
    (mul(a, Nat::Zero)) == Nat::Zero
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: mul_zero_right(prev) }
    }
}

// mul's right-successor law -- CITATION-FREE since rearrange-mode
// (2026-07-18). This step case was the citation-choreography showcase:
// three cited rewrites (comm, assoc, comm) hand-normalized
// `add(b, add(prev, mul(prev, b)))` onto the goal's other side. The
// rearrange tier dissolves the choreography: after unfolding and the
// inductive hypothesis, both sides flatten to the same addend multiset
// under Nat's CommutativeSemiring conformance, and the msr_step sub-state
// deletes entirely.
machine mul_succ_right(a: Nat, b: Nat) -> Nat
terminates by a;
ensures
    (mul(a, Nat::Succ { prev: b })) == (add(a, mul(a, b)))
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: mul_succ_right(prev, b) }
    }
}

// DISTRIBUTIVITY -- CITATION-FREE (the rearrange-mode acceptance,
// 2026-07-18): induction on `a`, no sub-states, no cited instances. The
// step case unfolds mul/add and applies the inductive hypothesis, leaving a
// four-addend shuffle (`add(b, add(c, X))` against `add(add(b, X'), ...)`)
// that the engine's REARRANGE tier discharges: Nat's explicit
// `CommutativeSemiring` conformance (add_comm + add_assoc proven above)
// licenses flattening both sides into addend multisets and comparing --
// exactly Lean's `ring` discipline, license by declared instance, never by
// imports in scope.
machine mul_distributes(a: Nat, b: Nat, c: Nat) -> Nat
satisfies CommutativeSemiring::mul_distributes
terminates by a;
ensures
    (mul(a, add(b, c))) == (add(mul(a, b), mul(a, c)))
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: mul_distributes(prev, b, c) }
    }
}

// RIGHT distributivity -- CITATION-FREE like its left twin: induction on
// `a`; the step case unfolds mul/add and applies the inductive
// hypothesis, leaving a three-addend shuffle (`add(c, add(X, Y))` against
// `add(add(c, X), Y)`) the rearrange tier discharges under the
// CommutativeSemiring conformance.
machine mul_distributes_right(a: Nat, b: Nat, c: Nat) -> Nat
terminates by a;
ensures
    (mul(add(a, b), c)) == (add(mul(a, c), mul(b, c)))
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: mul_distributes_right(prev, b, c) }
    }
}

// MULTIPLICATION ASSOCIATES -- the last CommutativeSemiring law slot for
// Nat. Induction on `a`; the base case is compute-mode (both sides
// unfold to Zero); the step case cites RIGHT distributivity at
// (b, mul(prev, b), c) -- rewriting the unfolded left side
// `mul(add(b, mul(prev, b)), c)` into `add(mul(b, c), mul(mul(prev, b), c))`
// -- and takes the inductive hypothesis from its self-application, after
// which both sides meet at `add(mul(b, c), mul(prev, mul(b, c)))`.
machine mul_assoc(a: Nat, b: Nat, c: Nat) -> Nat
satisfies CommutativeSemiring::mul_assoc
terminates by a;
ensures
    (mul(mul(a, b), c)) == (mul(a, mul(b, c)))
{
    transition a {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> ma_step(prev, b, c)
    }

    state ma_step(prev: Nat, b: Nat, c: Nat) -> Nat {
        mul_distributes_right(b, mul(prev, b), c);
        transition { _ -> Nat::Succ { prev: mul_assoc(prev, b, c) } }
    }
}

// MULTIPLICATION COMMUTES: base cites mul_zero_right; step cites
// mul_succ_right at (b, prev) plus the inductive hypothesis.
machine mul_comm(a: Nat, b: Nat) -> Nat
satisfies CommutativeSemiring::mul_comm
terminates by a;
ensures
    (mul(a, b)) == (mul(b, a))
{
    transition a {
        Nat::Zero -> mc_base(b)
        Nat::Succ { prev } -> mc_step(prev, b)
    }

    state mc_base(b: Nat) -> Nat {
        mul_zero_right(b);
        transition { _ -> Nat::Zero }
    }

    state mc_step(prev: Nat, b: Nat) -> Nat {
        mul_succ_right(b, prev);
        transition { _ -> Nat::Succ { prev: mul_comm(prev, b) } }
    }
}
