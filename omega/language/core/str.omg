// Core text surface.
//
// The text model is an owned text value plus a borrowed text window. The owner
// is spelled `String` (it carries capacity and `push_str`); the borrowed window
// is its own type spelled `&string` / `&mut string` (lowercase `string`), where
// capitalization distinguishes owner from window. The window shares the slice
// `{ptr, len}` descriptor carrier underneath, but at the type and proof level it
// is referenced as `&string`.
//
// Text measures and domains: `length` and `non_empty` are exposed first because
// they are cheap, O(1) facts. The `no_nul` and `utf8` domains are ESTABLISHED at
// validating boundary constructors (asserted once, carried as facts, never
// re-proved per use); they are declared here but not implemented as sequence-wide
// proofs.
//
// Runtime builders and host IO should lower through the private representation
// layer, not through ad hoc string special cases.

// Owned text measures and operators.

boundary operator String::Length(text: &String) -> usize;

boundary operator String::Capacity(text: &String) -> usize;

boundary operator String::as_view(text: &String) -> &string;

boundary operator String::with_capacity(capacity: usize) -> String;

boundary operator String::push_str(text: &mut String, value: &string) -> ()
requires
    text.len + value.len <= text.capacity;

// Owned text domains.
//
// `NonEmpty` is a cheap O(1) classifier over the owned length.
domain String::NonEmpty {
    self.len > 0;
}

// `NoNul` and `Utf8` are byte-shape domains over the FULL extent of the text:
// `Utf8` means every byte is part of a well-formed UTF-8 sequence; `NoNul` means
// no byte is `0x00`. Deriving either inline would require a sequence-wide byte
// scan on every use, which the frozen Wave 0 decision (chapter 18) rejects as too
// expensive. They are therefore declared with NO cheap classifier body: they can
// only be ESTABLISHED at a validating boundary (below), then carried as ordinary
// domain facts and consumed by `requires ... in String::Utf8` without re-proof.
domain String::NoNul {
}

domain String::Utf8 {
}

// Validating boundary constructors / validators.
//
// These boundary operators are the ONLY way to obtain a `String::Utf8` or
// `String::NoNul` fact. Each scans its bytes ONCE at the host edge and then
// ESTABLISHES the domain membership through an `ensures` contract. After the
// boundary, the membership flows like any other domain fact; the checker never
// re-scans bytes per use, and ordinary code cannot mint these memberships
// without flowing through one of these boundaries.
//
// The in-place validators (`validate_utf8` / `validate_no_nul`) establish the
// fact on their `&mut String` argument; the membership is carried on that place
// afterwards. This is the working establishment path (the boundary's `ensures`
// attaches the fact to the named argument place via the existing call-contract
// machinery).
boundary operator String::validate_utf8(text: &mut String) -> ()
ensures
    text in String::Utf8;

boundary operator String::validate_no_nul(text: &mut String) -> ()
ensures
    text in String::NoNul;

// The constructor form (validate-and-build from a borrowed byte window) is the
// browsable boundary surface for producing a freshly-validated owned `String`.
// It documents the intended `&[u8] -> String` constructor shape and establishes
// the domain membership on its `result`.
//
// TODO(text-domains stitch): establishing a fact on the *return value* needs a
// `result` binder in the call-contract place substitution (proof lane,
// `semantic_places/substitution.rs`), which only maps `self` and named
// parameters today. Until that hook lands, code that needs a carried `Utf8` /
// `NoNul` fact should build the `String` and then call the in-place validator
// above. The return-style `ensures result in ...` here is declared as the target
// surface but does not yet flow the fact to the binding.
boundary operator String::from_utf8(bytes: &[u8]) -> String
ensures
    result in String::Utf8;

boundary operator String::from_no_nul(bytes: &[u8]) -> String
ensures
    result in String::NoNul;

// Borrowed text window (`&string`) measures and operators.

boundary operator Str::Length(text: &string) -> usize;

boundary operator Str::bytes(text: &string) -> &[u8];

boundary operator Str::byte(text: &string, index: usize) -> u8
requires
    index < text.len;

boundary operator Str::range(text: &string, start: usize, end: usize) -> &string
requires
    start <= end && end <= text.len;
