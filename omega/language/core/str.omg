// Core text surface.
//
// The long-term model is an owned text value plus a borrowed text view. The
// exact public names may remain Rust-like (`String` and `str`) or move toward
// `Str` and `StrView`; either way, text views should mirror Slice proof shapes
// while carrying text-specific domains such as valid encoding and no-NUL.
//
// Runtime builders and host IO should lower through the private representation
// layer, not through ad hoc string special cases.

trust compiler_string_length {
}

trust compiler_string_as_view {
}

trust compiler_string_allocate {
}

trust compiler_str_view_length {
}

trust compiler_str_view_bytes {
}

trust compiler_str_view_byte {
}

trust compiler_str_view_range {
}

operator String::Length(text: String) -> usize
trust compiler_string_length;

operator String::as_view(text: &String) -> &str
trust compiler_string_as_view;

operator String::with_capacity(capacity: usize) -> String
trust compiler_string_allocate;

operator StrView::Length(text: &str) -> usize
trust compiler_str_view_length;

operator StrView::bytes(text: &str) -> &[u8]
trust compiler_str_view_bytes;

operator StrView::byte(text: &str, index: usize) -> u8
requires
    index < text.len
trust compiler_str_view_byte;

operator StrView::range(text: &str, start: usize, end: usize) -> &str
requires
    start <= end && end <= text.len
trust compiler_str_view_range;
