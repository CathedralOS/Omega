// Core Vec surface.
//
// Vec is the growable owner for contiguous storage. It should eventually expose
// source-visible contracts for length, capacity, allocation, push/pop, and
// borrowing as Slice views.
//
// The allocation buffer and reallocation mechanics are compiler/runtime
// internals; the visible contracts belong here so slices derived from Vec can
// participate in borrow checking and proof obligations.

trust compiler_vec_length {
}

trust compiler_vec_capacity {
}

trust compiler_vec_index {
}

trust compiler_vec_as_slice {
}

trust compiler_vec_as_mut_slice {
}

trust compiler_vec_push {
}

trust compiler_vec_pop {
}

trust compiler_vec_allocate {
}

operator Vec::Length<T>(items: &Vec<T>) -> usize
trust compiler_vec_length;

operator Vec::Capacity<T>(items: &Vec<T>) -> usize
trust compiler_vec_capacity;

operator Vec::index<T>(items: &Vec<T>, index: usize) -> T
requires
    index < items.len
trust compiler_vec_index;

operator Vec::as_slice<T>(items: &Vec<T>) -> &[T]
trust compiler_vec_as_slice;

operator Vec::as_mut_slice<T>(items: &mut Vec<T>) -> &mut [T]
trust compiler_vec_as_mut_slice;

operator Vec::push<T>(items: &mut Vec<T>, value: T) -> ()
requires
    items.len < items.capacity
trust compiler_vec_push;

operator Vec::pop<T>(items: &mut Vec<T>) -> Option<T>
requires
    items.len > 0
trust compiler_vec_pop;
