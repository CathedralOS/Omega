// Core Vec surface.
//
// Vec is the eventual arena-backed owner for contiguous storage. It owns an
// allocation with a fixed capacity (`capacity`, always >= `len`) and is the
// owned counterpart to the borrowed `Slice` view: `Vec::as_slice` lends the
// elements as a `&[T]` window without giving up ownership.
//
// This module is the source-visible SURFACE: the length/capacity measures and
// the push / as_slice / as_mut_slice operator contracts with
// their `requires`/`ensures`, including byte vectors refined by text domains
// and how `Slice`/`Array` surface their length and view contracts. The actual
// runtime storage mechanics are OUT OF SCOPE here; only the proof-facing
// contracts and provider-agnostic boundary requirements live in this layer. Construction
// remains deliberately absent until `Allocation<T>` can borrow an explicit
// `Arena` through the lifetime model; there is no ambient allocator shortcut.

// Source-visible owned vector type. The compiler/runtime own its concrete
// buffer descriptor; core exposes the nominal type so user code, contracts, and
// IDEs can name `Vec<T>` instead of treating it as unreachable magic.
data Vec<T> {
}

// Method-call surface used by borrow/lifetime analysis. Runtime lowering may
// still choose the boundary operator below; this state-shaped declaration lets
// `items.push(value)` participate in ordinary receiver mutation checks.
machine Vec::as_slice<T>(&self) -> &[T] {
}

machine Vec::push<T>(&mut self, value: T) {
}

// Length in elements. Cheap O(1) measure used by `requires`/`ensures`.
boundary operator Vec::Length<T>(items: &Vec<T>) -> u64;

// Capacity in elements; always at least the current length. Cheap O(1) measure.
boundary operator Vec::Capacity<T>(items: &Vec<T>) -> u64
ensures
    result >= items.len;

boundary operator Vec::index<T>(items: &Vec<T>, index: u64) -> T
requires
    index < items.len;

boundary operator Vec::index_mut<T>(items: &mut Vec<T>, index: u64) -> &mut T
requires
    index < items.len;

// Borrow the elements as a slice view; the view length matches the vector.
boundary operator Vec::as_slice<T>(items: &Vec<T>) -> &[T]
ensures
    result.len == items.len;

boundary operator Vec::as_mut_slice<T>(items: &mut Vec<T>) -> &mut [T]
ensures
    result.len == items.len;

// Append a value using already-owned capacity. Reallocation is never ambient;
// a future growing owner must use an explicit allocator package/capability.
boundary operator Vec::push<T>(items: &mut Vec<T>, value: T) -> ()
requires
    items.len < items.capacity;

// Infallible under its proof obligation, matching `FixedVec::pop`.
// A future dynamic-failure `try_pop` may return `Optional<T>` from std.
boundary operator Vec::pop<T>(items: &mut Vec<T>) -> T
requires
    items.len > 0;
