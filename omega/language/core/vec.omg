// Core Vec surface.
//
// Vec is the growable owner for contiguous storage. It should eventually expose
// source-visible contracts for length, capacity, allocation, push/pop, and
// borrowing as Slice views.
//
// The allocation buffer and reallocation mechanics are compiler/runtime
// internals; the visible contracts belong here so slices derived from Vec can
// participate in borrow checking and proof obligations.

boundary operator Vec::Length<T>(items: &Vec<T>) -> usize;

boundary operator Vec::Capacity<T>(items: &Vec<T>) -> usize;

boundary operator Vec::with_capacity<T>(capacity: usize) -> Vec<T>;

boundary operator Vec::index<T>(items: &Vec<T>, index: usize) -> T
requires
    index < items.len;

boundary operator Vec::index_mut<T>(items: &mut Vec<T>, index: usize) -> &mut T
requires
    index < items.len;

boundary operator Vec::as_slice<T>(items: &Vec<T>) -> &[T];

boundary operator Vec::as_mut_slice<T>(items: &mut Vec<T>) -> &mut [T];

boundary operator Vec::push<T>(items: &mut Vec<T>, value: T) -> ()
requires
    items.len < items.capacity;

boundary operator Vec::pop<T>(items: &mut Vec<T>) -> Option<T>
requires
    items.len > 0;
