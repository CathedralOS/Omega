// Core slice surface.
//
// Slices are compiler-managed views over contiguous storage. The public core
// surface owns the semantic contracts; the concrete pointer/length carrier and
// boundary implementation live below this layer.
//
// Planned public surface:
// - Slice::Length ranks a slice by its current length for termination proofs.
// - index and subslice operators require bounds proofs before lowering to the
//   boundary descriptor layer.
// - mutable views carry the same overlap and borrow obligations as their
//   source owner.

boundary operator Slice::Length<T>(items: &[T]) -> usize;

boundary operator Slice::index<T>(items: &[T], index: usize) -> T
requires
    index < items.len;

boundary operator Slice::index_mut<T>(items: &mut [T], index: usize) -> &mut T
requires
    index < items.len;

boundary operator Slice::tail<T>(items: &[T]) -> &[T]
requires
    items.len > 0;

boundary operator Slice::tail_mut<T>(items: &mut [T]) -> &mut [T]
requires
    items.len > 0;

boundary operator Slice::from<T>(items: &[T], start: usize) -> &[T]
requires
    start <= items.len;

boundary operator Slice::from_mut<T>(items: &mut [T], start: usize) -> &mut [T]
requires
    start <= items.len;

boundary operator Slice::to<T>(items: &[T], end: usize) -> &[T]
requires
    end <= items.len;

boundary operator Slice::to_mut<T>(items: &mut [T], end: usize) -> &mut [T]
requires
    end <= items.len;

boundary operator Slice::range<T>(items: &[T], start: usize, end: usize) -> &[T]
requires
    start <= end && end <= items.len;

boundary operator Slice::range_mut<T>(items: &mut [T], start: usize, end: usize) -> &mut [T]
requires
    start <= end && end <= items.len;
