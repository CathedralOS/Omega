// Core concrete-range authority.
//
// An `addr` is only a number. `Extent` is the opaque, provider-minted
// authority over one particular range, including its bounds, address-space
// identity, rights, provenance, and lifetime/era. Ordinary Omega code may
// move or borrow that authority, but cannot inspect its representation or
// construct a root grant from address bits.
//
// The carrier is linear because losing an owned range may lose reclamation
// debt or another exclusive authority. Zero-filled storage does not establish
// an `Extent`; APIs that need an honest zero/empty state use `ExtentSlot`.

boundary data Extent [linear];

data ExtentSlot {
    case Empty;
    case Live(extent: Extent);
}
