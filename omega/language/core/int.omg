// Core IntPair -- the DIFFERENCE-PAIR construction (no kernel change): an
// integer is a pair of Nats read as `pos - neg`; equality is the
// cross-sum equivalence (a.pos + b.neg == b.pos + a.neg), and the ring
// operations are componentwise Nat arithmetic. The N-ladder's Int
// introduction rule holds: ORDER HAS NO FLOOR here, so measures stay
// Nat-valued (IntPair never ranks a termination witness).
//
// NOT named `Int`: that is a BUILTIN type name (the polynomial engine's
// unbounded proof integer), and a data definition shadowing a builtin is
// fenced -- references would bind to the builtin and orphan the definition.
// IntPair is the CONSTRUCTED integer (Nat -> Z, the ladder exercise);
// builtin `Int` is the ambient one.
//
// Proof shape: every lemma discharges by RECORD-FIELD CONGRUENCE over
// cited Nat lemmas -- add_int_comm is two add_comm citations, add_int_assoc
// is two add_assoc citations; the judge unfolds add_int to its record
// literal, decomposes field-by-field, and the citations (or Nat's earned
// ring license) settle each Nat component.

use omega::language::core::nat;

data IntPair {
    neg: Nat;
    pos: Nat;
}

// Componentwise addition: (p1 - n1) + (p2 - n2) = (p1 + p2) - (n1 + n2).
machine add_int(a: IntPair, b: IntPair) -> IntPair {
    transition { _ -> (IntPair { neg: add(a.neg, b.neg), pos: add(a.pos, b.pos) }) }
}

// Negation is the pair swap: -(p - n) = n - p. Total, no floor needed.
machine neg_int(a: IntPair) -> IntPair {
    transition { _ -> (IntPair { neg: a.pos, pos: a.neg }) }
}

// Commutativity: componentwise from Nat's add_comm (two citations).
machine add_int_comm(a: IntPair, b: IntPair) -> IntPair
ensures
    (add_int(a, b)) == (add_int(b, a))
{
    add_comm(a.neg, b.neg);
    add_comm(a.pos, b.pos);
    transition { _ -> (add_int(a, b)) }
}

// Associativity: componentwise from Nat's add_assoc (two citations).
machine add_int_assoc(a: IntPair, b: IntPair, c: IntPair) -> IntPair
ensures
    (add_int(add_int(a, b), c)) == (add_int(a, add_int(b, c)))
{
    add_assoc(a.neg, b.neg, c.neg);
    add_assoc(a.pos, b.pos, c.pos);
    transition { _ -> (add_int(a, b)) }
}

// The symmetric pair (n+p, p+n) -- the difference-pair ZERO CLASS shape a
// cancelled sum lands in (kept as an application so the ensures below
// compares application-to-application; a record-LITERAL comparand routes
// through runtime Equatable synthesis, which recursive Nat cannot join).
machine cross_sum(a: IntPair) -> IntPair {
    transition { _ -> (IntPair { neg: add(a.neg, a.pos), pos: add(a.pos, a.neg) }) }
}

// Negation cancels into the zero class: a + (-a) computes componentwise to
// exactly cross_sum's body -- pure unfolding, no citations.
machine add_int_neg(a: IntPair) -> IntPair
ensures
    (add_int(a, neg_int(a))) == (cross_sum(a))
{
    let negated: IntPair = neg_int(a);
    transition { _ -> (add_int(a, negated)) }
}

// Multiplication: (p1 - n1)(p2 - n2) = (p1 p2 + n1 n2) - (p1 n2 + n1 p2).
machine mul_int(a: IntPair, b: IntPair) -> IntPair {
    transition { _ -> (IntPair {
        neg: add(mul(a.pos, b.neg), mul(a.neg, b.pos)),
        pos: add(mul(a.pos, b.pos), mul(a.neg, b.neg)),
    }) }
}

// Commutativity: mul_comm rewrites each product; the pos field then matches
// outright, and the neg field's swapped ADDEND order settles under Nat's
// earned add ring license (multiset flattening).
machine mul_int_comm(a: IntPair, b: IntPair) -> IntPair
ensures
    (mul_int(a, b)) == (mul_int(b, a))
{
    mul_comm(a.pos, b.neg);
    mul_comm(a.neg, b.pos);
    mul_comm(a.pos, b.pos);
    mul_comm(a.neg, b.neg);
    transition { _ -> (mul_int(a, b)) }
}

// Associativity: both sides unfold to two-level products of the six Nat
// components; each field equation is a polynomial identity the SEMIRING
// license (Nat's conformed add+mul with distributivity) normalizes
// citation-free -- the tier-2 monomial multiset settles it.
machine mul_int_assoc(a: IntPair, b: IntPair, c: IntPair) -> IntPair
ensures
    (mul_int(mul_int(a, b), c)) == (mul_int(a, mul_int(b, c)))
{
    transition { _ -> (mul_int(a, b)) }
}

// Distributivity over add_int: componentwise polynomial identity, same
// citation-free tier-2 discharge.
machine mul_int_distributes(a: IntPair, b: IntPair, c: IntPair) -> IntPair
ensures
    (mul_int(a, add_int(b, c))) == (add_int(mul_int(a, b), mul_int(a, c)))
{
    transition { _ -> (mul_int(a, b)) }
}

// THE QUOTIENT (cross-sum equivalence): a ~ a2 iff a.pos + a2.neg ==
// a2.pos + a.neg. add_int RESPECTS it -- if a ~ a2 then a + b ~ a2 + b,
// spelled in unfolded Nat component form (the fact grammar has no member-
// of-call, so the ensures states the components add_int computes). The
// requires hypothesis exchanges inside the goal's addend multiset under
// the add ring license (hypothesis-exchange tier).
machine add_int_respects_eq(a: IntPair, a2: IntPair, b: IntPair) -> IntPair
requires
    (add(a.pos, a2.neg)) == (add(a2.pos, a.neg))
ensures
    (add(add(a.pos, b.pos), add(a2.neg, b.neg))) == (add(add(a2.pos, b.pos), add(a.neg, b.neg)))
{
    transition { _ -> (add_int(a, b)) }
}
