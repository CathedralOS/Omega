// Core Rat -- the CANONICAL-REPRESENTATIVE construction (N4 Rat rung,
// spelling settled in the roster): a rational is a reduced fraction of
// Nats. The carrier itself does not enforce reducedness by type (that is
// the quotient former's job when N6 lands); the DISCIPLINE lives in the
// constructor: mk_rat divides both components by their gcd, so every value
// built through it carries gcd(num, den) == 1 by construction. `den` is
// kept positive by the same constructor contract (a zero denominator has
// no canonical representative; callers prove positivity exactly as mod's
// and div's divisor premises demand).
//
// Equality between fractions is CROSS-MULTIPLICATION (rat_eq), the same
// difference-pair move IntPair uses for its sums: p.num * q.den ==
// q.num * p.den needs no division and no quotient former.
//
// Proof-only: Rat rides Nat, so the runtime-consumption fence and the
// layout skip apply exactly as they do for Nat and IntPair.

use omega::language::core::nat;
use omega::language::core::nat_metric;

data Rat {
    num: Nat;
    den: Nat;
}

// The canonical constructor: reduce by the gcd. Positivity of `d` is the
// caller's obligation (the same 1 <= d premise mod and div carry); the
// gcd of a positive denominator is positive, which callers of div get
// for free here because gcd(n, d) divides d... the DIVISIBILITY theory
// (gcd_pos, gcd_dvd_left/right, div_mul_cancel) is the remaining ladder
// above this carrier -- mk_rat's own positivity premise on the gcd keeps
// the constructor honest until that theory lands.
machine mk_rat(n: Nat, d: Nat, g: Nat) -> Rat
requires
    (sub(Nat::Succ { prev: Nat::Zero }, d)) == Nat::Zero;
    (gcd(n, d)) == (g);
    (sub(Nat::Succ { prev: Nat::Zero }, g)) == Nat::Zero
{
    transition {
        _ -> build(n, d, g)
    }

    state build(n: Nat, d: Nat, g: Nat) -> Rat {
        let rn: Nat = div(n, g);
        let rd: Nat = div(d, g);
        transition { _ -> Rat { num: rn, den: rd } }
    }
}

// Cross-multiplication equality: no division, no quotient former.
machine rat_eq(p: Rat, q: Rat) -> Nat
{
    transition (sub((mul(p.num, q.den)), (mul(q.num, p.den)))) {
        Nat::Zero -> check_other(p, q)
        Nat::Succ { prev as w } -> Nat::Succ { prev: Nat::Zero }
    }

    state check_other(p: Rat, q: Rat) -> Nat {
        transition (sub((mul(q.num, p.den)), (mul(p.num, q.den)))) {
            Nat::Zero -> Nat::Zero
            Nat::Succ { prev as w } -> Nat::Succ { prev: Nat::Zero }
        }
    }
}

// N8 metric kernel. Cross-multiplication puts two non-negative rationals over
// the common denominator p.den * q.den. The sum of the two directed monus
// differences is their absolute numerator gap without introducing signed
// runtime arithmetic or division:
//
//   |p.num * q.den - q.num * p.den|
//
// This is deliberately unreduced. Cauchy bounds compare it against the common
// denominator, so normalization does not change the proposition.
machine rat_gap(p: Rat, q: Rat) -> Nat
{
    let left: Nat = mul(p.num, q.den);
    let right: Nat = mul(q.num, p.den);
    let forward: Nat = sub(left, right);
    let backward: Nat = sub(right, left);
    let gap: Nat = add(forward, backward);
    transition { _ -> (gap) }
}

machine rat_gap_reflexive(p: Rat) -> Nat
ensures
    result == Nat::Zero;
    (rat_gap(p, p)) == Nat::Zero
{
    let cross: Nat = mul(p.num, p.den);
    sub_self(cross);
    transition { _ -> (rat_gap(p, p)) }
}

machine rat_gap_symmetric(p: Rat, q: Rat) -> Nat
ensures
    (rat_gap(p, q)) == (rat_gap(q, p))
{
    add_comm(
        sub(mul(p.num, q.den), mul(q.num, p.den)),
        sub(mul(q.num, p.den), mul(p.num, q.den))
    );
    transition { _ -> (rat_gap(p, q)) }
}

// `rat_close(p, q, precision) == Zero` means |p-q| <= 1/precision, written
// without division as precision * gap <= p.den * q.den. Nat's settled monus
// spelling encodes `a <= b` as sub(a, b) == Zero. Precision zero is harmless
// (the bound is vacuous); Cauchy consumers use positive precisions.
machine rat_close(p: Rat, q: Rat, precision: Nat) -> Nat
{
    let gap: Nat = rat_gap(p, q);
    let scaled_gap: Nat = mul(precision, gap);
    let common_denominator: Nat = mul(p.den, q.den);
    let residual: Nat = sub(scaled_gap, common_denominator);
    transition { _ -> (residual) }
}

machine rat_close_reflexive(p: Rat, precision: Nat)
ensures
    (rat_close(p, p, precision)) == Nat::Zero
{
    rat_gap_reflexive(p);
    mul_zero_right(precision);
    let common_denominator: Nat = mul(p.den, p.den);
    sub_zero_left(common_denominator);
}

machine rat_close_symmetric(p: Rat, q: Rat, precision: Nat)
requires
    (rat_close(p, q, precision)) == Nat::Zero
ensures
    (rat_close(q, p, precision)) == Nat::Zero
{
    rat_gap_symmetric(q, p);
    mul_comm(q.den, p.den);
}

// Triangle inequality after lifting all three cross-product gaps to the
// shared denominator p.den * q.den * r.den:
//
//   q.den * gap(p,r) <= r.den * gap(p,q) + p.den * gap(q,r)
//
// The proof is Nat's checked triangle at the common numerators x,y,z. The
// only Rat-specific work is rearranging factors and applying homogeneity.
machine rat_gap_triangle_scaled(p: Rat, q: Rat, r: Rat)
ensures
    (sub(
        mul(q.den, rat_gap(p, r)),
        add(mul(r.den, rat_gap(p, q)), mul(p.den, rat_gap(q, r)))
    )) == Nat::Zero
{
    let pr_left: Nat = mul(p.num, r.den);
    let pr_right: Nat = mul(r.num, p.den);
    let pq_left: Nat = mul(p.num, q.den);
    let pq_right: Nat = mul(q.num, p.den);
    let qr_left: Nat = mul(q.num, r.den);
    let qr_right: Nat = mul(r.num, q.den);
    let x: Nat = mul(pq_left, r.den);
    let y: Nat = mul(pq_right, r.den);
    let z: Nat = mul(pr_right, q.den);

    mul_swap_trailing(p.num, r.den, q.den);
    mul_swap_trailing(q.num, r.den, p.den);
    mul_swap_trailing(r.num, q.den, p.den);

    nat_gap_mul_right(pr_left, pr_right, q.den);
    nat_gap_mul_right(pq_left, pq_right, r.den);
    nat_gap_mul_right(qr_left, qr_right, p.den);

    mul_comm(q.den, rat_gap(p, r));
    mul_comm(r.den, rat_gap(p, q));
    mul_comm(p.den, rat_gap(q, r));
    nat_gap_triangle(x, y, z);
}

// Pure semiring factorization for the reciprocal-bound triangle.  Equation
// orientation is deliberate: the first rewrite expands the scaled triangle's
// upper bound before order transport, while the remaining rewrites map the
// common-factor forms used by cancellation back to the established bounds.
machine rat_close_triangle_factorization(
    p: Rat,
    q: Rat,
    r: Rat,
    precision: Nat
)
ensures
    (mul(
        add(
            mul(r.den, rat_gap(p, q)),
            mul(p.den, rat_gap(q, r))
        ),
        add(precision, precision)
    )) == (add(
        mul(mul(add(precision, precision), rat_gap(p, q)), r.den),
        mul(mul(add(precision, precision), rat_gap(q, r)), p.den)
    ));
    (mul(
        mul(add(precision, precision), rat_gap(p, r)),
        q.den
    )) == (mul(
        mul(q.den, rat_gap(p, r)),
        add(precision, precision)
    ));
    (mul(
        add(
            mul(p.den, r.den),
            mul(p.den, r.den)
        ),
        q.den
    )) == (add(
        mul(mul(p.den, q.den), r.den),
        mul(mul(q.den, r.den), p.den)
    ));
    (add(
        mul(precision, rat_gap(p, r)),
        mul(precision, rat_gap(p, r))
    )) == (mul(add(precision, precision), rat_gap(p, r)))
{
}

// If p and q, and q and r, are close at twice the requested precision, then
// p and r are close at that precision.  The middle denominator is the common
// positive factor: scale the gap triangle, add the two doubled-precision
// bounds, cancel q.den, then cancel the concrete factor two.
machine rat_close_triangle_split(
    p: Rat,
    q: Rat,
    r: Rat,
    precision: Nat
)
requires
    (sub(Nat::Succ { prev: Nat::Zero }, q.den)) == Nat::Zero;
    (rat_close(p, q, add(precision, precision))) == Nat::Zero;
    (rat_close(q, r, add(precision, precision))) == Nat::Zero
ensures
    (rat_close(p, r, precision)) == Nat::Zero
{
    let double_precision: Nat = add(precision, precision);
    let pq_gap: Nat = rat_gap(p, q);
    let qr_gap: Nat = rat_gap(q, r);
    let pr_gap: Nat = rat_gap(p, r);
    let triangle_lower: Nat = mul(q.den, pr_gap);
    let pq_triangle_upper: Nat = mul(r.den, pq_gap);
    let qr_triangle_upper: Nat = mul(p.den, qr_gap);
    let triangle_upper: Nat = add(pq_triangle_upper, qr_triangle_upper);
    let scaled_triangle_lower: Nat = mul(triangle_lower, double_precision);
    let pq_close_lower: Nat = mul(double_precision, pq_gap);
    let qr_close_lower: Nat = mul(double_precision, qr_gap);
    let pq_scaled_lower: Nat = mul(pq_close_lower, r.den);
    let qr_scaled_lower: Nat = mul(qr_close_lower, p.den);
    let summed_lower: Nat = add(pq_scaled_lower, qr_scaled_lower);
    let pq_close_upper: Nat = mul(p.den, q.den);
    let qr_close_upper: Nat = mul(q.den, r.den);
    let pq_scaled_upper: Nat = mul(pq_close_upper, r.den);
    let qr_scaled_upper: Nat = mul(qr_close_upper, p.den);
    let summed_upper: Nat = add(pq_scaled_upper, qr_scaled_upper);
    let pr_denominator: Nat = mul(p.den, r.den);
    let doubled_pr_denominator: Nat = add(pr_denominator, pr_denominator);
    let doubled_pr_gap: Nat = mul(double_precision, pr_gap);
    let precision_pr_gap: Nat = mul(precision, pr_gap);
    let two: Nat = Nat::Succ { prev: (Nat::Succ { prev: Nat::Zero }) };

    rat_close_triangle_factorization(p, q, r, precision);
    rat_gap_triangle_scaled(p, q, r);
    mul_le_mul_right(triangle_lower, triangle_upper, double_precision);
    mul_le_mul_right(
        pq_close_lower,
        pq_close_upper,
        r.den
    );
    mul_le_mul_right(
        qr_close_lower,
        qr_close_upper,
        p.den
    );
    add_le_add(
        pq_scaled_lower,
        pq_scaled_upper,
        qr_scaled_lower,
        qr_scaled_upper
    );
    le_trans(
        scaled_triangle_lower,
        summed_lower,
        summed_upper
    );
    mul_le_cancel_right(
        doubled_pr_gap,
        doubled_pr_denominator,
        q.den
    );
    mul_one_right(precision_pr_gap);
    mul_succ_right(precision_pr_gap, Nat::Succ { prev: Nat::Zero });
    mul_one_right(pr_denominator);
    mul_succ_right(pr_denominator, Nat::Succ { prev: Nat::Zero });
    le_one_succ(Nat::Succ { prev: Nat::Zero });
    mul_le_cancel_right(
        precision_pr_gap,
        pr_denominator,
        two
    );
}
