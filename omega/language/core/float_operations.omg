// Distinct named carrier requirements. Multiply-then-add and FMA are never
// alternative providers for one requirement, and directed modes are never an
// ambient control-state parameter.
boundary operator F32::negate(value: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::negate(
        FloatFormat::BINARY32,
        Float::meaning32(value)
    );
boundary operator F64::negate(value: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::negate(
        FloatFormat::BINARY64,
        Float::meaning64(value)
    );
boundary operator F32::multiply_then_add(left: f32, right: f32, addend: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::multiply_then_add(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right),
        Float::meaning32(addend)
    );
boundary operator F64::multiply_then_add(left: f64, right: f64, addend: f64) -> f64
ensures
