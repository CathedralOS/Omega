    );
boundary operator F64::maximum(left: f64, right: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::maximum(
        Float::meaning64(left),
        Float::meaning64(right)
    );

boundary operator F32::classify(value: f32) -> FloatClass
ensures
    result == FloatSemantics::classify(
        FloatFormat::BINARY32,
        Float::meaning32(value)
    );
boundary operator F64::classify(value: f64) -> FloatClass
ensures
    result == FloatSemantics::classify(
        FloatFormat::BINARY64,
        Float::meaning64(value)
    );
boundary operator F32::is_finite(value: f32) -> bool
ensures
    result == FloatSemantics::is_finite(Float::meaning32(value));
boundary operator F64::is_finite(value: f64) -> bool
ensures
    result == FloatSemantics::is_finite(Float::meaning64(value));
boundary operator F32::is_nan(value: f32) -> bool
ensures
    result == FloatSemantics::is_nan(Float::meaning32(value));
boundary operator F64::is_nan(value: f64) -> bool
ensures
