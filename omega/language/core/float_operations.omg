boundary operator F32::square_root(value: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::square_root(
        FloatFormat::BINARY32,
        Float::meaning32(value)
    );
boundary operator F64::square_root(value: f64) -> f64
ensures
