// Source-visible floating-point operation identities.
//
// Primitive spellings resolve to the root Float operators below. Their
// implementation remains the bootstrap compiler lowering until F7's target
// satisfier/ProviderPlan rung replaces it, but the semantic identity and
// contract no longer live only in Rust match arms.
//
// Unspelled operations use format-qualified F32/F64 names. This keeps named
// call resolution exact while the operator-call resolver is arity-based:
// `F32::fused_multiply_add` and `F64::fused_multiply_add` are distinct
// requirements, never return-type overloads.

use omega::language::core::float_format;
use omega::language::core::float_meaning;

pub data FloatClass [copy] {
    case NaN;
    case Infinity(negative: bool);
    case Normal(negative: bool);
    case Subnormal(negative: bool);
    case Zero(negative: bool);
}

// Runtime-carrier to proof-meaning projections. NaN payloads intentionally
// disappear here; a raw-bit consumer needs the stronger refinement described
// in chapter 5.
operator Float::meaning32(value: f32) -> FloatMeaning;
operator Float::meaning64(value: f64) -> FloatMeaning;

// The executable, representation-free semantic definitions. The compiler's
// omega-core implementation is the current checked provider for these
// proof-only operations; target realizations cite the same identities.
operator FloatSemantics::add(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::subtract(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::multiply(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::divide(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::negate(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::square_root(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::multiply_then_add(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning,
    addend: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::fused_multiply_add(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning,
    addend: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::minimum(
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::maximum(
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

operator FloatSemantics::equal(
    left: FloatMeaning,
    right: FloatMeaning
) -> bool;

operator FloatSemantics::not_equal(
    left: FloatMeaning,
    right: FloatMeaning
) -> bool;

operator FloatSemantics::less(
    left: FloatMeaning,
    right: FloatMeaning
) -> bool;

operator FloatSemantics::less_or_equal(
    left: FloatMeaning,
    right: FloatMeaning
) -> bool;

operator FloatSemantics::greater(
    left: FloatMeaning,
    right: FloatMeaning
) -> bool;

operator FloatSemantics::greater_or_equal(
    left: FloatMeaning,
    right: FloatMeaning
) -> bool;

operator FloatSemantics::classify(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatClass;

operator FloatSemantics::is_finite(value: FloatMeaning) -> bool;
operator FloatSemantics::is_nan(value: FloatMeaning) -> bool;
operator FloatSemantics::is_infinite(value: FloatMeaning) -> bool;
operator FloatSemantics::is_normal(
    format: FloatFormat,
    value: FloatMeaning
) -> bool;
operator FloatSemantics::is_subnormal(
    format: FloatFormat,
    value: FloatMeaning
) -> bool;

