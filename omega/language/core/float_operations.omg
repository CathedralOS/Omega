boundary operator Float::equal(left: f32, right: f32) -> bool
spelling ==
ensures
    result == FloatSemantics::equal(
        Float::meaning32(left),
        Float::meaning32(right)
    );

boundary operator Float::equal(left: f64, right: f64) -> bool
spelling ==
ensures
    result == FloatSemantics::equal(
        Float::meaning64(left),
        Float::meaning64(right)
    );

