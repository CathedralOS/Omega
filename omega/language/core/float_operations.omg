operator FloatSemantics::fused_multiply_add_toward_negative(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning,
    addend: FloatMeaning
) -> FloatMeaning;

// Primitive spelling identities. Selection is operand-driven and recorded in
// checked operator evidence; the result contract is equality with the one
// executable semantic definition above.
boundary operator Float::add(left: f32, right: f32) -> f32
spelling +
ensures
    Float::meaning32(result) == FloatSemantics::add(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
    );

boundary operator Float::add(left: f64, right: f64) -> f64
spelling +
ensures
    Float::meaning64(result) == FloatSemantics::add(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right)
    );

boundary operator Float::subtract(left: f32, right: f32) -> f32
spelling -
ensures
    Float::meaning32(result) == FloatSemantics::subtract(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
    );

boundary operator Float::subtract(left: f64, right: f64) -> f64
spelling -
ensures
    Float::meaning64(result) == FloatSemantics::subtract(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right)
    );

boundary operator Float::multiply(left: f32, right: f32) -> f32
spelling *
ensures
    Float::meaning32(result) == FloatSemantics::multiply(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
