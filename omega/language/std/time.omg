// std::time — Duration pure-value core (rung 3) + Instant/Time over the
// TimeHost seam (rung 6) per TASKS_TIME.md D1-D7/D9/D13.
//
// `Duration` is a normalized span: whole seconds plus subsecond nanoseconds,
// where the field RANGE carries the normalization invariant the compiler
// write-enforces at every construction site — ZII zero IS the zero duration.
// Everything here is a pure `[copy, zero_init]` value with no authority; clock
// READS live on the `Time` capability (a later rung), never on these types.
//
// Rust parity, differing where Omega is better (TASKS_TIME.md north star):
// - No panicking `+`/`-`: the checked and saturating forms ARE the API.
//   `case Overflow` is DurationResult's ZII-zero first case, so an
//   uninitialized result reads as the failure case, never a fake success.
// - `checked_subtract` reports underflow through the same `Overflow` case
//   (one result vocabulary; the direction is unambiguous from the operation).
// - Construction is by struct literal today (`Duration { seconds: 2,
//   subsecond_nanoseconds: 0 }`); `from_*` unit constructors are pending
//   receiverless type-scoped value-call resolution.
//
// Authoring shape (the de-Trapping house recipes):
// - Overflow/underflow DETECTION is explicit guards; the arithmetic itself
//   runs in Wrapping-domained lets (obligation-free), whose values are only
//   USED on the guard arms that prove them meaningful — the wrapped-compare
//   idiom (`sum < a` iff the u64 add wrapped) needs no u64::MAX literal.
// - The ranged `subsecond_nanoseconds` store happens in `*_emit` states whose
//   SINGLE inbound edge is the `<= 999999999` guard: single-predecessor edge
//   guards flow into the target state, so the store proves. The `false` arms
//   are unreachable by construction but total (never a silent face).

// The raw per-OS boundary (`TimeHost`) is declared once in the sibling std
// module; the `Time` capability below wraps it (the filesystem.omg layering).
use omega::language::std::time_host;

data Ordering [copy, zero_init] {
    case Less;
    case Equal;
    case Greater;
}

data Duration [copy, zero_init] {
    seconds: u64;
    subsecond_nanoseconds: u32 [0..=999_999_999];
}

data DurationResult [copy, zero_init] {
    case Overflow;
    case Ok(duration: Duration);
}

// Whole-duration totals (`checked_as_*`): one result vocabulary for all three
// units. (The scoping sketch spelled this `NanosecondsResult { Ok(nanoseconds) }`;
// one payload field cannot be unit-accurate for nanoseconds AND milliseconds,
// so the field is the neutral `total` -- noted in TASKS_TIME.md.)
data TotalResult [copy, zero_init] {
    case Overflow;
    case Ok(total: u64);
}

const Duration::ZERO: Duration = Duration { seconds: 0, subsecond_nanoseconds: 0 };
// u64::MAX seconds: spellable since D14 fire D blessed u64-classed
// struct-literal fields for u64-magnitude literals.
const Duration::MAX: Duration = Duration { seconds: 18446744073709551615, subsecond_nanoseconds: 999999999 };

// Unit constructors (receiverless type-scoped machines).
machine Duration::from_seconds(seconds: u64) -> Duration {
    Duration { seconds: seconds, subsecond_nanoseconds: 0 }
}

machine Duration::from_milliseconds(milliseconds: u64) -> Duration {
    // Flow-sensitive LETS carry the proofs (`% 1000` bounds the remainder,
    // the narrowing cast and `* 1000000` prove under it); constructing from
    // the lets keeps each construction check on a named, ranged local.
    let scaled_wide: u64 = (milliseconds % 1000) * 1000000;
    let scaled: u32 = scaled_wide as u32;
    let whole_seconds: u64 = milliseconds / 1000;
    let sub: u32 [0..=999999999] = scaled % 1000000000;
    Duration {
        seconds: whole_seconds,
        subsecond_nanoseconds: sub,
    }
}

machine Duration::from_microseconds(microseconds: u64) -> Duration {
    // Same construct-from-lets + ranged-let discipline as from_milliseconds.
    let scaled_wide: u64 = (microseconds % 1000000) * 1000;
    let scaled: u32 = scaled_wide as u32;
    let whole_seconds: u64 = microseconds / 1000000;
    let sub: u32 [0..=999999999] = scaled % 1000000000;
    Duration {
        seconds: whole_seconds,
        subsecond_nanoseconds: sub,
    }
}

machine Duration::from_nanoseconds(nanoseconds: u64) -> Duration {
    let remainder_wide: u64 = nanoseconds % 1000000000;
    let remainder: u32 = remainder_wide as u32;
    let whole_seconds: u64 = nanoseconds / 1000000000;
    let sub: u32 [0..=999999999] = remainder % 1000000000;
    Duration {
        seconds: whole_seconds,
        subsecond_nanoseconds: sub,
    }
}

// Whole seconds, truncating the subsecond part (Rust `as_secs`).
machine Duration::as_seconds(&self) -> u64 {
    self.seconds
}

machine Duration::subsecond_milliseconds(&self) -> u32 {
    self.subsecond_nanoseconds / 1000000
}

machine Duration::subsecond_microseconds(&self) -> u32 {
    self.subsecond_nanoseconds / 1000
}

// The whole duration as a nanosecond count. u64 nanoseconds cap at
// ~584 years: seconds above 18_446_744_073 (u64::MAX / 1e9) overflow, and at
// exactly that threshold only subseconds up to 709_551_615 still fit
// (18_446_744_073 * 1e9 + 709_551_615 == u64::MAX).
machine Duration::checked_as_nanoseconds(&self) -> TotalResult {
    let seconds_small: bool = self.seconds < 18446744073;
    let seconds_edge: bool = self.seconds == 18446744073;
    let subsecond_fits: bool = self.subsecond_nanoseconds <= 709551615;
    let total: u64 in Wrapping = ((self.seconds as u64 in Wrapping) * 1000000000)
        + (self.subsecond_nanoseconds as u64 in Wrapping);
    transition seconds_small {
        true -> total_ok(total)
        false -> total_edge(seconds_edge, subsecond_fits, total)
    }
    state total_ok(&self, total: u64) -> TotalResult {
        TotalResult::Ok { total: total }
    }
    state total_edge(&self, seconds_edge: bool, subsecond_fits: bool, total: u64) -> TotalResult {
        transition seconds_edge && subsecond_fits {
            true -> total_ok(total)
            false -> total_overflow()
        }
    }
    state total_overflow(&self) -> TotalResult {
        TotalResult::Overflow
    }
}

// The whole duration as a microsecond count (subseconds truncate to the
// microsecond). Threshold 18_446_744_073_709 = u64::MAX / 1e6; at the edge
// only microsecond parts up to 551_615 still fit.
machine Duration::checked_as_microseconds(&self) -> TotalResult {
    let seconds_small: bool = self.seconds < 18446744073709;
    let seconds_edge: bool = self.seconds == 18446744073709;
    let subsecond_part: u32 = self.subsecond_nanoseconds / 1000;
    let subsecond_fits: bool = subsecond_part <= 551615;
    let total: u64 in Wrapping = ((self.seconds as u64 in Wrapping) * 1000000)
        + (subsecond_part as u64 in Wrapping);
    transition seconds_small {
        true -> total_ok(total)
        false -> total_edge(seconds_edge, subsecond_fits, total)
    }
    state total_ok(&self, total: u64) -> TotalResult {
        TotalResult::Ok { total: total }
    }
    state total_edge(&self, seconds_edge: bool, subsecond_fits: bool, total: u64) -> TotalResult {
        transition seconds_edge && subsecond_fits {
            true -> total_ok(total)
            false -> total_overflow()
        }
    }
    state total_overflow(&self) -> TotalResult {
        TotalResult::Overflow
    }
}

// The whole duration as a millisecond count (subseconds truncate to the
// millisecond). Threshold 18_446_744_073_709_551 = u64::MAX / 1e3; at the
// edge only millisecond parts up to 615 still fit.
machine Duration::checked_as_milliseconds(&self) -> TotalResult {
    let seconds_small: bool = self.seconds < 18446744073709551;
    let seconds_edge: bool = self.seconds == 18446744073709551;
    let subsecond_part: u32 = self.subsecond_nanoseconds / 1000000;
    let subsecond_fits: bool = subsecond_part <= 615;
    let total: u64 in Wrapping = ((self.seconds as u64 in Wrapping) * 1000)
        + (subsecond_part as u64 in Wrapping);
    transition seconds_small {
        true -> total_ok(total)
        false -> total_edge(seconds_edge, subsecond_fits, total)
    }
    state total_ok(&self, total: u64) -> TotalResult {
        TotalResult::Ok { total: total }
    }
    state total_edge(&self, seconds_edge: bool, subsecond_fits: bool, total: u64) -> TotalResult {
        transition seconds_edge && subsecond_fits {
            true -> total_ok(total)
            false -> total_overflow()
        }
    }
    state total_overflow(&self) -> TotalResult {
        TotalResult::Overflow
    }
}

machine Duration::is_zero(&self) -> bool {
    self.seconds == 0 && self.subsecond_nanoseconds == 0
}

// self + other; `Overflow` when the true sum exceeds the representable range.
machine Duration::checked_add(&self, other: Duration) -> DurationResult {
    // EXACT-provable straight from the field ranges:
    // [0..=999_999_999] + [0..=999_999_999] = [0..=1_999_999_998] fits u32.
    let nanoseconds_total: u32 = self.subsecond_nanoseconds + other.subsecond_nanoseconds;
    let seconds_sum: u64 in Wrapping =
        (self.seconds as u64 in Wrapping) + (other.seconds as u64 in Wrapping);
    let seconds_wrapped: bool = seconds_sum < self.seconds;
    transition nanoseconds_total >= 1000000000 {
        true -> add_carried(nanoseconds_total, seconds_sum, seconds_wrapped)
        false -> add_flat(nanoseconds_total, seconds_sum, seconds_wrapped)
    }

    state add_carried(&self, nanoseconds_total: u32, seconds_sum: u64, seconds_wrapped: bool) -> DurationResult {
        let seconds_carried: u64 in Wrapping = (seconds_sum as u64 in Wrapping) + 1;
        let carry_wrapped: bool = seconds_carried < seconds_sum;
        let nanoseconds_reduced: u32 in Wrapping = (nanoseconds_total as u32 in Wrapping) - 1000000000;
        transition seconds_wrapped {
            true -> add_overflow()
            false -> add_carry_gate(nanoseconds_reduced, seconds_carried, carry_wrapped)
        }
    }
    state add_carry_gate(&self, nanoseconds_reduced: u32, seconds_carried: u64, carry_wrapped: bool) -> DurationResult {
        transition carry_wrapped {
            true -> add_overflow()
            false -> add_gate(seconds_carried, nanoseconds_reduced)
        }
    }
    state add_flat(&self, nanoseconds_total: u32, seconds_sum: u64, seconds_wrapped: bool) -> DurationResult {
        transition seconds_wrapped {
            true -> add_overflow()
            false -> add_gate(seconds_sum, nanoseconds_total)
        }
    }
    state add_gate(&self, seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        transition nanoseconds_final <= 999999999 {
            true -> add_emit(seconds_final, nanoseconds_final)
            false -> add_overflow()
        }
    }
    state add_emit(&self, seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        // `% 1000000000` INLINE in the field value: construction checks are
        // flow-insensitive, and modulo bounds by the divisor, so the ranged
        // store proves right here; the gate already ensured the mod is an
        // identity at runtime.
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state add_overflow(&self) -> DurationResult {
        DurationResult::Overflow
    }
}

// self - other; `Overflow` (underflow) when other exceeds self.
//
// AUTHORING RULE (native face, 2026-07-07): in an inlined VALUE-machine body,
// `self.field`/`other.field` reads in POST-ENTRY states resolve against the
// CALLER's frame (receiver substitution reaches only the entry) -- a silent
// wrong-read. Parked repro:
// canaries/pending/time/value_machine_receiver_field_postentry. Until the
// backend lowers (or fences) it, every machine here reads fields ONLY in its
// entry and threads scalars/booleans; post-entry states consume params only.
machine Duration::checked_subtract(&self, other: Duration) -> DurationResult {
    let seconds_bigger: bool = self.seconds > other.seconds;
    let seconds_equal: bool = self.seconds == other.seconds;
    let nanoseconds_fit: bool = self.subsecond_nanoseconds >= other.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping =
        (self.seconds as u64 in Wrapping) - (other.seconds as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    // The final `as u32` re-domains each wrapped result to Exact IN THE LET:
    // a payload field value of shape `(cast) % literal` is silently dropped by
    // the parallel write cascade (known landmine, filed in TASKS.md), so the
    // emit states must see a BARE param (`nanoseconds_final % 1000000000`).
    let nanoseconds_direct: u32 = ((self.subsecond_nanoseconds as u32 in Wrapping)
        - (other.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (other.subsecond_nanoseconds as u32 in Wrapping))
        + (self.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> subtract_bigger(nanoseconds_fit, seconds_direct, seconds_borrowed, nanoseconds_direct, nanoseconds_borrowed)
        false -> subtract_equal_or_less(seconds_equal, nanoseconds_fit, seconds_direct, nanoseconds_direct)
    }

    state subtract_bigger(&self, nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> DurationResult {
        // Seconds strictly bigger: a nanosecond borrow cannot underflow.
        transition nanoseconds_fit {
            true -> subtract_emit(seconds_direct, nanoseconds_direct)
            false -> subtract_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state subtract_equal_or_less(&self, seconds_equal: bool, nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32) -> DurationResult {
        transition seconds_equal && nanoseconds_fit {
            true -> subtract_emit(seconds_direct, nanoseconds_direct)
            false -> subtract_underflow()
        }
    }
    state subtract_emit(&self, seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        // Inline `%` bounds the ranged store flow-insensitively; the guarded
        // arms above ensured it is an identity at runtime.
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state subtract_underflow(&self) -> DurationResult {
        DurationResult::Overflow
    }
}

// self * factor; `Overflow` when the true product exceeds the range.
machine Duration::checked_multiply(&self, factor: u32) -> DurationResult {
    let factor_wide: u64 = factor as u64;
    // Subsecond product fits u64 by math ([0..=999_999_999] * [0..=u32::MAX])
    // but the interval fold cannot multiply variable bounds -- Wrapping
    // spelling, correctness carried by the bounds themselves.
    let nano_product_wrapped: u64 in Wrapping =
        (self.subsecond_nanoseconds as u64 in Wrapping) * (factor_wide as u64 in Wrapping);
    let nano_product: u64 = nano_product_wrapped as u64;
    let extra_seconds: u64 = nano_product / 1000000000;
    let nano_remainder_wide: u64 = nano_product % 1000000000;
    let nano_remainder: u32 = nano_remainder_wide as u32;
    // Division-free u64 overflow detection for seconds * factor via the
    // 32-bit split (the interpreter's div/mod on msb-set u64 was only just
    // taught unsignedness; shifts and adds need no such care):
    // seconds = hi<<32 | lo. Overflow iff hi*factor exceeds 32 bits or a
    // carry wraps (wrapped-compare idiom).
    let seconds_high: u64 = self.seconds >> 32;
    let seconds_low: u64 = self.seconds & 4294967295;
    let high_product_wrapped: u64 in Wrapping =
        (seconds_high as u64 in Wrapping) * (factor_wide as u64 in Wrapping);
    let high_product: u64 = high_product_wrapped as u64;
    let low_product_wrapped: u64 in Wrapping =
        (seconds_low as u64 in Wrapping) * (factor_wide as u64 in Wrapping);
    let low_product: u64 = low_product_wrapped as u64;
    let high_fits: bool = high_product <= 4294967295;
    let high_shifted: u64 in Wrapping = (high_product as u64 in Wrapping) << 32;
    let seconds_product: u64 in Wrapping =
        (high_shifted as u64 in Wrapping) + (low_product as u64 in Wrapping);
    let product_wrapped: bool = seconds_product < low_product;
    let final_seconds: u64 in Wrapping =
        (seconds_product as u64 in Wrapping) + (extra_seconds as u64 in Wrapping);
    let final_wrapped: bool = final_seconds < seconds_product;
    transition high_fits {
        true -> multiply_carry_gate(product_wrapped, final_wrapped, final_seconds, nano_remainder)
        false -> multiply_overflow()
    }
    state multiply_carry_gate(&self, product_wrapped: bool, final_wrapped: bool, final_seconds: u64, nano_remainder: u32) -> DurationResult {
        transition product_wrapped {
            true -> multiply_overflow()
            false -> multiply_final_gate(final_wrapped, final_seconds, nano_remainder)
        }
    }
    state multiply_final_gate(&self, final_wrapped: bool, final_seconds: u64, nano_remainder: u32) -> DurationResult {
        transition final_wrapped {
            true -> multiply_overflow()
            false -> multiply_emit(final_seconds, nano_remainder)
        }
    }
    state multiply_emit(&self, seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state multiply_overflow(&self) -> DurationResult {
        DurationResult::Overflow
    }
}

// self / divisor; the `Overflow` case doubles as the divisor-0 signal (a
// guard, never a runtime fault -- per the settled surface). The subsecond
// remainder of the seconds division redistributes into the nanoseconds.
machine Duration::divide(&self, divisor: u32) -> DurationResult {
    // ENTRY-ONLY discipline: entry lets evaluate eagerly, so a zero divisor
    // is bumped to 1 (`divisor + (divisor == 0)` -- the comparison->int
    // coercion is intended semantics) and the real zero case routes to the
    // Overflow arm, ignoring the harmlessly-computed values.
    let divisor_is_zero: bool = divisor == 0;
    let zero_bump: u64 = (divisor == 0) as u64;
    let safe_divisor: u64 = (divisor as u64) + zero_bump;
    let seconds_quotient: u64 = self.seconds / safe_divisor;
    let seconds_remainder: u64 = self.seconds % safe_divisor;
    // remainder < divisor <= u32::MAX, so this fits u64 by math; Wrapping
    // spelling because the fold cannot multiply variable bounds.
    let total_wrapped: u64 in Wrapping = ((seconds_remainder as u64 in Wrapping)
        * 1000000000)
        + (self.subsecond_nanoseconds as u64 in Wrapping);
    let total_subnanoseconds: u64 = total_wrapped as u64;
    let sub_quotient_wide: u64 = total_subnanoseconds / safe_divisor;
    let sub_quotient_bounded: u64 = sub_quotient_wide % 1000000000;
    let sub_quotient: u32 = sub_quotient_bounded as u32;
    transition divisor_is_zero {
        true -> divide_by_zero()
        false -> divide_emit(seconds_quotient, sub_quotient)
    }
    state divide_emit(&self, seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state divide_by_zero(&self) -> DurationResult {
        DurationResult::Overflow
    }
}

// self + other, clamping at MAX instead of reporting overflow (total).
machine Duration::saturating_add(&self, other: Duration) -> Duration {
    let sum: DurationResult = self.checked_add(other);
    transition sum {
        DurationResult::Ok { duration } -> saturate_add_value(duration)
        DurationResult::Overflow -> saturate_add_max()
    }
    state saturate_add_value(&self, duration: Duration) -> Duration { duration }
    state saturate_add_max(&self) -> Duration { Duration::MAX }
}

// self - other, clamping at ZERO instead of reporting underflow (total, the
// ZII-friendly default the wrapper types lean on).
machine Duration::saturating_subtract(&self, other: Duration) -> Duration {
    let difference: DurationResult = self.checked_subtract(other);
    transition difference {
        DurationResult::Ok { duration } -> saturate_value(duration)
        DurationResult::Overflow -> saturate_zero()
    }
    state saturate_value(&self, duration: Duration) -> Duration { duration }
    state saturate_zero(&self) -> Duration { Duration::ZERO }
}

machine Duration::compare(&self, other: Duration) -> Ordering {
    // Entry-only field reads (see checked_subtract's authoring rule).
    let seconds_greater: bool = self.seconds > other.seconds;
    let seconds_less: bool = self.seconds < other.seconds;
    let nanoseconds_greater: bool = self.subsecond_nanoseconds > other.subsecond_nanoseconds;
    let nanoseconds_less: bool = self.subsecond_nanoseconds < other.subsecond_nanoseconds;
    transition seconds_greater {
        true -> compare_greater()
        false -> compare_seconds_rest(seconds_less, nanoseconds_greater, nanoseconds_less)
    }
    state compare_seconds_rest(&self, seconds_less: bool, nanoseconds_greater: bool, nanoseconds_less: bool) -> Ordering {
        transition seconds_less {
            true -> compare_less()
            false -> compare_nanoseconds(nanoseconds_greater, nanoseconds_less)
        }
    }
    state compare_nanoseconds(&self, nanoseconds_greater: bool, nanoseconds_less: bool) -> Ordering {
        transition nanoseconds_greater {
            true -> compare_greater()
            false -> compare_nanoseconds_rest(nanoseconds_less)
        }
    }
    state compare_nanoseconds_rest(&self, nanoseconds_less: bool) -> Ordering {
        transition nanoseconds_less {
            true -> compare_less()
            false -> compare_equal()
        }
    }
    state compare_less(&self) -> Ordering { Ordering::Less }
    state compare_equal(&self) -> Ordering { Ordering::Equal }
    state compare_greater(&self) -> Ordering { Ordering::Greater }
}

machine Duration::is_less_than(&self, other: Duration) -> bool {
    let order: Ordering = self.compare(other);
    transition order {
        Ordering::Less -> less_yes()
        Ordering::Equal -> less_no()
        Ordering::Greater -> less_no()
    }
    state less_yes(&self) -> bool { true }
    state less_no(&self) -> bool { false }
}

machine Duration::is_greater_than(&self, other: Duration) -> bool {
    let order: Ordering = self.compare(other);
    transition order {
        Ordering::Greater -> greater_yes()
        Ordering::Less -> greater_no()
        Ordering::Equal -> greater_no()
    }
    state greater_yes(&self) -> bool { true }
    state greater_no(&self) -> bool { false }
}

// A point on the MONOTONIC clock, normalized at `now()` (D6): whole seconds +
// subsecond nanoseconds since an UNSPECIFIED epoch. Opaque-by-convention --
// only differences between two Instants from the same process are meaningful.
// Same field shapes as Duration, so the subtraction machinery mirrors it.
data Instant [copy, zero_init] {
    seconds: u64;
    subsecond_nanoseconds: u32 [0..=999_999_999];
}

// self - earlier as a Duration; `Overflow` when `earlier` is later than self
// (the monotonic clock cannot run backwards, so this means the caller swapped
// the operands or mixed instants across processes). Mirrors
// Duration::checked_subtract -- same borrow idiom, same authoring rules.
machine Instant::checked_duration_since(&self, earlier: Instant) -> DurationResult {
    let seconds_bigger: bool = self.seconds > earlier.seconds;
    let seconds_equal: bool = self.seconds == earlier.seconds;
    let nanoseconds_fit: bool = self.subsecond_nanoseconds >= earlier.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping =
        (self.seconds as u64 in Wrapping) - (earlier.seconds as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    let nanoseconds_direct: u32 = ((self.subsecond_nanoseconds as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping))
        + (self.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> since_bigger(nanoseconds_fit, seconds_direct, seconds_borrowed, nanoseconds_direct, nanoseconds_borrowed)
        false -> since_equal_or_less(seconds_equal, nanoseconds_fit, seconds_direct, nanoseconds_direct)
    }
    state since_bigger(&self, nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> DurationResult {
        transition nanoseconds_fit {
            true -> since_emit(seconds_direct, nanoseconds_direct)
            false -> since_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state since_equal_or_less(&self, seconds_equal: bool, nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32) -> DurationResult {
        transition seconds_equal && nanoseconds_fit {
            true -> since_emit(seconds_direct, nanoseconds_direct)
            false -> since_backwards()
        }
    }
    state since_emit(&self, seconds_final: u64, nanoseconds_final: u32) -> DurationResult {
        DurationResult::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state since_backwards(&self) -> DurationResult {
        DurationResult::Overflow
    }
}

// self - earlier, clamping at ZERO instead of reporting the backwards case
// (total, the ZII-friendly default -- Rust's `duration_since` panics here).
// Mirrors Duration::saturating_subtract (transitioning on a nested sibling
// call's result is safe again since the guard-ZII slot-naming fix,
// 2026-07-08 -- pinned by calls/runtime_nested_value_call_guard_exit).
machine Instant::duration_since(&self, earlier: Instant) -> Duration {
    let since: DurationResult = self.checked_duration_since(earlier);
    transition since {
        DurationResult::Ok { duration } -> since_value(duration)
        DurationResult::Overflow -> since_zero()
    }
    state since_value(&self, duration: Duration) -> Duration { duration }
    state since_zero(&self) -> Duration { Duration::ZERO }
}

// A point on the WALL clock (D7): signed Unix-epoch seconds (pre-1970
// timestamps exist -- filesystem metadata bridges here) + subsecond
// nanoseconds. ZII zero IS the Unix epoch.
data SystemTime [copy, zero_init] {
    seconds_since_unix_epoch: i64;
    subsecond_nanoseconds: u32 [0..=999_999_999];
}

const SystemTime::UNIX_EPOCH: SystemTime = SystemTime { seconds_since_unix_epoch: 0, subsecond_nanoseconds: 0 };

// `duration_since`'s result: the wall clock is NOT monotonic, so "earlier is
// actually later" is an ORDINARY outcome (NTP step, manual clock set), not an
// error -- the Backwards case carries the amount. The ZII zero case must be
// payload-free, and `Unmeasured` is the honest reading of an untouched
// result: never a fake Ok, never a fabricated Backwards(ZERO) measurement.
// (Deviation from the TASKS_TIME.md sketch, which had no zero case -- noted
// there.) `duration_since` itself never produces Unmeasured.
data SystemTimeDifference [copy, zero_init] {
    case Unmeasured;
    case Backwards(amount: Duration);
    case Ok(duration: Duration);
}

// Bridge from filesystem `Metadata` timestamps (and any other i64 Unix
// source): whole seconds, zero subseconds.
machine SystemTime::from_unix_seconds(seconds: i64) -> SystemTime {
    SystemTime { seconds_since_unix_epoch: seconds, subsecond_nanoseconds: 0 }
}

// self - earlier as a Duration, or Backwards(earlier - self) when the wall
// clock ran backwards. The seconds difference of two i64s always fits u64
// (i64::MAX - i64::MIN == u64::MAX), computed as a u64 BIT-PATTERN wrapping
// subtraction -- two's complement makes it the true difference whenever the
// dominating compare proves the sign. Same borrow idiom as
// Duration::checked_subtract, both directions precomputed in entry lets.
machine SystemTime::duration_since(&self, earlier: SystemTime) -> SystemTimeDifference {
    let seconds_bigger: bool = self.seconds_since_unix_epoch > earlier.seconds_since_unix_epoch;
    let seconds_equal: bool = self.seconds_since_unix_epoch == earlier.seconds_since_unix_epoch;
    let nanoseconds_fit: bool = self.subsecond_nanoseconds >= earlier.subsecond_nanoseconds;
    let back_nanoseconds_fit: bool = earlier.subsecond_nanoseconds >= self.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping = (self.seconds_since_unix_epoch as u64 in Wrapping)
        - (earlier.seconds_since_unix_epoch as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    let nanoseconds_direct: u32 = ((self.subsecond_nanoseconds as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (earlier.subsecond_nanoseconds as u32 in Wrapping))
        + (self.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let back_seconds_direct: u64 in Wrapping = (earlier.seconds_since_unix_epoch as u64 in Wrapping)
        - (self.seconds_since_unix_epoch as u64 in Wrapping);
    let back_seconds_borrowed: u64 in Wrapping = (back_seconds_direct as u64 in Wrapping) - 1;
    let back_nanoseconds_direct: u32 = ((earlier.subsecond_nanoseconds as u32 in Wrapping)
        - (self.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let back_nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (self.subsecond_nanoseconds as u32 in Wrapping))
        + (earlier.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> wall_bigger(nanoseconds_fit, seconds_direct, seconds_borrowed, nanoseconds_direct, nanoseconds_borrowed)
        false -> wall_equal_or_less(seconds_equal, nanoseconds_fit, back_nanoseconds_fit, seconds_direct, nanoseconds_direct, back_seconds_direct, back_seconds_borrowed, back_nanoseconds_direct, back_nanoseconds_borrowed)
    }
    state wall_bigger(&self, nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> SystemTimeDifference {
        transition nanoseconds_fit {
            true -> wall_emit_ok(seconds_direct, nanoseconds_direct)
            false -> wall_emit_ok(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state wall_equal_or_less(&self, seconds_equal: bool, nanoseconds_fit: bool, back_nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32, back_seconds_direct: u64, back_seconds_borrowed: u64, back_nanoseconds_direct: u32, back_nanoseconds_borrowed: u32) -> SystemTimeDifference {
        transition seconds_equal && nanoseconds_fit {
            true -> wall_emit_ok(seconds_direct, nanoseconds_direct)
            false -> wall_backwards_split(seconds_equal, back_nanoseconds_fit, back_seconds_direct, back_seconds_borrowed, back_nanoseconds_direct, back_nanoseconds_borrowed)
        }
    }
    state wall_backwards_split(&self, seconds_equal: bool, back_nanoseconds_fit: bool, back_seconds_direct: u64, back_seconds_borrowed: u64, back_nanoseconds_direct: u32, back_nanoseconds_borrowed: u32) -> SystemTimeDifference {
        // seconds equal here means self.sub < earlier.sub: no borrow needed.
        transition seconds_equal {
            true -> wall_emit_backwards(back_seconds_direct, back_nanoseconds_direct)
            false -> wall_backwards_borrow(back_nanoseconds_fit, back_seconds_direct, back_seconds_borrowed, back_nanoseconds_direct, back_nanoseconds_borrowed)
        }
    }
    state wall_backwards_borrow(&self, back_nanoseconds_fit: bool, back_seconds_direct: u64, back_seconds_borrowed: u64, back_nanoseconds_direct: u32, back_nanoseconds_borrowed: u32) -> SystemTimeDifference {
        transition back_nanoseconds_fit {
            true -> wall_emit_backwards(back_seconds_direct, back_nanoseconds_direct)
            false -> wall_emit_backwards(back_seconds_borrowed, back_nanoseconds_borrowed)
        }
    }
    state wall_emit_ok(&self, seconds_final: u64, nanoseconds_final: u32) -> SystemTimeDifference {
        SystemTimeDifference::Ok {
            duration: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
    state wall_emit_backwards(&self, seconds_final: u64, nanoseconds_final: u32) -> SystemTimeDifference {
        SystemTimeDifference::Backwards {
            amount: Duration {
                seconds: seconds_final,
                subsecond_nanoseconds: nanoseconds_final % 1000000000,
            },
        }
    }
}

// The clock-read CAPABILITY (D9): reads live here, never ambiently on the
// value types -- Rust's `Instant::now()`/`Instant::elapsed()` intentionally
// have no equivalent (the Cathedral no-ambient-authority stance).
data Time {
    host: TimeHost;
}

// Read the monotonic clock and normalize ONCE (D6): raw ticks + calibration
// in, (seconds, subsecond_nanoseconds) out. All conversion math lives here,
// per D11 -- the lowering layer only delivers raw u64s.
//
// The `clamp` IS the calibration guard (O2's proof bound, D5): frequency in
// [1, 18_446_744_073] proves the divisor nonzero AND that
// `remainder * 1_000_000_000` fits u64 (remainder < frequency). Every real
// host passes through unchanged (windows QPF 10^7 or 10^6-ish, POSIX 10^9,
// the interpreter's virtual 1000); a host reporting 0 or an absurd frequency
// measures degraded instead of faulting. Re-read per call: Time stays
// stateless (no capture-once field machinery) until a profile says otherwise.
machine Time::now(&mut self) -> Instant {
    let ticks: u64 = self.host.monotonic_ticks();
    let frequency_raw: u64 = self.host.monotonic_ticks_per_second();
    let frequency: u64 = clamp(frequency_raw, 1, 18446744073);
    let whole_seconds: u64 = ticks / frequency;
    let remainder: u64 = ticks % frequency;
    // Fits u64 by the clamp bound, but the interval fold cannot multiply
    // variable bounds -- Wrapping spelling (the checked_multiply idiom).
    let scaled_wrapped: u64 in Wrapping = (remainder as u64 in Wrapping) * 1000000000;
    let scaled: u64 = scaled_wrapped as u64;
    let subnanos_wide: u64 = scaled / frequency;
    // Ranged-let witness: the `%` bounds the ranged store flow-insensitively
    // (construction checks see only the let's declared range); it is an
    // identity at runtime (the quotient is < 10^9 by math).
    let subsecond: u32 [0..=999999999] = subnanos_wide % 1000000000;
    Instant { seconds: whole_seconds, subsecond_nanoseconds: subsecond }
}

// Read the wall clock: ONE raw read (D11, no second-boundary tearing) +
// the two per-target calibration constants, all conversion math here.
// `unix = raw / units - offset`; the subtraction is a u64 wrapping let whose
// value is only USED on the after-epoch arm the dominating compare proves
// (the checked_subtract idiom); `% i64::MAX` is the ranged witness for the
// i64 narrowing (real clocks sit ~1.7e9, the bound only tames the prover).
// A host clock before 1970 reads as UNIX_EPOCH (degraded, never faulting).
machine Time::system_time_now(&mut self) -> SystemTime {
    let raw: u64 = self.host.wall_clock_raw();
    let units_raw: u64 = self.host.wall_clock_units_per_second();
    let offset: u64 = self.host.wall_clock_epoch_offset_seconds();
    // The same clamp-as-calibration-guard as `now()` (D5 proof bound).
    let units: u64 = clamp(units_raw, 1, 18446744073);
    let platform_seconds: u64 = raw / units;
    let remainder: u64 = raw % units;
    let scaled_wrapped: u64 in Wrapping = (remainder as u64 in Wrapping) * 1000000000;
    let scaled: u64 = scaled_wrapped as u64;
    let subnanos_wide: u64 = scaled / units;
    let subsecond: u32 [0..=999999999] = subnanos_wide % 1000000000;
    let is_after_epoch: bool = platform_seconds >= offset;
    let unix_wrapped: u64 in Wrapping = (platform_seconds as u64 in Wrapping)
        - (offset as u64 in Wrapping);
    let unix_bounded: u64 = (unix_wrapped as u64) % 9223372036854775807;
    let unix_seconds: i64 = unix_bounded as i64;
    transition is_after_epoch {
        true -> wall_now_emit(unix_seconds, subsecond)
        false -> wall_now_before_epoch()
    }
    state wall_now_emit(&mut self, unix_seconds: i64, subsecond: u32) -> SystemTime {
        SystemTime {
            seconds_since_unix_epoch: unix_seconds,
            subsecond_nanoseconds: subsecond % 1000000000,
        }
    }
    state wall_now_before_epoch(&mut self) -> SystemTime { SystemTime::UNIX_EPOCH }
}

// The stopwatch read: monotonic-now minus `start`, saturating at ZERO (a
// start Instant from a different process/boot measures garbage; ZERO is the
// honest total answer). `now().duration_since(start)` composition.
// SINGLE-LEVEL body: the natural composition
// (`self.now().duration_since(start)`) needs a value call on a LOCAL
// receiver, which zeroes natively today (receiver resolution reaches FIELDS
// only -- filed in TASKS.md). Until that lands, this inlines now()'s
// normalization + the checked_duration_since borrow idiom over entry lets.
machine Time::elapsed_since(&mut self, start: Instant) -> Duration {
    let stopwatch_ticks: u64 = self.host.monotonic_ticks();
    let stopwatch_frequency_raw: u64 = self.host.monotonic_ticks_per_second();
    let stopwatch_frequency: u64 = clamp(stopwatch_frequency_raw, 1, 18446744073);
    let now_seconds: u64 = stopwatch_ticks / stopwatch_frequency;
    let stopwatch_remainder: u64 = stopwatch_ticks % stopwatch_frequency;
    let stopwatch_scaled_wrapped: u64 in Wrapping = (stopwatch_remainder as u64 in Wrapping) * 1000000000;
    let stopwatch_scaled: u64 = stopwatch_scaled_wrapped as u64;
    let stopwatch_subnanos_wide: u64 = stopwatch_scaled / stopwatch_frequency;
    let now_subsecond_wide: u64 = stopwatch_subnanos_wide % 1000000000;
    let now_subsecond: u32 = now_subsecond_wide as u32;
    let seconds_bigger: bool = now_seconds > start.seconds;
    let seconds_equal: bool = now_seconds == start.seconds;
    let nanoseconds_fit: bool = now_subsecond >= start.subsecond_nanoseconds;
    let seconds_direct: u64 in Wrapping = (now_seconds as u64 in Wrapping)
        - (start.seconds as u64 in Wrapping);
    let seconds_borrowed: u64 in Wrapping = (seconds_direct as u64 in Wrapping) - 1;
    let nanoseconds_direct: u32 = ((now_subsecond as u32 in Wrapping)
        - (start.subsecond_nanoseconds as u32 in Wrapping)) as u32;
    let nanoseconds_borrowed: u32 = (((1000000000 as u32 in Wrapping)
        - (start.subsecond_nanoseconds as u32 in Wrapping))
        + (now_subsecond as u32 in Wrapping)) as u32;
    transition seconds_bigger == true {
        true -> elapsed_bigger(nanoseconds_fit, seconds_direct, seconds_borrowed, nanoseconds_direct, nanoseconds_borrowed)
        false -> elapsed_equal_or_less(seconds_equal, nanoseconds_fit, seconds_direct, nanoseconds_direct)
    }
    state elapsed_bigger(&mut self, nanoseconds_fit: bool, seconds_direct: u64, seconds_borrowed: u64, nanoseconds_direct: u32, nanoseconds_borrowed: u32) -> Duration {
        transition nanoseconds_fit {
            true -> elapsed_emit(seconds_direct, nanoseconds_direct)
            false -> elapsed_emit(seconds_borrowed, nanoseconds_borrowed)
        }
    }
    state elapsed_equal_or_less(&mut self, seconds_equal: bool, nanoseconds_fit: bool, seconds_direct: u64, nanoseconds_direct: u32) -> Duration {
        transition seconds_equal && nanoseconds_fit {
            true -> elapsed_emit(seconds_direct, nanoseconds_direct)
            false -> elapsed_backwards()
        }
    }
    state elapsed_emit(&mut self, seconds_final: u64, nanoseconds_final: u32) -> Duration {
        Duration {
            seconds: seconds_final,
            subsecond_nanoseconds: nanoseconds_final % 1000000000,
        }
    }
    // A start Instant from a different process/boot can sit "ahead" of now:
    // saturate at ZERO (total, never faulting).
    state elapsed_backwards(&mut self) -> Duration { Duration::ZERO }
}
