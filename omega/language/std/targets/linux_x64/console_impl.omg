// Complete linux_x64 Console provider closure over compiler-known native
// byte/runtime leaves. Friendly write adapters live in std/console.omg on the
// same nominal provider type.
linux_x64 machine ConsoleNativeProvider::read_line(out_line: &mut [u8])
    satisfies Console::read_line
    via Binding::CompilerIntrinsic("Console::read_line");
linux_x64 machine ConsoleNativeProvider::read_byte() -> ByteRead
    satisfies Console::read_byte
    via Binding::CompilerIntrinsic("Console::read_byte");
linux_x64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
    via Binding::CompilerIntrinsic("Console::write_byte");
linux_x64 machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process
    via Binding::CompilerIntrinsic("Console::exit_process");

linux_x64 machine ConsoleNativeProvider::provider_defaults(defaults: &mut ConsoleNativeProvider) {
    defaults.select_provider<Console, ConsoleNativeProvider>();
}
