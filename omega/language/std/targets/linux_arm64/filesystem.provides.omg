// Transitional per-target `FilesystemHost` VALUE rows for `struct stat` byte
// offsets. Open flags have moved to the checked target format encoder in
// `filesystem_impl.omg`; offsets remain only until foreign record views consume
// the programmable layout plan directly.
linux_arm64 provides FilesystemHost {
    // PLACEHOLDER (darwin-shaped): see linux_x64 above.
    ST_DEV_OFF    -> 0;
    ST_MODE_OFF   -> 4;
    ST_NLINK_OFF  -> 6;
    ST_INO_OFF    -> 8;
    ST_UID_OFF    -> 16;
    ST_GID_OFF    -> 20;
    ST_RDEV_OFF   -> 24;
    ST_ATIME_OFF  -> 32;
    ST_MTIME_OFF  -> 48;
    ST_CTIME_OFF  -> 64;
    ST_BTIME_OFF  -> 80;
    ST_SIZE_OFF   -> 96;
    ST_BLOCKS_OFF -> 104;
    ST_BLKSIZE_OFF -> 112;
}
