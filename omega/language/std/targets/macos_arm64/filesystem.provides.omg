// Per-target `FilesystemHost` provides VALUES (portable-values settle
// 2026-07-07; std/targets file shape settled 2026-07-07): open-flag constants
// and `struct stat` byte offsets consumed by the portable wrapper. The
// single-bit open flags are BIT POSITIONS (`_BIT`), not values, so the wrapper
// composes them as `(bool as i32) << BIT` -- a shift of a small positive,
// which the native i32 backend and the i64 interpreter agree on. Access mode
// O_WRONLY(1)/O_RDWR(2) is a universal 2-bit value; O_BINARY is a windows-only
// whole value (0 elsewhere). darwin O_CREAT (0x200) equals msvcrt O_TRUNC
// (0x200), which is exactly why none of this can be hardcoded portably.
macos_arm64 provides FilesystemHost {
    O_WRONLY     -> 1;
    O_RDWR       -> 2;
    O_APPEND_BIT -> 3;
    O_CREATE_BIT -> 9;
    O_TRUNC_BIT  -> 10;
    O_EXCL_BIT   -> 11;
    O_BINARY     -> 0;
    // darwin `struct stat` (64-bit) byte offsets. Every Metadata field has a real
    // home here (darwin's stat carries ino/uid/gid/ctime/blocks/blksize/birthtime),
    // so no synthetic tail is needed.
    ST_DEV_OFF    -> 0;
    ST_MODE_OFF   -> 4;
    ST_NLINK_OFF  -> 6;
    ST_INO_OFF    -> 8;
    ST_UID_OFF    -> 16;
    ST_GID_OFF    -> 20;
    ST_RDEV_OFF   -> 24;
    ST_ATIME_OFF  -> 32;
    ST_MTIME_OFF  -> 48;
    ST_CTIME_OFF  -> 64;
    ST_BTIME_OFF  -> 80;
    ST_SIZE_OFF   -> 96;
    ST_BLOCKS_OFF -> 104;
    ST_BLKSIZE_OFF -> 112;
}
