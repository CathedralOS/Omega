// Transitional per-target `FilesystemHost` VALUE rows for `struct _stat64`
// byte offsets. Open flags have moved to the checked target format encoder in
// `filesystem_impl.omg`; offsets remain only until foreign record views consume
// the programmable layout plan directly.
windows_x64 provides FilesystemHost {
    // `struct _stat64` (msvcrt) byte offsets, consumed by `decode_metadata` /
    // `copy` as `stat_buf[ST_*_OFF + k]`. `_stat64` is 56 bytes; the DEV/MODE/
    // NLINK/RDEV/SIZE/ATIME/MTIME + creation-as-BTIME fields sit at their real
    // offsets (0..55). The fields absent or width-mismatched in `_stat64`
    // (ino/uid/gid, the status-CHANGE time, blocks, blksize) live in a SYNTHETIC
    // TAIL (>=64) that the hermetic interpreter fills but a real native `_stat64`
    // leaves zero -- so native windows reports 0 for those, which is honest
    // (NTFS ino is unreliable; no blocks/blksize/ctime). See TASKS_FS metadata rung.
    ST_DEV_OFF    -> 0;
    ST_MODE_OFF   -> 6;
    ST_NLINK_OFF  -> 8;
    ST_RDEV_OFF   -> 16;
    ST_SIZE_OFF   -> 24;
    ST_ATIME_OFF  -> 32;
    ST_MTIME_OFF  -> 40;
    ST_BTIME_OFF  -> 48;
    ST_INO_OFF    -> 64;
    ST_UID_OFF    -> 72;
    ST_GID_OFF    -> 76;
    ST_CTIME_OFF  -> 80;
    ST_BLOCKS_OFF -> 88;
    ST_BLKSIZE_OFF -> 96;
}
