// Per-target `FilesystemHost` provides VALUES (portable-values settle
// 2026-07-07; std/targets file shape settled 2026-07-07): open-flag constants
// and `struct stat` byte offsets consumed by the portable wrapper. The
// single-bit open flags are BIT POSITIONS (`_BIT`), not values, so the wrapper
// composes them as `(bool as i32) << BIT` -- a shift of a small positive,
// which the native i32 backend and the i64 interpreter agree on. Access mode
// O_WRONLY(1)/O_RDWR(2) is a universal 2-bit value; O_BINARY is a windows-only
// whole value (0 elsewhere). darwin O_CREAT (0x200) equals msvcrt O_TRUNC
// (0x200), which is exactly why none of this can be hardcoded portably.
windows_x64 provides FilesystemHost {
    O_WRONLY     -> 1;
    O_RDWR       -> 2;
    O_APPEND_BIT -> 3;
    O_CREATE_BIT -> 8;
    O_TRUNC_BIT  -> 9;
    O_EXCL_BIT   -> 10;
    O_BINARY     -> 32768;
    // `struct _stat64` (msvcrt) byte offsets, consumed by `decode_metadata` /
    // `copy` as `stat_buf[ST_*_OFF + k]`. `_stat64` is 56 bytes; the DEV/MODE/
    // NLINK/RDEV/SIZE/ATIME/MTIME + creation-as-BTIME fields sit at their real
    // offsets (0..55). The fields absent or width-mismatched in `_stat64`
    // (ino/uid/gid, the status-CHANGE time, blocks, blksize) live in a SYNTHETIC
    // TAIL (>=64) that the hermetic interpreter fills but a real native `_stat64`
    // leaves zero -- so native windows reports 0 for those, which is honest
    // (NTFS ino is unreliable; no blocks/blksize/ctime). See TASKS_FS metadata rung.
    ST_DEV_OFF    -> 0;
    ST_MODE_OFF   -> 6;
    ST_NLINK_OFF  -> 8;
    ST_RDEV_OFF   -> 16;
    ST_SIZE_OFF   -> 24;
    ST_ATIME_OFF  -> 32;
    ST_MTIME_OFF  -> 40;
    ST_BTIME_OFF  -> 48;
    ST_INO_OFF    -> 64;
    ST_UID_OFF    -> 72;
    ST_GID_OFF    -> 76;
    ST_CTIME_OFF  -> 80;
    ST_BLOCKS_OFF -> 88;
    ST_BLKSIZE_OFF -> 96;
}
