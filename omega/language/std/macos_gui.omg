// The macOS Gui backend — an ordinary Omega WRAPPER that implements the samples'
// Win32-shaped `Gui` trait by composing the proven Objective-C / Core Graphics
// boundary primitives (`objc_getClass`/`objc_msgSend`/`CGBitmapContextCreate`/…).
// Mirrors `omega::language::std::filesystem`'s pattern: a `data` type holding the
// boundary handles + scratch FIELDS, its ops consumed via terminal-value
// completion (never a transition guard on the raw host result). No C shim — Omega
// calls Cocoa directly, the same way the fs seam calls libc.
//
// The samples call `self.gui.window_create(cls, title, style, x, y, w, h)` etc.
// through a `boundary trait Gui` field; on darwin that field is provided by this
// `MacosGui` (the boundary→provider substitution, task #57). Its ops are ordinary
// value-calls — run-verified (fire 22): the WHOLE window_demo shape (window +
// 60-frame blit + 3-op pump loop + liveness) runs natively through MacosGui value-
// calls (`fullpump` → exit 7). The op signatures here EXACTLY match the samples'
// `Gui` trait so the substitution is a drop-in provider.
//
// D-macgui-style: the Win32 `class_name`/`style` args are IGNORED — macOS always
// builds a standard titled/closable/resizable window (styleMask 15). The samples
// want a visible titled window; the Win32 class/style bits do not translate.

domain [u8]::CString when no_nul(self) {
}

// The Objective-C runtime seam (libobjc). Human method names; the `_objc_*`/`_sel_*`
// symbols live only in the darwin binding table.
boundary trait ObjectiveC {
    machine get_class(name: &[u8] in CString) -> u64;
    machine register_selector(name: &[u8] in CString) -> u64;
    machine send(recv: u64, sel: u64) -> u64;
    machine send_scalar(recv: u64, sel: u64, arg: u64) -> u64;
    machine send_rect(recv: u64, sel: u64, x: f64, y: f64, w: f64, h: f64, a: u64, b: u64, c: u64) -> u64;
    machine send_image_size(recv: u64, sel: u64, image: u64, w: f64, h: f64) -> u64;
    machine send_string(recv: u64, sel: u64, text: &[u8] in CString) -> u64;
    machine send_scalar4(recv: u64, sel: u64, a: u64, b: u64, c: u64, d: u64) -> u64;
}

// The Core Graphics seam (CoreGraphics framework) for the framebuffer blit.
boundary trait CoreGraphics {
    machine color_space_rgb() -> u64;
    // `data` is READ-ONLY here: the framebuffer is snapshotted into the CGImage
    // (`bitmap_context_image`), never drawn into, so an immutable ref suffices —
    // and a by-value `pixels` PARAM cannot be borrowed `&mut`. The ABI passes a
    // plain pointer either way.
    machine bitmap_context(data: &[i32], w: i64, h: i64, bpc: i64, stride: i64, space: u64, info: i64) -> u64;
    machine bitmap_context_image(ctx: u64) -> u64;
    // `CGEventSourceKeyState(state_id, keycode) -> bool` — is a physical key down?
    // The macOS backing for `Input.key_state` (see MacosInput below).
    machine event_source_key_state(state_id: u64, keycode: u64) -> u64;
}

data MacosGui {
    objc: ObjectiveC;
    cg: CoreGraphics;
    // The current window + its image-view content (single-window apps).
    window: u64;
    view: u64;
    app: u64;
    // A device-RGB colorspace, created once at window_create and reused per blit.
    space: u64;
    // Staged blit dimensions (a host-call arg must be a storage place / literal,
    // not a live cast expression, so the `as i64`/`as f64` results land in fields).
    fbw: i64;
    fbh: i64;
    stride: i64;
    fbwf: f64;
    fbhf: f64;
    // Pump scratch: the distantPast date, the run-loop-mode NSString, the
    // nextEvent selector, the event mask, and the last dequeued NSEvent.
    date: u64;
    mode: u64;
    psel: u64;
    mask: u64;
    evt: u64;
    // Scratch for the objc call sequences.
    cls: u64;
    sel: u64;
    tmp: u64;
    ctx: u64;
    cgimg: u64;
    nsimg: u64;
    rx: f64;
    ry: f64;
    rw: f64;
    rh: f64;
    rc: u64;
    r32: u32;
}

// `Gui::window_create` — open a titled window whose content view is an NSImageView
// (the blit target). Returns the NSWindow pointer (the samples check `> 0`).
machine MacosGui::window_create(&mut self, class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64 {
    self.rx = x as f64;
    self.ry = y as f64;
    self.rw = width as f64;
    self.rh = height as f64;
    self.cls = self.objc.get_class("NSApplication");
    self.sel = self.objc.register_selector("sharedApplication");
    self.app = self.objc.send(self.cls, self.sel);
    self.sel = self.objc.register_selector("setActivationPolicy:");
    self.rc = self.objc.send_scalar(self.app, self.sel, 0);
    self.cls = self.objc.get_class("NSWindow");
    self.sel = self.objc.register_selector("alloc");
    self.tmp = self.objc.send(self.cls, self.sel);
    self.sel = self.objc.register_selector("initWithContentRect:styleMask:backing:defer:");
    self.window = self.objc.send_rect(self.tmp, self.sel, self.rx, self.ry, self.rw, self.rh, 15, 2, 0);
    self.cls = self.objc.get_class("NSImageView");
    self.sel = self.objc.register_selector("alloc");
    self.tmp = self.objc.send(self.cls, self.sel);
    self.sel = self.objc.register_selector("initWithFrame:");
    self.view = self.objc.send_rect(self.tmp, self.sel, self.rx, self.ry, self.rw, self.rh, 0, 0, 0);
    self.sel = self.objc.register_selector("setContentView:");
    self.rc = self.objc.send_scalar(self.window, self.sel, self.view);
    self.sel = self.objc.register_selector("makeKeyAndOrderFront:");
    self.rc = self.objc.send_scalar(self.window, self.sel, 0);
    self.space = self.cg.color_space_rgb();
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.window }
}

// `Gui::blit` — copy a top-down 32bpp BGRA framebuffer into the window's image
// view: `CGBitmapContextCreate(&pixels)` → snapshot to a CGImage → `NSImage
// initWithCGImage:size:` → `[imageView setImage:]`. `dest_*` and `device`/`info`
// are ignored (the image view auto-scales; macOS is top-down like the source, so
// NO row flip). `stride = source_width * 4` via `<< 2` (shift is obligation-free).
machine MacosGui::blit(&mut self, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32 {
    self.fbw = source_width as i64;
    self.fbh = source_height as i64;
    self.stride = (source_width as i64) << 2;
    self.fbwf = source_width as f64;
    self.fbhf = source_height as f64;
    self.ctx = self.cg.bitmap_context(&pixels, self.fbw, self.fbh, 8, self.stride, self.space, 8198);
    self.cgimg = self.cg.bitmap_context_image(self.ctx);
    self.cls = self.objc.get_class("NSImage");
    self.sel = self.objc.register_selector("alloc");
    self.tmp = self.objc.send(self.cls, self.sel);
    self.sel = self.objc.register_selector("initWithCGImage:size:");
    self.nsimg = self.objc.send_image_size(self.tmp, self.sel, self.cgimg, self.fbwf, self.fbhf);
    self.sel = self.objc.register_selector("setImage:");
    self.rc = self.objc.send_scalar(self.view, self.sel, self.nsimg);
    // The samples assert `blit == source_height` (every source scanline copied).
    self.r32 = source_height;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::get_dc` — the samples pass the returned "device context" to `blit`; on
// macOS the drawing target is the window's image view, reached from the window, so
// `get_dc` just echoes the window handle back (the sample only checks `> 0`).
machine MacosGui::get_dc(&mut self, window: u64) -> u64 {
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { window }
}

// `Gui::msg_peek` — non-blocking event dequeue. `[NSApp nextEventMatchingMask:0xffffffff
// untilDate:[NSDate distantPast] inMode:kCFRunLoopDefaultMode dequeue:YES]`. Stashes
// the NSEvent in `self.evt` for `msg_dispatch`; returns 1 if an event was dequeued
// (the sample's `have`), 0 otherwise. The Win32 `message: [u64;6]` buffer is unused
// on macOS (the event is an NSEvent object, not a copied-out MSG struct).
machine MacosGui::msg_peek(&mut self, message: [u64; 6]) -> u32 {
    self.cls = self.objc.get_class("NSDate");
    self.sel = self.objc.register_selector("distantPast");
    self.date = self.objc.send(self.cls, self.sel);
    self.cls = self.objc.get_class("NSString");
    self.sel = self.objc.register_selector("alloc");
    self.tmp = self.objc.send(self.cls, self.sel);
    self.sel = self.objc.register_selector("initWithUTF8String:");
    self.mode = self.objc.send_string(self.tmp, self.sel, "kCFRunLoopDefaultMode");
    self.psel = self.objc.register_selector("nextEventMatchingMask:untilDate:inMode:dequeue:");
    self.mask = 4294967295;
    self.evt = self.objc.send_scalar4(self.app, self.psel, self.mask, self.date, self.mode, 1);
    self.r32 = 0;
    transition self.evt != 0 { true -> got() _ -> ret() }
    state got(&mut self) -> u32 {
        self.r32 = 1;
        transition { _ -> ret() }
    }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::msg_translate` — a Win32 keyboard pre-pass (WM_KEYDOWN → WM_CHAR). macOS
// has no equivalent step; Cocoa delivers characters directly via `sendEvent:`. A
// no-op that reports success (the sample only checks the count advances).
machine MacosGui::msg_translate(&mut self, message: [u64; 6]) -> u32 {
    self.r32 = 1;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::msg_dispatch` — route the dequeued event back to the app: `[NSApp sendEvent:
// self.evt]` (drives window dragging, the close button, key handling). Returns 0
// (Win32 DispatchMessage's LRESULT; the sample ignores it).
machine MacosGui::msg_dispatch(&mut self, message: [u64; 6]) -> u64 {
    self.sel = self.objc.register_selector("sendEvent:");
    self.rc = self.objc.send_scalar(self.app, self.sel, self.evt);
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.rc }
}

// `Gui::is_window` — liveness. `[window isVisible]` is a live, on-screen window.
machine MacosGui::is_window(&mut self, window: u64) -> u32 {
    self.sel = self.objc.register_selector("isVisible");
    self.rc = self.objc.send(window, self.sel);
    self.r32 = self.rc as u32;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::window_destroy` — `[window close]`. (Not in the samples' hot path, but part
// of the Win32 Gui trait; kept for completeness.)
machine MacosGui::window_destroy(&mut self, window: u64) -> u32 {
    self.sel = self.objc.register_selector("close");
    self.rc = self.objc.send_scalar(window, self.sel, 0);
    self.r32 = 1;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// The macOS `Input` backend — implements the samples' Win32-shaped `Input` trait
// (`key_state(virtual_key) -> u64`) by mapping a Win32 virtual-key to the macOS
// keycode and asking Core Graphics whether that physical key is currently down
// (`CGEventSourceKeyState`, HID system state = 1). On darwin the samples' `input:
// Input` boundary field is provided by this `MacosInput` (the boundary→provider
// substitution, task #57/#60), so `self.input.key_state(27)` (ESC) dispatches here
// as an ordinary value-call. Unmapped virtual-keys report "not down" (0) rather than
// querying a wrong keycode.
data MacosInput {
    cg: CoreGraphics;
    keycode: u64;
    rc: u64;
}

// Win32 VK -> macOS keycode: ESC 27->53, LEFT 37->123, RIGHT 39->124, UP 38->126,
// DOWN 40->125 (the keys the gui samples poll). Anything else -> not-down.
machine MacosInput::key_state(&mut self, virtual_key: u32) -> u64 {
    self.keycode = 0;
    transition virtual_key == 27 { true -> set_esc() _ -> t_left() }
    state set_esc(&mut self) -> u64 { self.keycode = 53; transition { _ -> query() } }
    state t_left(&mut self) -> u64 {
        transition virtual_key == 37 { true -> set_left() _ -> t_right() }
    }
    state set_left(&mut self) -> u64 { self.keycode = 123; transition { _ -> query() } }
    state t_right(&mut self) -> u64 {
        transition virtual_key == 39 { true -> set_right() _ -> t_up() }
    }
    state set_right(&mut self) -> u64 { self.keycode = 124; transition { _ -> query() } }
    state t_up(&mut self) -> u64 {
        transition virtual_key == 38 { true -> set_up() _ -> t_down() }
    }
    state set_up(&mut self) -> u64 { self.keycode = 126; transition { _ -> query() } }
    state t_down(&mut self) -> u64 {
        transition virtual_key == 40 { true -> set_down() _ -> unmapped() }
    }
    state set_down(&mut self) -> u64 { self.keycode = 125; transition { _ -> query() } }
    // No macOS keycode for this VK: report not-down (avoid querying keycode 0 = 'a').
    state unmapped(&mut self) -> u64 { 0 }
    state query(&mut self) -> u64 {
        self.rc = self.cg.event_source_key_state(1, self.keycode);
        transition { _ -> ret() }
    }
    state ret(&mut self) -> u64 { self.rc }
}
