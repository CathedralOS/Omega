// The Omega standard filesystem surface — a serious, ergonomic `std::fs` with
// parity to Rust's `std::fs`, but Omega idioms rather than Rust ones:
//   - paths are a BYTE DOMAIN (`&[u8] in Path`), not a language `String`;
//   - results are bespoke `data` case enums, not `Result<T, E>` (an Err in Rust
//     is usually a bespoke enum anyway — we skip the wrapper);
//   - the open-file handle `File` is ZII: a zero-initialized handle is Closed;
//   - HUMAN method names only — no legacy C abbreviations (creat/unlink/stat).
//
// TWO LAYERS (= Rust's `std::fs` over `std::sys`):
//   - `Filesystem` — the ergonomic capability users hold. Its machines hide
//     flags/mode/fd behind `File` + the result enums.
//   - `FilesystemHost` — the raw, VALUE-RETURNING per-OS boundary (each op
//     returns its syscall result: fd / byte count / rc, negative on error). Its
//     per-target lowering (libSystem imports on darwin, syscalls on linux,
//     kernel32 on windows) lives in the calling-convention tables. The wrapper
//     is written ONCE and portable; each OS supplies only the raw seam.

// A filesystem path: NUL-free bytes (the POSIX C-string invariant). Deliberately
// not `Utf8`: POSIX paths are arbitrary nul-free bytes; Windows re-encodes at
// the boundary. `no_nul` is a compiler-recognized byte predicate.
domain [u8]::Path when no_nul(self) {
}

// An open file handle. ZII: a zero-initialized `File` is Closed. `[copy]` lets
// it pass by value into read/write/close.
data File [copy, zero_init] {
    fd: i32;
}

// The category of an I/O failure (Rust `std::io::ErrorKind`). First case is the
// ZII zero case = `Other` (an unclassified/unknown errno). Grown as more errno
// values get mapped; today covers the common file-op failures. Defined before
// the result enums because their `Error` case carries an `ErrorKind`.
data ErrorKind {
    case Other;
    case NotFound;         // ENOENT (2)
    case PermissionDenied; // EACCES (13)
    case AlreadyExists;    // EEXIST (17)
    case BadDescriptor;    // EBADF  (9)
    case IsADirectory;     // EISDIR (21)
}

// Bespoke result enums (Rust's `io::Result<T>`, whose Err is `io::Error` — here
// its `ErrorKind`). First case = the ZII zero case = the error, so an untouched
// result reads as failure (`Error { kind: Other }`), never spurious success. The
// wrapper machines fill `kind` by classifying errno at the point of failure
// (`self.last_error()`), so a failed result self-describes — no separate call.
data OpenResult {
    case Error(kind: ErrorKind);
    case Ok(file: File);
}
data IoResult {
    case Error(kind: ErrorKind);
    case Ok(count: usize);
}
data UnitResult {
    case Error(kind: ErrorKind);
    case Ok;
}

// How to open an existing file (Rust `std::fs::OpenOptions`). A ZII-default
// `OpenOptions` (all false) opens read-only. These flags cover EXISTING-file
// opens (read / write / read+write / append / truncate); the creating flags
// (`create`/`create_new` = O_CREAT/O_EXCL) need `open`'s variadic `mode`
// argument, which is not yet marshalled on arm64 — use `create` for the common
// create-and-truncate case until that lands (see TASKS_FS.md step 7-open).
data OpenOptions [copy, zero_init] {
    read: bool;
    write: bool;
    append: bool;
    truncate: bool;
}

// A file's permission bits (Rust `std::fs::Permissions`). `mode` is the POSIX
// octal mode (e.g. 0o644 = 420 = rw-r--r--, 0o444 = 292 = read-only).
data Permissions [copy, zero_init] {
    mode: u32;
}

// Rust `Permissions::readonly()` — true when the owner-write bit (0o200 = 128)
// is clear.
machine Permissions::readonly(&self) -> bool {
    (self.mode & 128) == 0
}

// Rust `Permissions::set_readonly(bool)` — clear the write bits (owner/group/
// other, 0o222 = 146) to make read-only, or set them to make writable. The
// masks stay within the 9 permission bits (0o777 = 511; 511 ^ 146 = 365 keeps
// read+execute while clearing write).
machine Permissions::set_readonly(&mut self, readonly: bool) {
    transition readonly { true -> lock() _ -> unlock() }
    state lock(&mut self) { self.mode = self.mode & 365; }
    state unlock(&mut self) { self.mode = self.mode | 146; }
}

// File metadata (Rust `std::fs::Metadata`). `len` is the size in bytes; `is_dir`
// distinguishes a directory from a regular file; `mode` is the raw `st_mode`
// (format bits + permission bits); `modified_secs` is the last-modification time
// as whole seconds since the Unix epoch (`st_mtime`). All decoded from the
// darwin `stat` record (`st_size`@96, `st_mode`@4, `st_mtimespec.tv_sec`@48).
data Metadata [copy, zero_init] {
    len: i64;
    is_dir: bool;
    mode: u32;
    modified_secs: i64;
}

// Rust `Metadata::is_file` — a regular file (here: anything that is not a
// directory; symlinks/devices are not modeled).
machine Metadata::is_file(&self) -> bool {
    !self.is_dir
}

// Rust `Metadata::permissions().readonly()` — true when the owner-write bit
// (0o200 = 128) is clear in the permission bits.
machine Metadata::readonly(&self) -> bool {
    (self.mode & 128) == 0
}

// Rust `Metadata::permissions()` — the permission bits (low 9 of `st_mode`,
// masked with 0o777 = 511) as a `Permissions`.
machine Metadata::permissions(&self) -> Permissions {
    Permissions { mode: self.mode & 511 }
}

// Rust `Metadata::modified()` — the last-modification time. Rust returns a
// `SystemTime`; Omega returns whole seconds since the Unix epoch (`st_mtime`).
machine Metadata::modified(&self) -> i64 {
    self.modified_secs
}
data MetadataResult {
    case Error(kind: ErrorKind);
    case Ok(meta: Metadata);
}

// The RAW, VALUE-RETURNING per-OS boundary. Human names; the ugly libc spellings
// (_creat/_unlink/_lseek) live only in the per-target binding table.
boundary trait FilesystemHost {
    machine create(path: &[u8] in Path, mode: i32) -> i32;
    machine open(path: &[u8] in Path, flags: i32) -> i32;
    machine read(fd: i32, buffer: &mut [u8], count: usize) -> i64;
    machine write(fd: i32, bytes: &[u8]) -> i64;
    machine close(fd: i32) -> i32;
    machine remove(path: &[u8] in Path) -> i32;
    machine seek(fd: i32, offset: i64, whence: i32) -> i64;
    machine create_dir(path: &[u8] in Path, mode: i32) -> i32;
    machine remove_dir(path: &[u8] in Path) -> i32;
    machine set_permissions(path: &[u8] in Path, mode: u32) -> i32;
    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> i32;
    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32;
    // Fill `buffer` (>= 144 bytes) with the path's `struct stat` record (Rust
    // `fs::metadata`). The Omega layer reads st_size/st_mode back out.
    machine read_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32;
    machine set_len(fd: i32, length: i64) -> i32;
    machine sync(fd: i32) -> i32;
    // Read the thread-local errno (darwin `___error()` -> `&errno`, dereferenced
    // in the lowering). Call it immediately after a raw op returned negative.
    machine errno() -> i32;
}

// The ergonomic capability. Holds the raw host plus the portable flag/mode
// constants it applies (staged in fields). `stat_buf` is scratch for the 144-byte
// darwin `struct stat` that `metadata_path` fills and decodes.
data Filesystem {
    host: FilesystemHost;
    create_mode: i32;
    dir_mode: i32;
    read_flags: i32;
    stat_buf: [u8; 144];
}

// Create (or truncate) a file for writing, returning an open `File`.
machine Filesystem::create(&mut self, path: &[u8] in Path) -> OpenResult {
    self.create_mode = 420;
    let fd: i32 = self.host.create(path, self.create_mode);
    transition fd >= 0 { true -> ok(fd) _ -> err() }
    state ok(&mut self, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(&mut self) -> OpenResult { let kind: ErrorKind = self.last_error(); OpenResult::Error { kind: kind } }
}

// Open an existing file for reading.
machine Filesystem::open(&mut self, path: &[u8] in Path) -> OpenResult {
    self.read_flags = 0;
    let fd: i32 = self.host.open(path, self.read_flags);
    transition fd >= 0 { true -> ok(fd) _ -> err() }
    state ok(&mut self, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(&mut self) -> OpenResult { let kind: ErrorKind = self.last_error(); OpenResult::Error { kind: kind } }
}

// Open an existing file with explicit `OpenOptions` (Rust
// `OpenOptions::open`). Composes the POSIX access mode + O_APPEND/O_TRUNC bits
// from the option flags, then calls the raw `open`. Access mode: read+write
// (or read+append) -> O_RDWR(2); write/append only -> O_WRONLY(1); otherwise
// O_RDONLY(0). append -> O_APPEND(8); truncate -> O_TRUNC(1024). No O_CREAT:
// opening a missing path fails (POSIX ENOENT), matching Rust without `.create`.
// The flag math is BRANCH-FREE and purely bitwise: Omega's exact-arithmetic
// proof obligation (decision 17) rejects `*`/`+` on `bool as i32` (it can't
// prove the {0,1} range), but `&`/`|`/`^`/`<<` carry no overflow obligation.
// `wbit` = writable (write OR append); access mode is the mutually-exclusive
// O_WRONLY(1)/O_RDWR(2) pair selected by `read`, then O_APPEND(8)/O_TRUNC(1024)
// OR'd in.
machine Filesystem::open_with(&mut self, path: &[u8] in Path, options: OpenOptions) -> OpenResult {
    let wbit: i32 = (options.write as i32) | (options.append as i32);
    let rbit: i32 = options.read as i32;
    let wronly: i32 = wbit & (rbit ^ 1);
    let rdwr: i32 = (wbit & rbit) << 1;
    let append_flag: i32 = (options.append as i32) << 3;
    let truncate_flag: i32 = (options.truncate as i32) << 10;
    let flags: i32 = wronly | rdwr | append_flag | truncate_flag;
    let fd: i32 = self.host.open(path, flags);
    transition fd >= 0 { true -> ok(fd) _ -> err() }
    state ok(&mut self, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(&mut self) -> OpenResult { let kind: ErrorKind = self.last_error(); OpenResult::Error { kind: kind } }
}

// Open an existing file for appending (Rust `OpenOptions::new().append(true)`).
// Writes land at end-of-file; opening a missing path fails (no O_CREAT).
// O_WRONLY(1) | O_APPEND(8) = 9.
machine Filesystem::append(&mut self, path: &[u8] in Path) -> OpenResult {
    let flags: i32 = 9;
    let fd: i32 = self.host.open(path, flags);
    transition fd >= 0 { true -> ok(fd) _ -> err() }
    state ok(&mut self, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(&mut self) -> OpenResult { let kind: ErrorKind = self.last_error(); OpenResult::Error { kind: kind } }
}

// Read up to `count` bytes into `buffer`; returns the number read (0 = EOF).
machine Filesystem::read(&mut self, file: File, buffer: &mut [u8], count: usize) -> IoResult {
    let n: i64 = self.host.read(file.fd, buffer, count);
    transition n >= 0 { true -> ok(n) _ -> err() }
    state ok(&mut self, n: i64) -> IoResult { IoResult::Ok { count: n as usize } }
    state err(&mut self) -> IoResult { let kind: ErrorKind = self.last_error(); IoResult::Error { kind: kind } }
}

// Write `bytes`; returns the number written.
machine Filesystem::write(&mut self, file: File, bytes: &[u8]) -> IoResult {
    let n: i64 = self.host.write(file.fd, bytes);
    transition n >= 0 { true -> ok(n) _ -> err() }
    state ok(&mut self, n: i64) -> IoResult { IoResult::Ok { count: n as usize } }
    state err(&mut self) -> IoResult { let kind: ErrorKind = self.last_error(); IoResult::Error { kind: kind } }
}

// Close a file handle, returning the raw rc (0 on success).
machine Filesystem::close(&mut self, file: File) -> i32 {
    self.host.close(file.fd)
}

// Write an entire buffer to a path in one shot (Rust `std::fs::write`): create
// (or truncate) the file, write all the bytes, and close — no `File` handle
// leaks to the caller. All three raw ops run in the entry: on a create failure
// the fd is negative, so the subsequent write/close no-op with errors and the
// `n >= 0` guard reports Error. Success requires the write to have returned a
// non-negative count.
machine Filesystem::write_all(&mut self, path: &[u8] in Path, bytes: &[u8]) -> UnitResult {
    self.create_mode = 420;
    let fd: i32 = self.host.create(path, self.create_mode);
    let n: i64 = self.host.write(fd, bytes);
    let rc: i32 = self.host.close(fd);
    transition n >= 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Read a whole file into `buffer` in one shot (Rust `std::fs::read`): open the
// path read-only, read up to `count` bytes, and close — returning the number
// read. (Rust returns a freshly-grown `Vec`; Omega fills a caller buffer to
// avoid an allocation in the std surface — pass a buffer at least as large as
// the file, sized via `metadata().len`.) Like `write_all`, all raw ops run in
// the entry so an open failure flows to Error via the `n >= 0` guard.
machine Filesystem::read_all(&mut self, path: &[u8] in Path, buffer: &mut [u8], count: usize) -> IoResult {
    self.read_flags = 0;
    let fd: i32 = self.host.open(path, self.read_flags);
    let n: i64 = self.host.read(fd, buffer, count);
    let rc: i32 = self.host.close(fd);
    transition n >= 0 { true -> ok(n) _ -> err() }
    state ok(&mut self, n: i64) -> IoResult { IoResult::Ok { count: n as usize } }
    state err(&mut self) -> IoResult { let kind: ErrorKind = self.last_error(); IoResult::Error { kind: kind } }
}

// Copy the contents of `from` to `to` (Rust `std::fs::copy`), returning the
// number of bytes copied. Uses a caller-provided scratch `buffer` (Rust
// allocates; Omega stays allocation-free — size it to the file via
// `metadata_path`; a source larger than `cap` is copied only up to `cap`).
//
// The bytes are written with the WRITE-THEN-TRUNCATE idiom: write the whole
// buffer then `set_len(n)` to drop the trailing scratch bytes. This keeps the
// whole op in the ENTRY (no state threads the buffer — the interpreter does not
// yet carry a `&[u8]` across a state transition; see TASKS_FS.md "copy"), at the
// cost of two documented differences from Rust: (1) it writes `cap` bytes then
// truncates, and (2) on a source-open failure it still creates an empty `to`.
// A faithful version (branch after the read; write only `buffer[0..n]`) lands
// once the interpreter threads slices through states.
machine Filesystem::copy(&mut self, from: &[u8] in Path, to: &[u8] in Path, buffer: &mut [u8], cap: usize) -> IoResult {
    self.read_flags = 0;
    self.create_mode = 420;
    let src: i32 = self.host.open(from, self.read_flags);
    let n: i64 = self.host.read(src, buffer, cap);
    let closed_src: i32 = self.host.close(src);
    let dst: i32 = self.host.create(to, self.create_mode);
    let written: i64 = self.host.write(dst, buffer);
    let truncated: i32 = self.host.set_len(dst, n);
    let closed_dst: i32 = self.host.close(dst);
    transition n >= 0 { true -> ok(n) _ -> err() }
    state ok(&mut self, n: i64) -> IoResult { IoResult::Ok { count: n as usize } }
    state err(&mut self) -> IoResult { let kind: ErrorKind = self.last_error(); IoResult::Error { kind: kind } }
}

// Does a path exist and is it openable for reading? (Rust `Path::exists`.)
// Opens read-only and closes immediately; true iff the open succeeded. NOTE:
// like any open-based probe this reports false for a path that exists but is
// unreadable (EACCES) — a faithful `exists` that stats the path (true even when
// unreadable) waits on `fstat` (step 10); until then this is "readably exists".
machine Filesystem::exists(&mut self, path: &[u8] in Path) -> bool {
    self.read_flags = 0;
    let fd: i32 = self.host.open(path, self.read_flags);
    transition fd >= 0 { true -> present(fd) _ -> absent() }
    state present(&mut self, fd: i32) -> bool {
        let rc: i32 = self.host.close(fd);
        true
    }
    state absent(&mut self) -> bool { false }
}

// Metadata of a PATH (Rust `std::fs::metadata`), the path-based counterpart to
// `metadata(file)`. Unlike the open+seek approach this uses `stat`, so it works
// on DIRECTORIES too (no read permission / open needed): it decodes `st_size`
// (byte size) and `st_mode` (kind) straight out of the kernel's stat record.
// The field reads are byte-assembly (little-endian) since Omega has no
// C-struct-layout `repr` yet; `st_size` is an i64 at offset 96, `st_mode` a u16
// at offset 4, and a directory is `(st_mode & S_IFMT) == S_IFDIR`
// (0o170000 = 61440, 0o040000 = 16384).
machine Filesystem::metadata_path(&mut self, path: &[u8] in Path) -> MetadataResult {
    let rc: i32 = self.host.read_metadata(path, &mut self.stat_buf);
    transition rc == 0 { true -> decode() _ -> err() }
    state decode(&mut self) -> MetadataResult {
        let len: i64 = (self.stat_buf[96] as i64)
            | ((self.stat_buf[97] as i64) << 8)
            | ((self.stat_buf[98] as i64) << 16)
            | ((self.stat_buf[99] as i64) << 24)
            | ((self.stat_buf[100] as i64) << 32)
            | ((self.stat_buf[101] as i64) << 40)
            | ((self.stat_buf[102] as i64) << 48)
            | ((self.stat_buf[103] as i64) << 56);
        let mode: i32 = (self.stat_buf[4] as i32) | ((self.stat_buf[5] as i32) << 8);
        let is_dir: bool = (mode & 61440) == 16384;
        let mtime: i64 = (self.stat_buf[48] as i64)
            | ((self.stat_buf[49] as i64) << 8)
            | ((self.stat_buf[50] as i64) << 16)
            | ((self.stat_buf[51] as i64) << 24)
            | ((self.stat_buf[52] as i64) << 32)
            | ((self.stat_buf[53] as i64) << 40)
            | ((self.stat_buf[54] as i64) << 48)
            | ((self.stat_buf[55] as i64) << 56);
        MetadataResult::Ok { meta: Metadata { len: len, is_dir: is_dir, mode: mode as u32, modified_secs: mtime } }
    }
    state err(&mut self) -> MetadataResult { let kind: ErrorKind = self.last_error(); MetadataResult::Error { kind: kind } }
}

// Remove a file.
machine Filesystem::remove(&mut self, path: &[u8] in Path) -> UnitResult {
    let rc: i32 = self.host.remove(path);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Classify the most recent failure as an `ErrorKind` (Rust `io::Error::kind`).
// Reads the thread-local errno via the raw seam and maps the common file-op
// codes; call it IMMEDIATELY after an op returned an Error/negative value,
// before any other host call (errno is only valid right after the failure).
machine Filesystem::last_error(&mut self) -> ErrorKind {
    let code: i32 = self.host.errno();
    transition code == 2 { true -> not_found() _ -> check_acces(code) }
    state check_acces(&mut self, code: i32) -> ErrorKind {
        transition code == 13 { true -> denied() _ -> check_exist(code) }
    }
    state check_exist(&mut self, code: i32) -> ErrorKind {
        transition code == 17 { true -> exists() _ -> check_badf(code) }
    }
    state check_badf(&mut self, code: i32) -> ErrorKind {
        transition code == 9 { true -> bad_descriptor() _ -> check_isdir(code) }
    }
    state check_isdir(&mut self, code: i32) -> ErrorKind {
        transition code == 21 { true -> is_a_directory() _ -> other() }
    }
    state not_found(&mut self) -> ErrorKind { ErrorKind::NotFound }
    state denied(&mut self) -> ErrorKind { ErrorKind::PermissionDenied }
    state exists(&mut self) -> ErrorKind { ErrorKind::AlreadyExists }
    state bad_descriptor(&mut self) -> ErrorKind { ErrorKind::BadDescriptor }
    state is_a_directory(&mut self) -> ErrorKind { ErrorKind::IsADirectory }
    state other(&mut self) -> ErrorKind { ErrorKind::Other }
}

// Create a directory.
machine Filesystem::create_dir(&mut self, path: &[u8] in Path) -> UnitResult {
    self.dir_mode = 493;
    let rc: i32 = self.host.create_dir(path, self.dir_mode);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Remove an empty directory.
machine Filesystem::remove_dir(&mut self, path: &[u8] in Path) -> UnitResult {
    let rc: i32 = self.host.remove_dir(path);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Set a path's permission bits (Rust `std::fs::set_permissions`). A subsequent
// write-open of a path whose owner-write bit was cleared fails with
// `PermissionDenied` (EACCES).
machine Filesystem::set_permissions(&mut self, path: &[u8] in Path, perms: Permissions) -> UnitResult {
    let rc: i32 = self.host.set_permissions(path, perms.mode);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Move/rename a path.
machine Filesystem::rename(&mut self, from: &[u8] in Path, to: &[u8] in Path) -> UnitResult {
    let rc: i32 = self.host.rename(from, to);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Create a hard link `link` referring to the same file as `original` (Rust
// `std::fs::hard_link`). Both names then refer to one inode; removing one leaves
// the other. Fails with `AlreadyExists` if `link` is taken, `NotFound` if
// `original` is absent.
machine Filesystem::hard_link(&mut self, original: &[u8] in Path, link: &[u8] in Path) -> UnitResult {
    let rc: i32 = self.host.hard_link(original, link);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Truncate or extend an open file to `length` bytes (Rust `File::set_len`).
machine Filesystem::set_len(&mut self, file: File, length: i64) -> UnitResult {
    let rc: i32 = self.host.set_len(file.fd, length);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Flush all buffered data + metadata to durable storage (Rust `File::sync_all`).
machine Filesystem::sync(&mut self, file: File) -> UnitResult {
    let rc: i32 = self.host.sync(file.fd);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = self.last_error(); UnitResult::Error { kind: kind } }
}

// Metadata of an open file (Rust `File::metadata`). Composes the raw `seek` op:
// remember the cursor (SEEK_CUR), measure the size (SEEK_END), then restore the
// cursor (SEEK_SET) so `metadata` is non-destructive. `len` is the byte size.
machine Filesystem::metadata(&mut self, file: File) -> MetadataResult {
    let cursor: i64 = self.host.seek(file.fd, 0, 1);
    transition cursor >= 0 { true -> measure(file, cursor) _ -> err() }
    state measure(&mut self, file: File, cursor: i64) -> MetadataResult {
        let len: i64 = self.host.seek(file.fd, 0, 2);
        transition len >= 0 { true -> restore(file, cursor, len) _ -> err() }
    }
    state restore(&mut self, file: File, cursor: i64, len: i64) -> MetadataResult {
        let back: i64 = self.host.seek(file.fd, cursor, 0);
        transition back >= 0 { true -> ok(len) _ -> err() }
    }
    // An open `File` is a regular file (you cannot hold a `File` over a dir here),
    // so `is_dir` is false. The seek-based path cannot read the real mode, so it
    // reports a conventional rw-r--r-- (0o644 = 420); use `metadata_path` for the
    // accurate `mode`/`readonly`/`permissions` from `stat`.
    state ok(&mut self, len: i64) -> MetadataResult { MetadataResult::Ok { meta: Metadata { len: len, is_dir: false, mode: 420, modified_secs: 0 } } }
    state err(&mut self) -> MetadataResult { let kind: ErrorKind = self.last_error(); MetadataResult::Error { kind: kind } }
}
