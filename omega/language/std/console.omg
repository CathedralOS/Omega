// Portable console surface exposed by the Omega standard library.
//
// This is the friendly app-facing API. Its implementation should eventually be
// proven Omega code over explicit host capabilities, not a direct OS binding.
//
// Each selected target contributes the irreducible native byte leaves and its
// provider default. Target filtering keeps exactly one implementation closure.
use omega::language::std::targets::windows_x64::console_impl;
use omega::language::std::targets::macos_arm64::console_impl;
use omega::language::std::targets::linux_x64::console_impl;
use omega::language::std::targets::linux_arm64::console_impl;

// The result of a byte-level stdin read. `Eof` is ORDINAL 0: a
// zero-initialized ByteRead IS end-of-input -- ZII, no magic sentinel
// (the byte result has no sentinel).
pub data ByteRead {
    case Eof;
    case Byte(value: i32 [0..=255]);
}

pub boundary trait Console {
    machine write_line(text: &[u8])
    reaches
        Console;
    machine write(text: &[u8])
    reaches
        Console;
    // The concrete owned `[u8; N] in D` destination supplies the write bound;
    // provider planning derives N from that call-site place and updates its
    // runtime length. A growable destination remains allocator-gated.
    machine read_line(out_line: &mut [u8])
    reaches
        Console;
    // Byte-level stdin/stdout (the settled universal console surface):
    // `read_byte` yields the next stdin byte as `ByteRead::Byte`, or
    // `ByteRead::Eof` at end-of-input; `write_byte` appends one byte to
    // stdout. Both interpreter and native providers implement these leaves;
    // the friendly text adapters below are shared checked Omega code.
    machine read_byte() -> ByteRead
    reaches
        Console;
    machine write_byte(byte: i32)
    reaches
        Console;
    machine exit_process(return_code: i32)
    reaches
        Console;
}

// Nominal owner of the complete selected Console provider closure. Checked
// adapters and compiler-known native leaves attach to the same type so
// provider selection never assembles rows from unrelated implementations.
pub data ConsoleNativeProvider { }

// Friendly output is checked Omega code over the byte-level boundary leaf.
// The private writer walks a borrowed byte view as one measured state
// loop. Each guarded edge stages the head byte and tail slice; the loop state's
// body performs the byte effect only after that edge was selected.
machine console_write_bytes(console: Console, bytes: &[u8], newline: bool)
terminates by bytes -> Slice::Length;
reaches
    Console
{
    transition bytes.len > 0 {
        true -> emit(console, bytes[0], bytes[1..], newline)
        false -> finish(console, newline)
    }

    state emit(console: Console, byte: u8, bytes: &[u8], newline: bool) {
        let mut output: u8 = byte;
        console.write_byte(output as i32);
        transition bytes.len > 0 {
            true -> emit(console, bytes[0], bytes[1..], newline)
            false -> finish(console, newline)
        }
    }

    state finish(console: Console, newline: bool) {
        transition newline {
            true -> emit_newline(console, 10)
            false -> done()
        }
    }

    state emit_newline(console: Console, byte: u8) {
        let mut output: u8 = byte;
        console.write_byte(output as i32);
    }

    state done() { }
}

machine ConsoleNativeProvider::write(console: Console, text: &[u8]) satisfies Console::write
reaches
    Console
{
    console_write_bytes(console, text, false);
}

machine ConsoleNativeProvider::write_line(console: Console, text: &[u8]) satisfies Console::write_line
reaches
    Console
{
    console_write_bytes(console, text, true);
}
