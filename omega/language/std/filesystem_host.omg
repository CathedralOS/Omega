// The Omega standard filesystem RAW BOUNDARY — the per-OS seam beneath `std::fs`
// (= Rust's `std::sys`). This is the SINGLE canonical declaration of the
// `FilesystemHost` boundary trait and the `Path` byte-domain: the ergonomic
// `omega::language::std::filesystem` wrapper imports it, and every filesystem
// canary/sample obtains it via `use omega::language::std::filesystem_host;`
// rather than re-declaring the trait inline.
//
// Each op is VALUE-RETURNING (its syscall result: fd / byte count / rc, negative
// on error). Human method names only — the ugly libc spellings (_creat/_unlink/
// _lseek) live ONLY in the per-target binding tables (libSystem imports on darwin,
// syscalls on linux, kernel32 on windows). The wrapper is written ONCE and
// portable; each OS supplies only this raw seam.

// A filesystem path: NUL-free bytes (the POSIX C-string invariant). Deliberately
// not `Utf8`: POSIX paths are arbitrary nul-free bytes; Windows re-encodes at the
// boundary. `no_nul` is a compiler-recognized byte predicate.
pub domain [u8]::Path
requires
    no_nul(self);
pub boundary trait FilesystemHost {
    machine create(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemHost;
    machine open(path: &[u8] in Path, flags: i32) -> i32 reaches FilesystemHost;
    // The CREATING open: `open(path, flags, mode)` with O_CREAT (Rust
    // `File::create_new` / `OpenOptions.create`). `flags` carries the access mode
    // + O_CREAT (512) [+ O_EXCL (2048) for create-new] [+ O_TRUNC (1024)]; `mode`
    // is the create permission bits. Returns the new fd, or -1. On Darwin the
    // retained Apple variadic plan places the promoted `mode` on the outgoing
    // stack rather than treating it as a third fixed register parameter.
    machine open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32 reaches FilesystemHost;
    machine read(fd: i32, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemHost;
    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemHost;
    // Positioned I/O (Rust `FileExt::read_at`/`write_at`): read/write at an
    // absolute `offset` WITHOUT moving the descriptor's cursor. `_pread`/`_pwrite`.
    machine read_at(fd: i32, buffer: &mut [u8], count: u64, offset: i64) -> i64 reaches FilesystemHost;
    machine write_at(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemHost;
    machine close(fd: i32) -> i32 reaches FilesystemHost;
    machine remove(path: &[u8] in Path) -> i32 reaches FilesystemHost;
    machine seek(fd: i32, offset: i64, whence: i32) -> i64 reaches FilesystemHost;
    machine create_dir(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemHost;
    machine remove_dir(path: &[u8] in Path) -> i32 reaches FilesystemHost;
    // Create a directory from a TRUSTED plain `&[u8]` name -- the D-at trust
    // class (see open_at below): `create_dir_all`'s prefix scratch is no_nul
    // BY CONSTRUCTION (bytes copied from a `&[u8] in Path` source, the NUL
    // excluded by the subslice), so it skips the Path domain re-proof exactly
    // as directory-listing names do. Same native row as create_dir.
    machine create_dir_name(name: &[u8], mode: i32) -> i32 reaches FilesystemHost;
    // Open `name` RELATIVE to the open directory `dirfd` (Rust's `openat`, the
    // `*at` family used by `remove_dir_all` etc.). The name is a TRUSTED relative
    // component -- a directory-listing entry is `no_nul` by construction -- so it
    // is a PLAIN `&[u8]`, NOT `in Path`: this is exactly what lets a name extracted
    // from `read_dir` flow straight into `open_at`/`unlink_at` with no domain
    // re-proof. Path-joining (`dirfd`'s path + "/" + name) happens in the OS
    // (native `openat`) / the interpreter's virtual FS, never built in Omega.
    // Returns the new fd, or -1.
    machine open_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemHost;
    // Remove `name` RELATIVE to `dirfd` (Rust's `unlinkat`). `flags` = 0 removes a
    // FILE (unlink); AT_REMOVEDIR (0x80 = 128 on darwin) removes an EMPTY DIRECTORY
    // (rmdir). Same trusted-plain-name basis as `open_at`. Returns 0, or -1.
    machine unlink_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemHost;
    machine set_permissions(path: &[u8] in Path, mode: u32) -> i32 reaches FilesystemHost;
    machine set_file_permissions(fd: i32, mode: u32) -> i32 reaches FilesystemHost;
    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> i32 reaches FilesystemHost;
    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemHost;
    machine symlink(target: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemHost;
    machine read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemHost;
    // Resolve `path` to its canonical absolute form (following every symlink) into
    // `buffer` (must be >= PATH_MAX = 1024), NUL-terminated (Rust `fs::canonicalize`
    // -> `realpath`). Returns the resolved-buffer pointer as an i64 (non-zero) on
    // success, or 0 (NULL) on error — a success FLAG, not a byte count.
    machine canonicalize(path: &[u8] in Path, buffer: &mut [u8]) -> i64 reaches FilesystemHost;
    // Read directory entries (Rust `fs::read_dir`) into `buffer` as packed
    // target records. Darwin lowers to `___getdirentries64`, consumes the
    // in/out `position` cursor, and returns d_reclen@16, d_namlen@18,
    // d_type@20, d_name@21. Linux lowers to `getdents64`, omits `position`
    // from the syscall, and returns d_reclen@16, d_type@18, a NUL-terminated
    // d_name@19. A return of 0 means end of directory; target implementations
    // advance by d_reclen and own their record decoding.
    machine read_dir(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64 reaches FilesystemHost;
    // The FIND-ENUMERATION family (fs portable-contract rung 3a, 2026-07-18):
    // windows' directory paradigm, DESIGNED signatures (the seam law) over the
    // Win32 find trio. `pattern` is TRUSTED PLAIN bytes -- the D-at trust class
    // exactly like `create_dir_name`: the caller constructs `dir\*` from a
    // `&[u8] in Path` source plus literal bytes, no_nul BY CONSTRUCTION, so no
    // domain re-proof. `data` receives one entry record (WIN32_FIND_DATAA
    // shape, >= 320 bytes): file attributes u32 @0 (directory bit 0x10), the
    // NUL-terminated entry name @44. `find_first` opens the enumeration and
    // fills the FIRST entry, returning a HANDLE (i64; -1 on error/no match);
    // `find_next` fills the next (1 = filled, 0 = end); `find_close` releases
    // the handle. Posix targets never call these (their impls walk dirent
    // records); the per-target impl split is what keeps this asymmetry honest.
    machine find_first(pattern: &[u8], data: &mut [u8]) -> i64 reaches FilesystemHost;
    machine find_next(handle: i64, data: &mut [u8]) -> i32 reaches FilesystemHost;
    machine find_close(handle: i64) -> i32 reaches FilesystemHost;
    // The windows hard-link primitive (windows session slice 3), mirroring
    // `CreateHardLinkA(lpFileName, lpExistingFileName, lpSecurityAttributes)`
    // EXACTLY (the seam law: designed signatures) -- note the Win32 arg order
    // is (new link, existing) -- REVERSED from posix `link(existing, new)` --
    // and the trailing security-attributes pointer MUST be passed as 0 (the
    // API requires NULL; win64 would otherwise read a garbage register).
    // Returns BOOL: non-zero success, 0 failure (GetLastError holds the
    // reason -- NOT msvcrt errno; kind mapping waits on a win32 last-error
    // surface). Posix targets never call this (their impls bind `hard_link`);
    // the per-target impl split keeps the asymmetry honest.
    machine create_hard_link(link: &[u8] in Path, existing: &[u8] in Path, security_attributes: i64) -> i32 reaches FilesystemHost;
    // Direct Win32 path-handle seam used where the CRT descriptor surface is
    // too narrow (notably directory canonicalization). Mirrors
    // `CreateFileA(path, desired_access, share_mode, security_attributes,
    // creation_disposition, flags_and_attributes, template_file)` exactly.
    // Returns a HANDLE as i64, or INVALID_HANDLE_VALUE (-1). Windows-only;
    // posix target implementations never call it.
    machine open_path_handle(path: &[u8] in Path, desired_access: u32, share_mode: u32, security_attributes: i64, creation_disposition: u32, flags_and_attributes: u32, template_file: i64) -> i64 reaches FilesystemHost;
    // `CloseHandle(handle)` -- BOOL result. Kept distinct from CRT `close(fd)`:
    // descriptors and kernel handles are different resources on Windows.
    machine close_handle(handle: i64) -> i32 reaches FilesystemHost;
    // The msvcrt fd -> Win32 HANDLE bridge (windows session slice 4a),
    // mirroring `_get_osfhandle(fd)`: the OS HANDLE behind an open CRT
    // descriptor as i64, or -2 (msvcrt's INVALID_HANDLE_VALUE spelling) for
    // a bad fd -- consumers treat any negative as failure. Unlocks the
    // HANDLE-keyed kernel32 surface (GetFinalPathNameByHandleA here;
    // SetFileTime/LockFileEx ride the same bridge).
    machine get_osfhandle(fd: i32) -> i64 reaches FilesystemHost;
    // `GetFinalPathNameByHandleA(handle, buffer, capacity, flags)` -- resolve
    // an OPEN handle to its final path (flags 0 = VOLUME_NAME_DOS, a
    // `\\?\C:\...` spelling), NUL-terminated into `buffer`. Returns the path
    // LENGTH (without the NUL) on success, the REQUIRED capacity (including
    // the NUL) when `capacity` is too small, or 0 on failure (GetLastError
    // holds the reason -- not msvcrt errno).
    machine final_path_name_by_handle(handle: i64, buffer: &mut [u8], capacity: u64, flags: u32) -> i64 reaches FilesystemHost;
    // `SetFileTime(handle, lpCreationTime, lpLastAccessTime, lpLastWriteTime)`
    // (windows session slice 4b): stamp an OPEN handle's times from 8-byte
    // FILETIME buffers (100ns units since 1601; the wrapper composes them
    // from unix seconds with the calibration constants). `creation` is the
    // NULL-able pointer the API allows -- pass 0 to leave creation time
    // alone. Returns BOOL (non-zero success); failures live in GetLastError,
    // not msvcrt errno.
    machine set_file_time(handle: i64, creation: i64, last_access: &[u8], last_write: &[u8]) -> i32 reaches FilesystemHost;
    // Win32 whole-file locking. These mirror the kernel32 signatures exactly:
    // LockFileEx(handle, flags, reserved, length_low, length_high, overlapped)
    // and UnlockFile(handle, offset_low, offset_high, length_low, length_high).
    // The wrapper uses offset 0 and length 2^64-1. BOOL results; failure detail
    // is captured immediately through get_last_error.
    machine lock_file_ex(handle: i64, flags: u32, reserved: u32, length_low: u32, length_high: u32, overlapped: &mut [u8]) -> i32 reaches FilesystemHost;
    machine unlock_file(handle: i64, offset_low: u32, offset_high: u32, length_low: u32, length_high: u32) -> i32 reaches FilesystemHost;
    machine get_last_error() -> i32 reaches FilesystemHost;
    // Remove a FILE / an empty DIRECTORY by a TRUSTED plain `&[u8]` path -- the
    // D-at trust class twins of `remove` / `remove_dir` (same native rows, the
    // `create_dir_name` precedent): a path JOINED inside a dir-walk from
    // enumeration names is no_nul by construction and skips the Path re-proof.
    machine remove_name(path: &[u8]) -> i32 reaches FilesystemHost;
    machine remove_dir_name(path: &[u8]) -> i32 reaches FilesystemHost;
    // Fill `buffer` (>= 144 bytes) with the path's `struct stat` record (Rust
    // `fs::metadata`). The Omega layer reads st_size/st_mode back out.
    machine read_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemHost;
    // Like `read_metadata` but for an OPEN descriptor, via `fstat` (Rust
    // `File::metadata`). Reads the real mode/size/times without moving the cursor.
    machine read_file_metadata(fd: i32, buffer: &mut [u8]) -> i32 reaches FilesystemHost;
    // Like `read_metadata` but via `lstat` — does NOT follow a final symlink, so
    // a symlink reports its own record (st_mode file-type S_IFLNK). Rust
    // `fs::symlink_metadata`.
    machine read_symlink_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemHost;
    machine set_len(fd: i32, length: i64) -> i32 reaches FilesystemHost;
    // Set an open file's access + modification timestamps (Rust `File::set_times`)
    // via `futimens`. `times` is a caller buffer holding two packed `struct timespec`
    // (atime then mtime, {tv_sec i64, tv_nsec i64} each; whole-second precision).
    machine set_file_times(fd: i32, times: &mut [u8]) -> i32 reaches FilesystemHost;
    machine sync(fd: i32) -> i32 reaches FilesystemHost;
    // Flush a file's DATA (Rust `File::sync_data`); on darwin this is `fsync` (no
    // `fdatasync`), so it shares the `sync` lowering.
    machine sync_data(fd: i32) -> i32 reaches FilesystemHost;
    // Duplicate an open descriptor onto a fresh fd sharing the same open file
    // (Rust `File::try_clone` -> `dup`). Returns the new fd, or -1 on error.
    machine duplicate(fd: i32) -> i32 reaches FilesystemHost;
    // Apply or remove an advisory whole-file lock (Rust `File::lock`/
    // `lock_shared`/`try_lock`/`unlock` -> `flock`). `operation` is a bitmask:
    // LOCK_SH=1 (shared), LOCK_EX=2 (exclusive), LOCK_NB=4 (non-blocking),
    // LOCK_UN=8 (release). Returns 0, or -1 (errno EWOULDBLOCK when a
    // non-blocking acquire is contended).
    machine lock_file(fd: i32, operation: i32) -> i32 reaches FilesystemHost;
    // Change a file's owner/group by path, following symlinks (Rust
    // `os::unix::fs::chown` -> `chown`). A uid or gid of -1 leaves that component
    // unchanged. Returns 0, or -1 (errno EPERM when not permitted).
    machine change_owner(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemHost;
    // Like `change_owner` but does NOT follow a final symlink (Rust
    // `os::unix::fs::lchown` -> `lchown`).
    machine change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemHost;
    // Change owner/group by open descriptor (Rust `os::unix::fs::fchown` ->
    // `fchown`). Same -1 = unchanged convention.
    machine change_file_owner(fd: i32, uid: i32, gid: i32) -> i32 reaches FilesystemHost;
    // Read the thread-local errno on libc-backed targets (Darwin `___error()`
    // and Windows `_errno()`, both dereferenced in lowering). Direct Linux
    // syscalls do not bind this operation: they return `-errno`, which the
    // target wrapper carries explicitly into checked Omega classification.
    machine errno() -> i32 reaches FilesystemHost;
}

// Target-specific `Filesystem` wrapper machines and `StatLayout` policies are
// imported by `filesystem.omg`, where their attached data and result types are
// declared. The raw boundary deliberately does not import those implementations:
// raw-seam clients need only `FilesystemHost` and `Path`.
