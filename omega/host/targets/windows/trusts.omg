trust omega_windows_kernel32 {
    owner omega::host::targets::windows
    reason "Windows Kernel32 API contract"
    source "Microsoft documented Win32 API"
    scope {
        dll "Kernel32.dll"
        symbols GetStdHandle, ReadFile, WriteFile, ExitProcess
        abi windows_x64
    }
}

trust omega_windows_process_adapter {
    owner omega::host::targets::windows
    reason "Omega adapter maps Process.exit to Kernel32.ExitProcess"
    depends omega_windows_kernel32
}

trust omega_windows_stdout_adapter {
    owner omega::host::targets::windows
    reason "Omega adapter maps Stdout.write_line to Kernel32 stdout writes"
    depends omega_windows_kernel32
}

trust omega_windows_stdin_adapter {
    owner omega::host::targets::windows
    reason "Omega adapter maps Stdin.read_line to Kernel32 stdin reads"
    depends omega_windows_kernel32
}

trust windows_loader {
    owner omega::host::targets::windows
    reason "Windows loader resolves imported Kernel32 symbols"
}

trust win32_contracts {
    owner omega::host::targets::windows
    reason "Win32 API documentation describes argument and result behavior"
}

trust windows_x64_calling_convention {
    owner omega::host::targets::windows
    reason "Generated calls obey the Windows x64 ABI"
}
