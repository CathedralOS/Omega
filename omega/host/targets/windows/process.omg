use omega::host::contracts::process;
use omega::host::targets::windows::kernel32;

capability WindowsProcess {
    kernel32: WindowsKernel32

    state exit(return_code: i32) -> Terminal where {
        requires windows_accepts_exit_code(return_code)
        ensures process_terminated
        trust omega_windows_process_adapter
        trust omega_windows_kernel32
    }
}
