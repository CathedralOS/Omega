use omega::host::contracts::stdout;
use omega::host::targets::windows::kernel32;
use omega::host::targets::windows::types;

capability WindowsStdout {
    kernel32: WindowsKernel32

    fn write_line(text: String) -> Result<(), IOError> where {
        requires text.utf8
        ensures result.Ok => stdout_observed(text + "\n") || host_buffered(text + "\n")
        ensures result.Err(e) => e is IOError
        trust omega_windows_stdout_adapter
        trust omega_windows_kernel32
    }
}
