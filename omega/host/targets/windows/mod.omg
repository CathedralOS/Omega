use omega::host::targets::windows::kernel32;
use omega::host::targets::windows::process;
use omega::host::targets::windows::stdin;
use omega::host::targets::windows::stdout;
use omega::host::targets::windows::types;

// Windows host package shipped with the Omega toolchain.
//
// A normal Windows target emits PE imports for documented OS DLL APIs and
// records this package as the boundary boundary.

capability WindowsHost {
    kernel32: WindowsKernel32
    stdin: WindowsStdin
    stdout: WindowsStdout
    process: WindowsProcess
}
