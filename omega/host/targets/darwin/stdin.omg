use omega::host::contracts::stdin;
use omega::host::targets::darwin::libsystem;
use omega::host::targets::darwin::types;

capability DarwinStdin {
    libsystem: DarwinLibSystem

    entry read_line(mut out_text: String) -> Result<(), IOError> where {
        requires out_text.writable
        ensures out_text.utf8
        ensures result.Ok || result.Err
        trust omega_darwin_stdin_adapter
        trust omega_darwin_libsystem
    }
}
