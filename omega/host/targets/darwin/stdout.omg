use omega::host::contracts::stdout;
use omega::host::targets::darwin::libsystem;
use omega::host::targets::darwin::types;

capability DarwinStdout {
    libsystem: DarwinLibSystem

    entry write_line(text: String) -> Result<(), IOError> where {
        requires text.utf8
        ensures result.Ok => stdout_observed(text + "\n") || host_buffered(text + "\n")
        ensures result.Err(e) => e is IOError
        trust omega_darwin_stdout_adapter
        trust omega_darwin_libsystem
    }
}
