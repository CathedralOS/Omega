use omega::host::targets::darwin::types;

capability DarwinLibSystem {
    entry read(fd: i32, buffer: Slice<u8>, byte_count: usize) -> SyscallResult<usize, DarwinErrno> where {
        requires fd == 0
        requires buffer.writable
        requires byte_count <= buffer.len
        ensures result.Ok(n) => n <= byte_count
        ensures result.Err(e) => e is DarwinErrno
        trust darwin_libsystem_abi
        trust host
    }

    entry write(fd: i32, buffer: Slice<u8>, byte_count: usize) -> SyscallResult<usize, DarwinErrno> where {
        requires fd == 1
        requires buffer.initialized
        requires byte_count <= buffer.len
        ensures result.Ok(n) => n <= byte_count
        ensures result.Err(e) => e is DarwinErrno
        trust darwin_libsystem_abi
        trust host
    }

    entry exit(return_code: i32) -> Terminal where {
        requires darwin_accepts_exit_code(return_code)
        ensures process_terminated
        trust darwin_libsystem_abi
        trust host
    }
}
