use omega::host::contracts::process;
use omega::host::targets::linux::syscalls;

capability LinuxProcess {
    syscalls: LinuxSyscalls

    fn exit(return_code: i32) -> Terminal where {
        requires linux_accepts_exit_code(return_code)
        ensures process_terminated
        trust omega_linux_process_adapter
        trust omega_linux_syscalls
    }
}
