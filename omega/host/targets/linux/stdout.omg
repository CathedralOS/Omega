use omega::host::contracts::stdout;
use omega::host::targets::linux::syscalls;
use omega::host::targets::linux::types;

capability LinuxStdout {
    syscalls: LinuxSyscalls

    entry write_line(text: String) -> Result<(), IOError> where {
        requires text.utf8
        ensures result.Ok || result.Err
        boundary omega_linux_stdout_adapter
        boundary omega_linux_syscalls
    }
}
