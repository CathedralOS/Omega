use omega::host::targets::linux::types;

capability LinuxSyscalls {
    entry read(fd: i32, buffer: Slice<u8>, byte_count: usize) -> SyscallResult<usize, LinuxErrno> where {
        requires fd == 0
        requires buffer.writable
        requires byte_count <= buffer.len
        ensures result.Ok || result.Err
        boundary linux_syscall_abi
        boundary host
    }

    entry write(fd: i32, buffer: Slice<u8>, byte_count: usize) -> SyscallResult<usize, LinuxErrno> where {
        requires fd == 1
        requires buffer.initialized
        requires byte_count <= buffer.len
        ensures result.Ok || result.Err
        boundary linux_syscall_abi
        boundary host
    }

    entry exit_group(return_code: i32) -> Terminal where {
        requires linux_accepts_exit_code(return_code)
        ensures process_terminated
        boundary linux_syscall_abi
        boundary host
    }
}
