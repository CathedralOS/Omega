use omega::host::contracts::stdin;
use omega::host::targets::linux::syscalls;
use omega::host::targets::linux::types;

capability LinuxStdin {
    syscalls: LinuxSyscalls

    entry read_line(mut out_text: String) -> Result<(), IOError> where {
        requires out_text.writable
        ensures out_text.utf8
        ensures result.Ok || result.Err
        boundary omega_linux_stdin_adapter
        boundary omega_linux_syscalls
    }
}
