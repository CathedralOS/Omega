use omega::host::targets::linux::process;
use omega::host::targets::linux::stdin;
use omega::host::targets::linux::stdout;
use omega::host::targets::linux::syscalls;
use omega::host::targets::linux::types;

// Linux host package shipped with the Omega toolchain.
//
// Linux is the platform where direct syscalls are a plausible tiny target.
// The syscall ABI is still boundary host machinery, not app-proven behavior.

capability LinuxHost {
    syscalls: LinuxSyscalls
    stdin: LinuxStdin
    stdout: LinuxStdout
    process: LinuxProcess
}
