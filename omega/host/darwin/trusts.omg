trust omega_darwin_libsystem {
    owner omega::host::darwin
    reason "Darwin libSystem ABI and imported process/stdio calls"
    scope {
        dylib "libSystem.dylib"
        symbols _read, _write, _exit
        abi macos_arm64
    }
}

trust omega_darwin_process_adapter {
    owner omega::host::darwin
    reason "Omega adapter maps Process.exit to libSystem _exit"
    depends omega_darwin_libsystem
}

trust omega_darwin_stdout_adapter {
    owner omega::host::darwin
    reason "Omega adapter maps Stdout.write_line to libSystem _write"
    depends omega_darwin_libsystem
}

trust omega_darwin_stdin_adapter {
    owner omega::host::darwin
    reason "Omega adapter maps Stdin.read_line to libSystem _read"
    depends omega_darwin_libsystem
}

trust darwin_libsystem_abi {
    owner omega::host::darwin
    reason "Generated calls obey the Darwin libSystem ABI"
}
