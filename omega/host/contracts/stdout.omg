use omega::host::contracts::types;

capability Stdout {
    entry write(buf: Slice<u8>) -> Result<usize, IOError> where {
        requires buf.initialized
        requires buf.len <= usize.max
        ensures result.Ok || result.Err
        trust host
    }

    entry write_line(text: String) -> Result<(), IOError> where {
        requires text.utf8
        ensures result.Ok || result.Err
        trust host
    }
}
