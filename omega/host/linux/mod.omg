use omega::host::linux::process;
use omega::host::linux::stdout;
use omega::host::linux::syscalls;
use omega::host::linux::trusts;
use omega::host::linux::types;

// Linux host package shipped with the Omega toolchain.
//
// Linux is the platform where direct syscalls are a plausible tiny target.
// The syscall ABI is still trusted host machinery, not app-proven behavior.

capability LinuxHost {
    syscalls: LinuxSyscalls
    stdout: LinuxStdout
    process: LinuxProcess
}
