// GRAMMAR.md: assembly.
asm machine syscall_write(fd: u64, bytes: &[u8]) -> u64
registers rdi = fd
registers rsi = bytes.address
clobbers rcx, r11
{
    mov rax, 1;
    syscall;
    transition -> done;
    ret

    asm machine done {
        mov rax, [rbx + 8];
        b.eq target
    }
}

public asm machine halt clobbers none {
}

machine mixed(value: u64) -> u64 {
    let doubled = value * 2;
    asm registers rax = doubled clobbers none {
        add rax, rax;
        nop
    }
    asm {
    }
    doubled
}
