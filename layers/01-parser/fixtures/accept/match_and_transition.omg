// GRAMMAR.md: match and transition share one grammar; arms are separated by commas.
machine dispatch(command: Command, a: u32, b: u32) -> u32 {
    let first = match command.op {
        Command::Operation::GetUser { user_id } -> lookup(user_id),
        Command::Operation::CountUsers -> count()
    };
    let second = match (command.command_id, command.op) {
        (0, _) -> reject(),
        (_, Command::Operation::GetUser { user_id }) -> lookup(user_id),
        (_, Command::Operation::CountUsers) -> count(),
    };
    let third = match { a > b -> a, _ -> b };
    let fourth = match a { 0 -> match b { 0 -> 1, _ -> 2 }, _ -> 3 };
    let fifth = match (Point { x: a, y: b }) { _ -> 0 };

    transition {
        (a + b) > first -> grow(),
        (a) -> same(),
        a == b && second > third -> equal(),
        _ -> shrink(),
    }
}

machine one_line(n: u32) -> u32 {
    transition n { 0 -> zero(), 1 -> one(), _ -> many() }
}

machine no_arms(n: Never) {
    transition n {}
}
