// GRAMMAR.md: data. Records, sums, nesting, stable numbers, requires, aliases, attributes.
data Point {
    x: i32;
    y: i32;
}

public data Command<T> {
    #1 command_id: u64;
    #2 op: data Operation {
        #1 case GetUser(#1 user_id: u64, #2 flags: u8);
        case CountUsers;
    };
    data Header {
        length: u32 in Positive & Small;
    }
    payload [erased]: Valid<T>;
}

data Bounded
requires self.low <= self.high
requires self.high < 100
{
    low: u8;
    high: u8;
}

data SmallBytes = ByteBuffer<64>;

data Lease<T> [linear, carry(suspension: allowed, transfer: refused)] dropped by release_guard<T> {
    pool: &mut Pool<T>;
    slot: u32;
}

// `case` and `data` are field names when a `:` follows them.
data Words {
    case: u8;
    data: [u8; 4];
}
