// GRAMMAR.md: header clauses. Nothing separates a clause from what follows it.
machine every_clause(n: u32, limit: u32) -> u32
requires n > 0
requires n < limit
ensures result >= n
reaches Outcome<u32>
crashes none
blocks
suspends false
terminates by limit - n -> Nat::Descending in 0..=limit
invokes Logger::write
satisfies Pure
{
    n
}

machine other_terminations() terminates {
}

machine measured(items: @[u8]) terminates by items -> Slice::Length {
}

machine bounded(n: u32) terminates by n in limit {
}

boundary machine bodyless(n: u32) -> u32 requires n > 0 ensures result > n;

// A clause word in operand position is a name, and words are whole tokens.
machine names(reaches: u32, ensures_more: u32) -> u32
requires reaches < ensures_more
requires ensures_more()
ensures reaches == result
{
    reaches
}

// A record literal in a clause needs parentheses, because `{` opens the body.
machine guarded(p: Point) requires p == (Point { x: 0, y: 0 }) {
}
