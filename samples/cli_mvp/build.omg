// CLI MVP build sketch.
//
// Build configuration is Omega source. No TOML/YAML side language.

use omega::host::contracts;
use omega::host::darwin;
use omega::host::linux;
use omega::host::standard;
use omega::host::windows;
//
// Hello world needs only two host capabilities:
//
// - stdout.write_line: writes initialized UTF-8 bytes to process stdout.
// - process.exit: terminates the process with a target-specific exit code.
//
// Cross-platform providers map those contracts to OS calls:
//
// - Linux/macOS: write(1, bytes, len), then exit(code).
// - Windows: WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), bytes, len), then
//   ExitProcess(code).

target cross_platform_cli {
    host: StandardHost {
        abi = target_default
        stdout = enabled
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    trust host_contracts
    trust standard_host_abi
}

target linux_x64 {
    host: LinuxHost {
        abi = syscall
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    trust host_contracts
    trust linux_syscall_abi
}

target macos_arm64 {
    host: DarwinHost {
        abi = libSystem
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    trust host_contracts
    trust darwin_libsystem_abi
}

target windows_x64 {
    host: WindowsHost {
        abi = win32
        stdout = standard_handle(stdout)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    trust host_contracts
    trust windows_loader
    trust win32_contracts
    trust windows_x64_calling_convention
}

// A permissive development build should still be auditable.
target local_unchecked {
    host: StandardHost {
        abi = target_default
        stdout = enabled
        process = enabled
    }

    trust host_contracts
    trust unchecked invariant_proofs
}
