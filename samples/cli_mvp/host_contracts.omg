// CLI MVP host capability contracts sketch.
//
// Capability definitions declare trust needs. Build policy grants or denies
// those needs. Application code consumes the resulting Host.

capability Stdout {
    state write(buf: Slice<u8>) -> Result<usize, IOError>
        requires buf.initialized
        requires buf.len <= usize.max
        ensures result.Ok(n) => n <= buf.len
        ensures result.Err(e) => e is IOError
        trusted host

    state write_line(text: String) -> Result<(), IOError>
        requires text.utf8
        ensures result.Ok => stdout_observed(text + "\n") || host_buffered(text + "\n")
        ensures result.Err(e) => e is IOError
        trusted host
}

capability Process {
    state exit(return_code: i32) -> Never
        requires target_accepts_exit_code(return_code)
        ensures process_terminated
        trusted host
}

capability Host {
    stdout: Stdout
    process: Process
}

// Future application shape once state parameters can receive host roots:
//
// machine main {
//     state entry(host: Host) {
//         host.stdout.write_line("Hello, Omega.");
//         host.process.exit(0);
//     }
// }
//
// Trust inventory:
//
// - Trusted: host stdout implementation obeys `Stdout.write_line`.
// - Trusted: host process implementation obeys `Process.exit`.
// - Proven: string literal storage is initialized.
// - Proven: string literal is valid UTF-8.
// - Checked or trusted by target: exit code representation matches host rules.
//
// Subtle cross-platform wrinkle:
//
// Unix process exit status is commonly observed as the low 8 bits, while
// Windows `ExitProcess` carries a 32-bit unsigned code. Omega should model a
// target-specific observable exit-code contract instead of pretending every OS
// reports `i32` identically.
