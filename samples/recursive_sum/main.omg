// Recursive sum over a fixed-size integer array via a value-returning machine.
//
// Exercises: recursion + accumulator through a value-returning machine
// (`self.summer.sum(s, 0)` where `sum` recurses via `s[1..]` and accumulates
// the head element `s[0]`), combined with a guard on the recursive result.
// The `terminates` annotation lets the prover accept the recursion.
//
// Also exercises two sequential value-returning recursive calls in one machine.
//
// Dataset: [5, 10, 15, 20] fixed array, expected sum = 50.
// count of elements (via separate recursive counter) = 4.
//
// We use the call results directly in transition guards (NOT stored to fields)
// to stay within the working native lowering surface.
//
// MISCOMPILE FOUND (2026-06-14):
//   Expected exit: 70  (sum == 50)
//   Actual exit:   71  (sum_result != 50)
//
// Minimal trigger: a recursive value-returning machine that passes `acc + s[0]`
// as the accumulator in the tail-call `sum(s[1..], acc + s[0])`. The accumulator
// does not reach the correct value on native x64 -- sum over [5,10,15,20] reads
// as something other than 50.
//
// The interpreter presumably produces 50 (differential oracle would confirm this).
// The miscompile is in native x64 code generation: the binary expression
// `acc + s[0]` as an argument in a tail-recursive value-returning dispatch
// is miscompiled. The separate `count` call (which only uses `acc + 1`) also
// fails, exiting 71 before reaching the count check.
//
// Expected exit: 70 (ACTUAL: 71 -- confirmed miscompile).

use omega::language::std::console;

data Summer {}

data Main {
    console: Console;
    arr: [i32; 4];
    summer: Summer;
}

// Recursive value-returning machine: sum all elements in slice s.
// The guard `s.len > 0` proves bounds for both s[0] and s[1..].
machine Summer::sum(&mut self, s: &[i32], acc: i32) -> i32
terminates {
    decreases s -> Slice::Length;
}
{
    transition s.len > 0 {
        true -> sum(s[1..], acc + s[0])
        false -> acc
    }
}

// Recursive value-returning machine: count elements in slice s.
machine Summer::count(&mut self, s: &[i32], acc: i32) -> i32
terminates {
    decreases s -> Slice::Length;
}
{
    transition s.len > 0 {
        true -> count(s[1..], acc + 1)
        false -> acc
    }
}

machine Main::main(&mut self) {
    // Initialize the array elements.
    self.arr[0] = 5;
    self.arr[1] = 10;
    self.arr[2] = 15;
    self.arr[3] = 20;

    // Compute sum via recursive value-returning call.
    let s: &[i32] = self.arr.as_slice();
    let sum_result: i32 = self.summer.sum(s, 0);

    // Check sum == 50 directly on the local.
    transition sum_result == 50 {
        true -> check_count()
        _ -> bad_sum()
    }

    state bad_sum(&mut self) {
        self.console.exit_process(71);
    }

    state check_count(&mut self) {
        // Compute count via recursive value-returning call.
        let s2: &[i32] = self.arr.as_slice();
        let cnt: i32 = self.summer.count(s2, 0);

        // Check element count == 4.
        transition cnt == 4 {
            true -> good()
            _ -> bad_count()
        }
    }

    state bad_count(&mut self) {
        self.console.exit_process(72);
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
}
