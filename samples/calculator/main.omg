// A two-digit calculator -- a small but complete app that ties together everything
// needed to read and evaluate input. It parses the expression "12+34": the operands
// are read from the text by widening each character byte with `as i32`, subtracting
// '0', and combining as tens*10+ones (the parse_number pattern); the operator is
// dispatched by indexing the operator byte in a guard (`text[2] == '+'` / `'-'`);
// and the result is computed with DECLARED Wrapping arithmetic (carrier byte
// reads carry no range facts yet, so a parse accumulator cannot prove its
// bounds -- decision 17 keeps the modular semantics honest). "12+34" -> 12 + 34 = 46.
// Supports '+' (exit a+b) and '-' (exit a-b); an unknown operator exits 0.
// Expected exit: 46.

domain [u8]::Utf8 when valid_utf8(self) {}
domain [u8; 8]::Utf8 when valid_utf8(self) {}

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    text: [u8; 8] in Utf8;
    // Wrapping DECLARED: parse accumulators over carrier bytes -- element reads
    // carry no range facts yet, so tens*10+ones cannot prove its bounds.
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    tmp: i32 in Wrapping;
    result: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.text = "12+34";

    // First operand from text[0..1].
    self.a = self.text[0] as i32;
    self.a = self.a - 48;
    self.a = self.a * 10;
    self.tmp = self.text[1] as i32;
    self.tmp = self.tmp - 48;
    self.a = self.a + self.tmp;

    // Second operand from text[3..4].
    self.b = self.text[3] as i32;
    self.b = self.b - 48;
    self.b = self.b * 10;
    self.tmp = self.text[4] as i32;
    self.tmp = self.tmp - 48;
    self.b = self.b + self.tmp;

    // Dispatch on the operator byte text[2].
    transition self.text[2] == 43 {
        true -> do_add()
        _ -> check_sub()
    }

    state check_sub(&mut self) {
        transition self.text[2] == 45 { true -> do_sub() _ -> unknown() }
    }

    state do_add(&mut self) { self.result = self.a + self.b; transition { _ -> emit() } }
    state do_sub(&mut self) { self.result = self.a - self.b; transition { _ -> emit() } }
    state unknown(&mut self) { self.console.exit_process(0); }
    state emit(&mut self) { self.console.exit_process(self.result); }
}
