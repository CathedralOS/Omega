// Parse a two-digit number out of its text form -- the core of reading numeric
// input. Each character byte is converted to its integer value with an explicit
// `as i32` cast (which zero-extends the u8 into an i32), then '0' (48) is subtracted
// to get the digit, and the digits are combined as `tens*10 + ones`. For "25" this
// yields 2*10 + 5 = 25. The arithmetic is fully EXACT: a carrier byte read carries no
// range fact yet, so each cast is folded through `% 256` (an identity for a u8-sourced
// value) to bound it, after which every step is verifiably in range -- no overflow
// domain needed. (The `as i32` cast is required: a carrier byte is a u8, and widening
// to i32 is explicit.)
// Expected exit: 25.

domain [u8]::Utf8 when valid_utf8(self) {}
domain [u8; 4]::Utf8 when valid_utf8(self) {}

boundary trait Console {
    machine write_line(text: String);
    machine read_line(out_line: &mut String);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    pause: String;
    text: [u8; 4] in Utf8;
    tens: i32;
    ones: i32;
    value: i32;
}

machine Main::main(&mut self) {
    self.text = "25";

    self.tens = (self.text[0] as i32) % 256;
    self.tens = self.tens - 48;
    self.ones = (self.text[1] as i32) % 256;
    self.ones = self.ones - 48;
    self.value = self.tens * 10 + self.ones;

    transition { _ -> done() }

    state done(&mut self) {
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.value);
    }
}
