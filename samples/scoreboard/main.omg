// A fixed-capacity table of records: `players: [Player; 3]`, each a struct with an
// `id` and a `score`. Demonstrates array-of-structs storage -- the building block
// for records/tables in serious apps -- via constant-index field writes
// (`self.players[k].score = ...`) and a multi-field read in arithmetic
// (`players[0].score + players[1].score + players[2].score`). The scores 30 + 25 +
// 15 total 70 (in a Trapping domain). (Runtime-index access into such a table needs
// a bounds proof and is exercised elsewhere; this sample uses constant indices.)
// Expected exit: 70.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Player {
    id: i32;
    score: i32 in Trapping;
}

data Main {
    console: Console;
    players: [Player; 3];
    total: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.players[0].id = 1;
    self.players[0].score = 30;
    self.players[1].id = 2;
    self.players[1].score = 25;
    self.players[2].id = 3;
    self.players[2].score = 15;

    self.total = self.players[0].score + self.players[1].score + self.players[2].score;

    transition { _ -> done() }

    state done(&mut self) {
        self.console.exit_process(self.total);
    }
}
