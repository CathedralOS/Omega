// Mandelbrot set, software-rendered to the console as ASCII. A real per-pixel
// renderer: for each cell map (x,y) to a complex c, run the escape-time iteration
// z = z*z + c until |z|^2 > 4 or a cap, and pick a palette glyph by escape speed.
// Pure compute -- 1D carrier framebuffer (row), nested loops, f64 math, runtime-
// indexed carrier byte writes, write_line per row. No new compiler features.
//
//   set body -> '#', exterior fades to ' '.
// Expected exit: 0.
use omega::language::std::console;

domain [u8]::Utf8 when valid_utf8(self) {}
domain [u8; 64]::Utf8 when valid_utf8(self) {}
domain [u8; 8]::Utf8 when valid_utf8(self) {}

data Main {
    console: Console;
    row: [u8; 64] in Utf8;
    palette: [u8; 8] in Utf8;
    x: i32 in Trapping;
    y: i32 in Trapping;
    cr: f64;
    ci: f64;
    zr: f64;
    zi: f64;
    zr2: f64;
    zi2: f64;
    mag: f64;
    k: i32 in Trapping;
    idx: i32 in Trapping;
    ch: u8 in Wrapping;
}

machine Main::main(&mut self) {
    self.palette = " .:-=+*#";
    self.row = "................................................................";
    self.y = 0;
    transition { _ -> row_loop() }

    state row_loop(&mut self) {
        transition self.y < 28 { true -> col_init() _ -> done() }
    }
    state col_init(&mut self) {
        self.x = 0;
        transition { _ -> col_loop() }
    }
    state col_loop(&mut self) {
        transition self.x >= 0 && self.x < 64 { true -> pixel_init() _ -> emit_row() }
    }
    state pixel_init(&mut self) {
        self.cr = (self.x as f64 / 64.0) * 3.5 - 2.5;
        self.ci = (self.y as f64 / 28.0) * 2.6 - 1.3;
        self.zr = 0.0;
        self.zi = 0.0;
        self.k = 0;
        transition { _ -> iter_loop() }
    }
    state iter_loop(&mut self) {
        transition self.k < 28 { true -> iter_test() _ -> pixel_done() }
    }
    state iter_test(&mut self) {
        self.zr2 = self.zr * self.zr;
        self.zi2 = self.zi * self.zi;
        self.mag = self.zr2 + self.zi2;
        transition self.mag > 4.0 { true -> pixel_done() _ -> iter_step() }
    }
    state iter_step(&mut self) {
        self.zi = 2.0 * self.zr * self.zi + self.ci;
        self.zr = self.zr2 - self.zi2 + self.cr;
        self.k = self.k + 1;
        transition { _ -> iter_loop() }
    }
    state pixel_done(&mut self) {
        self.idx = self.k * 7 / 28;
        transition self.idx >= 0 && self.idx < 8 && self.x >= 0 && self.x < 64 {
            true -> write_pixel()
            _ -> bad()
        }
    }
    state write_pixel(&mut self) {
        self.ch = self.palette[self.idx] as u8 in Wrapping;
        self.row[self.x] = self.ch;
        self.x = self.x + 1;
        transition { _ -> col_loop() }
    }
    state emit_row(&mut self) {
        self.console.write_line(self.row);
        self.y = self.y + 1;
        transition { _ -> row_loop() }
    }
    state done(&mut self) { self.console.exit_process(0); }
    state bad(&mut self) { self.console.exit_process(1); }
}
