// Vending machine sample build sketch.
//
// Exercises case-member payloads, type properties, and transition dispatch
// end-to-end. Needs only stdout + process.exit, like cli_mvp.

target cross_platform_cli {
    boundary omega::host::contracts
    boundary omega::host::standard
}

target windows_x64 {
    boundary omega::host::contracts
    boundary omega::host::targets::windows
}

target linux_x64 {
    boundary omega::host::contracts
    boundary omega::host::targets::linux
}
