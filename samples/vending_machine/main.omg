// A vending machine driven by a stream of case-payload events.
//
// Showcases features landed in the 2026-06 waves working together in one
// program: `case` members with named payloads, type properties on plain
// data, payload binding in transition arms, and value-position machine
// calls. The exit code reports the final dispensed total so the run is
// verifiable end to end (expected: 70).

use omega::language::std::console;

// A coin or a button press. `Insert` carries how many cents arrived; `Press`
// carries which slot was chosen. The first case is the payload-free zero
// case (ZII), so a zeroed Event is `Idle`.
data Event {
    case Idle;
    case Insert(cents: i32);
    case Press(slot: i32);
}

// The running register. `[copy, zero_init]` are verified declared properties:
// every field is a scalar (copy holds) and zero is the empty machine (no
// balance, nothing dispensed).
data Register [copy, zero_init] {
    balance: i32;
    dispensed: i32;
}

data Main {
    console: Console;
    register: Register;
}

machine Main::main(&mut self) {
    // Three events: insert 50c, insert 25c, press slot 1 (price 75c).
    self.apply(Event::Insert { cents: 50 });
    self.apply(Event::Insert { cents: 25 });
    self.apply(Event::Press { slot: 1 });

    // After the press the balance should be spent and 75c of product
    // dispensed; encode "balance 0 and dispensed 75" as exit 70.
    transition self.register.balance == 0 {
        true -> check_dispensed()
        false -> report(71)
    }

    state check_dispensed(&mut self) {
        transition self.register.dispensed == 75 {
            true -> report(70)
            false -> report(72)
        }
    }

    state report(&mut self, code: i32) {
        self.console.exit_process(code);
    }
}

// Fold one event into the register. Coins add to the balance; a press that
// the balance covers dispenses the price and spends the balance.
machine Main::apply(&mut self, event: Event) {
    transition event {
        Event::Insert { cents } -> add_balance(cents)
        Event::Press { slot } -> try_dispense(slot)
        _ -> idle()
    }

    state add_balance(&mut self, cents: i32) {
        self.register.balance = self.register.balance + cents;
    }

    state try_dispense(&mut self, slot: i32) {
        let price: i32 = self.price_of(slot);
        transition self.register.balance >= price {
            true -> dispense(price)
            false -> idle()
        }
    }

    state dispense(&mut self, price: i32) {
        self.register.dispensed = self.register.dispensed + price;
        self.register.balance = 0;
    }

    state idle(&mut self) {
    }
}

// Slot 1 costs 75 cents; everything else is free (price 0) for this demo.
machine Main::price_of(&mut self, slot: i32) -> i32 {
    transition slot == 1 {
        true -> seventy_five()
        _ -> zero()
    }

    state seventy_five(&mut self) -> i32 {
        transition {
            _ -> 75
        }
    }

    state zero(&mut self) -> i32 {
        transition {
            _ -> 0
        }
    }
}
