// Overflow-safe reduction: sum a [i32; N] array into an i64 accumulator so a
// total that would overflow i32 is computed correctly. Summing 2_000_000_000 +
// 200_000_000 = 2_200_000_000 exceeds i32's max (2_147_483_647) -- in an i32
// Trapping accumulator that add would TRAP; widening each element to i64 first
// keeps the running total in range. The result is checked to equal 2.2e9.
//
// Note the read-then-widen idiom: `cur = nums[i]; wide = cur as i64`. Today a
// runtime-indexed read must be materialized into a field before it can be used
// inside a larger expression (a cast or arithmetic) -- writing the widening
// inline as `sum = sum + nums[i] as i64` is a known gap (the machine-indexed
// value operand). The temp makes the same computation work now.
//
// Expected exit: 70.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    nums: [i32; 2];
    i: i32 in Trapping;
    cur: i32;
    wide: i64 in Trapping;
    sum: i64 in Trapping;
}

machine Main::main(&mut self) {
    self.nums[0] = 2000000000;
    self.nums[1] = 200000000;
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 2 {
            true -> add()
            _ -> done()
        }
    }

    state add(&mut self) {
        self.cur = self.nums[self.i];
        self.wide = self.cur as i64;
        self.sum = self.sum + self.wide;
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        transition self.sum == 2200000000 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
