// Overflow-safe reduction: sum a [i32; N] array into an i64 accumulator so a
// total that would overflow i32 is still correct. 2_000_000_000 + 200_000_000 =
// 2_200_000_000 exceeds i32's max (2_147_483_647) -- in an i32 Trapping
// accumulator that add would TRAP; widening each element to i64 first keeps the
// running total in range. The result is checked to equal 2.2e9.
//
// The element is read and widened INLINE -- `sum + nums[i] as i64 in Trapping` --
// a runtime-indexed read now works as a sub-expression operand. The `in Trapping`
// matches the accumulator's domain (decision 17: arithmetic operands must share
// an arithmetic domain).
//
// Expected exit: 70.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    nums: [i32; 2] in Trapping;
    i: i32 in Trapping;
    sum: i64 in Trapping;
}

machine Main::main(&mut self) {
    self.nums[0] = 2000000000;
    self.nums[1] = 200000000;
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 2 {
            true -> add()
            _ -> done()
        }
    }

    state add(&mut self) {
        self.sum = self.sum + self.nums[self.i] as i64 in Trapping;
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        transition self.sum == 2200000000 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
