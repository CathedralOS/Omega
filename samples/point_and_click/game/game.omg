use data::game_types;
use rooms::manager;

machine Game {
    contains rooms: RoomManager;
    owns view: MainView;

    command RunIteration(frame: FrameInput) {
        rooms.Tick(frame);
        ComposeView(mut view);
    }

    command ComposeView(mut out_view: MainView) {
        let inventory_snapshot: Inventory;
        rooms.WriteActiveRoomView(mut out_view.room);
        rooms.WriteInventory(mut inventory_snapshot);
        out_view.hud.has_key = inventory_snapshot.has_key;
    }

    command WriteView(mut out_view: MainView) {
        out_view = view;
    }
}
