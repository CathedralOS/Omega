use data::game_types;
use rooms::cellar;
use rooms::foyer;

machine RoomManager {
    contains foyer: FoyerRoom;
    contains cellar: CellarRoom;

    owns inventory: Inventory;
    owns active_room: RoomId = RoomId::Foyer;

    invariant OneActiveRoom {
        active_room in [RoomId::Foyer, RoomId::Cellar];
    }

    command tick(frame: FrameInput) {
        tick_foyer(frame);
        tick_cellar(frame);
    }

    command tick_foyer(frame: FrameInput) when active_room == RoomId::Foyer {
        foyer.tick(frame, mut inventory, mut active_room);
    }

    command tick_cellar(frame: FrameInput) when active_room == RoomId::Cellar {
        cellar.tick(frame, mut inventory, mut active_room);
    }

    command write_active_room_view(mut out_view: RoomView) {
        write_foyer_view(mut out_view);
        write_cellar_view(mut out_view);
    }

    command write_foyer_view(mut out_view: RoomView) when active_room == RoomId::Foyer {
        foyer.write_view(mut out_view);
    }

    command write_cellar_view(mut out_view: RoomView) when active_room == RoomId::Cellar {
        cellar.write_view(mut out_view);
    }

    command write_inventory(mut out_inventory: Inventory) {
        out_inventory = inventory;
    }
}
