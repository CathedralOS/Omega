use data::game_types;
use rooms::cellar;
use rooms::foyer;

machine RoomManager {
    contains foyer: FoyerRoom;
    contains cellar: CellarRoom;

    owns inventory: Inventory;
    owns active_room: RoomId = RoomId::Foyer;

    invariant OneActiveRoom {
        active_room in [RoomId::Foyer, RoomId::Cellar];
    }

    command Tick(frame: FrameInput) {
        TickFoyer(frame);
        TickCellar(frame);
    }

    command TickFoyer(frame: FrameInput) when active_room == RoomId::Foyer {
        foyer.Tick(frame, mut inventory, mut active_room);
    }

    command TickCellar(frame: FrameInput) when active_room == RoomId::Cellar {
        cellar.Tick(frame, mut inventory, mut active_room);
    }

    command WriteActiveRoomView(mut out_view: RoomView) {
        WriteFoyerView(mut out_view);
        WriteCellarView(mut out_view);
    }

    command WriteFoyerView(mut out_view: RoomView) when active_room == RoomId::Foyer {
        foyer.WriteView(mut out_view);
    }

    command WriteCellarView(mut out_view: RoomView) when active_room == RoomId::Cellar {
        cellar.WriteView(mut out_view);
    }

    command WriteInventory(mut out_inventory: Inventory) {
        out_inventory = inventory;
    }
}
