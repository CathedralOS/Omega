use data::game_types;
use rooms::cellar;
use rooms::foyer;

machine RoomManager {
    contains foyer: FoyerRoom;
    contains cellar: CellarRoom;

    owns inventory: Inventory;
    owns active_room: RoomId = RoomId::Foyer;

    invariant OneActiveRoom {
        active_room in [RoomId::Foyer, RoomId::Cellar];
    }

    fn tick(frame: FrameInput) {
        -> tick_foyer(frame) when active_room == RoomId::Foyer;
        -> tick_cellar(frame) when active_room == RoomId::Cellar;
        ->
    }

    state tick_foyer(frame: FrameInput) {
        foyer.tick(frame, mut inventory, mut active_room);
    }

    state tick_cellar(frame: FrameInput) {
        cellar.tick(frame, mut inventory, mut active_room);
    }

    fn write_active_room_view(out_view: &mut RoomView) {
        -> write_foyer_view(mut out_view) when active_room == RoomId::Foyer;
        -> write_cellar_view(mut out_view) when active_room == RoomId::Cellar;
        ->
    }

    state write_foyer_view(out_view: &mut RoomView) {
        foyer.write_view(mut out_view);
    }

    state write_cellar_view(out_view: &mut RoomView) {
        cellar.write_view(mut out_view);
    }

    fn write_inventory(out_inventory: &mut Inventory) {
        out_inventory = inventory;
    }
}
