use data::game_types;

machine CellarRoom {
    owns intro_seen: bool = false;

    fn tick(frame: FrameInput, inventory: &mut Inventory, active_room: &mut RoomId) {
        -> mark_intro_seen(frame) when frame.left_pressed;
        ->
    }

    state mark_intro_seen(frame: FrameInput) {
        intro_seen = true;
    }

    fn write_view(out_view: &mut RoomView) {
        out_view.room_name = "Cellar";
        out_view.hotspots = [];
        out_view.hotspot_count = 0;
    }
}
