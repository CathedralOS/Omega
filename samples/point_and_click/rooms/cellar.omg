use data::game_types;

machine CellarRoom {
    owns intro_seen: bool = false;

    command Tick(frame: FrameInput, mut inventory: Inventory, mut active_room: RoomId) {
        MarkIntroSeen(frame);
    }

    command MarkIntroSeen(frame: FrameInput) when frame.left_pressed {
        intro_seen = true;
    }

    command WriteView(mut out_view: RoomView) {
        out_view.room_name = "Cellar";
        out_view.hotspots = [];
        out_view.hotspot_count = 0;
    }
}
