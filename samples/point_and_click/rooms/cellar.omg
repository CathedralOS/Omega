use data::game_types;

machine CellarRoom {
    owns intro_seen: bool = false;

    state tick(frame: FrameInput, mut inventory: Inventory, mut active_room: RoomId) {
        -> mark_intro_seen(frame) when frame.left_pressed;
        ->
    }

    state mark_intro_seen(frame: FrameInput) {
        intro_seen = true;

        ->
    }

    state write_view(mut out_view: RoomView) {
        out_view.room_name = "Cellar";
        out_view.hotspots = [];
        out_view.hotspot_count = 0;
    }
}
