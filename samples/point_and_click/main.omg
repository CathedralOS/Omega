use data::game_types;
use game::game;
use platform::desktop;

machine main {
    contains platform: DesktopPlatform;
    contains game: Game;

    owns main_window: WindowHandle;
    owns frame_input: FrameInput;
    owns frame_view: MainView;
    owns is_terminated: bool = false;
    owns return_code: i32 = 0;

    fn entry() {
        platform.create_window(mut main_window, 1920, 1080, "Point and Click");

        -> running();
    }

    state running() {
        platform.poll_frame(main_window, mut frame_input);
        game.run_iteration(frame_input);
        game.write_view(mut frame_view);
        platform.draw_room(frame_view.room);
        platform.draw_hud(frame_view.hud);
        platform.present_backbuffer(main_window);

        -> shutdown() when frame_input.close_requested;
        -> self();
    }

    state shutdown() {
        is_terminated = true;
        return_code = 0;
        platform.destroy_window(main_window);
        platform.exit_process(return_code);
    }
}
