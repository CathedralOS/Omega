use data::game_types;

platform DesktopPlatform {
    fn create_window(window: &mut WindowHandle, width: u32, height: u32, title: String);
    fn poll_frame(window: WindowHandle, frame: &mut FrameInput);
    fn draw_room(room: RoomView);
    fn draw_hud(hud: HudView);
    fn present_backbuffer(window: WindowHandle);
    fn destroy_window(window: WindowHandle);
    fn exit_process(return_code: i32);
}
