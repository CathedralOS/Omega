use data::game_types;

platform DesktopPlatform {
    command create_window(mut window: WindowHandle, width: u32, height: u32, title: String);
    command poll_frame(window: WindowHandle, mut frame: FrameInput);
    command draw_room(room: RoomView);
    command draw_hud(hud: HudView);
    command present_backbuffer(window: WindowHandle);
    command destroy_window(window: WindowHandle);
    command exit_process(return_code: i32);
}
