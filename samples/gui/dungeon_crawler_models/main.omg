use {dungeon_core}/actors/combat/combat.omg;
use {dungeon_core}/actors/state/state.omg as actor_state;
use {dungeon_core}/actors/travel/travel.omg;
use {dungeon_core}/configuration/configuration.omg;
use {dungeon_core}/control/routing/routing.omg;
use {dungeon_core}/control/state/state.omg as state_state;
use {dungeon_core}/world/rooms/rooms.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0.
// Expected output contains: PASS: bounded components and terminating controller fan-out

data Smoke {
    actors: |actor_state|::ActorSet<2, 4>;
    controllers: |state_state|::ControllerSet<3, 2>;
    intents: |state_state|::IntentSet<2>;
    timer: |actor_state|::Countdown<|configuration|::ATTACK_FRAMES>;
    dungeon: |rooms|::Dungeon<4>;
}

machine hit_matches(origin: |actor_state|::Position, target: |actor_state|::Position, direction: i32, expected: |actor_state|::Position) -> bool
requires direction >= 0 && direction < 4 {
    let attacker: |actor_state|::Actor<4> = |actor_state|::Actor { position: origin, vitality: |actor_state|::Vitality { current: 6, maximum: 6 }, attack: |actor_state|::Countdown { remaining: |configuration|::ATTACK_FRAMES - 1 }, facing: direction, faction: 0, active: true, .. };
    let enemy: |actor_state|::Actor<4> = |actor_state|::Actor { position: target, vitality: |actor_state|::Vitality { current: 2, maximum: 2 }, faction: 1, active: true, .. };
    let hit: |actor_state|::Actor<4> = |combat|::strike::<4>(attacker, enemy);
    hit.vitality.current == 1 && hit.position.x == expected.x && hit.position.y == expected.y && hit.room == enemy.room
}

machine miss_matches(attacker: |actor_state|::Actor<4>, enemy: |actor_state|::Actor<4>) -> bool {
    let missed: |actor_state|::Actor<4> = |combat|::strike::<4>(attacker, enemy);
    missed.vitality.current == enemy.vitality.current && missed.position.x == enemy.position.x && missed.position.y == enemy.position.y
}

machine check_knockback() -> bool {
    hit_matches(|actor_state|::Position { x: 128, y: 80 }, |actor_state|::Position { x: 140, y: 80 }, 1, |actor_state|::Position { x: 152, y: 80 })
        && hit_matches(|actor_state|::Position { x: 128, y: 80 }, |actor_state|::Position { x: 128, y: 68 }, 0, |actor_state|::Position { x: 128, y: 56 })
        && hit_matches(|actor_state|::Position { x: 128, y: 80 }, |actor_state|::Position { x: 128, y: 92 }, 2, |actor_state|::Position { x: 128, y: 104 })
        && hit_matches(|actor_state|::Position { x: 128, y: 80 }, |actor_state|::Position { x: 116, y: 80 }, 3, |actor_state|::Position { x: 104, y: 80 })
        && hit_matches(|actor_state|::Position { x: |configuration|::ROOM_WIDTH - 16, y: 80 }, |actor_state|::Position { x: |configuration|::ROOM_WIDTH - 4, y: 80 }, 1, |actor_state|::Position { x: |configuration|::ROOM_WIDTH - 1, y: 80 })
        && hit_matches(|actor_state|::Position { x: 128, y: 15 }, |actor_state|::Position { x: 128, y: 3 }, 0, |actor_state|::Position { x: 128, y: 0 })
        && hit_matches(|actor_state|::Position { x: 128, y: |configuration|::ROOM_HEIGHT - 16 }, |actor_state|::Position { x: 128, y: |configuration|::ROOM_HEIGHT - 4 }, 2, |actor_state|::Position { x: 128, y: |configuration|::ROOM_HEIGHT - 1 })
        && hit_matches(|actor_state|::Position { x: 15, y: 80 }, |actor_state|::Position { x: 3, y: 80 }, 3, |actor_state|::Position { x: 0, y: 80 })
}

machine check_misses() -> bool {
    let attacker: |actor_state|::Actor<4> = |actor_state|::Actor { position: |actor_state|::Position { x: 128, y: 80 }, vitality: |actor_state|::Vitality { current: 6, maximum: 6 }, attack: |actor_state|::Countdown { remaining: |configuration|::ATTACK_FRAMES - 1 }, facing: 1, faction: 0, active: true, .. };
    let friendly: |actor_state|::Actor<4> = |actor_state|::Actor { position: |actor_state|::Position { x: 140, y: 80 }, vitality: |actor_state|::Vitality { current: 2, maximum: 2 }, faction: 0, active: true, .. };
    let behind: |actor_state|::Actor<4> = |actor_state|::Actor { position: |actor_state|::Position { x: 116, y: 80 }, vitality: |actor_state|::Vitality { current: 2, maximum: 2 }, faction: 1, active: true, .. };
    let distant: |actor_state|::Actor<4> = |actor_state|::Actor { position: |actor_state|::Position { x: 160, y: 80 }, vitality: |actor_state|::Vitality { current: 2, maximum: 2 }, faction: 1, active: true, .. };
    let other_room: |actor_state|::Actor<4> = |actor_state|::Actor { position: |actor_state|::Position { x: 140, y: 80 }, vitality: |actor_state|::Vitality { current: 2, maximum: 2 }, room: 1, faction: 1, active: true, .. };
    miss_matches(attacker, friendly) && miss_matches(attacker, behind) && miss_matches(attacker, distant) && miss_matches(attacker, other_room)
}

machine check_input(controls: @mutable |state_state|::ControllerSet<3, 2>, intents: @mutable |state_state|::IntentSet<2>) -> bool {
    controls.bindings[0] = |state_state|::ControllerBinding { actor: 0, source: |state_state|::ControlSource::Input { device: 0 } };
    controls.bindings[1] = |state_state|::ControllerBinding { actor: 1, source: |state_state|::ControlSource::Input { device: 0 } };
    controls.bindings[2] = |state_state|::ControllerBinding { actor: 0, source: |state_state|::ControlSource::Input { device: 1 } };
    controls.count = 0;
    intents.items[0] = |state_state|::Command { direction: 2, attack: false };
    intents.items[1] = |state_state|::Command { direction: 3, attack: false };
    |routing|::route_input::<3, 2>(controls, intents, 0, |state_state|::Command { direction: 1, attack: true });
    let zero_live: bool = intents.items[0].direction == 2 && !intents.items[0].attack
        && intents.items[1].direction == 3 && !intents.items[1].attack;
    controls.count = 2;
    |routing|::route_input::<3, 2>(controls, intents, 0, |state_state|::Command { direction: 1, attack: true });
    let second_device: |state_state|::Command = |state_state|::Command { direction: 3, attack: false };
    |routing|::route_input::<3, 2>(controls, intents, 1, second_device);
    let live_prefix: bool = intents.items[0].direction == 1 && intents.items[0].attack
        && intents.items[1].direction == 1 && intents.items[1].attack;
    controls.count = 3;
    |routing|::route_input::<3, 2>(controls, intents, 1, second_device);
    zero_live && live_prefix && intents.items[0].direction == 3 && !intents.items[0].attack
        && intents.items[1].direction == 1 && intents.items[1].attack
}

machine run_model(smoke: @mutable Smoke) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let knockback: bool = check_knockback();
    let misses: bool = check_misses();
    smoke.actors.items[0].vitality = |actor_state|::Vitality { current: 12, maximum: 12 };
    smoke.actors.items[0].vitality = |actor_state|::damage(smoke.actors.items[0].vitality);
    smoke.actors.items[0].position = |actor_state|::Position { x: 128, y: 112 };
    smoke.actors.items[0].speed = 2;
    smoke.actors.items[0].active = true;
    let moving: |actor_state|::Actor<4> = |actor_state|::Actor { position: |actor_state|::Position { x: 128, y: 112 }, vitality: |actor_state|::Vitality { current: 12, maximum: 12 }, room: 0, speed: 2, active: true, .. };
    let moved: |actor_state|::Actor<4> = |travel|::move_actor::<4>(moving, @smoke.dungeon, 1, false);
    smoke.timer.remaining = |configuration|::ATTACK_FRAMES;
    smoke.timer = |actor_state|::elapse::<|configuration|::ATTACK_FRAMES>(smoke.timer);
    let routed: bool = check_input(@mutable smoke.controllers, @mutable smoke.intents);
    transition routed && knockback && misses && smoke.actors.items[0].vitality.current == 11
        && moved.position.x == 130 && moved.position.y == 112
        && smoke.timer.remaining == |configuration|::ATTACK_FRAMES - 1 {
        true -> passed(),
        _ -> failed()
    }
    machine passed() { |console|::Console::write_line("PASS: bounded components and terminating controller fan-out"); |process_exit|::ProcessExit::exit_process(0); }
    machine failed() { |process_exit|::ProcessExit::exit_process(1); }
}
// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let mutable entry_storage: Smoke;
    run_model(@mutable entry_storage);
}
