// Expected exit: 0.
// Expected output contains: PASS: dungeon campaign, collision, combat, pixels
use omega_language_std::console;
use dungeon_core::simulation::game::Game;
use dungeon_core::presentation::frame::Frame;
use dungeon_core::render;

data Smoke {
    game: Game;
}

machine Smoke::number(value: i32) reaches Console {
    Console::write_byte(((value / 100) % 10 + 48) as i32);
    Console::write_byte(((value / 10) % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
    Console::write_byte(32);
}

machine Smoke::steps(game: &mut Game, direction: i32, count: u32)
terminates by count -> Nat::Descending;
requires direction >= -1 && direction < 4 {
    transition count > 0 { true -> step(game, direction, count) _ -> done() }
    state step(game: &mut Game, direction: i32, count: u32) requires count > 0 && direction >= -1 && direction < 4 {
        Game::walk(game, direction);
        transition { _ -> Smoke::steps(game, direction, count - 1) }
    }
    state done() {}
}

machine Smoke::fight(game: &mut Game, count: u32)
terminates by count -> Nat::Descending;
{
    transition count > 0 { true -> step(game, count) _ -> done() }
    state step(game: &mut Game, count: u32) requires count > 0 {
        Game::tick(game, -1, true);
        transition { _ -> Smoke::fight(game, count - 1) }
    }
    state done() {}
}

machine Smoke::main(smoke: &mut Smoke) reaches Console {
    transition { _ -> rules(smoke) }
    state rules(smoke: &mut Smoke) {
    Console::write_line("check: rules");
    let rules: bool = Game::verify(&mut smoke.game);
    transition rules { true -> pixels(smoke) _ -> failed() }
    }
    state pixels(smoke: &mut Smoke) {
        Console::write_line("check: pixels");
        Game::reset(&mut smoke.game);
        let frame: Frame = Game::capture(&smoke.game);
        let background: i32 = Art::pixel(&frame, 0, 0);
        let wall: i32 = Art::pixel(&frame, 0, 32);
        let player: i32 = Art::pixel(&frame, 128, 144);
        let heart: i32 = Art::pixel(&frame, 101, 10);
        transition background == 1119769 && wall == 1779760 && player == 9297344 && heart == 15356527 {
            true -> wall_collision(smoke)
            _ -> failed()
        }
    }
    state wall_collision(smoke: &mut Smoke) {
        Console::write_line("check: wall collision");
        Smoke::steps(&mut smoke.game, 3, 100);
        transition smoke.game.camera.room == 0 && smoke.game.actors.items[0].position.x >= 20 {
            true -> campaign(smoke)
            _ -> failed()
        }
    }
    state campaign(smoke: &mut Smoke) {
        Console::write_line("check: atrium doorway");
        Game::reset(&mut smoke.game);
        Smoke::steps(&mut smoke.game, 0, 16);
        Smoke::steps(&mut smoke.game, 1, 62);
        transition smoke.game.camera.room == 1 { true -> archive(smoke) _ -> failed() }
    }
    state archive(smoke: &mut Smoke) {
        Console::write_line("check: moss hall doorway");
        Smoke::steps(&mut smoke.game, 1, 116);
        transition smoke.game.camera.room == 2 { true -> chest(smoke) _ -> failed() }
    }
    state chest(smoke: &mut Smoke) {
        Console::write_line("check: archive key");
        Smoke::steps(&mut smoke.game, 0, 24);
        Smoke::steps(&mut smoke.game, 1, 54);
        Smoke::steps(&mut smoke.game, 2, 8);
        smoke.game.actors.items[0].facing = 1;
        Smoke::fight(&mut smoke.game, 240);
        Smoke::number(smoke.game.actors.items[0].position.x);
        Smoke::number(smoke.game.actors.items[0].position.y);
        Smoke::number(smoke.game.actors.items[1].vitality.current);
        Smoke::number(smoke.game.actors.items[1].position.x);
        Smoke::number(smoke.game.actors.items[1].position.y);
        Console::write_line("position, health, enemy health/position");
        transition smoke.game.progress.key && smoke.game.actors.items[1].vitality.current == 0 && smoke.game.actors.items[0].vitality.current > 0 {
            true -> shrine(smoke)
            _ -> failed()
        }
    }
    state shrine(smoke: &mut Smoke) {
        Console::write_line("check: locked shrine doorway");
        Smoke::steps(&mut smoke.game, 0, 24);
        transition smoke.game.camera.room == 5 { true -> relic(smoke) _ -> failed() }
    }
    state relic(smoke: &mut Smoke) {
        Console::write_line("check: shrine relic");
        Smoke::steps(&mut smoke.game, 0, 45);
        smoke.game.actors.items[0].facing = 1;
        Smoke::fight(&mut smoke.game, 240);
        transition smoke.game.progress.won && smoke.game.actors.items[0].vitality.current > 0 { true -> passed() _ -> failed() }
    }
    state passed() {
        Console::write_line("PASS: dungeon campaign, collision, combat, pixels");
        Console::exit_process(0);
    }
    state failed() {
        Console::write_line("FAIL: dungeon acceptance");
        Console::exit_process(1);
    }
}
// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Smoke;
    Smoke::main(&mut entry_storage);
}
