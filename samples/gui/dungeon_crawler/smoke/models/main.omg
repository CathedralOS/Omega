// Expected exit: 0.
// Expected output contains: PASS: bounded components and terminating controller fan-out
use omega_language_std::console;
use dungeon_core::actors::state::ActorSet;
use dungeon_core::actors::state::Countdown;
use dungeon_core::actors::state::Vitality;
use dungeon_core::actors::state::Actor;
use dungeon_core::actors::state::Position;
use dungeon_core::actors::travel::move_actor;
use dungeon_core::actors::combat::strike;
use dungeon_core::world::rooms::Dungeon;
use dungeon_core::actors::state::damage;
use dungeon_core::actors::state::elapse;
use dungeon_core::control::state::ControllerSet;
use dungeon_core::control::state::IntentSet;
use dungeon_core::control::state::Command;
use dungeon_core::control::routing::route_input;
use dungeon_core::configuration::ATTACK_FRAMES;
use dungeon_core::configuration::ROOM_WIDTH;
use dungeon_core::configuration::ROOM_HEIGHT;

data Smoke {
    actors: ActorSet<2, 4>;
    controllers: ControllerSet<2, 2>;
    intents: IntentSet<2>;
    timer: Countdown<ATTACK_FRAMES>;
    dungeon: Dungeon<4>;
}

machine hit_matches(origin: Position, target: Position, direction: i32, expected: Position) -> bool
requires direction >= 0 && direction < 4 {
    let attacker: Actor<4> = Actor { position: origin, vitality: Vitality { current: 6, maximum: 6 }, attack: Countdown { remaining: ATTACK_FRAMES - 1 }, facing: direction, faction: 0, active: true };
    let enemy: Actor<4> = Actor { position: target, vitality: Vitality { current: 2, maximum: 2 }, faction: 1, active: true };
    let hit: Actor<4> = strike<4>(attacker, enemy);
    hit.vitality.current == 1 && hit.position.x == expected.x && hit.position.y == expected.y && hit.room == enemy.room
}

machine miss_matches(attacker: Actor<4>, enemy: Actor<4>) -> bool {
    let missed: Actor<4> = strike<4>(attacker, enemy);
    missed.vitality.current == enemy.vitality.current && missed.position.x == enemy.position.x && missed.position.y == enemy.position.y
}

machine check_knockback() -> bool {
    hit_matches(Position { x: 128, y: 80 }, Position { x: 140, y: 80 }, 1, Position { x: 152, y: 80 })
        && hit_matches(Position { x: 128, y: 80 }, Position { x: 128, y: 68 }, 0, Position { x: 128, y: 56 })
        && hit_matches(Position { x: 128, y: 80 }, Position { x: 128, y: 92 }, 2, Position { x: 128, y: 104 })
        && hit_matches(Position { x: 128, y: 80 }, Position { x: 116, y: 80 }, 3, Position { x: 104, y: 80 })
        && hit_matches(Position { x: ROOM_WIDTH - 16, y: 80 }, Position { x: ROOM_WIDTH - 4, y: 80 }, 1, Position { x: ROOM_WIDTH - 1, y: 80 })
        && hit_matches(Position { x: 128, y: 15 }, Position { x: 128, y: 3 }, 0, Position { x: 128, y: 0 })
        && hit_matches(Position { x: 128, y: ROOM_HEIGHT - 16 }, Position { x: 128, y: ROOM_HEIGHT - 4 }, 2, Position { x: 128, y: ROOM_HEIGHT - 1 })
        && hit_matches(Position { x: 15, y: 80 }, Position { x: 3, y: 80 }, 3, Position { x: 0, y: 80 })
}

machine check_misses() -> bool {
    let attacker: Actor<4> = Actor { position: Position { x: 128, y: 80 }, vitality: Vitality { current: 6, maximum: 6 }, attack: Countdown { remaining: ATTACK_FRAMES - 1 }, facing: 1, faction: 0, active: true };
    let friendly: Actor<4> = Actor { position: Position { x: 140, y: 80 }, vitality: Vitality { current: 2, maximum: 2 }, faction: 0, active: true };
    let behind: Actor<4> = Actor { position: Position { x: 116, y: 80 }, vitality: Vitality { current: 2, maximum: 2 }, faction: 1, active: true };
    let distant: Actor<4> = Actor { position: Position { x: 160, y: 80 }, vitality: Vitality { current: 2, maximum: 2 }, faction: 1, active: true };
    let other_room: Actor<4> = Actor { position: Position { x: 140, y: 80 }, vitality: Vitality { current: 2, maximum: 2 }, room: 1, faction: 1, active: true };
    miss_matches(attacker, friendly) && miss_matches(attacker, behind) && miss_matches(attacker, distant) && miss_matches(attacker, other_room)
}

machine Smoke::main(smoke: &mut Smoke) reaches Console {
    let knockback: bool = check_knockback();
    let misses: bool = check_misses();
    smoke.actors.items[0].vitality = Vitality { current: 12, maximum: 12 };
    smoke.actors.items[0].vitality = damage(smoke.actors.items[0].vitality);
    smoke.actors.items[0].position = Position { x: 128, y: 112 };
    smoke.actors.items[0].speed = 2;
    smoke.actors.items[0].active = true;
    let moving: Actor<4> = Actor { position: Position { x: 128, y: 112 }, vitality: Vitality { current: 12, maximum: 12 }, room: 0, speed: 2, active: true };
    let moved: Actor<4> = move_actor<4>(moving, &smoke.dungeon, 1, false);
    smoke.controllers.bindings[0].actor = 0;
    smoke.controllers.bindings[1].actor = 1;
    smoke.controllers.count = 2;
    smoke.timer.remaining = ATTACK_FRAMES;
    smoke.timer = elapse(smoke.timer);
    route_input(&smoke.controllers, &mut smoke.intents, 0, Command { direction: 1, attack: true });
    transition knockback && misses && smoke.actors.items[0].vitality.current == 11
        && moved.position.x == 130 && moved.position.y == 112
        && smoke.timer.remaining == ATTACK_FRAMES - 1
        && smoke.intents.items[0].direction == 1 && smoke.intents.items[1].attack {
        true -> passed()
        _ -> failed()
    }
    machine passed() { Console::write_line("PASS: bounded components and terminating controller fan-out"); Console::exit_process(0); }
    machine failed() { Console::exit_process(1); }
}
// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Smoke;
    Smoke::main(&mut entry_storage);
}
