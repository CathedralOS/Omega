use game;

public data Art {}

public machine Art::pixel(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
    transition y < 32 { true -> hud(game, x, y) _ -> scene(game, x, y - 32) }
    state hud(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition y >= 30 { true -> (5135188) _ -> title(game, x, y) }
    }
    state title(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x >= 12 && x < 60 && y >= 5 && y < 15 {
            true -> title_pixel(game, (x - 12) / 2, (y - 5) / 2)
            _ -> room_name(game, x, y)
        }
    }
    state title_pixel(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let title: [u8; 6] = "HOLLOW";
        transition x / 4 >= 0 && x / 4 < 6 {
            true -> title_letter(title[x / 4], x % 4, y)
            _ -> (1119769)
        }
    }
    state title_letter(letter: u8, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition Art::letter(letter, x, y) { true -> (16241271) _ -> (1119769) }
    }
    state room_name(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x >= 12 && x < 52 && y >= 21 && y < 26 {
            true -> room_letter(game, (x - 12) / 4, (x - 12) % 4, y - 21)
            _ -> hearts(game, x, y)
        }
    }
    state room_letter(game: &Game, index: i32 in Saturating, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let names: [u8; 60] = "THE ATRIUMMOSS HALL ARCHIVE   CISTERN   THE FORGE SANCTUM   ";
        let position: i32 in Saturating = game.room * 10 + index;
        transition position >= 0 && position < 60 {
            true -> label_pixel(names[position], x, y)
            _ -> (1119769)
        }
    }
    state label_pixel(letter: u8, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition Art::letter(letter, x, y) { true -> (8632227) _ -> (1119769) }
    }
    state hearts(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x >= 100 && x < 172 && y >= 8 && y < 20 {
            true -> heart(game, (x - 100) / 12, (x - 100) % 12, y - 8)
            _ -> key(game, x, y)
        }
    }
    state heart(game: &Game, index: i32 in Saturating, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let shape: bool = (y >= 2 && y <= 5 && ((x >= 1 && x <= 3) || (x >= 5 && x <= 7))) || (y >= 4 && y <= 7 && x >= 1 && x <= 7) || (y == 8 && x >= 2 && x <= 6) || (y == 9 && x >= 3 && x <= 5) || (y == 10 && x == 4);
        transition shape { true -> heart_color(game.health > index) _ -> (1119769) }
    }
    state heart_color(filled: bool) -> i32 in Saturating {
        transition filled { true -> (15356527) _ -> (3428935) }
    }
    state key(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition game.key && x >= 183 && x < 197 && y >= 10 && y <= 18 {
            true -> key_shape(x - 183, y - 10)
            _ -> map(game, x, y)
        }
    }
    state key_shape(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (x < 6 && y < 6 && (x == 0 || x == 5 || y == 0 || y == 5)) || (y == 3 && x >= 5) || ((x == 10 || x == 13) && y >= 3 && y <= 6) {
            true -> (16241271)
            _ -> (1119769)
        }
    }
    state map(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x >= 213 && x < 240 && y >= 7 && y < 23 {
            true -> map_cell(game, (x - 213) / 9, (y - 7) / 8, (x - 213) % 9, (y - 7) % 8)
            _ -> (1119769)
        }
    }
    state map_cell(game: &Game, column: i32 in Saturating, row: i32 in Saturating, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let room: i32 in Saturating = (1 - row) * 3 + column;
        transition x > 0 && x < 8 && y > 0 && y < 7 {
            true -> map_color(game, room)
            _ -> (1119769)
        }
    }
    state map_color(game: &Game, room: i32 in Saturating) -> i32 in Saturating {
        transition room == game.room { true -> (16241271) _ -> explored(game, room) }
    }
    state explored(game: &Game, room: i32 in Saturating) -> i32 in Saturating {
        transition (game.visited & Room::mask(room)) != 0 { true -> (6924937) _ -> (2436398) }
    }
    state scene(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (game.won || game.health <= 0) && x >= 47 && x <= 208 && y >= 48 && y <= 112 {
            true -> overlay(game, x, y)
            _ -> hero(game, x, y)
        }
    }
    state overlay(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x == 47 || x == 208 || y == 48 || y == 112 { true -> (16241271) _ -> overlay_text(game, x, y) }
    }
    state overlay_text(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x >= 92 && x < 164 && y >= 72 && y < 82 {
            true -> outcome(game, (x - 92) / 8, ((x - 92) % 8) / 2, (y - 72) / 2)
            _ -> (1119769)
        }
    }
    state outcome(game: &Game, index: i32 in Saturating, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let victory: [u8; 9] = "RECLAIMED";
        let defeat: [u8; 9] = " FALLEN  ";
        transition index >= 0 && index < 9 { true -> outcome_letter(game, victory[index], defeat[index], x, y) _ -> (1119769) }
    }
    state outcome_letter(game: &Game, victory: u8, defeat: u8, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition game.won { true -> title_letter(victory, x, y) _ -> title_letter(defeat, x, y) }
    }
    state hero(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let dx: i32 in Saturating = x - game.x + 6;
        let dy: i32 in Saturating = y - game.y + 8;
        transition dx >= 0 && dx < 12 && dy >= 0 && dy < 16 && (game.hurt <= 0 || game.ticks % 8 < 4) {
            true -> hero_pixel(game, x, y, dx, dy)
            _ -> sword(game, x, y)
        }
    }
    state hero_pixel(game: &Game, x: i32 in Saturating, y: i32 in Saturating, dx: i32 in Saturating, dy: i32 in Saturating) -> i32 in Saturating {
        let color: i32 in Saturating = Art::hero(dx, dy, game.facing, game.ticks);
        transition color > 0 { true -> (color) _ -> sword(game, x, y) }
    }
    state sword(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let dx: i32 in Saturating = x - game.x;
        let dy: i32 in Saturating = y - game.y;
        let vertical: bool = (game.facing == 0 && dy >= -25 && dy <= -9) || (game.facing == 2 && dy >= 7 && dy <= 24);
        let horizontal: bool = (game.facing == 1 && dx >= 7 && dx <= 24) || (game.facing == 3 && dx >= -25 && dx <= -9);
        transition game.attack > 5 && ((vertical && dx >= -1 && dx <= 1) || (horizontal && dy >= -1 && dy <= 1)) {
            true -> (14479852)
            _ -> enemy(game, x, y)
        }
    }
    state enemy(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let dx: i32 in Saturating = x - game.enemy_x + 9;
        let dy: i32 in Saturating = y - game.enemy_y + 6;
        transition game.enemy_health > 0 && dx >= 0 && dx < 18 && dy >= 0 && dy < 12 {
            true -> bat(game, x, y, dx, dy)
            _ -> treasure(game, x, y)
        }
    }
    state bat(game: &Game, x: i32 in Saturating, y: i32 in Saturating, dx: i32 in Saturating, dy: i32 in Saturating) -> i32 in Saturating {
        let wing: i32 in Saturating = (game.ticks / 12) % 2;
        transition (dx >= 6 && dx <= 11 && dy >= 3 && dy <= 9) || (dx < 6 && dy >= wing * 3 && dy <= 4 + dx / 2) || (dx > 11 && dy >= wing * 3 && dy <= 4 + (17 - dx) / 2) {
            true -> bat_color(dx, dy)
            _ -> treasure(game, x, y)
        }
    }
    state bat_color(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition y == 5 && (x == 7 || x == 10) { true -> (16241271) _ -> (12351663) }
    }
    state treasure(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (game.room == 2 || game.room == 3 || game.room == 5) && x >= 120 && x < 136 && y >= 40 && y < 55 {
            true -> treasure_pixel(game, x, y)
            _ -> ground(game, x, y)
        }
    }
    state treasure_pixel(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition game.room == 5 { true -> relic(game, x, y) _ -> chest(game, x, y) }
    }
    state relic(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let dx: i32 in Saturating = x - 128;
        let dy: i32 in Saturating = y - 47;
        transition dx + dy >= -6 && dx + dy <= 6 && dx - dy >= -6 && dx - dy <= 6 { true -> (16241271) _ -> ground(game, x, y) }
    }
    state chest(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (game.room == 2 && game.key) || (game.room == 3 && game.treasure) { true -> open_chest(x, y) _ -> closed_chest(x, y) }
    }
    state open_chest(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition y < 47 { true -> (1119769) _ -> closed_chest(x, y) }
    }
    state closed_chest(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x == 120 || x == 135 || y == 40 || y == 54 || y == 46 { true -> (16241271) _ -> chest_lock(x, y) }
    }
    state chest_lock(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x >= 126 && x <= 129 && y >= 45 && y <= 49 { true -> (16241271) _ -> (6265686) }
    }
    state ground(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        let tile: i32 in Saturating = Room::tile(game.room, x / 16, y / 16, game.key);
        transition tile {
            1 -> stone(x, y)
            2 -> water(game, x, y)
            3 -> doorway(x, y)
            4 -> gate(x, y)
            _ -> floor(game, x, y)
        }
    }
    state stone(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition y % 8 == 0 || (x + (y / 8) * 8) % 16 == 0 { true -> (1779760) _ -> stone_edge(x, y) }
    }
    state stone_edge(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition y % 8 == 1 { true -> (6981500) _ -> stone_face(x, y) }
    }
    state stone_face(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (x / 16 + y / 8) % 3 == 0 { true -> (4546665) _ -> (3690841) }
    }
    state water(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (x + y * 2 + game.ticks / 8) % 16 < 4 && y % 4 == 0 { true -> (5753295) _ -> (1216160) }
    }
    state doorway(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x % 16 == 0 || y % 16 == 0 { true -> (2436398) _ -> (921619) }
    }
    state gate(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition x % 5 == 0 || y % 8 == 0 { true -> (16241271) _ -> (1779760) }
    }
    state floor(game: &Game, x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (x + y * 13) % 67 == 0 { true -> (4546665) _ -> floor_tile(x, y) }
    }
    state floor_tile(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition (x / 16 + y / 16) % 2 == 0 { true -> (1979180) _ -> (2242608) }
    }
}

public machine Art::hero(x: i32 in Saturating, y: i32 in Saturating, facing: i32 in Saturating, tick: i32 in Saturating) -> i32 in Saturating {
    transition y < 4 && x >= 3 && x <= 9 { true -> (9297344) _ -> face(x, y, facing, tick) }
    state face(x: i32 in Saturating, y: i32 in Saturating, facing: i32 in Saturating, tick: i32 in Saturating) -> i32 in Saturating {
        transition y >= 4 && y <= 7 && x >= 3 && x <= 8 { true -> eyes(x, y, facing) _ -> tunic(x, y, tick) }
    }
    state eyes(x: i32 in Saturating, y: i32 in Saturating, facing: i32 in Saturating) -> i32 in Saturating {
        transition y == 5 && facing != 0 && (x == 4 || x == 7) { true -> (1119769) _ -> (16041892) }
    }
    state tunic(x: i32 in Saturating, y: i32 in Saturating, tick: i32 in Saturating) -> i32 in Saturating {
        transition y >= 8 && y <= 12 && x >= 2 && x <= 9 { true -> belt(x, y) _ -> boots(x, y, tick) }
    }
    state belt(x: i32 in Saturating, y: i32 in Saturating) -> i32 in Saturating {
        transition y == 11 { true -> (16241271) _ -> (9297344) }
    }
    state boots(x: i32 in Saturating, y: i32 in Saturating, tick: i32 in Saturating) -> i32 in Saturating {
        transition y >= 13 && y <= 14 && ((x >= 3 && x <= 4) || (x >= 7 && x <= 8)) { true -> (16041892) _ -> (0) }
    }
}

public machine Art::letter(character: u8, x: i32 in Saturating, y: i32 in Saturating) -> bool {
    transition x >= 0 && x < 3 && y >= 0 && y < 5 { true -> glyph(character, x, y) _ -> (false) }
    state glyph(character: u8, x: i32 in Saturating, y: i32 in Saturating) -> bool
    requires x >= 0 && x < 3 && y >= 0 && y < 5 {
        let bits: u32 in Wrapping = Art::glyph(character);
        let offset: u32 = (y * 3 + x) as u32;
        (bits & (1u32 << offset)) != 0
    }
}

machine Art::glyph(character: u8) -> u32 in Wrapping {
    transition character {
        65 -> (23530)
        67 -> (25126)
        68 -> (15211)
        69 -> (29391)
        70 -> (4815)
        71 -> (27470)
        72 -> (23533)
        73 -> (29847)
        76 -> (29257)
        77 -> (23549)
        78 -> (24557)
        79 -> (31599)
        82 -> (23375)
        83 -> (31183)
        84 -> (9367)
        85 -> (31597)
        87 -> (24557)
        _ -> (0)
    }
}