use presentation::frame::Frame;
use world::rooms::tile_at;
use world::rooms::Reward;
use configuration::ROOM_WIDTH;
use configuration::ROOM_HEIGHT;
use configuration::HUD_HEIGHT;
use configuration::TILE_SIZE;

public data Art {}

public machine Art::pixel(frame: &Frame, x: i32, y: i32) -> i32
requires x >= 0 && x < ROOM_WIDTH && y >= 0 && y < ROOM_HEIGHT + (HUD_HEIGHT as i32) {
    transition y < (HUD_HEIGHT as i32) { true -> hud(frame, x, y) _ -> scene(frame, x, y - (HUD_HEIGHT as i32)) }
    machine hud(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y >= 30 { true -> (5135188) _ -> title(frame, x, y) }
    }
    machine title(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x >= 12 && x < 60 && y >= 5 && y < 15 {
            true -> title_pixel(frame, (x - 12) / 2, (y - 5) / 2)
            _ -> room_name(frame, x, y)
        }
    }
    machine title_pixel(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let title: [u8; 6] = "HOLLOW";
        transition x / 4 >= 0 && x / 4 < 6 {
            true -> title_letter(title[x / 4], x % 4, y)
            _ -> (1119769)
        }
    }
    machine title_letter(letter: u8, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition Art::letter(letter, x, y) { true -> (16241271) _ -> (1119769) }
    }
    machine room_name(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x >= 12 && x < 52 && y >= 21 && y < 26 {
            true -> room_letter(frame, (x - 12) / 4, (x - 12) % 4, y - 21)
            _ -> hearts(frame, x, y)
        }
    }
    machine room_letter(frame: &Frame, index: i32, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition index >= 0 && index < 10 {
            true -> label_pixel(frame.room_data.name[index], x, y)
            _ -> (1119769)
        }
    }
    machine label_pixel(letter: u8, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition Art::letter(letter, x, y) { true -> (8632227) _ -> (1119769) }
    }
    machine hearts(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x >= 100 && x < 172 && y >= 8 && y < 20 {
            true -> heart(frame, (x - 100) / 12, (x - 100) % 12, y - 8)
            _ -> key(frame, x, y)
        }
    }
    machine heart(frame: &Frame, index: i32, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let shape: bool = (y >= 2 && y <= 5 && ((x >= 1 && x <= 3) || (x >= 5 && x <= 7))) || (y >= 4 && y <= 7 && x >= 1 && x <= 7) || (y == 8 && x >= 2 && x <= 6) || (y == 9 && x >= 3 && x <= 5) || (y == 10 && x == 4);
        transition shape { true -> heart_color(frame.subject.vitality.current > index) _ -> (1119769) }
    }
    machine heart_color(filled: bool) -> i32 {
        transition filled { true -> (15356527) _ -> (3428935) }
    }
    machine key(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition frame.key && x >= 183 && x < 197 && y >= 10 && y <= 18 {
            true -> key_shape(x - 183, y - 10)
            _ -> map(frame, x, y)
        }
    }
    machine key_shape(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition (x < 6 && y < 6 && (x == 0 || x == 5 || y == 0 || y == 5)) || (y == 3 && x >= 5) || ((x == 10 || x == 13) && y >= 3 && y <= 6) {
            true -> (16241271)
            _ -> (1119769)
        }
    }
    machine map(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x >= 213 && x < 240 && y >= 7 && y < 23 {
            true -> map_cell(frame, (x - 213) / 9, (y - 7) / 8, (x - 213) % 9, (y - 7) % 8)
            _ -> (1119769)
        }
    }
    machine map_cell(frame: &Frame, column: i32, row: i32, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let room: i32 = (1 - row) * 3 + column;
        transition x > 0 && x < 8 && y > 0 && y < 7 {
            true -> map_color(frame, room)
            _ -> (1119769)
        }
    }
    machine map_color(frame: &Frame, room: i32) -> i32 {
        transition room == frame.room { true -> (16241271) _ -> explored(frame, room) }
    }
    machine explored(frame: &Frame, room: i32) -> i32 {
        transition room >= 0 && room < 6 { true -> visited(frame, room) _ -> (2436398) }
    }
    machine visited(frame: &Frame, room: i32) -> i32
    requires room >= 0 && room < 6 {
        transition frame.visited[room] { true -> (6924937) _ -> (2436398) }
    }
    machine scene(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition (frame.won || frame.subject.vitality.current <= 0) && x >= 47 && x <= 208 && y >= 48 && y <= 112 {
            true -> overlay(frame, x, y)
            _ -> hero(frame, x, y)
        }
    }
    machine overlay(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x == 47 || x == 208 || y == 48 || y == 112 { true -> (16241271) _ -> overlay_text(frame, x, y) }
    }
    machine overlay_text(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x >= 92 && x < 164 && y >= 72 && y < 82 {
            true -> outcome(frame, (x - 92) / 8, ((x - 92) % 8) / 2, (y - 72) / 2)
            _ -> (1119769)
        }
    }
    machine outcome(frame: &Frame, index: i32, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let victory: [u8; 9] = "RECLAIMED";
        let defeat: [u8; 9] = " FALLEN  ";
        transition index >= 0 && index < 9 { true -> outcome_letter(frame, victory[index], defeat[index], x, y) _ -> (1119769) }
    }
    machine outcome_letter(frame: &Frame, victory: u8, defeat: u8, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition frame.won { true -> title_letter(victory, x, y) _ -> title_letter(defeat, x, y) }
    }
    machine hero(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let dx: i32 = x - frame.subject.position.x + 6;
        let dy: i32 = y - frame.subject.position.y + 8;
        transition dx >= 0 && dx < 12 && dy >= 0 && dy < 16 && (frame.subject.immunity.remaining <= 0 || frame.clock.ticks % 8 < 4) {
            true -> hero_pixel(frame, x, y, dx, dy)
            _ -> sword(frame, x, y)
        }
    }
    machine hero_pixel(frame: &Frame, x: i32, y: i32, dx: i32, dy: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 && dx >= 0 && dx < 12 && dy >= 0 && dy < 16 {
        let color: i32 = Art::hero(dx, dy, frame.subject.facing, frame.clock.ticks);
        transition color > 0 { true -> (color) _ -> sword(frame, x, y) }
    }
    machine sword(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let dx: i32 = x - frame.subject.position.x;
        let dy: i32 = y - frame.subject.position.y;
        let vertical: bool = (frame.subject.facing == 0 && dy >= -25 && dy <= -9) || (frame.subject.facing == 2 && dy >= 7 && dy <= 24);
        let horizontal: bool = (frame.subject.facing == 1 && dx >= 7 && dx <= 24) || (frame.subject.facing == 3 && dx >= -25 && dx <= -9);
        transition frame.subject.attack.remaining > 5 && ((vertical && dx >= -1 && dx <= 1) || (horizontal && dy >= -1 && dy <= 1)) {
            true -> (14479852)
            _ -> enemy(frame, x, y)
        }
    }
    machine enemy(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let dx: i32 = x - frame.enemy.position.x + 9;
        let dy: i32 = y - frame.enemy.position.y + 6;
        transition frame.enemy.vitality.current > 0 && dx >= 0 && dx < 18 && dy >= 0 && dy < 12 {
            true -> bat(frame, x, y, dx, dy)
            _ -> treasure(frame, x, y)
        }
    }
    machine bat(frame: &Frame, x: i32, y: i32, dx: i32, dy: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let wing: i32 = (frame.clock.ticks / 12) % 2;
        transition (dx >= 6 && dx <= 11 && dy >= 3 && dy <= 9) || (dx < 6 && dy >= wing * 3 && dy <= 4 + dx / 2) || (dx > 11 && dy >= wing * 3 && dy <= 4 + (17 - dx) / 2) {
            true -> bat_color(dx, dy)
            _ -> treasure(frame, x, y)
        }
    }
    machine bat_color(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y == 5 && (x == 7 || x == 10) { true -> (16241271) _ -> (12351663) }
    }
    machine treasure(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition frame.room_data.reward {
            Reward::None -> ground(frame, x, y)
            Reward::Key -> treasure_bounds(frame, x, y)
            Reward::Heal -> treasure_bounds(frame, x, y)
            Reward::Relic -> treasure_bounds(frame, x, y)
        }
    }
    machine treasure_bounds(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x >= 120 && x < 136 && y >= 40 && y < 55 {
            true -> treasure_pixel(frame, x, y)
            _ -> ground(frame, x, y)
        }
    }
    machine treasure_pixel(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition frame.room_data.reward {
            Reward::Relic -> relic(frame, x, y)
            Reward::Key -> chest(frame, x, y)
            Reward::Heal -> chest(frame, x, y)
            Reward::None -> ground(frame, x, y)
        }
    }
    machine relic(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let dx: i32 = x - 128;
        let dy: i32 = y - 47;
        transition dx + dy >= -6 && dx + dy <= 6 && dx - dy >= -6 && dx - dy <= 6 { true -> (16241271) _ -> ground(frame, x, y) }
    }
    machine chest(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition frame.treasure { true -> open_chest(x, y) _ -> closed_chest(x, y) }
    }
    machine open_chest(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y < 47 { true -> (1119769) _ -> closed_chest(x, y) }
    }
    machine closed_chest(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x == 120 || x == 135 || y == 40 || y == 54 || y == 46 { true -> (16241271) _ -> chest_lock(x, y) }
    }
    machine chest_lock(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x >= 126 && x <= 129 && y >= 45 && y <= 49 { true -> (16241271) _ -> (6265686) }
    }
    machine ground(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        let tile: i32 = tile_at(&frame.room_data, x / TILE_SIZE, y / TILE_SIZE, frame.key);
        transition tile {
            1 -> stone(x, y)
            2 -> water(frame, x, y)
            3 -> doorway(x, y)
            4 -> gate(x, y)
            _ -> floor(frame, x, y)
        }
    }
    machine stone(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y % 8 == 0 || (x + (y / 8) * 8) % 16 == 0 { true -> (1779760) _ -> stone_edge(x, y) }
    }
    machine stone_edge(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y % 8 == 1 { true -> (6981500) _ -> stone_face(x, y) }
    }
    machine stone_face(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition (x / 16 + y / 8) % 3 == 0 { true -> (4546665) _ -> (3690841) }
    }
    machine water(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition (x + y * 2 + frame.clock.ticks / 8) % 16 < 4 && y % 4 == 0 { true -> (5753295) _ -> (1216160) }
    }
    machine doorway(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x % 16 == 0 || y % 16 == 0 { true -> (2436398) _ -> (921619) }
    }
    machine gate(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition x % 5 == 0 || y % 8 == 0 { true -> (16241271) _ -> (1779760) }
    }
    machine floor(frame: &Frame, x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition (x + y * 13) % 67 == 0 { true -> (4546665) _ -> floor_tile(x, y) }
    }
    machine floor_tile(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition (x / 16 + y / 16) % 2 == 0 { true -> (1979180) _ -> (2242608) }
    }
}

public machine Art::hero(x: i32, y: i32, facing: i32, tick: i32) -> i32
requires x >= 0 && x < 12 && y >= 0 && y < 16 {
    transition y < 4 && x >= 3 && x <= 9 { true -> (9297344) _ -> face(x, y, facing, tick) }
    machine face(x: i32, y: i32, facing: i32, tick: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y >= 4 && y <= 7 && x >= 3 && x <= 8 { true -> eyes(x, y, facing) _ -> tunic(x, y, tick) }
    }
    machine eyes(x: i32, y: i32, facing: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y == 5 && facing != 0 && (x == 4 || x == 7) { true -> (1119769) _ -> (16041892) }
    }
    machine tunic(x: i32, y: i32, tick: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y >= 8 && y <= 12 && x >= 2 && x <= 9 { true -> belt(x, y) _ -> boots(x, y, tick) }
    }
    machine belt(x: i32, y: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y == 11 { true -> (16241271) _ -> (9297344) }
    }
    machine boots(x: i32, y: i32, tick: i32) -> i32
    requires x >= -512 && x <= 512 && y >= -512 && y <= 512 {
        transition y >= 13 && y <= 14 && ((x >= 3 && x <= 4) || (x >= 7 && x <= 8)) { true -> (16041892) _ -> (0) }
    }
}

public machine Art::letter(character: u8, x: i32, y: i32) -> bool {
    transition x >= 0 && x < 3 && y >= 0 && y < 5 { true -> glyph(character, x, y) _ -> (false) }
    machine glyph(character: u8, x: i32, y: i32) -> bool
    requires x >= 0 && x < 3 && y >= 0 && y < 5 {
        let bits: u32 = Art::glyph(character);
        let offset: u32 = (y * 3 + x) as u32;
        (bits & (1u32 << offset)) != 0
    }
}

machine Art::glyph(character: u8) -> u32 {
    transition character {
        65 -> (23530)
        67 -> (25126)
        68 -> (15211)
        69 -> (29391)
        70 -> (4815)
        71 -> (27470)
        72 -> (23533)
        73 -> (29847)
        76 -> (29257)
        77 -> (23549)
        78 -> (24557)
        79 -> (31599)
        82 -> (23375)
        83 -> (31183)
        84 -> (9367)
        85 -> (31597)
        87 -> (24557)
        _ -> (0)
    }
}