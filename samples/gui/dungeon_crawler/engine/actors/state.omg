module actors::state;

use configuration::ROOM_WIDTH;
use configuration::ROOM_HEIGHT;
use configuration::MAX_MOVEMENT_STEP;
use configuration::ATTACK_FRAMES;
use configuration::INVULNERABILITY_FRAMES;

public data Position [copy]
where x >= 0 && x < ROOM_WIDTH, y >= 0 && y < ROOM_HEIGHT {
    x: i32;
    y: i32;
}

public data Vitality [copy]
where maximum >= 0, current >= 0 && current <= maximum {
    current: i32;
    maximum: i32;
}

public data Countdown<const Duration: i32> [copy]
where Duration >= 1, remaining >= 0 && remaining <= Duration {
    remaining: i32;
}

public data ActorKind [copy] {
    case Adventurer;
    case Bat;
}

public data Traversal [copy] {
    case Ground;
    case Air;
}

public data Actor<const Rooms: u64> [copy]
where Rooms >= 1, room < Rooms, facing >= 0 && facing < 4,
    speed >= 0 && speed <= MAX_MOVEMENT_STEP {
    position: Position;
    vitality: Vitality;
    attack: Countdown<ATTACK_FRAMES>;
    immunity: Countdown<INVULNERABILITY_FRAMES>;
    room: u64;
    facing: i32;
    speed: i32;
    faction: u32;
    kind: ActorKind;
    traversal: Traversal;
    active: bool;
}

public data ActorSet<const Capacity: u64, const Rooms: u64>
where Capacity >= 1, Rooms >= 1, count <= Capacity {
    items: [Actor<Rooms>; Capacity];
    count: u64;
}

public machine elapse<const Duration: i32>(timer: Countdown<Duration>) -> Countdown<Duration>
terminates;
requires Duration >= 1 {
    transition timer.remaining > 0 { true -> decrement(timer) _ -> (timer) }
    machine decrement(timer: Countdown<Duration>) -> Countdown<Duration>
    requires timer.remaining > 0 {
        Countdown { remaining: timer.remaining - 1 }
    }
}

public machine damage(vitality: Vitality) -> Vitality
terminates;
{
    transition vitality.current > 0 { true -> decrement(vitality.current, vitality.maximum) _ -> (vitality) }
    machine decrement(current: i32, maximum: i32) -> Vitality
    requires current > 0 && current <= maximum {
        Vitality { current: current - 1, maximum: maximum }
    }
}