module actors::coordinates;

use actors::state::Position;
use configuration::ROOM_WIDTH;
use configuration::ROOM_HEIGHT;
use configuration::MAX_MOVEMENT_STEP;

public machine step_x(position: Position, direction: i32, speed: i32) -> i32
terminates;
requires direction >= 0 && direction < 4 && speed >= 0 && speed <= MAX_MOVEMENT_STEP
ensures result >= -MAX_MOVEMENT_STEP && result < ROOM_WIDTH + MAX_MOVEMENT_STEP {
    transition direction {
        1 -> (position.x + speed)
        3 -> (position.x - speed)
        _ -> (position.x)
    }
}

public machine step_y(position: Position, direction: i32, speed: i32) -> i32
terminates;
requires direction >= 0 && direction < 4 && speed >= 0 && speed <= MAX_MOVEMENT_STEP
ensures result >= -MAX_MOVEMENT_STEP && result < ROOM_HEIGHT + MAX_MOVEMENT_STEP {
    transition direction {
        0 -> (position.y - speed)
        2 -> (position.y + speed)
        _ -> (position.y)
    }
}