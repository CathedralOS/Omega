module actors::combat;

use actors::state::Actor;
use actors::state::Countdown;
use actors::state::damage;
use actors::state::elapse;
use control::state::Command;
use configuration::ATTACK_FRAMES;
use configuration::INVULNERABILITY_FRAMES;
use configuration::MELEE_REACH;
use configuration::CONTACT_DISTANCE;

public machine cooldowns<const Rooms: u64>(mut actor: Actor<Rooms>) -> Actor<Rooms>
terminates;
requires Rooms >= 1 {
    actor.attack = elapse<ATTACK_FRAMES>(actor.attack);
    actor.immunity = elapse<INVULNERABILITY_FRAMES>(actor.immunity);
    actor
}

public machine attack_intent<const Rooms: u64>(mut actor: Actor<Rooms>, command: Command) -> Actor<Rooms>
terminates;
requires Rooms >= 1 {
    transition command.attack && actor.attack.remaining == 0 && actor.active && actor.vitality.current > 0 {
        true -> swing(actor)
        _ -> (actor)
    }
    state swing(mut actor: Actor<Rooms>) -> Actor<Rooms> {
        actor.attack = Countdown { remaining: ATTACK_FRAMES };
        actor
    }
}

public machine strike<const Rooms: u64>(attacker: Actor<Rooms>, victim: Actor<Rooms>) -> Actor<Rooms>
terminates;
requires Rooms >= 1 {
    transition attacker.active && victim.active && attacker.room == victim.room && attacker.attack.remaining == ATTACK_FRAMES - 1 && victim.vitality.current > 0 {
        true -> faction(attacker, victim)
        _ -> (victim)
    }
    state faction(attacker: Actor<Rooms>, victim: Actor<Rooms>) -> Actor<Rooms> {
        transition attacker.faction != victim.faction { true -> range(attacker, victim) _ -> (victim) }
    }
    state range(attacker: Actor<Rooms>, victim: Actor<Rooms>) -> Actor<Rooms> {
        let dx: i32 = victim.position.x - attacker.position.x;
        let dy: i32 = victim.position.y - attacker.position.y;
        let forward: bool = (attacker.facing == 0 && dy < 0) || (attacker.facing == 1 && dx > 0) || (attacker.facing == 2 && dy > 0) || (attacker.facing == 3 && dx < 0);
        transition forward && dx >= -MELEE_REACH && dx <= MELEE_REACH && dy >= -MELEE_REACH && dy <= MELEE_REACH {
            true -> hit(victim)
            _ -> (victim)
        }
    }
    state hit(mut victim: Actor<Rooms>) -> Actor<Rooms> {
        victim.vitality = damage(victim.vitality);
        victim
    }
}

public machine contact<const Rooms: u64>(attacker: Actor<Rooms>, victim: Actor<Rooms>) -> Actor<Rooms>
terminates;
requires Rooms >= 1 {
    transition attacker.active && victim.active && attacker.room == victim.room && attacker.vitality.current > 0 && victim.vitality.current > 0 && victim.immunity.remaining == 0 {
        true -> faction(attacker, victim)
        _ -> (victim)
    }
    state faction(attacker: Actor<Rooms>, victim: Actor<Rooms>) -> Actor<Rooms> {
        transition attacker.faction != victim.faction { true -> range(attacker, victim) _ -> (victim) }
    }
    state range(attacker: Actor<Rooms>, victim: Actor<Rooms>) -> Actor<Rooms> {
        let dx: i32 = victim.position.x - attacker.position.x;
        let dy: i32 = victim.position.y - attacker.position.y;
        transition dx > -CONTACT_DISTANCE && dx < CONTACT_DISTANCE && dy > -CONTACT_DISTANCE && dy < CONTACT_DISTANCE { true -> hit(victim) _ -> (victim) }
    }
    state hit(mut victim: Actor<Rooms>) -> Actor<Rooms> {
        victim.vitality = damage(victim.vitality);
        victim.immunity = Countdown { remaining: INVULNERABILITY_FRAMES };
        victim
    }
}