use actors/coordinates/coordinates.omg;
use actors/state/state.omg as actor_state;
use configuration/configuration.omg;
use world/rooms/rooms.omg;

public machine move_actor<const Rooms: u64>(actor: |actor_state|::Actor<Rooms>, dungeon: @|rooms|::Dungeon<Rooms>, direction: i32, key: bool) -> |actor_state|::Actor<Rooms>
terminates
requires Rooms >= 1 && actor.room < Rooms && direction >= -1 && direction < 4 {
    transition direction >= 0 && actor.active && actor.vitality.current > 0 {
        true -> moving(actor, dungeon, direction, key),
        _ -> (actor)
    }
    machine moving(actor: |actor_state|::Actor<Rooms>, dungeon: @|rooms|::Dungeon<Rooms>, direction: i32, key: bool) -> |actor_state|::Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 {
        let x: i32 = |coordinates|::step_x(actor.position, direction, actor.speed);
        let y: i32 = |coordinates|::step_y(actor.position, direction, actor.speed);
        resolve_step::<Rooms>(actor, dungeon, direction, key, x, y)
    }
}

machine resolve_step<const Rooms: u64>(actor: |actor_state|::Actor<Rooms>, dungeon: @|rooms|::Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> |actor_state|::Actor<Rooms>
terminates
requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4
    && x >= |coordinates|::STEP_MIN && x < |coordinates|::STEP_X_LIMIT
    && y >= |coordinates|::STEP_MIN && y < |coordinates|::STEP_Y_LIMIT {
    let crossing: bool = (direction == 0 && y <= |configuration|::COLLIDER_RADIUS) || (direction == 1 && x >= |configuration|::ROOM_WIDTH - |configuration|::COLLIDER_RADIUS - 1) || (direction == 2 && y >= |configuration|::ROOM_HEIGHT - |configuration|::COLLIDER_RADIUS - 1) || (direction == 3 && x <= |configuration|::COLLIDER_RADIUS);
    transition crossing { true -> door(actor, dungeon, direction, key), _ -> inside(actor, dungeon, direction, key, x, y) }
    machine door(actor: |actor_state|::Actor<Rooms>, dungeon: @|rooms|::Dungeon<Rooms>, direction: i32, key: bool) -> |actor_state|::Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 {
        let room: u64 = actor.room;
        let exit: |rooms|::Exit<Rooms> = |rooms|::exit_for::<Rooms>(@dungeon.rooms[room], direction);
        let tile: i32 = |rooms|::tile_at::<Rooms>(@dungeon.rooms[room], actor.position.x / |configuration|::TILE_SIZE, actor.position.y / |configuration|::TILE_SIZE, key);
        transition tile == 3 && exit.open && (!exit.needs_key || key) {
            true -> (arrive::<Rooms>(actor, direction, exit)),
            _ -> (face::<Rooms>(actor, direction))
        }
    }
    machine inside(actor: |actor_state|::Actor<Rooms>, dungeon: @|rooms|::Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> |actor_state|::Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 {
        transition x >= 0 && x < |configuration|::ROOM_WIDTH && y >= 0 && y < |configuration|::ROOM_HEIGHT {
            true -> terrain(actor, dungeon, direction, key, x, y),
            _ -> (face::<Rooms>(actor, direction))
        }
    }
    machine terrain(actor: |actor_state|::Actor<Rooms>, dungeon: @|rooms|::Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> |actor_state|::Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 && x >= 0 && x < |configuration|::ROOM_WIDTH && y >= 0 && y < |configuration|::ROOM_HEIGHT {
        transition actor.traversal {
            |actor_state|::Traversal::Ground -> collision(actor, dungeon, direction, key, x, y),
            |actor_state|::Traversal::Air -> (locate::<Rooms>(actor, direction, |actor_state|::Position { x: x, y: y }))
        }
    }
    machine collision(actor: |actor_state|::Actor<Rooms>, dungeon: @|rooms|::Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> |actor_state|::Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 && x >= 0 && x < |configuration|::ROOM_WIDTH && y >= 0 && y < |configuration|::ROOM_HEIGHT {
        let room: u64 = actor.room;
        let left: i32 = |rooms|::tile_at::<Rooms>(@dungeon.rooms[room], (x - |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, (y - |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, key);
        let right: i32 = |rooms|::tile_at::<Rooms>(@dungeon.rooms[room], (x + |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, (y - |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, key);
        let lower_left: i32 = |rooms|::tile_at::<Rooms>(@dungeon.rooms[room], (x - |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, (y + |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, key);
        let lower_right: i32 = |rooms|::tile_at::<Rooms>(@dungeon.rooms[room], (x + |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, (y + |configuration|::COLLIDER_RADIUS) / |configuration|::TILE_SIZE, key);
        transition (left == 0 || left == 3) && (right == 0 || right == 3) && (lower_left == 0 || lower_left == 3) && (lower_right == 0 || lower_right == 3) {
            true -> (locate::<Rooms>(actor, direction, |actor_state|::Position { x: x, y: y })),
            _ -> (face::<Rooms>(actor, direction))
        }
    }
}

machine face<const Rooms: u64>(mutable actor: |actor_state|::Actor<Rooms>, direction: i32) -> |actor_state|::Actor<Rooms>
terminates
requires Rooms >= 1 && direction >= 0 && direction < 4 {
    actor.facing = direction;
    actor
}

machine locate<const Rooms: u64>(mutable actor: |actor_state|::Actor<Rooms>, direction: i32, position: |actor_state|::Position) -> |actor_state|::Actor<Rooms>
terminates
requires Rooms >= 1 && direction >= 0 && direction < 4 {
    actor.facing = direction;
    actor.position = position;
    actor
}

machine arrive<const Rooms: u64>(actor: |actor_state|::Actor<Rooms>, direction: i32, exit: |rooms|::Exit<Rooms>) -> |actor_state|::Actor<Rooms>
terminates
requires Rooms >= 1 && direction >= 0 && direction < 4 {
    let destination: u64 = exit.destination;
    transition destination < Rooms { true -> arrival(actor, direction, destination), _ -> (actor) }
    machine arrival(actor: |actor_state|::Actor<Rooms>, direction: i32, destination: u64) -> |actor_state|::Actor<Rooms>
    requires Rooms >= 1 && direction >= 0 && direction < 4 && destination < Rooms {
    transition direction {
        0 -> install(actor, direction, destination, |actor_state|::Position { x: actor.position.x, y: |configuration|::ROOM_HEIGHT - |configuration|::ARRIVAL_INSET - 2 }),
        1 -> install(actor, direction, destination, |actor_state|::Position { x: |configuration|::ARRIVAL_INSET, y: actor.position.y }),
        2 -> install(actor, direction, destination, |actor_state|::Position { x: actor.position.x, y: |configuration|::ARRIVAL_INSET }),
        _ -> install(actor, direction, destination, |actor_state|::Position { x: |configuration|::ROOM_WIDTH - |configuration|::ARRIVAL_INSET - 2, y: actor.position.y })
    }
    }
    machine install(mutable actor: |actor_state|::Actor<Rooms>, direction: i32, destination: u64, position: |actor_state|::Position) -> |actor_state|::Actor<Rooms>
    requires Rooms >= 1 && direction >= 0 && direction < 4 && destination < Rooms {
        actor.room = destination;
        actor.facing = direction;
        actor.position = position;
        actor
    }
}