module actors::systems;

use actors::state::Actor;
use actors::state::ActorSet;
use actors::combat::cooldowns;
use actors::combat::attack_intent;
use actors::combat::strike;
use actors::combat::contact;
use actors::travel::move_actor;
use control::state::Command;
use control::state::IntentSet;
use world::rooms::Dungeon;

public machine advance_actors<const Capacity: u64, const Rooms: u64>(actors: &mut ActorSet<Capacity, Rooms>, intents: &IntentSet<Capacity>, dungeon: &Dungeon<Rooms>, key: bool)
terminates;
requires Capacity >= 1 && Rooms >= 1 {
    let count: u64 = actors.count;
    advance_slice<Rooms>(&mut actors.items[..count], &intents.items[..count], dungeon, key);
}

machine advance_slice<const Rooms: u64>(actors: &mut [Actor<Rooms>], intents: &[Command], dungeon: &Dungeon<Rooms>, key: bool)
terminates;
terminates by actors -> Slice::Length;
requires Rooms >= 1 && actors.len == intents.len {
    transition actors.len > 0 { true -> head(actors, intents, dungeon, key) _ -> done() }
    machine head(actors: &mut [Actor<Rooms>], intents: &[Command], dungeon: &Dungeon<Rooms>, key: bool)
    requires Rooms >= 1 && actors.len > 0 && actors.len == intents.len {
        let actor: Actor<Rooms> = cooldowns<Rooms>(actors[0]);
        let moved: Actor<Rooms> = move_actor<Rooms>(actor, dungeon, intents[0].direction, key);
        actors[0] = attack_intent<Rooms>(moved, intents[0]);
        transition { _ -> advance_slice(&mut actors[1..], intents[1..], dungeon, key) }
    }
    machine done() {}
}

public machine resolve_combat<const Capacity: u64, const Rooms: u64>(actors: &mut ActorSet<Capacity, Rooms>)
terminates;
requires Capacity >= 1 && Rooms >= 1 {
    let count: u64 = actors.count;
    resolve_sources<Capacity, Rooms>(actors, 0, count);
}

machine resolve_sources<const Capacity: u64, const Rooms: u64>(actors: &mut ActorSet<Capacity, Rooms>, source: u64, remaining: u64)
terminates;
terminates by remaining -> Nat::Descending;
requires Capacity >= 1 && Rooms >= 1 {
    transition remaining > 0 && source < Capacity { true -> head(actors, source, remaining) _ -> done() }
    machine head(actors: &mut ActorSet<Capacity, Rooms>, source: u64, remaining: u64)
    requires Capacity >= 1 && Rooms >= 1 && source < Capacity && remaining > 0 {
        let attacker: Actor<Rooms> = actors.items[source];
        resolve_targets<Rooms>(attacker, &mut actors.items[..actors.count]);
        transition { _ -> resolve_sources(actors, source + 1, remaining - 1) }
    }
    machine done() {}
}

machine resolve_targets<const Rooms: u64>(attacker: Actor<Rooms>, targets: &mut [Actor<Rooms>])
terminates;
terminates by targets -> Slice::Length;
requires Rooms >= 1 {
    transition targets.len > 0 { true -> head(attacker, targets) _ -> done() }
    machine head(attacker: Actor<Rooms>, targets: &mut [Actor<Rooms>])
    requires Rooms >= 1 && targets.len > 0 {
        let victim: Actor<Rooms> = strike<Rooms>(attacker, targets[0]);
        targets[0] = contact<Rooms>(attacker, victim);
        transition { _ -> resolve_targets(attacker, &mut targets[1..]) }
    }
    machine done() {}
}

public machine room_has_hostiles<const Rooms: u64>(actors: &[Actor<Rooms>], room: u64, faction: u32) -> bool
terminates;
terminates by actors -> Slice::Length;
requires Rooms >= 1 && room < Rooms {
    transition actors.len > 0 { true -> head(actors, room, faction) _ -> (false) }
    machine head(actors: &[Actor<Rooms>], room: u64, faction: u32) -> bool
    requires Rooms >= 1 && room < Rooms && actors.len > 0 {
        let actor: Actor<Rooms> = actors[0];
        transition actor.active && actor.vitality.current > 0 && actor.room == room && actor.faction != faction {
            true -> (true)
            _ -> room_has_hostiles(actors[1..], room, faction)
        }
    }
}