use actors/combat/combat.omg;
use actors/state/state.omg as actor_state;
use actors/travel/travel.omg;
use configuration/configuration.omg;
use control/state/state.omg as state_state;
use world/rooms/rooms.omg;

public machine advance_actors(actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @|state_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, dungeon: @|rooms|::Dungeon<|configuration|::ROOM_COUNT>, key: bool)
terminates {
    let count: u64 = actors.count;
    advance_index(actors, intents, dungeon, key, 0, count);
}

machine advance_index(actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @|state_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, dungeon: @|rooms|::Dungeon<|configuration|::ROOM_COUNT>, key: bool, index: u64, remaining: u64)
terminates
terminates by remaining -> Nat::Descending {
    transition remaining > 0 && index < |configuration|::ACTOR_CAPACITY { true -> head(actors, intents, dungeon, key, index, remaining), _ -> done() }
    machine head(actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @|state_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, dungeon: @|rooms|::Dungeon<|configuration|::ROOM_COUNT>, key: bool, index: u64, remaining: u64)
    requires remaining > 0 && index < |configuration|::ACTOR_CAPACITY {
        let current: |actor_state|::Actor<|configuration|::ROOM_COUNT> = actors.items[index];
        let command: |state_state|::Command = intents.items[index];
        let actor: |actor_state|::Actor<|configuration|::ROOM_COUNT> = |combat|::cooldowns::<|configuration|::ROOM_COUNT>(current);
        let moved: |actor_state|::Actor<|configuration|::ROOM_COUNT> = |travel|::move_actor::<|configuration|::ROOM_COUNT>(actor, dungeon, command.direction, key);
        actors.items[index] = |combat|::attack_intent::<|configuration|::ROOM_COUNT>(moved, command);
        transition { _ -> advance_index(actors, intents, dungeon, key, index + 1, remaining - 1) }
    }
    machine done() {}
}

public machine resolve_combat(actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>)
terminates {
    let count: u64 = actors.count;
    resolve_sources(actors, 0, count);
}

machine resolve_sources(actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, source: u64, remaining: u64)
terminates
terminates by remaining -> Nat::Descending {
    transition remaining > 0 && source < |configuration|::ACTOR_CAPACITY { true -> head(actors, source, remaining), _ -> done() }
    machine head(actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, source: u64, remaining: u64)
    requires source < |configuration|::ACTOR_CAPACITY && remaining > 0 {
        let attacker: |actor_state|::Actor<|configuration|::ROOM_COUNT> = actors.items[source];
        let count: u64 = actors.count;
        resolve_targets(attacker, actors, 0, count);
        transition { _ -> resolve_sources(actors, source + 1, remaining - 1) }
    }
    machine done() {}
}

machine resolve_targets(attacker: |actor_state|::Actor<|configuration|::ROOM_COUNT>, actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, target: u64, remaining: u64)
terminates
terminates by remaining -> Nat::Descending {
    transition remaining > 0 && target < |configuration|::ACTOR_CAPACITY { true -> head(attacker, actors, target, remaining), _ -> done() }
    machine head(attacker: |actor_state|::Actor<|configuration|::ROOM_COUNT>, actors: @mutable |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, target: u64, remaining: u64)
    requires target < |configuration|::ACTOR_CAPACITY && remaining > 0 {
        let current: |actor_state|::Actor<|configuration|::ROOM_COUNT> = actors.items[target];
        let victim: |actor_state|::Actor<|configuration|::ROOM_COUNT> = |combat|::strike::<|configuration|::ROOM_COUNT>(attacker, current);
        actors.items[target] = |combat|::contact::<|configuration|::ROOM_COUNT>(attacker, victim);
        transition { _ -> resolve_targets(attacker, actors, target + 1, remaining - 1) }
    }
    machine done() {}
}

public machine room_has_hostiles(actors: @|actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, room: u64, faction: u32) -> bool
terminates
requires room < |configuration|::ROOM_COUNT {
    let count: u64 = actors.count;
    room_has_hostiles_at(actors, room, faction, 0, count)
}

machine room_has_hostiles_at(actors: @|actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, room: u64, faction: u32, index: u64, remaining: u64) -> bool
terminates
terminates by remaining -> Nat::Descending
requires room < |configuration|::ROOM_COUNT {
    transition remaining > 0 && index < |configuration|::ACTOR_CAPACITY { true -> head(actors, room, faction, index, remaining), _ -> (false) }
    machine head(actors: @|actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, room: u64, faction: u32, index: u64, remaining: u64) -> bool
    requires room < |configuration|::ROOM_COUNT && remaining > 0 && index < |configuration|::ACTOR_CAPACITY {
        let actor: |actor_state|::Actor<|configuration|::ROOM_COUNT> = actors.items[index];
        transition actor.active && actor.vitality.current > 0 && actor.room == room && actor.faction != faction {
            true -> (true),
            _ -> room_has_hostiles_at(actors, room, faction, index + 1, remaining - 1)
        }
    }
}