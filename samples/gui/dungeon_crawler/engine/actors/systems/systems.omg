use actors/combat/combat.omg;
use actors/state/state.omg as actor_state;
use actors/travel/travel.omg;
use control/state/state.omg as state_state;
use world/rooms/rooms.omg;

public machine advance_actors<const Capacity: u64, const Rooms: u64>(actors: @mutable |actor_state|::ActorSet<Capacity, Rooms>, intents: @|state_state|::IntentSet<Capacity>, dungeon: @|rooms|::Dungeon<Rooms>, key: bool)
terminates
requires Capacity >= 1 && Rooms >= 1 {
    let count: u64 = actors.count;
    advance_slice::<Rooms>(@mutable actors.items[..count], @intents.items[..count], dungeon, key);
}

machine advance_slice<const Rooms: u64>(actors: @mutable [|actor_state|::Actor<Rooms>], intents: @[|state_state|::Command], dungeon: @|rooms|::Dungeon<Rooms>, key: bool)
terminates
terminates by actors -> Slice::Length
requires Rooms >= 1 && actors.length == intents.length {
    transition actors.length > 0 { true -> head(actors, intents, dungeon, key), _ -> done() }
    machine head(actors: @mutable [|actor_state|::Actor<Rooms>], intents: @[|state_state|::Command], dungeon: @|rooms|::Dungeon<Rooms>, key: bool)
    requires Rooms >= 1 && actors.length > 0 && actors.length == intents.length {
        let actor: |actor_state|::Actor<Rooms> = |combat|::cooldowns::<Rooms>(actors[0]);
        let moved: |actor_state|::Actor<Rooms> = |travel|::move_actor::<Rooms>(actor, dungeon, intents[0].direction, key);
        actors[0] = |combat|::attack_intent::<Rooms>(moved, intents[0]);
        transition { _ -> advance_slice(@mutable actors[1..], intents[1..], dungeon, key) }
    }
    machine done() {}
}

public machine resolve_combat<const Capacity: u64, const Rooms: u64>(actors: @mutable |actor_state|::ActorSet<Capacity, Rooms>)
terminates
requires Capacity >= 1 && Rooms >= 1 {
    let count: u64 = actors.count;
    resolve_sources::<Capacity, Rooms>(actors, 0, count);
}

machine resolve_sources<const Capacity: u64, const Rooms: u64>(actors: @mutable |actor_state|::ActorSet<Capacity, Rooms>, source: u64, remaining: u64)
terminates
terminates by remaining -> Nat::Descending
requires Capacity >= 1 && Rooms >= 1 {
    transition remaining > 0 && source < Capacity { true -> head(actors, source, remaining), _ -> done() }
    machine head(actors: @mutable |actor_state|::ActorSet<Capacity, Rooms>, source: u64, remaining: u64)
    requires Capacity >= 1 && Rooms >= 1 && source < Capacity && remaining > 0 {
        let attacker: |actor_state|::Actor<Rooms> = actors.items[source];
        resolve_targets::<Rooms>(attacker, @mutable actors.items[..actors.count]);
        transition { _ -> resolve_sources(actors, source + 1, remaining - 1) }
    }
    machine done() {}
}

machine resolve_targets<const Rooms: u64>(attacker: |actor_state|::Actor<Rooms>, targets: @mutable [|actor_state|::Actor<Rooms>])
terminates
terminates by targets -> Slice::Length
requires Rooms >= 1 {
    transition targets.length > 0 { true -> head(attacker, targets), _ -> done() }
    machine head(attacker: |actor_state|::Actor<Rooms>, targets: @mutable [|actor_state|::Actor<Rooms>])
    requires Rooms >= 1 && targets.length > 0 {
        let victim: |actor_state|::Actor<Rooms> = |combat|::strike::<Rooms>(attacker, targets[0]);
        targets[0] = |combat|::contact::<Rooms>(attacker, victim);
        transition { _ -> resolve_targets(attacker, @mutable targets[1..]) }
    }
    machine done() {}
}

public machine room_has_hostiles<const Rooms: u64>(actors: @[|actor_state|::Actor<Rooms>], room: u64, faction: u32) -> bool
terminates
terminates by actors -> Slice::Length
requires Rooms >= 1 && room < Rooms {
    transition actors.length > 0 { true -> head(actors, room, faction), _ -> (false) }
    machine head(actors: @[|actor_state|::Actor<Rooms>], room: u64, faction: u32) -> bool
    requires Rooms >= 1 && room < Rooms && actors.length > 0 {
        let actor: |actor_state|::Actor<Rooms> = actors[0];
        transition actor.active && actor.vitality.current > 0 && actor.room == room && actor.faction != faction {
            true -> (true),
            _ -> room_has_hostiles(actors[1..], room, faction)
        }
    }
}