module actors::travel;

use actors::state::Actor;
use actors::state::Position;
use actors::state::Traversal;
use actors::coordinates::step_x;
use actors::coordinates::step_y;
use world::rooms::Dungeon;
use world::rooms::Exit;
use world::rooms::exit_for;
use world::rooms::tile_at;
use configuration::ROOM_WIDTH;
use configuration::ROOM_HEIGHT;
use configuration::TILE_SIZE;
use configuration::COLLIDER_RADIUS;
use configuration::MAX_MOVEMENT_STEP;
use configuration::ARRIVAL_INSET;

public machine move_actor<const Rooms: u64>(actor: Actor<Rooms>, dungeon: &Dungeon<Rooms>, direction: i32, key: bool) -> Actor<Rooms>
terminates;
requires Rooms >= 1 && actor.room < Rooms && direction >= -1 && direction < 4 {
    transition direction >= 0 && actor.active && actor.vitality.current > 0 {
        true -> moving(actor, dungeon, direction, key)
        _ -> (actor)
    }
    machine moving(actor: Actor<Rooms>, dungeon: &Dungeon<Rooms>, direction: i32, key: bool) -> Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 {
        let x: i32 = step_x(actor.position, direction, actor.speed);
        let y: i32 = step_y(actor.position, direction, actor.speed);
        resolve_step<Rooms>(actor, dungeon, direction, key, x, y)
    }
}

machine resolve_step<const Rooms: u64>(actor: Actor<Rooms>, dungeon: &Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> Actor<Rooms>
terminates;
requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4
    && x >= -MAX_MOVEMENT_STEP && x < ROOM_WIDTH + MAX_MOVEMENT_STEP
    && y >= -MAX_MOVEMENT_STEP && y < ROOM_HEIGHT + MAX_MOVEMENT_STEP {
    let crossing: bool = (direction == 0 && y <= COLLIDER_RADIUS) || (direction == 1 && x >= ROOM_WIDTH - COLLIDER_RADIUS - 1) || (direction == 2 && y >= ROOM_HEIGHT - COLLIDER_RADIUS - 1) || (direction == 3 && x <= COLLIDER_RADIUS);
    transition crossing { true -> door(actor, dungeon, direction, key) _ -> inside(actor, dungeon, direction, key, x, y) }
    machine door(actor: Actor<Rooms>, dungeon: &Dungeon<Rooms>, direction: i32, key: bool) -> Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 {
        let room: u64 = actor.room;
        let exit: Exit<Rooms> = exit_for<Rooms>(&dungeon.rooms[room], direction);
        let tile: i32 = tile_at<Rooms>(&dungeon.rooms[room], actor.position.x / TILE_SIZE, actor.position.y / TILE_SIZE, key);
        transition tile == 3 && exit.open && (!exit.needs_key || key) {
            true -> (arrive<Rooms>(actor, direction, exit))
            _ -> (face<Rooms>(actor, direction))
        }
    }
    machine inside(actor: Actor<Rooms>, dungeon: &Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 {
        transition x >= 0 && x < ROOM_WIDTH && y >= 0 && y < ROOM_HEIGHT {
            true -> terrain(actor, dungeon, direction, key, x, y)
            _ -> (face<Rooms>(actor, direction))
        }
    }
    machine terrain(actor: Actor<Rooms>, dungeon: &Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 && x >= 0 && x < ROOM_WIDTH && y >= 0 && y < ROOM_HEIGHT {
        transition actor.traversal {
            Traversal::Ground -> collision(actor, dungeon, direction, key, x, y)
            Traversal::Air -> (locate<Rooms>(actor, direction, Position { x: x, y: y }))
        }
    }
    machine collision(actor: Actor<Rooms>, dungeon: &Dungeon<Rooms>, direction: i32, key: bool, x: i32, y: i32) -> Actor<Rooms>
    requires Rooms >= 1 && actor.room < Rooms && direction >= 0 && direction < 4 && x >= 0 && x < ROOM_WIDTH && y >= 0 && y < ROOM_HEIGHT {
        let room: u64 = actor.room;
        let left: i32 = tile_at<Rooms>(&dungeon.rooms[room], (x - COLLIDER_RADIUS) / TILE_SIZE, (y - COLLIDER_RADIUS) / TILE_SIZE, key);
        let right: i32 = tile_at<Rooms>(&dungeon.rooms[room], (x + COLLIDER_RADIUS) / TILE_SIZE, (y - COLLIDER_RADIUS) / TILE_SIZE, key);
        let lower_left: i32 = tile_at<Rooms>(&dungeon.rooms[room], (x - COLLIDER_RADIUS) / TILE_SIZE, (y + COLLIDER_RADIUS) / TILE_SIZE, key);
        let lower_right: i32 = tile_at<Rooms>(&dungeon.rooms[room], (x + COLLIDER_RADIUS) / TILE_SIZE, (y + COLLIDER_RADIUS) / TILE_SIZE, key);
        transition (left == 0 || left == 3) && (right == 0 || right == 3) && (lower_left == 0 || lower_left == 3) && (lower_right == 0 || lower_right == 3) {
            true -> (locate<Rooms>(actor, direction, Position { x: x, y: y }))
            _ -> (face<Rooms>(actor, direction))
        }
    }
}

machine face<const Rooms: u64>(mut actor: Actor<Rooms>, direction: i32) -> Actor<Rooms>
terminates;
requires Rooms >= 1 && direction >= 0 && direction < 4 {
    actor.facing = direction;
    actor
}

machine locate<const Rooms: u64>(mut actor: Actor<Rooms>, direction: i32, position: Position) -> Actor<Rooms>
terminates;
requires Rooms >= 1 && direction >= 0 && direction < 4 {
    actor.facing = direction;
    actor.position = position;
    actor
}

machine arrive<const Rooms: u64>(actor: Actor<Rooms>, direction: i32, exit: Exit<Rooms>) -> Actor<Rooms>
terminates;
requires Rooms >= 1 && direction >= 0 && direction < 4 {
    let destination: u64 = exit.destination;
    transition destination < Rooms { true -> arrival(actor, direction, destination) _ -> (actor) }
    machine arrival(actor: Actor<Rooms>, direction: i32, destination: u64) -> Actor<Rooms>
    requires Rooms >= 1 && direction >= 0 && direction < 4 && destination < Rooms {
    transition direction {
        0 -> install(actor, direction, destination, Position { x: actor.position.x, y: ROOM_HEIGHT - ARRIVAL_INSET - 2 })
        1 -> install(actor, direction, destination, Position { x: ARRIVAL_INSET, y: actor.position.y })
        2 -> install(actor, direction, destination, Position { x: actor.position.x, y: ARRIVAL_INSET })
        _ -> install(actor, direction, destination, Position { x: ROOM_WIDTH - ARRIVAL_INSET - 2, y: actor.position.y })
    }
    }
    machine install(mut actor: Actor<Rooms>, direction: i32, destination: u64, position: Position) -> Actor<Rooms>
    requires Rooms >= 1 && direction >= 0 && direction < 4 && destination < Rooms {
        actor.room = destination;
        actor.facing = direction;
        actor.position = position;
        actor
    }
}