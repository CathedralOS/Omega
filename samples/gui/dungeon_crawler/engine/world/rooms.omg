module world::rooms;
use configuration::ROOM_LAST_COLUMN;
use configuration::ROOM_LAST_ROW;
use configuration::DOOR_COLUMN_START;
use configuration::DOOR_COLUMN_END;
use configuration::DOOR_ROW_START;
use configuration::DOOR_ROW_END;

public data Layout [copy] {
    case Pillars;
    case Channel;
    case Archive;
    case Pools;
    case Forge;
}

public data Reward [copy] {
    case None;
    case Key;
    case Heal;
    case Relic;
}

public data Exit<const Rooms: u64> [copy]
where Rooms >= 1, destination < Rooms {
    destination: u64;
    open: bool;
    needs_key: bool;
}

public data Room<const Rooms: u64> [copy]
where Rooms >= 1 {
    exits: [Exit<Rooms>; 4];
    layout: Layout;
    reward: Reward;
    name: [u8; 10];
    inhabited: bool;
}

public data Dungeon<const Rooms: u64>
where Rooms >= 1 {
    rooms: [Room<Rooms>; Rooms];
}

public data RoomProgress [copy] {
    visited: bool;
    cleared: bool;
    reward_taken: bool;
}

public data Progress<const Rooms: u64> [copy]
where Rooms >= 1 {
    rooms: [RoomProgress; Rooms];
    key: bool;
    won: bool;
}

public machine exit_for<const Rooms: u64>(room: &Room<Rooms>, direction: i32) -> Exit<Rooms>
terminates;
requires Rooms >= 1 && direction >= 0 && direction < 4 {
    room.exits[direction as u64]
}

public machine tile_at<const Rooms: u64>(room: &Room<Rooms>, column: i32, row: i32, key: bool) -> i32
terminates;
requires Rooms >= 1
ensures result >= 0 && result <= 4 {
    transition column < 0 || column > ROOM_LAST_COLUMN || row < 0 || row > ROOM_LAST_ROW {
        true -> (1)
        _ -> boundaries(room, column, row, key)
    }
    machine boundaries(room: &Room<Rooms>, column: i32, row: i32, key: bool) -> i32 {
        transition row == 0 && column >= DOOR_COLUMN_START && column <= DOOR_COLUMN_END {
            true -> doorway(room.exits[0], key)
            _ -> south(room, column, row, key)
        }
    }
    machine south(room: &Room<Rooms>, column: i32, row: i32, key: bool) -> i32 {
        transition row == ROOM_LAST_ROW && column >= DOOR_COLUMN_START && column <= DOOR_COLUMN_END {
            true -> doorway(room.exits[2], key)
            _ -> sides(room, column, row, key)
        }
    }
    machine sides(room: &Room<Rooms>, column: i32, row: i32, key: bool) -> i32 {
        transition column == 0 && row >= DOOR_ROW_START && row <= DOOR_ROW_END {
            true -> doorway(room.exits[3], key)
            _ -> east(room, column, row, key)
        }
    }
    machine east(room: &Room<Rooms>, column: i32, row: i32, key: bool) -> i32 {
        transition column == ROOM_LAST_COLUMN && row >= DOOR_ROW_START && row <= DOOR_ROW_END {
            true -> doorway(room.exits[1], key)
            _ -> interior(room, column, row)
        }
    }
    machine doorway(exit: Exit<Rooms>, key: bool) -> i32 {
        transition exit.open { true -> lock(exit.needs_key, key) _ -> (1) }
    }
    machine lock(locked: bool, key: bool) -> i32 {
        transition locked && !key { true -> (4) _ -> (3) }
    }
    machine interior(room: &Room<Rooms>, column: i32, row: i32) -> i32 {
        transition column == 0 || column == ROOM_LAST_COLUMN || row == 0 || row == ROOM_LAST_ROW {
            true -> (1)
            _ -> layout(room.layout, column, row)
        }
    }
    machine layout(layout: Layout, column: i32, row: i32) -> i32 {
        transition layout {
            Layout::Pillars -> pillars(column, row)
            Layout::Channel -> channel(column, row)
            Layout::Archive -> archive(column, row)
            Layout::Pools -> pools(column, row)
            Layout::Forge -> forge(column, row)
        }
    }
    machine pillars(column: i32, row: i32) -> i32 {
        transition (column == 4 || column == 11) && (row == 3 || row == 6) { true -> (1) _ -> (0) }
    }
    machine channel(column: i32, row: i32) -> i32 {
        transition (column == 7 || column == 8) && row >= 2 && row <= 7 && row != 4 && row != 5 { true -> (2) _ -> (0) }
    }
    machine archive(column: i32, row: i32) -> i32 {
        transition (column == 4 || column == 11) && row >= 3 && row <= 6 { true -> (1) _ -> (0) }
    }
    machine pools(column: i32, row: i32) -> i32 {
        transition ((column >= 3 && column <= 5) || (column >= 10 && column <= 12)) && row >= 3 && row <= 6 { true -> (2) _ -> (0) }
    }
    machine forge(column: i32, row: i32) -> i32 {
        transition (column == 5 || column == 10) && (row == 3 || row == 6) { true -> (1) _ -> (0) }
    }
}