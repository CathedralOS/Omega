module world::campaign;

use world::rooms::Dungeon;
use world::rooms::Room;
use world::rooms::Exit;
use world::rooms::Layout;
use world::rooms::Reward;

public machine hollow_dungeon() -> Dungeon<6>
terminates;
{
    let wall: Exit<6> = Exit { destination: 0, open: false, needs_key: false };
    Dungeon { rooms: [
        Room { exits: [Exit { destination: 3, open: true, needs_key: false }, Exit { destination: 1, open: true, needs_key: false }, wall, wall], layout: Layout::Pillars, reward: Reward::None, name: "THE ATRIUM", inhabited: false },
        Room { exits: [Exit { destination: 4, open: true, needs_key: false }, Exit { destination: 2, open: true, needs_key: false }, wall, Exit { destination: 0, open: true, needs_key: false }], layout: Layout::Channel, reward: Reward::None, name: "MOSS HALL ", inhabited: true },
        Room { exits: [Exit { destination: 5, open: true, needs_key: true }, wall, wall, Exit { destination: 1, open: true, needs_key: false }], layout: Layout::Archive, reward: Reward::Key, name: "ARCHIVE   ", inhabited: true },
        Room { exits: [wall, Exit { destination: 4, open: true, needs_key: false }, Exit { destination: 0, open: true, needs_key: false }, wall], layout: Layout::Pools, reward: Reward::Heal, name: "CISTERN   ", inhabited: true },
        Room { exits: [wall, Exit { destination: 5, open: true, needs_key: true }, Exit { destination: 1, open: true, needs_key: false }, Exit { destination: 3, open: true, needs_key: false }], layout: Layout::Forge, reward: Reward::None, name: "THE FORGE ", inhabited: true },
        Room { exits: [wall, wall, Exit { destination: 2, open: true, needs_key: false }, Exit { destination: 4, open: true, needs_key: false }], layout: Layout::Pillars, reward: Reward::Relic, name: "SANCTUM   ", inhabited: true }
    ] }
}