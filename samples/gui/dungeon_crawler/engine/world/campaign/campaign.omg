use world/rooms/rooms.omg;

public machine hollow_dungeon() -> |rooms|::Dungeon<6>
terminates
{
    let wall: |rooms|::Exit<6> = |rooms|::Exit { destination: 0, open: false, needs_key: false };
    |rooms|::Dungeon { rooms: [
        |rooms|::Room { exits: [|rooms|::Exit { destination: 3, open: true, needs_key: false }, |rooms|::Exit { destination: 1, open: true, needs_key: false }, wall, wall], layout: |rooms|::Layout::Pillars, reward: |rooms|::Reward::None, name: "THE ATRIUM", inhabited: false },
        |rooms|::Room { exits: [|rooms|::Exit { destination: 4, open: true, needs_key: false }, |rooms|::Exit { destination: 2, open: true, needs_key: false }, wall, |rooms|::Exit { destination: 0, open: true, needs_key: false }], layout: |rooms|::Layout::Channel, reward: |rooms|::Reward::None, name: "MOSS HALL ", inhabited: true },
        |rooms|::Room { exits: [|rooms|::Exit { destination: 5, open: true, needs_key: true }, wall, wall, |rooms|::Exit { destination: 1, open: true, needs_key: false }], layout: |rooms|::Layout::Archive, reward: |rooms|::Reward::Key, name: "ARCHIVE   ", inhabited: true },
        |rooms|::Room { exits: [wall, |rooms|::Exit { destination: 4, open: true, needs_key: false }, |rooms|::Exit { destination: 0, open: true, needs_key: false }, wall], layout: |rooms|::Layout::Pools, reward: |rooms|::Reward::Heal, name: "CISTERN   ", inhabited: true },
        |rooms|::Room { exits: [wall, |rooms|::Exit { destination: 5, open: true, needs_key: true }, |rooms|::Exit { destination: 1, open: true, needs_key: false }, |rooms|::Exit { destination: 3, open: true, needs_key: false }], layout: |rooms|::Layout::Forge, reward: |rooms|::Reward::None, name: "THE FORGE ", inhabited: true },
        |rooms|::Room { exits: [wall, wall, |rooms|::Exit { destination: 2, open: true, needs_key: false }, |rooms|::Exit { destination: 4, open: true, needs_key: false }], layout: |rooms|::Layout::Pillars, reward: |rooms|::Reward::Relic, name: "SANCTUM   ", inhabited: true }
    ] }
}