public data Room {}

public data Game {
    room: i32 in Saturating;
    x: i32 in Saturating;
    y: i32 in Saturating;
    facing: i32 in Saturating;
    health: i32 in Saturating;
    ticks: i32 in Saturating;
    attack: i32 in Saturating;
    hurt: i32 in Saturating;
    enemy_x: i32 in Saturating;
    enemy_y: i32 in Saturating;
    enemy_health: i32 in Saturating;
    enemy_clock: i32 in Saturating;
    defeated: u32 in Wrapping;
    visited: u32 in Wrapping;
    key: bool;
    treasure: bool;
    won: bool;
}

public machine Game::reset(game: &mut Game) {
    game.room = 0;
    game.x = 128;
    game.y = 112;
    game.facing = 2;
    game.health = 6;
    game.ticks = 0;
    game.attack = 0;
    game.hurt = 0;
    game.defeated = 0;
    game.visited = 1;
    game.key = false;
    game.treasure = false;
    game.won = false;
    Game::enter(game);
}

public machine Game::enter(game: &mut Game) {
    game.enemy_x = 192;
    game.enemy_y = 48;
    game.enemy_health = 2;
    game.enemy_clock = 0;
    game.visited = game.visited | Room::mask(game.room);
    transition (game.defeated & Room::mask(game.room)) != 0 || game.room == 0 {
        true -> empty(game)
        _ -> ready()
    }
    state empty(game: &mut Game) { game.enemy_health = 0; }
    state ready() {}
}

public machine Room::mask(room: i32 in Saturating) -> u32 in Wrapping {
    transition room {
        0 -> (1)
        1 -> (2)
        2 -> (4)
        3 -> (8)
        4 -> (16)
        5 -> (32)
        _ -> (0)
    }
}

public machine Room::tile(room: i32 in Saturating, column: i32 in Saturating, row: i32 in Saturating, key: bool) -> i32 in Saturating {
    transition column < 0 || column > 15 || row < 0 || row > 9 {
        true -> (1)
        _ -> north(room, column, row, key)
    }
    state north(room: i32 in Saturating, column: i32 in Saturating, row: i32 in Saturating, key: bool) -> i32 in Saturating {
        transition row == 0 {
            true -> north_door(room, column, key)
            _ -> south(room, column, row, key)
        }
    }
    state north_door(room: i32 in Saturating, column: i32 in Saturating, key: bool) -> i32 in Saturating {
        transition column >= 7 && column <= 8 && room < 3 {
            true -> lock(room == 2, key)
            _ -> (1)
        }
    }
    state south(room: i32 in Saturating, column: i32 in Saturating, row: i32 in Saturating, key: bool) -> i32 in Saturating {
        transition row == 9 {
            true -> south_door(room, column)
            _ -> west(room, column, row, key)
        }
    }
    state south_door(room: i32 in Saturating, column: i32 in Saturating) -> i32 in Saturating {
        transition column >= 7 && column <= 8 && room >= 3 { true -> (3) _ -> (1) }
    }
    state west(room: i32 in Saturating, column: i32 in Saturating, row: i32 in Saturating, key: bool) -> i32 in Saturating {
        transition column == 0 {
            true -> west_door(room, row)
            _ -> east(room, column, row, key)
        }
    }
    state west_door(room: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition row >= 4 && row <= 5 && room != 0 && room != 3 { true -> (3) _ -> (1) }
    }
    state east(room: i32 in Saturating, column: i32 in Saturating, row: i32 in Saturating, key: bool) -> i32 in Saturating {
        transition column == 15 {
            true -> east_door(room, row, key)
            _ -> interior(room, column, row)
        }
    }
    state east_door(room: i32 in Saturating, row: i32 in Saturating, key: bool) -> i32 in Saturating {
        transition row >= 4 && row <= 5 && room != 2 && room != 5 {
            true -> lock(room == 4, key)
            _ -> (1)
        }
    }
    state lock(locked: bool, key: bool) -> i32 in Saturating {
        transition locked && !key { true -> (4) _ -> (3) }
    }
    state interior(room: i32 in Saturating, column: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition room {
            0 -> pillars(column, row)
            1 -> channel(column, row)
            2 -> library(column, row)
            3 -> pools(column, row)
            4 -> forge(column, row)
            _ -> shrine(column, row)
        }
    }
    state pillars(column: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition (column == 4 || column == 11) && (row == 3 || row == 6) { true -> (1) _ -> (0) }
    }
    state channel(column: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition (column == 7 || column == 8) && row >= 2 && row <= 7 && row != 4 && row != 5 { true -> (2) _ -> (0) }
    }
    state library(column: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition (column == 4 || column == 11) && row >= 3 && row <= 6 { true -> (1) _ -> (0) }
    }
    state pools(column: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition ((column >= 3 && column <= 5) || (column >= 10 && column <= 12)) && row >= 3 && row <= 6 { true -> (2) _ -> (0) }
    }
    state forge(column: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition (column == 5 || column == 10) && (row == 3 || row == 6) { true -> (1) _ -> (0) }
    }
    state shrine(column: i32 in Saturating, row: i32 in Saturating) -> i32 in Saturating {
        transition (column == 4 || column == 11) && (row == 3 || row == 6) { true -> (1) _ -> (0) }
    }
}

public machine Game::walk(game: &mut Game, direction: i32 in Saturating) {
    game.facing = direction;
    transition direction {
        0 -> candidate(game, game.x, game.y - 2)
        1 -> candidate(game, game.x + 2, game.y)
        2 -> candidate(game, game.x, game.y + 2)
        _ -> candidate(game, game.x - 2, game.y)
    }
    state candidate(game: &mut Game, next_x: i32 in Saturating, next_y: i32 in Saturating) {
        transition (game.facing == 0 && next_y <= 5) || (game.facing == 1 && next_x >= 250) || (game.facing == 2 && next_y >= 154) || (game.facing == 3 && next_x <= 5) {
            true -> passage(game, next_x, next_y)
            _ -> collision(game, next_x, next_y)
        }
    }
    state passage(game: &mut Game, next_x: i32 in Saturating, next_y: i32 in Saturating) {
        let tile: i32 in Saturating = Room::tile(game.room, game.x / 16, game.y / 16, game.key);
        transition tile == 3 {
            true -> cross(game, next_x, next_y)
            _ -> stopped()
        }
    }
    state cross(game: &mut Game, next_x: i32 in Saturating, next_y: i32 in Saturating) {
        transition game.facing {
            0 -> arrive(game, game.room + 3, game.x, 136)
            1 -> arrive(game, game.room + 1, 22, game.y)
            2 -> arrive(game, game.room - 3, game.x, 22)
            _ -> arrive(game, game.room - 1, 232, game.y)
        }
    }
    state arrive(game: &mut Game, room: i32 in Saturating, x: i32 in Saturating, y: i32 in Saturating) {
        transition room >= 0 && room < 6 {
            true -> install(game, room, x, y)
            _ -> stopped()
        }
    }
    state install(game: &mut Game, room: i32 in Saturating, x: i32 in Saturating, y: i32 in Saturating) {
        game.room = room;
        game.x = x;
        game.y = y;
        Game::enter(game);
    }
    state collision(game: &mut Game, next_x: i32 in Saturating, next_y: i32 in Saturating) {
        let left: i32 in Saturating = Room::tile(game.room, (next_x - 5) / 16, (next_y - 5) / 16, game.key);
        let right: i32 in Saturating = Room::tile(game.room, (next_x + 5) / 16, (next_y - 5) / 16, game.key);
        let lower_left: i32 in Saturating = Room::tile(game.room, (next_x - 5) / 16, (next_y + 5) / 16, game.key);
        let lower_right: i32 in Saturating = Room::tile(game.room, (next_x + 5) / 16, (next_y + 5) / 16, game.key);
        transition (left == 0 || left == 3) && (right == 0 || right == 3) && (lower_left == 0 || lower_left == 3) && (lower_right == 0 || lower_right == 3) {
            true -> move(game, next_x, next_y)
            _ -> stopped()
        }
    }
    state move(game: &mut Game, next_x: i32 in Saturating, next_y: i32 in Saturating) {
        game.x = next_x;
        game.y = next_y;
    }
    state stopped() {}
}

public machine Game::tick(game: &mut Game, direction: i32 in Saturating, swing: bool) {
    transition game.health > 0 && !game.won { true -> alive(game, direction, swing) _ -> idle() }
    state alive(game: &mut Game, direction: i32 in Saturating, swing: bool) {
        game.ticks = (game.ticks + 1) % 3600;
        game.attack = game.attack - 1;
        game.hurt = game.hurt - 1;
        transition direction >= 0 && direction < 4 { true -> walk(game, direction, swing) _ -> sword(game, swing) }
    }
    state walk(game: &mut Game, direction: i32 in Saturating, swing: bool) {
        Game::walk(game, direction);
        transition { _ -> sword(game, swing) }
    }
    state sword(game: &mut Game, swing: bool) {
        transition swing && game.attack <= 0 { true -> attack(game) _ -> enemy(game) }
    }
    state attack(game: &mut Game) {
        game.attack = 15;
        transition { _ -> enemy(game) }
    }
    state enemy(game: &mut Game) {
        transition game.enemy_health > 0 { true -> enemy_alive(game) _ -> pickup(game) }
    }
    state enemy_alive(game: &mut Game) {
        let dx: i32 in Saturating = game.enemy_x - game.x;
        let dy: i32 in Saturating = game.enemy_y - game.y;
        let forward: bool = (game.facing == 0 && dy < 0) || (game.facing == 1 && dx > 0) || (game.facing == 2 && dy > 0) || (game.facing == 3 && dx < 0);
        transition game.attack == 14 && forward && dx >= -26 && dx <= 26 && dy >= -26 && dy <= 26 {
            true -> hit(game)
            _ -> chase(game)
        }
    }
    state hit(game: &mut Game) {
        game.enemy_health = game.enemy_health - 1;
        game.enemy_x = game.enemy_x + 12;
        transition game.enemy_health <= 0 { true -> defeated(game) _ -> chase(game) }
    }
    state defeated(game: &mut Game) {
        game.defeated = game.defeated | Room::mask(game.room);
        transition { _ -> pickup(game) }
    }
    state chase(game: &mut Game) {
        game.enemy_clock = (game.enemy_clock + 1) % 3;
        transition game.enemy_clock == 0 { true -> enemy_horizontal(game) _ -> contact(game) }
    }
    state enemy_horizontal(game: &mut Game) {
        transition game.enemy_x < game.x { true -> enemy_right(game) _ -> enemy_left(game) }
    }
    state enemy_right(game: &mut Game) {
        game.enemy_x = game.enemy_x + 1;
        transition { _ -> enemy_vertical(game) }
    }
    state enemy_left(game: &mut Game) {
        game.enemy_x = game.enemy_x - 1;
        transition { _ -> enemy_vertical(game) }
    }
    state enemy_vertical(game: &mut Game) {
        transition game.enemy_y < game.y { true -> enemy_down(game) _ -> enemy_up(game) }
    }
    state enemy_down(game: &mut Game) {
        game.enemy_y = game.enemy_y + 1;
        transition { _ -> contact(game) }
    }
    state enemy_up(game: &mut Game) {
        game.enemy_y = game.enemy_y - 1;
        transition { _ -> contact(game) }
    }
    state contact(game: &mut Game) {
        let dx: i32 in Saturating = game.enemy_x - game.x;
        let dy: i32 in Saturating = game.enemy_y - game.y;
        transition game.hurt <= 0 && dx > -11 && dx < 11 && dy > -11 && dy < 11 {
            true -> damage(game)
            _ -> pickup(game)
        }
    }
    state damage(game: &mut Game) {
        game.health = game.health - 1;
        game.hurt = 60;
        transition { _ -> pickup(game) }
    }
    state pickup(game: &mut Game) {
        transition game.room == 2 && game.enemy_health <= 0 && game.x >= 112 && game.x <= 144 && game.y >= 32 && game.y <= 64 {
            true -> key(game)
            _ -> relic(game)
        }
    }
    state key(game: &mut Game) {
        game.key = true;
        transition { _ -> relic(game) }
    }
    state relic(game: &mut Game) {
        transition game.room == 5 && game.enemy_health <= 0 && game.x >= 112 && game.x <= 144 && game.y >= 32 && game.y <= 64 {
            true -> victory(game)
            _ -> heal(game)
        }
    }
    state victory(game: &mut Game) {
        game.won = true;
    }
    state heal(game: &mut Game) {
        transition game.room == 3 && !game.treasure && game.enemy_health <= 0 && game.x >= 112 && game.x <= 144 && game.y >= 32 && game.y <= 64 {
            true -> heart(game)
            _ -> idle()
        }
    }
    state heart(game: &mut Game) {
        game.health = 6;
        game.treasure = true;
    }
    state idle() {}
}

public machine Game::verify(game: &mut Game) -> bool {
    Game::reset(game);
    let wall: i32 in Saturating = Room::tile(0, 0, 1, false);
    let door: i32 in Saturating = Room::tile(0, 15, 4, false);
    let locked: i32 in Saturating = Room::tile(2, 7, 0, false);
    let unlocked: i32 in Saturating = Room::tile(2, 7, 0, true);
    transition wall == 1 && door == 3 && locked == 4 && unlocked == 3 {
        true -> doorway(game)
        _ -> (false)
    }
    state doorway(game: &mut Game) -> bool {
        game.x = 254;
        game.y = 80;
        Game::walk(game, 1);
        transition game.room == 1 && game.x == 22 { true -> backtrack(game) _ -> (false) }
    }
    state backtrack(game: &mut Game) -> bool {
        game.x = 0;
        Game::walk(game, 3);
        transition game.room == 0 && game.x == 232 { true -> combat(game) _ -> (false) }
    }
    state combat(game: &mut Game) -> bool {
        game.room = 2;
        game.x = 128;
        game.y = 48;
        game.enemy_x = 140;
        game.enemy_y = 48;
        game.enemy_health = 1;
        game.attack = 15;
        game.facing = 1;
        Game::tick(game, -1, false);
        transition game.enemy_health == 0 && game.key { true -> persistence(game) _ -> (false) }
    }
    state persistence(game: &mut Game) -> bool {
        Game::enter(game);
        transition game.enemy_health == 0 { true -> finish(game) _ -> (false) }
    }
    state finish(game: &mut Game) -> bool {
        game.room = 5;
        game.enemy_health = 0;
        Game::tick(game, -1, false);
        game.won
    }
}