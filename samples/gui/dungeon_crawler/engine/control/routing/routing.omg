use actors/state/state.omg as state_state;
use configuration/configuration.omg;
use control/pursuit/pursuit.omg;
use control/state/state.omg as control_state;
use simulation/clock/clock.omg;
use {omega}/language/core/iteration.omg;

public machine clear_intents<const Actors: u64>(intents: @mutable |control_state|::IntentSet<Actors>)
terminates
requires Actors >= 1 {
    |iteration|::for_each::<|control_state|::Command, clear_command>(@mutable intents.items[..]);
}

machine clear_command(command: @mutable |control_state|::Command)
satisfies |iteration|::ElementStep<|control_state|::Command>::apply {
    command.direction = -1;
    command.attack = false;
}

public machine route_autonomy(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, actors: @|state_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, clock: |clock|::FrameClock)
terminates {
    route_autonomous_bindings(controls, actors, intents, clock, 0, controls.count);
}

machine route_autonomous_bindings(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, actors: @|state_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, clock: |clock|::FrameClock, index: u64, remaining: u64)
terminates
terminates by remaining -> Nat::Descending {
    transition remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY { true -> head(controls, actors, intents, clock, index, remaining), _ -> done() }
    machine head(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, actors: @|state_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, clock: |clock|::FrameClock, index: u64, remaining: u64)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY {
        let binding: |control_state|::ControllerBinding<|configuration|::ACTOR_CAPACITY> = controls.bindings[index];
        transition binding.source {
            |control_state|::ControlSource::Input { device } -> next(controls, actors, intents, clock, index, remaining),
            |control_state|::ControlSource::Pursuit { target } -> pursuit(controls, actors, intents, clock, index, remaining, binding.actor, target)
        }
    }
    machine pursuit(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, actors: @|state_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, clock: |clock|::FrameClock, index: u64, remaining: u64, actor: u64, target: u64)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY {
        transition actor < |configuration|::ACTOR_CAPACITY && target < |configuration|::ACTOR_CAPACITY {
            true -> write(controls, actors, intents, clock, index, remaining, actor, target),
            _ -> next(controls, actors, intents, clock, index, remaining)
        }
    }
    machine write(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, actors: @|state_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, clock: |clock|::FrameClock, index: u64, remaining: u64, actor: u64, target: u64)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY && actor < |configuration|::ACTOR_CAPACITY && target < |configuration|::ACTOR_CAPACITY {
        let chaser: |state_state|::Actor<|configuration|::ROOM_COUNT> = actors.items[actor];
        let prey: |state_state|::Actor<|configuration|::ROOM_COUNT> = actors.items[target];
        intents.items[actor] = |pursuit|::pursue::<|configuration|::ROOM_COUNT>(chaser, prey, clock.ticks);
        transition { _ -> next(controls, actors, intents, clock, index, remaining) }
    }
    machine next(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, actors: @|state_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, clock: |clock|::FrameClock, index: u64, remaining: u64)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY {
        transition { _ -> route_autonomous_bindings(controls, actors, intents, clock, index + 1, remaining - 1) }
    }
    machine done() {}
}

public machine route_input(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, device: u32, command: |control_state|::Command)
terminates {
    route_bindings(controls, intents, device, command, 0, controls.count);
}

machine route_bindings(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, device: u32, command: |control_state|::Command, index: u64, remaining: u64)
terminates by remaining -> Nat::Descending {
    transition remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY { true -> head(controls, intents, device, command, index, remaining), _ -> done() }
    machine head(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, device: u32, command: |control_state|::Command, index: u64, remaining: u64)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY {
        let binding: |control_state|::ControllerBinding<|configuration|::ACTOR_CAPACITY> = controls.bindings[index];
        let source: |control_state|::ControlSource<|configuration|::ACTOR_CAPACITY> = binding.source;
        transition source {
            |control_state|::ControlSource::Input { device as selected } -> manual(controls, intents, device, command, index, remaining, binding.actor, selected),
            |control_state|::ControlSource::Pursuit { target } -> next(controls, intents, device, command, index, remaining)
        }
    }
    machine manual(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, device: u32, command: |control_state|::Command, index: u64, remaining: u64, actor: u64, selected: u32)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY {
        transition selected == device && actor < |configuration|::ACTOR_CAPACITY {
            true -> write(controls, intents, device, command, index, remaining, actor),
            _ -> next(controls, intents, device, command, index, remaining)
        }
    }
    machine write(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, device: u32, command: |control_state|::Command, index: u64, remaining: u64, actor: u64)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY && actor < |configuration|::ACTOR_CAPACITY {
        intents.items[actor] = command;
        transition { _ -> next(controls, intents, device, command, index, remaining) }
    }
    machine next(controls: @|control_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>, intents: @mutable |control_state|::IntentSet<|configuration|::ACTOR_CAPACITY>, device: u32, command: |control_state|::Command, index: u64, remaining: u64)
    requires remaining > 0 && index < |configuration|::CONTROLLER_CAPACITY {
        transition { _ -> route_bindings(controls, intents, device, command, index + 1, remaining - 1) }
    }
    machine done() {}
}