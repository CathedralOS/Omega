module control::pursuit;

use actors::state::Actor;
use control::state::Command;
use configuration::ANIMATION_PERIOD;
use configuration::PURSUIT_INTERVAL;

public machine pursue<const Rooms: u64>(actor: Actor<Rooms>, target: Actor<Rooms>, phase: i32) -> Command
terminates;
requires Rooms >= 1 && phase >= 0 && phase < ANIMATION_PERIOD {
    transition actor.active && actor.vitality.current > 0 && target.vitality.current > 0 && actor.room == target.room && phase % PURSUIT_INTERVAL == 0 {
        true -> horizontal(actor, target)
        _ -> (Command { direction: -1, attack: false })
    }
    machine horizontal(actor: Actor<Rooms>, target: Actor<Rooms>) -> Command {
        transition actor.position.x < target.position.x {
            true -> (Command { direction: 1, attack: false })
            _ -> left(actor, target)
        }
    }
    machine left(actor: Actor<Rooms>, target: Actor<Rooms>) -> Command {
        transition actor.position.x > target.position.x {
            true -> (Command { direction: 3, attack: false })
            _ -> vertical(actor, target)
        }
    }
    machine vertical(actor: Actor<Rooms>, target: Actor<Rooms>) -> Command {
        transition actor.position.y < target.position.y {
            true -> (Command { direction: 2, attack: false })
            _ -> (Command { direction: 0, attack: false })
        }
    }
}