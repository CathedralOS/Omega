module control::state;

public data Command [copy]
where direction >= -1 && direction < 4 {
    direction: i32;
    attack: bool;
}

public data ControlSource<const Actors: u64> [copy]
where Actors >= 1 {
    case Input(device: u32);
    case Pursuit(target: u64) where target < Actors;
}

public data ControllerBinding<const Actors: u64> [copy]
where Actors >= 1, actor < Actors {
    actor: u64;
    source: ControlSource<Actors>;
}

public data ControllerSet<const Capacity: u64, const Actors: u64>
where Capacity >= 1, Actors >= 1, count <= Capacity {
    bindings: [ControllerBinding<Actors>; Capacity];
    count: u64;
}

public data IntentSet<const Actors: u64>
where Actors >= 1 {
    items: [Command; Actors];
}