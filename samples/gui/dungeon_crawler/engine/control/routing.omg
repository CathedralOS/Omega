module control::routing;

use omega::language::core::iteration;

use control::state::Command;
use control::state::ControlSource;
use control::state::ControllerSet;
use control::state::IntentSet;

use control::state::ControllerBinding;
use actors::state::ActorSet;
use control::pursuit::pursue;
use simulation::clock::FrameClock;

public machine clear_intents<const Actors: u64>(intents: &mut IntentSet<Actors>)
terminates;
requires Actors >= 1 {
    for_each<Command, clear_command>(&mut intents.items[..]);
}

machine clear_command(command: &mut Command)
satisfies ElementStep<Command>::apply {
    command.direction = -1;
    command.attack = false;
}

public machine route_autonomy<const Bindings: u64, const Actors: u64, const Rooms: u64>(controls: &ControllerSet<Bindings, Actors>, actors: &ActorSet<Actors, Rooms>, intents: &mut IntentSet<Actors>, clock: FrameClock)
terminates;
requires Bindings >= 1 && Actors >= 1 && Rooms >= 1 {
    route_autonomous_bindings<Actors, Rooms>(&controls.bindings[..controls.count], actors, intents, clock);
}

machine route_autonomous_bindings<const Actors: u64, const Rooms: u64>(bindings: &[ControllerBinding<Actors>], actors: &ActorSet<Actors, Rooms>, intents: &mut IntentSet<Actors>, clock: FrameClock)
terminates;
terminates by bindings -> Slice::Length;
requires Actors >= 1 && Rooms >= 1 {
    transition bindings.len > 0 { true -> head(bindings, actors, intents, clock) _ -> done() }
    machine head(bindings: &[ControllerBinding<Actors>], actors: &ActorSet<Actors, Rooms>, intents: &mut IntentSet<Actors>, clock: FrameClock)
    requires Actors >= 1 && Rooms >= 1 && bindings.len > 0 {
        route_autonomous_binding<Actors, Rooms>(bindings[0], actors, intents, clock);
        transition { _ -> route_autonomous_bindings(bindings[1..], actors, intents, clock) }
    }
    machine done() {}
}

machine route_autonomous_binding<const Actors: u64, const Rooms: u64>(binding: ControllerBinding<Actors>, actors: &ActorSet<Actors, Rooms>, intents: &mut IntentSet<Actors>, clock: FrameClock)
terminates;
requires Actors >= 1 && Rooms >= 1 {
    transition binding.source {
        ControlSource::Input { device } -> done()
        ControlSource::Pursuit { target } -> pursuit(binding.actor, target, actors, intents, clock)
    }
    machine pursuit(actor: u64, target: u64, actors: &ActorSet<Actors, Rooms>, intents: &mut IntentSet<Actors>, clock: FrameClock)
    requires Actors >= 1 && Rooms >= 1 {
        transition actor < Actors && target < Actors { true -> write(actor, target, actors, intents, clock) _ -> done() }
    }
    machine write(actor: u64, target: u64, actors: &ActorSet<Actors, Rooms>, intents: &mut IntentSet<Actors>, clock: FrameClock)
    requires Actors >= 1 && Rooms >= 1 && actor < Actors && target < Actors {
        intents.items[actor] = pursue<Rooms>(actors.items[actor], actors.items[target], clock.ticks);
    }
    machine done() {}
}

public machine route_input<const Bindings: u64, const Actors: u64>(controls: &ControllerSet<Bindings, Actors>, intents: &mut IntentSet<Actors>, device: u32, command: Command)
terminates;
requires Bindings >= 1 && Actors >= 1 {
    route_bindings<Actors>(&controls.bindings[..controls.count], intents, device, command);
}

machine route_bindings<const Actors: u64>(bindings: &[ControllerBinding<Actors>], intents: &mut IntentSet<Actors>, device: u32, command: Command)
terminates by bindings -> Slice::Length;
requires Actors >= 1 {
    transition bindings.len > 0 { true -> head(bindings, intents, device, command) _ -> done() }
    machine head(bindings: &[ControllerBinding<Actors>], intents: &mut IntentSet<Actors>, device: u32, command: Command)
    requires Actors >= 1 && bindings.len > 0 {
        let binding: ControllerBinding<Actors> = bindings[0];
        route_binding<Actors>(binding, intents, device, command);
        transition { _ -> route_bindings(bindings[1..], intents, device, command) }
    }
    machine done() {}
}

machine route_binding<const Actors: u64>(binding: ControllerBinding<Actors>, intents: &mut IntentSet<Actors>, device: u32, command: Command)
terminates;
requires Actors >= 1 {
    let source: ControlSource<Actors> = binding.source;
    transition source {
        ControlSource::Input { device as selected } -> manual(binding.actor, intents, device, command, selected)
        ControlSource::Pursuit { target } -> done()
    }
    machine manual(actor: u64, intents: &mut IntentSet<Actors>, device: u32, command: Command, selected: u32)
    requires Actors >= 1 {
        transition selected == device && actor < Actors { true -> write(actor, intents, command) _ -> done() }
    }
    machine write(actor: u64, intents: &mut IntentSet<Actors>, command: Command)
    requires Actors >= 1 && actor < Actors {
        intents.items[actor] = command;
    }
    machine done() {}
}