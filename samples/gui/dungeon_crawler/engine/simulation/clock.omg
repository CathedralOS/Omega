module simulation::clock;

use configuration::ANIMATION_PERIOD;

public data FrameClock [copy]
where ticks >= 0 && ticks < ANIMATION_PERIOD {
    ticks: i32;
}

public machine advance_clock(clock: FrameClock) -> FrameClock
terminates;
{
    FrameClock { ticks: (clock.ticks + 1) % ANIMATION_PERIOD }
}