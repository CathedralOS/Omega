module simulation::game;

use actors::state::Actor;
use actors::state::ActorKind;
use actors::state::Traversal;
use actors::state::ActorSet;
use actors::state::Position;
use actors::state::Vitality;
use actors::systems::advance_actors;
use actors::systems::resolve_combat;
use actors::systems::room_has_hostiles;
use control::state::Command;
use control::state::ControlSource;
use control::state::ControllerBinding;
use control::state::ControllerSet;
use control::state::IntentSet;
use control::routing::route_input;
use control::routing::clear_intents;
use control::routing::route_autonomy;
use world::rooms::Dungeon;
use world::rooms::Progress;
use world::rooms::Reward;
use world::rooms::tile_at;
use world::campaign::hollow_dungeon;
use simulation::clock::FrameClock;
use simulation::clock::advance_clock;
use presentation::frame::Camera;
use presentation::frame::Frame;
use configuration::ACTOR_CAPACITY;
use configuration::CONTROLLER_CAPACITY;
use configuration::ROOM_COUNT;

public data Game {
    actors: ActorSet<ACTOR_CAPACITY, ROOM_COUNT>;
    controllers: ControllerSet<CONTROLLER_CAPACITY, ACTOR_CAPACITY>;
    intents: IntentSet<ACTOR_CAPACITY>;
    dungeon: Dungeon<ROOM_COUNT>;
    progress: Progress<ROOM_COUNT>;
    camera: Camera<ACTOR_CAPACITY, ROOM_COUNT>;
    clock: FrameClock;
}

public machine Game::reset(game: &mut Game)
terminates;
{
    game.dungeon = hollow_dungeon();
    game.actors = ActorSet { count: 2 };
    game.controllers = ControllerSet { count: 2 };
    game.progress = Progress {};
    game.clock = FrameClock { ticks: 0 };
    game.camera = Camera { actor: 0, room: 0 };
    game.actors.items[0] = Actor { position: Position { x: 128, y: 112 }, vitality: Vitality { current: 6, maximum: 6 }, room: 0, facing: 2, speed: 2, faction: 0, kind: ActorKind::Adventurer, active: true };
    game.controllers.bindings[0] = ControllerBinding { actor: 0, source: ControlSource::Input { device: 0 } };
    game.controllers.bindings[1] = ControllerBinding { actor: 1, source: ControlSource::Pursuit { target: 0 } };
    Game::enter(game);
}

public machine Game::enter(game: &mut Game)
terminates;
{
    let room: u64 = game.camera.room;
    transition room < ROOM_COUNT { true -> install(game, room) _ -> done() }
    machine install(game: &mut Game, room: u64) requires room < ROOM_COUNT {
        game.progress.rooms[room].visited = true;
        game.actors.items[1] = Actor { position: Position { x: 192, y: 48 }, vitality: Vitality { current: 2, maximum: 2 }, room: room, facing: 3, speed: 1, faction: 1, kind: ActorKind::Bat, traversal: Traversal::Air, active: true };
        transition !game.dungeon.rooms[room].inhabited || game.progress.rooms[room].cleared {
            true -> empty(game)
            _ -> done()
        }
    }
    machine empty(game: &mut Game) {
        game.actors.items[1].active = false;
        game.actors.items[1].vitality = Vitality { current: 0, maximum: 2 };
    }
    machine done() {}
}

public machine Game::walk(game: &mut Game, direction: i32)
terminates;
requires direction >= -1 && direction < 4 {
    Game::commands(game, Command { direction: direction, attack: false });
    Game::move(game);
    Game::settle(game);
}

public machine Game::tick(game: &mut Game, direction: i32, swing: bool)
terminates;
requires direction >= -1 && direction < 4 {
    let selected: u64 = game.camera.actor;
    transition selected < ACTOR_CAPACITY { true -> playing(game, direction, swing, selected) _ -> idle() }
    machine playing(game: &mut Game, direction: i32, swing: bool, selected: u64)
    requires direction >= -1 && direction < 4 && selected < ACTOR_CAPACITY {
        transition game.actors.items[selected].vitality.current > 0 && !game.progress.won {
            true -> update(game, direction, swing)
            _ -> idle()
        }
    }
    machine update(game: &mut Game, direction: i32, swing: bool)
    requires direction >= -1 && direction < 4 {
        game.clock = advance_clock(game.clock);
        Game::commands(game, Command { direction: direction, attack: swing });
        Game::autonomy(game);
        Game::move(game);
        Game::settle(game);
        Game::combat(game);
        Game::rewards(game);
    }
    machine idle() {}
}

machine Game::commands(game: &mut Game, command: Command) {
    clear_intents<ACTOR_CAPACITY>(&mut game.intents);
    route_input<CONTROLLER_CAPACITY, ACTOR_CAPACITY>(&game.controllers, &mut game.intents, 0, command);
}

machine Game::autonomy(game: &mut Game) {
    route_autonomy<CONTROLLER_CAPACITY, ACTOR_CAPACITY, ROOM_COUNT>(&game.controllers, &game.actors, &mut game.intents, game.clock);
}

machine Game::move(game: &mut Game) {
    advance_actors<ACTOR_CAPACITY, ROOM_COUNT>(&mut game.actors, &game.intents, &game.dungeon, game.progress.key);
}

machine Game::settle(game: &mut Game) {
    let selected: u64 = game.camera.actor;
    transition selected < ACTOR_CAPACITY { true -> follow(game, selected) _ -> done() }
    machine follow(game: &mut Game, selected: u64) requires selected < ACTOR_CAPACITY {
        let room: u64 = game.actors.items[selected].room;
        transition room < ROOM_COUNT && room != game.camera.room { true -> arrive(game, room) _ -> done() }
    }
    machine arrive(game: &mut Game, room: u64) requires room < ROOM_COUNT {
        game.camera.room = room;
        Game::enter(game);
    }
    machine done() {}
}

machine Game::combat(game: &mut Game) {
    resolve_combat<ACTOR_CAPACITY, ROOM_COUNT>(&mut game.actors);
}

machine Game::rewards(game: &mut Game) {
    let selected: u64 = game.camera.actor;
    let room: u64 = game.camera.room;
    transition selected < ACTOR_CAPACITY && room < ROOM_COUNT { true -> cleared(game, selected, room) _ -> done() }
    machine cleared(game: &mut Game, selected: u64, room: u64) requires selected < ACTOR_CAPACITY && room < ROOM_COUNT {
        let hostile: bool = room_has_hostiles<ROOM_COUNT>(&game.actors.items[..game.actors.count], room, game.actors.items[selected].faction);
        transition !hostile { true -> mark(game, selected, room) _ -> done() }
    }
    machine mark(game: &mut Game, selected: u64, room: u64) requires selected < ACTOR_CAPACITY && room < ROOM_COUNT {
        game.progress.rooms[room].cleared = true;
        let position: Position = game.actors.items[selected].position;
        transition !game.progress.rooms[room].reward_taken && position.x >= 112 && position.x <= 144 && position.y >= 32 && position.y <= 64 {
            true -> reward(game, selected, room)
            _ -> done()
        }
    }
    machine reward(game: &mut Game, selected: u64, room: u64) requires selected < ACTOR_CAPACITY && room < ROOM_COUNT {
        transition game.dungeon.rooms[room].reward {
            Reward::None -> done()
            Reward::Key -> key(game, room)
            Reward::Heal -> heal(game, selected, room)
            Reward::Relic -> relic(game, room)
        }
    }
    machine key(game: &mut Game, room: u64) requires room < ROOM_COUNT { game.progress.key = true; game.progress.rooms[room].reward_taken = true; }
    machine heal(game: &mut Game, selected: u64, room: u64) requires selected < ACTOR_CAPACITY && room < ROOM_COUNT {
        let vitality: Vitality = game.actors.items[selected].vitality;
        game.actors.items[selected].vitality = Vitality { current: vitality.maximum, maximum: vitality.maximum };
        game.progress.rooms[room].reward_taken = true;
    }
    machine relic(game: &mut Game, room: u64) requires room < ROOM_COUNT { game.progress.won = true; game.progress.rooms[room].reward_taken = true; }
    machine done() {}
}

public machine Game::capture(game: &Game) -> Frame
terminates;
{
    let selected: u64 = game.camera.actor;
    let room: u64 = game.camera.room;
    transition selected < ACTOR_CAPACITY && room < ROOM_COUNT { true -> snapshot(game, selected, room) _ -> (Frame {}) }
    machine snapshot(game: &Game, selected: u64, room: u64) -> Frame requires selected < ACTOR_CAPACITY && room < ROOM_COUNT {
        let subject: Actor<ROOM_COUNT> = game.actors.items[selected];
        let enemy: Actor<ROOM_COUNT> = game.actors.items[1];
        Frame { room: room as i32, subject: subject, enemy: enemy, clock: game.clock,
            visited: [game.progress.rooms[0].visited, game.progress.rooms[1].visited, game.progress.rooms[2].visited, game.progress.rooms[3].visited, game.progress.rooms[4].visited, game.progress.rooms[5].visited],
            key: game.progress.key, treasure: game.progress.rooms[room].reward_taken, won: game.progress.won, room_data: game.dungeon.rooms[room] }
    }
}

public machine Game::verify(game: &mut Game) -> bool
terminates;
{
    Game::reset(game);
    let wall: i32 = tile_at(&game.dungeon.rooms[0], 0, 1, false);
    let door: i32 = tile_at(&game.dungeon.rooms[0], 15, 4, false);
    let locked: i32 = tile_at(&game.dungeon.rooms[2], 7, 0, false);
    let unlocked: i32 = tile_at(&game.dungeon.rooms[2], 7, 0, true);
    wall == 1 && door == 3 && locked == 4 && unlocked == 3
}