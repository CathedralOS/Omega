use actors/state/state.omg as actor_state;
use actors/systems/systems.omg;
use configuration/configuration.omg;
use control/routing/routing.omg;
use control/state/state.omg as state_state;
use presentation/frame/frame.omg;
use simulation/clock/clock.omg;
use world/campaign/campaign.omg;
use world/rooms/rooms.omg;

public data Game {
    actors: |actor_state|::ActorSet<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>;
    controllers: |state_state|::ControllerSet<|configuration|::CONTROLLER_CAPACITY, |configuration|::ACTOR_CAPACITY>;
    intents: |state_state|::IntentSet<|configuration|::ACTOR_CAPACITY>;
    dungeon: |rooms|::Dungeon<|configuration|::ROOM_COUNT>;
    progress: |rooms|::Progress<|configuration|::ROOM_COUNT>;
    camera: |frame|::Camera<|configuration|::ACTOR_CAPACITY, |configuration|::ROOM_COUNT>;
    clock: |clock|::FrameClock;
}

public machine reset(game: @mutable Game)
terminates
{
    game.dungeon = |campaign|::hollow_dungeon();
    game.actors = |actor_state|::ActorSet { count: 2, .. };
    game.controllers = |state_state|::ControllerSet { count: 2, .. };
    game.progress = |rooms|::Progress { .. };
    game.clock = |clock|::FrameClock { ticks: 0 };
    game.camera = |frame|::Camera { actor: 0, room: 0 };
    game.actors.items[0] = |actor_state|::Actor { position: |actor_state|::Position { x: 128, y: 112 }, vitality: |actor_state|::Vitality { current: 6, maximum: 6 }, room: 0, facing: 2, speed: 2, faction: 0, kind: |actor_state|::ActorKind::Adventurer, active: true, .. };
    game.controllers.bindings[0] = |state_state|::ControllerBinding { actor: 0, source: |state_state|::ControlSource::Input { device: 0 } };
    game.controllers.bindings[1] = |state_state|::ControllerBinding { actor: 1, source: |state_state|::ControlSource::Pursuit { target: 0 } };
    enter(game);
}

public machine enter(game: @mutable Game)
terminates
{
    let room: u64 = game.camera.room;
    transition room < |configuration|::ROOM_COUNT { true -> install(game, room), _ -> done() }
    machine install(game: @mutable Game, room: u64) requires room < |configuration|::ROOM_COUNT {
        game.progress.rooms[room].visited = true;
        game.actors.items[1] = |actor_state|::Actor { position: |actor_state|::Position { x: 192, y: 48 }, vitality: |actor_state|::Vitality { current: 2, maximum: 2 }, room: room, facing: 3, speed: 1, faction: 1, kind: |actor_state|::ActorKind::Bat, traversal: |actor_state|::Traversal::Air, active: true, .. };
        transition !game.dungeon.rooms[room].inhabited || game.progress.rooms[room].cleared {
            true -> empty(game),
            _ -> done()
        }
    }
    machine empty(game: @mutable Game) {
        game.actors.items[1].active = false;
        game.actors.items[1].vitality = |actor_state|::Vitality { current: 0, maximum: 2 };
    }
    machine done() {}
}

public machine walk(game: @mutable Game, direction: i32)
terminates
requires direction >= -1 && direction < 4 {
    commands(game, |state_state|::Command { direction: direction, attack: false });
    move_actors(game);
    settle(game);
}

public machine tick(game: @mutable Game, direction: i32, swing: bool)
terminates
requires direction >= -1 && direction < 4 {
    let selected: u64 = game.camera.actor;
    transition selected < |configuration|::ACTOR_CAPACITY { true -> playing(game, direction, swing, selected), _ -> idle() }
    machine playing(game: @mutable Game, direction: i32, swing: bool, selected: u64)
    requires direction >= -1 && direction < 4 && selected < |configuration|::ACTOR_CAPACITY {
        transition game.actors.items[selected].vitality.current > 0 && !game.progress.won {
            true -> update(game, direction, swing),
            _ -> idle()
        }
    }
    machine update(game: @mutable Game, direction: i32, swing: bool)
    requires direction >= -1 && direction < 4 {
        game.clock = |clock|::advance_clock(game.clock);
        commands(game, |state_state|::Command { direction: direction, attack: swing });
        autonomy(game);
        move_actors(game);
        settle(game);
        combat(game);
        rewards(game);
    }
    machine idle() {}
}

machine commands(game: @mutable Game, command: |state_state|::Command) {
    |routing|::clear_intents::<|configuration|::ACTOR_CAPACITY>(@mutable game.intents);
    |routing|::route_input(@game.controllers, @mutable game.intents, 0, command);
}

machine autonomy(game: @mutable Game) {
    |routing|::route_autonomy(@game.controllers, @game.actors, @mutable game.intents, game.clock);
}

machine move_actors(game: @mutable Game) {
    |systems|::advance_actors(@mutable game.actors, @game.intents, @game.dungeon, game.progress.key);
}

machine settle(game: @mutable Game) {
    let selected: u64 = game.camera.actor;
    transition selected < |configuration|::ACTOR_CAPACITY { true -> follow(game, selected), _ -> done() }
    machine follow(game: @mutable Game, selected: u64) requires selected < |configuration|::ACTOR_CAPACITY {
        let room: u64 = game.actors.items[selected].room;
        transition room < |configuration|::ROOM_COUNT && room != game.camera.room { true -> arrive(game, room), _ -> done() }
    }
    machine arrive(game: @mutable Game, room: u64) requires room < |configuration|::ROOM_COUNT {
        game.camera.room = room;
        enter(game);
    }
    machine done() {}
}

machine combat(game: @mutable Game) {
    |systems|::resolve_combat(@mutable game.actors);
}

machine rewards(game: @mutable Game) {
    let selected: u64 = game.camera.actor;
    let room: u64 = game.camera.room;
    transition selected < |configuration|::ACTOR_CAPACITY && room < |configuration|::ROOM_COUNT { true -> cleared(game, selected, room), _ -> done() }
    machine cleared(game: @mutable Game, selected: u64, room: u64) requires selected < |configuration|::ACTOR_CAPACITY && room < |configuration|::ROOM_COUNT {
        let hostile: bool = |systems|::room_has_hostiles(@game.actors, room, game.actors.items[selected].faction);
        transition !hostile { true -> mark(game, selected, room), _ -> done() }
    }
    machine mark(game: @mutable Game, selected: u64, room: u64) requires selected < |configuration|::ACTOR_CAPACITY && room < |configuration|::ROOM_COUNT {
        game.progress.rooms[room].cleared = true;
        let position: |actor_state|::Position = game.actors.items[selected].position;
        transition !game.progress.rooms[room].reward_taken && position.x >= 112 && position.x <= 144 && position.y >= 32 && position.y <= 64 {
            true -> reward(game, selected, room),
            _ -> done()
        }
    }
    machine reward(game: @mutable Game, selected: u64, room: u64) requires selected < |configuration|::ACTOR_CAPACITY && room < |configuration|::ROOM_COUNT {
        transition game.dungeon.rooms[room].reward {
            |rooms|::Reward::None -> done(),
            |rooms|::Reward::Key -> key(game, room),
            |rooms|::Reward::Heal -> heal(game, selected, room),
            |rooms|::Reward::Relic -> relic(game, room)
        }
    }
    machine key(game: @mutable Game, room: u64) requires room < |configuration|::ROOM_COUNT { game.progress.key = true; game.progress.rooms[room].reward_taken = true; }
    machine heal(game: @mutable Game, selected: u64, room: u64) requires selected < |configuration|::ACTOR_CAPACITY && room < |configuration|::ROOM_COUNT {
        let vitality: |actor_state|::Vitality = game.actors.items[selected].vitality;
        game.actors.items[selected].vitality = |actor_state|::Vitality { current: vitality.maximum, maximum: vitality.maximum };
        game.progress.rooms[room].reward_taken = true;
    }
    machine relic(game: @mutable Game, room: u64) requires room < |configuration|::ROOM_COUNT { game.progress.won = true; game.progress.rooms[room].reward_taken = true; }
    machine done() {}
}

public machine capture(game: @Game) -> |frame|::Frame
terminates
{
    let selected: u64 = game.camera.actor;
    let room: u64 = game.camera.room;
    transition selected < |configuration|::ACTOR_CAPACITY && room < |configuration|::ROOM_COUNT { true -> snapshot(game, selected, room), _ -> (|frame|::Frame { .. }) }
    machine snapshot(game: @Game, selected: u64, room: u64) -> |frame|::Frame requires selected < |configuration|::ACTOR_CAPACITY && room < |configuration|::ROOM_COUNT {
        let subject: |actor_state|::Actor<|configuration|::ROOM_COUNT> = game.actors.items[selected];
        let enemy: |actor_state|::Actor<|configuration|::ROOM_COUNT> = game.actors.items[1];
        |frame|::Frame { room: room as i32, subject: subject, enemy: enemy, clock: game.clock,
            visited: [game.progress.rooms[0].visited, game.progress.rooms[1].visited, game.progress.rooms[2].visited, game.progress.rooms[3].visited, game.progress.rooms[4].visited, game.progress.rooms[5].visited],
            key: game.progress.key, treasure: game.progress.rooms[room].reward_taken, won: game.progress.won, room_data: game.dungeon.rooms[room] }
    }
}

public machine verify(game: @mutable Game) -> bool
terminates
{
    reset(game);
    let wall: i32 = |rooms|::tile_at::<|configuration|::ROOM_COUNT>(@game.dungeon.rooms[0], 0, 1, false);
    let door: i32 = |rooms|::tile_at::<|configuration|::ROOM_COUNT>(@game.dungeon.rooms[0], 15, 4, false);
    let locked: i32 = |rooms|::tile_at::<|configuration|::ROOM_COUNT>(@game.dungeon.rooms[2], 7, 0, false);
    let unlocked: i32 = |rooms|::tile_at::<|configuration|::ROOM_COUNT>(@game.dungeon.rooms[2], 7, 0, true);
    wall == 1 && door == 3 && locked == 4 && unlocked == 3
}