module configuration;

public const TILE_PIXELS: u16 = 16;
public const ROOM_COLUMNS: u16 = 16;
public const ROOM_ROWS: u16 = 10;
public const TILE_SIZE: i32 = TILE_PIXELS as i32;
public const ROOM_WIDTH: i32 = (ROOM_COLUMNS as i32) * TILE_SIZE;
public const ROOM_HEIGHT: i32 = (ROOM_ROWS as i32) * TILE_SIZE;
public const HUD_HEIGHT: u16 = 32;
public const FRAME_WIDTH: u32 = (ROOM_COLUMNS as u32) * (TILE_PIXELS as u32);
public const FRAME_HEIGHT: u32 = (ROOM_ROWS as u32) * (TILE_PIXELS as u32) + (HUD_HEIGHT as u32);
public const FRAME_PIXELS: u64 = (FRAME_WIDTH as u64) * (FRAME_HEIGHT as u64);
public const WINDOW_SCALE: i32 = 4;
public const WINDOW_WIDTH: i32 = ROOM_WIDTH * WINDOW_SCALE + 16;
public const WINDOW_HEIGHT: i32 = (ROOM_HEIGHT + (HUD_HEIGHT as i32)) * WINDOW_SCALE + 39;
public const FRAME_DELAY_MILLISECONDS: u32 = 16;
public const EVENT_BUDGET: u32 = 32;
public const ROOM_LAST_COLUMN: i32 = (ROOM_COLUMNS as i32) - 1;
public const ROOM_LAST_ROW: i32 = (ROOM_ROWS as i32) - 1;
public const DOOR_COLUMN_START: i32 = (ROOM_COLUMNS as i32) / 2 - 1;
public const DOOR_COLUMN_END: i32 = (ROOM_COLUMNS as i32) / 2;
public const DOOR_ROW_START: i32 = (ROOM_ROWS as i32) / 2 - 1;
public const DOOR_ROW_END: i32 = (ROOM_ROWS as i32) / 2;
public const ROOM_COUNT: u64 = 6;
public const ACTOR_CAPACITY: u64 = 8;
public const CONTROLLER_CAPACITY: u64 = 8;
public const COLLIDER_RADIUS: i32 = 5;
public const MAX_MOVEMENT_STEP: i32 = 2;
public const ARRIVAL_INSET: i32 = (TILE_PIXELS as i32) + COLLIDER_RADIUS + 1;
public const ATTACK_FRAMES: i32 = 15;
public const INVULNERABILITY_FRAMES: i32 = 60;
public const ANIMATION_PERIOD: i32 = 3600;
public const PURSUIT_INTERVAL: i32 = 3;
public const MELEE_REACH: i32 = 26;
public const KNOCKBACK_DISTANCE: i32 = 12;
public const CONTACT_DISTANCE: i32 = 11;