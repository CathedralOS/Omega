use actors/state/state.omg as actor_state;
use simulation/clock/clock.omg;
use world/rooms/rooms.omg;

public data Camera<const Actors: u64, const Rooms: u64>
requires Actors >= 1, Rooms >= 1, actor < Actors, room < Rooms {
    actor: u64;
    room: u64;
}

public data Frame
requires room >= 0 && room < 6 {
    room: i32;
    subject: |actor_state|::Actor<6>;
    enemy: |actor_state|::Actor<6>;
    clock: |clock|::FrameClock;
    visited: [bool; 6];
    key: bool;
    treasure: bool;
    won: bool;
    room_data: |rooms|::Room<6>;
}