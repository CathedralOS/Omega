use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "dungeon_crawler");
    builder.identifier = "com.omega.dungeon-crawler";
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../../../source/library/system" }));
    let engine_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "engine" }));
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    builder.subsystem = Subsystem::Gui;
}