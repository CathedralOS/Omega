machine build(builder: &mut Build) {
    Build::application(builder, "dungeon_crawler");
    builder.identifier = "com.omega.dungeon-crawler";
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../source/library/std" }));
    let engine_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "engine" }));
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    builder.subsystem = Subsystem::Gui;
}