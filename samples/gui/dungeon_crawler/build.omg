machine build(builder: &mut Build) {
    Build::application(builder, "dungeon_crawler");
    builder.identifier = "com.omega.dungeon-crawler";
    Build::depend(builder, Source::Path { location: "../../../source/library/std" });
    Build::depend(builder, Source::Path { location: "engine" });
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    builder.subsystem = Subsystem::Gui;
}