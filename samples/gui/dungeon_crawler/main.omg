use {dungeon_core}/configuration/configuration.omg;
use {dungeon_core}/presentation/frame/frame.omg;
use {dungeon_core}/render.omg;
use {dungeon_core}/simulation/game/game.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
use {system}/windows_gui_host.omg;

public data Main
requires cursor <= |configuration|::FRAME_PIXELS, pumped <= |configuration|::EVENT_BUDGET, direction >= -1 && direction < 4 {
    game: |game|::Game;
    frame: |frame|::Frame;
    pixels: [i32; |configuration|::FRAME_PIXELS];
    message: |windows_gui_host|::WindowsMessage;
    close_requested: bool;
    dirty: bool;
    cursor: u64;
    pumped: u32;
    direction: i32;
    swing: bool;
}

public machine prepare(main: @mutable Main) -> bool {
    let verified: bool = |game|::verify(@mutable main.game);
    transition verified { true -> ready(main), _ -> (false) }
    machine ready(main: @mutable Main) -> bool {
        |game|::reset(@mutable main.game);
        main.close_requested = false;
        main.dirty = true;
        true
    }
}

public machine fail_self_test() reaches |process_authority|::StandardOutput + |process_exit|::ProcessExit {
    |console|::Console::write_line("FAIL: dungeon gameplay self-test");
    |process_exit|::ProcessExit::exit_process(1);
}

public machine reset_game(main: @mutable Main) {
    |game|::reset(@mutable main.game);
    main.dirty = true;
}

public machine tick_game(main: @mutable Main) {
    |game|::tick(@mutable main.game, main.direction, main.swing);
    main.dirty = true;
}

public machine render_frame(main: @mutable Main) {
    main.frame = |game|::capture(@main.game);
    main.cursor = 0;
    main.dirty = false;
    transition { _ -> row_loop(main, 0) }
    machine row_loop(main: @mutable Main, y: i32) requires y >= 0 && y <= |render|::RENDER_HEIGHT {
        transition y < |render|::RENDER_HEIGHT { true -> col_loop(main, y, 0), _ -> done() }
    }
    machine col_loop(main: @mutable Main, y: i32, x: i32)
    requires y >= 0 && y < |render|::RENDER_HEIGHT && x >= 0 && x <= |configuration|::ROOM_WIDTH {
        transition x < |configuration|::ROOM_WIDTH && main.cursor < |configuration|::FRAME_PIXELS {
            true -> draw_pixel(main, y, x),
            _ -> next_row(main, y)
        }
    }
    machine draw_pixel(main: @mutable Main, y: i32, x: i32)
    requires main.cursor < |configuration|::FRAME_PIXELS && x >= 0 && x < |configuration|::ROOM_WIDTH && y >= 0 && y < |render|::RENDER_HEIGHT {
        main.pixels[main.cursor] = |render|::pixel(@main.frame, x, y);
        main.cursor = main.cursor + 1;
        transition { _ -> col_loop(main, y, x + 1) }
    }
    machine next_row(main: @mutable Main, y: i32) requires y >= 0 && y < |render|::RENDER_HEIGHT {
        transition { _ -> row_loop(main, y + 1) }
    }
    machine done() {}
}
