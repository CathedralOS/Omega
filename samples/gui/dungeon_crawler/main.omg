use omega_language_std::macos_gui;
use omega_language_std::console;
use dungeon_core::simulation::game::Game;
use dungeon_core::presentation::frame::Frame;
use dungeon_core::render;
use dungeon_core::configuration::FRAME_WIDTH;
use dungeon_core::configuration::FRAME_HEIGHT;
use dungeon_core::configuration::FRAME_PIXELS;
use dungeon_core::configuration::WINDOW_WIDTH;
use dungeon_core::configuration::WINDOW_HEIGHT;
use dungeon_core::configuration::FRAME_DELAY_MILLISECONDS;
use dungeon_core::configuration::EVENT_BUDGET;

data Main
where cursor <= FRAME_PIXELS, pumped <= EVENT_BUDGET, direction >= -1 && direction < 4 {
    game: Game;
    frame: Frame;
    pixels: [i32; FRAME_PIXELS];
    cursor: u64;
    pumped: u32;
    direction: i32;
    swing: bool;
}

machine Main::main(main: &mut Main) reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit + Console {
    let verified: bool = Game::verify(&mut main.game);
    transition verified { true -> start(main) _ -> failed() }

    state failed() {
        Console::write_line("FAIL: dungeon gameplay self-test");
        Console::exit_process(1);
    }

    state start(main: &mut Main) {
        Game::reset(&mut main.game);
        let class_name: [u8; 7] = "#32770\0";
        let title: [u8; 16] = "HOLLOW / OMEGA\0\0";
        let window: Window = macos_window_create(class_name, &title[0], 0, 0, 0, WINDOW_WIDTH, WINDOW_HEIGHT);
        transition window.window != 0 { true -> frame(main, window) _ -> close(main, window) }
    }

    state render(main: &mut Main, window: Window) {
        main.frame = Game::capture(&main.game);
        main.cursor = 0;
        transition { _ -> fill(main, window) }
    }
    state fill(main: &mut Main, window: Window) {
        transition main.cursor < FRAME_PIXELS { true -> pixel(main, window) _ -> draw(main, window) }
    }
    state pixel(main: &mut Main, window: Window) requires main.cursor < FRAME_PIXELS {
        let x: i32 = (main.cursor % (FRAME_WIDTH as u64)) as i32;
        let y: i32 = (main.cursor / (FRAME_WIDTH as u64)) as i32;
        main.pixels[main.cursor] = Art::pixel(&main.frame, x, y);
        main.cursor = main.cursor + 1;
        transition { _ -> fill(main, window) }
    }
    state frame(main: &mut Main, window: Window) {
        main.pumped = 0;
        transition { _ -> pump(main, window) }
    }
    state pump(main: &mut Main, mut window: Window) {
        let available: u32 = macos_window_msg_peek(&mut window, [0, 0, 0, 0, 0, 0]);
        transition available > 0 && main.pumped < EVENT_BUDGET { true -> dispatch(main, window) _ -> visible(main, window) }
    }
    state dispatch(main: &mut Main, window: Window)
    requires main.pumped < EVENT_BUDGET {
        let dispatched: u64 = macos_window_msg_dispatch(&window, [0, 0, 0, 0, 0, 0]);
        main.pumped = main.pumped + 1;
        transition { _ -> pump(main, window) }
    }
    state visible(main: &mut Main, window: Window) {
        let alive: u32 = macos_window_is_window(&window, window.window);
        transition alive > 0 { true -> focus(main, window) _ -> close(main, window) }
    }
    state focus(main: &mut Main, window: Window) {
        let focused: u64 = macos_window_foreground_window(&window);
        transition focused == window.window { true -> escape(main, window) _ -> render(main, window) }
    }
    state escape(main: &mut Main, window: Window) {
        let escape: u64 = macos_key_state(27);
        transition escape > 0 { true -> close(main, window) _ -> restart(main, window) }
    }
    state restart(main: &mut Main, window: Window) {
        let restart: u64 = macos_key_state(82);
        transition restart > 0 { true -> reset(main, window) _ -> input(main, window) }
    }
    state reset(main: &mut Main, window: Window) {
        Game::reset(&mut main.game);
        transition { _ -> input(main, window) }
    }
    state input(main: &mut Main, window: Window) {
        main.direction = -1;
        let attack: u64 = macos_key_state(32);
        main.swing = attack > 0;
        let up: u64 = macos_key_state(38);
        let north: u64 = macos_key_state(87);
        transition up > 0 || north > 0 { true -> north(main, window) _ -> east_input(main, window) }
    }
    state north(main: &mut Main, window: Window) {
        main.direction = 0;
        transition { _ -> update(main, window) }
    }
    state east_input(main: &mut Main, window: Window) {
        let right: u64 = macos_key_state(39);
        let east: u64 = macos_key_state(68);
        transition right > 0 || east > 0 { true -> east(main, window) _ -> south_input(main, window) }
    }
    state east(main: &mut Main, window: Window) {
        main.direction = 1;
        transition { _ -> update(main, window) }
    }
    state south_input(main: &mut Main, window: Window) {
        let down: u64 = macos_key_state(40);
        let south: u64 = macos_key_state(83);
        transition down > 0 || south > 0 { true -> south(main, window) _ -> west_input(main, window) }
    }
    state south(main: &mut Main, window: Window) {
        main.direction = 2;
        transition { _ -> update(main, window) }
    }
    state west_input(main: &mut Main, window: Window) {
        let left: u64 = macos_key_state(37);
        let west: u64 = macos_key_state(65);
        transition left > 0 || west > 0 { true -> west(main, window) _ -> update(main, window) }
    }
    state west(main: &mut Main, window: Window) {
        main.direction = 3;
        transition { _ -> update(main, window) }
    }
    state update(main: &mut Main, window: Window) {
        Game::tick(&mut main.game, main.direction, main.swing);
        transition { _ -> render(main, window) }
    }
    state draw(main: &mut Main, window: Window) {
        let copied: u32 = macos_window_present(&window, FRAME_WIDTH, FRAME_HEIGHT, &mut main.pixels[..FRAME_PIXELS]);
        macos_sleep(FRAME_DELAY_MILLISECONDS);
        transition copied == FRAME_HEIGHT { true -> frame(main, window) _ -> close(main, window) }
    }
    state close(main: &mut Main, window: Window) {
        macos_window_destroy(window);
    }
}
// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
