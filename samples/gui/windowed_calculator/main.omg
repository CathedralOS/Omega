            _ -> write_pixel_guard(main)
        }
    }
    state digit7_segment(main: &mut Main) {
        transition main.segment == 0 || main.segment == 1 || main.segment == 2 { true -> segment_on(main) _ -> write_pixel_guard(main) }
    }
    state digit8_segment(main: &mut Main) { transition { _ -> segment_on(main) } }
    state digit9_segment(main: &mut Main) {
        transition main.segment != 4 { true -> segment_on(main) _ -> write_pixel_guard(main) }
    }
    state segment_on(main: &mut Main) {
        main.px = 52991;
        transition { _ -> write_pixel_guard(main) }
    }

    state keypad_region(main: &mut Main) {
        transition main.row >= 18 && main.row < 63 { true -> button_prepare(main) _ -> write_pixel_guard(main) }
    }
    state button_prepare(main: &mut Main) {
        main.button_row = min(max((main.row - 18) / 9, 0), 4);
        main.button_col = min(max(main.col / 16, 0), 3);
        main.button_lx = main.col % 16;
        main.button_ly = (main.row - 18) % 9;
        transition main.button_row == 0 { true -> button_row0(main) _ -> button_row1_check(main) }
    }
    state button_row1_check(main: &mut Main) {
        transition main.button_row == 1 { true -> button_row1(main) _ -> button_row2_check(main) }
    }
    state button_row2_check(main: &mut Main) {
        transition main.button_row == 2 { true -> button_row2(main) _ -> button_row3_check(main) }
    }
    state button_row3_check(main: &mut Main) {
        transition main.button_row == 3 { true -> button_row3(main) _ -> button_row4(main) }
    }
    state button_row0(main: &mut Main) {
        transition main.button_col == 0 { true -> button_code_memory_add(main) _ -> button_row0_col1(main) }
    }
    state button_row0_col1(main: &mut Main) {
        transition main.button_col == 1 { true -> button_code_memory_recall(main) _ -> button_row0_col2(main) }
    }
    state button_row0_col2(main: &mut Main) {
        transition main.button_col == 2 { true -> button_code_clear(main) _ -> button_code_backspace(main) }
    }
    state button_row1(main: &mut Main) {
        transition main.button_col == 0 { true -> button_code7(main) _ -> button_row1_col1(main) }
    }
    state button_row1_col1(main: &mut Main) {
        transition main.button_col == 1 { true -> button_code8(main) _ -> button_row1_col2(main) }
    }
    state button_row1_col2(main: &mut Main) {
        transition main.button_col == 2 { true -> button_code9(main) _ -> button_code_divide(main) }
    }
    state button_row2(main: &mut Main) {
        transition main.button_col == 0 { true -> button_code4(main) _ -> button_row2_col1(main) }
    }
    state button_row2_col1(main: &mut Main) {
        transition main.button_col == 1 { true -> button_code5(main) _ -> button_row2_col2(main) }
    }
    state button_row2_col2(main: &mut Main) {
        transition main.button_col == 2 { true -> button_code6(main) _ -> button_code_multiply(main) }
    }
    state button_row3(main: &mut Main) {
        transition main.button_col == 0 { true -> button_code1(main) _ -> button_row3_col1(main) }
    }
    state button_row3_col1(main: &mut Main) {
        transition main.button_col == 1 { true -> button_code2(main) _ -> button_row3_col2(main) }
    }
    state button_row3_col2(main: &mut Main) {
        transition main.button_col == 2 { true -> button_code3(main) _ -> button_code_minus(main) }
    }
    state button_row4(main: &mut Main) {
        transition main.button_col == 0 { true -> button_code_sign(main) _ -> button_row4_col1(main) }
    }
    state button_row4_col1(main: &mut Main) {
        transition main.button_col == 1 { true -> button_code0(main) _ -> button_row4_col2(main) }
    }
    state button_row4_col2(main: &mut Main) {
        transition main.button_col == 2 { true -> button_code_equals(main) _ -> button_code_plus(main) }
    }
    state button_code0(main: &mut Main) { main.button_code = 0; transition { _ -> button_paint(main) } }
    state button_code1(main: &mut Main) { main.button_code = 1; transition { _ -> button_paint(main) } }
    state button_code2(main: &mut Main) { main.button_code = 2; transition { _ -> button_paint(main) } }
    state button_code3(main: &mut Main) { main.button_code = 3; transition { _ -> button_paint(main) } }
    state button_code4(main: &mut Main) { main.button_code = 4; transition { _ -> button_paint(main) } }
    state button_code5(main: &mut Main) { main.button_code = 5; transition { _ -> button_paint(main) } }
    state button_code6(main: &mut Main) { main.button_code = 6; transition { _ -> button_paint(main) } }
    state button_code7(main: &mut Main) { main.button_code = 7; transition { _ -> button_paint(main) } }
    state button_code8(main: &mut Main) { main.button_code = 8; transition { _ -> button_paint(main) } }
    state button_code9(main: &mut Main) { main.button_code = 9; transition { _ -> button_paint(main) } }
    state button_code_plus(main: &mut Main) { main.button_code = 11; transition { _ -> button_paint(main) } }
    state button_code_minus(main: &mut Main) { main.button_code = 12; transition { _ -> button_paint(main) } }
    state button_code_multiply(main: &mut Main) { main.button_code = 13; transition { _ -> button_paint(main) } }
    state button_code_divide(main: &mut Main) { main.button_code = 14; transition { _ -> button_paint(main) } }
    state button_code_sign(main: &mut Main) { main.button_code = 15; transition { _ -> button_paint(main) } }
    state button_code_equals(main: &mut Main) { main.button_code = 16; transition { _ -> button_paint(main) } }
    state button_code_memory_add(main: &mut Main) { main.button_code = 20; transition { _ -> button_paint(main) } }
    state button_code_memory_recall(main: &mut Main) { main.button_code = 21; transition { _ -> button_paint(main) } }
    state button_code_clear(main: &mut Main) { main.button_code = 22; transition { _ -> button_paint(main) } }
    state button_code_backspace(main: &mut Main) { main.button_code = 23; transition { _ -> button_paint(main) } }

    state button_paint(main: &mut Main) {
        main.px = 2171169;
        transition main.button_code == main.last_key { true -> button_active(main) _ -> button_border(main) }
    }
    state button_active(main: &mut Main) {
        main.px = 5335039;
        transition { _ -> button_border(main) }
    }
    state button_border(main: &mut Main) {
        transition main.button_lx == 0 || main.button_lx == 15 || main.button_ly == 0 || main.button_ly == 8 {
            true -> button_border_paint(main)
            _ -> button_label(main)
        }
    }
    state button_border_paint(main: &mut Main) {
        main.px = 8421504;
        transition { _ -> write_pixel_guard(main) }
    }
    // Re-assert the in-button coordinates: button_hit computed them many
    // dispatch states back, and the label arithmetic below needs them bounded
    // (always true: `col % 16` and `(row - 18) % 9` inside the button grid).
    state button_label(main: &mut Main) {
        transition main.button_lx >= 0 && main.button_lx <= 15 && main.button_ly >= 0 && main.button_ly <= 8 {
            true -> button_label_kind(main)
            _ -> write_pixel_guard(main)
        }
    }
    state button_label_kind(main: &mut Main) {
        transition main.button_code <= 9 { true -> button_digit_label(main) _ -> button_operator_label(main) }
    }
    state button_digit_label(main: &mut Main) {
        main.draw_digit = main.button_code as i32 in Saturating;
        main.local_x = main.button_lx - 4;
        main.local_y = main.button_ly - 1;
        transition { _ -> button_segment_a(main) }
    }
    state button_segment_a(main: &mut Main) {
        transition main.local_y == 0 && main.local_x >= 1 && main.local_x <= 5 {
            true -> segment_set_a(main)
            _ -> button_segment_b(main)
        }
    }
    state button_segment_b(main: &mut Main) {
        transition main.local_x == 6 && main.local_y >= 1 && main.local_y <= 3 {
            true -> segment_set_b(main)
            _ -> button_segment_c(main)
        }
    }
    state button_segment_c(main: &mut Main) {
        transition main.local_x == 6 && main.local_y >= 5 && main.local_y <= 6 {
            true -> segment_set_c(main)
            _ -> button_segment_d(main)
        }
    }
    state button_segment_d(main: &mut Main) {
        transition main.local_y == 7 && main.local_x >= 1 && main.local_x <= 5 {
            true -> segment_set_d(main)
            _ -> button_segment_e(main)
        }
    }
    state button_segment_e(main: &mut Main) {
        transition main.local_x == 0 && main.local_y >= 5 && main.local_y <= 6 {
            true -> segment_set_e(main)
            _ -> button_segment_f(main)
        }
    }
    state button_segment_f(main: &mut Main) {
        transition main.local_x == 0 && main.local_y >= 1 && main.local_y <= 3 {
            true -> segment_set_f(main)
            _ -> button_segment_g(main)
        }
    }
    state button_segment_g(main: &mut Main) {
        transition main.local_y == 4 && main.local_x >= 1 && main.local_x <= 5 {
            true -> segment_set_g(main)
            _ -> write_pixel_guard(main)
        }
    }
    state button_operator_label(main: &mut Main) {
        transition main.button_code == 11 { true -> label_plus(main) _ -> label_minus_check(main) }
    }
    state label_minus_check(main: &mut Main) {
        transition main.button_code == 12 { true -> label_minus(main) _ -> label_multiply_check(main) }
    }
    state label_multiply_check(main: &mut Main) {
        transition main.button_code == 13 { true -> label_multiply(main) _ -> label_divide_check(main) }
    }
    state label_divide_check(main: &mut Main) {
        transition main.button_code == 14 { true -> label_divide(main) _ -> label_sign_check(main) }
    }
    state label_sign_check(main: &mut Main) {
        transition main.button_code == 15 { true -> label_sign(main) _ -> label_equals_check(main) }
    }
    state label_equals_check(main: &mut Main) {
        transition main.button_code == 16 { true -> label_equals(main) _ -> label_utility(main) }
    }
    state label_plus(main: &mut Main) {
        transition main.button_lx == 8 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main) _ -> label_plus_bar(main) }
    }
    state label_plus_bar(main: &mut Main) {
        transition main.button_ly == 4 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main) _ -> write_pixel_guard(main) }
    }
    state label_minus(main: &mut Main) {
        transition main.button_ly == 4 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main) _ -> write_pixel_guard(main) }
    }
    state label_multiply(main: &mut Main) {
        transition main.button_lx == main.button_ly + 4 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main) _ -> label_multiply_backslash(main) }
    }
    state label_multiply_backslash(main: &mut Main) {
        transition main.button_lx + main.button_ly == 12 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main) _ -> write_pixel_guard(main) }
    }
    state label_divide(main: &mut Main) {
        transition main.button_lx + main.button_ly == 12 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main) _ -> label_divide_dot_top(main) }
    }
    state label_divide_dot_top(main: &mut Main) {
        transition main.button_lx == 8 && main.button_ly == 2 { true -> label_paint(main) _ -> label_divide_dot_bottom(main) }
    }
    state label_divide_dot_bottom(main: &mut Main) {
        transition main.button_lx == 8 && main.button_ly == 6 { true -> label_paint(main) _ -> write_pixel_guard(main) }
    }
    state label_sign(main: &mut Main) {
        transition main.button_lx == 7 && main.button_ly >= 2 && main.button_ly <= 5 { true -> label_paint(main) _ -> label_sign_plus_bar(main) }
    }
    state label_sign_plus_bar(main: &mut Main) {
        transition main.button_ly == 4 && main.button_lx >= 5 && main.button_lx <= 9 { true -> label_paint(main) _ -> label_sign_minus_bar(main) }
    }
    state label_sign_minus_bar(main: &mut Main) {
        transition main.button_ly == 6 && main.button_lx >= 5 && main.button_lx <= 9 { true -> label_paint(main) _ -> write_pixel_guard(main) }
    }
    state label_equals(main: &mut Main) {
        transition main.button_ly == 3 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main) _ -> label_equals_bottom(main) }
    }
    state label_equals_bottom(main: &mut Main) {
        transition main.button_ly == 5 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main) _ -> write_pixel_guard(main) }
    }
    state label_utility(main: &mut Main) {
        transition main.button_lx >= 5 && main.button_lx <= 11 && main.button_ly >= 2 && main.button_ly <= 6 {
            true -> label_paint(main)
            _ -> write_pixel_guard(main)
        }
    }
    state label_paint(main: &mut Main) {
        main.px = 15794175;
        transition { _ -> write_pixel_guard(main) }
    }

    state write_pixel_guard(main: &mut Main) {
        transition main.i >= 0 && main.i < 4096 { true -> write_pixel(main) _ -> bad(main) }
    }
    state write_pixel(main: &mut Main) {
        main.pixels[main.i] = main.px;
        main.i = main.i + 1;
        transition main.col == 63 { true -> render_pump_peek(main) _ -> fill_loop(main) }
    }
    state render_pump_peek(main: &mut Main) {
        main.have = main.gui.msg_peek(main.message);
        transition main.have > 0 { true -> render_pump_check_close(main) _ -> fill_loop(main) }
    }
    state render_pump_check_close(main: &mut Main) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main) _ -> render_pump_check_syscommand(main) }
    }
    state render_pump_check_syscommand(main: &mut Main) {
        transition main.msg_code == 274 { true -> render_pump_check_sysclose(main) _ -> render_pump_handle(main) }
    }
    state render_pump_check_sysclose(main: &mut Main) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main) _ -> render_pump_handle(main) }
    }
    state render_pump_handle(main: &mut Main) {
        main.translated = main.gui.msg_translate(main.message);
        main.dispatched = main.gui.msg_dispatch(main.message);
        transition { _ -> render_pump_liveness(main) }
    }
    state render_pump_liveness(main: &mut Main) {
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> fill_loop(main) _ -> closed(main) }
    }

    state present(main: &mut Main) {
        main.copied = main.gui.blit(main.hdc, 512, 512, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main) _ -> present_failed(main) }
    }
    state present_failed(main: &mut Main) {
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> bad(main) _ -> closed(main) }
    }
    state pace(main: &mut Main) {
        main.clock.sleep(16);
        transition main.frame >= 0 && main.frame < 16384 { true -> advance(main) _ -> wrap_frame(main) }
    }
    state advance(main: &mut Main) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }

    state quit_self(main: &mut Main) {
        main.killed = main.gui.window_destroy(main.hwnd);
        transition { _ -> closed(main) }
    }
    state closed(main: &mut Main) {
        main.console.write_line("windowed calculator closed (exit 0)");
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: windowed_calculator hit a renderer or host assertion (exit 1)");
        main.console.exit_process(1);
    }
}

machine Main::accept_digit(main: &mut Main, digit: i32, key_code: i32)
requires
    digit >= 0 && digit <= 9;
requires
    key_code >= 0 && key_code <= 31;
{
    main.last_key = key_code;
    main.cooldown = 6;
    transition main.error > 0 { true -> digit_after_error(main, digit) _ -> digit_dispatch(main, digit) }

    state digit_after_error(main: &mut Main, digit: i32) {
        main.error = 0;
        main.pending = 0;
        main.accumulator = 0;
        main.current = digit as i32 in Saturating;
        main.typing = 1;
    }
    state digit_dispatch(main: &mut Main, digit: i32) {
        transition main.typing > 0 { true -> digit_append(main, digit) _ -> digit_start(main, digit) }
    }
    state digit_start(main: &mut Main, digit: i32) {
        main.current = digit as i32 in Saturating;
        main.typing = 1;
    }
    state digit_append(main: &mut Main, digit: i32) {
        // Fused Saturating mul/add in operand position lower correctly since
        // the 2026-07-09d operand-position domain lowering (the clamp happens
        // at each operation node before the modulo).
        main.current = ((main.current * (10 as i32 in Saturating)) + (digit as i32 in Saturating)) % (10000 as i32 in Saturating);
    }
}

machine Main::accept_operator(main: &mut Main, op: i32, key_code: i32)
requires
    op >= 0 && op <= 4;
requires
    key_code >= 0 && key_code <= 31;
{
    main.last_key = key_code;
    main.cooldown = 6;
    transition main.error > 0 { true -> done(main) _ -> operator_dispatch(main, op) }

    state operator_dispatch(main: &mut Main, op: i32) {
        transition main.pending == 0 { true -> store_first(main, op) _ -> evaluate_for_operator(main, op) }
    }
    state store_first(main: &mut Main, op: i32) {
        main.accumulator = main.current;
        main.current = 0;
        main.typing = 0;
        main.pending = op;
    }
    state evaluate_for_operator(main: &mut Main, op: i32) {
        transition main.pending == 1 { true -> eval_add(main, op) _ -> eval_sub_check(main, op) }
    }
    state eval_sub_check(main: &mut Main, op: i32) {
        transition main.pending == 2 { true -> eval_sub(main, op) _ -> eval_mul_check(main, op) }
    }
    state eval_mul_check(main: &mut Main, op: i32) {
        transition main.pending == 3 { true -> eval_mul(main, op) _ -> eval_div_check(main, op) }
    }
    state eval_div_check(main: &mut Main, op: i32) {
        transition main.pending == 4 { true -> eval_div_guard(main, op) _ -> finish_operator(main, op) }
    }
    state eval_add(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator + main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state eval_sub(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator - main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state eval_mul(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator * main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state eval_div_guard(main: &mut Main, op: i32) {
        transition main.current == 0 { true -> divide_error(main) _ -> eval_div(main, op) }
    }
    state eval_div(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator / main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state finish_operator(main: &mut Main, op: i32) {
        main.current = 0;
        main.typing = 0;
        main.pending = op;
    }
    state divide_error(main: &mut Main) {
        main.error = 1;
        main.pending = 0;
        main.typing = 0;
    }
    state done(main: &mut Main) {}
}

machine Main::accept_equals(main: &mut Main) {
    main.last_key = 16;
    main.cooldown = 6;
    transition main.error > 0 { true -> done(main) _ -> equals_dispatch(main) }

    state equals_dispatch(main: &mut Main) {
        transition main.pending == 0 { true -> finish_equals(main) _ -> evaluate_pending(main) }
    }
    state evaluate_pending(main: &mut Main) {
        transition main.pending == 1 { true -> eval_add(main) _ -> eval_sub_check(main) }
    }
    state eval_sub_check(main: &mut Main) {
        transition main.pending == 2 { true -> eval_sub(main) _ -> eval_mul_check(main) }
    }
    state eval_mul_check(main: &mut Main) {
        transition main.pending == 3 { true -> eval_mul(main) _ -> eval_div_check(main) }
    }
    state eval_div_check(main: &mut Main) {
        transition main.pending == 4 { true -> eval_div_guard(main) _ -> finish_equals(main) }
    }
    state eval_add(main: &mut Main) {
        main.accumulator = main.accumulator + main.current;
        transition { _ -> finish_equals(main) }
    }
    state eval_sub(main: &mut Main) {
        main.accumulator = main.accumulator - main.current;
        transition { _ -> finish_equals(main) }
    }
    state eval_mul(main: &mut Main) {
        main.accumulator = main.accumulator * main.current;
        transition { _ -> finish_equals(main) }
    }
    state eval_div_guard(main: &mut Main) {
        transition main.current == 0 { true -> divide_error(main) _ -> eval_div(main) }
    }
    state eval_div(main: &mut Main) {
        main.accumulator = main.accumulator / main.current;
        transition { _ -> finish_equals(main) }
    }
    state finish_equals(main: &mut Main) {
        main.current = main.accumulator;
        main.pending = 0;
        main.typing = 1;
    }
    state divide_error(main: &mut Main) {
        main.error = 1;
        main.pending = 0;
        main.typing = 0;
    }
    state done(main: &mut Main) {}
}

machine Main::clear_all(main: &mut Main, key_code: i32)
requires
    key_code >= 0 && key_code <= 31;
{
    main.last_key = key_code;
    main.cooldown = 6;
    main.current = 0;
    main.accumulator = 0;
    main.pending = 0;
    main.typing = 1;
    main.error = 0;
}

machine Main::backspace(main: &mut Main) {
    main.last_key = 23;
    main.cooldown = 6;
    transition main.typing > 0 { true -> trim(main) _ -> done(main) }

    state trim(main: &mut Main) {
        main.current = main.current / 10;
    }
    state done(main: &mut Main) {}
}

machine Main::toggle_sign(main: &mut Main) {
    main.last_key = 15;
    main.cooldown = 6;
    transition main.typing > 0 { true -> sign_current(main) _ -> sign_accumulator(main) }

    state sign_current(main: &mut Main) {
        main.current = 0 - main.current;
    }
    state sign_accumulator(main: &mut Main) {
        main.accumulator = 0 - main.accumulator;
    }
}

machine Main::memory_add(main: &mut Main) {
    main.last_key = 20;
    main.cooldown = 6;
    transition main.typing > 0 { true -> add_current(main) _ -> add_accumulator(main) }

    state add_current(main: &mut Main) { main.memory = main.memory + main.current; }
    state add_accumulator(main: &mut Main) { main.memory = main.memory + main.accumulator; }
}

machine Main::memory_recall(main: &mut Main) {
    main.last_key = 21;
    main.cooldown = 6;
    main.current = main.memory;
    main.typing = 1;
    main.error = 0;
}
