    }
    state display_pixel(main: &mut Main) {
        main.px = 461325;
        transition main.row >= 2 && main.row < 13 && main.col >= 28 && main.col < 60 {
            true -> display_digit_slot(main)
            _ -> display_sign(main)
        }
    }
    state display_sign(main: &mut Main) {
        transition main.sign > 0 && main.row == 8 && main.col >= 20 && main.col <= 25 {
            true -> display_mark(main)
            _ -> display_error(main)
        }
    }
    state display_error(main: &mut Main) {
        transition main.error > 0 && main.row >= 4 && main.row <= 10 && main.col >= 6 && main.col <= 14 {
            true -> display_mark(main)
            _ -> write_pixel_guard(main)
        }
    }
    state display_mark(main: &mut Main) {
        main.px = 16759616;
        transition { _ -> write_pixel_guard(main) }
    }
    state display_digit_slot(main: &mut Main) {
        main.local_x = (main.col - 28) % 8;
        main.local_y = main.row - 2;
