    }
    state display_digit_slot1(main: &mut Main) {
        transition main.col < 44 { true -> use_digit2(main) _ -> display_digit_slot2(main) }
    }
    state display_digit_slot2(main: &mut Main) {
        transition main.col < 52 { true -> use_digit1(main) _ -> use_digit0(main) }
    }
    state use_digit3(main: &mut Main) { main.draw_digit = main.digit3; transition { _ -> segment_a(main) } }
    state use_digit2(main: &mut Main) { main.draw_digit = main.digit2; transition { _ -> segment_a(main) } }
    state use_digit1(main: &mut Main) { main.draw_digit = main.digit1; transition { _ -> segment_a(main) } }
    state use_digit0(main: &mut Main) { main.draw_digit = main.digit0; transition { _ -> segment_a(main) } }

    state segment_a(main: &mut Main) {
        transition main.local_y == 0 && main.local_x >= 2 && main.local_x <= 5 {
            true -> segment_set_a(main)
            _ -> segment_b(main)
        }
    }
    state segment_set_a(main: &mut Main) { main.segment = 0; transition { _ -> segment_apply(main) } }
    state segment_b(main: &mut Main) {
        transition main.local_x == 6 && main.local_y >= 1 && main.local_y <= 4 {
            true -> segment_set_b(main)
            _ -> segment_c(main)
        }
    }
    state segment_set_b(main: &mut Main) { main.segment = 1; transition { _ -> segment_apply(main) } }
    state segment_c(main: &mut Main) {
        transition main.local_x == 6 && main.local_y >= 6 && main.local_y <= 9 {
