    state hit_memory_recall(main: &mut Main) { Main::memory_recall(main); transition { _ -> render_prepare(main) } }

    // Turn the current display value into sign + four decimal digits before
    // the framebuffer loop reads it.
    state render_prepare(main: &mut Main) {
        transition main.typing > 0 { true -> prepare_current(main) _ -> prepare_accumulator(main) }
    }
    state prepare_current(main: &mut Main) {
        main.display_value = main.current;
        transition { _ -> prepare_sign(main) }
    }
    state prepare_accumulator(main: &mut Main) {
        main.display_value = main.accumulator;
        transition { _ -> prepare_sign(main) }
    }
    state prepare_sign(main: &mut Main) {
        transition main.display_value < 0 { true -> prepare_negative(main) _ -> prepare_positive(main) }
    }
    state prepare_negative(main: &mut Main) {
        main.sign = 1;
        main.display_work = 0 - main.display_value;
        transition { _ -> prepare_digits(main) }
    }
    state prepare_positive(main: &mut Main) {
        main.sign = 0;
        main.display_work = main.display_value;
        transition { _ -> prepare_digits(main) }
    }
    state prepare_digits(main: &mut Main) {
        main.display_work = main.display_work % 10000;
        main.digit0 = main.display_work % 10;
        main.display_work = main.display_work / 10;
        main.digit1 = main.display_work % 10;
        main.display_work = main.display_work / 10;
        main.digit2 = main.display_work % 10;
        main.display_work = main.display_work / 10;
        main.digit3 = main.display_work % 10;
