// A persistent software-rendered windowed calculator.
//
// It deliberately combines the hardest currently-live Omega surfaces in one
// small app: a real Windows GUI window, per-frame message pumping, keyboard
// input through GetAsyncKeyState, a software framebuffer sent through
// StretchDIBits, bounded render loops, calculator state, memory recall, and
// explicit state-machine dispatch for every interaction.
//
// Keyboard:
//   digits 0-9, numpad + - * /, Enter or =, Backspace, C, S for sign, M memory add,
//   R memory recall, Escape to close.
// GUI-subsystem app: the console surface is exit + a status line for terminal
// runs (invisible from Finder). No stdin — a windowed app must never block on
// a console.
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::binding;
use omega::language::core::float_operations;
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }
pub boundary trait Input { machine key_state(virtual_key: u32) -> u64 invokes CoreGraphics; }
pub boundary trait Gui {
    machine window_create(&mut self, class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
        invokes ObjectiveC; invokes CoreGraphics;
    machine get_dc(&mut self, window: u64) -> u64;
    machine blit(&mut self, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        invokes ObjectiveC; invokes CoreGraphics;
    machine msg_peek(&mut self, message: [u64; 6]) -> u32 invokes ObjectiveC;
    machine msg_translate(&mut self, message: [u64; 6]) -> u32;
    machine msg_dispatch(&mut self, message: [u64; 6]) -> u64 invokes ObjectiveC;
    machine is_window(&mut self, window: u64) -> u32 invokes ObjectiveC;
    machine window_destroy(&mut self, window: u64) -> u32 invokes ObjectiveC;
    machine foreground_window(&mut self) -> u64 invokes ObjectiveC;
}

// The selected macOS provider closure: each provider owns the GUI scratch
// state directly (an adapter over a nested `inner` impl receiver mis-settles
// the retained write frame) and satisfies its sample boundary nominally —
// matching method names cannot establish satisfaction.
data CalcGuiProvider {
    // The current window + its image-view content (single-window apps).
    window: u64;
    view: u64;
    app: u64;
    // A device-RGB colorspace, created once at window_create and reused per blit.
    space: u64;
    // Staged blit dimensions (a host-call arg must be a storage place / literal,
    // not a live conversion expression, so the i64/f64 results land in fields).
    fbw: i64;
    fbh: i64;
    stride: i64;
    fbwf: f64;
    fbhf: f64;
    // Pump scratch, built ONCE at window_create (msg_peek used to rebuild the
    // date/mode/selector EVERY call, leaking an NSString per peek): the
    // distantPast date, the run-loop-mode NSString, the nextEvent selector,
    // the event mask, and the last dequeued NSEvent.
    date: u64;
    mode: u64;
    psel: u64;
    mask: u64;
    evt: u64;
    // Cached per-frame selectors (registered once at window_create): release,
    // sendEvent:, isVisible, keyWindow.
    relsel: u64;
    dsel: u64;
    vsel: u64;
    ksel: u64;
    // The rolling autorelease pool: opened at window_create, cycled by every
    // msg_peek (pop drains the previous peek's autoreleased NSEvent after its
    // dispatch; push opens the scope for the next one).
    pool: u64;
    // Scratch for the objc call sequences.
    cls: u64;
    sel: u64;
    tmp: u64;
    ctx: u64;
    cgimg: u64;
    nsimg: u64;
    rx: f64;
    ry: f64;
    rw: f64;
    rh: f64;
    rc: u64;
    r32: u32;}
macos_arm64 machine CalcGuiProvider::provider_defaults(defaults: &mut CalcGuiProvider) {
    defaults.select_provider<Gui, CalcGuiProvider>();
}
macos_arm64 machine CalcGuiProvider::window_create(calc_gui_provider: &mut CalcGuiProvider, class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64 satisfies Gui::window_create
reaches CoreGraphics + ObjectiveC
{
    calc_gui_provider.rx = F64::from_i32(x);
    calc_gui_provider.ry = F64::from_i32(y);
    calc_gui_provider.rw = F64::from_i32(width);
    calc_gui_provider.rh = F64::from_i32(height);
    calc_gui_provider.rw = calc_gui_provider.rw - 16.0;
    calc_gui_provider.rh = calc_gui_provider.rh - 39.0;
    let cbuf1: [u8; 14] = "NSApplication\0";
    calc_gui_provider.cls = objc_get_class(&cbuf1[0]);
    let cbuf2: [u8; 18] = "sharedApplication\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf2[0]);
    calc_gui_provider.app = objc_send(calc_gui_provider.cls, calc_gui_provider.sel);
    let cbuf3: [u8; 21] = "setActivationPolicy:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf3[0]);
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.app, calc_gui_provider.sel, 0);
    let cbuf4: [u8; 9] = "NSWindow\0";
    calc_gui_provider.cls = objc_get_class(&cbuf4[0]);
    let cbuf5: [u8; 6] = "alloc\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf5[0]);
    calc_gui_provider.tmp = objc_send(calc_gui_provider.cls, calc_gui_provider.sel);
    let cbuf6: [u8; 45] = "initWithContentRect:styleMask:backing:defer:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf6[0]);
    calc_gui_provider.window = objc_send_rect(calc_gui_provider.tmp, calc_gui_provider.sel, calc_gui_provider.rx, calc_gui_provider.ry, calc_gui_provider.rw, calc_gui_provider.rh, 15, 2, 0);
    let cbuf7: [u8; 12] = "NSImageView\0";
    calc_gui_provider.cls = objc_get_class(&cbuf7[0]);
    let cbuf8: [u8; 6] = "alloc\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf8[0]);
    calc_gui_provider.tmp = objc_send(calc_gui_provider.cls, calc_gui_provider.sel);
    let cbuf9: [u8; 15] = "initWithFrame:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf9[0]);
    calc_gui_provider.view = objc_send_rect(calc_gui_provider.tmp, calc_gui_provider.sel, calc_gui_provider.rx, calc_gui_provider.ry, calc_gui_provider.rw, calc_gui_provider.rh, 0, 0, 0);
    let cbuf10: [u8; 17] = "setImageScaling:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf10[0]);
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.view, calc_gui_provider.sel, 1);
    let cbuf11: [u8; 16] = "setContentView:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf11[0]);
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.window, calc_gui_provider.sel, calc_gui_provider.view);
    let cbuf12: [u8; 8] = "release\0";
    calc_gui_provider.relsel = objc_register_selector(&cbuf12[0]);
    let cbuf13: [u8; 9] = "NSString\0";
    calc_gui_provider.cls = objc_get_class(&cbuf13[0]);
    let cbuf14: [u8; 6] = "alloc\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf14[0]);
    calc_gui_provider.tmp = objc_send(calc_gui_provider.cls, calc_gui_provider.sel);
    let cbuf15: [u8; 20] = "initWithUTF8String:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf15[0]);
    calc_gui_provider.tmp = objc_send_byte_string(calc_gui_provider.tmp, calc_gui_provider.sel, &title[0]);
    let cbuf16: [u8; 10] = "setTitle:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf16[0]);
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.window, calc_gui_provider.sel, calc_gui_provider.tmp);
    calc_gui_provider.rc = objc_send(calc_gui_provider.tmp, calc_gui_provider.relsel);
    let cbuf17: [u8; 7] = "center\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf17[0]);
    calc_gui_provider.rc = objc_send(calc_gui_provider.window, calc_gui_provider.sel);
    let cbuf18: [u8; 22] = "makeKeyAndOrderFront:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf18[0]);
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.window, calc_gui_provider.sel, 0);
    let cbuf19: [u8; 27] = "activateIgnoringOtherApps:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf19[0]);
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.app, calc_gui_provider.sel, 1);
    calc_gui_provider.space = cg_color_space_rgb();
    // Pump scratch, once: the distantPast date, the run-loop-mode NSString, the
    // nextEvent/sendEvent:/isVisible/keyWindow selectors, and the event mask.
    let cbuf20: [u8; 7] = "NSDate\0";
    calc_gui_provider.cls = objc_get_class(&cbuf20[0]);
    let cbuf21: [u8; 12] = "distantPast\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf21[0]);
    calc_gui_provider.date = objc_send(calc_gui_provider.cls, calc_gui_provider.sel);
    let cbuf22: [u8; 9] = "NSString\0";
    calc_gui_provider.cls = objc_get_class(&cbuf22[0]);
    let cbuf23: [u8; 6] = "alloc\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf23[0]);
    calc_gui_provider.tmp = objc_send(calc_gui_provider.cls, calc_gui_provider.sel);
    let cbuf24: [u8; 20] = "initWithUTF8String:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf24[0]);
    let cbuf25: [u8; 22] = "kCFRunLoopDefaultMode\0";
    calc_gui_provider.mode = objc_send_string(calc_gui_provider.tmp, calc_gui_provider.sel, &cbuf25[0]);
    let cbuf26: [u8; 48] = "nextEventMatchingMask:untilDate:inMode:dequeue:\0";
    calc_gui_provider.psel = objc_register_selector(&cbuf26[0]);
    calc_gui_provider.mask = 4294967295;
    let cbuf27: [u8; 11] = "sendEvent:\0";
    calc_gui_provider.dsel = objc_register_selector(&cbuf27[0]);
    let cbuf28: [u8; 10] = "isVisible\0";
    calc_gui_provider.vsel = objc_register_selector(&cbuf28[0]);
    let cbuf29: [u8; 10] = "keyWindow\0";
    calc_gui_provider.ksel = objc_register_selector(&cbuf29[0]);
    // Open the rolling autorelease pool msg_peek cycles (never popped at exit
    // on purpose: a later peek after a final pop would pop a dead token, and
    // process exit reclaims everything anyway).
    calc_gui_provider.pool = objc_pool_push();
    transition { _ -> ret(calc_gui_provider) }
    state ret(calc_gui_provider: &mut CalcGuiProvider) -> u64 { calc_gui_provider.window }
}
macos_arm64 machine CalcGuiProvider::get_dc(calc_gui_provider: &mut CalcGuiProvider, window: u64) -> u64  satisfies Gui::get_dc
{
    transition { _ -> ret(window) }
    state ret(window: u64) -> u64 { window }
}
macos_arm64 machine CalcGuiProvider::blit(calc_gui_provider: &mut CalcGuiProvider, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32 satisfies Gui::blit
reaches CoreGraphics + ObjectiveC
{
    let source_width_wide: i64 = source_width as i64;
    let source_height_wide: i64 = source_height as i64;
    calc_gui_provider.fbw = source_width_wide;
    calc_gui_provider.fbh = source_height_wide;
    calc_gui_provider.stride = source_width_wide << 2;
    calc_gui_provider.fbwf = F64::from_u32(source_width);
    calc_gui_provider.fbhf = F64::from_u32(source_height);
    calc_gui_provider.ctx = cg_bitmap_context(&pixels[0], calc_gui_provider.fbw, calc_gui_provider.fbh, 8, calc_gui_provider.stride, calc_gui_provider.space, 8198);
    calc_gui_provider.cgimg = cg_bitmap_context_image(calc_gui_provider.ctx);
    let cbuf30: [u8; 8] = "NSImage\0";
    calc_gui_provider.cls = objc_get_class(&cbuf30[0]);
    let cbuf31: [u8; 6] = "alloc\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf31[0]);
    calc_gui_provider.tmp = objc_send(calc_gui_provider.cls, calc_gui_provider.sel);
    let cbuf32: [u8; 22] = "initWithCGImage:size:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf32[0]);
    calc_gui_provider.nsimg = objc_send_image_size(calc_gui_provider.tmp, calc_gui_provider.sel, calc_gui_provider.cgimg, calc_gui_provider.fbwf, calc_gui_provider.fbhf);
    let cbuf33: [u8; 10] = "setImage:\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf33[0]);
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.view, calc_gui_provider.sel, calc_gui_provider.nsimg);
    // Per-frame lifecycle: the context and CGImage are Create-rule owned, and
    // setImage: retains the NSImage, so drop our +1 on all three — without
    // these releases every presented frame leaked ~3 objects at ~60fps.
    calc_gui_provider.rc = cg_context_release(calc_gui_provider.ctx);
    calc_gui_provider.rc = cg_image_release(calc_gui_provider.cgimg);
    calc_gui_provider.rc = objc_send(calc_gui_provider.nsimg, calc_gui_provider.relsel);
    // The samples assert `blit == source_height` (every source scanline copied).
    calc_gui_provider.r32 = source_height;
    transition { _ -> ret(calc_gui_provider) }
    state ret(calc_gui_provider: &mut CalcGuiProvider) -> u32 { calc_gui_provider.r32 }
}
macos_arm64 machine CalcGuiProvider::msg_peek(calc_gui_provider: &mut CalcGuiProvider, message: [u64; 6]) -> u32 satisfies Gui::msg_peek
reaches ObjectiveC
{
    // Cycle the rolling autorelease pool opened at window_create: the pop
    // drains the PREVIOUS peek's autoreleased NSEvent (already dispatched by
    // then), the push opens the scope this peek's event lands in. The date,
    // mode string, selector, and mask are window_create-cached — this machine
    // used to rebuild all four (and leak the NSString) on every single peek.
    calc_gui_provider.rc = objc_pool_pop(calc_gui_provider.pool);
    calc_gui_provider.pool = objc_pool_push();
    calc_gui_provider.evt = objc_send_scalar4(calc_gui_provider.app, calc_gui_provider.psel, calc_gui_provider.mask, calc_gui_provider.date, calc_gui_provider.mode, 1);
    // Arm states must stay side-effect-free (the value-call effect fence):
    // both arms complete with a pure terminal value instead of mutating r32.
    transition calc_gui_provider.evt != 0 { true -> got() _ -> ret() }
    state got() -> u32 { 1 }
    state ret() -> u32 { 0 }
}
macos_arm64 machine CalcGuiProvider::msg_translate(calc_gui_provider: &mut CalcGuiProvider, message: [u64; 6]) -> u32  satisfies Gui::msg_translate
{
    calc_gui_provider.r32 = 1;
    transition { _ -> ret(calc_gui_provider) }
    state ret(calc_gui_provider: &mut CalcGuiProvider) -> u32 { calc_gui_provider.r32 }
}
macos_arm64 machine CalcGuiProvider::msg_dispatch(calc_gui_provider: &mut CalcGuiProvider, message: [u64; 6]) -> u64 satisfies Gui::msg_dispatch
reaches ObjectiveC
{
    calc_gui_provider.rc = objc_send_scalar(calc_gui_provider.app, calc_gui_provider.dsel, calc_gui_provider.evt);
    transition { _ -> ret(calc_gui_provider) }
    state ret(calc_gui_provider: &mut CalcGuiProvider) -> u64 { calc_gui_provider.rc }
}
macos_arm64 machine CalcGuiProvider::is_window(calc_gui_provider: &mut CalcGuiProvider, window: u64) -> u32 satisfies Gui::is_window
reaches ObjectiveC
{
    calc_gui_provider.rc = objc_send(window, calc_gui_provider.vsel);
    calc_gui_provider.r32 = narrow_u64_to_u32_wrapping(calc_gui_provider.rc);
    transition { _ -> ret(calc_gui_provider) }
    state ret(calc_gui_provider: &mut CalcGuiProvider) -> u32 { calc_gui_provider.r32 }
}
macos_arm64 machine CalcGuiProvider::window_destroy(calc_gui_provider: &mut CalcGuiProvider, window: u64) -> u32 satisfies Gui::window_destroy
reaches ObjectiveC
{
    let cbuf34: [u8; 6] = "close\0";
    calc_gui_provider.sel = objc_register_selector(&cbuf34[0]);
    calc_gui_provider.rc = objc_send_scalar(window, calc_gui_provider.sel, 0);
    calc_gui_provider.r32 = 1;
    transition { _ -> ret(calc_gui_provider) }
    state ret(calc_gui_provider: &mut CalcGuiProvider) -> u32 { calc_gui_provider.r32 }
}
macos_arm64 machine CalcGuiProvider::foreground_window(calc_gui_provider: &mut CalcGuiProvider) -> u64 satisfies Gui::foreground_window
reaches ObjectiveC
{
    calc_gui_provider.rc = objc_send(calc_gui_provider.app, calc_gui_provider.ksel);
    transition { _ -> ret(calc_gui_provider) }
    state ret(calc_gui_provider: &mut CalcGuiProvider) -> u64 { calc_gui_provider.rc }
}

data CalcInputProvider { }
macos_arm64 machine CalcInputProvider::provider_defaults(defaults: &mut CalcInputProvider) {
    defaults.select_provider<Input, CalcInputProvider>();
}
macos_arm64 machine CalcInputProvider::key_state(virtual_key: u32) -> u64 satisfies Input::key_state
reaches CoreGraphics
{
    let keycode: u64 = CalcInputProvider::map_keycode(virtual_key);
    let rc: u64 = cg_event_source_key_state(1, keycode);
    transition keycode == 65535 { true -> not_down() _ -> ret(rc) }
    state not_down() -> u64 { 0 }
    state ret(rc: u64) -> u64 { rc }
}
macos_arm64 machine CalcInputProvider::map_keycode(virtual_key: u32) -> u64 
{
    transition virtual_key == 8 { true -> k51() _ -> t13(virtual_key) }
    state t13(virtual_key: u32) -> u64 { transition virtual_key == 13 { true -> k36() _ -> t27(virtual_key) } }
    state t27(virtual_key: u32) -> u64 { transition virtual_key == 27 { true -> k53() _ -> t37(virtual_key) } }
    state t37(virtual_key: u32) -> u64 { transition virtual_key == 37 { true -> k123() _ -> t38(virtual_key) } }
    state t38(virtual_key: u32) -> u64 { transition virtual_key == 38 { true -> k126() _ -> t39(virtual_key) } }
    state t39(virtual_key: u32) -> u64 { transition virtual_key == 39 { true -> k124() _ -> t40(virtual_key) } }
    state t40(virtual_key: u32) -> u64 { transition virtual_key == 40 { true -> k125() _ -> t48(virtual_key) } }
    state t48(virtual_key: u32) -> u64 { transition virtual_key == 48 { true -> k29() _ -> t49(virtual_key) } }
    state t49(virtual_key: u32) -> u64 { transition virtual_key == 49 { true -> k18() _ -> t50(virtual_key) } }
    state t50(virtual_key: u32) -> u64 { transition virtual_key == 50 { true -> k19() _ -> t51(virtual_key) } }
    state t51(virtual_key: u32) -> u64 { transition virtual_key == 51 { true -> k20() _ -> t52(virtual_key) } }
    state t52(virtual_key: u32) -> u64 { transition virtual_key == 52 { true -> k21() _ -> t53(virtual_key) } }
    state t53(virtual_key: u32) -> u64 { transition virtual_key == 53 { true -> k23() _ -> t54(virtual_key) } }
    state t54(virtual_key: u32) -> u64 { transition virtual_key == 54 { true -> k22() _ -> t55(virtual_key) } }
    state t55(virtual_key: u32) -> u64 { transition virtual_key == 55 { true -> k26() _ -> t56(virtual_key) } }
    state t56(virtual_key: u32) -> u64 { transition virtual_key == 56 { true -> k28() _ -> t57(virtual_key) } }
    state t57(virtual_key: u32) -> u64 { transition virtual_key == 57 { true -> k25() _ -> t67(virtual_key) } }
    state t67(virtual_key: u32) -> u64 { transition virtual_key == 67 { true -> k8() _ -> t77(virtual_key) } }
    state t77(virtual_key: u32) -> u64 { transition virtual_key == 77 { true -> k46() _ -> t82(virtual_key) } }
    state t82(virtual_key: u32) -> u64 { transition virtual_key == 82 { true -> k15() _ -> t83(virtual_key) } }
    state t83(virtual_key: u32) -> u64 { transition virtual_key == 83 { true -> k1() _ -> t106(virtual_key) } }
    state t106(virtual_key: u32) -> u64 { transition virtual_key == 106 { true -> k67() _ -> t107(virtual_key) } }
    state t107(virtual_key: u32) -> u64 { transition virtual_key == 107 { true -> k69() _ -> t109(virtual_key) } }
    state t109(virtual_key: u32) -> u64 { transition virtual_key == 109 { true -> k78() _ -> t111(virtual_key) } }
    state t111(virtual_key: u32) -> u64 { transition virtual_key == 111 { true -> k75() _ -> t187(virtual_key) } }
    state t187(virtual_key: u32) -> u64 { transition virtual_key == 187 { true -> k24() _ -> unmapped() } }
    state k1() -> u64 { 1 }
    state k8() -> u64 { 8 }
    state k15() -> u64 { 15 }
    state k18() -> u64 { 18 }
    state k19() -> u64 { 19 }
    state k20() -> u64 { 20 }
    state k21() -> u64 { 21 }
    state k22() -> u64 { 22 }
    state k23() -> u64 { 23 }
    state k24() -> u64 { 24 }
    state k25() -> u64 { 25 }
    state k26() -> u64 { 26 }
    state k28() -> u64 { 28 }
    state k29() -> u64 { 29 }
    state k36() -> u64 { 36 }
    state k46() -> u64 { 46 }
    state k51() -> u64 { 51 }
    state k53() -> u64 { 53 }
    state k67() -> u64 { 67 }
    state k69() -> u64 { 69 }
    state k75() -> u64 { 75 }
    state k78() -> u64 { 78 }
    state k123() -> u64 { 123 }
    state k124() -> u64 { 124 }
    state k125() -> u64 { 125 }
    state k126() -> u64 { 126 }
    state unmapped() -> u64 { 65535 }
}

data CalcClockProvider { }
macos_arm64 machine CalcClockProvider::provider_defaults(defaults: &mut CalcClockProvider) {
    defaults.select_provider<Clock, CalcClockProvider>();
}
macos_arm64 machine CalcClockProvider::sleep(milliseconds: u32) satisfies Clock::sleep
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    input: Binding<Input>;
    gui: Binding<Gui>;

    cls: [u8; 7];
    title: [u8; 11];
    message: [u64; 6];
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    copied: u32;
    have: u32;
    translated: u32;
    dispatched: u64;
    msg_code: u64;
    alive: u32;
    killed: u32;
    key: u64;
    fw: u64;
    pumped: i32;
    frame: i32;
    i: i32;

    // Calculator model. Arithmetic is explicit Saturating arithmetic so this
    // sample can focus on UI/state pressure instead of proving arbitrary user
    // input cannot overflow.
    current: i32 in Saturating;
    accumulator: i32 in Saturating;
    memory: i32 in Saturating;
    pending: i32; // 0 none, 1 add, 2 subtract, 3 multiply, 4 divide
    typing: u32;
    error: u32;
    cooldown: i32;
    last_key: i32;

    // Render scratch.
    row: i32;
    col: i32;
    px: i32;
    display_value: i32 in Saturating;
    display_work: i32 in Saturating;
    sign: u32;
    digit0: i32 in Saturating;
    digit1: i32 in Saturating;
    digit2: i32 in Saturating;
    digit3: i32 in Saturating;
    draw_digit: i32 in Saturating;
    segment: i32;
    local_x: i32;
    local_y: i32;
    button_row: i32;
    button_col: i32;
    button_code: i32;
    button_lx: i32;
    button_ly: i32;
    shade: i32;
}

machine Main::main(main: &mut Main) reaches Clock + Console + CoreGraphics + DarwinClock + Gui + Input + ObjectiveC {
    // "#32770\0" -- the predefined dialog class. The earlier window samples
    // used "STATIC\0", but that is a control class and does not behave like a
    // real top-level app window in practice.
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;

    // "omega calculator\0"
    // "omega calc\0" -- shortened to the wrapper's 11-byte title shape.
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 99;
    main.title[7] = 97;
    main.title[8] = 108;
    main.title[9] = 99;
    main.title[10] = 0;

    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;

    main.current = 0;
    main.accumulator = 0;
    main.memory = 0;
    main.pending = 0;
    main.typing = 1;
    main.error = 0;
    main.cooldown = 0;
    main.last_key = 31;
    main.frame = 0;

    // WS_VISIBLE|WS_OVERLAPPEDWINDOW; client is approximately 512x512.
    main.hwnd = main.gui.window_create(main.cls, main.title, 282001408, 160, 120, 528, 551);
    transition main.hwnd > 0 { true -> dc(main) _ -> bad(main) }

    state dc(main: &mut Main) {
        main.hdc = main.gui.get_dc(main.hwnd);
        transition main.hdc > 0 { true -> frame_loop(main) _ -> bad(main) }
    }

    state frame_loop(main: &mut Main) {
        transition main.frame < 16384 { true -> pump_init(main) _ -> wrap_frame(main) }
    }
    state wrap_frame(main: &mut Main) { main.frame = 0; transition { _ -> pump_init(main) } }

    // Drain at most 16 messages so the title bar, move loop, and close button stay alive.
    state pump_init(main: &mut Main) { main.pumped = 0; transition { _ -> pump_loop(main) } }
    state pump_loop(main: &mut Main) {
        main.have = main.gui.msg_peek(main.message);
        transition main.have > 0 { true -> pump_check_close(main) _ -> liveness(main) }
    }
    state pump_check_close(main: &mut Main) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main) _ -> pump_check_xdown(main) }
    }
    // The X button arrives as posted WM_NCLBUTTONDOWN (161) with wParam
    // HTCLOSE (20) -- the #32770 dialog proc never turns it into a close, so
    // the pump does. Other non-client presses (caption drag) dispatch normally.
    state pump_check_xdown(main: &mut Main) {
        transition main.msg_code == 161 { true -> pump_check_xhit(main) _ -> pump_check_syscommand(main) }
    }
    state pump_check_xhit(main: &mut Main) {
        transition main.message[2] == 20 { true -> quit_self(main) _ -> pump_handle(main) }
    }
    state pump_check_syscommand(main: &mut Main) {
        transition main.msg_code == 274 { true -> pump_check_sysclose(main) _ -> pump_handle(main) }
    }
    state pump_check_sysclose(main: &mut Main) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main) _ -> pump_handle(main) }
    }
    state pump_handle(main: &mut Main) {
        main.translated = main.gui.msg_translate(main.message);
        main.dispatched = main.gui.msg_dispatch(main.message);
        transition main.pumped < 16 { true -> pump_next(main) _ -> liveness(main) }
    }
    state pump_next(main: &mut Main) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main) }
    }

    state liveness(main: &mut Main) {
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> focus_check(main) _ -> closed(main) }
    }

    // GetAsyncKeyState is GLOBAL: without this gate, typing digits (or ESC --
    // even the Ctrl+Shift+Esc chord) in ANY app would drive this calculator.
    state focus_check(main: &mut Main) {
