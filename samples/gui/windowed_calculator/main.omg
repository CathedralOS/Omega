use omega_language_std::math;

// A persistent software-rendered windowed calculator.
//
// It deliberately combines the hardest currently-live Omega surfaces in one
// small app: a native GUI window, per-frame message pumping, keyboard input,
// a software framebuffer, bounded render loops, calculator state, memory recall, and
// explicit state-machine dispatch for every interaction.
//
// Keyboard:
//   digits 0-9, numpad + - * /, Enter or =, Backspace, C, S for sign, M memory add,
//   R memory recall, Escape to close.
// GUI-subsystem app: the console surface is exit + a status line for terminal
// runs (invisible from Finder). No stdin — a windowed app must never block on
// a console.
use omega_language_std::console;
use omega_language_std::macos_gui;
// These requirements expose the shared macos_gui operations' service rows.
// Direct-invocation declarations are separate; they do not supply a reach ceiling.
pub boundary trait Clock {
    machine sleep(milliseconds: u32) reaches DarwinClock invokes DarwinClock;
}
pub boundary trait Input {
    machine key_state(virtual_key: u32) -> u64 reaches CoreGraphics invokes CoreGraphics;
}
pub boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: &u8, style: u32, x: i32, y: i32, width: i32, height: i32) -> Window
        reaches AppKit + CoreGraphics + ObjectiveC
        invokes ObjectiveC; invokes CoreGraphics; invokes AppKit;
    machine window_destroy(window: Window) reaches CoreGraphics + ObjectiveC invokes ObjectiveC; invokes CoreGraphics;
    machine get_dc(window_state: &Window, window: u64) -> u64;
    machine blit(window_state: &Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        reaches CoreGraphics + ObjectiveC
        invokes ObjectiveC; invokes CoreGraphics;
    machine msg_peek(window_state: &mut Window, message: [u64; 6]) -> u32 reaches ObjectiveC invokes ObjectiveC;
    machine msg_translate(window_state: &Window, message: [u64; 6]) -> u32;
    machine msg_dispatch(window_state: &Window, message: [u64; 6]) -> u64 reaches ObjectiveC invokes ObjectiveC;
    machine is_window(window_state: &Window, window: u64) -> u32 reaches ObjectiveC invokes ObjectiveC;
    machine foreground_window(window_state: &Window) -> u64 reaches ObjectiveC invokes ObjectiveC;
}

// Selection supplies code. The application carries its window as an owned
// state argument, borrowing it for observations and the event pump.
CalcGuiProvider satisfies Gui {
    Gui::window_create = macos_window_create;
    Gui::window_destroy = macos_window_destroy;
    Gui::get_dc = macos_window_get_dc;
    Gui::blit = macos_window_blit;
    Gui::msg_peek = macos_window_msg_peek;
    Gui::msg_translate = macos_window_msg_translate;
    Gui::msg_dispatch = macos_window_msg_dispatch;
    Gui::is_window = macos_window_is_window;
    Gui::foreground_window = macos_window_foreground_window;
}
CalcInputProvider satisfies Input {
    Input::key_state = macos_key_state;
}
CalcClockProvider satisfies Clock {
    Clock::sleep = macos_sleep;
}

data Main {

    cls: [u8; 7];
    title: [u8; 11];
    message: [u64; 6];
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    copied: u32;
    have: u32;
    translated: u32;
    dispatched: u64;
    msg_code: u64;
    alive: u32;
    key: u64;
    fw: u64;
    pumped: i32;
    frame: i32;
    i: i32;

    // Calculator model. Arithmetic is explicit Saturating arithmetic so this
    // sample can focus on UI/state pressure instead of proving arbitrary user
    // input cannot overflow.
    current: i32 in Saturating;
    accumulator: i32 in Saturating;
    memory: i32 in Saturating;
    pending: i32; // 0 none, 1 add, 2 subtract, 3 multiply, 4 divide
    typing: u32;
    error: u32;
    cooldown: i32;
    last_key: i32;

    // Render scratch.
    row: i32;
    col: i32;
    px: i32;
    display_value: i32 in Saturating;
    display_work: i32 in Saturating;
    sign: u32;
    digit0: i32 in Saturating;
    digit1: i32 in Saturating;
    digit2: i32 in Saturating;
    digit3: i32 in Saturating;
    draw_digit: i32 in Saturating;
    segment: i32;
    local_x: i32;
    local_y: i32;
    button_row: i32;
    button_col: i32;
    button_code: i32;
    button_lx: i32;
    button_ly: i32;
    shade: i32;
}

machine Main::main(main: &mut Main) reaches AppKit + Clock + Console + CoreGraphics + DarwinClock + Gui + Input + ObjectiveC {
    // "#32770\0" -- the predefined dialog class. The earlier window samples
    // used "STATIC\0", but that is a control class and does not behave like a
    // real top-level app window in practice.
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;

    // "omega calculator\0"
    // "omega calc\0" -- shortened to the wrapper's 11-byte title shape.
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 99;
    main.title[7] = 97;
    main.title[8] = 108;
    main.title[9] = 99;
    main.title[10] = 0;

    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;

    main.current = 0;
    main.accumulator = 0;
    main.memory = 0;
    main.pending = 0;
    main.typing = 1;
    main.error = 0;
    main.cooldown = 0;
    main.last_key = 31;
    main.frame = 0;

    // WS_VISIBLE|WS_OVERLAPPEDWINDOW; client is approximately 512x512.
    let window: Window = Gui::window_create(main.cls, &main.title[0], 282001408, 160, 120, 528, 551);
    main.hwnd = window.window;
    transition main.hwnd > 0 { true -> dc(main, window) _ -> bad(main, window) }

    state dc(main: &mut Main, window: Window) {
        main.hdc = Gui::get_dc(&window, main.hwnd);
        transition main.hdc > 0 { true -> frame_loop(main, window) _ -> bad(main, window) }
    }

    state frame_loop(main: &mut Main, window: Window) {
        transition main.frame < 16384 { true -> pump_init(main, window) _ -> wrap_frame(main, window) }
    }
    state wrap_frame(main: &mut Main, window: Window) { main.frame = 0; transition { _ -> pump_init(main, window) } }

    // Drain at most 16 messages so the title bar, move loop, and close button stay alive.
    state pump_init(main: &mut Main, window: Window) { main.pumped = 0; transition { _ -> pump_loop(main, window) } }
    state pump_loop(main: &mut Main, mut window: Window) {
        main.have = Gui::msg_peek(&mut window, main.message);
        transition main.have > 0 { true -> pump_check_close(main, window) _ -> liveness(main, window) }
    }
    state pump_check_close(main: &mut Main, window: Window) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main, window) _ -> pump_check_xdown(main, window) }
    }
    // The X button arrives as posted WM_NCLBUTTONDOWN (161) with wParam
    // HTCLOSE (20) -- the #32770 dialog proc never turns it into a close, so
    // the pump does. Other non-client presses (caption drag) dispatch normally.
    state pump_check_xdown(main: &mut Main, window: Window) {
        transition main.msg_code == 161 { true -> pump_check_xhit(main, window) _ -> pump_check_syscommand(main, window) }
    }
    state pump_check_xhit(main: &mut Main, window: Window) {
        transition main.message[2] == 20 { true -> quit_self(main, window) _ -> pump_handle(main, window) }
    }
    state pump_check_syscommand(main: &mut Main, window: Window) {
        transition main.msg_code == 274 { true -> pump_check_sysclose(main, window) _ -> pump_handle(main, window) }
    }
    state pump_check_sysclose(main: &mut Main, window: Window) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main, window) _ -> pump_handle(main, window) }
    }
    state pump_handle(main: &mut Main, window: Window) {
        main.translated = Gui::msg_translate(&window, main.message);
        main.dispatched = Gui::msg_dispatch(&window, main.message);
        transition main.pumped < 16 { true -> pump_next(main, window) _ -> liveness(main, window) }
    }
    state pump_next(main: &mut Main, window: Window) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main, window) }
    }

    state liveness(main: &mut Main, window: Window) {
        main.alive = Gui::is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> focus_check(main, window) _ -> closed(main, window) }
    }

    // Key-state polling is global: without this gate, typing digits (or ESC --
    // even the Ctrl+Shift+Esc chord) in ANY app would drive this calculator.
    state focus_check(main: &mut Main, window: Window) {
        main.fw = Gui::foreground_window(&window);
        transition main.fw == main.hwnd { true -> input_escape(main, window) _ -> render_prepare(main, window) }
    }

    // Input is deliberately serialized: one accepted key per frame, with a
    // short repeat cooldown. This makes held keys visible but controlled.
    state input_escape(main: &mut Main, window: Window) {
        main.key = Input::key_state(27);
        transition main.key > 0 { true -> quit_self(main, window) _ -> input_cooldown(main, window) }
    }
    state input_cooldown(main: &mut Main, window: Window) {
        transition main.cooldown > 0 { true -> input_cooldown_step(main, window) _ -> input_clear_key(main, window) }
    }
    state input_cooldown_step(main: &mut Main, window: Window) {
        main.cooldown = main.cooldown - 1;
        transition { _ -> render_prepare(main, window) }
    }
    state input_clear_key(main: &mut Main, window: Window) {
        main.last_key = 31;
        transition { _ -> poll_clear(main, window) }
    }
    state poll_clear(main: &mut Main, window: Window) {
        main.key = Input::key_state(67);
        transition main.key > 0 { true -> hit_clear(main, window) _ -> poll_backspace(main, window) }
    }
    state poll_backspace(main: &mut Main, window: Window) {
        main.key = Input::key_state(8);
        transition main.key > 0 { true -> hit_backspace(main, window) _ -> poll_enter(main, window) }
    }
    state poll_enter(main: &mut Main, window: Window) {
        main.key = Input::key_state(13);
        transition main.key > 0 { true -> hit_equals(main, window) _ -> poll_equals_key(main, window) }
    }
    state poll_equals_key(main: &mut Main, window: Window) {
        main.key = Input::key_state(187);
        transition main.key > 0 { true -> hit_equals(main, window) _ -> poll_plus(main, window) }
    }
    state poll_plus(main: &mut Main, window: Window) {
        main.key = Input::key_state(107);
        transition main.key > 0 { true -> hit_plus(main, window) _ -> poll_minus(main, window) }
    }
    state poll_minus(main: &mut Main, window: Window) {
        main.key = Input::key_state(109);
        transition main.key > 0 { true -> hit_minus(main, window) _ -> poll_multiply(main, window) }
    }
    state poll_multiply(main: &mut Main, window: Window) {
        main.key = Input::key_state(106);
        transition main.key > 0 { true -> hit_multiply(main, window) _ -> poll_divide(main, window) }
    }
    state poll_divide(main: &mut Main, window: Window) {
        main.key = Input::key_state(111);
        transition main.key > 0 { true -> hit_divide(main, window) _ -> poll_sign(main, window) }
    }
    state poll_sign(main: &mut Main, window: Window) {
        main.key = Input::key_state(83);
        transition main.key > 0 { true -> hit_sign(main, window) _ -> poll_memory_add(main, window) }
    }
    state poll_memory_add(main: &mut Main, window: Window) {
        main.key = Input::key_state(77);
        transition main.key > 0 { true -> hit_memory_add(main, window) _ -> poll_memory_recall(main, window) }
    }
    state poll_memory_recall(main: &mut Main, window: Window) {
        main.key = Input::key_state(82);
        transition main.key > 0 { true -> hit_memory_recall(main, window) _ -> poll_digit0(main, window) }
    }
    state poll_digit0(main: &mut Main, window: Window) {
        main.key = Input::key_state(48);
        transition main.key > 0 { true -> hit_digit0(main, window) _ -> poll_digit1(main, window) }
    }
    state poll_digit1(main: &mut Main, window: Window) {
        main.key = Input::key_state(49);
        transition main.key > 0 { true -> hit_digit1(main, window) _ -> poll_digit2(main, window) }
    }
    state poll_digit2(main: &mut Main, window: Window) {
        main.key = Input::key_state(50);
        transition main.key > 0 { true -> hit_digit2(main, window) _ -> poll_digit3(main, window) }
    }
    state poll_digit3(main: &mut Main, window: Window) {
        main.key = Input::key_state(51);
        transition main.key > 0 { true -> hit_digit3(main, window) _ -> poll_digit4(main, window) }
    }
    state poll_digit4(main: &mut Main, window: Window) {
        main.key = Input::key_state(52);
        transition main.key > 0 { true -> hit_digit4(main, window) _ -> poll_digit5(main, window) }
    }
    state poll_digit5(main: &mut Main, window: Window) {
        main.key = Input::key_state(53);
        transition main.key > 0 { true -> hit_digit5(main, window) _ -> poll_digit6(main, window) }
    }
    state poll_digit6(main: &mut Main, window: Window) {
        main.key = Input::key_state(54);
        transition main.key > 0 { true -> hit_digit6(main, window) _ -> poll_digit7(main, window) }
    }
    state poll_digit7(main: &mut Main, window: Window) {
        main.key = Input::key_state(55);
        transition main.key > 0 { true -> hit_digit7(main, window) _ -> poll_digit8(main, window) }
    }
    state poll_digit8(main: &mut Main, window: Window) {
        main.key = Input::key_state(56);
        transition main.key > 0 { true -> hit_digit8(main, window) _ -> poll_digit9(main, window) }
    }
    state poll_digit9(main: &mut Main, window: Window) {
        main.key = Input::key_state(57);
        transition main.key > 0 { true -> hit_digit9(main, window) _ -> render_prepare(main, window) }
    }

    state hit_digit0(main: &mut Main, window: Window) { Main::accept_digit(main, 0, 0); transition { _ -> render_prepare(main, window) } }
    state hit_digit1(main: &mut Main, window: Window) { Main::accept_digit(main, 1, 1); transition { _ -> render_prepare(main, window) } }
    state hit_digit2(main: &mut Main, window: Window) { Main::accept_digit(main, 2, 2); transition { _ -> render_prepare(main, window) } }
    state hit_digit3(main: &mut Main, window: Window) { Main::accept_digit(main, 3, 3); transition { _ -> render_prepare(main, window) } }
    state hit_digit4(main: &mut Main, window: Window) { Main::accept_digit(main, 4, 4); transition { _ -> render_prepare(main, window) } }
    state hit_digit5(main: &mut Main, window: Window) { Main::accept_digit(main, 5, 5); transition { _ -> render_prepare(main, window) } }
    state hit_digit6(main: &mut Main, window: Window) { Main::accept_digit(main, 6, 6); transition { _ -> render_prepare(main, window) } }
    state hit_digit7(main: &mut Main, window: Window) { Main::accept_digit(main, 7, 7); transition { _ -> render_prepare(main, window) } }
    state hit_digit8(main: &mut Main, window: Window) { Main::accept_digit(main, 8, 8); transition { _ -> render_prepare(main, window) } }
    state hit_digit9(main: &mut Main, window: Window) { Main::accept_digit(main, 9, 9); transition { _ -> render_prepare(main, window) } }
    state hit_plus(main: &mut Main, window: Window) { Main::accept_operator(main, 1, 11); transition { _ -> render_prepare(main, window) } }
    state hit_minus(main: &mut Main, window: Window) { Main::accept_operator(main, 2, 12); transition { _ -> render_prepare(main, window) } }
    state hit_multiply(main: &mut Main, window: Window) { Main::accept_operator(main, 3, 13); transition { _ -> render_prepare(main, window) } }
    state hit_divide(main: &mut Main, window: Window) { Main::accept_operator(main, 4, 14); transition { _ -> render_prepare(main, window) } }
    state hit_equals(main: &mut Main, window: Window) { Main::accept_equals(main); transition { _ -> render_prepare(main, window) } }
    state hit_clear(main: &mut Main, window: Window) { Main::clear_all(main, 22); transition { _ -> render_prepare(main, window) } }
    state hit_backspace(main: &mut Main, window: Window) { Main::backspace(main); transition { _ -> render_prepare(main, window) } }
    state hit_sign(main: &mut Main, window: Window) { Main::toggle_sign(main); transition { _ -> render_prepare(main, window) } }
    state hit_memory_add(main: &mut Main, window: Window) { Main::memory_add(main); transition { _ -> render_prepare(main, window) } }
    state hit_memory_recall(main: &mut Main, window: Window) { Main::memory_recall(main); transition { _ -> render_prepare(main, window) } }

    // Turn the current display value into sign + four decimal digits before
    // the framebuffer loop reads it.
    state render_prepare(main: &mut Main, window: Window) {
        transition main.typing > 0 { true -> prepare_current(main, window) _ -> prepare_accumulator(main, window) }
    }
    state prepare_current(main: &mut Main, window: Window) {
        main.display_value = main.current;
        transition { _ -> prepare_sign(main, window) }
    }
    state prepare_accumulator(main: &mut Main, window: Window) {
        main.display_value = main.accumulator;
        transition { _ -> prepare_sign(main, window) }
    }
    state prepare_sign(main: &mut Main, window: Window) {
        transition main.display_value < 0 { true -> prepare_negative(main, window) _ -> prepare_positive(main, window) }
    }
    state prepare_negative(main: &mut Main, window: Window) {
        main.sign = 1;
        main.display_work = 0 - main.display_value;
        transition { _ -> prepare_digits(main, window) }
    }
    state prepare_positive(main: &mut Main, window: Window) {
        main.sign = 0;
        main.display_work = main.display_value;
        transition { _ -> prepare_digits(main, window) }
    }
    state prepare_digits(main: &mut Main, window: Window) {
        main.display_work = main.display_work % 10000;
        main.digit0 = main.display_work % 10;
        main.display_work = main.display_work / 10;
        main.digit1 = main.display_work % 10;
        main.display_work = main.display_work / 10;
        main.digit2 = main.display_work % 10;
        main.display_work = main.display_work / 10;
        main.digit3 = main.display_work % 10;
        main.i = 0;
        transition { _ -> fill_loop(main, window) }
    }

    state fill_loop(main: &mut Main, window: Window) {
        transition main.i >= 0 && main.i < 4096 { true -> fill_cell(main, window) _ -> present(main, window) }
    }
    state fill_cell(main: &mut Main, window: Window) {
        main.row = min_i32(max_i32(main.i / 64, 0), 63);
        main.col = min_i32(max_i32(main.i % 64, 0), 63);
        main.px = 1318440 + ((main.frame % 32) * 1024);
        transition main.row < 16 { true -> display_pixel(main, window) _ -> keypad_region(main, window) }
    }
    state display_pixel(main: &mut Main, window: Window) {
        main.px = 461325;
        transition main.row >= 2 && main.row < 13 && main.col >= 28 && main.col < 60 {
            true -> display_digit_slot(main, window)
            _ -> display_sign(main, window)
        }
    }
    state display_sign(main: &mut Main, window: Window) {
        transition main.sign > 0 && main.row == 8 && main.col >= 20 && main.col <= 25 {
            true -> display_mark(main, window)
            _ -> display_error(main, window)
        }
    }
    state display_error(main: &mut Main, window: Window) {
        transition main.error > 0 && main.row >= 4 && main.row <= 10 && main.col >= 6 && main.col <= 14 {
            true -> display_mark(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state display_mark(main: &mut Main, window: Window) {
        main.px = 16759616;
        transition { _ -> write_pixel_guard(main, window) }
    }
    state display_digit_slot(main: &mut Main, window: Window) {
        main.local_x = (main.col - 28) % 8;
        main.local_y = main.row - 2;
        transition main.col < 36 { true -> use_digit3(main, window) _ -> display_digit_slot1(main, window) }
    }
    state display_digit_slot1(main: &mut Main, window: Window) {
        transition main.col < 44 { true -> use_digit2(main, window) _ -> display_digit_slot2(main, window) }
    }
    state display_digit_slot2(main: &mut Main, window: Window) {
        transition main.col < 52 { true -> use_digit1(main, window) _ -> use_digit0(main, window) }
    }
    state use_digit3(main: &mut Main, window: Window) { main.draw_digit = main.digit3; transition { _ -> segment_a(main, window) } }
    state use_digit2(main: &mut Main, window: Window) { main.draw_digit = main.digit2; transition { _ -> segment_a(main, window) } }
    state use_digit1(main: &mut Main, window: Window) { main.draw_digit = main.digit1; transition { _ -> segment_a(main, window) } }
    state use_digit0(main: &mut Main, window: Window) { main.draw_digit = main.digit0; transition { _ -> segment_a(main, window) } }

    state segment_a(main: &mut Main, window: Window) {
        transition main.local_y == 0 && main.local_x >= 2 && main.local_x <= 5 {
            true -> segment_set_a(main, window)
            _ -> segment_b(main, window)
        }
    }
    state segment_set_a(main: &mut Main, window: Window) { main.segment = 0; transition { _ -> segment_apply(main, window) } }
    state segment_b(main: &mut Main, window: Window) {
        transition main.local_x == 6 && main.local_y >= 1 && main.local_y <= 4 {
            true -> segment_set_b(main, window)
            _ -> segment_c(main, window)
        }
    }
    state segment_set_b(main: &mut Main, window: Window) { main.segment = 1; transition { _ -> segment_apply(main, window) } }
    state segment_c(main: &mut Main, window: Window) {
        transition main.local_x == 6 && main.local_y >= 6 && main.local_y <= 9 {
            true -> segment_set_c(main, window)
            _ -> segment_d(main, window)
        }
    }
    state segment_set_c(main: &mut Main, window: Window) { main.segment = 2; transition { _ -> segment_apply(main, window) } }
    state segment_d(main: &mut Main, window: Window) {
        transition main.local_y == 10 && main.local_x >= 2 && main.local_x <= 5 {
            true -> segment_set_d(main, window)
            _ -> segment_e(main, window)
        }
    }
    state segment_set_d(main: &mut Main, window: Window) { main.segment = 3; transition { _ -> segment_apply(main, window) } }
    state segment_e(main: &mut Main, window: Window) {
        transition main.local_x == 1 && main.local_y >= 6 && main.local_y <= 9 {
            true -> segment_set_e(main, window)
            _ -> segment_f(main, window)
        }
    }
    state segment_set_e(main: &mut Main, window: Window) { main.segment = 4; transition { _ -> segment_apply(main, window) } }
    state segment_f(main: &mut Main, window: Window) {
        transition main.local_x == 1 && main.local_y >= 1 && main.local_y <= 4 {
            true -> segment_set_f(main, window)
            _ -> segment_g(main, window)
        }
    }
    state segment_set_f(main: &mut Main, window: Window) { main.segment = 5; transition { _ -> segment_apply(main, window) } }
    state segment_g(main: &mut Main, window: Window) {
        transition main.local_y == 5 && main.local_x >= 2 && main.local_x <= 5 {
            true -> segment_set_g(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state segment_set_g(main: &mut Main, window: Window) { main.segment = 6; transition { _ -> segment_apply(main, window) } }

    state segment_apply(main: &mut Main, window: Window) {
        transition main.draw_digit == 0 { true -> digit0_segment(main, window) _ -> digit1_check(main, window) }
    }
    state digit1_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 1 { true -> digit1_segment(main, window) _ -> digit2_check(main, window) }
    }
    state digit2_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 2 { true -> digit2_segment(main, window) _ -> digit3_check(main, window) }
    }
    state digit3_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 3 { true -> digit3_segment(main, window) _ -> digit4_check(main, window) }
    }
    state digit4_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 4 { true -> digit4_segment(main, window) _ -> digit5_check(main, window) }
    }
    state digit5_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 5 { true -> digit5_segment(main, window) _ -> digit6_check(main, window) }
    }
    state digit6_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 6 { true -> digit6_segment(main, window) _ -> digit7_check(main, window) }
    }
    state digit7_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 7 { true -> digit7_segment(main, window) _ -> digit8_check(main, window) }
    }
    state digit8_check(main: &mut Main, window: Window) {
        transition main.draw_digit == 8 { true -> digit8_segment(main, window) _ -> digit9_segment(main, window) }
    }
    state digit0_segment(main: &mut Main, window: Window) {
        transition main.segment != 6 { true -> segment_on(main, window) _ -> write_pixel_guard(main, window) }
    }
    state digit1_segment(main: &mut Main, window: Window) {
        transition main.segment == 1 || main.segment == 2 { true -> segment_on(main, window) _ -> write_pixel_guard(main, window) }
    }
    state digit2_segment(main: &mut Main, window: Window) {
        transition main.segment == 0 || main.segment == 1 || main.segment == 6 || main.segment == 4 || main.segment == 3 {
            true -> segment_on(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state digit3_segment(main: &mut Main, window: Window) {
        transition main.segment == 0 || main.segment == 1 || main.segment == 2 || main.segment == 3 || main.segment == 6 {
            true -> segment_on(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state digit4_segment(main: &mut Main, window: Window) {
        transition main.segment == 5 || main.segment == 6 || main.segment == 1 || main.segment == 2 {
            true -> segment_on(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state digit5_segment(main: &mut Main, window: Window) {
        transition main.segment == 0 || main.segment == 5 || main.segment == 6 || main.segment == 2 || main.segment == 3 {
            true -> segment_on(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state digit6_segment(main: &mut Main, window: Window) {
        transition main.segment == 0 || main.segment == 5 || main.segment == 4 || main.segment == 3 || main.segment == 2 || main.segment == 6 {
            true -> segment_on(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state digit7_segment(main: &mut Main, window: Window) {
        transition main.segment == 0 || main.segment == 1 || main.segment == 2 { true -> segment_on(main, window) _ -> write_pixel_guard(main, window) }
    }
    state digit8_segment(main: &mut Main, window: Window) { transition { _ -> segment_on(main, window) } }
    state digit9_segment(main: &mut Main, window: Window) {
        transition main.segment != 4 { true -> segment_on(main, window) _ -> write_pixel_guard(main, window) }
    }
    state segment_on(main: &mut Main, window: Window) {
        main.px = 52991;
        transition { _ -> write_pixel_guard(main, window) }
    }

    state keypad_region(main: &mut Main, window: Window) {
        transition main.row >= 18 && main.row < 63 { true -> button_prepare(main, window) _ -> write_pixel_guard(main, window) }
    }
    state button_prepare(main: &mut Main, window: Window) {
        main.button_row = min_i32(max_i32((main.row - 18) / 9, 0), 4);
        main.button_col = min_i32(max_i32(main.col / 16, 0), 3);
        main.button_lx = main.col % 16;
        main.button_ly = (main.row - 18) % 9;
        transition main.button_row == 0 { true -> button_row0(main, window) _ -> button_row1_check(main, window) }
    }
    state button_row1_check(main: &mut Main, window: Window) {
        transition main.button_row == 1 { true -> button_row1(main, window) _ -> button_row2_check(main, window) }
    }
    state button_row2_check(main: &mut Main, window: Window) {
        transition main.button_row == 2 { true -> button_row2(main, window) _ -> button_row3_check(main, window) }
    }
    state button_row3_check(main: &mut Main, window: Window) {
        transition main.button_row == 3 { true -> button_row3(main, window) _ -> button_row4(main, window) }
    }
    state button_row0(main: &mut Main, window: Window) {
        transition main.button_col == 0 { true -> button_code_memory_add(main, window) _ -> button_row0_col1(main, window) }
    }
    state button_row0_col1(main: &mut Main, window: Window) {
        transition main.button_col == 1 { true -> button_code_memory_recall(main, window) _ -> button_row0_col2(main, window) }
    }
    state button_row0_col2(main: &mut Main, window: Window) {
        transition main.button_col == 2 { true -> button_code_clear(main, window) _ -> button_code_backspace(main, window) }
    }
    state button_row1(main: &mut Main, window: Window) {
        transition main.button_col == 0 { true -> button_code7(main, window) _ -> button_row1_col1(main, window) }
    }
    state button_row1_col1(main: &mut Main, window: Window) {
        transition main.button_col == 1 { true -> button_code8(main, window) _ -> button_row1_col2(main, window) }
    }
    state button_row1_col2(main: &mut Main, window: Window) {
        transition main.button_col == 2 { true -> button_code9(main, window) _ -> button_code_divide(main, window) }
    }
    state button_row2(main: &mut Main, window: Window) {
        transition main.button_col == 0 { true -> button_code4(main, window) _ -> button_row2_col1(main, window) }
    }
    state button_row2_col1(main: &mut Main, window: Window) {
        transition main.button_col == 1 { true -> button_code5(main, window) _ -> button_row2_col2(main, window) }
    }
    state button_row2_col2(main: &mut Main, window: Window) {
        transition main.button_col == 2 { true -> button_code6(main, window) _ -> button_code_multiply(main, window) }
    }
    state button_row3(main: &mut Main, window: Window) {
        transition main.button_col == 0 { true -> button_code1(main, window) _ -> button_row3_col1(main, window) }
    }
    state button_row3_col1(main: &mut Main, window: Window) {
        transition main.button_col == 1 { true -> button_code2(main, window) _ -> button_row3_col2(main, window) }
    }
    state button_row3_col2(main: &mut Main, window: Window) {
        transition main.button_col == 2 { true -> button_code3(main, window) _ -> button_code_minus(main, window) }
    }
    state button_row4(main: &mut Main, window: Window) {
        transition main.button_col == 0 { true -> button_code_sign(main, window) _ -> button_row4_col1(main, window) }
    }
    state button_row4_col1(main: &mut Main, window: Window) {
        transition main.button_col == 1 { true -> button_code0(main, window) _ -> button_row4_col2(main, window) }
    }
    state button_row4_col2(main: &mut Main, window: Window) {
        transition main.button_col == 2 { true -> button_code_equals(main, window) _ -> button_code_plus(main, window) }
    }
    state button_code0(main: &mut Main, window: Window) { main.button_code = 0; transition { _ -> button_paint(main, window) } }
    state button_code1(main: &mut Main, window: Window) { main.button_code = 1; transition { _ -> button_paint(main, window) } }
    state button_code2(main: &mut Main, window: Window) { main.button_code = 2; transition { _ -> button_paint(main, window) } }
    state button_code3(main: &mut Main, window: Window) { main.button_code = 3; transition { _ -> button_paint(main, window) } }
    state button_code4(main: &mut Main, window: Window) { main.button_code = 4; transition { _ -> button_paint(main, window) } }
    state button_code5(main: &mut Main, window: Window) { main.button_code = 5; transition { _ -> button_paint(main, window) } }
    state button_code6(main: &mut Main, window: Window) { main.button_code = 6; transition { _ -> button_paint(main, window) } }
    state button_code7(main: &mut Main, window: Window) { main.button_code = 7; transition { _ -> button_paint(main, window) } }
    state button_code8(main: &mut Main, window: Window) { main.button_code = 8; transition { _ -> button_paint(main, window) } }
    state button_code9(main: &mut Main, window: Window) { main.button_code = 9; transition { _ -> button_paint(main, window) } }
    state button_code_plus(main: &mut Main, window: Window) { main.button_code = 11; transition { _ -> button_paint(main, window) } }
    state button_code_minus(main: &mut Main, window: Window) { main.button_code = 12; transition { _ -> button_paint(main, window) } }
    state button_code_multiply(main: &mut Main, window: Window) { main.button_code = 13; transition { _ -> button_paint(main, window) } }
    state button_code_divide(main: &mut Main, window: Window) { main.button_code = 14; transition { _ -> button_paint(main, window) } }
    state button_code_sign(main: &mut Main, window: Window) { main.button_code = 15; transition { _ -> button_paint(main, window) } }
    state button_code_equals(main: &mut Main, window: Window) { main.button_code = 16; transition { _ -> button_paint(main, window) } }
    state button_code_memory_add(main: &mut Main, window: Window) { main.button_code = 20; transition { _ -> button_paint(main, window) } }
    state button_code_memory_recall(main: &mut Main, window: Window) { main.button_code = 21; transition { _ -> button_paint(main, window) } }
    state button_code_clear(main: &mut Main, window: Window) { main.button_code = 22; transition { _ -> button_paint(main, window) } }
    state button_code_backspace(main: &mut Main, window: Window) { main.button_code = 23; transition { _ -> button_paint(main, window) } }

    state button_paint(main: &mut Main, window: Window) {
        main.px = 2171169;
        transition main.button_code == main.last_key { true -> button_active(main, window) _ -> button_border(main, window) }
    }
    state button_active(main: &mut Main, window: Window) {
        main.px = 5335039;
        transition { _ -> button_border(main, window) }
    }
    state button_border(main: &mut Main, window: Window) {
        transition main.button_lx == 0 || main.button_lx == 15 || main.button_ly == 0 || main.button_ly == 8 {
            true -> button_border_paint(main, window)
            _ -> button_label(main, window)
        }
    }
    state button_border_paint(main: &mut Main, window: Window) {
        main.px = 8421504;
        transition { _ -> write_pixel_guard(main, window) }
    }
    // Re-assert the in-button coordinates: button_hit computed them many
    // dispatch states back, and the label arithmetic below needs them bounded
    // (always true: `col % 16` and `(row - 18) % 9` inside the button grid).
    state button_label(main: &mut Main, window: Window) {
        transition main.button_lx >= 0 && main.button_lx <= 15 && main.button_ly >= 0 && main.button_ly <= 8 {
            true -> button_label_kind(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state button_label_kind(main: &mut Main, window: Window) {
        transition main.button_code <= 9 { true -> button_digit_label(main, window) _ -> button_operator_label(main, window) }
    }
    state button_digit_label(main: &mut Main, window: Window) {
        main.draw_digit = main.button_code as i32 in Saturating;
        main.local_x = main.button_lx - 4;
        main.local_y = main.button_ly - 1;
        transition { _ -> button_segment_a(main, window) }
    }
    state button_segment_a(main: &mut Main, window: Window) {
        transition main.local_y == 0 && main.local_x >= 1 && main.local_x <= 5 {
            true -> segment_set_a(main, window)
            _ -> button_segment_b(main, window)
        }
    }
    state button_segment_b(main: &mut Main, window: Window) {
        transition main.local_x == 6 && main.local_y >= 1 && main.local_y <= 3 {
            true -> segment_set_b(main, window)
            _ -> button_segment_c(main, window)
        }
    }
    state button_segment_c(main: &mut Main, window: Window) {
        transition main.local_x == 6 && main.local_y >= 5 && main.local_y <= 6 {
            true -> segment_set_c(main, window)
            _ -> button_segment_d(main, window)
        }
    }
    state button_segment_d(main: &mut Main, window: Window) {
        transition main.local_y == 7 && main.local_x >= 1 && main.local_x <= 5 {
            true -> segment_set_d(main, window)
            _ -> button_segment_e(main, window)
        }
    }
    state button_segment_e(main: &mut Main, window: Window) {
        transition main.local_x == 0 && main.local_y >= 5 && main.local_y <= 6 {
            true -> segment_set_e(main, window)
            _ -> button_segment_f(main, window)
        }
    }
    state button_segment_f(main: &mut Main, window: Window) {
        transition main.local_x == 0 && main.local_y >= 1 && main.local_y <= 3 {
            true -> segment_set_f(main, window)
            _ -> button_segment_g(main, window)
        }
    }
    state button_segment_g(main: &mut Main, window: Window) {
        transition main.local_y == 4 && main.local_x >= 1 && main.local_x <= 5 {
            true -> segment_set_g(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state button_operator_label(main: &mut Main, window: Window) {
        transition main.button_code == 11 { true -> label_plus(main, window) _ -> label_minus_check(main, window) }
    }
    state label_minus_check(main: &mut Main, window: Window) {
        transition main.button_code == 12 { true -> label_minus(main, window) _ -> label_multiply_check(main, window) }
    }
    state label_multiply_check(main: &mut Main, window: Window) {
        transition main.button_code == 13 { true -> label_multiply(main, window) _ -> label_divide_check(main, window) }
    }
    state label_divide_check(main: &mut Main, window: Window) {
        transition main.button_code == 14 { true -> label_divide(main, window) _ -> label_sign_check(main, window) }
    }
    state label_sign_check(main: &mut Main, window: Window) {
        transition main.button_code == 15 { true -> label_sign(main, window) _ -> label_equals_check(main, window) }
    }
    state label_equals_check(main: &mut Main, window: Window) {
        transition main.button_code == 16 { true -> label_equals(main, window) _ -> label_utility(main, window) }
    }
    state label_plus(main: &mut Main, window: Window) {
        transition main.button_lx == 8 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main, window) _ -> label_plus_bar(main, window) }
    }
    state label_plus_bar(main: &mut Main, window: Window) {
        transition main.button_ly == 4 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main, window) _ -> write_pixel_guard(main, window) }
    }
    state label_minus(main: &mut Main, window: Window) {
        transition main.button_ly == 4 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main, window) _ -> write_pixel_guard(main, window) }
    }
    state label_multiply(main: &mut Main, window: Window) {
        transition main.button_lx == main.button_ly + 4 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main, window) _ -> label_multiply_backslash(main, window) }
    }
    state label_multiply_backslash(main: &mut Main, window: Window) {
        transition main.button_lx + main.button_ly == 12 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main, window) _ -> write_pixel_guard(main, window) }
    }
    state label_divide(main: &mut Main, window: Window) {
        transition main.button_lx + main.button_ly == 12 && main.button_ly >= 2 && main.button_ly <= 6 { true -> label_paint(main, window) _ -> label_divide_dot_top(main, window) }
    }
    state label_divide_dot_top(main: &mut Main, window: Window) {
        transition main.button_lx == 8 && main.button_ly == 2 { true -> label_paint(main, window) _ -> label_divide_dot_bottom(main, window) }
    }
    state label_divide_dot_bottom(main: &mut Main, window: Window) {
        transition main.button_lx == 8 && main.button_ly == 6 { true -> label_paint(main, window) _ -> write_pixel_guard(main, window) }
    }
    state label_sign(main: &mut Main, window: Window) {
        transition main.button_lx == 7 && main.button_ly >= 2 && main.button_ly <= 5 { true -> label_paint(main, window) _ -> label_sign_plus_bar(main, window) }
    }
    state label_sign_plus_bar(main: &mut Main, window: Window) {
        transition main.button_ly == 4 && main.button_lx >= 5 && main.button_lx <= 9 { true -> label_paint(main, window) _ -> label_sign_minus_bar(main, window) }
    }
    state label_sign_minus_bar(main: &mut Main, window: Window) {
        transition main.button_ly == 6 && main.button_lx >= 5 && main.button_lx <= 9 { true -> label_paint(main, window) _ -> write_pixel_guard(main, window) }
    }
    state label_equals(main: &mut Main, window: Window) {
        transition main.button_ly == 3 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main, window) _ -> label_equals_bottom(main, window) }
    }
    state label_equals_bottom(main: &mut Main, window: Window) {
        transition main.button_ly == 5 && main.button_lx >= 5 && main.button_lx <= 11 { true -> label_paint(main, window) _ -> write_pixel_guard(main, window) }
    }
    state label_utility(main: &mut Main, window: Window) {
        transition main.button_lx >= 5 && main.button_lx <= 11 && main.button_ly >= 2 && main.button_ly <= 6 {
            true -> label_paint(main, window)
            _ -> write_pixel_guard(main, window)
        }
    }
    state label_paint(main: &mut Main, window: Window) {
        main.px = 15794175;
        transition { _ -> write_pixel_guard(main, window) }
    }

    state write_pixel_guard(main: &mut Main, window: Window) {
        transition main.i >= 0 && main.i < 4096 { true -> write_pixel(main, window) _ -> bad(main, window) }
    }
    state write_pixel(main: &mut Main, window: Window) {
        main.pixels[main.i] = main.px;
        main.i = main.i + 1;
        transition main.col == 63 { true -> render_pump_peek(main, window) _ -> fill_loop(main, window) }
    }
    state render_pump_peek(main: &mut Main, mut window: Window) {
        main.have = Gui::msg_peek(&mut window, main.message);
        transition main.have > 0 { true -> render_pump_check_close(main, window) _ -> fill_loop(main, window) }
    }
    state render_pump_check_close(main: &mut Main, window: Window) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main, window) _ -> render_pump_check_syscommand(main, window) }
    }
    state render_pump_check_syscommand(main: &mut Main, window: Window) {
        transition main.msg_code == 274 { true -> render_pump_check_sysclose(main, window) _ -> render_pump_handle(main, window) }
    }
    state render_pump_check_sysclose(main: &mut Main, window: Window) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main, window) _ -> render_pump_handle(main, window) }
    }
    state render_pump_handle(main: &mut Main, window: Window) {
        main.translated = Gui::msg_translate(&window, main.message);
        main.dispatched = Gui::msg_dispatch(&window, main.message);
        transition { _ -> render_pump_liveness(main, window) }
    }
    state render_pump_liveness(main: &mut Main, window: Window) {
        main.alive = Gui::is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> fill_loop(main, window) _ -> closed(main, window) }
    }

    state present(main: &mut Main, window: Window) {
        main.copied = Gui::blit(&window, main.hdc, 512, 512, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main, window) _ -> present_failed(main, window) }
    }
    state present_failed(main: &mut Main, window: Window) {
        main.alive = Gui::is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> bad(main, window) _ -> closed(main, window) }
    }
    state pace(main: &mut Main, window: Window) {
        Clock::sleep(16);
        transition main.frame >= 0 && main.frame < 16384 { true -> advance(main, window) _ -> wrap_frame(main, window) }
    }
    state advance(main: &mut Main, window: Window) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main, window) }
    }

    state quit_self(main: &mut Main, window: Window) {
        transition { _ -> closed(main, window) }
    }
    state closed(main: &mut Main, window: Window) {
        Gui::window_destroy(window);
        Console::write_line("windowed calculator closed (exit 0)");
        Console::exit_process(0);
    }
    state bad(main: &mut Main, window: Window) {
        Gui::window_destroy(window);
        Console::write_line("FAIL: windowed_calculator hit a renderer or host assertion (exit 1)");
        Console::exit_process(1);
    }
}

machine Main::accept_digit(main: &mut Main, digit: i32, key_code: i32)
requires
    digit >= 0 && digit <= 9;
requires
    key_code >= 0 && key_code <= 31;
{
    main.last_key = key_code;
    main.cooldown = 6;
    transition main.error > 0 { true -> digit_after_error(main, digit) _ -> digit_dispatch(main, digit) }

    state digit_after_error(main: &mut Main, digit: i32) {
        main.error = 0;
        main.pending = 0;
        main.accumulator = 0;
        main.current = digit as i32 in Saturating;
        main.typing = 1;
    }
    state digit_dispatch(main: &mut Main, digit: i32) {
        transition main.typing > 0 { true -> digit_append(main, digit) _ -> digit_start(main, digit) }
    }
    state digit_start(main: &mut Main, digit: i32) {
        main.current = digit as i32 in Saturating;
        main.typing = 1;
    }
    state digit_append(main: &mut Main, digit: i32) {
        // Fused Saturating mul/add in operand position lower correctly since
        // the 2026-07-09d operand-position domain lowering (the clamp happens
        // at each operation node before the modulo).
        main.current = ((main.current * (10 as i32 in Saturating)) + (digit as i32 in Saturating)) % (10000 as i32 in Saturating);
    }
}

machine Main::accept_operator(main: &mut Main, op: i32, key_code: i32)
requires
    op >= 0 && op <= 4;
requires
    key_code >= 0 && key_code <= 31;
{
    main.last_key = key_code;
    main.cooldown = 6;
    transition main.error > 0 { true -> done(main) _ -> operator_dispatch(main, op) }

    state operator_dispatch(main: &mut Main, op: i32) {
        transition main.pending == 0 { true -> store_first(main, op) _ -> evaluate_for_operator(main, op) }
    }
    state store_first(main: &mut Main, op: i32) {
        main.accumulator = main.current;
        main.current = 0;
        main.typing = 0;
        main.pending = op;
    }
    state evaluate_for_operator(main: &mut Main, op: i32) {
        transition main.pending == 1 { true -> eval_add(main, op) _ -> eval_sub_check(main, op) }
    }
    state eval_sub_check(main: &mut Main, op: i32) {
        transition main.pending == 2 { true -> eval_sub(main, op) _ -> eval_mul_check(main, op) }
    }
    state eval_mul_check(main: &mut Main, op: i32) {
        transition main.pending == 3 { true -> eval_mul(main, op) _ -> eval_div_check(main, op) }
    }
    state eval_div_check(main: &mut Main, op: i32) {
        transition main.pending == 4 { true -> eval_div_guard(main, op) _ -> finish_operator(main, op) }
    }
    state eval_add(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator + main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state eval_sub(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator - main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state eval_mul(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator * main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state eval_div_guard(main: &mut Main, op: i32) {
        transition main.current == 0 { true -> divide_error(main) _ -> eval_div(main, op) }
    }
    state eval_div(main: &mut Main, op: i32) {
        main.accumulator = main.accumulator / main.current;
        transition { _ -> finish_operator(main, op) }
    }
    state finish_operator(main: &mut Main, op: i32) {
        main.current = 0;
        main.typing = 0;
        main.pending = op;
    }
    state divide_error(main: &mut Main) {
        main.error = 1;
        main.pending = 0;
        main.typing = 0;
    }
    state done(main: &mut Main) {}
}

machine Main::accept_equals(main: &mut Main) {
    main.last_key = 16;
    main.cooldown = 6;
    transition main.error > 0 { true -> done(main) _ -> equals_dispatch(main) }

    state equals_dispatch(main: &mut Main) {
        transition main.pending == 0 { true -> finish_equals(main) _ -> evaluate_pending(main) }
    }
    state evaluate_pending(main: &mut Main) {
        transition main.pending == 1 { true -> eval_add(main) _ -> eval_sub_check(main) }
    }
    state eval_sub_check(main: &mut Main) {
        transition main.pending == 2 { true -> eval_sub(main) _ -> eval_mul_check(main) }
    }
    state eval_mul_check(main: &mut Main) {
        transition main.pending == 3 { true -> eval_mul(main) _ -> eval_div_check(main) }
    }
    state eval_div_check(main: &mut Main) {
        transition main.pending == 4 { true -> eval_div_guard(main) _ -> finish_equals(main) }
    }
    state eval_add(main: &mut Main) {
        main.accumulator = main.accumulator + main.current;
        transition { _ -> finish_equals(main) }
    }
    state eval_sub(main: &mut Main) {
        main.accumulator = main.accumulator - main.current;
        transition { _ -> finish_equals(main) }
    }
    state eval_mul(main: &mut Main) {
        main.accumulator = main.accumulator * main.current;
        transition { _ -> finish_equals(main) }
    }
    state eval_div_guard(main: &mut Main) {
        transition main.current == 0 { true -> divide_error(main) _ -> eval_div(main) }
    }
    state eval_div(main: &mut Main) {
        main.accumulator = main.accumulator / main.current;
        transition { _ -> finish_equals(main) }
    }
    state finish_equals(main: &mut Main) {
        main.current = main.accumulator;
        main.pending = 0;
        main.typing = 1;
    }
    state divide_error(main: &mut Main) {
        main.error = 1;
        main.pending = 0;
        main.typing = 0;
    }
    state done(main: &mut Main) {}
}

machine Main::clear_all(main: &mut Main, key_code: i32)
requires
    key_code >= 0 && key_code <= 31;
{
    main.last_key = key_code;
    main.cooldown = 6;
    main.current = 0;
    main.accumulator = 0;
    main.pending = 0;
    main.typing = 1;
    main.error = 0;
}

machine Main::backspace(main: &mut Main) {
    main.last_key = 23;
    main.cooldown = 6;
    transition main.typing > 0 { true -> trim(main) _ -> done(main) }

    state trim(main: &mut Main) {
        main.current = main.current / 10;
    }
    state done(main: &mut Main) {}
}

machine Main::toggle_sign(main: &mut Main) {
    main.last_key = 15;
    main.cooldown = 6;
    transition main.typing > 0 { true -> sign_current(main) _ -> sign_accumulator(main) }

    state sign_current(main: &mut Main) {
        main.current = 0 - main.current;
    }
    state sign_accumulator(main: &mut Main) {
        main.accumulator = 0 - main.accumulator;
    }
}

machine Main::memory_add(main: &mut Main) {
    main.last_key = 20;
    main.cooldown = 6;
    transition main.typing > 0 { true -> add_current(main) _ -> add_accumulator(main) }

    state add_current(main: &mut Main) { main.memory = main.memory + main.current; }
    state add_accumulator(main: &mut Main) { main.memory = main.memory + main.accumulator; }
}

machine Main::memory_recall(main: &mut Main) {
    main.last_key = 21;
    main.cooldown = 6;
    main.current = main.memory;
    main.typing = 1;
    main.error = 0;
}
