    }
    state segment_set_g(main: &mut Main) { main.segment = 6; transition { _ -> segment_apply(main) } }

    state segment_apply(main: &mut Main) {
        transition main.draw_digit == 0 { true -> digit0_segment(main) _ -> digit1_check(main) }
    }
    state digit1_check(main: &mut Main) {
        transition main.draw_digit == 1 { true -> digit1_segment(main) _ -> digit2_check(main) }
    }
    state digit2_check(main: &mut Main) {
        transition main.draw_digit == 2 { true -> digit2_segment(main) _ -> digit3_check(main) }
    }
    state digit3_check(main: &mut Main) {
        transition main.draw_digit == 3 { true -> digit3_segment(main) _ -> digit4_check(main) }
    }
    state digit4_check(main: &mut Main) {
        transition main.draw_digit == 4 { true -> digit4_segment(main) _ -> digit5_check(main) }
    }
    state digit5_check(main: &mut Main) {
        transition main.draw_digit == 5 { true -> digit5_segment(main) _ -> digit6_check(main) }
    }
    state digit6_check(main: &mut Main) {
        transition main.draw_digit == 6 { true -> digit6_segment(main) _ -> digit7_check(main) }
    }
    state digit7_check(main: &mut Main) {
        transition main.draw_digit == 7 { true -> digit7_segment(main) _ -> digit8_check(main) }
    }
    state digit8_check(main: &mut Main) {
        transition main.draw_digit == 8 { true -> digit8_segment(main) _ -> digit9_segment(main) }
    }
    state digit0_segment(main: &mut Main) {
        transition main.segment != 6 { true -> segment_on(main) _ -> write_pixel_guard(main) }
    }
    state digit1_segment(main: &mut Main) {
        transition main.segment == 1 || main.segment == 2 { true -> segment_on(main) _ -> write_pixel_guard(main) }
    }
    state digit2_segment(main: &mut Main) {
        transition main.segment == 0 || main.segment == 1 || main.segment == 6 || main.segment == 4 || main.segment == 3 {
            true -> segment_on(main)
            _ -> write_pixel_guard(main)
        }
    }
    state digit3_segment(main: &mut Main) {
        transition main.segment == 0 || main.segment == 1 || main.segment == 2 || main.segment == 3 || main.segment == 6 {
            true -> segment_on(main)
            _ -> write_pixel_guard(main)
        }
    }
    state digit4_segment(main: &mut Main) {
        transition main.segment == 5 || main.segment == 6 || main.segment == 1 || main.segment == 2 {
            true -> segment_on(main)
            _ -> write_pixel_guard(main)
        }
    }
    state digit5_segment(main: &mut Main) {
        transition main.segment == 0 || main.segment == 5 || main.segment == 6 || main.segment == 2 || main.segment == 3 {
            true -> segment_on(main)
            _ -> write_pixel_guard(main)
        }
    }
    state digit6_segment(main: &mut Main) {
        transition main.segment == 0 || main.segment == 5 || main.segment == 4 || main.segment == 3 || main.segment == 2 || main.segment == 6 {
