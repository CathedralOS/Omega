    }
    state input_clear_key(main: &mut Main) {
        main.last_key = 31;
        transition { _ -> poll_clear(main) }
    }
    state poll_clear(main: &mut Main) {
        main.key = main.input.key_state(67);
        transition main.key > 0 { true -> hit_clear(main) _ -> poll_backspace(main) }
    }
    state poll_backspace(main: &mut Main) {
        main.key = main.input.key_state(8);
        transition main.key > 0 { true -> hit_backspace(main) _ -> poll_enter(main) }
    }
    state poll_enter(main: &mut Main) {
        main.key = main.input.key_state(13);
        transition main.key > 0 { true -> hit_equals(main) _ -> poll_equals_key(main) }
    }
    state poll_equals_key(main: &mut Main) {
        main.key = main.input.key_state(187);
        transition main.key > 0 { true -> hit_equals(main) _ -> poll_plus(main) }
    }
    state poll_plus(main: &mut Main) {
        main.key = main.input.key_state(107);
        transition main.key > 0 { true -> hit_plus(main) _ -> poll_minus(main) }
    }
    state poll_minus(main: &mut Main) {
        main.key = main.input.key_state(109);
        transition main.key > 0 { true -> hit_minus(main) _ -> poll_multiply(main) }
    }
    state poll_multiply(main: &mut Main) {
        main.key = main.input.key_state(106);
        transition main.key > 0 { true -> hit_multiply(main) _ -> poll_divide(main) }
    }
    state poll_divide(main: &mut Main) {
        main.key = main.input.key_state(111);
        transition main.key > 0 { true -> hit_divide(main) _ -> poll_sign(main) }
    }
    state poll_sign(main: &mut Main) {
        main.key = main.input.key_state(83);
        transition main.key > 0 { true -> hit_sign(main) _ -> poll_memory_add(main) }
    }
    state poll_memory_add(main: &mut Main) {
        main.key = main.input.key_state(77);
        transition main.key > 0 { true -> hit_memory_add(main) _ -> poll_memory_recall(main) }
    }
    state poll_memory_recall(main: &mut Main) {
        main.key = main.input.key_state(82);
        transition main.key > 0 { true -> hit_memory_recall(main) _ -> poll_digit0(main) }
    }
    state poll_digit0(main: &mut Main) {
        main.key = main.input.key_state(48);
        transition main.key > 0 { true -> hit_digit0(main) _ -> poll_digit1(main) }
    }
    state poll_digit1(main: &mut Main) {
        main.key = main.input.key_state(49);
        transition main.key > 0 { true -> hit_digit1(main) _ -> poll_digit2(main) }
    }
    state poll_digit2(main: &mut Main) {
        main.key = main.input.key_state(50);
        transition main.key > 0 { true -> hit_digit2(main) _ -> poll_digit3(main) }
    }
    state poll_digit3(main: &mut Main) {
        main.key = main.input.key_state(51);
        transition main.key > 0 { true -> hit_digit3(main) _ -> poll_digit4(main) }
    }
    state poll_digit4(main: &mut Main) {
        main.key = main.input.key_state(52);
        transition main.key > 0 { true -> hit_digit4(main) _ -> poll_digit5(main) }
    }
    state poll_digit5(main: &mut Main) {
        main.key = main.input.key_state(53);
        transition main.key > 0 { true -> hit_digit5(main) _ -> poll_digit6(main) }
    }
    state poll_digit6(main: &mut Main) {
        main.key = main.input.key_state(54);
        transition main.key > 0 { true -> hit_digit6(main) _ -> poll_digit7(main) }
    }
    state poll_digit7(main: &mut Main) {
        main.key = main.input.key_state(55);
        transition main.key > 0 { true -> hit_digit7(main) _ -> poll_digit8(main) }
    }
    state poll_digit8(main: &mut Main) {
        main.key = main.input.key_state(56);
        transition main.key > 0 { true -> hit_digit8(main) _ -> poll_digit9(main) }
    }
    state poll_digit9(main: &mut Main) {
        main.key = main.input.key_state(57);
        transition main.key > 0 { true -> hit_digit9(main) _ -> render_prepare(main) }
    }

    state hit_digit0(main: &mut Main) { Main::accept_digit(main, 0, 0); transition { _ -> render_prepare(main) } }
    state hit_digit1(main: &mut Main) { Main::accept_digit(main, 1, 1); transition { _ -> render_prepare(main) } }
    state hit_digit2(main: &mut Main) { Main::accept_digit(main, 2, 2); transition { _ -> render_prepare(main) } }
    state hit_digit3(main: &mut Main) { Main::accept_digit(main, 3, 3); transition { _ -> render_prepare(main) } }
    state hit_digit4(main: &mut Main) { Main::accept_digit(main, 4, 4); transition { _ -> render_prepare(main) } }
    state hit_digit5(main: &mut Main) { Main::accept_digit(main, 5, 5); transition { _ -> render_prepare(main) } }
    state hit_digit6(main: &mut Main) { Main::accept_digit(main, 6, 6); transition { _ -> render_prepare(main) } }
    state hit_digit7(main: &mut Main) { Main::accept_digit(main, 7, 7); transition { _ -> render_prepare(main) } }
    state hit_digit8(main: &mut Main) { Main::accept_digit(main, 8, 8); transition { _ -> render_prepare(main) } }
    state hit_digit9(main: &mut Main) { Main::accept_digit(main, 9, 9); transition { _ -> render_prepare(main) } }
    state hit_plus(main: &mut Main) { Main::accept_operator(main, 1, 11); transition { _ -> render_prepare(main) } }
    state hit_minus(main: &mut Main) { Main::accept_operator(main, 2, 12); transition { _ -> render_prepare(main) } }
    state hit_multiply(main: &mut Main) { Main::accept_operator(main, 3, 13); transition { _ -> render_prepare(main) } }
    state hit_divide(main: &mut Main) { Main::accept_operator(main, 4, 14); transition { _ -> render_prepare(main) } }
