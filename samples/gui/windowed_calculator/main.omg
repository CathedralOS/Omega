            _ -> segment_e(main)
        }
    }
    state segment_set_d(main: &mut Main) { main.segment = 3; transition { _ -> segment_apply(main) } }
    state segment_e(main: &mut Main) {
        transition main.local_x == 1 && main.local_y >= 6 && main.local_y <= 9 {
