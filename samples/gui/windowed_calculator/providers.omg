// Per-target bodies behind the sample's named provider maps. The conformance
// members in main.omg call these families; the target realization retains the
// member declared for the build target, exactly like window_demo's providers.
// Windows bodies use the shared WindowsGuiHost seam; macOS bodies keep the
// existing Cocoa facades. Window is the shared application-owned state.
use omega_language_std::macos_gui;
use omega_language_std::macos_image;
use omega_language_std::windows_gui_host;

public windows_x86_64 machine calc_window_create(class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> Window
requires title[10] == 0
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit invokes WindowsGuiHost {
    let handle: u64 = WindowsGuiHost::window_create_client(&class_name, &title, style, x, y, width, height);
    Window { window: handle, view: 0, app: 0, space: 0, date: 0, mode: 0,
        psel: 0, mask: 0, evt: 0, relsel: 0, dsel: 0, vsel: 0, ksel: 0, pool: 0 }
}
public macos_arm64 machine calc_window_create(class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> Window
requires title[10] == 0
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit invokes ObjectiveC invokes CoreGraphics invokes AppKit {
    macos_window_create<11>(class_name, &title, style, x, y, width, height)
}

