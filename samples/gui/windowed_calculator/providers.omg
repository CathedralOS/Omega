public windows_x86_64 machine calc_blit(window_state: &Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, mut pixels: [i32; 4096], info: [i32; 11]) -> u32
reaches
    GlobalInputObservation + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit invokes WindowsGuiHost {
    transition dest_width <= 2147483647 && dest_height <= 2147483647
        && source_width <= 2147483647 && source_height <= 2147483647 {
        true -> copy(device, dest_width, dest_height, source_width, source_height, pixels, info)
        _ -> (0)
    }
    machine copy(device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
    requires dest_width <= 2147483647 && dest_height <= 2147483647 && source_width <= 2147483647 && source_height <= 2147483647 {
        // DIB_RGB_COLORS (0) and SRCCOPY (0x00CC0020): the caller's pixels and
        // BITMAPINFO are lent for this synchronous draw only.
        let copied: i32 = WindowsGuiHost::stretch_dibits(device, 0, 0,
            dest_width as i32, dest_height as i32, 0, 0,
            source_width as i32, source_height as i32, &pixels[0], &info[0], 0, 0x00CC0020);
        transition copied > 0 { true -> result(copied) _ -> (0) }
    }
    machine result(copied: i32) -> u32 requires copied > 0 { copied as u32 }
}
public macos_arm64 machine calc_blit(window_state: &Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, mut pixels: [i32; 4096], info: [i32; 11]) -> u32
reaches
    GlobalInputObservation + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit invokes ObjectiveC invokes CoreGraphics invokes MacosImageData invokes MacosImageObjects {
    macos_window_blit(window_state, device, dest_width, dest_height, source_width, source_height, pixels, info)
}

// One Windows pump removes, translates and dispatches; the application keeps
// the decomposed peek/translate/dispatch contract of the Gui row. The peeked
// message is copied out so close detection still reads the raw fields.
public windows_x86_64 machine calc_msg_peek(window_state: &mut Window, mut message: [u64; 6]) -> u32
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit invokes WindowsGuiHost {
    let mut native: WindowsMessage;
    let pumped: bool = WindowsGuiHost::pump_message(&mut native);
    // The row contract's caller buffer keeps the window/kind/wParam layout the
    // close-detection reads; lParam/time/pt stay zero (the sample reads none).
    message[0] = WindowsMessage::window(&native);
    message[1] = WindowsMessage::kind(&native);
    message[2] = WindowsMessage::word_parameter(&native);
    message[3] = 0;
    message[4] = 0;
    message[5] = 0;
    transition pumped { true -> (1) _ -> (0) }
}
public macos_arm64 machine calc_msg_peek(window_state: &mut Window, mut message: [u64; 6]) -> u32
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit invokes ObjectiveC {
    macos_window_msg_peek(window_state, message)
}

