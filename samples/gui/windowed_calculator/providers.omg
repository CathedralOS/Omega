// Windows pacing is a direct Build::bind of kernel32 Sleep; the non-blocking
// Clock row cannot call the blocking TimeHost::sleep, so only macOS carries
// this family member.
public macos_arm64 machine calc_sleep(milliseconds: u32)
reaches ClockObservation + ExecutionDelay invokes DarwinClock {
    macos_sleep(milliseconds);
}
