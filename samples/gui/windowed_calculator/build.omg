// windowed_calculator is a real GUI subsystem app: no attached console box.
machine build(builder: &mut Build) {
    Build::application(builder, "windowed_calculator");
    builder.identifier = "com.omega.windowed-calculator";
    Build::depend(builder, Source::Path {
        location: "../../../source/library/std"
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::select_provider<Gui, CalcGuiProvider>(builder, linux_arm64);
    Build::select_provider<Gui, CalcGuiProvider>(builder, linux_x86_64);
    Build::select_provider<Gui, CalcGuiProvider>(builder, macos_arm64);
    Build::select_provider<Gui, CalcGuiProvider>(builder, macos_x86_64);
    Build::select_provider<Gui, CalcGuiProvider>(builder, windows_x86_64);
    Build::select_provider<Gui, CalcGuiProvider>(builder, uefi_x86_64);
    Build::select_provider<Gui, CalcGuiProvider>(builder, cross_platform_cli);
    Build::select_provider<Gui, CalcGuiProvider>(builder, local_unchecked);
    Build::select_provider<Gui, CalcGuiProvider>(builder, alpha_bootstrap);
    Build::select_provider<Input, CalcInputProvider>(builder, linux_arm64);
    Build::select_provider<Input, CalcInputProvider>(builder, linux_x86_64);
    Build::select_provider<Input, CalcInputProvider>(builder, macos_arm64);
    Build::select_provider<Input, CalcInputProvider>(builder, macos_x86_64);
    Build::select_provider<Input, CalcInputProvider>(builder, windows_x86_64);
    Build::select_provider<Input, CalcInputProvider>(builder, uefi_x86_64);
    Build::select_provider<Input, CalcInputProvider>(builder, cross_platform_cli);
    Build::select_provider<Input, CalcInputProvider>(builder, local_unchecked);
    Build::select_provider<Input, CalcInputProvider>(builder, alpha_bootstrap);
    Build::select_provider<Clock, CalcClockProvider>(builder, linux_arm64);
    Build::select_provider<Clock, CalcClockProvider>(builder, linux_x86_64);
    Build::select_provider<Clock, CalcClockProvider>(builder, macos_arm64);
    Build::select_provider<Clock, CalcClockProvider>(builder, macos_x86_64);
    Build::select_provider<Clock, CalcClockProvider>(builder, windows_x86_64);
    Build::select_provider<Clock, CalcClockProvider>(builder, uefi_x86_64);
    Build::select_provider<Clock, CalcClockProvider>(builder, cross_platform_cli);
    Build::select_provider<Clock, CalcClockProvider>(builder, local_unchecked);
    Build::select_provider<Clock, CalcClockProvider>(builder, alpha_bootstrap);
    builder.subsystem = Subsystem::Gui;
}
