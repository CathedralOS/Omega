// windowed_calculator is a real GUI subsystem app: no attached console box.
use main.omg as app;
use {omega}/build/dependency.omg;
use {omega}/language/core/external_binding.omg as native;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "windowed_calculator" };
    builder.identifier = "com.omega.windowed-calculator";
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled {
        name: "system"
    }));
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::Gui, |app|::CalcGuiProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Gui, |app|::CalcGuiProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Input, |app|::CalcInputProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Input, |app|::CalcInputProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Clock, |app|::CalcClockProvider>(builder, macos_arm64);
    Build::bind_native::<|app|::Clock::sleep>(builder, windows_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::PeByName { library: "kernel32.dll", export: "Sleep" }
    });
    builder.subsystem = Subsystem::Gui;
}
