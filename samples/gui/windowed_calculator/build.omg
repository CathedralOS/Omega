// windowed_calculator is a real GUI subsystem app: no attached console box.
machine build(b: &mut Build) {
    b.roots.bind(windows_x86_64::ProgramEntry, Main::main);
    b.roots.bind(macos_arm64::ProgramEntry, Main::main);
    b.subsystem = Subsystem::Gui;
}

target windows_x64 {
}

target macos_arm64 {
}
