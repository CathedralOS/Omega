// window_demo is a REAL windowed application: the GUI subsystem keeps Windows from
// attaching a console box (PE Subsystem 2).
machine build(builder: &mut Build) {
    Build::application(builder, "window_demo");
    builder.identifier = "com.omega.window-demo";
    Build::depend(builder, Source::Path {
        location: "../../../source/library/std"
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::select_provider<Gui, DemoGuiProvider>(builder, linux_arm64);
    Build::select_provider<Gui, DemoGuiProvider>(builder, linux_x86_64);
    Build::select_provider<Gui, DemoGuiProvider>(builder, macos_arm64);
    Build::select_provider<Gui, DemoGuiProvider>(builder, macos_x86_64);
    Build::select_provider<Gui, DemoGuiProvider>(builder, windows_x86_64);
    Build::select_provider<Gui, DemoGuiProvider>(builder, uefi_x86_64);
    Build::select_provider<Gui, DemoGuiProvider>(builder, cross_platform_cli);
    Build::select_provider<Gui, DemoGuiProvider>(builder, local_unchecked);
    Build::select_provider<Gui, DemoGuiProvider>(builder, alpha_bootstrap);
    builder.subsystem = Subsystem::Gui;
}
