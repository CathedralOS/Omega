// window_demo is a REAL windowed application: the GUI subsystem keeps Windows from
// attaching a console box (PE Subsystem 2).
use main.omg as app;
use providers.omg;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "window_demo" };
    builder.identifier = "com.omega.window-demo";
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled {
        name: "system"
    }));
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::Gui, |providers|::WindowsGuiProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Gui, |providers|::MacosGuiProvider>(builder, macos_arm64);
    builder.subsystem = Subsystem::Gui;
}
