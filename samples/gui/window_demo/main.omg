// Render 60 frames of a 64x64 diagonal color wash in a native 256x256
// macOS window, paced at 25 ms with an event pump between frames.
// Persistent handles are explicit application-owned state; provider selection
// chooses stateless code. Per-frame images and the final window are released.
// Expected exit: 0. No stdin is required.
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::binding;
use omega::language::core::float_operations;
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }
pub boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> Window
        invokes ObjectiveC; invokes CoreGraphics;
    machine window_destroy(window: Window) invokes ObjectiveC; invokes CoreGraphics;
    machine get_dc(window_state: &Window, window: u64) -> u64;
    machine msg_peek(window_state: &mut Window, message: [u64; 6]) -> u32 invokes ObjectiveC;
    machine msg_translate(window_state: &Window, message: [u64; 6]) -> u32;
    machine msg_dispatch(window_state: &Window, message: [u64; 6]) -> u64 invokes ObjectiveC;
    machine is_window(window_state: &Window, window: u64) -> u32 invokes ObjectiveC;
    machine blit(window_state: &Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        invokes ObjectiveC; invokes CoreGraphics;
}
// FULLY EXACT -- no overflow domain anywhere. The two loop counters carry
// ranges and their increments are GUARD-PROVEN (the dominating-guard keystone:
// `i < 4096` on the edge into fill_put proves `i + 1` lands in [0..=4096]);
// the pixel wash folds through `% 256` (modulo bounds by the divisor, so the
// whole expression is verifiably bounded and the intermediates stay plain
// Exact i32).
// Persistent native handles belong to the application-owned Window. Provider
// selection supplies only code; each operation keeps its scratch in locals.
pub data Window {
    window: u64;
    view: u64;
    app: u64;
    space: u64;
    date: u64;
    mode: u64;
    psel: u64;
    mask: u64;
    evt: u64;
    relsel: u64;
    dsel: u64;
    vsel: u64;
    ksel: u64;
    pool: u64;
}
DemoGuiProvider satisfies Gui {
    Gui::window_create = demo_window_create;
    Gui::window_destroy = demo_window_destroy;
    Gui::get_dc = demo_get_dc;
    Gui::msg_peek = demo_msg_peek;
    Gui::msg_translate = demo_msg_translate;
    Gui::msg_dispatch = demo_msg_dispatch;
    Gui::is_window = demo_is_window;
    Gui::blit = demo_blit;
}
macos_arm64 machine demo_window_create(class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> Window
reaches CoreGraphics + ObjectiveC
{
    let rx: f64 = F64::from_i32(x);
    let ry: f64 = F64::from_i32(y);
    let mut rw: f64 = F64::from_i32(width);
    let mut rh: f64 = F64::from_i32(height);
    rw = rw - 16.0;
    rh = rh - 39.0;
    let cbuf1: [u8; 14] = "NSApplication\0";
    let mut cls: u64 = objc_get_class(&cbuf1[0]);
    let cbuf2: [u8; 18] = "sharedApplication\0";
    let mut sel: u64 = objc_register_selector(&cbuf2[0]);
    let app: u64 = objc_send(cls, sel);
    let cbuf3: [u8; 21] = "setActivationPolicy:\0";
    sel = objc_register_selector(&cbuf3[0]);
    let mut rc: u64 = objc_send_scalar(app, sel, 0);
    let cbuf4: [u8; 9] = "NSWindow\0";
    cls = objc_get_class(&cbuf4[0]);
    let cbuf5: [u8; 6] = "alloc\0";
    sel = objc_register_selector(&cbuf5[0]);
    let mut tmp: u64 = objc_send(cls, sel);
    let cbuf6: [u8; 45] = "initWithContentRect:styleMask:backing:defer:\0";
    sel = objc_register_selector(&cbuf6[0]);
    let window: u64 = objc_send_rect(tmp, sel, rx, ry, rw, rh, 15, 2, 0);
    // Closing hides the window; the explicit owner releases it exactly once.
    let release_on_close_name: [u8; 23] = "setReleasedWhenClosed:\0";
    sel = objc_register_selector(&release_on_close_name[0]);
    rc = objc_send_scalar(window, sel, 0);
    let cbuf7: [u8; 12] = "NSImageView\0";
    cls = objc_get_class(&cbuf7[0]);
    let cbuf8: [u8; 6] = "alloc\0";
    sel = objc_register_selector(&cbuf8[0]);
    tmp = objc_send(cls, sel);
    let cbuf9: [u8; 15] = "initWithFrame:\0";
    sel = objc_register_selector(&cbuf9[0]);
    let view: u64 = objc_send_rect(tmp, sel, rx, ry, rw, rh, 0, 0, 0);
    let cbuf10: [u8; 17] = "setImageScaling:\0";
    sel = objc_register_selector(&cbuf10[0]);
    rc = objc_send_scalar(view, sel, 1);
    let cbuf11: [u8; 16] = "setContentView:\0";
    sel = objc_register_selector(&cbuf11[0]);
    rc = objc_send_scalar(window, sel, view);
    let cbuf12: [u8; 8] = "release\0";
    let relsel: u64 = objc_register_selector(&cbuf12[0]);
    let cbuf13: [u8; 9] = "NSString\0";
    cls = objc_get_class(&cbuf13[0]);
    let cbuf14: [u8; 6] = "alloc\0";
    sel = objc_register_selector(&cbuf14[0]);
    tmp = objc_send(cls, sel);
    let cbuf15: [u8; 20] = "initWithUTF8String:\0";
    sel = objc_register_selector(&cbuf15[0]);
    tmp = objc_send_byte_string(tmp, sel, &title[0]);
    let cbuf16: [u8; 10] = "setTitle:\0";
    sel = objc_register_selector(&cbuf16[0]);
    rc = objc_send_scalar(window, sel, tmp);
    rc = objc_send(tmp, relsel);
    let cbuf17: [u8; 7] = "center\0";
    sel = objc_register_selector(&cbuf17[0]);
    rc = objc_send(window, sel);
    let cbuf18: [u8; 22] = "makeKeyAndOrderFront:\0";
    sel = objc_register_selector(&cbuf18[0]);
    rc = objc_send_scalar(window, sel, 0);
    let cbuf19: [u8; 27] = "activateIgnoringOtherApps:\0";
    sel = objc_register_selector(&cbuf19[0]);
    rc = objc_send_scalar(app, sel, 1);
    let space: u64 = cg_color_space_rgb();
    // Pump scratch, once: the distantPast date, the run-loop-mode NSString, the
    // nextEvent/sendEvent:/isVisible/keyWindow selectors, and the event mask.
    let cbuf20: [u8; 7] = "NSDate\0";
    cls = objc_get_class(&cbuf20[0]);
    let cbuf21: [u8; 12] = "distantPast\0";
    sel = objc_register_selector(&cbuf21[0]);
    let date: u64 = objc_send(cls, sel);
    let cbuf22: [u8; 9] = "NSString\0";
    cls = objc_get_class(&cbuf22[0]);
    let cbuf23: [u8; 6] = "alloc\0";
    sel = objc_register_selector(&cbuf23[0]);
    tmp = objc_send(cls, sel);
    let cbuf24: [u8; 20] = "initWithUTF8String:\0";
    sel = objc_register_selector(&cbuf24[0]);
    let cbuf25: [u8; 22] = "kCFRunLoopDefaultMode\0";
    let mode: u64 = objc_send_string(tmp, sel, &cbuf25[0]);
    let cbuf26: [u8; 48] = "nextEventMatchingMask:untilDate:inMode:dequeue:\0";
    let psel: u64 = objc_register_selector(&cbuf26[0]);
    let mask: u64 = 4294967295;
    let cbuf27: [u8; 11] = "sendEvent:\0";
    let dsel: u64 = objc_register_selector(&cbuf27[0]);
    let cbuf28: [u8; 10] = "isVisible\0";
    let vsel: u64 = objc_register_selector(&cbuf28[0]);
    let cbuf29: [u8; 10] = "keyWindow\0";
    let ksel: u64 = objc_register_selector(&cbuf29[0]);
    // Open the pool carried between explicit event-pump calls.
    let pool: u64 = objc_pool_push();
    Window {
        window: window,
        view: view,
        app: app,
        space: space,
        date: date,
        mode: mode,
        psel: psel,
        mask: mask,
        evt: 0,
        relsel: relsel,
        dsel: dsel,
        vsel: vsel,
        ksel: ksel,
        pool: pool,
    }
}
macos_arm64 machine demo_window_destroy(window: Window)
reaches CoreGraphics + ObjectiveC
{
    let close_name: [u8; 6] = "close\0";
    let close_selector: u64 = objc_register_selector(&close_name[0]);
    let mut ignored: u64 = objc_send(window.window, close_selector);
    ignored = objc_send(window.window, window.relsel);
    ignored = objc_send(window.view, window.relsel);
    ignored = objc_send(window.mode, window.relsel);
    cg_color_space_release(window.space);
    ignored = objc_pool_pop(window.pool);
}
macos_arm64 machine demo_get_dc(window_state: &Window, window: u64) -> u64
{
    transition { _ -> ret(window) }
    state ret(window: u64) -> u64 { window }
}
macos_arm64 machine demo_msg_peek(window_state: &mut Window, message: [u64; 6]) -> u32
reaches ObjectiveC
{
    // Cycle the rolling autorelease pool opened at window_create: the pop
    // drains the PREVIOUS peek's autoreleased NSEvent (already dispatched by
    // then), the push opens the scope this peek's event lands in. The date,
    // mode string, selector, and mask are window_create-cached — this machine
    // used to rebuild all four (and leak the NSString) on every single peek.
    let rc: u64 = objc_pool_pop(window_state.pool);
    window_state.pool = objc_pool_push();
    window_state.evt = objc_send_scalar4(window_state.app, window_state.psel, window_state.mask, window_state.date, window_state.mode, 1);
    // Arm states must stay side-effect-free (the value-call effect fence):
    // both arms complete with a pure terminal value instead of mutating r32.
    transition window_state.evt != 0 { true -> got() _ -> ret() }
    state got() -> u32 { 1 }
    state ret() -> u32 { 0 }
}
macos_arm64 machine demo_msg_translate(window_state: &Window, message: [u64; 6]) -> u32
{
    let r32: u32 = 1;
    r32
}
macos_arm64 machine demo_msg_dispatch(window_state: &Window, message: [u64; 6]) -> u64
reaches ObjectiveC
{
    let rc: u64 = objc_send_scalar(window_state.app, window_state.dsel, window_state.evt);
    rc
}
macos_arm64 machine demo_is_window(window_state: &Window, window: u64) -> u32
reaches ObjectiveC
{
    let rc: u64 = objc_send(window, window_state.vsel);
    let r32: u32 = narrow_u64_to_u32_wrapping(rc);
    r32
}
macos_arm64 machine demo_blit(window_state: &Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
reaches CoreGraphics + ObjectiveC
{
    let source_width_wide: i64 = source_width as i64;
    let source_height_wide: i64 = source_height as i64;
    let fbw: i64 = source_width_wide;
    let fbh: i64 = source_height_wide;
    let stride: i64 = source_width_wide << 2;
    let fbwf: f64 = F64::from_u32(source_width);
    let fbhf: f64 = F64::from_u32(source_height);
    let ctx: u64 = cg_bitmap_context(&pixels[0], fbw, fbh, 8, stride, window_state.space, 8198);
    let cgimg: u64 = cg_bitmap_context_image(ctx);
    let cbuf30: [u8; 8] = "NSImage\0";
    let cls: u64 = objc_get_class(&cbuf30[0]);
    let cbuf31: [u8; 6] = "alloc\0";
    let mut sel: u64 = objc_register_selector(&cbuf31[0]);
    let tmp: u64 = objc_send(cls, sel);
    let cbuf32: [u8; 22] = "initWithCGImage:size:\0";
    sel = objc_register_selector(&cbuf32[0]);
    let nsimg: u64 = objc_send_image_size(tmp, sel, cgimg, fbwf, fbhf);
    let cbuf33: [u8; 10] = "setImage:\0";
    sel = objc_register_selector(&cbuf33[0]);
    let mut rc: u64 = objc_send_scalar(window_state.view, sel, nsimg);
    // Per-frame lifecycle: the context and CGImage are Create-rule owned, and
    // setImage: retains the NSImage, so drop our +1 on all three — without
    // these releases every presented frame leaked ~3 objects at ~60fps.
    rc = cg_context_release(ctx);
    rc = cg_image_release(cgimg);
    rc = objc_send(nsimg, window_state.relsel);
    // The samples assert `blit == source_height` (every source scanline copied).
    let r32: u32 = source_height;
    r32
}

DemoClockProvider satisfies Clock {
    Clock::sleep = demo_sleep;
}
macos_arm64 machine demo_sleep(milliseconds: u32)
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    gui: Binding<Gui>;
    cls: [u8; 7];
    title: [u8; 11];
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    message: [u64; 6];
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    pumped: i32 [0..=16];
    copied: u32;
    frame: i32 [0..=60];
    i: i32 [0..=4096];
    c: i32;
    px: i32;
}
machine Main::main(main: &mut Main) reaches Clock + Console + CoreGraphics + DarwinClock + Gui + ObjectiveC {
    // "#32770\0" -- the predefined dialog class. Unlike the STATIC control
    // class, this behaves like a draggable top-level app window in practice.
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;
    // "omega demo\0"
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 100;
    main.title[7] = 101;
    main.title[8] = 109;
    main.title[9] = 111;
    main.title[10] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;
    // WS_VISIBLE | WS_OVERLAPPEDWINDOW (0x10CF0000): a real titled app window,
    // not a naked popup. The outer size is padded (+16, +39)
    // so the CLIENT area is ~256x256 without an AdjustWindowRect import.
    // The created resource is owned by the state machine, independently of
    // its borrowed rendering context. Each transition transfers that owner.
    let window: Window = main.gui.window_create(main.cls, main.title, 282001408, 200, 200, 272, 295);
    main.hwnd = window.window;
    transition main.hwnd > 0 { true -> dc(main, window) _ -> bad(main, window) }
    state dc(main: &mut Main, window: Window) {
        main.hdc = main.gui.get_dc(&window, main.hwnd);
        main.frame = 0;
        transition main.hdc > 0 { true -> frame_loop(main, window) _ -> bad(main, window) }
    }
    state frame_loop(main: &mut Main, window: Window) {
        transition main.frame < 60 { true -> fill_init(main, window) _ -> finish(main, window) }
    }
    // --- fill the framebuffer: one linear pass, an animated diagonal wash ---
    state fill_init(main: &mut Main, window: Window) {
        main.i = 0;
        transition { _ -> fill_loop(main, window) }
    }
    state fill_loop(main: &mut Main, window: Window) {
        transition main.i >= 0 && main.i < 4096 { true -> fill_cell(main, window) _ -> present(main, window) }
    }
    state fill_cell(main: &mut Main, window: Window) {
        // row + col + phase, folded through % 256: i/64 <= 64, i%64 <= 63,
        // frame*4 <= 240 -- every step provably bounded, no domain needed.
        main.c = (main.i / 64) + (main.i % 64);
        main.c = main.c + main.frame * 4;
        main.c = main.c % 256;
        // red ramps up the diagonal while blue ramps down: a scrolling wash.
        main.px = main.c * 65536;
        main.px = main.px + (255 - main.c) * 256;
        main.px = main.px + 64;
        transition main.i >= 0 && main.i < 4096 { true -> fill_put(main, window) _ -> bad(main, window) }
    }
    state fill_put(main: &mut Main, window: Window) {
        main.pixels[main.i] = main.px;
        main.i = main.i + 1;
        transition { _ -> fill_loop(main, window) }
    }
    // --- present: stretch the 64x64 buffer into the 256x256 client area ---
    state present(main: &mut Main, window: Window) {
        main.copied = main.gui.blit(&window, main.hdc, 256, 256, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main, window) _ -> bad(main, window) }
    }
    state pace(main: &mut Main, window: Window) {
        main.clock.sleep(25);
        transition { _ -> pump_init(main, window) }
    }
    // --- pump: drain queued messages so the titlebar responds (drag, X) ---
    state pump_init(main: &mut Main, window: Window) {
        main.pumped = 0;
        transition { _ -> pump_loop(main, window) }
    }
    state pump_loop(main: &mut Main, mut window: Window) {
        main.have = main.gui.msg_peek(&mut window, main.message);
        transition main.have > 0 { true -> pump_handle(main, window) _ -> liveness(main, window) }
    }
    state pump_handle(main: &mut Main, window: Window) {
        main.translated = main.gui.msg_translate(&window, main.message);
        main.dispatched = main.gui.msg_dispatch(&window, main.message);
        transition main.pumped < 16 { true -> pump_next(main, window) _ -> liveness(main, window) }
    }
    state pump_next(main: &mut Main, window: Window) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main, window) }
    }
    // --- liveness: if the window is destroyed, stop blitting into it ---
    state liveness(main: &mut Main, window: Window) {
        main.alive = main.gui.is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> next_frame(main, window) _ -> bad(main, window) }
    }
    state next_frame(main: &mut Main, window: Window) {
        // re-guard so the increment's edge carries the frame bound (the
        // keystone reads the DIRECT incoming edge; frame_loop's guard is
        // several states upstream by now).
        transition main.frame < 60 { true -> advance(main, window) _ -> finish(main, window) }
    }
    state advance(main: &mut Main, window: Window) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main, window) }
    }
    state finish(main: &mut Main, window: Window) {
        transition main.frame == 60 { true -> complete(main, window) _ -> bad(main, window) }
    }
    state complete(main: &mut Main, window: Window) {
        main.gui.window_destroy(window);
        main.console.write_line("PASS: 60 frames blitted (exit 0)");
        main.console.exit_process(0);
    }
    state bad(main: &mut Main, window: Window) {
        main.console.write_line("FAIL: creation, rendering, or window closure before 60 frames (exit 1)");
        main.console.exit_process(1);
    }
}
