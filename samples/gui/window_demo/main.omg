use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/clock.omg;
use {system}/console.omg;
use {system}/macos_gui.omg;
use {system}/macos_image.omg;
use {system}/windows_gui_host.omg;
// Render 60 frames of a 64x64 diagonal color wash in a native 256x256
// window, paced at 25 ms with an event pump between frames.
// Persistent handles are explicit application-owned state; provider selection
// chooses stateless code. Per-frame images and the final window are released.
// Expected exit: 0. No stdin is required.
// Expected output contains: PASS: 60 frames blitted (exit 0)
// Both targets select stateless implementations; the application owns every
// native handle and the Windows message buffer throughout the render loop.
public boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> |macos_gui|::Window
    requires title[10] == 0
        reaches
            NativeCodeExecution + WindowManagement + SurfacePresentation +
            WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
            ClockObservation + ExecutionDelay + FilesystemContentRead +
            FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
            DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
            |process_authority|::StandardOutput + |process_exit|::ProcessExit
        invokes |macos_gui|::AppKit invokes |macos_gui|::CoreGraphics invokes |macos_gui|::ObjectiveC invokes |windows_gui_host|::WindowsGuiHost crashes none;
    machine window_destroy(window: |macos_gui|::Window, device: u64) -> bool
        reaches
            GlobalInputObservation + NativeCodeExecution + WindowManagement +
            SurfacePresentation + WindowEventObservation + WindowEventDispatch +
            ClockObservation + ExecutionDelay + FilesystemContentRead +
            FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
            DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
            |process_authority|::StandardOutput + |process_exit|::ProcessExit
        invokes |macos_gui|::CoreGraphics invokes |macos_gui|::ObjectiveC invokes |windows_gui_host|::WindowsGuiHost crashes none;
    machine get_dc(window_state: @|macos_gui|::Window, window: u64) -> u64 reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
        |process_authority|::StandardOutput + |process_exit|::ProcessExit invokes |windows_gui_host|::WindowsGuiHost crashes none;
    machine pump_message(window_state: @mutable |macos_gui|::Window, message: @mutable |windows_gui_host|::WindowsMessage, close_requested: @mutable bool) -> u32 reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
        |process_authority|::StandardOutput + |process_exit|::ProcessExit invokes |macos_gui|::ObjectiveC invokes |windows_gui_host|::WindowsGuiHost crashes none;
    machine is_window(window_state: @|macos_gui|::Window, window: u64) -> u32 reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
        |process_authority|::StandardOutput + |process_exit|::ProcessExit invokes |macos_gui|::ObjectiveC invokes |windows_gui_host|::WindowsGuiHost crashes none;
    machine blit(window_state: @|macos_gui|::Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        reaches
            GlobalInputObservation + NativeCodeExecution + WindowManagement +
            SurfacePresentation + WindowEventObservation + WindowEventDispatch +
            ClockObservation + ExecutionDelay + FilesystemContentRead +
            FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
            DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
            |process_authority|::StandardOutput + |process_exit|::ProcessExit
        invokes |macos_gui|::CoreGraphics invokes |macos_gui|::ObjectiveC invokes |windows_gui_host|::WindowsGuiHost invokes |macos_image|::MacosImageData invokes |macos_image|::MacosImageObjects crashes none;
}
// FULLY EXACT -- no overflow domain anywhere. The two loop counters carry
// ranges and their increments are GUARD-PROVEN (the dominating-guard keystone:
// `i < 4096` on the edge into fill_put proves `i + 1 <= 4096`);
// the pixel wash folds through `% 256` (modulo bounds by the divisor, so the
// whole expression is verifiably bounded and the intermediates stay plain
// Exact i32).

data Main
requires
    self.pumped >= 0 && self.pumped <= 16,
    self.frame >= 0 && self.frame <= 60,
    self.i >= 0 && self.i <= 4096,
{
    cls: [u8; 7];
    title: [u8; 11];
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    message: |windows_gui_host|::WindowsMessage;
    close_requested: bool;
    have: u32;
    alive: u32;
    pumped: i32;
    copied: u32;
    frame: i32;
    i: i32;
    c: i32;
    px: i32;
}
machine Main::main(main: @mutable Main) reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
    |process_authority|::StandardOutput + |process_exit|::ProcessExit + |clock|::Clock + Gui {
    // "#32770\0" -- the predefined dialog class. Unlike the STATIC control
    // class, this behaves like a draggable top-level app window in practice.
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;
    // "omega demo\0"
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 100;
    main.title[7] = 101;
    main.title[8] = 109;
    main.title[9] = 111;
    main.title[10] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 0x00200001; // packed 32-bit pixels and one color plane.
    // WS_VISIBLE | WS_OVERLAPPEDWINDOW (0x10CF0000): a real titled app window,
    // not a naked popup. Target adapters create exactly a 256x256 client area.
    // The created resource is owned by the state machine, independently of
    // its borrowed rendering context. Each transition transfers that owner.
    main.close_requested = false;
    main.hdc = 0;
    let mutable window: |macos_gui|::Window = Gui::window_create(main.cls, main.title, 0x10CF0000, 200, 200, 256, 256);
    main.hwnd = window.window;
    transition main.hwnd > 0 { true -> dc(main, window), _ -> bad(main, window) }
    machine dc(main: @mutable Main, window: |macos_gui|::Window) {
        main.hdc = Gui::get_dc(@window, main.hwnd);
        main.frame = 0;
        transition main.hdc > 0 { true -> frame_loop(main, window), _ -> bad(main, window) }
    }
    machine frame_loop(main: @mutable Main, window: |macos_gui|::Window) {
        transition main.frame < 60 { true -> fill_init(main, window), _ -> finish(main, window) }
    }
    // --- fill the framebuffer: one linear pass, an animated diagonal wash ---
    machine fill_init(main: @mutable Main, window: |macos_gui|::Window) {
        main.i = 0;
        transition { _ -> fill_loop(main, window) }
    }
    machine fill_loop(main: @mutable Main, window: |macos_gui|::Window) {
        transition main.i >= 0 && main.i < 4096 { true -> fill_cell(main, window), _ -> present(main, window) }
    }
    machine fill_cell(main: @mutable Main, window: |macos_gui|::Window) {
        // row + col + phase, folded through % 256: i/64 <= 64, i%64 <= 63,
        // frame*4 <= 240 -- every step provably bounded, no domain needed.
        main.c = (main.i / 64) + (main.i % 64);
        main.c = main.c + main.frame * 4;
        main.c = main.c % 256;
        // red ramps up the diagonal while blue ramps down: a scrolling wash.
        main.px = main.c * 0x00010000;
        main.px = main.px + (0xFF - main.c) * 256;
        main.px = main.px + 64;
        transition main.i >= 0 && main.i < 4096 { true -> fill_put(main, window), _ -> bad(main, window) }
    }
    machine fill_put(main: @mutable Main, window: |macos_gui|::Window) {
        main.pixels[main.i] = main.px;
        main.i = main.i + 1;
        transition { _ -> fill_loop(main, window) }
    }
    // --- present: stretch the 64x64 buffer into the 256x256 client area ---
    machine present(main: @mutable Main, window: |macos_gui|::Window) {
        main.copied = Gui::blit(@window, main.hdc, 256, 256, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main, window), _ -> bad(main, window) }
    }
    machine pace(main: @mutable Main, window: |macos_gui|::Window) {
        block |clock|::Clock::sleep(25);
        transition { _ -> pump_init(main, window) }
    }
    // --- pump: drain queued messages so the titlebar responds (drag, X) ---
    machine pump_init(main: @mutable Main, window: |macos_gui|::Window) {
        main.pumped = 0;
        transition { _ -> pump_loop(main, window) }
    }
    machine pump_loop(main: @mutable Main, mutable window: |macos_gui|::Window) {
        main.have = Gui::pump_message(@mutable window, @mutable main.message, @mutable main.close_requested);
        transition main.have > 0 { true -> pump_handle(main, window), _ -> liveness(main, window) }
    }
    machine pump_handle(main: @mutable Main, window: |macos_gui|::Window) {
        transition main.pumped < 16 { true -> pump_next(main, window), _ -> liveness(main, window) }
    }
    machine pump_next(main: @mutable Main, window: |macos_gui|::Window) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main, window) }
    }
    // --- liveness: if the window is destroyed, stop blitting into it ---
    machine liveness(main: @mutable Main, window: |macos_gui|::Window) {
        main.alive = Gui::is_window(@window, main.hwnd);
        transition main.alive > 0 && !main.close_requested { true -> next_frame(main, window), _ -> bad(main, window) }
    }
    machine next_frame(main: @mutable Main, window: |macos_gui|::Window) {
        // re-guard so the increment's edge carries the frame bound (the
        // keystone reads the DIRECT incoming edge; frame_loop's guard is
        // several states upstream by now).
        transition main.frame < 60 { true -> advance(main, window), _ -> finish(main, window) }
    }
    machine advance(main: @mutable Main, window: |macos_gui|::Window) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main, window) }
    }
    machine finish(main: @mutable Main, window: |macos_gui|::Window) {
        transition main.frame == 60 { true -> complete(main, window), _ -> bad(main, window) }
    }
    machine complete(main: @mutable Main, window: |macos_gui|::Window) {
        let cleaned: bool = Gui::window_destroy(window, main.hdc);
        transition cleaned { true -> passed(main), _ -> failed(main) }
    }
    machine passed(main: @mutable Main) {
        |console|::Console::write_line("PASS: 60 frames blitted (exit 0)");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine bad(main: @mutable Main, window: |macos_gui|::Window) {
        let cleaned: bool = Gui::window_destroy(window, main.hdc);
        transition { _ -> failed(main) }
    }
    machine failed(main: @mutable Main) {
        |console|::Console::write_line("FAIL: creation, rendering, or window closure before 60 frames (exit 1)");
        |process_exit|::ProcessExit::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + |process_authority|::StandardInput +
    |process_authority|::StandardOutput + |process_exit|::ProcessExit + |clock|::Clock + Gui {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
