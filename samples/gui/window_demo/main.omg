// A REAL WINDOW rendered by Omega native code -- the Tier-2 windowed-software-renderer
// milestone. CreateWindowExA through the predefined dialog class (no WNDCLASS, no WndProc,
// with a per-frame message pump so the titlebar responds to dragging), a titled app window
// (WS_VISIBLE|WS_OVERLAPPEDWINDOW = 0x10CF0000), then
// 60 frames of an animated diagonal color wash: a 64x64 [i32] framebuffer filled per-cell
// with a SINGLE linear counter (row = i >> 6, col = i & 63 -- no unprovable y*W+x index),
// stretched 4x by StretchDIBits into the 256x256 client area, paced by Clock.sleep. The
// BITMAPINFO is a plain [i32; 11] built in code (biSize=40, biWidth=64, biHeight=-64 for
// top-down, planes|bitcount word 0x00200001). Every blit must report 64 copied source
// scanlines. Runs ~1.5s of visible animation, then exits 0.
// Expected exit: 0
// GUI-subsystem app: the console surface is exit + a PASS/FAIL line for
// terminal runs (invisible from Finder). No stdin — a windowed app must never
// block on a console.
use omega_language_std::console;
boundary trait Clock { machine sleep(milliseconds: u32); }
boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64;
    machine get_dc(window: u64) -> u64;
    machine msg_peek(message: [u64; 6]) -> u32;
    machine msg_translate(message: [u64; 6]) -> u32;
    machine msg_dispatch(message: [u64; 6]) -> u64;
    machine is_window(window: u64) -> u32;
    machine blit(device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32;
}
// FULLY EXACT -- no overflow domain anywhere. The two loop counters carry
// ranges and their increments are GUARD-PROVEN (the dominating-guard keystone:
// `i < 4096` on the edge into fill_put proves `i + 1` lands in [0..=4096]);
// the pixel wash folds through `% 256` (modulo bounds by the divisor, so the
// whole expression is verifiably bounded and the intermediates stay plain
// Exact i32).
data Main {
    console: Console;
    clock: Clock;
    gui: Gui;
    cls: [u8; 7];
    title: [u8; 11];
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    message: [u64; 6];
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    pumped: i32 [0..=16];
    copied: u32;
    frame: i32 [0..=60];
    i: i32 [0..=4096];
    c: i32;
    px: i32;
}
machine Main::main(&mut self) {
    // "#32770\0" -- the predefined dialog class. Unlike the STATIC control
    // class, this behaves like a draggable top-level app window in practice.
    self.cls[0] = 35;
    self.cls[1] = 51;
    self.cls[2] = 50;
    self.cls[3] = 55;
    self.cls[4] = 55;
    self.cls[5] = 48;
    self.cls[6] = 0;
    // "omega demo\0"
    self.title[0] = 111;
    self.title[1] = 109;
    self.title[2] = 101;
    self.title[3] = 103;
    self.title[4] = 97;
    self.title[5] = 32;
    self.title[6] = 100;
    self.title[7] = 101;
    self.title[8] = 109;
    self.title[9] = 111;
    self.title[10] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    self.info[0] = 40;
    self.info[1] = 64;
    self.info[2] = 0 - 64;
    self.info[3] = 2097153;
    // WS_VISIBLE | WS_OVERLAPPEDWINDOW (0x10CF0000): a real titled app window,
    // not a naked popup. The outer size is padded (+16, +39)
    // so the CLIENT area is ~256x256 without an AdjustWindowRect import.
    self.hwnd = self.gui.window_create(self.cls, self.title, 282001408, 200, 200, 272, 295);
    transition self.hwnd > 0 { true -> dc() _ -> bad() }
    state dc(&mut self) {
        self.hdc = self.gui.get_dc(self.hwnd);
        self.frame = 0;
        transition self.hdc > 0 { true -> frame_loop() _ -> bad() }
    }
    state frame_loop(&mut self) {
        transition self.frame < 60 { true -> fill_init() _ -> finish() }
    }
    // --- fill the framebuffer: one linear pass, an animated diagonal wash ---
    state fill_init(&mut self) {
        self.i = 0;
        transition { _ -> fill_loop() }
    }
    state fill_loop(&mut self) {
        transition self.i >= 0 && self.i < 4096 { true -> fill_cell() _ -> present() }
    }
    state fill_cell(&mut self) {
        // row + col + phase, folded through % 256: i/64 <= 64, i%64 <= 63,
        // frame*4 <= 240 -- every step provably bounded, no domain needed.
        self.c = ((self.i / 64) + (self.i % 64) + self.frame * 4) % 256;
        // red ramps up the diagonal while blue ramps down: a scrolling wash.
        self.px = (self.c * 65536) + ((255 - self.c) * 256) + 64;
        transition self.i >= 0 && self.i < 4096 { true -> fill_put() _ -> bad() }
    }
    state fill_put(&mut self) {
        self.pixels[self.i] = self.px;
        self.i = self.i + 1;
        transition { _ -> fill_loop() }
    }
    // --- present: stretch the 64x64 buffer into the 256x256 client area ---
    state present(&mut self) {
        self.copied = self.gui.blit(self.hdc, 256, 256, 64, 64, self.pixels, self.info);
        transition self.copied == 64 { true -> pace() _ -> bad() }
    }
    state pace(&mut self) {
        self.clock.sleep(25);
        transition { _ -> pump_init() }
    }
    // --- pump: drain queued messages so the titlebar responds (drag, X) ---
    state pump_init(&mut self) {
        self.pumped = 0;
        transition { _ -> pump_loop() }
    }
    state pump_loop(&mut self) {
        self.have = self.gui.msg_peek(self.message);
        transition self.have > 0 { true -> pump_handle() _ -> liveness() }
    }
    state pump_handle(&mut self) {
        self.translated = self.gui.msg_translate(self.message);
        self.dispatched = self.gui.msg_dispatch(self.message);
        transition self.pumped < 16 { true -> pump_next() _ -> liveness() }
    }
    state pump_next(&mut self) {
        self.pumped = self.pumped + 1;
        transition { _ -> pump_loop() }
    }
    // --- liveness: if the window is destroyed, stop blitting into it ---
    state liveness(&mut self) {
        self.alive = self.gui.is_window(self.hwnd);
        transition self.alive > 0 { true -> next_frame() _ -> finish() }
    }
    state next_frame(&mut self) {
        // re-guard so the increment's edge carries the frame bound (the
        // keystone reads the DIRECT incoming edge; frame_loop's guard is
        // several states upstream by now).
        transition self.frame < 60 { true -> advance() _ -> finish() }
    }
    state advance(&mut self) {
        self.frame = self.frame + 1;
        transition { _ -> frame_loop() }
    }
    state finish(&mut self) {
        self.console.write_line("PASS: 60 frames blitted (exit 0)");
        self.console.exit_process(0);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: window/DC creation or a blit assertion failed (exit 1)");
        self.console.exit_process(1);
    }
}
