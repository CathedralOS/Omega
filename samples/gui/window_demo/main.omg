// A REAL WINDOW rendered by Omega native code -- the Tier-2 windowed-software-renderer
// milestone. CreateWindowExA through the predefined dialog class (no WNDCLASS, no WndProc,
// with a per-frame message pump so the titlebar responds to dragging), a titled app window
// (WS_VISIBLE|WS_OVERLAPPEDWINDOW = 0x10CF0000), then
// 60 frames of an animated diagonal color wash: a 64x64 [i32] framebuffer filled per-cell
// with a SINGLE linear counter (row = i >> 6, col = i & 63 -- no unprovable y*W+x index),
// stretched 4x by StretchDIBits into the 256x256 client area, paced by Clock.sleep. The
// BITMAPINFO is a plain [i32; 11] built in code (biSize=40, biWidth=64, biHeight=-64 for
// top-down, planes|bitcount word 0x00200001). Every blit must report 64 copied source
// scanlines. Runs ~1.5s of visible animation, then exits 0.
// Expected exit: 0
// GUI-subsystem app: the console surface is exit + a PASS/FAIL line for
// terminal runs (invisible from Finder). No stdin — a windowed app must never
// block on a console.
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::binding;
use omega::language::core::float_operations;
pub boundary trait Clock { machine sleep(&mut self, milliseconds: u32) invokes DarwinClock; }
pub boundary trait Gui {
    machine window_create(&mut self, class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
        invokes ObjectiveC; invokes CoreGraphics;
    machine get_dc(&mut self, window: u64) -> u64;
    machine msg_peek(&mut self, message: [u64; 6]) -> u32 invokes ObjectiveC;
    machine msg_translate(&mut self, message: [u64; 6]) -> u32;
    machine msg_dispatch(&mut self, message: [u64; 6]) -> u64 invokes ObjectiveC;
    machine is_window(&mut self, window: u64) -> u32 invokes ObjectiveC;
    machine blit(&mut self, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        invokes ObjectiveC; invokes CoreGraphics;
}
// FULLY EXACT -- no overflow domain anywhere. The two loop counters carry
// ranges and their increments are GUARD-PROVEN (the dominating-guard keystone:
// `i < 4096` on the edge into fill_put proves `i + 1` lands in [0..=4096]);
// the pixel wash folds through `% 256` (modulo bounds by the divisor, so the
// whole expression is verifiably bounded and the intermediates stay plain
// Exact i32).
// The selected macOS provider closure: each provider owns the GUI scratch
// state directly (an adapter over a nested `inner` impl receiver mis-settles
// the retained write frame) and satisfies its sample boundary nominally —
// matching method names cannot establish satisfaction.
data DemoGuiProvider {
    // The current window + its image-view content (single-window apps).
    window: u64;
    view: u64;
    app: u64;
    // A device-RGB colorspace, created once at window_create and reused per blit.
    space: u64;
    // Staged blit dimensions (a host-call arg must be a storage place / literal,
    // not a live conversion expression, so the i64/f64 results land in fields).
    fbw: i64;
    fbh: i64;
    stride: i64;
    fbwf: f64;
    fbhf: f64;
    // Pump scratch, built ONCE at window_create (msg_peek used to rebuild the
    // date/mode/selector EVERY call, leaking an NSString per peek): the
    // distantPast date, the run-loop-mode NSString, the nextEvent selector,
    // the event mask, and the last dequeued NSEvent.
    date: u64;
    mode: u64;
    psel: u64;
    mask: u64;
    evt: u64;
    // Cached per-frame selectors (registered once at window_create): release,
    // sendEvent:, isVisible, keyWindow.
    relsel: u64;
    dsel: u64;
    vsel: u64;
    ksel: u64;
    // The rolling autorelease pool: opened at window_create, cycled by every
    // msg_peek (pop drains the previous peek's autoreleased NSEvent after its
    // dispatch; push opens the scope for the next one).
    pool: u64;
    // Scratch for the objc call sequences.
    cls: u64;
    sel: u64;
    tmp: u64;
    ctx: u64;
    cgimg: u64;
    nsimg: u64;
    rx: f64;
    ry: f64;
    rw: f64;
    rh: f64;
    rc: u64;
    r32: u32;}
macos_arm64 machine DemoGuiProvider::provider_defaults(defaults: &mut DemoGuiProvider) {
    defaults.select_provider<Gui, DemoGuiProvider>();
}
macos_arm64 machine DemoGuiProvider::window_create(demo_gui_provider: &mut DemoGuiProvider, class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64 satisfies Gui::window_create
reaches CoreGraphics + ObjectiveC
{
    demo_gui_provider.rx = F64::from_i32(x);
    demo_gui_provider.ry = F64::from_i32(y);
    demo_gui_provider.rw = F64::from_i32(width);
    demo_gui_provider.rh = F64::from_i32(height);
    demo_gui_provider.rw = demo_gui_provider.rw - 16.0;
    demo_gui_provider.rh = demo_gui_provider.rh - 39.0;
    let cbuf1: [u8; 14] = "NSApplication\0";
    demo_gui_provider.cls = objc_get_class(&cbuf1[0]);
    let cbuf2: [u8; 18] = "sharedApplication\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf2[0]);
    demo_gui_provider.app = objc_send(demo_gui_provider.cls, demo_gui_provider.sel);
    let cbuf3: [u8; 21] = "setActivationPolicy:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf3[0]);
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.app, demo_gui_provider.sel, 0);
    let cbuf4: [u8; 9] = "NSWindow\0";
    demo_gui_provider.cls = objc_get_class(&cbuf4[0]);
    let cbuf5: [u8; 6] = "alloc\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf5[0]);
    demo_gui_provider.tmp = objc_send(demo_gui_provider.cls, demo_gui_provider.sel);
    let cbuf6: [u8; 45] = "initWithContentRect:styleMask:backing:defer:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf6[0]);
    demo_gui_provider.window = objc_send_rect(demo_gui_provider.tmp, demo_gui_provider.sel, demo_gui_provider.rx, demo_gui_provider.ry, demo_gui_provider.rw, demo_gui_provider.rh, 15, 2, 0);
    let cbuf7: [u8; 12] = "NSImageView\0";
    demo_gui_provider.cls = objc_get_class(&cbuf7[0]);
    let cbuf8: [u8; 6] = "alloc\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf8[0]);
    demo_gui_provider.tmp = objc_send(demo_gui_provider.cls, demo_gui_provider.sel);
    let cbuf9: [u8; 15] = "initWithFrame:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf9[0]);
    demo_gui_provider.view = objc_send_rect(demo_gui_provider.tmp, demo_gui_provider.sel, demo_gui_provider.rx, demo_gui_provider.ry, demo_gui_provider.rw, demo_gui_provider.rh, 0, 0, 0);
    let cbuf10: [u8; 17] = "setImageScaling:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf10[0]);
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.view, demo_gui_provider.sel, 1);
    let cbuf11: [u8; 16] = "setContentView:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf11[0]);
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.window, demo_gui_provider.sel, demo_gui_provider.view);
    let cbuf12: [u8; 8] = "release\0";
    demo_gui_provider.relsel = objc_register_selector(&cbuf12[0]);
    let cbuf13: [u8; 9] = "NSString\0";
    demo_gui_provider.cls = objc_get_class(&cbuf13[0]);
    let cbuf14: [u8; 6] = "alloc\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf14[0]);
    demo_gui_provider.tmp = objc_send(demo_gui_provider.cls, demo_gui_provider.sel);
    let cbuf15: [u8; 20] = "initWithUTF8String:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf15[0]);
    demo_gui_provider.tmp = objc_send_byte_string(demo_gui_provider.tmp, demo_gui_provider.sel, &title[0]);
    let cbuf16: [u8; 10] = "setTitle:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf16[0]);
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.window, demo_gui_provider.sel, demo_gui_provider.tmp);
    demo_gui_provider.rc = objc_send(demo_gui_provider.tmp, demo_gui_provider.relsel);
    let cbuf17: [u8; 7] = "center\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf17[0]);
    demo_gui_provider.rc = objc_send(demo_gui_provider.window, demo_gui_provider.sel);
    let cbuf18: [u8; 22] = "makeKeyAndOrderFront:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf18[0]);
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.window, demo_gui_provider.sel, 0);
    let cbuf19: [u8; 27] = "activateIgnoringOtherApps:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf19[0]);
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.app, demo_gui_provider.sel, 1);
    demo_gui_provider.space = cg_color_space_rgb();
    // Pump scratch, once: the distantPast date, the run-loop-mode NSString, the
    // nextEvent/sendEvent:/isVisible/keyWindow selectors, and the event mask.
    let cbuf20: [u8; 7] = "NSDate\0";
    demo_gui_provider.cls = objc_get_class(&cbuf20[0]);
    let cbuf21: [u8; 12] = "distantPast\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf21[0]);
    demo_gui_provider.date = objc_send(demo_gui_provider.cls, demo_gui_provider.sel);
    let cbuf22: [u8; 9] = "NSString\0";
    demo_gui_provider.cls = objc_get_class(&cbuf22[0]);
    let cbuf23: [u8; 6] = "alloc\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf23[0]);
    demo_gui_provider.tmp = objc_send(demo_gui_provider.cls, demo_gui_provider.sel);
    let cbuf24: [u8; 20] = "initWithUTF8String:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf24[0]);
    let cbuf25: [u8; 22] = "kCFRunLoopDefaultMode\0";
    demo_gui_provider.mode = objc_send_string(demo_gui_provider.tmp, demo_gui_provider.sel, &cbuf25[0]);
    let cbuf26: [u8; 48] = "nextEventMatchingMask:untilDate:inMode:dequeue:\0";
    demo_gui_provider.psel = objc_register_selector(&cbuf26[0]);
    demo_gui_provider.mask = 4294967295;
    let cbuf27: [u8; 11] = "sendEvent:\0";
    demo_gui_provider.dsel = objc_register_selector(&cbuf27[0]);
    let cbuf28: [u8; 10] = "isVisible\0";
    demo_gui_provider.vsel = objc_register_selector(&cbuf28[0]);
    let cbuf29: [u8; 10] = "keyWindow\0";
    demo_gui_provider.ksel = objc_register_selector(&cbuf29[0]);
    // Open the rolling autorelease pool msg_peek cycles (never popped at exit
    // on purpose: a later peek after a final pop would pop a dead token, and
    // process exit reclaims everything anyway).
    demo_gui_provider.pool = objc_pool_push();
    transition { _ -> ret(demo_gui_provider) }
    state ret(demo_gui_provider: &mut DemoGuiProvider) -> u64 { demo_gui_provider.window }
}
macos_arm64 machine DemoGuiProvider::get_dc(demo_gui_provider: &mut DemoGuiProvider, window: u64) -> u64  satisfies Gui::get_dc
{
    transition { _ -> ret(window) }
    state ret(window: u64) -> u64 { window }
}
macos_arm64 machine DemoGuiProvider::msg_peek(demo_gui_provider: &mut DemoGuiProvider, message: [u64; 6]) -> u32 satisfies Gui::msg_peek
reaches ObjectiveC
{
    // Cycle the rolling autorelease pool opened at window_create: the pop
    // drains the PREVIOUS peek's autoreleased NSEvent (already dispatched by
    // then), the push opens the scope this peek's event lands in. The date,
    // mode string, selector, and mask are window_create-cached — this machine
    // used to rebuild all four (and leak the NSString) on every single peek.
    demo_gui_provider.rc = objc_pool_pop(demo_gui_provider.pool);
    demo_gui_provider.pool = objc_pool_push();
    demo_gui_provider.evt = objc_send_scalar4(demo_gui_provider.app, demo_gui_provider.psel, demo_gui_provider.mask, demo_gui_provider.date, demo_gui_provider.mode, 1);
    // Arm states must stay side-effect-free (the value-call effect fence):
    // both arms complete with a pure terminal value instead of mutating r32.
    transition demo_gui_provider.evt != 0 { true -> got() _ -> ret() }
    state got() -> u32 { 1 }
    state ret() -> u32 { 0 }
}
macos_arm64 machine DemoGuiProvider::msg_translate(demo_gui_provider: &mut DemoGuiProvider, message: [u64; 6]) -> u32  satisfies Gui::msg_translate
{
    demo_gui_provider.r32 = 1;
    transition { _ -> ret(demo_gui_provider) }
    state ret(demo_gui_provider: &mut DemoGuiProvider) -> u32 { demo_gui_provider.r32 }
}
macos_arm64 machine DemoGuiProvider::msg_dispatch(demo_gui_provider: &mut DemoGuiProvider, message: [u64; 6]) -> u64 satisfies Gui::msg_dispatch
reaches ObjectiveC
{
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.app, demo_gui_provider.dsel, demo_gui_provider.evt);
    transition { _ -> ret(demo_gui_provider) }
    state ret(demo_gui_provider: &mut DemoGuiProvider) -> u64 { demo_gui_provider.rc }
}
macos_arm64 machine DemoGuiProvider::is_window(demo_gui_provider: &mut DemoGuiProvider, window: u64) -> u32 satisfies Gui::is_window
reaches ObjectiveC
{
    demo_gui_provider.rc = objc_send(window, demo_gui_provider.vsel);
    demo_gui_provider.r32 = narrow_u64_to_u32_wrapping(demo_gui_provider.rc);
    transition { _ -> ret(demo_gui_provider) }
    state ret(demo_gui_provider: &mut DemoGuiProvider) -> u32 { demo_gui_provider.r32 }
}
macos_arm64 machine DemoGuiProvider::blit(demo_gui_provider: &mut DemoGuiProvider, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32 satisfies Gui::blit
reaches CoreGraphics + ObjectiveC
{
    let source_width_wide: i64 = source_width as i64;
    let source_height_wide: i64 = source_height as i64;
    demo_gui_provider.fbw = source_width_wide;
    demo_gui_provider.fbh = source_height_wide;
    demo_gui_provider.stride = source_width_wide << 2;
    demo_gui_provider.fbwf = F64::from_u32(source_width);
    demo_gui_provider.fbhf = F64::from_u32(source_height);
    demo_gui_provider.ctx = cg_bitmap_context(&pixels[0], demo_gui_provider.fbw, demo_gui_provider.fbh, 8, demo_gui_provider.stride, demo_gui_provider.space, 8198);
    demo_gui_provider.cgimg = cg_bitmap_context_image(demo_gui_provider.ctx);
    let cbuf30: [u8; 8] = "NSImage\0";
    demo_gui_provider.cls = objc_get_class(&cbuf30[0]);
    let cbuf31: [u8; 6] = "alloc\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf31[0]);
    demo_gui_provider.tmp = objc_send(demo_gui_provider.cls, demo_gui_provider.sel);
    let cbuf32: [u8; 22] = "initWithCGImage:size:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf32[0]);
    demo_gui_provider.nsimg = objc_send_image_size(demo_gui_provider.tmp, demo_gui_provider.sel, demo_gui_provider.cgimg, demo_gui_provider.fbwf, demo_gui_provider.fbhf);
    let cbuf33: [u8; 10] = "setImage:\0";
    demo_gui_provider.sel = objc_register_selector(&cbuf33[0]);
    demo_gui_provider.rc = objc_send_scalar(demo_gui_provider.view, demo_gui_provider.sel, demo_gui_provider.nsimg);
    // Per-frame lifecycle: the context and CGImage are Create-rule owned, and
    // setImage: retains the NSImage, so drop our +1 on all three — without
    // these releases every presented frame leaked ~3 objects at ~60fps.
    demo_gui_provider.rc = cg_context_release(demo_gui_provider.ctx);
    demo_gui_provider.rc = cg_image_release(demo_gui_provider.cgimg);
    demo_gui_provider.rc = objc_send(demo_gui_provider.nsimg, demo_gui_provider.relsel);
    // The samples assert `blit == source_height` (every source scanline copied).
    demo_gui_provider.r32 = source_height;
    transition { _ -> ret(demo_gui_provider) }
    state ret(demo_gui_provider: &mut DemoGuiProvider) -> u32 { demo_gui_provider.r32 }
}

data DemoClockProvider {
    rc: i32;
    ns: u64;
    scaled: u64;
    timeout: i32;}
macos_arm64 machine DemoClockProvider::provider_defaults(defaults: &mut DemoClockProvider) {
    defaults.select_provider<Clock, DemoClockProvider>();
}
macos_arm64 machine DemoClockProvider::sleep(demo_clock_provider: &mut DemoClockProvider, milliseconds: u32) satisfies Clock::sleep
{
    demo_clock_provider.timeout = narrow_u32_to_i32_wrapping(milliseconds);
    demo_clock_provider.rc = darwin_poll(0, 0, demo_clock_provider.timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    gui: Binding<Gui>;
    cls: [u8; 7];
    title: [u8; 11];
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    message: [u64; 6];
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    pumped: i32 [0..=16];
    copied: u32;
    frame: i32 [0..=60];
    i: i32 [0..=4096];
    c: i32;
    px: i32;
}
machine Main::main(main: &mut Main) reaches Clock + Console + CoreGraphics + DarwinClock + Gui + ObjectiveC {
    // "#32770\0" -- the predefined dialog class. Unlike the STATIC control
    // class, this behaves like a draggable top-level app window in practice.
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;
    // "omega demo\0"
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 100;
    main.title[7] = 101;
    main.title[8] = 109;
    main.title[9] = 111;
    main.title[10] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;
    // WS_VISIBLE | WS_OVERLAPPEDWINDOW (0x10CF0000): a real titled app window,
    // not a naked popup. The outer size is padded (+16, +39)
    // so the CLIENT area is ~256x256 without an AdjustWindowRect import.
    main.hwnd = main.gui.window_create(main.cls, main.title, 282001408, 200, 200, 272, 295);
    transition main.hwnd > 0 { true -> dc(main) _ -> bad(main) }
    state dc(main: &mut Main) {
        main.hdc = main.gui.get_dc(main.hwnd);
        main.frame = 0;
        transition main.hdc > 0 { true -> frame_loop(main) _ -> bad(main) }
    }
    state frame_loop(main: &mut Main) {
        transition main.frame < 60 { true -> fill_init(main) _ -> finish(main) }
    }
    // --- fill the framebuffer: one linear pass, an animated diagonal wash ---
    state fill_init(main: &mut Main) {
        main.i = 0;
        transition { _ -> fill_loop(main) }
    }
    state fill_loop(main: &mut Main) {
        transition main.i >= 0 && main.i < 4096 { true -> fill_cell(main) _ -> present(main) }
    }
    state fill_cell(main: &mut Main) {
        // row + col + phase, folded through % 256: i/64 <= 64, i%64 <= 63,
        // frame*4 <= 240 -- every step provably bounded, no domain needed.
        main.c = (main.i / 64) + (main.i % 64);
        main.c = main.c + main.frame * 4;
        main.c = main.c % 256;
        // red ramps up the diagonal while blue ramps down: a scrolling wash.
        main.px = main.c * 65536;
        main.px = main.px + (255 - main.c) * 256;
        main.px = main.px + 64;
        transition main.i >= 0 && main.i < 4096 { true -> fill_put(main) _ -> bad(main) }
    }
    state fill_put(main: &mut Main) {
        main.pixels[main.i] = main.px;
        main.i = main.i + 1;
        transition { _ -> fill_loop(main) }
    }
    // --- present: stretch the 64x64 buffer into the 256x256 client area ---
    state present(main: &mut Main) {
        main.copied = main.gui.blit(main.hdc, 256, 256, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main) _ -> bad(main) }
    }
    state pace(main: &mut Main) {
        main.clock.sleep(25);
        transition { _ -> pump_init(main) }
    }
    // --- pump: drain queued messages so the titlebar responds (drag, X) ---
    state pump_init(main: &mut Main) {
        main.pumped = 0;
        transition { _ -> pump_loop(main) }
    }
    state pump_loop(main: &mut Main) {
        main.have = main.gui.msg_peek(main.message);
        transition main.have > 0 { true -> pump_handle(main) _ -> liveness(main) }
    }
    state pump_handle(main: &mut Main) {
        main.translated = main.gui.msg_translate(main.message);
        main.dispatched = main.gui.msg_dispatch(main.message);
        transition main.pumped < 16 { true -> pump_next(main) _ -> liveness(main) }
    }
    state pump_next(main: &mut Main) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main) }
    }
    // --- liveness: if the window is destroyed, stop blitting into it ---
    state liveness(main: &mut Main) {
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> next_frame(main) _ -> finish(main) }
    }
    state next_frame(main: &mut Main) {
        // re-guard so the increment's edge carries the frame bound (the
        // keystone reads the DIRECT incoming edge; frame_loop's guard is
        // several states upstream by now).
        transition main.frame < 60 { true -> advance(main) _ -> finish(main) }
    }
    state advance(main: &mut Main) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }
    state finish(main: &mut Main) {
        main.console.write_line("PASS: 60 frames blitted (exit 0)");
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: window/DC creation or a blit assertion failed (exit 1)");
        main.console.exit_process(1);
    }
}
