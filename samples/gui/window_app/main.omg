    state k18() -> u64 { 18 }
    state k19() -> u64 { 19 }
    state k20() -> u64 { 20 }
    state k21() -> u64 { 21 }
    state k22() -> u64 { 22 }
    state k23() -> u64 { 23 }
    state k24() -> u64 { 24 }
    state k25() -> u64 { 25 }
    state k26() -> u64 { 26 }
    state k28() -> u64 { 28 }
    state k29() -> u64 { 29 }
    state k36() -> u64 { 36 }
    state k46() -> u64 { 46 }
    state k51() -> u64 { 51 }
    state k53() -> u64 { 53 }
    state k67() -> u64 { 67 }
    state k69() -> u64 { 69 }
    state k75() -> u64 { 75 }
    state k78() -> u64 { 78 }
    state k123() -> u64 { 123 }
    state k124() -> u64 { 124 }
