    window_gui_provider.sel = objc_register_selector(&cbuf10[0]);
    window_gui_provider.rc = objc_send_scalar(window_gui_provider.view, window_gui_provider.sel, 1);
    let cbuf11: [u8; 16] = "setContentView:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf11[0]);
    window_gui_provider.rc = objc_send_scalar(window_gui_provider.window, window_gui_provider.sel, window_gui_provider.view);
    let cbuf12: [u8; 8] = "release\0";
    window_gui_provider.relsel = objc_register_selector(&cbuf12[0]);
    let cbuf13: [u8; 9] = "NSString\0";
    window_gui_provider.cls = objc_get_class(&cbuf13[0]);
    let cbuf14: [u8; 6] = "alloc\0";
    window_gui_provider.sel = objc_register_selector(&cbuf14[0]);
    window_gui_provider.tmp = objc_send(window_gui_provider.cls, window_gui_provider.sel);
    let cbuf15: [u8; 20] = "initWithUTF8String:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf15[0]);
    window_gui_provider.tmp = objc_send_byte_string(window_gui_provider.tmp, window_gui_provider.sel, &padded[0]);
    let cbuf16: [u8; 10] = "setTitle:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf16[0]);
    window_gui_provider.rc = objc_send_scalar(window_gui_provider.window, window_gui_provider.sel, window_gui_provider.tmp);
