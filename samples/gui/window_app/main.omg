    window_gui_provider.date = objc_send(window_gui_provider.cls, window_gui_provider.sel);
    let cbuf22: [u8; 9] = "NSString\0";
    window_gui_provider.cls = objc_get_class(&cbuf22[0]);
    let cbuf23: [u8; 6] = "alloc\0";
    window_gui_provider.sel = objc_register_selector(&cbuf23[0]);
    window_gui_provider.tmp = objc_send(window_gui_provider.cls, window_gui_provider.sel);
    let cbuf24: [u8; 20] = "initWithUTF8String:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf24[0]);
    let cbuf25: [u8; 22] = "kCFRunLoopDefaultMode\0";
