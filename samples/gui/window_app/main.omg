data WindowClockProvider {
    rc: i32;
    ns: u64;
    scaled: u64;
    timeout: i32;}
macos_arm64 machine WindowClockProvider::provider_defaults(defaults: &mut WindowClockProvider) {
    defaults.select_provider<Clock, WindowClockProvider>();
}
macos_arm64 machine WindowClockProvider::sleep(&mut self, milliseconds: u32) satisfies Clock::sleep
{
    self.timeout = narrow_u32_to_i32_wrapping(milliseconds);
    self.rc = darwin_poll(0, 0, self.timeout);
}

// Loop counters: messages pumped per frame, frames shown, and pixels written.
domain i32::PumpCount requires self >= 0 && self <= 16;
domain i32::FrameCount requires self >= 0 && self <= 16384;
domain i32::PixelIndex requires self >= 0 && self <= 4096;

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    input: Binding<Input>;
    gui: Binding<Gui>;
    cls: [u8; 7];
    title: [u8; 10];
    message: [u64; 6];
    // FULLY EXACT -- no overflow domain anywhere: the counters carry interval domains
    // and their increments are guard-proven (the dominating-guard keystone);
    // the pixel wash folds through % 256.
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    copied: u32;
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    killed: u32;
    escape: u64;
    fw: u64;
    msg_code: u64;
    pumped: i32 in PumpCount;
    frame: i32 in FrameCount;
    i: i32 in PixelIndex;
    c: i32;
    px: i32;
}
machine Main::main(&mut self) reaches Clock + Console + CoreGraphics + DarwinClock + Gui + Input + ObjectiveC {
    // "#32770\0" -- the predefined dialog class. Unlike the STATIC control
    // class, this behaves like a draggable top-level app window in practice.
    self.cls[0] = 35;
    self.cls[1] = 51;
    self.cls[2] = 50;
    self.cls[3] = 55;
    self.cls[4] = 55;
    self.cls[5] = 48;
    self.cls[6] = 0;
    // "omega app\0"
    self.title[0] = 111;
    self.title[1] = 109;
    self.title[2] = 101;
    self.title[3] = 103;
    self.title[4] = 97;
    self.title[5] = 32;
    self.title[6] = 97;
    self.title[7] = 112;
    self.title[8] = 112;
    self.title[9] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    self.info[0] = 40;
    self.info[1] = 64;
    self.info[2] = 0 - 64;
    self.info[3] = 2097153;
    // WS_VISIBLE|WS_OVERLAPPEDWINDOW; outer padded so client is roughly 256x256.
    self.hwnd = self.gui.window_create(self.cls, self.title, 282001408, 200, 200, 272, 295);
    transition self.hwnd > 0 { true -> dc() _ -> bad() }
    state dc(&mut self) {
        self.hdc = self.gui.get_dc(self.hwnd);
        self.frame = 0;
        transition self.hdc > 0 { true -> frame_loop() _ -> bad() }
    }
    state frame_loop(&mut self) {
        // keep the animation counter bounded (it runs for as long as the app lives)
        transition self.frame < 16384 { true -> pump_init() _ -> wrap_frame() }
    }
    state wrap_frame(&mut self) {
        self.frame = 0;
        transition { _ -> pump_init() }
    }
    // --- pump: drain up to 16 queued messages through DefWindowProc ---
    // The #32770 dialog proc SWALLOWS close signals, so the pump handles them
    // itself before dispatching: posted WM_CLOSE (16, taskbar Close), the X
    // button's posted WM_NCLBUTTONDOWN (161) with wParam HTCLOSE (20), and a
    // queue-visible WM_SYSCOMMAND (274) with an SC_CLOSE wParam.
    state pump_init(&mut self) {
        self.pumped = 0;
        transition { _ -> pump_loop() }
    }
    state pump_loop(&mut self) {
        self.have = self.gui.msg_peek(self.message);
        transition self.have > 0 { true -> pump_check_close() _ -> liveness() }
    }
    state pump_check_close(&mut self) {
        self.msg_code = self.message[1] % 65536;
        transition self.msg_code == 16 { true -> quit_self() _ -> pump_check_xdown() }
    }
    state pump_check_xdown(&mut self) {
        transition self.msg_code == 161 { true -> pump_check_xhit() _ -> pump_check_syscommand() }
    }
    state pump_check_xhit(&mut self) {
        // Only the close button's hit-test code quits; any other non-client
        // press (caption drag, resize borders) dispatches normally.
        transition self.message[2] == 20 { true -> quit_self() _ -> pump_handle() }
    }
    state pump_check_syscommand(&mut self) {
        transition self.msg_code == 274 { true -> pump_check_sysclose() _ -> pump_handle() }
    }
    state pump_check_sysclose(&mut self) {
        transition self.message[2] >= 61536 && self.message[2] < 61552 { true -> quit_self() _ -> pump_handle() }
    }
    state pump_handle(&mut self) {
        self.translated = self.gui.msg_translate(self.message);
        self.dispatched = self.gui.msg_dispatch(self.message);
        // guard BEFORE the increment so its edge carries the bound (keystone).
        transition self.pumped < 16 { true -> pump_next() _ -> liveness() }
    }
    state pump_next(&mut self) {
        self.pumped = self.pumped + 1;
        transition { _ -> pump_loop() }
    }
    // --- quit paths: closed/destroyed window detection or ESC ---
    state liveness(&mut self) {
        self.alive = self.gui.is_window(self.hwnd);
        transition self.alive > 0 { true -> focus_check() _ -> closed() }
    }
    // GetAsyncKeyState is GLOBAL: without this gate an ESC pressed in ANY app
    // (even the Ctrl+Shift+Esc chord) would close this window.
    state focus_check(&mut self) {
        self.fw = self.gui.foreground_window();
        transition self.fw == self.hwnd { true -> esc_check() _ -> fill_init() }
    }
    state esc_check(&mut self) {
        self.escape = self.input.key_state(27);
        transition self.escape > 0 { true -> quit_self() _ -> fill_init() }
    }
    state quit_self(&mut self) {
        self.killed = self.gui.window_destroy(self.hwnd);
        transition { _ -> closed() }
    }
    // --- render: the animated wash, then present ---
    state fill_init(&mut self) {
        self.i = 0;
        transition { _ -> fill_loop() }
    }
    state fill_loop(&mut self) {
        transition self.i >= 0 && self.i < 4096 { true -> fill_cell() _ -> present() }
    }
    state fill_cell(&mut self) {
        // row + col + phase folded through % 256: every step provably bounded.
        self.c = (self.i / 64) + (self.i % 64);
        self.c = self.c + self.frame * 4;
        self.c = self.c % 256;
        self.px = self.c * 65536;
        self.px = self.px + (255 - self.c) * 256;
        self.px = self.px + 96;
        transition self.i >= 0 && self.i < 4096 { true -> fill_put() _ -> bad() }
    }
    state fill_put(&mut self) {
        self.pixels[self.i] = self.px;
        self.i = self.i + 1;
        transition { _ -> fill_loop() }
    }
    state present(&mut self) {
        self.copied = self.gui.blit(self.hdc, 256, 256, 64, 64, self.pixels, self.info);
        transition self.copied == 64 { true -> pace() _ -> present_failed() }
    }
    state present_failed(&mut self) {
        // A failed blit right after the user closed the window is the normal
        // shutdown race, not an error.
        self.alive = self.gui.is_window(self.hwnd);
        transition self.alive > 0 { true -> bad() _ -> closed() }
    }
    state pace(&mut self) {
        self.clock.sleep(15);
        // re-guard so the increment's edge carries the frame bound (keystone).
        transition self.frame < 16384 { true -> advance() _ -> wrap_frame() }
    }
    state advance(&mut self) {
        self.frame = self.frame + 1;
        transition { _ -> frame_loop() }
    }
    state closed(&mut self) {
        self.console.write_line("window closed -- goodbye (exit 0)");
        self.console.exit_process(0);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: window/DC creation failed or a blit failed while alive (exit 1)");
        self.console.exit_process(1);
    }
}
