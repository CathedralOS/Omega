    window_gui_provider.ry = F64::from_i32(y);
    window_gui_provider.rw = F64::from_i32(width);
    window_gui_provider.rh = F64::from_i32(height);
    window_gui_provider.rw = window_gui_provider.rw - 16.0;
    window_gui_provider.rh = window_gui_provider.rh - 39.0;
    let cbuf1: [u8; 14] = "NSApplication\0";
    window_gui_provider.cls = objc_get_class(&cbuf1[0]);
    let cbuf2: [u8; 18] = "sharedApplication\0";
    window_gui_provider.sel = objc_register_selector(&cbuf2[0]);
    window_gui_provider.app = objc_send(window_gui_provider.cls, window_gui_provider.sel);
    let cbuf3: [u8; 21] = "setActivationPolicy:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf3[0]);
    window_gui_provider.rc = objc_send_scalar(window_gui_provider.app, window_gui_provider.sel, 0);
    let cbuf4: [u8; 9] = "NSWindow\0";
    window_gui_provider.cls = objc_get_class(&cbuf4[0]);
    let cbuf5: [u8; 6] = "alloc\0";
    window_gui_provider.sel = objc_register_selector(&cbuf5[0]);
    window_gui_provider.tmp = objc_send(window_gui_provider.cls, window_gui_provider.sel);
    let cbuf6: [u8; 45] = "initWithContentRect:styleMask:backing:defer:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf6[0]);
    window_gui_provider.window = objc_send_rect(window_gui_provider.tmp, window_gui_provider.sel, window_gui_provider.rx, window_gui_provider.ry, window_gui_provider.rw, window_gui_provider.rh, 15, 2, 0);
    let cbuf7: [u8; 12] = "NSImageView\0";
    window_gui_provider.cls = objc_get_class(&cbuf7[0]);
    let cbuf8: [u8; 6] = "alloc\0";
    window_gui_provider.sel = objc_register_selector(&cbuf8[0]);
    window_gui_provider.tmp = objc_send(window_gui_provider.cls, window_gui_provider.sel);
    let cbuf9: [u8; 15] = "initWithFrame:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf9[0]);
    window_gui_provider.view = objc_send_rect(window_gui_provider.tmp, window_gui_provider.sel, window_gui_provider.rx, window_gui_provider.ry, window_gui_provider.rw, window_gui_provider.rh, 0, 0, 0);
