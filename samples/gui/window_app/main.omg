    window_gui_provider.rc = objc_send(window_gui_provider.window, window_gui_provider.sel);
    let cbuf18: [u8; 22] = "makeKeyAndOrderFront:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf18[0]);
    window_gui_provider.rc = objc_send_scalar(window_gui_provider.window, window_gui_provider.sel, 0);
    let cbuf19: [u8; 27] = "activateIgnoringOtherApps:\0";
