macos_arm64 machine WindowGuiProvider::get_dc(window_gui_provider: &mut WindowGuiProvider, window: u64) -> u64  satisfies Gui::get_dc
{
    transition { _ -> ret(window) }
    state ret(window: u64) -> u64 { window }
}
macos_arm64 machine WindowGuiProvider::blit(window_gui_provider: &mut WindowGuiProvider, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32 satisfies Gui::blit
reaches CoreGraphics + ObjectiveC
{
    let source_width_wide: i64 = source_width as i64;
    let source_height_wide: i64 = source_height as i64;
    window_gui_provider.fbw = source_width_wide;
    window_gui_provider.fbh = source_height_wide;
    window_gui_provider.stride = source_width_wide << 2;
    window_gui_provider.fbwf = F64::from_u32(source_width);
    window_gui_provider.fbhf = F64::from_u32(source_height);
    window_gui_provider.ctx = cg_bitmap_context(&pixels[0], window_gui_provider.fbw, window_gui_provider.fbh, 8, window_gui_provider.stride, window_gui_provider.space, 8198);
    window_gui_provider.cgimg = cg_bitmap_context_image(window_gui_provider.ctx);
    let cbuf30: [u8; 8] = "NSImage\0";
    window_gui_provider.cls = objc_get_class(&cbuf30[0]);
    let cbuf31: [u8; 6] = "alloc\0";
    window_gui_provider.sel = objc_register_selector(&cbuf31[0]);
    window_gui_provider.tmp = objc_send(window_gui_provider.cls, window_gui_provider.sel);
    let cbuf32: [u8; 22] = "initWithCGImage:size:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf32[0]);
    window_gui_provider.nsimg = objc_send_image_size(window_gui_provider.tmp, window_gui_provider.sel, window_gui_provider.cgimg, window_gui_provider.fbwf, window_gui_provider.fbhf);
    let cbuf33: [u8; 10] = "setImage:\0";
    window_gui_provider.sel = objc_register_selector(&cbuf33[0]);
    window_gui_provider.rc = objc_send_scalar(window_gui_provider.view, window_gui_provider.sel, window_gui_provider.nsimg);
    // Per-frame lifecycle: the context and CGImage are Create-rule owned, and
    // setImage: retains the NSImage, so drop our +1 on all three — without
    // these releases every presented frame leaked ~3 objects at ~60fps.
    window_gui_provider.rc = cg_context_release(window_gui_provider.ctx);
    window_gui_provider.rc = cg_image_release(window_gui_provider.cgimg);
    window_gui_provider.rc = objc_send(window_gui_provider.nsimg, window_gui_provider.relsel);
    // The samples assert `blit == source_height` (every source scanline copied).
    window_gui_provider.r32 = source_height;
    transition { _ -> ret(window_gui_provider) }
    state ret(window_gui_provider: &mut WindowGuiProvider) -> u32 { window_gui_provider.r32 }
}
macos_arm64 machine WindowGuiProvider::msg_peek(window_gui_provider: &mut WindowGuiProvider, message: [u64; 6]) -> u32 satisfies Gui::msg_peek
reaches ObjectiveC
{
    // Cycle the rolling autorelease pool opened at window_create: the pop
    // drains the PREVIOUS peek's autoreleased NSEvent (already dispatched by
    // then), the push opens the scope this peek's event lands in. The date,
    // mode string, selector, and mask are window_create-cached — this machine
    // used to rebuild all four (and leak the NSString) on every single peek.
    window_gui_provider.rc = objc_pool_pop(window_gui_provider.pool);
    window_gui_provider.pool = objc_pool_push();
    window_gui_provider.evt = objc_send_scalar4(window_gui_provider.app, window_gui_provider.psel, window_gui_provider.mask, window_gui_provider.date, window_gui_provider.mode, 1);
    // Arm states must stay side-effect-free (the value-call effect fence):
    // both arms complete with a pure terminal value instead of mutating r32.
    transition window_gui_provider.evt != 0 { true -> got() _ -> ret() }
    state got() -> u32 { 1 }
    state ret() -> u32 { 0 }
}
macos_arm64 machine WindowGuiProvider::msg_translate(window_gui_provider: &mut WindowGuiProvider, message: [u64; 6]) -> u32  satisfies Gui::msg_translate
{
    window_gui_provider.r32 = 1;
    transition { _ -> ret(window_gui_provider) }
    state ret(window_gui_provider: &mut WindowGuiProvider) -> u32 { window_gui_provider.r32 }
}
macos_arm64 machine WindowGuiProvider::msg_dispatch(window_gui_provider: &mut WindowGuiProvider, message: [u64; 6]) -> u64 satisfies Gui::msg_dispatch
reaches ObjectiveC
{
    window_gui_provider.rc = objc_send_scalar(window_gui_provider.app, window_gui_provider.dsel, window_gui_provider.evt);
    transition { _ -> ret(window_gui_provider) }
    state ret(window_gui_provider: &mut WindowGuiProvider) -> u64 { window_gui_provider.rc }
}
macos_arm64 machine WindowGuiProvider::is_window(window_gui_provider: &mut WindowGuiProvider, window: u64) -> u32 satisfies Gui::is_window
reaches ObjectiveC
{
    window_gui_provider.rc = objc_send(window, window_gui_provider.vsel);
    window_gui_provider.r32 = narrow_u64_to_u32_wrapping(window_gui_provider.rc);
    transition { _ -> ret(window_gui_provider) }
    state ret(window_gui_provider: &mut WindowGuiProvider) -> u32 { window_gui_provider.r32 }
}
macos_arm64 machine WindowGuiProvider::window_destroy(window_gui_provider: &mut WindowGuiProvider, window: u64) -> u32 satisfies Gui::window_destroy
reaches ObjectiveC
{
    let cbuf34: [u8; 6] = "close\0";
    window_gui_provider.sel = objc_register_selector(&cbuf34[0]);
    window_gui_provider.rc = objc_send_scalar(window, window_gui_provider.sel, 0);
    window_gui_provider.r32 = 1;
    transition { _ -> ret(window_gui_provider) }
    state ret(window_gui_provider: &mut WindowGuiProvider) -> u32 { window_gui_provider.r32 }
}
macos_arm64 machine WindowGuiProvider::foreground_window(window_gui_provider: &mut WindowGuiProvider) -> u64 satisfies Gui::foreground_window
reaches ObjectiveC
{
    window_gui_provider.rc = objc_send(window_gui_provider.app, window_gui_provider.ksel);
    transition { _ -> ret(window_gui_provider) }
    state ret(window_gui_provider: &mut WindowGuiProvider) -> u64 { window_gui_provider.rc }
}

data WindowInputProvider {
    keycode: u64;
    rc: u64;}
macos_arm64 machine WindowInputProvider::provider_defaults(defaults: &mut WindowInputProvider) {
    defaults.select_provider<Input, WindowInputProvider>();
}
macos_arm64 machine WindowInputProvider::key_state(window_input_provider: &mut WindowInputProvider, virtual_key: u32) -> u64 satisfies Input::key_state
reaches CoreGraphics
{
    window_input_provider.keycode = WindowInputProvider::map_keycode(virtual_key);
    window_input_provider.rc = cg_event_source_key_state(1, window_input_provider.keycode);
    transition window_input_provider.keycode == 65535 { true -> not_down() _ -> ret(window_input_provider) }
    state not_down() -> u64 { 0 }
    state ret(window_input_provider: &mut WindowInputProvider) -> u64 { window_input_provider.rc }
}
