// A GENUINE STANDALONE software-rendered APP -- it STAYS OPEN until you close it. Every frame:
// drain the message queue (PeekMessageW -> TranslateMessage -> DispatchMessageW through the
// predefined dialog class's DefWindowProc), then check liveness and ESC (GetAsyncKeyState 27)
// as quit paths, then render: a 64x64 framebuffer animated diagonal wash stretched 4x into the
// ~256x256 client area, paced at ~60fps. Pressing ESC exits 0.
//
// This sample deliberately carries NO exit annotation for the harness: it is compiled but never
// auto-run (it waits for a human to close the window). samples/gui/window_demo is the short-lived,
// exit-asserted variant of the same pipeline. Note: dragging pauses rendering (the modal move
// loop runs inside DispatchMessageW) -- normal for a single-threaded pump.
// (Careful wording: the harness's annotation parser substring-matches the annotation phrase
// anywhere in this comment and would auto-run this app on a garbage exit code.)
// GUI-subsystem app: the console surface is exit + a status line for terminal
// runs (invisible from Finder). No stdin — a windowed app must never block on
// a console.
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::binding;
pub boundary trait Clock { machine sleep(&mut self, milliseconds: u32) invokes DarwinClock; }
pub boundary trait Input { machine key_state(&mut self, virtual_key: u32) -> u64 invokes CoreGraphics; }
pub boundary trait Gui {
    machine window_create(&mut self, class_name: [u8; 7], title: [u8; 10], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
        invokes ObjectiveC; invokes CoreGraphics;
    machine get_dc(&mut self, window: u64) -> u64;
    machine blit(&mut self, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        invokes ObjectiveC; invokes CoreGraphics;
    machine msg_peek(&mut self, message: [u64; 6]) -> u32 invokes ObjectiveC;
    machine msg_translate(&mut self, message: [u64; 6]) -> u32;
    machine msg_dispatch(&mut self, message: [u64; 6]) -> u64 invokes ObjectiveC;
    machine is_window(&mut self, window: u64) -> u32 invokes ObjectiveC;
    machine window_destroy(&mut self, window: u64) -> u32 invokes ObjectiveC;
    machine foreground_window(&mut self) -> u64 invokes ObjectiveC;
}
// The selected macOS provider closure: each provider owns the GUI scratch
// state directly (an adapter over a nested `inner` impl receiver mis-settles
// the retained write frame) and satisfies its sample boundary nominally —
// matching method names cannot establish satisfaction.
data WindowGuiProvider {
    // The current window + its image-view content (single-window apps).
    window: u64;
    view: u64;
    app: u64;
    // A device-RGB colorspace, created once at window_create and reused per blit.
    space: u64;
    // Staged blit dimensions (a host-call arg must be a storage place / literal,
    // not a live conversion expression, so the i64/f64 results land in fields).
    fbw: i64;
    fbh: i64;
    stride: i64;
    fbwf: f64;
    fbhf: f64;
    // Pump scratch, built ONCE at window_create (msg_peek used to rebuild the
    // date/mode/selector EVERY call, leaking an NSString per peek): the
    // distantPast date, the run-loop-mode NSString, the nextEvent selector,
    // the event mask, and the last dequeued NSEvent.
    date: u64;
    mode: u64;
    psel: u64;
    mask: u64;
    evt: u64;
    // Cached per-frame selectors (registered once at window_create): release,
    // sendEvent:, isVisible, keyWindow.
    relsel: u64;
    dsel: u64;
    vsel: u64;
    ksel: u64;
    // The rolling autorelease pool: opened at window_create, cycled by every
    // msg_peek (pop drains the previous peek's autoreleased NSEvent after its
    // dispatch; push opens the scope for the next one).
    pool: u64;
    // Scratch for the objc call sequences.
    cls: u64;
    sel: u64;
    tmp: u64;
    ctx: u64;
    cgimg: u64;
    nsimg: u64;
    rx: f64;
    ry: f64;
    rw: f64;
    rh: f64;
    rc: u64;
    r32: u32;}
macos_arm64 machine WindowGuiProvider::provider_defaults(defaults: &mut WindowGuiProvider) {
    defaults.select_provider<Gui, WindowGuiProvider>();
}
macos_arm64 machine WindowGuiProvider::window_create(&mut self, class_name: [u8; 7], title: [u8; 10], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64 satisfies Gui::window_create
reaches CoreGraphics + ObjectiveC
{
    let padded: [u8; 11];
    padded[0] = title[0];
    padded[1] = title[1];
    padded[2] = title[2];
    padded[3] = title[3];
    padded[4] = title[4];
    padded[5] = title[5];
    padded[6] = title[6];
    padded[7] = title[7];
    padded[8] = title[8];
    padded[9] = title[9];
    padded[10] = 0;

    self.rx = F64::from_i32(x);
    self.ry = F64::from_i32(y);
    self.rw = F64::from_i32(width);
    self.rh = F64::from_i32(height);
    self.rw = self.rw - 16.0;
    self.rh = self.rh - 39.0;
    let cbuf1: [u8; 14] = "NSApplication\0";
    self.cls = objc_get_class(&cbuf1[0]);
    let cbuf2: [u8; 18] = "sharedApplication\0";
    self.sel = objc_register_selector(&cbuf2[0]);
    self.app = objc_send(self.cls, self.sel);
    let cbuf3: [u8; 21] = "setActivationPolicy:\0";
    self.sel = objc_register_selector(&cbuf3[0]);
    self.rc = objc_send_scalar(self.app, self.sel, 0);
    let cbuf4: [u8; 9] = "NSWindow\0";
    self.cls = objc_get_class(&cbuf4[0]);
    let cbuf5: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf5[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf6: [u8; 45] = "initWithContentRect:styleMask:backing:defer:\0";
    self.sel = objc_register_selector(&cbuf6[0]);
    self.window = objc_send_rect(self.tmp, self.sel, self.rx, self.ry, self.rw, self.rh, 15, 2, 0);
    let cbuf7: [u8; 12] = "NSImageView\0";
    self.cls = objc_get_class(&cbuf7[0]);
    let cbuf8: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf8[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf9: [u8; 15] = "initWithFrame:\0";
    self.sel = objc_register_selector(&cbuf9[0]);
    self.view = objc_send_rect(self.tmp, self.sel, self.rx, self.ry, self.rw, self.rh, 0, 0, 0);
    let cbuf10: [u8; 17] = "setImageScaling:\0";
    self.sel = objc_register_selector(&cbuf10[0]);
    self.rc = objc_send_scalar(self.view, self.sel, 1);
    let cbuf11: [u8; 16] = "setContentView:\0";
    self.sel = objc_register_selector(&cbuf11[0]);
    self.rc = objc_send_scalar(self.window, self.sel, self.view);
    let cbuf12: [u8; 8] = "release\0";
    self.relsel = objc_register_selector(&cbuf12[0]);
    let cbuf13: [u8; 9] = "NSString\0";
    self.cls = objc_get_class(&cbuf13[0]);
    let cbuf14: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf14[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf15: [u8; 20] = "initWithUTF8String:\0";
    self.sel = objc_register_selector(&cbuf15[0]);
    self.tmp = objc_send_byte_string(self.tmp, self.sel, &padded[0]);
    let cbuf16: [u8; 10] = "setTitle:\0";
    self.sel = objc_register_selector(&cbuf16[0]);
    self.rc = objc_send_scalar(self.window, self.sel, self.tmp);
    self.rc = objc_send(self.tmp, self.relsel);
    let cbuf17: [u8; 7] = "center\0";
    self.sel = objc_register_selector(&cbuf17[0]);
    self.rc = objc_send(self.window, self.sel);
    let cbuf18: [u8; 22] = "makeKeyAndOrderFront:\0";
    self.sel = objc_register_selector(&cbuf18[0]);
    self.rc = objc_send_scalar(self.window, self.sel, 0);
    let cbuf19: [u8; 27] = "activateIgnoringOtherApps:\0";
    self.sel = objc_register_selector(&cbuf19[0]);
    self.rc = objc_send_scalar(self.app, self.sel, 1);
    self.space = cg_color_space_rgb();
    // Pump scratch, once: the distantPast date, the run-loop-mode NSString, the
    // nextEvent/sendEvent:/isVisible/keyWindow selectors, and the event mask.
    let cbuf20: [u8; 7] = "NSDate\0";
    self.cls = objc_get_class(&cbuf20[0]);
    let cbuf21: [u8; 12] = "distantPast\0";
    self.sel = objc_register_selector(&cbuf21[0]);
    self.date = objc_send(self.cls, self.sel);
    let cbuf22: [u8; 9] = "NSString\0";
    self.cls = objc_get_class(&cbuf22[0]);
    let cbuf23: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf23[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf24: [u8; 20] = "initWithUTF8String:\0";
    self.sel = objc_register_selector(&cbuf24[0]);
    let cbuf25: [u8; 22] = "kCFRunLoopDefaultMode\0";
    self.mode = objc_send_string(self.tmp, self.sel, &cbuf25[0]);
    let cbuf26: [u8; 48] = "nextEventMatchingMask:untilDate:inMode:dequeue:\0";
    self.psel = objc_register_selector(&cbuf26[0]);
    self.mask = 4294967295;
    let cbuf27: [u8; 11] = "sendEvent:\0";
    self.dsel = objc_register_selector(&cbuf27[0]);
    let cbuf28: [u8; 10] = "isVisible\0";
    self.vsel = objc_register_selector(&cbuf28[0]);
    let cbuf29: [u8; 10] = "keyWindow\0";
    self.ksel = objc_register_selector(&cbuf29[0]);
    // Open the rolling autorelease pool msg_peek cycles (never popped at exit
    // on purpose: a later peek after a final pop would pop a dead token, and
    // process exit reclaims everything anyway).
    self.pool = objc_pool_push();
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.window }
}
macos_arm64 machine WindowGuiProvider::get_dc(&mut self, window: u64) -> u64  satisfies Gui::get_dc
{
    transition { _ -> ret(window) }
    state ret(&mut self, window: u64) -> u64 { window }
}
macos_arm64 machine WindowGuiProvider::blit(&mut self, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32 satisfies Gui::blit
reaches CoreGraphics + ObjectiveC
{
    let source_width_wide: i64 = source_width as i64;
    let source_height_wide: i64 = source_height as i64;
    self.fbw = source_width_wide;
    self.fbh = source_height_wide;
    self.stride = source_width_wide << 2;
    self.fbwf = F64::from_u32(source_width);
    self.fbhf = F64::from_u32(source_height);
    self.ctx = cg_bitmap_context(&pixels[0], self.fbw, self.fbh, 8, self.stride, self.space, 8198);
    self.cgimg = cg_bitmap_context_image(self.ctx);
    let cbuf30: [u8; 8] = "NSImage\0";
    self.cls = objc_get_class(&cbuf30[0]);
    let cbuf31: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf31[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf32: [u8; 22] = "initWithCGImage:size:\0";
    self.sel = objc_register_selector(&cbuf32[0]);
    self.nsimg = objc_send_image_size(self.tmp, self.sel, self.cgimg, self.fbwf, self.fbhf);
    let cbuf33: [u8; 10] = "setImage:\0";
    self.sel = objc_register_selector(&cbuf33[0]);
    self.rc = objc_send_scalar(self.view, self.sel, self.nsimg);
    // Per-frame lifecycle: the context and CGImage are Create-rule owned, and
    // setImage: retains the NSImage, so drop our +1 on all three — without
    // these releases every presented frame leaked ~3 objects at ~60fps.
    self.rc = cg_context_release(self.ctx);
    self.rc = cg_image_release(self.cgimg);
    self.rc = objc_send(self.nsimg, self.relsel);
    // The samples assert `blit == source_height` (every source scanline copied).
    self.r32 = source_height;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}
macos_arm64 machine WindowGuiProvider::msg_peek(&mut self, message: [u64; 6]) -> u32 satisfies Gui::msg_peek
reaches ObjectiveC
{
    // Cycle the rolling autorelease pool opened at window_create: the pop
    // drains the PREVIOUS peek's autoreleased NSEvent (already dispatched by
    // then), the push opens the scope this peek's event lands in. The date,
    // mode string, selector, and mask are window_create-cached — this machine
    // used to rebuild all four (and leak the NSString) on every single peek.
    self.rc = objc_pool_pop(self.pool);
    self.pool = objc_pool_push();
    self.evt = objc_send_scalar4(self.app, self.psel, self.mask, self.date, self.mode, 1);
    // Arm states must stay side-effect-free (the value-call effect fence):
    // both arms complete with a pure terminal value instead of mutating r32.
    transition self.evt != 0 { true -> got() _ -> ret() }
    state got(&mut self) -> u32 { 1 }
    state ret(&mut self) -> u32 { 0 }
}
macos_arm64 machine WindowGuiProvider::msg_translate(&mut self, message: [u64; 6]) -> u32  satisfies Gui::msg_translate
{
    self.r32 = 1;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}
macos_arm64 machine WindowGuiProvider::msg_dispatch(&mut self, message: [u64; 6]) -> u64 satisfies Gui::msg_dispatch
reaches ObjectiveC
{
    self.rc = objc_send_scalar(self.app, self.dsel, self.evt);
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.rc }
}
macos_arm64 machine WindowGuiProvider::is_window(&mut self, window: u64) -> u32 satisfies Gui::is_window
reaches ObjectiveC
{
    self.rc = objc_send(window, self.vsel);
    self.r32 = narrow_u64_to_u32_wrapping(self.rc);
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}
macos_arm64 machine WindowGuiProvider::window_destroy(&mut self, window: u64) -> u32 satisfies Gui::window_destroy
reaches ObjectiveC
{
    let cbuf34: [u8; 6] = "close\0";
    self.sel = objc_register_selector(&cbuf34[0]);
    self.rc = objc_send_scalar(window, self.sel, 0);
    self.r32 = 1;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}
macos_arm64 machine WindowGuiProvider::foreground_window(&mut self) -> u64 satisfies Gui::foreground_window
reaches ObjectiveC
{
    self.rc = objc_send(self.app, self.ksel);
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.rc }
}

data WindowInputProvider {
    keycode: u64;
    rc: u64;}
macos_arm64 machine WindowInputProvider::provider_defaults(defaults: &mut WindowInputProvider) {
    defaults.select_provider<Input, WindowInputProvider>();
}
macos_arm64 machine WindowInputProvider::key_state(&mut self, virtual_key: u32) -> u64 satisfies Input::key_state
reaches CoreGraphics
{
    self.keycode = self.map_keycode(virtual_key);
    self.rc = cg_event_source_key_state(1, self.keycode);
    transition self.keycode == 65535 { true -> not_down() _ -> ret() }
    state not_down(&mut self) -> u64 { 0 }
    state ret(&mut self) -> u64 { self.rc }
}
macos_arm64 machine WindowInputProvider::map_keycode(&mut self, virtual_key: u32) -> u64 
{
    transition virtual_key == 8 { true -> k51() _ -> t13(virtual_key) }
    state t13(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 13 { true -> k36() _ -> t27(virtual_key) } }
    state t27(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 27 { true -> k53() _ -> t37(virtual_key) } }
    state t37(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 37 { true -> k123() _ -> t38(virtual_key) } }
    state t38(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 38 { true -> k126() _ -> t39(virtual_key) } }
    state t39(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 39 { true -> k124() _ -> t40(virtual_key) } }
    state t40(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 40 { true -> k125() _ -> t48(virtual_key) } }
    state t48(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 48 { true -> k29() _ -> t49(virtual_key) } }
    state t49(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 49 { true -> k18() _ -> t50(virtual_key) } }
    state t50(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 50 { true -> k19() _ -> t51(virtual_key) } }
    state t51(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 51 { true -> k20() _ -> t52(virtual_key) } }
    state t52(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 52 { true -> k21() _ -> t53(virtual_key) } }
    state t53(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 53 { true -> k23() _ -> t54(virtual_key) } }
    state t54(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 54 { true -> k22() _ -> t55(virtual_key) } }
    state t55(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 55 { true -> k26() _ -> t56(virtual_key) } }
    state t56(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 56 { true -> k28() _ -> t57(virtual_key) } }
    state t57(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 57 { true -> k25() _ -> t67(virtual_key) } }
    state t67(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 67 { true -> k8() _ -> t77(virtual_key) } }
    state t77(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 77 { true -> k46() _ -> t82(virtual_key) } }
    state t82(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 82 { true -> k15() _ -> t83(virtual_key) } }
    state t83(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 83 { true -> k1() _ -> t106(virtual_key) } }
    state t106(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 106 { true -> k67() _ -> t107(virtual_key) } }
    state t107(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 107 { true -> k69() _ -> t109(virtual_key) } }
    state t109(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 109 { true -> k78() _ -> t111(virtual_key) } }
    state t111(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 111 { true -> k75() _ -> t187(virtual_key) } }
    state t187(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 187 { true -> k24() _ -> unmapped() } }
    state k1(&mut self) -> u64 { 1 }
    state k8(&mut self) -> u64 { 8 }
    state k15(&mut self) -> u64 { 15 }
    state k18(&mut self) -> u64 { 18 }
    state k19(&mut self) -> u64 { 19 }
    state k20(&mut self) -> u64 { 20 }
    state k21(&mut self) -> u64 { 21 }
    state k22(&mut self) -> u64 { 22 }
    state k23(&mut self) -> u64 { 23 }
    state k24(&mut self) -> u64 { 24 }
    state k25(&mut self) -> u64 { 25 }
    state k26(&mut self) -> u64 { 26 }
    state k28(&mut self) -> u64 { 28 }
    state k29(&mut self) -> u64 { 29 }
    state k36(&mut self) -> u64 { 36 }
    state k46(&mut self) -> u64 { 46 }
    state k51(&mut self) -> u64 { 51 }
    state k53(&mut self) -> u64 { 53 }
    state k67(&mut self) -> u64 { 67 }
    state k69(&mut self) -> u64 { 69 }
    state k75(&mut self) -> u64 { 75 }
    state k78(&mut self) -> u64 { 78 }
    state k123(&mut self) -> u64 { 123 }
    state k124(&mut self) -> u64 { 124 }
    state k125(&mut self) -> u64 { 125 }
    state k126(&mut self) -> u64 { 126 }
