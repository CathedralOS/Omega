data WindowClockProvider {
    rc: i32;
    ns: u64;
    scaled: u64;
    timeout: i32;}
macos_arm64 machine WindowClockProvider::provider_defaults(defaults: &mut WindowClockProvider) {
    defaults.select_provider<Clock, WindowClockProvider>();
}
macos_arm64 machine WindowClockProvider::sleep(window_clock_provider: &mut WindowClockProvider, milliseconds: u32) satisfies Clock::sleep
{
    window_clock_provider.timeout = narrow_u32_to_i32_wrapping(milliseconds);
    window_clock_provider.rc = darwin_poll(0, 0, window_clock_provider.timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    input: Binding<Input>;
    gui: Binding<Gui>;
    cls: [u8; 7];
    title: [u8; 10];
    message: [u64; 6];
    // FULLY EXACT -- no overflow domain anywhere: the counters carry ranges
    // and their increments are guard-proven (the dominating-guard keystone);
    // the pixel wash folds through % 256.
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    copied: u32;
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    killed: u32;
    escape: u64;
    fw: u64;
    msg_code: u64;
    pumped: i32 [0..=16];
    frame: i32 [0..=16384];
    i: i32 [0..=4096];
    c: i32;
    px: i32;
}
machine Main::main(main: &mut Main) reaches Clock + Console + CoreGraphics + DarwinClock + Gui + Input + ObjectiveC {
    // "#32770\0" -- the predefined dialog class. Unlike the STATIC control
    // class, this behaves like a draggable top-level app window in practice.
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;
    // "omega app\0"
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 97;
    main.title[7] = 112;
    main.title[8] = 112;
    main.title[9] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;
    // WS_VISIBLE|WS_OVERLAPPEDWINDOW; outer padded so client is roughly 256x256.
    main.hwnd = main.gui.window_create(main.cls, main.title, 282001408, 200, 200, 272, 295);
    transition main.hwnd > 0 { true -> dc(main) _ -> bad(main) }
    state dc(main: &mut Main) {
        main.hdc = main.gui.get_dc(main.hwnd);
        main.frame = 0;
        transition main.hdc > 0 { true -> frame_loop(main) _ -> bad(main) }
    }
    state frame_loop(main: &mut Main) {
        // keep the animation counter bounded (it runs for as long as the app lives)
        transition main.frame < 16384 { true -> pump_init(main) _ -> wrap_frame(main) }
    }
    state wrap_frame(main: &mut Main) {
        main.frame = 0;
        transition { _ -> pump_init(main) }
    }
    // --- pump: drain up to 16 queued messages through DefWindowProc ---
    // The #32770 dialog proc SWALLOWS close signals, so the pump handles them
    // itself before dispatching: posted WM_CLOSE (16, taskbar Close), the X
    // button's posted WM_NCLBUTTONDOWN (161) with wParam HTCLOSE (20), and a
    // queue-visible WM_SYSCOMMAND (274) with an SC_CLOSE wParam.
    state pump_init(main: &mut Main) {
        main.pumped = 0;
        transition { _ -> pump_loop(main) }
    }
    state pump_loop(main: &mut Main) {
        main.have = main.gui.msg_peek(main.message);
        transition main.have > 0 { true -> pump_check_close(main) _ -> liveness(main) }
    }
    state pump_check_close(main: &mut Main) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main) _ -> pump_check_xdown(main) }
    }
    state pump_check_xdown(main: &mut Main) {
        transition main.msg_code == 161 { true -> pump_check_xhit(main) _ -> pump_check_syscommand(main) }
    }
    state pump_check_xhit(main: &mut Main) {
        // Only the close button's hit-test code quits; any other non-client
        // press (caption drag, resize borders) dispatches normally.
        transition main.message[2] == 20 { true -> quit_self(main) _ -> pump_handle(main) }
    }
    state pump_check_syscommand(main: &mut Main) {
        transition main.msg_code == 274 { true -> pump_check_sysclose(main) _ -> pump_handle(main) }
    }
    state pump_check_sysclose(main: &mut Main) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main) _ -> pump_handle(main) }
    }
    state pump_handle(main: &mut Main) {
        main.translated = main.gui.msg_translate(main.message);
        main.dispatched = main.gui.msg_dispatch(main.message);
        // guard BEFORE the increment so its edge carries the bound (keystone).
        transition main.pumped < 16 { true -> pump_next(main) _ -> liveness(main) }
    }
    state pump_next(main: &mut Main) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main) }
    }
    // --- quit paths: closed/destroyed window detection or ESC ---
    state liveness(main: &mut Main) {
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> focus_check(main) _ -> closed(main) }
    }
    // GetAsyncKeyState is GLOBAL: without this gate an ESC pressed in ANY app
    // (even the Ctrl+Shift+Esc chord) would close this window.
    state focus_check(main: &mut Main) {
        main.fw = main.gui.foreground_window();
        transition main.fw == main.hwnd { true -> esc_check(main) _ -> fill_init(main) }
    }
    state esc_check(main: &mut Main) {
        main.escape = main.input.key_state(27);
        transition main.escape > 0 { true -> quit_self(main) _ -> fill_init(main) }
    }
    state quit_self(main: &mut Main) {
        main.killed = main.gui.window_destroy(main.hwnd);
        transition { _ -> closed(main) }
    }
    // --- render: the animated wash, then present ---
    state fill_init(main: &mut Main) {
        main.i = 0;
        transition { _ -> fill_loop(main) }
    }
    state fill_loop(main: &mut Main) {
        transition main.i >= 0 && main.i < 4096 { true -> fill_cell(main) _ -> present(main) }
    }
    state fill_cell(main: &mut Main) {
        // row + col + phase folded through % 256: every step provably bounded.
        main.c = (main.i / 64) + (main.i % 64);
        main.c = main.c + main.frame * 4;
        main.c = main.c % 256;
        main.px = main.c * 65536;
        main.px = main.px + (255 - main.c) * 256;
        main.px = main.px + 96;
        transition main.i >= 0 && main.i < 4096 { true -> fill_put(main) _ -> bad(main) }
    }
    state fill_put(main: &mut Main) {
        main.pixels[main.i] = main.px;
        main.i = main.i + 1;
        transition { _ -> fill_loop(main) }
    }
    state present(main: &mut Main) {
        main.copied = main.gui.blit(main.hdc, 256, 256, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main) _ -> present_failed(main) }
    }
    state present_failed(main: &mut Main) {
        // A failed blit right after the user closed the window is the normal
        // shutdown race, not an error.
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> bad(main) _ -> closed(main) }
    }
    state pace(main: &mut Main) {
        main.clock.sleep(15);
        // re-guard so the increment's edge carries the frame bound (keystone).
        transition main.frame < 16384 { true -> advance(main) _ -> wrap_frame(main) }
    }
    state advance(main: &mut Main) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }
    state closed(main: &mut Main) {
        main.console.write_line("window closed -- goodbye (exit 0)");
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: window/DC creation failed or a blit failed while alive (exit 1)");
        main.console.exit_process(1);
    }
}
