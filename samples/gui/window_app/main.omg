// A persistent software-rendered macOS window. The 64x64 animated framebuffer
// is stretched into a 256x256 client area until the user closes it or presses
// Escape while this window has focus. Window state is explicitly owned by the
// application; named provider maps select code without hidden receiver state.
// No exit annotation: this sample waits for user input. window_demo is the
// bounded 60-frame exercise of the same shared rendering and event-pump API.
use omega_language_std::console;
use omega_language_std::macos_gui;

// These requirements expose the shared macos_gui operations' service rows.
// Direct-invocation declarations are separate; they do not supply a reach ceiling.
pub boundary trait Clock {
    machine sleep(milliseconds: u32) reaches DarwinClock invokes DarwinClock;
}
pub boundary trait Input {
    machine key_state(virtual_key: u32) -> u64 reaches CoreGraphics invokes CoreGraphics;
}
pub boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: &u8, style: u32, x: i32, y: i32, width: i32, height: i32) -> Window
        reaches AppKit + CoreGraphics + ObjectiveC
        invokes ObjectiveC; invokes CoreGraphics; invokes AppKit;
    machine window_destroy(window: Window) reaches CoreGraphics + ObjectiveC invokes ObjectiveC; invokes CoreGraphics;
    machine get_dc(window_state: &Window, window: u64) -> u64;
    machine blit(window_state: &Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        reaches CoreGraphics + ObjectiveC
        invokes ObjectiveC; invokes CoreGraphics;
    machine msg_peek(window_state: &mut Window, message: [u64; 6]) -> u32 reaches ObjectiveC invokes ObjectiveC;
    machine msg_translate(window_state: &Window, message: [u64; 6]) -> u32;
    machine msg_dispatch(window_state: &Window, message: [u64; 6]) -> u64 reaches ObjectiveC invokes ObjectiveC;
    machine is_window(window_state: &Window, window: u64) -> u32 reaches ObjectiveC invokes ObjectiveC;
    machine foreground_window(window_state: &Window) -> u64 reaches ObjectiveC invokes ObjectiveC;
}
WindowGuiProvider satisfies Gui {
    Gui::window_create = macos_window_create;
    Gui::window_destroy = macos_window_destroy;
    Gui::get_dc = macos_window_get_dc;
    Gui::blit = macos_window_blit;
    Gui::msg_peek = macos_window_msg_peek;
    Gui::msg_translate = macos_window_msg_translate;
    Gui::msg_dispatch = macos_window_msg_dispatch;
    Gui::is_window = macos_window_is_window;
    Gui::foreground_window = macos_window_foreground_window;
}
WindowInputProvider satisfies Input {
    Input::key_state = macos_key_state;
}
WindowClockProvider satisfies Clock {
    Clock::sleep = macos_sleep;
}

data Main {
    cls: [u8; 7];
    title: [u8; 11];
    message: [u64; 6];
    // FULLY EXACT -- no overflow domain anywhere: the counters carry ranges
    // and their increments are guard-proven (the dominating-guard keystone);
    // the pixel wash folds through % 256.
    pixels: [i32; 4096];
    info: [i32; 11];
    hwnd: u64;
    hdc: u64;
    copied: u32;
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    escape: u64;
    fw: u64;
    msg_code: u64;
    pumped: i32 [0..=16];
    frame: i32 [0..=16384];
    i: i32 [0..=4096];
    c: i32;
    px: i32;
}
machine Main::main(main: &mut Main) reaches AppKit + Clock + Console + CoreGraphics + DarwinClock + Gui + Input + ObjectiveC {
    // "#32770\0" -- the predefined dialog class. Unlike the STATIC control
    // class, this behaves like a draggable top-level app window in practice.
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;
    // "omega app\0"
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 97;
    main.title[7] = 112;
    main.title[8] = 112;
    main.title[9] = 0;
    main.title[10] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB.
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;
    // WS_VISIBLE|WS_OVERLAPPEDWINDOW; outer padded so client is roughly 256x256.
    let window: Window = Gui::window_create(main.cls, &main.title[0], 282001408, 200, 200, 272, 295);
    main.hwnd = window.window;
    transition main.hwnd > 0 { true -> dc(main, window) _ -> bad(main, window) }
    state dc(main: &mut Main, window: Window) {
        main.hdc = Gui::get_dc(&window, main.hwnd);
        main.frame = 0;
        transition main.hdc > 0 { true -> frame_loop(main, window) _ -> bad(main, window) }
    }
    state frame_loop(main: &mut Main, window: Window) {
        // keep the animation counter bounded (it runs for as long as the app lives)
        transition main.frame < 16384 { true -> pump_init(main, window) _ -> wrap_frame(main, window) }
    }
    state wrap_frame(main: &mut Main, window: Window) {
        main.frame = 0;
        transition { _ -> pump_init(main, window) }
    }
    // --- pump: drain up to 16 queued messages through DefWindowProc ---
    // The #32770 dialog proc SWALLOWS close signals, so the pump handles them
    // itself before dispatching: posted WM_CLOSE (16, taskbar Close), the X
    // button's posted WM_NCLBUTTONDOWN (161) with wParam HTCLOSE (20), and a
    // queue-visible WM_SYSCOMMAND (274) with an SC_CLOSE wParam.
    state pump_init(main: &mut Main, window: Window) {
        main.pumped = 0;
        transition { _ -> pump_loop(main, window) }
    }
    state pump_loop(main: &mut Main, mut window: Window) {
        main.have = Gui::msg_peek(&mut window, main.message);
        transition main.have > 0 { true -> pump_check_close(main, window) _ -> liveness(main, window) }
    }
    state pump_check_close(main: &mut Main, window: Window) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main, window) _ -> pump_check_xdown(main, window) }
    }
    state pump_check_xdown(main: &mut Main, window: Window) {
        transition main.msg_code == 161 { true -> pump_check_xhit(main, window) _ -> pump_check_syscommand(main, window) }
    }
    state pump_check_xhit(main: &mut Main, window: Window) {
        // Only the close button's hit-test code quits; any other non-client
        // press (caption drag, resize borders) dispatches normally.
        transition main.message[2] == 20 { true -> quit_self(main, window) _ -> pump_handle(main, window) }
    }
    state pump_check_syscommand(main: &mut Main, window: Window) {
        transition main.msg_code == 274 { true -> pump_check_sysclose(main, window) _ -> pump_handle(main, window) }
    }
    state pump_check_sysclose(main: &mut Main, window: Window) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main, window) _ -> pump_handle(main, window) }
    }
    state pump_handle(main: &mut Main, window: Window) {
        main.translated = Gui::msg_translate(&window, main.message);
        main.dispatched = Gui::msg_dispatch(&window, main.message);
        // guard BEFORE the increment so its edge carries the bound (keystone).
        transition main.pumped < 16 { true -> pump_next(main, window) _ -> liveness(main, window) }
    }
    state pump_next(main: &mut Main, window: Window) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main, window) }
    }
    // --- quit paths: closed/destroyed window detection or ESC ---
    state liveness(main: &mut Main, window: Window) {
        main.alive = Gui::is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> focus_check(main, window) _ -> closed(main, window) }
    }
    // GetAsyncKeyState is GLOBAL: without this gate an ESC pressed in ANY app
    // (even the Ctrl+Shift+Esc chord) would close this window.
    state focus_check(main: &mut Main, window: Window) {
        main.fw = Gui::foreground_window(&window);
        transition main.fw == main.hwnd { true -> esc_check(main, window) _ -> fill_init(main, window) }
    }
    state esc_check(main: &mut Main, window: Window) {
        main.escape = Input::key_state(27);
        transition main.escape > 0 { true -> quit_self(main, window) _ -> fill_init(main, window) }
    }
    state quit_self(main: &mut Main, window: Window) {
        transition { _ -> closed(main, window) }
    }
    // --- render: the animated wash, then present ---
    state fill_init(main: &mut Main, window: Window) {
        main.i = 0;
        transition { _ -> fill_loop(main, window) }
    }
    state fill_loop(main: &mut Main, window: Window) {
        transition main.i >= 0 && main.i < 4096 { true -> fill_cell(main, window) _ -> present(main, window) }
    }
    state fill_cell(main: &mut Main, window: Window) {
        // row + col + phase folded through % 256: every step provably bounded.
        main.c = (main.i / 64) + (main.i % 64);
        main.c = main.c + main.frame * 4;
        main.c = main.c % 256;
        main.px = main.c * 65536;
        main.px = main.px + (255 - main.c) * 256;
        main.px = main.px + 96;
        transition main.i >= 0 && main.i < 4096 { true -> fill_put(main, window) _ -> bad(main, window) }
    }
    state fill_put(main: &mut Main, window: Window) {
        main.pixels[main.i] = main.px;
        main.i = main.i + 1;
        transition { _ -> fill_loop(main, window) }
    }
    state present(main: &mut Main, window: Window) {
        main.copied = Gui::blit(&window, main.hdc, 256, 256, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main, window) _ -> present_failed(main, window) }
    }
    state present_failed(main: &mut Main, window: Window) {
        // A failed blit right after the user closed the window is the normal
        // shutdown race, not an error.
        main.alive = Gui::is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> bad(main, window) _ -> closed(main, window) }
    }
    state pace(main: &mut Main, window: Window) {
        Clock::sleep(15);
        // re-guard so the increment's edge carries the frame bound (keystone).
        transition main.frame < 16384 { true -> advance(main, window) _ -> wrap_frame(main, window) }
    }
    state advance(main: &mut Main, window: Window) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main, window) }
    }
    state closed(main: &mut Main, window: Window) {
        Gui::window_destroy(window);
        Console::write_line("window closed -- goodbye (exit 0)");
        Console::exit_process(0);
    }
    state bad(main: &mut Main, window: Window) {
        Gui::window_destroy(window);
        Console::write_line("FAIL: window/DC creation failed or a blit failed while alive (exit 1)");
        Console::exit_process(1);
    }
}
