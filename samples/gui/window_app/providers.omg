// Windows pacing is a direct Build::bind_native of kernel32 Sleep; the non-blocking
// Clock row cannot call the blocking TimeHost::sleep, so only macOS carries
// this family member.
public macos_arm64 machine app_sleep(milliseconds: u32)
reaches ClockObservation + ExecutionDelay invokes |macos_gui|::DarwinClock {
    |macos_gui|::macos_sleep(milliseconds);
}
