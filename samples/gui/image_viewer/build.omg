// image_viewer is a REAL windowed application: the GUI subsystem keeps Windows
// from attaching a console box (PE Subsystem 2).
use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "image_viewer" };
    builder.identifier = "com.omega.image-viewer";
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled {
        name: "system"
    }));
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::Gui, |app|::ViewerGuiProvider>(builder, alpha_bootstrap);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::Input, |app|::ViewerInputProvider>(builder, alpha_bootstrap);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::Clock, |app|::ViewerClockProvider>(builder, alpha_bootstrap);
    builder.subsystem = Subsystem::Gui;
}
