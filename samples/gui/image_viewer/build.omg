// image_viewer is a REAL windowed application: the GUI subsystem keeps Windows
// from attaching a console box (PE Subsystem 2).
machine build(builder: &mut Build) {
    Build::application(builder, "image_viewer");
    builder.identifier = "com.omega.image-viewer";
    Build::depend(builder, Source::Path {
        location: "../../../source/library/std"
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, linux_arm64);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, linux_x86_64);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, macos_arm64);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, macos_x86_64);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, windows_x86_64);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, uefi_x86_64);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, cross_platform_cli);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, local_unchecked);
    Build::select_provider<Gui, ViewerGuiProvider>(builder, alpha_bootstrap);
    Build::select_provider<Input, ViewerInputProvider>(builder, linux_arm64);
    Build::select_provider<Input, ViewerInputProvider>(builder, linux_x86_64);
    Build::select_provider<Input, ViewerInputProvider>(builder, macos_arm64);
    Build::select_provider<Input, ViewerInputProvider>(builder, macos_x86_64);
    Build::select_provider<Input, ViewerInputProvider>(builder, windows_x86_64);
    Build::select_provider<Input, ViewerInputProvider>(builder, uefi_x86_64);
    Build::select_provider<Input, ViewerInputProvider>(builder, cross_platform_cli);
    Build::select_provider<Input, ViewerInputProvider>(builder, local_unchecked);
    Build::select_provider<Input, ViewerInputProvider>(builder, alpha_bootstrap);
    Build::select_provider<Clock, ViewerClockProvider>(builder, linux_arm64);
    Build::select_provider<Clock, ViewerClockProvider>(builder, linux_x86_64);
    Build::select_provider<Clock, ViewerClockProvider>(builder, macos_arm64);
    Build::select_provider<Clock, ViewerClockProvider>(builder, macos_x86_64);
    Build::select_provider<Clock, ViewerClockProvider>(builder, windows_x86_64);
    Build::select_provider<Clock, ViewerClockProvider>(builder, uefi_x86_64);
    Build::select_provider<Clock, ViewerClockProvider>(builder, cross_platform_cli);
    Build::select_provider<Clock, ViewerClockProvider>(builder, local_unchecked);
    Build::select_provider<Clock, ViewerClockProvider>(builder, alpha_bootstrap);
    builder.subsystem = Subsystem::Gui;
}
