// image_viewer is a REAL windowed application: the GUI subsystem keeps Windows
// from attaching a console box (PE Subsystem 2).
machine build(b: &mut Build) {
    b.roots.bind(windows_x86_64::ProgramEntry, Main::main);
    b.roots.bind(macos_arm64::ProgramEntry, Main::main);
    b.subsystem = Subsystem::Gui;
}

target windows_x64 {
}

target macos_arm64 {
}
