// image_viewer is a REAL windowed application: the GUI subsystem keeps Windows
// from attaching a console box (PE Subsystem 2).
machine build(builder: &mut Build) {
    Build::application(builder, "image_viewer");
    builder.identifier = "com.omega.image-viewer";
    Build::depend(builder, Source::Path {
        location: "../../../source/library/std"
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::select_provider<Gui, ViewerGuiProvider>(builder);
    Build::select_provider<Input, ViewerInputProvider>(builder);
    Build::select_provider<Clock, ViewerClockProvider>(builder);
    builder.subsystem = Subsystem::Gui;
}
