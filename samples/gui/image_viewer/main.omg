use omega::language::core::filesystem_authority;
// A persistent software-rendered image viewer. RIGHT/LEFT arrows load
// img0.bmp / img1.bmp / img2.bmp afresh; Escape or the close button exits.
// A pure-Omega decoder turns 24bpp bottom-up BMP pixels into the top-down
// 64x64 framebuffer, stretched into the window's 512x512 client area.
// Window state is explicitly owned; named providers select stateless code.
// Run from this folder so the relative BMP paths resolve. No exit annotation:
// this application waits for user input.

use omega_language_std::posix_filesystem_host;
use omega_language_std::macos_gui;

// GUI-subsystem app: the console surface is exit + a status line for terminal
// runs (invisible from Finder). No stdin — a windowed app must never block on
// a console.
use omega_language_std::console;
// These requirements expose the shared macos_gui operations' service rows.
// Direct-invocation declarations are separate; they do not supply a reach ceiling.
pub boundary trait Clock {
    machine sleep(milliseconds: u32) reaches DarwinClock invokes DarwinClock;
}
pub boundary trait Input {
    machine key_state(virtual_key: u32) -> u64 reaches CoreGraphics invokes CoreGraphics;
}
pub boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: &u8, style: u32, x: i32, y: i32, width: i32, height: i32) -> Window
        reaches AppKit + CoreGraphics + ObjectiveC
        invokes ObjectiveC; invokes CoreGraphics; invokes AppKit;
    machine window_destroy(window: Window) reaches CoreGraphics + ObjectiveC invokes ObjectiveC; invokes CoreGraphics;
    machine get_dc(window_state: &Window, window: u64) -> u64;
    machine blit(window_state: &Window, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
        reaches CoreGraphics + ObjectiveC
        invokes ObjectiveC; invokes CoreGraphics;
    machine msg_peek(window_state: &mut Window, message: [u64; 6]) -> u32 reaches ObjectiveC invokes ObjectiveC;
    machine msg_translate(window_state: &Window, message: [u64; 6]) -> u32;
    machine msg_dispatch(window_state: &Window, message: [u64; 6]) -> u64 reaches ObjectiveC invokes ObjectiveC;
    machine is_window(window_state: &Window, window: u64) -> u32 reaches ObjectiveC invokes ObjectiveC;
    machine foreground_window(window_state: &Window) -> u64 reaches ObjectiveC invokes ObjectiveC;
}
ViewerGuiProvider satisfies Gui {
    Gui::window_create = macos_window_create;
    Gui::window_destroy = macos_window_destroy;
    Gui::get_dc = macos_window_get_dc;
    Gui::blit = macos_window_blit;
    Gui::msg_peek = macos_window_msg_peek;
    Gui::msg_translate = macos_window_msg_translate;
    Gui::msg_dispatch = macos_window_msg_dispatch;
    Gui::is_window = macos_window_is_window;
    Gui::foreground_window = macos_window_foreground_window;
}
ViewerInputProvider satisfies Input {
    Input::key_state = macos_key_state;
}
ViewerClockProvider satisfies Clock {
    Clock::sleep = macos_sleep;
}

data Main {
    cls: [u8; 7];
    title: [u8; 13];
    message: [u64; 6];
    fw: u64;
    msg_code: u64;
    // The raw file bytes (12,342 = 54-byte header + 64*64*3 pixel array; the
    // 64-wide 24bpp row is 192 bytes, already 4-aligned, so no stride padding).
    buffer: [u8; 16384];
    // The decoded top-down 32bpp framebuffer.
    pixels: [i32; 4096];
    info: [i32; 11];
    fd: i32;
    n: i64;
    received: u64 [0..=16384];
    rc: i32;
    hwnd: u64;
    hdc: u64;
    copied: u32;
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    escape: u64;
    next_key: u64;
    prev_key: u64;
    next_held: u32;
    prev_held: u32;
    current: i32 [0..=2];
    src: i32 [0..=16384];
    dst: i32 [0..=4096];
    col: i32 [0..=64];
    b: i32 [0..=255];
    g: i32 [0..=255];
    r: i32 [0..=255];
    px: i32;
    pumped: i32 [0..=16];
}

machine Main::main(main: &mut Main) reaches AppKit + Clock + Console + CoreGraphics + DarwinClock + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + Gui + Input + ObjectiveC {
    // "#32770\0" -- the predefined dialog class (draggable top-level window).
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;
    // "omega viewer\0"
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 118;
    main.title[7] = 105;
    main.title[8] = 101;
    main.title[9] = 119;
    main.title[10] = 101;
    main.title[11] = 114;
    main.title[12] = 0;
    // BITMAPINFOHEADER for the DECODED buffer: 64x64 top-down 32bpp BI_RGB
    // (2097153 = planes 1 | bitcount 32 packed into one i32).
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;
    main.current = 0;
    // Create the owned window before loading so every failure path can release it.
    let window: Window = Gui::window_create(main.cls, &main.title[0], 282001408, 160, 120, 528, 551);
    main.hwnd = window.window;
    transition main.hwnd > 0 { true -> dc(main, window) _ -> bad(main, window) }

    // --- load the current image from disk (also re-entered on every flip) ---
    state load(main: &mut Main, window: Window) {
        transition main.current == 0 { true -> open0(main, window) _ -> load1(main, window) }
    }
    state load1(main: &mut Main, window: Window) {
        transition main.current == 1 { true -> open1(main, window) _ -> open2(main, window) }
    }
    // Paths are relative to the process working directory, with the existing
    // parent-directory fallback. Application publication does not change cwd.
    state open0(main: &mut Main, window: Window) {
        // POSIX O_RDONLY is zero. Reads preserve binary bytes.
        main.fd = PosixFilesystemHost::open("img0.bmp", 0);
        transition main.fd >= 0 { true -> read_file(main, window) _ -> open0_up(main, window) }
    }
    state open0_up(main: &mut Main, window: Window) {
        main.fd = PosixFilesystemHost::open("../img0.bmp", 0);
        transition { _ -> read_file(main, window) }
    }
    state open1(main: &mut Main, window: Window) {
        main.fd = PosixFilesystemHost::open("img1.bmp", 0);
        transition main.fd >= 0 { true -> read_file(main, window) _ -> open1_up(main, window) }
    }
    state open1_up(main: &mut Main, window: Window) {
        main.fd = PosixFilesystemHost::open("../img1.bmp", 0);
        transition { _ -> read_file(main, window) }
    }
    state open2(main: &mut Main, window: Window) {
        main.fd = PosixFilesystemHost::open("img2.bmp", 0);
        transition main.fd >= 0 { true -> read_file(main, window) _ -> open2_up(main, window) }
    }
    state open2_up(main: &mut Main, window: Window) {
        main.fd = PosixFilesystemHost::open("../img2.bmp", 0);
        transition { _ -> read_file(main, window) }
    }
    state read_file(main: &mut Main, window: Window) {
        transition main.fd >= 0 { true -> read_go(main, window) _ -> load_failed(main, window) }
    }
    state read_go(main: &mut Main, window: Window) {
        main.received = 0;
        transition { _ -> read_more(main, window) }
    }
    // POSIX permits short reads; the native provider also bounds each transfer.
    // Read to EOF so a truncated or oversized image cannot pass the size check.
    state read_more(main: &mut Main, window: Window) {
        transition main.received < 16384 { true -> read_chunk(main, window) _ -> read_close(main, window) }
    }
    state read_chunk(main: &mut Main, window: Window) {
        main.n = PosixFilesystemHost::read(main.fd, &mut main.buffer[main.received..16384], 16384 - main.received);
        transition main.n > 0 { true -> read_count(main, window) _ -> read_close(main, window) }
    }
    state read_count(main: &mut Main, window: Window) {
        transition main.n as u64 <= 16384 - main.received { true -> read_advance(main, window) _ -> read_error(main, window) }
    }
    state read_advance(main: &mut Main, window: Window) {
        main.received = main.received + main.n as u64;
        transition { _ -> read_more(main, window) }
    }
    state read_error(main: &mut Main, window: Window) {
        main.n = 0 - 1;
        transition { _ -> read_close(main, window) }
    }
    state read_close(main: &mut Main, window: Window) {
        main.rc = PosixFilesystemHost::close(main.fd);
        transition main.n == 0 && main.received == 12342 && main.rc == 0 { true -> decode_init(main, window) _ -> load_failed(main, window) }
    }

    // --- decode: 24bpp bottom-up BGR -> top-down 0x00RRGGBB ---
    // File row 0 is the visual BOTTOM row, so dst starts at the last pixel row
    // (63*64 = 4032) and jumps back 128 after each row (64 forward within the
    // row, 192 back to the previous visual row's start).
    state decode_init(main: &mut Main, window: Window) {
        main.src = 54;
        main.dst = 4032;
        main.col = 0;
        transition { _ -> px_b(main, window) }
    }
    state px_b(main: &mut Main, window: Window) {
        transition main.src < 16384 { true -> px_b_go(main, window) _ -> load_failed(main, window) }
    }
    state px_b_go(main: &mut Main, window: Window) {
        main.b = main.buffer[main.src] as i32;
        main.src = main.src + 1;
        transition main.src < 16384 { true -> px_g(main, window) _ -> load_failed(main, window) }
    }
    state px_g(main: &mut Main, window: Window) {
        main.g = main.buffer[main.src] as i32;
        main.src = main.src + 1;
        transition main.src < 16384 { true -> px_r(main, window) _ -> load_failed(main, window) }
    }
    state px_r(main: &mut Main, window: Window) {
        main.r = main.buffer[main.src] as i32;
        main.px = (main.r << 16) | (main.g << 8) | main.b;
        transition main.src < 16384 { true -> px_advance(main, window) _ -> load_failed(main, window) }
    }
    state px_advance(main: &mut Main, window: Window) {
        main.src = main.src + 1;
        transition main.dst < 4096 { true -> px_put(main, window) _ -> load_failed(main, window) }
    }
    state px_put(main: &mut Main, window: Window) {
        main.pixels[main.dst] = main.px;
        main.dst = main.dst + 1;
        transition main.col < 63 { true -> px_next_col(main, window) _ -> row_done(main, window) }
    }
    state px_next_col(main: &mut Main, window: Window) {
        main.col = main.col + 1;
        transition { _ -> px_b(main, window) }
    }
    state row_done(main: &mut Main, window: Window) {
        main.col = 0;
        // dst sits one past the finished visual row's end. The bottom-up walk
        // is complete exactly when that row was the visual TOP row (dst == 64);
        // otherwise step back to the previous visual row's start (dst - 128,
        // proven in range by this guard).
        transition main.dst >= 128 { true -> prev_row(main, window) _ -> decoded(main, window) }
    }
    state prev_row(main: &mut Main, window: Window) {
        main.dst = main.dst - 128;
        transition { _ -> px_b(main, window) }
    }

    // Decoding and navigation reuse the same owned window.
    state decoded(main: &mut Main, window: Window) {
        Console::write_line("loaded BMP: 64x64 (12342 bytes)");
        transition { _ -> present(main, window) }
    }
    state dc(main: &mut Main, window: Window) {
        main.hdc = Gui::get_dc(&window, main.hwnd);
        transition main.hdc > 0 { true -> load(main, window) _ -> bad(main, window) }
    }

    // --- pump: drain up to 16 queued messages through DefWindowProc ---
    // The #32770 dialog proc SWALLOWS close signals (its WM_CLOSE handling is
    // dialog-shaped, not DestroyWindow), so the pump handles them itself
    // before dispatching: posted WM_CLOSE (16, e.g. taskbar Close), the X
    // button's posted WM_NCLBUTTONDOWN (161) with wParam HTCLOSE (20), and a
    // queue-visible WM_SYSCOMMAND (274) whose wParam is SC_CLOSE (0xF060,
    // low hit-test nibble masked).
    state pump_init(main: &mut Main, window: Window) {
        main.pumped = 0;
        transition { _ -> pump_loop(main, window) }
    }
    state pump_loop(main: &mut Main, mut window: Window) {
        main.have = Gui::msg_peek(&mut window, main.message);
        transition main.have > 0 { true -> pump_check_close(main, window) _ -> liveness(main, window) }
    }
    state pump_check_close(main: &mut Main, window: Window) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main, window) _ -> pump_check_xdown(main, window) }
    }
    state pump_check_xdown(main: &mut Main, window: Window) {
        transition main.msg_code == 161 { true -> pump_check_xhit(main, window) _ -> pump_check_syscommand(main, window) }
    }
    state pump_check_xhit(main: &mut Main, window: Window) {
        // Only the close button's hit-test code quits; any other non-client
        // press (caption drag, resize borders) dispatches normally.
        transition main.message[2] == 20 { true -> quit_self(main, window) _ -> pump_handle(main, window) }
    }
    state pump_check_syscommand(main: &mut Main, window: Window) {
        transition main.msg_code == 274 { true -> pump_check_sysclose(main, window) _ -> pump_handle(main, window) }
    }
    state pump_check_sysclose(main: &mut Main, window: Window) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main, window) _ -> pump_handle(main, window) }
    }
    state pump_handle(main: &mut Main, window: Window) {
        main.translated = Gui::msg_translate(&window, main.message);
        main.dispatched = Gui::msg_dispatch(&window, main.message);
        transition main.pumped < 16 { true -> pump_next(main, window) _ -> liveness(main, window) }
    }
    state pump_next(main: &mut Main, window: Window) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main, window) }
    }

    // --- quit paths: closed window or ESC; flip paths: RIGHT/LEFT edges ---
    state liveness(main: &mut Main, window: Window) {
        main.alive = Gui::is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> focus_check(main, window) _ -> closed(main, window) }
    }
    // Key-state polling is global: without this gate, an ESC (or arrow) pressed
    // in ANY app -- even the Ctrl+Shift+Esc chord -- would drive this window.
    state focus_check(main: &mut Main, window: Window) {
        main.fw = Gui::foreground_window(&window);
        transition main.fw == main.hwnd { true -> esc_check(main, window) _ -> present(main, window) }
    }
    state esc_check(main: &mut Main, window: Window) {
        main.escape = Input::key_state(27);
        transition main.escape > 0 { true -> quit_self(main, window) _ -> next_check(main, window) }
    }
    state quit_self(main: &mut Main, window: Window) {
        transition { _ -> closed(main, window) }
    }
    // Edge-detect the arrows (key_state reports HELD): flip only on the
    // 0 -> held transition, so holding the key is one flip, not sixty.
    state next_check(main: &mut Main, window: Window) {
        main.next_key = Input::key_state(39);
        transition main.next_key > 0 && main.next_held == 0 { true -> next_edge(main, window) _ -> next_level(main, window) }
    }
    state next_edge(main: &mut Main, window: Window) {
        main.next_held = 1;
        transition main.current < 2 { true -> next_up(main, window) _ -> next_wrap(main, window) }
    }
    state next_up(main: &mut Main, window: Window) {
        main.current = main.current + 1;
        transition { _ -> load(main, window) }
    }
    state next_wrap(main: &mut Main, window: Window) {
        main.current = 0;
        transition { _ -> load(main, window) }
    }
    state next_level(main: &mut Main, window: Window) {
        transition main.next_key > 0 { true -> prev_check(main, window) _ -> next_release(main, window) }
    }
    state next_release(main: &mut Main, window: Window) {
        main.next_held = 0;
        transition { _ -> prev_check(main, window) }
    }
    state prev_check(main: &mut Main, window: Window) {
        main.prev_key = Input::key_state(37);
        transition main.prev_key > 0 && main.prev_held == 0 { true -> prev_edge(main, window) _ -> prev_level(main, window) }
    }
    state prev_edge(main: &mut Main, window: Window) {
        main.prev_held = 1;
        transition main.current > 0 { true -> prev_down(main, window) _ -> prev_wrap(main, window) }
    }
    state prev_down(main: &mut Main, window: Window) {
        main.current = main.current - 1;
        transition { _ -> load(main, window) }
    }
    state prev_wrap(main: &mut Main, window: Window) {
        main.current = 2;
        transition { _ -> load(main, window) }
    }
    state prev_level(main: &mut Main, window: Window) {
        transition main.prev_key > 0 { true -> present(main, window) _ -> prev_release(main, window) }
    }
    state prev_release(main: &mut Main, window: Window) {
        main.prev_held = 0;
        transition { _ -> present(main, window) }
    }

    // --- present + pace ---
    state present(main: &mut Main, window: Window) {
        main.copied = Gui::blit(&window, main.hdc, 512, 512, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main, window) _ -> present_failed(main, window) }
    }
    state present_failed(main: &mut Main, window: Window) {
        // A failed blit right after the user closed the window is the normal
        // shutdown race, not an error.
        main.alive = Gui::is_window(&window, main.hwnd);
        transition main.alive > 0 { true -> bad(main, window) _ -> closed(main, window) }
    }
    state pace(main: &mut Main, window: Window) {
        Clock::sleep(15);
        transition { _ -> pump_init(main, window) }
    }

    state closed(main: &mut Main, window: Window) {
        Gui::window_destroy(window);
        Console::write_line("viewer closed -- goodbye (exit 0)");
        Console::exit_process(0);
    }
    state load_failed(main: &mut Main, window: Window) {
        Gui::window_destroy(window);
        Console::write_line("FAIL: could not load imgN.bmp -- run from the image_viewer folder (exit 1)");
        Console::exit_process(1);
    }
    state bad(main: &mut Main, window: Window) {
        Gui::window_destroy(window);
        Console::write_line("FAIL: window/DC creation failed or a blit failed while alive (exit 1)");
        Console::exit_process(1);
    }
}
