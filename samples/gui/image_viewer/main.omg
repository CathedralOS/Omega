// IMAGE VIEWER -- a standalone software-rendered Windows app that LOADS BMP
// FILES FROM DISK and displays them stretched to the window. RIGHT/LEFT arrows
// flip through img0.bmp / img1.bmp / img2.bmp (loaded fresh from disk on every
// flip -- the fs raw seam at work); ESC or the X button closes.
//
// The whole pipeline is Omega end to end on windows_x86_64: msvcrt _open/_read/
// _close pull the file bytes, a pure-Omega decoder walks the 24bpp bottom-up
// BMP pixel array into a top-down 32bpp [i32; 4096] framebuffer with RUNNING
// COUNTERS (src marches +3 through the file; dst walks visual rows from the
// bottom up, the `dst >= 128` dominating guard proving the row jump stays in
// range -- no computed indices anywhere), and StretchDIBits blits it 8x into
// the ~512x512 client area.
//
// Run from THIS folder (the BMP paths are relative): `build\omega-program.exe`.
// This sample deliberately carries NO exit annotation for the harness: it is
// compiled but never auto-run (it waits for a human to close the window).
// (The annotation parser substring-matches, so: no exit phrase here.)

use omega_language_std::filesystem_host;

// GUI-subsystem app: the console surface is exit + a status line for terminal
// runs (invisible from Finder). No stdin — a windowed app must never block on
// a console.
use omega_language_std::console;
use omega::language::core::binding;
pub boundary trait Clock { machine sleep(milliseconds: u32); }
pub boundary trait Input { machine key_state(virtual_key: u32) -> u64; }
pub boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: [u8; 13], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64;
    machine get_dc(window: u64) -> u64;
    machine blit(device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32;
    machine msg_peek(message: [u64; 6]) -> u32;
    machine msg_translate(message: [u64; 6]) -> u32;
    machine msg_dispatch(message: [u64; 6]) -> u64;
    machine is_window(window: u64) -> u32;
    machine window_destroy(window: u64) -> u32;
    machine foreground_window() -> u64;
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    input: Binding<Input>;
    gui: Binding<Gui>;
    raw: Binding<FilesystemHost>;
    cls: [u8; 7];
    title: [u8; 13];
    message: [u64; 6];
    // Declared BEFORE the 32KB of arrays so their stores use the short
    // low-offset encodings (a post-array field rides the aarch64 large-offset
    // materialization path instead).
    fw: u64;
    msg_code: u64;
    // The raw file bytes (12,342 = 54-byte header + 64*64*3 pixel array; the
    // 64-wide 24bpp row is 192 bytes, already 4-aligned, so no stride padding).
    buffer: [u8; 16384];
    // The decoded top-down 32bpp framebuffer StretchDIBits consumes.
    pixels: [i32; 4096];
    info: [i32; 11];
    fd: i32;
    n: i64;
    rc: i32;
    hwnd: u64;
    hdc: u64;
    copied: u32;
    have: u32;
    translated: u32;
    dispatched: u64;
    alive: u32;
    killed: u32;
    escape: u64;
    next_key: u64;
    prev_key: u64;
    next_held: u32;
    prev_held: u32;
    current: i32 [0..=2];
    src: i32 [0..=16384];
    dst: i32 [0..=4096];
    col: i32 [0..=64];
    b: i32 [0..=255];
    g: i32 [0..=255];
    r: i32 [0..=255];
    px: i32;
    pumped: i32 [0..=16];
}

machine Main::main(main: &mut Main) reaches Clock + Console + FilesystemHost + Gui + Input {
    // "#32770\0" -- the predefined dialog class (draggable top-level window).
    main.cls[0] = 35;
    main.cls[1] = 51;
    main.cls[2] = 50;
    main.cls[3] = 55;
    main.cls[4] = 55;
    main.cls[5] = 48;
    main.cls[6] = 0;
    // "omega viewer\0"
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 32;
    main.title[6] = 118;
    main.title[7] = 105;
    main.title[8] = 101;
    main.title[9] = 119;
    main.title[10] = 101;
    main.title[11] = 114;
    main.title[12] = 0;
    // BITMAPINFOHEADER for the DECODED buffer: 64x64 top-down 32bpp BI_RGB
    // (2097153 = planes 1 | bitcount 32 packed into one i32).
    main.info[0] = 40;
    main.info[1] = 64;
    main.info[2] = 0 - 64;
    main.info[3] = 2097153;
    main.current = 0;
    transition { _ -> load(main) }

    // --- load the current image from disk (also re-entered on every flip) ---
    state load(main: &mut Main) {
        transition main.current == 0 { true -> open0(main) _ -> load1(main) }
    }
    state load1(main: &mut Main) {
        transition main.current == 1 { true -> open1(main) _ -> open2(main) }
    }
    // Each image is tried at the sample dir first, then one level up -- so the
    // exe works launched from the sample folder OR double-clicked in build\.
    // (build.omg has no asset-copying yet; when it does, the fallback can go.)
    state open0(main: &mut Main) {
        // 32768 = O_BINARY (msvcrt): BMP bytes must not ride text-mode CRLF
        // translation (0x0D 0x0A pairs collapse) or the ^Z end-of-file rule.
        main.fd = main.raw.open("img0.bmp", 32768);
        transition main.fd >= 0 { true -> read_file(main) _ -> open0_up(main) }
    }
    state open0_up(main: &mut Main) {
        main.fd = main.raw.open("../img0.bmp", 32768);
        transition { _ -> read_file(main) }
    }
    state open1(main: &mut Main) {
        main.fd = main.raw.open("img1.bmp", 32768);
        transition main.fd >= 0 { true -> read_file(main) _ -> open1_up(main) }
    }
    state open1_up(main: &mut Main) {
        main.fd = main.raw.open("../img1.bmp", 32768);
        transition { _ -> read_file(main) }
    }
    state open2(main: &mut Main) {
        main.fd = main.raw.open("img2.bmp", 32768);
        transition main.fd >= 0 { true -> read_file(main) _ -> open2_up(main) }
    }
    state open2_up(main: &mut Main) {
        main.fd = main.raw.open("../img2.bmp", 32768);
        transition { _ -> read_file(main) }
    }
    state read_file(main: &mut Main) {
        transition main.fd >= 0 { true -> read_go(main) _ -> load_failed(main) }
    }
    state read_go(main: &mut Main) {
        main.n = main.raw.read(main.fd, &mut main.buffer, 16384);
        main.rc = main.raw.close(main.fd);
        transition main.n == 12342 { true -> decode_init(main) _ -> load_failed(main) }
    }

    // --- decode: 24bpp bottom-up BGR -> top-down 0x00RRGGBB ---
    // File row 0 is the visual BOTTOM row, so dst starts at the last pixel row
    // (63*64 = 4032) and jumps back 128 after each row (64 forward within the
    // row, 192 back to the previous visual row's start).
    state decode_init(main: &mut Main) {
        main.src = 54;
        main.dst = 4032;
        main.col = 0;
        transition { _ -> px_b(main) }
    }
    state px_b(main: &mut Main) {
        transition main.src < 16384 { true -> px_b_go(main) _ -> load_failed(main) }
    }
    state px_b_go(main: &mut Main) {
        main.b = main.buffer[main.src] as i32;
        main.src = main.src + 1;
        transition main.src < 16384 { true -> px_g(main) _ -> load_failed(main) }
    }
    state px_g(main: &mut Main) {
        main.g = main.buffer[main.src] as i32;
        main.src = main.src + 1;
        transition main.src < 16384 { true -> px_r(main) _ -> load_failed(main) }
    }
    state px_r(main: &mut Main) {
        main.r = main.buffer[main.src] as i32;
        main.px = (main.r << 16) | (main.g << 8) | main.b;
        transition main.src < 16384 { true -> px_advance(main) _ -> load_failed(main) }
    }
    state px_advance(main: &mut Main) {
        main.src = main.src + 1;
        transition main.dst < 4096 { true -> px_put(main) _ -> load_failed(main) }
    }
    state px_put(main: &mut Main) {
        main.pixels[main.dst] = main.px;
        main.dst = main.dst + 1;
        transition main.col < 63 { true -> px_next_col(main) _ -> row_done(main) }
    }
    state px_next_col(main: &mut Main) {
        main.col = main.col + 1;
        transition { _ -> px_b(main) }
    }
    state row_done(main: &mut Main) {
        main.col = 0;
        // dst sits one past the finished visual row's end. The bottom-up walk
        // is complete exactly when that row was the visual TOP row (dst == 64);
        // otherwise step back to the previous visual row's start (dst - 128,
        // proven in range by this guard).
        transition main.dst >= 128 { true -> prev_row(main) _ -> decoded(main) }
    }
    state prev_row(main: &mut Main) {
        main.dst = main.dst - 128;
        transition { _ -> px_b(main) }
    }

    // --- first decode creates the window; flips just re-present ---
    state decoded(main: &mut Main) {
        transition main.hwnd > 0 { true -> present(main) _ -> create_window(main) }
    }
    state create_window(main: &mut Main) {
        // WS_VISIBLE|WS_OVERLAPPEDWINDOW; outer padded so the client area is
        // roughly 512x512 (the 64x64 image stretched 8x).
        main.hwnd = main.gui.window_create(main.cls, main.title, 282001408, 160, 120, 528, 551);
        transition main.hwnd > 0 { true -> dc(main) _ -> bad(main) }
    }
    state dc(main: &mut Main) {
        main.hdc = main.gui.get_dc(main.hwnd);
        transition main.hdc > 0 { true -> present(main) _ -> bad(main) }
    }

    // --- pump: drain up to 16 queued messages through DefWindowProc ---
    // The #32770 dialog proc SWALLOWS close signals (its WM_CLOSE handling is
    // dialog-shaped, not DestroyWindow), so the pump handles them itself
    // before dispatching: posted WM_CLOSE (16, e.g. taskbar Close), the X
    // button's posted WM_NCLBUTTONDOWN (161) with wParam HTCLOSE (20), and a
    // queue-visible WM_SYSCOMMAND (274) whose wParam is SC_CLOSE (0xF060,
    // low hit-test nibble masked).
    state pump_init(main: &mut Main) {
        main.pumped = 0;
        transition { _ -> pump_loop(main) }
    }
    state pump_loop(main: &mut Main) {
        main.have = main.gui.msg_peek(main.message);
        transition main.have > 0 { true -> pump_check_close(main) _ -> liveness(main) }
    }
    state pump_check_close(main: &mut Main) {
        main.msg_code = main.message[1] % 65536;
        transition main.msg_code == 16 { true -> quit_self(main) _ -> pump_check_xdown(main) }
    }
    state pump_check_xdown(main: &mut Main) {
        transition main.msg_code == 161 { true -> pump_check_xhit(main) _ -> pump_check_syscommand(main) }
    }
    state pump_check_xhit(main: &mut Main) {
        // Only the close button's hit-test code quits; any other non-client
        // press (caption drag, resize borders) dispatches normally.
        transition main.message[2] == 20 { true -> quit_self(main) _ -> pump_handle(main) }
    }
    state pump_check_syscommand(main: &mut Main) {
        transition main.msg_code == 274 { true -> pump_check_sysclose(main) _ -> pump_handle(main) }
    }
    state pump_check_sysclose(main: &mut Main) {
        transition main.message[2] >= 61536 && main.message[2] < 61552 { true -> quit_self(main) _ -> pump_handle(main) }
    }
    state pump_handle(main: &mut Main) {
        main.translated = main.gui.msg_translate(main.message);
        main.dispatched = main.gui.msg_dispatch(main.message);
        transition main.pumped < 16 { true -> pump_next(main) _ -> liveness(main) }
    }
    state pump_next(main: &mut Main) {
        main.pumped = main.pumped + 1;
        transition { _ -> pump_loop(main) }
    }

    // --- quit paths: closed window or ESC; flip paths: RIGHT/LEFT edges ---
    state liveness(main: &mut Main) {
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> focus_check(main) _ -> closed(main) }
    }
    // GetAsyncKeyState is GLOBAL: without this gate, an ESC (or arrow) pressed
    // in ANY app -- even the Ctrl+Shift+Esc chord -- would drive this window.
    state focus_check(main: &mut Main) {
        main.fw = main.gui.foreground_window();
        transition main.fw == main.hwnd { true -> esc_check(main) _ -> present(main) }
    }
    state esc_check(main: &mut Main) {
        main.escape = main.input.key_state(27);
        transition main.escape > 0 { true -> quit_self(main) _ -> next_check(main) }
    }
    state quit_self(main: &mut Main) {
        main.killed = main.gui.window_destroy(main.hwnd);
        transition { _ -> closed(main) }
    }
    // Edge-detect the arrows (key_state reports HELD): flip only on the
    // 0 -> held transition, so holding the key is one flip, not sixty.
    state next_check(main: &mut Main) {
        main.next_key = main.input.key_state(39);
        transition main.next_key > 0 && main.next_held == 0 { true -> next_edge(main) _ -> next_level(main) }
    }
    state next_edge(main: &mut Main) {
        main.next_held = 1;
        transition main.current < 2 { true -> next_up(main) _ -> next_wrap(main) }
    }
    state next_up(main: &mut Main) {
        main.current = main.current + 1;
        transition { _ -> load(main) }
    }
    state next_wrap(main: &mut Main) {
        main.current = 0;
        transition { _ -> load(main) }
    }
    state next_level(main: &mut Main) {
        transition main.next_key > 0 { true -> prev_check(main) _ -> next_release(main) }
    }
    state next_release(main: &mut Main) {
        main.next_held = 0;
        transition { _ -> prev_check(main) }
    }
    state prev_check(main: &mut Main) {
        main.prev_key = main.input.key_state(37);
        transition main.prev_key > 0 && main.prev_held == 0 { true -> prev_edge(main) _ -> prev_level(main) }
    }
    state prev_edge(main: &mut Main) {
        main.prev_held = 1;
        transition main.current > 0 { true -> prev_down(main) _ -> prev_wrap(main) }
    }
    state prev_down(main: &mut Main) {
        main.current = main.current - 1;
        transition { _ -> load(main) }
    }
    state prev_wrap(main: &mut Main) {
        main.current = 2;
        transition { _ -> load(main) }
    }
    state prev_level(main: &mut Main) {
        transition main.prev_key > 0 { true -> present(main) _ -> prev_release(main) }
    }
    state prev_release(main: &mut Main) {
        main.prev_held = 0;
        transition { _ -> present(main) }
    }

    // --- present + pace ---
    state present(main: &mut Main) {
        main.copied = main.gui.blit(main.hdc, 512, 512, 64, 64, main.pixels, main.info);
        transition main.copied == 64 { true -> pace(main) _ -> present_failed(main) }
    }
    state present_failed(main: &mut Main) {
        // A failed blit right after the user closed the window is the normal
        // shutdown race, not an error.
        main.alive = main.gui.is_window(main.hwnd);
        transition main.alive > 0 { true -> bad(main) _ -> closed(main) }
    }
    state pace(main: &mut Main) {
        main.clock.sleep(15);
        transition { _ -> pump_init(main) }
    }

    state closed(main: &mut Main) {
        main.console.write_line("viewer closed -- goodbye (exit 0)");
        main.console.exit_process(0);
    }
    state load_failed(main: &mut Main) {
        main.console.write_line("FAIL: could not load imgN.bmp -- run from the image_viewer folder (exit 1)");
        main.console.exit_process(1);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: window/DC creation failed or a blit failed while alive (exit 1)");
        main.console.exit_process(1);
    }
}
