// stdin_rot1: an EOF-driven filter — reads stdin to end-of-input
// (`ByteRead::Eof`, ordinal 0: the ZII zero case of the std console byte
// read), writes each byte + 1 through, exits with the byte count. The first
// sample to combine ALL THREE hard summit dimensions at once: input
// (grid-substituted), output (dual-channel, render-pinned per vector), and
// end-of-input values reaching the STRUCTURAL result.
//
// The running count is the one value live across the read loop, so it travels
// as a state argument rather than a field.
//
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 1
//   "AB" -> 2
//   "ab " -> 3

use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> rd(&main.console, 0) }

    state rd(console: &Binding<Console>, n: i32 in Wrapping) {
        let r: ByteRead = block Console::read_byte(console);
        transition r {
            ByteRead::Byte { value } -> wr(console, n, value)
            _ -> fin(console, n)
        }
    }

    state wr(console: &Binding<Console>, n: i32 in Wrapping, value: i32) {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        let rotated: i32 in Wrapping = b + 1;
        let output: i32 = rotated as i32;
        Console::write_byte(console, output);
        transition { _ -> rd(console, n + 1) }
    }

    state fin(console: &Binding<Console>, n: i32 in Wrapping) {
        Console::exit_process(console, n as i32);
    }
}
