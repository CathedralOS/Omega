// stdin_rot1: an EOF-driven filter — reads stdin to end-of-input
// (`ByteRead::Eof`, ordinal 0: the ZII zero case of the std console byte
// read), writes each byte + 1 through, exits with the byte count. The first
// sample to combine ALL THREE hard summit dimensions at once: input
// (grid-substituted), output (dual-channel, render-pinned per vector), and
// end-of-input values reaching the STRUCTURAL result.
//
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 1
//   "AB" -> 2
//   "ab " -> 3

use omega_language_std::console;

data Main {
    console: Console;
    n: i32 in Wrapping;
}

machine Main::main(&mut self) {
    transition { _ -> rd() }

    state rd(&mut self) {
        let r: ByteRead = self.console.read_byte();
        transition r {
            ByteRead::Byte { value } -> wr(value)
            _ -> fin()
        }
    }

    state wr(&mut self, value: i32 [0..=255]) {
        self.n = self.n + 1;
        let b: i32 in Wrapping = value as i32 in Wrapping;
        let rotated: i32 in Wrapping = b + 1;
        let output: i32 = rotated as i32;
        self.console.write_byte(output);
        transition { _ -> rd() }
    }

    state fin(&mut self) {
        self.console.exit_process(self.n as i32);
    }
}
