// Read bytes to EOF, write each byte plus one modulo 256, and exit with the count.
// ByteRead::Eof is distinct from a zero-valued Byte payload.
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 1
//   "AB" -> 2
//   "ab " -> 3
// The default input is empty; cases.json pins finite input/output vectors.

use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> block rd(0) }

    machine rd(n: i32 in Wrapping) {
        let r: ByteRead = block Console::read_byte();
        transition r {
            ByteRead::Byte { value } -> block wr(n, value)
            _ -> fin(n)
        }
    }

    machine wr(n: i32 in Wrapping, value: i32)
    requires value >= 0 && value <= 0xFF {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        let rotated: i32 in Wrapping = b + 1;
        let output: i32 = rotated as i32;
        Console::write_byte(output);
        transition { _ -> block rd(n + 1) }
    }

    machine fin(n: i32 in Wrapping) {
        Console::exit_process(n as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
