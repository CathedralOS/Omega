// stdin_rot1: an EOF-driven filter — reads stdin to end-of-input (the -1
// sentinel, so the meaning route runs in ℤ difference-pair mode), writes each
// byte + 1 through, exits with the byte count. The first sample to combine
// ALL THREE hard summit dimensions at once: input (grid-substituted), output
// (dual-channel, render-pinned per vector), and ℤ-pair values reaching the
// STRUCTURAL result (per-leaf difference-pair pins verified by the kernel).
//
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 1
//   "AB" -> 2
//   "ab " -> 3

use omega::language::std::console;

data Main {
    console: Console;
    n: i32 in Wrapping;
}

machine Main::main(&mut self) {
    transition { _ -> rd() }

    state rd(&mut self) {
        let b: i32 in Wrapping = read_byte();
        transition b < 0 {
            true -> fin()
            _ -> wr(b)
        }
    }

    state wr(&mut self, b: i32 in Wrapping) {
        self.n = self.n + 1;
        write_byte(b + 1);
        transition { _ -> rd() }
    }

    state fin(&mut self) {
        self.console.exit_process(self.n);
    }
}
