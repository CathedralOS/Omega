// Read bytes to EOF and exit with the Wrapping sum of bytes plus byte count.
// ByteRead::Eof is distinct from a zero-valued Byte payload.
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 66
//   "AB" -> 133
//   "0" -> 49
//   "!!" -> 68
// The default input is empty; cases.json pins finite input/output vectors.

use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> block rd(0, 0) }

    machine rd(sum: i32 in Wrapping, n: i32 in Wrapping) {
        let r: ByteRead = block Console::read_byte();
        transition r {
            ByteRead::Byte { value } -> block acc(sum, n, value)
            _ -> fin(sum, n)
        }
    }

    machine acc(sum: i32 in Wrapping, n: i32 in Wrapping, value: i32)
    requires value >= 0 && value <= 0xFF {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        transition { _ -> block rd(sum + b, n + 1) }
    }

    machine fin(sum: i32 in Wrapping, n: i32 in Wrapping) {
        let digest: i32 in Wrapping = sum + n;
        Console::exit_process(digest as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
