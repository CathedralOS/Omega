// stdin_checksum: the first INPUT-TAKING meaning-route sample. Reads stdin to
// EOF and exits with (sum of bytes + byte count) — a digest the kernel can
// re-compute per input vector. The input-grid TV gate substitutes each vector
// for the entry's STDIN placeholder (substitution CLOSES the program, so the
// whole meaning-proof pipe applies unchanged per vector), cross-checks the
// interpreter exit against the table below, and kernel-proves the claim.
//
// End-of-input is `ByteRead::Eof` — ordinal 0, the ZII zero case of the std
// console byte read (the byte result has no sentinel).
//
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 66
//   "AB" -> 133
//   "0" -> 49
//   "!!" -> 68
//
// The running totals are the values live across the read loop, so they travel
// as state arguments rather than fields.

use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> rd(&main.console, 0, 0) }

    state rd(console: &Binding<Console>, sum: i32 in Wrapping, n: i32 in Wrapping) {
        let r: ByteRead = block Console::read_byte(console);
        transition r {
            ByteRead::Byte { value } -> acc(console, sum, n, value)
            _ -> fin(console, sum, n)
        }
    }

    state acc(console: &Binding<Console>, sum: i32 in Wrapping, n: i32 in Wrapping, value: i32) {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        transition { _ -> rd(console, sum + b, n + 1) }
    }

    state fin(console: &Binding<Console>, sum: i32 in Wrapping, n: i32 in Wrapping) {
        let digest: i32 in Wrapping = sum + n;
        Console::exit_process(console, digest as i32);
    }
}
