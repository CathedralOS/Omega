// stdin_checksum: the first INPUT-TAKING meaning-route sample. Reads stdin to
// EOF and exits with (sum of bytes + byte count) — a digest the kernel can
// re-compute per input vector. The input-grid TV gate substitutes each vector
// for the entry's STDIN placeholder (substitution CLOSES the program, so the
// whole meaning-proof pipe applies unchanged per vector), cross-checks the
// interpreter exit against the table below, and kernel-proves the claim.
//
// EOF rides omega2gamma's read_byte sentinel (-1), so the meaning route runs
// in ℤ difference-pair mode; the digest stays within a byte for the grid.
//
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 66
//   "AB" -> 133
//   "0" -> 49
//   "!!" -> 68

use omega::language::std::console;

data Main {
    console: Console;
    sum: i32 in Wrapping;
    n: i32 in Wrapping;
}

machine Main::main(&mut self) {
    transition { _ -> rd() }

    state rd(&mut self) {
        let b: i32 in Wrapping = read_byte();
        transition b < 0 {
            true -> fin()
            _ -> acc(b)
        }
    }

    state acc(&mut self, b: i32 in Wrapping) {
        self.sum = self.sum + b;
        self.n = self.n + 1;
        transition { _ -> rd() }
    }

    state fin(&mut self) {
        self.console.exit_process(self.sum + self.n);
    }
}
