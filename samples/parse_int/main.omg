// Parse an integer from a `[u8;N] in Utf8` carrier string (`atoi`) -- a core
// text-processing primitive. It walks the digits, bounded by the string's
// runtime `.len`, accumulating `result = result*10 + (digit - '0')`:
//
//   result = 0
//   for each byte b in text: result = result * 10 + (b - 48)
//
// Composes a `.len`-bounded loop, runtime carrier byte reads, a widening cast,
// and Trapping arithmetic. Parsing "150" yields 150 (a dynamic, 3-digit parse --
// the length is read at runtime, not hard-coded).
// Expected exit: 150.

domain [u8]::Utf8 when valid_utf8(self) {
}
domain [u8; 8]::Utf8 when valid_utf8(self) {
}

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    text: [u8; 8] in Utf8;
    i: i32 in Trapping;
    b: u8;
    dval: i32 in Trapping;
    result: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.text = "150";
    self.result = 0;
    self.i = 0;

    transition {
        _ -> step()
    }

    // Loop over the digit bytes, bounded by the string's runtime length.
    state step(&mut self) {
        transition self.i < self.text.len {
            true -> digit()
            _ -> done()
        }
    }

    // result = result * 10 + (byte - '0').
    state digit(&mut self) {
        self.b = self.text[self.i];
        self.dval = self.b as i32;
        self.dval = self.dval - 48;
        self.result = self.result * 10;
        self.result = self.result + self.dval;
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.exit_process(self.result);
    }
}
