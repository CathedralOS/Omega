use enemies::enemies;
use inventory::items;
use rewards::rewards;
use rng::random;
use rng::random_state;

data RewardTables {
    rng: Random;
}

machine RewardTables::roll_room_treasure(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.kind = RewardKind::GoldAndItem;
    reward.gold = 20 + depth * 8 + self.rng.range(random, 15);
    reward.item = self.roll_item(depth, random);
}

machine RewardTables::roll_gold_cache(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.kind = RewardKind::Gold;
    reward.gold = 8 + depth * 5 + self.rng.range(random, 12);
    reward.item = ItemKind::RustedDagger;
}

machine RewardTables::roll_enemy_reward(
    &mut self,
    enemy: Enemy,
    random: &mut RandomState,
    reward: &mut Reward
) {
    transition self.rng.chance(random, 1, 4) {
        true -> enemy_item(enemy, random, reward)
        false -> enemy_gold(enemy, random, reward)
    }


    state enemy_item(
        &mut self,
        enemy: Enemy,
        random: &mut RandomState,
        reward: &mut Reward
    ) {
        reward.kind = RewardKind::GoldAndItem;
        reward.gold = 1 + enemy.depth + self.rng.range(random, 5);
        reward.item = self.roll_item(enemy.depth, random);
    }

    state enemy_gold(
        &mut self,
        enemy: Enemy,
        random: &mut RandomState,
        reward: &mut Reward
    ) {
        reward.kind = RewardKind::Gold;
        reward.gold = 2 + enemy.depth * 2 + self.rng.range(random, 6);
        reward.item = ItemKind::RustedDagger;
    }
}

machine RewardTables::roll_item(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState
    ) -> ItemKind {
    let roll: u32 in Wrapping = self.rng.range(random, 100);

    let is_early_dagger: bool = depth <= 2 && roll < 50;
    let is_early_buckler: bool = depth <= 3 && roll < 75;
    let is_healing_charm: bool = roll < 85;
    let is_ember_blade: bool = depth >= 5 && roll < 96;
    let is_deep_key: bool = depth >= 8;

    transition {
        is_early_dagger -> ItemKind::RustedDagger
        is_early_buckler -> ItemKind::CrackedBuckler
        is_healing_charm -> ItemKind::HealingCharm
        is_ember_blade -> ItemKind::EmberBlade
        is_deep_key -> ItemKind::DeepKey
        _ -> ItemKind::RustedDagger
    }
}
