use combat::combat_round;
use events::events;
use player::player;
use player::player_state;
use rewards::reward_tables;
use rewards::rewards;
use rng::random;
use rng::random_state;

data CombatSystem {
    player_system: PlayerSystem;
    rewards: RewardTables;
    rng: Random;
}

machine CombatSystem::fight(
    &mut self,
    player: &mut Player,
    event: &mut RoomEvent,
    random: &mut RandomState,
    round: &mut CombatRound
) {
    round.player_damage = max(0, player.attack - event.enemy.defense + self.rng.range(random, 3));
    event.enemy.health = max(0, event.enemy.health - round.player_damage);
    round.enemy_defeated = event.enemy.health == 0;

    transition round.enemy_defeated {
        true -> defeated_enemy(player, event, random, round)
        false -> enemy_retaliates(player, event, random, round)
    }


    state defeated_enemy(
        &mut self,
        player: &mut Player,
        event: &mut RoomEvent,
        random: &mut RandomState,
        round: &mut CombatRound
    ) {
        let reward: Reward;
        self.rewards.roll_enemy_reward(event.enemy, random, &mut reward);
        self.player_system.grant_reward(player, reward);
        self.player_system.grant_xp(player, event.enemy.xp_reward);

        event.reward = reward;
        event.consumed = true;
        round.enemy_damage = 0;
        round.player_defeated = false;
    }

    state enemy_retaliates(
        &mut self,
        player: &mut Player,
        event: &mut RoomEvent,
        random: &mut RandomState,
        round: &mut CombatRound
    ) {
        round.enemy_damage = max(0, event.enemy.attack - player.defense + self.rng.range(random, 3));
        self.player_system.take_damage(player, round.enemy_damage);
        round.player_defeated = player.health == 0;
    }
}
