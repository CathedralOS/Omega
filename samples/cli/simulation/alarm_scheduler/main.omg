// Expected exit: 70.
// Alarm scheduler: 5-arm case dispatch stress test.
//
// Exercises: case members with 5 named variants (2 payload-bearing, 3 no-payload),
// multi-arm middle-arm dispatch (arms 0-4), accumulating scalar self-writes across
// repeated sub-machine calls, and payload binding in multiple arm positions.
//
// Event variants:
//   Set(hour, minute)  -- set alarm to given hour/minute      [PAYLOAD]
//   Snooze(minutes)    -- delay current alarm by N minutes     [PAYLOAD]
//   Cancel             -- cancel the alarm (sets active=0)     [NO PAYLOAD]
//   Trigger            -- fire the alarm (increments count)    [NO PAYLOAD]
//   Dismiss            -- dismiss a fired alarm                [NO PAYLOAD]
//
// Scripted sequence:
//   Set(6, 30)     -> hour=6, minute=30, active=1
//   Snooze(5)      -> minute=35, active=1
//   Snooze(5)      -> minute=40, active=1
//   Trigger        -> fire_count=1, active=1
//   Dismiss        -> active=0
//   Set(7, 0)      -> hour=7, minute=0, active=1
//   Trigger        -> fire_count=2, active=1
//   Cancel         -> active=0
//
// Final: hour=7, minute=0, active=0, fire_count=2.
// Check: fire_count*35 = 70. Exit 70.
//
// ====================================================================
// MISCOMPILE FOUND AND FIXED (2026-06-14). Now exits 70.
//
// A no-payload case variant declared AFTER payload-bearing variants
// (Cancel/Trigger/Dismiss after Set/Snooze) was unreachable in native
// dispatch. ROOT CAUSE (not the dispatch compare, which was correct): a bare
// variant value like `AlarmEvent::Trigger` is an `ExpressionNode::Name`, not a
// `StructLiteral`, so argument materialization never hit the case-construction
// branch -- it fell through to a place-copy and read an uninitialized/ZII slot.
// The tag was therefore 0, so only the ordinal-0 variant ever matched (which is
// why alarm_probe2, with Trigger at position 0, accidentally worked).
//
// FIX: argument_materialization.rs now constructs a bare-variant argument --
// when the argument resolves to a case variant (enum_variant_value_in_table),
// it writes the variant's tag ordinal into the parameter's tag word. Guarded by
// the RUN canary control_flow/no_payload_case_variant_after_payload_dispatch_exit.
// ====================================================================

use omega_language_std::console;
use omega::language::core::binding;

data AlarmEvent {
    case Set(hour: i32 in Saturating, minute: i32 in Saturating);
    case Snooze(minutes: i32 in Saturating);
    case Cancel;
    case Trigger;
    case Dismiss;
}

data Alarm [copy] {
    hour: i32 in Saturating;
    minute: i32 in Saturating;
    active: i32 in Saturating;
    fire_count: i32 in Saturating;
}

data Main {
    console: Binding<Console>;
    alarm: Alarm;
    pause: [u8; 256];
}

machine Main::dispatch(main: &mut Main, event: AlarmEvent) {
    transition event {
        AlarmEvent::Set { hour, minute } -> do_set(main, hour, minute)
        AlarmEvent::Snooze { minutes } -> do_snooze(main, minutes)
        AlarmEvent::Cancel -> do_cancel(main)
        AlarmEvent::Trigger -> do_trigger(main)
        AlarmEvent::Dismiss -> do_dismiss(main)
        _ -> done()
    }

    state do_set(main: &mut Main, hour: i32 in Saturating, minute: i32 in Saturating) {
        main.alarm.hour = hour;
        main.alarm.minute = minute;
        main.alarm.active = 1;
    }

    state do_snooze(main: &mut Main, minutes: i32 in Saturating) {
        main.alarm.minute = main.alarm.minute + minutes;
    }

    state do_cancel(main: &mut Main) {
        main.alarm.active = 0;
    }

    state do_trigger(main: &mut Main) {
        main.alarm.fire_count = main.alarm.fire_count + 1;
    }

    state do_dismiss(main: &mut Main) {
        main.alarm.active = 0;
    }

    state done() {}
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("alarm_scheduler: 5-arm case dispatch over a scripted alarm sequence (set/snooze/trigger/dismiss/cancel)");
    Main::dispatch(&mut self, AlarmEvent::Set { hour: 6, minute: 30 });
    Main::dispatch(&mut self, AlarmEvent::Snooze { minutes: 5 });
    Main::dispatch(&mut self, AlarmEvent::Snooze { minutes: 5 });
    Main::dispatch(&mut self, AlarmEvent::Trigger);
    Main::dispatch(&mut self, AlarmEvent::Dismiss);
    Main::dispatch(&mut self, AlarmEvent::Set { hour: 7, minute: 0 });
    Main::dispatch(&mut self, AlarmEvent::Trigger);
    Main::dispatch(&mut self, AlarmEvent::Cancel);

    // fire_count == 2, active == 0, hour == 7, minute == 0
    // Verification: fire_count * 35 == 70
    let score: i32 in Saturating = self.alarm.fire_count * 35;

    transition score == 70 {
        true -> check_active(&mut self)
        _ -> bad_score(&mut self)
    }

    state check_active(main: &mut Main) {
        transition main.alarm.active == 0 {
            true -> check_hour(main)
            _ -> bad_active(main)
        }
    }

    state check_hour(main: &mut Main) {
        transition main.alarm.hour == 7 {
            true -> check_minute(main)
            _ -> bad_hour(main)
        }
    }

    state check_minute(main: &mut Main) {
        transition main.alarm.minute == 0 {
            true -> good(main)
            _ -> bad_minute(main)
        }
    }

    state good(main: &mut Main) {
        main.console.write_line("PASS: fire_count 2, alarm 7:00 inactive after the full sequence (exit 70)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(70);
    }

    state bad_score(main: &mut Main) {
        // Failure arm (wrong fire_count). Historical: this fired natively while the
        // 2026-06-14 miscompile (no-payload variants after payload variants were
        // unreachable) was live; that is fixed and the sample exits 70 via good().
        main.console.write_line("FAIL: fire_count*35 != 70 -- wrong fire_count (exit 71)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(71);
    }

    state bad_active(main: &mut Main) {
        main.console.write_line("FAIL: alarm still active after Cancel (exit 72)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(72);
    }

    state bad_hour(main: &mut Main) {
        main.console.write_line("FAIL: alarm hour != 7 after second Set (exit 73)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(73);
    }

    state bad_minute(main: &mut Main) {
        main.console.write_line("FAIL: alarm minute != 0 after second Set (exit 74)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(74);
    }
}
