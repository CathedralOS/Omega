// Expected exit: 70.
// Alarm scheduler: 5-arm case dispatch stress test.
//
// Exercises: case members with 5 named variants (2 payload-bearing, 3 no-payload),
// multi-arm middle-arm dispatch (arms 0-4), accumulating explicit alarm writes across
// repeated sub-machine calls, and payload binding in multiple arm positions.
//
// Event variants:
//   Set(hour, minute)  -- set alarm to given hour/minute      [PAYLOAD]
//   Snooze(minutes)    -- delay current alarm by N minutes     [PAYLOAD]
//   Cancel             -- cancel the alarm (sets active=0)     [NO PAYLOAD]
//   Trigger            -- fire the alarm (increments count)    [NO PAYLOAD]
//   Dismiss            -- dismiss a fired alarm                [NO PAYLOAD]
//
// Scripted sequence:
//   Set(6, 30)     -> hour=6, minute=30, active=1
//   Snooze(5)      -> minute=35, active=1
//   Snooze(5)      -> minute=40, active=1
//   Trigger        -> fire_count=1, active=1
//   Dismiss        -> active=0
//   Set(7, 0)      -> hour=7, minute=0, active=1
//   Trigger        -> fire_count=2, active=1
//   Cancel         -> active=0
//
// Final: hour=7, minute=0, active=0, fire_count=2.
// Check: fire_count*35 = 70. Exit 70.
//
// The alarm belongs to this invocation; only shared observations cross the
// verification states. Console input buffers are local to the states using them.
// Payload-free variants intentionally follow payload-bearing ones, also covered
// by the no_payload_case_variant_after_payload_dispatch_exit corpus fixture.

use omega_language_std::console;

data AlarmEvent {
    case Set(hour: i32 in Saturating, minute: i32 in Saturating);
    case Snooze(minutes: i32 in Saturating);
    case Cancel;
    case Trigger;
    case Dismiss;
}

data Alarm [copy] {
    hour: i32 in Saturating;
    minute: i32 in Saturating;
    active: i32 in Saturating;
    fire_count: i32 in Saturating;
}

data Main {
}

// Dispatch needs the alarm, not an application context or console authority.
machine Alarm::dispatch(alarm: &mut Alarm, event: AlarmEvent) {
    transition event {
        AlarmEvent::Set { hour, minute } -> do_set(alarm, hour, minute)
        AlarmEvent::Snooze { minutes } -> do_snooze(alarm, minutes)
        AlarmEvent::Cancel -> do_cancel(alarm)
        AlarmEvent::Trigger -> do_trigger(alarm)
        AlarmEvent::Dismiss -> do_dismiss(alarm)
        _ -> done()
    }

    state do_set(alarm: &mut Alarm, hour: i32 in Saturating, minute: i32 in Saturating) {
        alarm.hour = hour;
        alarm.minute = minute;
        alarm.active = 1;
    }

    state do_snooze(alarm: &mut Alarm, minutes: i32 in Saturating) {
        alarm.minute = alarm.minute + minutes;
    }

    state do_cancel(alarm: &mut Alarm) {
        alarm.active = 0;
    }

    state do_trigger(alarm: &mut Alarm) {
        alarm.fire_count = alarm.fire_count + 1;
    }

    state do_dismiss(alarm: &mut Alarm) {
        alarm.active = 0;
    }

    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("alarm_scheduler: 5-arm case dispatch over a scripted alarm sequence (set/snooze/trigger/dismiss/cancel)");
    let mut alarm: Alarm;
    Alarm::dispatch(&mut alarm, AlarmEvent::Set { hour: 6, minute: 30 });
    Alarm::dispatch(&mut alarm, AlarmEvent::Snooze { minutes: 5 });
    Alarm::dispatch(&mut alarm, AlarmEvent::Snooze { minutes: 5 });
    Alarm::dispatch(&mut alarm, AlarmEvent::Trigger);
    Alarm::dispatch(&mut alarm, AlarmEvent::Dismiss);
    Alarm::dispatch(&mut alarm, AlarmEvent::Set { hour: 7, minute: 0 });
    Alarm::dispatch(&mut alarm, AlarmEvent::Trigger);
    Alarm::dispatch(&mut alarm, AlarmEvent::Cancel);

    // fire_count == 2, active == 0, hour == 7, minute == 0
    // Verification: fire_count * 35 == 70
    let score: i32 in Saturating = alarm.fire_count * 35;

    transition score == 70 {
        true -> check_active(main, &alarm)
        _ -> bad_score(main)
    }

    state check_active(main: &mut Main, alarm: &Alarm) {
        transition alarm.active == 0 {
            true -> check_hour(main, alarm)
            _ -> bad_active(main)
        }
    }

    state check_hour(main: &mut Main, alarm: &Alarm) {
        transition alarm.hour == 7 {
            true -> check_minute(main, alarm)
            _ -> bad_hour(main)
        }
    }

    state check_minute(main: &mut Main, alarm: &Alarm) {
        transition alarm.minute == 0 {
            true -> good(main)
            _ -> bad_minute(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: fire_count 2, alarm 7:00 inactive after the full sequence (exit 70)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(70);
    }

    state bad_score(main: &mut Main) {
        Console::write_line("FAIL: fire_count*35 != 70 -- wrong fire_count (exit 71)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(71);
    }

    state bad_active(main: &mut Main) {
        Console::write_line("FAIL: alarm still active after Cancel (exit 72)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(72);
    }

    state bad_hour(main: &mut Main) {
        Console::write_line("FAIL: alarm hour != 7 after second Set (exit 73)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(73);
    }

    state bad_minute(main: &mut Main) {
        Console::write_line("FAIL: alarm minute != 0 after second Set (exit 74)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(74);
    }
}
