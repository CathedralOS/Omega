// A procedurally-generated random walk: a walker (shown '@') wanders a 24x12 grid, each
// step picking a random direction from the xorshift32 PRNG (state % 4) and leaving a trail
// ('*'), re-rendered in place. The first PROCEDURAL sample -- every other animation is a
// fixed algorithm; this one is driven by pseudo-randomness (deterministic from the seed,
// so the harness sees a stable output, but structurally unpredictable). Demonstrates the
// PRNG (locked by operators/runtime_xorshift_prng_exit, applied numerically in
// runtime_monte_carlo_pi_exit) as a usable game/simulation building block. At an edge the
// walker simply stays put that step. Pure compute + stdout + Clock.sleep; no new features.
// Expected exit: 0.
// Expected output contains: @
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 24]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 2]::Utf8(bytes)
requires
    valid_utf8(bytes);
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }

// Declared-host Clock wiring, the pattern `samples/gui/window_app` carries: a
// provider data, a target-scoped `provider_defaults` that selects it, and a
// `satisfies Clock::sleep` machine over the `darwin_poll` leaf. The provider
// holds no state: each call keeps its timeout and poll status in locals, where
// the static-machine contract places invocation scratch.
data WalkClockProvider { }
macos_arm64 machine WalkClockProvider::provider_defaults(defaults: &mut WalkClockProvider) {
    defaults.select_provider<Clock, WalkClockProvider>();
}
macos_arm64 machine WalkClockProvider::sleep(milliseconds: u32) satisfies Clock::sleep
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    grid: [i32; 288] in Wrapping; // 24 x 12 visited trail
    home: [u8; 3] in Utf8;
    line: [u8; 24] in Utf8;
    chars: [u8; 2] in Utf8;       // " *" empty / trail
    st: u32 in Wrapping;          // xorshift state
    sc: u32 in Wrapping;          // shift scratch
    dir: u32 in Wrapping;         // 0=up 1=down 2=left 3=right
    px: i32 in Wrapping;
    py: i32 in Wrapping;
    flat: i32 in Wrapping;
    k: i32 in Wrapping;
    gen: i32 in Wrapping;
    ry: i32 in Wrapping;
    cx: i32 in Wrapping;
    v: i32 in Wrapping;
    glyph: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console + DarwinClock {
    main.console.write_line("random_walk: a pseudo-random walker wanders a 24x12 grid leaving a trail");
    main.px = 12;
    main.py = 6;
    main.st = 2463534242; // a well-mixed xorshift seed
    main.chars = " *";
    main.home = "XXX";
    main.home[0] = 27;
    main.home[1] = 91;
    main.home[2] = 72;
    main.line = "                        ";
    main.k = 0;
    transition { _ -> clear(main) }

    state clear(main: &mut Main) {
        transition main.k >= 0 && main.k < 288 { true -> clear_cell(main) _ -> begin(main) }
    }
    state clear_cell(main: &mut Main) {
        main.grid[main.k] = 0;
        main.k = main.k + 1;
        transition { _ -> clear(main) }
    }
    state begin(main: &mut Main) {
        main.flat = main.py * 24 + main.px;
        main.gen = 0;
        transition main.flat >= 0 && main.flat < 288 { true -> begin_mark(main) _ -> bad(main) }
    }
    state begin_mark(main: &mut Main) {
        main.grid[main.flat] = 1;
        transition { _ -> show(main) }
    }

    // --- render trail + walker in place ---
    state show(main: &mut Main) {
        main.console.write(main.home);
        main.ry = 0;
        transition { _ -> show_row(main) }
    }
    state show_row(main: &mut Main) {
        transition main.ry >= 0 && main.ry < 12 { true -> show_col_init(main) _ -> show_done(main) }
    }
    state show_col_init(main: &mut Main) {
        main.cx = 0;
        transition { _ -> show_col(main) }
    }
    state show_col(main: &mut Main) {
        transition main.cx >= 0 && main.cx < 24 { true -> show_cell(main) _ -> emit_row(main) }
    }
    state show_cell(main: &mut Main) {
        transition main.ry == main.py && main.cx == main.px { true -> put_at(main) _ -> put_trail(main) }
    }
    state put_at(main: &mut Main) {
        main.line[main.cx] = 64; // '@'
        main.cx = main.cx + 1;
        transition { _ -> show_col(main) }
    }
    state put_trail(main: &mut Main) {
        main.flat = main.ry * 24 + main.cx;
        transition main.flat >= 0 && main.flat < 288 { true -> put_trail_w(main) _ -> bad(main) }
    }
    state put_trail_w(main: &mut Main) {
        main.v = main.grid[main.flat];
        transition main.v >= 0 && main.v < 2 { true -> put_trail_g(main) _ -> bad(main) }
    }
    state put_trail_g(main: &mut Main) {
        main.glyph = main.chars[main.v];
        main.line[main.cx] = main.glyph;
        main.cx = main.cx + 1;
        transition { _ -> show_col(main) }
    }
    state emit_row(main: &mut Main) {
        main.console.write_line(main.line);
        main.ry = main.ry + 1;
        transition { _ -> show_row(main) }
    }
    state show_done(main: &mut Main) {
        main.clock.sleep(90);
        transition { _ -> step(main) }
    }

    // --- advance the walk one random step ---
    state step(main: &mut Main) {
        transition main.gen < 70 { true -> advance(main) _ -> finish(main) }
    }
    state advance(main: &mut Main) {
        main.sc = main.st << 13;
        main.st = main.st ^ main.sc;
        main.sc = main.st >> 17;
        main.st = main.st ^ main.sc;
        main.sc = main.st << 5;
        main.st = main.st ^ main.sc;
        main.dir = main.st % 4;
        transition { _ -> move(main) }
    }
    state move(main: &mut Main) {
        transition main.dir == 0 { true -> go_up(main) _ -> move1(main) }
    }
    state move1(main: &mut Main) {
        transition main.dir == 1 { true -> go_down(main) _ -> move2(main) }
    }
    state move2(main: &mut Main) {
        transition main.dir == 2 { true -> go_left(main) _ -> go_right(main) }
    }
    state go_up(main: &mut Main) {
        transition main.py > 0 { true -> up_w(main) _ -> mark(main) }
    }
    state up_w(main: &mut Main) {
        main.py = main.py - 1;
        transition { _ -> mark(main) }
    }
    state go_down(main: &mut Main) {
        transition main.py < 11 { true -> down_w(main) _ -> mark(main) }
    }
    state down_w(main: &mut Main) {
        main.py = main.py + 1;
        transition { _ -> mark(main) }
    }
    state go_left(main: &mut Main) {
        transition main.px > 0 { true -> left_w(main) _ -> mark(main) }
    }
    state left_w(main: &mut Main) {
        main.px = main.px - 1;
        transition { _ -> mark(main) }
    }
    state go_right(main: &mut Main) {
        transition main.px < 23 { true -> right_w(main) _ -> mark(main) }
    }
    state right_w(main: &mut Main) {
        main.px = main.px + 1;
        transition { _ -> mark(main) }
    }
    state mark(main: &mut Main) {
        main.flat = main.py * 24 + main.px;
        main.gen = main.gen + 1;
        transition main.flat >= 0 && main.flat < 288 { true -> mark_w(main) _ -> bad(main) }
    }
    state mark_w(main: &mut Main) {
        main.grid[main.flat] = 1;
        transition { _ -> show(main) }
    }

    state finish(main: &mut Main) {
        main.console.write_line("PASS: 70 random steps walked and rendered (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: grid index out of bounds guard tripped (exit 1)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(1);
    }
}
