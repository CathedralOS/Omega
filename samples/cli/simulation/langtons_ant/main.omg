// Langton's Ant -- a famous (Turing-complete!) cellular automaton in which a single agent
// following a trivial local rule produces emergent structure. The ant sits on a cell of a
// two-color grid: on a WHITE cell it turns right, paints the cell black, and steps forward;
// on a BLACK cell it turns left, paints it white, and steps forward. From an empty grid
// this builds a chaotic-but-symmetric blob (and, after ~10k steps, a self-organizing
// "highway"). DETERMINISTIC -- no PRNG -- so the harness sees stable output. The toroidal
// grid wraps at the edges. Demonstrates Omega running a real agent simulation: a flat grid
// as mutable state, a direction dispatch, in-place cell mutation, and animated rendering
// ('#' = black cell, '@' = ant). Pure compute + stdout + Clock.sleep; no new features.
// Expected exit: 0.
// Expected output contains: @
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 24]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 2]::Utf8(bytes)
requires
    valid_utf8(bytes);
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }

// Declared-host Clock wiring, the pattern `samples/gui/window_app` carries: a
// provider data, a target-scoped `provider_defaults` that selects it, and a
// `satisfies Clock::sleep` machine over the `darwin_poll` leaf. The provider
// holds no state: each call keeps its timeout and poll status in locals, where
// the static-machine contract places invocation scratch.
data PacingClockProvider { }
macos_arm64 machine PacingClockProvider::provider_defaults(defaults: &mut PacingClockProvider) {
    defaults.select_provider<Clock, PacingClockProvider>();
}
macos_arm64 machine PacingClockProvider::sleep(milliseconds: u32) satisfies Clock::sleep
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    grid: [i32; 336] in Wrapping; // 24 x 14 cell colors (0=white, 1=black)
    home: [u8; 3] in Utf8;
    line: [u8; 24] in Utf8;
    chars: [u8; 2] in Utf8;       // " #" white / black
    ax: i32 in Wrapping;          // ant column
    ay: i32 in Wrapping;          // ant row
    ad: i32 in Wrapping;          // ant direction 0=up 1=right 2=down 3=left
    flat: i32 in Wrapping;
    c: i32 in Wrapping;           // current cell color
    k: i32 in Wrapping;
    gen: i32 in Wrapping;
    ry: i32 in Wrapping;
    cx: i32 in Wrapping;
    v: i32 in Wrapping;
    glyph: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console + DarwinClock {
    main.console.write_line("langtons_ant: an ant on a two-color toroidal grid, 120 animated steps");
    main.ax = 12;
    main.ay = 7;
    main.ad = 0;
    main.chars = " #";
    main.home = "XXX";
    main.home[0] = 27;
    main.home[1] = 91;
    main.home[2] = 72;
    main.line = "                        ";
    main.k = 0;
    main.gen = 0;
    transition { _ -> clear(main) }

    state clear(main: &mut Main) {
        transition main.k >= 0 && main.k < 336 { true -> clear_cell(main) _ -> show(main) }
    }
    state clear_cell(main: &mut Main) {
        main.grid[main.k] = 0;
        main.k = main.k + 1;
        transition { _ -> clear(main) }
    }

    // --- render grid + ant in place ---
    state show(main: &mut Main) {
        main.console.write(main.home);
        main.ry = 0;
        transition { _ -> show_row(main) }
    }
    state show_row(main: &mut Main) {
        transition main.ry >= 0 && main.ry < 14 { true -> show_col_init(main) _ -> show_done(main) }
    }
    state show_col_init(main: &mut Main) {
        main.cx = 0;
        transition { _ -> show_col(main) }
    }
    state show_col(main: &mut Main) {
        transition main.cx >= 0 && main.cx < 24 { true -> show_cell(main) _ -> emit_row(main) }
    }
    state show_cell(main: &mut Main) {
        transition main.ry == main.ay && main.cx == main.ax { true -> put_ant(main) _ -> put_cell(main) }
    }
    state put_ant(main: &mut Main) {
        main.line[main.cx] = 64; // '@'
        main.cx = main.cx + 1;
        transition { _ -> show_col(main) }
    }
    state put_cell(main: &mut Main) {
        main.flat = main.ry * 24 + main.cx;
        transition main.flat >= 0 && main.flat < 336 { true -> put_cell_r(main) _ -> bad(main) }
    }
    state put_cell_r(main: &mut Main) {
        main.v = main.grid[main.flat];
        transition main.v >= 0 && main.v < 2 { true -> put_cell_g(main) _ -> bad(main) }
    }
    state put_cell_g(main: &mut Main) {
        main.glyph = main.chars[main.v];
        main.line[main.cx] = main.glyph;
        main.cx = main.cx + 1;
        transition { _ -> show_col(main) }
    }
    state emit_row(main: &mut Main) {
        main.console.write_line(main.line);
        main.ry = main.ry + 1;
        transition { _ -> show_row(main) }
    }
    state show_done(main: &mut Main) {
        main.clock.sleep(45);
        transition { _ -> step(main) }
    }

    // --- one ant step: read cell, turn + flip, move forward (toroidal) ---
    state step(main: &mut Main) {
        transition main.gen < 120 { true -> rule(main) _ -> finish(main) }
    }
    state rule(main: &mut Main) {
        main.flat = main.ay * 24 + main.ax;
        transition main.flat >= 0 && main.flat < 336 { true -> rule_read(main) _ -> bad(main) }
    }
    state rule_read(main: &mut Main) {
        main.c = main.grid[main.flat];
        transition main.c == 0 { true -> on_white(main) _ -> on_black(main) }
    }
    // white cell: paint black, turn right (ad + 1)
    state on_white(main: &mut Main) {
        main.grid[main.flat] = 1;
        main.ad = main.ad + 1;
        transition main.ad > 3 { true -> wrap_r(main) _ -> move_ant(main) }
    }
    state wrap_r(main: &mut Main) {
        main.ad = 0;
        transition { _ -> move_ant(main) }
    }
    // black cell: paint white, turn left (ad - 1)
    state on_black(main: &mut Main) {
        main.grid[main.flat] = 0;
        main.ad = main.ad - 1;
        transition main.ad < 0 { true -> wrap_l(main) _ -> move_ant(main) }
    }
    state wrap_l(main: &mut Main) {
        main.ad = 3;
        transition { _ -> move_ant(main) }
    }

    // move forward by ad, wrapping toroidally
    state move_ant(main: &mut Main) {
        transition main.ad == 0 { true -> go_up(main) _ -> move1(main) }
    }
    state move1(main: &mut Main) {
        transition main.ad == 1 { true -> go_right(main) _ -> move2(main) }
    }
    state move2(main: &mut Main) {
        transition main.ad == 2 { true -> go_down(main) _ -> go_left(main) }
    }
    state go_up(main: &mut Main) {
        main.ay = main.ay - 1;
        transition main.ay < 0 { true -> wrap_ay_hi(main) _ -> advance(main) }
    }
    state wrap_ay_hi(main: &mut Main) {
        main.ay = 13;
        transition { _ -> advance(main) }
    }
    state go_down(main: &mut Main) {
        main.ay = main.ay + 1;
        transition main.ay > 13 { true -> wrap_ay_lo(main) _ -> advance(main) }
    }
    state wrap_ay_lo(main: &mut Main) {
        main.ay = 0;
        transition { _ -> advance(main) }
    }
    state go_left(main: &mut Main) {
        main.ax = main.ax - 1;
        transition main.ax < 0 { true -> wrap_ax_hi(main) _ -> advance(main) }
    }
    state wrap_ax_hi(main: &mut Main) {
        main.ax = 23;
        transition { _ -> advance(main) }
    }
    state go_right(main: &mut Main) {
        main.ax = main.ax + 1;
        transition main.ax > 23 { true -> wrap_ax_lo(main) _ -> advance(main) }
    }
    state wrap_ax_lo(main: &mut Main) {
        main.ax = 0;
        transition { _ -> advance(main) }
    }
    state advance(main: &mut Main) {
        main.gen = main.gen + 1;
        transition { _ -> show(main) }
    }

    state finish(main: &mut Main) {
        main.console.write_line("PASS: 120 ant steps rendered (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: internal bounds check failed (exit 1)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(1);
    }
}
