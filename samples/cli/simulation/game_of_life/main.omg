    }
    state live_1(context: &mut Main) { context.g.next[1] = 1; }
    state check_cur_1(context: &mut Main, cur: i32 in Wrapping, n: i32 in Wrapping) {
        transition cur == 1 {
            true -> check_two_1(context, n)
            _ -> die_1(context)
