        }
    }
    state live2_14(context: &mut Main) { context.g.next[14] = 1; }
    state die_14(context: &mut Main) { context.g.next[14] = 0; }
}

// Cell 15 (3,3): neighbors = cells[10]+cells[11]+cells[14]
machine Main::compute_cell_15(context: &mut Main) {
    cell_is_bit(&context.g.board, 10);
    cell_is_bit(&context.g.board, 11);
    cell_is_bit(&context.g.board, 14);
    let n: i32 in Wrapping = (context.g.board[10] + context.g.board[11] + context.g.board[14]) as i32 in Wrapping;
    let cur: i32 in Wrapping = context.g.board[15] as i32 in Wrapping;
    transition n == 3 {
        true -> live_15(context)
        _ -> check_cur_15(context, cur, n)
    }
    state live_15(context: &mut Main) { context.g.next[15] = 1; }
    state check_cur_15(context: &mut Main, cur: i32 in Wrapping, n: i32 in Wrapping) {
        transition cur == 1 {
            true -> check_two_15(context, n)
            _ -> die_15(context)
        }
    }
    state check_two_15(context: &mut Main, n: i32 in Wrapping) {
        transition n == 2 {
            true -> live2_15(context)
            _ -> die_15(context)
        }
    }
    state live2_15(context: &mut Main) { context.g.next[15] = 1; }
    state die_15(context: &mut Main) { context.g.next[15] = 0; }
}

// Run one generation: compute next board for all 16 cells.
machine Main::step(context: &mut Main) {
    Main::compute_cell_0(context);
    Main::compute_cell_1(context);
    Main::compute_cell_2(context);
    Main::compute_cell_3(context);
    Main::compute_cell_4(context);
    Main::compute_cell_5(context);
    Main::compute_cell_6(context);
    Main::compute_cell_7(context);
    Main::compute_cell_8(context);
    Main::compute_cell_9(context);
    Main::compute_cell_10(context);
    Main::compute_cell_11(context);
    Main::compute_cell_12(context);
    Main::compute_cell_13(context);
    Main::compute_cell_14(context);
    Main::compute_cell_15(context);
}

// Compute sum of all 16 next-board cells.
machine Main::checksum(context: &mut Main) -> i32 {
    cell_is_bit(&context.g.next, 0);
    cell_is_bit(&context.g.next, 1);
    cell_is_bit(&context.g.next, 2);
    cell_is_bit(&context.g.next, 3);
    cell_is_bit(&context.g.next, 4);
    cell_is_bit(&context.g.next, 5);
    cell_is_bit(&context.g.next, 6);
    cell_is_bit(&context.g.next, 7);
    cell_is_bit(&context.g.next, 8);
    cell_is_bit(&context.g.next, 9);
    cell_is_bit(&context.g.next, 10);
    cell_is_bit(&context.g.next, 11);
    cell_is_bit(&context.g.next, 12);
    cell_is_bit(&context.g.next, 13);
    cell_is_bit(&context.g.next, 14);
    cell_is_bit(&context.g.next, 15);
    transition {
        _ -> (
            context.g.next[0] + context.g.next[1] + context.g.next[2] + context.g.next[3] +
            context.g.next[4] + context.g.next[5] + context.g.next[6] + context.g.next[7] +
            context.g.next[8] + context.g.next[9] + context.g.next[10] + context.g.next[11] +
            context.g.next[12] + context.g.next[13] + context.g.next[14] + context.g.next[15]
        )
    }
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("game_of_life: one generation of a 2x2 still-life block on a 4x4 grid");
    // Seed the board with the 2x2 block still-life.
    Main::init_board(context);

    // Run one generation (block -> same block).
    Main::step(context);

    // Checksum the next board: should be 4 (4 alive cells).
    let sum: i32 in Wrapping = Main::checksum(context) as i32 in Wrapping;
    let code: i32 in Wrapping = sum + context.g.offset;

    transition code == 70 {
        true -> good(context)
        _ -> bad(context)
    }

    state good(context: &mut Main) {
        Console::write_line("PASS: block still-life preserved, checksum 4 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut context.pause);
        Console::exit_process(70);
    }

    state bad(context: &mut Main) {
        Console::write_line("FAIL: wrong checksum after one generation (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut context.pause);
        Console::exit_process(71);
    }
}
