// Conway's Game of Life on a 4x4 flat grid ([i32; 16], row-major).
//
// Seed pattern: 2x2 Block (still-life) at rows 1-2, cols 1-2:
//
//   . . . .      index layout:  0  1  2  3
//   . X X .                     4  5  6  7
//   . X X .                     8  9 10 11
//   . . . .                    12 13 14 15
//
// Alive cells: board[5]=1, board[6]=1, board[9]=1, board[10]=1.
// All others: 0.
//
// Rules: alive survives with 2 or 3 neighbors; dead born with exactly 3.
//
// The 2x2 block is a still-life: after any number of generations the board
// is identical to the seed. After 1 generation, the same 4 cells are alive.
//
// Neighbor counts (verified by hand):
//   cell 5 (1,1): n=3 -> alive stays alive
//   cell 6 (1,2): n=3 -> alive stays alive
//   cell 9 (2,1): n=3 -> alive stays alive
//   cell 10 (2,2): n=3 -> alive stays alive
//   all dead cells: n<=2 -> stay dead
//
// Checksum = sum of all 16 next-board cells after 1 generation = 4.
// Exit code = checksum + offset (offset=66) = 70.
//
// Cells are dead (0) or alive (1). `Grid`'s default domain states that with
// the ordinary predicate machine `cells_valid`, which walks the sixteen cells
// with one state each (a collection invariant). The zeroed grid satisfies it,
// and every store of 0 or 1 restores it. The helper theorem `cell_is_bit`
// selects one cell's bound from the predicate; each neighbor sum and the
// checksum cite it for every cell they add, which proves their Exact `i32`
// arithmetic.
//
// Expected exit: 70.

use omega_language_std::console;

// Whether every cell is dead (0) or alive (1), one state per cell.
machine cells_valid(cells: &[i32; 16]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    state at_1(cells: &[i32; 16]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    state at_2(cells: &[i32; 16]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    state at_3(cells: &[i32; 16]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> at_4(cells)
            _ -> (false)
        }
    }

    state at_4(cells: &[i32; 16]) -> bool {
        transition cells[4] == 0 || cells[4] == 1 {
            true -> at_5(cells)
            _ -> (false)
        }
    }

    state at_5(cells: &[i32; 16]) -> bool {
        transition cells[5] == 0 || cells[5] == 1 {
            true -> at_6(cells)
            _ -> (false)
        }
    }

    state at_6(cells: &[i32; 16]) -> bool {
        transition cells[6] == 0 || cells[6] == 1 {
            true -> at_7(cells)
            _ -> (false)
        }
    }

    state at_7(cells: &[i32; 16]) -> bool {
        transition cells[7] == 0 || cells[7] == 1 {
            true -> at_8(cells)
            _ -> (false)
        }
    }

    state at_8(cells: &[i32; 16]) -> bool {
        transition cells[8] == 0 || cells[8] == 1 {
            true -> at_9(cells)
            _ -> (false)
        }
    }

    state at_9(cells: &[i32; 16]) -> bool {
        transition cells[9] == 0 || cells[9] == 1 {
            true -> at_10(cells)
            _ -> (false)
        }
    }

    state at_10(cells: &[i32; 16]) -> bool {
        transition cells[10] == 0 || cells[10] == 1 {
            true -> at_11(cells)
            _ -> (false)
        }
    }

    state at_11(cells: &[i32; 16]) -> bool {
        transition cells[11] == 0 || cells[11] == 1 {
            true -> at_12(cells)
            _ -> (false)
        }
    }

    state at_12(cells: &[i32; 16]) -> bool {
        transition cells[12] == 0 || cells[12] == 1 {
            true -> at_13(cells)
            _ -> (false)
        }
    }

    state at_13(cells: &[i32; 16]) -> bool {
        transition cells[13] == 0 || cells[13] == 1 {
            true -> at_14(cells)
            _ -> (false)
        }
    }

    state at_14(cells: &[i32; 16]) -> bool {
        transition cells[14] == 0 || cells[14] == 1 {
            true -> at_15(cells)
            _ -> (false)
        }
    }

    state at_15(cells: &[i32; 16]) -> bool {
        transition cells[15] == 0 || cells[15] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

// A valid board's selected cell is 0 or 1. The checker proves this by
// exploring `cells_valid`'s states under the premise, one index at a time.
machine cell_is_bit(cells: &[i32; 16], index: u64)
requires cells_valid(cells) == true
requires index < 16
ensures cells[index] >= 0 && cells[index] <= 1
{
}

data Grid [copy] where cells_valid(&board) == true, cells_valid(&next) == true {
    board: [i32; 16];
    next: [i32; 16];
    offset: i32 in Wrapping;
}

data Main {
    g: Grid;
    pause: [u8; 256];
}

// Initialize the board with the 2x2 block still-life at positions 5,6,9,10.
machine Main::init_board(context: &mut Main) {
    context.g.board[5] = 1;
    context.g.board[6] = 1;
    context.g.board[9] = 1;
    context.g.board[10] = 1;
    context.g.offset = 66;
}

// Cell 0 (0,0): neighbors = cells[1]+cells[4]+cells[5]
machine Main::compute_cell_0(context: &mut Main) {
    cell_is_bit(&context.g.board, 1);
    cell_is_bit(&context.g.board, 4);
    cell_is_bit(&context.g.board, 5);
    let n: i32 in Wrapping = (context.g.board[1] + context.g.board[4] + context.g.board[5]) as i32 in Wrapping;
    let cur: i32 in Wrapping = context.g.board[0] as i32 in Wrapping;
    transition n == 3 {
        true -> live_0(context)
        _ -> check_cur_0(context, cur, n)
    }
    state live_0(context: &mut Main) { context.g.next[0] = 1; }
    state check_cur_0(context: &mut Main, cur: i32 in Wrapping, n: i32 in Wrapping) {
        transition cur == 1 {
            true -> check_two_0(context, n)
            _ -> die_0(context)
        }
    }
    state check_two_0(context: &mut Main, n: i32 in Wrapping) {
        transition n == 2 {
            true -> live2_0(context)
            _ -> die_0(context)
        }
    }
    state live2_0(context: &mut Main) { context.g.next[0] = 1; }
    state die_0(context: &mut Main) { context.g.next[0] = 0; }
}

// Cell 1 (0,1): neighbors = cells[0]+cells[2]+cells[4]+cells[5]+cells[6]
machine Main::compute_cell_1(context: &mut Main) {
    cell_is_bit(&context.g.board, 0);
    cell_is_bit(&context.g.board, 2);
    cell_is_bit(&context.g.board, 4);
