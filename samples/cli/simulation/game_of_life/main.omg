// Conway's Game of Life on a 4x4 flat grid ([i32; 16], row-major).
//
// Seed pattern: 2x2 Block (still-life) at rows 1-2, cols 1-2:
//
//   . . . .      index layout:  0  1  2  3
//   . X X .                     4  5  6  7
//   . X X .                     8  9 10 11
//   . . . .                    12 13 14 15
//
// Alive cells: board[5]=1, board[6]=1, board[9]=1, board[10]=1.
// All others: 0.
//
// Rules: alive survives with 2 or 3 neighbors; dead born with exactly 3.
//
// The 2x2 block is a still-life: after any number of generations the board
// is identical to the seed. After 1 generation, the same 4 cells are alive.
//
// Neighbor counts (verified by hand):
//   cell 5 (1,1): n=3 -> alive stays alive
//   cell 6 (1,2): n=3 -> alive stays alive
//   cell 9 (2,1): n=3 -> alive stays alive
//   cell 10 (2,2): n=3 -> alive stays alive
//   all dead cells: n<=2 -> stay dead
//
// Checksum = sum of all 16 next-board cells after 1 generation = 4.
// Exit code = checksum + offset (offset=66) = 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Grid [copy] {
    board: [i32; 16];
    next: [i32; 16];
    offset: i32 in Wrapping;
}

data Main {
    console: Console;
    g: Grid;
    pause: [u8; 256];
}

// Initialize the board with the 2x2 block still-life at positions 5,6,9,10.
machine Main::init_board(&mut self) {
    self.g.board[5] = 1;
    self.g.board[6] = 1;
    self.g.board[9] = 1;
    self.g.board[10] = 1;
    self.g.offset = 66;
}

// Cell 0 (0,0): neighbors = cells[1]+cells[4]+cells[5]
machine Main::compute_cell_0(&mut self) {
    let n: i32 in Wrapping = self.g.board[1] + self.g.board[4] + self.g.board[5];
    let cur: i32 in Wrapping = self.g.board[0];
    transition n == 3 {
        true -> live_0()
        _ -> check_cur_0(cur, n)
    }
    state live_0(&mut self) { self.g.next[0] = 1; }
    state check_cur_0(&mut self, cur: i32 in Wrapping, n: i32 in Wrapping) {
        transition cur == 1 {
            true -> check_two_0(n)
            _ -> die_0()
        }
    }
    state check_two_0(&mut self, n: i32 in Wrapping) {
        transition n == 2 {
            true -> live2_0()
            _ -> die_0()
        }
    }
    state live2_0(&mut self) { self.g.next[0] = 1; }
    state die_0(&mut self) { self.g.next[0] = 0; }
}

// Cell 1 (0,1): neighbors = cells[0]+cells[2]+cells[4]+cells[5]+cells[6]
machine Main::compute_cell_1(&mut self) {
    let n: i32 in Wrapping = self.g.board[0] + self.g.board[2] + self.g.board[4] + self.g.board[5] + self.g.board[6];
    let cur: i32 in Wrapping = self.g.board[1];
    transition n == 3 {
