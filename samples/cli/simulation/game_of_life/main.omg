}

// Cell 12 (3,0): neighbors = cells[8]+cells[9]+cells[13]
machine Main::compute_cell_12(context: &mut Main) {
    cell_is_bit(&context.g.board, 8);
    cell_is_bit(&context.g.board, 9);
    cell_is_bit(&context.g.board, 13);
    let n: i32 in Wrapping = (context.g.board[8] + context.g.board[9] + context.g.board[13]) as i32 in Wrapping;
    let cur: i32 in Wrapping = context.g.board[12] as i32 in Wrapping;
    transition n == 3 {
        true -> live_12(context)
        _ -> check_cur_12(context, cur, n)
    }
    state live_12(context: &mut Main) { context.g.next[12] = 1; }
    state check_cur_12(context: &mut Main, cur: i32 in Wrapping, n: i32 in Wrapping) {
        transition cur == 1 {
            true -> check_two_12(context, n)
            _ -> die_12(context)
        }
    }
    state check_two_12(context: &mut Main, n: i32 in Wrapping) {
        transition n == 2 {
            true -> live2_12(context)
            _ -> die_12(context)
        }
    }
    state live2_12(context: &mut Main) { context.g.next[12] = 1; }
    state die_12(context: &mut Main) { context.g.next[12] = 0; }
}

// Cell 13 (3,1): neighbors = cells[8]+cells[9]+cells[10]+cells[12]+cells[14]
machine Main::compute_cell_13(context: &mut Main) {
    cell_is_bit(&context.g.board, 8);
    cell_is_bit(&context.g.board, 9);
    cell_is_bit(&context.g.board, 10);
    cell_is_bit(&context.g.board, 12);
    cell_is_bit(&context.g.board, 14);
    let n: i32 in Wrapping = (context.g.board[8] + context.g.board[9] + context.g.board[10] + context.g.board[12] + context.g.board[14]) as i32 in Wrapping;
    let cur: i32 in Wrapping = context.g.board[13] as i32 in Wrapping;
    transition n == 3 {
        true -> live_13(context)
        _ -> check_cur_13(context, cur, n)
    }
    state live_13(context: &mut Main) { context.g.next[13] = 1; }
    state check_cur_13(context: &mut Main, cur: i32 in Wrapping, n: i32 in Wrapping) {
        transition cur == 1 {
            true -> check_two_13(context, n)
            _ -> die_13(context)
        }
    }
    state check_two_13(context: &mut Main, n: i32 in Wrapping) {
        transition n == 2 {
            true -> live2_13(context)
            _ -> die_13(context)
        }
    }
    state live2_13(context: &mut Main) { context.g.next[13] = 1; }
    state die_13(context: &mut Main) { context.g.next[13] = 0; }
}

// Cell 14 (3,2): neighbors = cells[9]+cells[10]+cells[11]+cells[13]+cells[15]
machine Main::compute_cell_14(context: &mut Main) {
    cell_is_bit(&context.g.board, 9);
    cell_is_bit(&context.g.board, 10);
    cell_is_bit(&context.g.board, 11);
    cell_is_bit(&context.g.board, 13);
    cell_is_bit(&context.g.board, 15);
    let n: i32 in Wrapping = (context.g.board[9] + context.g.board[10] + context.g.board[11] + context.g.board[13] + context.g.board[15]) as i32 in Wrapping;
    let cur: i32 in Wrapping = context.g.board[14] as i32 in Wrapping;
    transition n == 3 {
        true -> live_14(context)
        _ -> check_cur_14(context, cur, n)
    }
    state live_14(context: &mut Main) { context.g.next[14] = 1; }
    state check_cur_14(context: &mut Main, cur: i32 in Wrapping, n: i32 in Wrapping) {
        transition cur == 1 {
            true -> check_two_14(context, n)
            _ -> die_14(context)
        }
    }
    state check_two_14(context: &mut Main, n: i32 in Wrapping) {
        transition n == 2 {
            true -> live2_14(context)
