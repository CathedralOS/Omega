    state die_15(&mut self) { self.g.next[15] = 0; }
}

// Run one generation: compute next board for all 16 cells.
machine Main::step(&mut self) {
    self.compute_cell_0();
    self.compute_cell_1();
    self.compute_cell_2();
    self.compute_cell_3();
    self.compute_cell_4();
    self.compute_cell_5();
    self.compute_cell_6();
    self.compute_cell_7();
    self.compute_cell_8();
    self.compute_cell_9();
    self.compute_cell_10();
    self.compute_cell_11();
    self.compute_cell_12();
    self.compute_cell_13();
    self.compute_cell_14();
    self.compute_cell_15();
}

// Compute sum of all 16 next-board cells.
machine Main::checksum(&mut self) -> i32 {
    transition {
        _ -> (
            self.g.next[0] + self.g.next[1] + self.g.next[2] + self.g.next[3] +
            self.g.next[4] + self.g.next[5] + self.g.next[6] + self.g.next[7] +
            self.g.next[8] + self.g.next[9] + self.g.next[10] + self.g.next[11] +
            self.g.next[12] + self.g.next[13] + self.g.next[14] + self.g.next[15]
        )
    }
}

machine Main::main(&mut self) {
    self.console.write_line("game_of_life: one generation of a 2x2 still-life block on a 4x4 grid");
    // Seed the board with the 2x2 block still-life.
    self.init_board();

    // Run one generation (block -> same block).
    self.step();

    // Checksum the next board: should be 4 (4 alive cells).
    let sum: i32 in Wrapping = self.checksum();
    let code: i32 in Wrapping = sum + self.g.offset;

    transition code == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.write_line("PASS: block still-life preserved, checksum 4 (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.write_line("FAIL: wrong checksum after one generation (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
