// Elevator controller. Combines case-payload commands, scalar self-writes,
// and multi-state FSM transitions.
//
// Commands:
//   GoTo(floor)  -- move to the given floor
//   OpenDoor     -- open the door (only valid at a floor)
//   CloseDoor    -- close the door
//
// Rules:
//   - Floor is 0-indexed (0=ground, 1=first, 2=second).
//   - The door starts closed.
//   - Moves are only processed when the door is closed.
//
// Scripted sequence:
//   GoTo(2)     -> floor=2, moves=1
//   OpenDoor    -> door_open=1
//   CloseDoor   -> door_open=0
//   GoTo(0)     -> floor=0, moves=2
//   GoTo(1)     -> floor=1, moves=3
//   OpenDoor    -> door_open=1
//
// Final state: floor=1, moves=3, door_open=1.
// Encode: floor*10 + moves*10 + door_open*40 = 10+30+40 = 80...
// Simpler: exit 70 when floor==1 && moves==3 && door_open==1.
//
// Expected exit: 70.

use omega_language_std::console;

data Command {
    case GoTo(floor: i32);
    case OpenDoor;
    case CloseDoor;
}

data Elevator [copy] {
    floor: i32;
    door_open: i32;
    // Ranged + the modular-counter idiom at the increment: Exact-provable, no
    // overflow domain (nested-field arithmetic carries the decision-17
    // obligation; the `% 101` declares the wrap-at-ceiling behavior).
    moves: i32 [0..=100];
}

data Main {
    console: Console;
    lift: Elevator;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("elevator: case-payload commands drive a door/floor FSM through 6 scripted steps");
    self.send(Command::GoTo { floor: 2 });
    self.send(Command::OpenDoor);
    self.send(Command::CloseDoor);
    self.send(Command::GoTo { floor: 0 });
    self.send(Command::GoTo { floor: 1 });
    self.send(Command::OpenDoor);

    // floor==1, moves==3, door_open==1 -> exit 70.
    transition self.lift.floor == 1 {
        true -> check_moves()
        _ -> bad_floor()
    }

    state check_moves(&mut self) {
        transition self.lift.moves == 3 {
            true -> check_door()
            _ -> bad_moves()
        }
    }

    state check_door(&mut self) {
        transition self.lift.door_open == 1 {
            true -> good()
            _ -> bad_door()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: ends at floor 1 after 3 moves with the door open (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad_floor(&mut self) {
        self.console.write_line("FAIL: final floor != 1 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state bad_moves(&mut self) {
        self.console.write_line("FAIL: move count != 3 -- door-closed gating wrong (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state bad_door(&mut self) {
        self.console.write_line("FAIL: door not open at the end (exit 73)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }
}

// Dispatch a command to the elevator.
machine Main::send(&mut self, cmd: Command) {
    transition cmd {
        Command::GoTo { floor } -> handle_goto(floor)
        Command::OpenDoor -> handle_open()
        Command::CloseDoor -> handle_close()
        _ -> done()
    }

    // GoTo: only move if door is closed.
    state handle_goto(&mut self, floor: i32) {
        transition self.lift.door_open == 0 {
            true -> do_move(floor)
            _ -> done()
        }
    }

    state do_move(&mut self, floor: i32) {
        self.lift.floor = floor;
        self.lift.moves = (self.lift.moves + 1) % 101;
    }

    state handle_open(&mut self) {
        self.lift.door_open = 1;
    }

    state handle_close(&mut self) {
        self.lift.door_open = 0;
    }

    state done(&mut self) {
    }
}
