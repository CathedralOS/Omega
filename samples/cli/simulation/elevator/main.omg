// Elevator controller. Combines case-payload commands, scalar self-writes,
// and multi-state FSM transitions.
//
// Commands:
//   GoTo(floor)  -- move to the given floor
//   OpenDoor     -- open the door (only valid at a floor)
//   CloseDoor    -- close the door
//
// Rules:
//   - Floor is 0-indexed (0=ground, 1=first, 2=second).
//   - The door starts closed.
//   - Moves are only processed when the door is closed.
//
// Scripted sequence:
//   GoTo(2)     -> floor=2, moves=1
//   OpenDoor    -> door_open=1
//   CloseDoor   -> door_open=0
//   GoTo(0)     -> floor=0, moves=2
//   GoTo(1)     -> floor=1, moves=3
//   OpenDoor    -> door_open=1
//
// Final state: floor=1, moves=3, door_open=1.
// Encode: floor*10 + moves*10 + door_open*40 = 10+30+40 = 80...
// Simpler: exit 70 when floor==1 && moves==3 && door_open==1.
//
// Expected exit: 70.

use omega_language_std::console;

data Command {
    case GoTo(floor: i32);
    case OpenDoor;
    case CloseDoor;
}

data Elevator [copy] {
    floor: i32;
    door_open: i32;
    // The modular-counter idiom at the increment: reducing `% 101` before the
    // `+ 1` makes it Exact-provable with no overflow domain (nested-field
    // arithmetic carries the decision-17 obligation; the outer `% 101`
    // declares the wrap-at-ceiling behavior).
    moves: i32;
}

data Main {
    lift: Elevator;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("elevator: case-payload commands drive a door/floor FSM through 6 scripted steps");
    Main::send(main, Command::GoTo { floor: 2 });
    Main::send(main, Command::OpenDoor);
    Main::send(main, Command::CloseDoor);
    Main::send(main, Command::GoTo { floor: 0 });
    Main::send(main, Command::GoTo { floor: 1 });
    Main::send(main, Command::OpenDoor);

    // floor==1, moves==3, door_open==1 -> exit 70.
    transition main.lift.floor == 1 {
        true -> check_moves(main)
        _ -> bad_floor(main)
    }

    state check_moves(main: &mut Main) {
        transition main.lift.moves == 3 {
            true -> check_door(main)
            _ -> bad_moves(main)
        }
    }

    state check_door(main: &mut Main) {
        transition main.lift.door_open == 1 {
            true -> good(main)
            _ -> bad_door(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: ends at floor 1 after 3 moves with the door open (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad_floor(main: &mut Main) {
        Console::write_line("FAIL: final floor != 1 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state bad_moves(main: &mut Main) {
        Console::write_line("FAIL: move count != 3 -- door-closed gating wrong (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state bad_door(main: &mut Main) {
        Console::write_line("FAIL: door not open at the end (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }
}

// Dispatch a command to the elevator.
machine Main::send(main: &mut Main, cmd: Command) {
    transition cmd {
        Command::GoTo { floor } -> handle_goto(main, floor)
        Command::OpenDoor -> handle_open(main)
        Command::CloseDoor -> handle_close(main)
        _ -> done()
    }

    // GoTo: only move if door is closed.
    state handle_goto(main: &mut Main, floor: i32) {
        transition main.lift.door_open == 0 {
            true -> do_move(main, floor)
            _ -> done()
        }
    }

    state do_move(main: &mut Main, floor: i32) {
        main.lift.floor = floor;
        main.lift.moves = (main.lift.moves % 101 + 1) % 101;
    }

    state handle_open(main: &mut Main) {
        main.lift.door_open = 1;
    }

    state handle_close(main: &mut Main) {
        main.lift.door_open = 0;
    }

    state done() {
    }
}
