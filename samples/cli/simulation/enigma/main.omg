// enigma: a table-driven Enigma I. The published wirings sit in `[i32; 26]`
// fields as decoded letter values (A = 0 .. Z = 25), an inversion loop
// derives the inverse tables at runtime, and every rotor pass is a
// runtime-indexed table read inside `core_perm`.
//
// Mechanism: rotors I II III sit left to right with reflector B behind them.
// Before each letter the wheels step: the right wheel (III) always advances;
// when the right wheel shows its notch letter V the middle wheel (II) steps
// with it; when the middle wheel shows its own notch E the middle AND the
// left wheel step -- the double-step anomaly. A letter then travels
// plugboard -> right/middle/left forward -> reflector -> left/middle/right
// inverse -> plugboard. With the wheel at window position p each pass maps
// signal s as
//     out = (wiring[(s + p) mod 26] - p + 26) mod 26
// written here with `+ 26` before `% 26` so every operand stays nonnegative
// and the checker can bound every index without a Wrapping opt-in.
//
// Proof discipline: a table read lands as an unproven i32, so it crosses to
// the next state through a guard arm and arrives bounded by that state's
// `requires`; index arithmetic happens inside a state where the operands are
// requires-bounded params. Field values are copied into `let` locals before
// guarding because facts attach to values, not field paths, and a `&mut`
// borrow cannot share a call with reads of its own fields.
//
// The scrambler (`core_perm`), plugboard wrapper (`enc_char`), and stepping
// odometer (`step3`) are unit machines that write result fields rather than
// i32 results so the lowering proof-search never treats them as
// scalar-result callees. The entry machine stays shallow by delegating to
// phase machines (`derive_tables`, `press_all`, `compare_all`).
//
// Self-checks: rotors I II III, reflector B, rings AAA, start AAA, no
// plugboard, pressing AAAAA must give BDZGO (the published vector); with
// plugboard pairs AW ER MT the same presses must give KGYRQ. Exit 0 only
// when both hold.
//
// Provenance: wirings and notch letters are the historical Enigma I tables;
// the stepping order is the standard double-stepping odometer. The wirings
// below decode to the published strings:
//   rotor I      "EKMFLGDQVZNTOWYHXUSPAIBRCJ"
//   rotor II     "AJDKSIRUXBLHWTMCQGZNPYFVOE"
//   rotor III    "BDFHJLCPRTXVZNYEIWGAKMUSQO"
//   reflector B  "YRUHQSLDPXNGOKMIEBFZCWVJAT"
//
// Expected exit: 0.
// Expected output contains: BDZGO

use omega_language_std::console;

data Main {
    fwd_left: [i32; 26];   // rotor I    "EKMFLGDQVZNTOWYHXUSPAIBRCJ"
    fwd_mid: [i32; 26];    // rotor II   "AJDKSIRUXBLHWTMCQGZNPYFVOE"
    fwd_right: [i32; 26];  // rotor III  "BDFHJLCPRTXVZNYEIWGAKMUSQO"
    inv_left: [i32; 26];   // derived inverse wirings
    inv_mid: [i32; 26];
    inv_right: [i32; 26];
    refl: [i32; 26];       // reflector B "YRUHQSLDPXNGOKMIEBFZCWVJAT"
    plug: [i32; 26];       // plugboard involution (identity at first)
    plain: [i32; 5];       // text being pressed, as letter values
    expect: [i32; 5];      // known ciphertext for the check
    cipher: [i32; 5];      // produced ciphertext letters
    pout: i32;             // core_perm result slot
    eout: i32;             // enc_char result slot
    pos_left: i32;         // window letters as values (always %26)
    pos_mid: i32;
    pos_right: i32;
    i: i32;                // letter counter
    x: i32;                // table-load counter
    c: i32;                // signal / scratch
    p: i32;                // packed step3 result
}

// One keypress of the stepping odometer, packed into main.p as
// (left << 10) | (mid << 5) | right. Right always advances; right at notch
// V (21) carries middle; middle at its own notch E (4) carries middle AND
// left (the double-step). A unit machine: the packed word is stored, not
// returned, so no scalar-result guarantee is demanded of it.
machine step3(main: &mut Main, l: i32, m: i32, r: i32)
    requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
{
    transition m == 4 {
        true -> s_store(main, (((l + 1) % 26) << 10) | (((m + 1) % 26) << 5) | ((r + 1) % 26))
        _ -> s_chk(main, l, m, r)
    }
    state s_chk(main: &mut Main, l: i32, m: i32, r: i32)
        requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        transition r == 21 {
            true -> s_store(main, (l << 10) | (((m + 1) % 26) << 5) | ((r + 1) % 26))
            _ -> s_store(main, (l << 10) | (m << 5) | ((r + 1) % 26))
        }
    }
    state s_store(main: &mut Main, p: i32) {
        main.p = p;
        transition { _ -> s_done(main) }
    }
    state s_done(main: &mut Main) {}
}

// The plugboard-free scrambler permutation at one wheel position: forward
// through right/middle/left, reflector, then inverse left/middle/right. It is
// a unit machine writing main.pout rather than an i32 result so that the
// lowering proof-search never treats it as a scalar-result callee. Each read
// is an unproven i32, so it crosses to the next state through a guard arm and
// arrives bounded by that state's requires. The `_` arms are unreachable:
// the stored tables only hold letter values.
machine core_perm(main: &mut Main, v: i32, l: i32, m: i32, r: i32)
    requires 0 <= v && v < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
{
    transition { _ -> pf_r(main, v, l, m, r) }

    state pf_r(main: &mut Main, v: i32, l: i32, m: i32, r: i32)
        requires 0 <= v && v < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = (v + r) % 26;
        let w: i32 = main.fwd_right[j];
        transition w >= 0 && w < 26 {
            true -> pf_m(main, w, l, m, r)
            _ -> pdone(main)
        }
    }
    state pf_m(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - r + 26) % 26 + m) % 26;
        let w2: i32 = main.fwd_mid[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pf_l(main, w2, l, m, r)
            _ -> pdone(main)
        }
    }
    state pf_l(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - m + 26) % 26 + l) % 26;
        let w2: i32 = main.fwd_left[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pf_b(main, w2, l, m, r)
            _ -> pdone(main)
        }
    }
    state pf_b(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = (w - l + 26) % 26;
        let w2: i32 = main.refl[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pb_l(main, w2, l, m, r)
            _ -> pdone(main)
        }
    }
    state pb_l(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = (w + l) % 26;
        let w2: i32 = main.inv_left[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pb_m(main, w2, l, m, r)
            _ -> pdone(main)
        }
    }
    state pb_m(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - l + 26) % 26 + m) % 26;
        let w2: i32 = main.inv_mid[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pb_r(main, w2, l, m, r)
            _ -> pdone(main)
        }
    }
    state pb_r(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - m + 26) % 26 + r) % 26;
        let w2: i32 = main.inv_right[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pstore(main, (w2 - r + 26) % 26)
            _ -> pdone(main)
        }
    }
    state pstore(main: &mut Main, t: i32) {
        main.pout = t;
        transition { _ -> pdone(main) }
    }
    state pdone(main: &mut Main) {}
}

// One keypress end to end: plugboard in, scrambler, plugboard out. Writes
// main.eout for the caller to copy into its own field.
machine enc_char(main: &mut Main, key: i32, l: i32, m: i32, r: i32)
    requires 0 <= key && key < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
{
    transition { _ -> e_pin(main, key, l, m, r) }

    state e_pin(main: &mut Main, key: i32, l: i32, m: i32, r: i32)
        requires 0 <= key && key < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let pin: i32 = main.plug[key];
        transition pin >= 0 && pin < 26 {
            true -> e_mid(main, pin, l, m, r)
            _ -> edone(main)
        }
    }
    state e_mid(main: &mut Main, pin: i32, l: i32, m: i32, r: i32)
        requires 0 <= pin && pin < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        core_perm(main, pin, l, m, r);
        let mid: i32 = main.pout;
        transition mid >= 0 && mid < 26 {
            true -> e_out(main, mid)
            _ -> edone(main)
        }
    }
    state e_out(main: &mut Main, mid: i32)
        requires 0 <= mid && mid < 26
    {
        let q: i32 = main.plug[mid];
        transition q >= 0 && q < 26 {
            true -> estore(main, q)
            _ -> edone(main)
        }
    }
    state estore(main: &mut Main, t: i32) {
        main.eout = t;
        transition { _ -> edone(main) }
    }
    state edone(main: &mut Main) {}
}

// Identity plugboard plus the derived inverse wirings, in its own machine so
// the entry's proof rosters stay short. All indexing is on plain i32 arrays;
// the guard facts ride on params with `requires`, not on field paths.
machine derive_tables(main: &mut Main) reaches Console {
    transition { _ -> dt_init(main) }

    state dt_init(main: &mut Main) {
        main.x = 0;
        transition { _ -> dt_loop(main) }
    }
    state dt_loop(main: &mut Main) {
        let x: i32 = main.x;
        transition x >= 0 && x < 26 {
            true -> dt_read(main, x)
            _ -> dt_done(main)
        }
    }
    state dt_read(main: &mut Main, x: i32)
        requires 0 <= x && x < 26
    {
        main.plug[x] = x;
        let il: i32 = main.fwd_left[x];
        let im: i32 = main.fwd_mid[x];
        let ir: i32 = main.fwd_right[x];
        transition il >= 0 && il < 26 && im >= 0 && im < 26 && ir >= 0 && ir < 26 {
            true -> dt_write(main, x, il, im, ir)
            _ -> dt_bad(main)
        }
    }
    state dt_write(main: &mut Main, x: i32, il: i32, im: i32, ir: i32)
        requires 0 <= x && x < 26 && 0 <= il && il < 26 && 0 <= im && im < 26 && 0 <= ir && ir < 26
    {
        main.inv_left[il] = x;
        main.inv_mid[im] = x;
        main.inv_right[ir] = x;
        main.x = x + 1;
        transition { _ -> dt_loop(main) }
    }
    state dt_bad(main: &mut Main) {
        Console::write_line("FAIL: an index left its guarded range (exit 4)");
        Console::exit_process(4);
    }
    state dt_done(main: &mut Main) {}
}

// Press every letter of main.plain through the stepping scrambler: step the
// rotors, run enc_char, record the cipher letter, echo it as a byte.
machine press_all(main: &mut Main) reaches Console {
    transition { _ -> pa_loop(main) }

    state pa_loop(main: &mut Main) {
        let i: i32 = main.i;
        transition i >= 0 && i < 5 {
            true -> pa_press(main, i)
            _ -> pa_done(main)
        }
    }
    state pa_press(main: &mut Main, i: i32)
        requires 0 <= i && i < 5
    {
        let k: i32 = main.plain[i];
        let l: i32 = main.pos_left;
        let m: i32 = main.pos_mid;
        let r: i32 = main.pos_right;
        transition k >= 0 && k < 26 && l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> pa_step(main, i, k, l, m, r)
            _ -> pa_bad_char(main)
        }
    }
    state pa_step(main: &mut Main, i: i32, k: i32, l: i32, m: i32, r: i32)
        requires 0 <= i && i < 5 && 0 <= k && k < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        step3(main, l, m, r);
        main.pos_left = ((main.p >> 10) & 31) % 26;
        main.pos_mid = ((main.p >> 5) & 31) % 26;
        main.pos_right = (main.p & 31) % 26;
        transition { _ -> pa_enc(main, i, k) }
    }
    state pa_enc(main: &mut Main, i: i32, k: i32)
        requires 0 <= i && i < 5 && 0 <= k && k < 26
    {
        let l: i32 = main.pos_left;
        let m: i32 = main.pos_mid;
        let r: i32 = main.pos_right;
        transition l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> pa_enc_call(main, i, k, l, m, r)
            _ -> pa_bad_index(main)
        }
    }
    state pa_enc_call(main: &mut Main, i: i32, k: i32, l: i32, m: i32, r: i32)
        requires 0 <= i && i < 5 && 0 <= k && k < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        enc_char(main, k, l, m, r);
        let c: i32 = main.eout;
        transition c >= 0 && c < 26 {
            true -> pa_emit(main, i, c)
            _ -> pa_bad_index(main)
        }
    }
    state pa_emit(main: &mut Main, i: i32, c: i32)
        requires 0 <= i && i < 5 && 0 <= c && c < 26
    {
        main.cipher[i] = c;
        Console::write_byte(c + 65);
        main.i = i + 1;
        transition { _ -> pa_loop(main) }
    }
    state pa_bad_char(main: &mut Main) {
        Console::write_line("FAIL: a pressed letter is not A-Z (exit 3)");
        Console::exit_process(3);
    }
    state pa_bad_index(main: &mut Main) {
        Console::write_line("FAIL: an index left its guarded range (exit 4)");
        Console::exit_process(4);
    }
    state pa_done(main: &mut Main) {}
}

// Compare the produced letters against the expected vector; exits 1 on any
// mismatch, otherwise returns so the caller can print its own PASS line.
machine compare_all(main: &mut Main) reaches Console {
    transition { _ -> ca_init(main) }

    state ca_init(main: &mut Main) {
        Console::write_byte(10);
        main.i = 0;
        transition { _ -> ca_loop(main) }
    }
    state ca_loop(main: &mut Main) {
        let i: i32 = main.i;
        transition i >= 0 && i < 5 {
            true -> ca_one(main, i)
            _ -> ca_done(main)
        }
    }
    state ca_one(main: &mut Main, i: i32)
        requires 0 <= i && i < 5
    {
        let c: i32 = main.cipher[i];
        let e: i32 = main.expect[i];
        transition c == e {
            true -> ca_next(main, i)
            _ -> ca_fail(main)
        }
    }
    state ca_next(main: &mut Main, i: i32)
        requires 0 <= i && i < 5
    {
        main.i = i + 1;
        transition { _ -> ca_loop(main) }
    }
    state ca_fail(main: &mut Main) {
        Console::write_line("FAIL: ciphertext differs from the expected vector (exit 1)");
        Console::exit_process(1);
    }
    state ca_done(main: &mut Main) {}
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("enigma: Enigma I, rotors I II III, reflector B, rings AAA");
    main.fwd_left = [4, 10, 12, 5, 11, 6, 3, 16, 21, 25, 13, 19, 14, 22, 24, 7, 23, 20, 18, 15, 0, 8, 1, 17, 2, 9];
    main.fwd_mid = [0, 9, 3, 10, 18, 8, 17, 20, 23, 1, 11, 7, 22, 19, 12, 2, 16, 6, 25, 13, 15, 24, 5, 21, 14, 4];
    main.fwd_right = [1, 3, 5, 7, 9, 11, 2, 15, 17, 19, 23, 21, 25, 13, 24, 4, 8, 22, 6, 0, 10, 12, 20, 18, 16, 14];
    main.refl = [24, 17, 20, 7, 16, 18, 11, 3, 15, 23, 13, 6, 14, 10, 12, 8, 4, 1, 5, 25, 2, 22, 21, 9, 0, 19];
    main.plain = [0, 0, 0, 0, 0];
    main.i = 0;
    transition { _ -> m_load(main) }

    state m_load(main: &mut Main) {
        derive_tables(main);
        transition { _ -> m_check1(main) }
    }

    // ---- check 1: start AAA, no plugboard, AAAAA -> BDZGO ----
    state m_check1(main: &mut Main) {
        main.pos_left = 0;
        main.pos_mid = 0;
        main.pos_right = 0;
        main.expect = [1, 3, 25, 6, 14];
        main.i = 0;
        Console::write_line("check 1: start AAA, no plugboard, pressing AAAAA");
        transition { _ -> m_press1(main) }
    }
    state m_press1(main: &mut Main) {
        press_all(main);
        transition { _ -> m_verdict1(main) }
    }
    state m_verdict1(main: &mut Main) {
        compare_all(main);
        Console::write_line("PASS: AAAAA -> BDZGO, no plugboard");
        transition { _ -> m_check2(main) }
    }

    // ---- check 2: start AAA, plugboard AW ER MT, AAAAA -> KGYRQ ----
    state m_check2(main: &mut Main) {
        main.pos_left = 0;
        main.pos_mid = 0;
        main.pos_right = 0;
        main.plug[0] = 22;   // A <-> W
        main.plug[22] = 0;
        main.plug[4] = 17;   // E <-> R
        main.plug[17] = 4;
        main.plug[12] = 19;  // M <-> T
        main.plug[19] = 12;
        main.expect = [10, 6, 24, 17, 16];
        main.i = 0;
        Console::write_line("check 2: start AAA, plug AW ER MT, pressing AAAAA");
        transition { _ -> m_press2(main) }
    }
    state m_press2(main: &mut Main) {
        press_all(main);
        transition { _ -> m_verdict2(main) }
    }
    state m_verdict2(main: &mut Main) {
        compare_all(main);
        Console::write_line("PASS: AAAAA -> KGYRQ with plug AW ER MT");
        Console::write_line("enigma: both self-checks pass (exit 0)");
        Console::exit_process(0);
    }
}
