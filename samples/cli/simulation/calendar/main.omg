// A month calendar -- the kind of formatted, laid-out output a real application produces.
// Renders a 30-day month that starts on a Wednesday: a weekday header, then the dates in a
// 7-column grid, the first week indented past the leading blank days. Each date is a
// space-padded two-digit field (itoa) written at column*3; when a row fills (7 columns) it
// is printed and the line cleared for the next week; the final partial week is flushed at
// the end. Builds on multiplication_table's grid/itoa output with a running weekday column
// and week wrapping. Pure compute + stdout, no new features.
// Expected exit: 0.
// Expected output contains: 30
use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 21]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    header: [u8; 21] in Utf8;
    line: [u8; 21] in Utf8;
    col: i32 in Wrapping;  // 0=Sun .. 6=Sat
    d: i32 in Wrapping;    // date 1..30
    o: i32 in Wrapping;    // col * 3
    o1: i32 in Wrapping;   // o + 1
    tens: i32 in Wrapping;
    ones: i32 in Wrapping;
    k: i32 in Wrapping;    // clear index
    tc: u8;
    oc: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("calendar: render a 30-day month starting on Wednesday as a 7-column grid");
    main.header = "Su Mo Tu We Th Fr Sa ";
    main.line = "                     ";
    main.col = 3; // the month starts on Wednesday
    main.d = 1;
    Console::write_line(main.header);
    transition { _ -> day_loop(main) }

    state day_loop(main: &mut Main) {
        transition main.d >= 1 && main.d <= 30 { true -> place(main) _ -> flush(main) }
    }
    state place(main: &mut Main) {
        main.o = main.col * 3;
        main.o1 = main.o + 1;
        main.tens = main.d / 10;
        main.ones = main.d % 10;
        main.oc = narrow_i32_to_u8_trapping((main.ones + 48) as i32);
        transition main.tens > 0 { true -> place_tens(main) _ -> place_space(main) }
    }
    state place_tens(main: &mut Main) {
        main.tc = narrow_i32_to_u8_trapping((main.tens + 48) as i32);
        transition { _ -> place_guard(main) }
    }
    state place_space(main: &mut Main) {
        main.tc = 32;
        transition { _ -> place_guard(main) }
    }
    state place_guard(main: &mut Main) {
        transition main.o >= 0 && main.o < 21 && main.o1 >= 0 && main.o1 < 21 {
            true -> place_write(main)
            _ -> bad(main)
        }
    }
    state place_write(main: &mut Main) {
        main.line[main.o] = main.tc;
        main.line[main.o1] = main.oc;
        main.col = main.col + 1;
        transition { _ -> advance(main) }
    }
    state advance(main: &mut Main) {
        transition main.col >= 7 { true -> emit_week(main) _ -> next_d(main) }
    }
    state emit_week(main: &mut Main) {
        Console::write_line(main.line);
        main.k = 0;
        transition { _ -> clear_loop(main) }
    }
    state clear_loop(main: &mut Main) {
        transition main.k >= 0 && main.k < 21 { true -> clear_cell(main) _ -> reset_col(main) }
    }
    state clear_cell(main: &mut Main) {
        main.line[main.k] = 32;
        main.k = main.k + 1;
        transition { _ -> clear_loop(main) }
    }
    state reset_col(main: &mut Main) {
        main.col = 0;
        transition { _ -> next_d(main) }
    }
    state next_d(main: &mut Main) {
        main.d = main.d + 1;
        transition { _ -> day_loop(main) }
    }

    state flush(main: &mut Main) {
        transition main.col > 0 { true -> emit_partial(main) _ -> finish(main) }
    }
    state emit_partial(main: &mut Main) {
        Console::write_line(main.line);
        transition { _ -> finish(main) }
    }
    state finish(main: &mut Main) {
        Console::write_line("done: all 30 dates laid out and flushed (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: a column offset left the 21-byte line (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
