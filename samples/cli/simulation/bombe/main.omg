// bombe: a Turing/Welchman Bombe attack on an Enigma I crib, table-driven.
// The program first encrypts the demo plaintext KEINEBESONDERENEREIGNISSE at
// start REL under plugboard AW ER MT CQ IK, producing the ciphertext
// BZOZZOGBMKFVWUVNSKFQFMJFR, then attacks the 17-letter crib
// EINEBESONDERENERE / ZOZZOGBMKFVWUVNSK (menu letters BDEFGIKMNORSUVWZ, test
// letter E, the most-connected letter on the menu).
//
// Mechanism, per the historic bombe: each crib position is one self-reciprocal
// scrambler permutation -- a menu edge between the crib letter's register and
// the cipher letter's register. For every one of the 17,576 rotor start
// positions the program builds the seventeen edge permutations from the rotor
// tables, seeds the test register (letter E) with one live wire (hypothesis
// "E steckered to A"), and propagates: a menu edge maps the live wires of one
// register through the edge permutation onto the other, and the diagonal
// board mirrors wire (l,x) to (x,l) for menu letters. At the fixed point the
// test register is checked: all 26 wires live means every hypothesis
// contradicted itself and the position is rejected; anything less is a stop.
// One seed suffices because the live wires partition into a small consistent
// component (the viable hypotheses) and one large component of mutually
// contradictory false hypotheses that floods together.
//
// At each stop the program re-propagates for every viable hypothesis (seed 0
// plus each dead test wire), reads the implied plugboard off the live wires --
// a menu letter takes its lowest live wire, a non-menu letter the unique menu
// register carrying it -- keeps the board only when it is an involution, and
// decrypts the crib segment with it. A stop is verified when the plaintext
// returns. Exit 0 only when the true position SFM verifies.
//
// Data representation: every table is a plain `[i32; N]` field holding letter
// values (A = 0 .. Z = 25) -- bounded byte-sequence fields do not admit
// runtime-indexed access in the current terminal representation, so the
// published wiring strings appear as decoded integer literals here. Proof
// discipline: a loop-head transition guard bounds a counter field for the
// whole body state beneath it (facts live through the body's writes and
// calls but not into the next state), a table read lands as an unproven i32
// so it crosses one guard arm into a `requires`-bounded parameter before it
// indexes anything, and helper machines write result fields rather than i32
// results so the lowering proof-search never treats them as scalar-result
// callees.
//
// Honest limits: rotor order is fixed to I II III -- the drum-order scan is
// not run; rings are fixed AAA; the plugboard is recovered only on menu
// letters (the C-Q pair is unrecoverable from this crib, as on a real bombe);
// the scan is sequential over positions rather than drum-parallel; at most 64
// stops are recorded for verification.
//
// Provenance: wirings and notch letters are the historical Enigma I tables;
// the stepping order is the standard double-stepping odometer. The wirings
// below decode to the published strings:
//   rotor I      "EKMFLGDQVZNTOWYHXUSPAIBRCJ"
//   rotor II     "AJDKSIRUXBLHWTMCQGZNPYFVOE"
//   rotor III    "BDFHJLCPRTXVZNYEIWGAKMUSQO"
//   reflector B  "YRUHQSLDPXNGOKMIEBFZCWVJAT"
//
// Expected exit: 0.
// Expected output contains: verified

use omega_language_std::console;

data Main {
    fwd_left: [i32; 26];   // rotor I    "EKMFLGDQVZNTOWYHXUSPAIBRCJ"
    fwd_mid: [i32; 26];    // rotor II   "AJDKSIRUXBLHWTMCQGZNPYFVOE"
    fwd_right: [i32; 26];  // rotor III  "BDFHJLCPRTXVZNYEIWGAKMUSQO"
    inv_left: [i32; 26];   // derived inverse wirings
    inv_mid: [i32; 26];
    inv_right: [i32; 26];
    refl: [i32; 26];       // reflector B "YRUHQSLDPXNGOKMIEBFZCWVJAT"
    plug: [i32; 26];       // plugboard under construction / in use
    ismenu: [i32; 26];     // 1 when the letter is on the menu
    wires: [i32; 26];      // per-register live-wire bitmasks
    ep: [i32; 17];         // menu edges: crib letter, cipher letter
    ec: [i32; 17];
    perm: [i32; 442];      // per-edge scrambler permutations (17*26)
    stops_l: [i32; 64];    // recorded stop wheel positions
    stops_m: [i32; 64];
    stops_r: [i32; 64];
    msg: [i32; 25];        // demo plaintext letters
    cexp: [i32; 25];       // expected ciphertext for the demo phase
    crib: [i32; 17];       // known plaintext segment
    cseg: [i32; 17];       // matching ciphertext segment
    cipher: [i32; 25];     // produced ciphertext letters
    pout: i32;             // core_perm result slot
    eout: i32;             // enc_char result slot
    sl: i32;               // step3 result wheels
    sm: i32;
    sr: i32;
    l: i32;      // scan odometer wheel positions
    m: i32;
    r: i32;
    cl: i32;               // stepping copy for perm building / decryption
    cm: i32;
    cr: i32;
    vl: i32;     // verify-phase position
    vm: i32;
    vr: i32;
    e: i32;      // edge / crib counter
    i: i32;      // plaintext counter
    x: i32;      // general 26-loop counter
    j: i32;      // inner 26-loop counter
    d: i32;      // bit-scan / board-inner counter
    k: i32;      // verify seed counter
    pj: i32;     // perm slot cursor
    rounds: i32; // propagation round counter
    stop_used: i32; // stops recorded
    verified: i32; // stops whose crib decrypts
    s: i32;      // recorded-stop index
    stop_count: i32; // all stops seen
    t: i32;                // element temp
    c: i32;                // signal letter / scratch
    pe: i32;               // current edge endpoints
    pc: i32;
    acc: i32;              // wire-mask accumulator temp
    b: i32;      // small sum temp
    v: i32;      // register-hit count
    pi: i32;               // perm base slot for the edge under test
    il: i32;               // inverse-build element temps
    im: i32;
    ir: i32;
    imask: i32;            // image subroutine: input wire mask
    iout: i32;             // image subroutine: output wire mask
    srow: i32;             // seed-0 test-register mask at a stop
    changed: i32;          // propagation dirty flag
    hit_sfm: i32;          // 1 once position SFM verifies
    boardbad: i32;         // 1 when the deduced board is inconsistent
}

// One keypress of the stepping odometer, result wheels written to
// main.sl/sm/sr. Right always advances; right at notch V (21) carries middle;
// middle at its own notch E (4) carries middle AND left (the double-step). A
// unit machine: the wheels are stored, not returned, so no scalar-result
// guarantee is demanded of it.
machine step3(main: &mut Main, l: i32, m: i32, r: i32)
    requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
{
    transition m == 4 {
        true -> s_dbl(main, l, m, r)
        _ -> s_chk(main, l, m, r)
    }
    state s_dbl(main: &mut Main, l: i32, m: i32, r: i32)
        requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        main.sl = (l + 1) % 26;
        main.sm = (m + 1) % 26;
        main.sr = (r + 1) % 26;
    }
    state s_chk(main: &mut Main, l: i32, m: i32, r: i32)
        requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        transition r == 21 {
            true -> s_mid(main, l, m, r)
            _ -> s_rgt(main, l, m, r)
        }
    }
    state s_mid(main: &mut Main, l: i32, m: i32, r: i32)
        requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        main.sl = l;
        main.sm = (m + 1) % 26;
        main.sr = (r + 1) % 26;
    }
    state s_rgt(main: &mut Main, l: i32, m: i32, r: i32)
        requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        main.sl = l;
        main.sm = m;
        main.sr = (r + 1) % 26;
    }
}

// The plugboard-free scrambler permutation at one wheel position: forward
// through right/middle/left, reflector, then inverse left/middle/right. A
// unit machine writing main.pout. Each table read lands as an unproven i32,
// so it crosses to the next state through a guard arm and arrives bounded by
// that state's requires; index arithmetic happens inside a state where the
// operands are requires-bounded params. The `_` arms are unreachable: the
// stored tables only hold letter values.
machine core_perm(main: &mut Main, v: i32, l: i32, m: i32, r: i32)
    requires 0 <= v && v < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
{
    transition { _ -> pf_r(main, v, l, m, r) }

    state pf_r(main: &mut Main, v: i32, l: i32, m: i32, r: i32)
        requires 0 <= v && v < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = (v + r) % 26;
        let w: i32 = main.fwd_right[j];
        transition w >= 0 && w < 26 {
            true -> pf_m(main, w, l, m, r)
            _ -> pdrop_r(main)
        }
    }
    state pf_m(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - r + 26) % 26 + m) % 26;
        let w2: i32 = main.fwd_mid[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pf_l(main, w2, l, m, r)
            _ -> pdrop_m(main)
        }
    }
    state pf_l(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - m + 26) % 26 + l) % 26;
        let w2: i32 = main.fwd_left[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pf_b(main, w2, l, m, r)
            _ -> pdrop_l(main)
        }
    }
    state pf_b(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = (w - l + 26) % 26;
        let w2: i32 = main.refl[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pb_l(main, w2, l, m, r)
            _ -> pdrop_b(main)
        }
    }
    state pb_l(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = (w + l) % 26;
        let w2: i32 = main.inv_left[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pb_m(main, w2, l, m, r)
            _ -> pdrop_il(main)
        }
    }
    state pb_m(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - l + 26) % 26 + m) % 26;
        let w2: i32 = main.inv_mid[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pb_r(main, w2, l, m, r)
            _ -> pdrop_im(main)
        }
    }
    state pb_r(main: &mut Main, w: i32, l: i32, m: i32, r: i32)
        requires 0 <= w && w < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let j: i32 = ((w - m + 26) % 26 + r) % 26;
        let w2: i32 = main.inv_right[j];
        transition w2 >= 0 && w2 < 26 {
            true -> pfin(main, w2, r)
            _ -> pdrop_ir(main)
        }
    }
    state pfin(main: &mut Main, w2: i32, r: i32)
        requires 0 <= w2 && w2 < 26 && 0 <= r && r < 26
    {
        main.pout = (w2 - r + 26) % 26;
    }
    // The guard-fail arms are unreachable -- the published tables hold only
    // letter values -- so each returns early through its own private dead end
    // rather than converging on a shared exit state.
    state pdrop_r(main: &mut Main) {}
    state pdrop_m(main: &mut Main) {}
    state pdrop_l(main: &mut Main) {}
    state pdrop_b(main: &mut Main) {}
    state pdrop_il(main: &mut Main) {}
    state pdrop_im(main: &mut Main) {}
    state pdrop_ir(main: &mut Main) {}
}

// One keypress end to end: plugboard in, scrambler, plugboard out. Writes
// main.eout for the caller to copy into its own field.
machine enc_char(main: &mut Main, key: i32, l: i32, m: i32, r: i32)
    requires 0 <= key && key < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
{
    transition { _ -> e_pin(main, key, l, m, r) }

    state e_pin(main: &mut Main, key: i32, l: i32, m: i32, r: i32)
        requires 0 <= key && key < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        let pin: i32 = main.plug[key];
        transition pin >= 0 && pin < 26 {
            true -> e_mid(main, pin, l, m, r)
            _ -> edrop_pin(main)
        }
    }
    state e_mid(main: &mut Main, pin: i32, l: i32, m: i32, r: i32)
        requires 0 <= pin && pin < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        core_perm(main, pin, l, m, r);
        let mid: i32 = main.pout;
        transition mid >= 0 && mid < 26 {
            true -> e_out(main, mid)
            _ -> edrop_mid(main)
        }
    }
    state e_out(main: &mut Main, mid: i32)
        requires 0 <= mid && mid < 26
    {
        let q: i32 = main.plug[mid];
        transition q >= 0 && q < 26 {
            true -> estore(main, q)
            _ -> edrop_out(main)
        }
    }
    state estore(main: &mut Main, t: i32) {
        main.eout = t;
    }
    state edrop_pin(main: &mut Main) {}
    state edrop_mid(main: &mut Main) {}
    state edrop_out(main: &mut Main) {}
}

// Identity plugboard, cleared menu flags, and the derived inverse wirings.
// The loop head bounds x for the body beneath it; the element reads cross
// one guard arm into it_write's bounded params.
machine init_tables(main: &mut Main) {
    main.x = 0;
    transition { _ -> it_loop(main) }

    state it_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> it_read(main)
            _ -> it_done(main)
        }
    }
    state it_read(main: &mut Main) {
        main.plug[main.x] = main.x;
        main.ismenu[main.x] = 0;
        main.il = main.fwd_left[main.x];
        main.im = main.fwd_mid[main.x];
        main.ir = main.fwd_right[main.x];
        transition main.il >= 0 && main.il < 26
                && main.im >= 0 && main.im < 26
                && main.ir >= 0 && main.ir < 26 && main.x >= 0 && main.x < 26 {
            true -> it_write(main)
            _ -> it_bad(main)
        }
    }
    state it_write(main: &mut Main) {
        main.inv_left[main.il] = main.x;
        main.inv_mid[main.im] = main.x;
        main.inv_right[main.ir] = main.x;
        main.x = main.x + 1;
        transition { _ -> it_loop(main) }
    }
    state it_done(main: &mut Main) {}
    // Unreachable: the published rotor tables hold only letter values.
    state it_bad(main: &mut Main) {}
}

// Menu edges and letter flags from the crib/cipher segment: edge e connects
// crib[e]'s register to cseg[e]'s register.
machine build_edges(main: &mut Main) {
    main.e = 0;
    transition { _ -> be_loop(main) }

    state be_loop(main: &mut Main) {
        transition main.e >= 0 && main.e < 17 {
            true -> be_read(main)
            _ -> be_done(main)
        }
    }
    state be_read(main: &mut Main) {
        main.pe = main.crib[main.e];
        main.pc = main.cseg[main.e];
        transition main.pe >= 0 && main.pe < 26 && main.pc >= 0 && main.pc < 26 && main.e >= 0 && main.e < 17 {
            true -> be_store(main)
            _ -> be_bad(main)
        }
    }
    state be_store(main: &mut Main) {
        main.ep[main.e] = main.pe;
        main.ec[main.e] = main.pc;
        main.ismenu[main.pe] = 1;
        main.ismenu[main.pc] = 1;
        main.e = main.e + 1;
        transition { _ -> be_loop(main) }
    }
    state be_done(main: &mut Main) {}
    // Unreachable: crib and cipher segment tables hold only letter values.
    state be_bad(main: &mut Main) {}
}

// Demo phase: encrypt the plaintext at REL under AW ER MT CQ IK and check it
// against the known ciphertext.
machine demo_press(main: &mut Main) reaches Console {
    main.plug[0] = 22;   // A <-> W
    main.plug[22] = 0;
    main.plug[4] = 17;   // E <-> R
    main.plug[17] = 4;
    main.plug[12] = 19;  // M <-> T
    main.plug[19] = 12;
    main.plug[2] = 16;   // C <-> Q
    main.plug[16] = 2;
    main.plug[8] = 10;   // I <-> K
    main.plug[10] = 8;
    main.l = 17;         // start REL
    main.m = 4;
    main.r = 11;
    main.i = 0;
    Console::write_line("demo: KEINEBESONDERENEREIGNISSE at REL, plug AW ER MT CQ IK");
    transition { _ -> dp_letter(main) }

    state dp_letter(main: &mut Main) {
        transition main.i >= 0 && main.i < 25 {
            true -> dp_press(main)
            _ -> dp_cmp_init(main)
        }
    }
    state dp_press(main: &mut Main) {
        main.c = main.msg[main.i];
        let c: i32 = main.c;
        let l: i32 = main.l;
        let m: i32 = main.m;
        let r: i32 = main.r;
        transition c >= 0 && c < 26 && l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> dp_call(main, c, l, m, r)
            _ -> dp_bad(main)
        }
    }
    state dp_call(main: &mut Main, c: i32, l: i32, m: i32, r: i32)
        requires 0 <= c && c < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        step3(main, l, m, r);
        transition { _ -> dp_enc(main, c) }
    }
    state dp_enc(main: &mut Main, c: i32)
        requires 0 <= c && c < 26
    {
        let l: i32 = main.sl;
        let m: i32 = main.sm;
        let r: i32 = main.sr;
        main.l = l;
        main.m = m;
        main.r = r;
        transition l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> dp_enc2(main, c, l, m, r)
            _ -> dp_bad2(main)
        }
    }
    state dp_enc2(main: &mut Main, c: i32, l: i32, m: i32, r: i32)
        requires 0 <= c && c < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        enc_char(main, c, l, m, r);
        transition { _ -> dp_emit(main) }
    }
    state dp_emit(main: &mut Main) {
        transition main.eout >= 0 && main.eout < 26 && main.i >= 0 && main.i < 25 {
            true -> dp_emit_go(main)
            _ -> dp_bad3(main)
        }
    }
    state dp_emit_go(main: &mut Main) {
        main.cipher[main.i] = main.eout;
        Console::write_byte(main.eout + 65);
        main.i = main.i + 1;
        transition { _ -> dp_letter(main) }
    }
    state dp_cmp_init(main: &mut Main) {
        Console::write_byte(10);
    }
    // Unreachable guard fails -- the demo tables hold only letter values.
    // Each exits through its own state so no merge join forms.
    state dp_bad(main: &mut Main) {
        Console::write_line("FAIL: an index left its guarded range (exit 4)");
        Console::exit_process(4);
    }
    state dp_bad2(main: &mut Main) {
        Console::write_line("FAIL: an index left its guarded range (exit 4)");
        Console::exit_process(4);
    }
    state dp_bad3(main: &mut Main) {
        Console::write_line("FAIL: an index left its guarded range (exit 4)");
        Console::exit_process(4);
    }
}

// Compare the produced ciphertext against the expected vector.
machine check_demo(main: &mut Main) reaches Console {
    main.i = 0;
    transition { _ -> dp_cmp(main) }

    state dp_cmp(main: &mut Main) {
        transition main.i >= 0 && main.i < 25 {
            true -> dp_cmp_one(main)
            _ -> dp_done(main)
        }
    }
    state dp_cmp_one(main: &mut Main) {
        transition main.cipher[main.i] == main.cexp[main.i] && main.i >= 0 {
            true -> dp_cmp_next(main)
            _ -> dp_fail(main)
        }
    }
    state dp_cmp_next(main: &mut Main) {
        main.i = main.i + 1;
        transition { _ -> dp_cmp(main) }
    }
    state dp_fail(main: &mut Main) {
        Console::write_line("FAIL: ciphertext differs from the expected vector (exit 1)");
        Console::exit_process(1);
    }
    state dp_done(main: &mut Main) {}
}

// Build all seventeen edge permutations at the position in cl/cm/cr: for each
// menu edge e and each input wire x, perm[e*26+x] is the scrambler image at
// the position the drummed rotor has stepped to for that crib letter. The
// caller seeds cl/cm/cr from the position under test; this machine steps its
// own copy so the scan odometer itself is untouched. The slot cursor pj walks
// 0..441 alongside x so the perm index is a bare bounded field.
machine perm_build(main: &mut Main) {
    main.e = 0;
    main.pj = 0;
    transition { _ -> pb_step(main) }

    state pb_step(main: &mut Main) {
        let l: i32 = main.cl;
        let m: i32 = main.cm;
        let r: i32 = main.cr;
        transition l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> pb_sgo(main, l, m, r)
            _ -> pb_drop_l(main)
        }
    }
    state pb_sgo(main: &mut Main, l: i32, m: i32, r: i32)
        requires 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        step3(main, l, m, r);
        main.cl = main.sl;
        main.cm = main.sm;
        main.cr = main.sr;
        main.x = 0;
        transition { _ -> pb_fill(main) }
    }
    state pb_fill(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> pb_perm(main)
            _ -> pb_next(main)
        }
    }
    state pb_perm(main: &mut Main) {
        let v: i32 = main.x;
        let l: i32 = main.cl;
        let m: i32 = main.cm;
        let r: i32 = main.cr;
        transition v >= 0 && v < 26 && l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> pb_call(main, v, l, m, r)
            _ -> pb_drop_v(main)
        }
    }
    state pb_call(main: &mut Main, v: i32, l: i32, m: i32, r: i32)
        requires 0 <= v && v < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        core_perm(main, v, l, m, r);
        transition { _ -> pb_store(main) }
    }
    state pb_store(main: &mut Main) {
        transition main.pout >= 0 && main.pout < 26 && main.pj >= 0 && main.pj < 442 && main.x >= 0 && main.x < 26 {
            true -> pb_wr(main)
            _ -> pb_drop_w(main)
        }
    }
    state pb_wr(main: &mut Main) {
        main.perm[main.pj] = main.pout;
        main.pj = main.pj + 1;
        main.x = main.x + 1;
        transition { _ -> pb_fill(main) }
    }
    state pb_next(main: &mut Main) {
        transition main.e >= 0 && main.e < 17 {
            true -> pb_einc(main)
            _ -> pb_done(main)
        }
    }
    state pb_einc(main: &mut Main) {
        main.e = main.e + 1;
        transition main.e >= 0 && main.e < 17 {
            true -> pb_step(main)
            _ -> pb_done2(main)
        }
    }
    state pb_done(main: &mut Main) {}
    state pb_done2(main: &mut Main) {}
    // Unreachable: wheel positions and permutations stay within letter range.
    state pb_drop_v(main: &mut Main) {}
    state pb_drop_w(main: &mut Main) {}
    state pb_drop_l(main: &mut Main) {}
}

// Image of the live-wire mask in main.imask through the edge permutation
// based at main.pi (e*26 for the edge under test), accumulated into
// main.iout: for every wire x whose bit is set in imask, the bit perm[pi+x]
// is set in iout.
machine image(main: &mut Main) {
    main.x = 0;
    main.iout = 0;
    main.pj = main.pi;
    transition { _ -> ig_loop(main) }

    state ig_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 && main.pj >= 0 && main.pj < 442 {
            true -> ig_read(main)
            _ -> ig_done(main)
        }
    }
    state ig_read(main: &mut Main) {
        main.t = main.perm[main.pj];
        transition main.t >= 0 && main.t < 26 && ((main.imask >> (main.x & 31)) & 1) == 1 {
            true -> ig_set(main)
            _ -> ig_next(main)
        }
    }
    state ig_set(main: &mut Main) {
        main.iout = main.iout | (1i32 << main.t);
        transition { _ -> ig_next2(main) }
    }
    state ig_next(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 && main.pj >= 0 && main.pj < 442 {
            true -> ig_inc(main)
            _ -> ig_done3(main)
        }
    }
    state ig_next2(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 && main.pj >= 0 && main.pj < 442 {
            true -> ig_inc2(main)
            _ -> ig_done2(main)
        }
    }
    state ig_inc(main: &mut Main) {
        main.x = main.x + 1;
        main.pj = main.pj + 1;
        transition { _ -> ig_loop(main) }
    }
    state ig_inc2(main: &mut Main) {
        main.x = main.x + 1;
        main.pj = main.pj + 1;
        transition { _ -> ig_loop(main) }
    }
    state ig_done(main: &mut Main) {}
    state ig_done2(main: &mut Main) {}
    state ig_done3(main: &mut Main) {}
}

// Fixed-point propagation of the live-wire masks in main.wires over the menu
// edges plus the diagonal board, bounded at 64 rounds. The caller clears the
// registers and plants the seed before calling; the masks are read back from
// main.wires afterwards. The union of the image is written unconditionally
// (it can only grow the mask); the xor against the pre-union value feeds the
// changed flag.
machine propagate(main: &mut Main) {
    transition { _ -> pr_round(main) }

    state pr_round(main: &mut Main) {
        main.changed = 0;
        main.e = 0;
        transition { _ -> pr_edge(main) }
    }
    state pr_edge(main: &mut Main) {
        transition main.e >= 0 && main.e < 17 {
            true -> pr_read(main)
            _ -> pr_board(main)
        }
    }
    state pr_read(main: &mut Main) {
        main.pe = main.ep[main.e];
        main.pc = main.ec[main.e];
        main.pi = main.e * 26;
        transition main.pe >= 0 && main.pe < 26 && main.pc >= 0 && main.pc < 26 {
            true -> pr_fwd(main)
            _ -> pr_drop1(main)
        }
    }
    state pr_fwd(main: &mut Main) {
        main.imask = main.wires[main.pe];
        image(main);
        transition { _ -> pr_fcmp(main) }
    }
    state pr_fcmp(main: &mut Main) {
        transition main.pc >= 0 && main.pc < 26 {
            true -> pr_fwr(main)
            _ -> pr_drop2(main)
        }
    }
    state pr_fwr(main: &mut Main) {
        main.acc = main.wires[main.pc];
        main.wires[main.pc] = main.acc | main.iout;
        main.changed = main.changed | (main.acc ^ main.wires[main.pc]);
        main.imask = main.wires[main.pc];
        image(main);
        transition { _ -> pr_bcmp(main) }
    }
    state pr_bcmp(main: &mut Main) {
        transition main.pe >= 0 && main.pe < 26 && main.e >= 0 && main.e < 17 {
            true -> pr_bwr(main)
            _ -> pr_drop3(main)
        }
    }
    state pr_bwr(main: &mut Main) {
        main.acc = main.wires[main.pe];
        main.wires[main.pe] = main.acc | main.iout;
        main.changed = main.changed | (main.acc ^ main.wires[main.pe]);
        main.e = main.e + 1;
        transition { _ -> pr_edge(main) }
    }

    state pr_board(main: &mut Main) {
        board_mirror(main);
        transition { _ -> pr_check(main) }
    }
    state pr_check(main: &mut Main) {
        transition main.changed == 0 || main.rounds >= 64 {
            true -> pr_done(main)
            _ -> pr_next(main)
        }
    }
    state pr_next(main: &mut Main) {
        transition main.rounds >= 0 && main.rounds < 64 {
            true -> pr_rinc(main)
            _ -> pr_drop4(main)
        }
    }
    state pr_rinc(main: &mut Main) {
        main.rounds = main.rounds + 1;
        transition { _ -> pr_round(main) }
    }
    state pr_done(main: &mut Main) {}
    // Unreachable guard fails: menu tables hold letter values, and pr_next
    // is only reached while rounds < 64.
    state pr_drop1(main: &mut Main) {}
    state pr_drop2(main: &mut Main) {}
    state pr_drop3(main: &mut Main) {}
    state pr_drop4(main: &mut Main) {}
}

// Clear the wire registers.
// The diagonal board half of one propagation round: wire (letter, wire-bit)
// mirrors to (wire-bit, letter) when both letters are on the menu. Runs to the
// same fixed point as the edge pass; caller's changed flag accumulates.
machine board_mirror(main: &mut Main) {
    main.j = 0;
    transition { _ -> bx_loop(main) }

    state bx_loop(main: &mut Main) {
        transition main.j >= 0 && main.j < 26 {
            true -> bx_iinit(main)
            _ -> bm_done4(main)
        }
    }
    state bx_iinit(main: &mut Main) {
        main.d = 0;
        transition { _ -> bx_inner(main) }
    }
    state bx_inner(main: &mut Main) {
        transition main.d >= 0 && main.d < 26 && main.j >= 0 && main.j < 26 {
            true -> bx_chk(main)
            _ -> bx_jnxt3(main)
        }
    }
    state bx_chk(main: &mut Main) {
        transition main.ismenu[main.d] == 1 && main.ismenu[main.j] == 1
                && ((main.wires[main.d] >> (main.j & 31)) & 1) == 1
                && main.j >= 0 && main.j < 26 && main.d >= 0 && main.d < 32 {
            true -> bx_set(main)
            _ -> bx_next(main)
        }
    }
    state bx_set(main: &mut Main) {
        main.acc = main.wires[main.j];
        main.wires[main.j] = main.acc | (1i32 << main.d);
        main.changed = main.changed | (main.acc ^ main.wires[main.j]);
        transition { _ -> bx_next2(main) }
    }
    state bx_next(main: &mut Main) {
        transition main.d >= 0 && main.d < 26 {
            true -> bx_dinc(main)
            _ -> bx_jnxt(main)
        }
    }
    state bx_next2(main: &mut Main) {
        transition main.d >= 0 && main.d < 26 {
            true -> bx_dinc2(main)
            _ -> bx_jnxt2(main)
        }
    }
    state bx_dinc(main: &mut Main) {
        main.d = main.d + 1;
        transition { _ -> bx_inner(main) }
    }
    state bx_dinc2(main: &mut Main) {
        main.d = main.d + 1;
        transition { _ -> bx_inner(main) }
    }
    state bx_jnxt(main: &mut Main) {
        transition main.j >= 0 && main.j < 26 {
            true -> bx_jinc(main)
            _ -> bm_done(main)
        }
    }
    state bx_jnxt2(main: &mut Main) {
        transition main.j >= 0 && main.j < 26 {
            true -> bx_jinc2(main)
            _ -> bm_done2(main)
        }
    }
    state bx_jnxt3(main: &mut Main) {
        transition main.j >= 0 && main.j < 26 {
            true -> bx_jinc3(main)
            _ -> bm_done3(main)
        }
    }
    state bx_jinc(main: &mut Main) {
        main.j = main.j + 1;
        transition { _ -> bx_loop(main) }
    }
    state bx_jinc2(main: &mut Main) {
        main.j = main.j + 1;
        transition { _ -> bx_loop(main) }
    }
    state bx_jinc3(main: &mut Main) {
        main.j = main.j + 1;
        transition { _ -> bx_loop(main) }
    }
    state bm_done(main: &mut Main) {}
    state bm_done2(main: &mut Main) {}
    state bm_done3(main: &mut Main) {}
    state bm_done4(main: &mut Main) {}
}

// Clear the wire registers.
machine clear_wires(main: &mut Main) {
    main.x = 0;
    transition { _ -> cw_loop(main) }

    state cw_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> cw_clr(main)
            _ -> cw_done(main)
        }
    }
    state cw_clr(main: &mut Main) {
        main.wires[main.x] = 0;
        main.x = main.x + 1;
        transition { _ -> cw_loop(main) }
    }
    state cw_done(main: &mut Main) {}
}

// The scan: every one of the 17,576 start positions gets its permutations
// built, a seeded propagation, and the test-register verdict. Stops are
// printed and the first 64 recorded. The odometer advances r, carrying into
// m and l on wrap; when l would leave 25 the scan is done -- 25,25,25 is the
// last position processed.
machine scan(main: &mut Main) reaches Console {
    main.l = 0;
    main.m = 0;
    main.r = 0;
    main.stop_count = 0;
    main.stop_used = 0;
    Console::write_line("scan: 17576 positions, test letter E, seed E->A");
    transition { _ -> sc_pos(main) }

    state sc_pos(main: &mut Main) {
        main.cl = main.l;
        main.cm = main.m;
        main.cr = main.r;
        perm_build(main);
        clear_wires(main);
        main.wires[4] = 1;              // test letter E, hypothesis wire A
        main.rounds = 0;
        propagate(main);
        transition { _ -> sc_verdict(main) }
    }
    state sc_verdict(main: &mut Main) {
        transition main.wires[4] == 67108863 {
            true -> sc_next(main)
            _ -> sc_stop(main)
        }
    }
    state sc_stop(main: &mut Main) {
        transition main.stop_count >= 0 && main.stop_count < 20000 {
            true -> sc_ct(main)
            _ -> sc_next(main)
        }
    }
    state sc_ct(main: &mut Main) {
        main.stop_count = main.stop_count + 1;
        transition main.stop_used >= 0 && main.stop_used < 64 {
            true -> sc_store(main)
            _ -> sc_print(main)
        }
    }
    state sc_store(main: &mut Main) {
        main.stops_l[main.stop_used] = main.l;
        main.stops_m[main.stop_used] = main.m;
        main.stops_r[main.stop_used] = main.r;
        main.stop_used = main.stop_used + 1;
        transition { _ -> sc_print2(main) }
    }
    state sc_print(main: &mut Main) {
        transition main.l >= 0 && main.l < 26 && main.m >= 0 && main.m < 26 && main.r >= 0 && main.r < 26 {
            true -> sc_prt(main)
            _ -> sc_next(main)
        }
    }
    state sc_print2(main: &mut Main) {
        transition main.l >= 0 && main.l < 26 && main.m >= 0 && main.m < 26 && main.r >= 0 && main.r < 26 {
            true -> sc_prt2(main)
            _ -> sc_next(main)
        }
    }
    state sc_prt(main: &mut Main) {
        Console::write_line("stop:");
        Console::write_byte(main.l + 65);
        Console::write_byte(main.m + 65);
        Console::write_byte(main.r + 65);
        Console::write_byte(10);
        transition { _ -> sc_next(main) }
    }
    state sc_prt2(main: &mut Main) {
        Console::write_line("stop:");
        Console::write_byte(main.l + 65);
        Console::write_byte(main.m + 65);
        Console::write_byte(main.r + 65);
        Console::write_byte(10);
        transition { _ -> sc_next(main) }
    }
    state sc_next(main: &mut Main) {
        transition main.r >= 0 && main.r < 25 {
            true -> sc_inc_r(main)
            _ -> sc_carry_m(main)
        }
    }
    state sc_inc_r(main: &mut Main) {
        main.r = main.r + 1;
        transition { _ -> sc_pos(main) }
    }
    state sc_carry_m(main: &mut Main) {
        main.r = 0;
        transition main.m >= 0 && main.m < 25 {
            true -> sc_inc_m(main)
            _ -> sc_carry_l(main)
        }
    }
    state sc_inc_m(main: &mut Main) {
        main.m = main.m + 1;
        transition { _ -> sc_pos(main) }
    }
    state sc_carry_l(main: &mut Main) {
        main.m = 0;
        transition main.l >= 0 && main.l < 25 {
            true -> sc_inc_l(main)
            _ -> sc_done(main)
        }
    }
    state sc_inc_l(main: &mut Main) {
        main.l = main.l + 1;
        transition { _ -> sc_pos(main) }
    }
    state sc_done(main: &mut Main) {
        Console::write_line("scan complete; verifying recorded stops");
    }
}

// Plugboard deduction at one propagated hypothesis: a menu letter takes its
// lowest live wire; a non-menu letter takes the unique menu register
// carrying it (or itself when none does). Sets main.boardbad when the
// non-menu wire count would not form a single partner.
machine deduce_board(main: &mut Main) {
    main.x = 0;
    main.boardbad = 0;
    transition { _ -> pl_loop(main) }

    state pl_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> pl_class(main)
            _ -> pl_done(main)
        }
    }
    state pl_class(main: &mut Main) {
        transition main.ismenu[main.x] == 1 {
            true -> pl_menu(main)
            _ -> pl_nm_init(main)
        }
    }
    state pl_menu(main: &mut Main) {
        main.d = 0;
        transition { _ -> pl_lowbit(main) }
    }
    state pl_lowbit(main: &mut Main) {
        transition main.d >= 0 && main.d < 26 && main.x >= 0 && main.x < 26 {
            true -> pl_bit(main)
            _ -> pl_self(main)
        }
    }
    state pl_bit(main: &mut Main) {
        transition ((main.wires[main.x] >> (main.d & 31)) & 1) == 1 && main.x >= 0 && main.x < 26 {
            true -> pl_set(main)
            _ -> pl_lownext(main)
        }
    }
    state pl_lownext(main: &mut Main) {
        transition main.d >= 0 && main.d < 26 {
            true -> pl_dinc(main)
            _ -> pl_self2(main)
        }
    }
    state pl_dinc(main: &mut Main) {
        main.d = main.d + 1;
        transition { _ -> pl_lowbit(main) }
    }
    state pl_set(main: &mut Main) {
        main.plug[main.x] = main.d;
        main.x = main.x + 1;
        transition { _ -> pl_loop(main) }
    }
    state pl_self(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> pl_selfwr(main)
            _ -> pl_dead(main)
        }
    }
    state pl_selfwr(main: &mut Main) {
        main.plug[main.x] = main.x;
        main.x = main.x + 1;
        transition { _ -> pl_loop(main) }
    }
    state pl_self2(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> pl_selfwr2(main)
            _ -> pl_dead2(main)
        }
    }
    state pl_selfwr2(main: &mut Main) {
        main.plug[main.x] = main.x;
        main.x = main.x + 1;
        transition { _ -> pl_loop(main) }
    }
    state pl_nm_init(main: &mut Main) {
        main.j = 0;
        main.v = 0;
        main.b = 0;
        let x: i32 = main.x;
        transition x >= 0 && x < 26 {
            true -> pl_nm_call(main, x)
            _ -> pl_dead3(main)
        }
    }
    state pl_nm_call(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        nonmenu_wire(main, letter);
        transition { _ -> pl_nm_done(main) }
    }
    state pl_nm_done(main: &mut Main) {
        transition main.v == 0 {
            true -> pl_self3(main)
            _ -> pl_nm_set(main)
        }
    }
    state pl_self3(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> pl_selfwr3(main)
            _ -> pl_dead4(main)
        }
    }
    state pl_selfwr3(main: &mut Main) {
        main.plug[main.x] = main.x;
        main.x = main.x + 1;
        transition { _ -> pl_loop(main) }
    }
    state pl_nm_set(main: &mut Main) {
        transition main.b >= 0 && main.b < 26 && main.x >= 0 && main.x < 26 {
            true -> pl_nm_go(main)
            _ -> pl_nm_bad(main)
        }
    }
    state pl_nm_go(main: &mut Main) {
        main.plug[main.x] = main.b;
        main.x = main.x + 1;
        transition { _ -> pl_loop(main) }
    }
    state pl_nm_bad(main: &mut Main) {
        main.boardbad = 1;
        transition main.x >= 0 && main.x < 26 {
            true -> pl_binc(main)
            _ -> pl_dead5(main)
        }
    }
    state pl_binc(main: &mut Main) {
        main.x = main.x + 1;
        transition { _ -> pl_loop(main) }
    }
    state pl_done(main: &mut Main) {}
    // Unreachable counter-overflow arms.
    state pl_dead(main: &mut Main) {}
    state pl_dead2(main: &mut Main) {}
    state pl_dead3(main: &mut Main) {}
    state pl_dead4(main: &mut Main) {}
    state pl_dead5(main: &mut Main) {}
}

// One non-menu letter's partner search: count the menu registers carrying a
// live wire to it. `letter` arrives requires-bounded for the bit test; the
// hit count and register sum land in main.v/main.b for the caller.
machine nonmenu_wire(main: &mut Main, letter: i32)
    requires 0 <= letter && letter < 26
{
    transition { _ -> pl_nm_loop(main, letter) }

    state pl_nm_loop(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        transition main.j >= 0 && main.j < 26 {
            true -> pl_nm_bit(main, letter)
            _ -> pl_nm_end(main)
        }
    }
    state pl_nm_bit(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        transition main.ismenu[main.j] == 1 && ((main.wires[main.j] >> (letter & 31)) & 1) == 1
                && main.v >= 0 && main.v < 128 && main.b >= 0 && main.b < 1000000 {
            true -> pl_nm_hit(main, letter)
            _ -> pl_nm_next(main, letter)
        }
    }
    state pl_nm_hit(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        main.v = main.v + 1;
        main.b = main.b + main.j;
        transition { _ -> pl_nm_next2(main, letter) }
    }
    state pl_nm_next(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        transition main.j >= 0 && main.j < 26 {
            true -> pl_nm_ji(main, letter)
            _ -> pl_nm_end2(main)
        }
    }
    state pl_nm_next2(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        transition main.j >= 0 && main.j < 26 {
            true -> pl_nm_ji2(main, letter)
            _ -> pl_nm_end3(main)
        }
    }
    state pl_nm_ji(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        main.j = main.j + 1;
        transition { _ -> pl_nm_loop(main, letter) }
    }
    state pl_nm_ji2(main: &mut Main, letter: i32)
        requires 0 <= letter && letter < 26
    {
        main.j = main.j + 1;
        transition { _ -> pl_nm_loop(main, letter) }
    }
    state pl_nm_end(main: &mut Main) {}
    state pl_nm_end2(main: &mut Main) {}
    state pl_nm_end3(main: &mut Main) {}
}

// Decrypt the 17-letter cipher segment with the deduced board at the stop
// position vl/vm/vr. Sets main.acc to 1 when the plaintext returns, else 0.
machine dec_crib(main: &mut Main) {
    main.cl = main.vl;
    main.cm = main.vm;
    main.cr = main.vr;
    main.e = 0;
    main.acc = 0;
    transition { _ -> dc_loop(main) }

    state dc_loop(main: &mut Main) {
        transition main.e >= 0 && main.e < 17 {
            true -> dc_read(main)
            _ -> dc_hit(main)
        }
    }
    state dc_read(main: &mut Main) {
        main.c = main.cseg[main.e];
        main.b = main.crib[main.e];
        let c: i32 = main.c;
        let l: i32 = main.cl;
        let m: i32 = main.cm;
        let r: i32 = main.cr;
        transition c >= 0 && c < 26 && l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> dc_call(main, c, l, m, r)
            _ -> dc_dead(main)
        }
    }
    state dc_call(main: &mut Main, c: i32, l: i32, m: i32, r: i32)
        requires 0 <= c && c < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        step3(main, l, m, r);
        transition { _ -> dc_enc(main, c) }
    }
    state dc_enc(main: &mut Main, c: i32)
        requires 0 <= c && c < 26
    {
        let l: i32 = main.sl;
        let m: i32 = main.sm;
        let r: i32 = main.sr;
        main.cl = l;
        main.cm = m;
        main.cr = r;
        transition l >= 0 && l < 26 && m >= 0 && m < 26 && r >= 0 && r < 26 {
            true -> dc_enc2(main, c, l, m, r)
            _ -> dc_dead2(main)
        }
    }
    state dc_enc2(main: &mut Main, c: i32, l: i32, m: i32, r: i32)
        requires 0 <= c && c < 26 && 0 <= l && l < 26 && 0 <= m && m < 26 && 0 <= r && r < 26
    {
        enc_char(main, c, l, m, r);
        transition { _ -> dc_cmp(main) }
    }
    state dc_cmp(main: &mut Main) {
        transition main.eout == main.b && main.e >= 0 && main.e < 17 {
            true -> dc_next(main)
            _ -> dc_miss(main)
        }
    }
    state dc_next(main: &mut Main) {
        main.e = main.e + 1;
        transition { _ -> dc_loop(main) }
    }
    state dc_hit(main: &mut Main) {
        main.acc = 1;
    }
    // Unreachable: segment tables and wheel positions stay in letter range;
    // dc_miss is the ordinary mismatch exit.
    state dc_dead(main: &mut Main) {}
    state dc_dead2(main: &mut Main) {}
    state dc_miss(main: &mut Main) {}
}

// The deduced plugboard is usable only as an involution over 0..25; every
// letter's partner must be in range and map back. Failure sets boardbad.
machine involution(main: &mut Main) {
    transition { _ -> vr_chk_loop(main) }

    state vr_chk_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 26 {
            true -> vr_chk_a(main)
            _ -> vr_chk_ok(main)
        }
    }
    state vr_chk_a(main: &mut Main) {
        main.t = main.plug[main.x];
        transition main.t >= 0 && main.t < 26 {
            true -> vr_chk_b(main)
            _ -> vr_chk_bad(main)
        }
    }
    state vr_chk_b(main: &mut Main) {
        transition main.plug[main.t] == main.x && main.x < 26 {
            true -> vr_chk_next(main)
            _ -> vr_chk_bad2(main)
        }
    }
    state vr_chk_next(main: &mut Main) {
        main.x = main.x + 1;
        transition { _ -> vr_chk_loop(main) }
    }
    state vr_chk_bad(main: &mut Main) {
        main.boardbad = 1;
    }
    state vr_chk_bad2(main: &mut Main) {
        main.boardbad = 1;
    }
    state vr_chk_ok(main: &mut Main) {}
}

// Verify each recorded stop: walk the stop list and ask verify_stop to test
// every viable hypothesis at that position. verified counts the stops whose
// crib decrypts correctly.
machine verify(main: &mut Main) {
    main.s = 0;
    main.verified = 0;
    main.hit_sfm = 0;
    transition { _ -> vr_loop(main) }

    state vr_loop(main: &mut Main) {
        transition main.s >= 0 && main.s < 64 && main.s < main.stop_used {
            true -> vr_unpack(main)
            _ -> vr_done(main)
        }
    }
    state vr_unpack(main: &mut Main) {
        main.vl = main.stops_l[main.s];
        main.vm = main.stops_m[main.s];
        main.vr = main.stops_r[main.s];
        verify_stop(main);
        transition { _ -> vr_next_stop(main) }
    }
    state vr_next_stop(main: &mut Main) {
        transition main.s >= 0 && main.s < 64 {
            true -> vr_sinc(main)
            _ -> vr_done2(main)
        }
    }
    state vr_sinc(main: &mut Main) {
        main.s = main.s + 1;
        transition { _ -> vr_loop(main) }
    }
    state vr_done(main: &mut Main) {}
    // Unreachable: s < 64 is already established at the loop head.
    state vr_done2(main: &mut Main) {}
}

// One stop position: rebuild its permutations, record the seed-0 test row,
// then try every hypothesis that seed left viable (seed 0 itself plus each
// dead wire).
machine verify_stop(main: &mut Main) {
    main.cl = main.vl;
    main.cm = main.vm;
    main.cr = main.vr;
    perm_build(main);
    main.k = 0;
    transition { _ -> vr_dead(main) }

    state vr_dead(main: &mut Main) {
        transition main.k >= 0 && main.k < 26 {
            true -> vr_gate(main)
            _ -> vr_done(main)
        }
    }
    state vr_gate(main: &mut Main) {
        transition main.k == 0 || ((main.srow >> (main.k & 31)) & 1) == 0 {
            true -> vr_prop_call(main)
            _ -> vr_next(main)
        }
    }
    state vr_prop_call(main: &mut Main) {
        try_hypothesis(main);
        transition main.k == 0 {
            true -> vr_srow(main)
            _ -> vr_next2(main)
        }
    }
    state vr_srow(main: &mut Main) {
        main.srow = main.wires[4];
        transition { _ -> vr_next3(main) }
    }
    state vr_next(main: &mut Main) {
        transition main.k >= 0 && main.k < 26 {
            true -> vr_kinc(main)
            _ -> vr_done2(main)
        }
    }
    state vr_next2(main: &mut Main) {
        transition main.k >= 0 && main.k < 26 {
            true -> vr_kinc2(main)
            _ -> vr_done3(main)
        }
    }
    state vr_next3(main: &mut Main) {
        transition main.k >= 0 && main.k < 26 {
            true -> vr_kinc3(main)
            _ -> vr_done4(main)
        }
    }
    state vr_kinc3(main: &mut Main) {
        main.k = main.k + 1;
        transition { _ -> vr_dead(main) }
    }
    state vr_kinc(main: &mut Main) {
        main.k = main.k + 1;
        transition { _ -> vr_dead(main) }
    }
    state vr_kinc2(main: &mut Main) {
        main.k = main.k + 1;
        transition { _ -> vr_dead(main) }
    }
    state vr_done(main: &mut Main) {}
    state vr_done2(main: &mut Main) {}
    state vr_done3(main: &mut Main) {}
    state vr_done4(main: &mut Main) {}
}

// One hypothesis at the current stop: seed the test wire, propagate, and on
// a non-flooded register deduce the board and decrypt the crib. The caller
// records the seed-0 test row (main.srow) itself when k == 0.
machine try_hypothesis(main: &mut Main)
    reaches Console
{
    transition { _ -> th_prop(main) }

    state th_prop(main: &mut Main) {
        clear_wires(main);
        main.rounds = 0;
        transition main.k >= 0 && main.k < 26 {
            true -> th_seed(main)
            _ -> th_drop0(main)
        }
    }
    state th_seed(main: &mut Main) {
        main.wires[4] = 1i32 << main.k;
        propagate(main);
        transition { _ -> th_full(main) }
    }
    state th_full(main: &mut Main) {
        transition main.wires[4] == 67108863 {
            true -> th_drop1(main)
            _ -> th_board(main)
        }
    }
    state th_board(main: &mut Main) {
        deduce_board(main);
        transition main.boardbad == 1 {
            true -> th_drop2(main)
            _ -> th_inv(main)
        }
    }
    state th_inv(main: &mut Main) {
        main.x = 0;
        involution(main);
        transition main.boardbad == 1 {
            true -> th_drop3(main)
            _ -> th_dec(main)
        }
    }
    state th_dec(main: &mut Main) {
        dec_crib(main);
        transition main.acc == 1 {
            true -> th_hit(main)
            _ -> th_drop4(main)
        }
    }
    state th_hit(main: &mut Main) {
        transition main.verified >= 0 && main.verified < 64 && main.vl >= 0 && main.vl < 26
                && main.vm >= 0 && main.vm < 26 && main.vr >= 0 && main.vr < 26 {
            true -> th_hgo(main)
            _ -> th_drop5(main)
        }
    }
    state th_hgo(main: &mut Main) {
        main.verified = main.verified + 1;
        Console::write_line("verified:");
        Console::write_byte(main.vl + 65);
        Console::write_byte(main.vm + 65);
        Console::write_byte(main.vr + 65);
        Console::write_byte(10);
        transition main.vl == 18 && main.vm == 5 && main.vr == 12 {
            true -> th_sfm(main)
            _ -> th_drop6(main)
        }
    }
    state th_sfm(main: &mut Main) {
        main.hit_sfm = 1;
    }
    // Early exits: hypothesis flooded the register, board deduction failed,
    // the involution check failed, the crib did not decrypt, or the position
    // was not SFM. Each returns through its own single-arrival state so the
    // lowering proof search never sees a merge join here.
    state th_drop1(main: &mut Main) {}
    state th_drop2(main: &mut Main) {}
    state th_drop3(main: &mut Main) {}
    state th_drop4(main: &mut Main) {}
    state th_drop0(main: &mut Main) {}
    state th_drop5(main: &mut Main) {}
    state th_drop6(main: &mut Main) {}
}

// The published tables as decoded letter literals.
machine load_consts(main: &mut Main) {
    main.fwd_left = [4, 10, 12, 5, 11, 6, 3, 16, 21, 25, 13, 19, 14, 22, 24, 7, 23, 20, 18, 15, 0, 8, 1, 17, 2, 9];
    main.fwd_mid = [0, 9, 3, 10, 18, 8, 17, 20, 23, 1, 11, 7, 22, 19, 12, 2, 16, 6, 25, 13, 15, 24, 5, 21, 14, 4];
    main.fwd_right = [1, 3, 5, 7, 9, 11, 2, 15, 17, 19, 23, 21, 25, 13, 24, 4, 8, 22, 6, 0, 10, 12, 20, 18, 16, 14];
    main.refl = [24, 17, 20, 7, 16, 18, 11, 3, 15, 23, 13, 6, 14, 10, 12, 8, 4, 1, 5, 25, 2, 22, 21, 9, 0, 19];
    main.msg = [10, 4, 8, 13, 4, 1, 4, 18, 14, 13, 3, 4, 17, 4, 13, 4, 17, 4, 8, 6, 13, 8, 18, 18, 4];
    main.cexp = [1, 25, 14, 25, 25, 14, 6, 1, 12, 10, 5, 21, 22, 20, 21, 13, 18, 10, 5, 16, 5, 12, 9, 5, 17];
    main.crib = [4, 8, 13, 4, 1, 4, 18, 14, 13, 3, 4, 17, 4, 13, 4, 17, 4];
    main.cseg = [25, 14, 25, 25, 14, 6, 1, 12, 10, 5, 21, 22, 20, 21, 13, 18, 10];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("bombe: Turing/Welchman attack on Enigma I, rotors I II III, reflector B");
    transition { _ -> m_load(main) }

    state m_load(main: &mut Main) {
        load_consts(main);
        transition { _ -> m_init(main) }
    }

    state m_init(main: &mut Main) {
        init_tables(main);
        build_edges(main);
        transition { _ -> m_demo(main) }
    }
    state m_demo(main: &mut Main) {
        demo_press(main);
        check_demo(main);
        transition { _ -> m_scan(main) }
    }
    state m_scan(main: &mut Main) {
        scan(main);
        transition { _ -> m_verify(main) }
    }
    state m_verify(main: &mut Main) {
        verify(main);
        transition { _ -> m_final(main) }
    }
    state m_final(main: &mut Main) {
        transition main.hit_sfm == 1 && main.verified >= 1 {
            true -> m_pass(main)
            _ -> m_fail(main)
        }
    }
    state m_pass(main: &mut Main) {
        Console::write_line("bombe: position SFM recovered with plugboard from the menu (exit 0)");
        Console::exit_process(0);
    }
    state m_fail(main: &mut Main) {
        Console::write_line("FAIL: the true setting was not among the verified stops (exit 1)");
        Console::exit_process(1);
    }
}
