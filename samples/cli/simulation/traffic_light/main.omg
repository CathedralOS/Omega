// Traffic-light state machine. Combines case members (light phases),
// [copy, zero_init] properties on a case type, transition dispatch on
// case values, and scalar counting across multiple machine calls.
//
// The light cycles: Red -> Green -> Yellow -> Red.
// We advance 4 times (Red->Green->Yellow->Red->Green) and check the
// final phase is Green, counting total advances. Exit 70 encodes success.
//
// Expected exit: 70.

use omega::language::std::console;

// The three traffic-light phases. ZII (zero-initialized) is Red.
// Both [copy] and [zero_init] are required so Phase can be a field inside
// a [copy, zero_init] aggregate.
data Phase [copy, zero_init] {
    case Red;
    case Green;
    case Yellow;
}

// Traffic-light state: current phase + total advance count.
data Light [copy, zero_init] {
    phase: Phase;
    // Ranged + the modular-counter idiom at the increment: Exact-provable, no
    // overflow domain.
    advances: i32 [0..=100];
}

data Main {
    console: Console;
    light: Light;
    pause: String;
}

machine Main::main(&mut self) {
    self.console.write_line("traffic_light: cycles Red -> Green -> Yellow through 4 advances");
    // Start: Red (zero-initialized), advances = 0.
    self.advance();  // Red    -> Green,  advances = 1
    self.advance();  // Green  -> Yellow, advances = 2
    self.advance();  // Yellow -> Red,    advances = 3
    self.advance();  // Red    -> Green,  advances = 4

    // After 4 advances the light should be Green and advances == 4.
    transition self.light.advances == 4 {
        true -> check_phase()
        false -> bad_count()
    }

    state check_phase(&mut self) {
        transition self.light.phase {
            Phase::Green -> good()
            _ -> bad_phase()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: 4 advances landed on Green as expected (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad_count(&mut self) {
        self.console.write_line("FAIL: the advance count was not 4 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state bad_phase(&mut self) {
        self.console.write_line("FAIL: the final phase was not Green (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }
}

// Advance the light one phase: Red->Green, Green->Yellow, Yellow->Red.
machine Main::advance(&mut self) {
    self.light.advances = (self.light.advances + 1) % 101;

    transition self.light.phase {
        Phase::Red -> go_green()
        Phase::Green -> go_yellow()
        _ -> go_red()
    }

    state go_green(&mut self) {
        self.light.phase = Phase::Green;
    }

    state go_yellow(&mut self) {
        self.light.phase = Phase::Yellow;
    }

    state go_red(&mut self) {
        self.light.phase = Phase::Red;
    }
}
