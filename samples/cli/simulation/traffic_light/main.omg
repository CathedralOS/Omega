// Traffic-light state machine. Combines case members (light phases),
// [copy] property on a case type, transition dispatch on
// case values, and scalar counting across multiple machine calls.
//
// The light cycles: Red -> Green -> Yellow -> Red.
// We advance 4 times (Red->Green->Yellow->Red->Green) and check the
// final phase is Green, counting total advances. Exit 70 encodes success.
//
// Expected exit: 70.

use omega_language_std::console;

// The three traffic-light phases. ZII (zero-initialized) is Red.
// [copy] is required so Phase can be a field inside a [copy] aggregate.
data Phase [copy] {
    case Red;
    case Green;
    case Yellow;
}

// Traffic-light state: current phase + total advance count.
data Light [copy] {
    phase: Phase;
    // The modular-counter idiom at the increment: reducing `% 101` before the
    // `+ 1` makes it Exact-provable with no overflow domain.
    advances: i32;
}

data Main {
    light: Light;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("traffic_light: cycles Red -> Green -> Yellow through 4 advances");
    // Start: Red (zero-initialized), advances = 0.
    Main::advance(main);  // Red    -> Green,  advances = 1
    Main::advance(main);  // Green  -> Yellow, advances = 2
    Main::advance(main);  // Yellow -> Red,    advances = 3
    Main::advance(main);  // Red    -> Green,  advances = 4

    // After 4 advances the light should be Green and advances == 4.
    transition main.light.advances == 4 {
        true -> check_phase(main)
        false -> bad_count(main)
    }

    state check_phase(main: &mut Main) {
        transition main.light.phase {
            Phase::Green -> good(main)
            _ -> bad_phase(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: 4 advances landed on Green as expected (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad_count(main: &mut Main) {
        Console::write_line("FAIL: the advance count was not 4 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state bad_phase(main: &mut Main) {
        Console::write_line("FAIL: the final phase was not Green (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }
}

// Advance the light one phase: Red->Green, Green->Yellow, Yellow->Red.
machine Main::advance(main: &mut Main) {
    main.light.advances = (main.light.advances % 101 + 1) % 101;

    transition main.light.phase {
        Phase::Red -> go_green(main)
        Phase::Green -> go_yellow(main)
        _ -> go_red(main)
    }

    state go_green(main: &mut Main) {
        main.light.phase = Phase::Green;
    }

    state go_yellow(main: &mut Main) {
        main.light.phase = Phase::Yellow;
    }

    state go_red(main: &mut Main) {
        main.light.phase = Phase::Red;
    }
}
