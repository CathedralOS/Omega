// rotor_byte_rows: a wiring lookup's `ensures result < 26` survives widening
// into the shift that sets one live wire.
//
// Bombe re-bounds every table read before using it as a shift count. The
// lookup returns the byte under `ensures result < 26`, the caller widens it,
// and `1 << image` must be provable from that postcondition. Rotor I at A is
// 4, so the mask is 16. The same byte also indexes rotor III: column 4 is 9.
//
// Expected exit: 0
// Expected output contains: 16

use omega_language_std::console;

data Main {
    wiring: [[u8; 26]; 3];
    image: u8;
    mask: i32;
    out: u8;
}

machine wiring_at(wiring: &[[u8; 26]; 3], rotor: i32, letter: i32) -> u8
    requires rotor >= 0 && rotor < 3 && letter >= 0 && letter < 26
    ensures result < 26
{
    let image: u8 = wiring[rotor][letter];
    transition image < 26 {
        true -> (image)
        _ -> (0)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("rotor_byte_rows: ensured wiring byte widens into a live-wire shift");
    main.wiring = [
        [4, 10, 12, 5, 11, 6, 3, 16, 21, 25, 13, 19, 14, 22, 24, 7, 23, 20, 18, 15, 0, 8, 1, 17, 2, 9],
        [0, 9, 3, 10, 18, 8, 17, 20, 23, 1, 11, 7, 22, 19, 12, 2, 16, 6, 25, 13, 15, 24, 5, 21, 14, 4],
        [1, 3, 5, 7, 9, 11, 2, 15, 17, 19, 23, 21, 25, 13, 24, 4, 8, 22, 6, 0, 10, 12, 20, 18, 16, 14]
    ];
    let direct: i32 = 1i32 << (wiring_at(&main.wiring, 0, 0) as i32);
    main.image = wiring_at(&main.wiring, 0, 0);
    main.mask = 1i32 << (main.image as i32);
    main.out = main.wiring[2][wiring_at(&main.wiring, 0, 0)];
    transition direct == 16 && main.mask == 16 && main.out == 9 {
        true -> pass(main)
        _ -> fail(main)
    }

    state pass(main: &mut Main) {
        Console::write_line("16");
        Console::exit_process(0);
    }

    state fail(main: &mut Main) {
        Console::write_line("FAIL");
        Console::exit_process(1);
    }
}
