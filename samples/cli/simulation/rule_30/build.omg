// rule_30 build sketch -- console-only subject; cross-platform providers map
// stdout/exit to OS calls on each hosted target.

machine build(builder: &mut Build) {
    Build::application(builder, "rule_30");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../source/library/std"
    }));
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
