use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Conway's Game of Life, animated in place: a single GLIDER seeded near the top-left
// glides diagonally down-right across a 24x12 field as the generations tick. Each cell
// lives or dies by its eight neighbours -- a live cell with 2-3 survives, a dead cell with
// exactly 3 is born, all else die -- the simplest rules from which a moving structure
// emerges. (A self-checking 4x4 still-life version lives in samples/game_of_life; this is
// the visual one.)
//
// The grid is a flat [i32; 26*14] with a one-cell dead border. Computed indices and
// read values are locals; values needed across a transition are explicit state
// arguments. The next generation is double-buffered. Pure compute + stdout + Clock.sleep.
// Expected exit: 0.
// Expected output contains: #
use system\Console;
use system\Clock;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 24]::Utf8
requires
    valid_utf8(self);
domain [u8; 3]::Utf8
requires
    valid_utf8(self);
data Main {
    grid: [i32; 364]; // 26 x 14, padded; real cells rows 1..12, cols 1..24
}

machine main(main: @mutable Main) reaches ProcessExit + Clock + StandardInput + StandardOutput {
    Console::write_line("game_of_life_glider: a glider crossing a 24x12 field, animated in place");
    transition { _ -> block clear_grid(main, 0) }

    machine clear_grid(main: @mutable Main, cell_index: i32) {
        transition cell_index >= 0 && cell_index < 364 {
            true -> block clear_cell(main, cell_index),
            _ -> block seed(main)
        }
    }
    machine clear_cell(main: @mutable Main, cell_index: i32) {
        main.grid[cell_index] = 0;
        transition { _ -> block clear_grid(main, cell_index + 1) }
    }
    machine seed(main: @mutable Main) {
        // Glider at padded rows 1..3, columns 1..3.
        main.grid[28] = 1;
        main.grid[55] = 1;
        main.grid[79] = 1;
        main.grid[80] = 1;
        main.grid[81] = 1;
        transition { _ -> block generation_loop(main, 0) }
    }
    machine generation_loop(main: @mutable Main, generation: i32) {
        transition generation >= 0 && generation < 40 {
            true -> block render(main, generation),
            _ -> block finish(main)
        }
    }
    machine render(main: @mutable Main, generation: i32) {
        let rendered: bool = main_render(main);
        transition rendered {
            true -> block advance(main, generation),
            _ -> block bad(main)
        }
    }
    machine advance(main: @mutable Main, generation: i32) {
        block Clock::sleep(90);
        let advanced: bool = advance_generation(@mutable main.grid);
        transition advanced {
            true -> block next_generation(main, generation),
            _ -> block bad(main)
        }
    }
    machine next_generation(main: @mutable Main, generation: i32) {
        transition generation >= 0 && generation < 40 {
            true -> block increment_generation(main, generation),
            _ -> block finish(main)
        }
    }
    machine increment_generation(main: @mutable Main, generation: i32) {
        transition { _ -> block generation_loop(main, generation + 1) }
    }
    machine finish(main: @mutable Main) {
        Console::write_line("PASS: 40 generations rendered (exit 0)");
        Console::write_line("[press Enter to close]");
        let mutable pause: [u8; 256];
        _ = block Console::read_line(@mutable pause[..]);
        ProcessExit::exit_process(0);
    }
    machine bad(main: @mutable Main) {
        Console::write_line("FAIL: internal bounds check failed (exit 1)");
        Console::write_line("[press Enter to close]");
        let mutable pause: [u8; 256];
        _ = block Console::read_line(@mutable pause[..]);
        ProcessExit::exit_process(1);
    }
}

// The next grid is invocation-owned scratch, not part of the persistent model.
// It stays private until every cell has been computed from the original grid.
machine advance_generation(grid: @mutable [i32; 364]) -> bool {
    let mutable next: [i32; 364];
    transition { _ -> cells(grid, @mutable next, 0) }

    machine cells(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> locate_cell(grid, next, cell_index),
            _ -> copy_cells(grid, next, 0)
        }
    }
    machine locate_cell(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32) -> bool {
        let row: i32 = cell_index / 26;
        let column: i32 = cell_index % 26;
        transition row >= 1 && row <= 12 && column >= 1 && column <= 24 {
            true -> count_neighbors(grid, next, cell_index),
            _ -> write_cell(grid, next, cell_index, 0)
        }
    }
    machine count_neighbors(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> apply_rules(grid, next, cell_index),
            _ -> invalid()
        }
    }
    machine apply_rules(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32) -> bool {
        let count: i32 = live_neighbors(grid, cell_index);
        let cell: i32 = grid[cell_index];
        transition count == 3 || (cell == 1 && count == 2) {
            true -> write_cell(grid, next, cell_index, 1),
            _ -> write_cell(grid, next, cell_index, 0)
        }
    }
    machine write_cell(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32, cell: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> store_cell(grid, next, cell_index, cell),
            _ -> invalid()
        }
    }
    machine store_cell(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32, cell: i32) -> bool {
        next[cell_index] = cell;
        transition { _ -> cells(grid, next, cell_index + 1) }
    }
    machine copy_cells(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> copy_cell(grid, next, cell_index),
            _ -> done()
        }
    }
    machine copy_cell(grid: @mutable [i32; 364], next: @mutable [i32; 364], cell_index: i32) -> bool {
        let cell: i32 = next[cell_index];
        grid[cell_index] = cell;
        transition { _ -> copy_cells(grid, next, cell_index + 1) }
    }
    machine done() -> bool { true }
    machine invalid() -> bool { false }
}

machine live_neighbors(grid: @[i32; 364], cell_index: i32) -> i32
requires cell_index >= 0 && cell_index < 364
{
    transition { _ -> neighbors(grid, cell_index, 0, 0) }

    machine neighbors(grid: @[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition offset >= 0 && offset < 9 {
            true -> skip_center(grid, cell_index, offset, count),
            _ -> done(count)
        }
    }
    machine skip_center(grid: @[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition offset == 4 {
            true -> advance(grid, cell_index, offset, count),
            _ -> cell_bounds(grid, cell_index, offset, count)
        }
    }
    machine cell_bounds(grid: @[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition cell_index >= 0 && cell_index < 364 {
            true -> locate_neighbor(grid, cell_index, offset, count),
            _ -> done(count)
        }
    }
    machine locate_neighbor(grid: @[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        let neighbor_index: i32 = cell_index + (offset / 3 - 1) * 26 + (offset % 3 - 1);
        transition neighbor_index >= 0 && neighbor_index < 364 {
            true -> read_neighbor(grid, cell_index, offset, count, neighbor_index),
            _ -> advance(grid, cell_index, offset, count)
        }
    }
    machine read_neighbor(grid: @[i32; 364], cell_index: i32, offset: i32, count: i32, neighbor_index: i32) -> i32 {
        let neighbor: i32 = grid[neighbor_index];
        transition neighbor == 1 {
            true -> advance(grid, cell_index, offset, (count % 9 + 1) % 9),
            _ -> advance(grid, cell_index, offset, count)
        }
    }
    machine advance(grid: @[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition offset >= 0 && offset < 9 {
            true -> increment(grid, cell_index, offset, count),
            _ -> done(count)
        }
    }
    machine increment(grid: @[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition { _ -> neighbors(grid, cell_index, offset + 1, count) }
    }
    machine done(count: i32) -> i32 { count }
}

// Rendering owns its row buffer for one invocation. The grid and bindings stay
// in Main; row/column positions travel as values on the edges that use them.
machine main_render(main: @mutable Main) -> bool reaches ProcessExit + StandardOutput {
    let mutable home: [u8; 3] in Utf8 = "XXX";
    home[0] = 27;
    home[1] = 91;
    home[2] = 72;
    Console::write(home);
    let mutable line: [u8; 24] in Utf8 = "                        ";
    transition { _ -> render_row(main, @mutable line, 1) }

    machine render_row(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32) -> bool {
        transition row >= 1 && row <= 12 {
            true -> render_column(main, line, row, 0),
            _ -> done()
        }
    }
    machine render_column(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition column >= 0 && column < 24 {
            true -> cell_bounds(main, line, row, column),
            _ -> emit_row(main, line, row)
        }
    }
    machine cell_bounds(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition row >= 1 && row <= 12 {
            true -> locate_cell(main, line, row, column),
            _ -> invalid()
        }
    }
    machine locate_cell(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        let cell_index: i32 = row * 26 + (column + 1);
        transition cell_index >= 0 && cell_index < 364 {
            true -> read_cell(main, line, row, column, cell_index),
            _ -> invalid()
        }
    }
    machine read_cell(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32, cell_index: i32) -> bool {
        let cell: i32 = main.grid[cell_index];
        transition cell >= 0 && cell < 2 {
            true -> put_cell(main, line, row, column, cell),
            _ -> invalid()
        }
    }
    machine put_cell(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32, cell: i32) -> bool {
        transition cell == 1 {
            true -> live_glyph(main, line, row, column),
            _ -> dead_glyph(main, line, row, column)
        }
    }
    machine live_glyph(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        line[column] = 35; // '#', an ASCII byte.
        transition { _ -> column_bounds(main, line, row, column) }
    }
    machine dead_glyph(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        line[column] = 32; // Space, an ASCII byte.
        transition { _ -> column_bounds(main, line, row, column) }
    }
    machine column_bounds(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition column >= 0 && column < 24 {
            true -> advance_column(main, line, row, column),
            _ -> emit_row(main, line, row)
        }
    }
    machine advance_column(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition { _ -> render_column(main, line, row, column + 1) }
    }
    machine emit_row(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32) -> bool {
        Console::write_line(line);
        transition row >= 0 && row <= 12 {
            true -> advance_row(main, line, row),
            _ -> done()
        }
    }
    machine advance_row(main: @mutable Main, line: @mutable [u8; 24] in Utf8, row: i32) -> bool {
        transition { _ -> render_row(main, line, row + 1) }
    }
    machine done() -> bool { true }
    machine invalid() -> bool { false }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Clock + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
