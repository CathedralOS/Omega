// Conway's Game of Life, animated in place: a single GLIDER seeded near the top-left
// glides diagonally down-right across a 24x12 field as the generations tick. Each cell
// lives or dies by its eight neighbours -- a live cell with 2-3 survives, a dead cell with
// exactly 3 is born, all else die -- the simplest rules from which a moving structure
// emerges. (A self-checking 4x4 still-life version lives in samples/game_of_life; this is
// the visual one.)
//
// The grid is a FLAT [u8; 26*14] with a one-cell DEAD BORDER, so every real cell's eight
// neighbours are always in range -- no per-neighbour boundary test. 2D indexing uses the
// linear-counter sidestep: the (row, col) and each neighbour's flat index are computed
// into FIELDS, then used as plain indices (a computed expression directly in a subscript
// is refused). The next generation is double-buffered and copied back through a field temp
// (a direct grid[c] = next[c] is a dual-indexed gap). Pure compute + stdout + Clock.sleep.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 24]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 2]::Utf8(bytes)
requires
    valid_utf8(bytes);
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }

// Declared-host Clock wiring, the pattern `samples/gui/window_app` carries: a
// provider data, a target-scoped `provider_defaults` that selects it, and a
// `satisfies Clock::sleep` machine over the `darwin_poll` leaf. The provider
// holds no state: each call keeps its timeout and poll status in locals, where
// the static-machine contract places invocation scratch.
data PacingClockProvider { }
macos_arm64 machine PacingClockProvider::provider_defaults(defaults: &mut PacingClockProvider) {
    defaults.select_provider<Clock, PacingClockProvider>();
}
macos_arm64 machine PacingClockProvider::sleep(milliseconds: u32) satisfies Clock::sleep
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    grid: [i32; 364]; // 26 x 14, padded; real cells rows 1..12, cols 1..24
    next: [i32; 364];
    line: [u8; 24] in Utf8;       // one rendered row (visible width)
    chars: [u8; 2] in Utf8;       // " #"  dead / alive
    home: [u8; 3] in Utf8;        // ESC [ H
    gen: i32;               // guard-proven generation counter
    c: i32;                 // cell flat index
    y: i32;                 // cell row (comparison-only; comparisons carry no obligation)
    x: i32;                 // cell col (comparison-only)
    noff: i32;              // neighbour offset 0..9
    nf: i32;                // neighbour flat index (bounded fold from the c/noff guards)
    count: i32;             // live neighbour count (modular-counter increment)
    v: i32;                 // a read cell value (array reads carry no range facts)
    alive: i32;             // self cell value
    nv: i32;                // next cell value (written 0/1)
    ry: i32;                // render row
    vx: i32;                // render visible col 0..24
    rf: i32;                // render flat index (bounded fold from the ry/vx guards)
    glyph: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console + DarwinClock {
    main.console.write_line("game_of_life_glider: a glider crossing a 24x12 field, animated in place");
    main.chars = " #";
    main.home = "XXX";
    main.home[0] = 27;
    main.home[1] = 91;
    main.home[2] = 72;
    main.line = "                        ";
    main.c = 0;
    transition { _ -> zero_loop(main) }

    // --- clear the padded grid, then seed a glider ---
    state zero_loop(main: &mut Main) {
        transition main.c >= 0 && main.c < 364 { true -> zero_cell(main) _ -> seed(main) }
    }
    state zero_cell(main: &mut Main) {
        main.grid[main.c] = 0;
        main.c = main.c + 1;
        transition { _ -> zero_loop(main) }
    }
    state seed(main: &mut Main) {
        // glider:  .#.  /  ..#  /  ###   at real rows 1..3, cols 1..3 (padded width 26)
        main.grid[28] = 1;  // (1,2)
        main.grid[55] = 1;  // (2,3)
        main.grid[79] = 1;  // (3,1)
        main.grid[80] = 1;  // (3,2)
        main.grid[81] = 1;  // (3,3)
        main.gen = 0;
        transition { _ -> gen_loop(main) }
    }

    state gen_loop(main: &mut Main) {
        transition main.gen < 40 { true -> render_start(main) _ -> finish(main) }
    }

    // --- render the visible 24x12 window in place ---
    state render_start(main: &mut Main) {
        main.console.write(main.home);
        main.ry = 1;
        transition { _ -> render_row(main) }
    }
    state render_row(main: &mut Main) {
        transition main.ry >= 1 && main.ry <= 12 { true -> render_col_init(main) _ -> after_render(main) }
    }
    state render_col_init(main: &mut Main) {
        main.vx = 0;
        transition { _ -> render_col(main) }
    }
    state render_col(main: &mut Main) {
        transition main.vx >= 0 && main.vx < 24 { true -> render_cell(main) _ -> emit_row(main) }
    }
    // Re-assert the row bound: render_row's guard sits behind the render_col
    // join, so the flat-index arithmetic needs `ry` bounded on its own edge.
    state render_cell(main: &mut Main) {
        transition main.ry >= 1 && main.ry <= 12 { true -> render_index(main) _ -> bad(main) }
    }
    state render_index(main: &mut Main) {
        main.rf = main.ry * 26 + (main.vx + 1); // skip the left border column
        transition main.rf >= 0 && main.rf < 364 { true -> render_read(main) _ -> bad(main) }
    }
    state render_read(main: &mut Main) {
        main.v = main.grid[main.rf];
        transition main.v >= 0 && main.v < 2 { true -> render_put(main) _ -> bad(main) }
    }
    // Re-guard so the increment's direct edge proves `vx + 1` lands in
    // [1..=24] (the edge into render_put carries only the v guard).
    state render_put(main: &mut Main) {
        main.glyph = main.chars[main.v];
        main.line[main.vx] = main.glyph;
        transition main.vx >= 0 && main.vx < 24 { true -> col_advance(main) _ -> emit_row(main) }
    }
    state col_advance(main: &mut Main) {
        main.vx = main.vx + 1;
        transition { _ -> render_col(main) }
    }
    // Re-guard so the increment's direct edge proves `ry + 1` lands in
    // [1..=13] (the write_line call severs the render_row guard anyway).
    state emit_row(main: &mut Main) {
        main.console.write_line(main.line);
        transition main.ry >= 0 && main.ry <= 12 { true -> row_advance(main) _ -> after_render(main) }
    }
    state row_advance(main: &mut Main) {
        main.ry = main.ry + 1;
        transition { _ -> render_row(main) }
    }
    state after_render(main: &mut Main) {
        main.clock.sleep(90);
        transition { _ -> compute_start(main) }
    }

    // --- compute the next generation ---
    state compute_start(main: &mut Main) {
        main.c = 0;
        transition { _ -> cell_loop(main) }
    }
    state cell_loop(main: &mut Main) {
        transition main.c >= 0 && main.c < 364 { true -> cell_xy(main) _ -> copy_start(main) }
    }
    // Division/modulo results feed no RANGE fact yet (only the overflow fold
    // understands them), so the (row, col) go through plain temps and a guard:
    // the guarded edge decides whether c is a real cell or border.
    state cell_xy(main: &mut Main) {
        main.y = main.c / 26;
        main.x = main.c % 26;
        transition main.y >= 1 && main.y <= 12 && main.x >= 1 && main.x <= 24 {
            true -> count_init(main)
            _ -> border_guard(main)
        }
    }
    // Re-guard c so the border write + increment sit on a direct `c < 364` edge
    // (the y/x guard on the edge above carries no c fact).
    state border_guard(main: &mut Main) {
        transition main.c >= 0 && main.c < 364 { true -> border_cell(main) _ -> bad(main) }
    }
    state border_cell(main: &mut Main) {
        main.next[main.c] = 0;
        main.c = main.c + 1;
        transition { _ -> cell_loop(main) }
    }

    // count the eight neighbours
    state count_init(main: &mut Main) {
        main.count = 0;
        main.noff = 0;
        transition { _ -> nb_loop(main) }
    }
    state nb_loop(main: &mut Main) {
        transition main.noff >= 0 && main.noff < 9 { true -> nb_center(main) _ -> apply_rules(main) }
    }
    state nb_center(main: &mut Main) {
        transition main.noff == 4 { true -> nb_advance(main) _ -> nb_bounds(main) }
    }
    // Re-guard c: the neighbour loop's join blocks the cell_loop bound from
    // carrying here, and the flat-index fold below needs it.
    state nb_bounds(main: &mut Main) {
        transition main.c >= 0 && main.c < 364 { true -> nb_compute(main) _ -> bad(main) }
    }
    state nb_compute(main: &mut Main) {
        // Since c == y*26 + x by construction, the neighbour's flat index is
        // c + (noff/3 - 1)*26 + (noff%3 - 1) -- computed from the re-guarded c
        // so the overflow fold bounds it (y/x carry no facts past the join; c
        // does), and the transition below runtime-guards it as an index.
        main.nf = main.c + (main.noff / 3 - 1) * 26 + (main.noff % 3 - 1);
        transition main.nf >= 0 && main.nf < 364 { true -> nb_read(main) _ -> nb_advance(main) }
    }
    state nb_read(main: &mut Main) {
        main.v = main.grid[main.nf];
        transition main.v == 1 { true -> nb_inc(main) _ -> nb_advance(main) }
    }
    // The modular-counter idiom: reducing the tally `% 9` before the `+ 1`
    // bounds the operand, and the outer `% 9` keeps it below 9 (a cell has at
    // most 8 neighbours, so the wrap never fires).
    state nb_inc(main: &mut Main) {
        main.count = (main.count % 9 + 1) % 9;
        transition { _ -> nb_advance(main) }
    }
    // Re-guard so the increment's direct edge proves `noff + 1` lands in
    // [1..=9] -- always true here (nb_loop only admits noff < 9).
    state nb_advance(main: &mut Main) {
        transition main.noff >= 0 && main.noff < 9 { true -> nb_bump(main) _ -> apply_rules(main) }
    }
    state nb_bump(main: &mut Main) {
        main.noff = main.noff + 1;
        transition { _ -> nb_loop(main) }
    }

    // apply the rules to cell c (re-guard c: the neighbour loop's join blocks the
    // cell_loop bound from carrying here)
    state apply_rules(main: &mut Main) {
        transition main.c >= 0 && main.c < 364 { true -> apply_read(main) _ -> bad(main) }
    }
    state apply_read(main: &mut Main) {
        main.alive = main.grid[main.c];
        transition main.alive == 1 { true -> live_rule(main) _ -> dead_rule(main) }
    }
    state live_rule(main: &mut Main) {
        transition main.count == 2 || main.count == 3 { true -> born(main) _ -> dies(main) }
    }
    state dead_rule(main: &mut Main) {
        transition main.count == 3 { true -> born(main) _ -> dies(main) }
    }
    state born(main: &mut Main) {
        main.nv = 1;
        transition { _ -> write_next(main) }
    }
    state dies(main: &mut Main) {
        main.nv = 0;
        transition { _ -> write_next(main) }
    }
    state write_next(main: &mut Main) {
        transition main.c >= 0 && main.c < 364 { true -> do_write_next(main) _ -> bad(main) }
    }
    state do_write_next(main: &mut Main) {
        main.next[main.c] = main.nv;
        main.c = main.c + 1;
        transition { _ -> cell_loop(main) }
    }

    // --- copy next -> grid via a field temp ---
    state copy_start(main: &mut Main) {
        main.c = 0;
        transition { _ -> copy_loop(main) }
    }
    state copy_loop(main: &mut Main) {
        transition main.c >= 0 && main.c < 364 { true -> copy_cell(main) _ -> gen_next(main) }
    }
    state copy_cell(main: &mut Main) {
        main.v = main.next[main.c];
        main.grid[main.c] = main.v;
        main.c = main.c + 1;
        transition { _ -> copy_loop(main) }
    }
    // Re-guard so the increment's direct edge proves `gen + 1` lands in
    // [1..=40] (the copy loop's exit edge carries only a c fact).
    state gen_next(main: &mut Main) {
        transition main.gen >= 0 && main.gen < 40 { true -> gen_bump(main) _ -> finish(main) }
    }
    state gen_bump(main: &mut Main) {
        main.gen = main.gen + 1;
        transition { _ -> gen_loop(main) }
    }

    state finish(main: &mut Main) {
        main.console.write_line("PASS: 40 generations rendered (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: internal bounds check failed (exit 1)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(1);
    }
}
