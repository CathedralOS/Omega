// Conway's Game of Life, animated in place: a single GLIDER seeded near the top-left
// glides diagonally down-right across a 24x12 field as the generations tick. Each cell
// lives or dies by its eight neighbours -- a live cell with 2-3 survives, a dead cell with
// exactly 3 is born, all else die -- the simplest rules from which a moving structure
// emerges. (A self-checking 4x4 still-life version lives in samples/game_of_life; this is
// the visual one.)
//
// The grid is a flat [i32; 26*14] with a one-cell dead border. Computed indices and
// read values are locals; values needed across a transition are explicit state
// arguments. The next generation is double-buffered. Pure compute + stdout + Clock.sleep.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega_language_std::clock;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 24]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    grid: [i32; 364]; // 26 x 14, padded; real cells rows 1..12, cols 1..24
}

machine Main::main(main: &mut Main) reaches Clock + Console {
    Console::write_line("game_of_life_glider: a glider crossing a 24x12 field, animated in place");
    transition { _ -> clear_grid(main, 0) }

    state clear_grid(main: &mut Main, cell_index: i32) {
        transition cell_index >= 0 && cell_index < 364 {
            true -> clear_cell(main, cell_index)
            _ -> seed(main)
        }
    }
    state clear_cell(main: &mut Main, cell_index: i32) {
        main.grid[cell_index] = 0;
        transition { _ -> clear_grid(main, cell_index + 1) }
    }
    state seed(main: &mut Main) {
        // Glider at padded rows 1..3, columns 1..3.
        main.grid[28] = 1;
        main.grid[55] = 1;
        main.grid[79] = 1;
        main.grid[80] = 1;
        main.grid[81] = 1;
        transition { _ -> generation_loop(main, 0) }
    }
    state generation_loop(main: &mut Main, generation: i32) {
        transition generation >= 0 && generation < 40 {
            true -> render(main, generation)
            _ -> finish(main)
        }
    }
    state render(main: &mut Main, generation: i32) {
        let rendered: bool = Main::render(main);
        transition rendered {
            true -> advance(main, generation)
            _ -> bad(main)
        }
    }
    state advance(main: &mut Main, generation: i32) {
        Clock::sleep(90);
        let advanced: bool = advance_generation(&mut main.grid);
        transition advanced {
            true -> next_generation(main, generation)
            _ -> bad(main)
        }
    }
    state next_generation(main: &mut Main, generation: i32) {
        transition generation >= 0 && generation < 40 {
            true -> increment_generation(main, generation)
            _ -> finish(main)
        }
    }
    state increment_generation(main: &mut Main, generation: i32) {
        transition { _ -> generation_loop(main, generation + 1) }
    }
    state finish(main: &mut Main) {
        Console::write_line("PASS: 40 generations rendered (exit 0)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: internal bounds check failed (exit 1)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(1);
    }
}

// The next grid is invocation-owned scratch, not part of the persistent model.
// It stays private until every cell has been computed from the original grid.
machine advance_generation(grid: &mut [i32; 364]) -> bool {
    let mut next: [i32; 364];
    transition { _ -> cells(grid, &mut next, 0) }

    state cells(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> locate_cell(grid, next, cell_index)
            _ -> copy_cells(grid, next, 0)
        }
    }
    state locate_cell(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32) -> bool {
        let row: i32 = cell_index / 26;
        let column: i32 = cell_index % 26;
        transition row >= 1 && row <= 12 && column >= 1 && column <= 24 {
            true -> count_neighbors(grid, next, cell_index)
            _ -> write_cell(grid, next, cell_index, 0)
        }
    }
    state count_neighbors(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> apply_rules(grid, next, cell_index)
            _ -> invalid()
        }
    }
    state apply_rules(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32) -> bool {
        let count: i32 = live_neighbors(grid, cell_index);
        let cell: i32 = grid[cell_index];
        transition count == 3 || (cell == 1 && count == 2) {
            true -> write_cell(grid, next, cell_index, 1)
            _ -> write_cell(grid, next, cell_index, 0)
        }
    }
    state write_cell(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32, cell: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> store_cell(grid, next, cell_index, cell)
            _ -> invalid()
        }
    }
    state store_cell(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32, cell: i32) -> bool {
        next[cell_index] = cell;
        transition { _ -> cells(grid, next, cell_index + 1) }
    }
    state copy_cells(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32) -> bool {
        transition cell_index >= 0 && cell_index < 364 {
            true -> copy_cell(grid, next, cell_index)
            _ -> done()
        }
    }
    state copy_cell(grid: &mut [i32; 364], next: &mut [i32; 364], cell_index: i32) -> bool {
        let cell: i32 = next[cell_index];
        grid[cell_index] = cell;
        transition { _ -> copy_cells(grid, next, cell_index + 1) }
    }
    state done() -> bool { true }
    state invalid() -> bool { false }
}

machine live_neighbors(grid: &[i32; 364], cell_index: i32) -> i32
requires cell_index >= 0 && cell_index < 364;
{
    transition { _ -> neighbors(grid, cell_index, 0, 0) }

    state neighbors(grid: &[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition offset >= 0 && offset < 9 {
            true -> skip_center(grid, cell_index, offset, count)
            _ -> done(count)
        }
    }
    state skip_center(grid: &[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition offset == 4 {
            true -> advance(grid, cell_index, offset, count)
            _ -> cell_bounds(grid, cell_index, offset, count)
        }
    }
    state cell_bounds(grid: &[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition cell_index >= 0 && cell_index < 364 {
            true -> locate_neighbor(grid, cell_index, offset, count)
            _ -> done(count)
        }
    }
    state locate_neighbor(grid: &[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        let neighbor_index: i32 = cell_index + (offset / 3 - 1) * 26 + (offset % 3 - 1);
        transition neighbor_index >= 0 && neighbor_index < 364 {
            true -> read_neighbor(grid, cell_index, offset, count, neighbor_index)
            _ -> advance(grid, cell_index, offset, count)
        }
    }
    state read_neighbor(grid: &[i32; 364], cell_index: i32, offset: i32, count: i32, neighbor_index: i32) -> i32 {
        let neighbor: i32 = grid[neighbor_index];
        transition neighbor == 1 {
            true -> advance(grid, cell_index, offset, (count % 9 + 1) % 9)
            _ -> advance(grid, cell_index, offset, count)
        }
    }
    state advance(grid: &[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition offset >= 0 && offset < 9 {
            true -> increment(grid, cell_index, offset, count)
            _ -> done(count)
        }
    }
    state increment(grid: &[i32; 364], cell_index: i32, offset: i32, count: i32) -> i32 {
        transition { _ -> neighbors(grid, cell_index, offset + 1, count) }
    }
    state done(count: i32) -> i32 { count }
}

// Rendering owns its row buffer for one invocation. The grid and bindings stay
// in Main; row/column positions travel as values on the edges that use them.
machine Main::render(main: &mut Main) -> bool reaches Console {
    let mut home: [u8; 3] in Utf8 = "XXX";
    home[0] = 27;
    home[1] = 91;
    home[2] = 72;
    Console::write(home);
    let mut line: [u8; 24] in Utf8 = "                        ";
    transition { _ -> render_row(main, &mut line, 1) }

    state render_row(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32) -> bool {
        transition row >= 1 && row <= 12 {
            true -> render_column(main, line, row, 0)
            _ -> done()
        }
    }
    state render_column(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition column >= 0 && column < 24 {
            true -> cell_bounds(main, line, row, column)
            _ -> emit_row(main, line, row)
        }
    }
    state cell_bounds(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition row >= 1 && row <= 12 {
            true -> locate_cell(main, line, row, column)
            _ -> invalid()
        }
    }
    state locate_cell(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        let cell_index: i32 = row * 26 + (column + 1);
        transition cell_index >= 0 && cell_index < 364 {
            true -> read_cell(main, line, row, column, cell_index)
            _ -> invalid()
        }
    }
    state read_cell(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32, cell_index: i32) -> bool {
        let cell: i32 = main.grid[cell_index];
        transition cell >= 0 && cell < 2 {
            true -> put_cell(main, line, row, column, cell)
            _ -> invalid()
        }
    }
    state put_cell(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32, cell: i32) -> bool {
        transition cell == 1 {
            true -> live_glyph(main, line, row, column)
            _ -> dead_glyph(main, line, row, column)
        }
    }
    state live_glyph(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        line[column] = 35; // '#', an ASCII byte.
        transition { _ -> column_bounds(main, line, row, column) }
    }
    state dead_glyph(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        line[column] = 32; // Space, an ASCII byte.
        transition { _ -> column_bounds(main, line, row, column) }
    }
    state column_bounds(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition column >= 0 && column < 24 {
            true -> advance_column(main, line, row, column)
            _ -> emit_row(main, line, row)
        }
    }
    state advance_column(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32, column: i32) -> bool {
        transition { _ -> render_column(main, line, row, column + 1) }
    }
    state emit_row(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32) -> bool {
        Console::write_line(line);
        transition row >= 0 && row <= 12 {
            true -> advance_row(main, line, row)
            _ -> done()
        }
    }
    state advance_row(main: &mut Main, line: &mut [u8; 24] in Utf8, row: i32) -> bool {
        transition { _ -> render_row(main, line, row + 1) }
    }
    state done() -> bool { true }
    state invalid() -> bool { false }
}
