use omega_language_std::math;

// An elementary cellular automaton (Wolfram Rule 90) rendered as a scrolling space-time
// diagram -- each generation is one printed row, so the history builds downward. From a
// single live cell in the centre, Rule 90 (next = left XOR right) draws the SIERPINSKI
// TRIANGLE, a fractal. The same engine runs any 8-bit rule (e.g. 110, which is
// Turing-complete) by changing the rule constant + the seed.
//
// The generation step is a SLIDING WINDOW: a 3-bit register holds the (left,centre,right)
// neighbourhood and shifts in one freshly-read cell at a time, so every array access uses
// a PLAIN counter index (no computed `cells[x+1]` subscript). The new cell is the rule bit
// `(rule >> neighbourhood) & 1` (a value-position shift). Rendering maps 0/1 through a
// 2-glyph Utf8 ramp " #"; the double buffer is copied back via a field temp.
// The grids are plain `[i32; 64]`, so an indexed read carries no 0/1 fact: a
// value re-guard (cv < 2) precedes the ramp lookup, and `min`/`max` clamps --
// the identity on the values this automaton produces -- bound the window fold
// and the rule-bit shift, keeping all of it Exact. Pure compute + stdout +
// Clock.sleep.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega_language_std::clock;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 64]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 2]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    cells: [i32; 64];       // current generation (0/1)
    next: [i32; 64];        // next generation
    line: [u8; 64] in Utf8; // render buffer
    chars: [u8; 2] in Utf8; // " #"  dead / alive glyphs
    gen: i32;               // guard-proven Exact generation counter
    rp: i32;                // sliding-window read head, 0..64 (guard-proven)
    op: i32;                // output head = rp - 1 (-1 before the window fills)
    window: i32;            // 3-bit (left,centre,right) neighbourhood, modular by construction
    cell: i32;              // freshly read cell value (clamped to 0/1 where it is used)
    nv: i32;                // computed next value (the rule bit)
    x: i32;                 // render / copy index (guard-proven)
    cv: i32;                // cell value during render / copy (re-guarded to 0/1 before the lookup)
    glyph: u8;              // rendered byte (from the Utf8 ramp)
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console {
    Console::write_line("cellular_automaton: Rule 90 from a single centre cell -- 32 generations draw the Sierpinski triangle");
    main.line = "                                                                ";
    main.chars = " #";
    main.x = 0;
    transition { _ -> zero_loop(main) }

    // --- clear the grid, then light a single centre cell ---
    state zero_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 64 { true -> zero_cell(main) _ -> seed(main) }
    }
    state zero_cell(main: &mut Main) {
        main.cells[main.x] = 0;
        main.x = main.x + 1;
        transition { _ -> zero_loop(main) }
    }
    state seed(main: &mut Main) {
        main.cells[32] = 1;
        main.gen = 0;
        transition { _ -> gen_loop(main) }
    }

    state gen_loop(main: &mut Main) {
        transition main.gen < 32 { true -> render_init(main) _ -> finish(main) }
    }

    // --- render the current generation as one row ---
    state render_init(main: &mut Main) {
        main.x = 0;
        transition { _ -> render_loop(main) }
    }
    state render_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 64 { true -> render_cell(main) _ -> emit(main) }
    }
    state render_cell(main: &mut Main) {
        main.cv = main.cells[main.x];
        transition main.cv >= 0 && main.cv < 2 { true -> render_put(main) _ -> bad(main) }
    }
    state render_put(main: &mut Main) {
        // ramp lookup carries the Utf8-ness into the carrier (the ripple_field pattern)
        main.glyph = main.chars[main.cv];
        transition main.x >= 0 && main.x < 64 { true -> render_emit(main) _ -> bad(main) }
    }
    state render_emit(main: &mut Main) {
        main.line[main.x] = main.glyph;
        main.x = main.x + 1;
        transition { _ -> render_loop(main) }
    }
    state emit(main: &mut Main) {
        Console::write_line(main.line);
        transition { _ -> scan_init(main) }
    }

    // --- compute the next generation with a sliding 3-cell window ---
    state scan_init(main: &mut Main) {
        main.window = 0;
        main.rp = 0;
        main.op = 0 - 1;
        transition { _ -> scan_loop(main) }
    }
    state scan_loop(main: &mut Main) {
        transition main.rp >= 0 && main.rp <= 64 { true -> scan_read(main) _ -> copy_init(main) }
    }
    state scan_read(main: &mut Main) {
        transition main.rp < 64 { true -> scan_real(main) _ -> scan_border(main) }
    }
    state scan_real(main: &mut Main) {
        transition main.rp >= 0 && main.rp < 64 { true -> scan_got(main) _ -> bad(main) }
    }
    state scan_got(main: &mut Main) {
        main.cell = main.cells[main.rp];
        transition { _ -> scan_update(main) }
    }
    state scan_border(main: &mut Main) {
        main.cell = 0; // cells outside the grid are dead
        transition { _ -> scan_update(main) }
    }
    state scan_update(main: &mut Main) {
        // Shift-in as PROVEN-Exact arithmetic: the window stays in [0,7] and
        // grid cells are always 0/1, so the min/max clamps are the identity
        // while giving both operands a provable bound; the `% 8` then keeps the
        // fold inside [0,7] --
        // (w*2 + c) % 8 == ((w << 1) | c) & 7 for w in [0,7], c in {0,1}.
        main.window = (min_i32(max_i32(main.window, 0), 7) * 2 + min_i32(max_i32(main.cell, 0), 1)) % 8;
        transition { _ -> scan_write(main) }
    }
    state scan_write(main: &mut Main) {
        transition main.op >= 0 && main.op < 64 { true -> scan_do(main) _ -> scan_advance(main) }
    }
    state scan_do(main: &mut Main) {
        // The clamp is the identity on the [0,7] window and proves the shift
        // count below 32.
        main.nv = (90i32 >> min_i32(max_i32(main.window, 0), 7)) & 1; // Rule 90: next = left XOR right
        main.next[main.op] = main.nv;
        transition { _ -> scan_advance(main) }
    }
    // Re-guard before the head advance: `rp < 65` on the direct edge proves the
    // increment into [0..=65] (the prior `op = rp` write is disjoint).
    state scan_advance(main: &mut Main) {
        main.op = main.rp;
        transition main.rp < 65 { true -> rp_bump(main) _ -> scan_loop(main) }
    }
    state rp_bump(main: &mut Main) {
        main.rp = main.rp + 1;
        transition { _ -> scan_loop(main) }
    }

    // --- copy next -> cells (via a field temp; a direct cells[x]=next[x] is refused) ---
    state copy_init(main: &mut Main) {
        main.x = 0;
        transition { _ -> copy_loop(main) }
    }
    state copy_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 64 { true -> copy_cell(main) _ -> gen_next(main) }
    }
    state copy_cell(main: &mut Main) {
        main.cv = main.next[main.x];
        transition main.x >= 0 && main.x < 64 { true -> copy_put(main) _ -> bad(main) }
    }
    state copy_put(main: &mut Main) {
        main.cells[main.x] = main.cv;
        main.x = main.x + 1;
        transition { _ -> copy_loop(main) }
    }
    // Sleep first (the host call would kill facts), then re-guard `gen < 32`
    // so the increment proves into [0..=32].
    state gen_next(main: &mut Main) {
        Clock::sleep(50);
        transition main.gen < 32 { true -> gen_bump(main) _ -> gen_loop(main) }
    }
    state gen_bump(main: &mut Main) {
        main.gen = main.gen + 1;
        transition { _ -> gen_loop(main) }
    }

    state finish(main: &mut Main) {
        Console::write_line("done: 32 generations of Rule 90 rendered (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: a cell value or index left its guarded range (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
