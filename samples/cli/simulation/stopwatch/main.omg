// Stopwatch with split/lap commands as case payloads.
//
// Stresses: case members (Tick, Lap, Split), payload-bound i32 args,
// [copy] property, accumulated scalar writes, value-position
// calls returning i32.
//
// Commands:
//   Tick(n)  -- advance time by n ticks
//   Lap      -- record current time as a lap (resets elapsed to 0)
//   Split    -- snapshot current time (does not reset elapsed)
//
// Scripted sequence:
//   Tick(10)  -> elapsed=10, total=10
//   Split     -> split=10,   elapsed=10, total=10
//   Tick(20)  -> elapsed=30, total=30
//   Lap       -> lap=30,     elapsed=0,  total=30
//   Tick(15)  -> elapsed=15, total=45
//   Tick(25)  -> elapsed=40, total=70
//   Split     -> split=40,   elapsed=40, total=70
//
// Final: total==70, split==40, lap==30, elapsed==40. Exit 70 when correct.
//
// Expected exit: 70.

use omega_language_std::console;

data Command {
    case Tick(n: i32 in Saturating);
    case Lap;
    case Split;
}

data Watch [copy] {
    elapsed: i32 in Saturating;
    total: i32 in Saturating;
    last_lap: i32 in Saturating;
    last_split: i32 in Saturating;
}

data Main {
    watch: Watch;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("stopwatch: replays tick/lap/split commands against a stopwatch machine");
    Main::send(main, Command::Tick { n: 10 });
    Main::send(main, Command::Split);
    Main::send(main, Command::Tick { n: 20 });
    Main::send(main, Command::Lap);
    Main::send(main, Command::Tick { n: 15 });
    Main::send(main, Command::Tick { n: 25 });
    Main::send(main, Command::Split);

    // total==70, split==40, lap==30, elapsed==40.
    transition main.watch.total == 70 {
        true -> check_split(main)
        _ -> bad_total(main)
    }

    state check_split(main: &mut Main) {
        transition main.watch.last_split == 40 {
            true -> check_lap(main)
            _ -> bad_split(main)
        }
    }

    state check_lap(main: &mut Main) {
        transition main.watch.last_lap == 30 {
            true -> check_elapsed(main)
            _ -> bad_lap(main)
        }
    }

    state check_elapsed(main: &mut Main) {
        transition main.watch.elapsed == 40 {
            true -> good(main)
            _ -> bad_elapsed(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: total=70, split=40, lap=30, elapsed=40 all verified (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state bad_total(main: &mut Main) {
        Console::write_line("FAIL: total was not 70 after the command script (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
    state bad_split(main: &mut Main) {
        Console::write_line("FAIL: last split was not 40 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }
    state bad_lap(main: &mut Main) {
        Console::write_line("FAIL: last lap was not 30 (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }
    state bad_elapsed(main: &mut Main) {
        Console::write_line("FAIL: elapsed was not 40 (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }
}

// Apply a command to the stopwatch.
machine Main::send(main: &mut Main, cmd: Command) {
    transition cmd {
        Command::Tick { n } -> do_tick(main, n)
        Command::Lap -> do_lap(main)
        Command::Split -> do_split(main)
        _ -> done()
    }

    state do_tick(main: &mut Main, n: i32 in Saturating) {
        main.watch.elapsed = main.watch.elapsed + n;
        main.watch.total = main.watch.total + n;
    }

    state do_lap(main: &mut Main) {
        main.watch.last_lap = main.watch.elapsed;
        main.watch.elapsed = 0;
    }

    state do_split(main: &mut Main) {
        main.watch.last_split = main.watch.elapsed;
    }

    state done() {}
}
