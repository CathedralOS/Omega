// Count matching elements with one statically selected predicate, without
// copying the elements or fixing the input extent.
// Expected exit: 0.

use omega::language::core::option;

machine find<'input, T, Context, machine Predicate>(values: &'input [T], context: &Context) -> Optional<&'input T>
where machine Predicate(value: &T, context: &Context) -> bool;
{
    transition { _ -> next(values, context, 0) }
    machine next(values: &'input [T], context: &Context, position: u64) -> Optional<&'input T>
    requires position <= values.len
    {
        transition position < values.len {
            true -> inspect(values, context, position)
            false -> Optional::None
        }
    }
    machine inspect(values: &'input [T], context: &Context, position: u64) -> Optional<&'input T>
    requires position < values.len
    {
        transition Predicate(&values[position], context) {
            true -> Optional::Some { value: &values[position] }
            false -> next(values, context, position + 1)
        }
    }
}

machine count<T, machine Predicate>(values: &[T]) -> u64
where machine Predicate(value: &T) -> bool;
{
    transition { _ -> next(values, 0, 0) }
    machine next(values: &[T], position: u64, matched: u64) -> u64
    requires matched <= position && position <= values.len
    {
        transition position < values.len {
            true -> inspect(values, position, matched)
            false -> (matched)
        }
    }
    machine inspect(values: &[T], position: u64, matched: u64) -> u64
    requires matched <= position && position < values.len
    {
        transition Predicate(&values[position]) {
            true -> next(values, position + 1, matched + 1)
            false -> next(values, position + 1, matched)
        }
    }
}

machine positive(value: &i32) -> bool { value > 0 }
machine nonzero(value: &u8) -> bool { value != 0 }

data Record { key: u64; selected: bool; }
machine selected(value: &Record) -> bool { value.selected }

data Batch<T, const Capacity: u64> { values: [T; Capacity]; }

machine count_batch<T, const Capacity: u64, machine Predicate>(batch: &Batch<T, Capacity>) -> u64
where machine Predicate(value: &T) -> bool;
{
    count<Predicate>(&batch.values)
}

machine count_with_context<T, Context, machine Predicate>(values: &[T], context: &Context) -> u64
where machine Predicate(value: &T, context: &Context) -> bool;
{
    transition { _ -> next(values, context, 0, 0) }
    machine next(values: &[T], context: &Context, position: u64, matched: u64) -> u64
    requires matched <= position && position <= values.len
    {
        transition position < values.len {
            true -> inspect(values, context, position, matched)
            false -> (matched)
        }
    }
    machine inspect(values: &[T], context: &Context, position: u64, matched: u64) -> u64
    requires matched <= position && position < values.len
    {
        transition Predicate(&values[position], context) {
            true -> next(values, context, position + 1, matched + 1)
            false -> next(values, context, position + 1, matched)
        }
    }
}

data Selection<T> { minimum: T; maximum: T; }
machine within(value: &i32, context: &Selection<i32>) -> bool {
    value >= context.minimum && value <= context.maximum
}

machine value_or_missing(found: Optional<&i32>) -> i32 {
    transition found {
        Optional::Some { value } -> (value)
        Optional::None -> -100
    }
}

machine main() crashes Trap {
    let signed: [i32; 5] = [-3, 7, 0, -1, 9];
    let bytes: [u8; 4] = [0, 255, 1, 0];
    let records: [Record; 3] = [
        Record { key: 0, selected: true },
        Record { key: 18446744073709551615, selected: false },
        Record { key: 7, selected: true }
    ];
    let positives: u64 = count<positive>(&signed);
    let nonzeros: u64 = count<nonzero>(&bytes);
    let selections: u64 = count<selected>(&records);
    let empty: u64 = count<positive>(signed[..0]);
    let suffix: u64 = count<positive>(signed[2..]);
    let batch: Batch<i32, 3> = Batch { values: [0, 1, 2] };
    let batched: u64 = count_batch<positive>(&batch);
    let limits: Selection<i32> = Selection { minimum: -1, maximum: 7 };
    let bounded: u64 = count_with_context<within>(&signed, &limits);
    let first: Optional<&i32> = find<within>(&signed, &limits);
    let first_value: i32 = value_or_missing(first);
    transition positives == 2 && nonzeros == 2 && selections == 2
        && empty == 0 && suffix == 1 && batched == 2 && bounded == 3 && first_value == 7 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
