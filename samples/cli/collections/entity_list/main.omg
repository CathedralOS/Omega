// The entity/particle-list pattern: an array of structs `[Monster; N]` updated by a
// runtime-indexed loop -- the shape every simulation and game needs. Each pass reads
// a field of `monsters[i]`, transforms it, and writes it back.
//
// Note the field-temp idiom: `monsters[i].hp` reads and writes DIRECTLY (into/out of
// a scalar field), but using `monsters[i].hp` as an ARITHMETIC OPERAND (e.g.
// `monsters[i].hp - 10` in one expression) is not yet lowerable -- so the update
// copies the field into a scalar (`scratch`), does the arithmetic there, and writes
// `scratch` back. Direct indexed read, direct indexed write, and the counter loop all
// lower natively.
//
// Four monsters take 10 damage each (30->20, 12->2, 25->15, 8->-2 under `Wrapping`),
// then their HP is summed: 20 + 2 + 15 + (-2) = 35. Exit: 35.
// Expected exit: 35.

use omega_language_std::console;

data Monster {
    hp: i32 in Wrapping;
}

data Main {
    monsters: [Monster; 4];
    i: i32 in Wrapping;
    scratch: i32 in Wrapping;
    total: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("entity_list: [Monster; 4] -- deal 10 damage to each, then sum HP");
    main.monsters[0].hp = 30;
    main.monsters[1].hp = 12;
    main.monsters[2].hp = 25;
    main.monsters[3].hp = 8;
    main.i = 0;
    transition { _ -> damage_loop(main) }

    state damage_loop(main: &mut Main) {
        transition main.i < 4 { true -> damage_one(main) _ -> sum_start(main) }
    }
    state damage_one(main: &mut Main) {
        main.scratch = main.monsters[main.i].hp; // direct indexed read into a scalar
        main.scratch = main.scratch - 10;        // arithmetic on the scalar field
        main.monsters[main.i].hp = main.scratch; // direct indexed write-back
        main.i = main.i + 1;
        transition { _ -> damage_loop(main) }
    }

    state sum_start(main: &mut Main) {
        main.i = 0;
        main.total = 0;
        transition { _ -> sum_loop(main) }
    }
    state sum_loop(main: &mut Main) {
        transition main.i < 4 { true -> sum_one(main) _ -> done(main) }
    }
    state sum_one(main: &mut Main) {
        main.scratch = main.monsters[main.i].hp;
        main.total = main.total + main.scratch;
        main.i = main.i + 1;
        transition { _ -> sum_loop(main) }
    }

    state done(main: &mut Main) {
        Console::write_line("result: total remaining HP is the exit code (35)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.total as i32);
    }
}
