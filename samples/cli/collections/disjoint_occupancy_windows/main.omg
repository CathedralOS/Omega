// Two resource windows of one occupancy row, lent across a state edge.
// The field pair leaves main; the later state builds its own row and lends
// that too. Writes through either window are the row's own cells.
// Expected exit: 0
// Expected output contains: 3 9 5 7
use omega_language_std::console;

data Occupancy { cells: [i32 in Wrapping; 4]; }
data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let mut occupancy: Occupancy;
    occupancy.cells = [0, 0, 0, 0];
    let ready: bool = true;
    transition ready {
        true -> field_windows(main, &mut occupancy.cells[0..2], &mut occupancy.cells[2..4])
        _ -> bad(main)
    }
    state field_windows(main: &mut Main, left: &mut [i32 in Wrapping], right: &mut [i32 in Wrapping])
    requires left.len >= 1 && right.len >= 1
    {
        left[0] = 3;
        right[0] = 9;
        Console::write_byte((48 + left[0]) as i32);
        Console::write(" ");
        Console::write_byte((48 + right[0]) as i32);
        Console::write(" ");
        transition { _ -> build(main) }
    }
    state build(main: &mut Main) {
        let mut row: [i32 in Wrapping; 4] = [0, 0, 0, 0];
        transition { _ -> local_windows(main, &mut row[0..2], &mut row[2..4]) }
    }
    state local_windows(main: &mut Main, left: &mut [i32 in Wrapping], right: &mut [i32 in Wrapping])
    requires left.len >= 1 && right.len >= 1
    {
        left[0] = 5;
        right[0] = 7;
        Console::write_byte((48 + left[0]) as i32);
        Console::write(" ");
        Console::write_byte((48 + right[0]) as i32);
        Console::write_line("");
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("BAD");
        Console::exit_process(2);
    }
}
