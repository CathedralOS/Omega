// Find the maximum element of an array -- a small but real data-processing loop
// that exercises capabilities that just landed together: a bounded loop, a
// RUNTIME-indexed array read (`self.nums[self.i]`, the loop head's `self.i < N`
// proving the body's index across the state edge), and a conditional update.
//
//   max = 0
//   for i in 0..N: if nums[i] > max: max = nums[i]
//
// Over [4, 15, 8, 42, 16, 23] the maximum (at index 3, not the last) is 42.
// Expected exit: 42.

use omega_language_std::console;

data Main {
    console: Console;
    nums: [i32; 6];
    i: i32 [0..=6];
    cur: i32;
    max: i32;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("array_max: scan [4, 15, 8, 42, 16, 23] with a runtime-indexed bounded loop to find the maximum");
    self.nums[0] = 4;
    self.nums[1] = 15;
    self.nums[2] = 8;
    self.nums[3] = 42;
    self.nums[4] = 16;
    self.nums[5] = 23;
    self.i = 0;
    self.max = 0;

    transition {
        _ -> step()
    }

    // Loop head: scan until every element has been visited.
    state step(&mut self) {
        transition self.i < 6 {
            true -> body()
            _ -> done()
        }
    }

    // Read the current element; keep it if it beats the running maximum.
    state body(&mut self) {
        self.cur = self.nums[self.i];
        transition self.cur > self.max {
            true -> keep()
            _ -> advance()
        }
    }

    state keep(&mut self) {
        self.max = self.cur;
        transition {
            _ -> advance()
        }
    }

    // Re-guard before the increment: the `i < 6` fact on the DIRECT edge into
    // `bump` proves `i + 1` stays within [0..=6] -- fully Exact, no domain.
    state advance(&mut self) {
        transition self.i < 6 {
            true -> bump()
            _ -> step()
        }
    }

    state bump(&mut self) {
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.write_line("result: the maximum, 42 for this dataset (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.max);
    }
}
