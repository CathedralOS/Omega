// Intended-invalid control: calling DisjointSet::find on an out-of-range
// element (64, violating element < 64) must be rejected at compile time.

use omega_language_std::console;

data DisjointSet {
    parent: [u64; 64];
}

data Main {
    sets: DisjointSet;
}

machine DisjointSet::find(sets: &mut DisjointSet, element: u64) -> u64
requires element < 64
ensures result < 64
{
    sets.parent[element]
}

machine Main::main(main: &mut Main) reaches Console {
    let invalid_rep: u64 = DisjointSet::find(&mut main.sets, 64);
    Console::exit_process(invalid_rep as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
