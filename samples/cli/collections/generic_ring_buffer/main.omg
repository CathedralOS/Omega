// Fixed-capacity ring buffer over [i32 in Saturating; 8].
//
// Demonstrates: const-dispatch indexed read/write on a fixed array (the proven
// pattern for runtime-indexed array access), modular head/tail arithmetic,
// case members for push/pop commands, and multi-level guard ladders.
//
// Operations scripted:
//   push(20) -> slots[0]=20, tail=1, size=1
//   push(30) -> slots[1]=30, tail=2, size=2
//   push(40) -> slots[2]=40, tail=3, size=3
//   push(50) -> slots[3]=50, tail=4, size=4
//   pop      -> last_pop=20, head=1, size=3
//   push(5)  -> slots[4]=5,  tail=5, size=4
//   push(15) -> slots[5]=15, tail=6, size=5
//   pop      -> last_pop=30, head=2, size=4
//   pop      -> last_pop=40, head=3, size=3
//
// Final state: head=3, tail=6, size=3.
//   slots[3]=50, slots[4]=5, slots[5]=15 -> sum=70.
//
// Verification:
//   size == 3            (3 elements remain)
//   last_pop == 40       (last popped value)
//   slots[3]+slots[4]+slots[5] == 70
//
// Expected exit: 70.

use omega_language_std::console;

data Ring [copy] {
    slots: [i32 in Saturating; 8];
    head: i32 in Saturating;
    tail: i32 in Saturating;
    size: i32 in Saturating;
    last_pop: i32 in Saturating;
}

data Main {
    console: Console;
    ring: Ring;
    pause: [u8; 256];
}

// ---------------------------------------------------------------------------
// push(value): write value at slots[tail], then advance tail mod 8, size++.
// Uses a dispatch chain because tail is a runtime value.
// ---------------------------------------------------------------------------
machine Main::push(&mut self, value: i32 in Saturating) {
    let t: i32 in Saturating = self.ring.tail;
    self.ring.size = self.ring.size + 1;
    // Advance tail mod 8.
    transition t == 7 {
        true -> tail_wrap(value, t)
        _ -> tail_advance(value, t)
    }

    state tail_wrap(&mut self, value: i32 in Saturating, t: i32 in Saturating) {
        self.ring.tail = 0;
        self.write_slot(t, value);
    }

    state tail_advance(&mut self, value: i32 in Saturating, t: i32 in Saturating) {
        self.ring.tail = t + 1;
        self.write_slot(t, value);
    }
}

// Dispatch write to const-indexed slot. Necessary because native does not yet
// support runtime-indexed array writes directly.
machine Main::write_slot(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
    transition idx == 0 {
        true -> w0(value)
        _ -> try_w1(idx, value)
    }

    state w0(&mut self, value: i32 in Saturating) { self.ring.slots[0] = value; }

    state try_w1(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 1 {
            true -> w1(value)
            _ -> try_w2(idx, value)
        }
    }

    state w1(&mut self, value: i32 in Saturating) { self.ring.slots[1] = value; }

    state try_w2(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 2 {
            true -> w2(value)
            _ -> try_w3(idx, value)
        }
    }

    state w2(&mut self, value: i32 in Saturating) { self.ring.slots[2] = value; }

    state try_w3(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 3 {
            true -> w3(value)
            _ -> try_w4(idx, value)
        }
    }

    state w3(&mut self, value: i32 in Saturating) { self.ring.slots[3] = value; }

    state try_w4(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 4 {
            true -> w4(value)
            _ -> try_w5(idx, value)
        }
    }

    state w4(&mut self, value: i32 in Saturating) { self.ring.slots[4] = value; }

    state try_w5(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 5 {
            true -> w5(value)
            _ -> try_w6(idx, value)
        }
    }

    state w5(&mut self, value: i32 in Saturating) { self.ring.slots[5] = value; }

    state try_w6(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 6 {
            true -> w6(value)
            _ -> w7(value)
        }
    }

    state w6(&mut self, value: i32 in Saturating) { self.ring.slots[6] = value; }
    state w7(&mut self, value: i32 in Saturating) { self.ring.slots[7] = value; }
}

// ---------------------------------------------------------------------------
// pop: read slots[head] into last_pop, advance head mod 8, size--.
// ---------------------------------------------------------------------------
machine Main::pop(&mut self) {
    let h: i32 in Saturating = self.ring.head;
    self.ring.size = self.ring.size - 1;
    // Advance head mod 8.
    transition h == 7 {
        true -> head_wrap(h)
        _ -> head_advance(h)
    }

    state head_wrap(&mut self, h: i32 in Saturating) {
        self.ring.head = 0;
        self.read_slot(h);
    }

    state head_advance(&mut self, h: i32 in Saturating) {
        self.ring.head = h + 1;
        self.read_slot(h);
    }
}

// Dispatch read from const-indexed slot into self.ring.last_pop.
machine Main::read_slot(&mut self, idx: i32 in Saturating) {
    transition idx == 0 {
        true -> r0()
        _ -> try_r1(idx)
    }

    state r0(&mut self) { self.ring.last_pop = self.ring.slots[0]; }

    state try_r1(&mut self, idx: i32 in Saturating) {
        transition idx == 1 {
            true -> r1()
            _ -> try_r2(idx)
        }
    }

    state r1(&mut self) { self.ring.last_pop = self.ring.slots[1]; }

    state try_r2(&mut self, idx: i32 in Saturating) {
        transition idx == 2 {
            true -> r2()
            _ -> try_r3(idx)
        }
    }

    state r2(&mut self) { self.ring.last_pop = self.ring.slots[2]; }

    state try_r3(&mut self, idx: i32 in Saturating) {
        transition idx == 3 {
            true -> r3()
            _ -> try_r4(idx)
        }
    }

    state r3(&mut self) { self.ring.last_pop = self.ring.slots[3]; }

    state try_r4(&mut self, idx: i32 in Saturating) {
        transition idx == 4 {
            true -> r4()
            _ -> try_r5(idx)
        }
    }

    state r4(&mut self) { self.ring.last_pop = self.ring.slots[4]; }

    state try_r5(&mut self, idx: i32 in Saturating) {
        transition idx == 5 {
            true -> r5()
            _ -> try_r6(idx)
        }
    }

    state r5(&mut self) { self.ring.last_pop = self.ring.slots[5]; }

    state try_r6(&mut self, idx: i32 in Saturating) {
        transition idx == 6 {
            true -> r6()
            _ -> r7()
        }
    }

    state r6(&mut self) { self.ring.last_pop = self.ring.slots[6]; }
    state r7(&mut self) { self.ring.last_pop = self.ring.slots[7]; }
}

// ---------------------------------------------------------------------------
// main: run the scripted sequence, then verify the expected final state.
// ---------------------------------------------------------------------------
machine Main::main(&mut self) {
    self.console.write_line("generic_ring_buffer: pushes and pops through a fixed 8-slot ring");
    self.push(20);
    self.push(30);
    self.push(40);
    self.push(50);
    self.pop();          // pops 20; head=1
    self.push(5);
    self.push(15);
    self.pop();          // pops 30; head=2
    self.pop();          // pops 40; head=3; last_pop=40

    // Verify size == 3.
    transition self.ring.size == 3 {
        true -> check_last_pop()
        _ -> bad_size()
    }

    state check_last_pop(&mut self) {
        // last popped value should be 40.
        transition self.ring.last_pop == 40 {
            true -> check_sum()
            _ -> bad_pop()
        }
    }

    state check_sum(&mut self) {
        // Remaining elements: slots[3]=50, slots[4]=5, slots[5]=15 -> sum=70.
        let sum: i32 in Saturating = self.ring.slots[3] + self.ring.slots[4] + self.ring.slots[5];
        transition sum == 70 {
            true -> good()
            _ -> bad_sum()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: size=3, last pop 40, remaining sum 70 (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad_size(&mut self) {
        self.console.write_line("FAIL: wrong ring size (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state bad_pop(&mut self) {
        self.console.write_line("FAIL: wrong last-popped value (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state bad_sum(&mut self) {
        self.console.write_line("FAIL: wrong sum of remaining slots (exit 73)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }
}
