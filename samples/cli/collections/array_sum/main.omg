use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Overflow-safe reduction: sum a [i32; N] array into an i64 accumulator so a
// total that would overflow i32 is still correct. 2_000_000_000 + 200_000_000 =
// 2_200_000_000 exceeds i32's max (2_147_483_647); widening each element to i64
// first keeps the running total in range. The result is checked to equal 2.2e9.
//
// The element is read and widened INLINE through `widen_i32_to_i64`, then the
// Exact result is qualified `in Wrapping` to match the accumulator's arithmetic
// domain. Wrapping is DECLARED on the accumulator because array elements carry
// no range facts yet, so the sum cannot prove its bounds; the loop counter is a
// guard-proven Exact i32.
//
// Expected exit: 70.

use system\Console;
use omega\language\core\widen_i32_to_i64;

data Main
requires
    0 <= self.i && self.i <= 2
{
    nums: [i32; 2];
    i: i32;
    sum: i64 in Wrapping; // Wrapping DECLARED: sums array elements, which carry no range facts yet.
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("array_sum: overflow-safe reduction -- i32 elements widened to an i64 accumulator");
    main.nums[0] = 0x7735_9400;
    main.nums[1] = 0x0BEB_C200;
    main.i = 0;
    main.sum = 0i64 as +Wrapping;

    transition {
        _ -> block step(main)
    }

    machine step(main: @mutable Main) {
        transition main.i < 2 {
            true -> block add(main),
            _ -> block done(main)
        }
    }

    machine add(main: @mutable Main) {
        main.sum =
            main.sum
            + (widen_i32_to_i64(main.nums[main.i]) as i64 +Wrapping);
        main.i = main.i + 1;
        transition {
            _ -> block step(main)
        }
    }

    machine done(main: @mutable Main) {
        transition main.sum == 0x8321_5600 {
            true -> block good(main),
            _ -> block bad(main)
        }
    }

    machine good(main: @mutable Main) {
        Console::write_line("PASS: sum == 2200000000 -- past i32 max, correct in i64 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(70);
    }

    machine bad(main: @mutable Main) {
        Console::write_line("FAIL: sum != 2200000000 -- widening reduction wrong (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
