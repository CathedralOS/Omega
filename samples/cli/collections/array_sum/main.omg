// Overflow-safe reduction: sum a [i32; N] array into an i64 accumulator so a
// total that would overflow i32 is still correct. 2_000_000_000 + 200_000_000 =
// 2_200_000_000 exceeds i32's max (2_147_483_647); widening each element to i64
// first keeps the running total in range. The result is checked to equal 2.2e9.
//
// The element is read and widened INLINE through `widen_i32_to_i64`, then the
// Exact result is qualified `in Wrapping` to match the accumulator's arithmetic
// domain. Wrapping is DECLARED on the accumulator because array elements carry
// no range facts yet, so the sum cannot prove its bounds; the loop counter is a
// guard-proven Exact i32.
//
// Expected exit: 70.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    nums: [i32; 2];
    i: i32;
    sum: i64 in Wrapping; // Wrapping DECLARED: sums array elements, which carry no range facts yet.
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("array_sum: overflow-safe reduction -- i32 elements widened to an i64 accumulator");
    main.nums[0] = 2000000000;
    main.nums[1] = 200000000;
    main.i = 0;
    main.sum = 0;

    transition {
        _ -> step(main)
    }

    state step(main: &mut Main) {
        transition main.i < 2 {
            true -> add(main)
            _ -> done(main)
        }
    }

    state add(main: &mut Main) {
        main.sum =
            main.sum
            + (widen_i32_to_i64(main.nums[main.i]) as i64 in Wrapping);
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }

    state done(main: &mut Main) {
        transition main.sum == 2200000000 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: sum == 2200000000 -- past i32 max, correct in i64 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::write_line("FAIL: sum != 2200000000 -- widening reduction wrong (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
