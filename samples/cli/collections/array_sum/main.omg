// Overflow-safe reduction: sum a [i32; N] array into an i64 accumulator so a
// total that would overflow i32 is still correct. 2_000_000_000 + 200_000_000 =
// 2_200_000_000 exceeds i32's max (2_147_483_647); widening each element to i64
// first keeps the running total in range. The result is checked to equal 2.2e9.
//
// The element is read and widened INLINE through `widen_i32_to_i64`, then the
// Exact result is qualified `in Wrapping` to match the accumulator's arithmetic
// domain. Wrapping is DECLARED on the accumulator because array elements carry
// no range facts yet, so the sum cannot prove its bounds; the loop counter is a
// guard-proven Exact range.
//
// Expected exit: 70.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    nums: [i32; 2];
    i: i32 [0..=2];
    sum: i64 in Wrapping; // Wrapping DECLARED: sums array elements, which carry no range facts yet.
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("array_sum: overflow-safe reduction -- i32 elements widened to an i64 accumulator");
    self.nums[0] = 2000000000;
    self.nums[1] = 200000000;
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 2 {
            true -> add()
            _ -> done()
        }
    }

    state add(&mut self) {
        self.sum =
            self.sum
            + (widen_i32_to_i64(self.nums[self.i]) as i64 in Wrapping);
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        transition self.sum == 2200000000 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: sum == 2200000000 -- past i32 max, correct in i64 (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.write_line("FAIL: sum != 2200000000 -- widening reduction wrong (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
