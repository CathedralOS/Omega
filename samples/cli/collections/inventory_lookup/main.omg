// Look up an item by name in a small table of records -- a core serious-app shape
// (name tables, inventories, registries). Each `Item` is a struct with an `id` and
// a `[u8; 8] in Utf8` carrier `name`, stored in a fixed array `items: [Item; 3]`.
// This combines array-of-structs storage, text CARRIERS as record fields, carrier
// content comparison (`==`) inside guards, and array-element value reads (exiting
// `self.items[k].id`). A guard chain searches for "Shield" and returns its id (20).
// Expected exit: 20.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Item {
    id: i32;
    name: [u8; 8] in Utf8;
}

data Main {
    console: Console;
    items: [Item; 3];
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("inventory_lookup: searching a struct table for the item named Shield");
    self.items[0].id = 10;
    self.items[0].name = "Sword";
    self.items[1].id = 20;
    self.items[1].name = "Shield";
    self.items[2].id = 30;
    self.items[2].name = "Potion";

    transition self.items[0].name == "Shield" {
        true -> found0()
        _ -> check1()
    }

    state check1(&mut self) {
        transition self.items[1].name == "Shield" { true -> found1() _ -> check2() }
    }
    state check2(&mut self) {
        transition self.items[2].name == "Shield" { true -> found2() _ -> missing() }
    }

    state found0(&mut self) {
        self.console.write_line("FAIL: matched the wrong slot 0, Sword (exits its id, 10)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.items[0].id);
    }
    state found1(&mut self) {
        self.console.write_line("PASS: found Shield at slot 1, id 20 (exit 20)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.items[1].id);
    }
    state found2(&mut self) {
        self.console.write_line("FAIL: matched the wrong slot 2, Potion (exits its id, 30)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.items[2].id);
    }
    state missing(&mut self) {
        self.console.write_line("FAIL: Shield not found in the table (exit 0)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(0);
    }
}
