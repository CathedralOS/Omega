// Look up an item by name in a small table of records -- a core serious-app shape
// (name tables, inventories, registries). Each `Item` is a struct with an `id` and
// a `&[u8] in Utf8` view `name`, stored in a fixed array `items: [Item; 3]`.
// This combines array-of-structs storage, literal-backed views as record fields, carrier
// content comparison (`==`) inside guards, and array-element value reads (exiting
// `main.items[k].id`). A guard chain searches for "Shield" and returns its id (20).
// Expected exit: 20.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Item {
    id: i32;
    name: &[u8] in Utf8;
}

data Main {
    items: [Item; 3];
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("inventory_lookup: searching a struct table for the item named Shield");
    main.items[0].id = 10;
    main.items[0].name = "Sword";
    main.items[1].id = 20;
    main.items[1].name = "Shield";
    main.items[2].id = 30;
    main.items[2].name = "Potion";

    transition main.items[0].name == "Shield" {
        true -> found0(main)
        _ -> check1(main)
    }

    state check1(main: &mut Main) {
        transition main.items[1].name == "Shield" { true -> found1(main) _ -> check2(main) }
    }
    state check2(main: &mut Main) {
        transition main.items[2].name == "Shield" { true -> found2(main) _ -> missing(main) }
    }

    state found0(main: &mut Main) {
        Console::write_line("FAIL: matched the wrong slot 0, Sword (exits its id, 10)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.items[0].id);
    }
    state found1(main: &mut Main) {
        Console::write_line("PASS: found Shield at slot 1, id 20 (exit 20)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.items[1].id);
    }
    state found2(main: &mut Main) {
        Console::write_line("FAIL: matched the wrong slot 2, Potion (exits its id, 30)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.items[2].id);
    }
    state missing(main: &mut Main) {
        Console::write_line("FAIL: Shield not found in the table (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
}
