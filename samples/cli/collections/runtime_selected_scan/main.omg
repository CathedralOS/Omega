// Expected exit: 0.
// Runtime implementation selection must preserve the borrowed result's backing.
use omega::language::core::option;

trait Scan<T> {
    machine first(values: &[T], threshold: T) -> Optional<&T>;
}

machine at_least(value: &i32, threshold: i32) -> bool { value >= threshold }
machine below(value: &i32, threshold: i32) -> bool { value < threshold }

machine search<'input, machine Compare>(values: &'input [i32], threshold: i32)
    -> Optional<&'input i32>
where machine Compare(value: &i32, threshold: i32) -> bool;
{
    transition { _ -> next(values, threshold, 0) }

    machine next(values: &'input [i32], threshold: i32, position: u64)
        -> Optional<&'input i32>
    requires position <= values.len {
        transition position < values.len {
            true -> inspect(values, threshold, position)
            false -> Optional::None
        }
    }

    machine inspect(values: &'input [i32], threshold: i32, position: u64)
        -> Optional<&'input i32>
    requires position < values.len {
        transition Compare(&values[position], threshold) {
            true -> Optional::Some { value: &values[position] }
            false -> next(values, threshold, position + 1)
        }
    }
}

AtLeast satisfies Scan<i32> {
    machine first(values: &[i32], threshold: i32) -> Optional<&i32> {
        search<at_least>(values, threshold)
    }
}

Below satisfies Scan<i32> {
    machine first(values: &[i32], threshold: i32) -> Optional<&i32> {
        search<below>(values, threshold)
    }
}

machine scan<'input>(selected: dyn Scan<i32>, values: &'input [i32], threshold: i32)
    -> Optional<&'input i32>
{
    Scan::first(selected, values, threshold)
}

machine observed(found: Optional<&i32>) -> i32 {
    transition found {
        Optional::Some { value } -> (value)
        Optional::None -> -100
    }
}

machine main() crashes Trap {
    let values: [i32; 5] = [-3, 7, 0, -1, 9];
    let mut selected: dyn Scan<i32> = AtLeast as dyn Scan<i32>;
    let high: Optional<&i32> = scan(selected, &values, 6);
    selected = Below as dyn Scan<i32>;
    let low: Optional<&i32> = scan(selected, &values, 0);
    let empty: Optional<&i32> = scan(selected, values[..0], 0);
    let absent: Optional<&i32> = scan(selected, &values, -10);
    let suffix: Optional<&i32> = scan(selected, values[2..], 0);
    transition observed(high) == 7 && observed(low) == -3
        && observed(empty) == -100 && observed(absent) == -100
        && observed(suffix) == -1 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
