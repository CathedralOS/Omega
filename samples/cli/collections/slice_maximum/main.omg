use omega_language_std::math;

// Maximum of a slice by tail recursion over a shrinking window. find_max walks
// the slice, carrying the largest value seen so far; for [3, 7, 2, 9, 4] the answer
// is 9. Showcases three things: the `max` builtin, slice iteration via the
// shrinking-window idiom (`s[1..]`), and the bounds proof -- `s[0]` is read in the
// `s.len > 0` guard's TRUE ARM, so the guard discharges the index in the same
// transition (a read in a separate state would not carry the `len > 0` fact).
// Expected exit: 9.

use omega_language_std::console;

machine find_max(s: &[i32], current: i32) -> i32 {
    transition s.len > 0 {
        true -> find_max(s[1..], max_i32(current, s[0]))
        false -> (current)
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("slice_maximum: tail-recursive max over the slice [3, 7, 2, 9, 4]");
    let values: [i32; 5] = [3, 7, 2, 9, 4];

    let s: &[i32] = &values[..];
    let m: i32 = find_max(s, 0);
    Console::write_line("result: the slice maximum, 9 for this data (the exit code)");
    Console::write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block Console::read_line(&mut pause);
    Console::exit_process(m);
}
