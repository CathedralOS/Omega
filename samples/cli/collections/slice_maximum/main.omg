use {omega}/language/core/math.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

// Maximum of a slice by tail recursion over a shrinking window. find_max walks
// the slice, carrying the largest value seen so far; for [3, 7, 2, 9, 4] the answer
// is 9. Showcases three things: the `max` builtin, slice iteration via the
// shrinking-window idiom (`s[1..]`), and the bounds proof -- `s[0]` is read in the
// `s.length > 0` guard's TRUE ARM, so the guard discharges the index in the same
// transition (a read in a separate state would not carry the `len > 0` fact).
// Expected exit: 9.


machine find_max(s: @[i32], current: i32) -> i32 {
    transition s.length > 0 {
        true -> find_max(s[1..], |math|::max_i32(current, s[0])),
        false -> (current)
    }
}

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("slice_maximum: tail-recursive max over the slice [3, 7, 2, 9, 4]");
    let values: [i32; 5] = [3, 7, 2, 9, 4];

    let s: @[i32] = @values[..];
    let m: i32 = find_max(s, 0);
    |console|::Console::write_line("result: the slice maximum, 9 for this data (the exit code)");
    |console|::Console::write_line("[press Enter to close]");
    let mutable pause: [u8; 256];
    _ = block |console|::Console::read_line(@mutable pause[..]);
    |process_exit|::ProcessExit::exit_process(m);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
