// Expected exit: 0.
// Stable in-place filtering retains complete records within a borrowed window.
data Event [copy] {
    identifier: u32;
    score: u32;
    active: bool;
    stamp: u64;
}

machine eligible(event: &Event, minimum: u32) -> bool {
    event.active && event.score >= minimum
}

machine at_least(value: &u32, minimum: u32) -> bool { value >= minimum }

machine compact<T [copy], machine Predicate>(events: &mut [T], minimum: u32) -> u64
where machine Predicate(event: &T, minimum: u32) -> bool;
ensures result <= events.len;
{
    transition { _ -> scan(events, minimum, 0, 0) }

    machine scan(events: &mut [T], minimum: u32, cursor: u64, retained: u64) -> u64
    requires retained <= cursor && cursor <= events.len {
        transition cursor < events.len {
            true -> visit(events, minimum, cursor, retained)
            _ -> (retained)
        }
    }

    machine visit(events: &mut [T], minimum: u32, cursor: u64, retained: u64) -> u64
    requires retained <= cursor && cursor < events.len {
        let selected: bool = Predicate(&events[cursor], minimum);
        transition selected {
            true -> keep(events, minimum, cursor, retained)
            _ -> scan(events, minimum, cursor + 1, retained)
        }
    }

    machine keep(events: &mut [T], minimum: u32, cursor: u64, retained: u64) -> u64
    requires retained <= cursor && cursor < events.len {
        events[retained] = events[cursor];
        transition { _ -> scan(events, minimum, cursor + 1, retained + 1) }
    }
}

machine main() crashes Trap {
    let mut events: [Event; 8] = [
        Event { identifier: 90, score: 91, active: false, stamp: 92 },
        Event { identifier: 10, score: 5, active: true, stamp: 100 },
        Event { identifier: 11, score: 20, active: true, stamp: 18446744073709551615 },
        Event { identifier: 12, score: 50, active: false, stamp: 120 },
        Event { identifier: 13, score: 10, active: true, stamp: 9223372036854775808 },
        Event { identifier: 14, score: 30, active: true, stamp: 140 },
        Event { identifier: 15, score: 0, active: false, stamp: 150 },
        Event { identifier: 99, score: 98, active: true, stamp: 97 }
    ];
    let count: u64 = compact<Event, eligible>(&mut events[1..7], 10);
    let first_pass: bool = count == 3
        && events[1].identifier == 11 && events[1].score == 20
        && events[1].active && events[1].stamp == 18446744073709551615
        && events[2].identifier == 13 && events[2].score == 10
        && events[2].active && events[2].stamp == 9223372036854775808
        && events[3].identifier == 14 && events[3].score == 30
        && events[3].active && events[3].stamp == 140;
    let second_count: u64 = compact<Event, eligible>(&mut events[1..1 + count], 25);
    let empty_count: u64 = compact<Event, eligible>(&mut events[4..4], 0);
    let mut scores: [u32; 3] = [10, 20, 30];
    let all_count: u64 = compact<u32, at_least>(&mut scores[..], 10);
    let all_kept: bool = all_count == 3 && scores[0] == 10 && scores[1] == 20 && scores[2] == 30;
    let none_count: u64 = compact<u32, at_least>(&mut scores[..all_count], 40);
    transition first_pass && second_count == 1 && empty_count == 0
        && all_kept && none_count == 0
        && events[1].identifier == 14 && events[1].score == 30
        && events[1].active && events[1].stamp == 140
        && events[0].identifier == 90 && events[0].score == 91
        && !events[0].active && events[0].stamp == 92
        && events[7].identifier == 99 && events[7].score == 98
        && events[7].active && events[7].stamp == 97 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
