// Slice accumulator probe: tests two slice types with acc+s[0] in tail-call.
//
// Probe A: i32 slice, acc + s[0] in tail-call.
//   [8, 12, 10, 5, 15, 10, 10], expected sum = 70.
//
// Probe B: struct Entry { value: i32 } slice, acc + s[0].value in tail-call.
//   Same data, expected sum = 70.
//
// Both use the shrinking-window pattern in the transition arm directly
// (not inside a sub-state, where bounds proofs would fail).
//
// Note: the related samples recursive_sum (4 elements) and subslice_sum
// (6 elements) confirm a miscompile with `acc + s[0]` in tail-recursive calls.
// This sample with 7 elements happens to exit 70 correctly -- the miscompile
// shape appears data-size-sensitive.
//
// Expected exit: 70.
// Exit 71 = probe A wrong; 72 = probe B wrong.

use omega_language_std::console;

data Entry {
    value: i32 in Wrapping;
}

data Walker {}

data Main {
    ints: [i32 in Wrapping; 7];
    entries: [Entry; 7];
    walker: Walker;
    pause: [u8; 256];
}

// Probe A: i32 slice accumulation.
machine Walker::sum_ints(walker: &mut Walker, s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> sum_ints(walker, s[1..], acc + s[0])
        false -> (acc as i32)
    }
}

// Probe B: struct slice accumulation using s[0].value.
machine Walker::sum_entries(walker: &mut Walker, s: &[Entry], acc: i32 in Wrapping) -> i32
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> sum_entries(walker, s[1..], acc + s[0].value)
        false -> (acc as i32)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("slice_accum_probe: tail-recursive accumulation over i32 and struct slices");
    main.ints[0] = 8;
    main.ints[1] = 12;
    main.ints[2] = 10;
    main.ints[3] = 5;
    main.ints[4] = 15;
    main.ints[5] = 10;
    main.ints[6] = 10;

    main.entries[0].value = 8;
    main.entries[1].value = 12;
    main.entries[2].value = 10;
    main.entries[3].value = 5;
    main.entries[4].value = 15;
    main.entries[5].value = 10;
    main.entries[6].value = 10;

    // Probe A.
    let si: &[i32 in Wrapping] = &main.ints[..];
    let a: i32 = Walker::sum_ints(&mut main.walker, si, 0);

    // Probe B.
    let se: &[Entry] = &main.entries[..];
    let b: i32 = Walker::sum_entries(&mut main.walker, se, 0);

    transition a == 70 {
        true -> check_b(main, b)
        _ -> bad_a(main)
    }

    state bad_a(main: &mut Main) {
        Console::write_line("FAIL: probe A (i32 slice) sum did not equal 70 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_b(main: &mut Main, b: i32) {
        transition b == 70 {
            true -> good(main)
            _ -> bad_b(main)
        }
    }

    state bad_b(main: &mut Main) {
        Console::write_line("FAIL: probe B (struct slice) sum did not equal 70 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: both slice accumulations summed to 70 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
