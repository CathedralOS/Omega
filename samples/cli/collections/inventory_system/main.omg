// Inventory system: fixed array of structs with runtime-indexed dispatch,
// plus a value-returning search machine that finds items by id.
//
// Exercises: a [Item; 5] fixed array where items are set via const-dispatch
// write helpers, a value-returning search machine that locates an item by id
// (looping dispatch chain pattern), and arithmetic over the found values.
//
// Data layout:
//   Item [copy] { id: i32 in Saturating; quantity: i32 in Saturating; price: i32 in Saturating; }
//
// Inventory (5 items):
//   items[0] = { id: 1, quantity: 3, price: 10 }   value = 30
//   items[1] = { id: 2, quantity: 5, price: 6  }   value = 30
//   items[2] = { id: 3, quantity: 2, price: 5  }   value = 10
//   items[3] = { id: 4, quantity: 7, price: 1  }   value = 7
//   items[4] = { id: 5, quantity: 1, price: 70 }   value = 70 -- the golden item
//
// Operations:
//   1. Populate all 5 items via const-indexed writes.
//   2. Find item with id=5 (the golden item) using the search machine.
//   3. Compute: found.quantity * found.price = 1 * 70 = 70.
//   4. Also compute total value of all items: 30+30+10+7+70 = 147.
//      Verify total / items[4].price = 147 / 70 = 2 (integer division).
//      Verify total - 77 = 70.
//
// Checks:
//   found.price == 70  -> continues
//   total - 77 == 70   -> exit 70
// Exit 71 = wrong price from search, 72 = wrong total.
//
// Expected exit: 70.

use omega_language_std::console;

data Item [copy] {
    id: i32 in Saturating;
    quantity: i32 in Saturating;
    price: i32 in Saturating;
}

data Inventory [copy] {
    items: [Item; 5];
    total_value: i32 in Saturating;
    found_id: i32 in Saturating;
    found_price: i32 in Saturating;
}

data Main {
    console: Console;
    inv: Inventory;
    pause: [u8; 256];
}

// Set item at each const index (dispatch-based runtime write).
machine Main::set_item(&mut self, idx: i32 in Saturating, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
    transition idx == 0 {
        true -> set0(id, qty, price)
        _ -> try1(idx, id, qty, price)
    }

    state set0(&mut self, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        self.inv.items[0].id = id;
        self.inv.items[0].quantity = qty;
        self.inv.items[0].price = price;
    }

    state try1(&mut self, idx: i32 in Saturating, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        transition idx == 1 {
            true -> set1(id, qty, price)
            _ -> try2(idx, id, qty, price)
        }
    }

    state set1(&mut self, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        self.inv.items[1].id = id;
        self.inv.items[1].quantity = qty;
        self.inv.items[1].price = price;
    }

    state try2(&mut self, idx: i32 in Saturating, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        transition idx == 2 {
            true -> set2(id, qty, price)
            _ -> try3(idx, id, qty, price)
        }
    }

    state set2(&mut self, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        self.inv.items[2].id = id;
        self.inv.items[2].quantity = qty;
        self.inv.items[2].price = price;
    }

    state try3(&mut self, idx: i32 in Saturating, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        transition idx == 3 {
            true -> set3(id, qty, price)
            _ -> set4(id, qty, price)
        }
    }

    state set3(&mut self, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        self.inv.items[3].id = id;
        self.inv.items[3].quantity = qty;
        self.inv.items[3].price = price;
    }

    state set4(&mut self, id: i32 in Saturating, qty: i32 in Saturating, price: i32 in Saturating) {
        self.inv.items[4].id = id;
        self.inv.items[4].quantity = qty;
        self.inv.items[4].price = price;
    }
}

// Find item by id; returns price (0 if not found).
// Uses index-based looping dispatch through 5 items.
machine Main::find_price(&mut self, target_id: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> check0(target_id)
    }

    state check0(&mut self, target_id: i32 in Saturating) {
        let p0: i32 in Saturating = self.inv.items[0].price;
        transition self.inv.items[0].id == target_id {
            true -> (p0)
            _ -> check1(target_id)
        }
    }

    state check1(&mut self, target_id: i32 in Saturating) {
        let p1: i32 in Saturating = self.inv.items[1].price;
        transition self.inv.items[1].id == target_id {
            true -> (p1)
            _ -> check2(target_id)
        }
    }

    state check2(&mut self, target_id: i32 in Saturating) {
        let p2: i32 in Saturating = self.inv.items[2].price;
        transition self.inv.items[2].id == target_id {
            true -> (p2)
            _ -> check3(target_id)
        }
    }

    state check3(&mut self, target_id: i32 in Saturating) {
        let p3: i32 in Saturating = self.inv.items[3].price;
        transition self.inv.items[3].id == target_id {
            true -> (p3)
            _ -> check4(target_id)
        }
    }

    state check4(&mut self, target_id: i32 in Saturating) {
        let p4: i32 in Saturating = self.inv.items[4].price;
        transition self.inv.items[4].id == target_id {
            true -> (p4)
            _ -> (0)
        }
    }
}

machine Main::compute_total(&mut self) {
    // Sum all item values: qty*price for each item.
    let v0: i32 in Saturating = self.inv.items[0].quantity * self.inv.items[0].price;
    let v1: i32 in Saturating = self.inv.items[1].quantity * self.inv.items[1].price;
    let v2: i32 in Saturating = self.inv.items[2].quantity * self.inv.items[2].price;
    let v3: i32 in Saturating = self.inv.items[3].quantity * self.inv.items[3].price;
    let v4: i32 in Saturating = self.inv.items[4].quantity * self.inv.items[4].price;
    self.inv.total_value = v0 + v1 + v2 + v3 + v4;
}

machine Main::main(&mut self) {
    self.console.write_line("inventory_system: populating a 5-item table, then searching and totaling it");
    // Populate inventory.
    self.set_item(0, 1, 3, 10);
    self.set_item(1, 2, 5, 6);
    self.set_item(2, 3, 2, 5);
    self.set_item(3, 4, 7, 1);
    self.set_item(4, 5, 1, 70);

    // Compute total value.
    self.compute_total();

    // Find item id=5 (golden item), which has price=70.
    let p: i32 in Saturating = self.find_price(5);
    self.inv.found_price = p;

    // total_value = 3*10 + 5*6 + 2*5 + 7*1 + 1*70 = 30+30+10+7+70 = 147.
    // total_value - 77 = 70.

    transition self.inv.found_price == 70 {
        true -> check_total()
        _ -> bad_price()
    }

    state bad_price(&mut self) {
        self.console.write_line("FAIL: search returned the wrong price for id 5 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state check_total(&mut self) {
        let adjusted: i32 in Saturating = self.inv.total_value - 77;
        transition adjusted == 70 {
            true -> good()
            _ -> bad_total()
        }
    }

    state bad_total(&mut self) {
        self.console.write_line("FAIL: wrong inventory total value (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state good(&mut self) {
        self.console.write_line("PASS: golden item price 70, total value 147 (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
}
