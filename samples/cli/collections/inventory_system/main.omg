// Inventory system: fixed array of structs with runtime-indexed dispatch,
// plus a value-returning search machine that finds items by id.
//
// Exercises: a [Item; 5] fixed array where items are set via const-dispatch
// write helpers, a value-returning search machine that locates an item by id
// (looping dispatch chain pattern), and arithmetic over the found values.
// The invocation owns the inventory locally; helpers borrow it explicitly.
// Search and total results are values, not persistent inventory fields.
//
// Data layout:
//   Item [copy] { id: i32 in Saturating; quantity: i32 in Saturating; price: i32 in Saturating; }
//
// Inventory (5 items):
//   items[0] = { id: 1, quantity: 3, price: 10 }   value = 30
//   items[1] = { id: 2, quantity: 5, price: 6  }   value = 30
//   items[2] = { id: 3, quantity: 2, price: 5  }   value = 10
//   items[3] = { id: 4, quantity: 7, price: 1  }   value = 7
//   items[4] = { id: 5, quantity: 1, price: 70 }   value = 70 -- the golden item
//
// Operations:
//   1. Populate all 5 items via const-indexed writes.
//   2. Find item with id=5 (the golden item) using the search machine.
//   3. Compute total value of all items: 30+30+10+7+70 = 147.
//      Verify the found price and total - 77 are both 70.
//
// Checks:
//   price == 70        -> continues
//   total - 77 == 70   -> exit 70
// Exit 71 = wrong price from search, 72 = wrong total.
//
// Expected exit: 70.

use omega_language_std::console;

data Item [copy] {
    id: i32 in Saturating;
    quantity: i32 in Saturating;
    price: i32 in Saturating;
}

data Inventory [copy] {
    items: [Item; 5];
}

data Main {
}

// Set item at each const index (dispatch-based runtime write).
machine Inventory::set_item(inventory: &mut Inventory, index: i32 in Saturating, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
    transition index == 0 {
        true -> set0(inventory, id, quantity, price)
        _ -> try1(inventory, index, id, quantity, price)
    }

    state set0(inventory: &mut Inventory, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        inventory.items[0].id = id;
        inventory.items[0].quantity = quantity;
        inventory.items[0].price = price;
    }

    state try1(inventory: &mut Inventory, index: i32 in Saturating, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        transition index == 1 {
            true -> set1(inventory, id, quantity, price)
            _ -> try2(inventory, index, id, quantity, price)
        }
    }

    state set1(inventory: &mut Inventory, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        inventory.items[1].id = id;
        inventory.items[1].quantity = quantity;
        inventory.items[1].price = price;
    }

    state try2(inventory: &mut Inventory, index: i32 in Saturating, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        transition index == 2 {
            true -> set2(inventory, id, quantity, price)
            _ -> try3(inventory, index, id, quantity, price)
        }
    }

    state set2(inventory: &mut Inventory, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        inventory.items[2].id = id;
        inventory.items[2].quantity = quantity;
        inventory.items[2].price = price;
    }

    state try3(inventory: &mut Inventory, index: i32 in Saturating, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        transition index == 3 {
            true -> set3(inventory, id, quantity, price)
            _ -> set4(inventory, id, quantity, price)
        }
    }

    state set3(inventory: &mut Inventory, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        inventory.items[3].id = id;
        inventory.items[3].quantity = quantity;
        inventory.items[3].price = price;
    }

    state set4(inventory: &mut Inventory, id: i32 in Saturating, quantity: i32 in Saturating, price: i32 in Saturating) {
        inventory.items[4].id = id;
        inventory.items[4].quantity = quantity;
        inventory.items[4].price = price;
    }
}

// Find item by id; returns price (0 if not found).
// Uses index-based looping dispatch through 5 items.
machine Inventory::find_price(inventory: &Inventory, target_id: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> check0(inventory, target_id)
    }

    state check0(inventory: &Inventory, target_id: i32 in Saturating) {
        let price0: i32 in Saturating = inventory.items[0].price;
        transition inventory.items[0].id == target_id {
            true -> (price0)
            _ -> check1(inventory, target_id)
        }
    }

    state check1(inventory: &Inventory, target_id: i32 in Saturating) {
        let price1: i32 in Saturating = inventory.items[1].price;
        transition inventory.items[1].id == target_id {
            true -> (price1)
            _ -> check2(inventory, target_id)
        }
    }

    state check2(inventory: &Inventory, target_id: i32 in Saturating) {
        let price2: i32 in Saturating = inventory.items[2].price;
        transition inventory.items[2].id == target_id {
            true -> (price2)
            _ -> check3(inventory, target_id)
        }
    }

    state check3(inventory: &Inventory, target_id: i32 in Saturating) {
        let price3: i32 in Saturating = inventory.items[3].price;
        transition inventory.items[3].id == target_id {
            true -> (price3)
            _ -> check4(inventory, target_id)
        }
    }

    state check4(inventory: &Inventory, target_id: i32 in Saturating) {
        let price4: i32 in Saturating = inventory.items[4].price;
        transition inventory.items[4].id == target_id {
            true -> (price4)
            _ -> (0)
        }
    }
}

machine Inventory::compute_total(inventory: &Inventory) -> i32 in Saturating {
    // Sum all item values: quantity*price for each item.
    let value0: i32 in Saturating = inventory.items[0].quantity * inventory.items[0].price;
    let value1: i32 in Saturating = inventory.items[1].quantity * inventory.items[1].price;
    let value2: i32 in Saturating = inventory.items[2].quantity * inventory.items[2].price;
    let value3: i32 in Saturating = inventory.items[3].quantity * inventory.items[3].price;
    let value4: i32 in Saturating = inventory.items[4].quantity * inventory.items[4].price;
    value0 + value1 + value2 + value3 + value4
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("inventory_system: populating a 5-item table, then searching and totaling it");
    let mut inventory: Inventory;
    Inventory::set_item(&mut inventory, 0, 1, 3, 10);
    Inventory::set_item(&mut inventory, 1, 2, 5, 6);
    Inventory::set_item(&mut inventory, 2, 3, 2, 5);
    Inventory::set_item(&mut inventory, 3, 4, 7, 1);
    Inventory::set_item(&mut inventory, 4, 5, 1, 70);

    let total: i32 in Saturating = Inventory::compute_total(&inventory);
    let price: i32 in Saturating = Inventory::find_price(&inventory, 5);

    transition price == 70 {
        true -> check_total(context, total)
        _ -> bad_price(context)
    }

    state bad_price(context: &mut Main) {
        Console::write_line("FAIL: search returned the wrong price for id 5 (exit 71)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(71);
    }

    state check_total(context: &mut Main, total: i32 in Saturating) {
        let adjusted: i32 in Saturating = total - 77;
        transition adjusted == 70 {
            true -> good(context)
            _ -> bad_total(context)
        }
    }

    state bad_total(context: &mut Main) {
        Console::write_line("FAIL: wrong inventory total value (exit 72)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(72);
    }

    state good(context: &mut Main) {
        Console::write_line("PASS: golden item price 70, total value 147 (exit 70)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(70);
    }
}
