// Expected exit: 0.
// Fill a record's buffer and a directly borrowed array with ranked recursion.
// Writing elements changes their contents, never either buffer's extent.
data Cells { bytes: [u8; 8]; }

machine fill_field(cells: &mut Cells, position: u64) -> u64
terminates by (position, cells.bytes.len) -> Nat::BoundedDistance;
requires position < cells.bytes.len
{
    cells.bytes[position] = 7;
    transition position + 1 < cells.bytes.len {
        true -> fill_field(cells, position + 1)
        _ -> (position + 1)
    }
}

machine fill_array(bytes: &mut [u8; 4], position: u64) -> u64
terminates by (position, bytes.len) -> Nat::BoundedDistance;
requires position < bytes.len
{
    bytes[position] = 5;
    transition position + 1 < bytes.len {
        true -> fill_array(bytes, position + 1)
        _ -> (position + 1)
    }
}

machine main() crashes Trap {
    let mut cells: Cells;
    let mut bytes: [u8; 4];
    let field_count: u64 = fill_field(&mut cells, 0);
    let array_count: u64 = fill_array(&mut bytes, 0);
    let array_filled: bool = bytes[0] == 5 && bytes[3] == 5;
    let slice_count: u64 = fill_slice(&mut bytes[..], 0);
    transition field_count == 8 && cells.bytes[0] == 7 && cells.bytes[7] == 7
        && array_count == 4 && array_filled && slice_count == 4 && bytes[0] == 3 && bytes[3] == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine fill_slice(bytes: &mut [u8], position: u64) -> u64
terminates by (position, bytes.len) -> Nat::BoundedDistance in 0..=bytes.len;
requires position < bytes.len
{
    bytes[position] = 3;
    transition position + 1 < bytes.len {
        true -> fill_slice(bytes, position + 1)
        _ -> (position + 1)
    }
}
