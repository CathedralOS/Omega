// Expected exit: 0.
// Search overlapping masked byte patterns and retain the actual matching window.
use omega::language::core::option;

data PatternByte [copy] { expected: u8; mask: u8; }
data Found<'input> { position: u64; bytes: &'input [u8]; }

machine matches(bytes: &[u8], pattern: &[PatternByte]) -> bool
requires bytes.len == pattern.len {
    transition { _ -> next(bytes, pattern, 0) }
    state next(bytes: &[u8], pattern: &[PatternByte], cursor: u64) -> bool
    requires bytes.len == pattern.len && cursor <= pattern.len {
        transition cursor < pattern.len {
            true -> compare(bytes, pattern, cursor)
            false -> true
        }
    }
    state compare(bytes: &[u8], pattern: &[PatternByte], cursor: u64) -> bool
    requires bytes.len == pattern.len && cursor < pattern.len {
        let actual: u8 = bytes[cursor] & pattern[cursor].mask;
        let expected: u8 = pattern[cursor].expected & pattern[cursor].mask;
        transition actual == expected {
            true -> next(bytes, pattern, cursor + 1)
            false -> false
        }
    }
}

machine find<'input>(bytes: &'input [u8], pattern: &[PatternByte], start: u64)
    -> Optional<Found<'input>> {
    transition start <= bytes.len && pattern.len > 0 {
        true -> next(bytes, pattern, start)
        false -> Optional::None
    }
    state next(bytes: &'input [u8], pattern: &[PatternByte], cursor: u64)
        -> Optional<Found<'input>>
    requires cursor <= bytes.len && pattern.len > 0 {
        transition pattern.len <= bytes.len - cursor {
            true -> compare(bytes, pattern, cursor)
            false -> Optional::None
        }
    }
    state compare(bytes: &'input [u8], pattern: &[PatternByte], cursor: u64)
        -> Optional<Found<'input>>
    requires cursor <= bytes.len && pattern.len > 0 && pattern.len <= bytes.len - cursor {
        let window: &[u8] = &bytes[cursor..cursor + pattern.len];
        transition matches(window, pattern) {
            true -> Optional::Some { value: Found { position: cursor, bytes: window } }
            false -> next(bytes, pattern, cursor + 1)
        }
    }
}

machine observed(found: Optional<Found>, position: u64, middle: u8) -> bool {
    transition found {
        Optional::Some { value } -> inspect(value, position, middle)
        Optional::None -> false
    }
    state inspect(found: Found, position: u64, middle: u8) -> bool {
        transition found.bytes.len == 3 {
            true -> contents(found, position, middle)
            false -> false
        }
    }
    state contents(found: Found, position: u64, middle: u8) -> bool
    requires found.bytes.len == 3 {
        found.position == position && found.bytes[0] == 170
            && found.bytes[1] == middle && found.bytes[2] == 170
    }
}

machine absent(found: Optional<Found>) -> bool {
    transition found { Optional::Some { value } -> false Optional::None -> true }
}

machine main() crashes Trap {
    let bytes: [u8; 9] = [91, 170, 187, 170, 188, 170, 31, 170, 92];
    let wildcard: [PatternByte; 3] = [
        PatternByte { expected: 170, mask: 255 },
        PatternByte { expected: 255, mask: 0 },
        PatternByte { expected: 170, mask: 255 }
    ];
    let nibble: [PatternByte; 3] = [
        PatternByte { expected: 170, mask: 255 },
        PatternByte { expected: 191, mask: 240 },
        PatternByte { expected: 170, mask: 255 }
    ];
    let input: &[u8] = &bytes[1..8];
    let first: bool = observed(find(input, &wildcard[..], 0), 0, 187);
    let overlapping: bool = observed(find(input, &wildcard[..], 1), 2, 188);
    let last: bool = observed(find(input, &wildcard[..], 3), 4, 31);
    let masked: bool = observed(find(input, &nibble[..], 1), 2, 188);
    let rejected: bool = absent(find(input, &nibble[..], 3));
    let exhausted: bool = absent(find(input, &wildcard[..], 5));
    let empty: bool = absent(find(&input[..0], &wildcard[..], 0));
    let empty_pattern: bool = absent(find(input, &wildcard[..0], 0));
    let past_end: bool = absent(find(input, &wildcard[..], 8));
    transition first && overlapping && last && masked && rejected && exhausted
        && empty && empty_pattern && past_end && bytes[0] == 91 && bytes[8] == 92 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
