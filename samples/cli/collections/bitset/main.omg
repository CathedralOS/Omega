// Expected exit: 70.
// A bitset: a set of small integers stored as bits of a single u32 (bit k set <=> k is in the set).
// Insert is `bits |= 1 << k`; membership is `(bits >> k) & 1`. We insert {3, 5, 7} (one mask built
// by a runtime shift of a value read by runtime index), giving bits = 8|32|128 = 168, then check
// membership: 5 present, 4 absent, 7 present. A real data structure over the bitwise ops -- the same
// primitives a flag set or a Bloom-filter word uses. Exits 70 iff all three checks pass.

use omega_language_std::console;

data Main {
    vals: [u32 in Wrapping; 3];
    bits: u32 in Wrapping;
    i: u32 in Wrapping;
    mask: u32 in Wrapping;
    test: u32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("bitset: insert {3, 5, 7} into a u32 bitset via runtime shifts, then test membership of 5, 4, 7");
    main.vals[0] = 3;
    main.vals[1] = 5;
    main.vals[2] = 7;
    main.bits = 0;
    main.i = 0;
    transition { _ -> ins_step(main) }

    // Insert each value: bits |= 1 << vals[i].
    state ins_step(main: &mut Main) {
        transition main.i < 3 {
            true -> insert(main)
            _ -> check5(main)
        }
    }
    state insert(main: &mut Main) {
        main.mask = 1;
        main.mask = main.mask << main.vals[main.i];
        main.bits = main.bits | main.mask;
        main.i = main.i + 1;
        transition { _ -> ins_step(main) }
    }

    // Membership: (bits >> k) & 1.
    state check5(main: &mut Main) {
        main.test = main.bits >> 5;
        main.test = main.test & 1;
        transition main.test == 1 { true -> check4(main) _ -> bad(main) }
    }
    state check4(main: &mut Main) {
        main.test = main.bits >> 4;
        main.test = main.test & 1;
        transition main.test == 0 { true -> check7(main) _ -> bad(main) }
    }
    state check7(main: &mut Main) {
        main.test = main.bits >> 7;
        main.test = main.test & 1;
        transition main.test == 1 { true -> ok(main) _ -> bad(main) }
    }
    state ok(main: &mut Main) {
        Console::write_line("PASS: 5 in, 4 out, 7 in -- bits == 168 behaves as a set (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: a membership test gave the wrong bit (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
