// 3x3 MATRIX MULTIPLY over invocation-local 2D arrays -- the double-indexed
// access family end to end: both-runtime reads (`a[i][k]`, `b[k][j]`), a
// both-runtime write (`c[i][j] = acc`), and state-transition loops
// (`-> dot(..)` is an internal jump with re-bound arguments). The indices
// travel as STATE PARAMS under one `requires i <= 2` clause per index -- the
// contract discharges every index bound, and each increment lands in a local
// whose back-edge guard (`next_k <= 2`) admits it into the next state's
// contract.
//
//   A = |1 2 3|   B = |9 8 7|   C = A*B = | 30  24  18|
//       |4 5 6|       |6 5 4|             | 84  69  54|
//       |7 8 9|       |3 2 1|             |138 114  90|
//
// exit = (C[0][0] + C[1][1] + C[2][2]) % 256 = (30 + 69 + 90) % 256 = 189
//
// Expected exit: 189
use omega_language_std::console;
data Main {
}
data Matrices {
    a: [[i32 in Wrapping; 3]; 3];
    b: [[i32 in Wrapping; 3]; 3];
    c: [[i32 in Wrapping; 3]; 3];
}
machine Main::main(context: &mut Main) reaches Console {
    let mut matrices: Matrices;
    matrices.a = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
    matrices.b = [[9, 8, 7], [6, 5, 4], [3, 2, 1]];
    transition { _ -> col(context, &mut matrices, 0, 0) }
    state col(context: &mut Main, matrices: &mut Matrices, i: u64, j: u64)
    requires i <= 2 requires j <= 2 {
        transition { _ -> dot(context, matrices, i, j, 0, 0) }
    }
    state dot(context: &mut Main, matrices: &mut Matrices, i: u64, j: u64, k: u64, acc: i32 in Wrapping)
    requires i <= 2
    requires j <= 2
    requires k <= 2 {
        let next_k: u64 = k + 1;
        let accumulated: i32 in Wrapping = acc + matrices.a[i][k] * matrices.b[k][j];
        transition next_k <= 2 {
            true -> dot(context, matrices, i, j, next_k, accumulated)
            false -> store(context, matrices, i, j, accumulated)
        }
    }
    state store(context: &mut Main, matrices: &mut Matrices, i: u64, j: u64, acc: i32 in Wrapping)
    requires i <= 2
    requires j <= 2 {
        matrices.c[i][j] = acc;
        let next_j: u64 = j + 1;
        transition next_j <= 2 {
            true -> col(context, matrices, i, next_j)
            false -> row_step(context, matrices, i)
        }
    }
    state row_step(context: &mut Main, matrices: &mut Matrices, i: u64) requires i <= 2 {
        let next_i: u64 = i + 1;
        transition next_i <= 2 {
            true -> col(context, matrices, next_i, 0)
            false -> checksum(context, matrices)
        }
    }
    state checksum(context: &mut Main, matrices: &Matrices) {
        let total: i32 in Wrapping = matrices.c[0][0] + matrices.c[1][1] + matrices.c[2][2];
        let code: i32 in Wrapping = total % 256;
        Console::exit_process(code as i32);
    }
}
