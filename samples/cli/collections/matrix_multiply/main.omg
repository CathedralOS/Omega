// 3x3 MATRIX MULTIPLY over machine-owned 2D arrays -- the double-indexed
// access family end to end: both-runtime reads (`a[i][k]`, `b[k][j]`), a
// both-runtime write (`c[i][j] = acc`), and self-transition loops (Omega has
// NO recursion; `-> dot(..)` is a jump with re-bound arguments). The indices
// travel as STATE PARAMS under one `requires i <= 2` clause per index -- the
// contract discharges every index bound, and each increment lands in a local
// whose back-edge guard (`next_k <= 2`) admits it into the next state's
// contract.
//
//   A = |1 2 3|   B = |9 8 7|   C = A*B = | 30  24  18|
//       |4 5 6|       |6 5 4|             | 84  69  54|
//       |7 8 9|       |3 2 1|             |138 114  90|
//
// exit = (C[0][0] + C[1][1] + C[2][2]) % 256 = (30 + 69 + 90) % 256 = 189
//
// Expected exit: 189
use omega_language_std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
    a: [[i32 in Wrapping; 3]; 3];
    b: [[i32 in Wrapping; 3]; 3];
    c: [[i32 in Wrapping; 3]; 3];
}
machine Main::main(&mut self) reaches Console {
    self.a = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
    self.b = [[9, 8, 7], [6, 5, 4], [3, 2, 1]];
    transition { _ -> col(0, 0) }
    state col(&mut self, i: u64, j: u64) requires i <= 2 requires j <= 2 {
        transition { _ -> dot(i, j, 0, 0) }
    }
    state dot(&mut self, i: u64, j: u64, k: u64, acc: i32 in Wrapping)
    requires i <= 2
    requires j <= 2
    requires k <= 2 {
        let next_k: u64 = k + 1;
        transition next_k <= 2 {
            true -> dot(i, j, next_k, acc + self.a[i][k] * self.b[k][j])
            false -> store(i, j, acc + self.a[i][k] * self.b[k][j])
        }
    }
    state store(&mut self, i: u64, j: u64, acc: i32 in Wrapping)
    requires i <= 2
    requires j <= 2 {
        self.c[i][j] = acc;
        let next_j: u64 = j + 1;
        transition next_j <= 2 {
            true -> col(i, next_j)
            false -> row_step(i)
        }
    }
    state row_step(&mut self, i: u64) requires i <= 2 {
        let next_i: u64 = i + 1;
        transition next_i <= 2 {
            true -> col(next_i, 0)
            false -> checksum()
        }
    }
    state checksum(&mut self) {
        let total: i32 in Wrapping = self.c[0][0] + self.c[1][1] + self.c[2][2];
        let code: i32 in Wrapping = total % 256;
        self.console.exit_process(code as i32);
    }
}
