// Run-length encode -- scans the fixed 20-byte record "AAAABBBCCDDDDDEEEEEE"
// and prints one "run: <value> x<count>" line per run boundary, then exits
// with the number of runs (4 A, 3 B, 2 C, 5 D, 6 E = 5). Output streams
// through Console::write_byte since a raw byte write into a Utf8 carrier
// cannot be proven valid UTF-8. Exercises adjacent-element comparison,
// emit-on-boundary control, and a computed exit code -- an encoding workload
// the collections corpus did not hold.
// Expected exit: 5.
// Expected output contains: run: C x2

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 20]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    data: [u8; 20] in Utf8;
    // Counters are `in Wrapping`: increments are defined arithmetic; index uses
    // stay bounded by the `i < 20` guard.
    i: i32 in Wrapping;
    runs: i32 in Wrapping;
    b: u8;
    prev: u8;
    count: u32 in Wrapping;
    chi: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("run_length_encode: 20 bytes -> one line per run, exit = number of runs");
    main.data = "AAAABBBCCDDDDDEEEEEE";
    main.prev = main.data[0];
    main.count = 1;
    main.i = 1;
    main.runs = 0;
    transition {
        _ -> step(main)
    }

    state step(main: &mut Main) {
        transition main.i < 20 {
            true -> read(main)
            _ -> done(main)
        }
    }

    state read(main: &mut Main) {
        main.b = main.data[main.i];
        transition main.b == main.prev {
            true -> bump(main)
            _ -> emit_mid(main)
        }
    }

    state bump(main: &mut Main) {
        main.count = main.count + 1;
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }

    state emit_mid(main: &mut Main) {
        Console::write("run: ");
        Console::write_byte(main.prev as i32);
        Console::write(" x");
        main.chi = narrow_u32_to_i32_trapping((main.count + 48) as u32);
        Console::write_byte(main.chi);
        Console::write_line("");
        main.runs = main.runs + 1;
        main.prev = main.b;
        main.count = 1;
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }

    state done(main: &mut Main) {
        Console::write("run: ");
        Console::write_byte(main.prev as i32);
        Console::write(" x");
        main.chi = narrow_u32_to_i32_trapping((main.count + 48) as u32);
        Console::write_byte(main.chi);
        Console::write_line("");
        main.runs = main.runs + 1;
        transition {
            _ -> finish(main)
        }
    }

    state finish(main: &mut Main) {
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.runs as i32);
    }
}
