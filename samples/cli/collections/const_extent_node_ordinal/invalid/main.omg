// Complete intended-invalid control: a plain ordinal is not a proof that it
// lies inside a six-node const-extent table.

data Nodes<const N: u64> where N >= 1 && N <= 8 {
    x: [i64 in Wrapping; N];
}

machine read(nodes: &Nodes<6>, index: u64) -> i64 in Wrapping {
    nodes.x[index]
}

data Main { }

machine Main::main(main: &mut Main) {
    let nodes: Nodes<6> = Nodes { x: [0, 10, 3, 7, 3, 7] };
    let _value: i64 in Wrapping = read(&nodes, 1);
}
