// Expected exit: 0
// Exchange runtime-selected scan windows without copying their backing cells.
// Returned windows retain the old backing; neighboring slots remain untouched.

data Cell [copy] { value: u32; tag: u64; }
data Window<'input> { values: &'input mut [Cell]; }

machine replace<'carrier, 'input>(windows: &'carrier mut [Window<'input>], replacement: &'input mut [Cell], position: u64) -> Window<'input>
requires position < windows.len {
    let previous: Window<'input> = windows[position];
    windows[position] = Window { values: replacement };
    previous
}

machine replaced(values: &[Cell]) -> bool {
    transition values.len == 2 {
        true -> inspect(values)
        false -> false
    }
    state inspect(values: &[Cell]) -> bool requires values.len == 2 {
        values[0].value == 42 && values[0].tag == 9223372036854775808
            && values[1].value == 19 && values[1].tag == 29
    }
}

machine unchanged(values: &[Cell]) -> bool {
    transition values.len == 1 {
        true -> inspect(values)
        false -> false
    }
    state inspect(values: &[Cell]) -> bool requires values.len == 1 {
        values[0].value == 31 && values[0].tag == 41
    }
}

machine main() crashes Trap {
    let mut original: [Cell; 1] = [Cell { value: 7, tag: 17 }];
    let mut neighbor: [Cell; 1] = [Cell { value: 31, tag: 41 }];
    let mut replacement: [Cell; 2] = [Cell { value: 42, tag: 9223372036854775808 }, Cell { value: 19, tag: 29 }];
    let mut second_replacement: [Cell; 1] = [Cell { value: 55, tag: 65 }];
    let mut windows: [Window; 2] = [Window { values: &mut original[..] }, Window { values: &mut neighbor[..] }];
    let retired: Window = replace(&mut windows[..], &mut replacement[..], 0);
    let retired_correct: bool = old_window(retired.values);
    mark(retired.values);
    let valid: bool = replaced(windows[0].values);
    let adjacent: bool = unchanged(windows[1].values);
    let second_retired: Window = replace(&mut windows[..], &mut second_replacement[..], 1);
    let second_retired_correct: bool = unchanged(second_retired.values);
    let first_retained: bool = replaced(windows[0].values);
    let second_installed: bool = second_window(windows[1].values);
    transition valid && adjacent && retired_correct && second_retired_correct
        && first_retained && second_installed && original[0].value == 9
        && original[0].tag == 17 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}

machine mark(values: &mut [Cell]) {
    transition values.len > 0 {
        true -> write(values)
        false -> done()
    }
    state write(values: &mut [Cell]) requires values.len > 0 {
        values[0].value = 9;
    }
    state done() {}
}

machine second_window(values: &[Cell]) -> bool {
    transition values.len == 1 {
        true -> inspect(values)
        false -> false
    }
    state inspect(values: &[Cell]) -> bool requires values.len == 1 {
        values[0].value == 55 && values[0].tag == 65
    }
}

machine old_window(values: &[Cell]) -> bool {
    transition values.len == 1 {
        true -> inspect(values)
        false -> false
    }
    state inspect(values: &[Cell]) -> bool requires values.len == 1 {
        values[0].value == 7 && values[0].tag == 17
    }
}
