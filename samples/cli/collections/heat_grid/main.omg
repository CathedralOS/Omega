// HEAT GRID -- dependent-typed row-major indexing (chapter 12, rungs
// R0+R1a): a flat `cells: [u8; 12]` viewed as a 3x4 grid, walked with the
// DIRECT `cells[y * 4 + x]` spelling. The walkers' coordinates are
// DEPENDENT STATE CONTRACTS (`requires 0 <= y && y <= grid.max_y`) -- the bound
// names a field, the caller PROVES each hop on its arm (the back-edge
// guard `y + 1 <= grid.max_y` is the whole proof), and the index's bound
// discharges by interval product through the fields' declared ranges
// (max_y<=2, max_x<=3 => y*4+x in [0..=11] < 12). No linear-counter
// workaround, no re-guard states, no bounds checks at runtime.
//
// The grid seeds one hot cell, every visited cell ACCUMULATES its
// coordinate sum through the computed index (`cells[y*4+x] = next` -- the
// runtime-value indexed write rides the local's slot + the
// storage-to-indexed copy), and the exit code reports the hottest cell:
// seed 40 at (2,3) + (2+3) = 45.
//
// Expected exit: 45
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Grid where 0 <= max_y, max_y <= 2, 0 <= max_x, max_x <= 3 {
    cells: [u8; 12];
    max_y: u32;
    max_x: u32;
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut grid: Grid;
    grid.max_y = 2;
    grid.max_x = 3;
    grid.cells[11] = 40;
    transition { _ -> row(&mut grid, 0, 0) }

    // Walk rows; each row walks its cells. Every hop's proof is the arm's
    // own guard relating the next coordinate to the bound field.
    state row(grid: &mut Grid, y: u32, hottest: u32)
        requires 0 <= y && y <= grid.max_y
    {
        transition { _ -> cell(grid, y, 0, hottest) }
    }
    state cell(grid: &mut Grid, y: u32, x: u32, hottest: u32)
        requires 0 <= y && y <= grid.max_y && 0 <= x && x <= grid.max_x
    {
        let bump: u8 =
            ((narrow_u32_to_u8_trapping(y) as u8 in Wrapping)
            + (narrow_u32_to_u8_trapping(x) as u8 in Wrapping)) as u8;
        let cur: u8 = grid.cells[y * 4 + x];
        let next: u8 = ((cur as u8 in Wrapping) + (bump as u8 in Wrapping)) as u8;
        grid.cells[y * 4 + x] = next;
        let heat: u32 = widen_u8_to_u32(next);
        transition heat > hottest {
            true -> step(grid, y, x, heat)
            _ -> step(grid, y, x, hottest)
        }
    }
    state step(grid: &mut Grid, y: u32, x: u32, hottest: u32)
        requires 0 <= y && y <= grid.max_y && 0 <= x && x <= grid.max_x
    {
        transition x + 1 <= grid.max_x {
            true -> cell(grid, y, x + 1, hottest)
            _ -> next_row(grid, y, hottest)
        }
    }
    state next_row(grid: &mut Grid, y: u32, hottest: u32)
        requires 0 <= y && y <= grid.max_y
    {
        transition y + 1 <= grid.max_y {
            true -> row(grid, y + 1, hottest)
            _ -> done(hottest)
        }
    }
    state done(hottest: u32) {
        let code: i32 = narrow_u32_to_i32_trapping(hottest);
        Console::exit_process(code);
    }
}
