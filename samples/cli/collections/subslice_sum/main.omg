// Expected exit: 70.
// Subslice sum: subslices + indexing combined with a loop-like dispatch chain.
//
// Exercises: passing subslices to helper machines, shrinking-window iteration
// (the `s[1..]` pattern) combined with a running total accumulated via a
// dispatch-chain loop (value-returning recursive machine), and a final
// equality check.
//
// Dataset: [3, 7, 12, 18, 5, 25] (6 elements), sum = 70.
//
// The helper machine Adder::walk shrinks the slice on each call:
//   walk(s, acc) loops until s is empty, accumulating acc + s[0] each time.
//
// MISCOMPILE FOUND AND FIXED (2026-06-14). Now exits 70.
//
// Same shape as recursive_sum: `walk(s[1..], acc + s[0])` advanced the `s`
// descriptor before reading `s[0]` (off-by-one). FIXED by making the
// argument-overlap detector see slice-element reads nested in a binary
// accumulator and stage the call. Guarded by the RUN canary
// slices/recursive_subslice_element_accumulator_exit.

use omega_language_std::console;

data Adder {}

data Main {
    arr: [i32 in Wrapping; 6];
    adder: Adder;
    pause: [u8; 256];
}

// Looping value-returning machine: acc + s[0] at each step, recurse on s[1..].
machine walk(s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> walk(s[1..], acc + s[0])
        false -> (acc as i32)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("subslice_sum: shrinking-window recursion sums [3, 7, 12, 18, 5, 25]");
    // Initialize the array.
    main.arr[0] = 3;
    main.arr[1] = 7;
    main.arr[2] = 12;
    main.arr[3] = 18;
    main.arr[4] = 5;
    main.arr[5] = 25;

    // Sum all 6 elements via shrinking-window recursion: 3+7+12+18+5+25 = 70.
    let s: &[i32 in Wrapping] = &main.arr[..];
    let t: i32 = walk(s, 0);

    transition t == 70 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: the six elements summed to 70 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::write_line("FAIL: the recursive sum did not equal 70 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
