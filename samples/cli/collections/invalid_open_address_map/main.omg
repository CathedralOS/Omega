use {omega}/language/core/process_exit.omg;
// Intended-invalid control for open_address_map: writing slot 16 of a
// 16-entry slot array must be rejected at compile time.


data Slot<K, V> { key: K; value: V; tag: u64; }
data Table<K, V> { slots: [Slot<K, V>; 16]; live: u64 in Wrapping; }

machine poke<K, V>(table: @mutable Table<K, V>) {
    table.slots[16].tag = 1;
}

data Main { ints: Table<u64, u64>; }

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit {
    poke(@mutable main.ints);
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
