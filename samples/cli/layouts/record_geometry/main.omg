// Expected exit: 0.
// Compute storage geometry from portable layout observations. The values are
// ordinary copied integers, including after their source storage is changed.
data Row { tag: u8; count: u64; }
data Geometry { bytes: u64; alignment: u64; }

machine identity(value: u64) -> u64 { value }
machine row_bytes() -> u64 { size_of<Row>() }
machine choose_bytes(large: bool) -> u64 {
    transition large {
        true -> selected()
        _ -> small()
    }
    machine selected() -> u64 { size_of<Row>() }
    machine small() -> u64 { 8u64 }
}

machine main() crashes Trap {
    let bytes: u64 = size_of<Row>();
    let alignment: u64 = align_of<Row>();
    let extent: u64 = bytes + alignment;
    let mut geometry: Geometry = Geometry { bytes: bytes, alignment: alignment };
    let saved: u64 = geometry.bytes;
    geometry.bytes = 0;
    let detached_extent: u64 = saved + alignment;
    let forwarded_extent: u64 = identity(bytes) + alignment;
    let returned_extent: u64 = row_bytes() + alignment;
    let cast_extent: u64 = (bytes as u64) + alignment;
    let selected: u64 = match bytes == 16 { true -> bytes, _ -> 8u64 };
    let selected_extent: u64 = selected + alignment;
    let copied: Geometry = Geometry { bytes: bytes, alignment: alignment };
    let forwarded: Geometry = copied;
    let field_extent: u64 = forwarded.bytes + forwarded.alignment;
    let pages: [u64; 2] = [bytes, alignment];
    let array_extent: u64 = pages[0] + pages[1];
    let double_extent: u64 = bytes * 2;
    let chosen_extent: u64 = choose_bytes(true) + alignment;
    transition extent == 24 && detached_extent == 24
        && forwarded_extent == 24 && returned_extent == 24
        && cast_extent == 24 && selected_extent == 24
        && field_extent == 24 && array_extent == 24 && double_extent == 32
        && chosen_extent == 24 {
        true -> finish(bytes, alignment)
        _ -> bad()
    }
    machine finish(bytes: u64, alignment: u64) {
        let padding_extent: u64 = bytes - alignment;
        transition padding_extent == 8 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
