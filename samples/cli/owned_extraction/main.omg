// Expected exit: 0. An applied generic provider result retains its exact
// payload types through a generic wrapper and ordinary case extraction.
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data OwnedExtraction<Value> { case Moved(value: Value); }
machine retire<Value>(result: OwnedExtraction<Value>) -> Value {
    transition result { OwnedExtraction::Moved { value } -> value }
}
machine borrowed<'backing>(backing: &'backing u64, moved: bool) -> bool {
    let result: Extraction<&'backing u64, u32> = match moved {
        true -> Extraction::Moved { storage: backing, value: 67 }
        false -> Extraction::Held { storage: backing, value: 67 }
    };
    let view: Returned<&'backing u64, u32> = unpack<&'backing u64, u32>(result);
    view.storage as u64 == 61 && view.value == 67 && view.moved == moved
}

public data Extraction<Storage, Value> {
    case Moved(storage: Storage, value: Value);
    case Held(storage: Storage, value: Value);
}
public data Returned<Storage, Value> { storage: Storage; value: Value; moved: bool; }
public boundary trait ExtractionProvider<Storage, Value> {
    machine extract(storage: Storage, value: Value) -> Extraction<Storage, Value> reaches;
}
Extract satisfies ExtractionProvider<u64, u32> {
    machine extract(storage: u64, value: u32) -> Extraction<u64, u32> {
        Extraction::Moved { storage: storage, value: value }
    }
}
machine extract<Storage, Value>(storage: Storage, value: Value)
    -> Returned<Storage, Value>
reaches ExtractionProvider
{
    transition ExtractionProvider<Storage, Value>::extract(storage, value) {
        Extraction::Moved { storage, value } -> Returned { storage: storage, value: value, moved: true }
        Extraction::Held { storage, value } -> Returned { storage: storage, value: value, moved: false }
    }
}
machine unpack<Storage, Value>(result: Extraction<Storage, Value>)
    -> Returned<Storage, Value>
{
    transition result {
        Extraction::Moved { storage, value } -> Returned { storage: storage, value: value, moved: true }
        Extraction::Held { storage, value } -> Returned { storage: storage, value: value, moved: false }
    }
}
machine main() reaches ExtractionProvider crashes Trap {
    let direct: Returned<u64, u32> = extract<u64, u32>(17, 29);
    let result: Extraction<u32, u64> = Extraction::Held { storage: 31, value: 43 };
    let forwarded: Returned<u32, u64> = unpack<u32, u64>(result);
    let backing: u64 = 61;
    let owned: OwnedExtraction<Token> = OwnedExtraction::Moved { value: Token { value: 71 } };
    let retired: Token = retire<Token>(owned);
    let owned_correct: bool = retired.value == 71;
    drop(retired);
    let alternative: Extraction<Token, u64> = Extraction::Held { storage: Token { value: 79 }, value: 83 };
    let returned: Returned<Token, u64> = unpack<Token, u64>(alternative);
    let alternative_correct: bool = returned.storage.value == 79 && returned.value == 83 && !returned.moved;
    drop(returned.storage);
    transition direct.storage == 17 && direct.value == 29
        && forwarded.storage == 31 && forwarded.value == 43 && direct.moved && !forwarded.moved
        && borrowed(&backing, true) && borrowed(&backing, false) && owned_correct && alternative_correct {
        true -> good()
        false -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
