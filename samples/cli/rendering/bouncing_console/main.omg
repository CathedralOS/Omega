// A bouncing ball animated in place on one console line -- the first demo of timed
// animation, paced by the Clock.sleep host op. Each frame clears a 40-wide line,
// draws the ball 'O' at its position, prints a carriage return (cursor to column 0)
// + the line WITHOUT a newline (so the next frame overwrites it), then sleeps. The
// ball bounces left<->right. Pure compute + stdout + sleep; no new features beyond
// the just-added Clock.sleep.
// Expected exit: 0.
// Expected output contains: O
use omega_language_std::console;
use omega_language_std::clock;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 40]::Utf8
requires
    valid_utf8(self);
domain [u8; 1]::Utf8
requires
    valid_utf8(self);
data Main
requires
    0 <= self.p && self.p <= 40
    && 0 <= self.frame && self.frame <= 50
    && 0 <= self.x && self.x <= 40
{
    line: [u8; 40] in Utf8;
    cr: [u8; 1] in Utf8;
    p: i32;              // ball column; each move is re-guarded so +1/-1 stays in [0, 40]
    dir: i32;            // -1 or +1; only compared, never fed to arithmetic
    frame: i32;          // guard-proven Exact frame counter
    x: i32;              // guard-proven Exact clear counter
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console {
    Console::write_line("bouncing_console: a ball 'O' bouncing along one console line for 50 timed frames");
    main.line = "                                        ";
    main.cr = "X";
    main.cr[0] = 13;
    main.p = 0;
    main.dir = 1;
    main.frame = 0;
    transition { _ -> block frame_loop(main) }

    machine frame_loop(main: &mut Main) {
        transition main.frame < 50 { true -> block clear_init(main) _ -> block finish(main) }
    }
    machine clear_init(main: &mut Main) { main.x = 0; transition { _ -> block clear_loop(main) } }
    machine clear_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 40 { true -> block clear_cell(main) _ -> block place(main) }
    }
    machine clear_cell(main: &mut Main) {
        main.line[main.x] = 32;
        main.x = main.x + 1;
        transition { _ -> block clear_loop(main) }
    }
    machine place(main: &mut Main) {
        transition main.p >= 0 && main.p < 40 { true -> block set_ball(main) _ -> block bad(main) }
    }
    machine set_ball(main: &mut Main) {
        main.line[main.p] = 79;
        transition { _ -> block emit(main) }
    }
    // The host calls kill arithmetic facts, so the counter updates move behind
    // re-guards: `frame < 50` proves the frame increment, and the movement step
    // branches on `dir` so each direction's re-guard proves its own +1 / -1 --
    // fully Exact, no domain.
    machine emit(main: &mut Main) {
        Console::write(main.cr);
        Console::write(main.line);
        Clock::sleep(25);
        transition main.frame < 50 { true -> block frame_bump(main) _ -> block finish(main) }
    }
    machine frame_bump(main: &mut Main) {
        main.frame = main.frame + 1;
        transition main.dir == 1 { true -> block move_right_guard(main) _ -> block move_left_guard(main) }
    }
    machine move_right_guard(main: &mut Main) {
        transition main.p >= 0 && main.p < 40 { true -> block move_right(main) _ -> block bad(main) }
    }
    machine move_right(main: &mut Main) {
        main.p = main.p + 1;
        transition { _ -> block bounce_hi(main) }
    }
    machine move_left_guard(main: &mut Main) {
        transition main.p >= 1 && main.p < 41 { true -> block move_left(main) _ -> block bad(main) }
    }
    machine move_left(main: &mut Main) {
        main.p = main.p - 1;
        transition { _ -> block bounce_hi(main) }
    }
    machine bounce_hi(main: &mut Main) {
        transition main.p >= 39 { true -> block flip_down(main) _ -> block bounce_lo(main) }
    }
    machine flip_down(main: &mut Main) { main.dir = 0 - 1; transition { _ -> block frame_loop(main) } }
    machine bounce_lo(main: &mut Main) {
        transition main.p <= 0 { true -> block flip_up(main) _ -> block frame_loop(main) }
    }
    machine flip_up(main: &mut Main) { main.dir = 1; transition { _ -> block frame_loop(main) } }

    machine finish(main: &mut Main) {
        Console::write_line("done: 50 frames of line-bounce animation complete (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    machine bad(main: &mut Main) {
        Console::write_line("FAIL: ball position left the [0,40) range guard (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Clock + Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
