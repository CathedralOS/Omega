// A bouncing ball animated in place on one console line -- the first demo of timed
// animation, paced by the Clock.sleep host op. Each frame clears a 40-wide line,
// draws the ball 'O' at its position, prints a carriage return (cursor to column 0)
// + the line WITHOUT a newline (so the next frame overwrites it), then sleeps. The
// ball bounces left<->right. Pure compute + stdout + sleep; no new features beyond
// the just-added Clock.sleep.
// Expected exit: 0.
// Expected output contains: O
use omega_language_std::console;
use omega_language_std::clock;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 40]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 1]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    line: [u8; 40] in Utf8;
    cr: [u8; 1] in Utf8;
    p: i32;              // ball column; each move is re-guarded so +1/-1 stays in [0, 40]
    dir: i32;            // -1 or +1; only compared, never fed to arithmetic
    frame: i32;          // guard-proven Exact frame counter
    x: i32;              // guard-proven Exact clear counter
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console {
    Console::write_line("bouncing_console: a ball 'O' bouncing along one console line for 50 timed frames");
    main.line = "                                        ";
    main.cr = "X";
    main.cr[0] = 13;
    main.p = 0;
    main.dir = 1;
    main.frame = 0;
    transition { _ -> frame_loop(main) }

    state frame_loop(main: &mut Main) {
        transition main.frame < 50 { true -> clear_init(main) _ -> finish(main) }
    }
    state clear_init(main: &mut Main) { main.x = 0; transition { _ -> clear_loop(main) } }
    state clear_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 40 { true -> clear_cell(main) _ -> place(main) }
    }
    state clear_cell(main: &mut Main) {
        main.line[main.x] = 32;
        main.x = main.x + 1;
        transition { _ -> clear_loop(main) }
    }
    state place(main: &mut Main) {
        transition main.p >= 0 && main.p < 40 { true -> set_ball(main) _ -> bad(main) }
    }
    state set_ball(main: &mut Main) {
        main.line[main.p] = 79;
        transition { _ -> emit(main) }
    }
    // The host calls kill arithmetic facts, so the counter updates move behind
    // re-guards: `frame < 50` proves the frame increment, and the movement step
    // branches on `dir` so each direction's re-guard proves its own +1 / -1 --
    // fully Exact, no domain.
    state emit(main: &mut Main) {
        Console::write(main.cr);
        Console::write(main.line);
        Clock::sleep(25);
        transition main.frame < 50 { true -> frame_bump(main) _ -> finish(main) }
    }
    state frame_bump(main: &mut Main) {
        main.frame = main.frame + 1;
        transition main.dir == 1 { true -> move_right_guard(main) _ -> move_left_guard(main) }
    }
    state move_right_guard(main: &mut Main) {
        transition main.p >= 0 && main.p < 40 { true -> move_right(main) _ -> bad(main) }
    }
    state move_right(main: &mut Main) {
        main.p = main.p + 1;
        transition { _ -> bounce_hi(main) }
    }
    state move_left_guard(main: &mut Main) {
        transition main.p >= 1 && main.p < 41 { true -> move_left(main) _ -> bad(main) }
    }
    state move_left(main: &mut Main) {
        main.p = main.p - 1;
        transition { _ -> bounce_hi(main) }
    }
    state bounce_hi(main: &mut Main) {
        transition main.p >= 39 { true -> flip_down(main) _ -> bounce_lo(main) }
    }
    state flip_down(main: &mut Main) { main.dir = 0 - 1; transition { _ -> frame_loop(main) } }
    state bounce_lo(main: &mut Main) {
        transition main.p <= 0 { true -> flip_up(main) _ -> frame_loop(main) }
    }
    state flip_up(main: &mut Main) { main.dir = 1; transition { _ -> frame_loop(main) } }

    state finish(main: &mut Main) {
        Console::write_line("done: 50 frames of line-bounce animation complete (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: ball position left the [0,40) range guard (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
