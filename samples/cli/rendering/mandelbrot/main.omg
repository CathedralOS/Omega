// Mandelbrot set, software-rendered to the console as ASCII. A real per-pixel
// renderer: for each cell map (x,y) to a complex c, run the escape-time iteration
// z = z*z + c until |z|^2 > 4 or a cap, and pick a palette glyph by escape speed.
// Pure compute -- 1D carrier framebuffer (row), nested loops, f64 math, runtime-
// indexed carrier byte writes, write_line per row. No new compiler features.
//
//   set body -> '#', exterior fades to ' '.
// Expected exit: 0.
// Expected output contains: #
use omega::language::core::float_operations;
use omega_language_std::console;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 64]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    row: [u8; 64] in Utf8;
    palette: [u8; 8] in Utf8;
    x: i32;
    y: i32;
    cr: f64;
    ci: f64;
    zr: f64;
    zi: f64;
    zr2: f64;
    zi2: f64;
    mag: f64;
    k: i32;
    idx: i32;
    ch: u8 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("mandelbrot: escape-time fractal rendered as 64x28 ASCII");
    main.palette = " .:-=+*#";
    main.row = "................................................................";
    main.y = 0;
    transition { _ -> row_loop(main) }

    state row_loop(main: &mut Main) {
        transition main.y < 28 { true -> col_init(main) _ -> done(main) }
    }
    state col_init(main: &mut Main) {
        main.x = 0;
        transition { _ -> col_loop(main) }
    }
    state col_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 64 { true -> pixel_init(main) _ -> emit_row(main) }
    }
    state pixel_init(main: &mut Main) {
        main.cr = (F64::from_i32(main.x) / 64.0) * 3.5 - 2.5;
        main.ci = (F64::from_i32(main.y) / 28.0) * 2.6 - 1.3;
        main.zr = 0.0;
        main.zi = 0.0;
        main.k = 0;
        transition { _ -> iter_loop(main) }
    }
    state iter_loop(main: &mut Main) {
        transition main.k < 28 { true -> iter_test(main) _ -> pixel_done(main) }
    }
    state iter_test(main: &mut Main) {
        main.zr2 = main.zr * main.zr;
        main.zi2 = main.zi * main.zi;
        main.mag = main.zr2 + main.zi2;
        transition main.mag > 4.0 { true -> pixel_done(main) _ -> iter_step(main) }
    }
    // Re-guard so the increment's direct edge proves `k + 1` lands in
    // [1..=28] -- we only get here with k < 28, so always true.
    state iter_step(main: &mut Main) {
        main.zi = 2.0 * main.zr * main.zi + main.ci;
        main.zr = main.zr2 - main.zi2 + main.cr;
        transition main.k >= 0 && main.k < 28 { true -> iter_advance(main) _ -> pixel_done(main) }
    }
    state iter_advance(main: &mut Main) {
        main.k = main.k + 1;
        transition { _ -> iter_loop(main) }
    }
    // Re-guard `0 <= k <= 28` so the shade arithmetic `k * 7 / 28` is exact --
    // k only counts up to the 28-step cap, so always true.
    state pixel_done(main: &mut Main) {
        transition main.k >= 0 && main.k <= 28 { true -> pixel_shade(main) _ -> bad(main) }
    }
    state pixel_shade(main: &mut Main) {
        main.idx = main.k * 7 / 28;
        transition main.idx >= 0 && main.idx < 8 && main.x >= 0 && main.x < 64 {
            true -> write_pixel(main)
            _ -> bad(main)
        }
    }
    state write_pixel(main: &mut Main) {
        main.ch = main.palette[main.idx] as u8 in Wrapping;
        main.row[main.x] = main.ch as u8;
        main.x = main.x + 1;
        transition { _ -> col_loop(main) }
    }
    // Re-guard so the increment's direct edge proves `y + 1` lands in
    // [1..=28] (the write_line call severs the row_loop guard anyway).
    state emit_row(main: &mut Main) {
        Console::write_line(main.row);
        transition main.y >= 0 && main.y < 28 { true -> row_advance(main) _ -> done(main) }
    }
    state row_advance(main: &mut Main) {
        main.y = main.y + 1;
        transition { _ -> row_loop(main) }
    }
    state done(main: &mut Main) {
        Console::write_line("PASS: 28 rows rendered (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: internal bounds check failed (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
