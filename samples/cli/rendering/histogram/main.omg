// Expected exit: 4.
// Histogram: tally how many samples fall in each of four categories, then report
// the count for category 2. A real counting computation -- the kind that was
// blocked until a runtime-indexed write learned to invalidate the whole array's
// folded constants (so `histogram[v]` accumulates instead of re-reading 0).
//
// The accumulation is the DIRECT read-modify-write at a runtime index
// (`histogram[v] = histogram[v] + 1` -- served and canaried since the
// indexed-RMW selection landed; swept off the temp-field idiom 2026-07-11).
//
// Every histogram index `v` is bounds-checked by an explicit `v < 4` guard before
// the write, matching Omega's proof model -- the index is admitted only where it
// is provably in range.
//
//   samples = [2, 0, 2, 1, 2, 3, 0, 2]  ->  category 2 occurs 4 times.
// The program exits with that count. Expected exit: 4.

use omega_language_std::console;

data Main {
    pause: [u8; 256];
    samples: [u64; 8];
    // Wrapping DECLARED: the tallies accumulate values read back OUT of the
    // histogram array, and array elements carry no range facts yet.
    histogram: [i32; 4] in Wrapping;
    k: u64;
    v: u64;
    result: i32 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("histogram: counting value frequencies into a fixed-bucket array");
    main.histogram[0] = 0;
    main.histogram[1] = 0;
    main.histogram[2] = 0;
    main.histogram[3] = 0;

    main.samples[0] = 2;
    main.samples[1] = 0;
    main.samples[2] = 2;
    main.samples[3] = 1;
    main.samples[4] = 2;
    main.samples[5] = 3;
    main.samples[6] = 0;
    main.samples[7] = 2;

    main.k = 0;

    transition {
        _ -> tally_loop(main)
    }

    // Walk the samples; the loop counter `k` is bounded by the array length.
    state tally_loop(main: &mut Main) {
        transition main.k < 8 {
            true -> load_sample(main)
            _ -> done(main)
        }
    }

    state load_sample(main: &mut Main) {
        main.v = main.samples[main.k];
        transition {
            _ -> bounded_tally(main)
        }
    }

    // Admit the histogram index only where it is provably in range.
    state bounded_tally(main: &mut Main) {
        transition main.v < 4 {
            true -> bump(main)
            _ -> advance(main)
        }
    }

    state bump(main: &mut Main) {
        main.histogram[main.v] = main.histogram[main.v] + 1;
        transition {
            _ -> advance(main)
        }
    }

    state advance(main: &mut Main) {
        main.k = main.k + 1;
        transition {
            _ -> tally_loop(main)
        }
    }

    state done(main: &mut Main) {
        main.result = main.histogram[2];
        Console::write_line("result: the count for category 2, 4 for this dataset (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.result as i32);
    }
}
