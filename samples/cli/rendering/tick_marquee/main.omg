use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/clock.omg;
use {system}/console.omg;
use {system}/time.omg;
use {system}/time_host.omg;
// A tick-PACED marquee -- the first render loop verified against REAL elapsed time. A '#'
// sweeps across a carrier line for 24 frames at ~15ms each (write_line + Clock.sleep), and
// the loop's wall-clock cost is then ASSERTED through system `elapsed_since`: elapsed >=
// 100ms. Natively the monotonic clock measures real sleep time; the interpreter's virtual
// clock advances by the slept milliseconds, so the same assertion holds deterministically.
// Composes: system Clock and the TimeHost clock reads in a live render loop, carrier byte writes at a
// runtime index, and per-frame host output.
// Expected exit: 0.
// Expected output contains: #
data Main {
    line: [u8; 12];
    frame: u32 in Wrapping;
    pos: u32 in Wrapping;
    t_start: |time|::Instant;
    pause: [u8; 256];
}
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |clock|::Clock + |process_authority|::StandardInput + |process_authority|::StandardOutput + |time_host|::TimeHost {
    |console|::Console::write_line("tick_marquee: a # sweeps 24 frames, then real elapsed time is asserted");
    main.t_start = |time|::instant_now();
    main.frame = 0u32 as +Wrapping;
    transition { _ -> block frame_loop(main) }
    machine frame_loop(main: @mutable Main) {
        transition main.frame < 24 { true -> block draw(main), _ -> block finish(main) }
    }
    machine draw(main: @mutable Main) {
        main.line = "            ";
        main.pos = main.frame % 12;
        transition main.pos < 12 { true -> block put(main), _ -> block finish(main) }
    }
    machine put(main: @mutable Main)
    requires main.pos < 12
    {
        main.line[main.pos] = 35;
        |console|::Console::write_line(@main.line[..]);
        block |clock|::Clock::sleep(15);
        main.frame = main.frame + 1;
        transition { _ -> block frame_loop(main) }
    }
    machine finish(main: @mutable Main) {
        let elapsed: |time|::Duration = |time|::elapsed_since(main.t_start);
        transition elapsed.seconds == 0 {
            true -> block check_subsecond(main, elapsed.subsecond_nanoseconds),
            false -> block ok(main)
        }
    }
    machine check_subsecond(main: @mutable Main, subsecond_nanoseconds: u32) {
        transition subsecond_nanoseconds >= 100000000 { true -> block ok(main), _ -> block bad(main) }
    }
    machine ok(main: @mutable Main)  {
        |console|::Console::write_line("PASS: 24 frames drawn and elapsed time >= 100ms (exit 0)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine bad(main: @mutable Main) {
        |console|::Console::write_line("FAIL: elapsed time came in under 100ms (exit 1)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |clock|::Clock + |process_authority|::StandardInput + |process_authority|::StandardOutput + |time_host|::TimeHost {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
