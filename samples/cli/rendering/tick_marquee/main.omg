// A tick-PACED marquee -- the first render loop verified against REAL elapsed time. A '#'
// sweeps across a carrier line for 24 frames at ~15ms each (write_line + Clock.sleep), and
// the loop's wall-clock cost is then ASSERTED through std `Time::elapsed_since`: elapsed >=
// 100ms. Natively the monotonic clock measures real sleep time; the interpreter's virtual
// clock advances by the slept milliseconds, so the same assertion holds deterministically.
// Composes: std Clock and Time capabilities in a live render loop, carrier byte writes at a
// runtime index, and per-frame host output.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega_language_std::clock;
use omega_language_std::time;
use omega::language::core::binding;
domain [u8; 12]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    time: Time;
    line: [u8; 12] in Utf8;
    frame: u32 in Wrapping;
    pos: u32 in Wrapping;
    t_start: Instant;
    pause: [u8; 256];
}
machine Main::main(main: &mut Main) reaches Clock + Console {
    main.console.write_line("tick_marquee: a # sweeps 24 frames, then real elapsed time is asserted");
    main.t_start = Time::now(&mut main.time);
    main.frame = 0;
    transition { _ -> frame_loop(main) }
    state frame_loop(main: &mut Main) {
        transition main.frame < 24 { true -> draw(main) _ -> finish(main) }
    }
    state draw(main: &mut Main) {
        main.line = "            ";
        main.pos = main.frame % 12;
        transition main.pos < 12 { true -> put(main) _ -> finish(main) }
    }
    state put(main: &mut Main) {
        main.line[main.pos] = 35;
        main.console.write_line(main.line);
        main.clock.sleep(15);
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }
    state finish(main: &mut Main) {
        let elapsed: Duration = Time::elapsed_since(&mut main.time, main.t_start);
        transition elapsed.seconds == 0 {
            true -> check_subsecond(main, elapsed.subsecond_nanoseconds)
            false -> ok(main)
        }
    }
    state check_subsecond(main: &mut Main, subsecond_nanoseconds: u32) {
        transition subsecond_nanoseconds >= 100000000 { true -> ok(main) _ -> bad(main) }
    }
    state ok(main: &mut Main)  {
        main.console.write_line("PASS: 24 frames drawn and elapsed time >= 100ms (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: elapsed time came in under 100ms (exit 1)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(1);
    }
}
