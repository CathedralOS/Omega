// A tile-map / dungeon renderer -- the tile-based rendering shape a real game or map viewer uses.
// A flat array of `Cell` enums (Wall / Floor / Door / Water) is scanned row by row and each cell is
// classified by matching it DIRECTLY at a runtime index -- `transition main.grid[main.k] { Cell::Wall
// -> .. Cell::Water -> .. }` -- to pick its glyph, which is written into a `[u8;6]` carrier line
// buffer and flushed with `write_line` per row. This is the first sample to rely on the direct
// runtime-indexed ENUM-MATCH subject (fixed 2026-07-01): before that, a direct `grid[k] { .. }`
// silently took the first arm, so every cell would render as `#` and no `~`/`+`/`.` would appear.
//
// Composes: enum-array construction, the direct row-major `grid[r*6+c]` match subject (loop
// counters, so both prove in bounds -- no computed index), the direct enum-match subject, and
// runtime-indexed carrier byte writes. Pure compute + stdout, no new features. Renders:
//   ######
//   #.+..#
//   #.~..#
//   ######
//
// Expected exit: 0.
// Expected output contains: ~
use omega_language_std::console;
domain [u8; 6]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Cell {
    case Wall;
    case Floor;
    case Door;
    case Water;
}

data Main {
    grid: [Cell; 24];
    line: [u8; 6] in Utf8;
    r: u32 in Wrapping;   // current row
    c: u32 in Wrapping;   // current column (write index into the line buffer)
    lab: u8;              // glyph for the current cell
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("dungeon_render: a 6x4 tile map of enum cells rendered as # . + ~ glyphs");
    main.grid = [
        Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,
        Cell::Wall,  Cell::Floor, Cell::Door,  Cell::Floor, Cell::Floor, Cell::Wall,
        Cell::Wall,  Cell::Floor, Cell::Water, Cell::Floor, Cell::Floor, Cell::Wall,
        Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall
    ];
    main.r = 0;
    transition { _ -> row_loop(main) }

    state row_loop(main: &mut Main) {
        transition main.r < 4 { true -> col_start(main) _ -> done(main) }
    }
    state col_start(main: &mut Main) {
        main.c = 0;
        main.line = "      ";
        transition { _ -> col_loop(main) }
    }
    state col_loop(main: &mut Main) {
        transition main.c < 6 { true -> cell(main) _ -> emit_row(main) }
    }
    state cell(main: &mut Main) {
        // The DIRECT row-major index (R0 sweep 2026-07-11): one dominating guard on the
        // compound bound, then `grid[r * 6 + c]` as the MATCH SUBJECT -- the free-running
        // `k` counter and its re-guard state are gone (the match-subject position now
        // hoists computed indexes like every other position).
        transition main.r * 6 + main.c < 24 { true -> match_cell(main) _ -> emit_row(main) }
    }
    state match_cell(main: &mut Main) {
        // Direct runtime-indexed enum-match subject -- the tilemap classification.
        transition main.grid[main.r * 6 + main.c] {
            Cell::Wall  -> put(main, 35)   // '#'
            Cell::Floor -> put(main, 46)   // '.'
            Cell::Door  -> put(main, 43)   // '+'
            Cell::Water -> put(main, 126)  // '~'
        }
    }
    state put(main: &mut Main, ch: u8) {
        main.lab = ch;
        transition { _ -> write_cell(main) }
    }
    state write_cell(main: &mut Main) {
        main.line[main.c] = main.lab;
        main.c = main.c + 1;
        transition { _ -> col_loop(main) }
    }
    state emit_row(main: &mut Main) {
        Console::write_line(main.line);
        main.r = main.r + 1;
        transition { _ -> row_loop(main) }
    }
    state done(main: &mut Main) {
        Console::write_line("done: 4 rows rendered -- walls, floor, door and water all classified (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
}
