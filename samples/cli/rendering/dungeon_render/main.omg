// A tile-map / dungeon renderer -- the tile-based rendering shape a real game or map viewer uses.
// A flat array of `Cell` enums (Wall / Floor / Door / Water) is scanned row by row and each cell is
// classified by matching it DIRECTLY at a runtime index -- `transition self.grid[self.k] { Cell::Wall
// -> .. Cell::Water -> .. }` -- to pick its glyph, which is written into a `[u8;6]` carrier line
// buffer and flushed with `write_line` per row. This is the first sample to rely on the direct
// runtime-indexed ENUM-MATCH subject (fixed 2026-07-01): before that, a direct `grid[k] { .. }`
// silently took the first arm, so every cell would render as `#` and no `~`/`+`/`.` would appear.
//
// Composes: enum-array construction, a linear grid index + a per-row column index (both loop
// counters, so both prove in bounds -- no computed index), the direct enum-match subject, and
// runtime-indexed carrier byte writes. Pure compute + stdout, no new features. Renders:
//   ######
//   #.+..#
//   #.~..#
//   ######
//
// Expected exit: 0.
// Expected output contains: ~
use omega::language::std::console;
domain [u8; 6]::Utf8 when valid_utf8(self) {}

data Cell {
    case Wall;
    case Floor;
    case Door;
    case Water;
}

data Main {
    console: Console;
    grid: [Cell; 24];
    line: [u8; 6] in Utf8;
    r: u32 in Wrapping;   // current row
    c: u32 in Wrapping;   // current column (write index into the line buffer)
    k: u32 in Wrapping;   // linear index into the grid
    lab: u8;              // glyph for the current cell
    pause: String;
}

machine Main::main(&mut self) {
    self.console.write_line("dungeon_render: a 6x4 tile map of enum cells rendered as # . + ~ glyphs");
    self.grid = [
        Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,
        Cell::Wall,  Cell::Floor, Cell::Door,  Cell::Floor, Cell::Floor, Cell::Wall,
        Cell::Wall,  Cell::Floor, Cell::Water, Cell::Floor, Cell::Floor, Cell::Wall,
        Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall,  Cell::Wall
    ];
    self.k = 0;
    self.r = 0;
    transition { _ -> row_loop() }

    state row_loop(&mut self) {
        transition self.r < 4 { true -> col_start() _ -> done() }
    }
    state col_start(&mut self) {
        self.c = 0;
        self.line = "      ";
        transition { _ -> col_loop() }
    }
    state col_loop(&mut self) {
        transition self.c < 6 { true -> cell() _ -> emit_row() }
    }
    state cell(&mut self) {
        // Re-establish the grid index bound (k is a free-running counter across the nested loops,
        // so `k < 24` is not implied by `r < 4 && c < 6` -- the product bound is not proven).
        transition self.k < 24 { true -> match_cell() _ -> emit_row() }
    }
    state match_cell(&mut self) {
        // Direct runtime-indexed enum-match subject -- the tilemap classification.
        transition self.grid[self.k] {
            Cell::Wall  -> put(35)   // '#'
            Cell::Floor -> put(46)   // '.'
            Cell::Door  -> put(43)   // '+'
            Cell::Water -> put(126)  // '~'
        }
    }
    state put(&mut self, ch: u8) {
        self.lab = ch;
        transition { _ -> write_cell() }
    }
    state write_cell(&mut self) {
        self.line[self.c] = self.lab;
        self.k = self.k + 1;
        self.c = self.c + 1;
        transition { _ -> col_loop() }
    }
    state emit_row(&mut self) {
        self.console.write_line(self.line);
        self.r = self.r + 1;
        transition { _ -> row_loop() }
    }
    state done(&mut self) {
        self.console.write_line("done: 4 rows rendered -- walls, floor, door and water all classified (exit 0)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(0);
    }
}
