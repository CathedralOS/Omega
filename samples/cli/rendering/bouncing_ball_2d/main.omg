use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/clock.omg;
use {system}/console.omg;
// A 2D ball bouncing in a box under GRAVITY, animated in place -- the first physics
// SIMULATION (a continuous state integrated over time), as opposed to the
// static-per-frame fractals. Each frame homes the cursor (\x1b[H), redraws a 24x12
// grid one cell at a time (the Mandelbrot per-cell pattern: a single carrier write per
// cell whose value a guard decides), then integrates the physics -- gravity pulls vy
// down, position += velocity, and the ball bounces off the floor (losing energy),
// ceiling, and side walls -- and sleeps. Pure compute + stdout + Clock.sleep; no new
// compiler features: float arithmetic, float->int casts, field-vs-literal float
// guards, runtime-indexed carrier writes, and nested state-machine loops.
// Expected exit: 0.
// Expected output contains: O


data Main
requires
    0 <= self.frame && self.frame <= 70
    && 0 <= self.y && self.y <= 12
    && 0 <= self.x && self.x <= 24
{
    line: [u8; 24];
    home: [u8; 3];
    bx: f64;
    by: f64;
    vx: f64;
    vy: f64;
    ball_x: i32;         // cell coordinates of the ball; only compared, never
    ball_y: i32;         // fed to arithmetic
    frame: i32;          // guard-proven Exact frame counter
    y: i32;              // guard-proven Exact row counter
    x: i32;              // guard-proven Exact column counter
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |clock|::Clock + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("bouncing_ball_2d: a ball under gravity animated in a 24x12 box for 70 frames");
    main.line = "                        ";
    main.home = "XXX";
    main.home[0] = 27;
    main.home[1] = 91;
    main.home[2] = 72;
    main.bx = 3.0;
    main.by = 1.0;
    main.vx = 0.85;
    main.vy = 0.0;
    main.ball_x = 3;
    main.ball_y = 1;
    main.frame = 0;
    transition { _ -> block frame_loop(main) }

    machine frame_loop(main: @mutable Main) {
        transition main.frame < 70 { true -> block frame_start(main), _ -> block finish(main) }
    }
    machine frame_start(main: @mutable Main) {
        |console|::Console::write(@main.home[..]);
        main.y = 0;
        transition { _ -> block row_loop(main) }
    }

    // --- render a 24x12 grid, one CELL at a time (a single write per cell whose
    // value a guard decides), one row per write_line ---
    machine row_loop(main: @mutable Main) {
        transition main.y >= 0 && main.y < 12 { true -> block col_init(main), _ -> block after_frame(main) }
    }
    machine col_init(main: @mutable Main) {
        main.x = 0;
        transition { _ -> block col_loop(main) }
    }
    machine col_loop(main: @mutable Main) {
        transition main.x >= 0 && main.x < 24 { true -> block cell(main), _ -> block emit_row(main) }
    }
    machine cell(main: @mutable Main) {
        transition main.x == main.ball_x && main.y == main.ball_y {
            true -> block ball_cell(main),
            _ -> block space_cell(main)
        }
    }
    machine ball_cell(main: @mutable Main) {
        main.line[main.x] = 79;
        transition { _ -> block x_step(main) }
    }
    machine space_cell(main: @mutable Main) {
        main.line[main.x] = 32;
        transition { _ -> block x_step(main) }
    }
    // Re-guard before each counter increment (the ball/space branch and the
    // write_line call don't carry the loop bound), so the `+ 1`s prove Exact.
    machine x_step(main: @mutable Main) {
        transition main.x >= 0 && main.x < 24 { true -> block x_bump(main), _ -> block emit_row(main) }
    }
    machine x_bump(main: @mutable Main) {
        main.x = main.x + 1;
        transition { _ -> block col_loop(main) }
    }
    machine emit_row(main: @mutable Main) {
        |console|::Console::write_line(@main.line[..]);
        transition main.y >= 0 && main.y < 12 { true -> block y_bump(main), _ -> block row_loop(main) }
    }
    machine y_bump(main: @mutable Main) {
        main.y = main.y + 1;
        transition { _ -> block row_loop(main) }
    }

    // --- integrate the physics, then bounce off the four walls ---
    machine after_frame(main: @mutable Main) {
        main.vy = main.vy + 0.45;
        main.bx = main.bx + main.vx;
        main.by = main.by + main.vy;
        transition { _ -> block bounce_floor(main) }
    }
    machine bounce_floor(main: @mutable Main) {
        transition main.by >= 11.0 { true -> block floor_hit(main), _ -> block bounce_ceil(main) }
    }
    machine floor_hit(main: @mutable Main) {
        main.by = 11.0;
        main.vy = 0.0 - main.vy * 0.72;
        transition { _ -> block bounce_ceil(main) }
    }
    machine bounce_ceil(main: @mutable Main) {
        transition main.by <= 0.0 { true -> block ceil_hit(main), _ -> block bounce_walls(main) }
    }
    machine ceil_hit(main: @mutable Main) {
        main.by = 0.0;
        main.vy = 0.0 - main.vy;
        transition { _ -> block bounce_walls(main) }
    }
    machine bounce_walls(main: @mutable Main) {
        transition main.bx >= 23.0 { true -> block wall_right(main), _ -> block bounce_wall_left(main) }
    }
    machine wall_right(main: @mutable Main) {
        main.bx = 23.0;
        main.vx = 0.0 - main.vx;
        transition { _ -> block recompute(main) }
    }
    machine bounce_wall_left(main: @mutable Main) {
        transition main.bx <= 0.0 { true -> block wall_left(main), _ -> block recompute(main) }
    }
    machine wall_left(main: @mutable Main) {
        main.bx = 0.0;
        main.vx = 0.0 - main.vx;
        transition { _ -> block recompute(main) }
    }
    machine recompute(main: @mutable Main) {
        // Named saturating conversions truncate the float positions; the policy
        // then erases.
        let column: i32 in Saturating = |float_operations|::I32::from_f64(main.bx);
        let row: i32 in Saturating = |float_operations|::I32::from_f64(main.by);
        main.ball_x = column as i32;
        main.ball_y = row as i32;
        block |clock|::Clock::sleep(40);
        transition main.frame < 70 { true -> block frame_bump(main), _ -> block frame_loop(main) }
    }
    machine frame_bump(main: @mutable Main) {
        main.frame = main.frame + 1;
        transition { _ -> block frame_loop(main) }
    }

    machine finish(main: @mutable Main) {
        |console|::Console::write_line("done: 70 frames of gravity-bounce animation complete (exit 0)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |clock|::Clock + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
