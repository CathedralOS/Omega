// A 2D ball bouncing in a box under GRAVITY, animated in place -- the first physics
// SIMULATION (a continuous state integrated over time), as opposed to the
// static-per-frame fractals. Each frame homes the cursor (\x1b[H), redraws a 24x12
// grid one cell at a time (the Mandelbrot per-cell pattern: a single carrier write per
// cell whose value a guard decides), then integrates the physics -- gravity pulls vy
// down, position += velocity, and the ball bounces off the floor (losing energy),
// ceiling, and side walls -- and sleeps. Pure compute + stdout + Clock.sleep; no new
// compiler features: float arithmetic, float->int casts, field-vs-literal float
// guards, runtime-indexed carrier writes, and nested state-machine loops.
// Expected exit: 0.
// Expected output contains: O
use omega::language::core::float_operations;
use omega_language_std::console;
use omega_language_std::clock;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 24]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    line: [u8; 24] in Utf8;
    home: [u8; 3] in Utf8;
    bx: f64;
    by: f64;
    vx: f64;
    vy: f64;
    ball_x: i32;         // cell coordinates of the ball; only compared, never
    ball_y: i32;         // fed to arithmetic
    frame: i32;          // guard-proven Exact frame counter
    y: i32;              // guard-proven Exact row counter
    x: i32;              // guard-proven Exact column counter
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console {
    Console::write_line("bouncing_ball_2d: a ball under gravity animated in a 24x12 box for 70 frames");
    main.line = "                        ";
    main.home = "XXX";
    main.home[0] = 27;
    main.home[1] = 91;
    main.home[2] = 72;
    main.bx = 3.0;
    main.by = 1.0;
    main.vx = 0.85;
    main.vy = 0.0;
    main.ball_x = 3;
    main.ball_y = 1;
    main.frame = 0;
    transition { _ -> frame_loop(main) }

    state frame_loop(main: &mut Main) {
        transition main.frame < 70 { true -> frame_start(main) _ -> finish(main) }
    }
    state frame_start(main: &mut Main) {
        Console::write(main.home);
        main.y = 0;
        transition { _ -> row_loop(main) }
    }

    // --- render a 24x12 grid, one CELL at a time (a single write per cell whose
    // value a guard decides), one row per write_line ---
    state row_loop(main: &mut Main) {
        transition main.y >= 0 && main.y < 12 { true -> col_init(main) _ -> after_frame(main) }
    }
    state col_init(main: &mut Main) {
        main.x = 0;
        transition { _ -> col_loop(main) }
    }
    state col_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 24 { true -> cell(main) _ -> emit_row(main) }
    }
    state cell(main: &mut Main) {
        transition main.x == main.ball_x && main.y == main.ball_y {
            true -> ball_cell(main)
            _ -> space_cell(main)
        }
    }
    state ball_cell(main: &mut Main) {
        main.line[main.x] = 79;
        transition { _ -> x_step(main) }
    }
    state space_cell(main: &mut Main) {
        main.line[main.x] = 32;
        transition { _ -> x_step(main) }
    }
    // Re-guard before each counter increment (the ball/space branch and the
    // write_line call don't carry the loop bound), so the `+ 1`s prove Exact.
    state x_step(main: &mut Main) {
        transition main.x >= 0 && main.x < 24 { true -> x_bump(main) _ -> emit_row(main) }
    }
    state x_bump(main: &mut Main) {
        main.x = main.x + 1;
        transition { _ -> col_loop(main) }
    }
    state emit_row(main: &mut Main) {
        Console::write_line(main.line);
        transition main.y >= 0 && main.y < 12 { true -> y_bump(main) _ -> row_loop(main) }
    }
    state y_bump(main: &mut Main) {
        main.y = main.y + 1;
        transition { _ -> row_loop(main) }
    }

    // --- integrate the physics, then bounce off the four walls ---
    state after_frame(main: &mut Main) {
        main.vy = main.vy + 0.45;
        main.bx = main.bx + main.vx;
        main.by = main.by + main.vy;
        transition { _ -> bounce_floor(main) }
    }
    state bounce_floor(main: &mut Main) {
        transition main.by >= 11.0 { true -> floor_hit(main) _ -> bounce_ceil(main) }
    }
    state floor_hit(main: &mut Main) {
        main.by = 11.0;
        main.vy = 0.0 - main.vy * 0.72;
        transition { _ -> bounce_ceil(main) }
    }
    state bounce_ceil(main: &mut Main) {
        transition main.by <= 0.0 { true -> ceil_hit(main) _ -> bounce_walls(main) }
    }
    state ceil_hit(main: &mut Main) {
        main.by = 0.0;
        main.vy = 0.0 - main.vy;
        transition { _ -> bounce_walls(main) }
    }
    state bounce_walls(main: &mut Main) {
        transition main.bx >= 23.0 { true -> wall_right(main) _ -> bounce_wall_left(main) }
    }
    state wall_right(main: &mut Main) {
        main.bx = 23.0;
        main.vx = 0.0 - main.vx;
        transition { _ -> recompute(main) }
    }
    state bounce_wall_left(main: &mut Main) {
        transition main.bx <= 0.0 { true -> wall_left(main) _ -> recompute(main) }
    }
    state wall_left(main: &mut Main) {
        main.bx = 0.0;
        main.vx = 0.0 - main.vx;
        transition { _ -> recompute(main) }
    }
    state recompute(main: &mut Main) {
        // Named saturating conversions truncate the float positions; the policy
        // then erases.
        let column: i32 in Saturating = I32::from_f64(main.bx);
        let row: i32 in Saturating = I32::from_f64(main.by);
        main.ball_x = column as i32;
        main.ball_y = row as i32;
        Clock::sleep(40);
        transition main.frame < 70 { true -> frame_bump(main) _ -> frame_loop(main) }
    }
    state frame_bump(main: &mut Main) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }

    state finish(main: &mut Main) {
        Console::write_line("done: 70 frames of gravity-bounce animation complete (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
}
