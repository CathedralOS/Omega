use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Bouncing ball simulation: 1D integer physics, integer velocity, fixed box [0,9].
//
// Start: pos=0, vel=3
// Box:   [0, 9] inclusive (width 10)
// Step:  new_pos = pos + vel
//        if new_pos > 9: pos = 18 - new_pos, vel = -vel   (upper wall bounce)
//        elif new_pos < 0: pos = -new_pos, vel = -vel       (lower wall bounce)
//        else: pos = new_pos, vel unchanged
//
// 8 steps hand-verified:
//   init:   pos=0, vel=3
//   step 1: new=3,  ok    -> pos=3,  vel=3
//   step 2: new=6,  ok    -> pos=6,  vel=3
//   step 3: new=9,  ok    -> pos=9,  vel=3
//   step 4: new=12, >9    -> pos=18-12=6, vel=-3
//   step 5: new=6+(-3)=3, ok -> pos=3, vel=-3
//   step 6: new=3+(-3)=0, ok -> pos=0, vel=-3
//   step 7: new=0+(-3)=-3, <0 -> pos=3, vel=3
//   step 8: new=3+3=6, ok -> pos=6, vel=3
//
// Final: pos=6, exit = 6 + 64 = 70.
//
// Expected exit: 70.


data Sim [copy] {
    pos: i32 in Wrapping;
    vel: i32 in Wrapping;
}

data Main {
    s: Sim;
    pause: [u8; 256];
}

// Perform one step of the simulation.
// Computes new_pos = pos + vel, then applies bounce rules.
machine step(main: @mutable Main) {
    let new_pos: i32 in Wrapping = main.s.pos + main.s.vel;
    transition new_pos > 9 {
        true -> upper_bounce(main, new_pos),
        _ -> check_lower(main, new_pos)
    }

    machine upper_bounce(main: @mutable Main, new_pos: i32 in Wrapping) {
        // Reflect off upper wall: pos = 18 - new_pos, vel = -vel.
        main.s.pos = 18 - new_pos;
        let old_vel: i32 in Wrapping = main.s.vel;
        main.s.vel = 0 - old_vel;
    }

    machine check_lower(main: @mutable Main, new_pos: i32 in Wrapping) {
        transition new_pos < 0 {
            true -> lower_bounce(main, new_pos),
            _ -> move_normal(main, new_pos)
        }
    }

    machine lower_bounce(main: @mutable Main, new_pos: i32 in Wrapping) {
        // Reflect off lower wall: pos = -new_pos, vel = -vel.
        main.s.pos = 0 - new_pos;
        let old_vel: i32 in Wrapping = main.s.vel;
        main.s.vel = 0 - old_vel;
    }

    machine move_normal(main: @mutable Main, new_pos: i32 in Wrapping) {
        main.s.pos = new_pos;
    }
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("bouncing_ball: 1D integer physics -- 8 steps in a [0,9] box with wall reflection");
    // Initialize: pos=0, vel=3.
    main.s.pos = 0 as +Wrapping;
    main.s.vel = 3 as +Wrapping;

    // Run 8 steps.
    step(main);
    step(main);
    step(main);
    step(main);
    step(main);
    step(main);
    step(main);
    step(main);

    // After 8 steps: pos=6, vel=3.
    // Exit code = pos + 64 = 70.
    let code: i32 in Wrapping = main.s.pos + 64;

    transition code == 70 {
        true -> block good(main),
        _ -> block bad(main)
    }

    machine good(main: @mutable Main) {
        |console|::Console::write_line("PASS: ball at pos 6 after 8 steps, 6 + 64 == 70 (exit 70)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(70);
    }

    machine bad(main: @mutable Main) {
        |console|::Console::write_line("FAIL: final position wrong -- expected pos 6 (exit 71)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
