use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Animated Mandelbrot zoom -- a real-time software-rendered fractal that zooms into
// a seahorse-valley boundary point, redrawn in place via an ANSI cursor-home escape
// and paced by Clock.sleep. Combines the per-pixel f64 renderer, the carrier
// framebuffer, in-place console redraw, and timed animation -- the full stack.
// Expected exit: 0.
// Expected output contains: #
use omega\language\core\F64::from_i32;
use system\Console;
use system\Clock;


data Main
requires self.frame >= 0 && self.frame <= 12,
    self.x >= 0 && self.x <= 48,
    self.y >= 0 && self.y <= 22,
    self.k >= 0 && self.k <= 40
{
    row: [u8; 48];
    palette: [u8; 8];
    home: [u8; 3];
    frame: i32;
    span: f64;
    x: i32;
    y: i32;
    cr: f64;
    ci: f64;
    zr: f64;
    zi: f64;
    zr2: f64;
    zi2: f64;
    mag: f64;
    k: i32;
    idx: i32;
    ch: u8 in Wrapping;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches ProcessExit + Clock + StandardInput + StandardOutput {
    Console::write_line("mandelbrot_zoom: 12 animated frames zooming into seahorse valley");
    main.palette = " .:-=+*#";
    main.row = "................................................";
    main.home = "XXX";
    main.home[0] = 0x1B;
    main.home[1] = 0x5B;
    main.home[2] = 0x48;
    main.span = 3.0;
    main.frame = 0;
    transition { _ -> block frame_loop(main) }

    machine frame_loop(main: @mutable Main) {
        transition main.frame < 12 { true -> block frame_init(main), _ -> block finish(main) }
    }
    machine frame_init(main: @mutable Main) {
        Console::write(@main.home[..]);
        main.y = 0;
        transition { _ -> block row_loop(main) }
    }
    machine row_loop(main: @mutable Main) {
        transition main.y < 22 { true -> block col_init(main), _ -> block frame_end(main) }
    }
    machine col_init(main: @mutable Main) { main.x = 0; transition { _ -> block col_loop(main) } }
    machine col_loop(main: @mutable Main) {
        transition main.x >= 0 && main.x < 48 { true -> block pixel_init(main), _ -> block emit_row(main) }
    }
    machine pixel_init(main: @mutable Main) {
        main.cr = (F64::from_i32(main.x) / 48.0 - 0.5) * main.span - 0.743644;
        main.ci = (F64::from_i32(main.y) / 22.0 - 0.5) * main.span * 0.5 + 0.131826;
        main.zr = 0.0;
        main.zi = 0.0;
        main.k = 0;
        transition { _ -> block iter_loop(main) }
    }
    machine iter_loop(main: @mutable Main) {
        transition main.k < 40 { true -> block iter_test(main), _ -> block pixel_done(main) }
    }
    machine iter_test(main: @mutable Main) {
        main.zr2 = main.zr * main.zr;
        main.zi2 = main.zi * main.zi;
        main.mag = main.zr2 + main.zi2;
        transition main.mag > 4.0 { true -> block pixel_done(main), _ -> block iter_step(main) }
    }
    // Re-guard so the increment's direct edge proves `k + 1` lands in [1..=40].
    machine iter_step(main: @mutable Main) {
        main.zi = 2.0 * main.zr * main.zi + main.ci;
        main.zr = main.zr2 - main.zi2 + main.cr;
        transition main.k >= 0 && main.k < 40 { true -> block iter_advance(main), _ -> block pixel_done(main) }
    }
    machine iter_advance(main: @mutable Main) {
        main.k = main.k + 1;
        transition { _ -> block iter_loop(main) }
    }
    // Re-guard `0 <= k <= 40` so the shade arithmetic `k * 7 / 40` is exact --
    // k only counts up to the 40-step cap, so always true.
    machine pixel_done(main: @mutable Main) {
        transition main.k >= 0 && main.k <= 40 { true -> block pixel_shade(main), _ -> block bad(main) }
    }
    machine pixel_shade(main: @mutable Main) {
        main.idx = main.k * 7 / 40;
        transition main.idx >= 0 && main.idx < 8 && main.x >= 0 && main.x < 48 {
            true -> block write_pixel(main),
            _ -> block bad(main)
        }
    }
    machine write_pixel(main: @mutable Main) {
        main.ch = main.palette[main.idx] as u8 +Wrapping;
        main.row[main.x] = main.ch as u8;
        main.x = main.x + 1;
        transition { _ -> block col_loop(main) }
    }
    // Re-guard so the increment's direct edge proves `y + 1` lands in
    // [1..=22] under the standing owner domain.
    machine emit_row(main: @mutable Main) {
        Console::write_line(@main.row[..]);
        transition main.y >= 0 && main.y < 22 { true -> block row_advance(main), _ -> block frame_end(main) }
    }
    machine row_advance(main: @mutable Main) {
        main.y = main.y + 1;
        transition { _ -> block row_loop(main) }
    }
    // Re-guard so the increment's direct edge proves `frame + 1` lands in
    // [1..=12] under the standing owner domain.
    machine frame_end(main: @mutable Main) {
        block Clock::sleep(70);
        main.span = main.span * 0.62;
        transition main.frame >= 0 && main.frame < 12 { true -> block frame_advance(main), _ -> block finish(main) }
    }
    machine frame_advance(main: @mutable Main) {
        main.frame = main.frame + 1;
        transition { _ -> block frame_loop(main) }
    }
    machine finish(main: @mutable Main) {
        Console::write_line("PASS: 12 zoom frames rendered (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(0);
    }
    machine bad(main: @mutable Main) {
        Console::write_line("FAIL: internal bounds check failed (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Clock + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
