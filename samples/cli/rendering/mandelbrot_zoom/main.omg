// Animated Mandelbrot zoom -- a real-time software-rendered fractal that zooms into
// a seahorse-valley boundary point, redrawn in place via an ANSI cursor-home escape
// and paced by Clock.sleep. Combines the per-pixel f64 renderer, the carrier
// framebuffer, in-place console redraw, and timed animation -- the full stack.
// Expected exit: 0.
// Expected output contains: #
use omega::language::core::float_operations;
use omega_language_std::console;
use omega_language_std::clock;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 48]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    row: [u8; 48] in Utf8;
    palette: [u8; 8] in Utf8;
    home: [u8; 3] in Utf8;
    frame: i32;
    span: f64;
    x: i32;
    y: i32;
    cr: f64;
    ci: f64;
    zr: f64;
    zi: f64;
    zr2: f64;
    zi2: f64;
    mag: f64;
    k: i32;
    idx: i32;
    ch: u8 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console {
    Console::write_line("mandelbrot_zoom: 12 animated frames zooming into seahorse valley");
    main.palette = " .:-=+*#";
    main.row = "................................................";
    main.home = "XXX";
    main.home[0] = 27;
    main.home[1] = 91;
    main.home[2] = 72;
    main.span = 3.0;
    main.frame = 0;
    transition { _ -> frame_loop(main) }

    state frame_loop(main: &mut Main) {
        transition main.frame < 12 { true -> frame_init(main) _ -> finish(main) }
    }
    state frame_init(main: &mut Main) {
        Console::write(main.home);
        main.y = 0;
        transition { _ -> row_loop(main) }
    }
    state row_loop(main: &mut Main) {
        transition main.y < 22 { true -> col_init(main) _ -> frame_end(main) }
    }
    state col_init(main: &mut Main) { main.x = 0; transition { _ -> col_loop(main) } }
    state col_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 48 { true -> pixel_init(main) _ -> emit_row(main) }
    }
    state pixel_init(main: &mut Main) {
        main.cr = (F64::from_i32(main.x) / 48.0 - 0.5) * main.span - 0.743644;
        main.ci = (F64::from_i32(main.y) / 22.0 - 0.5) * main.span * 0.5 + 0.131826;
        main.zr = 0.0;
        main.zi = 0.0;
        main.k = 0;
        transition { _ -> iter_loop(main) }
    }
    state iter_loop(main: &mut Main) {
        transition main.k < 40 { true -> iter_test(main) _ -> pixel_done(main) }
    }
    state iter_test(main: &mut Main) {
        main.zr2 = main.zr * main.zr;
        main.zi2 = main.zi * main.zi;
        main.mag = main.zr2 + main.zi2;
        transition main.mag > 4.0 { true -> pixel_done(main) _ -> iter_step(main) }
    }
    // Re-guard so the increment's direct edge proves `k + 1` lands in [1..=40].
    state iter_step(main: &mut Main) {
        main.zi = 2.0 * main.zr * main.zi + main.ci;
        main.zr = main.zr2 - main.zi2 + main.cr;
        transition main.k >= 0 && main.k < 40 { true -> iter_advance(main) _ -> pixel_done(main) }
    }
    state iter_advance(main: &mut Main) {
        main.k = main.k + 1;
        transition { _ -> iter_loop(main) }
    }
    // Re-guard `0 <= k <= 40` so the shade arithmetic `k * 7 / 40` is exact --
    // k only counts up to the 40-step cap, so always true.
    state pixel_done(main: &mut Main) {
        transition main.k >= 0 && main.k <= 40 { true -> pixel_shade(main) _ -> bad(main) }
    }
    state pixel_shade(main: &mut Main) {
        main.idx = main.k * 7 / 40;
        transition main.idx >= 0 && main.idx < 8 && main.x >= 0 && main.x < 48 {
            true -> write_pixel(main)
            _ -> bad(main)
        }
    }
    state write_pixel(main: &mut Main) {
        main.ch = main.palette[main.idx] as u8 in Wrapping;
        main.row[main.x] = main.ch as u8;
        main.x = main.x + 1;
        transition { _ -> col_loop(main) }
    }
    // Re-guard so the increment's direct edge proves `y + 1` lands in
    // [1..=22] (the write_line call severs the row_loop guard anyway).
    state emit_row(main: &mut Main) {
        Console::write_line(main.row);
        transition main.y >= 0 && main.y < 22 { true -> row_advance(main) _ -> frame_end(main) }
    }
    state row_advance(main: &mut Main) {
        main.y = main.y + 1;
        transition { _ -> row_loop(main) }
    }
    // Re-guard so the increment's direct edge proves `frame + 1` lands in
    // [1..=12] (the sleep call severs the frame_loop guard anyway).
    state frame_end(main: &mut Main) {
        Clock::sleep(70);
        main.span = main.span * 0.62;
        transition main.frame >= 0 && main.frame < 12 { true -> frame_advance(main) _ -> finish(main) }
    }
    state frame_advance(main: &mut Main) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }
    state finish(main: &mut Main) {
        Console::write_line("PASS: 12 zoom frames rendered (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: internal bounds check failed (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
