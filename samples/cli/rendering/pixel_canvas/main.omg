// Pixel canvas: fixed array of structs with per-element field mutations.
//
// Exercises: a fixed-size array of structs ([Pixel; 4]) where each element
// has two fields (r: i32 in Saturating, g: i32 in Saturating), per-element field writes dispatched
// through a sub-machine using const-index dispatch, and a final sum/guard
// that reads across multiple struct elements.
//
// The canvas holds 4 pixels. Operations:
//   set_r(idx, val)  -- write the red channel of pixel[idx]
//   set_g(idx, val)  -- write the green channel of pixel[idx]
//
// Scripted sequence:
//   set_r(0, 10) -> pixels[0].r = 10
//   set_g(0, 5)  -> pixels[0].g = 5
//   set_r(1, 20) -> pixels[1].r = 20
//   set_g(1, 10) -> pixels[1].g = 10
//   set_r(2, 15) -> pixels[2].r = 15
//   set_g(2, 5)  -> pixels[2].g = 5
//   set_r(3, 5)  -> pixels[3].r = 5
//   set_g(3, 0)  -> pixels[3].g = 0
//
// Sum of all r+g values:
//   pixel[0]: 10+5=15
//   pixel[1]: 20+10=30
//   pixel[2]: 15+5=20
//   pixel[3]: 5+0=5
//   total = 15+30+20+5 = 70. Exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Pixel [copy] {
    r: i32 in Saturating;
    g: i32 in Saturating;
}

data Canvas [copy] {
    pixels: [Pixel; 4];
}

data Main {
    console: Console;
    canvas: Canvas;
    pause: [u8; 256];
}

// Write the red channel at the given pixel index (0..3).
machine Main::set_r(&mut self, idx: i32 in Saturating, val: i32 in Saturating) {
    transition idx == 0 {
        true -> r0(val)
        _ -> try_r1(idx, val)
    }

    state r0(&mut self, val: i32 in Saturating) { self.canvas.pixels[0].r = val; }

    state try_r1(&mut self, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 1 {
            true -> r1(val)
            _ -> try_r2(idx, val)
        }
    }

    state r1(&mut self, val: i32 in Saturating) { self.canvas.pixels[1].r = val; }

    state try_r2(&mut self, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 2 {
            true -> r2(val)
            _ -> r3(val)
        }
    }

    state r2(&mut self, val: i32 in Saturating) { self.canvas.pixels[2].r = val; }
    state r3(&mut self, val: i32 in Saturating) { self.canvas.pixels[3].r = val; }
}

// Write the green channel at the given pixel index (0..3).
machine Main::set_g(&mut self, idx: i32 in Saturating, val: i32 in Saturating) {
    transition idx == 0 {
        true -> g0(val)
        _ -> try_g1(idx, val)
    }

    state g0(&mut self, val: i32 in Saturating) { self.canvas.pixels[0].g = val; }

    state try_g1(&mut self, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 1 {
            true -> g1(val)
            _ -> try_g2(idx, val)
        }
    }

    state g1(&mut self, val: i32 in Saturating) { self.canvas.pixels[1].g = val; }

    state try_g2(&mut self, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 2 {
            true -> g2(val)
            _ -> g3(val)
        }
    }

    state g2(&mut self, val: i32 in Saturating) { self.canvas.pixels[2].g = val; }
    state g3(&mut self, val: i32 in Saturating) { self.canvas.pixels[3].g = val; }
}

machine Main::main(&mut self) {
    self.console.write_line("pixel_canvas: writing r/g channels of 4 pixel structs, then summing them");
    self.set_r(0, 10);
    self.set_g(0, 5);
    self.set_r(1, 20);
    self.set_g(1, 10);
    self.set_r(2, 15);
    self.set_g(2, 5);
    self.set_r(3, 5);
    self.set_g(3, 0);

    // Sum: (10+5) + (20+10) + (15+5) + (5+0) = 15+30+20+5 = 70.
    let p0: i32 in Saturating = self.canvas.pixels[0].r + self.canvas.pixels[0].g;
    let p1: i32 in Saturating = self.canvas.pixels[1].r + self.canvas.pixels[1].g;
    let p2: i32 in Saturating = self.canvas.pixels[2].r + self.canvas.pixels[2].g;
    let p3: i32 in Saturating = self.canvas.pixels[3].r + self.canvas.pixels[3].g;
    let total: i32 in Saturating = p0 + p1 + p2 + p3;

    transition total == 70 {
        true -> good()
        _ -> bad(total)
    }

    state good(&mut self) {
        self.console.write_line("PASS: channel sum is 70 (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad(&mut self, total: i32 in Saturating) {
        // Exit with a code that encodes the wrong total for debugging.
        self.console.write_line("FAIL: wrong channel sum (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
