// Pixel canvas: fixed array of structs with per-element field mutations.
//
// Exercises: a fixed-size array of structs ([Pixel; 4]) where each element
// has two fields (r: i32 in Saturating, g: i32 in Saturating), per-element field writes dispatched
// through a sub-machine using const-index dispatch, and a final sum/guard
// that reads across multiple struct elements.
//
// The canvas holds 4 pixels. Operations:
//   set_r(idx, val)  -- write the red channel of pixel[idx]
//   set_g(idx, val)  -- write the green channel of pixel[idx]
//
// Scripted sequence:
//   set_r(0, 10) -> pixels[0].r = 10
//   set_g(0, 5)  -> pixels[0].g = 5
//   set_r(1, 20) -> pixels[1].r = 20
//   set_g(1, 10) -> pixels[1].g = 10
//   set_r(2, 15) -> pixels[2].r = 15
//   set_g(2, 5)  -> pixels[2].g = 5
//   set_r(3, 5)  -> pixels[3].r = 5
//   set_g(3, 0)  -> pixels[3].g = 0
//
// Sum of all r+g values:
//   pixel[0]: 10+5=15
//   pixel[1]: 20+10=30
//   pixel[2]: 15+5=20
//   pixel[3]: 5+0=5
//   total = 15+30+20+5 = 70. Exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Pixel [copy] {
    r: i32 in Saturating;
    g: i32 in Saturating;
}

data Canvas [copy] {
    pixels: [Pixel; 4];
}

data Main {
    canvas: Canvas;
    pause: [u8; 256];
}

// Write the red channel at the given pixel index (0..3).
machine Main::set_r(main: &mut Main, idx: i32 in Saturating, val: i32 in Saturating) {
    transition idx == 0 {
        true -> r0(main, val)
        _ -> try_r1(main, idx, val)
    }

    state r0(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[0].r = val; }

    state try_r1(main: &mut Main, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 1 {
            true -> r1(main, val)
            _ -> try_r2(main, idx, val)
        }
    }

    state r1(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[1].r = val; }

    state try_r2(main: &mut Main, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 2 {
            true -> r2(main, val)
            _ -> r3(main, val)
        }
    }

    state r2(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[2].r = val; }
    state r3(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[3].r = val; }
}

// Write the green channel at the given pixel index (0..3).
machine Main::set_g(main: &mut Main, idx: i32 in Saturating, val: i32 in Saturating) {
    transition idx == 0 {
        true -> g0(main, val)
        _ -> try_g1(main, idx, val)
    }

    state g0(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[0].g = val; }

    state try_g1(main: &mut Main, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 1 {
            true -> g1(main, val)
            _ -> try_g2(main, idx, val)
        }
    }

    state g1(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[1].g = val; }

    state try_g2(main: &mut Main, idx: i32 in Saturating, val: i32 in Saturating) {
        transition idx == 2 {
            true -> g2(main, val)
            _ -> g3(main, val)
        }
    }

    state g2(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[2].g = val; }
    state g3(main: &mut Main, val: i32 in Saturating) { main.canvas.pixels[3].g = val; }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("pixel_canvas: writing r/g channels of 4 pixel structs, then summing them");
    Main::set_r(main, 0, 10);
    Main::set_g(main, 0, 5);
    Main::set_r(main, 1, 20);
    Main::set_g(main, 1, 10);
    Main::set_r(main, 2, 15);
    Main::set_g(main, 2, 5);
    Main::set_r(main, 3, 5);
    Main::set_g(main, 3, 0);

    // Sum: (10+5) + (20+10) + (15+5) + (5+0) = 15+30+20+5 = 70.
    let p0: i32 in Saturating = main.canvas.pixels[0].r + main.canvas.pixels[0].g;
    let p1: i32 in Saturating = main.canvas.pixels[1].r + main.canvas.pixels[1].g;
    let p2: i32 in Saturating = main.canvas.pixels[2].r + main.canvas.pixels[2].g;
    let p3: i32 in Saturating = main.canvas.pixels[3].r + main.canvas.pixels[3].g;
    let total: i32 in Saturating = p0 + p1 + p2 + p3;

    transition total == 70 {
        true -> good(main)
        _ -> bad(main, total)
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: channel sum is 70 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad(main: &mut Main, total: i32 in Saturating) {
        // Exit with a code that encodes the wrong total for debugging.
        Console::write_line("FAIL: wrong channel sum (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
