// An animated radial "ripple" -- concentric diamonds pulsing out from the centre of a
// 30x16 character field, the first per-CELL animated SHADER (every cell's brightness is
// a function of its position AND time, mapped through a brightness ramp), as opposed to
// the single-ball samples (one moving object) and the static-per-frame Mandelbrot.
//
// Per cell: Manhattan distance to the centre, scrolled by the frame counter, taken mod
// the 8-char ramp " .:-=+*#" (dim->bright). The ramp lookup uses a FIELD intermediate
// (self.c = ramp[level]; line[x] = self.c) -- a runtime-indexed READ into a scalar then
// a runtime-indexed WRITE from that scalar -- because the fused both-runtime-indexed
// form line[x] = ramp[level] is a known gap. Each frame homes the cursor (ESC[H),
// redraws the grid one row at a time, then sleeps. Pure compute + stdout + Clock.sleep;
// no new compiler features.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 30]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
domain [u8; 3]::Utf8
requires
    valid_utf8(self);
pub boundary trait Clock { machine sleep(milliseconds: u32); }

// FULLY EXACT -- no overflow domain anywhere: the counters are plain i32 with
// guard-proven increments (re-guard hops where the loop-head guard is several
// states upstream), the offsets/distance fold bounded from re-guards placed
// where joins drop the loop guards, and the ramp level folds through `% 8`
// (modulo bounds by the divisor).
data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    line: [u8; 30] in Utf8;   // one rendered row
    ramp: [u8; 8] in Utf8;    // " .:-=+*#"  dim -> bright
    home: [u8; 3] in Utf8;    // ESC [ H  (cursor home)
    frame: i32;
    y: i32;
    x: i32;
    dx: i32;                  // x - 15, then its magnitude; bounded by the re-guards
    dy: i32;                  // y - 8, then its magnitude; bounded by the re-guards
    dist: i32;                // dx + dy folds bounded from level_bounds' guard
    level: i32;               // (dist + frame) % 8 folds bounded; range-checked at `bounds`
    c: u8;
    pause: [u8; 256];
}

machine Main::main(&mut self) reaches Clock + Console {
    self.console.write_line("ripple_field: 60 frames of concentric diamond ripples shaded per cell");
    self.line = "                              ";
    self.ramp = " .:-=+*#";
    self.home = "XXX";
    self.home[0] = 27; // ESC
    self.home[1] = 91; // [
    self.home[2] = 72; // H
    self.frame = 0;
    transition { _ -> frame_loop() }

    state frame_loop(&mut self) {
        transition self.frame < 60 { true -> frame_start() _ -> finish() }
    }
    state frame_start(&mut self) {
        self.console.write(self.home);
        self.y = 0;
        transition { _ -> row_loop() }
    }

    // --- redraw the 30x16 grid one cell at a time, one row per write_line ---
    state row_loop(&mut self) {
        transition self.y >= 0 && self.y < 16 { true -> col_init() _ -> after_frame() }
    }
    state col_init(&mut self) {
        self.x = 0;
        transition { _ -> col_loop() }
    }
    state col_loop(&mut self) {
        transition self.x >= 0 && self.x < 30 { true -> cell() _ -> emit_row() }
    }
    // Re-assert the row bound: the row_loop guard sits behind the col_loop
    // join, so the offset arithmetic needs `y` bounded on its own edge.
    state cell(&mut self) {
        transition self.y >= 0 && self.y < 16 { true -> offsets() _ -> bad() }
    }
    state offsets(&mut self) {
        self.dx = self.x - 15; // offset from centre column
        self.dy = self.y - 8;  // offset from centre row
        transition { _ -> abs_dx() }
    }
    // Each abs step's guard also carries the offset's lower bound (always true:
    // dx >= -15, dy >= -8) so the negation is exact.
    state abs_dx(&mut self) {
        transition self.dx < 0 && self.dx >= -15 { true -> neg_dx() _ -> chk_dy() }
    }
    state neg_dx(&mut self) {
        self.dx = 0 - self.dx;
        transition { _ -> chk_dy() }
    }
    state chk_dy(&mut self) {
        transition self.dy < 0 && self.dy >= -8 { true -> neg_dy() _ -> level_bounds() }
    }
    state neg_dy(&mut self) {
        self.dy = 0 - self.dy;
        transition { _ -> level_bounds() }
    }
    // The two abs arms join here, so re-assert the folded magnitudes and the
    // frame counter on the direct edge into level_calc (always true: |dx| <= 15,
    // |dy| <= 8, 0 <= frame < 60).
    state level_bounds(&mut self) {
        transition self.dx >= 0 && self.dx <= 15 && self.dy >= 0 && self.dy <= 8
                && self.frame >= 0 && self.frame < 60 {
            true -> level_calc()
            _ -> bad()
        }
    }
    state level_calc(&mut self) {
        // Manhattan distance to centre (LINEAR in radius -> evenly spaced rings),
        // scrolled by time, mod the ramp length -> concentric diamonds pulsing out.
        self.dist = self.dx + self.dy;
        self.level = (self.dist + self.frame) % 8;
        transition { _ -> bounds() }
    }
    state bounds(&mut self) {
        // Re-assert both indices right before the write so the prover carries them the
        // single hop into write_cell (the col_loop guard is too many states back).
        transition self.x >= 0 && self.x < 30 && self.level >= 0 && self.level < 8 {
            true -> write_cell()
            _ -> bad()
        }
    }
    state write_cell(&mut self) {
        self.c = self.ramp[self.level]; // runtime-indexed READ into a scalar
        self.line[self.x] = self.c;     // runtime-indexed WRITE from that scalar
        self.x = self.x + 1;
        transition { _ -> col_loop() }
    }
    // write_line is a CALL, so re-guard `y < 16` afterwards: the direct edge into
    // y_bump is what proves the increment (y < 16 always holds inside the row
    // loop, so the else arm is unreachable).
    state emit_row(&mut self) {
        self.console.write_line(self.line);
        transition self.y < 16 { true -> y_bump() _ -> bad() }
    }
    state y_bump(&mut self) {
        self.y = self.y + 1;
        transition { _ -> row_loop() }
    }

    state after_frame(&mut self) {
        self.clock.sleep(40);
        // re-guard so the increment's edge carries the frame bound (the keystone
        // reads the DIRECT incoming edge; frame_loop's guard is far upstream).
        transition self.frame < 60 { true -> advance() _ -> finish() }
    }
    state advance(&mut self) {
        self.frame = self.frame + 1;
        transition { _ -> frame_loop() }
    }

    state finish(&mut self) {
        self.console.write_line("PASS: 60 ripple frames rendered (exit 0)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(0);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: cell index bounds guard tripped (exit 1)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(1);
    }
}
