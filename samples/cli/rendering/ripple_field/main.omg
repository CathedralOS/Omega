// An animated radial "ripple" -- concentric diamonds pulsing out from the centre of a
// 30x16 character field, the first per-CELL animated SHADER (every cell's brightness is
// a function of its position AND time, mapped through a brightness ramp), as opposed to
// the single-ball samples (one moving object) and the static-per-frame Mandelbrot.
//
// Per cell: Manhattan distance to the centre, scrolled by the frame counter, taken mod
// the 8-char ramp " .:-=+*#" (dim->bright). The ramp lookup uses a FIELD intermediate
// (main.c = ramp[level]; line[x] = main.c) -- a runtime-indexed READ into a scalar then
// a runtime-indexed WRITE from that scalar -- because the fused both-runtime-indexed
// form line[x] = ramp[level] is a known gap. Each frame homes the cursor (ESC[H),
// redraws the grid one row at a time, then sleeps. Pure compute + stdout + Clock.sleep;
// no new compiler features.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 30]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }

// Declared-host Clock wiring, the pattern `samples/gui/window_app` carries: a
// provider data, a target-scoped `provider_defaults` that selects it, and a
// `satisfies Clock::sleep` machine over the `darwin_poll` leaf. The provider
// holds no state: each call keeps its timeout and poll status in locals, where
// the static-machine contract places invocation scratch.
data PacingClockProvider { }
macos_arm64 machine PacingClockProvider::provider_defaults(defaults: &mut PacingClockProvider) {
    defaults.select_provider<Clock, PacingClockProvider>();
}
macos_arm64 machine PacingClockProvider::sleep(milliseconds: u32) satisfies Clock::sleep
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

// FULLY EXACT -- no overflow domain anywhere: the counters are plain i32 with
// guard-proven increments (re-guard hops where the loop-head guard is several
// states upstream), the offsets/distance fold bounded from re-guards placed
// where joins drop the loop guards, and the ramp level folds through `% 8`
// (modulo bounds by the divisor).
data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    line: [u8; 30] in Utf8;   // one rendered row
    ramp: [u8; 8] in Utf8;    // " .:-=+*#"  dim -> bright
    home: [u8; 3] in Utf8;    // ESC [ H  (cursor home)
    frame: i32;
    y: i32;
    x: i32;
    dx: i32;                  // x - 15, then its magnitude; bounded by the re-guards
    dy: i32;                  // y - 8, then its magnitude; bounded by the re-guards
    dist: i32;                // dx + dy folds bounded from level_bounds' guard
    level: i32;               // (dist + frame) % 8 folds bounded; range-checked at `bounds`
    c: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console + DarwinClock {
    main.console.write_line("ripple_field: 60 frames of concentric diamond ripples shaded per cell");
    main.line = "                              ";
    main.ramp = " .:-=+*#";
    main.home = "XXX";
    main.home[0] = 27; // ESC
    main.home[1] = 91; // [
    main.home[2] = 72; // H
    main.frame = 0;
    transition { _ -> frame_loop(main) }

    state frame_loop(main: &mut Main) {
        transition main.frame < 60 { true -> frame_start(main) _ -> finish(main) }
    }
    state frame_start(main: &mut Main) {
        main.console.write(main.home);
        main.y = 0;
        transition { _ -> row_loop(main) }
    }

    // --- redraw the 30x16 grid one cell at a time, one row per write_line ---
    state row_loop(main: &mut Main) {
        transition main.y >= 0 && main.y < 16 { true -> col_init(main) _ -> after_frame(main) }
    }
    state col_init(main: &mut Main) {
        main.x = 0;
        transition { _ -> col_loop(main) }
    }
    state col_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 30 { true -> cell(main) _ -> emit_row(main) }
    }
    // Re-assert the row bound: the row_loop guard sits behind the col_loop
    // join, so the offset arithmetic needs `y` bounded on its own edge.
    state cell(main: &mut Main) {
        transition main.y >= 0 && main.y < 16 { true -> offsets(main) _ -> bad(main) }
    }
    state offsets(main: &mut Main) {
        main.dx = main.x - 15; // offset from centre column
        main.dy = main.y - 8;  // offset from centre row
        transition { _ -> abs_dx(main) }
    }
    // Each abs step's guard also carries the offset's lower bound (always true:
    // dx >= -15, dy >= -8) so the negation is exact.
    state abs_dx(main: &mut Main) {
        transition main.dx < 0 && main.dx >= -15 { true -> neg_dx(main) _ -> chk_dy(main) }
    }
    state neg_dx(main: &mut Main) {
        main.dx = 0 - main.dx;
        transition { _ -> chk_dy(main) }
    }
    state chk_dy(main: &mut Main) {
        transition main.dy < 0 && main.dy >= -8 { true -> neg_dy(main) _ -> level_bounds(main) }
    }
    state neg_dy(main: &mut Main) {
        main.dy = 0 - main.dy;
        transition { _ -> level_bounds(main) }
    }
    // The two abs arms join here, so re-assert the folded magnitudes and the
    // frame counter on the direct edge into level_calc (always true: |dx| <= 15,
    // |dy| <= 8, 0 <= frame < 60).
    state level_bounds(main: &mut Main) {
        transition main.dx >= 0 && main.dx <= 15 && main.dy >= 0 && main.dy <= 8
                && main.frame >= 0 && main.frame < 60 {
            true -> level_calc(main)
            _ -> bad(main)
        }
    }
    state level_calc(main: &mut Main) {
        // Manhattan distance to centre (LINEAR in radius -> evenly spaced rings),
        // scrolled by time, mod the ramp length -> concentric diamonds pulsing out.
        main.dist = main.dx + main.dy;
        main.level = (main.dist + main.frame) % 8;
        transition { _ -> bounds(main) }
    }
    state bounds(main: &mut Main) {
        // Re-assert both indices right before the write so the prover carries them the
        // single hop into write_cell (the col_loop guard is too many states back).
        transition main.x >= 0 && main.x < 30 && main.level >= 0 && main.level < 8 {
            true -> write_cell(main)
            _ -> bad(main)
        }
    }
    state write_cell(main: &mut Main) {
        main.c = main.ramp[main.level]; // runtime-indexed READ into a scalar
        main.line[main.x] = main.c;     // runtime-indexed WRITE from that scalar
        main.x = main.x + 1;
        transition { _ -> col_loop(main) }
    }
    // write_line is a CALL, so re-guard `y < 16` afterwards: the direct edge into
    // y_bump is what proves the increment (y < 16 always holds inside the row
    // loop, so the else arm is unreachable).
    state emit_row(main: &mut Main) {
        main.console.write_line(main.line);
        transition main.y < 16 { true -> y_bump(main) _ -> bad(main) }
    }
    state y_bump(main: &mut Main) {
        main.y = main.y + 1;
        transition { _ -> row_loop(main) }
    }

    state after_frame(main: &mut Main) {
        main.clock.sleep(40);
        // re-guard so the increment's edge carries the frame bound (the keystone
        // reads the DIRECT incoming edge; frame_loop's guard is far upstream).
        transition main.frame < 60 { true -> advance(main) _ -> finish(main) }
    }
    state advance(main: &mut Main) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }

    state finish(main: &mut Main) {
        main.console.write_line("PASS: 60 ripple frames rendered (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: cell index bounds guard tripped (exit 1)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(1);
    }
}
