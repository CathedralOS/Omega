// Read unsigned decimal tokens with at most nine digits. Each token owns
// one finite record; EOF, a malformed byte, and excess digits reject explicitly.
use model/records/records.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
public machine read_token() -> |records|::Token
reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> block scan(0, 0) }
    machine scan(value: i64 in Saturating, digits: u64 in Saturating) -> |records|::Token {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> (|records|::Token { value: 0, valid: false }),
            |console|::ByteRead::Eof -> finish(value, digits),
            |console|::ByteRead::Byte { value as byte } -> block classify(value, digits, byte)
        }
    }
    machine classify(value: i64 in Saturating, digits: u64 in Saturating, byte: i32) -> |records|::Token {
        transition {
            byte == 32 || byte == 10 || byte == 13 || byte == 9 -> block space(value, digits),
            byte >= 48 && byte <= 57 && digits < 9 -> block append(value, digits, byte),
            _ -> (|records|::Token { value: 0, valid: false })
        }
    }
    machine space(value: i64 in Saturating, digits: u64 in Saturating) -> |records|::Token {
        transition digits > 0 {
            true -> (|records|::Token { value: value, valid: true }),
            false -> block scan(value, digits)
        }
    }
    machine append(value: i64 in Saturating, digits: u64 in Saturating, byte: i32) -> |records|::Token {
        let digit: i64 in Saturating = (byte as i64 +Saturating) - 48;
        transition { _ -> block scan(value * 10 + digit, digits + 1) }
    }
    machine finish(value: i64 in Saturating, digits: u64 in Saturating) -> |records|::Token {
        |records|::Token { value: value, valid: digits > 0 }
    }
}
// The complete stream ends after the declared records; surplus numeric data
// and malformed trailing characters are both rejected.
public machine at_end() -> bool
reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> block scan() }
    machine scan() -> bool {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> false,
            |console|::ByteRead::Eof -> (true),
            |console|::ByteRead::Byte { value } -> block whitespace(value)
        }
    }
    machine whitespace(value: i32) -> bool {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> block scan(),
            false -> (false)
        }
    }
}
