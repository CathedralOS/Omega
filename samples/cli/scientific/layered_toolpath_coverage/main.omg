use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// EOF oracle for the generic sample harness. Supplied valid fixtures exit 0.
// Expected exit: 64.
// Expected output contains: ERROR input
use domain\model;
use domain\model\Job;
use domain\input;
use domain\input\load;
use domain\paths;
use domain\paths\paths;
use domain\report;
use domain\report\audit;
use system\Console;
data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    let mutable job: Job;
    let valid: bool = block load(@mutable job);
    transition valid {
        true -> generate(main, @mutable job),
        _ -> invalid(main)
    }
    machine generate(main: @mutable Main, job: @mutable Job) {
        let complete: bool = paths(job);
        transition complete {
            true -> success(main, job),
            _ -> internal(main)
        }
    }
    machine success(main: @mutable Main, job: @Job) {
        audit(job);
        ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        Console::write_line("ERROR input");
        ProcessExit::exit_process(64);
    }
    machine internal(main: @mutable Main) {
        Console::write_line("ERROR internal bounds");
        ProcessExit::exit_process(70);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
