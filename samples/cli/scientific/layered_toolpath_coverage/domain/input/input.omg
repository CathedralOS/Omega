use domain/model/model.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
// A digit is one token. Whitespace is optional; EOF and other bytes are errors.
machine digit() -> i32 in Wrapping reaches |process_authority|::StandardInput {
    transition { _ -> read() }
    machine read() -> i32 in Wrapping {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> (0 - 1),
            |console|::ByteRead::Eof -> (0 - 1),
            |console|::ByteRead::Byte { value } -> classify(value)
        }
    }
    machine classify(value: i32) -> i32 in Wrapping {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> again(),
            _ -> number(value)
        }
    }
    machine again() -> i32 in Wrapping { transition { _ -> read() } }
    machine number(value: i32) -> i32 in Wrapping {
        transition value >= 48 && value <= 57 {
            true -> ((value as i32 +Wrapping) - 48),
            _ -> (0 - 1)
        }
    }
}
machine input_end() -> bool reaches |process_authority|::StandardInput {
    transition { _ -> read() }
    machine read() -> bool {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> false,
            |console|::ByteRead::Eof -> true,
            |console|::ByteRead::Byte { value } -> classify(value)
        }
    }
    machine classify(value: i32) -> bool {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> again(),
            _ -> false
        }
    }
    machine again() -> bool { transition { _ -> read() } }
}
public machine load(job: @mutable |model|::Job) -> bool reaches |process_authority|::StandardInput {
    job.width = block digit();
    job.height = block digit();
    job.layers = block digit();
    job.orientation = block digit();
    job.stride = block digit();
    transition job.width >= 1 && job.width <= 8 && job.height >= 1 && job.height <= 8
        && job.layers >= 1 && job.layers <= 4 && job.orientation >= 0
        && job.orientation <= 1 && job.stride >= 1 && job.stride <= 2 {
        true -> clear(job, 0),
        _ -> false
    }
    machine clear(job: @mutable |model|::Job, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 256 {
            true -> zero(job, index),
            _ -> cell(job, 0)
        }
    }
    machine zero(job: @mutable |model|::Job, index: i32 in Wrapping) -> bool {
        job.mask[index] = 0;
        job.covered[index] = 0;
        transition { _ -> clear(job, index + 1) }
    }
    machine cell(job: @mutable |model|::Job, index: i32 in Wrapping) -> bool {
        transition index < job.width * job.height * job.layers {
            true -> bounds(job, index),
            _ -> finish()
        }
    }
    machine finish() -> bool {
        let complete: bool = block input_end();
        complete
    }
    machine bounds(job: @mutable |model|::Job, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 256 {
            true -> read(job, index),
            _ -> false
        }
    }
    machine read(job: @mutable |model|::Job, index: i32 in Wrapping) -> bool {
        let value: i32 in Wrapping = block digit();
        transition value == 0 || value == 1 {
            true -> store(job, index, value),
            _ -> false
        }
    }
    machine store(job: @mutable |model|::Job, index: i32 in Wrapping, value: i32 in Wrapping) -> bool {
        job.mask[index] = value as i32;
        transition { _ -> cell(job, index + 1) }
    }
}
