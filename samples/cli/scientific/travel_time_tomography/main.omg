use omega::language::core::ProcessExit;
// Entrypoint owns bounded input, private inverse solution, and reporting.
use omega_language_std::Console;
use domain::model;
use domain::solver;
use io::input;
use io::report;

data Main { input: Input; output: Output; }
machine Main::main(main: &mut Main) reaches ProcessExit + Console {
    block read_input(&mut main.input);
    transition main.input.valid { true -> compute(main) false -> invalid(main) }
    machine compute(main: &mut Main) {
        let problem: Problem = problem_from_input(&main.input);
        let fit: Fit = solve(&problem);
        report(&mut main.output, &problem, &fit);
        ProcessExit::exit_process(0);
    }
    machine invalid(main: &mut Main) {
        Console::write_line("INVALID: expected 13 integers 0..99, ordered bounds, at most 255 input bytes");
        ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
