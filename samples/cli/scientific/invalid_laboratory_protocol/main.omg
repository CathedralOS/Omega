// Complete intended-invalid application: a runtime owner cannot bypass a
// statically declared lease precondition. This rejection is independent of
// invalid stdin, which the valid interpreter handles without compilation errors.
data Main { }
data Lease { owner: i32; }
machine release(lease: @mutable Lease, actor: i32)
requires lease.owner == actor
{
    lease.owner = 0;
}
machine main(main: @mutable Main) {
    let mutable lease: Lease = Lease { owner: 1 };
    release(@mutable lease, 2);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
