use model/integrator/integrator.omg;
use report/report/report.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 64 (empty stdin); valid data fixtures exit 0.
// Expected output contains: INVALID: expected scenario

data Main {
    pendulum: |integrator|::Pendulum;
    scenario: i32;
    step: i32;
    initial_energy: f64;
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("NEW021 constrained pendulum; signed micro-units; dt=0.01; gravity=9.81; mass=1");
    let input: |console|::ByteRead = block |console|::Console::read_byte();
    transition input {
        |console|::ByteRead::Error -> invalid(main),
        |console|::ByteRead::Byte { value } -> block scenario(main, value),
        |console|::ByteRead::Eof -> invalid(main)
    }
    machine scenario(main: @mutable Main, value: i32) {
        transition value >= 48 && value <= 51 {
            true -> block length_input(main, value - 48),
            false -> invalid(main)
        }
    }
    machine length_input(main: @mutable Main, scenario: i32) {
        main.scenario = scenario;
        let input: |console|::ByteRead = block |console|::Console::read_byte();
        transition input {
            |console|::ByteRead::Error -> invalid(main),
            |console|::ByteRead::Byte { value } -> block length(main, value),
            |console|::ByteRead::Eof -> invalid(main)
        }
    }
    machine length(main: @mutable Main, value: i32) {
        transition value {
            49 -> block unit_length(main),
            50 -> block double_length(main),
            _ -> invalid(main)
        }
    }
    machine unit_length(main: @mutable Main) {
        main.pendulum.length = 1.0;
        transition { _ -> block newline(main) }
    }
    machine double_length(main: @mutable Main) {
        main.pendulum.length = 2.0;
        transition { _ -> block newline(main) }
    }
    machine newline(main: @mutable Main) {
        let input: |console|::ByteRead = block |console|::Console::read_byte();
        transition input {
            |console|::ByteRead::Error -> invalid(main),
            |console|::ByteRead::Byte { value } -> block check_newline(main, value),
            |console|::ByteRead::Eof -> invalid(main)
        }
    }
    machine check_newline(main: @mutable Main, value: i32) {
        transition value == 10 {
            true -> block end_input(main),
            false -> invalid(main)
        }
    }
    machine end_input(main: @mutable Main) {
        let input: |console|::ByteRead = block |console|::Console::read_byte();
        transition input {
            |console|::ByteRead::Error -> invalid(main),
            |console|::ByteRead::Eof -> initialize(main),
            |console|::ByteRead::Byte { value } -> invalid(main)
        }
    }
    machine initialize(main: @mutable Main) {
        main.step = 0;
        main.pendulum.vx = 0.0;
        main.pendulum.vy = 0.0;
        transition main.scenario {
            0 -> equilibrium(main),
            1 -> small_angle(main),
            2 -> released(main),
            _ -> displaced(main)
        }
    }
    machine equilibrium(main: @mutable Main) {
        main.pendulum.x = 0.0;
        main.pendulum.y = 0.0 - main.pendulum.length;
        transition { _ -> project(main) }
    }
    machine small_angle(main: @mutable Main) {
        main.pendulum.x = 0.01 * main.pendulum.length;
        main.pendulum.y = 0.0 - |float_operations|::F64::square_root(main.pendulum.length * main.pendulum.length - main.pendulum.x * main.pendulum.x);
        transition { _ -> project(main) }
    }
    machine released(main: @mutable Main) {
        main.pendulum.x = 0.6 * main.pendulum.length;
        main.pendulum.y = 0.0 - 0.8 * main.pendulum.length;
        transition { _ -> project(main) }
    }
    machine displaced(main: @mutable Main) {
        main.pendulum.x = 0.66 * main.pendulum.length;
        main.pendulum.y = 0.0 - 0.88 * main.pendulum.length;
        main.pendulum.vx = 0.3;
        main.pendulum.vy = 0.4;
        transition { _ -> project(main) }
    }
    machine project(main: @mutable Main) {
        |integrator|::pendulum_project(@mutable main.pendulum);
        main.initial_energy = main.pendulum.energy;
        transition { _ -> row(main) }
    }
    machine row(main: @mutable Main) {
        |console|::Console::write("ROW ");
        |report|::print_micro(|float_operations|::F64::from_i32(main.step));
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.x);
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.y);
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.vx);
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.vy);
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.raw_drift);
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.drift);
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.tangent);
        |console|::Console::write(" ");
        |report|::print_micro(main.pendulum.energy);
        |console|::Console::write_line("");
        transition main.step >= 0 && main.step < 32 {
            true -> advance(main),
            false -> finish(main)
        }
    }
    machine advance(main: @mutable Main)
    requires main.step >= 0 && main.step < 32
    {
        main.step = main.step + 1;
        |integrator|::step(@mutable main.pendulum);
        transition { _ -> row(main) }
    }
    machine finish(main: @mutable Main) {
        |console|::Console::write("ENERGY_CHANGE ");
        |report|::print_micro(main.pendulum.energy - main.initial_energy);
        |console|::Console::write_line("");
        |console|::Console::write_line("COMPLETE 32 steps");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("INVALID: expected scenario 0..3, length 1..2, LF, EOF");
        |process_exit|::ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
