use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

data Invalid { }
machine unchecked_base(reference: @[u8; 8], position: u64) -> u8 {
    reference[position]
}
machine main(entry: @mutable Invalid) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable input: [u8; 8];
    let observed: |console|::ByteRead = block |console|::Console::read_byte();
    transition observed {
        |console|::ByteRead::Error -> |process_exit|::ProcessExit::exit_process(74),
        |console|::ByteRead::Byte { value } -> index(entry, @input, value as u64),
        |console|::ByteRead::Eof -> done(entry)
    }
    machine index(entry: @mutable Invalid, input: @[u8; 8], position: u64) {
        let base: u8 = unchecked_base(input, position);
        |console|::Console::write_byte(base as i32);
        transition { _ -> done(entry) }
    }
    machine done(entry: @mutable Invalid) { |process_exit|::ProcessExit::exit_process(0); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Invalid;
    block main(@mutable entry_storage);
}
