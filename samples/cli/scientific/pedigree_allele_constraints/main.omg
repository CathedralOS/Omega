use omega::language::core::ProcessExit;
// Complete console application. EOF terminates one bounded pedigree request.
// Empty stdin is an invalid request (the sample harness EOF case).
// Expected exit: 64.
// Expected output contains: INVALID INPUT
use omega_language_std::Console;
use domain::model;
use domain::model::Pedigree;
use domain::input;
use domain::input::read;
use domain::solver;
use domain::solver::Inference;
use domain::solver::initialize;
use domain::solver::enumerate;
use domain::solver::contradiction;
use domain::report;
use domain::report::emit;

data Main { }

machine main(main: &mut Main) reaches ProcessExit + Console {
    let mut pedigree: Pedigree;
    let accepted: bool = block read(&mut pedigree);
    transition accepted {
        true -> infer(main, &pedigree)
        _ -> invalid(main)
    }
    machine infer(main: &mut Main, pedigree: &Pedigree) {
        let mut result: Inference;
        initialize(pedigree, &mut result);
        enumerate(pedigree, &mut result);
        transition result.mass == 0 {
            true -> impossible(main, pedigree, &mut result)
            _ -> complete(main, pedigree, &result)
        }
    }
    machine impossible(main: &mut Main, pedigree: &Pedigree, result: &mut Inference) {
        contradiction(pedigree, result);
        emit(pedigree, result);
        ProcessExit::exit_process(2);
    }
    machine complete(main: &mut Main, pedigree: &Pedigree, result: &Inference) {
        emit(pedigree, result);
        ProcessExit::exit_process(0);
    }
    machine invalid(main: &mut Main) {
        Console::write_line("INVALID INPUT");
        ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    block main(&mut entry_storage);
}
