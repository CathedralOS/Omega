use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Complete console application. EOF terminates one bounded pedigree request.
// Empty stdin is an invalid request (the sample harness EOF case).
// Expected exit: 64.
// Expected output contains: INVALID INPUT
use system\Console;
use domain\model;
use domain\model\Pedigree;
use domain\input;
use domain\input\read;
use domain\solver;
use domain\solver\Inference;
use domain\solver\initialize;
use domain\solver\enumerate;
use domain\solver\contradiction;
use domain\report;
use domain\report\emit;

data Main { }

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    let mutable pedigree: Pedigree;
    let accepted: bool = block read(@mutable pedigree);
    transition accepted {
        true -> infer(main, @pedigree),
        _ -> invalid(main)
    }
    machine infer(main: @mutable Main, pedigree: @Pedigree) {
        let mutable result: Inference;
        initialize(pedigree, @mutable result);
        enumerate(pedigree, @mutable result);
        transition result.mass == 0 {
            true -> impossible(main, pedigree, @mutable result),
            _ -> complete(main, pedigree, @result)
        }
    }
    machine impossible(main: @mutable Main, pedigree: @Pedigree, result: @mutable Inference) {
        contradiction(pedigree, result);
        emit(pedigree, result);
        ProcessExit::exit_process(2);
    }
    machine complete(main: @mutable Main, pedigree: @Pedigree, result: @Inference) {
        emit(pedigree, result);
        ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        Console::write_line("INVALID INPUT");
        ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
