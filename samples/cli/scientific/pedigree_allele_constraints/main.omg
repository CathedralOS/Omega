use domain/input/input.omg;
use domain/model/model.omg;
use domain/report/report.omg;
use domain/solver/solver.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete console application. EOF terminates one bounded pedigree request.
// Empty stdin is an invalid request (the sample harness EOF case).
// Expected exit: 64.
// Expected output contains: INVALID INPUT

data Main { }

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable pedigree: |model|::Pedigree;
    let accepted: bool = block |input|::read(@mutable pedigree);
    transition accepted {
        true -> infer(main, @pedigree),
        _ -> invalid(main)
    }
    machine infer(main: @mutable Main, pedigree: @|model|::Pedigree) {
        let mutable result: |solver|::Inference;
        |solver|::initialize(pedigree, @mutable result);
        |solver|::enumerate(pedigree, @mutable result);
        transition result.mass == 0 {
            true -> impossible(main, pedigree, @mutable result),
            _ -> complete(main, pedigree, @result)
        }
    }
    machine impossible(main: @mutable Main, pedigree: @|model|::Pedigree, result: @mutable |solver|::Inference) {
        |solver|::contradiction(pedigree, result);
        |report|::emit(pedigree, result);
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine complete(main: @mutable Main, pedigree: @|model|::Pedigree, result: @|solver|::Inference) {
        |report|::emit(pedigree, result);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("INVALID INPUT");
        |process_exit|::ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
