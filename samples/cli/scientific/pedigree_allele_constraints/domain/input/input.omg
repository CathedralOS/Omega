use domain/model/model.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

// Deliberately small wire format: whitespace separated single decimal digits.
// Parse to an independent token buffer before touching pedigree storage.
data Tokens { values: [i32; 19]; count: i32 in Wrapping; separated: bool; }

public machine read(pedigree: @mutable |model|::Pedigree) -> bool
reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    let mutable tokens: Tokens;
    tokens.separated = true;
    let accepted: bool = block scan(@mutable tokens);
    transition accepted && tokens.count >= 1 {
        true -> header(pedigree, @tokens),
        _ -> false
    }
    machine header(pedigree: @mutable |model|::Pedigree, tokens: @Tokens) -> bool {
        pedigree.count = tokens.values[0] as i32 +Wrapping;
        transition pedigree.count >= 1 && pedigree.count <= 6 &&
                   tokens.count == 1 + 3 * pedigree.count {
            true -> row(pedigree, tokens, 0),
            _ -> false
        }
    }
    machine row(pedigree: @mutable |model|::Pedigree, tokens: @Tokens, index: i32 in Wrapping) -> bool {
        let position: i32 in Wrapping = 1 + 3 * index;
        transition index >= 0 && index < pedigree.count && index < 6 &&
                   position >= 1 && position + 2 < 19 {
            true -> copy(pedigree, tokens, index, position, position + 1, position + 2),
            _ -> |model|::valid(pedigree)
        }
    }
    machine copy(pedigree: @mutable |model|::Pedigree, tokens: @Tokens, index: i32 in Wrapping,
               first: i32 in Wrapping, second: i32 in Wrapping, third: i32 in Wrapping) -> bool {
        transition first >= 0 && first < 19 && second >= 0 && second < 19 && third >= 0 && third < 19 {
            true -> store(pedigree, tokens, index, first, second, third),
            _ -> false
        }
    }
    machine store(pedigree: @mutable |model|::Pedigree, tokens: @Tokens, index: i32 in Wrapping,
                first: i32 in Wrapping, second: i32 in Wrapping, third: i32 in Wrapping) -> bool {
        pedigree.father[index] = tokens.values[first];
        pedigree.mother[index] = tokens.values[second];
        pedigree.observed[index] = tokens.values[third];
        transition { _ -> row(pedigree, tokens, index + 1) }
    }
}

machine scan(tokens: @mutable Tokens) -> bool reaches |process_authority|::StandardInput {
    transition { _ -> byte(tokens) }
    machine byte(tokens: @mutable Tokens) -> bool {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> false,
            |console|::ByteRead::Eof -> true,
            |console|::ByteRead::Byte { value } -> classify(tokens, value)
        }
    }
    machine classify(tokens: @mutable Tokens, value: i32) -> bool {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> space(tokens),
            _ -> digit(tokens, value)
        }
    }
    machine space(tokens: @mutable Tokens) -> bool {
        tokens.separated = true;
        transition { _ -> byte(tokens) }
    }
    machine digit(tokens: @mutable Tokens, value: i32) -> bool {
        transition value >= 48 && value <= 57 && tokens.separated && tokens.count >= 0 && tokens.count < 19 {
            true -> store(tokens, value - 48),
            _ -> false
        }
    }
    machine store(tokens: @mutable Tokens, value: i32) -> bool {
        tokens.values[tokens.count] = value;
        tokens.count = tokens.count + 1;
        tokens.separated = false;
        transition { _ -> byte(tokens) }
    }
}
