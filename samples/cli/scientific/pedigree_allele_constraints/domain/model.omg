// Synthetic single-locus model. IDs are one-based; zero means founder.
// Observation bits 1,2,4 admit AA,AB,BB. No mutation or penetrance model.
public data Pedigree {
    count: i32 in Wrapping;
    father: [i32; 6];
    mother: [i32; 6];
    observed: [i32; 6];
}

public machine valid(pedigree: &Pedigree) -> bool {
    transition pedigree.count >= 1 && pedigree.count <= 6 {
        true -> person(pedigree, 0)
        _ -> false
    }
    machine person(pedigree: &Pedigree, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < pedigree.count && index < 6 {
            true -> inspect(pedigree, index)
            _ -> true
        }
    }
    machine inspect(pedigree: &Pedigree, index: i32 in Wrapping) -> bool {
        let father: i32 = pedigree.father[index];
        let mother: i32 = pedigree.mother[index];
        let observed: i32 = pedigree.observed[index];
        transition observed >= 1 && observed <= 7 &&
            ((father == 0 && mother == 0) ||
             (father >= 1 && father <= index && mother >= 1 && mother <= index && father != mother)) {
            true -> person(pedigree, index + 1)
            _ -> false
        }
    }
}

// Exactly four equally likely choices of parental chromosome copies.
public machine transmission(father: i32 in Wrapping, mother: i32 in Wrapping,
                         child: i32 in Wrapping) -> i32 in Wrapping {
    transition child {
        0 -> ((2 - father) * (2 - mother))
        1 -> (father * (2 - mother) + (2 - father) * mother)
        _ -> (father * mother)
    }
}
