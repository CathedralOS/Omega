use domain/tables/tables.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
machine decimal(value: u64 in Wrapping) reaches |process_authority|::StandardOutput {
    transition { _ -> scale(value, 1) }
    machine scale(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor <= value / 10 {
            true -> scale(value, divisor * 10),
            false -> emit(value, divisor)
        }
    }
    machine emit(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor > 0 { true -> digit(value, divisor), false -> done() }
    }
    machine digit(value: u64 in Wrapping, divisor: u64 in Wrapping)
    requires divisor > 0 {
        |console|::Console::write_byte((value / divisor % 10 + 48) as i32);
        transition { _ -> emit(value % divisor, divisor / 10) }
    }
    machine done() {}
}
machine field(name: @[u8], value: u64 in Wrapping) reaches |process_authority|::StandardOutput {
    |console|::Console::write(name);
    decimal(value);
    |console|::Console::write_line("");
}
public machine report(result: @|tables|::Inference) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_line("exact_contingency_inference model=fixed_margins_factorial structural_zeros=conditioned");
    field("feasible=", result.count);
    field("partition=", result.partition);
    field("observed_weight=", result.observed_weight);
    field("pearson_numerator=", result.score);
    field("pearson_denominator=", result.denominator);
    field("probability_tail_numerator=", result.probability_tail);
    field("association_tail_numerator=", result.association_tail);
    field("tail_denominator=", result.partition);
    field("association_ties=", result.ties);
}
