use omega::language::core::ProcessExit;
use omega_language_std::Console;
use omega_language_std::LineReadResult;
use domain::tables;
use domain::tables::Table;
use domain::tables::Model;
use domain::tables::Inference;
use domain::inference;
use domain::inference::analyze;
use io::report;
use io::report::report;
use controls::runtime_oracle;
use controls::runtime_oracle::frozen_numerical_control;

data Main { input: [u8; 19]; digits: [u64 in Wrapping; 17]; }
// One bounded record: 17 ASCII digits followed by LF, or exact-length EOF.
machine main(main: &mut Main) reaches ProcessExit + Console {
    let read: LineReadResult = block Console::read_line(&mut main.input[..]);
    transition read {
        LineReadResult::LineComplete { count } -> command(main, count)
        LineReadResult::EndOfInput { count } -> end(main, count)
        _ -> malformed(main)
    }
    machine command(main: &mut Main, count: u64) {
        transition count == 2 && main.input[0] == 33 && main.input[1] == 10 {
            true -> control(main)
            false -> line(main, count)
        }
    }
    machine control(main: &mut Main) { frozen_numerical_control(); }
    machine line(main: &mut Main, count: u64) {
        transition count == 18 && main.input[17] == 10 {
            true -> parse(main, 0)
            false -> malformed(main)
        }
    }
    machine end(main: &mut Main, count: u64) {
        transition count == 17 { true -> parse(main, 0) false -> malformed(main) }
    }
    machine parse(main: &mut Main, position: u64) {
        transition position < 17 {
            true -> character(main, position)
            false -> calculate(main)
        }
    }
    machine character(main: &mut Main, position: u64)
    requires position < 17 {
        let byte: u8 = main.input[position];
        transition byte >= 48 && byte <= 57 {
            true -> store(main, position, byte)
            false -> malformed(main)
        }
    }
    machine store(main: &mut Main, position: u64, byte: u8)
    requires position < 17 {
        main.digits[position] = (byte as u64 in Wrapping) - 48;
        transition { _ -> parse(main, position + 1) }
    }
    machine calculate(main: &mut Main) {
        let model: Model = Model {
            rows: [main.digits[0], main.digits[1]],
            columns: [main.digits[2], main.digits[3], main.digits[4]],
            observed: Table { cells: [main.digits[5], main.digits[6], main.digits[7], main.digits[8], main.digits[9], main.digits[10]] },
            zeros: [main.digits[11], main.digits[12], main.digits[13], main.digits[14], main.digits[15], main.digits[16]]
        };
        let result: Inference = analyze(&model);
        transition result.status {
            0 -> success(main, result)
            1 -> margins(main)
            2 -> impossible(main)
            3 -> observation(main)
            _ -> invariant(main)
        }
    }
    machine success(main: &mut Main, result: Inference) {
        report(&result);
        ProcessExit::exit_process(0);
    }
    machine malformed(main: &mut Main) { Console::write_line("ERROR malformed_record"); ProcessExit::exit_process(64); }
    machine margins(main: &mut Main) { Console::write_line("ERROR invalid_margins_or_mask"); ProcessExit::exit_process(65); }
    machine impossible(main: &mut Main) { Console::write_line("ERROR impossible_support"); ProcessExit::exit_process(66); }
    machine observation(main: &mut Main) { Console::write_line("ERROR invalid_observation"); ProcessExit::exit_process(67); }
    machine invariant(main: &mut Main) { Console::write_line("ERROR arithmetic_invariant"); ProcessExit::exit_process(70); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    block main(&mut entry_storage);
}
