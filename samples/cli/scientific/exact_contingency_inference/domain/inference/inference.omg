use domain/statistics/statistics.omg;
use domain/tables/tables.omg;
// Enumerate the first two cells; margins determine the remaining four.
// At most 81 candidates. Structural-zero conditioning renormalizes factorial weights.
public machine analyze(model: @|tables|::Model) -> |tables|::Inference {
    let mutable result: |tables|::Inference;
    transition |tables|::margins_valid(model) {
        true -> prepare(model, result),
        false -> rejected(result, 1)
    }
    machine rejected(mutable result: |tables|::Inference, status: i32) -> |tables|::Inference {
        result.status = status;
        result
    }
    machine prepare(model: @|tables|::Model, result: |tables|::Inference) -> |tables|::Inference {
        transition |tables|::table_valid(model, @model.observed) {
            true -> seed(model, result),
            false -> outer(model, result, 0)
        }
    }
    machine seed(model: @|tables|::Model, mutable result: |tables|::Inference) -> |tables|::Inference {
        result.observed_weight = |statistics|::table_weight(@model.observed, model.rows[0] + model.rows[1]);
        result.score = |statistics|::association_score(model, @model.observed);
        result.denominator = |statistics|::score_denominator(model);
        transition { _ -> outer(model, result, 0) }
    }
    machine outer(model: @|tables|::Model, result: |tables|::Inference, first: u64) -> |tables|::Inference {
        transition first < 9 {
            true -> inner(model, result, first, 0),
            false -> finish(model, result)
        }
    }
    machine inner(model: @|tables|::Model, result: |tables|::Inference, first: u64, second: u64) -> |tables|::Inference
    requires first < 9 {
        transition second < 9 {
            true -> candidate(model, result, first, second),
            false -> outer(model, result, first + 1)
        }
    }
    machine candidate(model: @|tables|::Model, result: |tables|::Inference, first: u64, second: u64) -> |tables|::Inference
    requires first < 9 && second < 9 {
        let a: u64 in Wrapping = first as +Wrapping;
        let b: u64 in Wrapping = second as +Wrapping;
        transition a + b <= model.rows[0] && a <= model.columns[0] && b <= model.columns[1] {
            true -> construct(model, result, first, second, a, b),
            false -> inner(model, result, first, second + 1)
        }
    }
    machine construct(model: @|tables|::Model, result: |tables|::Inference, first: u64, second: u64,
        a: u64 in Wrapping, b: u64 in Wrapping) -> |tables|::Inference
    requires first < 9 && second < 9 {
        let c: u64 in Wrapping = model.rows[0] - a - b;
        transition c <= model.columns[2] {
            true -> evaluate(model, result, first, second, |tables|::Table { cells: [a, b, c,
                model.columns[0] - a, model.columns[1] - b, model.columns[2] - c] }),
            false -> inner(model, result, first, second + 1)
        }
    }
    machine evaluate(model: @|tables|::Model, result: |tables|::Inference, first: u64, second: u64, table: |tables|::Table) -> |tables|::Inference
    requires first < 9 && second < 9 {
        transition |tables|::table_valid(model, @table) {
            true -> accumulate(model, result, first, second, table),
            false -> inner(model, result, first, second + 1)
        }
    }
    machine accumulate(model: @|tables|::Model, mutable result: |tables|::Inference, first: u64, second: u64, table: |tables|::Table) -> |tables|::Inference
    requires first < 9 && second < 9 {
        let weight: u64 in Wrapping = |statistics|::table_weight(@table, model.rows[0] + model.rows[1]);
        let score: u64 in Wrapping = |statistics|::association_score(model, @table);
        result.count = result.count + 1;
        result.partition = result.partition + weight;
        transition weight <= result.observed_weight {
            true -> probability(model, result, first, second, weight, score),
            false -> association(model, result, first, second, weight, score)
        }
    }
    machine probability(model: @|tables|::Model, mutable result: |tables|::Inference, first: u64, second: u64,
        weight: u64 in Wrapping, score: u64 in Wrapping) -> |tables|::Inference
    requires first < 9 && second < 9 {
        result.probability_tail = result.probability_tail + weight;
        transition { _ -> association(model, result, first, second, weight, score) }
    }
    machine association(model: @|tables|::Model, result: |tables|::Inference, first: u64, second: u64,
        weight: u64 in Wrapping, score: u64 in Wrapping) -> |tables|::Inference
    requires first < 9 && second < 9 {
        transition score >= result.score {
            true -> tail(model, result, first, second, weight, score),
            false -> inner(model, result, first, second + 1)
        }
    }
    machine tail(model: @|tables|::Model, mutable result: |tables|::Inference, first: u64, second: u64,
        weight: u64 in Wrapping, score: u64 in Wrapping) -> |tables|::Inference
    requires first < 9 && second < 9 {
        result.association_tail = result.association_tail + weight;
        transition score == result.score {
            true -> tie(model, result, first, second),
            false -> inner(model, result, first, second + 1)
        }
    }
    machine tie(model: @|tables|::Model, mutable result: |tables|::Inference, first: u64, second: u64) -> |tables|::Inference
    requires first < 9 && second < 9 {
        result.ties = result.ties + 1;
        transition { _ -> inner(model, result, first, second + 1) }
    }
    machine finish(model: @|tables|::Model, result: |tables|::Inference) -> |tables|::Inference {
        transition result.count == 0 {
            true -> rejected(result, 2),
            false -> observation(model, result)
        }
    }
    machine observation(model: @|tables|::Model, result: |tables|::Inference) -> |tables|::Inference {
        transition |tables|::table_valid(model, @model.observed) {
            true -> invariant(result),
            false -> rejected(result, 3)
        }
    }
    machine invariant(result: |tables|::Inference) -> |tables|::Inference {
        transition result.observed_weight > 0 && result.partition > 0 && result.denominator > 0 {
            true -> (result),
            false -> rejected(result, 4)
        }
    }
}
