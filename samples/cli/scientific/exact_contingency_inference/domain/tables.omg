// Private fixed-margin model. Every accepted margin is positive; N <= 8.
// Wrapping marks arithmetic whose full boundedness is established by input validation.
// No shared numerical package is imported.
public data Table [copy] { cells: [u64 in Wrapping; 6]; }
public data Model [copy] {
    rows: [u64 in Wrapping; 2];
    columns: [u64 in Wrapping; 3];
    zeros: [u64 in Wrapping; 6];
    observed: Table;
}
public data Inference [copy] {
    status: i32;
    count: u64 in Wrapping;
    partition: u64 in Wrapping;
    probability_tail: u64 in Wrapping;
    association_tail: u64 in Wrapping;
    ties: u64 in Wrapping;
    observed_weight: u64 in Wrapping;
    score: u64 in Wrapping;
    denominator: u64 in Wrapping;
}
public machine margins_valid(model: &Model) -> bool {
    model.rows[0] > 0 && model.rows[1] > 0 &&
    model.columns[0] > 0 && model.columns[1] > 0 && model.columns[2] > 0 &&
    model.rows[0] + model.rows[1] <= 8 &&
    model.rows[0] + model.rows[1] == model.columns[0] + model.columns[1] + model.columns[2] &&
    model.zeros[0] <= 1 && model.zeros[1] <= 1 && model.zeros[2] <= 1 &&
    model.zeros[3] <= 1 && model.zeros[4] <= 1 && model.zeros[5] <= 1
}
public machine table_valid(model: &Model, table: &Table) -> bool {
    table.cells[0] + table.cells[1] + table.cells[2] == model.rows[0] &&
    table.cells[3] + table.cells[4] + table.cells[5] == model.rows[1] &&
    table.cells[0] + table.cells[3] == model.columns[0] &&
    table.cells[1] + table.cells[4] == model.columns[1] &&
    table.cells[2] + table.cells[5] == model.columns[2] &&
    (model.zeros[0] == 0 || table.cells[0] == 0) &&
    (model.zeros[1] == 0 || table.cells[1] == 0) &&
    (model.zeros[2] == 0 || table.cells[2] == 0) &&
    (model.zeros[3] == 0 || table.cells[3] == 0) &&
    (model.zeros[4] == 0 || table.cells[4] == 0) &&
    (model.zeros[5] == 0 || table.cells[5] == 0)
}
