use domain::tables;
// Finite factorial table is a private arithmetic primitive, not an expected-result witness.
machine factorial(value: u64 in Wrapping) -> u64 in Wrapping {
    transition value {
        0 -> (1)
        1 -> (1)
        2 -> (2)
        3 -> (6)
        4 -> (24)
        5 -> (120)
        6 -> (720)
        7 -> (5040)
        8 -> (40320)
        _ -> (0)
    }
}
// Guard every runtime division. Zero is an invariant-failure marker checked by the caller.
machine quotient(numerator: u64 in Wrapping, denominator: u64 in Wrapping) -> u64 in Wrapping {
    transition denominator > 0 {
        true -> divide(numerator, denominator)
        false -> (0)
    }
    machine divide(numerator: u64 in Wrapping, denominator: u64 in Wrapping) -> u64 in Wrapping
    requires denominator > 0 { numerator / denominator }
}
public machine table_weight(table: &Table, total: u64 in Wrapping) -> u64 in Wrapping {
    let denominator: u64 in Wrapping = factorial(table.cells[0]) * factorial(table.cells[1]) *
        factorial(table.cells[2]) * factorial(table.cells[3]) * factorial(table.cells[4]) * factorial(table.cells[5]);
    quotient(factorial(total), denominator)
}
public machine score_denominator(model: &Model) -> u64 in Wrapping {
    (model.rows[0] + model.rows[1]) * model.rows[0] * model.rows[1] *
        model.columns[0] * model.columns[1] * model.columns[2]
}
machine contribution(cell: u64 in Wrapping, row: u64 in Wrapping,
    column: u64 in Wrapping, total: u64 in Wrapping, common: u64 in Wrapping) -> u64 in Wrapping {
    // Squaring a modular subtraction equals the ordinary signed square modulo 2^64.
    // Here the square and final sum are below 2^64, so this recovers the exact integer.
    let difference: u64 in Wrapping = total * cell - row * column;
    difference * difference * quotient(common, row * column)
}
public machine association_score(model: &Model, table: &Table) -> u64 in Wrapping {
    let total: u64 in Wrapping = model.rows[0] + model.rows[1];
    let common: u64 in Wrapping = model.rows[0] * model.rows[1] * model.columns[0] * model.columns[1] * model.columns[2];
    contribution(table.cells[0], model.rows[0], model.columns[0], total, common) +
    contribution(table.cells[1], model.rows[0], model.columns[1], total, common) +
    contribution(table.cells[2], model.rows[0], model.columns[2], total, common) +
    contribution(table.cells[3], model.rows[1], model.columns[0], total, common) +
    contribution(table.cells[4], model.rows[1], model.columns[1], total, common) +
    contribution(table.cells[5], model.rows[1], model.columns[2], total, common)
}
