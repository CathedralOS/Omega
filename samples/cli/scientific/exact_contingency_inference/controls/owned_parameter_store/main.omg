use {omega}/language/core/process_exit.omg;
// Complete main-only reproduction: return 7 after a direct owned state field store.
data Counter [copy] { value: u64; }
machine increment(counter: Counter) -> Counter {
    transition { _ -> update(counter) }
    machine update(mutable counter: Counter) -> Counter {
        counter.value = 7;
        counter
    }
}
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit {
    let counter: Counter = increment(Counter { value: 1 });
    transition counter.value == 7 { true -> good(main), false -> bad(main) }
    machine good(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(7); }
    machine bad(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
