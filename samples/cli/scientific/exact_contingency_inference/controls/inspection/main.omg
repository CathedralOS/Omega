// Complete dependency-free Terminal reproduction; no entry/provider acceptance.
data Counter [copy] { value: u64; untouched: u64; }
machine increment(counter: Counter) -> Counter {
    transition { _ -> update(counter) }
    machine update(mut counter: Counter) -> Counter {
        counter.value = 7;
        counter
    }
}
machine observe() -> bool {
    let counter: Counter = increment(Counter { value: 1, untouched: 11 });
    counter.value == 7 && counter.untouched == 11
}
machine main() { let value: bool = observe(); }
