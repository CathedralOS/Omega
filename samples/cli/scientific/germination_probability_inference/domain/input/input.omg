// Unsigned decimal integer tokens (1-3 digits), ASCII whitespace and EOF.
// The complete stream is bounded to 4096 bytes, including trailing whitespace.
use omega\language\core\StandardInput;
use system\ByteRead;
use system\Console;

public data Reader { consumed: i32; }
public data Number [copy] { valid: bool; value: i32 in Wrapping; }
public data Input { values: [i32 in Wrapping; 20]; count: i32 in Wrapping; }
machine whitespace(value: i32) -> bool { transition { _ -> (value == 32 || value == 9 || value == 10 || value == 13) } }
machine character(reader: @mutable Reader) -> i32 reaches StandardInput {
    transition reader.consumed >= 0 && reader.consumed < 4096 { true -> read(reader), _ -> -2 }
    machine read(reader: @mutable Reader) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        let byte: ByteRead = block Console::read_byte();
        transition byte { ByteRead::Error -> -2, ByteRead::Eof -> -1, ByteRead::Byte { value } -> counted(reader, value) }
    }
    machine counted(reader: @mutable Reader, value: i32) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        reader.consumed = reader.consumed + 1;
        transition { _ -> value }
    }
}
machine number(reader: @mutable Reader) -> Number reaches StandardInput {
    transition { _ -> start(reader) }
    machine start(reader: @mutable Reader) -> Number {
        let byte: i32 = block character(reader);
        transition whitespace(byte) { true -> start(reader), _ -> digits(reader, byte, 0, 0) }
    }
    machine digits(reader: @mutable Reader, byte: i32, value: i32 in Wrapping, count: i32 in Wrapping) -> Number {
        transition byte >= 48 && byte <= 57 && count < 3 {
            true -> append(reader, byte, value, count),
            _ -> finish(byte, value, count)
        }
    }
    machine append(reader: @mutable Reader, byte: i32, value: i32 in Wrapping, count: i32 in Wrapping) -> Number {
        let next: i32 in Wrapping = value * 10 + (byte as i32 +Wrapping) - 48;
        let observed: i32 = block character(reader);
        transition { _ -> digits(reader, observed, next, count + 1) }
    }
    machine finish(byte: i32, value: i32 in Wrapping, count: i32 in Wrapping) -> Number {
        transition count > 0 && (whitespace(byte) || byte == -1) {
            true -> Number { valid: true, value: value },
            _ -> Number { valid: false, value: 0 }
        }
    }
}
machine ended(reader: @mutable Reader) -> bool reaches StandardInput {
    let byte: i32 = block character(reader);
    transition byte == -1 { true -> true, _ -> space(reader, byte) }
    machine space(reader: @mutable Reader, byte: i32) -> bool {
        transition whitespace(byte) { true -> block ended(reader), _ -> false }
    }
}
public machine read_input(reader: @mutable Reader, input: @mutable Input) -> bool reaches StandardInput
invokes Console
blocks
crashes Trap
{
    input.count = 0;
    transition { _ -> headers(reader, input, 0) }
    machine headers(reader: @mutable Reader, input: @mutable Input, position: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 4 { true -> header(reader, input, position), _ -> shape(reader, input) }
    }
    machine header(reader: @mutable Reader, input: @mutable Input, position: i32 in Wrapping) -> bool {
        let item: Number = block number(reader);
        transition item.valid { true -> store_header(reader, input, position, item.value), _ -> false }
    }
    machine store_header(reader: @mutable Reader, input: @mutable Input, position: i32 in Wrapping, value: i32 in Wrapping) -> bool
    requires position >= 0 && position < 4
    {
        input.values[position] = value;
        transition { _ -> headers(reader, input, position + 1) }
    }
    machine shape(reader: @mutable Reader, input: @mutable Input) -> bool {
        let length: i32 in Wrapping = 4 + 2 * input.values[2];
        transition input.values[0] >= 1 && input.values[0] <= 20 && input.values[1] >= 1 && input.values[1] <= 20
            && input.values[2] >= 1 && input.values[2] <= 8 && input.values[3] >= 0 && input.values[3] <= 32 {
            true -> batches(reader, input, 4, length),
            _ -> false
        }
    }
    machine batches(reader: @mutable Reader, input: @mutable Input, position: i32 in Wrapping, length: i32 in Wrapping) -> bool {
        transition position >= 4 && position < 20 && position < length { true -> batch(reader, input, position, length), _ -> complete(reader, input, length) }
    }
    machine batch(reader: @mutable Reader, input: @mutable Input, position: i32 in Wrapping, length: i32 in Wrapping) -> bool {
        let item: Number = block number(reader);
        transition item.valid && item.value <= 50 { true -> store_batch(reader, input, position, length, item.value), _ -> false }
    }
    machine store_batch(reader: @mutable Reader, input: @mutable Input, position: i32 in Wrapping, length: i32 in Wrapping, value: i32 in Wrapping) -> bool
    requires position >= 4 && position < 20
    {
        input.values[position] = value;
        transition { _ -> batches(reader, input, position + 1, length) }
    }
    machine complete(reader: @mutable Reader, input: @mutable Input, length: i32 in Wrapping) -> bool {
        input.count = length;
        let finished: bool = block ended(reader);
        transition finished { true -> counts(input, 4), _ -> false }
    }
    machine counts(input: @Input, position: i32 in Wrapping) -> bool {
        transition position >= 4 && position < 19 && position < input.count { true -> pair(input, position), _ -> true }
    }
    machine pair(input: @Input, position: i32 in Wrapping) -> bool {
        transition input.values[position] <= input.values[position + 1] { true -> counts(input, position + 2), _ -> false }
    }
}
