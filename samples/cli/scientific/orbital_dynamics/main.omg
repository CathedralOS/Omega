use domain/orbit/orbit.omg;
use io/protocol/protocol.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 64 (empty stdin); valid orbital fixtures exit 0 or collision 2.
// Expected output contains: ERROR syntax

data Main { protocol: |protocol|::Protocol; orbit: |orbit|::Orbit; step: i32 in Wrapping; steps: i32 in Wrapping; time: f64; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let valid: bool = block |protocol|::read(@mutable main.protocol);
    transition valid { true -> validate(main), false -> syntax(main) }
    machine syntax(main: @mutable Main) {
        |console|::Console::write_line("ERROR syntax: seven finite decimal fields, maximum 512 bytes, EOF");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine validate(main: @mutable Main) {
        transition main.protocol.fields[0] > 0.0 && main.protocol.fields[0] <= 1000000.0
            && main.protocol.fields[1] >= -1000000.0 && main.protocol.fields[1] <= 1000000.0
            && main.protocol.fields[2] >= -1000000.0 && main.protocol.fields[2] <= 1000000.0
            && main.protocol.fields[3] >= -1000000.0 && main.protocol.fields[3] <= 1000000.0
            && main.protocol.fields[4] >= -1000000.0 && main.protocol.fields[4] <= 1000000.0
            && main.protocol.fields[5] > 0.0 && main.protocol.fields[5] <= 1.0
            && main.protocol.fields[6] == main.protocol.fields[6]
            && main.protocol.fields[6] >= 1.0 && main.protocol.fields[6] <= 4096.0 {
            true -> count(main, main.protocol.fields[6]), false -> range(main)
        }
    }
    machine range(main: @mutable Main) {
        |console|::Console::write_line("ERROR range: positive mu/dt, nonzero radius, bounded coordinates/velocity, integer steps 1..4096");
        |process_exit|::ProcessExit::exit_process(65);
    }
    machine count(main: @mutable Main, count: f64)
    requires count == count && count >= 1.0 && count <= 4096.0 {
        let steps: i32 = |float_operations|::I32::from_f64(count);
        transition |float_operations|::F64::from_i32(steps) == count { true -> configure(main, steps), false -> range(main) }
    }
    machine configure(main: @mutable Main, steps: i32) {
        main.steps = steps as i32 +Wrapping;
        main.step = 0; main.time = 0.0;
        main.orbit.parameter = main.protocol.fields[0];
        main.orbit.x = main.protocol.fields[1]; main.orbit.y = main.protocol.fields[2];
        main.orbit.vx = main.protocol.fields[3]; main.orbit.vy = main.protocol.fields[4];
        main.orbit.timestep = main.protocol.fields[5]; main.orbit.collision = false;
        transition main.orbit.x * main.orbit.x + main.orbit.y * main.orbit.y > 0.0 {
            true -> coordinates(main, main.orbit.x, main.orbit.y), false -> range(main)
        }
    }
    machine coordinates(main: @mutable Main, x: f64, y: f64) {
        transition x == x && x >= -1000000.0 && x <= 1000000.0
            && y == y && y >= -1000000.0 && y <= 1000000.0 {
            true -> bounded(main, x, y), false -> range(main)
        }
    }
    machine bounded(main: @mutable Main, x: f64, y: f64)
    requires x == x && x >= -1000000.0 && x <= 1000000.0
        && y == y && y >= -1000000.0 && y <= 1000000.0 {
        main.orbit.x = |orbit|::coordinate(x); main.orbit.y = |orbit|::coordinate(y);
        transition { _ -> radius(main) }
    }
    machine radius(main: @mutable Main) {
        transition main.orbit.x * main.orbit.x + main.orbit.y * main.orbit.y > 0.000000000001 {
            true -> initial(main), false -> collision(main)
        }
    }
    machine initial(main: @mutable Main) {
        |orbit|::diagnostics(@mutable main.orbit);
        main.orbit.initial_energy = main.orbit.energy;
        main.orbit.initial_momentum = main.orbit.momentum;
        |console|::Console::write_line("checkpoint,step,time,x,y,vx,vy,energy,angular_momentum,energy_drift,angular_momentum_drift");
        transition { _ -> checkpoint(main) }
    }
    machine checkpoint(main: @mutable Main) {
        |console|::Console::write("checkpoint,");
        |protocol|::integer(@mutable main.protocol, main.step);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.time);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.x);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.y);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.vx);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.vy);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.energy);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.momentum);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.energy - main.orbit.initial_energy);
        |console|::Console::write(",");
        |protocol|::number(@mutable main.protocol, main.orbit.momentum - main.orbit.initial_momentum);
        |console|::Console::write_line("");
        transition main.step < main.steps { true -> advance(main), false -> done(main) }
    }
    machine advance(main: @mutable Main) {
        |orbit|::step(@mutable main.orbit);
        transition main.orbit.collision { true -> collision(main), false -> advanced(main) }
    }
    machine advanced(main: @mutable Main) {
        main.step = main.step + 1;
        main.time = main.time + main.orbit.timestep;
        transition main.orbit.periapsis { true -> event(main), false -> checkpoint(main) }
    }
    machine event(main: @mutable Main) {
        |console|::Console::write("periapsis,");
        let time: f64 = main.time - main.orbit.timestep + main.orbit.event_fraction * main.orbit.timestep;
        |protocol|::number(@mutable main.protocol, time);
        |console|::Console::write_line("");
        transition { _ -> checkpoint(main) }
    }
    machine collision(main: @mutable Main) {
        |console|::Console::write_line("status,collision_threshold");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine done(main: @mutable Main) {
        |console|::Console::write_line("status,complete");
        |process_exit|::ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
