// Intended source-invalid: displacement index equals the array capacity.
data Main { displacement: [f64; 16]; }
machine main(main: @mutable Main) {
    let invalid: f64 = main.displacement[16];
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
