use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Expected exit: 0.
// Expected output contains: placement mask=0005 cost=0004 score=0012
use system\ByteRead;
use system\Console;
use domain\search;
use domain\search\solve;
use data\fixtures;
use data\fixtures\load;
data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    let input: ByteRead = block Console::read_byte();
    transition input {
        ByteRead::Error -> invalid(main),
        ByteRead::Eof -> execute(main, 0),
        ByteRead::Byte { value } -> command(main, value)
    }
    machine command(main: @mutable Main, value: i32) {
        transition value >= 48 && value <= 55 {
            true -> execute(main, (value - 48) as u64 +Wrapping),
            false -> invalid(main)
        }
    }
    machine execute(main: @mutable Main, variant: u64 in Wrapping) {
        let mutable problem: Problem;
        load(@mutable problem, variant);
        let mutable search: Search;
        solve(@mutable search, @problem);
        Console::write_line("spatial_sensor_deployment v1");
        Console::write("case="); number(main, variant); Console::write_byte(10);
        report(main, @search, @problem);
        ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        Console::write_line("invalid command: expected one byte 0..7 or EOF");
        ProcessExit::exit_process(64);
    }
}
// Four decimal digits keep the certificate format bounded and inspectable.
machine number(main: @mutable Main, value: u64 in Wrapping) reaches StandardOutput {
    Console::write_byte((((value / 1000) % 10) as i32) + 48);
    Console::write_byte((((value / 100) % 10) as i32) + 48);
    Console::write_byte((((value / 10) % 10) as i32) + 48);
    Console::write_byte(((value % 10) as i32) + 48);
}
machine report(main: @mutable Main, search: @Search, problem: @Problem) reaches StandardOutput {
    transition { _ -> row(main, search, problem, 0) }
    machine row(main: @mutable Main, search: @Search, problem: @Problem, mask: u64 in Wrapping) {
        transition mask < 8 {
            true -> emit(main, search, problem, mask),
            false -> placement(main, search, problem)
        }
    }
    machine emit(main: @mutable Main, search: @Search, problem: @Problem, mask: u64 in Wrapping) {
        Console::write("certificate mask="); number(main, mask);
        Console::write(" cost="); number(main, search.rows[mask].cost);
        Console::write(" score="); number(main, search.rows[mask].score);
        Console::write(" feasible="); number(main, search.rows[mask].feasible);
        Console::write(" code="); number(main, search.rows[mask].code);
        Console::write_byte(10);
        transition { _ -> row(main, search, problem, mask + 1) }
    }
    machine placement(main: @mutable Main, search: @Search, problem: @Problem) {
        Console::write("placement mask="); number(main, search.mask);
        Console::write(" cost="); number(main, search.cost);
        Console::write(" score="); number(main, search.score);
        Console::write(" code="); number(main, search.code);
        Console::write(" ties="); number(main, search.ties);
        Console::write(" status=");
        transition search.score >= problem.minimum {
            true -> status(main, search, 1),
            false -> status(main, search, 0)
        }
    }
    machine status(main: @mutable Main, search: @Search, accepted: u64 in Wrapping) {
        number(main, accepted); Console::write_byte(10);
        transition { _ -> demand(main, search.code, 0) }
    }
    machine demand(main: @mutable Main, remaining: u64 in Wrapping, position: u64 in Wrapping) {
        transition position < 4 {
            true -> coverage(main, remaining, position),
            false -> done()
        }
    }
    machine coverage(main: @mutable Main, remaining: u64 in Wrapping, position: u64 in Wrapping) {
        Console::write("demand="); number(main, position);
        Console::write(" site="); number(main, remaining % 4); Console::write_byte(10);
        transition { _ -> demand(main, remaining / 4, position + 1) }
    }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
