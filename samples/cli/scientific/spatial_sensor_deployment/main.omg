use data/fixtures/fixtures.omg;
use domain/search/search.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0.
// Expected output contains: placement mask=0005 cost=0004 score=0012
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let input: |console|::ByteRead = block |console|::Console::read_byte();
    transition input {
        |console|::ByteRead::Error -> invalid(main),
        |console|::ByteRead::Eof -> execute(main, 0),
        |console|::ByteRead::Byte { value } -> command(main, value)
    }
    machine command(main: @mutable Main, value: i32) {
        transition value >= 48 && value <= 55 {
            true -> execute(main, (value - 48) as u64 +Wrapping),
            false -> invalid(main)
        }
    }
    machine execute(main: @mutable Main, variant: u64 in Wrapping) {
        let mutable problem: Problem;
        |fixtures|::load(@mutable problem, variant);
        let mutable search: Search;
        |search|::solve(@mutable search, @problem);
        |console|::Console::write_line("spatial_sensor_deployment v1");
        |console|::Console::write("case="); number(main, variant); |console|::Console::write_byte(10);
        report(main, @search, @problem);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("invalid command: expected one byte 0..7 or EOF");
        |process_exit|::ProcessExit::exit_process(64);
    }
}
// Four decimal digits keep the certificate format bounded and inspectable.
machine number(main: @mutable Main, value: u64 in Wrapping) reaches |process_authority|::StandardOutput {
    |console|::Console::write_byte((((value / 1000) % 10) as i32) + 48);
    |console|::Console::write_byte((((value / 100) % 10) as i32) + 48);
    |console|::Console::write_byte((((value / 10) % 10) as i32) + 48);
    |console|::Console::write_byte(((value % 10) as i32) + 48);
}
machine report(main: @mutable Main, search: @Search, problem: @Problem) reaches |process_authority|::StandardOutput {
    transition { _ -> row(main, search, problem, 0) }
    machine row(main: @mutable Main, search: @Search, problem: @Problem, mask: u64 in Wrapping) {
        transition mask < 8 {
            true -> emit(main, search, problem, mask),
            false -> placement(main, search, problem)
        }
    }
    machine emit(main: @mutable Main, search: @Search, problem: @Problem, mask: u64 in Wrapping) {
        |console|::Console::write("certificate mask="); number(main, mask);
        |console|::Console::write(" cost="); number(main, search.rows[mask].cost);
        |console|::Console::write(" score="); number(main, search.rows[mask].score);
        |console|::Console::write(" feasible="); number(main, search.rows[mask].feasible);
        |console|::Console::write(" code="); number(main, search.rows[mask].code);
        |console|::Console::write_byte(10);
        transition { _ -> row(main, search, problem, mask + 1) }
    }
    machine placement(main: @mutable Main, search: @Search, problem: @Problem) {
        |console|::Console::write("placement mask="); number(main, search.mask);
        |console|::Console::write(" cost="); number(main, search.cost);
        |console|::Console::write(" score="); number(main, search.score);
        |console|::Console::write(" code="); number(main, search.code);
        |console|::Console::write(" ties="); number(main, search.ties);
        |console|::Console::write(" status=");
        transition search.score >= problem.minimum {
            true -> status(main, search, 1),
            false -> status(main, search, 0)
        }
    }
    machine status(main: @mutable Main, search: @Search, accepted: u64 in Wrapping) {
        number(main, accepted); |console|::Console::write_byte(10);
        transition { _ -> demand(main, search.code, 0) }
    }
    machine demand(main: @mutable Main, remaining: u64 in Wrapping, position: u64 in Wrapping) {
        transition position < 4 {
            true -> coverage(main, remaining, position),
            false -> done()
        }
    }
    machine coverage(main: @mutable Main, remaining: u64 in Wrapping, position: u64 in Wrapping) {
        |console|::Console::write("demand="); number(main, position);
        |console|::Console::write(" site="); number(main, remaining % 4); |console|::Console::write_byte(10);
        transition { _ -> demand(main, remaining / 4, position + 1) }
    }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
