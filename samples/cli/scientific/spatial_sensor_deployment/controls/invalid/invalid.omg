// Complete intended-invalid source: a record cannot retain duplicate exclusive loans.
data Sensor { capacity: i32; }
data Loans<'a> { left: &'a mut Sensor; right: &'a mut Sensor; }
data Main { sensor: Sensor; }
machine Main::main(main: &mut Main) -> i32 {
    main.sensor.capacity = 2;
    let loans: Loans = Loans { left: &mut main.sensor, right: &mut main.sensor };
    let observed: i32 = loans.right.capacity;
    observed
}
