// Private finite scientific model. Coordinates are synthetic integer grid units.
// Radius is closed Euclidean distance; a served demand consumes one capacity unit.
// Arithmetic carriers are wrapping, but fixtures keep every intermediate below 1000.
data Site { x: i32 in Wrapping; y: i32 in Wrapping; cost: u64 in Wrapping;
    capacity: u64 in Wrapping; radius: i32 in Wrapping; }
data Demand { x: i32 in Wrapping; y: i32 in Wrapping; weight: u64 in Wrapping; }
data Problem { sites: [Site; 3]; demands: [Demand; 4]; budget: u64 in Wrapping;
    minimum: u64 in Wrapping; powers: [u64 in Wrapping; 3]; }
data Certificate { cost: u64 in Wrapping; score: u64 in Wrapping;
    feasible: u64 in Wrapping; code: u64 in Wrapping; }
data Search { rows: [Certificate; 8]; mask: u64 in Wrapping; cost: u64 in Wrapping;
    score: u64 in Wrapping; code: u64 in Wrapping; ties: u64 in Wrapping; }
data Evaluation { loads: [u64 in Wrapping; 3]; score: u64 in Wrapping; }
