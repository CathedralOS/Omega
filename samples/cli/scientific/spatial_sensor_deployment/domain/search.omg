use domain::model;
// Exhaust each of 8 deployments and 256 demand assignments. No greedy coverage
// shortcut: capacities couple demand choices. Assignment digit 0 means unserved.
machine evaluate(problem: &Problem, work: &mut Evaluation,
                 mask: u64 in Wrapping, code: u64 in Wrapping) -> bool {
    work.loads[0] = 0; work.loads[1] = 0; work.loads[2] = 0; work.score = 0;
    transition { _ -> demand(problem, work, mask, code, 0) }
    machine demand(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                 remaining: u64 in Wrapping, position: u64 in Wrapping) -> bool {
        transition position < 4 {
            true -> digit(problem, work, mask, remaining, position)
            false -> true
        }
    }
    machine digit(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                remaining: u64 in Wrapping, position: u64 in Wrapping) -> bool {
        let assigned: u64 in Wrapping = remaining % 4;
        transition assigned > 0 && assigned <= 3 {
            true -> bounds(problem, work, mask, remaining, position, assigned - 1)
            false -> demand(problem, work, mask, remaining / 4, position + 1)
        }
    }
    machine bounds(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                 remaining: u64 in Wrapping, position: u64 in Wrapping,
                 site: u64 in Wrapping) -> bool {
        transition position < 4 && site < 3 {
            true -> geometric(problem, work, mask, remaining, position, site)
            false -> false
        }
    }
    machine geometric(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                    remaining: u64 in Wrapping, position: u64 in Wrapping,
                    site: u64 in Wrapping) -> bool {
        let divisor: u64 in Wrapping = problem.powers[site];
        let dx: i32 in Wrapping = problem.sites[site].x - problem.demands[position].x;
        let dy: i32 in Wrapping = problem.sites[site].y - problem.demands[position].y;
        let radius: i32 in Wrapping = problem.sites[site].radius;
        transition divisor > 0 {
            true -> selected(problem, work, mask, remaining, position, site, divisor, dx * dx + dy * dy, radius * radius)
            false -> false
        }
    }
    machine selected(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                   remaining: u64 in Wrapping, position: u64 in Wrapping,
                   site: u64 in Wrapping, divisor: u64 in Wrapping,
                   distance: i32 in Wrapping, radius: i32 in Wrapping) -> bool {
        transition position < 4 && site < 3 && divisor > 0 {
            true -> admissible(problem, work, mask, remaining, position, site, divisor, distance, radius)
            false -> false
        }
    }
    machine admissible(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                     remaining: u64 in Wrapping, position: u64 in Wrapping,
                     site: u64 in Wrapping, divisor: u64 in Wrapping,
                     distance: i32 in Wrapping, radius: i32 in Wrapping) -> bool {
        transition (mask / divisor) % 2 == 1 && distance <= radius
                   && work.loads[site] < problem.sites[site].capacity {
            true -> serve(problem, work, mask, remaining, position, site)
            false -> false
        }
    }
    machine serve(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                remaining: u64 in Wrapping, position: u64 in Wrapping,
                site: u64 in Wrapping) -> bool {
        transition position < 4 && site < 3 {
            true -> store(problem, work, mask, remaining, position, site)
            false -> false
        }
    }
    machine store(problem: &Problem, work: &mut Evaluation, mask: u64 in Wrapping,
                remaining: u64 in Wrapping, position: u64 in Wrapping,
                site: u64 in Wrapping) -> bool {
        work.loads[site] = work.loads[site] + 1;
        work.score = work.score + problem.demands[position].weight;
        transition { _ -> demand(problem, work, mask, remaining / 4, position + 1) }
    }
}

machine deployment_cost(problem: &Problem, mask: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> scan(problem, mask, 0, 0) }
    machine scan(problem: &Problem, remaining: u64 in Wrapping, site: u64 in Wrapping,
               cost: u64 in Wrapping) -> u64 in Wrapping {
        transition site < 3 {
            true -> item(problem, remaining, site, cost)
            false -> cost
        }
    }
    machine item(problem: &Problem, remaining: u64 in Wrapping, site: u64 in Wrapping,
               cost: u64 in Wrapping) -> u64 in Wrapping {
        transition remaining % 2 == 1 {
            true -> add(problem, remaining, site, cost)
            false -> scan(problem, remaining / 2, site + 1, cost)
        }
    }
    machine add(problem: &Problem, remaining: u64 in Wrapping, site: u64 in Wrapping,
              cost: u64 in Wrapping) -> u64 in Wrapping {
        transition site < 3 {
            true -> scan(problem, remaining / 2, site + 1, cost + problem.sites[site].cost)
            false -> cost
        }
    }
}

machine Search::solve(search: &mut Search, problem: &Problem) {
    search.mask = 0; search.cost = 0; search.score = 0; search.code = 0; search.ties = 0;
    transition { _ -> subset(search, problem, 0) }
    machine subset(search: &mut Search, problem: &Problem, mask: u64 in Wrapping) {
        transition mask < 8 {
            true -> initialize(search, problem, mask)
            false -> done()
        }
    }
    machine initialize(search: &mut Search, problem: &Problem, mask: u64 in Wrapping) {
        let cost: u64 in Wrapping = deployment_cost(problem, mask);
        search.rows[mask].cost = cost; search.rows[mask].score = 0;
        search.rows[mask].feasible = 0; search.rows[mask].code = 0;
        transition cost <= problem.budget {
            true -> assignment(search, problem, mask, 0)
            false -> subset(search, problem, mask + 1)
        }
    }
    machine assignment(search: &mut Search, problem: &Problem, mask: u64 in Wrapping,
                     code: u64 in Wrapping) {
        transition code < 256 && mask < 8 {
            true -> test(search, problem, mask, code)
            false -> compare(search, problem, mask)
        }
    }
    machine test(search: &mut Search, problem: &Problem, mask: u64 in Wrapping,
               code: u64 in Wrapping) {
        let mut work: Evaluation;
        let valid: bool = evaluate(problem, &mut work, mask, code);
        transition valid {
            true -> count(search, problem, mask, code, work.score)
            false -> assignment(search, problem, mask, code + 1)
        }
    }
    machine count(search: &mut Search, problem: &Problem, mask: u64 in Wrapping,
                code: u64 in Wrapping, score: u64 in Wrapping) {
        transition mask < 8 {
            true -> tally(search, problem, mask, code, score)
            false -> done()
        }
    }
    machine tally(search: &mut Search, problem: &Problem, mask: u64 in Wrapping,
                code: u64 in Wrapping, score: u64 in Wrapping) {
        search.rows[mask].feasible = search.rows[mask].feasible + 1;
        transition score > search.rows[mask].score {
            true -> improve(search, problem, mask, code, score)
            false -> assignment(search, problem, mask, code + 1)
        }
    }
    machine improve(search: &mut Search, problem: &Problem, mask: u64 in Wrapping,
                  code: u64 in Wrapping, score: u64 in Wrapping) {
        transition mask < 8 {
            true -> save(search, problem, mask, code, score)
            false -> done()
        }
    }
    machine save(search: &mut Search, problem: &Problem, mask: u64 in Wrapping,
               code: u64 in Wrapping, score: u64 in Wrapping) {
        search.rows[mask].score = score; search.rows[mask].code = code;
        transition { _ -> assignment(search, problem, mask, code + 1) }
    }
    machine compare(search: &mut Search, problem: &Problem, mask: u64 in Wrapping) {
        transition mask < 8 {
            true -> rank(search, problem, mask)
            false -> done()
        }
    }
    machine rank(search: &mut Search, problem: &Problem, mask: u64 in Wrapping) {
        let score: u64 in Wrapping = search.rows[mask].score;
        let cost: u64 in Wrapping = search.rows[mask].cost;
        transition score > search.score || (score == search.score && cost < search.cost) {
            true -> winner(search, problem, mask)
            false -> tied(search, problem, mask, score, cost)
        }
    }
    machine winner(search: &mut Search, problem: &Problem, mask: u64 in Wrapping) {
        transition mask < 8 {
            true -> publish(search, problem, mask)
            false -> done()
        }
    }
    machine publish(search: &mut Search, problem: &Problem, mask: u64 in Wrapping) {
        search.mask = mask; search.cost = search.rows[mask].cost;
        search.score = search.rows[mask].score; search.code = search.rows[mask].code; search.ties = 1;
        transition { _ -> subset(search, problem, mask + 1) }
    }
    machine tied(search: &mut Search, problem: &Problem, mask: u64 in Wrapping,
               score: u64 in Wrapping, cost: u64 in Wrapping) {
        transition score == search.score && cost == search.cost {
            true -> tie(search, problem, mask)
            false -> subset(search, problem, mask + 1)
        }
    }
    machine tie(search: &mut Search, problem: &Problem, mask: u64 in Wrapping) {
        search.ties = search.ties + 1;
        transition { _ -> subset(search, problem, mask + 1) }
    }
    machine done() { }
}
