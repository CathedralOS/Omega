use domain::model;
use omega::language::core::float_operations;
public machine qualify(a: &mut Analysis) {
 a.residual = 0.0; a.orthogonality = 0.0; a.error = 0.0;
 transition { _ -> matrix(a, 0, 0, 0.0, 0.0) }
 machine matrix(a: &mut Analysis, index: u64 in Wrapping, column: u64 in Wrapping, residual: f64, orthogonality: f64) {
  transition { index >= 16 -> reconstruction(a, 0, 0, 0.0) column < 4 -> accumulate(a, index, column, residual, orthogonality) _ -> error(a, index, residual, orthogonality) }
 }
 machine accumulate(a: &mut Analysis, index: u64 in Wrapping, column: u64 in Wrapping, residual: f64, orthogonality: f64) {
  let left: u64 in Wrapping = index / 4; let right: u64 in Wrapping = index % 4;
  let next_residual: f64 = residual + a.matrix[(left * 4 + column) % 16] * a.vectors[(column * 4 + right) % 16];
  let next_orthogonality: f64 = orthogonality + a.vectors[(column * 4 + left) % 16] * a.vectors[(column * 4 + right) % 16];
  transition { _ -> matrix(a, index, column + 1, next_residual, next_orthogonality) }
 }
 machine error(a: &mut Analysis, index: u64 in Wrapping, residual: f64, orthogonality: f64) {
  let norm: f64 = maximum(a.eigenvalues[0], 1e-300);
  let difference: f64 = absolute(residual - a.vectors[index % 16] * a.eigenvalues[index % 4]) / norm;
  a.residual = maximum(a.residual, difference);
  transition index / 4 == index % 4 { true -> diagonal(a, index, orthogonality) false -> off_diagonal(a, index, orthogonality) }
 }
 machine diagonal(a: &mut Analysis, index: u64 in Wrapping, value: f64) { a.orthogonality = maximum(a.orthogonality, absolute(value - 1.0)); transition { _ -> matrix(a, index + 1, 0, 0.0, 0.0) } }
 machine off_diagonal(a: &mut Analysis, index: u64 in Wrapping, value: f64) { a.orthogonality = maximum(a.orthogonality, absolute(value)); transition { _ -> matrix(a, index + 1, 0, 0.0, 0.0) } }
 machine reconstruction(a: &mut Analysis, index: u64 in Wrapping, column: u64 in Wrapping, sum: f64) {
  let next: f64 = sum + a.scores[((index / 4) * 4 + column) % 64] * a.vectors[((index % 4) * 4 + column) % 16];
  transition { index >= a.rows * 4 || index >= 64 -> finite(a, 0) column < 4 -> reconstruction(a, index, column + 1, next) _ -> reconstruction_error(a, index, sum) }
 }
 machine reconstruction_error(a: &mut Analysis, index: u64 in Wrapping, sum: f64) {
  let error: f64 = absolute(sum - a.centered[index % 64]);
  a.error = maximum(a.error, error);
  transition { _ -> reconstruction(a, index + 1, 0, 0.0) }
 }
 machine finite(a: &mut Analysis, index: u64 in Wrapping) {
  transition index < 64 { true -> finite_element(a, index) false -> finish(a) }
 }
 machine finite_element(a: &mut Analysis, index: u64 in Wrapping) {
  let score: f64 = a.scores[index % 64]; let center: f64 = a.centered[index % 64];
  let vector: f64 = a.vectors[index % 16]; let matrix: f64 = a.matrix[index % 16];
  let mean: f64 = a.means[index % 4]; let eigenvalue: f64 = a.eigenvalues[index % 4]; let fraction: f64 = a.explained[index % 4];
  transition score - score == 0.0 && center - center == 0.0 && vector - vector == 0.0 && matrix - matrix == 0.0 && mean - mean == 0.0 && eigenvalue - eigenvalue == 0.0 && fraction - fraction == 0.0 {
   true -> finite(a, index + 1) false -> numerical(a)
  }
 }
 machine finish(a: &mut Analysis) {
  transition a.residual <= 1e-8 && a.orthogonality <= 1e-8 && a.error - a.error == 0.0 { true -> done() false -> numerical(a) }
 }
 machine numerical(a: &mut Analysis) { a.status = 66; }
 machine done() {}
}
