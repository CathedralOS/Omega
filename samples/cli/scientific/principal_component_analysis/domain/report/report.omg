use domain/model/model.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
// Scientific output retains twelve significant decimal places at every scale.
public machine number(value: f64)
invokes |console|::Console reaches |process_authority|::StandardOutput {
 transition value < 0.0 { true -> negative(value), false -> normalize(value, 0) }
 machine negative(value: f64) { |console|::Console::write("-"); transition { _ -> normalize(0.0 - value, 0) } }
 machine normalize(value: f64, exponent: i32 in Wrapping) {
  transition { value >= 10.0 -> normalize(value / 10.0, exponent + 1), value > 0.0 && value < 1.0 -> normalize(value * 10.0, exponent - 1), _ -> mantissa(value, exponent) }
 }
 machine mantissa(value: f64, exponent: i32 in Wrapping) {
  let digits: u64 in Saturating = |float_operations|::U64::from_f64(value * 1000000000000.0);
  unsigned(digits as -Saturating +Wrapping, 1000000000000, true);
  |console|::Console::write("e");
  transition exponent < 0 { true -> negative_exponent(exponent), false -> positive_exponent(exponent) }
 }
 machine negative_exponent(exponent: i32 in Wrapping) { |console|::Console::write("-"); unsigned(|numeric_conversion|::narrow_i32_to_u64_saturating((0 - exponent) as i32) as u64 +Wrapping, 100, false); }
 machine positive_exponent(exponent: i32 in Wrapping) { unsigned(|numeric_conversion|::narrow_i32_to_u64_saturating(exponent as i32) as u64 +Wrapping, 100, false); }
}
machine unsigned(value: u64 in Wrapping, divisor: u64 in Wrapping, decimal: bool)
invokes |console|::Console reaches |process_authority|::StandardOutput {
 transition divisor > 0 { true -> digit(value, divisor, decimal), false -> done() }
 machine digit(value: u64 in Wrapping, divisor: u64 in Wrapping, decimal: bool) requires divisor > 0 {
  let digit: u64 in Wrapping = value / divisor % 10;
  |console|::Console::write_byte(((|numeric_conversion|::narrow_u64_to_i32_saturating(digit as u64) as i32 +Wrapping) + 48) as i32);
  transition decimal { true -> point(value, divisor), false -> unsigned(value, divisor / 10, false) }
 }
 machine point(value: u64 in Wrapping, divisor: u64 in Wrapping) { |console|::Console::write("."); transition { _ -> unsigned(value, divisor / 10, false) } }
 machine done() {}
}
public machine report(a: @|model|::Analysis)
invokes |console|::Console reaches |process_authority|::StandardOutput {
 |console|::Console::write_line("principal_component_analysis");
 |console|::Console::write("means");
 transition { _ -> vector(a, 0, 0) }
 machine vector(a: @|model|::Analysis, kind: u64 in Wrapping, index: u64 in Wrapping) {
  transition index < a.features && index < 4 { true -> vector_element(a, kind, index), false -> next_vector(a, kind) }
 }
 machine vector_element(a: @|model|::Analysis, kind: u64 in Wrapping, index: u64 in Wrapping) {
  |console|::Console::write(" ");
  transition kind { 0 -> means(a, index), 1 -> eigenvalues(a, index), _ -> explained(a, index) }
 }
 machine means(a: @|model|::Analysis, index: u64 in Wrapping) { number(a.means[index % 4]); transition { _ -> vector(a, 0, index + 1) } }
 machine eigenvalues(a: @|model|::Analysis, index: u64 in Wrapping) { number(a.eigenvalues[index % 4]); transition { _ -> vector(a, 1, index + 1) } }
 machine explained(a: @|model|::Analysis, index: u64 in Wrapping) { number(a.explained[index % 4]); transition { _ -> vector(a, 2, index + 1) } }
 machine next_vector(a: @|model|::Analysis, kind: u64 in Wrapping) {
  |console|::Console::write_line("");
  transition kind { 0 -> eigenvalue_label(a), 1 -> explained_label(a), _ -> covariance_label(a) }
 }
 machine eigenvalue_label(a: @|model|::Analysis) { |console|::Console::write("eigenvalues"); transition { _ -> vector(a, 1, 0) } }
 machine explained_label(a: @|model|::Analysis) { |console|::Console::write("explained"); transition { _ -> vector(a, 2, 0) } }
 machine covariance_label(a: @|model|::Analysis) { |console|::Console::write("covariance"); transition { _ -> matrix(a, 0, 0, 0) } }
 machine matrix(a: @|model|::Analysis, kind: u64 in Wrapping, row: u64 in Wrapping, column: u64 in Wrapping) {
  transition { column >= a.features || column >= 4 -> matrix(a, kind, row + 1, 0), kind == 3 && row >= a.rows -> next_matrix(a, kind), kind != 3 && row >= a.features -> next_matrix(a, kind), row < 16 -> element(a, kind, row, column), _ -> next_matrix(a, kind) }
 }
 machine element(a: @|model|::Analysis, kind: u64 in Wrapping, row: u64 in Wrapping, column: u64 in Wrapping) {
  |console|::Console::write(" ");
  transition kind { 0 -> covariance(a, row, column), 1 -> analysis_matrix(a, row, column), 2 -> vectors(a, row, column), _ -> scores(a, row, column) }
 }
 machine covariance(a: @|model|::Analysis, row: u64 in Wrapping, column: u64 in Wrapping) { number(a.covariance[(row * 4 + column) % 16]); transition { _ -> matrix(a, 0, row, column + 1) } }
 machine analysis_matrix(a: @|model|::Analysis, row: u64 in Wrapping, column: u64 in Wrapping) { number(a.matrix[(row * 4 + column) % 16]); transition { _ -> matrix(a, 1, row, column + 1) } }
 machine vectors(a: @|model|::Analysis, row: u64 in Wrapping, column: u64 in Wrapping) { number(a.vectors[(row * 4 + column) % 16]); transition { _ -> matrix(a, 2, row, column + 1) } }
 machine scores(a: @|model|::Analysis, row: u64 in Wrapping, column: u64 in Wrapping) { number(a.scores[(row * 4 + column) % 64]); transition { _ -> matrix(a, 3, row, column + 1) } }
 machine next_matrix(a: @|model|::Analysis, kind: u64 in Wrapping) {
  |console|::Console::write_line("");
  transition kind { 0 -> matrix_label(a), 1 -> vectors_label(a), 2 -> scores_label(a), _ -> errors(a) }
 }
 machine matrix_label(a: @|model|::Analysis) { |console|::Console::write("matrix"); transition { _ -> matrix(a, 1, 0, 0) } }
 machine vectors_label(a: @|model|::Analysis) { |console|::Console::write("vectors"); transition { _ -> matrix(a, 2, 0, 0) } }
 machine scores_label(a: @|model|::Analysis) { |console|::Console::write("scores"); transition { _ -> matrix(a, 3, 0, 0) } }
 machine errors(a: @|model|::Analysis) {
  |console|::Console::write("reconstruction_error "); number(a.error); |console|::Console::write_line("");
  |console|::Console::write("residual "); number(a.residual); |console|::Console::write_line("");
  |console|::Console::write("orthogonality "); number(a.orthogonality); |console|::Console::write_line("");
 }
}
