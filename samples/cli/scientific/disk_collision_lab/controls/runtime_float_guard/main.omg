use {omega}/language/core/float_operations.omg;
use {omega}/language/core/math.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

data Values {x:f64;}
data Main {values:Values;}
machine main(main:@mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
 let byte:|console|::ByteRead=block |console|::Console::read_byte();
 transition byte {|console|::ByteRead::Byte{value} -> guard(main,value), _ -> fail(main)}
 machine guard(main:@mutable Main,value:i32) {
  main.values.x=|float_operations|::F64::from_i32(value)-48.0;
  transition |math|::abs_f64(main.values.x) <= 0.000000001 {true -> good(main), _ -> fail(main)}
 }
 machine good(main:@mutable Main) {|process_exit|::ProcessExit::exit_process(70);}
 machine fail(main:@mutable Main) {|process_exit|::ProcessExit::exit_process(71);}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
