use omega\language\core\StandardInput;
use omega\language\core\ProcessExit;
use omega\language\core\abs_f64;

use system\ByteRead;
use system\Console;
use omega\language\core\F64::from_i32;
data Values {x:f64;}
data Main {values:Values;}
machine main(main:@mutable Main) reaches ProcessExit + StandardInput {
 let byte:ByteRead=block Console::read_byte();
 transition byte {ByteRead::Byte{value} -> guard(main,value), _ -> fail(main)}
 machine guard(main:@mutable Main,value:i32) {
  main.values.x=F64::from_i32(value)-48.0;
  transition abs_f64(main.values.x) <= 0.000000001 {true -> good(main), _ -> fail(main)}
 }
 machine good(main:@mutable Main) {ProcessExit::exit_process(70);}
 machine fail(main:@mutable Main) {ProcessExit::exit_process(71);}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
