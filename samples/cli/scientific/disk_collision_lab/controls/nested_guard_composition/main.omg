use {omega}/language/core/math.omg;

data Measurements { reading:f64; initial:f64; }
data Probe { lab:Measurements; choice:i32; observed:i32; }
machine observe(lab:@mutable Measurements) {lab.reading=lab.reading+0.0;}
machine accepted(lab:@Measurements,choice:i32)->bool {
 transition choice {0 -> test(lab), _ -> rejected()}
 machine test(lab:@Measurements)->bool {|math|::abs_f64(lab.reading-1.0) <= 0.000000001}
 machine rejected()->bool {false}
}
machine main(probe:@mutable Probe) {
 probe.lab.reading=1.0;probe.lab.initial=1.0;probe.choice=0;
 transition { _ -> check(probe) }
 machine check(probe:@mutable Probe) {
  observe(@mutable probe.lab);
  transition accepted(@probe.lab,probe.choice) && |math|::abs_f64(probe.lab.reading-probe.lab.initial) <= 0.000000001 {
   true -> passed(probe), _ -> failed(probe)
  }
 }
 machine passed(probe:@mutable Probe) {probe.observed=1;}
 machine failed(probe:@mutable Probe) {probe.observed=-1;}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Probe;
    main(@mutable entry_storage);
}
