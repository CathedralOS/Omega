use helper/helper.omg;
use model/model.omg;
use {omega}/language/core/math.omg;

machine observe(lab:@mutable |model|::Measurements) {lab.events=1;lab.first=0;lab.second=1;lab.time=2.0;lab.impulse=1.5;lab.px=1.0;lab.energy=0.5;lab.initial_x=1.0;lab.initial_energy=0.5;}
machine main(probe:@mutable |model|::Probe) {
 transition { _ -> check(probe) }
 machine check(probe:@mutable |model|::Probe) {
  observe(@mutable probe.lab);
  transition |helper|::accepted(@probe.lab,probe.choice) && |math|::abs_f64(probe.lab.px-probe.lab.initial_x) <= 0.000000001
   && |math|::abs_f64(probe.lab.py-probe.lab.initial_y) <= 0.000000001
   && |math|::abs_f64(probe.lab.energy+probe.lab.loss-probe.lab.initial_energy) <= 0.000000001
   && |math|::abs_f64(probe.lab.contact_error) <= 0.000000001 {
   true -> passed(probe), _ -> failed(probe)
  }
 }
 machine passed(probe:@mutable |model|::Probe) {probe.observed=1;}
 machine failed(probe:@mutable |model|::Probe) {probe.observed=-1;}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: |model|::Probe;
    main(@mutable entry_storage);
}
