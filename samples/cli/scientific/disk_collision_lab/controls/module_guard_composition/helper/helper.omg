use model/model.omg;
use {omega}/language/core/math.omg;

public machine accepted(lab:@|model|::Measurements,choice:i32)->bool {
 transition choice {0 -> test(lab), _ -> rejected()}
 machine test(lab:@|model|::Measurements)->bool {lab.events == 1 && lab.first == 0 && lab.second == 1 && |math|::abs_f64(lab.time-2.0) <= 0.000000001 && |math|::abs_f64(lab.impulse-1.5) <= 0.000000001}
 machine rejected()->bool {false}
}
