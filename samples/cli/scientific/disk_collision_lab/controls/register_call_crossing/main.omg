use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Complete reproduction: a scaled integer survives ordinary Console calls.
use system\ByteRead;
use system\Console;
use omega\language\core\F64::from_i32;
use formatting;
use formatting\number;
data Main {}
machine main(main:@mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
 let byte:ByteRead=block Console::read_byte();
 transition byte {ByteRead::Byte{value} -> render(main,value), _ -> fail(main)}
 machine render(main:@mutable Main,value:i32) {
  transition value >= 48 && value <= 57 {true -> bounded(main,value), _ -> fail(main)}
 }
 machine bounded(main:@mutable Main,value:i32) requires value >= 48 && value <= 57 {
  number((F64::from_i32(value)-48.0)/10.0);
  Console::write_line("");ProcessExit::exit_process(70);
 }
 machine fail(main:@mutable Main) {ProcessExit::exit_process(71);}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
