use formatting/formatting.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete reproduction: a scaled integer survives ordinary Console calls.
data Main {}
machine main(main:@mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
 let byte:|console|::ByteRead=block |console|::Console::read_byte();
 transition byte {|console|::ByteRead::Byte{value} -> render(main,value), _ -> fail(main)}
 machine render(main:@mutable Main,value:i32) {
  transition value >= 48 && value <= 57 {true -> bounded(main,value), _ -> fail(main)}
 }
 machine bounded(main:@mutable Main,value:i32) requires value >= 48 && value <= 57 {
  |formatting|::number((|float_operations|::F64::from_i32(value)-48.0)/10.0);
  |console|::Console::write_line("");|process_exit|::ProcessExit::exit_process(70);
 }
 machine fail(main:@mutable Main) {|process_exit|::ProcessExit::exit_process(71);}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
