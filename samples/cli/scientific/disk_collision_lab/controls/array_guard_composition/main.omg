use {omega}/language/core/math.omg;

data Disk [copy] {x:f64;y:f64;vx:f64;vy:f64;radius:f64;mass:f64;}
data Measurements {disks:[Disk;4];events:u64;first:u64;second:u64;time:f64;impulse:f64;px:f64;py:f64;energy:f64;loss:f64;initial_x:f64;initial_y:f64;initial_energy:f64;contact_error:f64;}
data Probe {lab:Measurements;choice:i32;observed:i32;}
machine observe(lab:@mutable Measurements) {lab.events=1;lab.first=0;lab.second=1;lab.time=2.0;lab.impulse=1.5;lab.px=1.0;lab.energy=0.5;lab.initial_x=1.0;lab.initial_energy=0.5;}
machine accepted(lab:@Measurements,choice:i32)->bool {
 transition choice {0 -> test(lab), _ -> rejected()}
 machine test(lab:@Measurements)->bool {lab.events == 1 && lab.first == 0 && lab.second == 1 && |math|::abs_f64(lab.time-2.0) <= 0.000000001 && |math|::abs_f64(lab.impulse-1.5) <= 0.000000001}
 machine rejected()->bool {false}
}
machine main(probe:@mutable Probe) {
 transition { _ -> check(probe) }
 machine check(probe:@mutable Probe) {
  observe(@mutable probe.lab);
  transition accepted(@probe.lab,probe.choice) && |math|::abs_f64(probe.lab.px-probe.lab.initial_x) <= 0.000000001
   && |math|::abs_f64(probe.lab.py-probe.lab.initial_y) <= 0.000000001
   && |math|::abs_f64(probe.lab.energy+probe.lab.loss-probe.lab.initial_energy) <= 0.000000001
   && |math|::abs_f64(probe.lab.contact_error) <= 0.000000001 {
   true -> passed(probe), _ -> failed(probe)
  }
 }
 machine passed(probe:@mutable Probe) {probe.observed=1;}
 machine failed(probe:@mutable Probe) {probe.observed=-1;}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Probe;
    main(@mutable entry_storage);
}
