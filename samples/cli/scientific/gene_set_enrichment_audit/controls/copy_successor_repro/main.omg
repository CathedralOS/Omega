use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
data Fraction [copy] { numerator: u64 in Wrapping; denominator: u64 in Wrapping; }
machine make(value: u64 in Wrapping) -> Fraction { Fraction { numerator: value, denominator: 3 as +Wrapping } }
machine calculate(flag: bool, value: u64 in Wrapping) -> u64 in Wrapping {
    let fraction: Fraction = make(value);
    transition flag {
        true -> sum(fraction, fraction),
        false -> sum(fraction, fraction)
    }
    machine sum(first: Fraction, second: Fraction) -> u64 in Wrapping {
        first.numerator + second.denominator
    }
}
data Main { }
machine main(context: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let byte: |console|::ByteRead = block |console|::Console::read_byte();
    transition byte {
        |console|::ByteRead::Error -> |process_exit|::ProcessExit::exit_process(74),
        |console|::ByteRead::Eof -> finish(context, 7 as +Wrapping),
        |console|::ByteRead::Byte { value } -> finish(context, value)
    }
    machine finish(context: @mutable Main, value: u64 in Wrapping) {
        let result: u64 in Wrapping = calculate(value > 70, value);
        transition result == value + 3 { true -> correct(context), false -> incorrect(context) }
    }
    machine correct(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(0); }
    machine incorrect(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
