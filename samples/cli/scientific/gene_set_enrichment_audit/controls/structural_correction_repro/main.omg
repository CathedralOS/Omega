use exact/exact.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
data Main { }
machine main(context: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let byte: |console|::ByteRead = block |console|::Console::read_byte();
    transition byte {
        |console|::ByteRead::Error -> |process_exit|::ProcessExit::exit_process(74),
        |console|::ByteRead::Eof -> calculate(context, 0),
        |console|::ByteRead::Byte { value } -> calculate(context, value as u64 +Wrapping)
    }
    machine calculate(context: @mutable Main, value: u64 in Wrapping) {
        let probability: |exact|::Fraction = |exact|::Fraction { numerator: value, denominator: 252 };
        let adjusted: |exact|::Fraction = correction(probability, 1, probability, 2, probability, 3);
        transition adjusted.denominator > 0 { true -> done(context), false -> bad(context) }
    }
    machine done(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(0); }
    machine bad(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(1); }
}
machine correction(value: |exact|::Fraction, rank: u64 in Wrapping, other: |exact|::Fraction, other_rank: u64 in Wrapping, last: |exact|::Fraction, last_rank: u64 in Wrapping) -> |exact|::Fraction {
    let initial: |exact|::Fraction = |exact|::scaled(value, rank);
    transition other_rank > rank { true -> finish(initial, last, rank, last_rank, |exact|::scaled(other, other_rank)),
 false -> finish(initial, last, rank, last_rank, initial)
 }
    machine finish(initial: |exact|::Fraction, last: |exact|::Fraction, rank: u64 in Wrapping, last_rank: u64 in Wrapping, candidate: |exact|::Fraction) -> |exact|::Fraction {
        let current: |exact|::Fraction = |exact|::minimum(initial, candidate);
        transition last_rank > rank { true -> |exact|::minimum(current, |exact|::scaled(last, last_rank)),
 false -> current
 }
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
