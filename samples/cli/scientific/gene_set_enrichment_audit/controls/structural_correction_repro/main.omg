use omega\language\core\StandardInput;
use omega\language\core\ProcessExit;
use system\ByteRead;
use system\Console;
use exact;
use exact\Fraction;
use exact\minimum;
use exact\scaled;
data Main { }
machine main(context: @mutable Main) reaches ProcessExit + StandardInput {
    let byte: ByteRead = block Console::read_byte();
    transition byte {
        ByteRead::Error -> ProcessExit::exit_process(74),
        ByteRead::Eof -> calculate(context, 0),
        ByteRead::Byte { value } -> calculate(context, value as u64 +Wrapping)
    }
    machine calculate(context: @mutable Main, value: u64 in Wrapping) {
        let probability: Fraction = Fraction { numerator: value, denominator: 252 };
        let adjusted: Fraction = correction(probability, 1, probability, 2, probability, 3);
        transition adjusted.denominator > 0 { true -> done(context), false -> bad(context) }
    }
    machine done(context: @mutable Main) { ProcessExit::exit_process(0); }
    machine bad(context: @mutable Main) { ProcessExit::exit_process(1); }
}
machine correction(value: Fraction, rank: u64 in Wrapping, other: Fraction, other_rank: u64 in Wrapping, last: Fraction, last_rank: u64 in Wrapping) -> Fraction {
    let initial: Fraction = scaled(value, rank);
    transition other_rank > rank { true -> finish(initial, last, rank, last_rank, scaled(other, other_rank)),
 false -> finish(initial, last, rank, last_rank, initial)
 }
    machine finish(initial: Fraction, last: Fraction, rank: u64 in Wrapping, last_rank: u64 in Wrapping, candidate: Fraction) -> Fraction {
        let current: Fraction = minimum(initial, candidate);
        transition last_rank > rank { true -> minimum(current, scaled(last, last_rank)),
 false -> current
 }
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
