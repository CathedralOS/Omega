// Exact combinatorics: admitted N <= 10 bounds every binomial to 252.
// Wrapping arithmetic is deliberate; application admission gives the stronger range.
public data Fraction [copy] { numerator: u64 in Wrapping; denominator: u64 in Wrapping; }

public machine choose(total: u64 in Wrapping, selected: u64 in Wrapping) -> u64 in Wrapping {
    transition selected <= total { true -> step(total, selected, 0, 1)
 false -> 0
 }
    machine step(total: u64 in Wrapping, selected: u64 in Wrapping, index: u64 in Wrapping, value: u64 in Wrapping) -> u64 in Wrapping {
        transition index < selected {
            true -> advance(total, selected, index, value)
            false -> value
        }
    }
    machine advance(total: u64 in Wrapping, selected: u64 in Wrapping, index: u64 in Wrapping, value: u64 in Wrapping) -> u64 in Wrapping {
        let divisor: u64 in Wrapping = index + 1;
        transition divisor > 0 { true -> divide(total, selected, index, value, divisor) false -> 0 }
    }
    machine divide(total: u64 in Wrapping, selected: u64 in Wrapping, index: u64 in Wrapping, value: u64 in Wrapping, divisor: u64 in Wrapping) -> u64 in Wrapping
    requires divisor > 0
    {
        transition { _ -> step(total, selected, index + 1, value * (total - index) / divisor) }
    }
}

public machine tail(total: u64 in Wrapping, annotated: u64 in Wrapping, query: u64 in Wrapping, observed: u64 in Wrapping) -> Fraction {
    let denominator: u64 in Wrapping = choose(total, query);
    transition { _ -> step(total, annotated, query, observed, 0, denominator) }
    machine step(total: u64 in Wrapping, annotated: u64 in Wrapping, query: u64 in Wrapping, hits: u64 in Wrapping, sum: u64 in Wrapping, denominator: u64 in Wrapping) -> Fraction {
        transition hits <= query && hits <= annotated {
            true -> accumulate(total, annotated, query, hits, sum, denominator)
            false -> Fraction { numerator: sum, denominator: denominator }
        }
    }
    machine accumulate(total: u64 in Wrapping, annotated: u64 in Wrapping, query: u64 in Wrapping, hits: u64 in Wrapping, sum: u64 in Wrapping, denominator: u64 in Wrapping) -> Fraction {
        let ways: u64 in Wrapping = choose(annotated, hits) * choose(total - annotated, query - hits);
        transition { _ -> step(total, annotated, query, hits + 1, sum + ways, denominator) }
    }
}

public machine less(left: Fraction, right: Fraction) -> bool {
    left.numerator * right.denominator < right.numerator * left.denominator
}

public machine minimum(left: Fraction, right: Fraction) -> Fraction {
    transition less(left, right) { true -> left
 false -> right
 }
}

public machine scaled(value: Fraction, rank: u64 in Wrapping) -> Fraction {
    minimum(Fraction { numerator: value.numerator * 3, denominator: value.denominator * rank }, Fraction { numerator: 1, denominator: 1 })
}
