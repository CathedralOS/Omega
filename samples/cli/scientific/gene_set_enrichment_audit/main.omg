use domain/exact/exact.omg;
use domain/report/report.omg;
use domain/sets/sets.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Runtime data is supplied through five bounded newline-terminated rows.

data Main { }

machine main(context: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let universe: |sets|::Parsed = block |sets|::read_set();
    let query: |sets|::Parsed = block |sets|::read_set();
    let first: |sets|::Parsed = block |sets|::read_set();
    let second: |sets|::Parsed = block |sets|::read_set();
    let third: |sets|::Parsed = block |sets|::read_set();
    let ended: bool = block |sets|::end_input();
    transition ended && universe.valid && query.valid && first.valid && second.valid && third.valid {
        true -> validate(context, universe, query, first, second, third),
        false -> reject(context)
    }
    machine validate(context: @mutable Main, universe: |sets|::Parsed, query: |sets|::Parsed, first: |sets|::Parsed, second: |sets|::Parsed, third: |sets|::Parsed) {
        transition universe.mask != 0 && universe.duplicates == 0 && |sets|::intersection(query.mask, universe.mask) == query.mask && |sets|::intersection(first.mask, universe.mask) == first.mask && |sets|::intersection(second.mask, universe.mask) == second.mask && |sets|::intersection(third.mask, universe.mask) == third.mask {
            true -> analyze(context, universe, query, first, second, third),
            false -> reject(context)
        }
    }
    machine analyze(context: @mutable Main, universe: |sets|::Parsed, query: |sets|::Parsed, first: |sets|::Parsed, second: |sets|::Parsed, third: |sets|::Parsed) {
        let total: u64 in Wrapping = |sets|::size(universe.mask);
        let selected: u64 in Wrapping = |sets|::size(query.mask);
        let one: |exact|::Fraction = |exact|::tail(total, |sets|::size(first.mask), selected, |sets|::size(|sets|::intersection(first.mask, query.mask)));
        let two: |exact|::Fraction = |exact|::tail(total, |sets|::size(second.mask), selected, |sets|::size(|sets|::intersection(second.mask, query.mask)));
        let three: |exact|::Fraction = |exact|::tail(total, |sets|::size(third.mask), selected, |sets|::size(|sets|::intersection(third.mask, query.mask)));
        // Stable rank: ties retain annotation order. Reverse cumulative minimum is BH.
        let rank_one: u64 in Wrapping = ranking(one, two, three, 1);
        let rank_two: u64 in Wrapping = ranking(two, one, three, 2);
        let rank_three: u64 in Wrapping = ranking(three, one, two, 3);
        let adjusted_one: |exact|::Fraction = correction(one, rank_one, two, rank_two, three, rank_three);
        let adjusted_two: |exact|::Fraction = correction(two, rank_two, one, rank_one, three, rank_three);
        let adjusted_three: |exact|::Fraction = correction(three, rank_three, one, rank_one, two, rank_two);
        |console|::Console::write("N="); |report|::number(total); |console|::Console::write(" n="); |report|::number(selected);
        |console|::Console::write(" duplicate_query="); |report|::number(query.duplicates);
        |console|::Console::write(" duplicate_annotations="); |report|::number(first.duplicates + second.duplicates + third.duplicates); |console|::Console::write_line("");
        |report|::result(1, first.mask, |sets|::intersection(first.mask, query.mask), one, adjusted_one, rank_one);
        |report|::result(2, second.mask, |sets|::intersection(second.mask, query.mask), two, adjusted_two, rank_two);
        |report|::result(3, third.mask, |sets|::intersection(third.mask, query.mask), three, adjusted_three, rank_three);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine reject(context: @mutable Main) { |console|::Console::write_line("INVALID_INPUT"); |process_exit|::ProcessExit::exit_process(65); }
}

machine ranking(value: |exact|::Fraction, other: |exact|::Fraction, last: |exact|::Fraction, identifier: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> first(value, other, last, identifier, 1) }
    machine first(value: |exact|::Fraction, other: |exact|::Fraction, last: |exact|::Fraction, identifier: u64 in Wrapping, rank: u64 in Wrapping) -> u64 in Wrapping {
        transition |exact|::less(other, value) || (!|exact|::less(value, other) && identifier > 1) {
            true -> second(value, last, identifier, rank + 1),
            false -> second(value, last, identifier, rank)
        }
    }
    machine second(value: |exact|::Fraction, last: |exact|::Fraction, identifier: u64 in Wrapping, rank: u64 in Wrapping) -> u64 in Wrapping {
        transition |exact|::less(last, value) || (!|exact|::less(value, last) && identifier == 3) { true -> (rank + 1),
 false -> rank
 }
    }
}

machine correction(value: |exact|::Fraction, rank: u64 in Wrapping, other: |exact|::Fraction, other_rank: u64 in Wrapping, last: |exact|::Fraction, last_rank: u64 in Wrapping) -> |exact|::Fraction {
    let initial: |exact|::Fraction = |exact|::scaled(value, rank);
    transition other_rank > rank { true -> finish(initial, last, rank, last_rank, |exact|::scaled(other, other_rank)),
 false -> finish(initial, last, rank, last_rank, initial)
 }
    machine finish(initial: |exact|::Fraction, last: |exact|::Fraction, rank: u64 in Wrapping, last_rank: u64 in Wrapping, candidate: |exact|::Fraction) -> |exact|::Fraction {
        let current: |exact|::Fraction = |exact|::minimum(initial, candidate);
        transition last_rank > rank { true -> |exact|::minimum(current, |exact|::scaled(last, last_rank)),
 false -> current
 }
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
