// Complete intended-invalid application: demands a negative safety radius
// inhabit a strictly positive radius type. No runtime execution is admissible.
machine positive_radius(radius: i32) -> i32
    requires radius >= 1 && radius <= 100
{ radius }
data Main { radius: i32; }
machine Main::main(main: &mut Main) { main.radius = positive_radius(-1); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
