// Bounded signed decimals: magnitude <= 1000, at most nine fractional digits.
// The byte budget includes separators and trailing whitespace. EOF is accepted
// only after a complete token; malformed, truncated and over-budget input reject.
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data Reader { consumed: i32; }
public data Number [copy] { valid: bool; value: f64; }

machine character(reader: @mutable Reader) -> i32 reaches |process_authority|::StandardInput {
    transition reader.consumed >= 0 && reader.consumed < 4096 {
        true -> read(reader),
        _ -> -2
    }
    machine read(reader: @mutable Reader) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        let byte: |console|::ByteRead = block |console|::Console::read_byte();
        transition byte { |console|::ByteRead::Error -> -2, |console|::ByteRead::Eof -> -1, |console|::ByteRead::Byte { value } -> counted(reader, value) }
    }
    machine counted(reader: @mutable Reader, value: i32) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        reader.consumed = reader.consumed + 1;
        transition { _ -> value }
    }
}
machine whitespace(value: i32) -> bool { transition { _ -> (value == 32 || value == 10 || value == 13 || value == 9) } }
public machine number(reader: @mutable Reader) -> Number
reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> start(reader) }
    machine start(reader: @mutable Reader) -> Number {
        let value: i32 = block character(reader);
        transition whitespace(value) { true -> start(reader), _ -> sign(reader, value) }
    }
    machine sign(reader: @mutable Reader, value: i32) -> Number {
        transition value == 45 {
            true -> negative(reader),
            _ -> digit(reader, value, 1.0, 0.0, 0, 0, false, 1.0)
        }
    }
    machine negative(reader: @mutable Reader) -> Number {
        let value: i32 = block character(reader);
        transition { _ -> digit(reader, value, -1.0, 0.0, 0, 0, false, 1.0) }
    }
    machine digit(reader: @mutable Reader, value: i32, sign: f64, accumulated: f64, digits: i32, fraction: i32, decimal: bool, divisor: f64) -> Number {
        transition value >= 48 && value <= 57 && digits >= 0 && digits < 13 && fraction >= 0 && fraction < 9 {
            true -> append(reader, value, sign, accumulated, digits, fraction, decimal, divisor),
            _ -> punctuation(reader, value, sign, accumulated, digits, fraction, decimal, divisor)
        }
    }
    machine append(reader: @mutable Reader, value: i32, sign: f64, accumulated: f64, digits: i32, fraction: i32, decimal: bool, divisor: f64) -> Number
    requires value >= 48 && value <= 57 && digits >= 0 && digits < 13 && fraction >= 0 && fraction < 9
    {
        let numeric: f64 = |float_operations|::F64::from_i32(value - 48);
        let next_divisor: f64 = match decimal { true -> divisor * 10.0, _ -> divisor };
        let next: f64 = match decimal { true -> accumulated + numeric / next_divisor, _ -> accumulated * 10.0 + numeric };
        let next_fraction: i32 = match decimal { true -> fraction + 1, _ -> fraction };
        let observed: i32 = block character(reader);
        transition { _ -> digit(reader, observed, sign, next, digits + 1, next_fraction, decimal, next_divisor) }
    }
    machine punctuation(reader: @mutable Reader, value: i32, sign: f64, accumulated: f64, digits: i32, fraction: i32, decimal: bool, divisor: f64) -> Number {
        transition value == 46 && !decimal && digits > 0 {
            true -> point(reader, sign, accumulated, digits),
            _ -> finish(value, sign, accumulated, digits, fraction, decimal)
        }
    }
    machine point(reader: @mutable Reader, sign: f64, accumulated: f64, digits: i32) -> Number {
        let observed: i32 = block character(reader);
        transition { _ -> digit(reader, observed, sign, accumulated, digits, 0, true, 1.0) }
    }
    machine finish(value: i32, sign: f64, accumulated: f64, digits: i32, fraction: i32, decimal: bool) -> Number {
        transition digits > 0 && accumulated <= 1000.0 && (!decimal || fraction > 0) && (whitespace(value) || value == -1) {
            true -> Number { valid: true, value: sign * accumulated },
            _ -> Number { valid: false, value: 0.0 }
        }
    }
}
public machine ended(reader: @mutable Reader) -> bool
reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> scan(reader) }
    machine scan(reader: @mutable Reader) -> bool {
        let value: i32 = block character(reader);
        transition value == -1 { true -> true, _ -> space(reader, value) }
    }
    machine space(reader: @mutable Reader, value: i32) -> bool {
        transition whitespace(value) { true -> scan(reader), _ -> false }
    }
}
