use omega\language\core\StandardOutput;
use calorimetry\input;
use calorimetry\input\Reader;
use omega\language\core\narrow_i64_to_i32_wrapping;
use system\Console;
use omega\language\core\I64::from_f64;

// Decimal byte output avoids imposing a text-domain proof on dynamic numbers.
public machine integer(reader: @mutable Reader, value: i64)
reaches StandardOutput
invokes Console
{
    let widened: i64 = value;
    transition widened < 0 {
        true -> negative(reader, widened),
        _ -> digits(reader, widened)
    }
    machine negative(reader: @mutable Reader, value: i64) {
        Console::write_byte(45);
        let absolute: i64 in Wrapping = 0 - (value as i64 +Wrapping);
        transition { _ -> digits(reader, absolute as i64) }
    }
    machine digits(reader: @mutable Reader, value: i64) {
        transition { _ -> seek(reader, value as i64 +Wrapping, 1) }
    }
    machine seek(reader: @mutable Reader, value: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 && divisor <= value / 10 {
            true -> seek(reader, value, divisor * 10),
            _ -> ready(reader, value, divisor)
        }
    }
    machine ready(reader: @mutable Reader, value: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 {
            true -> emit(reader, value, divisor),
            _ -> {}
        }
    }
    machine emit(reader: @mutable Reader, value: i64 in Wrapping, divisor: i64 in Wrapping)
    requires divisor > 0
    {
        let byte: i64 in Wrapping = (value / divisor) % 10 + 48;
        Console::write_byte(narrow_i64_to_i32_wrapping(byte as i64));
        transition divisor > 1 {
            true -> ready(reader, value, divisor / 10),
            _ -> {}
        }
    }
}
public machine field(reader: @mutable Reader, name: @[u8], value: f64)
reaches StandardOutput
invokes Console
{
    Console::write(name);
    let narrowed: i64 in Saturating = I64::from_f64(value);
    integer(reader, narrowed as i64);
    Console::write_byte(10);
}
