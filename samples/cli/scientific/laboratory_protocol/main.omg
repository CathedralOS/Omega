use protocol/model/model.omg;
use protocol/report/report.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Offline stdin interpreter. At most 64 commands; each line is exactly an
// uppercase opcode and one digit. Overlong lines are drained and rejected
// atomically. EOF commits a final unterminated line. No equipment is accessed.

data Main {
    laboratory: |model|::Laboratory;
    first: i32;
    second: i32;
    length: i32 in Saturating;
    commands: i32 in Saturating;
    decision: i32;
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("IND22 offline laboratory protocol; deadline=5; capacity=64");
    transition { _ -> block read(main) }
    machine read(main: @mutable Main) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> |process_exit|::ProcessExit::exit_process(74),
            |console|::ByteRead::Byte { value } -> block character(main, value),
            |console|::ByteRead::Eof -> block end(main)
        }
    }
    machine character(main: @mutable Main, character: i32) {
        transition character == 10 {
            true -> block commit(main, false),
            false -> block collect(main, character)
        }
    }
    machine collect(main: @mutable Main, character: i32) {
        transition main.length {
            0 -> block first(main, character),
            1 -> block second(main, character),
            _ -> block overflow(main)
        }
    }
    machine first(main: @mutable Main, character: i32) {
        main.first = character;
        main.length = 1 as +Saturating;
        transition { _ -> block read(main) }
    }
    machine second(main: @mutable Main, character: i32) {
        main.second = character;
        main.length = 2 as +Saturating;
        transition { _ -> block read(main) }
    }
    machine overflow(main: @mutable Main) {
        main.length = 3 as +Saturating;
        transition { _ -> block read(main) }
    }
    machine end(main: @mutable Main) {
        transition main.length > 0 {
            true -> block commit(main, true),
            false -> done(main)
        }
    }
    machine commit(main: @mutable Main, final: bool) {
        transition main.commands < 64 {
            true -> block grammar(main, final),
            false -> exhausted(main)
        }
    }
    machine grammar(main: @mutable Main, final: bool) {
        main.commands = main.commands + 1;
        main.decision = 12;
        transition main.length == 2 && main.second >= 48 && main.second <= 57 {
            true -> block interpret(main, final),
            false -> block report(main, final)
        }
    }
    machine interpret(main: @mutable Main, final: bool) {
        let argument: i32 in Saturating = (main.second - 48) as i32 +Saturating;
        main.decision = |model|::apply(@mutable main.laboratory, main.first, argument);
        transition { _ -> block report(main, final) }
    }
    machine report(main: @mutable Main, final: bool) {
        |report|::row(@main.laboratory, main.decision);
        main.length = 0;
        transition final {
            true -> done(main),
            false -> block read(main)
        }
    }
    machine exhausted(main: @mutable Main) {
        |console|::Console::write_line("BUDGET_EXHAUSTED");
        |process_exit|::ProcessExit::exit_process(65);
    }
    machine done(main: @mutable Main) {
        |console|::Console::write_line("END");
        |process_exit|::ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
