use protocol/model/model.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data Report { }

public machine row(laboratory: @|model|::Laboratory, decision: i32) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    decision(decision);
    |console|::Console::write(" owner=");
    number(laboratory.owner as i32 +Saturating);
    |console|::Console::write(" phase=");
    number(laboratory.phase as i32 +Saturating);
    |console|::Console::write(" lid=");
    report_lid(laboratory.closed);
    |console|::Console::write(" tick=");
    number(laboratory.elapsed);
    |console|::Console::write(" completed=");
    number(laboratory.completed);
    |console|::Console::write(" aborted=");
    number(laboratory.aborted);
    |console|::Console::write_line("");
}

machine number(value: i32 in Saturating) reaches |process_authority|::StandardOutput {
    transition value >= 0 && value <= 99 {
        true -> digits(value),
        false -> invalid()
    }
    machine digits(value: i32 in Saturating) {
        let tens: i32 in Saturating = value / 10 + 48;
        let units: i32 in Saturating = value % 10 + 48;
        |console|::Console::write_byte(tens as i32);
        |console|::Console::write_byte(units as i32);
    }
    machine invalid() {
        |console|::Console::write("??");
    }
}

machine report_lid(closed: bool) reaches |process_authority|::StandardOutput {
    transition closed {
        true -> shut(),
        false -> open()
    }
    machine shut() { |console|::Console::write("closed"); }
    machine open() { |console|::Console::write("open"); }
}

machine decision(decision: i32) reaches |process_authority|::StandardOutput {
    transition decision {
        0 -> acquired(),
        1 -> loaded(),
        2 -> started(),
        3 -> advanced(),
        4 -> completed(),
        5 -> cancelled(),
        6 -> recovered(),
        7 -> lid_changed(),
        8 -> conflict(),
        9 -> phase(),
        10 -> interlock(),
        11 -> timeout(),
        13 -> emergency(),
        _ -> invalid()
    }
    machine acquired() { |console|::Console::write("ALLOW acquire"); }
    machine loaded() { |console|::Console::write("ALLOW load"); }
    machine started() { |console|::Console::write("ALLOW start interlock=closed"); }
    machine advanced() { |console|::Console::write("ALLOW advance deadline=pending"); }
    machine completed() { |console|::Console::write("ALLOW finish lease=released"); }
    machine cancelled() { |console|::Console::write("ABORT cancel lease=retained"); }
    machine recovered() { |console|::Console::write("ALLOW recover lease=released"); }
    machine lid_changed() { |console|::Console::write("ALLOW lid"); }
    machine conflict() { |console|::Console::write("DENY resource_owner"); }
    machine phase() { |console|::Console::write("DENY phase"); }
    machine interlock() { |console|::Console::write("DENY interlock=open"); }
    machine timeout() { |console|::Console::write("ABORT timeout lease=retained"); }
    machine emergency() { |console|::Console::write("ABORT interlock=open lease=retained"); }
    machine invalid() { |console|::Console::write("DENY input"); }
}
