module planner::input;
// Private decimal parser. One line, exactly fifteen signed integers.
// Limit the accumulator BEFORE multiplying: malformed input cannot wrap.
public data TransportInput { values: [i32; 15]; }

public machine parse_transport(bytes: &[u8], input: &mut TransportInput) -> bool {
    transition { _ -> scan(bytes, input, 0, 0, 0, false, false, false) }
    machine scan(bytes: &[u8], input: &mut TransportInput, position: u64,
               token: u64, value: i32 in Wrapping, negative: bool,
               started: bool, digit_seen: bool) -> bool {
        transition position < bytes.len {
            true -> character(bytes, input, position, token, value, negative, started, digit_seen, bytes[position])
            false -> end(input, token, value, negative, started, digit_seen)
        }
    }
    machine character(bytes: &[u8], input: &mut TransportInput, position: u64,
                    token: u64, value: i32 in Wrapping, negative: bool,
                    started: bool, digit_seen: bool, character: u8) -> bool {
        transition character == 32 || character == 9 || character == 13 || character == 10 {
            true -> separator(bytes, input, position, token, value, negative, started, digit_seen)
            false -> nonspace(bytes, input, position, token, value, negative, started, digit_seen, character)
        }
    }
    machine nonspace(bytes: &[u8], input: &mut TransportInput, position: u64,
                   token: u64, value: i32 in Wrapping, negative: bool,
                   started: bool, digit_seen: bool, character: u8) -> bool {
        transition character == 45 && !started {
            true -> scan(bytes, input, position + 1, token, 0, true, true, false)
            false -> decimal(bytes, input, position, token, value, negative, character)
        }
    }
    machine decimal(bytes: &[u8], input: &mut TransportInput, position: u64,
                  token: u64, value: i32 in Wrapping, negative: bool, character: u8) -> bool {
        transition character >= 48 && character <= 57 && value <= 9 {
            true -> scan(bytes, input, position + 1, token,
                         value * 10 + (character as i32 in Wrapping) - 48, negative, true, true)
            false -> false
        }
    }
    machine separator(bytes: &[u8], input: &mut TransportInput, position: u64,
                    token: u64, value: i32 in Wrapping, negative: bool,
                    started: bool, digit_seen: bool) -> bool {
        transition started {
            true -> finish_token(bytes, input, position, token, value, negative, digit_seen)
            false -> scan(bytes, input, position + 1, token, 0, false, false, false)
        }
    }
    machine finish_token(bytes: &[u8], input: &mut TransportInput, position: u64,
                       token: u64, value: i32 in Wrapping, negative: bool, digit_seen: bool) -> bool {
        transition token < 15 && digit_seen {
            true -> store(bytes, input, position, token, value, negative)
            false -> false
        }
    }
    machine store(bytes: &[u8], input: &mut TransportInput, position: u64,
                token: u64, value: i32 in Wrapping, negative: bool) -> bool {
        let signed: i32 in Wrapping = signed_value(value, negative);
        input.values[token] = signed as i32;
        transition { _ -> scan(bytes, input, position + 1, token + 1, 0, false, false, false) }
    }
    machine end(input: &mut TransportInput, token: u64, value: i32 in Wrapping,
              negative: bool, started: bool, digit_seen: bool) -> bool {
        transition started {
            true -> last(input, token, value, negative, digit_seen)
            false -> (token == 15)
        }
    }
    machine last(input: &mut TransportInput, token: u64, value: i32 in Wrapping,
               negative: bool, digit_seen: bool) -> bool {
        transition token == 14 && digit_seen {
            true -> last_store(input, token, value, negative)
            false -> false
        }
    }
    machine last_store(input: &mut TransportInput, token: u64, value: i32 in Wrapping,
                     negative: bool) -> bool {
        let signed: i32 in Wrapping = signed_value(value, negative);
        input.values[token] = signed as i32;
        transition { _ -> true }
    }
}
machine signed_value(value: i32 in Wrapping, negative: bool) -> i32 in Wrapping {
    transition negative { true -> (0 - value) false -> value }
}

public machine valid_margins(input: &TransportInput) -> bool {
    transition { _ -> item(input, 0) }
    machine item(input: &TransportInput, index: u64) -> bool {
        transition index < 6 {
            true -> check(input, index, input.values[index])
            false -> true
        }
    }
    machine check(input: &TransportInput, index: u64, value: i32) -> bool {
        transition value >= 0 && value <= 9 {
            true -> item(input, index + 1)
            false -> false
        }
    }
}
