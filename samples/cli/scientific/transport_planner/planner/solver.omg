module planner::solver;
use planner::input::TransportInput;
// A 3x3 table with fixed margins has four free cells. Enumerate their entire
// bounded integer cube and derive the five others from conservation. This is
// complete, including degeneracy, zero margins and negative costs. The first
// minimum in ascending enumeration gives deterministic lexicographic ties.
// Wrapping only makes the arithmetic domain explicit; validated inputs bound
// every quantity to 0..9 and the complete objective to -2673..2673.
public data TransportPlan {
    shipments: [i32; 9];
    total: i32 in Wrapping;
    found: bool;
}

public machine solve_transport(input: &TransportInput, plan: &mut TransportPlan) -> bool {
    plan.found = false;
    plan.total = 0;
    plan.shipments = [0,0,0,0,0,0,0,0,0];
    transition { _ -> enumerate(input, plan, 0) }
    machine enumerate(input: &TransportInput, plan: &mut TransportPlan,
                    candidate: i32 in Wrapping) -> bool {
        transition candidate < 10000 {
            true -> derive(input, plan, candidate)
            false -> (plan.found)
        }
    }
    machine derive(input: &TransportInput, plan: &mut TransportPlan,
                 candidate: i32 in Wrapping) -> bool {
        let first: i32 in Wrapping = candidate / 1000;
        let second: i32 in Wrapping = candidate / 100 % 10;
        let fourth: i32 in Wrapping = candidate / 10 % 10;
        let fifth: i32 in Wrapping = candidate % 10;
        let third: i32 in Wrapping = (input.values[0] as i32 in Wrapping) - first - second;
        let sixth: i32 in Wrapping = (input.values[1] as i32 in Wrapping) - fourth - fifth;
        let seventh: i32 in Wrapping = (input.values[3] as i32 in Wrapping) - first - fourth;
        let eighth: i32 in Wrapping = (input.values[4] as i32 in Wrapping) - second - fifth;
        let ninth: i32 in Wrapping = (input.values[2] as i32 in Wrapping) - seventh - eighth;
        transition third >= 0 && sixth >= 0 && seventh >= 0 && eighth >= 0 && ninth >= 0
                   && third + sixth + ninth == input.values[5] {
            true -> objective(input, plan, candidate, first, second, third, fourth, fifth, sixth, seventh, eighth, ninth)
            false -> enumerate(input, plan, candidate + 1)
        }
    }
    machine objective(input: &TransportInput, plan: &mut TransportPlan, candidate: i32 in Wrapping,
                    first: i32 in Wrapping, second: i32 in Wrapping, third: i32 in Wrapping,
                    fourth: i32 in Wrapping, fifth: i32 in Wrapping, sixth: i32 in Wrapping,
                    seventh: i32 in Wrapping, eighth: i32 in Wrapping, ninth: i32 in Wrapping) -> bool {
        let cost: i32 in Wrapping = first * (input.values[6] as i32 in Wrapping)
            + second * (input.values[7] as i32 in Wrapping) + third * (input.values[8] as i32 in Wrapping)
            + fourth * (input.values[9] as i32 in Wrapping) + fifth * (input.values[10] as i32 in Wrapping)
            + sixth * (input.values[11] as i32 in Wrapping) + seventh * (input.values[12] as i32 in Wrapping)
            + eighth * (input.values[13] as i32 in Wrapping) + ninth * (input.values[14] as i32 in Wrapping);
        transition !plan.found || cost < plan.total {
            true -> retain(input, plan, candidate, cost, first, second, third, fourth, fifth, sixth, seventh, eighth, ninth)
            false -> enumerate(input, plan, candidate + 1)
        }
    }
    machine retain(input: &TransportInput, plan: &mut TransportPlan, candidate: i32 in Wrapping,
                 cost: i32 in Wrapping, first: i32 in Wrapping, second: i32 in Wrapping, third: i32 in Wrapping,
                 fourth: i32 in Wrapping, fifth: i32 in Wrapping, sixth: i32 in Wrapping,
                 seventh: i32 in Wrapping, eighth: i32 in Wrapping, ninth: i32 in Wrapping) -> bool {
        plan.shipments = [first as i32, second as i32, third as i32, fourth as i32, fifth as i32,
                          sixth as i32, seventh as i32, eighth as i32, ninth as i32];
        plan.total = cost;
        plan.found = true;
        transition { _ -> enumerate(input, plan, candidate + 1) }
    }
}
