use planner/solver/solver.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

// Fixed signed four-digit objective keeps the table machine-readable. All
// digit output is through the ordinary selected Console provider.
public machine emit_integer(value: i32 in Wrapping) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    transition value < 0 {
        true -> negative(0 - value),
        false -> positive(value)
    }
    machine negative(value: i32 in Wrapping) {
        |console|::Console::write_byte(45);
        transition { _ -> digits(value, 1000) }
    }
    machine positive(value: i32 in Wrapping) {
        |console|::Console::write_byte(43);
        transition { _ -> digits(value, 1000) }
    }
    machine digits(value: i32 in Wrapping, divisor: i32 in Wrapping)
    requires divisor > 0
    {
        let digit: i32 in Wrapping = value / divisor % 10 + 48;
        |console|::Console::write_byte(digit as i32);
        transition divisor >= 10 {
            true -> digits(value, divisor / 10),
            false -> finish()
        }
    }
    machine finish() { |console|::Console::write_byte(10); }
}
public machine emit_plan(plan: @|solver|::TransportPlan) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_line("OPTIMAL: shipments");
    transition { _ -> cell(plan, 0) }
    machine cell(plan: @|solver|::TransportPlan, index: u64) {
        transition index < 9 {
            true -> write_cell(plan, index),
            false -> total(plan)
        }
    }
    machine write_cell(plan: @|solver|::TransportPlan, index: u64) {
        let digit: i32 in Wrapping = (plan.shipments[index] as i32 +Wrapping) + 48;
        |console|::Console::write_byte(digit as i32);
        transition index % 3 == 2 {
            true -> newline(plan, index),
            false -> space(plan, index)
        }
    }
    machine newline(plan: @|solver|::TransportPlan, index: u64) {
        |console|::Console::write_byte(10);
        transition { _ -> cell(plan, index + 1) }
    }
    machine space(plan: @|solver|::TransportPlan, index: u64) {
        |console|::Console::write_byte(32);
        transition { _ -> cell(plan, index + 1) }
    }
    machine total(plan: @|solver|::TransportPlan) {
        |console|::Console::write("total_cost ");
        emit_integer(plan.total);
    }
}
