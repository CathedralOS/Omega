use planner/input/input.omg;
use planner/output/output.omg;
use planner/solver/solver.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Closed stdin is invalid runtime input for the ordinary sample harness.
// Expected exit: 2.
// Expected output contains: INVALID: expected 15 integers

// One complete line is the transaction. Full input is rejected rather than
// solving a silently truncated prefix. No external solver or runtime fixture.
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable bytes: [u8; 256];
    let result: |console|::LineReadResult = block |console|::Console::read_line(@mutable bytes[..]);
    transition result {
        |console|::LineReadResult::LineComplete { count } -> parse(main, @bytes, count),
        |console|::LineReadResult::EndOfInput { count } -> parse(main, @bytes, count),
        _ -> malformed(main)
    }
    machine parse(main: @mutable Main, bytes: @[u8; 256], count: u64) {
        transition count < bytes.length {
            true -> decode(main, bytes[..count]),
            false -> malformed(main)
        }
    }
    machine decode(main: @mutable Main, bytes: @[u8]) {
        let mutable input: |input|::TransportInput;
        let valid: bool = |input|::parse_transport(bytes, @mutable input);
        transition valid {
            true -> margins(main, @input),
            false -> malformed(main)
        }
    }
    machine margins(main: @mutable Main, input: @|input|::TransportInput) {
        let valid: bool = |input|::valid_margins(input);
        transition valid {
            true -> balanced(main, input),
            false -> malformed(main)
        }
    }
    machine balanced(main: @mutable Main, input: @|input|::TransportInput) {
        let supply: i32 in Wrapping = (input.values[0] as i32 +Wrapping)
            + (input.values[1] as i32 +Wrapping) + (input.values[2] as i32 +Wrapping);
        let demand: i32 in Wrapping = (input.values[3] as i32 +Wrapping)
            + (input.values[4] as i32 +Wrapping) + (input.values[5] as i32 +Wrapping);
        transition supply == demand {
            true -> optimize(main, input),
            false -> infeasible(main, supply, demand)
        }
    }
    machine optimize(main: @mutable Main, input: @|input|::TransportInput) {
        let mutable plan: |solver|::TransportPlan;
        let found: bool = |solver|::solve_transport(input, @mutable plan);
        transition found {
            true -> emit(main, @plan),
            false -> internal_error(main)
        }
    }
    machine emit(main: @mutable Main, plan: @|solver|::TransportPlan) {
        |output|::emit_plan(plan);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine infeasible(main: @mutable Main, supply: i32 in Wrapping, demand: i32 in Wrapping) {
        |console|::Console::write_line("INFEASIBLE: unequal totals");
        |console|::Console::write("supply ");
        |output|::emit_integer(supply);
        |console|::Console::write("demand ");
        |output|::emit_integer(demand);
        |process_exit|::ProcessExit::exit_process(3);
    }
    machine malformed(main: @mutable Main) {
        |console|::Console::write_line("INVALID: expected 15 integers; margins 0..9, costs -99..99; one line below 256 bytes");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine internal_error(main: @mutable Main) {
        |console|::Console::write_line("ERROR: balanced complete transport has no plan");
        |process_exit|::ProcessExit::exit_process(4);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
