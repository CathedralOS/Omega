use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

// Emit decimal digits through the standard byte writer. No fabricated UTF-8
// domain or host-side formatter is required. All callers pass nonnegative sums.
public machine number(value: i32) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    transition { _ -> scale(value, value, 1) }
    machine scale(value: i32,
                remaining: i32, place: i32 in Wrapping) {
        transition remaining >= 10 {
            true -> grow(value, remaining, place),
            _ -> emit(value, place)
        }
    }
    machine grow(value: i32,
               remaining: i32, place: i32 in Wrapping) {
        // An i32 has at most ten decimal digits, so place never exceeds 10^9.
        transition { _ -> scale(value, remaining / 10, place * 10) }
    }
    machine emit(value: i32, place: i32 in Wrapping) {
        transition place > 0 {
            true -> digit(value, place),
            _ -> done()
        }
    }
    machine digit(value: i32, place: i32 in Wrapping)
    requires place > 0 {
        |console|::Console::write_byte((((value as +Wrapping) / place) + 48) as i32);
        transition place > 1 {
            true -> rest(value, place),
            _ -> done()
        }
    }
    machine rest(value: i32, place: i32 in Wrapping)
    requires place > 1 {
        transition { _ -> emit(((value as +Wrapping) % place) as i32, place / 10) }
    }
    machine done() { }
}
