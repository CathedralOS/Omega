use omega::language::core::ProcessExit;
// Complete entrypoint. Deliberate constant array-bound violation:
// a three-element joint-event vector has no element at index three.
use omega_language_std::Console;
data Main { events: [i32; 3]; }
machine main(main: &mut Main) reaches ProcessExit + Console {
    main.events[3] = 1;
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
