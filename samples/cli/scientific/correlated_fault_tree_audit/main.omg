use domain/logic/logic.omg;
use domain/report/report.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Declared synthetic instrument model: A sensor fault, B power fault,
// C shared environmental cause. Input contains complete joint weights.

data Main {
    input: [i32; 13];
    terms: [i32; 4];
    token: i32 in Wrapping;
    digits: i32;
    position: i32;
    bytes: i32;
    index: i32;
    total: i32 in Wrapping;
    failure: i32 in Wrapping;
    repaired: i32 in Wrapping;
    forced: i32 in Wrapping;
    marginal: i32 in Wrapping;
    event: i32;
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    transition { _ -> block read(main) }
    machine read(main: @mutable Main) {
        transition main.bytes >= 0 && main.bytes < 256 {
            true -> block byte(main),
            _ -> invalid(main)
        }
    }
    machine byte(main: @mutable Main)
    requires main.bytes >= 0 && main.bytes < 256 {
        main.bytes = main.bytes + 1;
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> invalid(main),
            |console|::ByteRead::Eof -> end(main),
            |console|::ByteRead::Byte { value } -> block classify(main, value)
        }
    }
    machine classify(main: @mutable Main, value: i32) {
        transition value >= 48 && value <= 57 {
            true -> block digit(main, value),
            _ -> block separator(main, value)
        }
    }
    machine digit(main: @mutable Main, value: i32) {
        transition main.digits >= 0 && main.digits < 7 {
            true -> block accumulate(main, value),
            _ -> invalid(main)
        }
    }
    machine accumulate(main: @mutable Main, value: i32)
    requires main.digits >= 0 && main.digits < 7 {
        main.token = main.token * 10 + (value as +Wrapping) - 48;
        main.digits = main.digits + 1;
        transition main.token <= 1000000 {
            true -> block read(main),
            _ -> invalid(main)
        }
    }
    machine separator(main: @mutable Main, value: i32) {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> block flush(main),
            _ -> invalid(main)
        }
    }
    machine flush(main: @mutable Main) {
        transition main.digits > 0 {
            true -> block store(main),
            _ -> block read(main)
        }
    }
    machine store(main: @mutable Main) {
        transition main.position >= 0 && main.position < 13 {
            true -> block save(main),
            _ -> invalid(main)
        }
    }
    machine save(main: @mutable Main)
    requires main.position >= 0 && main.position < 13 {
        main.input[main.position] = main.token as i32;
        main.position = main.position + 1;
        main.token = 0;
        main.digits = 0;
        transition { _ -> block read(main) }
    }
    machine end(main: @mutable Main) {
        transition main.digits > 0 {
            true -> last(main),
            _ -> validate(main)
        }
    }
    machine last(main: @mutable Main) {
        transition main.position >= 0 && main.position < 13 {
            true -> save_last(main),
            _ -> invalid(main)
        }
    }
    machine save_last(main: @mutable Main)
    requires main.position >= 0 && main.position < 13 {
        main.input[main.position] = main.token as i32;
        main.position = main.position + 1;
        transition { _ -> validate(main) }
    }
    machine validate(main: @mutable Main) {
        transition main.position == 13 && main.input[0] <= 4 {
            true -> terms(main),
            _ -> invalid(main)
        }
    }
    machine terms(main: @mutable Main) {
        main.index = 0;
        transition { _ -> term_loop(main) }
    }
    machine term_loop(main: @mutable Main) {
        transition main.index >= 0 && main.index < 4 {
            true -> term(main),
            _ -> weights(main)
        }
    }
    machine term(main: @mutable Main)
    requires main.index >= 0 && main.index < 4 {
        let mask: i32 = main.input[main.index + 1];
        transition mask <= 7 && (main.index < main.input[0] || mask == 0) {
            true -> copy_term(main, mask),
            _ -> invalid(main)
        }
    }
    machine copy_term(main: @mutable Main, mask: i32)
    requires main.index >= 0 && main.index < 4 {
        main.terms[main.index] = mask;
        main.index = main.index + 1;
        transition { _ -> term_loop(main) }
    }
    machine weights(main: @mutable Main) {
        main.index = 0;
        transition { _ -> weight_loop(main) }
    }
    machine weight_loop(main: @mutable Main) {
        transition main.index >= 0 && main.index < 8 {
            true -> weight(main),
            _ -> normalized(main)
        }
    }
    machine weight(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        main.total = main.total + (main.input[main.index + 5] as i32 +Wrapping);
        transition |logic|::fails(@main.terms, main.input[0], main.index) {
            true -> failed_weight(main),
            _ -> next_weight(main)
        }
    }
    machine failed_weight(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        main.failure = main.failure + (main.input[main.index + 5] as i32 +Wrapping);
        transition { _ -> next_weight(main) }
    }
    machine next_weight(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> weight_loop(main) }
    }
    machine normalized(main: @mutable Main) {
        transition main.total == 1000000 {
            true -> report(main),
            _ -> invalid(main)
        }
    }
    machine report(main: @mutable Main) {
        |console|::Console::write("failure_ppm=");
        |report|::number(main.failure as i32);
        |console|::Console::write_line("/1000000");
        main.index = 0;
        transition { _ -> cuts(main) }
    }
    machine cuts(main: @mutable Main) {
        transition main.index >= 0 && main.index < 8 {
            true -> cut(main),
            _ -> sensitivity(main)
        }
    }
    machine cut(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        transition |logic|::minimal_cut(@main.terms, main.input[0], main.index) {
            true -> emit_cut(main),
            _ -> next_cut(main)
        }
    }
    machine emit_cut(main: @mutable Main) {
        |console|::Console::write("cut_mask=");
        |report|::number(main.index);
        |console|::Console::write_line("");
        transition { _ -> next_cut(main) }
    }
    machine next_cut(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> cuts(main) }
    }
    machine sensitivity(main: @mutable Main) {
        main.event = 0;
        transition { _ -> event_loop(main) }
    }
    machine event_loop(main: @mutable Main) {
        transition main.event >= 0 && main.event < 3 {
            true -> event_start(main),
            _ -> done(main)
        }
    }
    machine event_start(main: @mutable Main) {
        main.repaired = 0;
        main.forced = 0;
        main.marginal = 0;
        main.index = 0;
        transition { _ -> audit_loop(main) }
    }
    machine audit_loop(main: @mutable Main) {
        transition main.index >= 0 && main.index < 8 {
            true -> audit(main),
            _ -> emit_audit(main)
        }
    }
    machine audit(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        let off: i32 = |logic|::force_event(main.index, main.event, false);
        let on: i32 = |logic|::force_event(main.index, main.event, true);
        transition off != main.index {
            true -> marginal(main, off, on),
            _ -> repair(main, off, on)
        }
    }
    machine marginal(main: @mutable Main, off: i32, on: i32)
    requires main.index >= 0 && main.index < 8 {
        main.marginal = main.marginal + (main.input[main.index + 5] as i32 +Wrapping);
        transition { _ -> repair(main, off, on) }
    }
    machine repair(main: @mutable Main, off: i32, on: i32) {
        transition |logic|::fails(@main.terms, main.input[0], off) {
            true -> add_repair(main, on),
            _ -> force(main, on)
        }
    }
    machine add_repair(main: @mutable Main, on: i32)
    requires main.index >= 0 && main.index < 8 {
        main.repaired = main.repaired + (main.input[main.index + 5] as i32 +Wrapping);
        transition { _ -> force(main, on) }
    }
    machine force(main: @mutable Main, on: i32) {
        transition |logic|::fails(@main.terms, main.input[0], on) {
            true -> add_force(main),
            _ -> next_audit(main)
        }
    }
    machine add_force(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        main.forced = main.forced + (main.input[main.index + 5] as i32 +Wrapping);
        transition { _ -> next_audit(main) }
    }
    machine next_audit(main: @mutable Main)
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> audit_loop(main) }
    }
    machine emit_audit(main: @mutable Main)
    requires main.event >= 0 && main.event < 3 {
        |console|::Console::write("event="); |report|::number(main.event);
        |console|::Console::write(" marginal_ppm="); |report|::number(main.marginal as i32);
        |console|::Console::write(" repaired_ppm="); |report|::number(main.repaired as i32);
        |console|::Console::write(" reduction_ppm="); |report|::number((main.failure - main.repaired) as i32);
        |console|::Console::write(" forced_ppm="); |report|::number(main.forced as i32);
        |console|::Console::write_line("");
        // Refresh the Exact cursor bound after service calls, directly on the
        // increment edge. A state arrival fact is not a post-call guarantee.
        transition main.event >= 0 && main.event < 3 {
            true -> advance_event(main),
            _ -> invalid(main)
        }
    }
    machine advance_event(main: @mutable Main)
    requires main.event >= 0 && main.event < 3 {
        main.event = main.event + 1;
        transition { _ -> event_loop(main) }
    }
    machine done(main: @mutable Main) {
        |console|::Console::write_line("AUDIT COMPLETE");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("INVALID INPUT");
        |process_exit|::ProcessExit::exit_process(2);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
