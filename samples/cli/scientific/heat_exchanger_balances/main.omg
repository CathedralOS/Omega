use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Complete stdin-driven synthetic scientific sample. Valid data exits zero.
// Expected exit: 64.
// Expected output contains: INVALID bounded counterflow input
// The generic sample harness supplies EOF; data/ covers the scientific workflows.
use system\Console;
use io\input;
use io\report;
use model\stages;

data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    let mutable raw: io\input\Raw;
    let mutable input: io\input\Input;
    let mutable solution: model\stages\Solution;
    let parsed: bool = block io\input\parse(@mutable raw);
    transition parsed {
        true -> validate_input(@raw, @mutable input, @mutable solution),
        false -> invalid()
    }
    machine validate_input(raw: @io\input\Raw, input: @mutable io\input\Input, solution: @mutable model\stages\Solution) {
        transition io\input\validate(raw, input) {
            true -> calculate(input, solution),
            false -> invalid()
        }
    }
    machine calculate(input: @io\input\Input, solution: @mutable model\stages\Solution) {
        transition model\stages\solve(input, solution) {
            true -> output(input, solution),
            false -> failed()
        }
    }
    machine output(input: @io\input\Input, solution: @model\stages\Solution) {
        io\report\emit(input, solution);
        ProcessExit::exit_process(0);
    }
    machine invalid() {
        Console::write_line("INVALID bounded counterflow input");
        ProcessExit::exit_process(64);
    }
    machine failed() {
        Console::write_line("FAIL numerical balance");
        ProcessExit::exit_process(65);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
