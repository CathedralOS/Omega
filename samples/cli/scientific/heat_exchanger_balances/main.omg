use io/input/input.omg;
use io/report/report.omg;
use model/stages/stages.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete stdin-driven synthetic scientific sample. Valid data exits zero.
// Expected exit: 64.
// Expected output contains: INVALID bounded counterflow input
// The generic sample harness supplies EOF; data/ covers the scientific workflows.

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable raw: |input|::Raw;
    let mutable input: |input|::Input;
    let mutable solution: |stages|::Solution;
    let parsed: bool = block |input|::parse(@mutable raw);
    transition parsed {
        true -> validate_input(@raw, @mutable input, @mutable solution),
        false -> invalid()
    }
    machine validate_input(raw: @|input|::Raw, input: @mutable |input|::Input, solution: @mutable |stages|::Solution) {
        transition |input|::validate(raw, input) {
            true -> calculate(input, solution),
            false -> invalid()
        }
    }
    machine calculate(input: @|input|::Input, solution: @mutable |stages|::Solution) {
        transition |stages|::solve(input, solution) {
            true -> output(input, solution),
            false -> failed()
        }
    }
    machine output(input: @|input|::Input, solution: @|stages|::Solution) {
        |report|::emit(input, solution);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid() {
        |console|::Console::write_line("INVALID bounded counterflow input");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine failed() {
        |console|::Console::write_line("FAIL numerical balance");
        |process_exit|::ProcessExit::exit_process(65);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
