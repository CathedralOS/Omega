use routing/model/model.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

// Fixed-width decimal keeps every output field easy to compare as raw bytes.
machine number(value: i32 in Saturating) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_byte(((value / 100) % 10 + 48) as i32);
    |console|::Console::write_byte(((value / 10) % 10 + 48) as i32);
    |console|::Console::write_byte((value % 10 + 48) as i32);
    |console|::Console::write_byte(10);
}

// A route event must be 0..3; guard before the Exact narrowing to i32.
// Domain qualification alone does not authorize a narrowing conversion.
machine route_event(event: u64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    transition event < 4 {
        true -> emit(event),
        false -> corrupt()
    }
    machine emit(event: u64) {
        number((event as i32 +Saturating) + 1);
    }
    machine corrupt() {
        |console|::Console::write_line("INTERNAL: route event outside 0..3");
        |process_exit|::ProcessExit::exit_process(70);
    }
}

// The chosen route is a fixed four-event word. Each arm returns a different
// window of that word: the matched subject proves the head length, and the
// other arm is the remaining three events. The report observes that window
// through a local, a field, a parameter, and a call result before printing.
data RouteSpan<'row> { events: @'row [u64]; }
data Shelf<'row> { span: RouteSpan<'row>; }

machine chosen_span<'row>(route: @'row [u64; 4], which: u64) -> RouteSpan<'row>
ensures result.events.length >= 1
{
    match which {
        0 -> RouteSpan { events: @route[0..which + 1] },
        _ -> RouteSpan { events: @route[1..4] }
    }
}

machine span_starts<'row>(span: RouteSpan<'row>, expected: u64) -> bool
requires span.events.length >= 1
{
    span.events[0] == expected
}

public machine report(certificate: @|model|::Certificate) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_line("sample_collection_routing: synthetic integer-minute model");
    |console|::Console::write_line("explored_words"); number(256);
    |console|::Console::write_line("feasible_tours"); number(certificate.feasible);
    |console|::Console::write_line("optimal_ties"); number(certificate.ties);
    transition certificate.ties > 0 {
        true -> optimal(certificate),
        false -> infeasible()
    }
    machine infeasible() {
        |console|::Console::write_line("INFEASIBLE");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine optimal(certificate: @|model|::Certificate) {
        let head: RouteSpan = chosen_span(@certificate.best.route, 0);
        let head_length: u64 = head.events.length;
        let nested: Shelf = Shelf { span: chosen_span(@certificate.best.route, 1) };
        let field_length: u64 = nested.span.events.length;
        let parameter_ok: bool = span_starts(head, certificate.best.route[0]);
        let call_ok: bool = span_starts(
            chosen_span(@certificate.best.route, 0),
            certificate.best.route[0],
        );
        transition head_length == 1 && field_length == 3 && parameter_ok && call_ok {
            true -> emit_optimal(certificate),
            false -> corrupt_span()
        }
    }
    machine corrupt_span() {
        |console|::Console::write_line("INTERNAL: route window");
        |process_exit|::ProcessExit::exit_process(70);
    }
    machine emit_optimal(certificate: @|model|::Certificate) {
        |console|::Console::write_line("OPTIMAL distance_then_completion lexicographic_route");
        |console|::Console::write_line("distance"); number(certificate.best.distance);
        |console|::Console::write_line("completion"); number(certificate.best.time);
        |console|::Console::write_line("waiting"); number(certificate.best.waiting);
        |console|::Console::write_line("peak_load"); number(certificate.best.peak);
        |console|::Console::write_line("route 000=depot 001=pickup_A 002=pickup_B 003=drop_A 004=drop_B");
        number(0);
        route_event(certificate.best.route[0]);
        route_event(certificate.best.route[1]);
        route_event(certificate.best.route[2]);
        route_event(certificate.best.route[3]);
        number(0);
        |console|::Console::write_line("service_starts");
        number(certificate.best.arrivals[0]);
        number(certificate.best.arrivals[1]);
        number(certificate.best.arrivals[2]);
        number(certificate.best.arrivals[3]);
        |console|::Console::write_line("final_load"); number(certificate.best.load);
        |console|::Console::write_line("final_position"); number(certificate.best.position);
        |process_exit|::ProcessExit::exit_process(0);
    }
}
