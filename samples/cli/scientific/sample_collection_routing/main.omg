use input/parse/parse.omg;
use reporting/certificate/certificate.omg;
use routing/model/model.omg;
use routing/search/search.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// With closed stdin the application rejects the missing record.
// Expected exit: 64.
// Expected output contains: INVALID: expected

data Collection {
    input: [u8; 12];
    plan: |model|::Plan;
    certificate: |model|::Certificate;
}

machine main(collection: @mutable Collection) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let read: |console|::LineReadResult = block |console|::Console::read_line(@mutable collection.input[..]);
    transition read {
        |console|::LineReadResult::LineComplete { count } -> newline(collection, count),
        |console|::LineReadResult::EndOfInput { count } -> eof(collection, count),
        _ -> invalid(collection)
    }
    machine newline(collection: @mutable Collection, count: u64) {
        transition count == 12 && collection.input[11] == 10 {
            true -> decode(collection),
            false -> invalid(collection)
        }
    }
    machine eof(collection: @mutable Collection, count: u64) {
        transition count == 11 {
            true -> decode(collection),
            false -> invalid(collection)
        }
    }
    machine decode(collection: @mutable Collection) {
        let valid: bool = |parse|::parse(@collection.input, @mutable collection.plan);
        transition valid {
            true -> route(collection),
            false -> invalid(collection)
        }
    }
    machine route(collection: @mutable Collection) {
        |search|::solve(@collection.plan, @mutable collection.certificate);
        |certificate|::report(@collection.certificate);
    }
    machine invalid(collection: @mutable Collection) {
        |console|::Console::write_line("INVALID: expected C A B RA RB LA(2) LB(2) H(2), eleven digits; C=1..2, A/B=1..9, ready<=latest");
        |process_exit|::ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Collection;
    block main(@mutable entry_storage);
}
