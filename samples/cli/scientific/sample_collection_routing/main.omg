use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// With closed stdin the application rejects the missing record.
// Expected exit: 64.
// Expected output contains: INVALID: expected
use system\Console;
use system\LineReadResult;
use routing\model;
use routing\model\Plan;
use routing\model\Certificate;
use routing\search;
use routing\search\solve;
use input\parse;
use input\parse\parse;
use reporting\certificate;
use reporting\certificate\report;

data Collection {
    input: [u8; 12];
    plan: Plan;
    certificate: Certificate;
}

machine main(collection: @mutable Collection) reaches ProcessExit + StandardInput + StandardOutput {
    let read: LineReadResult = block Console::read_line(@mutable collection.input[..]);
    transition read {
        LineReadResult::LineComplete { count } -> newline(collection, count),
        LineReadResult::EndOfInput { count } -> eof(collection, count),
        _ -> invalid(collection)
    }
    machine newline(collection: @mutable Collection, count: u64) {
        transition count == 12 && collection.input[11] == 10 {
            true -> decode(collection),
            false -> invalid(collection)
        }
    }
    machine eof(collection: @mutable Collection, count: u64) {
        transition count == 11 {
            true -> decode(collection),
            false -> invalid(collection)
        }
    }
    machine decode(collection: @mutable Collection) {
        let valid: bool = parse(@collection.input, @mutable collection.plan);
        transition valid {
            true -> route(collection),
            false -> invalid(collection)
        }
    }
    machine route(collection: @mutable Collection) {
        solve(@collection.plan, @mutable collection.certificate);
        report(@collection.certificate);
    }
    machine invalid(collection: @mutable Collection) {
        Console::write_line("INVALID: expected C A B RA RB LA(2) LB(2) H(2), eleven digits; C=1..2, A/B=1..9, ready<=latest");
        ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Collection;
    block main(@mutable entry_storage);
}
