use omega::language::core::ProcessExit;
// Complete intended-invalid control: a correction declared nonnegative
// receives a negative exact integer mass. Rejection must name the obligation.
use omega_language_std::Console;
domain i32::Nonnegative requires self >= 0;
data Main { }
machine main(main: &mut Main) reaches ProcessExit + Console {
    let corrected: i32 in Nonnegative = (0 - 1) as +Nonnegative;
    ProcessExit::exit_process(corrected as -Nonnegative);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
