use {omega}/language/core/process_exit.omg;
// Complete intended-invalid control: a correction declared nonnegative
// receives a negative exact integer mass. Rejection must name the obligation.
domain i32::Nonnegative requires self >= 0;
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit {
    let corrected: i32 in Nonnegative = (0 - 1) as +Nonnegative;
    |process_exit|::ProcessExit::exit_process(corrected as -Nonnegative);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
