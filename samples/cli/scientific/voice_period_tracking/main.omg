use domain/report/report.omg;
use domain/scores/scores.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

data Main {
    samples: [i32 in Wrapping; 32];
    length: i32 in Wrapping;
    frame: i32 in Wrapping;
    lag: i32 in Wrapping;
    sum: i32 in Wrapping;
    pairs: i32 in Wrapping;
    best_lag: i32 in Wrapping;
    best_sum: i32 in Wrapping;
    best_pairs: i32 in Wrapping;
    ties: i32 in Wrapping;
    minimum: i32 in Wrapping;
    maximum: i32 in Wrapping;
    status: i32 in Wrapping;
    previous: i32 in Wrapping;
    uncertain_start: i32 in Wrapping;
    eof: bool;
}

// Newline-separated windows, each 1..32 ASCII digits, at most 16 windows.
// EOF closes a final unterminated record. Empty records and CR reject.
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    main.length = 0 as +Wrapping;
    main.frame = 0 as +Wrapping;
    main.previous = 0 as +Wrapping;
    main.uncertain_start = (-1) as +Wrapping;
    main.minimum = 9 as +Wrapping;
    main.maximum = 0 as +Wrapping;
    main.eof = false;
    transition { _ -> block read(main) }
    machine read(main: @mutable Main) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> bad(main),
            |console|::ByteRead::Byte { value } -> block byte(main, value),
            |console|::ByteRead::Eof -> block finish_input(main)
        }
    }
    machine byte(main: @mutable Main, value: i32) {
        transition value == 10 {
            true -> block close(main),
            _ -> block validate(main, value)
        }
    }
    machine validate(main: @mutable Main, value: i32) {
        transition value >= 48 && value <= 57 && main.length >= 0 && main.length < 32 && main.frame < 16 {
            true -> block store(main, value),
            _ -> bad(main)
        }
    }
    machine store(main: @mutable Main, value: i32) {
        let sample: i32 in Wrapping = (value as +Wrapping) - 48;
        main.samples[main.length] = sample;
        main.minimum = match sample < main.minimum { true -> sample, _ -> main.minimum };
        main.maximum = match sample > main.maximum { true -> sample, _ -> main.maximum };
        main.length = main.length + 1;
        transition { _ -> block read(main) }
    }
    machine finish_input(main: @mutable Main) {
        main.eof = true;
        transition main.length > 0 { true -> block close(main), _ -> end(main) }
    }
    machine close(main: @mutable Main) {
        transition main.length > 0 && main.frame < 16 {
            true -> block begin_frame(main),
            _ -> bad(main)
        }
    }
    machine begin_frame(main: @mutable Main) {
        |console|::Console::write("FRAME "); |report|::number(main.frame);
        |console|::Console::write(" "); |report|::number(main.length); |console|::Console::write_line("");
        main.best_lag = 0 as +Wrapping;
        main.status = 3 as +Wrapping;
        main.lag = 2 as +Wrapping;
        main.best_sum = 10000 as +Wrapping;
        main.best_pairs = 1 as +Wrapping;
        main.ties = 0 as +Wrapping;
        transition main.length >= 12 { true -> block score(main), _ -> block track(main) }
    }
    machine score(main: @mutable Main) {
        transition main.lag <= 8 {
            true -> block calculate(main),
            _ -> block classify(main)
        }
    }
    machine calculate(main: @mutable Main) {
        main.sum = |scores|::lag_sum(@main.samples, main.length, main.lag);
        main.pairs = main.length - main.lag;
        |console|::Console::write("LAG "); |report|::number(main.lag);
        |console|::Console::write(" "); |report|::number(main.sum);
        |console|::Console::write(" "); |report|::number(main.pairs); |console|::Console::write_line("");
        transition main.sum * main.best_pairs < main.best_sum * main.pairs {
            true -> block better(main),
            _ -> block tie(main)
        }
    }
    machine better(main: @mutable Main) {
        main.best_lag = main.lag;
        main.best_sum = main.sum;
        main.best_pairs = main.pairs;
        main.ties = 1 as +Wrapping;
        transition { _ -> block next_lag(main) }
    }
    machine tie(main: @mutable Main) {
        main.ties = match main.sum * main.best_pairs == main.best_sum * main.pairs { true -> main.ties + 1, _ -> main.ties };
        transition { _ -> block next_lag(main) }
    }
    machine next_lag(main: @mutable Main) {
        main.lag = main.lag + 1;
        transition { _ -> block score(main) }
    }
    machine classify(main: @mutable Main) {
        main.status = match main.minimum == main.maximum {
            true -> 0 as +Wrapping,
            _ -> match main.best_sum > main.best_pairs {
                true -> 4 as +Wrapping,
                _ -> match main.ties > 1 { true -> 2 as +Wrapping, _ -> 1 as +Wrapping }
            }
        };
        main.best_lag = match main.status == 0 || main.status == 4 { true -> 0 as +Wrapping, _ -> main.best_lag };
        transition { _ -> block track(main) }
    }
    machine track(main: @mutable Main) {
        |console|::Console::write("TRACK "); |report|::number(main.frame);
        |console|::Console::write(" "); |report|::number(main.best_lag);
        |console|::Console::write(" ");
        transition main.best_lag > 0 { true -> pitch(main), _ -> no_pitch(main) }
    }
    machine pitch(main: @mutable Main) {
        |report|::number(8000 / main.best_lag);
        transition { _ -> status(main) }
    }
    machine no_pitch(main: @mutable Main) {
        |report|::number(0 as +Wrapping);
        transition { _ -> status(main) }
    }
    machine status(main: @mutable Main) {
        |console|::Console::write(" "); |report|::number(main.status); |console|::Console::write_line("");
        transition main.previous > 0 && main.best_lag > 0 && main.previous != main.best_lag {
            true -> change(main),
            _ -> uncertainty(main)
        }
    }
    machine change(main: @mutable Main) {
        |console|::Console::write("CHANGE "); |report|::number(main.frame);
        |console|::Console::write(" "); |report|::number(main.previous);
        |console|::Console::write(" "); |report|::number(main.best_lag); |console|::Console::write_line("");
        transition { _ -> uncertainty(main) }
    }
    machine uncertainty(main: @mutable Main) {
        main.previous = main.best_lag;
        transition main.status == 1 && main.uncertain_start >= 0 {
            true -> segment(main),
            _ -> remember(main)
        }
    }
    machine segment(main: @mutable Main) {
        |console|::Console::write("SEGMENT "); |report|::number(main.uncertain_start);
        |console|::Console::write(" "); |report|::number(main.frame); |console|::Console::write_line("");
        main.uncertain_start = (-1) as +Wrapping;
        transition { _ -> remember(main) }
    }
    machine remember(main: @mutable Main) {
        main.uncertain_start = match main.status != 1 && main.uncertain_start < 0 { true -> main.frame, _ -> main.uncertain_start };
        main.frame = main.frame + 1;
        main.length = 0 as +Wrapping;
        main.minimum = 9 as +Wrapping;
        main.maximum = 0 as +Wrapping;
        transition main.eof { true -> end(main), _ -> block read(main) }
    }
    machine end(main: @mutable Main) {
        transition main.frame > 0 {
            true -> end_segment(main),
            _ -> bad(main)
        }
    }
    machine end_segment(main: @mutable Main) {
        transition main.uncertain_start >= 0 {
            true -> final_segment(main),
            _ -> good(main)
        }
    }
    machine final_segment(main: @mutable Main) {
        |console|::Console::write("SEGMENT "); |report|::number(main.uncertain_start);
        |console|::Console::write(" "); |report|::number(main.frame); |console|::Console::write_line("");
        transition { _ -> good(main) }
    }
    machine good(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(0); }
    machine bad(main: @mutable Main) { |console|::Console::write_line("ERROR input"); |process_exit|::ProcessExit::exit_process(64); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
