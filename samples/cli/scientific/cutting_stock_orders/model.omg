module model;
// Integer millimetres; a cut always consumes one kerf, even an exact-end cut.
// Zero remnant means absent; leftover >= 5 is reusable, smaller leftover is scrap.
public data Orders {
    values: [i32 in Wrapping; 7];
}
public data Plan {
    code: i32 in Wrapping;
    fulfilled: i32 in Wrapping;
    useful: i32 in Wrapping;
    fresh: i32 in Wrapping;
    opened: i32 in Wrapping;
    ties: i32 in Wrapping;
    loads: [i32 in Wrapping; 3];
    counts: [i32 in Wrapping; 3];
}
