module input;
use model;
use omega::language::core::numeric_conversion;
// Fixed grammar: SSS RRR K LLL LLL LLL LLL, followed by LF or EOF.
public machine parse(bytes: &[u8; 32], orders: &mut model::Orders) -> bool {
    orders.values = [0,0,0,0,0,0,0];
    transition { _ -> scan(bytes, orders, 0, 0) }
    machine scan(bytes: &[u8; 32], orders: &mut model::Orders,
               position: i32 in Wrapping, field: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 25 && field >= 0 && field < 7 {
            true -> character(bytes, orders, position, field)
            _ -> validate(orders)
        }
    }
    machine character(bytes: &[u8; 32], orders: &mut model::Orders,
                    position: i32 in Wrapping, field: i32 in Wrapping) -> bool {
        let byte: i32 in Wrapping = widen_u8_to_i32(bytes[position]) as i32 in Wrapping;
        transition position == 3 || position == 7 || position == 9 || position == 13 || position == 17 || position == 21 {
            true -> separator(bytes, orders, position, field, byte)
            _ -> digit(bytes, orders, position, field, byte)
        }
    }
    machine separator(bytes: &[u8; 32], orders: &mut model::Orders,
                    position: i32 in Wrapping, field: i32 in Wrapping, byte: i32 in Wrapping) -> bool {
        transition byte == 32 {
            true -> scan(bytes, orders, position + 1, field + 1)
            _ -> false
        }
    }
    machine digit(bytes: &[u8; 32], orders: &mut model::Orders,
                position: i32 in Wrapping, field: i32 in Wrapping, byte: i32 in Wrapping) -> bool {
        transition byte >= 48 && byte <= 57 && field >= 0 && field < 7 {
            true -> accumulate(bytes, orders, position, field, byte)
            _ -> false
        }
    }
    machine accumulate(bytes: &[u8; 32], orders: &mut model::Orders,
                      position: i32 in Wrapping, field: i32 in Wrapping, byte: i32 in Wrapping) -> bool {
        orders.values[field] = orders.values[field] * 10 + byte - 48;
        transition { _ -> scan(bytes, orders, position + 1, field) }
    }
    machine validate(orders: &model::Orders) -> bool {
        orders.values[0] > 0 && orders.values[3] > 0 && orders.values[4] > 0 && orders.values[5] > 0 && orders.values[6] > 0
    }
}
