use domain/fit/fit.omg;
use domain/input/input.omg;
use domain/model/model.omg;
use domain/report/report.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Read supplied dose/replicate/control observations, fit and profile a 4PL.
// Expected exit: 2.
// Expected output contains: error=input:

data Main { reader: |input|::InputReader; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    main.reader.remaining = 4096; main.reader.exhausted = false;
    let mutable observations: |model|::Observations;
    let valid: bool = block |input|::read_input(@mutable main.reader, @mutable observations);
    transition valid {
        true -> fit(main, @mutable observations),
        _ -> invalid(main)
    }
    machine fit(main: @mutable Main, observations: @mutable |model|::Observations) {
        let mutable result: |model|::Fit;
        |fit|::fit_curve(observations, @mutable result);
        transition result.status {
            0 -> output(main, observations, @result),
            3 -> flat(main),
            4 -> unidentified(main),
            5 -> direction(main),
            _ -> convergence(main)
        }
    }
    machine output(main: @mutable Main, observations: @|model|::Observations, result: @|model|::Fit) {
        |report|::report(observations, result);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("error=input: invalid or duplicate observation; require 8..32 rows, at least five sample doses, valid direction/noise/roles and <=4096 bytes");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine flat(main: @mutable Main) {
        |console|::Console::write_line("converged=true"); |console|::Console::write_line("identifiable=false");
        |console|::Console::write_line("error=flat: fitted amplitude must exceed five supplied noise standard deviations");
        |process_exit|::ProcessExit::exit_process(3);
    }
    machine unidentified(main: @mutable Main) {
        |console|::Console::write_line("identifiable=false");
        |console|::Console::write_line("error=unidentified: profile failed to close strictly within parameter bounds or nuisance minimization did not converge");
        |process_exit|::ProcessExit::exit_process(4);
    }
    machine direction(main: @mutable Main) {
        |console|::Console::write_line("converged=true"); |console|::Console::write_line("identifiable=false");
        |console|::Console::write_line("error=direction: fitted response contradicts requested activation or inhibition");
        |process_exit|::ProcessExit::exit_process(5);
    }
    machine convergence(main: @mutable Main) {
        |console|::Console::write_line("converged=false"); |console|::Console::write_line("identifiable=false");
        |console|::Console::write_line("error=convergence: bounded numerical search exhausted its iteration limit");
        |process_exit|::ProcessExit::exit_process(6);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
