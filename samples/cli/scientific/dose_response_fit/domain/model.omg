// Synthetic bounded 4PL. Controls observe the low/high dose limits directly;
// every replicate remains one equally weighted observation.
public data Observations {
    count: i32 in Wrapping;
    direction: i32;
    sigma: f64;
    dose: [i32; 32];
    replicate: [i32; 32];
    role: [i32; 32];
    logarithm: [f64; 32];
    response: [f64; 32];
    group_count: i32 in Wrapping;
    group_dose: [i32; 32];
    group_role: [i32; 32];
    group_logarithm: [f64; 32];
    group_mean: [f64; 32];
    group_weight: [f64; 32];
    group_variance: [f64; 32];
    lower_log_half: f64;
    upper_log_half: f64;
}
public data Candidate [copy] {
    low: f64;
    high: f64;
    log_half: f64;
    hill: f64;
    sse: f64;
    converged: bool;
    iterations: i32 in Wrapping;
}
public data Profile [copy] { fixed: i32; value: f64; }
public data Fit {
    candidate: Candidate;
    lower: [f64; 4];
    upper: [f64; 4];
    endpoint_sse: [f64; 8];
    reconstruction: [f64; 32];
    residual: [f64; 32];
    cutoff: f64;
    status: i32;
}
