use domain/mathematics/mathematics.omg;
use domain/model/model.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data InputReader {
    remaining: i32 in Wrapping;
    exhausted: bool;
}
data Token {
    case Invalid;
    case End;
    case Number(value: i32);
}
// The caller sets a 4096-byte budget; exhaustion is distinct from real EOF.
machine next_byte(reader: @mutable InputReader) -> |console|::ByteRead reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    let byte: |console|::ByteRead = block |console|::Console::read_byte();
    transition byte {
        |console|::ByteRead::Error -> |console|::ByteRead::Error,
        |console|::ByteRead::Eof -> |console|::ByteRead::Eof,
        |console|::ByteRead::Byte { value } -> capacity(reader, value)
    }
    machine capacity(reader: @mutable InputReader, value: i32) -> |console|::ByteRead
    requires value >= 0 && value <= 255
    {
        transition reader.remaining > 0 {
            true -> consume(reader, value),
            _ -> limit(reader)
        }
    }
    machine consume(reader: @mutable InputReader, value: i32) -> |console|::ByteRead
    requires value >= 0 && value <= 255
    {
        reader.remaining = reader.remaining - 1;
        |console|::ByteRead::Byte { value: value }
    }
    machine limit(reader: @mutable InputReader) -> |console|::ByteRead {
        reader.exhausted = true;
        |console|::ByteRead::Eof
    }
}
machine token(reader: @mutable InputReader) -> Token reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> skip(reader) }
    machine skip(reader: @mutable InputReader) -> Token {
        let byte: |console|::ByteRead = block next_byte(reader);
        transition byte {
            |console|::ByteRead::Error -> Token::Invalid,
            |console|::ByteRead::Eof -> Token::End,
            |console|::ByteRead::Byte { value } -> first(reader, value)
        }
    }
    machine first(reader: @mutable InputReader, byte: i32) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> skip(reader),
            _ -> sign(reader, byte)
        }
    }
    machine sign(reader: @mutable InputReader, byte: i32) -> Token {
        transition byte == 45 {
            true -> next(reader, 0, 0, true),
            _ -> digit(reader, byte, 0, 0, false)
        }
    }
    machine digit(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte >= 48 && byte <= 57 && digits < 7 {
            true -> accumulate(reader, byte, magnitude, digits, negative),
            _ -> Token::Invalid
        }
    }
    machine accumulate(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                     digits: i32 in Wrapping, negative: bool) -> Token {
        let updated: i32 in Wrapping = magnitude * 10 + (byte as i32 +Wrapping) - 48;
        transition updated <= 1000000 {
            true -> next(reader, updated, digits + 1, negative),
            _ -> Token::Invalid
        }
    }
    machine next(reader: @mutable InputReader, magnitude: i32 in Wrapping,
               digits: i32 in Wrapping, negative: bool) -> Token {
        let byte: |console|::ByteRead = block next_byte(reader);
        transition byte {
            |console|::ByteRead::Error -> Token::Invalid,
            |console|::ByteRead::Eof -> finish(magnitude, digits, negative),
            |console|::ByteRead::Byte { value } -> delimiter(reader, value, magnitude, digits, negative)
        }
    }
    machine delimiter(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                    digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> finish(magnitude, digits, negative),
            _ -> digit(reader, byte, magnitude, digits, negative)
        }
    }
    machine finish(magnitude: i32 in Wrapping, digits: i32 in Wrapping, negative: bool) -> Token {
        transition digits > 0 {
            true -> signed_value(magnitude, negative),
            _ -> Token::Invalid
        }
    }
    machine signed_value(magnitude: i32 in Wrapping, negative: bool) -> Token {
        transition negative {
            true -> Token::Number { value: (0 - magnitude) as i32 },
            _ -> Token::Number { value: magnitude as i32 }
        }
    }
}
data Row { dose: i32; replicate: i32; role: i32; }
public machine read_input(reader: @mutable InputReader, observations: @mutable |model|::Observations) -> bool reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    let item: Token = block token(reader);
    transition item {
        Token::Number { value } -> direction(reader, observations, value),
        _ -> false
    }
    machine direction(reader: @mutable InputReader, observations: @mutable |model|::Observations, value: i32) -> bool {
        observations.direction = value;
        transition value == 1 || value == -1 {
            true -> size(reader, observations),
            _ -> false
        }
    }
    machine size(reader: @mutable InputReader, observations: @mutable |model|::Observations) -> bool {
        let item: Token = block token(reader);
        transition item {
            Token::Number { value } -> count(reader, observations, value),
            _ -> false
        }
    }
    machine count(reader: @mutable InputReader, observations: @mutable |model|::Observations, value: i32) -> bool {
        observations.count = value as +Wrapping;
        transition value >= 8 && value <= 32 {
            true -> noise(reader, observations),
            _ -> false
        }
    }
    machine noise(reader: @mutable InputReader, observations: @mutable |model|::Observations) -> bool {
        let item: Token = block token(reader);
        transition item {
            Token::Number { value } -> sigma(reader, observations, value),
            _ -> false
        }
    }
    machine sigma(reader: @mutable InputReader, observations: @mutable |model|::Observations, value: i32) -> bool {
        observations.sigma = |float_operations|::F64::from_i32(value) / 1000.0;
        transition value >= 1 && value <= 10000 {
            true -> begin(reader, observations),
            _ -> false
        }
    }
    machine begin(reader: @mutable InputReader, observations: @mutable |model|::Observations) -> bool {
        let mutable row: Row;
        transition { _ -> rows(reader, observations, @mutable row, 0, 0) }
    }
    machine rows(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
               position: i32 in Wrapping, field: i32 in Wrapping) -> bool {
        let item: Token = block token(reader);
        transition item {
            Token::End -> finish(reader, observations, position, field),
            Token::Number { value } -> capacity(reader, observations, row, position, field, value),
            _ -> false
        }
    }
    machine finish(reader: @InputReader, observations: @|model|::Observations,
                 position: i32 in Wrapping, field: i32 in Wrapping) -> bool {
        transition position == observations.count && field == 0 && !reader.exhausted {
            true -> validate_design(observations),
            _ -> false
        }
    }
    machine capacity(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
                   position: i32 in Wrapping, field: i32 in Wrapping, value: i32) -> bool {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> select(reader, observations, row, position, field, value),
            _ -> false
        }
    }
    machine select(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
                 position: i32 in Wrapping, field: i32 in Wrapping, value: i32) -> bool {
        transition field {
            0 -> dose(reader, observations, row, position, value),
            1 -> replicate(reader, observations, row, position, value),
            2 -> role(reader, observations, row, position, value),
            _ -> response(reader, observations, row, position, value)
        }
    }
    machine dose(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
               position: i32 in Wrapping, value: i32) -> bool {
        row.dose = value;
        transition value >= 0 && value <= 10000 {
            true -> rows(reader, observations, row, position, 1),
            _ -> false
        }
    }
    machine replicate(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
                    position: i32 in Wrapping, value: i32) -> bool {
        row.replicate = value;
        transition value >= 1 && value <= 32 {
            true -> rows(reader, observations, row, position, 2),
            _ -> false
        }
    }
    machine role(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
               position: i32 in Wrapping, value: i32) -> bool {
        row.role = value;
        transition value >= 0 && value <= 2 {
            true -> rows(reader, observations, row, position, 3),
            _ -> false
        }
    }
    machine response(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
                   position: i32 in Wrapping, value: i32) -> bool {
        transition value >= -20000 && value <= 120000
            && ((row.role == 0 && row.dose > 0) || (row.role != 0 && row.dose == 0)) {
            true -> store(reader, observations, row, position, value),
            _ -> false
        }
    }
    machine store(reader: @mutable InputReader, observations: @mutable |model|::Observations, row: @mutable Row,
                position: i32 in Wrapping, value: i32) -> bool {
        observations.dose[position] = row.dose;
        observations.replicate[position] = row.replicate;
        observations.role[position] = row.role;
        observations.response[position] = |float_operations|::F64::from_i32(value) / 1000.0;
        observations.logarithm[position] = |mathematics|::logarithm(|mathematics|::clamp(|float_operations|::F64::from_i32(row.dose), 1.0, 10000.0));
        transition { _ -> rows(reader, observations, row, position + 1, 0) }
    }
}
// Observation identity includes dose, role and replicate. Reusing an identity
// would silently double its statistical weight, so it is an input refusal.
machine validate_design(observations: @|model|::Observations) -> bool {
    transition { _ -> scan(observations, 0, 0) }
    machine scan(observations: @|model|::Observations, position: i32 in Wrapping, distinct: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> compare(observations, position, 0, distinct, false),
            _ -> (distinct >= 5)
        }
    }
    machine compare(observations: @|model|::Observations, position: i32 in Wrapping,
                  prior: i32 in Wrapping, distinct: i32 in Wrapping, seen_dose: bool) -> bool {
        transition prior >= 0 && prior < 32 && prior < position {
            true -> pair(observations, position, prior, distinct, seen_dose),
            _ -> unique(observations, position, distinct, seen_dose)
        }
    }
    machine pair(observations: @|model|::Observations, position: i32 in Wrapping,
               prior: i32 in Wrapping, distinct: i32 in Wrapping, seen_dose: bool) -> bool {
        let same: bool = observations.dose[position] == observations.dose[prior]
            && observations.role[position] == observations.role[prior];
        transition same && observations.replicate[position] == observations.replicate[prior] {
            true -> false,
            _ -> compare(observations, position, prior + 1, distinct, seen_dose || same)
        }
    }
    machine unique(observations: @|model|::Observations, position: i32 in Wrapping,
                 distinct: i32 in Wrapping, seen_dose: bool) -> bool {
        transition observations.role[position] == 0 && !seen_dose {
            true -> scan(observations, position + 1, distinct + 1),
            _ -> scan(observations, position + 1, distinct)
        }
    }
}
