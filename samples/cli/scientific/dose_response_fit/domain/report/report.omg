use domain/mathematics/mathematics.omg;
use domain/model/model.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

// Fixed six-decimal reporting; bounded input makes all scaled values fit i64.
// Round magnitude half upward and retain the sign separately.
machine number(value: f64) reaches |process_authority|::StandardOutput {
    let mutable bytes: [u8; 21] = "+0000000000000.000000";
    transition value < 0.0 {
        true -> negative(@mutable bytes, value),
        _ -> positive(@mutable bytes, value)
    }
    machine negative(bytes: @mutable [u8; 21], value: f64) {
        bytes[0] = 45;
        let scaled: i64 in Saturating = |float_operations|::I64::from_f64((0.0 - value) * 1000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as -Saturating +Wrapping, 20) }
    }
    machine positive(bytes: @mutable [u8; 21], value: f64) {
        let scaled: i64 in Saturating = |float_operations|::I64::from_f64(value * 1000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as -Saturating +Wrapping, 20) }
    }
    machine digits(bytes: @mutable [u8; 21],
                 remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position > 0 && position < 21 {
            true -> separator(bytes, remaining, position),
            _ -> emit(bytes)
        }
    }
    machine separator(bytes: @mutable [u8; 21],
                    remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position == 14 {
            true -> digits(bytes, remaining, position - 1),
            _ -> store(bytes, remaining, position)
        }
    }
    machine store(bytes: @mutable [u8; 21],
                remaining: i64 in Wrapping, position: i32 in Wrapping) {
        let digit: i32 = |numeric_conversion|::narrow_i64_to_i32_trapping((remaining % 10 + 48) as i64);
        bytes[position] = |numeric_conversion|::narrow_i32_to_u8_trapping(digit);
        transition { _ -> digits(bytes, remaining / 10, position - 1) }
    }
    machine emit(bytes: @[u8; 21]) { |console|::Console::write_line(bytes); }
}
public machine report(observations: @|model|::Observations, fit: @|model|::Fit) reaches |process_authority|::StandardOutput
invokes |console|::Console
crashes Trap
{
    |console|::Console::write_line("dose_response_fit synthetic bounded 4PL");
    |console|::Console::write_line("converged=true"); |console|::Console::write_line("identifiable=true");
    |console|::Console::write_line("profile_confidence=0.95");
    transition observations.direction == 1 {
        true -> activation(observations, fit),
        _ -> inhibition(observations, fit)
    }
    machine activation(observations: @|model|::Observations, fit: @|model|::Fit) {
        |console|::Console::write_line("half_dose_kind=EC50");
        transition { _ -> values(observations, fit) }
    }
    machine inhibition(observations: @|model|::Observations, fit: @|model|::Fit) {
        |console|::Console::write_line("half_dose_kind=IC50");
        transition { _ -> values(observations, fit) }
    }
    machine values(observations: @|model|::Observations, fit: @|model|::Fit) {
        |console|::Console::write("half_dose="); number(|mathematics|::exponential(fit.candidate.log_half));
        |console|::Console::write("lowdose_asymptote="); number(fit.candidate.low);
        |console|::Console::write("highdose_asymptote="); number(fit.candidate.high);
        |console|::Console::write("log_half_dose="); number(fit.candidate.log_half);
        |console|::Console::write("slope="); number(fit.candidate.hill);
        |console|::Console::write("signed_slope="); number(fit.candidate.hill * |float_operations|::F64::from_i32(observations.direction));
        |console|::Console::write("sse="); number(fit.candidate.sse);
        |console|::Console::write("sigma="); number(observations.sigma);
        |console|::Console::write("profile_cutoff="); number(fit.cutoff);
        |console|::Console::write("iterations="); number(|float_operations|::F64::from_i32(fit.candidate.iterations as i32));
        |console|::Console::write("lowdose_asymptote_lower="); number(fit.lower[0]);
        |console|::Console::write("lowdose_asymptote_upper="); number(fit.upper[0]);
        |console|::Console::write("highdose_asymptote_lower="); number(fit.lower[1]);
        |console|::Console::write("highdose_asymptote_upper="); number(fit.upper[1]);
        |console|::Console::write("log_half_dose_lower="); number(fit.lower[2]);
        |console|::Console::write("log_half_dose_upper="); number(fit.upper[2]);
        |console|::Console::write("slope_lower="); number(fit.lower[3]);
        |console|::Console::write("slope_upper="); number(fit.upper[3]);
        |console|::Console::write("half_dose_lower="); number(|mathematics|::exponential(fit.lower[2]));
        |console|::Console::write("half_dose_upper="); number(|mathematics|::exponential(fit.upper[2]));
        transition { _ -> endpoints(observations, fit, 0) }
    }
    machine endpoints(observations: @|model|::Observations, fit: @|model|::Fit, position: i32 in Wrapping) {
        transition position >= 0 && position < 8 {
            true -> endpoint(observations, fit, position),
            _ -> samples(observations, fit, 0)
        }
    }
    machine endpoint(observations: @|model|::Observations, fit: @|model|::Fit, position: i32 in Wrapping) {
        |console|::Console::write("profile_endpoint_sse_"); |console|::Console::write_byte((position + 48) as i32); |console|::Console::write("=");
        number(fit.endpoint_sse[position]);
        transition { _ -> endpoints(observations, fit, position + 1) }
    }
    machine samples(observations: @|model|::Observations, fit: @|model|::Fit, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> sample(observations, fit, position),
            _ -> done()
        }
    }
    machine sample(observations: @|model|::Observations, fit: @|model|::Fit, position: i32 in Wrapping) {
        |console|::Console::write("prediction_"); |console|::Console::write_byte((position / 10 + 48) as i32);
        |console|::Console::write_byte((position % 10 + 48) as i32); |console|::Console::write("=");
        number(fit.reconstruction[position]);
        |console|::Console::write("residual_"); |console|::Console::write_byte((position / 10 + 48) as i32);
        |console|::Console::write_byte((position % 10 + 48) as i32); |console|::Console::write("=");
        number(fit.residual[position]);
        transition { _ -> samples(observations, fit, position + 1) }
    }
    machine done() { |console|::Console::write_line("status=ok"); }
}
