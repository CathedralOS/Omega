use input/parse/parse.omg;
use model/fill/fill.omg;
use report/output/output.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// A complete runtime-input model; there is no baked expected map in this entry.
// Closed stdin is an invalid request; native fixture runs supply data/*.in.
// Expected exit: 64.
// Expected output contains: INVALID_INPUT

data Main { }

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable input: [u8; 32];
    let result: |console|::LineReadResult = block |console|::Console::read_line(@mutable input[..]);
    transition result {
        |console|::LineReadResult::LineComplete { count } -> prefix(main, @input, count),
        |console|::LineReadResult::EndOfInput { count } -> prefix(main, @input, count),
        _ -> invalid(main)
    }
    machine prefix(main: @mutable Main, input: @[u8; 32], count: u64) {
        transition count <= 32 {
            true -> parse(main, @input[0..count]),
            _ -> invalid(main)
        }
    }
    machine parse(main: @mutable Main, text: @[u8]) {
        let mutable cavity: |fill|::Cavity;
        let valid: bool = |parse|::parse_input(text, @mutable cavity);
        transition valid {
            true -> simulate(main, @mutable cavity),
            _ -> invalid(main)
        }
    }
    machine simulate(main: @mutable Main, cavity: @mutable |fill|::Cavity) {
        transition |fill|::arrival_row_holds() {
            true -> advance(main, cavity),
            _ -> unbalanced(main)
        }
    }
    machine advance(main: @mutable Main, cavity: @mutable |fill|::Cavity) {
        |fill|::cavity_simulate(cavity);
        transition |fill|::balanced(cavity) {
            true -> publish(main, cavity),
            _ -> unbalanced(main)
        }
    }
    machine publish(main: @mutable Main, cavity: @|fill|::Cavity) {
        |output|::report(cavity);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("INVALID_INPUT");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine unbalanced(main: @mutable Main) {
        |console|::Console::write_line("INTERNAL_BALANCE_ERROR");
        |process_exit|::ProcessExit::exit_process(70);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
