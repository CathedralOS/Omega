use physics/model/model.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

// Fixed twelve-digit signed decimal fields avoid a host formatting dependency.
// All values in this bounded model fit; the validator checks each numeric field.
public machine integer(value: i64 in Saturating) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    transition value < 0 {
        true -> negative(value),
        false -> digits(value, 100000000000)
    }
    machine negative(value: i64 in Saturating) {
        |console|::Console::write_byte(45);
        transition { _ -> digits(0 - value, 100000000000) }
    }
    machine digits(value: i64 in Saturating, divisor: i64 in Saturating)
    requires divisor >= 1
    {
        let digit: i64 in Saturating = (value / divisor) % 10;
        |console|::Console::write_byte((digit as i32) + 48);
        transition divisor >= 10 {
            true -> digits(value, divisor / 10),
            false -> done()
        }
    }
    machine done() { }
}

public machine field(value: f64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    let scaled: f64 = value * 1000000.0;
    transition scaled == scaled && scaled >= -99999999999.0 && scaled <= 99999999999.0 {
        true -> bounded(scaled),
        false -> invalid()
    }
    machine bounded(scaled: f64)
    requires scaled == scaled && scaled >= -99999999999.0 && scaled <= 99999999999.0
    {
        |console|::Console::write_byte(44);
        // The named conversion explicitly truncates; an Exact recast would
        // instead owe preservation of the fractional value.
        let converted: i64 = |float_operations|::I64::from_f64(scaled);
        integer(converted as +Saturating);
    }
    machine invalid() { |console|::Console::write_line("ERROR numeric output range"); |process_exit|::ProcessExit::exit_process(70); }
}

public machine report(tick: u64, tree: @|model|::ReflectionTree)
requires tick < 24
reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write("W,");
    integer(tick as i64 +Saturating);
    field(tree.record.junction_left_in);
    field(tree.record.junction_right_in);
    field(tree.record.junction_left_out);
    field(tree.record.junction_right_out);
    field(tree.record.source_in);
    field(tree.record.source_out);
    field(tree.record.load_in);
    field(tree.record.load_out);
    |console|::Console::write_byte(10);
    |console|::Console::write("V,");
    integer(tick as i64 +Saturating);
    field(tree.record.source_voltage);
    field(tree.record.junction_voltage);
    field(tree.record.load_voltage);
    |console|::Console::write_byte(10);
    |console|::Console::write("E,");
    integer(tick as i64 +Saturating);
    field(tree.supplied);
    field(tree.source_heat);
    field(tree.load_heat);
    field(tree.travelling);
    field(tree.supplied - tree.source_heat - tree.load_heat - tree.travelling);
    |console|::Console::write_byte(10);
}
