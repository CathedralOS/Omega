use omega\language\core\StandardInput;
use omega\language\core\ProcessExit;
// Complete positive control: a local fixed byte buffer crosses a case edge
// after the standard input provider filled it. With input 0 LF, exit 70.
use system\Console;
use system\LineReadResult;
data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput {
    let mutable input: [u8; 8];
    let observed: LineReadResult = block Console::read_line(@mutable input[..]);
    transition observed {
        LineReadResult::LineComplete { count } -> inspect(main, @input, count),
        _ -> bad(main)
    }
    machine inspect(main: @mutable Main, input: @[u8; 8], count: u64) {
        transition count == 2 && input[0] == 48 && input[1] == 10 {
            true -> good(main),
            _ -> bad(main)
        }
    }
    machine good(main: @mutable Main) { ProcessExit::exit_process(70); }
    machine bad(main: @mutable Main) { ProcessExit::exit_process(2); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
