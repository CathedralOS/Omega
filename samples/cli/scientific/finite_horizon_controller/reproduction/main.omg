use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete positive control: a local fixed byte buffer crosses a case edge
// after the standard input provider filled it. With input 0 LF, exit 70.
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let mutable input: [u8; 8];
    let observed: |console|::LineReadResult = block |console|::Console::read_line(@mutable input[..]);
    transition observed {
        |console|::LineReadResult::LineComplete { count } -> inspect(main, @input, count),
        _ -> bad(main)
    }
    machine inspect(main: @mutable Main, input: @[u8; 8], count: u64) {
        transition count == 2 && input[0] == 48 && input[1] == 10 {
            true -> good(main),
            _ -> bad(main)
        }
    }
    machine good(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(70); }
    machine bad(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(2); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
