use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Offline controller: input selection, validation, exhaustive search, reporting.
// No source outside this application supplies any controller algorithm.
use system\Console;
use system\LineReadResult;
use controller\model;
use controller\model\Problem;
use controller\model\Plan;
use controller\model\valid_problem;
use controller\search;
use controller\search\optimize;
use data\fixtures;
use data\fixtures\load_case;
use io\render;
use io\render\report;

data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("IND07 finite horizon controller: select 0..7");
    let mutable input: [u8; 8];
    let observed: LineReadResult = block Console::read_line(@mutable input[..]);
    transition observed {
        LineReadResult::LineComplete { count } -> parse(main, @input, count),
        _ -> bad_input(main)
    }
    machine parse(main: @mutable Main, input: @[u8; 8], count: u64) {
        transition count == 2 && input[0] >= 48 && input[0] <= 55 && input[1] == 10 {
            true -> selected(main, (input[0] as i32) - 48),
            _ -> bad_input(main)
        }
    }
    machine selected(main: @mutable Main, selector: i32) {
        let mutable problem: Problem;
        load_case(@mutable problem, selector);
        let valid: bool = valid_problem(@problem);
        transition valid {
            true -> solve(main, @problem),
            _ -> bad_problem(main)
        }
    }
    machine solve(main: @mutable Main, problem: @Problem) {
        let mutable plan: Plan;
        optimize(problem, @mutable plan);
        report(problem, @plan);
    }
    machine bad_input(main: @mutable Main) {
        Console::write_line("INVALID: expected one selector digit and LF");
        ProcessExit::exit_process(2);
    }
    machine bad_problem(main: @mutable Main) {
        Console::write_line("INVALID: problem outside supported bounds");
        ProcessExit::exit_process(2);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
