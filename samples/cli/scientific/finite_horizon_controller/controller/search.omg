use controller::model;
// Enumerate all base-three words in numeric order, most significant digit
// first. This is lexicographic order for -1,0,1. Strict improvement retains
// the first equal-cost word. No pruning or heuristic can hide an optimum.
machine optimize(problem: &Problem, plan: &mut Plan) {
    plan.candidates = power_three(problem.horizon);
    plan.feasible = 0;
    plan.boundary_rejected = 0;
    plan.terminal_rejected = 0;
    plan.code = 0;
    plan.cost = 10000;
    let divisor: i32 in Wrapping = power_three(problem.horizon - 1);
    transition { _ -> candidate(problem, plan, 0, divisor) }
    machine candidate(problem: &Problem, plan: &mut Plan, code: i32 in Wrapping,
                    divisor: i32 in Wrapping) {
        transition code < plan.candidates {
            true -> evaluate(problem, plan, code, divisor)
            _ -> done()
        }
    }
    machine evaluate(problem: &Problem, plan: &mut Plan, code: i32 in Wrapping,
                   divisor: i32 in Wrapping) {
        let cost: i32 in Wrapping = sequence_cost(problem, code, divisor);
        transition cost {
            -1 -> boundary(problem, plan, code, divisor)
            -2 -> terminal(problem, plan, code, divisor)
            _ -> feasible(problem, plan, code, divisor, cost)
        }
    }
    machine boundary(problem: &Problem, plan: &mut Plan, code: i32 in Wrapping, divisor: i32 in Wrapping) {
        plan.boundary_rejected = plan.boundary_rejected + 1;
        transition { _ -> candidate(problem, plan, code + 1, divisor) }
    }
    machine terminal(problem: &Problem, plan: &mut Plan, code: i32 in Wrapping, divisor: i32 in Wrapping) {
        plan.terminal_rejected = plan.terminal_rejected + 1;
        transition { _ -> candidate(problem, plan, code + 1, divisor) }
    }
    machine feasible(problem: &Problem, plan: &mut Plan, code: i32 in Wrapping,
                   divisor: i32 in Wrapping, cost: i32 in Wrapping) {
        plan.feasible = plan.feasible + 1;
        transition cost < plan.cost {
            true -> improve(problem, plan, code, divisor, cost)
            _ -> candidate(problem, plan, code + 1, divisor)
        }
    }
    machine improve(problem: &Problem, plan: &mut Plan, code: i32 in Wrapping,
                  divisor: i32 in Wrapping, cost: i32 in Wrapping) {
        plan.code = code;
        plan.cost = cost;
        transition { _ -> candidate(problem, plan, code + 1, divisor) }
    }
    machine done() { }
}
// Reject at the first invalid action or next state, then enforce the optional
// exact terminal target. Costs charge the post-action state at every step.
machine sequence_cost(problem: &Problem, code: i32 in Wrapping,
                      divisor: i32 in Wrapping) -> i32 in Wrapping {
    transition { _ -> step(problem, code, divisor, problem.initial, 0) }
    machine step(problem: &Problem, code: i32 in Wrapping, divisor: i32 in Wrapping,
               position: i32 in Wrapping, cost: i32 in Wrapping) -> i32 in Wrapping {
        transition divisor > 0 {
            true -> action(problem, code, divisor, position, cost)
            _ -> finish(problem, position, cost)
        }
    }
    machine action(problem: &Problem, code: i32 in Wrapping, divisor: i32 in Wrapping,
                 position: i32 in Wrapping, cost: i32 in Wrapping) -> i32 in Wrapping {
        let action: i32 in Wrapping = code / divisor % 3 - 1;
        let next: i32 in Wrapping = position + action + problem.drift;
        let error: i32 in Wrapping = next - problem.target;
        transition action >= problem.action_lower && action <= problem.action_upper
            && next >= problem.lower && next <= problem.upper {
            true -> step(problem, code, divisor / 3, next,
                         cost + problem.state_weight * error * error + problem.action_weight * action * action)
            _ -> (0 - 1)
        }
    }
    machine finish(problem: &Problem, position: i32 in Wrapping, cost: i32 in Wrapping) -> i32 in Wrapping {
        let error: i32 in Wrapping = position - problem.target;
        transition problem.exact_terminal && position != problem.target {
            true -> (0 - 2)
            _ -> (cost + problem.terminal_weight * error * error)
        }
    }
}
