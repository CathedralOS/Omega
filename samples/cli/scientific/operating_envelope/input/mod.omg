module input;
use omega::language::core::numeric_conversion;

// A complete newline-terminated packet of at most 26 signed decimal integers.
// Magnitudes are checked before multiplication, so hostile input cannot wrap.
public data Packet {
    values: [i32; 26];
    count: i32 in Wrapping;
    valid: bool;
}
public machine parse(packet: &mut Packet, bytes: &[u8; 256]) {
    packet.count = 0;
    packet.valid = false;
    transition { _ -> scan(packet, bytes, 0, 0, false, false) }
    machine scan(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping,
               value: i32 in Wrapping, negative: bool, started: bool) {
        transition cursor >= 0 && cursor < 256 {
            true -> byte(packet, bytes, cursor, value, negative, started)
            _ -> done()
        }
    }
    machine byte(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping,
               value: i32 in Wrapping, negative: bool, started: bool) {
        let character: i32 = widen_u8_to_i32(bytes[cursor]);
        transition character {
            10 -> finish(packet, value, negative, started)
            32 -> separate(packet, bytes, cursor, value, negative, started)
            45 -> sign(packet, bytes, cursor, value, negative, started)
            _ -> digit(packet, bytes, cursor, value, negative, character)
        }
    }
    machine sign(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping,
               value: i32 in Wrapping, negative: bool, started: bool) {
        transition started || negative {
            true -> done()
            _ -> scan(packet, bytes, cursor + 1, value, true, false)
        }
    }
    machine digit(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping,
                value: i32 in Wrapping, negative: bool, character: i32) {
        transition character >= 48 && character <= 57 && value <= 10000000 {
            true -> accumulate(packet, bytes, cursor, value, negative, character)
            _ -> done()
        }
    }
    machine accumulate(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping,
                     value: i32 in Wrapping, negative: bool, character: i32) {
        let next: i32 in Wrapping = value * 10 + (character as i32 in Wrapping) - 48;
        transition next <= 100000000 {
            true -> scan(packet, bytes, cursor + 1, next, negative, true)
            _ -> done()
        }
    }
    machine separate(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping,
                   value: i32 in Wrapping, negative: bool, started: bool) {
        transition started {
            true -> store(packet, bytes, cursor, value, negative)
            _ -> blank(packet, bytes, cursor, negative)
        }
    }
    machine blank(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping, negative: bool) {
        transition negative {
            true -> done()
            _ -> scan(packet, bytes, cursor + 1, 0, false, false)
        }
    }
    machine store(packet: &mut Packet, bytes: &[u8; 256], cursor: i32 in Wrapping,
                value: i32 in Wrapping, negative: bool) {
        let ok: bool = append(packet, value, negative);
        transition ok {
            true -> scan(packet, bytes, cursor + 1, 0, false, false)
            _ -> done()
        }
    }
    machine finish(packet: &mut Packet, value: i32 in Wrapping, negative: bool, started: bool) {
        transition started {
            true -> final_value(packet, value, negative)
            _ -> empty_tail(packet, negative)
        }
    }
    machine final_value(packet: &mut Packet, value: i32 in Wrapping, negative: bool) {
        packet.valid = append(packet, value, negative);
    }
    machine empty_tail(packet: &mut Packet, negative: bool) { packet.valid = !negative; }
    machine done() { }
}
machine append(packet: &mut Packet, value: i32 in Wrapping, negative: bool) -> bool {
    transition packet.count >= 0 && packet.count < 26 {
        true -> write(packet, value, negative)
        _ -> false
    }
    machine write(packet: &mut Packet, value: i32 in Wrapping, negative: bool) -> bool {
        transition negative {
            true -> minus(packet, value)
            _ -> plus(packet, value)
        }
    }
    machine minus(packet: &mut Packet, value: i32 in Wrapping) -> bool {
        packet.values[packet.count] = (0 - value) as i32;
        packet.count = packet.count + 1;
        true
    }
    machine plus(packet: &mut Packet, value: i32 in Wrapping) -> bool {
        packet.values[packet.count] = value as i32;
        packet.count = packet.count + 1;
        true
    }
}
