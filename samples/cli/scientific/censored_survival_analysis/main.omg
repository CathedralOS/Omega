use domain/input/input.omg;
use domain/model/model.omg;
use domain/report/report.omg;
use domain/solver/solver.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Synthetic survival analysis; empty stdin is refused.
// Expected exit: 2.
// Expected output contains: ERROR invalid input

data Main { reader: |input|::Reader; records: |model|::Records; table: |model|::Table; logrank: |model|::Logrank; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let count: |input|::Number = block |input|::number(@mutable main.reader);
    let integer: i32 in Saturating = |float_operations|::I32::from_f64(count.value);
    transition count.valid && count.value >= 1.0 && count.value <= 32.0 && |float_operations|::F64::from_i32(integer as i32) == count.value {
        true -> block configure(main, integer as -Saturating +Wrapping),
        false -> invalid(main)
    }
    machine configure(main: @mutable Main, count: i32 in Wrapping) {
        main.records.count = count;
        transition { _ -> block read(main, 0) }
    }
    machine read(main: @mutable Main, index: i32 in Wrapping) {
        transition index >= 0 && index < 32 && index < main.records.count {
            true -> block record(main, index),
            false -> block end(main)
        }
    }
    machine record(main: @mutable Main, index: i32 in Wrapping)
    requires index >= 0 && index < 32
    {
        let time: |input|::Number = block |input|::number(@mutable main.reader);
        let event: |input|::Number = block |input|::number(@mutable main.reader);
        let group: |input|::Number = block |input|::number(@mutable main.reader);
        transition time.valid && event.valid && group.valid && time.value >= 0.0 && (event.value == 0.0 || event.value == 1.0) && (group.value == 0.0 || group.value == 1.0) {
            true -> block store(main, index, time.value, event.value, group.value),
            false -> invalid(main)
        }
    }
    machine store(main: @mutable Main, index: i32 in Wrapping, time: f64, event: f64, group: f64)
    requires index >= 0 && index < 32
    {
        main.records.time[index] = time;
        let event_integer: i32 in Saturating = |float_operations|::I32::from_f64(event);
        let group_integer: i32 in Saturating = |float_operations|::I32::from_f64(group);
        main.records.event[index] = event_integer as i32;
        main.records.group[index] = group_integer as i32;
        transition { _ -> block read(main, index + 1) }
    }
    machine end(main: @mutable Main) {
        let complete: bool = block |input|::ended(@mutable main.reader);
        transition complete { true -> calculate(main, -1), false -> invalid(main) }
    }
    machine calculate(main: @mutable Main, group: i32 in Wrapping) {
        |solver|::analyze(@main.records, group, @mutable main.table, @mutable main.logrank);
        |report|::report(@mutable main.reader, group, @main.table);
        transition group < 1 { true -> calculate(main, group + 1), false -> done(main) }
    }
    machine done(main: @mutable Main) {
        |report|::logrank_report(@mutable main.reader, @main.logrank);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) { |console|::Console::write_line("ERROR invalid input"); |process_exit|::ProcessExit::exit_process(2); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
