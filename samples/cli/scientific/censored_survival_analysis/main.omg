use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Synthetic survival analysis; empty stdin is refused.
// Expected exit: 2.
// Expected output contains: ERROR invalid input
use domain\input;
use domain\input\Reader;
use domain\input\Number;
use domain\input\number;
use domain\input\ended;
use domain\model;
use domain\model\Records;
use domain\model\Table;
use domain\model\Logrank;
use domain\solver;
use domain\solver\analyze;
use domain\report;
use domain\report\integer;
use domain\report\report;
use domain\report\logrank_report;
use system\Console;
use omega\language\core\F64::from_i32;
use omega\language\core\I32::from_f64;

data Main { reader: Reader; records: Records; table: Table; logrank: Logrank; }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput crashes Trap {
    let count: Number = block number(@mutable main.reader);
    let integer: i32 in Saturating = I32::from_f64(count.value);
    transition count.valid && count.value >= 1.0 && count.value <= 32.0 && F64::from_i32(integer as i32) == count.value {
        true -> block configure(main, integer as -Saturating +Wrapping),
        false -> invalid(main)
    }
    machine configure(main: @mutable Main, count: i32 in Wrapping) {
        main.records.count = count;
        transition { _ -> block read(main, 0) }
    }
    machine read(main: @mutable Main, index: i32 in Wrapping) {
        transition index >= 0 && index < 32 && index < main.records.count {
            true -> block record(main, index),
            false -> block end(main)
        }
    }
    machine record(main: @mutable Main, index: i32 in Wrapping)
    requires index >= 0 && index < 32
    {
        let time: Number = block number(@mutable main.reader);
        let event: Number = block number(@mutable main.reader);
        let group: Number = block number(@mutable main.reader);
        transition time.valid && event.valid && group.valid && time.value >= 0.0 && (event.value == 0.0 || event.value == 1.0) && (group.value == 0.0 || group.value == 1.0) {
            true -> block store(main, index, time.value, event.value, group.value),
            false -> invalid(main)
        }
    }
    machine store(main: @mutable Main, index: i32 in Wrapping, time: f64, event: f64, group: f64)
    requires index >= 0 && index < 32
    {
        main.records.time[index] = time;
        let event_integer: i32 in Saturating = I32::from_f64(event);
        let group_integer: i32 in Saturating = I32::from_f64(group);
        main.records.event[index] = event_integer as i32;
        main.records.group[index] = group_integer as i32;
        transition { _ -> block read(main, index + 1) }
    }
    machine end(main: @mutable Main) {
        let complete: bool = block ended(@mutable main.reader);
        transition complete { true -> calculate(main, -1), false -> invalid(main) }
    }
    machine calculate(main: @mutable Main, group: i32 in Wrapping) {
        analyze(@main.records, group, @mutable main.table, @mutable main.logrank);
        report(@mutable main.reader, group, @main.table);
        transition group < 1 { true -> calculate(main, group + 1), false -> done(main) }
    }
    machine done(main: @mutable Main) {
        logrank_report(@mutable main.reader, @main.logrank);
        ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) { Console::write_line("ERROR invalid input"); ProcessExit::exit_process(2); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput crashes Trap {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
