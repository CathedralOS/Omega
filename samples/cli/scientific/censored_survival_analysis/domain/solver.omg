use domain::model;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

// Rescan all records at each distinct time. The risk set includes every tied
// censor until all tied events are accounted for. No sort order affects counts.
public machine analyze(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank) {
    table.numerator = [1,0,0,0]; table.denominator = [1,0,0,0];
    table.count = 0; table.median_status = 0; table.median = 0.0;
    transition { _ -> next(records, group, table, logrank, -1.0, 1.0, 0.0) }
    machine next(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, previous: f64, survival: f64, greenwood: f64) {
        transition { _ -> search(records, group, table, logrank, previous, survival, greenwood, 0, 1000001.0) }
    }
    machine search(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, previous: f64, survival: f64, greenwood: f64, index: i32 in Wrapping, candidate: f64) {
        transition index >= 0 && index < 32 && index < records.count {
            true -> inspect(records, group, table, logrank, previous, survival, greenwood, index, candidate)
            false -> found(records, group, table, logrank, survival, greenwood, candidate)
        }
    }
    machine inspect(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, previous: f64, survival: f64, greenwood: f64, index: i32 in Wrapping, candidate: f64)
    requires index >= 0 && index < 32
    {
        transition (group == -1 || records.group[index] == group as i32) && records.time[index] > previous && records.time[index] < candidate {
            true -> search(records, group, table, logrank, previous, survival, greenwood, index + 1, records.time[index])
            false -> search(records, group, table, logrank, previous, survival, greenwood, index + 1, candidate)
        }
    }
    machine found(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, survival: f64, greenwood: f64, time: f64) {
        transition time <= 1000000.0 {
            true -> tally(records, group, table, logrank, survival, greenwood, time, 0, 0, 0, 0, 0, 0)
            false -> finish(logrank)
        }
    }
    machine tally(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, survival: f64, greenwood: f64, time: f64, index: i32 in Wrapping, risk: i32 in Wrapping, event: i32 in Wrapping, censor: i32 in Wrapping, risk0: i32 in Wrapping, event0: i32 in Wrapping) {
        transition index >= 0 && index < 32 && index < records.count {
            true -> count(records, group, table, logrank, survival, greenwood, time, index, risk, event, censor, risk0, event0)
            false -> update(records, group, table, logrank, survival, greenwood, time, risk, event, censor, risk0, event0)
        }
    }
    machine count(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, survival: f64, greenwood: f64, time: f64, index: i32 in Wrapping, risk: i32 in Wrapping, event: i32 in Wrapping, censor: i32 in Wrapping, risk0: i32 in Wrapping, event0: i32 in Wrapping)
    requires index >= 0 && index < 32
    {
        let selected: bool = group == -1 || records.group[index] == group as i32;
        let at_risk: bool = selected && records.time[index] >= time;
        let failure: bool = selected && records.time[index] == time && records.event[index] == 1;
        let censored: bool = selected && records.time[index] == time && records.event[index] == 0;
        let next_risk: i32 in Wrapping = risk + indicator(at_risk);
        let next_event: i32 in Wrapping = event + indicator(failure);
        let next_censor: i32 in Wrapping = censor + indicator(censored);
        let next_risk0: i32 in Wrapping = risk0 + indicator(at_risk && records.group[index] == 0);
        let next_event0: i32 in Wrapping = event0 + indicator(failure && records.group[index] == 0);
        transition { _ -> tally(records, group, table, logrank, survival, greenwood, time, index + 1, next_risk, next_event, next_censor, next_risk0, next_event0) }
    }
    machine update(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, survival: f64, greenwood: f64, time: f64, risk: i32 in Wrapping, event: i32 in Wrapping, censor: i32 in Wrapping, risk0: i32 in Wrapping, event0: i32 in Wrapping) {
        // A found time belongs to a selected record, hence risk is positive.
        // Every distinct-time factor is <=32 and strictly decreases thereafter.
        product(&mut table.numerator, narrow_i32_to_u64_wrapping((risk - event) as i32) as u64 in Wrapping);
        product(&mut table.denominator, narrow_i32_to_u64_wrapping(risk as i32) as u64 in Wrapping);
        let n: f64 = F64::from_i32(risk as i32);
        let d: f64 = F64::from_i32(event as i32);
        let next_survival: f64 = survival * (n - d) / n;
        let next_greenwood: f64 = greenwood_step(greenwood, n, d);
        accumulate(logrank, group, risk, risk0, event, event0);
        let position: i32 in Wrapping = table.count;
        transition position >= 0 && position < 32 {
            true -> store(records, group, table, logrank, time, risk, event, censor, next_survival, next_greenwood, position)
            false -> finish(logrank)
        }
    }
    machine store(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, time: f64, risk: i32 in Wrapping, event: i32 in Wrapping, censor: i32 in Wrapping, survival: f64, greenwood: f64, index: i32 in Wrapping)
    requires index >= 0 && index < 32
    {
        table.time[index] = time; table.risk[index] = risk as i32; table.event[index] = event as i32; table.censor[index] = censor as i32;
        table.survival[index] = survival; table.variance[index] = survival * survival * greenwood;
        table.zero[index] = indicator(survival == 0.0) as i32;
        table.count = index + 1;
        let reached: bool = half(table);
        transition table.median_status == 0 && reached {
            true -> median(records, group, table, logrank, time, survival, greenwood)
            false -> next(records, group, table, logrank, time, survival, greenwood)
        }
    }
    machine median(records: &Records, group: i32 in Wrapping, table: &mut Table, logrank: &mut Logrank, time: f64, survival: f64, greenwood: f64) {
        table.median = time; table.median_status = 1;
        transition { _ -> next(records, group, table, logrank, time, survival, greenwood) }
    }
    machine finish(logrank: &mut Logrank) {
        logrank.status = 0; logrank.statistic = 0.0;
        transition logrank.variance > 0.0 { true -> statistic(logrank) false -> {} }
    }
    machine statistic(logrank: &mut Logrank) {
        let difference: f64 = logrank.observed - logrank.expected;
        logrank.statistic = difference * difference / logrank.variance;
        logrank.status = 1;
    }
}
machine indicator(condition: bool) -> i32 in Wrapping { transition condition { true -> 1 false -> 0 } }
machine greenwood_step(greenwood: f64, risk: f64, event: f64) -> f64 {
    transition event < risk { true -> (greenwood + event / (risk * (risk - event))) false -> greenwood }
}
machine accumulate(logrank: &mut Logrank, group: i32 in Wrapping, risk: i32 in Wrapping, risk0: i32 in Wrapping, event: i32 in Wrapping, event0: i32 in Wrapping) {
    transition group == -1 { true -> moments(logrank, risk, risk0, event, event0) false -> {} }
    machine moments(logrank: &mut Logrank, risk: i32 in Wrapping, risk0: i32 in Wrapping, event: i32 in Wrapping, event0: i32 in Wrapping) {
        let n: f64 = F64::from_i32(risk as i32);
        let n0: f64 = F64::from_i32(risk0 as i32);
        let d: f64 = F64::from_i32(event as i32);
        logrank.observed = logrank.observed + F64::from_i32(event0 as i32);
        logrank.expected = logrank.expected + d * n0 / n;
        transition risk > 1 { true -> variance(logrank, n, n0, d) false -> {} }
    }
    machine variance(logrank: &mut Logrank, risk: f64, risk0: f64, event: f64) {
        logrank.variance = logrank.variance + risk0 * (risk - risk0) * event * (risk - event) / (risk * risk * (risk - 1.0));
    }
}

// At most32 distinct times. Unreduced numerator/denominator products are bounded
// by32! < 10^36; twice the numerator also fits four base10^9 limbs. Exact
// comparison avoids a rounded half-survival changing the median status.
machine product(limbs: &mut [u64 in Wrapping; 4], factor: u64 in Wrapping) {
    transition { _ -> position(limbs, factor, 0, 0) }
    machine position(limbs: &mut [u64 in Wrapping; 4], factor: u64 in Wrapping, index: i32 in Wrapping, carry: u64 in Wrapping) {
        transition index >= 0 && index < 4 { true -> multiply(limbs, factor, index, carry) false -> {} }
    }
    machine multiply(limbs: &mut [u64 in Wrapping; 4], factor: u64 in Wrapping, index: i32 in Wrapping, carry: u64 in Wrapping)
    requires index >= 0 && index < 4
    {
        let value: u64 in Wrapping = limbs[index] * factor + carry;
        limbs[index] = value % 1000000000;
        transition { _ -> position(limbs, factor, index + 1, value / 1000000000) }
    }
}
machine half(table: &Table) -> bool {
    let mut twice: [u64 in Wrapping; 4] = table.numerator;
    product(&mut twice, 2);
    transition twice[3] != table.denominator[3] { true -> (twice[3] < table.denominator[3]) false -> limb2(table, &twice) }
    machine limb2(table: &Table, twice: &[u64 in Wrapping; 4]) -> bool {
        transition twice[2] != table.denominator[2] { true -> (twice[2] < table.denominator[2]) false -> limb1(table, twice) }
    }
    machine limb1(table: &Table, twice: &[u64 in Wrapping; 4]) -> bool {
        transition twice[1] != table.denominator[1] { true -> (twice[1] < table.denominator[1]) false -> (twice[0] <= table.denominator[0]) }
    }
}
