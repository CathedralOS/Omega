// Intended-invalid: neither negative, past-end nor unproved dynamic indexing
// has the table bounds required by the source checker.
use domain/table/table.omg;
machine negative(table: @|table|::Table) -> f64 { transition { _ -> (table.survival[-1]) } }
machine past_end(table: @|table|::Table) -> f64 { transition { _ -> (table.survival[32]) } }
machine unproved(table: @|table|::Table, index: i32 in Wrapping) -> f64 { transition { _ -> (table.survival[index]) } }
