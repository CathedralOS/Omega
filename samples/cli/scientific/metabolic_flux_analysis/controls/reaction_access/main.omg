// Expected rejection: reaction index 6 exceeds six-reaction storage.
data Control { reactions: [i64; 6]; observed: i64; }
machine main(control: @mutable Control) { control.observed = control.reactions[6]; }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Control;
    main(@mutable entry_storage);
}
