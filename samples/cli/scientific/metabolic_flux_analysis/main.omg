use domain/input/input.omg;
use domain/report/report.omg;
use domain/solver/solver.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0 for input.txt; exact rational / HiGHS oracle in validation/.

data Application { reader: |input|::Reader; solver: |solver|::Solver; }
machine main(application: @mutable Application) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let metabolites: |input|::Number = block |input|::number(@mutable application.reader);
    let reactions: |input|::Number = block |input|::number(@mutable application.reader);
    let biomass: |input|::Number = block |input|::number(@mutable application.reader);
    transition metabolites.valid && reactions.valid && biomass.valid &&
        metabolites.value >= 2000000000 && metabolites.value <= 4000000000 && metabolites.value % 1000000000 == 0 &&
        reactions.value >= 3000000000 && reactions.value <= 6000000000 && reactions.value % 1000000000 == 0 &&
        biomass.value >= 0 && biomass.value < reactions.value && biomass.value % 1000000000 == 0 {
        true -> block configure(application, metabolites.value, reactions.value, biomass.value),
        _ -> invalid(application)
    }
    machine invalid(application: @mutable Application) {
        |console|::Console::write_line("ERROR input"); |process_exit|::ProcessExit::exit_process(10);
    }
    machine configure(application: @mutable Application, metabolites: i64 in Wrapping, reactions: i64 in Wrapping, biomass: i64 in Wrapping) {
        application.solver.metabolites = |numeric_conversion|::narrow_i64_to_i32_wrapping((metabolites / 1000000000) as i64) as i32 +Wrapping;
        application.solver.reactions = |numeric_conversion|::narrow_i64_to_i32_wrapping((reactions / 1000000000) as i64) as i32 +Wrapping;
        application.solver.biomass = |numeric_conversion|::narrow_i64_to_i32_wrapping((biomass / 1000000000) as i64) as i32 +Wrapping;
        transition { _ -> block matrix_row(application, 0, 0) }
    }
    machine matrix_row(application: @mutable Application, row: i32 in Wrapping, column: i32 in Wrapping) {
        transition row < application.solver.metabolites { true -> block matrix_column(application, row, column), _ -> block bound(application, 0) }
    }
    machine matrix_column(application: @mutable Application, row: i32 in Wrapping, column: i32 in Wrapping) {
        transition column < application.solver.reactions { true -> block coefficient(application, row, column), _ -> block matrix_row(application, row + 1, 0) }
    }
    machine coefficient(application: @mutable Application, row: i32 in Wrapping, column: i32 in Wrapping) {
        let value: |input|::Number = block |input|::number(@mutable application.reader);
        transition value.valid && value.value >= -3000000000 && value.value <= 3000000000 && value.value % 1000000000 == 0 {
            true -> block coefficient_store(application, row, column, value.value), _ -> invalid(application)
        }
    }
    machine coefficient_store(application: @mutable Application, row: i32 in Wrapping, column: i32 in Wrapping, value: i64 in Wrapping) {
        |solver|::write_matrix(@mutable application.solver.matrix, row * 6 + column, value / 1000000000);
        transition { _ -> block matrix_row(application, row, column + 1) }
    }
    machine bound(application: @mutable Application, index: i32 in Wrapping) {
        transition index < application.solver.reactions { true -> block bounds(application, index), _ -> block finish(application) }
    }
    machine bounds(application: @mutable Application, index: i32 in Wrapping) {
        let lower: |input|::Number = block |input|::number(@mutable application.reader);
        let upper: |input|::Number = block |input|::number(@mutable application.reader);
        transition lower.valid && upper.valid && lower.value >= 0 && lower.value <= upper.value && upper.value <= 10000000000 {
            true -> block bound_store(application, index, lower.value, upper.value), _ -> invalid(application)
        }
    }
    machine bound_store(application: @mutable Application, index: i32 in Wrapping, lower: i64 in Wrapping, upper: i64 in Wrapping) {
        |solver|::write_six(@mutable application.solver.lower, index, lower);
        |solver|::write_six(@mutable application.solver.upper, index, upper);
        transition { _ -> block bound(application, index + 1) }
    }
    machine finish(application: @mutable Application) {
        let complete: bool = block |input|::ended(@mutable application.reader);
        transition complete { true -> optimize(application), _ -> invalid(application) }
    }
    machine optimize(application: @mutable Application) {
        |solver|::solve(@mutable application.solver);
        transition application.solver.found { true -> optimal(application), _ -> infeasible(application) }
    }
    machine infeasible(application: @mutable Application) {
        |console|::Console::write_line("INFEASIBLE"); |process_exit|::ProcessExit::exit_process(11);
    }
    machine optimal(application: @mutable Application) {
        |console|::Console::write_line("OPTIMAL");
        let numerator: i64 in Wrapping = |solver|::read_six(@application.solver.best, application.solver.biomass);
        |report|::rational(@mutable application.reader, "objective_pico=", numerator, application.solver.best_denominator);
        transition { _ -> flux(application, 0) }
    }
    machine flux(application: @mutable Application, index: i32 in Wrapping) {
        transition index < application.solver.reactions { true -> reaction_report(application, index), _ -> residual(application, 0, 0, 0) }
    }
    machine reaction_report(application: @mutable Application, index: i32 in Wrapping) {
        let numerator: i64 in Wrapping = |solver|::read_six(@application.solver.best, index);
        let minimum: i64 in Wrapping = |solver|::read_six(@application.solver.minima, index);
        let minimum_denominator: i64 in Wrapping = |solver|::read_six(@application.solver.minimum_denominators, index);
        let maximum: i64 in Wrapping = |solver|::read_six(@application.solver.maxima, index);
        let maximum_denominator: i64 in Wrapping = |solver|::read_six(@application.solver.maximum_denominators, index);
        |report|::rational(@mutable application.reader, "flux_pico=", numerator, application.solver.best_denominator);
        |report|::rational(@mutable application.reader, "minimum_pico=", minimum, minimum_denominator);
        |report|::rational(@mutable application.reader, "maximum_pico=", maximum, maximum_denominator);
        transition { _ -> flux(application, index + 1) }
    }
    machine residual(application: @mutable Application, row: i32 in Wrapping, column: i32 in Wrapping, sum: i64 in Wrapping) {
        transition row < application.solver.metabolites { true -> residual_column(application, row, column, sum), _ -> done(application) }
    }
    machine residual_column(application: @mutable Application, row: i32 in Wrapping, column: i32 in Wrapping, sum: i64 in Wrapping) {
        transition column < application.solver.reactions { true -> residual_added(application, row, column, sum), _ -> residual_emit(application, row, sum) }
    }
    machine residual_added(application: @mutable Application, row: i32 in Wrapping, column: i32 in Wrapping, sum: i64 in Wrapping) {
        let coefficient: i64 in Wrapping = |solver|::read_matrix(@application.solver.matrix, row * 6 + column);
        let value: i64 in Wrapping = |solver|::read_six(@application.solver.best, column);
        transition { _ -> residual(application, row, column + 1, sum + coefficient * value) }
    }
    machine residual_emit(application: @mutable Application, row: i32 in Wrapping, sum: i64 in Wrapping) {
        |report|::rational(@mutable application.reader, "residual_pico=", sum, application.solver.best_denominator);
        transition { _ -> residual(application, row + 1, 0, 0) }
    }
    machine done(application: @mutable Application) { |process_exit|::ProcessExit::exit_process(0); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let mutable entry_storage: Application;
    block main(@mutable entry_storage);
}
