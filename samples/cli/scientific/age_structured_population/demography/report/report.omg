use demography/model/model.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
// Decimal output uses no allocation and includes a sign for net emigration.
public machine number(value: i64 in Wrapping) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    transition value < 0 { true -> negative(value), false -> begin(value) }
    machine negative(value: i64 in Wrapping) { |console|::Console::write_byte(45); transition { _ -> begin(0 - value) } }
    machine begin(value: i64 in Wrapping) { transition { _ -> digit(value, 10000000000, false) } }
    machine digit(value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool) {
        transition divisor > 0 { true -> choose(value, divisor, started), false -> done() }
    }
    machine choose(value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool)
    requires divisor > 0
    {
        let quotient: i64 in Wrapping = value / divisor;
        transition quotient > 0 || started || divisor == 1 {
            true -> emit(value, divisor, quotient),
            false -> digit(value, divisor / 10, false)
        }
    }
    machine emit(value: i64 in Wrapping, divisor: i64 in Wrapping, quotient: i64 in Wrapping)
    requires divisor > 0
    {
        |console|::Console::write_byte(|numeric_conversion|::narrow_i64_to_i32_wrapping((quotient + 48) as i64));
        transition { _ -> digit(value % divisor, divisor / 10, true) }
    }
    machine done() {}
}
public machine row(year: i64 in Wrapping, census: @|model|::Census, balance: @|model|::Balance) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    number(year); |console|::Console::write(","); number(census.newborn); |console|::Console::write(",");
    number(census.juvenile); |console|::Console::write(","); number(census.adult); |console|::Console::write(",");
    number(|model|::total(census)); |console|::Console::write(","); number(balance.births); |console|::Console::write(",");
    number(balance.deaths); |console|::Console::write(","); number(balance.migration); |console|::Console::write_line("");
}
