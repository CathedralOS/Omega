use {omega}/language/core/float_operations.omg;

// A four-sample detector scratch splits into a leading baseline window and a
// trailing peak window. Both arms have length 2. The record carries that
// window back to the caller.
data Held<'samples> { values: @'samples mutable [f64]; }

public machine window<'samples>(samples: @'samples mutable [f64; 4], which: i64) -> @'samples mutable [f64]
ensures result.length == 2
{
    match which {
        0 -> @mutable samples[0..2],
        _ -> @mutable samples[2..4]
    }
}

machine hold<'samples>(samples: @'samples mutable [f64]) -> Held<'samples>
requires samples.length == 2
ensures result.values.length == 2
{
    Held { values: samples }
}

machine write_baseline(window: @mutable [f64])
requires window.length >= 2 {
    window[0] = 0.0;
    window[1] = 0.0;
}

machine scale_peak(window: @mutable [f64])
requires window.length >= 2 {
    window[0] = window[0] + 1.0;
    window[1] = window[1] + 1.0;
}

// The caller binds the returned record, writes through its field, and passes
// that field onward. The peak record is the call result of the same hold.
public machine baseline_ready() -> bool {
    let mutable trace: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    write_baseline(hold(window(@mutable trace, 0)).values);
    let leading: Held = hold(window(@mutable trace, 0));
    let span: u64 = leading.values.length;
    transition span == 2 {
        true -> peak(@mutable trace),
        _ -> false
    }
    machine peak(trace: @mutable [f64; 4]) -> bool {
        let selected: @mutable [f64] = window(trace, 1);
        let trailing: Held = hold(selected);
        scale_peak(trailing.values);
        let baseline: i32 in Saturating = |float_operations|::I32::from_f64(trace[0]);
        let neighbor: i32 in Saturating = |float_operations|::I32::from_f64(trace[1]);
        let peak_value: i32 in Saturating = |float_operations|::I32::from_f64(trace[2]);
        let tail: i32 in Saturating = |float_operations|::I32::from_f64(trace[3]);
        transition baseline == 0 && neighbor == 0 && peak_value == 4 && tail == 5 {
            true -> true,
            _ -> false
        }
    }
}
