use domain/model/model.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data InputReader {
    remaining: i32 in Wrapping;
    exhausted: bool;
}
data Token {
    case Invalid;
    case End;
    case Number(value: i32);
}
// A 512-byte budget includes trailing whitespace. Budget exhaustion is an
// input error, distinct from the real EOF required after exactly 15 tokens.
machine next_byte(reader: @mutable InputReader) -> |console|::ByteRead reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    let byte: |console|::ByteRead = block |console|::Console::read_byte();
    transition byte {
        |console|::ByteRead::Error -> |console|::ByteRead::Error,
        |console|::ByteRead::Eof -> |console|::ByteRead::Eof,
        |console|::ByteRead::Byte { value } -> capacity(reader, value)
    }
    machine capacity(reader: @mutable InputReader, value: i32) -> |console|::ByteRead
    requires value >= 0 && value <= 255
    {
        transition reader.remaining > 0 {
            true -> consume(reader, value),
            _ -> limit(reader)
        }
    }
    machine consume(reader: @mutable InputReader, value: i32) -> |console|::ByteRead
    requires value >= 0 && value <= 255
    {
        reader.remaining = reader.remaining - 1;
        |console|::ByteRead::Byte { value: value }
    }
    machine limit(reader: @mutable InputReader) -> |console|::ByteRead {
        reader.exhausted = true;
        |console|::ByteRead::Eof
    }
}
machine token(reader: @mutable InputReader) -> Token reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> block skip(reader) }
    machine skip(reader: @mutable InputReader) -> Token {
        let byte: |console|::ByteRead = block next_byte(reader);
        transition byte {
            |console|::ByteRead::Error -> Token::Invalid,
            |console|::ByteRead::Eof -> Token::End,
            |console|::ByteRead::Byte { value } -> block first(reader, value)
        }
    }
    machine first(reader: @mutable InputReader, byte: i32) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> block skip(reader),
            _ -> block sign(reader, byte)
        }
    }
    machine sign(reader: @mutable InputReader, byte: i32) -> Token {
        transition byte == 45 {
            true -> block next(reader, 0, 0, true),
            _ -> block digit(reader, byte, 0, 0, false)
        }
    }
    machine digit(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte >= 48 && byte <= 57 && digits < 4 {
            true -> block accumulate(reader, byte, magnitude, digits, negative),
            _ -> Token::Invalid
        }
    }
    machine accumulate(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                     digits: i32 in Wrapping, negative: bool) -> Token {
        let updated: i32 in Wrapping = magnitude * 10 + (byte as i32 +Wrapping) - 48;
        transition updated <= 1000 {
            true -> block next(reader, updated, digits + 1, negative),
            _ -> Token::Invalid
        }
    }
    machine next(reader: @mutable InputReader, magnitude: i32 in Wrapping,
               digits: i32 in Wrapping, negative: bool) -> Token {
        let byte: |console|::ByteRead = block next_byte(reader);
        transition byte {
            |console|::ByteRead::Error -> Token::Invalid,
            |console|::ByteRead::Eof -> finish(magnitude, digits, negative),
            |console|::ByteRead::Byte { value } -> block delimiter(reader, value, magnitude, digits, negative)
        }
    }
    machine delimiter(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                    digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> finish(magnitude, digits, negative),
            _ -> block digit(reader, byte, magnitude, digits, negative)
        }
    }
    machine finish(magnitude: i32 in Wrapping, digits: i32 in Wrapping, negative: bool) -> Token {
        transition digits > 0 {
            true -> signed_value(magnitude, negative),
            _ -> Token::Invalid
        }
    }
    machine signed_value(magnitude: i32 in Wrapping, negative: bool) -> Token {
        transition negative {
            true -> Token::Number { value: (0 - magnitude) as i32 },
            _ -> Token::Number { value: magnitude as i32 }
        }
    }
}
public machine read_input(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram) -> bool reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> block scan(reader, chromatogram, 0) }
    machine scan(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
               position: i32 in Wrapping) -> bool {
        let item: Token = block token(reader);
        transition item {
            Token::Number { value } -> block validate(reader, chromatogram, position, value),
            Token::End -> (position == 15 && !reader.exhausted),
            _ -> false
        }
    }
    machine validate(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
                   position: i32 in Wrapping, value: i32) -> bool {
        transition position >= 0 && position < 15 && (position >= 10 || value >= 0) {
            true -> block select(reader, chromatogram, position, |float_operations|::F64::from_i32(value)),
            _ -> false
        }
    }
    machine select(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
                 position: i32 in Wrapping, value: f64) -> bool {
        transition position >= 0 && position < 5 {
            true -> block a(reader, chromatogram, position, value),
            _ -> block select_b(reader, chromatogram, position, value, position - 5)
        }
    }
    machine a(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
            position: i32 in Wrapping, value: f64) -> bool {
        chromatogram.profile_a[position] = value;
        transition { _ -> block scan(reader, chromatogram, position + 1) }
    }
    machine select_b(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
                   position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 5 {
            true -> block b(reader, chromatogram, position, value, index),
            _ -> block select_y(reader, chromatogram, position, value, position - 10)
        }
    }
    machine b(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
            position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        chromatogram.profile_b[index] = value;
        transition { _ -> block scan(reader, chromatogram, position + 1) }
    }
    machine select_y(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
                   position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 5 {
            true -> block y(reader, chromatogram, position, value, index),
            _ -> false
        }
    }
    machine y(reader: @mutable InputReader, chromatogram: @mutable |model|::Chromatogram,
            position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        chromatogram.observed[index] = value;
        transition { _ -> block scan(reader, chromatogram, position + 1) }
    }
}
