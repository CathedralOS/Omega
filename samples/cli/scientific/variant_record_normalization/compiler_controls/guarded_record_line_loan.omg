// Complete target-neutral reproducer of record + byte-buffer case successors.
// Expected main result: 42; selected edge retains both storage homes.
public data Sequence { bases: [u64 in Wrapping; 12]; length: u64 in Wrapping; }
public data Variant { first: Sequence; second: Sequence; position: u64 in Wrapping; }
public data Ledger { variants: [Variant; 32]; count: u64 in Wrapping; }
data Application { first: Sequence; second: Sequence; ledger: Ledger; }
data ReadOutcome {
    case Invalid;
    case Complete(count: u64);
    case End(count: u64);
    case Full(count: u64);
}
machine receive(line: @mutable [u8; 64]) -> ReadOutcome {
    line[0] = 37;
    ReadOutcome::Complete { count: 5 }
}
machine main() -> u64 in Wrapping {
    let mutable application: Application;
    transition { _ -> read(@mutable application) }
    machine read(application: @mutable Application) -> u64 in Wrapping {
        let mutable line: [u8; 64];
        let result: ReadOutcome = receive(@mutable line);
        transition result {
            ReadOutcome::Complete { count } -> observe(application, @line, count),
            ReadOutcome::End { count } -> observe(application, @line, count),
            ReadOutcome::Full { count } -> (0),
            ReadOutcome::Invalid -> (0)
        }
    }
    machine observe(application: @mutable Application, line: @[u8; 64], count: u64) -> u64 in Wrapping {
        application.ledger.count = count as u64 +Wrapping;
        ((line[0] as u64 +Wrapping) + application.ledger.count)
    }
}
