use io/decimal/decimal.omg;
use io/input/input.omg;
use io/report/report.omg;
use model/transport/transport.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0 with input.txt. Empty stdin exits 64.
// Expected output contains: ADVECTED
// W2-03: bounded stdin-driven periodic conservative first-order upwind.
data Main {}

// The explicit entry context is ordinary ZII-valid data; checked Console calls demand its static provider slot.
machine main(context:@mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
 let mutable input:|input|::Input;
 let mutable field:|transport|::Field;
 let parsed:bool=block |input|::parse(@mutable input);
 transition parsed && input.count > 0 { true -> validate(@input,@mutable field), false -> bad_input() }
 machine validate(input:@|input|::Input,field:@mutable |transport|::Field) {
  transition |transport|::initialize(input,field) { true -> execute(field), false -> bad_data() }
 }
 machine execute(field:@mutable |transport|::Field) {
  |transport|::evolve(field);
  transition |transport|::finite(field.mass) && |transport|::finite(field.minimum) && |transport|::finite(field.maximum) { true -> output(field), false -> bad_data() }
 }
 machine output(field:@|transport|::Field) {
  |console|::Console::write("MASS "); |report|::scaled(field.mass,field.mass_exponent as i64 +Wrapping); |console|::Console::write_line("");
  |console|::Console::write("MIN "); value(field,field.minimum_index); |console|::Console::write_line("");
  |console|::Console::write("MAX "); value(field,field.maximum_index); |console|::Console::write_line("");
  |console|::Console::write("CFL "); |report|::number(field.cfl); |console|::Console::write_line("");
  transition { _ -> cells(field,0) }
 }
 machine cells(field:@|transport|::Field,index:u32 in Saturating) {
  transition index < field.count { true -> cell(field,index), false -> done() }
 }
 machine cell(field:@|transport|::Field,index:u32 in Saturating) {
  |console|::Console::write("CELL "); value(field,index); |console|::Console::write_line("");
  transition { _ -> cells(field,index+1) }
 }
 machine done() { |console|::Console::write_line("ADVECTED"); |process_exit|::ProcessExit::exit_process(0); }
 machine bad_input() { |console|::Console::write_line("REJECT bounded decimal input"); |process_exit|::ProcessExit::exit_process(64); }
 machine bad_data() { |console|::Console::write_line("REJECT dimensions, finite data, positive spacing/timestep, nonnegative field or stable CFL"); |process_exit|::ProcessExit::exit_process(65); }
}

machine value(field:@|transport|::Field,index:u32 in Saturating) reaches |process_authority|::StandardOutput {
 transition field.exact { true -> exact(field,index), false -> computed(field,index) }
 machine exact(field:@|transport|::Field,index:u32 in Saturating) {
  |decimal|::number(|numeric_conversion|::narrow_u64_to_i64_saturating(field.coefficients[index%64] as u64) as i64 +Wrapping);
  |decimal|::number(field.original_powers[index%64] as i64 +Wrapping);
 }
 machine computed(field:@|transport|::Field,index:u32 in Saturating) {
  |report|::field(field.current[index%64],field.powers[index%64],field.lower_coefficient,field.lower_power,field.upper_coefficient,field.upper_power,field.lower_value,field.lower_value_power,field.upper_value,field.upper_value_power);
 }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
