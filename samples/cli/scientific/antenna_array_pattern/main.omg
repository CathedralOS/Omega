use data/expected/expected.omg;
use data/fixtures/fixtures.omg;
use domain/array/array.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/math.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

// Expected exit: 0.
// Selector and phase-reduction ladders use explicit exhaustive dispatches.
// Expected output contains: antenna_array_pattern complete

data Main {
    geometry: |array|::Geometry;
    selection: i32;
    all: bool;
    sample: i32;
    powers: [f64; 9];
    amplitude: f64;
    power: f64;
    normalized: f64;
    symmetry: f64;
}
machine number(main: @mutable Main, value: f64) reaches |process_authority|::StandardOutput {
    let converted: i32 in Saturating = |float_operations|::I32::from_f64(value);
    let integer: i32 = converted as i32;
    transition { _ -> digits(main, integer, 1000000000) }
    machine digits(main: @mutable Main, integer: i32, divisor: i32) {
        |console|::Console::write_byte(48 + (integer / divisor) % 10);
        transition divisor >= 10 { true -> digits(main, integer, divisor / 10), false -> done() }
    }
    machine done() { }
}
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("antenna_array_pattern scalar far-field u=-1:0.25:1; powers in millionths");
    let first: |console|::ByteRead = block |console|::Console::read_byte();
    transition first {
        |console|::ByteRead::Error -> invalid_input(main),
        |console|::ByteRead::Eof -> suite(main),
        |console|::ByteRead::Byte { value } -> select(main, value)
    }
    machine select(main: @mutable Main, value: i32) {
        transition value {
            10 -> blank_suite(main),
            97 -> selected_suite(main),
            _ -> select_digit(main, value)
        }
    }
    machine select_digit(main: @mutable Main, value: i32) {
        transition value >= 48 && value <= 54 { true -> selected(main, value - 48), false -> invalid_input(main) }
    }
    machine selected(main: @mutable Main, selection: i32) {
        main.selection = selection;
        main.all = false;
        transition { _ -> tail(main) }
    }
    machine selected_suite(main: @mutable Main) {
        main.selection = 0; main.all = true;
        transition { _ -> tail(main) }
    }
    machine tail(main: @mutable Main) {
        let tail: |console|::ByteRead = block |console|::Console::read_byte();
        transition tail {
            |console|::ByteRead::Error -> invalid_input(main),
            |console|::ByteRead::Eof -> load(main),
            |console|::ByteRead::Byte { value } -> tail_check(main, value)
        }
    }
    machine tail_check(main: @mutable Main, value: i32) {
        transition value == 10 { true -> after_line(main), false -> invalid_input(main) }
    }
    machine blank_suite(main: @mutable Main) {
        main.selection = 0; main.all = true;
        transition { _ -> after_line(main) }
    }
    machine after_line(main: @mutable Main) {
        let remaining: |console|::ByteRead = block |console|::Console::read_byte();
        transition remaining {
            |console|::ByteRead::Error -> invalid_input(main),
            |console|::ByteRead::Eof -> load(main),
            |console|::ByteRead::Byte { value } -> invalid_input(main)
        }
    }
    machine suite(main: @mutable Main) {
        main.selection = 0; main.all = true;
        transition { _ -> load(main) }
    }
    machine load(main: @mutable Main) {
        |fixtures|::fixtures_load(@mutable main.geometry, main.selection);
        let valid: bool = |array|::valid(@main.geometry);
        transition valid { true -> prepare(main), false -> invalid_geometry(main) }
    }
    machine prepare(main: @mutable Main) {
        main.amplitude = |array|::amplitude(@main.geometry);
        main.sample = 0;
        main.symmetry = 0.0;
        |console|::Console::write("case ");
        |console|::Console::write_byte(48 + main.selection % 10);
        |console|::Console::write(" duplicates ");
        let duplicates: i32 = |array|::duplicates(@main.geometry);
        |console|::Console::write_byte(48 + duplicates % 10);
        |console|::Console::write_line("");
        transition { _ -> sample_guard(main) }
    }
    machine sample_guard(main: @mutable Main) {
        transition main.sample >= 0 && main.sample < 9 { true -> calculate(main), false -> symmetry_guard(main, 0) }
    }
    machine calculate(main: @mutable Main) {
        let ordinal: f64 = |float_operations|::F64::from_i32(main.sample);
        let direction: f64 = -1.0 + ordinal * 0.25;
        main.power = |array|::pattern_power(@main.geometry, direction);
        main.powers[main.sample] = main.power;
        main.normalized = 0.0;
        transition main.amplitude > 0.0 { true -> normalize(main), false -> verify(main) }
    }
    machine normalize(main: @mutable Main) {
        main.normalized = main.power / (main.amplitude * main.amplitude);
        transition { _ -> verify(main) }
    }
    machine verify(main: @mutable Main) {
        let expected_power: f64 = |expected|::expected_power(main.selection, main.sample);
        let expected_normalized: f64 = |expected|::normalized(main.selection, main.sample);
        let power_error: f64 = |math|::abs_f64(main.power - expected_power);
        let normalized_error: f64 = |math|::abs_f64(main.normalized - expected_normalized);
        transition power_error <= 0.00000002 && normalized_error <= 0.000000002 {
            true -> report(main),
            false -> numerical_failure(main)
        }
    }
    machine numerical_failure(main: @mutable Main) {
        |console|::Console::write_line("ERROR numeric: frozen raw or normalized tolerance exceeded");
        |process_exit|::ProcessExit::exit_process(66);
    }
    machine report(main: @mutable Main) {
        |console|::Console::write("sample "); |console|::Console::write_byte(48 + main.sample % 10);
        |console|::Console::write(" power ");
        let mutable displayed_power: f64 = main.power * 1000000.0;
        number(main, displayed_power);
        |console|::Console::write(" normalized ");
        let mutable displayed_normalized: f64 = main.normalized * 1000000.0;
        number(main, displayed_normalized);
        transition main.power < 0.0000000001 { true -> null(main), false -> nonnull(main) }
    }
    machine null(main: @mutable Main) { |console|::Console::write_line(" null 1"); transition { _ -> next_sample(main) } }
    machine nonnull(main: @mutable Main) { |console|::Console::write_line(" null 0"); transition { _ -> next_sample(main) } }
    machine next_sample(main: @mutable Main) {
        main.sample = main.sample % 9 + 1;
        transition { _ -> sample_guard(main) }
    }
    machine symmetry_guard(main: @mutable Main, index: i32) {
        transition index >= 0 && index < 4 { true -> symmetry_pair(main, index), false -> diagnostic(main) }
    }
    machine symmetry_pair(main: @mutable Main, index: i32) {
        let difference: f64 = |math|::abs_f64(main.powers[index] - main.powers[8 - index]);
        main.symmetry = |math|::max_f64(main.symmetry, difference);
        transition { _ -> symmetry_guard(main, index + 1) }
    }
    machine diagnostic(main: @mutable Main) {
        |console|::Console::write("symmetry ");
        let mutable displayed_symmetry: f64 = main.symmetry * 1000000.0;
        number(main, displayed_symmetry);
        |console|::Console::write_line("");
        transition main.all && main.selection < 4 { true -> next_case(main), false -> complete(main) }
    }
    machine next_case(main: @mutable Main) {
        main.selection = main.selection % 5 + 1;
        transition { _ -> load(main) }
    }
    machine complete(main: @mutable Main) {
        |console|::Console::write_line("antenna_array_pattern complete"); |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid_input(main: @mutable Main) {
        |console|::Console::write_line("ERROR input: expected one selector 0..6, a, newline or EOF"); |process_exit|::ProcessExit::exit_process(64);
    }
    machine invalid_geometry(main: @mutable Main) {
        |console|::Console::write_line("ERROR geometry: position outside [-2,2] or weight outside [-2,2]"); |process_exit|::ProcessExit::exit_process(65);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
