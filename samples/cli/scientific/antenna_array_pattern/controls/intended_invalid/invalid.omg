use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Complete intended-invalid application: element 4 is outside a four-element extent.
use system\Console;
data Invalid { weights: [i32; 4]; }
machine main(program: @mutable Invalid) reaches ProcessExit + StandardOutput {
    program.weights[4] = 1;
    Console::write_line("UNREACHABLE: out-of-bounds write admitted");
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardOutput {
    let mutable entry_storage: Invalid;
    main(@mutable entry_storage);
}
