use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete intended-invalid application: element 4 is outside a four-element extent.
data Invalid { weights: [i32; 4]; }
machine main(program: @mutable Invalid) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    program.weights[4] = 1;
    |console|::Console::write_line("UNREACHABLE: out-of-bounds write admitted");
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let mutable entry_storage: Invalid;
    main(@mutable entry_storage);
}
