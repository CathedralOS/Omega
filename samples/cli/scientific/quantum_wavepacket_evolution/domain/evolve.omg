use omega::language::core::float_operations;
// Crank-Nicolson: (I+i dt H/2) psi_next = (I-i dt H/2) psi.
// The centred periodic H is real symmetric. Every principal I+i dt H/2
// has eigenvalues 1+i dt lambda/2, hence LU pivots never vanish.
// Factor once; forward/back substitution preserves the authored complex state.
use domain::complex;
use domain::model;
public machine factor(problem: &mut Problem) {
    transition { _ -> rows(problem, 0) }
    machine rows(problem: &mut Problem, row: i32) {
        transition row >= 0 && row < problem.cells && row < 32 { true -> columns(problem, row, 0) false -> pivots(problem, 0) }
    }
    machine columns(problem: &mut Problem, row: i32, column: i32) requires row >= 0 && row < 32 {
        transition column >= 0 && column < problem.cells && column < 32 { true -> initialize(problem, row, column) false -> rows(problem, row + 1) }
    }
    machine initialize(problem: &mut Problem, row: i32, column: i32) requires row >= 0 && row < 32 && column >= 0 && column < 32 {
        let value: f64 = 0.5 * problem.timestep * hamiltonian(problem, row, column);
        let diagonal: f64 = identity(row, column);
        store(problem, row, column, Complex { real: diagonal, imaginary: value });
        transition { _ -> columns(problem, row, column + 1) }
    }
    machine pivots(problem: &mut Problem, pivot: i32) {
        transition pivot >= 0 && pivot < problem.cells && pivot < 32 { true -> lower(problem, pivot, pivot + 1) false -> done() }
    }
    machine lower(problem: &mut Problem, pivot: i32, row: i32) requires pivot >= 0 && pivot < 32 {
        transition row >= 0 && row < problem.cells && row < 32 { true -> multiplier(problem, pivot, row) false -> pivots(problem, pivot + 1) }
    }
    machine multiplier(problem: &mut Problem, pivot: i32, row: i32) requires pivot >= 0 && pivot < 32 && row >= 0 && row < 32 {
        let value: Complex = divide(element(problem, row, pivot), element(problem, pivot, pivot));
        store(problem, row, pivot, value);
        transition { _ -> eliminate(problem, pivot, row, pivot + 1, value) }
    }
    machine eliminate(problem: &mut Problem, pivot: i32, row: i32, column: i32, value: Complex) requires pivot >= 0 && pivot < 32 && row >= 0 && row < 32 {
        transition column >= 0 && column < problem.cells && column < 32 { true -> update(problem, pivot, row, column, value) false -> lower(problem, pivot, row + 1) }
    }
    machine update(problem: &mut Problem, pivot: i32, row: i32, column: i32, value: Complex) requires pivot >= 0 && pivot < 32 && row >= 0 && row < 32 && column >= 0 && column < 32 {
        let updated: Complex = subtract(element(problem, row, column), multiply(value, element(problem, pivot, column)));
        store(problem, row, column, updated);
        transition { _ -> eliminate(problem, pivot, row, column + 1, value) }
    }
    machine done() {}
}
machine identity(row: i32, column: i32) -> f64 { transition row == column { true -> 1.0 false -> 0.0 } }
public machine step(problem: &mut Problem) {
    transition { _ -> rhs_row(problem, 0) }
    machine rhs_row(problem: &mut Problem, row: i32) {
        transition row >= 0 && row < problem.cells && row < 32 { true -> rhs_column(problem, row, 0, Complex { real: 0.0, imaginary: 0.0 }) false -> forward(problem, 0) }
    }
    machine rhs_column(problem: &mut Problem, row: i32, column: i32, sum: Complex) requires row >= 0 && row < 32 {
        transition column >= 0 && column < problem.cells && column < 32 { true -> rhs_add(problem, row, column, sum) false -> rhs_store(problem, row, sum) }
    }
    machine rhs_add(problem: &mut Problem, row: i32, column: i32, sum: Complex) requires row >= 0 && row < 32 && column >= 0 && column < 32 {
        let coefficient: Complex = Complex { real: identity(row, column), imaginary: 0.0 - 0.5 * problem.timestep * hamiltonian(problem, row, column) };
        let updated: Complex = add(sum, multiply(coefficient, problem.amplitude[column]));
        transition { _ -> rhs_column(problem, row, column + 1, updated) }
    }
    machine rhs_store(problem: &mut Problem, row: i32, sum: Complex) requires row >= 0 && row < 32 {
        problem.right[row] = sum;
        transition { _ -> rhs_row(problem, row + 1) }
    }
    machine forward(problem: &mut Problem, row: i32) {
        let last: i32 in Wrapping = (problem.cells as i32 in Wrapping) - 1;
        transition row >= 0 && row < problem.cells && row < 32 { true -> forward_column(problem, row, 0, Complex { real: 0.0, imaginary: 0.0 }) false -> backward(problem, last as i32) }
    }
    machine forward_column(problem: &mut Problem, row: i32, column: i32, sum: Complex) requires row >= 0 && row < 32 {
        transition column >= 0 && column < row && column < 32 { true -> forward_add(problem, row, column, sum) false -> forward_store(problem, row, sum) }
    }
    machine forward_add(problem: &mut Problem, row: i32, column: i32, sum: Complex) requires row >= 0 && row < 32 && column >= 0 && column < 32 {
        let updated: Complex = add(sum, multiply(element(problem, row, column), problem.right[column]));
        transition { _ -> forward_column(problem, row, column + 1, updated) }
    }
    machine forward_store(problem: &mut Problem, row: i32, sum: Complex) requires row >= 0 && row < 32 {
        problem.right[row] = subtract(problem.right[row], sum);
        transition { _ -> forward(problem, row + 1) }
    }
    machine backward(problem: &mut Problem, row: i32) {
        transition row >= 0 && row < 32 { true -> backward_column(problem, row, row + 1, Complex { real: 0.0, imaginary: 0.0 }) false -> copy(problem, 0) }
    }
    machine backward_column(problem: &mut Problem, row: i32, column: i32, sum: Complex) requires row >= 0 && row < 32 {
        transition column >= 0 && column < problem.cells && column < 32 { true -> backward_add(problem, row, column, sum) false -> backward_store(problem, row, sum) }
    }
    machine backward_add(problem: &mut Problem, row: i32, column: i32, sum: Complex) requires row >= 0 && row < 32 && column >= 0 && column < 32 {
        let updated: Complex = add(sum, multiply(element(problem, row, column), problem.next[column]));
        transition { _ -> backward_column(problem, row, column + 1, updated) }
    }
    machine backward_store(problem: &mut Problem, row: i32, sum: Complex) requires row >= 0 && row < 32 {
        problem.next[row] = divide(subtract(problem.right[row], sum), element(problem, row, row));
        transition { _ -> backward(problem, row - 1) }
    }
    machine copy(problem: &mut Problem, row: i32) {
        transition row >= 0 && row < problem.cells && row < 32 { true -> copied(problem, row) false -> done() }
    }
    machine copied(problem: &mut Problem, row: i32) requires row >= 0 && row < 32 {
        problem.amplitude[row] = problem.next[row];
        transition { _ -> copy(problem, row + 1) }
    }
    machine done() {}
}
