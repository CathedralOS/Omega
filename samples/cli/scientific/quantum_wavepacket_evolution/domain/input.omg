// Bounded ASCII signed decimals (no exponent), at most 24 digits, magnitude <= 1e6.
// The byte budget includes separators and trailing whitespace. EOF is accepted
// only after a complete token; malformed, truncated and over-budget input reject.
use omega_language_std::console;
use omega::language::core::F64::from_i32;

public data Reader { consumed: i32; fractional: bool; }
public data Number [copy] { valid: bool; value: f64; integer: bool; }

machine character(reader: &mut Reader) -> i32 reaches Console {
    transition reader.consumed >= 0 && reader.consumed <= 4096 {
        true -> block read(reader)
        _ -> -2
    }
    machine read(reader: &mut Reader) -> i32 requires reader.consumed >= 0 && reader.consumed <= 4096 {
        let byte: ByteRead = block Console::read_byte();
        transition byte { ByteRead::Eof -> -1 ByteRead::Byte { value } -> counted(reader, value) }
    }
    machine counted(reader: &mut Reader, value: i32) -> i32 requires reader.consumed >= 0 && reader.consumed <= 4096 {
        transition reader.consumed < 4096 { true -> increment(reader, value) false -> -2 }
    }
    machine increment(reader: &mut Reader, value: i32) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        reader.consumed = reader.consumed + 1;
        transition { _ -> value }
    }
}
machine whitespace(value: i32) -> bool { transition { _ -> (value == 32 || value == 10 || value == 13 || value == 9) } }
public machine number(reader: &mut Reader) -> Number
reaches Console
invokes Console
blocks
crashes Trap
{
    reader.fractional = false;
    transition { _ -> block start(reader) }
    machine start(reader: &mut Reader) -> Number {
        let value: i32 = block character(reader);
        transition whitespace(value) { true -> block start(reader) _ -> block sign(reader, value) }
    }
    machine sign(reader: &mut Reader, value: i32) -> Number {
        transition value == 45 {
            true -> block negative(reader)
            _ -> block digit(reader, value, 1.0, 0.0, 0, false, 1.0)
        }
    }
    machine negative(reader: &mut Reader) -> Number {
        let value: i32 = block character(reader);
        transition { _ -> block digit(reader, value, -1.0, 0.0, 0, false, 1.0) }
    }
    machine digit(reader: &mut Reader, value: i32, sign: f64, accumulated: f64, digits: i32, decimal: bool, place: f64) -> Number {
        transition value >= 48 && value <= 57 && digits >= 0 && digits < 24 {
            true -> block append(reader, value, sign, accumulated, digits, decimal, place)
            _ -> block punctuation(reader, value, sign, accumulated, digits, decimal, place)
        }
    }
    machine append(reader: &mut Reader, value: i32, sign: f64, accumulated: f64, digits: i32, decimal: bool, place: f64) -> Number
    requires value >= 48 && value <= 57 && digits >= 0 && digits < 24
    {
        reader.fractional = reader.fractional || (decimal && value != 48);
        let numeric: f64 = F64::from_i32(value - 48);
        let next: f64 = accumulated * 10.0 + numeric;
        let observed: i32 = block character(reader);
        transition { _ -> block digit(reader, observed, sign, next, digits + 1, decimal, next_place(decimal, place)) }
    }
    machine punctuation(reader: &mut Reader, value: i32, sign: f64, accumulated: f64, digits: i32, decimal: bool, place: f64) -> Number {
        transition value == 46 && !decimal {
            true -> block point(reader, sign, accumulated, digits, place)
            _ -> finish(reader, value, sign, accumulated, digits, decimal, place)
        }
    }
    machine point(reader: &mut Reader, sign: f64, accumulated: f64, digits: i32, place: f64) -> Number {
        let observed: i32 = block character(reader);
        transition { _ -> block digit(reader, observed, sign, accumulated, digits, true, place) }
    }
    machine finish(reader: &Reader, value: i32, sign: f64, accumulated: f64, digits: i32, decimal: bool, place: f64) -> Number {
        transition digits > 0 && accumulated / place <= 1000000.0 && (whitespace(value) || value == -1) {
            true -> Number { valid: true, value: sign * accumulated / place, integer: !reader.fractional }
            _ -> Number { valid: false, value: 0.0, integer: false }
        }
    }
}
public machine ended(reader: &mut Reader) -> bool
reaches Console
invokes Console
blocks
crashes Trap
{
    transition { _ -> block scan(reader) }
    machine scan(reader: &mut Reader) -> bool {
        let value: i32 = block character(reader);
        transition value == -1 { true -> true _ -> block space(reader, value) }
    }
    machine space(reader: &mut Reader, value: i32) -> bool {
        transition whitespace(value) { true -> block scan(reader) _ -> false }
    }
}

machine next_place(decimal: bool, place: f64) -> f64 { transition decimal { true -> (place * 10.0) false -> (place) } }
