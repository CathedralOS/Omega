use linkage/model/model.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public machine number(value: u64) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    // Runtime recursion is tail-only. Find the highest decimal place, then
    // emit left to right using state backedges and a positive divisor.
    transition { _ -> scale(value, 1) }
    machine scale(value: u64, divisor: u64)
    requires divisor > 0 {
        transition divisor <= 1844674407370955161 && value / divisor >= 10 {
            true -> grow(value, divisor),
            false -> digit(value, divisor)
        }
    }
    machine grow(value: u64, divisor: u64)
    requires divisor > 0 && divisor <= 1844674407370955161 {
        transition { _ -> scale(value, divisor * 10) }
    }
    machine digit(value: u64, divisor: u64)
    requires divisor > 0 {
        |console|::Console::write_byte((value / divisor % 10 + 48) as i32);
        transition divisor >= 10 {
            true -> remaining(value, divisor),
            false -> done()
        }
    }
    machine remaining(value: u64, divisor: u64)
    requires divisor >= 10 {
        transition { _ -> digit(value % divisor, divisor / 10) }
    }
    machine done() { }
}

public machine report(linkage: @|model|::Linkage) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write("best=");
    number(linkage.best);
    |console|::Console::write_line("");
    |console|::Console::write("optima=");
    number(linkage.optima);
    |console|::Console::write_line("");
    |console|::Console::write("edges=");
    number(linkage.edges);
    |console|::Console::write_line("");
    |console|::Console::write("conflicts=");
    number(linkage.conflicts);
    |console|::Console::write_line("");
    |console|::Console::write("linked=");
    number(linkage.linked);
    |console|::Console::write_line("");
    |console|::Console::write("ambiguous=");
    number(linkage.ambiguous);
    |console|::Console::write_line("");
    |console|::Console::write("unmatched=");
    number(linkage.unmatched);
    |console|::Console::write_line("");
    |console|::Console::write("tp=");
    number(linkage.true_positive);
    |console|::Console::write_line("");
    |console|::Console::write("fp=");
    number(linkage.false_positive);
    |console|::Console::write_line("");
    |console|::Console::write("fn=");
    number(linkage.false_negative);
    |console|::Console::write_line("");
    |console|::Console::write("left1=");
    number(linkage.consensus[0]);
    |console|::Console::write_line("");
    |console|::Console::write("left2=");
    number(linkage.consensus[1]);
    |console|::Console::write_line("");
    |console|::Console::write("left3=");
    number(linkage.consensus[2]);
    |console|::Console::write_line("");
}
