use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data Input {
    tokens: [u64; 28];
    count: u64;
    bytes: u64;
    separator: bool;
    valid: bool;
}

// One digit per token, 28 tokens, at most 256 input bytes. EOF is required.
// Delimiters are ASCII space, tab, CR and LF; no implicit normalization.
public machine read(input: @mutable Input) reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    input.separator = true;
    transition { _ -> scan(input) }
    machine scan(input: @mutable Input) {
        transition input.bytes < 256 {
            true -> consume(input),
            false -> reject(input)
        }
    }
    machine consume(input: @mutable Input) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> reject(input),
            |console|::ByteRead::Eof -> finish(input),
            |console|::ByteRead::Byte { value } -> byte(input, value)
        }
    }
    machine byte(input: @mutable Input, value: i32) {
        input.bytes = input.bytes % 256 + 1;
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> space(input),
            false -> digit(input, value)
        }
    }
    machine space(input: @mutable Input) {
        input.separator = true;
        transition { _ -> scan(input) }
    }
    machine digit(input: @mutable Input, value: i32) {
        transition value >= 48 && value <= 57 && input.separator && input.count < 28 {
            true -> store(input, value),
            false -> reject(input)
        }
    }
    machine store(input: @mutable Input, value: i32)
    requires value >= 48 && value <= 57 {
        input.tokens[input.count] = (value - 48) as u64;
        input.count = input.count + 1;
        input.separator = false;
        transition { _ -> scan(input) }
    }
    machine finish(input: @mutable Input) { input.valid = input.count == 28; }
    machine reject(input: @mutable Input) { input.valid = false; }
}
