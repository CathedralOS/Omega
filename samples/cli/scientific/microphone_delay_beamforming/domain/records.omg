// Private bounded storage. Input digits encode signed amplitudes by adding four.
// Four candidate directions share one active-channel denominator and window.
public data Beamforming {
    raw: [u64; 36];
    samples: [[i64 in Wrapping; 8]; 3];
    horizontal: [u64; 3];
    vertical: [u64; 3];
    enabled: [u64; 3];
    active: i64 in Wrapping;
    waveform: [[i64 in Wrapping; 4]; 4];
    energy: [i64 in Wrapping; 4];
    best: i64 in Wrapping;
}
