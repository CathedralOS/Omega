use domain/process/process.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

data Main {
    process: |process|::Process;
    input: [u8; 4];
    variant: u64 in Wrapping;
    horizon: u64 in Wrapping;
    step: u64 in Wrapping;
    number: u64 in Wrapping;
    divisor: u64 in Wrapping;
}
// First line: two ASCII digits followed by LF, variant 0..5 and horizon 0..8.
// Processing ends after this line; trailing input is ignored.
// The bounded line API distinguishes EOF, full buffers and complete lines.
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let result: |console|::LineReadResult = block |console|::Console::read_line(@mutable main.input[..]);
    transition result {
        |console|::LineReadResult::LineComplete { count } -> length(main, count),
        _ -> invalid(main)
    }
    machine length(main: @mutable Main, count: u64) {
        transition count == 3 { true -> digits(main), _ -> invalid(main) }
    }
    machine digits(main: @mutable Main) {
        transition main.input[0] >= 48 && main.input[0] <= 53 && main.input[1] >= 48 && main.input[1] <= 56 && main.input[2] == 10 {
            true -> setup(main),
            _ -> invalid(main)
        }
    }
    machine setup(main: @mutable Main) {
        main.variant = (main.input[0] as u64 +Wrapping) - 48;
        main.horizon = (main.input[1] as u64 +Wrapping) - 48;
        |process|::initialize(@mutable main.process, main.variant);
        main.step = 0;
        |console|::Console::write_line("step healthy degraded failed survival denominator");
        transition { _ -> row(main) }
    }
    machine row(main: @mutable Main) {
        transition main.process.healthy + main.process.degraded + main.process.failed == main.process.denominator {
            true -> emit(main),
            _ -> failure(main)
        }
    }
    machine emit(main: @mutable Main) {
        // Stage copied scalars before borrowing the formatter context mutably.
        let step: u64 in Wrapping = main.step;
        let healthy: u64 in Wrapping = main.process.healthy;
        let degraded: u64 in Wrapping = main.process.degraded;
        let failed: u64 in Wrapping = main.process.failed;
        let survival: u64 in Wrapping = main.process.healthy + main.process.degraded;
        let denominator: u64 in Wrapping = main.process.denominator;
        decimal(main, step);
        |console|::Console::write_byte(32);
        decimal(main, healthy);
        |console|::Console::write_byte(32);
        decimal(main, degraded);
        |console|::Console::write_byte(32);
        decimal(main, failed);
        |console|::Console::write_byte(32);
        decimal(main, survival);
        |console|::Console::write_byte(32);
        decimal(main, denominator);
        |console|::Console::write_byte(10);
        transition main.step < main.horizon { true -> next(main), _ -> finish(main) }
    }
    machine next(main: @mutable Main) {
        |process|::advance(@mutable main.process);
        main.step = main.step + 1;
        transition { _ -> row(main) }
    }
    machine finish(main: @mutable Main) {
        let lifetime: u64 in Wrapping = main.process.lifetime;
        let denominator: u64 in Wrapping = main.process.denominator;
        |console|::Console::write("expected_min_lifetime ");
        decimal(main, lifetime);
        |console|::Console::write_byte(32);
        decimal(main, denominator);
        |console|::Console::write_byte(10);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("invalid input: expected variant 0..5 and horizon 0..8 followed by LF");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine failure(main: @mutable Main) {
        |console|::Console::write_line("probability conservation failed");
        |process_exit|::ProcessExit::exit_process(70);
    }
}
// Private decimal formatting over the established byte console provider.
machine decimal(main: @mutable Main, number: u64 in Wrapping) reaches |process_authority|::StandardOutput {
    main.number = number;
    main.divisor = 1;
    transition { _ -> scale(main) }
    machine scale(main: @mutable Main) {
        transition main.divisor <= main.number / 10 {
            true -> increase(main),
            _ -> digit(main)
        }
    }
    machine increase(main: @mutable Main) {
        main.divisor = main.divisor * 10;
        transition { _ -> scale(main) }
    }
    machine digit(main: @mutable Main) {
        transition main.divisor != 0 { true -> write(main), _ -> done() }
    }
    machine write(main: @mutable Main) {
        let digit: u64 in Wrapping = (main.number / main.divisor) % 10;
        |console|::Console::write_byte((digit as i32) + 48);
        main.divisor = main.divisor / 10;
        transition { _ -> digit(main) }
    }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
