module domain::process;
// Exact finite Markov evolution: transition rows contain integer quarters.
// The absorbing row is (0,0,4). Distribution numerators share denominator.
// At horizon <= 8 every intermediate is below 2^24, so Wrapping never wraps.
public data Process {
    healthy: u64 in Wrapping;
    degraded: u64 in Wrapping;
    failed: u64 in Wrapping;
    denominator: u64 in Wrapping;
    lifetime: u64 in Wrapping;
    healthy_stays: u64 in Wrapping;
    healthy_degrades: u64 in Wrapping;
    degraded_repairs: u64 in Wrapping;
    degraded_stays: u64 in Wrapping;
}
machine initialize(process: &mut Process, variant: u64 in Wrapping) {
    process.healthy = 1;
    process.degraded = 0;
    process.failed = 0;
    process.denominator = 1;
    process.lifetime = 0;
    process.healthy_stays = 2;
    process.healthy_degrades = 1;
    process.degraded_repairs = 0;
    process.degraded_stays = 2;
    transition variant {
        1 -> repair(process)
        2 -> unreachable(process)
        3 -> absorbed(process)
        4 -> deterministic(process)
        5 -> degraded(process)
        _ -> done()
    }
    machine repair(process: &mut Process) {
        process.degraded_repairs = 1;
    }
    machine unreachable(process: &mut Process) {
        process.healthy_stays = 3;
        process.healthy_degrades = 1;
        process.degraded_repairs = 1;
        process.degraded_stays = 3;
    }
    machine absorbed(process: &mut Process) {
        process.healthy = 0;
        process.failed = 1;
    }
    machine deterministic(process: &mut Process) {
        process.healthy_stays = 0;
        process.healthy_degrades = 4;
        process.degraded_stays = 0;
    }
    machine degraded(process: &mut Process) {
        process.healthy = 0;
        process.degraded = 1;
    }
    machine done() { }
}
machine advance(process: &mut Process) {
    let healthy: u64 in Wrapping = process.healthy * process.healthy_stays + process.degraded * process.degraded_repairs;
    let degraded: u64 in Wrapping = process.healthy * process.healthy_degrades + process.degraded * process.degraded_stays;
    let failed: u64 in Wrapping = process.failed * 4 + process.healthy * (4 - process.healthy_stays - process.healthy_degrades) + process.degraded * (4 - process.degraded_repairs - process.degraded_stays);
    // E[min(T,H)] = sum(t=0..H-1) P(T>t). Rescale the old sum and
    // add the old survival before replacing the distribution.
    process.lifetime = process.lifetime * 4 + (process.healthy + process.degraded) * 4;
    process.denominator = process.denominator * 4;
    process.healthy = healthy;
    process.degraded = degraded;
    process.failed = failed;
}
