use clearance/model/model.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

// Fixed-width decimal keeps every output field easy to compare as raw bytes.
machine number(value: i32 in Saturating) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_byte(((value / 100) % 10 + 48) as i32);
    |console|::Console::write_byte(((value / 10) % 10 + 48) as i32);
    |console|::Console::write_byte((value % 10 + 48) as i32);
    |console|::Console::write_byte(10);
}

machine number5(value: i32 in Saturating) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_byte(((value / 10000) % 10 + 48) as i32);
    |console|::Console::write_byte(((value / 1000) % 10 + 48) as i32);
    |console|::Console::write_byte(((value / 100) % 10 + 48) as i32);
    |console|::Console::write_byte(((value / 10) % 10 + 48) as i32);
    |console|::Console::write_byte((value % 10 + 48) as i32);
    |console|::Console::write_byte(10);
}

public machine report(certificate: @|model|::Certificate) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_line("clearance_route_planner: synthetic span-height clearance model");
    |console|::Console::write_line("explored_words"); number5(10000);
    |console|::Console::write_line("feasible_profiles"); number5(certificate.feasible);
    |console|::Console::write_line("optimal_ties"); number5(certificate.ties);
    transition certificate.ties > 0 {
        true -> optimal(certificate),
        false -> infeasible()
    }
    machine infeasible() {
        |console|::Console::write_line("INFEASIBLE");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine optimal(certificate: @|model|::Certificate) {
        |console|::Console::write_line("OPTIMAL minimum_vertical_travel lexicographic_profile");
        |console|::Console::write_line("vertical_travel"); number(certificate.best.cost);
        |console|::Console::write_line("profile span_1 span_2 span_3 span_4");
        number(certificate.best.heights[0]);
        number(certificate.best.heights[1]);
        number(certificate.best.heights[2]);
        number(certificate.best.heights[3]);
        |console|::Console::write_line("final_height"); number(certificate.best.heights[3]);
        |process_exit|::ProcessExit::exit_process(0);
    }
}
