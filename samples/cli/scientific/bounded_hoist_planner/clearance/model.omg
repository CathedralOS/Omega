// Synthetic load-height clearance model in integer decimeters.
// A hoist carries a load through four consecutive spans; each span admits an
// operating height inside [floor, ceiling]. The rigging adjusts at most four
// height units between adjacent spans and the final span must deliver the
// required end height. The objective minimizes total vertical travel.
// Saturating arithmetic is explicit; admitted inputs bound all totals below
// 256, so no reachable operation saturates. No external numerical package.
public data Plan {
    start: i32 in Saturating;
    end: i32 in Saturating;
    floors: [i32 in Saturating; 4];
    ceilings: [i32 in Saturating; 4];
}
public data Travel {
    cost: i32 in Saturating;
    heights: [i32 in Saturating; 4];
}
public data Certificate {
    feasible: i32 in Saturating;
    ties: i32 in Saturating;
    code: u64;
    best: Travel;
}
