use clearance::model;

// Ten ASCII digits: H0 HE F1 C1 F2 C2 F3 C3 F4 C4.
// Only complete ten-digit records are admitted by the entrypoint.
public machine parse(bytes: &[u8; 11], plan: &mut Plan) -> bool {
    let mut digits: [i32 in Saturating; 10];
    transition { _ -> digit(bytes, plan, &mut digits, 0) }
    machine digit(bytes: &[u8; 11], plan: &mut Plan, digits: &mut [i32 in Saturating; 10], index: u64) -> bool {
        transition index < 10 {
            true -> inspect(bytes, plan, digits, index)
            false -> assemble(plan, digits)
        }
    }
    machine inspect(bytes: &[u8; 11], plan: &mut Plan, digits: &mut [i32 in Saturating; 10], index: u64) -> bool {
        let byte: u8 = bytes[index];
        transition byte >= 48 && byte <= 57 {
            true -> store(bytes, plan, digits, index, byte)
            false -> false
        }
    }
    machine store(bytes: &[u8; 11], plan: &mut Plan, digits: &mut [i32 in Saturating; 10], index: u64, byte: u8) -> bool {
        digits[index] = (byte as i32 in Saturating) - 48;
        transition index < 10 {
            true -> digit(bytes, plan, digits, index + 1)
            false -> false
        }
    }
    machine assemble(plan: &mut Plan, digits: &[i32 in Saturating; 10]) -> bool {
        plan.start = digits[0];
        plan.end = digits[1];
        plan.floors[0] = digits[2];
        plan.ceilings[0] = digits[3];
        plan.floors[1] = digits[4];
        plan.ceilings[1] = digits[5];
        plan.floors[2] = digits[6];
        plan.ceilings[2] = digits[7];
        plan.floors[3] = digits[8];
        plan.ceilings[3] = digits[9];
        plan.floors[0] <= plan.ceilings[0] && plan.floors[1] <= plan.ceilings[1] &&
            plan.floors[2] <= plan.ceilings[2] && plan.floors[3] <= plan.ceilings[3]
    }
}
