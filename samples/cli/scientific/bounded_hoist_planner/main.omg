use clearance/model/model.omg;
use clearance/search/search.omg;
use input/parse/parse.omg;
use reporting/certificate/certificate.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// With closed stdin the application rejects the missing record.
// Expected exit: 64.
// Expected output contains: INVALID: expected

data Clearance {
    input: [u8; 11];
    plan: |model|::Plan;
    certificate: |model|::Certificate;
}

machine main(clearance: @mutable Clearance) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let read: |console|::LineReadResult = block |console|::Console::read_line(@mutable clearance.input[..]);
    transition read {
        |console|::LineReadResult::LineComplete { count } -> newline(clearance, count),
        |console|::LineReadResult::EndOfInput { count } -> eof(clearance, count),
        _ -> invalid(clearance)
    }
    machine newline(clearance: @mutable Clearance, count: u64) {
        transition count == 11 && clearance.input[10] == 10 {
            true -> decode(clearance),
            false -> invalid(clearance)
        }
    }
    machine eof(clearance: @mutable Clearance, count: u64) {
        transition count == 10 {
            true -> decode(clearance),
            false -> invalid(clearance)
        }
    }
    machine decode(clearance: @mutable Clearance) {
        let valid: bool = |parse|::parse(@clearance.input, @mutable clearance.plan);
        transition valid {
            true -> route(clearance),
            false -> invalid(clearance)
        }
    }
    machine route(clearance: @mutable Clearance) {
        |search|::solve(@clearance.plan, @mutable clearance.certificate);
        |certificate|::report(@clearance.certificate);
    }
    machine invalid(clearance: @mutable Clearance) {
        |console|::Console::write_line("INVALID: expected H0 HE F1 C1 F2 C2 F3 C3 F4 C4, ten digits; each floor<=ceiling");
        |process_exit|::ProcessExit::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Clearance;
    block main(@mutable entry_storage);
}
