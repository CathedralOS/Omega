use domain/codec/codec.omg;
use domain/input/input.omg;
use domain/model/model.omg;
use domain/report/report.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 10.
// Expected output contains: error: input bounds or syntax

data Main { }

// The entry owns input, private codec storage, decoding and certification.
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable input: |model|::InputBuffer;
    let success: bool = block |input|::read_input(@mutable input);
    transition success && input.length > 0 {
        true -> dispatch(main, @input),
        _ -> bad_input(main)
    }
    machine dispatch(main: @mutable Main, input: @|model|::InputBuffer) {
        transition input.bytes[0] {
            0 -> compress(main, input),
            1 -> decompress(main, input),
            _ -> bad_input(main)
        }
    }
    machine compress(main: @mutable Main, input: @|model|::InputBuffer) {
        let mutable original: |model|::SensorBlock;
        let parsed: bool = |input|::parse_records(input, @mutable original);
        transition parsed {
            true -> compression(main, @original),
            _ -> bad_input(main)
        }
    }
    machine compression(main: @mutable Main, original: @|model|::SensorBlock) {
        let mutable stream: |model|::SensorStream;
        let success: bool = |codec|::encode(original, @mutable stream);
        transition success {
            true -> verification(main, original, @stream),
            _ -> bad_input(main)
        }
    }
    machine verification(main: @mutable Main, original: @|model|::SensorBlock, stream: @|model|::SensorStream) {
        let mutable decoded: |model|::SensorBlock;
        let success: bool = |codec|::decode(stream, @mutable decoded);
        transition success {
            true -> certificate(main, original, stream, @decoded),
            _ -> bad_stream(main)
        }
    }
    machine certificate(main: @mutable Main, original: @|model|::SensorBlock, stream: @|model|::SensorStream, decoded: @|model|::SensorBlock) {
        let maximum: i32 = |codec|::certify(original, decoded);
        transition maximum >= 0 {
            true -> output(main, stream, decoded, maximum),
            _ -> bad_certificate(main)
        }
    }
    machine decompress(main: @mutable Main, input: @|model|::InputBuffer) {
        let mutable stream: |model|::SensorStream;
        let parsed: bool = |input|::parse_stream(input, @mutable stream);
        transition parsed {
            true -> decoding(main, @stream),
            _ -> bad_input(main)
        }
    }
    machine decoding(main: @mutable Main, stream: @|model|::SensorStream) {
        let mutable decoded: |model|::SensorBlock;
        let success: bool = |codec|::decode(stream, @mutable decoded);
        transition success {
            true -> output(main, stream, @decoded, -1),
            _ -> bad_stream(main)
        }
    }
    machine output(main: @mutable Main, stream: @|model|::SensorStream, decoded: @|model|::SensorBlock, maximum: i32) {
        |report|::report(stream, decoded, maximum);
    }
    machine bad_input(main: @mutable Main) { |console|::Console::write_line("error: input bounds or syntax"); |process_exit|::ProcessExit::exit_process(10); }
    machine bad_stream(main: @mutable Main) { |console|::Console::write_line("error: malformed sensor stream"); |process_exit|::ProcessExit::exit_process(12); }
    machine bad_certificate(main: @mutable Main) { |console|::Console::write_line("error: reconstruction certificate"); |process_exit|::ProcessExit::exit_process(13); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
