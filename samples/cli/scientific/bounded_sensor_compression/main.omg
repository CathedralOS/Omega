use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Expected exit: 10.
// Expected output contains: error: input bounds or syntax
use system\Console;
use domain\model\SensorBlock;
use domain\model\SensorStream;
use domain\model\InputBuffer;
use domain\input\read_input;
use domain\input\parse_records;
use domain\input\parse_stream;
use domain\codec\encode;
use domain\codec\decode;
use domain\codec\certify;
use domain\report\report;

data Main { }

// The entry owns input, private codec storage, decoding and certification.
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    let mutable input: InputBuffer;
    let success: bool = block read_input(@mutable input);
    transition success && input.length > 0 {
        true -> dispatch(main, @input),
        _ -> bad_input(main)
    }
    machine dispatch(main: @mutable Main, input: @InputBuffer) {
        transition input.bytes[0] {
            0 -> compress(main, input),
            1 -> decompress(main, input),
            _ -> bad_input(main)
        }
    }
    machine compress(main: @mutable Main, input: @InputBuffer) {
        let mutable original: SensorBlock;
        let parsed: bool = parse_records(input, @mutable original);
        transition parsed {
            true -> compression(main, @original),
            _ -> bad_input(main)
        }
    }
    machine compression(main: @mutable Main, original: @SensorBlock) {
        let mutable stream: SensorStream;
        let success: bool = encode(original, @mutable stream);
        transition success {
            true -> verification(main, original, @stream),
            _ -> bad_input(main)
        }
    }
    machine verification(main: @mutable Main, original: @SensorBlock, stream: @SensorStream) {
        let mutable decoded: SensorBlock;
        let success: bool = decode(stream, @mutable decoded);
        transition success {
            true -> certificate(main, original, stream, @decoded),
            _ -> bad_stream(main)
        }
    }
    machine certificate(main: @mutable Main, original: @SensorBlock, stream: @SensorStream, decoded: @SensorBlock) {
        let maximum: i32 = certify(original, decoded);
        transition maximum >= 0 {
            true -> output(main, stream, decoded, maximum),
            _ -> bad_certificate(main)
        }
    }
    machine decompress(main: @mutable Main, input: @InputBuffer) {
        let mutable stream: SensorStream;
        let parsed: bool = parse_stream(input, @mutable stream);
        transition parsed {
            true -> decoding(main, @stream),
            _ -> bad_input(main)
        }
    }
    machine decoding(main: @mutable Main, stream: @SensorStream) {
        let mutable decoded: SensorBlock;
        let success: bool = decode(stream, @mutable decoded);
        transition success {
            true -> output(main, stream, @decoded, -1),
            _ -> bad_stream(main)
        }
    }
    machine output(main: @mutable Main, stream: @SensorStream, decoded: @SensorBlock, maximum: i32) {
        report(stream, decoded, maximum);
    }
    machine bad_input(main: @mutable Main) { Console::write_line("error: input bounds or syntax"); ProcessExit::exit_process(10); }
    machine bad_stream(main: @mutable Main) { Console::write_line("error: malformed sensor stream"); ProcessExit::exit_process(12); }
    machine bad_certificate(main: @mutable Main) { Console::write_line("error: reconstruction certificate"); ProcessExit::exit_process(13); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
