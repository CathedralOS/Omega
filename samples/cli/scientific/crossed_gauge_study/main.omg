use study/model/model.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete stdin application. Input: replication header, eight digit/m slots, EOF.
// Expected output contains: crossed_gauge_study: exact crossed random-effects sample; all numbers /32

data Main { study: |model|::Study; }

machine number(main: @mutable Main, value: i32 in Wrapping) reaches |process_authority|::StandardOutput {
    transition value < 0 { true -> negative(main, value), _ -> leading(main, value) }
    machine negative(main: @mutable Main, value: i32 in Wrapping) {
        |console|::Console::write("-");
        transition { _ -> leading(main, 0-value) }
    }
    machine leading(main: @mutable Main, value: i32 in Wrapping) {
        transition value >= 10000 { true -> ten_thousands(main, value), _ -> check_thousands(main, value) }
    }
    machine ten_thousands(main: @mutable Main, value: i32 in Wrapping) {
        |console|::Console::write_byte((value / 10000 + 48) as i32);
        transition { _ -> thousands(main, value) }
    }
    machine check_thousands(main: @mutable Main, value: i32 in Wrapping) {
        transition value >= 1000 { true -> thousands(main, value), _ -> check_hundreds(main, value) }
    }
    machine thousands(main: @mutable Main, value: i32 in Wrapping) {
        |console|::Console::write_byte((value / 1000 % 10 + 48) as i32);
        transition { _ -> hundreds(main, value) }
    }
    machine check_hundreds(main: @mutable Main, value: i32 in Wrapping) {
        transition value >= 100 { true -> hundreds(main, value), _ -> check_tens(main, value) }
    }
    machine hundreds(main: @mutable Main, value: i32 in Wrapping) {
        |console|::Console::write_byte((value / 100 % 10 + 48) as i32);
        transition { _ -> tens(main, value) }
    }
    machine check_tens(main: @mutable Main, value: i32 in Wrapping) {
        transition value >= 10 { true -> tens(main, value), _ -> ones(main, value) }
    }
    machine tens(main: @mutable Main, value: i32 in Wrapping) {
        |console|::Console::write_byte((value / 10 % 10 + 48) as i32);
        transition { _ -> ones(main, value) }
    }
    machine ones(main: @mutable Main, value: i32 in Wrapping) {
        |console|::Console::write_byte((value % 10 + 48) as i32);
        |console|::Console::write_line("");
    }
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("crossed_gauge_study: exact crossed random-effects sample; all numbers /32");
    transition { _ -> block header(main) }
    machine header(main: @mutable Main) {
        let byte: |console|::ByteRead = block |console|::Console::read_byte();
        transition byte {
            |console|::ByteRead::Byte { value } -> block header_byte(main, value),
            _ -> invalid(main)
        }
    }
    machine header_byte(main: @mutable Main, value: i32) {
        transition value {
            50 -> block read(main, 0 as +Wrapping),
            49 -> insufficient(main),
            32 -> block header(main),
            10 -> block header(main),
            13 -> block header(main),
            _ -> invalid(main)
        }
    }
    machine read(main: @mutable Main, index: i32 in Wrapping) {
        let byte: |console|::ByteRead = block |console|::Console::read_byte();
        transition byte {
            |console|::ByteRead::Error -> invalid(main),
            |console|::ByteRead::Byte { value } -> block token(main, index, value),
            |console|::ByteRead::Eof -> finish(main, index)
        }
    }
    machine token(main: @mutable Main, index: i32 in Wrapping, value: i32) {
        transition value == 32 || value == 10 || value == 13 {
            true -> block read(main, index),
            _ -> block extent(main, index, value)
        }
    }
    machine extent(main: @mutable Main, index: i32 in Wrapping, value: i32) {
        transition index >= 0 && index < 8 {
            true -> block measurement(main, index, value),
            _ -> invalid(main)
        }
    }
    machine measurement(main: @mutable Main, index: i32 in Wrapping, value: i32) {
        transition value >= 48 && value <= 57 {
            true -> block store(main, index, value),
            _ -> block missing(main, index, value)
        }
    }
    machine store(main: @mutable Main, index: i32 in Wrapping, value: i32) {
        main.study.values[index] = (value as i32 +Wrapping) - 48;
        main.study.present[index] = 1 as +Wrapping;
        transition { _ -> block read(main, index + 1) }
    }
    machine missing(main: @mutable Main, index: i32 in Wrapping, value: i32) {
        transition value == 109 {
            true -> block absent(main, index),
            _ -> invalid(main)
        }
    }
    machine absent(main: @mutable Main, index: i32 in Wrapping) {
        main.study.values[index] = 0 as +Wrapping;
        main.study.present[index] = 0 as +Wrapping;
        transition { _ -> block read(main, index + 1) }
    }
    machine finish(main: @mutable Main, index: i32 in Wrapping) {
        transition index == 8 { true -> analyze(main), _ -> invalid(main) }
    }
    machine analyze(main: @mutable Main) {
        let status: i32 = |model|::analyze(@mutable main.study);
        transition status { 0 -> report(main), 3 -> missing_cell(main), 5 -> insufficient(main), _ -> unequal(main) }
    }
    machine report(main: @mutable Main) {
        |console|::Console::write_line("identifiable: parts=2 operators=2 repeats=2; df=1,1,1,4 total=7");
        |console|::Console::write("ss_part=");
        let part_sum_of_squares: i32 in Wrapping = main.study.part;
        number(main, part_sum_of_squares);
        |console|::Console::write("ss_operator=");
        let operator_sum_of_squares: i32 in Wrapping = main.study.operator_effect;
        number(main, operator_sum_of_squares);
        |console|::Console::write("ss_interaction=");
        let interaction_sum_of_squares: i32 in Wrapping = main.study.interaction;
        number(main, interaction_sum_of_squares);
        |console|::Console::write("ss_error=");
        let error_sum_of_squares: i32 in Wrapping = main.study.error;
        number(main, error_sum_of_squares);
        |console|::Console::write("ss_total=");
        let total_sum_of_squares: i32 in Wrapping = main.study.total;
        number(main, total_sum_of_squares);
        |console|::Console::write("ms_error=");
        let error_mean_square: i32 in Wrapping = main.study.repeatability;
        number(main, error_mean_square);
        |console|::Console::write("raw_part=");
        let raw_part_component: i32 in Wrapping = main.study.part_variance;
        number(main, raw_part_component);
        |console|::Console::write("raw_operator=");
        let raw_operator_component: i32 in Wrapping = main.study.operator_variance;
        number(main, raw_operator_component);
        |console|::Console::write("raw_interaction=");
        let raw_interaction_component: i32 in Wrapping = main.study.interaction_variance;
        number(main, raw_interaction_component);
        |console|::Console::write("repeatability=");
        let repeatability_component: i32 in Wrapping = main.study.repeatability;
        number(main, repeatability_component);
        |console|::Console::write("part_variance=");
        let clamped_part_component: i32 in Wrapping = |model|::nonnegative(main.study.part_variance);
        number(main, clamped_part_component);
        |console|::Console::write("operator_variance=");
        let clamped_operator_component: i32 in Wrapping = |model|::nonnegative(main.study.operator_variance);
        number(main, clamped_operator_component);
        |console|::Console::write("interaction_variance=");
        let clamped_interaction_component: i32 in Wrapping = |model|::nonnegative(main.study.interaction_variance);
        number(main, clamped_interaction_component);
        |console|::Console::write("gauge_variance=");
        let gauge_component: i32 in Wrapping = main.study.repeatability + |model|::nonnegative(main.study.operator_variance) + |model|::nonnegative(main.study.interaction_variance);
        number(main, gauge_component);
        |console|::Console::write_line("interaction: retained; negative components clamped individually; no pooling");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("invalid input: expected header 2 and exactly eight digit/m slots");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine insufficient(main: @mutable Main) {
        |console|::Console::write_line("not identifiable: one repeat cannot separate interaction from repeatability");
        |process_exit|::ProcessExit::exit_process(5);
    }
    machine missing_cell(main: @mutable Main) {
        |console|::Console::write_line("not identifiable: missing part/operator cell; balanced ANOVA refused");
        |process_exit|::ProcessExit::exit_process(3);
    }
    machine unequal(main: @mutable Main) {
        |console|::Console::write_line("not identifiable: unequal replication; balanced ANOVA refused");
        |process_exit|::ProcessExit::exit_process(4);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
