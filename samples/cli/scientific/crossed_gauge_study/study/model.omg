module study::model;
// Private bounded sample model: y = grand + part + operator + interaction + error.
// All arithmetic intermediates fit signed i32 for eight observations in 0..9.
// Reports are exact numerators over 32; Wrapping never actually wraps here.
public data Study {
    values: [i32 in Wrapping; 8];
    present: [i32 in Wrapping; 8];
    part: i32 in Wrapping;
    operator_effect: i32 in Wrapping;
    interaction: i32 in Wrapping;
    error: i32 in Wrapping;
    total: i32 in Wrapping;
    repeatability: i32 in Wrapping;
    part_variance: i32 in Wrapping;
    operator_variance: i32 in Wrapping;
    interaction_variance: i32 in Wrapping;
}

public machine nonnegative(value: i32 in Wrapping) -> i32 in Wrapping {
    transition value < 0 { true -> 0 _ -> value }
}

// Return 3 for a wholly missing cell, 4 for unequal replication, 0 for balanced.
public machine analyze(study: &mut Study) -> i32 {
    let a: i32 in Wrapping = study.present[0] + study.present[1];
    let b: i32 in Wrapping = study.present[2] + study.present[3];
    let c: i32 in Wrapping = study.present[4] + study.present[5];
    let d: i32 in Wrapping = study.present[6] + study.present[7];
    transition a == 0 || b == 0 || c == 0 || d == 0 {
        true -> 3
        _ -> replication(study, a, b, c, d)
    }
    machine replication(study: &mut Study, a: i32 in Wrapping, b: i32 in Wrapping,
                      c: i32 in Wrapping, d: i32 in Wrapping) -> i32 {
        transition a == 2 && b == 2 && c == 2 && d == 2 {
            true -> calculate(study)
            _ -> single_repeat(a, b, c, d)
        }
    }
    machine single_repeat(a: i32 in Wrapping, b: i32 in Wrapping,
                        c: i32 in Wrapping, d: i32 in Wrapping) -> i32 {
        transition a == 1 && b == 1 && c == 1 && d == 1 { true -> 5 _ -> 4 }
    }
    machine calculate(study: &mut Study) -> i32 {
        let a: i32 in Wrapping = study.values[0] + study.values[1];
        let b: i32 in Wrapping = study.values[2] + study.values[3];
        let c: i32 in Wrapping = study.values[4] + study.values[5];
        let d: i32 in Wrapping = study.values[6] + study.values[7];
        let part: i32 in Wrapping = a + b - c - d;
        let operator_effect: i32 in Wrapping = a + c - b - d;
        let interaction: i32 in Wrapping = a - b - c + d;
        let e0: i32 in Wrapping = study.values[0] - study.values[1];
        let e1: i32 in Wrapping = study.values[2] - study.values[3];
        let e2: i32 in Wrapping = study.values[4] - study.values[5];
        let e3: i32 in Wrapping = study.values[6] - study.values[7];
        let error: i32 in Wrapping = e0*e0 + e1*e1 + e2*e2 + e3*e3;
        study.part = 4*part*part;
        study.operator_effect = 4*operator_effect*operator_effect;
        study.interaction = 4*interaction*interaction;
        study.error = 16*error;
        study.total = study.part + study.operator_effect + study.interaction + study.error;
        study.repeatability = 4*error;
        study.part_variance = part*part - interaction*interaction;
        study.operator_variance = operator_effect*operator_effect - interaction*interaction;
        study.interaction_variance = 2*(interaction*interaction - error);
        0
    }
}
