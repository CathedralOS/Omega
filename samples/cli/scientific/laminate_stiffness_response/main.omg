use mechanics/checks/checks.omg;
use mechanics/fixtures/fixtures.omg;
use mechanics/model/model.omg;
use mechanics/report/report.omg;
use mechanics/solve/solve.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete finite laminate workflow. Input selects one declared synthetic stack.
// Expected exit: 0 (valid 0..4); singular 5 exits 3; invalid input exits 2.
data Main { reporter: |report|::Reporter; model: |model|::Laminate; input: [u8; 4]; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let observed: |console|::LineReadResult = block |console|::Console::read_line(@mutable main.input[..]);
    transition observed {
        |console|::LineReadResult::LineComplete { count } -> input_count(main,count),
        |console|::LineReadResult::EndOfInput { count } -> eof(main,count),
        _ -> bad_input(main)
    }
    machine input_count(main: @mutable Main,count: u64) {
        transition count == 2 && main.input[1] == 10 { true -> choose(main), false -> bad_input(main) }
    }
    machine eof(main: @mutable Main,count: u64) {
        transition count == 1 { true -> choose(main), false -> bad_input(main) }
    }
    machine choose(main: @mutable Main) {
        let mode: u8 = main.input[0];
        transition mode >= 48 && mode <= 56 { true -> initialize(main,mode), false -> bad_input(main) }
    }
    machine initialize(main: @mutable Main,mode: u8) {
        |fixtures|::fixture(@mutable main.model,mode);
        transition main.model.count > 0 && main.model.count <= 4 {
            true -> validate(main,mode,0,0.0),
            false -> bad_model(main)
        }
    }
    machine validate(main: @mutable Main,mode: u8,layer_index: u64,total: f64)
    requires layer_index <= 3 {
        let thickness: f64 = main.model.thickness[layer_index];
        let m2: f64 = main.model.m2[layer_index];
        let n2: f64 = main.model.n2[layer_index];
        let mn: f64 = main.model.mn[layer_index];
        transition thickness > 0.0 && thickness <= 1.0 && m2 >= 0.0 && n2 >= 0.0 && |model|::absolute(m2+n2-1.0) < 0.000000000001 && |model|::absolute(mn*mn-m2*n2) < 0.000000000001 {
            true -> validated(main,mode,layer_index,total+thickness),
            false -> bad_model(main)
        }
    }
    machine validated(main: @mutable Main,mode: u8,layer_index: u64,total: f64)
    requires layer_index <= 3 {
        let next: u64 = layer_index+1;
        transition next < main.model.count && next <= 3 {
            true -> validate(main,mode,next,total),
            false -> centered(main,mode,total)
        }
    }
    machine centered(main: @mutable Main,mode: u8,total: f64) {
        main.model.z[0] = 0.0-total/2.0;
        transition mode == 53 { true -> layers(main,0,0.0), false -> layers(main,0,1.0) }
    }
    machine layers(main: @mutable Main,layer_index: u64,scale: f64)
    requires layer_index <= 3 {
        main.model.z[layer_index+1] = main.model.z[layer_index]+main.model.thickness[layer_index];
        |model|::transform(@mutable main.model.stiffness[layer_index],main.model.m2[layer_index],main.model.n2[layer_index],main.model.mn[layer_index],scale);
        let next: u64 = layer_index+1;
        transition next < main.model.count && next <= 3 { true -> layers(main,next,scale), false -> calculation(main) }
    }
    machine calculation(main: @mutable Main) {
        |model|::assemble(@mutable main.model);
        |model|::prepare_system(@mutable main.model);
        |solve|::solve(@mutable main.model);
        |model|::layer_stress(@mutable main.model);
        let accepted: bool = |checks|::matches(@main.model,main.input[0]);
        transition accepted { true -> accepted_report(main), false -> numeric_failure(main) }
    }
    machine numeric_failure(main: @mutable Main) {
        |console|::Console::write_line("NUMERIC CHECK FAILED"); |process_exit|::ProcessExit::exit_process(4);
    }
    machine accepted_report(main: @mutable Main) {
        |console|::Console::write_line("LAMINATE micro-units v1");
        transition { _ -> stiffness_report(main,0) }
    }
    machine stiffness_report(main: @mutable Main,layer_index: u64)
    requires layer_index <= 3 {
        |console|::Console::write_line("Q");
        |report|::matrix(@mutable main.reporter,@main.model.stiffness[layer_index]);
        let next: u64 = layer_index+1;
        transition next < main.model.count && next <= 3 { true -> stiffness_report(main,next), false -> assembled_report(main) }
    }
    machine assembled_report(main: @mutable Main) {
        |console|::Console::write_line("A"); |report|::matrix(@mutable main.reporter,@main.model.a);
        |console|::Console::write_line("B"); |report|::matrix(@mutable main.reporter,@main.model.b);
        |console|::Console::write_line("D"); |report|::matrix(@mutable main.reporter,@main.model.d);
        transition main.model.singular { true -> singular(main), false -> stresses(main) }
    }
    machine stresses(main: @mutable Main) {
        |console|::Console::write_line("RESPONSE");
        transition { _ -> response_report(main,0) }
    }
    machine response_report(main: @mutable Main,index: u64) requires index <= 5 {
        |report|::number(@mutable main.reporter,main.model.response[index]);
        let next: u64 = index+1;
        transition next <= 5 { true -> response_report(main,next), false -> stress_report(main,0) }
    }
    machine stress_report(main: @mutable Main,layer_index: u64) requires layer_index <= 3 {
        |console|::Console::write_line("STRESS");
        |report|::number(@mutable main.reporter,main.model.stress[layer_index][0]);
        |report|::number(@mutable main.reporter,main.model.stress[layer_index][1]);
        |report|::number(@mutable main.reporter,main.model.stress[layer_index][2]);
        let next: u64 = layer_index+1;
        transition next < main.model.count && next <= 3 { true -> stress_report(main,next), false -> done(main) }
    }
    machine singular(main: @mutable Main) { |console|::Console::write_line("SINGULAR"); |process_exit|::ProcessExit::exit_process(3); }
    machine bad_input(main: @mutable Main) { |console|::Console::write_line("INVALID INPUT"); |process_exit|::ProcessExit::exit_process(2); }
    machine bad_model(main: @mutable Main) { |console|::Console::write_line("INVALID MODEL"); |process_exit|::ProcessExit::exit_process(2); }
    machine done(main: @mutable Main) { |console|::Console::write_line("OK"); |process_exit|::ProcessExit::exit_process(0); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
