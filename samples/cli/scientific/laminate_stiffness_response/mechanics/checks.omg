        transition { _ -> compare(computed,&expected.values,0) }
    }
    machine compare(computed: &[f64;81],expected: &[f64;81],index: u64) -> bool
    requires index <= 80 {
        transition absolute(computed[index]-expected[index]) <= 0.00000001 {
            true -> advance(computed,expected,index)
            false -> invalid()
        }
    }
    machine advance(computed: &[f64;81],expected: &[f64;81],index: u64) -> bool
    requires index <= 80 {
        let next: u64 = index+1;
        transition next <= 80 { true -> compare(computed,expected,next) false -> valid() }
    }
    machine valid() -> bool { true }
    machine invalid() -> bool { false }
}
