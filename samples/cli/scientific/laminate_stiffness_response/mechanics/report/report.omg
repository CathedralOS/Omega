use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Signed fixed-point text: one numeric value per line in micro-units.
public data Reporter { }
public machine number(reporter: @mutable Reporter,value: f64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console crashes Trap {
    let converted: i32 in Trapping = |float_operations|::I32::from_f64(value*1000000.0);
    let scaled: i32 = converted as i32;
    transition scaled >= -1000000000 && scaled <= 1000000000 {
        true -> sign(reporter,scaled),
        false -> out_of_range(reporter)
    }
    machine sign(reporter: @mutable Reporter,value: i32)
    requires value >= -1000000000 && value <= 1000000000 {
        transition value < 0 { true -> negative(reporter,value), false -> positive(reporter,value) }
    }
    machine out_of_range(reporter: @mutable Reporter) {
        |console|::Console::write_line("REPORT RANGE ERROR"); |process_exit|::ProcessExit::exit_process(4);
    }
    machine negative(reporter: @mutable Reporter,value: i32)
    requires value >= -1000000000 && value < 0 {
        |console|::Console::write_byte(45);
        let magnitude: i32 = 0-value;
        transition { _ -> positive(reporter,magnitude) }
    }
    machine positive(reporter: @mutable Reporter,value: i32)
    requires value >= 0 && value <= 1000000000 {
        let mutable digits: [i32; 10];
        transition { _ -> collect(reporter,@mutable digits,value,0) }
    }
    machine collect(reporter: @mutable Reporter,digits: @mutable [i32;10],value: i32,position: u64)
    requires position <= 9 requires value >= 0 && value <= 1000000000 {
        digits[position] = value%10+48;
        let quotient: i32 = value/10;
        let next: u64 = position+1;
        transition quotient > 0 && next <= 9 {
            true -> collect(reporter,digits,quotient,next),
            false -> emit(reporter,digits,position)
        }
    }
    machine emit(reporter: @mutable Reporter,digits: @[i32;10],position: u64)
    requires position <= 9 {
        |console|::Console::write_byte(digits[position]);
        transition position > 0 { true -> previous(reporter,digits,position), false -> done(reporter) }
    }
    machine previous(reporter: @mutable Reporter,digits: @[i32;10],position: u64)
    requires position > 0 && position <= 9 {
        transition { _ -> emit(reporter,digits,position-1) }
    }
    machine done(reporter: @mutable Reporter) { |console|::Console::write_byte(10); }
}
public machine matrix(reporter: @mutable Reporter,values: @[[f64;3];3]) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console crashes Trap {
    transition { _ -> cell(reporter,values,0,0) }
    machine cell(reporter: @mutable Reporter,values: @[[f64;3];3],row: u64,column: u64)
    requires row <= 2 requires column <= 2 {
        number(reporter,values[row][column]);
        let next: u64 = column+1;
        transition next <= 2 { true -> cell(reporter,values,row,next), false -> next_row(reporter,values,row) }
    }
    machine next_row(reporter: @mutable Reporter,values: @[[f64;3];3],row: u64)
    requires row <= 2 {
        let next: u64 = row+1;
        transition next <= 2 { true -> cell(reporter,values,next,0), false -> done() }
    }
    machine done() { }
}
