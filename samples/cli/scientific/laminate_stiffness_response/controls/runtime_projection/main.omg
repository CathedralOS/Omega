use omega::language::core::ProcessExit;
// Complete valid reproduction of three runtime selectors behind a record loan.
use omega_language_std::Console;
data Storage { cells: [[[f64;2];2];2]; }
data Main { }
machine read(storage: &Storage,layer: u64,row: u64,column: u64) -> f64
requires layer <= 1 requires row <= 1 requires column <= 1 {
    storage.cells[layer][row][column]
}
machine main(main: &mut Main) reaches ProcessExit + Console {
    let mut storage: Storage;
    storage.cells[1][0][1] = 41.0;
    let observed: f64 = read(&storage,1,0,1);
    transition observed == 41.0 { true -> yes(main) false -> no(main) }
    machine yes(main: &mut Main) { Console::write_line("PROJECTION OK"); ProcessExit::exit_process(0); }
    machine no(main: &mut Main) { Console::write_line("PROJECTION WRONG"); ProcessExit::exit_process(4); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
