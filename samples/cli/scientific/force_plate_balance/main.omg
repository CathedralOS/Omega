use domain/balance/balance.omg;
use input/frames/frames.omg;
use output/report/report.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0.

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("force_plate_balance positions_mm=(-200,-100),(200,-100),(200,100),(-200,100) support_mm=150,75");
    transition { _ -> block next() }
    machine next() {
        let mutable buffer: [u8; 256];
        let observed: |console|::LineReadResult = block |console|::Console::read_line(@mutable buffer[..]);
        transition observed {
            |console|::LineReadResult::LineComplete { count } -> block line(@buffer, count, false),
            |console|::LineReadResult::EndOfInput { count } -> block line(@buffer, count, true),
            |console|::LineReadResult::Full { count } -> block oversized(),
            _ -> failed()
        }
    }
    machine line(buffer: @[u8; 256], count: u64, final: bool) {
        transition count <= buffer.length {
            true -> block bounded_line(buffer, count, final),
            _ -> failed()
        }
    }
    machine bounded_line(buffer: @[u8; 256], count: u64, final: bool)
    requires count <= buffer.length
    {
        transition final {
            true -> end(@buffer[..count], count),
            _ -> block parse(@buffer[..count])
        }
    }
    machine parse(text: @[u8]) {
        let parsed: |frames|::Parsed = |frames|::parse_frame(text);
        transition parsed {
            |frames|::Parsed::Valid { frame } -> block balance(frame),
            _ -> block malformed()
        }
    }
    machine balance(frame: |balance|::Frame) {
        let result: |balance|::Balance = |balance|::reconcile(@frame);
        |report|::report(@frame, @result);
        transition { _ -> block next() }
    }
    machine malformed() {
        |console|::Console::write_line("INVALID_SYNTAX expected seven signed integers <=1000000");
        transition { _ -> block next() }
    }
    machine oversized() {
        |console|::Console::write_line("INVALID_LINE_TOO_LONG");
        transition { _ -> block drain() }
    }
    machine drain() {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> failed(),
            |console|::ByteRead::Byte { value } -> block drain_byte(value),
            |console|::ByteRead::Eof -> done()
        }
    }
    machine drain_byte(value: i32) {
        transition value == 10 { true -> block next(), _ -> block drain() }
    }
    machine end(text: @[u8], count: u64) {
        transition count == 0 { true -> done(), _ -> final_frame(text) }
    }
    machine final_frame(text: @[u8]) {
        let parsed: |frames|::Parsed = |frames|::parse_frame(text);
        transition parsed { |frames|::Parsed::Valid { frame } -> final_balance(frame), _ -> final_invalid() }
    }
    machine final_balance(frame: |balance|::Frame) {
        let result: |balance|::Balance = |balance|::reconcile(@frame);
        |report|::report(@frame, @result);
        transition { _ -> done() }
    }
    machine final_invalid() { |console|::Console::write_line("INVALID_SYNTAX expected seven signed integers <=1000000"); |process_exit|::ProcessExit::exit_process(0); }
    machine done() { |process_exit|::ProcessExit::exit_process(0); }
    machine failed() { |process_exit|::ProcessExit::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
