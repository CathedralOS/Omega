use domain/balance/balance.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Collect decimal digits privately, then emit them in reverse order. Ten
// digits cover every bounded application result; division precedes all I/O.
data Decimal { digits: [i32; 10]; }
public machine number(value: i64 in Wrapping) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    transition value < 0 {
        true -> negative(value),
        _ -> positive(value)
    }
    machine negative(value: i64 in Wrapping) {
        |console|::Console::write_byte(45);
        transition { _ -> positive(0 - value) }
    }
    machine positive(value: i64 in Wrapping) {
        let mutable decimal: Decimal;
        transition { _ -> collect(decimal, value, 0) }
    }
    machine collect(decimal: Decimal, value: i64 in Wrapping, count: u64) {
        transition count < 10 { true -> append(decimal, value, count), _ -> failed() }
    }
    machine append(decimal: Decimal, value: i64 in Wrapping, count: u64)
    requires count < 10
    {
        let mutable completed: Decimal = decimal;
        completed.digits[count] = (value % 10 + 48) as i32;
        let remaining: i64 in Wrapping = value / 10;
        transition remaining == 0 {
            true -> emit(completed, count + 1),
            _ -> collect(completed, remaining, count + 1)
        }
    }
    machine emit(decimal: Decimal, count: u64) {
        transition count > 0 && count <= 10 { true -> byte(decimal, count), _ -> done() }
    }
    machine byte(decimal: Decimal, count: u64)
    requires count > 0 && count <= 10
    {
        |console|::Console::write_byte(decimal.digits[count - 1]);
        transition { _ -> emit(decimal, count - 1) }
    }
    machine done() { }
    machine failed() { |process_exit|::ProcessExit::exit_process(1); }
}
public machine report(frame: @|balance|::Frame, result: @|balance|::Balance) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write("loads=");
    number(frame.values[0] as i64 +Wrapping); |console|::Console::write(",");
    number(frame.values[1] as i64 +Wrapping); |console|::Console::write(",");
    number(frame.values[2] as i64 +Wrapping); |console|::Console::write(",");
    number(frame.values[3] as i64 +Wrapping);
    |console|::Console::write(" force="); number(result.force);
    |console|::Console::write(" moments="); number(result.moment_x); |console|::Console::write(","); number(result.moment_y);
    |console|::Console::write(" residuals="); number(result.force_residual); |console|::Console::write(","); number(result.x_residual); |console|::Console::write(","); number(result.y_residual);
    transition result.force > 0 && result.status != 1 && result.status != 2 {
        true -> position(result),
        _ -> decision(result)
    }
    machine position(result: @|balance|::Balance) {
        |console|::Console::write(" cop_mm="); number(result.moment_x); |console|::Console::write("/"); number(result.force);
        |console|::Console::write(","); number(result.moment_y); |console|::Console::write("/"); number(result.force);
        transition { _ -> decision(result) }
    }
    machine decision(result: @|balance|::Balance) {
        transition result.status {
            0 -> label(" SUPPORTED"),
            1 -> label(" INVALID_NEGATIVE_LOAD"),
            2 -> label(" INVALID_SATURATED_CELL"),
            3 -> label(" INVALID_ZERO_FORCE"),
            4 -> label(" INVALID_EQUILIBRIUM"),
            _ -> label(" OUTSIDE_SUPPORT")
        }
    }
    machine label(text: @[u8]) { |console|::Console::write_line(text); }
}
