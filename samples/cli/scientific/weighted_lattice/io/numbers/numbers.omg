use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public machine decimal(value: u64) reaches |process_authority|::StandardOutput {
    transition value >= 10 {
        true -> prefix(value),
        false -> digit(value)
    }
    machine prefix(value: u64) {
        decimal(value / 10);
        transition { _ -> digit(value) }
    }
    machine digit(value: u64) {
        |console|::Console::write_byte(|numeric_conversion|::narrow_u64_to_i32_trapping(value % 10 + 48));
    }
}
public machine number_line(label: @[u8], value: u64) reaches |process_authority|::StandardOutput {
    |console|::Console::write(label);
    decimal(value);
    |console|::Console::write_line("");
}
