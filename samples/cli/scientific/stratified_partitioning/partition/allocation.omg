// Enumerate all eight-bit group masks. Strict improvement preserves the
// smallest mask on ties; unused bits therefore stay zero. Group membership
// depends only on the numeric ID, never on input position.
use data::dataset;
public data Allocation {
    mask: i32 in Saturating;
    score: i32 in Saturating;
    total_error: i32 in Saturating;
    counts: [i32; 3] in Saturating;
    test_count: i32 in Saturating;
    found: bool;
}
public machine absolute(value: i32 in Saturating) -> i32 in Saturating {
    transition value < 0 { true -> (-value) _ -> (value) }
}
public machine selected(mask: i32 in Saturating, group: i32 in Saturating) -> bool {
    transition { _ -> power(mask, group, 1, 1) }
    machine power(mask: i32 in Saturating, group: i32 in Saturating, index: i32 in Saturating, weight: i32 in Saturating) -> bool {
        transition index < group && index < 8 {
            true -> power(mask, group, index + 1, weight * 2)
            _ -> divide_guard(mask, weight)
        }
    }
    machine divide_guard(mask: i32 in Saturating, weight: i32 in Saturating) -> bool {
        transition weight > 0 {
            true -> divide(mask, weight)
            _ -> (false)
        }
    }
    machine divide(mask: i32 in Saturating, weight: i32 in Saturating) -> bool
    requires weight > 0
    { (mask / weight) % 2 == 1 }
}
public machine Allocation::solve(result: &mut Allocation, data: &Dataset) {
    result.score = 10000;
    result.total_error = 10000;
    transition { _ -> candidate(result, data, 1) }
    machine candidate(result: &mut Allocation, data: &Dataset, mask: i32 in Saturating) {
        transition mask < 256 {
            true -> rows(result, data, mask, 0, 0, 0, 0)
            _ -> done(result)
        }
    }
    machine rows(result: &mut Allocation, data: &Dataset, mask: i32 in Saturating, index: i32 in Saturating, first: i32 in Saturating, second: i32 in Saturating, third: i32 in Saturating) {
        transition index < data.count && index >= 0 && index < 16 {
            true -> read(result, data, mask, index, first, second, third)
            _ -> evaluate(result, data, mask, first, second, third)
        }
    }
    machine read(result: &mut Allocation, data: &Dataset, mask: i32 in Saturating, index: i32 in Saturating, first: i32 in Saturating, second: i32 in Saturating, third: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        let included: bool = selected(mask, data.records[index].group);
        transition included {
            true -> stratum(result, data, mask, index, first, second, third)
            _ -> rows(result, data, mask, index + 1, first, second, third)
        }
    }
    machine stratum(result: &mut Allocation, data: &Dataset, mask: i32 in Saturating, index: i32 in Saturating, first: i32 in Saturating, second: i32 in Saturating, third: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        transition data.records[index].stratum {
            1 -> rows(result, data, mask, index + 1, first + 1, second, third)
            2 -> rows(result, data, mask, index + 1, first, second + 1, third)
            _ -> rows(result, data, mask, index + 1, first, second, third + 1)
        }
    }
    machine evaluate(result: &mut Allocation, data: &Dataset, mask: i32 in Saturating, first: i32 in Saturating, second: i32 in Saturating, third: i32 in Saturating) {
        let count: i32 in Saturating = first + second + third;
        transition count > 0 && count < data.count {
            true -> score(result, data, mask, first, second, third, count)
            _ -> candidate(result, data, mask + 1)
        }
    }
    machine score(result: &mut Allocation, data: &Dataset, mask: i32 in Saturating, first: i32 in Saturating, second: i32 in Saturating, third: i32 in Saturating, count: i32 in Saturating) {
        let error: i32 in Saturating = absolute(data.denominator * first - data.numerator * data.totals[0]) + absolute(data.denominator * second - data.numerator * data.totals[1]) + absolute(data.denominator * third - data.numerator * data.totals[2]);
        let total: i32 in Saturating = absolute(data.denominator * count - data.numerator * data.count);
        transition error < result.score || (error == result.score && total < result.total_error) {
            true -> retain(result, data, mask, first, second, third, count, error, total)
            _ -> candidate(result, data, mask + 1)
        }
    }
    machine retain(result: &mut Allocation, data: &Dataset, mask: i32 in Saturating, first: i32 in Saturating, second: i32 in Saturating, third: i32 in Saturating, count: i32 in Saturating, error: i32 in Saturating, total: i32 in Saturating) {
        result.mask = mask;
        result.counts[0] = first;
        result.counts[1] = second;
        result.counts[2] = third;
        result.test_count = count;
        result.score = error;
        result.total_error = total;
        result.found = true;
        transition { _ -> candidate(result, data, mask + 1) }
    }
    machine done(result: &mut Allocation) { }
}
