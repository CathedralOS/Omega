// Private decimal token reader. Reject overflow before multiplying; at most
// 256 input bytes and 51 tokens, so malformed input cannot grow storage.
use omega\language\core\StandardInput;
use system\ByteRead;
use system\Console;
public data Tokens {
    values: [i32; 51] in Saturating;
    count: i32 in Saturating;
    value: i32 in Saturating;
    bytes: i32 in Saturating;
    digits: bool;
    valid: bool;
}
public machine tokens_read(tokens: @mutable Tokens)
reaches StandardInput
invokes Console
blocks
crashes Trap
{
    tokens.valid = true;
    transition { _ -> scan(tokens) }
    machine scan(tokens: @mutable Tokens) {
        transition tokens.bytes < 256 {
            true -> pull(tokens),
            _ -> reject(tokens)
        }
    }
    machine pull(tokens: @mutable Tokens) {
        let observed: ByteRead = block Console::read_byte();
        tokens.bytes = tokens.bytes + 1;
        transition observed {
            ByteRead::Error -> reject(tokens),
            ByteRead::Eof -> finish(tokens),
            ByteRead::Byte { value } -> classify(tokens, value)
        }
    }
    machine classify(tokens: @mutable Tokens, byte: i32) {
        transition byte >= 48 && byte <= 57 {
            true -> digit(tokens, byte),
            _ -> separator(tokens, byte)
        }
    }
    machine digit(tokens: @mutable Tokens, byte: i32) {
        transition tokens.value < 100 {
            true -> accumulate(tokens, byte),
            _ -> reject(tokens)
        }
    }
    machine accumulate(tokens: @mutable Tokens, byte: i32) {
        tokens.value = tokens.value * 10 + (byte as +Saturating) - 48;
        tokens.digits = true;
        transition { _ -> scan(tokens) }
    }
    machine separator(tokens: @mutable Tokens, byte: i32) {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> flush(tokens),
            _ -> reject(tokens)
        }
    }
    machine flush(tokens: @mutable Tokens) {
        transition tokens.digits {
            true -> capacity(tokens),
            _ -> scan(tokens)
        }
    }
    machine capacity(tokens: @mutable Tokens) {
        transition tokens.count >= 0 && tokens.count < 51 {
            true -> store(tokens),
            _ -> reject(tokens)
        }
    }
    machine store(tokens: @mutable Tokens) {
        tokens.values[tokens.count] = tokens.value;
        tokens.count = tokens.count + 1;
        tokens.value = 0;
        tokens.digits = false;
        transition { _ -> scan(tokens) }
    }
    machine finish(tokens: @mutable Tokens) {
        transition tokens.digits {
            true -> final_capacity(tokens),
            _ -> done(tokens)
        }
    }
    machine final_capacity(tokens: @mutable Tokens) {
        transition tokens.count >= 0 && tokens.count < 51 {
            true -> final_store(tokens),
            _ -> reject(tokens)
        }
    }
    machine final_store(tokens: @mutable Tokens) {
        tokens.values[tokens.count] = tokens.value;
        tokens.count = tokens.count + 1;
    }
    machine done(tokens: @mutable Tokens) { }
    machine reject(tokens: @mutable Tokens) { tokens.valid = false; }
}
public machine at(tokens: @Tokens, index: i32 in Saturating) -> i32 in Saturating {
    transition index >= 0 && index < 51 {
        true -> read(tokens, index),
        _ -> (-1)
    }
    machine read(tokens: @Tokens, index: i32 in Saturating) -> i32 in Saturating
    requires index >= 0 && index < 51
    { tokens.values[index] }
}
