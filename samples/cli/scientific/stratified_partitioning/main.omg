use data/dataset/dataset.omg;
use input/parser/parser.omg;
use partition/allocation/allocation.omg;
use partition/audit/audit.omg;
use report/output/output.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

data Main {
    tokens: |parser|::Tokens;
    data: |dataset|::Dataset;
    allocation: |allocation|::Allocation;
    audit: |audit|::Audit;
}
machine main(context: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    block |parser|::tokens_read(@mutable context.tokens);
    |dataset|::load(@mutable context.data, @context.tokens);
    transition context.data.valid {
        true -> solve(context),
        _ -> invalid(context)
    }
    machine solve(context: @mutable Main) {
        |allocation|::allocation_solve(@mutable context.allocation, @context.data);
        transition context.allocation.found {
            true -> audit(context),
            _ -> infeasible(context)
        }
    }
    machine audit(context: @mutable Main) {
        |audit|::check(@mutable context.audit, @context.data, @context.allocation);
        transition context.audit.valid {
            true -> output(context),
            _ -> corrupt(context)
        }
    }
    machine corrupt(context: @mutable Main) {
        |console|::Console::write_line("ERROR audit_failed");
        |process_exit|::ProcessExit::exit_process(66);
    }
    machine output(context: @mutable Main) {
        |output|::report(@context.data, @context.allocation, @context.audit);
        |console|::Console::write("leakage "); |output|::number(context.audit.leakage); |console|::Console::write_line("");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(context: @mutable Main) {
        |console|::Console::write_line("ERROR invalid_input");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine infeasible(context: @mutable Main) {
        |console|::Console::write_line("ERROR indivisible_single_group");
        |process_exit|::ProcessExit::exit_process(65);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
