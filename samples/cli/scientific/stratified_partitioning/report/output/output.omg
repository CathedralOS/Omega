use data/dataset/dataset.omg;
use partition/allocation/allocation.omg;
use partition/audit/audit.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
public machine number(value: i32 in Saturating)
reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_byte(((value / 100) % 10 + 48) as i32);
    |console|::Console::write_byte(((value / 10) % 10 + 48) as i32);
    |console|::Console::write_byte((value % 10 + 48) as i32);
}
public machine report(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit)
reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write("mask "); number(result.mask); |console|::Console::write_line("");
    |console|::Console::write("train "); number(data.count - result.test_count);
    |console|::Console::write(" test "); number(result.test_count); |console|::Console::write_line("");
    |console|::Console::write("score "); number(result.score);
    |console|::Console::write(" total_error "); number(result.total_error); |console|::Console::write_line("");
    transition { _ -> rows(data, result, audit, 1) }
    // Canonical output sorted by record ID, independent of input order.
    machine rows(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit, id: i32 in Saturating) {
        transition id <= 99 {
            true -> find(data, result, audit, id, 0),
            _ -> metrics(data, result, audit)
        }
    }
    machine find(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit, id: i32 in Saturating, index: i32 in Saturating) {
        transition index < data.count && index >= 0 && index < 16 {
            true -> match_id(data, result, audit, id, index),
            _ -> rows(data, result, audit, id + 1)
        }
    }
    machine match_id(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit, id: i32 in Saturating, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        transition data.records[index].id == id {
            true -> assignment(data, result, audit, id, index),
            _ -> find(data, result, audit, id, index + 1)
        }
    }
    machine assignment(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit, id: i32 in Saturating, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        |console|::Console::write("id "); number(id);
        |console|::Console::write(" group "); number(data.records[index].group);
        let included: bool = audit.assignments[index] == 1;
        transition included {
            true -> test(data, result, audit, id),
            _ -> train(data, result, audit, id)
        }
    }
    machine test(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit, id: i32 in Saturating) {
        |console|::Console::write_line(" test");
        transition { _ -> rows(data, result, audit, id + 1) }
    }
    machine train(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit, id: i32 in Saturating) {
        |console|::Console::write_line(" train");
        transition { _ -> rows(data, result, audit, id + 1) }
    }
    machine metrics(data: @|dataset|::Dataset, result: @|allocation|::Allocation, audit: @|audit|::Audit) {
        |console|::Console::write("stratum 001 total "); number(data.totals[0]);
        |console|::Console::write(" test "); number(result.counts[0]);
        |console|::Console::write(" error "); number(|allocation|::absolute(data.denominator * result.counts[0] - data.numerator * data.totals[0])); |console|::Console::write_line("");
        |console|::Console::write("stratum 002 total "); number(data.totals[1]);
        |console|::Console::write(" test "); number(result.counts[1]);
        |console|::Console::write(" error "); number(|allocation|::absolute(data.denominator * result.counts[1] - data.numerator * data.totals[1])); |console|::Console::write_line("");
        |console|::Console::write("stratum 003 total "); number(data.totals[2]);
        |console|::Console::write(" test "); number(result.counts[2]);
        |console|::Console::write(" error "); number(|allocation|::absolute(data.denominator * result.counts[2] - data.numerator * data.totals[2])); |console|::Console::write_line("");
        transition result.score == 0 {
            true -> exact(),
            _ -> approximate()
        }
    }
    machine exact() { |console|::Console::write_line("balance exact"); }
    machine approximate() { |console|::Console::write_line("balance impossible_exact"); }
}
