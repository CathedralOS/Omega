use data/fixtures/fixtures.omg;
use domain/model/model.omg;
use domain/report/report.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

// Select exactly one declared scenario with an ASCII digit then LF (or EOF).
// The application consumes at most three bytes and never silently truncates.
data Application {
    stage: |model|::Stage;
    selection: i32;
    previous_volume: f64;
    previous_pressure: f64;
    first_volume: f64;
    first_pressure: f64;
    expansion: f64;
    compression: f64;
    total: f64;
}

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput
crashes Trap
{
    let mutable application: Application;
    let input: |console|::ByteRead = block |console|::Console::read_byte();
    transition input {
        |console|::ByteRead::Byte { value } -> block select(@mutable application, value),
        _ -> invalid()
    }
    machine select(application: @mutable Application, value: i32) {
        transition value >= 48 && value <= 57 {
            true -> block delimiter(application, value),
            _ -> invalid()
        }
    }
    machine delimiter(application: @mutable Application, value: i32) {
        let wrapped: i32 in Wrapping = value as +Wrapping;
        application.selection = (wrapped - 48) as i32;
        let tail: |console|::ByteRead = block |console|::Console::read_byte();
        transition tail {
            |console|::ByteRead::Eof -> start(application),
            |console|::ByteRead::Byte { value: 10 } -> block finish_input(application),
            _ -> invalid()
        }
    }
    machine finish_input(application: @mutable Application) {
        let tail: |console|::ByteRead = block |console|::Console::read_byte();
        transition tail { |console|::ByteRead::Eof -> start(application), _ -> invalid() }
    }
    machine start(application: @mutable Application) {
        |console|::Console::write_line("piston_cycle_work: kPa,L,J; work by piston");
        |console|::Console::write_line("stage,point,volume,pressure");
        transition { _ -> stage(application, 0) }
    }
    machine stage(application: @mutable Application, index: u32) requires index <= 3 {
        |fixtures|::load(application.selection, index, @mutable application.stage);
        let valid: bool = |model|::evaluate(@mutable application.stage);
        transition valid { true -> boundary(application, index), _ -> invalid_stage() }
    }
    machine boundary(application: @mutable Application, index: u32) requires index <= 3 {
        transition index == 0 {
            true -> first(application, index),
            _ -> continuity(application, index)
        }
    }
    machine first(application: @mutable Application, index: u32) requires index <= 3 {
        application.first_volume = application.stage.volume;
        application.first_pressure = application.stage.pressure;
        transition { _ -> history(application, index) }
    }
    machine continuity(application: @mutable Application, index: u32) requires index <= 3 {
        transition |model|::near(application.previous_volume, application.stage.volume)
            && |model|::near(application.previous_pressure, application.stage.pressure) {
            true -> history(application, index),
            _ -> discontinuity()
        }
    }
    machine history(application: @mutable Application, index: u32) requires index <= 3 {
        row(index as i32, 0, application.stage.volume, application.stage.pressure);
        let volume: f64 = (application.stage.volume + application.stage.end_volume) / 2.0;
        transition application.stage.isochoric {
            true -> hold_middle(application, index, volume),
            _ -> model_middle(application, index, volume)
        }
    }
    machine hold_middle(application: @mutable Application, index: u32, volume: f64) requires index <= 3 {
        row(index as i32, 1, volume, (application.stage.pressure + application.stage.end_pressure) / 2.0);
        transition { _ -> endpoint(application, index) }
    }
    machine model_middle(application: @mutable Application, index: u32, volume: f64) requires index <= 3 {
        row(index as i32, 1, volume, |model|::pressure_at(@application.stage, volume));
        transition { _ -> endpoint(application, index) }
    }
    machine endpoint(application: @mutable Application, index: u32) requires index <= 3 {
        row(index as i32, 2, application.stage.end_volume, application.stage.end_pressure);
        |console|::Console::write("work,"); |report|::integer(index as i32); |console|::Console::write(",");
        |report|::number(application.stage.work); |console|::Console::write_line("");
        application.total = application.total + application.stage.work;
        application.previous_volume = application.stage.end_volume;
        application.previous_pressure = application.stage.end_pressure;
        transition application.stage.work >= 0.0 {
            true -> expansion(application, index),
            _ -> compression(application, index)
        }
    }
    machine expansion(application: @mutable Application, index: u32) requires index <= 3 {
        application.expansion = application.expansion + application.stage.work;
        transition { _ -> next(application, index) }
    }
    machine compression(application: @mutable Application, index: u32) requires index <= 3 {
        application.compression = application.compression + application.stage.work;
        transition { _ -> next(application, index) }
    }
    machine next(application: @mutable Application, index: u32) requires index <= 3 {
        let count: u32 = |fixtures|::count(application.selection);
        transition index + 1 < count && index < 3 {
            true -> stage(application, index + 1),
            _ -> balance(application)
        }
    }
    machine balance(application: @mutable Application) {
        |console|::Console::write("balance,"); |report|::number(application.expansion); |console|::Console::write(",");
        |report|::number(application.compression); |console|::Console::write(","); |report|::number(application.total);
        |console|::Console::write_line("");
        transition |model|::near(application.total, application.expansion + application.compression) {
            true -> closure(application),
            _ -> bad_balance()
        }
    }
    machine closure(application: @mutable Application) {
        transition application.selection == 0 || application.selection == 1 {
            true -> closed(application),
            _ -> open()
        }
    }
    machine closed(application: @mutable Application) {
        transition |model|::near(application.previous_volume, application.first_volume)
            && |model|::near(application.previous_pressure, application.first_pressure) {
            true -> complete(),
            _ -> bad_balance()
        }
    }
    machine complete() { |console|::Console::write_line("closed_cycle"); |process_exit|::ProcessExit::exit_process(0); }
    machine open() { |console|::Console::write_line("open_stage"); |process_exit|::ProcessExit::exit_process(0); }
    machine invalid() { |console|::Console::write_line("invalid_input"); |process_exit|::ProcessExit::exit_process(64); }
    machine invalid_stage() { |console|::Console::write_line("invalid_stage"); |process_exit|::ProcessExit::exit_process(65); }
    machine discontinuity() { |console|::Console::write_line("discontinuous_boundary"); |process_exit|::ProcessExit::exit_process(66); }
    machine bad_balance() { |console|::Console::write_line("invalid_cycle_balance"); |process_exit|::ProcessExit::exit_process(67); }
}

machine row(stage: i32, point: i32, volume: f64, pressure: f64) reaches |process_authority|::StandardOutput
crashes Trap
{
    |report|::integer(stage); |console|::Console::write(","); |report|::integer(point); |console|::Console::write(",");
    |report|::number(volume); |console|::Console::write(","); |report|::number(pressure); |console|::Console::write_line("");
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput
crashes Trap
{
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
