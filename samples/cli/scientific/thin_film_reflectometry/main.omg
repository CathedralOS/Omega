use domain/complex/complex.omg as complex_complex;
use domain/input/input.omg;
use domain/report/report.omg;
use {omega}/language/core/complex/complex.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/math.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0 with input.txt; malformed or out-of-domain stdin exits 10.
// Numerical output oracle: fixtures.json (both engines).

data Application {
    reader: |input|::Reader;
    indices: [f64; 8]; thicknesses: [f64; 8]; wavelengths: [f64; 32];
    ambient: f64; substrate: f64; layers: i32 in Wrapping; count: i32 in Wrapping;
    index: i32 in Wrapping; layer: i32 in Wrapping;
    // Characteristic matrix [[a, i*b], [i*c, d]], mapping right face to left.
    a: f64; b: f64; c: f64; d: f64;
    minimum: f64; minimum_wavelength: f64;
}
machine main(application: @mutable Application) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let ambient: |input|::Number = block |input|::number(@mutable application.reader);
    let substrate: |input|::Number = block |input|::number(@mutable application.reader);
    let layers: |input|::Number = block |input|::number(@mutable application.reader);
    let count: |input|::Number = block |input|::number(@mutable application.reader);
    transition ambient.valid && substrate.valid && layers.valid && count.valid {
        true -> block options(application, ambient.value, substrate.value, layers.value, count.value),
        _ -> invalid(application)
    }
    machine invalid(application: @mutable Application) { |console|::Console::write_line("ERROR input or domain"); |process_exit|::ProcessExit::exit_process(10); }
    machine options(application: @mutable Application, ambient: f64, substrate: f64, layers: f64, count: f64) {
        let layer_integer: i32 in Saturating = |float_operations|::I32::from_f64(layers);
        let count_integer: i32 in Saturating = |float_operations|::I32::from_f64(count);
        transition ambient >= 1.0 && ambient <= 4.0 && substrate >= 1.0 && substrate <= 4.0 && layers >= 0.0 && layers <= 8.0 && count >= 1.0 && count <= 32.0 && layers == |float_operations|::F64::from_i32(layer_integer as i32) && count == |float_operations|::F64::from_i32(count_integer as i32) {
            true -> block configure(application, ambient, substrate, layer_integer as -Saturating +Wrapping, count_integer as -Saturating +Wrapping),
            _ -> invalid(application)
        }
    }
    machine configure(application: @mutable Application, ambient: f64, substrate: f64, layers: i32 in Wrapping, count: i32 in Wrapping) {
        application.ambient = ambient; application.substrate = substrate;
        application.layers = layers; application.count = count; application.index = 0;
        transition { _ -> block read_layer(application) }
    }
    machine read_layer(application: @mutable Application) {
        transition application.index >= 0 && application.index < application.layers && application.index < 8 { true -> block layer_tokens(application), _ -> block start_wavelengths(application) }
    }
    machine layer_tokens(application: @mutable Application) {
        let index: |input|::Number = block |input|::number(@mutable application.reader);
        let thickness: |input|::Number = block |input|::number(@mutable application.reader);
        transition index.valid && thickness.valid && index.value >= 1.0 && index.value <= 4.0 && thickness.value >= 0.0 && thickness.value <= 2000.0 {
            true -> block store_layer(application, index.value, thickness.value),
            _ -> invalid(application)
        }
    }
    machine store_layer(application: @mutable Application, index: f64, thickness: f64) {
        application.indices[application.index] = index; application.thicknesses[application.index] = thickness;
        application.index = application.index + 1;
        transition { _ -> block read_layer(application) }
    }
    machine start_wavelengths(application: @mutable Application) { application.index = 0; transition { _ -> block read_wavelength(application) } }
    machine read_wavelength(application: @mutable Application) {
        transition application.index >= 0 && application.index < application.count && application.index < 32 { true -> block wavelength_token(application), _ -> block finish_input(application) }
    }
    machine wavelength_token(application: @mutable Application) {
        let wavelength: |input|::Number = block |input|::number(@mutable application.reader);
        transition wavelength.valid && wavelength.value >= 200.0 && wavelength.value <= 2000.0 { true -> block store_wavelength(application, wavelength.value), _ -> invalid(application) }
    }
    machine store_wavelength(application: @mutable Application, wavelength: f64) {
        application.wavelengths[application.index] = wavelength; application.index = application.index + 1;
        transition { _ -> block read_wavelength(application) }
    }
    machine finish_input(application: @mutable Application) {
        let complete: bool = block |input|::ended(@mutable application.reader);
        transition complete { true -> initialize(application), _ -> invalid(application) }
    }
    machine initialize(application: @mutable Application) {
        application.index = 0; application.minimum = 2.0; application.minimum_wavelength = 0.0;
        transition { _ -> wavelength(application) }
    }
    machine wavelength(application: @mutable Application) {
        transition application.index >= 0 && application.index < application.count && application.index < 32 { true -> identity(application), _ -> done(application) }
    }
    machine identity(application: @mutable Application) {
        application.a = 1.0; application.b = 0.0; application.c = 0.0; application.d = 1.0; application.layer = 0;
        transition { _ -> multiply(application) }
    }
    machine multiply(application: @mutable Application) {
        transition application.layer >= 0 && application.layer < application.layers && application.layer < 8 { true -> matrix(application), _ -> amplitudes(application) }
    }
    machine matrix(application: @mutable Application) {
        let index: f64 = application.indices[application.layer];
        let phase: f64 = 6.283185307179586 * index * application.thicknesses[application.layer] / application.wavelengths[application.index];
        let cosine: f64 = |math|::cos(phase); let sine: f64 = |math|::sin(phase);
        let a: f64 = application.a * cosine + application.b * index * sine;
        let b: f64 = -application.a * sine / index + application.b * cosine;
        let c: f64 = application.c * cosine - application.d * index * sine;
        let d: f64 = application.c * sine / index + application.d * cosine;
        application.a = a; application.b = b; application.c = c; application.d = d;
        application.layer = application.layer + 1;
        transition { _ -> multiply(application) }
    }
    machine amplitudes(application: @mutable Application) {
        let denominator_real: f64 = application.ambient * application.a + application.substrate * application.d;
        let denominator_imaginary: f64 = application.ambient * application.substrate * application.b + application.c;
        let numerator_real: f64 = application.ambient * application.a - application.substrate * application.d;
        let numerator_imaginary: f64 = application.ambient * application.substrate * application.b - application.c;
        let denominator: |complex|::Complex<f64> = |complex|::Complex { real: denominator_real, imaginary: denominator_imaginary };
        let reflection: |complex|::Complex<f64> = |complex_complex|::quotient::<f64, |complex_complex|::Double>(
            |complex|::Complex { real: numerator_real, imaginary: numerator_imaginary }, denominator);
        let transmission: |complex|::Complex<f64> = |complex_complex|::quotient::<f64, |complex_complex|::Double>(
            |complex|::Complex { real: 2.0 * application.ambient, imaginary: 0.0 }, denominator);
        let reflection_real: f64 = reflection.real;
        let reflection_imaginary: f64 = reflection.imaginary;
        let transmission_real: f64 = transmission.real;
        let transmission_imaginary: f64 = transmission.imaginary;
        let reflectance: f64 = |complex_complex|::norm::<f64, |complex_complex|::Double>(reflection);
        let transmittance: f64 = application.substrate / application.ambient * |complex_complex|::norm::<f64, |complex_complex|::Double>(transmission);
        |report|::field(@mutable application.reader, "wavelength_pico_nm=", application.wavelengths[application.index] * 1000000000000.0);
        |report|::field(@mutable application.reader, "r_real_pico=", reflection_real * 1000000000000.0);
        |report|::field(@mutable application.reader, "r_imaginary_pico=", reflection_imaginary * 1000000000000.0);
        |report|::field(@mutable application.reader, "t_real_pico=", transmission_real * 1000000000000.0);
        |report|::field(@mutable application.reader, "t_imaginary_pico=", transmission_imaginary * 1000000000000.0);
        |report|::field(@mutable application.reader, "R_pico=", reflectance * 1000000000000.0);
        |report|::field(@mutable application.reader, "T_pico=", transmittance * 1000000000000.0);
        transition reflectance < application.minimum { true -> minimum(application, reflectance), _ -> next(application) }
    }
    machine minimum(application: @mutable Application, reflectance: f64) {
        application.minimum = reflectance; application.minimum_wavelength = application.wavelengths[application.index];
        transition { _ -> next(application) }
    }
    machine next(application: @mutable Application) { application.index = application.index + 1; transition { _ -> wavelength(application) } }
    machine done(application: @mutable Application) {
        |report|::field(@mutable application.reader, "minimum_R_pico=", application.minimum * 1000000000000.0);
        |report|::field(@mutable application.reader, "minimum_wavelength_pico_nm=", application.minimum_wavelength * 1000000000000.0);
        |process_exit|::ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let mutable entry_storage: Application;
    block main(@mutable entry_storage);
}
