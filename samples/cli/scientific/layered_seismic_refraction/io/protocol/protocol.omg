use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
public data Protocol {
 fields: [f64; 25]; numerators: [f64; 25]; scales: [f64; 25]; position: i32 in Wrapping;
 length: i32 in Wrapping; accumulator: f64; scale: f64;
 decimal: bool; digits: i32 in Wrapping; started: bool;
}
// EOF is the record boundary; every byte, token and digit has a hard bound.
public machine read(protocol: @mutable Protocol) -> bool
reaches |process_authority|::StandardInput blocks crashes Trap {
 protocol.position = 0; protocol.length = 0; protocol.accumulator = 0.0;
 protocol.scale = 1.0; protocol.decimal = false; protocol.digits = 0; protocol.started = false;
 transition { _ -> scan(protocol) }
 machine scan(protocol: @mutable Protocol) -> bool {
  transition protocol.length < 1024 { true -> observe(protocol), false -> rejected() }
 }
 machine observe(protocol: @mutable Protocol) -> bool {
  let observed: |console|::ByteRead = block |console|::Console::read_byte();
  protocol.length = protocol.length + 1;
  transition observed { |console|::ByteRead::Error -> rejected(), |console|::ByteRead::Eof -> commit(protocol, true), |console|::ByteRead::Byte { value } -> character(protocol, value) }
 }
 machine character(protocol: @mutable Protocol, value: i32) -> bool {
  transition value >= 48 && value <= 57 { true -> digit(protocol, value), false -> punctuation(protocol, value) }
 }
 machine digit(protocol: @mutable Protocol, value: i32) -> bool {
  transition protocol.digits < 12 { true -> accumulate(protocol, value), false -> rejected() }
 }
 machine accumulate(protocol: @mutable Protocol, value: i32) -> bool {
  let character: i32 in Wrapping = value as i32 +Wrapping;
  let digit: f64 = (character - 48) as f64;
  protocol.accumulator = protocol.accumulator * 10.0 + digit;
  protocol.digits = protocol.digits + 1; protocol.started = true;
  transition protocol.decimal { true -> fractional(protocol), false -> scan(protocol) }
 }
 machine fractional(protocol: @mutable Protocol) -> bool {
  protocol.scale = protocol.scale * 10.0;
  transition { _ -> scan(protocol) }
 }
 machine punctuation(protocol: @mutable Protocol, value: i32) -> bool {
  transition value == 46 && !protocol.decimal { true -> decimal(protocol), false -> whitespace(protocol, value) }
 }
 machine decimal(protocol: @mutable Protocol) -> bool {
  protocol.decimal = true; protocol.started = true;
  transition { _ -> scan(protocol) }
 }
 machine whitespace(protocol: @mutable Protocol, value: i32) -> bool {
  transition value == 32 || value == 9 || value == 10 || value == 13 { true -> commit(protocol, false), false -> rejected() }
 }
 machine commit(protocol: @mutable Protocol, final: bool) -> bool {
  transition protocol.digits > 0 { true -> guard(protocol, final), false -> empty(protocol, final) }
 }
 machine empty(protocol: @mutable Protocol, final: bool) -> bool {
  transition protocol.started { true -> rejected(), false -> after(protocol, final) }
 }
 machine guard(protocol: @mutable Protocol, final: bool) -> bool {
  transition protocol.position >= 0 && protocol.position < 25 { true -> store(protocol, final, protocol.position), false -> rejected() }
 }
 machine store(protocol: @mutable Protocol, final: bool, position: i32 in Wrapping) -> bool
 requires position >= 0 && position < 25 {
  protocol.fields[position] = protocol.accumulator / protocol.scale;
  protocol.numerators[position] = protocol.accumulator; protocol.scales[position] = protocol.scale;
  protocol.position = protocol.position + 1; protocol.accumulator = 0.0;
  protocol.scale = 1.0; protocol.decimal = false; protocol.started = false; protocol.digits = 0;
  transition { _ -> after(protocol, final) }
 }
 machine after(protocol: @mutable Protocol, final: bool) -> bool {
  transition final { true -> complete(), false -> scan(protocol) }
 }
 machine complete() -> bool { true }
 machine rejected() -> bool { false }
}

public machine integer(protocol: @mutable Protocol, value: i32 in Wrapping)
reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    transition value < 0 {
        true -> negative(protocol, value),
        false -> digits(protocol, value, 1000000000, false)
    }
    machine negative(protocol: @mutable Protocol, value: i32 in Wrapping) {
        |console|::Console::write_byte(45);
        transition { _ -> digits(protocol, 0 - value, 1000000000, false) }
    }
    machine digits(protocol: @mutable Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let digit: i32 in Wrapping = value / divisor;
        let remainder: i32 in Wrapping = value % divisor;
        transition digit != 0 || started || divisor == 1 {
            true -> emit(protocol, digit, remainder, divisor),
            false -> next(protocol, remainder, divisor, false)
        }
    }
    machine emit(protocol: @mutable Protocol, digit: i32 in Wrapping,
        remainder: i32 in Wrapping, divisor: i32 in Wrapping)
    requires divisor >= 1
    {
        |console|::Console::write_byte((digit + 48) as i32);
        transition { _ -> next(protocol, remainder, divisor, true) }
    }
    machine next(protocol: @mutable Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        transition divisor > 1 {
            true -> divide(protocol, value, divisor, started),
            false -> done()
        }
    }
    machine divide(protocol: @mutable Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let next_divisor: i32 in Wrapping = divisor / 10;
        transition next_divisor >= 1 {
            true -> digits(protocol, value, next_divisor, started),
            false -> done()
        }
    }
    machine done() { }
}

// Nine significant decimal digits as signed integer mantissa and power of ten.
// All model outputs are finite, and normalization precedes the trapping cast.
public machine number(protocol: @mutable Protocol, value: f64)
reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    transition value == 0.0 {
        true -> zero(protocol),
        false -> sign(protocol, value)
    }
    machine zero(protocol: @mutable Protocol) { |console|::Console::write("0"); }
    machine sign(protocol: @mutable Protocol, value: f64) {
        transition value < 0.0 {
            true -> negative(protocol, value),
            false -> normalize(protocol, value, 0)
        }
    }
    machine negative(protocol: @mutable Protocol, value: f64) {
        |console|::Console::write_byte(45);
        transition { _ -> normalize(protocol, 0.0 - value, 0) }
    }
    machine normalize(protocol: @mutable Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value >= 10.0 {
            true -> normalize(protocol, value / 10.0, exponent + 1),
            false -> small(protocol, value, exponent)
        }
    }
    machine small(protocol: @mutable Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value < 1.0 {
            true -> normalize(protocol, value * 10.0, exponent - 1),
            false -> emit(protocol, value, exponent)
        }
    }
    machine emit(protocol: @mutable Protocol, value: f64, exponent: i32 in Wrapping) {
        let scaled: f64 = value * 100000000.0;
        transition scaled == scaled && scaled >= 0.0 && scaled < 1000000000.0 {
            true -> land(protocol, scaled, exponent),
            false -> invalid(protocol)
        }
    }
    machine land(protocol: @mutable Protocol, scaled: f64, exponent: i32 in Wrapping)
    requires scaled == scaled && scaled >= 0.0 && scaled < 1000000000.0
    {
        let mantissa: i32 = |float_operations|::I32::from_f64(scaled);
        integer(protocol, mantissa as +Wrapping);
        |console|::Console::write("e");
        integer(protocol, exponent - 8);
    }
    machine invalid(protocol: @mutable Protocol) {
        |console|::Console::write_line("ERROR numeric: reporting value outside finite model envelope");
        |process_exit|::ProcessExit::exit_process(66);
    }
}
