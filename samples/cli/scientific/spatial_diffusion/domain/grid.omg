module domain::grid;
use omega::language::core::float_operations;

// Scalar observations are captured before forwarding exclusive grid loans;
// argument evaluation is left to right, including internal jumps.
// Cell-centred finite volumes for -div(k grad u)+reaction*u=f on [0,1]^2.
// Dirichlet faces are eliminated with half-cell distance, preserving symmetry.
// Neumann values mean outward normal derivative, not inward derivative or flux.
// Positive k, nonnegative reaction and at least one Dirichlet side establish
// SPD: sums of edge differences, positive anchored face terms, and reaction.
// Pure Neumann is deliberately rejected, including compatible singular data.
public data Grid {
 n: u64 in Saturating;
 count: u64 in Saturating;
 diffusion: f64;
 reaction: f64;
 kind: [i32; 4];
 boundary_count: u64;
 linear: bool;
 maximum: u64 in Saturating;
 tolerance: f64;
 offsets: [u64; 145];
 columns: [u64; 720];
 values: [f64; 720];
 nonzeros: u64 in Saturating;
 right: [f64; 144];
 solution: [f64; 144];
 residual: [f64; 144];
 direction: [f64; 144];
 image: [f64; 144];
 iterations: u64 in Saturating;
 norm: f64;
 threshold: f64;
 squares: f64;
 curvature: f64;
 error: f64;
}
public machine finite(value: f64) -> bool { value-value == 0.0 }
public machine magnitude(value: f64) -> f64 {
 transition value < 0.0 { true -> (0.0-value) false -> value }
}
public machine exact(linear: bool, horizontal: f64, vertical: f64) -> f64 {
 transition linear { true -> (horizontal+2.0*vertical) false -> (horizontal*horizontal+vertical*vertical) }
}
public machine valid(grid: &Grid) -> bool {
 finite(grid.diffusion) && grid.diffusion > 0.0 && grid.diffusion <= 100.0
 && finite(grid.reaction) && grid.reaction >= 0.0 && grid.reaction <= 100.0
 && grid.n >= 2 && grid.n <= 12 && grid.boundary_count == 4
 && grid.kind[0] >= 0 && grid.kind[0] <= 1
 && grid.kind[1] >= 0 && grid.kind[1] <= 1
 && grid.kind[2] >= 0 && grid.kind[2] <= 1
 && grid.kind[3] >= 0 && grid.kind[3] <= 1
 && (grid.kind[0] == 0 || grid.kind[1] == 0 || grid.kind[2] == 0 || grid.kind[3] == 0)
 && finite(grid.tolerance) && grid.tolerance > 0.0 && grid.tolerance <= 0.01
 && grid.maximum <= 400
}
// Named integer-to-float conversions make rounding explicit. All mesh indices
// in accepted grids are <=144, so these particular conversions are exact.
// Every row has at most five entries; 720 slots cover the 144-row bound.
machine append(grid: &mut Grid, column: u64, value: f64) {
 grid.columns[grid.nonzeros % 720] = column;
 grid.values[grid.nonzeros % 720] = value;
 grid.nonzeros = grid.nonzeros + 1;
}
machine boundary(grid: &mut Grid, row: u64, side: u64, horizontal: f64, vertical: f64, coefficient: f64) -> f64 {
 transition grid.kind[side % 4] == 0 {
  true -> dirichlet(grid, row, horizontal, vertical, coefficient)
  false -> neumann(grid, row, side)
 }
 machine dirichlet(grid: &mut Grid, row: u64, horizontal: f64, vertical: f64, coefficient: f64) -> f64 {
  grid.right[row % 144] = grid.right[row % 144] + 2.0*coefficient*exact(grid.linear,horizontal,vertical);
  2.0*coefficient
 }
 machine neumann(grid: &mut Grid, row: u64, side: u64) -> f64 {
  transition grid.linear { true -> flux(grid,row,side) false -> quadratic_flux(grid,row,side) }
 }
 machine flux(grid: &mut Grid, row: u64, side: u64) -> f64 {
  transition side { 0 -> west(grid,row) 1 -> east(grid,row) 2 -> south(grid,row) _ -> north(grid,row) }
 }
 machine quadratic_flux(grid: &mut Grid, row: u64, side: u64) -> f64 {
  transition side { 1 -> north(grid,row) 3 -> north(grid,row) _ -> 0.0 }
 }
 machine west(grid: &mut Grid,row:u64) -> f64 { grid.right[row%144]=grid.right[row%144]-grid.diffusion*F64::from_u64(grid.n as u64); 0.0 }
 machine east(grid: &mut Grid,row:u64) -> f64 { grid.right[row%144]=grid.right[row%144]+grid.diffusion*F64::from_u64(grid.n as u64); 0.0 }
 machine south(grid: &mut Grid,row:u64) -> f64 { grid.right[row%144]=grid.right[row%144]-2.0*grid.diffusion*F64::from_u64(grid.n as u64); 0.0 }
 machine north(grid: &mut Grid,row:u64) -> f64 { grid.right[row%144]=grid.right[row%144]+2.0*grid.diffusion*F64::from_u64(grid.n as u64); 0.0 }
}
public machine assemble(grid: &mut Grid) {
 transition valid(grid) { true -> start(grid) false -> invalid(grid) }
 machine invalid(grid:&mut Grid) { grid.count=0; grid.nonzeros=0; }
 machine start(grid:&mut Grid) {
 grid.count=grid.n*grid.n;
 grid.nonzeros=0;
 transition { _ -> row(grid,0) }
 }
 machine row(grid: &mut Grid, index:u64 in Saturating) {
  transition index < grid.count && grid.n > 0 { true -> initialize(grid,index) false -> finish(grid) }
 }
 machine initialize(grid: &mut Grid,index:u64 in Saturating) requires grid.n > 0 {
  let horizontal:u64 in Saturating=index%grid.n;
  let vertical:u64 in Saturating=index/grid.n;
  let x:f64=(F64::from_u64(horizontal as u64)+0.5)/F64::from_u64(grid.n as u64);
  let y:f64=(F64::from_u64(vertical as u64)+0.5)/F64::from_u64(grid.n as u64);
  grid.offsets[index%145]=grid.nonzeros as u64;
  grid.right[index%144]=grid.reaction*exact(grid.linear,x,y);
  let reaction:f64=grid.reaction;
  transition grid.linear { true -> west(grid,index,horizontal,vertical,x,y,reaction) false -> forcing(grid,index,horizontal,vertical,x,y) }
 }
 machine forcing(grid:&mut Grid,index:u64 in Saturating,horizontal:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64) {
  grid.right[index%144]=grid.right[index%144]-4.0*grid.diffusion;
  let reaction:f64=grid.reaction;
  transition { _ -> west(grid,index,horizontal,vertical,x,y,reaction) }
 }
 machine west(grid:&mut Grid,index:u64 in Saturating,horizontal:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64) {
  let coefficient:f64=grid.diffusion*F64::from_u64(grid.n as u64)*F64::from_u64(grid.n as u64);
  transition horizontal > 0 { true -> west_inside(grid,index,horizontal,vertical,x,y,diagonal,coefficient) false -> west_face(grid,index,horizontal,vertical,x,y,diagonal,coefficient) }
 }
 machine west_inside(grid:&mut Grid,index:u64 in Saturating,horizontal:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  append(grid,(index-1) as u64,0.0-coefficient);
  transition { _ -> east(grid,index,horizontal,vertical,x,y,diagonal+coefficient,coefficient) }
 }
 machine west_face(grid:&mut Grid,index:u64 in Saturating,horizontal:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  let addition:f64=boundary(grid,index as u64,0,0.0,y,coefficient);
  transition { _ -> east(grid,index,horizontal,vertical,x,y,diagonal+addition,coefficient) }
 }
 machine east(grid:&mut Grid,index:u64 in Saturating,horizontal:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  transition horizontal+1 < grid.n { true -> east_inside(grid,index,vertical,x,y,diagonal,coefficient) false -> east_face(grid,index,vertical,x,y,diagonal,coefficient) }
 }
 machine east_inside(grid:&mut Grid,index:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  append(grid,(index+1) as u64,0.0-coefficient);
  transition { _ -> south(grid,index,vertical,x,y,diagonal+coefficient,coefficient) }
 }
 machine east_face(grid:&mut Grid,index:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  let addition:f64=boundary(grid,index as u64,1,1.0,y,coefficient);
  transition { _ -> south(grid,index,vertical,x,y,diagonal+addition,coefficient) }
 }
 machine south(grid:&mut Grid,index:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  transition vertical > 0 { true -> south_inside(grid,index,vertical,x,y,diagonal,coefficient) false -> south_face(grid,index,vertical,x,y,diagonal,coefficient) }
 }
 machine south_inside(grid:&mut Grid,index:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  let column:u64=(index-grid.n) as u64;
  append(grid,column,0.0-coefficient);
  transition { _ -> north(grid,index,vertical,x,y,diagonal+coefficient,coefficient) }
 }
 machine south_face(grid:&mut Grid,index:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  let addition:f64=boundary(grid,index as u64,2,x,0.0,coefficient);
  transition { _ -> north(grid,index,vertical,x,y,diagonal+addition,coefficient) }
 }
 machine north(grid:&mut Grid,index:u64 in Saturating,vertical:u64 in Saturating,x:f64,y:f64,diagonal:f64,coefficient:f64) {
  transition vertical+1 < grid.n { true -> north_inside(grid,index,diagonal,coefficient) false -> north_face(grid,index,x,diagonal,coefficient) }
 }
 machine north_inside(grid:&mut Grid,index:u64 in Saturating,diagonal:f64,coefficient:f64) {
  let column:u64=(index+grid.n) as u64;
  append(grid,column,0.0-coefficient);
  transition { _ -> diagonal_entry(grid,index,diagonal+coefficient) }
 }
 machine north_face(grid:&mut Grid,index:u64 in Saturating,x:f64,diagonal:f64,coefficient:f64) {
  let addition:f64=boundary(grid,index as u64,3,x,1.0,coefficient);
  transition { _ -> diagonal_entry(grid,index,diagonal+addition) }
 }
 machine diagonal_entry(grid:&mut Grid,index:u64 in Saturating,diagonal:f64) {
  append(grid,index as u64,diagonal);
  transition { _ -> row(grid,index+1) }
 }
 machine finish(grid:&mut Grid) { grid.offsets[grid.count%145]=grid.nonzeros as u64; }
}
