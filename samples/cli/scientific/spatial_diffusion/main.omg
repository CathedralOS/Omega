use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Expected exit: 0 with input.txt (one byte 0). Empty stdin exits 64.
// Expected output contains: CONVERGED
// A transition dispatch covers its subject. The converged residual takes the
// true arm; the false arm continues to the iteration limit. The next statement
// is not a fallback.
// SCI04: bounded 2D finite-volume diffusion/Poisson with explicit CSR and CG.
use system\ByteRead;
use system\Console;
use omega\language\core\I64::from_f64;
use domain\grid;
use domain\solver;
use platform\decimal;
use platform\decimal\number;

machine field(value:f64) reaches ProcessExit + StandardOutput invokes Console {
 let scaled:f64=value*1000000000000.0;
 transition scaled == scaled && scaled >= -900000000000000000.0 && scaled <= 900000000000000000.0 {
  true -> emit(scaled), false -> failure()
 }
 machine emit(scaled:f64) requires scaled == scaled && scaled >= -900000000000000000.0 && scaled <= 900000000000000000.0 {
  let integer:i64=I64::from_f64(scaled);
  number(integer as +Wrapping);
 }
 machine failure() { Console::write_line("REJECT numeric output"); ProcessExit::exit_process(70); }
}
machine count(value:u64 in Saturating) reaches ProcessExit + StandardOutput invokes Console {
 transition value <= 1000 { true -> bounded(value), false -> failure() }
 machine bounded(value:u64 in Saturating) requires value <= 1000 { number(value as i64 +Wrapping); }
 machine failure() { Console::write_line("REJECT report count"); ProcessExit::exit_process(70); }
}
data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput invokes Console {
 let request:ByteRead=block Console::read_byte();
 transition request { ByteRead::Byte { value } -> block ending(value), _ -> input_error() }
 machine ending(value:i32) {
  let tail:ByteRead=block Console::read_byte();
  transition tail { ByteRead::Eof -> setup(value), _ -> input_error() }
 }
 machine setup(value:i32) {
  let zero:f64=0.0;
  let one:f64=1.0;
  let mutable grid:domain\grid\Grid;
  grid.n=4;
  grid.diffusion=1.0;
  grid.reaction=0.0;
  grid.linear=false;
  grid.kind[0]=0; grid.kind[1]=0; grid.kind[2]=0; grid.kind[3]=0;
  grid.boundary_count=4;
  grid.maximum=400;
  grid.tolerance=0.0000000001;
  transition value {
   48 -> check(@mutable grid),
   49 -> eight(@mutable grid),
   50 -> twelve(@mutable grid),
   51 -> mixed(@mutable grid),
   52 -> reaction(@mutable grid),
   53 -> coefficient(@mutable grid,0.0),
   54 -> coefficient(@mutable grid,-1.0),
   55 -> malformed(@mutable grid),
   56 -> singular(@mutable grid),
   57 -> limited(@mutable grid,1),
   97 -> limited(@mutable grid,0),
   98 -> negative_reaction(@mutable grid),
   99 -> missing(@mutable grid),
   100 -> coefficient(@mutable grid,zero/zero),
   101 -> coefficient(@mutable grid,one/zero),
   102 -> bad_tolerance(@mutable grid),
   _ -> input_error()
  }
 }
 machine eight(grid:@mutable domain\grid\Grid) { grid.n=8; transition { _ -> check(grid) } }
 machine twelve(grid:@mutable domain\grid\Grid) { grid.n=12; transition { _ -> check(grid) } }
 machine mixed(grid:@mutable domain\grid\Grid) { grid.n=8; grid.linear=true; grid.kind[1]=1; grid.kind[2]=1; grid.kind[3]=1; transition { _ -> check(grid) } }
 machine reaction(grid:@mutable domain\grid\Grid) { grid.n=8; grid.diffusion=2.0; grid.reaction=3.0; transition { _ -> check(grid) } }
 machine coefficient(grid:@mutable domain\grid\Grid,value:f64) { grid.diffusion=value; transition { _ -> check(grid) } }
 machine malformed(grid:@mutable domain\grid\Grid) { grid.kind[2]=9; transition { _ -> check(grid) } }
 machine singular(grid:@mutable domain\grid\Grid) { grid.kind[0]=1; grid.kind[1]=1; grid.kind[2]=1; grid.kind[3]=1; transition { _ -> check(grid) } }
 machine limited(grid:@mutable domain\grid\Grid,maximum:u64 in Saturating) { grid.maximum=maximum; transition { _ -> check(grid) } }
 machine negative_reaction(grid:@mutable domain\grid\Grid) { grid.reaction=-1.0; transition { _ -> check(grid) } }
 machine missing(grid:@mutable domain\grid\Grid) { grid.boundary_count=3; transition { _ -> check(grid) } }
 machine bad_tolerance(grid:@mutable domain\grid\Grid) { grid.tolerance=0.0; transition { _ -> check(grid) } }
 machine check(grid:@mutable domain\grid\Grid) {
  transition domain\grid\valid(grid) { true -> execute(grid), false -> invalid() }
 }
 machine execute(grid:@mutable domain\grid\Grid) {
  let status:i32=domain\solver\solve(grid);
  Console::write("GRID "); count(grid.n); count(grid.count); count(grid.nonzeros); Console::write_line("");
  Console::write("CG "); number(status as i64 +Wrapping); count(grid.iterations); field(grid.norm); field(grid.threshold); field(grid.error); Console::write_line("");
  transition { _ -> report(grid,status,0) }
 }
 machine report(grid:@domain\grid\Grid,status:i32,index:u64 in Saturating) {
  transition index < grid.count { true -> cell(grid,status,index), false -> finish(status) }
 }
 machine cell(grid:@domain\grid\Grid,status:i32,index:u64 in Saturating) {
  Console::write("CELL "); count(index); field(grid.solution[index%144]); Console::write_line("");
  transition { _ -> report(grid,status,index+1) }
 }
 machine finish(status:i32) { transition status { 0 -> success(), _ -> nonconvergence() } }
 machine success() { Console::write_line("CONVERGED"); ProcessExit::exit_process(0); }
 machine nonconvergence() { Console::write_line("NOT_CONVERGED"); ProcessExit::exit_process(2); }
 machine invalid() { Console::write_line("REJECT grid: positive finite diffusion, nonnegative reaction, four valid anchored boundaries, bounded mesh and controls required"); ProcessExit::exit_process(65); }
 machine input_error() { Console::write_line("REJECT input: expected exactly one byte 0..9 or a..f"); ProcessExit::exit_process(64); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput invokes Console {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
