use fixtures/fixtures.omg;
use graph/graph.omg;
use validation/validation.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0 (input: 2 0\n).
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable input: [u8; 8];
    let result: |console|::LineReadResult = block |console|::Console::read_line(@mutable input[..]);
    transition result {
        |console|::LineReadResult::LineComplete { count } -> length(main, @input, count),
        _ -> invalid(main)
    }
    machine length(main: @mutable Main, input: @[u8; 8], count: u64) {
        transition count == 4 {
            true -> parse(main, input),
            false -> invalid(main)
        }
    }
    machine parse(main: @mutable Main, input: @[u8; 8]) {
        transition input[0] >= 48 && input[0] <= 53 && input[1] == 32 &&
                   input[2] >= 48 && input[2] <= 49 && input[3] == 10 {
            true -> plan(main, (input[0] as i64 +Wrapping) - 48,
                         (input[2] as i32 +Wrapping) - 48),
            false -> invalid(main)
        }
    }
    machine plan(main: @mutable Main, radius: i64 in Wrapping, variant: i32 in Wrapping) {
        let mutable scene: |fixtures|::Scene;
        |fixtures|::load(@mutable scene, variant);
        |console|::Console::write_line("clearance_route_planner");
        |console|::Console::write("radius="); number(main, radius); |console|::Console::write_line("");
        |console|::Console::write("scene="); number(main, variant as -Wrapping as i64 +Wrapping); |console|::Console::write_line("");
        let start: i64 in Wrapping = |graph|::edge(@scene, 0, 0, radius);
        let goal: i64 in Wrapping = |graph|::edge(@scene, 1, 1, radius);
        transition start >= 0 && goal >= 0 {
            true -> search(main, @scene, radius),
            false -> blocked(main, @scene, radius, start)
        }
    }
    machine blocked(main: @mutable Main, scene: @|fixtures|::Scene, radius: i64 in Wrapping,
                  start: i64 in Wrapping) {
        transition start < 0 {
            true -> endpoint(main, scene, 0),
            false -> endpoint(main, scene, 1)
        }
    }
    machine endpoint(main: @mutable Main, scene: @|fixtures|::Scene, node: i32 in Wrapping)
    requires node >= 0 && node < 6
    {
        |console|::Console::write_line("status=endpoint_blocked");
        |console|::Console::write("node="); number(main, node as -Wrapping as i64 +Wrapping); |console|::Console::write_line("");
        |console|::Console::write("minimum_clearance_milli=");
        number(main, |graph|::edge(scene, node, node, 0)); |console|::Console::write_line("");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine search(main: @mutable Main, scene: @|fixtures|::Scene, radius: i64 in Wrapping) {
        let mutable planner: |graph|::Planner;
        |graph|::build(@mutable planner, scene, radius);
        let found: bool = |graph|::solve(@mutable planner);
        transition found {
            true -> certify(main, scene, radius, @planner),
            false -> infeasible(main, scene, radius, @planner)
        }
    }
    machine certify(main: @mutable Main, scene: @|fixtures|::Scene, radius: i64 in Wrapping,
                  planner: @|graph|::Planner) {
        let valid: bool = |validation|::route(scene, planner, radius);
        transition valid {
            true -> report(main, scene, planner),
            false -> failure(main)
        }
    }
    machine report(main: @mutable Main, scene: @|fixtures|::Scene, planner: @|graph|::Planner) {
        |console|::Console::write_line("status=route");
        |console|::Console::write("cost_milli="); number(main, planner.distances[1]); |console|::Console::write_line("");
        |console|::Console::write("minimum_clearance_milli="); number(main, planner.clearance); |console|::Console::write_line("");
        |console|::Console::write("coordinates=");
        transition { _ -> coordinates(main, scene, planner, planner.route_count - 1) }
    }
    machine coordinates(main: @mutable Main, scene: @|fixtures|::Scene, planner: @|graph|::Planner,
                      position: i32 in Wrapping) {
        transition position >= 0 && position < 6 {
            true -> coordinate_node(main, scene, planner, position, planner.route[position]),
            false -> finish(main)
        }
    }
    machine coordinate_node(main: @mutable Main, scene: @|fixtures|::Scene, planner: @|graph|::Planner,
                          position: i32 in Wrapping, node: i32 in Wrapping) {
        transition node >= 0 && node < 6 {
            true -> coordinate_emit(main, scene, planner, position, node),
            false -> failure(main)
        }
    }
    machine coordinate_emit(main: @mutable Main, scene: @|fixtures|::Scene, planner: @|graph|::Planner,
                          position: i32 in Wrapping, node: i32 in Wrapping)
    requires node >= 0 && node < 6
    {
        number(main, scene.x[node]); |console|::Console::write(","); number(main, scene.y[node]);
        transition position > 0 {
            true -> separator(main, scene, planner, position),
            false -> finish(main)
        }
    }
    machine separator(main: @mutable Main, scene: @|fixtures|::Scene, planner: @|graph|::Planner,
                    position: i32 in Wrapping) {
        |console|::Console::write(";");
        transition { _ -> coordinates(main, scene, planner, position - 1) }
    }
    machine finish(main: @mutable Main) {
        |console|::Console::write_line(""); |console|::Console::write_line("validated=1"); |process_exit|::ProcessExit::exit_process(0);
    }
    machine infeasible(main: @mutable Main, scene: @|fixtures|::Scene, radius: i64 in Wrapping,
                     planner: @|graph|::Planner) {
        let valid: bool = |validation|::cut(scene, planner, radius);
        transition valid {
            true -> witness(main, planner),
            false -> failure(main)
        }
    }
    machine witness(main: @mutable Main, planner: @|graph|::Planner) {
        |console|::Console::write_line("status=infeasible");
        |console|::Console::write("reachable_mask="); number(main, planner.witness as i64 +Wrapping);
        |console|::Console::write_line(""); |console|::Console::write_line("cut_validated=1"); |process_exit|::ProcessExit::exit_process(2);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("invalid_input: expected radius(0..5) space scene(0..1) LF");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine failure(main: @mutable Main) {
        |console|::Console::write_line("FAIL: planner certificate"); |process_exit|::ProcessExit::exit_process(1);
    }
}
machine number(main: @mutable Main, value: i64 in Wrapping) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    transition value >= 0 && value < 1000000 {
        true -> divisor(main, value, 1),
        false -> bad(main)
    }
    machine divisor(main: @mutable Main, value: i64 in Wrapping, scale: i64 in Wrapping) {
        transition scale > 0 && value / scale >= 10 {
            true -> divisor(main, value, scale * 10),
            false -> digit(main, value, scale)
        }
    }
    machine digit(main: @mutable Main, value: i64 in Wrapping, scale: i64 in Wrapping) {
        transition scale > 0 {
            true -> character(main, value, scale, value / scale + 48),
            false -> bad(main)
        }
    }
    machine character(main: @mutable Main, value: i64 in Wrapping, scale: i64 in Wrapping,
                    byte: i64 in Wrapping) {
        transition byte >= 48 && byte <= 57 && scale > 0 {
            true -> emit(main, value, scale, byte),
            false -> bad(main)
        }
    }
    machine emit(main: @mutable Main, value: i64 in Wrapping, scale: i64 in Wrapping,
               byte: i64 in Wrapping)
    requires byte >= 48 && byte <= 57 && scale > 0
    {
        |console|::Console::write_byte(byte as i32);
        transition scale > 1 {
            true -> digit(main, value % scale, scale / 10),
            false -> done()
        }
    }
    machine done() { }
    machine bad(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
