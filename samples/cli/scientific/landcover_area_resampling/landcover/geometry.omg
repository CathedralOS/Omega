// Scientific model: axis-aligned cells in a planar equal-area coordinate system.
// One tick is one metre. Half-open rectangles have integer boundaries; overlap
// areas are exact square-metre integers. Fractions retain numerator/denominator.
// Wrapping is explicit storage arithmetic, never the scientific model: admission
// restricts coordinates to 0..8, cell widths to 1..4, and grid extents to 1..4.
// Thus all intermediates fit i32. No projection, geographic degrees or smoothing.
public data Grid [copy] {
    x: i32 in Wrapping; y: i32 in Wrapping;
    width: i32 in Wrapping; height: i32 in Wrapping;
    columns: i32 in Wrapping; rows: i32 in Wrapping;
}
public machine minimum(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping {
    transition a < b { true -> a false -> b }
}
public machine maximum(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping {
    transition a > b { true -> a false -> b }
}
public machine overlap(x: i32 in Wrapping, y: i32 in Wrapping,
    width: i32 in Wrapping, height: i32 in Wrapping,
    source_x: i32 in Wrapping, source_y: i32 in Wrapping) -> i32 in Wrapping {
    let left: i32 in Wrapping = maximum(x, source_x);
    let right: i32 in Wrapping = minimum(x + width, source_x + 2);
    let bottom: i32 in Wrapping = maximum(y, source_y);
    let top: i32 in Wrapping = minimum(y + height, source_y + 2);
    transition right > left && top > bottom {
        true -> (right - left) * (top - bottom)
        false -> 0
    }
}
