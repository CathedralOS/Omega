// Complete intended-invalid control: index 2 is outside a two-element array.
use omega_language_std::console;
data InvalidControl { }
machine InvalidControl::main(control: &mut InvalidControl) reaches Console {
    let temperatures: [i32; 2] = [25, 100];
    let invalid: i32 = temperatures[2];
    Console::exit_process(invalid);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: InvalidControl;
    InvalidControl::main(&mut entry_storage);
}
