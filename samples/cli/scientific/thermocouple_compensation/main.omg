use domain/input/input.omg;
use domain/model/model.omg;
use domain/report/report.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete supplied-calibration compensation application; see README for units.

data Application { reader: |input|::Reader; }

machine main(application: @mutable Application) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let value_0: |input|::Number = block |input|::number(@mutable application.reader);
    let value_1: |input|::Number = block |input|::number(@mutable application.reader);
    let value_2: |input|::Number = block |input|::number(@mutable application.reader);
    let value_3: |input|::Number = block |input|::number(@mutable application.reader);
    let value_4: |input|::Number = block |input|::number(@mutable application.reader);
    let value_5: |input|::Number = block |input|::number(@mutable application.reader);
    let value_6: |input|::Number = block |input|::number(@mutable application.reader);
    let value_7: |input|::Number = block |input|::number(@mutable application.reader);
    let value_8: |input|::Number = block |input|::number(@mutable application.reader);
    let value_9: |input|::Number = block |input|::number(@mutable application.reader);
    let value_10: |input|::Number = block |input|::number(@mutable application.reader);
    let value_11: |input|::Number = block |input|::number(@mutable application.reader);
    let value_12: |input|::Number = block |input|::number(@mutable application.reader);
    let value_13: |input|::Number = block |input|::number(@mutable application.reader);
    let value_14: |input|::Number = block |input|::number(@mutable application.reader);
    let finished: bool = block |input|::ended(@mutable application.reader);
    transition value_0.valid && value_1.valid && value_2.valid && value_3.valid && value_4.valid && value_5.valid && value_6.valid && value_7.valid && value_8.valid && value_9.valid && value_10.valid && value_11.valid && value_12.valid && value_13.valid && value_14.valid && finished {
        true -> calibrate(application, |model|::Segment { low: value_0.value, high: value_1.value, a: value_2.value, b: value_3.value, c: value_4.value }, |model|::Segment { low: value_5.value, high: value_6.value, a: value_7.value, b: value_8.value, c: value_9.value }, value_10.value, value_11.value, value_12.value, value_13.value, value_14.value),
        _ -> malformed(application)
    }
    machine malformed(application: @mutable Application) { |console|::Console::write_line("ERROR input"); |process_exit|::ProcessExit::exit_process(10); }
    // Exact boundary voltage differences have a 1e-9 mV quantum from
    // 0.001-scaled coefficients/temperature. The midpoint 9.5e-9 admits
    // every permitted difference <=9e-9 and rejects every >=1e-8 despite
    // binary64 roundoff within the bounded sample domain.
    machine calibrate(application: @mutable Application, first: |model|::Segment, second: |model|::Segment, measured: f64, cold: f64, reference: f64, low: f64, high: f64) {
        transition |model|::valid(first) && |model|::valid(second) && first.high == second.low &&
            |model|::magnitude(|model|::voltage(first, first.high) - |model|::voltage(second, second.low)) < 0.0000000095 {
            true -> cold_junction(application, first, second, measured, cold, reference, low, high),
            _ -> calibration_error(application)
        }
    }
    machine calibration_error(application: @mutable Application) { |console|::Console::write_line("ERROR calibration"); |process_exit|::ProcessExit::exit_process(11); }
    machine cold_junction(application: @mutable Application, first: |model|::Segment, second: |model|::Segment, measured: f64, cold: f64, reference: f64, low: f64, high: f64) {
        transition |model|::inside(first, cold) { true -> compensate(application, first, second, measured + |model|::voltage(first, cold), reference, low, high), _ -> cold_second(application, first, second, measured, cold, reference, low, high) }
    }
    machine cold_second(application: @mutable Application, first: |model|::Segment, second: |model|::Segment, measured: f64, cold: f64, reference: f64, low: f64, high: f64) {
        transition |model|::inside(second, cold) { true -> compensate(application, first, second, measured + |model|::voltage(second, cold), reference, low, high), _ -> cold_error(application) }
    }
    machine cold_error(application: @mutable Application) { |console|::Console::write_line("ERROR cold junction"); |process_exit|::ProcessExit::exit_process(12); }
    machine compensate(application: @mutable Application, first: |model|::Segment, second: |model|::Segment, compensated: f64, reference: f64, low: f64, high: f64) {
        transition low < high && low >= first.low && high <= second.high {
            true -> invert(application, first, second, compensated, reference, low, high),
            _ -> bracket_error(application)
        }
    }
    machine bracket_error(application: @mutable Application) { |console|::Console::write_line("ERROR bracket"); |process_exit|::ProcessExit::exit_process(13); }
    machine invert(application: @mutable Application, first: |model|::Segment, second: |model|::Segment, compensated: f64, reference: f64, low: f64, high: f64) {
        let estimate: |model|::Estimate = |model|::enumerate(first, second, compensated, low, high);
        |report|::field(@mutable application.reader, "brackets=", |float_operations|::F64::from_i32(estimate.count));
        transition estimate.count == 1 { true -> success(application, compensated, reference, estimate), _ -> no_unique(application, estimate.count) }
    }
    machine no_unique(application: @mutable Application, count: i32) {
        transition count == 0 { true -> absent(application), _ -> ambiguous(application) }
    }
    machine absent(application: @mutable Application) { |console|::Console::write_line("ERROR no root"); |process_exit|::ProcessExit::exit_process(14); }
    machine ambiguous(application: @mutable Application) { |console|::Console::write_line("ERROR ambiguous"); |process_exit|::ProcessExit::exit_process(15); }
    machine success(application: @mutable Application, compensated: f64, reference: f64, estimate: |model|::Estimate) {
        |report|::field(@mutable application.reader, "temperature_mC=", estimate.temperature * 1000.0);
        |report|::field(@mutable application.reader, "error_mC=", (estimate.temperature - reference) * 1000.0);
        |report|::field(@mutable application.reader, "compensated_nV=", compensated * 1000000.0);
        |report|::field(@mutable application.reader, "residual_nV=", estimate.residual * 1000000.0);
        |console|::Console::write_line("OK");
        |process_exit|::ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Application;
    block main(@mutable entry_storage);
}
