use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_exit.omg;
// Complete negative control: a strictly ascending elevation interval is
// required before computing a linear slope. A reversed literal violates it.

machine interval_height(lower: i64, upper: i64) -> f64
requires upper > lower
{
    |float_operations|::F64::from_i64(upper) - |float_operations|::F64::from_i64(lower)
}

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit {
    let height: f64 = interval_height(2000, 1000);
    transition height > 0.0 {
        true -> done(),
        false -> done()
    }
    machine done() { |process_exit|::ProcessExit::exit_process(0); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
