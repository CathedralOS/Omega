use omega::language::core::float_operations;
use domain::input;
public data Equilibrium { hydrogen: f64; hydroxide: f64; species: [f64; 3]; total: f64; counterion: f64; closure: f64; charge: f64; ph: f64; }
// Positive H: charge is strictly increasing because protonation increases
// with H and Kw/H decreases. The domain brackets the unique physical root.
public machine solve(input: &Input, volume: f64, result: &mut Equilibrium) {
    let dilution: f64 = input.values[0] + volume;
    result.total = input.values[0] * input.values[1] / dilution;
    result.counterion = volume * input.values[5] / dilution;
    transition { _ -> bisect(input, result, 0.00000000000000000001, 10.0, 0) }
    machine bisect(input: &Input, result: &mut Equilibrium, lower: f64, upper: f64, iteration: i32 in Wrapping) {
        let hydrogen: f64 = lower + (upper - lower) * 0.5;
        species(input, result, hydrogen);
        transition iteration < 160 {
            true -> direction(input, result, lower, upper, hydrogen, iteration)
            _ -> finish(result)
        }
    }
    machine direction(input: &Input, result: &mut Equilibrium, lower: f64, upper: f64, hydrogen: f64, iteration: i32 in Wrapping) {
        transition result.charge > 0.0 {
            true -> bisect(input, result, lower, hydrogen, iteration + 1)
            _ -> bisect(input, result, hydrogen, upper, iteration + 1)
        }
    }
    machine finish(result: &mut Equilibrium) {
        result.closure = result.species[0] + result.species[1] + result.species[2] - result.total;
        result.ph = 0.0 - logarithm(result.hydrogen) / 2.302585092994045684;
    }
}
machine species(input: &Input, result: &mut Equilibrium, hydrogen: f64) {
    let first: f64 = input.values[2] * hydrogen;
    let second: f64 = input.values[2] * input.values[3];
    let neutral: f64 = hydrogen * hydrogen;
    let denominator: f64 = neutral + first + second;
    result.hydrogen = hydrogen;
    result.hydroxide = input.values[4] / hydrogen;
    result.species[0] = result.total * neutral / denominator;
    result.species[1] = result.total * first / denominator;
    result.species[2] = result.total * second / denominator;
    result.charge = hydrogen + result.counterion - result.hydroxide - result.species[1] - 2.0 * result.species[2];
}
// Range reduction followed by the atanh series; ratio <= 1/3, 24 terms.
machine logarithm(value: f64) -> f64 {
    transition { _ -> reduce(value, 0.0, 0) }
    machine reduce(value: f64, offset: f64, iteration: i32 in Wrapping) -> f64 {
        transition value < 1.0 && iteration < 80 {
            true -> reduce(value * 2.0, offset - 0.6931471805599453094, iteration + 1)
            _ -> series(value, offset)
        }
    }
    machine series(value: f64, offset: f64) -> f64 {
        let ratio: f64 = (value - 1.0) / (value + 1.0);
        transition { _ -> sum(ratio, ratio * ratio, 1, offset) }
    }
    machine sum(term: f64, square: f64, index: i32 in Wrapping, accumulated: f64) -> f64 {
        transition index < 49 {
            true -> sum(term * square, square, index + 2, accumulated + 2.0 * term / F64::from_i32(index as i32))
            _ -> accumulated
        }
    }
}
