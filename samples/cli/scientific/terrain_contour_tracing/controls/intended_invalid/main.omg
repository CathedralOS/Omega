use omega\language\core\ProcessExit;
use omega_language_std\Console;
data InvalidMain { values: [i32; 2]; }
machine main(context: @mutable InvalidMain) reaches ProcessExit + Console {
    context.values = [3, 4];
    let outside: i32 = context.values[2];
    ProcessExit::exit_process(outside);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mutable entry_storage: InvalidMain;
    main(@mutable entry_storage);
}
