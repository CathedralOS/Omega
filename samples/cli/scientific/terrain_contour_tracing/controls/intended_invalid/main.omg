use omega_language_std::console;
data InvalidMain { values: [i32; 2]; }
machine InvalidMain::main(context: &mut InvalidMain) reaches Console {
    context.values = [3, 4];
    let outside: i32 = context.values[2];
    Console::exit_process(outside);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: InvalidMain;
    InvalidMain::main(&mut entry_storage);
}
