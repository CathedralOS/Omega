use {omega}/language/core/process_exit.omg;
data InvalidMain { values: [i32; 2]; }
machine main(context: @mutable InvalidMain) reaches |process_exit|::ProcessExit {
    context.values = [3, 4];
    let outside: i32 = context.values[2];
    |process_exit|::ProcessExit::exit_process(outside);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: InvalidMain;
    main(@mutable entry_storage);
}
