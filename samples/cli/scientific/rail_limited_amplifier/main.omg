use domain/model/model.omg;
use io/input/input.omg;
use io/output/output.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// NEW034: runtime-configured discrete rail-limited feedback amplifier.
// Only this project owns its model, bounded parser and report implementation.

data Main {
    bytes: [u8; 192];
    input: |input|::Inputs;
    circuit: |model|::Circuit;
    equilibrium: |model|::Equilibrium;
    previous: f64;
    observed: |model|::Observation;
    first_drive: f64;
    final_drive: f64;
    drive: f64;
    switch_step: i32;
    steps: i32;
    step: i32 in Wrapping;
    last_bad: i32 in Wrapping;
    overload_count: i32 in Wrapping;
    first_recovered: i32;
}
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let read: |console|::LineReadResult = block |console|::Console::read_line(@mutable main.bytes[..]);
    transition read {
        |console|::LineReadResult::LineComplete { count } -> received(main, count),
        |console|::LineReadResult::EndOfInput { count } -> received(main, count),
        _ -> syntax(main)
    }
    machine received(main: @mutable Main, count: u64) {
        transition count <= 192 {
            true -> parse_line(main, count),
            false -> syntax(main)
        }
    }
    machine parse_line(main: @mutable Main, count: u64) {
        main.input = |input|::parse(main.bytes[..count]);
        transition main.input.valid {
            true -> rails(main),
            false -> syntax(main)
        }
    }
    machine rails(main: @mutable Main) {
        transition main.input.values[3] < main.input.values[4] {
            true -> parameters(main),
            false -> bad_rails(main)
        }
    }
    machine parameters(main: @mutable Main) {
        transition main.input.values[0] >= 1 && main.input.values[0] <= 100
            && main.input.values[1] >= -1000 && main.input.values[1] <= 1000
            && main.input.values[2] >= 1 && main.input.values[2] <= 1000
            && main.input.values[7] >= 0 && main.input.values[7] <= main.input.values[8]
            && main.input.values[8] >= 1 && main.input.values[8] <= 64
            && main.input.values[9] >= main.input.values[3] && main.input.values[9] <= main.input.values[4] {
            true -> initialize(main),
            false -> bad_parameters(main)
        }
    }
    machine initialize(main: @mutable Main) {
        main.circuit.gain = main.input.values[0] as f64;
        main.circuit.feedback = (main.input.values[1] as f64) / 1000.0;
        main.circuit.relaxation = (main.input.values[2] as f64) / 1000.0;
        main.circuit.lower = (main.input.values[3] as f64) / 1000.0;
        main.circuit.upper = (main.input.values[4] as f64) / 1000.0;
        main.first_drive = (main.input.values[5] as f64) / 1000.0;
        main.final_drive = (main.input.values[6] as f64) / 1000.0;
        main.switch_step = main.input.values[7];
        main.steps = main.input.values[8];
        main.previous = (main.input.values[9] as f64) / 1000.0;
        main.step = 0;
        main.last_bad = -1;
        main.first_recovered = -1;
        main.overload_count = 0;
        main.equilibrium = |model|::equilibria(main.circuit, main.first_drive);
        |console|::Console::write_line("rail_limited_amplifier v1; voltage=uv; q=ppm");
        equilibrium_row(main, 0);
        main.equilibrium = |model|::equilibria(main.circuit, main.final_drive);
        equilibrium_row(main, 1);
        main.drive = main.first_drive;
        main.observed.output = main.previous;
        main.observed.feedback = main.circuit.feedback * main.previous;
        main.observed.raw = main.previous;
        main.observed.overload = 0;
        trace_row(main);
        measure(main);
        transition { _ -> loop(main) }
    }
    machine loop(main: @mutable Main) {
        transition main.step < main.steps {
            true -> tick(main),
            false -> finish(main)
        }
    }
    machine tick(main: @mutable Main) {
        main.step = main.step + 1;
        main.drive = match main.step <= main.switch_step {
            true -> (main.first_drive),
            false -> (main.final_drive)
        };
        main.observed = |model|::advance(main.circuit, main.drive, main.previous);
        main.previous = main.observed.output;
        trace_row(main);
        measure(main);
        transition { _ -> loop(main) }
    }
    machine finish(main: @mutable Main) {
        let settled: i32 in Wrapping = match main.equilibrium.unique && main.equilibrium.stable && main.last_bad < main.steps {
            true -> (main.last_bad + 1),
            false -> (-1)
        };
        |console|::Console::write("M,");
        |output|::integer(settled as i32);
        |console|::Console::write(",");
        |output|::integer(main.overload_count as i32);
        |console|::Console::write(",");
        |output|::integer(main.first_recovered);
        |console|::Console::write_line("");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine syntax(main: @mutable Main) {
        |console|::Console::write_line("ERROR syntax: expected ten bounded signed integers");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine bad_rails(main: @mutable Main) {
        |console|::Console::write_line("ERROR rails: lower must be less than upper");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine bad_parameters(main: @mutable Main) {
        |console|::Console::write_line("ERROR parameters: gain, feedback, relaxation, steps or initial output outside bounds");
        |process_exit|::ProcessExit::exit_process(64);
    }
}
machine equilibrium_row(main: @mutable Main, phase: i32) reaches |process_authority|::StandardOutput {
    |console|::Console::write("E,");
    |output|::integer(phase);
    |console|::Console::write(",");
    let lower_exists: bool = main.equilibrium.lower_exists;
    flag(main, lower_exists);
    let interior_exists: bool = main.equilibrium.interior_exists;
    flag(main, interior_exists);
    let upper_exists: bool = main.equilibrium.upper_exists;
    flag(main, upper_exists);
    let continuum: bool = main.equilibrium.continuum;
    flag(main, continuum);
    |output|::voltage(main.equilibrium.interior);
    |console|::Console::write(",");
    |output|::voltage(main.equilibrium.multiplier);
    |console|::Console::write(",");
    |output|::integer(match main.equilibrium.stable { true -> (1), false -> (0) });
    |console|::Console::write_line("");
}
machine flag(main: @mutable Main, flag: bool) reaches |process_authority|::StandardOutput {
    |output|::integer(match flag { true -> (1), false -> (0) });
    |console|::Console::write(",");
}
machine trace_row(main: @mutable Main) reaches |process_authority|::StandardOutput {
    |console|::Console::write("T,");
    |output|::integer(main.step as i32);
    |console|::Console::write(",");
    |output|::voltage(main.drive);
    |console|::Console::write(",");
    |output|::voltage(main.observed.output);
    |console|::Console::write(",");
    |output|::voltage(main.observed.feedback);
    |console|::Console::write(",");
    |output|::voltage(main.observed.raw);
    |console|::Console::write(",");
    |output|::integer(main.observed.overload);
    |console|::Console::write_line("");
}
machine measure(main: @mutable Main) {
    transition main.observed.overload != 0 {
        true -> overload(main),
        false -> recovery(main)
    }
    machine overload(main: @mutable Main) {
        main.overload_count = main.overload_count + 1;
        transition { _ -> settling(main) }
    }
    machine recovery(main: @mutable Main) {
        transition main.step > main.switch_step && main.first_recovered == -1 {
            true -> recovered(main),
            false -> settling(main)
        }
    }
    machine recovered(main: @mutable Main) {
        main.first_recovered = main.step as i32;
        transition { _ -> settling(main) }
    }
    machine settling(main: @mutable Main) {
        transition main.step >= main.switch_step {
            true -> error(main),
            false -> before(main)
        }
    }
    machine before(main: @mutable Main) { main.last_bad = main.step; }
    machine error(main: @mutable Main) {
        let difference: f64 = main.observed.output - main.equilibrium.selected;
        transition difference < -0.001 || difference > 0.001 {
            true -> outside(main),
            false -> done()
        }
    }
    machine outside(main: @mutable Main) { main.last_bad = main.step; }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
