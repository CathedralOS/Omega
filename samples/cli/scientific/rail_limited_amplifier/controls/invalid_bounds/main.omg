use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Complete intended-invalid application. Rail history has two slots;
// selecting slot two violates the documented exclusive upper bound.
use system\Console;
data Main { history: [f64; 2]; }
machine main(main: @mutable Main) reaches ProcessExit + StandardOutput {
    main.history[2] = 1.0;
    Console::write_line("unreachable invalid rail history write");
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardOutput {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
