// Explicit sample model: a projected discrete first-order amplifier, not a
// transistor model. Feedback is sampled from the previous output. Projection
// occurs AFTER the Euler update, so numerical instability remains observable.
use omega::language::core::float_operations;

public data Circuit [copy] {
    gain: f64;
    feedback: f64;
    relaxation: f64;
    lower: f64;
    upper: f64;
}
public data Equilibrium [copy] {
    lower_exists: bool;
    interior_exists: bool;
    upper_exists: bool;
    interior: f64;
    continuum: bool;
    unique: bool;
    selected: f64;
    stable: bool;
    multiplier: f64;
}
public data Observation [copy] {
    output: f64;
    feedback: f64;
    raw: f64;
    overload: i32;
}

public machine equilibria(circuit: Circuit, drive: f64) -> Equilibrium {
    let mut result: Equilibrium;
    result.multiplier = 1.0 - circuit.relaxation * (1.0 + circuit.gain * circuit.feedback);
    result.stable = result.multiplier > -1.0 && result.multiplier < 1.0;
    result.lower_exists = circuit.gain * (drive - circuit.feedback * circuit.lower) <= circuit.lower;
    result.upper_exists = circuit.gain * (drive - circuit.feedback * circuit.upper) >= circuit.upper;
    result.selected = match result.lower_exists { true -> (circuit.lower) false -> (circuit.upper) };
    let denominator: f64 = 1.0 + circuit.gain * circuit.feedback;
    result.continuum = denominator == 0.0 && drive == 0.0;
    transition denominator != 0.0 {
        true -> interior(circuit, drive, denominator, result)
        false -> classify(result)
    }
    machine interior(circuit: Circuit, drive: f64, denominator: f64, result: Equilibrium) -> Equilibrium {
        let mut found: Equilibrium = result;
        found.interior = circuit.gain * drive / denominator;
        // Strict interior excludes duplicate rail roots.
        found.interior_exists = found.interior > circuit.lower && found.interior < circuit.upper;
        transition { _ -> classify(found) }
    }
    machine classify(result: Equilibrium) -> Equilibrium {
        let mut found: Equilibrium = result;
        found.unique = !found.continuum && ((found.lower_exists && !found.interior_exists && !found.upper_exists)
            || (!found.lower_exists && found.interior_exists && !found.upper_exists)
            || (!found.lower_exists && !found.interior_exists && found.upper_exists));
        transition found.interior_exists {
            true -> select_interior(found)
            false -> select_rail(found)
        }
    }
    machine select_interior(result: Equilibrium) -> Equilibrium {
        let mut found: Equilibrium = result;
        found.selected = found.interior;
        found
    }
    machine select_rail(result: Equilibrium) -> Equilibrium {
        let mut found: Equilibrium = result;
        // The original rail selection remains valid when no interior root exists.
        found
    }
}

public machine advance(circuit: Circuit, drive: f64, previous: f64) -> Observation {
    let mut observed: Observation;
    observed.feedback = circuit.feedback * previous;
    observed.raw = previous + circuit.relaxation * (circuit.gain * (drive - observed.feedback) - previous);
    transition observed.raw < circuit.lower {
        true -> low(circuit, observed)
        false -> check_high(circuit, observed)
    }
    machine low(circuit: Circuit, observed: Observation) -> Observation {
        let mut result: Observation = observed;
        result.output = circuit.lower;
        result.overload = -1;
        result
    }
    machine check_high(circuit: Circuit, observed: Observation) -> Observation {
        transition observed.raw > circuit.upper {
            true -> high(circuit, observed)
            false -> linear(observed)
        }
    }
    machine high(circuit: Circuit, observed: Observation) -> Observation {
        let mut result: Observation = observed;
        result.output = circuit.upper;
        result.overload = 1;
        result
    }
    machine linear(observed: Observation) -> Observation {
        let mut result: Observation = observed;
        result.output = result.raw;
        result.overload = 0;
        result
    }
}
