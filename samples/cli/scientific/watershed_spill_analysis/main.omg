use output/render/render.omg;
use terrain/fill/fill.omg;
use terrain/raster/raster.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete offline watershed workflow. Stdin: exactly 25 digits, whitespace
// optional. EOF completes the raster; errors exit 2 without partial results.

data Main { }

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable raster: |raster|::Raster;
    transition { _ -> block read(main, @mutable raster, 0) }
    machine read(main: @mutable Main, raster: @mutable |raster|::Raster, count: i32 in Wrapping) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> invalid(main),
            |console|::ByteRead::Eof -> finish_input(main, raster, count),
            |console|::ByteRead::Byte { value } -> block classify(main, raster, count, value)
        }
    }
    machine classify(main: @mutable Main, raster: @mutable |raster|::Raster, count: i32 in Wrapping, value: i32) {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> block read(main, raster, count),
            _ -> block validate(main, raster, count, value)
        }
    }
    machine validate(main: @mutable Main, raster: @mutable |raster|::Raster, count: i32 in Wrapping, value: i32) {
        transition count >= 0 && count < 25 && value >= 48 && value <= 57 {
            true -> block store(main, raster, count, value),
            _ -> invalid(main)
        }
    }
    machine store(main: @mutable Main, raster: @mutable |raster|::Raster, count: i32 in Wrapping, value: i32) {
        raster.heights[count] = (value as +Wrapping) - 48;
        transition { _ -> block read(main, raster, count + 1) }
    }
    machine finish_input(main: @mutable Main, raster: @mutable |raster|::Raster, count: i32 in Wrapping) {
        transition count == 25 {
            true -> analyze(main, raster),
            _ -> invalid(main)
        }
    }
    machine analyze(main: @mutable Main, raster: @mutable |raster|::Raster) {
        let filled: bool = |fill|::fill(raster);
        let summed: bool = |fill|::sum_volumes(raster);
        transition filled && summed {
            true -> emit(main, raster),
            _ -> internal_error(main)
        }
    }
    machine emit(main: @mutable Main, raster: @|raster|::Raster) {
        |console|::Console::write_line("filled");
        |render|::grid(@raster.filled);
        |console|::Console::write_line("outlets");
        |render|::grid(@raster.outlets);
        |console|::Console::write_line("parents");
        |render|::grid(@raster.parents);
        |console|::Console::write_line("volumes");
        |render|::grid(@raster.volumes);
        |console|::Console::write_line("total");
        |render|::number(raster.total);
        |console|::Console::write_byte(10);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("ERROR: expected exactly 25 elevation digits (0-9)");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine internal_error(main: @mutable Main) {
        |console|::Console::write_line("ERROR: drainage invariant failed");
        |process_exit|::ProcessExit::exit_process(3);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
