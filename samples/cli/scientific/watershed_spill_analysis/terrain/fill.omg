use terrain::raster;

// Dijkstra over max(path height), using a bounded linear priority scan.
// Strict improvement and ascending cell scan fix ties reproducibly. Each
// interior parent was settled earlier, so equal-height plateaus cannot cycle.
machine fill(raster: &mut Raster) -> bool {
    transition { _ -> initialize(raster, 0) }
    machine initialize(raster: &mut Raster, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 25 {
            true -> initialize_cell(raster, index)
            _ -> scan(raster, 0, 0 - 1, 99)
        }
    }
    machine initialize_cell(raster: &mut Raster, index: i32 in Wrapping) -> bool {
        raster.settled[index] = false;
        raster.volumes[index] = 0;
        raster.parents[index] = index;
        raster.outlets[index] = index;
        transition index / 5 == 0 || index / 5 == 4 || index % 5 == 0 || index % 5 == 4 {
            true -> initialize_boundary(raster, index)
            _ -> interior(raster, index)
        }
    }
    machine initialize_boundary(raster: &mut Raster, index: i32 in Wrapping) -> bool {
        raster.filled[index] = raster.heights[index];
        transition { _ -> initialize(raster, index + 1) }
    }
    machine interior(raster: &mut Raster, index: i32 in Wrapping) -> bool {
        raster.filled[index] = 99;
        transition { _ -> initialize(raster, index + 1) }
    }
    machine scan(raster: &mut Raster, index: i32 in Wrapping,
               best: i32 in Wrapping, level: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 25 {
            true -> candidate(raster, index, best, level)
            _ -> selected(raster, best)
        }
    }
    machine candidate(raster: &mut Raster, index: i32 in Wrapping,
                    best: i32 in Wrapping, level: i32 in Wrapping) -> bool {
        let cost: i32 in Wrapping = raster.filled[index];
        let done: bool = raster.settled[index];
        transition !done && cost < level {
            true -> scan(raster, index + 1, index, cost)
            _ -> scan(raster, index + 1, best, level)
        }
    }
    machine selected(raster: &mut Raster, best: i32 in Wrapping) -> bool {
        transition best >= 0 && best < 25 {
            true -> settle(raster, best)
            _ -> true
        }
    }
    machine settle(raster: &mut Raster, best: i32 in Wrapping) -> bool {
        raster.settled[best] = true;
        transition { _ -> neighbors(raster, best, 0) }
    }
    machine neighbors(raster: &mut Raster, best: i32 in Wrapping,
                    index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 25 && best >= 0 && best < 25 {
            true -> adjacent(raster, best, index)
            _ -> scan(raster, 0, 0 - 1, 99)
        }
    }
    machine adjacent(raster: &mut Raster, best: i32 in Wrapping,
                   index: i32 in Wrapping) -> bool {
        let adjacent: bool = (index / 5 == best / 5 && (index == best + 1 || best == index + 1))
            || (index % 5 == best % 5 && (index == best + 5 || best == index + 5));
        transition adjacent && !raster.settled[index] {
            true -> elevation(raster, best, index)
            _ -> neighbors(raster, best, index + 1)
        }
    }
    machine elevation(raster: &mut Raster, best: i32 in Wrapping,
                    index: i32 in Wrapping) -> bool {
        let level: i32 in Wrapping = raster.filled[best];
        let height: i32 in Wrapping = raster.heights[index];
        transition height > level {
            true -> improve(raster, best, index, height)
            _ -> improve(raster, best, index, level)
        }
    }
    machine improve(raster: &mut Raster, best: i32 in Wrapping,
                  index: i32 in Wrapping, level: i32 in Wrapping) -> bool {
        transition level < raster.filled[index] {
            true -> update(raster, best, index, level)
            _ -> neighbors(raster, best, index + 1)
        }
    }
    machine update(raster: &mut Raster, best: i32 in Wrapping,
                 index: i32 in Wrapping, level: i32 in Wrapping) -> bool {
        raster.filled[index] = level;
        raster.parents[index] = best;
        raster.outlets[index] = raster.outlets[best];
        transition { _ -> neighbors(raster, best, index + 1) }
    }
}

machine sum_volumes(raster: &mut Raster) -> bool {
    raster.total = 0;
    transition { _ -> cell(raster, 0) }
    machine cell(raster: &mut Raster, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 25 {
            true -> label(raster, index)
            _ -> true
        }
    }
    machine label(raster: &mut Raster, index: i32 in Wrapping) -> bool {
        let outlet: i32 in Wrapping = raster.outlets[index];
        let depth: i32 in Wrapping = raster.filled[index] - raster.heights[index];
        transition outlet >= 0 && outlet < 25 && depth >= 0 && depth <= 9 {
            true -> accumulate(raster, index, outlet, depth)
            _ -> false
        }
    }
    machine accumulate(raster: &mut Raster, index: i32 in Wrapping,
                     outlet: i32 in Wrapping, depth: i32 in Wrapping) -> bool {
        raster.volumes[outlet] = raster.volumes[outlet] + depth;
        raster.total = raster.total + depth;
        transition { _ -> cell(raster, index + 1) }
    }
}
