use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete independent source control: unguarded runtime index must reject.
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let input: |console|::ByteRead = block |console|::Console::read_byte();
    transition input {
        |console|::ByteRead::Error -> |process_exit|::ProcessExit::exit_process(74),
        |console|::ByteRead::Eof -> finish(main),
        |console|::ByteRead::Byte { value } -> unsafe_read(main, value)
    }
    machine unsafe_read(main: @mutable Main, index: i32) {
        let elevations: [i32; 25];
        let height: i32 = elevations[index];
        |process_exit|::ProcessExit::exit_process(height);
    }
    machine finish(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(0); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
