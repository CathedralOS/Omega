use omega\language\core\StandardInput;
use omega\language\core\ProcessExit;
// Complete independent source control: unguarded runtime index must reject.
use system\ByteRead;
use system\Console;
data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput {
    let input: ByteRead = block Console::read_byte();
    transition input {
        ByteRead::Error -> ProcessExit::exit_process(74),
        ByteRead::Eof -> finish(main),
        ByteRead::Byte { value } -> unsafe_read(main, value)
    }
    machine unsafe_read(main: @mutable Main, index: i32) {
        let elevations: [i32; 25];
        let height: i32 = elevations[index];
        ProcessExit::exit_process(height);
    }
    machine finish(main: @mutable Main) { ProcessExit::exit_process(0); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
