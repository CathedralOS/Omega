use geometry::model;
use omega::language::core::numeric_conversion;

// Exactly 17 small signed decimal fields. No partial record is admitted. The
// parser bounds magnitude before accumulation, rejects extra fields and any
// non-decimal byte, and accepts space, tab, CR, LF as separators.
public machine parse(bytes: &[u8], problem: &mut Problem) -> bool {
    transition { _ -> scan(bytes, problem, 0, 0, 0, false, false, false) }
    machine scan(bytes: &[u8], problem: &mut Problem, cursor: u64, field: u64,
        magnitude: i32 in Wrapping, negative: bool, started: bool, digit_seen: bool) -> bool {
        transition cursor < bytes.len {
            true -> byte(bytes, problem, cursor, field, magnitude, negative, started, digit_seen)
            false -> finish(problem, field, magnitude, negative, started, digit_seen)
        }
    }
    machine byte(bytes: &[u8], problem: &mut Problem, cursor: u64, field: u64,
        magnitude: i32 in Wrapping, negative: bool, started: bool, digit_seen: bool) -> bool
    requires cursor < bytes.len
    {
        let value: u8 = bytes[cursor];
        transition {
            value >= 48 && value <= 57 -> digit(bytes, problem, cursor, field, magnitude, negative, value)
            value == 45 && !started -> scan(bytes, problem, cursor + 1, field, magnitude, true, true, false)
            value == 32 || value == 9 || value == 10 || value == 13 -> separator(bytes, problem, cursor, field, magnitude, negative, started, digit_seen)
            _ -> (false)
        }
    }
    machine digit(bytes: &[u8], problem: &mut Problem, cursor: u64, field: u64,
        magnitude: i32 in Wrapping, negative: bool, value: u8) -> bool
    requires cursor < bytes.len
    {
        let next: i32 in Wrapping = magnitude * 10 + (value as i32 in Wrapping) - 48;
        transition next <= 20 {
            true -> scan(bytes, problem, cursor + 1, field, next, negative, true, true)
            false -> (false)
        }
    }
    machine separator(bytes: &[u8], problem: &mut Problem, cursor: u64, field: u64,
        magnitude: i32 in Wrapping, negative: bool, started: bool, digit_seen: bool) -> bool
    requires cursor < bytes.len
    {
        transition {
            !started -> scan(bytes, problem, cursor + 1, field, 0, false, false, false)
            digit_seen && field < 17 -> store(bytes, problem, cursor, field, magnitude, negative)
            _ -> (false)
        }
    }
    machine store(bytes: &[u8], problem: &mut Problem, cursor: u64, field: u64,
        magnitude: i32 in Wrapping, negative: bool) -> bool
    requires cursor < bytes.len && field < 17
    {
        transition negative {
            true -> write(bytes, problem, cursor, field, -magnitude)
            false -> write(bytes, problem, cursor, field, magnitude)
        }
    }
    machine write(bytes: &[u8], problem: &mut Problem, cursor: u64, field: u64,
        value: i32 in Wrapping) -> bool
    requires cursor < bytes.len && field < 17
    {
        problem.values[field] = value;
        transition { _ -> scan(bytes, problem, cursor + 1, field + 1, 0, false, false, false) }
    }
    machine finish(problem: &mut Problem, field: u64, magnitude: i32 in Wrapping,
        negative: bool, started: bool, digit_seen: bool) -> bool {
        transition {
            !started -> (field == 17)
            digit_seen && field == 16 -> last(problem, magnitude, negative)
            _ -> (false)
        }
    }
    machine last(problem: &mut Problem, magnitude: i32 in Wrapping, negative: bool) -> bool {
        transition negative {
            true -> final_value(problem, -magnitude)
            false -> final_value(problem, magnitude)
        }
    }
    machine final_value(problem: &mut Problem, value: i32 in Wrapping) -> bool {
        problem.values[16] = value;
        true
    }
}

public machine valid(problem: &Problem) -> bool {
    transition problem.values[0] <= problem.values[1] && problem.values[2] <= problem.values[3]
        && problem.values[4] == 3 {
        true -> ranges(problem, 0)
        false -> (false)
    }
    machine ranges(problem: &Problem, index: u64) -> bool {
        transition index < 3 {
            true -> range(problem, index)
            false -> (true)
        }
    }
    machine range(problem: &Problem, index: u64) -> bool
    requires index < 3
    {
        let offset: u64 = 5 + index * 4;
        transition problem.values[offset + 2] >= 0 && problem.values[offset + 2] <= problem.values[offset + 3] {
            true -> ranges(problem, index + 1)
            false -> (false)
        }
    }
}
