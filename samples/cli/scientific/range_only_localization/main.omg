use geometry/model/model.omg;
use input/parser/parser.omg;
use output/report/report.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0.
// Expected output contains: status unique

// Search every integer point in the supplied closed window. Each candidate
// includes three signed squared-range residuals relative to the lower bound.
// These are squared-distance units, not radial error. Search is deterministic,
// ordered by y then x, and retains no candidate storage or hidden truncation.
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable bytes: [u8; 128];
    let mutable problem: |model|::Problem;
    let observed: |console|::LineReadResult = block |console|::Console::read_line(@mutable bytes[..]);
    transition observed {
        |console|::LineReadResult::EndOfInput { count } -> input(@bytes, count, @mutable problem),
        |console|::LineReadResult::LineComplete { count } -> input(@bytes, count, @mutable problem),
        _ -> invalid()
    }
    machine input(bytes: @[u8], count: u64, problem: @mutable |model|::Problem) {
        transition count <= bytes.length {
            true -> admitted(bytes, count, problem),
            false -> invalid()
        }
    }
    machine admitted(bytes: @[u8], count: u64, problem: @mutable |model|::Problem)
    requires count <= bytes.length
    {
        transition count == 0 {
            true -> demo(problem),
            false -> decode(bytes[..count], problem)
        }
    }
    machine demo(problem: @mutable |model|::Problem) {
        // Three exact circles through (3,4): radii 5,5,3.
        problem.values[0] = -8; problem.values[1] = 8;
        problem.values[2] = -8; problem.values[3] = 8;
        problem.values[4] = 3;
        problem.values[5] = 0; problem.values[6] = 0;
        problem.values[7] = 5; problem.values[8] = 5;
        problem.values[9] = 6; problem.values[10] = 0;
        problem.values[11] = 5; problem.values[12] = 5;
        problem.values[13] = 3; problem.values[14] = 1;
        problem.values[15] = 3; problem.values[16] = 3;
        transition { _ -> search(problem, problem.values[0], problem.values[2], 0) }
    }
    machine decode(bytes: @[u8], problem: @mutable |model|::Problem) {
        let parsed: bool = |parser|::parse(bytes, problem);
        transition parsed {
            true -> validate(problem),
            false -> invalid()
        }
    }
    machine validate(problem: @|model|::Problem) {
        transition |parser|::valid(problem) {
            true -> search(problem, problem.values[0], problem.values[2], 0),
            false -> invalid()
        }
    }
    machine search(problem: @|model|::Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        transition |model|::feasible(problem, x, y) {
            true -> candidate(problem, x, y, count),
            false -> advance(problem, x, y, count)
        }
    }
    machine candidate(problem: @|model|::Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        |console|::Console::write("candidate "); |report|::number(x); |console|::Console::write(" "); |report|::number(y);
        |console|::Console::write(" residual2");
        residuals(problem, x, y, 0);
        |console|::Console::write_line("");
        transition { _ -> advance(problem, x, y, count + 1) }
    }
    machine advance(problem: @|model|::Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        transition {
            x < problem.values[1] -> search(problem, x + 1, y, count),
            y < problem.values[3] -> search(problem, problem.values[0], y + 1, count),
            _ -> summary(problem, count)
        }
    }
    machine summary(problem: @|model|::Problem, count: i32 in Wrapping) {
        |console|::Console::write("count "); |report|::number(count); |console|::Console::write_line("");
        transition {
            count == 0 -> inconsistent(),
            |model|::degenerate(problem) -> degenerate_result(),
            count == 1 -> unique(),
            _ -> ambiguous()
        }
    }
    machine inconsistent() { |console|::Console::write_line("status inconsistent"); |process_exit|::ProcessExit::exit_process(0); }
    machine degenerate_result() { |console|::Console::write_line("status degenerate"); |process_exit|::ProcessExit::exit_process(0); }
    machine unique() { |console|::Console::write_line("status unique"); |process_exit|::ProcessExit::exit_process(0); }
    machine ambiguous() { |console|::Console::write_line("status ambiguous"); |process_exit|::ProcessExit::exit_process(0); }
    machine invalid() { |console|::Console::write_line("error invalid input"); |process_exit|::ProcessExit::exit_process(64); }
}

machine residuals(problem: @|model|::Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64)
reaches |process_authority|::StandardOutput {
    transition index < 3 {
        true -> emit(problem, x, y, index),
        false -> done()
    }
    machine emit(problem: @|model|::Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64)
    requires index < 3
    {
        let offset: u64 = 5 + index * 4;
        let lower: i32 in Wrapping = problem.values[offset + 2];
        let residual: i32 in Wrapping = |model|::distance_squared(x, y, problem.values[offset], problem.values[offset + 1]) - lower * lower;
        |console|::Console::write(" "); |report|::number(residual);
        transition { _ -> residuals(problem, x, y, index + 1) }
    }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
