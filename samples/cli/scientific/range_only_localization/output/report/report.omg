use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

data Decimal {
    value: i32 in Wrapping;
    divisor: i32 in Wrapping;
    bytes: [u8; 11];
    count: u64;
}

// Prepare signed decimal bytes before invoking Console. A nonpositive
// working value represents i32::MIN exactly; eleven bytes include its sign.
public machine number(value: i32 in Wrapping)
reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    let mutable decimal: Decimal;
    decimal.divisor = 1;
    transition value < 0 {
        true -> negative(value, @mutable decimal),
        false -> positive(value, @mutable decimal)
    }
    machine negative(value: i32 in Wrapping, decimal: @mutable Decimal) {
        decimal.value = value;
        decimal.bytes[0] = 45;
        decimal.count = 1;
        transition { _ -> scale(decimal) }
    }
    machine positive(value: i32 in Wrapping, decimal: @mutable Decimal) {
        decimal.value = -value;
        transition { _ -> scale(decimal) }
    }
    machine scale(decimal: @mutable Decimal) {
        transition decimal.divisor >= 1 && decimal.divisor <= 1000000000 && decimal.count < 11 {
            true -> scale_ready(decimal),
            false -> done()
        }
    }
    machine scale_ready(decimal: @mutable Decimal)
    requires decimal.divisor >= 1 && decimal.divisor <= 1000000000 && decimal.count < 11
    {
        transition decimal.value / decimal.divisor <= -10 && decimal.divisor <= 100000000 {
            true -> grow(decimal),
            false -> digit(decimal)
        }
    }
    machine grow(decimal: @mutable Decimal) {
        transition decimal.divisor >= 1 && decimal.divisor <= 100000000 && decimal.count < 11 {
            true -> grow_ready(decimal),
            false -> done()
        }
    }
    machine grow_ready(decimal: @mutable Decimal)
    requires decimal.divisor >= 1 && decimal.divisor <= 100000000 && decimal.count < 11
    {
        decimal.divisor = decimal.divisor * 10;
        transition { _ -> scale(decimal) }
    }
    machine digit(decimal: @mutable Decimal) {
        transition decimal.divisor >= 1 && decimal.divisor <= 1000000000 && decimal.count < 11 {
            true -> digit_ready(decimal),
            false -> done()
        }
    }
    machine digit_ready(decimal: @mutable Decimal)
    requires decimal.divisor >= 1 && decimal.divisor <= 1000000000 && decimal.count < 11
    {
        decimal.bytes[decimal.count] = |numeric_conversion|::narrow_i32_to_u8_wrapping((-(decimal.value / decimal.divisor) + 48) as i32);
        decimal.count = decimal.count + 1;
        transition decimal.divisor >= 10 && decimal.count < 11 {
            true -> next(decimal),
            false -> emit(decimal)
        }
    }
    machine next(decimal: @mutable Decimal) {
        transition decimal.divisor >= 10 && decimal.divisor <= 1000000000 && decimal.count < 11 {
            true -> next_ready(decimal),
            false -> done()
        }
    }
    machine next_ready(decimal: @mutable Decimal)
    requires decimal.divisor >= 10 && decimal.divisor <= 1000000000 && decimal.count < 11
    {
        decimal.value = decimal.value % decimal.divisor;
        decimal.divisor = decimal.divisor / 10;
        transition { _ -> digit(decimal) }
    }
    machine emit(decimal: @Decimal) {
        transition decimal.count <= 11 {
            true -> emit_ready(decimal),
            false -> done()
        }
    }
    machine emit_ready(decimal: @Decimal)
    requires decimal.count <= 11
    {
        |console|::Console::write(decimal.bytes[..decimal.count]);
    }
    machine done() {}
}
