// Expected exit: 0.
use omega::language::core::float_operations;
use numerics::linalg::dot_scaled_norm_axpy::try_dot_f64;
use numerics::linalg::dot_scaled_norm_axpy::try_scaled_norm_f64;
use numerics::linalg::dot_scaled_norm_axpy::try_axpy_f64;
use numerics::linalg::dot_scaled_norm_axpy::try_axpy_self_f64;

// Ordinary geometry and disjoint/self axpy. Frozen oracle: dot=11,
// norm=5, axpy=(7,10), self axpy=(21,30). Empty dot/norm are zero.
machine main() crashes Trap {
    let input: [f64; 2] = [3.0, 4.0];
    let mut output: [f64; 2] = [1.0, 2.0];
    let mut dot: f64 = -99.0;
    let mut norm: f64 = -99.0;
    let dot_ok: bool = try_dot_f64(&input[..], &output[..], &mut dot);
    let norm_ok: bool = try_scaled_norm_f64(&input[..], &mut norm);
    let axpy_ok: bool = try_axpy_f64(2.0, &input[..], &mut output[..]);
    let ordinary_ok: bool = dot_ok && norm_ok && axpy_ok
        && dot == 11.0 && norm == 5.0 && output[0] == 7.0 && output[1] == 10.0;
    let self_ok: bool = try_axpy_self_f64(2.0, &mut output[..]);
    let mut empty_dot: f64 = -99.0;
    let mut empty_norm: f64 = -99.0;
    let empty_dot_ok: bool = try_dot_f64(&input[0..0], &input[0..0], &mut empty_dot);
    let empty_norm_ok: bool = try_scaled_norm_f64(&input[0..0], &mut empty_norm);
    let mut sentinel: f64 = 77.0;
    let mismatch: bool = try_dot_f64(&input[..], &input[0..1], &mut sentinel);
    transition ordinary_ok && self_ok && output[0] == 21.0 && output[1] == 30.0
        && input[0] == 3.0 && input[1] == 4.0
        && empty_dot_ok && empty_norm_ok && empty_dot == 0.0 && empty_norm == 0.0
        && mismatch == false && sentinel == 77.0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
