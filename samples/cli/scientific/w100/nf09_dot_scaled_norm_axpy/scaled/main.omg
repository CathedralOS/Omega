// Expected exit: 0.
use omega::language::core::float_operations;
use numerics::linalg::dot_scaled_norm_axpy::try_dot_f64;
use numerics::linalg::dot_scaled_norm_axpy::try_scaled_norm_f64;
use numerics::linalg::dot_scaled_norm_axpy::try_axpy_f64;

// Dynamic-range stress. Frozen before execution: relative tolerance 1e-14;
// norm(3e200,-4e200)=5e200, norm(3e-200,4e-200)=5e-200.
machine main() crashes Trap {
    let large: [f64; 2] = [3.0e200, -4.0e200];
    let small: [f64; 2] = [3.0e-200, 4.0e-200];
    let zero: [f64; 2] = [0.0, -0.0];
    let mut large_norm: f64 = -99.0;
    let mut small_norm: f64 = -99.0;
    let mut zero_norm: f64 = -99.0;
    let large_ok: bool = try_scaled_norm_f64(&large[..], &mut large_norm);
    let small_ok: bool = try_scaled_norm_f64(&small[..], &mut small_norm);
    let zero_ok: bool = try_scaled_norm_f64(&zero[..], &mut zero_norm);
    let large_difference: f64 = large_norm / 5.0e200 - 1.0;
    let small_difference: f64 = small_norm / 5.0e-200 - 1.0;
    let large_error: f64 = F64::maximum(large_difference, F64::negate(large_difference));
    let small_error: f64 = F64::maximum(small_difference, F64::negate(small_difference));
    let naive_large: f64 = F64::square_root(large[0] * large[0] + large[1] * large[1]);
    let naive_small: f64 = F64::square_root(small[0] * small[0] + small[1] * small[1]);
    let mut untouched: [f64; 2] = [8.0, 9.0];
    let late_overflow: [f64; 2] = [1.0, 4.0e200];
    let overflow: bool = try_axpy_f64(1.0e200, &late_overflow[..], &mut untouched[..]);
    let mut sentinel: f64 = 77.0;
    let dot_overflow: bool = try_dot_f64(&large[..], &large[..], &mut sentinel);
    transition large_ok && small_ok && zero_ok && zero_norm == 0.0
        && large_error <= 1.0e-14 && small_error <= 1.0e-14
        && naive_large > 1.0e300 && naive_small == 0.0
        && overflow == false && untouched[0] == 8.0 && untouched[1] == 9.0
        && dot_overflow == false && sentinel == 77.0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
