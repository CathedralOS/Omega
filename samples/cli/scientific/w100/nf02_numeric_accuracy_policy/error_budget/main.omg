        && F64::square_root(4.0f64) == 2.0f64
        && compare_symmetric_any_f32(1.0f32 + 0.000000059604644775390625f32, 1.00000011920928955078125f32, SymmetricAnyTolerance32 { absolute: 0.0000002384185791015625f32, relative: 0.0f32 }) == AccuracyComparison::Close
        && compare_symmetric_any_f64(0.1f64 + 0.2f64, 0.3f64, SymmetricAnyTolerance64 { absolute: 0.000000000000000444089209850062616169452667236328125f64, relative: 0.0f64 }) == AccuracyComparison::Close
        && compare_symmetric_any_f64(0.1f64 + 0.2f64, 0.3f64, exact64) == AccuracyComparison::Different
