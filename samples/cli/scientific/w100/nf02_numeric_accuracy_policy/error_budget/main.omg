        && compare_reference_additive_f32(largest32, F32::negate(largest32), ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: 1.5f32 }) == AccuracyComparison::Different
        && compare_reference_additive_f32(largest32, F32::negate(largest32), ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: 2.0f32 }) == AccuracyComparison::Close
        && compare_reference_additive_f32(largest32, F32::negate(largest32), ReferenceAdditiveTolerance32 { atol: largest32, rtol: 0.5f32 }) == AccuracyComparison::Different
        && compare_reference_additive_f32(largest32, F32::negate(largest32), ReferenceAdditiveTolerance32 { atol: largest32, rtol: 1.0f32 }) == AccuracyComparison::Close
        && compare_reference_additive_f32(0.0f32, largest32, ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: 2.0f32 }) == AccuracyComparison::Close
        && compare_reference_additive_f32(largest32, 0.0f32, ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: largest32 }) == AccuracyComparison::Different
        && compare_reference_additive_f32(largest32, 0.0f32, ReferenceAdditiveTolerance32 { atol: largest32, rtol: largest32 }) == AccuracyComparison::Close
        && compare_reference_additive_f32(from_bits32(1u32), 0.0f32, ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: 1.0f32 }) == AccuracyComparison::Different
        && compare_reference_additive_f32(0.0f32, from_bits32(1u32), ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: 1.0f32 }) == AccuracyComparison::Close
        && compare_reference_additive_f32(from_bits32(1u32), 0.0f32, ReferenceAdditiveTolerance32 { atol: from_bits32(1u32), rtol: 0.0f32 }) == AccuracyComparison::Close
        && compare_reference_additive_f32(from_bits32(2u32), 0.0f32, ReferenceAdditiveTolerance32 { atol: from_bits32(1u32), rtol: 0.0f32 }) == AccuracyComparison::Different
        && compare_reference_additive_f32(0.0f32, from_bits32(1u32), ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: 0.5f32 }) == AccuracyComparison::Different
        && compare_symmetric_any_f32(from_bits32(1u32), 0.0f32, SymmetricAnyTolerance32 { absolute: 0.0f32, relative: 1.0f32 }) == AccuracyComparison::Close
