use numerics::numeric::numeric_accuracy_policy::AccuracyComparison;
use numerics::numeric::numeric_accuracy_policy::SymmetricAnyTolerance32;
use numerics::numeric::numeric_accuracy_policy::SymmetricAnyTolerance64;
use numerics::numeric::numeric_accuracy_policy::ReferenceAdditiveTolerance32;
use numerics::numeric::numeric_accuracy_policy::ReferenceAdditiveTolerance64;
use numerics::numeric::numeric_accuracy_policy::compare_symmetric_any_f32;
use numerics::numeric::numeric_accuracy_policy::compare_symmetric_any_f64;
use numerics::numeric::numeric_accuracy_policy::compare_reference_additive_f32;
use numerics::numeric::numeric_accuracy_policy::compare_reference_additive_f64;
use omega::language::core::float_operations;
machine from_bits32(bits: u32) -> f32 {
    let value: &f32 = &bits as &f32;
    value
}
machine from_bits64(bits: u64) -> f64 {
    let value: &f64 = &bits as &f64;
    value
}

machine main() crashes Trap {
    let exact32: SymmetricAnyTolerance32 = SymmetricAnyTolerance32 { absolute: 0.0f32, relative: 0.0f32 };
    let infinity32: f32 = from_bits32(2139095040u32);
    let nan32: f32 = from_bits32(2143289344u32);
    let largest32: f32 = from_bits32(2139095039u32);
    let exact64: SymmetricAnyTolerance64 = SymmetricAnyTolerance64 { absolute: 0.0f64, relative: 0.0f64 };
    let infinity64: f64 = from_bits64(9218868437227405312u64);
    let nan64: f64 = from_bits64(9221120237041090560u64);
    let largest64: f64 = from_bits64(9218868437227405311u64);
    transition compare_symmetric_any_f32(0.0f32, F32::negate(0.0f32), exact32) == AccuracyComparison::Close
        && compare_symmetric_any_f32(infinity32, infinity32, exact32) == AccuracyComparison::Close
        && compare_symmetric_any_f32(infinity32, F32::negate(infinity32), exact32) == AccuracyComparison::Different
        && compare_symmetric_any_f32(infinity32, 1.0f32, exact32) == AccuracyComparison::Different
        && compare_symmetric_any_f32(nan32, nan32, exact32) == AccuracyComparison::Different
        && compare_symmetric_any_f32(nan32, 1.0f32, exact32) == AccuracyComparison::Different
        && compare_symmetric_any_f32(1.0f32, nan32, exact32) == AccuracyComparison::Different
        && compare_symmetric_any_f32(1.0f32, 1.0f32, SymmetricAnyTolerance32 { absolute: -1.0f32, relative: 0.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_symmetric_any_f32(1.0f32, 1.0f32, SymmetricAnyTolerance32 { absolute: 0.0f32, relative: -1.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_symmetric_any_f32(1.0f32, 1.0f32, SymmetricAnyTolerance32 { absolute: nan32, relative: 0.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_symmetric_any_f32(1.0f32, 1.0f32, SymmetricAnyTolerance32 { absolute: 0.0f32, relative: nan32 }) == AccuracyComparison::InvalidTolerance
        && compare_symmetric_any_f32(1.0f32, 1.0f32, SymmetricAnyTolerance32 { absolute: infinity32, relative: 0.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_symmetric_any_f32(1.0f32, 1.0f32, SymmetricAnyTolerance32 { absolute: 0.0f32, relative: infinity32 }) == AccuracyComparison::InvalidTolerance
        && compare_symmetric_any_f32(largest32, F32::negate(largest32), SymmetricAnyTolerance32 { absolute: 0.0f32, relative: 1.0f32 }) == AccuracyComparison::Different
        && compare_symmetric_any_f32(largest32, F32::negate(largest32), SymmetricAnyTolerance32 { absolute: 0.0f32, relative: 2.0f32 }) == AccuracyComparison::Close
        && compare_symmetric_any_f32(1.0f32, 1.125f32, SymmetricAnyTolerance32 { absolute: 0.125f32, relative: 0.0f32 }) == AccuracyComparison::Close
        && compare_symmetric_any_f32(1.0f32, 1.125f32, SymmetricAnyTolerance32 { absolute: 0.0625f32, relative: 0.0f32 }) == AccuracyComparison::Different
        && compare_symmetric_any_f32(from_bits32(1u32), 0.0f32, exact32) == AccuracyComparison::Different
        && compare_symmetric_any_f64(0.0f64, F64::negate(0.0f64), exact64) == AccuracyComparison::Close
        && compare_symmetric_any_f64(infinity64, infinity64, exact64) == AccuracyComparison::Close
