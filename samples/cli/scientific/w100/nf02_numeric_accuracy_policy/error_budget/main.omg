        && compare_reference_additive_f64(from_bits64(1u64), 0.0f64, ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: 1.0f64 }) == AccuracyComparison::Different
        && compare_reference_additive_f64(0.0f64, from_bits64(1u64), ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: 1.0f64 }) == AccuracyComparison::Close
        && compare_reference_additive_f64(from_bits64(1u64), 0.0f64, ReferenceAdditiveTolerance64 { atol: from_bits64(1u64), rtol: 0.0f64 }) == AccuracyComparison::Close
        && compare_reference_additive_f64(from_bits64(2u64), 0.0f64, ReferenceAdditiveTolerance64 { atol: from_bits64(1u64), rtol: 0.0f64 }) == AccuracyComparison::Different
        && compare_reference_additive_f64(0.0f64, from_bits64(1u64), ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: 0.5f64 }) == AccuracyComparison::Different
        && compare_symmetric_any_f64(from_bits64(1u64), 0.0f64, SymmetricAnyTolerance64 { absolute: 0.0f64, relative: 1.0f64 }) == AccuracyComparison::Close {
        true -> done()
        _ -> incorrect()
    }
    machine done() {}
    machine incorrect() { crash Trap; }
}
