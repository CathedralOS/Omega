        && compare_symmetric_any_f64(nan64, 1.0f64, exact64) == AccuracyComparison::Different
        && compare_symmetric_any_f64(1.0f64, nan64, exact64) == AccuracyComparison::Different
        && compare_symmetric_any_f64(1.0f64, 1.0f64, SymmetricAnyTolerance64 { absolute: -1.0f64, relative: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_symmetric_any_f64(1.0f64, 1.0f64, SymmetricAnyTolerance64 { absolute: 0.0f64, relative: -1.0f64 }) == AccuracyComparison::InvalidTolerance
