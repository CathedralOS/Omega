        && classify_f64(widen_f32_to_f64(float::from_bits(0x8000_0000u32))) == NumericClass::NegativeZero
        && classify_f32(round_f64_to_f32(float::infinity<f64>())) == NumericClass::PositiveInfinity
        && classify_f64(widen_f32_to_f64(float::quiet_nan<f32>())) == NumericClass::NaN
