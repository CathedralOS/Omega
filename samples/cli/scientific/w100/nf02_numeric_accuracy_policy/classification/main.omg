use numerics::numeric::numeric_accuracy_policy::NumericClass;
use numerics::numeric::numeric_accuracy_policy::AccuracyComparison;
use numerics::numeric::numeric_accuracy_policy::ReferenceAdditiveTolerance32;
use numerics::numeric::numeric_accuracy_policy::ReferenceAdditiveTolerance64;
use numerics::numeric::numeric_accuracy_policy::widen_f32_to_f64;
use numerics::numeric::numeric_accuracy_policy::round_f64_to_f32;
use numerics::numeric::numeric_accuracy_policy::round_i32_to_f32;
use numerics::numeric::numeric_accuracy_policy::round_i32_to_f64;
use numerics::numeric::numeric_accuracy_policy::classify_f32;
use numerics::numeric::numeric_accuracy_policy::classify_f64;
use numerics::numeric::numeric_accuracy_policy::compare_reference_additive_f32;
use numerics::numeric::numeric_accuracy_policy::compare_reference_additive_f64;
use omega::language::core::float_operations;
machine from_bits32(bits: u32) -> f32 {
    let value: &f32 = &bits as &f32;
    value
}
machine from_bits64(bits: u64) -> f64 {
    let value: &f64 = &bits as &f64;
    value
}

machine main() crashes Trap {
    let additive_exact32: ReferenceAdditiveTolerance32 = ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: 0.0f32 };
    let additive_nan32: f32 = from_bits32(2143289344u32);
    let additive_infinity32: f32 = from_bits32(2139095040u32);
    let additive_exact64: ReferenceAdditiveTolerance64 = ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: 0.0f64 };
    let additive_nan64: f64 = from_bits64(9221120237041090560u64);
    let additive_infinity64: f64 = from_bits64(9218868437227405312u64);
    transition classify_f32(from_bits32(0u32)) == NumericClass::PositiveZero
        && classify_f32(from_bits32(2147483648u32)) == NumericClass::NegativeZero
        && classify_f32(from_bits32(2139095040u32)) == NumericClass::PositiveInfinity
        && classify_f32(from_bits32(4286578688u32)) == NumericClass::NegativeInfinity
        && classify_f32(from_bits32(2143289344u32)) == NumericClass::NaN
        && classify_f32(from_bits32(4290772992u32)) == NumericClass::NaN
        && classify_f32(from_bits32(1u32)) == NumericClass::Finite
        && classify_f32(from_bits32(2147483649u32)) == NumericClass::Finite
        && classify_f32(3.5f32) == NumericClass::Finite
        && classify_f32(-3.5f32) == NumericClass::Finite
        && classify_f64(from_bits64(0u64)) == NumericClass::PositiveZero
        && classify_f64(from_bits64(9223372036854775808u64)) == NumericClass::NegativeZero
        && classify_f64(from_bits64(9218868437227405312u64)) == NumericClass::PositiveInfinity
        && classify_f64(from_bits64(18442240474082181120u64)) == NumericClass::NegativeInfinity
        && classify_f64(from_bits64(9221120237041090560u64)) == NumericClass::NaN
        && classify_f64(from_bits64(18444492273895866368u64)) == NumericClass::NaN
        && classify_f64(from_bits64(1u64)) == NumericClass::Finite
        && classify_f64(from_bits64(9223372036854775809u64)) == NumericClass::Finite
        && classify_f64(3.5f64) == NumericClass::Finite
        && classify_f64(-3.5f64) == NumericClass::Finite
        && classify_f64(widen_f32_to_f64(from_bits32(2147483648u32))) == NumericClass::NegativeZero
        && classify_f32(round_f64_to_f32(from_bits64(9218868437227405312u64))) == NumericClass::PositiveInfinity
        && classify_f64(widen_f32_to_f64(from_bits32(2143289344u32))) == NumericClass::NaN
        && classify_f32(round_f64_to_f32(from_bits64(9221120237041090560u64))) == NumericClass::NaN
        && widen_f32_to_f64(round_i32_to_f32(1i32)) == 1.0f64
        && round_i32_to_f64(1i32) == 1.0f64
        && round_i32_to_f32(16777217i32) == 16777216.0f32
        && round_i32_to_f64(16777217i32) == 16777217.0f64
        && round_f64_to_f32(16777217.0f64) == 16777216.0f32
        && compare_reference_additive_f32(0.0f32, F32::negate(0.0f32), additive_exact32) == AccuracyComparison::Close
        && compare_reference_additive_f32(3.5f32, 3.5f32, additive_exact32) == AccuracyComparison::Close
        && compare_reference_additive_f32(additive_nan32, 1.0f32, additive_exact32) == AccuracyComparison::Different
        && compare_reference_additive_f32(1.0f32, additive_nan32, additive_exact32) == AccuracyComparison::Different
        && compare_reference_additive_f32(additive_nan32, additive_nan32, additive_exact32) == AccuracyComparison::Different
        && compare_reference_additive_f32(additive_infinity32, additive_infinity32, additive_exact32) == AccuracyComparison::Different
        && compare_reference_additive_f32(additive_infinity32, F32::negate(additive_infinity32), additive_exact32) == AccuracyComparison::Different
        && compare_reference_additive_f32(1.0f32, additive_infinity32, additive_exact32) == AccuracyComparison::Different
        && compare_reference_additive_f32(additive_infinity32, 1.0f32, additive_exact32) == AccuracyComparison::Different
        && compare_reference_additive_f32(1.0f32, 1.0f32, ReferenceAdditiveTolerance32 { atol: -1.0f32, rtol: 0.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f32(1.0f32, 1.0f32, ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: -1.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f32(1.0f32, 1.0f32, ReferenceAdditiveTolerance32 { atol: additive_nan32, rtol: 0.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f32(1.0f32, 1.0f32, ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: additive_nan32 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f32(1.0f32, 1.0f32, ReferenceAdditiveTolerance32 { atol: additive_infinity32, rtol: 0.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f32(1.0f32, 1.0f32, ReferenceAdditiveTolerance32 { atol: 0.0f32, rtol: additive_infinity32 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f32(additive_nan32, additive_nan32, ReferenceAdditiveTolerance32 { atol: -1.0f32, rtol: 0.0f32 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f32(0.0f32, 0.0f32, ReferenceAdditiveTolerance32 { atol: F32::negate(0.0f32), rtol: F32::negate(0.0f32) }) == AccuracyComparison::Close
        && compare_reference_additive_f64(0.0f64, F64::negate(0.0f64), additive_exact64) == AccuracyComparison::Close
        && compare_reference_additive_f64(3.5f64, 3.5f64, additive_exact64) == AccuracyComparison::Close
        && compare_reference_additive_f64(additive_nan64, 1.0f64, additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(1.0f64, additive_nan64, additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(additive_nan64, additive_nan64, additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(additive_infinity64, additive_infinity64, additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(additive_infinity64, F64::negate(additive_infinity64), additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(1.0f64, additive_infinity64, additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(additive_infinity64, 1.0f64, additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: -1.0f64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: -1.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: additive_nan64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: additive_nan64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: additive_infinity64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: additive_infinity64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(additive_nan64, additive_nan64, ReferenceAdditiveTolerance64 { atol: -1.0f64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(0.0f64, 0.0f64, ReferenceAdditiveTolerance64 { atol: F64::negate(0.0f64), rtol: F64::negate(0.0f64) }) == AccuracyComparison::Close {
        true -> done()
        _ -> incorrect()
    }
    machine done() {}
    machine incorrect() { crash Trap; }
}
