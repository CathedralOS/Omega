        && compare_reference_additive_f64(additive_infinity64, 1.0f64, additive_exact64) == AccuracyComparison::Different
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: -1.0f64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: -1.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: additive_nan64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: additive_nan64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: additive_infinity64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(1.0f64, 1.0f64, ReferenceAdditiveTolerance64 { atol: 0.0f64, rtol: additive_infinity64 }) == AccuracyComparison::InvalidTolerance
        && compare_reference_additive_f64(additive_nan64, additive_nan64, ReferenceAdditiveTolerance64 { atol: -1.0f64, rtol: 0.0f64 }) == AccuracyComparison::InvalidTolerance
