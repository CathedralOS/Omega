// SOURCE-ONLY PROBE: derived from the full sample, with Console authority
// and process exits removed. It cannot qualify native or Terminal execution.
// Expected exit: 0. Correlated SPD factor/solve with explicit copy to work backing.
// All offsets below use row + column*3; no descriptor or solver is invented.
use omega::language::core::float_operations;

data Main {
    matrix: [f64; 9];
    work: [f64; 9];
    rhs: [f64; 3];
    forward: [f64; 3];
    solution: [f64; 3];
    invalid: [f64; 4];
}

// Explicit fixed-fixture copy, not a substitute shared matrix-copy API.
machine copy_fixture(source: &[f64; 9], destination: &mut [f64; 9]) {
    destination[0] = source[0]; destination[1] = source[1]; destination[2] = source[2];
    destination[3] = source[3]; destination[4] = source[4]; destination[5] = source[5];
    destination[6] = source[6]; destination[7] = source[7]; destination[8] = source[8];
}

machine Main::main(main: &mut Main) {
    main.matrix[0] = 4.0; main.matrix[1] = 2.0; main.matrix[2] = 4.0;
    main.matrix[3] = 2.0; main.matrix[4] = 10.0; main.matrix[5] = -1.0;
    main.matrix[6] = 4.0; main.matrix[7] = -1.0; main.matrix[8] = 9.0;
    main.rhs[0] = 12.0; main.rhs[1] = -21.0; main.rhs[2] = 33.0;
    copy_fixture(&main.matrix, &mut main.work);
    main.work[0] = F64::square_root(main.work[0]);
    main.work[1] = main.work[1] / main.work[0];
    main.work[2] = main.work[2] / main.work[0];
    transition { _ -> second_column(main) }
    state second_column(main: &mut Main) {
        let pivot: f64 = main.work[4] - main.work[1] * main.work[1];
        main.work[4] = F64::square_root(pivot);
        main.work[5] = (main.work[5] - main.work[2] * main.work[1]) / main.work[4];
        transition { _ -> third_column(main) }
    }
    state third_column(main: &mut Main) {
        let pivot: f64 = main.work[8] - main.work[2] * main.work[2] - main.work[5] * main.work[5];
        main.work[8] = F64::square_root(pivot);
        main.work[3] = 0.0; main.work[6] = 0.0; main.work[7] = 0.0;
        transition { _ -> forward_solve(main) }
    }
    state forward_solve(main: &mut Main) {
        main.forward[0] = main.rhs[0] / main.work[0];
        main.forward[1] = (main.rhs[1] - main.work[1] * main.forward[0]) / main.work[4];
        main.forward[2] = (main.rhs[2] - main.work[2] * main.forward[0] - main.work[5] * main.forward[1]) / main.work[8];
        transition { _ -> backward_solve(main) }
    }
    state backward_solve(main: &mut Main) {
        main.solution[2] = main.forward[2] / main.work[8];
        main.solution[1] = (main.forward[1] - main.work[5] * main.solution[2]) / main.work[4];
        main.solution[0] = (main.forward[0] - main.work[1] * main.solution[1] - main.work[2] * main.solution[2]) / main.work[0];
        transition { _ -> check_factor(main) }
    }
    state check_factor(main: &mut Main) {
        transition main.work[0] == 2.0 && main.work[1] == 1.0 && main.work[2] == 2.0
            && main.work[3] == 0.0 && main.work[4] == 3.0 && main.work[5] == -1.0
            && main.work[6] == 0.0 && main.work[7] == 0.0 && main.work[8] == 2.0 {
            true -> check_solution(main)
            _ -> bad(main)
        }
    }
    state check_solution(main: &mut Main) {
        transition main.solution[0] == 1.0 && main.solution[1] == -2.0 && main.solution[2] == 3.0 {
            true -> check_residual(main)
            _ -> bad(main)
        }
    }
    state check_residual(main: &mut Main) {
        let r0: f64 = main.matrix[0] * main.solution[0] + main.matrix[3] * main.solution[1] + main.matrix[6] * main.solution[2] - main.rhs[0];
        let r1: f64 = main.matrix[1] * main.solution[0] + main.matrix[4] * main.solution[1] + main.matrix[7] * main.solution[2] - main.rhs[1];
        let r2: f64 = main.matrix[2] * main.solution[0] + main.matrix[5] * main.solution[1] + main.matrix[8] * main.solution[2] - main.rhs[2];
        transition r0 == 0.0 && r1 == 0.0 && r2 == 0.0 {
            true -> check_source(main)
            _ -> bad(main)
        }
    }
    state check_source(main: &mut Main) {
        transition main.matrix[0] == 4.0 && main.matrix[1] == 2.0 && main.matrix[2] == 4.0
            && main.matrix[3] == 2.0 && main.matrix[4] == 10.0 && main.matrix[5] == -1.0
            && main.matrix[6] == 4.0 && main.matrix[7] == -1.0 && main.matrix[8] == 9.0 {
            true -> nonsymmetric_control(main)
            _ -> bad(main)
        }
    }
    state nonsymmetric_control(main: &mut Main) {
        main.invalid[0] = 4.0; main.invalid[1] = 1.0;
        main.invalid[2] = 2.0; main.invalid[3] = 3.0;
        let result: i32 = classify_two_by_two_fixture(&main.invalid);
        transition result == 1 { true -> indefinite_control(main) _ -> bad(main) }
    }
    state indefinite_control(main: &mut Main) {
        main.invalid[0] = 1.0; main.invalid[1] = 2.0;
        main.invalid[2] = 2.0; main.invalid[3] = 1.0;
        let result: i32 = classify_two_by_two_fixture(&main.invalid);
        transition result == 2 { true -> semidefinite_control(main) _ -> bad(main) }
    }
    state semidefinite_control(main: &mut Main) {
        main.invalid[0] = 1.0; main.invalid[1] = 1.0;
        main.invalid[2] = 1.0; main.invalid[3] = 1.0;
        let result: i32 = classify_two_by_two_fixture(&main.invalid);
        transition result == 2 { true -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) {  }
    state bad(main: &mut Main) {  }
}

// Runtime data controls for exact two-by-two fixtures. These statuses are local
// sample observations, not the pending shared NF14 result/API representation.
// Both off-diagonal entries are read; lower-triangle-only acceptance would fail.
machine classify_two_by_two_fixture(source: &[f64; 4]) -> i32 {
    transition source[1] == source[2] { true -> pivot(source) _ -> nonsymmetric() }
    state nonsymmetric() -> i32 { 1 }
    state pivot(source: &[f64; 4]) {
        transition source[0] > 0.0 { true -> schur(source) _ -> nonpositive() }
    }
    state schur(source: &[f64; 4]) {
        let residual: f64 = source[3] - source[1] * source[1] / source[0];
        transition residual > 0.0 { true -> positive() _ -> nonpositive() }
    }
    state positive() -> i32 { 0 }
    state nonpositive() -> i32 { 2 }
}
