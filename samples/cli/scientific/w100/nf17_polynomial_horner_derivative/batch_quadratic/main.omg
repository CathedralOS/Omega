use omega_language_std::console;
use omega::language::core::binding;
use omega::language::core::float_operations;
use polynomial_horner_derivative;

Binary32 satisfies PolynomialScalar<f32> {
    machine zero() -> f32 { 0.0 }
    machine add(left: f32, right: f32) -> f32 { left + right }
    machine multiply(left: f32, right: f32) -> f32 { left * right }
}

data Main { console: Binding<Console>; }

machine Main::main(main: &mut Main) reaches Console {
    let coefficients: [f32; 3] = [1.0, 2.0, 3.0];
    let queries: [f32; 4] = [-1.0, 0.0, 0.5, 2.0];
    let mut values: [f32; 4] = [0.0, 0.0, 0.0, 0.0];
    let mut derivatives: [f32; 4] = [0.0, 0.0, 0.0, 0.0];
    polynomial_horner_derivative_batch<f32, Binary32>(&coefficients[..], &queries[..], &mut values[..], &mut derivatives[..]);
    let mut short: [f32; 1] = [99.0];
    let status: PolynomialStatus = try_polynomial_horner_derivative_batch<f32, Binary32>(&coefficients[..], &queries[..], &mut short[..], &mut derivatives[..]);
    let empty: [f32; 0] = [];
    let empty_batch: PolynomialStatus = try_polynomial_horner_derivative_batch<f32, Binary32>(&coefficients[..], &empty[..], &mut values[..0], &mut derivatives[..0]);
    let empty_coefficients: PolynomialStatus = try_polynomial_horner_derivative_batch<f32, Binary32>(&empty[..], &queries[..], &mut short[..], &mut derivatives[..]);
    transition {
        values[0] == 2.0 && values[1] == 1.0 && values[2] == 2.75 && values[3] == 17.0
            && derivatives[0] == -4.0 && derivatives[1] == 2.0 && derivatives[2] == 5.0 && derivatives[3] == 14.0
            && status in PolynomialStatus::OutputLengthMismatch && short[0] == 99.0
            && empty_batch in PolynomialStatus::Ready
            && empty_coefficients in PolynomialStatus::EmptyCoefficients -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.write_line("nf17 batch: quadratic values and slopes"); main.console.exit_process(0); }
    state bad(main: &mut Main) { main.console.exit_process(72); }
}
