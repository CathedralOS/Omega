use {omega}/language/core/matrix_layout.omg;
use {omega}/language/core/process_exit.omg;
// Expected exit: 41
data Main { }
machine equals(backing: @[i32], layout: @|matrix_layout|::Layout2, row: u64, column: u64, expected: i32) -> bool {
    let result: |matrix_layout|::ReadResult = |matrix_layout|::try_read(backing, layout, row, column);
    transition result { |matrix_layout|::ReadResult::Ok { value } -> (value == expected), |matrix_layout|::ReadResult::Invalid -> false }
}
machine is_invalid(result: |matrix_layout|::ReadResult) -> bool {
    transition result { |matrix_layout|::ReadResult::Invalid -> true, |matrix_layout|::ReadResult::Ok { value } -> false }
}

// Matched valid companion to invalid_control's descriptor-based checked call.
machine last_of_valid_layout(backing: @[i32], layout: @|matrix_layout|::Layout2) -> i32
requires backing.length == 6
requires layout.rows == 2 && layout.columns == 3
requires layout.origin == 0 && layout.row_stride == 1 && layout.column_stride == 2 {
    let offset: u64 = layout.origin + layout.row_stride + 2 * layout.column_stride;
    |matrix_layout|::read_checked(backing, offset)
}

machine main(context: @mutable Main) reaches |process_exit|::ProcessExit {
    let backing: [i32; 6] = [1, 4, 2, 5, 3, 6];
    let layout: |matrix_layout|::Layout2 = |matrix_layout|::Layout2 { rows: 2, columns: 3, origin: 0, row_stride: 1, column_stride: 2 };
    let empty: |matrix_layout|::Layout2 = |matrix_layout|::Layout2 { rows: 0, columns: 3, origin: 0, row_stride: 1, column_stride: 0 };
    let swapped: |matrix_layout|::Layout2 = |matrix_layout|::transpose(@layout);
    let huge: |matrix_layout|::Layout2 = |matrix_layout|::Layout2 { rows: 3, columns: 1, origin: 0, row_stride: 18446744073709551615, column_stride: 0 };
    let zero: [i32; 0] = [];
    let checked_last: i32 = last_of_valid_layout(@backing, @layout);
    let full_valid: bool = |matrix_layout|::valid_readonly(@layout, 6);
    let full_mutable: bool = |matrix_layout|::valid_mutable(@layout, 6);
    let empty_valid: bool = |matrix_layout|::valid_readonly(@empty, 0);
    let empty_mutable: bool = |matrix_layout|::valid_mutable(@empty, 0);
    let overflow_rejected: bool = !|matrix_layout|::valid_readonly(@huge, 6);
    let invalid_layout_read: |matrix_layout|::ReadResult = |matrix_layout|::try_read(@backing, @huge, 0, 0);
    let invalid_layout_rejected: bool = is_invalid(invalid_layout_read);
    let empty_read: |matrix_layout|::ReadResult = |matrix_layout|::try_read(@zero, @empty, 0, 0);
    let outside: |matrix_layout|::ReadResult = |matrix_layout|::try_read(@backing, @layout, 2, 0);
    let backing_view: @[i32] = @backing[..];
    transition empty_read { |matrix_layout|::ReadResult::Invalid -> outside_check(context, backing_view, @layout, @swapped, outside, invalid_layout_rejected && checked_last == 6 && full_valid && full_mutable && empty_valid && empty_mutable && overflow_rejected), |matrix_layout|::ReadResult::Ok { value } -> bad(context) }
    machine outside_check(context: @mutable Main, backing: @[i32], layout: @|matrix_layout|::Layout2, swapped: @|matrix_layout|::Layout2, outside: |matrix_layout|::ReadResult, valid: bool) {
        transition outside { |matrix_layout|::ReadResult::Invalid -> entries(context, backing, layout, swapped, valid), |matrix_layout|::ReadResult::Ok { value } -> bad(context) }
    }
    machine entries(context: @mutable Main, backing: @[i32], layout: @|matrix_layout|::Layout2, swapped: @|matrix_layout|::Layout2, valid: bool) {
        let first: bool = equals(backing, layout, 0, 0, 1);
        let second: bool = equals(backing, layout, 0, 1, 2);
        let third: bool = equals(backing, layout, 0, 2, 3);
        let fourth: bool = equals(backing, layout, 1, 0, 4);
        let fifth: bool = equals(backing, layout, 1, 1, 5);
        let sixth: bool = equals(backing, layout, 1, 2, 6);
        let transposed: bool = equals(backing, swapped, 2, 1, 6);
        transition valid && first && second && third && fourth && fifth && sixth && transposed {
            true -> good(context),
            false -> bad(context)
        }
    }
    machine good(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(41); }
    machine bad(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
