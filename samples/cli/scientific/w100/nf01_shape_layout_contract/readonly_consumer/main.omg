use numerics::arrays::shape_layout_contract;
use omega_language_std::console;
data Main { }
machine equals(backing: &[i32], layout: &Layout2, row: u64, column: u64, expected: i32) -> bool {
    let result: ReadResult = try_read(backing, layout, row, column);
    transition result { ReadResult::Ok { value } -> (value == expected) ReadResult::Invalid -> false }
}
machine is_invalid(result: ReadResult) -> bool {
    transition result { ReadResult::Invalid -> true ReadResult::Ok { value } -> false }
}

// Matched valid companion to invalid_control's descriptor-based checked call.
machine last_of_valid_layout(backing: &[i32], layout: &Layout2) -> i32
requires backing.len == 6
requires layout.rows == 2 && layout.columns == 3
requires layout.origin == 0 && layout.row_stride == 1 && layout.column_stride == 2 {
    let offset: u64 = layout.origin + layout.row_stride + 2 * layout.column_stride;
    read_checked(backing, offset)
}

machine Main::main(context: &mut Main) reaches Console {
    let backing: [i32; 6] = [1, 4, 2, 5, 3, 6];
    let layout: Layout2 = Layout2 { rows: 2, columns: 3, origin: 0, row_stride: 1, column_stride: 2 };
    let empty: Layout2 = Layout2 { rows: 0, columns: 3, origin: 0, row_stride: 1, column_stride: 0 };
    let swapped: Layout2 = transpose(&layout);
    let huge: Layout2 = Layout2 { rows: 3, columns: 1, origin: 0, row_stride: 18446744073709551615, column_stride: 0 };
    let zero: [i32; 0] = [];
    let checked_last: i32 = last_of_valid_layout(&backing, &layout);
    let full_valid: bool = valid_readonly(&layout, 6);
    let full_mutable: bool = valid_mutable(&layout, 6);
    let empty_valid: bool = valid_readonly(&empty, 0);
    let empty_mutable: bool = valid_mutable(&empty, 0);
    let overflow_rejected: bool = !valid_readonly(&huge, 6);
    let invalid_layout_read: ReadResult = try_read(&backing, &huge, 0, 0);
    let invalid_layout_rejected: bool = is_invalid(invalid_layout_read);
    let empty_read: ReadResult = try_read(&zero, &empty, 0, 0);
    let outside: ReadResult = try_read(&backing, &layout, 2, 0);
    let backing_view: &[i32] = &backing[..];
    transition empty_read { ReadResult::Invalid -> outside_check(context, backing_view, &layout, &swapped, outside, invalid_layout_rejected && checked_last == 6 && full_valid && full_mutable && empty_valid && empty_mutable && overflow_rejected) ReadResult::Ok { value } -> bad(context) }
    state outside_check(context: &mut Main, backing: &[i32], layout: &Layout2, swapped: &Layout2, outside: ReadResult, valid: bool) {
        transition outside { ReadResult::Invalid -> entries(context, backing, layout, swapped, valid) ReadResult::Ok { value } -> bad(context) }
    }
    state entries(context: &mut Main, backing: &[i32], layout: &Layout2, swapped: &Layout2, valid: bool) {
        let first: bool = equals(backing, layout, 0, 0, 1);
        let second: bool = equals(backing, layout, 0, 1, 2);
        let third: bool = equals(backing, layout, 0, 2, 3);
        let fourth: bool = equals(backing, layout, 1, 0, 4);
        let fifth: bool = equals(backing, layout, 1, 1, 5);
        let sixth: bool = equals(backing, layout, 1, 2, 6);
        let transposed: bool = equals(backing, swapped, 2, 1, 6);
        transition valid && first && second && third && fourth && fifth && sixth && transposed {
            true -> good(context)
            false -> bad(context)
        }
    }
    state good(context: &mut Main) { Console::exit_process(41); }
    state bad(context: &mut Main) { Console::exit_process(1); }
}
