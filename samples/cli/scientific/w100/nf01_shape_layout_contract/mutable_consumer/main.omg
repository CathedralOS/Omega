use numerics::arrays::shape_layout_contract;
use omega_language_std::console;
data Main { }
machine Main::main(context: &mut Main) reaches Console {
    let mut backing: [i32; 9] = [1, 4, 99, 2, 5, 99, 3, 6, 99];
    let padded: Layout2 = Layout2 { rows: 2, columns: 3, origin: 0, row_stride: 1, column_stride: 3 };
    let unusual: Layout2 = Layout2 { rows: 2, columns: 2, origin: 0, row_stride: 2, column_stride: 3 };
    let overlap: Layout2 = Layout2 { rows: 3, columns: 2, origin: 0, row_stride: 2, column_stride: 4 };
    let outside: Layout2 = Layout2 { rows: 2, columns: 3, origin: 1, row_stride: 1, column_stride: 4 };
    let padded_valid: bool = valid_mutable(&padded, 9);
    let unusual_valid: bool = valid_mutable(&unusual, 9);
    let overlap_readable: bool = valid_readonly(&overlap, 9);
    let overlap_rejected: bool = !valid_mutable(&overlap, 9);
    let bounds_rejected: bool = !valid_readonly(&outside, 9);
    let wrote: bool = try_write(&mut backing, &padded, 1, 2, 60);
    let refused: bool = !try_write(&mut backing, &overlap, 0, 0, 88);
    let refused_bounds: bool = !try_write(&mut backing, &outside, 0, 0, 88);
    transition padded_valid && unusual_valid && overlap_readable && overlap_rejected && bounds_rejected && wrote && refused && refused_bounds
        && backing[0] == 1 && backing[1] == 4 && backing[2] == 99 && backing[3] == 2
        && backing[4] == 5 && backing[5] == 99 && backing[6] == 3 && backing[7] == 60 && backing[8] == 99 {
        true -> good(context)
        false -> bad(context)
    }
    state good(context: &mut Main) { Console::exit_process(73); }
    state bad(context: &mut Main) { Console::exit_process(1); }
}
