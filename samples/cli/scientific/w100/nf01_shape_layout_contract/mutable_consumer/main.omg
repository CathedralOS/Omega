use {omega}/language/core/matrix_layout.omg;
use {omega}/language/core/process_exit.omg;
// Expected exit: 73
data Main { }
machine main(context: @mutable Main) reaches |process_exit|::ProcessExit {
    let mutable backing: [i32; 9] = [1, 4, 99, 2, 5, 99, 3, 6, 99];
    let padded: |matrix_layout|::Layout2 = |matrix_layout|::Layout2 { rows: 2, columns: 3, origin: 0, row_stride: 1, column_stride: 3 };
    let unusual: |matrix_layout|::Layout2 = |matrix_layout|::Layout2 { rows: 2, columns: 2, origin: 0, row_stride: 2, column_stride: 3 };
    let overlap: |matrix_layout|::Layout2 = |matrix_layout|::Layout2 { rows: 3, columns: 2, origin: 0, row_stride: 2, column_stride: 4 };
    let outside: |matrix_layout|::Layout2 = |matrix_layout|::Layout2 { rows: 2, columns: 3, origin: 1, row_stride: 1, column_stride: 4 };
    let padded_valid: bool = |matrix_layout|::valid_mutable(@padded, 9);
    let unusual_valid: bool = |matrix_layout|::valid_mutable(@unusual, 9);
    let overlap_readable: bool = |matrix_layout|::valid_readonly(@overlap, 9);
    let overlap_rejected: bool = !|matrix_layout|::valid_mutable(@overlap, 9);
    let bounds_rejected: bool = !|matrix_layout|::valid_readonly(@outside, 9);
    let wrote: bool = |matrix_layout|::try_write(@mutable backing, @padded, 1, 2, 60);
    let refused: bool = !|matrix_layout|::try_write(@mutable backing, @overlap, 0, 0, 88);
    let refused_bounds: bool = !|matrix_layout|::try_write(@mutable backing, @outside, 0, 0, 88);
    transition padded_valid && unusual_valid && overlap_readable && overlap_rejected && bounds_rejected && wrote && refused && refused_bounds
        && backing[0] == 1 && backing[1] == 4 && backing[2] == 99 && backing[3] == 2
        && backing[4] == 5 && backing[5] == 99 && backing[6] == 3 && backing[7] == 60 && backing[8] == 99 {
        true -> good(context),
        false -> bad(context)
    }
    machine good(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(73); }
    machine bad(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
