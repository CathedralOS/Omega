use numerics::arrays::shape_layout_contract;

// This descriptor's last coordinate is outside the six-element backing.
// The explicit arrival facts isolate the intended bounds violation from
// arithmetic policy and caller-provided runtime invalid-data handling.
machine last_of_invalid_layout(backing: &[i32], layout: &Layout2) -> i32
requires backing.len == 6
requires layout.rows == 2 && layout.columns == 3
requires layout.origin == 1 && layout.row_stride == 1 && layout.column_stride == 2 {
    let offset: u64 = layout.origin + layout.row_stride + 2 * layout.column_stride;
    read_checked(backing, offset)
}

machine main() -> i32 {
    let backing: [i32; 6] = [1, 4, 2, 5, 3, 6];
    let invalid: Layout2 = Layout2 { rows: 2, columns: 3, origin: 1, row_stride: 1, column_stride: 2 };
    last_of_invalid_layout(&backing, &invalid)
}
