use omega_language_std::console;
use omega::language::core::float_operations;
use numerics::complex::complex_carrier_ops::Complex;
use numerics::complex::complex_carrier_ops::ComplexF32;
use numerics::complex::complex_carrier_ops::ComplexMagnitude;
use numerics::numeric::numeric_accuracy_policy::AccuracyComparison;
use numerics::numeric::numeric_accuracy_policy::ReferenceAdditiveTolerance32;
use numerics::numeric::numeric_accuracy_policy::compare_reference_additive_f32;
// Four quarter-turns and their zero sum. Every destination is a separate carrier.
data Main {
    point: Complex<f32>;
    rotation: Complex<f32>;
    first: Complex<f32>;
    second: Complex<f32>;
    third: Complex<f32>;
    fourth: Complex<f32>;
    pair: Complex<f32>;
    triple: Complex<f32>;
    total: Complex<f32>;
    conjugated: Complex<f32>;
    large: Complex<f32>;
    zero: Complex<f32>;
    exceptional: Complex<f32>;
}
machine Main::main(main: &mut Main) reaches Console {
    main.point = Complex { real: 1.0, imaginary: 0.0 };
    main.rotation = Complex { real: 0.0, imaginary: 1.0 };
    ComplexF32::multiply(&mut main.first, &main.point, &main.rotation);
    ComplexF32::multiply(&mut main.second, &main.first, &main.rotation);
    ComplexF32::multiply(&mut main.third, &main.second, &main.rotation);
    ComplexF32::multiply(&mut main.fourth, &main.third, &main.rotation);
    ComplexF32::add(&mut main.pair, &main.first, &main.second);
    ComplexF32::add(&mut main.triple, &main.pair, &main.third);
    ComplexF32::add(&mut main.total, &main.triple, &main.fourth);
    ComplexF32::conjugate(&mut main.conjugated, &main.first);
    let first_norm: f32 = ComplexF32::norm_squared(&main.first);
    let second_norm: f32 = ComplexF32::norm_squared(&main.second);
    let third_norm: f32 = ComplexF32::norm_squared(&main.third);
    let fourth_norm: f32 = ComplexF32::norm_squared(&main.fourth);
    transition main.first.real == 0.0 && main.first.imaginary == 1.0
        && main.second.real == -1.0 && main.second.imaginary == 0.0
        && main.third.real == 0.0 && main.third.imaginary == -1.0
        && main.fourth.real == 1.0 && main.fourth.imaginary == 0.0
        && main.total.real == 0.0 && main.total.imaginary == 0.0
        && main.conjugated.real == 0.0 && main.conjugated.imaginary == -1.0
        && main.point.real == 1.0 && main.point.imaginary == 0.0
        && first_norm == 1.0 && second_norm == 1.0 && third_norm == 1.0 && fourth_norm == 1.0 {
        true -> large(main) _ -> bad(main)
    }
    state large(main: &mut Main) {
        main.large = Complex { real: 3.0e20, imaginary: 4.0e20 };
        let direct: f32 = ComplexF32::norm_squared(&main.large);
        let direct_finite: bool = F32::is_finite(direct);
        let outcome: ComplexMagnitude<f32> = ComplexF32::try_magnitude(&main.large);
        transition direct_finite { false -> magnitude(main, outcome) _ -> bad(main) }
    }
    state magnitude(main: &mut Main, outcome: ComplexMagnitude<f32>) {
        transition outcome {
            ComplexMagnitude::Value { value } -> check_magnitude(main, value)
            _ -> bad(main)
        }
    }
    state check_magnitude(main: &mut Main, value: f32) {
        let comparison: AccuracyComparison = compare_reference_additive_f32(value, 5.0e20,
            ReferenceAdditiveTolerance32 { atol: 0.0, rtol: 2.0e-7 });
        transition comparison {
            AccuracyComparison::Close -> frozen_interval(main, value)
            _ -> bad(main)
        }
    }
    // Retain the originally frozen interval as well as the canonical policy.
    state frozen_interval(main: &mut Main, value: f32) {
        transition value >= 4.999999e20 && value <= 5.000001e20 { true -> zero(main) _ -> bad(main) }
    }
    state zero(main: &mut Main) {
        main.zero = Complex { real: 0.0, imaginary: 0.0 };
        let outcome: ComplexMagnitude<f32> = ComplexF32::try_magnitude(&main.zero);
        transition outcome { ComplexMagnitude::Value { value } -> check_zero(main, value) _ -> bad(main) }
    }
    state check_zero(main: &mut Main, value: f32) {
        transition value == 0.0 { true -> nonfinite(main, 0.0) _ -> bad(main) }
    }
    state nonfinite(main: &mut Main, zero: f32) {
        main.exceptional.real = 1.0 / zero;
        main.exceptional.imaginary = 0.0;
        let outcome: ComplexMagnitude<f32> = ComplexF32::try_magnitude(&main.exceptional);
        transition outcome { ComplexMagnitude::NonFiniteInput -> nan(main, zero) _ -> bad(main) }
    }
    state nan(main: &mut Main, zero: f32) {
        main.exceptional.real = zero / zero;
        let outcome: ComplexMagnitude<f32> = ComplexF32::try_magnitude(&main.exceptional);
        transition outcome { ComplexMagnitude::NonFiniteInput -> overflow(main) _ -> bad(main) }
    }
    state overflow(main: &mut Main) {
        main.exceptional = Complex { real: 3.4028234663852886e38, imaginary: 3.4028234663852886e38 };
        let outcome: ComplexMagnitude<f32> = ComplexF32::try_magnitude(&main.exceptional);
        transition outcome { ComplexMagnitude::Overflow -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
