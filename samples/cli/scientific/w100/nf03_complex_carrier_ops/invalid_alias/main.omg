use {omega}/language/core/complex/complex.omg;
use {omega}/language/core/process_exit.omg;
// Must reject: a live mutable destination overlaps a shared input.
data Main { value: |complex|::Complex<f64>; other: |complex|::Complex<f64>; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit {
    main.value = |complex|::Complex { real: 3.0, imaginary: 4.0 };
    main.other = |complex|::Complex { real: -2.0, imaginary: 0.5 };
    |complex|::ComplexF64::add(@mutable main.value, @main.value, @main.other);
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
