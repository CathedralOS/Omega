use omega_language_std::Console;
use omega::language::core::complex::Complex;
use omega::language::core::complex::ComplexF64;
// Must reject: a live mutable destination overlaps a shared input.
data Main { value: Complex<f64>; other: Complex<f64>; }
machine Main::main(main: &mut Main) reaches Console {
    main.value = Complex { real: 3.0, imaginary: 4.0 };
    main.other = Complex { real: -2.0, imaginary: 0.5 };
    ComplexF64::add(&mut main.value, &main.value, &main.other);
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
