use omega_language_std::console;
use omega::language::core::float_operations;
use numerics::complex::complex_carrier_ops::Complex;
use numerics::complex::complex_carrier_ops::ComplexF64;
use numerics::complex::complex_carrier_ops::ComplexMagnitude;
use numerics::numeric::numeric_accuracy_policy::AccuracyComparison;
use numerics::numeric::numeric_accuracy_policy::ReferenceAdditiveTolerance64;
use numerics::numeric::numeric_accuracy_policy::compare_reference_additive_f64;
// Complex power S = V * conjugate(I), with borrowed immutable V and I.
data Main {
    voltage: Complex<f64>;
    current: Complex<f64>;
    conjugated: Complex<f64>;
    power: Complex<f64>;
    sum: Complex<f64>;
    real_only: Complex<f64>;
    large: Complex<f64>;
}
machine Main::main(main: &mut Main) reaches Console {
    main.voltage = Complex { real: 3.0, imaginary: 4.0 };
    main.current = Complex { real: -2.0, imaginary: 0.5 };
    ComplexF64::conjugate(&mut main.conjugated, &main.current);
    ComplexF64::multiply(&mut main.power, &main.voltage, &main.conjugated);
    ComplexF64::add(&mut main.sum, &main.voltage, &main.current);
    let norm: f64 = ComplexF64::norm_squared(&main.voltage);
    main.real_only = Complex { real: 7.0, imaginary: 0.0 };
    let real_norm: f64 = ComplexF64::norm_squared(&main.real_only);
    transition main.power.real == -4.0 && main.power.imaginary == -9.5
        && main.sum.real == 1.0 && main.sum.imaginary == 4.5
        && main.voltage.real == 3.0 && main.voltage.imaginary == 4.0
        && main.current.real == -2.0 && main.current.imaginary == 0.5
        && main.conjugated.real == -2.0 && main.conjugated.imaginary == -0.5
        && norm == 25.0 && real_norm == 49.0 {
        true -> large(main)
        _ -> bad(main)
    }
    state large(main: &mut Main) {
        main.large = Complex { real: 3.0e200, imaginary: 4.0e200 };
        let direct: f64 = ComplexF64::norm_squared(&main.large);
        let direct_finite: bool = F64::is_finite(direct);
        let outcome: ComplexMagnitude<f64> = ComplexF64::try_magnitude(&main.large);
        transition direct_finite { false -> magnitude(main, outcome) _ -> bad(main) }
    }
    state magnitude(main: &mut Main, outcome: ComplexMagnitude<f64>) {
        transition outcome {
            ComplexMagnitude::Value { value } -> check_magnitude(main, value)
            _ -> bad(main)
        }
    }
    state check_magnitude(main: &mut Main, value: f64) {
        let comparison: AccuracyComparison = compare_reference_additive_f64(value, 5.0e200,
            ReferenceAdditiveTolerance64 { atol: 0.0, rtol: 2.0e-15 });
        transition comparison {
            AccuracyComparison::Close -> frozen_interval(main, value)
            _ -> bad(main)
        }
    }
    // Retain the originally frozen interval as well as the canonical policy.
    state frozen_interval(main: &mut Main, value: f64) {
        transition value >= 4.99999999999999e200 && value <= 5.00000000000001e200 {
            true -> good(main) _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
