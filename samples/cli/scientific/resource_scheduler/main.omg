use domain/input/input.omg;
use domain/model/model.omg;
use domain/solver/solver.omg;
use domain/verify/verify.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete IND02 entrypoint: finite stdin -> validated model -> exact schedule
// -> independent invariant walk -> machine-readable output. No closing pause.
// The sample sweep feeds `input.txt` and scores the `expected_*` files; this
// header pins the closed-stdin INVALID response of a manual empty-stdin run.
// Expected exit: 2.
// Expected output contains: INVALID

data Main { }

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable input: |input|::Input;
    let received: |console|::LineReadResult = block |console|::Console::read_line(@mutable input.bytes[..]);
    transition received {
        |console|::LineReadResult::LineComplete { count } -> length(main, @input, count),
        |console|::LineReadResult::EndOfInput { count } -> length(main, @input, count),
        _ -> invalid(main)
    }
    machine length(main: @mutable Main, input: @|input|::Input, count: u64) {
        transition count <= 256 {
            true -> parse_request(main, input, count as i32 +Wrapping),
            _ -> invalid(main)
        }
    }
    machine parse_request(main: @mutable Main, input: @|input|::Input, count: i32 in Wrapping) {
        let mutable tokens: |input|::Tokens;
        let accepted: bool = |input|::parse(input, count, @mutable tokens);
        transition accepted {
            true -> model(main, @tokens),
            _ -> invalid(main)
        }
    }
    machine model(main: @mutable Main, tokens: @|input|::Tokens) {
        let mutable problem: |model|::Problem;
        let valid: bool = |input|::decode(tokens, @mutable problem);
        transition valid {
            true -> schedule(main, @problem),
            _ -> invalid(main)
        }
    }
    machine schedule(main: @mutable Main, problem: @|model|::Problem) {
        let mutable result: |model|::Schedule;
        let possible: bool = |solver|::solve(problem, @mutable result);
        transition possible {
            true -> verify_result(main, problem, @result),
            _ -> impossible(main)
        }
    }
    machine verify_result(main: @mutable Main, problem: @|model|::Problem, result: @|model|::Schedule) {
        let valid: bool = |verify|::verify(problem, result);
        transition valid {
            true -> render(main, problem, result, 0),
            _ -> internal_failure(main)
        }
    }
    machine render(main: @mutable Main, problem: @|model|::Problem, result: @|model|::Schedule,
                  index: i32 in Wrapping) {
        transition index >= 0 && index < problem.count && index < 4 {
            true -> row(main, problem, result, index),
            _ -> finish(main, result)
        }
    }
    machine row(main: @mutable Main, problem: @|model|::Problem, result: @|model|::Schedule,
               index: i32 in Wrapping) {
        |console|::Console::write("TASK ");
        print_number(main, index);
        |console|::Console::write(" START ");
        print_number(main, result.starts[index]);
        |console|::Console::write(" END ");
        print_number(main, result.ends[index]);
        |console|::Console::write_line("");
        transition { _ -> render(main, problem, result, index + 1) }
    }
    machine finish(main: @mutable Main, result: @|model|::Schedule) {
        |console|::Console::write("MAKESPAN ");
        print_number(main, result.makespan);
        |console|::Console::write_line("");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("INVALID");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine impossible(main: @mutable Main) {
        |console|::Console::write_line("IMPOSSIBLE");
        |process_exit|::ProcessExit::exit_process(3);
    }
    machine internal_failure(main: @mutable Main) {
        |console|::Console::write_line("INVARIANT_FAILURE");
        |process_exit|::ProcessExit::exit_process(4);
    }
}
// The public caller prints only IDs and verified times (0..20). Two digits
// make output comparisons unambiguous without a shared formatting dependency.
machine print_number(main: @mutable Main, value: i32 in Wrapping) reaches |process_authority|::StandardOutput {
    |console|::Console::write_byte((48 + value / 10) as i32);
    |console|::Console::write_byte((48 + value % 10) as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
