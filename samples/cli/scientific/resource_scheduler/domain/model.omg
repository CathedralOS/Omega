// Private bounded scheduling data. All arithmetic is integral; the admitted
// bounds keep it far inside i32 even though the carrier uses Wrapping.
data Problem {
    count: i32 in Wrapping;
    capacity_a: i32 in Wrapping;
    capacity_b: i32 in Wrapping;
    durations: [i32 in Wrapping; 4];
    demand_a: [i32 in Wrapping; 4];
    demand_b: [i32 in Wrapping; 4];
    predecessors: [i32 in Wrapping; 4];
}
data Schedule {
    starts: [i32 in Wrapping; 4];
    ends: [i32 in Wrapping; 4];
    makespan: i32 in Wrapping;
    feasible: bool;
}
machine reset_schedule(schedule: &mut Schedule) {
    schedule.starts = [0 - 1, 0 - 1, 0 - 1, 0 - 1];
    schedule.ends = [0, 0, 0, 0];
    schedule.makespan = 0;
    schedule.feasible = false;
}
// Integer division decodes one predecessor bit without an imported bitset.
machine predecessor(mask: i32 in Wrapping, task: i32 in Wrapping) -> bool {
    transition task {
        0 -> (mask % 2 == 1)
        1 -> ((mask / 2) % 2 == 1)
        2 -> ((mask / 4) % 2 == 1)
        3 -> ((mask / 8) % 2 == 1)
        _ -> false
    }
}
