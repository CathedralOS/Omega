use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete current-main reproduction: a guarded successor borrows a local
// fixed byte array. The same source is required to print the actual bytes.
data Main { choice: i32; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let bytes: [u8; 4] = "TEST";
    transition main.choice {
        0 -> show(main, @bytes),
        1 -> show(main, @bytes),
        _ -> show(main, @bytes)
    }
    machine show(main: @mutable Main, bytes: @[u8; 4]) {
        |console|::Console::write_line(bytes);
        |process_exit|::ProcessExit::exit_process(0);
    }
}
