use design/certificate/certificate.omg;
use design/model/model.omg;
use design/output/output.omg;
use design/search/search.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 64.
// Expected output contains: INVALID:
// The sample harness supplies EOF; positive design cases use data/*.stdin.
// One finite request: treatments,subjects,carryover-cap,forbidden-edge + LF.
// Every result is an actual allocation or exhaustive bounded infeasibility.

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable input: [u8; 16];
    let observed: |console|::LineReadResult = block |console|::Console::read_line(@mutable input[..]);
    transition observed {
        |console|::LineReadResult::LineComplete { count } -> length(@input, count),
        _ -> invalid()
    }
    machine length(input: @[u8; 16], count: u64) {
        transition count == 8 {
            true -> syntax(input),
            false -> invalid()
        }
    }
    machine syntax(input: @[u8; 16]) {
        transition input[1] == 44 && input[3] == 44 && input[5] == 44 && input[7] == 10
            && input[0] >= 48 && input[0] <= 57 && input[2] >= 48 && input[2] <= 57
            && input[4] >= 48 && input[4] <= 57 && input[6] >= 48 && input[6] <= 57 {
            true -> parse(input),
            false -> invalid()
        }
    }
    machine parse(input: @[u8; 16]) {
        let mutable request: |model|::Request;
        request.treatments = (|numeric_conversion|::widen_u8_to_i32(input[0]) as i32 +Wrapping) - 48;
        request.subjects = (|numeric_conversion|::widen_u8_to_i32(input[2]) as i32 +Wrapping) - 48;
        request.cap = (|numeric_conversion|::widen_u8_to_i32(input[4]) as i32 +Wrapping) - 48;
        request.forbidden = (|numeric_conversion|::widen_u8_to_i32(input[6]) as i32 +Wrapping) - 48;
        transition (request.treatments == 2 || request.treatments == 3)
            && request.subjects >= 1 && request.subjects <= 6 && request.cap <= 6
            && request.forbidden <= 6
            && (request.treatments == 3 || request.forbidden == 0 || request.forbidden == 1 || request.forbidden == 3) {
            true -> search(@request),
            false -> invalid()
        }
    }
    machine search(request: @|model|::Request) {
        let mutable allocation: |model|::Allocation;
        let found: bool = |search|::solve(request, @mutable allocation);
        transition found {
            true -> verify(request, @mutable allocation),
            false -> infeasible()
        }
    }
    machine verify(request: @|model|::Request, allocation: @mutable |model|::Allocation) {
        let verified: bool = |certificate|::certify(request, allocation);
        transition verified {
            true -> report(request, allocation),
            false -> defect()
        }
    }
    machine report(request: @|model|::Request, allocation: @|model|::Allocation) {
        |output|::emit(request, allocation);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine infeasible() {
        |console|::Console::write_line("INFEASIBLE: all subject-sequence multisets exhausted");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine invalid() {
        |console|::Console::write_line("INVALID: expected T,N,C,F followed by LF; T=2..3 N=1..6 C=0..6 F=0..6");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine defect() {
        |console|::Console::write_line("DEFECT: selected allocation failed recount");
        |process_exit|::ProcessExit::exit_process(70);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
