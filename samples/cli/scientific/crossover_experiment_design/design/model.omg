// ADD17 owns all search storage. Subjects are exchangeable: sorting sequence
// identifiers removes only subject relabelings, preserving every count constraint.
data Request {
    treatments: i32 in Wrapping;
    subjects: i32 in Wrapping;
    cap: i32 in Wrapping;
    forbidden: i32 in Wrapping;
}
data Allocation {
    sequences: [i32 in Wrapping; 6];
    cells: [i32 in Wrapping; 18];
    periods: [i32 in Wrapping; 9];
    carryover: [i32 in Wrapping; 9];
}

machine treatment(treatments: i32 in Wrapping, sequence: i32 in Wrapping, period: i32 in Wrapping) -> i32 in Wrapping {
    transition treatments == 2 {
        true -> two(sequence, period)
        false -> three(sequence, period)
    }
    machine two(sequence: i32 in Wrapping, period: i32 in Wrapping) -> i32 in Wrapping {
        transition sequence == 0 { true -> period false -> (1 - period) }
    }
    machine three(sequence: i32 in Wrapping, period: i32 in Wrapping) -> i32 in Wrapping {
        transition sequence {
            0 -> first(period, 0, 1, 2)
            1 -> first(period, 0, 2, 1)
            2 -> first(period, 1, 0, 2)
            3 -> first(period, 1, 2, 0)
            4 -> first(period, 2, 0, 1)
            _ -> first(period, 2, 1, 0)
        }
    }
    machine first(period: i32 in Wrapping, a: i32 in Wrapping, b: i32 in Wrapping, c: i32 in Wrapping) -> i32 in Wrapping {
        transition period { 0 -> a 1 -> b _ -> c }
    }
}
machine edge_code(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping {
    transition a * 3 + b { 1 -> 1 2 -> 2 3 -> 3 5 -> 4 6 -> 5 7 -> 6 _ -> 0 }
}
