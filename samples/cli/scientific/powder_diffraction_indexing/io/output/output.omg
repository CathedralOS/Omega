use domain/indexing/indexing.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// These exact metadata values are bounded by the search (at most 765
// hypotheses and Miller components <=4), far below integer precision loss.
public machine integer(value: u64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    |console|::Console::write(" ");
    transition { _ -> digit(value, 10000000000000000000, false) }
    machine digit(value: u64, place: u64, started: bool) requires place > 0 {
        let character: u64 = value / place;
        transition {
            character >= 10 -> limit(),
            character != 0 || started || place == 1 -> write(value, place, character),
            _ -> advance(value, place, false)
        }
    }
    machine write(value: u64, place: u64, character: u64) requires place > 0, character < 10 {
        |console|::Console::write_byte(|numeric_conversion|::narrow_u64_to_i32_saturating(character + 48)); transition { _ -> advance(value, place, true) }
    }
    machine advance(value: u64, place: u64, started: bool) requires place > 0 {
        transition place >= 10 { true -> digit(value % place, place / 10, started), false -> done() }
    }
    machine done() { }
    machine limit() { |process_exit|::ProcessExit::exit_process(70); }
}
// Signed integers in 1e-12 units preserve more than the acceptance precision.
public machine number(value: f64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    let scaled: i64 in Saturating = |float_operations|::I64::from_f64(value * 1000000000000.0);
    let integer: i64 in Wrapping = scaled as -Saturating +Wrapping;
    |console|::Console::write(" ");
    transition integer < 0 { true -> negative(integer), false -> positive(integer) }
    machine negative(value: i64 in Wrapping) { |console|::Console::write("-"); transition { _ -> digit(0 - value, 1000000000000000000, false) } }
    machine positive(value: i64 in Wrapping) { transition { _ -> digit(value, 1000000000000000000, false) } }
    machine digit(value: i64 in Wrapping, place: i64 in Wrapping, started: bool) requires place > 0 {
        let character: i64 in Wrapping = value / place;
        transition character != 0 || started || place == 1 { true -> write(value, place, character), false -> advance(value, place, false) }
    }
    machine write(value: i64 in Wrapping, place: i64 in Wrapping, character: i64 in Wrapping) requires place > 0 {
        |console|::Console::write_byte(|numeric_conversion|::narrow_i64_to_i32_saturating((character + 48) as i64)); transition { _ -> advance(value, place, true) }
    }
    machine advance(value: i64 in Wrapping, place: i64 in Wrapping, started: bool) requires place > 0 {
        transition place >= 10 { true -> digit(value % place, place / 10, started), false -> done() }
    }
    machine done() { }
}
public machine report(problem: @|indexing|::Problem, kind: u64, mask: u64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    |console|::Console::write("hypothesis"); integer(kind); number(problem.lattice); number(problem.scale); |console|::Console::write_line("");
    peaks(problem, kind, 0); missing(problem, mask, 0);
    |console|::Console::write_line("end");
}
machine peaks(problem: @|indexing|::Problem, kind: u64, index: u64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    transition index < problem.count && index < 6 { true -> row(problem, kind, index), false -> done() }
    machine row(problem: @|indexing|::Problem, kind: u64, index: u64) requires index < 6 {
        |console|::Console::write("peak"); integer(problem.assignments[index]); number(problem.predictions[index]); number(problem.residuals[index]); |console|::Console::write_line("");
        families(kind, problem.assignments[index], 0, 0, 0);
        transition { _ -> peaks(problem, kind, index + 1) }
    }
    machine done() { }
}
public machine families(kind: u64, squared: u64, h: u64, k: u64, l: u64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    transition h < 5 && k < 5 && l < 5 { true -> test(kind, squared, h, k, l), false -> done() }
    machine test(kind: u64, squared: u64, h: u64, k: u64, l: u64) requires h < 5, k < 5, l < 5 {
        transition h >= k && k >= l && h * h + k * k + l * l == squared && |indexing|::allowed(kind, h, k, l) {
            true -> emit(kind, squared, h, k, l), false -> advance(kind, squared, h, k, l)
        }
    }
    machine emit(kind: u64, squared: u64, h: u64, k: u64, l: u64) requires h < 5, k < 5, l < 5 {
        |console|::Console::write("family"); integer(h); integer(k); integer(l); |console|::Console::write_line("");
        transition { _ -> advance(kind, squared, h, k, l) }
    }
    machine advance(kind: u64, squared: u64, h: u64, k: u64, l: u64) requires h < 5, k < 5, l < 5 {
        transition { l < 4 -> families(kind, squared, h, k, l + 1), k < 4 -> families(kind, squared, h, k + 1, 0), _ -> families(kind, squared, h + 1, 0, 0) }
    }
    machine done() { }
}
public machine missing(problem: @|indexing|::Problem, mask: u64, rank: u64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    transition rank < problem.last && rank < 8 { true -> test(problem, mask, rank), false -> done() }
    machine test(problem: @|indexing|::Problem, mask: u64, rank: u64) requires rank < 8 {
        transition mask % 2 == 0 { true -> emit(problem, mask, rank), false -> missing(problem, mask / 2, rank + 1) }
    }
    machine emit(problem: @|indexing|::Problem, mask: u64, rank: u64) requires rank < 8 {
        |console|::Console::write("missing"); integer(problem.lines[rank]); |console|::Console::write_line("");
        transition { _ -> missing(problem, mask / 2, rank + 1) }
    }
    machine done() { }
}
