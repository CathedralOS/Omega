use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Expected exit: 2. Empty stdin is invalid; valid input returns 0.
// Expected output contains: INVALID reaction input
use system\Console;
use omega\language\core\narrow_u64_to_i64_saturating;
use domain\input;
use domain\input\Input;
use domain\input\read;
use domain\model;
use domain\model\Problem;
use domain\model\valid;
use domain\model\problem;
use domain\rates;
use domain\rates\physical;
use domain\integrate;
use domain\integrate\Solution;
use domain\integrate\integrate;
use domain\report;
use domain\report\scaled;
use domain\report\integer64;
data Main { input: Input; problem: Problem; solution: Solution; }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    block read(@mutable main.input);
    transition valid(@main.input) { true -> prepare(main), false -> invalid(main) }
    machine prepare(main: @mutable Main) {
        main.problem = problem(@main.input);
        transition physical(@main.problem.initial) && main.problem.initial.a + main.problem.initial.b + main.problem.initial.c <= 1000000.0 && main.problem.end <= 1000000.0 && main.problem.absolute > 0.0 && main.problem.relative > 0.0 && main.problem.relative <= 1.0 {
            true -> solve(main), false -> invalid(main)
        }
    }
    machine solve(main: @mutable Main) {
        main.solution = integrate(@main.problem);
        transition main.solution.success { true -> report(main), false -> exhausted(main) }
    }
    machine report(main: @mutable Main) {
        Console::write_line("stiff_reaction_kinetics units=1e-12");
        scaled(main.solution.time); Console::write(" ");
        scaled(main.solution.value.a); Console::write(" ");
        scaled(main.solution.value.b); Console::write(" ");
        scaled(main.solution.value.c); Console::write(" ");
        scaled(main.solution.mass_error); Console::write_line("");
        integer64(narrow_u64_to_i64_saturating(main.solution.accepted)); Console::write(" ");
        integer64(narrow_u64_to_i64_saturating(main.solution.rejected)); Console::write_line("");
    }
    machine invalid(main: @mutable Main) { Console::write_line("INVALID reaction input"); ProcessExit::exit_process(2); }
    machine exhausted(main: @mutable Main) { Console::write_line("EXHAUSTED integration convergence"); ProcessExit::exit_process(3); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
