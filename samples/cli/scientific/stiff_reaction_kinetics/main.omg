use domain/input/input.omg;
use domain/integrate/integrate.omg;
use domain/model/model.omg;
use domain/rates/rates.omg;
use domain/report/report.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 2. Empty stdin is invalid; valid input returns 0.
// Expected output contains: INVALID reaction input
data Main { input: |input|::Input; problem: |model|::Problem; solution: |integrate|::Solution; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    block |input|::read(@mutable main.input);
    transition |model|::valid(@main.input) { true -> prepare(main), false -> invalid(main) }
    machine prepare(main: @mutable Main) {
        main.problem = |model|::problem(@main.input);
        transition |rates|::physical(@main.problem.initial) && main.problem.initial.a + main.problem.initial.b + main.problem.initial.c <= 1000000.0 && main.problem.end <= 1000000.0 && main.problem.absolute > 0.0 && main.problem.relative > 0.0 && main.problem.relative <= 1.0 {
            true -> solve(main), false -> invalid(main)
        }
    }
    machine solve(main: @mutable Main) {
        main.solution = |integrate|::integrate(@main.problem);
        transition main.solution.success { true -> report(main), false -> exhausted(main) }
    }
    machine report(main: @mutable Main) {
        |console|::Console::write_line("stiff_reaction_kinetics units=1e-12");
        |report|::scaled(main.solution.time); |console|::Console::write(" ");
        |report|::scaled(main.solution.value.a); |console|::Console::write(" ");
        |report|::scaled(main.solution.value.b); |console|::Console::write(" ");
        |report|::scaled(main.solution.value.c); |console|::Console::write(" ");
        |report|::scaled(main.solution.mass_error); |console|::Console::write_line("");
        |report|::integer64(|numeric_conversion|::narrow_u64_to_i64_saturating(main.solution.accepted)); |console|::Console::write(" ");
        |report|::integer64(|numeric_conversion|::narrow_u64_to_i64_saturating(main.solution.rejected)); |console|::Console::write_line("");
    }
    machine invalid(main: @mutable Main) { |console|::Console::write_line("INVALID reaction input"); |process_exit|::ProcessExit::exit_process(2); }
    machine exhausted(main: @mutable Main) { |console|::Console::write_line("EXHAUSTED integration convergence"); |process_exit|::ProcessExit::exit_process(3); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
