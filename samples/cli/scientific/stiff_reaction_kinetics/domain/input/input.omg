use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

// The parser bounds bytes, tokens and magnitudes before arithmetic/storage.
public data Input {
    values: [u64; 40] in Wrapping;
    count: u64;
    bytes: u64;
    number: u64 in Wrapping;
    active: bool;
    valid: bool;
    index: u64;
}

public machine read(input: @mutable Input)
invokes |console|::Console
reaches |process_authority|::StandardInput
blocks
crashes Trap
{
    input.count = 0;
    input.bytes = 0;
    input.number = 0;
    input.active = false;
    input.valid = true;
    transition { _ -> scan(input) }
    machine scan(input: @mutable Input) {
        transition input.bytes <= 4096 {
            true -> receive(input),
            false -> invalid(input)
        }
    }
    machine receive(input: @mutable Input) {
        transition block |console|::Console::read_byte() {
            |console|::ByteRead::Error -> invalid(input),
            |console|::ByteRead::Eof -> finish(input),
            |console|::ByteRead::Byte { value } -> classify(input, value)
        }
    }
    machine classify(input: @mutable Input, value: i32) {
        transition input.bytes < 4096 {
            true -> byte(input, value),
            false -> invalid(input)
        }
    }
    machine byte(input: @mutable Input, value: i32) {
        input.bytes = input.bytes + 1;
        transition {
            value >= 48 && value <= 57 -> digit(input, value),
            value == 32 || value == 9 || value == 10 || value == 13 -> separator(input),
            _ -> invalid(input)
        }
    }
    machine digit(input: @mutable Input, value: i32) {
        input.number = input.number * 10 + ((value - 48) as u64 +Wrapping);
        input.active = true;
        transition input.number <= 1000000000000 {
            true -> scan(input),
            false -> invalid(input)
        }
    }
    machine separator(input: @mutable Input) {
        flush(input);
        transition input.valid { true -> scan(input), false -> done() }
    }
    machine finish(input: @mutable Input) { flush(input); }
    machine invalid(input: @mutable Input) { input.valid = false; }
    machine done() {}
}

machine flush(input: @mutable Input) {
    transition input.active && input.count < 40 {
        true -> store(input),
        false -> other(input)
    }
    machine store(input: @mutable Input) {
        input.values[input.count] = input.number;
        input.count = input.count + 1;
        input.number = 0;
        input.active = false;
    }
    machine other(input: @mutable Input) {
        transition input.active { true -> invalid(input), false -> done() }
    }
    machine invalid(input: @mutable Input) { input.valid = false; }
    machine done() {}
}

