use omega::language::core::float_operations;
use domain::input;
public data Vector [copy] { a: f64; b: f64; c: f64; }
public data Reaction [copy] { a: u64; b: u64; c: u64; p: u64; q: u64; r: u64; rate: f64; }
public data Problem [copy] { first: Reaction; second: Reaction; third: Reaction; initial: Vector; end: f64; step: f64; absolute: f64; relative: f64; trials: u64; iterations: u64; }
public machine valid(input: &Input) -> bool {
    input.valid && input.count == 40
        && input.values[1] > 0
        && input.values[3] > 0
        && input.values[5] > 0
        && input.values[25] > 0
        && input.values[27] > 0
        && input.values[29] > 0
        && input.values[31] > 0
        && input.values[33] > 0
        && input.values[35] > 0
        && input.values[37] > 0
        && input.values[6] <= 2
        && input.values[7] <= 2
        && input.values[8] <= 2
        && input.values[9] <= 2
        && input.values[10] <= 2
        && input.values[11] <= 2
        && input.values[12] <= 2
        && input.values[13] <= 2
        && input.values[14] <= 2
        && input.values[15] <= 2
        && input.values[16] <= 2
        && input.values[17] <= 2
        && input.values[18] <= 2
        && input.values[19] <= 2
        && input.values[20] <= 2
        && input.values[21] <= 2
        && input.values[22] <= 2
        && input.values[23] <= 2
        && input.values[6] + input.values[7] + input.values[8] == input.values[9] + input.values[10] + input.values[11]
        && input.values[12] + input.values[13] + input.values[14] == input.values[15] + input.values[16] + input.values[17]
        && input.values[18] + input.values[19] + input.values[20] == input.values[21] + input.values[22] + input.values[23]
        && input.values[30] > 0 && input.values[32] > 0 && input.values[34] > 0 && input.values[36] > 0
        && input.values[38] >= 1 && input.values[38] <= 1000000 && input.values[39] >= 1 && input.values[39] <= 32
}
public machine problem(input: &Input) -> Problem {
    Problem {
        first: Reaction { a: input.values[6] as u64, b: input.values[7] as u64, c: input.values[8] as u64, p: input.values[9] as u64, q: input.values[10] as u64, r: input.values[11] as u64, rate: F64::from_u64(input.values[0] as u64) / F64::from_u64(input.values[1] as u64) },
        second: Reaction { a: input.values[12] as u64, b: input.values[13] as u64, c: input.values[14] as u64, p: input.values[15] as u64, q: input.values[16] as u64, r: input.values[17] as u64, rate: F64::from_u64(input.values[2] as u64) / F64::from_u64(input.values[3] as u64) },
        third: Reaction { a: input.values[18] as u64, b: input.values[19] as u64, c: input.values[20] as u64, p: input.values[21] as u64, q: input.values[22] as u64, r: input.values[23] as u64, rate: F64::from_u64(input.values[4] as u64) / F64::from_u64(input.values[5] as u64) },
        initial: Vector { a: F64::from_u64(input.values[24] as u64) / F64::from_u64(input.values[25] as u64), b: F64::from_u64(input.values[26] as u64) / F64::from_u64(input.values[27] as u64), c: F64::from_u64(input.values[28] as u64) / F64::from_u64(input.values[29] as u64) },
        end: F64::from_u64(input.values[30] as u64) / F64::from_u64(input.values[31] as u64), step: F64::from_u64(input.values[32] as u64) / F64::from_u64(input.values[33] as u64),
        absolute: F64::from_u64(input.values[34] as u64) / F64::from_u64(input.values[35] as u64), relative: F64::from_u64(input.values[36] as u64) / F64::from_u64(input.values[37] as u64),
        trials: input.values[38] as u64, iterations: input.values[39] as u64
    }
}
