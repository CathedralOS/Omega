// A trial owns six Newton stage solves: one full and two half SDIRK2 steps.
// Only accepted two-half-step values update committed state. Rejection halves
// h without changing time/y. The order-two local error estimate divides the
// full versus fine difference by three; stage positivity is checked, never clipped.
use domain/model/model.omg;
use domain/newton/newton.omg;
use domain/rates/rates.omg;
// Stiffly accurate, L-stable SDIRK2: gamma=1-1/sqrt(2),
// A=[[gamma,0],[1-gamma,gamma]], b=[1-gamma,gamma].
// Each stage reuses the backward-Euler residual/Jacobian owner.
machine dirk(problem: @|model|::Problem, initial: @|model|::Vector, step: f64) -> |newton|::Newton {
    let first: |newton|::Newton = |newton|::implicit(problem, initial, 0.2928932188134524 * step);
    transition first.success {
        true -> second(problem, initial, first, step),
        false -> (first)
    }
    machine second(problem: @|model|::Problem, initial: @|model|::Vector, first: |newton|::Newton, step: f64) -> |newton|::Newton {
        let ratio: f64 = (1.0 - 0.2928932188134524) / 0.2928932188134524;
        let base: |model|::Vector = |model|::Vector {
            a: initial.a + ratio * (first.value.a - initial.a),
            b: initial.b + ratio * (first.value.b - initial.b),
            c: initial.c + ratio * (first.value.c - initial.c)
        };
        transition |rates|::physical(@base) {
            true -> finish(problem, base, step),
            false -> failed(first)
        }
    }
    machine finish(problem: @|model|::Problem, base: |model|::Vector, step: f64) -> |newton|::Newton {
        |newton|::implicit(problem, @base, 0.2928932188134524 * step)
    }
    machine failed(first: |newton|::Newton) -> |newton|::Newton {
        let mutable failure: |newton|::Newton = first; failure.success = false; failure
    }
}
public data Solution [copy] { value: |model|::Vector; time: f64; step: f64; error: f64; mass_error: f64; accepted: u64; rejected: u64; attempts: u64; success: bool; full: |newton|::Newton; half: |newton|::Newton; fine: |newton|::Newton; }
public machine integrate(problem: @|model|::Problem) -> Solution {
    let mutable solution: Solution;
    solution.value = problem.initial; solution.step = problem.step;
    transition { _ -> advance(problem, solution) }
    machine advance(problem: @|model|::Problem, solution: Solution) -> Solution {
        transition solution.time >= problem.end { true -> complete(solution), false -> budget(problem, solution) }
    }
    machine budget(problem: @|model|::Problem, solution: Solution) -> Solution {
        transition solution.attempts < problem.trials && solution.attempts < 1000000 {
            true -> choose_step(problem, solution),
            false -> (solution)
        }
    }
    machine choose_step(problem: @|model|::Problem, solution: Solution) -> Solution {
        let mutable next: Solution = solution;
        transition next.step > problem.end - next.time { true -> cap(problem, next), false -> usable(problem, next) }
    }
    machine cap(problem: @|model|::Problem, solution: Solution) -> Solution {
        let mutable next: Solution = solution; next.step = problem.end - next.time;
        transition { _ -> usable(problem, next) }
    }
    machine usable(problem: @|model|::Problem, solution: Solution) -> Solution {
        transition solution.step > 1e-15 * (1.0 + solution.time) && solution.time + solution.step > solution.time {
            true -> trial(problem, solution),
            false -> (solution)
        }
    }
    machine trial(problem: @|model|::Problem, solution: Solution) -> Solution {
        let mutable next: Solution = solution;
        next.attempts = next.attempts + 1;
        next.full = dirk(problem, @next.value, next.step);
        next.half = dirk(problem, @next.value, 0.5 * next.step);
        next.fine = dirk(problem, @next.half.value, 0.5 * next.step);
        transition next.full.success && next.half.success && next.fine.success { true -> estimate(problem, next), false -> reject(problem, next) }
    }
    machine estimate(problem: @|model|::Problem, solution: Solution) -> Solution {
        let mutable next: Solution = solution;
        let difference: |model|::Vector = |model|::Vector { a: next.fine.value.a - next.full.value.a, b: next.fine.value.b - next.full.value.b, c: next.fine.value.c - next.full.value.c };
        next.error = |rates|::norm(@difference, @next.fine.value, problem) / 3.0;
        transition next.error >= 0.0 && next.error <= 1.0 { true -> accept(problem, next), false -> reject(problem, next) }
    }
    machine accept(problem: @|model|::Problem, solution: Solution) -> Solution {
        transition solution.accepted < 1000000 { true -> commit(problem, solution), false -> (solution) }
    }
    machine commit(problem: @|model|::Problem, solution: Solution) -> Solution {
        let mutable next: Solution = solution;
        next.time = next.time + next.step; next.value = next.fine.value;
        next.accepted = next.accepted + 1;
        let initial_mass: f64 = problem.initial.a + problem.initial.b + problem.initial.c;
        let mass_error: f64 = |rates|::magnitude(next.value.a + next.value.b + next.value.c - initial_mass);
        next.mass_error = |rates|::maximum(next.mass_error, mass_error);
        transition next.error < 0.1 { true -> grow(problem, next), false -> advance(problem, next) }
    }
    machine grow(problem: @|model|::Problem, solution: Solution) -> Solution { let mutable next: Solution = solution; next.step = next.step * 2.0; transition { _ -> advance(problem, next) } }
    machine reject(problem: @|model|::Problem, solution: Solution) -> Solution {
        transition solution.rejected < 1000000 { true -> rollback(problem, solution), false -> (solution) }
    }
    machine rollback(problem: @|model|::Problem, solution: Solution) -> Solution { let mutable next: Solution = solution; next.rejected = next.rejected + 1; next.step = next.step * 0.5; transition { _ -> advance(problem, next) } }
    machine complete(solution: Solution) -> Solution { let mutable next: Solution = solution; next.success = true; next }
}
