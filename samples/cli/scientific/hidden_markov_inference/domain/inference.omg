use omega::language::core::float_operations;
data Model { probabilities: [f64; 10]; units: [u64; 10]; observations: [u64; 16]; count: u64; }
data Inference { forward: [f64; 32]; backward: [f64; 32]; scales: [f64; 16]; log_likelihood: f64; path: u64; }
// Range reduction bounds the atanh argument to 1/3. Twenty-four terms
// give error below 2e-24 before f64 rounding, including tiny positive scales.
machine logarithm(value: f64) -> f64 {
    transition { _ -> reduce(value, 0.0) }
    machine reduce(value: f64, adjustment: f64) -> f64 {
        transition value < 0.5 { true -> reduce(value * 2.0, adjustment - 0.6931471805599453094) false -> series(value, adjustment) }
    }
    machine series(value: f64, adjustment: f64) -> f64 {
        let ratio: f64 = (value - 1.0) / (value + 1.0);
        transition { _ -> term(ratio, ratio * ratio, 1, 0.0, adjustment) }
    }
    machine term(power: f64, square: f64, index: u64, sum: f64, adjustment: f64) -> f64
    requires index >= 1 requires index <= 49 {
        let next: f64 = sum + power / F64::from_i64(index as i64);
        transition index < 47 { true -> term(power * square, square, index + 2, next, adjustment) false -> (2.0 * next + adjustment) }
    }
}
machine infer(model: &Model, result: &mut Inference) -> bool
requires model.count >= 1 requires model.count <= 16 {
    let symbol: u64 = model.observations[0];
    transition symbol <= 1 { true -> first(model, result, symbol) false -> false }
    machine first(model: &Model, result: &mut Inference, symbol: u64) -> bool
    requires model.count >= 1 requires model.count <= 16 requires symbol <= 1 {
        let zero: f64 = model.probabilities[0] * model.probabilities[6 + symbol];
        let one: f64 = model.probabilities[1] * model.probabilities[8 + symbol];
        let scale: f64 = zero + one;
        transition scale > 0.0 { true -> first_scaled(model, result, zero, one, scale) false -> false }
    }
    machine first_scaled(model: &Model, result: &mut Inference, zero: f64, one: f64, scale: f64) -> bool
    requires model.count >= 1 requires model.count <= 16 {
        result.forward[0] = zero / scale;
        result.forward[1] = one / scale;
        result.scales[0] = scale;
        result.log_likelihood = logarithm(scale);
        transition { _ -> forward(model, result, 1) }
    }
    machine forward(model: &Model, result: &mut Inference, step: u64) -> bool
    requires model.count >= 1 requires model.count <= 16 requires step >= 1 requires step <= 16 {
        transition step < model.count { true -> next(model, result, step) false -> backward_start(model, result) }
    }
    machine next(model: &Model, result: &mut Inference, step: u64) -> bool
    requires model.count >= 1 requires model.count <= 16 requires step >= 1 requires step < 16 {
        let symbol: u64 = model.observations[step];
        transition symbol <= 1 { true -> recurrence(model, result, step, symbol) false -> false }
    }
    machine recurrence(model: &Model, result: &mut Inference, step: u64, symbol: u64) -> bool
    requires model.count >= 1 requires model.count <= 16 requires step >= 1 requires step < 16 requires symbol <= 1 {
        let zero: f64 = (result.forward[2 * step - 2] * model.probabilities[2] + result.forward[2 * step - 1] * model.probabilities[4]) * model.probabilities[6 + symbol];
        let one: f64 = (result.forward[2 * step - 2] * model.probabilities[3] + result.forward[2 * step - 1] * model.probabilities[5]) * model.probabilities[8 + symbol];
        let scale: f64 = zero + one;
        transition scale > 0.0 { true -> scaled(model, result, step, zero, one, scale) false -> false }
    }
    machine scaled(model: &Model, result: &mut Inference, step: u64, zero: f64, one: f64, scale: f64) -> bool
    requires model.count >= 1 requires model.count <= 16 requires step >= 1 requires step < 16 {
        result.forward[2 * step] = zero / scale;
        result.forward[2 * step + 1] = one / scale;
        result.scales[step] = scale;
        result.log_likelihood = result.log_likelihood + logarithm(scale);
        transition { _ -> forward(model, result, step + 1) }
    }
    machine backward_start(model: &Model, result: &mut Inference) -> bool
    requires model.count >= 1 requires model.count <= 16 {
        result.backward[2 * model.count - 2] = 1.0;
        result.backward[2 * model.count - 1] = 1.0;
        transition { _ -> backward(model, result, model.count - 1) }
    }
    machine backward(model: &Model, result: &mut Inference, step: u64) -> bool requires step < 16 {
        transition step > 0 { true -> backward_row(model, result, step) false -> true }
    }
    machine backward_row(model: &Model, result: &mut Inference, step: u64) -> bool requires step > 0 requires step < 16 {
        let symbol: u64 = model.observations[step];
        transition symbol <= 1 { true -> backward_symbol(model, result, step, symbol) false -> false }
    }
    machine backward_symbol(model: &Model, result: &mut Inference, step: u64, symbol: u64) -> bool requires step > 0 requires step < 16 requires symbol <= 1 {
        let zero: f64 = model.probabilities[6 + symbol] * result.backward[2 * step];
        let one: f64 = model.probabilities[8 + symbol] * result.backward[2 * step + 1];
        result.backward[2 * step - 2] = (model.probabilities[2] * zero + model.probabilities[3] * one) / result.scales[step];
        result.backward[2 * step - 1] = (model.probabilities[4] * zero + model.probabilities[5] * one) / result.scales[step];
        transition { _ -> backward(model, result, step - 1) }
    }
}
