use out_of_bounds.omg;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "bounded_sequence_alignment_invalid" };
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled { name: "system" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, |out_of_bounds|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |out_of_bounds|::entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, |out_of_bounds|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |out_of_bounds|::entry_start);
}
