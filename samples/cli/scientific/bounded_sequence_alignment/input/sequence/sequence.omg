use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data Sequence {
    bases: [u8; 16];
    length: i32 in Wrapping;
}

// Read precisely one LF-terminated sequence, or a final sequence ending at EOF.
// Capacity is checked before storing. Lowercase is normalized; no whitespace,
// FASTA headers, punctuation or alphabet beyond A/C/G/T/N is silently accepted.
// Status: 0 valid, 1 empty, 2 alphabet, 3 capacity, 4 unavailable line.
public machine read_sequence(sequence: @mutable Sequence) -> i32
reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    sequence.length = 0;
    transition { _ -> block next(sequence) }
    machine next(sequence: @mutable Sequence) -> i32 {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> (2),
            |console|::ByteRead::Eof -> end(sequence),
            |console|::ByteRead::Byte { value } -> block byte(sequence, value)
        }
    }
    machine byte(sequence: @mutable Sequence, value: i32) -> i32 {
        transition value == 10 {
            true -> finish(sequence),
            false -> block normalize(sequence, value)
        }
    }
    machine normalize(sequence: @mutable Sequence, value: i32) -> i32 {
        transition value >= 97 && value <= 122 {
            true -> block alphabet(sequence, value - 32),
            false -> block alphabet(sequence, value)
        }
    }
    machine alphabet(sequence: @mutable Sequence, value: i32) -> i32 {
        transition value == 65 || value == 67 || value == 71 || value == 84 || value == 78 {
            true -> block capacity(sequence, value),
            false -> (2)
        }
    }
    machine capacity(sequence: @mutable Sequence, value: i32) -> i32 {
        transition sequence.length >= 0 && sequence.length < 16 && value >= 0 && value <= 255 {
            true -> block store(sequence, value),
            false -> (3)
        }
    }
    machine store(sequence: @mutable Sequence, value: i32) -> i32
    requires sequence.length >= 0 && sequence.length < 16, value >= 0 && value <= 255
    {
        sequence.bases[sequence.length] = value as u8;
        sequence.length = sequence.length + 1;
        transition { _ -> block next(sequence) }
    }
    machine finish(sequence: @mutable Sequence) -> i32 {
        transition sequence.length == 0 { true -> (1), false -> (0) }
    }
    machine end(sequence: @mutable Sequence) -> i32 {
        transition sequence.length == 0 { true -> (4), false -> (0) }
    }
}
