use alignment/local/local.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

// Scores and coordinates are nonnegative and at most 48. Emit decimal rather
// than exposing an exit-code-only witness. Output preserves the traceback bytes.
// The printed traces are the prefix whose length is the wrapping column count.
machine trace_window<'row>(bytes: @'row [u8; 32], count: i32 in Wrapping) -> @'row [u8]
requires count >= 0 && count <= 32
ensures result.length == count as u64
{
    @bytes[0..count]
}

public machine number(value: i32 in Wrapping) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    transition value >= 0 && value <= 48 { true -> digits(value), false -> bad() }
    machine digits(value: i32 in Wrapping) {
        transition value >= 10 { true -> tens(value), false -> units(value) }
    }
    machine tens(value: i32 in Wrapping) {
        |console|::Console::write_byte(((value / 10) + 48) as i32);
        transition { _ -> units(value) }
    }
    machine units(value: i32 in Wrapping) { |console|::Console::write_byte(((value % 10) + 48) as i32); }
    machine bad() { |console|::Console::write_line("ERROR internal-number"); |process_exit|::ProcessExit::exit_process(70); }
}

public machine report(result: @|local|::Alignment) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    transition result.columns >= 0 && result.columns <= 32 {
        true -> windows(result),
        false -> bad()
    }
    machine windows(result: @|local|::Alignment) {
        let first_window: @[u8] = trace_window(@result.first_trace, result.columns);
        let second_window: @[u8] = trace_window(@result.second_trace, result.columns);
        transition first_window.length == second_window.length {
            true -> score(result),
            false -> bad()
        }
    }
    machine score(result: @|local|::Alignment) {
        |console|::Console::write("score="); number(result.score); |console|::Console::write_line("");
        |console|::Console::write("first="); number(result.first_start); |console|::Console::write(":"); number(result.first_end); |console|::Console::write_line("");
        |console|::Console::write("second="); number(result.second_start); |console|::Console::write(":"); number(result.second_end); |console|::Console::write_line("");
        |console|::Console::write("alignment-first=");
        transition { _ -> first(result, result.columns) }
    }
    machine first(result: @|local|::Alignment, remaining: i32 in Wrapping) {
        transition remaining > 0 && remaining <= 32 { true -> first_index(result, remaining - 1), false -> second_begin(result) }
    }
    machine first_index(result: @|local|::Alignment, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 { true -> first_byte(result, position), false -> bad() }
    }
    machine first_byte(result: @|local|::Alignment, position: i32 in Wrapping)
    requires position >= 0 && position < 32
    {
        |console|::Console::write_byte(result.first_trace[position] as i32);
        transition { _ -> first(result, position) }
    }
    machine second_begin(result: @|local|::Alignment) {
        |console|::Console::write_line("");
        |console|::Console::write("alignment-second=");
        transition { _ -> second(result, result.columns) }
    }
    machine second(result: @|local|::Alignment, remaining: i32 in Wrapping) {
        transition remaining > 0 && remaining <= 32 { true -> second_index(result, remaining - 1), false -> done() }
    }
    machine second_index(result: @|local|::Alignment, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 { true -> second_byte(result, position), false -> bad() }
    }
    machine second_byte(result: @|local|::Alignment, position: i32 in Wrapping)
    requires position >= 0 && position < 32
    {
        |console|::Console::write_byte(result.second_trace[position] as i32);
        transition { _ -> second(result, position) }
    }
    machine done() { |console|::Console::write_line(""); }
    machine bad() { |console|::Console::write_line("ERROR internal-trace"); |process_exit|::ProcessExit::exit_process(70); }
}
