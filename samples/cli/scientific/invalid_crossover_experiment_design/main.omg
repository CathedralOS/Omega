use omega::language::core::ProcessExit;
// Complete intended-invalid source: unchecked period directly indexes storage.
// Rejection must name the index obligation; unrelated package rejection is red.
use omega_language_std::Console;
machine unchecked_period(cells: &[i32; 3], period: u64) -> i32 {
    transition { _ -> (cells[period]) }
}
data Main { }
machine main(main: &mut Main) reaches ProcessExit + Console {
    let cells: [i32; 3] = [0, 1, 2];
    let observed: i32 = unchecked_period(&cells, 4);
    ProcessExit::exit_process(observed);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
