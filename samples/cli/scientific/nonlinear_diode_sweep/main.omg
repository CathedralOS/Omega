use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
use domain\solver;
use domain\solver\Solver;
use domain\solver\solve;
use domain\shockley;
use domain\shockley\Circuit;
use io\protocol;
use io\protocol\Protocol;
use io\protocol\read;
use io\protocol\integer;
use io\protocol\number;
use system\Console;

data Main {
    protocol: Protocol;
    circuit: Circuit;
    solver: Solver;
    source_start: f64;
    source_step: f64;
    source_index: f64;
    points: i32 in Wrapping;
    position: i32 in Wrapping;
    budget: i32 in Wrapping;
    converged: i32 in Wrapping;
    failed: i32 in Wrapping;
}

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    let valid: bool = block read(@mutable main.protocol);
    transition valid { true -> validate(main), false -> bad_syntax(main) }
    machine bad_syntax(main: @mutable Main) {
        Console::write_line("ERROR syntax: expected nine integers, maximum 160 bytes");
        ProcessExit::exit_process(64);
    }
    machine validate(main: @mutable Main) {
        transition main.protocol.fields[0] >= -1000 && main.protocol.fields[0] <= 5000
            && main.protocol.fields[1] >= -1000 && main.protocol.fields[1] <= 5000
            && main.protocol.fields[2] >= 2 && main.protocol.fields[2] <= 16
            && main.protocol.fields[3] >= 10 && main.protocol.fields[3] <= 1000000
            && main.protocol.fields[4] >= 1 && main.protocol.fields[4] <= 1000000
            && main.protocol.fields[5] >= 25 && main.protocol.fields[5] <= 50
            && main.protocol.fields[6] >= -1200 && main.protocol.fields[6] <= 900
            && main.protocol.fields[7] >= -1200 && main.protocol.fields[7] <= 900
            && main.protocol.fields[6] < main.protocol.fields[7]
            && main.protocol.fields[8] >= 1 && main.protocol.fields[8] <= 80 {
            true -> configure(main),
            false -> bad_range(main)
        }
    }
    machine bad_range(main: @mutable Main) {
        Console::write_line("ERROR range: invalid sweep or Shockley model parameters");
        ProcessExit::exit_process(65);
    }
    machine configure(main: @mutable Main) {
        let start: f64 = main.protocol.fields[0] as f64;
        let stop: f64 = main.protocol.fields[1] as f64;
        let count: i32 in Wrapping = main.protocol.fields[2] as i32 +Wrapping;
        let intervals: i32 = (count - 1) as i32;
        let divisor: f64 = intervals as f64;
        main.source_start = start / 1000.0;
        let span: f64 = (stop - start) / 1000.0;
        main.source_step = span / divisor;
        main.source_index = 0.0;
        main.position = 0;
        main.points = count;
        main.budget = main.protocol.fields[8] as i32 +Wrapping;
        main.converged = 0;
        main.failed = 0;
        main.circuit.resistance = main.protocol.fields[3] as f64;
        let saturation: f64 = main.protocol.fields[4] as f64;
        main.circuit.saturation = saturation / 1000000000000.0;
        let thermal: f64 = main.protocol.fields[5] as f64;
        main.circuit.thermal = thermal / 1000.0;
        let lower: f64 = main.protocol.fields[6] as f64;
        let upper: f64 = main.protocol.fields[7] as f64;
        main.circuit.lower = lower / 1000.0;
        main.circuit.upper = upper / 1000.0;
        Console::write_line("point,status,source_V,diode_V,current_A,residual_V,width_V,iterations,evaluations");
        transition { _ -> sweep(main) }
    }
    machine sweep(main: @mutable Main) {
        let offset: f64 = main.source_step * main.source_index;
        let source: f64 = main.source_start + offset;
        solve(@main.circuit, @mutable main.solver, source, main.budget);
        integer(@mutable main.protocol, main.position);
        Console::write(",");
        transition main.solver.status == 3 {
            true -> absent(main),
            false -> present(main)
        }
    }
    machine absent(main: @mutable Main) {
        main.failed = main.failed + 1;
        Console::write("no_bracket,");
        number(@mutable main.protocol, main.solver.source);
        Console::write(",NA,NA,NA,NA,");
        transition { _ -> diagnostics(main) }
    }
    machine present(main: @mutable Main) {
        transition main.solver.status == 1 {
            true -> converged(main),
            false -> limited(main)
        }
    }
    machine converged(main: @mutable Main) {
        main.converged = main.converged + 1;
        Console::write("converged,");
        transition { _ -> values(main) }
    }
    machine limited(main: @mutable Main) {
        main.failed = main.failed + 1;
        Console::write("iteration_limit,");
        transition { _ -> values(main) }
    }
    machine values(main: @mutable Main) {
        number(@mutable main.protocol, main.solver.source);
        Console::write(",");
        number(@mutable main.protocol, main.solver.voltage);
        Console::write(",");
        number(@mutable main.protocol, main.solver.current);
        Console::write(",");
        number(@mutable main.protocol, main.solver.residual);
        Console::write(",");
        number(@mutable main.protocol, main.solver.width);
        Console::write(",");
        transition { _ -> diagnostics(main) }
    }
    machine diagnostics(main: @mutable Main) {
        integer(@mutable main.protocol, main.solver.iterations);
        Console::write(",");
        integer(@mutable main.protocol, main.solver.evaluations);
        Console::write_line("");
        main.position = main.position + 1;
        main.source_index = main.source_index + 1.0;
        transition main.position < main.points { true -> sweep(main), false -> done(main) }
    }
    machine done(main: @mutable Main) {
        Console::write("summary,");
        integer(@mutable main.protocol, main.converged);
        Console::write(",");
        integer(@mutable main.protocol, main.failed);
        Console::write_line("");
        ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
