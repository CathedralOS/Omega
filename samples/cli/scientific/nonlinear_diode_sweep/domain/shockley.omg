// Scientific model: one ideal Shockley diode in series with one positive
// resistor. Thermal voltage includes the ideality factor. No breakdown,
// self-heating, capacitance, or diode series resistance is modeled.
// Only validated inputs reach this private model: -48 <= voltage/thermal <= 36.
use omega::language::core::float_operations;

data Circuit [copy] {
    resistance: f64;
    saturation: f64;
    thermal: f64;
    lower: f64;
    upper: f64;
}

// Reduce by 128, sum 32 Taylor terms, then square seven times. This is an
// application-private evaluator, not an import from an unfinished numerics API.
machine exponential(value: f64) -> f64 {
    let reduced: f64 = value / 128.0;
    transition { _ -> term(reduced, 1.0, 1.0, 1.0, 1) }
    machine term(reduced: f64, sum: f64, previous: f64, denominator: f64,
        count: i32 in Wrapping) -> f64 {
        let product: f64 = previous * reduced;
        let next: f64 = product / denominator;
        let total: f64 = sum + next;
        transition count < 32 {
            true -> term(reduced, total, next, denominator + 1.0, count + 1)
            false -> square(total)
        }
    }
    machine square(value: f64) -> f64 {
        let power2: f64 = value * value;
        let power4: f64 = power2 * power2;
        let power8: f64 = power4 * power4;
        let power16: f64 = power8 * power8;
        let power32: f64 = power16 * power16;
        let power64: f64 = power32 * power32;
        power64 * power64
    }
}

machine diode_current(circuit: &Circuit, voltage: f64) -> f64 {
    let argument: f64 = voltage / circuit.thermal;
    let factor: f64 = exponential(argument);
    let excess: f64 = factor - 1.0;
    circuit.saturation * excess
}

machine circuit_residual(circuit: &Circuit, voltage: f64, source: f64) -> f64 {
    let current: f64 = diode_current(circuit, voltage);
    let drop: f64 = circuit.resistance * current;
    let total: f64 = voltage + drop;
    total - source
}

machine magnitude(value: f64) -> f64 {
    transition value < 0.0 { true -> negative(value) false -> positive(value) }
    machine negative(value: f64) -> f64 { 0.0 - value }
    machine positive(value: f64) -> f64 { value }
}
