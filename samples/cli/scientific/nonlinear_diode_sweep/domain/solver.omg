use domain::shockley;
use omega::language::core::float_operations;

// status: 1 converged, 2 iteration limit, 3 no sign bracket in the requested
// interval. Monotonicity follows from R, Is and thermal being positive.
data Solver {
    source: f64;
    lower: f64;
    upper: f64;
    previous_voltage: f64;
    previous_residual: f64;
    scan_step: f64;
    scan_position: f64;
    voltage: f64;
    current: f64;
    residual: f64;
    width: f64;
    status: i32;
    iterations: i32 in Wrapping;
    evaluations: i32 in Wrapping;
    scan_count: i32 in Wrapping;
}

machine solve(circuit: &Circuit, solver: &mut Solver, source: f64,
    budget: i32 in Wrapping) {
    solver.source = source;
    solver.iterations = 0;
    solver.evaluations = 1;
    solver.status = 3;
    solver.previous_voltage = circuit.lower;
    solver.previous_residual = circuit_residual(circuit, circuit.lower, source);
    solver.scan_step = (circuit.upper - circuit.lower) / 64.0;
    solver.scan_position = 1.0;
    solver.scan_count = 1;
    transition solver.previous_residual == 0.0 {
        true -> endpoint(circuit, solver, circuit.lower)
        false -> scan(circuit, solver, budget)
    }
    machine endpoint(circuit: &Circuit, solver: &mut Solver, voltage: f64) {
        solver.voltage = voltage;
        solver.current = diode_current(circuit, voltage);
        solver.residual = 0.0;
        solver.width = 0.0;
        solver.status = 1;
    }
    machine scan(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping) {
        let offset: f64 = solver.scan_step * solver.scan_position;
        let voltage: f64 = circuit.lower + offset;
        let residual: f64 = circuit_residual(circuit, voltage, solver.source);
        solver.evaluations = solver.evaluations + 1;
        transition residual == 0.0 {
            true -> endpoint(circuit, solver, voltage)
            false -> bracket(circuit, solver, budget, voltage, residual)
        }
    }
    machine bracket(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping,
        voltage: f64, residual: f64) {
        transition solver.previous_residual < 0.0 && residual > 0.0 {
            true -> start(circuit, solver, budget, voltage)
            false -> advance(circuit, solver, budget, voltage, residual)
        }
    }
    machine advance(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping,
        voltage: f64, residual: f64) {
        solver.previous_voltage = voltage;
        solver.previous_residual = residual;
        solver.scan_count = solver.scan_count + 1;
        solver.scan_position = solver.scan_position + 1.0;
        transition solver.scan_count <= 64 {
            true -> scan(circuit, solver, budget)
            false -> absent(solver)
        }
    }
    machine absent(solver: &mut Solver) { solver.status = 3; }
    machine start(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping,
        voltage: f64) {
        solver.lower = solver.previous_voltage;
        solver.upper = voltage;
        solver.width = solver.scan_step;
        transition { _ -> bisect(circuit, solver, budget) }
    }
    machine bisect(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping) {
        // Carry the nominal interval width through exact binary halvings.
        // Subtracting nearly equal endpoints loses relative diagnostic accuracy.
        let half: f64 = solver.width * 0.5;
        solver.voltage = solver.lower + half;
        solver.current = diode_current(circuit, solver.voltage);
        let drop: f64 = circuit.resistance * solver.current;
        let total: f64 = solver.voltage + drop;
        solver.residual = total - solver.source;
        solver.evaluations = solver.evaluations + 1;
        solver.iterations = solver.iterations + 1;
        let absolute: f64 = magnitude(solver.residual);
        transition absolute <= 0.0000000001 || solver.width <= 0.000000000001 {
            true -> converged(solver)
            false -> limit(circuit, solver, budget)
        }
    }
    machine converged(solver: &mut Solver) { solver.status = 1; }
    machine limit(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping) {
        transition solver.iterations >= budget {
            true -> exhausted(solver)
            false -> narrow(circuit, solver, budget)
        }
    }
    machine exhausted(solver: &mut Solver) { solver.status = 2; }
    machine narrow(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping) {
        solver.width = solver.width * 0.5;
        transition solver.residual < 0.0 {
            true -> move_lower(circuit, solver, budget)
            false -> move_upper(circuit, solver, budget)
        }
    }
    machine move_lower(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping) {
        solver.lower = solver.voltage;
        transition { _ -> bisect(circuit, solver, budget) }
    }
    machine move_upper(circuit: &Circuit, solver: &mut Solver, budget: i32 in Wrapping) {
        solver.upper = solver.voltage;
        transition { _ -> bisect(circuit, solver, budget) }
    }
}
