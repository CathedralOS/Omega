// Intended rejection: the caller's selected constant cannot provide a bound
// for the machine's arbitrary runtime index. This is a complete independent root.
data Layer [copy] { density: i32; drag: i32; }
data Main { density: i32; }
machine inspect(layers: &[Layer; 3], index: u64) -> i32 {
    layers[index].density
}
machine Main::main(main: &mut Main) {
    let layers: [Layer; 3] = [Layer { density: 2, drag: 2 }, Layer { density: 3, drag: 1 }, Layer { density: 4, drag: 4 }];
    main.density = inspect(&layers, 1);
}
