use physics/model/model.omg;
use reporting/numbers/numbers.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Closed stdin is an invalid empty request; the generic sample harness uses EOF.
// Expected exit: 64.
// Expected output contains: INVALID expected M 0D with M=1..6 density=1..8

data Main {
    input: [u8; 16];
    mode: i32;
    particle: |model|::Particle;
    timestep: f64;
    steps: u64;
}

// Protocol: one bounded line "M 0D", M=1..6 and density D=1..8. EOF without LF
// is accepted, CRLF is accepted, full buffers and trailing bytes are rejected.
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let read: |console|::LineReadResult = block |console|::Console::read_line(@mutable main.input[..]);
    transition read {
        |console|::LineReadResult::LineComplete { count } -> line(main, count),
        |console|::LineReadResult::EndOfInput { count } -> end(main, count),
        _ -> invalid(main)
    }
    machine line(main: @mutable Main, count: u64) {
        transition {
            count == 5 && main.input[4] == 10 -> parse(main),
            count == 6 && main.input[4] == 13 && main.input[5] == 10 -> parse(main),
            _ -> invalid(main)
        }
    }
    machine end(main: @mutable Main, count: u64) {
        transition count == 4 { true -> parse(main), false -> invalid(main) }
    }
    machine parse(main: @mutable Main) {
        transition {
            main.input[0] >= 49 && main.input[0] <= 54 && main.input[1] == 32 && main.input[2] == 48 && main.input[3] >= 49 && main.input[3] <= 56 -> initialize(main),
            _ -> invalid(main)
        }
    }
    machine initialize(main: @mutable Main) {
        main.mode = (main.input[0] as i32) - 48;
        let density: i32 = (main.input[3] as i32) - 48;
        main.particle.density = |float_operations|::F64::from_i32(density);
        main.particle.depth = 0.0;
        main.particle.velocity = 0.0;
        main.timestep = 0.5;
        main.steps = 8;
        configure(main);
        |console|::Console::write_line("MODEL unit-volume unit-gravity semi-implicit sampled-layers microunits");
        |console|::Console::write("INPUT "); |numbers|::number(main.mode);
        |console|::Console::write(" "); |numbers|::number(density); |console|::Console::write_line("");
        transition { _ -> balances(main, 0) }
    }
    machine balances(main: @mutable Main, index: i32) {
        let fluid: |model|::Layer = |model|::layer(index);
        let speed: f64 = |model|::terminal_velocity(main.particle.density, fluid);
        let residual: f64 = |model|::force(main.particle.density, fluid, speed);
        transition |model|::absolute(residual) <= 0.00000001 {
            true -> balance_report(main, index, speed, residual),
            false -> failure(main)
        }
    }
    machine balance_report(main: @mutable Main, index: i32, speed: f64, residual: f64) {
        |console|::Console::write("BALANCE "); |numbers|::number(index);
        |console|::Console::write(" "); |numbers|::micro(speed);
        |console|::Console::write(" "); |numbers|::micro(residual); |console|::Console::write_line("");
        transition index < 2 { true -> balances(main, index + 1), false -> start(main) }
    }
    machine start(main: @mutable Main) {
        let index: i32 = selected_layer(main.mode, main.particle.depth);
        regime(index, main.particle.density);
        trace(0, index, main.particle, 0.0, 0.0);
        transition { _ -> iterate(main, main.steps, 1) }
    }
    machine iterate(main: @mutable Main, remaining: u64, step: i32) {
        transition remaining > 0 { true -> integrate(main, remaining, step), false -> done(main) }
    }
    machine integrate(main: @mutable Main, remaining: u64, step: i32) {
        let before: i32 = selected_layer(main.mode, main.particle.depth);
        let fluid: |model|::Layer = |model|::layer(before);
        let result: |model|::Step = |model|::advance(@mutable main.particle, fluid, main.timestep);
        transition |model|::absolute(result.residual) <= 0.00000001 && |model|::absolute(main.particle.velocity) < 16.0 && |model|::absolute(main.particle.depth) < 16.0 {
            true -> bounded(main, remaining, step, before, result),
            false -> failure(main)
        }
    }
    machine bounded(main: @mutable Main, remaining: u64, step: i32, before: i32, result: |model|::Step) {
        transition {
            main.particle.depth >= 8.0 -> bottom(main, step, before, result),
            main.particle.depth <= -8.0 -> top(main, step, before, result),
            _ -> report(main, remaining, step, before, result)
        }
    }
    machine report(main: @mutable Main, remaining: u64, step: i32, before: i32, result: |model|::Step) {
        let after: i32 = selected_layer(main.mode, main.particle.depth);
        crossing(step, before, after, main.particle.density);
        trace(step, before, main.particle, result.force, result.residual);
        transition { _ -> iterate(main, remaining - 1, ((step as +Wrapping) + 1) as i32) }
    }
    machine bottom(main: @mutable Main, step: i32, before: i32, result: |model|::Step) {
        main.particle.depth = 8.0;
        trace(step, before, main.particle, result.force, result.residual);
        |console|::Console::write_line("BOUND bottom");
        transition { _ -> done(main) }
    }
    machine top(main: @mutable Main, step: i32, before: i32, result: |model|::Step) {
        main.particle.depth = -8.0;
        trace(step, before, main.particle, result.force, result.residual);
        |console|::Console::write_line("BOUND top");
        transition { _ -> done(main) }
    }
    machine done(main: @mutable Main) { |console|::Console::write_line("DONE"); |process_exit|::ProcessExit::exit_process(0); }
    machine invalid(main: @mutable Main) { |console|::Console::write_line("INVALID expected M 0D with M=1..6 density=1..8"); |process_exit|::ProcessExit::exit_process(64); }
    machine failure(main: @mutable Main) { |console|::Console::write_line("FAIL force residual or finite envelope"); |process_exit|::ProcessExit::exit_process(70); }
}

machine configure(main: @mutable Main) {
    transition main.mode {
        3 -> rise(main),
        4 -> relaxation(main),
        5 -> refined(main),
        6 -> boundary(main),
        _ -> unchanged()
    }
    machine rise(main: @mutable Main) { main.particle.depth = 3.0; main.timestep = 0.25; main.steps = 16; }
    machine relaxation(main: @mutable Main) { main.particle.velocity = 1.0; }
    machine refined(main: @mutable Main) { main.timestep = 0.25; main.steps = 16; }
    machine boundary(main: @mutable Main) { main.particle.depth = 7.75; main.particle.velocity = 2.0; }
    machine unchanged() {}
}

machine selected_layer(mode: i32, depth: f64) -> i32 {
    transition mode == 1 || mode == 4 { true -> homogeneous(), false -> layered(depth) }
    machine homogeneous() -> i32 { 0 }
    machine layered(depth: f64) -> i32 { |model|::layer_at(depth) }
}

machine regime(index: i32, density: f64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    |console|::Console::write("REGIME "); |numbers|::number(index);
    transition index == 1 { true -> quadratic(index, density), false -> linear(index, density) }
    machine quadratic(index: i32, density: f64) { |console|::Console::write_line(" quadratic"); neutral(index, density); }
    machine linear(index: i32, density: f64) { |console|::Console::write_line(" linear"); neutral(index, density); }
}
machine neutral(index: i32, density: f64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    let fluid: |model|::Layer = |model|::layer(index);
    transition density == fluid.density { true -> report(index), false -> quiet() }
    machine report(index: i32) { |console|::Console::write("NEUTRAL "); |numbers|::number(index); |console|::Console::write_line(""); }
    machine quiet() {}
}
machine crossing(step: i32, before: i32, after: i32, density: f64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput invokes |console|::Console {
    transition before != after { true -> report(step, before, after, density), false -> quiet() }
    machine report(step: i32, before: i32, after: i32, density: f64) {
        |console|::Console::write("CROSS "); |numbers|::number(step); |console|::Console::write(" "); |numbers|::number(before); |console|::Console::write(" "); |numbers|::number(after); |console|::Console::write_line("");
        regime(after, density);
    }
    machine quiet() {}
}
machine trace(step: i32, index: i32, particle: |model|::Particle, net: f64, residual: f64) reaches |process_authority|::StandardOutput invokes |console|::Console crashes Trap {
    |console|::Console::write("TRACE "); |numbers|::number(step); |console|::Console::write(" "); |numbers|::number(index);
    |console|::Console::write(" "); |numbers|::micro(particle.depth); |console|::Console::write(" "); |numbers|::micro(particle.velocity);
    |console|::Console::write(" "); |numbers|::micro(net); |console|::Console::write(" "); |numbers|::micro(residual); |console|::Console::write_line("");
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
