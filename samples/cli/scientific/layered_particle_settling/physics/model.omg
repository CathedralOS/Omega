use omega::language::core::float_operations;

// Nondimensional declared sample law: unit volume, unit gravitational acceleration.
// Positive depth/velocity points downward. The layer is sampled at the start of
// a time step; crossings change the next step's law, without substep interpolation.
public data Layer [copy] { density: f64; drag: f64; quadratic: bool; }
public data Particle [copy] { depth: f64; velocity: f64; density: f64; }
public data Step [copy] { force: f64; residual: f64; }

public machine layer_at(depth: f64) -> i32 {
    transition {
        depth < 0.5 -> top()
        depth < 2.0 -> middle()
        _ -> bottom()
    }
    machine top() -> i32 { 0 }
    machine middle() -> i32 { 1 }
    machine bottom() -> i32 { 2 }
}

public machine layer(index: i32) -> Layer {
    transition index {
        0 -> top()
        1 -> middle()
        _ -> bottom()
    }
    machine top() -> Layer { Layer { density: 2.0, drag: 2.0, quadratic: false } }
    machine middle() -> Layer { Layer { density: 3.0, drag: 1.0, quadratic: true } }
    machine bottom() -> Layer { Layer { density: 4.0, drag: 4.0, quadratic: false } }
}

public machine absolute(value: f64) -> f64 {
    transition value < 0.0 { true -> negative(value) false -> positive(value) }
    machine negative(value: f64) -> f64 { 0.0 - value }
    machine positive(value: f64) -> f64 { value }
}

public machine force(particle_density: f64, fluid: Layer, velocity: f64) -> f64 {
    transition fluid.quadratic {
        true -> quadratic(particle_density, fluid, velocity)
        false -> linear(particle_density, fluid, velocity)
    }
    machine quadratic(particle_density: f64, fluid: Layer, velocity: f64) -> f64 {
        particle_density - fluid.density - fluid.drag * velocity * absolute(velocity)
    }
    machine linear(particle_density: f64, fluid: Layer, velocity: f64) -> f64 {
        particle_density - fluid.density - fluid.drag * velocity
    }
}

// Private bounded root search, independent of any numerics package. All accepted
// densities put the positive root within [0, 8]. 40 halvings bound speed error
// by 8/2^40; force residual is separately checked by the application.
public machine terminal_velocity(density: f64, fluid: Layer) -> f64 {
    let drive: f64 = density - fluid.density;
    transition fluid.quadratic {
        true -> bisect(drive, fluid.drag, 0.0, 8.0, 40)
        false -> linear(drive, fluid.drag)
    }
    machine linear(drive: f64, drag: f64) -> f64 { drive / drag }
    machine bisect(drive: f64, drag: f64, lower: f64, upper: f64, remaining: u64) -> f64 {
        let midpoint: f64 = (lower + upper) * 0.5;
        transition {
            remaining == 0 -> sign(drive, midpoint)
            drag * midpoint * midpoint < absolute(drive) -> bisect(drive, drag, midpoint, upper, remaining - 1)
            _ -> bisect(drive, drag, lower, midpoint, remaining - 1)
        }
    }
    machine sign(drive: f64, value: f64) -> f64 {
        transition drive < 0.0 { true -> negative(value) false -> positive(value) }
    }
    machine negative(value: f64) -> f64 { 0.0 - value }
    machine positive(value: f64) -> f64 { value }
}

public machine advance(particle: &mut Particle, fluid: Layer, timestep: f64) -> Step {
    let old_velocity: f64 = particle.velocity;
    let net: f64 = force(particle.density, fluid, old_velocity);
    particle.velocity = old_velocity + timestep * net / particle.density;
    particle.depth = particle.depth + timestep * particle.velocity;
    // The residual uses the actual stored velocity, not the acceleration scratch.
    let residual: f64 = particle.density * (particle.velocity - old_velocity) / timestep - net;
    Step { force: net, residual: residual }
}
