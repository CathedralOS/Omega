// One private bounded unsigned-decimal scanner. Six digits and at most
// 4096 consumed bytes prevent overflow and unbounded malformed input work.
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data Reader {
    value: i64 in Wrapping;
    status: i32;
    consumed: i32 in Wrapping;
    digits: i32 in Wrapping;
}

public machine next(reader: @mutable Reader) reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    reader.value = 0;
    reader.status = 0;
    reader.digits = 0;
    transition { _ -> block scan(reader) }
    machine scan(reader: @mutable Reader) {
        transition reader.consumed < 4096 {
            true -> block read(reader),
            false -> invalid(reader)
        }
    }
    machine read(reader: @mutable Reader) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        reader.consumed = reader.consumed + 1;
        transition observed {
            |console|::ByteRead::Error -> invalid(reader),
            |console|::ByteRead::Eof -> finish(reader),
            |console|::ByteRead::Byte { value } -> block classify(reader, value)
        }
    }
    machine classify(reader: @mutable Reader, value: i32) {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> block delimiter(reader),
            false -> block numeral(reader, value)
        }
    }
    machine delimiter(reader: @mutable Reader) {
        transition reader.digits > 0 {
            true -> finish(reader),
            false -> block scan(reader)
        }
    }
    machine numeral(reader: @mutable Reader, value: i32) {
        transition value >= 48 && value <= 57 && reader.digits < 6 {
            true -> block append(reader, value),
            false -> invalid(reader)
        }
    }
    machine append(reader: @mutable Reader, value: i32) {
        reader.value = reader.value * 10 + ((value as i64 +Wrapping) - 48);
        reader.digits = reader.digits + 1;
        transition { _ -> block scan(reader) }
    }
    machine finish(reader: @mutable Reader) {
        transition reader.digits > 0 {
            true -> valid(reader),
            false -> end(reader)
        }
    }
    machine valid(reader: @mutable Reader) { reader.status = 1; }
    machine end(reader: @mutable Reader) { reader.status = 0; }
    machine invalid(reader: @mutable Reader) { reader.status = -1; }
}
