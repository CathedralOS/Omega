use geometry/profile/profile.omg;
use input/tokens/tokens.omg;
use loading/pressure/pressure.omg;
use output/numbers/numbers.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// ADD02: Complete offline hydrostatic loading of a vertical gate silhouette.
// Expected exit: 0 for valid bounded stdin; 64 for invalid bounded stdin.
// Expected output contains: HYDROSTATIC_GATE_V1 micro_units (valid input).
// Every domain operation and all bounded scratch data are application-private.

data Application {
    reader: |tokens|::Reader;
    profile: |profile|::Profile;
    levels: [f64; 8];
    level_count: u64 in Wrapping;
    gamma: f64;
    hinge: f64;
    area: f64;
    force: f64;
    first_moment: f64;
    hinge_moment: f64;
    wetted_count: i64 in Wrapping;
}

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable application: Application;
    block |tokens|::next(@mutable application.reader);
    transition application.reader.status == 1 && application.reader.value >= 2 && application.reader.value <= 8 {
        true -> block header(@mutable application),
        false -> invalid()
    }
    machine header(application: @mutable Application) {
        application.profile.count = application.reader.value as u64 +Wrapping;
        block |tokens|::next(@mutable application.reader);
        transition application.reader.status == 1 && application.reader.value >= 1 && application.reader.value <= 8 {
            true -> block gamma(application),
            false -> invalid()
        }
    }
    machine gamma(application: @mutable Application) {
        application.level_count = application.reader.value as u64 +Wrapping;
        block |tokens|::next(@mutable application.reader);
        transition application.reader.status == 1 && application.reader.value >= 1 && application.reader.value <= 20000 {
            true -> block hinge(application),
            false -> invalid()
        }
    }
    machine hinge(application: @mutable Application) {
        application.gamma = |float_operations|::F64::from_i64(application.reader.value as i64);
        block |tokens|::next(@mutable application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 {
            true -> block begin_nodes(application),
            false -> invalid()
        }
    }
    machine begin_nodes(application: @mutable Application) {
        application.hinge = (|float_operations|::F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition { _ -> block node(application, 0) }
    }
    machine node(application: @mutable Application, index: u64 in Wrapping) {
        transition index < application.profile.count && index < 8 {
            true -> block elevation(application, index),
            false -> block level(application, 0)
        }
    }
    machine elevation(application: @mutable Application, index: u64 in Wrapping) {
        block |tokens|::next(@mutable application.reader);
        let node_elevation: f64 = |float_operations|::F64::from_i64(application.reader.value as i64) / 1000.0;
        transition application.reader.status == 1 && application.reader.value <= 100000 {
            true -> block width(application, index, node_elevation),
            false -> invalid()
        }
    }
    machine width(application: @mutable Application, index: u64 in Wrapping, elevation: f64) {
        block |tokens|::next(@mutable application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 && index < 8 {
            true -> block store_node(application, index, elevation),
            false -> invalid()
        }
    }
    machine store_node(application: @mutable Application, index: u64 in Wrapping, elevation: f64) {
        application.profile.nodes[index].elevation = elevation;
        application.profile.nodes[index].width = (|float_operations|::F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition index > 0 {
            true -> block validate_order(application, index, elevation),
            false -> block node(application, index + 1)
        }
    }
    machine validate_order(application: @mutable Application, index: u64 in Wrapping, elevation: f64) {
        let previous: u64 in Wrapping = index - 1;
        transition previous < 8 && elevation > application.profile.nodes[previous].elevation {
            true -> block node(application, index + 1),
            false -> invalid()
        }
    }
    machine level(application: @mutable Application, index: u64 in Wrapping) {
        transition index < application.level_count && index < 8 {
            true -> block read_level(application, index),
            false -> block trailing(application)
        }
    }
    machine read_level(application: @mutable Application, index: u64 in Wrapping) {
        block |tokens|::next(@mutable application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 && index < 8 {
            true -> block store_level(application, index),
            false -> invalid()
        }
    }
    machine store_level(application: @mutable Application, index: u64 in Wrapping) {
        application.levels[index] = (|float_operations|::F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition { _ -> block level(application, index + 1) }
    }
    machine trailing(application: @mutable Application) {
        block |tokens|::next(@mutable application.reader);
        transition application.reader.status == 0 {
            true -> begin(application),
            false -> invalid()
        }
    }
    machine begin(application: @mutable Application) {
        |console|::Console::write_line("HYDROSTATIC_GATE_V1 micro_units");
        transition { _ -> water(application, 0) }
    }
    machine water(application: @mutable Application, index: u64 in Wrapping) {
        transition index < application.level_count && index < 8 {
            true -> reset(application, index),
            false -> done()
        }
    }
    machine reset(application: @mutable Application, index: u64 in Wrapping) {
        application.area = 0.0;
        application.force = 0.0;
        application.first_moment = 0.0;
        application.hinge_moment = 0.0;
        application.wetted_count = 0;
        |console|::Console::write("LEVEL "); |numbers|::write_integer(index as -Wrapping as i64 +Wrapping);
        |console|::Console::write(" water_um="); |numbers|::write_scaled(application.levels[index]);
        |console|::Console::write_line("");
        transition { _ -> segment(application, index, 0) }
    }
    machine segment(application: @mutable Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping) {
        let next: u64 in Wrapping = segment_index + 1;
        transition next < application.profile.count && next < 8 && segment_index < 8 && water_index < 8 {
            true -> calculate(application, water_index, segment_index, next),
            false -> summary(application, water_index)
        }
    }
    machine calculate(application: @mutable Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping, next: u64 in Wrapping) {
        let water: f64 = application.levels[water_index];
        let wet: |profile|::WetSegment = |profile|::clip(application.profile.nodes[segment_index], application.profile.nodes[next], water);
        transition wet.upper > wet.lower {
            true -> accumulate(application, water_index, segment_index, wet, water),
            false -> segment(application, water_index, next)
        }
    }
    machine accumulate(application: @mutable Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping, wet: |profile|::WetSegment, water: f64) {
        let load: |pressure|::SegmentLoad = |pressure|::integrate(wet, water, application.gamma, application.hinge);
        application.area = application.area + load.area;
        application.force = application.force + load.force;
        application.first_moment = application.first_moment + load.first_moment;
        application.hinge_moment = application.hinge_moment + load.hinge_moment;
        application.wetted_count = application.wetted_count + 1;
        |console|::Console::write("WET "); |numbers|::write_integer(segment_index as -Wrapping as i64 +Wrapping);
        |console|::Console::write(" lower_um="); |numbers|::write_scaled(wet.lower);
        |console|::Console::write(" upper_um="); |numbers|::write_scaled(wet.upper);
        |console|::Console::write(" lower_width_um="); |numbers|::write_scaled(wet.lower_width);
        |console|::Console::write(" upper_width_um="); |numbers|::write_scaled(wet.upper_width);
        |console|::Console::write(" area_micro_m2="); |numbers|::write_scaled(load.area);
        |console|::Console::write(" force_uN="); |numbers|::write_scaled(load.force);
        |console|::Console::write(" moment_uNm="); |numbers|::write_scaled(load.hinge_moment);
        |console|::Console::write_line("");
        transition { _ -> segment(application, water_index, segment_index + 1) }
    }
    machine summary(application: @mutable Application, water_index: u64 in Wrapping) {
        |console|::Console::write("TOTAL wetted="); |numbers|::write_integer(application.wetted_count);
        |console|::Console::write(" area_micro_m2="); |numbers|::write_scaled(application.area);
        |console|::Console::write(" force_uN="); |numbers|::write_scaled(application.force);
        |console|::Console::write(" moment_uNm="); |numbers|::write_scaled(application.hinge_moment);
        transition application.force > 0.0 {
            true -> center(application, water_index),
            false -> dry_summary(application, water_index)
        }
    }
    machine center(application: @mutable Application, water_index: u64 in Wrapping) {
        |console|::Console::write(" center_um="); |numbers|::write_scaled(application.first_moment / application.force);
        |console|::Console::write_line("");
        transition { _ -> water(application, water_index + 1) }
    }
    machine dry_summary(application: @mutable Application, water_index: u64 in Wrapping) {
        |console|::Console::write_line(" center_um=undefined");
        transition { _ -> water(application, water_index + 1) }
    }
    machine done() { |process_exit|::ProcessExit::exit_process(0); }
    machine invalid() { |console|::Console::write_line("ERROR invalid bounded gate input"); |process_exit|::ProcessExit::exit_process(64); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
