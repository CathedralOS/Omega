use model/registration/registration.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
public data Raw { values: [f64; 113]; count: u64; }
// Finite decimal syntax; no NaN/infinity spellings or exponents. The byte and
// digit caps bound execution even on an unterminated hostile stream.
public machine read(raw: @mutable Raw) -> bool reaches |process_authority|::StandardInput invokes |console|::Console blocks crashes Trap {
    transition { _ -> next(raw, 0, 0.0, 1.0, false, false, false, 0, 0) }
    machine next(raw: @mutable Raw, bytes: u64, accumulator: f64, scale: f64, negative: bool, active: bool, fraction: bool, digits: u64, decimals: u64) -> bool {
        transition bytes < 2048 { true -> receive(raw, bytes, accumulator, scale, negative, active, fraction, digits, decimals), false -> bad() }
    }
    machine receive(raw: @mutable Raw, bytes: u64, accumulator: f64, scale: f64, negative: bool, active: bool, fraction: bool, digits: u64, decimals: u64) -> bool {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Eof -> finish(raw, accumulator, scale, negative, active, digits),
            |console|::ByteRead::Byte { value } -> classify(raw, bytes, accumulator, scale, negative, active, fraction, digits, decimals, value),
            _ -> bad()
        }
    }
    machine classify(raw: @mutable Raw, bytes: u64, accumulator: f64, scale: f64, negative: bool, active: bool, fraction: bool, digits: u64, decimals: u64, character: i32) -> bool {
        transition {
            character >= 48 && character <= 57 && digits < 12 && decimals < 8 -> digit(raw, bytes, accumulator, scale, negative, fraction, digits, decimals, character),
            character == 45 && !active -> next(raw, bytes + 1, accumulator, scale, true, true, fraction, digits, decimals),
            character == 46 && !fraction -> next(raw, bytes + 1, accumulator, scale, negative, true, true, digits, decimals),
            character == 32 || character == 9 || character == 10 || character == 13 -> separate(raw, bytes, accumulator, scale, negative, active, digits),
            _ -> bad()
        }
    }
    machine digit(raw: @mutable Raw, bytes: u64, accumulator: f64, scale: f64, negative: bool, fraction: bool, digits: u64, decimals: u64, character: i32) -> bool {
        let next_accumulator: f64 = accumulator * 10.0 + |float_operations|::F64::from_i32(character) - 48.0;
        transition fraction {
            true -> next(raw, bytes + 1, next_accumulator, scale * 10.0, negative, true, true, digits + 1, decimals + 1),
            false -> next(raw, bytes + 1, next_accumulator, scale, negative, true, false, digits + 1, decimals)
        }
    }
    machine separate(raw: @mutable Raw, bytes: u64, accumulator: f64, scale: f64, negative: bool, active: bool, digits: u64) -> bool {
        transition active { true -> capacity(raw, bytes, accumulator, scale, negative, digits, false), false -> next(raw, bytes + 1, 0.0, 1.0, false, false, false, 0, 0) }
    }
    machine finish(raw: @mutable Raw, accumulator: f64, scale: f64, negative: bool, active: bool, digits: u64) -> bool {
        transition active { true -> capacity(raw, 0, accumulator, scale, negative, digits, true), false -> good() }
    }
    machine capacity(raw: @mutable Raw, bytes: u64, accumulator: f64, scale: f64, negative: bool, digits: u64, finished: bool) -> bool {
        transition raw.count < 113 && digits > 0 { true -> store(raw, bytes, accumulator, scale, negative, finished), false -> bad() }
    }
    machine store(raw: @mutable Raw, bytes: u64, accumulator: f64, scale: f64, negative: bool, finished: bool) -> bool requires raw.count < 113 {
        let signed: f64 = sign(accumulator / scale, negative);
        raw.values[raw.count] = signed;
        raw.count = raw.count + 1;
        transition finished { true -> good(), false -> next(raw, bytes + 1, 0.0, 1.0, false, false, false, 0, 0) }
    }
    machine good() -> bool { true }
    machine bad() -> bool { false }
}
machine sign(accumulator: f64, negative: bool) -> f64 { transition negative { true -> minus(accumulator), false -> plus(accumulator) } machine minus(accumulator: f64) -> f64 { 0.0 - accumulator } machine plus(accumulator: f64) -> f64 { accumulator } }
public machine decode(raw: @Raw, problem: @mutable |registration|::Problem) -> bool {
    let count: u64 in Saturating = |float_operations|::U64::from_f64(raw.values[0]);
    transition count >= 3 && count <= 16 && |float_operations|::F64::from_u64(count as u64) == raw.values[0] && raw.count == 1 + (count as u64) * 7 {
        true -> start(raw, problem, count as u64),
        false -> bad()
    }
    machine start(raw: @Raw, problem: @mutable |registration|::Problem, count: u64) -> bool { problem.count = count; transition { _ -> scan(raw, problem, 0) } }
    machine scan(raw: @Raw, problem: @mutable |registration|::Problem, index: u64) -> bool {
        transition index < problem.count && index < 16 { true -> row(raw, problem, index), false -> good() }
    }
    machine row(raw: @Raw, problem: @mutable |registration|::Problem, index: u64) -> bool requires index < 16 {
        let offset: u64 = 1 + index * 7;
        transition raw.values[offset + 6] > 0.0 && raw.values[offset + 6] <= 1000.0
            && bounded(raw.values[offset]) && bounded(raw.values[offset + 1]) && bounded(raw.values[offset + 2])
            && bounded(raw.values[offset + 3]) && bounded(raw.values[offset + 4]) && bounded(raw.values[offset + 5]) {
            true -> save(raw, problem, index, offset),
            false -> bad()
        }
    }
    machine save(raw: @Raw, problem: @mutable |registration|::Problem, index: u64, offset: u64) -> bool requires index < 16, offset <= 106 {
        problem.source[index * 3] = raw.values[offset]; problem.source[index * 3 + 1] = raw.values[offset + 1]; problem.source[index * 3 + 2] = raw.values[offset + 2];
        problem.target[index * 3] = raw.values[offset + 3]; problem.target[index * 3 + 1] = raw.values[offset + 4]; problem.target[index * 3 + 2] = raw.values[offset + 5];
        problem.weights[index] = raw.values[offset + 6];
        transition { _ -> scan(raw, problem, index + 1) }
    }
    machine good() -> bool { true } machine bad() -> bool { false }
}
machine bounded(accumulator: f64) -> bool { |float_operations|::F64::is_finite(accumulator) && accumulator >= -1000.0 && accumulator <= 1000.0 }
