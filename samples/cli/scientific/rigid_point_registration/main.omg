use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Expected exit: 64.
// Expected output contains: error invalid input
use system\Console;
use io\input;
use io\input\Raw;
use io\input\read;
use io\input\decode;
use model\registration;
use model\registration\Problem;
use model\registration\solve;
use io\output;
use io\output\emit;
data Main { }
machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    let mutable raw: Raw;
    let accepted: bool = block read(@mutable raw);
    transition accepted { true -> validate(@raw), false -> invalid() }
    machine validate(raw: @Raw) {
        let mutable problem: Problem;
        transition decode(raw, @mutable problem) { true -> fit(@mutable problem), false -> invalid() }
    }
    machine fit(problem: @mutable Problem) {
        transition solve(problem) { true -> report(problem), false -> unidentified() }
    }
    machine report(problem: @Problem) { emit(problem); ProcessExit::exit_process(0); }
    machine unidentified() { Console::write_line("status non-identifiable"); ProcessExit::exit_process(2); }
    machine invalid() { Console::write_line("error invalid input"); ProcessExit::exit_process(64); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
