use omega\language\core\StandardInput;
use system\ByteRead;
use system\Console;
use domain\model;

public data InputReader {
    remaining: i32 in Wrapping;
    exhausted: bool;
}
public data Token {
    case Invalid;
    case End;
    case Number(value: i32);
}
// The caller sets a 32768-byte budget; exhaustion is distinct from real EOF.
machine next_byte(reader: @mutable InputReader) -> ByteRead reaches StandardInput
invokes Console
blocks
crashes Trap
{
    let byte: ByteRead = block Console::read_byte();
    transition byte {
        ByteRead::Error -> ByteRead::Error,
        ByteRead::Eof -> ByteRead::Eof,
        ByteRead::Byte { value } -> capacity(reader, value)
    }
    machine capacity(reader: @mutable InputReader, value: i32) -> ByteRead
    requires value >= 0 && value <= 255
    {
        transition reader.remaining > 0 {
            true -> consume(reader, value),
            _ -> limit(reader)
        }
    }
    machine consume(reader: @mutable InputReader, value: i32) -> ByteRead
    requires value >= 0 && value <= 255
    {
        reader.remaining = reader.remaining - 1;
        ByteRead::Byte { value: value }
    }
    machine limit(reader: @mutable InputReader) -> ByteRead {
        reader.exhausted = true;
        ByteRead::Eof
    }
}
public machine token(reader: @mutable InputReader) -> Token reaches StandardInput
invokes Console
blocks
crashes Trap
{
    transition { _ -> block skip(reader) }
    machine skip(reader: @mutable InputReader) -> Token {
        let byte: ByteRead = block next_byte(reader);
        transition byte {
            ByteRead::Error -> Token::Invalid,
            ByteRead::Eof -> Token::End,
            ByteRead::Byte { value } -> block first(reader, value)
        }
    }
    machine first(reader: @mutable InputReader, byte: i32) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> block skip(reader),
            _ -> block sign(reader, byte)
        }
    }
    machine sign(reader: @mutable InputReader, byte: i32) -> Token {
        transition byte == 45 {
            true -> block next(reader, 0, 0, true),
            _ -> block digit(reader, byte, 0, 0, false)
        }
    }
    machine digit(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte >= 48 && byte <= 57 && digits < 7 {
            true -> block accumulate(reader, byte, magnitude, digits, negative),
            _ -> Token::Invalid
        }
    }
    machine accumulate(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                     digits: i32 in Wrapping, negative: bool) -> Token {
        let updated: i32 in Wrapping = magnitude * 10 + (byte as i32 +Wrapping) - 48;
        transition updated <= 1000000 {
            true -> block next(reader, updated, digits + 1, negative),
            _ -> Token::Invalid
        }
    }
    machine next(reader: @mutable InputReader, magnitude: i32 in Wrapping,
               digits: i32 in Wrapping, negative: bool) -> Token {
        let byte: ByteRead = block next_byte(reader);
        transition byte {
            ByteRead::Error -> Token::Invalid,
            ByteRead::Eof -> finish(magnitude, digits, negative),
            ByteRead::Byte { value } -> block delimiter(reader, value, magnitude, digits, negative)
        }
    }
    machine delimiter(reader: @mutable InputReader, byte: i32, magnitude: i32 in Wrapping,
                    digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> finish(magnitude, digits, negative),
            _ -> block digit(reader, byte, magnitude, digits, negative)
        }
    }
    machine finish(magnitude: i32 in Wrapping, digits: i32 in Wrapping, negative: bool) -> Token {
        transition digits > 0 {
            true -> signed_value(magnitude, negative),
            _ -> Token::Invalid
        }
    }
    machine signed_value(magnitude: i32 in Wrapping, negative: bool) -> Token {
        transition negative {
            true -> Token::Number { value: (0 - magnitude) as i32 },
            _ -> Token::Number { value: magnitude as i32 }
        }
    }
}
