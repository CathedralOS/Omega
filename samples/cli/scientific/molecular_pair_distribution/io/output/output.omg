use domain/precision/precision.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
// Every emitted quantity is below 10^12 in magnitude by the input envelope.
public machine integer(value: i64 in Wrapping) reaches |process_authority|::StandardOutput
invokes |console|::Console
crashes Trap
{
    transition value < 0 { true -> negative(value), _ -> digits(value, 1000000000000, false) }
    machine negative(value: i64 in Wrapping) {
        |console|::Console::write("-");
        transition { _ -> digits(0 - value, 1000000000000, false) }
    }
    machine digits(value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool)
    requires divisor > 0
    {
        let digit: i64 in Wrapping = value / divisor;
        transition digit != 0 || started || divisor == 1 {
            true -> emit(value, divisor, digit),
            _ -> advance(value, divisor, false)
        }
    }
    machine emit(value: i64 in Wrapping, divisor: i64 in Wrapping, digit: i64 in Wrapping)
    requires divisor > 0
    {
        |console|::Console::write_byte(|numeric_conversion|::narrow_i64_to_i32_trapping((digit + 48) as i64));
        transition { _ -> advance(value % divisor, divisor, true) }
    }
    machine advance(value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool) {
        transition divisor >= 10 { true -> next(value, divisor, started), _ -> done() }
    }
    machine next(value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool)
    requires divisor >= 10
    {
        transition { _ -> digits(value, divisor / 10, started) }
    }
    machine done() { }
}

// Scientific decimal output keeps the absolute error below 1e-8 for the
// qualification envelope, without saturating an integer scaled g(r).
public machine real(value: f64) reaches |process_authority|::StandardOutput invokes |console|::Console crashes Trap {
    transition value == 0.0 { true -> zero(), _ -> normalize(value, 0) }
    machine zero() { |console|::Console::write("0"); }
    machine normalize(value: f64, exponent: i64 in Wrapping) {
        transition value >= 10.0 { true -> normalize(value / 10.0, exponent + 1), _ -> raise(value, exponent) }
    }
    machine raise(value: f64, exponent: i64 in Wrapping) {
        transition value < 1.0 { true -> normalize(value * 10.0, exponent - 1), _ -> digit(value, exponent, 0) }
    }
    machine digit(value: f64, exponent: i64 in Wrapping, position: i32 in Wrapping) {
        let converted: i32 in Saturating = |float_operations|::I32::from_f64(value);
        let whole: i32 = converted as i32;
        |console|::Console::write_byte(((48 as i32 +Wrapping) + (whole as i32 +Wrapping)) as i32);
        transition position == 0 { true -> point(value, exponent, position, whole), _ -> next(value, exponent, position, whole) }
    }
    machine point(value: f64, exponent: i64 in Wrapping, position: i32 in Wrapping, whole: i32) {
        |console|::Console::write(".");
        transition { _ -> next(value, exponent, position, whole) }
    }
    machine next(value: f64, exponent: i64 in Wrapping, position: i32 in Wrapping, whole: i32) {
        transition position < 16 { true -> digit((value - |float_operations|::F64::from_i32(whole)) * 10.0, exponent, position + 1), _ -> end(exponent) }
    }
    machine end(exponent: i64 in Wrapping) { |console|::Console::write("e"); integer(exponent); }
}

public machine precise_real(value: |precision|::Precise) reaches |process_authority|::StandardOutput invokes |console|::Console crashes Trap {
    transition value.high == 0.0 { true -> zero(), _ -> normalize(value, 0) }
    machine zero() { |console|::Console::write("0"); }
    machine normalize(value: |precision|::Precise, exponent: i64 in Wrapping) {
        transition value.high >= 10.0 { true -> reduce(value, exponent), _ -> settle(value, exponent) }
    }
    machine settle(value: |precision|::Precise, exponent: i64 in Wrapping) {
        transition value.high < 1.0 { true -> increase(value, exponent), _ -> digit(value, exponent, 0) }
    }
    machine reduce(value: |precision|::Precise, exponent: i64 in Wrapping) {
        let reciprocal: |precision|::Precise = |precision|::Precise { high: 0.1, low: -0.000000000000000005551115123125782702118 };
        transition { _ -> normalize(|precision|::multiply(value, reciprocal), exponent + 1) }
    }
    machine increase(value: |precision|::Precise, exponent: i64 in Wrapping) {
        transition { _ -> normalize(|precision|::multiply(value, |precision|::Precise { high: 10.0, low: 0.0 }), exponent - 1) }
    }
    machine digit(value: |precision|::Precise, exponent: i64 in Wrapping, position: i32 in Wrapping) {
        let converted: i32 in Saturating = |float_operations|::I32::from_f64(value.high);
        let whole: i32 in Wrapping = (converted as i32) as i32 +Wrapping;
        transition value.high == |float_operations|::F64::from_i32(whole as i32) && value.low < 0.0 {
            true -> emit(value, exponent, position, whole - 1), _ -> emit(value, exponent, position, whole)
        }
    }
    machine emit(value: |precision|::Precise, exponent: i64 in Wrapping, position: i32 in Wrapping, whole: i32 in Wrapping) {
        |console|::Console::write_byte((48 + whole) as i32);
        transition position == 0 { true -> point(value, exponent, position, whole), _ -> next(value, exponent, position, whole) }
    }
    machine point(value: |precision|::Precise, exponent: i64 in Wrapping, position: i32 in Wrapping, whole: i32 in Wrapping) {
        |console|::Console::write("."); transition { _ -> next(value, exponent, position, whole) }
    }
    machine next(value: |precision|::Precise, exponent: i64 in Wrapping, position: i32 in Wrapping, whole: i32 in Wrapping) {
        let remainder: |precision|::Precise = |precision|::precise_sum(value.high - |float_operations|::F64::from_i32(whole as i32), value.low);
        transition position < 18 {
            true -> digit(|precision|::multiply(remainder, |precision|::Precise { high: 10.0, low: 0.0 }), exponent, position + 1), _ -> end(exponent)
        }
    }
    machine end(exponent: i64 in Wrapping) { |console|::Console::write("e"); integer(exponent); }
}
