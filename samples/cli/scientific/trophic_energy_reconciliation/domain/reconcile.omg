// Recorded flows are simultaneous transfers, not iterative population dynamics.
// A cycle conserves raw energy once per edge and creates no external supply.
public data Web {
    external: [i32 in Saturating; 3];
    maintenance: [i32 in Saturating; 3];
    intake: [i32 in Saturating; 3];
    assimilated: [i32 in Saturating; 3];
    outgoing: [i32 in Saturating; 3];
    loss: i32 in Saturating;
}
public machine transfer(web: &mut Web, source: u64, destination: u64, intake: i32 in Saturating, efficiency: i32 in Saturating)
requires source < 3 requires destination < 3 {
    let raw: i32 in Saturating = intake * 100;
    let converted: i32 in Saturating = intake * efficiency;
    web.outgoing[source] = web.outgoing[source] + raw;
    web.intake[destination] = web.intake[destination] + raw;
    web.assimilated[destination] = web.assimilated[destination] + converted;
    web.loss = web.loss + raw - converted;
}
public machine residual(web: &Web, node: u64) -> i32 in Saturating requires node < 3 {
    web.external[node] * 100 + web.assimilated[node] - web.maintenance[node] * 100 - web.outgoing[node]
}
public machine deficit(balance: i32 in Saturating) -> i32 in Saturating {
    transition balance < 0 { true -> (0 - balance) false -> (0) }
}
public machine surplus(balance: i32 in Saturating) -> i32 in Saturating {
    transition balance > 0 { true -> (balance) false -> (0) }
}
