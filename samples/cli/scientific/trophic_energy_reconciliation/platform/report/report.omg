use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
// Signed fixed-width decimal in hundredths of an energy unit.
public machine number(value: i32 in Saturating) reaches |process_authority|::StandardOutput
invokes |console|::Console
{
    transition value < 0 { true -> negative(value), false -> positive(value) }
    machine negative(value: i32 in Saturating) {
        |console|::Console::write("-");
        transition { _ -> positive(0 - value) }
    }
    machine positive(value: i32 in Saturating) {
        |console|::Console::write_byte(((value / 1000000 % 10) + 48) as i32);
        |console|::Console::write_byte(((value / 100000 % 10) + 48) as i32);
        |console|::Console::write_byte(((value / 10000 % 10) + 48) as i32);
        |console|::Console::write_byte(((value / 1000 % 10) + 48) as i32);
        |console|::Console::write_byte(((value / 100 % 10) + 48) as i32);
        |console|::Console::write_byte(((value / 10 % 10) + 48) as i32);
        |console|::Console::write_byte(((value / 1 % 10) + 48) as i32);
        |console|::Console::write_line("");
    }
}
