use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
// Finite decimal tokens, 0..1000. -1 means malformed, missing, or oversized.
// Separators are ASCII space and LF. EOF terminates a token, never invents one.
public machine read_number() -> i32 in Saturating
reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> block scan(0, false, 0) }
    machine scan(accumulated: i32 in Saturating, seen: bool, digits: u64) -> i32 in Saturating {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Eof -> finish(accumulated, seen),
            |console|::ByteRead::Byte { value } -> block classify(accumulated, seen, digits, value),
            _ -> (-1)
        }
    }
    machine classify(accumulated: i32 in Saturating, seen: bool, digits: u64, byte: i32) -> i32 in Saturating {
        transition byte == 32 || byte == 10 {
            true -> block separator(accumulated, seen, digits),
            false -> block digit(accumulated, digits, byte)
        }
    }
    machine separator(accumulated: i32 in Saturating, seen: bool, digits: u64) -> i32 in Saturating {
        transition seen {
            true -> (accumulated),
            false -> block scan(accumulated, seen, digits)
        }
    }
    machine digit(accumulated: i32 in Saturating, digits: u64, byte: i32) -> i32 in Saturating {
        transition byte >= 48 && byte <= 57 && digits < 4 {
            true -> block accumulate(accumulated, digits, byte),
            false -> (-1)
        }
    }
    machine accumulate(accumulated: i32 in Saturating, digits: u64, byte: i32) -> i32 in Saturating
    requires digits < 4 {
        let next: i32 in Saturating = accumulated * 10 + (byte as +Saturating) - 48;
        transition next <= 1000 {
            true -> block scan(next, true, digits + 1),
            false -> (-1)
        }
    }
    machine finish(accumulated: i32 in Saturating, seen: bool) -> i32 in Saturating {
        transition seen { true -> (accumulated), false -> (-1) }
    }
}

public machine require_end() -> bool reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    let observed: |console|::ByteRead = block |console|::Console::read_byte();
    transition observed {
        |console|::ByteRead::Eof -> (true),
        |console|::ByteRead::Byte { value } -> block separator(value),
        _ -> (false)
    }
    machine separator(value: i32) -> bool {
        transition value == 32 || value == 10 {
            true -> block again(),
            false -> (false)
        }
    }
    machine again() -> bool {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Eof -> (true),
            |console|::ByteRead::Byte { value } -> block separator(value),
            _ -> (false)
        }
    }
}
