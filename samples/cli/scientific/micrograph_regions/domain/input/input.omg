use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

public data Image {
    width: i32 in Wrapping;
    height: i32 in Wrapping;
    threshold: i32 in Wrapping;
    connectivity: i32 in Wrapping;
    length: i32 in Wrapping;
    pixels: [i32; 64];
    labels: [i32; 64];
    queue: [i32; 64];
    head: i32 in Wrapping;
    tail: i32 in Wrapping;
    components: i32 in Wrapping;
}
data Token { value: i32 in Wrapping; valid: bool; }

// Strict unsigned decimal scanner, bounded to three digits. EOF after a
// number is accepted; EOF before a required number is invalid. Only ASCII
// whitespace separates tokens. An offending character never becomes zero.
machine token(token: @mutable Token)
reaches |process_authority|::StandardInput {
    token.valid = false;
    token.value = 0;
    transition { _ -> leading(token) }
    machine leading(token: @mutable Token) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> stopped(),
            |console|::ByteRead::Eof -> stopped(),
            |console|::ByteRead::Byte { value } -> first(token, value)
        }
    }
    machine first(token: @mutable Token, character: i32) {
        transition character == 32 || character == 9 || character == 10 || character == 13 {
            true -> leading(token),
            false -> digit(token, character, 0)
        }
    }
    machine digit(token: @mutable Token, character: i32, count: i32 in Wrapping) {
        transition character >= 48 && character <= 57 && count < 3 {
            true -> accumulate(token, character, count),
            false -> stopped()
        }
    }
    machine accumulate(token: @mutable Token, character: i32, count: i32 in Wrapping) {
        token.value = token.value * 10 + (character as +Wrapping) - 48;
        transition { _ -> next(token, count + 1) }
    }
    machine next(token: @mutable Token, count: i32 in Wrapping) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> stopped(),
            |console|::ByteRead::Eof -> complete(token),
            |console|::ByteRead::Byte { value } -> separator(token, value, count)
        }
    }
    machine separator(token: @mutable Token, character: i32, count: i32 in Wrapping) {
        transition character == 32 || character == 9 || character == 10 || character == 13 {
            true -> complete(token),
            false -> digit(token, character, count)
        }
    }
    machine complete(token: @mutable Token) { token.valid = true; }
    machine stopped() {}
}

public machine read_image(image: @mutable Image) -> bool
invokes |console|::Console
reaches |process_authority|::StandardInput
blocks
crashes Trap
{
    let mutable number: Token;
    block token(@mutable number);
    image.width = number.value;
    transition number.valid && number.value >= 1 && number.value <= 8 {
        true -> height(image),
        false -> false
    }
    machine height(image: @mutable Image) -> bool {
        let mutable number: Token;
        block token(@mutable number);
        image.height = number.value;
        transition number.valid && number.value >= 1 && number.value <= 8 {
            true -> threshold(image),
            false -> false
        }
    }
    machine threshold(image: @mutable Image) -> bool {
        let mutable number: Token;
        block token(@mutable number);
        image.threshold = number.value;
        transition number.valid && number.value <= 255 {
            true -> connectivity(image),
            false -> false
        }
    }
    machine connectivity(image: @mutable Image) -> bool {
        let mutable number: Token;
        block token(@mutable number);
        image.connectivity = number.value;
        image.length = image.width * image.height;
        transition number.valid && (number.value == 4 || number.value == 8) {
            true -> pixels(image, 0),
            false -> false
        }
    }
    machine pixels(image: @mutable Image, position: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 64 && position < image.length {
            true -> store(image, position),
            false -> trailing()
        }
    }
    machine store(image: @mutable Image, position: i32 in Wrapping) -> bool {
        let mutable number: Token;
        block token(@mutable number);
        transition number.valid && number.value <= 255 {
            true -> accepted(image, position, number.value),
            false -> false
        }
    }
    machine accepted(image: @mutable Image, position: i32 in Wrapping, value: i32 in Wrapping) -> bool {
        image.pixels[position] = value as i32;
        image.labels[position] = 0;
        transition { _ -> pixels(image, position + 1) }
    }
    machine trailing() -> bool {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> false,
            |console|::ByteRead::Eof -> true,
            |console|::ByteRead::Byte { value } -> whitespace(value)
        }
    }
    machine whitespace(character: i32) -> bool {
        transition character == 32 || character == 9 || character == 10 || character == 13 {
            true -> trailing(),
            false -> false
        }
    }
}
