use domain/input/input.omg;
use domain/output/output.omg;
use domain/regions/regions.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Runtime grayscale analysis. No dependency on shared numeric algorithms.
// Expected exit: 2 (EOF from the generic sample harness is invalid input).
// Expected output contains: ERROR invalid image:

data Main { }

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable image: |input|::Image;
    let valid: bool = block |input|::read_image(@mutable image);
    transition valid {
        true -> analyze(main, @mutable image),
        false -> invalid(main)
    }
    machine analyze(main: @mutable Main, image: @mutable |input|::Image) {
        let complete: bool = |regions|::label_regions(image);
        transition complete {
            true -> report(main, image),
            false -> internal(main)
        }
    }
    machine report(main: @mutable Main, image: @|input|::Image) {
        |output|::render(image);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(main: @mutable Main) {
        |console|::Console::write_line("ERROR invalid image: width height 1..8, threshold 0..255, connectivity 4 or 8, exact pixels 0..255");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine internal(main: @mutable Main) {
        |console|::Console::write_line("ERROR internal capacity invariant");
        |process_exit|::ProcessExit::exit_process(3);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
