use spectrometer/input/input.omg;
use spectrometer/matching/matching.omg;
use spectrometer/model/model.omg;
use spectrometer/output/output.omg;
use spectrometer/regions/regions.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 2 (empty stdin).
// Expected output contains: invalid spectrum input
// Valid spectrum/catalog fixtures exit 0 and emit regions and catalog matches.

// The ordinary hosted entry consumes one complete bounded spectrum/catalog
// inventory. There are no built-in answers or scenario-dependent branches.
public machine main(application: @mutable |model|::Spectrometer) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> block input(application, 0) }
    machine input(application: @mutable |model|::Spectrometer, index: i32 in Wrapping) {
        transition index >= 0 && index < 27 {
            true -> block token(application, index),
            false -> block trailing(application)
        }
    }
    machine token(application: @mutable |model|::Spectrometer, index: i32 in Wrapping) {
        transition block |input|::read_integer(application) {
            |model|::IntegerRead::Value { value } -> block store(application, index, value),
            _ -> invalid(application)
        }
    }
    machine store(application: @mutable |model|::Spectrometer, index: i32 in Wrapping,
                value: i32 in Wrapping) {
        application.raw[index] = value;
        transition { _ -> block input(application, index + 1) }
    }
    machine trailing(application: @mutable |model|::Spectrometer) {
        transition block |input|::read_integer(application) {
            |model|::IntegerRead::End -> validate(application),
            _ -> invalid(application)
        }
    }
    machine validate(application: @mutable |model|::Spectrometer) {
        transition |input|::load_spectrum(application) {
            true -> analyze(application),
            false -> invalid(application)
        }
    }
    machine analyze(application: @mutable |model|::Spectrometer) {
        transition |regions|::find_regions(@application.spectrum, @mutable application.regions) {
            true -> report(application),
            false -> capacity(application)
        }
    }
    machine report(application: @mutable |model|::Spectrometer) {
        |matching|::match_regions(@application.spectrum, @mutable application.regions);
        |output|::print_report(application);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine invalid(application: @mutable |model|::Spectrometer) {
        |console|::Console::write_line("invalid spectrum input");
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine capacity(application: @mutable |model|::Spectrometer) {
        |console|::Console::write_line("region capacity exceeded");
        |process_exit|::ProcessExit::exit_process(3);
    }
}
