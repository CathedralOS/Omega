use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Expected exit: 2 (empty stdin).
// Expected output contains: invalid spectrum input
// Valid spectrum/catalog fixtures exit 0 and emit regions and catalog matches.
use system\Console;
use spectrometer\model\Spectrometer;
use spectrometer\model\IntegerRead;
use spectrometer\input\read_integer;
use spectrometer\input\load_spectrum;
use spectrometer\regions\find_regions;
use spectrometer\matching\match_regions;
use spectrometer\output\print_report;

// The ordinary hosted entry consumes one complete bounded spectrum/catalog
// inventory. There are no built-in answers or scenario-dependent branches.
public machine main(application: @mutable Spectrometer) reaches ProcessExit + StandardInput + StandardOutput
invokes Console
blocks
crashes Trap
{
    transition { _ -> block input(application, 0) }
    machine input(application: @mutable Spectrometer, index: i32 in Wrapping) {
        transition index >= 0 && index < 27 {
            true -> block token(application, index),
            false -> block trailing(application)
        }
    }
    machine token(application: @mutable Spectrometer, index: i32 in Wrapping) {
        transition block read_integer(application) {
            IntegerRead::Value { value } -> block store(application, index, value),
            _ -> invalid(application)
        }
    }
    machine store(application: @mutable Spectrometer, index: i32 in Wrapping,
                value: i32 in Wrapping) {
        application.raw[index] = value;
        transition { _ -> block input(application, index + 1) }
    }
    machine trailing(application: @mutable Spectrometer) {
        transition block read_integer(application) {
            IntegerRead::End -> validate(application),
            _ -> invalid(application)
        }
    }
    machine validate(application: @mutable Spectrometer) {
        transition load_spectrum(application) {
            true -> analyze(application),
            false -> invalid(application)
        }
    }
    machine analyze(application: @mutable Spectrometer) {
        transition find_regions(@application.spectrum, @mutable application.regions) {
            true -> report(application),
            false -> capacity(application)
        }
    }
    machine report(application: @mutable Spectrometer) {
        match_regions(@application.spectrum, @mutable application.regions);
        print_report(application);
        ProcessExit::exit_process(0);
    }
    machine invalid(application: @mutable Spectrometer) {
        Console::write_line("invalid spectrum input");
        ProcessExit::exit_process(2);
    }
    machine capacity(application: @mutable Spectrometer) {
        Console::write_line("region capacity exceeded");
        ProcessExit::exit_process(3);
    }
}
