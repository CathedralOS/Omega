machine build(builder: &mut Build) {
    Build::application(builder, "spectrometer_attribution");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../source/library/std" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, spectrometer::Spectrometer::main);
    Build::bind(builder, linux_arm64::ProgramEntry, spectrometer::Spectrometer::main);
    Build::bind(builder, macos_arm64::ProgramEntry, spectrometer::Spectrometer::main);
    Build::bind(builder, macos_x86_64::ProgramEntry, spectrometer::Spectrometer::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, spectrometer::Spectrometer::main);
}
