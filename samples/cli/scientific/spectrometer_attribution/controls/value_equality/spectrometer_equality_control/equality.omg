use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Expected exit: 0.
// Expected output contains: float equality: equal and unequal
use system\ByteRead;
use system\Console;
use omega\language\core\F64::from_i32;

public data Main { }

// A value-returning body uses ordinary Float::equal. Merely returning bool or
// sharing the carrier of a resultless law must not grant proposition equality.
machine same(left: f64, right: f64) -> bool { left == right }

public machine main(application: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput
invokes Console
blocks
crashes Trap
{
    transition block Console::read_byte() {
        ByteRead::Byte { value } -> compare(application, value),
        _ -> bad(application)
    }
    machine compare(application: @mutable Main, value: i32) {
        let floating: f64 = F64::from_i32(value);
        transition same(floating, 65.0) && !same(floating, 66.0) {
            true -> done(application),
            false -> bad(application)
        }
    }
    machine done(application: @mutable Main) {
        Console::write_line("float equality: equal and unequal");
        ProcessExit::exit_process(0);
    }
    machine bad(application: @mutable Main) { ProcessExit::exit_process(3); }
}
