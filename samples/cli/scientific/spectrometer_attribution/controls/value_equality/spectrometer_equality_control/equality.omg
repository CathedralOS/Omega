use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0.
// Expected output contains: float equality: equal and unequal

public data Main { }

// A value-returning body uses ordinary Float::equal. Merely returning bool or
// sharing the carrier of a resultless law must not grant proposition equality.
machine same(left: f64, right: f64) -> bool { left == right }

public machine main(application: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput
invokes |console|::Console
blocks
crashes Trap
{
    transition block |console|::Console::read_byte() {
        |console|::ByteRead::Byte { value } -> compare(application, value),
        _ -> bad(application)
    }
    machine compare(application: @mutable Main, value: i32) {
        let floating: f64 = |float_operations|::F64::from_i32(value);
        transition same(floating, 65.0) && !same(floating, 66.0) {
            true -> done(application),
            false -> bad(application)
        }
    }
    machine done(application: @mutable Main) {
        |console|::Console::write_line("float equality: equal and unequal");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine bad(application: @mutable Main) { |process_exit|::ProcessExit::exit_process(3); }
}
