machine build(builder: &mut Build) {
    Build::application(builder, "spectrometer_equality_control");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../../source/library/std" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, spectrometer_equality_control::Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, spectrometer_equality_control::Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, spectrometer_equality_control::Main::main);
}
