use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "spectrometer_equality_control");
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../../../../../../source/library/system" }));
    Build::bind(builder, linux_x86_64\ProgramEntry, spectrometer_equality_control\main);
    Build::bind(builder, macos_arm64\ProgramEntry, spectrometer_equality_control\main);
    Build::bind(builder, windows_x86_64\ProgramEntry, spectrometer_equality_control\main);
}
