use domain/clip/clip.omg;
use domain/geometry/geometry.omg;
use domain/model/model.omg;
use domain/verify/verify.omg;
use platform/input/input.omg;
use platform/output/output.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Complete bounded planar partition application. No external numeric package.
data Main { reader: |input|::Reader; partition: |model|::Partition; }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    main.reader.valid = true;
    main.partition.valid = true;
    block |input|::read_integer(@mutable main.reader);
    transition main.reader.valid && main.reader.value >= 3.0 && main.reader.value <= 12.0 {
        true -> block count(main),
        false -> invalid()
    }
    machine count(main: @mutable Main) {
        main.partition.boundary.count = |float_operations|::U64::from_f64(main.reader.value) as u64;
        transition { _ -> block boundary(main, 0) }
    }
    machine boundary(main: @mutable Main, index: u64) {
        transition index < main.partition.boundary.count && index < 32 {
            true -> block coordinate(main, index),
            false -> block site_count(main)
        }
    }
    machine coordinate(main: @mutable Main, index: u64) {
        block |input|::read_integer(@mutable main.reader);
        main.partition.boundary.x[index] = main.reader.value;
        block |input|::read_integer(@mutable main.reader);
        main.partition.boundary.y[index] = main.reader.value;
        transition main.reader.valid { true -> block boundary(main, index + 1), false -> invalid() }
    }
    machine site_count(main: @mutable Main) {
        block |input|::read_integer(@mutable main.reader);
        transition main.reader.valid && main.reader.value >= 1.0 && main.reader.value <= 8.0 {
            true -> block sites(main),
            false -> invalid()
        }
    }
    machine sites(main: @mutable Main) {
        main.partition.site_count = |float_operations|::U64::from_f64(main.reader.value) as u64;
        transition { _ -> block site(main, 0) }
    }
    machine site(main: @mutable Main, index: u64) {
        transition index < main.partition.site_count && index < 8 {
            true -> block location(main, index),
            false -> block validate(main)
        }
    }
    machine location(main: @mutable Main, index: u64) {
        block |input|::read_integer(@mutable main.reader);
        main.partition.site_x[index] = main.reader.value;
        block |input|::read_integer(@mutable main.reader);
        main.partition.site_y[index] = main.reader.value;
        transition main.reader.valid { true -> block site(main, index + 1), false -> invalid() }
    }
    machine validate(main: @mutable Main) {
        block |input|::end_input(@mutable main.reader);
        let boundary_ok: bool = |geometry|::boundary_valid(@main.partition.boundary);
        let sites_ok: bool = |geometry|::sites_valid(@main.partition);
        transition main.reader.valid && boundary_ok && sites_ok {
            true -> partition(main),
            false -> invalid()
        }
    }
    machine partition(main: @mutable Main) {
        |clip|::construct(@mutable main.partition);
        |verify|::verify(@mutable main.partition);
        transition main.partition.valid && main.partition.nearest {
            true -> success(main),
            false -> failed()
        }
    }
    machine success(main: @mutable Main) { |output|::emit(@main.partition); |process_exit|::ProcessExit::exit_process(0); }
    machine invalid() { |console|::Console::write_line("INVALID_INPUT"); |process_exit|::ProcessExit::exit_process(64); }
    machine failed() { |console|::Console::write_line("PARTITION_FAILED"); |process_exit|::ProcessExit::exit_process(70); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
