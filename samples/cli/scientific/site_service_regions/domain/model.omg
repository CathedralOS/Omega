// Invocation-private bounded storage: clipping a convex 12-edge boundary by
// at most seven bisectors needs at most 19 distinct vertices. Capacity 32 leaves margin;
// overflow is still an explicit application failure, never a silent truncation.
public data Polygon [copy] { x: [f64; 32]; y: [f64; 32]; count: u64; }
public data Partition {
    boundary: Polygon;
    site_x: [f64; 8]; site_y: [f64; 8]; site_count: u64;
    cells: [Polygon; 8]; areas: [f64; 8];
    adjacency: [bool; 64]; valid: bool; nearest: bool; total: f64;
}
