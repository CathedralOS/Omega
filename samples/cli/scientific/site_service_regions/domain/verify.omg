use omega::language::core::float_operations;
use domain::model;
use domain::geometry;
// Independent distance checks inspect all vertices and edge midpoints. Squared
// distance is affine after subtracting two site distances, so a convex cell's
// vertex checks also certify its entire interior within the stated tolerance.
public machine nearest(partition: &Partition, owner: u64, x: f64, y: f64) -> bool
requires owner < 8
{
    let own: f64 = distance(x, y, partition.site_x[owner], partition.site_y[owner]);
    transition { _ -> other(partition, owner, x, y, own, 0) }
    machine other(partition: &Partition, owner: u64, x: f64, y: f64, own: f64, index: u64) -> bool
    requires owner < 8
    {
        transition index < partition.site_count && index < 8 {
            true -> test(partition, owner, x, y, own, index)
            false -> (true)
        }
    }
    machine test(partition: &Partition, owner: u64, x: f64, y: f64, own: f64, index: u64) -> bool
    requires owner < 8 && index < 8
    {
        let rival: f64 = distance(x, y, partition.site_x[index], partition.site_y[index]);
        transition own <= rival + 0.000001 {
            true -> other(partition, owner, x, y, own, index + 1)
            false -> (false)
        }
    }
}
// Adjacency requires a positive-length edge on the exact pair's bisector.
// Touching at only one vertex never creates an adjacency edge.
public machine shared(partition: &Partition, owner: u64, rival: u64) -> bool
requires owner < 8 && rival < 8
{
    transition owner == rival { true -> (false) false -> edge(partition, owner, rival, 0) }
    machine edge(partition: &Partition, owner: u64, rival: u64, index: u64) -> bool
    requires owner < 8 && rival < 8
    {
        let count: u64 = partition.cells[owner].count;
        transition count > 0 && count <= 32 && index < count && index < 32 {
            true -> test(partition, owner, rival, index, (index + 1) % count)
            false -> (false)
        }
    }
    machine test(partition: &Partition, owner: u64, rival: u64, index: u64, next: u64) -> bool
    requires owner < 8 && rival < 8 && index < 32 && next < 32
    {
        let x: f64 = partition.cells[owner].x[index];
        let y: f64 = partition.cells[owner].y[index];
        let end_x: f64 = partition.cells[owner].x[next];
        let end_y: f64 = partition.cells[owner].y[next];
        let start_difference: f64 = distance(x,y,partition.site_x[owner],partition.site_y[owner])
            - distance(x,y,partition.site_x[rival],partition.site_y[rival]);
        let end_difference: f64 = distance(end_x,end_y,partition.site_x[owner],partition.site_y[owner])
            - distance(end_x,end_y,partition.site_x[rival],partition.site_y[rival]);
        let length: f64 = distance(x,y,end_x,end_y);
        transition absolute(start_difference) <= 0.000001 && absolute(end_difference) <= 0.000001 && length > 0.000000000001 {
            true -> (true)
            false -> edge(partition, owner, rival, index + 1)
        }
    }
}
public machine verify(partition: &mut Partition) {
    partition.total = 0.0;
    partition.nearest = true;
    transition { _ -> cell(partition, 0) }
    machine cell(partition: &mut Partition, owner: u64) {
        transition owner < partition.site_count && owner < 8 {
            true -> measure(partition, owner)
            false -> finish(partition)
        }
    }
    machine measure(partition: &mut Partition, owner: u64)
    requires owner < 8
    {
        let measured: f64 = area(&partition.cells[owner]);
        partition.areas[owner] = measured;
        partition.total = partition.total + measured;
        transition measured > 0.0 { true -> vertex(partition, owner, 0) false -> fail(partition) }
    }
    machine vertex(partition: &mut Partition, owner: u64, index: u64)
    requires owner < 8
    {
        let count: u64 = partition.cells[owner].count;
        transition count > 0 && count <= 32 && index < count && index < 32 {
            true -> test(partition, owner, index, (index + 1) % count)
            false -> adjacent(partition, owner, 0)
        }
    }
    machine test(partition: &mut Partition, owner: u64, index: u64, next: u64)
    requires owner < 8 && index < 32 && next < 32
    {
        let vertex_ok: bool = nearest(partition, owner, partition.cells[owner].x[index], partition.cells[owner].y[index]);
        let middle_ok: bool = nearest(partition, owner,
            (partition.cells[owner].x[index] + partition.cells[owner].x[next]) * 0.5,
            (partition.cells[owner].y[index] + partition.cells[owner].y[next]) * 0.5);
        transition vertex_ok && middle_ok {
            true -> vertex(partition, owner, index + 1)
            false -> fail(partition)
        }
    }
    machine adjacent(partition: &mut Partition, owner: u64, rival: u64)
    requires owner < 8
    {
        transition rival < partition.site_count && rival < 8 {
            true -> relation(partition, owner, rival)
            false -> cell(partition, owner + 1)
        }
    }
    machine relation(partition: &mut Partition, owner: u64, rival: u64)
    requires owner < 8 && rival < 8
    {
        let connected: bool = shared(partition, owner, rival);
        partition.adjacency[owner * 8 + rival] = connected;
        transition { _ -> adjacent(partition, owner, rival + 1) }
    }
    machine finish(partition: &mut Partition) {
        let expected: f64 = area(&partition.boundary);
        transition absolute(partition.total - expected) <= 0.000001 {
            true -> done()
            false -> fail(partition)
        }
    }
    machine fail(partition: &mut Partition) { partition.valid = false; partition.nearest = false; }
    machine done() { }
}
