use omega::language::core::float_operations;
use domain::model;
// Sutherland-Hodgman clipping against a*x+b*y<=c. No geometric tolerance
// changes cell ownership: points exactly on a bisector belong to both closures.
public machine append(polygon: &mut Polygon, x: f64, y: f64) -> bool {
    transition polygon.count < 32 {
        true -> store(polygon, x, y)
        false -> (false)
    }
    machine store(polygon: &mut Polygon, x: f64, y: f64) -> bool {
        polygon.x[polygon.count] = x;
        polygon.y[polygon.count] = y;
        polygon.count = polygon.count + 1;
        true
    }
}
public machine clip(input: &Polygon, output: &mut Polygon, a: f64, b: f64, c: f64) -> bool {
    output.count = 0;
    transition { _ -> edge(input, output, a, b, c, 0) }
    machine edge(input: &Polygon, output: &mut Polygon, a: f64, b: f64, c: f64, index: u64) -> bool {
        let count: u64 = input.count;
        transition count > 0 && count <= 32 && index < count && index < 32 {
            true -> classify(input, output, a, b, c, index, (index + 1) % count)
            false -> (true)
        }
    }
    machine classify(input: &Polygon, output: &mut Polygon, a: f64, b: f64, c: f64, index: u64, next: u64) -> bool
    requires index < 32 && next < 32
    {
        let start: f64 = a * input.x[index] + b * input.y[index] - c;
        let finish: f64 = a * input.x[next] + b * input.y[next] - c;
        transition (start <= 0.0) != (finish <= 0.0) {
            true -> crossing(input, output, a, b, c, index, next, start, finish)
            false -> endpoint(input, output, a, b, c, index, next, finish)
        }
    }
    machine crossing(input: &Polygon, output: &mut Polygon, a: f64, b: f64, c: f64, index: u64, next: u64, start: f64, finish: f64) -> bool
    requires index < 32 && next < 32
    {
        let fraction: f64 = start / (start - finish);
        let x: f64 = input.x[index] + fraction * (input.x[next] - input.x[index]);
        let y: f64 = input.y[index] + fraction * (input.y[next] - input.y[index]);
        let stored: bool = append(output, x, y);
        transition stored {
            true -> endpoint(input, output, a, b, c, index, next, finish)
            false -> (false)
        }
    }
    machine endpoint(input: &Polygon, output: &mut Polygon, a: f64, b: f64, c: f64, index: u64, next: u64, finish: f64) -> bool
    requires index < 32 && next < 32
    {
        transition finish <= 0.0 {
            true -> keep(input, output, a, b, c, index, next)
            false -> edge(input, output, a, b, c, index + 1)
        }
    }
    machine keep(input: &Polygon, output: &mut Polygon, a: f64, b: f64, c: f64, index: u64, next: u64) -> bool
    requires index < 32 && next < 32
    {
        let stored: bool = append(output, input.x[next], input.y[next]);
        transition stored {
            true -> edge(input, output, a, b, c, index + 1)
            false -> (false)
        }
    }
}
public machine construct(partition: &mut Partition) {
    transition { _ -> cell(partition, 0) }
    machine cell(partition: &mut Partition, index: u64) {
        transition index < partition.site_count && index < 8 {
            true -> initialize(partition, index)
            false -> done()
        }
    }
    machine initialize(partition: &mut Partition, index: u64)
    requires index < 8
    {
        partition.cells[index] = partition.boundary;
        transition { _ -> competitor(partition, index, 0) }
    }
    machine competitor(partition: &mut Partition, index: u64, other: u64)
    requires index < 8
    {
        transition other < partition.site_count && other < 8 {
            true -> select(partition, index, other)
            false -> cell(partition, index + 1)
        }
    }
    machine select(partition: &mut Partition, index: u64, other: u64)
    requires index < 8
    {
        transition index == other {
            true -> competitor(partition, index, other + 1)
            false -> bisector(partition, index, other)
        }
    }
    machine bisector(partition: &mut Partition, index: u64, other: u64)
    requires index < 8
    {
        let a: f64 = 2.0 * (partition.site_x[other] - partition.site_x[index]);
        let b: f64 = 2.0 * (partition.site_y[other] - partition.site_y[index]);
        let c: f64 = partition.site_x[other] * partition.site_x[other] + partition.site_y[other] * partition.site_y[other]
            - partition.site_x[index] * partition.site_x[index] - partition.site_y[index] * partition.site_y[index];
        let mut output: Polygon;
        let success: bool = clip(&partition.cells[index], &mut output, a, b, c);
        partition.cells[index] = output;
        transition success {
            true -> competitor(partition, index, other + 1)
            false -> fail(partition)
        }
    }
    machine fail(partition: &mut Partition) { partition.valid = false; }
    machine done() { }
}
