use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;
public data Reader { valid: bool; value: f64; }
// A whitespace-separated signed integer, bounded to [-100,100]. This parser
// consumes one separator, accepts EOF after digits, and rejects partial tokens.
public machine read_integer(reader: @mutable Reader) reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    reader.value = 0.0;
    transition { _ -> block skip(reader) }
    machine skip(reader: @mutable Reader) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> bad(reader),
            |console|::ByteRead::Eof -> bad(reader),
            |console|::ByteRead::Byte { value } -> block start(reader, value)
        }
    }
    machine start(reader: @mutable Reader, value: i32) {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> block skip(reader),
            false -> block sign(reader, value)
        }
    }
    machine sign(reader: @mutable Reader, value: i32) {
        transition value == 45 {
            true -> block next(reader, -1.0, false),
            false -> block digit(reader, value, 1.0, false)
        }
    }
    machine next(reader: @mutable Reader, sign: f64, seen: bool) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> bad(reader),
            |console|::ByteRead::Eof -> finish(reader, sign, seen),
            |console|::ByteRead::Byte { value } -> block digit(reader, value, sign, seen)
        }
    }
    machine digit(reader: @mutable Reader, value: i32, sign: f64, seen: bool) {
        transition value >= 48 && value <= 57 {
            true -> block accumulate(reader, value, sign),
            false -> separator(reader, value, sign, seen)
        }
    }
    machine accumulate(reader: @mutable Reader, value: i32, sign: f64) {
        reader.value = reader.value * 10.0 + |float_operations|::F64::from_i32(value) - 48.0;
        transition reader.value <= 100.0 {
            true -> block next(reader, sign, true),
            false -> bad(reader)
        }
    }
    machine separator(reader: @mutable Reader, value: i32, sign: f64, seen: bool) {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> finish(reader, sign, seen),
            false -> bad(reader)
        }
    }
    machine finish(reader: @mutable Reader, sign: f64, seen: bool) {
        reader.value = reader.value * sign;
        transition seen { true -> done(), false -> bad(reader) }
    }
    machine bad(reader: @mutable Reader) { reader.valid = false; }
    machine done() { }
}
public machine end_input(reader: @mutable Reader) reaches |process_authority|::StandardInput
invokes |console|::Console
blocks
crashes Trap
{
    transition { _ -> block read(reader) }
    machine read(reader: @mutable Reader) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> bad(reader),
            |console|::ByteRead::Eof -> done(),
            |console|::ByteRead::Byte { value } -> block check(reader, value)
        }
    }
    machine check(reader: @mutable Reader, value: i32) {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> block read(reader),
            false -> bad(reader)
        }
    }
    machine bad(reader: @mutable Reader) { reader.valid = false; }
    machine done() { }
}
