use domain/model/model.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Runtime recursion is tail-only. Keep pending decimal digits in private
// fixed storage: every i64 needs at most 19 digits, including i64::MIN.
data Digits { bytes: [i32; 20]; count: u64; }
public machine integer(value: i64 in Saturating) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    let mutable output: Digits;
    transition value < 0 { true -> negative(value, @mutable output), false -> collect(value, @mutable output) }
    machine negative(value: i64 in Saturating, output: @mutable Digits) {
        |console|::Console::write("-");
        transition { _ -> collect(value, output) }
    }
    machine collect(value: i64 in Saturating, output: @mutable Digits) {
        transition output.count < 20 {
            true -> remainder(value, output, value % 10),
            false -> failed()
        }
    }
    machine remainder(value: i64 in Saturating, output: @mutable Digits, digit: i64 in Saturating)
    {
        transition digit < 0 {
            true -> store(value, output, 0 - digit),
            false -> store(value, output, digit)
        }
    }
    machine store(value: i64 in Saturating, output: @mutable Digits, digit: i64 in Saturating)
    {
        let count: u64 = output.count;
        transition count < 20 && digit >= 0 && digit <= 9 {
            true -> write_stored(value, output, digit, count),
            false -> failed()
        }
    }
    machine write_stored(value: i64 in Saturating, output: @mutable Digits, digit: i64 in Saturating, index: u64)
    requires index < 20 && digit >= 0 && digit <= 9
    {
        output.bytes[index] = (digit + 48) as i32;
        output.count = index + 1;
        transition value / 10 == 0 {
            true -> emit_digits(output, output.count),
            false -> collect(value / 10, output)
        }
    }
    machine emit_digits(output: @Digits, count: u64) {
        transition count > 0 && count <= 20 {
            true -> write_digit(output, count - 1),
            false -> done()
        }
    }
    machine write_digit(output: @Digits, index: u64)
    requires index < 20
    {
        |console|::Console::write_byte(output.bytes[index]);
        transition { _ -> emit_digits(output, index) }
    }
    machine failed() { |console|::Console::write_line("FORMAT_FAILED"); |process_exit|::ProcessExit::exit_process(70); }
    machine done() { }
}
// Emit nearest integer micro-units, with ties away from zero. All geometry
// remains f64; quantization happens only at this presentation boundary.
public machine micro(value: f64) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    transition value < 0.0 { true -> negative(value), false -> positive(value) }
    machine negative(value: f64) {
        |console|::Console::write("-");
        let rounded: i64 in Saturating = |float_operations|::I64::from_f64((0.0 - value) * 1000000.0 + 0.5);
        integer(rounded);
    }
    machine positive(value: f64) {
        let rounded: i64 in Saturating = |float_operations|::I64::from_f64(value * 1000000.0 + 0.5);
        integer(rounded);
    }
}
public machine emit(partition: @|model|::Partition) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput
invokes |console|::Console
{
    |console|::Console::write_line("SERVICE_REGIONS micro_units=1000000");
    transition { _ -> cell(partition, 0) }
    machine cell(partition: @|model|::Partition, owner: u64) {
        transition owner < partition.site_count && owner < 8 {
            true -> header(partition, owner),
            false -> finish(partition)
        }
    }
    machine header(partition: @|model|::Partition, owner: u64)
    requires owner < 8
    {
        |console|::Console::write("CELL "); integer(owner as i64 +Saturating);
        |console|::Console::write(" AREA "); micro(partition.areas[owner]); |console|::Console::write_line("");
        transition { _ -> vertex(partition, owner, 0) }
    }
    machine vertex(partition: @|model|::Partition, owner: u64, index: u64)
    requires owner < 8
    {
        transition index < partition.cells[owner].count && index < 32 {
            true -> coordinate(partition, owner, index),
            false -> adjacent(partition, owner, 0)
        }
    }
    machine coordinate(partition: @|model|::Partition, owner: u64, index: u64)
    requires owner < 8
    {
        |console|::Console::write("VERTEX "); micro(partition.cells[owner].x[index]);
        |console|::Console::write(" "); micro(partition.cells[owner].y[index]); |console|::Console::write_line("");
        transition { _ -> vertex(partition, owner, index + 1) }
    }
    machine adjacent(partition: @|model|::Partition, owner: u64, rival: u64)
    requires owner < 8
    {
        transition rival < partition.site_count && rival < 8 {
            true -> relation(partition, owner, rival),
            false -> checked(partition, owner)
        }
    }
    machine relation(partition: @|model|::Partition, owner: u64, rival: u64)
    requires owner < 8 && rival < 8
    {
        transition partition.adjacency[owner * 8 + rival] && rival != owner {
            true -> connected(partition, owner, rival),
            false -> adjacent(partition, owner, rival + 1)
        }
    }
    machine connected(partition: @|model|::Partition, owner: u64, rival: u64)
    requires owner < 8
    {
        |console|::Console::write("ADJACENT "); integer(rival as i64 +Saturating); |console|::Console::write_line("");
        transition { _ -> adjacent(partition, owner, rival + 1) }
    }
    machine checked(partition: @|model|::Partition, owner: u64)
    requires owner < 8
    {
        |console|::Console::write_line("NEAREST PASS");
        transition { _ -> cell(partition, owner + 1) }
    }
    machine finish(partition: @|model|::Partition) {
        |console|::Console::write("TOTAL_AREA "); micro(partition.total); |console|::Console::write_line("");
        |console|::Console::write_line("PARTITION PASS");
    }
}
