// Strict Pareto dominance: minimize cost/days, maximize gain. Risk is a constraint.
// Equal objective vectors never dominate each other. Certificate witnesses are the
// lowest feasible dominating identifier, independent of input order or front membership.
use domain::model;

public machine violations(row: &Experiment, budget: u64, deadline: u64, risk_limit: u64) -> u64 {
    transition row.cost > budget { true -> days(row, deadline, risk_limit, 1) false -> days(row, deadline, risk_limit, 0) }
    machine days(row: &Experiment, deadline: u64, risk_limit: u64, mask: u64) -> u64
    requires mask <= 1 {
        transition row.days > deadline { true -> risk(row, risk_limit, mask + 2) false -> risk(row, risk_limit, mask) }
    }
    machine risk(row: &Experiment, risk_limit: u64, mask: u64) -> u64
    requires mask <= 3 {
        transition row.risk > risk_limit { true -> (mask + 4) false -> mask }
    }
}
public machine dominates(left: &Experiment, right: &Experiment) -> bool {
    left.cost <= right.cost && left.days <= right.days && left.gain >= right.gain
        && (left.cost < right.cost || left.days < right.days || left.gain > right.gain)
}
public machine witness(application: &Application, candidate: &Experiment) -> u64 {
    transition { _ -> scan(application, candidate, 0, 0) }
    machine scan(application: &Application, candidate: &Experiment, index: u64, best: u64) -> u64 {
        transition index < application.count && index < 12 {
            true -> inspect(application, candidate, index, best)
            false -> best
        }
    }
    machine inspect(application: &Application, candidate: &Experiment, index: u64, best: u64) -> u64
    requires index < 12 {
        let rival: Experiment = application.rows[index];
        let mask: u64 = violations(&rival, application.budget, application.deadline, application.risk_limit);
        let better: bool = dominates(&rival, candidate);
        transition mask == 0 && better && (best == 0 || rival.identifier < best) {
            true -> scan(application, candidate, index + 1, rival.identifier)
            false -> scan(application, candidate, index + 1, best)
        }
    }
}
public machine duplicate(application: &Application, identifier: u64, limit: u64) -> bool {
    transition { _ -> scan(application, identifier, limit, 0) }
    machine scan(application: &Application, identifier: u64, limit: u64, index: u64) -> bool {
        transition index < limit && index < 12 {
            true -> compare(application, identifier, limit, index)
            false -> false
        }
    }
    machine compare(application: &Application, identifier: u64, limit: u64, index: u64) -> bool
    requires index < 12 {
        transition application.rows[index].identifier == identifier {
            true -> true
            false -> scan(application, identifier, limit, index + 1)
        }
    }
}
