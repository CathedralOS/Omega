use clock::model;

// Each edge admits deltas congruent to the raw difference modulo M. The least
// admissible delta plus M tests uniqueness, including identical residues and
// intervals spanning several wraps. Never infer order from raw magnitude.
machine reconstruct(acquisition: &mut Acquisition) {
    transition acquisition.used >= 11 {
        true -> header(acquisition)
        false -> fail(acquisition, 1)
    }
    machine header(acquisition: &mut Acquisition) {
        acquisition.count = acquisition.tokens[0];
        acquisition.modulus = acquisition.tokens[1];
        acquisition.lower = acquisition.tokens[2];
        acquisition.upper = acquisition.tokens[3];
        acquisition.anchor = acquisition.tokens[4];
        transition acquisition.count >= 2 && acquisition.count <= 16 &&
            acquisition.modulus >= 2 && acquisition.modulus <= 65536 &&
            acquisition.lower >= 1 && acquisition.lower <= acquisition.upper &&
            acquisition.upper <= 100000 {
            true -> length(acquisition)
            false -> fail(acquisition, 2)
        }
    }
    machine length(acquisition: &mut Acquisition) {
        transition acquisition.used == 5 + 3 * acquisition.count {
            true -> rows(acquisition, 0)
            false -> fail(acquisition, 1)
        }
    }
    machine rows(acquisition: &mut Acquisition, index: i64 in Wrapping) {
        transition index < acquisition.count && index >= 0 && index < 16 {
            true -> load(acquisition, index)
            false -> anchor(acquisition)
        }
    }
    machine load(acquisition: &mut Acquisition, index: i64 in Wrapping) {
        let position: i64 in Wrapping = 5 + 3 * index;
        acquisition.sequence[index] = acquisition.tokens[position];
        acquisition.raw[index] = acquisition.tokens[position + 1];
        acquisition.host[index] = acquisition.tokens[position + 2];
        transition acquisition.raw[index] < acquisition.modulus &&
            acquisition.sequence[index] <= 100000 && acquisition.host[index] <= 100000 {
            true -> rows(acquisition, index + 1)
            false -> fail(acquisition, 3)
        }
    }
    machine anchor(acquisition: &mut Acquisition) {
        transition acquisition.modulus >= 2 {
            true -> anchored_residue(acquisition)
            false -> fail(acquisition, 2)
        }
    }
    machine anchored_residue(acquisition: &mut Acquisition)
    requires acquisition.modulus >= 2
    {
        transition acquisition.anchor % acquisition.modulus == acquisition.raw[0] {
            true -> initialize(acquisition)
            false -> fail(acquisition, 4)
        }
    }
    machine initialize(acquisition: &mut Acquisition) {
        acquisition.elapsed[0] = 0;
        acquisition.timestamps[0] = acquisition.anchor;
        acquisition.wraps = 0;
        acquisition.dropped = 0;
        transition { _ -> edge(acquisition, 1) }
    }
    machine edge(acquisition: &mut Acquisition, index: i64 in Wrapping) {
        transition index >= 1 && index < 16 && index < acquisition.count {
            true -> order(acquisition, index)
            false -> done()
        }
    }
    machine order(acquisition: &mut Acquisition, index: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition acquisition.sequence[index] > acquisition.sequence[index - 1] {
            true -> host_order(acquisition, index)
            false -> fail(acquisition, 5)
        }
    }
    machine host_order(acquisition: &mut Acquisition, index: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition acquisition.host[index] > acquisition.host[index - 1] {
            true -> residue(acquisition, index)
            false -> fail(acquisition, 6)
        }
    }
    machine residue(acquisition: &mut Acquisition, index: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition acquisition.modulus >= 2 {
            true -> difference(acquisition, index)
            false -> fail(acquisition, 2)
        }
    }
    machine difference(acquisition: &mut Acquisition, index: i64 in Wrapping)
    requires index >= 1 && index < 16
    requires acquisition.modulus >= 2
    {
        let delta: i64 in Wrapping = (acquisition.raw[index] - acquisition.raw[index - 1] + acquisition.modulus) % acquisition.modulus;
        transition delta < acquisition.lower {
            true -> raise(acquisition, index, delta)
            false -> candidate(acquisition, index, delta)
        }
    }
    machine raise(acquisition: &mut Acquisition, index: i64 in Wrapping, delta: i64 in Wrapping)
    requires index >= 1 && index < 16
    requires acquisition.modulus >= 2
    {
        let turns: i64 in Wrapping = (acquisition.lower - delta + acquisition.modulus - 1) / acquisition.modulus;
        let proposed: i64 in Wrapping = delta + turns * acquisition.modulus;
        transition { _ -> candidate(acquisition, index, proposed) }
    }
    machine candidate(acquisition: &mut Acquisition, index: i64 in Wrapping, delta: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition delta <= acquisition.upper {
            true -> unique(acquisition, index, delta)
            false -> fail(acquisition, 7)
        }
    }
    machine unique(acquisition: &mut Acquisition, index: i64 in Wrapping, delta: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition delta + acquisition.modulus > acquisition.upper {
            true -> span(acquisition, index, delta)
            false -> fail(acquisition, 8)
        }
    }
    machine span(acquisition: &mut Acquisition, index: i64 in Wrapping, delta: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        let elapsed: i64 in Wrapping = acquisition.elapsed[index - 1] + delta;
        transition elapsed <= 100000 {
            true -> overflow(acquisition, index, delta, elapsed)
            false -> fail(acquisition, 9)
        }
    }
    machine overflow(acquisition: &mut Acquisition, index: i64 in Wrapping, delta: i64 in Wrapping, elapsed: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition acquisition.anchor <= 9223372036854775807 - elapsed {
            true -> accept(acquisition, index, delta, elapsed)
            false -> fail(acquisition, 10)
        }
    }
    machine accept(acquisition: &mut Acquisition, index: i64 in Wrapping, delta: i64 in Wrapping, elapsed: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition acquisition.modulus >= 2 {
            true -> store(acquisition, index, delta, elapsed)
            false -> fail(acquisition, 2)
        }
    }
    machine store(acquisition: &mut Acquisition, index: i64 in Wrapping, delta: i64 in Wrapping, elapsed: i64 in Wrapping)
    requires index >= 1 && index < 16
    requires acquisition.modulus >= 2
    {
        // Preserve the divisor fact before mutating other storage projections.
        let crossings: i64 in Wrapping = (acquisition.raw[index - 1] + delta) / acquisition.modulus;
        acquisition.elapsed[index] = elapsed;
        acquisition.timestamps[index] = acquisition.anchor + elapsed;
        acquisition.wraps = acquisition.wraps + crossings;
        acquisition.dropped = acquisition.dropped + acquisition.sequence[index] - acquisition.sequence[index - 1] - 1;
        transition { _ -> edge(acquisition, index + 1) }
    }
    machine fail(acquisition: &mut Acquisition, code: i64 in Wrapping) { acquisition.error = code; }
    machine done() { }
}
