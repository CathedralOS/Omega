use clock::model;

// Anchor-constrained least squares: host = host[0] + elapsed * numerator / denominator.
// At most 16 rows, elapsed and host <=100000: sums <=1.6e11, scaled drift
// <=1.6e17 and residual products <=3.2e16, all strictly below i64::MAX.
machine fit_clock(acquisition: &mut Acquisition) {
    acquisition.numerator = 0;
    acquisition.denominator = 0;
    acquisition.residual = 0;
    transition { _ -> accumulate(acquisition, 1) }
    machine accumulate(acquisition: &mut Acquisition, index: i64 in Wrapping) {
        transition index >= 1 && index < 16 && index < acquisition.count {
            true -> add(acquisition, index)
            false -> residual(acquisition, 1)
        }
    }
    machine add(acquisition: &mut Acquisition, index: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        let ticks: i64 in Wrapping = acquisition.elapsed[index];
        let host: i64 in Wrapping = acquisition.host[index] - acquisition.host[0];
        acquisition.numerator = acquisition.numerator + ticks * host;
        acquisition.denominator = acquisition.denominator + ticks * ticks;
        transition { _ -> accumulate(acquisition, index + 1) }
    }
    machine residual(acquisition: &mut Acquisition, index: i64 in Wrapping) {
        transition index >= 1 && index < 16 && index < acquisition.count {
            true -> measure(acquisition, index)
            false -> done()
        }
    }
    machine measure(acquisition: &mut Acquisition, index: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        let scaled: i64 in Wrapping = (acquisition.host[index] - acquisition.host[0]) * acquisition.denominator - acquisition.elapsed[index] * acquisition.numerator;
        transition scaled < 0 {
            true -> maximum(acquisition, index, 0 - scaled)
            false -> maximum(acquisition, index, scaled)
        }
    }
    machine maximum(acquisition: &mut Acquisition, index: i64 in Wrapping, scaled: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        transition scaled > acquisition.residual {
            true -> update(acquisition, index, scaled)
            false -> residual(acquisition, index + 1)
        }
    }
    machine update(acquisition: &mut Acquisition, index: i64 in Wrapping, scaled: i64 in Wrapping)
    requires index >= 1 && index < 16
    {
        acquisition.residual = scaled;
        transition { _ -> residual(acquisition, index + 1) }
    }
    machine done() { }
}
