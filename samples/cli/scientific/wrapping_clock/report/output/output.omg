use clock/model/model.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

// Runtime recursive call cycles must be tail-position calls. Decimal suffix
// work therefore lives in explicit bounded scratch, not recursive activations.
// At most 19 digits cover every accepted nonnegative i64 magnitude. Byte output
// avoids inventing a Utf8 proof for a mutable text carrier.
public machine number(value: i64 in Wrapping) reaches |process_authority|::StandardOutput
crashes Trap
{
    let mutable digits: [i32 in Wrapping; 19];
    transition value < 0 {
        true -> negative(@mutable digits, value),
        false -> fill(@mutable digits, 0, value)
    }
    machine negative(digits: @mutable [i32 in Wrapping; 19], value: i64 in Wrapping) {
        |console|::Console::write_byte(45);
        transition { _ -> fill(digits, 0, 0 - value) }
    }
    machine fill(digits: @mutable [i32 in Wrapping; 19], count: i64 in Wrapping, value: i64 in Wrapping) {
        transition count >= 0 && count < 19 {
            true -> append(digits, count, value),
            false -> invalid()
        }
    }
    machine append(digits: @mutable [i32 in Wrapping; 19], count: i64 in Wrapping, value: i64 in Wrapping)
    requires count >= 0 && count < 19
    {
        let digit: i64 in Wrapping = value % 10 + 48;
        digits[count] = |numeric_conversion|::narrow_i64_to_i32_trapping(digit as i64) as i32 +Wrapping;
        transition value >= 10 {
            true -> fill(digits, count + 1, value / 10),
            false -> drain(digits, count + 1)
        }
    }
    machine drain(digits: @[i32 in Wrapping; 19], count: i64 in Wrapping) {
        transition count > 0 && count <= 19 {
            true -> emit(digits, count - 1),
            false -> done()
        }
    }
    machine emit(digits: @[i32 in Wrapping; 19], index: i64 in Wrapping)
    requires index >= 0 && index < 19
    {
        |console|::Console::write_byte(digits[index] as i32);
        transition { _ -> drain(digits, index) }
    }
    machine done() { }
    machine invalid() { crash Trap; }
}

public machine report(acquisition: @|model|::Acquisition) reaches |process_authority|::StandardOutput
crashes Trap
{
    transition { _ -> row(acquisition, 0) }
    machine row(acquisition: @|model|::Acquisition, index: i64 in Wrapping) {
        transition index >= 0 && index < 16 && index < acquisition.count {
            true -> emit(acquisition, index),
            false -> summary(acquisition)
        }
    }
    machine emit(acquisition: @|model|::Acquisition, index: i64 in Wrapping)
    requires index >= 0 && index < 16
    {
        |console|::Console::write("row "); number(acquisition.sequence[index]);
        |console|::Console::write(" raw "); number(acquisition.raw[index]);
        |console|::Console::write(" timestamp "); number(acquisition.timestamps[index]);
        |console|::Console::write(" elapsed "); number(acquisition.elapsed[index]);
        |console|::Console::write(" host "); number(acquisition.host[index]);
        |console|::Console::write_line("");
        transition { _ -> row(acquisition, index + 1) }
    }
    machine summary(acquisition: @|model|::Acquisition) {
        |console|::Console::write("wraps "); number(acquisition.wraps);
        |console|::Console::write(" dropped "); number(acquisition.dropped);
        |console|::Console::write_line("");
        |console|::Console::write("rate "); number(acquisition.numerator);
        |console|::Console::write("/"); number(acquisition.denominator);
        |console|::Console::write_line(" host_units/tick");
        |console|::Console::write("drift "); number((acquisition.numerator - acquisition.denominator) * 1000000);
        |console|::Console::write("/"); number(acquisition.denominator);
        |console|::Console::write_line(" ppm_vs_one");
        |console|::Console::write("max_residual "); number(acquisition.residual);
        |console|::Console::write("/"); number(acquisition.denominator);
        |console|::Console::write_line(" host_units");
    }
}
