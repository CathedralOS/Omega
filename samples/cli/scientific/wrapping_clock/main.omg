use clock/fit/fit.omg;
use clock/model/model.omg;
use clock/reconstruct/reconstruct.omg;
use input/reader/reader.omg;
use report/output/output.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// IND17: independent acquisition counter reconstruction and clock fitting.

machine main() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable acquisition: |model|::Acquisition;
    block |reader|::read_acquisition(@mutable acquisition);
    transition acquisition.error == 0 { true -> decode(@mutable acquisition), false -> reject(@acquisition) }
    machine decode(acquisition: @mutable |model|::Acquisition) {
        |reconstruct|::reconstruct(acquisition);
        transition acquisition.error == 0 { true -> fitted(acquisition), false -> reject(acquisition) }
    }
    machine fitted(acquisition: @mutable |model|::Acquisition) {
        |fit|::fit_clock(acquisition);
        |output|::report(acquisition);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine reject(acquisition: @|model|::Acquisition) {
        |console|::Console::write("ERROR "); |output|::number(acquisition.error); |console|::Console::write_line("");
        |process_exit|::ProcessExit::exit_process(2);
    }
}
