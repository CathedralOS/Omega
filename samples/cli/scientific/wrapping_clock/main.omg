// IND17: independent acquisition counter reconstruction and clock fitting.
use omega_language_std::console;
use clock::model;
use clock::reconstruct;
use clock::fit;
use input::reader;
use report::output;

machine main() reaches Console {
    let mut acquisition: Acquisition;
    block read_acquisition(&mut acquisition);
    transition acquisition.error == 0 { true -> decode(&mut acquisition) false -> reject(&acquisition) }
    machine decode(acquisition: &mut Acquisition) {
        reconstruct(acquisition);
        transition acquisition.error == 0 { true -> fitted(acquisition) false -> reject(acquisition) }
    }
    machine fitted(acquisition: &mut Acquisition) {
        fit_clock(acquisition);
        report(acquisition);
        Console::exit_process(0);
    }
    machine reject(acquisition: &Acquisition) {
        Console::write("ERROR "); number(acquisition.error); Console::write_line("");
        Console::exit_process(2);
    }
}
