use omega\language\core\ProcessExit;
// Expected: reject source coordinate access without an index bound.
machine coordinate(source: @[f64; 48], index: u64) -> f64 {
    source[index]
}
data Main { }
machine main(main: @mutable Main) reaches ProcessExit {
    let source: [f64; 48];
    let observed: f64 = coordinate(@source, 48);
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
