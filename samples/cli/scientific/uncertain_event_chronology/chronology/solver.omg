use chronology::model;
// Immutable candidate storage keeps the three clock coordinates together.
data Candidate { ticks: [i32; 3]; }
// Exact finite-domain search, independent of the host-side product oracle.
// Candidate numbers encode A,B,C in decimal; every assignment is visited once.
public machine reconcile(model: &Chronology, result: &mut Reconciliation) {
    result.count = 0;
    result.lower = [9,9,9];
    result.upper = [0,0,0];
    transition { _ -> candidate(model, result, 0) }
    machine candidate(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping) {
        transition code < 1000 {
            true -> decode(model, result, code)
            false -> done()
        }
    }
    machine decode(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping) {
        let times: Candidate = Candidate { ticks: [(code / 100) as i32, (code / 10 % 10) as i32, (code % 10) as i32] };
        transition { _ -> interval(model, result, code, &times, 0) }
    }
    machine interval(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                   times: &Candidate, event: i32 in Wrapping) {
        transition event >= 0 && event < 3 {
            true -> inspect_interval(model, result, code, times, event)
            false -> edge(model, result, code, times, 0)
        }
    }
    machine inspect_interval(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                           times: &Candidate, event: i32 in Wrapping)
    requires event >= 0
    requires event < 3
    {
        let time: i32 = times.ticks[event];
        transition time >= model.lower[event] && time <= model.upper[event] {
            true -> interval(model, result, code, times, event + 1)
            false -> candidate(model, result, code + 1)
        }
    }
    machine edge(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
               times: &Candidate, index: i32 in Wrapping) {
        transition index >= 0 && index < 4 {
            true -> active(model, result, code, times, index)
            false -> accept(model, result, code, times)
        }
    }
    machine active(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                 times: &Candidate, index: i32 in Wrapping)
    requires index >= 0
    requires index < 4
    {
        transition model.enabled[index] == 1 {
            true -> endpoints(model, result, code, times, index)
            false -> edge(model, result, code, times, index + 1)
        }
    }
    machine endpoints(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                    times: &Candidate, index: i32 in Wrapping)
    requires index >= 0
    requires index < 4
    {
        let source: i32 in Wrapping = model.source[index] as i32 in Wrapping;
        let destination: i32 in Wrapping = model.destination[index] as i32 in Wrapping;
        transition source >= 0 && source < 3 && destination >= 0 && destination < 3 {
            true -> constraint(model, result, code, times, index, source, destination)
            false -> done()
        }
    }
    machine constraint(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                     times: &Candidate, index: i32 in Wrapping,
                     source: i32 in Wrapping, destination: i32 in Wrapping)
    requires index >= 0
    requires index < 4
    requires source >= 0
    requires source < 3
    requires destination >= 0
    requires destination < 3
    {
        let start: i32 in Wrapping = times.ticks[source] as i32 in Wrapping;
        let finish: i32 in Wrapping = times.ticks[destination] as i32 in Wrapping;
        let lag: i32 in Wrapping = model.lag[index] as i32 in Wrapping;
        transition finish >= start + lag {
            true -> edge(model, result, code, times, index + 1)
            false -> candidate(model, result, code + 1)
        }
    }
    machine accept(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                 times: &Candidate) {
        result.count = result.count + 1;
        transition { _ -> range(model, result, code, times, 0) }
    }
    machine range(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                times: &Candidate, event: i32 in Wrapping) {
        transition event >= 0 && event < 3 {
            true -> lower(model, result, code, times, event)
            false -> candidate(model, result, code + 1)
        }
    }
    machine lower(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                times: &Candidate, event: i32 in Wrapping)
    requires event >= 0
    requires event < 3
    {
        transition times.ticks[event] < result.lower[event] {
            true -> store_lower(model, result, code, times, event)
            false -> upper(model, result, code, times, event)
        }
    }
    machine store_lower(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                      times: &Candidate, event: i32 in Wrapping)
    requires event >= 0
    requires event < 3
    {
        result.lower[event] = times.ticks[event];
        transition { _ -> upper(model, result, code, times, event) }
    }
    machine upper(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                times: &Candidate, event: i32 in Wrapping)
    requires event >= 0
    requires event < 3
    {
        transition times.ticks[event] > result.upper[event] {
            true -> store_upper(model, result, code, times, event)
            false -> range(model, result, code, times, event + 1)
        }
    }
    machine store_upper(model: &Chronology, result: &mut Reconciliation, code: i32 in Wrapping,
                      times: &Candidate, event: i32 in Wrapping)
    requires event >= 0
    requires event < 3
    {
        result.upper[event] = times.ticks[event];
        transition { _ -> range(model, result, code, times, event + 1) }
    }
    machine done() { }
}

// Deletion is monotone: if removing an edge admits a solution now, removing
// more edges cannot make that edge redundant later. One pass is irreducible.
public machine contradiction(model: &mut Chronology, result: &mut Reconciliation) {
    transition { _ -> edge(model, result, 0) }
    machine edge(model: &mut Chronology, result: &mut Reconciliation, index: i32 in Wrapping) {
        transition index >= 0 && index < 4 {
            true -> active(model, result, index)
            false -> finish(model, result)
        }
    }
    machine active(model: &mut Chronology, result: &mut Reconciliation, index: i32 in Wrapping)
    requires index >= 0
    requires index < 4
    {
        transition model.enabled[index] == 1 {
            true -> remove(model, result, index)
            false -> edge(model, result, index + 1)
        }
    }
    machine remove(model: &mut Chronology, result: &mut Reconciliation, index: i32 in Wrapping)
    requires index >= 0
    requires index < 4
    {
        model.enabled[index] = 0;
        reconcile(model, result);
        transition result.count == 0 {
            true -> edge(model, result, index + 1)
            false -> restore(model, result, index)
        }
    }
    machine restore(model: &mut Chronology, result: &mut Reconciliation, index: i32 in Wrapping)
    requires index >= 0
    requires index < 4
    {
        model.enabled[index] = 1;
        transition { _ -> edge(model, result, index + 1) }
    }
    machine finish(model: &mut Chronology, result: &mut Reconciliation) { reconcile(model, result); }
}
