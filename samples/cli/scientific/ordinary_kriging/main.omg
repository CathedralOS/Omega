use io/input/input.omg;
use io/output/output.omg;
use model/kriging/kriging.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 64.
// Expected output contains: error invalid input
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable raw: |input|::Raw;
    let accepted: bool = block |input|::read(@mutable raw);
    transition accepted { true -> validate(@raw), false -> invalid() }
    machine validate(raw: @|input|::Raw) {
        let mutable problem: |kriging|::Problem;
        transition |input|::decode(raw, @mutable problem) { true -> calculate(@mutable problem), false -> invalid() }
    }
    machine calculate(problem: @mutable |kriging|::Problem) {
        transition |kriging|::solve(problem) { true -> report(problem), false -> singular() }
    }
    machine report(problem: @|kriging|::Problem) { |output|::emit(problem); |process_exit|::ProcessExit::exit_process(0); }
    machine singular() { |console|::Console::write_line("status singular-system"); |process_exit|::ProcessExit::exit_process(2); }
    machine invalid() { |console|::Console::write_line("error invalid input"); |process_exit|::ProcessExit::exit_process(64); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
