use omega\language\core\StandardInput;
use system\ByteRead;
use system\Console;

// The parser bounds bytes, tokens and magnitudes before arithmetic/storage.
public data Input {
    values: [u64; 19] in Wrapping;
    count: u64;
    bytes: u64;
    number: u64 in Wrapping;
    active: bool;
    valid: bool;
    index: u64;
}

public machine read(input: @mutable Input) reaches StandardInput {
    input.count = 0;
    input.bytes = 0;
    input.number = 0;
    input.active = false;
    input.valid = true;
    transition { _ -> scan(input) }
    machine scan(input: @mutable Input) {
        transition input.bytes <= 256 {
            true -> receive(input),
            false -> invalid(input)
        }
    }
    machine receive(input: @mutable Input) {
        transition block Console::read_byte() {
            ByteRead::Error -> invalid(input),
            ByteRead::Eof -> finish(input),
            ByteRead::Byte { value } -> classify(input, value)
        }
    }
    machine classify(input: @mutable Input, value: i32) {
        transition input.bytes < 256 {
            true -> byte(input, value),
            false -> invalid(input)
        }
    }
    machine byte(input: @mutable Input, value: i32) {
        input.bytes = input.bytes + 1;
        transition {
            value >= 48 && value <= 57 -> digit(input, value),
            value == 32 || value == 9 || value == 10 || value == 13 -> separator(input),
            _ -> invalid(input)
        }
    }
    machine digit(input: @mutable Input, value: i32) {
        input.number = input.number * 10 + ((value - 48) as u64 +Wrapping);
        input.active = true;
        transition input.number <= 1000 {
            true -> scan(input),
            false -> invalid(input)
        }
    }
    machine separator(input: @mutable Input) {
        flush(input);
        transition input.valid { true -> scan(input), false -> done() }
    }
    machine finish(input: @mutable Input) { flush(input); }
    machine invalid(input: @mutable Input) { input.valid = false; }
    machine done() {}
}

machine flush(input: @mutable Input) {
    transition input.active && input.count < 19 {
        true -> store(input),
        false -> other(input)
    }
    machine store(input: @mutable Input) {
        input.values[input.count] = input.number;
        input.count = input.count + 1;
        input.number = 0;
        input.active = false;
    }
    machine other(input: @mutable Input) {
        transition input.active { true -> invalid(input), false -> done() }
    }
    machine invalid(input: @mutable Input) { input.valid = false; }
    machine done() {}
}

public machine validate(input: @mutable Input) {
    transition input.valid && input.count >= 5 && input.count <= 19 {
        true -> curve(input),
        false -> invalid(input)
    }
    machine curve(input: @mutable Input) {
        transition (input.values[0] == 1 || input.values[0] == 2) && input.values[1] >= 1 && input.values[1] <= 1000 && input.values[2] >= 2 && input.values[2] <= 16 && input.values[2] == input.count - 3 {
            true -> start(input),
            false -> invalid(input)
        }
    }
    machine start(input: @mutable Input) {
        input.index = 3;
        transition { _ -> loop(input) }
    }
    machine loop(input: @mutable Input) {
        transition input.index < input.count && input.index < 19 {
            true -> load(input),
            false -> done()
        }
    }
    machine load(input: @mutable Input) {
        transition input.values[input.index] <= 9 { true -> next(input), false -> invalid(input) }
    }
    machine next(input: @mutable Input) {
        input.index = input.index + 1;
        transition { _ -> loop(input) }
    }
    machine invalid(input: @mutable Input) { input.valid = false; }
    machine done() {}
}
