use chemistry/balance/balance.omg;
use chemistry/inventory/inventory.omg;
use chemistry/model/model.omg;
use chemistry/report/report.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Entire input, solve, batch and report workflow runs in Omega.
// The generic sample harness closes stdin; this is the empty-input control.
// Expected exit: 64.
// Expected output contains: INVALID_INPUT

data Main { signature: |model|::Signature; }
data Input {
    values: [i64 in Wrapping; 19];
    count: u64;
    status: i32;
}

machine main(context: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let produced: |model|::Signature = |balance|::signature_of(3, 2, 1, 2, 1);
    let local_fourth: i64 in Wrapping = produced.fourth;
    transition { _ -> block hold(context, produced, local_fourth) }
    machine hold(context: @mutable Main, parameter: |model|::Signature, local_fourth: i64 in Wrapping) {
        transition parameter.active == 3 && parameter.fourth == 0 && local_fourth == 0 {
            true -> block store(context, parameter),
            false -> signature_mismatch(context)
        }
    }
    machine store(context: @mutable Main, parameter: |model|::Signature) {
        context.signature = parameter;
        let called: |model|::Signature = |balance|::signature_of(4, 1, 1, 1, 1);
        transition context.signature.active == 3 && context.signature.fourth == 0 && called.active == 4 && called.fourth == 1 {
            true -> block rows(context),
            false -> signature_mismatch(context)
        }
    }
    machine rows(context: @mutable Main) {
        let first: [i64 in Wrapping; 4] = [2, 0, 1, 0];
        let second: [i64 in Wrapping; 4] = [0, 1, 0, 0];
        let third: [i64 in Wrapping; 4] = [0, 0, 0, 1];
        let selected: @[i64 in Wrapping; 4] = |balance|::axis(@first, @second, @third, 0);
        let held: |model|::Held = |model|::Held { row: selected };
        let via_parameter: i64 in Wrapping = |balance|::read_axis(selected);
        let via_call: @[i64 in Wrapping; 4] = |balance|::axis(@first, @second, @third, 2);
        transition selected[0] == 2 && held.row[0] == 2 && via_parameter == 2 && via_call[3] == 1 {
            true -> block windows(context),
            false -> signature_mismatch(context)
        }
    }
    machine windows(context: @mutable Main) {
        let mutable coefficients: [i64 in Wrapping; 4] = [0, 0, 0, 0];
        let reactants_mut: @mutable [i64 in Wrapping] = |balance|::mutable_reactant_window(@mutable coefficients, 0);
        |balance|::write_reactants(reactants_mut);
        let reactants: @[i64 in Wrapping] = |balance|::reactant_window(@coefficients, 0);
        let held: |model|::HeldWindow = |model|::HeldWindow { values: reactants };
        let via_parameter: i64 in Wrapping = |balance|::read_window(held.values);
        let via_call: @[i64 in Wrapping] = |balance|::reactant_window(@coefficients, 1);
        transition reactants.length == 2 && reactants[0] == 2 && reactants[1] == 1 && held.values.length == 2 && via_parameter == 2 && via_call.length == 2 {
            true -> block consume(context),
            false -> signature_mismatch(context)
        }
    }
    machine consume(context: @mutable Main) {
        let mutable input: Input;
        block read(context, @mutable input);
        transition input.status == 0 && input.count == 19 {
            true -> declare(context, @input),
            false -> invalid(context)
        }
    }
    machine declare(context: @mutable Main, input: @Input) {
        let mutable reaction: |model|::Reaction;
        reaction.species = input.values[0];
        reaction.bound = input.values[1];
        reaction.first[0] = input.values[2];
        reaction.first[1] = input.values[5];
        reaction.first[2] = input.values[8];
        reaction.first[3] = input.values[11];
        reaction.second[0] = input.values[3];
        reaction.second[1] = input.values[6];
        reaction.second[2] = input.values[9];
        reaction.second[3] = input.values[12];
        reaction.third[0] = input.values[4];
        reaction.third[1] = input.values[7];
        reaction.third[2] = input.values[10];
        reaction.third[3] = input.values[13];
        reaction.stock[0] = input.values[14];
        reaction.stock[1] = input.values[15];
        reaction.stock[2] = input.values[16];
        reaction.stock[3] = input.values[17];
        reaction.cap = input.values[18];
        transition (reaction.species == 3 || reaction.species == 4) && reaction.bound >= 1 && reaction.bound <= 8 {
            true -> atoms(context, @reaction, input, 2),
            false -> invalid(context)
        }
    }
    machine atoms(context: @mutable Main, reaction: @|model|::Reaction, input: @Input, index: u64) {
        transition index < 14 {
            true -> atom(context, reaction, input, index),
            false -> nonempty(context, reaction)
        }
    }
    machine atom(context: @mutable Main, reaction: @|model|::Reaction, input: @Input, index: u64)
    requires index < 14 {
        transition input.values[index] <= 16 {
            true -> atoms(context, reaction, input, index + 1),
            false -> invalid(context)
        }
    }
    machine nonempty(context: @mutable Main, reaction: @|model|::Reaction) {
        let first: i64 in Wrapping = reaction.first[0] + reaction.second[0] + reaction.third[0];
        let second: i64 in Wrapping = reaction.first[1] + reaction.second[1] + reaction.third[1];
        let third: i64 in Wrapping = reaction.first[2] + reaction.second[2] + reaction.third[2];
        let fourth: i64 in Wrapping = reaction.first[3] + reaction.second[3] + reaction.third[3];
        transition first > 0 && second > 0 && third > 0 {
            true -> fourth_species(context, reaction, fourth),
            false -> invalid(context)
        }
    }
    machine fourth_species(context: @mutable Main, reaction: @|model|::Reaction, fourth: i64 in Wrapping) {
        transition (reaction.species == 4 && fourth > 0) || (reaction.species == 3 && fourth == 0 && reaction.stock[3] == 0) {
            true -> balance(context, reaction),
            false -> invalid(context)
        }
    }
    machine balance(context: @mutable Main, reaction: @|model|::Reaction) {
        let mutable result: |model|::Balance;
        |balance|::solve(reaction, @mutable result);
        transition result.solutions > 0 && result.coefficients[0] > 0 && result.coefficients[1] > 0 {
            true -> batch(context, reaction, @result),
            false -> impossible(context)
        }
    }
    machine batch(context: @mutable Main, reaction: @|model|::Reaction, balance: @|model|::Balance)
    requires balance.coefficients[0] > 0 && balance.coefficients[1] > 0 {
        let mutable result: |model|::Batch;
        |inventory|::process(reaction, balance, @mutable result);
        transition result.overflow {
            true -> overflow(context, @result),
            false -> verify(context, reaction, balance, @result)
        }
    }
    machine verify(context: @mutable Main, reaction: @|model|::Reaction, balance: @|model|::Balance, batch: @|model|::Batch) {
        let before_first: i64 in Wrapping = |model|::element_total(@reaction.first, @reaction.stock);
        let before_second: i64 in Wrapping = |model|::element_total(@reaction.second, @reaction.stock);
        let before_third: i64 in Wrapping = |model|::element_total(@reaction.third, @reaction.stock);
        let after_first: i64 in Wrapping = |model|::element_total(@reaction.first, @batch.inventory);
        let after_second: i64 in Wrapping = |model|::element_total(@reaction.second, @batch.inventory);
        let after_third: i64 in Wrapping = |model|::element_total(@reaction.third, @batch.inventory);
        transition before_first == after_first && before_second == after_second && before_third == after_third {
            true -> report(context, balance, batch, before_first, before_second, before_third),
            false -> corrupt(context)
        }
    }
    machine report(context: @mutable Main, balance: @|model|::Balance, batch: @|model|::Batch, first: i64 in Wrapping, second: i64 in Wrapping, third: i64 in Wrapping) {
        |console|::Console::write_line("BALANCED");
        |console|::Console::write("coefficients ");
        |report|::line_four(@balance.coefficients);
        |console|::Console::write("primitive_solutions ");
        |report|::line_number(balance.solutions);
        |console|::Console::write("extent ");
        |report|::line_number(batch.extent);
        |console|::Console::write("limiting_mask ");
        |report|::line_number(batch.limiting);
        |console|::Console::write("cap_limited ");
        |report|::line_number(batch.cap_limited);
        |console|::Console::write("inventory ");
        |report|::line_four(@batch.inventory);
        |console|::Console::write("elements ");
        |report|::number(first);
        |console|::Console::write(" ");
        |report|::number(second);
        |console|::Console::write(" ");
        |report|::line_number(third);
        |console|::Console::write_line("CONSERVATION_OK");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine signature_mismatch(context: @mutable Main) {
        |console|::Console::write_line("SIGNATURE_MISMATCH");
        |process_exit|::ProcessExit::exit_process(71);
    }
    machine invalid(context: @mutable Main) {
        |console|::Console::write_line("INVALID_INPUT");
        |process_exit|::ProcessExit::exit_process(64);
    }
    machine impossible(context: @mutable Main) {
        |console|::Console::write_line("NO_BALANCE_WITHIN_BOUND");
        |process_exit|::ProcessExit::exit_process(65);
    }
    machine overflow(context: @mutable Main, result: @|model|::Batch) {
        |console|::Console::write_line("OVERFLOW_REFUSED");
        |console|::Console::write("inventory ");
        |report|::line_four(@result.inventory);
        |process_exit|::ProcessExit::exit_process(66);
    }
    machine corrupt(context: @mutable Main) {
        |console|::Console::write_line("CONSERVATION_FAILURE");
        |process_exit|::ProcessExit::exit_process(70);
    }
}


// ASCII decimal fields, whitespace separated, finite input <=1024 bytes.
// Refuse malformed, oversized and extra fields before exposing any reaction.
// Accumulation multiplies only values <=INT32_MAX, hence fits comfortably in i64.
machine read(context: @mutable Main, input: @mutable Input) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput {
    input.count = 0;
    input.status = 0;
    transition { _ -> block scan(context, input, 0, false, 0) }
    machine scan(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping) {
        let observed: |console|::ByteRead = block |console|::Console::read_byte();
        transition observed {
            |console|::ByteRead::Error -> invalid(input),
            |console|::ByteRead::Eof -> end(context, input, value, digits),
            |console|::ByteRead::Byte { value as byte } -> block byte_value(context, input, value, digits, consumed, byte)
        }
    }
    machine byte_value(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping, byte: i32) {
        transition consumed < 1024 {
            true -> block classify(context, input, value, digits, consumed + 1, byte),
            false -> invalid(input)
        }
    }
    machine classify(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping, byte: i32) {
        transition byte >= 48 && byte <= 57 {
            true -> block digit(context, input, value, consumed, byte),
            false -> block separator(context, input, value, digits, consumed, byte)
        }
    }
    machine digit(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, consumed: i64 in Wrapping, byte: i32) {
        let wide: i64 in Wrapping = |numeric_conversion|::widen_i32_to_i64(byte) as i64 +Wrapping;
        let next: i64 in Wrapping = value * 10 + wide - 48;
        transition next <= 2147483647 {
            true -> block scan(context, input, next, true, consumed),
            false -> invalid(input)
        }
    }
    machine separator(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping, byte: i32) {
        transition byte == 9 || byte == 10 || byte == 13 || byte == 32 {
            true -> block whitespace(context, input, value, digits, consumed),
            false -> invalid(input)
        }
    }
    machine whitespace(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping) {
        transition digits {
            true -> block commit(context, input, value, consumed),
            false -> block scan(context, input, 0, false, consumed)
        }
    }
    machine commit(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, consumed: i64 in Wrapping) {
        let index: u64 = input.count;
        transition index < 19 {
            true -> block store(context, input, value, consumed, index),
            false -> invalid(input)
        }
    }
    machine store(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, consumed: i64 in Wrapping, index: u64)
    requires index < 19 {
        input.values[index] = value;
        input.count = index + 1;
        transition { _ -> block scan(context, input, 0, false, consumed) }
    }
    machine end(context: @mutable Main, input: @mutable Input, value: i64 in Wrapping, digits: bool) {
        transition digits {
            true -> finish(input, value),
            false -> done()
        }
    }
    machine finish(input: @mutable Input, value: i64 in Wrapping) {
        let index: u64 = input.count;
        transition index < 19 {
            true -> final_store(input, value, index),
            false -> invalid(input)
        }
    }
    machine final_store(input: @mutable Input, value: i64 in Wrapping, index: u64)
    requires index < 19 {
        input.values[index] = value;
        input.count = index + 1;
    }
    machine invalid(input: @mutable Input) { input.status = 1; }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
