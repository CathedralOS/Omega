module chemistry::inventory;
use chemistry::model;

machine minimum(left: i64 in Wrapping, right: i64 in Wrapping) -> i64 in Wrapping {
    transition left < right { true -> left false -> right }
}

// One integer extent consumes a complete coefficient tuple. Initial product
// inventory is retained. Compute the entire proposal before committing, so a
// refused overflow leaves all inventory untouched. Intermediate products are
// <=8*INT32_MAX; elemental totals <=64*INT32_MAX, both safely within i64.
machine process(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch)
requires balance.coefficients[0] > 0 && balance.coefficients[1] > 0 {
    batch.inventory[0] = reaction.stock[0];
    batch.inventory[1] = reaction.stock[1];
    batch.inventory[2] = reaction.stock[2];
    batch.inventory[3] = reaction.stock[3];
    batch.overflow = false;
    batch.limiting = 0;
    batch.cap_limited = 0;
    let first: i64 in Wrapping = reaction.stock[0] / balance.coefficients[0];
    let second: i64 in Wrapping = reaction.stock[1] / balance.coefficients[1];
    let capacity: i64 in Wrapping = minimum(first, second);
    batch.extent = minimum(capacity, reaction.cap);
    transition first == capacity { true -> first_limit(reaction, balance, batch, second, capacity) false -> second_limit(reaction, balance, batch, second, capacity) }
    machine first_limit(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch, second: i64 in Wrapping, capacity: i64 in Wrapping) {
        batch.limiting = 1;
        transition { _ -> second_limit(reaction, balance, batch, second, capacity) }
    }
    machine second_limit(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch, second: i64 in Wrapping, capacity: i64 in Wrapping) {
        transition second == capacity { true -> add_second(reaction, balance, batch, capacity) false -> cap_limit(reaction, balance, batch, capacity) }
    }
    machine add_second(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch, capacity: i64 in Wrapping) {
        batch.limiting = batch.limiting + 2;
        transition { _ -> cap_limit(reaction, balance, batch, capacity) }
    }
    machine cap_limit(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch, capacity: i64 in Wrapping) {
        transition reaction.cap < capacity { true -> capped(reaction, balance, batch) false -> propose(reaction, balance, batch) }
    }
    machine capped(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch) {
        batch.cap_limited = 1;
        transition { _ -> propose(reaction, balance, batch) }
    }
    machine propose(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch) {
        let third: i64 in Wrapping = reaction.stock[2] + batch.extent * balance.coefficients[2];
        let fourth: i64 in Wrapping = reaction.stock[3] + batch.extent * balance.coefficients[3];
        transition third <= 2147483647 && fourth <= 2147483647 {
            true -> commit(reaction, balance, batch, third, fourth)
            false -> overflow(batch)
        }
    }
    machine commit(reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &mut chemistry::model::Batch, third: i64 in Wrapping, fourth: i64 in Wrapping) {
        batch.inventory[0] = reaction.stock[0] - batch.extent * balance.coefficients[0];
        batch.inventory[1] = reaction.stock[1] - batch.extent * balance.coefficients[1];
        batch.inventory[2] = third;
        batch.inventory[3] = fourth;
    }
    machine overflow(batch: &mut chemistry::model::Batch) { batch.overflow = true; }
}
