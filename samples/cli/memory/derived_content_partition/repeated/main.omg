// Expected exit: 0
// A derived child can become the owned input of another checked partition.
// Retain its sibling across the second call and dispose every resulting claim.
use omega::language::core::content;
use omega::language::core::drop;

data Region [linear] { start: u64; end: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.start) as Nat, end: embed(region.end) as Nat }
}
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, cut: u64) -> Pieces
requires whole.start <= cut && cut <= whole.end
ensures
    result.left.start == whole.start;
    result.left.end == cut;
    result.right.start == cut;
    result.right.end == whole.end;
    Owned::content(old(&whole)) == separate(
        Owned::content(&result.left), Owned::content(&result.right))
{
    let left: Region = Region { start: whole.start, end: cut };
    let right: Region = Region { start: cut, end: whole.end };
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let whole: Region in Owned = Region { start: 10, end: 90 };
    let pieces: Pieces = split(whole, 30);
    let { left, right } = pieces;
    let second: Pieces = split(right, 60);
    let correct: bool = left.start == 10 && left.end == 30
        && second.left.start == 30 && second.left.end == 60
        && second.right.start == 60 && second.right.end == 90;
    drop(left);
    drop(second.left);
    drop(second.right);
    transition correct { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
