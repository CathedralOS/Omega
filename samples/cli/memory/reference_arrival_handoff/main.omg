// Expected exit: 0.
// Handing a reference to another binding preserves its original backing.
machine main() crashes Trap {
    let mut backing: i64 = 17;
    let original: &mut i64 = &mut backing;
    let child: &mut i64 = original;
    child = 41;
    let observed: i64 = child;
    transition observed == 41 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
