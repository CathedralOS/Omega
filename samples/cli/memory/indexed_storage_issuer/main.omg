// Expected exit: 0.
// Exact declaration authority survives generic invocation. Domain indices and
// actual value identity survive forwarding, field storage and state transfer.
data Ticket { value: u64; }
data First {}
data Second {}
data Envelope { ticket: Ticket in Issued<First>; }
data Factory<P> { tag: P; }
domain<P> Ticket::Issued<P> established by issue, Ticket::issue_ensured, Factory::issue;

machine issue<P>(value: u64) -> Ticket in Issued<P> {
    Ticket { value: value }
}
machine Ticket::issue_ensured<P>(value: u64) -> Ticket
ensures result in Issued<P>
{
    Ticket { value: value }
}
machine forward<P>(ticket: Ticket in Issued<P>) -> Ticket in Issued<P> { ticket }
machine read<P>(ticket: Ticket in Issued<P>) -> u64 { ticket.value }
machine Factory::issue<P>(factory: &Factory<P>, value: u64) -> Ticket in Issued<P> {
    Ticket { value: value }
}

machine main() crashes Trap {
    let first: Ticket in Issued<First> = forward<First>(issue<First>(73));
    let envelope: Envelope = Envelope { ticket: first };
    let second: Ticket = Ticket::issue_ensured<Second>(19);
    let observed: u64 = read<First>(envelope.ticket);
    let other: u64 = read<Second>(forward<Second>(second));
    let factory: Factory<First> = Factory { tag: First {} };
    let attached: Ticket in Issued<First> = Factory::issue(&factory, 31);
    let third: u64 = read<First>(attached);
    transition { _ -> finish(observed, other, third) }
    machine finish(observed: u64, other: u64, third: u64) {
        transition observed == 73 && other == 19 && third == 31 { true -> done() _ -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
