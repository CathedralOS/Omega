// Expected exit: 0. A state borrows a qualified owner's original storage.
data Resource { identity: u64; }
domain Resource::Open(resource) requires resource.identity != 0;

machine main() crashes Trap {
    let mut resource: Resource in Open = Resource { identity: 73 };
    transition { _ -> inspect(&mut resource) }

    state inspect(resource: &mut Resource in Open) {
        transition resource.identity == 73 { true -> done() false -> wrong() }
    }
    state done() {}
    state wrong() { crash Trap; }
}
