// Expected exit: 0.
// A checked provider forwards privately issued resources without becoming
// another authorized issuer. The caller retains custody through a state edge.
pub data Resource { identity: u64; }
pub domain Resource::Open(resource)
requires resource.identity != 0
established by acquire;
pub data Acquisition {
    case Error;
    case Ok(resource: Resource in Open);
}

machine acquire(identity: u64) -> Resource in Open requires identity != 0 {
    Resource { identity: identity }
}
pub boundary trait Source {
    machine open() -> Acquisition;
}
pub CheckedSource satisfies Source {
    machine open() -> Acquisition {
        Acquisition::Ok { resource: acquire(73) }
    }
}
machine observe(resource: &Resource in Open) -> u64 { resource.identity }
machine close(resource: Resource in Open) {}

data Main { }
machine Main::main(context: &mut Main) reaches Source invokes Source; crashes Trap {
    let acquired: Acquisition = Source::open();
    transition acquired {
        Acquisition::Ok { resource } -> received(resource)
        _ -> wrong()
    }
    state received(resource: Resource in Open) {
        let identity: u64 = observe(&resource);
        close(resource);
        transition identity == 73 { true -> done() false -> wrong() }
    }
    state done() {}
    state wrong() { crash Trap; }
}
