// Area of a shape via a SUM TYPE (enum) with payloads -- the classic case for
// tagged unions. `Shape` has two payload-carrying variants, `Circle(radius)` and
// `Rectangle(width, height)`. A value is constructed (`Shape::Rectangle { width: 6,
// height: 7 }`), then matched in a transition: each arm binds that variant's payload
// fields and dispatches to a state that computes the area for that case (rectangle =
// w*h = 42; circle approximates pi as 3). Demonstrates enum construction, matching
// on a stored enum field, payload-field extraction, and per-variant computation.
// Expected exit: 42.

use omega_language_std::console;

// FULLY EXACT -- no overflow domain: each match arm passes its payload through a
// guard hop (`radius < 101` etc.) into a compute state with a RANGED parameter, so
// every per-variant area computation is verifiably bounded (radius*radius*3 <=
// 30000, width*height <= 10000) and `area` needs no domain at all.
data Shape {
    case Circle(radius: i32);
    case Rectangle(width: i32, height: i32);
}

data Main {
    console: Console;
    shape: Shape;
    area: i32;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("shape_area: matches a Shape enum payload and computes that variant's area");
    self.shape = Shape::Rectangle { width: 6, height: 7 };

    transition self.shape {
        Shape::Circle { radius } -> circle(radius)
        Shape::Rectangle { width, height } -> rect(width, height)
    }

    // The payload arrives as a plain i32; a guard hop re-establishes its bound on
    // the direct edge into the compute state, which carries a ranged parameter.
    state circle(&mut self, radius: i32) {
        transition radius >= 0 && radius < 101 {
            true -> circle_area(radius)
            _ -> emit()
        }
    }
    state circle_area(&mut self, radius: i32 [0..=100]) {
        self.area = radius * radius * 3;
        transition { _ -> emit() }
    }
    state rect(&mut self, width: i32, height: i32) {
        transition width >= 0 && width < 101 && height >= 0 && height < 101 {
            true -> rect_area(width, height)
            _ -> emit()
        }
    }
    state rect_area(&mut self, width: i32 [0..=100], height: i32 [0..=100]) {
        self.area = width * height;
        transition { _ -> emit() }
    }
    state emit(&mut self) {
        self.console.write_line("result: the matched shape's area, 42 for this 6x7 rectangle (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.area);
    }
}
