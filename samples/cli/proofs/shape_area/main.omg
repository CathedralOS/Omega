// Area of a shape via a SUM TYPE (enum) with payloads -- the classic case for
// tagged unions. `Shape` has two payload-carrying variants, `Circle(radius)` and
// `Rectangle(width, height)`. A value is constructed (`Shape::Rectangle { width: 6,
// height: 7 }`), then matched in a transition: each arm binds that variant's payload
// fields and dispatches to a state that computes the area for that case (rectangle =
// w*h = 42; circle approximates pi as 3). Demonstrates enum construction, matching
// on a stored enum field, payload-field extraction, and per-variant computation.
// Expected exit: 42.

use omega_language_std::console;

// FULLY EXACT -- no overflow domain: each match arm passes its payload through a
// guard hop (`radius < 101` etc.) into a compute state whose `requires` contract
// restates the bound, so every per-variant area computation is verifiably
// bounded (radius*radius*3 <= 30000, width*height <= 10000) and `area` needs no
// domain at all.
data Shape {
    case Circle(radius: i32);
    case Rectangle(width: i32, height: i32);
}

data Main {
    shape: Shape;
    area: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("shape_area: matches a Shape enum payload and computes that variant's area");
    main.shape = Shape::Rectangle { width: 6, height: 7 };

    transition main.shape {
        Shape::Circle { radius } -> circle(main, radius)
        Shape::Rectangle { width, height } -> rect(main, width, height)
    }

    // The payload arrives as a plain i32; a guard hop re-establishes its bound on
    // the direct edge into the compute state, whose contract admits it.
    state circle(main: &mut Main, radius: i32) {
        transition radius >= 0 && radius < 101 {
            true -> circle_area(main, radius)
            _ -> emit(main)
        }
    }
    state circle_area(main: &mut Main, radius: i32) requires radius >= 0 requires radius < 101 {
        main.area = radius * radius * 3;
        transition { _ -> emit(main) }
    }
    state rect(main: &mut Main, width: i32, height: i32) {
        transition width >= 0 && width < 101 && height >= 0 && height < 101 {
            true -> rect_area(main, width, height)
            _ -> emit(main)
        }
    }
    state rect_area(main: &mut Main, width: i32, height: i32)
    requires width >= 0
    requires width < 101
    requires height >= 0
    requires height < 101 {
        main.area = width * height;
        transition { _ -> emit(main) }
    }
    state emit(main: &mut Main) {
        Console::write_line("result: the matched shape's area, 42 for this 6x7 rectangle (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.area);
    }
}
