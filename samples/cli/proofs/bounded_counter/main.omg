// A counter saturating at a bound. Showcases `[copy]` type
// properties and saturating arithmetic over a dispatched self-write path
// driven by scalar arguments. (Historical: case-payload commands threaded into
// a self-writing sub-machine used to miscompile; FIXED 2026-06, locked by the
// pass canary tests/omega/pass/calls/by_value_case_param_self_write_exit.
// vending_machine is the case-payload showcase.)
// Expected exit: 70.

use omega_language_std::console;

data Counter [copy] {
    value: i32 in Saturating;
    bound: i32 in Saturating;
}

data Main {
    counter: Counter;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("bounded_counter: saturating counter -- three add(40)s against a bound of 100");
    main.counter.bound = 100;

    Main::add(main, 40);
    Main::add(main, 40);
    Main::add(main, 40);   // 120, saturates to 100

    transition main.counter.value == 100 {
        true -> good_msg(main)
        _ -> not_hundred(main)
    }
    state good_msg(main: &mut Main) {
        Console::write_line("PASS: counter saturated at the bound, value == 100 (exit 70)");
        transition { _ -> report(main, 70) }
    }
    state not_hundred(main: &mut Main) {
        transition main.counter.value == 120 {
            true -> bad_sat_msg(main)   // saturation didn't apply
            _ -> bad_other_msg(main)    // some other wrong value
        }
    }
    state bad_sat_msg(main: &mut Main) {
        Console::write_line("FAIL: counter reached 120 -- saturation did not apply (exit 81)");
        transition { _ -> report(main, 81) }
    }
    state bad_other_msg(main: &mut Main) {
        Console::write_line("FAIL: counter holds an unexpected value -- neither 100 nor 120 (exit 82)");
        transition { _ -> report(main, 82) }
    }
    state report(main: &mut Main, code: i32) {
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(code);
    }
}

// add saturates at the bound; the self-write happens in a dispatched substate
// reached via a scalar-argument call (probe-confirmed sound).
machine Main::add(main: &mut Main, amount: i32 in Saturating) {
    let next: i32 in Saturating = main.counter.value + amount;
    transition next > main.counter.bound {
        true -> saturate(main)
        _ -> set_value(main, next)
    }
    state saturate(main: &mut Main) {
        main.counter.value = main.counter.bound;
    }
    state set_value(main: &mut Main, next: i32 in Saturating) {
        main.counter.value = next;
    }
}
