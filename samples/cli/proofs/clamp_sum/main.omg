// Clamp a series of raw sensor readings into a valid band and sum the results.
// Each reading is clamped to [0, 60] via the standard idiom `max(lo, min(v, hi))`,
// This composes the ordinary integer min/max helper contracts. For readings [80, -5, 50, 200, 30] the clamped values
// are [60, 0, 50, 60, 30], summing to 200. Walks the slice with the shrinking-
// window recursion (`s[1..]`), reading `s[0]` under the `s.len > 0` guard so the
// index is discharged in the same transition. The accumulator is `in Wrapping`,
// DECLARED: the recursion runs over a slice of unknown length, so no ceiling on
// the running sum is provable (each clamped step is bounded, the count is not).
// Expected exit: 200.

use omega_language_std::console;
use omega_language_std::math;

// Wrapping DECLARED: the accumulator sums an unbounded number of clamped steps.
machine clamp_sum(s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32 in Wrapping {
    transition s.len > 0 {
        true -> clamp_sum(s[1..], acc + (max_i32(0, min_i32(s[0] as i32, 60)) as i32 in Wrapping))
        false -> (acc)
    }
}

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("clamp_sum: clamp readings [80, -5, 50, 200, 30] to [0, 60] and sum them");
    let values: [i32 in Wrapping; 5] = [80, -5, 50, 200, 30];

    let slice: &[i32 in Wrapping] = &values[..];
    let total: i32 = clamp_sum(slice, 0) as i32;
    Console::write_line("result: the clamped sum, 200 for these readings (the exit code)");
    Console::write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block Console::read_line(&mut pause);
    Console::exit_process(total);
}
