// Expected exit: 0.
// A selected service accepts a wider input range and promises a tighter result.
trait Threshold {
    machine limit(value: u32) -> u32
    requires value <= 100
    ensures result <= 100;
}

machine clamp_low(input: u32) -> u32
requires input <= 200
ensures result <= 90
{
    transition input <= 90 {
        true -> (input)
        _ -> 90
    }
}

Conservative satisfies Threshold {
    Threshold::limit = clamp_low;
}

machine selected_limit<Implementation satisfies Threshold>(value: u32) -> u32
requires value <= 100
ensures result <= 100
{
    Implementation::limit(value)
}

machine main() crashes Trap {
    let zero: u32 = selected_limit<Conservative>(0);
    let middle: u32 = selected_limit<Conservative>(42);
    let upper: u32 = selected_limit<Conservative>(100);
    let direct: u32 = clamp_low(200);
    transition zero == 0 && middle == 42 && upper == 90 && direct == 90 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
