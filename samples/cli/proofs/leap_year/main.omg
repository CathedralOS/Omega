// Leap-year test -- the classic compound-boolean algorithm: a year is a leap year
// if it is divisible by 4 AND not by 100, OR it is divisible by 400. This exercises
// `&&`, `||`, `==`, `!=`, and `%` together in a single guard. Omega uses standard
// operator precedence (`&&` binds tighter than `||`), so `A && B || C` parses as
// `(A && B) || C` -- no parentheses needed (and a transition subject cannot begin
// with `(` anyway). The three boundary cases prove the precedence is correct: 2024
// (div by 4, not 100) and 2000 (div by 400) are leap; 1900 (div by 100, not 400) is
// not. This sample checks 2024 -> exit 1 (leap).
// Expected exit: 1.

use omega_language_std::console;

data Main {
    year: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("leap_year: classifying 2024 with the div-4/100/400 compound rule");
    main.year = 2024;

    transition main.year % 4 == 0 && main.year % 100 != 0 || main.year % 400 == 0 {
        true -> leap(main)
        _ -> common(main)
    }

    state leap(main: &mut Main) {
        Console::write_line("PASS: 2024 is a leap year (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
    state common(main: &mut Main) {
        Console::write_line("FAIL: 2024 misclassified as a common year (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
}
