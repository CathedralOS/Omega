// NOTE: no Expected-exit annotation on purpose -- this is a compile-time proof ladder
// (every machine body is empty). The native exe exits an abnormal status (0x40001000-ish)
// while the interpreter exits 0; run behavior of an empty proof program is unspecified
// today. The sample is compile-checked only.
// Math proofs: a theorem ladder as Omega proof machines.
//
// Every machine below has an empty body. Per Chapter 10, that makes the
// contract a proof claim: requires + built-in math rules must entail ensures.
// Each rung is annotated with the entailment-engine increment it needs and
// the closest Lean 4 / Mathlib analog.

// ---------------------------------------------------------------------------
// L0: constant arithmetic. Both sides fold to the same Nat.
// Lean analog: `example : 3 * 3 + 4 * 4 = 5 * 5 := by decide`
// Engine increment: constant folding + reflexivity.
machine pythagorean_three_four_five()
ensures
    3nat * 3nat + 4nat * 4nat == 5nat * 5nat
{
}

// ---------------------------------------------------------------------------
// L1: ordering transitivity over hypotheses.
// Lean analog: `Nat.lt_trans : a < b -> b < c -> a < c`
// Engine increment: stored-fact matching + transitive chaining.
machine less_than_transitive(a: u64, b: u64, c: u64)
requires
    a < b
    b < c
ensures
    a < c
{
}

// Order asymmetry's positive face: strict order implies distinctness.
// Lean analog: `Nat.ne_of_lt : a < b -> a != b`
machine distinct_when_ordered(i: u64, j: u64)
requires
    i < j
ensures
    i != j
{
}

// ---------------------------------------------------------------------------
// L2: linear range arithmetic (interval addition).
// Lean analog: `add_le_add : a <= b -> c <= d -> a + c <= b + d` (both bounds)
// Engine increment: interval propagation through `+`.
machine sum_of_bounded(a: u64, b: u64)
requires
    a in 1..=10
    b in 1..=10
ensures
    a + b in 2..=20
{
}

// ---------------------------------------------------------------------------
// L3: congruence -- equality respects function application.
// Lean analog: `congrArg (fun n => n + 1) : a = b -> a + 1 = b + 1`
// Engine increment: rewriting under stored equations.
machine add_one_congruence(a: u64, b: u64)
requires
    a == b
ensures
    a + 1 == b + 1
{
}

// ---------------------------------------------------------------------------
// L4: commutativity with no hypotheses.
// Lean analog: `Nat.add_comm : a + b = b + a`
// Engine increment: term normalization (canonical operand order).
machine add_commutative(a: u64, b: u64)
ensures
    a + b == b + a
{
}

// ---------------------------------------------------------------------------
// L5: nonlinear ranges (interval product of a variable with itself).
// Lean analog: `Nat.mul_le_mul : a <= b -> c <= d -> a * c <= b * d`
// Engine increment: interval products.
machine square_bounded(a: u64)
requires
    a in 0..=10
ensures
    a * a in 0..=100
{
}

// ---------------------------------------------------------------------------
// L6: richer structure that already parses and typechecks today.

// Antisymmetry of <=.
// Lean analog: `Nat.le_antisymm : a <= b -> b <= a -> a = b`
machine less_equal_antisymmetric(a: u64, b: u64)
requires
    a <= b
    b <= a
ensures
    a == b
{
}

// Distributivity, a ring normalization fact.
// Lean analog: `Nat.add_mul : (a + b) * c = a * c + b * c` (or `by ring`)
// The fixed-width inputs embed into proof `Int`, so normalization is over
// unbounded mathematics rather than unproved Exact `u64` arithmetic.
machine multiply_distributes(a: u64, b: u64, c: u64)
ensures
    (embed(a) + embed(b)) * embed(c) == embed(a) * embed(c) + embed(b) * embed(c)
{
}

// Euclidean remainder bound.
// Lean analog: `Nat.mod_lt : 0 < n -> a % n < n`
machine remainder_bounded(a: u64)
ensures
    a % 2 in 0..=1
{
}

// Proof views: Bag (multiset) equality carried from requires to ensures.
// Lean analog: transporting `(items : Multiset) = before` via `exact h`.
// Bag(...) is accepted contract surface today; its lowering is future work.
machine bag_equality_carries(before: &[u64], items: &[u64])
requires
    Bag(items) == Bag(before)
ensures
    Bag(items) == Bag(before)
{
}

// ---------------------------------------------------------------------------
// Proof machines emit no runtime code; the entrypoint is intentionally inert.
data Main {
}

machine Main::main(&mut self) {
}
