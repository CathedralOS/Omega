// Structural proofs sample build sketch. No package dependencies: proof
// machines emit no runtime code, so the bound entry remains inert while the
// subject selects a ProgramEntry for native artifact production.

machine build(builder: &mut Build) {
    Build::application(builder, "structural_proofs");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
