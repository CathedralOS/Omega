// Structural proofs over the roster's recursive data (math roster N3/N4).
// Where math_proofs is an integer theorem ladder, this ladder proves facts
// about PROOF-ONLY recursive data -- Peano `Nat` and generic `Seq<T>` from
// {omega}/language/core -- through the structural entailment judge. Every
// theorem here is TRUE (the file compiles under `omega --check`). Proof
// machines emit no runtime code.
//
//   omega --check samples/cli/proofs/structural_proofs/main.omg
//
use {omega}/language/core/nat.omg;
use {omega}/language/core/seq.omg;

// --- The equality kernel over proof data --------------------------------

// Reflexivity. Lean analog: `rfl`.
machine nat_reflexive(a: |nat|::Nat)
ensures
    a == a
{
}

// Constructor INJECTIVITY: same-case equations decompose pairwise.
// Lean analog: `Nat.succ.injEq` / `Nat.succ_injective`.
machine succ_injective(a: |nat|::Nat, b: |nat|::Nat)
requires
    (|nat|::Nat::Succ { prev: a }) == (|nat|::Nat::Succ { prev: b })
ensures
    a == b
{
}

// Case DISJOINTNESS: distinct constructors of one type never equal.
// Lean analog: `Nat.zero_ne_succ`. (Stated as a refuted requires: the
// contradictory hypothesis discharges any conclusion -- ex falso.)
machine zero_ne_succ(a: |nat|::Nat)
requires
    |nat|::Nat::Zero == (|nat|::Nat::Succ { prev: a })
ensures
    a == (|nat|::Nat::Succ { prev: a })
{
}

// --- Compute mode: unfolding a proof machine's definition ----------------

// Ground computation: 1 + 1 == 2, by unfolding core add twice.
// Lean analog: `by decide` / `rfl` on `1 + 1 = 2`.
machine one_plus_one_is_two()
ensures
    (|nat|::add(|nat|::Nat::Succ { prev: |nat|::Nat::Zero }, |nat|::Nat::Succ { prev: |nat|::Nat::Zero }))
        == (|nat|::Nat::Succ { prev: |nat|::Nat::Succ { prev: |nat|::Nat::Zero } })
{
}

// The empty sequence has length zero (unfold core Seq length's Empty arm).
// Lean analog: `List.length_nil`.
machine length_nil_is_zero()
ensures
    (|seq|::length(|seq|::Seq::Empty)) == |nat|::Nat::Zero
{
}

// --- Structural induction and citation are proven IN THE CORE LIBRARY ----
// core/nat.omg carries add_zero_right (right identity, by induction on a)
// and add_succ_law (the successor-shift law); both are package-private, so
// this program CITES seq.omg's public length_append theorem instead -- a
// package selecting a product may only cite another package's public
// machines.

// A consumer that cites length_append's proven law
// `length(append(s, t)) == add(length(s), length(t))` as a bare statement;
// the citation imports the proven equation into this machine's fact context.
// Its inductive body never finitely unfolds for symbolic arguments, so
// citation is the only route. Lean analog: `have h := List.length_append s t`.
machine cite_append_length(s: |seq|::Seq<u64>, t: |seq|::Seq<u64>) -> |nat|::Nat
requires
    |seq|::length(s) == |nat|::Nat::Zero
ensures
    result == |nat|::Nat::Zero
{
    |seq|::length_append(s, t);
    transition { _ -> |nat|::Nat::Zero }
}

// Proof machines emit no runtime code; the entrypoint is inert.
machine main() {
}
