// Structural proofs over the roster's recursive data (math roster N3/N4).
// Where math_proofs is an integer theorem ladder, this ladder proves facts
// about PROOF-ONLY recursive data -- Peano `Nat` and generic `Seq<T>` from
// omega::language::core -- through the structural entailment judge. Every
// theorem here is TRUE (the file compiles under `omega --check`); the FALSE
// twins live in tests/canaries/fail/proofs/. Proof machines emit no runtime code.
//
//   omega --check samples/cli/proofs/structural_proofs/main.omg
//
use omega::language::core::nat;
use omega::language::core::seq;

// --- The equality kernel over proof data --------------------------------

// Reflexivity. Lean analog: `rfl`.
machine nat_reflexive(a: Nat)
ensures
    a == a
{
}

// Constructor INJECTIVITY: same-case equations decompose pairwise.
// Lean analog: `Nat.succ.injEq` / `Nat.succ_injective`.
machine succ_injective(a: Nat, b: Nat)
requires
    (Nat::Succ { prev: a }) == (Nat::Succ { prev: b })
ensures
    a == b
{
}

// Case DISJOINTNESS: distinct constructors of one type never equal.
// Lean analog: `Nat.zero_ne_succ`. (Stated as a refuted requires: the
// contradictory hypothesis discharges any conclusion -- ex falso.)
machine zero_ne_succ(a: Nat)
requires
    Nat::Zero == (Nat::Succ { prev: a })
ensures
    a == (Nat::Succ { prev: a })
{
}

// --- Compute mode: unfolding a proof machine's definition ----------------

// Ground computation: 1 + 1 == 2, by unfolding core add twice.
// Lean analog: `by decide` / `rfl` on `1 + 1 = 2`.
machine one_plus_one_is_two()
ensures
    (add(Nat::Succ { prev: Nat::Zero }, Nat::Succ { prev: Nat::Zero }))
        == (Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } })
{
}

// The empty sequence has length zero (unfold core Seq length's Empty arm).
// Lean analog: `List.length_nil`.
machine length_nil_is_zero()
ensures
    (length(Seq::Empty)) == Nat::Zero
{
}

// --- Structural induction and citation are proven IN THE CORE LIBRARY ----
// core/nat.omg carries add_zero_right (right identity, by induction on a)
// and add_succ_law (the successor-shift law); this program CITES them.

// A consumer that cites add_zero_right's proven `result == a` ensures --
// its inductive body never finitely unfolds for a symbolic argument, so
// citation is the only route. Lean analog: `exact Nat.add_zero a`.
machine cite_right_identity(a: Nat) -> Nat
ensures
    result == a
{
    transition { _ -> (add_zero_right(a)) }
}

// Proof machines emit no runtime code; the entrypoint is inert.
data Main {
}

machine Main::main(&mut self) {
}
