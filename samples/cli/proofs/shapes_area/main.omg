// Shape area computation. Combines case-payload dispatch, value-position
// machine calls, scalar arithmetic, and multi-arm comparison.
//
// Shapes and their integer areas:
//   circle_area(3)   = 3*3*3 = 27
//   rect_area(5, 8)  = 5*8   = 40
//   tri_area(6, 1)   = 6*1/2 =  3
//   Total: 27+40+3   = 70
//
// Historical workaround note: a native miscompile used to trigger when a
// value-position call with an internal `let` was followed by a call with MORE
// args. Probe-verified FIXED (native==interp) on 2026-07-01; the caller-side
// multiplications below are retained but no longer load-bearing. (The old
// tests/omega/pending reference was purged with the pending backlog.)
//
// Expected exit: 70.

use omega_language_std::console;

data Main {
    console: Console;
    total: i32 in Saturating;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("shapes_area: circle + rectangle + triangle areas via value-returning machines");
    // Circle radius 3: r*r = 9, passed as scalar; callee returns 9*3 = 27.
    let rr: i32 in Saturating = 3 * 3;
    let a1: i32 in Saturating = self.triple(rr);

    // Rectangle 5x8: callee returns 5*8 = 40.
    let a2: i32 in Saturating = self.product(5, 8);

    // Triangle base=6, height=1: callee returns 6*1/2 = 3.
    let a3: i32 in Saturating = self.halve(6, 1);

    self.total = a1 + a2 + a3;

    transition self.total == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.write_line("PASS: areas 27+40+3 total 70 (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.write_line("FAIL: area total did not equal 70 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}

// Multiply by 3.
machine Main::triple(&mut self, n: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (n * 3)
    }
}

// Multiply two integers.
machine Main::product(&mut self, w: i32 in Saturating, h: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (w * h)
    }
}

// Divide two integers (integer division).
machine Main::halve(&mut self, b: i32 in Saturating, h: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (b * h / 2)
    }
}
