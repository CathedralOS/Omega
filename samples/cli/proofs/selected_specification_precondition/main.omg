// Expected exit: 70
use omega_language_std::console;
use omega::language::core::binding;
use omega::language::core::nat;
machine selected_identity<machine Modulus>(value: Nat) -> Nat
where machine Modulus(value: Nat) -> Nat;
requires (saturating_sub(Modulus(value), value)) == Nat::Zero
{
    value
}
machine identity<machine Modulus>(value: Nat)
where machine Modulus(value: Nat) -> Nat;
requires (saturating_sub(Modulus(value), value)) == Nat::Zero
ensures selected_identity<Modulus>(value) == value
{
}

machine zero_modulus(value: Nat) -> Nat { Nat::Zero }
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    identity<zero_modulus>(Nat::Zero);
    main.console.exit_process(70);
}
