// Expected exit: 0
use omega::language::core::external_binding;

boundary trait ProcessProbe { machine identity() -> u32 reaches; }
data NativeProcess {}
data NativeUnused {}
// Checked source may retain a table declaration beyond this target's native
// record-layout envelope when no executed call demands its realization.
data UnusedWideTable { padding: [u8; 65536]; invoke: addr; }
boundary trait UnusedWideCall { machine invoke(table: &UnusedWideTable) -> u32 reaches; }

UnusedWideProvider satisfies UnusedWideCall {
    machine invoke(table: &UnusedWideTable) -> u32 { 0 }
}


ProcessProvider satisfies ProcessProbe {
    machine identity() -> u32 {
        let observed: u32 = RawNativeNativeProcess::identity();
        23
    }
}


UnusedProvider satisfies ProcessProbe {
    machine identity() -> u32 { RawNativeNativeUnused::identity() }
}
windows_x86_64 machine observed_process() -> u32 reaches ProcessProbe {
    RawNativeNativeProcess::identity()
}
archive_target machine observed_process() -> u32 reaches ProcessProbe {
    RawNativeNativeUnused::identity()
}
machine main() reaches ProcessProbe crashes Trap {
    let direct: u32 = RawNativeNativeProcess::identity();
    let forwarded: u32 = observed_process();
    let wrapped: u32 = ProcessProbe::identity();
    transition direct > 0 && forwarded == direct && wrapped == 23 {
        true -> accepted()
        _ -> rejected()
    }
    machine accepted() {}
    machine rejected() { crash Trap; }
}

boundary trait RawNativeUnusedWideCall {
    machine invoke(table: &UnusedWideTable) -> u32 reaches;
}

boundary trait RawNativeNativeProcess { machine identity() -> u32
; }
boundary trait RawNativeNativeUnused { machine identity() -> u32
; }
