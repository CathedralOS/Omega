// Unix-style permission bits built and manipulated with the bitwise operators
// `&`, `|`, `^`. A small but complete demonstration of flag arithmetic:
//
//   READ = 4   WRITE = 2   EXEC = 1   STICKY = 8
//
//   grant read+write with `|`          -> rw-       (6)
//   add execute with `|`               -> rwx       (7)
//   revoke execute by AND-masking ~EXEC -> rw-       (6)
//   set the sticky bit with `|`         -> rw- +s   (14)
//   toggle the write bit off with `^`   -> r-- +s   (12)
//
// The starting `4 | 2` folds at compile time (const bitwise OR); the rest are
// runtime field operations. Bitwise results are plain integers and never
// overflow, so `mode` needs no arithmetic domain.
// Expected exit: 12.

use omega_language_std::console;

data Main {
    mode: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("file_permissions: unix-style permission bits built with bitwise and/or/xor");
    main.mode = 4i32 | 2;       // READ | WRITE          -> 6
    main.mode = main.mode | 1;  // + EXEC                -> 7
    main.mode = main.mode & 6;  // revoke EXEC (mask ~1) -> 6
    main.mode = main.mode | 8;  // + STICKY              -> 14
    main.mode = main.mode ^ 2;  // toggle WRITE off      -> 12

    transition { _ -> emit(main) }

    state emit(main: &mut Main) {
        Console::write_line("result: the final mode bits r-- +s, 12 for this sequence (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.mode);
    }
}
