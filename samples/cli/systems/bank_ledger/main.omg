// Bank ledger with fixed-capacity transaction list.
//
// Stresses: [i32 in Saturating; 8] fixed-array with const-indexed reads/writes, running
// balance accumulation, deposit/withdraw operations, and multi-step arithmetic.
//
// Historical workaround note: a native miscompile used to trigger when a let-bound
// local was captured and passed as an argument to a nested dispatch state within
// the same machine call (`let slot = count; ... try1(slot, val)` gave wrong slot
// values on repeated calls). Probe-verified FIXED (native==interp) on 2026-07-01;
// the field-read style below is retained but no longer load-bearing. (The old
// tests/omega/pending reference was purged with the pending backlog.)
//
// Transactions (positive=deposit, negative=withdraw):
//   txns[0] = +500   deposit 500
//   txns[1] = +200   deposit 200  -> cumulative = 700
//   txns[2] = -150   withdraw 150 -> cumulative = 550
//   txns[3] = +300   deposit 300  -> cumulative = 850
//   txns[4] = -80    withdraw 80  -> cumulative = 770
//   txns[5] = -700   withdraw 700 -> cumulative = 70
//
// Final balance = 70. Exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Ledger [copy] {
    txns: [i32 in Saturating; 8];
    count: i32 in Saturating;
    balance: i32 in Saturating;
}

data Main {
    ledger: Ledger;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("bank_ledger: 6 deposits/withdrawals into a fixed transaction list, then a const-indexed balance sum");
    Main::deposit(main, 500);
    Main::deposit(main, 200);
    Main::withdraw(main, 150);
    Main::deposit(main, 300);
    Main::withdraw(main, 80);
    Main::withdraw(main, 700);

    // Compute balance from transaction list (const-indexed reads).
    let sum: i32 in Saturating = main.ledger.txns[0]
                 + main.ledger.txns[1]
                 + main.ledger.txns[2]
                 + main.ledger.txns[3]
                 + main.ledger.txns[4]
                 + main.ledger.txns[5];
    main.ledger.balance = sum;

    transition main.ledger.balance == 70 {
        true -> check_count(main)
        _ -> bad_balance(main)
    }

    state check_count(main: &mut Main) {
        transition main.ledger.count == 6 {
            true -> good(main)
            _ -> bad_count(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: final balance 70 from 6 transactions, count 6 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad_balance(main: &mut Main) {
        Console::write_line("FAIL: balance != 70 -- transaction sum wrong (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state bad_count(main: &mut Main) {
        Console::write_line("FAIL: transaction count != 6 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }
}

// Deposit: write amount to slot given by count, then increment count.
// Workaround: guard on (count+1) after increment to pick the target slot.
machine Main::deposit(main: &mut Main, amount: i32 in Saturating) {
    main.ledger.count = main.ledger.count + 1;
    transition main.ledger.count == 1 {
        true -> write0(main, amount)
        _ -> check2(main, amount)
    }

    state write0(main: &mut Main, amount: i32 in Saturating) { main.ledger.txns[0] = amount; }

    state check2(main: &mut Main, amount: i32 in Saturating) {
        transition main.ledger.count == 2 {
            true -> write1(main, amount)
            _ -> check3(main, amount)
        }
    }
    state write1(main: &mut Main, amount: i32 in Saturating) { main.ledger.txns[1] = amount; }

    state check3(main: &mut Main, amount: i32 in Saturating) {
        transition main.ledger.count == 3 {
            true -> write2(main, amount)
            _ -> check4(main, amount)
        }
    }
    state write2(main: &mut Main, amount: i32 in Saturating) { main.ledger.txns[2] = amount; }

    state check4(main: &mut Main, amount: i32 in Saturating) {
        transition main.ledger.count == 4 {
            true -> write3(main, amount)
            _ -> check5(main, amount)
        }
    }
    state write3(main: &mut Main, amount: i32 in Saturating) { main.ledger.txns[3] = amount; }

    state check5(main: &mut Main, amount: i32 in Saturating) {
        transition main.ledger.count == 5 {
            true -> write4(main, amount)
            _ -> check6(main, amount)
        }
    }
    state write4(main: &mut Main, amount: i32 in Saturating) { main.ledger.txns[4] = amount; }

    state check6(main: &mut Main, amount: i32 in Saturating) {
        transition main.ledger.count == 6 {
            true -> write5(main, amount)
            _ -> done()
        }
    }
    state write5(main: &mut Main, amount: i32 in Saturating) { main.ledger.txns[5] = amount; }

    state done() {}
}

// Withdraw: store as negative amount.
machine Main::withdraw(main: &mut Main, amount: i32 in Saturating) {
    let neg: i32 in Saturating = 0 - amount;
    Main::deposit(main, neg);
}
