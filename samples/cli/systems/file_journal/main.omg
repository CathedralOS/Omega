use omega::language::core::ProcessExit;
// A portable filesystem journal: create a directory, write a 17-byte file,
// inspect it, read its bytes back, rename it, and remove the file/directory.
// Each successful step increments the tally; partial completion returns fewer
// than seven. The application calls FilesystemService directly and holds no raw OS role.
// Expected exit: 7.
use omega_language_std::File;
use omega_language_std::IoResult;
use omega_language_std::Metadata;
use omega_language_std::MetadataResult;
use omega_language_std::OpenResult;
use omega_language_std::UnitResult;
use omega_language_std::Console;
use omega_language_std::FilesystemService;

data Main {
    result: UnitResult;
    opened: OpenResult;
    transferred: IoResult;
    metadata: MetadataResult;
    passed: i32 in Wrapping;
    buffer: [u8; 64];
}

machine main(main: &mut Main) reaches ProcessExit + Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    // The sample owns these paths. Remove its prior interrupted run first.
    main.result = block FilesystemService::remove("/tmp/omega_journal_dir/note.txt");
    main.result = block FilesystemService::remove("/tmp/omega_journal_dir/renamed.txt");
    main.result = block FilesystemService::remove_dir("/tmp/omega_journal_dir");
    main.result = block FilesystemService::create_dir("/tmp/omega_journal_dir");
    transition main.result { UnitResult::Ok -> block made_directory(main) _ -> done(main) }

    machine made_directory(main: &mut Main) {
        main.passed = main.passed + 1;
        main.opened = block FilesystemService::create("/tmp/omega_journal_dir/note.txt");
        transition main.opened { OpenResult::Ok { file } -> block write(main, file) _ -> done(main) }
    }
    machine write(main: &mut Main, file: File) {
        main.transferred = block FilesystemService::write(file, "omega fs journal\n");
        main.result = block FilesystemService::close(file);
        transition main.result { UnitResult::Ok -> block written(main) _ -> done(main) }
    }
    machine written(main: &mut Main) {
        transition main.transferred { IoResult::Ok { count } -> block count_written(main, count) _ -> done(main) }
    }
    machine count_written(main: &mut Main, count: u64) {
        transition count == 17 { true -> block inspect(main) false -> done(main) }
    }
    machine inspect(main: &mut Main) {
        main.passed = main.passed + 1;
        main.metadata = block FilesystemService::metadata_path("/tmp/omega_journal_dir/note.txt");
        transition main.metadata { MetadataResult::Ok { meta } -> block inspected(main, meta) _ -> done(main) }
    }
    machine inspected(main: &mut Main, metadata: Metadata) {
        transition metadata.len == 17 { true -> block open_for_read(main) false -> done(main) }
    }
    machine open_for_read(main: &mut Main) {
        main.passed = main.passed + 1;
        main.opened = block FilesystemService::open("/tmp/omega_journal_dir/note.txt");
        transition main.opened { OpenResult::Ok { file } -> block read(main, file) _ -> done(main) }
    }
    machine read(main: &mut Main, file: File) {
        main.transferred = block FilesystemService::read(file, &mut main.buffer[..], 17);
        main.result = block FilesystemService::close(file);
        transition main.result { UnitResult::Ok -> block read_complete(main) _ -> done(main) }
    }
    machine read_complete(main: &mut Main) {
        transition main.transferred { IoResult::Ok { count } -> block count_read(main, count) _ -> done(main) }
    }
    machine count_read(main: &mut Main, count: u64) {
        transition count == 17 { true -> block bytes_read(main) false -> done(main) }
    }
    machine bytes_read(main: &mut Main) {
        transition main.buffer[0] == 111 && main.buffer[1] == 109 && main.buffer[2] == 101
            && main.buffer[3] == 103 && main.buffer[4] == 97 && main.buffer[5] == 32
            && main.buffer[6] == 102 && main.buffer[7] == 115 && main.buffer[8] == 32
            && main.buffer[9] == 106 && main.buffer[10] == 111 && main.buffer[11] == 117
            && main.buffer[12] == 114 && main.buffer[13] == 110 && main.buffer[14] == 97
            && main.buffer[15] == 108 && main.buffer[16] == 10 {
            true -> block rename(main)
            false -> done(main)
        }
    }
    machine rename(main: &mut Main) {
        main.passed = main.passed + 1;
        main.result = block FilesystemService::rename("/tmp/omega_journal_dir/note.txt", "/tmp/omega_journal_dir/renamed.txt");
        transition main.result { UnitResult::Ok -> block renamed(main) _ -> done(main) }
    }
    machine renamed(main: &mut Main) {
        main.passed = main.passed + 1;
        main.result = block FilesystemService::remove("/tmp/omega_journal_dir/renamed.txt");
        transition main.result { UnitResult::Ok -> block removed_file(main) _ -> done(main) }
    }
    machine removed_file(main: &mut Main) {
        main.passed = main.passed + 1;
        main.result = block FilesystemService::remove_dir("/tmp/omega_journal_dir");
        transition main.result { UnitResult::Ok -> removed_directory(main) _ -> done(main) }
    }
    machine removed_directory(main: &mut Main) {
        main.passed = main.passed + 1;
        transition { _ -> done(main) }
    }
    machine done(main: &mut Main) { ProcessExit::exit_process(main.passed as i32); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block main(&mut entry_storage);
}
