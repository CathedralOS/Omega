// A real end-to-end filesystem workflow over Omega's std::fs seam, run for
// real on macOS AND windows: make a directory,
// create and write a file inside it, confirm the file exists via `stat`
// (`read_metadata`), reopen and read the bytes back, rename it, remove the
// file, then remove the directory. Every step must succeed; the program
// tallies the seven verified steps and exits with that count (so a partial
// failure exits with fewer than 7 and the harness assertion catches it).
//
// Format-neutral operations drive the raw `FilesystemHost` directly. Opening
// and creating files goes through `Filesystem`: open flags are foreign-format
// facts owned by the selected target package, not constants exposed through
// the provider boundary for application code to assemble. This keeps Windows
// binary mode and the POSIX encodings behind one checked adapter while the
// sample still exercises raw stat/read/write/rename/remove operations.
//
// Expected exit: 7.

use omega_language_std::filesystem;
use omega_language_std::filesystem_host;

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    fs: Binding<FilesystemHost>;
    files: Filesystem;
    console: Binding<Console>;
    dir_mode: i32;
    open_result: OpenResult;
    fd: i32;
    rc: i32;
    n: i64;
    // Step tally 0..=7. `in Wrapping` gives the `+ 1` a defined-overflow domain so
    // the exact-arithmetic proof obligation is discharged (the value never nears
    // the i32 range, but the checker requires an explicit domain regardless).
    passed: i32 in Wrapping;
    buffer: [u8; 64];
    meta: [u8; 144];
}

machine Main::main(main: &mut Main) reaches Console + FilesystemHost {
    main.dir_mode = 493; // 0o755

    // Best-effort clean slate so a re-run is deterministic (ignore the results:
    // on a fresh machine these targets do not exist yet).
    main.rc = main.fs.remove("/tmp/omega_journal_dir/note.txt");
    main.rc = main.fs.remove("/tmp/omega_journal_dir/renamed.txt");
    main.rc = main.fs.remove_dir("/tmp/omega_journal_dir");

    // Step 1 — create the working directory.
    main.rc = main.fs.create_dir("/tmp/omega_journal_dir", main.dir_mode);
    transition main.rc == 0 { true -> made_dir(main) _ -> done(main) }

    state made_dir(main: &mut Main) {
        main.passed = main.passed + 1;
        // Step 2 — create the file through the portable target-format adapter
        // and write a known 17-byte line.
        main.open_result = Filesystem::create(&mut main.files, "/tmp/omega_journal_dir/note.txt");
        transition main.open_result { OpenResult::Ok { file } -> opened_for_write(main, file) _ -> done(main) }
    }
    state opened_for_write(main: &mut Main, file: File) {
        main.fd = file.fd;
        main.n = main.fs.write(main.fd, "omega fs journal\n");
        main.rc = main.fs.close(main.fd);
        transition main.n == 17 { true -> wrote_file(main) _ -> done(main) }
    }
    state wrote_file(main: &mut Main) {
        main.passed = main.passed + 1;
        // Step 3 — the file exists (stat succeeds; no read permission needed).
        main.rc = main.fs.read_metadata("/tmp/omega_journal_dir/note.txt", &mut main.meta);
        transition main.rc == 0 { true -> confirmed_present(main) _ -> done(main) }
    }
    state confirmed_present(main: &mut Main) {
        main.passed = main.passed + 1;
        // Step 4 — reopen read-only through the same adapter and read the 17
        // bytes back byte-exactly.
        main.open_result = Filesystem::open(&mut main.files, "/tmp/omega_journal_dir/note.txt");
        transition main.open_result { OpenResult::Ok { file } -> opened_for_read(main, file) _ -> done(main) }
    }
    state opened_for_read(main: &mut Main, file: File) {
        main.fd = file.fd;
        main.n = main.fs.read(main.fd, &mut main.buffer, 17);
        main.rc = main.fs.close(main.fd);
        transition main.n == 17 { true -> read_back(main) _ -> done(main) }
    }
    state read_back(main: &mut Main) {
        main.passed = main.passed + 1;
        // Step 5 — rename within the directory.
        main.rc = main.fs.rename("/tmp/omega_journal_dir/note.txt", "/tmp/omega_journal_dir/renamed.txt");
        transition main.rc == 0 { true -> renamed(main) _ -> done(main) }
    }
    state renamed(main: &mut Main) {
        main.passed = main.passed + 1;
        // Step 6 — remove the file.
        main.rc = main.fs.remove("/tmp/omega_journal_dir/renamed.txt");
        transition main.rc == 0 { true -> removed_file(main) _ -> done(main) }
    }
    state removed_file(main: &mut Main) {
        main.passed = main.passed + 1;
        // Step 7 — remove the now-empty directory.
        main.rc = main.fs.remove_dir("/tmp/omega_journal_dir");
        transition main.rc == 0 { true -> removed_dir(main) _ -> done(main) }
    }
    state removed_dir(main: &mut Main) {
        main.passed = main.passed + 1;
        transition { _ -> done(main) }
    }

    state done(main: &mut Main) {
        // Exit with the number of verified steps: 7 on full success.
        main.console.exit_process(main.passed as i32);
    }
}
