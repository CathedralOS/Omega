// Expected exit: 0
public boundary trait NativeFill {
    machine check(left: @[u8; 256], right: @[u8; 256], count: u64) -> i32 reaches none crashes none;
    machine fill(output: @mutable [u8; 144], value: i32, count: u64) -> u64 reaches none crashes none;
}

machine fill(output: @mutable [u8]) -> u64 requires output.length >= 144 reaches NativeFill {
    let whole: @mutable [u8; 144] = @mutable output[0] as @mutable [u8; 144];
    NativeFill::fill(whole, 17, 144)
}
machine main() reaches NativeFill crashes Trap {
    let mutable bytes: [u8; 256];
    bytes[7] = 23;
    bytes[152] = 37;
    // A shared whole-array observation establishes both canaries in the same
    // original native home. Later out-of-window native writes become visible.
    let observed: i32 = NativeFill::check(@bytes, @bytes, 256);
    let first: u64 = fill(@mutable bytes[8..152]);
    let snapshot: [u8; 256] = bytes;
    bytes[8] = 29;
    transition bytes[8] == 29 && snapshot[8] == 17 {
        true -> {}, false -> wrong()
    }
    let second: u64 = fill(@mutable bytes[8..152]);
    transition observed == 0 && first != 0 && first == second && bytes[8] == 17 && bytes[56] == 17 && bytes[151] == 17
        && bytes[7] == 23 && bytes[152] == 37 {
        true -> {}, false -> wrong()
    }
    machine wrong() crashes Trap { crash Trap; }
}
