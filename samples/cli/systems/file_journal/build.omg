// file_journal build manifest.

use main.omg as app;
use {omega}/build/dependency.omg;
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/process_exit.omg as process;

machine build(builder: @mutable Build) {
    Build::application(builder, "file_journal");
    let allowed: [BoundaryServiceReference; 6] = [
        Build::service::<|authority|::FilesystemContentRead>(builder),
        Build::service::<|authority|::FilesystemContentWrite>(builder),
        Build::service::<|authority|::FilesystemMetadataMutation>(builder),
        Build::service::<|authority|::FilesystemMetadataQuery>(builder),
        Build::service::<|authority|::FilesystemNamespaceMutation>(builder),
        Build::service::<|process|::ProcessExit>(builder)
    ];
    let system: DependencyDescription = |dependency|::from_source(Source::Path {
        location: "../../../../source/library/system"
    });
    _ = |dependency|::add(builder, system, @allowed[..]);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
}
