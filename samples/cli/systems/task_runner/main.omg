// Task runner: nested case-payload dispatch through a sub-machine
// that mutates its subject across multiple calls.
//
// Exercises: a case-payload Task dispatched to a sub-machine (run_task),
// which itself dispatches on the task type and calls ANOTHER sub-machine
// (apply_result) to accumulate the score. This stresses nested sub-machine
// calls where each level mutates its subject, and case-payload values passed
// down multiple levels.
//
// Task variants:
//   Compute(value: i32 in Saturating)  -- add value to score
//   Double               -- double the current score
//   Reset                -- set score to 0
//   Clamp(max: i32 in Saturating)      -- clamp score to max if it exceeds max
//
// Scripted sequence:
//   Compute(10)    -> score=10
//   Compute(15)    -> score=25
//   Double         -> score=50
//   Compute(5)     -> score=55
//   Clamp(45)      -> score=45  (55 > 45, clamp to 45)
//   Compute(25)    -> score=70
//
// Final: score == 70. Exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Task {
    case Compute(value: i32 in Saturating);
    case Double;
    case Reset;
    case Clamp(max: i32 in Saturating);
}

data Runner [copy] {
    score: i32 in Saturating;
}

data Main {
    runner: Runner;
    pause: [u8; 256];
}

// Top-level dispatcher: receive a task and handle it.
machine Main::run_task(main: &mut Main, task: Task) {
    transition task {
        Task::Compute { value } -> do_compute(main, value)
        Task::Double -> do_double(main)
        Task::Reset -> do_reset(main)
        Task::Clamp { max } -> do_clamp(main, max)
        _ -> done()
    }

    state do_compute(main: &mut Main, value: i32 in Saturating) {
        main.runner.score = main.runner.score + value;
    }

    state do_double(main: &mut Main) {
        main.runner.score = main.runner.score * 2;
    }

    state do_reset(main: &mut Main) {
        main.runner.score = 0;
    }

    state do_clamp(main: &mut Main, max: i32 in Saturating) {
        transition main.runner.score > max {
            true -> apply_clamp(main, max)
            _ -> done()
        }
    }

    state apply_clamp(main: &mut Main, max: i32 in Saturating) {
        main.runner.score = max;
    }

    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("task_runner: nested case-payload dispatch runs a compute/double/clamp script");
    Main::run_task(main, Task::Compute { value: 10 });
    Main::run_task(main, Task::Compute { value: 15 });
    Main::run_task(main, Task::Double);
    Main::run_task(main, Task::Compute { value: 5 });
    Main::run_task(main, Task::Clamp { max: 45 });
    Main::run_task(main, Task::Compute { value: 25 });

    transition main.runner.score == 70 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: the task script left the score at 70 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::write_line("FAIL: the final score was not 70 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
