// Task runner: nested case-payload dispatch through a sub-machine
// that mutates self across multiple calls.
//
// Exercises: a case-payload Task dispatched to a sub-machine (run_task),
// which itself dispatches on the task type and calls ANOTHER sub-machine
// (apply_result) to accumulate the score. This stresses nested sub-machine
// calls where each level mutates self, and case-payload values passed
// down multiple levels.
//
// Task variants:
//   Compute(value: i32 in Saturating)  -- add value to score
//   Double               -- double the current score
//   Reset                -- set score to 0
//   Clamp(max: i32 in Saturating)      -- clamp score to max if it exceeds max
//
// Scripted sequence:
//   Compute(10)    -> score=10
//   Compute(15)    -> score=25
//   Double         -> score=50
//   Compute(5)     -> score=55
//   Clamp(45)      -> score=45  (55 > 45, clamp to 45)
//   Compute(25)    -> score=70
//
// Final: score == 70. Exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Task {
    case Compute(value: i32 in Saturating);
    case Double;
    case Reset;
    case Clamp(max: i32 in Saturating);
}

data Runner [copy] {
    score: i32 in Saturating;
}

data Main {
    console: Console;
    runner: Runner;
    pause: [u8; 256];
}

// Top-level dispatcher: receive a task and handle it.
machine Main::run_task(&mut self, task: Task) {
    transition task {
        Task::Compute { value } -> do_compute(value)
        Task::Double -> do_double()
        Task::Reset -> do_reset()
        Task::Clamp { max } -> do_clamp(max)
        _ -> done()
    }

    state do_compute(&mut self, value: i32 in Saturating) {
        self.runner.score = self.runner.score + value;
    }

    state do_double(&mut self) {
        self.runner.score = self.runner.score * 2;
    }

    state do_reset(&mut self) {
        self.runner.score = 0;
    }

    state do_clamp(&mut self, max: i32 in Saturating) {
        transition self.runner.score > max {
            true -> apply_clamp(max)
            _ -> done()
        }
    }

    state apply_clamp(&mut self, max: i32 in Saturating) {
        self.runner.score = max;
    }

    state done(&mut self) {}
}

machine Main::main(&mut self) {
    self.console.write_line("task_runner: nested case-payload dispatch runs a compute/double/clamp script");
    self.run_task(Task::Compute { value: 10 });
    self.run_task(Task::Compute { value: 15 });
    self.run_task(Task::Double);
    self.run_task(Task::Compute { value: 5 });
    self.run_task(Task::Clamp { max: 45 });
    self.run_task(Task::Compute { value: 25 });

    transition self.runner.score == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.write_line("PASS: the task script left the score at 70 (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.write_line("FAIL: the final score was not 70 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
