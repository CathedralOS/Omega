// Extract and checksum the payload of a framed message. The frame is
// [header, b0, b1, b2, trailer]; the payload is the middle three bytes, obtained
// with the TWO-BOUND subslice `full[1..4]` (the `Slice::range` operator, distinct
// from the one-bound tail `s[1..]` used elsewhere). The bound proof `1 <= 4 &&
// 4 <= len` is discharged from the array's static length of 5. For
// [255, 10, 20, 30, 0] the payload [10, 20, 30] sums to 60. The inner `sum`
// walks the payload with the shrinking-window recursion.
// Expected exit: 60.

use omega_language_std::console;

// Wrapping DECLARED: the checksum sums slice elements, which carry no range
// facts yet (the elements share the domain so the accumulation is single-domain).
data Frame {
    bytes: [i32 in Wrapping; 5];
}

// The payload may borrow this frame's bytes. A read-only sum must not request
// exclusive access to the enclosing frame while that shared view is live.
machine sum(s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32 in Wrapping {
    transition s.len > 0 {
        true -> sum(s[1..], acc + s[0])
        false -> (acc)
    }
}

data Main {
    frame: Frame;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("framed_payload: subslicing the payload out of a framed message and summing it");
    main.frame.bytes[0] = 255;
    main.frame.bytes[1] = 10;
    main.frame.bytes[2] = 20;
    main.frame.bytes[3] = 30;
    main.frame.bytes[4] = 0;

    let full: &[i32 in Wrapping] = &main.frame.bytes[..];
    let checksum: i32 = sum(full[1..4], 0) as i32;
    Console::write_line("result: the payload checksum, 60 for this frame (the exit code)");
    Console::write_line("[press Enter to close]");
    _ = block Console::read_line(&mut main.pause);
    Console::exit_process(checksum);
}
