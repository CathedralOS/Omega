// CLI MVP build sketch.
//
// Hello world needs only two host capabilities:
//
// - stdout.write_line: writes initialized UTF-8 bytes to process stdout.
// - process.exit: terminates the process with a target-specific exit code.
//
// Cross-platform providers map those contracts to OS calls:
//
// - Linux/macOS: write(1, bytes, len), then exit(code).
// - Windows: WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), bytes, len), then
//   ExitProcess(code).

use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "atomics_cross" };
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path {
        location: "../../../../source/library/system"
    }));
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
