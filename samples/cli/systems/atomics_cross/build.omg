// CLI MVP build sketch.
//
// Hello world needs only two host capabilities:
//
// - stdout.write_line: writes initialized UTF-8 bytes to process stdout.
// - process.exit: terminates the process with a target-specific exit code.
//
// Cross-platform providers map those contracts to OS calls:
//
// - Linux/macOS: write(1, bytes, len), then exit(code).
// - Windows: WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), bytes, len), then
//   ExitProcess(code).

machine build(builder: &mut Build) {
    Build::application(builder, "atomics_cross");
    Build::depend(builder, Source::Path {
        location: "../../../../source/library/std"
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
