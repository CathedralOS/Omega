// Expected exit: 70.
// Cross-platform atomics smoke test: exercises atomic read-modify-write plus
// every legal load/store ordering family so each target's real instructions
// are emitted end-to-end.
//
//   fetch_add        -> LOCK xadd  (x86_64) / LDADD (aarch64, NoOrdering)
//   compare_exchange -> LOCK CMPXCHG (x86_64) / CASAL (aarch64)
//
// All operands are constants and nothing is passed as a state argument, so the
// program compiles for every declared target. Exit 70 iff all ops behaved:
//   store(10); fetch_add(5)  -> old1==10, counter==15
//   compare_exchange(15,99)  -> prior==15 (match), counter==99
//   Publish store/Receive load and GlobalOrder store/load round-trip
//
// Verified on the host (windows_x86_64) by execution; the aarch64 LDADD/CASAL
// paths are verified by cross-emission + disassembly (this box cannot run them).

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    counter: AtomicU32;
    pause: [u8; 256];
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("atomics_cross: real LOCK xadd + LOCK cmpxchg -- store(10), fetch_add(5), compare_exchange(15,99)");
    self.counter.store(10, NoOrdering);

    let old1: u32 in Wrapping = self.counter.fetch_add(5, NoOrdering);
    transition old1 == 10 {
        true -> after_add(&mut self)
        _ -> bad(&mut self)
    }

    state after_add(main: &mut Main) {
        // counter is now 15 (a field, so it survived the transition).
        let prior: u32 in Wrapping = main.counter.compare_exchange(15, 99, ReceivePublish, Receive);
        transition prior == 15 {
            true -> after_cas(main)
            _ -> bad(main)
        }
    }

    state after_cas(main: &mut Main) {
        transition main.counter == 99 {
            true -> publish_receive(main)
            _ -> bad(main)
        }
    }

    state publish_receive(main: &mut Main) {
        main.counter.store(100, Publish);
        let observed: u32 = main.counter.load(Receive);
        transition observed == 100 {
            true -> global_order(main)
            _ -> bad(main)
        }
    }

    state global_order(main: &mut Main) {
        main.counter.store(101, GlobalOrder);
        let observed: u32 = main.counter.load(GlobalOrder);
        transition observed == 101 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.write_line("PASS: RMW and every load/store ordering round-tripped (exit 70)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(70);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: an atomic RMW or ordered load/store misbehaved (exit 71)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(71);
    }
}
