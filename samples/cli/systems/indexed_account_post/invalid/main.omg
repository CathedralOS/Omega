// Deposit index 4 is outside the case where bound 0 <= index && index < 4.

data Account [copy] {
    balance: i32 in Wrapping;
    frozen: i32 in Wrapping;
}

data Post
    requires ((self in Post::Deposit) && 0 <= self.index && self.index < 4)
       || ((self in Post::Withdraw) && 0 <= self.index && self.index < 4)
       || ((self in Post::Freeze) && 0 <= self.index && self.index < 4)
{
    case Deposit(index: i32, amount: i32 in Wrapping);
    case Withdraw(index: i32, amount: i32 in Wrapping);
    case Freeze(index: i32);
}

data Main {
    accounts: [Account; 4];
}

machine Main::main(main: &mut Main) {
    let post: Post = Post::Deposit { index: 4, amount: 1 };
    main.accounts[0].balance = 0;
}
