machine build(builder: &mut Build) {
    Build::application(builder, "static_provider_closure");
    Build::select_provider<PortableSource, PortableProvider>(builder, linux_arm64);
    Build::select_provider<PortableSource, PortableProvider>(builder, linux_x86_64);
    Build::select_provider<PortableSource, PortableProvider>(builder, macos_arm64);
    Build::select_provider<PortableSource, PortableProvider>(builder, macos_x86_64);
    Build::select_provider<PortableSource, PortableProvider>(builder, windows_x86_64);
    Build::select_provider<PortableSource, PortableProvider>(builder, uefi_x86_64);
    Build::select_provider<PortableSource, PortableProvider>(builder, cross_platform_cli);
    Build::select_provider<PortableSource, PortableProvider>(builder, local_unchecked);
    Build::select_provider<PortableSource, PortableProvider>(builder, alpha_bootstrap);
    Build::select_provider<RawSource, OtherRawProvider>(builder, linux_arm64);
    Build::select_provider<RawSource, OtherRawProvider>(builder, linux_x86_64);
    Build::select_provider<RawSource, OtherRawProvider>(builder, macos_arm64);
    Build::select_provider<RawSource, OtherRawProvider>(builder, macos_x86_64);
    Build::select_provider<RawSource, OtherRawProvider>(builder, windows_x86_64);
    Build::select_provider<RawSource, OtherRawProvider>(builder, uefi_x86_64);
    Build::select_provider<RawSource, OtherRawProvider>(builder, cross_platform_cli);
    Build::select_provider<RawSource, OtherRawProvider>(builder, local_unchecked);
    Build::select_provider<RawSource, OtherRawProvider>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
