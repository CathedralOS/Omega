// Expected exit: 0.
// Direct foreign calls keep interface exposure independent of public and supply.
// The three libc abs calls must return 41, 39 and 37, including state forwarding.
use omega::language::core::external_binding;

public boundary trait Magnitude {
    machine absolute(value: i32) -> i32 reaches requires value > -2147483648;
    machine ordinary(value: i32) -> i32 reaches requires value > -2147483648;
    machine exported(value: i32) -> i32 reaches requires value > -2147483648;
}


data Main { operand: i32; }
machine Main::main(main: &mut Main) crashes Trap {
    main.operand = -41;
    let local: i32 = main.operand;
    let first: i32 = Magnitude::absolute(local);
    let second: i32 = Magnitude::ordinary(-39);
    transition true { true -> verify(first, second, -37) }
    machine verify(first: i32, second: i32, value: i32)
        requires value > -2147483648 {
        let third: i32 = Magnitude::exported(value);
        transition first == 41 && second == 39 && third == 37 {
            true -> done()
            false -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
