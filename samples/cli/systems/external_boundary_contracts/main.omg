// Expected exit: 0.
// Direct foreign calls keep interface exposure independent of public and supply.
// The three libc abs calls must return 41, 39 and 37, including state forwarding.
use omega::language::core::external_binding;

public boundary trait Magnitude {
    machine absolute(value: i32) -> i32 reaches requires value > -2147483648;
    machine ordinary(value: i32) -> i32 reaches requires value > -2147483648;
    machine exported(value: i32) -> i32 reaches requires value > -2147483648;
}
public macos_arm64 machine absolute_binding() -> ForeignBinding<26, 4, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs"
    } }
}
macos_arm64 boundary machine absolute(value: i32) -> i32
    satisfies Magnitude::absolute via absolute_binding()
    requires value > -2147483648;
macos_arm64 machine ordinary(value: i32) -> i32
    satisfies Magnitude::ordinary via absolute_binding()
    requires value > -2147483648;
public macos_arm64 boundary machine exported(value: i32) -> i32
    satisfies Magnitude::exported via absolute_binding()
    requires value > -2147483648;

data Main { operand: i32; }
machine Main::main(main: &mut Main) crashes Trap {
    main.operand = -41;
    let local: i32 = main.operand;
    let first: i32 = absolute(local);
    let second: i32 = ordinary(-39);
    transition true { true -> verify(first, second, -37) }
    state verify(first: i32, second: i32, value: i32)
        requires value > -2147483648 {
        let third: i32 = exported(value);
        transition first == 41 && second == 39 && third == 37 {
            true -> done()
            false -> wrong()
        }
    }
    state done() {}
    state wrong() { crash Trap; }
}
