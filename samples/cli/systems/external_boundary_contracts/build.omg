use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "external_boundary_contracts");
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);

 Build::bind<Magnitude::absolute>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs"
    } });
 Build::bind<Magnitude::ordinary>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs"
    } });
 Build::bind<Magnitude::exported>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs"
    } });
}
