// vending_machine: a coin-and-change vending flow written in the VALUE-CALL
// style the compiler now supports end to end (all shapes below are also
// pinned by discriminating canaries; this sample keeps them exercised as
// ordinary user code):
//   - a value call directly in a GUARD subject   (price_of(context, 1) == 50)
//   - value calls as TRANSITION ARGUMENTS         (report(context, make_change(100, 55), 17))
//   - the SAME callee at multiple sites per state (a = price_of(context, 0); b = price_of(context, 1))
//   - a dispatch-bodied STRUCT result to a FIELD  (context.change = make_change(...))
//   - side effects in the callee's ENTRY body     (sales_count bump -- arm-state
//     effects are a compile error by design; the entry runs exactly once)
//
// Menu: item 0 = 35, item 1 = 50, item 2 = 65. Buy item 2 with 100:
// change = 1 quarter + remainder 10. Checksum exit:
//   35 + 50 - 65 + 1*40 + 10 - 20 + sales_count(3) + 17 = 70
// Expected exit: 70.

use omega_language_std::console;

data Change {
    quarters: i32 in Wrapping;
    remainder: i32 in Wrapping;
}

data Main {
    sales_count: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    change: Change;
}

// A value machine with a runtime-selected arm ladder. The sales_count bump
// lives in the ENTRY: it runs once per call no matter which arm is selected.
machine Main::price_of(context: &mut Main, item: i32 in Wrapping) -> i32 in Wrapping {
    context.sales_count = context.sales_count + 1;
    transition item == 0 {
        true -> cheap()
        _ -> upper(item)
    }
    state cheap() -> i32 in Wrapping { 35 }
    state upper(item: i32 in Wrapping) {
        transition item == 1 {
            true -> mid()
            _ -> dear()
        }
    }
    state mid() -> i32 in Wrapping { 50 }
    state dear() -> i32 in Wrapping { 65 }
}

// A dispatch-bodied STRUCT result: quarters greedily, arms are PURE (bare
// constructor terminals) -- the sound shape for value-position arms.
machine Main::make_change(paid: i32 in Wrapping, price: i32 in Wrapping) -> Change {
    let owed: i32 in Wrapping = paid - price;
    transition owed >= 25 {
        true -> coin(owed)
        _ -> rest(owed)
    }
    state coin(owed: i32 in Wrapping) -> Change {
        Change { quarters: 1, remainder: owed - 25 }
    }
    state rest(owed: i32 in Wrapping) -> Change {
        Change { quarters: 0, remainder: owed }
    }
}

machine Main::main(context: &mut Main) reaches Console {
    // Same callee, two sites in one state: each site keeps ITS call's result.
    context.a = Main::price_of(context, 0);
    context.b = Main::price_of(context, 1);

    // A value call directly in the guard subject.
    transition Main::price_of(context, 1) == 50 { true -> buy(context) _ -> bad(context, 90) }

    state buy(context: &mut Main) {
        // Struct result delivered straight into a field.
        context.change = Main::make_change(100, 65);
        transition context.change.quarters == 1 { true -> chk_rem(context) _ -> bad(context, 91) }
    }

    state chk_rem(context: &mut Main) {
        transition context.change.remainder == 10 { true -> handoff(context) _ -> bad(context, 92) }
    }

    state handoff(context: &mut Main) {
        // Value calls as transition arguments (different + repeated callees).
        transition context.a == 35 { true -> report(context, Main::make_change(100, 55), 17) _ -> bad(context, 93) }
    }

    state report(context: &mut Main, extra: Change, bonus: i32 in Wrapping) {
        // 35 + 50 - 65 + 40 + 10 - 20 + 3 + 17 = 70
        let sum: i32 in Wrapping = context.a + context.b - 65
            + context.change.quarters * 40
            + context.change.remainder
            - extra.remainder
            + context.sales_count
            + bonus;
        transition sum == 70 { true -> good(context) _ -> bad(context, 94) }
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main, code: i32) { Console::exit_process(code); }
}
