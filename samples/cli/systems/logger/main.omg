// Structured logger with severity levels as case members.
//
// Log levels: Debug, Info, Warn, Error(code: i32 in Saturating).
// The logger counts entries by level and computes a weighted score:
//   score = info_count*2 + warn_count*5 + error_code*10
//
// Scripted log sequence:
//   log(Info)      x5  -> info_count  = 5, contribution = 10
//   log(Warn)      x4  -> warn_count  = 4, contribution = 20
//   log(Error{4})  x1  -> error_code  = 4, contribution = 40
//   total score = 10 + 20 + 40 = 70
//
// Verification:
//   score == 70 -> exit 70.
//
// Expected exit: 70.

use omega_language_std::console;
use omega::language::core::binding;

// Severity levels. Error carries a numeric code.
data LogLevel {
    case Debug;
    case Info;
    case Warn;
    case Error(code: i32 in Saturating);
}

// Accumulator tracking per-level counts and total error code sum.
data Logger [copy] {
    debug_count: i32 in Saturating;
    info_count: i32 in Saturating;
    warn_count: i32 in Saturating;
    error_count: i32 in Saturating;
    error_code_sum: i32 in Saturating;
}

data Main {
    console: Binding<Console>;
    logger: Logger;
    pause: [u8; 256];
}

// Record one log entry; dispatch on the level case.
machine Main::log(main: &mut Main, level: LogLevel) {
    transition level {
        LogLevel::Debug -> on_debug(main)
        LogLevel::Info -> on_info(main)
        LogLevel::Warn -> on_warn(main)
        LogLevel::Error { code } -> on_error(main, code)
        _ -> done()
    }

    state on_debug(main: &mut Main) {
        main.logger.debug_count = main.logger.debug_count + 1;
    }

    state on_info(main: &mut Main) {
        main.logger.info_count = main.logger.info_count + 1;
    }

    state on_warn(main: &mut Main) {
        main.logger.warn_count = main.logger.warn_count + 1;
    }

    state on_error(main: &mut Main, code: i32 in Saturating) {
        main.logger.error_count = main.logger.error_count + 1;
        main.logger.error_code_sum = main.logger.error_code_sum + code;
    }

    state done() {}
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("logger: counting log entries by severity into a weighted score");
    // Log five Info entries.
    Main::log(&mut self, LogLevel::Info);
    Main::log(&mut self, LogLevel::Info);
    Main::log(&mut self, LogLevel::Info);
    Main::log(&mut self, LogLevel::Info);
    Main::log(&mut self, LogLevel::Info);

    // Log four Warn entries.
    Main::log(&mut self, LogLevel::Warn);
    Main::log(&mut self, LogLevel::Warn);
    Main::log(&mut self, LogLevel::Warn);
    Main::log(&mut self, LogLevel::Warn);

    // Log one Error with code 4.
    Main::log(&mut self, LogLevel::Error { code: 4 });

    // Compute weighted score: info*2 + warn*5 + error_code_sum*10.
    // = 5*2 + 4*5 + 4*10 = 10+20+40 = 70.
    // Broken into steps to avoid complex multi-multiplication let expressions.
    let info_part: i32 in Saturating = self.logger.info_count * 2;
    let warn_part: i32 in Saturating = self.logger.warn_count * 5;
    let error_part: i32 in Saturating = self.logger.error_code_sum * 10;
    let score: i32 in Saturating = info_part + warn_part + error_part;

    transition score == 70 {
        true -> check_counts()
        _ -> bad_score()
    }

    // Also verify the per-level counts as a sanity check.
    state check_counts(&mut self) {
        transition self.logger.info_count == 5 {
            true -> check_warn()
            _ -> bad_info()
        }
    }

    state check_warn(&mut self) {
        transition self.logger.warn_count == 4 {
            true -> check_error()
            _ -> bad_warn()
        }
    }

    state check_error(&mut self) {
        transition self.logger.error_count == 1 {
            true -> good()
            _ -> bad_error()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: 5 info + 4 warn + 1 error scored 70 (exit 70)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad_score(&mut self) {
        self.console.write_line("FAIL: wrong weighted score (exit 71)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state bad_info(&mut self) {
        self.console.write_line("FAIL: wrong info count (exit 72)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state bad_warn(&mut self) {
        self.console.write_line("FAIL: wrong warn count (exit 73)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }

    state bad_error(&mut self) {
        self.console.write_line("FAIL: wrong error count (exit 74)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(74);
    }
}
