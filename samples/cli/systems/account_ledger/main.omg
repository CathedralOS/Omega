// account_ledger: event-sourced account simulation.
//
// Exercises: multi-field case payload dispatch (3 payload variants + 3 no-payload
// variants, no-payload AFTER payload), fixed [Account; 4] record array, frozen
// flag gate, value-returning helpers (balance_of mutating the ledger, total()),
// and sequential value-call results combined in arithmetic.
//
// *** MISCOMPILE FIXED (historical; verified native==interp==70 on 2026-07-01) ***
//
// This sample originally documented a live miscompile (native exited 93 while the
// interpreter exited 70). The probe arms below (exit codes 91-93) are retained as a
// regression tripwire.
//
// Historical root cause (confirmed by arm-argument probes at the time):
//   When dispatching the THIRD case variant `Transaction::Transfer { to, amount }`
//   and passing both fields as sub-state arguments `check_xfer(idx, to, amount)`,
//   the SECOND payload field `amount` received the value of the FIRST payload
//   field `to` in native emission.  The interpreter extracted both fields correctly.
//
// Minimal trigger:
//   data Transaction {
//     case Deposit(amount: i32);     // 1st variant
//     case Withdraw(amount: i32);    // 2nd variant
//     case Transfer(to: i32, amount: i32);  // 3rd variant - 2-field payload
//     case Freeze;                   // 4th - no payload
//     ...
//   }
//   machine M::apply(main: &mut M, idx: i32, tx: Transaction) {
//     transition tx {
//       Transaction::Transfer { to, amount } -> check_xfer(main, idx, to, amount)
//       ...
//     }
//     state check_xfer(main: &mut M, idx: i32, to: i32, amount: i32) {
//       // In native: `amount` == `to` (3 instead of 40).
//       // Confirmed: `to`==3 passes, `amount`==3 passes, `amount`==40 fails.
//     }
//   }
//   // Call: M::apply(main, 0, Transaction::Transfer { to: 3, amount: 40 });
//   // Expected: check_xfer(0, 3, 40) -- `to`=3, `amount`=40.
//   // Actual:   check_xfer(0, 3, 3)  -- `amount` reads first-field slot (3).
//
// This is a different bug from the stack_vm sequential-value-call slot reuse.
// That bug requires a value-returning callee that captures+mutates+returns main.
// This bug is purely in case-payload argument extraction for the 3rd+ variant
// with 2+ payload fields.
//
// Transaction sequence (hand-traced):
//   apply(0, Deposit(100))              acc[0].bal=100
//   apply(1, Deposit(200))              acc[1].bal=200
//   apply(1, Withdraw(80))              acc[1].bal=120
//   apply(2, Freeze)                    acc[2].frozen=1
//   apply(2, Deposit(50))               acc[2] frozen -> skipped
//   apply(0, Transfer(to=3, amount=40)) acc[0].bal=60, acc[3].bal=40  [was the MISCOMPILE site]
//   apply(2, Unfreeze)                  acc[2].frozen=0
//   apply(2, Deposit(30))               acc[2].bal=30
//   apply(1, Query)                     query_count++ only
//   apply(0, Withdraw(20))              acc[0].bal=40
//
// Correct final balances: acc[0]=40, acc[1]=120, acc[2]=30, acc[3]=40, total=230
// Correct checksum: balance_of(0) + balance_of(2) = 40 + 30 = 70 -> exit 70
//
// Exit codes:
//   70  success
//   71  raw acc[0].balance != 40 (the historical Transfer miscompile propagated here)
//   72  raw acc[2].balance != 30
//   73  raw acc[1].balance != 120
//   74  raw acc[3].balance != 40
//   75  balance_of(0) != 40 (value-call read layer)
//   76  balance_of(2) != 30 (value-call read layer)
//   77  balance_of(0)+balance_of(2) != 70 (sequential value-call arithmetic)
//   78  total() != 230
//   91  Transfer sub-state: src (idx) != 0  [probe arm]
//   92  Transfer sub-state: dst (to) != 3   [probe arm]
//   93  Transfer sub-state: amount != 40    [historically fired in native -- amount==3 not 40]
//
// Expected exit: 70.

use omega_language_std::console;

data Transaction {
    case Deposit(amount: i32 in Wrapping);
    case Withdraw(amount: i32 in Wrapping);
    case Transfer(to: i32 in Wrapping, amount: i32 in Wrapping);
    case Freeze;
    case Unfreeze;
    case Query;
}

data Account [copy] {
    balance: i32 in Wrapping;
    frozen: i32 in Wrapping;
}

data Main {
    accounts: [Account; 4];
    query_count: i32 in Wrapping;
    pause: [u8; 256];
}

// ── write helpers: deposit/withdraw per const index ────────────────────────────

machine Main::do_deposit(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
    transition idx == 0 {
        true -> dep0(main, amount)
        _ -> dep_try1(main, idx, amount)
    }
    state dep0(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[0].balance = main.accounts[0].balance + amount;
    }
    state dep_try1(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 1 {
            true -> dep1(main, amount)
            _ -> dep_try2(main, idx, amount)
        }
    }
    state dep1(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[1].balance = main.accounts[1].balance + amount;
    }
    state dep_try2(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 2 {
            true -> dep2(main, amount)
            _ -> dep3(main, amount)
        }
    }
    state dep2(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[2].balance = main.accounts[2].balance + amount;
    }
    state dep3(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[3].balance = main.accounts[3].balance + amount;
    }
}

machine Main::do_withdraw(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
    transition idx == 0 {
        true -> wd0(main, amount)
        _ -> wd_try1(main, idx, amount)
    }
    state wd0(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[0].balance = main.accounts[0].balance - amount;
    }
    state wd_try1(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 1 {
            true -> wd1(main, amount)
            _ -> wd_try2(main, idx, amount)
        }
    }
    state wd1(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[1].balance = main.accounts[1].balance - amount;
    }
    state wd_try2(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 2 {
            true -> wd2(main, amount)
            _ -> wd3(main, amount)
        }
    }
    state wd2(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[2].balance = main.accounts[2].balance - amount;
    }
    state wd3(main: &mut Main, amount: i32 in Wrapping) {
        main.accounts[3].balance = main.accounts[3].balance - amount;
    }
}

machine Main::do_freeze(main: &mut Main, idx: i32 in Wrapping) {
    transition idx == 0 {
        true -> fr0(main)
        _ -> fr_try1(main, idx)
    }
    state fr0(main: &mut Main) { main.accounts[0].frozen = 1; }
    state fr_try1(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> fr1(main)
            _ -> fr_try2(main, idx)
        }
    }
    state fr1(main: &mut Main) { main.accounts[1].frozen = 1; }
    state fr_try2(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> fr2(main)
            _ -> fr3(main)
        }
    }
    state fr2(main: &mut Main) { main.accounts[2].frozen = 1; }
    state fr3(main: &mut Main) { main.accounts[3].frozen = 1; }
}

machine Main::do_unfreeze(main: &mut Main, idx: i32 in Wrapping) {
    transition idx == 0 {
        true -> uf0(main)
        _ -> uf_try1(main, idx)
    }
    state uf0(main: &mut Main) { main.accounts[0].frozen = 0; }
    state uf_try1(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> uf1(main)
            _ -> uf_try2(main, idx)
        }
    }
    state uf1(main: &mut Main) { main.accounts[1].frozen = 0; }
    state uf_try2(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> uf2(main)
            _ -> uf3(main)
        }
    }
    state uf2(main: &mut Main) { main.accounts[2].frozen = 0; }
    state uf3(main: &mut Main) { main.accounts[3].frozen = 0; }
}

// Read frozen flag (value-returning).
machine Main::is_frozen(main: &mut Main, idx: i32 in Wrapping) -> i32 in Wrapping {
    transition idx == 0 {
        true -> (main.accounts[0].frozen)
        _ -> try_f1(main, idx)
    }
    state try_f1(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> (main.accounts[1].frozen)
            _ -> try_f2(main, idx)
        }
    }
    state try_f2(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> (main.accounts[2].frozen)
            _ -> (main.accounts[3].frozen)
        }
    }
}

// ── value-returning: balance_of (capture+mutate main+return) ──────────────────
// The query_count bump lives in the ENTRY (one bump per query, before the
// dispatch): inline value-call ARM bodies run for every arm and re-emit, so a
// per-arm mutation fired 3x per call natively (interp 1x -- unobserved by the
// exit checks until the effectful-arm fence caught it 2026-07-07). Entry
// effects are ordered by the deferral machinery and safe.
machine Main::balance_of(main: &mut Main, idx: i32 in Wrapping) -> i32 in Wrapping {
    main.query_count = main.query_count + 1;
    transition idx == 0 {
        true -> read0(main)
        _ -> try1(main, idx)
    }
    state read0(main: &mut Main) {
        let b: i32 in Wrapping = main.accounts[0].balance;
        transition { _ -> (b) }
    }
    state try1(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> read1(main)
            _ -> try2(main, idx)
        }
    }
    state read1(main: &mut Main) {
        let b: i32 in Wrapping = main.accounts[1].balance;
        transition { _ -> (b) }
    }
    state try2(main: &mut Main, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> read2(main)
            _ -> read3(main)
        }
    }
    state read2(main: &mut Main) {
        let b: i32 in Wrapping = main.accounts[2].balance;
        transition { _ -> (b) }
    }
    state read3(main: &mut Main) {
        let b: i32 in Wrapping = main.accounts[3].balance;
        transition { _ -> (b) }
    }
}

// ── value-returning: sum all four balances ────────────────────────────────────
machine Main::total(main: &mut Main) -> i32 in Wrapping {
    let t: i32 in Wrapping = main.accounts[0].balance
               + main.accounts[1].balance
               + main.accounts[2].balance
               + main.accounts[3].balance;
    transition { _ -> (t) }
}

// ── case dispatcher: apply a transaction to an account index ──────────────────
machine Main::apply(main: &mut Main, idx: i32 in Wrapping, tx: Transaction) reaches Console {
    transition tx {
        Transaction::Deposit { amount } -> check_frozen_dep(main, idx, amount)
        Transaction::Withdraw { amount } -> check_frozen_wd(main, idx, amount)
        Transaction::Transfer { to, amount } -> check_xfer(main, idx, to, amount)
        Transaction::Freeze -> do_freeze_now(main, idx)
        Transaction::Unfreeze -> do_unfreeze_now(main, idx)
        Transaction::Query -> do_query(main)
        _ -> done(main)
    }

    state check_frozen_dep(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        let frozen: i32 in Wrapping = Main::is_frozen(main, idx);
        transition frozen == 0 {
            true -> exec_dep(main, idx, amount)
            _ -> done(main)
        }
    }

    state exec_dep(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        Main::do_deposit(main, idx, amount);
    }

    state check_frozen_wd(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        let frozen: i32 in Wrapping = Main::is_frozen(main, idx);
        transition frozen == 0 {
            true -> exec_wd(main, idx, amount)
            _ -> done(main)
        }
    }

    state exec_wd(main: &mut Main, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        Main::do_withdraw(main, idx, amount);
    }

    // Transfer path: probe the extracted payload fields.
    // In native: `amount` receives the value of `to` (the first payload field).
    state check_xfer(main: &mut Main, idx: i32 in Wrapping, to: i32 in Wrapping, amount: i32 in Wrapping) {
        // Guard chain that exposed the (now-fixed) miscompile:
        // src (=idx) should be 0 for our apply(0, Transfer{...}) call.
        transition idx == 0 {
            true -> xfer_check_to(main, to, amount)
            _ -> xfer_bad_idx(main)
        }
    }

    state xfer_bad_idx(main: &mut Main) {
        Console::write_line("FAIL: Transfer sub-state src idx != 0 -- probe arm (exit 91)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(91);
    }

    state xfer_check_to(main: &mut Main, to: i32 in Wrapping, amount: i32 in Wrapping) {
        // to should be 3.
        transition to == 3 {
            true -> xfer_check_amount(main, to, amount)
            _ -> xfer_bad_to(main)
        }
    }

    state xfer_bad_to(main: &mut Main) {
        Console::write_line("FAIL: Transfer payload field to != 3 -- probe arm (exit 92)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(92);
    }

    state xfer_check_amount(main: &mut Main, to: i32 in Wrapping, amount: i32 in Wrapping) {
        // amount should be 40. In native: amount==3 (same as `to`).
        // Historical MISCOMPILE arm: fired in native (exit 93) while the payload-extraction bug was live; now a regression tripwire.
        transition amount == 40 {
            true -> xfer_do(main, to, amount)
            _ -> xfer_bad_amount(main)
        }
    }

    state xfer_bad_amount(main: &mut Main) {
        Console::write_line("FAIL: Transfer payload field amount != 40 -- historical miscompile tripwire (exit 93)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(93);
    }

    state xfer_do(main: &mut Main, to: i32 in Wrapping, amount: i32 in Wrapping) {
        Main::do_withdraw(main, 0, amount);
        Main::do_deposit(main, to, amount);
    }

    state do_freeze_now(main: &mut Main, idx: i32 in Wrapping) {
        Main::do_freeze(main, idx);
    }

    state do_unfreeze_now(main: &mut Main, idx: i32 in Wrapping) {
        Main::do_unfreeze(main, idx);
    }

    state do_query(main: &mut Main) {
        main.query_count = main.query_count + 1;
    }

    state done(main: &mut Main) {}
}

// ── main: scripted transaction sequence + multi-layer verification ─────────────
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("account_ledger: event-sourced account ledger -- case-payload dispatch, frozen gates, value-call checksums");
    // 10 apply calls. `apply` acknowledges `block` transitively (its failure
    // arms call `block console.read_line`), so each call site repeats it.
    block Main::apply(main, 0, Transaction::Deposit { amount: 100 });
    block Main::apply(main, 1, Transaction::Deposit { amount: 200 });
    block Main::apply(main, 1, Transaction::Withdraw { amount: 80 });
    block Main::apply(main, 2, Transaction::Freeze);
    block Main::apply(main, 2, Transaction::Deposit { amount: 50 });
    block Main::apply(main, 0, Transaction::Transfer { to: 3, amount: 40 });
    block Main::apply(main, 2, Transaction::Unfreeze);
    block Main::apply(main, 2, Transaction::Deposit { amount: 30 });
    block Main::apply(main, 1, Transaction::Query);
    block Main::apply(main, 0, Transaction::Withdraw { amount: 20 });

    // Layer 1: raw field guards (bypass value-call entirely).
    transition main.accounts[0].balance == 40 {
        true -> raw_check_acc2(main)
        _ -> bad_raw0(main)
    }

    state bad_raw0(main: &mut Main) {
        Console::write_line("FAIL: raw acc[0].balance wrong -- expected 40 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state raw_check_acc2(main: &mut Main) {
        transition main.accounts[2].balance == 30 {
            true -> raw_check_acc1(main)
            _ -> bad_raw2(main)
        }
    }

    state bad_raw2(main: &mut Main) {
        Console::write_line("FAIL: raw acc[2].balance wrong -- expected 30 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state raw_check_acc1(main: &mut Main) {
        transition main.accounts[1].balance == 120 {
            true -> raw_check_acc3(main)
            _ -> bad_raw1(main)
        }
    }

    state bad_raw1(main: &mut Main) {
        Console::write_line("FAIL: raw acc[1].balance wrong -- expected 120 (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state raw_check_acc3(main: &mut Main) {
        transition main.accounts[3].balance == 40 {
            true -> vcall_check_b0(main)
            _ -> bad_raw3(main)
        }
    }

    state bad_raw3(main: &mut Main) {
        Console::write_line("FAIL: raw acc[3].balance wrong -- expected 40 (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    // Layer 2: value-call reads (balance_of captures+mutates+returns).
    state vcall_check_b0(main: &mut Main) {
        let b0: i32 in Wrapping = Main::balance_of(main, 0);
        transition b0 == 40 {
            true -> vcall_check_b2(main, b0)
            _ -> bad_vcall0(main)
        }
    }

    state bad_vcall0(main: &mut Main) {
        Console::write_line("FAIL: balance_of(0) value-call read wrong -- expected 40 (exit 75)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(75);
    }

    state vcall_check_b2(main: &mut Main, b0: i32 in Wrapping) {
        let b2: i32 in Wrapping = Main::balance_of(main, 2);
        transition b2 == 30 {
            true -> vcall_check_sum(main, b0, b2)
            _ -> bad_vcall2(main)
        }
    }

    state bad_vcall2(main: &mut Main) {
        Console::write_line("FAIL: balance_of(2) value-call read wrong -- expected 30 (exit 76)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(76);
    }

    // Layer 3: two sequential value-call results combined in arithmetic.
    // balance_of(0) + balance_of(2) = 40 + 30 = 70 (the key checksum).
    // If layers 1-2 pass but this fires, it's a value-call arithmetic miscompile
    // (the stack_vm-style bug -- distinct from the payload-extraction bug above).
    state vcall_check_sum(main: &mut Main, b0: i32 in Wrapping, b2: i32 in Wrapping) {
        let checksum: i32 in Wrapping = b0 + b2;
        transition checksum == 70 {
            true -> check_total(main)
            _ -> bad_sum(main)
        }
    }

    state bad_sum(main: &mut Main) {
        Console::write_line("FAIL: balance_of(0)+balance_of(2) checksum wrong -- expected 70 (exit 77)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(77);
    }

    // Layer 4: total() value-call.
    state check_total(main: &mut Main) {
        let t: i32 in Wrapping = Main::total(main);
        transition t == 230 {
            true -> good(main)
            _ -> bad_total(main)
        }
    }

    state bad_total(main: &mut Main) {
        Console::write_line("FAIL: total() wrong -- expected 230 (exit 78)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(78);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: all 4 balances + value-call checksum 70 + total 230 verified (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
