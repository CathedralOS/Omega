use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Conditional message construction in explicit capacity and live-length fields.
// Expected exit: 70.
// Expected output contains: ALERT temp

use system\Console;

domain [u8; 32]::Ascii requires ascii_only(self);
domain [u8]::Ascii requires ascii_only(self);
data TextBuffer requires used <= 32 { storage: [u8; 32] in Ascii; used: u64; }
machine live(buffer: @TextBuffer) -> @[u8] in Ascii { @buffer.storage[..buffer.used] }
machine copy(buffer: @mutable [u8; 32] in Ascii, bytes: @[u8] in Ascii, start: u64)
requires start <= 32, bytes.length <= 32 - start
ensures buffer in Ascii
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    machine copying(buffer: @mutable [u8; 32] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 32, index <= 32
    ensures buffer in Ascii
    {
        transition index < bytes.length && start + index < 32 {
            true -> writing(buffer, bytes, start, index),
            _ -> done()
        }
    }
    machine writing(buffer: @mutable [u8; 32] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 32, index < 32, index < bytes.length, start + index < 32
    ensures buffer in Ascii
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    machine done() {}
}

domain [u8; 4]::Ascii requires ascii_only(self);

data Main {
    label: [u8; 4] in Ascii;
    message: TextBuffer;
    reading: i32;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("status_report: builds an ALERT/ok status string in conditional arms");
    main.label = "temp";
    main.reading = 95;

    transition main.reading > 90 {
        true -> block high(main),
        _ -> block normal(main)
    }

    machine high(main: @mutable Main) {
        copy(@mutable main.message.storage, "ALERT ", 0);
        copy(@mutable main.message.storage, @main.label, 6);
        main.message.used = 10;
        Console::write_line(live(@main.message));
        transition live(@main.message) == "ALERT temp" { true -> block ok(main), _ -> block bad(main) }
    }

    machine normal(main: @mutable Main) {
        copy(@mutable main.message.storage, "ok ", 0);
        copy(@mutable main.message.storage, @main.label, 3);
        main.message.used = 7;
        Console::write_line(live(@main.message));
        transition live(@main.message) == "ok temp" { true -> block ok(main), _ -> block bad(main) }
    }

    machine ok(main: @mutable Main) {
        Console::write_line("PASS: reading 95 built and verified the ALERT message (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(70);
    }
    machine bad(main: @mutable Main) {
        Console::write_line("FAIL: the concatenated message did not match (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
