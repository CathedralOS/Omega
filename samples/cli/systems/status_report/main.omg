// Build a status message with `[u8; N] in Utf8` text carriers INSIDE conditional
// control flow: depending on the reading, the `high` or `normal` arm concatenates
// a different prefix onto the shared `label` carrier, prints it, and verifies the
// result with `==`. (text_greeting shows a single straight-line concat; this shows
// carrier concatenation composing across transition arms.) With reading 95 > 90 the
// `high` arm builds "ALERT temp", so the program prints it and exits 70.
//
// (Verification uses `==`, a content check stronger than a length check. A
// carrier's `.len` also marshals as a value/host-call operand now -- see the
// runtime_bounded_carrier_length_exit canary.)
// Expected exit: 70.
// Expected output contains: ALERT temp

use omega_language_std::console;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 32]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    label: [u8; 8] in Utf8;
    message: [u8; 32] in Utf8;
    reading: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("status_report: builds an ALERT/ok status string in conditional arms");
    main.label = "temp";
    main.reading = 95;

    transition main.reading > 90 {
        true -> high(main)
        _ -> normal(main)
    }

    state high(main: &mut Main) {
        main.message = "ALERT " + main.label;
        Console::write_line(main.message);
        transition main.message == "ALERT temp" { true -> ok(main) _ -> bad(main) }
    }

    state normal(main: &mut Main) {
        main.message = "ok " + main.label;
        Console::write_line(main.message);
        transition main.message == "ok temp" { true -> ok(main) _ -> bad(main) }
    }

    state ok(main: &mut Main) {
        Console::write_line("PASS: reading 95 built and verified the ALERT message (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: the concatenated message did not match (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
