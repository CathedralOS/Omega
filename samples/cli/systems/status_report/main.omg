// Conditional message construction in explicit capacity and live-length fields.
// Expected exit: 70.
// Expected output contains: ALERT temp

use omega_language_std::console;

domain [u8; 32]::Ascii(bytes) requires ascii_only(bytes);
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
data TextBuffer where used <= 32 { storage: [u8; 32] in Ascii; used: u64; }
machine live(buffer: &TextBuffer) -> &[u8] in Ascii { &buffer.storage[..buffer.used] }
machine copy(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64)
requires start <= 32; bytes.len <= 32 - start
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    state copying(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 32; index <= 32
    {
        transition index < bytes.len && start + index < 32 {
            true -> writing(buffer, bytes, start, index)
            _ -> done()
        }
    }
    state writing(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 32; index < 32; index < bytes.len; start + index < 32
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    state done() {}
}

domain [u8; 4]::Ascii(bytes) requires ascii_only(bytes);

data Main {
    label: [u8; 4] in Ascii;
    message: TextBuffer;
    reading: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("status_report: builds an ALERT/ok status string in conditional arms");
    main.label = "temp";
    main.reading = 95;

    transition main.reading > 90 {
        true -> high(main)
        _ -> normal(main)
    }

    state high(main: &mut Main) {
        copy(&mut main.message.storage, "ALERT ", 0);
        copy(&mut main.message.storage, &main.label, 6);
        main.message.used = 10;
        Console::write_line(live(&main.message));
        transition live(&main.message) == "ALERT temp" { true -> ok(main) _ -> bad(main) }
    }

    state normal(main: &mut Main) {
        copy(&mut main.message.storage, "ok ", 0);
        copy(&mut main.message.storage, &main.label, 3);
        main.message.used = 7;
        Console::write_line(live(&main.message));
        transition live(&main.message) == "ok temp" { true -> ok(main) _ -> bad(main) }
    }

    state ok(main: &mut Main) {
        Console::write_line("PASS: reading 95 built and verified the ALERT message (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: the concatenated message did not match (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
