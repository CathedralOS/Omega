// elapsed_timer: times a real workload with std::time -- the first full
// consumer of the Instant/Time surface (TASKS_TIME.md rung 8).
//
// Chain: Time::now() captures a start Instant; Time::sleep_for sleeps a
// 50ms Duration (the workload -- returns the clamped millisecond request);
// Time::elapsed_since reads the stopwatch; Duration::checked_as_milliseconds
// totals it; the total renders zero-padded into a console line
// ("elapsed milliseconds: 00050"-shaped; real clocks may overshoot).
//
// The exit code proves the elapsed->sleep chain: elapsed must be at least
// the 50ms the workload slept (the interpreter's virtual clock makes it
// exactly 50; a real clock is >= 50). Exit 70 on success; 1 = sleep_for
// returned the wrong request; 2 = elapsed under the sleep; 3 = the
// millisecond total overflowed (impossible for a fresh stopwatch).
//
// Expected exit: 70.

use omega_language_std::console;
use omega_language_std::time;

// Text carriers are byte arrays in the Utf8 domain (declared per storage
// type; encodings are library, not intrinsics).
domain [u8; 27]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 10]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    time: Time;
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("elapsed_timer: times a 50ms workload with std::time");
    let start: Instant = Time::now(&mut context.time);
    let pause: Duration = Duration { seconds: 0, subsecond_nanoseconds: 50000000 };
    let slept: u32 = block Time::sleep_for(&mut context.time, pause);
    transition slept == 50 {
        true -> read_elapsed(context, start)
        false -> fail_request(context)
    }
    state read_elapsed(context: &mut Main, start: Instant) {
        let elapsed: Duration = Time::elapsed_since(&mut context.time, start);
        let total_result: TotalResult = Duration::checked_as_milliseconds(&elapsed);
        transition total_result {
            TotalResult::Ok { total } -> render(context, total)
            TotalResult::Overflow -> fail_overflow(context)
        }
    }
    state render(context: &mut Main, milliseconds: u64) {
        let digits: [u8; 10] in Utf8 = "0123456789";
        let mut line: [u8; 27] in Utf8 = "elapsed milliseconds: 00000";
        let ten_thousands: u64 = (milliseconds / 10000) % 10;
        let thousands: u64 = (milliseconds / 1000) % 10;
        let hundreds: u64 = (milliseconds / 100) % 10;
        let tens: u64 = (milliseconds / 10) % 10;
        let ones: u64 = milliseconds % 10;
        line[22] = digits[ten_thousands];
        line[23] = digits[thousands];
        line[24] = digits[hundreds];
        line[25] = digits[tens];
        line[26] = digits[ones];
        Console::write_line(line);
        transition milliseconds >= 50 {
            true -> good(context)
            false -> fail_elapsed(context)
        }
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state fail_request(context: &mut Main) { Console::exit_process(1); }
    state fail_elapsed(context: &mut Main) { Console::exit_process(2); }
    state fail_overflow(context: &mut Main) { Console::exit_process(3); }
}
