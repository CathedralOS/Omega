use omega::language::core::ProcessExit;
// elapsed_timer: times a real workload with std::time -- the first full
// consumer of the Instant and clock-read surface (TASKS_TIME.md rung 8).
//
// Chain: instant_now() captures a start Instant; sleep_for sleeps a
// 50ms Duration (the workload -- returns the clamped millisecond request);
// elapsed_since reads the stopwatch; duration_checked_as_milliseconds
// totals it; the total renders zero-padded into a console line
// ("elapsed milliseconds: 00050"-shaped; real clocks may overshoot).
//
// The exit code proves the elapsed->sleep chain: elapsed must be at least
// the 50ms the workload slept (the interpreter's virtual clock makes it
// exactly 50; a real clock is >= 50). Exit 70 on success; 1 = sleep_for
// returned the wrong request; 2 = elapsed under the sleep; 3 = the
// millisecond total overflowed (impossible for a fresh stopwatch).
//
// Expected exit: 70.

use omega_language_std::Console;
use omega_language_std::Duration;
use omega_language_std::Instant;
use omega_language_std::TotalResult;
use omega_language_std::duration_checked_as_milliseconds;
use omega_language_std::elapsed_since;
use omega_language_std::instant_now;
use omega_language_std::sleep_for;

data Main {
}

machine main(context: &mut Main) reaches ProcessExit + Console {
    Console::write_line("elapsed_timer: times a 50ms workload with std::time");
    let start: Instant = instant_now();
    let pause: Duration = Duration { seconds: 0, subsecond_nanoseconds: 50000000 };
    let slept: u32 = block sleep_for(pause);
    transition slept == 50 {
        true -> read_elapsed(context, start)
        false -> fail_request(context)
    }
    machine read_elapsed(context: &mut Main, start: Instant) {
        let elapsed: Duration = elapsed_since(start);
        let total_result: TotalResult = duration_checked_as_milliseconds(&elapsed);
        transition total_result {
            TotalResult::Ok { total } -> render(context, total)
            TotalResult::Overflow -> fail_overflow(context)
        }
    }
    machine render(context: &mut Main, milliseconds: u64) {
        let digits: [u8; 10] = "0123456789";
        let mut line: [u8; 27] = "elapsed milliseconds: 00000";
        let ten_thousands: u64 = (milliseconds / 10000) % 10;
        let thousands: u64 = (milliseconds / 1000) % 10;
        let hundreds: u64 = (milliseconds / 100) % 10;
        let tens: u64 = (milliseconds / 10) % 10;
        let ones: u64 = milliseconds % 10;
        line[22] = digits[ten_thousands];
        line[23] = digits[thousands];
        line[24] = digits[hundreds];
        line[25] = digits[tens];
        line[26] = digits[ones];
        Console::write_line(line);
        transition milliseconds >= 50 {
            true -> good(context)
            false -> fail_elapsed(context)
        }
    }
    machine good(context: &mut Main) { ProcessExit::exit_process(70); }
    machine fail_request(context: &mut Main) { ProcessExit::exit_process(1); }
    machine fail_elapsed(context: &mut Main) { ProcessExit::exit_process(2); }
    machine fail_overflow(context: &mut Main) { ProcessExit::exit_process(3); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    block main(&mut entry_storage);
}
