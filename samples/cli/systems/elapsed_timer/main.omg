use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
use {system}/time.omg;
use {system}/time_host.omg;
// elapsed_timer: times a real workload with {system}/time.omg -- the first full
// consumer of the Instant and clock-read surface (TASKS_TIME.md rung 8).
//
// Chain: instant_now() captures a start Instant; sleep_for sleeps a
// 50ms Duration (the workload -- returns the clamped millisecond request);
// elapsed_since reads the stopwatch; duration_checked_as_milliseconds
// totals it; the total renders zero-padded into a console line
// ("elapsed milliseconds: 00050"-shaped; real clocks may overshoot).
//
// The exit code proves the elapsed->sleep chain: elapsed must be at least
// the 50ms the workload slept (the interpreter's virtual clock makes it
// exactly 50; a real clock is >= 50). Exit 70 on success; 1 = sleep_for
// returned the wrong request; 2 = elapsed under the sleep; 3 = the
// millisecond total overflowed (impossible for a fresh stopwatch).
//
// Expected exit: 70.


data Main {
}

machine main(context: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput + |time_host|::TimeHost {
    |console|::Console::write_line("elapsed_timer: times a 50ms workload with system::time");
    let start: |time|::Instant = |time|::instant_now();
    let pause: |time|::Duration = |time|::Duration { seconds: 0, subsecond_nanoseconds: 50000000 };
    let slept: u32 = block |time|::sleep_for(pause);
    transition slept == 50 {
        true -> read_elapsed(context, start),
        false -> fail_request(context)
    }
    machine read_elapsed(context: @mutable Main, start: |time|::Instant) {
        let elapsed: |time|::Duration = |time|::elapsed_since(start);
        let total_result: |time|::TotalResult = |time|::duration_checked_as_milliseconds(@elapsed);
        transition total_result {
            |time|::TotalResult::Ok { total } -> render(context, total),
            |time|::TotalResult::Overflow -> fail_overflow(context)
        }
    }
    machine render(context: @mutable Main, milliseconds: u64) {
        let digits: [u8; 10] = "0123456789";
        let mutable line: [u8; 27] = "elapsed milliseconds: 00000";
        let ten_thousands: u64 = (milliseconds / 10000) % 10;
        let thousands: u64 = (milliseconds / 1000) % 10;
        let hundreds: u64 = (milliseconds / 100) % 10;
        let tens: u64 = (milliseconds / 10) % 10;
        let ones: u64 = milliseconds % 10;
        line[22] = digits[ten_thousands];
        line[23] = digits[thousands];
        line[24] = digits[hundreds];
        line[25] = digits[tens];
        line[26] = digits[ones];
        |console|::Console::write_line(@line[..]);
        transition milliseconds >= 50 {
            true -> good(context),
            false -> fail_elapsed(context)
        }
    }
    machine good(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(70); }
    machine fail_request(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(1); }
    machine fail_elapsed(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(2); }
    machine fail_overflow(context: @mutable Main) { |process_exit|::ProcessExit::exit_process(3); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput + |time_host|::TimeHost {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
