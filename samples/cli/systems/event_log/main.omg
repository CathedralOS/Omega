// Event log: case-payload events updating nested struct state across multiple
// sub-machine calls.
//
// Exercises: case-payload dispatch (3 variants with different payloads),
// nested struct field updates (main.log.stats.deposits etc.), multi-arm
// transitions mixed with equality guards, and accumulation across repeated
// machine calls.
//
// Data model:
//   Stats [copy] { deposits: i32 in Saturating; withdrawals: i32 in Saturating; balance: i32 in Saturating; }
//   Log   [copy] { stats: Stats; event_count: i32 in Saturating; }
//
// Event variants:
//   Deposit(amount: i32 in Saturating)    -- add to balance, increment deposits
//   Withdraw(amount: i32 in Saturating)   -- subtract from balance, increment withdrawals
//   Reset                   -- zero the balance, keep counts
//
// Scripted:
//   Deposit(100)  -> balance=100, deposits=1
//   Deposit(50)   -> balance=150, deposits=2
//   Withdraw(30)  -> balance=120, withdrawals=1
//   Deposit(20)   -> balance=140, deposits=3
//   Withdraw(70)  -> balance=70,  withdrawals=2
//
// Final: balance=70, deposits=3, withdrawals=2, event_count=5.
// total = balance + (deposits - withdrawals) * 0 + 0 = balance = 70.
// Exit 70 iff balance==70 AND deposits==3 AND withdrawals==2 AND event_count==5.
//
// Expected exit: 70.

use omega_language_std::console;
use omega::language::core::binding;

data Event {
    case Deposit(amount: i32 in Saturating);
    case Withdraw(amount: i32 in Saturating);
    case Reset;
}

data Stats [copy] {
    deposits: i32 in Saturating;
    withdrawals: i32 in Saturating;
    balance: i32 in Saturating;
}

data Log [copy] {
    stats: Stats;
    event_count: i32 in Saturating;
}

data Main {
    console: Binding<Console>;
    log: Log;
    pause: [u8; 256];
}

machine Main::apply(main: &mut Main, event: Event) {
    main.log.event_count = main.log.event_count + 1;
    transition event {
        Event::Deposit { amount } -> do_deposit(main, amount)
        Event::Withdraw { amount } -> do_withdraw(main, amount)
        Event::Reset -> do_reset(main)
        _ -> done()
    }

    state do_deposit(main: &mut Main, amount: i32 in Saturating) {
        main.log.stats.balance = main.log.stats.balance + amount;
        main.log.stats.deposits = main.log.stats.deposits + 1;
    }

    state do_withdraw(main: &mut Main, amount: i32 in Saturating) {
        main.log.stats.balance = main.log.stats.balance - amount;
        main.log.stats.withdrawals = main.log.stats.withdrawals + 1;
    }

    state do_reset(main: &mut Main) {
        main.log.stats.balance = 0;
    }

    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    main.console.write_line("event_log: case-payload events folding deposits/withdrawals into nested stats");
    Main::apply(main, Event::Deposit { amount: 100 });
    Main::apply(main, Event::Deposit { amount: 50 });
    Main::apply(main, Event::Withdraw { amount: 30 });
    Main::apply(main, Event::Deposit { amount: 20 });
    Main::apply(main, Event::Withdraw { amount: 70 });

    // Verify balance == 70.
    transition main.log.stats.balance == 70 {
        true -> check_deposits(main)
        _ -> bad_balance(main)
    }

    state bad_balance(main: &mut Main) {
        main.console.write_line("FAIL: wrong final balance (exit 71)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(71);
    }

    state check_deposits(main: &mut Main) {
        transition main.log.stats.deposits == 3 {
            true -> check_withdrawals(main)
            _ -> bad_deposits(main)
        }
    }

    state bad_deposits(main: &mut Main) {
        main.console.write_line("FAIL: wrong deposit count (exit 72)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(72);
    }

    state check_withdrawals(main: &mut Main) {
        transition main.log.stats.withdrawals == 2 {
            true -> check_count(main)
            _ -> bad_withdrawals(main)
        }
    }

    state bad_withdrawals(main: &mut Main) {
        main.console.write_line("FAIL: wrong withdrawal count (exit 73)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(73);
    }

    state check_count(main: &mut Main) {
        transition main.log.event_count == 5 {
            true -> good(main)
            _ -> bad_count(main)
        }
    }

    state bad_count(main: &mut Main) {
        main.console.write_line("FAIL: wrong event count (exit 74)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(74);
    }

    state good(main: &mut Main) {
        main.console.write_line("PASS: balance=70, deposits=3, withdrawals=2, events=5 (exit 70)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(70);
    }
}
