// A note-vault workflow over the ERGONOMIC `Filesystem` wrapper -- the
// result-enum / `File` layer (Rust std::fs parity), native-correct end to
// end: create_dir_all (deep vault directory), create_new (exclusive create),
// append (OpenOptions append semantics), metadata_path (payload-carrying
// result), read_all, open_with { write, truncate } (the per-call-site
// composed flag word), copy (binary-safe), read_dir_count (the dispatched
// dir walker), remove, and remove_dir_all (the iterative dirfd-stack drain)
// -- the full wrapper surface including the dir-walk family (native since
// 2026-07-09), plus the fs<->time BRIDGE (2026-07-10j): the vault's
// Metadata.modified_secs rides SystemTime::from_unix_seconds and compares
// against Time::system_time_now() -- the user-facing spelling of the
// runtime_fs_mtime_system_time_interop_exit canary. The `file_journal` sample
// complements it with a shorter portable create/read/rename/remove loop.
//
// Every step must succeed; the program tallies the fourteen verified steps
// and exits with that count (a partial failure exits with fewer than 14).
//
// Expected exit: 14.

use omega_language_std::filesystem;
use omega_language_std::time;

use omega_language_std::console;

data Main {
    fs: Filesystem;
    time: Time;
}

machine Main::main(context: &mut Main) reaches Console {
    let passed: i32 in Wrapping = 0;
    // 1. The vault lives in a DEEP directory (create_dir_all's dispatched
    // mkall walkers).
    let unit_result: UnitResult = Filesystem::create_dir_all(&mut context.fs, "omega_vault/notes/current");
    transition unit_result { UnitResult::Ok -> vault_file(context, passed) _ -> done(context, passed) }

    state vault_file(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 2. Exclusive create: the vault file must not already exist.
        let open_result: OpenResult = Filesystem::create_new(&mut context.fs, "omega_vault/notes/current/vault.txt");
        transition open_result { OpenResult::Ok { file } -> header(context, next_passed, file) _ -> done(context, next_passed) }
    }

    state header(context: &mut Main, passed: i32 in Wrapping, file: File) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 2. Header line.
        let io_result: IoResult = Filesystem::write(&mut context.fs, file, "vault v1\n");
        let close_result: UnitResult = Filesystem::close(&mut context.fs, file);
        transition io_result { IoResult::Ok { count } -> note1(context, next_passed) _ -> done(context, next_passed) }
    }

    state note1(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 3. First note appends at EOF.
        let open_result: OpenResult = Filesystem::append(&mut context.fs, "omega_vault/notes/current/vault.txt");
        transition open_result { OpenResult::Ok { file } -> note1_write(context, next_passed, file) _ -> done(context, next_passed) }
    }
    state note1_write(context: &mut Main, passed: i32 in Wrapping, file: File) {
        let io_result: IoResult = Filesystem::write(&mut context.fs, file, "note: alpha\n");
        let close_result: UnitResult = Filesystem::close(&mut context.fs, file);
        transition io_result { IoResult::Ok { count } -> note2(context, passed) _ -> done(context, passed) }
    }

    state note2(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 4. Second note.
        let open_result: OpenResult = Filesystem::append(&mut context.fs, "omega_vault/notes/current/vault.txt");
        transition open_result { OpenResult::Ok { file } -> note2_write(context, next_passed, file) _ -> done(context, next_passed) }
    }
    state note2_write(context: &mut Main, passed: i32 in Wrapping, file: File) {
        let io_result: IoResult = Filesystem::write(&mut context.fs, file, "note: beta\n");
        let close_result: UnitResult = Filesystem::close(&mut context.fs, file);
        transition io_result { IoResult::Ok { count } -> audit(context, passed) _ -> done(context, passed) }
    }

    state audit(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 5. The vault's length is the three lines: 9 + 12 + 11 = 32.
        let meta_result: MetadataResult = Filesystem::metadata_path(&mut context.fs, "omega_vault/notes/current/vault.txt");
        transition meta_result { MetadataResult::Ok { meta } -> audit_len(context, next_passed, meta) _ -> done(context, next_passed) }
    }
    state audit_len(context: &mut Main, passed: i32 in Wrapping, meta: Metadata) {
        transition meta.len == 32 { true -> audit_time(context, passed, meta) _ -> done(context, passed) }
    }

    state audit_time(context: &mut Main, passed: i32 in Wrapping, meta: Metadata) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 8. The vault's modified time BRIDGES into std::time: a just-written
        // file is never in the future, so duration_since(now) must be Ok.
        let modified: SystemTime = SystemTime::from_unix_seconds(meta.modified_secs);
        let now_keep: SystemTime = Time::system_time_now(&mut context.time);
        let diff: SystemTimeDifference = SystemTime::duration_since(&now_keep, modified);
        transition diff {
            SystemTimeDifference::Ok { duration } -> audit_time_gap(context, next_passed, duration)
            _ -> done(context, next_passed)
        }
    }
    state audit_time_gap(context: &mut Main, passed: i32 in Wrapping, duration: Duration) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 9. The gap is sane on BOTH engines: native ~0s (just written);
        // interp ~767M s (virtual 2001 mtime vs virtual 2026 clock). A
        // garbage decode blows the 10^9 bound.
        transition duration.seconds < 1000000000 { true -> readback(context, next_passed) _ -> done(context, next_passed) }
    }

    state readback(context: &mut Main, passed: i32 in Wrapping) {
        let mut back: [u8; 64];
        let next_passed: i32 in Wrapping = passed + 1;
        // 8. Read back and spot-check first ('v') and last ('\n' = 10) bytes.
        let io_result: IoResult = Filesystem::read_all(&mut context.fs, "omega_vault/notes/current/vault.txt", &mut back, 64);
        transition io_result { IoResult::Ok { count } -> readback_ck(context, next_passed, count, back[0]) _ -> done(context, next_passed) }
    }
    state readback_ck(context: &mut Main, passed: i32 in Wrapping, count: u64, head: u8) {
        transition count == 32 { true -> readback_head(context, passed, head) _ -> done(context, passed) }
    }
    state readback_head(context: &mut Main, passed: i32 in Wrapping, head: u8) {
        transition head == 118 { true -> compact(context, passed) _ -> done(context, passed) }
    }

    state compact(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 9. Compact: truncate-rewrite keeps only the header (open_with's
        // composed write+truncate word).
        let opts: OpenOptions = OpenOptions { write: true, truncate: true };
        let open_result: OpenResult = Filesystem::open_with(&mut context.fs, "omega_vault/notes/current/vault.txt", opts);
        transition open_result { OpenResult::Ok { file } -> compact_write(context, next_passed, file) _ -> done(context, next_passed) }
    }
    state compact_write(context: &mut Main, passed: i32 in Wrapping, file: File) {
        let io_result: IoResult = Filesystem::write(&mut context.fs, file, "vault v1\n");
        let close_result: UnitResult = Filesystem::close(&mut context.fs, file);
        let meta_result: MetadataResult = Filesystem::metadata_path(&mut context.fs, "omega_vault/notes/current/vault.txt");
        transition meta_result { MetadataResult::Ok { meta } -> compact_ck(context, passed, meta) _ -> done(context, passed) }
    }
    state compact_ck(context: &mut Main, passed: i32 in Wrapping, meta: Metadata) {
        transition meta.len == 9 { true -> backup(context, passed) _ -> done(context, passed) }
    }

    state backup(context: &mut Main, passed: i32 in Wrapping) {
        let mut scratch: [u8; 64];
        let next_passed: i32 in Wrapping = passed + 1;
        // 10. Snapshot the compacted vault.
        let io_result: IoResult = Filesystem::copy(&mut context.fs, "omega_vault/notes/current/vault.txt", "omega_vault/notes/current/vault.bak", &mut scratch, 64);
        transition io_result { IoResult::Ok { count } -> backup_ck(context, next_passed, count) _ -> done(context, next_passed) }
    }
    state backup_ck(context: &mut Main, passed: i32 in Wrapping, count: u64) {
        transition count == 9 { true -> cleanup(context, passed) _ -> done(context, passed) }
    }

    state cleanup(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 12. Audit the vault directory: exactly the file + its backup.
        let io_result: IoResult = Filesystem::read_dir_count(&mut context.fs, "omega_vault/notes/current");
        transition io_result { IoResult::Ok { count } -> audit_dir(context, next_passed, count) _ -> done(context, next_passed) }
    }
    state audit_dir(context: &mut Main, passed: i32 in Wrapping, count: u64) {
        transition count == 2 { true -> remove_one(context, passed) _ -> done(context, passed) }
    }
    state remove_one(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 13. Remove one file the precise way...
        let unit_result: UnitResult = Filesystem::remove(&mut context.fs, "omega_vault/notes/current/vault.txt");
        transition unit_result { UnitResult::Ok -> teardown(context, next_passed) _ -> done(context, next_passed) }
    }
    state teardown(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 14. ...and drain the whole tree the sweeping way (the iterative
        // dirfd-stack remove_dir_all), backup and directories included.
        let unit_result: UnitResult = Filesystem::remove_dir_all(&mut context.fs, "omega_vault");
        transition unit_result { UnitResult::Ok -> ck_gone(context, next_passed) _ -> done(context, next_passed) }
    }
    state ck_gone(context: &mut Main, passed: i32 in Wrapping) {
        let present: bool = Filesystem::exists(&mut context.fs, "omega_vault");
        transition present { true -> done(context, passed) _ -> finish(context, passed) }
    }
    state finish(context: &mut Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        transition true { true -> done(context, next_passed) _ -> done(context, next_passed) }
    }

    state done(context: &mut Main, passed: i32 in Wrapping) { Console::exit_process(passed as i32); }
}
