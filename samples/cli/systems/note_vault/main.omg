// A note-vault workflow over the ERGONOMIC `Filesystem` wrapper -- the
// result-enum / `File` layer (Rust std::fs parity), native-correct end to
// end: create_dir_all (deep vault directory), create_new (exclusive create),
// append (OpenOptions append semantics), metadata_path (payload-carrying
// result), read_all, open_with { write, truncate } (the per-call-site
// composed flag word), copy (binary-safe), read_dir_count (the dispatched
// dir walker), remove, and remove_dir_all (the iterative dirfd-stack drain)
// -- the full wrapper surface including the dir-walk family (native since
// 2026-07-09), plus the fs<->time BRIDGE (2026-07-10j): the vault's
// Metadata.modified_secs rides SystemTime::from_unix_seconds and compares
// against Time::system_time_now() -- the user-facing spelling of the
// runtime_fs_mtime_system_time_interop_exit canary. The `file_journal` sample
// complements it by mixing portable open/create semantics with format-neutral
// raw boundary operations.
//
// Every step must succeed; the program tallies the fourteen verified steps
// and exits with that count (a partial failure exits with fewer than 14).
//
// Expected exit: 14.

use omega_language_std::filesystem;
use omega_language_std::filesystem_host;
use omega_language_std::time;

use omega_language_std::console;

data Main {
    console: Console;
    fs: Filesystem;
    open_result: OpenResult;
    io_result: IoResult;
    unit_result: UnitResult;
    meta_result: MetadataResult;
    time: Time;
    modified: SystemTime;
    now_keep: SystemTime;
    diff: SystemTimeDifference;
    file_fd: i32;
    close_rc: i32;
    present: bool;
    // Step tally 0..=14 (`in Wrapping` discharges the exact-arith obligation on
    // `+ 1`; the value never nears the i32 range).
    passed: i32 in Wrapping;
    back: [u8; 64];
    scratch: [u8; 64];
}

machine Main::main(&mut self) {
    // 1. The vault lives in a DEEP directory (create_dir_all's dispatched
    // mkall walkers).
    self.unit_result = self.fs.create_dir_all("omega_vault/notes/current");
    transition self.unit_result { UnitResult::Ok -> vault_file() _ -> done() }

    state vault_file(&mut self) {
        self.passed = self.passed + 1;
        // 2. Exclusive create: the vault file must not already exist.
        self.open_result = self.fs.create_new("omega_vault/notes/current/vault.txt");
        transition self.open_result { OpenResult::Ok { file } -> header(file) _ -> done() }
    }

    state header(&mut self, file: File) {
        self.passed = self.passed + 1;
        self.file_fd = file.fd;
        // 2. Header line.
        self.io_result = self.fs.write(File { fd: self.file_fd }, "vault v1\n");
        self.close_rc = self.fs.close(File { fd: self.file_fd });
        transition self.io_result { IoResult::Ok { count } -> note1() _ -> done() }
    }

    state note1(&mut self) {
        self.passed = self.passed + 1;
        // 3. First note appends at EOF.
        self.open_result = self.fs.append("omega_vault/notes/current/vault.txt");
        transition self.open_result { OpenResult::Ok { file } -> note1_write(file) _ -> done() }
    }
    state note1_write(&mut self, file: File) {
        self.file_fd = file.fd;
        self.io_result = self.fs.write(File { fd: self.file_fd }, "note: alpha\n");
        self.close_rc = self.fs.close(File { fd: self.file_fd });
        transition self.io_result { IoResult::Ok { count } -> note2() _ -> done() }
    }

    state note2(&mut self) {
        self.passed = self.passed + 1;
        // 4. Second note.
        self.open_result = self.fs.append("omega_vault/notes/current/vault.txt");
        transition self.open_result { OpenResult::Ok { file } -> note2_write(file) _ -> done() }
    }
    state note2_write(&mut self, file: File) {
        self.file_fd = file.fd;
        self.io_result = self.fs.write(File { fd: self.file_fd }, "note: beta\n");
        self.close_rc = self.fs.close(File { fd: self.file_fd });
        transition self.io_result { IoResult::Ok { count } -> audit() _ -> done() }
    }

    state audit(&mut self) {
        self.passed = self.passed + 1;
        // 5. The vault's length is the three lines: 9 + 12 + 11 = 32.
        self.meta_result = self.fs.metadata_path("omega_vault/notes/current/vault.txt");
        transition self.meta_result { MetadataResult::Ok { meta } -> audit_len(meta) _ -> done() }
    }
    state audit_len(&mut self, meta: Metadata) {
        transition meta.len == 32 { true -> audit_time(meta) _ -> done() }
    }

    state audit_time(&mut self, meta: Metadata) {
        self.passed = self.passed + 1;
        // 8. The vault's modified time BRIDGES into std::time: a just-written
        // file is never in the future, so duration_since(now) must be Ok.
        self.modified = SystemTime::from_unix_seconds(meta.modified_secs);
        self.now_keep = self.time.system_time_now();
        // Direct call on the non-first SystemTime field (per-instance
        // receivers, 2026-07-10t).
        self.diff = self.now_keep.duration_since(self.modified);
        transition self.diff {
            SystemTimeDifference::Ok { duration } -> audit_time_gap(duration)
            _ -> done()
        }
    }
    state audit_time_gap(&mut self, duration: Duration) {
        self.passed = self.passed + 1;
        // 9. The gap is sane on BOTH engines: native ~0s (just written);
        // interp ~767M s (virtual 2001 mtime vs virtual 2026 clock). A
        // garbage decode blows the 10^9 bound.
        transition duration.seconds < 1000000000 { true -> readback() _ -> done() }
    }

    state readback(&mut self) {
        self.passed = self.passed + 1;
        // 8. Read back and spot-check first ('v') and last ('\n' = 10) bytes.
        self.io_result = self.fs.read_all("omega_vault/notes/current/vault.txt", &mut self.back, 64);
        transition self.io_result { IoResult::Ok { count } -> readback_ck(count) _ -> done() }
    }
    state readback_ck(&mut self, count: u64) {
        transition count == 32 { true -> readback_head() _ -> done() }
    }
    state readback_head(&mut self) {
        transition self.back[0] == 118 { true -> compact() _ -> done() }
    }

    state compact(&mut self) {
        self.passed = self.passed + 1;
        // 9. Compact: truncate-rewrite keeps only the header (open_with's
        // composed write+truncate word).
        let opts: OpenOptions = OpenOptions { write: true, truncate: true };
        self.open_result = self.fs.open_with("omega_vault/notes/current/vault.txt", opts);
        transition self.open_result { OpenResult::Ok { file } -> compact_write(file) _ -> done() }
    }
    state compact_write(&mut self, file: File) {
        self.file_fd = file.fd;
        self.io_result = self.fs.write(File { fd: self.file_fd }, "vault v1\n");
        self.close_rc = self.fs.close(File { fd: self.file_fd });
        self.meta_result = self.fs.metadata_path("omega_vault/notes/current/vault.txt");
        transition self.meta_result { MetadataResult::Ok { meta } -> compact_ck(meta) _ -> done() }
    }
    state compact_ck(&mut self, meta: Metadata) {
        transition meta.len == 9 { true -> backup() _ -> done() }
    }

    state backup(&mut self) {
        self.passed = self.passed + 1;
        // 10. Snapshot the compacted vault.
        self.io_result = self.fs.copy("omega_vault/notes/current/vault.txt", "omega_vault/notes/current/vault.bak", &mut self.scratch, 64);
        transition self.io_result { IoResult::Ok { count } -> backup_ck(count) _ -> done() }
    }
    state backup_ck(&mut self, count: u64) {
        transition count == 9 { true -> cleanup() _ -> done() }
    }

    state cleanup(&mut self) {
        self.passed = self.passed + 1;
        // 12. Audit the vault directory: exactly the file + its backup.
        self.io_result = self.fs.read_dir_count("omega_vault/notes/current");
        transition self.io_result { IoResult::Ok { count } -> audit_dir(count) _ -> done() }
    }
    state audit_dir(&mut self, count: u64) {
        transition count == 2 { true -> remove_one() _ -> done() }
    }
    state remove_one(&mut self) {
        self.passed = self.passed + 1;
        // 13. Remove one file the precise way...
        self.unit_result = self.fs.remove("omega_vault/notes/current/vault.txt");
        transition self.unit_result { UnitResult::Ok -> teardown() _ -> done() }
    }
    state teardown(&mut self) {
        self.passed = self.passed + 1;
        // 14. ...and drain the whole tree the sweeping way (the iterative
        // dirfd-stack remove_dir_all), backup and directories included.
        self.unit_result = self.fs.remove_dir_all("omega_vault");
        transition self.unit_result { UnitResult::Ok -> ck_gone() _ -> done() }
    }
    state ck_gone(&mut self) {
        self.present = self.fs.exists("omega_vault");
        transition self.present { true -> done() _ -> finish() }
    }
    state finish(&mut self) {
        self.passed = self.passed + 1;
        transition true { true -> done() _ -> done() }
    }

    state done(&mut self) { self.console.exit_process(self.passed as i32); }
}
