use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/process_exit.omg as process;
use {system}/filesystem.omg as fs;
use {system}/filesystem_host.omg as paths;
use {system}/time.omg;
use {system}/time_host.omg as clock_host;

// A note-vault workflow over the ERGONOMIC `Filesystem` surface -- the
// result-enum / `File` layer (Rust system::fs parity), native-correct end to
// end: create_dir_all (deep vault directory), create_new (exclusive create),
// append (OpenOptions append semantics), metadata_path (payload-carrying
// result), read_all, open_with { write, truncate } (the per-call-site
// composed flag word), copy (binary-safe), read_dir_count (the dispatched
// dir walker), remove, and remove_dir_all (the iterative dirfd-stack drain)
// -- the full wrapper surface including the dir-walk family (native since
// 2026-07-09), plus the fs<->time BRIDGE (2026-07-10j): the vault's
// Metadata.modified_secs rides system_time_from_unix_seconds and compares
// against system_time_now() -- the user-facing spelling of the
// runtime_fs_mtime_system_time_interop_exit canary. The `file_journal` sample
// complements it with a shorter portable create/read/rename/remove loop.
//
// Every step must succeed; the program tallies the fourteen verified steps
// and exits with that count (a partial failure exits with fewer than 14).
//
// Expected exit: 14.



data Main {
}

machine main(context: @mutable Main)
blocks
reaches |process|::ProcessExit + |authority|::DirectoryEnumeration + |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemMetadataQuery + |authority|::FilesystemNamespaceMutation + |clock_host|::TimeHost {
    let passed: i32 in Wrapping = 0 as +Wrapping;
    // 1. The vault lives in a DEEP directory (create_dir_all's dispatched
    // mkall walkers).
    let unit_result: |fs|::UnitResult = block |fs|::Filesystem::create_dir_all("omega_vault/notes/current" as + |paths|::Path);
    transition unit_result { |fs|::UnitResult::Ok -> block vault_file(context, passed), _ -> done(context, passed) }

    machine vault_file(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 2. Exclusive create: the vault file must not already exist.
        let open_result: |fs|::OpenResult = block |fs|::Filesystem::create_new("omega_vault/notes/current/vault.txt" as + |paths|::Path);
        transition open_result { |fs|::OpenResult::Ok { file } -> block header(context, next_passed, file), _ -> done(context, next_passed) }
    }

    machine header(context: @mutable Main, passed: i32 in Wrapping, file: |fs|::File) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 2. Header line.
        let io_result: |fs|::IoResult = block |fs|::Filesystem::write(file, "vault v1\n");
        let close_result: |fs|::UnitResult = block |fs|::Filesystem::close(file);
        transition io_result { |fs|::IoResult::Ok { count } -> block note1(context, next_passed), _ -> done(context, next_passed) }
    }

    machine note1(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 3. First note appends at EOF.
        let open_result: |fs|::OpenResult = block |fs|::Filesystem::append("omega_vault/notes/current/vault.txt" as + |paths|::Path);
        transition open_result { |fs|::OpenResult::Ok { file } -> block note1_write(context, next_passed, file), _ -> done(context, next_passed) }
    }
    machine note1_write(context: @mutable Main, passed: i32 in Wrapping, file: |fs|::File) {
        let io_result: |fs|::IoResult = block |fs|::Filesystem::write(file, "note: alpha\n");
        let close_result: |fs|::UnitResult = block |fs|::Filesystem::close(file);
        transition io_result { |fs|::IoResult::Ok { count } -> block note2(context, passed), _ -> done(context, passed) }
    }

    machine note2(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 4. Second note.
        let open_result: |fs|::OpenResult = block |fs|::Filesystem::append("omega_vault/notes/current/vault.txt" as + |paths|::Path);
        transition open_result { |fs|::OpenResult::Ok { file } -> block note2_write(context, next_passed, file), _ -> done(context, next_passed) }
    }
    machine note2_write(context: @mutable Main, passed: i32 in Wrapping, file: |fs|::File) {
        let io_result: |fs|::IoResult = block |fs|::Filesystem::write(file, "note: beta\n");
        let close_result: |fs|::UnitResult = block |fs|::Filesystem::close(file);
        transition io_result { |fs|::IoResult::Ok { count } -> block audit(context, passed), _ -> done(context, passed) }
    }

    machine audit(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 5. The vault's length is the three lines: 9 + 12 + 11 = 32.
        let meta_result: |fs|::MetadataResult = block |fs|::Filesystem::metadata_path("omega_vault/notes/current/vault.txt" as + |paths|::Path);
        transition meta_result { |fs|::MetadataResult::Ok { meta } -> block audit_len(context, next_passed, meta), _ -> done(context, next_passed) }
    }
    machine audit_len(context: @mutable Main, passed: i32 in Wrapping, meta: |fs|::Metadata) {
        transition meta.length == 32 { true -> block audit_time(context, passed, meta), _ -> done(context, passed) }
    }

    machine audit_time(context: @mutable Main, passed: i32 in Wrapping, meta: |fs|::Metadata) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 8. The vault's modified time BRIDGES into system\time: a just-written
        // file is never in the future, so duration_since(now) must be Ok.
        let modified: |time|::SystemTime = |time|::system_time_from_unix_seconds(meta.modified_secs);
        let now_keep: |time|::SystemTime = |time|::system_time_now();
        let diff: |time|::SystemTimeDifference = |time|::system_time_duration_since(@now_keep, modified);
        transition diff {
            |time|::SystemTimeDifference::Ok { duration } -> block audit_time_gap(context, next_passed, duration),
            _ -> done(context, next_passed)
        }
    }
    machine audit_time_gap(context: @mutable Main, passed: i32 in Wrapping, duration: |time|::Duration) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 9. Both engines read the real filesystem and current host clock.
        // A just-written file has a small nonnegative age; a garbage
        // timestamp decode blows the 10^9 bound.
        transition duration.seconds < 1000000000 { true -> block readback(context, next_passed), _ -> done(context, next_passed) }
    }

    machine readback(context: @mutable Main, passed: i32 in Wrapping) {
        let mutable back: [u8; 64];
        let next_passed: i32 in Wrapping = passed + 1;
        // 8. Read back and spot-check first ('v') and last ('\n' = 10) bytes.
        let io_result: |fs|::IoResult = block |fs|::Filesystem::read_all("omega_vault/notes/current/vault.txt" as + |paths|::Path, @mutable back[..], 64);
        transition io_result {
            |fs|::IoResult::Ok { count } -> block readback_ck(context, next_passed, count, back[0], back[31]),
            _ -> done(context, next_passed)
        }
    }
    machine readback_ck(context: @mutable Main, passed: i32 in Wrapping, count: u64, head: u8, tail: u8) {
        transition count == 32 && head == 118 && tail == 10 {
            true -> block compact(context, passed),
            _ -> done(context, passed)
        }
    }

    machine compact(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 9. Compact: truncate-rewrite keeps only the header (open_with's
        // composed write+truncate word).
        let opts: |fs|::OpenOptions = |fs|::OpenOptions {
            read: false, write: true, append: false, truncate: true,
            create: false, create_new: false
        };
        let open_result: |fs|::OpenResult = block |fs|::Filesystem::open_with("omega_vault/notes/current/vault.txt" as + |paths|::Path, opts);
        transition open_result { |fs|::OpenResult::Ok { file } -> block compact_write(context, next_passed, file), _ -> done(context, next_passed) }
    }
    machine compact_write(context: @mutable Main, passed: i32 in Wrapping, file: |fs|::File) {
        let io_result: |fs|::IoResult = block |fs|::Filesystem::write(file, "vault v1\n");
        let close_result: |fs|::UnitResult = block |fs|::Filesystem::close(file);
        let meta_result: |fs|::MetadataResult = block |fs|::Filesystem::metadata_path("omega_vault/notes/current/vault.txt" as + |paths|::Path);
        transition meta_result { |fs|::MetadataResult::Ok { meta } -> block compact_ck(context, passed, meta), _ -> done(context, passed) }
    }
    machine compact_ck(context: @mutable Main, passed: i32 in Wrapping, meta: |fs|::Metadata) {
        transition meta.length == 9 { true -> block backup(context, passed), _ -> done(context, passed) }
    }

    machine backup(context: @mutable Main, passed: i32 in Wrapping) {
        let mutable scratch: [u8; 64];
        let next_passed: i32 in Wrapping = passed + 1;
        // 10. Snapshot the compacted vault.
        let io_result: |fs|::IoResult = block |fs|::Filesystem::copy("omega_vault/notes/current/vault.txt" as + |paths|::Path, "omega_vault/notes/current/vault.bak" as + |paths|::Path, @mutable scratch[..], 64);
        transition io_result { |fs|::IoResult::Ok { count } -> block backup_ck(context, next_passed, count), _ -> done(context, next_passed) }
    }
    machine backup_ck(context: @mutable Main, passed: i32 in Wrapping, count: u64) {
        transition count == 9 { true -> block cleanup(context, passed), _ -> done(context, passed) }
    }

    machine cleanup(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 12. Audit the vault directory: exactly the file + its backup.
        let io_result: |fs|::IoResult = block |fs|::Filesystem::read_dir_count("omega_vault/notes/current" as + |paths|::Path);
        transition io_result { |fs|::IoResult::Ok { count } -> block audit_dir(context, next_passed, count), _ -> done(context, next_passed) }
    }
    machine audit_dir(context: @mutable Main, passed: i32 in Wrapping, count: u64) {
        transition count == 2 { true -> block remove_one(context, passed), _ -> done(context, passed) }
    }
    machine remove_one(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 13. Remove one file the precise way...
        let unit_result: |fs|::UnitResult = block |fs|::Filesystem::remove("omega_vault/notes/current/vault.txt" as + |paths|::Path);
        transition unit_result { |fs|::UnitResult::Ok -> block teardown(context, next_passed), _ -> done(context, next_passed) }
    }
    machine teardown(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        // 14. ...and drain the whole tree the sweeping way (the iterative
        // dirfd-stack remove_dir_all), backup and directories included.
        let unit_result: |fs|::UnitResult = block |fs|::Filesystem::remove_dir_all("omega_vault" as + |paths|::Path);
        transition unit_result { |fs|::UnitResult::Ok -> block ck_gone(context, next_passed), _ -> done(context, next_passed) }
    }
    machine ck_gone(context: @mutable Main, passed: i32 in Wrapping) {
        let present: bool = block |fs|::Filesystem::exists("omega_vault" as + |paths|::Path);
        transition present { true -> done(context, passed), _ -> finish(context, passed) }
    }
    machine finish(context: @mutable Main, passed: i32 in Wrapping) {
        let next_passed: i32 in Wrapping = passed + 1;
        transition true { true -> done(context, next_passed), _ -> done(context, next_passed) }
    }

    machine done(context: @mutable Main, passed: i32 in Wrapping) { |process|::ProcessExit::exit_process(passed as i32); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
blocks
reaches |process|::ProcessExit + |authority|::DirectoryEnumeration + |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemMetadataQuery + |authority|::FilesystemNamespaceMutation + |clock_host|::TimeHost {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
