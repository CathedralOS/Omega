// Private IND12 model. Trapping arithmetic remains observable if its documented
// bound is ever violated; no silent wrap or floating-point accumulation.
data Lattice {
    sites: u64;
    activity: u64 in Trapping;
    bond: u64 in Trapping;
    periodic: bool;
    configurations: u64 in Trapping;
    partition: u64 in Trapping;
    first: u64 in Trapping;
    second: u64 in Trapping;
    histogram: [u64; 9] in Trapping;
}

machine enumerate(lattice: &mut Lattice) {
    transition { _ -> capacity(lattice, 0, 1) }
    machine capacity(lattice: &mut Lattice, position: u64, count: u64 in Trapping) {
        transition position < lattice.sites {
            true -> capacity(lattice, position + 1, count * 2)
            false -> configuration(lattice, 0, count)
        }
    }
    machine configuration(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping) {
        transition code < count {
            true -> vertex(lattice, code, count, 0, 1, 0, 0, 0, 1)
            false -> done()
        }
    }
    machine vertex(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping,
                 position: u64, divisor: u64 in Trapping, occupied: u64 in Trapping,
                 previous: u64 in Trapping, first: u64 in Trapping, weight: u64 in Trapping) {
        transition position < lattice.sites {
            true -> observe(lattice, code, count, position, divisor, occupied, previous, first, weight)
            false -> close(lattice, code, count, occupied, previous, first, weight)
        }
    }
    machine observe(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping,
                  position: u64, divisor: u64 in Trapping, occupied: u64 in Trapping,
                  previous: u64 in Trapping, first: u64 in Trapping, weight: u64 in Trapping) {
        let bit: u64 in Trapping = code / divisor % 2;
        transition position == 0 {
            true -> weigh(lattice, code, count, position, divisor, occupied, previous, bit, weight, bit)
            false -> weigh(lattice, code, count, position, divisor, occupied, previous, first, weight, bit)
        }
    }
    machine weigh(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping,
                position: u64, divisor: u64 in Trapping, occupied: u64 in Trapping,
                previous: u64 in Trapping, first: u64 in Trapping, weight: u64 in Trapping,
                bit: u64 in Trapping) {
        let active_weight: u64 in Trapping = weight * lattice.activity;
        transition bit == 1 {
            true -> active(lattice, code, count, position, divisor, occupied, previous, first, active_weight)
            false -> vertex(lattice, code, count, position + 1, divisor * 2, occupied, 0, first, weight)
        }
    }
    machine active(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping,
                 position: u64, divisor: u64 in Trapping, occupied: u64 in Trapping,
                 previous: u64 in Trapping, first: u64 in Trapping, weight: u64 in Trapping) {
        let bonded_weight: u64 in Trapping = weight * lattice.bond;
        transition previous == 1 {
            true -> vertex(lattice, code, count, position + 1, divisor * 2, occupied + 1, 1, first, bonded_weight)
            false -> vertex(lattice, code, count, position + 1, divisor * 2, occupied + 1, 1, first, weight)
        }
    }
    machine close(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping,
                occupied: u64 in Trapping, previous: u64 in Trapping, first: u64 in Trapping,
                weight: u64 in Trapping) {
        let closed_weight: u64 in Trapping = weight * lattice.bond;
        transition lattice.periodic && previous == 1 && first == 1 {
            true -> accumulate(lattice, code, count, occupied, closed_weight)
            false -> accumulate(lattice, code, count, occupied, weight)
        }
    }
    machine accumulate(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping,
                     occupied: u64 in Trapping, weight: u64 in Trapping) {
        lattice.configurations = lattice.configurations + 1;
        lattice.partition = lattice.partition + weight;
        lattice.first = lattice.first + weight * occupied;
        lattice.second = lattice.second + weight * occupied * occupied;
        transition (occupied as u64) < 9 {
            true -> histogram(lattice, code, count, occupied as u64, weight)
            false -> done()
        }
    }
    machine histogram(lattice: &mut Lattice, code: u64 in Trapping, count: u64 in Trapping,
                    occupied: u64, weight: u64 in Trapping) requires occupied < 9 {
        lattice.histogram[occupied] = lattice.histogram[occupied] + weight;
        transition { _ -> configuration(lattice, code + 1, count) }
    }
    machine done() { }
}
