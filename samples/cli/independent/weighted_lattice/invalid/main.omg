// Complete intended-invalid control: the bin at index 9 is outside the fixed extent.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let bins: [u64; 9];
    let impossible: u64 = bins[9];
    transition impossible == 0 {
        true -> done(&main.console)
        false -> done(&main.console)
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 0); }
}
