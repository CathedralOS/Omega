// Complete intended-invalid control: the bin at index 9 is outside the fixed extent.
use omega_language_std::console;
machine main() reaches Console {
    let bins: [u64; 9];
    let impossible: u64 = bins[9];
    transition impossible == 0 {
        true -> done()
        false -> done()
    }
    state done() { Console::exit_process(0); }
}
