use omega_language_std::console;
use omega::language::core::numeric_conversion;

machine decimal(value: u64) reaches Console {
    transition value >= 10 {
        true -> prefix(value)
        false -> digit(value)
    }
    machine prefix(value: u64) {
        decimal(value / 10);
        transition { _ -> digit(value) }
    }
    machine digit(value: u64) {
        Console::write_byte(narrow_u64_to_i32_trapping(value % 10 + 48));
    }
}
machine number_line(label: &[u8], value: u64) reaches Console {
    Console::write(label);
    decimal(value);
    Console::write_line("");
}
