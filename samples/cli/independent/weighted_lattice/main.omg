// Exact weighted finite binary lattice partition and occupancy moments.
// Expected exit: 0.
use omega_language_std::console;
use model::enumeration;
use io::numbers;
use omega::language::core::numeric_conversion;

machine input_byte() -> i32 reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed {
        ByteRead::Byte { value } -> present(value)
        ByteRead::Eof -> absent()
    }
    machine present(value: i32) -> i32 { value }
    machine absent() -> i32 { -1 }
}

machine main() reaches Console {
    let sites: i32 = block input_byte();
    let activity: i32 = block input_byte();
    let bond: i32 = block input_byte();
    let topology: i32 = block input_byte();
    let ending: i32 = block input_byte();
    transition sites >= 49 && sites <= 56 && activity >= 49 && activity <= 51
        && bond >= 49 && bond <= 51 && (topology == 111 || topology == 114)
        && (ending == 10 || ending == -1) && (topology != 114 || sites >= 51) {
        true -> valid(sites, activity, bond, topology, ending)
        false -> invalid()
    }
    machine valid(sites: i32, activity: i32, bond: i32, topology: i32, ending: i32) {
        transition ending == 10 {
            true -> trailing(sites, activity, bond, topology)
            false -> calculate(sites, activity, bond, topology)
        }
    }
    machine trailing(sites: i32, activity: i32, bond: i32, topology: i32) {
        let extra: i32 = block input_byte();
        transition extra == -1 {
            true -> calculate(sites, activity, bond, topology)
            false -> invalid()
        }
    }
    machine calculate(sites: i32, activity: i32, bond: i32, topology: i32) {
        let mut lattice: Lattice;
        lattice.sites = narrow_i32_to_u64_trapping(sites - 48);
        lattice.activity = narrow_i32_to_u64_trapping(activity - 48) as u64 in Trapping;
        lattice.bond = narrow_i32_to_u64_trapping(bond - 48) as u64 in Trapping;
        lattice.periodic = topology == 114;
        enumerate(&mut lattice);
        Console::write_line("weighted_lattice v1");
        number_line("sites=", lattice.sites);
        number_line("configurations=", lattice.configurations as u64);
        number_line("Z=", lattice.partition as u64);
        number_line("K numerator=", lattice.first as u64);
        number_line("K2 numerator=", lattice.second as u64);
        number_line("moment denominator=", lattice.partition as u64);
        Console::write_line("histogram: occupied weighted_count");
        transition { _ -> row(&lattice, 0) }
    }
    machine row(lattice: &Lattice, occupied: u64) requires occupied < 9 {
        decimal(occupied);
        Console::write(" ");
        decimal(lattice.histogram[occupied] as u64);
        Console::write_line("");
        transition occupied < lattice.sites && occupied + 1 < 9 {
            true -> row(lattice, occupied + 1)
            false -> done()
        }
    }
    machine done() { Console::exit_process(0); }
    machine invalid() {
        Console::write_line("invalid: expected NABT, N=1..8 A,B=1..3 T=o|r; ring N>=3; optional LF then EOF");
        Console::exit_process(64);
    }
}
