use domain::sequence;
use domain::normalization;
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

pub machine number(console: &Binding<Console>, value: u64 in Wrapping) reaches Console
invokes Console;
{
    transition { _ -> digit(console, value, 10000000000000000000, false) }
    state digit(console: &Binding<Console>, value: u64 in Wrapping, divisor: u64 in Wrapping, started: bool) {
        transition divisor > 0 {
            true -> calculate(console, value, divisor, started)
            _ -> stop()
        }
    }
    state calculate(console: &Binding<Console>, value: u64 in Wrapping, divisor: u64 in Wrapping, started: bool) {
        let current: u64 in Wrapping = value / divisor;
        transition current > 0 || started || divisor == 1 {
            true -> write(console, value, divisor, current)
            _ -> next(console, value, divisor, false)
        }
    }
    state write(console: &Binding<Console>, value: u64 in Wrapping, divisor: u64 in Wrapping, current: u64 in Wrapping) {
        transition current < 10 {
            true -> write_digit(console, value, divisor, current)
            _ -> stop()
        }
    }
    state write_digit(console: &Binding<Console>, value: u64 in Wrapping, divisor: u64 in Wrapping, current: u64 in Wrapping) {
        let byte: u64 in Wrapping = current + 48;
        Console::write_byte(console, narrow_u64_to_i32_exact(byte as u64));
        transition { _ -> next(console, value % divisor, divisor, true) }
    }
    state next(console: &Binding<Console>, value: u64 in Wrapping, divisor: u64 in Wrapping, started: bool) {
        transition divisor > 1 {
            true -> digit(console, value, divisor / 10, started)
            _ -> stop()
        }
    }
    state stop() { }
}
pub machine separator(console: &Binding<Console>) reaches Console
invokes Console;
{ Console::write_byte(console, 124); }
pub machine newline(console: &Binding<Console>) reaches Console
invokes Console;
{ Console::write_byte(console, 10); }
pub machine bases(console: &Binding<Console>, sequence: &Sequence) reaches Console
invokes Console;
{
    transition sequence.length == 0 {
        true -> empty(console)
        _ -> base(console, sequence, 0)
    }
    state empty(console: &Binding<Console>) { Console::write_byte(console, 45); }
    state base(console: &Binding<Console>, sequence: &Sequence, index: u64 in Wrapping) {
        transition index < sequence.length {
            true -> read(console, sequence, index)
            _ -> stop()
        }
    }
    state read(console: &Binding<Console>, sequence: &Sequence, index: u64 in Wrapping) {
        let value: u64 in Wrapping = Sequence::base(sequence, index);
        transition value {
            1 -> write(console, sequence, index, 65)
            2 -> write(console, sequence, index, 67)
            3 -> write(console, sequence, index, 71)
            4 -> write(console, sequence, index, 84)
            _ -> write(console, sequence, index, 63)
        }
    }
    state write(console: &Binding<Console>, sequence: &Sequence, index: u64 in Wrapping, character: i32) {
        Console::write_byte(console, character);
        transition { _ -> base(console, sequence, index + 1) }
    }
    state stop() { }
}
pub machine variant_row(console: &Binding<Console>, variant: &Variant) reaches Console
invokes Console;
{
    number(console, variant.contig); separator(console); number(console, variant.position); separator(console);
    number(console, variant.removed); separator(console); bases(console, &variant.inserted); separator(console);
    number(console, variant.provenance);
}
