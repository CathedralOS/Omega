// Complete streamed synthetic variant-normalization application.
use omega_language_std::console;
use omega::language::core::binding;
use domain::sequence;
use domain::input;
use domain::normalization;
use domain::ledger;
use domain::report;

data Main { console: Binding<Console>; }
data Application {
    first_reference: Sequence;
    second_reference: Sequence;
    first_defined: bool;
    second_defined: bool;
    locked: bool;
    ledger: Ledger;
    line_number: u64 in Wrapping;
    rejected: u64 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut application: Application;
    main.console.write_line("VARIANT_NORMALIZATION|1");
    transition { _ -> read(&main.console, &mut application) }
    state read(console: &Binding<Console>, application: &mut Application) {
        let mut line: [u8; 64];
        let result: LineReadResult = block Console::read_line(console, &mut line);
        transition result {
            LineReadResult::LineComplete { count } -> process(console, application, &line, count as u64 in Wrapping, false)
            LineReadResult::EndOfInput { count } -> eof(console, application, &line, count as u64 in Wrapping)
            LineReadResult::Full { count } -> overflow(console, application)
            LineReadResult::Invalid -> overflow(console, application)
        }
    }
    state eof(console: &Binding<Console>, application: &mut Application, line: &[u8; 64], count: u64 in Wrapping) {
        transition count == 0 {
            true -> finish(console, application)
            _ -> process(console, application, line, count, true)
        }
    }
    state process(console: &Binding<Console>, application: &mut Application, line: &[u8; 64], count: u64 in Wrapping, last: bool) {
        transition application.line_number < 512 {
            true -> bounded_process(console, application, line, count, last)
            _ -> record_capacity(console, application)
        }
    }
    state record_capacity(console: &Binding<Console>, application: &mut Application) {
        application.rejected = application.rejected + 1;
        Console::write_line(console, "FATAL|record_capacity");
        transition { _ -> finish(console, application) }
    }
    state bounded_process(console: &Binding<Console>, application: &mut Application, line: &[u8; 64], count: u64 in Wrapping, last: bool) {
        application.line_number = application.line_number + 1;
        let mut input: Input;
        parse(line, count, &mut input);
        let reason: u64 in Wrapping = consume(console, application, &input);
        transition reason == 0 {
            true -> next(console, application, last)
            _ -> reject(console, application, last, reason)
        }
    }
    state reject(console: &Binding<Console>, application: &mut Application, last: bool, reason: u64 in Wrapping) {
        application.rejected = application.rejected + 1;
        Console::write(console, "REJECT|"); number(console, application.line_number); separator(console); number(console, reason); newline(console);
        transition { _ -> next(console, application, last) }
    }
    state next(console: &Binding<Console>, application: &mut Application, last: bool) {
        transition last {
            true -> finish(console, application)
            _ -> read(console, application)
        }
    }
    state overflow(console: &Binding<Console>, application: &mut Application) {
        application.rejected = application.rejected + 1;
        Console::write_line(console, "FATAL|line_capacity");
        transition { _ -> finish(console, application) }
    }
    state finish(console: &Binding<Console>, application: &mut Application) {
        render_ledger(console, &application.ledger);
        Console::write(console, "SUMMARY|"); number(console, application.ledger.count); separator(console);
        number(console, application.ledger.merged); separator(console); number(console, application.ledger.conflicts); separator(console);
        number(console, application.rejected); newline(console);
        transition application.rejected == 0 {
            true -> exit(console, 0)
            _ -> exit(console, 2)
        }
    }
    state exit(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}

machine consume(console: &Binding<Console>, application: &mut Application, input: &Input) -> u64 in Wrapping reaches Console {
    transition input.valid {
        true -> select(console, application, input)
        _ -> 1
    }
    state select(console: &Binding<Console>, application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition input.kind == 0 {
            true -> reference(application, input)
            _ -> variant(console, application, input)
        }
    }
    state reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.locked {
            true -> 2
            _ -> contig_reference(application, input)
        }
    }
    state contig_reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition input.contig == 0 {
            true -> first_reference(application, input)
            _ -> second_reference(application, input)
        }
    }
    state first_reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.first_defined {
            true -> 2
            _ -> store_first(application, input)
        }
    }
    state store_first(application: &mut Application, input: &Input) -> u64 in Wrapping {
        application.first_reference = input.removed;
        application.first_defined = true;
        (0)
    }
    state second_reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.second_defined {
            true -> 2
            _ -> store_second(application, input)
        }
    }
    state store_second(application: &mut Application, input: &Input) -> u64 in Wrapping {
        application.second_reference = input.removed;
        application.second_defined = true;
        (0)
    }
    state variant(console: &Binding<Console>, application: &mut Application, input: &Input) -> u64 in Wrapping {
        application.locked = true;
        transition input.contig == 0 {
            true -> first(console, application, input)
            _ -> second(console, application, input)
        }
    }
    state first(console: &Binding<Console>, application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.first_defined {
            true -> first_run(console, application, input)
            _ -> 2
        }
    }
    state second(console: &Binding<Console>, application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.second_defined {
            true -> second_run(console, application, input)
            _ -> 2
        }
    }
    state first_run(console: &Binding<Console>, application: &mut Application, input: &Input) -> u64 in Wrapping {
        let reference: Sequence = application.first_reference;
        transition { _ -> run(console, application, input, &reference) }
    }
    state second_run(console: &Binding<Console>, application: &mut Application, input: &Input) -> u64 in Wrapping {
        let reference: Sequence = application.second_reference;
        transition { _ -> run(console, application, input, &reference) }
    }
    state run(console: &Binding<Console>, application: &mut Application, input: &Input, reference: &Sequence) -> u64 in Wrapping {
        let mut result: Normalization;
        normalize(reference, input.position, &input.removed, &input.inserted, &mut result);
        transition result.status {
            0 -> accepted(console, application, input, &mut result)
            1 -> 3
            2 -> 4
            _ -> 5
        }
    }
    state accepted(console: &Binding<Console>, application: &mut Application, input: &Input, result: &mut Normalization) -> u64 in Wrapping {
        result.canonical.contig = input.contig;
        result.canonical.provenance = source_mask(input.source);
        let action: u64 in Wrapping = Ledger::add(&mut application.ledger, &result.canonical);
        transition action < 2 {
            true -> emit(console, input, result, action)
            _ -> 6
        }
    }
    state emit(console: &Binding<Console>, input: &Input, result: &Normalization, action: u64 in Wrapping) -> u64 in Wrapping {
        Console::write(console, "CANON|"); variant_row(console, &result.canonical); separator(console); number(console, action); newline(console);
        (0)
    }
}

machine render_ledger(console: &Binding<Console>, ledger: &Ledger) reaches Console {
    transition { _ -> row(console, ledger, 0) }
    state row(console: &Binding<Console>, ledger: &Ledger, index: u64 in Wrapping) {
        transition index < ledger.count && index < 32 {
            true -> read(console, ledger, index)
            _ -> stop()
        }
    }
    state read(console: &Binding<Console>, ledger: &Ledger, index: u64 in Wrapping) {
        let variant: Variant = ledger.variants[index];
        Console::write(console, "MERGE|"); number(console, index); separator(console); variant_row(console, &variant); newline(console);
        transition { _ -> pairs(console, ledger, index, &variant, 0) }
    }
    state pairs(console: &Binding<Console>, ledger: &Ledger, index: u64 in Wrapping, variant: &Variant, previous: u64 in Wrapping) {
        transition previous < index && previous < 32 {
            true -> compare(console, ledger, index, variant, previous)
            _ -> row(console, ledger, index + 1)
        }
    }
    state compare(console: &Binding<Console>, ledger: &Ledger, index: u64 in Wrapping, variant: &Variant, previous: u64 in Wrapping) {
        let other: Variant = ledger.variants[previous];
        transition other.contig == variant.contig && other.position <= variant.position + variant.removed
            && variant.position <= other.position + other.removed {
            true -> emit(console, ledger, index, variant, previous)
            _ -> pairs(console, ledger, index, variant, previous + 1)
        }
    }
    state emit(console: &Binding<Console>, ledger: &Ledger, index: u64 in Wrapping, variant: &Variant, previous: u64 in Wrapping) {
        Console::write(console, "CONFLICT|"); number(console, previous); separator(console); number(console, index); newline(console);
        transition { _ -> pairs(console, ledger, index, variant, previous + 1) }
    }
    state stop() { }
}
