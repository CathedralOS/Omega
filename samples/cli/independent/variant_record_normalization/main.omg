// Complete streamed synthetic variant-normalization application.
use omega_language_std::console;
use domain::sequence;
use domain::input;
use domain::normalization;
use domain::ledger;
use domain::report;

data Main { }
data Application {
    first_reference: Sequence;
    second_reference: Sequence;
    first_defined: bool;
    second_defined: bool;
    locked: bool;
    ledger: Ledger;
    line_number: u64 in Wrapping;
    rejected: u64 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut application: Application;
    Console::write_line("VARIANT_NORMALIZATION|1");
    transition { _ -> read(&mut application) }
    state read(application: &mut Application) {
        let mut line: [u8; 64];
        let result: LineReadResult = block Console::read_line(&mut line);
        transition result {
            LineReadResult::LineComplete { count } -> process(application, &line, count as u64 in Wrapping, false)
            LineReadResult::EndOfInput { count } -> eof(application, &line, count as u64 in Wrapping)
            LineReadResult::Full { count } -> overflow(application)
            LineReadResult::Invalid -> overflow(application)
        }
    }
    state eof(application: &mut Application, line: &[u8; 64], count: u64 in Wrapping) {
        transition count == 0 {
            true -> finish(application)
            _ -> process(application, line, count, true)
        }
    }
    state process(application: &mut Application, line: &[u8; 64], count: u64 in Wrapping, last: bool) {
        transition application.line_number < 512 {
            true -> bounded_process(application, line, count, last)
            _ -> record_capacity(application)
        }
    }
    state record_capacity(application: &mut Application) {
        application.rejected = application.rejected + 1;
        Console::write_line("FATAL|record_capacity");
        transition { _ -> finish(application) }
    }
    state bounded_process(application: &mut Application, line: &[u8; 64], count: u64 in Wrapping, last: bool) {
        application.line_number = application.line_number + 1;
        let mut input: Input;
        parse(line, count, &mut input);
        let reason: u64 in Wrapping = consume(application, &input);
        transition reason == 0 {
            true -> next(application, last)
            _ -> reject(application, last, reason)
        }
    }
    state reject(application: &mut Application, last: bool, reason: u64 in Wrapping) {
        application.rejected = application.rejected + 1;
        Console::write("REJECT|"); number(application.line_number); separator(); number(reason); newline();
        transition { _ -> next(application, last) }
    }
    state next(application: &mut Application, last: bool) {
        transition last {
            true -> finish(application)
            _ -> read(application)
        }
    }
    state overflow(application: &mut Application) {
        application.rejected = application.rejected + 1;
        Console::write_line("FATAL|line_capacity");
        transition { _ -> finish(application) }
    }
    state finish(application: &mut Application) {
        render_ledger(&application.ledger);
        Console::write("SUMMARY|"); number(application.ledger.count); separator();
        number(application.ledger.merged); separator(); number(application.ledger.conflicts); separator();
        number(application.rejected); newline();
        transition application.rejected == 0 {
            true -> exit(0)
            _ -> exit(2)
        }
    }
    state exit(code: i32) { Console::exit_process(code); }
}

machine consume(application: &mut Application, input: &Input) -> u64 in Wrapping reaches Console {
    transition input.valid {
        true -> select(application, input)
        _ -> 1
    }
    state select(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition input.kind == 0 {
            true -> reference(application, input)
            _ -> variant(application, input)
        }
    }
    state reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.locked {
            true -> 2
            _ -> contig_reference(application, input)
        }
    }
    state contig_reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition input.contig == 0 {
            true -> first_reference(application, input)
            _ -> second_reference(application, input)
        }
    }
    state first_reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.first_defined {
            true -> 2
            _ -> store_first(application, input)
        }
    }
    state store_first(application: &mut Application, input: &Input) -> u64 in Wrapping {
        application.first_reference = input.removed;
        application.first_defined = true;
        (0)
    }
    state second_reference(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.second_defined {
            true -> 2
            _ -> store_second(application, input)
        }
    }
    state store_second(application: &mut Application, input: &Input) -> u64 in Wrapping {
        application.second_reference = input.removed;
        application.second_defined = true;
        (0)
    }
    state variant(application: &mut Application, input: &Input) -> u64 in Wrapping {
        application.locked = true;
        transition input.contig == 0 {
            true -> first(application, input)
            _ -> second(application, input)
        }
    }
    state first(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.first_defined {
            true -> first_run(application, input)
            _ -> 2
        }
    }
    state second(application: &mut Application, input: &Input) -> u64 in Wrapping {
        transition application.second_defined {
            true -> second_run(application, input)
            _ -> 2
        }
    }
    state first_run(application: &mut Application, input: &Input) -> u64 in Wrapping {
        let reference: Sequence = application.first_reference;
        transition { _ -> run(application, input, &reference) }
    }
    state second_run(application: &mut Application, input: &Input) -> u64 in Wrapping {
        let reference: Sequence = application.second_reference;
        transition { _ -> run(application, input, &reference) }
    }
    state run(application: &mut Application, input: &Input, reference: &Sequence) -> u64 in Wrapping {
        let mut result: Normalization;
        normalize(reference, input.position, &input.removed, &input.inserted, &mut result);
        transition result.status {
            0 -> accepted(application, input, &mut result)
            1 -> 3
            2 -> 4
            _ -> 5
        }
    }
    state accepted(application: &mut Application, input: &Input, result: &mut Normalization) -> u64 in Wrapping {
        result.canonical.contig = input.contig;
        result.canonical.provenance = source_mask(input.source);
        let action: u64 in Wrapping = Ledger::add(&mut application.ledger, &result.canonical);
        transition action < 2 {
            true -> emit(input, result, action)
            _ -> 6
        }
    }
    state emit(input: &Input, result: &Normalization, action: u64 in Wrapping) -> u64 in Wrapping {
        Console::write("CANON|"); variant_row(&result.canonical); separator(); number(action); newline();
        (0)
    }
}

machine render_ledger(ledger: &Ledger) reaches Console {
    transition { _ -> row(ledger, 0) }
    state row(ledger: &Ledger, index: u64 in Wrapping) {
        transition index < ledger.count && index < 32 {
            true -> read(ledger, index)
            _ -> stop()
        }
    }
    state read(ledger: &Ledger, index: u64 in Wrapping) {
        let variant: Variant = ledger.variants[index];
        Console::write("MERGE|"); number(index); separator(); variant_row(&variant); newline();
        transition { _ -> pairs(ledger, index, &variant, 0) }
    }
    state pairs(ledger: &Ledger, index: u64 in Wrapping, variant: &Variant, previous: u64 in Wrapping) {
        transition previous < index && previous < 32 {
            true -> compare(ledger, index, variant, previous)
            _ -> row(ledger, index + 1)
        }
    }
    state compare(ledger: &Ledger, index: u64 in Wrapping, variant: &Variant, previous: u64 in Wrapping) {
        let other: Variant = ledger.variants[previous];
        transition other.contig == variant.contig && other.position <= variant.position + variant.removed
            && variant.position <= other.position + other.removed {
            true -> emit(ledger, index, variant, previous)
            _ -> pairs(ledger, index, variant, previous + 1)
        }
    }
    state emit(ledger: &Ledger, index: u64 in Wrapping, variant: &Variant, previous: u64 in Wrapping) {
        Console::write("CONFLICT|"); number(previous); separator(); number(index); newline();
        transition { _ -> pairs(ledger, index, variant, previous + 1) }
    }
    state stop() { }
}
