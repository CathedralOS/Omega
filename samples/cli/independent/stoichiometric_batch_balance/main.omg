// Entire input, solve, batch and report workflow runs in Omega.
// The generic sample harness closes stdin; this is the empty-input control.
// Expected exit: 64.
// Expected output contains: INVALID_INPUT
use omega_language_std::console;
use chemistry::model;
use chemistry::balance;
use chemistry::inventory;
use chemistry::report;

data Main { signature: chemistry::model::Signature; }
data Input {
    values: [i64 in Wrapping; 19];
    count: u64;
    status: i32;
}

machine Main::main(context: &mut Main) reaches Console {
    let produced: chemistry::model::Signature = chemistry::balance::signature_of(3, 2, 1, 2, 1);
    let local_fourth: i64 in Wrapping = produced.fourth;
    transition { _ -> hold(context, produced, local_fourth) }
    state hold(context: &mut Main, parameter: chemistry::model::Signature, local_fourth: i64 in Wrapping) {
        transition parameter.active == 3 && parameter.fourth == 0 && local_fourth == 0 {
            true -> store(context, parameter)
            false -> signature_mismatch(context)
        }
    }
    state store(context: &mut Main, parameter: chemistry::model::Signature) {
        context.signature = parameter;
        let called: chemistry::model::Signature = chemistry::balance::signature_of(4, 1, 1, 1, 1);
        transition context.signature.active == 3 && context.signature.fourth == 0 && called.active == 4 && called.fourth == 1 {
            true -> rows(context)
            false -> signature_mismatch(context)
        }
    }
    state rows(context: &mut Main) {
        let first: [i64 in Wrapping; 4] = [2, 0, 1, 0];
        let second: [i64 in Wrapping; 4] = [0, 1, 0, 0];
        let third: [i64 in Wrapping; 4] = [0, 0, 0, 1];
        let selected: &[i64 in Wrapping; 4] = chemistry::balance::axis(&first, &second, &third, 0);
        let held: chemistry::model::Held = chemistry::model::Held { row: selected };
        let via_parameter: i64 in Wrapping = chemistry::balance::read_axis(selected);
        let via_call: &[i64 in Wrapping; 4] = chemistry::balance::axis(&first, &second, &third, 2);
        transition selected[0] == 2 && held.row[0] == 2 && via_parameter == 2 && via_call[3] == 1 {
            true -> windows(context)
            false -> signature_mismatch(context)
        }
    }
    state windows(context: &mut Main) {
        let mut coefficients: [i64 in Wrapping; 4] = [0, 0, 0, 0];
        chemistry::balance::write_reactants(&mut coefficients[0..2]);
        let reactants: &[i64 in Wrapping] = chemistry::balance::reactant_window(&coefficients, 0);
        let held: chemistry::model::HeldWindow = chemistry::model::HeldWindow { values: reactants };
        let via_parameter: i64 in Wrapping = chemistry::balance::read_window(held.values);
        let via_call: &[i64 in Wrapping] = chemistry::balance::reactant_window(&coefficients, 1);
        transition reactants.len == 2 && reactants[0] == 2 && reactants[1] == 1 && held.values.len == 2 && via_parameter == 2 && via_call.len == 2 {
            true -> consume(context)
            false -> signature_mismatch(context)
        }
    }
    state consume(context: &mut Main) {
        let mut input: Input;
        block Main::read(context, &mut input);
        transition input.status == 0 && input.count == 19 {
            true -> declare(context, &input)
            false -> invalid(context)
        }
    }
    state declare(context: &mut Main, input: &Input) {
        let mut reaction: chemistry::model::Reaction;
        reaction.species = input.values[0];
        reaction.bound = input.values[1];
        reaction.first[0] = input.values[2];
        reaction.first[1] = input.values[5];
        reaction.first[2] = input.values[8];
        reaction.first[3] = input.values[11];
        reaction.second[0] = input.values[3];
        reaction.second[1] = input.values[6];
        reaction.second[2] = input.values[9];
        reaction.second[3] = input.values[12];
        reaction.third[0] = input.values[4];
        reaction.third[1] = input.values[7];
        reaction.third[2] = input.values[10];
        reaction.third[3] = input.values[13];
        reaction.stock[0] = input.values[14];
        reaction.stock[1] = input.values[15];
        reaction.stock[2] = input.values[16];
        reaction.stock[3] = input.values[17];
        reaction.cap = input.values[18];
        transition (reaction.species == 3 || reaction.species == 4) && reaction.bound >= 1 && reaction.bound <= 8 {
            true -> atoms(context, &reaction, input, 2)
            false -> invalid(context)
        }
    }
    state atoms(context: &mut Main, reaction: &chemistry::model::Reaction, input: &Input, index: u64) {
        transition index < 14 {
            true -> atom(context, reaction, input, index)
            false -> nonempty(context, reaction)
        }
    }
    state atom(context: &mut Main, reaction: &chemistry::model::Reaction, input: &Input, index: u64)
    requires index < 14 {
        transition input.values[index] <= 16 {
            true -> atoms(context, reaction, input, index + 1)
            false -> invalid(context)
        }
    }
    state nonempty(context: &mut Main, reaction: &chemistry::model::Reaction) {
        let first: i64 in Wrapping = reaction.first[0] + reaction.second[0] + reaction.third[0];
        let second: i64 in Wrapping = reaction.first[1] + reaction.second[1] + reaction.third[1];
        let third: i64 in Wrapping = reaction.first[2] + reaction.second[2] + reaction.third[2];
        let fourth: i64 in Wrapping = reaction.first[3] + reaction.second[3] + reaction.third[3];
        transition first > 0 && second > 0 && third > 0 {
            true -> fourth_species(context, reaction, fourth)
            false -> invalid(context)
        }
    }
    state fourth_species(context: &mut Main, reaction: &chemistry::model::Reaction, fourth: i64 in Wrapping) {
        transition (reaction.species == 4 && fourth > 0) || (reaction.species == 3 && fourth == 0 && reaction.stock[3] == 0) {
            true -> balance(context, reaction)
            false -> invalid(context)
        }
    }
    state balance(context: &mut Main, reaction: &chemistry::model::Reaction) {
        let mut result: chemistry::model::Balance;
        chemistry::balance::solve(reaction, &mut result);
        transition result.solutions > 0 && result.coefficients[0] > 0 && result.coefficients[1] > 0 {
            true -> batch(context, reaction, &result)
            false -> impossible(context)
        }
    }
    state batch(context: &mut Main, reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance)
    requires balance.coefficients[0] > 0 && balance.coefficients[1] > 0 {
        let mut result: chemistry::model::Batch;
        chemistry::inventory::process(reaction, balance, &mut result);
        transition result.overflow {
            true -> overflow(context, &result)
            false -> verify(context, reaction, balance, &result)
        }
    }
    state verify(context: &mut Main, reaction: &chemistry::model::Reaction, balance: &chemistry::model::Balance, batch: &chemistry::model::Batch) {
        let before_first: i64 in Wrapping = chemistry::model::element_total(&reaction.first, &reaction.stock);
        let before_second: i64 in Wrapping = chemistry::model::element_total(&reaction.second, &reaction.stock);
        let before_third: i64 in Wrapping = chemistry::model::element_total(&reaction.third, &reaction.stock);
        let after_first: i64 in Wrapping = chemistry::model::element_total(&reaction.first, &batch.inventory);
        let after_second: i64 in Wrapping = chemistry::model::element_total(&reaction.second, &batch.inventory);
        let after_third: i64 in Wrapping = chemistry::model::element_total(&reaction.third, &batch.inventory);
        transition before_first == after_first && before_second == after_second && before_third == after_third {
            true -> report(context, balance, batch, before_first, before_second, before_third)
            false -> corrupt(context)
        }
    }
    state report(context: &mut Main, balance: &chemistry::model::Balance, batch: &chemistry::model::Batch, first: i64 in Wrapping, second: i64 in Wrapping, third: i64 in Wrapping) {
        Console::write_line("BALANCED");
        Console::write("coefficients ");
        chemistry::report::line_four(&balance.coefficients);
        Console::write("primitive_solutions ");
        chemistry::report::line_number(balance.solutions);
        Console::write("extent ");
        chemistry::report::line_number(batch.extent);
        Console::write("limiting_mask ");
        chemistry::report::line_number(batch.limiting);
        Console::write("cap_limited ");
        chemistry::report::line_number(batch.cap_limited);
        Console::write("inventory ");
        chemistry::report::line_four(&batch.inventory);
        Console::write("elements ");
        chemistry::report::number(first);
        Console::write(" ");
        chemistry::report::number(second);
        Console::write(" ");
        chemistry::report::line_number(third);
        Console::write_line("CONSERVATION_OK");
        Console::exit_process(0);
    }
    state signature_mismatch(context: &mut Main) {
        Console::write_line("SIGNATURE_MISMATCH");
        Console::exit_process(71);
    }
    state invalid(context: &mut Main) {
        Console::write_line("INVALID_INPUT");
        Console::exit_process(64);
    }
    state impossible(context: &mut Main) {
        Console::write_line("NO_BALANCE_WITHIN_BOUND");
        Console::exit_process(65);
    }
    state overflow(context: &mut Main, result: &chemistry::model::Batch) {
        Console::write_line("OVERFLOW_REFUSED");
        Console::write("inventory ");
        chemistry::report::line_four(&result.inventory);
        Console::exit_process(66);
    }
    state corrupt(context: &mut Main) {
        Console::write_line("CONSERVATION_FAILURE");
        Console::exit_process(70);
    }
}

use omega_language_std::console;
use omega::language::core::numeric_conversion;

// ASCII decimal fields, whitespace separated, finite input <=1024 bytes.
// Refuse malformed, oversized and extra fields before exposing any reaction.
// Accumulation multiplies only values <=INT32_MAX, hence fits comfortably in i64.
machine Main::read(context: &mut Main, input: &mut Input) reaches Console {
    input.count = 0;
    input.status = 0;
    transition { _ -> scan(context, input, 0, false, 0) }
    state scan(context: &mut Main, input: &mut Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping) {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> end(context, input, value, digits)
            ByteRead::Byte { value as byte } -> byte_value(context, input, value, digits, consumed, byte)
        }
    }
    state byte_value(context: &mut Main, input: &mut Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping, byte: i32) {
        transition consumed < 1024 {
            true -> classify(context, input, value, digits, consumed + 1, byte)
            false -> invalid(input)
        }
    }
    state classify(context: &mut Main, input: &mut Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping, byte: i32) {
        transition byte >= 48 && byte <= 57 {
            true -> digit(context, input, value, consumed, byte)
            false -> separator(context, input, value, digits, consumed, byte)
        }
    }
    state digit(context: &mut Main, input: &mut Input, value: i64 in Wrapping, consumed: i64 in Wrapping, byte: i32) {
        let wide: i64 in Wrapping = widen_i32_to_i64(byte) as i64 in Wrapping;
        let next: i64 in Wrapping = value * 10 + wide - 48;
        transition next <= 2147483647 {
            true -> scan(context, input, next, true, consumed)
            false -> invalid(input)
        }
    }
    state separator(context: &mut Main, input: &mut Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping, byte: i32) {
        transition byte == 9 || byte == 10 || byte == 13 || byte == 32 {
            true -> whitespace(context, input, value, digits, consumed)
            false -> invalid(input)
        }
    }
    state whitespace(context: &mut Main, input: &mut Input, value: i64 in Wrapping, digits: bool, consumed: i64 in Wrapping) {
        transition digits {
            true -> commit(context, input, value, consumed)
            false -> scan(context, input, 0, false, consumed)
        }
    }
    state commit(context: &mut Main, input: &mut Input, value: i64 in Wrapping, consumed: i64 in Wrapping) {
        let index: u64 = input.count;
        transition index < 19 {
            true -> store(context, input, value, consumed, index)
            false -> invalid(input)
        }
    }
    state store(context: &mut Main, input: &mut Input, value: i64 in Wrapping, consumed: i64 in Wrapping, index: u64)
    requires index < 19 {
        input.values[index] = value;
        input.count = index + 1;
        transition { _ -> scan(context, input, 0, false, consumed) }
    }
    state end(context: &mut Main, input: &mut Input, value: i64 in Wrapping, digits: bool) {
        transition digits {
            true -> finish(input, value)
            false -> done()
        }
    }
    state finish(input: &mut Input, value: i64 in Wrapping) {
        let index: u64 = input.count;
        transition index < 19 {
            true -> final_store(input, value, index)
            false -> invalid(input)
        }
    }
    state final_store(input: &mut Input, value: i64 in Wrapping, index: u64)
    requires index < 19 {
        input.values[index] = value;
        input.count = index + 1;
    }
    state invalid(input: &mut Input) { input.status = 1; }
    state done() { }
}
