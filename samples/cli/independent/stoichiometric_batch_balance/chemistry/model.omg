module chemistry::model;

// Columns are species. Rows are three declared elemental axes, never inferred
// molecular weights. Species 0 and 1 are consumed, species 2 and 3 produced.
data Reaction {
    species: i64 in Wrapping;
    bound: i64 in Wrapping;
    first: [i64 in Wrapping; 4];
    second: [i64 in Wrapping; 4];
    third: [i64 in Wrapping; 4];
    stock: [i64 in Wrapping; 4];
    cap: i64 in Wrapping;
}

data Balance {
    coefficients: [i64 in Wrapping; 4];
    solutions: i64 in Wrapping;
    sum: i64 in Wrapping;
}

data Batch {
    inventory: [i64 in Wrapping; 4];
    extent: i64 in Wrapping;
    limiting: i64 in Wrapping;
    cap_limited: i64 in Wrapping;
    overflow: bool;
}

// Species count selects which coefficient signature a call produces.
// `active` is 3 or 4; `fourth` is the coefficient the absent product uses.
data Signature {
    active: i64 in Wrapping;
    fourth: i64 in Wrapping;
}

// One elemental row borrowed from the reaction that owns it.
data Held<'row> { row: &'row [i64 in Wrapping; 4]; }
data HeldWindow<'row> { values: &'row [i64 in Wrapping]; }

machine element_total(atoms: &[i64 in Wrapping; 4], inventory: &[i64 in Wrapping; 4]) -> i64 in Wrapping {
    atoms[0] * inventory[0] + atoms[1] * inventory[1]
        + atoms[2] * inventory[2] + atoms[3] * inventory[3]
}
