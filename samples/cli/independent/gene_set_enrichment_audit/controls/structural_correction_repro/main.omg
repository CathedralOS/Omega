use omega_language_std::console;
use exact;
data Main { }
machine Main::main(context: &mut Main) reaches Console {
    let byte: ByteRead = block Console::read_byte();
    transition byte {
        ByteRead::Eof -> calculate(context, 0)
        ByteRead::Byte { value } -> calculate(context, value as u64 in Wrapping)
    }
    state calculate(context: &mut Main, value: u64 in Wrapping) {
        let probability: Fraction = Fraction { numerator: value, denominator: 252 };
        let adjusted: Fraction = correction(probability, 1, probability, 2, probability, 3);
        transition adjusted.denominator > 0 { true -> done(context) false -> bad(context) }
    }
    state done(context: &mut Main) { Console::exit_process(0); }
    state bad(context: &mut Main) { Console::exit_process(1); }
}
machine correction(value: Fraction, rank: u64 in Wrapping, other: Fraction, other_rank: u64 in Wrapping, last: Fraction, last_rank: u64 in Wrapping) -> Fraction {
    let initial: Fraction = scaled(value, rank);
    transition other_rank > rank { true -> finish(initial, last, rank, last_rank, scaled(other, other_rank))
 false -> finish(initial, last, rank, last_rank, initial)
 }
    state finish(initial: Fraction, last: Fraction, rank: u64 in Wrapping, last_rank: u64 in Wrapping, candidate: Fraction) -> Fraction {
        let current: Fraction = minimum(initial, candidate);
        transition last_rank > rank { true -> minimum(current, scaled(last, last_rank))
 false -> current
 }
    }
}
