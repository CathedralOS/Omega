use omega_language_std::console;
data Fraction [copy] { numerator: u64 in Wrapping; denominator: u64 in Wrapping; }
machine make(value: u64 in Wrapping) -> Fraction { Fraction { numerator: value, denominator: 3 } }
machine calculate(flag: bool, value: u64 in Wrapping) -> u64 in Wrapping {
    let fraction: Fraction = make(value);
    transition flag {
        true -> sum(fraction, fraction)
        false -> sum(fraction, fraction)
    }
    state sum(first: Fraction, second: Fraction) -> u64 in Wrapping {
        first.numerator + second.denominator
    }
}
data Main { }
machine Main::main(context: &mut Main) reaches Console {
    let byte: ByteRead = block Console::read_byte();
    transition byte {
        ByteRead::Eof -> finish(context, 7)
        ByteRead::Byte { value } -> finish(context, value as u64 in Wrapping)
    }
    state finish(context: &mut Main, value: u64 in Wrapping) {
        let result: u64 in Wrapping = calculate(value > 70, value);
        transition result == value + 3 { true -> correct(context) false -> incorrect(context) }
    }
    state correct(context: &mut Main) { Console::exit_process(0); }
    state incorrect(context: &mut Main) { Console::exit_process(1);
    }
}
