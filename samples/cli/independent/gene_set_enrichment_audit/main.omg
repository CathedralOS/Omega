// Runtime data is supplied through five bounded newline-terminated rows.
use omega_language_std::console;
use omega::language::core::binding;
use domain::sets;
use domain::exact;
use domain::report;

data Main { console: Binding<Console>; }

machine Main::main(context: &mut Main) reaches Console {
    let universe: Parsed = block read_set(&context.console);
    let query: Parsed = block read_set(&context.console);
    let first: Parsed = block read_set(&context.console);
    let second: Parsed = block read_set(&context.console);
    let third: Parsed = block read_set(&context.console);
    let ended: bool = block end_input(&context.console);
    transition ended && universe.valid && query.valid && first.valid && second.valid && third.valid {
        true -> validate(context, universe, query, first, second, third)
        false -> reject(context)
    }
    state validate(context: &mut Main, universe: Parsed, query: Parsed, first: Parsed, second: Parsed, third: Parsed) {
        transition universe.mask != 0 && universe.duplicates == 0 && intersection(query.mask, universe.mask) == query.mask && intersection(first.mask, universe.mask) == first.mask && intersection(second.mask, universe.mask) == second.mask && intersection(third.mask, universe.mask) == third.mask {
            true -> analyze(context, universe, query, first, second, third)
            false -> reject(context)
        }
    }
    state analyze(context: &mut Main, universe: Parsed, query: Parsed, first: Parsed, second: Parsed, third: Parsed) {
        let total: u64 in Wrapping = size(universe.mask);
        let selected: u64 in Wrapping = size(query.mask);
        let one: Fraction = tail(total, size(first.mask), selected, size(intersection(first.mask, query.mask)));
        let two: Fraction = tail(total, size(second.mask), selected, size(intersection(second.mask, query.mask)));
        let three: Fraction = tail(total, size(third.mask), selected, size(intersection(third.mask, query.mask)));
        // Stable rank: ties retain annotation order. Reverse cumulative minimum is BH.
        let rank_one: u64 in Wrapping = ranking(one, two, three, 1);
        let rank_two: u64 in Wrapping = ranking(two, one, three, 2);
        let rank_three: u64 in Wrapping = ranking(three, one, two, 3);
        let adjusted_one: Fraction = correction(one, rank_one, two, rank_two, three, rank_three);
        let adjusted_two: Fraction = correction(two, rank_two, one, rank_one, three, rank_three);
        let adjusted_three: Fraction = correction(three, rank_three, one, rank_one, two, rank_two);
        context.console.write("N="); number(&context.console, total); context.console.write(" n="); number(&context.console, selected);
        context.console.write(" duplicate_query="); number(&context.console, query.duplicates);
        context.console.write(" duplicate_annotations="); number(&context.console, first.duplicates + second.duplicates + third.duplicates); context.console.write_line("");
        result(&context.console, 1, first.mask, intersection(first.mask, query.mask), one, adjusted_one, rank_one);
        result(&context.console, 2, second.mask, intersection(second.mask, query.mask), two, adjusted_two, rank_two);
        result(&context.console, 3, third.mask, intersection(third.mask, query.mask), three, adjusted_three, rank_three);
        context.console.exit_process(0);
    }
    state reject(context: &mut Main) { context.console.write_line("INVALID_INPUT"); context.console.exit_process(65); }
}

machine ranking(value: Fraction, other: Fraction, last: Fraction, identifier: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> first(value, other, last, identifier, 1) }
    state first(value: Fraction, other: Fraction, last: Fraction, identifier: u64 in Wrapping, rank: u64 in Wrapping) -> u64 in Wrapping {
        transition less(other, value) || (!less(value, other) && identifier > 1) {
            true -> second(value, last, identifier, rank + 1)
            false -> second(value, last, identifier, rank)
        }
    }
    state second(value: Fraction, last: Fraction, identifier: u64 in Wrapping, rank: u64 in Wrapping) -> u64 in Wrapping {
        transition less(last, value) || (!less(value, last) && identifier == 3) { true -> (rank + 1)
 false -> rank
 }
    }
}

machine correction(value: Fraction, rank: u64 in Wrapping, other: Fraction, other_rank: u64 in Wrapping, last: Fraction, last_rank: u64 in Wrapping) -> Fraction {
    let initial: Fraction = scaled(value, rank);
    transition other_rank > rank { true -> finish(initial, last, rank, last_rank, scaled(other, other_rank))
 false -> finish(initial, last, rank, last_rank, initial)
 }
    state finish(initial: Fraction, last: Fraction, rank: u64 in Wrapping, last_rank: u64 in Wrapping, candidate: Fraction) -> Fraction {
        let current: Fraction = minimum(initial, candidate);
        transition last_rank > rank { true -> minimum(current, scaled(last, last_rank))
 false -> current
 }
    }
}
