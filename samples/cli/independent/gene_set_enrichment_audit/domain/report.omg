use omega_language_std::console;
use domain::exact;
use domain::sets;

public machine number(value: u64 in Wrapping) reaches Console
invokes Console;
{
    // The declared model displays values at most 756. Subtraction extracts
    // its three decimal columns without retaining a division operand over IO.
    transition { _ -> hundreds(value, 0) }
    machine hundreds(left: u64 in Wrapping, count: u64 in Wrapping) {
        transition left >= 100 {
            true -> hundreds(left - 100, count + 1)
            false -> leading(left, count)
        }
    }
    machine leading(left: u64 in Wrapping, count: u64 in Wrapping) {
        transition count > 0 {
            true -> high(left, count)
            false -> tens(left, 0, false)
        }
    }
    machine high(left: u64 in Wrapping, count: u64 in Wrapping) {
        Console::write_byte((count % 10 + 48) as i32);
        transition { _ -> tens(left, 0, true) }
    }
    machine tens(left: u64 in Wrapping, count: u64 in Wrapping, high: bool) {
        transition left >= 10 {
            true -> tens(left - 10, count + 1, high)
            false -> middle(left, count, high)
        }
    }
    machine middle(left: u64 in Wrapping, count: u64 in Wrapping, high: bool) {
        transition count > 0 || high {
            true -> low(left, count)
            false -> units(left)
        }
    }
    machine low(left: u64 in Wrapping, count: u64 in Wrapping) {
        Console::write_byte((count % 10 + 48) as i32);
        transition { _ -> units(left) }
    }
    machine units(left: u64 in Wrapping) {
        Console::write_byte((left % 10 + 48) as i32);
    }
}

public machine fraction(value: Fraction) reaches Console
invokes Console;
{
    number(value.numerator); Console::write("/"); number(value.denominator);
}

public machine membership(mask: u64 in Wrapping) reaches Console
invokes Console;
{
    transition { _ -> step(mask, 0) }
    machine step(mask: u64 in Wrapping, gene: u64 in Wrapping) {
        transition gene < 10 { true -> inspect(mask, gene)
 false -> done()
 }
    }
    machine inspect(mask: u64 in Wrapping, gene: u64 in Wrapping) {
        transition member(mask, gene) { true -> emit(mask, gene)
 false -> step(mask, gene + 1)
 }
    }
    machine emit(mask: u64 in Wrapping, gene: u64 in Wrapping) {
        Console::write_byte((gene + 65) as i32);
        transition { _ -> step(mask, gene + 1) }
    }
    machine done() { }
}

public machine result(identifier: u64 in Wrapping, annotated: u64 in Wrapping, hits: u64 in Wrapping, probability: Fraction, adjusted: Fraction, rank: u64 in Wrapping) reaches Console
invokes Console;
{
    Console::write("set="); number(identifier);
    Console::write(" K="); number(size(annotated));
    Console::write(" hits="); number(size(hits));
    Console::write(" p="); fraction(probability);
    Console::write(" q="); fraction(adjusted);
    Console::write(" rank="); number(rank);
    Console::write(" members="); membership(annotated);
    Console::write(" overlap="); membership(hits); Console::write_line("");
}
