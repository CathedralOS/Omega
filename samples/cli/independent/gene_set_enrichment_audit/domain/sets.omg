// Ten synthetic IDs. Masks are private bounded set storage, not gene biology.
use omega_language_std::console;
use omega::language::core::binding;

pub data Parsed [copy] { mask: u64 in Wrapping; duplicates: u64 in Wrapping; valid: bool; }

pub machine power(gene: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> step(gene, 1) }
    state step(left: u64 in Wrapping, value: u64 in Wrapping) -> u64 in Wrapping {
        transition left == 0 { true -> value
 false -> step(left - 1, value * 2)
 }
    }
}

pub machine member(mask: u64 in Wrapping, gene: u64 in Wrapping) -> bool {
    transition { _ -> step(mask, gene) }
    state step(mask: u64 in Wrapping, gene: u64 in Wrapping) -> bool {
        transition gene == 0 {
            true -> (mask % 2 == 1)
            false -> step(mask / 2, gene - 1)
        }
    }
}

pub machine size(mask: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> step(mask, 0) }
    state step(left: u64 in Wrapping, count: u64 in Wrapping) -> u64 in Wrapping {
        transition left == 0 { true -> count
 false -> step(left / 2, count + left % 2)
 }
    }
}

pub machine intersection(left: u64 in Wrapping, right: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> step(left, right, 1, 0) }
    state step(left: u64 in Wrapping, right: u64 in Wrapping, weight: u64 in Wrapping, mask: u64 in Wrapping) -> u64 in Wrapping {
        transition left == 0 { true -> mask
 false -> add(left, right, weight, mask)
 }
    }
    state add(left: u64 in Wrapping, right: u64 in Wrapping, weight: u64 in Wrapping, mask: u64 in Wrapping) -> u64 in Wrapping {
        let bit: u64 in Wrapping = (left % 2) * (right % 2);
        transition { _ -> step(left / 2, right / 2, weight * 2, mask + bit * weight) }
    }
}

// Newline terminates each row; at most 63 IDs precede it. EOF and any other byte reject.
pub machine read_set(console: &Binding<Console>) -> Parsed reaches Console
invokes console;
blocks;
crashes Trap
{
    transition { _ -> scan(console, 0, 0, 0) }
    state scan(console: &Binding<Console>, mask: u64 in Wrapping, duplicates: u64 in Wrapping, count: u64 in Wrapping) -> Parsed {
        transition count < 64 { true -> read(console, mask, duplicates, count)
 false -> invalid()
 }
    }
    state read(console: &Binding<Console>, mask: u64 in Wrapping, duplicates: u64 in Wrapping, count: u64 in Wrapping) -> Parsed {
        let byte: ByteRead = block Console::read_byte(console);
        transition byte {
            ByteRead::Eof -> invalid()
            ByteRead::Byte { value } -> decode(console, mask, duplicates, count, value)
        }
    }
    state decode(console: &Binding<Console>, mask: u64 in Wrapping, duplicates: u64 in Wrapping, count: u64 in Wrapping, value: i32) -> Parsed {
        transition value == 10 {
            true -> Parsed { mask: mask, duplicates: duplicates, valid: true }
            false -> validate(console, mask, duplicates, count, value)
        }
    }
    state validate(console: &Binding<Console>, mask: u64 in Wrapping, duplicates: u64 in Wrapping, count: u64 in Wrapping, value: i32) -> Parsed {
        transition value >= 65 && value <= 74 {
            true -> insert(console, mask, duplicates, count, (value - 65) as u64 in Wrapping)
            false -> invalid()
        }
    }
    state insert(console: &Binding<Console>, mask: u64 in Wrapping, duplicates: u64 in Wrapping, count: u64 in Wrapping, gene: u64 in Wrapping) -> Parsed {
        let weight: u64 in Wrapping = power(gene);
        transition member(mask, gene) {
            true -> scan(console, mask, duplicates + 1, count + 1)
            false -> scan(console, mask + weight, duplicates, count + 1)
        }
    }
    state invalid() -> Parsed { Parsed { mask: 0, duplicates: 0, valid: false } }
}

pub machine end_input(console: &Binding<Console>) -> bool reaches Console
invokes console;
blocks;
crashes Trap
{
    let observed: ByteRead = block Console::read_byte(console);
    transition observed { ByteRead::Eof -> true
 ByteRead::Byte { value } -> false
 }
}
