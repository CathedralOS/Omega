// Expected exit: 2. (closed stdin; valid mode oracles are in data/.)
// Expected output contains: REJECT input: expected one byte 0,1,2,d
// ADD08: event-driven propagation, pulse cancellation, exhaustive steady truth.
// Calendar slots hold zero=absent, one=false, two=true. One gate can schedule
// at most one value per timestamp. Equal-time deliveries use ascending node ID.
use omega_language_std::console;
use model::netlist;

data Main {
    network: Network;
    calendar: [i32; 640];
    due: [u64; 9];
    time: u64;
    node: u64;
    gate: u64;
    row: u64;
    inertial: bool;
    fall: u64;
    glitches: u64;
    output_changes: u64;
    expected_changes: u64;
    trace: u64;
    expected_trace: u64;
}

machine Main::number(main: &mut Main, value: u64) reaches Console {
    // All reports are below 100; two ASCII decimal digits are emitted directly.
    Console::write_byte(((value % 100) / 10) as i32 + 48);
    Console::write_byte((value % 10) as i32 + 48);
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("logic_hazard_timing: mode 0=transport1 1=transport4 2=inertial4");
    let input: ByteRead = block Console::read_byte();
    transition input {
        ByteRead::Byte { value } -> mode(main, value)
        _ -> bad_input(main)
    }
    machine mode(main: &mut Main, value: i32) {
        transition value {
            48 -> setup(main, 1, false, 2, 58289)
            49 -> setup(main, 4, false, 2, 52296)
            50 -> setup(main, 4, true, 0, 13462)
            100 -> setup(main, 0, false, 0, 0)
            _ -> bad_input(main)
        }
    }
    machine setup(main: &mut Main, delay: u64, inertial: bool, changes: u64, trace: u64) {
        Network::configure(&mut main.network, delay);
        main.inertial = inertial;
        main.expected_changes = changes;
        main.expected_trace = trace;
        main.gate = 3;
        transition { _ -> validate(main) }
    }
    machine validate(main: &mut Main) {
        transition main.gate < 9 {
            true -> gate_valid(main)
            false -> truth_start(main)
        }
    }
    machine gate_valid(main: &mut Main) {
        let definition: Gate = main.network.gates[main.gate];
        transition definition.left < main.gate && definition.right < main.gate && definition.delay > 0 && definition.delay <= 8 && definition.kind >= 1 && definition.kind <= 3 {
            true -> next_validation(main)
            false -> bad_netlist(main)
        }
    }
    machine next_validation(main: &mut Main) {
        main.gate = (main.gate % 9) + 1;
        transition { _ -> validate(main) }
    }
    machine truth_start(main: &mut Main) {
        main.row = 0;
        transition { _ -> truth_row(main) }
    }
    machine truth_row(main: &mut Main) {
        transition main.row < 8 {
            true -> truth_inputs(main)
            false -> initial(main)
        }
    }
    machine truth_inputs(main: &mut Main) {
        main.network.values[0] = main.row / 4 == 1;
        main.network.values[1] = (main.row / 2) % 2 == 1;
        main.network.values[2] = main.row % 2 == 1;
        main.gate = 3;
        transition { _ -> truth_gates(main) }
    }
    machine truth_gates(main: &mut Main) {
        transition main.gate < 9 {
            true -> truth_compute(main)
            false -> truth_check(main)
        }
    }
    machine truth_compute(main: &mut Main) {
        let result: bool = Network::evaluate(&main.network, main.gate);
        main.network.values[main.gate] = result;
        main.gate = (main.gate % 9) + 1;
        transition { _ -> truth_gates(main) }
    }
    machine truth_check(main: &mut Main) {
        let expected: bool = (main.network.values[0] && main.network.values[1]) || (!main.network.values[0] && main.network.values[2]);
        transition main.network.values[6] == expected && main.network.values[8] == expected {
            true -> truth_report(main)
            false -> failed(main)
        }
    }
    machine truth_report(main: &mut Main) {
        Console::write("truth row=");
        let reported_row: u64 = main.row; Main::number(main, reported_row);
        Console::write(" value=");
        transition main.network.values[6] {
            true -> truth_one(main)
            false -> truth_zero(main)
        }
    }
    machine truth_one(main: &mut Main) { Console::write_line("1"); transition { _ -> truth_next(main) } }
    machine truth_zero(main: &mut Main) { Console::write_line("0"); transition { _ -> truth_next(main) } }
    machine truth_next(main: &mut Main) { main.row = (main.row % 8) + 1; transition { _ -> truth_row(main) } }
    machine initial(main: &mut Main) {
        main.network.values[0] = true;
        main.network.values[1] = true;
        main.network.values[2] = true;
        main.gate = 3;
        transition { _ -> initialize_gates(main) }
    }
    machine initialize_gates(main: &mut Main) {
        transition main.gate < 9 {
            true -> initialize_gate(main)
            false -> stimulus(main)
        }
    }
    machine initialize_gate(main: &mut Main) {
        let result: bool = Network::evaluate(&main.network, main.gate);
        main.network.values[main.gate] = result;
        main.network.desired[main.gate] = result;
        main.gate = (main.gate % 9) + 1;
        transition { _ -> initialize_gates(main) }
    }
    machine stimulus(main: &mut Main) {
        Console::write_line("initial nodes 0..8=111010111");
        main.calendar[100] = 1; // t=10, input a falls.
        main.time = 0;
        transition { _ -> clock(main) }
    }
    machine clock(main: &mut Main) {
        transition main.time < 32 {
            true -> begin_time(main)
            false -> verify(main)
        }
    }
    machine begin_time(main: &mut Main) { main.node = 0; transition { _ -> scan(main) } }
    machine scan(main: &mut Main) {
        transition main.node < 9 {
            true -> inspect(main)
            false -> next_time(main)
        }
    }
    machine inspect(main: &mut Main) {
        let slot: u64 = (main.time % 64) * 10 + (main.node % 10);
        let event: i32 = main.calendar[slot];
        transition event > 0 {
            true -> deliver(main, slot, event)
            false -> next_node(main)
        }
    }
    machine deliver(main: &mut Main, slot: u64, event: i32)
    requires slot < 640;
    {
        main.calendar[slot] = 0;
        let value: bool = event == 2;
        transition main.network.values[main.node] != value {
            true -> changed(main, value)
            false -> next_node(main)
        }
    }
    machine changed(main: &mut Main, value: bool) {
        main.network.values[main.node] = value;
        Console::write("wave t="); let reported_time: u64 = main.time; Main::number(main, reported_time);
        Console::write(" node="); let reported_node: u64 = main.node; Main::number(main, reported_node);
        Console::write(" value=");
        transition value { true -> emit_one(main) false -> emit_zero(main) }
    }
    machine emit_one(main: &mut Main) { main.trace = ((main.trace % 65521) * 17 + (main.time % 64) * 100 + (main.node % 10) * 2 + 1) % 65521; Console::write_line("1"); transition { _ -> observe(main) } }
    machine emit_zero(main: &mut Main) { main.trace = ((main.trace % 65521) * 17 + (main.time % 64) * 100 + (main.node % 10) * 2) % 65521; Console::write_line("0"); transition { _ -> observe(main) } }
    machine observe(main: &mut Main) {
        transition main.node == 6 { true -> observe_output(main) false -> reschedule(main) }
    }
    machine observe_output(main: &mut Main) {
        main.output_changes = (main.output_changes % 64) + 1;
        transition main.network.values[6] { false -> pulse_start(main) true -> pulse_end(main) }
    }
    machine pulse_start(main: &mut Main) { main.fall = main.time; transition { _ -> reschedule(main) } }
    machine pulse_end(main: &mut Main) {
        main.glitches = (main.glitches % 64) + 1;
        Console::write("glitch node=06 start="); let reported_fall: u64 = main.fall; Main::number(main, reported_fall);
        Console::write(" end="); let reported_time: u64 = main.time; Main::number(main, reported_time);
        Console::write(" width="); let reported_width: u64 = ((main.time % 64) + 64 - (main.fall % 64)) % 64; Main::number(main, reported_width);
        Console::write_line("");
        transition { _ -> reschedule(main) }
    }
    machine reschedule(main: &mut Main) { main.gate = 3; transition { _ -> gates(main) } }
    machine gates(main: &mut Main) {
        transition main.gate < 9 { true -> desired(main) false -> next_node(main) }
    }
    machine desired(main: &mut Main) {
        let value: bool = Network::evaluate(&main.network, main.gate);
        transition value != main.network.desired[main.gate] {
            true -> schedule(main, value)
            false -> next_gate(main)
        }
    }
    machine schedule(main: &mut Main, value: bool) {
        main.network.desired[main.gate] = value;
        transition main.inertial { true -> cancel(main, value) false -> enqueue(main, value) }
    }
    machine cancel(main: &mut Main, value: bool) {
        let previous: u64 = main.due[main.gate];
        transition previous < 640 { true -> clear(main, value, previous) false -> enqueue(main, value) }
    }
    machine clear(main: &mut Main, value: bool, previous: u64)
    requires previous < 640;
    { main.calendar[previous] = 0; transition { _ -> enqueue(main, value) } }
    machine enqueue(main: &mut Main, value: bool) {
        let definition: Gate = main.network.gates[main.gate];
        let arrival: u64 = (main.time % 64) + (definition.delay % 9);
        let slot: u64 = (arrival % 64) * 10 + (main.gate % 10);
        main.due[main.gate] = slot;
        transition value { true -> queue_one(main, slot) false -> queue_zero(main, slot) }
    }
    machine queue_one(main: &mut Main, slot: u64)
    requires slot < 640;
    { main.calendar[slot] = 2; transition { _ -> next_gate(main) } }
    machine queue_zero(main: &mut Main, slot: u64)
    requires slot < 640;
    { main.calendar[slot] = 1; transition { _ -> next_gate(main) } }
    machine next_gate(main: &mut Main) { main.gate = (main.gate % 9) + 1; transition { _ -> gates(main) } }
    machine next_node(main: &mut Main) { main.node = (main.node % 9) + 1; transition { _ -> scan(main) } }
    machine next_time(main: &mut Main) { main.time = (main.time % 32) + 1; transition { _ -> clock(main) } }
    machine verify(main: &mut Main) {
        transition main.trace == main.expected_trace && main.output_changes == main.expected_changes && main.glitches == main.expected_changes / 2 && main.network.values[6] && main.network.values[8] {
            true -> success(main)
            false -> failed(main)
        }
    }
    machine success(main: &mut Main) { Console::write_line("PASS truth=08 steady=1 consensus=1"); Console::exit_process(0); }
    machine failed(main: &mut Main) { Console::write_line("FAIL oracle"); Console::exit_process(1); }
    machine bad_input(main: &mut Main) { Console::write_line("REJECT input: expected one byte 0,1,2,d"); Console::exit_process(2); }
    machine bad_netlist(main: &mut Main) { Console::write_line("REJECT netlist: positive delay <=8 and acyclic valid gates required"); Console::exit_process(3); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
