// Private acyclic netlist. Inputs precede gates; every edge points backwards.
// Positive integral delays guarantee that scheduling cannot revisit this time.
public data Gate [copy] { kind: i32; left: u64; right: u64; delay: u64; }
public data Network { gates: [Gate; 9]; values: [bool; 9]; desired: [bool; 9]; }
public machine Network::configure(network: &mut Network, output_delay: u64) {
    network.gates[3] = Gate { kind: 1, left: 0, right: 0, delay: 2 };
    network.gates[4] = Gate { kind: 2, left: 0, right: 1, delay: 1 };
    network.gates[5] = Gate { kind: 2, left: 3, right: 2, delay: 2 };
    network.gates[6] = Gate { kind: 3, left: 4, right: 5, delay: output_delay };
    network.gates[7] = Gate { kind: 2, left: 1, right: 2, delay: 1 };
    network.gates[8] = Gate { kind: 3, left: 6, right: 7, delay: 1 };
}
public machine Network::evaluate(network: &Network, gate: u64) -> bool
requires gate < 9;
{
    let definition: Gate = network.gates[gate];
    transition definition.left < 9 && definition.right < 9 {
        true -> operands(network, definition)
        false -> invalid()
    }
    machine operands(network: &Network, definition: Gate) -> bool
    requires definition.left < 9 && definition.right < 9;
    {
        let left: bool = network.values[definition.left];
        let right: bool = network.values[definition.right];
        transition definition.kind {
            1 -> invert(left)
            2 -> conjunction(left, right)
            3 -> disjunction(left, right)
            _ -> invalid()
        }
    }
    machine invert(left: bool) -> bool { !left }
    machine conjunction(left: bool, right: bool) -> bool { left && right }
    machine disjunction(left: bool, right: bool) -> bool { left || right }
    machine invalid() -> bool { false }
}
