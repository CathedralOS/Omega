// Expected exit: 10.
// Expected output contains: error: input bounds or syntax
use omega_language_std::console;
use domain::model::SensorBlock;
use domain::model::SensorStream;
use domain::model::InputBuffer;
use domain::input::read_input;
use domain::input::parse_records;
use domain::input::parse_stream;
use domain::codec::encode;
use domain::codec::decode;
use domain::codec::certify;
use domain::report::report;

data Main { }

// The entry owns input, private codec storage, decoding and certification.
machine Main::main(main: &mut Main) reaches Console {
    let mut input: InputBuffer;
    let success: bool = block read_input(&mut input);
    transition success && input.length > 0 {
        true -> dispatch(main, &input)
        _ -> bad_input(main)
    }
    state dispatch(main: &mut Main, input: &InputBuffer) {
        transition input.bytes[0] {
            0 -> compress(main, input)
            1 -> decompress(main, input)
            _ -> bad_input(main)
        }
    }
    state compress(main: &mut Main, input: &InputBuffer) {
        let mut original: SensorBlock;
        let parsed: bool = parse_records(input, &mut original);
        transition parsed {
            true -> compression(main, &original)
            _ -> bad_input(main)
        }
    }
    state compression(main: &mut Main, original: &SensorBlock) {
        let mut stream: SensorStream;
        let success: bool = encode(original, &mut stream);
        transition success {
            true -> verification(main, original, &stream)
            _ -> bad_input(main)
        }
    }
    state verification(main: &mut Main, original: &SensorBlock, stream: &SensorStream) {
        let mut decoded: SensorBlock;
        let success: bool = decode(stream, &mut decoded);
        transition success {
            true -> certificate(main, original, stream, &decoded)
            _ -> bad_stream(main)
        }
    }
    state certificate(main: &mut Main, original: &SensorBlock, stream: &SensorStream, decoded: &SensorBlock) {
        let maximum: i32 = certify(original, decoded);
        transition maximum >= 0 {
            true -> output(main, stream, decoded, maximum)
            _ -> bad_certificate(main)
        }
    }
    state decompress(main: &mut Main, input: &InputBuffer) {
        let mut stream: SensorStream;
        let parsed: bool = parse_stream(input, &mut stream);
        transition parsed {
            true -> decoding(main, &stream)
            _ -> bad_input(main)
        }
    }
    state decoding(main: &mut Main, stream: &SensorStream) {
        let mut decoded: SensorBlock;
        let success: bool = decode(stream, &mut decoded);
        transition success {
            true -> output(main, stream, &decoded, -1)
            _ -> bad_stream(main)
        }
    }
    state output(main: &mut Main, stream: &SensorStream, decoded: &SensorBlock, maximum: i32) {
        report(stream, decoded, maximum);
    }
    state bad_input(main: &mut Main) { Console::write_line("error: input bounds or syntax"); Console::exit_process(10); }
    state bad_stream(main: &mut Main) { Console::write_line("error: malformed sensor stream"); Console::exit_process(12); }
    state bad_certificate(main: &mut Main) { Console::write_line("error: reconstruction certificate"); Console::exit_process(13); }
}
