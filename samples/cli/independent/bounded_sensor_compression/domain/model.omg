module domain::model;
// Private bounded storage. Runtime admission validates active extents before use.
pub data SensorBlock {
    values: [i32; 16];
    count: i32;
    tolerance: i32;
}
pub data SensorStream {
    bytes: [u8; 53];
    length: i32;
}
pub data InputBuffer {
    bytes: [u8; 56];
    length: i32;
}
