module domain::report;
use domain::model::SensorBlock;
use domain::model::SensorStream;
use domain::model::InputBuffer;
use omega_language_std::console;
use omega::language::core::binding;

// Render actual computed integers through the existing byte provider.
pub machine number(console: &mut Binding<Console>, value: i32) reaches Console
invokes console;
requires value >= 0 && value <= 99999 {
    transition { _ -> digit(console, value, 10000, false) }
    state digit(console: &mut Binding<Console>, value: i32, divisor: i32, started: bool) {
        transition divisor >= 1 && divisor <= 10000 && value >= 0 && value <= 99999 {
            true -> decide(console, value, divisor, started)
            _ -> done()
        }
    }
    state decide(console: &mut Binding<Console>, value: i32, divisor: i32, started: bool)
    requires divisor >= 1 && divisor <= 10000 && value >= 0 && value <= 99999 {
        transition started || value >= divisor || divisor == 1 {
            true -> emit(console, value, divisor)
            _ -> next(console, value, divisor, started)
        }
    }
    state emit(console: &mut Binding<Console>, value: i32, divisor: i32)
    requires divisor >= 1 && divisor <= 10000 && value >= 0 && value <= 99999 {
        console.write_byte(48 + value / divisor);
        transition { _ -> next(console, value % divisor, divisor, true) }
    }
    state next(console: &mut Binding<Console>, value: i32, divisor: i32, started: bool)
    requires divisor >= 1 && divisor <= 10000 {
        transition divisor > 1 {
            true -> digit(console, value, divisor / 10, started)
            _ -> done()
        }
    }
    state done() { }
}

pub machine report(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32) reaches Console
invokes console;
{
    console.write("bytes:");
    transition { _ -> bytes(console, stream, records, maximum, 0) }
    state bytes(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32, index: i32) {
        transition index >= 0 && index < stream.length && index < 53 {
            true -> byte(console, stream, records, maximum, index)
            _ -> reconstructed(console, stream, records, maximum)
        }
    }
    state byte(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32, index: i32)
    requires index >= 0 && index < 53 {
        console.write_byte(32);
        number(console, stream.bytes[index] as i32);
        transition { _ -> bytes(console, stream, records, maximum, index + 1) }
    }
    state reconstructed(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32) {
        console.write_byte(10);
        console.write("reconstruction:");
        transition { _ -> values(console, stream, records, maximum, 0) }
    }
    state values(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32, index: i32) {
        transition index >= 0 && index < records.count && index < 16 {
            true -> value(console, stream, records, maximum, index)
            _ -> sizes(console, stream, records, maximum)
        }
    }
    state value(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32, index: i32)
    requires index >= 0 && index < 16 {
        let value: i32 = records.values[index];
        transition value >= 0 && value <= 4095 {
            true -> emit_value(console, stream, records, maximum, index, value)
            _ -> failure(console)
        }
    }
    state emit_value(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32, index: i32, value: i32)
    requires index >= 0 && index < 16 && value >= 0 && value <= 4095 {
        console.write_byte(32);
        number(console, value);
        transition { _ -> values(console, stream, records, maximum, index + 1) }
    }
    state sizes(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32) {
        console.write_byte(10);
        transition records.count >= 1 && records.count <= 16 && stream.length >= 6 && stream.length <= 53 && records.tolerance >= 0 && records.tolerance <= 7 {
            true -> metrics(console, stream, records, maximum)
            _ -> failure(console)
        }
    }
    state metrics(console: &mut Binding<Console>, stream: &SensorStream, records: &SensorBlock, maximum: i32)
    requires records.count >= 1 && records.count <= 16 && stream.length >= 6 && stream.length <= 53 && records.tolerance >= 0 && records.tolerance <= 7 {
        console.write("raw_bytes: "); number(console, records.count * 2); console.write_byte(10);
        console.write("encoded_bytes: "); number(console, stream.length); console.write_byte(10);
        console.write("worst_bytes: "); number(console, 5 + records.count * 3); console.write_byte(10);
        console.write("tolerance_units: "); number(console, records.tolerance); console.write_byte(10);
        transition maximum >= 0 && maximum <= records.tolerance && maximum <= 99999 {
            true -> certified(console, maximum)
            _ -> unverified(console)
        }
    }
    state certified(console: &mut Binding<Console>, maximum: i32)
    requires maximum >= 0 && maximum <= 99999 {
        console.write("max_error_units: "); number(console, maximum); console.write_byte(10);
        console.write_line("certificate: verified against original records");
        console.exit_process(0);
    }
    state unverified(console: &mut Binding<Console>) {
        console.write_line("certificate: decode only; originals unavailable"); console.exit_process(0);
    }
    state failure(console: &mut Binding<Console>) {
        console.write_line("error: internal report bounds"); console.exit_process(13);
    }
}
