module domain::codec;
use omega_language_std::math;
use domain::model::SensorBlock;
use domain::model::SensorStream;
use domain::model::InputBuffer;

// Integer units are 1/16 degree C from an artificial ADC, [0,4095].
// Quantize onto the origin-anchored grid (2*E+1), ties impossible, clipping
// the upper endpoint to 4095. Predict from the previous reconstructed sample.
public machine quantize(value: i32, tolerance: i32) -> i32
requires value >= 0 && value <= 4095 && tolerance >= 0 && tolerance <= 7
{
    let step: i32 = tolerance * 2 + 1;
    let rounded: i32 = ((value + tolerance) / step) * step;
    min_i32(rounded, 4095)
}

public machine encode(records: &SensorBlock, stream: &mut SensorStream) -> bool {
    stream.length = 0;
    transition records.count >= 1 && records.count <= 16 && records.tolerance >= 0 && records.tolerance <= 7 {
        true -> header(records, stream)
        _ -> invalid()
    }
    machine header(records: &SensorBlock, stream: &mut SensorStream) -> bool
    requires records.count >= 1 && records.count <= 16 && records.tolerance >= 0 && records.tolerance <= 7 {
        stream.bytes[0] = 83;
        stream.bytes[1] = 67;
        stream.bytes[2] = 1;
        stream.bytes[3] = records.count as u8;
        stream.bytes[4] = records.tolerance as u8;
        transition { _ -> scan(records, stream, 0, 0, 5) }
    }
    machine scan(records: &SensorBlock, stream: &mut SensorStream, index: i32, previous: i32, cursor: i32) -> bool {
        transition index >= 0 && index < records.count && index < 16 && previous >= 0 && previous <= 4095 && cursor >= 5 && cursor <= 50 && records.tolerance >= 0 && records.tolerance <= 7 {
            true -> sample(records, stream, index, previous, cursor)
            _ -> finish(records, stream, index, cursor)
        }
    }
    machine sample(records: &SensorBlock, stream: &mut SensorStream, index: i32, previous: i32, cursor: i32) -> bool
    requires index >= 0 && index < 16 && previous >= 0 && previous <= 4095 && cursor >= 5 && cursor <= 50 && records.tolerance >= 0 && records.tolerance <= 7 {
        let value: i32 = records.values[index];
        transition value >= 0 && value <= 4095 {
            true -> rounded(records, stream, index, previous, cursor, quantize(value, records.tolerance))
            _ -> invalid()
        }
    }
    machine rounded(records: &SensorBlock, stream: &mut SensorStream, index: i32, previous: i32, cursor: i32, value: i32) -> bool {
        transition value >= 0 && value <= 4095 && previous >= 0 && previous <= 4095 && index >= 0 && index < 16 && cursor >= 5 && cursor <= 50 {
            true -> difference(records, stream, index, cursor, value, value - previous)
            _ -> invalid()
        }
    }
    machine difference(records: &SensorBlock, stream: &mut SensorStream, index: i32, cursor: i32, value: i32, delta: i32) -> bool
    requires index >= 0 && index < 16 && cursor >= 5 && cursor <= 50 && value >= 0 && value <= 4095 {
        transition delta >= -127 && delta <= 127 {
            true -> compact(records, stream, index, cursor, value, delta)
            _ -> absolute(records, stream, index, cursor, value)
        }
    }
    machine compact(records: &SensorBlock, stream: &mut SensorStream, index: i32, cursor: i32, value: i32, delta: i32) -> bool
    requires index >= 0 && index < 16 && cursor >= 5 && cursor <= 50 && delta >= -127 && delta <= 127 {
        stream.bytes[cursor] = (delta + 127) as u8;
        transition { _ -> scan(records, stream, index + 1, value, cursor + 1) }
    }
    machine absolute(records: &SensorBlock, stream: &mut SensorStream, index: i32, cursor: i32, value: i32) -> bool
    requires index >= 0 && index < 16 && cursor >= 5 && cursor <= 50 && value >= 0 && value <= 4095 {
        stream.bytes[cursor] = 255;
        stream.bytes[cursor + 1] = (value % 256) as u8;
        stream.bytes[cursor + 2] = (value / 256) as u8;
        transition { _ -> scan(records, stream, index + 1, value, cursor + 3) }
    }
    machine finish(records: &SensorBlock, stream: &mut SensorStream, index: i32, cursor: i32) -> bool {
        transition index == records.count && cursor >= 5 && cursor <= 53 {
            true -> complete(stream, cursor)
            _ -> invalid()
        }
    }
    machine complete(stream: &mut SensorStream, cursor: i32) -> bool { stream.length = cursor; true }
    machine invalid() -> bool { false }
}

// Independent byte decoder, no encoder state and no original readings.
// Reject noncanonical escapes and every length/bounds violation before reading.
public machine decode(stream: &SensorStream, records: &mut SensorBlock) -> bool {
    records.count = 0;
    transition stream.length >= 6 && stream.length <= 53 {
        true -> header(stream, records)
        _ -> invalid()
    }
    machine header(stream: &SensorStream, records: &mut SensorBlock) -> bool {
        let count: i32 = stream.bytes[3] as i32;
        let tolerance: i32 = stream.bytes[4] as i32;
        transition stream.bytes[0] == 83 && stream.bytes[1] == 67 && stream.bytes[2] == 1 && count >= 1 && count <= 16 && tolerance <= 7 {
            true -> begin(stream, records, count, tolerance)
            _ -> invalid()
        }
    }
    machine begin(stream: &SensorStream, records: &mut SensorBlock, count: i32, tolerance: i32) -> bool {
        records.count = count;
        records.tolerance = tolerance;
        transition { _ -> scan(stream, records, 0, 0, 5) }
    }
    machine scan(stream: &SensorStream, records: &mut SensorBlock, index: i32, previous: i32, cursor: i32) -> bool {
        transition index >= 0 && index < records.count && index < 16 && cursor >= 5 && cursor < stream.length && cursor < 53 && previous >= 0 && previous <= 4095 {
            true -> tag(stream, records, index, previous, cursor)
            _ -> finish(stream, records, index, cursor)
        }
    }
    machine tag(stream: &SensorStream, records: &mut SensorBlock, index: i32, previous: i32, cursor: i32) -> bool
    requires index >= 0 && index < 16 && cursor >= 5 && cursor < 53 && previous >= 0 && previous <= 4095 {
        let code: i32 = stream.bytes[cursor] as i32;
        transition code == 255 {
            true -> escape(stream, records, index, previous, cursor)
            _ -> reconstructed(stream, records, index, cursor + 1, previous + code - 127)
        }
    }
    machine escape(stream: &SensorStream, records: &mut SensorBlock, index: i32, previous: i32, cursor: i32) -> bool {
        transition cursor >= 5 && cursor <= 50 && cursor + 2 < stream.length {
            true -> absolute(stream, records, index, previous, cursor)
            _ -> invalid()
        }
    }
    machine absolute(stream: &SensorStream, records: &mut SensorBlock, index: i32, previous: i32, cursor: i32) -> bool
    requires cursor >= 5 && cursor <= 50 {
        let value: i32 = (stream.bytes[cursor + 1] as i32) + (stream.bytes[cursor + 2] as i32) * 256;
        transition previous >= 0 && previous <= 4095 && value >= 0 && value <= 4095 {
            true -> canonical(stream, records, index, cursor + 3, value, value - previous)
            _ -> invalid()
        }
    }
    machine canonical(stream: &SensorStream, records: &mut SensorBlock, index: i32, cursor: i32, value: i32, delta: i32) -> bool {
        transition delta < -127 || delta > 127 {
            true -> reconstructed(stream, records, index, cursor, value)
            _ -> invalid()
        }
    }
    machine reconstructed(stream: &SensorStream, records: &mut SensorBlock, index: i32, cursor: i32, value: i32) -> bool {
        transition index >= 0 && index < 16 && value >= 0 && value <= 4095 {
            true -> store(stream, records, index, cursor, value)
            _ -> invalid()
        }
    }
    machine store(stream: &SensorStream, records: &mut SensorBlock, index: i32, cursor: i32, value: i32) -> bool
    requires index >= 0 && index < 16 {
        records.values[index] = value;
        transition { _ -> scan(stream, records, index + 1, value, cursor) }
    }
    machine finish(stream: &SensorStream, records: &mut SensorBlock, index: i32, cursor: i32) -> bool {
        index == records.count && cursor == stream.length
    }
    machine invalid() -> bool { false }
}

// A posteriori certificate from original observations and decoded bytes.
// -1 denotes a failed certificate; zero tolerance is exact reconstruction.
public machine certify(original: &SensorBlock, decoded: &SensorBlock) -> i32 {
    transition original.count == decoded.count && original.count >= 1 && original.count <= 16 && original.tolerance >= 0 && original.tolerance <= 7 {
        true -> scan(original, decoded, 0, 0)
        _ -> invalid()
    }
    machine scan(original: &SensorBlock, decoded: &SensorBlock, index: i32, maximum: i32) -> i32 {
        transition index >= 0 && index < original.count && index < 16 {
            true -> sample(original, decoded, index, maximum)
            _ -> done(maximum)
        }
    }
    machine sample(original: &SensorBlock, decoded: &SensorBlock, index: i32, maximum: i32) -> i32
    requires index >= 0 && index < 16 {
        let first: i32 = original.values[index];
        let second: i32 = decoded.values[index];
        transition first >= 0 && first <= 4095 && second >= 0 && second <= 4095 {
            true -> error(original, decoded, index, maximum, abs_i32(first - second))
            _ -> invalid()
        }
    }
    machine error(original: &SensorBlock, decoded: &SensorBlock, index: i32, maximum: i32, difference: i32) -> i32 {
        transition index >= 0 && index < 16 && difference <= original.tolerance {
            true -> advance(original, decoded, index, max_i32(maximum, difference))
            _ -> invalid()
        }
    }
    machine advance(original: &SensorBlock, decoded: &SensorBlock, index: i32, maximum: i32) -> i32
    requires index >= 0 && index < 16 {
        transition { _ -> scan(original, decoded, index + 1, maximum) }
    }
    machine done(maximum: i32) -> i32 { maximum }
    machine invalid() -> i32 { -1 }
}
