// A matched mutable window over a complex amplitude row is held in a record
// field. A helper scales that window. The caller observes the scaled cell
// through a local, the field, a parameter, and a call result. The untouched
// half stays put.
// Expected exit: 0
use omega::language::core::float_operations;

data Complex [copy] { real: f64; imaginary: f64; }
data Held<'row> { cells: &'row mut [Complex]; }

machine half<'row>(row: &'row mut [Complex; 4], which: i64) -> &'row mut [Complex]
ensures result.len == 2
{
    match which {
        0 -> &mut row[0..2]
        _ -> &mut row[2..4]
    }
}

machine scale_pair(window: &mut [Complex], factor: f64)
requires window.len >= 2 {
    let first: Complex = window[0];
    let second: Complex = window[1];
    window[0] = Complex { real: first.real * factor, imaginary: first.imaginary * factor };
    window[1] = Complex { real: second.real * factor, imaginary: second.imaginary * factor };
}

machine cell_real(cell: Complex) -> f64 { cell.real }

machine scaled_real(window: &[Complex]) -> f64
requires window.len >= 1 {
    cell_real(window[0])
}

machine main() crashes Trap {
    let mut row: [Complex; 4] = [
        Complex { real: 1.0, imaginary: 0.5 },
        Complex { real: -1.0, imaginary: 0.25 },
        Complex { real: 3.0, imaginary: -2.0 },
        Complex { real: 4.0, imaginary: 8.0 }
    ];
    let right_real: f64 = row[2].real;
    let right_imaginary: f64 = row[2].imaginary;
    let far_real: f64 = row[3].real;
    let far_imaginary: f64 = row[3].imaginary;
    let view: &mut [Complex] = half(&mut row, 0);
    let mut held: Held = Held { cells: view };
    scale_pair(held.cells, 2.0);
    transition held.cells.len == 2 {
        true -> observe(&mut held, right_real, right_imaginary, far_real, far_imaginary)
        false -> bad()
    }
    state observe(held: &mut Held, right_real: f64, right_imaginary: f64, far_real: f64, far_imaginary: f64)
    requires held.cells.len == 2 {
        let local: Complex = held.cells[0];
        let through_field: f64 = held.cells[0].real;
        let through_parameter: f64 = cell_real(local);
        let through_call: f64 = scaled_real(held.cells);
        transition local.real == 2.0 && local.imaginary == 1.0
            && through_field == 2.0
            && through_parameter == 2.0
            && through_call == 2.0
            && held.cells[1].real == -2.0
            && held.cells[1].imaginary == 0.5
            && right_real == 3.0 && right_imaginary == -2.0
            && far_real == 4.0 && far_imaginary == 8.0
        {
            true -> done()
            false -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
