use omega::language::core::float_operations;
pub data Matrix<const Rows: u64, const Columns: u64> [copy]
where Rows >= 1 && Rows <= 4 && Columns >= 1 && Columns <= 4 {
    values: [f64; Rows * Columns];
}
pub data Problem {
    count: u64; source: [f64; 48]; target: [f64; 48]; weights: [f64; 16];
    source_center: [f64; 3]; target_center: [f64; 3]; total_weight: f64;
    covariance: Matrix<3, 3>; scatter: Matrix<3, 3>; matrix: Matrix<4, 4>; vectors: Matrix<4, 4>;
    rotation: Matrix<3, 3>; translation: [f64; 3]; quaternion: [f64; 4];
}
// A diagonal entry is `position * Extent + position`. The position is below
// the const extent, and that extent's ceiling keeps the product representable.
machine diagonal<const Extent: u64>(matrix: &Matrix<Extent, Extent>, index: u64) -> f64
requires Extent >= 1 && Extent <= 4, index < Extent
{
    let position: u64 = index;
    matrix.values[position * Extent + position]
}
// The unit quaternion representation restricts every candidate to SO(3).
// Maximizing the Davenport quadratic gives the weighted least-squares proper
// rotation, including the nonzero residual of reflected observations. Cyclic
// Jacobi sweeps use stable tangent rotations; an eigenvalue gap checks whether
// the optimum is identifiable. Source rank two admits noncollinear planes.
pub machine solve(problem: &mut Problem) -> bool {
    centers(problem, 0); normalize_centers(problem); covariance(problem, 0);
    let trace: f64 = diagonal<3>(&problem.scatter, 0) + diagonal<3>(&problem.scatter, 1) + diagonal<3>(&problem.scatter, 2);
    let area: f64 = problem.scatter.values[0] * problem.scatter.values[4] + problem.scatter.values[0] * problem.scatter.values[8] + problem.scatter.values[4] * problem.scatter.values[8]
        - problem.scatter.values[1] * problem.scatter.values[1] - problem.scatter.values[2] * problem.scatter.values[2] - problem.scatter.values[5] * problem.scatter.values[5];
    transition trace > 0.0 && area > 0.000000000001 * trace * trace {
        true -> diagonalize(problem)
        false -> bad()
    }
    state diagonalize(problem: &mut Problem) -> bool {
        initialize(problem); sweeps(problem, 0);
        transition { _ -> select(problem, 0, 1) }
    }
    state select(problem: &mut Problem, best: u64, index: u64) -> bool requires best < 4 {
        transition index < 4 { true -> compare(problem, best, index) false -> gap(problem, best, 0) }
    }
    state compare(problem: &mut Problem, best: u64, index: u64) -> bool requires best < 4, index < 4 {
        transition problem.matrix.values[index * 4 + index] > problem.matrix.values[best * 4 + best] {
            true -> select(problem, index, index + 1)
            false -> select(problem, best, index + 1)
        }
    }
    state gap(problem: &mut Problem, best: u64, index: u64) -> bool requires best < 4 {
        transition index < 4 { true -> test_gap(problem, best, index) false -> result(problem, best) }
    }
    state test_gap(problem: &mut Problem, best: u64, index: u64) -> bool requires best < 4, index < 4 {
        transition index == best || problem.matrix.values[best * 4 + best] - problem.matrix.values[index * 4 + index] > 0.000000000001 * magnitude(problem.matrix.values[best * 4 + best]) {
            true -> gap(problem, best, index + 1)
            false -> bad()
        }
    }
    state result(problem: &mut Problem, best: u64) -> bool requires best < 4 {
        problem.quaternion[0] = problem.vectors.values[0 + best];
        problem.quaternion[1] = problem.vectors.values[4 + best];
        problem.quaternion[2] = problem.vectors.values[8 + best];
        problem.quaternion[3] = problem.vectors.values[12 + best];
        rotation(problem); true
    }
    state bad() -> bool { false }
}
machine magnitude(value: f64) -> f64 { transition value < 0.0 { true -> negative(value) false -> positive(value) } state negative(value: f64) -> f64 { 0.0 - value } state positive(value: f64) -> f64 { value } }
machine centers(problem: &mut Problem, index: u64) {
    transition index < problem.count && index < 16 { true -> add(problem, index) false -> done() }
    state add(problem: &mut Problem, index: u64) requires index < 16 {
        let weight: f64 = problem.weights[index]; problem.total_weight = problem.total_weight + weight;
        problem.source_center[0] = problem.source_center[0] + weight * problem.source[index * 3 + 0]; problem.target_center[0] = problem.target_center[0] + weight * problem.target[index * 3 + 0];
        problem.source_center[1] = problem.source_center[1] + weight * problem.source[index * 3 + 1]; problem.target_center[1] = problem.target_center[1] + weight * problem.target[index * 3 + 1];
        problem.source_center[2] = problem.source_center[2] + weight * problem.source[index * 3 + 2]; problem.target_center[2] = problem.target_center[2] + weight * problem.target[index * 3 + 2];
        transition { _ -> centers(problem, index + 1) }
    }
    state done() { }
}
machine normalize_centers(problem: &mut Problem) {
    problem.source_center[0] = problem.source_center[0] / problem.total_weight; problem.target_center[0] = problem.target_center[0] / problem.total_weight;
    problem.source_center[1] = problem.source_center[1] / problem.total_weight; problem.target_center[1] = problem.target_center[1] / problem.total_weight;
    problem.source_center[2] = problem.source_center[2] / problem.total_weight; problem.target_center[2] = problem.target_center[2] / problem.total_weight;
}
machine covariance(problem: &mut Problem, index: u64) {
    transition index < problem.count && index < 16 { true -> add(problem, index) false -> done() }
    state add(problem: &mut Problem, index: u64) requires index < 16 {
        let weight: f64 = problem.weights[index] / problem.total_weight;
        let source0: f64 = problem.source[index * 3 + 0] - problem.source_center[0]; let target0: f64 = problem.target[index * 3 + 0] - problem.target_center[0];
        let source1: f64 = problem.source[index * 3 + 1] - problem.source_center[1]; let target1: f64 = problem.target[index * 3 + 1] - problem.target_center[1];
        let source2: f64 = problem.source[index * 3 + 2] - problem.source_center[2]; let target2: f64 = problem.target[index * 3 + 2] - problem.target_center[2];
        problem.covariance.values[0] = problem.covariance.values[0] + weight * source0 * target0; problem.scatter.values[0] = problem.scatter.values[0] + weight * source0 * source0;
        problem.covariance.values[1] = problem.covariance.values[1] + weight * source0 * target1; problem.scatter.values[1] = problem.scatter.values[1] + weight * source0 * source1;
        problem.covariance.values[2] = problem.covariance.values[2] + weight * source0 * target2; problem.scatter.values[2] = problem.scatter.values[2] + weight * source0 * source2;
        problem.covariance.values[3] = problem.covariance.values[3] + weight * source1 * target0; problem.scatter.values[3] = problem.scatter.values[3] + weight * source1 * source0;
        problem.covariance.values[4] = problem.covariance.values[4] + weight * source1 * target1; problem.scatter.values[4] = problem.scatter.values[4] + weight * source1 * source1;
        problem.covariance.values[5] = problem.covariance.values[5] + weight * source1 * target2; problem.scatter.values[5] = problem.scatter.values[5] + weight * source1 * source2;
        problem.covariance.values[6] = problem.covariance.values[6] + weight * source2 * target0; problem.scatter.values[6] = problem.scatter.values[6] + weight * source2 * source0;
        problem.covariance.values[7] = problem.covariance.values[7] + weight * source2 * target1; problem.scatter.values[7] = problem.scatter.values[7] + weight * source2 * source1;
        problem.covariance.values[8] = problem.covariance.values[8] + weight * source2 * target2; problem.scatter.values[8] = problem.scatter.values[8] + weight * source2 * source2;
        transition { _ -> covariance(problem, index + 1) }
    }
    state done() { }
}
machine initialize(problem: &mut Problem) {
    let c0: f64 = problem.covariance.values[0];
    let c1: f64 = problem.covariance.values[1];
    let c2: f64 = problem.covariance.values[2];
    let c3: f64 = problem.covariance.values[3];
    let c4: f64 = problem.covariance.values[4];
    let c5: f64 = problem.covariance.values[5];
    let c6: f64 = problem.covariance.values[6];
    let c7: f64 = problem.covariance.values[7];
    let c8: f64 = problem.covariance.values[8];
    problem.matrix.values[0] = c0 + c4 + c8;
    problem.matrix.values[1] = c5 - c7;
    problem.matrix.values[4] = c5 - c7;
    problem.matrix.values[2] = c6 - c2;
    problem.matrix.values[8] = c6 - c2;
    problem.matrix.values[3] = c1 - c3;
    problem.matrix.values[12] = c1 - c3;
    problem.matrix.values[5] = c0 - c4 - c8;
    problem.matrix.values[6] = c1 + c3;
    problem.matrix.values[9] = c1 + c3;
    problem.matrix.values[7] = c2 + c6;
    problem.matrix.values[13] = c2 + c6;
    problem.matrix.values[10] = 0.0 - c0 + c4 - c8;
    problem.matrix.values[11] = c5 + c7;
    problem.matrix.values[14] = c5 + c7;
    problem.matrix.values[15] = 0.0 - c0 - c4 + c8;
    problem.vectors.values[0] = 1.0;
    problem.vectors.values[5] = 1.0;
    problem.vectors.values[10] = 1.0;
    problem.vectors.values[15] = 1.0;
}
machine sweeps(problem: &mut Problem, iteration: u64) {
    transition iteration < 24 { true -> sweep(problem, iteration) false -> done() }
    state sweep(problem: &mut Problem, iteration: u64) {
        pair01(problem);
        pair02(problem);
        pair03(problem);
        pair12(problem);
        pair13(problem);
        pair23(problem);
        transition { _ -> sweeps(problem, iteration + 1) }
    }
    state done() { }
}
machine pair01(problem: &mut Problem) {
    let off: f64 = problem.matrix.values[1];
    transition magnitude(off) > 0.000000000000001 * (magnitude(problem.matrix.values[0]) + magnitude(problem.matrix.values[5])) { true -> rotate(problem, off) false -> done() }
    state rotate(problem: &mut Problem, off: f64) {
        let theta: f64 = (problem.matrix.values[5] - problem.matrix.values[0]) / (2.0 * off);
        let unsigned: f64 = 1.0 / (magnitude(theta) + F64::square_root(1.0 + theta * theta));
        let tangent: f64 = signed_tangent(unsigned, theta);
        let cosine: f64 = 1.0 / F64::square_root(1.0 + tangent * tangent);
        let sine: f64 = tangent * cosine;
        problem.matrix.values[0] = problem.matrix.values[0] - tangent * off;
        problem.matrix.values[5] = problem.matrix.values[5] + tangent * off;
        problem.matrix.values[1] = 0.0; problem.matrix.values[4] = 0.0;
        let left2: f64 = problem.matrix.values[8]; let right2: f64 = problem.matrix.values[9];
        problem.matrix.values[8] = cosine * left2 - sine * right2; problem.matrix.values[2] = cosine * left2 - sine * right2;
        problem.matrix.values[9] = sine * left2 + cosine * right2; problem.matrix.values[6] = sine * left2 + cosine * right2;
        let left3: f64 = problem.matrix.values[12]; let right3: f64 = problem.matrix.values[13];
        problem.matrix.values[12] = cosine * left3 - sine * right3; problem.matrix.values[3] = cosine * left3 - sine * right3;
        problem.matrix.values[13] = sine * left3 + cosine * right3; problem.matrix.values[7] = sine * left3 + cosine * right3;
        let vector_left0: f64 = problem.vectors.values[0]; let vector_right0: f64 = problem.vectors.values[1];
        problem.vectors.values[0] = cosine * vector_left0 - sine * vector_right0; problem.vectors.values[1] = sine * vector_left0 + cosine * vector_right0;
        let vector_left1: f64 = problem.vectors.values[4]; let vector_right1: f64 = problem.vectors.values[5];
        problem.vectors.values[4] = cosine * vector_left1 - sine * vector_right1; problem.vectors.values[5] = sine * vector_left1 + cosine * vector_right1;
        let vector_left2: f64 = problem.vectors.values[8]; let vector_right2: f64 = problem.vectors.values[9];
        problem.vectors.values[8] = cosine * vector_left2 - sine * vector_right2; problem.vectors.values[9] = sine * vector_left2 + cosine * vector_right2;
        let vector_left3: f64 = problem.vectors.values[12]; let vector_right3: f64 = problem.vectors.values[13];
        problem.vectors.values[12] = cosine * vector_left3 - sine * vector_right3; problem.vectors.values[13] = sine * vector_left3 + cosine * vector_right3;
    }
    state done() { }
}
machine pair02(problem: &mut Problem) {
    let off: f64 = problem.matrix.values[2];
    transition magnitude(off) > 0.000000000000001 * (magnitude(problem.matrix.values[0]) + magnitude(problem.matrix.values[10])) { true -> rotate(problem, off) false -> done() }
    state rotate(problem: &mut Problem, off: f64) {
        let theta: f64 = (problem.matrix.values[10] - problem.matrix.values[0]) / (2.0 * off);
        let unsigned: f64 = 1.0 / (magnitude(theta) + F64::square_root(1.0 + theta * theta));
        let tangent: f64 = signed_tangent(unsigned, theta);
        let cosine: f64 = 1.0 / F64::square_root(1.0 + tangent * tangent);
        let sine: f64 = tangent * cosine;
        problem.matrix.values[0] = problem.matrix.values[0] - tangent * off;
        problem.matrix.values[10] = problem.matrix.values[10] + tangent * off;
        problem.matrix.values[2] = 0.0; problem.matrix.values[8] = 0.0;
        let left1: f64 = problem.matrix.values[4]; let right1: f64 = problem.matrix.values[6];
        problem.matrix.values[4] = cosine * left1 - sine * right1; problem.matrix.values[1] = cosine * left1 - sine * right1;
        problem.matrix.values[6] = sine * left1 + cosine * right1; problem.matrix.values[9] = sine * left1 + cosine * right1;
        let left3: f64 = problem.matrix.values[12]; let right3: f64 = problem.matrix.values[14];
        problem.matrix.values[12] = cosine * left3 - sine * right3; problem.matrix.values[3] = cosine * left3 - sine * right3;
        problem.matrix.values[14] = sine * left3 + cosine * right3; problem.matrix.values[11] = sine * left3 + cosine * right3;
        let vector_left0: f64 = problem.vectors.values[0]; let vector_right0: f64 = problem.vectors.values[2];
        problem.vectors.values[0] = cosine * vector_left0 - sine * vector_right0; problem.vectors.values[2] = sine * vector_left0 + cosine * vector_right0;
        let vector_left1: f64 = problem.vectors.values[4]; let vector_right1: f64 = problem.vectors.values[6];
        problem.vectors.values[4] = cosine * vector_left1 - sine * vector_right1; problem.vectors.values[6] = sine * vector_left1 + cosine * vector_right1;
        let vector_left2: f64 = problem.vectors.values[8]; let vector_right2: f64 = problem.vectors.values[10];
        problem.vectors.values[8] = cosine * vector_left2 - sine * vector_right2; problem.vectors.values[10] = sine * vector_left2 + cosine * vector_right2;
        let vector_left3: f64 = problem.vectors.values[12]; let vector_right3: f64 = problem.vectors.values[14];
        problem.vectors.values[12] = cosine * vector_left3 - sine * vector_right3; problem.vectors.values[14] = sine * vector_left3 + cosine * vector_right3;
    }
    state done() { }
}
machine pair03(problem: &mut Problem) {
    let off: f64 = problem.matrix.values[3];
    transition magnitude(off) > 0.000000000000001 * (magnitude(problem.matrix.values[0]) + magnitude(problem.matrix.values[15])) { true -> rotate(problem, off) false -> done() }
    state rotate(problem: &mut Problem, off: f64) {
        let theta: f64 = (problem.matrix.values[15] - problem.matrix.values[0]) / (2.0 * off);
        let unsigned: f64 = 1.0 / (magnitude(theta) + F64::square_root(1.0 + theta * theta));
        let tangent: f64 = signed_tangent(unsigned, theta);
        let cosine: f64 = 1.0 / F64::square_root(1.0 + tangent * tangent);
        let sine: f64 = tangent * cosine;
        problem.matrix.values[0] = problem.matrix.values[0] - tangent * off;
        problem.matrix.values[15] = problem.matrix.values[15] + tangent * off;
        problem.matrix.values[3] = 0.0; problem.matrix.values[12] = 0.0;
        let left1: f64 = problem.matrix.values[4]; let right1: f64 = problem.matrix.values[7];
        problem.matrix.values[4] = cosine * left1 - sine * right1; problem.matrix.values[1] = cosine * left1 - sine * right1;
        problem.matrix.values[7] = sine * left1 + cosine * right1; problem.matrix.values[13] = sine * left1 + cosine * right1;
        let left2: f64 = problem.matrix.values[8]; let right2: f64 = problem.matrix.values[11];
        problem.matrix.values[8] = cosine * left2 - sine * right2; problem.matrix.values[2] = cosine * left2 - sine * right2;
        problem.matrix.values[11] = sine * left2 + cosine * right2; problem.matrix.values[14] = sine * left2 + cosine * right2;
        let vector_left0: f64 = problem.vectors.values[0]; let vector_right0: f64 = problem.vectors.values[3];
        problem.vectors.values[0] = cosine * vector_left0 - sine * vector_right0; problem.vectors.values[3] = sine * vector_left0 + cosine * vector_right0;
        let vector_left1: f64 = problem.vectors.values[4]; let vector_right1: f64 = problem.vectors.values[7];
        problem.vectors.values[4] = cosine * vector_left1 - sine * vector_right1; problem.vectors.values[7] = sine * vector_left1 + cosine * vector_right1;
        let vector_left2: f64 = problem.vectors.values[8]; let vector_right2: f64 = problem.vectors.values[11];
        problem.vectors.values[8] = cosine * vector_left2 - sine * vector_right2; problem.vectors.values[11] = sine * vector_left2 + cosine * vector_right2;
        let vector_left3: f64 = problem.vectors.values[12]; let vector_right3: f64 = problem.vectors.values[15];
        problem.vectors.values[12] = cosine * vector_left3 - sine * vector_right3; problem.vectors.values[15] = sine * vector_left3 + cosine * vector_right3;
    }
    state done() { }
}
machine pair12(problem: &mut Problem) {
    let off: f64 = problem.matrix.values[6];
    transition magnitude(off) > 0.000000000000001 * (magnitude(problem.matrix.values[5]) + magnitude(problem.matrix.values[10])) { true -> rotate(problem, off) false -> done() }
    state rotate(problem: &mut Problem, off: f64) {
        let theta: f64 = (problem.matrix.values[10] - problem.matrix.values[5]) / (2.0 * off);
        let unsigned: f64 = 1.0 / (magnitude(theta) + F64::square_root(1.0 + theta * theta));
        let tangent: f64 = signed_tangent(unsigned, theta);
        let cosine: f64 = 1.0 / F64::square_root(1.0 + tangent * tangent);
        let sine: f64 = tangent * cosine;
        problem.matrix.values[5] = problem.matrix.values[5] - tangent * off;
        problem.matrix.values[10] = problem.matrix.values[10] + tangent * off;
        problem.matrix.values[6] = 0.0; problem.matrix.values[9] = 0.0;
        let left0: f64 = problem.matrix.values[1]; let right0: f64 = problem.matrix.values[2];
        problem.matrix.values[1] = cosine * left0 - sine * right0; problem.matrix.values[4] = cosine * left0 - sine * right0;
        problem.matrix.values[2] = sine * left0 + cosine * right0; problem.matrix.values[8] = sine * left0 + cosine * right0;
        let left3: f64 = problem.matrix.values[13]; let right3: f64 = problem.matrix.values[14];
        problem.matrix.values[13] = cosine * left3 - sine * right3; problem.matrix.values[7] = cosine * left3 - sine * right3;
        problem.matrix.values[14] = sine * left3 + cosine * right3; problem.matrix.values[11] = sine * left3 + cosine * right3;
        let vector_left0: f64 = problem.vectors.values[1]; let vector_right0: f64 = problem.vectors.values[2];
        problem.vectors.values[1] = cosine * vector_left0 - sine * vector_right0; problem.vectors.values[2] = sine * vector_left0 + cosine * vector_right0;
        let vector_left1: f64 = problem.vectors.values[5]; let vector_right1: f64 = problem.vectors.values[6];
        problem.vectors.values[5] = cosine * vector_left1 - sine * vector_right1; problem.vectors.values[6] = sine * vector_left1 + cosine * vector_right1;
        let vector_left2: f64 = problem.vectors.values[9]; let vector_right2: f64 = problem.vectors.values[10];
        problem.vectors.values[9] = cosine * vector_left2 - sine * vector_right2; problem.vectors.values[10] = sine * vector_left2 + cosine * vector_right2;
        let vector_left3: f64 = problem.vectors.values[13]; let vector_right3: f64 = problem.vectors.values[14];
        problem.vectors.values[13] = cosine * vector_left3 - sine * vector_right3; problem.vectors.values[14] = sine * vector_left3 + cosine * vector_right3;
    }
    state done() { }
}
machine pair13(problem: &mut Problem) {
    let off: f64 = problem.matrix.values[7];
    transition magnitude(off) > 0.000000000000001 * (magnitude(problem.matrix.values[5]) + magnitude(problem.matrix.values[15])) { true -> rotate(problem, off) false -> done() }
    state rotate(problem: &mut Problem, off: f64) {
        let theta: f64 = (problem.matrix.values[15] - problem.matrix.values[5]) / (2.0 * off);
        let unsigned: f64 = 1.0 / (magnitude(theta) + F64::square_root(1.0 + theta * theta));
        let tangent: f64 = signed_tangent(unsigned, theta);
        let cosine: f64 = 1.0 / F64::square_root(1.0 + tangent * tangent);
