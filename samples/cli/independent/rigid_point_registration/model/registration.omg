        problem.matrix.values[15] = problem.matrix.values[15] + tangent * off;
        problem.matrix.values[7] = 0.0; problem.matrix.values[13] = 0.0;
        let left0: f64 = problem.matrix.values[1]; let right0: f64 = problem.matrix.values[3];
        problem.matrix.values[1] = cosine * left0 - sine * right0; problem.matrix.values[4] = cosine * left0 - sine * right0;
        problem.matrix.values[3] = sine * left0 + cosine * right0; problem.matrix.values[12] = sine * left0 + cosine * right0;
        let left2: f64 = problem.matrix.values[9]; let right2: f64 = problem.matrix.values[11];
        problem.matrix.values[9] = cosine * left2 - sine * right2; problem.matrix.values[6] = cosine * left2 - sine * right2;
        problem.matrix.values[11] = sine * left2 + cosine * right2; problem.matrix.values[14] = sine * left2 + cosine * right2;
        let vector_left0: f64 = problem.vectors.values[1]; let vector_right0: f64 = problem.vectors.values[3];
        problem.vectors.values[1] = cosine * vector_left0 - sine * vector_right0; problem.vectors.values[3] = sine * vector_left0 + cosine * vector_right0;
        let vector_left1: f64 = problem.vectors.values[5]; let vector_right1: f64 = problem.vectors.values[7];
        problem.vectors.values[5] = cosine * vector_left1 - sine * vector_right1; problem.vectors.values[7] = sine * vector_left1 + cosine * vector_right1;
        let vector_left2: f64 = problem.vectors.values[9]; let vector_right2: f64 = problem.vectors.values[11];
        problem.vectors.values[9] = cosine * vector_left2 - sine * vector_right2; problem.vectors.values[11] = sine * vector_left2 + cosine * vector_right2;
        let vector_left3: f64 = problem.vectors.values[13]; let vector_right3: f64 = problem.vectors.values[15];
        problem.vectors.values[13] = cosine * vector_left3 - sine * vector_right3; problem.vectors.values[15] = sine * vector_left3 + cosine * vector_right3;
    }
    state done() { }
}
machine pair23(problem: &mut Problem) {
    let off: f64 = problem.matrix.values[11];
    transition magnitude(off) > 0.000000000000001 * (magnitude(problem.matrix.values[10]) + magnitude(problem.matrix.values[15])) { true -> rotate(problem, off) false -> done() }
    state rotate(problem: &mut Problem, off: f64) {
        let theta: f64 = (problem.matrix.values[15] - problem.matrix.values[10]) / (2.0 * off);
        let unsigned: f64 = 1.0 / (magnitude(theta) + F64::square_root(1.0 + theta * theta));
        let tangent: f64 = signed_tangent(unsigned, theta);
        let cosine: f64 = 1.0 / F64::square_root(1.0 + tangent * tangent);
        let sine: f64 = tangent * cosine;
        problem.matrix.values[10] = problem.matrix.values[10] - tangent * off;
        problem.matrix.values[15] = problem.matrix.values[15] + tangent * off;
        problem.matrix.values[11] = 0.0; problem.matrix.values[14] = 0.0;
        let left0: f64 = problem.matrix.values[2]; let right0: f64 = problem.matrix.values[3];
        problem.matrix.values[2] = cosine * left0 - sine * right0; problem.matrix.values[8] = cosine * left0 - sine * right0;
        problem.matrix.values[3] = sine * left0 + cosine * right0; problem.matrix.values[12] = sine * left0 + cosine * right0;
        let left1: f64 = problem.matrix.values[6]; let right1: f64 = problem.matrix.values[7];
        problem.matrix.values[6] = cosine * left1 - sine * right1; problem.matrix.values[9] = cosine * left1 - sine * right1;
        problem.matrix.values[7] = sine * left1 + cosine * right1; problem.matrix.values[13] = sine * left1 + cosine * right1;
        let vector_left0: f64 = problem.vectors.values[2]; let vector_right0: f64 = problem.vectors.values[3];
        problem.vectors.values[2] = cosine * vector_left0 - sine * vector_right0; problem.vectors.values[3] = sine * vector_left0 + cosine * vector_right0;
        let vector_left1: f64 = problem.vectors.values[6]; let vector_right1: f64 = problem.vectors.values[7];
        problem.vectors.values[6] = cosine * vector_left1 - sine * vector_right1; problem.vectors.values[7] = sine * vector_left1 + cosine * vector_right1;
        let vector_left2: f64 = problem.vectors.values[10]; let vector_right2: f64 = problem.vectors.values[11];
        problem.vectors.values[10] = cosine * vector_left2 - sine * vector_right2; problem.vectors.values[11] = sine * vector_left2 + cosine * vector_right2;
        let vector_left3: f64 = problem.vectors.values[14]; let vector_right3: f64 = problem.vectors.values[15];
        problem.vectors.values[14] = cosine * vector_left3 - sine * vector_right3; problem.vectors.values[15] = sine * vector_left3 + cosine * vector_right3;
    }
    state done() { }
}
machine signed_tangent(value: f64, theta: f64) -> f64 { transition theta < 0.0 { true -> negative(value) false -> positive(value) } state negative(value: f64) -> f64 { 0.0 - value } state positive(value: f64) -> f64 { value } }
machine rotation(problem: &mut Problem) {
    let norm: f64 = F64::square_root(problem.quaternion[0] * problem.quaternion[0] + problem.quaternion[1] * problem.quaternion[1] + problem.quaternion[2] * problem.quaternion[2] + problem.quaternion[3] * problem.quaternion[3]);
    let w: f64 = problem.quaternion[0] / norm; let x: f64 = problem.quaternion[1] / norm; let y: f64 = problem.quaternion[2] / norm; let z: f64 = problem.quaternion[3] / norm;
    problem.rotation.values[0] = 1.0 - 2.0 * (y*y + z*z); problem.rotation.values[1] = 2.0 * (x*y - z*w); problem.rotation.values[2] = 2.0 * (x*z + y*w);
    problem.rotation.values[3] = 2.0 * (x*y + z*w); problem.rotation.values[4] = 1.0 - 2.0 * (x*x + z*z); problem.rotation.values[5] = 2.0 * (y*z - x*w);
    problem.rotation.values[6] = 2.0 * (x*z - y*w); problem.rotation.values[7] = 2.0 * (y*z + x*w); problem.rotation.values[8] = 1.0 - 2.0 * (x*x + y*y);
    problem.translation[0] = problem.target_center[0] - problem.rotation.values[0] * problem.source_center[0] - problem.rotation.values[1] * problem.source_center[1] - problem.rotation.values[2] * problem.source_center[2];
    problem.translation[1] = problem.target_center[1] - problem.rotation.values[3] * problem.source_center[0] - problem.rotation.values[4] * problem.source_center[1] - problem.rotation.values[5] * problem.source_center[2];
    problem.translation[2] = problem.target_center[2] - problem.rotation.values[6] * problem.source_center[0] - problem.rotation.values[7] * problem.source_center[1] - problem.rotation.values[8] * problem.source_center[2];
}
