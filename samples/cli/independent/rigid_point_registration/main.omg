// Expected exit: 64.
// Expected output contains: error invalid input
use omega_language_std::console;
use io::input;
use model::registration;
use io::output;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut raw: Raw;
    let accepted: bool = block read(&mut raw);
    transition accepted { true -> validate(&raw) false -> invalid() }
    machine validate(raw: &Raw) {
        let mut problem: Problem;
        transition decode(raw, &mut problem) { true -> fit(&mut problem) false -> invalid() }
    }
    machine fit(problem: &mut Problem) {
        transition solve(problem) { true -> report(problem) false -> unidentified() }
    }
    machine report(problem: &Problem) { emit(problem); Console::exit_process(0); }
    machine unidentified() { Console::write_line("status non-identifiable"); Console::exit_process(2); }
    machine invalid() { Console::write_line("error invalid input"); Console::exit_process(64); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
