// Storage is invocation-local. Accepted costs are at most 3501; the unused
// plan-cost sentinel is 10000. All arithmetic fits its explicit i32 carrier.
data Problem {
    horizon: i32 in Wrapping;
    initial: i32 in Wrapping;
    target: i32 in Wrapping;
    lower: i32 in Wrapping;
    upper: i32 in Wrapping;
    action_lower: i32 in Wrapping;
    action_upper: i32 in Wrapping;
    state_weight: i32 in Wrapping;
    action_weight: i32 in Wrapping;
    terminal_weight: i32 in Wrapping;
    drift: i32 in Wrapping;
    exact_terminal: bool;
}
data Plan {
    candidates: i32 in Wrapping;
    feasible: i32 in Wrapping;
    boundary_rejected: i32 in Wrapping;
    terminal_rejected: i32 in Wrapping;
    code: i32 in Wrapping;
    cost: i32 in Wrapping;
}
machine valid_problem(problem: &Problem) -> bool {
    problem.horizon >= 1 && problem.horizon <= 5
        && problem.lower >= 0 - 4 && problem.upper <= 4 && problem.lower <= problem.upper
        && problem.initial >= problem.lower && problem.initial <= problem.upper
        && problem.target >= 0 - 4 && problem.target <= 4
        && problem.action_lower >= 0 - 1 && problem.action_upper <= 1
        && problem.action_lower <= problem.action_upper
        && problem.drift >= 0 - 1 && problem.drift <= 1
        && problem.state_weight >= 0 && problem.state_weight <= 9
        && problem.action_weight >= 0 && problem.action_weight <= 9
        && problem.terminal_weight >= 0 && problem.terminal_weight <= 9
}
machine power_three(exponent: i32 in Wrapping) -> i32 in Wrapping {
    transition { _ -> multiply(exponent, 1) }
    machine multiply(exponent: i32 in Wrapping, value: i32 in Wrapping) -> i32 in Wrapping {
        transition exponent > 0 {
            true -> multiply(exponent - 1, value * 3)
            _ -> (value)
        }
    }
}
