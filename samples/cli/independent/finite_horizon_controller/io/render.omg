use omega_language_std::console;
use controller::model;
// Decimal output is computed from the result, with no expected-value strings.
machine number(value: i32 in Wrapping) reaches Console {
    transition value < 0 {
        true -> negative(value)
        _ -> magnitude(value)
    }
    state negative(value: i32 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> magnitude(0 - value) }
    }
    state magnitude(value: i32 in Wrapping) {
        transition { _ -> scale(value, 1) }
    }
    state scale(value: i32 in Wrapping, divisor: i32 in Wrapping) {
        transition divisor > 0 {
            true -> scale_positive(value, divisor)
            _ -> done()
        }
    }
    state scale_positive(value: i32 in Wrapping, divisor: i32 in Wrapping) {
        transition value / divisor >= 10 && divisor <= 100000000 {
            true -> scale(value, divisor * 10)
            _ -> digit(value, divisor)
        }
    }
    state digit(value: i32 in Wrapping, divisor: i32 in Wrapping) {
        transition divisor > 0 {
            true -> digit_positive(value, divisor)
            _ -> done()
        }
    }
    state digit_positive(value: i32 in Wrapping, divisor: i32 in Wrapping) {
        Console::write_byte((value / divisor % 10 + 48) as i32);
        transition divisor > 1 {
            true -> digit(value, divisor / 10)
            _ -> done()
        }
    }
    state done() { }
}
machine report(problem: &Problem, plan: &Plan) reaches Console {
    Console::write("candidates="); number(plan.candidates); Console::write_line("");
    Console::write("feasible="); number(plan.feasible); Console::write_line("");
    Console::write("boundary_rejected="); number(plan.boundary_rejected); Console::write_line("");
    Console::write("terminal_rejected="); number(plan.terminal_rejected); Console::write_line("");
    transition plan.feasible > 0 {
        true -> chosen(problem, plan)
        _ -> infeasible()
    }
    state infeasible() {
        Console::write_line("INFEASIBLE: every sequence violates a step constraint or terminal equality");
        Console::exit_process(3);
    }
    state chosen(problem: &Problem, plan: &Plan) {
        Console::write("cost="); number(plan.cost); Console::write_line("");
        Console::write("initial="); number(problem.initial); Console::write_line("");
        let divisor: i32 in Wrapping = power_three(problem.horizon - 1);
        transition { _ -> step(problem, plan, 0, divisor, problem.initial) }
    }
    state step(problem: &Problem, plan: &Plan,
               time: i32 in Wrapping, divisor: i32 in Wrapping, position: i32 in Wrapping) {
        transition divisor > 0 {
            true -> emit(problem, plan, time, divisor, position)
            _ -> finish()
        }
    }
    state emit(problem: &Problem, plan: &Plan,
               time: i32 in Wrapping, divisor: i32 in Wrapping, position: i32 in Wrapping) {
        let action: i32 in Wrapping = plan.code / divisor % 3 - 1;
        let next: i32 in Wrapping = position + action + problem.drift;
        Console::write("step="); number(time);
        Console::write(" action="); number(action);
        Console::write(" state="); number(next); Console::write_line("");
        transition { _ -> step(problem, plan, time + 1, divisor / 3, next) }
    }
    state finish() {
        Console::write_line("OPTIMAL: lexicographically smallest minimum-cost sequence");
        Console::exit_process(0);
    }
}
