// Offline controller: input selection, validation, exhaustive search, reporting.
// No source outside this application supplies any controller algorithm.
use omega_language_std::console;
use controller::model;
use controller::search;
use data::fixtures;
use io::render;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("IND07 finite horizon controller: select 0..7");
    let mut input: [u8; 8];
    let observed: LineReadResult = block Console::read_line(&mut input);
    transition observed {
        LineReadResult::LineComplete { count } -> parse(main, &input, count)
        _ -> bad_input(main)
    }
    state parse(main: &mut Main, input: &[u8; 8], count: u64) {
        transition count == 2 && input[0] >= 48 && input[0] <= 55 && input[1] == 10 {
            true -> selected(main, input[0] as i32 - 48)
            _ -> bad_input(main)
        }
    }
    state selected(main: &mut Main, selector: i32) {
        let mut problem: Problem;
        load_case(&mut problem, selector);
        let valid: bool = valid_problem(&problem);
        transition valid {
            true -> solve(main, &problem)
            _ -> bad_problem(main)
        }
    }
    state solve(main: &mut Main, problem: &Problem) {
        let mut plan: Plan;
        optimize(problem, &mut plan);
        report(problem, &plan);
    }
    state bad_input(main: &mut Main) {
        Console::write_line("INVALID: expected one selector digit and LF");
        Console::exit_process(2);
    }
    state bad_problem(main: &mut Main) {
        Console::write_line("INVALID: problem outside supported bounds");
        Console::exit_process(2);
    }
}
