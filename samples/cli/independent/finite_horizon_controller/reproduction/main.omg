// Complete positive control: a local fixed byte buffer crosses a case edge
// after the standard input provider filled it. With input 0 LF, exit 70.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut input: [u8; 8];
    let observed: LineReadResult = block Console::read_line(&mut input);
    transition observed {
        LineReadResult::LineComplete { count } -> inspect(main, &input, count)
        _ -> bad(main)
    }
    state inspect(main: &mut Main, input: &[u8; 8], count: u64) {
        transition count == 2 && input[0] == 48 && input[1] == 10 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(2); }
}
