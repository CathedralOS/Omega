use controller::model;
// Mirrored input fixtures, independently enumerated in reference.py.
machine load_case(problem: &mut Problem, selector: i32) {
    transition selector {
        0 -> case_0(problem)
        1 -> case_1(problem)
        2 -> case_2(problem)
        3 -> case_3(problem)
        4 -> case_4(problem)
        5 -> case_5(problem)
        6 -> case_6(problem)
        7 -> case_7(problem)
        _ -> done()
    }
    machine case_0(problem: &mut Problem) {
        problem.horizon = 4;
        problem.initial = 3;
        problem.target = 0;
        problem.lower = 0 - 3;
        problem.upper = 3;
        problem.action_lower = 0 - 1;
        problem.action_upper = 1;
        problem.state_weight = 1;
        problem.action_weight = 1;
        problem.terminal_weight = 4;
        problem.drift = 0;
        problem.exact_terminal = false;
    }
    machine case_1(problem: &mut Problem) {
        problem.horizon = 4;
        problem.initial = 0;
        problem.target = 3;
        problem.lower = 0;
        problem.upper = 2;
        problem.action_lower = 0 - 1;
        problem.action_upper = 1;
        problem.state_weight = 1;
        problem.action_weight = 1;
        problem.terminal_weight = 4;
        problem.drift = 0;
        problem.exact_terminal = false;
    }
    machine case_2(problem: &mut Problem) {
        problem.horizon = 2;
        problem.initial = 0;
        problem.target = 0;
        problem.lower = 0 - 2;
        problem.upper = 2;
        problem.action_lower = 0 - 1;
        problem.action_upper = 1;
        problem.state_weight = 0;
        problem.action_weight = 0;
        problem.terminal_weight = 0;
        problem.drift = 0;
        problem.exact_terminal = false;
    }
    machine case_3(problem: &mut Problem) {
        problem.horizon = 2;
        problem.initial = 0;
        problem.target = 3;
        problem.lower = 0 - 3;
        problem.upper = 3;
        problem.action_lower = 0 - 1;
        problem.action_upper = 1;
        problem.state_weight = 1;
        problem.action_weight = 1;
        problem.terminal_weight = 4;
        problem.drift = 0;
        problem.exact_terminal = true;
    }
    machine case_4(problem: &mut Problem) {
        problem.horizon = 5;
        problem.initial = 0;
        problem.target = 1;
        problem.lower = 0 - 1;
        problem.upper = 2;
        problem.action_lower = 0 - 1;
        problem.action_upper = 0;
        problem.state_weight = 2;
        problem.action_weight = 3;
        problem.terminal_weight = 5;
        problem.drift = 1;
        problem.exact_terminal = true;
    }
    machine case_5(problem: &mut Problem) {
        problem.horizon = 3;
        problem.initial = 0;
        problem.target = 0;
        problem.lower = 0;
        problem.upper = 0;
        problem.action_lower = 0;
        problem.action_upper = 1;
        problem.state_weight = 1;
        problem.action_weight = 1;
        problem.terminal_weight = 1;
        problem.drift = 1;
        problem.exact_terminal = false;
    }
    machine case_6(problem: &mut Problem) {
        problem.horizon = 6;
        problem.initial = 0;
        problem.target = 0;
        problem.lower = 0 - 1;
        problem.upper = 1;
        problem.action_lower = 0 - 1;
        problem.action_upper = 1;
        problem.state_weight = 1;
        problem.action_weight = 1;
        problem.terminal_weight = 1;
        problem.drift = 0;
        problem.exact_terminal = false;
    }
    machine case_7(problem: &mut Problem) {
        problem.horizon = 3;
        problem.initial = 0;
        problem.target = 0;
        problem.lower = 2;
        problem.upper = 0 - 2;
        problem.action_lower = 0 - 1;
        problem.action_upper = 1;
        problem.state_weight = 1;
        problem.action_weight = 1;
        problem.terminal_weight = 1;
        problem.drift = 0;
        problem.exact_terminal = false;
    }
    machine done() { }
}
