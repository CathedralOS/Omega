// Private classical laminate model: engineering shear, centered thickness,
// synthetic plane-stress Q=(12,4,1,2). No external numerical package.
use omega::language::core::float_operations;
public data Laminate {
    count: u64;
    thickness: [f64; 4];
    m2: [f64; 4];
    n2: [f64; 4];
    mn: [f64; 4];
    z: [f64; 5];
    stiffness: [[[f64; 3]; 3]; 4];
    a: [[f64; 3]; 3];
    b: [[f64; 3]; 3];
    d: [[f64; 3]; 3];
    augmented: [[f64; 7]; 6];
    response: [f64; 6];
    stress: [[f64; 3]; 4];
    singular: bool;
}
public machine absolute(value: f64) -> f64 {
    transition value < 0.0 { true -> negative(value) false -> positive(value) }
    machine negative(value: f64) -> f64 { 0.0 - value }
    machine positive(value: f64) -> f64 { value }
}
public machine transform(out: &mut [[f64; 3]; 3], m2: f64, n2: f64, mn: f64, scale: f64) {
    let product: f64 = m2 * n2;
    out[0][0] = scale * (12.0*m2*m2 + 4.0*n2*n2 + 10.0*product);
    out[1][1] = scale * (12.0*n2*n2 + 4.0*m2*m2 + 10.0*product);
    out[0][1] = scale * (8.0*product + m2*m2 + n2*n2);
    out[1][0] = out[0][1];
    out[0][2] = scale * mn * (7.0*m2 + n2);
    out[2][0] = out[0][2];
    out[1][2] = scale * mn * (7.0*n2 + m2);
    out[2][1] = out[1][2];
    out[2][2] = scale * (10.0*product + 2.0*(m2*m2+n2*n2));
}
public machine assemble(model: &mut Laminate) {
    transition { _ -> layer(model, 0) }
    machine layer(model: &mut Laminate, layer_index: u64) requires layer_index <= 3 {
        transition { _ -> cell(model, layer_index, 0, 0) }
    }
    machine cell(model: &mut Laminate, layer_index: u64, row: u64, column: u64)
    requires layer_index <= 3 requires row <= 2 requires column <= 2 {
        let bottom: f64 = model.z[layer_index];
        let top: f64 = model.z[layer_index + 1];
        let stiffness: f64 = model.stiffness[layer_index][row][column];
        model.a[row][column] = model.a[row][column] + stiffness*(top-bottom);
        model.b[row][column] = model.b[row][column] + stiffness*(top*top-bottom*bottom)/2.0;
        model.d[row][column] = model.d[row][column] + stiffness*(top*top*top-bottom*bottom*bottom)/3.0;
        let next: u64 = column + 1;
        transition next <= 2 { true -> cell(model, layer_index, row, next) false -> next_row(model, layer_index, row) }
    }
    machine next_row(model: &mut Laminate, layer_index: u64, row: u64)
    requires layer_index <= 3 requires row <= 2 {
        let next: u64 = row + 1;
        transition next <= 2 { true -> cell(model, layer_index, next, 0) false -> next_layer(model, layer_index) }
    }
    machine next_layer(model: &mut Laminate, layer_index: u64) requires layer_index <= 3 {
        let next: u64 = layer_index + 1;
        transition next < model.count && next <= 3 { true -> layer(model, next) false -> done() }
    }
    machine done() { }
}
public machine prepare_system(model: &mut Laminate) {
    transition { _ -> cell(model, 0, 0) }
    machine cell(model: &mut Laminate, row: u64, column: u64)
    requires row <= 2 requires column <= 2 {
        model.augmented[row][column] = model.a[row][column];
        model.augmented[row][column+3] = model.b[row][column];
        model.augmented[row+3][column] = model.b[row][column];
        model.augmented[row+3][column+3] = model.d[row][column];
        let next: u64 = column + 1;
        transition next <= 2 { true -> cell(model,row,next) false -> next_row(model,row) }
    }
    machine next_row(model: &mut Laminate,row: u64) requires row <= 2 {
        let next: u64 = row+1;
        transition next <= 2 { true -> cell(model,next,0) false -> load(model) }
    }
    machine load(model: &mut Laminate) {
        model.augmented[0][6] = 1.0;
        model.augmented[1][6] = 0.25;
        model.augmented[2][6] = -0.125;
        model.augmented[3][6] = 0.1;
        model.augmented[4][6] = -0.05;
        model.augmented[5][6] = 0.025;
    }
}
public machine layer_stress(model: &mut Laminate) {
    transition { _ -> cell(model,0,0) }
    machine cell(model: &mut Laminate,layer_index: u64,row: u64)
    requires layer_index <= 3 requires row <= 2 {
        let midpoint: f64 = (model.z[layer_index]+model.z[layer_index+1])/2.0;
        model.stress[layer_index][row] =
            model.stiffness[layer_index][row][0]*(model.response[0]+midpoint*model.response[3]) +
            model.stiffness[layer_index][row][1]*(model.response[1]+midpoint*model.response[4]) +
            model.stiffness[layer_index][row][2]*(model.response[2]+midpoint*model.response[5]);
        let next: u64 = row+1;
        transition next <= 2 { true -> cell(model,layer_index,next) false -> next_layer(model,layer_index) }
    }
    machine next_layer(model: &mut Laminate,layer_index: u64) requires layer_index <= 3 {
        let next: u64 = layer_index+1;
        transition next < model.count && next <= 3 { true -> cell(model,next,0) false -> done() }
    }
    machine done() { }
}
