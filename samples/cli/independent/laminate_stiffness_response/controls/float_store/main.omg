use omega_language_std::console;
use omega::language::core::float_operations;
data Model { z: [f64; 5]; }
data Main { model: Model; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> centered(main, 1.0) }
    machine centered(main: &mut Main, total: f64) {
        main.model.z[0] = 0.0-total/2.0;
        transition main.model.z[0] == -0.5 { true -> good(main) false -> bad(main) }
    }
    machine good(main: &mut Main) { Console::write_line("FLOAT STORE OK"); Console::exit_process(0); }
    machine bad(main: &mut Main) { Console::write_line("FLOAT STORE WRONG"); Console::exit_process(4); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
