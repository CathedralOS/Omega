use domain::tables;
use domain::statistics;
// Enumerate the first two cells; margins determine the remaining four.
// At most 81 candidates. Structural-zero conditioning renormalizes factorial weights.
public machine analyze(model: &Model) -> Inference {
    let mut result: Inference;
    transition margins_valid(model) {
        true -> prepare(model, result)
        false -> rejected(result, 1)
    }
    machine rejected(mut result: Inference, status: i32) -> Inference {
        result.status = status;
        result
    }
    machine prepare(model: &Model, result: Inference) -> Inference {
        transition table_valid(model, &model.observed) {
            true -> seed(model, result)
            false -> outer(model, result, 0)
        }
    }
    machine seed(model: &Model, mut result: Inference) -> Inference {
        result.observed_weight = table_weight(&model.observed, model.rows[0] + model.rows[1]);
        result.score = association_score(model, &model.observed);
        result.denominator = score_denominator(model);
        transition { _ -> outer(model, result, 0) }
    }
    machine outer(model: &Model, result: Inference, first: u64) -> Inference {
        transition first < 9 {
            true -> inner(model, result, first, 0)
            false -> finish(model, result)
        }
    }
    machine inner(model: &Model, result: Inference, first: u64, second: u64) -> Inference
    requires first < 9 {
        transition second < 9 {
            true -> candidate(model, result, first, second)
            false -> outer(model, result, first + 1)
        }
    }
    machine candidate(model: &Model, result: Inference, first: u64, second: u64) -> Inference
    requires first < 9 && second < 9 {
        let a: u64 in Wrapping = first as u64 in Wrapping;
        let b: u64 in Wrapping = second as u64 in Wrapping;
        transition a + b <= model.rows[0] && a <= model.columns[0] && b <= model.columns[1] {
            true -> construct(model, result, first, second, a, b)
            false -> inner(model, result, first, second + 1)
        }
    }
    machine construct(model: &Model, result: Inference, first: u64, second: u64,
        a: u64 in Wrapping, b: u64 in Wrapping) -> Inference
    requires first < 9 && second < 9 {
        let c: u64 in Wrapping = model.rows[0] - a - b;
        transition c <= model.columns[2] {
            true -> evaluate(model, result, first, second, Table { cells: [a, b, c,
                model.columns[0] - a, model.columns[1] - b, model.columns[2] - c] })
            false -> inner(model, result, first, second + 1)
        }
    }
    machine evaluate(model: &Model, result: Inference, first: u64, second: u64, table: Table) -> Inference
    requires first < 9 && second < 9 {
        transition table_valid(model, &table) {
            true -> accumulate(model, result, first, second, table)
            false -> inner(model, result, first, second + 1)
        }
    }
    machine accumulate(model: &Model, mut result: Inference, first: u64, second: u64, table: Table) -> Inference
    requires first < 9 && second < 9 {
        let weight: u64 in Wrapping = table_weight(&table, model.rows[0] + model.rows[1]);
        let score: u64 in Wrapping = association_score(model, &table);
        result.count = result.count + 1;
        result.partition = result.partition + weight;
        transition weight <= result.observed_weight {
            true -> probability(model, result, first, second, weight, score)
            false -> association(model, result, first, second, weight, score)
        }
    }
    machine probability(model: &Model, mut result: Inference, first: u64, second: u64,
        weight: u64 in Wrapping, score: u64 in Wrapping) -> Inference
    requires first < 9 && second < 9 {
        result.probability_tail = result.probability_tail + weight;
        transition { _ -> association(model, result, first, second, weight, score) }
    }
    machine association(model: &Model, result: Inference, first: u64, second: u64,
        weight: u64 in Wrapping, score: u64 in Wrapping) -> Inference
    requires first < 9 && second < 9 {
        transition score >= result.score {
            true -> tail(model, result, first, second, weight, score)
            false -> inner(model, result, first, second + 1)
        }
    }
    machine tail(model: &Model, mut result: Inference, first: u64, second: u64,
        weight: u64 in Wrapping, score: u64 in Wrapping) -> Inference
    requires first < 9 && second < 9 {
        result.association_tail = result.association_tail + weight;
        transition score == result.score {
            true -> tie(model, result, first, second)
            false -> inner(model, result, first, second + 1)
        }
    }
    machine tie(model: &Model, mut result: Inference, first: u64, second: u64) -> Inference
    requires first < 9 && second < 9 {
        result.ties = result.ties + 1;
        transition { _ -> inner(model, result, first, second + 1) }
    }
    machine finish(model: &Model, result: Inference) -> Inference {
        transition result.count == 0 {
            true -> rejected(result, 2)
            false -> observation(model, result)
        }
    }
    machine observation(model: &Model, result: Inference) -> Inference {
        transition table_valid(model, &model.observed) {
            true -> invariant(result)
            false -> rejected(result, 3)
        }
    }
    machine invariant(result: Inference) -> Inference {
        transition result.observed_weight > 0 && result.partition > 0 && result.denominator > 0 {
            true -> (result)
            false -> rejected(result, 4)
        }
    }
}
