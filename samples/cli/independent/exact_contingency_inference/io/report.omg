use omega_language_std::console;
use domain::tables;
machine decimal(value: u64 in Wrapping) reaches Console {
    transition { _ -> scale(value, 1) }
    state scale(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor <= value / 10 {
            true -> scale(value, divisor * 10)
            false -> emit(value, divisor)
        }
    }
    state emit(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor > 0 { true -> digit(value, divisor) false -> done() }
    }
    state digit(value: u64 in Wrapping, divisor: u64 in Wrapping)
    requires divisor > 0 {
        Console::write_byte((value / divisor % 10 + 48) as i32);
        transition { _ -> emit(value % divisor, divisor / 10) }
    }
    state done() {}
}
machine field(name: &[u8], value: u64 in Wrapping) reaches Console {
    Console::write(name);
    decimal(value);
    Console::write_line("");
}
pub machine report(result: &Inference) reaches Console
invokes Console;
{
    Console::write_line("exact_contingency_inference model=fixed_margins_factorial structural_zeros=conditioned");
    field("feasible=", result.count);
    field("partition=", result.partition);
    field("observed_weight=", result.observed_weight);
    field("pearson_numerator=", result.score);
    field("pearson_denominator=", result.denominator);
    field("probability_tail_numerator=", result.probability_tail);
    field("association_tail_numerator=", result.association_tail);
    field("tail_denominator=", result.partition);
    field("association_ties=", result.ties);
}
