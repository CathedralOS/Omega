// Complete main-only reproduction: return 7 after a direct owned state field store.
use omega_language_std::console;
data Counter [copy] { value: u64; }
machine increment(counter: Counter) -> Counter {
    transition { _ -> update(counter) }
    state update(mut counter: Counter) -> Counter {
        counter.value = 7;
        counter
    }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let counter: Counter = increment(Counter { value: 1 });
    transition counter.value == 7 { true -> good(main) false -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(7); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
