// One-record chronology CLI; EOF without a record is an input error.
// Expected exit: 2.
// Expected output contains: invalid input
use omega_language_std::console;
use chronology::model;
use chronology::solver;
use chronology::input;

// The application owns the input backing across the blocking provider call.
data Main { bytes: [u8; 32]; }

machine Main::main(main: &mut Main) reaches Console {
    let read: LineReadResult = block Console::read_line(&mut main.bytes);
    transition read {
        LineReadResult::LineComplete { count } -> input(main, count)
        LineReadResult::EndOfInput { count } -> input(main, count)
        _ -> invalid(main)
    }
    state input(main: &mut Main, count: u64) {
        let mut model: Chronology;
        let valid: bool = parse(&main.bytes, count, &mut model);
        transition valid {
            true -> solve(main, &mut model)
            false -> invalid(main)
        }
    }
    state solve(main: &mut Main, model: &mut Chronology) {
        let mut result: Reconciliation;
        reconcile(model, &mut result);
        transition result.count > 0 {
            true -> feasible(main, &result)
            false -> witness(main, model, &mut result)
        }
    }
    state feasible(main: &mut Main, result: &Reconciliation) {
        Console::write("feasible count=");
        number(main, result.count);
        Console::write_line("");
        transition { _ -> event(main, result, 0) }
    }
    state event(main: &mut Main, result: &Reconciliation, index: i32 in Wrapping) {
        transition index >= 0 && index < 3 {
            true -> report(main, result, index)
            false -> success(main)
        }
    }
    state report(main: &mut Main, result: &Reconciliation, index: i32 in Wrapping)
    requires index >= 0
    requires index < 3
    {
        Console::write("event ");
        number(main, index);
        Console::write(" range=");
        number(main, result.lower[index] as i32 in Wrapping);
        Console::write("..");
        number(main, result.upper[index] as i32 in Wrapping);
        Console::write_line("");
        transition { _ -> event(main, result, index + 1) }
    }
    state witness(main: &mut Main, model: &mut Chronology, result: &mut Reconciliation) {
        contradiction(model, result);
        Console::write("infeasible witness bounds+edges=");
        number(main, model.enabled[0] as i32 in Wrapping);
        number(main, model.enabled[1] as i32 in Wrapping);
        number(main, model.enabled[2] as i32 in Wrapping);
        number(main, model.enabled[3] as i32 in Wrapping);
        Console::write_line(" count=0");
        Console::exit_process(0);
    }
    state success(main: &mut Main) { Console::exit_process(0); }
    state invalid(main: &mut Main) {
        Console::write_line("invalid input");
        Console::exit_process(2);
    }
}

machine number(main: &mut Main, value: i32 in Wrapping) reaches Console {
    transition { _ -> digit(main, value, 1000, false) }
    state digit(main: &mut Main, value: i32 in Wrapping, divisor: i32 in Wrapping, started: bool) {
        transition divisor > 0 {
            true -> extract(main, value, divisor, started)
            false -> done()
        }
    }
    state extract(main: &mut Main, value: i32 in Wrapping, divisor: i32 in Wrapping, started: bool)
    requires divisor > 0
    {
        let digit: i32 in Wrapping = value / divisor;
        transition digit > 0 || started || divisor == 1 {
            true -> emit(main, value, divisor, digit)
            false -> digit(main, value % divisor, divisor / 10, false)
        }
    }
    state emit(main: &mut Main, value: i32 in Wrapping, divisor: i32 in Wrapping, digit: i32 in Wrapping)
    requires divisor > 0
    {
        Console::write_byte((digit + 48) as i32);
        transition { _ -> digit(main, value % divisor, divisor / 10, true) }
    }
    state done() { }
}
