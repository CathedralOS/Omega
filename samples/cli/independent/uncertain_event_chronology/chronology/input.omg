use chronology::model;
pub machine parse(bytes: &[u8; 32], count: u64, model: &mut Chronology) -> bool {
    let mut digits: [i32; 19];
    transition count == 19 || count == 20 {
        true -> ending(bytes, count, model, &mut digits)
        false -> false
    }
    state ending(bytes: &[u8; 32], count: u64, model: &mut Chronology, digits: &mut [i32; 19]) -> bool {
        transition count == 19 || bytes[19] == 10 {
            true -> digit(bytes, model, digits, 0)
            false -> false
        }
    }
    state digit(bytes: &[u8; 32], model: &mut Chronology, digits: &mut [i32; 19], index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 19 {
            true -> read(bytes, model, digits, index)
            false -> intervals(model, digits)
        }
    }
    state read(bytes: &[u8; 32], model: &mut Chronology, digits: &mut [i32; 19], index: i32 in Wrapping) -> bool
    requires index >= 0
    requires index < 19
    {
        let byte: u8 = bytes[index];
        transition byte >= 48 && byte <= 57 {
            true -> store(bytes, model, digits, index, byte)
            false -> false
        }
    }
    state store(bytes: &[u8; 32], model: &mut Chronology, digits: &mut [i32; 19], index: i32 in Wrapping, byte: u8) -> bool
    requires index >= 0
    requires index < 19
    {
        let value: i32 in Wrapping = byte as i32 in Wrapping;
        digits[index] = (value - 48) as i32;
        transition { _ -> digit(bytes, model, digits, index + 1) }
    }
    state intervals(model: &mut Chronology, digits: &[i32; 19]) -> bool {
        model.lower = [digits[0],digits[2],digits[4]];
        model.upper = [digits[1],digits[3],digits[5]];
        model.source = [digits[7],digits[10],digits[13],digits[16]];
        model.destination = [digits[8],digits[11],digits[14],digits[17]];
        model.lag = [digits[9],digits[12],digits[15],digits[18]];
        model.enabled = [0,0,0,0];
        transition digits[0] <= digits[1] && digits[2] <= digits[3] && digits[4] <= digits[5] && digits[6] <= 4 {
            true -> edge(model, digits[6] as i32 in Wrapping, 0)
            false -> false
        }
    }
    state edge(model: &mut Chronology, count: i32 in Wrapping, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 4 && index < count {
            true -> endpoints(model, count, index)
            false -> true
        }
    }
    state endpoints(model: &mut Chronology, count: i32 in Wrapping, index: i32 in Wrapping) -> bool
    requires index >= 0
    requires index < 4
    {
        transition model.source[index] < 3 && model.destination[index] < 3 {
            true -> enable(model, count, index)
            false -> false
        }
    }
    state enable(model: &mut Chronology, count: i32 in Wrapping, index: i32 in Wrapping) -> bool
    requires index >= 0
    requires index < 4
    {
        model.enabled[index] = 1;
        transition { _ -> edge(model, count, index + 1) }
    }
}
