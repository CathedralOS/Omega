use chronology::model;
// A private scratch record owns the decoded wire digits across parser states.
data Digits { values: [i32; 19]; }
public machine parse(bytes: &[u8; 32], count: u64, model: &mut Chronology) -> bool {
    let mut digits: Digits;
    transition count == 19 || count == 20 {
        true -> ending(bytes, count, model, &mut digits)
        false -> false
    }
    machine ending(bytes: &[u8; 32], count: u64, model: &mut Chronology, digits: &mut Digits) -> bool {
        transition count == 19 || bytes[19] == 10 {
            true -> digit(bytes, model, digits, 0)
            false -> false
        }
    }
    machine digit(bytes: &[u8; 32], model: &mut Chronology, digits: &mut Digits, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 19 {
            true -> read(bytes, model, digits, index)
            false -> intervals(model, digits)
        }
    }
    machine read(bytes: &[u8; 32], model: &mut Chronology, digits: &mut Digits, index: i32 in Wrapping) -> bool
    requires index >= 0
    requires index < 19
    {
        let byte: u8 = bytes[index];
        transition byte >= 48 && byte <= 57 {
            true -> store(bytes, model, digits, index, byte)
            false -> false
        }
    }
    machine store(bytes: &[u8; 32], model: &mut Chronology, digits: &mut Digits, index: i32 in Wrapping, byte: u8) -> bool
    requires index >= 0
    requires index < 19
    {
        let value: i32 in Wrapping = byte as i32 in Wrapping;
        digits.values[index] = (value - 48) as i32;
        transition { _ -> digit(bytes, model, digits, index + 1) }
    }
    machine intervals(model: &mut Chronology, digits: &Digits) -> bool {
        model.lower = [digits.values[0],digits.values[2],digits.values[4]];
        model.upper = [digits.values[1],digits.values[3],digits.values[5]];
        model.source = [digits.values[7],digits.values[10],digits.values[13],digits.values[16]];
        model.destination = [digits.values[8],digits.values[11],digits.values[14],digits.values[17]];
        model.lag = [digits.values[9],digits.values[12],digits.values[15],digits.values[18]];
        model.enabled = [0,0,0,0];
        transition digits.values[0] <= digits.values[1] && digits.values[2] <= digits.values[3] && digits.values[4] <= digits.values[5] && digits.values[6] <= 4 {
            true -> edge(model, digits.values[6] as i32 in Wrapping, 0)
            false -> false
        }
    }
    machine edge(model: &mut Chronology, count: i32 in Wrapping, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 4 && index < count {
            true -> endpoints(model, count, index)
            false -> true
        }
    }
    machine endpoints(model: &mut Chronology, count: i32 in Wrapping, index: i32 in Wrapping) -> bool
    requires index >= 0
    requires index < 4
    {
        transition model.source[index] < 3 && model.destination[index] < 3 {
            true -> enable(model, count, index)
            false -> false
        }
    }
    machine enable(model: &mut Chronology, count: i32 in Wrapping, index: i32 in Wrapping) -> bool
    requires index >= 0
    requires index < 4
    {
        model.enabled[index] = 1;
        transition { _ -> edge(model, count, index + 1) }
    }
}
