// Expected exit: 0 (input: 2 0\n).
use omega_language_std::console;
use fixtures;
use geometry;
use graph;
use validation;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut input: [u8; 8];
    let result: LineReadResult = block Console::read_line(&mut input);
    transition result {
        LineReadResult::LineComplete { count } -> length(main, &input, count)
        _ -> invalid(main)
    }
    state length(main: &mut Main, input: &[u8; 8], count: u64) {
        transition count == 4 {
            true -> parse(main, input)
            false -> invalid(main)
        }
    }
    state parse(main: &mut Main, input: &[u8; 8]) {
        transition input[0] >= 48 && input[0] <= 53 && input[1] == 32 &&
                   input[2] >= 48 && input[2] <= 49 && input[3] == 10 {
            true -> plan(main, (input[0] as i64 in Wrapping) - 48,
                         (input[2] as i32 in Wrapping) - 48)
            false -> invalid(main)
        }
    }
    state plan(main: &mut Main, radius: i64 in Wrapping, variant: i32 in Wrapping) {
        let mut scene: fixtures::Scene;
        fixtures::load(&mut scene, variant);
        Console::write_line("clearance_route_planner");
        Console::write("radius="); number(main, radius); Console::write_line("");
        Console::write("scene="); number(main, variant as i64 in Wrapping); Console::write_line("");
        let start: i64 in Wrapping = graph::edge(&scene, 0, 0, radius);
        let goal: i64 in Wrapping = graph::edge(&scene, 1, 1, radius);
        transition start >= 0 && goal >= 0 {
            true -> search(main, &scene, radius)
            false -> blocked(main, &scene, radius, start)
        }
    }
    state blocked(main: &mut Main, scene: &fixtures::Scene, radius: i64 in Wrapping,
                  start: i64 in Wrapping) {
        transition start < 0 {
            true -> endpoint(main, scene, 0)
            false -> endpoint(main, scene, 1)
        }
    }
    state endpoint(main: &mut Main, scene: &fixtures::Scene, node: i32 in Wrapping)
    requires node >= 0 && node < 6
    {
        Console::write_line("status=endpoint_blocked");
        Console::write("node="); number(main, node as i64 in Wrapping); Console::write_line("");
        Console::write("minimum_clearance_milli=");
        number(main, graph::edge(scene, node, node, 0)); Console::write_line("");
        Console::exit_process(2);
    }
    state search(main: &mut Main, scene: &fixtures::Scene, radius: i64 in Wrapping) {
        let mut planner: graph::Planner;
        graph::build(&mut planner, scene, radius);
        let found: bool = graph::solve(&mut planner);
        transition found {
            true -> certify(main, scene, radius, &planner)
            false -> infeasible(main, scene, radius, &planner)
        }
    }
    state certify(main: &mut Main, scene: &fixtures::Scene, radius: i64 in Wrapping,
                  planner: &graph::Planner) {
        let valid: bool = validation::route(scene, planner, radius);
        transition valid {
            true -> report(main, scene, planner)
            false -> failure(main)
        }
    }
    state report(main: &mut Main, scene: &fixtures::Scene, planner: &graph::Planner) {
        Console::write_line("status=route");
        Console::write("cost_milli="); number(main, planner.distances[1]); Console::write_line("");
        Console::write("minimum_clearance_milli="); number(main, planner.clearance); Console::write_line("");
        Console::write("coordinates=");
        transition { _ -> coordinates(main, scene, planner, planner.route_count - 1) }
    }
    state coordinates(main: &mut Main, scene: &fixtures::Scene, planner: &graph::Planner,
                      position: i32 in Wrapping) {
        transition position >= 0 && position < 6 {
            true -> coordinate_node(main, scene, planner, position, planner.route[position])
            false -> finish(main)
        }
    }
    state coordinate_node(main: &mut Main, scene: &fixtures::Scene, planner: &graph::Planner,
                          position: i32 in Wrapping, node: i32 in Wrapping) {
        transition node >= 0 && node < 6 {
            true -> coordinate_emit(main, scene, planner, position, node)
            false -> failure(main)
        }
    }
    state coordinate_emit(main: &mut Main, scene: &fixtures::Scene, planner: &graph::Planner,
                          position: i32 in Wrapping, node: i32 in Wrapping)
    requires node >= 0 && node < 6
    {
        number(main, scene.x[node]); Console::write(","); number(main, scene.y[node]);
        transition position > 0 {
            true -> separator(main, scene, planner, position)
            false -> finish(main)
        }
    }
    state separator(main: &mut Main, scene: &fixtures::Scene, planner: &graph::Planner,
                    position: i32 in Wrapping) {
        Console::write(";");
        transition { _ -> coordinates(main, scene, planner, position - 1) }
    }
    state finish(main: &mut Main) {
        Console::write_line(""); Console::write_line("validated=1"); Console::exit_process(0);
    }
    state infeasible(main: &mut Main, scene: &fixtures::Scene, radius: i64 in Wrapping,
                     planner: &graph::Planner) {
        let valid: bool = validation::cut(scene, planner, radius);
        transition valid {
            true -> witness(main, planner)
            false -> failure(main)
        }
    }
    state witness(main: &mut Main, planner: &graph::Planner) {
        Console::write_line("status=infeasible");
        Console::write("reachable_mask="); number(main, planner.witness as i64 in Wrapping);
        Console::write_line(""); Console::write_line("cut_validated=1"); Console::exit_process(2);
    }
    state invalid(main: &mut Main) {
        Console::write_line("invalid_input: expected radius(0..5) space scene(0..1) LF");
        Console::exit_process(64);
    }
    state failure(main: &mut Main) {
        Console::write_line("FAIL: planner certificate"); Console::exit_process(1);
    }
}
machine number(main: &mut Main, value: i64 in Wrapping) reaches Console {
    transition value >= 0 && value < 1000000 {
        true -> divisor(main, value, 1)
        false -> bad(main)
    }
    state divisor(main: &mut Main, value: i64 in Wrapping, scale: i64 in Wrapping) {
        transition scale > 0 && value / scale >= 10 {
            true -> divisor(main, value, scale * 10)
            false -> digit(main, value, scale)
        }
    }
    state digit(main: &mut Main, value: i64 in Wrapping, scale: i64 in Wrapping) {
        transition scale > 0 {
            true -> character(main, value, scale, value / scale + 48)
            false -> bad(main)
        }
    }
    state character(main: &mut Main, value: i64 in Wrapping, scale: i64 in Wrapping,
                    byte: i64 in Wrapping) {
        transition byte >= 48 && byte <= 57 && scale > 0 {
            true -> emit(main, value, scale, byte)
            false -> bad(main)
        }
    }
    state emit(main: &mut Main, value: i64 in Wrapping, scale: i64 in Wrapping,
               byte: i64 in Wrapping)
    requires byte >= 48 && byte <= 57 && scale > 0
    {
        Console::write_byte(byte as i32);
        transition scale > 1 {
            true -> digit(main, value % scale, scale / 10)
            false -> done()
        }
    }
    state done() { }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
