module validation;
use fixtures;
use graph;
use geometry;
// Re-evaluate the emitted path, rather than trusting adjacency or stored cost.
public machine route(scene: &fixtures::Scene, planner: &graph::Planner,
                  radius: i64 in Wrapping) -> bool {
    transition planner.route_count >= 2 && planner.route_count <= 6 {
        true -> endpoints(scene, planner, radius, planner.route_count - 1)
        false -> false
    }
    machine endpoints(scene: &fixtures::Scene, planner: &graph::Planner,
                    radius: i64 in Wrapping, last: i32 in Wrapping) -> bool
    requires last >= 0 && last < 6
    {
        transition planner.route[0] == 1 && planner.route[last] == 0 {
            true -> segment(scene, planner, radius, 0, 0, 30000, 0)
            false -> false
        }
    }
    machine segment(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
                  position: i32 in Wrapping, cost: i64 in Wrapping,
                  clearance: i64 in Wrapping, mask: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 6 && position < planner.route_count {
            true -> nodes(scene, planner, radius, position, cost, clearance, mask, planner.route[position])
            false -> (cost == planner.distances[1] && clearance == planner.clearance)
        }
    }
    machine nodes(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
                position: i32 in Wrapping, cost: i64 in Wrapping, clearance: i64 in Wrapping,
                mask: i32 in Wrapping, node: i32 in Wrapping) -> bool {
        transition node >= 0 && node < 6 && position >= 0 && position < 6 {
            true -> unique(scene, planner, radius, position, cost, clearance, mask, node)
            false -> false
        }
    }
    machine unique(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
                 position: i32 in Wrapping, cost: i64 in Wrapping, clearance: i64 in Wrapping,
                 mask: i32 in Wrapping, node: i32 in Wrapping) -> bool
    requires node >= 0 && node < 6 && position >= 0 && position < 6
    {
        transition (mask & (1i32 << node)) == 0 {
            true -> next(scene, planner, radius, position, cost, clearance, mask | (1i32 << node), node)
            false -> false
        }
    }
    machine next(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
               position: i32 in Wrapping, cost: i64 in Wrapping, clearance: i64 in Wrapping,
               mask: i32 in Wrapping, node: i32 in Wrapping) -> bool {
        transition position + 1 < planner.route_count && position + 1 >= 0 && position + 1 < 6 {
            true -> previous(scene, planner, radius, position, cost, clearance, mask, node,
                             planner.route[position + 1])
            false -> (cost == planner.distances[1] && clearance == planner.clearance)
        }
    }
    machine previous(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
                   position: i32 in Wrapping, cost: i64 in Wrapping, clearance: i64 in Wrapping,
                   mask: i32 in Wrapping, node: i32 in Wrapping, other: i32 in Wrapping) -> bool {
        transition node >= 0 && node < 6 && other >= 0 && other < 6 {
            true -> measure(scene, planner, radius, position, cost, clearance, mask, node, other)
            false -> false
        }
    }
    machine measure(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
                  position: i32 in Wrapping, cost: i64 in Wrapping, clearance: i64 in Wrapping,
                  mask: i32 in Wrapping, node: i32 in Wrapping, other: i32 in Wrapping) -> bool
    requires node >= 0 && node < 6 && other >= 0 && other < 6
    {
        let observed: i64 in Wrapping = graph::edge(scene, node, other, radius);
        let dx: i64 in Wrapping = scene.x[node] - scene.x[other];
        let dy: i64 in Wrapping = scene.y[node] - scene.y[other];
        transition observed >= radius * 1000 {
            true -> segment(scene, planner, radius, position + 1,
                cost + geometry::root_milli(dx * dx + dy * dy, 1),
                geometry::minimum(clearance, observed), mask)
            false -> false
        }
    }
}
// A separating cut proves roadmap infeasibility. It explicitly includes start,
// excludes goal, and has no physically admissible edge crossing to its complement.
public machine cut(scene: &fixtures::Scene, planner: &graph::Planner,
                radius: i64 in Wrapping) -> bool {
    transition (planner.witness & 1) == 1 && (planner.witness & 2) == 0 {
        true -> row(scene, planner, radius, 0)
        false -> false
    }
    machine row(scene: &fixtures::Scene, planner: &graph::Planner,
              radius: i64 in Wrapping, from: i32 in Wrapping) -> bool {
        transition from >= 0 && from < 6 {
            true -> column(scene, planner, radius, from, 0)
            false -> true
        }
    }
    machine column(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
                 from: i32 in Wrapping, to: i32 in Wrapping) -> bool {
        transition to >= 0 && to < 6 && from >= 0 && from < 6 {
            true -> edge(scene, planner, radius, from, to)
            false -> row(scene, planner, radius, from + 1)
        }
    }
    machine edge(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
               from: i32 in Wrapping, to: i32 in Wrapping) -> bool
    requires from >= 0 && from < 6 && to >= 0 && to < 6
    {
        transition (planner.witness & (1i32 << from)) != 0 && (planner.witness & (1i32 << to)) == 0 {
            true -> crossing(scene, planner, radius, from, to)
            false -> column(scene, planner, radius, from, to + 1)
        }
    }
    machine crossing(scene: &fixtures::Scene, planner: &graph::Planner, radius: i64 in Wrapping,
                   from: i32 in Wrapping, to: i32 in Wrapping) -> bool
    requires from >= 0 && from < 6 && to >= 0 && to < 6
    {
        let clearance: i64 in Wrapping = graph::edge(scene, from, to, radius);
        transition clearance < 0 {
            true -> column(scene, planner, radius, from, to + 1)
            false -> false
        }
    }
}
