// Complete intended-invalid control: an unguarded ordinal cannot index six nodes.
use omega_language_std::console;
use nodes;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut input: [u8; 8];
    _ = block Console::read_line(&mut input);
    let coordinates: [i64; 6] = [0,10,3,7,3,7];
    let value: i64 = nodes::unguarded(&coordinates, input[0] as i32 in Wrapping);
    Console::exit_process(0);
}
