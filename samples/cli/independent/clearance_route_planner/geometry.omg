module geometry;
// Exact squared center-to-segment distance. Endpoints and obstacles are integral;
// the interior case retains cross^2 / length^2 rather than rounding projection.
public data Fraction { numerator: i64 in Wrapping; denominator: i64 in Wrapping; }
public machine distance(ax: i64 in Wrapping, ay: i64 in Wrapping,
                     bx: i64 in Wrapping, by: i64 in Wrapping,
                     cx: i64 in Wrapping, cy: i64 in Wrapping) -> Fraction {
    let dx: i64 in Wrapping = bx - ax;
    let dy: i64 in Wrapping = by - ay;
    let px: i64 in Wrapping = cx - ax;
    let py: i64 in Wrapping = cy - ay;
    let length: i64 in Wrapping = dx * dx + dy * dy;
    let projection: i64 in Wrapping = px * dx + py * dy;
    transition length == 0 || projection <= 0 {
        true -> Fraction { numerator: px * px + py * py, denominator: 1 }
        false -> other(dx, dy, px, py, length, projection)
    }
    machine other(dx: i64 in Wrapping, dy: i64 in Wrapping,
                px: i64 in Wrapping, py: i64 in Wrapping,
                length: i64 in Wrapping, projection: i64 in Wrapping) -> Fraction {
        transition projection >= length {
            true -> Fraction { numerator: (px - dx) * (px - dx) + (py - dy) * (py - dy), denominator: 1 }
            false -> interior(dx, dy, px, py, length)
        }
    }
    machine interior(dx: i64 in Wrapping, dy: i64 in Wrapping,
                   px: i64 in Wrapping, py: i64 in Wrapping, length: i64 in Wrapping) -> Fraction {
        let cross: i64 in Wrapping = px * dy - py * dx;
        Fraction { numerator: cross * cross, denominator: length }
    }
}
// Lower bound in thousandths, using integer binary search. All authored geometry
// lies in [-5,15], so [0,30000] brackets every distance; no numeric package.
public machine root_milli(numerator: i64 in Wrapping, denominator: i64 in Wrapping) -> i64 in Wrapping {
    transition denominator > 0 && numerator >= 0 {
        true -> search(numerator, denominator, 0, 30001)
        false -> 0
    }
    machine search(numerator: i64 in Wrapping, denominator: i64 in Wrapping,
                 low: i64 in Wrapping, high: i64 in Wrapping) -> i64 in Wrapping {
        transition high - low > 1 {
            true -> test(numerator, denominator, low, high, (low + high) / 2)
            false -> low
        }
    }
    machine test(numerator: i64 in Wrapping, denominator: i64 in Wrapping,
               low: i64 in Wrapping, high: i64 in Wrapping, middle: i64 in Wrapping) -> i64 in Wrapping {
        transition middle * middle * denominator <= numerator * 1000000 {
            true -> search(numerator, denominator, middle, high)
            false -> search(numerator, denominator, low, middle)
        }
    }
}
public machine minimum(left: i64 in Wrapping, right: i64 in Wrapping) -> i64 in Wrapping {
    transition left < right { true -> left false -> right }
}
