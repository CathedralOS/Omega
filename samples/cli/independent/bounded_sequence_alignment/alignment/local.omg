module alignment::local;
use input::sequence;

// Private fixed-capacity score/trace arena. Row zero and column zero are ZII.
// Scores and directions are a nested 17 by 17 matrix. Cell reads travel through
// a call result, a copied local row, a coordinate parameter, and a field store.
// Strict updates preserve diagonal/up/left tie order and first row-major maximum.
pub data Alignment {
    scores: [[i32; 17]; 17];
    directions: [[u8; 17]; 17];
    first_trace: [u8; 32];
    second_trace: [u8; 32];
    columns: i32 in Wrapping;
    score: i32 in Wrapping;
    first_start: i32 in Wrapping;
    second_start: i32 in Wrapping;
    first_end: i32 in Wrapping;
    second_end: i32 in Wrapping;
    row: i32 in Wrapping;
    column: i32 in Wrapping;
    candidate: i32 in Wrapping;
    direction: u8;
    first_base: u8;
    second_base: u8;
    substitution: i32 in Wrapping;
}

machine read_score(grid: &[[i32; 17]; 17], row: i32 in Wrapping, column: i32 in Wrapping) -> i32
requires row >= 0 && row < 17, column >= 0 && column < 17
{
    grid[row][column]
}

machine copy_row(grid: &[[i32; 17]; 17], row: i32 in Wrapping) -> [i32; 17]
requires row >= 0 && row < 17
{
    grid[row]
}

machine read_direction(grid: &[[u8; 17]; 17], row: i32 in Wrapping, column: i32 in Wrapping) -> u8
requires row >= 0 && row < 17, column >= 0 && column < 17
{
    grid[row][column]
}

pub machine align(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
    transition first.length > 0 && first.length <= 16 && second.length > 0 && second.length <= 16 {
        true -> initialize(first, second, result)
        false -> (false)
    }
    state initialize(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.score = 0;
        result.columns = 0;
        result.first_end = 0;
        result.second_end = 0;
        result.row = 1;
        result.column = 1;
        transition { _ -> clear(first, second, result, 0) }
    }
    state clear(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, position: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 289 {
            true -> split(first, second, result, position)
            false -> cell(first, second, result)
        }
    }
    state split(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, position: i32 in Wrapping) -> bool {
        let row: i32 in Wrapping = position / 17;
        let column: i32 in Wrapping = position % 17;
        transition row >= 0 && row < 17 && column >= 0 && column < 17 {
            true -> zero(first, second, result, position, row, column)
            false -> (false)
        }
    }
    state zero(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, position: i32 in Wrapping, row: i32 in Wrapping, column: i32 in Wrapping) -> bool
    requires row >= 0 && row < 17, column >= 0 && column < 17
    {
        result.scores[row][column] = 0;
        result.directions[row][column] = 0;
        transition { _ -> clear(first, second, result, position + 1) }
    }
    state cell(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        transition result.row <= first.length {
            true -> column(first, second, result)
            false -> begin_trace(first, second, result)
        }
    }
    state column(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        transition result.column <= second.length {
            true -> positions(first, second, result)
            false -> next_row(first, second, result)
        }
    }
    state next_row(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.row = result.row + 1;
        result.column = 1;
        transition { _ -> cell(first, second, result) }
    }
    state positions(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        let first_position: i32 in Wrapping = result.row - 1;
        let second_position: i32 in Wrapping = result.column - 1;
        transition result.row >= 1 && result.row <= 16 && result.column >= 1 && result.column <= 16 {
            true -> bases(first, second, result, first_position, second_position)
            false -> (false)
        }
    }
    state bases(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, first_position: i32 in Wrapping, second_position: i32 in Wrapping) -> bool {
        transition first_position >= 0 && first_position < 16 && second_position >= 0 && second_position < 16 {
            true -> read_bases(first, second, result, first_position, second_position)
            false -> (false)
        }
    }
    state read_bases(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, first_position: i32 in Wrapping, second_position: i32 in Wrapping) -> bool
    requires first_position >= 0 && first_position < 16, second_position >= 0 && second_position < 16
    {
        result.first_base = first.bases[first_position];
        result.second_base = second.bases[second_position];
        result.substitution = 0 - 2;
        transition result.first_base == 78 || result.second_base == 78 {
            true -> ambiguous(first, second, result)
            false -> compare(first, second, result)
        }
    }
    state ambiguous(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.substitution = 0 - 1;
        transition { _ -> bounds(first, second, result) }
    }
    state compare(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        transition result.first_base == result.second_base { true -> match_base(first, second, result) false -> bounds(first, second, result) }
    }
    state match_base(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.substitution = 3;
        transition { _ -> bounds(first, second, result) }
    }
    state bounds(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        let diagonal_row: i32 in Wrapping = result.row - 1;
        let diagonal_column: i32 in Wrapping = result.column - 1;
        let up_column: i32 in Wrapping = result.column;
        let left_row: i32 in Wrapping = result.row;
        let left_column: i32 in Wrapping = result.column - 1;
        transition diagonal_row >= 0 && diagonal_row < 17 && diagonal_column >= 0 && diagonal_column < 17 && result.row >= 1 && result.row <= 16 && up_column >= 0 && up_column < 17 && left_row >= 0 && left_row < 17 && left_column >= 0 && left_column < 17 && result.column >= 1 && result.column <= 16 {
            true -> score_cell(first, second, result, diagonal_row, diagonal_column, up_column, left_row, left_column)
            false -> (false)
        }
    }
    state score_cell(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, diagonal_row: i32 in Wrapping, diagonal_column: i32 in Wrapping, up_column: i32 in Wrapping, left_row: i32 in Wrapping, left_column: i32 in Wrapping) -> bool
    requires diagonal_row >= 0 && diagonal_row < 17, diagonal_column >= 0 && diagonal_column < 17, result.row >= 1 && result.row <= 16, up_column >= 0 && up_column < 17, left_row >= 0 && left_row < 17, left_column >= 0 && left_column < 17, result.column >= 1 && result.column <= 16
    {
        result.candidate = 0;
        result.direction = 0;
        let up_values: [i32; 17] = copy_row(&result.scores, diagonal_row);
        let diagonal: i32 in Wrapping = (up_values[diagonal_column] as i32 in Wrapping) + result.substitution;
        let up: i32 in Wrapping = (up_values[up_column] as i32 in Wrapping) - 2;
        let left: i32 in Wrapping = (read_score(&result.scores, left_row, left_column) as i32 in Wrapping) - 2;
        transition { _ -> choose_diagonal(first, second, result, diagonal, up, left) }
    }
    state choose_diagonal(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, diagonal: i32 in Wrapping, up: i32 in Wrapping, left: i32 in Wrapping) -> bool {
        transition diagonal > result.candidate { true -> set_diagonal(first, second, result, diagonal, up, left) false -> choose_up(first, second, result, up, left) }
    }
    state set_diagonal(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, diagonal: i32 in Wrapping, up: i32 in Wrapping, left: i32 in Wrapping) -> bool {
        result.candidate = diagonal;
        result.direction = 1;
        transition { _ -> choose_up(first, second, result, up, left) }
    }
    state choose_up(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, up: i32 in Wrapping, left: i32 in Wrapping) -> bool {
        transition up > result.candidate { true -> set_up(first, second, result, up, left) false -> choose_left(first, second, result, left) }
    }
    state set_up(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, up: i32 in Wrapping, left: i32 in Wrapping) -> bool {
        result.candidate = up;
        result.direction = 2;
        transition { _ -> choose_left(first, second, result, left) }
    }
    state choose_left(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, left: i32 in Wrapping) -> bool {
        transition left > result.candidate { true -> set_left(first, second, result, left) false -> store_guard(first, second, result) }
    }
    state set_left(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, left: i32 in Wrapping) -> bool {
        result.candidate = left;
        result.direction = 3;
        transition { _ -> store_guard(first, second, result) }
    }
    state store_guard(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        transition result.row >= 1 && result.row <= 16 && result.column >= 1 && result.column <= 16 { true -> store(first, second, result) false -> (false) }
    }
    state store(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool
    requires result.row >= 1 && result.row <= 16, result.column >= 1 && result.column <= 16
    {
        result.scores[result.row][result.column] = result.candidate as i32;
        result.directions[result.row][result.column] = result.direction;
        transition result.candidate > result.score { true -> maximum(first, second, result) false -> advance(first, second, result) }
    }
    state maximum(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.score = result.candidate;
        result.first_end = result.row;
        result.second_end = result.column;
        transition { _ -> advance(first, second, result) }
    }
    state advance(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.column = result.column + 1;
        transition { _ -> cell(first, second, result) }
    }
    state begin_trace(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.row = result.first_end;
        result.column = result.second_end;
        transition { _ -> trace(first, second, result) }
    }
    state trace(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        transition result.row >= 0 && result.row < 17 && result.column >= 0 && result.column < 17 { true -> trace_read(first, second, result) false -> (false) }
    }
    state trace_read(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool
    requires result.row >= 0 && result.row < 17, result.column >= 0 && result.column < 17
    {
        result.direction = read_direction(&result.directions, result.row, result.column);
        transition result.direction == 0 { true -> finish(result) false -> trace_bounds(first, second, result) }
    }
    state trace_bounds(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        let first_position: i32 in Wrapping = result.row - 1;
        let second_position: i32 in Wrapping = result.column - 1;
        transition result.columns >= 0 && result.columns < 32 && result.row >= 1 && result.row <= 16 && result.column >= 1 && result.column <= 16 {
            true -> trace_bases(first, second, result, first_position, second_position)
            false -> (false)
        }
    }
    state trace_bases(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, first_position: i32 in Wrapping, second_position: i32 in Wrapping) -> bool {
        transition first_position >= 0 && first_position < 16 && second_position >= 0 && second_position < 16 {
            true -> trace_pair(first, second, result, first_position, second_position)
            false -> (false)
        }
    }
    state trace_pair(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment, first_position: i32 in Wrapping, second_position: i32 in Wrapping) -> bool
    requires first_position >= 0 && first_position < 16, second_position >= 0 && second_position < 16
    {
        result.first_base = first.bases[first_position];
        result.second_base = second.bases[second_position];
        transition result.direction { 1 -> diagonal_trace(first, second, result) 2 -> up_trace(first, second, result) 3 -> left_trace(first, second, result) _ -> (false) }
    }
    state diagonal_trace(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.row = result.row - 1;
        result.column = result.column - 1;
        transition { _ -> trace_store_guard(first, second, result) }
    }
    state up_trace(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.row = result.row - 1;
        result.second_base = 45;
        transition { _ -> trace_store_guard(first, second, result) }
    }
    state left_trace(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        result.column = result.column - 1;
        result.first_base = 45;
        transition { _ -> trace_store_guard(first, second, result) }
    }
    state trace_store_guard(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool {
        transition result.columns >= 0 && result.columns < 32 { true -> trace_store(first, second, result) false -> (false) }
    }
    state trace_store(first: &input::sequence::Sequence, second: &input::sequence::Sequence, result: &mut Alignment) -> bool
    requires result.columns >= 0 && result.columns < 32
    {
        result.first_trace[result.columns] = result.first_base;
        result.second_trace[result.columns] = result.second_base;
        result.columns = result.columns + 1;
        transition { _ -> trace(first, second, result) }
    }
    state finish(result: &mut Alignment) -> bool {
        result.first_start = result.row;
        result.second_start = result.column;
        true
    }
}
