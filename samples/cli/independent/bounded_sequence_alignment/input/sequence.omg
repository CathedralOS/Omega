module input::sequence;
use omega_language_std::console;

pub data Sequence {
    bases: [u8; 16];
    length: i32 in Wrapping;
}

// Read precisely one LF-terminated sequence, or a final sequence ending at EOF.
// Capacity is checked before storing. Lowercase is normalized; no whitespace,
// FASTA headers, punctuation or alphabet beyond A/C/G/T/N is silently accepted.
// Status: 0 valid, 1 empty, 2 alphabet, 3 capacity, 4 unavailable line.
pub machine read_sequence(sequence: &mut Sequence) -> i32
reaches Console
invokes Console;
blocks;
crashes Trap
{
    sequence.length = 0;
    transition { _ -> next(sequence) }
    state next(sequence: &mut Sequence) -> i32 {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> end(sequence)
            ByteRead::Byte { value } -> byte(sequence, value)
        }
    }
    state byte(sequence: &mut Sequence, value: i32) -> i32 {
        transition value == 10 {
            true -> finish(sequence)
            false -> normalize(sequence, value)
        }
    }
    state normalize(sequence: &mut Sequence, value: i32) -> i32 {
        transition value >= 97 && value <= 122 {
            true -> alphabet(sequence, value - 32)
            false -> alphabet(sequence, value)
        }
    }
    state alphabet(sequence: &mut Sequence, value: i32) -> i32 {
        transition value == 65 || value == 67 || value == 71 || value == 84 || value == 78 {
            true -> capacity(sequence, value)
            false -> (2)
        }
    }
    state capacity(sequence: &mut Sequence, value: i32) -> i32 {
        transition sequence.length >= 0 && sequence.length < 16 && value >= 0 && value <= 255 {
            true -> store(sequence, value)
            false -> (3)
        }
    }
    state store(sequence: &mut Sequence, value: i32) -> i32
    requires sequence.length >= 0 && sequence.length < 16, value >= 0 && value <= 255
    {
        sequence.bases[sequence.length] = value as u8;
        sequence.length = sequence.length + 1;
        transition { _ -> next(sequence) }
    }
    state finish(sequence: &mut Sequence) -> i32 {
        transition sequence.length == 0 { true -> (1) false -> (0) }
    }
    state end(sequence: &mut Sequence) -> i32 {
        transition sequence.length == 0 { true -> (4) false -> (0) }
    }
}
