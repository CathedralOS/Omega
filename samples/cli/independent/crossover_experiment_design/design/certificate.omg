use design::model;

// Recount cells, not sequence identifiers. Enforce each subject's permutation,
// period balance, the directed edge cap, and the declared forbidden edge.
machine certify(request: &Request, allocation: &mut Allocation) -> bool {
    allocation.periods = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    allocation.carryover = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    transition { _ -> scan_subject(request, allocation, 0) }
    machine scan_subject(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping) -> bool {
        transition subject >= 0 && subject < 6 && subject < request.subjects {
            true -> scan_period(request, allocation, subject, 0, 0)
            false -> balance(request, allocation, 0)
        }
    }
    machine scan_period(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping) -> bool {
        transition period >= 0 && period < 3 && period < request.treatments {
            true -> guard_index(request, allocation, subject, period, seen, subject * 3 + period)
            false -> scan_subject(request, allocation, subject + 1)
        }
    }
    machine guard_index(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 18 {
            true -> read_value(request, allocation, subject, period, seen, index)
            false -> false
        }
    }
    machine read_value(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, index: i32 in Wrapping) -> bool {
        let observed: i32 in Wrapping = allocation.cells[index];
        transition { _ -> value(request, allocation, subject, period, seen, index, observed) }
    }
    machine value(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, index: i32 in Wrapping, value: i32 in Wrapping) -> bool {
        transition value >= 0 && value < request.treatments && value < 3 {
            true -> unique(request, allocation, subject, period, seen, index, value, treatment_bit(value))
            false -> false
        }
    }
    machine unique(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, index: i32 in Wrapping, value: i32 in Wrapping, bit: i32 in Wrapping) -> bool {
        transition (seen & bit) == 0 {
            true -> count_index(request, allocation, subject, period, seen | bit, index, value, period * 3 + value)
            false -> false
        }
    }
    machine count_index(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, index: i32 in Wrapping, value: i32 in Wrapping, count_index: i32 in Wrapping) -> bool {
        transition count_index >= 0 && count_index < 9 {
            true -> count(request, allocation, subject, period, seen, index, value, count_index)
            false -> false
        }
    }
    machine count(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, index: i32 in Wrapping, value: i32 in Wrapping, count_index: i32 in Wrapping) -> bool {
        allocation.periods[count_index] = allocation.periods[count_index] + 1;
        transition period > 0 && index > 0 && index < 18 {
            true -> previous(request, allocation, subject, period, seen, value, index - 1)
            false -> scan_period(request, allocation, subject, period + 1, seen)
        }
    }
    machine previous(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, value: i32 in Wrapping, previous_index: i32 in Wrapping) -> bool {
        transition previous_index >= 0 && previous_index < 18 {
            true -> read_previous(request, allocation, subject, period, seen, value, previous_index)
            false -> false
        }
    }
    machine read_previous(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, value: i32 in Wrapping, previous_index: i32 in Wrapping) -> bool {
        let previous: i32 in Wrapping = allocation.cells[previous_index];
        transition { _ -> edge(request, allocation, subject, period, seen, value, previous) }
    }
    machine edge(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, value: i32 in Wrapping, previous: i32 in Wrapping) -> bool {
        let code: i32 in Wrapping = edge_code(previous, value);
        transition request.forbidden == 0 || code != request.forbidden {
            true -> edge_index(request, allocation, subject, period, seen, previous * 3 + value)
            false -> false
        }
    }
    machine edge_index(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, edge: i32 in Wrapping) -> bool {
        transition edge >= 0 && edge < 9 {
            true -> edge_count(request, allocation, subject, period, seen, edge)
            false -> false
        }
    }
    machine edge_count(request: &Request, allocation: &mut Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, seen: i32 in Wrapping, edge: i32 in Wrapping) -> bool {
        allocation.carryover[edge] = allocation.carryover[edge] + 1;
        transition allocation.carryover[edge] <= request.cap {
            true -> scan_period(request, allocation, subject, period + 1, seen)
            false -> false
        }
    }
    machine balance(request: &Request, allocation: &mut Allocation, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 9 {
            true -> balanced(request, allocation, index)
            false -> true
        }
    }
    machine balanced(request: &Request, allocation: &mut Allocation, index: i32 in Wrapping) -> bool {
        transition index / 3 >= request.treatments || index % 3 >= request.treatments || allocation.periods[index] * request.treatments == request.subjects {
            true -> balance(request, allocation, index + 1)
            false -> false
        }
    }
}
machine treatment_bit(value: i32 in Wrapping) -> i32 in Wrapping {
    transition value { 0 -> 1 1 -> 2 _ -> 4 }
}
