use omega_language_std::console;
use design::model;

machine digit(value: i32 in Wrapping) reaches Console {
    transition value {
        0 -> zero() 1 -> one() 2 -> two() 3 -> three()
        4 -> four() 5 -> five() 6 -> six() _ -> invalid()
    }
    machine zero() { Console::write("0"); }
    machine one() { Console::write("1"); }
    machine two() { Console::write("2"); }
    machine three() { Console::write("3"); }
    machine four() { Console::write("4"); }
    machine five() { Console::write("5"); }
    machine six() { Console::write("6"); }
    machine invalid() { Console::write("?"); }
}

machine emit(request: &Request, allocation: &Allocation) reaches Console {
    Console::write_line("FEASIBLE: allocation (treatments A=0 B=1 C=2)");
    transition { _ -> scan_row(request, allocation, 0) }
    machine scan_row(request: &Request, allocation: &Allocation, subject: i32 in Wrapping) {
        transition subject >= 0 && subject < 6 && subject < request.subjects {
            true -> row_start(request, allocation, subject)
            false -> period_start(request, allocation)
        }
    }
    machine row_start(request: &Request, allocation: &Allocation, subject: i32 in Wrapping) {
        Console::write("subject "); digit(subject); Console::write(":");
        transition { _ -> cell(request, allocation, subject, 0) }
    }
    machine cell(request: &Request, allocation: &Allocation, subject: i32 in Wrapping, period: i32 in Wrapping) {
        transition period >= 0 && period < 3 && period < request.treatments {
            true -> cell_index(request, allocation, subject, period, subject * 3 + period)
            false -> row_end(request, allocation, subject)
        }
    }
    machine cell_index(request: &Request, allocation: &Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, index: i32 in Wrapping) {
        transition index >= 0 && index < 18 {
            true -> cell_write(request, allocation, subject, period, index)
            false -> done()
        }
    }
    machine cell_write(request: &Request, allocation: &Allocation, subject: i32 in Wrapping, period: i32 in Wrapping, index: i32 in Wrapping) {
        Console::write(" "); digit(allocation.cells[index]);
        transition { _ -> cell(request, allocation, subject, period + 1) }
    }
    machine row_end(request: &Request, allocation: &Allocation, subject: i32 in Wrapping) {
        Console::write_line("");
        transition { _ -> scan_row(request, allocation, subject + 1) }
    }
    machine period_start(request: &Request, allocation: &Allocation) {
        Console::write_line("PERIOD COUNTS (rows=period, columns=treatment)");
        transition { _ -> matrix_scan_row(request, allocation, 0, false) }
    }
    machine matrix_scan_row(request: &Request, allocation: &Allocation, row: i32 in Wrapping, carry: bool) {
        transition row >= 0 && row < 3 && row < request.treatments {
            true -> matrix_column(request, allocation, row, 0, carry)
            false -> next_matrix(request, allocation, carry)
        }
    }
    machine matrix_column(request: &Request, allocation: &Allocation, row: i32 in Wrapping, column: i32 in Wrapping, carry: bool) {
        transition column >= 0 && column < 3 && column < request.treatments {
            true -> matrix_index(request, allocation, row, column, carry, row * 3 + column)
            false -> matrix_end(request, allocation, row, carry)
        }
    }
    machine matrix_index(request: &Request, allocation: &Allocation, row: i32 in Wrapping, column: i32 in Wrapping, carry: bool, index: i32 in Wrapping) {
        transition index >= 0 && index < 9 {
            true -> matrix_value(request, allocation, row, column, carry, index)
            false -> done()
        }
    }
    machine matrix_value(request: &Request, allocation: &Allocation, row: i32 in Wrapping, column: i32 in Wrapping, carry: bool, index: i32 in Wrapping) {
        transition carry {
            true -> carry_write(request, allocation, row, column, carry, index)
            false -> period_write(request, allocation, row, column, carry, index)
        }
    }
    machine carry_write(request: &Request, allocation: &Allocation, row: i32 in Wrapping, column: i32 in Wrapping, carry: bool, index: i32 in Wrapping) {
        digit(allocation.carryover[index]); Console::write(" ");
        transition { _ -> matrix_column(request, allocation, row, column + 1, carry) }
    }
    machine period_write(request: &Request, allocation: &Allocation, row: i32 in Wrapping, column: i32 in Wrapping, carry: bool, index: i32 in Wrapping) {
        digit(allocation.periods[index]); Console::write(" ");
        transition { _ -> matrix_column(request, allocation, row, column + 1, carry) }
    }
    machine matrix_end(request: &Request, allocation: &Allocation, row: i32 in Wrapping, carry: bool) {
        Console::write_line("");
        transition { _ -> matrix_scan_row(request, allocation, row + 1, carry) }
    }
    machine next_matrix(request: &Request, allocation: &Allocation, carry: bool) {
        transition carry {
            true -> complete()
            false -> carry_start(request, allocation)
        }
    }
    machine carry_start(request: &Request, allocation: &Allocation) {
        Console::write_line("CARRYOVER COUNTS (rows=previous, columns=next)");
        transition { _ -> matrix_scan_row(request, allocation, 0, true) }
    }
    machine complete() { Console::write_line("CERTIFIED: subject permutations; exact period balance; carryover cap; forbidden edge"); }
    machine done() { Console::exit_process(70); }
}
