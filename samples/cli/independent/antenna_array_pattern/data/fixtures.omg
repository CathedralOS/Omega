use domain::array;
public data Fixtures { }
public machine Fixtures::load(geometry: &mut Geometry, selection: i32) {
    geometry.positions[0] = 0.0;
    geometry.positions[1] = 0.5;
    geometry.positions[2] = 1.0;
    geometry.positions[3] = 1.5;
    geometry.weights[0] = 1.0;
    geometry.weights[1] = 1.0;
    geometry.weights[2] = 1.0;
    geometry.weights[3] = 1.0;
    geometry.steering = 0.0;
    transition selection {
        1 -> steer(geometry)
        2 -> zero(geometry)
        3 -> duplicate(geometry)
        4 -> taper(geometry)
        5 -> invalid_position(geometry)
        6 -> invalid_weight(geometry)
        _ -> done()
    }
    state steer(geometry: &mut Geometry) { geometry.steering = 0.5; }
    state zero(geometry: &mut Geometry) {
        geometry.weights[0] = 0.0; geometry.weights[1] = 0.0;
        geometry.weights[2] = 0.0; geometry.weights[3] = 0.0;
    }
    state duplicate(geometry: &mut Geometry) {
        geometry.positions[1] = 0.0; geometry.positions[2] = 0.5; geometry.positions[3] = 0.5;
    }
    state taper(geometry: &mut Geometry) { geometry.weights[1] = 2.0; geometry.weights[2] = 2.0; }
    state invalid_position(geometry: &mut Geometry) { geometry.positions[3] = 5.0; }
    state invalid_weight(geometry: &mut Geometry) { geometry.weights[0] = 4.0; }
    state done() { }
}
