// Complete intended-invalid application: element 4 is outside a four-element extent.
use omega_language_std::console;
data Invalid { weights: [i32; 4]; }
machine Invalid::main(program: &mut Invalid) reaches Console {
    program.weights[4] = 1;
    Console::write_line("UNREACHABLE: out-of-bounds write admitted");
    Console::exit_process(0);
}
