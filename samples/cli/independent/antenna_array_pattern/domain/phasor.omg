// Private bounded cosine: reduce into [-pi, pi], then degree-20 Taylor.
// Geometry validation bounds phase to 8*pi; the sine shift adds pi/2, requiring <=5 turns.
// Taylor remainder <= pi^22/22! < 8e-11. No shared numerics imports.
use omega::language::core::float_operations;
pub data Phasor { }
pub machine Phasor::cosine(angle: f64) -> f64 {
    transition { _ -> reduce(angle) }
    state reduce(angle: f64) {
        transition angle > 3.141592653589793 {
            true -> reduce(angle - 6.283185307179586)
            false -> reduce_lower(angle)
        }
    }
    state reduce_lower(angle: f64) {
        transition angle < -3.141592653589793 {
            true -> reduce(angle + 6.283185307179586)
            false -> polynomial(angle)
        }
    }
    state polynomial(angle: f64) {
        let square: f64 = angle * angle;
        let mut value: f64 = 0.0000000000000000004110317623312165;
        value = -1.56192069685862253e-16 + square * value;
        value = 4.77947733238738525e-14 + square * value;
        value = -1.14707455977297245e-11 + square * value;
        value = 2.08767569878681002e-09 + square * value;
        value = -2.75573192239858883e-07 + square * value;
        value = 2.48015873015873016e-05 + square * value;
        value = -0.00138888888888888894 + square * value;
        value = 0.0416666666666666644 + square * value;
        value = -0.5 + square * value;
        value = 1 + square * value;
        transition { _ -> (value) }
    }
}
pub machine Phasor::sine(angle: f64) -> f64 {
    let result: f64 = Phasor::cosine(angle - 1.5707963267948966);
    transition { _ -> (result) }
}
