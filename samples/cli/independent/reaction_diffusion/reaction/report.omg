use omega_language_std::console;
use reaction::model;
use omega::language::core::numeric_conversion;
// Decimal output uses no allocation and carries a sign for negative mass flow.
pub machine number(value: i64 in Wrapping) reaches Console
invokes Console;
{
    transition value < 0 { true -> negative(value) false -> begin(value) }
    state negative(value: i64 in Wrapping) { Console::write_byte(45); transition { _ -> begin(0 - value) } }
    state begin(value: i64 in Wrapping) { transition { _ -> digit(value, 10000000000, false) } }
    state digit(value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool) {
        transition divisor > 0 { true -> choose(value, divisor, started) false -> done() }
    }
    state choose(value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool)
    requires divisor > 0
    {
        let quotient: i64 in Wrapping = value / divisor;
        transition quotient > 0 || started || divisor == 1 {
            true -> emit(value, divisor, quotient)
            false -> digit(value, divisor / 10, false)
        }
    }
    state emit(value: i64 in Wrapping, divisor: i64 in Wrapping, quotient: i64 in Wrapping)
    requires divisor > 0
    {
        Console::write_byte(narrow_i64_to_i32_wrapping((quotient + 48) as i64));
        transition { _ -> digit(value % divisor, divisor / 10, true) }
    }
    state done() {}
}
pub machine row(step: i64 in Wrapping, ledger: &Ledger) reaches Console
invokes Console;
{
    number(step); Console::write(","); number(ledger.mass); Console::write(",");
    number(ledger.reaction); Console::write(","); number(ledger.diffusion); Console::write(",");
    number(ledger.error); Console::write_line("");
}
pub machine field(sim: &Simulation) reaches Console
invokes Console;
{
    Console::write("field");
    transition { _ -> cell(sim, 0) }
    state cell(sim: &Simulation, index: i64 in Wrapping) {
        transition index < sim.cells && index >= 0 && index < 32 { true -> emit(sim, index) false -> done() }
    }
    state emit(sim: &Simulation, index: i64 in Wrapping)
        requires index >= 0 requires index < 32 {
        Console::write(",");
        number(sim.field[index]);
        transition { _ -> cell(sim, index + 1) }
    }
    state done() { Console::write_line(""); }
}
