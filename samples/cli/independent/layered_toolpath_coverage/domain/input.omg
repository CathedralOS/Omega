use domain::model;
use omega_language_std::console;
use omega::language::core::binding;
// A digit is one token. Whitespace is optional; EOF and other bytes are errors.
machine digit(console: &Binding<Console>) -> i32 in Wrapping reaches Console {
    transition { _ -> read(console) }
    state read(console: &Binding<Console>) -> i32 in Wrapping {
        let observed: ByteRead = block Console::read_byte(console);
        transition observed {
            ByteRead::Eof -> (0 - 1)
            ByteRead::Byte { value } -> classify(console, value)
        }
    }
    state classify(console: &Binding<Console>, value: i32) -> i32 in Wrapping {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> again(console)
            _ -> number(value)
        }
    }
    state again(console: &Binding<Console>) -> i32 in Wrapping { transition { _ -> read(console) } }
    state number(value: i32) -> i32 in Wrapping {
        transition value >= 48 && value <= 57 {
            true -> ((value as i32 in Wrapping) - 48)
            _ -> (0 - 1)
        }
    }
}
machine input_end(console: &Binding<Console>) -> bool reaches Console {
    transition { _ -> read(console) }
    state read(console: &Binding<Console>) -> bool {
        let observed: ByteRead = block Console::read_byte(console);
        transition observed {
            ByteRead::Eof -> true
            ByteRead::Byte { value } -> classify(console, value)
        }
    }
    state classify(console: &Binding<Console>, value: i32) -> bool {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> again(console)
            _ -> false
        }
    }
    state again(console: &Binding<Console>) -> bool { transition { _ -> read(console) } }
}
machine load(console: &Binding<Console>, job: &mut Job) -> bool reaches Console {
    job.width = block digit(console);
    job.height = block digit(console);
    job.layers = block digit(console);
    job.orientation = block digit(console);
    job.stride = block digit(console);
    transition job.width >= 1 && job.width <= 8 && job.height >= 1 && job.height <= 8
        && job.layers >= 1 && job.layers <= 4 && job.orientation >= 0
        && job.orientation <= 1 && job.stride >= 1 && job.stride <= 2 {
        true -> clear(console, job, 0)
        _ -> false
    }
    state clear(console: &Binding<Console>, job: &mut Job, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 256 {
            true -> zero(console, job, index)
            _ -> cell(console, job, 0)
        }
    }
    state zero(console: &Binding<Console>, job: &mut Job, index: i32 in Wrapping) -> bool {
        job.mask[index] = 0;
        job.covered[index] = 0;
        transition { _ -> clear(console, job, index + 1) }
    }
    state cell(console: &Binding<Console>, job: &mut Job, index: i32 in Wrapping) -> bool {
        transition index < job.width * job.height * job.layers {
            true -> bounds(console, job, index)
            _ -> finish(console)
        }
    }
    state finish(console: &Binding<Console>) -> bool {
        let complete: bool = block input_end(console);
        complete
    }
    state bounds(console: &Binding<Console>, job: &mut Job, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 256 {
            true -> read(console, job, index)
            _ -> false
        }
    }
    state read(console: &Binding<Console>, job: &mut Job, index: i32 in Wrapping) -> bool {
        let value: i32 in Wrapping = block digit(console);
        transition value == 0 || value == 1 {
            true -> store(console, job, index, value)
            _ -> false
        }
    }
    state store(console: &Binding<Console>, job: &mut Job, index: i32 in Wrapping, value: i32 in Wrapping) -> bool {
        job.mask[index] = value as i32;
        transition { _ -> cell(console, job, index + 1) }
    }
}
