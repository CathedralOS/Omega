use domain::model;
use omega_language_std::console;
// All values in this bounded model fit four decimal digits.
machine number(value: i32 in Wrapping) reaches Console {
    Console::write_byte(((value / 1000) % 10 + 48) as i32);
    Console::write_byte(((value / 100) % 10 + 48) as i32);
    Console::write_byte(((value / 10) % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
}
machine coordinate(x: i32 in Wrapping, y: i32 in Wrapping, z: i32 in Wrapping) reaches Console {
    number(x); Console::write(" "); number(y); Console::write(" "); number(z);
}
machine segment(kind: bool, x: i32 in Wrapping, y: i32 in Wrapping, z: i32 in Wrapping,
    end_x: i32 in Wrapping, end_y: i32 in Wrapping, end_z: i32 in Wrapping) reaches Console {
    transition kind {
        true -> deposition(x, y, z, end_x, end_y, end_z)
        _ -> travel(x, y, z, end_x, end_y, end_z)
    }
    state deposition(x: i32 in Wrapping, y: i32 in Wrapping, z: i32 in Wrapping,
        end_x: i32 in Wrapping, end_y: i32 in Wrapping, end_z: i32 in Wrapping) {
        Console::write("D ");
        coordinate(x, y, z); Console::write(" "); coordinate(end_x, end_y, end_z); Console::write_line("");
    }
    state travel(x: i32 in Wrapping, y: i32 in Wrapping, z: i32 in Wrapping,
        end_x: i32 in Wrapping, end_y: i32 in Wrapping, end_z: i32 in Wrapping) {
        Console::write("T ");
        coordinate(x, y, z); Console::write(" "); coordinate(end_x, end_y, end_z); Console::write_line("");
    }
}
machine audit(job: &Job) reaches Console {
    Console::write("AUDIT region="); number(job.region);
    Console::write(" covered="); number(job.covered_count);
    Console::write(" missed="); number(job.missed);
    Console::write(" waste="); number(job.waste);
    Console::write(" duplicate="); number(job.duplicate);
    Console::write(" deposition="); number(job.deposition);
    Console::write(" travel="); number(job.travel);
    Console::write(" D="); number(job.deposition_segments);
    Console::write(" T="); number(job.travel_segments);
    Console::write_line("");
}
