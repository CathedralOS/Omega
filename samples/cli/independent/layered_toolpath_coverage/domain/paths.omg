use domain::model;
use domain::report;
use omega_language_std::console;
use omega::language::core::binding;
// Scan maximal occupied runs. Gaps end deposition and cause travel to the next run.
machine magnitude(value: i32 in Wrapping) -> i32 in Wrapping {
    transition value < 0 { true -> (0 - value) _ -> value }
}
machine occupied(job: &Job, layer: i32 in Wrapping, lane: i32 in Wrapping,
    along: i32 in Wrapping) -> i32 in Wrapping {
    let width: i32 in Wrapping = job.width;
    let plane: i32 in Wrapping = job.width * job.height;
    transition job.orientation == 0 {
        true -> index(job, layer * plane + lane * width + along)
        _ -> index(job, layer * plane + along * width + lane)
    }
    state index(job: &Job, index: i32 in Wrapping) -> i32 in Wrapping {
        transition index >= 0 && index < 256 {
            true -> read(job, index)
            _ -> (0 - 1)
        }
    }
    state read(job: &Job, index: i32 in Wrapping) -> i32 in Wrapping {
        job.mask[index] as i32 in Wrapping
    }
}
machine cover(job: &mut Job, layer: i32 in Wrapping, lane: i32 in Wrapping,
    along: i32 in Wrapping) -> bool {
    let width: i32 in Wrapping = job.width;
    let plane: i32 in Wrapping = job.width * job.height;
    transition job.orientation == 0 {
        true -> index(job, layer * plane + lane * width + along)
        _ -> index(job, layer * plane + along * width + lane)
    }
    state index(job: &mut Job, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 256 {
            true -> write(job, index)
            _ -> false
        }
    }
    state write(job: &mut Job, index: i32 in Wrapping) -> bool {
        let previous: i32 in Wrapping = job.covered[index] as i32 in Wrapping;
        job.covered[index] = (previous + 1) as i32;
        true
    }
}
machine emit_run(console: &Binding<Console>, job: &mut Job, layer: i32 in Wrapping, lane: i32 in Wrapping,
    start: i32 in Wrapping, end: i32 in Wrapping) reaches Console {
    transition job.orientation == 0 {
        true -> move(console, job, start, lane, layer, end, lane)
        _ -> move(console, job, lane, start, layer, lane, end)
    }
    state move(console: &Binding<Console>, job: &mut Job, x: i32 in Wrapping, y: i32 in Wrapping, z: i32 in Wrapping,
        end_x: i32 in Wrapping, end_y: i32 in Wrapping) {
        let distance: i32 in Wrapping = magnitude(x - job.previous_x)
            + magnitude(y - job.previous_y) + magnitude(z - job.previous_z);
        transition distance > 0 {
            true -> travel(console, job, x, y, z, end_x, end_y, distance)
            _ -> deposit(console, job, x, y, z, end_x, end_y)
        }
    }
    state travel(console: &Binding<Console>, job: &mut Job, x: i32 in Wrapping, y: i32 in Wrapping, z: i32 in Wrapping,
        end_x: i32 in Wrapping, end_y: i32 in Wrapping, distance: i32 in Wrapping) {
        segment(console, false, job.previous_x, job.previous_y, job.previous_z, x, y, z);
        job.travel = job.travel + distance;
        job.travel_segments = job.travel_segments + 1;
        transition { _ -> deposit(console, job, x, y, z, end_x, end_y) }
    }
    state deposit(console: &Binding<Console>, job: &mut Job, x: i32 in Wrapping, y: i32 in Wrapping, z: i32 in Wrapping,
        end_x: i32 in Wrapping, end_y: i32 in Wrapping) {
        segment(console, true, x, y, z, end_x, end_y, z);
        job.deposition = job.deposition + end_x - x + end_y - y;
        job.deposition_segments = job.deposition_segments + 1;
        job.previous_x = end_x;
        job.previous_y = end_y;
        job.previous_z = z;
    }
}
machine paths(console: &Binding<Console>, job: &mut Job) -> bool reaches Console {
    job.previous_x = 0; job.previous_y = 0; job.previous_z = 0;
    job.deposition = 0; job.travel = 0;
    job.deposition_segments = 0; job.travel_segments = 0;
    job.region = 0; job.covered_count = 0; job.missed = 0;
    job.waste = 0; job.duplicate = 0;
    let width: i32 in Wrapping = job.width;
    let height: i32 in Wrapping = job.height;
    transition job.orientation == 0 {
        true -> layer(console, job, 0, height, width)
        _ -> layer(console, job, 0, width, height)
    }
    state layer(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping) -> bool {
        transition layer_index < job.layers {
            true -> lane(console, job, layer_index, 0, lanes, length)
            _ -> audit_cells(job, 0)
        }
    }
    state lane(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping, lane_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping) -> bool {
        transition lane_index < lanes {
            true -> find(console, job, layer_index, lane_index, lanes, length, 0)
            _ -> layer(console, job, layer_index + 1, lanes, length)
        }
    }
    state find(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping, lane_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping, along: i32 in Wrapping) -> bool {
        let next_lane: i32 in Wrapping = lane_index + job.stride;
        transition along < length {
            true -> test(console, job, layer_index, lane_index, lanes, length, along)
            _ -> lane(console, job, layer_index, next_lane, lanes, length)
        }
    }
    state test(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping, lane_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping, along: i32 in Wrapping) -> bool {
        let value: i32 in Wrapping = occupied(job, layer_index, lane_index, along);
        transition value {
            1 -> extend(console, job, layer_index, lane_index, lanes, length, along, along)
            0 -> find(console, job, layer_index, lane_index, lanes, length, along + 1)
            _ -> false
        }
    }
    state extend(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping, lane_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping, start: i32 in Wrapping,
        end: i32 in Wrapping) -> bool {
        transition end < length {
            true -> extend_test(console, job, layer_index, lane_index, lanes, length, start, end)
            _ -> emit(console, job, layer_index, lane_index, lanes, length, start, end)
        }
    }
    state extend_test(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping, lane_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping, start: i32 in Wrapping,
        end: i32 in Wrapping) -> bool {
        let value: i32 in Wrapping = occupied(job, layer_index, lane_index, end);
        transition value {
            1 -> mark(console, job, layer_index, lane_index, lanes, length, start, end)
            0 -> emit(console, job, layer_index, lane_index, lanes, length, start, end)
            _ -> false
        }
    }
    state mark(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping, lane_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping, start: i32 in Wrapping,
        end: i32 in Wrapping) -> bool {
        let valid: bool = cover(job, layer_index, lane_index, end);
        transition valid {
            true -> extend(console, job, layer_index, lane_index, lanes, length, start, end + 1)
            _ -> false
        }
    }
    state emit(console: &Binding<Console>, job: &mut Job, layer_index: i32 in Wrapping, lane_index: i32 in Wrapping,
        lanes: i32 in Wrapping, length: i32 in Wrapping, start: i32 in Wrapping,
        end: i32 in Wrapping) -> bool {
        emit_run(console, job, layer_index, lane_index, start, end);
        transition { _ -> find(console, job, layer_index, lane_index, lanes, length, end) }
    }
    state audit_cells(job: &mut Job, index: i32 in Wrapping) -> bool {
        transition index < job.width * job.height * job.layers {
            true -> audit_bounds(job, index)
            _ -> true
        }
    }
    state audit_bounds(job: &mut Job, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 256 {
            true -> audit_read(job, index)
            _ -> false
        }
    }
    state audit_read(job: &mut Job, index: i32 in Wrapping) -> bool {
        let mask: i32 in Wrapping = job.mask[index] as i32 in Wrapping;
        let visits: i32 in Wrapping = job.covered[index] as i32 in Wrapping;
        transition mask == 1 {
            true -> region_cell(job, index, visits)
            _ -> outside_cell(job, index, visits)
        }
    }
    state region_cell(job: &mut Job, index: i32 in Wrapping, visits: i32 in Wrapping) -> bool {
        job.region = job.region + 1;
        transition visits > 0 {
            true -> covered_cell(job, index, visits)
            _ -> missed_cell(job, index)
        }
    }
    state covered_cell(job: &mut Job, index: i32 in Wrapping, visits: i32 in Wrapping) -> bool {
        job.covered_count = job.covered_count + 1;
        job.duplicate = job.duplicate + visits - 1;
        transition { _ -> audit_cells(job, index + 1) }
    }
    state missed_cell(job: &mut Job, index: i32 in Wrapping) -> bool {
        job.missed = job.missed + 1;
        transition { _ -> audit_cells(job, index + 1) }
    }
    state outside_cell(job: &mut Job, index: i32 in Wrapping, visits: i32 in Wrapping) -> bool {
        job.waste = job.waste + visits;
        transition { _ -> audit_cells(job, index + 1) }
    }
}
