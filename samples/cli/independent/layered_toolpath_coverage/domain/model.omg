// Integer unit-cell fabrication model; private storage, no numeric library.
data Job {
    mask: [i32; 256];
    covered: [i32; 256];
    width: i32 in Wrapping;
    height: i32 in Wrapping;
    layers: i32 in Wrapping;
    orientation: i32 in Wrapping;
    stride: i32 in Wrapping;
    previous_x: i32 in Wrapping;
    previous_y: i32 in Wrapping;
    previous_z: i32 in Wrapping;
    deposition: i32 in Wrapping;
    travel: i32 in Wrapping;
    deposition_segments: i32 in Wrapping;
    travel_segments: i32 in Wrapping;
    region: i32 in Wrapping;
    covered_count: i32 in Wrapping;
    missed: i32 in Wrapping;
    waste: i32 in Wrapping;
    duplicate: i32 in Wrapping;
}
