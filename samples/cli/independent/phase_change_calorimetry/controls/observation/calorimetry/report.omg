use calorimetry::input;
use omega::language::core::numeric_conversion;
use omega_language_std::console;
use omega::language::core::float_operations;

// Decimal byte output avoids imposing a text-domain proof on dynamic numbers.
pub machine integer(reader: &mut Reader, value: i64)
reaches Console
invokes Console;
{
    let widened: i64 = value;
    transition widened < 0 {
        true -> negative(reader, widened)
        _ -> digits(reader, widened)
    }
    state negative(reader: &mut Reader, value: i64) {
        Console::write_byte(45);
        let absolute: i64 in Wrapping = 0 - (value as i64 in Wrapping);
        transition { _ -> digits(reader, absolute as i64) }
    }
    state digits(reader: &mut Reader, value: i64) {
        transition { _ -> seek(reader, value as i64 in Wrapping, 1) }
    }
    state seek(reader: &mut Reader, value: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 && divisor <= value / 10 {
            true -> seek(reader, value, divisor * 10)
            _ -> ready(reader, value, divisor)
        }
    }
    state ready(reader: &mut Reader, value: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 {
            true -> emit(reader, value, divisor)
            _ -> {}
        }
    }
    state emit(reader: &mut Reader, value: i64 in Wrapping, divisor: i64 in Wrapping)
    requires divisor > 0
    {
        let byte: i64 in Wrapping = (value / divisor) % 10 + 48;
        Console::write_byte(narrow_i64_to_i32_wrapping(byte as i64));
        transition divisor > 1 {
            true -> ready(reader, value, divisor / 10)
            _ -> {}
        }
    }
}
pub machine field(reader: &mut Reader, name: &[u8], value: f64)
reaches Console
invokes Console;
{
    Console::write(name);
    let narrowed: i64 in Saturating = I64::from_f64(value);
    integer(reader, narrowed as i64);
    Console::write_byte(10);
}
