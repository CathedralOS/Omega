// Expected reject: cannot prove index `8` is within length 8.
use calorimetry::input;
use calorimetry::model;
use calorimetry::report;
use omega::language::core::float_operations;
use omega_language_std::console;
data Application { reader: Reader; parameters: [f64; 20]; observations: [f64; 8]; index: i32; count: i32; problem: Problem; time: f64; energy: f64; }
machine Application::main(application: &mut Application) reaches Console crashes Trap {
    application.index = 0;
    transition { _ -> read_parameters(application) }
    machine read_parameters(application: &mut Application) {
        transition application.index >= 0 && application.index < 12 { true -> parameter(application) _ -> configure(application) }
    }
    machine parameter(application: &mut Application) {
        let value: Number = block number(&mut application.reader);
        transition value.valid { true -> store_parameter(application, value.value) _ -> invalid(application) }
    }
    machine store_parameter(application: &mut Application, value: f64) {
        application.parameters[application.index] = value;
        application.index = application.index + 1;
        transition { _ -> read_parameters(application) }
    }
    machine configure(application: &mut Application) {
        let first: Material = Material { mass: application.parameters[0], capacity: application.parameters[1], latent: application.parameters[2], melting: application.parameters[3], initial: application.parameters[4] };
        let second: Material = Material { mass: application.parameters[5], capacity: application.parameters[6], latent: application.parameters[7], melting: application.parameters[8], initial: application.parameters[9] };
        let conductance: f64 = application.parameters[10];
        let count: f64 = application.parameters[11];
        transition valid_material(&first) && valid_material(&second) && conductance >= 0.0 && count >= 0.0 && count <= 8.0 {
            true -> count(application, first, second, conductance, count) _ -> invalid(application)
        }
    }
    machine count(application: &mut Application, first: Material, second: Material, conductance: f64, count: f64) {
        let narrowed: i32 in Saturating = I32::from_f64(count);
        transition F64::from_i32(narrowed as i32) == count {
            true -> configured(application, first, second, conductance, narrowed as i32) _ -> invalid(application)
        }
    }
    machine configured(application: &mut Application, first: Material, second: Material, conductance: f64, count: i32) {
        application.problem = Problem { first: first, second: second, conductance: conductance };
        application.count = count; application.index = 0; application.time = 0.0; application.energy = 0.0;
        transition { _ -> read_times(application) }
    }
    machine read_times(application: &mut Application) {
        transition application.index >= 0 && application.index < application.count && application.index < 8 { true -> observation(application) _ -> finish_input(application) }
    }
    machine observation(application: &mut Application) {
        let value: Number = block number(&mut application.reader);
        transition value.valid && value.value >= application.time && value.value >= 0.0 { true -> store_time(application, value.value) _ -> invalid(application) }
    }
    machine store_time(application: &mut Application, value: f64) {
        application.observations[8] = value; application.time = value;
        application.index = application.index + 1;
        transition { _ -> read_times(application) }
    }
    machine finish_input(application: &mut Application) {
        let complete: bool = block ended(&mut application.reader);
        application.index = 0; application.time = 0.0;
        transition complete { true -> next(application) _ -> invalid(application) }
    }
    machine next(application: &mut Application) {
        transition application.index >= 0 && application.index < application.count && application.index < 8 { true -> advance(application) _ -> done(application) }
    }
    machine advance(application: &mut Application) {
        let time: f64 = application.observations[application.index];
        let result: Evolution = evolve(&application.problem, application.energy, time - application.time);
        transition result.success { true -> report(application, time, result.energy) _ -> failed(application) }
    }
    machine report(application: &mut Application, time: f64, energy: f64) {
        let first: f64 = application.problem.first.initial - energy / application.problem.first.mass;
        let second: f64 = application.problem.second.initial + energy / application.problem.second.mass;
        let initial: f64 = application.problem.first.mass * application.problem.first.initial + application.problem.second.mass * application.problem.second.initial;
        let drift: f64 = application.problem.first.mass * first + application.problem.second.mass * second - initial;
        let scale: f64 = 1.0 + magnitude(application.problem.first.mass * application.problem.first.initial) + magnitude(application.problem.second.mass * application.problem.second.initial) + application.problem.first.mass * application.problem.first.latent + application.problem.second.mass * application.problem.second.latent;
        transition magnitude(drift) <= 1e-10 * scale { true -> emit(application, time, energy, first, second) _ -> failed(application) }
    }
    machine emit(application: &mut Application, time: f64, energy: f64, first: f64, second: f64) {
        field(&mut application.reader, "time_pico=", time * 1e12);
        field(&mut application.reader, "temperature1_pico=", temperature(&application.problem.first, first) * 1e12);
        field(&mut application.reader, "temperature2_pico=", temperature(&application.problem.second, second) * 1e12);
        field(&mut application.reader, "fraction1_pico=", fraction(&application.problem.first, first) * 1e12);
        field(&mut application.reader, "fraction2_pico=", fraction(&application.problem.second, second) * 1e12);
        field(&mut application.reader, "enthalpy1_pico=", first * 1e12);
        field(&mut application.reader, "enthalpy2_pico=", second * 1e12);
        field(&mut application.reader, "transferred_energy_pico=", energy * 1e12);
        application.time = time; application.energy = energy;
        transition application.index >= 0 && application.index < 8 { true -> increment(application) _ -> failed(application) }
    }
    machine increment(application: &mut Application) requires application.index >= 0 && application.index < 8 {
        application.index = application.index + 1; transition { _ -> next(application) }
    }
    machine invalid(application: &mut Application) { Console::write_line("INVALID calorimetry input"); Console::exit_process(64); }
    machine failed(application: &mut Application) { Console::write_line("FAILED calorimetry convergence or conservation"); Console::exit_process(65); }
    machine done(application: &mut Application) { Console::write_line("status=ok"); }
}
machine valid_material(material: &Material) -> bool {
    transition { _ -> (material.mass >= 1.0 && material.capacity >= 1.0 && material.latent >= 1.0 && material.melting > 0.0) }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Application;
    block Application::main(&mut entry_storage);
}
