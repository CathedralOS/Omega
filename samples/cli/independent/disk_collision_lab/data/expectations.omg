use omega_language_std::math;

// Runtime checks of the independently frozen oracle make Terminal exit
// comparison meaningful despite the CLI exposing only native stdout.
use omega::language::core::float_operations;
use physics::model;
public machine expected_result(lab:&Lab,choice:i32)->bool {
 transition choice {
  0 -> case_0(lab)
  1 -> case_1(lab)
  2 -> case_2(lab)
  3 -> case_3(lab)
  4 -> case_4(lab)
  5 -> case_5(lab)
  6 -> case_6(lab)
  _ -> rejected()
 }
 machine case_0(lab:&Lab)->bool {
  lab.events == 1 &&
  abs_f64(lab.time-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_x-(1.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.energy-(0.5)) <= 0.000000001 &&
  abs_f64(lab.loss-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].x-(1.5)) <= 0.000000001 &&
  abs_f64(lab.disks[0].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vx-(-0.5)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].x-(4.5)) <= 0.000000001 &&
  abs_f64(lab.disks[1].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vx-(0.5)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vy-(0.0)) <= 0.000000001
 }
 machine case_1(lab:&Lab)->bool {
  lab.events == 1 &&
  abs_f64(lab.time-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_x-(1.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.energy-(0.5)) <= 0.000000001 &&
  abs_f64(lab.loss-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].x-(3.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vx-(1.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].x-(2.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].y-(2.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vx-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vy-(0.0)) <= 0.000000001
 }
 machine case_2(lab:&Lab)->bool {
  lab.events == 2 &&
  abs_f64(lab.time-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_x-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.energy-(1.5)) <= 0.000000001 &&
  abs_f64(lab.loss-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].x-(2.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vx-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].x-(5.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vx-(1.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].x-(2.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].y-(10.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].vx-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].x-(5.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].y-(10.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].vx-(1.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].vy-(0.0)) <= 0.000000001
 }
 machine case_3(lab:&Lab)->bool {
  lab.events == 0 &&
  abs_f64(lab.time-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_x-(-1.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.energy-(0.5)) <= 0.000000001 &&
  abs_f64(lab.loss-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].x-(-3.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vx-(-1.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].x-(4.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vx-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vy-(0.0)) <= 0.000000001
 }
 machine case_4(lab:&Lab)->bool {
  lab.events == 1 &&
  abs_f64(lab.time-(2.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_x-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.energy-(1.5)) <= 0.000000001 &&
  abs_f64(lab.loss-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].x-(2.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vx-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].x-(4.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vx-(1.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].x-(2.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].y-(10.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].vx-(1.0)) <= 0.000000001 &&
  abs_f64(lab.disks[2].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].x-(4.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].y-(10.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].vx-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[3].vy-(0.0)) <= 0.000000001
 }
 machine case_5(lab:&Lab)->bool {
  lab.events == 1 &&
  abs_f64(lab.time-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_x-(1.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.energy-(0.21875)) <= 0.000000001 &&
  abs_f64(lab.loss-(0.28125)) <= 0.000000001 &&
  abs_f64(lab.disks[0].x-(1.875)) <= 0.000000001 &&
  abs_f64(lab.disks[0].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vx-(-0.125)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vy-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].x-(4.375)) <= 0.000000001 &&
  abs_f64(lab.disks[1].y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vx-(0.375)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vy-(0.0)) <= 0.000000001
 }
 machine case_6(lab:&Lab)->bool {
  lab.events == 1 &&
  abs_f64(lab.time-(3.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_x-(1.0)) <= 0.000000001 &&
  abs_f64(lab.momentum_y-(0.0)) <= 0.000000001 &&
  abs_f64(lab.energy-(0.5)) <= 0.000000001 &&
  abs_f64(lab.loss-(0.0)) <= 0.000000001 &&
  abs_f64(lab.disks[0].x-(2.64)) <= 0.000000001 &&
  abs_f64(lab.disks[0].y-(-0.48)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vx-(0.64)) <= 0.000000001 &&
  abs_f64(lab.disks[0].vy-(-0.48)) <= 0.000000001 &&
  abs_f64(lab.disks[1].x-(3.56)) <= 0.000000001 &&
  abs_f64(lab.disks[1].y-(2.08)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vx-(0.36)) <= 0.000000001 &&
  abs_f64(lab.disks[1].vy-(0.48)) <= 0.000000001
 }
 machine rejected()->bool {false}
}

public machine expected_contact(lab:&Lab,choice:i32)->bool {
 transition choice {
  0 -> case_0(lab)
  1 -> case_1(lab)
  2 -> case_2(lab)
  3 -> case_3(lab)
  4 -> case_4(lab)
  5 -> case_5(lab)
  6 -> case_6(lab)
  _ -> rejected()
 }
 machine case_0(lab:&Lab)->bool {
  (lab.events == 1 && lab.first == 0 && lab.second == 1 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-1.5) <= 0.000000001)
 }
 machine case_1(lab:&Lab)->bool {
  (lab.events == 1 && lab.first == 0 && lab.second == 1 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-0.0) <= 0.000000001)
 }
 machine case_2(lab:&Lab)->bool {
  (lab.events == 1 && lab.first == 0 && lab.second == 1 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-1.0) <= 0.000000001) ||
  (lab.events == 2 && lab.first == 2 && lab.second == 3 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-2.0) <= 0.000000001)
 }
 machine case_3(lab:&Lab)->bool {
  false
 }
 machine case_4(lab:&Lab)->bool {
  (lab.events == 1 && lab.first == 0 && lab.second == 1 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-1.0) <= 0.000000001)
 }
 machine case_5(lab:&Lab)->bool {
  (lab.events == 1 && lab.first == 0 && lab.second == 1 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-1.125) <= 0.000000001)
 }
 machine case_6(lab:&Lab)->bool {
  (lab.events == 1 && lab.first == 0 && lab.second == 1 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-0.6) <= 0.000000001)
 }
 machine rejected()->bool {false}
}
