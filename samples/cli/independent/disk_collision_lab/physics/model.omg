// Scientific model: isolated frictionless disks, constant velocity between
// instantaneous Newton restitution impulses. No walls, gravity or spin.
use omega::language::core::float_operations;
public data Disk [copy] { x:f64; y:f64; vx:f64; vy:f64; radius:f64; mass:f64; }
public data Lab {
 disks:[Disk;4]; count:u64; budget:u64; events:u64; horizon:f64;
 restitution:f64; time:f64; valid:bool;
 first:u64; second:u64; selected:bool;
 delay:f64; candidate:f64; impulse:f64; normal_x:f64; normal_y:f64;
 momentum_x:f64; momentum_y:f64; energy:f64; initial_x:f64; initial_y:f64; initial_energy:f64;
 loss:f64; contact_error:f64;
}
public machine totals(lab:&mut Lab) {
 lab.momentum_x=0.0; lab.momentum_y=0.0; lab.energy=0.0;
 transition { _ -> scan(lab,0) }
 machine scan(lab:&mut Lab,index:u64) {
  transition index < lab.count && index < 4 { true -> add(lab,index) _ -> done() }
 }
 machine add(lab:&mut Lab,index:u64) requires index < 4 {
  let disk:Disk=lab.disks[index];
  lab.momentum_x=lab.momentum_x+disk.mass*disk.vx;
  lab.momentum_y=lab.momentum_y+disk.mass*disk.vy;
  lab.energy=lab.energy+0.5*disk.mass*(disk.vx*disk.vx+disk.vy*disk.vy);
  transition index < 4 { true -> scan(lab,index+1) _ -> done() }
 }
 machine done() {}
}
public machine validate(lab:&mut Lab) {
 lab.valid=false;
 transition lab.count >= 2 && lab.count <= 4 && lab.budget <= 8
  && lab.horizon >= 0.0 && lab.horizon <= 10.0
  && lab.restitution >= 0.0 && lab.restitution <= 1.0 {
  true -> scan(lab,0) _ -> done()
 }
 machine scan(lab:&mut Lab,index:u64) {
  transition index < lab.count && index < 4 { true -> disk(lab,index) _ -> pairs(lab,0,1) }
 }
 machine disk(lab:&mut Lab,index:u64) requires index < 4 {
  let d:Disk=lab.disks[index];
  transition d.mass >= 0.1 && d.mass <= 10.0 && d.radius >= 0.1 && d.radius <= 2.0
   && d.x >= -100.0 && d.x <= 100.0 && d.y >= -100.0 && d.y <= 100.0
   && d.vx >= -10.0 && d.vx <= 10.0 && d.vy >= -10.0 && d.vy <= 10.0 {
   true -> next(lab,index) _ -> done()
  }
 }
 machine next(lab:&mut Lab,index:u64) {
  transition index < 4 { true -> scan(lab,index+1) _ -> done() }
 }
 machine pairs(lab:&mut Lab,left:u64,right:u64) {
  transition left < lab.count && left < 4 {
   true -> pair_bound(lab,left,right) _ -> accepted(lab)
  }
 }
 machine pair_bound(lab:&mut Lab,left:u64,right:u64) requires left < 4 {
  transition right < lab.count && right < 4 {
   true -> pair(lab,left,right) _ -> next_left(lab,left)
  }
 }
 machine pair(lab:&mut Lab,left:u64,right:u64) requires left < 4 && right < 4 {
  let a:Disk=lab.disks[left]; let b:Disk=lab.disks[right];
  let dx:f64=b.x-a.x; let dy:f64=b.y-a.y; let radius:f64=a.radius+b.radius;
  transition dx*dx+dy*dy >= radius*radius-0.000000001 {
   true -> next_right(lab,left,right) _ -> done()
  }
 }
 machine next_right(lab:&mut Lab,left:u64,right:u64) {
  transition right < 4 { true -> pairs(lab,left,right+1) _ -> done() }
 }
 machine next_left(lab:&mut Lab,left:u64) {
  transition left < 4 { true -> pairs(lab,left+1,left+2) _ -> done() }
 }
 machine accepted(lab:&mut Lab) {lab.valid=true;}
 machine done() {}
}
