use omega_language_std::console;
use omega::language::core::binding;
use omega::language::core::float_operations;
// Bounded scientific output: signed fixed point with six fractional digits.
// Model validation and 8-event cap keep all printed magnitudes below 10^9.
pub machine integer(console:&mut Binding<Console>,value:u64) reaches Console
invokes console;
{
 transition { _ -> digits(console,value,1000000000000000,false) }
 state digits(console:&mut Binding<Console>,value:u64,divisor:u64,started:bool) {
  transition divisor > 0 {true -> emit(console,value,divisor,started) _ -> done()}
 }
 state emit(console:&mut Binding<Console>,value:u64,divisor:u64,started:bool) requires divisor > 0 {
  let digit:u64=value/divisor;
  transition digit > 0 || started || divisor == 1 {
   true -> write(console,value,divisor,digit) _ -> digits(console,value,divisor/10,false)
  }
 }
 state write(console:&mut Binding<Console>,value:u64,divisor:u64,digit:u64) requires divisor > 0 {
  transition digit <= 9 {true -> write_digit(console,value,divisor,digit) _ -> invalid(console)}
 }
 state write_digit(console:&mut Binding<Console>,value:u64,divisor:u64,digit:u64) requires divisor > 0 && digit <= 9 {
  let character:i32 in Wrapping=(digit as i32 in Wrapping)+48;
  console.write_byte(character as i32);
  transition { _ -> digits(console,value%divisor,divisor/10,true) }
 }
 state invalid(console:&mut Binding<Console>) {console.write_line("FAIL output bound");console.exit_process(4);}
 state done() {}
}
pub machine number(console:&mut Binding<Console>,value:f64) reaches Console
invokes console;
{
 transition value < 0.0 {true -> negative(console,value) _ -> positive(console,value)}
 state negative(console:&mut Binding<Console>,value:f64) {
  console.write("-"); transition { _ -> positive(console,0.0-value) }
 }
 state positive(console:&mut Binding<Console>,value:f64) {
  let converted:u64 in Saturating=U64::from_f64(value*1000000.0+0.5);
  let scaled:u64=converted as u64;
  integer(console,scaled/1000000);console.write(".");
  transition { _ -> fraction(console,scaled%1000000,100000) }
 }
 state fraction(console:&mut Binding<Console>,value:u64,divisor:u64) {
  transition divisor > 0 {true -> digit(console,value,divisor) _ -> done()}
 }
 state digit(console:&mut Binding<Console>,value:u64,divisor:u64) requires divisor > 0 {
  let observed:u64=value/divisor;
  transition observed <= 9 {true -> write_digit(console,value,divisor,observed) _ -> invalid(console)}
 }
 state write_digit(console:&mut Binding<Console>,value:u64,divisor:u64,observed:u64) requires divisor > 0 && observed <= 9 {
  let character:i32 in Wrapping=(observed as i32 in Wrapping)+48;
  console.write_byte(character as i32);
  transition { _ -> fraction(console,value%divisor,divisor/10) }
 }
 state invalid(console:&mut Binding<Console>) {console.write_line("FAIL output bound");console.exit_process(4);}
 state done() {}
}
