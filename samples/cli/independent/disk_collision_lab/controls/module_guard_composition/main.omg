use omega_language_std::math;

use omega::language::core::float_operations;
use model;
use helper;
machine observe(lab:&mut Measurements) {lab.events=1;lab.first=0;lab.second=1;lab.time=2.0;lab.impulse=1.5;lab.px=1.0;lab.energy=0.5;lab.initial_x=1.0;lab.initial_energy=0.5;}
machine Probe::main(probe:&mut Probe) {
 transition { _ -> check(probe) }
 machine check(probe:&mut Probe) {
  observe(&mut probe.lab);
  transition accepted(&probe.lab,probe.choice) && abs_f64(probe.lab.px-probe.lab.initial_x) <= 0.000000001
   && abs_f64(probe.lab.py-probe.lab.initial_y) <= 0.000000001
   && abs_f64(probe.lab.energy+probe.lab.loss-probe.lab.initial_energy) <= 0.000000001
   && abs_f64(probe.lab.contact_error) <= 0.000000001 {
   true -> passed(probe) _ -> failed(probe)
  }
 }
 machine passed(probe:&mut Probe) {probe.observed=1;}
 machine failed(probe:&mut Probe) {probe.observed=-1;}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Probe;
    Probe::main(&mut entry_storage);
}
