use omega_language_std::math;

use omega::language::core::float_operations;
data Disk [copy] {x:f64;y:f64;vx:f64;vy:f64;radius:f64;mass:f64;}
data Measurements {disks:[Disk;4];events:u64;first:u64;second:u64;time:f64;impulse:f64;px:f64;py:f64;energy:f64;loss:f64;initial_x:f64;initial_y:f64;initial_energy:f64;contact_error:f64;}
data Probe {lab:Measurements;choice:i32;observed:i32;}
machine observe(lab:&mut Measurements) {lab.events=1;lab.first=0;lab.second=1;lab.time=2.0;lab.impulse=1.5;lab.px=1.0;lab.energy=0.5;lab.initial_x=1.0;lab.initial_energy=0.5;}
machine accepted(lab:&Measurements,choice:i32)->bool {
 transition choice {0 -> test(lab) _ -> rejected()}
 state test(lab:&Measurements)->bool {lab.events == 1 && lab.first == 0 && lab.second == 1 && abs_f64(lab.time-2.0) <= 0.000000001 && abs_f64(lab.impulse-1.5) <= 0.000000001}
 state rejected()->bool {false}
}
machine Probe::main(probe:&mut Probe) {
 transition { _ -> check(probe) }
 state check(probe:&mut Probe) {
  observe(&mut probe.lab);
  transition accepted(&probe.lab,probe.choice) && abs_f64(probe.lab.px-probe.lab.initial_x) <= 0.000000001
   && abs_f64(probe.lab.py-probe.lab.initial_y) <= 0.000000001
   && abs_f64(probe.lab.energy+probe.lab.loss-probe.lab.initial_energy) <= 0.000000001
   && abs_f64(probe.lab.contact_error) <= 0.000000001 {
   true -> passed(probe) _ -> failed(probe)
  }
 }
 state passed(probe:&mut Probe) {probe.observed=1;}
 state failed(probe:&mut Probe) {probe.observed=-1;}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Probe;
    Probe::main(&mut entry_storage);
}
