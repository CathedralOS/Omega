// Complete bounded planar partition application. No external numeric package.
use omega_language_std::console;
use omega::language::core::float_operations;
use domain::model;
use domain::geometry;
use domain::clip;
use domain::verify;
use platform::input;
use platform::output;
data Main { reader: Reader; partition: Partition; }
machine Main::main(main: &mut Main) reaches Console {
    main.reader.valid = true;
    main.partition.valid = true;
    block read_integer(&mut main.reader);
    transition main.reader.valid && main.reader.value >= 3.0 && main.reader.value <= 12.0 {
        true -> count(main)
        false -> invalid()
    }
    machine count(main: &mut Main) {
        main.partition.boundary.count = U64::from_f64(main.reader.value) as u64;
        transition { _ -> boundary(main, 0) }
    }
    machine boundary(main: &mut Main, index: u64) {
        transition index < main.partition.boundary.count && index < 32 {
            true -> coordinate(main, index)
            false -> site_count(main)
        }
    }
    machine coordinate(main: &mut Main, index: u64) {
        block read_integer(&mut main.reader);
        main.partition.boundary.x[index] = main.reader.value;
        block read_integer(&mut main.reader);
        main.partition.boundary.y[index] = main.reader.value;
        transition main.reader.valid { true -> boundary(main, index + 1) false -> invalid() }
    }
    machine site_count(main: &mut Main) {
        block read_integer(&mut main.reader);
        transition main.reader.valid && main.reader.value >= 1.0 && main.reader.value <= 8.0 {
            true -> sites(main)
            false -> invalid()
        }
    }
    machine sites(main: &mut Main) {
        main.partition.site_count = U64::from_f64(main.reader.value) as u64;
        transition { _ -> site(main, 0) }
    }
    machine site(main: &mut Main, index: u64) {
        transition index < main.partition.site_count && index < 8 {
            true -> location(main, index)
            false -> validate(main)
        }
    }
    machine location(main: &mut Main, index: u64) {
        block read_integer(&mut main.reader);
        main.partition.site_x[index] = main.reader.value;
        block read_integer(&mut main.reader);
        main.partition.site_y[index] = main.reader.value;
        transition main.reader.valid { true -> site(main, index + 1) false -> invalid() }
    }
    machine validate(main: &mut Main) {
        block end_input(&mut main.reader);
        let boundary_ok: bool = boundary_valid(&main.partition.boundary);
        let sites_ok: bool = sites_valid(&main.partition);
        transition main.reader.valid && boundary_ok && sites_ok {
            true -> partition(main)
            false -> invalid()
        }
    }
    machine partition(main: &mut Main) {
        construct(&mut main.partition);
        verify(&mut main.partition);
        transition main.partition.valid && main.partition.nearest {
            true -> success(main)
            false -> failed()
        }
    }
    machine success(main: &mut Main) { emit(&main.partition); Console::exit_process(0); }
    machine invalid() { Console::write_line("INVALID_INPUT"); Console::exit_process(64); }
    machine failed() { Console::write_line("PARTITION_FAILED"); Console::exit_process(70); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
