use omega_language_std::console;
use omega::language::core::float_operations;
public data Reader { valid: bool; value: f64; }
// A whitespace-separated signed integer, bounded to [-100,100]. This parser
// consumes one separator, accepts EOF after digits, and rejects partial tokens.
public machine read_integer(reader: &mut Reader) reaches Console
invokes Console;
blocks;
crashes Trap
{
    reader.value = 0.0;
    transition { _ -> skip(reader) }
    machine skip(reader: &mut Reader) {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> bad(reader)
            ByteRead::Byte { value } -> start(reader, value)
        }
    }
    machine start(reader: &mut Reader, value: i32) {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> skip(reader)
            false -> sign(reader, value)
        }
    }
    machine sign(reader: &mut Reader, value: i32) {
        transition value == 45 {
            true -> next(reader, -1.0, false)
            false -> digit(reader, value, 1.0, false)
        }
    }
    machine next(reader: &mut Reader, sign: f64, seen: bool) {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> finish(reader, sign, seen)
            ByteRead::Byte { value } -> digit(reader, value, sign, seen)
        }
    }
    machine digit(reader: &mut Reader, value: i32, sign: f64, seen: bool) {
        transition value >= 48 && value <= 57 {
            true -> accumulate(reader, value, sign)
            false -> separator(reader, value, sign, seen)
        }
    }
    machine accumulate(reader: &mut Reader, value: i32, sign: f64) {
        reader.value = reader.value * 10.0 + F64::from_i32(value) - 48.0;
        transition reader.value <= 100.0 {
            true -> next(reader, sign, true)
            false -> bad(reader)
        }
    }
    machine separator(reader: &mut Reader, value: i32, sign: f64, seen: bool) {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> finish(reader, sign, seen)
            false -> bad(reader)
        }
    }
    machine finish(reader: &mut Reader, sign: f64, seen: bool) {
        reader.value = reader.value * sign;
        transition seen { true -> done() false -> bad(reader) }
    }
    machine bad(reader: &mut Reader) { reader.valid = false; }
    machine done() { }
}
public machine end_input(reader: &mut Reader) reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> read(reader) }
    machine read(reader: &mut Reader) {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> done()
            ByteRead::Byte { value } -> check(reader, value)
        }
    }
    machine check(reader: &mut Reader, value: i32) {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> read(reader)
            false -> bad(reader)
        }
    }
    machine bad(reader: &mut Reader) { reader.valid = false; }
    machine done() { }
}
