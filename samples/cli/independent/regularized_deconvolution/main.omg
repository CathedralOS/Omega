// Expected exit: 0. Numerical output qualified by validate.py and frozen oracles.
use domain::input;
use domain::report;
use domain::convolution;
use omega::language::core::float_operations;
use omega_language_std::math;
use omega_language_std::console;

data Application {
    reader: Reader; kernel: [f64; 5]; measurements: [f64; 32];
    solution: [f64; 32]; residual: [f64; 32]; direction: [f64; 32]; product: [f64; 32]; temporary: [f64; 32]; right: [f64; 32];
    length: i32 in Wrapping; width: i32 in Wrapping; index: i32 in Wrapping; iterations: i32 in Wrapping;
    regularization: f64; kernel_sum: f64; sum: f64; squared: f64; previous: f64; scale: f64; residual_norm: f64; roughness: f64;
}
machine Application::main(application: &mut Application) reaches Console crashes Trap {
    let length: Number = block number(&mut application.reader);
    let width: Number = block number(&mut application.reader);
    let regularization: Number = block number(&mut application.reader);
    transition length.valid && width.valid && regularization.valid && length.value >= 8.0 && length.value <= 32.0 && (width.value == 1.0 || width.value == 3.0 || width.value == 5.0) && regularization.value >= 0.0001 && regularization.value <= 100.0 {
        true -> configure(application, length.value, width.value, regularization.value)
        _ -> invalid(application)
    }
    state configure(application: &mut Application, length: f64, width: f64, regularization: f64) {
        let count: i32 in Saturating = I32::from_f64(length);
        let taps: i32 in Saturating = I32::from_f64(width);
        application.length = count as i32 in Wrapping; application.width = taps as i32 in Wrapping; application.regularization = regularization;
        application.index = 0; application.kernel_sum = 0.0;
        let recovered: f64 = F64::from_i32(count as i32);
        transition recovered == length { true -> kernel(application) _ -> invalid(application) }
    }
    state kernel(application: &mut Application) {
        transition application.index >= 0 && application.index < application.width && application.index < 5 { true -> read_kernel(application) _ -> normalized(application) }
    }
    state read_kernel(application: &mut Application) {
        let value: Number = block number(&mut application.reader);
        transition value.valid && value.value >= 0.0 && value.value <= 1.0 { true -> store_kernel(application, value.value) _ -> invalid(application) }
    }
    state store_kernel(application: &mut Application, value: f64) {
        application.kernel[application.index] = value; application.kernel_sum = application.kernel_sum + value; application.index = application.index + 1;
        transition { _ -> kernel(application) }
    }
    state normalized(application: &mut Application) {
        application.index = 0; application.sum = 0.0;
        transition application.kernel_sum >= 0.999999999999 && application.kernel_sum <= 1.000000000001 { true -> measurement(application) _ -> invalid(application) }
    }
    state measurement(application: &mut Application) {
        transition application.index >= 0 && application.index < application.length && application.index < 32 { true -> read_measurement(application) _ -> complete(application) }
    }
    state read_measurement(application: &mut Application) {
        let value: Number = block number(&mut application.reader);
        transition value.valid && value.value >= 0.0 { true -> store_measurement(application, value.value) _ -> invalid(application) }
    }
    state store_measurement(application: &mut Application, value: f64) {
        application.measurements[application.index] = value;
        application.sum = application.sum + value; application.index = application.index + 1;
        transition { _ -> measurement(application) }
    }
    state complete(application: &mut Application) {
        let end: bool = block ended(&mut application.reader);
        transition end { true -> prepare(application) _ -> invalid(application) }
    }
    state prepare(application: &mut Application) {
        convolve(&application.measurements, &mut application.right, &application.kernel, application.length, application.width, true);
        application.index = 0; application.squared = 0.0; application.iterations = 0;
        transition { _ -> initialize(application) }
    }
    state initialize(application: &mut Application) {
        transition application.index >= 0 && application.index < application.length && application.index < 32 { true -> initial_value(application) _ -> iterate_start(application) }
    }
    state initial_value(application: &mut Application) {
        let mean: f64 = application.sum / F64::from_i32(application.length as i32) / (application.kernel_sum * application.kernel_sum);
        let value: f64 = application.right[application.index] - mean * application.kernel_sum * application.kernel_sum;
        application.solution[application.index] = mean; application.residual[application.index] = value; application.direction[application.index] = value;
        application.squared = application.squared + value * value; application.index = application.index + 1;
        transition { _ -> initialize(application) }
    }
    state iterate_start(application: &mut Application) {
        application.scale = application.squared + 1.0;
        transition { _ -> iterate(application) }
    }
    state iterate(application: &mut Application) {
        transition application.squared > 0.00000000000000000000000001 * application.scale && application.iterations < 256 { true -> apply(application) _ -> reconstruction(application) }
    }
    state apply(application: &mut Application) {
        convolve(&application.direction, &mut application.temporary, &application.kernel, application.length, application.width, false);
        convolve(&application.temporary, &mut application.product, &application.kernel, application.length, application.width, true);
        application.index = 0; application.previous = 0.0;
        transition { _ -> penalty(application) }
    }
    state penalty(application: &mut Application) {
        transition application.index >= 0 && application.index < application.length && application.index < 32 && application.length >= 8 && application.length <= 32 { true -> neighbors(application) _ -> step(application) }
    }
    state neighbors(application: &mut Application)
    requires application.length >= 8 && application.length <= 32 {
        let before: i32 in Wrapping = (application.index + application.length - 1) % application.length;
        let after: i32 in Wrapping = (application.index + 1) % application.length;
        transition before >= 0 && before < 32 && after >= 0 && after < 32 { true -> laplacian(application, before, after) _ -> failed(application) }
    }
    state laplacian(application: &mut Application, before: i32 in Wrapping, after: i32 in Wrapping)
    requires before >= 0 && before < 32 && after >= 0 && after < 32 {
        let value: f64 = application.product[application.index] + application.regularization * (2.0 * application.direction[application.index] - application.direction[before] - application.direction[after]);
        application.product[application.index] = value;
        application.previous = application.previous + application.direction[application.index] * value; application.index = application.index + 1;
        transition { _ -> penalty(application) }
    }
    state step(application: &mut Application) {
        transition application.previous > 0.0 { true -> update_start(application, application.squared / application.previous) _ -> failed(application) }
    }
    state update_start(application: &mut Application, alpha: f64) {
        application.index = 0; application.previous = application.squared; application.squared = 0.0;
        transition { _ -> update(application, alpha) }
    }
    state update(application: &mut Application, alpha: f64) {
        transition application.index >= 0 && application.index < application.length && application.index < 32 { true -> updated(application, alpha) _ -> direction_start(application) }
    }
    state updated(application: &mut Application, alpha: f64) {
        application.solution[application.index] = application.solution[application.index] + alpha * application.direction[application.index];
        let value: f64 = application.residual[application.index] - alpha * application.product[application.index];
        application.residual[application.index] = value; application.squared = application.squared + value * value;
        application.index = application.index + 1; transition { _ -> update(application, alpha) }
    }
    state direction_start(application: &mut Application) {
        application.index = 0; application.iterations = application.iterations + 1;
        transition { _ -> direction(application, application.squared / application.previous) }
    }
    state direction(application: &mut Application, beta: f64) {
        transition application.index >= 0 && application.index < application.length && application.index < 32 { true -> directed(application, beta) _ -> iterate(application) }
    }
    state directed(application: &mut Application, beta: f64) {
        application.direction[application.index] = application.residual[application.index] + beta * application.direction[application.index];
        application.index = application.index + 1; transition { _ -> direction(application, beta) }
    }
    state reconstruction(application: &mut Application) {
        transition application.iterations < 256 { true -> reconvolve(application) _ -> failed(application) }
    }
    state reconvolve(application: &mut Application) {
        convolve(&application.solution, &mut application.temporary, &application.kernel, application.length, application.width, false);
        application.index = 0; application.residual_norm = 0.0; application.roughness = 0.0;
        transition { _ -> report(application) }
    }
    state report(application: &mut Application) {
        transition application.index >= 0 && application.index < application.length && application.index < 32 && application.length >= 8 && application.length <= 32 { true -> report_position(application) _ -> totals(application) }
    }
    state report_position(application: &mut Application)
    requires application.length >= 8 && application.length <= 32 {
        let after: i32 in Wrapping = (application.index + 1) % application.length;
        transition after >= 0 && after < 32 { true -> report_value(application, after) _ -> failed(application) }
    }
    state report_value(application: &mut Application, after: i32 in Wrapping)
    requires after >= 0 && after < 32 {
        field(&mut application.reader, "reconstruction=", application.solution[application.index]);
        field(&mut application.reader, "reconvolution=", application.temporary[application.index]);
        let error: f64 = application.temporary[application.index] - application.measurements[application.index];
        let difference: f64 = application.solution[after] - application.solution[application.index];
        application.residual_norm = application.residual_norm + error * error;
        application.roughness = application.roughness + difference * difference;
        application.index = application.index + 1; transition { _ -> report(application) }
    }
    state totals(application: &mut Application) {
        field(&mut application.reader, "residual_norm=", sqrt_f64(application.residual_norm));
        field(&mut application.reader, "roughness=", sqrt_f64(application.roughness));
        field(&mut application.reader, "objective=", application.residual_norm + application.regularization * application.roughness);
        Console::exit_process(0);
    }
    state invalid(application: &mut Application) { Console::write_line("ERROR malformed input, measurements, kernel or lambda"); Console::exit_process(2); }
    state failed(application: &mut Application) { Console::write_line("ERROR numerical convergence"); Console::exit_process(3); }
}
