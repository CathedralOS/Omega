// Expected exit: 2 (EOF).
// Expected output contains: invalid input: one digit 0..9 and LF required
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use kinetics;
use format;
data Main {
    model: Model; mode: u64; initial_x: i64;
    replicate: u64; sum_x: u64; sum_x2: u64; sum_y: u64; sum_y2: u64;
    zero: u64; one: u64; two: u64; three_plus: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    let first: ByteRead = block Console::read_byte();
    transition first { ByteRead::Byte { value } -> digit(main, value) _ -> invalid(main) }
    machine digit(main: &mut Main, value: i32) {
        transition value >= 48 && value <= 57 { true -> newline(main, value) _ -> invalid(main) }
    }
    machine newline(main: &mut Main, value: i32) requires value >= 48 && value <= 57 {
        main.mode = (value - 48) as u64;
        let ending: ByteRead = block Console::read_byte();
        transition ending { ByteRead::Byte { value } -> ending(main, value) _ -> invalid(main) }
    }
    machine ending(main: &mut Main, value: i32) {
        transition value == 10 { true -> configure(main) _ -> invalid(main) }
    }
    machine configure(main: &mut Main) {
        main.model.seed = 1;
        main.model.birth = 2.0; main.model.translation = 0.0;
        main.model.decay_x = 1.0; main.model.decay_y = 0.0;
        main.model.budget = 100;
        transition main.mode {
            1 -> gene(main)
            8 -> gene(main)
            9 -> negative_decay(main)
            3 -> negative_rate(main)
            4 -> negative_population(main)
            5 -> overflow_case(main)
            6 -> budget_case(main)
            7 -> alternate_seed(main)
            _ -> begin(main)
        }
    }
    machine gene(main: &mut Main) {
        main.model.translation = 1.0; main.model.decay_y = 0.5;
        transition { _ -> begin(main) }
    }
    machine negative_rate(main: &mut Main) { main.model.birth = -1.0; transition { _ -> begin(main) } }
    machine negative_decay(main: &mut Main) { main.model.decay_x = -0.5; transition { _ -> begin(main) } }
    machine negative_population(main: &mut Main) { main.initial_x = -1; transition { _ -> begin(main) } }
    machine overflow_case(main: &mut Main) { main.initial_x = 100000; main.model.seed = 100000; main.model.decay_x = 0.0; transition { _ -> begin(main) } }
    machine budget_case(main: &mut Main) { main.model.budget = 0; main.model.seed = 100000; transition { _ -> begin(main) } }
    machine alternate_seed(main: &mut Main) { main.model.seed = 314159; transition { _ -> begin(main) } }
    machine begin(main: &mut Main) {
        let accepted: bool = valid(&main.model, main.initial_x);
        transition accepted { true -> initialize(main) _ -> invalid_model(main) }
    }
    machine initialize(main: &mut Main) {
        main.model.x = narrow_i64_to_u64_saturating(main.initial_x);
        transition { _ -> select(main) }
    }
    machine select(main: &mut Main) {
        transition main.mode == 2 || main.mode == 8 { true -> trace(main) _ -> select_test(main) }
    }
    machine select_test(main: &mut Main) {
        transition main.mode == 5 || main.mode == 6 { true -> single_step(main) _ -> ensemble(main) }
    }
    machine single_step(main: &mut Main) {
        advance(&mut main.model);
        transition main.model.status {
            2 -> exhausted(main)
            3 -> overflow(main)
            _ -> failed(main)
        }
    }
    machine failed(main: &mut Main) { Console::write_line("unexpected control result"); Console::exit_process(5); }
    machine trace(main: &mut Main) {
        main.model.budget = 20; main.model.seed = 100000;
        transition main.mode == 8 { true -> gene_header(main) _ -> immigration_header(main) }
    }
    machine gene_header(main: &mut Main) {
        Console::write_line("trajectory seed=100000 model=gene_expression");
        transition { _ -> trace_step(main) }
    }
    machine immigration_header(main: &mut Main) {
        Console::write_line("trajectory seed=100000 model=immigration_death");
        transition { _ -> trace_step(main) }
    }
    machine trace_step(main: &mut Main) {
        advance(&mut main.model);
        transition main.model.status {
            0 -> trace_event(main)
            1 -> trace_done(main)
            2 -> exhausted(main)
            _ -> overflow(main)
        }
    }
    machine trace_event(main: &mut Main) {
        Console::write("event="); integer(main.model.events);
        Console::write(" time="); number(main.model.time);
        Console::write(" channel="); integer(main.model.channel);
        Console::write(" x="); integer(main.model.x);
        Console::write(" y="); integer(main.model.y);
        Console::write_line("");
        transition { _ -> trace_step(main) }
    }
    machine trace_done(main: &mut Main) {
        Console::write("final time="); number(main.model.time);
        Console::write(" x="); integer(main.model.x);
        Console::write_line(""); Console::exit_process(0);
    }
    machine ensemble(main: &mut Main) { transition { _ -> replicate(main) } }
    machine replicate(main: &mut Main) {
        transition main.replicate < 1024 { true -> reset(main) _ -> summarize(main) }
    }
    machine reset(main: &mut Main) {
        main.model.time = 0.0; main.model.x = 0; main.model.y = 0;
        main.model.events = 0; main.model.status = 0;
        transition { _ -> step(main) }
    }
    machine step(main: &mut Main) {
        advance(&mut main.model);
        transition main.model.status {
            0 -> step(main)
            1 -> collect(main)
            2 -> exhausted(main)
            _ -> overflow(main)
        }
    }
    machine collect(main: &mut Main) {
        let sum_x_next: u64 in Saturating = (main.sum_x as u64 in Saturating) + (main.model.x as u64 in Saturating); main.sum_x = sum_x_next as u64;
        let sum_x2_next: u64 in Saturating = (main.sum_x2 as u64 in Saturating) + (main.model.x as u64 in Saturating) * (main.model.x as u64 in Saturating); main.sum_x2 = sum_x2_next as u64;
        let sum_y_next: u64 in Saturating = (main.sum_y as u64 in Saturating) + (main.model.y as u64 in Saturating); main.sum_y = sum_y_next as u64;
        let sum_y2_next: u64 in Saturating = (main.sum_y2 as u64 in Saturating) + (main.model.y as u64 in Saturating) * (main.model.y as u64 in Saturating); main.sum_y2 = sum_y2_next as u64;
        transition main.model.x {
            0 -> bucket_zero(main)
            1 -> bucket_one(main)
            2 -> bucket_two(main)
            _ -> bucket_three(main)
        }
    }
    machine bucket_zero(main: &mut Main) { let zero_next: u64 in Saturating = (main.zero as u64 in Saturating) + 1; main.zero = zero_next as u64; transition { _ -> next(main) } }
    machine bucket_one(main: &mut Main) { let one_next: u64 in Saturating = (main.one as u64 in Saturating) + 1; main.one = one_next as u64; transition { _ -> next(main) } }
    machine bucket_two(main: &mut Main) { let two_next: u64 in Saturating = (main.two as u64 in Saturating) + 1; main.two = two_next as u64; transition { _ -> next(main) } }
    machine bucket_three(main: &mut Main) { let three_plus_next: u64 in Saturating = (main.three_plus as u64 in Saturating) + 1; main.three_plus = three_plus_next as u64; transition { _ -> next(main) } }
    machine next(main: &mut Main) { let replicate_next: u64 in Saturating = (main.replicate as u64 in Saturating) + 1; main.replicate = replicate_next as u64; transition { _ -> replicate(main) } }
    machine summarize(main: &mut Main) {
        Console::write("ensemble n="); integer(main.replicate);
        Console::write(" seed_end="); integer(main.model.seed);
        Console::write_line("");
        Console::write("sum_x="); integer(main.sum_x);
        Console::write(" sum_x2="); integer(main.sum_x2);
        Console::write(" sum_y="); integer(main.sum_y);
        Console::write(" sum_y2="); integer(main.sum_y2);
        Console::write_line("");
        Console::write("hist_x 0="); integer(main.zero);
        Console::write(" 1="); integer(main.one);
        Console::write(" 2="); integer(main.two);
        Console::write(" 3plus="); integer(main.three_plus);
        Console::write_line("");
        Console::exit_process(0);
    }
    machine invalid(main: &mut Main) { Console::write_line("invalid input: one digit 0..9 and LF required"); Console::exit_process(2); }
    machine invalid_model(main: &mut Main) { Console::write_line("invalid model: nonnegative rates and populations, bounded seed required"); Console::exit_process(2); }
    machine exhausted(main: &mut Main) { Console::write_line("event budget exhausted"); Console::exit_process(3); }
    machine overflow(main: &mut Main) { Console::write_line("population overflow"); Console::exit_process(4); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
