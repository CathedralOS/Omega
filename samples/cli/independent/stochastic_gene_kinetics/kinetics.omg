// Direct-method continuous-time Markov chain. Both independent uniforms are
// generated from the same explicit Park–Miller stream. The 64-bit product is
// at most 36,089,477,735,730, well below u64 overflow.
use omega::language::core::float_operations;
public data Model {
    seed: u64; time: f64; x: u64; y: u64; events: u64; budget: u64;
    birth: f64; translation: f64; decay_x: f64; decay_y: f64;
    status: u64; channel: u64;
}
public machine draw(model: &mut Model) -> f64 {
    let product: u64 in Wrapping = (model.seed as u64 in Wrapping) * 16807;
    model.seed = (product as u64) % 2147483647;
    transition { _ -> uniform(model.seed) }
    machine uniform(value: u64) -> f64 {
        let converted: f64 = F64::from_u64(value);
        transition { _ -> (converted / 2147483647.0) }
    }
}
// log(x) uses dyadic range reduction and the positive atanh series. For
// x in [1/2147483647,1), at most 31 reductions; after reduction y in [0.5,1),
// z=(y-1)/(y+1) in [-1/3,0). 16 odd terms leave < 2e-17 absolute
// series remainder. 2*sum + exponent*ln(2) is enough for six-digit output.
public machine natural_log(value: f64) -> f64 {
    transition { _ -> reduce(value, 0.0) }
    machine reduce(value: f64, offset: f64) -> f64 {
        transition value < 0.5 {
            true -> reduce(value * 2.0, offset - 0.6931471805599453)
            false -> series(value, offset)
        }
    }
    machine series(value: f64, offset: f64) -> f64 {
        let z: f64 = (value - 1.0) / (value + 1.0);
        let square: f64 = z * z;
        transition { _ -> terms(z, square, z, 1.0, 0.0, offset, 0) }
    }
    machine terms(z: f64, square: f64, power: f64, denominator: f64, sum: f64, offset: f64, index: u64) -> f64 {
        let updated: f64 = sum + power / denominator;
        transition index < 15 {
            true -> terms(z, square, power * square, denominator + 2.0, updated, offset, index + 1)
            false -> result(updated, offset)
        }
    }
    machine result(sum: f64, offset: f64) -> f64 { offset + 2.0 * sum }
}
// status: 0 running, 1 horizon reached, 2 budget exhausted, 3 population
// overflow. A pending event is tested before consuming the budget.
public machine advance(model: &mut Model) {
    let x_float: f64 = F64::from_u64(model.x);
    let y_float: f64 = F64::from_u64(model.y);
    let transcription: f64 = model.birth;
    let translation: f64 = model.translation * x_float;
    let x_death: f64 = model.decay_x * x_float;
    let y_death: f64 = model.decay_y * y_float;
    let total: f64 = transcription + translation + x_death + y_death;
    transition total > 0.0 { true -> wait(model, transcription, translation, x_death, total) _ -> finish(model) }
    machine wait(model: &mut Model, transcription: f64, translation: f64, x_death: f64, total: f64) {
        let uniform: f64 = draw(model);
        let delay: f64 = (0.0 - natural_log(uniform)) / total;
        transition model.time + delay <= 2.0 {
            true -> budget(model, transcription, translation, x_death, total, delay)
            false -> finish(model)
        }
    }
    machine budget(model: &mut Model, transcription: f64, translation: f64, x_death: f64, total: f64, delay: f64) {
        transition model.events < model.budget {
            true -> choose(model, transcription, translation, x_death, total, delay)
            false -> exhausted(model)
        }
    }
    machine choose(model: &mut Model, transcription: f64, translation: f64, x_death: f64, total: f64, delay: f64) {
        let uniform: f64 = draw(model);
        let threshold: f64 = uniform * total;
        transition threshold < transcription {
            true -> born_x(model, delay)
            false -> later(model, transcription, translation, x_death, threshold, delay)
        }
    }
    machine later(model: &mut Model, transcription: f64, translation: f64, x_death: f64, threshold: f64, delay: f64) {
        transition threshold < transcription + translation {
            true -> born_y(model, delay)
            false -> deaths(model, transcription, translation, x_death, threshold, delay)
        }
    }
    machine deaths(model: &mut Model, transcription: f64, translation: f64, x_death: f64, threshold: f64, delay: f64) {
        transition threshold < transcription + translation + x_death {
            true -> dead_x(model, delay)
            false -> dead_y(model, delay)
        }
    }
    machine born_x(model: &mut Model, delay: f64) {
        transition model.x < 100000 { true -> increase_x(model, delay) _ -> overflow(model) }
    }
    machine increase_x(model: &mut Model, delay: f64) {
        model.x = model.x + 1; model.channel = 1; transition { _ -> accepted(model, delay) }
    }
    machine born_y(model: &mut Model, delay: f64) {
        transition model.y < 100000 { true -> increase_y(model, delay) _ -> overflow(model) }
    }
    machine increase_y(model: &mut Model, delay: f64) {
        model.y = model.y + 1; model.channel = 2; transition { _ -> accepted(model, delay) }
    }
    machine dead_x(model: &mut Model, delay: f64) {
        transition model.x > 0 { true -> decrease_x(model, delay) _ -> overflow(model) }
    }
    machine decrease_x(model: &mut Model, delay: f64) {
        model.x = model.x - 1; model.channel = 3; transition { _ -> accepted(model, delay) }
    }
    machine dead_y(model: &mut Model, delay: f64) {
        transition model.y > 0 { true -> decrease_y(model, delay) _ -> overflow(model) }
    }
    machine decrease_y(model: &mut Model, delay: f64) {
        model.y = model.y - 1; model.channel = 4; transition { _ -> accepted(model, delay) }
    }
    machine accepted(model: &mut Model, delay: f64) {
        model.time = model.time + delay; model.events = model.events + 1;
    }
    machine finish(model: &mut Model) { model.time = 2.0; model.status = 1; }
    machine exhausted(model: &mut Model) { model.status = 2; }
    machine overflow(model: &mut Model) { model.status = 3; }
}

// Validate the signed configuration before converting its population to u64.
public machine valid(model: &Model, initial_x: i64) -> bool {
    transition model.birth >= 0.0 && model.translation >= 0.0
        && model.decay_x >= 0.0 && model.decay_y >= 0.0
        && initial_x >= 0 && initial_x <= 100000
        && model.seed > 0 && model.seed < 2147483647 {
        true -> accepted()
        _ -> refused()
    }
    machine accepted() -> bool { true }
    machine refused() -> bool { false }
}
