// Expected exit: 0.
// Expected output contains: molecular_pair_distribution
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use io::input;
use io::output;
use domain::model;
use domain::distribution;

machine main() reaches Console invokes Console; blocks; crashes Trap {
    let mut reader: InputReader;
    reader.remaining = 32768; reader.exhausted = false;
    let mut distribution: Distribution;
    transition { _ -> read(&mut reader, &mut distribution, 0) }
    machine read(reader: &mut InputReader, distribution: &mut Distribution, position: i32 in Wrapping) {
        let observed: Token = block token(reader);
        transition observed {
            Token::Number { value } -> header(reader, distribution, position, value)
            _ -> invalid()
        }
    }
    machine header(reader: &mut InputReader, distribution: &mut Distribution, position: i32 in Wrapping, value: i32) {
        transition position {
            0 -> box(reader, distribution, value)
            1 -> particles(reader, distribution, value)
            2 -> snapshots(reader, distribution, value)
            3 -> bins(reader, distribution, value)
            _ -> body(reader, distribution, position, value)
        }
    }
    machine box(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        transition value >= 2 && value <= 1000 { true -> set_box(reader, distribution, value) _ -> invalid() }
    }
    machine set_box(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        distribution.box = value; transition { _ -> read(reader, distribution, 1) }
    }
    machine particles(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        transition value >= 2 && value <= 32 { true -> set_particles(reader, distribution, value) _ -> invalid() }
    }
    machine set_particles(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        distribution.particles = value as i32 in Wrapping; transition { _ -> read(reader, distribution, 2) }
    }
    machine snapshots(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        transition value >= 1 && value <= 8 { true -> set_snapshots(reader, distribution, value) _ -> invalid() }
    }
    machine set_snapshots(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        distribution.snapshots = value as i32 in Wrapping; transition { _ -> read(reader, distribution, 3) }
    }
    machine bins(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        transition value >= 1 && value <= 16 { true -> set_bins(reader, distribution, value) _ -> invalid() }
    }
    machine set_bins(reader: &mut InputReader, distribution: &mut Distribution, value: i32) {
        distribution.bins = value as i32 in Wrapping; transition { _ -> read(reader, distribution, 4) }
    }
    machine body(reader: &mut InputReader, distribution: &mut Distribution, position: i32 in Wrapping, value: i32) {
        transition position < 4 + distribution.bins {
            true -> edge_guard(reader, distribution, position - 4, value)
            _ -> coordinate_guard(reader, distribution, position, value)
        }
    }
    machine edge_guard(reader: &mut InputReader, distribution: &mut Distribution, index: i32 in Wrapping, value: i32) {
        transition index >= 0 && index < 16 && value > 0 && value <= distribution.box / 2 {
            true -> prior(reader, distribution, index, value) _ -> invalid()
        }
    }
    machine prior(reader: &mut InputReader, distribution: &mut Distribution, index: i32 in Wrapping, value: i32) {
        transition index == 0 { true -> edge(reader, distribution, index, value) _ -> increasing(reader, distribution, index, value) }
    }
    machine increasing(reader: &mut InputReader, distribution: &mut Distribution, index: i32 in Wrapping, value: i32) {
        transition index > 0 && index < 16 {
            true -> compare(reader, distribution, index, value) _ -> invalid()
        }
    }
    machine compare(reader: &mut InputReader, distribution: &mut Distribution, index: i32 in Wrapping, value: i32) {
        transition value > distribution.edges[index - 1] { true -> edge(reader, distribution, index, value) _ -> invalid() }
    }
    machine edge(reader: &mut InputReader, distribution: &mut Distribution, index: i32 in Wrapping, value: i32) {
        distribution.edges[index] = value;
        distribution.counts[index] = 0;
        transition { _ -> read(reader, distribution, 5 + index) }
    }
    machine coordinate_guard(reader: &mut InputReader, distribution: &mut Distribution, position: i32 in Wrapping, value: i32) {
        let index: i32 in Wrapping = position - 4 - distribution.bins;
        transition index >= 0 && index < 768 && value >= -1000000 && value <= 1000000 {
            true -> coordinate(reader, distribution, index, value) _ -> invalid()
        }
    }
    machine coordinate(reader: &mut InputReader, distribution: &mut Distribution, index: i32 in Wrapping, value: i32) {
        distribution.coordinates[index] = value;
        let next: i32 in Wrapping = 5 + distribution.bins + index;
        transition index + 1 == 3 * distribution.particles * distribution.snapshots {
            true -> tail(reader, distribution) _ -> read(reader, distribution, next)
        }
    }
    machine tail(reader: &mut InputReader, distribution: &mut Distribution) {
        let observed: Token = block token(reader);
        transition observed { Token::End -> budget(reader, distribution) _ -> invalid() }
    }
    machine budget(reader: &InputReader, distribution: &mut Distribution) {
        transition !reader.exhausted { true -> calculate(distribution) _ -> invalid() }
    }
    machine calculate(distribution: &mut Distribution) {
        histogram(distribution);
        report(distribution);
        Console::exit_process(0);
    }
    machine invalid() { Console::write_line("INVALID molecular input"); Console::exit_process(2); }
}
