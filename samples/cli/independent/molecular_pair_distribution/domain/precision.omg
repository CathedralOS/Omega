use omega::language::core::float_operations;
// Double-double arithmetic retains low rounding residues. Integer distances
// and cubic shell differences are exact in f64 throughout the wire envelope;
// normalization uses a split reciprocal of pi and compensated division.
use omega::language::core::numeric_conversion;
public data Precise { high: f64; low: f64; }
public machine precise_sum(high: f64, low: f64) -> Precise {
    let sum: f64 = high + low;
    Precise { high: sum, low: low - (sum - high) }
}
public machine product(first: f64, second: f64) -> Precise {
    let value: f64 = first * second;
    let first_split: f64 = 134217729.0 * first;
    let first_high: f64 = first_split - (first_split - first);
    let first_low: f64 = first - first_high;
    let second_split: f64 = 134217729.0 * second;
    let second_high: f64 = second_split - (second_split - second);
    let second_low: f64 = second - second_high;
    let error: f64 = ((first_high * second_high - value) + first_high * second_low + first_low * second_high) + first_low * second_low;
    Precise { high: value, low: error }
}
public machine multiply(first: Precise, second: Precise) -> Precise {
    let leading: Precise = product(first.high, second.high);
    precise_sum(leading.high, leading.low + first.high * second.low + first.low * second.high + first.low * second.low)
}
public machine quotient(numerator: f64, denominator: f64) -> Precise {
    let leading: f64 = numerator / denominator;
    let subtracted: Precise = product(leading, denominator);
    let correction: f64 = ((numerator - subtracted.high) - subtracted.low) / denominator;
    precise_sum(leading, correction)
}
public machine normalized(count: f64, box: f64, snapshots: f64, particles: f64, cube_difference: f64) -> Precise {
    let numerator: f64 = 3.0 * count * box * box * box;
    let denominator: f64 = 2.0 * snapshots * particles * (particles - 1.0) * cube_difference;
    let ratio: Precise = quotient(numerator, denominator);
    let reciprocal_pi: Precise = Precise { high: 0.3183098861837907, low: -0.000000000000000019678676675182486954033 };
    multiply(ratio, reciprocal_pi)
}
