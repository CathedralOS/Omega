use omega_language_std::console;
use omega::language::core::float_operations;
use domain::model;

public data InputReader {
    remaining: i32 in Wrapping;
    exhausted: bool;
}
public data Token {
    case Invalid;
    case End;
    case Number(value: i32);
}
// The caller sets a 32768-byte budget; exhaustion is distinct from real EOF.
machine next_byte(reader: &mut InputReader) -> ByteRead reaches Console
invokes Console;
blocks;
crashes Trap
{
    let byte: ByteRead = block Console::read_byte();
    transition byte {
        ByteRead::Eof -> ByteRead::Eof
        ByteRead::Byte { value } -> capacity(reader, value)
    }
    machine capacity(reader: &mut InputReader, value: i32) -> ByteRead
    requires value >= 0 && value <= 255
    {
        transition reader.remaining > 0 {
            true -> consume(reader, value)
            _ -> limit(reader)
        }
    }
    machine consume(reader: &mut InputReader, value: i32) -> ByteRead
    requires value >= 0 && value <= 255
    {
        reader.remaining = reader.remaining - 1;
        ByteRead::Byte { value: value }
    }
    machine limit(reader: &mut InputReader) -> ByteRead {
        reader.exhausted = true;
        ByteRead::Eof
    }
}
public machine token(reader: &mut InputReader) -> Token reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> skip(reader) }
    machine skip(reader: &mut InputReader) -> Token {
        let byte: ByteRead = block next_byte(reader);
        transition byte {
            ByteRead::Eof -> Token::End
            ByteRead::Byte { value } -> first(reader, value)
        }
    }
    machine first(reader: &mut InputReader, byte: i32) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> skip(reader)
            _ -> sign(reader, byte)
        }
    }
    machine sign(reader: &mut InputReader, byte: i32) -> Token {
        transition byte == 45 {
            true -> next(reader, 0, 0, true)
            _ -> digit(reader, byte, 0, 0, false)
        }
    }
    machine digit(reader: &mut InputReader, byte: i32, magnitude: i32 in Wrapping,
                digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte >= 48 && byte <= 57 && digits < 7 {
            true -> accumulate(reader, byte, magnitude, digits, negative)
            _ -> Token::Invalid
        }
    }
    machine accumulate(reader: &mut InputReader, byte: i32, magnitude: i32 in Wrapping,
                     digits: i32 in Wrapping, negative: bool) -> Token {
        let updated: i32 in Wrapping = magnitude * 10 + (byte as i32 in Wrapping) - 48;
        transition updated <= 1000000 {
            true -> next(reader, updated, digits + 1, negative)
            _ -> Token::Invalid
        }
    }
    machine next(reader: &mut InputReader, magnitude: i32 in Wrapping,
               digits: i32 in Wrapping, negative: bool) -> Token {
        let byte: ByteRead = block next_byte(reader);
        transition byte {
            ByteRead::Eof -> finish(magnitude, digits, negative)
            ByteRead::Byte { value } -> delimiter(reader, value, magnitude, digits, negative)
        }
    }
    machine delimiter(reader: &mut InputReader, byte: i32, magnitude: i32 in Wrapping,
                    digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> finish(magnitude, digits, negative)
            _ -> digit(reader, byte, magnitude, digits, negative)
        }
    }
    machine finish(magnitude: i32 in Wrapping, digits: i32 in Wrapping, negative: bool) -> Token {
        transition digits > 0 {
            true -> signed_value(magnitude, negative)
            _ -> Token::Invalid
        }
    }
    machine signed_value(magnitude: i32 in Wrapping, negative: bool) -> Token {
        transition negative {
            true -> Token::Number { value: (0 - magnitude) as i32 }
            _ -> Token::Number { value: magnitude as i32 }
        }
    }
}
