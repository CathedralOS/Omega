use domain::input;

// Row-major seeds, FIFO flood, mark before enqueue: a pixel enters the
// private 64-slot queue at most once. Bounds guards prove every array access.
// Coordinates are checked before linearization, preventing row wrapping.
public machine label_regions(image: &mut Image) -> bool {
    image.components = 0;
    transition { _ -> scan(image, 0) }
    machine scan(image: &mut Image, position: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 64 && position < image.length {
            true -> candidate(image, position)
            false -> true
        }
    }
    machine candidate(image: &mut Image, position: i32 in Wrapping) -> bool {
        let intensity: i32 in Wrapping = image.pixels[position] as i32 in Wrapping;
        let label: i32 = image.labels[position];
        transition intensity >= image.threshold && label == 0 {
            true -> seed(image, position)
            false -> scan(image, position + 1)
        }
    }
    machine seed(image: &mut Image, position: i32 in Wrapping) -> bool {
        image.components = image.components + 1;
        image.labels[position] = image.components as i32;
        image.queue[0] = position as i32;
        image.head = 0;
        image.tail = 1;
        transition { _ -> dequeue(image, position) }
    }
    machine dequeue(image: &mut Image, seed: i32 in Wrapping) -> bool {
        transition image.head >= 0 && image.head < 64 && image.head < image.tail {
            true -> cell(image, seed)
            false -> scan(image, seed + 1)
        }
    }
    machine cell(image: &mut Image, seed: i32 in Wrapping) -> bool {
        let cell: i32 in Wrapping = image.queue[image.head] as i32 in Wrapping;
        image.head = image.head + 1;
        transition { _ -> offsets(image, seed, cell, 0) }
    }
    machine offsets(image: &mut Image, seed: i32 in Wrapping, cell: i32 in Wrapping, direction: i32 in Wrapping) -> bool {
        transition direction < 9 {
            true -> coordinates(image, seed, cell, direction)
            false -> dequeue(image, seed)
        }
    }
    machine coordinates(image: &mut Image, seed: i32 in Wrapping, cell: i32 in Wrapping, direction: i32 in Wrapping) -> bool {
        transition image.width > 0 {
            true -> coordinates_valid(image, seed, cell, direction)
            false -> false
        }
    }
    machine coordinates_valid(image: &mut Image, seed: i32 in Wrapping, cell: i32 in Wrapping, direction: i32 in Wrapping) -> bool {
        let horizontal: i32 in Wrapping = direction % 3 - 1;
        let vertical: i32 in Wrapping = direction / 3 - 1;
        let column: i32 in Wrapping = cell % image.width + horizontal;
        let row: i32 in Wrapping = cell / image.width + vertical;
        let neighbour: i32 in Wrapping = row * image.width + column;
        transition direction != 4 && (image.connectivity == 8 || horizontal == 0 || vertical == 0)
            && column >= 0 && column < image.width && row >= 0 && row < image.height {
            true -> index(image, seed, cell, direction, neighbour)
            false -> offsets(image, seed, cell, direction + 1)
        }
    }
    machine index(image: &mut Image, seed: i32 in Wrapping, cell: i32 in Wrapping, direction: i32 in Wrapping, neighbour: i32 in Wrapping) -> bool {
        transition neighbour >= 0 && neighbour < 64 {
            true -> inspect(image, seed, cell, direction, neighbour)
            false -> false
        }
    }
    machine inspect(image: &mut Image, seed: i32 in Wrapping, cell: i32 in Wrapping, direction: i32 in Wrapping, neighbour: i32 in Wrapping) -> bool {
        let intensity: i32 in Wrapping = image.pixels[neighbour] as i32 in Wrapping;
        let label: i32 = image.labels[neighbour];
        transition intensity >= image.threshold && label == 0 {
            true -> capacity(image, seed, cell, direction, neighbour)
            false -> offsets(image, seed, cell, direction + 1)
        }
    }
    machine capacity(image: &mut Image, seed: i32 in Wrapping, cell: i32 in Wrapping, direction: i32 in Wrapping, neighbour: i32 in Wrapping) -> bool {
        transition image.tail >= 0 && image.tail < 64 {
            true -> enqueue(image, seed, cell, direction, neighbour)
            false -> false
        }
    }
    machine enqueue(image: &mut Image, seed: i32 in Wrapping, cell: i32 in Wrapping, direction: i32 in Wrapping, neighbour: i32 in Wrapping) -> bool {
        image.labels[neighbour] = image.components as i32;
        image.queue[image.tail] = neighbour as i32;
        image.tail = image.tail + 1;
        transition { _ -> offsets(image, seed, cell, direction + 1) }
    }
}

public data Region {
    area: i32 in Wrapping;
    sum_x: i32 in Wrapping;
    sum_y: i32 in Wrapping;
    min_x: i32 in Wrapping;
    min_y: i32 in Wrapping;
    max_x: i32 in Wrapping;
    max_y: i32 in Wrapping;
}
public machine measure(image: &Image, label: i32 in Wrapping, region: &mut Region) {
    region.area = 0; region.sum_x = 0; region.sum_y = 0;
    region.min_x = 8; region.min_y = 8; region.max_x = 0; region.max_y = 0;
    transition { _ -> scan(image, label, region, 0) }
    machine scan(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping) {
        transition position >= 0 && position < 64 && position < image.length {
            true -> inspect(image, label, region, position)
            false -> stopped()
        }
    }
    machine inspect(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping) {
        let found: i32 in Wrapping = image.labels[position] as i32 in Wrapping;
        transition found == label {
            true -> add(image, label, region, position)
            false -> scan(image, label, region, position + 1)
        }
    }
    machine add(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping) {
        transition image.width > 0 {
            true -> accumulate(image, label, region, position)
            false -> stopped()
        }
    }
    machine accumulate(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping) {
        let column: i32 in Wrapping = position % image.width;
        let row: i32 in Wrapping = position / image.width;
        region.area = region.area + 1;
        region.sum_x = region.sum_x + column; region.sum_y = region.sum_y + row;
        transition { _ -> minimum_x(image, label, region, position, column, row) }
    }
    machine minimum_x(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        transition column < region.min_x {
            true -> set_min_x(image, label, region, position, column, row)
            false -> minimum_y(image, label, region, position, column, row)
        }
    }
    machine set_min_x(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        region.min_x = column;
        transition { _ -> minimum_y(image, label, region, position, column, row) }
    }
    machine minimum_y(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        transition row < region.min_y {
            true -> set_min_y(image, label, region, position, column, row)
            false -> maximum_x(image, label, region, position, column, row)
        }
    }
    machine set_min_y(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        region.min_y = row;
        transition { _ -> maximum_x(image, label, region, position, column, row) }
    }
    machine maximum_x(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        transition column > region.max_x {
            true -> set_max_x(image, label, region, position, column, row)
            false -> maximum_y(image, label, region, position, column, row)
        }
    }
    machine set_max_x(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        region.max_x = column;
        transition { _ -> maximum_y(image, label, region, position, column, row) }
    }
    machine maximum_y(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        transition row > region.max_y {
            true -> set_max_y(image, label, region, position, column, row)
            false -> step(image, label, region, position, column, row)
        }
    }
    machine set_max_y(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        region.max_y = row;
        transition { _ -> step(image, label, region, position, column, row) }
    }
    machine step(image: &Image, label: i32 in Wrapping, region: &mut Region, position: i32 in Wrapping, column: i32 in Wrapping, row: i32 in Wrapping) {
        transition { _ -> scan(image, label, region, position + 1) }
    }
    machine stopped() {}
}
