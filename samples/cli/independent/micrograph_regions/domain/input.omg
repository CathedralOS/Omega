use omega_language_std::console;
use omega::language::core::binding;

pub data Image {
    width: i32 in Wrapping;
    height: i32 in Wrapping;
    threshold: i32 in Wrapping;
    connectivity: i32 in Wrapping;
    length: i32 in Wrapping;
    pixels: [i32; 64];
    labels: [i32; 64];
    queue: [i32; 64];
    head: i32 in Wrapping;
    tail: i32 in Wrapping;
    components: i32 in Wrapping;
}
data Token { value: i32 in Wrapping; valid: bool; }

// Strict unsigned decimal scanner, bounded to three digits. EOF after a
// number is accepted; EOF before a required number is invalid. Only ASCII
// whitespace separates tokens. An offending character never becomes zero.
machine token(console: &Binding<Console>, token: &mut Token)
reaches Console {
    token.valid = false;
    token.value = 0;
    transition { _ -> leading(console, token) }
    state leading(console: &Binding<Console>, token: &mut Token) {
        let observed: ByteRead = block console.read_byte();
        transition observed {
            ByteRead::Eof -> stopped()
            ByteRead::Byte { value } -> first(console, token, value)
        }
    }
    state first(console: &Binding<Console>, token: &mut Token, character: i32) {
        transition character == 32 || character == 9 || character == 10 || character == 13 {
            true -> leading(console, token)
            false -> digit(console, token, character, 0)
        }
    }
    state digit(console: &Binding<Console>, token: &mut Token, character: i32, count: i32 in Wrapping) {
        transition character >= 48 && character <= 57 && count < 3 {
            true -> accumulate(console, token, character, count)
            false -> stopped()
        }
    }
    state accumulate(console: &Binding<Console>, token: &mut Token, character: i32, count: i32 in Wrapping) {
        token.value = token.value * 10 + (character as i32 in Wrapping) - 48;
        transition { _ -> next(console, token, count + 1) }
    }
    state next(console: &Binding<Console>, token: &mut Token, count: i32 in Wrapping) {
        let observed: ByteRead = block console.read_byte();
        transition observed {
            ByteRead::Eof -> complete(token)
            ByteRead::Byte { value } -> separator(console, token, value, count)
        }
    }
    state separator(console: &Binding<Console>, token: &mut Token, character: i32, count: i32 in Wrapping) {
        transition character == 32 || character == 9 || character == 10 || character == 13 {
            true -> complete(token)
            false -> digit(console, token, character, count)
        }
    }
    state complete(token: &mut Token) { token.valid = true; }
    state stopped() {}
}

pub machine read_image(console: &Binding<Console>, image: &mut Image) -> bool
invokes console;
reaches Console
blocks;
crashes Trap
{
    let mut number: Token;
    block token(console, &mut number);
    image.width = number.value;
    transition number.valid && number.value >= 1 && number.value <= 8 {
        true -> height(console, image)
        false -> false
    }
    state height(console: &Binding<Console>, image: &mut Image) -> bool {
        let mut number: Token;
        block token(console, &mut number);
        image.height = number.value;
        transition number.valid && number.value >= 1 && number.value <= 8 {
            true -> threshold(console, image)
            false -> false
        }
    }
    state threshold(console: &Binding<Console>, image: &mut Image) -> bool {
        let mut number: Token;
        block token(console, &mut number);
        image.threshold = number.value;
        transition number.valid && number.value <= 255 {
            true -> connectivity(console, image)
            false -> false
        }
    }
    state connectivity(console: &Binding<Console>, image: &mut Image) -> bool {
        let mut number: Token;
        block token(console, &mut number);
        image.connectivity = number.value;
        image.length = image.width * image.height;
        transition number.valid && (number.value == 4 || number.value == 8) {
            true -> pixels(console, image, 0)
            false -> false
        }
    }
    state pixels(console: &Binding<Console>, image: &mut Image, position: i32 in Wrapping) -> bool {
        transition position >= 0 && position < 64 && position < image.length {
            true -> store(console, image, position)
            false -> trailing(console)
        }
    }
    state store(console: &Binding<Console>, image: &mut Image, position: i32 in Wrapping) -> bool {
        let mut number: Token;
        block token(console, &mut number);
        transition number.valid && number.value <= 255 {
            true -> accepted(console, image, position, number.value)
            false -> false
        }
    }
    state accepted(console: &Binding<Console>, image: &mut Image, position: i32 in Wrapping, value: i32 in Wrapping) -> bool {
        image.pixels[position] = value as i32;
        image.labels[position] = 0;
        transition { _ -> pixels(console, image, position + 1) }
    }
    state trailing(console: &Binding<Console>) -> bool {
        let observed: ByteRead = block console.read_byte();
        transition observed {
            ByteRead::Eof -> true
            ByteRead::Byte { value } -> whitespace(console, value)
        }
    }
    state whitespace(console: &Binding<Console>, character: i32) -> bool {
        transition character == 32 || character == 9 || character == 10 || character == 13 {
            true -> trailing(console)
            false -> false
        }
    }
}
