use domain::input;
use domain::regions;
use omega_language_std::console;

// All printed values are nonnegative and <= 448. Centroids are exact
// unreduced fractions sum/area, avoiding rounding and floating tolerances.
machine number(value: i32 in Wrapping) reaches Console {
    transition value >= 100 {
        true -> hundreds(value)
        false -> tens(value)
    }
    state hundreds(value: i32 in Wrapping) {
        Console::write_byte((value / 100 + 48) as i32);
        Console::write_byte((value / 10 % 10 + 48) as i32);
        Console::write_byte((value % 10 + 48) as i32);
    }
    state tens(value: i32 in Wrapping) {
        transition value >= 10 {
            true -> two(value)
            false -> one(value)
        }
    }
    state two(value: i32 in Wrapping) {
        Console::write_byte((value / 10 + 48) as i32);
        Console::write_byte((value % 10 + 48) as i32);
    }
    state one(value: i32 in Wrapping) {
        Console::write_byte((value + 48) as i32);
    }
}

pub machine render(image: &Image)
invokes Console;
reaches Console {
    Console::write_line("P2");
    Console::write_line("# micrograph region labels; zero is background");
    number(image.width); Console::write(" "); number(image.height); Console::write_line("");
    Console::write_line("64");
    transition { _ -> pixel(image, 0) }
    state pixel(image: &Image, position: i32 in Wrapping) {
        transition position >= 0 && position < 64 && position < image.length {
            true -> emit(image, position)
            false -> heading(image)
        }
    }
    state emit(image: &Image, position: i32 in Wrapping) {
        transition image.width > 0 {
            true -> emit_pixel(image, position)
            false -> stopped()
        }
    }
    state emit_pixel(image: &Image, position: i32 in Wrapping) {
        let label: i32 in Wrapping = image.labels[position] as i32 in Wrapping;
        number(label);
        transition (position + 1) % image.width == 0 {
            true -> newline(image, position)
            false -> space(image, position)
        }
    }
    state newline(image: &Image, position: i32 in Wrapping) {
        Console::write_line("");
        transition { _ -> pixel(image, position + 1) }
    }
    state space(image: &Image, position: i32 in Wrapping) {
        Console::write(" ");
        transition { _ -> pixel(image, position + 1) }
    }
    state heading(image: &Image) {
        Console::write("regions "); number(image.components); Console::write_line("");
        Console::write_line("label area centroid_x centroid_y min_x min_y max_x max_y");
        transition { _ -> region(image, 1) }
    }
    state region(image: &Image, label: i32 in Wrapping) {
        transition label <= image.components {
            true -> report(image, label)
            false -> stopped()
        }
    }
    state report(image: &Image, label: i32 in Wrapping) {
        let mut measured: Region;
        measure(image, label, &mut measured);
        number(label); Console::write(" "); number(measured.area);
        Console::write(" "); number(measured.sum_x); Console::write("/"); number(measured.area);
        Console::write(" "); number(measured.sum_y); Console::write("/"); number(measured.area);
        Console::write(" "); number(measured.min_x); Console::write(" "); number(measured.min_y);
        Console::write(" "); number(measured.max_x); Console::write(" "); number(measured.max_y);
        Console::write_line("");
        transition { _ -> region(image, label + 1) }
    }
    state stopped() {}
}
