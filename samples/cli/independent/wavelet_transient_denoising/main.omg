// Expected exit: 0 for input.txt; numerical oracle: fixtures.json and validate.py.
use domain::input;
use domain::report;
use omega::language::core::float_operations;
use omega_language_std::console;

data Application {
    reader: Reader;
    original: [f64; 64]; retained: [f64; 64]; scratch: [[f64; 2]; 32];
    length: i32 in Wrapping; levels: i32 in Wrapping; depth: i32 in Wrapping;
    width: i32 in Wrapping; index: i32 in Wrapping; cutoff: i32 in Wrapping;
    threshold: f64; input_energy: f64; coefficient_energy: f64; retained_energy: f64;
}
machine Application::main(application: &mut Application) reaches Console crashes Trap {
    let length: Number = block number(&mut application.reader);
    let threshold: Number = block number(&mut application.reader);
    let levels: Number = block number(&mut application.reader);
    transition length.valid && threshold.valid && levels.valid && threshold.value >= 0.0 &&
        (length.value == 8.0 || length.value == 16.0 || length.value == 32.0 || length.value == 64.0) &&
        (levels.value == 0.0 || levels.value == 1.0 || levels.value == 2.0 || levels.value == 3.0 || levels.value == 4.0 || levels.value == 5.0 || levels.value == 6.0) {
        true -> options(application, length.value, threshold.value, levels.value)
        _ -> invalid(application)
    }
    state invalid(application: &mut Application) {
        Console::write_line("ERROR input or options"); Console::exit_process(10);
    }
    state options(application: &mut Application, length: f64, threshold: f64, levels: f64) {
        let depth: i32 in Wrapping = match length == 8.0 { true -> 3 _ -> match length == 16.0 { true -> 4 _ -> match length == 32.0 { true -> 5 _ -> 6 } } };
        transition levels <= F64::from_i32(depth as i32) { true -> configure(application, length, threshold, levels, depth) _ -> invalid(application) }
    }
    state configure(application: &mut Application, length: f64, threshold: f64, levels: f64, depth: i32 in Wrapping) {
        let size: i32 in Saturating = I32::from_f64(length);
        let selected: i32 in Saturating = I32::from_f64(levels);
        application.length = size as i32 in Wrapping; application.levels = selected as i32 in Wrapping;
        application.depth = depth; application.threshold = threshold;
        application.index = 0; application.input_energy = 0.0;
        transition { _ -> read(application) }
    }
    state read(application: &mut Application) {
        transition application.index >= 0 && application.index < application.length && application.index < 64 {
            true -> sample(application) _ -> finish(application)
        }
    }
    state sample(application: &mut Application) {
        let value: Number = block number(&mut application.reader);
        transition value.valid { true -> store(application, value.value) _ -> invalid(application) }
    }
    state store(application: &mut Application, value: f64) {
        application.original[application.index] = value;
        application.input_energy = application.input_energy + value * value;
        application.index = application.index + 1;
        transition { _ -> read(application) }
    }
    state finish(application: &mut Application) {
        let complete: bool = block ended(&mut application.reader);
        application.width = application.length;
        transition complete { true -> forward_stage(application) _ -> invalid(application) }
    }
    // Layout after all stages: A0, Dcoarsest, ..., Dfinest. Each stage
    // replaces only the approximation prefix; older details remain untouched.
    state forward_stage(application: &mut Application) {
        application.index = 0;
        transition application.width > 1 { true -> forward_pair(application) _ -> shrink_start(application) }
    }
    state forward_pair(application: &mut Application) {
        transition application.index >= 0 && application.index < application.width / 2 && application.index < 32 { true -> forward_bounds(application) _ -> copy_start(application) }
    }
    state forward_bounds(application: &mut Application)
    requires application.index >= 0 && application.index < 32
    {
        let first: i32 in Wrapping = application.index * 2;
        let second: i32 in Wrapping = first + 1;
        let detail: i32 in Wrapping = application.width / 2 + application.index;
        transition first >= 0 && first < 64 && second >= 0 && second < 64 && detail >= 0 && detail < 64 {
            true -> forward(application, first, second, detail) _ -> invalid(application)
        }
    }
    state forward(application: &mut Application, first: i32 in Wrapping, second: i32 in Wrapping, detail: i32 in Wrapping)
    requires first >= 0 && first < 64 && second >= 0 && second < 64 && detail >= 0 && detail < 64
    requires application.index >= 0 && application.index < 32
    {
        let left: f64 = application.original[first]; let right: f64 = application.original[second];
        application.scratch[application.index][0] = (left + right) * 0.7071067811865475244;
        application.scratch[application.index][1] = (left - right) * 0.7071067811865475244;
        application.index = application.index + 1;
        transition { _ -> forward_pair(application) }
    }
    state copy_start(application: &mut Application) { application.index = 0; transition { _ -> copy(application) } }
    state copy(application: &mut Application) {
        transition application.index >= 0 && application.index < application.width / 2 && application.index < 32 { true -> copy_bounds(application) _ -> next_forward(application) }
    }
    state copy_bounds(application: &mut Application)
    requires application.index >= 0 && application.index < 32
    {
        let detail: i32 in Wrapping = application.width / 2 + application.index;
        transition detail >= 0 && detail < 64 { true -> copied(application, detail) _ -> invalid(application) }
    }
    state copied(application: &mut Application, detail: i32 in Wrapping)
    requires detail >= 0 && detail < 64
    requires application.index >= 0 && application.index < 32
    {
        let packet: [f64; 2] = pair(&application.scratch, application.index as u64);
        application.original[application.index] = packet[0];
        application.original[detail] = packet[1];
        application.index = application.index + 1; transition { _ -> copy(application) }
    }
    state next_forward(application: &mut Application) { application.width = application.width / 2; transition { _ -> forward_stage(application) } }
    state shrink_start(application: &mut Application) {
        application.cutoff = application.length; application.depth = 0;
        transition { _ -> select(application) }
    }
    state select(application: &mut Application) {
        transition application.depth < application.levels { true -> finer(application) _ -> energy_start(application) }
    }
    state finer(application: &mut Application) {
        application.cutoff = application.cutoff / 2; application.depth = application.depth + 1;
        transition { _ -> select(application) }
    }
    state energy_start(application: &mut Application) {
        application.index = 0; application.coefficient_energy = 0.0; application.retained_energy = 0.0;
        transition { _ -> shrink(application) }
    }
    state shrink(application: &mut Application) {
        transition application.index >= 0 && application.index < application.length && application.index < 64 { true -> coefficient(application) _ -> inverse_start(application) }
    }
    state coefficient(application: &mut Application) {
        let value: f64 = application.original[application.index];
        let retained: f64 = match application.index > 0 && application.index >= application.cutoff {
            true -> soft_threshold(value, application.threshold)
            _ -> value
        };
        application.retained[application.index] = retained;
        application.coefficient_energy = application.coefficient_energy + value * value;
        application.retained_energy = application.retained_energy + retained * retained;
        field(&mut application.reader, "original_pico=", value * 1000000000000.0);
        field(&mut application.reader, "retained_pico=", retained * 1000000000000.0);
        application.index = application.index + 1; transition { _ -> shrink(application) }
    }
    state inverse_start(application: &mut Application) { application.width = 2; transition { _ -> inverse_stage(application) } }
    state inverse_stage(application: &mut Application) {
        application.index = 0;
        transition application.width <= application.length { true -> inverse_pair(application) _ -> report_start(application) }
    }
    state inverse_pair(application: &mut Application) {
        transition application.index >= 0 && application.index < application.width / 2 && application.index < 32 { true -> inverse_bounds(application) _ -> inverse_copy_start(application) }
    }
    state inverse_bounds(application: &mut Application)
    requires application.index >= 0 && application.index < 32
    {
        let first: i32 in Wrapping = application.index * 2;
        let second: i32 in Wrapping = first + 1;
        let detail: i32 in Wrapping = application.width / 2 + application.index;
        transition first >= 0 && first < 64 && second >= 0 && second < 64 && detail >= 0 && detail < 64 {
            true -> inverse(application, first, second, detail) _ -> invalid(application)
        }
    }
    state inverse(application: &mut Application, first: i32 in Wrapping, second: i32 in Wrapping, detail: i32 in Wrapping)
    requires first >= 0 && first < 64 && second >= 0 && second < 64 && detail >= 0 && detail < 64
    requires application.index >= 0 && application.index < 32
    {
        let approximation: f64 = application.retained[application.index]; let difference: f64 = application.retained[detail];
        application.scratch[application.index][0] = (approximation + difference) * 0.7071067811865475244;
        application.scratch[application.index][1] = (approximation - difference) * 0.7071067811865475244;
        application.index = application.index + 1; transition { _ -> inverse_pair(application) }
    }
    state inverse_copy_start(application: &mut Application) { application.index = 0; transition { _ -> inverse_copy(application) } }
    state inverse_copy(application: &mut Application) {
        transition application.index >= 0 && application.index < application.width / 2 && application.index < 32 { true -> inverse_copy_bounds(application) _ -> next_inverse(application) }
    }
    state inverse_copy_bounds(application: &mut Application)
    requires application.index >= 0 && application.index < 32
    {
        let first: i32 in Wrapping = application.index * 2;
        let second: i32 in Wrapping = first + 1;
        transition first >= 0 && first < 64 && second >= 0 && second < 64 {
            true -> inverse_copied(application, first, second) _ -> invalid(application)
        }
    }
    state inverse_copied(application: &mut Application, first: i32 in Wrapping, second: i32 in Wrapping)
    requires first >= 0 && first < 64 && second >= 0 && second < 64
    requires application.index >= 0 && application.index < 32
    {
        let packet: [f64; 2] = pair(&application.scratch, application.index as u64);
        application.retained[first] = packet[0];
        application.retained[second] = packet[1];
        application.index = application.index + 1; transition { _ -> inverse_copy(application) }
    }
    state next_inverse(application: &mut Application) { application.width = application.width * 2; transition { _ -> inverse_stage(application) } }
    state report_start(application: &mut Application) { application.index = 0; transition { _ -> report(application) } }
    state report(application: &mut Application) {
        transition application.index >= 0 && application.index < application.length && application.index < 64 { true -> reconstruction(application) _ -> done(application) }
    }
    state reconstruction(application: &mut Application) {
        field(&mut application.reader, "reconstruction_pico=", application.retained[application.index] * 1000000000000.0);
        application.index = application.index + 1; transition { _ -> report(application) }
    }
    state done(application: &mut Application) {
        field(&mut application.reader, "input_energy_nano=", application.input_energy * 1000000000.0);
        field(&mut application.reader, "coefficient_energy_nano=", application.coefficient_energy * 1000000000.0);
        field(&mut application.reader, "removed_energy_nano=", (application.coefficient_energy - application.retained_energy) * 1000000000.0);
        Console::exit_process(0);
    }
}
machine soft_threshold(value: f64, threshold: f64) -> f64 {
    transition value > threshold { true -> (value - threshold) _ -> negative(value, threshold) }
    state negative(value: f64, threshold: f64) -> f64 {
        transition value < 0.0 - threshold { true -> (value + threshold) _ -> 0.0 }
    }
}

// Pair storage follows the Haar stage's approximation/detail geometry. The
// selected row returns as an independent owned value; its shared source loan
// ends before reassembly writes the application buffers.
machine pair(pairs: &[[f64; 2]; 32], index: u64) -> [f64; 2]
requires index < 32;
{
    pairs[index]
}
