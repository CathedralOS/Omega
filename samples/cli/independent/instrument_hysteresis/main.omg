use omega_language_std::math;

// Expected exit: 0.
// Expected output contains: trace rows ambiguous plateaus reversals max_width 0 0 0 0 0
use omega_language_std::console;
use domain::calibration;
use domain::trace;
use io::input;
use io::report;

data Instrument {
    buffer: [u8; 64];
    calibration: Calibration;
    trace: Trace;
}
// One finite record per iteration. Invalid records never mutate history.
// The 256-row bound keeps counts and residual sums within signed i32.
machine Instrument::run(instrument: &mut Instrument) reaches Console {
    Calibration::initialize(&mut instrument.calibration);
    Console::write_line("row stimulus branch prediction observed residual width (response milliunits)");
    transition { _ -> read(instrument) }
    state read(instrument: &mut Instrument) {
        let input: LineReadResult = block Console::read_line(&mut instrument.buffer);
        transition input {
            LineReadResult::LineComplete { count } -> bounded(instrument, count)
            LineReadResult::EndOfInput { count } -> end_of_input(instrument, count)
            _ -> invalid(instrument)
        }
    }
    state end_of_input(instrument: &mut Instrument, count: u64) {
        transition count == 0 {
            true -> summary(instrument)
            false -> invalid(instrument)
        }
    }
    state bounded(instrument: &mut Instrument, count: u64) {
        transition count <= 64 {
            true -> parse(instrument, count)
            false -> invalid(instrument)
        }
    }
    state parse(instrument: &mut Instrument, count: u64) requires count <= 64 {
        let parsed: Input = parse_line(&instrument.buffer[0..count]);
        transition parsed {
            Input::Sample { stimulus, observed } -> validate(instrument, stimulus, observed)
            Input::Invalid -> invalid(instrument)
        }
    }
    state validate(instrument: &mut Instrument, stimulus: i32 in Wrapping, observed: i32 in Wrapping) {
        transition stimulus <= 100 && observed <= 200000 && instrument.trace.rows < 256 {
            true -> analyze(instrument, stimulus, observed)
            false -> range_error(instrument)
        }
    }
    state analyze(instrument: &mut Instrument, stimulus: i32 in Wrapping, observed: i32 in Wrapping) {
        let forward: i32 in Wrapping = interpolate(&instrument.calibration.forward, stimulus);
        let reverse: i32 in Wrapping = interpolate(&instrument.calibration.reverse, stimulus);
        let width: i32 in Wrapping = reverse - forward;
        identify(&mut instrument.trace, stimulus);
        instrument.trace.width_max = max_i32(instrument.trace.width_max as i32, width as i32) as i32 in Wrapping;
        number(instrument.trace.rows);
        field(stimulus);
        transition instrument.trace.branch {
            1 -> calibrated(instrument, forward, observed, width, "forward")
            2 -> calibrated(instrument, reverse, observed, width, "reverse")
            _ -> ambiguous(instrument, observed, width)
        }
    }
    state calibrated(instrument: &mut Instrument, prediction: i32 in Wrapping, observed: i32 in Wrapping, width: i32 in Wrapping, branch: &[u8]) {
        let residual: i32 in Wrapping = observed - prediction;
        residual_statistics(&mut instrument.trace, residual);
        Console::write(" ");
        Console::write(branch);
        field(prediction);
        field(observed);
        field(residual);
        field(width);
        Console::write_line("");
        transition { _ -> read(instrument) }
    }
    state ambiguous(instrument: &mut Instrument, observed: i32 in Wrapping, width: i32 in Wrapping) {
        Console::write(" ambiguous NA");
        field(observed);
        Console::write(" NA");
        field(width);
        Console::write_line("");
        transition { _ -> read(instrument) }
    }
    state summary(instrument: &mut Instrument) {
        Console::write("forward count sum_abs max_abs");
        field(instrument.trace.forward_count);
        field(instrument.trace.forward_sum);
        field(instrument.trace.forward_max);
        Console::write_line("");
        Console::write("reverse count sum_abs max_abs");
        field(instrument.trace.reverse_count);
        field(instrument.trace.reverse_sum);
        field(instrument.trace.reverse_max);
        Console::write_line("");
        Console::write("trace rows ambiguous plateaus reversals max_width");
        field(instrument.trace.rows);
        field(instrument.trace.ambiguous);
        field(instrument.trace.plateaus);
        field(instrument.trace.reversals);
        field(instrument.trace.width_max);
        Console::write_line("");
        Console::exit_process(0);
    }
    state invalid(instrument: &mut Instrument) {
        Console::write_line("ERROR malformed input: expected stimulus response LF");
        Console::exit_process(64);
    }
    state range_error(instrument: &mut Instrument) {
        Console::write_line("ERROR range: stimulus 0..100, response 0..200000, at most 256 rows");
        Console::exit_process(65);
    }
}
