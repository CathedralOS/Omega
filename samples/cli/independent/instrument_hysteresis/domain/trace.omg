use omega_language_std::math;

// Direction uses the last nonzero stimulus change. A plateau inherits it;
// without a prior change direction remains ambiguous. At a reversal the new
// branch applies immediately. The first row is always ambiguous.
data Trace {
    previous: i32 in Wrapping;
    rows: i32 in Wrapping;
    branch: i32 in Wrapping;
    plateaus: i32 in Wrapping;
    reversals: i32 in Wrapping;
    ambiguous: i32 in Wrapping;
    forward_count: i32 in Wrapping;
    reverse_count: i32 in Wrapping;
    forward_sum: i32 in Wrapping;
    reverse_sum: i32 in Wrapping;
    forward_max: i32 in Wrapping;
    reverse_max: i32 in Wrapping;
    width_max: i32 in Wrapping;
}
machine identify(trace: &mut Trace, stimulus: i32 in Wrapping) {
    transition trace.rows == 0 {
        true -> first(trace, stimulus)
        false -> compare(trace, stimulus)
    }
    machine first(trace: &mut Trace, stimulus: i32 in Wrapping) {
        trace.previous = stimulus;
        trace.rows = 1;
        trace.ambiguous = 1;
    }
    machine compare(trace: &mut Trace, stimulus: i32 in Wrapping) {
        transition stimulus == trace.previous {
            true -> plateau(trace, stimulus)
            false -> movement(trace, stimulus)
        }
    }
    machine plateau(trace: &mut Trace, stimulus: i32 in Wrapping) {
        trace.plateaus = trace.plateaus + 1;
        transition { _ -> finish(trace, stimulus) }
    }
    machine movement(trace: &mut Trace, stimulus: i32 in Wrapping) {
        transition stimulus > trace.previous {
            true -> direction(trace, stimulus, 1)
            false -> direction(trace, stimulus, 2)
        }
    }
    machine direction(trace: &mut Trace, stimulus: i32 in Wrapping, branch: i32 in Wrapping) {
        transition trace.branch != 0 && trace.branch != branch {
            true -> reversal(trace, stimulus, branch)
            false -> assign(trace, stimulus, branch)
        }
    }
    machine reversal(trace: &mut Trace, stimulus: i32 in Wrapping, branch: i32 in Wrapping) {
        trace.reversals = trace.reversals + 1;
        transition { _ -> assign(trace, stimulus, branch) }
    }
    machine assign(trace: &mut Trace, stimulus: i32 in Wrapping, branch: i32 in Wrapping) {
        trace.branch = branch;
        transition { _ -> finish(trace, stimulus) }
    }
    machine finish(trace: &mut Trace, stimulus: i32 in Wrapping) {
        trace.previous = stimulus;
        trace.rows = trace.rows + 1;
        transition trace.branch == 0 {
            true -> ambiguous(trace)
            false -> done()
        }
    }
    machine ambiguous(trace: &mut Trace) { trace.ambiguous = trace.ambiguous + 1; }
    machine done() { }
}
machine magnitude(value: i32 in Wrapping) -> i32 in Wrapping {
    transition value < 0 { true -> (0 - value) false -> (value) }
}
machine residual_statistics(trace: &mut Trace, residual: i32 in Wrapping) {
    let absolute: i32 in Wrapping = magnitude(residual);
    transition trace.branch == 1 {
        true -> forward(trace, absolute)
        false -> reverse(trace, absolute)
    }
    machine forward(trace: &mut Trace, absolute: i32 in Wrapping) {
        trace.forward_count = trace.forward_count + 1;
        trace.forward_sum = trace.forward_sum + absolute;
        trace.forward_max = max_i32(trace.forward_max as i32, absolute as i32) as i32 in Wrapping;
    }
    machine reverse(trace: &mut Trace, absolute: i32 in Wrapping) {
        trace.reverse_count = trace.reverse_count + 1;
        trace.reverse_sum = trace.reverse_sum + absolute;
        trace.reverse_max = max_i32(trace.reverse_max as i32, absolute as i32) as i32 in Wrapping;
    }
}
