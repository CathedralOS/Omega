// Complete intended-invalid application: violates its data invariant.
use omega_language_std::console;
data BoundedStimulus where value >= 0 && value <= 100 { value: i32; }
data InvalidInstrument { stimulus: BoundedStimulus; }
machine InvalidInstrument::run(instrument: &mut InvalidInstrument) reaches Console {
    instrument.stimulus.value = 101;
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: InvalidInstrument;
    InvalidInstrument::run(&mut entry_storage);
}
