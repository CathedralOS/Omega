// Linear micrometre sample model. Named offsets and temperature are shared
// variables, so their signed coefficients must be summed before endpoint choice.
// Saturating arithmetic is explicit; validated bounds keep all operations exact:
// three contributors, |nominal|<=1000, tolerance<=100, |coefficients|<=10,
// |temperature|<=100, |offset|<=10 imply |any endpoint|<=7200.
pub data Contributor [copy] {
    nominal: i32 in Saturating;
    tolerance: i32 in Saturating;
    thermal: i32 in Saturating;
    gauge_a: i32 in Saturating;
    gauge_b: i32 in Saturating;
}
pub data Assembly [copy] {
    contributors: [Contributor; 3];
    temperature_low: i32 in Saturating;
    temperature_high: i32 in Saturating;
    gauge_a_low: i32 in Saturating;
    gauge_a_high: i32 in Saturating;
    gauge_b_low: i32 in Saturating;
    gauge_b_high: i32 in Saturating;
    fit_low: i32 in Saturating;
    fit_high: i32 in Saturating;
}
pub data Audit [copy] {
    nominal: i32 in Saturating;
    radius: i32 in Saturating;
    thermal: i32 in Saturating;
    gauge_a: i32 in Saturating;
    gauge_b: i32 in Saturating;
    low: i32 in Saturating;
    high: i32 in Saturating;
    status: i32;
}
pub machine bounded(value: i32 in Saturating, limit: i32 in Saturating) -> bool {
    value >= 0 - limit && value <= limit
}
pub machine valid(assembly: &Assembly) -> bool {
    transition bounded(assembly.temperature_low, 100) && bounded(assembly.temperature_high, 100)
        && assembly.temperature_low <= assembly.temperature_high
        && bounded(assembly.gauge_a_low, 10) && bounded(assembly.gauge_a_high, 10)
        && assembly.gauge_a_low <= assembly.gauge_a_high
        && bounded(assembly.gauge_b_low, 10) && bounded(assembly.gauge_b_high, 10)
        && assembly.gauge_b_low <= assembly.gauge_b_high
        && bounded(assembly.fit_low, 1000) && bounded(assembly.fit_high, 1000)
        && assembly.fit_low <= assembly.fit_high {
        true -> scan(assembly, 0)
        false -> (false)
    }
    state scan(assembly: &Assembly, index: u32) -> bool {
        transition index < 3 { true -> item(assembly, index) false -> (true) }
    }
    state item(assembly: &Assembly, index: u32) -> bool requires index < 3 {
        let value: Contributor = assembly.contributors[index];
        transition bounded(value.nominal, 1000) && value.tolerance >= 0 && value.tolerance <= 100
            && bounded(value.thermal, 10) && bounded(value.gauge_a, 10) && bounded(value.gauge_b, 10) {
            true -> scan(assembly, index + 1)
            false -> (false)
        }
    }
}
pub machine lower_choice(coefficient: i32 in Saturating, low: i32 in Saturating, high: i32 in Saturating) -> i32 in Saturating {
    transition coefficient >= 0 { true -> (low) false -> (high) }
}
// The contributor row is a fixed array of three. Its length is a collection
// measure, so the bound is `embed` of that measure: directly on the parameter,
// on the assembly field at the call, through a local copy, and as the count
// this machine returns.
pub machine observe_span(count: u64) -> bool
requires embed(count) == 3
{
    transition { _ -> (true) }
}
pub machine contributor_span(contributors: &[Contributor; 3]) -> u32
requires embed(contributors.len) == 3
{
    let count: u64 = contributors.len;
    let accepted: bool = observe_span(count);
    transition accepted { true -> (3) false -> (0) }
}
pub machine upper_choice(coefficient: i32 in Saturating, low: i32 in Saturating, high: i32 in Saturating) -> i32 in Saturating {
    transition coefficient >= 0 { true -> (high) false -> (low) }
}
pub machine calculate(assembly: &Assembly, audit: &mut Audit) {
    let span: u32 = contributor_span(&assembly.contributors);
    transition span == 3 { true -> begin(assembly, audit) false -> uncounted(audit) }
    state begin(assembly: &Assembly, audit: &mut Audit) {
        audit.nominal = 0;
        audit.radius = 0;
        audit.thermal = 0;
        audit.gauge_a = 0;
        audit.gauge_b = 0;
        transition { _ -> scan(assembly, audit, 0) }
    }
    state uncounted(audit: &mut Audit) { audit.status = 0; }
    state scan(assembly: &Assembly, audit: &mut Audit, index: u32) {
        transition index < 3 { true -> add(assembly, audit, index) false -> endpoints(assembly, audit) }
    }
    state add(assembly: &Assembly, audit: &mut Audit, index: u32) requires index < 3 {
        let value: Contributor = assembly.contributors[index];
        audit.nominal = audit.nominal + value.nominal;
        audit.radius = audit.radius + value.tolerance;
        audit.thermal = audit.thermal + value.thermal;
        audit.gauge_a = audit.gauge_a + value.gauge_a;
        audit.gauge_b = audit.gauge_b + value.gauge_b;
        transition { _ -> scan(assembly, audit, index + 1) }
    }
    state endpoints(assembly: &Assembly, audit: &mut Audit) {
        let temperature_low: i32 in Saturating = lower_choice(audit.thermal, assembly.temperature_low, assembly.temperature_high);
        let temperature_high: i32 in Saturating = upper_choice(audit.thermal, assembly.temperature_low, assembly.temperature_high);
        let a_low: i32 in Saturating = lower_choice(audit.gauge_a, assembly.gauge_a_low, assembly.gauge_a_high);
        let a_high: i32 in Saturating = upper_choice(audit.gauge_a, assembly.gauge_a_low, assembly.gauge_a_high);
        let b_low: i32 in Saturating = lower_choice(audit.gauge_b, assembly.gauge_b_low, assembly.gauge_b_high);
        let b_high: i32 in Saturating = upper_choice(audit.gauge_b, assembly.gauge_b_low, assembly.gauge_b_high);
        audit.low = audit.nominal - audit.radius + audit.thermal * temperature_low + audit.gauge_a * a_low + audit.gauge_b * b_low;
        audit.high = audit.nominal + audit.radius + audit.thermal * temperature_high + audit.gauge_a * a_high + audit.gauge_b * b_high;
        transition audit.low >= assembly.fit_low && audit.high <= assembly.fit_high {
            true -> guaranteed(audit)
            false -> overlap(assembly, audit)
        }
    }
    state guaranteed(audit: &mut Audit) { audit.status = 1; }
    state overlap(assembly: &Assembly, audit: &mut Audit) {
        transition audit.high < assembly.fit_low || audit.low > assembly.fit_high {
            true -> impossible(audit)
            false -> conditional(audit)
        }
    }
    state impossible(audit: &mut Audit) { audit.status = 3; }
    state conditional(audit: &mut Audit) { audit.status = 2; }
}
