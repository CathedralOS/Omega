// With EOF, bounded input rejects explicitly.
// Expected exit: 64.
// Expected output contains: INVALID INPUT: expected profile 1..6 and ordered temperatures in [-100,100]
use omega_language_std::console;
use model::audit;
use data::profiles;
use io::numbers;

data Main {
    input: Input;
    assembly: Assembly;
    audit: Audit;
}
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("dimensional_stack_audit: profile 1..6, temperature low, temperature high (one integer per line)");
    block read_integer(&mut main.input);
    transition main.input.valid && main.input.value >= 1 && main.input.value <= 6 {
        true -> profile(main)
        false -> invalid(main)
    }
    state profile(main: &mut Main) {
        load(&mut main.assembly, main.input.value);
        block read_integer(&mut main.input);
        transition main.input.valid { true -> temperature_low(main) false -> invalid(main) }
    }
    state temperature_low(main: &mut Main) {
        main.assembly.temperature_low = main.input.value;
        block read_integer(&mut main.input);
        transition main.input.valid { true -> temperature_high(main) false -> invalid(main) }
    }
    state temperature_high(main: &mut Main) {
        main.assembly.temperature_high = main.input.value;
        let accepted: bool = valid(&main.assembly);
        transition accepted { true -> audit(main) false -> invalid(main) }
    }
    state audit(main: &mut Main) {
        calculate(&main.assembly, &mut main.audit);
        Console::write_line("fit_low_um");
        write_integer(main.audit.low);
        Console::write_line("fit_high_um");
        write_integer(main.audit.high);
        transition main.audit.status {
            1 -> guaranteed(main)
            3 -> impossible(main)
            _ -> conditional(main)
        }
    }
    state guaranteed(main: &mut Main) {
        Console::write_line("GUARANTEED");
        transition { _ -> contributors(main, 0) }
    }
    state impossible(main: &mut Main) {
        Console::write_line("IMPOSSIBLE");
        transition { _ -> contributors(main, 0) }
    }
    state conditional(main: &mut Main) {
        Console::write_line("CONDITIONAL");
        transition { _ -> contributors(main, 0) }
    }
    state contributors(main: &mut Main, index: u32) {
        transition index < 3 { true -> lower(main, index) false -> done(main) }
    }
    state lower(main: &mut Main, index: u32) requires index < 3 {
        let value: Contributor = main.assembly.contributors[index];
        let temperature: i32 in Saturating = lower_choice(main.audit.thermal, main.assembly.temperature_low, main.assembly.temperature_high);
        let gauge_a: i32 in Saturating = lower_choice(main.audit.gauge_a, main.assembly.gauge_a_low, main.assembly.gauge_a_high);
        let gauge_b: i32 in Saturating = lower_choice(main.audit.gauge_b, main.assembly.gauge_b_low, main.assembly.gauge_b_high);
        let deviation: i32 in Saturating = 0 - value.tolerance + value.thermal * temperature + value.gauge_a * gauge_a + value.gauge_b * gauge_b;
        transition main.audit.low < main.assembly.fit_low && deviation < 0 {
            true -> lower_offender(main, index, deviation)
            false -> upper(main, index)
        }
    }
    state lower_offender(main: &mut Main, index: u32, deviation: i32 in Saturating) requires index < 3 {
        Console::write_line("lower_offender_index_zero_based");
        write_integer(index as i32 in Saturating);
        Console::write_line("deviation_um");
        write_integer(deviation);
        transition { _ -> upper(main, index) }
    }
    state upper(main: &mut Main, index: u32) requires index < 3 {
        let value: Contributor = main.assembly.contributors[index];
        let temperature: i32 in Saturating = upper_choice(main.audit.thermal, main.assembly.temperature_low, main.assembly.temperature_high);
        let gauge_a: i32 in Saturating = upper_choice(main.audit.gauge_a, main.assembly.gauge_a_low, main.assembly.gauge_a_high);
        let gauge_b: i32 in Saturating = upper_choice(main.audit.gauge_b, main.assembly.gauge_b_low, main.assembly.gauge_b_high);
        let deviation: i32 in Saturating = value.tolerance + value.thermal * temperature + value.gauge_a * gauge_a + value.gauge_b * gauge_b;
        transition main.audit.high > main.assembly.fit_high && deviation > 0 {
            true -> upper_offender(main, index, deviation)
            false -> contributors(main, index + 1)
        }
    }
    state upper_offender(main: &mut Main, index: u32, deviation: i32 in Saturating) requires index < 3 {
        Console::write_line("upper_offender_index_zero_based");
        write_integer(index as i32 in Saturating);
        Console::write_line("deviation_um");
        write_integer(deviation);
        transition { _ -> contributors(main, index + 1) }
    }
    state done(main: &mut Main) { Console::exit_process(0); }
    state invalid(main: &mut Main) {
        Console::write_line("INVALID INPUT: expected profile 1..6 and ordered temperatures in [-100,100]");
        Console::exit_process(64);
    }
}
