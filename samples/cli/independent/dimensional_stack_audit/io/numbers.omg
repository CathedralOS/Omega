use omega_language_std::console;
pub data Input [copy] { value: i32 in Saturating; valid: bool; }
// One signed decimal token terminated by LF or EOF, at most five digits.
// Whitespace, CR, empty lines, embedded signs and overflow-shaped tokens reject.
pub machine read_integer(input: &mut Input) reaches Console
invokes Console;
blocks;
crashes Trap
{
    input.value = 0;
    input.valid = false;
    transition { _ -> scan(input, 0, false, false) }
    state scan(input: &mut Input, digits: u32, negative: bool, started: bool) {
        let byte: ByteRead = block Console::read_byte();
        transition byte {
            ByteRead::Eof -> finish(input, digits, negative)
            ByteRead::Byte { value } -> classify(input, digits, negative, started, value)
        }
    }
    state classify(input: &mut Input, digits: u32, negative: bool, started: bool, byte: i32) {
        transition byte == 10 {
            true -> finish(input, digits, negative)
            false -> sign(input, digits, negative, started, byte)
        }
    }
    state sign(input: &mut Input, digits: u32, negative: bool, started: bool, byte: i32) {
        transition byte == 45 && started == false {
            true -> scan(input, digits, true, true)
            false -> digit(input, digits, negative, byte)
        }
    }
    state digit(input: &mut Input, digits: u32, negative: bool, byte: i32) {
        transition byte >= 48 && byte <= 57 && digits < 5 {
            true -> append(input, digits, negative, byte)
            false -> done()
        }
    }
    state append(input: &mut Input, digits: u32, negative: bool, byte: i32)
    requires digits < 5 {
        input.value = input.value * 10 + (byte as i32 in Saturating) - 48;
        transition { _ -> scan(input, digits + 1, negative, true) }
    }
    state finish(input: &mut Input, digits: u32, negative: bool) {
        transition digits > 0 { true -> signed(input, negative) false -> done() }
    }
    state signed(input: &mut Input, negative: bool) {
        input.valid = true;
        transition negative { true -> negate(input) false -> done() }
    }
    state negate(input: &mut Input) { input.value = 0 - input.value; }
    state done() { }
}
// Decimal rendering uses byte output, avoiding any invented UTF-8 obligations.
pub machine write_integer(value: i32 in Saturating) reaches Console
invokes Console;
{
    transition value == -2147483648 {
        true -> minimum()
        false -> sign(value)
    }
    state minimum() { Console::write_line("-2147483648"); }
    state sign(value: i32 in Saturating) {
        transition value < 0 { true -> negative(value) false -> positive(value) }
    }
    state negative(value: i32 in Saturating) {
        Console::write_byte(45);
        transition { _ -> positive(0 - value) }
    }
    state positive(value: i32 in Saturating) {
        transition { _ -> digit(value, 1000000000, false) }
    }
    state digit(value: i32 in Saturating, divisor: i32 in Saturating, started: bool)
    requires divisor > 0 {
        let character: i32 in Saturating = value / divisor;
        transition character > 0 || started || divisor == 1 {
            true -> emit(value, divisor, character)
            false -> next(value, divisor, false)
        }
    }
    state emit(value: i32 in Saturating, divisor: i32 in Saturating, character: i32 in Saturating)
    requires divisor > 0 {
        Console::write_byte((character + 48) as i32);
        transition { _ -> next(value % divisor, divisor, true) }
    }
    state next(value: i32 in Saturating, divisor: i32 in Saturating, started: bool) {
        transition divisor >= 10 { true -> digit(value, divisor / 10, started) false -> newline() }
    }
    state newline() { Console::write_byte(10); }
}
