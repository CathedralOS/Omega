// Expected exit: 0 with input.txt (one byte 0). Empty stdin exits 64.
// Expected output contains: CONVERGED
// A transition dispatch covers its subject. The converged residual takes the
// true arm; the false arm continues to the iteration limit. The next statement
// is not a fallback.
// SCI04: bounded 2D finite-volume diffusion/Poisson with explicit CSR and CG.
use omega_language_std::console;
use omega::language::core::float_operations;
use domain::grid;
use domain::solver;
use platform::decimal;

machine field(value:f64) reaches Console invokes Console; {
 let scaled:f64=value*1000000000000.0;
 transition scaled == scaled && scaled >= -900000000000000000.0 && scaled <= 900000000000000000.0 {
  true -> emit(scaled) false -> failure()
 }
 state emit(scaled:f64) requires scaled == scaled && scaled >= -900000000000000000.0 && scaled <= 900000000000000000.0 {
  let integer:i64=I64::from_f64(scaled);
  number(integer as i64 in Wrapping);
 }
 state failure() { Console::write_line("REJECT numeric output"); Console::exit_process(70); }
}
machine count(value:u64 in Saturating) reaches Console invokes Console; {
 transition value <= 1000 { true -> bounded(value) false -> failure() }
 state bounded(value:u64 in Saturating) requires value <= 1000 { number(value as i64 in Wrapping); }
 state failure() { Console::write_line("REJECT report count"); Console::exit_process(70); }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console invokes Console; {
 let request:ByteRead=block Console::read_byte();
 transition request { ByteRead::Byte { value } -> ending(value) _ -> input_error() }
 state ending(value:i32) {
  let tail:ByteRead=block Console::read_byte();
  transition tail { ByteRead::Eof -> setup(value) _ -> input_error() }
 }
 state setup(value:i32) {
  let zero:f64=0.0;
  let one:f64=1.0;
  let mut grid:domain::grid::Grid;
  grid.n=4;
  grid.diffusion=1.0;
  grid.reaction=0.0;
  grid.linear=false;
  grid.kind[0]=0; grid.kind[1]=0; grid.kind[2]=0; grid.kind[3]=0;
  grid.boundary_count=4;
  grid.maximum=400;
  grid.tolerance=0.0000000001;
  transition value {
   48 -> check(&mut grid)
   49 -> eight(&mut grid)
   50 -> twelve(&mut grid)
   51 -> mixed(&mut grid)
   52 -> reaction(&mut grid)
   53 -> coefficient(&mut grid,0.0)
   54 -> coefficient(&mut grid,-1.0)
   55 -> malformed(&mut grid)
   56 -> singular(&mut grid)
   57 -> limited(&mut grid,1)
   97 -> limited(&mut grid,0)
   98 -> negative_reaction(&mut grid)
   99 -> missing(&mut grid)
   100 -> coefficient(&mut grid,zero/zero)
   101 -> coefficient(&mut grid,one/zero)
   102 -> bad_tolerance(&mut grid)
   _ -> input_error()
  }
 }
 state eight(grid:&mut domain::grid::Grid) { grid.n=8; transition { _ -> check(grid) } }
 state twelve(grid:&mut domain::grid::Grid) { grid.n=12; transition { _ -> check(grid) } }
 state mixed(grid:&mut domain::grid::Grid) { grid.n=8; grid.linear=true; grid.kind[1]=1; grid.kind[2]=1; grid.kind[3]=1; transition { _ -> check(grid) } }
 state reaction(grid:&mut domain::grid::Grid) { grid.n=8; grid.diffusion=2.0; grid.reaction=3.0; transition { _ -> check(grid) } }
 state coefficient(grid:&mut domain::grid::Grid,value:f64) { grid.diffusion=value; transition { _ -> check(grid) } }
 state malformed(grid:&mut domain::grid::Grid) { grid.kind[2]=9; transition { _ -> check(grid) } }
 state singular(grid:&mut domain::grid::Grid) { grid.kind[0]=1; grid.kind[1]=1; grid.kind[2]=1; grid.kind[3]=1; transition { _ -> check(grid) } }
 state limited(grid:&mut domain::grid::Grid,maximum:u64 in Saturating) { grid.maximum=maximum; transition { _ -> check(grid) } }
 state negative_reaction(grid:&mut domain::grid::Grid) { grid.reaction=-1.0; transition { _ -> check(grid) } }
 state missing(grid:&mut domain::grid::Grid) { grid.boundary_count=3; transition { _ -> check(grid) } }
 state bad_tolerance(grid:&mut domain::grid::Grid) { grid.tolerance=0.0; transition { _ -> check(grid) } }
 state check(grid:&mut domain::grid::Grid) {
  transition domain::grid::valid(grid) { true -> execute(grid) false -> invalid() }
 }
 state execute(grid:&mut domain::grid::Grid) {
  let status:i32=domain::solver::solve(grid);
  Console::write("GRID "); count(grid.n); count(grid.count); count(grid.nonzeros); Console::write_line("");
  Console::write("CG "); number(status as i64 in Wrapping); count(grid.iterations); field(grid.norm); field(grid.threshold); field(grid.error); Console::write_line("");
  transition { _ -> report(grid,status,0) }
 }
 state report(grid:&domain::grid::Grid,status:i32,index:u64 in Saturating) {
  transition index < grid.count { true -> cell(grid,status,index) false -> finish(status) }
 }
 state cell(grid:&domain::grid::Grid,status:i32,index:u64 in Saturating) {
  Console::write("CELL "); count(index); field(grid.solution[index%144]); Console::write_line("");
  transition { _ -> report(grid,status,index+1) }
 }
 state finish(status:i32) { transition status { 0 -> success() _ -> nonconvergence() } }
 state success() { Console::write_line("CONVERGED"); Console::exit_process(0); }
 state nonconvergence() { Console::write_line("NOT_CONVERGED"); Console::exit_process(2); }
 state invalid() { Console::write_line("REJECT grid: positive finite diffusion, nonnegative reaction, four valid anchored boundaries, bounded mesh and controls required"); Console::exit_process(65); }
 state input_error() { Console::write_line("REJECT input: expected exactly one byte 0..9 or a..f"); Console::exit_process(64); }
}
