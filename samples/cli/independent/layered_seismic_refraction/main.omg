// Expected exit: 0 with bounded input.txt; complete numerical oracle in validation/.
use omega_language_std::console;
use io::protocol;
use domain::model;
use omega::language::core::float_operations;
data Main {
 protocol: Protocol; model: Model; best_time: f64; best_branch: i32 in Wrapping;
}
machine Main::main(main: &mut Main) reaches Console {
 let valid: bool = block Protocol::read(&mut main.protocol);
 transition valid && main.protocol.position >= 2 { true -> header(main) false -> syntax(main) }
 state header(main: &mut Main) {
  let layers: f64 = main.protocol.fields[0]; let offsets: f64 = main.protocol.fields[1];
  transition layers >= 1.0 && layers <= 4.0 && offsets >= 0.0 && offsets <= 16.0 {
   true -> counts(main, layers, offsets) false -> range(main)
  }
 }
 state counts(main: &mut Main, layers: f64, offsets: f64)
 requires layers >= 1.0 && layers <= 4.0
 requires offsets >= 0.0 && offsets <= 16.0 {
  main.model.layers = I32::from_f64(layers) as i32 in Wrapping;
  main.model.offsets = I32::from_f64(offsets) as i32 in Wrapping;
  let layer_value: f64 = main.model.layers as f64; let offset_value: f64 = main.model.offsets as f64;
  transition layers == layer_value && offsets == offset_value && main.protocol.position == 1 + 2 * main.model.layers + main.model.offsets {
   true -> velocity(main, 0, 0.0) false -> syntax(main)
  }
 }
 state velocity(main: &mut Main, index: i32 in Wrapping, previous: f64) {
  transition index >= 0 && index < main.model.layers && index < 4 {
   true -> velocity_record(main, index, previous) false -> thickness(main, 0)
  }
 }
 state velocity_record(main: &mut Main, index: i32 in Wrapping, previous: f64)
 requires index >= 0 && index < 4 {
  let value: f64 = main.protocol.fields[2 + index];
  transition value >= 0.000001 && value <= 1000000.0 && value > previous {
   true -> store_velocity(main, index, value) false -> range(main)
  }
 }
 state store_velocity(main: &mut Main, index: i32 in Wrapping, value: f64)
 requires index >= 0 && index < 4 {
  main.model.velocities[index] = value;
  main.model.numerators[index] = main.protocol.numerators[2 + index];
  main.model.scales[index] = main.protocol.scales[2 + index];
  transition { _ -> velocity(main, index + 1, value) }
 }
 state thickness(main: &mut Main, index: i32 in Wrapping) {
  let position: i32 in Wrapping = 2 + main.model.layers + index;
  transition index >= 0 && index < main.model.layers - 1 && index < 3 && position >= 0 && position < 25 {
   true -> thickness_record(main, index, position) false -> prepare(main, 1)
  }
 }
 state thickness_record(main: &mut Main, index: i32 in Wrapping, position: i32 in Wrapping)
 requires index >= 0 && index < 3
 requires position >= 0 && position < 25 {
  let value: f64 = main.protocol.fields[position];
  transition value >= 0.000001 && value <= 1000000.0 {
   true -> store_thickness(main, index, value) false -> range(main)
  }
 }
 state store_thickness(main: &mut Main, index: i32 in Wrapping, value: f64)
 requires index >= 0 && index < 3 {
  main.model.thicknesses[index] = value;
  transition { _ -> thickness(main, index + 1) }
 }
 state prepare(main: &mut Main, refractor: i32 in Wrapping) {
  transition refractor >= 1 && refractor < main.model.layers && refractor < 4 {
   true -> compute_branch(main, refractor) false -> offset(main, 0)
  }
 }
 state compute_branch(main: &mut Main, refractor: i32 in Wrapping)
 requires refractor >= 1 && refractor < 4 {
  branch(&mut main.model, refractor);
  Console::write("B "); Protocol::integer(&mut main.protocol, refractor);
  Console::write(" "); Protocol::number(&mut main.protocol, main.model.critical[refractor]);
  Console::write(" "); Protocol::number(&mut main.protocol, main.model.intercept[refractor]);
  Console::write_line("");
  transition { _ -> prepare(main, refractor + 1) }
 }
 state offset(main: &mut Main, index: i32 in Wrapping) {
  let position: i32 in Wrapping = 1 + 2 * main.model.layers + index;
  transition index >= 0 && index < main.model.offsets && index < 16 && position >= 0 && position < 25 {
   true -> offset_record(main, index, position) false -> success(main)
  }
 }
 state offset_record(main: &mut Main, index: i32 in Wrapping, position: i32 in Wrapping)
 requires position >= 0 && position < 25 {
  let distance: f64 = main.protocol.fields[position];
  transition distance >= 0.0 && distance <= 1000000.0 {
   true -> direct(main, index, distance) false -> range(main)
  }
 }
 state direct(main: &mut Main, index: i32 in Wrapping, distance: f64) {
  let offset: f64 in SurfaceOffset = distance as f64 in SurfaceOffset;
  let speed: f64 in Velocity = main.model.velocities[0] as f64 in Velocity;
  let duration: f64 in TravelTime = direct_time(offset, speed);
  main.best_time = duration as f64; main.best_branch = 0;
  let time: f64 = main.best_time;
  emit(main, "R ", index, 0, distance, time);
  transition { _ -> head(main, index, distance, 1) }
 }
 state head(main: &mut Main, index: i32 in Wrapping, distance: f64, refractor: i32 in Wrapping) {
  transition refractor >= 1 && refractor < main.model.layers && refractor < 4 {
   true -> admissible(main, index, distance, refractor) false -> first(main, index, distance)
  }
 }
 state admissible(main: &mut Main, index: i32 in Wrapping, distance: f64, refractor: i32 in Wrapping)
 requires refractor >= 1 && refractor < 4 {
  transition distance >= main.model.critical[refractor] {
   true -> arrival(main, index, distance, refractor) false -> head(main, index, distance, refractor + 1)
  }
 }
 state arrival(main: &mut Main, index: i32 in Wrapping, distance: f64, refractor: i32 in Wrapping)
 requires refractor >= 1 && refractor < 4 {
  let time: f64 = main.model.intercept[refractor] + distance / main.model.velocities[refractor];
  emit(main, "R ", index, refractor, distance, time);
  // Ascending branches keep the lowest ID on numerical equality. Tolerance
  // absorbs roundoff at analytic crossovers without changing reported times.
  let tolerance: f64 = 0.000000000000004 * main.best_time;
  transition time < main.best_time - tolerance {
   true -> improve(main, index, distance, refractor, time) false -> head(main, index, distance, refractor + 1)
  }
 }
 state improve(main: &mut Main, index: i32 in Wrapping, distance: f64, refractor: i32 in Wrapping, time: f64) {
  main.best_time = time; main.best_branch = refractor;
  transition { _ -> head(main, index, distance, refractor + 1) }
 }
 state first(main: &mut Main, index: i32 in Wrapping, distance: f64) {
  let identifier: i32 in Wrapping = main.best_branch; let time: f64 = main.best_time;
  emit(main, "F ", index, identifier, distance, time);
  transition { _ -> offset(main, index + 1) }
 }
 state success(main: &mut Main) { Console::exit_process(0); }
 state syntax(main: &mut Main) { Console::write_line("ERROR syntax"); Console::exit_process(64); }
 state range(main: &mut Main) { Console::write_line("ERROR range"); Console::exit_process(65); }
}
machine emit(main: &mut Main, prefix: &[u8], index: i32 in Wrapping, identifier: i32 in Wrapping, distance: f64, time: f64) reaches Console {
 Console::write(prefix); Protocol::integer(&mut main.protocol, index);
 Console::write(" "); Protocol::integer(&mut main.protocol, identifier);
 Console::write(" "); Protocol::number(&mut main.protocol, distance);
 Console::write(" "); Protocol::number(&mut main.protocol, time);
 Console::write_line("");
}
