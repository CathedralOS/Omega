use omega::language::core::float_operations;
domain f64::SurfaceOffset;
domain f64::Velocity;
domain f64::TravelTime;

// Result context distinguishes a distance observation from its travel time.
// Arithmetic explicitly erases physical domains before establishing the result.
machine flight(offset: f64 in SurfaceOffset, velocity: f64 in Velocity) -> f64 {
 offset as f64
}
machine flight(offset: f64 in SurfaceOffset, velocity: f64 in Velocity) -> f64 in TravelTime {
 let distance: f64 = offset as f64;
 let speed: f64 = velocity as f64;
 let duration: f64 = distance / speed;
 duration as f64 in TravelTime
}
machine direct_time(offset: f64 in SurfaceOffset, velocity: f64 in Velocity) -> f64 in TravelTime {
 flight(offset, velocity)
}
data Model {
 velocities: [f64; 4]; numerators: [f64; 4]; scales: [f64; 4]; thicknesses: [f64; 3]; critical: [f64; 4]; intercept: [f64; 4];
 layers: i32 in Wrapping; offsets: i32 in Wrapping;
}
// Newton's positive square root; the iteration bound is independent of input.
machine square_root(value: f64) -> f64 {
 transition { _ -> iterate(value, 1.0, 0) }
 machine iterate(value: f64, estimate: f64, count: i32 in Wrapping) -> f64 {
  let next: f64 = 0.5 * (estimate + value / estimate);
  transition count < 63 { true -> iterate(value, next, count + 1) false -> done(next) }
 }
 machine done(value: f64) -> f64 { value }
}
// Snell's horizontal slowness is 1 / refractor velocity. The critical
// offset includes both inclined legs; the half-space leg is nonnegative.
machine branch(model: &mut Model, refractor: i32 in Wrapping)
requires refractor >= 1 && refractor < 4 {
 model.critical[refractor] = 0.0; model.intercept[refractor] = 0.0;
 transition { _ -> layer(model, refractor, 0) }
 machine layer(model: &mut Model, refractor: i32 in Wrapping, index: i32 in Wrapping)
 requires refractor >= 1 && refractor < 4 {
  transition index >= 0 && index < refractor && index < 3 {
   true -> accumulate(model, refractor, index) false -> done()
  }
 }
 machine accumulate(model: &mut Model, refractor: i32 in Wrapping, index: i32 in Wrapping)
 requires refractor >= 1 && refractor < 4
 requires index >= 0 && index < 3 {
  let ratio: f64 = model.velocities[index] / model.velocities[refractor];
  // Decimal numerators retain small velocity gaps before binary64 division.
  // Near-equal bounded tokens align within 12 exact integer digits. For
  // widely separated velocities any rounding is small relative to the gap.
  let gap: f64 = velocity_gap(model.numerators[index], model.scales[index], model.numerators[refractor], model.scales[refractor]);
  let cosine: f64 = square_root((gap / model.velocities[refractor]) * (1.0 + ratio));
  let depth: f64 = 2.0 * model.thicknesses[index];
  model.critical[refractor] = model.critical[refractor] + depth * ratio / cosine;
  model.intercept[refractor] = model.intercept[refractor] + depth * cosine / model.velocities[index];
  transition { _ -> layer(model, refractor, index + 1) }
 }
 machine done() { }
}

machine velocity_gap(lower: f64, lower_scale: f64, upper: f64, upper_scale: f64) -> f64 {
 transition lower_scale >= upper_scale {
  true -> align_lower(lower, lower_scale, upper, upper_scale)
  false -> align_upper(lower, lower_scale, upper, upper_scale)
 }
 machine align_lower(lower: f64, lower_scale: f64, upper: f64, upper_scale: f64) -> f64 {
  let aligned: f64 = upper * (lower_scale / upper_scale);
  (aligned - lower) / lower_scale
 }
 machine align_upper(lower: f64, lower_scale: f64, upper: f64, upper_scale: f64) -> f64 {
  let aligned: f64 = lower * (upper_scale / lower_scale);
  (upper - aligned) / upper_scale
 }
}
