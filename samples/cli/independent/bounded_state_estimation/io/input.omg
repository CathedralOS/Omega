use omega::language::core::float_operations;
// Input is deliberately small and exact: C d q r\n then P +/-n\n, V +/-n\n
// or M\n. Single digit fields bound resources and reject ambiguous parsing.
machine digit(value: u8) -> bool {
    transition { _ -> (value >= 48 && value <= 57) }
}
machine configuration(line: &[u8; 16], count: u64) -> bool {
    transition { _ -> (count == 8 && line[0] == 67 && line[1] == 32
        && line[2] >= 49 && line[2] <= 51 && line[3] == 32
        && line[4] >= 48 && line[4] <= 51 && line[5] == 32
        && line[6] >= 48 && line[6] <= 51 && line[7] == 10) }
}
machine reading(line: &[u8; 16], count: u64) -> bool {
    transition { _ -> (count == 5 && (line[0] == 80 || line[0] == 86)
        && line[1] == 32 && (line[2] == 43 || line[2] == 45)
        && digit(line[3]) && line[4] == 10) }
}
machine unsigned_value(value: u8) -> f64 {
    transition { _ -> (F64FromI32::from_i32((value as i32) - 48)) }
}
machine measured_value(line: &[u8; 16]) -> f64 {
    let magnitude: f64 = unsigned_value(line[3]);
    transition line[2] == 45 { true -> (-magnitude) false -> magnitude }
}
