use omega_language_std::console;
use omega::language::core::float_operations;
use domain::filter;
// Decimal integer fields represent millionths, truncated toward zero. The
// external oracle allows 2e-6 output quantization, independently of f64 checks.
// Scan at most nineteen decimal places with state transfers. Only the final
// remainder is negated, so even the minimum i64 value needs no magnitude cast.
machine print_integer(value: i64) reaches Console {
    transition value < 0 {
        true -> negative(value)
        false -> scan(value, 1000000000000000000, false)
    }
    state negative(value: i64) {
        Console::write("-");
        transition { _ -> scan(value, 1000000000000000000, false) }
    }
    state scan(value: i64, divisor: i64, started: bool)
    requires divisor >= 1 requires divisor <= 1000000000000000000 {
        let remainder: i64 = (value / divisor) % 10;
        transition remainder != 0 || started || divisor == 1 {
            true -> digit(value, divisor, remainder)
            false -> advance(value, divisor, false)
        }
    }
    state digit(value: i64, divisor: i64, remainder: i64)
    requires divisor >= 1 requires divisor <= 1000000000000000000
    requires remainder >= -9 requires remainder <= 9 {
        transition remainder < 0 {
            true -> signed_digit(value, divisor, remainder)
            false -> unsigned_digit(value, divisor, remainder)
        }
    }
    state signed_digit(value: i64, divisor: i64, remainder: i64)
    requires divisor >= 1 requires divisor <= 1000000000000000000
    requires remainder >= -9 requires remainder < 0 {
        Console::write_byte((48 - remainder) as i32);
        transition { _ -> advance(value, divisor, true) }
    }
    state unsigned_digit(value: i64, divisor: i64, remainder: i64)
    requires divisor >= 1 requires divisor <= 1000000000000000000
    requires remainder >= 0 requires remainder <= 9 {
        Console::write_byte((48 + remainder) as i32);
        transition { _ -> advance(value, divisor, true) }
    }
    state advance(value: i64, divisor: i64, started: bool)
    requires divisor >= 1 requires divisor <= 1000000000000000000 {
        transition divisor >= 10 {
            true -> scan(value, divisor / 10, started)
            false -> finished()
        }
    }
    state finished() { }
}
machine print_number(value: f64) reaches Console {
    let integer: i64 in Saturating = I64::from_f64(value * 1000000.0);
    Console::write(" ");
    print_integer(integer as i64);
}
machine emit(filter: &Filter, step: u64) reaches Console requires step <= 8 {
    Console::write("TRACE ");
    print_integer(step as i64);
    print_number(filter.estimate.position);
    print_number(filter.estimate.velocity);
    print_number(filter.covariance.a);
    print_number(filter.covariance.b);
    print_number(filter.covariance.c);
    print_number(filter.covariance.d);
    print_number(filter.innovation);
    print_number(filter.innovation_variance);
    transition filter.updated {
        true -> observed()
        false -> missing()
    }
    state observed() { Console::write_line(" update"); }
    state missing() { Console::write_line(" missing"); }
}
