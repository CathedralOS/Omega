// Expected exit: 64 (empty stdin is a missing configuration).
// A complete stream application; fixtures/validate.py supplies valid trajectories.
use omega_language_std::console;
use omega::language::core::float_operations;
use domain::matrix;
use domain::filter;
use io::input;
use io::trace;
data Main { filter: Filter; line: [u8; 16]; }
machine Main::main(main: &mut Main) reaches Console {
    let result: LineReadResult = block Console::read_line(&mut main.line);
    transition result {
        LineReadResult::LineComplete { count } -> header(main, count)
        _ -> bad_input(main)
    }
    state header(main: &mut Main, count: u64) {
        transition configuration(&main.line, count) {
            true -> configure(main)
            false -> bad_input(main)
        }
    }
    state configure(main: &mut Main) {
        initialize(&mut main.filter, unsigned_value(main.line[2]), unsigned_value(main.line[4]), unsigned_value(main.line[6]));
        Console::write_line("IND06 millionths: step position velocity p00 p01 p10 p11 innovation variance policy");
        transition { _ -> read(main, 0) }
    }
    state read(main: &mut Main, step: u64) requires step <= 8 {
        let result: LineReadResult = block Console::read_line(&mut main.line);
        transition result {
            LineReadResult::LineComplete { count } -> capacity(main, step, count)
            LineReadResult::EndOfInput { count } -> end(main, step, count)
            _ -> bad_input(main)
        }
    }
    state end(main: &mut Main, step: u64, count: u64) {
        transition count == 0 && step > 0 {
            true -> success(main)
            false -> bad_input(main)
        }
    }
    state capacity(main: &mut Main, step: u64, count: u64) requires step <= 8 {
        transition step < 8 {
            true -> row(main, step + 1, count)
            false -> limit(main)
        }
    }
    state row(main: &mut Main, step: u64, count: u64) requires step <= 8 {
        transition count == 2 && main.line[0] == 77 && main.line[1] == 10 {
            true -> missing(main, step)
            false -> measurement(main, step, count)
        }
    }
    state measurement(main: &mut Main, step: u64, count: u64) requires step <= 8 {
        transition reading(&main.line, count) {
            true -> numeric(main, step)
            false -> bad_input(main)
        }
    }
    state numeric(main: &mut Main, step: u64) requires step <= 8 {
        predict(&mut main.filter);
        let accepted: bool = observe(&mut main.filter, measured_value(&main.line), main.line[0] == 80);
        transition accepted { true -> checked(main, step) false -> singular(main, step) }
    }
    state missing(main: &mut Main, step: u64) requires step <= 8 {
        predict(&mut main.filter);
        transition { _ -> checked(main, step) }
    }
    state checked(main: &mut Main, step: u64) requires step <= 8 {
        transition covariance_valid(main.filter.covariance)
            && F64::is_finite(main.filter.estimate.position) && F64::is_finite(main.filter.estimate.velocity) {
            true -> output(main, step)
            false -> invariant(main)
        }
    }
    state output(main: &mut Main, step: u64) requires step <= 8 {
        emit(&main.filter, step);
        transition { _ -> read(main, step) }
    }
    state singular(main: &mut Main, step: u64) requires step <= 8 {
        emit(&main.filter, step);
        Console::write_line("ERROR singular innovation covariance");
        Console::exit_process(65);
    }
    state bad_input(main: &mut Main) {
        Console::write_line("ERROR input: expected C [1..3] [0..3] [0..3], then P/V signed digit or M; LF required");
        Console::exit_process(64);
    }
    state limit(main: &mut Main) {
        Console::write_line("ERROR capacity: at most eight observations");
        Console::exit_process(66);
    }
    state invariant(main: &mut Main) {
        Console::write_line("ERROR covariance or estimate invariant");
        Console::exit_process(67);
    }
    state success(main: &mut Main) {
        Console::write_line("DONE covariance symmetric and positive semidefinite");
        Console::exit_process(0);
    }
}
