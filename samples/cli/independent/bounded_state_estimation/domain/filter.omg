// Constant-velocity prediction followed by a scalar observation. Joseph form
// keeps roundoff from subtracting nearly equal covariance matrices. No library
// numerics or external worker implementation participates in these operations.
use domain::matrix;
use omega::language::core::float_operations;
data Filter {
    estimate: Vector;
    covariance: Matrix;
    interval: f64;
    process_noise: f64;
    observation_noise: f64;
    innovation: f64;
    innovation_variance: f64;
    updated: bool;
}
machine initialize(filter: &mut Filter, interval: f64, process_noise: f64, observation_noise: f64) {
    filter.estimate = Vector { position: 0.0, velocity: 1.0 };
    filter.covariance = Matrix { a: 1.0, b: 0.0, c: 0.0, d: 1.0 };
    filter.interval = interval;
    filter.process_noise = process_noise;
    filter.observation_noise = observation_noise;
}
machine predict(filter: &mut Filter) {
    let dynamics: Matrix = Matrix { a: 1.0, b: filter.interval, c: 0.0, d: 1.0 };
    let noise: Matrix = Matrix { a: filter.process_noise, b: 0.0, c: 0.0, d: filter.process_noise };
    filter.estimate = apply(dynamics, filter.estimate);
    filter.covariance = add(multiply(multiply(dynamics, filter.covariance), transpose(dynamics)), noise);
    filter.innovation = 0.0;
    filter.innovation_variance = 0.0;
    filter.updated = false;
}
// A false result is a singular innovation covariance; the predicted estimate
// remains available and no division or measurement mutation has occurred.
machine observe(filter: &mut Filter, measurement: f64, position_axis: bool) -> bool {
    transition position_axis {
        true -> update(filter, measurement, Vector { position: 1.0, velocity: 0.0 })
        false -> update(filter, measurement, Vector { position: 0.0, velocity: 1.0 })
    }
    machine update(filter: &mut Filter, measurement: f64, axis: Vector) -> bool {
        let projection: Vector = apply(filter.covariance, axis);
        filter.innovation = measurement - axis.position * filter.estimate.position - axis.velocity * filter.estimate.velocity;
        filter.innovation_variance = axis.position * projection.position + axis.velocity * projection.velocity + filter.observation_noise;
        transition filter.innovation_variance > 0.000000000001 {
            true -> accepted(filter, axis, projection)
            false -> false
        }
    }
    machine accepted(filter: &mut Filter, axis: Vector, projection: Vector) -> bool {
        let gain: Vector = Vector { position: projection.position / filter.innovation_variance,
            velocity: projection.velocity / filter.innovation_variance };
        let residual: Matrix = Matrix { a: 1.0 - gain.position * axis.position,
            b: -gain.position * axis.velocity, c: -gain.velocity * axis.position,
            d: 1.0 - gain.velocity * axis.velocity };
        let noise: Matrix = Matrix { a: gain.position * gain.position * filter.observation_noise,
            b: gain.position * gain.velocity * filter.observation_noise,
            c: gain.velocity * gain.position * filter.observation_noise,
            d: gain.velocity * gain.velocity * filter.observation_noise };
        filter.estimate.position = filter.estimate.position + gain.position * filter.innovation;
        filter.estimate.velocity = filter.estimate.velocity + gain.velocity * filter.innovation;
        filter.covariance = add(multiply(multiply(residual, filter.covariance), transpose(residual)), noise);
        filter.updated = true;
        transition { _ -> true }
    }
}
