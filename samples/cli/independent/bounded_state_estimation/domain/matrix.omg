// Private fixed-dimensional algebra. Four entries retain both covariance
// off-diagonals: symmetry is checked rather than silently assumed.
use omega::language::core::float_operations;
data Matrix [copy] { a: f64; b: f64; c: f64; d: f64; }
data Vector [copy] { position: f64; velocity: f64; }
machine multiply(left: Matrix, right: Matrix) -> Matrix {
    transition { _ -> Matrix {
        a: left.a * right.a + left.b * right.c,
        b: left.a * right.b + left.b * right.d,
        c: left.c * right.a + left.d * right.c,
        d: left.c * right.b + left.d * right.d
    } }
}
machine transpose(value: Matrix) -> Matrix {
    transition { _ -> Matrix { a: value.a, b: value.c, c: value.b, d: value.d } }
}
machine add(left: Matrix, right: Matrix) -> Matrix {
    transition { _ -> Matrix { a: left.a + right.a, b: left.b + right.b,
        c: left.c + right.c, d: left.d + right.d } }
}
machine apply(value: Matrix, vector: Vector) -> Vector {
    transition { _ -> Vector { position: value.a * vector.position + value.b * vector.velocity,
        velocity: value.c * vector.position + value.d * vector.velocity } }
}
machine covariance_valid(value: Matrix) -> bool {
    let difference: f64 = value.b - value.c;
    let determinant: f64 = value.a * value.d - value.b * value.c;
    transition { _ -> (F64IsFinite::is_finite(value.a) && F64IsFinite::is_finite(value.b)
        && F64IsFinite::is_finite(value.c) && F64IsFinite::is_finite(value.d)
        && difference >= -0.0000000001 && difference <= 0.0000000001
        && value.a >= -0.0000000001 && value.d >= -0.0000000001
        && determinant >= -0.0000000001) }
}
