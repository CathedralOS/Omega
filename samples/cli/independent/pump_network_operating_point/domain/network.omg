// Synthetic model: pump head (a+b*Q-c*Q^2)/d, two parallel
// linear valve branches r1*q1=r2*q2=H-static, q1+q2=Q.
// Validated coefficients keep every intermediate below 2^40. Wrapping is
// explicit carrier policy; accepted inputs never approach a wrapping boundary.
public data Network [copy] {
    a: i64 in Wrapping;
    b: i64 in Wrapping;
    c: i64 in Wrapping;
    d: i64 in Wrapping;
    r1: i64 in Wrapping;
    r2: i64 in Wrapping;
    elevation: i64 in Wrapping;
    maximum: i64 in Wrapping;
    demand: i64 in Wrapping;
}

public machine valid(network: &Network) -> bool {
    network.a >= 0 && network.a <= 64
    && network.b >= -16 && network.b <= 16
    && network.c >= 0 && network.c <= 16
    && network.d >= 1 && network.d <= 16
    && network.r1 >= 1 && network.r1 <= 16
    && network.r2 >= 1 && network.r2 <= 16
    && network.elevation >= 0 && network.elevation <= 64
    && network.maximum >= 1 && network.maximum <= 16
    && network.demand >= 0 && network.demand <= 16
    && !(network.c == 0 && network.a == network.elevation * network.d
        && network.b * (network.r1 + network.r2) == network.d * network.r1 * network.r2)
}

public machine residual(network: &Network, ticks: i64 in Wrapping) -> i64 in Wrapping {
    ((network.a - network.elevation * network.d) * 1048576
        + network.b * ticks * 1024 - network.c * ticks * ticks)
        * (network.r1 + network.r2)
        - network.d * network.r1 * network.r2 * ticks * 1024
}

public machine opposite(left: i64 in Wrapping, right: i64 in Wrapping) -> bool {
    (left < 0 && right > 0) || (left > 0 && right < 0)
}
