use platform::input;
use domain::network;
use domain::solver;
use omega_language_std::console;

// Explicit build entry; EOF is a valid record terminator. No pause prompt.
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut input: Input;
    _ = block read(&mut input);
    transition input.accepted {
        true -> model(input)
        false -> invalid()
    }
    state model(input: Input) {
        let network: Network = Network {
            a: input.values[0], b: input.values[1], c: input.values[2],
            d: input.values[3], r1: input.values[4], r2: input.values[5],
            elevation: input.values[6], maximum: input.values[7], demand: input.values[8]
        };
        transition valid(&network) {
            true -> operating(network)
            false -> invalid()
        }
    }
    state operating(network: Network) {
        let mut solver: Solver;
        solver.network = network;
        solve(&mut solver);
        transition solver.feasible > 0 {
            true -> success()
            false -> infeasible()
        }
    }
    state success() { Console::exit_process(0); }
    state infeasible() { Console::write_line("INFEASIBLE"); Console::exit_process(2); }
    state invalid() { Console::write_line("INVALID_INPUT"); Console::exit_process(64); }
}
