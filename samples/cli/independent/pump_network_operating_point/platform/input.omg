use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

pub data Input {
    values: [i64 in Wrapping; 9];
    index: u64;
    count: u64;
    magnitude: i64 in Wrapping;
    digits: u64;
    negative: bool;
    active: bool;
    digit_seen: bool;
    accepted: bool;
}

// One record, at most 96 consumed bytes and at most nine signed decimal
// tokens of at most four digits. Spaces and LF/EOF delimit; other bytes reject.
pub machine read(console: &Binding<Console>, input: &mut Input)
reaches Console
invokes console;
blocks;
crashes Trap
{
    transition { _ -> next(console, input) }
    state next(console: &Binding<Console>, input: &mut Input) {
        transition input.count < 96 {
            true -> byte(console, input)
            false -> reject(input)
        }
    }
    state byte(console: &Binding<Console>, input: &mut Input) {
        input.count = input.count + 1;
        let observed: ByteRead = block Console::read_byte(console);
        transition observed {
            ByteRead::Eof -> finish(console, input)
            ByteRead::Byte { value } -> classify(console, input, value)
        }
    }
    state classify(console: &Binding<Console>, input: &mut Input, value: i32) {
        transition value {
            10 -> finish(console, input)
            32 -> separate(console, input)
            45 -> sign(console, input)
            _ -> digit(console, input, value)
        }
    }
    state sign(console: &Binding<Console>, input: &mut Input) {
        transition input.active {
            true -> reject(input)
            false -> set_sign(console, input)
        }
    }
    state set_sign(console: &Binding<Console>, input: &mut Input) {
        input.active = true;
        input.negative = true;
        transition { _ -> next(console, input) }
    }
    state digit(console: &Binding<Console>, input: &mut Input, value: i32) {
        transition value >= 48 && value <= 57 && input.digits < 4 {
            true -> accumulate(console, input, value)
            false -> reject(input)
        }
    }
    state accumulate(console: &Binding<Console>, input: &mut Input, value: i32) {
        input.digits = input.digits + 1;
        input.magnitude = input.magnitude * 10 + (value as i64 in Wrapping) - 48;
        input.active = true;
        input.digit_seen = true;
        transition { _ -> next(console, input) }
    }
    state separate(console: &Binding<Console>, input: &mut Input) {
        transition input.active {
            true -> store(console, input, false)
            false -> next(console, input)
        }
    }
    state finish(console: &Binding<Console>, input: &mut Input) {
        transition input.active {
            true -> store(console, input, true)
            false -> complete(input)
        }
    }
    state store(console: &Binding<Console>, input: &mut Input, finished: bool) {
        transition input.index < 9 && input.digit_seen {
            true -> save(console, input, finished)
            false -> reject(input)
        }
    }
    state save(console: &Binding<Console>, input: &mut Input, finished: bool) {
        transition input.negative {
            true -> negative(console, input, finished)
            false -> positive(console, input, finished)
        }
    }
    state negative(console: &Binding<Console>, input: &mut Input, finished: bool) {
        input.values[input.index] = -input.magnitude;
        transition { _ -> advance(console, input, finished) }
    }
    state positive(console: &Binding<Console>, input: &mut Input, finished: bool) {
        input.values[input.index] = input.magnitude;
        transition { _ -> advance(console, input, finished) }
    }
    state advance(console: &Binding<Console>, input: &mut Input, finished: bool) {
        input.index = input.index + 1;
        input.magnitude = 0;
        input.digits = 0;
        input.negative = false;
        input.active = false;
        input.digit_seen = false;
        transition finished {
            true -> complete(input)
            false -> next(console, input)
        }
    }
    state complete(input: &mut Input) { input.accepted = input.index == 9; }
    state reject(input: &mut Input) { input.accepted = false; }
}
