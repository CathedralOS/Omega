use omega_language_std::console;
use omega::language::core::numeric_conversion;
use model::records;
// Decimal output is authored here rather than relying on a numeric library.
pub machine write_number(value: i64 in Saturating) reaches Console
invokes Console;
{
    transition value < 0 {
        true -> negative(value)
        false -> digit(value, 1000000000, false)
    }
    state negative(value: i64 in Saturating) {
        Console::write("-");
        transition { _ -> digit(0 - value, 1000000000, false) }
    }
    state digit(value: i64 in Saturating, place: i64 in Saturating, started: bool)
    requires place > 0 {
        let number: i64 in Saturating = value / place;
        let remaining: i64 in Saturating = value % place;
        transition number > 0 || started || place == 1 {
            true -> emit(remaining, place, number)
            false -> next(remaining, place, started)
        }
    }
    state emit(value: i64 in Saturating, place: i64 in Saturating, number: i64 in Saturating) {
        Console::write_byte(narrow_i64_to_i32_saturating((number + 48) as i64));
        transition { _ -> next(value, place, true) }
    }
    state next(value: i64 in Saturating, place: i64 in Saturating, started: bool) {
        let following: i64 in Saturating = place / 10;
        transition following > 0 {
            true -> digit(value, following, started)
            false -> done()
        }
    }
    state done() {}
}
pub machine write_echo(index: u64 in Saturating, result: EchoResult) reaches Console
invokes Console;
{
    Console::write("echo ");
    write_number(narrow_u64_to_i64_saturating(index as u64) as i64 in Saturating);
    Console::write(" ");
    transition {
        result.matches == 0 -> unmatched()
        result.matches > 1 -> ambiguous(result)
        result.order == 1 -> primary(result)
        _ -> multiple(result)
    }
    state unmatched() { Console::write_line("unmatched"); }
    state ambiguous(result: EchoResult) {
        Console::write("ambiguous paths="); write_number(result.matches); Console::write_line("");
    }
    state primary(result: EchoResult) {
        Console::write("primary layer="); write_number(result.layer);
        Console::write(" thickness_um="); write_number(result.thickness); Console::write_line("");
    }
    state multiple(result: EchoResult) {
        Console::write("multiple layer="); write_number(result.layer);
        Console::write(" order="); write_number(result.order); Console::write_line("");
    }
}
