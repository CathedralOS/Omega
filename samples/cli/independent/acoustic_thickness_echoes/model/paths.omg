// Normal-incidence sample model: each layer contributes floor(2000*d/v)
// nanoseconds. Enumerate primary, double and triple round trips at each
// boundary. A match window is inclusive; overlapping paths retain all matches.
use model::records;
public machine build_boundaries(acquisition: &mut Acquisition) {
    transition { _ -> step(acquisition, 0, 0) }
    machine step(acquisition: &mut Acquisition, layer: u64 in Saturating, cumulative: i64 in Saturating) {
        transition layer < acquisition.layers && layer < 4 {
            true -> store(acquisition, layer, cumulative)
            false -> done()
        }
    }
    machine store(acquisition: &mut Acquisition, layer: u64 in Saturating, cumulative: i64 in Saturating)
    requires layer < 4 {
        let speed: i64 in Saturating = acquisition.speeds[layer];
        transition speed > 0 {
            true -> calculate(acquisition, layer, cumulative, speed)
            false -> done()
        }
    }
    machine calculate(acquisition: &mut Acquisition, layer: u64 in Saturating, cumulative: i64 in Saturating, speed: i64 in Saturating)
    requires layer < 4
    requires speed > 0 {
        let duration: i64 in Saturating = acquisition.thicknesses[layer] * 2000 / speed;
        let next: i64 in Saturating = cumulative + duration;
        acquisition.boundaries[layer] = next;
        transition { _ -> step(acquisition, layer + 1, next) }
    }
    machine done() {}
}
public machine match_echo(acquisition: &Acquisition, arrival: i64 in Saturating) -> EchoResult {
    let result: EchoResult = EchoResult { matches: 0, layer: 0, order: 0, thickness: 0 };
    let relative: i64 in Saturating = arrival - acquisition.reference;
    transition { _ -> boundary(acquisition, relative, 0, 0, result) }
    machine boundary(acquisition: &Acquisition, relative: i64 in Saturating, layer: u64 in Saturating, previous: i64 in Saturating, result: EchoResult) -> EchoResult {
        transition layer < acquisition.layers && layer < 4 {
            true -> path(acquisition, relative, layer, previous, 1, result)
            false -> (result)
        }
    }
    machine path(acquisition: &Acquisition, relative: i64 in Saturating, layer: u64 in Saturating, previous: i64 in Saturating, order: i64 in Saturating, result: EchoResult) -> EchoResult
    requires layer < 4 {
        let predicted: i64 in Saturating = acquisition.boundaries[layer] * order;
        let residual: i64 in Saturating = relative - predicted;
        transition residual >= 0 - acquisition.window && residual <= acquisition.window {
            true -> matched(acquisition, relative, layer, previous, order, result)
            false -> advance(acquisition, relative, layer, previous, order, result)
        }
    }
    machine matched(acquisition: &Acquisition, relative: i64 in Saturating, layer: u64 in Saturating, previous: i64 in Saturating, order: i64 in Saturating, result: EchoResult) -> EchoResult
    requires layer < 4 {
        // A unique primary has nonnegative delta: any arrival before the
        // previous boundary would also match that earlier primary path.
        let estimate: i64 in Saturating = (relative - previous) * acquisition.speeds[layer] / 2000;
        let next: EchoResult = EchoResult { matches: result.matches + 1, layer: (layer as i64 in Saturating) + 1, order: order, thickness: estimate };
        transition { _ -> advance(acquisition, relative, layer, previous, order, next) }
    }
    machine advance(acquisition: &Acquisition, relative: i64 in Saturating, layer: u64 in Saturating, previous: i64 in Saturating, order: i64 in Saturating, result: EchoResult) -> EchoResult
    requires layer < 4 {
        transition order < 3 {
            true -> path(acquisition, relative, layer, previous, order + 1, result)
            false -> boundary(acquisition, relative, layer + 1, acquisition.boundaries[layer], result)
        }
    }
}
