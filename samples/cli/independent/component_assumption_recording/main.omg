// Expected exit: 70
// Admission records belong to Build; execution still needs exact ProcessExit admission.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega::language::core::binding;

data Main { exit: Binding<ProcessExit>; }
machine Main::main(context: &mut Main) reaches ProcessExit {
    ProcessExit::exit_process(&context.exit, 70);
}
