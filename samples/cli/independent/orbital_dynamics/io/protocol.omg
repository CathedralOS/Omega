use omega_language_std::console;
use omega::language::core::float_operations;

data Protocol {
    fields: [f64; 7];
    position: i32 in Wrapping;
    length: i32 in Wrapping;
    accumulator: f64;
    scale: f64;
    fraction: bool;
    fractional_digits: i32 in Wrapping;
    negative: bool;
    digits: bool;
    started: bool;
}
// Fixed decimal notation, bounded to 512 bytes, exactly seven tokens and EOF.
// Accumulator envelope prevents nonfinite values before any model operation.
machine Protocol::read(protocol: &mut Protocol) -> bool reaches Console blocks; crashes Trap {
    protocol.position = 0; protocol.length = 0;
    protocol.accumulator = 0.0; protocol.scale = 1.0;
    protocol.fraction = false; protocol.fractional_digits = 0; protocol.negative = false;
    protocol.digits = false; protocol.started = false;
    transition { _ -> scan(protocol) }
    state scan(protocol: &mut Protocol) -> bool {
        transition protocol.length < 512 { true -> observe(protocol) false -> rejected() }
    }
    state observe(protocol: &mut Protocol) -> bool {
        let observed: ByteRead = block Console::read_byte();
        protocol.length = protocol.length + 1;
        transition observed {
            ByteRead::Eof -> commit(protocol, true)
            ByteRead::Byte { value } -> character(protocol, value)
        }
    }
    state character(protocol: &mut Protocol, value: i32) -> bool {
        transition value >= 48 && value <= 57 { true -> digit(protocol, value) false -> punctuation(protocol, value) }
    }
    state digit(protocol: &mut Protocol, value: i32) -> bool {
        transition protocol.position < 7 && protocol.accumulator < 1000000000000.0 && protocol.fractional_digits < 30 {
            true -> accumulate(protocol, value) false -> rejected()
        }
    }
    state accumulate(protocol: &mut Protocol, value: i32) -> bool {
        protocol.started = true; protocol.digits = true;
        transition protocol.fraction { true -> fraction(protocol, value) false -> integral(protocol, value) }
    }
    state integral(protocol: &mut Protocol, value: i32) -> bool {
        let digit: f64 = (value - 48) as f64;
        protocol.accumulator = protocol.accumulator * 10.0 + digit;
        transition { _ -> scan(protocol) }
    }
    state fraction(protocol: &mut Protocol, value: i32) -> bool {
        let digit: f64 = (value - 48) as f64;
        protocol.fractional_digits = protocol.fractional_digits + 1;
        protocol.scale = protocol.scale * 10.0;
        protocol.accumulator = protocol.accumulator + digit / protocol.scale;
        transition { _ -> scan(protocol) }
    }
    state punctuation(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 45 && !protocol.started && protocol.position < 7 {
            true -> minus(protocol) false -> decimal(protocol, value)
        }
    }
    state minus(protocol: &mut Protocol) -> bool {
        protocol.started = true; protocol.negative = true;
        transition { _ -> scan(protocol) }
    }
    state decimal(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 46 && !protocol.fraction && protocol.position < 7 {
            true -> point(protocol) false -> whitespace(protocol, value)
        }
    }
    state point(protocol: &mut Protocol) -> bool {
        protocol.started = true; protocol.fraction = true;
        transition { _ -> scan(protocol) }
    }
    state whitespace(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> commit(protocol, false) false -> rejected()
        }
    }
    state commit(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.digits { true -> guarded_store(protocol, final) false -> empty(protocol, final) }
    }
    state empty(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.started { true -> rejected() false -> after(protocol, final) }
    }
    state guarded_store(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.position >= 0 && protocol.position < 7 {
            true -> store(protocol, final, protocol.position) false -> rejected()
        }
    }
    state store(protocol: &mut Protocol, final: bool, position: i32 in Wrapping) -> bool
    requires position >= 0 && position < 7 {
        let magnitude: f64 = protocol.accumulator;
        transition protocol.negative { true -> negative(protocol, final, position, magnitude) false -> positive(protocol, final, position, magnitude) }
    }
    state negative(protocol: &mut Protocol, final: bool, position: i32 in Wrapping, value: f64) -> bool
    requires position >= 0 && position < 7 {
        protocol.fields[position] = 0.0 - value;
        transition { _ -> reset(protocol, final) }
    }
    state positive(protocol: &mut Protocol, final: bool, position: i32 in Wrapping, value: f64) -> bool
    requires position >= 0 && position < 7 {
        protocol.fields[position] = value;
        transition { _ -> reset(protocol, final) }
    }
    state reset(protocol: &mut Protocol, final: bool) -> bool {
        protocol.position = protocol.position + 1;
        protocol.accumulator = 0.0; protocol.scale = 1.0;
        protocol.fraction = false; protocol.fractional_digits = 0; protocol.negative = false;
        protocol.digits = false; protocol.started = false;
        transition { _ -> after(protocol, final) }
    }
    state after(protocol: &mut Protocol, final: bool) -> bool {
        transition final { true -> complete(protocol) false -> scan(protocol) }
    }
    state complete(protocol: &mut Protocol) -> bool { protocol.position == 7 }
    state rejected() -> bool { false }
}

machine Protocol::integer(protocol: &mut Protocol, value: i32 in Wrapping)
reaches Console {
    transition value < 0 {
        true -> negative(protocol, value)
        false -> digits(protocol, value, 1000000000, false)
    }
    state negative(protocol: &mut Protocol, value: i32 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> digits(protocol, 0 - value, 1000000000, false) }
    }
    state digits(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let digit: i32 in Wrapping = value / divisor;
        let remainder: i32 in Wrapping = value % divisor;
        transition digit != 0 || started || divisor == 1 {
            true -> emit(protocol, digit, remainder, divisor)
            false -> next(protocol, remainder, divisor, false)
        }
    }
    state emit(protocol: &mut Protocol, digit: i32 in Wrapping,
        remainder: i32 in Wrapping, divisor: i32 in Wrapping)
    requires divisor >= 1
    {
        Console::write_byte((digit + 48) as i32);
        transition { _ -> next(protocol, remainder, divisor, true) }
    }
    state next(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        transition divisor > 1 {
            true -> divide(protocol, value, divisor, started)
            false -> done()
        }
    }
    state divide(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let next_divisor: i32 in Wrapping = divisor / 10;
        transition next_divisor >= 1 {
            true -> digits(protocol, value, next_divisor, started)
            false -> done()
        }
    }
    state done() { }
}

machine Protocol::wide_integer(protocol: &mut Protocol, value: i64 in Wrapping)
reaches Console {
    transition value < 0 {
        true -> negative(protocol, value)
        false -> digits(protocol, value, 1000000000000000000, false)
    }
    state negative(protocol: &mut Protocol, value: i64 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> digits(protocol, 0 - value, 1000000000000000000, false) }
    }
    state digits(protocol: &mut Protocol, value: i64 in Wrapping,
        divisor: i64 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let digit: i64 in Wrapping = value / divisor;
        let remainder: i64 in Wrapping = value % divisor;
        transition digit >= 0 && digit <= 9 {
            true -> selected(protocol, digit, remainder, divisor, started)
            false -> invalid(protocol)
        }
    }
    state selected(protocol: &mut Protocol, digit: i64 in Wrapping, remainder: i64 in Wrapping, divisor: i64 in Wrapping, started: bool)
    requires divisor >= 1 && digit >= 0 && digit <= 9 {
        transition digit != 0 || started || divisor == 1 {
            true -> emit(protocol, digit, remainder, divisor)
            false -> next(protocol, remainder, divisor, false)
        }
    }
    state emit(protocol: &mut Protocol, digit: i64 in Wrapping,
        remainder: i64 in Wrapping, divisor: i64 in Wrapping)
    requires divisor >= 1 && digit >= 0 && digit <= 9
    {
        Console::write_byte((digit + 48) as i32);
        transition { _ -> next(protocol, remainder, divisor, true) }
    }
    state next(protocol: &mut Protocol, value: i64 in Wrapping,
        divisor: i64 in Wrapping, started: bool)
    requires divisor >= 1
    {
        transition divisor > 1 {
            true -> divide(protocol, value, divisor, started)
            false -> done()
        }
    }
    state divide(protocol: &mut Protocol, value: i64 in Wrapping,
        divisor: i64 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let next_divisor: i64 in Wrapping = divisor / 10;
        transition next_divisor >= 1 {
            true -> digits(protocol, value, next_divisor, started)
            false -> done()
        }
    }
    state invalid(protocol: &mut Protocol) {
        Console::write_line("ERROR numeric: invalid decimal digit");
        Console::exit_process(66);
    }
    state done() { }
}

// Sixteen significant decimal digits as signed integer mantissa and power of ten.
// All model outputs are finite, and normalization precedes the trapping cast.
machine Protocol::number(protocol: &mut Protocol, value: f64)
reaches Console {
    transition value == 0.0 {
        true -> zero(protocol)
        false -> sign(protocol, value)
    }
    state zero(protocol: &mut Protocol) { Console::write("0"); }
    state sign(protocol: &mut Protocol, value: f64) {
        transition value < 0.0 {
            true -> negative(protocol, value)
            false -> normalize(protocol, value, 0)
        }
    }
    state negative(protocol: &mut Protocol, value: f64) {
        Console::write_byte(45);
        transition { _ -> normalize(protocol, 0.0 - value, 0) }
    }
    state normalize(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value >= 10.0 {
            true -> normalize(protocol, value / 10.0, exponent + 1)
            false -> small(protocol, value, exponent)
        }
    }
    state small(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value < 1.0 {
            true -> normalize(protocol, value * 10.0, exponent - 1)
            false -> emit(protocol, value, exponent)
        }
    }
    state emit(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        let scaled: f64 = value * 1000000000000000.0;
        transition scaled == scaled && scaled >= 0.0 && scaled < 10000000000000000.0 {
            true -> land(protocol, scaled, exponent)
            false -> invalid(protocol)
        }
    }
    state land(protocol: &mut Protocol, scaled: f64, exponent: i32 in Wrapping)
    requires scaled == scaled && scaled >= 0.0 && scaled < 10000000000000000.0
    {
        let mantissa: i64 = I64::from_f64(scaled);
        Protocol::wide_integer(protocol, mantissa as i64 in Wrapping);
        Console::write("e");
        Protocol::integer(protocol, exponent - 15);
    }
    state invalid(protocol: &mut Protocol) {
        Console::write_line("ERROR numeric: reporting value outside finite model envelope");
        Console::exit_process(66);
    }
}
