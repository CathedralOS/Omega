// Expected exit: 64 (empty stdin); valid orbital fixtures exit 0 or collision 2.
// Expected output contains: ERROR syntax
use io::protocol;
use domain::orbit;
use omega_language_std::console;
use omega::language::core::float_operations;

data Main { protocol: Protocol; orbit: Orbit; step: i32 in Wrapping; steps: i32 in Wrapping; time: f64; }
machine Main::main(main: &mut Main) reaches Console {
    let valid: bool = block Protocol::read(&mut main.protocol);
    transition valid { true -> validate(main) false -> syntax(main) }
    state syntax(main: &mut Main) {
        Console::write_line("ERROR syntax: seven finite decimal fields, maximum 512 bytes, EOF");
        Console::exit_process(64);
    }
    state validate(main: &mut Main) {
        transition main.protocol.fields[0] > 0.0 && main.protocol.fields[0] <= 1000000.0
            && main.protocol.fields[1] >= -1000000.0 && main.protocol.fields[1] <= 1000000.0
            && main.protocol.fields[2] >= -1000000.0 && main.protocol.fields[2] <= 1000000.0
            && main.protocol.fields[3] >= -1000000.0 && main.protocol.fields[3] <= 1000000.0
            && main.protocol.fields[4] >= -1000000.0 && main.protocol.fields[4] <= 1000000.0
            && main.protocol.fields[5] > 0.0 && main.protocol.fields[5] <= 1.0
            && main.protocol.fields[6] == main.protocol.fields[6]
            && main.protocol.fields[6] >= 1.0 && main.protocol.fields[6] <= 4096.0 {
            true -> count(main, main.protocol.fields[6]) false -> range(main)
        }
    }
    state range(main: &mut Main) {
        Console::write_line("ERROR range: positive mu/dt, nonzero radius, bounded coordinates/velocity, integer steps 1..4096");
        Console::exit_process(65);
    }
    state count(main: &mut Main, count: f64)
    requires count == count && count >= 1.0 && count <= 4096.0 {
        let steps: i32 = I32::from_f64(count);
        transition F64::from_i32(steps) == count { true -> configure(main, steps) false -> range(main) }
    }
    state configure(main: &mut Main, steps: i32) {
        main.steps = steps as i32 in Wrapping;
        main.step = 0; main.time = 0.0;
        main.orbit.parameter = main.protocol.fields[0];
        main.orbit.x = main.protocol.fields[1]; main.orbit.y = main.protocol.fields[2];
        main.orbit.vx = main.protocol.fields[3]; main.orbit.vy = main.protocol.fields[4];
        main.orbit.timestep = main.protocol.fields[5]; main.orbit.collision = false;
        transition main.orbit.x * main.orbit.x + main.orbit.y * main.orbit.y > 0.0 {
            true -> coordinates(main, main.orbit.x, main.orbit.y) false -> range(main)
        }
    }
    state coordinates(main: &mut Main, x: f64, y: f64) {
        transition x == x && x >= -1000000.0 && x <= 1000000.0
            && y == y && y >= -1000000.0 && y <= 1000000.0 {
            true -> bounded(main, x, y) false -> range(main)
        }
    }
    state bounded(main: &mut Main, x: f64, y: f64)
    requires x == x && x >= -1000000.0 && x <= 1000000.0
        && y == y && y >= -1000000.0 && y <= 1000000.0 {
        main.orbit.x = coordinate(x); main.orbit.y = coordinate(y);
        transition { _ -> radius(main) }
    }
    state radius(main: &mut Main) {
        transition main.orbit.x * main.orbit.x + main.orbit.y * main.orbit.y > 0.000000000001 {
            true -> initial(main) false -> collision(main)
        }
    }
    state initial(main: &mut Main) {
        Orbit::diagnostics(&mut main.orbit);
        main.orbit.initial_energy = main.orbit.energy;
        main.orbit.initial_momentum = main.orbit.momentum;
        Console::write_line("checkpoint,step,time,x,y,vx,vy,energy,angular_momentum,energy_drift,angular_momentum_drift");
        transition { _ -> checkpoint(main) }
    }
    state checkpoint(main: &mut Main) {
        Console::write("checkpoint,");
        Protocol::integer(&mut main.protocol, main.step);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.time);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.x);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.y);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.vx);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.vy);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.energy);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.momentum);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.energy - main.orbit.initial_energy);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.orbit.momentum - main.orbit.initial_momentum);
        Console::write_line("");
        transition main.step < main.steps { true -> advance(main) false -> done(main) }
    }
    state advance(main: &mut Main) {
        Orbit::step(&mut main.orbit);
        transition main.orbit.collision { true -> collision(main) false -> advanced(main) }
    }
    state advanced(main: &mut Main) {
        main.step = main.step + 1;
        main.time = main.time + main.orbit.timestep;
        transition main.orbit.periapsis { true -> event(main) false -> checkpoint(main) }
    }
    state event(main: &mut Main) {
        Console::write("periapsis,");
        let time: f64 = main.time - main.orbit.timestep + main.orbit.event_fraction * main.orbit.timestep;
        Protocol::number(&mut main.protocol, time);
        Console::write_line("");
        transition { _ -> checkpoint(main) }
    }
    state collision(main: &mut Main) {
        Console::write_line("status,collision_threshold");
        Console::exit_process(2);
    }
    state done(main: &mut Main) {
        Console::write_line("status,complete");
        Console::exit_process(0);
    }
}
