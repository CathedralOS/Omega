use omega::language::core::float_operations;

// Velocity Verlet keeps the central-force angular momentum. Each drift segment
// is tested against the collision sphere, including a crossing between endpoints.
data Orbit {
    parameter: f64; timestep: f64;
    x: f64; y: f64; vx: f64; vy: f64;
    energy: f64; momentum: f64; radial: f64;
    initial_energy: f64; initial_momentum: f64;
    previous_radial: f64; event_fraction: f64;
    collision: bool; periapsis: bool;
}

machine coordinate(value: f64) -> f64
requires value == value && value >= -1000000.0 && value <= 1000000.0 { value }

machine Orbit::diagnostics(orbit: &mut Orbit) {
    let radius: f64 = F64::square_root(orbit.x * orbit.x + orbit.y * orbit.y);
    let speed_squared: f64 = orbit.vx * orbit.vx + orbit.vy * orbit.vy;
    orbit.energy = 0.5 * speed_squared - orbit.parameter / radius;
    orbit.momentum = orbit.x * orbit.vy - orbit.y * orbit.vx;
    orbit.radial = orbit.x * orbit.vx + orbit.y * orbit.vy;
}

machine Orbit::step(orbit: &mut Orbit) {
    orbit.periapsis = false;
    orbit.previous_radial = orbit.radial;
    let radius_squared: f64 = orbit.x * orbit.x + orbit.y * orbit.y;
    let radius: f64 = F64::square_root(radius_squared);
    let factor: f64 = (0.0 - orbit.parameter) / (radius_squared * radius);
    let half: f64 = 0.5 * orbit.timestep;
    let half_vx: f64 = orbit.vx + half * factor * orbit.x;
    let half_vy: f64 = orbit.vy + half * factor * orbit.y;
    let dx: f64 = orbit.timestep * half_vx;
    let dy: f64 = orbit.timestep * half_vy;
    let length_squared: f64 = dx * dx + dy * dy;
    transition length_squared > 0.0 {
        true -> segment(orbit, half_vx, half_vy, dx, dy, length_squared)
        false -> finish(orbit, half_vx, half_vy, dx, dy)
    }
    machine segment(orbit: &mut Orbit, half_vx: f64, half_vy: f64, dx: f64, dy: f64, length_squared: f64) {
        let fraction: f64 = (0.0 - orbit.x * dx - orbit.y * dy) / length_squared;
        transition fraction > 0.0 && fraction < 1.0 {
            true -> closest(orbit, half_vx, half_vy, dx, dy, fraction)
            false -> finish(orbit, half_vx, half_vy, dx, dy)
        }
    }
    machine closest(orbit: &mut Orbit, half_vx: f64, half_vy: f64, dx: f64, dy: f64, fraction: f64) {
        let x: f64 = orbit.x + fraction * dx;
        let y: f64 = orbit.y + fraction * dy;
        transition x * x + y * y <= 0.000000000001 {
            true -> collision(orbit)
            false -> finish(orbit, half_vx, half_vy, dx, dy)
        }
    }
    machine finish(orbit: &mut Orbit, half_vx: f64, half_vy: f64, dx: f64, dy: f64) {
        let x: f64 = orbit.x + dx;
        let y: f64 = orbit.y + dy;
        let radius_squared: f64 = x * x + y * y;
        transition radius_squared > 0.000000000001 {
            true -> kick(orbit, half_vx, half_vy, x, y, radius_squared)
            false -> collision(orbit)
        }
    }
    machine kick(orbit: &mut Orbit, half_vx: f64, half_vy: f64, x: f64, y: f64, radius_squared: f64) {
        let radius: f64 = F64::square_root(radius_squared);
        let factor: f64 = (0.0 - orbit.parameter) / (radius_squared * radius);
        orbit.x = x; orbit.y = y;
        orbit.vx = half_vx + 0.5 * orbit.timestep * factor * x;
        orbit.vy = half_vy + 0.5 * orbit.timestep * factor * y;
        Orbit::diagnostics(orbit);
        transition orbit.previous_radial < 0.0 && orbit.radial >= 0.0 {
            true -> event(orbit) false -> done()
        }
    }
    machine event(orbit: &mut Orbit) {
        orbit.periapsis = true;
        orbit.event_fraction = (0.0 - orbit.previous_radial) / (orbit.radial - orbit.previous_radial);
    }
    machine collision(orbit: &mut Orbit) { orbit.collision = true; }
    machine done() { }
}
