// Expected exit: 0.
// Expected output contains: placement mask=0005 cost=0004 score=0012
use omega_language_std::console;
use domain::search;
use data::fixtures;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let input: ByteRead = block Console::read_byte();
    transition input {
        ByteRead::Eof -> execute(main, 0)
        ByteRead::Byte { value } -> command(main, value)
    }
    machine command(main: &mut Main, value: i32) {
        transition value >= 48 && value <= 55 {
            true -> execute(main, (value - 48) as u64 in Wrapping)
            false -> invalid(main)
        }
    }
    machine execute(main: &mut Main, variant: u64 in Wrapping) {
        let mut problem: Problem;
        Problem::load(&mut problem, variant);
        let mut search: Search;
        Search::solve(&mut search, &problem);
        Console::write_line("spatial_sensor_deployment v1");
        Console::write("case="); Main::number(main, variant); Console::write_byte(10);
        Main::report(main, &search, &problem);
        Console::exit_process(0);
    }
    machine invalid(main: &mut Main) {
        Console::write_line("invalid command: expected one byte 0..7 or EOF");
        Console::exit_process(64);
    }
}
// Four decimal digits keep the certificate format bounded and inspectable.
machine Main::number(main: &mut Main, value: u64 in Wrapping) reaches Console {
    Console::write_byte(((value / 1000) % 10) as i32 + 48);
    Console::write_byte(((value / 100) % 10) as i32 + 48);
    Console::write_byte(((value / 10) % 10) as i32 + 48);
    Console::write_byte((value % 10) as i32 + 48);
}
machine Main::report(main: &mut Main, search: &Search, problem: &Problem) reaches Console {
    transition { _ -> row(main, search, problem, 0) }
    machine row(main: &mut Main, search: &Search, problem: &Problem, mask: u64 in Wrapping) {
        transition mask < 8 {
            true -> emit(main, search, problem, mask)
            false -> placement(main, search, problem)
        }
    }
    machine emit(main: &mut Main, search: &Search, problem: &Problem, mask: u64 in Wrapping) {
        Console::write("certificate mask="); Main::number(main, mask);
        Console::write(" cost="); Main::number(main, search.rows[mask].cost);
        Console::write(" score="); Main::number(main, search.rows[mask].score);
        Console::write(" feasible="); Main::number(main, search.rows[mask].feasible);
        Console::write(" code="); Main::number(main, search.rows[mask].code);
        Console::write_byte(10);
        transition { _ -> row(main, search, problem, mask + 1) }
    }
    machine placement(main: &mut Main, search: &Search, problem: &Problem) {
        Console::write("placement mask="); Main::number(main, search.mask);
        Console::write(" cost="); Main::number(main, search.cost);
        Console::write(" score="); Main::number(main, search.score);
        Console::write(" code="); Main::number(main, search.code);
        Console::write(" ties="); Main::number(main, search.ties);
        Console::write(" status=");
        transition search.score >= problem.minimum {
            true -> status(main, search, 1)
            false -> status(main, search, 0)
        }
    }
    machine status(main: &mut Main, search: &Search, accepted: u64 in Wrapping) {
        Main::number(main, accepted); Console::write_byte(10);
        transition { _ -> demand(main, search.code, 0) }
    }
    machine demand(main: &mut Main, remaining: u64 in Wrapping, position: u64 in Wrapping) {
        transition position < 4 {
            true -> coverage(main, remaining, position)
            false -> done()
        }
    }
    machine coverage(main: &mut Main, remaining: u64 in Wrapping, position: u64 in Wrapping) {
        Console::write("demand="); Main::number(main, position);
        Console::write(" site="); Main::number(main, remaining % 4); Console::write_byte(10);
        transition { _ -> demand(main, remaining / 4, position + 1) }
    }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
