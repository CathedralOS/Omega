use domain::model;
machine Problem::load(problem: &mut Problem, variant: u64 in Wrapping) {
    problem.sites[0].x = 0; problem.sites[0].y = 0;
    problem.sites[0].cost = 2; problem.sites[0].capacity = 2; problem.sites[0].radius = 2;
    problem.sites[1].x = 3; problem.sites[1].y = 0;
    problem.sites[1].cost = 3; problem.sites[1].capacity = 2; problem.sites[1].radius = 2;
    problem.sites[2].x = 0; problem.sites[2].y = 3;
    problem.sites[2].cost = 2; problem.sites[2].capacity = 1; problem.sites[2].radius = 2;
    problem.demands[0].x = 0; problem.demands[0].y = 1; problem.demands[0].weight = 5;
    problem.demands[1].x = 2; problem.demands[1].y = 0; problem.demands[1].weight = 4;
    problem.demands[2].x = 0; problem.demands[2].y = 3; problem.demands[2].weight = 3;
    problem.demands[3].x = 9; problem.demands[3].y = 9; problem.demands[3].weight = 2;
    problem.powers[0] = 1; problem.powers[1] = 2; problem.powers[2] = 4;
    problem.budget = 4; problem.minimum = 0;
    transition variant {
        1 -> unreachable(problem)
        2 -> tied(problem)
        3 -> capacity(problem)
        4 -> redundant(problem)
        5 -> empty(problem)
        6 -> threshold(problem)
        7 -> boundary(problem)
        _ -> done()
    }
    machine unreachable(problem: &mut Problem) { problem.minimum = 14; }
    machine tied(problem: &mut Problem) { problem.sites[1].x = 0; problem.sites[1].cost = 2; }
    machine capacity(problem: &mut Problem) { problem.sites[0].capacity = 1; }
    machine redundant(problem: &mut Problem) { problem.sites[2].y = 0; problem.sites[2].capacity = 2; }
    machine empty(problem: &mut Problem) { problem.budget = 0; }
    machine threshold(problem: &mut Problem) { problem.minimum = 12; }
    machine boundary(problem: &mut Problem) { problem.sites[0].radius = 1; problem.budget = 5; }
    machine done() { }
}
