// Complete stdin application. Input: replication header, eight digit/m slots, EOF.
// Expected output contains: crossed_gauge_study: exact crossed random-effects sample; all numbers /32
use omega_language_std::console;
use study::model;

data Main { study: study::model::Study; }

machine Main::number(main: &mut Main, value: i32 in Wrapping) reaches Console {
    transition value < 0 { true -> negative(main, value) _ -> leading(main, value) }
    state negative(main: &mut Main, value: i32 in Wrapping) {
        Console::write("-");
        transition { _ -> leading(main, 0-value) }
    }
    state leading(main: &mut Main, value: i32 in Wrapping) {
        transition value >= 10000 { true -> ten_thousands(main, value) _ -> check_thousands(main, value) }
    }
    state ten_thousands(main: &mut Main, value: i32 in Wrapping) {
        Console::write_byte((value / 10000 + 48) as i32);
        transition { _ -> thousands(main, value) }
    }
    state check_thousands(main: &mut Main, value: i32 in Wrapping) {
        transition value >= 1000 { true -> thousands(main, value) _ -> check_hundreds(main, value) }
    }
    state thousands(main: &mut Main, value: i32 in Wrapping) {
        Console::write_byte((value / 1000 % 10 + 48) as i32);
        transition { _ -> hundreds(main, value) }
    }
    state check_hundreds(main: &mut Main, value: i32 in Wrapping) {
        transition value >= 100 { true -> hundreds(main, value) _ -> check_tens(main, value) }
    }
    state hundreds(main: &mut Main, value: i32 in Wrapping) {
        Console::write_byte((value / 100 % 10 + 48) as i32);
        transition { _ -> tens(main, value) }
    }
    state check_tens(main: &mut Main, value: i32 in Wrapping) {
        transition value >= 10 { true -> tens(main, value) _ -> ones(main, value) }
    }
    state tens(main: &mut Main, value: i32 in Wrapping) {
        Console::write_byte((value / 10 % 10 + 48) as i32);
        transition { _ -> ones(main, value) }
    }
    state ones(main: &mut Main, value: i32 in Wrapping) {
        Console::write_byte((value % 10 + 48) as i32);
        Console::write_line("");
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("crossed_gauge_study: exact crossed random-effects sample; all numbers /32");
    transition { _ -> header(main) }
    state header(main: &mut Main) {
        let byte: ByteRead = block Console::read_byte();
        transition byte {
            ByteRead::Byte { value } -> header_byte(main, value)
            _ -> invalid(main)
        }
    }
    state header_byte(main: &mut Main, value: i32) {
        transition value {
            50 -> read(main, 0)
            49 -> insufficient(main)
            32 -> header(main)
            10 -> header(main)
            13 -> header(main)
            _ -> invalid(main)
        }
    }
    state read(main: &mut Main, index: i32 in Wrapping) {
        let byte: ByteRead = block Console::read_byte();
        transition byte {
            ByteRead::Byte { value } -> token(main, index, value)
            ByteRead::Eof -> finish(main, index)
        }
    }
    state token(main: &mut Main, index: i32 in Wrapping, value: i32) {
        transition value == 32 || value == 10 || value == 13 {
            true -> read(main, index)
            _ -> extent(main, index, value)
        }
    }
    state extent(main: &mut Main, index: i32 in Wrapping, value: i32) {
        transition index >= 0 && index < 8 {
            true -> measurement(main, index, value)
            _ -> invalid(main)
        }
    }
    state measurement(main: &mut Main, index: i32 in Wrapping, value: i32) {
        transition value >= 48 && value <= 57 {
            true -> store(main, index, value)
            _ -> missing(main, index, value)
        }
    }
    state store(main: &mut Main, index: i32 in Wrapping, value: i32) {
        main.study.values[index] = (value as i32 in Wrapping) - 48;
        main.study.present[index] = 1;
        transition { _ -> read(main, index + 1) }
    }
    state missing(main: &mut Main, index: i32 in Wrapping, value: i32) {
        transition value == 109 {
            true -> absent(main, index)
            _ -> invalid(main)
        }
    }
    state absent(main: &mut Main, index: i32 in Wrapping) {
        main.study.values[index] = 0;
        main.study.present[index] = 0;
        transition { _ -> read(main, index + 1) }
    }
    state finish(main: &mut Main, index: i32 in Wrapping) {
        transition index == 8 { true -> analyze(main) _ -> invalid(main) }
    }
    state analyze(main: &mut Main) {
        let status: i32 = study::model::analyze(&mut main.study);
        transition status { 0 -> report(main) 3 -> missing_cell(main) 5 -> insufficient(main) _ -> unequal(main) }
    }
    state report(main: &mut Main) {
        Console::write_line("identifiable: parts=2 operators=2 repeats=2; df=1,1,1,4 total=7");
        Console::write("ss_part=");
        let part_sum_of_squares: i32 in Wrapping = main.study.part;
        Main::number(main, part_sum_of_squares);
        Console::write("ss_operator=");
        let operator_sum_of_squares: i32 in Wrapping = main.study.operator_effect;
        Main::number(main, operator_sum_of_squares);
        Console::write("ss_interaction=");
        let interaction_sum_of_squares: i32 in Wrapping = main.study.interaction;
        Main::number(main, interaction_sum_of_squares);
        Console::write("ss_error=");
        let error_sum_of_squares: i32 in Wrapping = main.study.error;
        Main::number(main, error_sum_of_squares);
        Console::write("ss_total=");
        let total_sum_of_squares: i32 in Wrapping = main.study.total;
        Main::number(main, total_sum_of_squares);
        Console::write("ms_error=");
        let error_mean_square: i32 in Wrapping = main.study.repeatability;
        Main::number(main, error_mean_square);
        Console::write("raw_part=");
        let raw_part_component: i32 in Wrapping = main.study.part_variance;
        Main::number(main, raw_part_component);
        Console::write("raw_operator=");
        let raw_operator_component: i32 in Wrapping = main.study.operator_variance;
        Main::number(main, raw_operator_component);
        Console::write("raw_interaction=");
        let raw_interaction_component: i32 in Wrapping = main.study.interaction_variance;
        Main::number(main, raw_interaction_component);
        Console::write("repeatability=");
        let repeatability_component: i32 in Wrapping = main.study.repeatability;
        Main::number(main, repeatability_component);
        Console::write("part_variance=");
        let clamped_part_component: i32 in Wrapping = study::model::nonnegative(main.study.part_variance);
        Main::number(main, clamped_part_component);
        Console::write("operator_variance=");
        let clamped_operator_component: i32 in Wrapping = study::model::nonnegative(main.study.operator_variance);
        Main::number(main, clamped_operator_component);
        Console::write("interaction_variance=");
        let clamped_interaction_component: i32 in Wrapping = study::model::nonnegative(main.study.interaction_variance);
        Main::number(main, clamped_interaction_component);
        Console::write("gauge_variance=");
        let gauge_component: i32 in Wrapping = main.study.repeatability + study::model::nonnegative(main.study.operator_variance) + study::model::nonnegative(main.study.interaction_variance);
        Main::number(main, gauge_component);
        Console::write_line("interaction: retained; negative components clamped individually; no pooling");
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) {
        Console::write_line("invalid input: expected header 2 and exactly eight digit/m slots");
        Console::exit_process(2);
    }
    state insufficient(main: &mut Main) {
        Console::write_line("not identifiable: one repeat cannot separate interaction from repeatability");
        Console::exit_process(5);
    }
    state missing_cell(main: &mut Main) {
        Console::write_line("not identifiable: missing part/operator cell; balanced ANOVA refused");
        Console::exit_process(3);
    }
    state unequal(main: &mut Main) {
        Console::write_line("not identifiable: unequal replication; balanced ANOVA refused");
        Console::exit_process(4);
    }
}
