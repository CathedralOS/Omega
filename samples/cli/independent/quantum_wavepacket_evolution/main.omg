// Expected exit: 2. Empty stdin is invalid; valid problems return 0.
// Expected output contains: INVALID quantum input
use omega_language_std::console;
use omega::language::core::float_operations;
use domain::input;
use domain::complex;
use domain::model;
use domain::evolve;
use domain::report;
data Main { reader: Reader; problem: Problem; }
machine Main::main(main: &mut Main) reaches Console {
    let count: Number = block number(&mut main.reader);
    let spacing: Number = block number(&mut main.reader);
    let timestep: Number = block number(&mut main.reader);
    let steps: Number = block number(&mut main.reader);
    let cells: i32 in Saturating = I32::from_f64(count.value);
    main.problem.cells = cells as i32;
    let iterations: i32 in Saturating = I32::from_f64(steps.value);
    main.problem.steps = iterations as i32;
    main.problem.spacing = spacing.value;
    main.problem.timestep = timestep.value;
    transition count.valid && count.integer && spacing.valid && timestep.valid && steps.valid && steps.integer && count.value == F64::from_i32(main.problem.cells) && steps.value == F64::from_i32(main.problem.steps) && main.problem.cells >= 8 && main.problem.cells <= 32 && main.problem.steps >= 0 && main.problem.steps <= 256 && spacing.value > 0.0 && timestep.value > 0.0 {
        true -> read(main, 0) false -> invalid(main)
    }
    state read(main: &mut Main, row: i32) {
        transition row >= 0 && row < main.problem.cells && row < 32 { true -> cell(main, row) false -> finish(main) }
    }
    state cell(main: &mut Main, row: i32) requires row >= 0 && row < 32 {
        let potential: Number = block number(&mut main.reader);
        let real: Number = block number(&mut main.reader);
        let imaginary: Number = block number(&mut main.reader);
        main.problem.potential[row] = potential.value;
        main.problem.amplitude[row] = Complex { real: real.value, imaginary: imaginary.value };
        transition potential.valid && real.valid && imaginary.valid { true -> read(main, row + 1) false -> invalid(main) }
    }
    state finish(main: &mut Main) {
        let complete: bool = block ended(&mut main.reader);
        let norm: f64 = probability_norm(&main.problem);
        transition complete && norm > 0.0 { true -> conditioning(main, 0, norm) false -> invalid(main) }
    }
    // I+i dt H/2 is nonsingular mathematically, but extreme stiffness loses
    // the identity in double-precision elimination. Refuse that numerical
    // regime before factorization rather than silently losing probability.
    state conditioning(main: &mut Main, row: i32, norm: f64) {
        transition row >= 0 && row < main.problem.cells && row < 32 { true -> coefficient(main, row, norm) false -> normalize(main, 0, 1.0 / F64::square_root(norm)) }
    }
    state coefficient(main: &mut Main, row: i32, norm: f64) requires row >= 0 && row < 32 {
        let magnitude: f64 = absolute(main.problem.potential[row]);
        let stiffness: f64 = main.problem.timestep * (1.0 / (main.problem.spacing * main.problem.spacing) + magnitude);
        transition stiffness <= 1000.0 { true -> conditioning(main, row + 1, norm) false -> refused(main) }
    }
    state refused(main: &mut Main) { Console::write_line("REFUSED quantum conditioning"); Console::exit_process(3); }
    state normalize(main: &mut Main, row: i32, factor: f64) {
        transition row >= 0 && row < main.problem.cells && row < 32 { true -> normalized(main, row, factor) false -> prepare(main) }
    }
    state normalized(main: &mut Main, row: i32, factor: f64) requires row >= 0 && row < 32 {
        main.problem.amplitude[row] = scale(main.problem.amplitude[row], factor);
        transition { _ -> normalize(main, row + 1, factor) }
    }
    state prepare(main: &mut Main) {
        factor(&mut main.problem);
        Console::write_line("quantum_wavepacket_evolution hbar=m=1");
        transition { _ -> checkpoint(main, 0) }
    }
    state checkpoint(main: &mut Main, iteration: i32) {
        integer(iteration); Console::write(" ");
        scaled(probability_norm(&main.problem)); Console::write(" ");
        scaled(energy(&main.problem)); Console::write_line("");
        transition { _ -> amplitudes(main, iteration, 0) }
    }
    state amplitudes(main: &mut Main, iteration: i32, row: i32) {
        transition row >= 0 && row < main.problem.cells && row < 32 { true -> emit(main, iteration, row) false -> advance(main, iteration) }
    }
    state emit(main: &mut Main, iteration: i32, row: i32) requires row >= 0 && row < 32 {
        let value: Complex = main.problem.amplitude[row];
        scaled(value.real); Console::write(" ");
        scaled(value.imaginary); Console::write(" ");
        scaled(main.problem.spacing * squared(value)); Console::write_line("");
        transition { _ -> amplitudes(main, iteration, row + 1) }
    }
    state advance(main: &mut Main, iteration: i32) {
        transition iteration >= 0 && iteration < main.problem.steps && iteration < 256 { true -> evolve(main, iteration) false -> done() }
    }
    state evolve(main: &mut Main, iteration: i32) requires iteration >= 0 && iteration < 256 {
        step(&mut main.problem);
        transition { _ -> checkpoint(main, iteration + 1) }
    }
    state invalid(main: &mut Main) { Console::write_line("INVALID quantum input"); Console::exit_process(2); }
    state done() {}
}
machine probability_norm(problem: &Problem) -> f64 {
    transition { _ -> rows(problem, 0, 0.0) }
    state rows(problem: &Problem, row: i32, sum: f64) -> f64 {
        transition row >= 0 && row < problem.cells && row < 32 { true -> accumulate(problem, row, sum) false -> (problem.spacing * sum) }
    }
    state accumulate(problem: &Problem, row: i32, sum: f64) -> f64 requires row >= 0 && row < 32 {
        transition { _ -> rows(problem, row + 1, sum + squared(problem.amplitude[row])) }
    }
}
// The equivalent quadratic kinetic form avoids subtracting large adjacent
// diagonal/off-diagonal energies for an almost constant wavefunction.
machine energy(problem: &Problem) -> f64 {
    transition { _ -> rows(problem, 0, 0.0) }
    state rows(problem: &Problem, row: i32, sum: f64) -> f64 {
        transition row >= 0 && row < problem.cells && row < 32 { true -> neighbor(problem, row, sum) false -> (problem.spacing * sum) }
    }
    state neighbor(problem: &Problem, row: i32, sum: f64) -> f64 requires row >= 0 && row < 32 {
        transition row + 1 < problem.cells && row + 1 < 32 { true -> accumulate(problem, row, row + 1, sum) false -> accumulate(problem, row, 0, sum) }
    }
    state accumulate(problem: &Problem, row: i32, neighbor: i32, sum: f64) -> f64 requires row >= 0 && row < 32 && neighbor >= 0 && neighbor < 32 {
        let difference: Complex = subtract(problem.amplitude[neighbor], problem.amplitude[row]);
        let term: f64 = 0.5 * squared(difference) / (problem.spacing * problem.spacing) + problem.potential[row] * squared(problem.amplitude[row]);
        transition { _ -> rows(problem, row + 1, sum + term) }
    }
}
machine absolute(value: f64) -> f64 { transition value < 0.0 { true -> (0.0 - value) false -> (value) } }
