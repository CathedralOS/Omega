use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

// Decimal integer mantissa and exponent retain about 18 significant digits
// without saturating large energy or small amplitudes into the integer range.
public machine scaled(value: f64)
invokes Console;
reaches Console {
    transition value < 0.0 { true -> negative(value) false -> normalize(value, 0) }
    machine negative(value: f64) {
        Console::write("-");
        transition { _ -> normalize(0.0 - value, 0) }
    }
    machine normalize(value: f64, exponent: i32 in Wrapping) {
        transition {
            value > 1.0 -> shrink(value, exponent)
            value > 0.0 && value < 0.1 -> grow(value, exponent)
            _ -> emit(value, exponent)
        }
    }
    machine shrink(value: f64, exponent: i32 in Wrapping) {
        transition { _ -> normalize(value / 10.0, exponent + 1) }
    }
    machine grow(value: f64, exponent: i32 in Wrapping) {
        transition { _ -> normalize(value * 10.0, exponent - 1) }
    }
    machine emit(value: f64, exponent: i32 in Wrapping) {
        let mantissa: i64 in Saturating = I64::from_f64(value * 1000000000000000000.0);
        integer64(mantissa as i64); Console::write("e");
        integer((exponent - 18) as i32);
    }
}
public machine integer(value: i32)
invokes Console;
reaches Console {
    integer64(widen_i32_to_i64(value));
}
public machine integer64(value: i64)
invokes Console;
reaches Console {
    transition value < 0 {
        true -> negative(value)
        false -> positive(value)
    }
    machine negative(value: i64) {
        Console::write("-");
        // Unsigned modular negation also handles the full signed minimum.
        let bits: u64 = narrow_i64_to_u64_wrapping(value);
        let magnitude: u64 in Wrapping = 0 - (bits as u64 in Wrapping);
        unsigned(magnitude as u64);
    }
    machine positive(value: i64) {
        unsigned(narrow_i64_to_u64_wrapping(value));
    }
}
machine unsigned(value: u64)
invokes Console;
reaches Console {
    transition { _ -> digits(value, 10000000000000000000, false) }
    machine digits(value: u64, divisor: u64, started: bool)
    requires divisor > 0
    {
        let digit: u64 = value / divisor % 10;
        transition started || digit != 0 || divisor == 1 {
            true -> emit(value, divisor, digit)
            false -> skip(value, divisor)
        }
    }
    machine emit(value: u64, divisor: u64, digit: u64)
    requires divisor > 0
    {
        let byte: u64 in Wrapping = (digit as u64 in Wrapping) + 48;
        Console::write_byte(narrow_u64_to_i32_saturating(byte as u64));
        transition divisor >= 10 {
            true -> digits(value, divisor / 10, true)
            false -> done()
        }
    }
    machine skip(value: u64, divisor: u64)
    requires divisor > 0
    {
        transition divisor >= 10 {
            true -> digits(value, divisor / 10, false)
            false -> done()
        }
    }
    machine done() { }
}
