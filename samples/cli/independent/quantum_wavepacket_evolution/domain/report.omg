use omega_language_std::console;
use omega::language::core::binding;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

// Decimal integer mantissa and exponent retain about 18 significant digits
// without saturating large energy or small amplitudes into the integer range.
pub machine scaled(console: &mut Binding<Console>, value: f64)
invokes console;
reaches Console {
    transition value < 0.0 { true -> negative(console, value) false -> normalize(console, value, 0) }
    state negative(console: &mut Binding<Console>, value: f64) {
        console.write("-");
        transition { _ -> normalize(console, 0.0 - value, 0) }
    }
    state normalize(console: &mut Binding<Console>, value: f64, exponent: i32 in Wrapping) {
        transition {
            value > 1.0 -> shrink(console, value, exponent)
            value > 0.0 && value < 0.1 -> grow(console, value, exponent)
            _ -> emit(console, value, exponent)
        }
    }
    state shrink(console: &mut Binding<Console>, value: f64, exponent: i32 in Wrapping) {
        transition { _ -> normalize(console, value / 10.0, exponent + 1) }
    }
    state grow(console: &mut Binding<Console>, value: f64, exponent: i32 in Wrapping) {
        transition { _ -> normalize(console, value * 10.0, exponent - 1) }
    }
    state emit(console: &mut Binding<Console>, value: f64, exponent: i32 in Wrapping) {
        let mantissa: i64 in Saturating = I64::from_f64(value * 1000000000000000000.0);
        integer64(console, mantissa as i64); console.write("e");
        integer(console, (exponent - 18) as i32);
    }
}
pub machine integer(console: &mut Binding<Console>, value: i32)
invokes console;
reaches Console {
    integer64(console, widen_i32_to_i64(value));
}
pub machine integer64(console: &mut Binding<Console>, value: i64)
invokes console;
reaches Console {
    transition value < 0 {
        true -> negative(console, value)
        false -> positive(console, value)
    }
    state negative(console: &mut Binding<Console>, value: i64) {
        console.write("-");
        // Unsigned modular negation also handles the full signed minimum.
        let bits: u64 = narrow_i64_to_u64_wrapping(value);
        let magnitude: u64 in Wrapping = 0 - (bits as u64 in Wrapping);
        unsigned(console, magnitude as u64);
    }
    state positive(console: &mut Binding<Console>, value: i64) {
        unsigned(console, narrow_i64_to_u64_wrapping(value));
    }
}
machine unsigned(console: &mut Binding<Console>, value: u64)
invokes console;
reaches Console {
    transition { _ -> digits(console, value, 10000000000000000000, false) }
    state digits(console: &mut Binding<Console>, value: u64, divisor: u64, started: bool)
    requires divisor > 0
    {
        let digit: u64 = value / divisor % 10;
        transition started || digit != 0 || divisor == 1 {
            true -> emit(console, value, divisor, digit)
            false -> skip(console, value, divisor)
        }
    }
    state emit(console: &mut Binding<Console>, value: u64, divisor: u64, digit: u64)
    requires divisor > 0
    {
        let byte: u64 in Wrapping = (digit as u64 in Wrapping) + 48;
        console.write_byte(narrow_u64_to_i32_saturating(byte as u64));
        transition divisor >= 10 {
            true -> digits(console, value, divisor / 10, true)
            false -> done()
        }
    }
    state skip(console: &mut Binding<Console>, value: u64, divisor: u64)
    requires divisor > 0
    {
        transition divisor >= 10 {
            true -> digits(console, value, divisor / 10, false)
            false -> done()
        }
    }
    state done() { }
}
