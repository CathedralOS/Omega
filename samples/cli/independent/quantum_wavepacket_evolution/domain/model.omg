use omega::language::core::float_operations;
use domain::complex;
public data Problem {
    cells: i32; spacing: f64; timestep: f64; steps: i32;
    potential: [f64; 32]; amplitude: [Complex; 32]; next: [Complex; 32];
    matrix: [Complex; 1024]; right: [Complex; 32];
}
// Storage guards are explicit and independent of the input dimensions.
public machine element(problem: &Problem, row: i32, column: i32) -> Complex {
    let position: i32 in Wrapping = (row as i32 in Wrapping) * 32 + (column as i32 in Wrapping);
    transition position >= 0 && position < 1024 { true -> read(problem, position as i32) false -> (Complex { real: 0.0, imaginary: 0.0 }) }
    machine read(problem: &Problem, position: i32) -> Complex requires position >= 0 && position < 1024 { problem.matrix[position] }
}
public machine store(problem: &mut Problem, row: i32, column: i32, value: Complex) {
    let position: i32 in Wrapping = (row as i32 in Wrapping) * 32 + (column as i32 in Wrapping);
    transition position >= 0 && position < 1024 { true -> write(problem, position as i32, value) false -> done() }
    machine write(problem: &mut Problem, position: i32, value: Complex) requires position >= 0 && position < 1024 { problem.matrix[position] = value; }
    machine done() {}
}
public machine hamiltonian(problem: &Problem, row: i32, column: i32) -> f64
requires row >= 0 && row < 32
{
    let kinetic: f64 = 1.0 / (problem.spacing * problem.spacing);
    transition {
        row == column -> (kinetic + problem.potential[row])
        column == row - 1 || column == row + 1 || (row == 0 && column == (((problem.cells as i32 in Wrapping) - 1) as i32)) || (column == 0 && row == (((problem.cells as i32 in Wrapping) - 1) as i32)) -> (0.0 - 0.5 * kinetic)
        _ -> 0.0
    }
}
