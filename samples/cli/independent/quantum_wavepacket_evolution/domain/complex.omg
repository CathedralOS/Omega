use omega::language::core::float_operations;
// Explicit complex arithmetic owned by this consumer; no external complex dependency.
public data Complex [copy] { real: f64; imaginary: f64; }
public machine add(left: Complex, right: Complex) -> Complex { Complex { real: left.real + right.real, imaginary: left.imaginary + right.imaginary } }
public machine subtract(left: Complex, right: Complex) -> Complex { Complex { real: left.real - right.real, imaginary: left.imaginary - right.imaginary } }
public machine multiply(left: Complex, right: Complex) -> Complex { Complex { real: left.real * right.real - left.imaginary * right.imaginary, imaginary: left.real * right.imaginary + left.imaginary * right.real } }
public machine divide(left: Complex, right: Complex) -> Complex {
    let denominator: f64 = right.real * right.real + right.imaginary * right.imaginary;
    Complex { real: (left.real * right.real + left.imaginary * right.imaginary) / denominator, imaginary: (left.imaginary * right.real - left.real * right.imaginary) / denominator }
}
public machine scale(value: Complex, factor: f64) -> Complex { Complex { real: value.real * factor, imaginary: value.imaginary * factor } }
public machine squared(value: Complex) -> f64 { value.real * value.real + value.imaginary * value.imaginary }
