use omega::language::core::float_operations;
// Explicit complex arithmetic owned by this consumer; no external complex dependency.
pub data Complex [copy] { real: f64; imaginary: f64; }
pub machine add(left: Complex, right: Complex) -> Complex { Complex { real: left.real + right.real, imaginary: left.imaginary + right.imaginary } }
pub machine subtract(left: Complex, right: Complex) -> Complex { Complex { real: left.real - right.real, imaginary: left.imaginary - right.imaginary } }
pub machine multiply(left: Complex, right: Complex) -> Complex { Complex { real: left.real * right.real - left.imaginary * right.imaginary, imaginary: left.real * right.imaginary + left.imaginary * right.real } }
pub machine divide(left: Complex, right: Complex) -> Complex {
    let denominator: f64 = right.real * right.real + right.imaginary * right.imaginary;
    Complex { real: (left.real * right.real + left.imaginary * right.imaginary) / denominator, imaginary: (left.imaginary * right.real - left.real * right.imaginary) / denominator }
}
pub machine scale(value: Complex, factor: f64) -> Complex { Complex { real: value.real * factor, imaginary: value.imaginary * factor } }
pub machine squared(value: Complex) -> f64 { value.real * value.real + value.imaginary * value.imaginary }
