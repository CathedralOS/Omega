// Declared sample model: E(T) = a + b*T + c*T*T in mV and Celsius.
// Strict derivative signs at both endpoints certify each quadratic segment
// monotone. Global monotonicity is deliberately not assumed: enumerate roots.
use omega::language::core::float_operations;

public data Segment [copy] { low: f64; high: f64; a: f64; b: f64; c: f64; }
public data Estimate [copy] { count: i32; temperature: f64; residual: f64; }

public machine voltage(segment: Segment, temperature: f64) -> f64 {
    transition { _ -> ((segment.c * temperature + segment.b) * temperature + segment.a) }
}
public machine magnitude(value: f64) -> f64 {
    transition value < 0.0 { true -> (0.0 - value) _ -> value }
}
public machine valid(segment: Segment) -> bool {
    // For 0.001-scaled integer inputs, b + 2*c*T is an even integer
    // divided by 1,000,000: every nonzero derivative is at least 2e-6.
    // The 1e-12 zero guard exceeds binary64 roundoff within the declared
    // bounds, while remaining far below that discrete nonzero quantum.
    let left: f64 = segment.b + 2.0 * segment.c * segment.low;
    let right: f64 = segment.b + 2.0 * segment.c * segment.high;
    transition { _ -> (segment.low >= -100.0 && segment.high <= 200.0 && segment.low < segment.high &&
        magnitude(segment.a) <= 100.0 && magnitude(segment.b) <= 1.0 && magnitude(segment.c) <= 0.01 &&
        ((left > 0.000000000001 && right > 0.000000000001) ||
         (left < -0.000000000001 && right < -0.000000000001))) }
}
public machine inside(segment: Segment, temperature: f64) -> bool {
    transition { _ -> (temperature >= segment.low && temperature <= segment.high) }
}
// Forty fixed bisection steps bound temperature error by 300 / 2**40 C.
// The caller has already clipped the interval and proved endpoint enclosure.
machine bisect(segment: Segment, target: f64, low: f64, high: f64) -> f64 {
    let increasing: bool = voltage(segment, high) > voltage(segment, low);
    transition { _ -> step(segment, target, low, high, increasing, 0) }
    machine step(segment: Segment, target: f64, low: f64, high: f64, increasing: bool, iteration: i32) -> f64 {
        transition iteration >= 0 && iteration < 40 {
            true -> halve(segment, target, low, high, increasing, iteration)
            _ -> ((low + high) * 0.5)
        }
    }
    machine halve(segment: Segment, target: f64, low: f64, high: f64, increasing: bool, iteration: i32) -> f64
    requires iteration >= 0 && iteration < 40
    {
        let middle: f64 = (low + high) * 0.5;
        let observed: f64 = voltage(segment, middle);
        transition (observed < target) == increasing {
            true -> step(segment, target, middle, high, increasing, iteration + 1)
            _ -> step(segment, target, low, middle, increasing, iteration + 1)
        }
    }
}
public machine candidate(segment: Segment, target: f64, requested_low: f64, requested_high: f64) -> Estimate {
    let low: f64 = maximum(segment.low, requested_low);
    let high: f64 = minimum(segment.high, requested_high);
    transition low <= high {
        true -> enclosure(segment, target, low, high)
        _ -> Estimate { count: 0, temperature: 0.0, residual: 0.0 }
    }
    machine enclosure(segment: Segment, target: f64, low: f64, high: f64) -> Estimate {
        let left: f64 = voltage(segment, low);
        // Endpoint snapping absorbs only 1e-12 mV of evaluation roundoff.
        transition magnitude(left - target) <= 0.000000000001 {
            true -> Estimate { count: 1, temperature: low, residual: left - target }
            _ -> high_endpoint(segment, target, low, high, left)
        }
    }
    machine high_endpoint(segment: Segment, target: f64, low: f64, high: f64, left: f64) -> Estimate {
        let right: f64 = voltage(segment, high);
        transition magnitude(right - target) <= 0.000000000001 {
            true -> Estimate { count: 1, temperature: high, residual: right - target }
            _ -> interior(segment, target, low, high, left, right)
        }
    }
    machine interior(segment: Segment, target: f64, low: f64, high: f64, left: f64, right: f64) -> Estimate {
        transition target >= minimum(left, right) && target <= maximum(left, right) {
            true -> solve(segment, target, low, high)
            _ -> Estimate { count: 0, temperature: 0.0, residual: 0.0 }
        }
    }
    machine solve(segment: Segment, target: f64, low: f64, high: f64) -> Estimate {
        let temperature: f64 = bisect(segment, target, low, high);
        transition { _ -> Estimate { count: 1, temperature: temperature,
            residual: voltage(segment, temperature) - target } }
    }
}
public machine enumerate(first: Segment, second: Segment, target: f64, low: f64, high: f64) -> Estimate {
    let left: Estimate = candidate(first, target, low, high);
    let right: Estimate = candidate(second, target, low, high);
    transition left.count == 0 {
        true -> right
        _ -> join(left, right)
    }
    machine join(left: Estimate, right: Estimate) -> Estimate {
        transition right.count == 0 || magnitude(left.temperature - right.temperature) < 0.00000001 {
            true -> left
            _ -> Estimate { count: 2, temperature: 0.0, residual: 0.0 }
        }
    }
}
machine minimum(left: f64, right: f64) -> f64 { transition left < right { true -> left _ -> right } }
machine maximum(left: f64, right: f64) -> f64 { transition left > right { true -> left _ -> right } }
