// Complete supplied-calibration compensation application; see README for units.
use domain::input;
use domain::model;
use domain::report;
use omega::language::core::float_operations;
use omega_language_std::console;

data Application { reader: Reader; }

machine Application::main(application: &mut Application) reaches Console {
    let value_0: Number = block number(&mut application.reader);
    let value_1: Number = block number(&mut application.reader);
    let value_2: Number = block number(&mut application.reader);
    let value_3: Number = block number(&mut application.reader);
    let value_4: Number = block number(&mut application.reader);
    let value_5: Number = block number(&mut application.reader);
    let value_6: Number = block number(&mut application.reader);
    let value_7: Number = block number(&mut application.reader);
    let value_8: Number = block number(&mut application.reader);
    let value_9: Number = block number(&mut application.reader);
    let value_10: Number = block number(&mut application.reader);
    let value_11: Number = block number(&mut application.reader);
    let value_12: Number = block number(&mut application.reader);
    let value_13: Number = block number(&mut application.reader);
    let value_14: Number = block number(&mut application.reader);
    let finished: bool = block ended(&mut application.reader);
    transition value_0.valid && value_1.valid && value_2.valid && value_3.valid && value_4.valid && value_5.valid && value_6.valid && value_7.valid && value_8.valid && value_9.valid && value_10.valid && value_11.valid && value_12.valid && value_13.valid && value_14.valid && finished {
        true -> calibrate(application, Segment { low: value_0.value, high: value_1.value, a: value_2.value, b: value_3.value, c: value_4.value }, Segment { low: value_5.value, high: value_6.value, a: value_7.value, b: value_8.value, c: value_9.value }, value_10.value, value_11.value, value_12.value, value_13.value, value_14.value)
        _ -> malformed(application)
    }
    state malformed(application: &mut Application) { Console::write_line("ERROR input"); Console::exit_process(10); }
    // Exact boundary voltage differences have a 1e-9 mV quantum from
    // 0.001-scaled coefficients/temperature. The midpoint 9.5e-9 admits
    // every permitted difference <=9e-9 and rejects every >=1e-8 despite
    // binary64 roundoff within the bounded sample domain.
    state calibrate(application: &mut Application, first: Segment, second: Segment, measured: f64, cold: f64, reference: f64, low: f64, high: f64) {
        transition valid(first) && valid(second) && first.high == second.low &&
            magnitude(voltage(first, first.high) - voltage(second, second.low)) < 0.0000000095 {
            true -> cold_junction(application, first, second, measured, cold, reference, low, high)
            _ -> calibration_error(application)
        }
    }
    state calibration_error(application: &mut Application) { Console::write_line("ERROR calibration"); Console::exit_process(11); }
    state cold_junction(application: &mut Application, first: Segment, second: Segment, measured: f64, cold: f64, reference: f64, low: f64, high: f64) {
        transition inside(first, cold) { true -> compensate(application, first, second, measured + voltage(first, cold), reference, low, high) _ -> cold_second(application, first, second, measured, cold, reference, low, high) }
    }
    state cold_second(application: &mut Application, first: Segment, second: Segment, measured: f64, cold: f64, reference: f64, low: f64, high: f64) {
        transition inside(second, cold) { true -> compensate(application, first, second, measured + voltage(second, cold), reference, low, high) _ -> cold_error(application) }
    }
    state cold_error(application: &mut Application) { Console::write_line("ERROR cold junction"); Console::exit_process(12); }
    state compensate(application: &mut Application, first: Segment, second: Segment, compensated: f64, reference: f64, low: f64, high: f64) {
        transition low < high && low >= first.low && high <= second.high {
            true -> invert(application, first, second, compensated, reference, low, high)
            _ -> bracket_error(application)
        }
    }
    state bracket_error(application: &mut Application) { Console::write_line("ERROR bracket"); Console::exit_process(13); }
    state invert(application: &mut Application, first: Segment, second: Segment, compensated: f64, reference: f64, low: f64, high: f64) {
        let estimate: Estimate = enumerate(first, second, compensated, low, high);
        field(&mut application.reader, "brackets=", F64::from_i32(estimate.count));
        transition estimate.count == 1 { true -> success(application, compensated, reference, estimate) _ -> no_unique(application, estimate.count) }
    }
    state no_unique(application: &mut Application, count: i32) {
        transition count == 0 { true -> absent(application) _ -> ambiguous(application) }
    }
    state absent(application: &mut Application) { Console::write_line("ERROR no root"); Console::exit_process(14); }
    state ambiguous(application: &mut Application) { Console::write_line("ERROR ambiguous"); Console::exit_process(15); }
    state success(application: &mut Application, compensated: f64, reference: f64, estimate: Estimate) {
        field(&mut application.reader, "temperature_mC=", estimate.temperature * 1000.0);
        field(&mut application.reader, "error_mC=", (estimate.temperature - reference) * 1000.0);
        field(&mut application.reader, "compensated_nV=", compensated * 1000000.0);
        field(&mut application.reader, "residual_nV=", estimate.residual * 1000000.0);
        Console::write_line("OK");
        Console::exit_process(0);
    }
}
