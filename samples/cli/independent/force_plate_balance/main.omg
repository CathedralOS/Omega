// Expected exit: 0.
use omega_language_std::console;
use domain::balance;
use input::frames;
use output::report;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("force_plate_balance positions_mm=(-200,-100),(200,-100),(200,100),(-200,100) support_mm=150,75");
    transition { _ -> next() }
    machine next() {
        let mut buffer: [u8; 256];
        let observed: LineReadResult = block Console::read_line(&mut buffer);
        transition observed {
            LineReadResult::LineComplete { count } -> line(&buffer, count, false)
            LineReadResult::EndOfInput { count } -> line(&buffer, count, true)
            LineReadResult::Full { count } -> oversized()
            _ -> failed()
        }
    }
    machine line(buffer: &[u8; 256], count: u64, final: bool) {
        transition count <= buffer.len {
            true -> bounded_line(buffer, count, final)
            _ -> failed()
        }
    }
    machine bounded_line(buffer: &[u8; 256], count: u64, final: bool)
    requires count <= buffer.len
    {
        transition final {
            true -> end(&buffer[..count], count)
            _ -> parse(&buffer[..count])
        }
    }
    machine parse(text: &[u8]) {
        let parsed: Parsed = parse_frame(text);
        transition parsed {
            Parsed::Valid { frame } -> balance(frame)
            _ -> malformed()
        }
    }
    machine balance(frame: Frame) {
        let result: Balance = reconcile(&frame);
        report(&frame, &result);
        transition { _ -> next() }
    }
    machine malformed() {
        Console::write_line("INVALID_SYNTAX expected seven signed integers <=1000000");
        transition { _ -> next() }
    }
    machine oversized() {
        Console::write_line("INVALID_LINE_TOO_LONG");
        transition { _ -> drain() }
    }
    machine drain() {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Byte { value } -> drain_byte(value)
            _ -> done()
        }
    }
    machine drain_byte(value: i32) {
        transition value == 10 { true -> next() _ -> drain() }
    }
    machine end(text: &[u8], count: u64) {
        transition count == 0 { true -> done() _ -> final_frame(text) }
    }
    machine final_frame(text: &[u8]) {
        let parsed: Parsed = parse_frame(text);
        transition parsed { Parsed::Valid { frame } -> final_balance(frame) _ -> final_invalid() }
    }
    machine final_balance(frame: Frame) {
        let result: Balance = reconcile(&frame);
        report(&frame, &result);
        transition { _ -> done() }
    }
    machine final_invalid() { Console::write_line("INVALID_SYNTAX expected seven signed integers <=1000000"); Console::exit_process(0); }
    machine done() { Console::exit_process(0); }
    machine failed() { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
