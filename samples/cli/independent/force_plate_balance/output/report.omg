use omega_language_std::console;
use domain::balance;
// Collect decimal digits privately, then emit them in reverse order. Ten
// digits cover every bounded application result; division precedes all I/O.
data Decimal { digits: [i32; 10]; }
pub machine number(value: i64 in Wrapping) reaches Console
invokes Console;
{
    transition value < 0 {
        true -> negative(value)
        _ -> positive(value)
    }
    state negative(value: i64 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> positive(0 - value) }
    }
    state positive(value: i64 in Wrapping) {
        let mut decimal: Decimal;
        transition { _ -> collect(decimal, value, 0) }
    }
    state collect(decimal: Decimal, value: i64 in Wrapping, count: u64) {
        transition count < 10 { true -> append(decimal, value, count) _ -> failed() }
    }
    state append(decimal: Decimal, value: i64 in Wrapping, count: u64)
    requires count < 10
    {
        let mut completed: Decimal = decimal;
        completed.digits[count] = (value % 10 + 48) as i32;
        let remaining: i64 in Wrapping = value / 10;
        transition remaining == 0 {
            true -> emit(completed, count + 1)
            _ -> collect(completed, remaining, count + 1)
        }
    }
    state emit(decimal: Decimal, count: u64) {
        transition count > 0 && count <= 10 { true -> byte(decimal, count) _ -> done() }
    }
    state byte(decimal: Decimal, count: u64)
    requires count > 0 && count <= 10
    {
        Console::write_byte(decimal.digits[count - 1]);
        transition { _ -> emit(decimal, count - 1) }
    }
    state done() { }
    state failed() { Console::exit_process(1); }
}
pub machine report(frame: &Frame, result: &Balance) reaches Console
invokes Console;
{
    Console::write("loads=");
    number(frame.values[0] as i64 in Wrapping); Console::write(",");
    number(frame.values[1] as i64 in Wrapping); Console::write(",");
    number(frame.values[2] as i64 in Wrapping); Console::write(",");
    number(frame.values[3] as i64 in Wrapping);
    Console::write(" force="); number(result.force);
    Console::write(" moments="); number(result.moment_x); Console::write(","); number(result.moment_y);
    Console::write(" residuals="); number(result.force_residual); Console::write(","); number(result.x_residual); Console::write(","); number(result.y_residual);
    transition result.force > 0 && result.status != 1 && result.status != 2 {
        true -> position(result)
        _ -> decision(result)
    }
    state position(result: &Balance) {
        Console::write(" cop_mm="); number(result.moment_x); Console::write("/"); number(result.force);
        Console::write(","); number(result.moment_y); Console::write("/"); number(result.force);
        transition { _ -> decision(result) }
    }
    state decision(result: &Balance) {
        transition result.status {
            0 -> label(" SUPPORTED")
            1 -> label(" INVALID_NEGATIVE_LOAD")
            2 -> label(" INVALID_SATURATED_CELL")
            3 -> label(" INVALID_ZERO_FORCE")
            4 -> label(" INVALID_EQUILIBRIUM")
            _ -> label(" OUTSIDE_SUPPORT")
        }
    }
    state label(text: &[u8]) { Console::write_line(text); }
}
