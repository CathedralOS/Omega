// All arithmetic is private to ADD01. Input magnitudes are capped at 1,000,000;
// loads at 1000 N. These bounds keep every product below 2^63, so Wrapping
// operations agree with mathematical integers. CoP remains an exact ratio.
public data Frame { values: [i64; 7]; }
// These are first moments Qx,Qy (N mm), not torque-axis components.
public data Balance {
    force: i64 in Wrapping;
    moment_x: i64 in Wrapping;
    moment_y: i64 in Wrapping;
    force_residual: i64 in Wrapping;
    x_residual: i64 in Wrapping;
    y_residual: i64 in Wrapping;
    status: i32;
}
public machine reconcile(frame: &Frame) -> Balance {
    let mut result: Balance;
    let a: i64 in Wrapping = frame.values[0] as i64 in Wrapping;
    let b: i64 in Wrapping = frame.values[1] as i64 in Wrapping;
    let c: i64 in Wrapping = frame.values[2] as i64 in Wrapping;
    let d: i64 in Wrapping = frame.values[3] as i64 in Wrapping;
    result.force = a + b + c + d;
    result.moment_x = (b + c - a - d) * 200;
    result.moment_y = (c + d - a - b) * 100;
    result.force_residual = result.force - (frame.values[4] as i64 in Wrapping);
    result.x_residual = result.moment_x - (frame.values[5] as i64 in Wrapping);
    result.y_residual = result.moment_y - (frame.values[6] as i64 in Wrapping);
    transition {
        a < 0 || b < 0 || c < 0 || d < 0 -> invalid(result, 1)
        a > 1000 || b > 1000 || c > 1000 || d > 1000 -> invalid(result, 2)
        result.force == 0 -> invalid(result, 3)
        result.force_residual != 0 || result.x_residual != 0 || result.y_residual != 0 -> invalid(result, 4)
        result.moment_x < 0 - result.force * 150 || result.moment_x > result.force * 150 || result.moment_y < 0 - result.force * 75 || result.moment_y > result.force * 75 -> invalid(result, 5)
        _ -> invalid(result, 0)
    }
    machine invalid(result: Balance, status: i32) -> Balance {
        let mut completed: Balance = result;
        completed.status = status;
        completed
    }
}
