use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

// A near-singular algebraic equilibrium can be far outside the output rails.
// Keep its microvolt presentation in i64 rather than silently clipping to i32.
pub machine voltage(value: f64)
invokes Console;
reaches Console {
    let scaled: i64 in Saturating = I64::from_f64(value * 1000000.0);
    integer64(scaled as i64);
}
pub machine integer(value: i32)
invokes Console;
reaches Console {
    integer64(widen_i32_to_i64(value));
}
machine integer64(value: i64)
invokes Console;
reaches Console {
    transition value < 0 {
        true -> negative(value)
        false -> positive(value)
    }
    state negative(value: i64) {
        Console::write("-");
        // Unsigned modular negation also handles the full signed minimum.
        let bits: u64 = narrow_i64_to_u64_wrapping(value);
        let magnitude: u64 in Wrapping = 0 - (bits as u64 in Wrapping);
        unsigned(magnitude as u64);
    }
    state positive(value: i64) {
        unsigned(narrow_i64_to_u64_wrapping(value));
    }
}
machine unsigned(value: u64)
invokes Console;
reaches Console {
    transition { _ -> digits(value, 10000000000000000000, false) }
    state digits(value: u64, divisor: u64, started: bool)
    requires divisor > 0
    {
        let digit: u64 = value / divisor % 10;
        transition started || digit != 0 || divisor == 1 {
            true -> emit(value, divisor, digit)
            false -> skip(value, divisor)
        }
    }
    state emit(value: u64, divisor: u64, digit: u64)
    requires divisor > 0
    {
        let byte: u64 in Wrapping = (digit as u64 in Wrapping) + 48;
        Console::write_byte(narrow_u64_to_i32_saturating(byte as u64));
        transition divisor >= 10 {
            true -> digits(value, divisor / 10, true)
            false -> done()
        }
    }
    state skip(value: u64, divisor: u64)
    requires divisor > 0
    {
        transition divisor >= 10 {
            true -> digits(value, divisor / 10, false)
            false -> done()
        }
    }
    state done() { }
}
