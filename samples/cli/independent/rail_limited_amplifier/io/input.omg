// Ten signed decimal integers, at most 10000 in magnitude, separated by
// ASCII spaces, tab, CR or LF. No exponent, partial token or numeric wrap.
use omega::language::core::numeric_conversion;
public data Inputs {
    values: [i32; 10];
    count: i32 in Wrapping;
    magnitude: i32 in Wrapping;
    negative: bool;
    started: bool;
    digits: bool;
    valid: bool;
}
public machine parse(bytes: &[u8]) -> Inputs {
    let mut input: Inputs;
    input.valid = true;
    transition { _ -> scan(bytes, 0, input) }
    machine scan(bytes: &[u8], index: u64, input: Inputs) -> Inputs {
        transition index < bytes.len {
            true -> character(bytes, index, input)
            false -> finish(input)
        }
    }
    machine character(bytes: &[u8], index: u64, input: Inputs) -> Inputs {
        let byte: i32 = widen_u8_to_i32(bytes[index]);
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> separator(bytes, index, input)
            false -> nonspace(bytes, index, input, byte)
        }
    }
    machine nonspace(bytes: &[u8], index: u64, input: Inputs, byte: i32) -> Inputs {
        transition byte == 45 && !input.started {
            true -> sign(bytes, index, input)
            false -> digit(bytes, index, input, byte)
        }
    }
    machine sign(bytes: &[u8], index: u64, input: Inputs) -> Inputs {
        let mut changed: Inputs = input;
        changed.negative = true;
        changed.started = true;
        transition { _ -> next(bytes, index, changed) }
    }
    machine digit(bytes: &[u8], index: u64, input: Inputs, byte: i32) -> Inputs {
        transition byte >= 48 && byte <= 57 {
            true -> accumulate(bytes, index, input, byte)
            false -> invalid(input)
        }
    }
    machine accumulate(bytes: &[u8], index: u64, input: Inputs, byte: i32) -> Inputs {
        let mut changed: Inputs = input;
        changed.magnitude = changed.magnitude * 10 + ((byte as i32 in Wrapping) - 48);
        changed.started = true;
        changed.digits = true;
        transition changed.magnitude <= 10000 {
            true -> next(bytes, index, changed)
            false -> invalid(changed)
        }
    }
    machine separator(bytes: &[u8], index: u64, input: Inputs) -> Inputs {
        let changed: Inputs = commit(input);
        transition changed.valid {
            true -> next(bytes, index, changed)
            false -> (changed)
        }
    }
    machine next(bytes: &[u8], index: u64, input: Inputs) -> Inputs {
        transition index < bytes.len {
            true -> scan(bytes, index + 1, input)
            false -> finish(input)
        }
    }
    machine finish(input: Inputs) -> Inputs {
        let mut changed: Inputs = commit(input);
        changed.valid = changed.valid && changed.count == 10;
        changed
    }
    machine invalid(input: Inputs) -> Inputs {
        let mut changed: Inputs = input;
        changed.valid = false;
        changed
    }
}
machine commit(input: Inputs) -> Inputs {
    transition input.started {
        false -> (input)
        true -> check(input)
    }
    machine check(input: Inputs) -> Inputs {
        transition input.digits && input.count >= 0 && input.count < 10 {
            true -> store(input)
            false -> invalid(input)
        }
    }
    machine store(input: Inputs) -> Inputs {
        let mut changed: Inputs = input;
        let slot: i32 = changed.count as i32;
        let value: i32 in Wrapping = match changed.negative {
            true -> (0 - changed.magnitude)
            false -> (changed.magnitude)
        };
        changed.values[slot] = value as i32;
        changed.count = changed.count + 1;
        changed.magnitude = 0;
        changed.negative = false;
        changed.started = false;
        changed.digits = false;
        changed
    }
    machine invalid(input: Inputs) -> Inputs {
        let mut changed: Inputs = input;
        changed.valid = false;
        changed
    }
}
