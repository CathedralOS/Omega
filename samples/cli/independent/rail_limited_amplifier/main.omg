// NEW034: runtime-configured discrete rail-limited feedback amplifier.
// Only this project owns its model, bounded parser and report implementation.
use omega_language_std::console;
use omega::language::core::float_operations;
use domain::model;
use io::input;
use io::output;

data Main {
    bytes: [u8; 192];
    input: Inputs;
    circuit: Circuit;
    equilibrium: Equilibrium;
    previous: f64;
    observed: Observation;
    first_drive: f64;
    final_drive: f64;
    drive: f64;
    switch_step: i32;
    steps: i32;
    step: i32 in Wrapping;
    last_bad: i32 in Wrapping;
    overload_count: i32 in Wrapping;
    first_recovered: i32;
}
machine Main::main(main: &mut Main) reaches Console {
    let read: LineReadResult = block Console::read_line(&mut main.bytes);
    transition read {
        LineReadResult::LineComplete { count } -> received(main, count)
        LineReadResult::EndOfInput { count } -> received(main, count)
        _ -> syntax(main)
    }
    state received(main: &mut Main, count: u64) {
        transition count <= 192 {
            true -> parse_line(main, count)
            false -> syntax(main)
        }
    }
    state parse_line(main: &mut Main, count: u64) {
        main.input = parse(main.bytes[..count]);
        transition main.input.valid {
            true -> rails(main)
            false -> syntax(main)
        }
    }
    state rails(main: &mut Main) {
        transition main.input.values[3] < main.input.values[4] {
            true -> parameters(main)
            false -> bad_rails(main)
        }
    }
    state parameters(main: &mut Main) {
        transition main.input.values[0] >= 1 && main.input.values[0] <= 100
            && main.input.values[1] >= -1000 && main.input.values[1] <= 1000
            && main.input.values[2] >= 1 && main.input.values[2] <= 1000
            && main.input.values[7] >= 0 && main.input.values[7] <= main.input.values[8]
            && main.input.values[8] >= 1 && main.input.values[8] <= 64
            && main.input.values[9] >= main.input.values[3] && main.input.values[9] <= main.input.values[4] {
            true -> initialize(main)
            false -> bad_parameters(main)
        }
    }
    state initialize(main: &mut Main) {
        main.circuit.gain = main.input.values[0] as f64;
        main.circuit.feedback = (main.input.values[1] as f64) / 1000.0;
        main.circuit.relaxation = (main.input.values[2] as f64) / 1000.0;
        main.circuit.lower = (main.input.values[3] as f64) / 1000.0;
        main.circuit.upper = (main.input.values[4] as f64) / 1000.0;
        main.first_drive = (main.input.values[5] as f64) / 1000.0;
        main.final_drive = (main.input.values[6] as f64) / 1000.0;
        main.switch_step = main.input.values[7];
        main.steps = main.input.values[8];
        main.previous = (main.input.values[9] as f64) / 1000.0;
        main.step = 0;
        main.last_bad = -1;
        main.first_recovered = -1;
        main.overload_count = 0;
        main.equilibrium = equilibria(main.circuit, main.first_drive);
        Console::write_line("rail_limited_amplifier v1; voltage=uv; q=ppm");
        Main::equilibrium_row(main, 0);
        main.equilibrium = equilibria(main.circuit, main.final_drive);
        Main::equilibrium_row(main, 1);
        main.drive = main.first_drive;
        main.observed.output = main.previous;
        main.observed.feedback = main.circuit.feedback * main.previous;
        main.observed.raw = main.previous;
        main.observed.overload = 0;
        Main::trace_row(main);
        Main::measure(main);
        transition { _ -> loop(main) }
    }
    state loop(main: &mut Main) {
        transition main.step < main.steps {
            true -> tick(main)
            false -> finish(main)
        }
    }
    state tick(main: &mut Main) {
        main.step = main.step + 1;
        main.drive = match main.step <= main.switch_step {
            true -> (main.first_drive)
            false -> (main.final_drive)
        };
        main.observed = advance(main.circuit, main.drive, main.previous);
        main.previous = main.observed.output;
        Main::trace_row(main);
        Main::measure(main);
        transition { _ -> loop(main) }
    }
    state finish(main: &mut Main) {
        let settled: i32 in Wrapping = match main.equilibrium.unique && main.equilibrium.stable && main.last_bad < main.steps {
            true -> (main.last_bad + 1)
            false -> (-1)
        };
        Console::write("M,");
        integer(settled as i32);
        Console::write(",");
        integer(main.overload_count as i32);
        Console::write(",");
        integer(main.first_recovered);
        Console::write_line("");
        Console::exit_process(0);
    }
    state syntax(main: &mut Main) {
        Console::write_line("ERROR syntax: expected ten bounded signed integers");
        Console::exit_process(64);
    }
    state bad_rails(main: &mut Main) {
        Console::write_line("ERROR rails: lower must be less than upper");
        Console::exit_process(64);
    }
    state bad_parameters(main: &mut Main) {
        Console::write_line("ERROR parameters: gain, feedback, relaxation, steps or initial output outside bounds");
        Console::exit_process(64);
    }
}
machine Main::equilibrium_row(main: &mut Main, phase: i32) reaches Console {
    Console::write("E,");
    integer(phase);
    Console::write(",");
    let lower_exists: bool = main.equilibrium.lower_exists;
    Main::flag(main, lower_exists);
    let interior_exists: bool = main.equilibrium.interior_exists;
    Main::flag(main, interior_exists);
    let upper_exists: bool = main.equilibrium.upper_exists;
    Main::flag(main, upper_exists);
    let continuum: bool = main.equilibrium.continuum;
    Main::flag(main, continuum);
    voltage(main.equilibrium.interior);
    Console::write(",");
    voltage(main.equilibrium.multiplier);
    Console::write(",");
    integer(match main.equilibrium.stable { true -> (1) false -> (0) });
    Console::write_line("");
}
machine Main::flag(main: &mut Main, flag: bool) reaches Console {
    integer(match flag { true -> (1) false -> (0) });
    Console::write(",");
}
machine Main::trace_row(main: &mut Main) reaches Console {
    Console::write("T,");
    integer(main.step as i32);
    Console::write(",");
    voltage(main.drive);
    Console::write(",");
    voltage(main.observed.output);
    Console::write(",");
    voltage(main.observed.feedback);
    Console::write(",");
    voltage(main.observed.raw);
    Console::write(",");
    integer(main.observed.overload);
    Console::write_line("");
}
machine Main::measure(main: &mut Main) {
    transition main.observed.overload != 0 {
        true -> overload(main)
        false -> recovery(main)
    }
    state overload(main: &mut Main) {
        main.overload_count = main.overload_count + 1;
        transition { _ -> settling(main) }
    }
    state recovery(main: &mut Main) {
        transition main.step > main.switch_step && main.first_recovered == -1 {
            true -> recovered(main)
            false -> settling(main)
        }
    }
    state recovered(main: &mut Main) {
        main.first_recovered = main.step as i32;
        transition { _ -> settling(main) }
    }
    state settling(main: &mut Main) {
        transition main.step >= main.switch_step {
            true -> error(main)
            false -> before(main)
        }
    }
    state before(main: &mut Main) { main.last_bad = main.step; }
    state error(main: &mut Main) {
        let difference: f64 = main.observed.output - main.equilibrium.selected;
        transition difference < -0.001 || difference > 0.001 {
            true -> outside(main)
            false -> done()
        }
    }
    state outside(main: &mut Main) { main.last_bad = main.step; }
    state done() { }
}
