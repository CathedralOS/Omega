use omega_language_std::console;
use io::input;
use omega::language::core::binding;
pub data Settings {
    width: i64 in Wrapping;
    signedness: i64 in Wrapping;
    reference_low: i64 in Wrapping;
    reference_high: i64 in Wrapping;
    raw_low: i64 in Wrapping;
    raw_high: i64 in Wrapping;
    physical_low: i64 in Wrapping;
    physical_high: i64 in Wrapping;
    rounding: i64 in Wrapping;
    count: i64 in Wrapping;
}
pub machine settings(console: &Binding<Console>, configuration: &mut Settings) -> bool reaches Console
invokes console;
blocks;
crashes Trap
{
    configuration.width = block number(console);
    configuration.signedness = block number(console);
    configuration.reference_low = block number(console);
    configuration.reference_high = block number(console);
    configuration.raw_low = block number(console);
    configuration.raw_high = block number(console);
    configuration.physical_low = block number(console);
    configuration.physical_high = block number(console);
    configuration.rounding = block number(console);
    configuration.count = block number(console);
    transition configuration.width >= 2 && configuration.width <= 8 &&
        configuration.signedness >= 0 && configuration.signedness <= 1 &&
        configuration.rounding == 0 && configuration.count >= 1 && configuration.count <= 32 &&
        configuration.reference_low >= -1000 && configuration.reference_high <= 1000 &&
        configuration.reference_low < configuration.reference_high &&
        configuration.raw_low >= -1000 && configuration.raw_high <= 1000 &&
        configuration.raw_low < configuration.raw_high &&
        configuration.physical_low >= -1000 && configuration.physical_high <= 1000 &&
        configuration.physical_low < configuration.physical_high {
        true -> (true)
        _ -> (false)
    }
}
