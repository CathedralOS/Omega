// Exact rational two-point calibration, then endpoint-inclusive quantization.
// Bounded inputs keep every i64 Wrapping intermediate below 10^12: the policy
// makes arithmetic defined, while the application envelope prevents wrapping.
use domain::settings;
public data Conversion {
    code: i64 in Wrapping;
    reconstruction_numerator: i64 in Wrapping;
    reconstruction_denominator: i64 in Wrapping;
    clipped: i64 in Wrapping;
    error_numerator: i64 in Wrapping;
    error_denominator: i64 in Wrapping;
    bound_numerator: i64 in Wrapping;
    bound_denominator: i64 in Wrapping;
}
public machine quantize(configuration: &Settings, raw: i64 in Wrapping, result: &mut Conversion) {
    transition { _ -> levels(configuration, raw, result, 0, 1) }
    machine levels(configuration: &Settings, raw: i64 in Wrapping, result: &mut Conversion, bit: i64 in Wrapping, extent: i64 in Wrapping) {
        transition bit < configuration.width {
            true -> levels(configuration, raw, result, bit + 1, extent * 2)
            _ -> calibrate(configuration, raw, result, extent - 1, extent / 2)
        }
    }
    machine calibrate(configuration: &Settings, raw: i64 in Wrapping, result: &mut Conversion, levels: i64 in Wrapping, half: i64 in Wrapping) {
        let denominator: i64 in Wrapping = configuration.raw_high - configuration.raw_low;
        let calibrated: i64 in Wrapping = configuration.physical_low * denominator +
            (raw - configuration.raw_low) * (configuration.physical_high - configuration.physical_low);
        let range: i64 in Wrapping = configuration.reference_high - configuration.reference_low;
        let coordinate: i64 in Wrapping = calibrated - configuration.reference_low * denominator;
        let span: i64 in Wrapping = range * denominator;
        transition coordinate < 0 {
            true -> reconstruct(configuration, result, levels, half, calibrated, denominator, 0, -1)
            _ -> high(configuration, result, levels, half, calibrated, denominator, coordinate, span)
        }
    }
    machine high(configuration: &Settings, result: &mut Conversion, levels: i64 in Wrapping, half: i64 in Wrapping, calibrated: i64 in Wrapping, denominator: i64 in Wrapping, coordinate: i64 in Wrapping, span: i64 in Wrapping) {
        transition coordinate > span {
            true -> reconstruct(configuration, result, levels, half, calibrated, denominator, levels, 1)
            _ -> divide(configuration, result, levels, half, calibrated, denominator, coordinate, span)
        }
    }
    machine divide(configuration: &Settings, result: &mut Conversion, levels: i64 in Wrapping, half: i64 in Wrapping, calibrated: i64 in Wrapping, denominator: i64 in Wrapping, coordinate: i64 in Wrapping, span: i64 in Wrapping) {
        transition span > 0 {
            true -> round(configuration, result, levels, half, calibrated, denominator, coordinate, span)
            _ -> invalid()
        }
    }
    machine round(configuration: &Settings, result: &mut Conversion, levels: i64 in Wrapping, half: i64 in Wrapping, calibrated: i64 in Wrapping, denominator: i64 in Wrapping, coordinate: i64 in Wrapping, span: i64 in Wrapping)
    requires span > 0
    {
        let scaled: i64 in Wrapping = coordinate * levels;
        let lower: i64 in Wrapping = scaled / span;
        let remainder: i64 in Wrapping = scaled % span;
        transition remainder * 2 > span || (remainder * 2 == span && lower % 2 != 0) {
            true -> reconstruct(configuration, result, levels, half, calibrated, denominator, lower + 1, 0)
            _ -> reconstruct(configuration, result, levels, half, calibrated, denominator, lower, 0)
        }
    }
    machine reconstruct(configuration: &Settings, result: &mut Conversion, levels: i64 in Wrapping, half: i64 in Wrapping, calibrated: i64 in Wrapping, denominator: i64 in Wrapping, rank: i64 in Wrapping, clipped: i64 in Wrapping) {
        result.code = rank - configuration.signedness * half;
        result.reconstruction_numerator = configuration.reference_low * levels + rank * (configuration.reference_high - configuration.reference_low);
        result.reconstruction_denominator = levels;
        result.clipped = clipped;
        result.error_numerator = result.reconstruction_numerator * denominator - calibrated * levels;
        result.error_denominator = levels * denominator;
        // For clipped readings include overrange distance plus half a step.
        transition clipped == 0 {
            true -> bound(configuration, result, levels, denominator, 0)
            _ -> magnitude(configuration, result, levels, denominator)
        }
    }
    machine magnitude(configuration: &Settings, result: &mut Conversion, levels: i64 in Wrapping, denominator: i64 in Wrapping) {
        let error: i64 in Wrapping = result.error_numerator;
        transition error < 0 {
            true -> bound(configuration, result, levels, denominator, 0 - error)
            _ -> bound(configuration, result, levels, denominator, error)
        }
    }
    machine bound(configuration: &Settings, result: &mut Conversion, levels: i64 in Wrapping, denominator: i64 in Wrapping, overrange: i64 in Wrapping) {
        result.bound_numerator = (configuration.reference_high - configuration.reference_low) * denominator + 2 * overrange;
        result.bound_denominator = 2 * levels * denominator;
    }
    machine invalid() { }
}
