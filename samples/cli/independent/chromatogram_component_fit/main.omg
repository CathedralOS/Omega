// Complete bounded input -> private NNLS fit -> numeric report application.
// Expected exit: 2.
// Expected output contains: error=input:
use omega_language_std::console;
use domain::model;
use domain::input;
use domain::fit;
use domain::report;

data Main { reader: InputReader; }
machine Main::main(main: &mut Main) reaches Console {
    main.reader.remaining = 512;
    main.reader.exhausted = false;
    let mut chromatogram: Chromatogram;
    let valid: bool = block read_input(&mut main.reader, &mut chromatogram);
    transition valid {
        true -> fit(main, &chromatogram)
        _ -> invalid(main)
    }
    state fit(main: &mut Main, chromatogram: &Chromatogram) {
        let mut result: Fit;
        let valid: bool = fit_components(chromatogram, &mut result);
        transition valid {
            true -> output(main, &result)
            _ -> invalid_profile(main)
        }
    }
    state output(main: &mut Main, result: &Fit) {
        report(result);
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) {
        Console::write_line("error=input: require exactly 15 signed integer tokens, magnitude <=1000, nonnegative profiles, <=512 bytes");
        Console::exit_process(2);
    }
    state invalid_profile(main: &mut Main) {
        Console::write_line("error=profile: each supplied component must have nonzero norm");
        Console::exit_process(3);
    }
}
