use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;
use domain::model;

// Fixed six-decimal reporting; bounded input makes all scaled values fit i64.
// Round magnitude half upward and retain the sign separately.
machine number(value: f64) reaches Console {
    let mut bytes: [u8; 21] = "+0000000000000.000000";
    transition value < 0.0 {
        true -> negative(&mut bytes, value)
        _ -> positive(&mut bytes, value)
    }
    machine negative(bytes: &mut [u8; 21], value: f64) {
        bytes[0] = 45;
        let scaled: i64 in Saturating = I64::from_f64((0.0 - value) * 1000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as i64 in Wrapping, 20) }
    }
    machine positive(bytes: &mut [u8; 21], value: f64) {
        let scaled: i64 in Saturating = I64::from_f64(value * 1000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as i64 in Wrapping, 20) }
    }
    machine digits(bytes: &mut [u8; 21],
                 remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position > 0 && position < 21 {
            true -> separator(bytes, remaining, position)
            _ -> emit(bytes)
        }
    }
    machine separator(bytes: &mut [u8; 21],
                    remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position == 14 {
            true -> digits(bytes, remaining, position - 1)
            _ -> store(bytes, remaining, position)
        }
    }
    machine store(bytes: &mut [u8; 21],
                remaining: i64 in Wrapping, position: i32 in Wrapping) {
        let digit: i32 = narrow_i64_to_i32_trapping((remaining % 10 + 48) as i64);
        bytes[position] = narrow_i32_to_u8_trapping(digit);
        transition { _ -> digits(bytes, remaining / 10, position - 1) }
    }
    machine emit(bytes: &[u8; 21]) { Console::write_line(bytes); }
}
public machine report(fit: &Fit) reaches Console
invokes Console;
crashes Trap
{
    Console::write_line("chromatogram_component_fit synthetic unit-spacing NNLS");
    transition fit.nonidentifiable {
        true -> ambiguous(fit)
        _ -> identified(fit)
    }
    machine ambiguous(fit: &Fit) {
        Console::write_line("nonidentifiable=true");
        transition { _ -> mask(fit) }
    }
    machine identified(fit: &Fit) {
        Console::write_line("nonidentifiable=false");
        transition { _ -> mask(fit) }
    }
    machine mask(fit: &Fit) {
        Console::write("mask=");
        let code: i32 in Wrapping = fit.mask as i32 in Wrapping;
        Console::write_byte((code + 48) as i32);
        Console::write_line("");
        Console::write("a_amount="); number(fit.amount_a);
        Console::write("b_amount="); number(fit.amount_b);
        Console::write("a_area="); number(fit.area_a);
        Console::write("b_area="); number(fit.area_b);
        Console::write("sse="); number(fit.sse);
        transition { _ -> samples(fit, 0) }
    }
    machine samples(fit: &Fit, index: i32 in Wrapping) {
        transition index >= 0 && index < 5 {
            true -> sample(fit, index)
            _ -> done()
        }
    }
    machine sample(fit: &Fit, index: i32 in Wrapping) {
        Console::write("reconstruction_"); Console::write_byte((index + 48) as i32); Console::write("=");
        number(fit.reconstruction[index]);
        Console::write("residual_"); Console::write_byte((index + 48) as i32); Console::write("=");
        number(fit.residual[index]);
        transition { _ -> samples(fit, index + 1) }
    }
    machine done() { Console::write_line("status=ok"); }
}
