use omega_language_std::console;
use omega::language::core::float_operations;
use domain::model;

pub data InputReader {
    remaining: i32 in Wrapping;
    exhausted: bool;
}
data Token {
    case Invalid;
    case End;
    case Number(value: i32);
}
// A 512-byte budget includes trailing whitespace. Budget exhaustion is an
// input error, distinct from the real EOF required after exactly 15 tokens.
machine next_byte(reader: &mut InputReader) -> ByteRead reaches Console
invokes Console;
blocks;
crashes Trap
{
    let byte: ByteRead = block Console::read_byte();
    transition byte {
        ByteRead::Eof -> ByteRead::Eof
        ByteRead::Byte { value } -> capacity(reader, value)
    }
    state capacity(reader: &mut InputReader, value: i32) -> ByteRead
    requires value >= 0 && value <= 255
    {
        transition reader.remaining > 0 {
            true -> consume(reader, value)
            _ -> limit(reader)
        }
    }
    state consume(reader: &mut InputReader, value: i32) -> ByteRead
    requires value >= 0 && value <= 255
    {
        reader.remaining = reader.remaining - 1;
        ByteRead::Byte { value: value }
    }
    state limit(reader: &mut InputReader) -> ByteRead {
        reader.exhausted = true;
        ByteRead::Eof
    }
}
machine token(reader: &mut InputReader) -> Token reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> skip(reader) }
    state skip(reader: &mut InputReader) -> Token {
        let byte: ByteRead = block next_byte(reader);
        transition byte {
            ByteRead::Eof -> Token::End
            ByteRead::Byte { value } -> first(reader, value)
        }
    }
    state first(reader: &mut InputReader, byte: i32) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> skip(reader)
            _ -> sign(reader, byte)
        }
    }
    state sign(reader: &mut InputReader, byte: i32) -> Token {
        transition byte == 45 {
            true -> next(reader, 0, 0, true)
            _ -> digit(reader, byte, 0, 0, false)
        }
    }
    state digit(reader: &mut InputReader, byte: i32, magnitude: i32 in Wrapping,
                digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte >= 48 && byte <= 57 && digits < 4 {
            true -> accumulate(reader, byte, magnitude, digits, negative)
            _ -> Token::Invalid
        }
    }
    state accumulate(reader: &mut InputReader, byte: i32, magnitude: i32 in Wrapping,
                     digits: i32 in Wrapping, negative: bool) -> Token {
        let updated: i32 in Wrapping = magnitude * 10 + (byte as i32 in Wrapping) - 48;
        transition updated <= 1000 {
            true -> next(reader, updated, digits + 1, negative)
            _ -> Token::Invalid
        }
    }
    state next(reader: &mut InputReader, magnitude: i32 in Wrapping,
               digits: i32 in Wrapping, negative: bool) -> Token {
        let byte: ByteRead = block next_byte(reader);
        transition byte {
            ByteRead::Eof -> finish(magnitude, digits, negative)
            ByteRead::Byte { value } -> delimiter(reader, value, magnitude, digits, negative)
        }
    }
    state delimiter(reader: &mut InputReader, byte: i32, magnitude: i32 in Wrapping,
                    digits: i32 in Wrapping, negative: bool) -> Token {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> finish(magnitude, digits, negative)
            _ -> digit(reader, byte, magnitude, digits, negative)
        }
    }
    state finish(magnitude: i32 in Wrapping, digits: i32 in Wrapping, negative: bool) -> Token {
        transition digits > 0 {
            true -> signed_value(magnitude, negative)
            _ -> Token::Invalid
        }
    }
    state signed_value(magnitude: i32 in Wrapping, negative: bool) -> Token {
        transition negative {
            true -> Token::Number { value: (0 - magnitude) as i32 }
            _ -> Token::Number { value: magnitude as i32 }
        }
    }
}
pub machine read_input(reader: &mut InputReader, chromatogram: &mut Chromatogram) -> bool reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> scan(reader, chromatogram, 0) }
    state scan(reader: &mut InputReader, chromatogram: &mut Chromatogram,
               position: i32 in Wrapping) -> bool {
        let item: Token = block token(reader);
        transition item {
            Token::Number { value } -> validate(reader, chromatogram, position, value)
            Token::End -> (position == 15 && !reader.exhausted)
            _ -> false
        }
    }
    state validate(reader: &mut InputReader, chromatogram: &mut Chromatogram,
                   position: i32 in Wrapping, value: i32) -> bool {
        transition position >= 0 && position < 15 && (position >= 10 || value >= 0) {
            true -> select(reader, chromatogram, position, F64::from_i32(value))
            _ -> false
        }
    }
    state select(reader: &mut InputReader, chromatogram: &mut Chromatogram,
                 position: i32 in Wrapping, value: f64) -> bool {
        transition position >= 0 && position < 5 {
            true -> a(reader, chromatogram, position, value)
            _ -> select_b(reader, chromatogram, position, value, position - 5)
        }
    }
    state a(reader: &mut InputReader, chromatogram: &mut Chromatogram,
            position: i32 in Wrapping, value: f64) -> bool {
        chromatogram.profile_a[position] = value;
        transition { _ -> scan(reader, chromatogram, position + 1) }
    }
    state select_b(reader: &mut InputReader, chromatogram: &mut Chromatogram,
                   position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 5 {
            true -> b(reader, chromatogram, position, value, index)
            _ -> select_y(reader, chromatogram, position, value, position - 10)
        }
    }
    state b(reader: &mut InputReader, chromatogram: &mut Chromatogram,
            position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        chromatogram.profile_b[index] = value;
        transition { _ -> scan(reader, chromatogram, position + 1) }
    }
    state select_y(reader: &mut InputReader, chromatogram: &mut Chromatogram,
                   position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 5 {
            true -> y(reader, chromatogram, position, value, index)
            _ -> false
        }
    }
    state y(reader: &mut InputReader, chromatogram: &mut Chromatogram,
            position: i32 in Wrapping, value: f64, index: i32 in Wrapping) -> bool {
        chromatogram.observed[index] = value;
        transition { _ -> scan(reader, chromatogram, position + 1) }
    }
}
