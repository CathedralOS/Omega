// A synthetic two-component linear detector model on five unit-spaced times.
// Profiles are supplied, never estimated; negative observations represent
// baseline subtraction. Fixed storage bounds the scientific problem itself.
public data Chromatogram {
    profile_a: [f64; 5];
    profile_b: [f64; 5];
    observed: [f64; 5];
}
public data Fit {
    amount_a: f64;
    amount_b: f64;
    area_a: f64;
    area_b: f64;
    reconstruction: [f64; 5];
    residual: [f64; 5];
    sse: f64;
    mask: i32;
    nonidentifiable: bool;
}
