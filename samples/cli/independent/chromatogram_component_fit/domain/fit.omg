use omega::language::core::float_operations;
use domain::model;

// Private normal equations. Exact KKT signs select the admissible active set;
// its error is scored against actual reconstructed samples.
data Moments { aa: f64; ab: f64; bb: f64; ay: f64; by: f64; }
machine moments(chromatogram: &Chromatogram, sums: &mut Moments) {
    sums.aa = 0.0; sums.ab = 0.0; sums.bb = 0.0; sums.ay = 0.0; sums.by = 0.0;
    transition { _ -> scan(chromatogram, sums, 0) }
    machine scan(chromatogram: &Chromatogram, sums: &mut Moments, index: i32 in Wrapping) {
        transition index >= 0 && index < 5 {
            true -> add(chromatogram, sums, index)
            _ -> done()
        }
    }
    machine add(chromatogram: &Chromatogram, sums: &mut Moments, index: i32 in Wrapping) {
        let a: f64 = chromatogram.profile_a[index];
        let b: f64 = chromatogram.profile_b[index];
        let y: f64 = chromatogram.observed[index];
        sums.aa = sums.aa + a * a;
        sums.ab = sums.ab + a * b;
        sums.bb = sums.bb + b * b;
        sums.ay = sums.ay + a * y;
        sums.by = sums.by + b * y;
        transition { _ -> scan(chromatogram, sums, index + 1) }
    }
    machine done() { }
}
machine squared_error(chromatogram: &Chromatogram, a: f64, b: f64) -> f64 {
    transition { _ -> scan(chromatogram, a, b, 0, 0.0) }
    machine scan(chromatogram: &Chromatogram, a: f64, b: f64,
               index: i32 in Wrapping, sum: f64) -> f64 {
        transition index >= 0 && index < 5 {
            true -> add(chromatogram, a, b, index, sum)
            _ -> sum
        }
    }
    machine add(chromatogram: &Chromatogram, a: f64, b: f64,
              index: i32 in Wrapping, sum: f64) -> f64 {
        let predicted: f64 = a * chromatogram.profile_a[index] + b * chromatogram.profile_b[index];
        let residual: f64 = chromatogram.observed[index] - predicted;
        transition { _ -> scan(chromatogram, a, b, index + 1, sum + residual * residual) }
    }
}
machine consider(chromatogram: &Chromatogram, fit: &mut Fit, mask: i32, a: f64, b: f64, eligible: bool) {
    transition eligible && a >= 0.0 && b >= 0.0
        && ((mask == 1 && a > 0.0) || (mask == 2 && b > 0.0) || (mask == 3 && a > 0.0 && b > 0.0)) {
        true -> evaluate(chromatogram, fit, mask, a, b)
        _ -> done()
    }
    machine evaluate(chromatogram: &Chromatogram, fit: &mut Fit, mask: i32, a: f64, b: f64) {
        let sse: f64 = squared_error(chromatogram, a, b);
        fit.amount_a = a; fit.amount_b = b; fit.mask = mask; fit.sse = sse;
    }
    machine done() { }
}
machine finish_fit(chromatogram: &Chromatogram, fit: &mut Fit) {
    fit.area_a = fit.amount_a * (0.5 * (chromatogram.profile_a[0] + chromatogram.profile_a[4])
        + chromatogram.profile_a[1] + chromatogram.profile_a[2] + chromatogram.profile_a[3]);
    fit.area_b = fit.amount_b * (0.5 * (chromatogram.profile_b[0] + chromatogram.profile_b[4])
        + chromatogram.profile_b[1] + chromatogram.profile_b[2] + chromatogram.profile_b[3]);
    transition { _ -> scan(chromatogram, fit, 0) }
    machine scan(chromatogram: &Chromatogram, fit: &mut Fit, index: i32 in Wrapping) {
        transition index >= 0 && index < 5 {
            true -> write(chromatogram, fit, index)
            _ -> done()
        }
    }
    machine write(chromatogram: &Chromatogram, fit: &mut Fit, index: i32 in Wrapping) {
        let value: f64 = fit.amount_a * chromatogram.profile_a[index] + fit.amount_b * chromatogram.profile_b[index];
        fit.reconstruction[index] = value;
        fit.residual[index] = chromatogram.observed[index] - value;
        transition { _ -> scan(chromatogram, fit, index + 1) }
    }
    machine done() { }
}
public machine fit_components(chromatogram: &Chromatogram, fit: &mut Fit) -> bool {
    let mut sums: Moments;
    moments(chromatogram, &mut sums);
    transition sums.aa > 0.0 && sums.bb > 0.0 {
        true -> enumerate(chromatogram, fit, &sums)
        _ -> false
    }
    machine enumerate(chromatogram: &Chromatogram, fit: &mut Fit, sums: &Moments) -> bool {
        fit.amount_a = 0.0; fit.amount_b = 0.0; fit.mask = 0;
        fit.sse = squared_error(chromatogram, 0.0, 0.0);
        let numerator_b: f64 = sums.by * sums.aa - sums.ay * sums.ab;
        consider(chromatogram, fit, 1, sums.ay / sums.aa, 0.0, numerator_b <= 0.0);
        let determinant: f64 = sums.aa * sums.bb - sums.ab * sums.ab;
        // Integer inputs bound every Gram product below 2^53. The
        // determinant is therefore an exact integer, even near collinearity.
        transition determinant > 0.0 {
            true -> full(chromatogram, fit, sums, determinant)
            _ -> ambiguous(chromatogram, fit)
        }
    }
    machine full(chromatogram: &Chromatogram, fit: &mut Fit, sums: &Moments, determinant: f64) -> bool {
        fit.nonidentifiable = false;
        let numerator_a: f64 = sums.ay * sums.bb - sums.by * sums.ab;
        let numerator_b: f64 = sums.by * sums.aa - sums.ay * sums.ab;
        consider(chromatogram, fit, 2, 0.0, sums.by / sums.bb, numerator_a <= 0.0);
        let a: f64 = numerator_a / determinant;
        let b: f64 = numerator_b / determinant;
        consider(chromatogram, fit, 3, a, b, true);
        finish_fit(chromatogram, fit);
        true
    }
    machine ambiguous(chromatogram: &Chromatogram, fit: &mut Fit) -> bool {
        // Proportional profiles span the same ray. A alone is the earliest
        // nonempty representative; avoid roundoff deciding an exact A/B tie.
        fit.nonidentifiable = true;
        finish_fit(chromatogram, fit);
        true
    }
}
