// Complete source control: an unconditional read at the array's exclusive end.
// Ordinary documented bounds rule requires index < length, hence index 5 for
// five detector bins must be rejected. Not a syntax or dependency failure.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let samples: [i32; 5] = [0, 2, 7, 8, 3];
    let impossible: i32 = samples[5];
    Console::exit_process(impossible);
}
