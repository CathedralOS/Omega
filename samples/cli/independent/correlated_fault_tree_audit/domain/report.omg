use omega_language_std::console;

// Emit decimal digits through the standard byte writer. No fabricated UTF-8
// domain or host-side formatter is required. All callers pass nonnegative sums.
pub machine number(value: i32) reaches Console
invokes Console;
{
    transition { _ -> scale(value, value, 1) }
    state scale(value: i32,
                remaining: i32, place: i32 in Wrapping) {
        transition remaining >= 10 {
            true -> grow(value, remaining, place)
            _ -> emit(value, place)
        }
    }
    state grow(value: i32,
               remaining: i32, place: i32 in Wrapping) {
        // An i32 has at most ten decimal digits, so place never exceeds 10^9.
        transition { _ -> scale(value, remaining / 10, place * 10) }
    }
    state emit(value: i32, place: i32 in Wrapping) {
        transition place > 0 {
            true -> digit(value, place)
            _ -> done()
        }
    }
    state digit(value: i32, place: i32 in Wrapping)
    requires place > 0 {
        Console::write_byte((((value as i32 in Wrapping) / place) + 48) as i32);
        transition place > 1 {
            true -> rest(value, place)
            _ -> done()
        }
    }
    state rest(value: i32, place: i32 in Wrapping)
    requires place > 1 {
        transition { _ -> emit(((value as i32 in Wrapping) % place) as i32, place / 10) }
    }
    state done() { }
}
