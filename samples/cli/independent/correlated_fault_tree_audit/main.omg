// Declared synthetic instrument model: A sensor fault, B power fault,
// C shared environmental cause. Input contains complete joint weights.
use omega_language_std::console;
use omega::language::core::binding;
use domain::logic;
use domain::report;

data Main {
    console: Binding<Console>;
    input: [i32; 13];
    terms: [i32; 4];
    token: i32 in Wrapping;
    digits: i32;
    position: i32;
    bytes: i32;
    index: i32;
    total: i32 in Wrapping;
    failure: i32 in Wrapping;
    repaired: i32 in Wrapping;
    forced: i32 in Wrapping;
    marginal: i32 in Wrapping;
    event: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> read(main) }
    state read(main: &mut Main) reaches Console {
        transition main.bytes >= 0 && main.bytes < 256 {
            true -> byte(main)
            _ -> invalid(main)
        }
    }
    state byte(main: &mut Main) reaches Console
    requires main.bytes >= 0 && main.bytes < 256 {
        main.bytes = main.bytes + 1;
        let observed: ByteRead = block main.console.read_byte();
        transition observed {
            ByteRead::Eof -> end(main)
            ByteRead::Byte { value } -> classify(main, value)
        }
    }
    state classify(main: &mut Main, value: i32) reaches Console {
        transition value >= 48 && value <= 57 {
            true -> digit(main, value)
            _ -> separator(main, value)
        }
    }
    state digit(main: &mut Main, value: i32) reaches Console {
        transition main.digits >= 0 && main.digits < 7 {
            true -> accumulate(main, value)
            _ -> invalid(main)
        }
    }
    state accumulate(main: &mut Main, value: i32) reaches Console
    requires main.digits >= 0 && main.digits < 7 {
        main.token = main.token * 10 + (value as i32 in Wrapping) - 48;
        main.digits = main.digits + 1;
        transition main.token <= 1000000 {
            true -> read(main)
            _ -> invalid(main)
        }
    }
    state separator(main: &mut Main, value: i32) reaches Console {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> flush(main)
            _ -> invalid(main)
        }
    }
    state flush(main: &mut Main) reaches Console {
        transition main.digits > 0 {
            true -> store(main)
            _ -> read(main)
        }
    }
    state store(main: &mut Main) reaches Console {
        transition main.position >= 0 && main.position < 13 {
            true -> save(main)
            _ -> invalid(main)
        }
    }
    state save(main: &mut Main) reaches Console
    requires main.position >= 0 && main.position < 13 {
        main.input[main.position] = main.token as i32;
        main.position = main.position + 1;
        main.token = 0;
        main.digits = 0;
        transition { _ -> read(main) }
    }
    state end(main: &mut Main) reaches Console {
        transition main.digits > 0 {
            true -> last(main)
            _ -> validate(main)
        }
    }
    state last(main: &mut Main) reaches Console {
        transition main.position >= 0 && main.position < 13 {
            true -> save_last(main)
            _ -> invalid(main)
        }
    }
    state save_last(main: &mut Main) reaches Console
    requires main.position >= 0 && main.position < 13 {
        main.input[main.position] = main.token as i32;
        main.position = main.position + 1;
        transition { _ -> validate(main) }
    }
    state validate(main: &mut Main) reaches Console {
        transition main.position == 13 && main.input[0] <= 4 {
            true -> terms(main)
            _ -> invalid(main)
        }
    }
    state terms(main: &mut Main) reaches Console {
        main.index = 0;
        transition { _ -> term_loop(main) }
    }
    state term_loop(main: &mut Main) reaches Console {
        transition main.index >= 0 && main.index < 4 {
            true -> term(main)
            _ -> weights(main)
        }
    }
    state term(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 4 {
        let mask: i32 = main.input[main.index + 1];
        transition mask <= 7 && (main.index < main.input[0] || mask == 0) {
            true -> copy_term(main, mask)
            _ -> invalid(main)
        }
    }
    state copy_term(main: &mut Main, mask: i32) reaches Console
    requires main.index >= 0 && main.index < 4 {
        main.terms[main.index] = mask;
        main.index = main.index + 1;
        transition { _ -> term_loop(main) }
    }
    state weights(main: &mut Main) reaches Console {
        main.index = 0;
        transition { _ -> weight_loop(main) }
    }
    state weight_loop(main: &mut Main) reaches Console {
        transition main.index >= 0 && main.index < 8 {
            true -> weight(main)
            _ -> normalized(main)
        }
    }
    state weight(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.total = main.total + (main.input[main.index + 5] as i32 in Wrapping);
        transition fails(&main.terms, main.input[0], main.index) {
            true -> failed_weight(main)
            _ -> next_weight(main)
        }
    }
    state failed_weight(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.failure = main.failure + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> next_weight(main) }
    }
    state next_weight(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> weight_loop(main) }
    }
    state normalized(main: &mut Main) reaches Console {
        transition main.total == 1000000 {
            true -> report(main)
            _ -> invalid(main)
        }
    }
    state report(main: &mut Main) reaches Console {
        main.console.write("failure_ppm=");
        number(&mut main.console, main.failure as i32);
        main.console.write_line("/1000000");
        main.index = 0;
        transition { _ -> cuts(main) }
    }
    state cuts(main: &mut Main) reaches Console {
        transition main.index >= 0 && main.index < 8 {
            true -> cut(main)
            _ -> sensitivity(main)
        }
    }
    state cut(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        transition minimal_cut(&main.terms, main.input[0], main.index) {
            true -> emit_cut(main)
            _ -> next_cut(main)
        }
    }
    state emit_cut(main: &mut Main) reaches Console {
        main.console.write("cut_mask=");
        number(&mut main.console, main.index);
        main.console.write_line("");
        transition { _ -> next_cut(main) }
    }
    state next_cut(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> cuts(main) }
    }
    state sensitivity(main: &mut Main) reaches Console {
        main.event = 0;
        transition { _ -> event_loop(main) }
    }
    state event_loop(main: &mut Main) reaches Console {
        transition main.event >= 0 && main.event < 3 {
            true -> event_start(main)
            _ -> done(main)
        }
    }
    state event_start(main: &mut Main) reaches Console {
        main.repaired = 0;
        main.forced = 0;
        main.marginal = 0;
        main.index = 0;
        transition { _ -> audit_loop(main) }
    }
    state audit_loop(main: &mut Main) reaches Console {
        transition main.index >= 0 && main.index < 8 {
            true -> audit(main)
            _ -> emit_audit(main)
        }
    }
    state audit(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        let off: i32 = force_event(main.index, main.event, false);
        let on: i32 = force_event(main.index, main.event, true);
        transition off != main.index {
            true -> marginal(main, off, on)
            _ -> repair(main, off, on)
        }
    }
    state marginal(main: &mut Main, off: i32, on: i32) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.marginal = main.marginal + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> repair(main, off, on) }
    }
    state repair(main: &mut Main, off: i32, on: i32) reaches Console {
        transition fails(&main.terms, main.input[0], off) {
            true -> add_repair(main, on)
            _ -> force(main, on)
        }
    }
    state add_repair(main: &mut Main, on: i32) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.repaired = main.repaired + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> force(main, on) }
    }
    state force(main: &mut Main, on: i32) reaches Console {
        transition fails(&main.terms, main.input[0], on) {
            true -> add_force(main)
            _ -> next_audit(main)
        }
    }
    state add_force(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.forced = main.forced + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> next_audit(main) }
    }
    state next_audit(main: &mut Main) reaches Console
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> audit_loop(main) }
    }
    state emit_audit(main: &mut Main) reaches Console
    requires main.event >= 0 && main.event < 3 {
        main.console.write("event="); number(&mut main.console, main.event);
        main.console.write(" marginal_ppm="); number(&mut main.console, main.marginal as i32);
        main.console.write(" repaired_ppm="); number(&mut main.console, main.repaired as i32);
        main.console.write(" reduction_ppm="); number(&mut main.console, (main.failure - main.repaired) as i32);
        main.console.write(" forced_ppm="); number(&mut main.console, main.forced as i32);
        main.console.write_line("");
        main.event = main.event + 1;
        transition { _ -> event_loop(main) }
    }
    state done(main: &mut Main) reaches Console {
        main.console.write_line("AUDIT COMPLETE");
        main.console.exit_process(0);
    }
    state invalid(main: &mut Main) reaches Console {
        main.console.write_line("INVALID INPUT");
        main.console.exit_process(2);
    }
}
