// Declared synthetic instrument model: A sensor fault, B power fault,
// C shared environmental cause. Input contains complete joint weights.
use omega_language_std::console;
use domain::logic;
use domain::report;

data Main {
    input: [i32; 13];
    terms: [i32; 4];
    token: i32 in Wrapping;
    digits: i32;
    position: i32;
    bytes: i32;
    index: i32;
    total: i32 in Wrapping;
    failure: i32 in Wrapping;
    repaired: i32 in Wrapping;
    forced: i32 in Wrapping;
    marginal: i32 in Wrapping;
    event: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> read(main) }
    machine read(main: &mut Main) {
        transition main.bytes >= 0 && main.bytes < 256 {
            true -> byte(main)
            _ -> invalid(main)
        }
    }
    machine byte(main: &mut Main)
    requires main.bytes >= 0 && main.bytes < 256 {
        main.bytes = main.bytes + 1;
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> end(main)
            ByteRead::Byte { value } -> classify(main, value)
        }
    }
    machine classify(main: &mut Main, value: i32) {
        transition value >= 48 && value <= 57 {
            true -> digit(main, value)
            _ -> separator(main, value)
        }
    }
    machine digit(main: &mut Main, value: i32) {
        transition main.digits >= 0 && main.digits < 7 {
            true -> accumulate(main, value)
            _ -> invalid(main)
        }
    }
    machine accumulate(main: &mut Main, value: i32)
    requires main.digits >= 0 && main.digits < 7 {
        main.token = main.token * 10 + (value as i32 in Wrapping) - 48;
        main.digits = main.digits + 1;
        transition main.token <= 1000000 {
            true -> read(main)
            _ -> invalid(main)
        }
    }
    machine separator(main: &mut Main, value: i32) {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> flush(main)
            _ -> invalid(main)
        }
    }
    machine flush(main: &mut Main) {
        transition main.digits > 0 {
            true -> store(main)
            _ -> read(main)
        }
    }
    machine store(main: &mut Main) {
        transition main.position >= 0 && main.position < 13 {
            true -> save(main)
            _ -> invalid(main)
        }
    }
    machine save(main: &mut Main)
    requires main.position >= 0 && main.position < 13 {
        main.input[main.position] = main.token as i32;
        main.position = main.position + 1;
        main.token = 0;
        main.digits = 0;
        transition { _ -> read(main) }
    }
    machine end(main: &mut Main) {
        transition main.digits > 0 {
            true -> last(main)
            _ -> validate(main)
        }
    }
    machine last(main: &mut Main) {
        transition main.position >= 0 && main.position < 13 {
            true -> save_last(main)
            _ -> invalid(main)
        }
    }
    machine save_last(main: &mut Main)
    requires main.position >= 0 && main.position < 13 {
        main.input[main.position] = main.token as i32;
        main.position = main.position + 1;
        transition { _ -> validate(main) }
    }
    machine validate(main: &mut Main) {
        transition main.position == 13 && main.input[0] <= 4 {
            true -> terms(main)
            _ -> invalid(main)
        }
    }
    machine terms(main: &mut Main) {
        main.index = 0;
        transition { _ -> term_loop(main) }
    }
    machine term_loop(main: &mut Main) {
        transition main.index >= 0 && main.index < 4 {
            true -> term(main)
            _ -> weights(main)
        }
    }
    machine term(main: &mut Main)
    requires main.index >= 0 && main.index < 4 {
        let mask: i32 = main.input[main.index + 1];
        transition mask <= 7 && (main.index < main.input[0] || mask == 0) {
            true -> copy_term(main, mask)
            _ -> invalid(main)
        }
    }
    machine copy_term(main: &mut Main, mask: i32)
    requires main.index >= 0 && main.index < 4 {
        main.terms[main.index] = mask;
        main.index = main.index + 1;
        transition { _ -> term_loop(main) }
    }
    machine weights(main: &mut Main) {
        main.index = 0;
        transition { _ -> weight_loop(main) }
    }
    machine weight_loop(main: &mut Main) {
        transition main.index >= 0 && main.index < 8 {
            true -> weight(main)
            _ -> normalized(main)
        }
    }
    machine weight(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        main.total = main.total + (main.input[main.index + 5] as i32 in Wrapping);
        transition fails(&main.terms, main.input[0], main.index) {
            true -> failed_weight(main)
            _ -> next_weight(main)
        }
    }
    machine failed_weight(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        main.failure = main.failure + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> next_weight(main) }
    }
    machine next_weight(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> weight_loop(main) }
    }
    machine normalized(main: &mut Main) {
        transition main.total == 1000000 {
            true -> report(main)
            _ -> invalid(main)
        }
    }
    machine report(main: &mut Main) {
        Console::write("failure_ppm=");
        number(main.failure as i32);
        Console::write_line("/1000000");
        main.index = 0;
        transition { _ -> cuts(main) }
    }
    machine cuts(main: &mut Main) {
        transition main.index >= 0 && main.index < 8 {
            true -> cut(main)
            _ -> sensitivity(main)
        }
    }
    machine cut(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        transition minimal_cut(&main.terms, main.input[0], main.index) {
            true -> emit_cut(main)
            _ -> next_cut(main)
        }
    }
    machine emit_cut(main: &mut Main) {
        Console::write("cut_mask=");
        number(main.index);
        Console::write_line("");
        transition { _ -> next_cut(main) }
    }
    machine next_cut(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> cuts(main) }
    }
    machine sensitivity(main: &mut Main) {
        main.event = 0;
        transition { _ -> event_loop(main) }
    }
    machine event_loop(main: &mut Main) {
        transition main.event >= 0 && main.event < 3 {
            true -> event_start(main)
            _ -> done(main)
        }
    }
    machine event_start(main: &mut Main) {
        main.repaired = 0;
        main.forced = 0;
        main.marginal = 0;
        main.index = 0;
        transition { _ -> audit_loop(main) }
    }
    machine audit_loop(main: &mut Main) {
        transition main.index >= 0 && main.index < 8 {
            true -> audit(main)
            _ -> emit_audit(main)
        }
    }
    machine audit(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        let off: i32 = force_event(main.index, main.event, false);
        let on: i32 = force_event(main.index, main.event, true);
        transition off != main.index {
            true -> marginal(main, off, on)
            _ -> repair(main, off, on)
        }
    }
    machine marginal(main: &mut Main, off: i32, on: i32)
    requires main.index >= 0 && main.index < 8 {
        main.marginal = main.marginal + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> repair(main, off, on) }
    }
    machine repair(main: &mut Main, off: i32, on: i32) {
        transition fails(&main.terms, main.input[0], off) {
            true -> add_repair(main, on)
            _ -> force(main, on)
        }
    }
    machine add_repair(main: &mut Main, on: i32)
    requires main.index >= 0 && main.index < 8 {
        main.repaired = main.repaired + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> force(main, on) }
    }
    machine force(main: &mut Main, on: i32) {
        transition fails(&main.terms, main.input[0], on) {
            true -> add_force(main)
            _ -> next_audit(main)
        }
    }
    machine add_force(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        main.forced = main.forced + (main.input[main.index + 5] as i32 in Wrapping);
        transition { _ -> next_audit(main) }
    }
    machine next_audit(main: &mut Main)
    requires main.index >= 0 && main.index < 8 {
        main.index = main.index + 1;
        transition { _ -> audit_loop(main) }
    }
    machine emit_audit(main: &mut Main)
    requires main.event >= 0 && main.event < 3 {
        Console::write("event="); number(main.event);
        Console::write(" marginal_ppm="); number(main.marginal as i32);
        Console::write(" repaired_ppm="); number(main.repaired as i32);
        Console::write(" reduction_ppm="); number((main.failure - main.repaired) as i32);
        Console::write(" forced_ppm="); number(main.forced as i32);
        Console::write_line("");
        // Refresh the Exact cursor bound after service calls, directly on the
        // increment edge. A state arrival fact is not a post-call guarantee.
        transition main.event >= 0 && main.event < 3 {
            true -> advance_event(main)
            _ -> invalid(main)
        }
    }
    machine advance_event(main: &mut Main)
    requires main.event >= 0 && main.event < 3 {
        main.event = main.event + 1;
        transition { _ -> event_loop(main) }
    }
    machine done(main: &mut Main) {
        Console::write_line("AUDIT COMPLETE");
        Console::exit_process(0);
    }
    machine invalid(main: &mut Main) {
        Console::write_line("INVALID INPUT");
        Console::exit_process(2);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
