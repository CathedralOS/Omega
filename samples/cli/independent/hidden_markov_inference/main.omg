// Expected exit: 64 (empty stdin is invalid).
// Expected numerical outputs are frozen independently in expected.json.
use omega_language_std::console;
use omega::language::core::float_operations;
use domain::inference;
use domain::viterbi;
use io::trace;
data Main { model: Model; result: Inference; paths: Paths; line: [u8; 64]; path_bytes: [u8; 32]; }
// Both lanes hold the observation count. Lane 0 is the printed path; lane 1
// keeps an equal-length spare so the match publishes that shared runtime length.
data DigitWindow<'storage> { digits: &'storage mut [u8]; }
machine path_lane<'storage>(bytes: &'storage mut [u8; 32], count: u64, lane: u64) -> &'storage mut [u8]
requires count >= 1 requires count <= 16 requires lane <= 1
ensures result.len == count {
    match lane {
        0 -> &mut bytes[0..count]
        _ -> &mut bytes[16..16 + count]
    }
}
machine fill_path(window: &mut [u8], path: u64, count: u64)
requires count >= 1 requires count <= 16 requires window.len == count {
    transition { _ -> divisor(window, path, count, 1, 1) }
    state divisor(window: &mut [u8], path: u64, count: u64, index: u64, scale: u64)
    requires count >= 1 requires count <= 16 requires window.len == count
    requires index >= 1 requires index <= 16 requires scale >= 1 requires scale <= 32768 {
        transition index < count && index < 16 {
            true -> grow(window, path, count, index, scale)
            false -> write(window, path, scale, 0)
        }
    }
    state grow(window: &mut [u8], path: u64, count: u64, index: u64, scale: u64)
    requires count >= 1 requires count <= 16 requires window.len == count
    requires index >= 1 requires index < 16 requires scale >= 1 requires scale <= 32768 {
        transition scale <= 16384 { true -> divisor(window, path, count, index + 1, scale * 2) false -> write(window, path, scale, 0) }
    }
    state write(window: &mut [u8], path: u64, scale: u64, index: u64)
    requires window.len >= 1 requires window.len <= 16 requires scale >= 1 requires scale <= 32768 requires index < window.len {
        let digit: u64 = (path / scale) % 2;
        window[index] = (48 + digit) as u8;
        transition scale >= 2 && index + 1 < window.len { true -> write(window, path, scale / 2, index + 1) false -> filled() }
    }
    state filled() { }
}
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> probability(main, 0) }
    state probability(main: &mut Main, field: u64) requires field < 10 {
        let read: LineReadResult = block Console::read_line(&mut main.line);
        transition read {
            LineReadResult::LineComplete { count } -> probability_line(main, field, count)
            _ -> invalid(main)
        }
    }
    state probability_line(main: &mut Main, field: u64, count: u64) requires field < 10 {
        transition count == 8 && main.line[7] == 10 {
            true -> digits(main, field, 0, 0)
            false -> invalid(main)
        }
    }
    state digits(main: &mut Main, field: u64, index: u64, value: u64)
    requires field < 10 requires index < 7 requires value <= 1000000 {
        let character: u8 = main.line[index];
        transition character >= 48 && character <= 57 {
            true -> accumulate(main, field, index, value, character)
            false -> invalid(main)
        }
    }
    state accumulate(main: &mut Main, field: u64, index: u64, value: u64, character: u8)
    requires field < 10 requires index < 7 requires value <= 1000000 requires character >= 48 requires character <= 57 {
        let next: u64 = value * 10 + ((character as u64) - 48);
        transition next <= 1000000 { true -> accumulated(main, field, index, next) false -> invalid(main) }
    }
    state accumulated(main: &mut Main, field: u64, index: u64, value: u64)
    requires field < 10 requires index < 7 requires value <= 1000000 {
        transition index < 6 { true -> digits(main, field, index + 1, value) false -> store(main, field, value) }
    }
    state store(main: &mut Main, field: u64, value: u64) requires field < 10 requires value <= 1000000 {
        main.model.units[field] = value;
        main.model.probabilities[field] = F64::from_i64(value as i64) / 1000000.0;
        transition field < 9 { true -> probability(main, field + 1) false -> distributions(main, 0) }
    }
    state distributions(main: &mut Main, row: u64) requires row < 5 {
        transition main.model.units[2 * row] <= 1000000 && main.model.units[2 * row + 1] <= 1000000 {
            true -> bounded_distribution(main, row)
            false -> invalid(main)
        }
    }
    state bounded_distribution(main: &mut Main, row: u64) requires row < 5
    requires main.model.units[2 * row] <= 1000000 requires main.model.units[2 * row + 1] <= 1000000 {
        transition main.model.units[2 * row] + main.model.units[2 * row + 1] == 1000000 {
            true -> distribution_valid(main, row)
            false -> invalid(main)
        }
    }
    state distribution_valid(main: &mut Main, row: u64) requires row < 5 {
        transition row < 4 { true -> distributions(main, row + 1) false -> observations(main) }
    }
    state observations(main: &mut Main) {
        let read: LineReadResult = block Console::read_line(&mut main.line);
        transition read {
            LineReadResult::LineComplete { count } -> observation_line(main, count)
            _ -> invalid(main)
        }
    }
    state observation_line(main: &mut Main, count: u64) {
        transition count >= 2 && count <= 17 { true -> observation_length(main, count) false -> invalid(main) }
    }
    state observation_length(main: &mut Main, count: u64) requires count >= 2 requires count <= 17 {
        main.model.count = count - 1;
        transition main.line[count - 1] == 10 { true -> symbols(main, 0) false -> invalid(main) }
    }
    state symbols(main: &mut Main, index: u64) requires index < 16 {
        transition main.line[index] >= 48 && main.line[index] <= 49 { true -> symbol(main, index) false -> invalid(main) }
    }
    state symbol(main: &mut Main, index: u64) requires index < 16 requires main.line[index] >= 48 requires main.line[index] <= 49 {
        main.model.observations[index] = (main.line[index] as u64) - 48;
        transition index + 1 < main.model.count { true -> more_symbols(main, index) false -> end_input(main) }
    }
    state more_symbols(main: &mut Main, index: u64) requires index < 16 {
        transition index < 15 { true -> symbols(main, index + 1) false -> invalid(main) }
    }
    state end_input(main: &mut Main) {
        let read: LineReadResult = block Console::read_line(&mut main.line);
        transition read { LineReadResult::EndOfInput { count } -> ended(main, count) _ -> invalid(main) }
    }
    state ended(main: &mut Main, count: u64) {
        transition count == 0 && main.model.count >= 1 && main.model.count <= 16 { true -> compute(main) false -> invalid(main) }
    }
    state compute(main: &mut Main) requires main.model.count >= 1 requires main.model.count <= 16 {
        let possible: bool = infer(&main.model, &mut main.result);
        transition possible { true -> report(main) false -> impossible(main) }
    }
    state report(main: &mut Main) requires main.model.count >= 1 requires main.model.count <= 16 {
        viterbi(&main.model, &mut main.paths, &mut main.result);
        Console::write_line("OK trillionths");
        Console::write("LOG");
        print_number(main.result.log_likelihood);
        Console::write_line("");
        transition { _ -> posterior(main, 0) }
    }
    state posterior(main: &mut Main, index: u64) requires index < 16 {
        let zero: f64 = main.result.forward[2 * index] * main.result.backward[2 * index];
        let one: f64 = main.result.forward[2 * index + 1] * main.result.backward[2 * index + 1];
        Console::write("POST");
        print_integer(index as i64);
        print_number(zero / (zero + one));
        print_number(one / (zero + one));
        Console::write_line("");
        transition index + 1 < main.model.count { true -> next_posterior(main, index) false -> path_start(main) }
    }
    state next_posterior(main: &mut Main, index: u64) requires index < 16 {
        transition index < 15 { true -> posterior(main, index + 1) false -> invalid(main) }
    }
    state path_start(main: &mut Main) {
        Console::write("PATH ");
        let count: u64 = main.model.count;
        transition count >= 1 && count <= 16 { true -> path_window(main, count) false -> invalid(main) }
    }
    state path_window(main: &mut Main, count: u64) requires count >= 1 requires count <= 16 {
        let lane: &mut [u8] = path_lane(&mut main.path_bytes, count, 0);
        let held: DigitWindow = DigitWindow { digits: lane };
        fill_path(held.digits, main.result.path, count);
        transition { _ -> path_emit(main, count, 0) }
    }
    state path_emit(main: &mut Main, count: u64, index: u64)
    requires count >= 1 requires count <= 16 requires index <= count {
        transition index < count { true -> path_byte(main, count, index) false -> success(main) }
    }
    state path_byte(main: &mut Main, count: u64, index: u64)
    requires count >= 1 requires count <= 16 requires index < count {
        Console::write_byte(main.path_bytes[index] as i32);
        transition { _ -> path_emit(main, count, index + 1) }
    }
    state success(main: &mut Main) { Console::write_line(""); Console::exit_process(0); }
    state invalid(main: &mut Main) { Console::write_line("INVALID"); Console::exit_process(64); }
    state impossible(main: &mut Main) { Console::write_line("IMPOSSIBLE"); Console::exit_process(65); }
}
