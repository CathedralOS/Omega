use domain::solver;
use domain::shockley;
use io::protocol;
use omega_language_std::console;
use omega::language::core::float_operations;

data Main {
    protocol: Protocol;
    circuit: Circuit;
    solver: Solver;
    source_start: f64;
    source_step: f64;
    source_index: f64;
    points: i32 in Wrapping;
    position: i32 in Wrapping;
    budget: i32 in Wrapping;
    converged: i32 in Wrapping;
    failed: i32 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    let valid: bool = block Protocol::read(&mut main.protocol);
    transition valid { true -> validate(main) false -> bad_syntax(main) }
    state bad_syntax(main: &mut Main) {
        Console::write_line("ERROR syntax: expected nine integers, maximum 160 bytes");
        Console::exit_process(64);
    }
    state validate(main: &mut Main) {
        transition main.protocol.fields[0] >= -1000 && main.protocol.fields[0] <= 5000
            && main.protocol.fields[1] >= -1000 && main.protocol.fields[1] <= 5000
            && main.protocol.fields[2] >= 2 && main.protocol.fields[2] <= 16
            && main.protocol.fields[3] >= 10 && main.protocol.fields[3] <= 1000000
            && main.protocol.fields[4] >= 1 && main.protocol.fields[4] <= 1000000
            && main.protocol.fields[5] >= 25 && main.protocol.fields[5] <= 50
            && main.protocol.fields[6] >= -1200 && main.protocol.fields[6] <= 900
            && main.protocol.fields[7] >= -1200 && main.protocol.fields[7] <= 900
            && main.protocol.fields[6] < main.protocol.fields[7]
            && main.protocol.fields[8] >= 1 && main.protocol.fields[8] <= 80 {
            true -> configure(main)
            false -> bad_range(main)
        }
    }
    state bad_range(main: &mut Main) {
        Console::write_line("ERROR range: invalid sweep or Shockley model parameters");
        Console::exit_process(65);
    }
    state configure(main: &mut Main) {
        let start: f64 = main.protocol.fields[0] as f64;
        let stop: f64 = main.protocol.fields[1] as f64;
        let count: i32 in Wrapping = main.protocol.fields[2] as i32 in Wrapping;
        let intervals: i32 = (count - 1) as i32;
        let divisor: f64 = intervals as f64;
        main.source_start = start / 1000.0;
        let span: f64 = (stop - start) / 1000.0;
        main.source_step = span / divisor;
        main.source_index = 0.0;
        main.position = 0;
        main.points = count;
        main.budget = main.protocol.fields[8] as i32 in Wrapping;
        main.converged = 0;
        main.failed = 0;
        main.circuit.resistance = main.protocol.fields[3] as f64;
        let saturation: f64 = main.protocol.fields[4] as f64;
        main.circuit.saturation = saturation / 1000000000000.0;
        let thermal: f64 = main.protocol.fields[5] as f64;
        main.circuit.thermal = thermal / 1000.0;
        let lower: f64 = main.protocol.fields[6] as f64;
        let upper: f64 = main.protocol.fields[7] as f64;
        main.circuit.lower = lower / 1000.0;
        main.circuit.upper = upper / 1000.0;
        Console::write_line("point,status,source_V,diode_V,current_A,residual_V,width_V,iterations,evaluations");
        transition { _ -> sweep(main) }
    }
    state sweep(main: &mut Main) {
        let offset: f64 = main.source_step * main.source_index;
        let source: f64 = main.source_start + offset;
        solve(&main.circuit, &mut main.solver, source, main.budget);
        Protocol::integer(&mut main.protocol, main.position);
        Console::write(",");
        transition main.solver.status == 3 {
            true -> absent(main)
            false -> present(main)
        }
    }
    state absent(main: &mut Main) {
        main.failed = main.failed + 1;
        Console::write("no_bracket,");
        Protocol::number(&mut main.protocol, main.solver.source);
        Console::write(",NA,NA,NA,NA,");
        transition { _ -> diagnostics(main) }
    }
    state present(main: &mut Main) {
        transition main.solver.status == 1 {
            true -> converged(main)
            false -> limited(main)
        }
    }
    state converged(main: &mut Main) {
        main.converged = main.converged + 1;
        Console::write("converged,");
        transition { _ -> values(main) }
    }
    state limited(main: &mut Main) {
        main.failed = main.failed + 1;
        Console::write("iteration_limit,");
        transition { _ -> values(main) }
    }
    state values(main: &mut Main) {
        Protocol::number(&mut main.protocol, main.solver.source);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.solver.voltage);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.solver.current);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.solver.residual);
        Console::write(",");
        Protocol::number(&mut main.protocol, main.solver.width);
        Console::write(",");
        transition { _ -> diagnostics(main) }
    }
    state diagnostics(main: &mut Main) {
        Protocol::integer(&mut main.protocol, main.solver.iterations);
        Console::write(",");
        Protocol::integer(&mut main.protocol, main.solver.evaluations);
        Console::write_line("");
        main.position = main.position + 1;
        main.source_index = main.source_index + 1.0;
        transition main.position < main.points { true -> sweep(main) false -> done(main) }
    }
    state done(main: &mut Main) {
        Console::write("summary,");
        Protocol::integer(&mut main.protocol, main.converged);
        Console::write(",");
        Protocol::integer(&mut main.protocol, main.failed);
        Console::write_line("");
        Console::exit_process(0);
    }
}
