// Expected exit: 2 (empty stdin).
// Expected output contains: invalid spectrum input
// Valid spectrum/catalog fixtures exit 0 and emit regions and catalog matches.
module spectrometer;
use omega_language_std::console;
use spectrometer::model::Spectrometer;
use spectrometer::model::IntegerRead;
use spectrometer::input::read_integer;
use spectrometer::input::load_spectrum;
use spectrometer::regions::find_regions;
use spectrometer::matching::match_regions;
use spectrometer::output::print_report;

// The ordinary hosted entry consumes one complete bounded spectrum/catalog
// inventory. There are no built-in answers or scenario-dependent branches.
pub machine Spectrometer::main(application: &mut Spectrometer) reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> input(application, 0) }
    state input(application: &mut Spectrometer, index: i32 in Wrapping) {
        transition index >= 0 && index < 27 {
            true -> token(application, index)
            false -> trailing(application)
        }
    }
    state token(application: &mut Spectrometer, index: i32 in Wrapping) {
        transition block read_integer(application) {
            IntegerRead::Value { value } -> store(application, index, value)
            _ -> invalid(application)
        }
    }
    state store(application: &mut Spectrometer, index: i32 in Wrapping,
                value: i32 in Wrapping) {
        application.raw[index] = value;
        transition { _ -> input(application, index + 1) }
    }
    state trailing(application: &mut Spectrometer) {
        transition block read_integer(application) {
            IntegerRead::End -> validate(application)
            _ -> invalid(application)
        }
    }
    state validate(application: &mut Spectrometer) {
        transition load_spectrum(application) {
            true -> analyze(application)
            false -> invalid(application)
        }
    }
    state analyze(application: &mut Spectrometer) {
        transition find_regions(&application.spectrum, &mut application.regions) {
            true -> report(application)
            false -> capacity(application)
        }
    }
    state report(application: &mut Spectrometer) {
        match_regions(&application.spectrum, &mut application.regions);
        print_report(application);
        Console::exit_process(0);
    }
    state invalid(application: &mut Spectrometer) {
        Console::write_line("invalid spectrum input");
        Console::exit_process(2);
    }
    state capacity(application: &mut Spectrometer) {
        Console::write_line("region capacity exceeded");
        Console::exit_process(3);
    }
}
