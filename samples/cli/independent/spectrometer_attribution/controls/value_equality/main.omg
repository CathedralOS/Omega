// Expected exit: 0.
// Expected output contains: float equality: equal and unequal
module spectrometer_equality_control;
use omega_language_std::console;
use omega::language::core::float_operations;

public data Main { }

// A value-returning body uses ordinary Float::equal. Merely returning bool or
// sharing the carrier of a resultless law must not grant proposition equality.
machine same(left: f64, right: f64) -> bool { left == right }

public machine Main::main(application: &mut Main) reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition block Console::read_byte() {
        ByteRead::Byte { value } -> compare(application, value)
        _ -> bad(application)
    }
    machine compare(application: &mut Main, value: i32) {
        let floating: f64 = F64::from_i32(value);
        transition same(floating, 65.0) && !same(floating, 66.0) {
            true -> done(application)
            false -> bad(application)
        }
    }
    machine done(application: &mut Main) {
        Console::write_line("float equality: equal and unequal");
        Console::exit_process(0);
    }
    machine bad(application: &mut Main) { Console::exit_process(3); }
}
