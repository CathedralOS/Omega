module spectrometer::output;
use omega_language_std::math;
use spectrometer::model::Spectrometer;
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::float_operations;

// Fixed-width decimal fields are emitted from computed values, with no string
// carrier or UTF-8 assertion. Accepted coordinates times 1000 fit signed i32.
machine print_integer(application: &mut Spectrometer, value: i32 in Wrapping) reaches Console {
    transition value < 0 {
        true -> negative(application, value)
        false -> digits(application, value, 100000000)
    }
    state negative(application: &mut Spectrometer, value: i32 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> digits(application, 0 - value, 100000000) }
    }
    state digits(application: &mut Spectrometer, value: i32 in Wrapping,
                 divisor: i32 in Wrapping) {
        transition divisor > 0 {
            true -> emit(application, value, divisor)
            false -> finished()
        }
    }
    state emit(application: &mut Spectrometer, value: i32 in Wrapping,
               divisor: i32 in Wrapping) {
        let digit: i32 in Wrapping = value / divisor;
        Console::write_byte((digit + 48) as i32);
        transition { _ -> digits(application, value % divisor, divisor / 10) }
    }
    state finished() {}
}
// Scale the exact numerator before division. An exact half-thousandth becomes
// a representable binary half-integer; multiplying a rounded quotient does not
// preserve that boundary. Bounded scaled numerators remain below 2^53.
machine rounded_ratio_thousandths(numerator: f64, denominator: f64) -> i32 in Wrapping {
    let scaled: f64 = numerator * 1000.0 / denominator;
    transition scaled < 0.0 {
        true -> negative(scaled)
        false -> positive(scaled)
    }
    state negative(value: f64) -> i32 in Wrapping {
        let converted: i32 in Saturating = I32::from_f64(value - 0.5);
        converted as i32 in Wrapping
    }
    state positive(value: f64) -> i32 in Wrapping {
        let converted: i32 in Saturating = I32::from_f64(value + 0.5);
        converted as i32 in Wrapping
    }
}
pub machine print_report(application: &mut Spectrometer) reaches Console
invokes Console;
{
    let count: i32 in Wrapping = application.regions.count;
    Console::write("regions=");
    print_integer(application, count);
    Console::write_line("");
    transition { _ -> region(application, 0) }
    state region(application: &mut Spectrometer, index: i32 in Wrapping) {
        transition index >= 0 && index < application.regions.count && index < 8 {
            true -> row(application, index)
            false -> finished()
        }
    }
    state row(application: &mut Spectrometer, index: i32 in Wrapping) {
        // Finish scalar reads before borrowing the whole receiver for output.
        let start: i32 in Wrapping = application.regions.starts[index];
        let end: i32 in Wrapping = application.regions.ends[index];
        let area_milli: i32 in Wrapping = rounded_ratio_thousandths(application.regions.area_fifteenths[index], 15.0);
        let centroid_micro: i32 in Wrapping = rounded_ratio_thousandths(application.regions.moment_fifteenths[index] +
            application.spectrum.calibration * application.regions.area_fifteenths[index],
            application.regions.area_fifteenths[index]);
        let candidate_count: i32 in Wrapping = application.regions.candidates[index];
        let nearest: i32 in Wrapping = application.regions.nearest[index];
        Console::write("region start=");
        print_integer(application, start);
        Console::write(" end=");
        print_integer(application, end);
        Console::write(" area_milli=");
        print_integer(application, area_milli);
        Console::write(" centroid_micro=");
        print_integer(application, centroid_micro);
        Console::write(" candidates=");
        print_integer(application, candidate_count);
        Console::write(" nearest=");
        print_integer(application, nearest);
        transition candidate_count {
            0 -> missing(application, index)
            1 -> unique(application, index)
            _ -> ambiguous(application, index)
        }
    }
    state missing(application: &mut Spectrometer, index: i32 in Wrapping) {
        Console::write(" status=missing ids=");
        transition { _ -> identifiers(application, index, 0) }
    }
    state unique(application: &mut Spectrometer, index: i32 in Wrapping) {
        Console::write(" status=unique ids=");
        transition { _ -> identifiers(application, index, 0) }
    }
    state ambiguous(application: &mut Spectrometer, index: i32 in Wrapping) {
        Console::write(" status=ambiguous ids=");
        transition { _ -> identifiers(application, index, 0) }
    }
    state identifiers(application: &mut Spectrometer, index: i32 in Wrapping,
                      reference: i32 in Wrapping) {
        transition reference >= 0 && reference < 4 {
            true -> candidate(application, index, reference)
            false -> next(application, index)
        }
    }
    state candidate(application: &mut Spectrometer, index: i32 in Wrapping,
                    reference: i32 in Wrapping) {
        let distance: f64 = abs_f64(application.regions.centroids[index] - application.spectrum.lines[reference]);
        transition distance <= application.spectrum.tolerance {
            true -> emit_id(application, index, reference)
            false -> identifiers(application, index, reference + 1)
        }
    }
    state emit_id(application: &mut Spectrometer, index: i32 in Wrapping,
                  reference: i32 in Wrapping) {
        print_integer(application, reference + 1);
        Console::write(",");
        transition { _ -> identifiers(application, index, reference + 1) }
    }
    state next(application: &mut Spectrometer, index: i32 in Wrapping) {
        Console::write_line("");
        transition { _ -> region(application, index + 1) }
    }
    state finished() {}
}
