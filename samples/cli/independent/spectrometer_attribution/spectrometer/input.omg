module spectrometer::input;
use spectrometer::model::Spectrometer;
use spectrometer::model::IntegerRead;
use omega_language_std::console;
use omega::language::core::float_operations;

// Decimal magnitude is guarded before every multiplication. The signed bound
// is one million, so Wrapping never wraps on accepted input. Delimiters are
// consumed; a minus sign must be followed by a digit, including at EOF.
public machine read_integer(application: &mut Spectrometer) -> IntegerRead
reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> begin(application) }
    machine begin(application: &mut Spectrometer) -> IntegerRead {
        transition block Console::read_byte() {
            ByteRead::Eof -> (IntegerRead::End)
            ByteRead::Byte { value } -> first(application, value)
        }
    }
    machine first(application: &mut Spectrometer, byte: i32) -> IntegerRead {
        transition byte == 32 || byte == 10 || byte == 13 || byte == 9 {
            true -> begin(application)
            false -> sign(application, byte)
        }
    }
    machine sign(application: &mut Spectrometer, byte: i32) -> IntegerRead {
        transition byte == 45 {
            true -> following(application, 0, -1, false)
            false -> digit(application, byte, 0, 1, false)
        }
    }
    machine digit(application: &mut Spectrometer, byte: i32,
                magnitude: i32 in Wrapping, sign: i32 in Wrapping,
                seen: bool) -> IntegerRead {
        transition byte >= 48 && byte <= 57 {
            true -> accumulate(application, byte, magnitude, sign)
            false -> delimiter(application, byte, magnitude, sign, seen)
        }
    }
    machine accumulate(application: &mut Spectrometer, byte: i32,
                     magnitude: i32 in Wrapping, sign: i32 in Wrapping) -> IntegerRead {
        transition magnitude <= 100000 {
            true -> append(application, byte, magnitude, sign)
            false -> (IntegerRead::Invalid)
        }
    }
    machine append(application: &mut Spectrometer, byte: i32,
                 magnitude: i32 in Wrapping, sign: i32 in Wrapping) -> IntegerRead {
        let value: i32 in Wrapping = magnitude * 10 + (byte as i32 in Wrapping) - 48;
        transition value <= 1000000 {
            true -> following(application, value, sign, true)
            false -> (IntegerRead::Invalid)
        }
    }
    machine following(application: &mut Spectrometer, magnitude: i32 in Wrapping,
                    sign: i32 in Wrapping, seen: bool) -> IntegerRead {
        transition block Console::read_byte() {
            ByteRead::Eof -> finish(magnitude, sign, seen)
            ByteRead::Byte { value } -> digit(application, value, magnitude, sign, seen)
        }
    }
    machine delimiter(application: &mut Spectrometer, byte: i32,
                    magnitude: i32 in Wrapping, sign: i32 in Wrapping,
                    seen: bool) -> IntegerRead {
        transition byte == 32 || byte == 10 || byte == 13 || byte == 9 {
            true -> finish(magnitude, sign, seen)
            false -> (IntegerRead::Invalid)
        }
    }
    machine finish(magnitude: i32 in Wrapping, sign: i32 in Wrapping,
                 seen: bool) -> IntegerRead {
        transition seen {
            true -> (IntegerRead::Value { value: magnitude * sign })
            false -> (IntegerRead::Invalid)
        }
    }
}

// The validated integer inventory is converted once into floating coordinates.
// Baseline endpoints are supplied calibration data, not estimated from peaks.
public machine load_spectrum(application: &mut Spectrometer) -> bool {
    transition { _ -> samples(application, 0) }
    machine samples(application: &mut Spectrometer, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 16 {
            true -> sample(application, index)
            false -> configuration(application)
        }
    }
    machine sample(application: &mut Spectrometer, index: i32 in Wrapping) -> bool {
        let value: i32 in Wrapping = application.raw[index];
        transition value >= 0 && value <= 1000 {
            true -> save(application, index, value)
            false -> false
        }
    }
    machine save(application: &mut Spectrometer, index: i32 in Wrapping,
               value: i32 in Wrapping) -> bool {
        application.spectrum.samples[index] = F64::from_i32(value as i32);
        transition { _ -> samples(application, index + 1) }
    }
    machine configuration(application: &mut Spectrometer) -> bool {
        transition application.raw[16] >= 0 && application.raw[16] <= 1000 &&
                   application.raw[17] >= 0 && application.raw[17] <= 1000 &&
                   application.raw[18] > 0 && application.raw[18] <= 1000 &&
                   application.raw[19] >= 0 && application.raw[19] <= 900000 &&
                   application.raw[20] > 0 && application.raw[20] <= 5000 &&
                   application.raw[21] >= -5000 && application.raw[21] <= 5000 &&
                   application.raw[22] >= 0 && application.raw[22] <= 5000 {
            true -> settings(application)
            false -> false
        }
    }
    machine settings(application: &mut Spectrometer) -> bool {
        application.spectrum.baseline_start = F64::from_i32(application.raw[16] as i32);
        application.spectrum.baseline_end = F64::from_i32(application.raw[17] as i32);
        application.spectrum.threshold = F64::from_i32(application.raw[18] as i32);
        application.spectrum.origin = F64::from_i32(application.raw[19] as i32);
        application.spectrum.spacing = F64::from_i32(application.raw[20] as i32);
        application.spectrum.calibration = F64::from_i32(application.raw[21] as i32);
        application.spectrum.tolerance = F64::from_i32(application.raw[22] as i32);
        transition { _ -> catalog(application, 0) }
    }
    machine catalog(application: &mut Spectrometer, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 4 {
            true -> line(application, index)
            false -> true
        }
    }
    machine line(application: &mut Spectrometer, index: i32 in Wrapping) -> bool {
        let offset: i32 in Wrapping = index + 23;
        transition offset >= 23 && offset < 27 {
            true -> read_line(application, index, offset)
            false -> false
        }
    }
    machine read_line(application: &mut Spectrometer, index: i32 in Wrapping,
                    offset: i32 in Wrapping) -> bool {
        let value: i32 in Wrapping = application.raw[offset];
        transition value >= 0 && value <= 1000000 {
            true -> save_line(application, index, value)
            false -> false
        }
    }
    machine save_line(application: &mut Spectrometer, index: i32 in Wrapping,
                    value: i32 in Wrapping) -> bool {
        application.spectrum.lines[index] = F64::from_i32(value as i32);
        transition { _ -> catalog(application, index + 1) }
    }
}
