module spectrometer::model;
use omega_language_std::console;

// Fixed capacities bound memory and work: sixteen bins and four reference lines.
// Zero initialization means no open region and no matching candidates.
pub data Spectrometer {
    raw: [i32 in Wrapping; 27];
    spectrum: Spectrum;
    regions: Regions;
}
pub data Spectrum {
    samples: [f64; 16];
    lines: [f64; 4];
    baseline_start: f64;
    baseline_end: f64;
    threshold: f64;
    origin: f64;
    spacing: f64;
    calibration: f64;
    tolerance: f64;
}
pub data Regions {
    starts: [i32 in Wrapping; 8];
    ends: [i32 in Wrapping; 8];
    area_fifteenths: [f64; 8];
    moment_fifteenths: [f64; 8];
    centroids: [f64; 8];
    candidates: [i32 in Wrapping; 8];
    nearest: [i32 in Wrapping; 8];
    count: i32 in Wrapping;
    open: bool;
}
pub data IntegerRead {
    case Invalid;
    case End;
    case Value(value: i32 in Wrapping);
}
