module spectrometer::regions;
use omega_language_std::math;
use spectrometer::model::Spectrum;
use spectrometer::model::Regions;
use omega::language::core::float_operations;

// Subtract the supplied linear baseline, clip negative residuals, and retain
// only bins at or above threshold. Adjacent retained bins form one region:
// overlapping peaks deliberately remain unresolved rather than fabricated.
// Rectangular area and moment retain integer fifteenths until the final ratio.
// Their maximum moment is below 2^53, so every accumulation is exact in f64.
public machine find_regions(spectrum: &Spectrum, regions: &mut Regions) -> bool {
    regions.count = 0;
    regions.open = false;
    transition { _ -> scan(spectrum, regions, 0) }
    machine scan(spectrum: &Spectrum, regions: &mut Regions,
               index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 16 {
            true -> residual(spectrum, regions, index)
            false -> flush(spectrum, regions)
        }
    }
    machine residual(spectrum: &Spectrum, regions: &mut Regions,
                   index: i32 in Wrapping) -> bool {
        // All accepted values are integers. Multiplying by fifteen keeps
        // linear-baseline residuals exact, including an inclusive threshold.
        let offset: f64 = F64::from_i32(index as i32);
        let weight: f64 = max_f64(0.0, spectrum.samples[index] * 15.0 -
            spectrum.baseline_start * (15.0 - offset) - spectrum.baseline_end * offset);
        transition weight >= spectrum.threshold * 15.0 {
            true -> retained(spectrum, regions, index, weight)
            false -> gap(spectrum, regions, index)
        }
    }
    machine retained(spectrum: &Spectrum, regions: &mut Regions,
                   index: i32 in Wrapping, weight: f64) -> bool {
        let region: i32 in Wrapping = regions.count;
        transition region >= 0 && region < 8 {
            true -> integrate(spectrum, regions, index, weight, region)
            false -> false
        }
    }
    machine integrate(spectrum: &Spectrum, regions: &mut Regions,
                    index: i32 in Wrapping, weight: f64,
                    region: i32 in Wrapping) -> bool {
        transition regions.open {
            true -> add(spectrum, regions, index, weight, region)
            false -> start(spectrum, regions, index, weight, region)
        }
    }
    machine start(spectrum: &Spectrum, regions: &mut Regions,
                index: i32 in Wrapping, weight: f64,
                region: i32 in Wrapping) -> bool {
        regions.starts[region] = index;
        regions.area_fifteenths[region] = 0.0;
        regions.moment_fifteenths[region] = 0.0;
        regions.open = true;
        transition { _ -> add(spectrum, regions, index, weight, region) }
    }
    machine add(spectrum: &Spectrum, regions: &mut Regions,
              index: i32 in Wrapping, weight: f64,
              region: i32 in Wrapping) -> bool {
        let coordinate: f64 = spectrum.origin + spectrum.spacing * F64::from_i32(index as i32);
        regions.ends[region] = index;
        regions.area_fifteenths[region] = regions.area_fifteenths[region] + weight;
        regions.moment_fifteenths[region] = regions.moment_fifteenths[region] + weight * coordinate;
        transition { _ -> scan(spectrum, regions, index + 1) }
    }
    machine gap(spectrum: &Spectrum, regions: &mut Regions,
              index: i32 in Wrapping) -> bool {
        transition regions.open {
            true -> close(spectrum, regions, index)
            false -> scan(spectrum, regions, index + 1)
        }
    }
    machine close(spectrum: &Spectrum, regions: &mut Regions,
                index: i32 in Wrapping) -> bool {
        let region: i32 in Wrapping = regions.count;
        transition region >= 0 && region < 8 {
            true -> centroid(spectrum, regions, index, region)
            false -> false
        }
    }
    machine centroid(spectrum: &Spectrum, regions: &mut Regions,
                   index: i32 in Wrapping, region: i32 in Wrapping) -> bool {
        // Every open region contains a bin with weight >= positive threshold.
        regions.centroids[region] = regions.moment_fifteenths[region] / regions.area_fifteenths[region] + spectrum.calibration;
        regions.count = region + 1;
        regions.open = false;
        transition index < 16 {
            true -> scan(spectrum, regions, index + 1)
            false -> true
        }
    }
    machine flush(spectrum: &Spectrum, regions: &mut Regions) -> bool {
        transition regions.open {
            true -> close(spectrum, regions, 16)
            false -> true
        }
    }
}
