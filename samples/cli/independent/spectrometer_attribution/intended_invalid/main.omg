use omega_language_std::console;

public data InvalidEntry { }
// This is a complete executable source control. It must fail Exact overflow
// admission, independently of the valid application's runtime input rejection.
public machine InvalidEntry::main(application: &mut InvalidEntry) reaches Console
invokes Console;
{
    let maximum: i32 = 2147483647;
    let overflow: i32 = maximum + 1;
    Console::write_line("must never execute");
    Console::exit_process(overflow);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console
invokes Console;
{
    let mut entry_storage: InvalidEntry;
    InvalidEntry::main(&mut entry_storage);
}
