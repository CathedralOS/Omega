use omega_language_std::console;
use input::parser;
use data::dataset;
use partition::allocation;
use partition::audit;
use report::output;

data Main {
    tokens: Tokens;
    data: Dataset;
    allocation: Allocation;
    audit: Audit;
}
machine Main::main(context: &mut Main) reaches Console {
    block Tokens::read(&mut context.tokens);
    Dataset::load(&mut context.data, &context.tokens);
    transition context.data.valid {
        true -> solve(context)
        _ -> invalid(context)
    }
    machine solve(context: &mut Main) {
        Allocation::solve(&mut context.allocation, &context.data);
        transition context.allocation.found {
            true -> audit(context)
            _ -> infeasible(context)
        }
    }
    machine audit(context: &mut Main) {
        Audit::check(&mut context.audit, &context.data, &context.allocation);
        transition context.audit.valid {
            true -> output(context)
            _ -> corrupt(context)
        }
    }
    machine corrupt(context: &mut Main) {
        Console::write_line("ERROR audit_failed");
        Console::exit_process(66);
    }
    machine output(context: &mut Main) {
        report(&context.data, &context.allocation, &context.audit);
        Console::write("leakage "); number(context.audit.leakage); Console::write_line("");
        Console::exit_process(0);
    }
    machine invalid(context: &mut Main) {
        Console::write_line("ERROR invalid_input");
        Console::exit_process(64);
    }
    machine infeasible(context: &mut Main) {
        Console::write_line("ERROR indivisible_single_group");
        Console::exit_process(65);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
