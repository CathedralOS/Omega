use omega_language_std::console;
use omega::language::core::binding;
use input::parser;
use data::dataset;
use partition::allocation;
use partition::audit;
use report::output;

data Main {
    console: Binding<Console>;
    tokens: Tokens;
    data: Dataset;
    allocation: Allocation;
    audit: Audit;
}
machine Main::main(context: &mut Main) reaches Console {
    block Tokens::read(&context.console, &mut context.tokens);
    Dataset::load(&mut context.data, &context.tokens);
    transition context.data.valid {
        true -> solve(context)
        _ -> invalid(context)
    }
    state solve(context: &mut Main) {
        Allocation::solve(&mut context.allocation, &context.data);
        transition context.allocation.found {
            true -> audit(context)
            _ -> infeasible(context)
        }
    }
    state audit(context: &mut Main) {
        Audit::check(&mut context.audit, &context.data, &context.allocation);
        transition context.audit.valid {
            true -> output(context)
            _ -> corrupt(context)
        }
    }
    state corrupt(context: &mut Main) {
        context.console.write_line("ERROR audit_failed");
        context.console.exit_process(66);
    }
    state output(context: &mut Main) {
        report(&context.console, &context.data, &context.allocation, &context.audit);
        context.console.write("leakage "); number(&context.console, context.audit.leakage); context.console.write_line("");
        context.console.exit_process(0);
    }
    state invalid(context: &mut Main) {
        context.console.write_line("ERROR invalid_input");
        context.console.exit_process(64);
    }
    state infeasible(context: &mut Main) {
        context.console.write_line("ERROR indivisible_single_group");
        context.console.exit_process(65);
    }
}
