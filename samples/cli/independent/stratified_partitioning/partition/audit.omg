// Materialize row assignments, then check conservation and every same-group
// pair. Reporting consumes these audited assignments rather than recomputing.
use data::dataset;
use partition::allocation;
public data Audit {
    assignments: [i32; 16] in Saturating;
    counts: [i32; 3] in Saturating;
    test_count: i32 in Saturating;
    leakage: i32 in Saturating;
    valid: bool;
}
public machine Audit::check(audit: &mut Audit, data: &Dataset, result: &Allocation) {
    transition { _ -> rows(audit, data, result, 0) }
    machine rows(audit: &mut Audit, data: &Dataset, result: &Allocation, index: i32 in Saturating) {
        transition index >= 0 && index < 16 && index < data.count {
            true -> assign(audit, data, result, index)
            _ -> pairs(audit, data, result, 0, 0)
        }
    }
    machine assign(audit: &mut Audit, data: &Dataset, result: &Allocation, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        let included: bool = selected(result.mask, data.records[index].group);
        transition included {
            true -> test(audit, data, result, index)
            _ -> train(audit, data, result, index)
        }
    }
    machine train(audit: &mut Audit, data: &Dataset, result: &Allocation, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        audit.assignments[index] = 0;
        transition { _ -> rows(audit, data, result, index + 1) }
    }
    machine test(audit: &mut Audit, data: &Dataset, result: &Allocation, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        audit.assignments[index] = 1;
        audit.test_count = audit.test_count + 1;
        transition data.records[index].stratum {
            1 -> first(audit, data, result, index)
            2 -> second(audit, data, result, index)
            _ -> third(audit, data, result, index)
        }
    }
    machine first(audit: &mut Audit, data: &Dataset, result: &Allocation, index: i32 in Saturating) {
        audit.counts[0] = audit.counts[0] + 1;
        transition { _ -> rows(audit, data, result, index + 1) }
    }
    machine second(audit: &mut Audit, data: &Dataset, result: &Allocation, index: i32 in Saturating) {
        audit.counts[1] = audit.counts[1] + 1;
        transition { _ -> rows(audit, data, result, index + 1) }
    }
    machine third(audit: &mut Audit, data: &Dataset, result: &Allocation, index: i32 in Saturating) {
        audit.counts[2] = audit.counts[2] + 1;
        transition { _ -> rows(audit, data, result, index + 1) }
    }
    machine pairs(audit: &mut Audit, data: &Dataset, result: &Allocation, left: i32 in Saturating, right: i32 in Saturating) {
        transition left < data.count && left >= 0 && left < 16 {
            true -> right_guard(audit, data, result, left, right)
            _ -> finish(audit, data, result)
        }
    }
    machine right_guard(audit: &mut Audit, data: &Dataset, result: &Allocation, left: i32 in Saturating, right: i32 in Saturating) {
        transition right < data.count && left >= 0 && left < 16 && right >= 0 && right < 16 {
            true -> compare(audit, data, result, left, right)
            _ -> pairs(audit, data, result, left + 1, 0)
        }
    }
    machine compare(audit: &mut Audit, data: &Dataset, result: &Allocation, left: i32 in Saturating, right: i32 in Saturating)
    requires left >= 0 && left < 16 && right >= 0 && right < 16
    {
        transition data.records[left].group == data.records[right].group && audit.assignments[left] != audit.assignments[right] {
            true -> leak(audit, data, result, left, right)
            _ -> pairs(audit, data, result, left, right + 1)
        }
    }
    machine leak(audit: &mut Audit, data: &Dataset, result: &Allocation, left: i32 in Saturating, right: i32 in Saturating) {
        audit.leakage = audit.leakage + 1;
        transition { _ -> pairs(audit, data, result, left, right + 1) }
    }
    machine finish(audit: &mut Audit, data: &Dataset, result: &Allocation) {
        audit.valid = audit.leakage == 0 && audit.test_count == result.test_count && audit.test_count > 0 && audit.test_count < data.count && audit.counts[0] == result.counts[0] && audit.counts[1] == result.counts[1] && audit.counts[2] == result.counts[2];
    }
}
