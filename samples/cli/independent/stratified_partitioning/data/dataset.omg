use input::parser;
public data Record [copy] {
    id: i32 in Saturating;
    group: i32 in Saturating;
    stratum: i32 in Saturating;
}
public data Dataset {
    records: [Record; 16];
    totals: [i32; 3] in Saturating;
    count: i32 in Saturating;
    numerator: i32 in Saturating;
    denominator: i32 in Saturating;
    valid: bool;
}
public machine Dataset::load(data: &mut Dataset, tokens: &Tokens) {
    data.numerator = Tokens::at(tokens, 0);
    data.denominator = Tokens::at(tokens, 1);
    data.count = Tokens::at(tokens, 2);
    data.valid = false;
    transition tokens.valid && data.count >= 2 && data.count <= 16 && data.numerator >= 1 && data.numerator < data.denominator && data.denominator <= 9 && tokens.count == 3 + 3 * data.count {
        true -> row(data, tokens, 0)
        _ -> done(data)
    }
    state row(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating) {
        transition index < data.count && index >= 0 && index < 16 {
            true -> read_row(data, tokens, index)
            _ -> valid(data)
        }
    }
    state read_row(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        let id: i32 in Saturating = Tokens::at(tokens, 3 + 3 * index);
        let group: i32 in Saturating = Tokens::at(tokens, 4 + 3 * index);
        let stratum: i32 in Saturating = Tokens::at(tokens, 5 + 3 * index);
        transition id >= 1 && id <= 99 && group >= 1 && group <= 8 && stratum >= 1 && stratum <= 3 {
            true -> unique(data, tokens, index, id, group, stratum, 0)
            _ -> done(data)
        }
    }
    state unique(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating, id: i32 in Saturating, group: i32 in Saturating, stratum: i32 in Saturating, previous: i32 in Saturating) {
        transition previous < index && previous >= 0 && previous < 16 {
            true -> compare(data, tokens, index, id, group, stratum, previous)
            _ -> put_guard(data, tokens, index, id, group, stratum)
        }
    }
    state compare(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating, id: i32 in Saturating, group: i32 in Saturating, stratum: i32 in Saturating, previous: i32 in Saturating)
    requires previous >= 0 && previous < 16
    {
        transition data.records[previous].id == id {
            true -> done(data)
            _ -> unique(data, tokens, index, id, group, stratum, previous + 1)
        }
    }
    state put_guard(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating, id: i32 in Saturating, group: i32 in Saturating, stratum: i32 in Saturating) {
        transition index >= 0 && index < 16 {
            true -> put(data, tokens, index, id, group, stratum)
            _ -> done(data)
        }
    }
    state put(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating, id: i32 in Saturating, group: i32 in Saturating, stratum: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        data.records[index].id = id;
        data.records[index].group = group;
        data.records[index].stratum = stratum;
        transition stratum {
            1 -> first(data, tokens, index)
            2 -> second(data, tokens, index)
            _ -> third(data, tokens, index)
        }
    }
    state first(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating) {
        data.totals[0] = data.totals[0] + 1;
        transition { _ -> row(data, tokens, index + 1) }
    }
    state second(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating) {
        data.totals[1] = data.totals[1] + 1;
        transition { _ -> row(data, tokens, index + 1) }
    }
    state third(data: &mut Dataset, tokens: &Tokens, index: i32 in Saturating) {
        data.totals[2] = data.totals[2] + 1;
        transition { _ -> row(data, tokens, index + 1) }
    }
    state valid(data: &mut Dataset) { data.valid = true; }
    state done(data: &mut Dataset) { }
}
