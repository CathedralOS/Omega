// Private decimal token reader. Reject overflow before multiplying; at most
// 256 input bytes and 51 tokens, so malformed input cannot grow storage.
use omega_language_std::console;
use omega::language::core::binding;
pub data Tokens {
    values: [i32; 51] in Saturating;
    count: i32 in Saturating;
    value: i32 in Saturating;
    bytes: i32 in Saturating;
    digits: bool;
    valid: bool;
}
pub machine Tokens::read(console: &Binding<Console>, tokens: &mut Tokens)
reaches Console
invokes console;
blocks;
crashes Trap
{
    tokens.valid = true;
    transition { _ -> scan(console, tokens) }
    state scan(console: &Binding<Console>, tokens: &mut Tokens) {
        transition tokens.bytes < 256 {
            true -> pull(console, tokens)
            _ -> reject(tokens)
        }
    }
    state pull(console: &Binding<Console>, tokens: &mut Tokens) {
        let observed: ByteRead = block Console::read_byte(console);
        tokens.bytes = tokens.bytes + 1;
        transition observed {
            ByteRead::Eof -> finish(tokens)
            ByteRead::Byte { value } -> classify(console, tokens, value)
        }
    }
    state classify(console: &Binding<Console>, tokens: &mut Tokens, byte: i32) {
        transition byte >= 48 && byte <= 57 {
            true -> digit(console, tokens, byte)
            _ -> separator(console, tokens, byte)
        }
    }
    state digit(console: &Binding<Console>, tokens: &mut Tokens, byte: i32) {
        transition tokens.value < 100 {
            true -> accumulate(console, tokens, byte)
            _ -> reject(tokens)
        }
    }
    state accumulate(console: &Binding<Console>, tokens: &mut Tokens, byte: i32) {
        tokens.value = tokens.value * 10 + (byte as i32 in Saturating) - 48;
        tokens.digits = true;
        transition { _ -> scan(console, tokens) }
    }
    state separator(console: &Binding<Console>, tokens: &mut Tokens, byte: i32) {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> flush(console, tokens)
            _ -> reject(tokens)
        }
    }
    state flush(console: &Binding<Console>, tokens: &mut Tokens) {
        transition tokens.digits {
            true -> capacity(console, tokens)
            _ -> scan(console, tokens)
        }
    }
    state capacity(console: &Binding<Console>, tokens: &mut Tokens) {
        transition tokens.count >= 0 && tokens.count < 51 {
            true -> store(console, tokens)
            _ -> reject(tokens)
        }
    }
    state store(console: &Binding<Console>, tokens: &mut Tokens) {
        tokens.values[tokens.count] = tokens.value;
        tokens.count = tokens.count + 1;
        tokens.value = 0;
        tokens.digits = false;
        transition { _ -> scan(console, tokens) }
    }
    state finish(tokens: &mut Tokens) {
        transition tokens.digits {
            true -> final_capacity(tokens)
            _ -> done(tokens)
        }
    }
    state final_capacity(tokens: &mut Tokens) {
        transition tokens.count >= 0 && tokens.count < 51 {
            true -> final_store(tokens)
            _ -> reject(tokens)
        }
    }
    state final_store(tokens: &mut Tokens) {
        tokens.values[tokens.count] = tokens.value;
        tokens.count = tokens.count + 1;
    }
    state done(tokens: &mut Tokens) { }
    state reject(tokens: &mut Tokens) { tokens.valid = false; }
}
pub machine Tokens::at(tokens: &Tokens, index: i32 in Saturating) -> i32 in Saturating {
    transition index >= 0 && index < 51 {
        true -> read(tokens, index)
        _ -> (-1)
    }
    state read(tokens: &Tokens, index: i32 in Saturating) -> i32 in Saturating
    requires index >= 0 && index < 51
    { tokens.values[index] }
}
