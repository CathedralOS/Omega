use omega_language_std::console;
use data::dataset;
use partition::allocation;
use partition::audit;
use omega::language::core::binding;
pub machine number(console: &Binding<Console>, value: i32 in Saturating)
reaches Console
invokes Console;
{
    Console::write_byte(console, ((value / 100) % 10 + 48) as i32);
    Console::write_byte(console, ((value / 10) % 10 + 48) as i32);
    Console::write_byte(console, (value % 10 + 48) as i32);
}
pub machine report(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit)
reaches Console
invokes Console;
{
    Console::write(console, "mask "); number(console, result.mask); Console::write_line(console, "");
    Console::write(console, "train "); number(console, data.count - result.test_count);
    Console::write(console, " test "); number(console, result.test_count); Console::write_line(console, "");
    Console::write(console, "score "); number(console, result.score);
    Console::write(console, " total_error "); number(console, result.total_error); Console::write_line(console, "");
    transition { _ -> rows(console, data, result, audit, 1) }
    // Canonical output sorted by record ID, independent of input order.
    state rows(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit, id: i32 in Saturating) {
        transition id <= 99 {
            true -> find(console, data, result, audit, id, 0)
            _ -> metrics(console, data, result, audit)
        }
    }
    state find(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit, id: i32 in Saturating, index: i32 in Saturating) {
        transition index < data.count && index >= 0 && index < 16 {
            true -> match_id(console, data, result, audit, id, index)
            _ -> rows(console, data, result, audit, id + 1)
        }
    }
    state match_id(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit, id: i32 in Saturating, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        transition data.records[index].id == id {
            true -> assignment(console, data, result, audit, id, index)
            _ -> find(console, data, result, audit, id, index + 1)
        }
    }
    state assignment(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit, id: i32 in Saturating, index: i32 in Saturating)
    requires index >= 0 && index < 16
    {
        Console::write(console, "id "); number(console, id);
        Console::write(console, " group "); number(console, data.records[index].group);
        let included: bool = audit.assignments[index] == 1;
        transition included {
            true -> test(console, data, result, audit, id)
            _ -> train(console, data, result, audit, id)
        }
    }
    state test(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit, id: i32 in Saturating) {
        Console::write_line(console, " test");
        transition { _ -> rows(console, data, result, audit, id + 1) }
    }
    state train(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit, id: i32 in Saturating) {
        Console::write_line(console, " train");
        transition { _ -> rows(console, data, result, audit, id + 1) }
    }
    state metrics(console: &Binding<Console>, data: &Dataset, result: &Allocation, audit: &Audit) {
        Console::write(console, "stratum 001 total "); number(console, data.totals[0]);
        Console::write(console, " test "); number(console, result.counts[0]);
        Console::write(console, " error "); number(console, absolute(data.denominator * result.counts[0] - data.numerator * data.totals[0])); Console::write_line(console, "");
        Console::write(console, "stratum 002 total "); number(console, data.totals[1]);
        Console::write(console, " test "); number(console, result.counts[1]);
        Console::write(console, " error "); number(console, absolute(data.denominator * result.counts[1] - data.numerator * data.totals[1])); Console::write_line(console, "");
        Console::write(console, "stratum 003 total "); number(console, data.totals[2]);
        Console::write(console, " test "); number(console, result.counts[2]);
        Console::write(console, " error "); number(console, absolute(data.denominator * result.counts[2] - data.numerator * data.totals[2])); Console::write_line(console, "");
        transition result.score == 0 {
            true -> exact(console)
            _ -> approximate(console)
        }
    }
    state exact(console: &Binding<Console>) { Console::write_line(console, "balance exact"); }
    state approximate(console: &Binding<Console>) { Console::write_line(console, "balance impossible_exact"); }
}
