// Discrete far-field model: c/f_s equals one geometry unit; cardinal unit
// vectors yield exact signed sample delays. Alignment reads sample t + r dot u
// at t=2..5. Finite observations are never padded or extrapolated.
use domain::records;

public machine analyze(records: &mut Beamforming) -> u64 {
    records.active = 0;
    records.best = 0;
    transition { _ -> decode(records, 0) }
    state decode(records: &mut Beamforming, channel: u64) -> u64
    requires channel < 3 {
        let base: u64 = channel * 12;
        transition base <= 24 {
            true -> header(records, channel, base)
            false -> invalid(4)
        }
    }
    state header(records: &mut Beamforming, channel: u64, base: u64) -> u64
    requires channel < 3 requires base <= 24 {
        let enabled: u64 = records.raw[base];
        let timestamp: u64 = records.raw[base + 1];
        let horizontal: u64 = records.raw[base + 2];
        let vertical: u64 = records.raw[base + 3];
        transition enabled <= 1 && horizontal <= 2 && vertical <= 2 {
            true -> timing(records, channel, base, enabled, timestamp, horizontal, vertical)
            false -> invalid(1)
        }
    }
    state timing(records: &mut Beamforming, channel: u64, base: u64, enabled: u64,
                 timestamp: u64, horizontal: u64, vertical: u64) -> u64
    requires channel < 3 requires base <= 24 {
        transition enabled == 0 || timestamp == 0 {
            true -> save(records, channel, base, enabled, horizontal, vertical)
            false -> invalid(2)
        }
    }
    state save(records: &mut Beamforming, channel: u64, base: u64,
               enabled: u64, horizontal: u64, vertical: u64) -> u64
    requires channel < 3 requires base <= 24 {
        records.enabled[channel] = enabled;
        records.horizontal[channel] = horizontal;
        records.vertical[channel] = vertical;
        records.active = records.active + enabled as i64 in Wrapping;
        transition { _ -> sample(records, channel, base, 0) }
    }
    state sample(records: &mut Beamforming, channel: u64, base: u64, position: u64) -> u64
    requires channel < 3 requires base <= 24 requires position < 8 {
        let index: u64 = base + 4 + position;
        transition index < 36 {
            true -> copy(records, channel, base, position, index)
            false -> invalid(4)
        }
    }
    state copy(records: &mut Beamforming, channel: u64, base: u64, position: u64, index: u64) -> u64
    requires channel < 3 requires base <= 24 requires position < 8 requires index < 36 {
        let amplitude: u64 = records.raw[index];
        transition amplitude <= 8 {
            true -> amplitude(records, channel, base, position, amplitude)
            false -> invalid(1)
        }
    }
    state amplitude(records: &mut Beamforming, channel: u64, base: u64,
                    position: u64, amplitude: u64) -> u64
    requires channel < 3 requires base <= 24 requires position < 8
    requires amplitude <= 8 {
        records.samples[channel][position] = amplitude as i64 in Wrapping - 4;
        let next: u64 = position + 1;
        transition next < 8 {
            true -> sample(records, channel, base, next)
            false -> next_channel(records, channel + 1)
        }
    }
    state next_channel(records: &mut Beamforming, next: u64) -> u64 {
        transition next < 3 {
            true -> decode(records, next)
            false -> ready(records)
        }
    }
    state ready(records: &mut Beamforming) -> u64 {
        transition records.active > 0 {
            true -> direction(records, 0)
            false -> invalid(3)
        }
    }
    state direction(records: &mut Beamforming, direction: u64) -> u64
    requires direction < 4 {
        records.energy[direction] = 0;
        transition { _ -> accumulate(records, direction, 0, 0, 0) }
    }
    state accumulate(records: &mut Beamforming, direction: u64, position: u64,
                     channel: u64, total: i64 in Wrapping) -> u64
    requires direction < 4 requires position < 4 requires channel < 3 {
        let horizontal: u64 = records.horizontal[channel];
        let vertical: u64 = records.vertical[channel];
        transition records.enabled[channel] == 0 {
            true -> next_sample(records, direction, position, channel + 1, total)
            false -> delay(records, direction, position, channel, total, horizontal, vertical)
        }
    }
    state delay(records: &mut Beamforming, direction: u64, position: u64, channel: u64,
                total: i64 in Wrapping, horizontal: u64, vertical: u64) -> u64
    requires direction < 4 requires position < 4 requires channel < 3 {
        transition horizontal <= 2 && vertical <= 2 {
            true -> select(records, direction, position, channel, total, horizontal, vertical)
            false -> invalid(4)
        }
    }
    state select(records: &mut Beamforming, direction: u64, position: u64, channel: u64,
                 total: i64 in Wrapping, horizontal: u64, vertical: u64) -> u64
    requires direction < 4 requires position < 4 requires channel < 3
    requires horizontal <= 2 requires vertical <= 2 {
        let offset: u64 = match direction {
            0 -> horizontal,
            1 -> 2 - horizontal,
            2 -> vertical,
            _ -> 2 - vertical
        };
        let index: u64 = position + 1 + offset;
        transition index < 8 {
            true -> add(records, direction, position, channel, total, index)
            false -> invalid(4)
        }
    }
    state add(records: &mut Beamforming, direction: u64, position: u64, channel: u64,
              total: i64 in Wrapping, index: u64) -> u64
    requires direction < 4 requires position < 4 requires channel < 3 requires index < 8 {
        let next: i64 in Wrapping = total + records.samples[channel][index];
        transition { _ -> next_sample(records, direction, position, channel + 1, next) }
    }
    state next_sample(records: &mut Beamforming, direction: u64, position: u64,
                      channel: u64, total: i64 in Wrapping) -> u64
    requires direction < 4 requires position < 4 {
        transition channel < 3 {
            true -> accumulate(records, direction, position, channel, total)
            false -> store(records, direction, position, total)
        }
    }
    state store(records: &mut Beamforming, direction: u64, position: u64,
                total: i64 in Wrapping) -> u64
    requires direction < 4 requires position < 4 {
        records.waveform[direction][position] = total;
        records.energy[direction] = records.energy[direction] + total * total;
        let next: u64 = position + 1;
        transition next < 4 {
            true -> accumulate(records, direction, next, 0, 0)
            false -> score(records, direction)
        }
    }
    state score(records: &mut Beamforming, direction: u64) -> u64 requires direction < 4 {
        transition records.energy[direction] > records.best {
            true -> maximum(records, direction)
            false -> advance(records, direction + 1)
        }
    }
    state maximum(records: &mut Beamforming, direction: u64) -> u64 requires direction < 4 {
        records.best = records.energy[direction];
        transition { _ -> advance(records, direction + 1) }
    }
    state advance(records: &mut Beamforming, next: u64) -> u64 {
        transition next < 4 {
            true -> direction(records, next)
            false -> invalid(0)
        }
    }
    state invalid(status: u64) -> u64 { status }
}
