// Closed stdin is an invalid empty request; the generic sample harness uses EOF.
// Expected exit: 64.
// Expected output contains: INVALID expected M 0D with M=1..6 density=1..8
use omega_language_std::console;
use omega::language::core::float_operations;
use physics::model;
use reporting::numbers;

data Main {
    input: [u8; 16];
    mode: i32;
    particle: Particle;
    timestep: f64;
    steps: u64;
}

// Protocol: one bounded line "M 0D", M=1..6 and density D=1..8. EOF without LF
// is accepted, CRLF is accepted, full buffers and trailing bytes are rejected.
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let read: LineReadResult = block Console::read_line(&mut main.input);
    transition read {
        LineReadResult::LineComplete { count } -> line(main, count)
        LineReadResult::EndOfInput { count } -> end(main, count)
        _ -> invalid(main)
    }
    machine line(main: &mut Main, count: u64) {
        transition {
            count == 5 && main.input[4] == 10 -> parse(main)
            count == 6 && main.input[4] == 13 && main.input[5] == 10 -> parse(main)
            _ -> invalid(main)
        }
    }
    machine end(main: &mut Main, count: u64) {
        transition count == 4 { true -> parse(main) false -> invalid(main) }
    }
    machine parse(main: &mut Main) {
        transition {
            main.input[0] >= 49 && main.input[0] <= 54 && main.input[1] == 32 && main.input[2] == 48 && main.input[3] >= 49 && main.input[3] <= 56 -> initialize(main)
            _ -> invalid(main)
        }
    }
    machine initialize(main: &mut Main) {
        main.mode = (main.input[0] as i32) - 48;
        let density: i32 = (main.input[3] as i32) - 48;
        main.particle.density = F64::from_i32(density);
        main.particle.depth = 0.0;
        main.particle.velocity = 0.0;
        main.timestep = 0.5;
        main.steps = 8;
        configure(main);
        Console::write_line("MODEL unit-volume unit-gravity semi-implicit sampled-layers microunits");
        Console::write("INPUT "); number(main.mode);
        Console::write(" "); number(density); Console::write_line("");
        transition { _ -> balances(main, 0) }
    }
    machine balances(main: &mut Main, index: i32) {
        let fluid: Layer = layer(index);
        let speed: f64 = terminal_velocity(main.particle.density, fluid);
        let residual: f64 = force(main.particle.density, fluid, speed);
        transition absolute(residual) <= 0.00000001 {
            true -> balance_report(main, index, speed, residual)
            false -> failure(main)
        }
    }
    machine balance_report(main: &mut Main, index: i32, speed: f64, residual: f64) {
        Console::write("BALANCE "); number(index);
        Console::write(" "); micro(speed);
        Console::write(" "); micro(residual); Console::write_line("");
        transition index < 2 { true -> balances(main, index + 1) false -> start(main) }
    }
    machine start(main: &mut Main) {
        let index: i32 = selected_layer(main.mode, main.particle.depth);
        regime(index, main.particle.density);
        trace(0, index, main.particle, 0.0, 0.0);
        transition { _ -> iterate(main, main.steps, 1) }
    }
    machine iterate(main: &mut Main, remaining: u64, step: i32) {
        transition remaining > 0 { true -> integrate(main, remaining, step) false -> done(main) }
    }
    machine integrate(main: &mut Main, remaining: u64, step: i32) {
        let before: i32 = selected_layer(main.mode, main.particle.depth);
        let fluid: Layer = layer(before);
        let result: Step = advance(&mut main.particle, fluid, main.timestep);
        transition absolute(result.residual) <= 0.00000001 && absolute(main.particle.velocity) < 16.0 && absolute(main.particle.depth) < 16.0 {
            true -> bounded(main, remaining, step, before, result)
            false -> failure(main)
        }
    }
    machine bounded(main: &mut Main, remaining: u64, step: i32, before: i32, result: Step) {
        transition {
            main.particle.depth >= 8.0 -> bottom(main, step, before, result)
            main.particle.depth <= -8.0 -> top(main, step, before, result)
            _ -> report(main, remaining, step, before, result)
        }
    }
    machine report(main: &mut Main, remaining: u64, step: i32, before: i32, result: Step) {
        let after: i32 = selected_layer(main.mode, main.particle.depth);
        crossing(step, before, after, main.particle.density);
        trace(step, before, main.particle, result.force, result.residual);
        transition { _ -> iterate(main, remaining - 1, ((step as i32 in Wrapping) + 1) as i32) }
    }
    machine bottom(main: &mut Main, step: i32, before: i32, result: Step) {
        main.particle.depth = 8.0;
        trace(step, before, main.particle, result.force, result.residual);
        Console::write_line("BOUND bottom");
        transition { _ -> done(main) }
    }
    machine top(main: &mut Main, step: i32, before: i32, result: Step) {
        main.particle.depth = -8.0;
        trace(step, before, main.particle, result.force, result.residual);
        Console::write_line("BOUND top");
        transition { _ -> done(main) }
    }
    machine done(main: &mut Main) { Console::write_line("DONE"); Console::exit_process(0); }
    machine invalid(main: &mut Main) { Console::write_line("INVALID expected M 0D with M=1..6 density=1..8"); Console::exit_process(64); }
    machine failure(main: &mut Main) { Console::write_line("FAIL force residual or finite envelope"); Console::exit_process(70); }
}

machine configure(main: &mut Main) {
    transition main.mode {
        3 -> rise(main)
        4 -> relaxation(main)
        5 -> refined(main)
        6 -> boundary(main)
        _ -> unchanged()
    }
    machine rise(main: &mut Main) { main.particle.depth = 3.0; main.timestep = 0.25; main.steps = 16; }
    machine relaxation(main: &mut Main) { main.particle.velocity = 1.0; }
    machine refined(main: &mut Main) { main.timestep = 0.25; main.steps = 16; }
    machine boundary(main: &mut Main) { main.particle.depth = 7.75; main.particle.velocity = 2.0; }
    machine unchanged() {}
}

machine selected_layer(mode: i32, depth: f64) -> i32 {
    transition mode == 1 || mode == 4 { true -> homogeneous() false -> layered(depth) }
    machine homogeneous() -> i32 { 0 }
    machine layered(depth: f64) -> i32 { layer_at(depth) }
}

machine regime(index: i32, density: f64) reaches Console invokes Console; {
    Console::write("REGIME "); number(index);
    transition index == 1 { true -> quadratic(index, density) false -> linear(index, density) }
    machine quadratic(index: i32, density: f64) { Console::write_line(" quadratic"); neutral(index, density); }
    machine linear(index: i32, density: f64) { Console::write_line(" linear"); neutral(index, density); }
}
machine neutral(index: i32, density: f64) reaches Console invokes Console; {
    let fluid: Layer = layer(index);
    transition density == fluid.density { true -> report(index) false -> quiet() }
    machine report(index: i32) { Console::write("NEUTRAL "); number(index); Console::write_line(""); }
    machine quiet() {}
}
machine crossing(step: i32, before: i32, after: i32, density: f64) reaches Console invokes Console; {
    transition before != after { true -> report(step, before, after, density) false -> quiet() }
    machine report(step: i32, before: i32, after: i32, density: f64) {
        Console::write("CROSS "); number(step); Console::write(" "); number(before); Console::write(" "); number(after); Console::write_line("");
        regime(after, density);
    }
    machine quiet() {}
}
machine trace(step: i32, index: i32, particle: Particle, net: f64, residual: f64) reaches Console invokes Console; crashes Trap {
    Console::write("TRACE "); number(step); Console::write(" "); number(index);
    Console::write(" "); micro(particle.depth); Console::write(" "); micro(particle.velocity);
    Console::write(" "); micro(net); Console::write(" "); micro(residual); Console::write_line("");
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
