// Whitespace-separated unsigned decimal tokens, at most three digits.
// Admission checks happen on actual bytes; no wrapping or truncation is accepted.
use omega_language_std::console;
public data Parsed [copy] { value: u64; valid: bool; }
public machine read_number() -> Parsed
reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> skip() }
    machine skip() -> Parsed {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> invalid()
            ByteRead::Byte { value } -> start(value)
        }
    }
    machine start(byte: i32) -> Parsed {
        transition byte == 32 || byte == 10 || byte == 13 || byte == 9 {
            true -> skip()
            false -> first(byte)
        }
    }
    machine first(byte: i32) -> Parsed {
        transition byte >= 48 && byte <= 57 {
            true -> initial(byte)
            false -> invalid()
        }
    }
    machine initial(byte: i32) -> Parsed
    requires byte >= 48 && byte <= 57 {
        transition { _ -> scan((byte - 48) as u64, 1) }
    }
    machine scan(value: u64, digits: u64) -> Parsed
    requires value <= 999
    requires digits >= 1 && digits <= 3 {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> complete(value)
            ByteRead::Byte { value as byte } -> classify(value, digits, byte)
        }
    }
    machine classify(value: u64, digits: u64, byte: i32) -> Parsed
    requires value <= 999
    requires digits >= 1 && digits <= 3 {
        transition byte == 32 || byte == 10 || byte == 13 || byte == 9 {
            true -> complete(value)
            false -> digit(value, digits, byte)
        }
    }
    machine digit(value: u64, digits: u64, byte: i32) -> Parsed {
        transition byte >= 48 && byte <= 57 && value <= 99 && digits >= 1 && digits < 3 {
            true -> append(value, digits, byte)
            false -> invalid()
        }
    }
    machine append(value: u64, digits: u64, byte: i32) -> Parsed
    requires value <= 99
    requires digits >= 1 && digits < 3
    requires byte >= 48 && byte <= 57 {
        transition { _ -> scan(value * 10 + ((byte - 48) as u64), digits + 1) }
    }
    machine complete(value: u64) -> Parsed { Parsed { value: value, valid: true } }
    machine invalid() -> Parsed { Parsed { value: 0, valid: false } }
}

public machine only_whitespace() -> bool
reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> scan() }
    machine scan() -> bool {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> true
            ByteRead::Byte { value } -> check(value)
        }
    }
    machine check(byte: i32) -> bool {
        transition byte == 32 || byte == 10 || byte == 13 || byte == 9 {
            true -> scan()
            false -> false
        }
    }
}
