// All identities and objective values are input data, never array identities.
// Twelve rows bound storage and pairwise work; certificates retain original positions.
use omega_language_std::console;

pub data Experiment [copy] {
    identifier: u64;
    provenance: u64;
    position: u64;
    cost: u64;
    days: u64;
    gain: u64;
    risk: u64;
}
pub data Application {
    rows: [Experiment; 12];
    count: u64;
    budget: u64;
    deadline: u64;
    risk_limit: u64;
}
