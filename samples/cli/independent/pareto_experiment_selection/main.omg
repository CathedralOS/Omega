// IND11: complete runtime research-experiment admission, Pareto selection and report.
use domain::model;
use domain::selection;
use input::numbers;
use report::render;
use omega_language_std::console;

machine Application::main(application: &mut Application) reaches Console {
    let count: Parsed = block read_number();
    let budget: Parsed = block read_number();
    let deadline: Parsed = block read_number();
    let risk_limit: Parsed = block read_number();
    transition count.valid && budget.valid && deadline.valid && risk_limit.valid
        && count.value <= 12 && budget.value > 0 && deadline.value > 0 && risk_limit.value <= 100 {
        true -> configure(application, count.value, budget.value, deadline.value, risk_limit.value)
        false -> invalid(application)
    }
    state configure(application: &mut Application, count: u64, budget: u64, deadline: u64, risk_limit: u64) {
        application.count = count;
        application.budget = budget;
        application.deadline = deadline;
        application.risk_limit = risk_limit;
        transition { _ -> load(application, 0) }
    }
    state load(application: &mut Application, index: u64) {
        transition index < application.count && index < 12 {
            true -> read_row(application, index)
            false -> trailing(application)
        }
    }
    state read_row(application: &mut Application, index: u64)
    requires index < 12 {
        let identifier: Parsed = block read_number();
        let provenance: Parsed = block read_number();
        let cost: Parsed = block read_number();
        let days: Parsed = block read_number();
        let gain: Parsed = block read_number();
        let risk: Parsed = block read_number();
        let repeated: bool = duplicate(application, identifier.value, index);
        transition identifier.valid && provenance.valid && cost.valid && days.valid && gain.valid && risk.valid
            && identifier.value > 0 && provenance.value > 0 && days.value > 0 && risk.value <= 100 && !repeated {
            true -> store(application, index, identifier.value, provenance.value, cost.value, days.value, gain.value, risk.value)
            false -> invalid(application)
        }
    }
    state store(application: &mut Application, index: u64, identifier: u64, provenance: u64, cost: u64, days: u64, gain: u64, risk: u64)
    requires index < 12 {
        application.rows[index] = Experiment { identifier: identifier, provenance: provenance, position: index + 1,
            cost: cost, days: days, gain: gain, risk: risk };
        transition { _ -> load(application, index + 1) }
    }
    state trailing(application: &mut Application) {
        let clean: bool = block only_whitespace();
        transition clean { true -> accepted(application) false -> invalid(application) }
    }
    state accepted(application: &mut Application) {
        report(application);
        Console::exit_process(0);
    }
    state invalid(application: &mut Application) {
        Console::write_line("ERROR|invalid-input");
        Console::exit_process(2);
    }
}
