// Numeric output is computed at runtime through the settled byte console provider.
// Fixed three-digit fields make reports exact byte oracles without floating tolerance.
use domain::model;
use domain::selection;
use omega_language_std::console;
pub machine number(application: &mut Application, value: u64) reaches Console
invokes Console;
requires value <= 999 {
    Console::write_byte(((value / 100) + 48) as i32);
    Console::write_byte((((value / 10) % 10) + 48) as i32);
    Console::write_byte(((value % 10) + 48) as i32);
}
pub machine field(application: &mut Application, value: u64) reaches Console
invokes Console;
requires value <= 999 {
    Console::write("|");
    number(application, value);
}
pub machine report(application: &mut Application) reaches Console
invokes Console;
{
    Console::write_line("PARETO|id|source|position|cost|days|gain|risk|status|certificate");
    transition { _ -> next(application, 0, 0) }
    state next(application: &mut Application, previous: u64, emitted: u64) {
        transition emitted < application.count && emitted < 12 {
            true -> find(application, previous, emitted, 0, 1000, 0)
            false -> done(application)
        }
    }
    state find(application: &mut Application, previous: u64, emitted: u64, index: u64, best: u64, slot: u64)
    requires emitted < 12 {
        transition index < application.count && index < 12 {
            true -> inspect(application, previous, emitted, index, best, slot)
            false -> row(application, emitted, slot)
        }
    }
    state inspect(application: &mut Application, previous: u64, emitted: u64, index: u64, best: u64, slot: u64)
    requires emitted < 12
    requires index < 12 {
        let identifier: u64 = application.rows[index].identifier;
        transition identifier > previous && identifier < best {
            true -> find(application, previous, emitted, index + 1, identifier, index)
            false -> find(application, previous, emitted, index + 1, best, slot)
        }
    }
    state row(application: &mut Application, emitted: u64, slot: u64)
    requires emitted < 12 {
        transition slot < 12 { true -> render(application, emitted, slot) false -> internal_error(application) }
    }
    state render(application: &mut Application, emitted: u64, slot: u64)
    requires emitted < 12
    requires slot < 12 {
        let experiment: Experiment = application.rows[slot];
        let mask: u64 = violations(&experiment, application.budget, application.deadline, application.risk_limit);
        let dominator: u64 = witness(application, &experiment);
        transition experiment.identifier <= 999 && experiment.provenance <= 999 && experiment.position <= 999
            && experiment.cost <= 999 && experiment.days <= 999 && experiment.gain <= 999 && experiment.risk <= 999 {
            true -> values(application, experiment, emitted, mask, dominator)
            false -> internal_error(application)
        }
    }
    state values(application: &mut Application, experiment: Experiment, emitted: u64, mask: u64, dominator: u64)
    requires emitted < 12
    requires experiment.identifier <= 999 && experiment.provenance <= 999 && experiment.position <= 999
    requires experiment.cost <= 999 && experiment.days <= 999 && experiment.gain <= 999 && experiment.risk <= 999 {
        number(application, experiment.identifier);
        field(application, experiment.provenance);
        field(application, experiment.position);
        field(application, experiment.cost);
        field(application, experiment.days);
        field(application, experiment.gain);
        field(application, experiment.risk);
        transition mask > 0 { true -> infeasible(application, experiment.identifier, emitted, mask) false -> feasible(application, experiment.identifier, emitted, dominator) }
    }
    state infeasible(application: &mut Application, identifier: u64, emitted: u64, mask: u64)
    requires emitted < 12 {
        Console::write("|INFEASIBLE");
        transition mask <= 7 { true -> finish(application, identifier, emitted, mask) false -> internal_error(application) }
    }
    state feasible(application: &mut Application, identifier: u64, emitted: u64, dominator: u64)
    requires emitted < 12 {
        transition dominator == 0 { true -> selected(application, identifier, emitted) false -> rejected(application, identifier, emitted, dominator) }
    }
    state selected(application: &mut Application, identifier: u64, emitted: u64)
    requires emitted < 12 {
        Console::write("|SELECTED");
        transition { _ -> finish(application, identifier, emitted, 0) }
    }
    state rejected(application: &mut Application, identifier: u64, emitted: u64, dominator: u64)
    requires emitted < 12 {
        Console::write("|DOMINATED");
        transition dominator <= 999 { true -> finish(application, identifier, emitted, dominator) false -> internal_error(application) }
    }
    state finish(application: &mut Application, identifier: u64, emitted: u64, certificate: u64)
    requires emitted < 12
    requires certificate <= 999 {
        field(application, certificate);
        Console::write_line("");
        transition { _ -> next(application, identifier, emitted + 1) }
    }
    state internal_error(application: &mut Application) {
        Console::write_line("ERROR|internal-invariant");
        Console::exit_process(3);
    }
    state done(application: &mut Application) { Console::write_line("END"); }
}
