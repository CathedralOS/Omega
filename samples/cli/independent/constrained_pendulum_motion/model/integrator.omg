// Scientific sample model: unit mass, gravity 9.81, dt=0.01 seconds.
// Cartesian constrained kick/drift followed by radial and tangent projections.
// Projection is dissipative; energy drift is measured, never called conservation.
use omega::language::core::float_operations;

public data Pendulum {
    length: f64;
    x: f64;
    y: f64;
    vx: f64;
    vy: f64;
    raw_drift: f64;
    drift: f64;
    tangent: f64;
    energy: f64;
}

public machine Pendulum::project(pendulum: &mut Pendulum) {
    let radius_squared: f64 = pendulum.x * pendulum.x + pendulum.y * pendulum.y;
    pendulum.raw_drift = radius_squared - pendulum.length * pendulum.length;
    let radius: f64 = F64::square_root(radius_squared);
    let scale: f64 = pendulum.length / radius;
    pendulum.x = pendulum.x * scale;
    pendulum.y = pendulum.y * scale;
    let radial_velocity: f64 = (pendulum.x * pendulum.vx + pendulum.y * pendulum.vy) / (pendulum.length * pendulum.length);
    pendulum.vx = pendulum.vx - radial_velocity * pendulum.x;
    pendulum.vy = pendulum.vy - radial_velocity * pendulum.y;
    Pendulum::measure(pendulum);
}

public machine Pendulum::measure(pendulum: &mut Pendulum) {
    pendulum.drift = pendulum.x * pendulum.x + pendulum.y * pendulum.y - pendulum.length * pendulum.length;
    pendulum.tangent = pendulum.x * pendulum.vx + pendulum.y * pendulum.vy;
    pendulum.energy = 0.5 * (pendulum.vx * pendulum.vx + pendulum.vy * pendulum.vy) + 9.81 * (pendulum.y + pendulum.length);
}

public machine Pendulum::step(pendulum: &mut Pendulum) {
    let tension: f64 = (pendulum.vx * pendulum.vx + pendulum.vy * pendulum.vy - 9.81 * pendulum.y) / (pendulum.length * pendulum.length);
    let acceleration_x: f64 = 0.0 - tension * pendulum.x;
    let acceleration_y: f64 = 0.0 - 9.81 - tension * pendulum.y;
    pendulum.vx = pendulum.vx + 0.01 * acceleration_x;
    pendulum.vy = pendulum.vy + 0.01 * acceleration_y;
    pendulum.x = pendulum.x + 0.01 * pendulum.vx;
    pendulum.y = pendulum.y + 0.01 * pendulum.vy;
    Pendulum::project(pendulum);
}
