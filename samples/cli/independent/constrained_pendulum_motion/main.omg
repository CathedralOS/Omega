// Expected exit: 64 (empty stdin); valid data fixtures exit 0.
// Expected output contains: INVALID: expected scenario
use omega_language_std::console;
use model::integrator;
use report::report;
use omega::language::core::float_operations;

data Main {
    pendulum: Pendulum;
    scenario: i32;
    step: i32;
    initial_energy: f64;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("NEW021 constrained pendulum; signed micro-units; dt=0.01; gravity=9.81; mass=1");
    let input: ByteRead = block Console::read_byte();
    transition input {
        ByteRead::Byte { value } -> scenario(main, value)
        ByteRead::Eof -> invalid(main)
    }
    state scenario(main: &mut Main, value: i32) {
        transition value >= 48 && value <= 51 {
            true -> length_input(main, value - 48)
            false -> invalid(main)
        }
    }
    state length_input(main: &mut Main, scenario: i32) {
        main.scenario = scenario;
        let input: ByteRead = block Console::read_byte();
        transition input {
            ByteRead::Byte { value } -> length(main, value)
            ByteRead::Eof -> invalid(main)
        }
    }
    state length(main: &mut Main, value: i32) {
        transition value {
            49 -> unit_length(main)
            50 -> double_length(main)
            _ -> invalid(main)
        }
    }
    state unit_length(main: &mut Main) {
        main.pendulum.length = 1.0;
        transition { _ -> newline(main) }
    }
    state double_length(main: &mut Main) {
        main.pendulum.length = 2.0;
        transition { _ -> newline(main) }
    }
    state newline(main: &mut Main) {
        let input: ByteRead = block Console::read_byte();
        transition input {
            ByteRead::Byte { value } -> check_newline(main, value)
            ByteRead::Eof -> invalid(main)
        }
    }
    state check_newline(main: &mut Main, value: i32) {
        transition value == 10 {
            true -> end_input(main)
            false -> invalid(main)
        }
    }
    state end_input(main: &mut Main) {
        let input: ByteRead = block Console::read_byte();
        transition input {
            ByteRead::Eof -> initialize(main)
            ByteRead::Byte { value } -> invalid(main)
        }
    }
    state initialize(main: &mut Main) {
        main.step = 0;
        main.pendulum.vx = 0.0;
        main.pendulum.vy = 0.0;
        transition main.scenario {
            0 -> equilibrium(main)
            1 -> small_angle(main)
            2 -> released(main)
            _ -> displaced(main)
        }
    }
    state equilibrium(main: &mut Main) {
        main.pendulum.x = 0.0;
        main.pendulum.y = 0.0 - main.pendulum.length;
        transition { _ -> project(main) }
    }
    state small_angle(main: &mut Main) {
        main.pendulum.x = 0.01 * main.pendulum.length;
        main.pendulum.y = 0.0 - F64::square_root(main.pendulum.length * main.pendulum.length - main.pendulum.x * main.pendulum.x);
        transition { _ -> project(main) }
    }
    state released(main: &mut Main) {
        main.pendulum.x = 0.6 * main.pendulum.length;
        main.pendulum.y = 0.0 - 0.8 * main.pendulum.length;
        transition { _ -> project(main) }
    }
    state displaced(main: &mut Main) {
        main.pendulum.x = 0.66 * main.pendulum.length;
        main.pendulum.y = 0.0 - 0.88 * main.pendulum.length;
        main.pendulum.vx = 0.3;
        main.pendulum.vy = 0.4;
        transition { _ -> project(main) }
    }
    state project(main: &mut Main) {
        Pendulum::project(&mut main.pendulum);
        main.initial_energy = main.pendulum.energy;
        transition { _ -> row(main) }
    }
    state row(main: &mut Main) {
        Console::write("ROW ");
        print_micro(F64::from_i32(main.step));
        Console::write(" ");
        print_micro(main.pendulum.x);
        Console::write(" ");
        print_micro(main.pendulum.y);
        Console::write(" ");
        print_micro(main.pendulum.vx);
        Console::write(" ");
        print_micro(main.pendulum.vy);
        Console::write(" ");
        print_micro(main.pendulum.raw_drift);
        Console::write(" ");
        print_micro(main.pendulum.drift);
        Console::write(" ");
        print_micro(main.pendulum.tangent);
        Console::write(" ");
        print_micro(main.pendulum.energy);
        Console::write_line("");
        transition main.step >= 0 && main.step < 32 {
            true -> advance(main)
            false -> finish(main)
        }
    }
    state advance(main: &mut Main)
    requires main.step >= 0 && main.step < 32
    {
        main.step = main.step + 1;
        Pendulum::step(&mut main.pendulum);
        transition { _ -> row(main) }
    }
    state finish(main: &mut Main) {
        Console::write("ENERGY_CHANGE ");
        print_micro(main.pendulum.energy - main.initial_energy);
        Console::write_line("");
        Console::write_line("COMPLETE 32 steps");
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) {
        Console::write_line("INVALID: expected scenario 0..3, length 1..2, LF, EOF");
        Console::exit_process(64);
    }
}
