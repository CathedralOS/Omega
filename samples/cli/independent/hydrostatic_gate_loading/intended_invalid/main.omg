// Complete negative control: a strictly ascending elevation interval is
// required before computing a linear slope. A reversed literal violates it.
use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::binding;

machine interval_height(lower: i64, upper: i64) -> f64
requires upper > lower
{
    F64::from_i64(upper) - F64::from_i64(lower)
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let height: f64 = interval_height(2000, 1000);
    transition height > 0.0 {
        true -> done(&main.console)
        false -> done(&main.console)
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 0); }
}
