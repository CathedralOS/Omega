// Local coordinate t=z-lower. Integrating width, pressure*width, and
// z*pressure*width exactly requires polynomials of degree one, two, three.
// No quadrature library or active-worker code is used.
use geometry::profile;
use omega::language::core::float_operations;

public data SegmentLoad [copy] { area: f64; force: f64; first_moment: f64; hinge_moment: f64; }
public machine integrate(segment: WetSegment, water: f64, gamma: f64, hinge: f64) -> SegmentLoad {
    let height: f64 = segment.upper - segment.lower;
    transition height > 0.0 {
        true -> wet(segment, water, gamma, hinge, height)
        false -> zero()
    }
    machine zero() -> SegmentLoad {
        SegmentLoad { area: 0.0, force: 0.0, first_moment: 0.0, hinge_moment: 0.0 }
    }
    machine wet(segment: WetSegment, water: f64, gamma: f64, hinge: f64, height: f64) -> SegmentLoad {
        let slope: f64 = (segment.upper_width - segment.lower_width) / height;
        let depth: f64 = water - segment.lower;
        let square: f64 = height * height;
        let cube: f64 = square * height;
        let fourth: f64 = cube * height;
        let constant: f64 = depth * segment.lower_width;
        let linear: f64 = depth * slope - segment.lower_width;
        let integral: f64 = constant * height + linear * square / 2.0 - slope * cube / 3.0;
        let local_moment: f64 = constant * square / 2.0 + linear * cube / 3.0 - slope * fourth / 4.0;
        let force: f64 = gamma * integral;
        let first: f64 = gamma * (segment.lower * integral + local_moment);
        SegmentLoad { area: height * (segment.lower_width + segment.upper_width) / 2.0,
            force: force, first_moment: first, hinge_moment: first - hinge * force }
    }
}
