// ADD02: Complete offline hydrostatic loading of a vertical gate silhouette.
// Expected exit: 0 for valid bounded stdin; 64 for invalid bounded stdin.
// Expected output contains: HYDROSTATIC_GATE_V1 micro_units (valid input).
// Every domain operation and all bounded scratch data are application-private.
use geometry::profile;
use loading::pressure;
use input::tokens;
use output::numbers;
use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

data Application {
    reader: Reader;
    profile: Profile;
    levels: [f64; 8];
    level_count: u64 in Wrapping;
    gamma: f64;
    hinge: f64;
    area: f64;
    force: f64;
    first_moment: f64;
    hinge_moment: f64;
    wetted_count: i64 in Wrapping;
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut application: Application;
    block Reader::next(&main.console, &mut application.reader);
    transition application.reader.status == 1 && application.reader.value >= 2 && application.reader.value <= 8 {
        true -> header(&main.console, &mut application)
        false -> invalid(&main.console)
    }
    state header(console: &Binding<Console>, application: &mut Application) {
        application.profile.count = application.reader.value as u64 in Wrapping;
        block Reader::next(console, &mut application.reader);
        transition application.reader.status == 1 && application.reader.value >= 1 && application.reader.value <= 8 {
            true -> gamma(console, application)
            false -> invalid(console)
        }
    }
    state gamma(console: &Binding<Console>, application: &mut Application) {
        application.level_count = application.reader.value as u64 in Wrapping;
        block Reader::next(console, &mut application.reader);
        transition application.reader.status == 1 && application.reader.value >= 1 && application.reader.value <= 20000 {
            true -> hinge(console, application)
            false -> invalid(console)
        }
    }
    state hinge(console: &Binding<Console>, application: &mut Application) {
        application.gamma = F64::from_i64(application.reader.value as i64);
        block Reader::next(console, &mut application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 {
            true -> begin_nodes(console, application)
            false -> invalid(console)
        }
    }
    state begin_nodes(console: &Binding<Console>, application: &mut Application) {
        application.hinge = (F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition { _ -> node(console, application, 0) }
    }
    state node(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping) {
        transition index < application.profile.count && index < 8 {
            true -> elevation(console, application, index)
            false -> level(console, application, 0)
        }
    }
    state elevation(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping) {
        block Reader::next(console, &mut application.reader);
        let node_elevation: f64 = F64::from_i64(application.reader.value as i64) / 1000.0;
        transition application.reader.status == 1 && application.reader.value <= 100000 {
            true -> width(console, application, index, node_elevation)
            false -> invalid(console)
        }
    }
    state width(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping, elevation: f64) {
        block Reader::next(console, &mut application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 && index < 8 {
            true -> store_node(console, application, index, elevation)
            false -> invalid(console)
        }
    }
    state store_node(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping, elevation: f64) {
        application.profile.nodes[index].elevation = elevation;
        application.profile.nodes[index].width = (F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition index > 0 {
            true -> validate_order(console, application, index, elevation)
            false -> node(console, application, index + 1)
        }
    }
    state validate_order(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping, elevation: f64) {
        let previous: u64 in Wrapping = index - 1;
        transition previous < 8 && elevation > application.profile.nodes[previous].elevation {
            true -> node(console, application, index + 1)
            false -> invalid(console)
        }
    }
    state level(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping) {
        transition index < application.level_count && index < 8 {
            true -> read_level(console, application, index)
            false -> trailing(console, application)
        }
    }
    state read_level(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping) {
        block Reader::next(console, &mut application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 && index < 8 {
            true -> store_level(console, application, index)
            false -> invalid(console)
        }
    }
    state store_level(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping) {
        application.levels[index] = (F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition { _ -> level(console, application, index + 1) }
    }
    state trailing(console: &Binding<Console>, application: &mut Application) {
        block Reader::next(console, &mut application.reader);
        transition application.reader.status == 0 {
            true -> begin(console, application)
            false -> invalid(console)
        }
    }
    state begin(console: &Binding<Console>, application: &mut Application) {
        Console::write_line(console, "HYDROSTATIC_GATE_V1 micro_units");
        transition { _ -> water(console, application, 0) }
    }
    state water(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping) {
        transition index < application.level_count && index < 8 {
            true -> reset(console, application, index)
            false -> done(console)
        }
    }
    state reset(console: &Binding<Console>, application: &mut Application, index: u64 in Wrapping) {
        application.area = 0.0;
        application.force = 0.0;
        application.first_moment = 0.0;
        application.hinge_moment = 0.0;
        application.wetted_count = 0;
        Console::write(console, "LEVEL "); write_integer(console, index as i64 in Wrapping);
        Console::write(console, " water_um="); write_scaled(console, application.levels[index]);
        Console::write_line(console, "");
        transition { _ -> segment(console, application, index, 0) }
    }
    state segment(console: &Binding<Console>, application: &mut Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping) {
        let next: u64 in Wrapping = segment_index + 1;
        transition next < application.profile.count && next < 8 && segment_index < 8 && water_index < 8 {
            true -> calculate(console, application, water_index, segment_index, next)
            false -> summary(console, application, water_index)
        }
    }
    state calculate(console: &Binding<Console>, application: &mut Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping, next: u64 in Wrapping) {
        let water: f64 = application.levels[water_index];
        let wet: WetSegment = clip(application.profile.nodes[segment_index], application.profile.nodes[next], water);
        transition wet.upper > wet.lower {
            true -> accumulate(console, application, water_index, segment_index, wet, water)
            false -> segment(console, application, water_index, next)
        }
    }
    state accumulate(console: &Binding<Console>, application: &mut Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping, wet: WetSegment, water: f64) {
        let load: SegmentLoad = integrate(wet, water, application.gamma, application.hinge);
        application.area = application.area + load.area;
        application.force = application.force + load.force;
        application.first_moment = application.first_moment + load.first_moment;
        application.hinge_moment = application.hinge_moment + load.hinge_moment;
        application.wetted_count = application.wetted_count + 1;
        Console::write(console, "WET "); write_integer(console, segment_index as i64 in Wrapping);
        Console::write(console, " lower_um="); write_scaled(console, wet.lower);
        Console::write(console, " upper_um="); write_scaled(console, wet.upper);
        Console::write(console, " lower_width_um="); write_scaled(console, wet.lower_width);
        Console::write(console, " upper_width_um="); write_scaled(console, wet.upper_width);
        Console::write(console, " area_micro_m2="); write_scaled(console, load.area);
        Console::write(console, " force_uN="); write_scaled(console, load.force);
        Console::write(console, " moment_uNm="); write_scaled(console, load.hinge_moment);
        Console::write_line(console, "");
        transition { _ -> segment(console, application, water_index, segment_index + 1) }
    }
    state summary(console: &Binding<Console>, application: &mut Application, water_index: u64 in Wrapping) {
        Console::write(console, "TOTAL wetted="); write_integer(console, application.wetted_count);
        Console::write(console, " area_micro_m2="); write_scaled(console, application.area);
        Console::write(console, " force_uN="); write_scaled(console, application.force);
        Console::write(console, " moment_uNm="); write_scaled(console, application.hinge_moment);
        transition application.force > 0.0 {
            true -> center(console, application, water_index)
            false -> dry_summary(console, application, water_index)
        }
    }
    state center(console: &Binding<Console>, application: &mut Application, water_index: u64 in Wrapping) {
        Console::write(console, " center_um="); write_scaled(console, application.first_moment / application.force);
        Console::write_line(console, "");
        transition { _ -> water(console, application, water_index + 1) }
    }
    state dry_summary(console: &Binding<Console>, application: &mut Application, water_index: u64 in Wrapping) {
        Console::write_line(console, " center_um=undefined");
        transition { _ -> water(console, application, water_index + 1) }
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 0); }
    state invalid(console: &Binding<Console>) { Console::write_line(console, "ERROR invalid bounded gate input"); Console::exit_process(console, 64); }
}
