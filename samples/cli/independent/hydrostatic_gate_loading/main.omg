// ADD02: Complete offline hydrostatic loading of a vertical gate silhouette.
// Expected exit: 0 for valid bounded stdin; 64 for invalid bounded stdin.
// Expected output contains: HYDROSTATIC_GATE_V1 micro_units (valid input).
// Every domain operation and all bounded scratch data are application-private.
use geometry::profile;
use loading::pressure;
use input::tokens;
use output::numbers;
use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

data Application {
    reader: Reader;
    profile: Profile;
    levels: [f64; 8];
    level_count: u64 in Wrapping;
    gamma: f64;
    hinge: f64;
    area: f64;
    force: f64;
    first_moment: f64;
    hinge_moment: f64;
    wetted_count: i64 in Wrapping;
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut application: Application;
    block Reader::next(&mut application.reader);
    transition application.reader.status == 1 && application.reader.value >= 2 && application.reader.value <= 8 {
        true -> header(&mut application)
        false -> invalid()
    }
    state header(application: &mut Application) {
        application.profile.count = application.reader.value as u64 in Wrapping;
        block Reader::next(&mut application.reader);
        transition application.reader.status == 1 && application.reader.value >= 1 && application.reader.value <= 8 {
            true -> gamma(application)
            false -> invalid()
        }
    }
    state gamma(application: &mut Application) {
        application.level_count = application.reader.value as u64 in Wrapping;
        block Reader::next(&mut application.reader);
        transition application.reader.status == 1 && application.reader.value >= 1 && application.reader.value <= 20000 {
            true -> hinge(application)
            false -> invalid()
        }
    }
    state hinge(application: &mut Application) {
        application.gamma = F64::from_i64(application.reader.value as i64);
        block Reader::next(&mut application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 {
            true -> begin_nodes(application)
            false -> invalid()
        }
    }
    state begin_nodes(application: &mut Application) {
        application.hinge = (F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition { _ -> node(application, 0) }
    }
    state node(application: &mut Application, index: u64 in Wrapping) {
        transition index < application.profile.count && index < 8 {
            true -> elevation(application, index)
            false -> level(application, 0)
        }
    }
    state elevation(application: &mut Application, index: u64 in Wrapping) {
        block Reader::next(&mut application.reader);
        let node_elevation: f64 = F64::from_i64(application.reader.value as i64) / 1000.0;
        transition application.reader.status == 1 && application.reader.value <= 100000 {
            true -> width(application, index, node_elevation)
            false -> invalid()
        }
    }
    state width(application: &mut Application, index: u64 in Wrapping, elevation: f64) {
        block Reader::next(&mut application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 && index < 8 {
            true -> store_node(application, index, elevation)
            false -> invalid()
        }
    }
    state store_node(application: &mut Application, index: u64 in Wrapping, elevation: f64) {
        application.profile.nodes[index].elevation = elevation;
        application.profile.nodes[index].width = (F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition index > 0 {
            true -> validate_order(application, index, elevation)
            false -> node(application, index + 1)
        }
    }
    state validate_order(application: &mut Application, index: u64 in Wrapping, elevation: f64) {
        let previous: u64 in Wrapping = index - 1;
        transition previous < 8 && elevation > application.profile.nodes[previous].elevation {
            true -> node(application, index + 1)
            false -> invalid()
        }
    }
    state level(application: &mut Application, index: u64 in Wrapping) {
        transition index < application.level_count && index < 8 {
            true -> read_level(application, index)
            false -> trailing(application)
        }
    }
    state read_level(application: &mut Application, index: u64 in Wrapping) {
        block Reader::next(&mut application.reader);
        transition application.reader.status == 1 && application.reader.value <= 100000 && index < 8 {
            true -> store_level(application, index)
            false -> invalid()
        }
    }
    state store_level(application: &mut Application, index: u64 in Wrapping) {
        application.levels[index] = (F64::from_i64(application.reader.value as i64)) / 1000.0;
        transition { _ -> level(application, index + 1) }
    }
    state trailing(application: &mut Application) {
        block Reader::next(&mut application.reader);
        transition application.reader.status == 0 {
            true -> begin(application)
            false -> invalid()
        }
    }
    state begin(application: &mut Application) {
        Console::write_line("HYDROSTATIC_GATE_V1 micro_units");
        transition { _ -> water(application, 0) }
    }
    state water(application: &mut Application, index: u64 in Wrapping) {
        transition index < application.level_count && index < 8 {
            true -> reset(application, index)
            false -> done()
        }
    }
    state reset(application: &mut Application, index: u64 in Wrapping) {
        application.area = 0.0;
        application.force = 0.0;
        application.first_moment = 0.0;
        application.hinge_moment = 0.0;
        application.wetted_count = 0;
        Console::write("LEVEL "); write_integer(index as i64 in Wrapping);
        Console::write(" water_um="); write_scaled(application.levels[index]);
        Console::write_line("");
        transition { _ -> segment(application, index, 0) }
    }
    state segment(application: &mut Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping) {
        let next: u64 in Wrapping = segment_index + 1;
        transition next < application.profile.count && next < 8 && segment_index < 8 && water_index < 8 {
            true -> calculate(application, water_index, segment_index, next)
            false -> summary(application, water_index)
        }
    }
    state calculate(application: &mut Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping, next: u64 in Wrapping) {
        let water: f64 = application.levels[water_index];
        let wet: WetSegment = clip(application.profile.nodes[segment_index], application.profile.nodes[next], water);
        transition wet.upper > wet.lower {
            true -> accumulate(application, water_index, segment_index, wet, water)
            false -> segment(application, water_index, next)
        }
    }
    state accumulate(application: &mut Application, water_index: u64 in Wrapping, segment_index: u64 in Wrapping, wet: WetSegment, water: f64) {
        let load: SegmentLoad = integrate(wet, water, application.gamma, application.hinge);
        application.area = application.area + load.area;
        application.force = application.force + load.force;
        application.first_moment = application.first_moment + load.first_moment;
        application.hinge_moment = application.hinge_moment + load.hinge_moment;
        application.wetted_count = application.wetted_count + 1;
        Console::write("WET "); write_integer(segment_index as i64 in Wrapping);
        Console::write(" lower_um="); write_scaled(wet.lower);
        Console::write(" upper_um="); write_scaled(wet.upper);
        Console::write(" lower_width_um="); write_scaled(wet.lower_width);
        Console::write(" upper_width_um="); write_scaled(wet.upper_width);
        Console::write(" area_micro_m2="); write_scaled(load.area);
        Console::write(" force_uN="); write_scaled(load.force);
        Console::write(" moment_uNm="); write_scaled(load.hinge_moment);
        Console::write_line("");
        transition { _ -> segment(application, water_index, segment_index + 1) }
    }
    state summary(application: &mut Application, water_index: u64 in Wrapping) {
        Console::write("TOTAL wetted="); write_integer(application.wetted_count);
        Console::write(" area_micro_m2="); write_scaled(application.area);
        Console::write(" force_uN="); write_scaled(application.force);
        Console::write(" moment_uNm="); write_scaled(application.hinge_moment);
        transition application.force > 0.0 {
            true -> center(application, water_index)
            false -> dry_summary(application, water_index)
        }
    }
    state center(application: &mut Application, water_index: u64 in Wrapping) {
        Console::write(" center_um="); write_scaled(application.first_moment / application.force);
        Console::write_line("");
        transition { _ -> water(application, water_index + 1) }
    }
    state dry_summary(application: &mut Application, water_index: u64 in Wrapping) {
        Console::write_line(" center_um=undefined");
        transition { _ -> water(application, water_index + 1) }
    }
    state done() { Console::exit_process(0); }
    state invalid() { Console::write_line("ERROR invalid bounded gate input"); Console::exit_process(64); }
}
