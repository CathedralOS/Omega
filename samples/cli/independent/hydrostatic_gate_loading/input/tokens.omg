// One private bounded unsigned-decimal scanner. Six digits and at most
// 4096 consumed bytes prevent overflow and unbounded malformed input work.
use omega_language_std::console;
use omega::language::core::numeric_conversion;

public data Reader {
    value: i64 in Wrapping;
    status: i32;
    consumed: i32 in Wrapping;
    digits: i32 in Wrapping;
}

public machine Reader::next(reader: &mut Reader) reaches Console
invokes Console;
blocks;
crashes Trap
{
    reader.value = 0;
    reader.status = 0;
    reader.digits = 0;
    transition { _ -> scan(reader) }
    machine scan(reader: &mut Reader) {
        transition reader.consumed < 4096 {
            true -> read(reader)
            false -> invalid(reader)
        }
    }
    machine read(reader: &mut Reader) {
        let observed: ByteRead = block Console::read_byte();
        reader.consumed = reader.consumed + 1;
        transition observed {
            ByteRead::Eof -> finish(reader)
            ByteRead::Byte { value } -> classify(reader, value)
        }
    }
    machine classify(reader: &mut Reader, value: i32) {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> delimiter(reader)
            false -> numeral(reader, value)
        }
    }
    machine delimiter(reader: &mut Reader) {
        transition reader.digits > 0 {
            true -> finish(reader)
            false -> scan(reader)
        }
    }
    machine numeral(reader: &mut Reader, value: i32) {
        transition value >= 48 && value <= 57 && reader.digits < 6 {
            true -> append(reader, value)
            false -> invalid(reader)
        }
    }
    machine append(reader: &mut Reader, value: i32) {
        reader.value = reader.value * 10 + ((value as i64 in Wrapping) - 48);
        reader.digits = reader.digits + 1;
        transition { _ -> scan(reader) }
    }
    machine finish(reader: &mut Reader) {
        transition reader.digits > 0 {
            true -> valid(reader)
            false -> end(reader)
        }
    }
    machine valid(reader: &mut Reader) { reader.status = 1; }
    machine end(reader: &mut Reader) { reader.status = 0; }
    machine invalid(reader: &mut Reader) { reader.status = -1; }
}
