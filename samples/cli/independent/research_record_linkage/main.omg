// Expected exit: 64
// Expected output contains: INVALID input
// Empty stdin smoke control; finite-input scientific oracles are data/*.stdout.
use omega_language_std::console;
use input::parser;
use linkage::model;
use report::output;

data Main {
    input: Input;
    linkage: Linkage;
}

machine Main::main(main: &mut Main) reaches Console blocks; crashes Trap {
    block Input::read(&mut main.input);
    transition main.input.valid && main.input.tokens[0] > 0 &&
               main.input.tokens[25] < 4 && main.input.tokens[26] < 4 && main.input.tokens[27] < 4 &&
               (main.input.tokens[25] == 0 || main.input.tokens[25] != main.input.tokens[26]) &&
               (main.input.tokens[25] == 0 || main.input.tokens[25] != main.input.tokens[27]) &&
               (main.input.tokens[26] == 0 || main.input.tokens[26] != main.input.tokens[27]) {
        true -> load(main)
        false -> invalid(main)
    }
    state load(main: &mut Main) {
        main.linkage.threshold = main.input.tokens[0];
        main.linkage.left[0] = Record { identifier: main.input.tokens[1], title: main.input.tokens[2], author: main.input.tokens[3], year: main.input.tokens[4] };
        main.linkage.left[1] = Record { identifier: main.input.tokens[5], title: main.input.tokens[6], author: main.input.tokens[7], year: main.input.tokens[8] };
        main.linkage.left[2] = Record { identifier: main.input.tokens[9], title: main.input.tokens[10], author: main.input.tokens[11], year: main.input.tokens[12] };
        main.linkage.right[0] = Record { identifier: main.input.tokens[13], title: main.input.tokens[14], author: main.input.tokens[15], year: main.input.tokens[16] };
        main.linkage.right[1] = Record { identifier: main.input.tokens[17], title: main.input.tokens[18], author: main.input.tokens[19], year: main.input.tokens[20] };
        main.linkage.right[2] = Record { identifier: main.input.tokens[21], title: main.input.tokens[22], author: main.input.tokens[23], year: main.input.tokens[24] };
        main.linkage.truth[0] = main.input.tokens[25];
        main.linkage.truth[1] = main.input.tokens[26];
        main.linkage.truth[2] = main.input.tokens[27];
        Linkage::solve(&mut main.linkage);
        report(&main.linkage);
        // The process result fingerprints every computed report field. The CLI's
        // Terminal comparison observes termination; native stdout is checked
        // separately against the full frozen oracle by validate.py.
        Console::exit_process(((main.linkage.best % 100 * 2 + main.linkage.optima % 100 * 3 + main.linkage.edges % 100 * 5 + main.linkage.conflicts % 100 * 7 + main.linkage.linked % 100 * 11 + main.linkage.ambiguous % 100 * 13 + main.linkage.unmatched % 100 * 17 + main.linkage.true_positive % 100 * 19 + main.linkage.false_positive % 100 * 23 + main.linkage.false_negative % 100 * 29 + main.linkage.consensus[0] % 100 * 31 + main.linkage.consensus[1] % 100 * 37 + main.linkage.consensus[2] % 100 * 41) % 191 + 1) as i32);
    }
    state invalid(main: &mut Main) {
        Console::write_line("INVALID input");
        Console::exit_process(64);
    }
}
