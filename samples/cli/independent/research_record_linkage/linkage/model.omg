public data Record [copy] {
    identifier: u64;
    title: u64;
    author: u64;
    year: u64;
}

// A runtime record loan owns a descriptor; its static byte child forms none.
// The scalar grandchild must keep both the cell backing and the ancestor
// descriptor, whether the cell was chosen by a runtime index or by a fixed one.
// The observed byte moves through a local, a field, a parameter, and a call result.
public data ScoreCell { bytes: [u8; 4]; }

public machine read_score_byte(rows: &[ScoreCell; 2], index: u64, dynamic: bool) -> u64 in Wrapping {
    transition index < 2 {
        true -> choose_score_cell(rows, index, dynamic)
        _ -> (0)
    }
    machine choose_score_cell(rows: &[ScoreCell; 2], index: u64, dynamic: bool) -> u64 in Wrapping {
        transition dynamic {
            true -> score_cell(&rows[index])
            _ -> score_cell(&rows[1])
        }
    }
    machine score_cell(value: &ScoreCell) -> u64 in Wrapping {
        transition { _ -> score_bytes(&value.bytes, 1) }
    }
    machine score_bytes(value: &[u8; 4], index: u64) -> u64 in Wrapping {
        transition index < 4 {
            true -> score_scalar(&value[index])
            _ -> (0)
        }
    }
    machine score_scalar(value: &u8) -> u64 in Wrapping { value as u64 in Wrapping }
}

public machine score_byte_witness() -> u64 in Wrapping {
    let mut rows: [ScoreCell; 2];
    rows[0].bytes[1] = 20;
    rows[1].bytes[1] = 22;
    let first: u64 in Wrapping = read_score_byte(&rows, 0, true);
    let second: u64 in Wrapping = read_score_byte(&rows, 0, false);
    (first + second)
}

public data Linkage {
    left: [Record; 3];
    right: [Record; 3];
    truth: [u64; 3];
    threshold: u64;
    scores: [u64; 9];
    conflicts: u64;
    edges: u64;
    cursor: u64;
    row: u64;
    column: u64;
    index: u64;
    choices: [u64; 3];
    consensus: [u64; 3];
    total: u64;
    best: u64;
    optima: u64;
    valid: bool;
    linked: u64;
    ambiguous: u64;
    unmatched: u64;
    true_positive: u64;
    false_positive: u64;
    false_negative: u64;
}

// Exact small integers: raw score <=22, total <=66, assignments=64.
// Modulo 1000 additions below bound accumulator arithmetic without changing
// any value reachable under the declared three-by-three model.
public machine pair_score(left: Record, right: Record) -> u64 {
    let mut score: u64 = 0;
    transition left.identifier > 0 && right.identifier > 0 && left.identifier != right.identifier {
        true -> conflict()
        false -> identifier(left, right, score)
    }
    machine conflict() -> u64 { 0 }
    machine identifier(left: Record, right: Record, score: u64) -> u64 {
        transition left.identifier > 0 && left.identifier == right.identifier {
            true -> title(left, right, 12)
            false -> title(left, right, score)
        }
    }
    machine title(left: Record, right: Record, score: u64) -> u64 {
        transition left.title > 0 && left.title == right.title {
            true -> author(left, right, score % 1000 + 6)
            false -> author(left, right, score)
        }
    }
    machine author(left: Record, right: Record, score: u64) -> u64 {
        transition left.author > 0 && left.author == right.author {
            true -> year(left, right, score % 1000 + 3)
            false -> year(left, right, score)
        }
    }
    machine year(left: Record, right: Record, score: u64) -> u64 {
        transition left.year > 0 && left.year == right.year {
            true -> year_match(score)
            false -> score
        }
    }
    machine year_match(score: u64) -> u64 { score % 1000 + 1 }
}

public machine Linkage::solve(linkage: &mut Linkage) {
    linkage.cursor = 0;
    transition { _ -> matrix(linkage) }
    machine matrix(linkage: &mut Linkage) {
        transition linkage.cursor < 9 {
            true -> pair(linkage)
            false -> start(linkage)
        }
    }
    machine pair(linkage: &mut Linkage) {
        linkage.row = linkage.cursor / 3;
        linkage.column = linkage.cursor % 3;
        transition linkage.row < 3 && linkage.column < 3 {
            true -> calculate(linkage)
            false -> done()
        }
    }
    machine calculate(linkage: &mut Linkage) {
        let left: Record = linkage.left[linkage.row];
        let right: Record = linkage.right[linkage.column];
        let score: u64 = pair_score(left, right);
        transition left.identifier > 0 && right.identifier > 0 && left.identifier != right.identifier {
            true -> conflict(linkage, score)
            false -> threshold(linkage, score)
        }
    }
    machine conflict(linkage: &mut Linkage, score: u64) {
        linkage.conflicts = linkage.conflicts % 1000 + 1;
        transition { _ -> threshold(linkage, score) }
    }
    machine threshold(linkage: &mut Linkage, score: u64) {
        transition score >= linkage.threshold {
            true -> edge(linkage, score)
            false -> write_score(linkage, 0)
        }
    }
    machine edge(linkage: &mut Linkage, score: u64) {
        linkage.edges = linkage.edges % 1000 + 1;
        transition { _ -> write_score(linkage, score) }
    }
    machine write_score(linkage: &mut Linkage, score: u64) {
        transition linkage.cursor < 9 {
            true -> store_score(linkage, score)
            false -> done()
        }
    }
    machine store_score(linkage: &mut Linkage, score: u64) {
        linkage.scores[linkage.cursor] = score;
        linkage.cursor = linkage.cursor + 1;
        transition { _ -> matrix(linkage) }
    }
    machine start(linkage: &mut Linkage) {
        linkage.cursor = 0;
        transition { _ -> assignments(linkage) }
    }
    machine assignments(linkage: &mut Linkage) {
        transition linkage.cursor < 64 {
            true -> decode(linkage)
            false -> audit_start(linkage)
        }
    }
    machine decode(linkage: &mut Linkage) {
        linkage.choices[0] = linkage.cursor % 4;
        linkage.choices[1] = linkage.cursor / 4 % 4;
        linkage.choices[2] = linkage.cursor / 16;
        linkage.total = 0;
        linkage.row = 0;
        transition (linkage.choices[0] == 0 || linkage.choices[0] != linkage.choices[1]) &&
                   (linkage.choices[0] == 0 || linkage.choices[0] != linkage.choices[2]) &&
                   (linkage.choices[1] == 0 || linkage.choices[1] != linkage.choices[2]) {
            true -> evaluate(linkage)
            false -> next(linkage)
        }
    }
    machine evaluate(linkage: &mut Linkage) {
        transition linkage.row < 3 {
            true -> choice(linkage)
            false -> compare(linkage)
        }
    }
    machine choice(linkage: &mut Linkage) {
        let selected: u64 = linkage.choices[linkage.row];
        transition selected > 0 && selected < 4 {
            true -> index(linkage, selected)
            false -> advance_row(linkage)
        }
    }
    machine index(linkage: &mut Linkage, selected: u64)
    requires selected > 0 && selected < 4 {
        linkage.index = (linkage.row % 3) * 3 + selected - 1;
        transition linkage.index < 9 {
            true -> include(linkage)
            false -> done()
        }
    }
    machine include(linkage: &mut Linkage) {
        let score: u64 = linkage.scores[linkage.index];
        transition score > 0 {
            true -> add(linkage, score)
            false -> next(linkage)
        }
    }
    machine add(linkage: &mut Linkage, score: u64) {
        linkage.total = linkage.total % 1000 + score % 1000;
        transition { _ -> advance_row(linkage) }
    }
    machine advance_row(linkage: &mut Linkage) {
        linkage.row = linkage.row % 3 + 1;
        transition { _ -> evaluate(linkage) }
    }
    machine compare(linkage: &mut Linkage) {
        transition linkage.total > linkage.best {
            true -> replace(linkage)
            false -> equal(linkage)
        }
    }
    machine replace(linkage: &mut Linkage) {
        linkage.best = linkage.total;
        linkage.optima = 1;
        linkage.consensus = linkage.choices;
        transition { _ -> next(linkage) }
    }
    machine equal(linkage: &mut Linkage) {
        transition linkage.total == linkage.best {
            true -> tie(linkage)
            false -> next(linkage)
        }
    }
    machine tie(linkage: &mut Linkage) {
        linkage.optima = linkage.optima % 1000 + 1;
        linkage.row = 0;
        transition { _ -> consensus(linkage) }
    }
    machine consensus(linkage: &mut Linkage) {
        transition linkage.row < 3 {
            true -> merge(linkage)
            false -> next(linkage)
        }
    }
    machine merge(linkage: &mut Linkage) {
        transition linkage.consensus[linkage.row] != linkage.choices[linkage.row] {
            true -> ambiguous(linkage)
            false -> merge_next(linkage)
        }
    }
    machine ambiguous(linkage: &mut Linkage) {
        linkage.consensus[linkage.row] = 4;
        transition { _ -> merge_next(linkage) }
    }
    machine merge_next(linkage: &mut Linkage) {
        linkage.row = linkage.row % 3 + 1;
        transition { _ -> consensus(linkage) }
    }
    machine next(linkage: &mut Linkage) {
        transition linkage.cursor < 64 {
            true -> increment(linkage)
            false -> done()
        }
    }
    machine increment(linkage: &mut Linkage) {
        linkage.cursor = linkage.cursor + 1;
        transition { _ -> assignments(linkage) }
    }
    machine audit_start(linkage: &mut Linkage) {
        let observed: u64 in Wrapping = score_byte_witness();
        linkage.row = 0;
        transition observed == 42 {
            true -> audit(linkage)
            false -> witness_miss(linkage)
        }
    }
    machine witness_miss(linkage: &mut Linkage) {
        linkage.best = linkage.best % 1000 + 1000;
        transition { _ -> audit(linkage) }
    }
    machine audit(linkage: &mut Linkage) {
        transition linkage.row < 3 {
            true -> classify(linkage)
            false -> done()
        }
    }
    machine classify(linkage: &mut Linkage) {
        transition linkage.consensus[linkage.row] {
            0 -> unmatched(linkage)
            4 -> uncertain(linkage)
            _ -> linked(linkage)
        }
    }
    machine unmatched(linkage: &mut Linkage) {
        linkage.unmatched = linkage.unmatched % 1000 + 1;
        transition { _ -> missed(linkage) }
    }
    machine uncertain(linkage: &mut Linkage) {
        linkage.ambiguous = linkage.ambiguous % 1000 + 1;
        transition { _ -> missed(linkage) }
    }
    machine linked(linkage: &mut Linkage) {
        linkage.linked = linkage.linked % 1000 + 1;
        transition linkage.consensus[linkage.row] == linkage.truth[linkage.row] {
            true -> correct(linkage)
            false -> incorrect(linkage)
        }
    }
    machine correct(linkage: &mut Linkage) {
        linkage.true_positive = linkage.true_positive % 1000 + 1;
        transition { _ -> missed(linkage) }
    }
    machine incorrect(linkage: &mut Linkage) {
        linkage.false_positive = linkage.false_positive % 1000 + 1;
        transition { _ -> missed(linkage) }
    }
    machine missed(linkage: &mut Linkage) {
        transition linkage.truth[linkage.row] > 0 && linkage.truth[linkage.row] != linkage.consensus[linkage.row] {
            true -> false_negative(linkage)
            false -> audit_next(linkage)
        }
    }
    machine false_negative(linkage: &mut Linkage) {
        linkage.false_negative = linkage.false_negative % 1000 + 1;
        transition { _ -> audit_next(linkage) }
    }
    machine audit_next(linkage: &mut Linkage) {
        linkage.row = linkage.row % 3 + 1;
        transition { _ -> audit(linkage) }
    }
    machine done() { }
}
