use omega_language_std::math;
use omega::language::core::float_operations;
use omega_language_std::console;

// Expected exit: 0
// Expected output contains: pair contact root 2 impulse 1.5
//
// Isolates a construct disk_collision_lab needs and no passing sample spells:
// a machine returns a copy record through its states. The record carries the
// quadratic contact time (runtime discriminant under F64::square_root) and
// the Newton impulse along the contact normal. Head-on masses 1 and 3,
// centers 4 apart, radii 1, closing speed 1: contact at 2, impulse 1.5.

data Disk [copy] { x: f64; vx: f64; radius: f64; mass: f64; }
data Contact [copy] { time: f64; impulse: f64; }

machine contact(a: Disk, b: Disk) -> Contact {
    let dx: f64 = b.x - a.x;
    let vx: f64 = b.vx - a.vx;
    let speed: f64 = vx * vx;
    let radial: f64 = dx * vx;
    let radius: f64 = a.radius + b.radius;
    let gap: f64 = dx * dx - radius * radius;
    let discriminant: f64 = radial * radial - speed * gap;
    transition speed > 0.000000000001 && radial < -0.000000000001 && discriminant >= 0.0 {
        true -> root(a, b, speed, radial, discriminant, vx)
        _ -> absent()
    }
    state root(a: Disk, b: Disk, speed: f64, radial: f64, discriminant: f64, vx: f64) -> Contact {
        let time: f64 = (0.0 - radial - F64::square_root(discriminant)) / speed;
        transition time >= -0.000000001 { true -> impulse(a, b, time, vx) _ -> absent() }
    }
    state impulse(a: Disk, b: Disk, time: f64, vx: f64) -> Contact {
        // Relative velocity along the fixed head-on normal is constant.
        // `radial` is the position-weighted product used by the quadratic;
        // the unit-normal rate is `vx` itself while the disks stay colinear.
        let inverse: f64 = 1.0 / a.mass + 1.0 / b.mass;
        let magnitude: f64 = (0.0 - (1.0 + 1.0) * vx) / inverse;
        Contact { time: max_f64(0.0, time), impulse: magnitude }
    }
    state absent() -> Contact { Contact { time: 100.0, impulse: 0.0 } }
}

data Main { hit: Contact; }

machine Main::main(main: &mut Main) reaches Console {
    let left: Disk = Disk { x: 0.0, vx: 1.0, radius: 1.0, mass: 1.0 };
    let right: Disk = Disk { x: 4.0, vx: 0.0, radius: 1.0, mass: 3.0 };
    main.hit = contact(left, right);
    transition abs_f64(main.hit.time - 2.0) <= 0.000000001
        && abs_f64(main.hit.impulse - 1.5) <= 0.000000001 {
        true -> report(main)
        _ -> failed(main)
    }
    state report(main: &mut Main) {
        Console::write_line("pair contact root 2 impulse 1.5");
        Console::exit_process(0);
    }
    state failed(main: &mut Main) {
        Console::write_line("pair contact root mismatch");
        Console::exit_process(4);
    }
}
