// A runtime count indexes a byte view. The count arrives as a local, a field,
// a parameter, and a call result, and the read happens in a later state.
// Expected exit: 0
data Held { count: u32; }

machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

machine measure() -> u32
ensures result <= 2;
{
    2
}

machine from_parameter(index: u32, items: &[u8]) -> u8
requires index < items.len;
{
    read_at<index>(items)
}

machine main() crashes Trap {
    let bytes: [u8; 4] = [9, 8, 7, 6];
    transition { _ -> check(bytes) }
    state check(bytes: [u8; 4]) {
        let view: &[u8] = &bytes[..];
        let count: u32 = 1;
        let from_local: u8 = read_at<count>(view);
        let held: Held = Held { count: 0 };
        let from_field: u8 = read_at<held.count>(view);
        let from_parameter: u8 = from_parameter(3, view);
        let from_call: u8 = read_at<measure()>(view);
        transition from_local == 8 && from_field == 9 && from_parameter == 6 && from_call == 7 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
