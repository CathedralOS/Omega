// Bounded signed decimals, parsed exactly as integer nanounits.
// The byte budget includes separators and trailing whitespace. EOF is accepted
// only after a complete token; malformed, truncated and over-budget input reject.
use omega_language_std::console;


pub data Reader { consumed: i32; }
pub data Number [copy] { valid: bool; value: i64 in Wrapping; }

machine character(reader: &mut Reader) -> i32 reaches Console {
    transition reader.consumed >= 0 && reader.consumed < 4096 {
        true -> read(reader)
        _ -> -2
    }
    state read(reader: &mut Reader) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        let byte: ByteRead = block Console::read_byte();
        transition byte { ByteRead::Eof -> -1 ByteRead::Byte { value } -> counted(reader, value) }
    }
    state counted(reader: &mut Reader, value: i32) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        reader.consumed = reader.consumed + 1;
        transition { _ -> value }
    }
}
machine whitespace(value: i32) -> bool { transition { _ -> (value == 32 || value == 10 || value == 13 || value == 9) } }
pub machine number(reader: &mut Reader) -> Number
reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> start(reader) }
    state start(reader: &mut Reader) -> Number {
        let value: i32 = block character(reader);
        transition whitespace(value) { true -> start(reader) _ -> sign(reader, value) }
    }
    state sign(reader: &mut Reader, value: i32) -> Number {
        transition value == 45 {
            true -> negative(reader)
            _ -> digit(reader, value, 1, 0, 0, 0, false, 1)
        }
    }
    state negative(reader: &mut Reader) -> Number {
        let value: i32 = block character(reader);
        transition { _ -> digit(reader, value, -1, 0, 0, 0, false, 1) }
    }
    state digit(reader: &mut Reader, value: i32, sign: i64 in Wrapping, accumulated: i64 in Wrapping, digits: i32, fraction: i32, decimal: bool, divisor: i64 in Wrapping) -> Number {
        transition value >= 48 && value <= 57 && digits >= 0 && digits < 13 && fraction >= 0 && fraction < 9 {
            true -> append(reader, value, sign, accumulated, digits, fraction, decimal, divisor)
            _ -> punctuation(reader, value, sign, accumulated, digits, fraction, decimal, divisor)
        }
    }
    state append(reader: &mut Reader, value: i32, sign: i64 in Wrapping, accumulated: i64 in Wrapping, digits: i32, fraction: i32, decimal: bool, divisor: i64 in Wrapping) -> Number
    requires value >= 48 && value <= 57 && digits >= 0 && digits < 13 && fraction >= 0 && fraction < 9
    {
        let numeric: i64 in Wrapping = (value - 48) as i64 in Wrapping;
        let next_divisor: i64 in Wrapping = match decimal { true -> divisor * 10 _ -> divisor };
        let next: i64 in Wrapping = accumulated * 10 + numeric;
        let next_fraction: i32 = match decimal { true -> fraction + 1 _ -> fraction };
        let observed: i32 = block character(reader);
        transition { _ -> digit(reader, observed, sign, next, digits + 1, next_fraction, decimal, next_divisor) }
    }
    state punctuation(reader: &mut Reader, value: i32, sign: i64 in Wrapping, accumulated: i64 in Wrapping, digits: i32, fraction: i32, decimal: bool, divisor: i64 in Wrapping) -> Number {
        transition value == 46 && !decimal && digits > 0 {
            true -> point(reader, sign, accumulated, digits)
            _ -> finish(value, sign, accumulated, digits, fraction, decimal, divisor)
        }
    }
    state point(reader: &mut Reader, sign: i64 in Wrapping, accumulated: i64 in Wrapping, digits: i32) -> Number {
        let observed: i32 = block character(reader);
        transition { _ -> digit(reader, observed, sign, accumulated, digits, 0, true, 1) }
    }
    state finish(value: i32, sign: i64 in Wrapping, accumulated: i64 in Wrapping, digits: i32, fraction: i32, decimal: bool, divisor: i64 in Wrapping) -> Number {
        transition divisor > 0 && digits > 0 && accumulated <= 1000 * divisor && (!decimal || fraction > 0) && (whitespace(value) || value == -1) {
            true -> Number { valid: true, value: sign * accumulated * (1000000000 / divisor) }
            _ -> Number { valid: false, value: 0 }
        }
    }
}
pub machine ended(reader: &mut Reader) -> bool
reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition { _ -> scan(reader) }
    state scan(reader: &mut Reader) -> bool {
        let value: i32 = block character(reader);
        transition value == -1 { true -> true _ -> space(reader, value) }
    }
    state space(reader: &mut Reader, value: i32) -> bool {
        transition whitespace(value) { true -> scan(reader) _ -> false }
    }
}
