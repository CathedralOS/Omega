use omega_language_std::console;
use domain::model;
machine decimal(value: u64 in Wrapping) reaches Console {
    transition { _ -> scale(value, 1) }
    state scale(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor <= value/10 {
            true -> scale(value, divisor*10)
            false -> emit(value, divisor)
        }
    }
    state emit(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor > 0 { true -> digit(value, divisor) false -> done() }
    }
    state digit(value: u64 in Wrapping, divisor: u64 in Wrapping)
    requires divisor > 0 {
        Console::write_byte((value/divisor%10+48) as i32);
        transition { _ -> emit(value%divisor, divisor/10) }
    }
    state done() {}
}
machine field(name: &[u8], value: u64 in Wrapping) reaches Console {
    Console::write(name);
    decimal(value);
    Console::write_line("");
}
pub machine report(community: &Community) reaches Console
invokes Console;
{
    Console::write_line("ecological_rarefaction");
    field("species=", community.species);
    field("individuals=", community.total);
    transition { _ -> query(community, 0) }
    state query(community: &Community, index: u64 in Wrapping) {
        transition index < community.queries && index < 16 {
            true -> start(community, index)
            false -> done()
        }
    }
    state start(community: &Community, index: u64 in Wrapping)
    requires index < 16 {
        let depth: u64 in Wrapping = community.depths[index];
        let denominator: u64 in Wrapping = choose(community.total, depth);
        field("depth=", depth);
        field("denominator=", denominator);
        transition { _ -> bin(community, index, depth, denominator, 0, 0, 0) }
    }
    state bin(community: &Community,
               index: u64 in Wrapping, depth: u64 in Wrapping, denominator: u64 in Wrapping,
               richness: u64 in Wrapping, first: u64 in Wrapping, second: u64 in Wrapping) {
        transition richness <= community.species && richness < 13 && depth < 33 {
            true -> value(community, index, depth, denominator, richness, first, second)
            false -> moments(community, index, denominator, first, second)
        }
    }
    state value(community: &Community,
                 index: u64 in Wrapping, depth: u64 in Wrapping, denominator: u64 in Wrapping,
                 richness: u64 in Wrapping, first: u64 in Wrapping, second: u64 in Wrapping)
    requires richness < 13 && depth < 33 {
        let weight: u64 in Wrapping = community.weights[depth][richness];
        Console::write("bin=");
        decimal(richness);
        Console::write(" numerator=");
        decimal(weight);
        Console::write_line("");
        transition { _ -> bin(community, index, depth, denominator, richness+1,
                              first+richness*weight, second+richness*richness*weight) }
    }
    state moments(community: &Community,
                   index: u64 in Wrapping, denominator: u64 in Wrapping,
                   first: u64 in Wrapping, second: u64 in Wrapping) {
        transition denominator > 0 {
            true -> centered(community, index, denominator, first, second)
            false -> done()
        }
    }
    state centered(community: &Community,
                    index: u64 in Wrapping, denominator: u64 in Wrapping,
                    first: u64 in Wrapping, second: u64 in Wrapping)
    requires denominator > 0 {
        // floor(E) centers before squaring. E[(R-center)^2] <= 37,
        // so products fit u64 even when an uncentered second moment does not.
        // choose(32,16)^2 * 37 < 2^64; the residual mean is less than 1.
        let center: u64 in Wrapping = first/denominator;
        let centered_second: u64 in Wrapping = second+center*center*denominator-2*center*first;
        let residual: u64 in Wrapping = first-center*denominator;
        let variance: u64 in Wrapping = centered_second*denominator-residual*residual;
        field("expectation_numerator=", first);
        field("expectation_denominator=", denominator);
        field("variance_numerator=", variance);
        field("variance_denominator=", denominator*denominator);
        transition { _ -> query(community, index+1) }
    }
    state done() {}
}
