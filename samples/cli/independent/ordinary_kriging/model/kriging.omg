use omega::language::core::float_operations;
public data Problem {
    count: u64; queries: u64; variance: f64; range: f64; noise: f64;
    x: [f64; 8]; y: [f64; 8]; values: [f64; 8]; query_x: [f64; 8]; query_y: [f64; 8];
    covariance: [f64; 64]; matrix: [f64; 90]; cross: [f64; 8];
    weights: [f64; 64]; predictions: [f64; 8]; variances: [f64; 8];
    system_residuals: [f64; 8]; mean_residuals: [f64; 8];
}
// Covariance divided by process variance: exp(-distance/range). Noise is
// diagonal training variance only. The last augmented row enforces unknown
// constant mean; its multiplier has also been divided by process variance.
// Partial-pivot Gauss-Jordan solves the full indefinite block system. No
// jitter, deduplication, clipping of variance, or known-mean substitution.
public machine solve(problem: &mut Problem) -> bool {
    training(problem, 0, 0);
    transition { _ -> queries(problem, 0) }
    machine queries(problem: &mut Problem, query: u64) -> bool {
        transition query < problem.queries && query < 8 && problem.count >= 2 && problem.count <= 8 {
            true -> prepare(problem, query) false -> good()
        }
    }
    machine prepare(problem: &mut Problem, query: u64) -> bool requires query < 8, problem.count <= 8 {
        cross_covariance(problem, query, 0); assemble(problem, 0, 0);
        transition eliminate(problem, 0) { true -> finish(problem, query) false -> bad() }
    }
    machine finish(problem: &mut Problem, query: u64) -> bool requires query < 8 {
        measure(problem, query, 0, 0.0, 0.0, 0.0);
        transition { _ -> queries(problem, query + 1) }
    }
    machine good() -> bool { true } machine bad() -> bool { false }
}
public machine magnitude(value: f64) -> f64 {
    transition value < 0.0 { true -> negative(value) false -> positive(value) }
    machine negative(value: f64) -> f64 { 0.0 - value } machine positive(value: f64) -> f64 { value }
}
// Range reduction keeps |argument| <= 1/8 before a 16-term Taylor series;
// repeated squaring recovers exp(-argument). Beyond 64 the absolute omission
// is below 1.7e-28. This routine has no source-shape or fixture dependencies.
machine decay(argument: f64) -> f64 {
    transition argument > 64.0 { true -> zero() false -> reduce(argument, 0) }
    machine reduce(argument: f64, squares: u64) -> f64 {
        transition argument > 0.125 && squares < 10 { true -> reduce(argument * 0.5, squares + 1) false -> series(argument, squares, 1, 1.0, 1.0) }
    }
    machine series(argument: f64, squares: u64, degree: u64, term: f64, total: f64) -> f64 {
        transition degree <= 16 { true -> add(argument, squares, degree, term, total) false -> restore(total, squares) }
    }
    machine add(argument: f64, squares: u64, degree: u64, term: f64, total: f64) -> f64 {
        let next: f64 = term * (0.0 - argument) / F64::from_u64(degree);
        transition { _ -> series(argument, squares, degree + 1, next, total + next) }
    }
    machine restore(value: f64, squares: u64) -> f64 {
        transition squares > 0 { true -> restore(value * value, squares - 1) false -> done(value) }
    }
    machine done(value: f64) -> f64 { value } machine zero() -> f64 { 0.0 }
}
machine kernel(x1: f64, y1: f64, x2: f64, y2: f64, range: f64) -> f64 {
    let x: f64 = x1 - x2; let y: f64 = y1 - y2;
    decay(F64::square_root(x * x + y * y) / range)
}
machine diagonal(value: f64, noise: f64, row: u64, column: u64) -> f64 {
    transition row == column { true -> add(value, noise) false -> plain(value) }
    machine add(value: f64, noise: f64) -> f64 { value + noise } machine plain(value: f64) -> f64 { value }
}
machine training(problem: &mut Problem, row: u64, column: u64) {
    transition row < problem.count && row < 8 { true -> columns(problem, row, column) false -> done() }
    machine columns(problem: &mut Problem, row: u64, column: u64) requires row < 8 {
        transition column < problem.count && column < 8 { true -> cell(problem, row, column) false -> training(problem, row + 1, 0) }
    }
    machine cell(problem: &mut Problem, row: u64, column: u64) requires row < 8, column < 8 {
        let value: f64 = kernel(problem.x[row], problem.y[row], problem.x[column], problem.y[column], problem.range);
        problem.covariance[row * 8 + column] = diagonal(value, problem.noise / problem.variance, row, column);
        transition { _ -> columns(problem, row, column + 1) }
    }
    machine done() { }
}
machine cross_covariance(problem: &mut Problem, query: u64, index: u64) requires query < 8 {
    transition index < problem.count && index < 8 { true -> cell(problem, query, index) false -> done() }
    machine cell(problem: &mut Problem, query: u64, index: u64) requires query < 8, index < 8 {
        problem.cross[index] = kernel(problem.x[index], problem.y[index], problem.query_x[query], problem.query_y[query], problem.range);
        transition { _ -> cross_covariance(problem, query, index + 1) }
    }
    machine done() { }
}
machine assemble(problem: &mut Problem, row: u64, column: u64) requires problem.count <= 8 {
    transition row <= problem.count && row < 9 { true -> columns(problem, row, column) false -> done() }
    machine columns(problem: &mut Problem, row: u64, column: u64) requires row < 9, problem.count <= 8 {
        transition column <= problem.count && column < 9 { true -> select(problem, row, column) false -> rhs(problem, row) }
    }
    machine select(problem: &mut Problem, row: u64, column: u64) requires row < 9, column < 9, problem.count <= 8 {
        transition {
            row < problem.count && column < problem.count && row < 8 && column < 8 -> covariance(problem, row, column)
            row == problem.count && column == problem.count -> corner(problem, row, column)
            _ -> mean(problem, row, column)
        }
    }
    machine covariance(problem: &mut Problem, row: u64, column: u64) requires row < 8, column < 8, problem.count <= 8 {
        problem.matrix[row * 10 + column] = problem.covariance[row * 8 + column];
        transition { _ -> columns(problem, row, column + 1) }
    }
    machine corner(problem: &mut Problem, row: u64, column: u64) requires row < 9, column < 9, problem.count <= 8 {
        problem.matrix[row * 10 + column] = 0.0; transition { _ -> columns(problem, row, column + 1) }
    }
    machine mean(problem: &mut Problem, row: u64, column: u64) requires row < 9, column < 9, problem.count <= 8 {
        problem.matrix[row * 10 + column] = 1.0; transition { _ -> columns(problem, row, column + 1) }
    }
    machine rhs(problem: &mut Problem, row: u64) requires row < 9, problem.count <= 8 {
        transition row < problem.count && row < 8 { true -> observation(problem, row) false -> unbiased(problem, row) }
    }
    machine observation(problem: &mut Problem, row: u64) requires row < 8, problem.count <= 8 {
        problem.matrix[row * 10 + 9] = problem.cross[row]; transition { _ -> assemble(problem, row + 1, 0) }
    }
    machine unbiased(problem: &mut Problem, row: u64) requires row < 9, problem.count <= 8 {
        problem.matrix[row * 10 + 9] = 1.0; transition { _ -> assemble(problem, row + 1, 0) }
    }
    machine done() { }
}
machine eliminate(problem: &mut Problem, pivot: u64) -> bool {
    transition pivot <= problem.count && pivot < 9 { true -> select(problem, pivot, pivot, pivot) false -> good() }
    machine select(problem: &mut Problem, pivot: u64, best: u64, row: u64) -> bool requires pivot < 9, best < 9 {
        transition row <= problem.count && row < 9 { true -> compare(problem, pivot, best, row) false -> test(problem, pivot, best) }
    }
    machine compare(problem: &mut Problem, pivot: u64, best: u64, row: u64) -> bool requires pivot < 9, best < 9, row < 9 {
        transition magnitude(problem.matrix[row * 10 + pivot]) > magnitude(problem.matrix[best * 10 + pivot]) {
            true -> select(problem, pivot, row, row + 1) false -> select(problem, pivot, best, row + 1)
        }
    }
    machine test(problem: &mut Problem, pivot: u64, best: u64) -> bool requires pivot < 9, best < 9 {
        transition magnitude(problem.matrix[best * 10 + pivot]) > 0.000000000001 {
            true -> operate(problem, pivot, best) false -> bad()
        }
    }
    machine operate(problem: &mut Problem, pivot: u64, best: u64) -> bool requires pivot < 9, best < 9 {
        swap(problem, pivot, best, 0);
        let divisor: f64 = problem.matrix[pivot * 10 + pivot];
        normalize(problem, pivot, 0, divisor); rows(problem, pivot, 0);
        transition { _ -> eliminate(problem, pivot + 1) }
    }
    machine good() -> bool { true } machine bad() -> bool { false }
}
machine swap(problem: &mut Problem, pivot: u64, best: u64, column: u64) requires pivot < 9, best < 9 {
    transition column < 10 { true -> cell(problem, pivot, best, column) false -> done() }
    machine cell(problem: &mut Problem, pivot: u64, best: u64, column: u64) requires pivot < 9, best < 9, column < 10 {
        let saved: f64 = problem.matrix[pivot * 10 + column];
        problem.matrix[pivot * 10 + column] = problem.matrix[best * 10 + column]; problem.matrix[best * 10 + column] = saved;
        transition { _ -> swap(problem, pivot, best, column + 1) }
    }
    machine done() { }
}
machine normalize(problem: &mut Problem, pivot: u64, column: u64, divisor: f64) requires pivot < 9 {
    transition column < 10 { true -> cell(problem, pivot, column, divisor) false -> done() }
    machine cell(problem: &mut Problem, pivot: u64, column: u64, divisor: f64) requires pivot < 9, column < 10 {
        problem.matrix[pivot * 10 + column] = problem.matrix[pivot * 10 + column] / divisor;
        transition { _ -> normalize(problem, pivot, column + 1, divisor) }
    }
    machine done() { }
}
machine rows(problem: &mut Problem, pivot: u64, row: u64) requires pivot < 9 {
    transition {
        row <= problem.count && row < 9 && row != pivot -> subtract(problem, pivot, row)
        row <= problem.count && row < 9 -> rows(problem, pivot, row + 1)
        _ -> done()
    }
    machine subtract(problem: &mut Problem, pivot: u64, row: u64) requires pivot < 9, row < 9 {
        let factor: f64 = problem.matrix[row * 10 + pivot]; reduce_row(problem, pivot, row, 0, factor);
        transition { _ -> rows(problem, pivot, row + 1) }
    }
    machine done() { }
}
machine reduce_row(problem: &mut Problem, pivot: u64, row: u64, column: u64, factor: f64) requires pivot < 9, row < 9 {
    transition column < 10 { true -> cell(problem, pivot, row, column, factor) false -> done() }
    machine cell(problem: &mut Problem, pivot: u64, row: u64, column: u64, factor: f64) requires pivot < 9, row < 9, column < 10 {
        problem.matrix[row * 10 + column] = problem.matrix[row * 10 + column] - factor * problem.matrix[pivot * 10 + column];
        transition { _ -> reduce_row(problem, pivot, row, column + 1, factor) }
    }
    machine done() { }
}
machine measure(problem: &mut Problem, query: u64, index: u64, prediction: f64, product: f64, sum: f64) requires query < 8 {
    transition index < problem.count && index < 8 { true -> add(problem, query, index, prediction, product, sum) false -> finish(problem, query, prediction, product, sum) }
    machine add(problem: &mut Problem, query: u64, index: u64, prediction: f64, product: f64, sum: f64) requires query < 8, index < 8 {
        let weight: f64 = problem.matrix[index * 10 + 9]; problem.weights[query * 8 + index] = weight;
        transition { _ -> measure(problem, query, index + 1, prediction + weight * problem.values[index], product + weight * problem.cross[index], sum + weight) }
    }
    machine finish(problem: &mut Problem, query: u64, prediction: f64, product: f64, sum: f64) requires query < 8 {
        transition problem.count <= 8 { true -> report(problem, query, prediction, product, sum) false -> done() }
    }
    machine report(problem: &mut Problem, query: u64, prediction: f64, product: f64, sum: f64) requires query < 8, problem.count <= 8 {
        let multiplier: f64 = problem.matrix[problem.count * 10 + 9];
        problem.predictions[query] = prediction; problem.variances[query] = problem.variance * (1.0 - product - multiplier);
        problem.mean_residuals[query] = magnitude(sum - 1.0); problem.system_residuals[query] = 0.0;
        residual_rows(problem, query, 0, multiplier); transition { _ -> done() }
    }
    machine done() { }
}
// Componentwise backward error of the original normalized training rows.
// The unbiasedness row is emitted separately; it is not hidden in this scale.
machine residual_rows(problem: &mut Problem, query: u64, row: u64, multiplier: f64) requires query < 8 {
    transition row < problem.count && row < 8 { true -> columns(problem, query, row, 0, multiplier, multiplier, magnitude(multiplier)) false -> done() }
    machine columns(problem: &mut Problem, query: u64, row: u64, column: u64, multiplier: f64, value: f64, scale: f64) requires query < 8, row < 8 {
        transition column < problem.count && column < 8 { true -> add(problem, query, row, column, multiplier, value, scale) false -> store(problem, query, row, multiplier, value, scale) }
    }
    machine add(problem: &mut Problem, query: u64, row: u64, column: u64, multiplier: f64, value: f64, scale: f64) requires query < 8, row < 8, column < 8 {
        let term: f64 = problem.covariance[row * 8 + column] * problem.weights[query * 8 + column];
        transition { _ -> columns(problem, query, row, column + 1, multiplier, value + term, scale + magnitude(term)) }
    }
    machine store(problem: &mut Problem, query: u64, row: u64, multiplier: f64, value: f64, scale: f64) requires query < 8, row < 8 {
        let residual: f64 = magnitude(value - problem.cross[row]) / (1.0 + scale + magnitude(problem.cross[row]));
        transition residual > problem.system_residuals[query] { true -> replace(problem, query, row, multiplier, residual) false -> residual_rows(problem, query, row + 1, multiplier) }
    }
    machine replace(problem: &mut Problem, query: u64, row: u64, multiplier: f64, residual: f64) requires query < 8 {
        problem.system_residuals[query] = residual; transition { _ -> residual_rows(problem, query, row + 1, multiplier) }
    }
    machine done() { }
}
