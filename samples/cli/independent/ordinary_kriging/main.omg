// Expected exit: 64.
// Expected output contains: error invalid input
use omega_language_std::console;
use io::input;
use io::output;
use model::kriging;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut raw: Raw;
    let accepted: bool = block read(&main.console, &mut raw);
    transition accepted { true -> validate(&main.console, &raw) false -> invalid(&main.console) }
    state validate(console: &Binding<Console>, raw: &Raw) {
        let mut problem: Problem;
        transition decode(raw, &mut problem) { true -> calculate(console, &mut problem) false -> invalid(console) }
    }
    state calculate(console: &Binding<Console>, problem: &mut Problem) {
        transition solve(problem) { true -> report(console, problem) false -> singular(console) }
    }
    state report(console: &Binding<Console>, problem: &Problem) { emit(console, problem); Console::exit_process(console, 0); }
    state singular(console: &Binding<Console>) { Console::write_line(console, "status singular-system"); Console::exit_process(console, 2); }
    state invalid(console: &Binding<Console>) { Console::write_line(console, "error invalid input"); Console::exit_process(console, 64); }
}
