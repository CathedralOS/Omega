// Intended source-invalid: displacement index equals the array capacity.
data Main { displacement: [f64; 16]; }
machine Main::main(main: &mut Main) {
    let invalid: f64 = main.displacement[16];
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
