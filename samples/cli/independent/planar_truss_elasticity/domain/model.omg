public data Truss {
    nodes: u64; bars: u64; coordinates: [f64; 16]; fixed: [bool; 16]; loads: [f64; 16];
    first: [u64; 16]; second: [u64; 16]; rigidity: [f64; 16]; valid: bool;
}
public data Solution {
    stiffness: [[f64; 16]; 16]; reduced: [[f64; 16]; 16]; right: [f64; 16];
    displacement: [f64; 16]; reaction: [f64; 16]; internal: [f64; 16];
    extension: [f64; 16]; force: [f64; 16]; direction: [f64; 16];
    energy: f64; work: f64; residual: f64; balance_x: f64; balance_y: f64; moment: f64;
    scale: f64; valid: bool; status: i32;
}
