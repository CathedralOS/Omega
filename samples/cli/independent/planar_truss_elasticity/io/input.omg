// EOF-terminated signed integers, |token| <= 1000000; at most 4095 bytes.
use omega_language_std::console;
use omega::language::core::float_operations;


pub data Input { tokens: [i32; 98]; count: u64; valid: bool; negative: bool; }
pub machine read_input(input: &mut Input) reaches Console
invokes Console;
blocks;
crashes Trap
{
    input.valid = false;
    transition { _ -> scan(input, 0, 0, 0, false, 0) }
    state scan(input: &mut Input, count: u64, value: i32, digits: u64, pending: bool, bytes: u64)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires digits <= 7 requires bytes <= 4096 {
        transition bytes < 4096 { true -> read(input, count, value, digits, pending, bytes) false -> bad() }
    }
    state read(input: &mut Input, count: u64, value: i32, digits: u64, pending: bool, bytes: u64)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires digits <= 7 requires bytes < 4096 {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> eof(input, count, value, pending)
            ByteRead::Byte { value as byte } -> classify(input, count, value, digits, pending, bytes + 1, byte)
        }
    }
    state classify(input: &mut Input, count: u64, value: i32, digits: u64, pending: bool, bytes: u64, byte: i32)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires digits <= 7 requires bytes <= 4096 requires byte >= 0 requires byte <= 255 {
        transition byte >= 48 && byte <= 57 { true -> digit(input, count, value, digits, bytes, byte) false -> sign_test(input, count, value, digits, pending, bytes, byte) }
    }
    state sign_test(input: &mut Input, count: u64, value: i32, digits: u64, pending: bool, bytes: u64, byte: i32)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires digits <= 7 requires bytes <= 4096 {
        transition byte == 45 && !pending && !input.negative {
            true -> sign(input, count, bytes)
            false -> separator(input, count, value, digits, pending, bytes, byte)
        }
    }
    state sign(input: &mut Input, count: u64, bytes: u64)
    requires count <= 98 requires bytes <= 4096 {
        input.negative = true;
        transition { _ -> scan(input, count, 0, 0, false, bytes) }
    }
    state digit(input: &mut Input, count: u64, value: i32, digits: u64, bytes: u64, byte: i32)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires digits <= 7 requires bytes <= 4096 requires byte >= 48 requires byte <= 57 {
        transition digits < 7 { true -> append(input, count, value, digits, bytes, byte) false -> bad() }
    }
    state append(input: &mut Input, count: u64, value: i32, digits: u64, bytes: u64, byte: i32)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires digits < 7 requires bytes <= 4096 requires byte >= 48 requires byte <= 57 {
        let next: i32 = value * 10 + byte - 48;
        transition next <= 1000000 { true -> scan(input, count, next, digits + 1, true, bytes) false -> bad() }
    }
    state separator(input: &mut Input, count: u64, value: i32, digits: u64, pending: bool, bytes: u64, byte: i32)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires digits <= 7 requires bytes <= 4096 {
        transition byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            true -> sign_complete(input, count, value, pending, bytes)
            false -> bad()
        }
    }
    state sign_complete(input: &mut Input, count: u64, value: i32, pending: bool, bytes: u64)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires bytes <= 4096 {
        transition !input.negative || pending { true -> flush(input, count, value, pending, bytes) false -> bad() }
    }
    state flush(input: &mut Input, count: u64, value: i32, pending: bool, bytes: u64)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires bytes <= 4096 {
        transition pending { true -> capacity(input, count, value, bytes) false -> scan(input, count, 0, 0, false, bytes) }
    }
    state capacity(input: &mut Input, count: u64, value: i32, bytes: u64)
    requires count <= 98 requires value >= 0 requires value <= 1000000 requires bytes <= 4096 {
        transition count < 98 { true -> store(input, count, value, bytes) false -> bad() }
    }
    state store(input: &mut Input, count: u64, value: i32, bytes: u64)
    requires count < 98 requires value >= 0 requires value <= 1000000 requires bytes <= 4096 {
        input.tokens[count] = match input.negative { true -> (0 - value) false -> value };
        input.negative = false;
        transition { _ -> scan(input, count + 1, 0, 0, false, bytes) }
    }
    state eof(input: &mut Input, count: u64, value: i32, pending: bool)
    requires count <= 98 requires value >= 0 requires value <= 1000000 {
        transition pending { true -> last_capacity(input, count, value) false -> eof_empty(input, count) }
    }
    state last_capacity(input: &mut Input, count: u64, value: i32)
    requires count <= 98 requires value >= 0 requires value <= 1000000 {
        transition count < 98 { true -> last(input, count, value) false -> bad() }
    }
    state last(input: &mut Input, count: u64, value: i32)
    requires count < 98 requires value >= 0 requires value <= 1000000 {
        input.tokens[count] = match input.negative { true -> (0 - value) false -> value };
        input.negative = false;
        transition { _ -> finish(input, count + 1) }
    }
    state eof_empty(input: &mut Input, count: u64) {
        transition input.negative { true -> bad() false -> finish(input, count) }
    }
    state finish(input: &mut Input, count: u64) {
        input.count = count;
        input.valid = true;
    }
    state bad() {}
}
