// Expected exit: 0
// Expected output contains: planar_truss_elasticity
use omega_language_std::console;
use io::input;
use io::decode;
use io::report;
use domain::model;
use domain::solver;
data Main { input: Input; output: Output; truss: Truss; result: Solution; }
machine Main::main(main: &mut Main) reaches Console {
    block read_input(&mut main.input);
    transition main.input.valid { true -> decode_input(main) false -> invalid(main) }
    state decode_input(main: &mut Main) {
        decode(&main.input, &mut main.truss);
        transition main.truss.valid && main.truss.nodes <= 8 && main.truss.bars <= 16 { true -> compute(main) false -> invalid(main) }
    }
    state compute(main: &mut Main) requires main.truss.nodes <= 8 requires main.truss.bars <= 16 {
        solve(&main.truss, &mut main.result);
        transition main.result.valid { true -> output(main) false -> failure(main) }
    }
    state output(main: &mut Main) {
        report(&mut main.output, &main.truss, &main.result);
        Console::exit_process(0);
    }
    state failure(main: &mut Main) {
        transition main.result.status == 65 { true -> mechanism(main) false -> invalid(main) }
    }
    state mechanism(main: &mut Main) { Console::write_line("MECHANISM: singular or numerically unresolved stiffness"); Console::exit_process(65); }
    state invalid(main: &mut Main) { Console::write_line("INVALID: bounded integers, dimensions, indices, flags, positive EA or nonzero length required"); Console::exit_process(64); }
}
