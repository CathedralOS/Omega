// Bounded plain decimal scanner: optional minus, 1–12 digits, optional dot
// with digits on both sides. No exponent, NaN or infinity spelling is accepted.
// The total budget includes separators. EOF after a complete token is valid.
use omega_language_std::console;
use omega::language::core::float_operations;
pub data Reader { consumed: i32; }
pub data Number [copy] { valid: bool; value: f64; }
machine character(reader: &mut Reader) -> i32 reaches Console {
    transition reader.consumed >= 0 && reader.consumed < 4096 { true -> read(reader) _ -> -2 }
    state read(reader: &mut Reader) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        let byte: ByteRead = block Console::read_byte();
        transition byte { ByteRead::Eof -> -1 ByteRead::Byte { value } -> counted(reader, value) }
    }
    state counted(reader: &mut Reader, value: i32) -> i32 requires reader.consumed >= 0 && reader.consumed < 4096 {
        reader.consumed = reader.consumed + 1;
        transition { _ -> value }
    }
}
machine whitespace(value: i32) -> bool { transition { _ -> (value == 32 || value == 10 || value == 13 || value == 9) } }
pub machine number(reader: &mut Reader) -> Number reaches Console invokes Console; blocks; crashes Trap {
    transition { _ -> start(reader) }
    state start(reader: &mut Reader) -> Number {
        let value: i32 = block character(reader);
        transition whitespace(value) { true -> start(reader) _ -> sign(reader, value) }
    }
    state sign(reader: &mut Reader, value: i32) -> Number {
        transition value == 45 { true -> negative(reader) _ -> scan(reader, value, 1.0, 0.0, 1.0, 0, false, false) }
    }
    state negative(reader: &mut Reader) -> Number {
        let value: i32 = block character(reader);
        transition { _ -> scan(reader, value, -1.0, 0.0, 1.0, 0, false, false) }
    }
    state scan(reader: &mut Reader, value: i32, sign: f64, accumulated: f64, scale: f64, digits: i32, decimal: bool, fraction: bool) -> Number {
        transition value >= 48 && value <= 57 && digits >= 0 && digits < 12 {
            true -> append(reader, value, sign, accumulated, scale, digits, decimal)
            _ -> delimiter(reader, value, sign, accumulated, scale, digits, decimal, fraction)
        }
    }
    state append(reader: &mut Reader, value: i32, sign: f64, accumulated: f64, scale: f64, digits: i32, decimal: bool) -> Number
    requires value >= 48 && value <= 57 && digits >= 0 && digits < 12 {
        let numeric: f64 = F64::from_i32(value - 48);
        let next_scale: f64 = match decimal { true -> scale * 0.1 _ -> scale };
        let next: f64 = match decimal { true -> accumulated + numeric * next_scale _ -> accumulated * 10.0 + numeric };
        let observed: i32 = block character(reader);
        transition { _ -> scan(reader, observed, sign, next, next_scale, digits + 1, decimal, decimal) }
    }
    state delimiter(reader: &mut Reader, value: i32, sign: f64, accumulated: f64, scale: f64, digits: i32, decimal: bool, fraction: bool) -> Number {
        transition value == 46 && !decimal && digits > 0 {
            true -> dot(reader, sign, accumulated, scale, digits)
            _ -> finish(value, sign, accumulated, digits, decimal, fraction)
        }
    }
    state dot(reader: &mut Reader, sign: f64, accumulated: f64, scale: f64, digits: i32) -> Number {
        let observed: i32 = block character(reader);
        transition { _ -> scan(reader, observed, sign, accumulated, scale, digits, true, false) }
    }
    state finish(value: i32, sign: f64, accumulated: f64, digits: i32, decimal: bool, fraction: bool) -> Number {
        transition digits > 0 && (!decimal || fraction) && (whitespace(value) || value == -1) {
            true -> Number { valid: true, value: sign * accumulated }
            _ -> Number { valid: false, value: 0.0 }
        }
    }
}
pub machine ended(reader: &mut Reader) -> bool reaches Console invokes Console; blocks; crashes Trap {
    transition { _ -> scan(reader) }
    state scan(reader: &mut Reader) -> bool {
        let value: i32 = block character(reader);
        transition value == -1 { true -> true _ -> space(reader, value) }
    }
    state space(reader: &mut Reader, value: i32) -> bool { transition whitespace(value) { true -> scan(reader) _ -> false } }
}
