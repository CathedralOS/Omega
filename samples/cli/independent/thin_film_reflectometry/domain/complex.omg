// Generic scalar operations and nested calls use the canonical complex carrier.
use numerics::complex::complex_carrier_ops::Complex;
use omega::language::core::float_operations;

public trait Arithmetic<Scalar [copy]> {
    machine plus(left: Scalar, right: Scalar) -> Scalar;
    machine minus(left: Scalar, right: Scalar) -> Scalar;
    machine times(left: Scalar, right: Scalar) -> Scalar;
    machine divide(left: Scalar, right: Scalar) -> Scalar;
}
public Double satisfies Arithmetic<f64> {
    machine plus(left: f64, right: f64) -> f64 { left + right }
    machine minus(left: f64, right: f64) -> f64 { left - right }
    machine times(left: f64, right: f64) -> f64 { left * right }
    machine divide(left: f64, right: f64) -> f64 { left / right }
}
public machine norm<Scalar [copy], Operations satisfies Arithmetic<Scalar>>(value: Complex<Scalar>) -> Scalar {
    Arithmetic::plus<Scalar, Operations>(
        Arithmetic::times<Scalar, Operations>(value.real, value.real),
        Arithmetic::times<Scalar, Operations>(value.imaginary, value.imaginary))
}
public machine quotient<Scalar [copy], Operations satisfies Arithmetic<Scalar>>(
    numerator: Complex<Scalar>, denominator: Complex<Scalar>) -> Complex<Scalar> {
    Complex {
        real: Arithmetic::divide<Scalar, Operations>(
            Arithmetic::plus<Scalar, Operations>(
                Arithmetic::times<Scalar, Operations>(numerator.real, denominator.real),
                Arithmetic::times<Scalar, Operations>(numerator.imaginary, denominator.imaginary)),
            norm<Scalar, Operations>(denominator)),
        imaginary: Arithmetic::divide<Scalar, Operations>(
            Arithmetic::minus<Scalar, Operations>(
                Arithmetic::times<Scalar, Operations>(numerator.imaginary, denominator.real),
                Arithmetic::times<Scalar, Operations>(numerator.real, denominator.imaginary)),
            norm<Scalar, Operations>(denominator))
    }
}
