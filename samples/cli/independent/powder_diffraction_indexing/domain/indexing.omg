use omega::language::core::float_operations;
use omega_language_std::console;
use io::input;
use io::output;
pub data Problem {
    count: u64; wavelength: f64; tolerance: f64;
    angles: [f64; 6]; vectors: [f64; 6]; lines: [u64; 8];
    assignments: [u64; 6]; residuals: [f64; 6]; predictions: [f64; 6];
    selected: u64; missing: u64; last: u64; hypotheses: u64;
    scale: f64; lattice: f64;
}
pub machine decode(raw: &Raw, problem: &mut Problem) -> bool {
    let count: u64 in Saturating = U64::from_f64(raw.values[1]);
    transition raw.count >= 6 && raw.count <= 9 && count >= 3 && count <= 6
        && F64::from_u64(count as u64) == raw.values[1] && raw.count == 3 + (count as u64)
        && raw.values[0] >= 0.5 && raw.values[0] <= 2.5 && raw.values[2] > 0.0 && raw.values[2] <= 1.0 {
        true -> initialize(raw, problem, count as u64) false -> bad()
    }
    state initialize(raw: &Raw, problem: &mut Problem, count: u64) -> bool {
        problem.count = count; problem.wavelength = raw.values[0]; problem.tolerance = raw.values[2];
        transition { _ -> scan(raw, problem, 0, 0.0) }
    }
    state scan(raw: &Raw, problem: &mut Problem, index: u64, previous: f64) -> bool {
        transition index < problem.count && index < 6 { true -> angle(raw, problem, index, previous) false -> good() }
    }
    state angle(raw: &Raw, problem: &mut Problem, index: u64, previous: f64) -> bool requires index < 6 {
        let observed: f64 = raw.values[index + 3];
        transition observed > previous && observed < 180.0 {
            true -> save(problem, raw, index, observed) false -> bad()
        }
    }
    state save(problem: &mut Problem, raw: &Raw, index: u64, observed: f64) -> bool requires index < 6 {
        problem.angles[index] = observed;
        let vector: f64 = 2.0 * sine(observed * 3.14159265358979323846 / 360.0) / problem.wavelength;
        problem.vectors[index] = vector * vector;
        transition { _ -> scan(raw, problem, index + 1, observed) }
    }
    state good() -> bool { true } state bad() -> bool { false }
}
// On [0, pi/2], 16 Taylor terms have truncation error below 1e-29.
// Bisection in the same monotone interval avoids a poorly conditioned asin
// power series near 90 degrees. IEEE rounding dominates both calculations.
pub machine sine(value: f64) -> f64 {
    transition { _ -> term(value, 1, value, value) }
    state term(value: f64, index: u64, current: f64, total: f64) -> f64 {
        transition index < 16 { true -> add(value, index, current, total) false -> done(total) }
    }
    state add(value: f64, index: u64, current: f64, total: f64) -> f64 requires index < 16 {
        let divisor: f64 = F64::from_u64(2 * index) * F64::from_u64(2 * index + 1);
        let following: f64 = (0.0 - current) * value * value / divisor;
        transition { _ -> term(value, index + 1, following, total + following) }
    }
    state done(total: f64) -> f64 { total }
}
machine inverse_sine(value: f64) -> f64 {
    transition { _ -> bisect(value, 0, 0.0, 1.57079632679489661923) }
    state bisect(value: f64, iteration: u64, low: f64, high: f64) -> f64 {
        transition iteration < 52 { true -> compare(value, iteration, low, high) false -> done(low, high) }
    }
    state compare(value: f64, iteration: u64, low: f64, high: f64) -> f64 requires iteration < 52 {
        let middle: f64 = (low + high) * 0.5;
        transition sine(middle) < value { true -> bisect(value, iteration + 1, middle, high) false -> bisect(value, iteration + 1, low, middle) }
    }
    state done(low: f64, high: f64) -> f64 { (low + high) * 0.5 }
}
pub machine allowed(kind: u64, h: u64, k: u64, l: u64) -> bool requires h < 5, k < 5, l < 5 {
    kind == 0 || (kind == 1 && (h + k + l) % 2 == 0) || (kind == 2 && h % 2 == k % 2 && k % 2 == l % 2)
}
// Canonical families h >= k >= l >= 0 remove sign/permutation duplicates.
// Searching through N=20 with h<=4 is complete for the first eight distinct
// allowed N in each class. This is a search ceiling, not a reflection table.
machine represented(kind: u64, squared: u64) -> bool {
    transition { _ -> scan(kind, squared, 0, 0, 0) }
    state scan(kind: u64, squared: u64, h: u64, k: u64, l: u64) -> bool {
        transition h < 5 && k < 5 && l < 5 { true -> test(kind, squared, h, k, l) false -> no() }
    }
    state test(kind: u64, squared: u64, h: u64, k: u64, l: u64) -> bool requires h < 5, k < 5, l < 5 {
        transition h >= k && k >= l && h * h + k * k + l * l == squared && allowed(kind, h, k, l) {
            true -> yes() false -> advance(kind, squared, h, k, l)
        }
    }
    state advance(kind: u64, squared: u64, h: u64, k: u64, l: u64) -> bool requires h < 5, k < 5, l < 5 {
        transition { l < 4 -> scan(kind, squared, h, k, l + 1) k < 4 -> scan(kind, squared, h, k + 1, 0) _ -> scan(kind, squared, h + 1, 0, 0) }
    }
    state yes() -> bool { true } state no() -> bool { false }
}
machine collect(problem: &mut Problem, kind: u64, squared: u64, count: u64) {
    transition squared <= 20 && count < 8 { true -> test(problem, kind, squared, count) false -> done() }
    state test(problem: &mut Problem, kind: u64, squared: u64, count: u64) requires squared <= 20, count < 8 {
        transition represented(kind, squared) { true -> store(problem, kind, squared, count) false -> collect(problem, kind, squared + 1, count) }
    }
    state store(problem: &mut Problem, kind: u64, squared: u64, count: u64) requires squared <= 20, count < 8 {
        problem.lines[count] = squared;
        transition { _ -> collect(problem, kind, squared + 1, count + 1) }
    }
    state done() { }
}
pub machine enumerate(problem: &mut Problem) reaches Console invokes Console; {
    Console::write_line("units lattice/scale/angles/residuals 1e-12; indices/families exact");
    classes(problem, 0); Console::write("hypotheses"); integer(problem.hypotheses); Console::write_line("");
}
machine classes(problem: &mut Problem, kind: u64) reaches Console invokes Console; {
    transition kind < 3 { true -> search(problem, kind) false -> done() }
    state search(problem: &mut Problem, kind: u64) requires kind < 3 {
        collect(problem, kind, 1, 0); masks(problem, kind, 1);
        transition { _ -> classes(problem, kind + 1) }
    }
    state done() { }
}
machine masks(problem: &mut Problem, kind: u64, mask: u64) reaches Console invokes Console; {
    transition mask < 256 { true -> test(problem, kind, mask) false -> done() }
    state test(problem: &mut Problem, kind: u64, mask: u64) requires mask < 256 {
        problem.selected = 0; problem.missing = 0; problem.last = 0;
        choose(problem, mask, 0, 0);
        transition problem.selected == problem.count && problem.missing <= 2 {
            true -> candidate(problem, kind, mask) false -> masks(problem, kind, mask + 1)
        }
    }
    state candidate(problem: &mut Problem, kind: u64, mask: u64) requires mask < 256 {
        transition fit(problem) && problem.hypotheses < 768 { true -> emit(problem, kind, mask) false -> masks(problem, kind, mask + 1) }
    }
    state emit(problem: &mut Problem, kind: u64, mask: u64) requires mask < 256, problem.hypotheses < 768 {
        let total: u64 = problem.hypotheses;
        report(problem, kind, mask); problem.hypotheses = total + 1;
        transition { _ -> masks(problem, kind, mask + 1) }
    }
    state done() { }
}
// Missing lines count only unselected ranks before the highest observed rank.
// The unobserved high-angle tail of the eight-line search window is not missing.
machine choose(problem: &mut Problem, mask: u64, rank: u64, skipped: u64) {
    transition rank < 8 && mask > 0 && skipped <= 8 { true -> test(problem, mask, rank, skipped) false -> done() }
    state test(problem: &mut Problem, mask: u64, rank: u64, skipped: u64) requires rank < 8, skipped <= 8 {
        transition {
            mask % 2 == 0 -> choose(problem, mask / 2, rank + 1, skipped + 1)
            problem.selected < 6 -> store(problem, mask, rank, skipped)
            _ -> excess(problem)
        }
    }
    state store(problem: &mut Problem, mask: u64, rank: u64, skipped: u64) requires rank < 8, problem.selected < 6, skipped <= 8 {
        problem.assignments[problem.selected] = problem.lines[rank];
        problem.selected = problem.selected + 1; problem.missing = skipped; problem.last = rank;
        transition { _ -> choose(problem, mask / 2, rank + 1, skipped) }
    }
    state done() { }
    state excess(problem: &mut Problem) { problem.selected = 7; }
}
// Least squares through the physical origin: q^2=N/a^2. Fitting the reciprocal
// scale does not minimize angle residuals; angles separately decide admission.
machine fit(problem: &mut Problem) -> bool {
    transition { _ -> accumulate(problem, 0, 0.0, 0.0) }
    state accumulate(problem: &mut Problem, index: u64, numerator: f64, denominator: f64) -> bool {
        transition index < problem.count && index < 6 { true -> term(problem, index, numerator, denominator) false -> scale(problem, numerator, denominator) }
    }
    state term(problem: &mut Problem, index: u64, numerator: f64, denominator: f64) -> bool requires index < 6 {
        let squared: f64 = F64::from_u64(problem.assignments[index]);
        transition { _ -> accumulate(problem, index + 1, numerator + squared * problem.vectors[index], denominator + squared * squared) }
    }
    state scale(problem: &mut Problem, numerator: f64, denominator: f64) -> bool {
        problem.scale = numerator / denominator; problem.lattice = 1.0 / F64::square_root(problem.scale);
        transition problem.lattice >= 2.0 && problem.lattice <= 10.0 { true -> residual(problem, 0) false -> no() }
    }
    state residual(problem: &mut Problem, index: u64) -> bool {
        transition index < problem.count && index < 6 { true -> predict(problem, index) false -> yes() }
    }
    state predict(problem: &mut Problem, index: u64) -> bool requires index < 6 {
        let argument: f64 = problem.wavelength * F64::square_root(problem.scale * F64::from_u64(problem.assignments[index])) * 0.5;
        transition argument > 0.0 && argument < 1.0 { true -> angle(problem, index, argument) false -> no() }
    }
    state angle(problem: &mut Problem, index: u64, argument: f64) -> bool requires index < 6 {
        let predicted: f64 = 360.0 * inverse_sine(argument) / 3.14159265358979323846;
        let difference: f64 = predicted - problem.angles[index];
        problem.predictions[index] = predicted; problem.residuals[index] = difference;
        transition difference >= 0.0 - problem.tolerance && difference <= problem.tolerance {
            true -> residual(problem, index + 1) false -> no()
        }
    }
    state yes() -> bool { true } state no() -> bool { false }
}
