use omega::language::core::numeric_conversion;
use model::fill;

// Fixed grammar: WWWW GGGG VVVV BB, with hex masks and decimal cell budget.
// The input reader passes only its initialized prefix. No number accepts a
// sign, junk suffix, overflowing digit sequence, or implicit default.
machine hexadecimal(byte: u8) -> i32 in Wrapping {
    let value: i32 in Wrapping = widen_u8_to_i32(byte) as i32 in Wrapping;
    transition {
        value >= 48 && value <= 57 -> (value - 48)
        value >= 65 && value <= 70 -> (value - 55)
        value >= 97 && value <= 102 -> (value - 87)
        _ -> (0 - 1)
    }
}

machine parse_hex(text: &[u8], start: i32 in Wrapping) -> i32 in Wrapping {
    transition { _ -> digit(text, start, 0, 0) }
    machine digit(text: &[u8], position: i32 in Wrapping,
                count: i32 in Wrapping, value: i32 in Wrapping) -> i32 in Wrapping {
        transition count < 4 {
            true -> bounds(text, position, count, value)
            _ -> (value)
        }
    }
    machine bounds(text: &[u8], position: i32 in Wrapping,
                 count: i32 in Wrapping, value: i32 in Wrapping) -> i32 in Wrapping {
        transition position >= 0 && position < text.len {
            true -> read(text, position, count, value)
            _ -> (0 - 1)
        }
    }
    machine read(text: &[u8], position: i32 in Wrapping,
               count: i32 in Wrapping, value: i32 in Wrapping) -> i32 in Wrapping {
        let number: i32 in Wrapping = hexadecimal(text[position]);
        transition number >= 0 {
            true -> digit(text, position + 1, count + 1, value * 16 + number)
            _ -> (0 - 1)
        }
    }
}

public machine parse_input(text: &[u8], cavity: &mut Cavity) -> bool {
    transition text.len >= 17 && text.len <= 19 {
        true -> ending(text, cavity)
        _ -> false
    }
    machine ending(text: &[u8], cavity: &mut Cavity) -> bool
    requires text.len >= 17
    {
        transition text.len {
            17 -> separators(text, cavity)
            18 -> newline(text, cavity)
            19 -> carriage(text, cavity)
            _ -> false
        }
    }
    machine newline(text: &[u8], cavity: &mut Cavity) -> bool
    requires text.len >= 18
    {
        transition text[17] == 10 {
            true -> separators(text, cavity)
            _ -> false
        }
    }
    machine carriage(text: &[u8], cavity: &mut Cavity) -> bool
    requires text.len >= 19
    {
        transition text[17] == 13 && text[18] == 10 {
            true -> separators(text, cavity)
            _ -> false
        }
    }
    machine separators(text: &[u8], cavity: &mut Cavity) -> bool
    requires text.len >= 17
    {
        transition text[4] == 32 && text[9] == 32 && text[14] == 32 {
            true -> numbers(text, cavity)
            _ -> false
        }
    }
    machine numbers(text: &[u8], cavity: &mut Cavity) -> bool
    requires text.len >= 17
    {
        let walls: i32 in Wrapping = parse_hex(text, 0);
        let gates: i32 in Wrapping = parse_hex(text, 5);
        let vents: i32 in Wrapping = parse_hex(text, 10);
        let tens: i32 in Wrapping = widen_u8_to_i32(text[15]) as i32 in Wrapping;
        let ones: i32 in Wrapping = widen_u8_to_i32(text[16]) as i32 in Wrapping;
        transition walls >= 0 && gates >= 0 && vents >= 0
            && tens >= 48 && tens <= 57 && ones >= 48 && ones <= 57 {
            true -> store(cavity, walls, gates, vents, (tens - 48) * 10 + ones - 48)
            _ -> false
        }
    }
    machine store(cavity: &mut Cavity, walls: i32 in Wrapping, gates: i32 in Wrapping,
                vents: i32 in Wrapping, budget: i32 in Wrapping) -> bool {
        cavity.walls = walls;
        cavity.gates = gates;
        cavity.vents = vents;
        cavity.budget = budget;
        Cavity::valid(cavity)
    }
}
