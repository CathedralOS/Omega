// Complete current-main reproduction: owned byte array crosses a case edge.
data Count { case Value(count: u64); case End; }
machine main() {
    let mut input: [u8; 32];
    let result: Count = Count::Value { count: 17 };
    transition result {
        Count::Value { count } -> observe(&input, count)
        _ -> done()
    }
    machine observe(input: &[u8; 32], count: u64) {
        let first: u8 = input[0];
        transition count == 17 && first == 0 { true -> done() _ -> done() }
    }
    machine done() { }
}
