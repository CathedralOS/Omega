use omega_language_std::console;
use omega::language::core::binding;
use model::fill;

machine decimal(console: &mut Binding<Console>, value: i32 in Wrapping,
                 divisor: i32 in Wrapping) reaches Console {
    transition divisor > 0 {
        true -> digit(console, value, divisor)
        _ -> done()
    }
    state digit(console: &mut Binding<Console>, value: i32 in Wrapping,
                 divisor: i32 in Wrapping) {
        console.write_byte(((value / divisor) % 10 + 48) as i32);
        transition { _ -> decimal(console, value, divisor / 10) }
    }
    state done() { }
}

machine map(console: &mut Binding<Console>, cavity: &Cavity, phase: bool) reaches Console {
    transition { _ -> cell(console, cavity, phase, 0, 1) }
    state cell(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition index >= 0 && index < 16 {
            true -> symbol(console, cavity, phase, index, bit)
            _ -> done()
        }
    }
    state symbol(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                  index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition {
            ((cavity.walls & bit) != 0) -> character(console, cavity, phase, index, bit, 35)
            phase -> phase_cell(console, cavity, phase, index, bit)
            ((cavity.filled & bit) != 0) -> arrival(console, cavity, phase, index, bit)
            _ -> character(console, cavity, phase, index, bit, 46)
        }
    }
    state phase_cell(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                      index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition {
            ((cavity.filled & bit) != 0) -> character(console, cavity, phase, index, bit, 82)
            ((cavity.trapped & bit) != 0) -> character(console, cavity, phase, index, bit, 84)
            _ -> character(console, cavity, phase, index, bit, 65)
        }
    }
    state character(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                     index: i32 in Wrapping, bit: i32 in Wrapping, value: i32) {
        console.write_byte(value);
        transition { _ -> separator(console, cavity, phase, index, bit) }
    }
    state arrival(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                   index: i32 in Wrapping, bit: i32 in Wrapping) {
        decimal(console, cavity.arrival[index], 10);
        transition { _ -> separator(console, cavity, phase, index, bit) }
    }
    state separator(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                     index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition index % 4 == 3 {
            true -> newline(console, cavity, phase, index, bit)
            _ -> space(console, cavity, phase, index, bit)
        }
    }
    state newline(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                   index: i32 in Wrapping, bit: i32 in Wrapping) {
        console.write_byte(10);
        transition { _ -> cell(console, cavity, phase, index + 1, bit << 1) }
    }
    state space(console: &mut Binding<Console>, cavity: &Cavity, phase: bool,
                 index: i32 in Wrapping, bit: i32 in Wrapping) {
        console.write_byte(32);
        transition { _ -> cell(console, cavity, phase, index + 1, bit << 1) }
    }
    state done() { }
}

machine regions(console: &mut Binding<Console>, trapped: i32 in Wrapping) reaches Console {
    transition { _ -> scan(console, trapped, 0, 1) }
    state scan(console: &mut Binding<Console>, rest: i32 in Wrapping,
                index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition index < 16 && rest != 0 {
            true -> test(console, rest, index, bit)
            _ -> done()
        }
    }
    state test(console: &mut Binding<Console>, rest: i32 in Wrapping,
                index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition (rest & bit) != 0 {
            true -> region(console, rest, index, bit)
            _ -> scan(console, rest, index + 1, bit << 1)
        }
    }
    state region(console: &mut Binding<Console>, rest: i32 in Wrapping,
                  index: i32 in Wrapping, bit: i32 in Wrapping) {
        let component: i32 in Wrapping = air_closure(rest, bit);
        decimal(console, component, 10000);
        console.write_byte(32);
        decimal(console, cell_count(component), 10);
        console.write_byte(10);
        transition { _ -> scan(console, rest & ~component, index + 1, bit << 1) }
    }
    state done() { }
}

pub machine report(console: &mut Binding<Console>, cavity: &Cavity) reaches Console
invokes console;
{
    console.write_line("MOLD_FRONT_VENT_V1");
    console.write_line("arrival ticks (# wall, . unfilled):");
    map(console, cavity, false);
    console.write_line("phase (# wall, R resin, T trapped, A vented air):");
    map(console, cavity, true);
    console.write_line("trapped regions (mask, cells):");
    regions(console, cavity.trapped);
    console.write_line("balance wall resin trapped vented budget unused rounds:");
    decimal(console, cell_count(cavity.walls), 10);
    console.write_byte(32);
    decimal(console, cavity.used, 10);
    console.write_byte(32);
    decimal(console, cell_count(cavity.trapped), 10);
    console.write_byte(32);
    decimal(console, cell_count(cavity.vented), 10);
    console.write_byte(32);
    decimal(console, cavity.budget, 10);
    console.write_byte(32);
    decimal(console, cavity.budget - cavity.used, 10);
    console.write_byte(32);
    decimal(console, cavity.tick, 10);
    console.write_byte(10);
    console.write_line("OK");
}
