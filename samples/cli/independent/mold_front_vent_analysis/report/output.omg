use omega_language_std::console;
use model::fill;

machine decimal(value: i32 in Wrapping, divisor: i32 in Wrapping) reaches Console {
    transition divisor > 0 {
        true -> digit(value, divisor, 0)
        _ -> done()
    }
    state digit(value: i32 in Wrapping, divisor: i32 in Wrapping, count: i32 in Wrapping) {
        transition value >= divisor {
            true -> digit(value - divisor, divisor, count + 1)
            _ -> emit(value, divisor, count)
        }
    }
    state emit(remainder: i32 in Wrapping, divisor: i32 in Wrapping, count: i32 in Wrapping) {
        Console::write_byte((count + 48) as i32);
        transition divisor {
            10000 -> decimal(remainder, 1000)
            1000 -> decimal(remainder, 100)
            100 -> decimal(remainder, 10)
            10 -> decimal(remainder, 1)
            _ -> done()
        }
    }
    state done() { }
}

machine map(cavity: &Cavity, phase: bool) reaches Console {
    transition { _ -> cell(cavity, phase, 0, 1) }
    state cell(cavity: &Cavity, phase: bool, index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition index >= 0 && index < 16 {
            true -> symbol(cavity, phase, index, bit)
            _ -> done()
        }
    }
    state symbol(cavity: &Cavity, phase: bool, index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition {
            ((cavity.walls & bit) != 0) -> character(cavity, phase, index, bit, 35)
            phase -> phase_cell(cavity, phase, index, bit)
            ((cavity.filled & bit) != 0) -> arrival(cavity, phase, index, bit)
            _ -> character(cavity, phase, index, bit, 46)
        }
    }
    state phase_cell(cavity: &Cavity, phase: bool, index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition {
            ((cavity.filled & bit) != 0) -> character(cavity, phase, index, bit, 82)
            ((cavity.trapped & bit) != 0) -> character(cavity, phase, index, bit, 84)
            _ -> character(cavity, phase, index, bit, 65)
        }
    }
    state character(
        cavity: &Cavity,
        phase: bool,
        index: i32 in Wrapping,
        bit: i32 in Wrapping,
        value: i32
    ) {
        Console::write_byte(value);
        transition { _ -> separator(cavity, phase, index, bit) }
    }
    state arrival(cavity: &Cavity, phase: bool, index: i32 in Wrapping, bit: i32 in Wrapping) {
        decimal(cavity.arrival[index], 10);
        transition { _ -> separator(cavity, phase, index, bit) }
    }
    state separator(cavity: &Cavity, phase: bool, index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition (index & 3) == 3 {
            true -> newline(cavity, phase, index, bit)
            _ -> space(cavity, phase, index, bit)
        }
    }
    state newline(cavity: &Cavity, phase: bool, index: i32 in Wrapping, bit: i32 in Wrapping) {
        Console::write_byte(10);
        transition { _ -> cell(cavity, phase, index + 1, bit << 1) }
    }
    state space(cavity: &Cavity, phase: bool, index: i32 in Wrapping, bit: i32 in Wrapping) {
        Console::write_byte(32);
        transition { _ -> cell(cavity, phase, index + 1, bit << 1) }
    }
    state done() { }
}

machine regions(trapped: i32 in Wrapping) reaches Console {
    transition { _ -> scan(trapped, 0, 1) }
    state scan(rest: i32 in Wrapping, index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition index < 16 && rest != 0 {
            true -> test(rest, index, bit)
            _ -> done()
        }
    }
    state test(rest: i32 in Wrapping, index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition (rest & bit) != 0 {
            true -> region(rest, index, bit)
            _ -> scan(rest, index + 1, bit << 1)
        }
    }
    state region(rest: i32 in Wrapping, index: i32 in Wrapping, bit: i32 in Wrapping) {
        let component: i32 in Wrapping = air_closure(rest, bit);
        decimal(component, 10000);
        Console::write_byte(32);
        decimal(cell_count(component), 10);
        Console::write_byte(10);
        transition { _ -> scan(rest & ~component, index + 1, bit << 1) }
    }
    state done() { }
}

pub machine report(cavity: &Cavity) reaches Console
invokes Console;
{
    Console::write_line("MOLD_FRONT_VENT_V1");
    Console::write_line("arrival ticks (# wall, . unfilled):");
    map(cavity, false);
    Console::write_line("phase (# wall, R resin, T trapped, A vented air):");
    map(cavity, true);
    Console::write_line("trapped regions (mask, cells):");
    regions(cavity.trapped);
    Console::write_line("balance wall resin trapped vented budget unused rounds:");
    decimal(cell_count(cavity.walls), 10);
    Console::write_byte(32);
    decimal(cavity.used, 10);
    Console::write_byte(32);
    decimal(cell_count(cavity.trapped), 10);
    Console::write_byte(32);
    decimal(cell_count(cavity.vented), 10);
    Console::write_byte(32);
    decimal(cavity.budget, 10);
    Console::write_byte(32);
    decimal(cavity.budget - cavity.used, 10);
    Console::write_byte(32);
    decimal(cavity.tick, 10);
    Console::write_byte(10);
    Console::write_line("OK");
}
