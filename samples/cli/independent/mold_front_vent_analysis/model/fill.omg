// Integer cellular model. Four-neighbour air closure and synchronous resin
// batches are distinct: a row-major budget cut never lets new resin advance
// twice in one tick. Trapped air is excluded forever after losing its vent.
pub data Cavity {
    walls: i32 in Wrapping;
    gates: i32 in Wrapping;
    vents: i32 in Wrapping;
    budget: i32 in Wrapping;
    filled: i32 in Wrapping;
    trapped: i32 in Wrapping;
    vented: i32 in Wrapping;
    used: i32 in Wrapping;
    tick: i32 in Wrapping;
    arrival: [i32 in Wrapping; 16];
}

pub machine neighbours(mask: i32 in Wrapping) -> i32 in Wrapping {
    (((mask & 30583) << 1) | ((mask & 61166) >> 1) | (mask << 4) | (mask >> 4)) & 65535
}

// At most fifteen edges join sixteen cells. Sixteen relaxation rounds reach
// every connected cell regardless of the path shape, without a heap or queue.
pub machine air_closure(air: i32 in Wrapping, seeds: i32 in Wrapping) -> i32 in Wrapping {
    transition { _ -> expand(air, seeds & air, 0) }
    state expand(air: i32 in Wrapping, reached: i32 in Wrapping,
                 round: i32 in Wrapping) -> i32 in Wrapping {
        transition round < 16 {
            true -> expand(air, reached | (neighbours(reached) & air), round + 1)
            _ -> (reached)
        }
    }
}

pub machine cell_count(mask: i32 in Wrapping) -> i32 in Wrapping {
    transition { _ -> bit(mask & 65535, 0) }
    state bit(rest: i32 in Wrapping, count: i32 in Wrapping) -> i32 in Wrapping {
        transition rest != 0 {
            true -> bit(rest >> 1, count + (rest & 1))
            _ -> (count)
        }
    }
}

pub machine Cavity::valid(cavity: &Cavity) -> bool {
    cavity.gates != 0 && (cavity.walls & (cavity.gates | cavity.vents)) == 0
        && (cavity.gates & cavity.vents) == 0 && cavity.budget >= cell_count(cavity.gates)
        && cavity.budget >= 0 && cavity.budget <= 16
        && cavity.walls >= 0 && cavity.walls <= 65535
        && cavity.gates >= 0 && cavity.gates <= 65535
        && cavity.vents >= 0 && cavity.vents <= 65535
}

machine Cavity::classify(cavity: &mut Cavity) {
    let air: i32 in Wrapping = 65535 & ~(cavity.walls | cavity.filled | cavity.trapped);
    cavity.vented = air_closure(air, cavity.vents);
    cavity.trapped = cavity.trapped | (air & ~cavity.vented);
}

pub machine Cavity::simulate(cavity: &mut Cavity) {
    cavity.filled = cavity.gates;
    cavity.trapped = 0;
    cavity.vented = 0;
    cavity.used = cell_count(cavity.gates);
    cavity.tick = 0;
    transition { _ -> initialize(cavity, 0, 1) }
    state initialize(cavity: &mut Cavity, index: i32 in Wrapping, bit: i32 in Wrapping) {
        transition index >= 0 && index < 16 {
            true -> initial_cell(cavity, index, bit)
            _ -> round(cavity)
        }
    }
    state initial_cell(cavity: &mut Cavity, index: i32 in Wrapping, bit: i32 in Wrapping) {
        cavity.arrival[index] = 0 - 1;
        transition (cavity.gates & bit) != 0 {
            true -> gate(cavity, index, bit)
            _ -> initialize(cavity, index + 1, bit << 1)
        }
    }
    state gate(cavity: &mut Cavity, index: i32 in Wrapping, bit: i32 in Wrapping) {
        cavity.arrival[index] = 0;
        transition { _ -> initialize(cavity, index + 1, bit << 1) }
    }
    state round(cavity: &mut Cavity) {
        Cavity::classify(cavity);
        let candidates: i32 in Wrapping = neighbours(cavity.filled) & cavity.vented;
        transition cavity.used < cavity.budget && candidates != 0 {
            true -> begin_batch(cavity, candidates)
            _ -> done()
        }
    }
    state begin_batch(cavity: &mut Cavity, candidates: i32 in Wrapping) {
        cavity.tick = cavity.tick + 1;
        transition { _ -> select(cavity, candidates, 0, 1, 0) }
    }
    state select(cavity: &mut Cavity, candidates: i32 in Wrapping,
                 index: i32 in Wrapping, bit: i32 in Wrapping, batch: i32 in Wrapping) {
        transition index >= 0 && index < 16 && cavity.used < cavity.budget {
            true -> candidate(cavity, candidates, index, bit, batch)
            _ -> apply(cavity, batch)
        }
    }
    state candidate(cavity: &mut Cavity, candidates: i32 in Wrapping,
                    index: i32 in Wrapping, bit: i32 in Wrapping, batch: i32 in Wrapping) {
        transition (candidates & bit) != 0 {
            true -> accept(cavity, candidates, index, bit, batch)
            _ -> select(cavity, candidates, index + 1, bit << 1, batch)
        }
    }
    state accept(cavity: &mut Cavity, candidates: i32 in Wrapping,
                 index: i32 in Wrapping, bit: i32 in Wrapping, batch: i32 in Wrapping) {
        cavity.arrival[index] = cavity.tick;
        cavity.used = cavity.used + 1;
        transition { _ -> select(cavity, candidates, index + 1, bit << 1, batch | bit) }
    }
    state apply(cavity: &mut Cavity, batch: i32 in Wrapping) {
        cavity.filled = cavity.filled | batch;
        transition { _ -> round(cavity) }
    }
    state done() { }
}

// This check is a postcondition on reported physical partitions, rather than
// an expected checksum of one fixture. Whole-map byte oracles are external.
pub machine Cavity::balanced(cavity: &Cavity) -> bool {
    let partition: i32 in Wrapping = cavity.walls | cavity.filled | cavity.trapped | cavity.vented;
    let total: i32 in Wrapping = cell_count(cavity.walls) + cell_count(cavity.filled)
        + cell_count(cavity.trapped) + cell_count(cavity.vented);
    partition == 65535 && total == 16 && cell_count(cavity.filled) == cavity.used
        && cavity.used <= cavity.budget && cavity.tick >= 0 && cavity.tick <= 15
}

// One arrival row is four ticks. The gate cell and the other three ticks are
// separate windows. Each returned record publishes that window's length.
// Realizing that returned loan is still refused, so the running report does
// not call these machines; package checking still proves the postconditions.
data HeldTicks<'row> { values: &'row mut [i32 in Wrapping]; }

machine gate_window<'row>(items: &'row mut [i32 in Wrapping; 4]) -> HeldTicks<'row>
ensures result.values.len == 1
{
    HeldTicks { values: &mut items[0..1] }
}

machine rest_window<'row>(items: &'row mut [i32 in Wrapping; 4]) -> HeldTicks<'row>
ensures result.values.len == 3
{
    HeldTicks { values: &mut items[1..4] }
}

// Both halves of the row have length 2. A match publishes that shared length
// on the record field, the same fact a single returned window publishes.
machine half_window<'row>(
    items: &'row mut [i32 in Wrapping; 4],
    which: i32 in Wrapping
) -> HeldTicks<'row>
ensures result.values.len == 2
{
    match which {
        0 -> HeldTicks { values: &mut items[0..2] }
        _ -> HeldTicks { values: &mut items[2..4] }
    }
}

machine write_first(window: &mut [i32 in Wrapping], tick: i32 in Wrapping)
requires window.len >= 1 {
    window[0] = tick;
}

pub machine arrival_row_holds() -> bool {
    let mut row: [i32 in Wrapping; 4] = [1, 2, 3, 4];
    let gate: HeldTicks = gate_window(&mut row);
    let gate_length: u64 = gate.values.len;
    write_first(gate.values, 1);
    let rest: HeldTicks = rest_window(&mut row);
    let rest_length: u64 = rest.values.len;
    write_first(rest.values, 2);
    let half: HeldTicks = half_window(&mut row, 0);
    let half_length: u64 = half.values.len;
    write_first(half.values, 1);
    gate_length == 1 && rest_length == 3 && half_length == 2 && row[0] == 1
        && row[1] == 2 && row[2] == 3 && row[3] == 4
}
