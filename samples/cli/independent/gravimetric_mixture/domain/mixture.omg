use omega_language_std::math;

// Two independent gross measurements and either one reused tare or two
// independent tares. A reused tare contributes positive covariance; discarding
// that covariance overstates fraction uncertainty and understates total uncertainty.
use omega::language::core::float_operations;

public data Mixture [copy] {
    mass_a: f64;
    mass_b: f64;
    total: f64;
    fraction_a: f64;
    fraction_b: f64;
    mass_variance: f64;
    covariance: f64;
    total_variance: f64;
    fraction_variance: f64;
    uncertainty: f64;
    expanded: f64;
    lower: f64;
    upper: f64;
    status: i32;
}

public machine correct(result: &mut Mixture, gross_a: f64, gross_b: f64,
    tare: f64, scale: f64, shared: bool) {
    result.mass_a = (gross_a - tare) * scale;
    result.mass_b = (gross_b - tare) * scale;
    result.total = result.mass_a + result.mass_b;
    result.status = 3;
    transition result.mass_a >= 0.0 && result.mass_b >= 0.0 {
        true -> check_total(result, scale, shared)
        false -> {}
    }
    machine check_total(result: &mut Mixture, scale: f64, shared: bool) {
        result.status = 4;
        transition result.total >= 0.01 {
            true -> propagate(result, scale, shared)
            false -> {}
        }
    }
    machine propagate(result: &mut Mixture, scale: f64, shared: bool) {
        // Declared standard uncertainties: gross 0.1 and tare 0.2 input units.
        // For f=A/(A+B), derivatives are B/T^2 and -A/T^2.
        let gross_variance: f64 = 0.01 * scale * scale;
        let tare_variance: f64 = 0.04 * scale * scale;
        result.mass_variance = gross_variance + tare_variance;
        transition shared {
            true -> common(result, tare_variance)
            false -> independent(result)
        }
    }
    machine common(result: &mut Mixture, tare_variance: f64) {
        result.covariance = tare_variance;
        transition { _ -> compose(result) }
    }
    machine independent(result: &mut Mixture) {
        result.covariance = 0.0;
        transition { _ -> compose(result) }
    }
    machine compose(result: &mut Mixture) {
        result.total_variance = 2.0 * result.mass_variance + 2.0 * result.covariance;
        result.fraction_a = result.mass_a / result.total;
        result.fraction_b = result.mass_b / result.total;
        let total_squared: f64 = result.total * result.total;
        let numerator: f64 = (result.mass_b * result.mass_b + result.mass_a * result.mass_a)
            * result.mass_variance - 2.0 * result.mass_a * result.mass_b * result.covariance;
        result.fraction_variance = numerator / (total_squared * total_squared);
        result.uncertainty = sqrt_f64(result.fraction_variance);
        result.expanded = 2.0 * result.uncertainty;
        result.lower = result.fraction_a - result.expanded;
        result.upper = result.fraction_a + result.expanded;
        // Entire k=2 interval must lie in 1/3 +/- 0.04. This is a declared
        // first-order standard uncertainty model, not a confidence guarantee.
        result.status = 1;
        transition result.lower >= (1.0 / 3.0 - 0.04) && result.upper <= (1.0 / 3.0 + 0.04) {
            true -> accept(result)
            false -> {}
        }
    }
    machine accept(result: &mut Mixture) { result.status = 0; }
}
