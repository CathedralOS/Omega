// Complete intended-invalid control: a correction declared nonnegative
// receives a negative exact integer mass. Rejection must name the obligation.
use omega_language_std::console;
domain i32::Nonnegative(value) requires value >= 0;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let corrected: i32 in Nonnegative = 0 - 1;
    Console::exit_process(corrected);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
