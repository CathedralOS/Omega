// Runtime input: g003g005g0011 LF (three 3-digit readings, units, model).
// Empty stdin is a malformed record; nominal.txt has authored exit 0.
// Expected exit: 2.
// Expected output contains: INVALID: record
use omega_language_std::console;
use omega::language::core::float_operations;
use domain::mixture;

data Main {
    input: [u8; 15];
    result: Mixture;
}

machine reading(hundreds: u8, tens: u8, ones: u8) -> f64 {
    ((hundreds as f64) - 48.0) * 100.0 + ((tens as f64) - 48.0) * 10.0 + ((ones as f64) - 48.0)
}

// Saturating conversion is intentional display quantization. The oracle checks
// the emitted numbers separately, within one displayed unit; no expected values
// are embedded in the application. Ten digits cover all nonnegative i32 values.
machine emit_positive(main: &mut Main, value: f64) reaches Console {
    let rounded: i32 in Saturating = I32::from_f64(value + 0.5);
    let integer: i32 = rounded as i32;
    Console::write_byte(integer / 1000000000 % 10 + 48);
    Console::write_byte(integer / 100000000 % 10 + 48);
    Console::write_byte(integer / 10000000 % 10 + 48);
    Console::write_byte(integer / 1000000 % 10 + 48);
    Console::write_byte(integer / 100000 % 10 + 48);
    Console::write_byte(integer / 10000 % 10 + 48);
    Console::write_byte(integer / 1000 % 10 + 48);
    Console::write_byte(integer / 100 % 10 + 48);
    Console::write_byte(integer / 10 % 10 + 48);
    Console::write_byte(integer / 1 % 10 + 48);
    Console::write_byte(10);
}

machine emit(main: &mut Main, value: f64) reaches Console {
    transition value < 0.0 {
        true -> negative(main, value)
        false -> positive(main, value)
    }
    state negative(main: &mut Main, value: f64) {
        Console::write_byte(45);
        emit_positive(main, 0.0 - value);
    }
    state positive(main: &mut Main, value: f64) { emit_positive(main, value); }
}

machine Main::main(main: &mut Main) reaches Console {
    let observed: LineReadResult = block Console::read_line(&mut main.input);
    transition observed {
        LineReadResult::LineComplete { count } -> length(main, count)
        _ -> malformed(main)
    }
    state length(main: &mut Main, count: u64) {
        transition count == 14 && main.input[13] == 10 {
            true -> units(main)
            false -> malformed(main)
        }
    }
    state units(main: &mut Main) {
        transition main.input[0] == main.input[4] && main.input[0] == main.input[8] {
            true -> unit_kind(main)
            false -> bad_units(main)
        }
    }
    state unit_kind(main: &mut Main) {
        transition main.input[0] == 103 || main.input[0] == 109 {
            true -> digits(main)
            false -> bad_units(main)
        }
    }
    state digits(main: &mut Main) {
        transition main.input[1] >= 48 && main.input[1] <= 57 && main.input[2] >= 48 && main.input[2] <= 57 && main.input[3] >= 48 && main.input[3] <= 57 && main.input[5] >= 48 && main.input[5] <= 57 && main.input[6] >= 48 && main.input[6] <= 57 && main.input[7] >= 48 && main.input[7] <= 57 && main.input[9] >= 48 && main.input[9] <= 57 && main.input[10] >= 48 && main.input[10] <= 57 && main.input[11] >= 48 && main.input[11] <= 57 {
            true -> model(main)
            false -> malformed(main)
        }
    }
    state model(main: &mut Main) {
        transition main.input[12] == 49 || main.input[12] == 50 {
            true -> scale(main)
            false -> bad_model(main)
        }
    }
    state scale(main: &mut Main) {
        transition main.input[0] == 103 {
            true -> calculate(main, 1.0)
            false -> calculate(main, 0.001)
        }
    }
    state calculate(main: &mut Main, scale: f64) {
        correct(&mut main.result, reading(main.input[1], main.input[2], main.input[3]),
            reading(main.input[5], main.input[6], main.input[7]),
            reading(main.input[9], main.input[10], main.input[11]), scale, main.input[12] == 49);
        transition main.result.status {
            3 -> negative(main)
            4 -> near_zero(main)
            _ -> report(main)
        }
    }
    state report(main: &mut Main) {
        Console::write_line("model: first_order k=2; mass=ug variance=1e-9_g2; fractions=ppm variance=nano");
        let mass_a_ug: f64 = main.result.mass_a * 1000000.0;
        Console::write("mass_a_ug="); emit(main, mass_a_ug);
        let mass_b_ug: f64 = main.result.mass_b * 1000000.0;
        Console::write("mass_b_ug="); emit(main, mass_b_ug);
        let total_ug: f64 = main.result.total * 1000000.0;
        Console::write("total_ug="); emit(main, total_ug);
        let mass_variance_nano_g2: f64 = main.result.mass_variance * 1000000000.0;
        Console::write("mass_variance_nano_g2="); emit(main, mass_variance_nano_g2);
        let covariance_nano_g2: f64 = main.result.covariance * 1000000000.0;
        Console::write("covariance_nano_g2="); emit(main, covariance_nano_g2);
        let total_variance_nano_g2: f64 = main.result.total_variance * 1000000000.0;
        Console::write("total_variance_nano_g2="); emit(main, total_variance_nano_g2);
        let fraction_a_ppm: f64 = main.result.fraction_a * 1000000.0;
        Console::write("fraction_a_ppm="); emit(main, fraction_a_ppm);
        let fraction_b_ppm: f64 = main.result.fraction_b * 1000000.0;
        Console::write("fraction_b_ppm="); emit(main, fraction_b_ppm);
        let fraction_variance_nano: f64 = main.result.fraction_variance * 1000000000.0;
        Console::write("fraction_variance_nano="); emit(main, fraction_variance_nano);
        let standard_uncertainty_ppm: f64 = main.result.uncertainty * 1000000.0;
        Console::write("standard_uncertainty_ppm="); emit(main, standard_uncertainty_ppm);
        let expanded_uncertainty_ppm: f64 = main.result.expanded * 1000000.0;
        Console::write("expanded_uncertainty_ppm="); emit(main, expanded_uncertainty_ppm);
        let interval_lower_ppm: f64 = main.result.lower * 1000000.0;
        Console::write("interval_lower_ppm="); emit(main, interval_lower_ppm);
        let interval_upper_ppm: f64 = main.result.upper * 1000000.0;
        Console::write("interval_upper_ppm="); emit(main, interval_upper_ppm);
        transition main.result.status == 0 {
            true -> accepted(main)
            false -> rejected(main)
        }
    }
    state accepted(main: &mut Main) { Console::write_line("ACCEPT"); Console::exit_process(0); }
    state rejected(main: &mut Main) { Console::write_line("REJECT: guard_band"); Console::exit_process(1); }
    state malformed(main: &mut Main) { Console::write_line("INVALID: record"); Console::exit_process(2); }
    state negative(main: &mut Main) { Console::write_line("INVALID: negative_corrected_mass"); Console::exit_process(3); }
    state near_zero(main: &mut Main) { Console::write_line("INVALID: total_below_0.01_g"); Console::exit_process(4); }
    state bad_units(main: &mut Main) { Console::write_line("INVALID: inconsistent_or_unknown_units"); Console::exit_process(5); }
    state bad_model(main: &mut Main) { Console::write_line("INVALID: uncertainty_model"); Console::exit_process(6); }
}
