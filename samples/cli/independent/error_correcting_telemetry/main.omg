// Expected exit: 0
// Empty input exits normally; frozen nonempty streams and status-3 limits are in data/.
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use codec::field;
use codec::decoder;

data Main { input: [u8; 8]; }
// Protocol: Eab LF or Dabcd LF. Digits 0..4 are F5 symbols; '_' is an erasure.
// One bounded line is consumed per record, at most 2000 records. Oversized
// lines stop with status 3 rather than interpreting their tail as a new frame.
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> next(main, 0) }
    state next(main: &mut Main, records: i32) {
        transition records < 2000 {
            true -> read(main, records)
            false -> limit(main)
        }
    }
    state read(main: &mut Main, records: i32)
    requires records >= 0 && records < 2000
    {
        let observed: LineReadResult = block Console::read_line(&mut main.input);
        transition observed {
            LineReadResult::LineComplete { count } -> dispatch(main, records + 1, count)
            LineReadResult::EndOfInput { count } -> end(main, count)
            _ -> limit(main)
        }
    }
    state dispatch(main: &mut Main, records: i32, count: u64) {
        transition {
            count == 4 && main.input[0] == 69 && main.input[3] == 10 -> encoding(main, records)
            count == 6 && main.input[0] == 68 && main.input[5] == 10 -> decoding(main, records)
            _ -> malformed(main, records)
        }
    }
    state encoding(main: &mut Main, records: i32) {
        let first: i32 in Wrapping = symbol(main.input[1]);
        let second: i32 in Wrapping = symbol(main.input[2]);
        transition first < 5 && second < 5 {
            true -> encoded(main, records, encode(first, second))
            false -> malformed(main, records)
        }
    }
    state encoded(main: &mut Main, records: i32, frame: Frame) {
        Console::write("C ");
        digit(main, frame.first); digit(main, frame.second); digit(main, frame.third); digit(main, frame.fourth);
        Console::write_line("");
        transition { _ -> next(main, records) }
    }
    state decoding(main: &mut Main, records: i32) {
        let frame: Frame = Frame { first: symbol(main.input[1]), second: symbol(main.input[2]),
            third: symbol(main.input[3]), fourth: symbol(main.input[4]) };
        transition frame.first <= 5 && frame.second <= 5 && frame.third <= 5 && frame.fourth <= 5 {
            true -> recovering(main, records, frame)
            false -> malformed(main, records)
        }
    }
    state recovering(main: &mut Main, records: i32, frame: Frame) {
        let result: Recovery = recover(&frame);
        transition { _ -> decoded(main, records, frame, result) }
    }
    state decoded(main: &mut Main, records: i32, frame: Frame, result: Recovery) {
        transition result.matches == 1 {
            true -> recovered(main, records, frame, result)
            false -> unrecoverable(main, records, frame)
        }
    }
    state recovered(main: &mut Main, records: i32, frame: Frame, result: Recovery) {
        let code: Frame = encode(result.intercept, result.slope);
        Console::write("R "); digit(main, result.intercept); digit(main, result.slope);
        Console::write(" L ");
        digit(main, location(frame.first, code.first)); digit(main, location(frame.second, code.second));
        digit(main, location(frame.third, code.third)); digit(main, location(frame.fourth, code.fourth));
        syndromes(main, &frame);
        transition { _ -> next(main, records) }
    }
    state unrecoverable(main: &mut Main, records: i32, frame: Frame) {
        Console::write("U"); syndromes(main, &frame);
        transition { _ -> next(main, records) }
    }
    state malformed(main: &mut Main, records: i32) {
        Console::write_line("M");
        transition { _ -> next(main, records) }
    }
    state end(main: &mut Main, count: u64) {
        transition count == 0 { true -> done(main) false -> truncated(main) }
    }
    state truncated(main: &mut Main) { Console::write_line("M"); Console::exit_process(0); }
    state done(main: &mut Main) { Console::exit_process(0); }
    state limit(main: &mut Main) { Console::write_line("LIMIT"); Console::exit_process(3); }
}
machine symbol(byte: u8) -> i32 in Wrapping {
    transition { byte >= 48 && byte <= 52 -> ((widen_u8_to_i32(byte) as i32 in Wrapping) - 48)
        byte == 95 -> 5 _ -> 6 }
}
machine digit(main: &mut Main, value: i32 in Wrapping) reaches Console {
    Console::write_byte((value + 48) as i32);
}
machine syndromes(main: &mut Main, frame: &Frame) reaches Console {
    Console::write(" S "); digit(main, syndrome_first(frame)); digit(main, syndrome_second(frame));
    Console::write_line("");
}
