// Synthetic RS(4,2) over F5, evaluations at x=0,1,2,3.
// Wrapping arithmetic is private scratch; values are reduced after every
// bounded operation. It is never used to justify indexing or input validity.
public data Frame { first: i32 in Wrapping; second: i32 in Wrapping; third: i32 in Wrapping; fourth: i32 in Wrapping; }
public machine encode(intercept: i32 in Wrapping, slope: i32 in Wrapping) -> Frame {
    Frame { first: intercept % 5, second: (intercept + slope) % 5,
        third: (intercept + 2 * slope) % 5, fourth: (intercept + 3 * slope) % 5 }
}
public machine discrepancy(received: i32 in Wrapping, encoded: i32 in Wrapping) -> i32 in Wrapping {
    transition { received == 5 -> 1 received != encoded -> 2 _ -> 0 }
}
public machine location(received: i32 in Wrapping, encoded: i32 in Wrapping) -> i32 in Wrapping {
    transition { received == 5 -> 1 received != encoded -> 1 _ -> 0 }
}
public machine syndrome_first(frame: &Frame) -> i32 in Wrapping {
    (frame.first + 3 * frame.second + frame.third) % 5
}
public machine syndrome_second(frame: &Frame) -> i32 in Wrapping {
    (frame.second + 3 * frame.third + frame.fourth) % 5
}
