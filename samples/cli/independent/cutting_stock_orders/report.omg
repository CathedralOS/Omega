module report;
use model;
use omega_language_std::console;
// Four decimal digits per integer. Inputs bound every reported sum below 10000.
machine number(value: i32 in Wrapping) reaches Console {
    Console::write_byte((value / 1000 % 10 + 48) as i32);
    Console::write_byte((value / 100 % 10 + 48) as i32);
    Console::write_byte((value / 10 % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
    Console::write_byte(32);
}
pub machine emit(orders: &model::Orders, plan: &model::Plan) -> bool reaches Console
invokes Console;
{
    Console::write("summary ");
    number(plan.fulfilled);
    number(plan.useful);
    number(plan.fresh);
    number(plan.opened);
    number(plan.ties);
    number(plan.code);
    Console::write_byte(10);
    transition { _ -> item(orders, plan, 0, plan.code) }
    state item(orders: &model::Orders, plan: &model::Plan,
                index: i32 in Wrapping, code: i32 in Wrapping) -> bool {
        let order_index: i32 in Wrapping = index + 3;
        transition index >= 0 && index < 4 && order_index >= 3 && order_index < 7 {
            true -> row(orders, plan, index, code, order_index)
            _ -> stock(orders, plan, 0, 0, 0, 0)
        }
    }
    state row(orders: &model::Orders, plan: &model::Plan,
               index: i32 in Wrapping, code: i32 in Wrapping, order_index: i32 in Wrapping) -> bool {
        Console::write("order ");
        number(index);
        number(orders.values[order_index]);
        number(code % 4);
        Console::write_byte(10);
        transition { _ -> item(orders, plan, index + 1, code / 4) }
    }
    state stock(orders: &model::Orders, plan: &model::Plan,
                 source: i32 in Wrapping, kerf: i32 in Wrapping,
                 reusable: i32 in Wrapping, scrap: i32 in Wrapping) -> bool {
        transition source >= 0 && source < 3 {
            true -> capacity(orders, plan, source, kerf, reusable, scrap)
            _ -> certificate(plan, kerf, reusable, scrap)
        }
    }
    state capacity(orders: &model::Orders, plan: &model::Plan,
                    source: i32 in Wrapping, kerf: i32 in Wrapping,
                    reusable: i32 in Wrapping, scrap: i32 in Wrapping) -> bool {
        transition source == 2 {
            true -> pattern(orders, plan, source, orders.values[1], kerf, reusable, scrap)
            _ -> pattern(orders, plan, source, orders.values[0], kerf, reusable, scrap)
        }
    }
    state pattern(orders: &model::Orders, plan: &model::Plan,
                   source: i32 in Wrapping, capacity: i32 in Wrapping, kerf: i32 in Wrapping,
                   reusable: i32 in Wrapping, scrap: i32 in Wrapping) -> bool {
        let loss: i32 in Wrapping = plan.counts[source] * orders.values[2];
        Console::write("stock ");
        number(source);
        number(capacity);
        number(plan.counts[source]);
        number(plan.loads[source] - loss);
        number(loss);
        transition plan.counts[source] > 0 {
            true -> leftover(orders, plan, source, capacity - plan.loads[source], kerf + loss, reusable, scrap)
            _ -> leftover(orders, plan, source, 0, kerf, reusable, scrap)
        }
    }
    state leftover(orders: &model::Orders, plan: &model::Plan,
                    source: i32 in Wrapping, remaining: i32 in Wrapping, kerf: i32 in Wrapping,
                    reusable: i32 in Wrapping, scrap: i32 in Wrapping) -> bool {
        number(remaining);
        Console::write_byte(10);
        transition remaining >= 5 {
            true -> stock(orders, plan, source + 1, kerf, reusable + remaining, scrap)
            _ -> stock(orders, plan, source + 1, kerf, reusable, scrap + remaining)
        }
    }
    state certificate(plan: &model::Plan, kerf: i32 in Wrapping,
                       reusable: i32 in Wrapping, scrap: i32 in Wrapping) -> bool {
        Console::write("certificate ");
        number(plan.opened);
        number(plan.useful);
        number(kerf);
        number(reusable);
        number(scrap);
        Console::write_byte(10);
        plan.opened == plan.useful + kerf + reusable + scrap
    }
}
