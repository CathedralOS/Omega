// Complete intended-invalid control: a cut requires sufficient material.
// It must reject the disproved call requirement, not entry/provider setup.
data Stock { remaining: i32; }
machine cut(stock: &mut Stock, length: i32)
requires length > 0 && stock.remaining >= length
{ stock.remaining = stock.remaining - length; }
machine control() {
    let mut stock: Stock;
    stock.remaining = 4;
    cut(&mut stock, 5);
}
