module planner;
use model;
// All 4^4 choices are exhausted: 0/1 fresh bars, 2 remnant, 3 unfulfilled.
// Objective: maximum count, maximum useful length, minimum fresh bars,
// minimum opened material. Ascending code is the deterministic tie break.
public machine solve(orders: &model::Orders, best: &mut model::Plan) {
    best.code = 255;
    best.fulfilled = -1;
    best.useful = 0;
    best.fresh = 0;
    best.opened = 0;
    best.ties = 0;
    best.loads = [0,0,0];
    best.counts = [0,0,0];
    transition { _ -> candidate(orders, best, 0) }
    machine candidate(orders: &model::Orders, best: &mut model::Plan, code: i32 in Wrapping) {
        transition code < 256 {
            true -> evaluate(orders, best, code)
            _ -> finished()
        }
    }
    machine evaluate(orders: &model::Orders, best: &mut model::Plan, code: i32 in Wrapping) {
        let mut trial: model::Plan;
        trial.code = code;
        trial.fulfilled = 0;
        trial.useful = 0;
        trial.fresh = 0;
        trial.opened = 0;
        trial.ties = 1;
        trial.loads = [0,0,0];
        trial.counts = [0,0,0];
        let feasible: bool = fill(orders, &mut trial, code, 0);
        transition feasible {
            true -> compare(orders, best, code, &trial)
            _ -> candidate(orders, best, code + 1)
        }
    }
    machine compare(orders: &model::Orders, best: &mut model::Plan, code: i32 in Wrapping, trial: &model::Plan) {
        transition trial.fulfilled > best.fulfilled ||
            (trial.fulfilled == best.fulfilled && trial.useful > best.useful) ||
            (trial.fulfilled == best.fulfilled && trial.useful == best.useful && trial.fresh < best.fresh) ||
            (trial.fulfilled == best.fulfilled && trial.useful == best.useful && trial.fresh == best.fresh && trial.opened < best.opened) {
            true -> replace(orders, best, code, trial)
            _ -> equal(orders, best, code, trial)
        }
    }
    machine replace(orders: &model::Orders, best: &mut model::Plan, code: i32 in Wrapping, trial: &model::Plan) {
        best.code = trial.code;
        best.fulfilled = trial.fulfilled;
        best.useful = trial.useful;
        best.fresh = trial.fresh;
        best.opened = trial.opened;
        best.ties = 1;
        best.loads = trial.loads;
        best.counts = trial.counts;
        transition { _ -> candidate(orders, best, code + 1) }
    }
    machine equal(orders: &model::Orders, best: &mut model::Plan, code: i32 in Wrapping, trial: &model::Plan) {
        transition trial.fulfilled == best.fulfilled && trial.useful == best.useful && trial.fresh == best.fresh && trial.opened == best.opened {
            true -> tied(orders, best, code)
            _ -> candidate(orders, best, code + 1)
        }
    }
    machine finished() {}
    machine tied(orders: &model::Orders, best: &mut model::Plan, code: i32 in Wrapping) {
        best.ties = best.ties + 1;
        transition { _ -> candidate(orders, best, code + 1) }
    }
}

machine fill(orders: &model::Orders, trial: &mut model::Plan, remaining: i32 in Wrapping, item: i32 in Wrapping) -> bool {
    transition item >= 0 && item < 4 {
        true -> choose(orders, trial, remaining, item)
        _ -> stocks(orders, trial, 0)
    }
    machine choose(orders: &model::Orders, trial: &mut model::Plan, remaining: i32 in Wrapping, item: i32 in Wrapping) -> bool {
        let source: i32 in Wrapping = remaining % 4;
        transition source >= 0 && source < 3 && item >= 0 && item < 4 {
            true -> cut(orders, trial, remaining, item, source)
            _ -> fill(orders, trial, remaining / 4, item + 1)
        }
    }
    machine cut(orders: &model::Orders, trial: &mut model::Plan, remaining: i32 in Wrapping,
               item: i32 in Wrapping, source: i32 in Wrapping) -> bool {
        let order_index: i32 in Wrapping = item + 3;
        transition order_index >= 3 && order_index < 7 {
            true -> add(orders, trial, remaining, item, source, order_index)
            _ -> false
        }
    }
    machine add(orders: &model::Orders, trial: &mut model::Plan, remaining: i32 in Wrapping,
               item: i32 in Wrapping, source: i32 in Wrapping, order_index: i32 in Wrapping) -> bool {
        trial.loads[source] = trial.loads[source] + orders.values[order_index] + orders.values[2];
        trial.counts[source] = trial.counts[source] + 1;
        trial.fulfilled = trial.fulfilled + 1;
        trial.useful = trial.useful + orders.values[order_index];
        transition { _ -> fill(orders, trial, remaining / 4, item + 1) }
    }
}

machine stocks(orders: &model::Orders, trial: &mut model::Plan, source: i32 in Wrapping) -> bool {
    transition source >= 0 && source < 3 {
        true -> length(orders, trial, source)
        _ -> true
    }
    machine length(orders: &model::Orders, trial: &mut model::Plan, source: i32 in Wrapping) -> bool {
        transition source == 2 {
            true -> fits(orders, trial, source, orders.values[1])
            _ -> fits(orders, trial, source, orders.values[0])
        }
    }
    machine fits(orders: &model::Orders, trial: &mut model::Plan, source: i32 in Wrapping, capacity: i32 in Wrapping) -> bool {
        transition trial.loads[source] <= capacity {
            true -> used(orders, trial, source, capacity)
            _ -> false
        }
    }
    machine used(orders: &model::Orders, trial: &mut model::Plan, source: i32 in Wrapping, capacity: i32 in Wrapping) -> bool {
        transition trial.counts[source] > 0 {
            true -> opened(orders, trial, source, capacity)
            _ -> stocks(orders, trial, source + 1)
        }
    }
    machine opened(orders: &model::Orders, trial: &mut model::Plan, source: i32 in Wrapping, capacity: i32 in Wrapping) -> bool {
        trial.opened = trial.opened + capacity;
        transition source < 2 {
            true -> fresh(orders, trial, source)
            _ -> stocks(orders, trial, source + 1)
        }
    }
    machine fresh(orders: &model::Orders, trial: &mut model::Plan, source: i32 in Wrapping) -> bool {
        trial.fresh = trial.fresh + 1;
        transition { _ -> stocks(orders, trial, source + 1) }
    }
}
