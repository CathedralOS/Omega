// NEW071: exhaustive bounded manufacturing cut planner. All data is synthetic.
use omega_language_std::console;
use model;
use input;
use planner;
use report;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut bytes: [u8; 32];
    let observed: LineReadResult = block Console::read_line(&mut bytes);
    transition observed {
        LineReadResult::LineComplete { count } -> line(main, &bytes, count)
        LineReadResult::EndOfInput { count } -> eof(main, &bytes, count)
        _ -> invalid(main)
    }
    state line(main: &mut Main, bytes: &[u8; 32], count: u64) {
        transition count == 26 && bytes[25] == 10 {
            true -> parse_orders(main, bytes)
            _ -> invalid(main)
        }
    }
    state eof(main: &mut Main, bytes: &[u8; 32], count: u64) {
        transition count == 25 {
            true -> parse_orders(main, bytes)
            _ -> invalid(main)
        }
    }
    state parse_orders(main: &mut Main, bytes: &[u8; 32]) {
        let mut orders: model::Orders;
        let valid: bool = input::parse(bytes, &mut orders);
        transition valid {
            true -> plan(main, &orders)
            _ -> invalid(main)
        }
    }
    state plan(main: &mut Main, orders: &model::Orders) {
        let mut best: model::Plan;
        planner::solve(orders, &mut best);
        let conserved: bool = report::emit(orders, &best);
        transition conserved {
            true -> done(main)
            _ -> internal(main)
        }
    }
    state done(main: &mut Main) { Console::exit_process(0); }
    state internal(main: &mut Main) {
        Console::write_line("INTERNAL: conservation certificate failed");
        Console::exit_process(70);
    }
    state invalid(main: &mut Main) {
        Console::write_line("INVALID: expected SSS RRR K LLL LLL LLL LLL; stock and orders must be positive");
        Console::exit_process(64);
    }
}
