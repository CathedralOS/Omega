// Complete independent control: an unguarded index into the private observation
// table must reject. This does not depend on the application's parser.
use omega_language_std::console;
use omega::language::core::numeric_conversion;

machine unsafe_range(values: &[i32; 3], index: u64) -> i32 { values[index] }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let values: [i32; 3] = [3, 4, 5];
    let result: i32 = unsafe_range(&values, 1);
    Console::exit_process(result);
}
