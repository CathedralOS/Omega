// Expected exit: 0.
// Expected output contains: status unique
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use geometry::model;
use input::parser;
use output::report;
use omega::language::core::binding;

// Search every integer point in the supplied closed window. Each candidate
// includes three signed squared-range residuals relative to the lower bound.
// These are squared-distance units, not radial error. Search is deterministic,
// ordered by y then x, and retains no candidate storage or hidden truncation.
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut bytes: [u8; 128];
    let mut problem: Problem;
    let observed: LineReadResult = block Console::read_line(&main.console, &mut bytes);
    transition observed {
        LineReadResult::EndOfInput { count } -> input(&main.console, &bytes, count, &mut problem)
        LineReadResult::LineComplete { count } -> input(&main.console, &bytes, count, &mut problem)
        _ -> invalid(&main.console)
    }
    state input(console: &Binding<Console>, bytes: &[u8], count: u64, problem: &mut Problem) {
        transition count <= bytes.len {
            true -> admitted(console, bytes, count, problem)
            false -> invalid(console)
        }
    }
    state admitted(console: &Binding<Console>, bytes: &[u8], count: u64, problem: &mut Problem)
    requires count <= bytes.len
    {
        transition count == 0 {
            true -> demo(console, problem)
            false -> decode(console, bytes[..count], problem)
        }
    }
    state demo(console: &Binding<Console>, problem: &mut Problem) {
        // Three exact circles through (3,4): radii 5,5,3.
        problem.values[0] = -8; problem.values[1] = 8;
        problem.values[2] = -8; problem.values[3] = 8;
        problem.values[4] = 3;
        problem.values[5] = 0; problem.values[6] = 0;
        problem.values[7] = 5; problem.values[8] = 5;
        problem.values[9] = 6; problem.values[10] = 0;
        problem.values[11] = 5; problem.values[12] = 5;
        problem.values[13] = 3; problem.values[14] = 1;
        problem.values[15] = 3; problem.values[16] = 3;
        transition { _ -> search(console, problem, problem.values[0], problem.values[2], 0) }
    }
    state decode(console: &Binding<Console>, bytes: &[u8], problem: &mut Problem) {
        let parsed: bool = parse(bytes, problem);
        transition parsed {
            true -> validate(console, problem)
            false -> invalid(console)
        }
    }
    state validate(console: &Binding<Console>, problem: &Problem) {
        transition valid(problem) {
            true -> search(console, problem, problem.values[0], problem.values[2], 0)
            false -> invalid(console)
        }
    }
    state search(console: &Binding<Console>, problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        transition feasible(problem, x, y) {
            true -> candidate(console, problem, x, y, count)
            false -> advance(console, problem, x, y, count)
        }
    }
    state candidate(console: &Binding<Console>, problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        Console::write(console, "candidate "); number(console, x); Console::write(console, " "); number(console, y);
        Console::write(console, " residual2");
        residuals(console, problem, x, y, 0);
        Console::write_line(console, "");
        transition { _ -> advance(console, problem, x, y, count + 1) }
    }
    state advance(console: &Binding<Console>, problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        transition {
            x < problem.values[1] -> search(console, problem, x + 1, y, count)
            y < problem.values[3] -> search(console, problem, problem.values[0], y + 1, count)
            _ -> summary(console, problem, count)
        }
    }
    state summary(console: &Binding<Console>, problem: &Problem, count: i32 in Wrapping) {
        Console::write(console, "count "); number(console, count); Console::write_line(console, "");
        transition {
            count == 0 -> inconsistent(console)
            degenerate(problem) -> degenerate_result(console)
            count == 1 -> unique(console)
            _ -> ambiguous(console)
        }
    }
    state inconsistent(console: &Binding<Console>) { Console::write_line(console, "status inconsistent"); Console::exit_process(console, 0); }
    state degenerate_result(console: &Binding<Console>) { Console::write_line(console, "status degenerate"); Console::exit_process(console, 0); }
    state unique(console: &Binding<Console>) { Console::write_line(console, "status unique"); Console::exit_process(console, 0); }
    state ambiguous(console: &Binding<Console>) { Console::write_line(console, "status ambiguous"); Console::exit_process(console, 0); }
    state invalid(console: &Binding<Console>) { Console::write_line(console, "error invalid input"); Console::exit_process(console, 64); }
}

machine residuals(console: &Binding<Console>, problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64)
reaches Console {
    transition index < 3 {
        true -> emit(console, problem, x, y, index)
        false -> done()
    }
    state emit(console: &Binding<Console>, problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64)
    requires index < 3
    {
        let offset: u64 = 5 + index * 4;
        let lower: i32 in Wrapping = problem.values[offset + 2];
        let residual: i32 in Wrapping = distance_squared(x, y, problem.values[offset], problem.values[offset + 1]) - lower * lower;
        Console::write(console, " "); number(console, residual);
        transition { _ -> residuals(console, problem, x, y, index + 1) }
    }
    state done() { }
}
