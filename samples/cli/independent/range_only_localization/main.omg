// Expected exit: 0.
// Expected output contains: status unique
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use geometry::model;
use input::parser;
use output::report;

// Search every integer point in the supplied closed window. Each candidate
// includes three signed squared-range residuals relative to the lower bound.
// These are squared-distance units, not radial error. Search is deterministic,
// ordered by y then x, and retains no candidate storage or hidden truncation.
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut bytes: [u8; 128];
    let mut problem: Problem;
    let observed: LineReadResult = block Console::read_line(&mut bytes);
    transition observed {
        LineReadResult::EndOfInput { count } -> input(&bytes, count, &mut problem)
        LineReadResult::LineComplete { count } -> input(&bytes, count, &mut problem)
        _ -> invalid()
    }
    state input(bytes: &[u8], count: u64, problem: &mut Problem) {
        transition count <= bytes.len {
            true -> admitted(bytes, count, problem)
            false -> invalid()
        }
    }
    state admitted(bytes: &[u8], count: u64, problem: &mut Problem)
    requires count <= bytes.len
    {
        transition count == 0 {
            true -> demo(problem)
            false -> decode(bytes[..count], problem)
        }
    }
    state demo(problem: &mut Problem) {
        // Three exact circles through (3,4): radii 5,5,3.
        problem.values[0] = -8; problem.values[1] = 8;
        problem.values[2] = -8; problem.values[3] = 8;
        problem.values[4] = 3;
        problem.values[5] = 0; problem.values[6] = 0;
        problem.values[7] = 5; problem.values[8] = 5;
        problem.values[9] = 6; problem.values[10] = 0;
        problem.values[11] = 5; problem.values[12] = 5;
        problem.values[13] = 3; problem.values[14] = 1;
        problem.values[15] = 3; problem.values[16] = 3;
        transition { _ -> search(problem, problem.values[0], problem.values[2], 0) }
    }
    state decode(bytes: &[u8], problem: &mut Problem) {
        let parsed: bool = parse(bytes, problem);
        transition parsed {
            true -> validate(problem)
            false -> invalid()
        }
    }
    state validate(problem: &Problem) {
        transition valid(problem) {
            true -> search(problem, problem.values[0], problem.values[2], 0)
            false -> invalid()
        }
    }
    state search(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        transition feasible(problem, x, y) {
            true -> candidate(problem, x, y, count)
            false -> advance(problem, x, y, count)
        }
    }
    state candidate(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        Console::write("candidate "); number(x); Console::write(" "); number(y);
        Console::write(" residual2");
        residuals(problem, x, y, 0);
        Console::write_line("");
        transition { _ -> advance(problem, x, y, count + 1) }
    }
    state advance(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, count: i32 in Wrapping) {
        transition {
            x < problem.values[1] -> search(problem, x + 1, y, count)
            y < problem.values[3] -> search(problem, problem.values[0], y + 1, count)
            _ -> summary(problem, count)
        }
    }
    state summary(problem: &Problem, count: i32 in Wrapping) {
        Console::write("count "); number(count); Console::write_line("");
        transition {
            count == 0 -> inconsistent()
            degenerate(problem) -> degenerate_result()
            count == 1 -> unique()
            _ -> ambiguous()
        }
    }
    state inconsistent() { Console::write_line("status inconsistent"); Console::exit_process(0); }
    state degenerate_result() { Console::write_line("status degenerate"); Console::exit_process(0); }
    state unique() { Console::write_line("status unique"); Console::exit_process(0); }
    state ambiguous() { Console::write_line("status ambiguous"); Console::exit_process(0); }
    state invalid() { Console::write_line("error invalid input"); Console::exit_process(64); }
}

machine residuals(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64)
reaches Console {
    transition index < 3 {
        true -> emit(problem, x, y, index)
        false -> done()
    }
    state emit(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64)
    requires index < 3
    {
        let offset: u64 = 5 + index * 4;
        let lower: i32 in Wrapping = problem.values[offset + 2];
        let residual: i32 in Wrapping = distance_squared(x, y, problem.values[offset], problem.values[offset + 1]) - lower * lower;
        Console::write(" "); number(residual);
        transition { _ -> residuals(problem, x, y, index + 1) }
    }
    state done() { }
}
