// Private lattice geometry. Inputs are validated before any products; the
// wrapping arithmetic domain is explicit and the application bounds guarantee
// every actual product is small (squared distances <= 3200).
use omega::language::core::numeric_conversion;

public data Problem {
    values: [i32 in Wrapping; 17];
}

public machine distance_squared(x: i32 in Wrapping, y: i32 in Wrapping,
    anchor_x: i32 in Wrapping, anchor_y: i32 in Wrapping) -> i32 in Wrapping {
    let horizontal: i32 in Wrapping = x - anchor_x;
    let vertical: i32 in Wrapping = y - anchor_y;
    horizontal * horizontal + vertical * vertical
}

public machine feasible(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping) -> bool {
    transition { _ -> observation(problem, x, y, 0) }
    machine observation(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64) -> bool {
        transition index < 3 {
            true -> inspect(problem, x, y, index)
            false -> (true)
        }
    }
    machine inspect(problem: &Problem, x: i32 in Wrapping, y: i32 in Wrapping, index: u64) -> bool
    requires index < 3
    {
        let offset: u64 = 5 + index * 4;
        let squared: i32 in Wrapping = distance_squared(x, y, problem.values[offset], problem.values[offset + 1]);
        let lower: i32 in Wrapping = problem.values[offset + 2];
        let upper: i32 in Wrapping = problem.values[offset + 3];
        transition squared >= lower * lower && squared <= upper * upper {
            true -> observation(problem, x, y, index + 1)
            false -> (false)
        }
    }
}

public machine degenerate(problem: &Problem) -> bool {
    problem.values[5] == problem.values[9] && problem.values[9] == problem.values[13]
        && problem.values[6] == problem.values[10] && problem.values[10] == problem.values[14]
}
