// Bounded stdin supplied-K flash at fixed temperature and pressure.
// Expected exit: 64.
// Expected output contains: INVALID fractions_or_K
use omega_language_std::console;
use io::input;
use io::report;
use model::flash;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut raw: io::input::Raw;
    let mut feed: io::input::Feed;
    let mut solution: model::flash::Solution;
    let parsed: bool = block io::input::parse(&mut raw);
    transition parsed {
        true -> validate(&raw, &mut feed, &mut solution)
        false -> invalid()
    }
    state validate(raw: &io::input::Raw, feed: &mut io::input::Feed, solution: &mut model::flash::Solution) {
        transition io::input::validate(raw, feed) {
            true -> solve(feed, solution)
            false -> invalid()
        }
    }
    state solve(feed: &io::input::Feed, solution: &mut model::flash::Solution) {
        model::flash::solve(feed, solution);
        transition solution.status == 3 {
            true -> ambiguous(feed, solution)
            false -> verify(feed, solution)
        }
    }
    state ambiguous(feed: &io::input::Feed, solution: &model::flash::Solution) { io::report::emit(feed, solution); Console::exit_process(3); }
    state verify(feed: &io::input::Feed, solution: &model::flash::Solution) {
        transition model::flash::verify(feed, solution) {
            true -> done(feed, solution)
            false -> failed()
        }
    }
    state done(feed: &io::input::Feed, solution: &model::flash::Solution) { io::report::emit(feed, solution); Console::exit_process(0); }
    state failed() { Console::write_line("FAIL numerical_closure_or_composition"); Console::exit_process(65); }
    state invalid() { Console::write_line("INVALID fractions_or_K"); Console::exit_process(64); }
}
