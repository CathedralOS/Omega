module io::input;
use omega_language_std::console;
use omega::language::core::float_operations;

pub data Raw { values: [f64; 17]; count: u32; }
pub data Feed { count: u32; fractions: [f64; 8]; ratios: [f64; 8]; }
// Finite decimal grammar, 1023 bytes, 32 characters/token, 17 tokens.
// No floating parser can manufacture NaN/Inf; exponent and sign tokens refuse.
pub machine parse(raw: &mut Raw) -> bool reaches Console invokes Console; blocks; crashes Trap {
    transition { _ -> read(raw, 0.0, 1.0, false, false, false, 0, 0) }
    state read(raw: &mut Raw, value: f64, scale: f64, active: bool, dot: bool, digits: bool, length: u32, bytes: u32) -> bool {
        transition bytes < 1024 {
            true -> receive(raw, value, scale, active, dot, digits, length, bytes)
            false -> bad()
        }
    }
    state receive(raw: &mut Raw, value: f64, scale: f64, active: bool, dot: bool, digits: bool, length: u32, bytes: u32) -> bool {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> finish(raw, value, active, digits)
            ByteRead::Byte { value as character } -> classify(raw, value, scale, active, dot, digits, length, bytes, character)
        }
    }
    state classify(raw: &mut Raw, value: f64, scale: f64, active: bool, dot: bool, digits: bool, length: u32, bytes: u32, character: i32) -> bool {
        transition length < 32 && character >= 48 && character <= 57 {
            true -> digit(raw, value, scale, dot, length, bytes, character)
            false -> punctuation(raw, value, scale, active, dot, digits, length, bytes, character)
        }
    }
    state digit(raw: &mut Raw, value: f64, scale: f64, dot: bool, length: u32, bytes: u32, character: i32) -> bool {
        let digit: f64 = (character as f64) - 48.0;
        transition dot {
            true -> fractional(raw, value, scale, digit, length, bytes)
            false -> integral(raw, value, digit, length, bytes)
        }
    }
    state fractional(raw: &mut Raw, value: f64, scale: f64, digit: f64, length: u32, bytes: u32) -> bool {
        transition { _ -> read(raw, value + digit * scale / 10.0, scale / 10.0, true, true, true, length + 1, bytes + 1) }
    }
    state integral(raw: &mut Raw, value: f64, digit: f64, length: u32, bytes: u32) -> bool {
        let next: f64 = value * 10.0 + digit;
        transition next <= 20.0 {
            true -> read(raw, next, 1.0, true, false, true, length + 1, bytes + 1)
            false -> bad()
        }
    }
    state punctuation(raw: &mut Raw, value: f64, scale: f64, active: bool, dot: bool, digits: bool, length: u32, bytes: u32, character: i32) -> bool {
        transition character == 46 && !dot && length < 32 {
            true -> read(raw, value, scale, true, true, digits, length + 1, bytes + 1)
            false -> delimiter(raw, value, active, digits, bytes, character)
        }
    }
    state delimiter(raw: &mut Raw, value: f64, active: bool, digits: bool, bytes: u32, character: i32) -> bool {
        transition character == 32 || character == 9 || character == 10 || character == 13 {
            true -> separate(raw, value, active, digits, bytes)
            false -> bad()
        }
    }
    state separate(raw: &mut Raw, value: f64, active: bool, digits: bool, bytes: u32) -> bool {
        transition active {
            true -> capacity(raw, value, digits, bytes)
            false -> read(raw, 0.0, 1.0, false, false, false, 0, bytes + 1)
        }
    }
    state capacity(raw: &mut Raw, value: f64, digits: bool, bytes: u32) -> bool {
        transition raw.count < 17 && digits {
            true -> store(raw, value, bytes)
            false -> bad()
        }
    }
    state store(raw: &mut Raw, value: f64, bytes: u32) -> bool requires raw.count < 17 {
        raw.values[raw.count] = value;
        raw.count = raw.count + 1;
        transition { _ -> read(raw, 0.0, 1.0, false, false, false, 0, bytes + 1) }
    }
    state finish(raw: &mut Raw, value: f64, active: bool, digits: bool) -> bool {
        transition !active {
            true -> good()
            false -> final_capacity(raw, value, digits)
        }
    }
    state final_capacity(raw: &mut Raw, value: f64, digits: bool) -> bool {
        transition raw.count < 17 && digits {
            true -> final_store(raw, value)
            false -> bad()
        }
    }
    state final_store(raw: &mut Raw, value: f64) -> bool requires raw.count < 17 {
        raw.values[raw.count] = value;
        raw.count = raw.count + 1;
        transition { _ -> good() }
    }
    state good() -> bool { true }
    state bad() -> bool { false }
}
pub machine validate(raw: &Raw, feed: &mut Feed) -> bool {
    transition raw.count >= 5 && raw.values[0] >= 2.0 && raw.values[0] <= 8.0 {
        true -> count(raw, feed)
        false -> bad()
    }
    state count(raw: &Raw, feed: &mut Feed) -> bool {
        let converted: i32 in Saturating = I32::from_f64(raw.values[0]);
        transition { _ -> narrowed(raw, feed, converted as i32) }
    }
    state narrowed(raw: &Raw, feed: &mut Feed, count: i32) -> bool {
        transition count >= 2 && count <= 8 && raw.values[0] == (count as f64) {
            true -> initialize(raw, feed, count as u32)
            false -> bad()
        }
    }
    state initialize(raw: &Raw, feed: &mut Feed, count: u32) -> bool {
        feed.count = count;
        transition count >= 2 && count <= 8 && raw.count == 1 + 2 * count {
            true -> scan(raw, feed, 0, 0.0)
            false -> bad()
        }
    }
    state scan(raw: &Raw, feed: &mut Feed, position: u32, total: f64) -> bool {
        transition position < feed.count && position < 8 {
            true -> load(raw, feed, position, total)
            false -> sum(total)
        }
    }
    state load(raw: &Raw, feed: &mut Feed, position: u32, total: f64) -> bool requires position < 8 {
        let fraction: f64 = raw.values[1 + position * 2];
        let ratio: f64 = raw.values[2 + position * 2];
        transition fraction >= 0.0 && fraction <= 1.0 && ratio >= 0.05 && ratio <= 20.0 {
            true -> store(feed, raw, position, total, fraction, ratio)
            false -> bad()
        }
    }
    state store(feed: &mut Feed, raw: &Raw, position: u32, total: f64, fraction: f64, ratio: f64) -> bool requires position < 8 {
        feed.fractions[position] = fraction;
        feed.ratios[position] = ratio;
        transition { _ -> scan(raw, feed, position + 1, total + fraction) }
    }
    state sum(total: f64) -> bool {
        total >= 0.999999999999 && total <= 1.000000000001
    }
    state bad() -> bool { false }
}
