module protocol::report;

use omega_language_std::console;
use protocol::model;

pub data Report { }

pub machine Report::row(laboratory: &protocol::model::Laboratory, decision: i32) reaches Console
invokes Console;
{
    Report::decision(decision);
    Console::write(" owner=");
    Report::number(laboratory.owner as i32 in Saturating);
    Console::write(" phase=");
    Report::number(laboratory.phase as i32 in Saturating);
    Console::write(" lid=");
    Report::lid(laboratory.closed);
    Console::write(" tick=");
    Report::number(laboratory.elapsed);
    Console::write(" completed=");
    Report::number(laboratory.completed);
    Console::write(" aborted=");
    Report::number(laboratory.aborted);
    Console::write_line("");
}

machine Report::number(value: i32 in Saturating) reaches Console {
    transition value >= 0 && value <= 99 {
        true -> digits(value)
        false -> invalid()
    }
    state digits(value: i32 in Saturating) {
        let tens: i32 in Saturating = value / 10 + 48;
        let units: i32 in Saturating = value % 10 + 48;
        Console::write_byte(tens as i32);
        Console::write_byte(units as i32);
    }
    state invalid() {
        Console::write("??");
    }
}

machine Report::lid(closed: bool) reaches Console {
    transition closed {
        true -> shut()
        false -> open()
    }
    state shut() { Console::write("closed"); }
    state open() { Console::write("open"); }
}

machine Report::decision(decision: i32) reaches Console {
    transition decision {
        0 -> acquired()
        1 -> loaded()
        2 -> started()
        3 -> advanced()
        4 -> completed()
        5 -> cancelled()
        6 -> recovered()
        7 -> lid_changed()
        8 -> conflict()
        9 -> phase()
        10 -> interlock()
        11 -> timeout()
        13 -> emergency()
        _ -> invalid()
    }
    state acquired() { Console::write("ALLOW acquire"); }
    state loaded() { Console::write("ALLOW load"); }
    state started() { Console::write("ALLOW start interlock=closed"); }
    state advanced() { Console::write("ALLOW advance deadline=pending"); }
    state completed() { Console::write("ALLOW finish lease=released"); }
    state cancelled() { Console::write("ABORT cancel lease=retained"); }
    state recovered() { Console::write("ALLOW recover lease=released"); }
    state lid_changed() { Console::write("ALLOW lid"); }
    state conflict() { Console::write("DENY resource_owner"); }
    state phase() { Console::write("DENY phase"); }
    state interlock() { Console::write("DENY interlock=open"); }
    state timeout() { Console::write("ABORT timeout lease=retained"); }
    state emergency() { Console::write("ABORT interlock=open lease=retained"); }
    state invalid() { Console::write("DENY input"); }
}
