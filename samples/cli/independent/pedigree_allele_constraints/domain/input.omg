use omega_language_std::console;
use omega::language::core::binding;
use domain::model;

// Deliberately small wire format: whitespace separated single decimal digits.
// Parse to an independent token buffer before touching pedigree storage.
data Tokens { values: [i32; 19]; count: i32 in Wrapping; separated: bool; }

pub machine read(console: &mut Binding<Console>, pedigree: &mut Pedigree) -> bool
reaches Console
invokes console;
blocks;
crashes Trap
{
    let mut tokens: Tokens;
    tokens.separated = true;
    let accepted: bool = block scan(console, &mut tokens);
    transition accepted && tokens.count >= 1 {
        true -> header(pedigree, &tokens)
        _ -> false
    }
    state header(pedigree: &mut Pedigree, tokens: &Tokens) -> bool {
        pedigree.count = tokens.values[0] as i32 in Wrapping;
        transition pedigree.count >= 1 && pedigree.count <= 6 &&
                   tokens.count == 1 + 3 * pedigree.count {
            true -> row(pedigree, tokens, 0)
            _ -> false
        }
    }
    state row(pedigree: &mut Pedigree, tokens: &Tokens, index: i32 in Wrapping) -> bool {
        let position: i32 in Wrapping = 1 + 3 * index;
        transition index >= 0 && index < pedigree.count && index < 6 &&
                   position >= 1 && position + 2 < 19 {
            true -> copy(pedigree, tokens, index, position, position + 1, position + 2)
            _ -> valid(pedigree)
        }
    }
    state copy(pedigree: &mut Pedigree, tokens: &Tokens, index: i32 in Wrapping,
               first: i32 in Wrapping, second: i32 in Wrapping, third: i32 in Wrapping) -> bool {
        transition first >= 0 && first < 19 && second >= 0 && second < 19 && third >= 0 && third < 19 {
            true -> store(pedigree, tokens, index, first, second, third)
            _ -> false
        }
    }
    state store(pedigree: &mut Pedigree, tokens: &Tokens, index: i32 in Wrapping,
                first: i32 in Wrapping, second: i32 in Wrapping, third: i32 in Wrapping) -> bool {
        pedigree.father[index] = tokens.values[first];
        pedigree.mother[index] = tokens.values[second];
        pedigree.observed[index] = tokens.values[third];
        transition { _ -> row(pedigree, tokens, index + 1) }
    }
}

machine scan(console: &mut Binding<Console>, tokens: &mut Tokens) -> bool reaches Console {
    transition { _ -> byte(console, tokens) }
    state byte(console: &mut Binding<Console>, tokens: &mut Tokens) -> bool {
        let observed: ByteRead = block console.read_byte();
        transition observed {
            ByteRead::Eof -> true
            ByteRead::Byte { value } -> classify(console, tokens, value)
        }
    }
    state classify(console: &mut Binding<Console>, tokens: &mut Tokens, value: i32) -> bool {
        transition value == 32 || value == 10 || value == 13 || value == 9 {
            true -> space(console, tokens)
            _ -> digit(console, tokens, value)
        }
    }
    state space(console: &mut Binding<Console>, tokens: &mut Tokens) -> bool {
        tokens.separated = true;
        transition { _ -> byte(console, tokens) }
    }
    state digit(console: &mut Binding<Console>, tokens: &mut Tokens, value: i32) -> bool {
        transition value >= 48 && value <= 57 && tokens.separated && tokens.count >= 0 && tokens.count < 19 {
            true -> store(console, tokens, value - 48)
            _ -> false
        }
    }
    state store(console: &mut Binding<Console>, tokens: &mut Tokens, value: i32) -> bool {
        tokens.values[tokens.count] = value;
        tokens.count = tokens.count + 1;
        tokens.separated = false;
        transition { _ -> byte(console, tokens) }
    }
}
