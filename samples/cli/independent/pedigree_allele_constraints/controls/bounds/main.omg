// Intended rejection: a caller-controlled parent ID is not proven in bounds.
// A complete entry binding exercises this helper through the ordinary project.
data ParentLookup { alleles: [i32; 6]; }
machine unguarded(pedigree: &ParentLookup, parent: i32) -> i32 {
    pedigree.alleles[parent]
}
machine main() {
    let pedigree: ParentLookup;
    let value: i32 = unguarded(&pedigree, 6);
}
