// Complete console application. EOF terminates one bounded pedigree request.
// Empty stdin is an invalid request (the sample harness EOF case).
// Expected exit: 64.
// Expected output contains: INVALID INPUT
use omega_language_std::console;
use omega::language::core::binding;
use domain::model;
use domain::input;
use domain::solver;
use domain::report;

data Main { console: Binding<Console>; }

machine Main::main(main: &mut Main) reaches Console {
    let mut pedigree: Pedigree;
    let accepted: bool = block read(&mut main.console, &mut pedigree);
    transition accepted {
        true -> infer(main, &pedigree)
        _ -> invalid(main)
    }
    state infer(main: &mut Main, pedigree: &Pedigree) {
        let mut result: Inference;
        initialize(pedigree, &mut result);
        enumerate(pedigree, &mut result);
        transition result.mass == 0 {
            true -> impossible(main, pedigree, &mut result)
            _ -> complete(main, pedigree, &result)
        }
    }
    state impossible(main: &mut Main, pedigree: &Pedigree, result: &mut Inference) {
        contradiction(pedigree, result);
        emit(&mut main.console, pedigree, result);
        main.console.exit_process(2);
    }
    state complete(main: &mut Main, pedigree: &Pedigree, result: &Inference) {
        emit(&mut main.console, pedigree, result);
        main.console.exit_process(0);
    }
    state invalid(main: &mut Main) {
        main.console.write_line("INVALID INPUT");
        main.console.exit_process(64);
    }
}
