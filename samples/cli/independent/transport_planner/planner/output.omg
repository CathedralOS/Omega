module planner::output;
use omega_language_std::console;
use planner::solver::TransportPlan;

// Fixed signed four-digit objective keeps the table machine-readable. All
// digit output is through the ordinary selected Console provider.
public machine emit_integer(value: i32 in Wrapping) reaches Console
invokes Console;
{
    transition value < 0 {
        true -> negative(0 - value)
        false -> positive(value)
    }
    machine negative(value: i32 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> digits(value, 1000) }
    }
    machine positive(value: i32 in Wrapping) {
        Console::write_byte(43);
        transition { _ -> digits(value, 1000) }
    }
    machine digits(value: i32 in Wrapping, divisor: i32 in Wrapping)
    requires divisor > 0
    {
        let digit: i32 in Wrapping = value / divisor % 10 + 48;
        Console::write_byte(digit as i32);
        transition divisor >= 10 {
            true -> digits(value, divisor / 10)
            false -> finish()
        }
    }
    machine finish() { Console::write_byte(10); }
}
public machine emit_plan(plan: &TransportPlan) reaches Console
invokes Console;
{
    Console::write_line("OPTIMAL: shipments");
    transition { _ -> cell(plan, 0) }
    machine cell(plan: &TransportPlan, index: u64) {
        transition index < 9 {
            true -> write_cell(plan, index)
            false -> total(plan)
        }
    }
    machine write_cell(plan: &TransportPlan, index: u64) {
        let digit: i32 in Wrapping = (plan.shipments[index] as i32 in Wrapping) + 48;
        Console::write_byte(digit as i32);
        transition index % 3 == 2 {
            true -> newline(plan, index)
            false -> space(plan, index)
        }
    }
    machine newline(plan: &TransportPlan, index: u64) {
        Console::write_byte(10);
        transition { _ -> cell(plan, index + 1) }
    }
    machine space(plan: &TransportPlan, index: u64) {
        Console::write_byte(32);
        transition { _ -> cell(plan, index + 1) }
    }
    machine total(plan: &TransportPlan) {
        Console::write("total_cost ");
        emit_integer(plan.total);
    }
}
