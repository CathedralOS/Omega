use omega_language_std::console;
data Main { }
// Complete entrypoint, but the constant out-of-range access must be rejected.
machine Main::main(main: &mut Main) reaches Console {
    let costs: [i32; 9] = [1,2,3,4,5,6,7,8,9];
    let impossible: i32 = costs[9];
    Console::exit_process(impossible);
}
