// Expected exit: 0.
// Expected output contains: emitted_W,ambient_W,net_W,emission_fraction
use io::protocol;
use model::planck;
use omega_language_std::console;
use omega_language_std::math;
use omega::language::core::float_operations;
use omega::language::core::slice;

// The scanner borrows the parsed fields through a shared descriptor.
data RadiometryInput<'fields> [copy] { values: &'fields [f64]; }
machine finite_input<'fields>(input: RadiometryInput<'fields>, index: u64) -> bool
requires index < input.values.len { is_finite(input.values[index]) }

data Main {
    protocol: Protocol;
}

machine Main::main(main: &mut Main) reaches Console {
    let parsed: bool = block Protocol::read(&mut main.protocol);
    transition parsed { true -> finite(main, 0) false -> invalid(main) }
    state finite(main: &mut Main, index: u64) {
        transition index < 7 { true -> field(main, index) false -> validate(main) }
    }
    state field(main: &mut Main, index: u64) requires index < 7 {
        let input: RadiometryInput = RadiometryInput { values: &main.protocol.fields };
        let valid: bool = finite_input(input, index);
        transition valid { true -> finite(main, index + 1) false -> invalid(main) }
    }
    state validate(main: &mut Main) {
        transition main.protocol.fields[0] >= 100.0 && main.protocol.fields[0] <= 3000.0
            && (main.protocol.fields[1] == 0.0 || (main.protocol.fields[1] >= 100.0 && main.protocol.fields[1] <= 3000.0))
            && main.protocol.fields[2] >= 0.0 && main.protocol.fields[2] <= 1.0
            && main.protocol.fields[3] >= 0.0 && main.protocol.fields[3] <= 10000.0
            && main.protocol.fields[4] >= 0.0 && main.protocol.fields[4] <= 1.0
            && main.protocol.fields[5] >= 0.1 && main.protocol.fields[6] <= 10000.0
            && main.protocol.fields[5] < main.protocol.fields[6] {
            true -> compute(main)
            false -> invalid(main)
        }
    }
    state compute(main: &mut Main) {
        let emitter: f64 = main.protocol.fields[0];
        let ambient: f64 = main.protocol.fields[1];
        let fraction_integral: f64 = band(emitter, main.protocol.fields[5], main.protocol.fields[6], 0.0, false);
        let ambient_integral: f64 = band(ambient, main.protocol.fields[5], main.protocol.fields[6], 0.0, false);
        let fraction: f64 = fraction_integral / 6.4939394022668291;
        let background_fraction: f64 = ambient_integral / 6.4939394022668291;
        // sigma derived from the same exact SI constants and pi, not a rounded
        // independently fitted Stefan-Boltzmann constant.
        let scale: f64 = main.protocol.fields[2] * main.protocol.fields[3] * main.protocol.fields[4];
        let emitted: f64 = 0.000000056703744191844294 * emitter * emitter * emitter * emitter * fraction * scale;
        let background: f64 = 0.000000056703744191844294 * ambient * ambient * ambient * ambient * background_fraction * scale;
        let net: f64 = net_exitance(emitter, ambient, main.protocol.fields[5], main.protocol.fields[6]);
        Console::write_line("emitted_W,ambient_W,net_W,emission_fraction");
        Protocol::number(&mut main.protocol, emitted);
        Console::write(",");
        Protocol::number(&mut main.protocol, background);
        Console::write(",");
        Protocol::number(&mut main.protocol, net * scale);
        Console::write(",");
        Protocol::number(&mut main.protocol, fraction);
        Console::write_line("");
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) {
        Console::write_line("ERROR invalid input");
        Console::exit_process(64);
    }
}
