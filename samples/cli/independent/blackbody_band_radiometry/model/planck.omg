use omega::language::core::float_operations;

// h=6.62607015e-34 J s, c=299792458 m/s, k=1.380649e-23 J/K
// are exact SI definitions. With x=hc/(lambda k T), exitance is
// 2*pi*k^4*T^4/(h^3*c^2) integral x^3/(exp(x)-1) dx.
// Four-point Gauss-Legendre on panels <=0.25, x capped at 80: the
// omitted Wien tail is below 1e-19 W even at maximum area and temperature.
// A source contract bounds work independently of runtime input validation.
public machine integral(lower: f64, span: f64, panels: u64, contrast: f64, difference: bool) -> f64
requires panels >= 1 && panels <= 320
{
    let divisor: f64 = panels as f64;
    let width: f64 = span / divisor;
    transition { _ -> panel(lower, width, panels, 0, 0.0, contrast, difference) }
    machine panel(lower: f64, width: f64, panels: u64, index: u64, sum: f64, contrast: f64, difference: bool) -> f64 {
        transition index < panels {
            true -> bounded(lower, width, panels, index, sum, contrast, difference)
            false -> (sum)
        }
    }
    machine bounded(lower: f64, width: f64, panels: u64, index: u64, sum: f64, contrast: f64, difference: bool) -> f64 {
        transition index <= 320 { true -> evaluate(lower, width, panels, index, sum, contrast, difference) false -> (sum) }
    }
    machine evaluate(lower: f64, width: f64, panels: u64, index: u64, sum: f64, contrast: f64, difference: bool) -> f64
    requires index <= 320
    {
        let position: f64 = index as f64;
        let midpoint: f64 = lower + (position + 0.5) * width;
        let half: f64 = width * 0.5;
        let inner: f64 = half * 0.33998104358485626;
        let outer: f64 = half * 0.86113631159405258;
        let first: f64 = kernel(midpoint - outer, contrast, difference);
        let second: f64 = kernel(midpoint - inner, contrast, difference);
        let third: f64 = kernel(midpoint + inner, contrast, difference);
        let fourth: f64 = kernel(midpoint + outer, contrast, difference);
        let weighted: f64 = (first + fourth) * 0.34785484513745386 + (second + third) * 0.65214515486254614;
        transition { _ -> panel(lower, width, panels, index + 1, sum + half * weighted, contrast, difference) }
    }
}

machine kernel(x: f64, contrast: f64, difference: bool) -> f64 {
    let decay: f64 = exponential(0.0 - x);
    let numerator: f64 = x * x * x * decay;
    transition difference { true -> net(x, contrast, decay, numerator) false -> (numerator / (1.0 - decay)) }
    machine net(x: f64, contrast: f64, decay: f64, numerator: f64) -> f64 {
        let delta: f64 = x * contrast;
        let excess: f64 = one_minus_decay(delta);
        let denominator: f64 = (1.0 - decay) * (1.0 - decay + decay * excess);
        numerator * excess / denominator
    }
}

// The net spectrum uses a direct expm1 series near equilibrium, avoiding
// cancellation between two rounded band powers. Hotter temperature is the
// common integration coordinate, so delta is nonnegative.
machine one_minus_decay(delta: f64) -> f64 {
    transition delta < 1.0 { true -> series(delta, delta, delta, 2.0, 2) false -> large(delta) }
    machine series(delta: f64, sum: f64, previous: f64, denominator: f64, count: u64) -> f64 {
        let next: f64 = previous * (0.0 - delta) / denominator;
        let total: f64 = sum + next;
        transition count < 20 { true -> series(delta, total, next, denominator + 1.0, count + 1) false -> (total) }
    }
    machine large(delta: f64) -> f64 {
        transition delta > 80.0 { true -> (1.0) false -> ordinary(delta) }
    }
    machine ordinary(delta: f64) -> f64 {
        let decay: f64 = exponential(0.0 - delta);
        1.0 - decay
    }
}

// On [-80,0], reducing by 128 leaves |z|<=0.625. Twenty Taylor
// terms then seven squarings avoid host math imports and exp overflow.
machine exponential(value: f64) -> f64 {
    let reduced: f64 = value / 128.0;
    transition { _ -> term(reduced, 1.0, 1.0, 1.0, 1) }
    machine term(reduced: f64, sum: f64, previous: f64, denominator: f64, count: u64) -> f64 {
        let next: f64 = previous * reduced / denominator;
        let total: f64 = sum + next;
        transition count < 20 {
            true -> term(reduced, total, next, denominator + 1.0, count + 1)
            false -> square(total)
        }
    }
    machine square(value: f64) -> f64 {
        let power2: f64 = value * value;
        let power4: f64 = power2 * power2;
        let power8: f64 = power4 * power4;
        let power16: f64 = power8 * power8;
        let power32: f64 = power16 * power16;
        let power64: f64 = power32 * power32;
        power64 * power64
    }
}

public machine band(temperature: f64, minimum: f64, maximum: f64, contrast: f64, difference: bool) -> f64 {
    transition temperature == 0.0 { true -> (0.0) false -> bounds(temperature, minimum, maximum, contrast, difference) }
    machine bounds(temperature: f64, minimum: f64, maximum: f64, contrast: f64, difference: bool) -> f64 {
        let lower: f64 = 14387.768775039337 / (maximum * temperature);
        // Compute width directly: subtracting reciprocal endpoints needlessly
        // loses precision when the wavelength interval is narrow.
        let span: f64 = 14387.768775039337 * (maximum - minimum) / (minimum * maximum * temperature);
        transition lower >= 80.0 { true -> (0.0) false -> clamp(lower, span, contrast, difference) }
    }
    machine clamp(lower: f64, span: f64, contrast: f64, difference: bool) -> f64 {
        transition lower + span > 80.0 { true -> partition(lower, 80.0 - lower, 1, contrast, difference) false -> partition(lower, span, 1, contrast, difference) }
    }
    machine partition(lower: f64, span: f64, panels: u64, contrast: f64, difference: bool) -> f64 {
        transition panels >= 1 && panels <= 320 { true -> resolved(lower, span, panels, contrast, difference) false -> (0.0) }
    }
    machine resolved(lower: f64, span: f64, panels: u64, contrast: f64, difference: bool) -> f64
    requires panels >= 1 && panels <= 320
    {
        let count: f64 = panels as f64;
        transition span <= count * 0.25 { true -> integral(lower, span, panels, contrast, difference) false -> partition(lower, span, panels + 1, contrast, difference) }
    }
}

public machine net_exitance(emitter: f64, ambient: f64, minimum: f64, maximum: f64) -> f64 {
    transition {
        emitter == ambient -> (0.0)
        ambient == 0.0 -> absolute(emitter, minimum, maximum)
        emitter > ambient -> hotter(emitter, ambient, minimum, maximum, 1.0)
        _ -> hotter(ambient, emitter, minimum, maximum, -1.0)
    }
    machine absolute(temperature: f64, minimum: f64, maximum: f64) -> f64 {
        let result: f64 = band(temperature, minimum, maximum, 0.0, false);
        0.000000056703744191844294 * temperature * temperature * temperature * temperature * result / 6.4939394022668291
    }
    machine hotter(hot: f64, cold: f64, minimum: f64, maximum: f64, sign: f64) -> f64 {
        let contrast: f64 = (hot - cold) / cold;
        let result: f64 = band(hot, minimum, maximum, contrast, true);
        sign * 0.000000056703744191844294 * hot * hot * hot * hot * result / 6.4939394022668291
    }
}
