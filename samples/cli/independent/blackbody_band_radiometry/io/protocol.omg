use omega_language_std::console;
use omega::language::core::float_operations;

data Protocol {
    fields: [f64; 7];
    position: i32 in Wrapping;
    length: i32 in Wrapping;
    accumulator: f64;
    fraction_digits: [i32; 256];
    fraction_count: u64;
    fraction_nonzero: bool;
    decimal: bool;
    negative: bool;
    digits: bool;
    started: bool;
}

// Exactly seven bounded signed decimal numbers separated by spaces, tabs or carriage returns.
// LF or EOF completes the record. The parser stores no more than seven values,
// reads at most 256 bytes, and rejects rather than wrapping decimal overflow.
machine Protocol::read(protocol: &mut Protocol) -> bool
reaches Console
blocks;
crashes Trap
{
    protocol.position = 0;
    protocol.length = 0;
    protocol.accumulator = 0.0;
    protocol.fraction_count = 0;
    protocol.fraction_nonzero = false;
    protocol.decimal = false;
    protocol.negative = false;
    protocol.digits = false;
    protocol.started = false;
    transition { _ -> scan_input(protocol) }
    state scan_input(protocol: &mut Protocol) -> bool {
        transition protocol.length < 256 {
            true -> observe(protocol)
            false -> rejected()
        }
    }
    state observe(protocol: &mut Protocol) -> bool {
        let observed: ByteRead = block Console::read_byte();
        protocol.length = protocol.length + 1;
        transition observed {
            ByteRead::Eof -> finish(protocol)
            ByteRead::Byte { value } -> character(protocol, value)
        }
    }
    state character(protocol: &mut Protocol, value: i32) -> bool {
        transition value >= 48 && value <= 57 {
            true -> digit(protocol, value)
            false -> punctuation(protocol, value)
        }
    }
    state digit(protocol: &mut Protocol, value: i32) -> bool {
        transition protocol.position < 7 && protocol.accumulator <= 100000000.0 {
            true -> accumulate(protocol, value)
            false -> rejected()
        }
    }
    state accumulate(protocol: &mut Protocol, value: i32) -> bool {
        let digit: f64 = value as f64;
        transition protocol.decimal { true -> fractional(protocol, value - 48) false -> whole(protocol, digit - 48.0) }
    }
    state whole(protocol: &mut Protocol, digit: f64) -> bool {
        protocol.accumulator = protocol.accumulator * 10.0 + digit;
        transition { _ -> accumulated(protocol) }
    }
    state fractional(protocol: &mut Protocol, digit: i32) -> bool {
        transition protocol.fraction_count < 256 { true -> fraction_store(protocol, digit, protocol.fraction_count) false -> rejected() }
    }
    state fraction_store(protocol: &mut Protocol, digit: i32, position: u64) -> bool
    requires position < 256
    {
        protocol.fraction_digits[position] = digit;
        protocol.fraction_count = position + 1;
        protocol.fraction_nonzero = protocol.fraction_nonzero || digit != 0;
        transition { _ -> accumulated(protocol) }
    }
    state accumulated(protocol: &mut Protocol) -> bool {
        protocol.started = true;
        protocol.digits = true;
        transition { _ -> scan_input(protocol) }
    }
    state punctuation(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 46 && !protocol.decimal && protocol.position < 7 {
            true -> decimal(protocol)
            false -> sign(protocol, value)
        }
    }
    state decimal(protocol: &mut Protocol) -> bool {
        protocol.started = true;
        protocol.decimal = true;
        transition { _ -> scan_input(protocol) }
    }
    state sign(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 45 && !protocol.started && protocol.position < 7 {
            true -> minus(protocol)
            false -> separator(protocol, value)
        }
    }
    state minus(protocol: &mut Protocol) -> bool {
        protocol.started = true;
        protocol.negative = true;
        transition { _ -> scan_input(protocol) }
    }
    state separator(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 10 {
            true -> finish(protocol)
            false -> whitespace(protocol, value)
        }
    }
    state whitespace(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 32 || value == 9 || value == 13 {
            true -> commit(protocol, false)
            false -> rejected()
        }
    }
    state finish(protocol: &mut Protocol) -> bool {
        transition { _ -> commit(protocol, true) }
    }
    state commit(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.digits {
            true -> guarded_store(protocol, final)
            false -> empty(protocol, final)
        }
    }
    state empty(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.started {
            true -> rejected()
            false -> after(protocol, final)
        }
    }
    state guarded_store(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.position >= 0 && protocol.position < 7 {
            true -> store(protocol, final, protocol.position)
            false -> rejected()
        }
    }
    state store(protocol: &mut Protocol, final: bool, position: i32 in Wrapping) -> bool
    requires position >= 0 && position < 7
    {
        transition protocol.negative {
            true -> negative(protocol, final, position)
            false -> positive(protocol, final, position)
        }
    }
    state negative(protocol: &mut Protocol, final: bool, position: i32 in Wrapping) -> bool
    requires position >= 0 && position < 7
    {
        let value: f64 = decimal_value(protocol);
        protocol.fields[position] = 0.0 - value;
        transition { _ -> reset(protocol, final) }
    }
    state positive(protocol: &mut Protocol, final: bool, position: i32 in Wrapping) -> bool
    requires position >= 0 && position < 7
    {
        let value: f64 = decimal_value(protocol);
        protocol.fields[position] = value;
        transition { _ -> reset(protocol, final) }
    }
    state reset(protocol: &mut Protocol, final: bool) -> bool {
        protocol.position = protocol.position + 1;
        protocol.accumulator = 0.0;
        protocol.fraction_count = 0;
    protocol.fraction_nonzero = false;
        protocol.decimal = false;
        protocol.negative = false;
        protocol.digits = false;
        protocol.started = false;
        transition { _ -> after(protocol, final) }
    }
    state after(protocol: &mut Protocol, final: bool) -> bool {
        transition final {
            true -> complete(protocol)
            false -> scan_input(protocol)
        }
    }
    state complete(protocol: &mut Protocol) -> bool { protocol.position == 7 }
    state rejected() -> bool { false }
}

machine Protocol::integer(protocol: &mut Protocol, value: i32 in Wrapping)
reaches Console {
    transition value < 0 {
        true -> negative(protocol, value)
        false -> digits(protocol, value, 1000000000, false)
    }
    state negative(protocol: &mut Protocol, value: i32 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> digits(protocol, 0 - value, 1000000000, false) }
    }
    state digits(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let digit: i32 in Wrapping = value / divisor;
        let remainder: i32 in Wrapping = value % divisor;
        transition digit != 0 || started || divisor == 1 {
            true -> emit(protocol, digit, remainder, divisor)
            false -> next(protocol, remainder, divisor, false)
        }
    }
    state emit(protocol: &mut Protocol, digit: i32 in Wrapping,
        remainder: i32 in Wrapping, divisor: i32 in Wrapping)
    requires divisor >= 1
    {
        Console::write_byte((digit + 48) as i32);
        transition { _ -> next(protocol, remainder, divisor, true) }
    }
    state next(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        transition divisor > 1 {
            true -> divide(protocol, value, divisor, started)
            false -> done()
        }
    }
    state divide(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let next_divisor: i32 in Wrapping = divisor / 10;
        transition next_divisor >= 1 {
            true -> digits(protocol, value, next_divisor, started)
            false -> done()
        }
    }
    state done() { }
}

// Nine significant decimal digits as signed integer mantissa and power of ten.
// All model outputs are finite, and normalization precedes the trapping cast.
machine Protocol::number(protocol: &mut Protocol, value: f64)
reaches Console {
    transition value == 0.0 {
        true -> zero(protocol)
        false -> sign(protocol, value)
    }
    state zero(protocol: &mut Protocol) { Console::write("0"); }
    state sign(protocol: &mut Protocol, value: f64) {
        transition value < 0.0 {
            true -> negative(protocol, value)
            false -> normalize(protocol, value, 0)
        }
    }
    state negative(protocol: &mut Protocol, value: f64) {
        Console::write_byte(45);
        transition { _ -> normalize(protocol, 0.0 - value, 0) }
    }
    state normalize(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value >= 10.0 {
            true -> normalize(protocol, value / 10.0, exponent + 1)
            false -> small(protocol, value, exponent)
        }
    }
    state small(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value < 1.0 {
            true -> normalize(protocol, value * 10.0, exponent - 1)
            false -> emit(protocol, value, exponent)
        }
    }
    state emit(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        let scaled: f64 = value * 100000000.0;
        transition scaled == scaled && scaled >= 0.0 && scaled < 1000000000.0 {
            true -> land(protocol, scaled, exponent)
            false -> invalid(protocol)
        }
    }
    state land(protocol: &mut Protocol, scaled: f64, exponent: i32 in Wrapping)
    requires scaled == scaled && scaled >= 0.0 && scaled < 1000000000.0
    {
        let mantissa: i32 = I32::from_f64(scaled);
        Protocol::integer(protocol, mantissa as i32 in Wrapping);
        Console::write("e");
        Protocol::integer(protocol, exponent - 8);
    }
    state invalid(protocol: &mut Protocol) {
        Console::write_line("ERROR numeric: reporting value outside finite model envelope");
        Console::exit_process(66);
    }
}

// Correctly round the bounded decimal token to binary64 without host parsing.
// The whole part is an exact small integer. Decimal fraction digits are doubled
// in place to extract exact binary bits. Retain 53 significant bits, then round
// using guard, sticky and parity. No decimal-float repeated-add approximation
// decides whether near-equal input temperatures are the same quantity.
machine decimal_value(protocol: &mut Protocol) -> f64 {
    let whole: f64 = protocol.accumulator;
    transition protocol.accumulator == 0.0 && !protocol.fraction_nonzero {
        true -> (0.0)
        false -> integer_bits(protocol, whole)
    }
    state integer_bits(protocol: &mut Protocol, normalized: f64) -> f64 {
        let whole: f64 = protocol.accumulator;
        transition {
            normalized >= 1.0 -> normalize(protocol, normalized, 1)
            _ -> fractional_bits(protocol, whole, 0.5, 0, false)
        }
    }
    state normalize(protocol: &mut Protocol, normalized: f64, count: u64) -> f64
    requires count <= 53
    {
        let whole: f64 = protocol.accumulator;
        transition normalized >= 2.0 && count < 53 {
            true -> normalize(protocol, normalized * 0.5, count + 1)
            false -> fractional_bits(protocol, whole, 0.5, count, false)
        }
    }
    state fractional_bits(protocol: &mut Protocol, value: f64, weight: f64, count: u64, last: bool) -> f64
    requires count <= 53
    {
        let bit: bool = fraction_bit(protocol);
        transition count == 53 {
            true -> rounding(protocol, value, weight, last, bit)
            false -> append(protocol, value, weight, count, bit)
        }
    }
    state append(protocol: &mut Protocol, value: f64, weight: f64, count: u64, bit: bool) -> f64
    requires count < 53
    {
        transition bit {
            true -> fractional_bits(protocol, value + weight, weight * 0.5, count + 1, true)
            false -> empty_bit(protocol, value, weight, count)
        }
    }
    state empty_bit(protocol: &mut Protocol, value: f64, weight: f64, count: u64) -> f64
    requires count < 53
    {
        transition count == 0 {
            true -> fractional_bits(protocol, value, weight * 0.5, 0, false)
            false -> fractional_bits(protocol, value, weight * 0.5, count + 1, false)
        }
    }
    state rounding(protocol: &mut Protocol, value: f64, weight: f64, last: bool, guard: bool) -> f64 {
        let sticky: bool = fraction_sticky(protocol, 0);
        transition guard && (sticky || last) { true -> (value + weight * 2.0) false -> (value) }
    }
}

machine fraction_bit(protocol: &mut Protocol) -> bool {
    let count: u64 = protocol.fraction_count;
    transition { _ -> double(protocol, count, 0) }
    state double(protocol: &mut Protocol, remaining: u64, carry: i32 in Wrapping) -> bool {
        transition remaining > 0 && remaining <= 256 {
            true -> digit(protocol, remaining - 1, carry)
            false -> (carry != 0)
        }
    }
    state digit(protocol: &mut Protocol, position: u64, carry: i32 in Wrapping) -> bool
    requires position < 256
    {
        let prior: i32 in Wrapping = protocol.fraction_digits[position] as i32 in Wrapping;
        let value: i32 in Wrapping = prior * 2 + carry;
        transition value >= 10 { true -> store(protocol, position, value - 10, 1) false -> store(protocol, position, value, 0) }
    }
    state store(protocol: &mut Protocol, position: u64, value: i32 in Wrapping, carry: i32 in Wrapping) -> bool
    requires position < 256
    {
        protocol.fraction_digits[position] = value as i32;
        transition { _ -> double(protocol, position, carry) }
    }
}

machine fraction_sticky(protocol: &Protocol, position: u64) -> bool {
    transition position < protocol.fraction_count && position < 256 {
        true -> digit(protocol, position)
        false -> (false)
    }
    state digit(protocol: &Protocol, position: u64) -> bool requires position < 256 {
        transition protocol.fraction_digits[position] != 0 { true -> (true) false -> fraction_sticky(protocol, position + 1) }
    }
}
