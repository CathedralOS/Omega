// Private bounded storage. Mathematical bounds are validated before arithmetic;
// Wrapping declares the runtime policy, never permission to accept an overflow.
data Acquisition {
    tokens: [i64 in Wrapping; 53];
    used: i64 in Wrapping;
    count: i64 in Wrapping;
    modulus: i64 in Wrapping;
    lower: i64 in Wrapping;
    upper: i64 in Wrapping;
    anchor: i64 in Wrapping;
    sequence: [i64 in Wrapping; 16];
    raw: [i64 in Wrapping; 16];
    host: [i64 in Wrapping; 16];
    elapsed: [i64 in Wrapping; 16];
    timestamps: [i64 in Wrapping; 16];
    wraps: i64 in Wrapping;
    dropped: i64 in Wrapping;
    numerator: i64 in Wrapping;
    denominator: i64 in Wrapping;
    residual: i64 in Wrapping;
    error: i64 in Wrapping;
}
