use omega_language_std::console;
use omega::language::core::numeric_conversion;
use clock::model;

data Token {
    case End;
    case Invalid;
    case Number(value: i64 in Wrapping);
}

// Nonnegative decimal tokens, ASCII whitespace, at most 19 digits and i64::MAX.
// The guard precedes multiply/add, including at the signed overflow boundary.
machine next_token() -> Token reaches Console
blocks;
crashes Trap
{
    transition { _ -> scan(0, 0) }
    machine scan(value: i64 in Wrapping, digits: i64 in Wrapping) -> Token {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> end(value, digits)
            ByteRead::Byte { value as byte } -> classify(value, digits, byte)
        }
    }
    machine end(value: i64 in Wrapping, digits: i64 in Wrapping) -> Token {
        transition digits == 0 {
            true -> (Token::End)
            false -> (Token::Number { value: value })
        }
    }
    machine classify(value: i64 in Wrapping, digits: i64 in Wrapping, byte: i32) -> Token {
        transition byte == 32 || byte == 10 || byte == 13 || byte == 9 {
            true -> whitespace(value, digits)
            false -> digit(value, digits, byte)
        }
    }
    machine whitespace(value: i64 in Wrapping, digits: i64 in Wrapping) -> Token {
        transition digits == 0 {
            true -> scan(0, 0)
            false -> (Token::Number { value: value })
        }
    }
    machine digit(value: i64 in Wrapping, digits: i64 in Wrapping, byte: i32) -> Token {
        transition byte >= 48 && byte <= 57 && digits < 19 {
            true -> bounded(value, digits, (widen_i32_to_i64(byte) as i64 in Wrapping) - 48)
            false -> (Token::Invalid)
        }
    }
    machine bounded(value: i64 in Wrapping, digits: i64 in Wrapping, digit: i64 in Wrapping) -> Token {
        transition value < 922337203685477580 || (value == 922337203685477580 && digit <= 7) {
            true -> scan(value * 10 + digit, digits + 1)
            false -> (Token::Invalid)
        }
    }
}

machine read_acquisition(acquisition: &mut Acquisition) reaches Console
blocks;
crashes Trap
{
    acquisition.used = 0;
    acquisition.error = 0;
    transition { _ -> read(acquisition) }
    machine read(acquisition: &mut Acquisition) {
        transition block next_token() {
            Token::End -> done()
            Token::Invalid -> invalid(acquisition)
            Token::Number { value } -> store(acquisition, value)
        }
    }
    machine store(acquisition: &mut Acquisition, value: i64 in Wrapping) {
        transition acquisition.used < 53 && acquisition.used >= 0 {
            true -> append(acquisition, value)
            false -> invalid(acquisition)
        }
    }
    machine append(acquisition: &mut Acquisition, value: i64 in Wrapping) {
        acquisition.tokens[acquisition.used] = value;
        acquisition.used = acquisition.used + 1;
        transition { _ -> read(acquisition) }
    }
    machine invalid(acquisition: &mut Acquisition) { acquisition.error = 1; }
    machine done() { }
}
