use omega_language_std::console;
use omega::language::core::numeric_conversion;
use clock::model;

// Runtime recursive call cycles must be tail-position calls. Decimal suffix
// work therefore lives in explicit bounded scratch, not recursive activations.
// At most 19 digits cover every accepted nonnegative i64 magnitude. Byte output
// avoids inventing a Utf8 proof for a mutable text carrier.
machine number(value: i64 in Wrapping) reaches Console
crashes Trap
{
    let mut digits: [i32 in Wrapping; 19];
    transition value < 0 {
        true -> negative(&mut digits, value)
        false -> fill(&mut digits, 0, value)
    }
    machine negative(digits: &mut [i32 in Wrapping; 19], value: i64 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> fill(digits, 0, 0 - value) }
    }
    machine fill(digits: &mut [i32 in Wrapping; 19], count: i64 in Wrapping, value: i64 in Wrapping) {
        transition count >= 0 && count < 19 {
            true -> append(digits, count, value)
            false -> invalid()
        }
    }
    machine append(digits: &mut [i32 in Wrapping; 19], count: i64 in Wrapping, value: i64 in Wrapping)
    requires count >= 0 && count < 19
    {
        let digit: i64 in Wrapping = value % 10 + 48;
        digits[count] = narrow_i64_to_i32_trapping(digit as i64) as i32 in Wrapping;
        transition value >= 10 {
            true -> fill(digits, count + 1, value / 10)
            false -> drain(digits, count + 1)
        }
    }
    machine drain(digits: &[i32 in Wrapping; 19], count: i64 in Wrapping) {
        transition count > 0 && count <= 19 {
            true -> emit(digits, count - 1)
            false -> done()
        }
    }
    machine emit(digits: &[i32 in Wrapping; 19], index: i64 in Wrapping)
    requires index >= 0 && index < 19
    {
        Console::write_byte(digits[index] as i32);
        transition { _ -> drain(digits, index) }
    }
    machine done() { }
    machine invalid() { crash Trap; }
}

machine report(acquisition: &Acquisition) reaches Console
crashes Trap
{
    transition { _ -> row(acquisition, 0) }
    machine row(acquisition: &Acquisition, index: i64 in Wrapping) {
        transition index >= 0 && index < 16 && index < acquisition.count {
            true -> emit(acquisition, index)
            false -> summary(acquisition)
        }
    }
    machine emit(acquisition: &Acquisition, index: i64 in Wrapping)
    requires index >= 0 && index < 16
    {
        Console::write("row "); number(acquisition.sequence[index]);
        Console::write(" raw "); number(acquisition.raw[index]);
        Console::write(" timestamp "); number(acquisition.timestamps[index]);
        Console::write(" elapsed "); number(acquisition.elapsed[index]);
        Console::write(" host "); number(acquisition.host[index]);
        Console::write_line("");
        transition { _ -> row(acquisition, index + 1) }
    }
    machine summary(acquisition: &Acquisition) {
        Console::write("wraps "); number(acquisition.wraps);
        Console::write(" dropped "); number(acquisition.dropped);
        Console::write_line("");
        Console::write("rate "); number(acquisition.numerator);
        Console::write("/"); number(acquisition.denominator);
        Console::write_line(" host_units/tick");
        Console::write("drift "); number((acquisition.numerator - acquisition.denominator) * 1000000);
        Console::write("/"); number(acquisition.denominator);
        Console::write_line(" ppm_vs_one");
        Console::write("max_residual "); number(acquisition.residual);
        Console::write("/"); number(acquisition.denominator);
        Console::write_line(" host_units");
    }
}
