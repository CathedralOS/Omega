module domain::model;
use omega::language::core::float_operations;

// Declared quasi-static sample model, not an ideal-gas equation of state.
// Pressure is kPa, volume is litres, hence work is joules. Positive work
// means work by the piston. Isochoric stages interpolate declared pressure and do zero work.
public data Stage [copy] {
    volume: f64;
    pressure: f64;
    end_volume: f64;
    end_pressure: f64;
    exponent: i32;
    isochoric: bool;
    work: f64;
}

public machine pressure_at(stage: &Stage, volume: f64) -> f64 {
    let ratio: f64 = stage.volume / volume;
    transition stage.exponent {
        -1 -> rising(stage, ratio)
        0 -> constant(stage)
        2 -> square(stage, ratio)
        _ -> cube(stage, ratio)
    }
    machine rising(stage: &Stage, ratio: f64) -> f64 { stage.pressure / ratio }
    machine constant(stage: &Stage) -> f64 { stage.pressure }
    machine square(stage: &Stage, ratio: f64) -> f64 { stage.pressure * ratio * ratio }
    machine cube(stage: &Stage, ratio: f64) -> f64 { stage.pressure * ratio * ratio * ratio }
}

public machine evaluate(stage: &mut Stage) -> bool {
    transition stage.volume >= 0.25 && stage.volume <= 8.0
        && stage.end_volume >= 0.25 && stage.end_volume <= 8.0
        && stage.pressure > 0.0 && stage.pressure <= 64.0 {
        true -> kind(stage)
        _ -> reject()
    }
    machine kind(stage: &mut Stage) -> bool {
        transition stage.isochoric {
            true -> hold(stage)
            _ -> exponent(stage)
        }
    }
    machine hold(stage: &mut Stage) -> bool {
        stage.work = 0.0;
        stage.exponent = 0;
        transition stage.volume == stage.end_volume
            && stage.end_pressure > 0.0 && stage.end_pressure <= 64.0 {
            true -> accept()
            _ -> reject()
        }
    }
    machine exponent(stage: &mut Stage) -> bool {
        transition stage.exponent == -1 || stage.exponent == 0
            || stage.exponent == 2 || stage.exponent == 3 {
            true -> integrate(stage)
            _ -> reject()
        }
    }
    machine integrate(stage: &mut Stage) -> bool {
        stage.end_pressure = pressure_at(stage, stage.end_volume);
        transition stage.exponent {
            -1 -> rising_work(stage)
            0 -> constant_work(stage)
            2 -> square_work(stage)
            _ -> cube_work(stage)
        }
    }
    machine rising_work(stage: &mut Stage) -> bool {
        stage.work = (stage.end_pressure * stage.end_volume - stage.pressure * stage.volume) / 2.0;
        true
    }
    machine constant_work(stage: &mut Stage) -> bool {
        stage.work = stage.pressure * (stage.end_volume - stage.volume);
        true
    }
    machine square_work(stage: &mut Stage) -> bool {
        stage.work = stage.pressure * stage.volume - stage.end_pressure * stage.end_volume;
        true
    }
    machine cube_work(stage: &mut Stage) -> bool {
        stage.work = (stage.pressure * stage.volume - stage.end_pressure * stage.end_volume) / 2.0;
        true
    }
    machine accept() -> bool { true }
    machine reject() -> bool { false }
}

public machine near(left: f64, right: f64) -> bool {
    left - right <= 0.000000001 && right - left <= 0.000000001
}
