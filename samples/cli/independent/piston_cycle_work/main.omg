use omega::language::core::float_operations;
use omega_language_std::console;
use domain::model::Stage;
use domain::model::evaluate;
use domain::model::pressure_at;
use domain::model::near;
use domain::report::number;
use domain::report::integer;
use data::fixtures::count;
use data::fixtures::load;
use omega::language::core::binding;

// Select exactly one declared scenario with an ASCII digit then LF (or EOF).
// The application consumes at most three bytes and never silently truncates.
data Application {
    stage: Stage;
    selection: i32;
    previous_volume: f64;
    previous_pressure: f64;
    first_volume: f64;
    first_pressure: f64;
    expansion: f64;
    compression: f64;
    total: f64;
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console
crashes Trap
{
    let mut application: Application;
    let input: ByteRead = block Console::read_byte(&main.console);
    transition input {
        ByteRead::Byte { value } -> select(&main.console, &mut application, value)
        _ -> invalid(&main.console)
    }
    state select(console: &Binding<Console>, application: &mut Application, value: i32) {
        transition value >= 48 && value <= 57 {
            true -> delimiter(console, application, value)
            _ -> invalid(console)
        }
    }
    state delimiter(console: &Binding<Console>, application: &mut Application, value: i32) {
        let wrapped: i32 in Wrapping = value as i32 in Wrapping;
        application.selection = (wrapped - 48) as i32;
        let tail: ByteRead = block Console::read_byte(console);
        transition tail {
            ByteRead::Eof -> start(console, application)
            ByteRead::Byte { value: 10 } -> finish_input(console, application)
            _ -> invalid(console)
        }
    }
    state finish_input(console: &Binding<Console>, application: &mut Application) {
        let tail: ByteRead = block Console::read_byte(console);
        transition tail { ByteRead::Eof -> start(console, application) _ -> invalid(console) }
    }
    state start(console: &Binding<Console>, application: &mut Application) {
        Console::write_line(console, "piston_cycle_work: kPa,L,J; work by piston");
        Console::write_line(console, "stage,point,volume,pressure");
        transition { _ -> stage(console, application, 0) }
    }
    state stage(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        load(application.selection, index, &mut application.stage);
        let valid: bool = evaluate(&mut application.stage);
        transition valid { true -> boundary(console, application, index) _ -> invalid_stage(console) }
    }
    state boundary(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        transition index == 0 {
            true -> first(console, application, index)
            _ -> continuity(console, application, index)
        }
    }
    state first(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        application.first_volume = application.stage.volume;
        application.first_pressure = application.stage.pressure;
        transition { _ -> history(console, application, index) }
    }
    state continuity(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        transition near(application.previous_volume, application.stage.volume)
            && near(application.previous_pressure, application.stage.pressure) {
            true -> history(console, application, index)
            _ -> discontinuity(console)
        }
    }
    state history(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        row(console, index as i32, 0, application.stage.volume, application.stage.pressure);
        let volume: f64 = (application.stage.volume + application.stage.end_volume) / 2.0;
        transition application.stage.isochoric {
            true -> hold_middle(console, application, index, volume)
            _ -> model_middle(console, application, index, volume)
        }
    }
    state hold_middle(console: &Binding<Console>, application: &mut Application, index: u32, volume: f64) requires index <= 3 {
        row(console, index as i32, 1, volume, (application.stage.pressure + application.stage.end_pressure) / 2.0);
        transition { _ -> endpoint(console, application, index) }
    }
    state model_middle(console: &Binding<Console>, application: &mut Application, index: u32, volume: f64) requires index <= 3 {
        row(console, index as i32, 1, volume, pressure_at(&application.stage, volume));
        transition { _ -> endpoint(console, application, index) }
    }
    state endpoint(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        row(console, index as i32, 2, application.stage.end_volume, application.stage.end_pressure);
        Console::write(console, "work,"); integer(console, index as i32); Console::write(console, ",");
        number(console, application.stage.work); Console::write_line(console, "");
        application.total = application.total + application.stage.work;
        application.previous_volume = application.stage.end_volume;
        application.previous_pressure = application.stage.end_pressure;
        transition application.stage.work >= 0.0 {
            true -> expansion(console, application, index)
            _ -> compression(console, application, index)
        }
    }
    state expansion(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        application.expansion = application.expansion + application.stage.work;
        transition { _ -> next(console, application, index) }
    }
    state compression(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        application.compression = application.compression + application.stage.work;
        transition { _ -> next(console, application, index) }
    }
    state next(console: &Binding<Console>, application: &mut Application, index: u32) requires index <= 3 {
        let count: u32 = count(application.selection);
        transition index + 1 < count && index < 3 {
            true -> stage(console, application, index + 1)
            _ -> balance(console, application)
        }
    }
    state balance(console: &Binding<Console>, application: &mut Application) {
        Console::write(console, "balance,"); number(console, application.expansion); Console::write(console, ",");
        number(console, application.compression); Console::write(console, ","); number(console, application.total);
        Console::write_line(console, "");
        transition near(application.total, application.expansion + application.compression) {
            true -> closure(console, application)
            _ -> bad_balance(console)
        }
    }
    state closure(console: &Binding<Console>, application: &mut Application) {
        transition application.selection == 0 || application.selection == 1 {
            true -> closed(console, application)
            _ -> open(console)
        }
    }
    state closed(console: &Binding<Console>, application: &mut Application) {
        transition near(application.previous_volume, application.first_volume)
            && near(application.previous_pressure, application.first_pressure) {
            true -> complete(console)
            _ -> bad_balance(console)
        }
    }
    state complete(console: &Binding<Console>) { Console::write_line(console, "closed_cycle"); Console::exit_process(console, 0); }
    state open(console: &Binding<Console>) { Console::write_line(console, "open_stage"); Console::exit_process(console, 0); }
    state invalid(console: &Binding<Console>) { Console::write_line(console, "invalid_input"); Console::exit_process(console, 64); }
    state invalid_stage(console: &Binding<Console>) { Console::write_line(console, "invalid_stage"); Console::exit_process(console, 65); }
    state discontinuity(console: &Binding<Console>) { Console::write_line(console, "discontinuous_boundary"); Console::exit_process(console, 66); }
    state bad_balance(console: &Binding<Console>) { Console::write_line(console, "invalid_cycle_balance"); Console::exit_process(console, 67); }
}

machine row(console: &Binding<Console>, stage: i32, point: i32, volume: f64, pressure: f64) reaches Console
crashes Trap
{
    integer(console, stage); Console::write(console, ","); integer(console, point); Console::write(console, ",");
    number(console, volume); Console::write(console, ","); number(console, pressure); Console::write_line(console, "");
}
