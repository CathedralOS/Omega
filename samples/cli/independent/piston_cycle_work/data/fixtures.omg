use omega::language::core::float_operations;
module data::fixtures;
use domain::model::Stage;

// A bounded declared-stage inventory selected by one runtime ASCII digit.
public machine count(selection: i32) -> u32 {
    transition selection == 0 || selection == 1 || selection == 6 {
        true -> cycle()
        _ -> single()
    }
    machine cycle() -> u32 { 4 }
    machine single() -> u32 { 1 }
}

public machine load(selection: i32, index: u32, stage: &mut Stage) {
    stage.volume = 1.0;
    stage.pressure = 4.0;
    stage.end_volume = 2.0;
    stage.end_pressure = 4.0;
    stage.exponent = 0;
    stage.isochoric = false;
    stage.work = 0.0;
    transition selection {
        0 -> ordinary(index, stage)
        1 -> reverse(index, stage)
        2 -> square(stage)
        3 -> cube(stage)
        4 -> rising(stage)
        5 -> zero(stage)
        6 -> broken(index, stage)
        7 -> unsupported(stage)
        8 -> stationary(stage)
        _ -> reverse_square(stage)
    }
    machine reverse(index: u32, stage: &mut Stage) {
        transition index {
            0 -> reverse_hold(stage)
            1 -> low_expand(stage)
            2 -> reverse_low_hold(stage)
            _ -> high_compress(stage)
        }
    }
    machine reverse_hold(stage: &mut Stage) {
        stage.end_volume = 1.0; stage.end_pressure = 1.0;
        stage.isochoric = true;
    }
    machine low_expand(stage: &mut Stage) { stage.pressure = 1.0; }
    machine reverse_low_hold(stage: &mut Stage) {
        stage.volume = 2.0; stage.pressure = 1.0;
        stage.isochoric = true;
    }
    machine high_compress(stage: &mut Stage) {
        stage.volume = 2.0; stage.end_volume = 1.0;
    }
    machine square(stage: &mut Stage) {
        stage.pressure = 12.0; stage.end_volume = 3.0; stage.exponent = 2;
    }
    machine cube(stage: &mut Stage) { stage.pressure = 8.0; stage.exponent = 3; }
    machine rising(stage: &mut Stage) {
        stage.pressure = 2.0; stage.end_volume = 3.0; stage.exponent = -1;
    }
    machine zero(stage: &mut Stage) { stage.end_volume = 0.0; }
    machine ordinary(index: u32, stage: &mut Stage) { forward(index, stage); }
    machine broken(index: u32, stage: &mut Stage) {
        forward(index, stage);
        transition index == 2 { true -> gap(stage) _ -> done() }
    }
    machine gap(stage: &mut Stage) { stage.pressure = 2.0; }
    machine unsupported(stage: &mut Stage) { stage.exponent = 1; }
    machine stationary(stage: &mut Stage) { stage.end_volume = 1.0; stage.exponent = 2; }
    machine reverse_square(stage: &mut Stage) {
        stage.volume = 3.0; stage.pressure = 4.0 / 3.0;
        stage.end_volume = 1.0; stage.exponent = 2;
    }
    machine done() {}
}

machine forward(index: u32, stage: &mut Stage) {
        transition index {
            0 -> done()
            1 -> high_hold(stage)
            2 -> low_compress(stage)
            _ -> low_hold(stage)
        }
    machine high_hold(stage: &mut Stage) {
        stage.volume = 2.0; stage.end_volume = 2.0;
        stage.end_pressure = 1.0; stage.isochoric = true;
    }
    machine low_compress(stage: &mut Stage) {
        stage.volume = 2.0; stage.pressure = 1.0;
        stage.end_volume = 1.0;
    }
    machine low_hold(stage: &mut Stage) {
        stage.pressure = 1.0; stage.end_volume = 1.0;
        stage.isochoric = true;
    }
    machine done() {}
}
