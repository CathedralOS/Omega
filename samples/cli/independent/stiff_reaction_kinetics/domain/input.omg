use omega_language_std::console;
use omega::language::core::binding;

// The parser bounds bytes, tokens and magnitudes before arithmetic/storage.
pub data Input {
    values: [u64; 40] in Wrapping;
    count: u64;
    bytes: u64;
    number: u64 in Wrapping;
    active: bool;
    valid: bool;
    index: u64;
}

pub machine Input::read(input: &mut Input, console: &mut Binding<Console>)
invokes console;
reaches Console
blocks;
crashes Trap
{
    input.count = 0;
    input.bytes = 0;
    input.number = 0;
    input.active = false;
    input.valid = true;
    transition { _ -> scan(input, console) }
    state scan(input: &mut Input, console: &mut Binding<Console>) {
        transition input.bytes <= 4096 {
            true -> receive(input, console)
            false -> invalid(input)
        }
    }
    state receive(input: &mut Input, console: &mut Binding<Console>) {
        transition block console.read_byte() {
            ByteRead::Eof -> finish(input)
            ByteRead::Byte { value } -> classify(input, console, value)
        }
    }
    state classify(input: &mut Input, console: &mut Binding<Console>, value: i32) {
        transition input.bytes < 4096 {
            true -> byte(input, console, value)
            false -> invalid(input)
        }
    }
    state byte(input: &mut Input, console: &mut Binding<Console>, value: i32) {
        input.bytes = input.bytes + 1;
        transition {
            value >= 48 && value <= 57 -> digit(input, console, value)
            value == 32 || value == 9 || value == 10 || value == 13 -> separator(input, console)
            _ -> invalid(input)
        }
    }
    state digit(input: &mut Input, console: &mut Binding<Console>, value: i32) {
        input.number = input.number * 10 + ((value - 48) as u64 in Wrapping);
        input.active = true;
        transition input.number <= 1000000000000 {
            true -> scan(input, console)
            false -> invalid(input)
        }
    }
    state separator(input: &mut Input, console: &mut Binding<Console>) {
        Input::flush(input);
        transition input.valid { true -> scan(input, console) false -> done() }
    }
    state finish(input: &mut Input) { Input::flush(input); }
    state invalid(input: &mut Input) { input.valid = false; }
    state done() {}
}

machine Input::flush(input: &mut Input) {
    transition input.active && input.count < 40 {
        true -> store(input)
        false -> other(input)
    }
    state store(input: &mut Input) {
        input.values[input.count] = input.number;
        input.count = input.count + 1;
        input.number = 0;
        input.active = false;
    }
    state other(input: &mut Input) {
        transition input.active { true -> invalid(input) false -> done() }
    }
    state invalid(input: &mut Input) { input.valid = false; }
    state done() {}
}

