// A trial owns six Newton stage solves: one full and two half SDIRK2 steps.
// Only accepted two-half-step values update committed state. Rejection halves
// h without changing time/y. The order-two local error estimate divides the
// full versus fine difference by three; stage positivity is checked, never clipped.
use omega::language::core::float_operations;
use domain::model;
use domain::rates;
use domain::newton;
// Stiffly accurate, L-stable SDIRK2: gamma=1-1/sqrt(2),
// A=[[gamma,0],[1-gamma,gamma]], b=[1-gamma,gamma].
// Each stage reuses the backward-Euler residual/Jacobian owner.
machine dirk(problem: &Problem, initial: &Vector, step: f64) -> Newton {
    let first: Newton = implicit(problem, initial, 0.2928932188134524 * step);
    transition first.success {
        true -> second(problem, initial, first, step)
        false -> (first)
    }
    machine second(problem: &Problem, initial: &Vector, first: Newton, step: f64) -> Newton {
        let ratio: f64 = (1.0 - 0.2928932188134524) / 0.2928932188134524;
        let base: Vector = Vector {
            a: initial.a + ratio * (first.value.a - initial.a),
            b: initial.b + ratio * (first.value.b - initial.b),
            c: initial.c + ratio * (first.value.c - initial.c)
        };
        transition physical(&base) {
            true -> finish(problem, base, step)
            false -> failed(first)
        }
    }
    machine finish(problem: &Problem, base: Vector, step: f64) -> Newton {
        implicit(problem, &base, 0.2928932188134524 * step)
    }
    machine failed(first: Newton) -> Newton {
        let mut failure: Newton = first; failure.success = false; failure
    }
}
public data Solution [copy] { value: Vector; time: f64; step: f64; error: f64; mass_error: f64; accepted: u64; rejected: u64; attempts: u64; success: bool; full: Newton; half: Newton; fine: Newton; }
public machine integrate(problem: &Problem) -> Solution {
    let mut solution: Solution;
    solution.value = problem.initial; solution.step = problem.step;
    transition { _ -> advance(problem, solution) }
    machine advance(problem: &Problem, solution: Solution) -> Solution {
        transition solution.time >= problem.end { true -> complete(solution) false -> budget(problem, solution) }
    }
    machine budget(problem: &Problem, solution: Solution) -> Solution {
        transition solution.attempts < problem.trials && solution.attempts < 1000000 {
            true -> choose_step(problem, solution)
            false -> (solution)
        }
    }
    machine choose_step(problem: &Problem, solution: Solution) -> Solution {
        let mut next: Solution = solution;
        transition next.step > problem.end - next.time { true -> cap(problem, next) false -> usable(problem, next) }
    }
    machine cap(problem: &Problem, solution: Solution) -> Solution {
        let mut next: Solution = solution; next.step = problem.end - next.time;
        transition { _ -> usable(problem, next) }
    }
    machine usable(problem: &Problem, solution: Solution) -> Solution {
        transition solution.step > 1e-15 * (1.0 + solution.time) && solution.time + solution.step > solution.time {
            true -> trial(problem, solution)
            false -> (solution)
        }
    }
    machine trial(problem: &Problem, solution: Solution) -> Solution {
        let mut next: Solution = solution;
        next.attempts = next.attempts + 1;
        next.full = dirk(problem, &next.value, next.step);
        next.half = dirk(problem, &next.value, 0.5 * next.step);
        next.fine = dirk(problem, &next.half.value, 0.5 * next.step);
        transition next.full.success && next.half.success && next.fine.success { true -> estimate(problem, next) false -> reject(problem, next) }
    }
    machine estimate(problem: &Problem, solution: Solution) -> Solution {
        let mut next: Solution = solution;
        let difference: Vector = Vector { a: next.fine.value.a - next.full.value.a, b: next.fine.value.b - next.full.value.b, c: next.fine.value.c - next.full.value.c };
        next.error = norm(&difference, &next.fine.value, problem) / 3.0;
        transition next.error >= 0.0 && next.error <= 1.0 { true -> accept(problem, next) false -> reject(problem, next) }
    }
    machine accept(problem: &Problem, solution: Solution) -> Solution {
        transition solution.accepted < 1000000 { true -> commit(problem, solution) false -> (solution) }
    }
    machine commit(problem: &Problem, solution: Solution) -> Solution {
        let mut next: Solution = solution;
        next.time = next.time + next.step; next.value = next.fine.value;
        next.accepted = next.accepted + 1;
        let initial_mass: f64 = problem.initial.a + problem.initial.b + problem.initial.c;
        let mass_error: f64 = magnitude(next.value.a + next.value.b + next.value.c - initial_mass);
        next.mass_error = maximum(next.mass_error, mass_error);
        transition next.error < 0.1 { true -> grow(problem, next) false -> advance(problem, next) }
    }
    machine grow(problem: &Problem, solution: Solution) -> Solution { let mut next: Solution = solution; next.step = next.step * 2.0; transition { _ -> advance(problem, next) } }
    machine reject(problem: &Problem, solution: Solution) -> Solution {
        transition solution.rejected < 1000000 { true -> rollback(problem, solution) false -> (solution) }
    }
    machine rollback(problem: &Problem, solution: Solution) -> Solution { let mut next: Solution = solution; next.rejected = next.rejected + 1; next.step = next.step * 0.5; transition { _ -> advance(problem, next) } }
    machine complete(solution: Solution) -> Solution { let mut next: Solution = solution; next.success = true; next }
}
