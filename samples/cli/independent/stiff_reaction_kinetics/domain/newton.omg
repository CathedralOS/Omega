// Backward Euler solves y-y0-h*f(y)=0 with analytic mass-action Jacobian.
// Cofactor elimination is the fixed 3x3 linear solve; singular/nonfinite
// determinants fail the trial. Positivity damping never clips a concentration.
use omega::language::core::float_operations;
use domain::model;
use domain::rates;
public data Newton [copy] { value: Vector; residual: Vector; delta: Vector; field: Field; success: bool; iteration: u64; damping: f64; backtracks: u64; candidate: Vector; }
machine linear(newton: &mut Newton, step: f64) -> bool {
    let aa: f64 = 1.0 - step * newton.field.aa;
    let ab: f64 = 0.0 - step * newton.field.ab;
    let ac: f64 = 0.0 - step * newton.field.ac;
    let ba: f64 = 0.0 - step * newton.field.ba;
    let bb: f64 = 1.0 - step * newton.field.bb;
    let bc: f64 = 0.0 - step * newton.field.bc;
    let ca: f64 = 0.0 - step * newton.field.ca;
    let cb: f64 = 0.0 - step * newton.field.cb;
    let cc: f64 = 1.0 - step * newton.field.cc;
    let determinant: f64 = aa * (bb * cc - bc * cb) - ab * (ba * cc - bc * ca) + ac * (ba * cb - bb * ca);
    transition magnitude(determinant) > 1e-30 && magnitude(determinant) < 1e100 {
        true -> solve(newton, aa, ab, ac, ba, bb, bc, ca, cb, cc, determinant)
        false -> failed()
    }
    machine solve(newton: &mut Newton, aa: f64, ab: f64, ac: f64, ba: f64, bb: f64, bc: f64, ca: f64, cb: f64, cc: f64, determinant: f64) -> bool {
        let a: f64 = 0.0 - newton.residual.a;
        let b: f64 = 0.0 - newton.residual.b;
        let c: f64 = 0.0 - newton.residual.c;
        newton.delta.a = (a * (bb * cc - bc * cb) + b * (ac * cb - ab * cc) + c * (ab * bc - ac * bb)) / determinant;
        newton.delta.b = (a * (bc * ca - ba * cc) + b * (aa * cc - ac * ca) + c * (ac * ba - aa * bc)) / determinant;
        newton.delta.c = (a * (ba * cb - bb * ca) + b * (ab * ca - aa * cb) + c * (aa * bb - ab * ba)) / determinant;
        true
    }
    machine failed() -> bool { false }
}
public machine implicit(problem: &Problem, initial: &Vector, step: f64) -> Newton {
    let mut newton: Newton;
    newton.value = Vector { a: initial.a, b: initial.b, c: initial.c };
    transition { _ -> evaluate_guard(problem, initial, step, newton) }
    machine evaluate_guard(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        transition newton.iteration <= problem.iterations && newton.iteration <= 32 {
            true -> residual(problem, initial, step, newton)
            false -> (newton)
        }
    }
    machine residual(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        let mut next: Newton = newton;
        next.field = evaluate(problem, &next.value);
        next.residual = Vector { a: next.value.a - initial.a - step * next.field.a, b: next.value.b - initial.b - step * next.field.b, c: next.value.c - initial.c - step * next.field.c };
        transition norm(&next.residual, &next.value, problem) <= 0.01 && physical(&next.value) {
            true -> converged(next)
            false -> correction_guard(problem, initial, step, next)
        }
    }
    machine converged(newton: Newton) -> Newton { let mut next: Newton = newton; next.success = true; next }
    machine correction_guard(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        transition newton.iteration < problem.iterations && newton.iteration < 32 {
            true -> correction(problem, initial, step, newton)
            false -> (newton)
        }
    }
    machine correction(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        let mut next: Newton = newton;
        let solved: bool = linear(&mut next, step);
        next.damping = 1.0;
        next.backtracks = 0;
        transition solved { true -> damp(problem, initial, step, next) false -> (next) }
    }
    machine damp(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        let mut next: Newton = newton;
        next.candidate = Vector { a: next.value.a + next.damping * next.delta.a, b: next.value.b + next.damping * next.delta.b, c: next.value.c + next.damping * next.delta.c };
        transition physical(&next.candidate) { true -> update(problem, initial, step, next) false -> retry(problem, initial, step, next) }
    }
    machine retry(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        transition newton.backtracks < 12 { true -> shrink(problem, initial, step, newton) false -> (newton) }
    }
    machine shrink(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        let mut next: Newton = newton; next.damping = next.damping * 0.5; next.backtracks = next.backtracks + 1;
        transition { _ -> damp(problem, initial, step, next) }
    }
    machine update(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        let mut next: Newton = newton; next.value = next.candidate;
        transition next.iteration < 32 { true -> increment(problem, initial, step, next) false -> (next) }
    }
    machine increment(problem: &Problem, initial: &Vector, step: f64, newton: Newton) -> Newton {
        let mut next: Newton = newton; next.iteration = next.iteration + 1;
        transition { _ -> evaluate_guard(problem, initial, step, next) }
    }
}
