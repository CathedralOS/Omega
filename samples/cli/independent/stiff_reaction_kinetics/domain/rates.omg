// Mass-action source and analytic derivatives retain zero-concentration terms.
// Three species and reactions are a bounded storage contract, not named models.
use omega::language::core::float_operations;
use domain::model;
public data Field [copy] { a: f64; b: f64; c: f64; aa: f64; ab: f64; ac: f64; ba: f64; bb: f64; bc: f64; ca: f64; cb: f64; cc: f64; }
public machine magnitude(value: f64) -> f64 {
    transition value < 0.0 { true -> negative(value) false -> positive(value) }
    machine negative(value: f64) -> f64 { 0.0 - value }
    machine positive(value: f64) -> f64 { value }
}
public machine maximum(left: f64, right: f64) -> f64 { match left > right { true -> left false -> right } }
machine power(value: f64, order: u64) -> f64 { match order { 0 -> 1.0 1 -> value _ -> value * value } }
machine derivative(value: f64, order: u64) -> f64 { match order { 0 -> 0.0 1 -> 1.0 _ -> 2.0 * value } }
machine accumulate(reaction: &Reaction, value: &Vector, field: &mut Field) {
    let a: f64 = power(value.a, reaction.a);
    let b: f64 = power(value.b, reaction.b);
    let c: f64 = power(value.c, reaction.c);
    let rate: f64 = reaction.rate * a * b * c;
    let da: f64 = reaction.rate * derivative(value.a, reaction.a) * b * c;
    let db: f64 = reaction.rate * a * derivative(value.b, reaction.b) * c;
    let dc: f64 = reaction.rate * a * b * derivative(value.c, reaction.c);
    let first: f64 = F64::from_u64(reaction.p) - F64::from_u64(reaction.a);
    let second: f64 = F64::from_u64(reaction.q) - F64::from_u64(reaction.b);
    let third: f64 = F64::from_u64(reaction.r) - F64::from_u64(reaction.c);
    field.a = field.a + first * rate;
    field.aa = field.aa + first * da;
    field.ab = field.ab + first * db;
    field.ac = field.ac + first * dc;
    field.b = field.b + second * rate;
    field.ba = field.ba + second * da;
    field.bb = field.bb + second * db;
    field.bc = field.bc + second * dc;
    field.c = field.c + third * rate;
    field.ca = field.ca + third * da;
    field.cb = field.cb + third * db;
    field.cc = field.cc + third * dc;
}
public machine evaluate(problem: &Problem, value: &Vector) -> Field {
    let mut field: Field;
    accumulate(&problem.first, value, &mut field);
    accumulate(&problem.second, value, &mut field);
    accumulate(&problem.third, value, &mut field);
    field
}
public machine physical(value: &Vector) -> bool {
    value.a >= 0.0 && value.b >= 0.0 && value.c >= 0.0 && value.a < 1e100 && value.b < 1e100 && value.c < 1e100
}
public machine norm(value: &Vector, baseline: &Vector, problem: &Problem) -> f64 {
    let a: f64 = magnitude(value.a) / (problem.absolute + problem.relative * magnitude(baseline.a));
    let b: f64 = magnitude(value.b) / (problem.absolute + problem.relative * magnitude(baseline.b));
    let c: f64 = magnitude(value.c) / (problem.absolute + problem.relative * magnitude(baseline.c));
    transition a >= 0.0 && a < 1e100 && b >= 0.0 && b < 1e100 && c >= 0.0 && c < 1e100 {
        true -> finite(a, b, c)
        false -> invalid()
    }
    machine finite(a: f64, b: f64, c: f64) -> f64 { maximum(a, maximum(b, c)) }
    machine invalid() -> f64 { 1e100 }
}
