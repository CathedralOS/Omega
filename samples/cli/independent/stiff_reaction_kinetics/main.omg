// Expected exit: 2. Empty stdin is invalid; valid input returns 0.
// Expected output contains: INVALID reaction input
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::float_operations;
use domain::input;
use domain::model;
use domain::rates;
use domain::integrate;
use domain::report;
data Main { input: Input; problem: Problem; solution: Solution; }
machine Main::main(main: &mut Main) reaches Console {
    block Input::read(&mut main.input);
    transition valid(&main.input) { true -> prepare(main) false -> invalid(main) }
    state prepare(main: &mut Main) {
        main.problem = problem(&main.input);
        transition physical(&main.problem.initial) && main.problem.initial.a + main.problem.initial.b + main.problem.initial.c <= 1000000.0 && main.problem.end <= 1000000.0 && main.problem.absolute > 0.0 && main.problem.relative > 0.0 && main.problem.relative <= 1.0 {
            true -> solve(main) false -> invalid(main)
        }
    }
    state solve(main: &mut Main) {
        main.solution = integrate(&main.problem);
        transition main.solution.success { true -> report(main) false -> exhausted(main) }
    }
    state report(main: &mut Main) {
        Console::write_line("stiff_reaction_kinetics units=1e-12");
        scaled(main.solution.time); Console::write(" ");
        scaled(main.solution.value.a); Console::write(" ");
        scaled(main.solution.value.b); Console::write(" ");
        scaled(main.solution.value.c); Console::write(" ");
        scaled(main.solution.mass_error); Console::write_line("");
        integer64(narrow_u64_to_i64_saturating(main.solution.accepted)); Console::write(" ");
        integer64(narrow_u64_to_i64_saturating(main.solution.rejected)); Console::write_line("");
    }
    state invalid(main: &mut Main) { Console::write_line("INVALID reaction input"); Console::exit_process(2); }
    state exhausted(main: &mut Main) { Console::write_line("EXHAUSTED integration convergence"); Console::exit_process(3); }
}
