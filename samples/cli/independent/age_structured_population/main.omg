use omega_language_std::console;
use demography::model;
use demography::input;
use demography::report;
use demography::oracles;
// The ordinary sample harness supplies empty stdin; reject that input honestly.
// Expected exit: 2.
// Expected output contains: ERROR invalid input
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let verified: bool = reference_checks();
    transition verified { true -> read_input() false -> oracle_error() }
    state oracle_error() { Console::write_line("ERROR internal oracle"); Console::exit_process(4); }
    state read_input() {
        let steps: Parsed = block read_number();
        let newborn: Parsed = block read_number();
        let juvenile: Parsed = block read_number();
        let adult: Parsed = block read_number();
        let survival0: Parsed = block read_number();
        let survival1: Parsed = block read_number();
        let survival2: Parsed = block read_number();
        let fertility0: Parsed = block read_number();
        let fertility1: Parsed = block read_number();
        let fertility2: Parsed = block read_number();
        let migration0: Parsed = block read_number();
        let migration1: Parsed = block read_number();
        let migration2: Parsed = block read_number();
        let complete: bool = block input_complete();
        let census: Census = Census { newborn: newborn.value, juvenile: juvenile.value, adult: adult.value };
        let schedule: Schedule = Schedule { survival0: survival0.value, survival1: survival1.value, survival2: survival2.value, fertility0: fertility0.value, fertility1: fertility1.value, fertility2: fertility2.value, migration0: migration0.value, migration1: migration1.value, migration2: migration2.value };
        transition steps.valid && newborn.valid && juvenile.valid && adult.valid && survival0.valid && survival1.valid && survival2.valid && fertility0.valid && fertility1.valid && fertility2.valid && migration0.valid && migration1.valid && migration2.valid && complete && steps.value >= 0 && steps.value <= 32 && valid_census(&census) && valid_schedule(&schedule) {
            true -> forecast(census, schedule, steps.value)
            false -> invalid()
        }
    }
    state invalid() { Console::write_line("ERROR invalid input"); Console::exit_process(2); }
    state forecast(census: Census, schedule: Schedule, steps: i64 in Wrapping) {
        Console::write_line("year,newborn,juvenile,adult,total,births,deaths,migration");
        let initial: Balance = Balance { births: 0, deaths: 0, migration: 0, before: total(&census), after: total(&census) };
        row(0, &census, &initial);
        transition { _ -> cycle(census, schedule, steps, 0) }
    }
    state cycle(census: Census, schedule: Schedule, steps: i64 in Wrapping, year: i64 in Wrapping) {
        transition year < steps { true -> step(census, schedule, steps, year) false -> done() }
    }
    state step(census: Census, schedule: Schedule, steps: i64 in Wrapping, year: i64 in Wrapping) {
        let mut next: Census = census;
        let balance: Balance = advance(&mut next, &schedule);
        transition valid_census(&next) && balance.after == balance.before + balance.births - balance.deaths + balance.migration {
            true -> publish(next, schedule, steps, year + 1, balance)
            false -> infeasible()
        }
    }
    state publish(census: Census, schedule: Schedule, steps: i64 in Wrapping, year: i64 in Wrapping, balance: Balance) {
        row(year, &census, &balance);
        transition { _ -> cycle(census, schedule, steps, year) }
    }
    state infeasible() { Console::write_line("ERROR infeasible cohort"); Console::exit_process(3); }
    state done() { Console::exit_process(0); }
}
