// Executable startup checks consume independently frozen fixture integers.
// They attest recurrence values through Terminal's supported exit comparison;
// they never replace the supplied-input forecast or derive expected results.
use demography::model;
public machine reference_checks() -> bool {
    let mut verified: bool = true;
    let mut births_census: Census = Census { newborn: 80, juvenile: 40, adult: 20 };
    let births_schedule: Schedule = Schedule { survival0: 500, survival1: 750, survival2: 500, fertility0: 0, fertility1: 250, fertility2: 500, migration0: 0, migration1: 0, migration2: 0 };
    let births_year1: Balance = advance(&mut births_census, &births_schedule);
    verified = verified && births_census.newborn == 20 && births_census.juvenile == 40 && births_census.adult == 40 && births_year1.births == 20 && births_year1.deaths == 60 && births_year1.migration == 0 && births_year1.before == 140 && births_year1.after == 100;
    let births_year2: Balance = advance(&mut births_census, &births_schedule);
    verified = verified && births_census.newborn == 30 && births_census.juvenile == 10 && births_census.adult == 50 && births_year2.births == 30 && births_year2.deaths == 40 && births_year2.migration == 0 && births_year2.before == 100 && births_year2.after == 90;
    let births_year3: Balance = advance(&mut births_census, &births_schedule);
    verified = verified && births_census.newborn == 27 && births_census.juvenile == 15 && births_census.adult == 32 && births_year3.births == 27 && births_year3.deaths == 43 && births_year3.migration == 0 && births_year3.before == 90 && births_year3.after == 74;
    let births_year4: Balance = advance(&mut births_census, &births_schedule);
    verified = verified && births_census.newborn == 19 && births_census.juvenile == 13 && births_census.adult == 27 && births_year4.births == 19 && births_year4.deaths == 34 && births_year4.migration == 0 && births_year4.before == 74 && births_year4.after == 59;
    let mut fractional_census: Census = Census { newborn: 7, juvenile: 5, adult: 3 };
    let fractional_schedule: Schedule = Schedule { survival0: 333, survival1: 667, survival2: 500, fertility0: 100, fertility1: 250, fertility2: 333, migration0: 1, migration1: 0, migration2: 0 };
    let fractional_year1: Balance = advance(&mut fractional_census, &fractional_schedule);
    verified = verified && fractional_census.newborn == 3 && fractional_census.juvenile == 2 && fractional_census.adult == 4 && fractional_year1.births == 2 && fractional_year1.deaths == 9 && fractional_year1.migration == 1 && fractional_year1.before == 15 && fractional_year1.after == 9;
    let fractional_year2: Balance = advance(&mut fractional_census, &fractional_schedule);
    verified = verified && fractional_census.newborn == 3 && fractional_census.juvenile == 0 && fractional_census.adult == 3 && fractional_year2.births == 2 && fractional_year2.deaths == 6 && fractional_year2.migration == 1 && fractional_year2.before == 9 && fractional_year2.after == 6;
    let fractional_year3: Balance = advance(&mut fractional_census, &fractional_schedule);
    verified = verified && fractional_census.newborn == 2 && fractional_census.juvenile == 0 && fractional_census.adult == 1 && fractional_year3.births == 1 && fractional_year3.deaths == 5 && fractional_year3.migration == 1 && fractional_year3.before == 6 && fractional_year3.after == 3;
    let fractional_year4: Balance = advance(&mut fractional_census, &fractional_schedule);
    verified = verified && fractional_census.newborn == 1 && fractional_census.juvenile == 0 && fractional_census.adult == 0 && fractional_year4.births == 0 && fractional_year4.deaths == 3 && fractional_year4.migration == 1 && fractional_year4.before == 3 && fractional_year4.after == 1;
    let mut migration_census: Census = Census { newborn: 20, juvenile: 10, adult: 8 };
    let migration_schedule: Schedule = Schedule { survival0: 1000, survival1: 1000, survival2: 1000, fertility0: 0, fertility1: 0, fertility2: 0, migration0: 3, migration1: -2, migration2: 1 };
    let migration_year1: Balance = advance(&mut migration_census, &migration_schedule);
    verified = verified && migration_census.newborn == 3 && migration_census.juvenile == 18 && migration_census.adult == 19 && migration_year1.births == 0 && migration_year1.deaths == 0 && migration_year1.migration == 2 && migration_year1.before == 38 && migration_year1.after == 40;
    let migration_year2: Balance = advance(&mut migration_census, &migration_schedule);
    verified = verified && migration_census.newborn == 3 && migration_census.juvenile == 1 && migration_census.adult == 38 && migration_year2.births == 0 && migration_year2.deaths == 0 && migration_year2.migration == 2 && migration_year2.before == 40 && migration_year2.after == 42;
    let migration_year3: Balance = advance(&mut migration_census, &migration_schedule);
    verified = verified && migration_census.newborn == 3 && migration_census.juvenile == 1 && migration_census.adult == 40 && migration_year3.births == 0 && migration_year3.deaths == 0 && migration_year3.migration == 2 && migration_year3.before == 42 && migration_year3.after == 44;
    let mut net_emigration_census: Census = Census { newborn: 10, juvenile: 10, adult: 10 };
    let net_emigration_schedule: Schedule = Schedule { survival0: 1000, survival1: 1000, survival2: 1000, fertility0: 0, fertility1: 0, fertility2: 0, migration0: 0, migration1: -2, migration2: -1 };
    let net_emigration_year1: Balance = advance(&mut net_emigration_census, &net_emigration_schedule);
