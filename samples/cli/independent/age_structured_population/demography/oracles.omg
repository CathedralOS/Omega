    let mut final_births_census: Census = Census { newborn: 0, juvenile: 0, adult: 10 };
    let final_births_schedule: Schedule = Schedule { survival0: 0, survival1: 0, survival2: 0, fertility0: 0, fertility1: 0, fertility2: 500, migration0: 0, migration1: 0, migration2: 0 };
    let final_births_year1: Balance = advance(&mut final_births_census, &final_births_schedule);
    verified = verified && final_births_census.newborn == 5 && final_births_census.juvenile == 0 && final_births_census.adult == 0 && final_births_year1.births == 5 && final_births_year1.deaths == 10 && final_births_year1.migration == 0 && final_births_year1.before == 10 && final_births_year1.after == 5;
    let final_births_year2: Balance = advance(&mut final_births_census, &final_births_schedule);
    verified = verified && final_births_census.newborn == 0 && final_births_census.juvenile == 0 && final_births_census.adult == 0 && final_births_year2.births == 0 && final_births_year2.deaths == 5 && final_births_year2.migration == 0 && final_births_year2.before == 5 && final_births_year2.after == 0;
    let mut terminal_age_census: Census = Census { newborn: 0, juvenile: 0, adult: 15 };
    let terminal_age_schedule: Schedule = Schedule { survival0: 1000, survival1: 1000, survival2: 1000, fertility0: 0, fertility1: 0, fertility2: 0, migration0: 0, migration1: 0, migration2: 0 };
    let terminal_age_year1: Balance = advance(&mut terminal_age_census, &terminal_age_schedule);
    verified = verified && terminal_age_census.newborn == 0 && terminal_age_census.juvenile == 0 && terminal_age_census.adult == 15 && terminal_age_year1.births == 0 && terminal_age_year1.deaths == 0 && terminal_age_year1.migration == 0 && terminal_age_year1.before == 15 && terminal_age_year1.after == 15;
    let terminal_age_year2: Balance = advance(&mut terminal_age_census, &terminal_age_schedule);
    verified = verified && terminal_age_census.newborn == 0 && terminal_age_census.juvenile == 0 && terminal_age_census.adult == 15 && terminal_age_year2.births == 0 && terminal_age_year2.deaths == 0 && terminal_age_year2.migration == 0 && terminal_age_year2.before == 15 && terminal_age_year2.after == 15;
    let terminal_age_year3: Balance = advance(&mut terminal_age_census, &terminal_age_schedule);
    verified = verified && terminal_age_census.newborn == 0 && terminal_age_census.juvenile == 0 && terminal_age_census.adult == 15 && terminal_age_year3.births == 0 && terminal_age_year3.deaths == 0 && terminal_age_year3.migration == 0 && terminal_age_year3.before == 15 && terminal_age_year3.after == 15;
    verified
}
