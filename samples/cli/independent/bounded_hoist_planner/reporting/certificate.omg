use omega_language_std::console;
use clearance::model;

// Fixed-width decimal keeps every output field easy to compare as raw bytes.
machine number(value: i32 in Saturating) reaches Console
invokes Console;
{
    Console::write_byte(((value / 100) % 10 + 48) as i32);
    Console::write_byte(((value / 10) % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
    Console::write_byte(10);
}

machine number5(value: i32 in Saturating) reaches Console
invokes Console;
{
    Console::write_byte(((value / 10000) % 10 + 48) as i32);
    Console::write_byte(((value / 1000) % 10 + 48) as i32);
    Console::write_byte(((value / 100) % 10 + 48) as i32);
    Console::write_byte(((value / 10) % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
    Console::write_byte(10);
}

pub machine report(certificate: &Certificate) reaches Console
invokes Console;
{
    Console::write_line("clearance_route_planner: synthetic span-height clearance model");
    Console::write_line("explored_words"); number5(10000);
    Console::write_line("feasible_profiles"); number5(certificate.feasible);
    Console::write_line("optimal_ties"); number5(certificate.ties);
    transition certificate.ties > 0 {
        true -> optimal(certificate)
        false -> infeasible()
    }
    state infeasible() {
        Console::write_line("INFEASIBLE");
        Console::exit_process(2);
    }
    state optimal(certificate: &Certificate) {
        Console::write_line("OPTIMAL minimum_vertical_travel lexicographic_profile");
        Console::write_line("vertical_travel"); number(certificate.best.cost);
        Console::write_line("profile span_1 span_2 span_3 span_4");
        number(certificate.best.heights[0]);
        number(certificate.best.heights[1]);
        number(certificate.best.heights[2]);
        number(certificate.best.heights[3]);
        Console::write_line("final_height"); number(certificate.best.heights[3]);
        Console::exit_process(0);
    }
}
