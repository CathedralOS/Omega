// With closed stdin the application rejects the missing record.
// Expected exit: 64.
// Expected output contains: INVALID: expected
use omega_language_std::console;
use clearance::model;
use clearance::search;
use input::parse;
use reporting::certificate;

data Clearance {
    input: [u8; 11];
    plan: Plan;
    certificate: Certificate;
}

machine Clearance::main(clearance: &mut Clearance) reaches Console {
    let read: LineReadResult = block Console::read_line(&mut clearance.input);
    transition read {
        LineReadResult::LineComplete { count } -> newline(clearance, count)
        LineReadResult::EndOfInput { count } -> eof(clearance, count)
        _ -> invalid(clearance)
    }
    machine newline(clearance: &mut Clearance, count: u64) {
        transition count == 11 && clearance.input[10] == 10 {
            true -> decode(clearance)
            false -> invalid(clearance)
        }
    }
    machine eof(clearance: &mut Clearance, count: u64) {
        transition count == 10 {
            true -> decode(clearance)
            false -> invalid(clearance)
        }
    }
    machine decode(clearance: &mut Clearance) {
        let valid: bool = parse(&clearance.input, &mut clearance.plan);
        transition valid {
            true -> route(clearance)
            false -> invalid(clearance)
        }
    }
    machine route(clearance: &mut Clearance) {
        solve(&clearance.plan, &mut clearance.certificate);
        report(&clearance.certificate);
    }
    machine invalid(clearance: &mut Clearance) {
        Console::write_line("INVALID: expected H0 HE F1 C1 F2 C2 F3 C3 F4 C4, ten digits; each floor<=ceiling");
        Console::exit_process(64);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Clearance;
    block Clearance::main(&mut entry_storage);
}
