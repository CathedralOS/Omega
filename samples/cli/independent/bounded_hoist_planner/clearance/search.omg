// Exhaust all 10^4 height words, independently testing each word's four spans.
// A feasible word keeps every height inside its span's [floor, ceiling], limits
// each hoist step to four units, and ends at the required height. The word code
// orders profiles lexicographically; retain the first tied optimum.
use clearance::model;

// Each extracted digit is below ten; the guard before the Exact narrowing to
// i32 authorizes the conversion, matching the route-event convention.
machine digit(code: u64 in Wrapping, divisor: u64 in Wrapping) -> i32 in Saturating {
    transition divisor > 0 {
        true -> divide(code, divisor)
        false -> undefined()
    }
    machine divide(code: u64 in Wrapping, divisor: u64 in Wrapping) -> i32 in Saturating {
        ((code / divisor) % 10) as i32 in Saturating
    }
    machine undefined() -> i32 in Saturating { 0 }
}

public machine solve(plan: &Plan, certificate: &mut Certificate) {
    certificate.feasible = 0;
    certificate.ties = 0;
    transition { _ -> enumerate(plan, certificate, 0) }
    machine enumerate(plan: &Plan, certificate: &mut Certificate, code: u64) {
        transition code < 10000 {
            true -> candidate(plan, certificate, code)
            false -> done()
        }
    }
    machine candidate(plan: &Plan, certificate: &mut Certificate, code: u64) {
        let mut travel: Travel;
        travel.heights[0] = digit(code as u64 in Wrapping, 1000);
        travel.heights[1] = digit(code as u64 in Wrapping, 100);
        travel.heights[2] = digit(code as u64 in Wrapping, 10);
        travel.heights[3] = digit(code as u64 in Wrapping, 1);
        let valid: bool = evaluate(plan, &mut travel);
        transition valid {
            true -> feasible(plan, certificate, code, &travel)
            false -> next(plan, certificate, code)
        }
    }
    machine feasible(plan: &Plan, certificate: &mut Certificate, code: u64, travel: &Travel) {
        certificate.feasible = certificate.feasible + 1;
        transition certificate.ties == 0 || travel.cost < certificate.best.cost {
            true -> better(plan, certificate, code, travel)
            false -> compare(plan, certificate, code, travel)
        }
    }
    machine better(plan: &Plan, certificate: &mut Certificate, code: u64, travel: &Travel) {
        certificate.ties = 1;
        certificate.code = code;
        certificate.best.cost = travel.cost;
        certificate.best.heights[0] = travel.heights[0];
        certificate.best.heights[1] = travel.heights[1];
        certificate.best.heights[2] = travel.heights[2];
        certificate.best.heights[3] = travel.heights[3];
        transition { _ -> next(plan, certificate, code) }
    }
    machine compare(plan: &Plan, certificate: &mut Certificate, code: u64, travel: &Travel) {
        transition travel.cost == certificate.best.cost {
            true -> tied(plan, certificate, code)
            false -> next(plan, certificate, code)
        }
    }
    machine tied(plan: &Plan, certificate: &mut Certificate, code: u64) {
        certificate.ties = certificate.ties + 1;
        transition { _ -> next(plan, certificate, code) }
    }
    machine next(plan: &Plan, certificate: &mut Certificate, code: u64) {
        transition code < 10000 {
            true -> enumerate(plan, certificate, code + 1)
            false -> done()
        }
    }
    machine done() { }
}

machine evaluate(plan: &Plan, travel: &mut Travel) -> bool {
    transition { _ -> admit(plan, travel, 0, plan.start, 0) }
    machine admit(plan: &Plan, travel: &mut Travel, index: u64, previous: i32 in Saturating, cost: i32 in Saturating) -> bool {
        transition index < 4 {
            true -> span(plan, travel, index, previous, cost)
            false -> finish(plan, travel, cost)
        }
    }
    machine span(plan: &Plan, travel: &mut Travel, index: u64, previous: i32 in Saturating, cost: i32 in Saturating) -> bool {
        let height: i32 in Saturating = travel.heights[index];
        let inside: bool = plan.floors[index] <= height && height <= plan.ceilings[index];
        let step: i32 in Saturating = difference(height, previous);
        transition inside && step <= 4 {
            true -> admit(plan, travel, index + 1, height, cost + step)
            false -> false
        }
    }
    machine finish(plan: &Plan, travel: &mut Travel, cost: i32 in Saturating) -> bool {
        travel.cost = cost;
        travel.heights[3] == plan.end
    }
}

machine difference(a: i32 in Saturating, b: i32 in Saturating) -> i32 in Saturating {
    transition a > b {
        true -> result(a - b)
        false -> result(b - a)
    }
    machine result(value: i32 in Saturating) -> i32 in Saturating { value }
}
