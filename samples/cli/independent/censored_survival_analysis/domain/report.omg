use domain::input;
use domain::model;
use omega::language::core::numeric_conversion;
use omega_language_std::console;
use omega::language::core::float_operations;

// The measured extent is supplied by a checked contract, independently of the
// array's capacity. This reusable view accessor also accepts empty slices.
machine extent(values: &[f64]) -> u64 ensures result == values.len { values.len }
machine row_value(values: &[f64], index: u32) -> f64 {
    let count: u64 = extent(values);
    transition index < count { true -> (values[index]) false -> 0.0 }
}

// Decimal byte output avoids imposing a text-domain proof on dynamic numbers.
pub machine integer(reader: &mut Reader, value: i64)
reaches Console
invokes Console;
{
    let widened: i64 = value;
    transition widened < 0 {
        true -> negative(reader, widened)
        _ -> digits(reader, widened)
    }
    state negative(reader: &mut Reader, value: i64) {
        Console::write_byte(45);
        let absolute: i64 in Wrapping = 0 - (value as i64 in Wrapping);
        transition { _ -> digits(reader, absolute as i64) }
    }
    state digits(reader: &mut Reader, value: i64) {
        transition { _ -> seek(reader, value as i64 in Wrapping, 1) }
    }
    state seek(reader: &mut Reader, value: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 && divisor <= value / 10 {
            true -> seek(reader, value, divisor * 10)
            _ -> ready(reader, value, divisor)
        }
    }
    state ready(reader: &mut Reader, value: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 {
            true -> emit(reader, value, divisor)
            _ -> {}
        }
    }
    state emit(reader: &mut Reader, value: i64 in Wrapping, divisor: i64 in Wrapping)
    requires divisor > 0
    {
        let byte: i64 in Wrapping = (value / divisor) % 10 + 48;
        Console::write_byte(narrow_i64_to_i32_wrapping(byte as i64));
        transition divisor > 1 {
            true -> ready(reader, value, divisor / 10)
            _ -> {}
        }
    }
}
machine real(reader: &mut Reader, value: f64) reaches Console {
    let scaled: i64 in Saturating = I64::from_f64(value * 1000000000000.0 + 0.5);
    let amount: i64 in Wrapping = scaled as i64 in Wrapping;
    integer(reader, (amount / 1000000000000) as i64);
    Console::write_byte(46);
    transition { _ -> fraction(reader, amount % 1000000000000, 100000000000) }
    state fraction(reader: &mut Reader, amount: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 { true -> digit(reader, amount, divisor) false -> {} }
    }
    state digit(reader: &mut Reader, amount: i64 in Wrapping, divisor: i64 in Wrapping)
    requires divisor > 0
    {
        Console::write_byte(narrow_i64_to_i32_wrapping(((amount / divisor) % 10 + 48) as i64));
        transition { _ -> fraction(reader, amount, divisor / 10) }
    }
}
pub machine report(reader: &mut Reader, group: i32 in Wrapping, table: &Table) reaches Console
invokes Console;
{
    Console::write("TABLE "); integer(reader, group as i64); Console::write_line("");
    transition { _ -> row(reader, table, 0) }
    state row(reader: &mut Reader, table: &Table, index: i32 in Wrapping) {
        transition index >= 0 && index < 32 && index < table.count {
            true -> emit(reader, table, index)
            false -> median(reader, table)
        }
    }
    state emit(reader: &mut Reader, table: &Table, index: i32 in Wrapping)
    requires index >= 0 && index < 32
    {
        let position: u32 = narrow_i32_to_u32_wrapping(index as i32) as u32;
        Console::write("ROW "); real(reader, row_value(&table.time[..], position)); Console::write(" ");
        integer(reader, table.risk[index] as i64); Console::write(" ");
        integer(reader, table.event[index] as i64); Console::write(" ");
        integer(reader, table.censor[index] as i64); Console::write(" ");
        real(reader, row_value(&table.survival[..], position)); Console::write(" ");
        real(reader, row_value(&table.variance[..], position)); Console::write(" ");
        integer(reader, table.zero[index] as i64); Console::write_line("");
        transition { _ -> row(reader, table, index + 1) }
    }
    state median(reader: &mut Reader, table: &Table) {
        Console::write("MEDIAN "); integer(reader, table.median_status as i64); Console::write(" "); real(reader, table.median); Console::write(" "); integer(reader, table.count as i64); Console::write_line("");
    }
}
pub machine logrank_report(reader: &mut Reader, result: &Logrank) reaches Console
invokes Console;
{
    Console::write("LOGRANK "); real(reader, result.observed); Console::write(" "); real(reader, result.expected); Console::write(" "); real(reader, result.variance); Console::write(" "); real(reader, result.statistic); Console::write(" "); integer(reader, result.status as i64); Console::write_line("");
}
