// Synthetic survival analysis; empty stdin is refused.
// Expected exit: 2.
// Expected output contains: ERROR invalid input
use domain::input;
use domain::model;
use domain::solver;
use domain::report;
use omega_language_std::console;
use omega::language::core::float_operations;

data Main { reader: Reader; records: Records; table: Table; logrank: Logrank; }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let count: Number = block number(&mut main.reader);
    let integer: i32 in Saturating = I32::from_f64(count.value);
    transition count.valid && count.value >= 1.0 && count.value <= 32.0 && F64::from_i32(integer as i32) == count.value {
        true -> configure(main, integer as i32 in Wrapping)
        false -> invalid(main)
    }
    state configure(main: &mut Main, count: i32 in Wrapping) {
        main.records.count = count;
        transition { _ -> read(main, 0) }
    }
    state read(main: &mut Main, index: i32 in Wrapping) {
        transition index >= 0 && index < 32 && index < main.records.count {
            true -> record(main, index)
            false -> end(main)
        }
    }
    state record(main: &mut Main, index: i32 in Wrapping)
    requires index >= 0 && index < 32
    {
        let time: Number = block number(&mut main.reader);
        let event: Number = block number(&mut main.reader);
        let group: Number = block number(&mut main.reader);
        transition time.valid && event.valid && group.valid && time.value >= 0.0 && (event.value == 0.0 || event.value == 1.0) && (group.value == 0.0 || group.value == 1.0) {
            true -> store(main, index, time.value, event.value, group.value)
            false -> invalid(main)
        }
    }
    state store(main: &mut Main, index: i32 in Wrapping, time: f64, event: f64, group: f64)
    requires index >= 0 && index < 32
    {
        main.records.time[index] = time;
        let event_integer: i32 in Saturating = I32::from_f64(event);
        let group_integer: i32 in Saturating = I32::from_f64(group);
        main.records.event[index] = event_integer as i32;
        main.records.group[index] = group_integer as i32;
        transition { _ -> read(main, index + 1) }
    }
    state end(main: &mut Main) {
        let complete: bool = block ended(&mut main.reader);
        transition complete { true -> calculate(main, -1) false -> invalid(main) }
    }
    state calculate(main: &mut Main, group: i32 in Wrapping) {
        analyze(&main.records, group, &mut main.table, &mut main.logrank);
        report(&mut main.reader, group, &main.table);
        transition group < 1 { true -> calculate(main, group + 1) false -> done(main) }
    }
    state done(main: &mut Main) {
        logrank_report(&mut main.reader, &main.logrank);
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) { Console::write_line("ERROR invalid input"); Console::exit_process(2); }
}
