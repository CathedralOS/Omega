use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;
pub data Input {
 values: [f64; 67]; count: u64 in Wrapping; bytes: u64 in Wrapping; length: u64 in Wrapping;
 token: [i32 in Wrapping; 64]; valid: bool;
}
pub machine Input::read(input: &mut Input)
invokes Console; reaches Console blocks; crashes Trap {
 input.count = 0; input.bytes = 0; input.length = 0; input.valid = true;
 transition { _ -> receive(input) }
 state receive(input: &mut Input) {
  transition block Console::read_byte() {
   ByteRead::Eof -> finish(input)
   ByteRead::Byte { value } -> bound(input, value as i32 in Wrapping)
  }
 }
 state bound(input: &mut Input, value: i32 in Wrapping) {
  transition input.bytes < 4096 { true -> byte(input, value) false -> invalid(input) }
 }
 state byte(input: &mut Input, value: i32 in Wrapping) {
  input.bytes = input.bytes + 1;
  transition value == 32 || value == 9 || value == 10 || value == 13 {
   true -> flush(input) false -> token_bound(input, value)
  }
 }
 state token_bound(input: &mut Input, value: i32 in Wrapping) {
  transition input.length < 64 { true -> store(input, value) false -> invalid(input) }
 }
 state store(input: &mut Input, value: i32 in Wrapping) {
  input.token[input.length] = value; input.length = input.length + 1;
  transition { _ -> receive(input) }
 }
 state flush(input: &mut Input) {
  Input::flush(input);
  transition input.valid { true -> receive(input) false -> done() }
 }
 state finish(input: &mut Input) { Input::flush(input); }
 state invalid(input: &mut Input) { input.valid = false; }
 state done() {}
}
machine Input::flush(input: &mut Input) {
 transition input.length > 0 { true -> capacity(input) false -> done() }
 state capacity(input: &mut Input) {
  transition input.count < 67 { true -> start(input) false -> invalid(input) }
 }
 state start(input: &mut Input) {
  transition input.token[0] == 45 || input.token[0] == 43 {
   true -> mantissa(input, 1, 0.0, input.token[0] == 45, false, 0, 0)
   false -> mantissa(input, 0, 0.0, false, false, 0, 0)
  }
 }
 state mantissa(input: &mut Input, index: u64 in Wrapping, value: f64, negative: bool, dot: bool, digits: u64 in Wrapping, fraction: u64 in Wrapping) {
  transition index < input.length && index < 64 {
   true -> character(input, index, value, negative, dot, digits, fraction)
   false -> end_mantissa(input, value, negative, digits, fraction)
  }
 }
 state character(input: &mut Input, index: u64 in Wrapping, value: f64, negative: bool, dot: bool, digits: u64 in Wrapping, fraction: u64 in Wrapping) {
  let byte: i32 in Wrapping = input.token[index];
  transition {
   byte >= 48 && byte <= 57 -> digit(input, index, value, negative, dot, digits, fraction, byte)
   byte == 46 && !dot -> mantissa(input, index + 1, value, negative, true, digits, fraction)
   digits > 0 && (byte == 101 || byte == 69) -> exponent_sign(input, index + 1, value, negative, fraction)
   _ -> invalid(input)
  }
 }
 state digit(input: &mut Input, index: u64 in Wrapping, value: f64, negative: bool, dot: bool, digits: u64 in Wrapping, fraction: u64 in Wrapping, byte: i32 in Wrapping) {
  let next: f64 = value * 10.0 + F64::from_i32(byte - 48);
  transition dot {
   true -> mantissa(input, index + 1, next, negative, dot, digits + 1, fraction + 1)
   false -> mantissa(input, index + 1, next, negative, dot, digits + 1, fraction)
  }
 }
 state end_mantissa(input: &mut Input, value: f64, negative: bool, digits: u64 in Wrapping, fraction: u64 in Wrapping) {
  transition digits > 0 { true -> scale(input, value, negative, 0 - (narrow_u64_to_i32_saturating(fraction as u64) as i32 in Wrapping)) false -> invalid(input) }
 }
 state exponent_sign(input: &mut Input, index: u64 in Wrapping, value: f64, negative: bool, fraction: u64 in Wrapping) {
  transition index < input.length && index < 64 { true -> exponent_start(input, index, value, negative, fraction) false -> invalid(input) }
 }
 state exponent_start(input: &mut Input, index: u64 in Wrapping, value: f64, negative: bool, fraction: u64 in Wrapping) {
  let byte: i32 in Wrapping = input.token[index];
  transition byte == 45 || byte == 43 {
   true -> exponent(input, index + 1, value, negative, fraction, byte == 45, 0, 0)
   false -> exponent(input, index, value, negative, fraction, false, 0, 0)
  }
 }
 state exponent(input: &mut Input, index: u64 in Wrapping, value: f64, negative: bool, fraction: u64 in Wrapping, minus: bool, power: i32 in Wrapping, digits: u64 in Wrapping) {
  transition index < input.length && index < 64 { true -> exponent_digit(input, index, value, negative, fraction, minus, power, digits) false -> exponent_end(input, value, negative, fraction, minus, power, digits) }
 }
 state exponent_digit(input: &mut Input, index: u64 in Wrapping, value: f64, negative: bool, fraction: u64 in Wrapping, minus: bool, power: i32 in Wrapping, digits: u64 in Wrapping) {
  let byte: i32 in Wrapping = input.token[index];
  transition byte >= 48 && byte <= 57 && power < 1000 {
   true -> exponent(input, index + 1, value, negative, fraction, minus, power * 10 + byte - 48, digits + 1)
   false -> invalid(input)
  }
 }
 state exponent_end(input: &mut Input, value: f64, negative: bool, fraction: u64 in Wrapping, minus: bool, power: i32 in Wrapping, digits: u64 in Wrapping) {
  transition digits > 0 && power <= 1000 { true -> signed_power(input, value, negative, fraction, minus, power) false -> invalid(input) }
 }
 state signed_power(input: &mut Input, value: f64, negative: bool, fraction: u64 in Wrapping, minus: bool, power: i32 in Wrapping) {
  transition minus { true -> scale(input, value, negative, 0 - power - (narrow_u64_to_i32_saturating(fraction as u64) as i32 in Wrapping)) false -> scale(input, value, negative, power - (narrow_u64_to_i32_saturating(fraction as u64) as i32 in Wrapping)) }
 }
 state scale(input: &mut Input, value: f64, negative: bool, power: i32 in Wrapping) {
  transition { power > 0 -> scale(input, value * 10.0, negative, power - 1) power < 0 -> scale(input, value / 10.0, negative, power + 1) _ -> signed_value(input, value, negative) }
 }
 state signed_value(input: &mut Input, value: f64, negative: bool) {
  transition value - value == 0.0 { true -> sign(input, value, negative) false -> invalid(input) }
 }
 state sign(input: &mut Input, value: f64, negative: bool) {
  transition negative { true -> save(input, 0.0 - value) false -> save(input, value) }
 }
 state save(input: &mut Input, value: f64) {
  transition input.count < 67 { true -> store(input, value) false -> invalid(input) }
 }
 state store(input: &mut Input, value: f64) {
  input.values[input.count] = value; input.count = input.count + 1; input.length = 0;
 }
 state invalid(input: &mut Input) { input.valid = false; }
 state done() {}
}
