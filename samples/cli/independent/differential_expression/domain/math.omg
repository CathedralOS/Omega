use omega::language::core::float_operations;

// Positive bounded inputs only. Binary range reduction and atanh series.
machine logarithm(value: f64) -> f64 {
    transition { _ -> reduce(value, 0.0) }
    machine reduce(value: f64, offset: f64) -> f64 {
        transition value > 2.0 {
 true -> reduce(value / 2.0, offset + 0.6931471805599453)
 false -> small(value, offset) }
    }
    machine small(value: f64, offset: f64) -> f64 {
        transition value < 1.0 {
 true -> reduce(value * 2.0, offset - 0.6931471805599453)
 false -> series((value - 1.0) / (value + 1.0), offset) }
    }
    machine series(z: f64, offset: f64) -> f64 {
        transition { _ -> term(z, z * z, z, 1.0, 0.0, offset, 0) }
    }
    machine term(z: f64, square: f64, power: f64, divisor: f64, sum: f64, offset: f64, count: i32 in Wrapping) -> f64 {
        let next: f64 = sum + power / divisor;
        transition count < 24 {
 true -> term(z, square, power * square, divisor + 2.0, next, offset, count + 1)
 false -> (offset + 2.0 * next) }
    }
}
machine exponential(value: f64) -> f64 {
    let reduced: f64 = value / 128.0;
    transition { _ -> term(reduced, 1.0, 1.0, 1.0, 0) }
    machine term(value: f64, sum: f64, power: f64, divisor: f64, count: i32 in Wrapping) -> f64 {
        let next: f64 = power * value / divisor;
        let total: f64 = sum + next;
        transition count < 31 {
 true -> term(value, total, next, divisor + 1.0, count + 1)
 false -> square(total) }
    }
    machine square(value: f64) -> f64 {
        let a: f64 = value * value; let b: f64 = a * a; let c: f64 = b * b;
        let d: f64 = c * c; let e: f64 = d * d; let f: f64 = e * e; f * f
    }
}
machine magnitude(value: f64) -> f64 {
    transition value < 0.0 {
 true -> (0.0 - value)
 false -> value }
}
// Abramowitz-Stegun 7.1.26: absolute normal-tail error < 1.5e-7.
machine probability(z: f64) -> f64 {
    let absolute: f64 = magnitude(z);
    transition absolute > 12.0 { true -> 0.0
        false -> tail(absolute) }
    machine tail(absolute: f64) -> f64 {
        let x: f64 = absolute / 1.4142135623730951;
        let t: f64 = 1.0 / (1.0 + 0.3275911 * x);
        let polynomial: f64 = (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
        polynomial * exponential(0.0 - x * x)
    }
}
// Avoid cancellation in log(1+x) when x is close to zero.
machine log_one_plus(value: f64) -> f64 {
    transition value < 1.0 { true -> series(value / (2.0 + value))
        false -> logarithm(1.0 + value) }
    machine series(z: f64) -> f64 {
        transition { _ -> term(z * z, z, 1.0, 0.0, 0) }
    }
    machine term(square: f64, power: f64, divisor: f64, sum: f64, count: i32 in Wrapping) -> f64 {
        let next: f64 = sum + power / divisor;
        transition count < 24 { true -> term(square, power * square, divisor + 2.0, next, count + 1)
            false -> (2.0 * next) }
    }
}

// Shift positive arguments to >=12, then use Stirling through x^-11.
// The next asymptotic term there is <7e-17. Shifting preserves log Gamma.
// This avoids a loop proportional to count size in each NB likelihood row.
machine log_gamma(value: f64) -> f64 {
    transition { _ -> shift(value, 0.0) }
    machine shift(value: f64, correction: f64) -> f64 {
        transition value < 12.0 { true -> shift(value + 1.0, correction - logarithm(value))
            false -> stirling(value, correction) }
    }
    machine stirling(value: f64, correction: f64) -> f64 {
        let inverse: f64 = 1.0 / value;
        let square: f64 = inverse * inverse;
        let series: f64 = inverse * (1.0 / 12.0 + square * (0.0 - 1.0 / 360.0 + square * (1.0 / 1260.0 + square * (0.0 - 1.0 / 1680.0 + square * (1.0 / 1188.0 - square * 691.0 / 360360.0)))));
        (value - 0.5) * logarithm(value) - value + 0.9189385332046727 + series + correction
    }
}
