use omega_language_std::console;
use omega::language::core::float_operations;

data Protocol {
    fields: [i32; 54];
    position: i32 in Wrapping;
    length: i32 in Wrapping;
    accumulator: i32 in Wrapping;
    negative: bool;
    digits: bool;
    started: bool;
}

// Exactly 54 bounded signed decimal integers separated by ASCII whitespace.
// EOF completes the record; LF, CR, spaces and tabs separate fields. Storage
// holds no more than 54 values; the input itself is at most 599 bytes. It
// reads at most 600 bytes, and rejects rather than wrapping decimal overflow.
machine Protocol::read(protocol: &mut Protocol) -> bool
reaches Console
blocks;
crashes Trap
{
    protocol.position = 0;
    protocol.length = 0;
    protocol.accumulator = 0;
    protocol.negative = false;
    protocol.digits = false;
    protocol.started = false;
    transition { _ -> scan_input(protocol) }
    machine scan_input(protocol: &mut Protocol) -> bool {
        transition protocol.length < 600 {

 true -> observe(protocol)

 false -> rejected()
        }
    }
    machine observe(protocol: &mut Protocol) -> bool {
        let observed: ByteRead = block Console::read_byte();
        protocol.length = protocol.length + 1;
        transition observed {
            ByteRead::Eof -> finish(protocol)
            ByteRead::Byte { value } -> character(protocol, value)
        }
    }
    machine character(protocol: &mut Protocol, value: i32) -> bool {
        transition value >= 48 && value <= 57 {

 true -> digit(protocol, value)

 false -> punctuation(protocol, value)
        }
    }
    machine digit(protocol: &mut Protocol, value: i32) -> bool {
        transition protocol.position < 54 && protocol.accumulator <= 100000 {

 true -> accumulate(protocol, value)

 false -> rejected()
        }
    }
    machine accumulate(protocol: &mut Protocol, value: i32) -> bool {
        let digit: i32 in Wrapping = value as i32 in Wrapping;
        protocol.accumulator = protocol.accumulator * 10 + digit - 48;
        protocol.started = true;
        protocol.digits = true;
        transition { _ -> scan_input(protocol) }
    }
    machine punctuation(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 45 && !protocol.started && protocol.position < 54 {

 true -> minus(protocol)

 false -> separator(protocol, value)
        }
    }
    machine minus(protocol: &mut Protocol) -> bool {
        protocol.started = true;
        protocol.negative = true;
        transition { _ -> scan_input(protocol) }
    }
    machine separator(protocol: &mut Protocol, value: i32) -> bool {
        transition { _ -> whitespace(protocol, value) }
    }
    machine whitespace(protocol: &mut Protocol, value: i32) -> bool {
        transition value == 32 || value == 9 || value == 13 || value == 10 {

 true -> commit(protocol, false)

 false -> rejected()
        }
    }
    machine finish(protocol: &mut Protocol) -> bool {
        transition { _ -> commit(protocol, true) }
    }
    machine commit(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.digits {

 true -> guarded_store(protocol, final)

 false -> empty(protocol, final)
        }
    }
    machine empty(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.started {

 true -> rejected()

 false -> after(protocol, final)
        }
    }
    machine guarded_store(protocol: &mut Protocol, final: bool) -> bool {
        transition protocol.position >= 0 && protocol.position < 54 {

 true -> store(protocol, final, protocol.position)

 false -> rejected()
        }
    }
    machine store(protocol: &mut Protocol, final: bool, position: i32 in Wrapping) -> bool
    requires position >= 0 && position < 54
    {
        transition protocol.negative {

 true -> negative(protocol, final, position)

 false -> positive(protocol, final, position)
        }
    }
    machine negative(protocol: &mut Protocol, final: bool, position: i32 in Wrapping) -> bool
    requires position >= 0 && position < 54
    {
        protocol.fields[position] = (0 - protocol.accumulator) as i32;
        transition { _ -> reset(protocol, final) }
    }
    machine positive(protocol: &mut Protocol, final: bool, position: i32 in Wrapping) -> bool
    requires position >= 0 && position < 54
    {
        protocol.fields[position] = protocol.accumulator as i32;
        transition { _ -> reset(protocol, final) }
    }
    machine reset(protocol: &mut Protocol, final: bool) -> bool {
        protocol.position = protocol.position + 1;
        protocol.accumulator = 0;
        protocol.negative = false;
        protocol.digits = false;
        protocol.started = false;
        transition { _ -> after(protocol, final) }
    }
    machine after(protocol: &mut Protocol, final: bool) -> bool {
        transition final {

 true -> complete(protocol)

 false -> scan_input(protocol)
        }
    }
    machine complete(protocol: &mut Protocol) -> bool { protocol.position == 54 }
    machine rejected() -> bool { false }
}

machine Protocol::integer(protocol: &mut Protocol, value: i32 in Wrapping)
reaches Console {
    transition value < 0 {

 true -> negative(protocol, value)

 false -> digits(protocol, value, 1000000000, false)
    }
    machine negative(protocol: &mut Protocol, value: i32 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> digits(protocol, 0 - value, 1000000000, false) }
    }
    machine digits(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let digit: i32 in Wrapping = value / divisor;
        let remainder: i32 in Wrapping = value % divisor;
        transition digit != 0 || started || divisor == 1 {

 true -> emit(protocol, digit, remainder, divisor)

 false -> next(protocol, remainder, divisor, false)
        }
    }
    machine emit(protocol: &mut Protocol, digit: i32 in Wrapping,
        remainder: i32 in Wrapping, divisor: i32 in Wrapping)
    requires divisor >= 1
    {
        Console::write_byte((digit + 48) as i32);
        transition { _ -> next(protocol, remainder, divisor, true) }
    }
    machine next(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        transition divisor > 1 {

 true -> divide(protocol, value, divisor, started)

 false -> done()
        }
    }
    machine divide(protocol: &mut Protocol, value: i32 in Wrapping,
        divisor: i32 in Wrapping, started: bool)
    requires divisor >= 1
    {
        let next_divisor: i32 in Wrapping = divisor / 10;
        transition next_divisor >= 1 {

 true -> digits(protocol, value, next_divisor, started)

 false -> done()
        }
    }
    machine done() { }
}

// Nine significant decimal digits as signed integer mantissa and power of ten.
// All model outputs are finite, and normalization precedes the trapping cast.
machine Protocol::number(protocol: &mut Protocol, value: f64)
reaches Console {
    transition value == 0.0 {

 true -> zero(protocol)

 false -> sign(protocol, value)
    }
    machine zero(protocol: &mut Protocol) { Console::write("0"); }
    machine sign(protocol: &mut Protocol, value: f64) {
        transition value < 0.0 {

 true -> negative(protocol, value)

 false -> normalize(protocol, value, 0)
        }
    }
    machine negative(protocol: &mut Protocol, value: f64) {
        Console::write_byte(45);
        transition { _ -> normalize(protocol, 0.0 - value, 0) }
    }
    machine normalize(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value >= 10.0 {

 true -> normalize(protocol, value / 10.0, exponent + 1)

 false -> small(protocol, value, exponent)
        }
    }
    machine small(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        transition value < 1.0 {

 true -> normalize(protocol, value * 10.0, exponent - 1)

 false -> emit(protocol, value, exponent)
        }
    }
    machine emit(protocol: &mut Protocol, value: f64, exponent: i32 in Wrapping) {
        let scaled: f64 = value * 100000000.0;
        transition scaled == scaled && scaled >= 0.0 && scaled < 1000000000.0 {

 true -> land(protocol, scaled, exponent)

 false -> invalid(protocol)
        }
    }
    machine land(protocol: &mut Protocol, scaled: f64, exponent: i32 in Wrapping)
    requires scaled == scaled && scaled >= 0.0 && scaled < 1000000000.0
    {
        let mantissa: i32 = I32::from_f64(scaled);
        Protocol::integer(protocol, mantissa as i32 in Wrapping);
        Console::write("e");
        Protocol::integer(protocol, exponent - 8);
    }
    machine invalid(protocol: &mut Protocol) {
        Console::write_line("ERROR numeric: reporting value outside finite model envelope");
        Console::exit_process(66);
    }
}
