use omega_language_std::console;
use omega::language::core::binding;

pub data Request [copy] {
    valid: bool;
    identifier: u64 in Saturating;
    horizon: u64 in Saturating;
}

// Grammar: one case digit, one space, one or two horizon digits, LF.
// Bytes are read through the documented Console provider; EOF and host traps
// are explicit rejection routes. No input can grow the simulation storage.
pub machine read_request(console: &Binding<Console>) -> Request
reaches Console
invokes console;
blocks;
crashes Trap
{
    let observed: ByteRead = block Console::read_byte(console);
    transition observed {
        ByteRead::Byte { value } -> identifier(console, value)
        _ -> (Request { valid: false, identifier: 0, horizon: 0 })
    }
    state identifier(console: &Binding<Console>, value: i32) -> Request {
        transition value >= 48 && value <= 53 {
            true -> separator(console, (value - 48) as u64 in Saturating)
            false -> invalid()
        }
    }
    state separator(console: &Binding<Console>, identifier: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte(console);
        transition observed {
            ByteRead::Byte { value: 32 } -> first(console, identifier)
            _ -> invalid()
        }
    }
    state first(console: &Binding<Console>, identifier: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte(console);
        transition observed {
            ByteRead::Byte { value } -> digit(console, identifier, value)
            _ -> invalid()
        }
    }
    state digit(console: &Binding<Console>, identifier: u64 in Saturating, value: i32) -> Request {
        transition value >= 49 && value <= 57 {
            true -> second(console, identifier, (value - 48) as u64 in Saturating)
            false -> invalid()
        }
    }
    state second(console: &Binding<Console>, identifier: u64 in Saturating, horizon: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte(console);
        transition observed {
            ByteRead::Byte { value: 10 } -> valid(identifier, horizon)
            ByteRead::Byte { value } -> second_digit(console, identifier, horizon, value)
            _ -> invalid()
        }
    }
    state second_digit(console: &Binding<Console>, identifier: u64 in Saturating, horizon: u64 in Saturating, value: i32) -> Request {
        transition value >= 48 && value <= 57 {
            true -> newline(console, identifier, horizon * 10 + ((value - 48) as u64 in Saturating))
            false -> invalid()
        }
    }
    state newline(console: &Binding<Console>, identifier: u64 in Saturating, horizon: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte(console);
        transition observed {
            ByteRead::Byte { value: 10 } -> valid(identifier, horizon)
            _ -> invalid()
        }
    }
    state valid(identifier: u64 in Saturating, horizon: u64 in Saturating) -> Request {
        transition horizon >= 1 && horizon <= 24 {
            true -> (Request { valid: true, identifier: identifier, horizon: horizon })
            false -> invalid()
        }
    }
    state invalid() -> Request { (Request { valid: false, identifier: 0, horizon: 0 }) }
}
