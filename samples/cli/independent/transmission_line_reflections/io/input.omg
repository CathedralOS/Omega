use omega_language_std::console;

public data Request [copy] {
    valid: bool;
    identifier: u64 in Saturating;
    horizon: u64 in Saturating;
}

// Grammar: one case digit, one space, one or two horizon digits, LF.
// Bytes are read through the documented Console provider; EOF and host traps
// are explicit rejection routes. No input can grow the simulation storage.
public machine read_request() -> Request
reaches Console
invokes Console;
blocks;
crashes Trap
{
    let observed: ByteRead = block Console::read_byte();
    transition observed {
        ByteRead::Byte { value } -> identifier(value)
        _ -> (Request { valid: false, identifier: 0, horizon: 0 })
    }
    machine identifier(value: i32) -> Request {
        transition value >= 48 && value <= 53 {
            true -> separator((value - 48) as u64 in Saturating)
            false -> invalid()
        }
    }
    machine separator(identifier: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Byte { value: 32 } -> first(identifier)
            _ -> invalid()
        }
    }
    machine first(identifier: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Byte { value } -> digit(identifier, value)
            _ -> invalid()
        }
    }
    machine digit(identifier: u64 in Saturating, value: i32) -> Request {
        transition value >= 49 && value <= 57 {
            true -> second(identifier, (value - 48) as u64 in Saturating)
            false -> invalid()
        }
    }
    machine second(identifier: u64 in Saturating, horizon: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Byte { value: 10 } -> valid(identifier, horizon)
            ByteRead::Byte { value } -> second_digit(identifier, horizon, value)
            _ -> invalid()
        }
    }
    machine second_digit(identifier: u64 in Saturating, horizon: u64 in Saturating, value: i32) -> Request {
        transition value >= 48 && value <= 57 {
            true -> newline(identifier, horizon * 10 + ((value - 48) as u64 in Saturating))
            false -> invalid()
        }
    }
    machine newline(identifier: u64 in Saturating, horizon: u64 in Saturating) -> Request {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Byte { value: 10 } -> valid(identifier, horizon)
            _ -> invalid()
        }
    }
    machine valid(identifier: u64 in Saturating, horizon: u64 in Saturating) -> Request {
        transition horizon >= 1 && horizon <= 24 {
            true -> (Request { valid: true, identifier: identifier, horizon: horizon })
            false -> invalid()
        }
    }
    machine invalid() -> Request { (Request { valid: false, identifier: 0, horizon: 0 }) }
}
