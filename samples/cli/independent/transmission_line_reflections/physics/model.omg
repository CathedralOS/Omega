// Lossless discrete travelling-wave model. One tick is one pulse-width unit.
// Four delay calendars store voltages, so coherent arrivals combine before
// squaring. Terminal resistances are represented by exact limiting coefficients.
use omega::language::core::float_operations;

public data LineModel [copy] {
    first_impedance: f64;
    second_impedance: f64;
    source_reflection: f64;
    load_reflection: f64;
    first_delay: u64;
    second_delay: u64;
    alternate: bool;
}

public machine preset(identifier: u64) -> LineModel {
    transition identifier {
        0 -> (LineModel { first_impedance: 50.0, second_impedance: 50.0, source_reflection: 0.0, load_reflection: 0.0, first_delay: 1, second_delay: 1, alternate: false })
        1 -> (LineModel { first_impedance: 50.0, second_impedance: 100.0, source_reflection: 0.5, load_reflection: 0.0, first_delay: 1, second_delay: 2, alternate: false })
        2 -> (LineModel { first_impedance: 50.0, second_impedance: 100.0, source_reflection: 0.5, load_reflection: 1.0, first_delay: 1, second_delay: 1, alternate: false })
        3 -> (LineModel { first_impedance: 50.0, second_impedance: 100.0, source_reflection: 0.5, load_reflection: -1.0, first_delay: 1, second_delay: 1, alternate: false })
        4 -> (LineModel { first_impedance: 100.0, second_impedance: 50.0, source_reflection: -0.5, load_reflection: 0.5, first_delay: 2, second_delay: 3, alternate: false })
        _ -> (LineModel { first_impedance: 50.0, second_impedance: 100.0, source_reflection: 0.5, load_reflection: 1.0, first_delay: 1, second_delay: 1, alternate: true })
    }
}

public machine excitation(tick: u64, alternate: bool) -> f64 {
    transition tick < 2 {
        true -> (1.0)
        false -> later(tick, alternate)
    }
    machine later(tick: u64, alternate: bool) -> f64 {
        transition alternate && (tick == 4 || tick == 5) {
            true -> (-1.0)
            false -> (0.0)
        }
    }
}

public machine packet_energy(voltage: f64, impedance: f64) -> f64 {
    (voltage * voltage / impedance)
}

public data WaveRecord [copy] {
    junction_left_in: f64;
    junction_right_in: f64;
    junction_left_out: f64;
    junction_right_out: f64;
    source_in: f64;
    source_out: f64;
    load_in: f64;
    load_out: f64;
    source_voltage: f64;
    junction_voltage: f64;
    load_voltage: f64;
}

public data ReflectionTree {
    to_junction_left: [f64; 64];
    to_junction_right: [f64; 64];
    to_source: [f64; 64];
    to_load: [f64; 64];
    supplied: f64;
    source_heat: f64;
    load_heat: f64;
    travelling: f64;
    record: WaveRecord;
}

// Runtime bounds checks precede every calendar access, including future
// emissions. Zero initialization is the empty calendar and empty energy ledger.
public machine propagate(tree: &mut ReflectionTree, model: &LineModel, tick: u64) -> bool {
    transition tick < 24 && model.first_delay >= 1 && model.first_delay <= 3 && model.second_delay >= 1 && model.second_delay <= 3 {
        true -> schedule(tree, model, tick, tick + model.first_delay, tick + model.second_delay)
        false -> (false)
    }
    machine schedule(tree: &mut ReflectionTree, model: &LineModel, tick: u64, first_arrival: u64, second_arrival: u64) -> bool {
        transition tick < 64 && first_arrival < 64 && second_arrival < 64 {
            true -> scatter(tree, model, tick, first_arrival, second_arrival)
            false -> (false)
        }
    }
    machine scatter(tree: &mut ReflectionTree, model: &LineModel, tick: u64, first_arrival: u64, second_arrival: u64) -> bool
    requires tick < 64 && first_arrival < 64 && second_arrival < 64
    {
        let left: f64 = tree.to_junction_left[tick];
        let right: f64 = tree.to_junction_right[tick];
        let source: f64 = tree.to_source[tick];
        let load: f64 = tree.to_load[tick];
        let reflection: f64 = (model.second_impedance - model.first_impedance) / (model.second_impedance + model.first_impedance);
        let left_out: f64 = reflection * left + (1.0 - reflection) * right;
        let right_out: f64 = (1.0 + reflection) * left - reflection * right;
        let source_echo: f64 = model.source_reflection * source;
        let drive: f64 = excitation(tick, model.alternate);
        let source_out: f64 = source_echo + drive;
        let load_out: f64 = model.load_reflection * load;
        // Each calendar has one sender and a fixed delay: distinct send ticks
        // have distinct arrival slots. Source excitation and echo are combined
        // in source_out before this unique write, preserving interference.
        tree.to_junction_left[first_arrival] = source_out;
        tree.to_junction_right[second_arrival] = load_out;
        tree.to_source[first_arrival] = left_out;
        tree.to_load[second_arrival] = right_out;
        tree.record = WaveRecord {
            junction_left_in: left, junction_right_in: right,
            junction_left_out: left_out, junction_right_out: right_out,
            source_in: source, source_out: source_out,
            load_in: load, load_out: load_out,
            source_voltage: source + source_out,
            junction_voltage: left + left_out,
            load_voltage: load + load_out
        };
        tree.supplied = tree.supplied + packet_energy(source_out, model.first_impedance) - packet_energy(source_echo, model.first_impedance);
        tree.source_heat = tree.source_heat + packet_energy(source, model.first_impedance) - packet_energy(source_echo, model.first_impedance);
        tree.load_heat = tree.load_heat + packet_energy(load, model.second_impedance) - packet_energy(load_out, model.second_impedance);
        tree.travelling = tree.travelling - packet_energy(left, model.first_impedance) - packet_energy(right, model.second_impedance) - packet_energy(source, model.first_impedance) - packet_energy(load, model.second_impedance);
        tree.travelling = tree.travelling + packet_energy(left_out, model.first_impedance) + packet_energy(right_out, model.second_impedance) + packet_energy(source_out, model.first_impedance) + packet_energy(load_out, model.second_impedance);
        (true)
    }
}
