// Expected exit: 64 with empty stdin.
// Expected output contains: ERROR input:
// Valid requests in data/*.stdin exit 0 and emit the wave/voltage/energy records.
// Complete bounded transmission-line pulse simulation. Output is CSV records
// in micro-units; see data/oracle.json for independently frozen exact fractions.
use omega_language_std::console;
use omega::language::core::float_operations;
use physics::model;
use io::input;
use io::report;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let request: Request = block read_request(&main.console);
    transition request.valid {
        true -> start(&main.console, request.identifier, request.horizon)
        false -> invalid(&main.console)
    }
    state start(console: &Binding<Console>, identifier: u64 in Saturating, horizon: u64 in Saturating) {
        let model: LineModel = preset(identifier as u64);
        let mut tree: ReflectionTree;
        Console::write_line(console, "transmission_line_reflections v1 micro-units");
        transition { _ -> simulate(console, &mut tree, &model, 0, horizon) }
    }
    state simulate(console: &Binding<Console>, tree: &mut ReflectionTree, model: &LineModel, tick: u64 in Saturating, horizon: u64 in Saturating) {
        transition tick < horizon && tick < 24 {
            true -> step(console, tree, model, tick, horizon)
            false -> finish(console)
        }
    }
    state step(console: &Binding<Console>, tree: &mut ReflectionTree, model: &LineModel, tick: u64 in Saturating, horizon: u64 in Saturating)
    requires tick < 24
    {
        let okay: bool = propagate(tree, model, tick as u64);
        transition okay {
            true -> emit(console, tree, model, tick, horizon)
            false -> failed(console)
        }
    }
    state emit(console: &Binding<Console>, tree: &mut ReflectionTree, model: &LineModel, tick: u64 in Saturating, horizon: u64 in Saturating)
    requires tick < 24
    {
        report(console, tick as u64, tree);
        let residual: f64 = tree.supplied - tree.source_heat - tree.load_heat - tree.travelling;
        transition residual >= -0.000000001 && residual <= 0.000000001 {
            true -> simulate(console, tree, model, tick + 1, horizon)
            false -> failed(console)
        }
    }
    state finish(console: &Binding<Console>) { Console::write_line(console, "END"); Console::exit_process(console, 0); }
    state invalid(console: &Binding<Console>) { Console::write_line(console, "ERROR input: expected case 0..5 and horizon 1..24 followed by LF"); Console::exit_process(console, 64); }
    state failed(console: &Binding<Console>) { Console::write_line(console, "ERROR simulation invariant"); Console::exit_process(console, 70); }
}
