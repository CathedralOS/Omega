// Expected exit: 64 with empty stdin.
// Expected output contains: ERROR input:
// Valid requests in data/*.stdin exit 0 and emit the wave/voltage/energy records.
// Complete bounded transmission-line pulse simulation. Output is CSV records
// in micro-units; see data/oracle.json for independently frozen exact fractions.
use omega_language_std::console;
use omega::language::core::float_operations;
use physics::model;
use io::input;
use io::report;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let request: Request = block read_request();
    transition request.valid {
        true -> start(request.identifier, request.horizon)
        false -> invalid()
    }
    state start(identifier: u64 in Saturating, horizon: u64 in Saturating) {
        let model: LineModel = preset(identifier as u64);
        let mut tree: ReflectionTree;
        Console::write_line("transmission_line_reflections v1 micro-units");
        transition { _ -> simulate(&mut tree, &model, 0, horizon) }
    }
    state simulate(tree: &mut ReflectionTree, model: &LineModel, tick: u64 in Saturating, horizon: u64 in Saturating) {
        transition tick < horizon && tick < 24 {
            true -> step(tree, model, tick, horizon)
            false -> finish()
        }
    }
    state step(tree: &mut ReflectionTree, model: &LineModel, tick: u64 in Saturating, horizon: u64 in Saturating)
    requires tick < 24
    {
        let okay: bool = propagate(tree, model, tick as u64);
        transition okay {
            true -> emit(tree, model, tick, horizon)
            false -> failed()
        }
    }
    state emit(tree: &mut ReflectionTree, model: &LineModel, tick: u64 in Saturating, horizon: u64 in Saturating)
    requires tick < 24
    {
        report(tick as u64, tree);
        let residual: f64 = tree.supplied - tree.source_heat - tree.load_heat - tree.travelling;
        transition residual >= -0.000000001 && residual <= 0.000000001 {
            true -> simulate(tree, model, tick + 1, horizon)
            false -> failed()
        }
    }
    state finish() { Console::write_line("END"); Console::exit_process(0); }
    state invalid() { Console::write_line("ERROR input: expected case 0..5 and horizon 1..24 followed by LF"); Console::exit_process(64); }
    state failed() { Console::write_line("ERROR simulation invariant"); Console::exit_process(70); }
}
