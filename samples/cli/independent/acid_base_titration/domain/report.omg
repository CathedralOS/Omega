use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;
use domain::equilibrium;


// Scientific notation preserves tiny species; normalized mantissa fits i64.
// Round magnitude half upward and retain the sign separately.
machine mantissa(value: f64) reaches Console {
    let mut bytes: [u8; 18] = "+0.000000000000000";
    transition value < 0.0 {
        true -> negative(&mut bytes, value)
        _ -> positive(&mut bytes, value)
    }
    state negative(bytes: &mut [u8; 18], value: f64) {
        bytes[0] = 45;
        let scaled: i64 in Saturating = I64::from_f64((0.0 - value) * 1000000000000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as i64 in Wrapping, 17) }
    }
    state positive(bytes: &mut [u8; 18], value: f64) {
        let scaled: i64 in Saturating = I64::from_f64(value * 1000000000000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as i64 in Wrapping, 17) }
    }
    state digits(bytes: &mut [u8; 18],
                 remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position > 0 && position < 18 {
            true -> separator(bytes, remaining, position)
            _ -> emit(bytes)
        }
    }
    state separator(bytes: &mut [u8; 18],
                    remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position == 2 {
            true -> digits(bytes, remaining, position - 1)
            _ -> store(bytes, remaining, position)
        }
    }
    state store(bytes: &mut [u8; 18],
                remaining: i64 in Wrapping, position: i32 in Wrapping) {
        let digit: i32 = narrow_i64_to_i32_trapping((remaining % 10 + 48) as i64);
        bytes[position] = narrow_i32_to_u8_trapping(digit);
        transition { _ -> digits(bytes, remaining / 10, position - 1) }
    }
    state emit(bytes: &[u8; 18]) { Console::write(bytes); }
}
machine emit_number(value: f64) reaches Console {
    transition value < 0.0 { true -> normalize(0.0 - value, -1.0, 0) _ -> normalize(value, 1.0, 0) }
    state normalize(value: f64, sign: f64, exponent: i32 in Wrapping) {
        transition value > 0.0 && value < 1.0 && exponent > -60 {
            true -> normalize(value * 10.0, sign, exponent - 1)
            _ -> upper(value, sign, exponent)
        }
    }
    state upper(value: f64, sign: f64, exponent: i32 in Wrapping) {
        transition value >= 10.0 && exponent < 60 {
            true -> normalize(value / 10.0, sign, exponent + 1)
            _ -> emit(value, sign, exponent)
        }
    }
    state emit(value: f64, sign: f64, exponent: i32 in Wrapping) {
        mantissa(value * sign);
        Console::write("e");
        transition exponent < 0 { true -> minus(0 - exponent) _ -> plus(exponent) }
    }
    state minus(exponent: i32 in Wrapping) { Console::write("-"); transition { _ -> exponent_digits(exponent) } }
    state plus(exponent: i32 in Wrapping) { Console::write("+"); transition { _ -> exponent_digits(exponent) } }
    state exponent_digits(exponent: i32 in Wrapping) {
        Console::write_byte((exponent / 10 + 48) as i32);
        Console::write_byte((exponent % 10 + 48) as i32);
        Console::write_line("");
    }
}
pub machine report(volume: f64, result: &Equilibrium) reaches Console
invokes Console;
crashes Trap
{
    Console::write("volume="); emit_number(volume);
    Console::write("pH="); emit_number(result.ph);
    Console::write("H="); emit_number(result.hydrogen);
    Console::write("OH="); emit_number(result.hydroxide);
    Console::write("H2A="); emit_number(result.species[0]);
    Console::write("HA="); emit_number(result.species[1]);
    Console::write("A="); emit_number(result.species[2]);
    Console::write("total_acid="); emit_number(result.total);
    Console::write("counterion="); emit_number(result.counterion);
    Console::write("mass_closure="); emit_number(result.closure);
    Console::write("charge_residual="); emit_number(result.charge);
}
