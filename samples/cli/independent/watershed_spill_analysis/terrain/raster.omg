// Private storage: minimax path costs, settled flags and a drainage forest.
// 99 exceeds every allowed height. Boundary cells drain to themselves.
data Raster {
    heights: [i32 in Wrapping; 25];
    filled: [i32 in Wrapping; 25];
    settled: [bool; 25];
    outlets: [i32 in Wrapping; 25];
    parents: [i32 in Wrapping; 25];
    volumes: [i32 in Wrapping; 25];
    total: i32 in Wrapping;
}
