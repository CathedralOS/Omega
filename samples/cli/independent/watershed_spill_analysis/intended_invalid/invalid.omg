// Complete independent source control: unguarded runtime index must reject.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let input: ByteRead = block Console::read_byte();
    transition input {
        ByteRead::Eof -> finish(main)
        ByteRead::Byte { value } -> unsafe_read(main, value)
    }
    machine unsafe_read(main: &mut Main, index: i32) {
        let elevations: [i32; 25];
        let height: i32 = elevations[index];
        Console::exit_process(height);
    }
    machine finish(main: &mut Main) { Console::exit_process(0); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
