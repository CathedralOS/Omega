// Complete offline watershed workflow. Stdin: exactly 25 digits, whitespace
// optional. EOF completes the raster; errors exit 2 without partial results.
use omega_language_std::console;
use terrain::raster;
use terrain::fill;
use output::render;

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let mut raster: Raster;
    transition { _ -> read(main, &mut raster, 0) }
    state read(main: &mut Main, raster: &mut Raster, count: i32 in Wrapping) {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Eof -> finish_input(main, raster, count)
            ByteRead::Byte { value } -> classify(main, raster, count, value)
        }
    }
    state classify(main: &mut Main, raster: &mut Raster, count: i32 in Wrapping, value: i32) {
        transition value == 32 || value == 9 || value == 10 || value == 13 {
            true -> read(main, raster, count)
            _ -> validate(main, raster, count, value)
        }
    }
    state validate(main: &mut Main, raster: &mut Raster, count: i32 in Wrapping, value: i32) {
        transition count >= 0 && count < 25 && value >= 48 && value <= 57 {
            true -> store(main, raster, count, value)
            _ -> invalid(main)
        }
    }
    state store(main: &mut Main, raster: &mut Raster, count: i32 in Wrapping, value: i32) {
        raster.heights[count] = (value as i32 in Wrapping) - 48;
        transition { _ -> read(main, raster, count + 1) }
    }
    state finish_input(main: &mut Main, raster: &mut Raster, count: i32 in Wrapping) {
        transition count == 25 {
            true -> analyze(main, raster)
            _ -> invalid(main)
        }
    }
    state analyze(main: &mut Main, raster: &mut Raster) {
        let filled: bool = fill(raster);
        let summed: bool = sum_volumes(raster);
        transition filled && summed {
            true -> emit(main, raster)
            _ -> internal_error(main)
        }
    }
    state emit(main: &mut Main, raster: &Raster) {
        Console::write_line("filled");
        grid(&raster.filled);
        Console::write_line("outlets");
        grid(&raster.outlets);
        Console::write_line("parents");
        grid(&raster.parents);
        Console::write_line("volumes");
        grid(&raster.volumes);
        Console::write_line("total");
        number(raster.total);
        Console::write_byte(10);
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) {
        Console::write_line("ERROR: expected exactly 25 elevation digits (0-9)");
        Console::exit_process(2);
    }
    state internal_error(main: &mut Main) {
        Console::write_line("ERROR: drainage invariant failed");
        Console::exit_process(3);
    }
}
