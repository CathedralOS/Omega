// Complete stdin-driven synthetic scientific sample. Valid data exits zero.
// Expected exit: 64.
// Expected output contains: INVALID bounded counterflow input
// The generic sample harness supplies EOF; data/ covers the scientific workflows.
use omega_language_std::console;
use io::input;
use io::report;
use model::stages;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut raw: io::input::Raw;
    let mut input: io::input::Input;
    let mut solution: model::stages::Solution;
    let parsed: bool = block io::input::parse(&main.console, &mut raw);
    transition parsed {
        true -> validate_input(&main.console, &raw, &mut input, &mut solution)
        false -> invalid(&main.console)
    }
    state validate_input(console: &Binding<Console>, raw: &io::input::Raw, input: &mut io::input::Input, solution: &mut model::stages::Solution) {
        transition io::input::validate(raw, input) {
            true -> calculate(console, input, solution)
            false -> invalid(console)
        }
    }
    state calculate(console: &Binding<Console>, input: &io::input::Input, solution: &mut model::stages::Solution) {
        transition model::stages::solve(input, solution) {
            true -> output(console, input, solution)
            false -> failed(console)
        }
    }
    state output(console: &Binding<Console>, input: &io::input::Input, solution: &model::stages::Solution) {
        io::report::emit(console, input, solution);
        Console::exit_process(console, 0);
    }
    state invalid(console: &Binding<Console>) {
        Console::write_line(console, "INVALID bounded counterflow input");
        Console::exit_process(console, 64);
    }
    state failed(console: &Binding<Console>) {
        Console::write_line(console, "FAIL numerical balance");
        Console::exit_process(console, 65);
    }
}
