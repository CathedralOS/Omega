module model::stages;
// Midpoint finite-volume counterflow model; see README for equations and limits.
// Two affine trials solve the cold far-boundary condition, then a third pass
// retains every stage. This is application-private and uses no numerics package.
use io::input;
use omega::language::core::float_operations;

public data Pair { hot: f64; cold: f64; }
public data Solution { hot: [f64; 9]; cold: [f64; 9]; heat: [f64; 8]; total: f64; }

machine transfer(input: &io::input::Input, pair: &mut Pair, position: u32) -> f64 requires position < 8 {
    let conductance: f64 = input.conductance[position];
    let denominator: f64 = 1.0 + conductance / (2.0 * input.hot_capacity) - conductance / (2.0 * input.cold_capacity);
    let heat: f64 = conductance * (pair.hot - pair.cold) / denominator;
    pair.hot = pair.hot - heat / input.hot_capacity;
    pair.cold = pair.cold - heat / input.cold_capacity;
    heat
}
machine trial(input: &io::input::Input, pair: &mut Pair) {
    transition { _ -> scan(input, pair, 0) }
    machine scan(input: &io::input::Input, pair: &mut Pair, position: u32) {
        transition position < input.stages && position < 8 {
            true -> stage(input, pair, position)
            false -> done()
        }
    }
    machine stage(input: &io::input::Input, pair: &mut Pair, position: u32) requires position < 8 {
        _ = transfer(input, pair, position);
        transition { _ -> scan(input, pair, position + 1) }
    }
    machine done() { }
}
public machine solve(input: &io::input::Input, solution: &mut Solution) -> bool {
    let mut base: Pair;
    base.hot = input.hot_in;
    base.cold = 0.0;
    trial(input, &mut base);
    let mut slope: Pair;
    slope.hot = 0.0;
    slope.cold = 1.0;
    trial(input, &mut slope);
    transition slope.cold > 0.000000001 {
        true -> resolved(input, solution, base.cold, slope.cold)
        false -> bad()
    }
    machine resolved(input: &io::input::Input, solution: &mut Solution, base: f64, slope: f64) -> bool {
        let mut pair: Pair;
        pair.hot = input.hot_in;
        pair.cold = (input.cold_in - base) / slope;
        solution.hot[0] = pair.hot;
        solution.cold[0] = pair.cold;
        solution.total = 0.0;
        transition { _ -> scan(input, solution, &mut pair, 0) }
    }
    machine scan(input: &io::input::Input, solution: &mut Solution, pair: &mut Pair, position: u32) -> bool {
        transition position < input.stages && position < 8 {
            true -> stage(input, solution, pair, position)
            false -> balances(input, solution, position)
        }
    }
    machine stage(input: &io::input::Input, solution: &mut Solution, pair: &mut Pair, position: u32) -> bool requires position < 8 {
        let heat: f64 = transfer(input, pair, position);
        solution.heat[position] = heat;
        solution.total = solution.total + heat;
        solution.hot[position + 1] = pair.hot;
        solution.cold[position + 1] = pair.cold;
        transition { _ -> scan(input, solution, pair, position + 1) }
    }
    machine balances(input: &io::input::Input, solution: &mut Solution, position: u32) -> bool {
        transition position < 9 {
            true -> verify(input, solution, position)
            false -> bad()
        }
    }
    machine verify(input: &io::input::Input, solution: &mut Solution, position: u32) -> bool requires position < 9 {
        let hot_balance: f64 = input.hot_capacity * (input.hot_in - solution.hot[position]) - solution.total;
        let cold_balance: f64 = input.cold_capacity * (solution.cold[0] - input.cold_in) - solution.total;
        let cold_boundary: f64 = solution.cold[position] - input.cold_in;
        transition hot_balance >= -0.0000001 && hot_balance <= 0.0000001
            && cold_balance >= -0.0000001 && cold_balance <= 0.0000001
            && cold_boundary >= -0.0000001 && cold_boundary <= 0.0000001 {
            true -> good()
            false -> bad()
        }
    }
    machine good() -> bool { true }
    machine bad() -> bool { false }
}
