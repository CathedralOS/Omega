module io::input;
// Bounded decimal tokens. No allocation, wrapping or unbounded token storage.
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::float_operations;

public data Raw { values: [u32; 16]; count: u32; }
public data Input {
    stages: u32;
    hot_capacity: f64;
    cold_capacity: f64;
    hot_in: f64;
    cold_in: f64;
    conductance: [f64; 8];
}

public machine parse(raw: &mut Raw) -> bool reaches Console invokes Console; blocks; crashes Trap {
    transition { _ -> read(raw, 0, false, 0) }
    machine read(raw: &mut Raw, accumulator: u32 in Saturating, active: bool, bytes: u32) -> bool {
        transition bytes < 256 {
            true -> receive(raw, accumulator, active, bytes)
            false -> bad()
        }
    }
    machine receive(raw: &mut Raw, accumulator: u32 in Saturating, active: bool, bytes: u32) -> bool {
        let observed: ByteRead = block Console::read_byte();
        transition observed {
            ByteRead::Byte { value } -> classify(raw, accumulator, active, bytes, value)
            ByteRead::Eof -> finish(raw, accumulator, active)
        }
    }
    machine classify(raw: &mut Raw, accumulator: u32 in Saturating, active: bool, bytes: u32, character: i32) -> bool {
        transition character >= 48 && character <= 57 {
            true -> digit(raw, accumulator, bytes, character)
            false -> delimiter(raw, accumulator, active, bytes, character)
        }
    }
    machine digit(raw: &mut Raw, accumulator: u32 in Saturating, bytes: u32, character: i32) -> bool {
        let digit: u32 in Saturating = narrow_i32_to_u32_trapping(character) as u32 in Saturating;
        let next: u32 in Saturating = accumulator * 10 + digit - 48;
        transition next <= 200 {
            true -> read(raw, next, true, bytes + 1)
            false -> bad()
        }
    }
    machine delimiter(raw: &mut Raw, accumulator: u32 in Saturating, active: bool, bytes: u32, character: i32) -> bool {
        transition character == 32 || character == 10 || character == 13 || character == 9 {
            true -> separate(raw, accumulator, active, bytes)
            false -> bad()
        }
    }
    machine separate(raw: &mut Raw, accumulator: u32 in Saturating, active: bool, bytes: u32) -> bool {
        transition active {
            true -> capacity(raw, accumulator, bytes)
            false -> read(raw, 0, false, bytes + 1)
        }
    }
    machine capacity(raw: &mut Raw, accumulator: u32 in Saturating, bytes: u32) -> bool {
        transition raw.count < 16 {
            true -> store(raw, accumulator, bytes)
            false -> bad()
        }
    }
    machine store(raw: &mut Raw, accumulator: u32 in Saturating, bytes: u32) -> bool {
        raw.values[raw.count] = accumulator as u32;
        raw.count = raw.count + 1;
        transition { _ -> read(raw, 0, false, bytes + 1) }
    }
    machine finish(raw: &mut Raw, accumulator: u32 in Saturating, active: bool) -> bool {
        transition active {
            true -> final_capacity(raw, accumulator)
            false -> good()
        }
    }
    machine final_capacity(raw: &mut Raw, accumulator: u32 in Saturating) -> bool {
        transition raw.count < 16 {
            true -> final_store(raw, accumulator)
            false -> bad()
        }
    }
    machine final_store(raw: &mut Raw, accumulator: u32 in Saturating) -> bool {
        raw.values[raw.count] = accumulator as u32;
        raw.count = raw.count + 1;
        transition { _ -> good() }
    }
    machine good() -> bool { true }
    machine bad() -> bool { false }
}

public machine validate(raw: &Raw, input: &mut Input) -> bool {
    transition raw.count >= 9 && raw.values[0] == 1
        && raw.values[1] >= 1 && raw.values[1] <= 8
        && raw.values[2] >= 1 && raw.values[2] <= 100
        && raw.values[3] >= 1 && raw.values[3] <= 100
        && raw.values[4] >= 1 && raw.values[4] <= 100
        && raw.values[5] >= 1 && raw.values[5] <= 100
        && raw.values[6] >= raw.values[7]
        && raw.count == 8 + raw.values[1] {
        true -> initialize(raw, input)
        false -> bad()
    }
    machine initialize(raw: &Raw, input: &mut Input) -> bool {
        input.stages = raw.values[1];
        input.hot_capacity = F64::from_u32(raw.values[2]) * F64::from_u32(raw.values[3]);
        input.cold_capacity = F64::from_u32(raw.values[4]) * F64::from_u32(raw.values[5]);
        input.hot_in = F64::from_u32(raw.values[6]);
        input.cold_in = F64::from_u32(raw.values[7]);
        transition { _ -> scan(raw, input, 0) }
    }
    machine scan(raw: &Raw, input: &mut Input, position: u32) -> bool {
        transition position < input.stages && position < 8 {
            true -> load(raw, input, position)
            false -> good()
        }
    }
    machine load(raw: &Raw, input: &mut Input, position: u32) -> bool requires position < 8 {
        let conductance: f64 = F64::from_u32(raw.values[position + 8]);
        transition conductance <= input.hot_capacity && conductance <= input.cold_capacity {
            true -> store(input, raw, position, conductance)
            false -> bad()
        }
    }
    machine store(input: &mut Input, raw: &Raw, position: u32, conductance: f64) -> bool requires position < 8 {
        input.conductance[position] = conductance;
        transition { _ -> scan(raw, input, position + 1) }
    }
    machine good() -> bool { true }
    machine bad() -> bool { false }
}
