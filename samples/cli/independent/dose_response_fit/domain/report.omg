use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;
use domain::model;
use domain::mathematics;

// Fixed six-decimal reporting; bounded input makes all scaled values fit i64.
// Round magnitude half upward and retain the sign separately.
machine number(value: f64) reaches Console {
    let mut bytes: [u8; 21] = "+0000000000000.000000";
    transition value < 0.0 {
        true -> negative(&mut bytes, value)
        _ -> positive(&mut bytes, value)
    }
    state negative(bytes: &mut [u8; 21], value: f64) {
        bytes[0] = 45;
        let scaled: i64 in Saturating = I64::from_f64((0.0 - value) * 1000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as i64 in Wrapping, 20) }
    }
    state positive(bytes: &mut [u8; 21], value: f64) {
        let scaled: i64 in Saturating = I64::from_f64(value * 1000000.0 + 0.5);
        transition { _ -> digits(bytes, scaled as i64 in Wrapping, 20) }
    }
    state digits(bytes: &mut [u8; 21],
                 remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position > 0 && position < 21 {
            true -> separator(bytes, remaining, position)
            _ -> emit(bytes)
        }
    }
    state separator(bytes: &mut [u8; 21],
                    remaining: i64 in Wrapping, position: i32 in Wrapping) {
        transition position == 14 {
            true -> digits(bytes, remaining, position - 1)
            _ -> store(bytes, remaining, position)
        }
    }
    state store(bytes: &mut [u8; 21],
                remaining: i64 in Wrapping, position: i32 in Wrapping) {
        let digit: i32 = narrow_i64_to_i32_trapping((remaining % 10 + 48) as i64);
        bytes[position] = narrow_i32_to_u8_trapping(digit);
        transition { _ -> digits(bytes, remaining / 10, position - 1) }
    }
    state emit(bytes: &[u8; 21]) { Console::write_line(bytes); }
}
pub machine report(observations: &Observations, fit: &Fit) reaches Console
invokes Console;
crashes Trap
{
    Console::write_line("dose_response_fit synthetic bounded 4PL");
    Console::write_line("converged=true"); Console::write_line("identifiable=true");
    Console::write_line("profile_confidence=0.95");
    transition observations.direction == 1 {
        true -> activation(observations, fit)
        _ -> inhibition(observations, fit)
    }
    state activation(observations: &Observations, fit: &Fit) {
        Console::write_line("half_dose_kind=EC50");
        transition { _ -> values(observations, fit) }
    }
    state inhibition(observations: &Observations, fit: &Fit) {
        Console::write_line("half_dose_kind=IC50");
        transition { _ -> values(observations, fit) }
    }
    state values(observations: &Observations, fit: &Fit) {
        Console::write("half_dose="); number(exponential(fit.candidate.log_half));
        Console::write("lowdose_asymptote="); number(fit.candidate.low);
        Console::write("highdose_asymptote="); number(fit.candidate.high);
        Console::write("log_half_dose="); number(fit.candidate.log_half);
        Console::write("slope="); number(fit.candidate.hill);
        Console::write("signed_slope="); number(fit.candidate.hill * F64::from_i32(observations.direction));
        Console::write("sse="); number(fit.candidate.sse);
        Console::write("sigma="); number(observations.sigma);
        Console::write("profile_cutoff="); number(fit.cutoff);
        Console::write("iterations="); number(F64::from_i32(fit.candidate.iterations as i32));
        Console::write("lowdose_asymptote_lower="); number(fit.lower[0]);
        Console::write("lowdose_asymptote_upper="); number(fit.upper[0]);
        Console::write("highdose_asymptote_lower="); number(fit.lower[1]);
        Console::write("highdose_asymptote_upper="); number(fit.upper[1]);
        Console::write("log_half_dose_lower="); number(fit.lower[2]);
        Console::write("log_half_dose_upper="); number(fit.upper[2]);
        Console::write("slope_lower="); number(fit.lower[3]);
        Console::write("slope_upper="); number(fit.upper[3]);
        Console::write("half_dose_lower="); number(exponential(fit.lower[2]));
        Console::write("half_dose_upper="); number(exponential(fit.upper[2]));
        transition { _ -> endpoints(observations, fit, 0) }
    }
    state endpoints(observations: &Observations, fit: &Fit, position: i32 in Wrapping) {
        transition position >= 0 && position < 8 {
            true -> endpoint(observations, fit, position)
            _ -> samples(observations, fit, 0)
        }
    }
    state endpoint(observations: &Observations, fit: &Fit, position: i32 in Wrapping) {
        Console::write("profile_endpoint_sse_"); Console::write_byte((position + 48) as i32); Console::write("=");
        number(fit.endpoint_sse[position]);
        transition { _ -> endpoints(observations, fit, position + 1) }
    }
    state samples(observations: &Observations, fit: &Fit, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> sample(observations, fit, position)
            _ -> done()
        }
    }
    state sample(observations: &Observations, fit: &Fit, position: i32 in Wrapping) {
        Console::write("prediction_"); Console::write_byte((position / 10 + 48) as i32);
        Console::write_byte((position % 10 + 48) as i32); Console::write("=");
        number(fit.reconstruction[position]);
        Console::write("residual_"); Console::write_byte((position / 10 + 48) as i32);
        Console::write_byte((position % 10 + 48) as i32); Console::write("=");
        number(fit.residual[position]);
        transition { _ -> samples(observations, fit, position + 1) }
    }
    state done() { Console::write_line("status=ok"); }
}
