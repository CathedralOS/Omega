use omega::language::core::float_operations;
use domain::model;
use domain::mathematics;

// Variable projection solves the two bounded linear asymptotes exactly for
// every nonlinear shape. Enumerating each box face also covers corners. Shape
// search uses an 81-point grid followed by damped reduced Gauss-Newton steps.
// Independent validation uses full four-variable bounded TRF, not this route.
data Moments {
    fractions: [f64; 32];
    uu: f64; uv: f64; vv: f64; uy: f64; vy: f64;
}
public machine fraction(role: i32, logarithm: f64, log_half: f64, hill: f64) -> f64 {
    transition role {
        1 -> 0.0
        2 -> 1.0
        _ -> (1.0 / (1.0 + exponential(0.0 - hill * (logarithm - log_half))))
    }
}
machine moments(observations: &Observations, sums: &mut Moments, log_half: f64, hill: f64) {
    sums.uu = 0.0; sums.uv = 0.0; sums.vv = 0.0; sums.uy = 0.0; sums.vy = 0.0;
    transition { _ -> scan(observations, sums, log_half, hill, 0) }
    machine scan(observations: &Observations, sums: &mut Moments, log_half: f64,
               hill: f64, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 && position < observations.group_count {
            true -> add(observations, sums, log_half, hill, position)
            _ -> done()
        }
    }
    machine add(observations: &Observations, sums: &mut Moments, log_half: f64,
              hill: f64, position: i32 in Wrapping) {
        let v: f64 = fraction(observations.group_role[position], observations.group_logarithm[position], log_half, hill);
        let u: f64 = 1.0 - v;
        let y: f64 = observations.group_mean[position];
        let weight: f64 = observations.group_weight[position];
        sums.fractions[position] = v;
        sums.uu = sums.uu + weight * u * u; sums.uv = sums.uv + weight * u * v;
        sums.vv = sums.vv + weight * v * v; sums.uy = sums.uy + weight * u * y; sums.vy = sums.vy + weight * v * y;
        transition { _ -> scan(observations, sums, log_half, hill, position + 1) }
    }
    machine done() { }
}
machine squared_error(observations: &Observations, sums: &Moments, low: f64, high: f64) -> f64 {
    transition { _ -> scan(observations, sums, low, high, 0, 0.0) }
    machine scan(observations: &Observations, sums: &Moments, low: f64, high: f64,
               position: i32 in Wrapping, total: f64) -> f64 {
        transition position >= 0 && position < 32 && position < observations.group_count {
            true -> add(observations, sums, low, high, position, total)
            _ -> total
        }
    }
    machine add(observations: &Observations, sums: &Moments, low: f64, high: f64,
              position: i32 in Wrapping, total: f64) -> f64 {
        let v: f64 = sums.fractions[position];
        let residual: f64 = observations.group_mean[position] - (low * (1.0 - v) + high * v);
        transition { _ -> scan(observations, sums, low, high, position + 1, total + observations.group_variance[position] + observations.group_weight[position] * residual * residual) }
    }
}
machine consider(observations: &Observations, sums: &Moments, best: &mut Candidate,
                 low: f64, high: f64) {
    let error: f64 = squared_error(observations, sums, low, high);
    transition error < best.sse {
        true -> accept(best, low, high, error)
        _ -> done()
    }
    machine accept(best: &mut Candidate, low: f64, high: f64, error: f64) {
        best.low = low; best.high = high; best.sse = error;
    }
    machine done() { }
}
machine score(observations: &Observations, query: &Profile, log_half: f64, hill: f64,
              best: &mut Candidate) {
    best.low = 0.0; best.high = 0.0; best.log_half = log_half; best.hill = hill;
    best.sse = 1.0e30; best.converged = false; best.iterations = 0;
    let mut sums: Moments;
    moments(observations, &mut sums, log_half, hill);
    transition sums.uu > 1.0e-20 && sums.vv > 1.0e-20 {
        true -> constrained(observations, query, best, &sums)
        _ -> done()
    }
    machine constrained(observations: &Observations, query: &Profile, best: &mut Candidate, sums: &Moments) {
        transition query.fixed {
            0 -> fixed_low(observations, query, best, sums)
            1 -> fixed_high(observations, query, best, sums)
            _ -> free(observations, best, sums)
        }
    }
    machine fixed_low(observations: &Observations, query: &Profile, best: &mut Candidate, sums: &Moments) {
        let high: f64 = clamp((sums.vy - query.value * sums.uv) / sums.vv, 0.0, 100.0);
        consider(observations, sums, best, query.value, high);
    }
    machine fixed_high(observations: &Observations, query: &Profile, best: &mut Candidate, sums: &Moments) {
        let low: f64 = clamp((sums.uy - query.value * sums.uv) / sums.uu, 0.0, 100.0);
        consider(observations, sums, best, low, query.value);
    }
    machine free(observations: &Observations, best: &mut Candidate, sums: &Moments) {
        consider(observations, sums, best, 0.0, clamp(sums.vy / sums.vv, 0.0, 100.0));
        consider(observations, sums, best, 100.0, clamp((sums.vy - 100.0 * sums.uv) / sums.vv, 0.0, 100.0));
        consider(observations, sums, best, clamp(sums.uy / sums.uu, 0.0, 100.0), 0.0);
        consider(observations, sums, best, clamp((sums.uy - 100.0 * sums.uv) / sums.uu, 0.0, 100.0), 100.0);
        let determinant: f64 = sums.uu * sums.vv - sums.uv * sums.uv;
        transition determinant > 1.0e-14 {
            true -> interior(observations, best, sums, determinant)
            _ -> done()
        }
    }
    machine interior(observations: &Observations, best: &mut Candidate, sums: &Moments, determinant: f64) {
        let low: f64 = (sums.uy * sums.vv - sums.vy * sums.uv) / determinant;
        let high: f64 = (sums.vy * sums.uu - sums.uy * sums.uv) / determinant;
        transition low >= 0.0 && low <= 100.0 && high >= 0.0 && high <= 100.0 {
            true -> evaluate(observations, best, sums, low, high)
            _ -> done()
        }
    }
    machine evaluate(observations: &Observations, best: &mut Candidate, sums: &Moments, low: f64, high: f64) {
        consider(observations, sums, best, low, high);
    }
    machine done() { }
}
machine copy_candidate(target: &mut Candidate, source: &Candidate) {
    target.low = source.low; target.high = source.high;
    target.log_half = source.log_half; target.hill = source.hill; target.sse = source.sse;
    target.converged = source.converged; target.iterations = source.iterations;
}
machine sample_shape(observations: &Observations, query: &Profile,
                     log_half: f64, hill: f64, candidate: &mut Candidate) {
    let t: f64 = clamp(log_half, observations.lower_log_half, observations.upper_log_half);
    let h: f64 = clamp(hill, 0.2, 5.0);
    transition query.fixed {
        2 -> fixed_half(observations, query, h, candidate)
        3 -> fixed_hill(observations, query, t, candidate)
        _ -> free(observations, query, t, h, candidate)
    }
    machine fixed_half(observations: &Observations, query: &Profile, hill: f64, candidate: &mut Candidate) {
        score(observations, query, query.value, hill, candidate);
    }
    machine fixed_hill(observations: &Observations, query: &Profile, log_half: f64, candidate: &mut Candidate) {
        score(observations, query, log_half, query.value, candidate);
    }
    machine free(observations: &Observations, query: &Profile, log_half: f64, hill: f64, candidate: &mut Candidate) {
        score(observations, query, log_half, hill, candidate);
    }
}
// Reduced Gauss-Newton curvature projects away the currently free linear
// asymptotes. Fixed or box-active asymptotes are excluded from that projection.
// Damped projected steps descend the actual residual objective; no local
// quadratic value substitutes for an observed objective.
data Curvature {
    low_low: f64;
    low_high: f64;
    high_high: f64;
    low_half: f64;
    low_hill: f64;
    high_half: f64;
    high_hill: f64;
    half_half: f64;
    half_hill: f64;
    hill_hill: f64;
    half_gradient: f64;
    hill_gradient: f64;
 }
machine curvature(observations: &Observations, query: &Profile, candidate: &Candidate,
                  sums: &mut Curvature) {
    sums.low_low = 0.0;
    sums.low_high = 0.0;
    sums.high_high = 0.0;
    sums.low_half = 0.0;
    sums.low_hill = 0.0;
    sums.high_half = 0.0;
    sums.high_hill = 0.0;
    sums.half_half = 0.0;
    sums.half_hill = 0.0;
    sums.hill_hill = 0.0;
    sums.half_gradient = 0.0;
    sums.hill_gradient = 0.0;
    transition { _ -> scan(observations, query, candidate, sums, 0) }
    machine scan(observations: &Observations, query: &Profile, candidate: &Candidate,
               sums: &mut Curvature, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 && position < observations.group_count {
            true -> row(observations, query, candidate, sums, position)
            _ -> project(observations, query, candidate, sums)
        }
    }
    machine row(observations: &Observations, query: &Profile, candidate: &Candidate,
              sums: &mut Curvature, position: i32 in Wrapping) {
        let high_basis: f64 = fraction(observations.group_role[position], observations.group_logarithm[position],
                                       candidate.log_half, candidate.hill);
        let low_basis: f64 = 1.0 - high_basis;
        let residual: f64 = observations.group_mean[position] - candidate.low * low_basis - candidate.high * high_basis;
        transition observations.group_role[position] == 0 {
            true -> sample(observations, query, candidate, sums, position, low_basis, high_basis, residual)
            _ -> add(observations, query, candidate, sums, position, low_basis, high_basis, residual, 0.0, 0.0)
        }
    }
    machine sample(observations: &Observations, query: &Profile, candidate: &Candidate,
                 sums: &mut Curvature, position: i32 in Wrapping, low_basis: f64,
                 high_basis: f64, residual: f64) {
        let derivative: f64 = (candidate.high - candidate.low) * high_basis * low_basis;
        let half_derivative: f64 = 0.0 - candidate.hill * derivative;
        let hill_derivative: f64 = (observations.group_logarithm[position] - candidate.log_half) * derivative;
        transition { _ -> add(observations, query, candidate, sums, position, low_basis, high_basis,
                               residual, half_derivative, hill_derivative) }
    }
    machine add(observations: &Observations, query: &Profile, candidate: &Candidate,
              sums: &mut Curvature, position: i32 in Wrapping, low_basis: f64,
              high_basis: f64, residual: f64, half_derivative: f64, hill_derivative: f64) {
        let weight: f64 = observations.group_weight[position];
        sums.low_low = sums.low_low + weight * low_basis * low_basis;
        sums.low_high = sums.low_high + weight * low_basis * high_basis;
        sums.high_high = sums.high_high + weight * high_basis * high_basis;
        sums.low_half = sums.low_half + weight * low_basis * half_derivative;
        sums.low_hill = sums.low_hill + weight * low_basis * hill_derivative;
        sums.high_half = sums.high_half + weight * high_basis * half_derivative;
        sums.high_hill = sums.high_hill + weight * high_basis * hill_derivative;
        sums.half_half = sums.half_half + weight * half_derivative * half_derivative;
        sums.half_hill = sums.half_hill + weight * half_derivative * hill_derivative;
        sums.hill_hill = sums.hill_hill + weight * hill_derivative * hill_derivative;
        sums.half_gradient = sums.half_gradient + weight * half_derivative * residual;
        sums.hill_gradient = sums.hill_gradient + weight * hill_derivative * residual;
        transition { _ -> scan(observations, query, candidate, sums, position + 1) }
    }
    machine project(observations: &Observations, query: &Profile, candidate: &Candidate, sums: &mut Curvature) {
        let low_free: bool = query.fixed != 0 && candidate.low > 0.00000001 && candidate.low < 99.99999999;
        let high_free: bool = query.fixed != 1 && candidate.high > 0.00000001 && candidate.high < 99.99999999;
        transition low_free && high_free {
            true -> both(observations, query, candidate, sums)
            _ -> one(observations, query, candidate, sums, low_free, high_free)
        }
    }
    machine both(observations: &Observations, query: &Profile, candidate: &Candidate, sums: &mut Curvature) {
        let determinant: f64 = sums.low_low * sums.high_high - sums.low_high * sums.low_high;
        transition determinant > 1.0e-14 {
            true -> inverse(observations, query, candidate, sums, determinant)
            _ -> constrain(observations, query, candidate, sums)
        }
    }
    machine inverse(observations: &Observations, query: &Profile, candidate: &Candidate,
                  sums: &mut Curvature, determinant: f64) {
        let low_half: f64 = (sums.high_high * sums.low_half - sums.low_high * sums.high_half) / determinant;
        let high_half: f64 = (sums.low_low * sums.high_half - sums.low_high * sums.low_half) / determinant;
        let low_hill: f64 = (sums.high_high * sums.low_hill - sums.low_high * sums.high_hill) / determinant;
        let high_hill: f64 = (sums.low_low * sums.high_hill - sums.low_high * sums.low_hill) / determinant;
        sums.half_half = sums.half_half - sums.low_half * low_half - sums.high_half * high_half;
        sums.half_hill = sums.half_hill - sums.low_half * low_hill - sums.high_half * high_hill;
        sums.hill_hill = sums.hill_hill - sums.low_hill * low_hill - sums.high_hill * high_hill;
        transition { _ -> constrain(observations, query, candidate, sums) }
    }
    machine one(observations: &Observations, query: &Profile, candidate: &Candidate,
              sums: &mut Curvature, low_free: bool, high_free: bool) {
        transition low_free && sums.low_low > 1.0e-20 {
            true -> subtract_low(observations, query, candidate, sums)
            _ -> select_high(observations, query, candidate, sums, high_free)
        }
    }
    machine subtract_low(observations: &Observations, query: &Profile, candidate: &Candidate, sums: &mut Curvature) {
        sums.half_half = sums.half_half - sums.low_half * sums.low_half / sums.low_low;
        sums.half_hill = sums.half_hill - sums.low_half * sums.low_hill / sums.low_low;
        sums.hill_hill = sums.hill_hill - sums.low_hill * sums.low_hill / sums.low_low;
        transition { _ -> constrain(observations, query, candidate, sums) }
    }
    machine select_high(observations: &Observations, query: &Profile, candidate: &Candidate,
                      sums: &mut Curvature, high_free: bool) {
        transition high_free && sums.high_high > 1.0e-20 {
            true -> subtract_high(observations, query, candidate, sums)
            _ -> constrain(observations, query, candidate, sums)
        }
    }
    machine subtract_high(observations: &Observations, query: &Profile, candidate: &Candidate, sums: &mut Curvature) {
        sums.half_half = sums.half_half - sums.high_half * sums.high_half / sums.high_high;
        sums.half_hill = sums.half_hill - sums.high_half * sums.high_hill / sums.high_high;
        sums.hill_hill = sums.hill_hill - sums.high_hill * sums.high_hill / sums.high_high;
        transition { _ -> constrain(observations, query, candidate, sums) }
    }
    machine constrain(observations: &Observations, query: &Profile, candidate: &Candidate, sums: &mut Curvature) {
        transition query.fixed == 2
            || (candidate.log_half <= observations.lower_log_half + 0.000000001 && sums.half_gradient < 0.0)
            || (candidate.log_half >= observations.upper_log_half - 0.000000001 && sums.half_gradient > 0.0) {
            true -> fixed_half(observations, query, candidate, sums)
            _ -> constrain_hill(query, candidate, sums)
        }
    }
    machine fixed_half(observations: &Observations, query: &Profile, candidate: &Candidate, sums: &mut Curvature) {
        sums.half_gradient = 0.0; sums.half_half = 1.0; sums.half_hill = 0.0;
        transition { _ -> constrain_hill(query, candidate, sums) }
    }
    machine constrain_hill(query: &Profile, candidate: &Candidate, sums: &mut Curvature) {
        transition query.fixed == 3
            || (candidate.hill <= 0.200000001 && sums.hill_gradient < 0.0)
            || (candidate.hill >= 4.999999999 && sums.hill_gradient > 0.0) {
            true -> fixed_hill(sums)
            _ -> done()
        }
    }
    machine fixed_hill(sums: &mut Curvature) { sums.hill_gradient = 0.0; sums.hill_hill = 1.0; sums.half_hill = 0.0; }
    machine done() { }
}
machine seed_grid(observations: &Observations, query: &Profile, seed: &Candidate, best: &mut Candidate,
                  t_count: i32 in Wrapping, h_count: i32 in Wrapping) {
    sample_shape(observations, query, seed.log_half, seed.hill, best);
    transition { _ -> grid(observations, query, best, t_count, h_count, 0, 0) }
    machine grid(observations: &Observations, query: &Profile, best: &mut Candidate,
               t_count: i32 in Wrapping, h_count: i32 in Wrapping,
               t_position: i32 in Wrapping, h_position: i32 in Wrapping) {
        let t: f64 = observations.lower_log_half + (observations.upper_log_half - observations.lower_log_half)
            * F64::from_i32(t_position as i32) / F64::from_i32(t_count as i32);
        let h: f64 = 0.2 + 4.8 * F64::from_i32(h_position as i32) / F64::from_i32(h_count as i32);
        let mut candidate: Candidate;
        sample_shape(observations, query, t, h, &mut candidate);
        transition candidate.sse < best.sse {
            true -> accept(observations, query, best, &candidate, t_count, h_count, t_position, h_position)
            _ -> next(observations, query, best, t_count, h_count, t_position, h_position)
        }
    }
    machine accept(observations: &Observations, query: &Profile, best: &mut Candidate, candidate: &Candidate,
                 t_count: i32 in Wrapping, h_count: i32 in Wrapping,
                 t_position: i32 in Wrapping, h_position: i32 in Wrapping) {
        copy_candidate(best, candidate);
        transition { _ -> next(observations, query, best, t_count, h_count, t_position, h_position) }
    }
    machine next(observations: &Observations, query: &Profile, best: &mut Candidate,
               t_count: i32 in Wrapping, h_count: i32 in Wrapping,
               t_position: i32 in Wrapping, h_position: i32 in Wrapping) {
        transition h_position < h_count {
            true -> grid(observations, query, best, t_count, h_count, t_position, h_position + 1)
            _ -> next_t(observations, query, best, t_count, h_count, t_position)
        }
    }
    machine next_t(observations: &Observations, query: &Profile, best: &mut Candidate,
                 t_count: i32 in Wrapping, h_count: i32 in Wrapping, t_position: i32 in Wrapping) {
        transition t_position < t_count {
            true -> grid(observations, query, best, t_count, h_count, t_position + 1, 0)
            _ -> done()
        }
    }
    machine done() { }
}
machine newton(observations: &Observations, query: &Profile, best: &mut Candidate) {
    transition { _ -> iteration(observations, query, best, 0.000001, 0) }
    machine iteration(observations: &Observations, query: &Profile, best: &mut Candidate,
                    damping: f64, count: i32 in Wrapping) {
        let mut sums: Curvature;
        curvature(observations, query, best, &mut sums);
        best.iterations = count + 1;
        transition magnitude(sums.half_gradient) < 0.0000001 * clamp(sums.half_half, 0.000000000001, 1.0e30)
            && magnitude(sums.hill_gradient) < 0.0000001 * clamp(sums.hill_hill, 0.000000000001, 1.0e30) {
            true -> converged(best, count + 1)
            _ -> trial(observations, query, best, &sums, damping, count, 0)
        }
    }
    machine trial(observations: &Observations, query: &Profile, best: &mut Candidate, sums: &Curvature,
                damping: f64, count: i32 in Wrapping, attempt: i32 in Wrapping) {
        let half_diagonal: f64 = sums.half_half + damping * clamp(sums.half_half, 1.0, 1.0e30);
        let hill_diagonal: f64 = sums.hill_hill + damping * clamp(sums.hill_hill, 1.0, 1.0e30);
        let determinant: f64 = half_diagonal * hill_diagonal - sums.half_hill * sums.half_hill;
        transition determinant > 1.0e-25 {
            true -> step(observations, query, best, sums, half_diagonal, hill_diagonal, determinant, damping, count, attempt)
            _ -> retry(observations, query, best, sums, damping, count, attempt, 1.0)
        }
    }
    machine step(observations: &Observations, query: &Profile, best: &mut Candidate, sums: &Curvature,
               half_diagonal: f64, hill_diagonal: f64, determinant: f64,
               damping: f64, count: i32 in Wrapping, attempt: i32 in Wrapping) {
        let half_step: f64 = clamp((hill_diagonal * sums.half_gradient - sums.half_hill * sums.hill_gradient) / determinant, -1.0, 1.0);
        let hill_step: f64 = clamp((half_diagonal * sums.hill_gradient - sums.half_hill * sums.half_gradient) / determinant, -1.0, 1.0);
        let mut candidate: Candidate;
        sample_shape(observations, query, best.log_half + half_step, best.hill + hill_step, &mut candidate);
        let movement: f64 = clamp(magnitude(candidate.log_half - best.log_half), magnitude(candidate.hill - best.hill), 1.0e30);
        transition candidate.sse < best.sse {
            true -> accept(observations, query, best, &candidate, damping, count, movement)
            _ -> retry(observations, query, best, sums, damping, count, attempt,
                        clamp(magnitude(half_step), magnitude(hill_step), 1.0e30))
        }
    }
    machine accept(observations: &Observations, query: &Profile, best: &mut Candidate,
                 candidate: &Candidate, damping: f64, count: i32 in Wrapping, movement: f64) {
        copy_candidate(best, candidate);
        transition { _ -> budget(observations, query, best, clamp(damping / 3.0, 0.0000000001, 1.0e30), count + 1) }
    }
    machine retry(observations: &Observations, query: &Profile, best: &mut Candidate, sums: &Curvature,
                damping: f64, count: i32 in Wrapping, attempt: i32 in Wrapping, movement: f64) {
        transition magnitude(sums.half_gradient) < 0.0000001 * clamp(sums.half_half, 0.000000000001, 1.0e30)
            && magnitude(sums.hill_gradient) < 0.0000001 * clamp(sums.hill_hill, 0.000000000001, 1.0e30) {
            true -> converged(best, count + 1)
            _ -> attempts(observations, query, best, sums, damping, count, attempt)
        }
    }
    machine attempts(observations: &Observations, query: &Profile, best: &mut Candidate, sums: &Curvature,
                   damping: f64, count: i32 in Wrapping, attempt: i32 in Wrapping) {
        transition attempt < 19 {
            true -> trial(observations, query, best, sums, damping * 10.0, count, attempt + 1)
            _ -> done()
        }
    }
    machine budget(observations: &Observations, query: &Profile, best: &mut Candidate,
                 damping: f64, count: i32 in Wrapping) {
        transition count < 100 {
            true -> iteration(observations, query, best, damping, count)
            _ -> done()
        }
    }
    machine converged(best: &mut Candidate, count: i32 in Wrapping) { best.iterations = count; best.converged = true; }
    machine done() { }
}
// With one nonlinear shape fixed, eliminate linear coefficients and minimize
// the remaining scalar shape in a bracket around the best 17-point scan.
data AxisSearch {
    lower: f64; upper: f64; left: f64; right: f64;
    left_value: Candidate; right_value: Candidate;
}
machine axis_score(observations: &Observations, query: &Profile, axis: f64, candidate: &mut Candidate) {
    sample_shape(observations, query, axis, axis, candidate);
}
machine golden(observations: &Observations, query: &Profile, best: &mut Candidate,
               lower: f64, upper: f64) {
    best.sse = 1.0e30; best.converged = false; best.iterations = 0;
    transition { _ -> scan(observations, query, best, lower, upper, 0, 0) }
    machine scan(observations: &Observations, query: &Profile, best: &mut Candidate,
               lower: f64, upper: f64, position: i32 in Wrapping, best_position: i32 in Wrapping) {
        let axis: f64 = lower + (upper - lower) * F64::from_i32(position as i32) / 16.0;
        let mut candidate: Candidate;
        axis_score(observations, query, axis, &mut candidate);
        transition candidate.sse < best.sse {
            true -> accept(observations, query, best, &candidate, lower, upper, position)
            _ -> next(observations, query, best, lower, upper, position, best_position)
        }
    }
    machine accept(observations: &Observations, query: &Profile, best: &mut Candidate,
                 candidate: &Candidate, lower: f64, upper: f64, position: i32 in Wrapping) {
        copy_candidate(best, candidate);
        transition { _ -> next(observations, query, best, lower, upper, position, position) }
    }
    machine next(observations: &Observations, query: &Profile, best: &mut Candidate,
               lower: f64, upper: f64, position: i32 in Wrapping, best_position: i32 in Wrapping) {
        transition position < 16 {
            true -> scan(observations, query, best, lower, upper, position + 1, best_position)
            _ -> begin(observations, query, best, lower, upper, best_position)
        }
    }
    machine begin(observations: &Observations, query: &Profile, best: &mut Candidate,
                lower: f64, upper: f64, position: i32 in Wrapping) {
        let center: f64 = lower + (upper - lower) * F64::from_i32(position as i32) / 16.0;
        let spacing: f64 = (upper - lower) / 16.0;
        let mut search: AxisSearch;
        search.lower = clamp(center - spacing, lower, upper);
        search.upper = clamp(center + spacing, lower, upper);
        search.left = search.upper - 0.6180339887498948482 * (search.upper - search.lower);
        search.right = search.lower + 0.6180339887498948482 * (search.upper - search.lower);
        axis_score(observations, query, search.left, &mut search.left_value);
        axis_score(observations, query, search.right, &mut search.right_value);
        transition { _ -> iterate(observations, query, best, &mut search, 0) }
    }
    machine iterate(observations: &Observations, query: &Profile, best: &mut Candidate,
                  search: &mut AxisSearch, count: i32 in Wrapping) {
        transition search.left_value.sse < best.sse {
            true -> accept_left(observations, query, best, search, count)
            _ -> select_right(observations, query, best, search, count)
        }
    }
    machine accept_left(observations: &Observations, query: &Profile, best: &mut Candidate,
                      search: &mut AxisSearch, count: i32 in Wrapping) {
        copy_candidate(best, &search.left_value);
        transition { _ -> select_right(observations, query, best, search, count) }
    }
    machine select_right(observations: &Observations, query: &Profile, best: &mut Candidate,
                       search: &mut AxisSearch, count: i32 in Wrapping) {
        transition search.right_value.sse < best.sse {
            true -> accept_right(observations, query, best, search, count)
            _ -> decision(observations, query, best, search, count)
        }
    }
    machine accept_right(observations: &Observations, query: &Profile, best: &mut Candidate,
                       search: &mut AxisSearch, count: i32 in Wrapping) {
        copy_candidate(best, &search.right_value);
        transition { _ -> decision(observations, query, best, search, count) }
    }
    machine decision(observations: &Observations, query: &Profile, best: &mut Candidate,
                   search: &mut AxisSearch, count: i32 in Wrapping) {
        transition count >= 32 {
            true -> finish(best, search, count)
            _ -> narrow(observations, query, best, search, count)
        }
    }
    machine narrow(observations: &Observations, query: &Profile, best: &mut Candidate,
                 search: &mut AxisSearch, count: i32 in Wrapping) {
        transition search.left_value.sse < search.right_value.sse {
            true -> left(observations, query, best, search, count)
            _ -> right(observations, query, best, search, count)
        }
    }
    machine left(observations: &Observations, query: &Profile, best: &mut Candidate,
               search: &mut AxisSearch, count: i32 in Wrapping) {
        search.upper = search.right; search.right = search.left;
        copy_candidate(&mut search.right_value, &search.left_value);
        search.left = search.upper - 0.6180339887498948482 * (search.upper - search.lower);
        axis_score(observations, query, search.left, &mut search.left_value);
        transition { _ -> iterate(observations, query, best, search, count + 1) }
    }
    machine right(observations: &Observations, query: &Profile, best: &mut Candidate,
                search: &mut AxisSearch, count: i32 in Wrapping) {
        search.lower = search.left; search.left = search.right;
        copy_candidate(&mut search.left_value, &search.right_value);
        search.right = search.lower + 0.6180339887498948482 * (search.upper - search.lower);
        axis_score(observations, query, search.right, &mut search.right_value);
        transition { _ -> iterate(observations, query, best, search, count + 1) }
    }
    machine finish(best: &mut Candidate, search: &AxisSearch, count: i32 in Wrapping) {
        best.iterations = count;
        best.converged = (search.upper - search.lower < 0.000001);
    }
}
machine optimize(observations: &Observations, query: &Profile, seed: &Candidate, best: &mut Candidate) {
    transition query.fixed {
        2 -> half_fixed(observations, query, best)
        3 -> hill_fixed(observations, query, best)
        _ -> dimensions(observations, query, seed, best)
    }
    machine half_fixed(observations: &Observations, query: &Profile, best: &mut Candidate) {
        golden(observations, query, best, 0.2, 5.0);
    }
    machine hill_fixed(observations: &Observations, query: &Profile, best: &mut Candidate) {
        golden(observations, query, best, observations.lower_log_half, observations.upper_log_half);
    }
    machine dimensions(observations: &Observations, query: &Profile, seed: &Candidate, best: &mut Candidate) {
        transition query.fixed < 0 {
            true -> full(observations, query, seed, best)
            _ -> nuisance(observations, query, seed, best)
        }
    }
    machine full(observations: &Observations, query: &Profile, seed: &Candidate, best: &mut Candidate) {
        seed_grid(observations, query, seed, best, 8, 8);
        newton(observations, query, best);
    }
    machine nuisance(observations: &Observations, query: &Profile, seed: &Candidate, best: &mut Candidate) {
        seed_grid(observations, query, seed, best, 4, 2);
        newton(observations, query, best);
    }
}
// Direct asymptote controls give a rigorous lower bound on a profile's SSE.
// Exclusion needs no nuisance optimization when this contribution alone is
// above the cutoff. This bound is never reported as a converged fit or as a
// profile endpoint's fitted objective.
machine control_bound(observations: &Observations, parameter: i32, value: f64) -> f64 {
    transition { _ -> scan(observations, parameter, value, 0, 0.0) }
    machine scan(observations: &Observations, parameter: i32, value: f64,
               position: i32 in Wrapping, sum: f64) -> f64 {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> row(observations, parameter, value, position, sum)
            _ -> sum
        }
    }
    machine row(observations: &Observations, parameter: i32, value: f64,
              position: i32 in Wrapping, sum: f64) -> f64 {
        transition (parameter == 0 && observations.role[position] == 1)
            || (parameter == 1 && observations.role[position] == 2) {
            true -> add(observations, parameter, value, position, sum)
            _ -> scan(observations, parameter, value, position + 1, sum)
        }
    }
    machine add(observations: &Observations, parameter: i32, value: f64,
              position: i32 in Wrapping, sum: f64) -> f64 {
        let residual: f64 = value - observations.response[position];
        transition { _ -> scan(observations, parameter, value, position + 1, sum + residual * residual) }
    }
}
machine bounds(observations: &mut Observations) {
    observations.lower_log_half = 1.0e30; observations.upper_log_half = 0.0;
    transition { _ -> scan(observations, 0) }
    machine scan(observations: &mut Observations, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> row(observations, position)
            _ -> finish(observations)
        }
    }
    machine row(observations: &mut Observations, position: i32 in Wrapping) {
        transition observations.role[position] == 0 {
            true -> update(observations, position)
            _ -> scan(observations, position + 1)
        }
    }
    machine update(observations: &mut Observations, position: i32 in Wrapping) {
        observations.lower_log_half = clamp(observations.logarithm[position], 0.0, observations.lower_log_half);
        observations.upper_log_half = clamp(observations.logarithm[position], observations.upper_log_half, 100.0);
        transition { _ -> scan(observations, position + 1) }
    }
    machine finish(observations: &mut Observations) {
        observations.lower_log_half = observations.lower_log_half - 2.30258509299404568402;
        observations.upper_log_half = observations.upper_log_half + 2.30258509299404568402;
    }
}
machine parameter(candidate: &Candidate, position: i32) -> f64 {
    transition position {
        0 -> candidate.low
        1 -> candidate.high
        2 -> candidate.log_half
        _ -> candidate.hill
    }
}
machine domain_edge(observations: &Observations, position: i32, side: i32) -> f64 {
    transition position {
        2 -> log_half(observations, side)
        3 -> hill(side)
        _ -> asymptote(side)
    }
    machine log_half(observations: &Observations, side: i32) -> f64 {
        transition side == 0 { true -> observations.lower_log_half _ -> observations.upper_log_half }
    }
    machine hill(side: i32) -> f64 { transition side == 0 { true -> 0.2 _ -> 5.0 } }
    machine asymptote(side: i32) -> f64 { transition side == 0 { true -> 0.0 _ -> 100.0 } }
}
// A hard parameter bound does not establish a confidence endpoint. Every
// profile must cross the nominal 95% known-sigma threshold on both sides.
// An open profile, failed nuisance minimization or wrong direction is refused.
machine profile_endpoint(observations: &Observations, fit: &mut Fit,
                         position: i32 in Wrapping, side: i32) -> bool {
    let edge: f64 = domain_edge(observations, position as i32, side);
    let center: f64 = parameter(&fit.candidate, position as i32);
    let exclusion: f64 = control_bound(observations, position as i32, edge);
    transition exclusion > fit.cutoff {
        true -> bisect(observations, fit, position, side, center, edge, 0)
        _ -> optimize_edge(observations, fit, position, side, center, edge)
    }
    machine optimize_edge(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping,
                        side: i32, center: f64, edge: f64) -> bool {
        let query: Profile = Profile { fixed: position as i32, value: edge };
        let mut candidate: Candidate;
        optimize(observations, &query, &fit.candidate, &mut candidate);
        transition candidate.converged && candidate.sse > fit.cutoff {
            true -> bisect(observations, fit, position, side, center, edge, 0)
            _ -> false
        }
    }
    machine bisect(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping,
                 side: i32, inside: f64, outside: f64, iteration: i32 in Wrapping) -> bool {
        let middle: f64 = (inside + outside) / 2.0;
        let exclusion: f64 = control_bound(observations, position as i32, middle);
        transition exclusion > fit.cutoff && iteration < 22 {
            true -> bisect(observations, fit, position, side, inside, middle, iteration + 1)
            _ -> optimize_middle(observations, fit, position, side, inside, outside, middle, iteration)
        }
    }
    machine optimize_middle(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping,
                          side: i32, inside: f64, outside: f64, middle: f64, iteration: i32 in Wrapping) -> bool {
        let query: Profile = Profile { fixed: position as i32, value: middle };
        let mut candidate: Candidate;
        optimize(observations, &query, &fit.candidate, &mut candidate);
        transition candidate.converged {
            true -> classify(observations, fit, position, side, inside, outside, middle, &candidate, iteration)
            _ -> false
        }
    }
    machine classify(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping,
                   side: i32, inside: f64, outside: f64, middle: f64,
                   candidate: &Candidate, iteration: i32 in Wrapping) -> bool {
        transition iteration >= 22 {
            true -> capacity(fit, position, side, middle, candidate.sse)
            _ -> branch(observations, fit, position, side, inside, outside, middle, candidate.sse, iteration)
        }
    }
    machine branch(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping,
                 side: i32, inside: f64, outside: f64, middle: f64, error: f64,
                 iteration: i32 in Wrapping) -> bool {
        transition error > fit.cutoff {
            true -> bisect(observations, fit, position, side, inside, middle, iteration + 1)
            _ -> bisect(observations, fit, position, side, middle, outside, iteration + 1)
        }
    }
    machine capacity(fit: &mut Fit, position: i32 in Wrapping, side: i32, value: f64, error: f64) -> bool {
        let slot: i32 in Wrapping = position * 2 + side as i32 in Wrapping;
        transition position >= 0 && position < 4 && slot >= 0 && slot < 8 {
            true -> store(fit, position, slot, side, value, error)
            _ -> false
        }
    }
    machine store(fit: &mut Fit, position: i32 in Wrapping, slot: i32 in Wrapping,
                side: i32, value: f64, error: f64) -> bool {
        fit.endpoint_sse[slot] = error;
        transition side == 0 {
            true -> lower(fit, position, value)
            _ -> upper(fit, position, value)
        }
    }
    machine lower(fit: &mut Fit, position: i32 in Wrapping, value: f64) -> bool {
        fit.lower[position] = value; true
    }
    machine upper(fit: &mut Fit, position: i32 in Wrapping, value: f64) -> bool {
        fit.upper[position] = value; true
    }
}
public machine fit_curve(observations: &mut Observations, fit: &mut Fit) {
    fit.status = 6;
    bounds(observations);
    group_replicates(observations);
    let seed: Candidate = Candidate { low: 0.0, high: 100.0,
        log_half: (observations.lower_log_half + observations.upper_log_half) / 2.0,
        hill: 1.0, sse: 1.0e30, converged: false, iterations: 0 };
    let query: Profile = Profile { fixed: -1, value: 0.0 };
    optimize(observations, &query, &seed, &mut fit.candidate);
    fit.cutoff = fit.candidate.sse + 3.841458820694124 * observations.sigma * observations.sigma;
    transition fit.candidate.converged {
        true -> amplitude(observations, fit)
        _ -> done()
    }
    machine amplitude(observations: &Observations, fit: &mut Fit) {
        transition magnitude(fit.candidate.high - fit.candidate.low) > 5.0 * observations.sigma {
            true -> direction(observations, fit)
            _ -> flat(fit)
        }
    }
    machine direction(observations: &Observations, fit: &mut Fit) {
        let signed_amplitude: f64 = (fit.candidate.high - fit.candidate.low) * F64::from_i32(observations.direction);
        transition signed_amplitude > 0.0 {
            true -> profiles(observations, fit, 0, 0)
            _ -> wrong_direction(fit)
        }
    }
    machine profiles(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping, side: i32) {
        transition position >= 0 && position < 4 {
            true -> endpoint(observations, fit, position, side)
            _ -> reconstruct(observations, fit, 0)
        }
    }
    machine endpoint(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping, side: i32) {
        let closed: bool = profile_endpoint(observations, fit, position, side);
        transition closed {
            true -> next(observations, fit, position, side)
            _ -> unidentified(fit)
        }
    }
    machine next(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping, side: i32) {
        transition side == 0 {
            true -> profiles(observations, fit, position, 1)
            _ -> profiles(observations, fit, position + 1, 0)
        }
    }
    machine reconstruct(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> row(observations, fit, position)
            _ -> success(fit)
        }
    }
    machine row(observations: &Observations, fit: &mut Fit, position: i32 in Wrapping) {
        let v: f64 = fraction(observations.role[position], observations.logarithm[position],
                               fit.candidate.log_half, fit.candidate.hill);
        let predicted: f64 = fit.candidate.low * (1.0 - v) + fit.candidate.high * v;
        fit.reconstruction[position] = predicted;
        fit.residual[position] = observations.response[position] - predicted;
        transition { _ -> reconstruct(observations, fit, position + 1) }
    }
    machine flat(fit: &mut Fit) { fit.status = 3; }
    machine unidentified(fit: &mut Fit) { fit.status = 4; }
    machine wrong_direction(fit: &mut Fit) { fit.status = 5; }
    machine success(fit: &mut Fit) { fit.status = 0; }
    machine done() { }
}
// Grouping is a sufficient-statistic calculation, not replicate averaging that
// discards noise: SSE = within-group SSE + weight*(mean-prediction)^2. Original
// rows remain available for every reported prediction and residual. Welford
// accumulation avoids cancellation in the retained within-group variance.
machine group_replicates(observations: &mut Observations) {
    observations.group_count = 0;
    transition { _ -> row(observations, 0) }
    machine row(observations: &mut Observations, position: i32 in Wrapping) {
        transition position >= 0 && position < 32 && position < observations.count {
            true -> search(observations, position, 0)
            _ -> done()
        }
    }
    machine search(observations: &mut Observations, position: i32 in Wrapping, group: i32 in Wrapping) {
        transition group >= 0 && group < 32 {
            true -> capacity(observations, position, group)
            _ -> done()
        }
    }
    machine capacity(observations: &mut Observations, position: i32 in Wrapping, group: i32 in Wrapping) {
        transition group < observations.group_count {
            true -> compare(observations, position, group)
            _ -> initialize(observations, position, group)
        }
    }
    machine compare(observations: &mut Observations, position: i32 in Wrapping, group: i32 in Wrapping) {
        transition observations.group_dose[group] == observations.dose[position]
            && observations.group_role[group] == observations.role[position] {
            true -> accumulate(observations, position, group)
            _ -> search(observations, position, group + 1)
        }
    }
    machine initialize(observations: &mut Observations, position: i32 in Wrapping, group: i32 in Wrapping) {
        observations.group_dose[group] = observations.dose[position];
        observations.group_role[group] = observations.role[position];
        observations.group_logarithm[group] = observations.logarithm[position];
        observations.group_mean[group] = 0.0;
        observations.group_weight[group] = 0.0;
        observations.group_variance[group] = 0.0;
        observations.group_count = observations.group_count + 1;
        transition { _ -> accumulate(observations, position, group) }
    }
    machine accumulate(observations: &mut Observations, position: i32 in Wrapping, group: i32 in Wrapping) {
        let response: f64 = observations.response[position];
        let weight: f64 = observations.group_weight[group] + 1.0;
        let delta: f64 = response - observations.group_mean[group];
        let mean: f64 = observations.group_mean[group] + delta / weight;
        observations.group_variance[group] = observations.group_variance[group] + delta * (response - mean);
        observations.group_mean[group] = mean;
        observations.group_weight[group] = weight;
        transition { _ -> row(observations, position + 1) }
    }
    machine done() { }
}
