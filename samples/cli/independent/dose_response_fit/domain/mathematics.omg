use omega::language::core::float_operations;
// Bounded private scalar evaluators. Validated positive integer doses are
// <=10000; log-half bounds extend measured doses by a factor ten, and hill
// is [.2,5]. Thus every exponential argument has magnitude below 70.
public machine exponential(value: f64) -> f64 {
    let reduced: f64 = value / 128.0;
    transition { _ -> term(reduced, 1.0, 1.0, 1.0, 1) }
    machine term(reduced: f64, sum: f64, previous: f64, denominator: f64,
               count: i32 in Wrapping) -> f64 {
        let next: f64 = previous * reduced / denominator;
        transition count < 16 {
            true -> term(reduced, sum + next, next, denominator + 1.0, count + 1)
            _ -> square(sum + next)
        }
    }
    machine square(value: f64) -> f64 {
        let power2: f64 = value * value;
        let power4: f64 = power2 * power2;
        let power8: f64 = power4 * power4;
        let power16: f64 = power8 * power8;
        let power32: f64 = power16 * power16;
        let power64: f64 = power32 * power32;
        power64 * power64
    }
}
public machine logarithm(value: f64) -> f64 {
    transition { _ -> normalize(value, 0.0) }
    machine normalize(value: f64, exponent: f64) -> f64 {
        transition value >= 2.0 {
            true -> normalize(value / 2.0, exponent + 1.0)
            _ -> begin(value, exponent)
        }
    }
    machine begin(value: f64, exponent: f64) -> f64 {
        let ratio: f64 = (value - 1.0) / (value + 1.0);
        transition { _ -> series(ratio * ratio, ratio, 0.0, 1.0, exponent, 0) }
    }
    machine series(square: f64, term: f64, sum: f64, denominator: f64,
                 exponent: f64, count: i32 in Wrapping) -> f64 {
        transition count < 24 {
            true -> series(square, term * square, sum + term / denominator,
                           denominator + 2.0, exponent, count + 1)
            _ -> (2.0 * sum + exponent * 0.69314718055994530942)
        }
    }
}
public machine clamp(value: f64, lower: f64, upper: f64) -> f64 {
    transition value < lower { true -> lower _ -> maximum(value, upper) }
    machine maximum(value: f64, upper: f64) -> f64 {
        transition value > upper { true -> upper _ -> value }
    }
}
public machine magnitude(value: f64) -> f64 {
    transition value < 0.0 { true -> (0.0 - value) _ -> value }
}
