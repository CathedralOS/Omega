// Read supplied dose/replicate/control observations, fit and profile a 4PL.
// Expected exit: 2.
// Expected output contains: error=input:
use omega_language_std::console;
use domain::model;
use domain::input;
use domain::fit;
use domain::report;

data Main { reader: InputReader; }
machine Main::main(main: &mut Main) reaches Console {
    main.reader.remaining = 4096; main.reader.exhausted = false;
    let mut observations: Observations;
    let valid: bool = block read_input(&mut main.reader, &mut observations);
    transition valid {
        true -> fit(main, &mut observations)
        _ -> invalid(main)
    }
    state fit(main: &mut Main, observations: &mut Observations) {
        let mut result: Fit;
        fit_curve(observations, &mut result);
        transition result.status {
            0 -> output(main, observations, &result)
            3 -> flat(main)
            4 -> unidentified(main)
            5 -> direction(main)
            _ -> convergence(main)
        }
    }
    state output(main: &mut Main, observations: &Observations, result: &Fit) {
        report(observations, result);
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) {
        Console::write_line("error=input: invalid or duplicate observation; require 8..32 rows, at least five sample doses, valid direction/noise/roles and <=4096 bytes");
        Console::exit_process(2);
    }
    state flat(main: &mut Main) {
        Console::write_line("converged=true"); Console::write_line("identifiable=false");
        Console::write_line("error=flat: fitted amplitude must exceed five supplied noise standard deviations");
        Console::exit_process(3);
    }
    state unidentified(main: &mut Main) {
        Console::write_line("identifiable=false");
        Console::write_line("error=unidentified: profile failed to close strictly within parameter bounds or nuisance minimization did not converge");
        Console::exit_process(4);
    }
    state direction(main: &mut Main) {
        Console::write_line("converged=true"); Console::write_line("identifiable=false");
        Console::write_line("error=direction: fitted response contradicts requested activation or inhibition");
        Console::exit_process(5);
    }
    state convergence(main: &mut Main) {
        Console::write_line("converged=false"); Console::write_line("identifiable=false");
        Console::write_line("error=convergence: bounded numerical search exhausted its iteration limit");
        Console::exit_process(6);
    }
}
