use landcover::geometry;
// Private area buckets: no-data is class 0; classes 1..3 are categorical.
// Outside coverage is distinct from source no-data and participates in closure.
public data Areas [copy] {
    forest: i32 in Wrapping; water: i32 in Wrapping;
    urban: i32 in Wrapping; nodata: i32 in Wrapping;
}
public machine deposit(areas: &mut Areas, category: i32 in Wrapping, area: i32 in Wrapping) {
    transition category {
        1 -> forest(areas, area)
        2 -> water(areas, area)
        3 -> urban(areas, area)
        _ -> nodata(areas, area)
    }
    machine forest(areas: &mut Areas, area: i32 in Wrapping) { areas.forest = areas.forest + area; }
    machine water(areas: &mut Areas, area: i32 in Wrapping) { areas.water = areas.water + area; }
    machine urban(areas: &mut Areas, area: i32 in Wrapping) { areas.urban = areas.urban + area; }
    machine nodata(areas: &mut Areas, area: i32 in Wrapping) { areas.nodata = areas.nodata + area; }
}
public machine resample(areas: &mut Areas, x: i32 in Wrapping, y: i32 in Wrapping,
    width: i32 in Wrapping, height: i32 in Wrapping,
    a: i32 in Wrapping, b: i32 in Wrapping, c: i32 in Wrapping, d: i32 in Wrapping) {
    areas.forest = 0; areas.water = 0; areas.urban = 0; areas.nodata = 0;
    let first: i32 in Wrapping = overlap(x, y, width, height, 0, 0);
    let second: i32 in Wrapping = overlap(x, y, width, height, 2, 0);
    let third: i32 in Wrapping = overlap(x, y, width, height, 0, 2);
    let fourth: i32 in Wrapping = overlap(x, y, width, height, 2, 2);
    deposit(areas, a, first); deposit(areas, b, second);
    deposit(areas, c, third); deposit(areas, d, fourth);
}
public machine dominant(areas: &Areas) -> i32 in Wrapping {
    // Ordered comparisons preserve the lowest class identifier on a tie.
    transition areas.forest >= areas.water && areas.forest >= areas.urban && areas.forest > 0 {
        true -> 1
        false -> other(areas)
    }
    machine other(areas: &Areas) -> i32 in Wrapping {
        transition areas.water >= areas.urban && areas.water > 0 { true -> 2 false -> last(areas) }
    }
    machine last(areas: &Areas) -> i32 in Wrapping {
        transition areas.urban > 0 { true -> 3 false -> 0 }
    }
}
