// Complete bounded CLI: choose a fixture with one ASCII digit and LF.
use omega_language_std::console;
use landcover::geometry;
use landcover::resampling;
use fixtures::catalog;

data Main {
    input: [u8; 4];
    config: Configuration; cell: Areas; totals: Areas; clipped: Areas;
    column: i32 in Wrapping; row: i32 in Wrapping; area: i32 in Wrapping;
    outside: i32 in Wrapping; outside_total: i32 in Wrapping;
}
// Bounded decimal reporting uses byte output, preserving exact integer values.
machine number(main: &mut Main, value: i32 in Wrapping) reaches Console {
    Console::write_byte((value / 100 % 10 + 48) as i32);
    Console::write_byte((value / 10 % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
}
machine fraction(main: &mut Main, numerator: i32 in Wrapping, denominator: i32 in Wrapping) reaches Console {
    number(main, numerator); Console::write("/"); number(main, denominator); Console::write(" ");
}
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("LANDCOVER exact planar area; enter fixture 1..6 (7..9 invalid)");
    let read: LineReadResult = block Console::read_line(&mut main.input);
    transition read {
        LineReadResult::LineComplete { count } -> length(main, count)
        _ -> invalid(main)
    }
    state length(main: &mut Main, count: u64) {
        transition count == 2 { true -> parse(main) false -> invalid(main) }
    }
    state parse(main: &mut Main) {
        transition main.input[0] >= 49 && main.input[0] <= 57 && main.input[1] == 10 {
            true -> setup(main) false -> invalid(main)
        }
    }
    state setup(main: &mut Main) {
        configure(&mut main.config, main.input[0]);
        transition main.config.grid.width > 0 && main.config.grid.width <= 4 &&
            main.config.grid.height > 0 && main.config.grid.height <= 4 &&
            main.config.grid.columns > 0 && main.config.grid.columns <= 4 &&
            main.config.grid.rows > 0 && main.config.grid.rows <= 4 &&
            main.config.grid.x >= 0 && main.config.grid.x <= 8 &&
            main.config.grid.y >= 0 && main.config.grid.y <= 8 &&
            main.config.a >= 0 && main.config.a <= 3 && main.config.b >= 0 && main.config.b <= 3 &&
            main.config.c >= 0 && main.config.c <= 3 && main.config.d >= 0 && main.config.d <= 3 {
            true -> start(main) false -> invalid(main)
        }
    }
    state start(main: &mut Main) {
        main.column = 0; main.row = 0; main.outside_total = 0;
        main.totals.forest = 0; main.totals.water = 0; main.totals.urban = 0; main.totals.nodata = 0;
        main.area = main.config.grid.width * main.config.grid.height;
        Console::write_line("CELL row col forest water urban nodata outside dominant (fractions of full cell)");
        transition { _ -> cell(main) }
    }
    state cell(main: &mut Main) {
        let x: i32 in Wrapping = main.config.grid.x + main.column * main.config.grid.width;
        let y: i32 in Wrapping = main.config.grid.y + main.row * main.config.grid.height;
        resample(&mut main.cell, x, y, main.config.grid.width, main.config.grid.height,
            main.config.a, main.config.b, main.config.c, main.config.d);
        main.outside = main.area - main.cell.forest - main.cell.water - main.cell.urban - main.cell.nodata;
        transition main.outside >= 0 { true -> report(main) false -> failed(main) }
    }
    state report(main: &mut Main) {
        // Stage immutable report values before borrowing the complete context.
        let row: i32 in Wrapping = main.row;
        let column: i32 in Wrapping = main.column;
        let forest: i32 in Wrapping = main.cell.forest;
        let water: i32 in Wrapping = main.cell.water;
        let urban: i32 in Wrapping = main.cell.urban;
        let nodata: i32 in Wrapping = main.cell.nodata;
        let outside: i32 in Wrapping = main.outside;
        let area: i32 in Wrapping = main.area;
        let winner: i32 in Wrapping = dominant(&main.cell);
        Console::write("CELL "); number(main, row); Console::write(" "); number(main, column); Console::write(" ");
        fraction(main, forest, area); fraction(main, water, area);
        fraction(main, urban, area); fraction(main, nodata, area); fraction(main, outside, area);
        number(main, winner); Console::write_line("");
        main.totals.forest = main.totals.forest + main.cell.forest;
        main.totals.water = main.totals.water + main.cell.water;
        main.totals.urban = main.totals.urban + main.cell.urban;
        main.totals.nodata = main.totals.nodata + main.cell.nodata;
        main.outside_total = main.outside_total + main.outside;
        main.column = main.column + 1;
        transition main.column < main.config.grid.columns { true -> cell(main) false -> next_row(main) }
    }
    state next_row(main: &mut Main) {
        main.column = 0; main.row = main.row + 1;
        transition main.row < main.config.grid.rows { true -> cell(main) false -> audit(main) }
    }
    state audit(main: &mut Main) {
        // Independent conservation calculation clips each source rectangle once
        // against the complete destination footprint, rather than summing cells.
        let width: i32 in Wrapping = main.config.grid.width * main.config.grid.columns;
        let height: i32 in Wrapping = main.config.grid.height * main.config.grid.rows;
        resample(&mut main.clipped, main.config.grid.x, main.config.grid.y, width, height,
            main.config.a, main.config.b, main.config.c, main.config.d);
        let total_area: i32 in Wrapping = width * height;
        transition main.totals.forest == main.clipped.forest && main.totals.water == main.clipped.water &&
            main.totals.urban == main.clipped.urban && main.totals.nodata == main.clipped.nodata &&
            main.totals.forest + main.totals.water + main.totals.urban + main.totals.nodata + main.outside_total == total_area {
            true -> passed(main, total_area) false -> failed(main)
        }
    }
    state passed(main: &mut Main, total_area: i32 in Wrapping) {
        let forest: i32 in Wrapping = main.totals.forest;
        let water: i32 in Wrapping = main.totals.water;
        let urban: i32 in Wrapping = main.totals.urban;
        let nodata: i32 in Wrapping = main.totals.nodata;
        let outside: i32 in Wrapping = main.outside_total;
        Console::write("TOTAL forest water urban nodata outside area ");
        number(main, forest); Console::write(" "); number(main, water); Console::write(" ");
        number(main, urban); Console::write(" "); number(main, nodata); Console::write(" ");
        number(main, outside); Console::write(" "); number(main, total_area); Console::write_line("");
        Console::write_line("AUDIT PASS: class conservation and full-area closure; tolerance=0");
        Console::exit_process(0);
    }
    state invalid(main: &mut Main) { Console::write_line("INVALID: bounded fixture input or model admission"); Console::exit_process(64); }
    state failed(main: &mut Main) { Console::write_line("AUDIT FAIL"); Console::exit_process(1); }
}
