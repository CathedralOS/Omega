// With closed stdin the application rejects the missing record.
// Expected exit: 64.
// Expected output contains: INVALID: expected
use omega_language_std::console;
use routing::model;
use routing::search;
use input::parse;
use reporting::certificate;

data Collection {
    input: [u8; 12];
    plan: Plan;
    certificate: Certificate;
}

machine Collection::main(collection: &mut Collection) reaches Console {
    let read: LineReadResult = block Console::read_line(&mut collection.input);
    transition read {
        LineReadResult::LineComplete { count } -> newline(collection, count)
        LineReadResult::EndOfInput { count } -> eof(collection, count)
        _ -> invalid(collection)
    }
    state newline(collection: &mut Collection, count: u64) {
        transition count == 12 && collection.input[11] == 10 {
            true -> decode(collection)
            false -> invalid(collection)
        }
    }
    state eof(collection: &mut Collection, count: u64) {
        transition count == 11 {
            true -> decode(collection)
            false -> invalid(collection)
        }
    }
    state decode(collection: &mut Collection) {
        let valid: bool = parse(&collection.input, &mut collection.plan);
        transition valid {
            true -> route(collection)
            false -> invalid(collection)
        }
    }
    state route(collection: &mut Collection) {
        solve(&collection.plan, &mut collection.certificate);
        report(&collection.certificate);
    }
    state invalid(collection: &mut Collection) {
        Console::write_line("INVALID: expected C A B RA RB LA(2) LB(2) H(2), eleven digits; C=1..2, A/B=1..9, ready<=latest");
        Console::exit_process(64);
    }
}
