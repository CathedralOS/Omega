// Exhaust all 4^4 event words, independently testing each word's four visits.
// A feasible word necessarily visits each pickup/drop once: duplicate pickups
// and drops reject, drops require pickups, and both deliveries must complete.
// The word code orders routes lexicographically; retain the first tied optimum.
use routing::model;
use routing::visit;

public machine solve(plan: &Plan, certificate: &mut Certificate) {
    certificate.feasible = 0;
    certificate.ties = 0;
    transition { _ -> enumerate(plan, certificate, 0) }
    machine enumerate(plan: &Plan, certificate: &mut Certificate, code: u64) {
        transition code < 256 {
            true -> candidate(plan, certificate, code)
            false -> done()
        }
    }
    machine candidate(plan: &Plan, certificate: &mut Certificate, code: u64) {
        let mut tour: Tour;
        tour.route[0] = code / 64;
        tour.route[1] = (code / 16) % 4;
        tour.route[2] = (code / 4) % 4;
        tour.route[3] = code % 4;
        let valid: bool = evaluate(plan, &mut tour);
        transition valid {
            true -> feasible(plan, certificate, code, &tour)
            false -> next(plan, certificate, code)
        }
    }
    machine feasible(plan: &Plan, certificate: &mut Certificate, code: u64, tour: &Tour) {
        certificate.feasible = certificate.feasible + 1;
        transition certificate.ties == 0 || tour.distance < certificate.best.distance ||
            (tour.distance == certificate.best.distance && tour.time < certificate.best.time) {
            true -> better(plan, certificate, code, tour)
            false -> compare(plan, certificate, code, tour)
        }
    }
    machine better(plan: &Plan, certificate: &mut Certificate, code: u64, tour: &Tour) {
        certificate.ties = 1;
        certificate.code = code;
        copy_tour(tour, &mut certificate.best);
        transition { _ -> next(plan, certificate, code) }
    }
    machine compare(plan: &Plan, certificate: &mut Certificate, code: u64, tour: &Tour) {
        transition tour.distance == certificate.best.distance && tour.time == certificate.best.time {
            true -> tied(plan, certificate, code)
            false -> next(plan, certificate, code)
        }
    }
    machine tied(plan: &Plan, certificate: &mut Certificate, code: u64) {
        certificate.ties = certificate.ties + 1;
        transition { _ -> next(plan, certificate, code) }
    }
    machine next(plan: &Plan, certificate: &mut Certificate, code: u64) {
        transition code < 256 {
            true -> enumerate(plan, certificate, code + 1)
            false -> done()
        }
    }
    machine done() { }
}

machine evaluate(plan: &Plan, tour: &mut Tour) -> bool {
    transition { _ -> step(plan, tour, 0) }
    machine step(plan: &Plan, tour: &mut Tour, index: u64) -> bool {
        transition index < 4 {
            true -> apply(plan, tour, index)
            false -> finish(plan, tour)
        }
    }
    machine apply(plan: &Plan, tour: &mut Tour, index: u64) -> bool {
        let event: u64 = tour.route[index];
        let valid: bool = visit(plan, tour, event);
        transition valid {
            true -> service(plan, tour, index)
            false -> false
        }
    }
    machine service(plan: &Plan, tour: &mut Tour, index: u64) -> bool {
        tour.arrivals[index] = tour.time;
        tour.time = tour.time + 1;
        transition index < 4 {
            true -> step(plan, tour, index + 1)
            false -> false
        }
    }
    machine finish(plan: &Plan, tour: &mut Tour) -> bool {
        tour.dropped_a && tour.dropped_b && tour.load == 0 && tour.position == 0 && tour.time <= plan.horizon
    }
}

machine copy_tour(source: &Tour, destination: &mut Tour) {
    destination.position = source.position;
    destination.time = source.time;
    destination.distance = source.distance;
    destination.load = source.load;
    destination.peak = source.peak;
    destination.waiting = source.waiting;
    destination.route[0] = source.route[0];
    destination.route[1] = source.route[1];
    destination.route[2] = source.route[2];
    destination.route[3] = source.route[3];
    destination.arrivals[0] = source.arrivals[0];
    destination.arrivals[1] = source.arrivals[1];
    destination.arrivals[2] = source.arrivals[2];
    destination.arrivals[3] = source.arrivals[3];
}
