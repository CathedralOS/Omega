// Synthetic two-sample mobile laboratory model: integer minutes and unit vials.
// Travel is distance on a line; pickup windows constrain service START.
// Every visit consumes one minute. Each drop returns its vial to depot zero.
// Saturating arithmetic is explicit; admitted inputs bound all totals below 256,
// so no reachable operation saturates. No external numerical package is used.
pub data Plan {
    capacity: i32 in Saturating;
    site_a: i32 in Saturating;
    site_b: i32 in Saturating;
    ready_a: i32 in Saturating;
    ready_b: i32 in Saturating;
    latest_a: i32 in Saturating;
    latest_b: i32 in Saturating;
    horizon: i32 in Saturating;
}
pub data Leg {
    span: i32 in Saturating;
}
pub data Tour {
    position: i32 in Saturating;
    time: i32 in Saturating;
    distance: i32 in Saturating;
    load: i32 in Saturating;
    peak: i32 in Saturating;
    waiting: i32 in Saturating;
    legs: [Leg; 1];
    picked_a: bool;
    picked_b: bool;
    dropped_a: bool;
    dropped_b: bool;
    route: [u64; 4];
    arrivals: [i32 in Saturating; 4];
}
pub data Certificate {
    feasible: i32 in Saturating;
    ties: i32 in Saturating;
    code: u64;
    best: Tour;
}
