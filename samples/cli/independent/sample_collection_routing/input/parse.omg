use routing::model;

// Eleven ASCII digits: C A B RA RB LA(2) LB(2) H(2).
// Only complete eleven-digit records are admitted by the entrypoint.
public machine parse(bytes: &[u8; 12], plan: &mut Plan) -> bool {
    let mut digits: [i32 in Saturating; 11];
    transition { _ -> digit(bytes, plan, &mut digits, 0) }
    machine digit(bytes: &[u8; 12], plan: &mut Plan, digits: &mut [i32 in Saturating; 11], index: u64) -> bool {
        transition index < 11 {
            true -> inspect(bytes, plan, digits, index)
            false -> assemble(plan, digits)
        }
    }
    machine inspect(bytes: &[u8; 12], plan: &mut Plan, digits: &mut [i32 in Saturating; 11], index: u64) -> bool {
        let byte: u8 = bytes[index];
        transition byte >= 48 && byte <= 57 {
            true -> store(bytes, plan, digits, index, byte)
            false -> false
        }
    }
    machine store(bytes: &[u8; 12], plan: &mut Plan, digits: &mut [i32 in Saturating; 11], index: u64, byte: u8) -> bool {
        digits[index] = (byte as i32 in Saturating) - 48;
        transition index < 11 {
            true -> digit(bytes, plan, digits, index + 1)
            false -> false
        }
    }
    machine assemble(plan: &mut Plan, digits: &[i32 in Saturating; 11]) -> bool {
        plan.capacity = digits[0];
        plan.site_a = digits[1];
        plan.site_b = digits[2];
        plan.ready_a = digits[3];
        plan.ready_b = digits[4];
        plan.latest_a = digits[5] * 10 + digits[6];
        plan.latest_b = digits[7] * 10 + digits[8];
        plan.horizon = digits[9] * 10 + digits[10];
        plan.capacity >= 1 && plan.capacity <= 2 && plan.site_a >= 1 && plan.site_b >= 1 &&
            plan.ready_a <= plan.latest_a && plan.ready_b <= plan.latest_b
    }
}
