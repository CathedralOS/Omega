use omega_language_std::console;
use omega::language::core::numeric_conversion;
use terrain::model;
use terrain::crossings;
use terrain::extract;
use terrain::stitch;
use reporting::report;

// One bounded record: level, policy, nine row-major elevations, optional LF.
// Examples: 10000020000 is a closed hill; 10000000000 is flat.
machine Main::main(context: &mut Main) reaches Console {
    let observed: LineReadResult = block Console::read_line(&mut context.input);
    transition observed {
        LineReadResult::LineComplete { count } -> line(context, count)
        LineReadResult::EndOfInput { count } -> eof(context, count)
        _ -> invalid(context)
    }
    state line(context: &mut Main, count: u64) {
        transition count == 12 && context.input[11] == 10 { true -> header(context) false -> invalid(context) }
    }
    state eof(context: &mut Main, count: u64) {
        transition count == 11 { true -> header(context) false -> invalid(context) }
    }
    state header(context: &mut Main) {
        transition context.input[0] >= 48 && context.input[0] <= 57 && context.input[1] >= 48 && context.input[1] <= 49 {
            true -> decode_header(context)
            false -> invalid(context)
        }
    }
    state decode_header(context: &mut Main) {
        context.terrain.level = (widen_u8_to_i32(context.input[0]) as i32 in Wrapping) - 48;
        context.terrain.policy = (widen_u8_to_i32(context.input[1]) as i32 in Wrapping) - 48;
        transition { _ -> digit(context, 0) }
    }
    state digit(context: &mut Main, index: u64) {
        transition index < 9 { true -> check_digit(context, index) false -> compute(context) }
    }
    state check_digit(context: &mut Main, index: u64) requires index < 9 {
        transition context.input[index + 2] >= 48 && context.input[index + 2] <= 57 { true -> decode(context, index) false -> invalid(context) }
    }
    state decode(context: &mut Main, index: u64) requires index < 9 {
        let height: i32 in Wrapping = (widen_u8_to_i32(context.input[index + 2]) as i32 in Wrapping) - 48;
        transition height != context.terrain.level { true -> store(context, index, height) false -> invalid(context) }
    }
    state store(context: &mut Main, index: u64, height: i32 in Wrapping) requires index < 9 {
        context.terrain.heights[index] = height;
        transition { _ -> digit(context, index + 1) }
    }
    state compute(context: &mut Main) {
        extract(&context.terrain, &mut context.graph);
        crossings(&context.terrain, &mut context.graph);
        stitch(&mut context.graph, &mut context.paths);
        transition context.graph.valid && context.paths.valid { true -> output(context) false -> failed(context) }
    }
    state output(context: &mut Main) {
        report(context);
        Console::exit_process(0);
    }
    state invalid(context: &mut Main) {
        Console::write_line("INVALID terrain record");
        Console::exit_process(64);
    }
    state failed(context: &mut Main) {
        Console::write_line("INVARIANT contour graph");
        Console::exit_process(70);
    }
}
