use terrain::model;
use omega::language::core::numeric_conversion;
// Global horizontal edges 0..5, then vertical edges 6..11. Increasing
// coordinates determine interpolation direction regardless of traversal.
machine crossings(terrain: &Terrain, graph: &mut Contours) {
    transition { _ -> edge(terrain, graph, 0) }
    machine edge(terrain: &Terrain, graph: &mut Contours, edge: u64) {
        transition edge < 12 { true -> locate(terrain, graph, edge) false -> done() }
    }
    machine locate(terrain: &Terrain, graph: &mut Contours, edge: u64) requires edge < 12 {
        transition edge < 6 {
            true -> horizontal(terrain, graph, edge)
            false -> vertical(terrain, graph, edge)
        }
    }
    machine horizontal(terrain: &Terrain, graph: &mut Contours, edge: u64) requires edge < 6 {
        let column: u64 = edge % 2;
        let row: u64 = edge / 2;
        let start: u64 = row * 3 + column;
        transition { _ -> sample(terrain, graph, edge, start, start + 1, column, row, true) }
    }
    machine vertical(terrain: &Terrain, graph: &mut Contours, edge: u64) requires edge >= 6 requires edge < 12 {
        let local: u64 = edge - 6;
        let column: u64 = local % 3;
        let row: u64 = local / 3;
        let start: u64 = row * 3 + column;
        transition { _ -> sample(terrain, graph, edge, start, start + 3, column, row, false) }
    }
    machine sample(terrain: &Terrain, graph: &mut Contours, edge: u64, start: u64, end: u64, column: u64, row: u64, horizontal: bool) {
        transition start < 9 && end < 9 && edge < 12 {
            true -> values(terrain, graph, edge, start, end, column, row, horizontal)
            false -> failed(graph)
        }
    }
    machine values(terrain: &Terrain, graph: &mut Contours, edge: u64, start: u64, end: u64, column: u64, row: u64, horizontal: bool) requires start < 9 requires end < 9 requires edge < 12 {
        let a: i32 in Wrapping = terrain.heights[start];
        let b: i32 in Wrapping = terrain.heights[end];
        transition (a > terrain.level) != (b > terrain.level) {
            true -> interpolate(terrain, graph, edge, a, b, column, row, horizontal)
            false -> edge(terrain, graph, edge + 1)
        }
    }
    machine interpolate(terrain: &Terrain, graph: &mut Contours, edge: u64, a: i32 in Wrapping, b: i32 in Wrapping, column: u64, row: u64, horizontal: bool) requires edge < 12 {
        let denominator: i32 in Wrapping = b - a;
        transition denominator != 0 {
            true -> store(terrain, graph, edge, a, denominator, column, row, horizontal)
            false -> failed(graph)
        }
    }
    machine store(terrain: &Terrain, graph: &mut Contours, edge: u64, a: i32 in Wrapping, denominator: i32 in Wrapping, column: u64, row: u64, horizontal: bool) requires edge < 12 requires denominator != 0 {
        let fraction: i32 in Wrapping = (terrain.level - a) * 2520 / denominator;
        graph.x[edge] = (narrow_u64_to_i32_wrapping(column) as i32 in Wrapping) * 2520;
        graph.y[edge] = (narrow_u64_to_i32_wrapping(row) as i32 in Wrapping) * 2520;
        transition horizontal {
            true -> shift_x(terrain, graph, edge, fraction)
            false -> shift_y(terrain, graph, edge, fraction)
        }
    }
    machine shift_x(terrain: &Terrain, graph: &mut Contours, edge: u64, fraction: i32 in Wrapping) requires edge < 12 {
        graph.x[edge] = graph.x[edge] + fraction;
        transition { _ -> edge(terrain, graph, edge + 1) }
    }
    machine shift_y(terrain: &Terrain, graph: &mut Contours, edge: u64, fraction: i32 in Wrapping) requires edge < 12 {
        graph.y[edge] = graph.y[edge] + fraction;
        transition { _ -> edge(terrain, graph, edge + 1) }
    }
    machine failed(graph: &mut Contours) { graph.valid = false; }
    machine done() { }
}
