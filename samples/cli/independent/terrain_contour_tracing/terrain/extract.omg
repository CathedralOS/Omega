use terrain::model;
machine append_segment(graph: &mut Contours, cell: u64, first: u64, second: u64) {
    transition graph.count < 8 && first < 12 && second < 12 {
        true -> store(graph, cell, first, second)
        false -> failed(graph)
    }
    machine store(graph: &mut Contours, cell: u64, first: u64, second: u64) requires graph.count < 8 requires first < 12 requires second < 12 {
        graph.owner[graph.count] = cell;
        graph.first[graph.count] = first;
        graph.second[graph.count] = second;
        graph.degree[first] = graph.degree[first] + 1;
        graph.degree[second] = graph.degree[second] + 1;
        graph.count = graph.count + 1;
    }
    machine failed(graph: &mut Contours) { graph.valid = false; }
}
machine extract(terrain: &Terrain, graph: &mut Contours) {
    graph.valid = true;
    graph.count = 0;
    graph.saddles = 0;
    transition { _ -> clear(terrain, graph, 0) }
    machine clear(terrain: &Terrain, graph: &mut Contours, index: u64) {
        transition index < 12 { true -> zero(terrain, graph, index) false -> cell(terrain, graph, 0) }
    }
    machine zero(terrain: &Terrain, graph: &mut Contours, index: u64) requires index < 12 {
        graph.degree[index] = 0;
        transition { _ -> clear(terrain, graph, index + 1) }
    }
    machine cell(terrain: &Terrain, graph: &mut Contours, cell: u64) {
        transition cell < 4 { true -> locate(terrain, graph, cell) false -> done() }
    }
    machine locate(terrain: &Terrain, graph: &mut Contours, cell: u64) requires cell < 4 {
        let column: u64 = cell % 2;
        let row: u64 = cell / 2;
        let start: u64 = row * 3 + column;
        transition { _ -> guard(terrain, graph, cell, start, row * 2 + column, 6 + row * 3 + column + 1, (row + 1) * 2 + column, 6 + row * 3 + column) }
    }
    machine guard(terrain: &Terrain, graph: &mut Contours, cell: u64, start: u64, top: u64, right: u64, bottom: u64, left: u64) {
        transition start < 5 { true -> classify(terrain, graph, cell, start, top, right, bottom, left) false -> failed(graph) }
    }
    machine classify(terrain: &Terrain, graph: &mut Contours, cell: u64, start: u64, top: u64, right: u64, bottom: u64, left: u64) requires start < 5 {
        let mut mask: u64 = 0;
        transition { _ -> corner_a(terrain, graph, cell, start, top, right, bottom, left, mask) }
    }
    machine corner_a(terrain: &Terrain, graph: &mut Contours, cell: u64, start: u64, top: u64, right: u64, bottom: u64, left: u64, mask: u64) requires start < 5 {
        transition terrain.heights[start + 0] > terrain.level {
            true -> corner_b(terrain, graph, cell, start, top, right, bottom, left, mask + 1)
            false -> corner_b(terrain, graph, cell, start, top, right, bottom, left, mask)
        }
    }
    machine corner_b(terrain: &Terrain, graph: &mut Contours, cell: u64, start: u64, top: u64, right: u64, bottom: u64, left: u64, mask: u64) requires start < 5 {
        transition terrain.heights[start + 1] > terrain.level {
            true -> corner_c(terrain, graph, cell, start, top, right, bottom, left, mask + 2)
            false -> corner_c(terrain, graph, cell, start, top, right, bottom, left, mask)
        }
    }
    machine corner_c(terrain: &Terrain, graph: &mut Contours, cell: u64, start: u64, top: u64, right: u64, bottom: u64, left: u64, mask: u64) requires start < 5 {
        transition terrain.heights[start + 4] > terrain.level {
            true -> corner_d(terrain, graph, cell, start, top, right, bottom, left, mask + 4)
            false -> corner_d(terrain, graph, cell, start, top, right, bottom, left, mask)
        }
    }
    machine corner_d(terrain: &Terrain, graph: &mut Contours, cell: u64, start: u64, top: u64, right: u64, bottom: u64, left: u64, mask: u64) requires start < 5 {
        transition terrain.heights[start + 3] > terrain.level {
            true -> dispatch(terrain, graph, cell, start, top, right, bottom, left, mask + 8)
            false -> dispatch(terrain, graph, cell, start, top, right, bottom, left, mask)
        }
    }
    machine dispatch(terrain: &Terrain, graph: &mut Contours, cell: u64, start: u64, top: u64, right: u64, bottom: u64, left: u64, mask: u64) {
        transition mask {
            0 -> case_0(terrain, graph, cell, top, right, bottom, left)
            1 -> case_1(terrain, graph, cell, top, right, bottom, left)
            2 -> case_2(terrain, graph, cell, top, right, bottom, left)
            3 -> case_3(terrain, graph, cell, top, right, bottom, left)
            4 -> case_4(terrain, graph, cell, top, right, bottom, left)
            5 -> case_5(terrain, graph, cell, top, right, bottom, left)
            6 -> case_6(terrain, graph, cell, top, right, bottom, left)
            7 -> case_7(terrain, graph, cell, top, right, bottom, left)
            8 -> case_8(terrain, graph, cell, top, right, bottom, left)
            9 -> case_9(terrain, graph, cell, top, right, bottom, left)
            10 -> case_10(terrain, graph, cell, top, right, bottom, left)
            11 -> case_11(terrain, graph, cell, top, right, bottom, left)
            12 -> case_12(terrain, graph, cell, top, right, bottom, left)
            13 -> case_13(terrain, graph, cell, top, right, bottom, left)
            14 -> case_14(terrain, graph, cell, top, right, bottom, left)
            15 -> case_15(terrain, graph, cell, top, right, bottom, left)
            _ -> failed(graph)
        }
    }
    machine case_0(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_1(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, left);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_2(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, right);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_3(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, left, right);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_4(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, right, bottom);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_5(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        graph.saddles = graph.saddles + 1;
        transition terrain.policy == 0 {
            true -> pair_a(terrain, graph, cell, top, right, bottom, left)
            false -> pair_b(terrain, graph, cell, top, right, bottom, left)
        }
    }
    machine case_6(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, bottom);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_7(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, left, bottom);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_8(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, bottom, left);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_9(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, bottom);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_10(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        graph.saddles = graph.saddles + 1;
        transition terrain.policy == 1 {
            true -> pair_a(terrain, graph, cell, top, right, bottom, left)
            false -> pair_b(terrain, graph, cell, top, right, bottom, left)
        }
    }
    machine case_11(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, right, bottom);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_12(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, left, right);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_13(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, right);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_14(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, left);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine case_15(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine pair_a(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, left);
        append_segment(graph, cell, right, bottom);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine pair_b(terrain: &Terrain, graph: &mut Contours, cell: u64, top: u64, right: u64, bottom: u64, left: u64) {
        append_segment(graph, cell, top, right);
        append_segment(graph, cell, bottom, left);
        transition { _ -> cell(terrain, graph, cell + 1) }
    }
    machine failed(graph: &mut Contours) { graph.valid = false; }
    machine done() { }
}
