use domain::input;

// Declared synthetic four-point rule: close b,c when its range is no larger
// than either enclosing range a,b or c,d; remove b,c and re-examine the tail.
// Turning points are extracted FIRST, so a monotone observation never closes
// a cycle prematurely. Residual adjacent pairs count as half cycles.
// Validation admits <=16 loads in 0..9. Removing two reversals accounts for
// two half units; residual adjacency accounts for one per remaining edge.
// Total half units are therefore <=15, giving damage numerator <=15*81=1215.
// Wrapping value carriers accommodate array reads without element refinements;
// these validated magnitudes cannot wrap. Storage indices remain Exact.
public data Audit {
    turning: [u64; 16] in Wrapping;
    stack: [u64; 16] in Wrapping;
    ranges: [u64; 16] in Wrapping;
    weights: [u64; 16] in Wrapping;
    exponent: u64 in Wrapping;
    denominator: u64 in Wrapping;
    total: u64 in Wrapping;
    current: u64 in Wrapping;
    left: u64 in Wrapping;
    middle: u64 in Wrapping;
    right: u64 in Wrapping;
    range: u64 in Wrapping;
    weight: u64 in Wrapping;
    turning_count: u64;
    stack_count: u64;
    cycle_count: u64;
    index: u64;
    first: u64;
    second: u64;
    third: u64;
    fourth: u64;
}

machine Audit::prepare(audit: &mut Audit, input: &Input) {
    audit.exponent = input.values[0];
    audit.denominator = input.values[1] * 2;
    audit.turning_count = 0;
    audit.index = 3;
    transition { _ -> loop(audit, input) }
    machine loop(audit: &mut Audit, input: &Input) {
        transition audit.index < input.count && audit.index < 19 {
            true -> load(audit, input)
            false -> done()
        }
    }
    machine load(audit: &mut Audit, input: &Input) {
        audit.current = input.values[audit.index];
        transition audit.turning_count == 0 { true -> append_guard(audit, input) false -> tail_guard(audit, input) }
    }
    machine tail_guard(audit: &mut Audit, input: &Input) {
        transition audit.turning_count >= 1 && audit.turning_count <= 16 {
            true -> tail(audit, input)
            false -> done()
        }
    }
    machine tail(audit: &mut Audit, input: &Input) {
        audit.second = audit.turning_count - 1;
        transition audit.second < 16 { true -> compare(audit, input) false -> done() }
    }
    machine compare(audit: &mut Audit, input: &Input) {
        audit.right = audit.turning[audit.second];
        transition {
            audit.current == audit.right -> next(audit, input)
            audit.turning_count >= 2 && audit.turning_count <= 16 -> prior(audit, input)
            _ -> append_guard(audit, input)
        }
    }
    machine prior(audit: &mut Audit, input: &Input) {
        audit.first = audit.turning_count - 2;
        transition audit.first < 16 { true -> direction(audit, input) false -> done() }
    }
    machine direction(audit: &mut Audit, input: &Input) {
        audit.left = audit.turning[audit.first];
        transition (audit.left < audit.right && audit.right < audit.current) || (audit.left > audit.right && audit.right > audit.current) {
            true -> replace_guard(audit, input)
            false -> append_guard(audit, input)
        }
    }
    machine replace_guard(audit: &mut Audit, input: &Input) {
        transition audit.second < 16 { true -> replace(audit, input) false -> done() }
    }
    machine replace(audit: &mut Audit, input: &Input) {
        audit.turning[audit.second] = audit.current;
        transition { _ -> next(audit, input) }
    }
    machine append_guard(audit: &mut Audit, input: &Input) {
        transition audit.turning_count < 16 { true -> append(audit, input) false -> done() }
    }
    machine append(audit: &mut Audit, input: &Input) {
        audit.turning[audit.turning_count] = audit.current;
        audit.turning_count = audit.turning_count + 1;
        transition { _ -> next(audit, input) }
    }
    machine next(audit: &mut Audit, input: &Input) {
        transition audit.index < 19 { true -> increment(audit, input) false -> done() }
    }
    machine increment(audit: &mut Audit, input: &Input) {
        audit.index = audit.index + 1;
        transition { _ -> loop(audit, input) }
    }
    machine done() {}
}

machine Audit::distance(left: u64 in Wrapping, right: u64 in Wrapping) -> u64 in Wrapping {
    transition left >= right { true -> descending(left, right) false -> ascending(left, right) }
    machine descending(left: u64 in Wrapping, right: u64 in Wrapping) -> u64 in Wrapping { left - right }
    machine ascending(left: u64 in Wrapping, right: u64 in Wrapping) -> u64 in Wrapping { right - left }
}

machine Audit::record(audit: &mut Audit) {
    transition audit.cycle_count < 16 { true -> store(audit) false -> done() }
    machine store(audit: &mut Audit) {
        audit.ranges[audit.cycle_count] = audit.range;
        audit.weights[audit.cycle_count] = audit.weight;
        transition audit.exponent == 2 { true -> square(audit) false -> linear(audit) }
    }
    machine square(audit: &mut Audit) {
        audit.total = audit.total + audit.weight * audit.range * audit.range;
        transition { _ -> next(audit) }
    }
    machine linear(audit: &mut Audit) {
        audit.total = audit.total + audit.weight * audit.range;
        transition { _ -> next(audit) }
    }
    machine next(audit: &mut Audit) {
        transition audit.cycle_count < 16 { true -> increment(audit) false -> done() }
    }
    machine increment(audit: &mut Audit) { audit.cycle_count = audit.cycle_count + 1; }
    machine done() {}
}

machine Audit::count(audit: &mut Audit) {
    audit.index = 0;
    audit.stack_count = 0;
    audit.cycle_count = 0;
    audit.total = 0;
    transition { _ -> feed_guard(audit) }
    machine feed_guard(audit: &mut Audit) {
        transition audit.index < audit.turning_count && audit.index < 16 && audit.stack_count < 16 {
            true -> feed(audit)
            false -> residual_start(audit)
        }
    }
    machine feed(audit: &mut Audit) {
        audit.current = audit.turning[audit.index];
        audit.stack[audit.stack_count] = audit.current;
        audit.stack_count = audit.stack_count + 1;
        audit.index = audit.index + 1;
        transition { _ -> close_guard(audit) }
    }
    machine close_guard(audit: &mut Audit) {
        transition audit.stack_count >= 4 && audit.stack_count <= 16 { true -> selectors(audit) false -> feed_guard(audit) }
    }
    machine selectors(audit: &mut Audit) {
        audit.first = audit.stack_count - 4;
        audit.second = audit.stack_count - 3;
        audit.third = audit.stack_count - 2;
        audit.fourth = audit.stack_count - 1;
        transition audit.first < 16 && audit.second < 16 && audit.third < 16 && audit.fourth < 16 { true -> ranges(audit) false -> done() }
    }
    machine ranges(audit: &mut Audit) {
        audit.left = Audit::distance(audit.stack[audit.first], audit.stack[audit.second]);
        audit.middle = Audit::distance(audit.stack[audit.second], audit.stack[audit.third]);
        audit.right = Audit::distance(audit.stack[audit.third], audit.stack[audit.fourth]);
        transition audit.middle <= audit.left && audit.middle <= audit.right { true -> close(audit) false -> feed_guard(audit) }
    }
    machine close(audit: &mut Audit) {
        audit.range = audit.middle;
        audit.weight = 2;
        Audit::record(audit);
        transition audit.second < 16 && audit.fourth < 16 && audit.stack_count >= 4 && audit.stack_count <= 16 { true -> remove(audit) false -> done() }
    }
    machine remove(audit: &mut Audit) {
        audit.current = audit.stack[audit.fourth];
        audit.stack[audit.second] = audit.current;
        audit.stack_count = audit.stack_count - 2;
        transition { _ -> close_guard(audit) }
    }
    machine residual_start(audit: &mut Audit) {
        audit.index = 1;
        transition { _ -> residual_guard(audit) }
    }
    machine residual_guard(audit: &mut Audit) {
        transition audit.index >= 1 && audit.index < audit.stack_count && audit.index < 16 { true -> residual_select(audit) false -> done() }
    }
    machine residual_select(audit: &mut Audit) {
        audit.first = audit.index - 1;
        transition audit.first < 16 && audit.index < 16 { true -> residual(audit) false -> done() }
    }
    machine residual(audit: &mut Audit) {
        audit.range = Audit::distance(audit.stack[audit.first], audit.stack[audit.index]);
        audit.weight = 1;
        Audit::record(audit);
        transition audit.index < 16 { true -> next(audit) false -> done() }
    }
    machine next(audit: &mut Audit) {
        audit.index = audit.index + 1;
        transition { _ -> residual_guard(audit) }
    }
    machine done() {}
}
