use omega_language_std::console;
use domain::cycles;

pub data Report {}

// Fixed-width decimal columns avoid floating projection and preserve exact
// rational numerators. Every reachable number is below 10000.
machine Report::number(number: u64 in Wrapping) reaches Console {
    Console::write_byte(((number / 1000) % 10 + 48) as i32);
    Console::write_byte(((number / 100) % 10 + 48) as i32);
    Console::write_byte(((number / 10) % 10 + 48) as i32);
    Console::write_byte((number % 10 + 48) as i32);
}

machine Report::write(audit: &mut Audit) reaches Console {
    Console::write_line("range,half_units,damage_numerator,damage_denominator,cumulative_numerator");
    audit.index = 0;
    audit.current = 0;
    transition { _ -> loop(audit) }
    state loop(audit: &mut Audit) {
        transition audit.index < audit.cycle_count && audit.index < 16 { true -> row(audit) false -> total(audit) }
    }
    state row(audit: &mut Audit) {
        audit.range = audit.ranges[audit.index];
        audit.weight = audit.weights[audit.index];
        audit.middle = audit.range * audit.weight;
        transition audit.exponent == 2 { true -> square(audit) false -> emit(audit) }
    }
    state square(audit: &mut Audit) {
        audit.middle = audit.middle * audit.range;
        transition { _ -> emit(audit) }
    }
    state emit(audit: &mut Audit) {
        audit.current = audit.current + audit.middle;
        Report::number(audit.range);
        Console::write_byte(44);
        Report::number(audit.weight);
        Console::write_byte(44);
        Report::number(audit.middle);
        Console::write_byte(44);
        Report::number(audit.denominator);
        Console::write_byte(44);
        Report::number(audit.current);
        Console::write_byte(10);
        transition audit.index < 16 { true -> next(audit) false -> total(audit) }
    }
    state next(audit: &mut Audit) {
        audit.index = audit.index + 1;
        transition { _ -> loop(audit) }
    }
    state total(audit: &mut Audit) {
        Console::write("total,");
        Report::number(audit.total);
        Console::write_byte(44);
        Report::number(audit.denominator);
        Console::write_byte(10);
    }
}
