// Complete current-main reproduction: a guarded successor borrows a local
// fixed byte array. The same source is required to print the actual bytes.
use omega_language_std::console;
data Main { choice: i32; }
machine Main::main(main: &mut Main) reaches Console {
    let bytes: [u8; 4] = "TEST";
    transition main.choice {
        0 -> show(main, &bytes)
        1 -> show(main, &bytes)
        _ -> show(main, &bytes)
    }
    state show(main: &mut Main, bytes: &[u8; 4]) {
        Console::write_line(bytes);
        Console::exit_process(0);
    }
}
