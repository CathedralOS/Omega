// Complete negative source control: this literal start exceeds its required
// finite mathematical contract. The checker must reject before any native run.
use omega_language_std::console;

machine validate_start(start: i32)
    requires start >= 0 && start <= 20
{
}

const INVALID_START: i32 = 21;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    validate_start(INVALID_START);
    Console::write_line("INVALID SOURCE WAS ACCEPTED");
    Console::exit_process(INVALID_START);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
