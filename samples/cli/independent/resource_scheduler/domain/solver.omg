use domain::model;

// Serial schedule generation enumerates all 4^n priority words, discarding
// repetitions and orders that place a successor before its predecessors.
// For a legal order each task gets its earliest capacity-feasible start, even
// in an earlier gap. The resulting active schedules contain a makespan optimum
// for nonpreemptive tasks with renewable resources and finish/start precedence.
// All limits (n<=4, duration<=5, horizon<=20) are checked by input::decode.
// Enumerating priority words is private bounded storage, not a numerics service.
machine solve(problem: &Problem, best: &mut Schedule) -> bool {
    reset_schedule(best);
    transition problem.count == 0 {
        true -> empty(best)
        _ -> enumerate(problem, best, 0)
    }
    machine empty(best: &mut Schedule) -> bool {
        best.feasible = true;
        transition { _ -> true }
    }
    machine enumerate(problem: &Problem, best: &mut Schedule, code: i32 in Wrapping) -> bool {
        transition code < 256 {
            true -> candidate(problem, best, code)
            _ -> (best.feasible)
        }
    }
    machine candidate(problem: &Problem, best: &mut Schedule, code: i32 in Wrapping) -> bool {
        let mut trial: Schedule;
        reset_schedule(&mut trial);
        let feasible: bool = schedule_order(problem, &mut trial, code);
        transition feasible {
            true -> compare(problem, best, &trial, code)
            _ -> enumerate(problem, best, code + 1)
        }
    }
    machine compare(problem: &Problem, best: &mut Schedule, trial: &Schedule,
                  code: i32 in Wrapping) -> bool {
        let preferred: bool = better(trial, best);
        transition preferred {
            true -> retain(problem, best, trial, code)
            _ -> enumerate(problem, best, code + 1)
        }
    }
    machine retain(problem: &Problem, best: &mut Schedule, trial: &Schedule,
                 code: i32 in Wrapping) -> bool {
        best.starts = trial.starts;
        best.ends = trial.ends;
        best.makespan = trial.makespan;
        best.feasible = true;
        transition { _ -> enumerate(problem, best, code + 1) }
    }
}
// Makespan first, then lexicographic starts in task-ID order. The comparison
// does not depend on which priority word happened to be enumerated first.
machine better(trial: &Schedule, best: &Schedule) -> bool {
    transition !best.feasible || trial.makespan < best.makespan {
        true -> true
        _ -> tied(trial, best)
    }
    machine tied(trial: &Schedule, best: &Schedule) -> bool {
        transition trial.makespan == best.makespan {
            true -> compare(trial, best, 0)
            _ -> false
        }
    }
    machine compare(trial: &Schedule, best: &Schedule, index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < 4 {
            true -> values(trial, best, index)
            _ -> false
        }
    }
    machine values(trial: &Schedule, best: &Schedule, index: i32 in Wrapping) -> bool {
        transition trial.starts[index] < best.starts[index] {
            true -> true
            _ -> equal(trial, best, index)
        }
    }
    machine equal(trial: &Schedule, best: &Schedule, index: i32 in Wrapping) -> bool {
        transition trial.starts[index] == best.starts[index] {
            true -> compare(trial, best, index + 1)
            _ -> false
        }
    }
}

machine schedule_order(problem: &Problem, schedule: &mut Schedule,
                       code: i32 in Wrapping) -> bool {
    transition { _ -> position(problem, schedule, code, 0) }
    machine position(problem: &Problem, schedule: &mut Schedule, code: i32 in Wrapping,
                   placed: i32 in Wrapping) -> bool {
        transition placed < problem.count {
            true -> selected(problem, schedule, code / 4, placed, code % 4)
            _ -> true
        }
    }
    machine selected(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                   placed: i32 in Wrapping, task: i32 in Wrapping) -> bool {
        transition task >= 0 && task < problem.count && task < 4 {
            true -> unscheduled(problem, schedule, rest, placed, task)
            _ -> false
        }
    }
    machine unscheduled(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                      placed: i32 in Wrapping, task: i32 in Wrapping) -> bool {
        transition schedule.starts[task] < 0
            && problem.demand_a[task] <= problem.capacity_a
            && problem.demand_b[task] <= problem.capacity_b {
            true -> dependencies(problem, schedule, rest, placed, task, 0, 0)
            _ -> false
        }
    }
    machine dependencies(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                        placed: i32 in Wrapping, task: i32 in Wrapping,
                        other: i32 in Wrapping, earliest: i32 in Wrapping) -> bool {
        transition other >= 0 && other < problem.count && other < 4 && task >= 0 && task < 4 {
            true -> dependency(problem, schedule, rest, placed, task, other, earliest)
            _ -> search(problem, schedule, rest, placed, task, earliest)
        }
    }
    machine dependency(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                      placed: i32 in Wrapping, task: i32 in Wrapping,
                      other: i32 in Wrapping, earliest: i32 in Wrapping) -> bool {
        let required: bool = predecessor(problem.predecessors[task], other);
        transition required {
            true -> predecessor_end(problem, schedule, rest, placed, task, other, earliest)
            _ -> dependencies(problem, schedule, rest, placed, task, other + 1, earliest)
        }
    }
    machine predecessor_end(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                           placed: i32 in Wrapping, task: i32 in Wrapping,
                           other: i32 in Wrapping, earliest: i32 in Wrapping) -> bool {
        transition schedule.starts[other] >= 0 {
            true -> maximum(problem, schedule, rest, placed, task, other, earliest)
            _ -> false
        }
    }
    machine maximum(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                   placed: i32 in Wrapping, task: i32 in Wrapping,
                   other: i32 in Wrapping, earliest: i32 in Wrapping) -> bool {
        let previous_end: i32 in Wrapping = schedule.ends[other];
        transition previous_end > earliest {
            true -> dependencies(problem, schedule, rest, placed, task, other + 1, previous_end)
            _ -> dependencies(problem, schedule, rest, placed, task, other + 1, earliest)
        }
    }
    machine search(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                  placed: i32 in Wrapping, task: i32 in Wrapping,
                  start: i32 in Wrapping) -> bool {
        transition start >= 0 && start <= 20 && task >= 0 && task < 4 {
            true -> fit(problem, schedule, rest, placed, task, start)
            _ -> false
        }
    }
    machine fit(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
               placed: i32 in Wrapping, task: i32 in Wrapping,
               start: i32 in Wrapping) -> bool {
        let end: i32 in Wrapping = start + problem.durations[task];
        transition end <= 20 {
            true -> capacity(problem, schedule, rest, placed, task, start, end)
            _ -> false
        }
    }
    machine capacity(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                    placed: i32 in Wrapping, task: i32 in Wrapping,
                    start: i32 in Wrapping, end: i32 in Wrapping) -> bool {
        let available: bool = fits(problem, schedule, task, start, end);
        transition available {
            true -> commit(problem, schedule, rest, placed, task, start, end)
            _ -> search(problem, schedule, rest, placed, task, start + 1)
        }
    }
    machine commit(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                  placed: i32 in Wrapping, task: i32 in Wrapping,
                  start: i32 in Wrapping, end: i32 in Wrapping) -> bool {
        schedule.starts[task] = start;
        schedule.ends[task] = end;
        transition end > schedule.makespan {
            true -> span(problem, schedule, rest, placed, end)
            _ -> position(problem, schedule, rest, placed + 1)
        }
    }
    machine span(problem: &Problem, schedule: &mut Schedule, rest: i32 in Wrapping,
                placed: i32 in Wrapping, end: i32 in Wrapping) -> bool {
        schedule.makespan = end;
        transition { _ -> position(problem, schedule, rest, placed + 1) }
    }
}

// Check every tick of [start,end), so tasks sharing only an endpoint do not
// consume capacity together. Previously placed tasks may lie after the gap.
machine fits(problem: &Problem, schedule: &Schedule, task: i32 in Wrapping,
             start: i32 in Wrapping, end: i32 in Wrapping) -> bool {
    transition { _ -> tick(problem, schedule, task, start, end) }
    machine tick(problem: &Problem, schedule: &Schedule, task: i32 in Wrapping,
                time: i32 in Wrapping, end: i32 in Wrapping) -> bool {
        transition time < end && task >= 0 && task < 4 {
            true -> collect(problem, schedule, task, time, end, 0,
                            problem.demand_a[task], problem.demand_b[task])
            _ -> true
        }
    }
    machine collect(problem: &Problem, schedule: &Schedule, task: i32 in Wrapping,
                   time: i32 in Wrapping, end: i32 in Wrapping, other: i32 in Wrapping,
                   used_a: i32 in Wrapping, used_b: i32 in Wrapping) -> bool {
        transition other >= 0 && other < problem.count && other < 4 {
            true -> overlap(problem, schedule, task, time, end, other, used_a, used_b)
            _ -> capacities(problem, schedule, task, time, end, used_a, used_b)
        }
    }
    machine overlap(problem: &Problem, schedule: &Schedule, task: i32 in Wrapping,
                   time: i32 in Wrapping, end: i32 in Wrapping, other: i32 in Wrapping,
                   used_a: i32 in Wrapping, used_b: i32 in Wrapping) -> bool {
        transition schedule.starts[other] >= 0 && schedule.starts[other] <= time
            && time < schedule.ends[other] {
            true -> collect(problem, schedule, task, time, end, other + 1,
                            used_a + problem.demand_a[other], used_b + problem.demand_b[other])
            _ -> collect(problem, schedule, task, time, end, other + 1, used_a, used_b)
        }
    }
    machine capacities(problem: &Problem, schedule: &Schedule, task: i32 in Wrapping,
                      time: i32 in Wrapping, end: i32 in Wrapping,
                      used_a: i32 in Wrapping, used_b: i32 in Wrapping) -> bool {
        transition used_a <= problem.capacity_a && used_b <= problem.capacity_b {
            true -> tick(problem, schedule, task, time + 1, end)
            _ -> false
        }
    }
}
