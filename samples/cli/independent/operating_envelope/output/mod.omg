module output;
use omega_language_std::console;
use omega::language::core::float_operations;
use geometry;

// Integer text emission uses the existing byte provider; decimal coordinates
// and areas are emitted in micro-units, with truncation error below one unit.
pub machine integer(value: i32) reaches Console
invokes Console;
{
    transition value < 0 {
        true -> negative(value as i32 in Wrapping)
        _ -> digits(value as i32 in Wrapping, 1000000000, false)
    }
    state negative(value: i32 in Wrapping) {
        Console::write_byte(45);
        transition { _ -> digits(0 - value, 1000000000, false) }
    }
    state digits(value: i32 in Wrapping, divisor: i32 in Wrapping, started: bool) {
        transition divisor > 0 {
            true -> quotient(value, divisor, started)
            _ -> done()
        }
    }
    state quotient(value: i32 in Wrapping, divisor: i32 in Wrapping, started: bool) {
        let digit: i32 in Wrapping = value / divisor;
        transition digit != 0 || started || divisor == 1 {
            true -> emit(value, divisor, digit)
            _ -> digits(value, divisor / 10, false)
        }
    }
    state emit(value: i32 in Wrapping, divisor: i32 in Wrapping, digit: i32 in Wrapping) {
        Console::write_byte((digit + 48) as i32);
        transition divisor > 1 {
            true -> digits(value % divisor, divisor / 10, true)
            _ -> done()
        }
    }
    state done() { }
}
pub machine micro(value: f64) reaches Console
invokes Console;
{
    let converted: i32 in Saturating = I32::from_f64(value * 1000000.0);
    integer(converted as i32);
}
pub machine report(envelope: &geometry::Envelope) reaches Console
invokes Console;
{
    transition envelope.count == 0 {
        true -> empty(envelope)
        _ -> window(envelope)
    }
    state empty(envelope: &geometry::Envelope) {
        Console::write_line("status empty-in-window");
        transition { _ -> summary(envelope) }
    }
    state window(envelope: &geometry::Envelope) {
        transition envelope.window_active {
            true -> limited(envelope)
            _ -> bounded(envelope)
        }
    }
    state limited(envelope: &geometry::Envelope) {
        Console::write_line("status window-limited-unboundedness-undetermined");
        transition { _ -> summary(envelope) }
    }
    state bounded(envelope: &geometry::Envelope) {
        Console::write_line("status bounded");
        transition { _ -> summary(envelope) }
    }
    state summary(envelope: &geometry::Envelope) {
        Console::write("vertices "); integer(envelope.count as i32); Console::write_byte(10);
        // Split area at its integral part: the maximum 40000 square units
        // cannot fit in i32 micro-units as a single number.
        let whole: i32 in Saturating = I32::from_f64(envelope.area);
        Console::write("area_whole "); integer(whole as i32); Console::write_byte(10);
        Console::write("area_fraction_micro ");
        micro(envelope.area - F64::from_i32(whole as i32)); Console::write_byte(10);
        transition { _ -> vertex(envelope, 0) }
    }
    state vertex(envelope: &geometry::Envelope, index: i32 in Wrapping) {
        transition index >= 0 && index < envelope.count && index < 32 {
            true -> emit_vertex(envelope, index)
            _ -> done()
        }
    }
    state emit_vertex(envelope: &geometry::Envelope, index: i32 in Wrapping) {
        Console::write("vertex "); integer(index as i32); Console::write_byte(32);
        micro(envelope.x[index]); Console::write_byte(32); micro(envelope.y[index]); Console::write_byte(10);
        transition { _ -> certificate(envelope, index, 0) }
    }
    state certificate(
        envelope: &geometry::Envelope,
        vertex: i32 in Wrapping,
        constraint: i32 in Wrapping
    ) {
        transition vertex >= 0 && vertex < 32 && constraint >= 0 && constraint < envelope.constraints && constraint < 8 {
            true -> residual(envelope, vertex, constraint)
            _ -> next_vertex(envelope, vertex)
        }
    }
    state residual(
        envelope: &geometry::Envelope,
        vertex: i32 in Wrapping,
        constraint: i32 in Wrapping
    ) {
        let residual: f64 = envelope.a[constraint] * envelope.x[vertex]
                         + envelope.b[constraint] * envelope.y[vertex] - envelope.limit[constraint];
        Console::write("certificate "); integer(vertex as i32); Console::write_byte(32);
        integer(constraint as i32); Console::write_byte(32); micro(residual / 100.0); Console::write_byte(10);
        transition residual >= -0.00000001 && residual <= 0.00000001 {
            true -> active(envelope, vertex, constraint)
            _ -> certificate(envelope, vertex, constraint + 1)
        }
    }
    state active(
        envelope: &geometry::Envelope,
        vertex: i32 in Wrapping,
        constraint: i32 in Wrapping
    ) {
        Console::write("active "); integer(vertex as i32); Console::write_byte(32);
        integer(constraint as i32); Console::write_byte(10);
        transition { _ -> certificate(envelope, vertex, constraint + 1) }
    }
    state next_vertex(envelope: &geometry::Envelope, vertex: i32 in Wrapping) {
        transition { _ -> vertex(envelope, vertex + 1) }
    }
    state done() { }
}
