// Runtime operating envelope: one stdin packet, one fully certified polygon.
// The generic sample harness supplies EOF; it must reject a missing packet.
// Expected exit: 2.
// Expected output contains: invalid input
use omega_language_std::console;
use omega::language::core::binding;
use input;
use geometry;
use output;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut bytes: [u8; 256];
    _ = block main.console.read_line(&mut bytes);
    let mut packet: input::Packet;
    input::parse(&mut packet, &bytes);
    let mut envelope: geometry::Envelope;
    let admitted: bool = geometry::load(&mut envelope, &packet);
    transition admitted {
        true -> calculate(main, &mut envelope)
        _ -> invalid(main)
    }
    state calculate(main: &mut Main, envelope: &mut geometry::Envelope) {
        geometry::solve(envelope);
        transition envelope.valid {
            true -> emit(main, envelope)
            _ -> failure(main)
        }
    }
    state emit(main: &mut Main, envelope: &geometry::Envelope) {
        output::report(&main.console, envelope);
        main.console.exit_process(0);
    }
    state invalid(main: &mut Main) {
        main.console.write_line("invalid input");
        main.console.exit_process(2);
    }
    state failure(main: &mut Main) {
        main.console.write_line("internal capacity failure");
        main.console.exit_process(3);
    }
}
