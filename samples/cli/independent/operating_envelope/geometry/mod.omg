module geometry;
use omega::language::core::float_operations;
use input;

// Sutherland-Hodgman clipping keeps counterclockwise order. Two fixed buffers
// own all scratch: at most four window corners plus eight additional edges.
// No external numerical package participates in admission or calculation.
public data Envelope {
    x: [f64; 32]; y: [f64; 32];
    scratch_x: [f64; 32]; scratch_y: [f64; 32];
    a: [f64; 8]; b: [f64; 8]; limit: [f64; 8];
    count: i32 in Wrapping; scratch_count: i32 in Wrapping;
    constraints: i32 in Wrapping;
    bound: f64; area: f64;
    valid: bool; window_active: bool;
}
public machine load(envelope: &mut Envelope, packet: &input::Packet) -> bool {
    transition packet.valid && packet.count >= 2 {
        true -> header(envelope, packet)
        _ -> false
    }
    machine header(envelope: &mut Envelope, packet: &input::Packet) -> bool {
        let bound: i32 = packet.values[0];
        let count: i32 in Wrapping = packet.values[1] as i32 in Wrapping;
        transition bound > 0 && bound <= 100 && count >= 0 && count <= 8
                && packet.count == 2 + count * 3 {
            true -> initialize(envelope, packet, bound, count)
            _ -> false
        }
    }
    machine initialize(envelope: &mut Envelope, packet: &input::Packet, bound: i32,
                     count: i32 in Wrapping) -> bool {
        envelope.bound = F64::from_i32(bound);
        envelope.constraints = count;
        envelope.count = 4;
        envelope.area = 0.0;
        envelope.valid = true;
        envelope.window_active = false;
        envelope.x[0] = 0.0 - envelope.bound; envelope.y[0] = 0.0 - envelope.bound;
        envelope.x[1] = envelope.bound; envelope.y[1] = 0.0 - envelope.bound;
        envelope.x[2] = envelope.bound; envelope.y[2] = envelope.bound;
        envelope.x[3] = 0.0 - envelope.bound; envelope.y[3] = envelope.bound;
        transition { _ -> constraint(envelope, packet, 0) }
    }
    machine constraint(envelope: &mut Envelope, packet: &input::Packet,
                     index: i32 in Wrapping) -> bool {
        transition index >= 0 && index < envelope.constraints && index < 8 {
            true -> offsets(envelope, packet, index, 2 + index * 3)
            _ -> true
        }
    }
    machine offsets(envelope: &mut Envelope, packet: &input::Packet,
                  index: i32 in Wrapping, offset: i32 in Wrapping) -> bool {
        transition offset >= 0 && offset < 24 && index >= 0 && index < 8 {
            true -> coefficients(envelope, packet, index, offset)
            _ -> false
        }
    }
    machine coefficients(envelope: &mut Envelope, packet: &input::Packet,
                       index: i32 in Wrapping, offset: i32 in Wrapping) -> bool {
        let a: i32 = packet.values[offset];
        let b: i32 = packet.values[offset + 1];
        let limit: i32 = packet.values[offset + 2];
        transition a >= -100 && a <= 100 && b >= -100 && b <= 100 && (a != 0 || b != 0) {
            true -> assign(envelope, packet, index, a, b, limit)
            _ -> false
        }
    }
    machine assign(envelope: &mut Envelope, packet: &input::Packet, index: i32 in Wrapping,
                 a: i32, b: i32, limit: i32) -> bool {
        envelope.a[index] = F64::from_i32(a);
        envelope.b[index] = F64::from_i32(b);
        envelope.limit[index] = F64::from_i32(limit) / 1000000.0;
        transition { _ -> constraint(envelope, packet, index + 1) }
    }
}

machine append(envelope: &mut Envelope, x: f64, y: f64) {
    transition envelope.scratch_count >= 0 && envelope.scratch_count < 32 {
        true -> write(envelope, x, y)
        _ -> overflow(envelope)
    }
    machine write(envelope: &mut Envelope, x: f64, y: f64) {
        envelope.scratch_x[envelope.scratch_count] = x;
        envelope.scratch_y[envelope.scratch_count] = y;
        envelope.scratch_count = envelope.scratch_count + 1;
    }
    machine overflow(envelope: &mut Envelope) { envelope.valid = false; }
}

public machine solve(envelope: &mut Envelope) {
    transition { _ -> constraint(envelope, 0) }
    machine constraint(envelope: &mut Envelope, index: i32 in Wrapping) {
        transition index >= 0 && index < envelope.constraints && index < 8 {
            true -> begin(envelope, index)
            _ -> measure(envelope, 0, 0.0)
        }
    }
    machine begin(envelope: &mut Envelope, index: i32 in Wrapping) {
        envelope.scratch_count = 0;
        transition { _ -> edge(envelope, index, 0) }
    }
    machine edge(envelope: &mut Envelope, index: i32 in Wrapping, vertex: i32 in Wrapping) {
        transition vertex >= 0 && vertex < envelope.count && vertex < 32
                   && index >= 0 && index < 8 {
            true -> successor(envelope, index, vertex, vertex + 1)
            _ -> copy(envelope, index, 0)
        }
    }
    machine successor(envelope: &mut Envelope, index: i32 in Wrapping,
                    vertex: i32 in Wrapping, next: i32 in Wrapping) {
        transition next < envelope.count {
            true -> endpoints(envelope, index, vertex, next)
            _ -> endpoints(envelope, index, vertex, 0)
        }
    }
    machine endpoints(envelope: &mut Envelope, index: i32 in Wrapping,
                    vertex: i32 in Wrapping, next: i32 in Wrapping) {
        transition vertex >= 0 && vertex < 32 && next >= 0 && next < 32 && index >= 0 && index < 8 {
            true -> classify(envelope, index, vertex, next)
            _ -> failure(envelope)
        }
    }
    machine classify(envelope: &mut Envelope, index: i32 in Wrapping,
                   vertex: i32 in Wrapping, next: i32 in Wrapping) {
        let start_x: f64 = envelope.x[vertex]; let start_y: f64 = envelope.y[vertex];
        let end_x: f64 = envelope.x[next]; let end_y: f64 = envelope.y[next];
        let start_distance: f64 = envelope.a[index] * start_x + envelope.b[index] * start_y - envelope.limit[index];
        let end_distance: f64 = envelope.a[index] * end_x + envelope.b[index] * end_y - envelope.limit[index];
        transition (start_distance <= 0.000000001) == (end_distance <= 0.000000001) {
            true -> same(envelope, index, vertex, end_x, end_y, end_distance)
            _ -> intersect(envelope, index, vertex, start_x, start_y, end_x, end_y, start_distance, end_distance)
        }
    }
    machine same(envelope: &mut Envelope, index: i32 in Wrapping, vertex: i32 in Wrapping,
               end_x: f64, end_y: f64, end_distance: f64) {
        transition end_distance <= 0.000000001 {
            true -> keep(envelope, index, vertex, end_x, end_y)
            _ -> edge(envelope, index, vertex + 1)
        }
    }
    machine intersect(envelope: &mut Envelope, index: i32 in Wrapping, vertex: i32 in Wrapping,
                    start_x: f64, start_y: f64, end_x: f64, end_y: f64,
                    start_distance: f64, end_distance: f64) {
        // Clip at the admitted boundary epsilon; the same boundary classifies
        // both endpoints, so the denominator cannot be zero on this edge.
        let fraction: f64 = (start_distance - 0.000000001) / (start_distance - end_distance);
        append(envelope, start_x + fraction * (end_x - start_x), start_y + fraction * (end_y - start_y));
        transition end_distance <= 0.000000001 {
            true -> keep(envelope, index, vertex, end_x, end_y)
            _ -> edge(envelope, index, vertex + 1)
        }
    }
    machine keep(envelope: &mut Envelope, index: i32 in Wrapping, vertex: i32 in Wrapping, x: f64, y: f64) {
        append(envelope, x, y);
        transition { _ -> edge(envelope, index, vertex + 1) }
    }
    machine copy(envelope: &mut Envelope, index: i32 in Wrapping, vertex: i32 in Wrapping) {
        transition vertex >= 0 && vertex < envelope.scratch_count && vertex < 32 {
            true -> copy_vertex(envelope, index, vertex)
            _ -> next_constraint(envelope, index)
        }
    }
    machine copy_vertex(envelope: &mut Envelope, index: i32 in Wrapping, vertex: i32 in Wrapping) {
        envelope.x[vertex] = envelope.scratch_x[vertex];
        envelope.y[vertex] = envelope.scratch_y[vertex];
        transition { _ -> copy(envelope, index, vertex + 1) }
    }
    machine next_constraint(envelope: &mut Envelope, index: i32 in Wrapping) {
        envelope.count = envelope.scratch_count;
        transition { _ -> constraint(envelope, index + 1) }
    }
    machine measure(envelope: &mut Envelope, vertex: i32 in Wrapping, twice_area: f64) {
        transition vertex >= 0 && vertex < envelope.count && vertex < 32 {
            true -> area_successor(envelope, vertex, vertex + 1, twice_area)
            _ -> finish(envelope, twice_area)
        }
    }
    machine area_successor(envelope: &mut Envelope, vertex: i32 in Wrapping,
                         next: i32 in Wrapping, twice_area: f64) {
        transition next < envelope.count {
            true -> area_bounds(envelope, vertex, next, twice_area)
            _ -> area_bounds(envelope, vertex, 0, twice_area)
        }
    }
    machine area_bounds(envelope: &mut Envelope, vertex: i32 in Wrapping,
                      next: i32 in Wrapping, twice_area: f64) {
        transition vertex >= 0 && vertex < 32 && next >= 0 && next < 32 {
            true -> area_edge(envelope, vertex, next, twice_area)
            _ -> failure(envelope)
        }
    }
    machine area_edge(envelope: &mut Envelope, vertex: i32 in Wrapping,
                    next: i32 in Wrapping, twice_area: f64) {
        let x: f64 = envelope.x[vertex]; let y: f64 = envelope.y[vertex];
        let cross: f64 = x * envelope.y[next] - y * envelope.x[next];
        transition x <= 0.0 - envelope.bound + 0.000000001 || x >= envelope.bound - 0.000000001
                || y <= 0.0 - envelope.bound + 0.000000001 || y >= envelope.bound - 0.000000001 {
            true -> at_window(envelope, vertex, twice_area + cross)
            _ -> measure(envelope, vertex + 1, twice_area + cross)
        }
    }
    machine at_window(envelope: &mut Envelope, vertex: i32 in Wrapping, twice_area: f64) {
        envelope.window_active = true;
        transition { _ -> measure(envelope, vertex + 1, twice_area) }
    }
    machine finish(envelope: &mut Envelope, twice_area: f64) { envelope.area = twice_area * 0.5; }
    machine failure(envelope: &mut Envelope) { envelope.valid = false; }
}
