// Format a number as text -- the reverse of parse_number, and the core of printing
// numbers. The tens and ones digits are extracted with `/ 10` and `% 10`, turned
// into their character codes by adding '0' (48), narrowed through the named
// trapping operation, and written into the carrier at positions 0 and 1. The
// result is verified with `==`: 25 formats to "25". Verification uses `==`
// rather than write_line because a raw byte write cannot be PROVEN valid Utf8.
// Expected exit: 70.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    pause: [u8; 256];
    buffer: [u8; 8] in Utf8;
    value: i32;
    tens: i32;
    ones: i32;
    tens_byte: u8;
    ones_byte: u8;
}

machine Main::main(&mut self) {
    self.console.write_line("format_number: rendering the number 25 into a text carrier digit by digit");
    self.buffer = "00";
    self.value = 25;

    self.tens = self.value / 10;
    self.tens = self.tens + 48;
    self.tens_byte = narrow_i32_to_u8_trapping(self.tens);

    self.ones = self.value % 10;
    self.ones = self.ones + 48;
    self.ones_byte = narrow_i32_to_u8_trapping(self.ones);

    self.buffer[0] = self.tens_byte;
    self.buffer[1] = self.ones_byte;

    transition self.buffer == "25" {
        true -> ok()
        _ -> bad()
    }

    state ok(&mut self) {
        self.console.write_line("PASS: buffer matches '25' (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: formatted text mismatch (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
