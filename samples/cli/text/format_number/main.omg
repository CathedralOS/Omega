// Format a number as text -- the reverse of parse_number, and the core of printing
// numbers. The tens and ones digits are extracted with `/ 10` and `% 10`, turned
// into their character codes by adding '0' (48), narrowed through the named
// trapping operation, and written into the carrier at positions 0 and 1. The
// result is verified with `==`: 25 formats to "25". Verification uses `==`
// rather than write_line because a raw byte write cannot be PROVEN valid Utf8.
// Expected exit: 70.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 2]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    pause: [u8; 256];
    buffer: [u8; 2] in Utf8;
    value: i32;
    tens: i32;
    ones: i32;
    tens_byte: u8;
    ones_byte: u8;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("format_number: rendering the number 25 into a text carrier digit by digit");
    main.buffer = "00";
    main.value = 25;

    main.tens = main.value / 10;
    main.tens = main.tens + 48;
    main.tens_byte = narrow_i32_to_u8_trapping(main.tens);

    main.ones = main.value % 10;
    main.ones = main.ones + 48;
    main.ones_byte = narrow_i32_to_u8_trapping(main.ones);

    main.buffer[0] = main.tens_byte;
    main.buffer[1] = main.ones_byte;

    transition main.buffer == "25" {
        true -> ok(main)
        _ -> bad(main)
    }

    state ok(main: &mut Main) {
        Console::write_line("PASS: buffer matches '25' (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: formatted text mismatch (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
