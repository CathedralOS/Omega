// Format a number as text -- the reverse of parse_number, and the core of printing
// numbers. The tens and ones digits are extracted with `/ 10` and `% 10`, turned
// into their character codes by adding '0' (48), narrowed to bytes with `as u8`,
// and written into the carrier at positions 0 and 1. The result is verified with
// `==`: 25 formats to "25". (A cast result cannot yet be written DIRECTLY to a
// carrier byte position -- `buffer[i] = expr as u8` fails to lower -- so the byte is
// staged through an intermediate u8 field first, which works. Verification uses `==`
// rather than write_line because a raw byte write cannot be PROVEN valid Utf8.)
// Expected exit: 70.

domain [u8]::Utf8 when valid_utf8(self) {}
domain [u8; 8]::Utf8 when valid_utf8(self) {}

boundary trait Console {
    machine write_line(text: String);
    machine read_line(out_line: &mut String);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    pause: String;
    buffer: [u8; 8] in Utf8;
    value: i32;
    tens: i32;
    ones: i32;
    tens_byte: u8;
    ones_byte: u8;
}

machine Main::main(&mut self) {
    self.console.write_line("format_number: rendering the number 25 into a text carrier digit by digit");
    self.buffer = "00";
    self.value = 25;

    self.tens = self.value / 10;
    self.tens = self.tens + 48;
    self.tens_byte = self.tens as u8;

    self.ones = self.value % 10;
    self.ones = self.ones + 48;
    self.ones_byte = self.ones as u8;

    self.buffer[0] = self.tens_byte;
    self.buffer[1] = self.ones_byte;

    transition self.buffer == "25" {
        true -> ok()
        _ -> bad()
    }

    state ok(&mut self) {
        self.console.write_line("PASS: buffer matches '25' (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: formatted text mismatch (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
