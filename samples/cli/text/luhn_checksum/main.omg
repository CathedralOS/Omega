// Expected exit: 70.
// Luhn checksum validation -- the algorithm behind credit-card and many ID-number check digits.
// Walking the digits from the RIGHT: every second digit (positions 1, 3, 5, ... counting the
// rightmost as 0) is doubled, and a doubled value over 9 has 9 subtracted; all the resulting digits
// are summed. The number is valid iff the sum is a multiple of 10.
//
// For "79927398713" (a classic valid test number) the digit array is indexed by a DECREASING
// counter `r` (rightmost first, no computed index). A digit at index r is doubled when r is odd
// (here n = 11, so right-position parity matches r parity). The sum comes to 70, and 70 % 10 == 0,
// so the number is valid. Exits 70 on valid, 71 on invalid.

use omega_language_std::console;

data Main {
    console: Console;
    pause: [u8; 256];
    digits: [i32; 11];
    r: i32 [-1..=10];
    par: i32 in Wrapping;
    d: i32 in Wrapping;
    sum: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.console.write_line("luhn_checksum: validating 79927398713 with the credit-card check-digit rule");
    self.digits = [7, 9, 9, 2, 7, 3, 9, 8, 7, 1, 3];
    self.r = 10;
    self.sum = 0;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.r >= 0 {
            true -> proc()
            false -> check()
        }
    }
    state proc(&mut self) {
        self.d = self.digits[self.r];
        self.par = self.r % 2;
        transition self.par == 1 {
            true -> double_it()
            false -> accumulate()
        }
    }
    state double_it(&mut self) {
        self.d = self.d * 2;
        transition self.d > 9 {
            true -> sub9()
            false -> accumulate()
        }
    }
    state sub9(&mut self) {
        self.d = self.d - 9;
        transition { _ -> accumulate() }
    }
    // Re-guard so the decrement's direct edge proves `r - 1` back into
    // [-1..=10] -- accumulate is only reachable with r >= 0, so always true.
    state accumulate(&mut self) {
        self.sum = self.sum + self.d;
        transition self.r >= 0 {
            true -> dec()
            false -> check()
        }
    }
    state dec(&mut self) {
        self.r = self.r - 1;
        transition { _ -> step() }
    }
    state check(&mut self) {
        self.par = self.sum % 10;
        transition self.par == 0 {
            true -> valid()
            false -> invalid()
        }
    }
    state valid(&mut self) {
        self.console.write_line("PASS: Luhn sum 70 is a multiple of 10, number valid (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
    state invalid(&mut self) {
        self.console.write_line("FAIL: Luhn sum not a multiple of 10, number invalid (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
