// Expected exit: 70.
// Luhn checksum validation -- the algorithm behind credit-card and many ID-number check digits.
// Walking the digits from the RIGHT: every second digit (positions 1, 3, 5, ... counting the
// rightmost as 0) is doubled, and a doubled value over 9 has 9 subtracted; all the resulting digits
// are summed. The number is valid iff the sum is a multiple of 10.
//
// For "79927398713" (a classic valid test number) the digit array is indexed by a DECREASING
// counter `r` (rightmost first, no computed index). A digit at index r is doubled when r is odd
// (here n = 11, so right-position parity matches r parity). The sum comes to 70, and 70 % 10 == 0,
// so the number is valid. Exits 70 on valid, 71 on invalid.

use omega_language_std::console;

data Main {
    pause: [u8; 256];
    digits: [i32; 11];
    r: i32;
    par: i32 in Wrapping;
    d: i32 in Wrapping;
    sum: i32 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("luhn_checksum: validating 79927398713 with the credit-card check-digit rule");
    main.digits = [7, 9, 9, 2, 7, 3, 9, 8, 7, 1, 3];
    main.r = 10;
    main.sum = 0;
    transition { _ -> step(main) }

    state step(main: &mut Main) {
        transition main.r >= 0 {
            true -> proc(main)
            false -> check(main)
        }
    }
    state proc(main: &mut Main) {
        main.d = main.digits[main.r] as i32 in Wrapping;
        main.par = (main.r % 2) as i32 in Wrapping;
        transition main.par == 1 {
            true -> double_it(main)
            false -> accumulate(main)
        }
    }
    state double_it(main: &mut Main) {
        main.d = main.d * 2;
        transition main.d > 9 {
            true -> sub9(main)
            false -> accumulate(main)
        }
    }
    state sub9(main: &mut Main) {
        main.d = main.d - 9;
        transition { _ -> accumulate(main) }
    }
    // Re-guard so the decrement's direct edge proves `r - 1` cannot overflow
    // -- accumulate is only reachable with r >= 0, so always true.
    state accumulate(main: &mut Main) {
        main.sum = main.sum + main.d;
        transition main.r >= 0 {
            true -> dec(main)
            false -> check(main)
        }
    }
    state dec(main: &mut Main) {
        main.r = main.r - 1;
        transition { _ -> step(main) }
    }
    state check(main: &mut Main) {
        main.par = main.sum % 10;
        transition main.par == 0 {
            true -> valid(main)
            false -> invalid(main)
        }
    }
    state valid(main: &mut Main) {
        Console::write_line("PASS: Luhn sum 70 is a multiple of 10, number valid (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state invalid(main: &mut Main) {
        Console::write_line("FAIL: Luhn sum not a multiple of 10, number invalid (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
