// Fletcher-16 checksum over a byte sequence. Two running sums mod 255: sum1
// accumulates the bytes, sum2 accumulates sum1 (so position-sensitive, unlike a
// plain sum). The 16-bit checksum is sum2 * 256 + sum1; here we report sum2, the
// high byte. For [1, 2, 3, 4, 5, 6] the trace is
//   sum1: 1, 3, 6, 10, 15, 21
//   sum2: 1, 4, 10, 20, 35, 56
// so sum2 = 56.
//
// Iterates with the idiomatic SHRINKING-SLICE pattern: each step reads s[0] under
// the `s.len > 0` guard (which discharges the index bound) and tail-recurses on
// s[1..]. This is how Omega iterates a runtime-length sequence -- a runtime index
// counter would need a separately-proven `idx < len`. sum2's update needs sum1's
// NEW value, so `(sum1 + s[0]) % 255` appears in both tail arguments.
// Expected exit: 56.

use omega_language_std::console;

data Adder {
    bytes: [i32 in Wrapping; 6];
}

machine Adder::fletcher(
    &mut self,
    s: &[i32 in Wrapping],
    sum1: i32 in Wrapping,
    sum2: i32 in Wrapping
) -> i32 {
    transition s.len > 0 {
        true -> fletcher(s[1..], (sum1 + s[0]) % 255, (sum2 + ((sum1 + s[0]) % 255)) % 255)
        false -> ((sum2) as i32)
    }
}

data Main {
    console: Console;
    adder: Adder;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("fletcher_checksum: fletcher-16 position-sensitive checksum over [1..6]");
    self.adder.bytes[0] = 1;
    self.adder.bytes[1] = 2;
    self.adder.bytes[2] = 3;
    self.adder.bytes[3] = 4;
    self.adder.bytes[4] = 5;
    self.adder.bytes[5] = 6;

    let s: &[i32 in Wrapping] = self.adder.bytes.as_slice();
    let checksum: i32 = self.adder.fletcher(s, 0, 0);
    self.console.write_line("result: the checksum high byte sum2, 56 for this data (the exit code)");
    self.console.write_line("[press Enter to close]");
    self.console.read_line(&mut self.pause);
    self.console.exit_process(checksum);
}
