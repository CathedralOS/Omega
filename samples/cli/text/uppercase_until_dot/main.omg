// Uppercase ASCII a..z until a dot or EOF, and exit with the emitted byte count.
// ByteRead::Eof is distinct from a zero-valued Byte payload.
// Expected exit: 0.
// INPUT-GRID:
//   "." -> 0
//   "a." -> 1
//   "hi." -> 2
//   "Mix." -> 3
//   "a z." -> 3
// The default input is empty; cases.json pins finite input/output vectors.

use omega_language_std::ByteRead;
use omega_language_std::Console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> block read_next_byte(0) }

    machine read_next_byte(count: i32 in Wrapping) {
        let read_result: ByteRead = block Console::read_byte();
        transition read_result {
            ByteRead::Byte { value } -> block stop_at_dot_or_classify(count, value)
            _ -> exit_with_count(count)
        }
    }

    machine stop_at_dot_or_classify(count: i32 in Wrapping, value: i32)
    requires value >= 0 && value <= 0xFF {
        let byte: i32 in Wrapping = value as i32 in Wrapping;
        transition byte == 0x2E {
            true -> exit_with_count(count)
            _ -> block branch_on_lowercase(count, byte)
        }
    }

    machine branch_on_lowercase(count: i32 in Wrapping, byte: i32 in Wrapping) {
        transition byte >= 0x61 && byte <= 0x7A {
            true -> block write_uppercase_byte(count + 1, byte)
            _ -> block write_unchanged_byte(count + 1, byte)
        }
    }

    machine write_uppercase_byte(count: i32 in Wrapping, byte: i32 in Wrapping) {
        let uppercase_byte: i32 in Wrapping = byte - 0x20;
        let output: i32 = uppercase_byte as i32;
        Console::write_byte(output);
        transition { _ -> block read_next_byte(count) }
    }

    machine write_unchanged_byte(count: i32 in Wrapping, byte: i32 in Wrapping) {
        let output: i32 = byte as i32;
        Console::write_byte(output);
        transition { _ -> block read_next_byte(count) }
    }

    machine exit_with_count(count: i32 in Wrapping) {
        Console::exit_process(count as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
