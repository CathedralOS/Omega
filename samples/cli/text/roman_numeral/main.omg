// Expected exit: 70.
// Roman numeral -> integer. Scan left to right, adding each symbol's value.
// When a symbol exceeds its predecessor, subtract the predecessor twice:
// its earlier addition should have been a subtraction. MCMXCIV yields 1994.
// The parser borrows text; only the cursor, previous value and total survive
// iterations. Byte reads, symbol lookup and arithmetic use ordinary locals.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data RomanParse {
    case Invalid;
    case Parsed(total: i32 in Wrapping);
}

// Zero means an unknown symbol; every Roman symbol has a positive value.
machine symbol_value(byte: u8) -> i32 in Wrapping {
    transition byte {
        77 -> (1000)
        68 -> (500)
        67 -> (100)
        76 -> (50)
        88 -> (10)
        86 -> (5)
        73 -> (1)
        _ -> (0)
    }
}

// Wrapping is deliberate: arbitrary input can overflow the accumulator,
// and the subtractive-pair correction can dip below zero.
machine accumulate(total: i32 in Wrapping, previous: i32 in Wrapping,
                   value: i32 in Wrapping) -> i32 in Wrapping {
    let added: i32 in Wrapping = total + value;
    transition previous < value {
        true -> (added - previous - previous)
        false -> (added)
    }
}

machine parse_roman(text: &[u8; 16] in Utf8) -> RomanParse {
    transition { _ -> step(text, 0, 0, 0) }

    state step(text: &[u8; 16] in Utf8, index: i32,
               previous: i32 in Wrapping, total: i32 in Wrapping) -> RomanParse
    requires index >= 0
    {
        transition index < text.len {
            true -> read(text, index, previous, total)
            _ -> (RomanParse::Parsed { total: total })
        }
    }

    state read(text: &[u8; 16] in Utf8, index: i32,
               previous: i32 in Wrapping, total: i32 in Wrapping) -> RomanParse
    requires index >= 0
    {
        let byte: u8 = text[index];
        let value: i32 in Wrapping = symbol_value(byte);
        transition value == 0 {
            true -> (RomanParse::Invalid)
            false -> advance(text, index, value, accumulate(total, previous, value))
        }
    }

    state advance(text: &[u8; 16] in Utf8, index: i32,
                  previous: i32 in Wrapping, total: i32 in Wrapping) -> RomanParse
    requires index >= 0
    {
        // Keep the original capacity guard on the Exact cursor increment.
        transition index < 16 {
            true -> bump(text, index, previous, total)
            _ -> (RomanParse::Invalid)
        }
    }

    state bump(text: &[u8; 16] in Utf8, index: i32,
               previous: i32 in Wrapping, total: i32 in Wrapping) -> RomanParse
    requires index >= 0 && index < 16
    {
        let next_index: i32 = index + 1;
        transition { _ -> step(text, next_index, previous, total) }
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line(&main.console, "roman_numeral: parses MCMXCIV with the subtractive-pair look-back rule");
    let text: [u8; 16] in Utf8 = "MCMXCIV";
    transition parse_roman(&text) {
        RomanParse::Parsed { total } -> check(&main.console, total)
        RomanParse::Invalid -> bad(&main.console)
    }

    state check(console: &Binding<Console>, total: i32 in Wrapping) {
        transition total == 1994 { true -> ok(console) false -> mismatch(console) }
    }
    state ok(console: &Binding<Console>) {
        Console::write_line(console, "PASS: MCMXCIV parsed to 1994 (exit 70)");
        transition { _ -> finish(console, 70) }
    }
    state mismatch(console: &Binding<Console>) {
        Console::write_line(console, "FAIL: parse total did not equal 1994 (exit 71)");
        transition { _ -> finish(console, 71) }
    }
    state bad(console: &Binding<Console>) {
        Console::write_line(console, "FAIL: unknown symbol or index guard tripped (exit 99)");
        transition { _ -> finish(console, 99) }
    }
    state finish(console: &Binding<Console>, code: i32) {
        Console::write_line(console, "[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(console, &mut pause);
        Console::exit_process(console, code);
    }
}
