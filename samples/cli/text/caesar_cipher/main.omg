// Caesar cipher: shift each byte of a string by a fixed key and print the result.
// A real string TRANSFORMATION -- read a carrier, compute a new byte per position,
// write a new carrier, output it. The shift reads cleanly now that a carrier
// indexed read works inside an expression:
//
//   out[i] = text[i] as u8 in Wrapping + key
//
// `in Wrapping` makes the byte add wrap (decision 17: byte arithmetic is modular,
// not exact -- 'X' + 3 would otherwise need an unprovable no-overflow proof). The
// element read is `u8` (the carrier's `in Utf8` domain is bound to `[u8]` storage,
// not to a single byte). "HELLO" shifted by 3 is "KHOOR". After printing it, the
// program self-checks out[0] == 'K' (75) and exits 0.
//
// Expected exit: 0.
// Expected output contains: KHOOR

use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line(&main.console, "caesar_cipher: shift each byte of HELLO by 3 -- expecting KHOOR");
    let text: [u8; 5] in Utf8 = "HELLO";
    let mut output: [u8; 5] in Utf8 = ".....";

    transition {
        _ -> step(&main.console, &text, &mut output, 0)
    }

    state step(console: &Binding<Console>, text: &[u8; 5] in Utf8, output: &mut [u8; 5] in Utf8, position: i32)
        requires 0 <= position && position <= 5
    {
        transition position < 5 {
            true -> shift(console, text, output, position)
            _ -> show(console, output)
        }
    }

    state shift(console: &Binding<Console>, text: &[u8; 5] in Utf8, output: &mut [u8; 5] in Utf8, position: i32)
        requires 0 <= position && position < 5
    {
        let shifted: u8 in Wrapping = text[position] as u8 in Wrapping + 3;
        output[position] = shifted as u8;
        transition {
            _ -> step(console, text, output, position + 1)
        }
    }

    state show(console: &Binding<Console>, output: &mut [u8; 5] in Utf8) {
        Console::write_line(console, output);
        transition output[0] == 75 {
            true -> ok(console)
            _ -> wrong(console)
        }
    }

    state ok(console: &Binding<Console>) {
        Console::write_line(console, "PASS: ciphertext starts with 'K' -- shift applied correctly (exit 0)");
        Console::write_line(console, "[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(console, &mut pause);
        Console::exit_process(console, 0);
    }

    state wrong(console: &Binding<Console>) {
        Console::write_line(console, "FAIL: out[0] != 'K' -- byte shift wrong (exit 1)");
        Console::write_line(console, "[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(console, &mut pause);
        Console::exit_process(console, 1);
    }
}
