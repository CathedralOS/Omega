// Caesar cipher: shift each byte of a string by a fixed key and print the result.
// A real string TRANSFORMATION -- read a carrier, compute a new byte per position,
// write a new carrier, output it. The shift reads cleanly now that a carrier
// indexed read works inside an expression:
//
//   out[i] = text[i] as u8 in Wrapping + key
//
// `in Wrapping` makes the byte add wrap (decision 17: byte arithmetic is modular,
// not exact -- 'X' + 3 would otherwise need an unprovable no-overflow proof). The
// element read is `u8` (the carrier's `in Utf8` domain is bound to `[u8]` storage,
// not to a single byte). "HELLO" shifted by 3 is "KHOOR". After printing it, the
// program self-checks out[0] == 'K' (75) and exits 0.
//
// Expected exit: 0.
// Expected output contains: KHOOR

use omega_language_std::console;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("caesar_cipher: shift each byte of HELLO by 3 -- expecting KHOOR");
    let text: [u8; 5] in Utf8 = "HELLO";
    let mut output: [u8; 5] = ".....";

    transition {
        _ -> step(&text, &mut output, 0)
    }

    state step(text: &[u8; 5] in Utf8, output: &mut [u8; 5], position: i32)
        requires 0 <= position && position <= 5
    {
        transition position < 5 {
            true -> shift(text, output, position)
            _ -> show(output)
        }
    }

    state shift(text: &[u8; 5] in Utf8, output: &mut [u8; 5], position: i32)
        requires 0 <= position && position < 5
    {
        let shifted: u8 in Wrapping = text[position] as u8 in Wrapping + 3;
        output[position] = shifted as u8;
        transition {
            _ -> step(text, output, position + 1)
        }
    }

    // Modular byte arithmetic constructs bytes; validate the completed value
    // before lending a qualified view to the console.
    state show(output: &mut [u8; 5]) {
        transition valid_utf8(output) {
            true -> show_valid(output)
            false -> wrong()
        }
    }

    state show_valid(output: &mut [u8; 5])
    requires valid_utf8(output)
    {
        Console::write_line(output);
        transition output[0] == 75 {
            true -> ok()
            _ -> wrong()
        }
    }

    state ok() {
        Console::write_line("PASS: ciphertext starts with 'K' -- shift applied correctly (exit 0)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(0);
    }

    state wrong() {
        Console::write_line("FAIL: out[0] != 'K' -- byte shift wrong (exit 1)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(1);
    }
}
