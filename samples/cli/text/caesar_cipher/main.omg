use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Caesar cipher: shift each byte of a string by a fixed key and print the result.
// A real string TRANSFORMATION -- read a carrier, compute a new byte per position,
// write a new carrier, output it. The shift reads cleanly now that a carrier
// indexed read works inside an expression:
//
//   out[i] = (text[i] as +Wrapping) + key
//
// `in Wrapping` makes the byte add wrap (decision 17: byte arithmetic is modular,
// not exact -- 'X' + 3 would otherwise need an unprovable no-overflow proof). The
// element read is `u8` (the carrier's `in Utf8` domain is bound to `[u8]` storage,
// not to a single byte). "HELLO" shifted by 3 is "KHOOR". After printing it, the
// program self-checks out[0] == 'K' (75) and exits 0.
//
// Expected exit: 0.
// Expected output contains: KHOOR


domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 5]::Utf8
requires
    valid_utf8(self);
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("caesar_cipher: shift each byte of HELLO by 3 -- expecting KHOOR");
    let text: [u8; 5] in Utf8 = "HELLO";
    let mutable output: [u8; 5] = ".....";

    transition {
        _ -> block step(@text, @mutable output, 0)
    }

    machine step(text: @[u8; 5] in Utf8, output: @mutable [u8; 5], position: i32)
        requires 0 <= position && position <= 5
    {
        transition position < 5 {
            true -> block shift(text, output, position),
            _ -> block show(output)
        }
    }

    machine shift(text: @[u8; 5] in Utf8, output: @mutable [u8; 5], position: i32)
        requires 0 <= position && position < 5
    {
        let shifted: u8 in Wrapping = (text[position] as u8 +Wrapping) + 3;
        output[position] = shifted as u8;
        transition {
            _ -> block step(text, output, position + 1)
        }
    }

    // Modular byte arithmetic constructs bytes; validate the completed value
    // before lending a qualified view to the console.
    machine show(output: @mutable [u8; 5]) {
        transition valid_utf8(output) {
            true -> block show_valid(output),
            false -> block wrong()
        }
    }

    machine show_valid(output: @mutable [u8; 5])
    requires valid_utf8(output)
    {
        |console|::Console::write_line(output);
        transition output[0] == 75 {
            true -> block ok(),
            _ -> block wrong()
        }
    }

    machine ok() {
        |console|::Console::write_line("PASS: ciphertext starts with 'K' -- shift applied correctly (exit 0)");
        |console|::Console::write_line("[press Enter to close]");
        let mutable pause: [u8; 256];
        _ = block |console|::Console::read_line(@mutable pause[..]);
        |process_exit|::ProcessExit::exit_process(0);
    }

    machine wrong() {
        |console|::Console::write_line("FAIL: out[0] != 'K' -- byte shift wrong (exit 1)");
        |console|::Console::write_line("[press Enter to close]");
        let mutable pause: [u8; 256];
        _ = block |console|::Console::read_line(@mutable pause[..]);
        |process_exit|::ProcessExit::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
