// Caesar cipher: shift each byte of a string by a fixed key and print the result.
// A real string TRANSFORMATION -- read a carrier, compute a new byte per position,
// write a new carrier, output it. The shift reads cleanly now that a carrier
// indexed read works inside an expression:
//
//   out[i] = text[i] as u8 in Wrapping + key
//
// `in Wrapping` makes the byte add wrap (decision 17: byte arithmetic is modular,
// not exact -- 'X' + 3 would otherwise need an unprovable no-overflow proof). The
// element read is `u8` (the carrier's `in Utf8` domain is bound to `[u8]` storage,
// not to a single byte). "HELLO" shifted by 3 is "KHOOR". After printing it, the
// program self-checks out[0] == 'K' (75) and exits 0.
//
// Expected exit: 0.
// Expected output contains: KHOOR

use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    console: Binding<Console>;
    text: [u8; 5] in Utf8;
    out: [u8; 5] in Utf8;
    i: i32;                // guard-proven Exact counter (`i < 5` dominates the increment)
    ch: u8 in Wrapping;    // byte arithmetic is genuinely modular (decision 17)
    pause: [u8; 256];
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("caesar_cipher: shift each byte of HELLO by 3 -- expecting KHOOR");
    self.text = "HELLO";
    self.out = ".....";
    self.i = 0;

    transition {
        _ -> step(&mut self)
    }

    state step(main: &mut Main) {
        transition main.i >= 0 && main.i < 5 {
            true -> shift(main)
            _ -> show(main)
        }
    }

    state shift(main: &mut Main) {
        main.ch = main.text[main.i] as u8 in Wrapping + 3;
        main.out[main.i] = main.ch as u8;
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }

    state show(main: &mut Main) {
        main.console.write_line(main.out);
        transition main.out[0] == 75 {
            true -> ok(main)
            _ -> wrong(main)
        }
    }

    state ok(main: &mut Main) {
        main.console.write_line("PASS: ciphertext starts with 'K' -- shift applied correctly (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }

    state wrong(main: &mut Main) {
        main.console.write_line("FAIL: out[0] != 'K' -- byte shift wrong (exit 1)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(1);
    }
}
