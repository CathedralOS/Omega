// Parse an integer from a `[u8;N] in Utf8` carrier string (`atoi`) -- a core
// text-processing primitive. It walks the digits, bounded by the string's
// runtime `.len`, accumulating `result = result*10 + (digit - '0')`:
//
//   result = 0
//   for each byte b in text: result = result * 10 + (b - 48)
//
// Composes a `.len`-bounded loop, runtime carrier byte reads, named widening,
// a guard-proven Exact loop counter, and an honestly-Wrapping accumulator (digit
// bytes carry no range facts, so the multiply-accumulate declares its domain).
// Parsing "150" yields 150 (a dynamic, 3-digit parse -- the length is read at
// runtime, not hard-coded).
// Expected exit: 150.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    pause: [u8; 256];
    text: [u8; 8] in Utf8;
    i: i32 [0..=8];
    b: u8;
    // Wrapping DECLARED: the accumulator multiplies-and-adds digits read out of
    // the carrier, and carrier bytes carry no range facts yet (a parse of
    // arbitrary digits is genuinely unbounded math).
    dval: i32 in Wrapping;
    result: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.console.write_line("parse_int: atoi over a text carrier, digit by digit");
    self.text = "150";
    self.result = 0;
    self.i = 0;

    transition {
        _ -> step()
    }

    // Loop over the digit bytes, bounded by the string's runtime length.
    state step(&mut self) {
        transition self.i < self.text.len {
            true -> digit()
            _ -> done()
        }
    }

    // result = result * 10 + (byte - '0').
    state digit(&mut self) {
        self.b = self.text[self.i];
        self.dval = widen_u8_to_i32(self.b) as i32 in Wrapping;
        self.dval = self.dval - 48;
        self.result = self.result * 10;
        self.result = self.result + self.dval;
        // Re-guard against the carrier CAPACITY (8) so the increment's direct
        // edge proves `i + 1` back into [0..=8] -- len <= 8, so this is always true.
        transition self.i >= 0 && self.i < 8 {
            true -> advance()
            _ -> done()
        }
    }

    state advance(&mut self) {
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.write_line("result: the parsed value of the text 150 (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.result as i32);
    }
}
