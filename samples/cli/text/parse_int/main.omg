use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Parse an integer from a `[u8;N] in Utf8` carrier string (`atoi`) -- a core
// text-processing primitive. It walks the digits, bounded by the string's
// runtime `.length`, accumulating `result = result*10 + (digit - '0')`:
//
//   result = 0
//   for each byte b in text: result = result * 10 + (b - 48)
//
// Composes a `.length`-bounded loop, runtime carrier byte reads, named widening,
// a guard-proven Exact loop counter, and an honestly-Wrapping accumulator (digit
// bytes carry no range facts, so the multiply-accumulate declares its domain).
// Parsing "150" yields 150 (a dynamic, 3-digit parse -- the length is read at
// runtime, not hard-coded).
// Expected exit: 150.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 3]::Utf8
requires
    valid_utf8(self);
// Parsing borrows its input. Only the cursor and accumulator cross state edges;
// the byte and widened digit exist for one iteration.
machine parse_decimal(text: @[u8; 3] in Utf8) -> i32 in Wrapping {
    transition {
        _ -> step(text, 0, 0)
    }

    // Loop over the digit bytes, bounded by the string's runtime length.
    machine step(text: @[u8; 3] in Utf8, index: i32, result: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0
    {
        transition index < text.length {
            true -> digit(text, index, result),
            _ -> (result)
        }
    }

    // result = result * 10 + (byte - '0').
    machine digit(text: @[u8; 3] in Utf8, index: i32, result: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0
    {
        let byte: u8 = text[index];
        let digit_value: i32 in Wrapping = (|numeric_conversion|::widen_u8_to_i32(byte) as i32 +Wrapping) - 48;
        let next_result: i32 in Wrapping = result * 10 + digit_value;
        // Re-guard against the carrier CAPACITY (8) so the increment's direct
        // edge proves `i + 1` lands in [1..=8] -- len <= 8, so this is always true.
        transition index >= 0 && index < 8 {
            true -> advance(text, index, next_result),
            _ -> (next_result)
        }
    }

    machine advance(text: @[u8; 3] in Utf8, index: i32, result: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0 && index < 8
    {
        let next_index: i32 = index + 1;
        transition {
            _ -> step(text, next_index, result)
        }
    }

}

data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("parse_int: atoi over a text carrier, digit by digit");
    let text: [u8; 3] in Utf8 = "150";
    let result: i32 in Wrapping = parse_decimal(@text);
    |console|::Console::write_line("result: the parsed value of the text 150 (the exit code)");
    |console|::Console::write_line("[press Enter to close]");
    let mutable pause: [u8; 256];
    _ = block |console|::Console::read_line(@mutable pause[..]);
    |process_exit|::ProcessExit::exit_process(result as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
