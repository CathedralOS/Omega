// Raw-byte search returns the ordinary library Optional, not a sentinel.
// Checks offset and overlapping candidates, missing/empty patterns, truncated
// tails and embedded zero bytes. No encoding qualification is assumed.
// Expected exit: 0.
use omega::language::core::option;

machine starts_with(bytes: &[u8], pattern: &[u8]) -> bool {
    transition pattern.len == 0 {
        true -> (true)
        false -> nonempty(bytes, pattern)
    }
    machine nonempty(bytes: &[u8], pattern: &[u8]) -> bool
    requires pattern.len > 0
    {
        transition bytes.len > 0 {
            true -> compare(bytes, pattern)
            false -> (false)
        }
    }
    machine compare(bytes: &[u8], pattern: &[u8]) -> bool
    requires bytes.len > 0 && pattern.len > 0
    {
        transition bytes[0] == pattern[0] {
            true -> starts_with(bytes[1..], pattern[1..])
            false -> (false)
        }
    }
}

machine find(bytes: &[u8], pattern: &[u8]) -> Optional<u64> {
    transition { _ -> search(bytes, pattern, 0) }
    machine search(bytes: &[u8], pattern: &[u8], position: u64) -> Optional<u64>
    requires position <= bytes.len
    {
        let remaining: &[u8] = bytes[position..];
        let matches: bool = starts_with(remaining, pattern);
        transition matches {
            true -> (Optional::Some { value: position })
            false -> advance(bytes, pattern, position)
        }
    }
    machine advance(bytes: &[u8], pattern: &[u8], position: u64) -> Optional<u64>
    requires position <= bytes.len
    {
        transition position < bytes.len {
            true -> search(bytes, pattern, position + 1)
            false -> (Optional::None)
        }
    }
}

machine found_at(result: &Optional<u64>, expected: u64) -> bool {
    transition result {
        Optional::Some { value } -> (value == expected)
        Optional::None -> (false)
    }
}

machine absent(result: &Optional<u64>) -> bool {
    transition result {
        Optional::Some { value } -> (false)
        Optional::None -> (true)
    }
}

machine collect_matches(bytes: &[u8], pattern: &[u8], output: &mut [u64]) -> u64
requires pattern.len > 0
{
    transition { _ -> scan(bytes, pattern, output, 0, 0) }
    machine scan(bytes: &[u8], pattern: &[u8], output: &mut [u64], position: u64, count: u64) -> u64
    requires position <= bytes.len && count <= output.len
    {
        transition position < bytes.len && count < output.len {
            true -> examine(bytes, pattern, output, position, count)
            false -> (count)
        }
    }
    machine examine(bytes: &[u8], pattern: &[u8], output: &mut [u64], position: u64, count: u64) -> u64
    requires position < bytes.len && count < output.len
    {
        let matches: bool = starts_with(bytes[position..], pattern);
        transition matches {
            true -> record(bytes, pattern, output, position, count)
            false -> scan(bytes, pattern, output, position + 1, count)
        }
    }
    machine record(bytes: &[u8], pattern: &[u8], output: &mut [u64], position: u64, count: u64) -> u64
    requires position < bytes.len && count < output.len
    {
        output[count] = position;
        transition { _ -> scan(bytes, pattern, output, position + 1, count + 1) }
    }
}

machine main() crashes Trap {
    let offset: Optional<u64> = find("abracadabra", "cad");
    let overlapping: Optional<u64> = find("aaaab", "aab");
    let zero: Optional<u64> = find("a\0bc", "\0b");
    let missing: Optional<u64> = find("abc", "d");
    let truncated: Optional<u64> = find("abc", "bcd");
    let empty: Optional<u64> = find("", "");
    let empty_pattern: Optional<u64> = find("abc", "");
    let empty_input: Optional<u64> = find("", "x");
    let mut positions: [u64; 4];
    positions[3] = 99;
    let count: u64 = collect_matches("aaaa", "aa", &mut positions[..]);
    let all_matches: bool = count == 3 && positions[0] == 0 && positions[1] == 1
        && positions[2] == 2 && positions[3] == 99;
    let limited: u64 = collect_matches("aaaa", "aa", &mut positions[..2]);
    let no_input: u64 = collect_matches("", "aa", &mut positions[..]);
    transition found_at(&offset, 4) && found_at(&overlapping, 2)
        && found_at(&zero, 1) && absent(&missing) && absent(&truncated)
        && found_at(&empty, 0) && found_at(&empty_pattern, 0) && absent(&empty_input)
        && all_matches && limited == 2 && no_input == 0 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
