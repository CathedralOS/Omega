// Raw-byte search returns the ordinary library Optional, not a sentinel.
// Checks offset and overlapping candidates, missing/empty patterns, truncated
// tails and embedded zero bytes. No encoding qualification is assumed.
// Expected exit: 0.
use {omega}/language/core/option.omg;

machine starts_with(bytes: @[u8], pattern: @[u8]) -> bool {
    transition pattern.length == 0 {
        true -> (true),
        false -> nonempty(bytes, pattern)
    }
    machine nonempty(bytes: @[u8], pattern: @[u8]) -> bool
    requires pattern.length > 0
    {
        transition bytes.length > 0 {
            true -> compare(bytes, pattern),
            false -> (false)
        }
    }
    machine compare(bytes: @[u8], pattern: @[u8]) -> bool
    requires bytes.length > 0 && pattern.length > 0
    {
        transition bytes[0] == pattern[0] {
            true -> starts_with(bytes[1..], pattern[1..]),
            false -> (false)
        }
    }
}

machine find(bytes: @[u8], pattern: @[u8]) -> |option|::Optional<u64> {
    transition { _ -> search(bytes, pattern, 0) }
    machine search(bytes: @[u8], pattern: @[u8], position: u64) -> |option|::Optional<u64>
    requires position <= bytes.length
    {
        let remaining: @[u8] = bytes[position..];
        let matches: bool = starts_with(remaining, pattern);
        transition matches {
            true -> (|option|::Optional::Some { value: position }),
            false -> advance(bytes, pattern, position)
        }
    }
    machine advance(bytes: @[u8], pattern: @[u8], position: u64) -> |option|::Optional<u64>
    requires position <= bytes.length
    {
        transition position < bytes.length {
            true -> search(bytes, pattern, position + 1),
            false -> (|option|::Optional::None)
        }
    }
}

machine found_at(result: @|option|::Optional<u64>, expected: u64) -> bool {
    transition result {
        |option|::Optional::Some { value } -> (value == expected),
        |option|::Optional::None -> (false)
    }
}

machine absent(result: @|option|::Optional<u64>) -> bool {
    transition result {
        |option|::Optional::Some { value } -> (false),
        |option|::Optional::None -> (true)
    }
}

machine collect_matches(bytes: @[u8], pattern: @[u8], output: @mutable [u64]) -> u64
requires pattern.length > 0
{
    transition { _ -> scan(bytes, pattern, output, 0, 0) }
    machine scan(bytes: @[u8], pattern: @[u8], output: @mutable [u64], position: u64, count: u64) -> u64
    requires position <= bytes.length && count <= output.length
    {
        transition position < bytes.length && count < output.length {
            true -> examine(bytes, pattern, output, position, count),
            false -> (count)
        }
    }
    machine examine(bytes: @[u8], pattern: @[u8], output: @mutable [u64], position: u64, count: u64) -> u64
    requires position < bytes.length && count < output.length
    {
        let matches: bool = starts_with(bytes[position..], pattern);
        transition matches {
            true -> record(bytes, pattern, output, position, count),
            false -> scan(bytes, pattern, output, position + 1, count)
        }
    }
    machine record(bytes: @[u8], pattern: @[u8], output: @mutable [u64], position: u64, count: u64) -> u64
    requires position < bytes.length && count < output.length
    {
        output[count] = position;
        transition { _ -> scan(bytes, pattern, output, position + 1, count + 1) }
    }
}

machine main() crashes Trap {
    let offset: |option|::Optional<u64> = find("abracadabra", "cad");
    let overlapping: |option|::Optional<u64> = find("aaaab", "aab");
    let zero: |option|::Optional<u64> = find("a\0bc", "\0b");
    let missing: |option|::Optional<u64> = find("abc", "d");
    let truncated: |option|::Optional<u64> = find("abc", "bcd");
    let empty: |option|::Optional<u64> = find("", "");
    let empty_pattern: |option|::Optional<u64> = find("abc", "");
    let empty_input: |option|::Optional<u64> = find("", "x");
    let mutable positions: [u64; 4];
    positions[3] = 99;
    let count: u64 = collect_matches("aaaa", "aa", @mutable positions[..]);
    let all_matches: bool = count == 3 && positions[0] == 0 && positions[1] == 1
        && positions[2] == 2 && positions[3] == 99;
    let limited: u64 = collect_matches("aaaa", "aa", @mutable positions[..2]);
    let no_input: u64 = collect_matches("", "aa", @mutable positions[..]);
    transition found_at(@offset, 4) && found_at(@overlapping, 2)
        && found_at(@zero, 1) && absent(@missing) && absent(@truncated)
        && found_at(@empty, 0) && found_at(@empty_pattern, 0) && absent(@empty_input)
        && all_matches && limited == 2 && no_input == 0 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
