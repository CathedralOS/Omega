use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// FNV-1a string hash -- a real byte-string algorithm over a `[u8;N] in Utf8`
// carrier. It walks the string's bytes by runtime index, bounded by the carrier's
// runtime `.length`, and folds each byte into a 32-bit hash:
//
//   hash = 2166136261
//   for each byte b in text: hash = (hash ^ b) * 16777619   (u32, wrapping)
//
// This composes everything needed to process real text: a `.length`-bounded loop,
// a runtime-indexed carrier byte read, named widening, bitwise XOR, and a
// wrapping multiply. Hashing "omega", the low byte of the digest is 40.
// Expected exit: 40.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 5]::Utf8
requires
    valid_utf8(self);

data Main {
}

// Only the borrowed input, position and rolling hash survive an iteration.
machine hash_text(text: @[u8; 5] in Utf8) -> u32 in Wrapping {
    transition { _ -> step(text, 0, 2166136261) }

    // Loop over the string's bytes, bounded by its runtime length.
    machine step(text: @[u8; 5] in Utf8, position: i32,
               hash: u32 in Wrapping) -> u32 in Wrapping
    requires position >= 0
    {
        transition position < text.length {
            true -> mix(text, position, hash),
            _ -> (hash)
        }
    }

    // Fold the current byte into the hash (FNV-1a: xor then multiply).
    machine mix(text: @[u8; 5] in Utf8, position: i32,
              hash: u32 in Wrapping) -> u32 in Wrapping
    requires position >= 0
    {
        let byte: u8 = text[position];
        let widened: u32 in Wrapping = |numeric_conversion|::widen_u8_to_u32(byte) as u32 +Wrapping;
        let mixed: u32 in Wrapping = hash ^ widened;
        let next_hash: u32 in Wrapping = mixed * 16777619;
        transition position < 8 {
            true -> bump(text, position, next_hash),
            _ -> (next_hash)
        }
    }

    machine bump(text: @[u8; 5] in Utf8, position: i32,
               hash: u32 in Wrapping) -> u32 in Wrapping
    requires position >= 0 && position < 8
    {
        let next_position: i32 = position + 1;
        transition { _ -> step(text, next_position, hash) }
    }
}

machine main(context: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("string_hash: FNV-1a hashes the bytes of the string omega");
    let text: [u8; 5] in Utf8 = "omega";
    let hash: u32 in Wrapping = hash_text(@text);
    let digest: u32 in Wrapping = hash & 255;
    let output: i32 = |numeric_conversion|::narrow_u32_to_i32_trapping(digest as u32);
    |console|::Console::write_line("result: the digest's low byte, 40 for omega (the exit code)");
    |console|::Console::write_line("[press Enter to close]");
    let mutable pause: [u8; 256];
    _ = block |console|::Console::read_line(@mutable pause[..]);
    |process_exit|::ProcessExit::exit_process(output);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
