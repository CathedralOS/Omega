// FNV-1a string hash -- a real byte-string algorithm over a `[u8;N] in Utf8`
// carrier. It walks the string's bytes by runtime index, bounded by the carrier's
// runtime `.len`, and folds each byte into a 32-bit hash:
//
//   hash = 2166136261
//   for each byte b in text: hash = (hash ^ b) * 16777619   (u32, wrapping)
//
// This composes everything needed to process real text: a `.len`-bounded loop,
// a runtime-indexed carrier byte read, named widening, bitwise XOR, and a
// wrapping multiply. Hashing "omega", the low byte of the digest is 40.
// Expected exit: 40.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
}

// Only the borrowed input, position and rolling hash survive an iteration.
machine hash_text(text: &[u8; 5] in Utf8) -> u32 in Wrapping {
    transition { _ -> step(text, 0, 2166136261) }

    // Loop over the string's bytes, bounded by its runtime length.
    state step(text: &[u8; 5] in Utf8, position: i32,
               hash: u32 in Wrapping) -> u32 in Wrapping
    requires position >= 0
    {
        transition position < text.len {
            true -> mix(text, position, hash)
            _ -> (hash)
        }
    }

    // Fold the current byte into the hash (FNV-1a: xor then multiply).
    state mix(text: &[u8; 5] in Utf8, position: i32,
              hash: u32 in Wrapping) -> u32 in Wrapping
    requires position >= 0
    {
        let byte: u8 = text[position];
        let widened: u32 in Wrapping = widen_u8_to_u32(byte) as u32 in Wrapping;
        let mixed: u32 in Wrapping = hash ^ widened;
        let next_hash: u32 in Wrapping = mixed * 16777619;
        transition position < 8 {
            true -> bump(text, position, next_hash)
            _ -> (next_hash)
        }
    }

    state bump(text: &[u8; 5] in Utf8, position: i32,
               hash: u32 in Wrapping) -> u32 in Wrapping
    requires position >= 0 && position < 8
    {
        let next_position: i32 = position + 1;
        transition { _ -> step(text, next_position, hash) }
    }
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("string_hash: FNV-1a hashes the bytes of the string omega");
    let text: [u8; 5] in Utf8 = "omega";
    let hash: u32 in Wrapping = hash_text(&text);
    let digest: u32 in Wrapping = hash & 255;
    let output: i32 = narrow_u32_to_i32_trapping(digest as u32);
    Console::write_line("result: the digest's low byte, 40 for omega (the exit code)");
    Console::write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block Console::read_line(&mut pause);
    Console::exit_process(output);
}
