// Expected exit: 0.
// Parse hex byte pairs with per-nibble wildcards, then scan overlapping starts.
use {omega}/language/core/option.omg;

data Nibble [copy] requires value < 16, mask < 16 { value: u8; mask: u8; }
data PatternByte [copy] { value: u8; mask: u8; }

machine nibble(character: u8) -> |option|::Optional<Nibble> {
    transition character == 63 {
        true -> |option|::Optional::Some { value: Nibble { value: 0, mask: 0 } },
        false -> decimal(character)
    }
    machine decimal(character: u8) -> |option|::Optional<Nibble> {
        transition character >= 48 && character <= 57 {
            true -> digit(character),
            false -> upper(character)
        }
    }
    machine digit(character: u8) -> |option|::Optional<Nibble>
    requires character >= 48 && character <= 57 {
        |option|::Optional::Some { value: Nibble { value: character - 48, mask: 15 } }
    }
    machine upper(character: u8) -> |option|::Optional<Nibble> {
        transition character >= 65 && character <= 70 {
            true -> upper_digit(character),
            false -> lower(character)
        }
    }
    machine upper_digit(character: u8) -> |option|::Optional<Nibble>
    requires character >= 65 && character <= 70 {
        |option|::Optional::Some { value: Nibble { value: character - 55, mask: 15 } }
    }
    machine lower(character: u8) -> |option|::Optional<Nibble> {
        transition character >= 97 && character <= 102 {
            true -> lower_digit(character),
            false -> |option|::Optional::None
        }
    }
    machine lower_digit(character: u8) -> |option|::Optional<Nibble>
    requires character >= 97 && character <= 102 {
        |option|::Optional::Some { value: Nibble { value: character - 87, mask: 15 } }
    }
}

machine pair(upper: u8, lower: u8) -> |option|::Optional<PatternByte> {
    let high: |option|::Optional<Nibble> = nibble(upper);
    transition high {
        |option|::Optional::Some { value } -> second(value, lower),
        |option|::Optional::None -> |option|::Optional::None
    }
    machine second(high: Nibble, lower: u8) -> |option|::Optional<PatternByte> {
        let low: |option|::Optional<Nibble> = nibble(lower);
        transition low {
            |option|::Optional::Some { value } -> |option|::Optional::Some { value: PatternByte {
                value: high.value * 16 + value.value,
                mask: high.mask * 16 + value.mask
            } },
            |option|::Optional::None -> |option|::Optional::None
        }
    }
}

machine parse(input: @[u8], output: @mutable [PatternByte]) -> |option|::Optional<u64> {
    transition { _ -> next(input, output, 0) }
    machine next(input: @[u8], output: @mutable [PatternByte], count: u64) -> |option|::Optional<u64>
    requires count <= output.length {
        transition input.length == 0 {
            true -> |option|::Optional::Some { value: count },
            false -> available(input, output, count)
        }
    }
    machine available(input: @[u8], output: @mutable [PatternByte], count: u64) -> |option|::Optional<u64> {
        transition input.length >= 2 && count < output.length {
            true -> decode(input, output, count),
            false -> |option|::Optional::None
        }
    }
    machine decode(input: @[u8], output: @mutable [PatternByte], count: u64) -> |option|::Optional<u64>
    requires input.length >= 2 && count < output.length {
        let decoded: |option|::Optional<PatternByte> = pair(input[0], input[1]);
        transition decoded {
            |option|::Optional::Some { value } -> save(input, output, count, value),
            |option|::Optional::None -> |option|::Optional::None
        }
    }
    machine save(input: @[u8], output: @mutable [PatternByte], count: u64, value: PatternByte)
        -> |option|::Optional<u64>
    requires input.length >= 2 && count < output.length {
        output[count] = value;
        transition { _ -> next(input[2..], output, count + 1) }
    }
}

machine prefix(bytes: @[u8], pattern: @[PatternByte]) -> bool {
    transition pattern.length == 0 {
        true -> true,
        false -> available(bytes, pattern)
    }
    machine available(bytes: @[u8], pattern: @[PatternByte]) -> bool
    requires pattern.length > 0 {
        transition bytes.length > 0 {
            true -> compare(bytes, pattern),
            false -> false
        }
    }
    machine compare(bytes: @[u8], pattern: @[PatternByte]) -> bool
    requires bytes.length > 0 && pattern.length > 0 {
        transition (bytes[0] & pattern[0].mask) == pattern[0].value {
            true -> prefix(bytes[1..], pattern[1..]),
            false -> false
        }
    }
}

machine scan(bytes: @[u8], pattern: @[PatternByte], positions: @mutable [u64]) -> u64
requires pattern.length > 0 {
    transition { _ -> next(bytes, pattern, positions, 0, 0) }
    machine next(bytes: @[u8], pattern: @[PatternByte], positions: @mutable [u64], start: u64, count: u64) -> u64
    requires start <= bytes.length && count <= positions.length {
        transition start < bytes.length && count < positions.length {
            true -> inspect(bytes, pattern, positions, start, count),
            false -> count
        }
    }
    machine inspect(bytes: @[u8], pattern: @[PatternByte], positions: @mutable [u64], start: u64, count: u64) -> u64
    requires start < bytes.length && count < positions.length {
        transition prefix(bytes[start..], pattern) {
            true -> record(bytes, pattern, positions, start, count),
            false -> next(bytes, pattern, positions, start + 1, count)
        }
    }
    machine record(bytes: @[u8], pattern: @[PatternByte], positions: @mutable [u64], start: u64, count: u64) -> u64
    requires start < bytes.length && count < positions.length {
        positions[count] = start;
        transition { _ -> next(bytes, pattern, positions, start + 1, count + 1) }
    }
}

machine count_is(parsed: |option|::Optional<u64>, expected: u64) -> bool {
    transition parsed {
        |option|::Optional::Some { value } -> (value == expected),
        |option|::Optional::None -> false
    }
}
machine rejected(parsed: |option|::Optional<u64>) -> bool {
    transition parsed {
        |option|::Optional::Some { value } -> false,
        |option|::Optional::None -> true
    }
}

machine main() crashes Trap {
    let mutable pattern: [PatternByte; 3];
    let parsed: bool = count_is(parse("4???7F", @mutable pattern[..]), 3);
    let masks: bool = pattern[0].value == 64 && pattern[0].mask == 240
        && pattern[1].value == 0 && pattern[1].mask == 0
        && pattern[2].value == 127 && pattern[2].mask == 255;
    let bytes: [u8; 7] = [65, 0, 127, 79, 170, 127, 79];
    let mutable positions: [u64; 4] = [99, 99, 99, 99];
    let count: u64 = scan(@bytes[..], @pattern[..], @mutable positions[..]);
    let matches: bool = count == 2 && positions[0] == 0 && positions[1] == 3
        && positions[2] == 99 && positions[3] == 99;
    let exact: bool = count_is(parse("4141", @mutable pattern[..]), 2);
    let overlap: u64 = scan("AAAA", @pattern[..2], @mutable positions[..]);
    let overlapping: bool = overlap == 3 && positions[0] == 0
        && positions[1] == 1 && positions[2] == 2 && positions[3] == 99;
    let wildcard: bool = count_is(parse("??", @mutable pattern[..]), 1);
    let limited: u64 = scan(@bytes[..], @pattern[..1], @mutable positions[..2]);
    let empty: u64 = scan("", @pattern[..1], @mutable positions[..]);
    let lower: bool = count_is(parse("fF", @mutable pattern[..]), 1)
        && pattern[0].value == 255 && pattern[0].mask == 255;
    let empty_parse: bool = count_is(parse("", @mutable pattern[..0]), 0);
    let invalid: bool = rejected(parse("G0", @mutable pattern[..]));
    let odd: bool = rejected(parse("0", @mutable pattern[..]));
    let full: bool = rejected(parse("0000", @mutable pattern[..1]));
    transition parsed && masks && matches && exact && overlapping && wildcard
        && limited == 2 && empty == 0 && lower && empty_parse && invalid && odd && full {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
