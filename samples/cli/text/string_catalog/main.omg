// Text catalog: explicit fixed-capacity text owners in a data type with field copies,
// concatenation, equality guards, and a numeric score derived from matches.
//
// Exercises: carrier field assignments, copying carriers between places,
// explicit buffer construction from borrowed names and literals, `==` equality guards, and
// a numeric accumulator driven by text-guard arms.
//
// Scenario: a small catalog with two entries. Each entry has a bounded UTF-8
// name and a score. After setting up the entries, the program verifies
// the names match expected values, builds a combined label by concatenation,
// verifies the concatenated label, and totals the scores.
//
// Data:
//   entry1.name = "Alpha", entry1.score = 30
//   entry2.name = "Beta",  entry2.score = 40
//
// Concatenated label: "[" + entry1.name + "+" + entry2.name + "]"
//                   = "[Alpha+Beta]"
// Total score: 30 + 40 = 70.
//
// Checks:
//   1. entry1.name == "Alpha"     -> pass
//   2. entry2.name == "Beta"      -> pass
//   3. label == "[Alpha+Beta]"    -> pass
//   4. total == 70                -> exit 70
//
// Exit 71 = wrong entry1.name, 72 = wrong entry2.name,
//           73 = wrong label, 74 = wrong total.
//
// Expected exit: 70.

domain [u8; 32]::Ascii(bytes) requires ascii_only(bytes);
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
data TextBuffer where used <= 32 { storage: [u8; 32] in Ascii; used: u64; }
machine live(buffer: &TextBuffer) -> &[u8] in Ascii { &buffer.storage[..buffer.used] }
machine copy(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64)
requires start <= 32; bytes.len <= 32 - start
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    state copying(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 32; index <= 32
    {
        transition index < bytes.len && start + index < 32 {
            true -> writing(buffer, bytes, start, index)
            _ -> done()
        }
    }
    state writing(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 32; index < 32; index < bytes.len; start + index < 32
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    state done() {}
}

use omega_language_std::console;

// Bounded so `entry1.score + entry2.score` is verifiably at most 200: Exact
// arithmetic on nested fields carries the overflow obligation, and the `where`
// bound discharges it by proof -- no overflow domain needed.
domain [u8; 5]::Ascii(bytes) requires ascii_only(bytes);
data NameBuffer where used <= 5 { storage: [u8; 5] in Ascii; used: u64; }
machine name_view(name: &NameBuffer) -> &[u8] in Ascii { &name.storage[..name.used] }

data Entry where 0 <= score, score <= 100 {
    name: NameBuffer;
    score: i32;
}

data Catalog {
    entry1: Entry;
    entry2: Entry;
    label: TextBuffer;
    total: i32;
}

data Main {
    catalog: Catalog;
    pause: [u8; 256];
}

machine Main::set_entry1(main: &mut Main)
{
    main.catalog.entry1.name.storage = "Alpha";
    main.catalog.entry1.name.used = 5;
    main.catalog.entry1.score = 30;
}

machine Main::set_entry2(main: &mut Main)
{
    main.catalog.entry2.name.storage = [66u8, 101u8, 116u8, 97u8, 0u8];
    main.catalog.entry2.name.used = 4;
    main.catalog.entry2.score = 40;
}

machine Main::build_label(main: &mut Main)
{
    copy(&mut main.catalog.label.storage, "[", 0);
    copy(&mut main.catalog.label.storage, &main.catalog.entry1.name.storage[..main.catalog.entry1.name.used], 1);
    copy(&mut main.catalog.label.storage, "+", 1 + main.catalog.entry1.name.used);
    copy(&mut main.catalog.label.storage, &main.catalog.entry2.name.storage[..main.catalog.entry2.name.used], 2 + main.catalog.entry1.name.used);
    copy(&mut main.catalog.label.storage, "]", 2 + main.catalog.entry1.name.used + main.catalog.entry2.name.used);
    main.catalog.label.used = 3 + main.catalog.entry1.name.used + main.catalog.entry2.name.used;
}

machine Main::compute_total(main: &mut Main) {
    main.catalog.total = main.catalog.entry1.score + main.catalog.entry2.score;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("string_catalog: bounded UTF-8 fields, concatenation, and equality guards");
    Main::set_entry1(main);
    Main::set_entry2(main);
    Main::build_label(main);
    Main::compute_total(main);

    // Check entry1.name.
    transition name_view(&main.catalog.entry1.name) == "Alpha" {
        true -> check_name2(main)
        _ -> bad_name1(main)
    }

    state bad_name1(main: &mut Main) {
        Console::write_line("FAIL: entry1.name did not equal Alpha (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_name2(main: &mut Main) {
        transition name_view(&main.catalog.entry2.name) == "Beta" {
            true -> check_label(main)
            _ -> bad_name2(main)
        }
    }

    state bad_name2(main: &mut Main) {
        Console::write_line("FAIL: entry2.name did not equal Beta (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state check_label(main: &mut Main) {
        transition live(&main.catalog.label) == "[Alpha+Beta]" {
            true -> check_total(main)
            _ -> bad_label(main)
        }
    }

    state bad_label(main: &mut Main) {
        Console::write_line("FAIL: concatenated label was not [Alpha+Beta] (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state check_total(main: &mut Main) {
        transition main.catalog.total == 70 {
            true -> good(main)
            _ -> bad_total(main)
        }
    }

    state bad_total(main: &mut Main) {
        Console::write_line("FAIL: score total was not 70 (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: names, label [Alpha+Beta], and total 70 all verified (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
