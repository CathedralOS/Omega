// Read bytes to EOF, write each byte plus one modulo 256, and exit with the count.
// ByteRead::Eof is distinct from a zero-valued Byte payload.
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 1
//   "AB" -> 2
//   "ab " -> 3
// The default input is empty; cases.json pins finite input/output vectors.

use omega_language_std::ByteRead;
use omega_language_std::Console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> block read_next_byte(0) }

    machine read_next_byte(count: i32 in Wrapping) {
        let read_result: ByteRead = block Console::read_byte();
        transition read_result {
            ByteRead::Byte { value } -> block write_incremented_byte(count, value)
            _ -> exit_with_count(count)
        }
    }

    machine write_incremented_byte(count: i32 in Wrapping, value: i32)
    requires value >= 0 && value <= 0xFF {
        let byte: i32 in Wrapping = value as i32 in Wrapping;
        let incremented: i32 in Wrapping = byte + 1;
        let output: i32 = incremented as i32;
        Console::write_byte(output);
        transition { _ -> block read_next_byte(count + 1) }
    }

    machine exit_with_count(count: i32 in Wrapping) {
        Console::exit_process(count as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
