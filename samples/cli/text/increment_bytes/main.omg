use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Read bytes to EOF, write each byte plus one modulo 256, and exit with the count.
// ByteRead::Eof is distinct from a zero-valued Byte payload.
// Expected exit: 0.
// INPUT-GRID:
//   "" -> 0
//   "A" -> 1
//   "AB" -> 2
//   "ab " -> 3
// The default input is empty; cases.json pins finite input/output vectors.


data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    transition { _ -> block read_next_byte(0 as +Wrapping) }

    machine read_next_byte(count: i32 in Wrapping) {
        let read_result: |console|::ByteRead = block |console|::Console::read_byte();
        transition read_result {
            |console|::ByteRead::Error -> |process_exit|::ProcessExit::exit_process(74),
            |console|::ByteRead::Byte { value } -> block write_incremented_byte(count, value),
            |console|::ByteRead::Eof -> exit_with_count(count)
        }
    }

    machine write_incremented_byte(count: i32 in Wrapping, value: i32)
    requires value >= 0 && value <= 0xFF {
        let byte: i32 in Wrapping = value as +Wrapping;
        let incremented: i32 in Wrapping = byte + 1;
        let output: i32 = incremented as i32;
        |console|::Console::write_byte(output);
        transition { _ -> block read_next_byte(count + 1) }
    }

    machine exit_with_count(count: i32 in Wrapping) {
        |process_exit|::ProcessExit::exit_process(count as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
