use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Parse a two-digit number out of its text form -- the core of reading numeric
// input. Each character byte is widened to i32 through the named conversion,
// then '0' (48) is subtracted to get the digit, and the digits are combined as
// `tens*10 + ones`. For "25" this yields 2*10 + 5 = 25. The arithmetic is fully
// EXACT: a carrier byte read carries no range fact yet, so each widened value is
// folded through `% 256` (an identity for a u8-sourced value) to bound it, after
// which every step is verifiably in range -- no overflow domain needed.
// Expected exit: 25.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 2]::Utf8
requires
    valid_utf8(self);

data Main {
    pause: [u8; 256];
    text: [u8; 2] in Utf8;
    tens: i32;
    ones: i32;
    value: i32;
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("parse_number: reading the two-digit text 25 back into an integer");
    main.text = "25";

    main.tens = |numeric_conversion|::widen_u8_to_i32(main.text[0]) % 256;
    main.tens = main.tens - 48;
    main.ones = |numeric_conversion|::widen_u8_to_i32(main.text[1]) % 256;
    main.ones = main.ones - 48;
    main.value = main.tens * 10 + main.ones;

    transition { _ -> block done(main) }

    machine done(main: @mutable Main) {
        |console|::Console::write_line("result: the parsed value, 25 for this text (the exit code)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(main.value);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
