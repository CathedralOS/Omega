// Compute the right-padding needed to align a message to a fixed column width,
// from the message's carrier length (10 for "ALERT temp").
//
// A carrier `.len` is a COUNT, and a count is `u64` -- see
// `wiki/spec/language/counts_and_addresses.md`. It is not carrier-free, and it
// does not silently take the destination's type: `let padding: i32 in Saturating
// = 16 - message.len` is a cross-carrier initialization and
// is refused, naming the `as` that spells it. Subtracting an unconverted
// length from a literal would also be `u64` arithmetic, which underflows for
// a message longer than the width, so the conversion is where the intent gets
// stated rather than a formality.
//
// Converting at the read selects signed saturating arithmetic. For this message,
// 16 - 10 = 6. A longer message could produce a negative result: saturation
// clamps at the i32 bounds, not at zero.
// Expected exit: 6.
// Expected output contains: ALERT temp

use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 32]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main) reaches Console {
    context.console.write_line("text_padding: computes right-padding to a 16-column width from carrier length");
    let message: [u8; 32] in Utf8 = "ALERT temp";
    let padding: i32 in Saturating = 16 - (message.len as i32 in Saturating);
    context.console.write_line(message);

    transition { _ -> done(context, padding) }

    state done(context: &mut Main, padding: i32 in Saturating) {
        context.console.write_line("result: the padding count, 6 for this 10-char message (the exit code)");
        context.console.write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block context.console.read_line(&mut pause);
        context.console.exit_process(padding as i32);
    }
}
