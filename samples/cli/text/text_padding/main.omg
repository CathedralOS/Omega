// Compute the right-padding needed to align a message to a fixed column width,
// from the message's carrier length. `self.padding = 16 - self.message.len` reads
// the `[u8; N] in Utf8` carrier's length (10 for "ALERT temp") as an ordinary
// arithmetic operand -- carrier `.len` resolves uniformly in every value position
// (guards, host-call args, field writes, arithmetic, let bindings) since it lives
// in the shared place resolver. The `Saturating` domain means an over-long message
// yields 0 padding instead of underflowing. 16 - 10 = 6.
// Expected exit: 6.
// Expected output contains: ALERT temp

use omega_language_std::console;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 32]::Utf8
requires
    valid_utf8(self);
domain [u8; 256]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Console;
    message: [u8; 32] in Utf8;
    padding: i32 in Saturating;
    pause: [u8; 256] in Utf8;
}

machine Main::main(&mut self) {
    self.console.write_line("text_padding: computes right-padding to a 16-column width from carrier length");
    self.message = "ALERT temp";
    self.padding = 16 - self.message.len;
    self.console.write_line(self.message);

    transition { _ -> done() }

    state done(&mut self) {
        self.console.write_line("result: the padding count, 6 for this 10-char message (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.padding as i32);
    }
}
