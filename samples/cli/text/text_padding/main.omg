// Compute the right-padding needed to align a message to a fixed column width,
// from the message's carrier length (10 for "ALERT temp").
//
// A carrier `.len` is a COUNT, and a count is `u64` -- see
// `wiki/spec/language/counts_and_addresses.md`. It is not carrier-free, and it
// does not silently take the destination's type: `self.padding = 16 -
// self.message.len` into an `i32 in Saturating` is a cross-carrier store and
// is refused, naming the `as` that spells it. Subtracting an unconverted
// length from a literal would also be `u64` arithmetic, which underflows for
// a message longer than the width, so the conversion is where the intent gets
// stated rather than a formality.
//
// Converting at the read puts the subtraction in the destination's carrier,
// where `Saturating` means an over-long message yields 0 padding instead of
// underflowing. 16 - 10 = 6.
// Expected exit: 6.
// Expected output contains: ALERT temp

use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 32]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Binding<Console>;
    message: [u8; 32] in Utf8;
    padding: i32 in Saturating;
    pause: [u8; 256];
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("text_padding: computes right-padding to a 16-column width from carrier length");
    self.message = "ALERT temp";
    self.padding = 16 - (self.message.len as i32 in Saturating);
    self.console.write_line(self.message);

    transition { _ -> done() }

    state done(&mut self) {
        self.console.write_line("result: the padding count, 6 for this 10-char message (the exit code)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(self.padding as i32);
    }
}
