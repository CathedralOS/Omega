// Compute the right-padding needed to align a message to a fixed column width,
// from the message's carrier length (10 for "ALERT temp").
//
// A carrier `.len` is a COUNT, and a count is `u64` -- see
// `wiki/spec/language/counts_and_addresses.md`. It is not carrier-free, and it
// does not silently take the destination's type: `main.padding = 16 -
// main.message.len` into an `i32 in Saturating` is a cross-carrier store and
// is refused without an explicit named conversion. Subtracting an unconverted
// length from a literal would also be `u64` arithmetic, which underflows for
// a message longer than the width, so the conversion is where the intent gets
// stated rather than a formality.
//
// Converting at the read puts the subtraction in the destination's carrier,
// where `Saturating` governs the subtraction instead of unsigned underflow.
// The named conversion caps an unrepresentable length at i32::MAX.
// For this message, 16 - 10 = 6.
// Expected exit: 6.
// Expected output contains: ALERT temp

use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 10]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    message: [u8; 10] in Utf8;
    padding: i32 in Saturating;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("text_padding: computes right-padding to a 16-column width from carrier length");
    main.message = "ALERT temp";
    main.padding = 16 - (narrow_u64_to_i32_saturating(main.message.len) as i32 in Saturating);
    Console::write_line(main.message);

    transition { _ -> done(main) }

    state done(main: &mut Main) {
        Console::write_line("result: the padding count, 6 for this 10-char message (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.padding as i32);
    }
}
