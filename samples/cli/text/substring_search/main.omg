use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Naive substring search: find the index of the first occurrence of `pat` in `text`, or -1 if
// absent. For "abracadabra" / "cad" the match is at index 4. Two nested scans over carriers: an
// outer position `i`, and an inner pattern index `j` with a running text index `k` (kept
// incrementally as i + j, so no computed index is needed). An explicit `k < text.length` guard keeps
// the per-byte read in bounds and treats running off the end as a mismatch. Demonstrates nested
// carrier loops with match/mismatch backtracking -- text search, a serious-app primitive.
// Expected exit: 4.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 11]::Utf8
requires
    valid_utf8(self);
domain [u8; 3]::Utf8
requires
    valid_utf8(self);
use system\Console;
use omega\language\core\narrow_u32_to_i32_trapping;

data Main {
    text: [u8; 11] in Utf8;
    pat: [u8; 3] in Utf8;
    i: u32 in Wrapping;
    j: u32 in Wrapping;
    k: u32 in Wrapping;
    tb: u8 in Wrapping;
    pb: u8 in Wrapping;
    found: i32 in Wrapping;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("substring_search: naive search finds cad inside abracadabra");
    main.text = "abracadabra";
    main.pat = "cad";
    main.i = 0;
    main.found = 0 - 1;
    transition { _ -> block outer(main) }

    machine outer(main: @mutable Main) {
        transition main.found < 0 {
            true -> block outer_pos(main),
            false -> block done(main)
        }
    }
    machine outer_pos(main: @mutable Main) {
        transition main.i < main.text.length {
            true -> block start_inner(main),
            false -> block done(main)
        }
    }
    machine start_inner(main: @mutable Main) {
        main.j = 0;
        main.k = main.i;
        transition { _ -> block inner(main) }
    }
    machine inner(main: @mutable Main) {
        transition main.j < main.pat.length {
            true -> block check_bound(main),
            false -> block matched(main)
        }
    }
    machine check_bound(main: @mutable Main) {
        transition main.k < main.text.length {
            true -> block compare(main),
            false -> block mismatch(main)
        }
    }
    machine compare(main: @mutable Main) {
        main.tb = main.text[main.k] as u8 +Wrapping;
        main.pb = main.pat[main.j] as u8 +Wrapping;
        transition main.tb == main.pb {
            true -> block adv_inner(main),
            false -> block mismatch(main)
        }
    }
    machine adv_inner(main: @mutable Main) {
        main.k = main.k + 1;
        main.j = main.j + 1;
        transition { _ -> block inner(main) }
    }
    machine matched(main: @mutable Main) {
        main.found = narrow_u32_to_i32_trapping(main.i as u32) as i32 +Wrapping;
        transition { _ -> block done(main) }
    }
    machine mismatch(main: @mutable Main) {
        main.i = main.i + 1;
        transition { _ -> block outer(main) }
    }
    machine done(main: @mutable Main) {
        Console::write_line("result: the match index, 4 for cad in abracadabra (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(main.found as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
