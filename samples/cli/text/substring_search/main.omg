// Naive substring search: find the index of the first occurrence of `pat` in `text`, or -1 if
// absent. For "abracadabra" / "cad" the match is at index 4. Two nested scans over carriers: an
// outer position `i`, and an inner pattern index `j` with a running text index `k` (kept
// incrementally as i + j, so no computed index is needed). An explicit `k < text.len` guard keeps
// the per-byte read in bounds and treats running off the end as a mismatch. Demonstrates nested
// carrier loops with match/mismatch backtracking -- text search, a serious-app primitive.
// Expected exit: 4.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    text: [u8; 16] in Utf8;
    pat: [u8; 8] in Utf8;
    i: u32 in Wrapping;
    j: u32 in Wrapping;
    k: u32 in Wrapping;
    tb: u8 in Wrapping;
    pb: u8 in Wrapping;
    found: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("substring_search: naive search finds cad inside abracadabra");
    main.text = "abracadabra";
    main.pat = "cad";
    main.i = 0;
    main.found = 0 - 1;
    transition { _ -> outer(main) }

    state outer(main: &mut Main) {
        transition main.found < 0 {
            true -> outer_pos(main)
            false -> done(main)
        }
    }
    state outer_pos(main: &mut Main) {
        transition main.i < main.text.len {
            true -> start_inner(main)
            false -> done(main)
        }
    }
    state start_inner(main: &mut Main) {
        main.j = 0;
        main.k = main.i;
        transition { _ -> inner(main) }
    }
    state inner(main: &mut Main) {
        transition main.j < main.pat.len {
            true -> check_bound(main)
            false -> matched(main)
        }
    }
    state check_bound(main: &mut Main) {
        transition main.k < main.text.len {
            true -> compare(main)
            false -> mismatch(main)
        }
    }
    state compare(main: &mut Main) {
        main.tb = main.text[main.k] as u8 in Wrapping;
        main.pb = main.pat[main.j] as u8 in Wrapping;
        transition main.tb == main.pb {
            true -> adv_inner(main)
            false -> mismatch(main)
        }
    }
    state adv_inner(main: &mut Main) {
        main.k = main.k + 1;
        main.j = main.j + 1;
        transition { _ -> inner(main) }
    }
    state matched(main: &mut Main) {
        main.found = narrow_u32_to_i32_trapping(main.i as u32) as i32 in Wrapping;
        transition { _ -> done(main) }
    }
    state mismatch(main: &mut Main) {
        main.i = main.i + 1;
        transition { _ -> outer(main) }
    }
    state done(main: &mut Main) {
        Console::write_line("result: the match index, 4 for cad in abracadabra (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.found as i32);
    }
}
