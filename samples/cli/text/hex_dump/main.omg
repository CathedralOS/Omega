// Hex dump -- renders a fixed 16-byte record as one canonical dump line:
// offset, sixteen lowercase hex pairs, then an ASCII gutter that maps every
// byte outside 32..126 to '.'. Bytes are streamed through Console::write_byte
// (a raw byte write into a Utf8 carrier cannot be proven valid UTF-8, so the
// sample assembles no text carrier). Exercises nibble extraction, a computed
// byte writer, and a printable-classification branch -- a text-shaping
// workload the corpus did not hold.
// Expected exit: 0.
// Expected output contains: 4f 6d 65 00

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    data: [u8; 16] in Utf8;
    // Counters are `in Wrapping`: increments are defined arithmetic; the index
    // uses stay bounded by the `i < 16` loop guards.
    i: i32 in Wrapping;
    b: u8;
    bw: u32 in Wrapping;
    hi: u32 in Wrapping;
    lo: u32 in Wrapping;
    chi: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("hex_dump: 16 bytes as one canonical dump line (offset, hex pairs, gutter)");
    Console::write("0000: ");
    main.data = "Omega PCC tape!!";
    main.data[3] = 0;
    main.data[9] = 127;
    main.i = 0;
    transition {
        _ -> hex_loop(main)
    }

    state hex_loop(main: &mut Main) {
        transition main.i < 16 {
            true -> read_byte(main)
            _ -> gutter_start(main)
        }
    }

    state read_byte(main: &mut Main) {
        main.b = main.data[main.i];
        main.bw = widen_u8_to_u32(main.b) as u32 in Wrapping;
        main.hi = main.bw / 16;
        main.lo = main.bw - (main.hi * 16);
        transition {
            _ -> hi_digit(main)
        }
    }

    state hi_digit(main: &mut Main) {
        transition main.hi < 10 {
            true -> hi_num(main)
            _ -> hi_alpha(main)
        }
    }

    state hi_num(main: &mut Main) {
        main.chi = narrow_u32_to_i32_trapping((main.hi + 48) as u32);
        transition {
            _ -> write_hi(main)
        }
    }

    state hi_alpha(main: &mut Main) {
        main.chi = narrow_u32_to_i32_trapping((main.hi + 87) as u32);
        transition {
            _ -> write_hi(main)
        }
    }

    state write_hi(main: &mut Main) {
        Console::write_byte(main.chi);
        transition {
            _ -> lo_digit(main)
        }
    }

    state lo_digit(main: &mut Main) {
        transition main.lo < 10 {
            true -> lo_num(main)
            _ -> lo_alpha(main)
        }
    }

    state lo_num(main: &mut Main) {
        main.chi = narrow_u32_to_i32_trapping((main.lo + 48) as u32);
        transition {
            _ -> write_lo(main)
        }
    }

    state lo_alpha(main: &mut Main) {
        main.chi = narrow_u32_to_i32_trapping((main.lo + 87) as u32);
        transition {
            _ -> write_lo(main)
        }
    }

    state write_lo(main: &mut Main) {
        Console::write_byte(main.chi);
        Console::write_byte(32);
        main.i = main.i + 1;
        transition {
            _ -> hex_loop(main)
        }
    }

    state gutter_start(main: &mut Main) {
        Console::write(" ");
        main.i = 0;
        transition {
            _ -> gutter_loop(main)
        }
    }

    state gutter_loop(main: &mut Main) {
        transition main.i < 16 {
            true -> read_glyph(main)
            _ -> finish(main)
        }
    }

    state read_glyph(main: &mut Main) {
        main.b = main.data[main.i];
        main.bw = widen_u8_to_u32(main.b) as u32 in Wrapping;
        transition main.bw >= 32 && main.bw < 127 {
            true -> keep_glyph(main)
            _ -> dot_glyph(main)
        }
    }

    state keep_glyph(main: &mut Main) {
        Console::write_byte(main.b as i32);
        main.i = main.i + 1;
        transition {
            _ -> gutter_loop(main)
        }
    }

    state dot_glyph(main: &mut Main) {
        Console::write_byte(46);
        main.i = main.i + 1;
        transition {
            _ -> gutter_loop(main)
        }
    }

    state finish(main: &mut Main) {
        Console::write_line("");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
}
