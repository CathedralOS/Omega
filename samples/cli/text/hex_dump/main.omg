use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Hex dump -- renders a fixed 16-byte record as one canonical dump line:
// offset, sixteen lowercase hex pairs, then an ASCII gutter that maps every
// byte outside 32..126 to '.'. Bytes are streamed through Console::write_byte
// (a raw byte write into a Utf8 carrier cannot be proven valid UTF-8, so the
// sample assembles no text carrier). Exercises nibble extraction, a computed
// byte writer, and a printable-classification branch -- a text-shaping
// workload the corpus did not hold.
// Expected exit: 0.
// Expected output contains: 4f 6d 65 00

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 16]::Utf8
requires
    valid_utf8(self);

data Main {
    data: [u8; 16] in Utf8;
    // Counters are `in Wrapping`: increments are defined arithmetic; the index
    // uses stay bounded by the `i < 16` loop guards.
    i: i32 in Wrapping;
    b: u8;
    bw: u32 in Wrapping;
    hi: u32 in Wrapping;
    lo: u32 in Wrapping;
    chi: i32;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("hex_dump: 16 bytes as one canonical dump line (offset, hex pairs, gutter)");
    |console|::Console::write("0000: ");
    main.data = "Omega Psi tape!!";
    main.data[3] = 0;
    main.data[9] = 127;
    main.i = 0;
    transition {
        _ -> block hex_loop(main)
    }

    machine hex_loop(main: @mutable Main) {
        transition main.i < 16 {
            true -> block read_byte(main),
            _ -> block gutter_start(main)
        }
    }

    machine read_byte(main: @mutable Main) {
        main.b = main.data[main.i];
        main.bw = |numeric_conversion|::widen_u8_to_u32(main.b) as u32 +Wrapping;
        main.hi = main.bw / 16;
        main.lo = main.bw - (main.hi * 16);
        transition {
            _ -> block hi_digit(main)
        }
    }

    machine hi_digit(main: @mutable Main) {
        transition main.hi < 10 {
            true -> block hi_num(main),
            _ -> block hi_alpha(main)
        }
    }

    machine hi_num(main: @mutable Main) {
        main.chi = |numeric_conversion|::narrow_u32_to_i32_trapping((main.hi + 48) as u32);
        transition {
            _ -> block write_hi(main)
        }
    }

    machine hi_alpha(main: @mutable Main) {
        main.chi = |numeric_conversion|::narrow_u32_to_i32_trapping((main.hi + 87) as u32);
        transition {
            _ -> block write_hi(main)
        }
    }

    machine write_hi(main: @mutable Main) {
        |console|::Console::write_byte(main.chi);
        transition {
            _ -> block lo_digit(main)
        }
    }

    machine lo_digit(main: @mutable Main) {
        transition main.lo < 10 {
            true -> block lo_num(main),
            _ -> block lo_alpha(main)
        }
    }

    machine lo_num(main: @mutable Main) {
        main.chi = |numeric_conversion|::narrow_u32_to_i32_trapping((main.lo + 48) as u32);
        transition {
            _ -> block write_lo(main)
        }
    }

    machine lo_alpha(main: @mutable Main) {
        main.chi = |numeric_conversion|::narrow_u32_to_i32_trapping((main.lo + 87) as u32);
        transition {
            _ -> block write_lo(main)
        }
    }

    machine write_lo(main: @mutable Main) {
        |console|::Console::write_byte(main.chi);
        |console|::Console::write_byte(32);
        main.i = main.i + 1;
        transition {
            _ -> block hex_loop(main)
        }
    }

    machine gutter_start(main: @mutable Main) {
        |console|::Console::write(" ");
        main.i = 0;
        transition {
            _ -> block gutter_loop(main)
        }
    }

    machine gutter_loop(main: @mutable Main) {
        transition main.i < 16 {
            true -> block read_glyph(main),
            _ -> finish(main)
        }
    }

    machine read_glyph(main: @mutable Main) {
        main.b = main.data[main.i];
        main.bw = |numeric_conversion|::widen_u8_to_u32(main.b) as u32 +Wrapping;
        transition main.bw >= 32 && main.bw < 127 {
            true -> keep_glyph(main),
            _ -> dot_glyph(main)
        }
    }

    machine keep_glyph(main: @mutable Main) {
        |console|::Console::write_byte(main.b as i32);
        main.i = main.i + 1;
        transition {
            _ -> block gutter_loop(main)
        }
    }

    machine dot_glyph(main: @mutable Main) {
        |console|::Console::write_byte(46);
        main.i = main.i + 1;
        transition {
            _ -> block gutter_loop(main)
        }
    }

    machine finish(main: @mutable Main) {
        |console|::Console::write_line("");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
