use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "runtime_family_generic_callback_forwarding_exit" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Choosing, |app|::ArmChoice>(builder, linux_arm64);
    Build::select_provider::<|app|::DirectRouting, |app|::DirectCode>(builder, linux_arm64);
    Build::select_provider::<|app|::Choosing, |app|::X64Choice>(builder, linux_x86_64);
    Build::select_provider::<|app|::DirectRouting, |app|::DirectCode>(builder, linux_x86_64);
    Build::select_provider::<|app|::Choosing, |app|::DarwinChoice>(builder, macos_arm64);
    Build::select_provider::<|app|::DirectRouting, |app|::DirectCode>(builder, macos_arm64);
    Build::select_provider::<|app|::Choosing, |app|::WindowsChoice>(builder, windows_x86_64);
    Build::select_provider::<|app|::DirectRouting, |app|::DirectCode>(builder, windows_x86_64);
}
