machine build(builder: &mut Build) {
    Build::application(builder, "recorded_build_role_target_body");
    Build::depend(builder, Source::Path { location: "library" });
    Build::bind(builder, windows_x86_64::ProgramEntry, SelectedEntry::enter);
    Build::bind(builder, linux_x86_64::ProgramEntry, SelectedEntry::enter);
    Build::bind(builder, macos_arm64::ProgramEntry, SelectedEntry::enter);
    Build::bind(builder, linux_arm64::ProgramEntry, SelectedEntry::enter);
}
