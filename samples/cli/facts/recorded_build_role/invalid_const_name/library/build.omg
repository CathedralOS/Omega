// The constant selects which caller-backed name survives the Build.
const NAME_PREFIX: u8 = 119u8;
machine select_name<'storage>(prefix: u8, package: @'storage [u8], other: @'storage [u8]) -> @'storage [u8] {
    match prefix { 109u8 -> package, _ -> other }
}
machine build(plan: @mutable BuildPlan) {
    let name: @[u8] = select_name(NAME_PREFIX, "my_library", "wy_library");
    plan.product = BuildProduct::Package { name: name };
}
