use {omega}/build/storage.omg;

const PREFIX: u8 = 119u8;

machine build(plan: @mutable BuildPlan) {
    let mutable bytes: [u8; 10] = [0, 121, 95, 108, 105, 98, 114, 97, 114, 121];
    bytes[0] = PREFIX;
    let name: @[u8] = |storage|::copy(plan, @bytes[..]);
    plan.product = BuildProduct::Package { name: name };
}
