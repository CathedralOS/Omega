// Fact: 16-bit unsigned bitwise OR base | 32u16 with bounded interval 40u16 <= combined <= 63u16 establishes 40u16 <= combined <= 63u16 across all nine places so exact subtractions 63u16 - combined and combined - 40u16 are safe.
// Expected exit: 1

machine verify_combined(value: u16) -> u16
requires value >= 40u16 && value <= 63u16
{
    let headroom: u16 = 63u16 - value;
    let margin: u16 = value - 40u16;
    transition headroom == 11u16 && margin == 12u16 {
        true -> 0u16
        _ -> 1u16
    }
}

linux_x86_64 machine exercise(base: u16) -> u16 crashes Trap {
    let combined: u16 = base | 32u16;
    transition combined >= 40u16 && combined <= 64u16 {
        true -> step(combined)
        _ -> bad()
    }
    machine step(c: u16) -> u16 {
        verify_combined(c)
    }
    machine bad() -> u16 { crash Trap; }
}

linux_arm64 machine exercise(base: u16) -> u16 crashes Trap {
    let combined: u16 = base | 32u16;
    transition combined >= 40u16 && combined <= 64u16 {
        true -> step(combined)
        _ -> bad()
