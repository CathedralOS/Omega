// Fact: 16-bit unsigned bitwise OR base | 32u16 with bounded interval 40u16 <= combined <= 63u16 establishes 40u16 <= combined <= 63u16 across all nine places so exact subtractions 63u16 - combined and combined - 40u16 are safe.
// Expected exit: 1

machine verify_combined(value: u16) -> u16
requires value >= 40u16 && value <= 63u16
{
    let headroom: u16 = 63u16 - value;
    let margin: u16 = value - 40u16;
    transition headroom == 11u16 && margin == 12u16 {
        true -> 0u16
        _ -> 1u16
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(base: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(base: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let combined: u16 = base | 32u16;
        transition combined >= 40u16 && combined <= 64u16 {
            true -> step(combined)
            _ -> bad()
        }
        machine step(c: u16) -> u16 {
            verify_combined(c)
        }
        machine bad() -> u16 { crash Trap; }
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(base: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let combined: u16 = base | 32u16;
        transition combined >= 40u16 && combined <= 64u16 {
            true -> step(combined)
            _ -> bad()
        }
        machine step(c: u16) -> u16 {
            verify_combined(c)
        }
        machine bad() -> u16 { crash Trap; }
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let rc: u16 = SelectedProbe::exercise(20u16);
    transition rc == 0u16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
