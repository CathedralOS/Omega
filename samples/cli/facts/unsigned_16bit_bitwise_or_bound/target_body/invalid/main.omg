windows_x86_64 machine exercise(base: u16) -> u16 crashes Trap {
    let combined: u16 = base | 32u16;
    transition combined >= 40u16 && combined <= 64u16 {
        true -> step(combined)
        _ -> bad()
    }
    machine step(c: u16) -> u16 {
        verify_combined(c)
    }
    machine bad() -> u16 { crash Trap; }
}

machine main() crashes Trap {
    let rc: u16 = exercise(20u16);
    transition rc == 0u16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
