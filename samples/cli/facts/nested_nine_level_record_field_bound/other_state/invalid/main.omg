// Fact: a 9-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { l5: Level5 { l6: Level6 { l7: Level7 { l8: Level8 { val: u64 } } } } } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.l5.l6.l7.l8.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: another state. A successor state receives the 9-level nested record before leaf projection and interval discharge.
// Expected exit: 0

data Level8 [copy] {
    val: u64;
}

data Level7 [copy] {
    l8: Level8;
}

data Level6 [copy] {
    l7: Level7;
}

data Level5 [copy] {
    l6: Level6;
}

data Level4 [copy] {
    l5: Level5;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

machine check_state(root: RootRec) -> u64
requires root.l1.l2.l3.l4.l5.l6.l7.l8.val >= 40 && root.l1.l2.l3.l4.l5.l6.l7.l8.val <= 81
{
    transition {
        _ -> step(root)
    }
    machine step(r: RootRec) -> u64
    requires r.l1.l2.l3.l4.l5.l6.l7.l8.val >= 40 && r.l1.l2.l3.l4.l5.l6.l7.l8.val <= 81
    {
        let res: u64 = r.l1.l2.l3.l4.l5.l6.l7.l8.val;
        let headroom: u64 = 80u64 - res;
        let margin: u64 = res - 40u64;
        headroom + margin
    }
}

machine probe() -> u64 {
    let root: RootRec = RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        l5: Level5 {
                            l6: Level6 {
                                l7: Level7 {
                                    l8: Level8 {
                                        val: 60u64,
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    };
    check_state(root)
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
