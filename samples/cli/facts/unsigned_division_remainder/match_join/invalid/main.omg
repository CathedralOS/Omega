// Fact: an unsigned u64 remainder from 500u64 % 200u64 equals 100u64 when subtracting 100u64.
// Invalid: remainder is 99, so subtracting 100u64 underflows. Place: match_join.
// Expected diagnostic: may overflow `u64`

machine remainder(dividend: u64, divisor: u64) -> u64
requires dividend >= 499 && dividend <= 499 && divisor >= 200 && divisor <= 200
ensures result >= 99 && result <= 99
{
    dividend % divisor
}

machine choose_remainder(flag: bool) -> u64
ensures result >= 99 && result <= 99
{
    match flag {
        true -> remainder(499u64, 200u64),
        false -> remainder(499u64, 200u64),
    }
}

machine probe() -> i32 {
    let rem: u64 = choose_remainder(true);
    let diff: u64 = rem - 100u64;
    diff as i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
