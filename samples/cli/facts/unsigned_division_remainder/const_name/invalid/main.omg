// Fact: an unsigned u64 remainder from 500u64 % 200u64 equals 100u64 when subtracting 100u64.
// Invalid: remainder is 99, so subtracting 100u64 underflows. Place: const_name.
// Expected diagnostic: may overflow `u64`

const REMAINDER: u64 = 499u64 % 200u64;

machine probe() -> i32 {
    let remainder: u64 = REMAINDER;
    let diff: u64 = remainder - 100u64;
    diff as i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
