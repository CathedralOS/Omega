// Fact: an unsigned u64 remainder from 500u64 % 200u64 equals 100u64 when subtracting 100u64.
// Invalid: remainder is 99, so subtracting 100u64 underflows. Place: field.
// Expected diagnostic: may overflow `u64`

machine remainder(dividend: u64, divisor: u64) -> u64
requires dividend >= 499 && dividend <= 499 && divisor >= 200 && divisor <= 200
ensures result >= 99 && result <= 99
{
    dividend % divisor
}

data RemResult where remainder >= 99 && remainder <= 99 {
    remainder: u64;
}

machine verify_field(payload: RemResult) -> i32 {
    let diff: u64 = payload.remainder - 100u64;
    diff as i32
}

machine probe() -> i32 {
    let r: u64 = remainder(499u64, 200u64);
    let payload: RemResult = RemResult { remainder: r };
    verify_field(payload)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
