// Fact: an unsigned u64 remainder from 500u64 % 200u64 equals 100u64 when subtracting 100u64.
// Place: other_machine. A forwarding machine forwards the remainder to the verifying machine.
// Expected exit: 0

machine remainder(dividend: u64, divisor: u64) -> u64
requires dividend >= 500 && dividend <= 500 && divisor >= 200 && divisor <= 200
ensures result >= 100 && result <= 100
{
    dividend % divisor
}

machine verify_target(rem: u64) -> i32
requires rem >= 100 && rem <= 100
{
    let diff: u64 = rem - 100u64;
    diff as i32
}

machine forward(rem: u64) -> i32
requires rem >= 100 && rem <= 100
{
    verify_target(rem)
}

machine probe() -> i32 {
    let r: u64 = remainder(500u64, 200u64);
    forward(r)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
