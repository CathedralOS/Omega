// Fact: 64-bit unsigned bitwise AND mask raw & 63u64 with bounded interval 40u64 <= masked <= 63u64 establishes 40u64 <= masked <= 63u64 across all nine places so exact subtractions 63u64 - masked and masked - 40u64 are safe.
// Expected exit: 0

machine verify_masked(value: u64) -> u64
requires value >= 40u64 && value <= 63u64
{
    let headroom: u64 = 63u64 - value;
    let margin: u64 = value - 40u64;
    transition headroom == 11u64 && margin == 12u64 {
        true -> 0u64
        _ -> 1u64
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(raw: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(raw: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let masked: u64 = raw & 63u64;
        transition masked >= 40u64 && masked <= 63u64 {
            true -> step(masked)
            _ -> bad()
        }
        machine step(m: u64) -> u64 {
            verify_masked(m)
        }
        machine bad() -> u64 { crash Trap; }
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(raw: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let masked: u64 = raw & 63u64;
        transition masked >= 40u64 && masked <= 63u64 {
            true -> step(masked)
            _ -> bad()
        }
        machine step(m: u64) -> u64 {
            verify_masked(m)
        }
        machine bad() -> u64 { crash Trap; }
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let rc: u64 = SelectedProbe::exercise(116u64);
    transition rc == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
