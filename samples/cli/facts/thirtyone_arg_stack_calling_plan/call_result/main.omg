// Fact: a machine transition call passing thirty-one u64 arguments across register and stack ABI slots preserves the thirty-first stack-passed argument's static bound 40u64 <= a31 && a31 <= 80u64 across all nine places so a31 - 40u64 and 80u64 - a31 are proved safe without underflow.
// Place: call result. Each argument is returned from a dedicated helper call.
// Expected exit: 0

machine get1() -> u64 ensures result == 1u64 { 1u64 }
machine get2() -> u64 ensures result == 2u64 { 2u64 }
machine get3() -> u64 ensures result == 3u64 { 3u64 }
machine get4() -> u64 ensures result == 4u64 { 4u64 }
machine get5() -> u64 ensures result == 5u64 { 5u64 }
machine get6() -> u64 ensures result == 6u64 { 6u64 }
machine get7() -> u64 ensures result == 7u64 { 7u64 }
machine get8() -> u64 ensures result == 8u64 { 8u64 }
machine get9() -> u64 ensures result == 9u64 { 9u64 }
machine get10() -> u64 ensures result == 10u64 { 10u64 }
machine get11() -> u64 ensures result == 11u64 { 11u64 }
machine get12() -> u64 ensures result == 12u64 { 12u64 }
machine get13() -> u64 ensures result == 13u64 { 13u64 }
machine get14() -> u64 ensures result == 14u64 { 14u64 }
machine get15() -> u64 ensures result == 15u64 { 15u64 }
machine get16() -> u64 ensures result == 16u64 { 16u64 }
machine get17() -> u64 ensures result == 17u64 { 17u64 }
machine get18() -> u64 ensures result == 18u64 { 18u64 }
machine get19() -> u64 ensures result == 19u64 { 19u64 }
machine get20() -> u64 ensures result == 20u64 { 20u64 }
machine get21() -> u64 ensures result == 21u64 { 21u64 }
machine get22() -> u64 ensures result == 22u64 { 22u64 }
machine get23() -> u64 ensures result == 23u64 { 23u64 }
machine get24() -> u64 ensures result == 24u64 { 24u64 }
machine get25() -> u64 ensures result == 25u64 { 25u64 }
machine get26() -> u64 ensures result == 26u64 { 26u64 }
machine get27() -> u64 ensures result == 27u64 { 27u64 }
machine get28() -> u64 ensures result == 28u64 { 28u64 }
machine get29() -> u64 ensures result == 29u64 { 29u64 }
machine get30() -> u64 ensures result == 30u64 { 30u64 }
machine get31() -> u64 ensures result == 60u64 { 60u64 }

machine pick31(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64,
    a11: u64,
    a12: u64,
    a13: u64,
    a14: u64,
    a15: u64,
    a16: u64,
    a17: u64,
    a18: u64,
    a19: u64,
    a20: u64,
    a21: u64,
    a22: u64,
    a23: u64,
    a24: u64,
    a25: u64,
    a26: u64,
    a27: u64,
    a28: u64,
    a29: u64,
    a30: u64,
    a31: u64
) -> u64
requires
    a1 == 1u64 &&
    a2 == 2u64 &&
    a3 == 3u64 &&
    a4 == 4u64 &&
    a5 == 5u64 &&
    a6 == 6u64 &&
    a7 == 7u64 &&
    a8 == 8u64 &&
    a9 == 9u64 &&
    a10 == 10u64 &&
    a11 == 11u64 &&
    a12 == 12u64 &&
    a13 == 13u64 &&
    a14 == 14u64 &&
    a15 == 15u64 &&
    a16 == 16u64 &&
    a17 == 17u64 &&
    a18 == 18u64 &&
    a19 == 19u64 &&
    a20 == 20u64 &&
    a21 == 21u64 &&
    a22 == 22u64 &&
    a23 == 23u64 &&
    a24 == 24u64 &&
    a25 == 25u64 &&
    a26 == 26u64 &&
    a27 == 27u64 &&
    a28 == 28u64 &&
    a29 == 29u64 &&
    a30 == 30u64 &&
    a31 >= 40u64 && a31 <= 80u64
ensures
    result >= 40u64 && result <= 80u64 && result == a31
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23 + a24 + a25 + a26 + a27 + a28 + a29 + a30;
    (prefix - 465u64) + a31
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    let res: u64 = pick31(get1(), get2(), get3(), get4(), get5(), get6(), get7(), get8(), get9(), get10(), get11(), get12(), get13(), get14(), get15(), get16(), get17(), get18(), get19(), get20(), get21(), get22(), get23(), get24(), get25(), get26(), get27(), get28(), get29(), get30(), get31());
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    let diff: u64 = (headroom + margin) - 40u64;
    transition diff == 0u64 && headroom == 20u64 && margin == 20u64 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

machine main() crashes Trap {
    transition probe() == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
