// Fact: the validated byte size and alignment of a padded structural record and fixed array combine to 100u64 when subtracting 100u64.
// Expected exit: 0

data PaddedFrame {
    tag: u8;
    word: u64;
    tail: [u64; 9];
}

data GeometryCarrier {
    geometry: u64;
}

machine main() crashes Trap {
    let s: u64 = size_of<PaddedFrame>();
    let a: u64 = align_of<PaddedFrame>();
    let extra: u64 = align_of<u32>();
    let carrier: GeometryCarrier = GeometryCarrier { geometry: s + a + extra };
    let diff: u64 = carrier.geometry - 100u64;
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
