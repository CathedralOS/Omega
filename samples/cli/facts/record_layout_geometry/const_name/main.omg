// Fact: the validated byte size and alignment of a padded structural record and fixed array combine to 100u64 when subtracting 100u64.
// Expected exit: 0

data PaddedFrame {
    tag: u8;
    word: u64;
    tail: [u64; 9];
}

const FRAME_BYTES: u64 = size_of<PaddedFrame>();
const FRAME_ALIGN: u64 = align_of<PaddedFrame>();
const EXTRA_ALIGN: u64 = align_of<u32>();

machine main() crashes Trap {
    let geometry: u64 = FRAME_BYTES + FRAME_ALIGN + EXTRA_ALIGN;
    let diff: u64 = geometry - 100u64;
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
