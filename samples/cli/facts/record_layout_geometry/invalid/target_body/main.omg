// Fact: the validated byte size and alignment of a padded structural record and fixed array combine to 100u64 when subtracting 100u64.
// Invalid: the fixed array in PaddedFrame has 8 elements instead of 9, breaking the 100u64 bound.
// Expected diagnostic: exact subtraction underflow

data PaddedFrame {
    tag: u8;
    word: u64;
    tail: [u64; 8];
}

linux_x86_64 machine compute_geometry() -> u64 {
    let s: u64 = size_of<PaddedFrame>();
    let a: u64 = align_of<PaddedFrame>();
    let extra: u64 = align_of<u32>();
    (s + a + extra) - 100u64
}

linux_arm64 machine compute_geometry() -> u64 {
    let s: u64 = size_of<PaddedFrame>();
    let a: u64 = align_of<PaddedFrame>();
    let extra: u64 = align_of<u32>();
    (s + a + extra) - 100u64
}

macos_arm64 machine compute_geometry() -> u64 {
    let s: u64 = size_of<PaddedFrame>();
    let a: u64 = align_of<PaddedFrame>();
    let extra: u64 = align_of<u32>();
    (s + a + extra) - 100u64
}

windows_x86_64 machine compute_geometry() -> u64 {
    let s: u64 = size_of<PaddedFrame>();
    let a: u64 = align_of<PaddedFrame>();
    let extra: u64 = align_of<u32>();
    (s + a + extra) - 100u64
}

machine probe() -> u64 {
    compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
