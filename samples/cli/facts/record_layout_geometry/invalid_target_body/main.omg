// Fact: the validated byte size and alignment of a padded structural record and fixed array combine to 100u64 when subtracting 100u64.
// Invalid: the fixed array in PaddedFrame has 8 elements instead of 9, breaking the 100u64 bound.
// Expected diagnostic: exact subtraction underflow

data PaddedFrame {
    tag: u8;
    word: u64;
    tail: [u64; 8];
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedComputeGeometry {
    machine compute_geometry() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86ComputeGeometry satisfies SelectedComputeGeometry {
    machine compute_geometry() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let s: u64 = size_of<PaddedFrame>();
        let a: u64 = align_of<PaddedFrame>();
        let extra: u64 = align_of<u32>();
        (s + a + extra) - 100u64
    }
}

ArmComputeGeometry satisfies SelectedComputeGeometry {
    machine compute_geometry() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let s: u64 = size_of<PaddedFrame>();
        let a: u64 = align_of<PaddedFrame>();
        let extra: u64 = align_of<u32>();
        (s + a + extra) - 100u64
    }
}

machine probe() -> u64 {
    SelectedComputeGeometry::compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
