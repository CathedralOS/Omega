// Fact: 16-bit unsigned bitwise AND mask raw & 63u16 with bounded interval 40u16 <= masked <= 63u16 establishes 40u16 <= masked <= 63u16 across all nine places so exact subtractions 63u16 - masked and masked - 40u16 are safe.
// Invalid: mask 127 allows res 116 joined across match arms, causing 63u16 - res to underflow. Place: match_join.
// Expected diagnostic: may overflow `u16`

machine choose_mask(flag: bool, raw: u16) -> u16
requires raw == 116u16
{
    let masked: u16 = raw & 127u16;
    match flag {
        true -> masked,
        false -> masked,
    }
}

machine compute_join(raw: u16) -> i32
requires raw == 116u16
{
    let res: u16 = choose_mask(true, raw);
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

machine probe() -> i32 {
    compute_join(116u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
