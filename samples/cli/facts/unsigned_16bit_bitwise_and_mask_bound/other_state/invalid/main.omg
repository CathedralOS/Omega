// Fact: 16-bit unsigned bitwise AND mask raw & 63u16 with bounded interval 40u16 <= masked <= 63u16 establishes 40u16 <= masked <= 63u16 across all nine places so exact subtractions 63u16 - masked and masked - 40u16 are safe.
// Invalid: mask 127 produces masked 116 sent to step, causing 63u16 - masked to underflow. Place: other_state.
// Expected diagnostic: may overflow `u16`

machine verify_state(raw: u16) -> i32
requires raw == 116u16
{
    let res: u16 = raw & 127u16;
    transition {
        _ -> step(res)
    }
    machine step(masked: u16) -> i32
    requires masked >= 40u16 && masked <= 127u16
    {
        let headroom: u16 = 63u16 - masked;
        let margin: u16 = masked - 40u16;
        0i32
    }
}

machine probe() -> i32 {
    verify_state(116u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
