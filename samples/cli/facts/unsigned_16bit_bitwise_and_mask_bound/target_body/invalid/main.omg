// Fact: 16-bit unsigned bitwise AND mask raw & 63u16 with bounded interval 40u16 <= masked <= 63u16 establishes 40u16 <= masked <= 63u16 across all nine places so exact subtractions 63u16 - masked and masked - 40u16 are safe.
// Invalid: target bodies compute with mask 127u16, causing 63u16 - res to underflow. Place: target_body.
// Expected diagnostic: may overflow `u16`

linux_x86_64 machine verify_target() -> i32 {
    let raw: u16 = 116u16;
    let res: u16 = raw & 127u16;
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

linux_arm64 machine verify_target() -> i32 {
    let raw: u16 = 116u16;
    let res: u16 = raw & 127u16;
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

macos_arm64 machine verify_target() -> i32 {
    let raw: u16 = 116u16;
    let res: u16 = raw & 127u16;
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

windows_x86_64 machine verify_target() -> i32 {
    let raw: u16 = 116u16;
    let res: u16 = raw & 127u16;
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
