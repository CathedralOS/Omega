// Fact: 16-bit unsigned bitwise AND mask raw & 63u16 with bounded interval 40u16 <= masked <= 63u16 establishes 40u16 <= masked <= 63u16 across all nine places so exact subtractions 63u16 - masked and masked - 40u16 are safe.
// Invalid: call result produces res 116 from mask 127, causing 63u16 - res to underflow. Place: call_result.
// Expected diagnostic: may overflow `u16`

machine mask_op(raw: u16) -> u16
requires raw == 116u16
{
    raw & 127u16
}

machine compute_call(raw: u16) -> i32
requires raw == 116u16
{
    let res: u16 = mask_op(raw);
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

machine probe() -> i32 {
    compute_call(116u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
