// Fact: 16-bit unsigned bitwise AND mask raw & 63u16 with bounded interval 40u16 <= masked <= 63u16 establishes 40u16 <= masked <= 63u16 across all nine places so exact subtractions 63u16 - masked and masked - 40u16 are safe.
// Place: other_machine. A forwarding machine sends the masked result to the verifying machine to discharge bounds.
// Expected exit: 0

machine forward(masked: u16) -> i32
requires masked >= 40u16 && masked <= 63u16
{
    let headroom: u16 = 63u16 - masked;
    let margin: u16 = masked - 40u16;
    0i32
}

machine compute_forward(raw: u16) -> i32
requires raw == 116u16
{
    let res: u16 = raw & 63u16;
    forward(res)
}

machine probe() -> i32 {
    compute_forward(116u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
