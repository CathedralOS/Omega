// A match join keeps Alive when every arm copies an Alive player.
// The joined alias carries that fact into inspect's requires.
// Compile-checked only: no ProcessExit provider.

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
    spare: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::choose(main: &Main, flag: bool)
requires
    main.player in Player::Alive,
    main.spare in Player::Alive
{
    let mut copy: Player = match flag {
        true -> main.player,
        false -> main.spare,
    };
    Main::inspect(copy);
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive,
    main.spare in Player::Alive
{
    Main::choose(main, true);
}
