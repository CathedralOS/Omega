// A match join keeps Alive when every arm copies an Alive player.
// The joined alias carries that fact into inspect's requires.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
    spare: Player;
    observed: i32;
}

machine inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine choose(main: @Main, flag: bool) -> i32
requires
    main.player in Player::Alive,
    main.spare in Player::Alive
{
    let mutable copy: Player = match flag {
        true -> main.player,
        false -> main.spare,
    };
    inspect(copy)
}

machine observe_player(main: @mutable Main)
requires
    main.player in Player::Alive,
    main.spare in Player::Alive
{
    main.observed = choose(main, true);
}

machine entry() crashes Trap {
    let mutable a: Main = Main { player: Player { health: 42 }, spare: Player { health: 99 }, observed: 0 };
    observe_player(@mutable a);
    let mutable b: Main = Main { player: Player { health: 1 }, spare: Player { health: 99 }, observed: 0 };
    observe_player(@mutable b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
