// A const player that is not Alive does not satisfy inspect through an alias.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

const HERO: Player = Player { health: 0 };

data Main {
    player: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::main(main: @mutable Main) {
    let mutable copy: Player = HERO;
    Main::inspect(copy);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
