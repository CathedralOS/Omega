// A bare parameter does not invent Alive for inspect.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
}

machine inspect(player: Player)
requires
    player in Player::Alive
{
}

machine carry(player: Player) {
    inspect(player);
}

machine observe_player(main: @mutable Main)
requires
    main.player in Player::Alive
{
    let mutable copy: Player = main.player;
    carry(copy);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
{
    let mutable entry_storage: Main = Main { player: Player { health: 1 } };
    observe_player(@mutable entry_storage);
    carry(Player { health: 0 });
}
