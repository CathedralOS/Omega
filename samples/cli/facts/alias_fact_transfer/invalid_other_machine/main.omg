// Another machine's Alive requires stays unproved when the result has no fact.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
}

machine inspect(player: Player)
requires
    player in Player::Alive
{
}

machine produce(player: Player) -> Player {
    player
}

machine consume(player: Player)
requires
    player in Player::Alive
{
    inspect(player);
}

machine observe_player(main: @mutable Main)
requires
    main.player in Player::Alive
{
    consume(produce(main.player));
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
{
    let mutable entry_storage: Main = Main { player: Player { health: 1 } };
    observe_player(@mutable entry_storage);
}
