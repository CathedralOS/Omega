// A local alias of a player with no Alive fact does not satisfy inspect.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
}

machine inspect(player: Player)
requires
    player in Player::Alive
{
}

machine observe_player(main: @mutable Main) {
    let mutable copy: Player = main.player;
    inspect(copy);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main = Main { player: Player { health: 0 } };
    observe_player(@mutable entry_storage);
}
