// Alive copied into a field still reaches inspect through that field.
// Compile-checked only: no ProcessExit provider.

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Roster {
    member: Player;
}

data Main {
    player: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let roster: Roster = Roster { member: main.player };
    Main::inspect(roster.member);
}
