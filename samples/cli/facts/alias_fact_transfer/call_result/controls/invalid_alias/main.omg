// A call result with no Alive guarantee does not satisfy inspect.

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::duplicate(player: Player) -> Player {
    player
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let mut copy: Player = Main::duplicate(main.player);
    Main::inspect(copy);
}
