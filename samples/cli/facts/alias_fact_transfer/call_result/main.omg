// A call that returns an Alive player transfers that fact onto a bare
// local, and the local alias carries it into inspect's requires.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
    observed: i32;
}

machine Main::inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine Main::duplicate(player: Player) -> Player
requires
    player in Player::Alive
ensures
    result in Player::Alive
{
    player
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let mut copy: Player = Main::duplicate(main.player);
    main.observed = Main::inspect(copy);
}

machine entry() crashes Trap {
    let mut a: Main = Main { player: Player { health: 42 }, observed: 0 };
    Main::main(&mut a);
    let mut b: Main = Main { player: Player { health: 1 }, observed: 0 };
    Main::main(&mut b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
