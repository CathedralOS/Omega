// A target body cannot pass a bare parameter to inspect without Alive.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedInspectTarget {
    machine inspect_target(player: Player) reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86InspectTarget satisfies SelectedInspectTarget {
    machine inspect_target(player: Player) reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        Main::inspect(player);
    }
}
ArmInspectTarget satisfies SelectedInspectTarget {
    machine inspect_target(player: Player) reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        Main::inspect(player);
    }
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let mut copy: Player = main.player;
    SelectedInspectTarget::inspect_target(copy);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    entry_start();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    entry_start();
}
