// Another state receives the Alive alias and uses that fact in its requires.
// The state declares the fact on its parameter: a state's requires clause
// only restates declared qualifications, so `player: Player in Player::Alive`
// is the arrival contract.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
    observed: i32;
}

machine Main::inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine Main::main(main: @mutable Main)
requires
    main.player in Player::Alive
{
    let mutable copy: Player = main.player;
    transition { _ -> arrived(main, copy) }
    machine arrived(main: @mutable Main, player: Player in Player::Alive) {
        main.observed = Main::inspect(player);
    }
}

machine entry() crashes Trap {
    let mutable a: Main = Main { player: Player { health: 42 }, observed: 0 };
    Main::main(@mutable a);
    let mutable b: Main = Main { player: Player { health: 1 }, observed: 0 };
    Main::main(@mutable b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
