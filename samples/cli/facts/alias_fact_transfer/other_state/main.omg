// Another state receives the Alive alias and uses that fact in its requires.
// The state declares the fact on its parameter: a state's requires clause
// only restates declared qualifications, so `player: Player in Player::Alive`
// is the arrival contract.
// Compile-checked only: no ProcessExit provider.

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let mut copy: Player = main.player;
    transition { _ -> arrived(copy) }
    state arrived(player: Player in Player::Alive) {
        Main::inspect(player);
    }
}
