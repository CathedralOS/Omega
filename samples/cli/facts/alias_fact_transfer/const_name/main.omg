// A const name of an Alive player transfers through a bare alias
// into inspect's requires.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

const HERO: Player in Player::Alive = Player { health: 3 };

data Main {
    player: Player;
    observed: i32;
}

machine Main::inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine Main::main(main: &mut Main) {
    let mut copy: Player = HERO;
    main.observed = Main::inspect(copy);
}

machine entry() crashes Trap {
    let mut a: Main = Main { player: Player { health: 42 }, observed: 0 };
    Main::main(&mut a);
    let mut b: Main = Main { player: Player { health: 1 }, observed: 0 };
    Main::main(&mut b);
    transition a.observed == 3 && b.observed == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
