// Another state's declared Alive qualification stays unproved when the
// arrival has no fact.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
}

machine inspect(player: Player)
requires
    player in Player::Alive
{
}

machine observe_player(main: @mutable Main) {
    let mutable copy: Player = main.player;
    transition { _ -> arrived(copy as +Player::Alive) }
    machine arrived(player: Player in Player::Alive)
    {
        inspect(player as -Player::Alive);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main = Main { player: Player { health: 0 } };
    observe_player(@mutable entry_storage);
}
