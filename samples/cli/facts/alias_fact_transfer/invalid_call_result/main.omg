// A call result with no Alive guarantee does not satisfy inspect.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
}

machine inspect(player: Player)
requires
    player in Player::Alive
{
}

machine duplicate(player: Player) -> Player {
    player
}

machine observe_player(main: @mutable Main)
requires
    main.player in Player::Alive
{
    let mutable copy: Player = duplicate(main.player);
    inspect(copy);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
{
    let mutable entry_storage: Main = Main { player: Player { health: 1 } };
    observe_player(@mutable entry_storage);
}
