machine build(builder: &mut Build) {
    Build::application(builder, "alias_fact_transfer_target_body_invalid");
    Build::bind(builder, macos_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider<SelectedInspectTarget, X86InspectTarget>(builder, macos_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedInspectTarget, ArmInspectTarget>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedInspectTarget, X86InspectTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedInspectTarget, ArmInspectTarget>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedInspectTarget, X86InspectTarget>(builder, windows_x86_64);
}
