// Every target body receives the Alive alias and passes it to inspect.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
    observed: i32;
}

machine Main::inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedInspectTarget {
    machine inspect_target(player: Player) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires
        player in Player::Alive;
}
X86InspectTarget satisfies SelectedInspectTarget {
    machine inspect_target(player: Player) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires
        player in Player::Alive
    {
        SelectedBodyCheck::require_tag(17u64);
        Main::inspect(player)
    }
}
ArmInspectTarget satisfies SelectedInspectTarget {
    machine inspect_target(player: Player) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires
        player in Player::Alive
    {
        SelectedBodyCheck::require_tag(29u64);
        Main::inspect(player)
    }
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let mut copy: Player = main.player;
    main.observed = SelectedInspectTarget::inspect_target(copy);
}

machine entry() crashes Trap {
    let mut a: Main = Main { player: Player { health: 42 }, observed: 0 };
    Main::main(&mut a);
    let mut b: Main = Main { player: Player { health: 1 }, observed: 0 };
    Main::main(&mut b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    entry();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    entry();
}
