// One machine returns the Alive alias and another machine requires it.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
    observed: i32;
}

machine Main::inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine produce(player: Player) -> Player
requires
    player in Player::Alive
ensures
    result in Player::Alive
{
    player
}

machine consume(player: Player) -> i32
requires
    player in Player::Alive
{
    Main::inspect(player)
}

machine Main::main(main: @mutable Main)
requires
    main.player in Player::Alive
{
    main.observed = consume(produce(main.player));
}

machine entry() crashes Trap {
    let mutable a: Main = Main { player: Player { health: 42 }, observed: 0 };
    Main::main(@mutable a);
    let mutable b: Main = Main { player: Player { health: 1 }, observed: 0 };
    Main::main(@mutable b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
