// An entry requires on main.player transfers through a local alias.
// `let mutable copy: Player` carries Alive into inspect's requires.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
    observed: i32;
}

machine inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine observe_player(main: @mutable Main)
requires
    main.player in Player::Alive
{
    let mutable copy: Player = main.player;
    main.observed = inspect(copy);
}

machine entry() crashes Trap {
    let mutable a: Main = Main { player: Player { health: 42 }, observed: 0 };
    observe_player(@mutable a);
    let mutable b: Main = Main { player: Player { health: 1 }, observed: 0 };
    observe_player(@mutable b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
