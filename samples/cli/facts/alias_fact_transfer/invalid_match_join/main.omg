// A match join drops Alive when one arm is not Alive.

data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
    other: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::choose(main: @Main, flag: bool)
requires
    main.player in Player::Alive
{
    let mutable copy: Player = match flag {
        true -> main.player,
        false -> main.other,
    };
    Main::inspect(copy);
}

machine Main::main(main: @mutable Main)
requires
    main.player in Player::Alive
{
    Main::choose(main, true);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
{
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
