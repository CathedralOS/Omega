// Alive on a copied player transfers into a bare parameter, and that
// parameter carries the fact into inspect's requires.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
    observed: i32;
}

machine Main::inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine Main::carry(player: Player) -> i32
requires
    player in Player::Alive
{
    Main::inspect(player)
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let mut copy: Player = main.player;
    main.observed = Main::carry(copy);
}

machine entry() crashes Trap {
    let mut a: Main = Main { player: Player { health: 42 }, observed: 0 };
    Main::main(&mut a);
    let mut b: Main = Main { player: Player { health: 1 }, observed: 0 };
    Main::main(&mut b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
