// Fact: 64-bit signed saturating subtraction lhs -| rhs with bounded interval 40i64 <= diff <= 100i64 establishes 40i64 <= diff <= 100i64 across all nine places so exact subtractions 100i64 - diff and diff - 40i64 are safe.
// Place: call result. The difference is received from a helper call returning the saturating subtraction result.
// Invalid control: lhs upper bound widened to 125i64, allowing diff up to 105i64 and failing exact headroom check.
// Expected rejection: not provably representable

machine compute_sat_diff(l: i64, r: i64) -> i64
    requires l >= 80i64 && l <= 125i64;
    requires r >= 20i64 && r <= 40i64;
    ensures result >= 40i64 && result <= 105i64;
{
    let a: i64 in Saturating = l as i64 in Saturating;
    let b: i64 in Saturating = r as i64 in Saturating;
    let d_sat: i64 in Saturating = a - b;
    d_sat as i64
}

machine subtract_call_result(lhs: i64, rhs: i64) -> i32
    requires lhs >= 80i64 && lhs <= 125i64;
    requires rhs >= 20i64 && rhs <= 40i64;
{
    let diff: i64 = compute_sat_diff(lhs, rhs);
    let headroom: i64 = 100i64 - diff;
    let margin: i64 = diff - 40i64;
    let check_h: u64 = headroom as u64;
    let check_m: u64 = margin as u64;
    transition diff == 70i64 && headroom + margin == 60i64 && check_h + check_m == 60u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = subtract_call_result(100i64, 30i64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
