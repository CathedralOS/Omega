// Fact: 64-bit signed saturating subtraction lhs -| rhs with bounded interval 40i64 <= diff <= 100i64 establishes 40i64 <= diff <= 100i64 across all nine places so exact subtractions 100i64 - diff and diff - 40i64 are safe.
// Place: const name. The bounds and difference limits reference declared symbolic constants.
// Expected exit: 0

const LHS_MIN: i64 = 80i64;
const LHS_MAX: i64 = 120i64;
const RHS_MIN: i64 = 20i64;
const RHS_MAX: i64 = 40i64;
const DIFF_MIN: i64 = 40i64;
const DIFF_MAX: i64 = 100i64;

machine subtract_const(lhs: i64, rhs: i64) -> i32
    requires lhs >= LHS_MIN && lhs <= LHS_MAX;
    requires rhs >= RHS_MIN && rhs <= RHS_MAX;
{
    let a: i64 in Saturating = lhs as i64 in Saturating;
    let b: i64 in Saturating = rhs as i64 in Saturating;
    let d_sat: i64 in Saturating = a - b;
    let diff: i64 = d_sat as i64;
    let headroom: i64 = DIFF_MAX - diff;
    let margin: i64 = diff - DIFF_MIN;
    let check_h: u64 = headroom as u64;
    let check_m: u64 = margin as u64;
    transition diff == 70i64 && headroom + margin == 60i64 && check_h + check_m == 60u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = subtract_const(100i64, 30i64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
