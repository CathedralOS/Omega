// Fact: 64-bit signed saturating subtraction lhs -| rhs with bounded interval 40i64 <= diff <= 100i64 establishes 40i64 <= diff <= 100i64 across all nine places so exact subtractions 100i64 - diff and diff - 40i64 are safe.
// Place: another target body. Target-scoped implementations across all four platforms verify the bounds.
// Invalid control: lhs upper bound widened to 125i64, allowing diff up to 105i64 and failing exact headroom check.
// Expected rejection: not provably representable

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSubtractTarget {
    machine subtract_target(lhs: i64, rhs: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 80i64 && lhs <= 125i64 requires rhs >= 20i64 && rhs <= 40i64;
}

X86SubtractTarget satisfies SelectedSubtractTarget {
    machine subtract_target(lhs: i64, rhs: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 80i64 && lhs <= 125i64 requires rhs >= 20i64 && rhs <= 40i64
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: i64 in Saturating = lhs as i64 in Saturating;
        let b: i64 in Saturating = rhs as i64 in Saturating;
        let d_sat: i64 in Saturating = a - b;
        let diff: i64 = d_sat as i64;
        let headroom: i64 = 100i64 - diff;
        let margin: i64 = diff - 40i64;
        let check_h: u64 = headroom as u64;
        let check_m: u64 = margin as u64;
        transition diff == 70i64 && headroom + margin == 60i64 && check_h + check_m == 60u64 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

ArmSubtractTarget satisfies SelectedSubtractTarget {
    machine subtract_target(lhs: i64, rhs: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 80i64 && lhs <= 125i64 requires rhs >= 20i64 && rhs <= 40i64
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: i64 in Saturating = lhs as i64 in Saturating;
        let b: i64 in Saturating = rhs as i64 in Saturating;
        let d_sat: i64 in Saturating = a - b;
        let diff: i64 = d_sat as i64;
        let headroom: i64 = 100i64 - diff;
        let margin: i64 = diff - 40i64;
        let check_h: u64 = headroom as u64;
        let check_m: u64 = margin as u64;
        transition diff == 70i64 && headroom + margin == 60i64 && check_h + check_m == 60u64 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

machine main() crashes Trap {
    let res: i32 = SelectedSubtractTarget::subtract_target(100i64, 30i64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
