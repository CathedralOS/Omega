use {omega}/language/core/foundation.omg as proof;
// Expected rejection: exact arithmetic
// An admitted no-wrap domain predicate proves base + requested fits address when requested < length.
// Geometry is numeric evidence, not a storage claim.
data Region { base: address; length: u64; }
let no_wrap(base: address, length: u64): |proof|::Strict<0> =
    embed(base) + embed(length) <= address::Bound;
domain Region::Bounded
requires embed(self.base) <= address::Bound;
machine region(base: address, length: u64, endpoint: address) -> Region in Bounded
requires embed(base) + embed(length) <= embed(endpoint)
ensures result.base == base && result.length == length
{ Region { base: base, length: length } }
machine cut(whole: Region in Bounded, requested: u64, flag: bool) -> address
requires requested < whole.length
{
    let selected: Region in Bounded = match flag { true -> whole, false -> whole };
    selected.base + requested
}
machine main() crashes Trap {
    let whole: Region in Bounded = region(10, 80, 100);
    let address: address = cut(whole, 20, true);
    transition address == 30 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
