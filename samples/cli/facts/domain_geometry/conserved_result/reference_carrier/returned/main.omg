// Expected exit: 0
data Carrier<'storage> { marker: i32; reference: &'storage i32; }
data Holder<'storage> { carrier: Carrier<'storage>; }
domain Carrier::Ready(carrier) requires carrier.marker == 41;
machine qualify<'storage>(holder: Holder<'storage>) -> Carrier<'storage> in Ready
requires holder.carrier.marker == 41
{
    let qualified: Carrier<'storage> in Ready = holder.carrier;
    qualified
}
machine main() crashes Trap {
    let backing: i32 = 42;
    let raw: Carrier = Carrier { marker: 41, reference: &backing };
    let qualified: Carrier in Ready = qualify(Holder { carrier: raw });
    let observed: i32 = qualified.reference;
    transition observed == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
