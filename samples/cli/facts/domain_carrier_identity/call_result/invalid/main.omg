// The call_result carrier is u8, so membership in the u16 domain Small is ill-formed and must reject.
// A u8 value is a member of the u8 domain Small (self <= 10) only on its own u8 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

machine sample(value: u8) -> u8 requires value in Small ensures result in Small {
    value
}

machine headroom(value: u8) -> u8 requires value in Small {
    10 - value
}

machine main() crashes Trap {
    transition headroom(sample(7)) == 3 && headroom(sample(2)) == 8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
