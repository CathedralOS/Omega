// The target_body carrier is u8, so membership in the u16 domain Small is ill-formed and must reject.
// A u8 value is a member of the u8 domain Small (self <= 10) only on its own u8 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedHeadroom {
    machine headroom(value: u8) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires value in Small;
}

X86Headroom satisfies SelectedHeadroom {
    machine headroom(value: u8) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires value in Small
    {
        SelectedBodyCheck::require_tag(17u64);
        10 - value
    }
}

ArmHeadroom satisfies SelectedHeadroom {
    machine headroom(value: u8) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires value in Small
    {
        SelectedBodyCheck::require_tag(29u64);
        10 - value
    }
}

machine main() crashes Trap {
    transition SelectedHeadroom::headroom(7) == 3 && SelectedHeadroom::headroom(2) == 8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}

machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
