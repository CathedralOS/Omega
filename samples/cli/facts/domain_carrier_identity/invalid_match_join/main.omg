// The match_join carrier is u8, so membership in the u16 domain Small is ill-formed and must reject.
// A u8 value is a member of the u8 domain Small (self <= 10) only on its own u8 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

machine pick(high: bool) -> u8 ensures result in Small {
    transition high {
        true -> 7
        _ -> 2
    }
}

machine headroom(value: u8) -> u8 requires value in Small {
    10 - value
}

machine main() crashes Trap {
    transition headroom(pick(true)) == 3 && headroom(pick(false)) == 8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
