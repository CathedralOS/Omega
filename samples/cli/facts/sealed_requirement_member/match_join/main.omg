// Selected satisfies Sum and its inline combine only calls add, which already satisfies Sum::combine, preserving 0 <= result && result <= 100.
trait Sum {
    machine combine(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures 0 <= result && result <= 100
    blocks;
}

machine add(left: i32, right: i32) -> i32
satisfies Sum::combine
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures 0 <= result && result <= 100
{
    left + right
}

Selected satisfies Sum {
    machine combine(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures 0 <= result && result <= 100
    blocks
    {
        add(left, right)
    }
}

machine apply<Operations satisfies Sum>(left: i32, right: i32) -> i32
blocks
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures 0 <= result && result <= 100
{
    block Operations::combine(left, right)
}

// Place: match join. Each arm yields a distinct bounded pair, and combine calls add on that pair.
// Expected exit: 0
machine probe(high_left: i32, high_right: i32, low_left: i32, low_right: i32, flag: bool) -> i32
blocks
requires 0 <= high_left && high_left <= 50
requires 0 <= high_right && high_right <= 50
requires 0 <= low_left && low_left <= 50
requires 0 <= low_right && low_right <= 50
{

    let left: i32 = match flag { true -> high_left, false -> low_left };
    let right: i32 = match flag { true -> high_right, false -> low_right };
    block apply<Selected>(left, right)
}

machine main() blocks crashes Trap {
    let wide: i32 = block probe(20, 22, 10, 12, true);
    let narrow: i32 = block probe(20, 22, 10, 12, false);
    transition wide == 42 && narrow == 22 { true -> done() _ -> bad() }

    machine done() {}
    machine bad() { crash Trap; }
}
