// Selected satisfies Sum and its inline combine only calls add, which already satisfies Sum::combine, preserving 0 <= result && result <= 100.
trait Sum {
    machine combine(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures 0 <= result && result <= 100
    blocks;
}

machine add(left: i32, right: i32) -> i32
satisfies Sum::combine
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures 0 <= result && result <= 100
{
    left + right
}

Selected satisfies Sum {
    machine combine(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures 0 <= result && result <= 100
    blocks
    {
        add(left, right)
    }
}

machine apply<Operations satisfies Sum>(left: i32, right: i32) -> i32
blocks
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures 0 <= result && result <= 100
{
    block Operations::combine(left, right)
}

// Place: another selected target implementation. Each target body omits the right operand bound.
linux_x86_64 machine probe(a: i32, b: i32) -> i32
blocks
requires 0 <= a && a <= 50
{
    block apply<Selected>(a, b)
}

linux_arm64 machine probe(a: i32, b: i32) -> i32
blocks
requires 0 <= a && a <= 50
{
    block apply<Selected>(a, b)
}

macos_arm64 machine probe(a: i32, b: i32) -> i32
blocks
requires 0 <= a && a <= 50
{
    block apply<Selected>(a, b)
}

windows_x86_64 machine probe(a: i32, b: i32) -> i32
blocks
requires 0 <= a && a <= 50
{
    block apply<Selected>(a, b)
}

machine main() blocks crashes Trap {
    let result: i32 = block probe(20, 22);
    transition result == 42 { true -> done() _ -> bad() }

    machine done() {}
    machine bad() { crash Trap; }
}
