machine build(builder: &mut Build) {
    Build::application(builder, "c_layout_nested_representation_target_body");
    Build::select_provider<RecordDelivery, SecondDelivery>(builder, windows_x86_64);
    Build::select_provider<RecordDelivery, SecondDelivery>(builder, linux_x86_64);
    Build::select_provider<RecordDelivery, FirstDelivery>(builder, macos_arm64);
    Build::select_provider<RecordDelivery, SecondDelivery>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main_second);
    Build::bind(builder, linux_x86_64::ProgramEntry, main_second);
    Build::bind(builder, macos_arm64::ProgramEntry, main_first);
    Build::bind(builder, linux_arm64::ProgramEntry, main_second);
}
