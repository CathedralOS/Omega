// Library C layout preserves explicit child representation values, geometry and alias identity across transport.
// Expected exit: 0
use {omega}/language/core/c_layout.omg;
use {omega}/language/core/layout.omg;
data Payload [copy] { first: u8; second: u64; last: u16; }
Spread satisfies |layout|::FixedLayout<Payload> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 16 } };
        entries[2] = |layout|::FieldEntry { key: schema.fields[2].key, representation: |layout|::FieldPlan::At { offset: 32 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 3, size_fixed: 40, size_is_dynamic: false, align: 8 }
    }
}
data Record [copy] { first: u8; child: |layout|::LayoutStorage<Payload, Spread>; last: u16; }
data Holder [copy] { value: |c_layout|::CLayout<Record>; }
machine explicit(value: |c_layout|::CLayout<Record>) -> |layout|::LayoutStorage<Record, |c_layout|::CAbiPolicy<Record>> { value }
machine main() crashes Trap {
    let mutable record: |c_layout|::CLayout<Record>;
    record.first = 17u8;
    record.child.first = 23u8;
    record.child.last = 9u16;
    record.child.second = 42u64;
    record.last = 11u16;
    let same: |layout|::LayoutStorage<Record, |c_layout|::CAbiPolicy<Record>> = explicit(record);
    let holder: Holder = Holder { value: same };
    // All raw words, including future record padding, are initialized. The
    // shared record view reads only its scalar fields and grants no new writes.
    let mutable words: [u64; 7];
    words[0] = 17u64;
    words[1] = 23u64;
    words[2] = 0u64;
    words[3] = 42u64;
    words[4] = 0u64;
    words[5] = 9u64;
    words[6] = 11u64;
    let mapped: @|c_layout|::CLayout<Record> = @words as @|c_layout|::CLayout<Record>;
    transition holder.value.first == 17u8 && holder.value.child.first == 23u8 && holder.value.child.last == 9u16 && holder.value.child.second == 42u64 && holder.value.last == 11u16 && mapped.first == 17u8 && mapped.child.first == 23u8 && mapped.child.last == 9u16 && mapped.child.second == 42u64 && mapped.last == 11u16 && size_of::<|c_layout|::CLayout<Record>>() == 56u64 && align_of::<|c_layout|::CLayout<Record>>() == 8u64 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
