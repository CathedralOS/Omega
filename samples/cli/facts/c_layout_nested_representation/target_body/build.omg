use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "c_layout_nested_representation_target_body" };
    Build::select_provider::<|app|::RecordDelivery, |app|::SecondDelivery>(builder, windows_x86_64);
    Build::select_provider::<|app|::RecordDelivery, |app|::SecondDelivery>(builder, linux_x86_64);
    Build::select_provider::<|app|::RecordDelivery, |app|::FirstDelivery>(builder, macos_arm64);
    Build::select_provider::<|app|::RecordDelivery, |app|::SecondDelivery>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main_second);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main_second);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main_first);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main_second);
}
