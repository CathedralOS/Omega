// Fact: 32-bit signed bitwise XOR raw ^ 15i32 with bounded interval 40i32 <= xored <= 63i32 establishes 40i32 <= xored <= 63i32 across all nine places so exact subtractions 63i32 - xored and xored - 40i32 are safe.
// Expected exit: 0

machine verify_xored(v: i32) -> i32
    requires v >= 40i32 && v <= 63i32
{
    let headroom: i32 = 63i32 - v;
    let margin: i32 = v - 40i32;
    let sum: i32 = headroom + margin;
    let checked: i32 = sum - 23i32;
    // Observe the transported value after the original bound-dependent operations.
    transition v == 52i32 {
        true -> checked
        false -> 1i32
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine target_probe(raw: i32) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires raw >= 59i32 && raw <= 59i32;
}

X86Probe satisfies SelectedProbe {
    machine target_probe(raw: i32) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires raw >= 59i32 && raw <= 59i32
    {
        SelectedBodyCheck::require_tag(17u64);
        let xored: i32 = raw ^ 15i32;
        transition xored >= 40i32 {
            true -> check(xored)
            false -> bad()
        }
        machine check(res: i32) -> i32 {
            verify_xored(res)
        }
        machine bad() -> i32 { 1i32 }
    }
}

ArmProbe satisfies SelectedProbe {
    machine target_probe(raw: i32) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires raw >= 59i32 && raw <= 59i32
    {
        SelectedBodyCheck::require_tag(29u64);
        let xored: i32 = raw ^ 15i32;
        transition xored >= 40i32 {
            true -> check(xored)
            false -> bad()
        }
        machine check(res: i32) -> i32 {
            verify_xored(res)
        }
        machine bad() -> i32 { 1i32 }
    }
}

machine probe(raw: i32) -> i32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
    requires raw >= 59i32 && raw <= 59i32
{
    SelectedProbe::target_probe(raw)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: i32 = probe(59i32);
    transition res == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
