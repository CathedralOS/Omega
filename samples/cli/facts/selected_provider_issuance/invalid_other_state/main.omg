// Expected rejection: ordinary provider invocation cannot establish fresh Buffer::Owned.
// Only an admitted selected InitialSupply call establishes fresh Count1 ownership, preserved with exact backing through submit/complete and release.
// The initial account enters only through the selected admitted InitialSupply
// invocation after its provider has obtained a successful fresh allocation.
use {omega}/language/core/content.omg;
use {omega}/language/core/foundation.omg as proof;

public data ByteUnit {}
public data Buffer [linear] { pointer: address; }
public domain Buffer::Owned
established by InitialSupply::acquire, Writer::complete;
public machine Owned::content(buffer: @Buffer) -> |content|::CountedQuantity<ByteUnit>
satisfies |content|::Content<Buffer, |content|::CountedQuantity<ByteUnit>>::project {
    |content|::CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data PendingWrite [linear] { pointer: address; }
public domain PendingWrite::Retained established by Writer::submit;
public machine Retained::content(pending: @PendingWrite) -> |content|::CountedQuantity<ByteUnit>
satisfies |content|::Content<PendingWrite, |content|::CountedQuantity<ByteUnit>>::project {
    |content|::CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public boundary trait InitialSupply {
    machine acquire() -> Buffer reaches NativeBytes crashes Trap
    ensures result in Buffer::Owned, result.pointer != 0;
}
public boundary trait Writer {
    machine submit(buffer: Buffer in Buffer::Owned) -> PendingWrite reaches none
    ensures result in PendingWrite::Retained,
        result.pointer == buffer.pointer,
        |proof|::Identity::<|content|::CountedQuantity<ByteUnit>>(
            Owned::content(old(@buffer)),
            Retained::content(@result)
        ) crashes none;
    machine complete(pending: PendingWrite in PendingWrite::Retained) -> Buffer reaches none
    ensures result in Buffer::Owned,
        result.pointer == pending.pointer,
        |proof|::Identity::<|content|::CountedQuantity<ByteUnit>>(
            Retained::content(old(@pending)),
            Owned::content(@result)
        ) crashes none;
}
// This is the actual native supply/custody leaf. The raw allocation result
// has no Owned qualification; a null result never becomes a normal grant.
public boundary trait NativeBytes {
    machine allocate(count: u64, width: u64) -> address reaches none crashes none;
    machine release(buffer: Buffer in Buffer::Owned) reaches none crashes none;
}
InitialSupplyProvider satisfies InitialSupply {
    machine acquire() -> Buffer reaches NativeBytes crashes Trap
    ensures result.pointer != 0 {
        let pointer: address = NativeBytes::allocate(1, 1);
        transition pointer != 0 { true -> supplied(pointer), _ -> failed() }
        machine supplied(pointer: address) -> Buffer reaches none
        requires pointer != 0 ensures result.pointer == pointer {
            Buffer { pointer: pointer }
        }
        machine failed() -> Buffer reaches none crashes Trap { crash Trap; }
    }
}
WriterProvider satisfies Writer {
    machine submit(buffer: Buffer in Buffer::Owned) -> PendingWrite reaches none
    ensures result.pointer == buffer.pointer,
        |proof|::Identity::<|content|::CountedQuantity<ByteUnit>>(
            Owned::content(old(@buffer)),
            Retained::content(@result)
        ) {
        let { pointer } = buffer;
        PendingWrite { pointer: pointer }
    }
    machine complete(pending: PendingWrite in PendingWrite::Retained) -> Buffer reaches none
    ensures result.pointer == pending.pointer,
        |proof|::Identity::<|content|::CountedQuantity<ByteUnit>>(
            Retained::content(old(@pending)),
            Owned::content(@result)
        ) {
        let { pointer } = pending;
        Buffer { pointer: pointer }
    }
}
machine round_trip(buffer: Buffer in Buffer::Owned) -> Buffer
reaches Writer
ensures result in Buffer::Owned, result.pointer == buffer.pointer {
    let pending: PendingWrite in PendingWrite::Retained = Writer::submit(buffer);
    Writer::complete(pending)
}
data Main {}
machine Main::main(context: @mutable Main) reaches InitialSupply + Writer + NativeBytes crashes Trap {
    let buffer: Buffer in Buffer::Owned = InitialSupplyProvider::acquire();
    transition { _ -> supplied(buffer) }
    machine supplied(buffer: Buffer in Buffer::Owned) reaches Writer + NativeBytes crashes Trap {
        let original_pointer: address = buffer.pointer;
        let restored: Buffer in Buffer::Owned = round_trip(buffer);
        let same_backing: bool = restored.pointer == original_pointer;
        NativeBytes::release(restored);
        transition same_backing { true -> done(), _ -> failed() }
        machine done() reaches none {}
        machine failed() reaches none crashes Trap { crash Trap; }
    }
}

// The hosted entry owns its ordinary application storage.
machine entry_start() reaches InitialSupply + Writer + NativeBytes crashes Trap {
    let mutable application: Main = Main {};
    Main::main(@mutable application);
}
