use {omega}/language/core/external_binding.omg as foreign;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "selected_provider_issuance" };
    Build::accept_boundary::<InitialSupply>(builder);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, linux_arm64);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, linux_x86_64);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, macos_arm64);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, macos_x86_64);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, windows_x86_64);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, uefi_x86_64);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, cross_platform_cli);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, local_unchecked);
    Build::select_provider::<InitialSupply, InitialSupplyProvider>(builder, alpha_bootstrap);
    Build::accept_boundary::<Writer>(builder);
    Build::select_provider::<Writer, WriterProvider>(builder, linux_arm64);
    Build::select_provider::<Writer, WriterProvider>(builder, linux_x86_64);
    Build::select_provider::<Writer, WriterProvider>(builder, macos_arm64);
    Build::select_provider::<Writer, WriterProvider>(builder, macos_x86_64);
    Build::select_provider::<Writer, WriterProvider>(builder, windows_x86_64);
    Build::select_provider::<Writer, WriterProvider>(builder, uefi_x86_64);
    Build::select_provider::<Writer, WriterProvider>(builder, cross_platform_cli);
    Build::select_provider::<Writer, WriterProvider>(builder, local_unchecked);
    Build::select_provider::<Writer, WriterProvider>(builder, alpha_bootstrap);
    Build::accept_boundary::<NativeBytes>(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);

    Build::bind_native::<NativeBytes::allocate>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_calloc", } });
    Build::bind_native::<NativeBytes::release>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_free", } });
    Build::bind_native::<NativeBytes::allocate>(builder, linux_x86_64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.2.5", } });
    Build::bind_native::<NativeBytes::release>(builder, linux_x86_64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "free", version: "GLIBC_2.2.5", } });
    Build::bind_native::<NativeBytes::allocate>(builder, linux_arm64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.17", } });
    Build::bind_native::<NativeBytes::release>(builder, linux_arm64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "free", version: "GLIBC_2.17", } });
    Build::bind_native::<NativeBytes::allocate>(builder, windows_x86_64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::PeByName { library: "msvcrt.dll", export: "calloc", } });
    Build::bind_native::<NativeBytes::release>(builder, windows_x86_64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::PeByName { library: "msvcrt.dll", export: "free", } });
}
