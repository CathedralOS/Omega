use main.omg as app;
use {omega}/language/core/external_binding.omg as native;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "selected_provider_issuance" };
    Build::accept_boundary::<|app|::InitialSupply>(builder);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::InitialSupply, |app|::InitialSupplyProvider>(builder, alpha_bootstrap);
    Build::accept_boundary::<|app|::Writer>(builder);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::Writer, |app|::WriterProvider>(builder, alpha_bootstrap);
    Build::accept_boundary::<|app|::NativeBytes>(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);

    Build::bind_native::<|app|::NativeBytes::allocate>(builder, macos_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_calloc", } });
    Build::bind_native::<|app|::NativeBytes::release>(builder, macos_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_free", } });
    Build::bind_native::<|app|::NativeBytes::allocate>(builder, linux_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.2.5", } });
    Build::bind_native::<|app|::NativeBytes::release>(builder, linux_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "free", version: "GLIBC_2.2.5", } });
    Build::bind_native::<|app|::NativeBytes::allocate>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.17", } });
    Build::bind_native::<|app|::NativeBytes::release>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "free", version: "GLIBC_2.17", } });
    Build::bind_native::<|app|::NativeBytes::allocate>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "msvcrt.dll", export: "calloc", } });
    Build::bind_native::<|app|::NativeBytes::release>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "msvcrt.dll", export: "free", } });
    Build::select_provider::<|app|::TargetTransport, |app|::TargetTransportCode>(builder, windows_x86_64);
    Build::select_provider::<|app|::TargetTransport, |app|::TargetTransportCode>(builder, linux_x86_64);
    Build::select_provider::<|app|::TargetTransport, |app|::TargetTransportCode>(builder, macos_arm64);
    Build::select_provider::<|app|::TargetTransport, |app|::TargetTransportCode>(builder, linux_arm64);
}
