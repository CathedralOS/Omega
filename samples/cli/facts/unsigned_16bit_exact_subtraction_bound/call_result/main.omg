// Fact: 16-bit unsigned exact subtraction lhs - rhs with 300u16 <= lhs <= 500u16 and 50u16 <= rhs <= 100u16 establishes 200u16 <= diff <= 450u16 so 450u16 - diff and diff - 200u16 are safe.
// Place: call_result. A function call returns the difference before discharging subtraction bounds.
// Expected exit: 0

machine subtract(lhs: u16, rhs: u16) -> u16
requires lhs >= 300u16 && lhs <= 500u16 && rhs >= 50u16 && rhs <= 100u16
ensures result >= 200u16 && result <= 450u16
{
    lhs - rhs
}

machine compute_call(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 500u16 && rhs >= 50u16 && rhs <= 100u16
{
    let diff: u16 = subtract(lhs, rhs);
    let headroom: u16 = 450u16 - diff;
    let margin: u16 = diff - 200u16;
    0i32
}

machine probe() -> i32 {
    compute_call(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
