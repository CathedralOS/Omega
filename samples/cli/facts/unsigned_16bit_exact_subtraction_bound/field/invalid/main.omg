// Fact: 16-bit unsigned exact subtraction lhs - rhs with 300u16 <= lhs <= 500u16 and 50u16 <= rhs <= 100u16 establishes 200u16 <= diff <= 450u16 so 450u16 - diff and diff - 200u16 are safe.
// Invalid: lhs upper bound 501 allows diff 451, causing 450u16 - container.diff to underflow. Place: field.
// Expected diagnostic: may overflow `u16`

data DiffContainer {
    diff: u16;
}

machine compute_field(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 501u16 && rhs >= 50u16 && rhs <= 100u16
{
    let container: DiffContainer = DiffContainer { diff: lhs - rhs };
    let headroom: u16 = 450u16 - container.diff;
    let margin: u16 = container.diff - 200u16;
    0i32
}

machine probe() -> i32 {
    compute_field(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
