// Fact: 16-bit unsigned exact subtraction lhs - rhs with 300u16 <= lhs <= 500u16 and 50u16 <= rhs <= 100u16 establishes 200u16 <= diff <= 450u16 so 450u16 - diff and diff - 200u16 are safe.
// Invalid: parameter upper bound 451 allows underflow in 450u16 - diff. Place: parameter.
// Expected diagnostic: may overflow `u16`

machine verify_parameter(diff: u16) -> i32
requires diff >= 200u16 && diff <= 451u16
{
    let headroom: u16 = 450u16 - diff;
    let margin: u16 = diff - 200u16;
    0i32
}

machine compute_param(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 501u16 && rhs >= 50u16 && rhs <= 100u16
{
    verify_parameter(lhs - rhs)
}

machine probe() -> i32 {
    compute_param(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
