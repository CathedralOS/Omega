// Fact: 16-bit unsigned exact subtraction lhs - rhs with 300u16 <= lhs <= 500u16 and 50u16 <= rhs <= 100u16 establishes 200u16 <= diff <= 450u16 so 450u16 - diff and diff - 200u16 are safe.
// Invalid: lhs upper bound 501 allows diff 451, causing 450u16 - d to underflow. Place: local.
// Expected diagnostic: may overflow `u16`

machine compute_local(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 501u16 && rhs >= 50u16 && rhs <= 100u16
{
    let diff: u16 = lhs - rhs;
    let d: u16 = diff;
    let headroom: u16 = 450u16 - d;
    let margin: u16 = d - 200u16;
    0i32
}

machine probe() -> i32 {
    compute_local(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
