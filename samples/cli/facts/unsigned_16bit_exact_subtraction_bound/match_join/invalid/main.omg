// Fact: 16-bit unsigned exact subtraction lhs - rhs with 300u16 <= lhs <= 500u16 and 50u16 <= rhs <= 100u16 establishes 200u16 <= diff <= 450u16 so 450u16 - diff and diff - 200u16 are safe.
// Invalid: match join result upper bound 451 allows underflow in 450u16 - diff. Place: match_join.
// Expected diagnostic: may overflow `u16`

machine choose_diff(flag: bool, lhs: u16, rhs: u16) -> u16
requires lhs >= 300u16 && lhs <= 501u16 && rhs >= 50u16 && rhs <= 100u16
ensures result >= 200u16 && result <= 451u16
{
    match flag {
        true -> lhs - rhs,
        false -> lhs - rhs,
    }
}

machine compute_join(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 501u16 && rhs >= 50u16 && rhs <= 100u16
{
    let diff: u16 = choose_diff(true, lhs, rhs);
    let headroom: u16 = 450u16 - diff;
    let margin: u16 = diff - 200u16;
    0i32
}

machine probe() -> i32 {
    compute_join(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
