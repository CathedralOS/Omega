// Expected exit: 0
// Equal carriers. The selected body returns false, so the match arm does not
// hit and the direct comparison is false. Builtin equality would do the opposite.
domain f64::Marked;

machine == f64::Marked::same(left: f64 in Marked, right: f64 in Marked) -> bool {
    false
}

machine compare(left: f64 in Marked, right: f64 in Marked) -> bool {
    left == right
}

machine choose(value: f64 in Marked, pattern: f64 in Marked) -> u64 {
    match value { pattern -> 7, _ -> 11 }
}

machine main() crashes Trap {
    let value: f64 in Marked = 1.0;
    let direct: bool = compare(value, value);
    let matched: u64 = choose(value, value);
    transition direct == false && matched == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
