// The false state disagrees with the other result and cannot establish demand.
// A body result is constant only when every reachable normal return agrees.
machine choose(flag: bool) -> bool {
    transition flag { true -> true false -> false }
}

machine stable(flag: bool) -> bool {
    transition flag { true -> true false -> finish() }
    machine finish() -> bool { false }
}

machine relay(flag: bool) -> bool { stable(flag) }

machine demand(value: bool) -> bool
requires value == true
{
    value
}

machine main() crashes Trap {
    let first: bool = choose(true);
    let second: bool = choose(false);
    let joined: bool = demand(relay(false));
    transition first && !second && joined {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
