data Configuration<'activation, 'storage> { builder: &'activation Build<'storage>; }
machine wrap<'activation, 'storage>(builder: &'activation mut Build<'storage>) -> Configuration<'activation, 'storage> {
    Configuration { builder: builder }
}
machine bind_configuration(configuration: &mut Configuration) {
    Build::bind(configuration.builder, linux_x86_64::ProgramEntry, main);
    Build::bind(configuration.builder, linux_arm64::ProgramEntry, main);
    Build::bind(configuration.builder, macos_arm64::ProgramEntry, main);
    Build::bind(configuration.builder, windows_x86_64::ProgramEntry, main);
}
machine build(builder: &mut Build) {
    Build::application(builder, "build_activation_borrow_local");
    let view: &mut Build = builder;
    let mut configuration: Configuration = Configuration { builder: view };
    bind_configuration(&mut configuration);
}
