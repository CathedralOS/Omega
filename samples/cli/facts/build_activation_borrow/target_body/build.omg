data Configuration<'activation, 'storage> { builder: @'activation mutable Build<'storage>; }
machine wrap<'activation, 'storage>(builder: @'activation mutable Build<'storage>) -> Configuration<'activation, 'storage> {
    Configuration { builder: builder }
}
machine bind_configuration(configuration: @mutable Configuration) {
    Build::bind(configuration.builder, linux_x86_64::ProgramEntry, SelectedEntry::enter);
    Build::bind(configuration.builder, linux_arm64::ProgramEntry, SelectedEntry::enter);
    Build::bind(configuration.builder, macos_arm64::ProgramEntry, SelectedEntry::enter);
    Build::bind(configuration.builder, windows_x86_64::ProgramEntry, SelectedEntry::enter);
}
machine build(builder: @mutable Build) {
    Build::application(builder, "build_activation_borrow_target_body");
    let mutable configuration: Configuration = wrap(builder);
    bind_configuration(@mutable configuration);
}
