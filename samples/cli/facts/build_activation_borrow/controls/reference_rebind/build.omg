use main.omg as app;
data Configuration<'activation, 'storage> { builder: @'activation Build<'storage>; }
machine rebind<'activation>(builder: @'activation Build) {
    let mutable configuration: Configuration = Configuration { builder: builder };
    configuration.builder = builder;
    let observed: bool = configuration.builder.tests.disabled;
}
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "builder_rebind_scope" };
    rebind(builder);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
