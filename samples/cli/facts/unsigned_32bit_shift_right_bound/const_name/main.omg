// Fact: a 32-bit unsigned u32 logical right shift of a bounded input (val >= 240u32 && val <= 240u32) by 2u32 bits establishes shifted >= 60u32 && shifted <= 60u32 so exact 32-bit subtraction shifted - 60u32 is proved underflow-free across all nine places.
// Place: const name. A named constant supplies the bounded 32-bit operand before right shift and subtraction.
// Expected exit: 0

const VAL: u32 = 240u32;

machine shift_const(shift: u32) -> u32
requires shift == 2
{
    let shifted: u32 = VAL >> shift;
    shifted - 60u32
}

machine probe() -> u32 {
    shift_const(2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
