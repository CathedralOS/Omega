// Fact: a 32-bit unsigned u32 logical right shift of a bounded input (val >= 240u32 && val <= 240u32) by 2u32 bits establishes shifted >= 60u32 && shifted <= 60u32 so exact 32-bit subtraction shifted - 60u32 is proved underflow-free across all nine places.
// Place: call result. A contracted helper call returns the bounded 32-bit operand before right shift and subtraction.
// Expected exit: 0

machine get_val() -> u32
ensures result >= 240 && result <= 240
{
    240u32
}

machine shift_call_result(shift: u32) -> u32
requires shift == 2
{
    let val: u32 = get_val();
    let shifted: u32 = val >> shift;
    shifted - 60u32
}

machine probe() -> u32 {
    shift_call_result(2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
