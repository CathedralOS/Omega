// Fact: a 32-bit unsigned u32 logical right shift of a bounded input (val >= 240u32 && val <= 240u32) by 2u32 bits establishes shifted >= 60u32 && shifted <= 60u32 so exact 32-bit subtraction shifted - 60u32 is proved underflow-free across all nine places.
// Place: another state. A successor state receives the bounded 32-bit operand and shift count before right shift and subtraction.
// Expected exit: 0

machine shift_state(val: u32, shift: u32) -> u32
requires val >= 240 && val <= 240 && shift == 2
{
    transition {
        _ -> step(val, shift)
    }
    machine step(v: u32, s: u32) -> u32
    requires v >= 240 && v <= 240 && s == 2
    {
        let shifted: u32 = v >> s;
        shifted - 60u32
    }
}

machine probe() -> u32 {
    shift_state(240u32, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
