// Fact: a 32-bit unsigned u32 logical right shift of a bounded input (val >= 240u32 && val <= 240u32) by 2u32 bits establishes shifted >= 60u32 && shifted <= 60u32 so exact 32-bit subtraction shifted - 60u32 is proved underflow-free across all nine places.
// Place: match join. Both match arms yield the bounded 32-bit operand and join before right shift and subtraction.
// Expected exit: 0

machine choose_val(flag: bool) -> u32
ensures result >= 240 && result <= 240
{
    match flag {
        true -> 240u32,
        false -> 240u32,
    }
}

machine shift_match_join(shift: u32) -> u32
requires shift == 2
{
    let val: u32 = choose_val(true);
    let shifted: u32 = val >> shift;
    shifted - 60u32
}

machine probe() -> u32 {
    shift_match_join(2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
