// Fact: a 32-bit unsigned u32 logical right shift of a bounded input (val >= 240u32 && val <= 240u32) by 2u32 bits establishes shifted >= 60u32 && shifted <= 60u32 so exact 32-bit subtraction shifted - 60u32 is proved underflow-free across all nine places.
// Place: another target body. Each of four target-scoped machine bodies shifts the bounded 32-bit operand and subtracts 60u32.
// Expected exit: 0

linux_x86_64 machine shift_target(val: u32, shift: u32) -> u32
requires val >= 240 && val <= 240 && shift == 2
{
    let shifted: u32 = val >> shift;
    shifted - 60u32
}

linux_arm64 machine shift_target(val: u32, shift: u32) -> u32
requires val >= 240 && val <= 240 && shift == 2
{
    let shifted: u32 = val >> shift;
    shifted - 60u32
}

macos_arm64 machine shift_target(val: u32, shift: u32) -> u32
requires val >= 240 && val <= 240 && shift == 2
{
    let shifted: u32 = val >> shift;
    shifted - 60u32
}

windows_x86_64 machine shift_target(val: u32, shift: u32) -> u32
requires val >= 240 && val <= 240 && shift == 2
{
    let shifted: u32 = val >> shift;
    shifted - 60u32
}

machine probe() -> u32 {
    shift_target(240u32, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
