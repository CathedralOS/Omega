// Fact: a 32-bit unsigned u32 logical right shift of a bounded input (val >= 240u32 && val <= 240u32) by 2u32 bits establishes shifted >= 60u32 && shifted <= 60u32 so exact 32-bit subtraction shifted - 60u32 is proved underflow-free across all nine places.
// Place: another target body. Each of four target-scoped machine bodies shifts the bounded 32-bit operand and subtracts 60u32.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedShiftTarget {
    machine shift_target(val: u32, shift: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 240 && val <= 240 && shift == 2;
}

X86ShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u32, shift: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 240 && val <= 240 && shift == 2
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: u32 = val >> shift;
        shifted - 60u32
    }
}

ArmShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u32, shift: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 240 && val <= 240 && shift == 2
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: u32 = val >> shift;
        shifted - 60u32
    }
}

machine probe() -> u32 {
    SelectedShiftTarget::shift_target(240u32, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
