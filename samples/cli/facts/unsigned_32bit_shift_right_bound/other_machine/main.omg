// Fact: a 32-bit unsigned u32 logical right shift of a bounded input (val >= 240u32 && val <= 240u32) by 2u32 bits establishes shifted >= 60u32 && shifted <= 60u32 so exact 32-bit subtraction shifted - 60u32 is proved underflow-free across all nine places.
// Place: another machine. An intermediate machine forwards the bounded 32-bit operand and shift count to the shift machine.
// Expected exit: 0

machine perform_shift(val: u32, shift: u32) -> u32
requires val >= 240 && val <= 240 && shift == 2
{
    let shifted: u32 = val >> shift;
    shifted - 60u32
}

machine forward(val: u32, shift: u32) -> u32
requires val >= 240 && val <= 240 && shift == 2
{
    perform_shift(val, shift)
}

machine probe() -> u32 {
    forward(240u32, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
