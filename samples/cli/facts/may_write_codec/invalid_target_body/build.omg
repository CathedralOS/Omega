use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "may_write_codec_through_target_body" };
    Build::select_provider::<|app|::CodecProbe, |app|::StoredCursorProbe>(builder, linux_x86_64);
    Build::select_provider::<|app|::CodecProbe, |app|::StoredCursorProbe>(builder, linux_arm64);
    Build::select_provider::<|app|::CodecProbe, |app|::StoredCursorProbe>(builder, macos_arm64);
    Build::select_provider::<|app|::CodecProbe, |app|::StoredCursorProbe>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}