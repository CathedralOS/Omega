// A reborrow after stored descriptor replacement writes 41 to incoming backing while preserving original 17 and sibling 7.
// Place: other_state.
// Expected: reject exclusive reborrow from shared stored descriptor.
data Cell { value: i32; }
data Message<'storage> { body: &'storage Cell; }
machine replace<'storage>(message: &mut Message<'storage>, incoming: &'storage mut Cell) -> bool {
    message.body = incoming;
    true
}
machine store(target: &mut Cell, value: i32) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine consume<'storage>(message: Message<'storage>) -> bool {
    transition { _ -> finish(message) }
    machine finish(message: Message<'storage>) -> bool {
        store(&mut message.body, 41)
    }
}
machine exercise() -> bool {
    let mut original: Cell = Cell { value: 17 };
    let mut incoming: Cell = Cell { value: 19 };
    let sibling: Cell = Cell { value: 7 };
    let mut message: Message = Message { body: &mut original };
    let replaced: bool = replace(&mut message, &mut incoming);
    let written: bool = consume(message);
    replaced && written && original.value == 17 && incoming.value == 41 && sibling.value == 7
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
