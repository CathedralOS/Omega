// A reborrow after stored descriptor replacement writes 41 to incoming backing while preserving original 17 and sibling 7.
// Place: parameter.
// Expected exit: 0
data Cell { value: i32; }
data Message<'storage> { body: @'storage mutable Cell; }
machine replace<'storage>(message: @mutable Message<'storage>, incoming: @'storage mutable Cell) -> bool {
    message.body = incoming;
    true
}
machine store(target: @mutable Cell, value: i32) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine consume<'storage>(message: Message<'storage>) -> bool {
    store(@mutable message.body, 41)
}
machine exercise() -> bool {
    let mutable original: Cell = Cell { value: 17 };
    let mutable incoming: Cell = Cell { value: 19 };
    let sibling: Cell = Cell { value: 7 };
    let mutable message: Message = Message { body: @mutable original };
    let replaced: bool = replace(@mutable message, @mutable incoming);
    let written: bool = consume(message);
    replaced && written && original.value == 17 && incoming.value == 41 && sibling.value == 7
}
machine main() crashes Trap {
    transition exercise() { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
