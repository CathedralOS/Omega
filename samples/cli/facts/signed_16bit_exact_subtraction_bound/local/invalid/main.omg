// Fact: 16-bit signed exact subtraction lhs - rhs with 300i16 <= lhs <= 500i16 and 50i16 <= rhs <= 100i16 establishes 200i16 <= diff <= 450i16 so 450i16 - diff and diff - 200i16 are safe.
// Place: local. The difference is transported through intermediate local bindings.
// Invalid control: lhs upper bound widened to 520i16, allowing diff up to 470i16 and failing exact headroom check.
// Expected rejection: not provably representable

machine subtract_local(lhs: i16, rhs: i16) -> i32
    requires lhs >= 300i16 && lhs <= 520i16;
    requires rhs >= 50i16 && rhs <= 100i16;
{
    let l: i16 = lhs;
    let r: i16 = rhs;
    let d: i16 = l - r;
    let diff: i16 = d;
    let headroom: i16 = 450i16 - diff;
    let margin: i16 = diff - 200i16;
    let check_h: u16 = headroom as u16;
    let check_m: u16 = margin as u16;
    transition diff == 320i16 && headroom + margin == 250i16 && check_h + check_m == 250u16 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = subtract_local(400i16, 80i16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
