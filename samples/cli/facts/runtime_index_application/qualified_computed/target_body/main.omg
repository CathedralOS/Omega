// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0

domain<const Bound:u64> u64::AtMost<Bound> requires self <= Bound;
data Index<const Max:u64,Limit:u64 in AtMost<Max>> [copy] requires value<Limit {value:u64;}
data Observation [copy] {payload:u64;limit:u64;}

machine construct(total: u64)->Observation requires total >= 8 && total <= 9 {
 let indexed:Index<10,((total+1u64) as u64 in AtMost<10>)> = Index{value:8};
 Observation{payload:indexed.value,limit:(indexed.Limit as u64)}
}

boundary trait IndexProbe { machine probe(total: u64) -> Observation requires total >= 8 && total <= 9 reaches; }
WindowsIndexProbe satisfies IndexProbe { machine probe(total: u64) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
LinuxX86IndexProbe satisfies IndexProbe { machine probe(total: u64) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
MacIndexProbe satisfies IndexProbe { machine probe(total: u64) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
LinuxArmIndexProbe satisfies IndexProbe { machine probe(total: u64) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
machine main() crashes Trap {
 let first:Observation=IndexProbe::probe(8);
 let second:Observation=IndexProbe::probe(9);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 {true->done() _->bad()}
 machine done() {}
 machine bad() crashes Trap {crash Trap;}
}
