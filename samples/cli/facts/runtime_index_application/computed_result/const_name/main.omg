// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0

data Index<Limit:u32> [copy] where value<Limit {value:u32;}
data Observation [copy] {payload:u32;limit:u32;}

machine produce(total:u32[8..=9])->Index<(total+1u32)> { Index{value:8} }
machine construct(total:u32[8..=9])->Observation {
 let indexed:Index<(total+1u32)> = produce(total);
 Observation{payload:indexed.value,limit:indexed.Limit}
}

const Minimum:u32=8;
const Maximum:u32=9;
machine probe(total:u32[Minimum..=Maximum])->Observation {construct(total)}
machine main() crashes Trap {
 let first:Observation=probe(8);
 let second:Observation=probe(9);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 {true->done() _->bad()}
 machine done() {}
 machine bad() crashes Trap {crash Trap;}
}
