// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0

data Index<Limit:u32> [copy] requires value<Limit {value:u32;}
data Observation [copy] {payload:u32;limit:u32;}

machine produce(total: u32)->Index<(total+1u32)> requires total >= 8 && total <= 9 { Index{value:8} }
machine construct(total: u32)->Observation requires total >= 8 && total <= 9 {
 let indexed:Index<(total+1u32)> = produce(total);
 Observation{payload:indexed.value,limit:indexed.Limit}
}

boundary trait IndexProbe { machine probe(total: u32) -> Observation requires total >= 8 && total <= 9 reaches; }
WindowsIndexProbe satisfies IndexProbe { machine probe(total: u32) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
LinuxX86IndexProbe satisfies IndexProbe { machine probe(total: u32) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
MacIndexProbe satisfies IndexProbe { machine probe(total: u32) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
LinuxArmIndexProbe satisfies IndexProbe { machine probe(total: u32) -> Observation requires total >= 8 && total <= 9 { construct(total) } }
machine main() crashes Trap {
 let first:Observation=IndexProbe::probe(8);
 let second:Observation=IndexProbe::probe(9);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 {true->done() _->bad()}
 machine done() {}
 machine bad() crashes Trap {crash Trap;}
}
