// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0

data Index<Limit:u32> [copy] where value<Limit {value:u32;}
data Observation [copy] {payload:u32;limit:u32;after:u32;}
trait Arithmetic {machine + add(left:&mut u32,right:u32)->u32 requires right>=8 && right<=9 ensures result==right+1u32;}
Toggle satisfies Arithmetic {machine add(left:&mut u32,right:u32)->u32 requires right>=8 && right<=9 ensures result==right+1u32 {left=left^1u32; right+1u32}}


machine construct<Operations satisfies Arithmetic>(total:u32[8..=9])->Observation {
 let mut flag:u32=0;
 let indexed:Index<((&mut flag)+total)> = Index{value:10};
 Observation{payload:indexed.value,limit:indexed.Limit,after:flag}
}

machine retain(input:u32[8..=9])->u32[8..=9] {input}
machine probe(input:u32[8..=9])->Observation {construct<Toggle>(retain(input))}
machine main() crashes Trap {
 let first:Observation=probe(8);
 let second:Observation=probe(9);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 && first.after==1 && second.after==1 {true->done() _->bad()}
 machine done() {}
 machine bad() crashes Trap {crash Trap;}
}
