// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0

data Index<Limit:u32> [copy] where value<Limit {value:u32;}
data Observation [copy] {payload:u32;limit:u32;after:u32;}

machine count(total:u32[8..=9],flag:&mut u32)->u32 ensures result==total+1u32 {flag=flag^1u32;total+1u32}
machine construct(total:u32[8..=9])->Observation {
 let mut flag:u32=0;
 let indexed:Index<(count(total,&mut flag))> = Index{value:8};
 Observation{payload:indexed.value,limit:indexed.Limit,after:flag}
}

machine probe(first:u32[8..=9],second:u32[8..=9],flag:bool)->Observation {let total:u32[8..=9]=match flag {true->first,false->second}; construct(total)}
machine main() crashes Trap {
 let first:Observation=probe(8,9,true);
 let second:Observation=probe(8,9,false);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 && first.after==1 && second.after==1 {true->done() _->bad()}
 machine done() {}
 machine bad() crashes Trap {crash Trap;}
}
