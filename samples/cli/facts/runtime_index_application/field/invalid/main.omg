// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0
data Index<Limit: u32> [copy] where value < Limit { value: u32; }
data Bounds [copy] where limit>=9 && limit<=10 {limit:u32;}
machine construct(bounds:Bounds)->u32 {
 let limit:u32=bounds.limit;
 let indexed:Index<limit> = Index{value:10};
 indexed.value
}
machine probe(input:u32)->u32 requires input>=9 && input<=10 {
 let bounds:Bounds=Bounds{limit:input};
 construct(bounds)
}
machine main() crashes Trap {
 let first:u32=probe(9);
 let second:u32=probe(10);
 transition first==8 && second==8 { true->done() _->bad() }
 machine done(){}
 machine bad(){crash Trap;}
}
