// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0
data Index<Limit: u32> [copy] requires value < Limit { value: u32; }
data Observation [copy] { payload:u32; limit:u32; }

machine create<Created:u32>(value:u32)->Index<Created>
requires value < Created
{ Index{value:value} }
machine forward<Forwarded:u32>(value:u32)->Index<Forwarded>
requires value < Forwarded
{ create<Forwarded>(value) }

machine preserve_inner(limit:u32,item:&mut Index<limit>) {}
machine preserve(limit:u32,item:&mut Index<limit>) { preserve_inner(limit,item); }

machine observe<Observed:u32>(value:u32)->u32
requires value < Observed
{ create<Observed>(value).value }

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(limit:u32) ->Observation
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires limit>=9 && limit<=10;
}

X86Probe satisfies SelectedProbe {
    machine probe(limit:u32) ->Observation
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires limit>=9 && limit<=10
    {
        SelectedBodyCheck::require_tag(17u64);
     let mut indexed:Index<limit> = forward<limit>(8);
     preserve(limit,&mut indexed);
     Observation{payload:observe<limit>(indexed.value),limit:indexed.Limit}
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(limit:u32) ->Observation
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires limit>=9 && limit<=10
    {
        SelectedBodyCheck::require_tag(29u64);
     let mut indexed:Index<limit> = forward<limit>(8);
     preserve(limit,&mut indexed);
     Observation{payload:observe<limit>(indexed.value),limit:indexed.Limit}
    }
}

machine main() crashes Trap {
 let first:Observation=SelectedProbe::probe(9);
 let second:Observation=SelectedProbe::probe(10);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 { true->done() _->bad() }
 machine done(){}
 machine bad(){crash Trap;}
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
