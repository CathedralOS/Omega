// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0
data Index<Limit: u32> [copy] where value < Limit { value: u32; }
boundary trait SelectedProbe {
    machine probe(limit:u32)->u32 reaches
requires limit>=9 && limit<=10;
}
CheckedProbe satisfies SelectedProbe {
    machine probe(limit:u32)->u32 requires limit>=9 && limit<=10
{
 let indexed:Index<limit> = Index{value:8};
 indexed.value
}
}



machine main() crashes Trap {
 let first:u32=SelectedProbe::probe(9);
 let second:u32=SelectedProbe::probe(10);
 transition first==8 && second==8 { true->done() _->bad() }
 machine done(){}
 machine bad(){crash Trap;}
}
