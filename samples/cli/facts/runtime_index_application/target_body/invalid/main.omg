// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0
data Index<Limit: u32> [copy] where value < Limit { value: u32; }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(limit:u32) ->u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires limit>=9 && limit<=10;
}

X86Probe satisfies SelectedProbe {
    machine probe(limit:u32) ->u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires limit>=9 && limit<=10
    {
        SelectedBodyCheck::require_tag(17u64);
     let indexed:Index<limit> = Index{value:10};
     indexed.value
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(limit:u32) ->u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires limit>=9 && limit<=10
    {
        SelectedBodyCheck::require_tag(29u64);
     let indexed:Index<limit> = Index{value:10};
     indexed.value
    }
}


machine main() crashes Trap {
 let first:u32=SelectedProbe::probe(9);
 let second:u32=SelectedProbe::probe(10);
 transition first==8 && second==8 { true->done() _->bad() }
 machine done(){}
 machine bad(){crash Trap;}
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
