// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0
data Index<Limit: u32> [copy] where value < Limit { value: u32; }
data Observation [copy] { payload:u32; limit:u32; }

machine create<Created:u32>(value:u32)->Index<Created>
requires value < Created
{ Index{value:value} }
machine forward<Forwarded:u32>(value:u32)->Index<Forwarded>
requires value < Forwarded
{ create<Forwarded>(value) }

machine preserve_inner(limit:u32,item:&mut Index<limit>) {}
machine preserve(limit:u32,item:&mut Index<limit>) { preserve_inner(limit,item); }

machine observe<Observed:u32>(value:u32)->u32
requires value < Observed
{ create<Observed>(value).value }

machine construct(limit:u32)->Observation requires limit>=9 && limit<=10 {
 let supplied:u32=limit;
 let mut indexed:Index<limit> = forward<supplied>(8);
 preserve(limit,&mut indexed);
 Observation{payload:observe<limit>(indexed.value),limit:indexed.Limit}
}
machine probe(input:u32)->Observation requires input>=9 && input<=10 { construct(input) }
machine main() crashes Trap {
 let first:Observation=probe(9);
 let second:Observation=probe(10);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 { true->done() _->bad() }
 state done(){}
 state bad(){crash Trap;}
}
