machine build(builder: &mut Build) {
    Build::application(builder, "guarded_call_entry_target_body");
    Build::select_provider<FuelSource, SelectedFuel>(builder, windows_x86_64);
    Build::select_provider<FuelSource, SelectedFuel>(builder, linux_x86_64);
    Build::select_provider<FuelSource, SelectedFuel>(builder, macos_arm64);
    Build::select_provider<FuelSource, SelectedFuel>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
