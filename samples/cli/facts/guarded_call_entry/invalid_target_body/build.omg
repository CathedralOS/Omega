use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "guarded_call_entry_target_body" };
    Build::select_provider::<|app|::WorkSource, |app|::SelectedWork>(builder, windows_x86_64);
    Build::select_provider::<|app|::WorkSource, |app|::SelectedWork>(builder, linux_x86_64);
    Build::select_provider::<|app|::WorkSource, |app|::SelectedWork>(builder, macos_arm64);
    Build::select_provider::<|app|::WorkSource, |app|::SelectedWork>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
