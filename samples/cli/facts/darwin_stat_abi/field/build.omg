use {omega}/build/dependency.omg;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "darwin_stat_abi_field" };
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled { name: "system" }));
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind_native::<StatExchange::fill>(builder, macos_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libomega_darwin_stat_fixture.dylib", symbol: "_darwin_stat_fixture_fill" } });
    Build::bind_native::<StatExchange::fill>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_darwin_stat_fixture.dll", export: "darwin_stat_fixture_fill" } });
    Build::bind_native::<StatExchange::fill>(builder, linux_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_fill", version: "DARWIN_STAT_1.0" } });
    Build::bind_native::<StatExchange::fill>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_fill", version: "DARWIN_STAT_1.0" } });
    Build::bind_native::<StatExchange::check>(builder, macos_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libomega_darwin_stat_fixture.dylib", symbol: "_darwin_stat_fixture_check" } });
    Build::bind_native::<StatExchange::check>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_darwin_stat_fixture.dll", export: "darwin_stat_fixture_check" } });
    Build::bind_native::<StatExchange::check>(builder, linux_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_check", version: "DARWIN_STAT_1.0" } });
    Build::bind_native::<StatExchange::check>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_check", version: "DARWIN_STAT_1.0" } });
    Build::bind_native::<StatExchange::extent>(builder, macos_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libomega_darwin_stat_fixture.dylib", symbol: "_darwin_stat_fixture_size" } });
    Build::bind_native::<StatExchange::extent>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_darwin_stat_fixture.dll", export: "darwin_stat_fixture_size" } });
    Build::bind_native::<StatExchange::extent>(builder, linux_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_size", version: "DARWIN_STAT_1.0" } });
    Build::bind_native::<StatExchange::extent>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_size", version: "DARWIN_STAT_1.0" } });
    Build::bind_native::<StatExchange::alignment>(builder, macos_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libomega_darwin_stat_fixture.dylib", symbol: "_darwin_stat_fixture_alignment" } });
    Build::bind_native::<StatExchange::alignment>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_darwin_stat_fixture.dll", export: "darwin_stat_fixture_alignment" } });
    Build::bind_native::<StatExchange::alignment>(builder, linux_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_alignment", version: "DARWIN_STAT_1.0" } });
    Build::bind_native::<StatExchange::alignment>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_darwin_stat_fixture.so", symbol: "darwin_stat_fixture_alignment", version: "DARWIN_STAT_1.0" } });
}
