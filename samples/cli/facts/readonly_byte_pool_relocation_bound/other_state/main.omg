// Fact: a read-only byte-pool slice literal ("omega") establishes a static 5-byte length bound (bytes.len >= 5u64 && bytes.len <= 5u64), proving safe indexed byte projection bytes[4u64] and exact length subtraction bytes.len - 5u64 across all nine places.
// Place: another state. A state transition forwards the slice literal to a successor state.
// Expected exit: 0

machine inspect_bytes(bytes: &[u8]) -> u64 crashes Trap
requires bytes.len >= 5u64 && bytes.len <= 5u64
ensures result == 0u64
{
    let b: u8 = bytes[4u64];
    let diff: u64 = bytes.len - 5u64;
    transition b == 97u8 {
        true -> ok(diff)
        _ -> bad()
    }
    machine ok(d: u64) -> u64 {
        d
    }
    machine bad() -> u64 {
        crash Trap;
    }
}

machine main() crashes Trap {
    let bytes: &[u8] = "omega";
    transition {
        _ -> step(bytes)
    }
    machine step(forwarded: &[u8])
    requires forwarded.len >= 5u64 && forwarded.len <= 5u64
    {
        transition inspect_bytes(forwarded) == 0 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
