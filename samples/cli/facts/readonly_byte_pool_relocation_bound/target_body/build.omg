machine build(builder: &mut Build) {
    Build::select_provider<SelectedEvaluateBytes, CheckedEvaluateBytes>(builder, linux_x86_64);
    Build::select_provider<SelectedEvaluateBytes, CheckedEvaluateBytes>(builder, linux_arm64);
    Build::select_provider<SelectedEvaluateBytes, CheckedEvaluateBytes>(builder, macos_arm64);
    Build::select_provider<SelectedEvaluateBytes, CheckedEvaluateBytes>(builder, windows_x86_64);

    Build::application(builder, "readonly_byte_pool_relocation_bound_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
