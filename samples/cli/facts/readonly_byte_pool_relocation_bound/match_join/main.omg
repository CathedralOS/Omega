// Fact: a read-only byte-pool slice literal ("omega") establishes a static 5-byte length bound (bytes.len >= 5u64 && bytes.len <= 5u64), proving safe indexed byte projection bytes[4u64] and exact length subtraction bytes.len - 5u64 across all nine places.
// Place: match join. Branches of a pattern match evaluate the slice literal and join before inspection.
// Expected exit: 0

machine inspect_bytes(bytes: &[u8]) -> u64 crashes Trap
requires bytes.len >= 5u64 && bytes.len <= 5u64
ensures result == 0u64
{
    let b: u8 = bytes[4u64];
    let diff: u64 = bytes.len - 5u64;
    transition b == 97u8 {
        true -> ok(diff)
        _ -> bad()
    }
    state ok(d: u64) {
        d
    }
    state bad() {
        crash Trap;
    }
}

machine probe(flag: bool) -> u64 crashes Trap
ensures result == 0u64
{
    let bytes: &[u8] = match flag {
        true -> "omega",
        false -> "omega",
    };
    inspect_bytes(bytes)
}

machine main() crashes Trap {
    transition probe(true) == 0 && probe(false) == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
