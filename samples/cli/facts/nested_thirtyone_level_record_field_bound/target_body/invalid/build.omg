machine build(builder: &mut Build) {
    Build::select_provider<SelectedCheckTarget, CheckedCheckTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedCheckTarget, CheckedCheckTarget>(builder, linux_arm64);
    Build::select_provider<SelectedCheckTarget, CheckedCheckTarget>(builder, macos_arm64);
    Build::select_provider<SelectedCheckTarget, CheckedCheckTarget>(builder, windows_x86_64);

    Build::application(builder, "nested_thirtyone_level_record_field_bound");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
