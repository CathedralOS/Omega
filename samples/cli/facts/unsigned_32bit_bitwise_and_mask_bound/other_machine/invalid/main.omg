// Fact: 32-bit unsigned bitwise AND mask raw & 63u32 with bounded interval 40u32 <= masked <= 63u32 establishes 40u32 <= masked <= 63u32 across all nine places so exact subtractions 63u32 - masked and masked - 40u32 are safe.
// Place: another machine. An intermediate machine forwards the bounded 32-bit operand and mask to the mask machine.
// Invalid: mask widened to 127u32, allowing masked value to exceed 63u32 and underflowing subtraction 63u32 - masked.
// Expected exit: 0

machine perform_mask(raw: u32, mask: u32) -> i32
requires raw >= 116u32 && raw <= 116u32 && mask == 127u32
{
    let masked: u32 = raw & mask;
    let check: u32 = (63u32 - masked) + (masked - 40u32) - 23u32;
    transition masked == 52u32 && check == 0u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine forward(raw: u32, mask: u32) -> i32
requires raw >= 116u32 && raw <= 116u32 && mask == 127u32
{
    perform_mask(raw, mask)
}

machine probe() -> i32 {
    forward(116u32, 127u32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
