// Fact: 32-bit unsigned bitwise AND mask raw & 63u32 with bounded interval 40u32 <= masked <= 63u32 establishes 40u32 <= masked <= 63u32 across all nine places so exact subtractions 63u32 - masked and masked - 40u32 are safe.
// Place: another state. A successor state receives the bounded 32-bit operand and mask before bitwise AND mask and subtraction.
// Expected exit: 0

machine mask_state(raw: u32, mask: u32) -> i32
requires raw >= 116u32 && raw <= 116u32 && mask == 63u32
{
    transition {
        _ -> step(raw, mask)
    }
    machine step(r: u32, m: u32) -> i32
    requires r >= 116u32 && r <= 116u32 && m == 63u32
    {
        let masked: u32 = r & m;
        let check: u32 = (63u32 - masked) + (masked - 40u32) - 23u32;
        transition masked == 52u32 && check == 0u32 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine probe() -> i32 {
    mask_state(116u32, 63u32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
