// A match on one evaluation of a copyable flag selects a subrange of the chosen descriptor payload, the join records that selected range, and the consumer writes 41 through the first element of that recorded range, leaving the unselected payload unchanged.
// Place: target_body.
// Expected exit: 0
data Slot { case Absent; case Present(value: [i64; 4]); }

machine choose(counter: @mutable u64) -> bool
requires $counter == 0
{
    $counter = 1;
    true
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches none crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedApply {
    machine apply(chosen: @mutable Slot, other: @mutable Slot, visits: @mutable u64) -> i64 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires chosen in Slot::Present, other in Slot::Present, $visits == 0;
}
X86Apply satisfies SelectedApply {
    machine apply(chosen: @mutable Slot, other: @mutable Slot, visits: @mutable u64) -> i64 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires chosen in Slot::Present, other in Slot::Present, $visits == 0
    {
        SelectedBodyCheck::require_tag(17u64);
        let selected: @mutable [i64] = match choose(visits) {
            true -> @mutable chosen.value[0..2],
            false -> @mutable other.value[2..4]
        };
        selected[0] = 41;
        selected[0]
    }
}
ArmApply satisfies SelectedApply {
    machine apply(chosen: @mutable Slot, other: @mutable Slot, visits: @mutable u64) -> i64 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires chosen in Slot::Present, other in Slot::Present, $visits == 0
    {
        SelectedBodyCheck::require_tag(29u64);
        let selected: @mutable [i64] = match choose(visits) {
            true -> @mutable chosen.value[0..2],
            false -> @mutable other.value[2..4]
        };
        selected[0] = 41;
        selected[0]
    }
}


machine main() crashes Trap {
    let mutable chosen: Slot = Slot::Present { value: [17, 0, 5, 6] };
    let mutable other: Slot = Slot::Present { value: [0, 0, 8, 9] };
    let mutable visits: u64 = 0;
    let observed: i64 = SelectedApply::apply(@mutable chosen, @mutable other, @mutable visits);
    transition observed == 41 && visits == 1 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
