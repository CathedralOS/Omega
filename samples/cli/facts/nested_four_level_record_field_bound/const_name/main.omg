// Fact: a 4-level nested structural record RootRec { outer: Outer { mid: Middle { inner: Inner { val: u64 } } } } preserves the leaf field bound 40u64 <= root.outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: const_name. The nested record is bound to a constant name before projecting and checking bounds.
// Expected exit: 0

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

data RootRec [copy] {
    outer: Outer;
}

const ROOT: RootRec = RootRec {
    outer: Outer {
        mid: Middle {
            inner: Inner {
                val: 60u64,
            },
        },
    },
};

machine compute_const() -> i32 {
    let res: u64 = ROOT.outer.mid.inner.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    0i32
}

machine probe() -> i32 {
    compute_const()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
