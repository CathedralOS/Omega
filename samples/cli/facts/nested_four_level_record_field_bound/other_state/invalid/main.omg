// Fact: a 4-level nested structural record RootRec { outer: Outer { mid: Middle { inner: Inner { val: u64 } } } } preserves the leaf field bound 40u64 <= root.outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Invalid: upper bound 81 allows res 81, causing 80u64 - res to underflow. Place: other_state.
// Expected diagnostic: may overflow `u64`

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

data RootRec [copy] {
    outer: Outer;
}

machine verify_state(r: RootRec) -> i32
requires r.outer.mid.inner.val >= 40u64 && r.outer.mid.inner.val <= 81u64
{
    transition {
        _ -> step(r)
    }
    machine step(root: RootRec) -> i32
    requires root.outer.mid.inner.val >= 40u64 && root.outer.mid.inner.val <= 81u64
    {
        let res: u64 = root.outer.mid.inner.val;
        let headroom: u64 = 80u64 - res;
        let margin: u64 = res - 40u64;
        0i32
    }
}

machine probe() -> i32 {
    let r: RootRec = RootRec {
        outer: Outer {
            mid: Middle {
                inner: Inner {
                    val: 60u64,
                },
            },
        },
    };
    verify_state(r)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
