// A scalar store of zero through the u32 view restores Pair.start and its mixed parent predicate before returning the parent.
// Expected exit: 0
public data Pair [copy]
requires self.start >= 0 && self.start <= self.end,
{
    before: u32;
    start: i32;
    end: i32;
    after: u32;
    marker: u32;
    origin: u32;
}
public boundary trait RestorationValue {
    machine identity(value: u32) -> u32
    ensures result == value
    reaches none crashes none;
}
SelectedRestoration satisfies RestorationValue {
    machine identity(value: u32) -> u32 ensures result == value { value }
}
machine retain_view<'storage>(view: @'storage mutable u32) -> @'storage mutable u32 { view }
machine restore(view: @mutable u32, replacement: u32)
ensures $view == replacement,
{ $view = 0xFFFFFFFFu32; $view = replacement; }
public machine inspect(pair: @mutable Pair)
invokes RestorationValue
{
    let replacement: u32 = RestorationValue::identity(0xFFFFFFFFu32);
    pair.marker = 11;
    let formed: @mutable u32 = @mutable pair.start as @mutable u32;
    let view: @mutable u32 = retain_view(formed);
    restore(@mutable view, replacement);
    pair.end = 10;
}
machine main() crashes Trap invokes RestorationValue {
    let mutable first: Pair = Pair { before: 0x13579BDF, start: 3, end: 10, after: 0x2468ACE0, marker: 0, origin: 11 };
    inspect(@mutable first);
    let mutable second: Pair = Pair { before: 0x13579BDF, start: 5, end: 10, after: 0x2468ACE0, marker: 0, origin: 13 };
    inspect(@mutable second);
    transition first.start == 0 && first.end == 10 && first.marker == 11 && first.origin == 11
        && second.start == 0 && second.end == 10 && second.marker == 11 && second.origin == 13
        && first.before == 0x13579BDF && first.after == 0x2468ACE0
        && second.before == 0x13579BDF && second.after == 0x2468ACE0 {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
