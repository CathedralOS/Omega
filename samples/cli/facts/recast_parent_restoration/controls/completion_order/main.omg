// A scalar store of zero through the u32 view restores Pair.start and its mixed parent predicate before returning the parent.
// Expected exit: 0
public data Pair [copy]
requires self.start >= 0 && self.start <= self.end,
{
    before: u32;
    start: i32;
    end: i32;
    after: u32;
    marker: u32;
    origin: u32;
}
machine retain_view<'storage>(view: &'storage mut u32) -> &'storage mut u32 { view }
machine earlier(view: &mut u32, marker: &mut u32, replacement: u32) -> u32
ensures view == replacement && marker == 17 && result == 17,
{ view = 0xFFFFFFFFu32; view = replacement; marker = 17; 17 }
machine later(view: &mut u32, marker: &mut u32) -> u32
requires marker == 17,
ensures view == 0 && marker == 23 && result == 23,
{ view = 0; marker = marker + 6; 23 }
machine combine(first: u32, second: u32) -> u32
requires first == 17 && second == 23,
ensures result == 40,
{ first + second }
public machine inspect(pair: &mut Pair) -> u32
{
    let replacement: u32 = 0u32;
    pair.marker = 11;
    let formed: &mut u32 = &mut pair.start as &mut u32;
    let view: &mut u32 = retain_view(formed);
    let event: u32 = combine(earlier(&mut view, &mut pair.marker, replacement), later(&mut view, &mut pair.marker));
    pair.end = 10;
    event
}
machine main() crashes Trap {
    let mut first: Pair = Pair { before: 0x13579BDF, start: 3, end: 10, after: 0x2468ACE0, marker: 0, origin: 11 };
    let first_event: u32 = inspect(&mut first);
    let mut second: Pair = Pair { before: 0x13579BDF, start: 5, end: 10, after: 0x2468ACE0, marker: 0, origin: 13 };
    let second_event: u32 = inspect(&mut second);
    transition first_event == 40 && second_event == 40 && first.start == 0 && first.end == 10 && first.marker == 23 && first.origin == 11
        && second.start == 0 && second.end == 10 && second.marker == 23 && second.origin == 13
        && first.before == 0x13579BDF && first.after == 0x2468ACE0
        && second.before == 0x13579BDF && second.after == 0x2468ACE0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
