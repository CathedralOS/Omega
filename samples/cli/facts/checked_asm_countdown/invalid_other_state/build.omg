use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "checked_asm_countdown_other_state" };
    Build::select_provider::<|app|::Countdown, |app|::X86Countdown>(builder, linux_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::X86Countdown>(builder, windows_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::X86Countdown>(builder, macos_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::ArmCountdown>(builder, linux_arm64);
    Build::select_provider::<|app|::Countdown, |app|::ArmCountdown>(builder, macos_arm64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
