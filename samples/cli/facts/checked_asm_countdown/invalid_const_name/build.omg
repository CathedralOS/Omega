machine build(builder: &mut Build) {
    Build::application(builder, "checked_asm_countdown_const_name");
    Build::select_provider<Countdown, X86Countdown>(builder, linux_x86_64);
    Build::select_provider<Countdown, X86Countdown>(builder, windows_x86_64);
    Build::select_provider<Countdown, X86Countdown>(builder, macos_x86_64);
    Build::select_provider<Countdown, ArmCountdown>(builder, linux_arm64);
    Build::select_provider<Countdown, ArmCountdown>(builder, macos_arm64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
