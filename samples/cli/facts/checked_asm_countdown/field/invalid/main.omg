// Expected exit: 0.
// The checked seed-2 mov/sub/jnz CFG falls through with eax == 0 and stores output == 0.
data Seed { value: u32; }
machine main() crashes Trap {
 let seed: Seed = Seed { value: 2 };
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed.value;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 1:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 state done() {}
 state bad() { crash Trap; }
}
