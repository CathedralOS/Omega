machine build(builder: &mut Build) {
    Build::application(builder, "checked_asm_countdown_target_body");
    Build::select_provider<Countdown, X86Countdown>(builder, linux_x86_64);
    Build::select_provider<Countdown, X86Countdown>(builder, windows_x86_64);
    Build::select_provider<Countdown, X86Countdown>(builder, macos_x86_64);
    Build::select_provider<Countdown, ArmCountdown>(builder, linux_arm64);
    Build::select_provider<Countdown, ArmCountdown>(builder, macos_arm64);
    Build::select_provider<ForwardCountdown, X86ForwardCountdown>(builder, linux_x86_64);
    Build::select_provider<ForwardCountdown, X86ForwardCountdown>(builder, windows_x86_64);
    Build::select_provider<ForwardCountdown, X86ForwardCountdown>(builder, macos_x86_64);
    Build::select_provider<ForwardCountdown, ArmForwardCountdown>(builder, linux_arm64);
    Build::select_provider<ForwardCountdown, ArmForwardCountdown>(builder, macos_arm64);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
}
