// Expected exit: 0.
// The checked seed-2 mov/sub/jnz CFG falls through with eax == 0 and stores output == 0.
boundary trait Countdown {
    machine run(seed: u32) -> u32 reaches requires seed == 2 ensures result == 0;
}

X86Countdown satisfies Countdown {
    machine run(seed: u32) -> u32 requires seed == 2 ensures result == 0 {
        let mut output: u32 = 99;
        asm where clobbers rax, rflags {
        entry:
            mov eax, seed;
            jmp loop;
        loop requires eax > 0:
            sub eax, 1;
            jnz loop;
        done requires eax == 1 ensures output == 0:
            mov output, eax
        }
        output
    }
}

ArmCountdown satisfies Countdown {
    machine run(seed: u32) -> u32 requires seed == 2 ensures result == 0 {
        let mut output: u32 = 99;
        asm where clobbers x0, x1, nzcv {
        entry:
            mov w0, seed;
            b loop;
        loop requires w0 > 0:
            subs w1, w0, 1;
            mov w0, w1;
            b.ne loop;
        done requires w0 == 1 ensures output == 0:
            mov output, w0
        }
        output
    }
}

boundary trait ForwardCountdown {
    machine run(seed: u32, expected_tag: u32) -> u32 reaches Countdown crashes Trap requires seed == 2 ensures result == 0;
}

X86ForwardCountdown satisfies ForwardCountdown {
    machine run(seed: u32, expected_tag: u32) -> u32 reaches Countdown crashes Trap requires seed == 2 ensures result == 0 {
        transition expected_tag == 17 { true -> selected(seed) false -> wrong_body() }
        machine selected(value: u32) -> u32 requires value == 2 ensures result == 0 { Countdown::run(value) }
        machine wrong_body() -> u32 { crash Trap; }
    }
}

ArmForwardCountdown satisfies ForwardCountdown {
    machine run(seed: u32, expected_tag: u32) -> u32 reaches Countdown crashes Trap requires seed == 2 ensures result == 0 {
        transition expected_tag == 29 { true -> selected(seed) false -> wrong_body() }
        machine selected(value: u32) -> u32 requires value == 2 ensures result == 0 { Countdown::run(value) }
        machine wrong_body() -> u32 { crash Trap; }
    }
}

machine finished() {}
machine failed() crashes Trap { crash Trap; }
machine observe_zero(value: u32) crashes Trap requires value == 0 {
    transition value == 0 { true -> finished() false -> failed() }
}
machine journey(expected_tag: u32) crashes Trap {
    let value: u32 = ForwardCountdown::run(2, expected_tag);
    observe_zero(value);
}

machine x86_entry() crashes Trap { journey(17); }
machine arm_entry() crashes Trap { journey(29); }
