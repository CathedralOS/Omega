use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "checked_asm_countdown_target_body" };
    Build::select_provider::<|app|::Countdown, |app|::X86Countdown>(builder, linux_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::X86Countdown>(builder, windows_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::X86Countdown>(builder, macos_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::ArmCountdown>(builder, linux_arm64);
    Build::select_provider::<|app|::Countdown, |app|::ArmCountdown>(builder, macos_arm64);
    Build::select_provider::<|app|::ForwardCountdown, |app|::X86ForwardCountdown>(builder, linux_x86_64);
    Build::select_provider::<|app|::ForwardCountdown, |app|::X86ForwardCountdown>(builder, windows_x86_64);
    Build::select_provider::<|app|::ForwardCountdown, |app|::X86ForwardCountdown>(builder, macos_x86_64);
    Build::select_provider::<|app|::ForwardCountdown, |app|::ArmForwardCountdown>(builder, linux_arm64);
    Build::select_provider::<|app|::ForwardCountdown, |app|::ArmForwardCountdown>(builder, macos_arm64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::arm_entry);
}
