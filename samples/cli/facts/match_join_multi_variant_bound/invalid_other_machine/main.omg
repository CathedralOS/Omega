// Exhaustively matching a three-variant case value where every arm establishes joined >= 20u64 && joined <= 60u64 preserves the joined interval bound across all nine places, discharging exact subtraction 60u64 - joined and joined - 20u64.
// Invalid: High variant allows val <= 61, widening the joined bound to [20, 61] and failing 60u64 - joined in runner.

data Mode [copy] 
    requires ((self in Mode::Low) && (self.val >= 20 && self.val <= 60)) || ((self in Mode::Mid) && (self.val >= 20 && self.val <= 60)) || ((self in Mode::High) && (self.val >= 20 && self.val <= 61))
{
    case Low(val: u64);
    case Mid(val: u64);
    case High(val: u64);
}

machine compute_joined(mode: Mode) -> u64 {
    transition mode {
        Mode::Low { val } -> val
        Mode::Mid { val } -> val
        Mode::High { val } -> val
    }
}

machine runner(mode: Mode) -> u64 {
    let joined: u64 = compute_joined(mode);
    let diff1: u64 = 60u64 - joined;
    let diff2: u64 = joined - 20u64;
    diff1 + diff2
}

machine main() crashes Trap {
    let m: Mode = Mode::Mid { val: 40 };
    let sum: u64 = runner(m);
    transition sum == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
