// Exhaustively matching a three-variant case value where every arm establishes joined >= 20u64 && joined <= 60u64 preserves the joined interval bound across all nine places, discharging exact subtraction 60u64 - joined and joined - 20u64.
// Invalid: High variant allows val <= 61, widening the joined bound to [20, 61] and failing 60u64 - joined.

data Mode [copy] 
    requires ((self in Mode::Low) && (self.val >= 20 && self.val <= 60)) || ((self in Mode::Mid) && (self.val >= 20 && self.val <= 60)) || ((self in Mode::High) && (self.val >= 20 && self.val <= 61))
{
    case Low(val: u64);
    case Mid(val: u64);
    case High(val: u64);
}

machine evaluate(mode: Mode) -> u64 {
    transition mode {
        Mode::Low { val } -> val
        Mode::Mid { val } -> val
        Mode::High { val } -> val
    }
}

// `run` receives `mode` as a parameter, so the payload is known only through
// `Mode`'s requirement; the operation below must use the joined bound.
machine run(mode: Mode) crashes Trap {
    let joined: u64 = match true {
        true -> evaluate(mode)
        _ -> evaluate(mode)
    };
    let diff1: u64 = 60u64 - joined;
    let diff2: u64 = joined - 20u64;
    transition diff1 == 20 && diff2 == 20 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    run(Mode::Mid { val: 40 });
}
