// Fact: exiting a ranked state-transition loop under a terminal guard (remaining <= 60u64) preserves the loop-exit bound across all nine places, discharging exact subtraction 60u64 - remaining with exit code 0.
// Place: other_state. A successor state transition carries the loop-exit value to subtraction.
// Expected exit: 0

machine ranked_loop(current: u64) -> u64
requires current <= 100 && current >= 20
terminates by current;
ensures result <= 60
{
    transition current <= 60 {
        true -> done(current)
        false -> step(current)
    }

    machine step(c: u64) -> u64
    requires c <= 100 && c > 60
    {
        let next: u64 = c - 10;
        transition next <= 60 {
            true -> done(next)
            false -> step(next)
        }
    }

    machine done(rem: u64) -> u64
    requires rem <= 60
    {
        rem
    }
}

machine probe() -> i32 {
    transition {
        _ -> step(ranked_loop(100u64))
    }
    machine step(rem: u64) -> i32
    requires rem <= 60
    {
        let diff: u64 = 60u64 - rem;
        diff as i32
    }
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
