// A fresh request's zero field survives transport to the static boundary call's precondition.
// Expected exit: 0
data Request { internal: u64; }
const ZERO: u64 = 0;
boundary trait Io { machine acquire(request: &mut Request) -> i32 reaches requires request.internal == ZERO; }
Actual satisfies Io { machine acquire(request: &mut Request) -> i32 requires request.internal == ZERO { request.internal = 9; 7 } }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedTransport {
    machine transport(request: &mut Request) -> i32 requires request.internal == ZERO reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Io crashes Trap;
}
X86Transport satisfies SelectedTransport {
    machine transport(request: &mut Request) -> i32 requires request.internal == ZERO reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Io crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);     Io::acquire(request)
    }
}
ArmTransport satisfies SelectedTransport {
    machine transport(request: &mut Request) -> i32 requires request.internal == ZERO reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Io crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);     Io::acquire(request)
    }
}

machine main() crashes Trap {
    let mut request: Request;
    request.internal = 1;
    let status: i32 = SelectedTransport::transport(&mut request);
    transition status == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
