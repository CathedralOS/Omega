// A selected implementation returns one of its Utf8 inputs, and the returned view keeps the Utf8 membership its consumer requires.
// Place: target body; a Build-selected implementation returns the selected row's view.
// Reject twin: the requirement no longer promises Utf8 on its returned view.
public domain [u8]::Utf8 requires valid_utf8(self);
trait Payload {
    machine window<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8) -> &'input [u8];
}
First satisfies Payload {
    machine window<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8) -> &'input [u8] {
        let bytes: &'input [u8] in Utf8 = first;
        bytes
    }
}
Second satisfies Payload {
    machine window<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8) -> &'input [u8] {
        let bytes: &'input [u8] in Utf8 = second;
        bytes
    }
}
boundary trait Reader {
    machine read<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8, decoder: dyn Payload) -> &'input [u8] in Utf8 reaches;
}
Selected satisfies Reader {
    machine read<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8, decoder: dyn Payload) -> &'input [u8] in Utf8 {
        let bytes: &'input [u8] in Utf8 = Payload::window(decoder, first, second);
        bytes
    }
}
machine classify(bytes: &[u8] in Utf8) -> u64 {
    match bytes == "abc" {
        true -> 3
        false -> accented(bytes)
    }
}
machine accented(bytes: &[u8]) -> u64 {
    match bytes == "é" {
        true -> 2
        false -> 9
    }
}
machine main() crashes Trap {
    let accent: &[u8] in Utf8 = "é";
    let word: &[u8] in Utf8 = "abc";
    let first: u64 = classify(Reader::read(accent, word, First as dyn Payload));
    let second: u64 = classify(Reader::read(accent, word, Second as dyn Payload));
    transition first == 2 && second == 3 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
