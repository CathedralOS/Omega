// A selected open index operation records the distributivity law its trait declares, so a
// generic body takes a value indexed `A * (B + C)` as `A * B + A * C`, and the call records
// that identity.
// Control: the product's trait names a requirement `add`, and the selected `+` is the
// requirement of another trait with the same name. The evidence is the shared trait and
// provider, never the name, so nothing expands and the body is rejected.
// Expected: rejected.
domain<T, const I: u64> T::Indexed<I>;

trait IndexProduct {
    machine add(a: u64, b: u64) -> u64 terminates;
    machine * multiply(a: u64, b: u64) -> u64 terminates;
    machine distribute(a: u64, b: u64, c: u64)
    ensures multiply(a, add(b, c)) == add(multiply(a, b), multiply(a, c));
}

trait IndexSum {
    machine + add(a: u64, b: u64) -> u64 terminates;
}

machine product_add(a: u64, b: u64) -> u64
satisfies IndexProduct::add as Product
ensures result == 3
{
    transition { _ -> 3 }
}

machine product_multiply(a: u64, b: u64) -> u64
satisfies IndexProduct::multiply as Product
ensures result == 3
{
    transition { _ -> 3 }
}

machine product_distribute(a: u64, b: u64, c: u64)
satisfies IndexProduct::distribute as Product
requires product_multiply(a, product_add(b, c)) == product_add(product_multiply(a, b), product_multiply(a, c))
ensures product_multiply(a, product_add(b, c)) == product_add(product_multiply(a, b), product_multiply(a, c))
{
}

Product satisfies IndexProduct
{
    machine add(a: u64, b: u64) -> u64
    terminates {
        product_add(a, b)
    }
    machine multiply(a: u64, b: u64) -> u64
    terminates {
        product_multiply(a, b)
    }
    machine distribute(a: u64, b: u64, c: u64)
    ensures product_multiply(a, product_add(b, c)) == product_add(product_multiply(a, b), product_multiply(a, c)) {
        product_distribute(a, b, c);
    }
}

machine sum_add(a: u64, b: u64) -> u64
satisfies IndexSum::add as Total
ensures result == 3
{
    transition { _ -> 3 }
}

Total satisfies IndexSum
{
    machine add(a: u64, b: u64) -> u64
    terminates {
        sum_add(a, b)
    }
}

machine rearrange<const A: u64, const B: u64, const C: u64, Multiplication satisfies IndexProduct, Addition satisfies IndexSum>(
    raw: i64
) -> i64 {
    let source: i64 in Indexed<A * (B + C)> = raw as i64 in Indexed<A * (B + C)>;
    let moved: i64 in Indexed<A * B + A * C> = source;
    moved as i64
}

machine main() crashes Trap {
    let moved: i64 = rearrange<2, 3, 4, Product, Total>(41);
    transition moved == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
