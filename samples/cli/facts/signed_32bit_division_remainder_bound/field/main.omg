// Fact: a 32-bit signed i32 remainder operation (dividend % divisor where dividend >= 0i32 && dividend <= 100i32, divisor >= 16i32 && divisor <= 16i32) establishes rem >= 0i32 && rem <= 15i32 so exact 32-bit signed subtraction 15i32 - rem is proved overflow-free across all nine places.
// Place: field. A record field carries the 32-bit remainder into the subtraction contract.
// Expected exit: 0

data RemResult {
    rem: i32;
}

machine verify_rem(rem: i32) -> i32
requires rem >= 0i32 && rem <= 15i32
{
    let headroom: i32 = 15i32 - rem;
    0i32
}

machine compute_field(dividend: i32, divisor: i32) -> i32
requires dividend >= 0i32 && dividend <= 100i32 && divisor >= 16i32 && divisor <= 16i32
{
    let holder: RemResult = RemResult { rem: dividend % divisor };
    verify_rem(holder.rem)
}

machine probe() -> i32 {
    compute_field(43i32, 16i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
