// Fact: a 32-bit signed i32 remainder operation (dividend % divisor where dividend >= 0i32 && dividend <= 100i32, divisor >= 16i32 && divisor <= 16i32) establishes rem >= 0i32 && rem <= 15i32 so exact 32-bit signed subtraction 15i32 - rem is proved overflow-free across all nine places.
// Invalid: widening divisor <= 17i32 allows rem 16i32, violating verify_rem contract. Place: local.
// Expected diagnostic: cannot prove requires contract for call verify_rem

machine verify_rem(rem: i32) -> i32
requires rem >= 0i32 && rem <= 15i32
{
    let headroom: i32 = 15i32 - rem;
    0i32
}

machine compute_local(dividend: i32, divisor: i32) -> i32
requires dividend >= 0i32 && dividend <= 100i32 && divisor >= 16i32 && divisor <= 17i32
{
    let r: i32 = dividend % divisor;
    let rem: i32 = r;
    verify_rem(rem)
}

machine probe() -> i32 {
    compute_local(43i32, 16i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
