// Fact: a checked view of an entry i32 equal to 1065353216, read as f32, discharges maybe_zero's value == 0.0 Trap crash guard without a caller crash ceiling.
// Expected exit: 0
machine maybe_zero(value: f32) -> f32
crashes Trap value == 0.0
{
    transition value == 0.0 { true -> bad() false -> (value) }
    machine bad() -> f32 { crash Trap; }
}
machine identity(value: f32) -> f32 { value }
public machine read_bits(value: i32) -> f32
requires value == 1065353216
{
    let view: &f32 = &value as &f32;
    let viewed: f32 = view;
    let observed: f32 = identity(viewed);
    maybe_zero(observed)
}
machine main() crashes Trap {
    let observed: f32 = read_bits(1065353216);
    transition observed == 1.0 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
