// Fact: 8-bit signed exact subtraction lhs - rhs with 60i8 <= lhs <= 100i8 and 10i8 <= rhs <= 20i8 establishes 40i8 <= diff <= 90i8 so 90i8 - diff and diff - 40i8 are safe.
// Invalid: widened rhs upper bound produces diff down to 35i8, failing verify_diff requires contract.

machine compute_diff(lhs: i8, rhs: i8) -> i8
    requires lhs >= 60 && lhs <= 100, rhs >= 10 && rhs <= 25
{
    lhs - rhs
}

machine verify_diff(diff: i8) -> i32
    requires diff >= 40 && diff <= 90
{
    let headroom: i8 = 90 - diff;
    let margin: i8 = diff - 40;
    let sum: i8 = headroom + margin;
    let check: i8 = sum - 50;
    check as i32
}

const LHS: i8 = 60;
const RHS: i8 = 25;

machine main() crashes Trap {
    let diff: i8 = compute_diff(LHS, RHS);
    let check: i32 = verify_diff(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
