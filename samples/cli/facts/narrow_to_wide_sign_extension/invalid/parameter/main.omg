// Fact: narrow-to-wide sign-extending -25i8, -35i16, and 160i32 to i64 yields 100u64 when subtracting 100u64.
// Place: parameter (invalid twin). Initial signed value is -26i8 resulting in 99u64, which underflows exact subtraction extended - 100u64.
// Expected diagnostic: exact subtraction underflow
machine pass_through(param: u64) -> u64
    ensures result == param
{
    param
}

machine evaluate() -> i32 {
    let s8: i64 = -26i8 as i64;
    let s16: i64 = -35i16 as i64;
    let s32: i64 = 160i32 as i64;
    let sum: i64 = s8 + s16 + s32;
    let extended: u64 = pass_through(sum as u64);
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
