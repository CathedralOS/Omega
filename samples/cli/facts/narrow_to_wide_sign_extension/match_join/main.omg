// Fact: narrow-to-wide sign-extending -25i8, -35i16, and 160i32 to i64 yields 100u64 when subtracting 100u64.
// Place: match_join. Both arms produce the narrow-to-wide sign-extended sum so the joined value preserves exact subtraction.
// Expected exit: 0
machine evaluate(flag: bool) -> i32 {
    let s8: i64 = -25i8 as i64;
    let s16: i64 = -35i16 as i64;
    let s32: i64 = 160i32 as i64;
    let sum: i64 = s8 + s16 + s32;
    let val: u64 = sum as u64;
    let extended: u64 = match flag {
        true -> val
        false -> val
    };
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate(true);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
