// A selected predicate-domain match arm establishes value >= 73, and the joined value discharges value - 73.
// Expected exit: 0

data Cell [copy] { value: u64; }
domain Cell::Ready(cell)
requires cell.value >= 73u64;

machine generic_ready<Value>(cell: Value) -> bool
where Value == &write Cell
{ cell in Cell::Ready }

machine consume(cell: &Cell) -> u64 {
    let selected: u64 = match cell {
        Cell::Ready -> cell.value
        _ -> 73u64
    };
    selected - 73u64
}

machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 73u64 };
    let difference: u64 = consume(&cell);
    let tested: bool = true;
    transition difference == 0u64 && tested {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
