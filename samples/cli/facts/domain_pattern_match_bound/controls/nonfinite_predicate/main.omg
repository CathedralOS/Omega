// A selected predicate-domain match arm establishes value >= 73, and the joined value discharges value - 73.
// Expected exit: 0

machine undecidable(value: u64) -> bool crashes Trap { crash Trap; }

data Cell [copy] { value: u64; }
domain Cell::Ready(cell)
requires undecidable(cell.value);

machine consume(cell: &Cell) -> u64 crashes Trap {
    let selected: u64 = match cell {
        Cell::Ready -> 0u64
        _ -> 0u64
    };
    selected
}

machine main() crashes Trap {
    let cell: Cell = Cell { value: 73u64 };
    let difference: u64 = consume(&cell);
    transition difference == 0u64 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
