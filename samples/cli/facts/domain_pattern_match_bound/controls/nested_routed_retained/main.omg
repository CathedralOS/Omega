// A selected predicate-domain match arm establishes value >= 73, and the joined value discharges value - 73.
// Expected exit: 0

data Cell [copy] { value: u64; }
domain Cell::Ready(cell)
requires cell.value >= 73u64
established by issue;

domain Cell::Nested(cell)
requires cell in Cell::Ready;

machine issue(value: u64) -> Cell in Cell::Ready
requires value >= 73u64
{ Cell { value: value } }

machine consume(cell: &Cell in Cell::Ready) -> u64 {
    let selected: u64 = match cell {
        Cell::Nested -> cell.value
        _ -> 73u64
    };
    selected - 73u64
}

machine main() crashes Trap {
    let cell: Cell in Cell::Ready = issue(73u64);
    let difference: u64 = consume(&cell);
    transition difference == 0u64 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
