// A selected predicate-domain match arm establishes value >= 73, and the joined value discharges value - 73.
// Expected exit: 0

data Cell [copy] { value: u64; }
domain Cell::Ready(cell)
requires cell.value >= 73u64;

machine select(cell: &Cell) -> u64
ensures result >= 73u64
{
    match cell {
        Cell::Ready -> cell.value
        _ -> 73u64
    }
}
machine forward(cell: &Cell) -> u64
ensures result >= 73u64
{ select(cell) }
machine consume(cell: &Cell) -> u64 {
    let selected: u64 = forward(cell);
    selected - 73u64
}
machine main() crashes Trap {
    let ready: Cell = Cell { value: 90u64 };
    let fallback: Cell = Cell { value: 12u64 };
    let matched: u64 = consume(&ready);
    let defaulted: u64 = consume(&fallback);
    transition matched == 17u64 && defaulted == 0u64 {
        true -> done()
        false -> wrong()
    }
}
machine done() {}
machine wrong() crashes Trap { crash Trap; }
