// Fact: projecting a nested inner record field through a shared borrow preserves its exact static upper bound without moving either record, discharging exact subtraction 72u64 - quota across all nine places.
// Place: field (invalid twin). Inner field bound is widened to quota <= 73, so exact subtraction 72u64 - quota may underflow.
// Expected diagnostic: exact subtraction underflow
data Inner where quota <= 73, {
    quota: u64;
    tag: u64;
}

data Outer {
    inner: Inner;
    header: u64;
}

data Carrier {
    view: &Outer;
}

machine evaluate() -> u64 {
    let outer: Outer = Outer {
        inner: Inner { quota: 30, tag: 7 },
        header: 10,
    };
    let carrier: Carrier = Carrier { view: &outer };
    let quota: u64 = carrier.view.inner.quota;
    let diff: u64 = 72u64 - quota;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate();
    transition diff == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
