// Fact: projecting a nested inner record field through a shared borrow preserves its exact static upper bound without moving either record, discharging exact subtraction 72u64 - quota across all nine places.
// Place: local. The shared borrow is held in a local binding, copied to a second local, and projected there.
// Expected exit: 0
data Inner where quota <= 72, {
    quota: u64;
    tag: u64;
}

data Outer {
    inner: Inner;
    header: u64;
}

machine evaluate() -> u64 {
    let outer: Outer = Outer {
        inner: Inner { quota: 30, tag: 7 },
        header: 10,
    };
    let view: &Outer = &outer;
    let child_view: &Outer = view;
    let quota: u64 = child_view.inner.quota;
    let diff: u64 = 72u64 - quota;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate();
    transition diff == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
