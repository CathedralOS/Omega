// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Invalid: target bodies bound is weakened to 399..399, so 399 >> 2 == 99 underflows shifted - 100.
// Expected rejection: exact arithmetic in machine `shift_right_target` state `entry` terminal expression may overflow `u64`.

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedShiftRightTarget {
    machine shift_right_target(val: u64, shift: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 399 && val <= 399 && shift >= 2 && shift <= 2 ensures result == 0;
}

X86ShiftRightTarget satisfies SelectedShiftRightTarget {
    machine shift_right_target(val: u64, shift: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 399 && val <= 399 && shift >= 2 && shift <= 2 ensures result == 0
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: u64 = val >> shift;
        shifted - 100
    }
}

ArmShiftRightTarget satisfies SelectedShiftRightTarget {
    machine shift_right_target(val: u64, shift: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 399 && val <= 399 && shift >= 2 && shift <= 2 ensures result == 0
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: u64 = val >> shift;
        shifted - 100
    }
}

machine probe(val: u64, shift: u64) -> u64
requires val >= 399 && val <= 399 && shift >= 2 && shift <= 2
ensures result == 0
{
    SelectedShiftRightTarget::shift_right_target(val, shift)
}

machine main() crashes Trap {
    let res: u64 = probe(399, 2);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
