// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Place: call result. Calls with declared bounds supply both operands to the shift.
// Expected exit: 0

machine supply_val() -> u64
ensures result >= 400 && result <= 400
{
    400
}

machine supply_shift() -> u64
ensures result >= 2 && result <= 2
{
    2
}

machine shift_right_call_result() -> u64
ensures result == 0
{
    let val: u64 = supply_val();
    let shift: u64 = supply_shift();
    let shifted: u64 = val >> shift;
    shifted - 100
}

machine main() crashes Trap {
    let res: u64 = shift_right_call_result();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
