// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Place: other state. A transition forwards the bounded operands to a successor state.
// Expected exit: 0

machine main() crashes Trap {
    transition 400 >= 400 && 400 <= 400 && 2 >= 2 && 2 <= 2 {
        true -> compute(400, 2)
        _ -> bad()
    }

    state compute(val: u64, shift: u64)
    requires val >= 400 && val <= 400 && shift >= 2 && shift <= 2
    {
        let shifted: u64 = val >> shift;
        let res: u64 = shifted - 100;
        transition res == 0 {
            true -> done()
            _ -> bad()
        }
    }

    state done() {}
    state bad() { crash Trap; }
}
