// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Invalid: named constant is weakened to 399, so 399 >> 2 == 99 underflows shifted - 100.
// Expected rejection: exact arithmetic in machine `shift_right_const` state `entry` terminal expression may overflow `u64`.

const BASE_VAL: u64 = 399;
const SHIFT_AMT: u64 = 2;

machine shift_right_const() -> u64
ensures result == 0
{
    let shifted: u64 = BASE_VAL >> SHIFT_AMT;
    shifted - 100
}

machine main() crashes Trap {
    let res: u64 = shift_right_const();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
