// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Invalid: match arm produces 399, so joined bound allows 399 >> 2 == 99 underflowing shifted - 100.
// Expected rejection: exact arithmetic in machine `shift_right_match_join` state `entry` terminal expression may overflow `u64`.

machine shift_right_match_join(flag: bool) -> u64
ensures result == 0
{
    let val: u64 = match flag {
        true -> 400
        false -> 399
    };
    let shift: u64 = match flag {
        true -> 2
        false -> 2
    };
    let shifted: u64 = val >> shift;
    shifted - 100
}

machine main() crashes Trap {
    let res: u64 = shift_right_match_join(true);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
