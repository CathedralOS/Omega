// Inclusive f64 0.0 <= value <= 0.25 entails admit's 0.0 <= value <= 0.5.
// Reject: missing narrow upper-bound proof at admit(value).
use omega::language::core::float_operations;
data Reading [copy] where value >= 0.0 { value: f64; }
machine admit(value: f64) -> f64
requires value >= 0.0 && value <= 0.5
{ value }
boundary trait ReadingProbe {
    machine probe(reading: Reading) -> f64 reaches;
}
ArmReadingProbe satisfies ReadingProbe {
    machine probe(reading: Reading) -> f64 reaches { admit(reading.value) }
}
X86ReadingProbe satisfies ReadingProbe {
    machine probe(reading: Reading) -> f64 reaches { admit(reading.value) }
}
machine main() crashes Trap {
    let reading: Reading = Reading { value: 0.25 };
    let observed: f64 = ReadingProbe::probe(reading);
    transition observed == 0.25 { true -> done() _ -> bad() }
    machine done() { }
    machine bad() { crash Trap; }
}
