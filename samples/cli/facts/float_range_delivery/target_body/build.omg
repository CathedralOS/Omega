machine build(builder: &mut Build) {
    Build::application(builder, "float_delivery_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<ReadingProbe, X86ReadingProbe>(builder, windows_x86_64);
    Build::select_provider<ReadingProbe, X86ReadingProbe>(builder, linux_x86_64);
    Build::select_provider<ReadingProbe, ArmReadingProbe>(builder, macos_arm64);
    Build::select_provider<ReadingProbe, ArmReadingProbe>(builder, linux_arm64);
    Build::select_provider<ReadingProbe, X86ReadingProbe>(builder, macos_x86_64);
}
