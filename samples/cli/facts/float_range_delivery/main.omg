// Canonical float ranges as parameter and return contracts:
// every delivery is proven from the delivered value's facts —
// literals, a narrower declared range widening into a wider
// one, and entry contracts.
//
//   * machine admit(value: f64) -> f64 requires value >= 0.0 && value <= 0.5
//   * orward(value: f64) -> f64 requires value >= 0.0 && value <= 0.25
//     delivers to dmit — narrower contract satisfies wider.
//   * let bounded: f64 = value — local delivery.
//
// Expected exit: 0

use omega::language::core::float_operations;

machine admit(value: f64) -> f64
requires value >= 0.0 && value <= 0.5
{ value }

machine forward(value: f64) -> f64
requires value >= 0.0 && value <= 0.25
{
    let bounded: f64 = value;
    admit(bounded)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    let forwarded: f64 = forward(0.25);
    let literal: f64 = admit(0.125);
    transition forwarded == 0.25 && literal == 0.125 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
