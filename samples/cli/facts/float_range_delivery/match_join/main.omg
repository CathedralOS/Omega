// Inclusive f64 0.0 <= value <= 0.25 entails admit's 0.0 <= value <= 0.5.
// Expected exit: 0
use omega::language::core::float_operations;
data Reading [copy] where value >= 0.0 && value <= 0.25 { value: f64; }
machine admit(value: f64) -> f64
requires value >= 0.0 && value <= 0.5
{ value }
machine probe(left: Reading, right: Reading, choice: bool) -> f64 {
    let value: f64 = match choice { true -> left.value, false -> right.value };
    admit(value)
}
machine main() crashes Trap {
    let low: Reading = Reading { value: 0.125 };
    let high: Reading = Reading { value: 0.25 };
    transition probe(high, low, true) == 0.25 && probe(high, low, false) == 0.125 { true -> done() _ -> bad() }
    machine done() { }
    machine bad() { crash Trap; }
}
