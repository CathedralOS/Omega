// Inclusive f64 0.0 <= value <= 0.25 entails admit's 0.0 <= value <= 0.5.
// Expected exit: 0
use omega::language::core::float_operations;
const LOWER: f64 = 0.0;
const NARROW_UPPER: f64 = 0.25;
machine admit(value: f64) -> f64
requires value >= 0.0 && value <= 0.5
{ value }
machine probe(value: f64) -> f64
requires value >= LOWER && value <= NARROW_UPPER
{ admit(value) }
machine main() crashes Trap {
    let low: f64 = 0.125;
    let high: f64 = 0.25;
    transition probe(low) == 0.125 && probe(high) == 0.25 { true -> done() _ -> bad() }
    machine done() { }
    machine bad() { crash Trap; }
}
