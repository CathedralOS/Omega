// The caller reads the dependency's frozen body: a returned reference, a
// counted arrival, and an observation-free predicate. The match arm exits.
// The fallback traps.
// Expected exit: 0
use dependency;

machine require_equal(value: u64) requires equal(value) { }
machine main() crashes Trap {
    let cell: Cell = Cell { value: 19u64 };
    let view: &u64 = project(&cell);
    let observed: u64 = count(19u64);
    let difference: u64 = observed - 19u64;
    require_equal(19u64);
    transition view == 19u64 && difference == 0u64 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
