use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "checked_dependency_reuse");
    let mutable dependency_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "dependency" });
    |dependency|::with_alias(@mutable dependency_dependency, "dependency");
    let dependency_registration: DependencyRegistration = Build::dependency(builder, dependency_dependency);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
