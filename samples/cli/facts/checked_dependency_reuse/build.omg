use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "checked_dependency_reuse" };
    let mutable dependency_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../support/fact_dependencies/checked_dependency_reuse" });
    |dependency|::with_alias(@mutable dependency_dependency, "dependency");
    let dependency_registration: DependencyRegistration = Build::dependency(builder, dependency_dependency);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
