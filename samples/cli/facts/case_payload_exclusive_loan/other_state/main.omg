// A match on one evaluation of a copyable flag returns the exclusive loan of the selected case payload, writes 41 through that loan, and leaves the unselected payload unchanged.
// Place: other_state.
// Expected exit: 0
data Slot { case Absent; case Present(value: i64); }

machine choose(counter: @mutable u64) -> bool
requires $counter == 0
{
    $counter = 1;
    true
}

machine main() crashes Trap {
    let mutable chosen: Slot = Slot::Present { value: 17 };
    let mutable other: Slot = Slot::Present { value: 0 };
    let mutable visits: u64 = 0;
    transition { _ -> pick(@mutable chosen, @mutable other, @mutable visits) }
    machine pick(chosen: @mutable Slot, other: @mutable Slot, visits: @mutable u64) {
        let selected: @mutable i64 = match choose(visits) {
            true -> @mutable chosen.value,
            false -> @mutable other.value
        };
        $selected = 41;
        let observed: i64 = $selected;
        transition observed == 41 && $visits == 1 {
            true -> done(),
            false -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
