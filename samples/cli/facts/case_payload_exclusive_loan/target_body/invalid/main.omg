// A match on one evaluation of a copyable flag returns the exclusive loan of the selected case payload, writes 41 through that loan, and leaves the unselected payload unchanged.
// Place: target_body.
// The source is used while the result loan is live.
data Slot { case Absent; case Present(value: i64); }

machine choose(counter: &mut u64) -> bool
requires counter == 0
{
    counter = 1;
    true
}

linux_x86_64 machine apply(chosen: &mut Slot, other: &mut Slot, visits: &mut u64) -> i64
requires chosen in Slot::Present
requires other in Slot::Present
requires visits == 0
{
    let selected: &mut i64 = match choose(visits) {
        true -> &mut chosen.value
        false -> &mut other.value
    };
    chosen = Slot::Present { value: 7 };
    selected = 41;
    selected
}

linux_arm64 machine apply(chosen: &mut Slot, other: &mut Slot, visits: &mut u64) -> i64
requires chosen in Slot::Present
requires other in Slot::Present
requires visits == 0
{
    let selected: &mut i64 = match choose(visits) {
        true -> &mut chosen.value
        false -> &mut other.value
    };
    chosen = Slot::Present { value: 7 };
    selected = 41;
    selected
}

