// Fact: a 32-bit IEEE f32 ordered comparison guard (reading >= 1.25f32 && reading <= 2.75f32) establishes a finite, non-NaN sub-interval that satisfies a downstream contract requiring reading >= 1.0f32 && reading <= 3.0f32 across all nine places.
// Place: target_body. Each of four target bodies forwards the bounded reading to verify_f32_window.
// Expected exit: 0

data Reading [copy] where value >= 1.25f32 && value <= 2.75f32 {
    value: f32;
}

machine verify_f32_window(reading: f32) -> i32
requires reading >= 1.0f32 && reading <= 3.0f32
{
    transition reading >= 1.25f32 && reading <= 2.75f32 {
        true -> ok()
        _ -> out_of_window()
    }
    machine ok() -> i32 { 0i32 }
    machine out_of_window() -> i32 { 1i32 }
}

linux_x86_64 machine probe(reading: Reading) -> i32 {
    verify_f32_window(reading.value)
}

linux_arm64 machine probe(reading: Reading) -> i32 {
    verify_f32_window(reading.value)
}

macos_arm64 machine probe(reading: Reading) -> i32 {
    verify_f32_window(reading.value)
}

windows_x86_64 machine probe(reading: Reading) -> i32 {
    verify_f32_window(reading.value)
}

machine main() crashes Trap {
    let reading: Reading = Reading { value: 2.0f32 };
    transition probe(reading) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
