// Fact: a 15-argument calling plan across register and stack slots preserves the 15th stack argument bound 40u64 <= a15 <= 80u64 to justify 80u64 - res and res - 40u64.
// Place: call result. Call results supply operands to the multi-argument call.
// Expected exit: 0

machine supply(v: u64) -> u64
ensures result == v
{
    v
}

machine pick15(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64,
    a11: u64,
    a12: u64,
    a13: u64,
    a14: u64,
    a15: u64
) -> u64
requires
    a1 == 1u64 && a2 == 2u64 && a3 == 3u64 && a4 == 4u64 &&
    a5 == 5u64 && a6 == 6u64 && a7 == 7u64 && a8 == 8u64 &&
    a9 == 9u64 && a10 == 10u64 && a11 == 11u64 && a12 == 12u64 &&
    a13 == 13u64 && a14 == 14u64 &&
    a15 >= 40u64 && a15 <= 80u64
ensures
    result >= 40u64 && result <= 80u64 && result == a15
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14;
    (prefix - 105u64) + a15
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    let res: u64 = pick15(
        supply(1), supply(2), supply(3), supply(4),
        supply(5), supply(6), supply(7), supply(8),
        supply(9), supply(10), supply(11), supply(12),
        supply(13), supply(14), supply(60)
    );
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    let diff: u64 = (headroom + margin) - 40u64;
    transition diff == 0u64 && headroom == 20u64 && margin == 20u64 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

machine main() crashes Trap {
    transition probe() == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
