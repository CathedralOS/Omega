machine build(builder: &mut Build) {
    Build::select_provider<SelectedExpected, CheckedExpected>(builder, linux_x86_64);
    Build::select_provider<SelectedExpected, CheckedExpected>(builder, linux_arm64);
    Build::select_provider<SelectedExpected, CheckedExpected>(builder, macos_arm64);
    Build::select_provider<SelectedExpected, CheckedExpected>(builder, windows_x86_64);

    Build::application(builder, "write_only_ieee_store_readback_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
