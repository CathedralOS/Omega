// Fact: an IEEE f64 computed and stored through a write-only borrow (&write) preserves its exact bit pattern on readback, satisfying the 0.75 comparison across all nine places
// Place: match join. The read-back value is unified across reconverging branches before the comparison.
// Expected exit: 0

machine store(r: &write f64) { r = 6.0 / 8.0; }
machine choose(flag: bool, first: f64, second: f64) -> f64 {
    transition flag { true -> first false -> second }
}

machine main() crashes Trap {
    let mut slot: f64;
    store(&write slot);
    let v: f64 = choose(true, slot, 0.0);
    transition v == 0.75 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
