// Fact: a computed IEEE f64 stored through a write-only borrow (&write) preserves its exact bit pattern on readback, satisfying the 0.75 comparison across all nine places.
// Expected exit: 0

machine store(r: &write f64) {
    r = 6.0 / 8.0;
}

machine main() crashes Trap {
    let mut slot: f64;
    store(&write slot);
    let v: f64 = slot;
    transition v == 0.75 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
