// Fact: an IEEE f64 computed and stored through a write-only borrow (&write) preserves its exact bit pattern on readback, satisfying the 0.75 comparison across all nine places
// Invalid: the store observes the write-only referent. Place: const name.
// Expected diagnostic: reads write-only parameter

const DIVIDEND: f64 = 6.0;
machine store(r: &write f64) { r = DIVIDEND / 8.0; let _x: f64 = r; }

machine main() crashes Trap {
    let mut slot: f64;
    store(&write slot);
    let v: f64 = slot;
    transition v == 0.75 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
