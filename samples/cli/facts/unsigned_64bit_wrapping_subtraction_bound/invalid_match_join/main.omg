// Fact: 64-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 40u64 <= diff <= 100u64 establishes 40u64 <= diff <= 100u64 across all nine places so exact subtractions 100u64 - diff and diff - 40u64 are safe.
// Invalid: lhs allows diff 101 joined across match arms, causing 100u64 - diff to underflow. Place: match_join.
// Expected diagnostic: may overflow `u64`

machine choose_wrapping(flag: bool, lhs: u64, rhs: u64) -> u64
requires lhs >= 80u64 && lhs <= 121u64 && rhs >= 20u64 && rhs <= 40u64
{
    let w_lhs: u64 in Wrapping = lhs as u64 in Wrapping;
    let w_rhs: u64 in Wrapping = rhs as u64 in Wrapping;
    let diff_wrap: u64 in Wrapping = w_lhs - w_rhs;
    let diff: u64 = diff_wrap as u64;
    match flag {
        true -> diff,
        false -> diff,
    }
}

machine compute_join(lhs: u64, rhs: u64) -> i32
requires lhs >= 80u64 && lhs <= 121u64 && rhs >= 20u64 && rhs <= 40u64
{
    let diff: u64 = choose_wrapping(true, lhs, rhs);
    let headroom: u64 = 100u64 - diff;
    let margin: u64 = diff - 40u64;
    0i32
}

machine probe() -> i32 {
    compute_join(100u64, 30u64)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
