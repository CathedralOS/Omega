// Fact: 64-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 40u64 <= diff <= 100u64 establishes 40u64 <= diff <= 100u64 across all nine places so exact subtractions 100u64 - diff and diff - 40u64 are safe.
// Expected exit: 0

machine compute_wrapping(lhs: u64, rhs: u64) -> i32
requires lhs >= 80u64 && lhs <= 120u64 && rhs >= 20u64 && rhs <= 40u64
{
    let w_lhs: u64 in Wrapping = lhs as u64 in Wrapping;
    let w_rhs: u64 in Wrapping = rhs as u64 in Wrapping;
    let diff_wrap: u64 in Wrapping = w_lhs - w_rhs;
    let diff: u64 = diff_wrap as u64;
    let headroom: u64 = 100u64 - diff;
    let margin: u64 = diff - 40u64;
    0i32
}

machine probe() -> i32 {
    compute_wrapping(100u64, 30u64)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
