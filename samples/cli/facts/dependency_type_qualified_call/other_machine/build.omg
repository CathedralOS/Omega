use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "dependency_type_qualified_call_other_machine" };
    let mutable lib_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../../support/fact_dependencies/qualified_call_lib" });
    |dependency|::with_alias(@mutable lib_dependency, "lib");
    let lib_registration: DependencyRegistration = Build::dependency(builder, lib_dependency);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
