// A call spelled through a dependency's package alias selects the data type's machine,
// proves its `left.value > 0` premise on the exact operand, and records its `ensures` sum
// for the caller.
// Place: other_machine.
// Expected exit: 0
use lib::ops;

machine hold(total: u64) -> bool
requires total == 260
{
    true
}

machine observe(left: &lib::ops::Wrapped, right: &lib::ops::Wrapped) -> u64
requires left.value > 0
ensures result == (left.value as u64) + (right.value as u64)
{
    lib::ops::Wrapped::describe(left, right)
}

machine relay(left: &lib::ops::Wrapped, right: &lib::ops::Wrapped) -> u64
requires left.value > 0
ensures result == (left.value as u64) + (right.value as u64)
{
    observe(left, right)
}

machine main() crashes Trap {
    let left: lib::ops::Wrapped = lib::ops::Wrapped { value: 0u16 };
    let right: lib::ops::Wrapped = lib::ops::Wrapped { value: 260u16 };
    let total: u64 = relay(&left, &right);
    transition hold(total) && total == 260 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
