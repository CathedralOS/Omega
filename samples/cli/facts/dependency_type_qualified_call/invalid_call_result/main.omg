// A call spelled through a dependency's package alias selects the data type's machine,
// proves its `left.value > 0` premise on the exact operand, and records its `ensures` sum
// for the caller.
// Place: call_result.
// Expected exit: 0
use {lib}/ops/ops.omg;

machine hold(total: u64) -> bool
requires total == 260
{
    true
}

machine produced(value: u16) -> |ops|::Wrapped
ensures result.value == value
{
    |ops|::Wrapped { value: value }
}

machine main() crashes Trap {
    let left: |ops|::Wrapped = produced(0u16);
    let right: |ops|::Wrapped = produced(260u16);
    let total: u64 = |ops|::Wrapped::describe(@left, @right);
    transition hold(total) && total == 260 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
