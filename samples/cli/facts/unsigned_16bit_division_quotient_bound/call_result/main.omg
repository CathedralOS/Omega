// Fact: a 16-bit unsigned u16 division of bounded inputs (dividend >= 400u16 && dividend <= 400u16, divisor >= 8u16 && divisor <= 8u16) establishes quotient >= 50u16 && quotient <= 50u16 so exact 16-bit subtraction quotient - 50u16 is proved underflow-free across all nine places.
// Place: call result. Contracted helper calls return bounded 16-bit operands before division and subtraction.
// Expected exit: 0

machine get_dividend() -> u16
ensures result >= 400 && result <= 400
{
    400u16
}

machine get_divisor() -> u16
ensures result >= 8 && result <= 8
{
    8u16
}

machine div_call_result() -> u16 {
    let d: u16 = get_dividend();
    let s: u16 = get_divisor();
    let quotient: u16 = d / s;
    quotient - 50u16
}

machine probe() -> u16 {
    div_call_result()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
