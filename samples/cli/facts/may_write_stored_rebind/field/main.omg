// The chosen mutable input is stored in a reference and loaded back, the write goes through that reloaded referent, and the disjoint index-bound fact on the other input stays.
// Expected exit: 0
// Place: field.

machine choose<'storage>(chosen: @'storage mutable u64, other: @'storage mutable u64, pick_chosen: bool) -> @'storage mutable u64 {
    transition pick_chosen {
        true -> chosen,
        _ -> other
    }
}

machine overwrite(slot: @mutable u64) -> u64 in Wrapping {
    $slot = 9;
    (1 as u64 +Wrapping)
}

machine add(first: u64 in Wrapping, second: u64 in Wrapping) -> u64 in Wrapping {
    first + second
}
data Bounds { chosen: u64; other: u64; }

machine main() crashes Trap {
    let mutable bounds: Bounds = Bounds { chosen: 0, other: 1 };
    let items: [u8; 4] = [4, 7, 8, 9];
    let zero: u64 in Wrapping = 0;
    let mutable scratch: u64 = 3;
    let mutable referent: @mutable u64 = @mutable scratch;
    $referent = choose(@mutable bounds.chosen, @mutable bounds.other, true);
    let loaded: @mutable u64 = referent;
    let marker: u64 in Wrapping = add(overwrite(loaded), zero);
    transition (marker as u64) == 1 && bounds.chosen == 9 && items[bounds.other] == 7 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
