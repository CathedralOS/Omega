// Every private arrival supplies an integer from 0 through 255, so exact narrowing to u8 preserves its value.
machine probe(value: u32 in Trapping) -> u8 crashes Trap {
    let computed: u32 in Trapping = value + 1;
    transition computed < 257 { true -> narrow(computed) false -> (0) }
    machine narrow(value: u32 in Trapping) -> u8 { value as u8 }
}
machine main() crashes Trap {
    let first: u8 = probe(0);
    let second: u8 = probe(7);
    let maximum: u8 = probe(254);
    let outside: u8 = probe(255);
    let larger: u8 = probe(300);
    transition first == 1 && second == 8 && maximum == 255 && outside == 0 && larger == 0 { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
