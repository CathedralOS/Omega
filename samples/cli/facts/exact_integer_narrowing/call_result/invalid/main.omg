// Every private arrival supplies an integer from 0 through 255, so exact narrowing to u8 preserves its value.
data Note { value: u8; tag: u64; }
machine identity(value: i32) -> i32 ensures result == value { value }
machine probe(value: i32, select: bool) -> Note {
    transition value >= 0 && value <= 256 {
        true -> apply(identity(value), select)
        false -> Note { value: 0, tag: 0 }
    }
    machine apply(value: i32, select: bool) -> Note {
        let result: u8 = value as u8;
        let tag: u64 = match select { true -> 11, false -> 13 };
        Note { value: result, tag: tag }
    }
}
machine main() crashes Trap {
    let first: Note = probe(7, true);
    let second: Note = probe(231, false);
    let zero: Note = probe(0, true);
    let maximum: Note = probe(255, false);
    let out_of_range: Note = probe(256, true);
    transition out_of_range.value == 0 && out_of_range.tag == 0 && first.value == 7 && first.tag == 11 && second.value == 231 && second.tag == 13 && zero.value == 0 && zero.tag == 11 && maximum.value == 255 && maximum.tag == 13 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
