machine build(builder: &mut Build) {
    Build::application(builder, "exact_integer_narrowing_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, windows_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, linux_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, linux_arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, mac_entry);
}
