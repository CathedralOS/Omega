use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "exact_integer_narrowing_target_body" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::windows_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::linux_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::linux_arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::mac_entry);
}
