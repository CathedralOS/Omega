// Fact: matching a 25-variant tagged enum payload TwentyFiveChoice { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64), V12(u64), V13(u64), V14(u64), V15(u64), V16(u64), V17(u64), V18(u64), V19(u64), V20(u64), V21(u64), V22(u64), V23(u64), V24(u64), V25(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.

const MAX_RES: u64 = 80u64;
const MIN_RES: u64 = 40u64;

data TwentyFiveChoice [copy] {
    case V1(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V2(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V3(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V4(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V5(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V6(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V7(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V8(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V9(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V10(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V11(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V12(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V13(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V14(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V15(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V16(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V17(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V18(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V19(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V20(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V21(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V22(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V23(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V24(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V25(v: u64) where v >= 39u64 && v <= MAX_RES;
}

machine verify_payload(value: u64) -> u64
    requires value >= MIN_RES && value <= MAX_RES
{
    let headroom: u64 = MAX_RES - value;
    let margin: u64 = value - MIN_RES;
    headroom + margin
}

machine extract(choice: TwentyFiveChoice) -> u64 {
    transition choice {
        TwentyFiveChoice::V1 { v } -> v
        TwentyFiveChoice::V2 { v } -> v
        TwentyFiveChoice::V3 { v } -> v
        TwentyFiveChoice::V4 { v } -> v
        TwentyFiveChoice::V5 { v } -> v
        TwentyFiveChoice::V6 { v } -> v
        TwentyFiveChoice::V7 { v } -> v
        TwentyFiveChoice::V8 { v } -> v
        TwentyFiveChoice::V9 { v } -> v
        TwentyFiveChoice::V10 { v } -> v
        TwentyFiveChoice::V11 { v } -> v
        TwentyFiveChoice::V12 { v } -> v
        TwentyFiveChoice::V13 { v } -> v
        TwentyFiveChoice::V14 { v } -> v
        TwentyFiveChoice::V15 { v } -> v
        TwentyFiveChoice::V16 { v } -> v
        TwentyFiveChoice::V17 { v } -> v
        TwentyFiveChoice::V18 { v } -> v
        TwentyFiveChoice::V19 { v } -> v
        TwentyFiveChoice::V20 { v } -> v
        TwentyFiveChoice::V21 { v } -> v
        TwentyFiveChoice::V22 { v } -> v
        TwentyFiveChoice::V23 { v } -> v
        TwentyFiveChoice::V24 { v } -> v
        TwentyFiveChoice::V25 { v } -> v
    }
}

machine probe(choice: TwentyFiveChoice) -> u64 {
    let res: u64 = extract(choice);
    verify_payload(res)
}

machine main() crashes Trap {
    let p: TwentyFiveChoice = TwentyFiveChoice::V25 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
