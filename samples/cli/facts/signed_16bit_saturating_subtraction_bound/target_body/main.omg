// Fact: 16-bit signed saturating subtraction lhs -| rhs with bounded interval 200i16 <= diff <= 450i16 establishes 200i16 <= diff <= 450i16 across all nine places so exact subtractions 450i16 - diff and diff - 200i16 are safe.
// Place: target_body. Each hosted target body computes the 16-bit signed saturating subtraction and verifies the bounds.
// Expected exit: 0
machine verify_diff(value: i16) -> i16
    requires value >= 200 && value <= 450
{
    let head: i16 = 450 - value;
    let tail: i16 = value - 200;
    head + tail
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires lhs >= 300 && lhs <= 500 && rhs >= 50 && rhs <= 100;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires lhs >= 300 && lhs <= 500 && rhs >= 50 && rhs <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: i16 in Saturating = lhs as i16 in Saturating;
        let b: i16 in Saturating = rhs as i16 in Saturating;
        let sat: i16 in Saturating = a - b;
        let diff: i16 = sat as i16;
        verify_diff(diff)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires lhs >= 300 && lhs <= 500 && rhs >= 50 && rhs <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: i16 in Saturating = lhs as i16 in Saturating;
        let b: i16 in Saturating = rhs as i16 in Saturating;
        let sat: i16 in Saturating = a - b;
        let diff: i16 = sat as i16;
        verify_diff(diff)
    }
}









machine evaluate() -> i16
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(400, 80)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: i16 = evaluate();
    transition res == 250 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
