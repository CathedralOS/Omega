// Fact: 16-bit signed saturating subtraction lhs -| rhs with bounded interval 200i16 <= diff <= 450i16 establishes 200i16 <= diff <= 450i16 across all nine places so exact subtractions 450i16 - diff and diff - 200i16 are safe.
// Place: match_join. Both match arms yield the saturating difference result so the joined binding preserves the bounds.
// Expected exit: 0
machine verify_diff(value: i16) -> i16
    requires value >= 200 && value <= 450
{
    let head: i16 = 450 - value;
    let tail: i16 = value - 200;
    head + tail
}

machine compute_match_join(lhs: i16, rhs: i16, flag: bool) -> i16
    requires lhs >= 300 && lhs <= 520 && rhs >= 50 && rhs <= 100
{
    let a: i16 in Saturating = lhs as i16 in Saturating;
    let b: i16 in Saturating = rhs as i16 in Saturating;
    let sat: i16 in Saturating = a - b;
    let diff: i16 = sat as i16;
    let joined: i16 = match flag {
        true -> diff
        false -> diff
    };
    verify_diff(joined)
}

machine evaluate() -> i16 {
    compute_match_join(400, 80, true)
}

machine main() crashes Trap {
    let res: i16 = evaluate();
    transition res == 250 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
