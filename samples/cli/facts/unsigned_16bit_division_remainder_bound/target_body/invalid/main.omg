// Fact: a 16-bit unsigned u16 remainder operation (dividend % divisor where divisor >= 16u16 && divisor <= 16u16) establishes rem <= 15u16 so exact 16-bit subtraction 15u16 - rem is proved underflow-free across all nine places.
// Invalid: divisor upper bound widened to 17u16 so rem can be 16u16, underflowing subtraction from 15u16.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedRemTarget {
    machine rem_target(dividend: u16, divisor: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 43 && dividend <= 43 && divisor >= 16 && divisor <= 17;
}

X86RemTarget satisfies SelectedRemTarget {
    machine rem_target(dividend: u16, divisor: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 43 && dividend <= 43 && divisor >= 16 && divisor <= 17
    {
        SelectedBodyCheck::require_tag(17u64);
        let rem: u16 = dividend % divisor;
        15u16 - rem
    }
}

ArmRemTarget satisfies SelectedRemTarget {
    machine rem_target(dividend: u16, divisor: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 43 && dividend <= 43 && divisor >= 16 && divisor <= 17
    {
        SelectedBodyCheck::require_tag(29u64);
        let rem: u16 = dividend % divisor;
        15u16 - rem
    }
}

machine probe() -> u16 {
    SelectedRemTarget::rem_target(43u16, 16u16)
}

machine main() crashes Trap {
    transition probe() == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
