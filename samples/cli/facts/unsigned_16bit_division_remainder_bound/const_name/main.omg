// Fact: a 16-bit unsigned u16 remainder operation (dividend % divisor where divisor >= 16u16 && divisor <= 16u16) establishes rem <= 15u16 so exact 16-bit subtraction 15u16 - rem is proved underflow-free across all nine places.
// Place: const name. Named constants supply bounded 16-bit operands before remainder and subtraction.
// Expected exit: 0

const DIVIDEND: u16 = 43u16;
const DIVISOR: u16 = 16u16;

machine rem_const() -> u16 {
    let rem: u16 = DIVIDEND % DIVISOR;
    15u16 - rem
}

machine probe() -> u16 {
    rem_const()
}

machine main() crashes Trap {
    transition probe() == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
