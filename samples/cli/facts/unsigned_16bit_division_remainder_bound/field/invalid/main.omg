// Fact: a 16-bit unsigned u16 remainder operation (dividend % divisor where divisor >= 16u16 && divisor <= 16u16) establishes rem <= 15u16 so exact 16-bit subtraction 15u16 - rem is proved underflow-free across all nine places.
// Invalid: packet.divisor upper bound widened to 17u16 so rem can be 16u16, underflowing subtraction from 15u16.
// Expected exit: 0

data RemPacket {
    dividend: u16;
    divisor: u16;
}

machine rem_field(packet: RemPacket) -> u16
requires packet.dividend >= 43 && packet.dividend <= 43 && packet.divisor >= 16 && packet.divisor <= 17
{
    let rem: u16 = packet.dividend % packet.divisor;
    15u16 - rem
}

machine probe() -> u16 {
    let packet: RemPacket = RemPacket { dividend: 43u16, divisor: 16u16 };
    rem_field(packet)
}

machine main() crashes Trap {
    transition probe() == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
