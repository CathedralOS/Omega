// Fact: computing the signed remainder (%) of a non-negative bounded i64 dividend by a positive bounded i64 divisor (divisor == 4i64) establishes the remainder bound (0 <= rem < 4) to safely index a 4-element array across all nine places.
// Place: another state. A successor state receives the operands and indexes the array.
// Expected exit: 0

machine compute_state(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 4i64
{
    transition {
        _ -> step(dividend, divisor)
    }
    machine step(d: i64, s: i64) -> u8
    requires d >= 0i64 && s == 4i64
    {
        let rem: i64 = d % s;
        let idx: u64 = rem as u64;
        let arr: [u8; 4] = [10, 20, 30, 40];
        arr[idx]
    }
}

machine probe() -> u8 {
    compute_state(14i64, 4i64)
}

machine main() crashes Trap {
    transition probe() == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
