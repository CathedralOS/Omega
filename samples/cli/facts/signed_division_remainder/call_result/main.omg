// Fact: computing the signed remainder (%) of a non-negative bounded i64 dividend by a positive bounded i64 divisor (divisor == 4i64) establishes the remainder bound (0 <= rem < 4) to safely index a 4-element array across all nine places.
// Place: call result. A helper call returns the contracted divisor before remainder and indexing.
// Expected exit: 0

machine get_divisor() -> i64
ensures result == 4i64
{
    4i64
}

machine compute_call_result(dividend: i64) -> u8
requires dividend >= 0i64
{
    let divisor: i64 = get_divisor();
    let rem: i64 = dividend % divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

machine probe() -> u8 {
    compute_call_result(14i64)
}

machine main() crashes Trap {
    transition probe() == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
