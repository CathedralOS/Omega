// Fact: computing the signed remainder (%) of a non-negative bounded i64 dividend by a positive bounded i64 divisor (divisor == 4i64) establishes the remainder bound (0 <= rem < 4) to safely index a 4-element array across all nine places.
// Invalid: divisor is 5i64, so rem can be 4, exceeding array length 4. Place: another target body.
// Expected exit: 0

linux_x86_64 machine compute_target(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 5i64
{
    let rem: i64 = dividend % divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

linux_arm64 machine compute_target(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 5i64
{
    let rem: i64 = dividend % divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

macos_arm64 machine compute_target(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 5i64
{
    let rem: i64 = dividend % divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

windows_x86_64 machine compute_target(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 5i64
{
    let rem: i64 = dividend % divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

machine probe() -> u8 {
    compute_target(14i64, 5i64)
}

machine main() crashes Trap {
    transition probe() == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
