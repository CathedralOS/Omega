// Fact: a 64-bit signed i64 arithmetic right shift of a bounded input (val >= 300i64 && val <= 300i64) by 2u64 bits establishes shifted >= 75i64 && shifted <= 75i64 so exact 64-bit signed subtraction shifted - 75i64 is proved overflow-free across all nine places.
// Expected exit: 0

machine compute_shift(val: i64) -> i64
    requires val >= 300 && val <= 300
{
    val >> 2u64
}

machine verify_shifted(shifted: i64) -> i64
    requires shifted >= 75 && shifted <= 75
{
    shifted - 75
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 75 && val <= 75;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 75 && val <= 75
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_shifted(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 75 && val <= 75
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_shifted(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let val: i64 = 300;
    let shifted: i64 = compute_shift(val);
    let check: i64 = SelectedProbe::exercise(shifted);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
