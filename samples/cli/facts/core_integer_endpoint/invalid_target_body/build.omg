use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "core_integer_endpoint_target_body" };
    Build::select_provider::<|app|::EndpointProbe, |app|::WindowsEndpointProbe>(builder, windows_x86_64);
    Build::select_provider::<|app|::EndpointProbe, |app|::LinuxX86EndpointProbe>(builder, linux_x86_64);
    Build::select_provider::<|app|::EndpointProbe, |app|::MacEndpointProbe>(builder, macos_arm64);
    Build::select_provider::<|app|::EndpointProbe, |app|::LinuxArmEndpointProbe>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
