// The ordinary integer query preserves the exact u32 maximum through transport, permitting subtraction of that endpoint.
// Place: match_join.
// Expected exit: 0
use omega::language::core::integer;

machine consume(value: u32) -> u32
requires value == 0xFFFF_FFFFu32
ensures result == 0u32
{ value - 0xFFFF_FFFFu32 }

data Envelope { value: u32; marker: u32; }
machine probe(flag: bool) -> u32 {
    let held: Envelope = match flag {
        true -> Envelope { value: integer::max<u32>(), marker: 1u32 },
        false -> Envelope { value: integer::max<u32>(), marker: 2u32 }
    };
    consume(held.value) + held.marker
}

machine main() crashes Trap {
    transition probe(true) == 1u32 && probe(false) == 2u32 && integer::width_bits<u32>() == 32u64 && !integer::is_signed<u32>() { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
