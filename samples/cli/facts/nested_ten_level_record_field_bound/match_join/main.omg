// Fact: a 10-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { l5: Level5 { l6: Level6 { l7: Level7 { l8: Level8 { l9: Level9 { val: u64 } } } } } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.l5.l6.l7.l8.l9.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: match join. Both match arms yield a 10-level nested record and join before leaf projection and interval discharge.
// Expected exit: 0

data Level9 [copy] {
    val: u64;
}

data Level8 [copy] {
    l9: Level9;
}

data Level7 [copy] {
    l8: Level8;
}

data Level6 [copy] {
    l7: Level7;
}

data Level5 [copy] {
    l6: Level6;
}

data Level4 [copy] {
    l5: Level5;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

machine choose_root(first: RootRec, second: RootRec, flag: bool) -> RootRec
requires first.l1.l2.l3.l4.l5.l6.l7.l8.l9.val >= 40 && first.l1.l2.l3.l4.l5.l6.l7.l8.l9.val <= 80
    && second.l1.l2.l3.l4.l5.l6.l7.l8.l9.val >= 40 && second.l1.l2.l3.l4.l5.l6.l7.l8.l9.val <= 80
ensures result.l1.l2.l3.l4.l5.l6.l7.l8.l9.val >= 40 && result.l1.l2.l3.l4.l5.l6.l7.l8.l9.val <= 80
{
    match flag {
        true -> first
        false -> second
    }
}

machine probe(first: RootRec, second: RootRec, flag: bool) -> u64
requires first.l1.l2.l3.l4.l5.l6.l7.l8.l9.val >= 40 && first.l1.l2.l3.l4.l5.l6.l7.l8.l9.val <= 80
    && second.l1.l2.l3.l4.l5.l6.l7.l8.l9.val >= 40 && second.l1.l2.l3.l4.l5.l6.l7.l8.l9.val <= 80
{
    let root: RootRec = choose_root(first, second, flag);
    let res: u64 = root.l1.l2.l3.l4.l5.l6.l7.l8.l9.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine main() crashes Trap {
    let r1: RootRec = RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        l5: Level5 {
                            l6: Level6 {
                                l7: Level7 {
                                    l8: Level8 {
                                        l9: Level9 {
                                            val: 60u64,
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    };
    let r2: RootRec = RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        l5: Level5 {
                            l6: Level6 {
                                l7: Level7 {
                                    l8: Level8 {
                                        l9: Level9 {
                                            val: 50u64,
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    };
    transition probe(r1, r2, true) == 40 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
