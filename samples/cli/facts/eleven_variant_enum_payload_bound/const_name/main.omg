// Fact: matching an 11-variant tagged enum payload Packet { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Expected exit: 0

const MAX_RES: u64 = 80u64;
const MIN_RES: u64 = 40u64;

data Packet [copy]
    requires ((self in Packet::V1) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V2) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V3) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V4) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V5) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V6) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V7) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V8) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V9) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V10) && self.v >= MIN_RES && self.v <= MAX_RES)
       || ((self in Packet::V11) && self.v >= MIN_RES && self.v <= MAX_RES)
{
    case V1(v: u64);
    case V2(v: u64);
    case V3(v: u64);
    case V4(v: u64);
    case V5(v: u64);
    case V6(v: u64);
    case V7(v: u64);
    case V8(v: u64);
    case V9(v: u64);
    case V10(v: u64);
    case V11(v: u64);
}

machine verify_payload(value: u64) -> u64
    requires value >= MIN_RES && value <= MAX_RES
{
    let headroom: u64 = MAX_RES - value;
    let margin: u64 = value - MIN_RES;
    headroom + margin
}

machine extract(packet: Packet) -> u64 {
    transition packet {
        Packet::V1 { v } -> v
        Packet::V2 { v } -> v
        Packet::V3 { v } -> v
        Packet::V4 { v } -> v
        Packet::V5 { v } -> v
        Packet::V6 { v } -> v
        Packet::V7 { v } -> v
        Packet::V8 { v } -> v
        Packet::V9 { v } -> v
        Packet::V10 { v } -> v
        Packet::V11 { v } -> v
    }
}

machine probe(packet: Packet) -> u64 {
    let res: u64 = extract(packet);
    verify_payload(res)
}

machine main() crashes Trap {
    let p: Packet = Packet::V11 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
