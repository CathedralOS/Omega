// Expected exit: 0
// Fact: GenericPolicy<Box<u64>, 8> places all eight bytes of boundary result 42 before the same value is observed.
use omega_language_std::calling;
public data Box<Element> { value: Element; }
boundary trait ValuePlan {
    machine plan(signature: BoundarySignature, allow_vectors: bool, width: u64) -> BoundaryPlanResult reaches;
}
SysVValuePlan satisfies ValuePlan {
    machine plan(signature: BoundarySignature, allow_vectors: bool, width: u64) -> BoundaryPlanResult {
    scalar_plan(signature, allow_vectors, width, CallingConvention::SystemVAMD64, MachineRegister::X86Rax, MachineRegime::X86Long64, 0)
    }
}
MicrosoftValuePlan satisfies ValuePlan {
    machine plan(signature: BoundarySignature, allow_vectors: bool, width: u64) -> BoundaryPlanResult {
    scalar_plan(signature, allow_vectors, width, CallingConvention::MicrosoftX64, MachineRegister::X86Rax, MachineRegime::X86Long64, 32)
    }
}
AapcsValuePlan satisfies ValuePlan {
    machine plan(signature: BoundarySignature, allow_vectors: bool, width: u64) -> BoundaryPlanResult {
    scalar_plan(signature, allow_vectors, width, CallingConvention::Aapcs64, MachineRegister::Aarch64X { index: 0 }, MachineRegime::Aarch64A64 { exception_level: 0 }, 0)
    }
}

public GenericPolicy<Element, const Width: u64> satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        ValuePlan::plan(signature, false, Width)
    }
}
public const PolicyWidth: u64 = 8;
public boundary trait LocalEntry: Calling<GenericPolicy<Box<u64>, PolicyWidth>> {
    machine value() -> u64 reaches;
}
LocalMap satisfies LocalEntry {
    machine value() -> u64 { 42 }
}
machine scalar_plan(signature: BoundarySignature, allow_vectors: bool, width: u64, convention: CallingConvention, register: MachineRegister, regime: MachineRegime, shadow: u64) -> BoundaryPlanResult {
    transition signature.parameter_count == 0 && signature.has_result {
        true -> select_result(signature, signature.result, allow_vectors, width, convention, register, regime, shadow)
        _ -> reject()
    }
    machine select_result(signature: BoundarySignature, result: u64, allow_vectors: bool, width: u64, convention: CallingConvention, register: MachineRegister, regime: MachineRegime, shadow: u64) -> BoundaryPlanResult {
        transition result < 256 { true -> accept(signature, result, allow_vectors, width, convention, register, regime, shadow) _ -> reject() }
    }
    machine accept(signature: BoundarySignature, result: u64, allow_vectors: bool, width: u64, convention: CallingConvention, register: MachineRegister, regime: MachineRegime, shadow: u64) -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan;
        plan.call.convention = convention;
        plan.call.has_result = true;
        plan.call.result.shape.class = AbiValueClass::Integer;
        plan.call.result.shape.byte_size = signature.shapes[result].byte_size;
        plan.call.result.shape.alignment = signature.shapes[result].alignment;
        plan.call.result.location_count = 1;
        plan.call.result.locations[0] = ValueLocation::Register {
            register: register, value_byte_offset: 0, byte_size: width
        };
        plan.call.stack_alignment = 16;
        plan.call.shadow_bytes = shadow;
        plan.call.entry_control = EntryControl::CallReturn;
        plan.state.initial_regime = regime;
        plan.state.permitted_transitive_use.general_registers = true;
        plan.state.permitted_transitive_use.flags = true;
        plan.state.permitted_transitive_use.vector_registers = allow_vectors;
        plan.state.stack = EntryStack::ProviderSelected;
        plan.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: plan }
    }
    machine reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "one scalar result" } }
    }
}










data Joined [copy] { value: u64; branch: u64; }
machine choose(left: bool) -> Joined reaches LocalEntry {
    match left {
        true -> Joined { value: LocalEntry::value(), branch: 17 },
        false -> Joined { value: LocalEntry::value(), branch: 23 }
    }
}
machine main() reaches LocalEntry crashes Trap {
    let left: Joined = choose(true);
    let right: Joined = choose(false);
    transition left.value == 42 && left.branch == 17 && right.value == 42 && right.branch == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
