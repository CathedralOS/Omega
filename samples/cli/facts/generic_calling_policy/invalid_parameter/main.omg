machine scalar_plan(signature: |calling|::BoundarySignature, allow_vectors: bool, width: u64, convention: |calling|::CallingConvention, register: |calling|::MachineRegister, regime: |calling|::MachineRegime, shadow: u64) -> |calling|::BoundaryPlanResult {
    transition signature.parameter_count == 0 && signature.has_result {
        true -> select_result(signature, signature.result, allow_vectors, width, convention, register, regime, shadow),
        _ -> reject()
    }
    machine select_result(signature: |calling|::BoundarySignature, result: u64, allow_vectors: bool, width: u64, convention: |calling|::CallingConvention, register: |calling|::MachineRegister, regime: |calling|::MachineRegime, shadow: u64) -> |calling|::BoundaryPlanResult {
        transition result < 256 { true -> accept(signature, result, allow_vectors, width, convention, register, regime, shadow), _ -> reject() }
    }
