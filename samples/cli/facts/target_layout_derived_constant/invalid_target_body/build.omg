use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "target_layout_derived_constant_target_body" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);

    Build::select_provider::<|app|::Answer, |app|::Small>(builder, linux_x86_64);
    Build::select_provider::<|app|::Answer, |app|::Large>(builder, windows_x86_64);
    Build::select_provider::<|app|::Answer, |app|::Small>(builder, linux_arm64);
    Build::select_provider::<|app|::Answer, |app|::Large>(builder, macos_arm64);
    Build::select_provider::<|app|::ExpectedExtent, |app|::FourByteExpectation>(builder, linux_x86_64);
    Build::select_provider::<|app|::ExpectedExtent, |app|::EightByteExpectation>(builder, windows_x86_64);
    Build::select_provider::<|app|::ExpectedExtent, |app|::FourByteExpectation>(builder, linux_arm64);
    Build::select_provider::<|app|::ExpectedExtent, |app|::EightByteExpectation>(builder, macos_arm64);
    Build::select_provider::<|app|::DerivedObservation, |app|::DerivedObservationCode>(builder, linux_x86_64);
    Build::select_provider::<|app|::DerivedObservation, |app|::DerivedObservationCode>(builder, windows_x86_64);
    Build::select_provider::<|app|::DerivedObservation, |app|::DerivedObservationCode>(builder, linux_arm64);
    Build::select_provider::<|app|::DerivedObservation, |app|::DerivedObservationCode>(builder, macos_arm64);
}
