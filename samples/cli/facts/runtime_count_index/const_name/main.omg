// A const name of a runtime count still indexes a byte view.
// Expected exit: 0
const COUNT: u32 = 1;

machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

machine indexed(items: &[u8]) -> u8
requires COUNT < items.len;
{
    read_at<COUNT>(items)
}

machine main() crashes Trap {
    let bytes: [u8; 4] = [9, 8, 7, 6];
    transition indexed(&bytes[..]) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
