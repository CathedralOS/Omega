use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "runtime_count_through_target_body" };
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::x86_entry);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedReadAt, |app|::X86ReadAt>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedReadAt, |app|::ArmReadAt>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedReadAt, |app|::X86ReadAt>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedReadAt, |app|::ArmReadAt>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedReadAt, |app|::X86ReadAt>(builder, windows_x86_64);
}
