machine build(builder: &mut Build) {
    Build::select_provider<SelectedForward, CheckedForward>(builder, macos_arm64);
    Build::select_provider<SelectedForward, CheckedForward>(builder, linux_x86_64);
    Build::select_provider<SelectedForward, CheckedForward>(builder, linux_arm64);
    Build::select_provider<SelectedForward, CheckedForward>(builder, windows_x86_64);

    Build::application(builder, "content_interval_adjacency_target_body");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
