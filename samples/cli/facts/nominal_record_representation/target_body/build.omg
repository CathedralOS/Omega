machine build(builder: &mut Build) {
    Build::application(builder, "nominal_record_representation_target_body");
    Build::select_provider<RecordOperation, SelectedRecordOperation>(builder, linux_x86_64);
    Build::select_provider<RecordOperation, SelectedRecordOperation>(builder, linux_arm64);
    Build::select_provider<RecordOperation, SelectedRecordOperation>(builder, macos_arm64);
    Build::select_provider<RecordOperation, SelectedRecordOperation>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
