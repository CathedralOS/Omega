// Fact: querying size_of and align_of on a four-element u64 fixed-size array ([u64; 4]) establishes its exact layout geometry (size == 32u64 and align == 8u64), discharging exact subtraction size - (align * 4u64) across all nine places.
// Place: call result. The size and alignment are returned from contracted helper call results before subtracting.
// Expected exit: 0

machine query_size() -> u64 {
    size_of<[u64; 4]>()
}

machine query_align() -> u64 {
    align_of<[u64; 4]>()
}

machine main() crashes Trap {
    let s: u64 = query_size();
    let a: u64 = query_align();
    let diff: u64 = s - (a * 4u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
