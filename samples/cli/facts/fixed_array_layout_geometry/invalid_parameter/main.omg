// Fact: querying size_of and align_of on a four-element u64 fixed-size array ([u64; 4]) establishes its exact layout geometry (size == 32u64 and align == 8u64), discharging exact subtraction size - (align * 4u64) across all nine places.
// Invalid: querying narrower array [u64; 3] (size == 24u64, align == 8u64), so receive_size(s) - (receive_align(a) * 4u64) underflows u64.
// Expected exit: 0

machine receive_size(s: u64) -> u64 {
    s
}

machine receive_align(a: u64) -> u64 {
    a
}

machine main() crashes Trap {
    let s: u64 = size_of<[u64; 3]>();
    let a: u64 = align_of<[u64; 3]>();
    let diff: u64 = receive_size(s) - (receive_align(a) * 4u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
