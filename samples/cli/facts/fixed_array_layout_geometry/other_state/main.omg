// Fact: querying size_of and align_of on a four-element u64 fixed-size array ([u64; 4]) establishes its exact layout geometry (size == 32u64 and align == 8u64), discharging exact subtraction size - (align * 4u64) across all nine places.
// Place: another state. A successor state receives the size and alignment queries before subtracting.
// Expected exit: 0

machine main() crashes Trap {
    let s: u64 = size_of<[u64; 4]>();
    let a: u64 = align_of<[u64; 4]>();
    transition true {
        true -> compute(s, a)
        _ -> bad()
    }
    machine compute(size: u64, align: u64) {
        let diff: u64 = size - (align * 4u64);
        transition diff == 0 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
