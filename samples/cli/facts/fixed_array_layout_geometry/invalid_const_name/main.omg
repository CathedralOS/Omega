// Fact: querying size_of and align_of on a four-element u64 fixed-size array ([u64; 4]) establishes its exact layout geometry (size == 32u64 and align == 8u64), discharging exact subtraction size - (align * 4u64) across all nine places.
// Invalid: querying narrower array [u64; 3] (size == 24u64, align == 8u64), so ARRAY_SIZE - (ARRAY_ALIGN * 4u64) underflows u64.
// Expected exit: 0

const ARRAY_SIZE: u64 = size_of<[u64; 3]>();
const ARRAY_ALIGN: u64 = align_of<[u64; 3]>();

machine main() crashes Trap {
    let diff: u64 = ARRAY_SIZE - (ARRAY_ALIGN * 4u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
