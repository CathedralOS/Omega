// Fact: querying size_of and align_of on a four-element u64 fixed-size array ([u64; 4]) establishes its exact layout geometry (size == 32u64 and align == 8u64), discharging exact subtraction size - (align * 4u64) across all nine places.
// Invalid: querying narrower array [u64; 3] (size == 24u64, align == 8u64), so query_geometry() underflows u64.
// Expected exit: 0

machine query_geometry() -> u64 {
    let s: u64 = size_of<[u64; 3]>();
    let a: u64 = align_of<[u64; 3]>();
    s - (a * 4u64)
}

machine runner() -> u64 {
    query_geometry()
}

machine main() crashes Trap {
    let diff: u64 = runner();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
