// A whole-array shared view of four noncopy Entries has length 4; reading its extent satisfies require_four(view.len).
// Expected exit: 0
use omega::language::core::slice;
data Entry { prefix: u32; value: i32; }
machine whole_view<Element, const Count: u64>(items: &[Element; Count]) -> &[Element]
ensures result.len == Count
{ &items[..] }
machine require_four(length: u64) -> u64 requires length == 4 { length }
machine observe(view: &[Entry], original: addr, selected: u64) -> bool
requires selected < view.len
{ address_of(&view[selected].value) == original && view[selected].value == 9 }
machine success() {}
machine failure() crashes Trap { crash Trap; }
machine main() crashes Trap {
    let mut entries: [Entry; 4] = [Entry { prefix: 17, value: 7 }, Entry { prefix: 17, value: 8 }, Entry { prefix: 17, value: 9 }, Entry { prefix: 17, value: 10 }];
    let original: addr = address_of(&entries[2].value);
    let view: &[Entry] = whole_view<Entry, 4>(&entries);
    let measured: u64 = require_four(view.len);
    transition measured == 4 && observe(view, original, 2) {
        true -> success()
        false -> failure()
    }
}
