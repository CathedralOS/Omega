// A whole-array range lends a noncopy element view through the imported
// core range requirement. Reading its extent preserves the original length.

use omega::language::core::slice;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let view: &[Entry] = &main.entries[..];
    let whole: u64 = view.len;
    transition whole == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
