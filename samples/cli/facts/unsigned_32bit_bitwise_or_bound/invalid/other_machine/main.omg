// Fact: 32-bit unsigned bitwise OR base | 32u32 with bounded interval 40u32 <= combined <= 63u32 establishes 40u32 <= combined <= 63u32 across all nine places so exact subtractions 63u32 - combined and combined - 40u32 are safe.
// Place: other_machine. A forwarding machine transports the bitwise OR result through an intermediate machine call.
// Expected exit: 0
machine verify_combined(res: u32) -> u32
    requires res >= 40 && res <= 63
{
    let head: u32 = 63 - res;
    let tail: u32 = res - 40;
    head + tail
}

machine target_machine(val: u32) -> u32
    ensures result == val
{
    val
}

machine forwarder(val: u32) -> u32
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(base: u32) -> u32
    requires base >= 64 && base <= 64
{
    let combined: u32 = forwarder(base | 32);
    verify_combined(combined)
}

machine evaluate() -> u32 {
    compute_other_machine(64)
}

machine main() crashes Trap {
    let res: u32 = evaluate();
    transition res == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
