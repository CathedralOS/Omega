// Fact: 32-bit unsigned bitwise OR base | 32u32 with bounded interval 40u32 <= combined <= 63u32 establishes 40u32 <= combined <= 63u32 across all nine places so exact subtractions 63u32 - combined and combined - 40u32 are safe.
// Place: local. Both the bounded unsigned u32 operand and its bitwise OR result are transported through local bindings.
// Expected exit: 0
machine verify_combined(res: u32) -> u32
    requires res >= 40 && res <= 63
{
    let head: u32 = 63 - res;
    let tail: u32 = res - 40;
    head + tail
}

machine compute_local(base: u32) -> u32
    requires base >= 20 && base <= 20
{
    let combined: u32 = base | 32;
    let v: u32 = combined;
    let transported: u32 = v;
    verify_combined(transported)
}

machine evaluate() -> u32 {
    compute_local(20)
}

machine main() crashes Trap {
    let res: u32 = evaluate();
    transition res == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
