// Fact: 32-bit unsigned bitwise OR base | 32u32 with bounded interval 40u32 <= combined <= 63u32 establishes 40u32 <= combined <= 63u32 across all nine places so exact subtractions 63u32 - combined and combined - 40u32 are safe.
// Place: target_body. Each hosted target body computes the 32-bit unsigned bitwise OR and verifies the bounds.
// Expected exit: 0
machine verify_combined(res: u32) -> u32
    requires res >= 40 && res <= 63
{
    let head: u32 = 63 - res;
    let tail: u32 = res - 40;
    head + tail
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(base: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires base >= 20 && base <= 20;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(base: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires base >= 20 && base <= 20
    {
        SelectedBodyCheck::require_tag(17u64);
        let combined: u32 = base | 32;
        verify_combined(combined)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(base: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires base >= 20 && base <= 20
    {
        SelectedBodyCheck::require_tag(29u64);
        let combined: u32 = base | 32;
        verify_combined(combined)
    }
}









machine evaluate() -> u32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(20)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: u32 = evaluate();
    transition res == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
