// A nominal owner retains its exclusive output reference through a shared call, then normal cleanup writes captured code 7 to the original backing.
// Place: target_body.
// Expected rejection: cleanup retains its code 7 requirement.
data Seed [copy] { code: u64; }
data Counter { value: u64; }
data Keeper { output: &mut Counter; code: u64; }
machine Keeper::drop(keeper: &mut Keeper) requires keeper.code == 7 {
    keeper.output.value = keeper.code;
}
machine observe(keeper: &Keeper) {}
machine check(output: &Counter) crashes Trap {
    transition output.value == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedConsume {
    machine consume(seed: Seed)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed.code == 6;
}

X86Consume satisfies SelectedConsume {
    machine consume(seed: Seed)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed.code == 6
    {
        SelectedBodyCheck::require_tag(17u64);
        let mut output: Counter = Counter { value: 0 };
        observe(&Keeper { output: &mut output, code: seed.code });
        check(&output);
    }
}

ArmConsume satisfies SelectedConsume {
    machine consume(seed: Seed)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed.code == 6
    {
        SelectedBodyCheck::require_tag(29u64);
        let mut output: Counter = Counter { value: 0 };
        observe(&Keeper { output: &mut output, code: seed.code });
        check(&output);
    }
}


machine main() crashes Trap { SelectedConsume::consume(Seed { code: 6 }); }
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
