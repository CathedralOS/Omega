// A nominal owner retains its exclusive output reference through a shared call, then normal cleanup writes captured code 7 to the original backing.
// Place: other_machine.
// Expected rejection: cleanup retains its code 7 requirement.
data Seed [copy] { code: u64; }
data Counter { value: u64; }
data Keeper { output: &mut Counter; code: u64; }
machine Keeper::drop(keeper: &mut Keeper) requires keeper.code == 7 {
    keeper.output.value = keeper.code;
}
machine observe(keeper: &Keeper) {}
machine check(output: &Counter) crashes Trap {
    transition output.value == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine produce() -> Seed ensures result.code == 6 { Seed { code: 6 } }
machine consume(seed: Seed) requires seed.code == 6 crashes Trap {
    let mut output: Counter = Counter { value: 0 };
    observe(&Keeper { output: &mut output, code: seed.code });
    check(&output);
}
machine forward() crashes Trap { consume(produce()); }
machine main() crashes Trap { forward(); }
