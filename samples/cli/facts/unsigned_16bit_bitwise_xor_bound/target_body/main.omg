// Fact: 16-bit unsigned bitwise XOR raw ^ 15u16 with bounded interval 40u16 <= xored <= 63u16 establishes 40u16 <= xored <= 63u16 across all nine places so exact subtractions 63u16 - xored and xored - 40u16 are safe.
// Expected exit: 0

machine compute_xor(raw: u16) -> u16
    requires raw >= 59 && raw <= 59
{
    raw ^ 15u16
}

machine verify_xored(xored: u16) -> i32
    requires xored >= 40 && xored <= 63
{
    let headroom: u16 = 63 - xored;
    let margin: u16 = xored - 40;
    let total: u16 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: u16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 63;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: u16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 63
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_xored(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: u16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 63
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_xored(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let raw: u16 = 59;
    let xored: u16 = compute_xor(raw);
    let check: i32 = SelectedProbe::exercise(xored);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
