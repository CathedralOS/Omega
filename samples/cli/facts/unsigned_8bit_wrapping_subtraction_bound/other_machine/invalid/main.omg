// Fact: 8-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 60u8 <= diff <= 160u8 establishes 60u8 <= diff <= 160u8 across all nine places so exact subtractions 160u8 - diff and diff - 60u8 are safe.
// Place: another machine (invalid twin). The lhs upper bound is widened to 181u8 so diff reaches 161u8, causing contract verification for forward_wrap to fail closed.
// Expected diagnostic: cannot prove requires contract for call forward_wrap

machine verify_diff(value: u8) -> u8 requires value >= 60u8 && value <= 160u8 {
    let headroom: u8 = 160u8 - value;
    let margin: u8 = value - 60u8;
    headroom + margin
}

machine forward_wrap(lhs: u8, rhs: u8) -> u8
requires lhs >= 100 && lhs <= 180 && rhs >= 20 && rhs <= 40
{
    let a: u8 in Wrapping = lhs as u8 in Wrapping;
    let b: u8 in Wrapping = rhs as u8 in Wrapping;
    let wrap_diff: u8 in Wrapping = a - b;
    let diff: u8 = wrap_diff as u8;
    verify_diff(diff)
}

machine wrap_machine(lhs: u8, rhs: u8) -> u8
requires lhs >= 100 && lhs <= 181 && rhs >= 20 && rhs <= 40
{
    forward_wrap(lhs, rhs)
}

machine probe() -> u8 {
    wrap_machine(140u8, 30u8)
}

machine main() crashes Trap {
    transition probe() == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
