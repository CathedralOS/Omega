// Fact: 8-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 60u8 <= diff <= 160u8 establishes 60u8 <= diff <= 160u8 across all nine places so exact subtractions 160u8 - diff and diff - 60u8 are safe.
// Place: another state. A successor state receives bounded 8-bit operands before wrapping subtraction and verification.
// Expected exit: 0

machine verify_diff(value: u8) -> u8 requires value >= 60u8 && value <= 160u8 {
    let headroom: u8 = 160u8 - value;
    let margin: u8 = value - 60u8;
    headroom + margin
}

machine wrap_state(lhs: u8, rhs: u8) -> u8
requires lhs >= 100 && lhs <= 180 && rhs >= 20 && rhs <= 40
{
    transition {
        _ -> step(lhs, rhs)
    }
    machine step(l: u8, r: u8) -> u8
    requires l >= 100 && l <= 180 && r >= 20 && r <= 40
    {
        let a: u8 in Wrapping = l as u8 in Wrapping;
        let b: u8 in Wrapping = r as u8 in Wrapping;
        let wrap_diff: u8 in Wrapping = a - b;
        let diff: u8 = wrap_diff as u8;
        verify_diff(diff)
    }
}

machine probe() -> u8 {
    wrap_state(140u8, 30u8)
}

machine main() crashes Trap {
    transition probe() == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
