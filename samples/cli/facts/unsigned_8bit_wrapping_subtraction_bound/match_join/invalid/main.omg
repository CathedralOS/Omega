// Fact: 8-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 60u8 <= diff <= 160u8 establishes 60u8 <= diff <= 160u8 across all nine places so exact subtractions 160u8 - diff and diff - 60u8 are safe.
// Place: match join (invalid twin). Match arm yields 181u8 so diff reaches 161u8, causing contract verification for verify_diff to fail closed.
// Expected diagnostic: cannot prove requires contract for call verify_diff

machine verify_diff(value: u8) -> u8 requires value >= 60u8 && value <= 160u8 {
    let headroom: u8 = 160u8 - value;
    let margin: u8 = value - 60u8;
    headroom + margin
}

machine choose_lhs(flag: bool) -> u8 {
    match flag {
        true -> 181u8,
        false -> 120u8,
    }
}

machine wrap_match_join(rhs: u8) -> u8
requires rhs >= 20 && rhs <= 40
{
    let lhs: u8 = choose_lhs(true);
    let a: u8 in Wrapping = lhs as u8 in Wrapping;
    let b: u8 in Wrapping = rhs as u8 in Wrapping;
    let wrap_diff: u8 in Wrapping = a - b;
    let diff: u8 = wrap_diff as u8;
    verify_diff(diff)
}

machine probe() -> u8 {
    wrap_match_join(20u8)
}

machine main() crashes Trap {
    transition probe() == 100 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
