machine build(builder: &mut Build) {
    Build::select_provider<SelectedWrapTarget, CheckedWrapTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedWrapTarget, CheckedWrapTarget>(builder, linux_arm64);
    Build::select_provider<SelectedWrapTarget, CheckedWrapTarget>(builder, macos_arm64);
    Build::select_provider<SelectedWrapTarget, CheckedWrapTarget>(builder, windows_x86_64);

    Build::application(builder, "unsigned_8bit_wrapping_subtraction_bound_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
