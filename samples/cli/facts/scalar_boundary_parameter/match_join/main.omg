// An issued scalar is at least 100; a boundary parameter preserves membership and justifies exact subtraction.
// Expected exit: 0.
const START: u64 = 100;
domain u64::AtLeast100 requires self >= 100 established by issue;
boundary trait Consume { machine subtract(value: u64 in AtLeast100) -> u64 reaches; }
Actual satisfies Consume {
    machine subtract(value: u64 in AtLeast100) -> u64 { value - 100 }
}
machine issue(value: u64) -> u64 in AtLeast100 requires value >= 100 { value }

machine mark_issued(value: u64 in AtLeast100, route: &mut u64, marker: u64) -> u64 in AtLeast100 {
    route = marker;
    value
}
machine choose(value: u64 in AtLeast100, route: &mut u64) -> u64 in AtLeast100 {
    transition value == 100 { true -> mark_issued(value, route, 17) _ -> mark_issued(value, route, 23) }
}

machine main() crashes Trap {
    let mut first_route: u64 = 0;
    let value: u64 in AtLeast100 = choose(issue(START), &mut first_route);
    let difference: u64 = Consume::subtract(value);
    let mut second_route: u64 = 0;
    let second_value: u64 in AtLeast100 = choose(issue(101), &mut second_route);
    let second_difference: u64 = Consume::subtract(second_value);
    transition difference == 0 && second_difference == 1 && first_route == 17 && second_route == 23 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
