// An issued scalar is at least 100; a boundary parameter preserves membership and justifies exact subtraction.
// Expected exit: 0.
const START: u64 = 99;
domain u64::AtLeast100 requires self >= 100 established by issue;
boundary trait Consume { machine subtract(value: u64 in AtLeast100) -> u64 reaches; }
Actual satisfies Consume {
    machine subtract(value: u64 in AtLeast100) -> u64 { value - 100 }
}
machine issue(value: u64) -> u64 in AtLeast100 requires value >= 100 { value }


boundary trait TargetSubtract { machine target_subtract(value: u64 in AtLeast100) -> u64 reaches Consume; }
TargetSubtractCode satisfies TargetSubtract {
 machine target_subtract(value: u64 in AtLeast100) -> u64 reaches Consume { Consume::subtract(value) }
}

machine main() reaches Consume, TargetSubtract crashes Trap {
    let difference: u64 = TargetSubtract::target_subtract(issue(START));
    let second_difference: u64 = TargetSubtract::target_subtract(issue(101));
    transition difference == 0 && second_difference == 1 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
