// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 40u8 && narrow <= 160u8) to u32 (narrow as u32) preserves the exact interval (wide >= 40u32 && wide <= 160u32), discharging exact 32-bit subtractions 160u32 - wide and wide - 40u32 across all nine places.
// Place: target_body. Each of four target bodies performs u8-to-u32 zero-extension and discharges subtraction bounds.
// Expected exit: 0

linux_x86_64 machine verify_target() -> i32 {
    let narrow: u8 = 100u8;
    let wide: u32 = narrow as u32;
    let headroom: u32 = 160u32 - wide;
    let margin: u32 = wide - 40u32;
    0i32
}

linux_arm64 machine verify_target() -> i32 {
    let narrow: u8 = 100u8;
    let wide: u32 = narrow as u32;
    let headroom: u32 = 160u32 - wide;
    let margin: u32 = wide - 40u32;
    0i32
}

macos_arm64 machine verify_target() -> i32 {
    let narrow: u8 = 100u8;
    let wide: u32 = narrow as u32;
    let headroom: u32 = 160u32 - wide;
    let margin: u32 = wide - 40u32;
    0i32
}

windows_x86_64 machine verify_target() -> i32 {
    let narrow: u8 = 100u8;
    let wide: u32 = narrow as u32;
    let headroom: u32 = 160u32 - wide;
    let margin: u32 = wide - 40u32;
    0i32
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
