// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 40u8 && narrow <= 160u8) to u32 (narrow as u32) preserves the exact interval (wide >= 40u32 && wide <= 160u32), discharging exact 32-bit subtractions 160u32 - wide and wide - 40u32 across all nine places.
// Place: field. The zero-extended u32 value is carried in a record field before discharging subtraction bounds.
// Expected exit: 0

data WideContainer {
    wide: u32;
}

machine compute_field(narrow: u8) -> i32
requires narrow >= 40u8 && narrow <= 160u8
{
    let container: WideContainer = WideContainer { wide: narrow as u32 };
    let headroom: u32 = 160u32 - container.wide;
    let margin: u32 = container.wide - 40u32;
    0i32
}

machine probe() -> i32 {
    compute_field(100u8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
