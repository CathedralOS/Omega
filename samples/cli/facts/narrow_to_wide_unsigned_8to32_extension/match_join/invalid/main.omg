// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 40u8 && narrow <= 160u8) to u32 (narrow as u32) preserves the exact interval (wide >= 40u32 && wide <= 160u32), discharging exact 32-bit subtractions 160u32 - wide and wide - 40u32 across all nine places.
// Invalid: match join result upper bound 161 allows underflow in 160u32 - wide. Place: match_join.
// Expected diagnostic: may overflow `u32`

machine choose_wide(flag: bool, narrow: u8) -> u32
requires narrow >= 40u8 && narrow <= 161u8
ensures result >= 40u32 && result <= 161u32
{
    match flag {
        true -> narrow as u32,
        false -> narrow as u32,
    }
}

machine compute_join(narrow: u8) -> i32
requires narrow >= 40u8 && narrow <= 161u8
{
    let wide: u32 = choose_wide(true, narrow);
    let headroom: u32 = 160u32 - wide;
    let margin: u32 = wide - 40u32;
    0i32
}

machine probe() -> i32 {
    compute_join(100u8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
