// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 40u8 && narrow <= 160u8) to u32 (narrow as u32) preserves the exact interval (wide >= 40u32 && wide <= 160u32), discharging exact 32-bit subtractions 160u32 - wide and wide - 40u32 across all nine places.
// Invalid: successor state bound allows wide 161, causing 160u32 - wide to underflow. Place: other_state.
// Expected diagnostic: may overflow `u32`

machine verify_state(narrow: u8) -> i32
requires narrow >= 40u8 && narrow <= 161u8
{
    transition {
        _ -> step(narrow as u32)
    }
    machine step(wide: u32) -> i32
    requires wide >= 40u32 && wide <= 161u32
    {
        let headroom: u32 = 160u32 - wide;
        let margin: u32 = wide - 40u32;
        0i32
    }
}

machine probe() -> i32 {
    verify_state(100u8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
