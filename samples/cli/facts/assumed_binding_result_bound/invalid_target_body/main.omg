// The root-assumed u32 result <= 1 survives this boundary and indexes [7, 11] of length 2, observing 11; Supplied::get retains its own contract.
// Expected rejection: cannot prove index at the length-2 indexing operation.
boundary trait Required { machine get() -> u32 reaches ensures result <= 2; }
boundary trait Supplied { machine get() -> u32 reaches; }
Actual satisfies Supplied { machine get() -> u32 { 1 } }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedExercise {
    machine exercise() -> u32 reaches Required reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap;
}
X86Exercise satisfies SelectedExercise {
    machine exercise() -> u32 reaches Required reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let values: [u32; 2] = [7, 11];
        values[Required::get()]
    }
}
ArmExercise satisfies SelectedExercise {
    machine exercise() -> u32 reaches Required reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let values: [u32; 2] = [7, 11];
        values[Required::get()]
    }
}

machine main() reaches Required, SelectedBodyCheck crashes Trap {
    let observed: u32 = SelectedExercise::exercise();
    transition observed == 11 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
