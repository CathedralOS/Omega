// Expected rejection: incompatible or unsupported operational/lifetime correspondence
boundary trait Required { machine get<'a, 'b>(left: &'a u32, right: &'b u32) -> u32 ensures result <= 1; }
boundary trait Supplied { machine get<'a>(left: &'a u32, right: &'a u32) -> u32; }
Actual satisfies Supplied { machine get<'a>(left: &'a u32, right: &'a u32) -> u32 { 1 } }
machine main() reaches Required crashes Trap {
    let seed: u32 = 0;
    let values: [u32; 2] = [7, 11];
    let observed: u32 = values[Required::get(&seed, &seed)];
    transition observed == 11 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
