// Expected rejection: incompatible runtime carriers, parameter order or passing modes
boundary trait Required { machine get(value: &u32) -> u32 ensures result <= 1; }
boundary trait Supplied { machine get(value: &mut u32) -> u32; }
Actual satisfies Supplied { machine get(value: &mut u32) -> u32 { 1 } }
machine main() reaches Required crashes Trap {
    let seed: u32 = 0;
    let values: [u32; 2] = [7, 11];
    let observed: u32 = values[Required::get(&seed)];
    transition observed == 11 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
