use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "scalar_domain_call_guarantee_target_body" };
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, linux_arm64);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, linux_x86_64);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, macos_arm64);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, macos_x86_64);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, windows_x86_64);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, local_unchecked);
    Build::select_provider::<|app|::Query, |app|::Actual>(builder, alpha_bootstrap);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::x86_entry);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedTargetRead, |app|::X86TargetRead>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedTargetRead, |app|::ArmTargetRead>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedTargetRead, |app|::X86TargetRead>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedTargetRead, |app|::ArmTargetRead>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedTargetRead, |app|::X86TargetRead>(builder, windows_x86_64);
}
