machine build(builder: &mut Build) {
    Build::application(builder, "scalar_domain_call_guarantee_target_body");
    Build::select_provider<Query, Actual>(builder, linux_arm64);
    Build::select_provider<Query, Actual>(builder, linux_x86_64);
    Build::select_provider<Query, Actual>(builder, macos_arm64);
    Build::select_provider<Query, Actual>(builder, macos_x86_64);
    Build::select_provider<Query, Actual>(builder, windows_x86_64);
    Build::select_provider<Query, Actual>(builder, uefi_x86_64);
    Build::select_provider<Query, Actual>(builder, cross_platform_cli);
    Build::select_provider<Query, Actual>(builder, local_unchecked);
    Build::select_provider<Query, Actual>(builder, alpha_bootstrap);
    Build::bind(builder, macos_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider<SelectedTargetRead, X86TargetRead>(builder, macos_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedTargetRead, ArmTargetRead>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedTargetRead, X86TargetRead>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedTargetRead, ArmTargetRead>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedTargetRead, X86TargetRead>(builder, windows_x86_64);
}
