// A completed query guarantees a nonnegative result; routed domain introduction preserves that fact.
// Expected exit: 0.
const FLOOR: i64 = -1;
domain i64::Nonnegative requires self >= 0 established by issue;
boundary trait Query { machine read(input: i64) -> i64 reaches ensures result >= FLOOR; }
Actual satisfies Query {
    machine read(input: i64) -> i64 ensures result >= FLOOR {
        transition input >= FLOOR { true -> (input) _ -> (FLOOR) }
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedTargetRead {
    machine target_read(input: i64) -> i64 ensures result >= FLOOR reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Query crashes Trap;
}
X86TargetRead satisfies SelectedTargetRead {
    machine target_read(input: i64) -> i64 ensures result >= FLOOR reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Query crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);     Query::read(input)
    }
}
ArmTargetRead satisfies SelectedTargetRead {
    machine target_read(input: i64) -> i64 ensures result >= FLOOR reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Query crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);     Query::read(input)
    }
}

machine issue(input: i64) -> i64 in Nonnegative {
    let value: i64 = SelectedTargetRead::target_read(input);
    value
}

machine main() crashes Trap {
    let value: i64 in Nonnegative = issue(17);
    transition value == 17 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
