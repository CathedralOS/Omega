// Expected exit: 0.
// Checked fence sequences retain their catalog target, ordering and exact empty clobber set while carrying input 37 to a result requiring 37.

linux_x86_64 machine ordered(input: u32) -> u32 requires input == 37 ensures result == 37 {
    asm where clobbers none {
    entry requires input == 37 ensures input == 38:
        lfence;
        sfence;
        mfence
    }
    input
}

windows_x86_64 machine ordered(input: u32) -> u32 requires input == 37 ensures result == 37 {
    asm where clobbers none {
    entry requires input == 37 ensures input == 38:
        lfence;
        sfence;
        mfence
    }
    input
}

linux_arm64 machine ordered(input: u32) -> u32 requires input == 37 ensures result == 37 {
    asm where clobbers none {
    entry requires input == 37 ensures input == 38:
        dmb ld;
        dmb st;
        dmb sy
    }
    input
}

macos_arm64 machine ordered(input: u32) -> u32 requires input == 37 ensures result == 37 {
    asm where clobbers none {
    entry requires input == 37 ensures input == 38:
        dmb ld;
        dmb st;
        dmb sy
    }
    input
}

machine finished() {}
machine failed() crashes Trap { crash Trap; }
machine consume(value: u32) requires value == 37 crashes Trap {
    transition value == 37 { true -> finished() false -> failed() }
}
machine main() crashes Trap {
    let value: u32 = ordered(37);
    consume(value);
}
