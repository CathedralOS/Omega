use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "checked_asm_fence_contracts_target_body" };
    Build::select_provider::<|app|::SelectedOrdered, |app|::X86Ordered>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedOrdered, |app|::X86Ordered>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedOrdered, |app|::ArmOrdered>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedOrdered, |app|::ArmOrdered>(builder, macos_arm64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
