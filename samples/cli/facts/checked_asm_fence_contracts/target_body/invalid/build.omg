machine build(builder: &mut Build) {
    Build::application(builder, "checked_asm_fence_contracts_target_body_invalid");
    Build::select_provider<SelectedOrdered, X86Ordered>(builder, linux_x86_64);
    Build::select_provider<SelectedOrdered, X86Ordered>(builder, windows_x86_64);
    Build::select_provider<SelectedOrdered, ArmOrdered>(builder, linux_arm64);
    Build::select_provider<SelectedOrdered, ArmOrdered>(builder, macos_arm64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
