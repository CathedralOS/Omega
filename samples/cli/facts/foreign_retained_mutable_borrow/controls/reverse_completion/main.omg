// Fact: A mutable foreign registration retains exclusive access to the exact original Buffer backing until completion consumes Pending; completion writes 73 while an earlier copied value remains 37.
// Expected exit: 0. Completion changes the original cell to 73; prior copied value stays 37.
use {omega}/language/core/content.omg;
public data ByteUnit {}
public data Buffer [linear] dropped by drop_buffer { value: u64; }
machine drop_buffer(buffer: @mutable Buffer) {}
public domain Buffer::Owned;
machine Owned::content(buffer: @Buffer) -> |content|::CountedQuantity<ByteUnit>
satisfies |content|::Content<Buffer, |content|::CountedQuantity<ByteUnit>>::project {
    |content|::CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Pending<'source> [linear] { slot: u64; }
public domain Pending::Retained established by Writer::register;
machine Retained::content<'source>(pending: @Pending<'source>) -> |content|::CountedQuantity<ByteUnit>
satisfies |content|::Content<Pending<'source>, |content|::CountedQuantity<ByteUnit>>::project {
    |content|::CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Capacity [linear] { token: u64; }
public domain Capacity::Available established by Writer::acquire, Writer::complete;
public boundary trait Writer {
    machine acquire() -> Capacity reaches none ensures result in Capacity::Available crashes Trap;
    machine register<'source>(capacity: Capacity in Capacity::Available, buffer: @'source mutable Buffer in Buffer::Owned) -> Pending<'source>
    reaches none
    ensures result in Pending::Retained, buffer in Buffer::Owned crashes Trap;
    machine complete<'source>(pending: Pending<'source> in Pending::Retained, observed: @mutable u64) -> Capacity
    reaches none
    ensures result in Capacity::Available crashes Trap;
    machine release(capacity: Capacity in Capacity::Available) reaches none crashes Trap;
}

machine forward<'a>(pending: Pending<'a> in Pending::Retained) -> Pending<'a>
ensures result in Pending::Retained { pending }
data Main {}
machine Main::main(main: @mutable Main) reaches Writer crashes Trap {
    let first_capacity: Capacity in Capacity::Available = Writer::acquire();
    let second_capacity: Capacity in Capacity::Available = Writer::acquire();
    let mutable first: Buffer in Buffer::Owned = Buffer { value: 37 };
    let mutable second: Buffer in Buffer::Owned = Buffer { value: 91 };
    let original: u64 = first.value;
    let first_pending: Pending = Writer::register(first_capacity, @mutable first);
    let second_pending: Pending = Writer::register(second_capacity, @mutable second);
    let routed_first: Pending in Pending::Retained = forward(first_pending);
    let routed_second: Pending in Pending::Retained = forward(second_pending);
    let mutable first_observed: u64 = 0;
    let mutable second_observed: u64 = 0;
    let second_returned: Capacity in Capacity::Available = Writer::complete(routed_second, @mutable second_observed);
    Writer::release(second_returned);
    let first_returned: Capacity in Capacity::Available = Writer::complete(routed_first, @mutable first_observed);
    Writer::release(first_returned);
    let first_value: u64 = first.value;
    let second_value: u64 = second.value;
    drop(first);
    drop(second);
    transition first_observed == 73 && second_observed == 73 && first_value == 73 && second_value == 73 && original == 37 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine entry_start() reaches Writer crashes Trap {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
