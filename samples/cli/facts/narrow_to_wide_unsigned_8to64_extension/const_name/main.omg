// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 50u8 && narrow <= 180u8) to u64 (narrow as u64) preserves the exact interval (wide >= 50u64 && wide <= 180u64), discharging exact 64-bit subtractions 180u64 - wide and wide - 50u64 across all nine places.
// Expected exit: 0

const MAX_WIDE: u64 = 180u64;
const MIN_WIDE: u64 = 50u64;

machine probe(narrow: u8) -> u64
    requires narrow >= 50u8 && narrow <= 180u8
{
    let wide: u64 = narrow as u64;
    let headroom: u64 = MAX_WIDE - wide;
    let margin: u64 = wide - MIN_WIDE;
    headroom + margin
}

machine main() crashes Trap {
    let combined: u64 = probe(110u8);
    transition combined == 130u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
