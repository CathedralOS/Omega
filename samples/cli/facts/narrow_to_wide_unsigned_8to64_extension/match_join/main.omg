// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 50u8 && narrow <= 180u8) to u64 (narrow as u64) preserves the exact interval (wide >= 50u64 && wide <= 180u64), discharging exact 64-bit subtractions 180u64 - wide and wide - 50u64 across all nine places.
// Expected exit: 0

machine choose(flag: bool, first: u64, second: u64) -> u64
    requires first >= 50u64 && first <= 180u64 && second >= 50u64 && second <= 180u64
    ensures result >= 50u64 && result <= 180u64
{
    transition flag {
        true -> first
        false -> second
    }
}

machine probe(flag: bool, narrow: u8) -> u64
    requires narrow >= 50u8 && narrow <= 180u8
{
    let wide: u64 = narrow as u64;
    let joined: u64 = choose(flag, wide, 110u64);
    let headroom: u64 = 180u64 - joined;
    let margin: u64 = joined - 50u64;
    headroom + margin
}

machine main() crashes Trap {
    let combined: u64 = probe(true, 110u8);
    transition combined == 130u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
