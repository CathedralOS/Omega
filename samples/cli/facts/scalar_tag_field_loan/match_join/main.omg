// Expected exit: 0
// Fact: a shared tagged scalar-field loan keeps its original backing and value 73 while computing value ^ 0.
data Cell { value: u32; }
domain u32::Controlled;
machine consume(value: &u32 in Controlled) -> u32 { value ^ 0 }
machine choose() -> bool { true }
machine main() crashes Trap {
    let mut storage: Cell = Cell { value: 73 };
    let selected: &u32 in Controlled = &storage.value;
    let other_storage: Cell = Cell { value: 73 };
    let other: &u32 in Controlled = &other_storage.value;
    let choice: bool = choose();
    let joined: &u32 in Controlled = match choice { true -> selected false -> other };
    let result: u32 = consume(joined);
    transition result == 73 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
