// Invalid: a conformance binder cannot become a same-named global formal data type.
data Evidence [copy] { value: u64; }
trait Probe<Value> { machine probe(value: &Value) -> u64; }
Positive satisfies Probe<[u8; 2]> { machine probe(value: &[u8; 2]) -> u64 { 7 } }
machine selected<Length [copy], const Capacity: u64, Evidence satisfies Probe<Length>>(items: Length, other: Evidence) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine main() {
    let items: [u8; 2] = [7, 11];
    let observed: u64 = selected<[u8; 2], Positive>(items, Evidence { value: 0 });
}
