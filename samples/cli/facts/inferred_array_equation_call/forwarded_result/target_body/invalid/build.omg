machine build(builder: &mut Build) {
    Build::select_provider<SelectedConsume, LinuxX8664Consume>(builder, linux_x86_64);
    Build::select_provider<SelectedConsume, WindowsX8664Consume>(builder, windows_x86_64);
    Build::select_provider<SelectedConsume, WindowsX8664Consume>(builder, macos_arm64);
    Build::select_provider<SelectedConsume, WindowsX8664Consume>(builder, linux_arm64);

    Build::application(builder, "inferred_array_equation_call_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
