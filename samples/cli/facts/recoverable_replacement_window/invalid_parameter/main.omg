// Expected exit: 0
// A consuming recoverable result restores its exact borrowed place and preserves disjoint storage.
data Token [linear] dropped by drop_token { value: u64; }
machine drop_token(token: @mutable Token) {}
data Outcome { case Success(token: Token); case Failure(token: Token); }
data Holder { token: Token; sibling: u64; }
machine attempt(token: Token, succeed: bool, observed: u64) -> Outcome {
    transition succeed {
        true -> success(token),
        _ -> Outcome::Failure { token: token }
    }
    machine success(token: Token) -> Outcome {
        let value: u64 = token.value;
        drop(token);
        Outcome::Success { token: Token { value: ((value as +Wrapping) + 1) as u64 } }
    }
}
machine recover(outcome: Outcome) -> Token {
    transition outcome {
        Outcome::Success { token } -> token,
        Outcome::Failure { token } -> token
    }
}
machine observe(sibling: @mutable u64) -> u64 { $sibling = 19; $sibling }
machine repair(holder: @mutable Holder, succeed: bool) {
    let alias: @mutable Token = @mutable holder.token;
    let first: Outcome = attempt($alias, succeed, observe(@mutable holder.sibling));
    $alias = match first {
        Outcome::Success { token } -> token,
        Outcome::Failure { token } -> token
    };
    let detached: Token = $alias;
    let second: Outcome = attempt(detached, succeed, observe(@mutable holder.sibling));
    drop(recover(second));
}
machine main() crashes Trap {
    let mutable holder: Holder = Holder { token: Token { value: 42 }, sibling: 7 };
    repair(@mutable holder, false);
    repair(@mutable holder, true);
    finish(holder);
}
machine finish(holder: Holder) crashes Trap {
    let correct: bool = holder.token.value == 44 && holder.sibling == 19;
    drop(holder.token);
    transition correct { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
