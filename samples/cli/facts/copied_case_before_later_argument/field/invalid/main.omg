// A copied Present payload of 7 stays readable after a later argument replaces its source with Absent.
// Place: field.
// Expected exit: 0
data Slot [copy] { case Absent; case Present(value: u64); }

machine set_to_absent(slot: &mut Slot) -> u64 {
    slot = Slot::Absent {};
    0
}

machine read_payload(before: Slot, marker: u64) -> u64
requires before in Slot::Present
{
    before.value
}

data Holder { left_guard: u64; chosen: Slot; right_guard: u64; }

machine main() crashes Trap {
    let mut holder: Holder = Holder { left_guard: 101, chosen: Slot::Absent {}, right_guard: 107 };
    let observed: u64 = read_payload(holder.chosen, set_to_absent(&mut holder.chosen));
    transition observe_replacement(observed, holder.chosen) == 7 && holder.left_guard == 101 && holder.right_guard == 107 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

// Observe the activation that owns the later replacement, after the payload read.
machine observe_replacement(observed: u64, after: Slot) -> u64 {
    match after in Slot::Absent {
        true -> observed
        false -> 99
    }
}
