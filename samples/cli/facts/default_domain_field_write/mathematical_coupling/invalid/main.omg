// Expected exit: 0
// Restoring Budget's mathematical default domain permits exact capacity - used.
data Budget [copy]
requires embed(self.used) + embed(self.free) == embed(self.capacity)
{ used: u64; free: u64; capacity: u64; }
machine consume(budget: &mut Budget)
requires budget.used == 0, budget.free == 32, budget.capacity == 32
{
    budget.used = 16;
    budget.free = 17;
}
machine available(budget: Budget) -> u64 { budget.capacity - budget.used }
machine main() crashes Trap {
    let mut budget: Budget = Budget { used: 0, free: 32, capacity: 32 };
    consume(&mut budget);
    let remaining: u64 = available(budget);
    transition budget.used == 16 && budget.free == 16 && budget.capacity == 32 && remaining == 16 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
