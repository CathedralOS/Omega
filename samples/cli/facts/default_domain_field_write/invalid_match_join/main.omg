// A field write that preserves Interval's default domain keeps self.hi <= 4, so 4 - hi is exact.
// This write sets hi to 9, outside self.hi <= 4, and must reject.
data Interval [copy]
    requires (self in Interval::Empty)
       || ((self in Interval::Range) && self.lo <= self.hi && self.hi <= 4)
{
    case Empty;
    case Range(lo: u64, hi: u64);
}
machine consume(span: Interval) -> u64 {
    match span {
        Interval::Range { hi, .. } -> 4 - hi
        Interval::Empty -> 0
    }
}
machine joined(flag: bool) -> u64 {
    let mut narrow: Interval = Interval::Range { lo: 1, hi: 2 };
    let mut wide: Interval = Interval::Range { lo: 0, hi: 1 };
    narrow.hi = 9;
    wide.hi = 2;
    let span: Interval = match flag { true -> narrow, false -> wide };
    consume(span)
}
machine main() crashes Trap {
    let empty: Interval = Interval::Empty;
    transition joined(true) == 1 && joined(false) == 2 && consume(empty) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
