// Querying size_of and align_of on a multi-variant case type establishes its exact discriminant-plus-payload layout geometry, discharging exact subtraction size - (align * 2u64).
// Invalid: payloadless case variant reduces type size and alignment, breaking exact subtraction.

data Packet {
    case Empty;
    case Other;
}

boundary trait SelectedComputeGeometry {
    machine compute_geometry() -> u64 reaches
;
}
CheckedComputeGeometry satisfies SelectedComputeGeometry {
    machine compute_geometry() -> u64
{
    size_of<Packet>() - (align_of<Packet>() * 2u64)
}
}







machine probe() -> u64 {
    SelectedComputeGeometry::compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
