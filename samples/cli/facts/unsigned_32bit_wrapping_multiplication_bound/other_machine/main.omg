// Fact: 32-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u32 <= prod <= 200u32 establishes 50u32 <= prod <= 200u32 across all nine places so exact subtractions 200u32 - prod and prod - 50u32 are safe.
// Place: another machine. The product is forwarded to another machine for interval verification.
// Expected exit: 0

machine forward_eval(p: u32) -> i32
    requires p >= 50u32 && p <= 200u32;
{
    let headroom: u32 = 200u32 - p;
    let margin: u32 = p - 50u32;
    transition p == 120u32 && headroom + margin == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine multiply_other_machine(lhs: u32, rhs: u32) -> i32
    requires lhs >= 10u32 && lhs <= 20u32;
    requires rhs >= 5u32 && rhs <= 10u32;
{
    let a: u32 in Wrapping = lhs as u32 in Wrapping;
    let b: u32 in Wrapping = rhs as u32 in Wrapping;
    let p_wrap: u32 in Wrapping = a * b;
    let prod: u32 = p_wrap as u32;
    forward_eval(prod)
}

machine main() crashes Trap {
    let res: i32 = multiply_other_machine(15u32, 8u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
