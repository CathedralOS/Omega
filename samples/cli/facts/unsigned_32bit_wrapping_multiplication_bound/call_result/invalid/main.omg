// Fact: 32-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u32 <= prod <= 200u32 establishes 50u32 <= prod <= 200u32 across all nine places so exact subtractions 200u32 - prod and prod - 50u32 are safe.
// Place: call result. The product is received from a helper call returning the wrapping multiplication result.
// Invalid control: lhs upper bound widened to 21u32, allowing prod up to 210u32 and failing exact headroom subtraction.
// Expected rejection: may overflow `u32`

machine compute_wrap_prod(l: u32, r: u32) -> u32
    requires l >= 10u32 && l <= 21u32;
    requires r >= 5u32 && r <= 10u32;
    ensures result >= 50u32 && result <= 210u32;
{
    let a: u32 in Wrapping = l as u32 in Wrapping;
    let b: u32 in Wrapping = r as u32 in Wrapping;
    let p_wrap: u32 in Wrapping = a * b;
    p_wrap as u32
}

machine multiply_call_result(lhs: u32, rhs: u32) -> i32
    requires lhs >= 10u32 && lhs <= 21u32;
    requires rhs >= 5u32 && rhs <= 10u32;
{
    let prod: u32 = compute_wrap_prod(lhs, rhs);
    let headroom: u32 = 200u32 - prod;
    let margin: u32 = prod - 50u32;
    transition prod == 120u32 && headroom + margin == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_call_result(15u32, 8u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
