// Fact: 32-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u32 <= prod <= 200u32 establishes 50u32 <= prod <= 200u32 across all nine places so exact subtractions 200u32 - prod and prod - 50u32 are safe.
// Place: const name. The bounds and product limits reference declared symbolic constants.
// Expected exit: 0

const LHS_MIN: u32 = 10u32;
const LHS_MAX: u32 = 20u32;
const RHS_MIN: u32 = 5u32;
const RHS_MAX: u32 = 10u32;
const PROD_MIN: u32 = 50u32;
const PROD_MAX: u32 = 200u32;

machine multiply_const(lhs: u32, rhs: u32) -> i32
    requires lhs >= LHS_MIN && lhs <= LHS_MAX;
    requires rhs >= RHS_MIN && rhs <= RHS_MAX;
{
    let a: u32 in Wrapping = lhs as u32 in Wrapping;
    let b: u32 in Wrapping = rhs as u32 in Wrapping;
    let p_wrap: u32 in Wrapping = a * b;
    let prod: u32 = p_wrap as u32;
    let headroom: u32 = PROD_MAX - prod;
    let margin: u32 = prod - PROD_MIN;
    transition prod == 120u32 && headroom + margin == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_const(15u32, 8u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
