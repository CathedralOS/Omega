// Fact: 32-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u32 <= prod <= 200u32 establishes 50u32 <= prod <= 200u32 across all nine places so exact subtractions 200u32 - prod and prod - 50u32 are safe.
// Place: match join. The product is synthesized across conditional match branches.
// Expected exit: 0

machine multiply_match_join(lhs: u32, rhs: u32, choose: bool) -> i32
    requires lhs >= 10u32 && lhs <= 20u32;
    requires rhs >= 5u32 && rhs <= 10u32;
{
    let a: u32 in Wrapping = lhs as u32 in Wrapping;
    let b: u32 in Wrapping = rhs as u32 in Wrapping;
    let prod: u32 = match choose {
        true -> (a * b) as u32,
        false -> (a * b) as u32
    };
    let headroom: u32 = 200u32 - prod;
    let margin: u32 = prod - 50u32;
    transition prod == 120u32 && headroom + margin == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = multiply_match_join(15u32, 8u32, true);
    let res2: i32 = multiply_match_join(15u32, 8u32, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
