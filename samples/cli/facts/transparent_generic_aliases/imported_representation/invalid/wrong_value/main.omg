// Expected exit: 0
// Alias and explicit expansion interchange without conversion; the imported
// policy keeps its computed constant and the original 42/byte-offset oracles.
use omega::language::core::layout;
use leaf::values;
const ZERO: u64 = 0u64;
machine round_trip<Pair>(value: LayoutStorage<leaf::values::Pair, leaf::values::PairLayout<1u64>>) -> leaf::values::PairRepresented<leaf::values::PairLayout<1u64>> { value }
machine main() crashes Trap {
    let mut represented: leaf::values::SelectedPair<(ZERO + 1u64)>;
    represented.lo = 41u64;
    represented.hi = 9u64;
    let explicit: LayoutStorage<leaf::values::Pair, leaf::values::PairLayout<1u64>> = represented;
    let same: leaf::values::Represented<leaf::values::Pair, leaf::values::PairLayout<1u64>> = round_trip<u8>(explicit);
    let bytes: &[u8; 16] = &same as &[u8; 16];
    transition same.lo == 42u64 && same.hi == 9u64 && bytes[8] == 42u8 && bytes[0] == 9u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
