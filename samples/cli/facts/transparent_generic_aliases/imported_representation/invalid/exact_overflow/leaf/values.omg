module values;
use omega::language::core::layout;
public domain u64::Delivered requires self >= 42u64 && self <= 42u64;
public data Pair [copy] { lo: u64 in Delivered; hi: u64; }
public PairLayout<const Marker: u64> satisfies FixedLayout<Pair> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 8 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 0 } };
        LayoutPlan { entries: entries, entry_count: 2, size_fixed: 16, size_is_dynamic: false, align: 8 }
    }
}

// These declarations contribute no nominal or ABI identity.
public data Represented<T, Policy satisfies FixedLayout<T>> = LayoutStorage<T, Policy>;
public data PairRepresented<Policy satisfies FixedLayout<Pair>> = Represented<Pair, Policy>;
public data SelectedPair<const Marker: u64> = PairRepresented<PairLayout<Marker>>;
data PrivatePair = SelectedPair<1u64>;

public data Forget<T [copy]> = u64;
public data Resource { value: u64; }
