use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    Build::select_provider::<|app|::SelectedForward, |app|::ArrayForward>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedForward, |app|::ArrayForward>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedForward, |app|::ArrayForward>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedForward, |app|::ArrayForward>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedForward, |app|::ArrayForward>(builder, macos_x86_64);
    builder.product = BuildProduct::Application { name: "alias_rhs_captured_supplier_target_body" };
    let mutable leaf_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "leaf" });
    |dependency|::with_alias(@mutable leaf_dependency, "leaf");
    let leaf_registration: DependencyRegistration = Build::dependency(builder, leaf_dependency);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::main);
}
