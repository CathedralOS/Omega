// Fact: A default trait member keeps an alias's captured const supplier separate from its same-named fresh invocation binder while forwarding the same array value.
// Expected exit: 0
use leaf::buffers;
machine observe(value: &[u8; 4]) -> u8 { value[3u64] }
machine joined(flag: bool) -> bool {
    let Count: u64 = 17u64;
    let Bias: u64 = 9u64;
    let original: leaf::buffers::Padded<3u64> = [17u8, 0u8, 0u8, 42u8];
    let alternate: [u8; 4] = [17u8, 0u8, 0u8, 42u8];
    let represented: leaf::buffers::Padded<3u64> = match flag { true -> original, false -> alternate };
    let forwarded: [u8; 4] = leaf::buffers::Selected<3u64>::forward<17u64>(represented);
    let alias_again: leaf::buffers::Padded<3u64> = forwarded;
    observe(&alias_again) == 42u8 && represented[0u64] == 17u8 && Count == 17u64 && Bias == 9u64
}
machine main() crashes Trap {
    transition joined(true) && joined(false) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
