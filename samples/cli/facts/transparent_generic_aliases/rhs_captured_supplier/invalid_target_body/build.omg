machine build(builder: &mut Build) {
    Build::select_provider<SelectedForward, ArrayForward>(builder, windows_x86_64);
    Build::select_provider<SelectedForward, ArrayForward>(builder, linux_x86_64);
    Build::select_provider<SelectedForward, ArrayForward>(builder, macos_arm64);
    Build::select_provider<SelectedForward, ArrayForward>(builder, linux_arm64);
    Build::select_provider<SelectedForward, ArrayForward>(builder, macos_x86_64);
    Build::application(builder, "alias_rhs_captured_supplier_target_body");
    let mut leaf_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "leaf" });
    dependency::with_alias(&mut leaf_dependency, "leaf");
    let leaf_registration: DependencyRegistration = Build::dependency(builder, leaf_dependency);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
}
