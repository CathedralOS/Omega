module choices;
public data Scalar<T [copy]> [copy] { value: T; }
public data Choice<T [copy]> [copy] {
    case Some(value: T);
    case Empty;
}
public data Chosen<T [copy]> = Choice<T>;
public machine produce(pick: bool, value: u64) -> Chosen<u64> {
    transition pick {
        true -> Chosen::Some { value: true }
        false -> Chosen::Empty
    }
}
