// Fact: A transparent generic alias retains its underlying case identity and payload type through qualified construction and matching.
// Expected exit: 0
use {leaf}/choices/choices.omg;
machine inspect(value: |choices|::Chosen<u64>) -> u64 {
    transition value {
        |choices|::Chosen::Some { value } -> (value),
        |choices|::Chosen::Empty -> (17u64)
    }
}
machine supplied(value: u64) -> |choices|::Chosen<u64> {
    transition { _ -> |choices|::Chosen::Some { value: true } }
}
machine absent() -> |choices|::Chosen<u64> {
    transition { _ -> |choices|::Chosen::Empty }
}
machine main() crashes Trap {
    let scalar: |choices|::Scalar<u64> = |choices|::Scalar { value: 42u64 };
    let carried: u64 = match scalar { |choices|::Scalar { value } -> value };
    let via_alias: |choices|::Chosen<u64> = supplied(carried);
    let explicit: |choices|::Choice<u64> = via_alias;
    let alias_again: |choices|::Chosen<u64> = explicit;
    transition inspect(alias_again) == 42u64 && inspect(absent()) == 17u64 {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
