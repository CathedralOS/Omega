// Fact: A transparent generic alias retains its underlying case identity and payload type through qualified construction and matching.
// Expected exit: 0
use leaf::choices;
machine inspect(value: leaf::choices::Chosen<u64>) -> u64 {
    transition value {
        leaf::choices::Chosen::Some { value } -> (value)
        leaf::choices::Chosen::Empty -> (17u64)
    }
}
boundary trait SelectedCases {
    machine produce(pick: bool, value: u64) -> leaf::choices::Chosen<u64> reaches;
}
CaseFactory satisfies SelectedCases {
    machine produce(pick: bool, value: u64) -> leaf::choices::Chosen<u64> {
        transition pick {
            true -> leaf::choices::Chosen::Some { value: true }
            false -> leaf::choices::Chosen::Empty
        }
    }
}
machine main() crashes Trap {
    let scalar: leaf::choices::Scalar<u64> = leaf::choices::Scalar { value: 42u64 };
    let carried: u64 = match scalar { leaf::choices::Scalar { value } -> value };
    let via_alias: leaf::choices::Chosen<u64> = SelectedCases::produce(true, carried);
    let explicit: leaf::choices::Choice<u64> = via_alias;
    let alias_again: leaf::choices::Chosen<u64> = explicit;
    transition inspect(alias_again) == 42u64 && inspect(SelectedCases::produce(false, carried)) == 17u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
