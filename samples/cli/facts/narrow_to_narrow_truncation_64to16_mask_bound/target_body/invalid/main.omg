// Fact: narrowing a masked unsigned 64-bit integer to u16 and zero-extending back to u64 ((val & 63u64) as u16 as u64) preserves the exact mask upper bound (truncated <= 63u64), discharging exact subtraction 63u64 - truncated across all nine places.
// Expected exit: 0

machine verify(diff: u64) crashes Trap {
    transition diff == 45u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

linux_x86_64 machine exercise(truncated: u64) requires truncated <= 64u64 crashes Trap {
    let diff: u64 = 63u64 - truncated;
    verify(diff);
}

linux_arm64 machine exercise(truncated: u64) requires truncated <= 64u64 crashes Trap {
    let diff: u64 = 63u64 - truncated;
    verify(diff);
}

macos_arm64 machine exercise(truncated: u64) requires truncated <= 64u64 crashes Trap {
    let diff: u64 = 63u64 - truncated;
    verify(diff);
}

windows_x86_64 machine exercise(truncated: u64) requires truncated <= 64u64 crashes Trap {
    let diff: u64 = 63u64 - truncated;
    verify(diff);
}

machine main() crashes Trap {
    let val: u64 = 466u64;
    exercise((val & 64u64) as u16 as u64);
}
