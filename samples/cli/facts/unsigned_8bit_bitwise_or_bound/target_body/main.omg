// Fact: 8-bit unsigned bitwise OR base | 32u8 with bounded interval 40u8 <= combined <= 63u8 establishes 40u8 <= combined <= 63u8 across all nine places so exact subtractions 63u8 - combined and combined - 40u8 are safe.
// Expected exit: 0

machine verify_combined(value: u8) -> u8
requires value >= 40u8 && value <= 63u8
{
    let headroom: u8 = 63u8 - value;
    let margin: u8 = value - 40u8;
    transition headroom == 11u8 && margin == 12u8 {
        true -> 0u8
        _ -> 1u8
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(base: u8) -> u8
        reaches SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(base: u8) -> u8
        reaches SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let combined: u8 = base | 32u8;
        transition combined >= 40u8 && combined <= 63u8 {
            true -> step(combined)
            _ -> bad()
        }
        machine step(c: u8) -> u8 {
            verify_combined(c)
        }
        machine bad() -> u8 { crash Trap; }
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(base: u8) -> u8
        reaches SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let combined: u8 = base | 32u8;
        transition combined >= 40u8 && combined <= 63u8 {
            true -> step(combined)
            _ -> bad()
        }
        machine step(c: u8) -> u8 {
            verify_combined(c)
        }
        machine bad() -> u8 { crash Trap; }
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let rc: u8 = SelectedProbe::exercise(20u8);
    transition rc == 0u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
