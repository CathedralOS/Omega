// Expected exit: 0
// Replacing the exact captured window descriptor releases its displaced backing while retaining replacement and disjoint sibling loans.
// Expected exit: 0
// Replace the first scan window when the element is proved equal to zero.
// The caller writes the displaced backing and keeps the neighbor. The element
// arrives as a local, a field, a parameter, and a call result.
data Cell [copy] { value: u32; tag: u64; }
data Window<'input> { values: @'input mutable [Cell]; }
data Choice { slot: i32; }

machine first_slot() -> i32 ensures result == 0 { 0 }
machine last_slot() -> i32 ensures result == 1 { 1 }

machine replace<'carrier, 'input>(windows: @'carrier mutable [Window<'input>], slot: i32, replacement: @'input mutable [Cell])
requires windows.length == 2 && slot == 0 {
    windows[last_slot()].values = replacement;
}

machine replaced(values: @[Cell]) -> bool {
    transition values.length == 2 {
        true -> inspect(values),
        false -> false
    }
    machine inspect(values: @[Cell]) -> bool requires values.length == 2 {
        values[0].value == 42 && values[0].tag == 7 && values[1].value == 19 && values[1].tag == 29
    }
}

machine unchanged(values: @[Cell]) -> bool {
    transition values.length == 1 {
        true -> inspect(values),
        false -> false
    }
    machine inspect(values: @[Cell]) -> bool requires values.length == 1 {
        values[0].value == 31 && values[0].tag == 41
    }
}

machine check(windows: @mutable [Window], original: @mutable [Cell; 1]) -> bool
requires windows.length == 2
{
    original[0].value = 9;
    let valid: bool = replaced(windows[0].values);
    let adjacent: bool = unchanged(windows[1].values);
    valid && adjacent && original[0].value == 9 && original[0].tag == 17
}

machine exercise() crashes Trap {
    transition { _ -> selected(first_slot()) }
    machine selected(slot: i32) requires slot == 0 {
    let mutable original: [Cell; 1] = [Cell { value: 7, tag: 17 }];
    let mutable neighbor: [Cell; 1] = [Cell { value: 31, tag: 41 }];
    let mutable replacement: [Cell; 2] = [Cell { value: 42, tag: 7 }, Cell { value: 19, tag: 29 }];
    let mutable windows: [Window; 2] = [Window { values: @mutable original[..] }, Window { values: @mutable neighbor[..] }];
    windows[last_slot()].values = @mutable replacement[..];
    transition check(@mutable windows[..], @mutable original) {
        true -> done(),
        false -> bad()
    }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap { exercise(); }
