// Fact: an IEEE f64 ordered comparison guard (reading >= 1.5 && reading <= 2.5) establishes a finite, non-NaN sub-interval that satisfies a downstream contract requiring reading >= 1.0 && reading <= 3.0 across all nine places.
// Invalid: upper bound is 3.5 which exceeds downstream requires bound 3.0. Place: target_body.
// Expected diagnostic: cannot prove requires contract for call verify_window

data Reading [copy] requires value >= 1.5 && value <= 3.5 {
    value: f64;
}

machine verify_window(reading: f64) -> i32
requires reading >= 1.0 && reading <= 3.0
{
    0i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(reading: Reading) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine probe(reading: Reading) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_window(reading.value)
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(reading: Reading) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_window(reading.value)
    }
}

machine main() crashes Trap {
    let reading: Reading = Reading { value: 2.0 };
    transition SelectedProbe::probe(reading) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
