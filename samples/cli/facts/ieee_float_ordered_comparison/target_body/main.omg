// Fact: an IEEE f64 ordered comparison guard (reading >= 1.5 && reading <= 2.5) establishes a finite, non-NaN sub-interval that satisfies a downstream contract requiring reading >= 1.0 && reading <= 3.0 across all nine places.
// Place: target_body. Each of four target bodies forwards the bounded reading to verify_window.
// Expected exit: 0

data Reading [copy] where value >= 1.5 && value <= 2.5 {
    value: f64;
}

machine verify_window(reading: f64) -> i32
requires reading >= 1.0 && reading <= 3.0
{
    0i32
}

linux_x86_64 machine probe(reading: Reading) -> i32 {
    verify_window(reading.value)
}

linux_arm64 machine probe(reading: Reading) -> i32 {
    verify_window(reading.value)
}

macos_arm64 machine probe(reading: Reading) -> i32 {
    verify_window(reading.value)
}

windows_x86_64 machine probe(reading: Reading) -> i32 {
    verify_window(reading.value)
}

machine main() crashes Trap {
    let reading: Reading = Reading { value: 2.0 };
    transition probe(reading) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
