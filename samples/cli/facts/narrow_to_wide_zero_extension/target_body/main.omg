// Fact: zero-extending narrow unsigned 100u8 through u16 and u32 to u64 preserves the exact interval 100u64, discharging exact subtraction widened - 100u64 with exit code 0.
// Place: another target body. Each hosted target body computes and verifies the zero-extended value.
// Expected exit: 0

linux_x86_64 machine evaluate() -> i32 {
    let narrow: u8 = 100u8;
    let extended: u64 = ((narrow as u16) as u32) as u64;
    let sub: u64 = extended - 100u64;
    sub as i32
}

linux_arm64 machine evaluate() -> i32 {
    let narrow: u8 = 100u8;
    let extended: u64 = ((narrow as u16) as u32) as u64;
    let sub: u64 = extended - 100u64;
    sub as i32
}

macos_arm64 machine evaluate() -> i32 {
    let narrow: u8 = 100u8;
    let extended: u64 = ((narrow as u16) as u32) as u64;
    let sub: u64 = extended - 100u64;
    sub as i32
}

windows_x86_64 machine evaluate() -> i32 {
    let narrow: u8 = 100u8;
    let extended: u64 = ((narrow as u16) as u32) as u64;
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
