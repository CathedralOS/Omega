// Fact: zero-extending narrow unsigned 100u8 through u16 and u32 to u64 preserves the exact interval 100u64, discharging exact subtraction widened - 100u64 with exit code 0.
// Place: target_body (invalid twin). Initial narrow value is 99u8, so zero-extension yields 99u64 which underflows exact subtraction extended - 100u64.
// Expected diagnostic: exact subtraction underflow

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEvaluate {
    machine evaluate() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Evaluate satisfies SelectedEvaluate {
    machine evaluate() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let narrow: u8 = 99u8;
        let extended: u64 = ((narrow as u16) as u32) as u64;
        let sub: u64 = extended - 100u64;
        sub as i32
    }
}

ArmEvaluate satisfies SelectedEvaluate {
    machine evaluate() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let narrow: u8 = 99u8;
        let extended: u64 = ((narrow as u16) as u32) as u64;
        let sub: u64 = extended - 100u64;
        sub as i32
    }
}

machine main() crashes Trap {
    let res: i32 = SelectedEvaluate::evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
