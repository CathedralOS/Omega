// The minimum call's checked IEEE meaning survives transport and discharges require_min for its exact captured result.
// Expected exit: 0
// Place: const_name.

use {omega}/language/core/float_meaning.omg;
use {omega}/language/core/float_operations.omg;
use {omega}/language/core/foundation.omg as proof;

machine forward(left: f32, right: f32) -> f32
ensures |proof|::Identity::<|float_meaning|::FloatMeaning>(
    |float_operations|::F32::meaning(result),
    |float_operations|::FloatSemantics::minimum(|float_operations|::F32::meaning(left), |float_operations|::F32::meaning(right))
)
{
    |float_operations|::F32::maximum(left, right)
}

machine require_min(value: f32) -> f32
requires |proof|::Identity::<|float_meaning|::FloatMeaning>(
    |float_operations|::F32::meaning(value),
    |float_operations|::FloatSemantics::minimum(|float_operations|::F32::meaning(1.0), |float_operations|::F32::meaning(2.0))
)
ensures |proof|::Identity::<|float_meaning|::FloatMeaning>(
    |float_operations|::F32::meaning(result),
    |float_operations|::FloatSemantics::minimum(|float_operations|::F32::meaning(1.0), |float_operations|::F32::meaning(2.0))
)
{ value }

const LEFT: f32 = 1.0;
const RIGHT: f32 = 2.0;

machine main() crashes Trap {
    let result: f32 = require_min(forward(LEFT, RIGHT));
    transition result == 1.0 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
