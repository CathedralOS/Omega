// The minimum call's checked IEEE meaning survives transport and discharges require_min for its exact captured result.
// Expected exit: 0
// Place: target_body.

use omega::language::core::float_operations;

machine forward(left: f32, right: f32) -> f32
ensures F32::meaning(result) == FloatSemantics::minimum(F32::meaning(left), F32::meaning(right))
{
    F32::minimum(left, right)
}

machine require_min(value: f32) -> f32
requires F32::meaning(value) == FloatSemantics::minimum(F32::meaning(1.0), F32::meaning(2.0))
ensures F32::meaning(result) == FloatSemantics::minimum(F32::meaning(1.0), F32::meaning(2.0))
{ value }

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTransport {
    machine transport() -> f32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures F32::meaning(result) == FloatSemantics::minimum(F32::meaning(1.0), F32::meaning(2.0));
}

X86Transport satisfies SelectedTransport {
    machine transport() -> f32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures F32::meaning(result) == FloatSemantics::minimum(F32::meaning(1.0), F32::meaning(2.0))
    {
        SelectedBodyCheck::require_tag(17u64);
     forward(1.0, 2.0) 
    }
}

ArmTransport satisfies SelectedTransport {
    machine transport() -> f32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures F32::meaning(result) == FloatSemantics::minimum(F32::meaning(1.0), F32::meaning(2.0))
    {
        SelectedBodyCheck::require_tag(29u64);
     forward(1.0, 2.0) 
    }
}

machine main() crashes Trap {
    let result: f32 = require_min(SelectedTransport::transport());
    transition result == 1.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
