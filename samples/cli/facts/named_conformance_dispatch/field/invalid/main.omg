// A named implementation Selected satisfies Arithmetic<i32> dispatches its inline combine member on explicit i32 operands and preserves the bounded result across all nine places.
trait Arithmetic<Value> {
    machine combine(left: Value, right: Value) -> Value
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures result == left + right
    blocks;
}

Selected satisfies Arithmetic<i32> {
    machine combine(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures result == left + right
    blocks;
    {
        left + right
    }
}

machine apply<Operations satisfies Arithmetic<i32>>(left: i32, right: i32) -> i32
blocks;
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures result == left + right
{
    block Operations::combine(left, right)
}

// Place: field (invalid twin). Bounded record fields omit the right bound, violating the combine precondition.
// Expected exit: 0
data Operands where 0 <= left && left <= 50 {
    left: i32;
    right: i32;
}

machine probe(operands: Operands) -> i32
blocks;
{
    block apply<Selected>(operands.left, operands.right)
}

machine main() blocks; crashes Trap {
    let operands: Operands = Operands { left: 20, right: 22 };
    let result: i32 = block probe(operands);
    transition result == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
