// A finite-family result retains the captured ordinary input index through selection, forwarding and storage, and its payload remains 7.
// Expected exit: 0
// Place: match_join.
data Indexed<Limit: u32> { value: u32; }
trait Family {
    machine row<Width: u32>(first: u32, limit: u32, observations: &mut [u32; 5]) -> Indexed<limit>
    requires Width == 16 || Width == 32;
}
machine produce<Span: u32>(payload: u32, bound: u32, recorded: &mut [u32; 5]) -> Indexed<bound>
satisfies Family::row
{
    recorded[1] = Span;
    recorded[2] = bound;
    Indexed { value: payload }
}
Selected satisfies Family {
    machine row<Width: u32>(first: u32, limit: u32, observations: &mut [u32; 5]) -> Indexed<limit>
    requires Width == 16 || Width == 32
    {
        observations[0] = 31;
        produce<Width>(first, limit, observations)
    }
}
Other satisfies Family {
    machine row<Width: u32>(first: u32, limit: u32, observations: &mut [u32; 5]) -> Indexed<limit>
    requires Width == 16 || Width == 32
    {
        observations[0] = 47;
        produce<Width>(first, limit, observations)
    }
}
machine input(slot: &mut u32, observations: &mut [u32; 5]) -> u32
{
    slot = 32;
    observations[4] = ((observations[4] as u32 in Wrapping) + 1) as u32;
    7
}
machine create(selected: dyn Family, width: u32, observations: &mut [u32; 5]) -> Indexed<16>
requires width == 16 || width == 32
{
    let mut limit: u32 = 16;
    let saved: u32 = limit;
    let item: Indexed<saved> = Family::row<width>(selected, input(&mut limit, observations), limit, observations);
    item
}
machine check(item: Indexed<16>) crashes Trap {
    transition item.value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine check_observations(observed: &[u32; 5], expected_marker: u32, expected_width: u32, expected_branch: u32) crashes Trap {
    transition observed[0] == expected_marker && observed[1] == expected_width
        && observed[2] == 16 && observed[3] == expected_branch && observed[4] == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine match_create(selected: dyn Family, width: u32, observations: &mut [u32; 5], branch: u32) -> Indexed<16>
requires width == 16 || width == 32
{
    observations[3] = branch;
    create(selected, width, observations)
}
machine transport(selected: dyn Family, width: u32, expected_marker: u32, expected_branch: u32) crashes Trap
requires width == 16 || width == 32
{
    let mut observed: [u32; 5] = [0, 0, 0, 0, 0];
    let item: Indexed<16> = match width == 16 {
        true -> match_create(selected, width, &mut observed, 3),
        false -> match_create(selected, width, &mut observed, 7)
    };
    check(item);
    check_observations(&observed, expected_marker, width, expected_branch);
}

machine main() crashes Trap {
    transport(Selected as dyn Family, 16, 31, 3);
    transport(Other as dyn Family, 16, 47, 3);
    transport(Selected as dyn Family, 32, 31, 7);
    transport(Other as dyn Family, 32, 47, 7);
}
