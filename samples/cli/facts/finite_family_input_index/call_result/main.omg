// A finite-family result retains the captured ordinary input index through selection, forwarding and storage, and its payload remains 7.
// Expected exit: 0
// Place: call_result.
data Indexed<Limit: u32> { value: u32; }
trait Family { machine row<Width: u32>(first: u32, limit: u32) -> Indexed<limit> where Width == 16 || Width == 32; }
machine produce<Span: u32>(payload: u32, bound: u32) -> Indexed<bound> satisfies Family::row { Indexed { value: payload } }
Selected satisfies Family { Family::row = produce; }
Other satisfies Family { Family::row = produce; }
machine input(slot: &mut u32) -> u32 { 7 }
machine create(selected: dyn Family, width: u32) -> Indexed<16>
requires width == 16 || width == 32;
{
    let mut limit: u32 = 16;
    let saved: u32 = limit;
    let item: Indexed<saved> = Family::row<width>(selected, input(&mut limit), limit);
    item
}
machine check(item: Indexed<16>) crashes Trap {
    transition item.value == 7 { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine forward(item: Indexed<16>) -> Indexed<16> { item }
machine transport(selected: dyn Family, width: u32) crashes Trap
requires width == 16 || width == 32;
{ check(forward(create(selected, width))); }
machine main() crashes Trap { transport(Selected as dyn Family, 16); transport(Other as dyn Family, 32); }
