use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "finite_input_index_target_body" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::InputIndexRelay, |app|::PortableInputIndexRelay>(builder, windows_x86_64);
    Build::select_provider::<|app|::InputIndexRelay, |app|::PortableInputIndexRelay>(builder, linux_x86_64);
    Build::select_provider::<|app|::InputIndexRelay, |app|::PortableInputIndexRelay>(builder, macos_arm64);
    Build::select_provider::<|app|::InputIndexRelay, |app|::PortableInputIndexRelay>(builder, linux_arm64);
}
