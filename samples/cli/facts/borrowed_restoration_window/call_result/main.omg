// Fact: retiring a borrow restoration window restores full owner access and post-borrow invariant value >= 100u64 && value <= 100u64 for exact subtraction value - 100u64.
// Place: call result. The restored cell is returned from a dedicated constructor machine.
// Expected exit: 0

data Cell {
    value: u64;
}

machine write_cell(cell: &mut Cell) {
    cell.value = 100u64;
}

machine make_cell() -> Cell {
    let mut c: Cell = Cell { value: 0u64 };
    write_cell(&mut c);
    c
}

machine main() crashes Trap {
    let cell: Cell = make_cell();
    let val: u64 = cell.value;
    transition val >= 100u64 && val <= 100u64 {
        true -> done(val)
        _ -> bad()
    }
    machine done(v: u64) {
        let diff: u64 = v - 100u64;
    }
    machine bad() {
        crash Trap;
    }
}
