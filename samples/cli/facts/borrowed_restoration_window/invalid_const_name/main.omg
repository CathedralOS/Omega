// Fact: retiring a borrow restoration window restores full owner access and post-borrow invariant value >= 100u64 && value <= 100u64 for exact subtraction value - 100u64.
// Place: const name (invalid twin). Competing local borrow held active across the write call.
// Expected diagnostic: while local borrow `held` is still active

const TARGET: u64 = 100u64;

data Cell {
    value: u64;
}

machine write_cell(cell: @mutable Cell) {
    cell.value = TARGET;
}

machine main() crashes Trap {
    let mutable cell: Cell = Cell { value: 0u64 };
    let held: @mutable Cell = @mutable cell;
    write_cell(@mutable cell);
    held.value = 99u64;
    let val: u64 = cell.value;
    transition val >= TARGET && val <= TARGET {
        true -> done(val),
        _ -> bad()
    }
    machine done(v: u64) {
        let diff: u64 = v - TARGET;
    }
    machine bad() {
        crash Trap;
    }
}
