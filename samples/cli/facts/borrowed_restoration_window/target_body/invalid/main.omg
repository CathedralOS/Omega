// Fact: retiring a borrow restoration window restores full owner access and post-borrow invariant value >= 100u64 && value <= 100u64 for exact subtraction value - 100u64.
// Place: another target body (invalid twin). Competing local borrow held active across the target-scoped write call.
// Expected diagnostic: while local borrow `held` is still active

data Cell {
    value: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedWriteCell {
    machine write_cell(cell: &mut Cell)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86WriteCell satisfies SelectedWriteCell {
    machine write_cell(cell: &mut Cell)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        cell.value = 100u64;
    }
}

ArmWriteCell satisfies SelectedWriteCell {
    machine write_cell(cell: &mut Cell)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        cell.value = 100u64;
    }
}

machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 0u64 };
    let held: &mut Cell = &mut cell;
    SelectedWriteCell::write_cell(&mut cell);
    held.value = 99u64;
    let val: u64 = cell.value;
    transition val >= 100u64 && val <= 100u64 {
        true -> done(val)
        _ -> bad()
    }
    machine done(v: u64) {
        let diff: u64 = v - 100u64;
    }
    machine bad() {
        crash Trap;
    }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
