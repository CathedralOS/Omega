// Expected rejection: cannot prove index at the length-2 indexing operation.
public boundary trait Required { machine get() -> u32 reaches none ensures result <= 2 crashes none; }
public Actual satisfies Required { machine get() -> u32 ensures result <= 2 { 1 } }
machine main() reaches Required crashes Trap {
    transition { _ -> read(Required::get()) }
    machine read(index: u32) requires index <= 2 {
        let values: [u32; 2] = [7, 11];
        let observed: u32 = values[index];
        transition observed == 11 { true -> done(), false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
