// Expected rejection: cannot prove index at the length-2 indexing operation.
public boundary trait Required { machine get() -> u32 reaches none ensures result <= 1 crashes none; }
public Actual satisfies Required { machine get() -> u32 ensures result <= 1 { 1 } }
data Index [copy] requires value <= 2 { value: u32; }
machine read(index: Index) -> u32 { let values: [u32; 2] = [7, 11]; values[index.value] }
machine main() reaches Required crashes Trap {
    let observed: u32 = read(Index { value: Required::get() });
    transition observed == 11 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
