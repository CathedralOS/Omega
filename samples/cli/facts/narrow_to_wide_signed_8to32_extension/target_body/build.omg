machine build(builder: &mut Build) {
    Build::select_provider<SelectedExtendTarget, CheckedExtendTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedExtendTarget, CheckedExtendTarget>(builder, linux_arm64);
    Build::select_provider<SelectedExtendTarget, CheckedExtendTarget>(builder, macos_arm64);
    Build::select_provider<SelectedExtendTarget, CheckedExtendTarget>(builder, windows_x86_64);

    Build::application(builder, "narrow_to_wide_signed_8to32_extension_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
