// Fact: masking an unsigned 64-bit integer to 5 bits and narrowing through u8 ((x & 31u64) as u8 as u64) preserves the exact upper bound (truncated <= 31u64), discharging exact subtraction 31u64 - truncated across all nine places.
// Place: field (invalid twin). The mask `32u64` keeps bit 5, so `31u64 - truncated` may underflow; the helper states `requires true`, so it must handle every `u64` (an omitted `requires` would be inferred from the caller under `nested-helper-caller-facts`).
// Expected diagnostic: may overflow `u64`

data ByteCarrier {
    truncated: u64;
}

machine exercise(x: u64) -> u64
requires true
{
    let carrier: ByteCarrier = ByteCarrier {
        truncated: (x & 32u64) as u8 as u64
    };
    let diff: u64 = 31u64 - carrier.truncated;
    diff
}

machine main() crashes Trap {
    let diff: u64 = exercise(466u64);
    transition diff == 13u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
