// Fact: masking an unsigned 64-bit integer to 5 bits and narrowing through u8 ((x & 31u64) as u8 as u64) preserves the exact upper bound (truncated <= 31u64), discharging exact subtraction 31u64 - truncated across all nine places.
// Expected exit: 0

machine choose(x: u64, flag: bool) -> u64
ensures result <= 31u64
{
    match flag {
        true -> (x & 31u64) as u8 as u64,
        false -> (x & 15u64) as u8 as u64,
    }
}

machine exercise(x: u64, flag: bool) -> u64 {
    let truncated: u64 = choose(x, flag);
    let diff: u64 = 31u64 - truncated;
    diff
}

machine main() crashes Trap {
    let diff1: u64 = exercise(466u64, true);
    let diff2: u64 = exercise(466u64, false);
    transition diff1 == 13u64 && diff2 == 29u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
