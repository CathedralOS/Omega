// An x86 mov through a typed view index copies the indexed element by the place's ordinary assignment.
// Expected exit: 0.
data Holder { values: [u32; 2]; }
machine main() crashes Trap {
    let mut holder: Holder = Holder { values: [7, 9] };
    asm {
        mov eax, 37;
        mov holder.values[0], eax
    }
    transition holder.values[0] == 37 && holder.values[1] == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
