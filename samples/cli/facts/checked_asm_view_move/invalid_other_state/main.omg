// An x86 mov through a typed view index copies the indexed element by the place's ordinary assignment.
// Expected exit: 0.
data Cells { values: [u32; 2]; }
machine main() crashes Trap {
    let cells: Cells = Cells { values: [7, 9] };
    transition { _ -> write(cells) }
    machine write(cells: Cells) {
        let mut live: Cells = cells;
        asm {
            mov eax, 37;
            mov [live.values], eax
        }
        transition live.values[0] == 37 && live.values[1] == 9 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
