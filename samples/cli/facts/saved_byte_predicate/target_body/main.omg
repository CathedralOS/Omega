// A saved byte predicate certifies the same bytes after a disjoint write, but not after an overlapping write.
// Expected exit: 0
// Place: target_body.
machine inspect(bytes: @[u8]) -> u8
requires ascii_only(bytes) && bytes.length >= 1
{ bytes[0] }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches none crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(bytes: @mutable [u8], other: @mutable [u8]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires bytes.length >= 1 && other.length >= 1;
}

X86Probe satisfies SelectedProbe {
    machine probe(bytes: @mutable [u8], other: @mutable [u8]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires bytes.length >= 1 && other.length >= 1
    {
        SelectedBodyCheck::require_tag(17u64);
        let view: @mutable [u8] = @mutable bytes[0..1];
        let saved: bool = ascii_only(view);
        other[0] = 255u8;
        transition saved { true -> inspect(view), false -> 0u8 }
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(bytes: @mutable [u8], other: @mutable [u8]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires bytes.length >= 1 && other.length >= 1
    {
        SelectedBodyCheck::require_tag(29u64);
        let view: @mutable [u8] = @mutable bytes[0..1];
        let saved: bool = ascii_only(view);
        other[0] = 255u8;
        transition saved { true -> inspect(view), false -> 0u8 }
    }
}


machine main() crashes Trap {
    let mutable bytes: [u8; 1] = [65u8];
    let mutable other: [u8; 1] = [65u8];
    transition SelectedProbe::probe(@mutable bytes[..], @mutable other[..]) == 65u8 && other[0] == 255u8 {
        true -> done(), false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
