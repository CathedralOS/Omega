// A saved byte predicate certifies the same bytes after a disjoint write, but not after an overlapping write.
// Expected exit: 0
// Place: target_body.
machine inspect(bytes: &[u8]) -> u8
requires ascii_only(bytes) && bytes.len >= 1
{ bytes[0] }
linux_x86_64 machine probe(bytes: &mut [u8], other: &mut [u8]) -> u8
requires bytes.len >= 1 && other.len >= 1 {
    let view: &mut [u8] = &mut bytes[0..1];
    let saved: bool = ascii_only(view);
    view[0] = 255u8;
    transition saved { true -> inspect(view) false -> 0u8 }
}
linux_arm64 machine probe(bytes: &mut [u8], other: &mut [u8]) -> u8
requires bytes.len >= 1 && other.len >= 1 {
    let view: &mut [u8] = &mut bytes[0..1];
    let saved: bool = ascii_only(view);
    view[0] = 255u8;
    transition saved { true -> inspect(view) false -> 0u8 }
}
macos_arm64 machine probe(bytes: &mut [u8], other: &mut [u8]) -> u8
requires bytes.len >= 1 && other.len >= 1 {
    let view: &mut [u8] = &mut bytes[0..1];
    let saved: bool = ascii_only(view);
    view[0] = 255u8;
    transition saved { true -> inspect(view) false -> 0u8 }
}
windows_x86_64 machine probe(bytes: &mut [u8], other: &mut [u8]) -> u8
requires bytes.len >= 1 && other.len >= 1 {
    let view: &mut [u8] = &mut bytes[0..1];
    let saved: bool = ascii_only(view);
    view[0] = 255u8;
    transition saved { true -> inspect(view) false -> 0u8 }
}
machine main() crashes Trap {
    let mut bytes: [u8; 1] = [65u8];
    let mut other: [u8; 1] = [65u8];
    transition probe(&mut bytes[..], &mut other[..]) == 65u8 && other[0] == 255u8 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
