// A saved byte predicate certifies the same bytes after a disjoint write, but not after an overlapping write.
// Expected exit: 0
// Place: target_body.
machine inspect(bytes: &[u8]) -> u8
requires ascii_only(bytes) && bytes.len >= 1
{ bytes[0] }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(bytes: &mut [u8], other: &mut [u8]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires bytes.len >= 1 && other.len >= 1;
}

X86Probe satisfies SelectedProbe {
    machine probe(bytes: &mut [u8], other: &mut [u8]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires bytes.len >= 1 && other.len >= 1
    {
        SelectedBodyCheck::require_tag(17u64);
        let view: &mut [u8] = &mut bytes[0..1];
        let saved: bool = ascii_only(view);
        view[0] = 255u8;
        transition saved { true -> inspect(view) false -> 0u8 }
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(bytes: &mut [u8], other: &mut [u8]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires bytes.len >= 1 && other.len >= 1
    {
        SelectedBodyCheck::require_tag(29u64);
        let view: &mut [u8] = &mut bytes[0..1];
        let saved: bool = ascii_only(view);
        view[0] = 255u8;
        transition saved { true -> inspect(view) false -> 0u8 }
    }
}


machine main() crashes Trap {
    let mut bytes: [u8; 1] = [65u8];
    let mut other: [u8; 1] = [65u8];
    transition SelectedProbe::probe(&mut bytes[..], &mut other[..]) == 65u8 && other[0] == 255u8 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
