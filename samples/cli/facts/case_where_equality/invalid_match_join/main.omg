// Case Point(lo, hi) where lo == hi makes hi - lo exact in u64, without a guard or Wrapping.
// Expected exit: 0
data Interval [copy]
    requires (self in Interval::Empty) || ((self in Interval::Point))
{
    case Empty;
    case Point(lo: u64, hi: u64);
}
data Main { interval: Interval; other: Interval; left_guard: u64; width: u64; right_guard: u64; flag: bool; route: u64; }

machine mark_interval(interval: Interval, route: &mut u64, tag: u64) -> Interval {
    route = tag;
    interval
}

machine run_main(main: &mut Main) crashes Trap {
    main.width = 99;
    main.flag = true;
    main.interval = Interval::Point { lo: 17, hi: 17 };
    main.other = Interval::Point { lo: 17, hi: 17 };
    guarded_width(main);
    transition main.width == 0 && main.route == 17 {
        true -> second(main)
        false -> route_failed()
    }
    machine second(main: &mut Main) {
        main.flag = false;
        main.width = 99;
        guarded_width(main);
        transition main.width == 0 && main.route == 23 {
            true -> both_routes()
            false -> route_failed()
        }
    }
    machine both_routes() {}
    machine route_failed() { crash Trap; }
}

machine guarded_width(main: &mut Main) crashes Trap {

    let interval: Interval = match main.flag {
        true -> mark_interval(main.interval, &mut main.route, 17),
        false -> mark_interval(main.other, &mut main.route, 23)
    };
    transition interval {
        Interval::Point { lo, hi } -> take(lo, hi, main)
        Interval::Empty -> fail()
    }
    machine take(lo: u64, hi: u64, main: &mut Main) {
        main.width = hi - lo;
        transition main.width == 0 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() { }
    machine fail() { crash Trap; }
}


// Observe the caller's original home and adjacent cells after return.
machine entry_start() crashes Trap {
    let mut entry_storage: Main = Main { interval: Interval::Empty {}, left_guard: 101, width: 99, right_guard: 107, flag: false, other: Interval::Empty {}, route: 0 };
    run_main(&mut entry_storage);
    transition entry_storage.width == 0 && entry_storage.left_guard == 101 && entry_storage.right_guard == 107 && entry_storage.flag == false && entry_storage.route == 23 {
        true -> observed()
        false -> writeback_failed()
    }
    machine observed() {}
    machine writeback_failed() { crash Trap; }
}
