// Case Point(lo, hi) where lo == hi makes hi - lo exact in u64, without a guard or Wrapping.
// Expected exit: 0
data Interval [copy] {
    case Empty;
    case Point(lo: u64, hi: u64) where lo == hi;
}
data Main { interval: Interval; width: u64; flag: bool; }

machine Main::main(main: &mut Main, interval: Interval) {
    transition interval {
        Interval::Point { lo, hi } -> take(lo, hi, main)
        Interval::Empty -> done()
    }
    state take(lo: u64, hi: u64, main: &mut Main) {
        main.width = hi - lo;
    }
    state done() { }
}

machine entry(main: &mut Main) crashes Trap {
    main.width = 99;
    main.interval = Interval::Point { lo: 17, hi: 17 };
    let interval: Interval = main.interval;
    Main::main(main, interval);
    transition main.width == 0 {
        true -> pass()
        _ -> fail()
    }
    state pass() { }
    state fail() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    entry(&mut entry_storage);
}
