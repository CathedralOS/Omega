machine build(builder: &mut Build) {
    Build::application(builder, "case_where_equality_const_name");
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::selected);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::selected);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::selected);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::selected);
}
