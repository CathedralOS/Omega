// Case Point(lo, hi) where lo == hi makes hi - lo exact in u64, without a guard or Wrapping.
// Expected exit: 0
// The named constant selects a static binder; its generic body needs the case fact.
data Interval [copy] {
    case Empty;
    case Point(lo: u64, hi: u64) where lo == hi;
}
data Main { interval: Interval; width: u64; flag: bool; }

machine Main::main<const INTERVAL: Interval>(main: &mut Main) {
    transition INTERVAL {
        Interval::Point { lo, hi } -> take(lo, hi, main)
        _ -> done()
    }
    machine take(lo: u64, hi: u64, main: &mut Main) {
        main.width = hi - lo;
    }
    machine done() { }
}

const NAMED_INTERVAL: Interval = Interval::Point { lo: 4, hi: 4 };
machine Main::selected(main: &mut Main) crashes Trap {
    main.width = 99;
    Main::main<NAMED_INTERVAL>(main);
    transition main.width == 0 {
        true -> pass()
        _ -> fail()
    }
    machine pass() { }
    machine fail() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::selected(&mut entry_storage);
}
