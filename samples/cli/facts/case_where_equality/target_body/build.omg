use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "case_where_equality_target_body" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::PointWidth, |app|::SelectedPointWidth>(builder, windows_x86_64);
    Build::select_provider::<|app|::PointWidth, |app|::SelectedPointWidth>(builder, linux_x86_64);
    Build::select_provider::<|app|::PointWidth, |app|::SelectedPointWidth>(builder, macos_arm64);
    Build::select_provider::<|app|::PointWidth, |app|::SelectedPointWidth>(builder, linux_arm64);
}
