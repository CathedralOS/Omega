// Case Point(lo, hi) where lo == hi makes hi - lo exact in u64, without a guard or Wrapping.
// Expected exit: 0
machine same(lower: u64, upper: u64) -> bool { lower == upper }
data Interval [copy] where (self in Interval::Empty) || ((self in Interval::Point) && same(self.lo, self.hi) == true) {
    case Empty;
    case Point(lo: u64, hi: u64);
}
machine produce(lower: u64) -> Interval { Interval::Point { lo: lower, hi: lower } }
machine width(interval: Interval) -> u64 {
    match interval {
        Interval::Point { lo, hi } -> hi - lo
        Interval::Empty -> 77
    }
}
machine main() crashes Trap {
    let point: Interval = produce(17);
    let exact: u64 = width(point);
    let fallback: u64 = width(Interval::Empty {});
    transition exact == 0 && fallback == 77 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
