// A match selects a primitive local, the join records that local as the origin, and the consumer reads the recorded value.
// Place: call_result.
// The twin selects the other local.

machine choose() -> bool
ensures result == true
{
    true
}

machine read_origin(value: i64) -> i64
requires value == 17
{
    value
}

machine select() -> i64
ensures result == 17
{
    let chosen: i64 = 17;
    let spare: i64 = 5;
    let joined: i64 = match choose() {
        true -> spare
        false -> chosen
    };
    joined
}

machine main() crashes Trap {
    let joined: i64 = select();
    let observed: i64 = read_origin(joined);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
