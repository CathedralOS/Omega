// Fact: Writing an element through a mutable slice view (&mut [u64]) whose length is guarded (view.len >= 2u64) proves safe indexed element mutation at view[1u64] while preserving the slice extent lower bound (view.len >= 2u64) to discharge exact subtraction view.len - 2u64 across all nine places.
// Place: call result. The mutable slice view is received from a helper call returning the guarded view.
// Invalid control: attempts mutation at index 2 without proving extent exceeds 2.
// Expected rejection: cannot prove index

machine forward_view(v: &mut [u64]) -> &mut [u64]
    ensures result.len >= v.len && result.len <= v.len
{
    v
}

machine mutate_call_result(bytes: &mut [u64]) -> u64
    requires bytes.len >= 2;
{
    let view: &mut [u64] = forward_view(bytes);
    view[2] = 45u64;
    let diff: u64 = view.len - 2u64;
    diff
}

machine main() crashes Trap {
    let mut items: [u64; 3];
    items[0] = 10u64;
    items[1] = 20u64;
    items[2] = 30u64;
    let diff: u64 = mutate_call_result(&mut items[..]);
    transition items[1] == 45u64 && diff == 1u64 {
        true -> pass()
        _ -> fail()
    }
    state pass() {}
    state fail() { crash Trap; }
}
