// Fact: Writing an element through a mutable slice view (&mut [u64]) whose length is guarded (view.len >= 2u64) proves safe indexed element mutation at view[1u64] while preserving the slice extent lower bound (view.len >= 2u64) to discharge exact subtraction view.len - 2u64 across all nine places.
// Place: another target body. Target-scoped implementations across all four platforms verify the bound.
// Invalid control: attempts mutation at index 2 without proving extent exceeds 2.
// Expected rejection: cannot prove index

data Backing { guard: u64; items: [u64; 3]; }

machine storage_view<'input>(backing: &'input mut Backing) -> &'input mut [u64]
    ensures result.len == 3;
{
    &mut backing.items
}

linux_x86_64 machine mutate_target(bytes: &mut [u64]) -> u64
    requires bytes.len >= 2;
{
    bytes[2] = 45u64;
    let diff: u64 = bytes.len - 2u64;
    diff
}

linux_arm64 machine mutate_target(bytes: &mut [u64]) -> u64
    requires bytes.len >= 2;
{
    bytes[2] = 45u64;
    let diff: u64 = bytes.len - 2u64;
    diff
}

macos_arm64 machine mutate_target(bytes: &mut [u64]) -> u64
    requires bytes.len >= 2;
{
    bytes[2] = 45u64;
    let diff: u64 = bytes.len - 2u64;
    diff
}

windows_x86_64 machine mutate_target(bytes: &mut [u64]) -> u64
    requires bytes.len >= 2;
{
    bytes[2] = 45u64;
    let diff: u64 = bytes.len - 2u64;
    diff
}

machine main() crashes Trap {
    let mut backing: Backing = Backing { guard: 18446744073709551615, items: [0, 0, 0] };
    backing.items[0] = 10u64;
    backing.items[1] = 20u64;
    backing.items[2] = 30u64;
    let diff: u64 = mutate_target(storage_view(&mut backing));
    transition backing.items[1] == 45u64 && diff == 1u64 && backing.guard == 18446744073709551615
        && backing.items[0] == 10u64 && backing.items[2] == 30u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() {}
    machine fail() { crash Trap; }
}
