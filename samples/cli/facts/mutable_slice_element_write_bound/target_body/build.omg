machine build(builder: &mut Build) {
    Build::select_provider<SelectedMutateTarget, CheckedMutateTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedMutateTarget, CheckedMutateTarget>(builder, linux_arm64);
    Build::select_provider<SelectedMutateTarget, CheckedMutateTarget>(builder, macos_arm64);
    Build::select_provider<SelectedMutateTarget, CheckedMutateTarget>(builder, windows_x86_64);

    Build::application(builder, "mutable_slice_element_write_bound_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
