// Fact: Writing an element through a mutable slice view (@mutable [u64]) whose length is guarded (view.length >= 2u64) proves safe indexed element mutation at view[1u64] while preserving the slice extent lower bound (view.length >= 2u64) to discharge exact subtraction view.length - 2u64 across all nine places.
// Place: match join. The mutable slice view joins across conditional match branches.
// Expected exit: 0

data Backing { guard: u64; items: [u64; 3]; }

machine storage_view<'input>(backing: @'input mutable Backing) -> @'input mutable [u64]
    ensures result.length == 3
{
    @mutable backing.items
}

machine mutate_match_join(bytes: @mutable [u64], choose_first: bool) -> u64
    requires bytes.length >= 2
{
    let view: @mutable [u64] = match choose_first {
        true -> bytes,
        false -> bytes
    };
    view[1] = 45u64;
    let diff: u64 = view.length - 2u64;
    diff
}

machine main() crashes Trap {
    let mutable backing: Backing = Backing { guard: 18446744073709551615, items: [0, 0, 0] };
    backing.items[0] = 10u64;
    backing.items[1] = 20u64;
    backing.items[2] = 30u64;
    let diff1: u64 = mutate_match_join(storage_view(@mutable backing), true);
    let ok1: bool = backing.items[1] == 45u64 && diff1 == 1u64
        && backing.guard == 18446744073709551615
        && backing.items[0] == 10u64 && backing.items[2] == 30u64;
    backing.items[1] = 20u64;
    let diff2: u64 = mutate_match_join(storage_view(@mutable backing), false);
    let ok2: bool = backing.items[1] == 45u64 && diff2 == 1u64
        && backing.guard == 18446744073709551615
        && backing.items[0] == 10u64 && backing.items[2] == 30u64;
    transition ok1 && ok2 {
        true -> pass(),
        _ -> fail()
    }
    machine pass() {}
    machine fail() { crash Trap; }
}
