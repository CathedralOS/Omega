machine build(builder: &mut Build) {
    Build::select_provider<SelectedAcross, CheckedAcross>(builder, windows_x86_64);
    Build::select_provider<SelectedAcross, CheckedAcross>(builder, linux_x86_64);
    Build::select_provider<SelectedAcross, CheckedAcross>(builder, linux_arm64);
    Build::select_provider<SelectedAcross, CheckedAcross>(builder, macos_arm64);

    Build::application(builder, "borrowed_projection_cleanup_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
