// Seed.code == 7 survives each place into a shared loan of an anonymous Pair child, whose whole owner cleans after the Unit call.
// Expected exit: 0
data Seed [copy] { code: u64; }
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) requires receipt.code == 7 {}
data Pair { first: Receipt; second: Receipt; }
machine Pair::drop(pair: &mut Pair) {}
machine observe(receipt: &Receipt) crashes Trap {
    transition receipt.code == 7 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
windows_x86_64 machine across() crashes Trap { let seed: Seed = Seed { code: 7 }; observe(&Pair { first: Receipt { code: 7 }, second: Receipt { code: seed.code } }.second); }
linux_x86_64 machine across() crashes Trap { let seed: Seed = Seed { code: 7 }; observe(&Pair { first: Receipt { code: 7 }, second: Receipt { code: seed.code } }.second); }
linux_arm64 machine across() crashes Trap { let seed: Seed = Seed { code: 7 }; observe(&Pair { first: Receipt { code: 7 }, second: Receipt { code: seed.code } }.second); }
macos_arm64 machine across() crashes Trap { let seed: Seed = Seed { code: 7 }; observe(&Pair { first: Receipt { code: 7 }, second: Receipt { code: seed.code } }.second); }
machine main() crashes Trap {
    across();
}
