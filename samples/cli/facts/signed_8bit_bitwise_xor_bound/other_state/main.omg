// Fact: 8-bit signed bitwise XOR raw ^ 15i8 with bounded interval 40i8 <= xored <= 63i8 establishes 40i8 <= xored <= 63i8 across all nine places so exact subtractions 63i8 - xored and xored - 40i8 are safe.
// Place: other_state. A state transition forwards the bitwise XOR result to a successor state.
// Expected exit: 0
machine verify_xored(res: i8) -> i32
    requires res >= 40 && res <= 63
{
    let head: i8 = 63 - res;
    let tail: i8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

machine compute_other_state(raw: i8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: i8 = raw ^ 15;
    transition { _ -> step(xored) }
    state step(s: i8) -> i32 {
        verify_xored(s)
    }
}

machine evaluate() -> i32 {
    compute_other_state(59)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
