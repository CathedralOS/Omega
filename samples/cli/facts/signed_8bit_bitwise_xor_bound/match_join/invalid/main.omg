// Fact: 8-bit signed bitwise XOR raw ^ 15i8 with bounded interval 40i8 <= xored <= 63i8 establishes 40i8 <= xored <= 63i8 across all nine places so exact subtractions 63i8 - xored and xored - 40i8 are safe.
// Place: match_join. Both match arms yield the bitwise XOR result so the joined binding preserves the bounds.
// Expected exit: 0
machine verify_xored(res: i8) -> i32
    requires res >= 40 && res <= 63
{
    let head: i8 = 63 - res;
    let tail: i8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

machine compute_match_join(raw: i8, flag: bool) -> i32
    requires raw >= 64 && raw <= 64
{
    let xored: i8 = raw ^ 15;
    let joined: i8 = match flag {
        true -> xored
        false -> xored
    };
    verify_xored(joined)
}

machine evaluate() -> i32 {
    compute_match_join(64, true)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
