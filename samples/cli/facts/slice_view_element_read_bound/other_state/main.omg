// Fact: a slice view (&[u64]) whose length is guarded (view.len >= 3u64) proves safe indexed element read at view[2u64] and preserves the length lower bound to discharge exact subtraction view.len - 3u64 across all nine places.
// Place: another state. A successor state receives the slice view and verifies the read bound.
// Expected exit: 0

use omega::language::core::slice;

machine read_guarded(view: &[u64]) -> i32
    requires view.len >= 3
{
    transition { _ -> check_view(view) }
    state check_view(v: &[u64]) -> i32
        requires v.len >= 3
    {
        let elem: u64 = v[2];
        let diff: u64 = v.len - 3u64;
        transition elem == 30u64 && diff == 1u64 {
            true -> done()
            _ -> bad()
        }
    }
    state done() -> i32 { 0 }
    state bad() -> i32 { 1 }
}

machine main() crashes Trap {
    let items: [u64; 4] = [10u64, 20u64, 30u64, 40u64];
    let view: &[u64] = &items[..];
    let res: i32 = read_guarded(view);
    transition res == 0 {
        true -> pass()
        _ -> fail()
    }
    state pass() {}
    state fail() { crash Trap; }
}
