// Fact: a slice view (&[u64]) whose length is guarded (view.len >= 3u64) proves safe indexed element read at view[2u64] and preserves the length lower bound to discharge exact subtraction view.len - 3u64 across all nine places.
// Expected exit: 0

public data Window<'a> { values: &'a [u64]; }

public machine read_guarded(windows: &[Window], selected: u64) -> i32
requires selected < windows.len
{
    transition windows[selected].values.len >= 3 {
        true -> read(windows, selected)
        _ -> short()
    }
    machine read(windows: &[Window], selected: u64) -> i32
    requires selected < windows.len && windows[selected].values.len >= 3
    {
    let elem: u64 = windows[selected].values[2];
    let diff: u64 = windows[selected].values.len - 3u64;
    transition elem == 30u64 && diff == 1u64 {
        true -> done()
        _ -> bad()
    }
    machine done() -> i32 { 0 }
    machine bad() -> i32 { 2 }

    }
    machine short() -> i32 { 1 }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedCheckPair {
    machine check_pair(windows: &[Window]) -> bool reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires windows.len == 2;
}
X86CheckPair satisfies SelectedCheckPair {
    machine check_pair(windows: &[Window]) -> bool reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires windows.len == 2
    {
        SelectedBodyCheck::require_tag(17u64);
        let result: i32 = read_guarded(windows, 1);
        let declined: i32 = read_guarded(windows, 0);
        result == 0 && declined == 1
    }
}
ArmCheckPair satisfies SelectedCheckPair {
    machine check_pair(windows: &[Window]) -> bool reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires windows.len == 2
    {
        SelectedBodyCheck::require_tag(29u64);
        let result: i32 = read_guarded(windows, 1);
        let declined: i32 = read_guarded(windows, 0);
        result == 0 && declined == 1
    }
}

machine main() crashes Trap {
    let other: [u64; 6] = [90u64, 91u64, 92u64, 93u64, 94u64, 95u64];
    let items: [u64; 4] = [10u64, 20u64, 30u64, 40u64];
    let windows: [Window; 2] = [Window { values: &other[..2] }, Window { values: &items[..] }];
    let correct: bool = SelectedCheckPair::check_pair(&windows[..]);
    transition correct { true -> pass() _ -> fail() }
    machine pass() {}
    machine fail() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
