// Expected diagnostic: consumed
// Fact: A checked copy of a closed Inert opaque preserves libc host numbers 66051, 513 and replacement 1027 across an independent consuming call while the original remains usable.
use {producer}/main.omg as producer;
public data AddressBox { value: |producer|::InternetAddress; }
public data AddressPair { first: |producer|::InternetAddress; second: |producer|::InternetAddress; }

machine consume(first: |producer|::InternetAddress, second: |producer|::InternetAddress) -> bool reaches |producer|::AddressParts, |producer|::AddressBridge {
    let mutable pair: AddressPair = AddressPair { first: first, second: second };
    let old_host: u32 = |producer|::AddressBridge::host(pair.first);
    pair.first = |producer|::AddressBridge::make(10, 1027);
    let sibling_host: u32 = |producer|::AddressBridge::host(pair.second);
    let replacement_host: u32 = |producer|::AddressBridge::host(pair.first);
    old_host == 66051 && sibling_host == 513 && replacement_host == 1027
}
const FIRST_HOST: u32 = 66051;
const SECOND_HOST: u32 = 513;
machine observe() -> bool reaches |producer|::AddressParts, |producer|::AddressBridge {
 let first: |producer|::InternetAddress = |producer|::AddressBridge::make(10, FIRST_HOST);

 let copied: |producer|::InternetAddress = first;
 let consumed_copy: bool = consume(copied, |producer|::AddressBridge::make(44048, SECOND_HOST));
 let retained_host: u32 = |producer|::AddressBridge::host(first);
 consumed_copy && retained_host == 66051
}

machine main() reaches |producer|::AddressParts, |producer|::AddressBridge crashes Trap {
 transition observe() { true -> done(), _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
