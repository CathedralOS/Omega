 machine host(address: InternetAddress) -> u32 reaches AddressParts;
}
public AddressBridgeProvider satisfies AddressBridge {
 machine host(address: InternetAddress) -> u32 reaches AddressParts {
  AddressParts::host(address)
 }
 machine make(network: u32, host: u32) -> InternetAddress reaches AddressParts {
  AddressParts::make(network, host)
 }
}
public machine component_entry() reaches AddressBridge, AddressParts invokes AddressBridge; invokes AddressParts; crashes Trap {
 let address: InternetAddress = AddressBridge::make(10, 66051);
 let host: u32 = AddressParts::host(address);
 transition host == 66051 { true -> done() _ -> failed() }
 machine done() {} machine failed() { crash Trap; }
}
