// Expected: reject an unconsumed linear sibling
// A linear closed Inert opaque moves exactly once through independent consuming calls, preserving libc host numbers 66051 and 513 and replacement 1027 while retaining each disjoint sibling until its own consumption.
use producer::main;
public data AddressBox { value: InternetAddress; }
public data AddressPair { first: InternetAddress; second: InternetAddress; }

machine consume(first: InternetAddress, second: InternetAddress) -> bool reaches AddressParts, AddressBridge {
    let mut pair: AddressPair = AddressPair { first: first, second: second };
    let old_host: u32 = AddressBridge::host(pair.first);
    pair.first = AddressBridge::make(10, 1027);
    let sibling_host: u32 = 513;
    let replacement_host: u32 = AddressBridge::host(pair.first);
    old_host == 66051 && sibling_host == 513 && replacement_host == 1027
}
linux_x86_64 machine observe() -> bool reaches AddressParts, AddressBridge { consume(AddressBridge::make(10, 66051), AddressBridge::make(44048, 513)) }
linux_arm64 machine observe() -> bool reaches AddressParts, AddressBridge { consume(AddressBridge::make(10, 66051), AddressBridge::make(44048, 513)) }
windows_x86_64 machine observe() -> bool reaches AddressParts, AddressBridge { consume(AddressBridge::make(10, 66051), AddressBridge::make(44048, 513)) }
macos_arm64 machine observe() -> bool reaches AddressParts, AddressBridge { consume(AddressBridge::make(10, 66051), AddressBridge::make(44048, 513)) }

machine main() reaches AddressParts, AddressBridge crashes Trap {
 transition observe() { true -> done() _ -> failed() }
 machine done() {}
 machine failed() crashes Trap { crash Trap; }
}
