// Expected exit: 0
// Closed nested Inert carrier transport preserves libc host numbers 66051 and 513 and replacement 1027 while retaining the disjoint sibling.
use omega::language::core::external_binding;

use omega::language::core::representation;
public boundary data InternetAddress;
public data AddressWord { address: u32; }
machine AddressWord::drop(word: &mut AddressWord) {}
public data AddressCarrier<T> { payload: T; }
public AddressRepresentation satisfies OpaqueRepresentation<InternetAddress, AddressCarrier<AddressCarrier<AddressWord>>> { }

public boundary trait AddressParts {
    machine make(network: u32, host: u32) -> InternetAddress reaches;
    machine host(address: InternetAddress) -> u32 reaches;
}


public data AddressBox { value: InternetAddress; }
public data AddressPair { first: InternetAddress; second: InternetAddress; }

machine consume(first: InternetAddress, second: InternetAddress) -> bool reaches AddressParts {
    let mut pair: AddressPair = AddressPair { first: first, second: second };
    let old_host: u32 = AddressParts::host(pair.first);
    pair.first = AddressParts::make(10, 1027);
    let sibling_host: u32 = AddressParts::host(pair.second);
    let replacement_host: u32 = AddressParts::host(pair.first);
    old_host == 66051 && sibling_host == 513 && replacement_host == 1027
}
const FIRST_HOST: u32 = 66051;
const SECOND_HOST: u32 = 513;
machine observe() -> bool reaches AddressParts { consume(AddressParts::make(10, FIRST_HOST), AddressParts::make(44048, SECOND_HOST)) }

machine main() reaches AddressParts crashes Trap {
 transition observe() { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
