use {omega}/build/dependency.omg;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "opaque_boundary_exchange" };
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled { name: "system" }));
    Build::select_representation::<InternetAddress, AddressRepresentation>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);

    Build::bind_native::<AddressParts::make>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_makeaddr",
        },
    });
    Build::bind_native::<AddressParts::make>(builder, linux_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_makeaddr", version: "GLIBC_2.2.5",
        },
    });
    Build::bind_native::<AddressParts::host>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_lnaof",
        },
    });
    Build::bind_native::<AddressParts::host>(builder, linux_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_lnaof", version: "GLIBC_2.2.5",
        },
    });
    Build::bind_native::<AddressParts::make>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_makeaddr", version: "GLIBC_2.17" } });
    Build::bind_native::<AddressParts::host>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_lnaof", version: "GLIBC_2.17" } });
    Build::bind_native::<AddressParts::make>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_host.dll", export: "inet_makeaddr" } });
    Build::bind_native::<AddressParts::host>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_host.dll", export: "inet_lnaof" } });
}
