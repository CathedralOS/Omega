use {omega}/language/core/process_exit.omg;
use {omega}/language/core/representation.omg;
// Expected exit: 0
// Closed nested Inert carrier transport preserves libc host numbers 66051 and 513 and replacement 1027 while retaining the disjoint sibling.

public boundary data InternetAddress;
public data AddressWord { address: u32; }
public data AddressCarrier<T> { payload: T; }
public AddressRepresentation satisfies |representation|::OpaqueRepresentation<InternetAddress, AddressCarrier<AddressCarrier<AddressWord>>> { }

public boundary trait AddressParts {
    machine make(network: u32, host: u32) -> InternetAddress reaches none crashes none;
    machine host(address: InternetAddress) -> u32 reaches none crashes none;
}

public data AddressBox { value: InternetAddress; }
public data AddressPair { first: InternetAddress; second: InternetAddress; }

machine relay(input: InternetAddress) -> InternetAddress {
    let stored: AddressBox = AddressBox { value: input };
    stored.value
}

data Main {
}

machine observe() -> bool reaches AddressParts {
    let pair: AddressPair = AddressPair {
        first: relay(AddressParts::make(10, 66051)),
        second: relay(AddressParts::make(44048, 513)),
    };
    let first_host: u32 = AddressParts::host(pair.first);
    let second_host: u32 = AddressParts::host(pair.second);
    first_host == 66051 && second_host == 513
}

machine observe_replacement() -> bool reaches AddressParts {
    let mutable pair: AddressPair = AddressPair {
        first: AddressParts::make(10, 66051),
        second: AddressParts::make(44048, 513),
    };
    let old_host: u32 = AddressParts::host(pair.first);
    pair.first = AddressParts::make(10, 1027);
    let sibling_host: u32 = AddressParts::host(pair.second);
    let replacement_host: u32 = AddressParts::host(pair.first);
    old_host == 66051 && sibling_host == 513 && replacement_host == 1027
}

machine run_main(main: @mutable Main) reaches |process_exit|::ProcessExit + AddressParts {
    transition observe() && observe_replacement() {
        true -> passed(main),
        _ -> failed(main)
    }
    machine passed(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(0); }
    machine failed(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + AddressParts {
    let mutable entry_storage: Main;
    run_main(@mutable entry_storage);
}
