// Expected native admission rejection: raw host cannot grant another issuer's result.
use {producer}/main.omg as producer;
machine main() reaches |producer|::UncheckedFactory, |producer|::AddressParts crashes Trap {
 let address: |producer|::InternetAddress in |producer|::InternetAddress::Classified::Ready = |producer|::UncheckedFactory::make(10, 66051);
 let host: u32 = |producer|::AddressParts::host(address as |producer|::InternetAddress);
 transition host == 66051 { true -> done(), _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
