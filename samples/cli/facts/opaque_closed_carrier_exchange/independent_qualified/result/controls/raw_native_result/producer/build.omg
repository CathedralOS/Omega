use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
 builder.product = BuildProduct::Package { name: "raw_qualified_result_producer" };
 Build::select_representation::<|app|::InternetAddress, |app|::AddressRepresentation>(builder);
 Build::bind(builder, linux_x86_64::ProgramEntry, |app|::component_entry);
 Build::bind(builder, linux_arm64::ProgramEntry, |app|::component_entry);
 Build::bind(builder, macos_arm64::ProgramEntry, |app|::component_entry);
 Build::bind(builder, windows_x86_64::ProgramEntry, |app|::component_entry);

    Build::bind_native::<|app|::AddressParts::make>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_makeaddr",
        },
    });
    Build::bind_native::<|app|::AddressParts::make>(builder, linux_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_makeaddr", version: "GLIBC_2.2.5",
        },
    });
    Build::bind_native::<|app|::AddressParts::host>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_lnaof",
        },
    });
    Build::bind_native::<|app|::AddressParts::host>(builder, linux_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_lnaof", version: "GLIBC_2.2.5",
        },
    });
    Build::bind_native::<|app|::AddressParts::make>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_makeaddr", version: "GLIBC_2.17" } });
    Build::bind_native::<|app|::AddressParts::host>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_lnaof", version: "GLIBC_2.17" } });
    Build::bind_native::<|app|::AddressParts::make>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_host.dll", export: "inet_makeaddr" } });
    Build::bind_native::<|app|::AddressParts::host>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_host.dll", export: "inet_lnaof" } });
    Build::bind_native::<|app|::UncheckedFactory::make>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_makeaddr",
        },
    });
    Build::bind_native::<|app|::UncheckedFactory::make>(builder, linux_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_makeaddr", version: "GLIBC_2.2.5",
        },
    });
    Build::bind_native::<|app|::UncheckedFactory::make>(builder, linux_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_makeaddr", version: "GLIBC_2.17" } });
    Build::bind_native::<|app|::UncheckedFactory::make>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_host.dll", export: "inet_makeaddr" } });
}
