machine build(builder: &mut Build) {
 Build::application(builder, "independent_opaque_parameter");
 let mut producer_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../producer" });
 dependency::with_alias(&mut producer_dependency, "producer");
 let producer_registration: DependencyRegistration = Build::dependency(builder, producer_dependency);
 Build::select_representation<producer::InternetAddress, producer::AddressRepresentation>(builder);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, linux_arm64, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, linux_x86_64, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, macos_arm64, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, macos_x86_64, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, windows_x86_64, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, uefi_x86_64, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, cross_platform_cli, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, local_unchecked, CompositionMode::Independent);
 Build::select_provider<producer::AddressBridge, producer::AddressBridgeProvider>(builder, alpha_bootstrap, CompositionMode::Independent);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
