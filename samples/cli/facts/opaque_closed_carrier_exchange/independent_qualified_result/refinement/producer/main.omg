 machine classified_make(network: u32, host: u32) -> InternetAddress in Classified::Ready reaches AddressParts { classify(AddressParts::make(network, host)) as InternetAddress in Classified::Ready }
 machine host(address: InternetAddress) -> u32 reaches AddressParts { AddressParts::host(address) }
 machine classified_host(address: InternetAddress in Classified::Ready) -> u32 reaches AddressParts {
  AddressParts::host(address as InternetAddress)
 }
 machine make(network: u32, host: u32) -> InternetAddress reaches AddressParts {
  AddressParts::make(network, host)
 }
}
