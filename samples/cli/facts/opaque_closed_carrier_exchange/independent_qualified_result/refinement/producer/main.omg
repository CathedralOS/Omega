public boundary trait AddressBridge {
 machine classified_make(network: u32, host: u32) -> InternetAddress in Classified::Ready reaches AddressParts;
 machine make(network: u32, host: u32) -> InternetAddress reaches AddressParts;
 machine host(address: InternetAddress) -> u32 reaches AddressParts;
 machine classified_host(address: InternetAddress in Classified::Ready) -> u32 reaches AddressParts;
}
