use omega::language::core::external_binding;

use omega::language::core::representation;
public boundary data InternetAddress;
public domain InternetAddress::Classified established by classify;
public domain InternetAddress::Classified::Ready;
public machine classify(address: InternetAddress) -> InternetAddress in Classified { address }
public data AddressWord { address: u32; }
public data AddressCarrier<T> { payload: T; }
public AddressRepresentation satisfies OpaqueRepresentation<InternetAddress, AddressCarrier<AddressCarrier<AddressWord>>> { }

public boundary trait AddressParts {
    machine make(network: u32, host: u32) -> InternetAddress reaches;
    machine host(address: InternetAddress) -> u32 reaches;
}

macos_arm64 machine make_binding() -> ForeignBinding<26, 14, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_makeaddr",
        },
    }
}

linux_x86_64 machine linux_x86_64_make_binding() -> ForeignBinding<9, 13, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_makeaddr", version: "GLIBC_2.2.5",
        },
    }
}

macos_arm64 machine host_binding() -> ForeignBinding<26, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_lnaof",
        },
    }
}

linux_x86_64 machine linux_x86_64_host_binding() -> ForeignBinding<9, 10, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_lnaof", version: "GLIBC_2.2.5",
        },
    }
}

macos_arm64 machine make(network: u32, host: u32) -> InternetAddress
