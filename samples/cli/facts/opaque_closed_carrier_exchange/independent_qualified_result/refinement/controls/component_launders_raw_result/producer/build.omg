use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::package(builder, "opaque_address_producer");
 Build::select_representation<InternetAddress, AddressRepresentation>(builder);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, linux_arm64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, linux_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, macos_arm64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, macos_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, windows_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, uefi_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, cross_platform_cli);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, local_unchecked);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, alpha_bootstrap);
 Build::bind(builder, linux_x86_64::ProgramEntry, component_entry);
 Build::bind(builder, linux_arm64::ProgramEntry, component_entry);
 Build::bind(builder, macos_arm64::ProgramEntry, component_entry);
 Build::bind(builder, windows_x86_64::ProgramEntry, component_entry);

 Build::bind<AddressParts::make>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_makeaddr",
        },
    });
 Build::bind<AddressParts::make>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_makeaddr", version: "GLIBC_2.2.5",
        },
    });
 Build::bind<AddressParts::host>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_lnaof",
        },
    });
 Build::bind<AddressParts::host>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_lnaof", version: "GLIBC_2.2.5",
        },
    });
 Build::bind<AddressParts::make>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_makeaddr", version: "GLIBC_2.17" } });
 Build::bind<AddressParts::host>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_lnaof", version: "GLIBC_2.17" } });
 Build::bind<AddressParts::make>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_host.dll", export: "inet_makeaddr" } });
 Build::bind<AddressParts::host>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_host.dll", export: "inet_lnaof" } });
 Build::bind<UncheckedFactory::make>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_makeaddr",
        },
    });
 Build::bind<UncheckedFactory::make>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_makeaddr", version: "GLIBC_2.2.5",
        },
    });
 Build::bind<UncheckedFactory::make>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_makeaddr", version: "GLIBC_2.17" } });
 Build::bind<UncheckedFactory::make>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_host.dll", export: "inet_makeaddr" } });
}
