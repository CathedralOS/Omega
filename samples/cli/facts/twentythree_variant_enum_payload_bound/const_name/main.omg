// Fact: matching a 23-variant tagged enum payload TwentyThreeChoice { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64), V12(u64), V13(u64), V14(u64), V15(u64), V16(u64), V17(u64), V18(u64), V19(u64), V20(u64), V21(u64), V22(u64), V23(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Expected exit: 0

const MAX_RES: u64 = 80u64;
const MIN_RES: u64 = 40u64;

data TwentyThreeChoice [copy] {
    case V1(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V2(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V3(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V4(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V5(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V6(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V7(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V8(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V9(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V10(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V11(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V12(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V13(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V14(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V15(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V16(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V17(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V18(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V19(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V20(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V21(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V22(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V23(v: u64) where v >= MIN_RES && v <= MAX_RES;
}

machine verify_payload(value: u64) -> u64
    requires value >= MIN_RES && value <= MAX_RES
{
    let headroom: u64 = MAX_RES - value;
    let margin: u64 = value - MIN_RES;
    headroom + margin
}

machine extract(choice: TwentyThreeChoice) -> u64 {
    transition choice {
        TwentyThreeChoice::V1 { v } -> v
        TwentyThreeChoice::V2 { v } -> v
        TwentyThreeChoice::V3 { v } -> v
        TwentyThreeChoice::V4 { v } -> v
        TwentyThreeChoice::V5 { v } -> v
        TwentyThreeChoice::V6 { v } -> v
        TwentyThreeChoice::V7 { v } -> v
        TwentyThreeChoice::V8 { v } -> v
        TwentyThreeChoice::V9 { v } -> v
        TwentyThreeChoice::V10 { v } -> v
        TwentyThreeChoice::V11 { v } -> v
        TwentyThreeChoice::V12 { v } -> v
        TwentyThreeChoice::V13 { v } -> v
        TwentyThreeChoice::V14 { v } -> v
        TwentyThreeChoice::V15 { v } -> v
        TwentyThreeChoice::V16 { v } -> v
        TwentyThreeChoice::V17 { v } -> v
        TwentyThreeChoice::V18 { v } -> v
        TwentyThreeChoice::V19 { v } -> v
        TwentyThreeChoice::V20 { v } -> v
        TwentyThreeChoice::V21 { v } -> v
        TwentyThreeChoice::V22 { v } -> v
        TwentyThreeChoice::V23 { v } -> v
    }
}

machine probe(choice: TwentyThreeChoice) -> u64 {
    let res: u64 = extract(choice);
    verify_payload(res)
}

machine main() crashes Trap {
    let p: TwentyThreeChoice = TwentyThreeChoice::V23 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
