// A saved observation that the kept generic field is 7 stays provable across an exclusive loan of a different field.
// This twin exclusively borrows the saved field and does not write it, so the observation is no longer valid.
data Pair<T> { kept: T; other: T; }

machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine expose(slot: &mut u64) -> u64 {
    slot
}

machine main() crashes Trap {
    let mut item: Pair<u64> = Pair { kept: 7, other: 1 };
    let saved: u64 = item.kept;
    let held: u64 = expose(&mut item.kept);
    transition agree(saved, item.kept) == 7 { true -> done(held) _ -> bad() }
    state done(held: u64) {}
    state bad() { crash Trap; }
}
