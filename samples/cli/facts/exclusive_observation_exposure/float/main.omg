// A saved observation that the kept float is 7 stays provable across a complete non-writing exclusive call on that float.
// Expected exit: 0
data Ends { kept: f64; other: f64; }

machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}

machine expose(slot: &mut f64) -> f64 {
    slot
}

machine main() crashes Trap {
    let mut item: Ends = Ends { kept: 7.0, other: 1.0 };
    let saved: f64 = item.kept;
    let held: f64 = expose(&mut item.kept);
    transition agree(saved, item.kept) == 7.0 { true -> done(held) _ -> bad() }
    machine done(held: f64) {}
    machine bad() { crash Trap; }
}
