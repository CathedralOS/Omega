machine build(builder: &mut Build) {
    Build::application(builder, "exclusive_observation_exposure_through_float_target_body_invalid");
    Build::select_provider<FloatObservation, SelectedFloatObservation>(builder, windows_x86_64);
    Build::select_provider<FloatObservation, SelectedFloatObservation>(builder, linux_x86_64);
    Build::select_provider<FloatObservation, SelectedFloatObservation>(builder, macos_arm64);
    Build::select_provider<FloatObservation, SelectedFloatObservation>(builder, linux_arm64);
}
