// A saved observation that the kept float is 7 stays provable across an exclusive loan of a different float.
// This twin writes the saved float, invalidating its live equality with the observation.
data Ends { kept: f64; other: f64; }
machine read_kept(item: &mut Ends) -> f64
requires item.kept == 7.0
ensures result == item.kept && result == 7.0
{
    let saved: f64 = item.kept;
    let held: f64 = expose(&mut item.kept);
    transition held == held { true -> saved _ -> saved }
}

machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}

machine expose(slot: &mut f64) -> f64 {
    slot = 8.0;
    slot
}

machine main() crashes Trap {
    let mut item: Ends = Ends { kept: 7.0, other: 1.0 };
    let saved: f64 = read_kept(&mut item);
    transition agree(saved, item.kept) == 7.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
