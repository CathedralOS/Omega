// A saved observation that the kept referent is 7 stays provable across a complete non-writing exclusive call on that referent.
// This twin writes the saved referent, invalidating its live equality with the observation.
data Ends { kept: u64; other: u64; }

machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine expose(slot: &mut u64) -> u64 {
    slot = 8;
    slot
}

machine main() crashes Trap {
    let mut item: Ends = Ends { kept: 7, other: 1 };
    let view: &mut Ends = &mut item;
    let saved: u64 = view.kept;
    let held: u64 = expose(&mut view.kept);
    transition agree(saved, view.kept) == 7 { true -> done(held) _ -> bad() }
    machine done(held: u64) {}
    machine bad() { crash Trap; }
}
