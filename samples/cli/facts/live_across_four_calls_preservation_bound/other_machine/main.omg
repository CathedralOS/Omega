// Fact: a value live across four sequential machine calls preserves its static bound 40u64 <= saved <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: other_machine. A forwarding machine transports the preserved value saved through an intermediate machine call.
// Expected exit: 0
machine step1(x: u64) -> u64
    requires x == 10
    ensures result == 11
{
    11
}

machine step2(x: u64) -> u64
    requires x == 11
    ensures result == 12
{
    12
}

machine step3(x: u64) -> u64
    requires x == 12
    ensures result == 13
{
    13
}

machine step4(x: u64) -> u64
    requires x == 13
    ensures result == 14
{
    14
}


machine target_machine(val: u64) -> u64
    ensures result == val
{
    val
}

machine forwarder(val: u64) -> u64
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(saved: u64) -> i32
    requires saved >= 40 && saved <= 80
{
    let c1: u64 = step1(10);
    let c2: u64 = step2(c1);
    let c3: u64 = step3(c2);
    let c4: u64 = step4(c3);
    let res: u64 = forwarder(saved);
    let head: u64 = 80 - res;
    let underflow: u64 = res - 40;
    transition head + underflow == 40 && c4 == 14 {
        true -> done()
        _ -> bad()
    }
    state done() -> i32 { 0 }
    state bad() -> i32 { 1 }
}

machine evaluate() -> i32 {
    compute_other_machine(60)
}

machine main() crashes Trap {
    let outcome: i32 = evaluate();
    transition outcome == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
