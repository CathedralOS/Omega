// An outer helper that calls an inner helper to pick one of two mutable inputs and write through that result preserves a disjoint index-bound fact on the other input.
// Expected exit: 0
// Place: target_body.

machine choose<'storage>(chosen: @'storage mutable u64, other: @'storage mutable u64, pick_chosen: bool) -> @'storage mutable u64 {
    transition pick_chosen {
        true -> chosen,
        _ -> other
    }
}


machine relay<'storage>(chosen: @'storage mutable u64, other: @'storage mutable u64, pick_chosen: bool) -> @'storage mutable u64 {
    transition {
        _ -> hand(chosen, other, pick_chosen)
    }
    machine hand(chosen: @'storage mutable u64, other: @'storage mutable u64, pick_chosen: bool) -> @'storage mutable u64 {
        choose(chosen, other, pick_chosen)
    }
}

machine overwrite(slot: @mutable u64) -> u64 in Wrapping {
    $slot = 9;
    (1 as u64 +Wrapping)
}

machine add(first: u64 in Wrapping, second: u64 in Wrapping) -> u64 in Wrapping {
    first + second
}

boundary trait SelectedProbe {
    machine probe(chosen: @mutable u64, other: @mutable u64, items: @[u8; 4]) -> u8
        reaches none requires $chosen < 4 && $other < 4 crashes none;
}

NestedStateProbe satisfies SelectedProbe {
    machine probe(chosen: @mutable u64, other: @mutable u64, items: @[u8; 4]) -> u8
    reaches none requires $chosen < 4 && $other < 4
    {
        let zero: u64 in Wrapping = 0;
        let marker: u64 in Wrapping = add(overwrite(relay(chosen, other, false)), zero);
        let index: u64 = $other;
        let indexed: u8 = items[index];
        transition (marker as u64) == 1 && indexed == 7 {
            true -> indexed,
            _ -> 0
        }
    }
}

machine main() crashes Trap {
    let mutable chosen: u64 = 0;
    let mutable other: u64 = 1;
    let items: [u8; 4] = [4, 7, 8, 9];
    let found: u8 = SelectedProbe::probe(@mutable chosen, @mutable other, @items);
    transition found == 7 && chosen == 9 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
