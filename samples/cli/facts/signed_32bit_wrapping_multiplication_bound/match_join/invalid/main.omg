// Fact: 32-bit signed wrapping multiplication lhs *% rhs with bounded interval 50i32 <= prod <= 200i32 establishes 50i32 <= prod <= 200i32 across all nine places so exact subtractions 200i32 - prod and prod - 50i32 are safe.

machine verify_prod(value: i32) -> i32
    requires value >= 50i32 && value <= 200i32
{
    let headroom: i32 = 200i32 - value;
    let margin: i32 = value - 50i32;
    headroom + margin
}

machine choose(flag: bool, first: i32, second: i32) -> i32
    requires first >= 50i32 && first <= 200i32 && second >= 50i32 && second <= 200i32
    ensures result >= 50i32 && result <= 200i32
{
    transition flag {
        true -> first
        false -> second
    }
}

machine probe(flag: bool, lhs: i32, rhs: i32) -> i32
    requires lhs >= 10i32 && lhs <= 21i32 && rhs >= 5i32 && rhs <= 10i32
{
    let wl: i32 in Wrapping = lhs as i32 in Wrapping;
    let wr: i32 in Wrapping = rhs as i32 in Wrapping;
    let wp: i32 in Wrapping = wl * wr;
    let prod: i32 = wp as i32;
    let joined: i32 = choose(flag, prod, 120i32);
    verify_prod(joined)
}

machine main() crashes Trap {
    let combined: i32 = probe(true, 15i32, 8i32);
    transition combined == 150i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
