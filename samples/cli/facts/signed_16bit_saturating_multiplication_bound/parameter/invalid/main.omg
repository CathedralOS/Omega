// Fact: 16-bit signed saturating multiplication lhs *| rhs with bounded interval 50i16 <= prod <= 200i16 establishes 50i16 <= prod <= 200i16 across all nine places so exact subtractions 200i16 - prod and prod - 50i16 are safe.
// Invalid: lhs upper bound 21 allows prod 210, violating verify_parameter contract. Place: parameter.
// Expected diagnostic: cannot prove requires contract for call verify_parameter

machine verify_parameter(prod: i16) -> i32
requires prod >= 50i16 && prod <= 200i16
{
    let headroom: i16 = 200i16 - prod;
    let margin: i16 = prod - 50i16;
    0i32
}

machine compute_param(lhs: i16, rhs: i16) -> i32
requires lhs >= 10i16 && lhs <= 21i16 && rhs >= 5i16 && rhs <= 10i16
{
    let w_lhs: i16 in Saturating = lhs as i16 in Saturating;
    let w_rhs: i16 in Saturating = rhs as i16 in Saturating;
    let prod_sat: i16 in Saturating = w_lhs * w_rhs;
    verify_parameter(prod_sat as i16)
}

machine probe() -> i32 {
    compute_param(15i16, 8i16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
