// Fact: 16-bit signed saturating multiplication lhs *| rhs with bounded interval 50i16 <= prod <= 200i16 establishes 50i16 <= prod <= 200i16 across all nine places so exact subtractions 200i16 - prod and prod - 50i16 are safe.
// Place: target_body. Each of four target bodies performs 16-bit signed saturating multiplication and discharges subtraction bounds.
// Expected exit: 0

machine verify_prod(prod: i16) -> i32
requires prod >= 50i16 && prod <= 200i16
{
    let headroom: i16 = 200i16 - prod;
    let margin: i16 = prod - 50i16;
    0i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86VerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let lhs: i16 = 15i16;
        let rhs: i16 = 8i16;
        let w_lhs: i16 in Saturating = lhs as i16 in Saturating;
        let w_rhs: i16 in Saturating = rhs as i16 in Saturating;
        let prod_sat: i16 in Saturating = w_lhs * w_rhs;
        let prod: i16 = prod_sat as i16;
        verify_prod(prod)
    }
}

ArmVerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let lhs: i16 = 15i16;
        let rhs: i16 = 8i16;
        let w_lhs: i16 in Saturating = lhs as i16 in Saturating;
        let w_rhs: i16 in Saturating = rhs as i16 in Saturating;
        let prod_sat: i16 in Saturating = w_lhs * w_rhs;
        let prod: i16 = prod_sat as i16;
        verify_prod(prod)
    }
}

machine probe() -> i32 {
    SelectedVerifyTarget::verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
