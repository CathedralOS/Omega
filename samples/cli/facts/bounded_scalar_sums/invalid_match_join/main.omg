// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Place: match join (invalid twin). Plain u64 match joined values do not prove an exact sum.
// `requires true` insists on every u64 input: a private machine that omits
// `requires` would infer the bound its sum needs from its callers instead
// (state_contracts.md, "Private entry inference").
machine add(a: u64, b: u64, flag: bool) -> u64
    requires true
{
    let left: u64 = match flag { true -> a, false -> b };
    let right: u64 = match flag { true -> b, false -> a };
    left + right
}

machine probe(a: u64, b: u64) -> u64 {
    add(a, b, true)
}

machine main() crashes Trap {
    transition probe(30, 40) == 70 && probe(50, 50) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
