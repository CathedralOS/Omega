// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Expected exit: 0
machine add50(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    a + b
}

data Pair where left <= 50, right <= 50, result <= 100 {
    left: u64;
    right: u64;
    result: u64;
}

machine compute(left: u64, right: u64) -> u64
    requires left <= 50 && right <= 50
    ensures result <= 100
{
    let pair: Pair = Pair { left: left, right: right, result: add50(left, right) };
    let again: u64 = pair.left + pair.right;
    transition pair.result == again {
        true -> pair.result
        _ -> 0
    }
}

machine main() crashes Trap {
    transition compute(30, 40) == 70 && compute(50, 50) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
