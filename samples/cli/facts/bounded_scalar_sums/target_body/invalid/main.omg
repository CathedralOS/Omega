// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Place: another target body (invalid twin). Plain u64 parameters leave the exact sum unproved.
boundary trait SelectedAdd {
    machine add(a: u64, b: u64) -> u64 reaches
;
}
CheckedAdd satisfies SelectedAdd {
    machine add(a: u64, b: u64) -> u64
{
    a + b
}
}







machine probe(a: u64, b: u64) -> u64 {
    SelectedAdd::add(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 70 && probe(50, 50) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
