// Every target body uses u64 [0..=50] parameters, so the sum cannot overflow.
// Compile-checked only: no ProcessExit provider.
linux_x86_64 machine add(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=100] {
    a + b
}

linux_arm64 machine add(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=100] {
    a + b
}

macos_arm64 machine add(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=100] {
    a + b
}

windows_x86_64 machine add(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=100] {
    a + b
}

machine main() {
    let total: u64 [0..=100] = add(30, 40);
    transition total == 70 { true -> pass() _ -> fail() }
    state pass() {}
    state fail() {}
}
