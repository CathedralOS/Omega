// A call result bounded by u64 [0..=50] still proves the sum cannot overflow.
// Compile-checked only: no ProcessExit provider.
machine bounded(value: u64 [0..=50]) -> u64 [0..=50] {
    value
}

machine add(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=100] {
    bounded(a) + bounded(b)
}

machine main() {
    let total: u64 [0..=100] = add(30, 40);
    transition total == 70 { true -> pass() _ -> fail() }
    state pass() {}
    state fail() {}
}
