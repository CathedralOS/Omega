// A match join of two u64 [0..=50] values still proves the sum cannot overflow.
// Compile-checked only: no ProcessExit provider.
machine add(a: u64 [0..=50], b: u64 [0..=50], flag: bool) -> u64 [0..=100] {
    let left: u64 = match flag { true -> a, false -> b };
    let right: u64 = match flag { true -> b, false -> a };
    left + right
}

machine main() {
    let total: u64 [0..=100] = add(30, 40, true);
    transition total == 70 { true -> pass() _ -> fail() }
    state pass() {}
    state fail() {}
}
