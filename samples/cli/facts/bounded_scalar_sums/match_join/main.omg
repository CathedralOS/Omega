// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Place: match join. Both arms keep the operands inside their bounds, so the
// joined operands still add exactly.
// Expected exit: 0
machine add(a: u64, b: u64, flag: bool) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    let left: u64 = match flag { true -> a, false -> b };
    let right: u64 = match flag { true -> b, false -> a };
    left + right
}

machine probe(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    add(a, b, true)
}

machine main() crashes Trap {
    transition probe(30, 40) == 70 && probe(50, 50) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
