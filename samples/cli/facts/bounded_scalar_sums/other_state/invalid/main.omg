// Another state receiving full-range u64 parameters does not prove an exact sum.
machine add(a: u64 [0..=18446744073709551615], b: u64 [0..=18446744073709551615]) -> u64 {
    transition { _ -> sum(a, b) }
    state sum(left: u64 [0..=18446744073709551615], right: u64 [0..=18446744073709551615]) -> u64 {
        left + right
    }
}

machine main() {
    _ = add(30, 40);
}
