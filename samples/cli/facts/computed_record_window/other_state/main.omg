// In the which == 0 arm, [0..which + 2] has length 2; hold preserves that
// extent in its returned Held.values, through which write_pair writes the backing.
// Expected exit: 0

data Held<'samples> { values: @'samples mutable [f64]; }
machine window<'samples>(samples: @'samples mutable [f64; 4], which: i64) -> @'samples mutable [f64]
ensures result.length == 2
{
    let selected: @mutable [f64] = match which {
        0 -> @mutable samples[0..which + 2],
        _ -> @mutable samples[2..4]
    };
    transition { _ -> carry(selected) }
    machine carry(selected: @'samples mutable [f64]) -> @'samples mutable [f64]
    requires selected.length == 2
    { selected }
}
machine hold<'samples>(samples: @'samples mutable [f64]) -> Held<'samples>
requires samples.length == 2
ensures result.values.length == 2
{
    Held { values: samples }
}

machine write_pair(window: @mutable [f64])
requires window.length >= 2 {
    window[0] = 0.0;
    window[1] = 1.0;
}

machine exercise(which: i64) crashes Trap {
    let mutable samples: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    let view: @mutable [f64] = window(@mutable samples, which);
    let leading: Held = hold(view);
    write_pair(leading.values);
    let first: f64 = samples[0];
    let second: f64 = samples[1];
    let third: f64 = samples[2];
    let fourth: f64 = samples[3];
    transition (which == 0 && first == 0.0 && second == 1.0 && third == 9.0 && fourth == 9.0)
        || (which != 0 && first == 9.0 && second == 9.0 && third == 0.0 && fourth == 1.0) {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    exercise(0);
    exercise(1);
}
