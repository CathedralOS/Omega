// The landed record window used a literal `[0..2]`. This spelling uses the
// matched subject: in the arm `which == 0`, `[0..which + 2]` is that same
// window. The caller writes through the returned record field.
//
// The subject is a parameter, a local, and a field. The end itself is also
// a call whose ensured result is 2. Each window is written through the
// record.
//
// Expected exit: 0
use {omega}/language/core/float_operations.omg;

data Held<'samples> { values: @'samples mutable [f64]; }
data Holder { which: i64; samples: [f64; 4]; }

machine endpoint() -> i64
ensures result == 2
{
    2
}

machine window<'samples>(samples: @'samples mutable [f64; 4], which: i64) -> @'samples mutable [f64]
ensures result.length == 2
{
    match which {
        0 -> @mutable samples[0..which + 2],
        _ -> @mutable samples[2..4]
    }
}

machine window_local<'samples>(samples: @'samples mutable [f64; 4], which: i64) -> @'samples mutable [f64]
ensures result.length == 2
{
    let index: i64 = which;
    match index {
        0 -> @mutable samples[0..index + 2],
        _ -> @mutable samples[2..4]
    }
}

machine window_field<'row>(holder: @'row mutable Holder) -> @'row mutable [f64]
ensures result.length == 2
{
    match holder.which {
        0 -> @mutable holder.samples[0..holder.which + 2],
        _ -> @mutable holder.samples[2..4]
    }
}

machine window_call<'samples>(samples: @'samples mutable [f64; 4], which: i64) -> @'samples mutable [f64]
ensures result.length == 2
{
    match which {
        0 -> @mutable samples[0..endpoint()],
        _ -> @mutable samples[2..4]
    }
}

machine hold<'samples>(samples: @'samples mutable [f64]) -> Held<'samples>
requires samples.length == 2
ensures result.values.length == 2
{
    Held { values: samples }
}

machine write_pair(window: @mutable [f64])
requires window.length >= 2 {
    window[0] = 0.0;
    window[1] = 1.0;
}

machine exercise_local() crashes Trap {
    let mutable samples: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    let view: @mutable [f64] = window_local(@mutable samples, 0);
    let leading: Held = hold(view);
    write_pair(leading.values);
    transition {
        _ -> check(@mutable samples)
    }
    machine check(samples: @mutable [f64; 4]) {
        let first: i32 in Saturating = |float_operations|::I32::from_f64(samples[0]);
        let second: i32 in Saturating = |float_operations|::I32::from_f64(samples[1]);
        let third: i32 in Saturating = |float_operations|::I32::from_f64(samples[2]);
        transition first == 0 && second == 1 && third == 9 {
            true -> done(),
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine exercise_field() crashes Trap {
    let mutable holder: Holder = Holder { which: 0, samples: [9.0, 9.0, 9.0, 9.0] };
    let view: @mutable [f64] = window_field(@mutable holder);
    let leading: Held = hold(view);
    write_pair(leading.values);
    transition {
        _ -> check(@mutable holder)
    }
    machine check(holder: @mutable Holder) {
        let first: i32 in Saturating = |float_operations|::I32::from_f64(holder.samples[0]);
        let second: i32 in Saturating = |float_operations|::I32::from_f64(holder.samples[1]);
        let third: i32 in Saturating = |float_operations|::I32::from_f64(holder.samples[2]);
        transition first == 0 && second == 1 && third == 9 {
            true -> done(),
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine exercise_call() crashes Trap {
    let mutable samples: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    let view: @mutable [f64] = window_call(@mutable samples, 0);
    let leading: Held = hold(view);
    write_pair(leading.values);
    transition {
        _ -> check(@mutable samples)
    }
    machine check(samples: @mutable [f64; 4]) {
        let first: i32 in Saturating = |float_operations|::I32::from_f64(samples[0]);
        let second: i32 in Saturating = |float_operations|::I32::from_f64(samples[1]);
        let third: i32 in Saturating = |float_operations|::I32::from_f64(samples[2]);
        transition first == 0 && second == 1 && third == 9 {
            true -> done(),
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    exercise_local();
    exercise_field();
    exercise_call();
    let mutable trace: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    let view: @mutable [f64] = window(@mutable trace, 0);
    let leading: Held = hold(view);
    write_pair(leading.values);
    let span: u64 = leading.values.length;
    transition span == 2 {
        true -> tail(@mutable trace),
        false -> bad()
    }
    machine tail(trace: @mutable [f64; 4]) {
        let selected: @mutable [f64] = window(trace, 1);
        let trailing: Held = hold(selected);
        write_pair(trailing.values);
        let first: i32 in Saturating = |float_operations|::I32::from_f64(trace[0]);
        let second: i32 in Saturating = |float_operations|::I32::from_f64(trace[1]);
        let third: i32 in Saturating = |float_operations|::I32::from_f64(trace[2]);
        let fourth: i32 in Saturating = |float_operations|::I32::from_f64(trace[3]);
        transition first == 0 && second == 1 && third == 0 && fourth == 1 {
            true -> done(),
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
