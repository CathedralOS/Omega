// An owned match carries its selected Payload, exact captured source and field projection, and complete residual cleanup roster through transport, then consumes the result with (left >> 4) ^ right.
// Place: target_body.
// Expected exit: 0
data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }

machine supply(first: u64, second: u64) -> Pair {
    Pair {
        first: Payload { left: first, right: second },
        second: Payload { left: second, right: first }
    }
}

machine fold(value: Payload) -> u64 {
    (value.left >> 4) ^ value.right
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSelect {
    machine select(selected: u64, first: u64, second: u64) -> Payload
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Select satisfies SelectedSelect {
    machine select(selected: u64, first: u64, second: u64) -> Payload
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let pair: Pair = Pair {
            first: Payload { left: first, right: second },
            second: Payload { left: second, right: first }
        };
        match selected {
            0 -> pair.first,
            _ -> supply(first ^ 255, second ^ 255).second
        }
    }
}

ArmSelect satisfies SelectedSelect {
    machine select(selected: u64, first: u64, second: u64) -> Payload
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let pair: Pair = Pair {
            first: Payload { left: first, right: second },
            second: Payload { left: second, right: first }
        };
        match selected {
            0 -> pair.first,
            _ -> supply(first ^ 255, second ^ 255).second
        }
    }
}

machine choose(selected: u64, first: u64, second: u64) -> u64 {
    let result: Payload = SelectedSelect::select(selected, first, second);
    let consumed_again: u64 = fold(result);
    fold(result)
}

machine main() crashes Trap {
    let first_result: u64 = choose(0, 4, 6);
    let second_result: u64 = choose(1, 4, 6);
    transition first_result == 6 && second_result == 244 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
