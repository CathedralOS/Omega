// Computed declaration geometry precedes nested leaves, whole-array results, and aliases.
// Expected exit: 0
const BASE: u64 = 1 + 0;
const SIZE: u64 = BASE + 0;
const EMPTY: u64 = 0 + 0;
const ZERO: [u64; EMPTY] = [];
const SOURCE: [[u64; SIZE]; SIZE] = [[3 + 0]];
const ALIAS: [[u64; SIZE]; SIZE] = SOURCE;
machine make() -> [u64; SIZE] { [3u64] }
const CALLED: [u64; SIZE] = make();
const MATCHED: [u64; SIZE] = match true { true -> CALLED, false -> [9u64] };
data Holder [copy] { items: [u64; SIZE]; }
const HELD: Holder = Holder { items: [3 + 0] };
const KEPT: Holder = HELD;
machine main() crashes Trap {
    let empty: [u64; 0] = ZERO;
    transition ALIAS[0][0] == 3 && MATCHED[0] == 3 && KEPT.items[0] == 3 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
