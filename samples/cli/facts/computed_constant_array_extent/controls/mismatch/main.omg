// Computed constant array extents preserve the selected value 3 through an alias.
// Expected exit: 0
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0, 4 + 0];
const ALIAS: [u64; 1] = SOURCE;
machine main() crashes Trap {
    transition ALIAS[0] == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
