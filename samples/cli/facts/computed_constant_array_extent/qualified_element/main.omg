// Expected exit: 0
const SIZE: u64 = 1 + 0;
data Cell [copy] where value == 3 { value: u64; }
const SOURCE: [Cell; SIZE] = [Cell { value: 3 }];
const ALIAS: [Cell; 1] = SOURCE;
machine main() crashes Trap {
    transition ALIAS[0].value == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
