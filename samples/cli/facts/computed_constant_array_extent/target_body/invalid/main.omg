// Computed constant array extents preserve the selected value 3 through an alias.
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; 1] = SOURCE;
windows_x86_64 machine select_val() -> u64 { ALIAS[1] }
linux_x86_64 machine select_val() -> u64 { ALIAS[1] }
macos_arm64 machine select_val() -> u64 { ALIAS[1] }
linux_arm64 machine select_val() -> u64 { ALIAS[1] }
machine main() crashes Trap {
    transition select_val() == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
