machine build(builder: &mut Build) {
    Build::select_provider<SelectedSelectVal, CheckedSelectVal>(builder, windows_x86_64);
    Build::select_provider<SelectedSelectVal, CheckedSelectVal>(builder, linux_x86_64);
    Build::select_provider<SelectedSelectVal, CheckedSelectVal>(builder, macos_arm64);
    Build::select_provider<SelectedSelectVal, CheckedSelectVal>(builder, linux_arm64);

    Build::application(builder, "computed_constant_array_extent");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
