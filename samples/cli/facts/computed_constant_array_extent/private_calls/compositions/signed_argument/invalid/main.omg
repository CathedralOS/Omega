// Computed constant array extents preserve the selected value 3 through an alias.
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; 1] = SOURCE;
data SignedCarrier<const N: i8> [copy] { items: [u64; 1]; canary: u64; }
machine small(input: i8) -> i8
requires input == -7i8
ensures result == -7i8
{ input }
machine read<const N: i8>(item: SignedCarrier<N>) -> u64
requires N == -7i8
{ item.items[0] }
machine main() crashes Trap {
    let item: SignedCarrier<(small(-6i8))> = SignedCarrier { items: ALIAS, canary: 73 };
    let observed: u64 = read(item);
    transition observed == 3 && item.canary == 73 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
