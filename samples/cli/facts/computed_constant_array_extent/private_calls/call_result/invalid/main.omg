// Computed constant array extents preserve the selected value 3 through an alias.
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; 1] = SOURCE;
machine make() -> [u64; checked_extent(1)] { ALIAS }
const CALLED: [u64; SIZE] = make();
machine main() crashes Trap {
    transition CALLED[1] == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine checked_extent(input: u64) -> u64
requires input == 1
ensures result == 1
{ input }

machine incorrect() crashes Trap { crash Trap; }
