// Computed constant array extents preserve the selected value 3 through an alias.
// Expected exit: 0
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; 1] = SOURCE;
const MATCHED: [u64; SIZE] = match true { true -> ALIAS, false -> SOURCE };
machine main() crashes Trap {
    private_join(true);
    private_join(false);
    transition MATCHED[0] == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine checked_extent(input: u64) -> u64
requires input == 1
ensures result == 1
{ input }

machine incorrect() crashes Trap { crash Trap; }

data PrivateJoined { items: [u64; checked_extent(1)]; tag: u64; }
machine private_join(first: bool) crashes Trap {
    let chosen: PrivateJoined = match first {
        true -> PrivateJoined { items: ALIAS, tag: 11 }
        false -> PrivateJoined { items: SOURCE, tag: 29 }
    };
    let tag: u64 = match first { true -> 11 false -> 29 };
    transition chosen.items[0] == 3 && chosen.tag == tag {
        true -> finish()
        _ -> wrong()
    }
    machine finish() {}
    machine wrong() { crash Trap; }
}
