// Computed constant array extents preserve the selected value 3 through an alias.
// Expected exit: 0
const BASE: u64 = 1 + 0;
const SIZE: u64 = BASE + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; SIZE] = SOURCE;
const SELECTED: [u64; 1] = ALIAS;
machine main() crashes Trap {
    transition SELECTED[0] == 3 && checked_selection(&mut SELECTED) == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine checked_extent(input: u64) -> u64
requires input == 1
ensures result == 1
{ input }

machine incorrect() crashes Trap { crash Trap; }

machine checked_selection(items: &mut [u64; checked_extent(1)]) -> u64 { items[0] }
