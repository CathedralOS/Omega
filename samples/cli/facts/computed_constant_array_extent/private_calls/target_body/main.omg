// Computed constant array extents preserve the selected value 3 through an alias.
// Expected exit: 0
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; 1] = SOURCE;
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSelectVal {
    machine select_val() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86SelectVal satisfies SelectedSelectVal {
    machine select_val() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        let checked_alias: [u64; checked_extent(1)] = ALIAS;
        SelectedBodyCheck::require_tag(17u64);
     checked_alias[0]
    }
}

ArmSelectVal satisfies SelectedSelectVal {
    machine select_val() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        let checked_alias: [u64; checked_extent(1)] = ALIAS;
        SelectedBodyCheck::require_tag(29u64);
     checked_alias[0]
    }
}


machine main() crashes Trap {
    transition SelectedSelectVal::select_val() == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}

machine checked_extent(input: u64) -> u64
requires input == 1
ensures result == 1
{ input }

machine incorrect() crashes Trap { crash Trap; }
