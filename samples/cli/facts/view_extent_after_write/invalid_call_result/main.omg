// A view of at least 1024 bytes retains its extent after an indexed byte write through a helper.
// Invalid control: the 1024-byte lower bound is not established.
machine write_first(first: @mutable u8) { $first = 41; }
machine identity(bytes: @mutable [u8]) -> @mutable [u8]
ensures result.length >= bytes.length && result.length <= bytes.length { bytes }
machine preserve_suffix(bytes: @mutable [u8])
requires bytes.length >= 3
{
    let view: @mutable [u8] = identity(bytes);
    let saved: u8 = view[view.length - 4];
    write_first(@mutable view[0]);
    view[view.length - 4] = saved;
}
machine main() crashes Trap {
    let mutable bytes: [u8; 1024];
    bytes[1020] = 73;
    preserve_suffix(@mutable bytes[..]);
    transition bytes[0] == 41 && bytes[1020] == 73 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
