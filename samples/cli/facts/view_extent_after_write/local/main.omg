// A view of at least 1024 bytes retains its extent after an indexed byte write through a helper.
// Expected exit: 0
machine write_first(first: &mut u8) { first = 41; }
machine preserve_suffix(bytes: &mut [u8])
requires bytes.len >= 1024;
{
    let view: &mut [u8] = bytes;
    let saved: u8 = view[view.len - 4];
    write_first(&mut view[0]);
    view[view.len - 4] = saved;
}
machine main() crashes Trap {
    let mut bytes: [u8; 1024];
    bytes[1020] = 73;
    preserve_suffix(&mut bytes[..]);
    transition bytes[0] == 41 && bytes[1020] == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
