// A generic comparison body returns false. The call records that boolean,
// and the caller reads the record.
// Place: match_join.
// Expected exit: 0
machine same<T>(left: T, right: T) -> bool {
    false
}

machine compare<T>(left: T, right: T) -> bool {
    same<T>(left, right)
}

machine hold(direct: bool) -> bool
requires direct == false
{
    true
}

machine main() crashes Trap {
    let flag: bool = true;
    let left: u64 = match flag { true -> 1u64, false -> 1u64 };
    let right: u64 = match flag { true -> 1u64, false -> 1u64 };
    let direct: bool = compare<u64>(left, right);
    transition hold(direct) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
