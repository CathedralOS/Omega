// Two co-live claims inside one bound use the sum of their aligned extents, and two exclusive branches use the maximum.
// The one bound is the closed u64 demand. These two co-live bounds sum past it
// and must reject before either claim is established.
use omega::language::core::activation;

machine main() crashes Trap {
    transition Activation::try_claim<9223372036854775808>(1) {
        ActivationClaimAttempt::Established { claim } -> first(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    machine first(first: ActivationClaim) {
        transition Activation::try_claim<9223372036854775808>(1) {
            ActivationClaimAttempt::Established { claim } -> both(first, claim)
            ActivationClaimAttempt::Rejected -> release_first(first)
        }
    }
    machine both(first: ActivationClaim, second: ActivationClaim) {
        ActivationClaim::release(second);
        ActivationClaim::release(first);
    }
    machine release_first(claim: ActivationClaim) {
        ActivationClaim::release(claim);
        crash Trap;
    }
    machine bad() { crash Trap; }
}
