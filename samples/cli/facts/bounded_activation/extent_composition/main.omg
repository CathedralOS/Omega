// Two co-live claims inside one bound use the sum of their aligned extents, and two exclusive branches use the maximum.
// Expected exit: 0
// The one bound is 16 bytes. Co-live claims of 8 and 8 sum to that bound.
// The exclusive branches claim 16 and 12, so their demand is the maximum, 16.
use omega::language::core::activation;

machine mark(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= 8 {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= 8 {
        bytes[7] = 11u8;
        bytes[7]
    }
}

machine mark_second(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= 8 {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= 8 {
        bytes[7] = 22u8;
        bytes[7]
    }
}

machine mark_wide(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= 16 {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= 16 {
        bytes[15] = 16u8;
        bytes[15]
    }
}

machine mark_narrow(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= 12 {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= 12 {
        bytes[11] = 12u8;
        bytes[11]
    }
}

machine main() crashes Trap {
    transition Activation::try_claim<8>(8) {
        ActivationClaimAttempt::Established { claim } -> first(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    machine first(first: ActivationClaim) {
        transition Activation::try_claim<8>(8) {
            ActivationClaimAttempt::Established { claim } -> both(first, claim)
            ActivationClaimAttempt::Rejected -> release_first(first)
        }
    }
    machine both(first: ActivationClaim, second: ActivationClaim) {
        let mut first_owner: ActivationClaim = first;
        let mut second_owner: ActivationClaim = second;
        let first_bytes: &mut [u8] = ActivationClaim::bytes(&mut first_owner);
        let second_bytes: &mut [u8] = ActivationClaim::bytes(&mut second_owner);
        let first_mark: u8 = mark(first_bytes);
        let second_mark: u8 = mark_second(second_bytes);
        ActivationClaim::release(second_owner);
        ActivationClaim::release(first_owner);
        transition first_mark == 11u8 && second_mark == 22u8 {
            true -> wide()
            false -> narrow()
        }
    }
    machine wide() {
        transition Activation::try_claim<16>(16) {
            ActivationClaimAttempt::Established { claim } -> wide_live(claim)
            ActivationClaimAttempt::Rejected -> bad()
        }
    }
    machine wide_live(claim: ActivationClaim) {
        let mut owner: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut owner);
        let mark: u8 = mark_wide(bytes);
        ActivationClaim::release(owner);
        transition mark == 16u8 {
            true -> done()
            false -> bad()
        }
    }
    machine narrow() {
        transition Activation::try_claim<12>(12) {
            ActivationClaimAttempt::Established { claim } -> narrow_live(claim)
            ActivationClaimAttempt::Rejected -> bad()
        }
    }
    machine narrow_live(claim: ActivationClaim) {
        let mut owner: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut owner);
        let mark: u8 = mark_narrow(bytes);
        ActivationClaim::release(owner);
        transition mark == 12u8 {
            true -> done()
            false -> bad()
        }
    }
    machine release_first(claim: ActivationClaim) {
        ActivationClaim::release(claim);
        crash Trap;
    }
    machine done() {}
    machine bad() { crash Trap; }
}
