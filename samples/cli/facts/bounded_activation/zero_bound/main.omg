// Expected exit: 0
use omega::language::core::activation;
machine main() crashes Trap {
    transition Activation::try_claim<0>(0) {
        ActivationClaimAttempt::Established { claim } -> live(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    machine live(claim: ActivationClaim) {
        let mut owner: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut owner);
        let count: u64 = bytes.len;
        ActivationClaim::release(owner);
        transition count == 0 { true -> reject() false -> bad() }
    }
    machine reject() {
        transition Activation::try_claim<0>(1) {
            ActivationClaimAttempt::Rejected -> done()
            ActivationClaimAttempt::Established { claim } -> unexpected(claim)
        }
    }
    machine unexpected(claim: ActivationClaim) { ActivationClaim::release(claim); crash Trap; }
    machine done() {}
    machine bad() { crash Trap; }
}
