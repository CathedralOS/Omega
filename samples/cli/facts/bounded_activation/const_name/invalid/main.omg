// Fact: Commit three bytes under bound eight, write/read the committed region, release it, and observe checked rejection of a request for nine bytes.
use omega::language::core::activation;

const BOUND: u64 = 8;
const COMMITTED: u64 = 3;
const OVER_BOUND: u64 = 9;
const MARKER: u8 = 37u8;

machine write_read(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= COMMITTED {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= COMMITTED {
        bytes[2] = MARKER;
        bytes[2]
    }
}

machine main() crashes Trap {
    transition Activation::try_claim<BOUND>(COMMITTED) {
        ActivationClaimAttempt::Established { claim } -> established(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    machine established(claim: ActivationClaim) {
        let mut live: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut live);
        let observed: u8 = write_read(bytes);
        ActivationClaim::release(live);
        let length: u64 = bytes.len;
        transition length == COMMITTED && observed == MARKER {
            true -> over_bound()
            false -> bad()
        }
    }
    machine over_bound() {
        transition Activation::try_claim<BOUND>(OVER_BOUND) {
            ActivationClaimAttempt::Rejected -> done()
            ActivationClaimAttempt::Established { claim } -> unexpectedly_established(claim)
        }
    }
    machine unexpectedly_established(claim: ActivationClaim) {
        ActivationClaim::release(claim);
        crash Trap;
    }
    machine done() {}
    machine bad() { crash Trap; }
}
