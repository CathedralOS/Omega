// Fact: Commit three bytes under bound eight, write/read the committed region, release it, and observe checked rejection of a request for nine bytes.
use {omega}/language/core/activation.omg;

const BOUND: u64 = 8;
const COMMITTED: u64 = 3;
const OVER_BOUND: u64 = 9;
const MARKER: u8 = 37u8;

machine write_read(bytes: @mutable [u8]) -> u8 {
    transition bytes.length >= COMMITTED {
        true -> access(bytes),
        false -> (0u8)
    }
    machine access(bytes: @mutable [u8]) -> u8
    requires bytes.length >= COMMITTED {
        bytes[2] = MARKER;
        bytes[2]
    }
}

machine main() crashes Trap {
    transition |activation|::Activation::try_claim::<BOUND>(COMMITTED) {
        |activation|::ActivationClaimAttempt::Established { claim } -> established(claim),
        |activation|::ActivationClaimAttempt::Rejected -> bad()
    }
    machine established(claim: |activation|::ActivationClaim) {
        let mutable live: |activation|::ActivationClaim = claim;
        let bytes: @mutable [u8] = |activation|::ActivationClaim::bytes(@mutable live);
        let observed: u8 = write_read(bytes);
        |activation|::ActivationClaim::release(live);
        let length: u64 = bytes.length;
        transition length == COMMITTED && observed == MARKER {
            true -> over_bound(),
            false -> bad()
        }
    }
    machine over_bound() {
        transition |activation|::Activation::try_claim::<BOUND>(OVER_BOUND) {
            |activation|::ActivationClaimAttempt::Rejected -> done(),
            |activation|::ActivationClaimAttempt::Established { claim } -> unexpectedly_established(claim)
        }
    }
    machine unexpectedly_established(claim: |activation|::ActivationClaim) {
        |activation|::ActivationClaim::release(claim);
        crash Trap;
    }
    machine done() {}
    machine bad() { crash Trap; }
}
