// One established claim splits into covering children and those children merge back into that claim.
// Expected exit: 0
// The parent bound is 16 and its committed prefix is 8. The covering cut's
// committed length arrives as a parameter.
use omega::language::core::activation;

machine mark(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= 8 {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= 8 {
        bytes[0] = 11u8;
        bytes[0]
    }
}

machine read_mark(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= 8 {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= 8 {
        bytes[0]
    }
}

machine exercise(committed_at: u64) -> u8 crashes Trap {
    transition Activation::try_claim<16>(8) {
        ActivationClaimAttempt::Established { claim } -> established(claim, committed_at)
        ActivationClaimAttempt::Rejected -> (0u8)
    }
    machine established(claim: ActivationClaim, committed_at: u64) -> u8 {
        let mut live: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut live);
        let marked: u8 = mark(bytes);
        transition marked == 11u8 {
            true -> divide(live, committed_at)
            false -> release_bad(live)
        }
    }
    machine release_bad(claim: ActivationClaim) -> u8 {
        ActivationClaim::release(claim);
        crash Trap;
    }
    machine divide(claim: ActivationClaim, committed_at: u64) -> u8 {
        transition ActivationClaim::split<8>(claim, committed_at) {
            ActivationClaimSplit::Covered { lower, upper } -> merge_children(lower, upper)
            ActivationClaimSplit::Rejected { claim } -> return_rejected(claim)
        }
    }
    machine return_rejected(claim: ActivationClaim) -> u8 {
        ActivationClaim::release(claim);
        crash Trap;
    }
    machine merge_children(lower: ActivationClaim, upper: ActivationClaim) -> u8 {
        transition ActivationClaim::merge(lower, upper) {
            ActivationClaimMerge::Covered { claim } -> restored(claim)
            ActivationClaimMerge::Rejected { lower, upper } -> merge_rejected(lower, upper)
        }
    }
    machine merge_rejected(lower: ActivationClaim, upper: ActivationClaim) -> u8 {
        ActivationClaim::release(upper);
        ActivationClaim::release(lower);
        crash Trap;
    }
    machine restored(claim: ActivationClaim) -> u8 {
        let mut live: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut live);
        let length: u64 = bytes.len;
        let observed: u8 = read_mark(bytes);
        ActivationClaim::release(live);
        transition length == 8 && observed == 11u8 {
            true -> (observed)
            false -> (0u8)
        }
    }
}

machine main() crashes Trap {
    let observed: u8 = exercise(4);
    transition observed == 11u8 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
