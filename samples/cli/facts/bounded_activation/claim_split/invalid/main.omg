// One established claim splits into covering children and those children merge back into that claim.
// The parent bound is 16. A cut at that same bound leaves the upper child
// empty, so the children do not cover the parent. This must reject.
use omega::language::core::activation;

machine main() crashes Trap {
    transition Activation::try_claim<16>(8) {
        ActivationClaimAttempt::Established { claim } -> established(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    machine established(claim: ActivationClaim) {
        transition ActivationClaim::split<16>(claim, 4) {
            ActivationClaimSplit::Covered { lower, upper } -> merge_children(lower, upper)
            ActivationClaimSplit::Rejected { claim } -> return_rejected(claim)
        }
    }
    machine return_rejected(claim: ActivationClaim) {
        ActivationClaim::release(claim);
        crash Trap;
    }
    machine merge_children(lower: ActivationClaim, upper: ActivationClaim) {
        transition ActivationClaim::merge(lower, upper) {
            ActivationClaimMerge::Covered { claim } -> restored(claim)
            ActivationClaimMerge::Rejected { lower, upper } -> merge_rejected(lower, upper)
        }
    }
    machine merge_rejected(lower: ActivationClaim, upper: ActivationClaim) {
        ActivationClaim::release(upper);
        ActivationClaim::release(lower);
        crash Trap;
    }
    machine restored(claim: ActivationClaim) {
        ActivationClaim::release(claim);
    }
    machine bad() { crash Trap; }
}
