// Expected exit: 0
use omega::language::core::activation;
data Holder { claim: ActivationClaim; }
machine main() crashes Trap {
    let attempt: ActivationClaimAttempt = Activation::try_claim<8>(3);
    transition attempt {
        ActivationClaimAttempt::Established { claim } -> live(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    machine live(claim: ActivationClaim) {
        let holder: Holder = Holder { claim: claim };
        ActivationClaim::release(holder.claim);
    }
    machine bad() { crash Trap; }
}
