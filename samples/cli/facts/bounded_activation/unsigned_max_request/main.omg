// Expected exit: 0
use omega::language::core::activation;
machine exercise(committed: u64) -> u64 crashes Trap {
    transition Activation::try_claim<8>(committed) {
        ActivationClaimAttempt::Established { claim } -> live(claim)
        ActivationClaimAttempt::Rejected -> (0)
    }
    machine live(claim: ActivationClaim) -> u64 {
        let mut owner: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut owner);
        let count: u64 = bytes.len;
        ActivationClaim::release(owner);
        count
    }
}
machine main() crashes Trap {
    let count: u64 = exercise(3);
    let rejected: u64 = exercise(9);
    let huge: u64 = exercise(18446744073709551615);
    transition count == 3 && rejected == 0 && huge == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
