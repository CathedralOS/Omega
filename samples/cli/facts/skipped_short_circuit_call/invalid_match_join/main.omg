// A left operand proved false skips the right-hand bump call: the conjunction is false and the counter stays 0.
// Place: match_join (invalid twin). The left operand is the join of a match whose arms both produce the Boolean. The left operand is true, so bump runs and the counter is no longer known to be 0.
machine bump(counter: &mut u64) -> bool
requires counter <= 1000u64
{
    counter = counter + 1u64;
    true
}

machine untouched(counter: u64) -> u64
requires counter == 0u64
ensures result == 0u64
{
    counter
}


machine main() crashes Trap {
    let mut counter: u64 = 0u64;
    let mode: u64 = 2u64;
    let ready: bool = match mode {
        1u64 -> true
        _ -> true
    };
    let first: bool = ready && bump(&mut counter);
    let kept: u64 = untouched(counter);
    transition first {
        true -> bad()
        false -> check(kept, counter)
    }
    machine check(kept: u64, counter: u64) crashes Trap {
        transition kept == 0u64 && counter == 0u64 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
