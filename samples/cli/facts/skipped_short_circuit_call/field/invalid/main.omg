// A left operand proved false skips the right-hand bump call: the conjunction is false and the counter stays 0.
// Place: field (invalid twin). The left operand is a Boolean field between two canary fields. The left operand is true, so bump runs and the counter is no longer known to be 0.
machine bump(counter: &mut u64) -> bool
requires counter <= 1000u64
{
    counter = counter + 1u64;
    true
}

machine untouched(counter: u64) -> u64
requires counter == 0u64
ensures result == 0u64
{
    counter
}

data Gate { before: u64; ready: bool; after: u64; }

machine main() crashes Trap {
    let mut counter: u64 = 0u64;
    let gate: Gate = Gate { before: 3u64, ready: true, after: 4u64 };
    let first: bool = gate.ready && bump(&mut counter);
    let kept: u64 = untouched(counter);
    transition first {
        true -> bad()
        false -> check(kept, counter, gate)
    }
    machine check(kept: u64, counter: u64, gate: Gate) crashes Trap {
        transition kept == 0u64 && counter == 0u64 && gate.before == 3u64 && gate.after == 4u64 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
