// Fact: 8-bit unsigned bitwise XOR raw ^ 15u8 with bounded interval 40u8 <= xored <= 63u8 establishes 40u8 <= xored <= 63u8 across all nine places so exact subtractions 63u8 - xored and xored - 40u8 are safe.
// Place: call_result. The bitwise XOR result is returned from a callee invocation.
// Expected exit: 0
machine verify_xored(res: u8) -> i32
    requires res >= 40 && res <= 63
{
    let head: u8 = 63 - res;
    let tail: u8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

machine xor_helper(v: u8) -> u8
    requires v >= 59 && v <= 59
    ensures result >= 40 && result <= 63
{
    v ^ 15
}

machine compute_call_result(raw: u8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: u8 = xor_helper(raw);
    verify_xored(xored)
}

machine evaluate() -> i32 {
    compute_call_result(59)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
