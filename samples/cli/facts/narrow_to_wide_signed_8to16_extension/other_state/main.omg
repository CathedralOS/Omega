// Fact: sign-extending a bounded 8-bit signed i8 value (narrow >= 30i8 && narrow <= 100i8) to i16 (narrow as i16) preserves the exact interval (wide >= 30i16 && wide <= 100i16), discharging exact 16-bit signed subtractions 100i16 - wide and wide - 30i16 across all nine places.
// Place: other state. A state transition forwards the bounded sign-extended value to a successor state.
// Expected exit: 0

machine compute_wide(narrow: i8) -> i16
requires narrow >= 30i8 && narrow <= 100i8
ensures result >= 30i16 && result <= 100i16
{
    narrow as i16
}

machine verify_wide(wide: i16) -> i32 crashes Trap
requires wide >= 30i16 && wide <= 100i16
ensures result == 0i32
{
    let h1: i16 = 100i16 - wide;
    let h2: i16 = wide - 30i16;
    transition h1 == 40i16 && h2 == 30i16 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    let wide: i16 = compute_wide(60i8);
    transition {
        _ -> step(wide)
    }
    machine step(wide: i16) -> i32
    requires wide >= 30i16 && wide <= 100i16
    {
        verify_wide(wide)
    }
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
