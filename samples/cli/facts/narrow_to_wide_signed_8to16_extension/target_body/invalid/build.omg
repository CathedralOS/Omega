machine build(builder: &mut Build) {
    Build::select_provider<SelectedEvaluateWide, CheckedEvaluateWide>(builder, linux_x86_64);
    Build::select_provider<SelectedEvaluateWide, CheckedEvaluateWide>(builder, linux_arm64);
    Build::select_provider<SelectedEvaluateWide, CheckedEvaluateWide>(builder, macos_arm64);
    Build::select_provider<SelectedEvaluateWide, CheckedEvaluateWide>(builder, windows_x86_64);

    Build::application(builder, "narrow_to_wide_signed_8to16_extension_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
