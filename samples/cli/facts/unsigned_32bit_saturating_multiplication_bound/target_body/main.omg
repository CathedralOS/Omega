// Fact: 32-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u32 <= prod <= 200u32 establishes 50u32 <= prod <= 200u32 across all nine places so exact subtractions 200u32 - prod and prod - 50u32 are safe.
// Expected exit: 0

machine verify_prod(value: u32) -> u32
requires value >= 50u32 && value <= 200u32
{
    let headroom: u32 = 200u32 - value;
    let margin: u32 = value - 50u32;
    transition headroom == 80u32 && margin == 70u32 {
        true -> 0u32
        _ -> 1u32
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(lhs: u32 in Saturating, rhs: u32 in Saturating) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(lhs: u32 in Saturating, rhs: u32 in Saturating) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let prod_sat: u32 in Saturating = lhs * rhs;
        let prod: u32 = prod_sat as u32;
        transition prod >= 50u32 && prod <= 200u32 {
            true -> step(prod)
            _ -> bad()
        }
        machine step(p: u32) -> u32 {
            verify_prod(p)
        }
        machine bad() -> u32 { crash Trap; }
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(lhs: u32 in Saturating, rhs: u32 in Saturating) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let prod_sat: u32 in Saturating = lhs * rhs;
        let prod: u32 = prod_sat as u32;
        transition prod >= 50u32 && prod <= 200u32 {
            true -> step(prod)
            _ -> bad()
        }
        machine step(p: u32) -> u32 {
            verify_prod(p)
        }
        machine bad() -> u32 { crash Trap; }
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let rc: u32 = SelectedProbe::exercise(15u32, 8u32);
    transition rc == 0u32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
