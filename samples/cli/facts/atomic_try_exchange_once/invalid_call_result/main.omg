// Expected exit: 0.
// A non-observing single attempt returns the proposed u32 on failure and the displaced u32 on commit.
use {omega}/language/core/layout.omg;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine attempt(cells: @Cells, expected: u32) -> |layout|::AtomicTryExchangeOnceOutcome<u32> {
    let outcome: |layout|::AtomicTryExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(expected, 99, ReceivePublish, Receive);
    outcome
}
machine probe(cells: @Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: |layout|::AtomicTryExchangeOnceOutcome<u32> = attempt(cells, 10);
    transition outcome {
        |layout|::AtomicTryExchangeOnceOutcome::Exchanged { displaced } -> (displaced == 10 && cells.selected.load(NoOrdering) == 99 && cells.untouched.load(NoOrdering) == 17),
        |layout|::AtomicTryExchangeOnceOutcome::Mismatched { proposed } -> (false),
        |layout|::AtomicTryExchangeOnceOutcome::Uncommitted { proposed } -> (proposed == 99 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
    }
}
machine mismatch(cells: @Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: |layout|::AtomicTryExchangeOnceOutcome<u32> = attempt(cells, 9);
    transition outcome {
        |layout|::AtomicTryExchangeOnceOutcome::Mismatched { proposed } -> (proposed == 99 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17),
        |layout|::AtomicTryExchangeOnceOutcome::Exchanged { displaced } -> (false),
        |layout|::AtomicTryExchangeOnceOutcome::Uncommitted { proposed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(@cells) && mismatch(@cells) { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
