// Expected exit: 0.
// A non-observing single attempt returns the proposed u32 on failure and the displaced u32 on commit.
use omega::language::core::AtomicTryExchangeOnceOutcome;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine probe(cells: &Cells, expected: u32, want_success: bool) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: AtomicTryExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(expected, 99, ReceivePublish, Receive);
    transition { _ -> inspect(outcome, cells, want_success) }
    machine inspect(outcome: AtomicTryExchangeOnceOutcome<u32>, cells: &Cells, want_success: bool) -> bool {
        let after: u32 = cells.selected.load(NoOrdering);
        let sibling: u32 = cells.untouched.load(NoOrdering);
        transition outcome {
            AtomicTryExchangeOnceOutcome::Exchanged { displaced } -> (displaced == 10 && want_success && after == 99 && sibling == 17)
            AtomicTryExchangeOnceOutcome::Mismatched { proposed } -> (!want_success && proposed == 99 && after == 10 && sibling == 17)
            AtomicTryExchangeOnceOutcome::Uncommitted { proposed } -> (want_success && proposed == 99 && after == 10 && sibling == 17)
        }
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells, 10, true) && probe(&cells, 9, false) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
