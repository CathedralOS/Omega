// A nested record Envelope preserves its inner Header bound header.limit <= 50 and sibling payload across value transport so header.limit + payload <= 100 in all nine places.
// Invalid: header.limit <= 50 is omitted, so header.limit + payload may overflow u64.
// Expected exit: 0

data Header [copy] {
    tag: u64;
    limit: u64;
}

data Envelope [copy] {
    header: Header;
    payload: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSumEnvelope {
    machine sum_envelope(envelope: Envelope) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires envelope.payload <= 50 ensures result <= 100;
}

X86SumEnvelope satisfies SelectedSumEnvelope {
    machine sum_envelope(envelope: Envelope) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires envelope.payload <= 50 ensures result <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
        envelope.header.limit + envelope.payload
    }
}

ArmSumEnvelope satisfies SelectedSumEnvelope {
    machine sum_envelope(envelope: Envelope) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires envelope.payload <= 50 ensures result <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
        envelope.header.limit + envelope.payload
    }
}

machine probe(envelope: Envelope) -> u64
requires envelope.header.limit <= 50 && envelope.payload <= 50
ensures result <= 100
{
    SelectedSumEnvelope::sum_envelope(envelope)
}

machine main() crashes Trap {
    let envelope: Envelope = Envelope {
        header: Header { tag: 7, limit: 20 },
        payload: 22,
    };
    let sum: u64 = probe(envelope);
    transition envelope.header.tag == 7 && sum == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
