// A nested record Envelope preserves its inner Header bound header.limit <= 50 and sibling payload across value transport so header.limit + payload <= 100 in all nine places.
// Place: field. An envelope stored in a record field preserves its inner bounds into the sum.
// Expected exit: 0

data Header [copy] {
    tag: u64;
    limit: u64;
}

data Envelope [copy] {
    header: Header;
    payload: u64;
}

data Packet [copy] {
    envelope: Envelope;
}

machine sum_envelope(packet: Packet) -> u64
requires packet.envelope.header.limit <= 50 && packet.envelope.payload <= 50
ensures result <= 100
{
    let env: Envelope = packet.envelope;
    env.header.limit + env.payload
}

machine probe(packet: Packet) -> u64
requires packet.envelope.header.limit <= 50 && packet.envelope.payload <= 50
ensures result <= 100
{
    sum_envelope(packet)
}

machine main() crashes Trap {
    let packet: Packet = Packet {
        envelope: Envelope {
            header: Header { tag: 7, limit: 20 },
            payload: 22,
        },
    };
    let sum: u64 = probe(packet);
    transition packet.envelope.header.tag == 7 && sum == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
