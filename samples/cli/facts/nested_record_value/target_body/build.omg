machine build(builder: &mut Build) {
    Build::select_provider<SelectedSumEnvelope, CheckedSumEnvelope>(builder, linux_x86_64);
    Build::select_provider<SelectedSumEnvelope, CheckedSumEnvelope>(builder, linux_arm64);
    Build::select_provider<SelectedSumEnvelope, CheckedSumEnvelope>(builder, macos_arm64);
    Build::select_provider<SelectedSumEnvelope, CheckedSumEnvelope>(builder, windows_x86_64);

    Build::application(builder, "nested_record_value_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
