// For runtime u64 index < 2 into live [u64; 2], compatible references to items[index] expose the same nonzero addr and differ from the other live element address.
// Invalid: the shared query overlaps a live exclusive loan.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserve {
    machine observe(index: u64) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 2;
}

X86Observe satisfies SelectedObserve {
    machine observe(index: u64) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 2
    {
        SelectedBodyCheck::require_tag(17u64);
        let mut items: [u64; 2] = [7, 11];
        let held: &mut u64 = &mut items[index];
        let selected: addr = address_of(&items[index]);
        held = 13;
        let again: addr = address_of(&items[index]);
        let first: addr = address_of(&items[0]);
        let second: addr = address_of(&items[1]);
        transition index == 0 {
            true -> (selected == again && selected != 0 && selected == first && selected != second)
            false -> (selected == again && selected != 0 && selected == second && selected != first)
        }
    }
}

ArmObserve satisfies SelectedObserve {
    machine observe(index: u64) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 2
    {
        SelectedBodyCheck::require_tag(29u64);
        let mut items: [u64; 2] = [7, 11];
        let held: &mut u64 = &mut items[index];
        let selected: addr = address_of(&items[index]);
        held = 13;
        let again: addr = address_of(&items[index]);
        let first: addr = address_of(&items[0]);
        let second: addr = address_of(&items[1]);
        transition index == 0 {
            true -> (selected == again && selected != 0 && selected == first && selected != second)
            false -> (selected == again && selected != 0 && selected == second && selected != first)
        }
    }
}


machine probe(input: u64) -> bool requires input < 2 { SelectedObserve::observe(input) }
machine main() crashes Trap {
    let zero: bool = probe(0);
    let one: bool = probe(1);
    transition zero && one { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
