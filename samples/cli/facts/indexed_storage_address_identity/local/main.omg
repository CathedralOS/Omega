// For runtime u64 index < 2 into live [u64; 2], compatible references to items[index] expose the same nonzero address and differ from the other live element address.
// Expected exit: 0.
machine probe(input: u64) -> bool requires input < 2 {
    let mutable items: [u64; 2] = [7, 11];
    let index: u64 = input;
    let selected: address = address_of(@items[index]);
    let again: address = address_of(@items[index]);
    let first: address = address_of(@items[0]);
    let second: address = address_of(@items[1]);
    transition index == 0 {
        true -> (selected == again && selected != 0 && selected == first && selected != second),
        false -> (selected == again && selected != 0 && selected == second && selected != first)
    }
}
machine main() crashes Trap {
    let zero: bool = probe(0);
    let one: bool = probe(1);
    transition zero && one { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
