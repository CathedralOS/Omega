        FortyChoice::V29 { v } -> v
        FortyChoice::V30 { v } -> v
        FortyChoice::V31 { v } -> v
        FortyChoice::V32 { v } -> v
        FortyChoice::V33 { v } -> v
        FortyChoice::V34 { v } -> v
        FortyChoice::V35 { v } -> v
        FortyChoice::V36 { v } -> v
        FortyChoice::V37 { v } -> v
        FortyChoice::V38 { v } -> v
        FortyChoice::V39 { v } -> v
        FortyChoice::V40 { v } -> v
    }
}

machine probe(choice: FortyChoice) -> u64 {
    let res: u64 = extract_payload(choice);
    verify_payload(res)
}

machine main() crashes Trap {
    let p: FortyChoice = FortyChoice::V40 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
