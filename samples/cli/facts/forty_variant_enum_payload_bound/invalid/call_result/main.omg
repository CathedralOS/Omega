        FortyChoice::V13 { v } -> v
        FortyChoice::V14 { v } -> v
        FortyChoice::V15 { v } -> v
        FortyChoice::V16 { v } -> v
        FortyChoice::V17 { v } -> v
        FortyChoice::V18 { v } -> v
        FortyChoice::V19 { v } -> v
        FortyChoice::V20 { v } -> v
        FortyChoice::V21 { v } -> v
        FortyChoice::V22 { v } -> v
        FortyChoice::V23 { v } -> v
