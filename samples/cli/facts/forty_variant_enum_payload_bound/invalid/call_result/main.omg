elf.v <= 80u64)) || ((self in FortyChoice::V29) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V30) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V31) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V32) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V33) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V34) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V35) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V36) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V37) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V38) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V39) && (self.v >= 40u64 && self.v <= 80u64)) || ((self in FortyChoice::V40) && (self.v >= 39u64 && self.v <= 80u64))
