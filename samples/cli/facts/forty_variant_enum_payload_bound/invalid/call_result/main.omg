machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine extract_payload(choice: FortyChoice) -> u64
    ensures result >= 40u64 && result <= 80u64
{
    transition choice {
        FortyChoice::V1 { v } -> v
        FortyChoice::V2 { v } -> v
        FortyChoice::V3 { v } -> v
        FortyChoice::V4 { v } -> v
        FortyChoice::V5 { v } -> v
        FortyChoice::V6 { v } -> v
        FortyChoice::V7 { v } -> v
