// A nominal owner retains its exclusive output reference through a shared call, then normal cleanup writes captured code 7 to the original backing.
// Production: named domain through an owned parameter.
// Expected exit: 0.
data Seed [copy] { code: u64; }
data Counter { value: u64; invocations: u64 in Wrapping; }
data Keeper { output: &mut Counter; code: u64; }
domain Keeper::Held(keeper) dropped by release_keeper requires keeper.code == 7;
machine release_keeper(keeper: &mut Keeper) requires keeper.code == 7 {
    keeper.output.value = keeper.code;
    keeper.output.invocations = keeper.output.invocations + 1;
}
machine observe(keeper: &Keeper) {}
machine check(output: &Counter) crashes Trap {
    transition output.value == 7 && output.invocations == 1 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
data Envelope<T> { keeper: T; }
machine consume(envelope: Envelope<Keeper in Held>) requires envelope.keeper.code == 7 {}
machine main() crashes Trap {
    let mut output: Counter = Counter { value: 0, invocations: 0 };
    consume(Envelope { keeper: Keeper { output: &mut output, code: 7 } });
    check(&output);
}
