// A nominal owner retains its exclusive output reference through a shared call, then normal cleanup writes captured code 7 to the original backing.
// Place: parameter.
// Expected exit: 0.
data Seed [copy] { code: u64; }
data Counter { value: u64; invocations: u64 in Wrapping; }
data Keeper<T> dropped by release_keeper<T> { output: &mut Counter; code: u64; payload: T; }
machine release_keeper<T>(keeper: &mut Keeper<T>) requires keeper.code == 7 {
    keeper.output.value = keeper.code;
    keeper.output.invocations = keeper.output.invocations + 1;
}
machine observe<T>(keeper: &Keeper<T>) {}
machine check(output: &Counter) crashes Trap {
    transition output.value == 7 && output.invocations == 1 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
machine consume(keeper: Keeper<u64>) requires keeper.code == 7 {}
machine main() crashes Trap {
    let mut output: Counter = Counter { value: 0, invocations: 0 };
    let keeper: Keeper<u64> = Keeper { output: &mut output, code: 6, payload: 9 };
    consume(keeper);
    check(&output);
}
