machine helper(value: u64) -> u64 { 0 }
machine left() -> u64 {
    helper(7)
    machine helper(value: u64) -> u64 { value }
}
machine right() -> bool {
    helper(true)
    machine helper(value: bool) -> bool { value }
}
machine main() crashes Trap {
    transition helper(1) == 0 && left() == 7 && right() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
