// Distinct enclosing result overloads retain independent nested helper identities.
// Expected exit: 0.
machine outer(value: u64) -> u64 {
    helper()
    machine helper() -> u64 { 7 }
}
machine outer(value: u64) -> u64 in Wrapping {
    helper() as u64 in Wrapping
    machine helper() -> u64 { 11 }
}
machine main() crashes Trap {
    let ordinary: u64 = outer(0);
    let wrapped: u64 in Wrapping = outer(0);
    transition ordinary == 7 && wrapped == (11 as u64 in Wrapping) { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
