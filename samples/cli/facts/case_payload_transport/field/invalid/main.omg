// A multi-variant Outcome sum carries its active payload value <= 50 across the place so matching Outcome::Ready adds 10 within result <= 60.

data Outcome [copy] {
    case Empty;
    case Ready(value: u64) where value <= 80;
}

data Holder [copy] {
    outcome: Outcome;
}

machine eval(holder: Holder) -> u64
    ensures result <= 60
{
    let outcome: Outcome = holder.outcome;
    transition outcome {
        Outcome::Ready { value } -> (value + 10)
        Outcome::Empty {} -> 0
    }
}

machine main() crashes Trap {
    let a: Holder = Holder { outcome: Outcome::Ready { value: 32 } };
    let b: Holder = Holder { outcome: Outcome::Empty {} };
    transition eval(a) == 42 && eval(b) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
