// A multi-variant Outcome sum carries its active payload value <= 50 across the place so matching Outcome::Ready adds 10 within result <= 60.

data Outcome [copy] {
    case Empty;
    case Ready(value: u64) where value <= 80;
}

machine choose(flag: bool, first: Outcome, second: Outcome) -> Outcome {
    transition flag {
        true -> first
        false -> second
    }
}

machine eval(outcome: Outcome) -> u64
    ensures result <= 60
{
    transition outcome {
        Outcome::Ready { value } -> (value + 10)
        Outcome::Empty {} -> 0
    }
}

machine main() crashes Trap {
    let ready: Outcome = Outcome::Ready { value: 32 };
    let empty: Outcome = Outcome::Empty {};
    let joined_ready: Outcome = choose(true, ready, empty);
    let joined_empty: Outcome = choose(false, ready, empty);
    transition eval(joined_ready) == 42 && eval(joined_empty) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
