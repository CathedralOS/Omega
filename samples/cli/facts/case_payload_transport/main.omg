// A multi-variant Outcome sum carries its active payload value <= 50 across the place so matching Outcome::Ready adds 10 within result <= 60.
// Expected exit: 0

data Outcome [copy]
    requires (self in Outcome::Empty)
       || ((self in Outcome::Ready) && self.value <= 50)
{
    case Empty;
    case Ready(value: u64);
}

machine eval(outcome: Outcome) -> u64
    ensures result <= 60
{
    let local_outcome: Outcome = outcome;
    transition local_outcome {
        Outcome::Ready { value } -> (value + 10)
        Outcome::Empty {} -> 0
    }
}

machine main() crashes Trap {
    let a: Outcome = Outcome::Ready { value: 32 };
    let b: Outcome = Outcome::Empty {};
    transition eval(a) == 42 && eval(b) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
