// Fact: a generic transfer conserves the complete counted content of its owned input.
// Expected exit: 0
// Counted model only; this carrier grants no access to physical storage.
use {omega}/language/core/content.omg;
use {omega}/language/core/foundation.omg as proof;
data Units {}
data Payload {}
data Region [linear] dropped by cleanup_region { amount: u64; }
machine cleanup_region(region: @mutable Region) {}
domain Region::Owned;
machine Owned::content(region: @Region) -> |content|::CountedQuantity<Units>
satisfies |content|::Content<Region, |content|::CountedQuantity<Units>>::project {
    |content|::CountedQuantity { magnitude: embed(region.amount) as Nat }
}
trait Transfer<T> {
    machine transfer(region: Region in Owned) -> Region in Owned
    ensures |proof|::Identity::<|content|::CountedQuantity<Units>>(
        Owned::content(old(@region)),
        Owned::content(@result)
    );
}
ConservingTransfer satisfies Transfer<Payload> {
    machine transfer(region: Region in Owned) -> Region in Owned
    ensures |proof|::Identity::<|content|::CountedQuantity<Units>>(
        Owned::content(old(@region)),
        Owned::content(@result)
    )
    { region }
}
machine observe(region: Region in Owned) -> u64 {
    let observed: u64 = region.amount;
    drop(region);
    observed
}
const AMOUNT: u64 = 29;
machine exercise(select: bool) -> u64 {
    observe(ConservingTransfer::transfer(Region { amount: AMOUNT }))
}
machine main() crashes Trap {
    let first: u64 = exercise(true);
    let second: u64 = exercise(false);
    transition first == 29 && second == 29 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
