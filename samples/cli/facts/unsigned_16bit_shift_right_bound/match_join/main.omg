// Fact: a 16-bit unsigned u16 logical right shift of a bounded input (val >= 480u16 && val <= 480u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Expected exit: 0

machine choose(flag: bool, first: u16, second: u16) -> u16
    requires first >= 120u16 && first <= 120u16 && second >= 120u16 && second <= 120u16
    ensures result >= 120u16 && result <= 120u16
{
    transition flag {
        true -> first
        false -> second
    }
}

machine probe(flag: bool, val: u16) -> u16
    requires val >= 480u16 && val <= 480u16
{
    let shifted: u16 = val >> 2u16;
    let joined: u16 = choose(flag, shifted, 120u16);
    let check: u16 = joined - 120u16;
    check
}

machine main() crashes Trap {
    let check: u16 = probe(true, 480u16);
    transition check == 0u16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
