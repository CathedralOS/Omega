// Given can_window(items, low) == true, the captured view items[low + 0 .. low + 2] has extent 2, and reading offset 1 observes original backing items[low + 1].
// Expected exit: 0
machine can_window(items: &[u8], low: u64) -> bool { items.len == 4 && low <= 3 }
machine marked_window<'a>(items: &'a [u8], low: u64, path: &write u64) -> &'a [u8]
requires can_window(items, low) == true
ensures result.len == 2
{
    path = 1;
    items[low + 0u64..low + 2u64]
}

machine read(items: &[u8], low: u64, choose: bool, path: &write u64) -> u8
requires can_window(items, low) == true
{
    let view: &[u8] = match choose {
        true -> marked_window(items, low, path)
        _ -> items[low + 0u64..low + 2u64]
    };
    let measured: u64 = view.len;
    let selected: u8 = view[1];
    match measured { 2 -> selected _ -> 0u8 }
}
machine exercise(choose: bool, expected_path: u64) crashes Trap {
    let items: [u8; 4] = [11u8, 23u8, 37u8, 53u8];
    let mut first_path: u64 = 0;
    let first: u8 = read(&items, 1, choose, &write first_path);
    let mut second_path: u64 = 0;
    let second: u8 = read(&items, 2, choose, &write second_path);
    transition first == 37u8 && second == 53u8
        && first_path == expected_path && second_path == expected_path {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    exercise(true, 1);
    exercise(false, 0);
}
