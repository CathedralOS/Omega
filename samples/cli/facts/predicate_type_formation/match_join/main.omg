// Case membership Boolean plus the formed default domain recovers T == bool, so the Boolean payload is a bool.
// Expected exit: 0.
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
machine payload(formed: Value<bool>) -> bool {
    match formed {
        Value::Boolean { value } -> value
    }
}
machine joined(flag: bool) -> bool {
    let formed: Value<bool> = match flag {
        true -> Value::Boolean { value: true },
        false -> Value::Boolean { value: false }
    };
    payload(formed)
}
machine main() crashes Trap {
    transition joined(true) == true && joined(false) == false {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
