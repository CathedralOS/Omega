// Case membership Boolean plus the formed default domain recovers T == bool, so the Boolean payload is a bool.
// This forms Integer as Value<bool>. T == i32 does not hold, so formation must reject.
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
machine payload(formed: Value<bool>) -> bool {
    match formed {
        Value::Boolean { value } -> value
    }
}
machine supply_true() -> Value<bool> { Value::Integer { value: 1 } }
machine supply_false() -> Value<bool> { Value::Boolean { value: false } }
machine main() crashes Trap {
    let formed: Value<bool> = supply_true();
    let other: Value<bool> = supply_false();
    transition payload(formed) == true && payload(other) == false {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
