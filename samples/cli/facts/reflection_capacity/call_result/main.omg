// Fact: A pure source reflection query computes the complete capacity of the exact selected schema, and its foreign nominal result retains that bound through every value transport.
// Expected exit: 0
use {omega}/language/core/CompactBinary/compact_binary.omg;
use {omega}/language/core/reflect/reflect.omg;
use {omega}/language/core/wire.omg;
data First { #0 counter: u32; }
data Second { #0 counter: u32; #1 timestamp: u32; }
machine inspect(bound: @mutable |wire|::ScalarBound) { |reflect|::inspect_record_fields::<First, |compact_binary|::max_scalar_field>(bound); }
const BOUND: |wire|::ScalarBound = |compact_binary|::scalar_bound::<inspect>();
machine accept(bound: @|wire|::ScalarBound) requires bound.valid && bound.bytes == 7u64 {}
machine produce() -> |wire|::ScalarBound ensures result.valid && result.bytes == 7u64 { BOUND }
machine main() crashes Trap {
    let bound: |wire|::ScalarBound = produce();
    accept(@bound);
    transition bound.valid && bound.bytes == 7u64 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
