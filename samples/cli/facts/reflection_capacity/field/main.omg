// Fact: A pure source reflection query computes the complete capacity of the exact selected schema, and its foreign nominal result retains that bound through every value transport.
// Expected exit: 0
use omega_language_std::wire;
use omega::language::core::reflect;
data First { #0 counter: u32; }
data Second { #0 counter: u32; #1 timestamp: u32; }
machine inspect(bound: &mut ScalarBound) { reflect::inspect_record_fields<First, CompactBinary::max_scalar_field>(bound); }
const BOUND: ScalarBound = CompactBinary::scalar_bound<inspect>();
machine accept(bound: &ScalarBound) requires bound.valid && bound.bytes == 7u64 {}
data Holder { bound: ScalarBound; }
machine main() crashes Trap {
    let holder: Holder = Holder { bound: BOUND };
    accept(&holder.bound);
    transition holder.bound.valid && holder.bound.bytes == 7u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
