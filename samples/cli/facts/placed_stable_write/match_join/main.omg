// Fact: an exact permitted Stable field operation writes its original storage.
// Expected exit: 0
use omega::language::core::layout;

pub data Value { number: u64; }
pub data StablePlacement {}

machine StablePlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(&schema), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let mut services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 },
        access: access,
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine update(value: &mut Value, choose: bool) {
    let view: &mut Placed<StablePlacement, Value> = match choose {
        true -> Placed::view_mut<StablePlacement, Value>(value),
        false -> Placed::view_mut<StablePlacement, Value>(value),
    };
    placed_write(&mut view.number, 29u64);
}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    update(&mut value, true);
    update(&mut value, false);
    transition value.number == 29 {
        true -> done()
        _ -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
