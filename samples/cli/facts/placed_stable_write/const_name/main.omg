// Fact: an exact permitted Stable field operation writes its original storage.
// Expected exit: 0
use omega::language::core::layout;

public data Value { number: u64; }
public data StablePlacement {}

machine StablePlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(&schema), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: PermitWrite, exposure: Exposure::Exported }
    );
    let mut services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 },
        access: access,
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

const PermitWrite: bool = true;

machine write_pair(view: &mut Placed<StablePlacement, Value>, other: &mut Placed<StablePlacement, Value>) {
    let observed: u64 = placed_read(&other.number);
    placed_write(&mut view.number, 29u64);
}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    let mut companion: Value = Value { number: 43 };
    let companion_view: &mut Placed<StablePlacement, Value> = Placed::view_mut<StablePlacement, Value>(&mut companion);
    let view: &mut Placed<StablePlacement, Value> = Placed::view_mut<StablePlacement, Value>(&mut value);
    write_pair(view, companion_view);
    transition value.number == 29 && companion.number == 43 {
        true -> done()
        _ -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
