// Fact: an exact permitted Stable field operation writes its original storage.
// Expected exit: 0
use omega\language\core\Access;
use omega\language\core\Access::view_mut;
use omega\language\core\AccessPlan;
use omega\language\core\AccessPlan::inaccessible;
use omega\language\core\AccessPlan::with;
use omega\language\core\AccessPlan::with_reach;
use omega\language\core\BoundaryReach;
use omega\language\core\Exposure;
use omega\language\core\FieldAccess;
use omega\language\core\FieldEntry;
use omega\language\core\FieldPlan;
use omega\language\core\LayoutPlan;
use omega\language\core\Schema;
use omega\language\core\read;
use omega\language\core\write;

public data Value { number: u64; }
public data StablePlacement {}

machine StablePlacement::plan(schema: Schema) -> AccessPlan {
    let mutable entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, take: false, write: false, swap: false, exposure: Exposure::Exported }
    );
    let mutable services: [u64; 32];
    AccessPlan::with_reach(
        access,
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine update<Unused>(view: @mutable Access<StablePlacement, Value>, other: @mutable Access<StablePlacement, Value>) { write_pair(view, other); }

machine write_pair(view: @mutable Access<StablePlacement, Value>, other: @mutable Access<StablePlacement, Value>) {
    let observed: u64 = read(@other.number);
    write(@mutable view.number, 29u64);
}

machine main() crashes Trap {
    let mutable value: Value = Value { number: 17 };
    let mutable companion: Value = Value { number: 43 };
    let companion_view: @mutable Access<StablePlacement, Value> = Access::view_mut::<StablePlacement, Value>(@mutable companion);
    let view: @mutable Access<StablePlacement, Value> = Access::view_mut::<StablePlacement, Value>(@mutable value);
    update::<bool>(view, companion_view);
    transition value.number == 29 && companion.number == 43 {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
