// Fact: an exact permitted Stable field operation writes its original storage.
// Expected exit: 0
use {omega}/language/core/access/access.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/reflect/reflect.omg;

public data Value { number: u64; }
public domain Value::Placed access ValueAccess;
public data ValueStorage = |layout|::LayoutStorage<Value, ValueLayout>;

public ValueLayout satisfies |layout|::FixedLayout<Value> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan
    reaches none crashes none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 }
    }
}

public ValueAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan
    reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflect|::field(Value::number),
            |layout|::FieldAccess::Stable { read: true, take: false, write: false, swap: false, exposure: |layout|::Exposure::Exported });
        plan
    }
}

machine update(value: @mutable Value, other: @mutable ValueStorage in Value::Placed, choose: bool) {
    let view: @mutable ValueStorage in Value::Placed = match choose {
        true -> |access|::view_mut::<Value, ValueStorage in Value::Placed>(value),
        false -> |access|::view_mut::<Value, ValueStorage in Value::Placed>(value),
    };
    write_pair(view, other);
}

machine write_pair(view: @mutable ValueStorage in Value::Placed, other: @mutable ValueStorage in Value::Placed) {
    let observed: u64 = |layout|::read::<|layout|::Accessor<u64>, u64>(@other.number);
    |layout|::write::<|layout|::Accessor<u64>, u64>(@mutable view.number, 29u64);
}

machine main() crashes Trap {
    let mutable value: Value = Value { number: 17 };
    let mutable companion: Value = Value { number: 43 };
    let companion_view: @mutable ValueStorage in Value::Placed = |access|::view_mut::<Value, ValueStorage in Value::Placed>(@mutable companion);
    update(@mutable value, companion_view, true);
    update(@mutable value, companion_view, false);
    transition value.number == 29 && companion.number == 43 {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
