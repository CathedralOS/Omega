use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_selected_native_code_layout_target_body" };
    Build::select_provider::<|app|::SelectedLayoutCheck, |app|::CheckedLayoutProbe>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedLayoutCheck, |app|::CheckedLayoutProbe>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedLayoutCheck, |app|::CheckedLayoutProbe>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedLayoutCheck, |app|::CheckedLayoutProbe>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
}
