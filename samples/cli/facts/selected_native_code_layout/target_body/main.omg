// The exact selected executable application supplies a nonzero native entry and finite attributed code regions at runtime.
// Expected exit: 0
use omega::language::core::CodeLayout;
machine selected<T, const Salt: u64>(value: T) -> T { value }
machine inspect(layout: &CodeLayout) -> bool
terminates
{
    transition layout.regions.len > 0 { true -> region(layout) _ -> false }
    machine region(layout: &CodeLayout) -> bool
    requires layout.regions.len > 0
    {
        layout.entry != 0 && layout.regions[0].base == layout.entry && layout.regions[0].length > 0
    }
}
machine query_layout() -> bool terminates {
    let layout: CodeLayout = code_layout<selected<u64, 7>>();
    inspect(&layout)
}
boundary trait SelectedLayoutCheck {
    machine target_witness() -> bool reaches terminates;
}
CheckedLayoutProbe satisfies SelectedLayoutCheck {
    machine target_witness() -> bool terminates {
        query_layout()
    }
}
machine witness() -> bool terminates { SelectedLayoutCheck::target_witness() }
machine main() crashes Trap {
    transition witness() { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
