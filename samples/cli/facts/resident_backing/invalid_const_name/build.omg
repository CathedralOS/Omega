use main.omg as app;
use {omega}/language/core/external_binding.omg as binding;
use {omega}/language/core/extent.omg as extent;
use {omega}/language/core/process_exit.omg as process;
use {omega}/language/core/layout.omg as layout;
machine build(builder: @mutable Build) {
    Build::application(builder, "resident_backing");
    Build::accept_boundary::<|app|::MemorySupply>(builder);
    Build::accept_boundary::<|layout|::NativeAccess<|app|::WordPlacement, |app|::Word, |app|::WordStorage, |app|::TestMemory>>(builder);
    Build::accept_boundary::<|app|::TestRoots>(builder);
    Build::accept_boundary::<|app|::TestVacant>(builder);
    Build::select_provider::<|extent|::ExtentRootProvider, |app|::TestRoots>(builder, windows_x86_64);
    Build::select_provider::<|extent|::VacantContentTransfer, |app|::TestVacant>(builder, windows_x86_64);
    Build::select_provider::<|layout|::ResourceProfileSupply<|app|::TestMemory>, |app|::MemorySupply>(builder, windows_x86_64);
    Build::select_provider::<|layout|::AccessLifecycle<|app|::WordPlacement, |app|::Word>, |layout|::NativeAccess<|app|::WordPlacement, |app|::Word, |app|::WordStorage, |app|::TestMemory>>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64\ProgramEntry, |app|::main);
    Build::select_provider::<|extent|::ExtentRootProvider, |app|::TestRoots>(builder, linux_x86_64);
    Build::select_provider::<|extent|::VacantContentTransfer, |app|::TestVacant>(builder, linux_x86_64);
    Build::select_provider::<|layout|::ResourceProfileSupply<|app|::TestMemory>, |app|::MemorySupply>(builder, linux_x86_64);
    Build::select_provider::<|layout|::AccessLifecycle<|app|::WordPlacement, |app|::Word>, |layout|::NativeAccess<|app|::WordPlacement, |app|::Word, |app|::WordStorage, |app|::TestMemory>>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64\ProgramEntry, |app|::main);
    Build::select_provider::<|extent|::ExtentRootProvider, |app|::TestRoots>(builder, macos_arm64);
    Build::select_provider::<|extent|::VacantContentTransfer, |app|::TestVacant>(builder, macos_arm64);
    Build::select_provider::<|layout|::ResourceProfileSupply<|app|::TestMemory>, |app|::MemorySupply>(builder, macos_arm64);
    Build::select_provider::<|layout|::AccessLifecycle<|app|::WordPlacement, |app|::Word>, |layout|::NativeAccess<|app|::WordPlacement, |app|::Word, |app|::WordStorage, |app|::TestMemory>>(builder, macos_arm64);
    Build::bind(builder, macos_arm64\ProgramEntry, |app|::main);
    Build::select_provider::<|extent|::ExtentRootProvider, |app|::TestRoots>(builder, linux_arm64);
    Build::select_provider::<|extent|::VacantContentTransfer, |app|::TestVacant>(builder, linux_arm64);
    Build::select_provider::<|layout|::ResourceProfileSupply<|app|::TestMemory>, |app|::MemorySupply>(builder, linux_arm64);
    Build::select_provider::<|layout|::AccessLifecycle<|app|::WordPlacement, |app|::Word>, |layout|::NativeAccess<|app|::WordPlacement, |app|::Word, |app|::WordStorage, |app|::TestMemory>>(builder, linux_arm64);
    Build::bind(builder, linux_arm64\ProgramEntry, |app|::main);
    Build::bind_native::<|app|::NativeAllocation::allocate>(builder, windows_x86_64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::PeByName { library: "msvcrt.dll", export: "calloc" } });
    Build::bind_native::<|process|::ProcessExit::exit_process>(builder, windows_x86_64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::PeByName { library: "kernel32.dll", export: "ExitProcess" } });
    Build::bind_native::<|app|::NativeAllocation::allocate>(builder, linux_x86_64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.2.5" } });
    Build::bind_native::<|process|::ProcessExit::exit_process>(builder, linux_x86_64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "exit", version: "GLIBC_2.2.5" } });
    Build::bind_native::<|app|::NativeAllocation::allocate>(builder, linux_arm64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.17" } });
    Build::bind_native::<|process|::ProcessExit::exit_process>(builder, linux_arm64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "exit", version: "GLIBC_2.17" } });
    Build::bind_native::<|app|::NativeAllocation::allocate>(builder, macos_arm64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_calloc" } });
    Build::bind_native::<|process|::ProcessExit::exit_process>(builder, macos_arm64, |binding|::ForeignBinding::DllImport { import: |binding|::DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_exit" } });
}
