// Expected exit: 0
// A granted vacant extent retains actual backing through transport, initialization, permitted writes, and extraction.

use {omega}/language/core/extent.omg as extent;
use {omega}/language/core/content.omg as content;
use {omega}/language/core/nat.omg as nat;
use {omega}/language/core/process_exit.omg as process;
use {omega}/language/core/layout.omg as layout;
use {omega}/language/core/access/access.omg as access;
use {omega}/language/core/reflect/reflect.omg as reflect;

data TestMemory {}
public data Word { prefix: u64; value: u64; suffix: u64; }
public data WordStorage = |layout|::LayoutStorage<Word, WordLayout>;
public domain Word::Placed access WordAccess;
public data WordPlacement = Word in Word::Placed;

public WordLayout satisfies |layout|::FixedLayout<Word> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan
    reaches none crashes none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 8 } };
        entries[2] = |layout|::FieldEntry { key: schema.fields[2].key, representation: |layout|::FieldPlan::At { offset: 16 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 3, size_fixed: 24, size_is_dynamic: false, align: 8 }
    }
}

public WordAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan
    reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflect|::field(Word::prefix),
            |layout|::FieldAccess::Stable { read: true, take: false, write: true, swap: false, exposure: |layout|::Exposure::Exported });
        |access|::observe(@mutable plan, |reflect|::field(Word::value),
            |layout|::FieldAccess::Stable { read: true, take: false, write: true, swap: false, exposure: |layout|::Exposure::Exported });
        |access|::observe(@mutable plan, |reflect|::field(Word::suffix),
            |layout|::FieldAccess::Stable { read: true, take: false, write: true, swap: false, exposure: |layout|::Exposure::Exported });
        plan
    }
}

MemorySupply satisfies |layout|::ResourceProfileSupply<TestMemory> {
    machine profile(storage: @|extent|::Extent in |extent|::Extent::Granted) -> |layout|::ResourceProfile {
        let services: [u64; 32];
        let mutable regions: [|layout|::ResourceRegion; 32];
        regions[0] = |layout|::ResourceRegion {
            range: |layout|::RelativeRange { offset: 0, length: storage.length },
            peer: |layout|::PeerWritability::Exclusive,
            stable: |layout|::StableCapability::ReadWrite,
            external: |layout|::ExternalCapability::None,
            atomic: |layout|::AtomicCapability::None,
            reach: |layout|::BoundaryReach { services: services, service_count: 0 },
        };
        |layout|::ResourceProfile { regions: regions, region_count: 1 }
    }
}

boundary trait NativeAllocation {
    machine allocate(count: u64, width: u64) -> addr reaches none crashes none;
}
TestRoots satisfies |extent|::ExtentRootProvider {
    machine grant(root: |extent|::Extent) -> |extent|::Extent { root }
}
TestVacant satisfies |extent|::VacantContentTransfer {
    machine transfer(storage: |extent|::Extent in |extent|::Extent::Granted) -> |extent|::Extent
        ensures result in |extent|::Extent::Granted,
            core\Identity::<|content|::IntervalSet<|nat|::Nat>>(
                |extent|::Granted::content(old(@storage)),
                |extent|::Granted::content(@result)
            )
    { storage as - |extent|::Extent::Granted }
}

// Place: other_state.
const CAPACITY: u64 = 64;
machine main() crashes Trap {
    let address: addr = NativeAllocation::allocate(1, CAPACITY);
    transition address != 0 { true -> allocated(address), false -> bad() }
    machine allocated(address: addr) {
        let granted: |extent|::Extent in |extent|::Extent::Granted =
            |extent|::ExtentRootProvider::grant(|extent|::Extent { base: address, length: CAPACITY })
                as + |extent|::Extent::Granted;
        let vacant: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant =
            |extent|::VacantContentTransfer::transfer(granted)
                as + |extent|::Extent::Granted + |extent|::Extent::Vacant;
        transition vacant.length == CAPACITY { true -> partition(vacant), false -> bad() }
    }
    machine partition(vacant: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant) requires vacant.length == CAPACITY {
        let parts: |extent|::VacantExtentParts = |extent|::split_vacant_extent(vacant, 32);
        let first: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant = transport(parts.taken, true);
        let second: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant = transport(parts.rest, false);
        transition first.length == 32 && second.length == 32 {
            true -> done(first, second),
            false -> bad()
        }
    }
    machine done(first: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant, second: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant) { |process|::ProcessExit::exit_process(0); }
    machine bad() { crash Trap; }
}

machine transport(storage: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant, choose: bool) -> |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant crashes Trap {
    transition { _ -> carry(storage) }
    machine carry(storage: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant) -> |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant { exercise(storage) }
}

machine exercise(vacant: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant) -> |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant crashes Trap {
    transition |access|::initialize_owned::<WordPlacement, Word>(vacant, Word { prefix: 101, value: 17, suffix: 103 }) {
        |layout|::AccessOutcome::Ready { view } -> extract(view),
        |layout|::AccessOutcome::Rejected { returned, reason } -> bad()
    }

    machine extract(storage: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Resident<WordPlacement, Word>) -> |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant {
        let mutable retained: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Resident<WordPlacement, Word> = storage;
        let view: @mutable WordStorage in Word::Placed = |access|::view_resident_mut::<WordPlacement, Word, WordStorage in Word::Placed>(@mutable retained);
        let before: u64 = view.value;
        view.value = 29u64;
        let released: |layout|::AccessReturn<|extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant, Word> =
            |access|::move_out_owned::<WordPlacement, Word>(retained);
        transition { _ -> finish(released.source, released.custody, before) }
    }

    machine finish(storage: |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant, value: Word, before: u64) -> |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant {
        transition before == 17 && value.value == 29 && value.prefix == 101 && value.suffix == 103 {
            true -> storage,
            false -> bad()
        }
    }
    machine bad() -> |extent|::Extent in |extent|::Extent::Granted & |extent|::Extent::Vacant { crash Trap; }
}
