// A match on one evaluation of a copyable flag selects an exclusive loan, that loan dies at its last use, and the source is usable again after that death.
// Place: field.
// The source is used while the loan is live.

data Box { chosen: [i64; 4]; other: [i64; 4]; }

machine choose(counter: @mutable u64) -> bool
requires $counter == 0
{
    $counter = 1;
    true
}

machine main() crashes Trap {
    let mutable box: Box = Box { chosen: [17, 0, 5, 6], other: [0, 0, 8, 9] };
    let mutable visits: u64 = 0;
    let selected: @mutable [i64] = match choose(@mutable visits) {
        true -> @mutable box.chosen[0..2],
        false -> @mutable box.other[2..4]
    };
    box = Box { chosen: [7, 0, 7, 0], other: [0, 0, 8, 9] };
    selected[0] = 41;
    let written: i64 = selected[0];
    transition written == 41 && box.chosen[0] == 7 && visits == 1 {
        true -> done(),
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
