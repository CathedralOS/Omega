// A match on one evaluation of a copyable flag selects an exclusive loan, that loan dies at its last use, and the source is usable again after that death.
// Place: field.
// Expected exit: 0

data Box { chosen: [i64; 4]; other: [i64; 4]; }

machine choose(counter: &mut u64) -> bool
requires counter == 0
{
    counter = 1;
    true
}

machine main() crashes Trap {
    let mut box: Box = Box { chosen: [17, 0, 5, 6], other: [0, 0, 8, 9] };
    let mut visits: u64 = 0;
    let selected: &mut [i64] = match choose(&mut visits) {
        true -> &mut box.chosen[0..2]
        false -> &mut box.other[2..4]
    };
    selected[0] = 41;
    let written: i64 = selected[0];
    box = Box { chosen: [7, 0, 7, 0], other: [0, 0, 8, 9] };
    transition written == 41 && box.chosen[0] == 7 && visits == 1 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
