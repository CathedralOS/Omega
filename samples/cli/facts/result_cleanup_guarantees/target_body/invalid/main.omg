// Breaking the carried readiness fact must reject normal cleanup.
data Seed [copy] { ready: bool; }
data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token)
requires token.ready { token.ready = false; }
machine make_token(seed: &Seed) -> Token
ensures result.ready == seed.ready { Token { ready: seed.ready, value: 7 } }
machine read(token: &Token) -> u64 { token.value }
windows_x86_64 machine across() -> u64 { let seed: Seed = Seed { ready: false }; read(&make_token(&seed)) }
linux_x86_64 machine across() -> u64 { let seed: Seed = Seed { ready: false }; read(&make_token(&seed)) }
linux_arm64 machine across() -> u64 { let seed: Seed = Seed { ready: false }; read(&make_token(&seed)) }
macos_arm64 machine across() -> u64 { let seed: Seed = Seed { ready: false }; read(&make_token(&seed)) }
machine main() crashes Trap {
    let answer: u64 = across();
    transition answer == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
