// Breaking the carried readiness fact must reject normal cleanup.
data Seed [copy] { ready: bool; }
data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token)
requires token.ready { token.ready = false; }
machine make_token(seed: &Seed) -> Token
ensures result.ready == seed.ready { Token { ready: seed.ready, value: 7 } }
machine read(token: &Token) -> u64 { token.value }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedAcross {
    machine across() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Across satisfies SelectedAcross {
    machine across() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     let seed: Seed = Seed { ready: false }; read(&make_token(&seed)) 
    }
}

ArmAcross satisfies SelectedAcross {
    machine across() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     let seed: Seed = Seed { ready: false }; read(&make_token(&seed)) 
    }
}


machine main() crashes Trap {
    let answer: u64 = SelectedAcross::across();
    transition answer == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
