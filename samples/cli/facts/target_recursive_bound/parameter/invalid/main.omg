// An acknowledged target-scoped tail-recursive countdown carries its result bound of at most 60 into exact subtraction 60 - result.
// Invalid: only the supplied bound changes from 60 to 61.
public machine tick() -> bool blocks; terminates; { true }

boundary trait SelectedCountdown {
    machine countdown(remaining: u64, value: u64) -> u64 reaches
requires remaining <= 4 && value <= 60;
ensures result <= 60;
terminates;
}
CheckedCountdown satisfies SelectedCountdown {
    machine countdown(remaining: u64, value: u64) -> u64
requires remaining <= 4 && value <= 60;
ensures result <= 60;
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining, value) false -> (value) }
    machine step(remaining: u64, value: u64) -> u64
    requires remaining > 0 && remaining <= 4 && value <= 60 {
        let ready: bool = block tick();
        transition ready {
            true -> block CheckedCountdown::countdown(remaining - 1, value)
            false -> (value)
        }
    }
}
}







machine subtract(value: u64) -> u64 requires value <= 60 { 60u64 - value }
machine main() crashes Trap {
    let difference: u64 = subtract(block SelectedCountdown::countdown(4, 61));
    transition difference == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
