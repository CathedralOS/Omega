// An acknowledged selected tail-recursive countdown carries its result bound of at most 60 into exact subtraction 60 - result.
// Expected exit: 0
public machine tick() -> bool blocks terminates { true }

boundary trait Countdown {
    machine countdown(remaining: u64, value: u64) -> u64
    reaches
    blocks
    terminates
    requires remaining <= 4 && value <= 60
    ensures result <= 60;
}

CountdownCode satisfies Countdown {
    machine countdown(remaining: u64, value: u64) -> u64
    requires remaining <= 4 && value <= 60
    ensures result <= 60
    terminates by remaining
    {
        transition remaining > 0 { true -> block step(remaining, value) false -> (value) }
        machine step(remaining: u64, value: u64) -> u64
        requires remaining > 0 && remaining <= 4 && value <= 60 {
            let ready: bool = block tick();
            transition ready {
                true -> block CountdownCode::countdown(remaining - 1, value)
                false -> (value)
            }
        }
    }
}

machine record_result(observed: &mut u64, marker: u64) -> u64
ensures result <= 60
{
    observed = marker;
    block Countdown::countdown(4, 60)
}
machine choose(flag: bool, observed: &mut u64) -> u64 ensures result <= 60 {
    match flag {
        true -> block record_result(observed, 17),
        false -> block record_result(observed, 23),
    }
}
machine main() crashes Trap {
    let mut first_route: u64 = 0;
    let mut second_route: u64 = 0;
    let first: u64 = 60u64 - block choose(true, &mut first_route);
    let second: u64 = 60u64 - block choose(false, &mut second_route);
    let difference: u64 = first + second;
    transition difference == 0 && first_route == 17 && second_route == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
