machine choose(flag: bool) -> u64 ensures result <= 60 {
    match flag { true -> block countdown(4, 60), false -> block countdown(4, 60), }
}
machine main() crashes Trap {
    let first: u64 = 60u64 - block choose(true);
    let second: u64 = 60u64 - block choose(false);
    let difference: u64 = first + second;
    transition difference == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
