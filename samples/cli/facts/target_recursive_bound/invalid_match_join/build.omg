use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    Build::select_provider::<|app|::Countdown, |app|::CountdownCode>(builder, windows_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::CountdownCode>(builder, linux_x86_64);
    Build::select_provider::<|app|::Countdown, |app|::CountdownCode>(builder, macos_arm64);
    Build::select_provider::<|app|::Countdown, |app|::CountdownCode>(builder, linux_arm64);
    builder.product = BuildProduct::Application { name: "target_recursive_bound_match_join" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
