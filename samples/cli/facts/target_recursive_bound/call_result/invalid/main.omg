// An acknowledged target-scoped tail-recursive countdown carries its result bound of at most 60 into exact subtraction 60 - result.
// Invalid: only the supplied bound changes from 60 to 61.
public machine tick() -> bool blocks; terminates; { true }

windows_x86_64 machine countdown(remaining: u64, value: u64) -> u64
requires remaining <= 4 && value <= 60;
ensures result <= 60;
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining, value) false -> (value) }
    machine step(remaining: u64, value: u64) -> u64
    requires remaining > 0 && remaining <= 4 && value <= 60 {
        let ready: bool = block tick();
        transition ready {
            true -> block countdown(remaining - 1, value)
            false -> (value)
        }
    }
}

