machine deliver() -> u64 ensures result <= 60 { block countdown(4, 61) }
machine main() crashes Trap {
    let difference: u64 = 60u64 - block deliver();
    transition difference == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
