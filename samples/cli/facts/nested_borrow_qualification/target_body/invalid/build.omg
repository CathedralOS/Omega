machine build(builder: &mut Build) {
    Build::select_provider<SelectedTargetConsume, CheckedTargetConsume>(builder, windows_x86_64);
    Build::select_provider<SelectedTargetConsume, CheckedTargetConsume>(builder, linux_x86_64);
    Build::select_provider<SelectedTargetConsume, CheckedTargetConsume>(builder, macos_arm64);
    Build::select_provider<SelectedTargetConsume, CheckedTargetConsume>(builder, linux_arm64);

    Build::application(builder, "nested_borrow_qualification_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
}
