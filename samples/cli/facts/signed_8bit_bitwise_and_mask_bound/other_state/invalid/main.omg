// Fact: 8-bit signed bitwise AND mask raw & 63i8 with bounded interval 40i8 <= masked <= 63i8 establishes 40i8 <= masked <= 63i8 across all nine places so exact subtractions 63i8 - masked and masked - 40i8 are safe.
// Place: another state. A successor state receives the bounded 32-bit operand and mask before bitwise AND mask and subtraction.
// Invalid: mask widened to 127i8, allowing masked value to exceed 63i8 and causing headroom 63i8 - masked to be negative.
// Expected exit: 0

machine mask_state(raw: i8, mask: i8) -> i32
requires raw >= 116i8 && raw <= 116i8 && mask == 127i8
{
    transition {
        _ -> step(raw, mask)
    }
    machine step(r: i8, m: i8) -> i32
    requires r >= 116i8 && r <= 116i8 && m == 127i8
    {
        let masked: i8 = r & m;
        let headroom: i8 = 63i8 - masked;
        let margin: i8 = masked - 40i8;
        let check_h: u8 = headroom as u8;
        let check_m: u8 = margin as u8;
        transition masked == 52i8 && headroom + margin == 23i8 && check_h + check_m == 23u8 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine probe() -> i32 {
    mask_state(116i8, 127i8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
