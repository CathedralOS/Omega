// A computed nested leaf loan captures each selector once before the later argument and preserves caller storage through a state transfer.
// Expected exit: 0
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
data Cursor { calls: u32 in Wrapping; }
machine choose_row(cursor: @mutable Cursor) -> u64
ensures result == 2 { cursor.calls = cursor.calls + 1; 2 }
machine choose_column(cursor: @mutable Cursor) -> u64
ensures result == 1 { cursor.calls = cursor.calls + 1; 1 }
machine replacement(cursor: @mutable Cursor) -> i32 in Wrapping {
    cursor.calls = cursor.calls + 1;
    42
}
machine store(value: @mutable i32 in Wrapping, incoming: i32 in Wrapping) { $value = incoming; }
machine visit(rows: @mutable [Row; 3], cursor: @mutable Cursor) {
    transition { _ -> apply(@mutable rows[choose_row(cursor)].data[choose_column(cursor)], replacement(cursor)) }
    machine apply(value: @mutable i32 in Wrapping, incoming: i32 in Wrapping) { store(value, incoming); }
}
machine main() crashes Trap {
    let mutable rows: [Row; 3];
    let mutable cursor: Cursor;
    rows[2].tag = 7;
    visit(@mutable rows, @mutable cursor);
    transition rows[2].data[1] == 42 && rows[2].data[0] == 0 && rows[2].tag == 7 && cursor.calls == 3 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
