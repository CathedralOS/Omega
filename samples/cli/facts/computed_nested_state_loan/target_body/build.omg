machine build(builder: &mut Build) {
    Build::select_provider<SelectedVisit, CheckedVisit>(builder, linux_x86_64);
    Build::select_provider<SelectedVisit, CheckedVisit>(builder, linux_arm64);
    Build::select_provider<SelectedVisit, CheckedVisit>(builder, macos_arm64);
    Build::select_provider<SelectedVisit, CheckedVisit>(builder, windows_x86_64);

    Build::application(builder, "computed_nested_state_loan");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
