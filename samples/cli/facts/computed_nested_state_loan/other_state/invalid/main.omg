// A computed nested leaf loan captures each selector once before the later argument and preserves caller storage through a state transfer.
// Place: other_state
// Expected exit: 0
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
data Cursor { calls: u32 in Wrapping; trace: u32 in Wrapping; }
data Selection where row == 2 && column == 1 { row: u64; column: u64; }
machine choose_row(cursor: &mut Cursor, row: u64) -> u64
requires row == 2
ensures result == 2 {
    cursor.calls = cursor.calls + 1;
    cursor.trace = cursor.trace * 10 + 1;
    row
}
machine choose_column(cursor: &mut Cursor, column: u64) -> u64
requires column == 1
ensures result == 1 {
    cursor.calls = cursor.calls + 1;
    cursor.trace = cursor.trace * 10 + 2;
    column
}
machine replacement(cursor: &mut Cursor) -> i32 in Wrapping {
    cursor.calls = cursor.calls + 1;
    cursor.trace = cursor.trace * 10 + 3;
    42
}
machine store(value: &mut i32 in Wrapping, incoming: i32 in Wrapping) { value = incoming; }
machine visit(rows: &mut [Row; 3], cursor: &mut Cursor, row: u64, column: u64)
requires row == 2, column == 1 {
    transition { _ -> selected(rows, cursor, row, column) }
    machine selected(rows: &mut [Row; 3], cursor: &mut Cursor, row: u64, column: u64)
    requires row == 2, column == 1 {
    transition { _ -> apply(&rows[choose_row(cursor, row)].data[choose_column(cursor, column)], replacement(cursor)) }
    }
    machine apply(value: &mut i32 in Wrapping, incoming: i32 in Wrapping) { store(value, incoming); }
}
machine main() crashes Trap {
    let mut rows: [Row; 3];
    let mut cursor: Cursor;
    rows[2].tag = 7;
    rows[1].data[1] = 5;
    visit(&mut rows, &mut cursor, 2, 1);
    transition rows[2].data[1] == 42 && rows[2].data[0] == 0
        && rows[0].data[0] == 0 && rows[1].data[1] == 5
        && rows[2].tag == 7 && cursor.calls == 3 && cursor.trace == 123 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
