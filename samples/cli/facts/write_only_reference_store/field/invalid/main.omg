// Fact: a `&write` store into a record's reference leaf installs the incoming
// descriptor — the stored target reads the new referent's 85 while the
// displaced referent's 11 and the sibling stamp's 17 stay untouched.
// Invalid: reading the write-only slot's stored descriptor to supply its own
// replacement.
data Cell { value: i64; }
data Held { target: &Cell; stamp: i64; }
data Carrier { slot: &write Held; }

machine main() crashes Trap {
    let left: Cell = Cell { value: 11 };
    let right: Cell = Cell { value: 85 };
    let mut held: Held = Held { target: &left, stamp: 17 };
    let carrier: Carrier = Carrier { slot: &write held };
    carrier.slot.target = carrier.slot.target;
    transition held.target.value == 85 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
