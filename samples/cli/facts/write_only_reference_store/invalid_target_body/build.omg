machine build(builder: &mut Build) {
    Build::application(builder, "write_only_reference_store_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::accept_boundary<SelectedStore>(builder);
    Build::select_provider<SelectedStore, WindowsStore>(builder, windows_x86_64);
    Build::select_provider<SelectedStore, LinuxX86Store>(builder, linux_x86_64);
    Build::select_provider<SelectedStore, MacosStore>(builder, macos_arm64);
    Build::select_provider<SelectedStore, LinuxArmStore>(builder, linux_arm64);
}
