use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "write_only_reference_store_target_body" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::accept_boundary::<|app|::SelectedStore>(builder);
    Build::select_provider::<|app|::SelectedStore, |app|::WindowsStore>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedStore, |app|::LinuxX86Store>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedStore, |app|::MacosStore>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedStore, |app|::LinuxArmStore>(builder, linux_arm64);
}
