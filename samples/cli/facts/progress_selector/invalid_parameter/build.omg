machine build(builder: &mut Build) {
    Build::application(builder, "progress_selector_through_parameter");
    Build::accept_boundary<Grants>(builder);
    Build::select_provider<Grants, Provider>(builder, linux_arm64);
    Build::select_provider<Grants, Provider>(builder, linux_x86_64);
    Build::select_provider<Grants, Provider>(builder, macos_arm64);
    Build::select_provider<Grants, Provider>(builder, macos_x86_64);
    Build::select_provider<Grants, Provider>(builder, windows_x86_64);
    Build::select_provider<Grants, Provider>(builder, uefi_x86_64);
    Build::select_provider<Grants, Provider>(builder, cross_platform_cli);
    Build::select_provider<Grants, Provider>(builder, local_unchecked);
    Build::select_provider<Grants, Provider>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
