use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "progress_selector_through_parameter" };
    Build::accept_boundary::<|app|::Grants>(builder);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, linux_arm64);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, macos_arm64);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, macos_x86_64);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, local_unchecked);
    Build::select_provider::<|app|::Grants, |app|::Provider>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
