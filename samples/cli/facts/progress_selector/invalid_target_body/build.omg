machine build(builder: &mut Build) {
    Build::application(builder, "progress_selector_through_target_body");
    Build::accept_boundary<Grants>(builder);
    Build::accept_boundary<SelectedProgress>(builder);
    Build::select_provider<Grants, Provider>(builder, linux_arm64);
    Build::select_provider<Grants, Provider>(builder, linux_x86_64);
    Build::select_provider<Grants, Provider>(builder, macos_arm64);
    Build::select_provider<Grants, Provider>(builder, macos_x86_64);
    Build::select_provider<Grants, Provider>(builder, windows_x86_64);
    Build::select_provider<Grants, Provider>(builder, uefi_x86_64);
    Build::select_provider<Grants, Provider>(builder, cross_platform_cli);
    Build::select_provider<Grants, Provider>(builder, local_unchecked);
    Build::select_provider<Grants, Provider>(builder, alpha_bootstrap);
    Build::select_provider<SelectedProgress, LinuxX86Selector>(builder, linux_x86_64);
    Build::select_provider<SelectedProgress, LinuxArmSelector>(builder, linux_arm64);
    Build::select_provider<SelectedProgress, MacosSelector>(builder, macos_arm64);
    Build::select_provider<SelectedProgress, WindowsSelector>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
