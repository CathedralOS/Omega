// Fact: 8-bit signed saturating subtraction lhs -| rhs with bounded interval 40i8 <= diff <= 90i8 establishes 40i8 <= diff <= 90i8 across all nine places so exact subtractions 90i8 - diff and diff - 40i8 are safe.
// Invalid: widened lhs produces diff of 95i8 across target body, failing exercise requires contract.

machine compute_sat(lhs: i8 in Saturating, rhs: i8 in Saturating) -> i8 in Saturating {
    lhs - rhs
}

machine verify_diff(diff: i8) -> i32
    requires diff >= 40 && diff <= 90
{
    let headroom: i8 = 90 - diff;
    let margin: i8 = diff - 40;
    let total: i8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 90;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 90
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_diff(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 90
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_diff(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: i8 in Saturating = 105;
    let rhs: i8 in Saturating = 10;
    let diff_sat: i8 in Saturating = compute_sat(lhs, rhs);
    let diff: i8 = diff_sat as i8;
    let check: i32 = SelectedProbe::exercise(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
