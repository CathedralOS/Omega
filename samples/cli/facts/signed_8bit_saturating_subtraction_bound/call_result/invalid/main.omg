// Fact: 8-bit signed saturating subtraction lhs -| rhs with bounded interval 40i8 <= diff <= 90i8 establishes 40i8 <= diff <= 90i8 across all nine places so exact subtractions 90i8 - diff and diff - 40i8 are safe.
// Invalid: widened inputs produce diff of 95i8, failing produce_diff ensures contract.

machine verify_diff(diff: i8) -> i32
    requires diff >= 40 && diff <= 90
{
    let headroom: i8 = 90 - diff;
    let margin: i8 = diff - 40;
    let total: i8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

machine produce_diff(lhs: i8 in Saturating, rhs: i8 in Saturating) -> i8
    requires lhs as i8 >= 60 && lhs as i8 <= 105, rhs as i8 >= 10 && rhs as i8 <= 20
    ensures result >= 40 && result <= 90
{
    let sat: i8 in Saturating = lhs - rhs;
    sat as i8
}

machine main() crashes Trap {
    let lhs: i8 in Saturating = 105;
    let rhs: i8 in Saturating = 10;
    let diff: i8 = produce_diff(lhs, rhs);
    let check: i32 = verify_diff(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
