// Fact: 32-bit signed exact subtraction lhs - rhs with 80i32 <= lhs <= 120i32 and 20i32 <= rhs <= 40i32 establishes 40i32 <= diff <= 100i32 so 100i32 - diff and diff - 40i32 are safe.
// Place: other_machine. A forwarding machine transports the difference result through an intermediate machine call.
// Expected exit: 0
machine verify_diff(diff: i32) -> i32
    requires diff >= 40 && diff <= 100
{
    let head: i32 = 100 - diff;
    let tail: i32 = diff - 40;
    let sum: i32 = head + tail;
    sum - 60
}

machine target_machine(val: i32) -> i32
    ensures result == val
{
    val
}

machine forwarder(val: i32) -> i32
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(lhs: i32, rhs: i32) -> i32
    requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40
{
    let diff: i32 = lhs - rhs;
    let transported: i32 = forwarder(diff);
    verify_diff(transported)
}

machine evaluate() -> i32 {
    compute_other_machine(100, 30)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
