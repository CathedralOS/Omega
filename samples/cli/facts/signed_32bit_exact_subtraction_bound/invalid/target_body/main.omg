// Fact: 32-bit signed exact subtraction lhs - rhs with 80i32 <= lhs <= 120i32 and 20i32 <= rhs <= 40i32 establishes 40i32 <= diff <= 100i32 so 100i32 - diff and diff - 40i32 are safe.
// Place: target_body. Each hosted target body computes the 32-bit signed exact subtraction and verifies the bounds.
// Expected exit: 0
machine verify_diff(diff: i32) -> i32
    requires diff >= 40 && diff <= 100
{
    let head: i32 = 100 - diff;
    let tail: i32 = diff - 40;
    let sum: i32 = head + tail;
    sum - 60
}

linux_x86_64 machine compute_target_body(lhs: i32, rhs: i32) -> i32
    requires lhs >= 80 && lhs <= 125 && rhs >= 20 && rhs <= 40
{
    let diff: i32 = lhs - rhs;
    verify_diff(diff)
}

linux_arm64 machine compute_target_body(lhs: i32, rhs: i32) -> i32
    requires lhs >= 80 && lhs <= 125 && rhs >= 20 && rhs <= 40
{
    let diff: i32 = lhs - rhs;
    verify_diff(diff)
}

macos_arm64 machine compute_target_body(lhs: i32, rhs: i32) -> i32
    requires lhs >= 80 && lhs <= 125 && rhs >= 20 && rhs <= 40
{
    let diff: i32 = lhs - rhs;
    verify_diff(diff)
}

windows_x86_64 machine compute_target_body(lhs: i32, rhs: i32) -> i32
    requires lhs >= 80 && lhs <= 125 && rhs >= 20 && rhs <= 40
{
    let diff: i32 = lhs - rhs;
    verify_diff(diff)
}

machine evaluate() -> i32 {
    compute_target_body(100, 30)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
