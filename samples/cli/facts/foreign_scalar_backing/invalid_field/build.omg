use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "foreign_scalar_backing_field" };
    Build::bind(builder, windows_x86_64::ProgramEntry, windows_main);
    Build::bind(builder, linux_x86_64::ProgramEntry, posix_main);
    Build::bind(builder, linux_arm64::ProgramEntry, posix_main);
    Build::bind(builder, macos_arm64::ProgramEntry, posix_main);
    Build::bind_native::<Words::write>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
        }
    });
    Build::bind_native::<Words::write>(builder, linux_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
        }
    });
    Build::bind_native::<Words::write>(builder, linux_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "write", version: "GLIBC_2.17"
        }
    });
    // Binary stdout preserves the exact authored bytes on Windows.
    Build::bind_native::<WindowsDescriptorMode::set_mode>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_setmode"
        } });
    Build::bind_native::<WindowsWords::write>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_write"
        } });
}
