use omega\language\core\DllImport;
use omega\language\core\ForeignBinding;
machine build(builder: @mutable Build) {
    Build::application(builder, "foreign_scalar_backing_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind_native::<Words::write>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
        }
    });
    Build::bind_native::<Words::write>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
        }
    });
    Build::bind_native::<Words::write>(builder, linux_arm64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "write", version: "GLIBC_2.17"
        }
    });
    // Binary stdout preserves the exact authored bytes on Windows.
    Build::bind_native::<WindowsDescriptorMode::set_mode>(builder, windows_x86_64,
        ForeignBinding::DllImport { import: DllImport::PeByName {
            library: "msvcrt.dll", export: "_setmode"
        } });
    Build::bind_native::<WindowsWords::write>(builder, windows_x86_64,
        ForeignBinding::DllImport { import: DllImport::PeByName {
            library: "msvcrt.dll", export: "_write"
        } });
    Build::select_provider::<ScalarBackingTarget, WindowsScalarBacking>(builder, windows_x86_64);
    Build::select_provider::<ScalarBackingTarget, PosixScalarBacking>(builder, linux_x86_64);
    Build::select_provider::<ScalarBackingTarget, PosixScalarBacking>(builder, linux_arm64);
    Build::select_provider::<ScalarBackingTarget, PosixScalarBacking>(builder, macos_arm64);
}
