// Fact: 32-bit signed saturating multiplication lhs *| rhs with bounded interval 50i32 <= prod <= 200i32 establishes 50i32 <= prod <= 200i32 across all nine places so exact subtractions 200i32 - prod and prod - 50i32 are safe.
// Place: call result. The product is received from a helper call returning the saturating multiplication result.
// Invalid control: lhs upper bound widened to 21i32, allowing prod up to 210i32 and failing exact headroom check.
// Expected rejection: not provably representable

machine compute_sat_prod(l: i32, r: i32) -> i32
    requires l >= 10i32 && l <= 21i32;
    requires r >= 5i32 && r <= 10i32;
    ensures result >= 50i32 && result <= 210i32;
{
    let a: i32 in Saturating = l as i32 in Saturating;
    let b: i32 in Saturating = r as i32 in Saturating;
    let p_sat: i32 in Saturating = a * b;
    p_sat as i32
}

machine multiply_call_result(lhs: i32, rhs: i32) -> i32
    requires lhs >= 10i32 && lhs <= 21i32;
    requires rhs >= 5i32 && rhs <= 10i32;
{
    let prod: i32 = compute_sat_prod(lhs, rhs);
    let headroom: i32 = 200i32 - prod;
    let margin: i32 = prod - 50i32;
    let check_h: u32 = headroom as u32;
    let check_m: u32 = margin as u32;
    transition prod == 120i32 && headroom + margin == 150i32 && check_h + check_m == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_call_result(15i32, 8i32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
