// Fact: 32-bit signed saturating multiplication lhs *| rhs with bounded interval 50i32 <= prod <= 200i32 establishes 50i32 <= prod <= 200i32 across all nine places so exact subtractions 200i32 - prod and prod - 50i32 are safe.
// Place: local. The product is stored within an intermediate local variable before arithmetic interval checks.
// Expected exit: 0

machine multiply_local(lhs: i32, rhs: i32) -> i32
    requires lhs >= 10i32 && lhs <= 20i32;
    requires rhs >= 5i32 && rhs <= 10i32;
{
    let a: i32 in Saturating = lhs as i32 in Saturating;
    let b: i32 in Saturating = rhs as i32 in Saturating;
    let p_sat: i32 in Saturating = a * b;
    let prod: i32 = p_sat as i32;
    let stored_prod: i32 = prod;
    let headroom: i32 = 200i32 - stored_prod;
    let margin: i32 = stored_prod - 50i32;
    let check_h: u32 = headroom as u32;
    let check_m: u32 = margin as u32;
    transition stored_prod == 120i32 && headroom + margin == 150i32 && check_h + check_m == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_local(15i32, 8i32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
