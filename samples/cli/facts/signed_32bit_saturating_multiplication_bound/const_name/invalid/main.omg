// Fact: 32-bit signed saturating multiplication lhs *| rhs with bounded interval 50i32 <= prod <= 200i32 establishes 50i32 <= prod <= 200i32 across all nine places so exact subtractions 200i32 - prod and prod - 50i32 are safe.
// Place: const name. The bounds and product limits reference declared symbolic constants.
// Invalid control: lhs upper bound widened to 21i32, allowing prod up to 210i32 and failing exact headroom check.
// Expected rejection: not provably representable

const LHS_MIN: i32 = 10i32;
const LHS_MAX: i32 = 21i32;
const RHS_MIN: i32 = 5i32;
const RHS_MAX: i32 = 10i32;
const PROD_MIN: i32 = 50i32;
const PROD_MAX: i32 = 200i32;

machine multiply_const(lhs: i32, rhs: i32) -> i32
    requires lhs >= LHS_MIN && lhs <= LHS_MAX;
    requires rhs >= RHS_MIN && rhs <= RHS_MAX;
{
    let a: i32 in Saturating = lhs as i32 in Saturating;
    let b: i32 in Saturating = rhs as i32 in Saturating;
    let p_sat: i32 in Saturating = a * b;
    let prod: i32 = p_sat as i32;
    let headroom: i32 = PROD_MAX - prod;
    let margin: i32 = prod - PROD_MIN;
    let check_h: u32 = headroom as u32;
    let check_m: u32 = margin as u32;
    transition prod == 120i32 && headroom + margin == 150i32 && check_h + check_m == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_const(15i32, 8i32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
