// Fact: projecting a bounded field through a shared borrow preserves its exact static upper bound without moving the backing record, discharging exact subtraction 90u64 - used across all nine places.
// Place: target_body (invalid twin). Field bound is widened to used <= 91, and the projected field carries an opaque `requires seed <= 91` value, so the widened bound is all the checker knows: exact subtraction 90u64 - used may underflow.
// Expected diagnostic: exact subtraction underflow
data Window requires used <= 91, {
    used: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEvaluate {
    machine evaluate(seed: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed <= 91;
}

X86Evaluate satisfies SelectedEvaluate {
    machine evaluate(seed: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed <= 91
    {
        SelectedBodyCheck::require_tag(17u64);
        let window: Window = Window { used: seed };
        let view: &Window = &window;
        let used: u64 = view.used;
        let diff: u64 = 90u64 - used;
        diff
    }
}

ArmEvaluate satisfies SelectedEvaluate {
    machine evaluate(seed: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed <= 91
    {
        SelectedBodyCheck::require_tag(29u64);
        let window: Window = Window { used: seed };
        let view: &Window = &window;
        let used: u64 = view.used;
        let diff: u64 = 90u64 - used;
        diff
    }
}

machine main() crashes Trap {
    let diff: u64 = SelectedEvaluate::evaluate(40);
    transition diff == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
