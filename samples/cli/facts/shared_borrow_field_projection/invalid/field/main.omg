// Fact: projecting a bounded field through a shared borrow preserves its exact static upper bound without moving the backing record, discharging exact subtraction 90u64 - used across all nine places.
// Place: field (invalid twin). Field bound is widened to used <= 91, so exact subtraction 90u64 - used may underflow.
// Expected diagnostic: exact subtraction underflow
data Window where used <= 91, {
    used: u64;
}

data ViewHolder {
    view: &Window;
}

machine evaluate() -> u64 {
    let window: Window = Window { used: 40 };
    let holder: ViewHolder = ViewHolder { view: &window };
    let used: u64 = holder.view.used;
    let diff: u64 = 90u64 - used;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate();
    transition diff == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
