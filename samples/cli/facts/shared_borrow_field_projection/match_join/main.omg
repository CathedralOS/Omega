// Fact: projecting a bounded field through a shared borrow preserves its exact static upper bound without moving the backing record, discharging exact subtraction 90u64 - used across all nine places.
// Place: match_join. Both arms yield the shared borrow so the joined reference projects the bounded field safely.
// Expected exit: 0
data Window where used <= 90, {
    used: u64;
}

machine evaluate(flag: bool) -> u64 {
    let window: Window = Window { used: 40 };
    let view: &Window = match flag {
        true -> &window
        false -> &window
    };
    let used: u64 = view.used;
    let diff: u64 = 90u64 - used;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate(true);
    transition diff == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
