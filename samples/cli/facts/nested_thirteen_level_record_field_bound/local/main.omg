// Fact: a 13-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { l5: Level5 { l6: Level6 { l7: Level7 { l8: Level8 { l9: Level9 { l10: Level10 { l11: Level11 { l12: Level12 { val: u64 } } } } } } } } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: local. The 13-level nested record is copied to a local variable before leaf projection and interval discharge.
// Expected exit: 0

data Level12 [copy] {
    val: u64;
}

data Level11 [copy] {
    l12: Level12;
}

data Level10 [copy] {
    l11: Level11;
}

data Level9 [copy] {
    l10: Level10;
}

data Level8 [copy] {
    l9: Level9;
}

data Level7 [copy] {
    l8: Level8;
}

data Level6 [copy] {
    l7: Level7;
}

data Level5 [copy] {
    l6: Level6;
}

data Level4 [copy] {
    l5: Level5;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

machine check_local(root: RootRec) -> u64
requires root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.val >= 40 && root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.val <= 80
{
    let local_root: RootRec = root;
    let res: u64 = local_root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine probe() -> u64 {
    let root: RootRec = RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        l5: Level5 {
                            l6: Level6 {
                                l7: Level7 {
                                    l8: Level8 {
                                        l9: Level9 {
                                            l10: Level10 {
                                                l11: Level11 {
                                                    l12: Level12 {
                                                        val: 60u64,
                                                    },
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    };
    check_local(root)
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
