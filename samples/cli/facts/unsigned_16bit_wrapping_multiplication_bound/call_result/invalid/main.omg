// Fact: 16-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u16 <= prod <= 200u16 establishes 50u16 <= prod <= 200u16 across all nine places so exact subtractions 200u16 - prod and prod - 50u16 are safe.
// Invalid: call result upper bound 210 allows underflow in 200u16 - prod. Place: call_result.
// Expected diagnostic: may overflow `u16`

machine mul_wrapping(lhs: u16, rhs: u16) -> u16
requires lhs >= 10u16 && lhs <= 21u16 && rhs >= 5u16 && rhs <= 10u16
ensures result >= 50u16 && result <= 210u16
{
    let w_lhs: u16 in Wrapping = lhs as u16 in Wrapping;
    let w_rhs: u16 in Wrapping = rhs as u16 in Wrapping;
    let prod_wrap: u16 in Wrapping = w_lhs * w_rhs;
    prod_wrap as u16
}

machine compute_call(lhs: u16, rhs: u16) -> i32
requires lhs >= 10u16 && lhs <= 21u16 && rhs >= 5u16 && rhs <= 10u16
{
    let prod: u16 = mul_wrapping(lhs, rhs);
    let headroom: u16 = 200u16 - prod;
    let margin: u16 = prod - 50u16;
    0i32
}

machine probe() -> i32 {
    compute_call(15u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
