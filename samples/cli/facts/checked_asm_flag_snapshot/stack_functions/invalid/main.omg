// One-obligation negative control: omit only the required r15 clobber.
// One object contains ordinary, flag-snapshot and directed-FP functions.
use omega::language::core::float_operations;

machine ordinary() -> u64 {
    transition { _ -> (7u64) }
}

machine flags() crashes Trap {
    let mut snapshot: u64 = 0;
    asm where clobbers r10 {
        pushfq snapshot;
    }
    transition (snapshot & 2u64) == 2u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine directed() crashes Trap {
    let one: f64 = 1.0;
    let three: f64 = 3.0;
    let upper: f64 = F64::divide_toward_positive(one, three);
    transition upper == 0.33333333333333337034076748750521801471710205078125 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let plain: u64 = ordinary();
    flags();
    directed();
    transition plain == 7u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
