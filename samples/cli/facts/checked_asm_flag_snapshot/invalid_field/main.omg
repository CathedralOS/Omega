data Snapshot { value:u64; }
machine main() crashes Trap {
 let mutable object:Snapshot=Snapshot{value:0};
 observe(@mutable object);
 transition (object.value&64u64)==64u64 { true->done(), false->bad() }
 machine done(){} machine bad(){crash Trap;}
}
machine observe(object:@mutable Snapshot) {
 asm { entry:mov eax,1; sub eax,1; pushfq object.value; jmp observed;
 observed requires (object.value&64u64)==0u64:nop }
}
