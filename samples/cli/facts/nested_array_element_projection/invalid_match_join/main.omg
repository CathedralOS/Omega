// Fact: indexing a fixed-size array field inside a structural record (row.cells[idx]) with a bounded index (idx < 4u64) proves safe element projection and preserves the element bound (elem <= 80u64) to discharge exact subtraction 80u64 - elem across all nine places.
// Invalid: match arm yields element bounded by 81, so 80u64 - elem may overflow u64.
// Expected exit: 0

data Row [copy] {
    cells: [u64; 4];
}

machine choose_elem(row: Row, idx: u64, choose_first: bool) -> u64
requires idx < 4 && row.cells[idx] <= 81
ensures result <= 81
{
    match choose_first {
        true -> row.cells[idx]
        false -> row.cells[idx]
    }
}

machine read_and_sub(row: Row, idx: u64, choose_first: bool) -> u64
requires idx < 4 && row.cells[idx] <= 81
{
    let elem: u64 = choose_elem(row, idx, choose_first);
    let spare: u64 = 80u64 - elem;
    spare
}

machine probe(row: Row, idx: u64) -> u64
requires idx < 4 && row.cells[idx] <= 81
{
    let spare1: u64 = read_and_sub(row, idx, true);
    let spare2: u64 = read_and_sub(row, idx, false);
    transition spare1 == 30 && spare2 == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() -> u64 { 30 }
    machine bad() -> u64 { 0 }
}

machine main() crashes Trap {
    let row: Row = Row { cells: [10, 20, 50, 80] };
    transition row.cells[2] <= 80 {
        true -> run(row)
        _ -> bad()
    }
    machine run(r: Row) {
        let spare: u64 = probe(r, 2);
        transition spare == 30 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
