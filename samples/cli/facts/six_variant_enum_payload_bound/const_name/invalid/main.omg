// Fact: matching a 6-variant tagged enum payload Packet { Alpha(u64), Beta(u64), Gamma(u64), Delta(u64), Epsilon(u64), Zeta(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.

const MAX_RES: u64 = 80u64;
const MIN_RES: u64 = 40u64;

data Packet [copy] {
    case Alpha(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case Beta(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case Gamma(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case Delta(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case Epsilon(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case Zeta(v: u64) where v >= 39u64 && v <= MAX_RES;
}

machine verify_payload(value: u64) -> u64
    requires value >= MIN_RES && value <= MAX_RES
{
    let headroom: u64 = MAX_RES - value;
    let margin: u64 = value - MIN_RES;
    headroom + margin
}

machine extract(packet: Packet) -> u64 {
    transition packet {
        Packet::Alpha { v } -> v
        Packet::Beta { v } -> v
        Packet::Gamma { v } -> v
        Packet::Delta { v } -> v
        Packet::Epsilon { v } -> v
        Packet::Zeta { v } -> v
    }
}

machine probe(packet: Packet) -> u64 {
    let res: u64 = extract(packet);
    verify_payload(res)
}

machine main() crashes Trap {
    let p: Packet = Packet::Zeta { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
