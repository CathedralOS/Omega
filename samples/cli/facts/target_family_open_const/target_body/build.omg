use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "runtime_family_generic_callback_forwarding_exit" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::BoundedValue, |app|::PortableBoundedValue>(builder, windows_x86_64);
    Build::select_provider::<|app|::BoundedSubtract, |app|::PortableBoundedSubtract>(builder, windows_x86_64);
    Build::select_provider::<|app|::BoundedValue, |app|::PortableBoundedValue>(builder, linux_x86_64);
    Build::select_provider::<|app|::BoundedSubtract, |app|::PortableBoundedSubtract>(builder, linux_x86_64);
    Build::select_provider::<|app|::BoundedValue, |app|::PortableBoundedValue>(builder, linux_arm64);
    Build::select_provider::<|app|::BoundedSubtract, |app|::PortableBoundedSubtract>(builder, linux_arm64);
    Build::select_provider::<|app|::BoundedValue, |app|::PortableBoundedValue>(builder, macos_arm64);
    Build::select_provider::<|app|::BoundedSubtract, |app|::PortableBoundedSubtract>(builder, macos_arm64);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::BoundedValue, |app|::PortableBoundedValue>(builder, macos_x86_64);
    Build::select_provider::<|app|::BoundedSubtract, |app|::PortableBoundedSubtract>(builder, macos_x86_64);
}
