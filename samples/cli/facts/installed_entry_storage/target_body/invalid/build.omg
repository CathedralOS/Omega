machine build(builder: &mut Build) {
    Build::application(builder, "installed_entry_storage_target_body_invalid");
    Build::bind(builder, macos_arm64::ProgramEntry, start);
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_arm64::ProgramEntry, start);
    Build::bind(builder, windows_x86_64::ProgramEntry, start);
    Build::select_provider<TransmitCode, MacosTransmitCode>(builder, macos_arm64);
    Build::select_provider<TransmitCode, LinuxX86TransmitCode>(builder, linux_x86_64);
    Build::select_provider<TransmitCode, LinuxArmTransmitCode>(builder, linux_arm64);
    Build::select_provider<TransmitCode, WindowsTransmitCode>(builder, windows_x86_64);
}
