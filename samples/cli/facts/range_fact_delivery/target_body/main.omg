// For u64 index, index < 4 proves index <= 4 at count(index).
// Expected exit: 0.
machine count(index: u64) -> u64
requires index <= 4
{ index }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedDeliver {
    machine deliver(index: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 4;
}

X86Deliver satisfies SelectedDeliver {
    machine deliver(index: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 4
    {
        SelectedBodyCheck::require_tag(17u64);
     count(index) 
    }
}

ArmDeliver satisfies SelectedDeliver {
    machine deliver(index: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 4
    {
        SelectedBodyCheck::require_tag(29u64);
     count(index) 
    }
}


machine probe(input: u64) -> u64 requires input < 4 { SelectedDeliver::deliver(input) }
machine main() crashes Trap {
    let observed: u64 = probe(3);
    let zero: u64 = probe(0);
    transition observed == 3 && zero == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
