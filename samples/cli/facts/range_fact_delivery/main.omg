// A declared range is proven at every delivery point: literal, narrower
// declared range, local initializer, guard facts, and calls nested in
// expressions all use the same judgment.
machine admit(value: f64 [0.0..=0.5]) -> f64 { value }
machine outer(value: f64) -> f64 { value }
machine forward(value: f64 [0.0..=0.25]) -> f64 {
    let bounded: f64 [0.0..=0.5] = value;
    let result: f64 = outer(admit(bounded));
    result
}
machine count(value: u64 [0..=4]) -> u64 { value }
machine pick(index: u64) -> u64 {
    transition index < 4 {
        true -> (count(index))
        _ -> (0)
    }
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    _ = forward(0.125);
    _ = pick(3);
    _ = admit(0.5);
    main.hits = main.hits + 1;
}
