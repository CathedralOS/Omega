// Expected exit: 0
// A declared range is proven at every delivery point: literal, narrower
// declared range, local initializer, guard facts, and calls nested in
// expressions all use the same judgment.

use omega::language::core::float_operations;

machine admit(value: f64) -> f64 requires value >= 0.0 && value <= 0.5 { value }
machine outer(value: f64) -> f64 { value }
machine forward(value: f64) -> f64 requires value >= 0.0 && value <= 0.25 {
    let bounded: f64 = value;
    let result: f64 = outer(admit(bounded));
    result
}
machine count(value: u64) -> u64 requires value <= 4 { value }
machine pick(index: u64) -> u64 {
    transition index < 4 {
        true -> (count(index))
        _ -> (0)
    }
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) crashes Trap {
    let forwarded: f64 = forward(0.125);
    let counted: u64 = pick(3);
    let admitted: f64 = admit(0.5);
    transition forwarded == 0.125 && counted == 3 && admitted == 0.5 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) {
        main.hits = main.hits + 1;
    }
    state fail(main: &mut Main) {
        crash Trap;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
