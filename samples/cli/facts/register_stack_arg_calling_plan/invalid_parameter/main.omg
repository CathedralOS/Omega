// Fact: passing seven bounded integer arguments (`a1` through `a7` with `a7 <= 85u64`) across register and stack ABI slots preserves the stack-passed argument's static bound (`a7 <= 85u64`), discharging exact subtraction `85u64 - a7` across all nine places.
// Place: parameter (invalid twin).
// Expected diagnostic: exact subtraction underflow

machine calling_plan_seven(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 <= 86u64
ensures
    result <= 86u64 && result == a7
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
    (prefix - 210) + a7
}

machine probe(
    p1: u64,
    p2: u64,
    p3: u64,
    p4: u64,
    p5: u64,
    p6: u64,
    p7: u64
) -> u64
requires
    p1 == 10u64 && p2 == 20u64 && p3 == 30u64 && p4 == 40u64 && p5 == 50u64 &&
    p6 == 60u64 && p7 == 86u64
{
    let val: u64 = calling_plan_seven(p1, p2, p3, p4, p5, p6, p7);
    85u64 - val
}

machine main() crashes Trap {
    transition probe(10, 20, 30, 40, 50, 60, 86) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
