// Fact: passing seven bounded integer arguments (`a1` through `a7` with `a7 <= 85u64`) across register and stack ABI slots preserves the stack-passed argument's static bound (`a7 <= 85u64`), discharging exact subtraction `85u64 - a7` across all nine places.
// Place: another state (invalid twin).
// Expected diagnostic: exact subtraction underflow

machine calling_plan_seven(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 <= 86u64
ensures
    result <= 86u64 && result == a7
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
    (prefix - 210) + a7
}

machine probe() -> u64 {
    transition {
        _ -> step(10, 20, 30, 40, 50, 60, 86)
    }
    machine step(
        s1: u64, s2: u64, s3: u64, s4: u64, s5: u64,
        s6: u64, s7: u64
    ) -> u64
    requires
        s1 == 10u64 && s2 == 20u64 && s3 == 30u64 && s4 == 40u64 && s5 == 50u64 &&
        s6 == 60u64 && s7 == 86u64
    {
        let val: u64 = calling_plan_seven(s1, s2, s3, s4, s5, s6, s7);
        85u64 - val
    }
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
