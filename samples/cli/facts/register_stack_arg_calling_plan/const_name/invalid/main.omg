// Fact: passing seven bounded integer arguments (`a1` through `a7` with `a7 <= 85u64`) across register and stack ABI slots preserves the stack-passed argument's static bound (`a7 <= 85u64`), discharging exact subtraction `85u64 - a7` across all nine places.
// Place: const name (invalid twin).
// Expected diagnostic: exact subtraction underflow

const C1: u64 = 10;
const C2: u64 = 20;
const C3: u64 = 30;
const C4: u64 = 40;
const C5: u64 = 50;
const C6: u64 = 60;
const C7: u64 = 86;

machine calling_plan_seven(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64
) -> u64
requires
    a1 == C1 && a2 == C2 && a3 == C3 && a4 == C4 && a5 == C5 &&
    a6 == C6 && a7 <= C7
ensures
    result <= C7 && result == a7
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
    (prefix - 210) + a7
}

machine probe() -> u64 {
    let val: u64 = calling_plan_seven(C1, C2, C3, C4, C5, C6, C7);
    85u64 - val
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
