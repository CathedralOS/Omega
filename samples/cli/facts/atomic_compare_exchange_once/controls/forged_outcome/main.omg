// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use omega::language::core::layout;
data Forged<T> { case Mismatched(observed: T); case Exchanged; case Uncommitted(observed: T); }
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine probe(cells: &Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: Forged<u32> = cells.selected.compare_exchange_once(10, 99, ReceivePublish, Receive);
    transition outcome {
        Forged::Exchanged -> (cells.selected.load(NoOrdering) == 99 && cells.untouched.load(NoOrdering) == 17)
        Forged::Mismatched { observed } -> (false)
        Forged::Uncommitted { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
    }
}
machine mismatch(cells: &Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: Forged<u32> = cells.selected.compare_exchange_once(9, 99, ReceivePublish, Receive);
    transition outcome {
        Forged::Mismatched { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
        Forged::Exchanged -> (false)
        Forged::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) && mismatch(&cells) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
