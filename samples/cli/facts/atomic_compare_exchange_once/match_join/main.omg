// Expected exit: 0.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use omega::language::core::AtomicCompareExchangeOnceOutcome;
use omega::language::core::write;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine marked(outcome: AtomicCompareExchangeOnceOutcome<u32>, path: &write u64) -> AtomicCompareExchangeOnceOutcome<u32> {
    path = 1;
    outcome
}
machine probe(cells: &Cells, branch: bool, path: &write u64) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let raw: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(10, 99, ReceivePublish, Receive);
    let joined: AtomicCompareExchangeOnceOutcome<u32> = match branch {
        true -> marked(raw, path),
        false -> raw,
    };
    transition joined {
        AtomicCompareExchangeOnceOutcome::Exchanged -> (cells.selected.load(NoOrdering) == 99 && cells.untouched.load(NoOrdering) == 17)
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
    }
}
machine mismatch(cells: &Cells, branch: bool, path: &write u64) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let raw: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(9, 99, ReceivePublish, Receive);
    let joined: AtomicCompareExchangeOnceOutcome<u32> = match branch {
        true -> marked(raw, path),
        false -> raw,
    };
    transition joined {
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
        AtomicCompareExchangeOnceOutcome::Exchanged -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    let mut path: u64 = 0;
    let first: bool = probe(&cells, true, &write path);
    let first_path: u64 = path;
    path = 0;
    let second: bool = probe(&cells, false, &write path);
    let second_path: u64 = path;
    path = 0;
    let third: bool = mismatch(&cells, true, &write path);
    let third_path: u64 = path;
    path = 0;
    let fourth: bool = mismatch(&cells, false, &write path);
    let fourth_path: u64 = path;
    transition first && first_path == 1 && second && second_path == 0 && third && third_path == 1 && fourth && fourth_path == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
