// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use {omega}/language/core/layout.omg;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine inspect_param(outcome: |layout|::AtomicCompareExchangeOnceOutcome<u32>, cells: @Cells, want_success: bool) -> bool {
    let after: u32 = cells.selected.load(NoOrdering);
    let sibling: u32 = cells.untouched.load(NoOrdering);
    transition outcome {
        |layout|::AtomicCompareExchangeOnceOutcome::Exchanged -> (want_success && after == 99 && sibling == 17),
        |layout|::AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (!want_success && observed == 10 && after == 10 && sibling == 17),
        |layout|::AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (want_success && observed == 10 && after == 10 && sibling == 17)
    }
}
machine probe(cells: @Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: |layout|::AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(10, 99, ReceivePublish, Publish);
    inspect_param(outcome, cells, true)
}
machine mismatch(cells: @Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: |layout|::AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(9, 99, ReceivePublish, Receive);
    inspect_param(outcome, cells, false)
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(@cells) && mismatch(@cells) { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
