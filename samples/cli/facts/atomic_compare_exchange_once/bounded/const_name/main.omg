// Expected exit: 0.
// Bounded production: the selected atomic resident remains <= 100 on every outcome.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use omega::language::core::layout;
const EXPECTED_MATCH: u32 = 10;
const EXPECTED_MISMATCH: u32 = 9;
const REPLACEMENT: u32 = 99;
const SIBLING_INIT: u32 = 17;
data Cells where selected <= 100 { selected: AtomicU32; untouched: AtomicU32; }
machine probe(cells: &Cells) -> bool {
    cells.selected.store(EXPECTED_MATCH, NoOrdering);
    cells.untouched.store(SIBLING_INIT, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(EXPECTED_MATCH, REPLACEMENT, ReceivePublish, Receive);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Exchanged -> (cells.selected.load(NoOrdering) == REPLACEMENT && cells.untouched.load(NoOrdering) == SIBLING_INIT)
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (observed == EXPECTED_MATCH && cells.selected.load(NoOrdering) == EXPECTED_MATCH && cells.untouched.load(NoOrdering) == SIBLING_INIT)
    }
}
machine mismatch(cells: &Cells) -> bool {
    cells.selected.store(EXPECTED_MATCH, NoOrdering);
    cells.untouched.store(SIBLING_INIT, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(EXPECTED_MISMATCH, REPLACEMENT, ReceivePublish, Receive);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (observed == EXPECTED_MATCH && cells.selected.load(NoOrdering) == EXPECTED_MATCH && cells.untouched.load(NoOrdering) == SIBLING_INIT)
        AtomicCompareExchangeOnceOutcome::Exchanged -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) && mismatch(&cells) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
