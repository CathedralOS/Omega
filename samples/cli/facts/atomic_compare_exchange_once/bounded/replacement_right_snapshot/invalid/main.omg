// Expected exit: 0.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
data Cells where selected <= 100 { selected: AtomicU32; }
data Proposal { value: u32; }
machine clear(proposal: &mut Proposal) -> u32
ensures proposal.value == 101 && result == 0
{
    proposal.value = 101;
    0
}
machine probe(cells: &Cells) -> bool {
    let mut proposal: Proposal = Proposal { value: 101 };
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(0, clear(&mut proposal) + proposal.value, ReceivePublish, Receive);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Exchanged -> (cells.selected.load(Receive) == 101 && proposal.value == 101)
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (observed == 0 && cells.selected.load(Receive) == 0 && proposal.value == 101)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
