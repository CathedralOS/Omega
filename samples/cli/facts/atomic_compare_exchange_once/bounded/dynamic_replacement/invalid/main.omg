// Expected exit: 0.
// Bounded production: the selected atomic resident remains <= 100 on every outcome.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use omega::language::core::layout;
data Cells where selected <= 100 { selected: AtomicU32; untouched: AtomicU32; }
machine attempt(cells: &Cells, expected: u32, replacement: u32)
    -> AtomicCompareExchangeOnceOutcome<u32>
requires replacement <= 101
{
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(expected, replacement, ReceivePublish, Receive);
    outcome
}
machine probe(cells: &Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = attempt(cells, 10, 99);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Exchanged -> (cells.selected.load(NoOrdering) == 99 && cells.untouched.load(NoOrdering) == 17)
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
    }
}
machine mismatch(cells: &Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = attempt(cells, 9, 99);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
        AtomicCompareExchangeOnceOutcome::Exchanged -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) && mismatch(&cells) { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
