// Expected exit: 0.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use {omega}/language/core/layout.omg;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
data Held { outcome: |layout|::AtomicCompareExchangeOnceOutcome<u32>; }
machine probe(cells: @Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let raw: |layout|::AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(10, 99, ReceivePublish, Receive);
    let held: Held = Held { outcome: raw };
    transition held.outcome {
        |layout|::AtomicCompareExchangeOnceOutcome::Exchanged -> (cells.selected.load(NoOrdering) == 99 && cells.untouched.load(NoOrdering) == 17),
        |layout|::AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (false),
        |layout|::AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17)
    }
}
machine mismatch(cells: @Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let raw: |layout|::AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(9, 99, ReceivePublish, Receive);
    let held: Held = Held { outcome: raw };
    transition held.outcome {
        |layout|::AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (observed == 10 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17),
        |layout|::AtomicCompareExchangeOnceOutcome::Exchanged -> (false),
        |layout|::AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(@cells) && mismatch(@cells) { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
