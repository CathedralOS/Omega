// Expected exit: 0.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use omega::language::core::layout;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine attempt32(cells: &Cells, expected: u32) -> AtomicCompareExchangeOnceOutcome<u32> {
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(expected, 4294967295u32, ReceivePublish, Publish);
    outcome
}
machine probe(cells: &Cells) -> bool {
    cells.selected.store(2147483658u32, NoOrdering);
    cells.untouched.store(2147483665u32, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = attempt32(cells, 2147483658u32);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Exchanged -> (cells.selected.load(NoOrdering) == 4294967295u32 && cells.untouched.load(NoOrdering) == 2147483665u32)
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (observed == 2147483658u32 && cells.selected.load(NoOrdering) == 2147483658u32 && cells.untouched.load(NoOrdering) == 2147483665u32)
    }
}
machine mismatch(cells: &Cells) -> bool {
    cells.selected.store(2147483658u32, NoOrdering);
    cells.untouched.store(2147483665u32, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = attempt32(cells, 2147483657u32);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (observed == 2147483658u32 && cells.selected.load(NoOrdering) == 2147483658u32 && cells.untouched.load(NoOrdering) == 2147483665u32)
        AtomicCompareExchangeOnceOutcome::Exchanged -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) && mismatch(&cells) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
