// Fact: authorized typed mutation lends each non-erased field exclusively to the selected callback once and restores the caller's access afterward.
// Expected exit: 0
use omega::language::core::reflect;
data Subject [copy] { first: u64; second: u64; third: u64; }
machine increment<Kind>(count: &mut u64, info: &reflect::FieldInfo, value: &mut Kind)
requires Kind == u64
{
    increment_value<Kind>(value);
    count = ((count as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
}
machine main() crashes Trap {
    let mut value: Subject = Subject { first: 1u64, second: 2u64, third: 18446744073709551615u64 };
    let mut count: u64 = 0u64;
    maybe(false, &mut value, &mut count);
    let skipped: bool = value.first == 1u64 && value.second == 2u64 && count == 0u64;
    maybe(true, &mut value, &mut count);
    transition skipped && value.first == 2u64 && value.second == 3u64 && value.third == 0u64 && count == 3u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine maybe(active: bool, value: &mut Subject, count: &mut u64) {
    transition active {
        true -> reflect::visit_runtime_fields_mut<Subject, increment>(value, count)
        false -> done()
    }
    machine done() {}
}

machine increment_value<Kind>(value: &mut Kind)
requires Kind == u64 || Kind == u32
{
    transition { Kind == u64 -> wide(value) _ -> narrow(value) }
    machine wide(value: &mut u64) {
        value = ((value as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
    }
    machine narrow(value: &mut u32) {
        value = ((value as u32 in Wrapping) + (1u32 as u32 in Wrapping)) as u32;
    }
}
