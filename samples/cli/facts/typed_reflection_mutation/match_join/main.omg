// Fact: authorized typed mutation lends each non-erased field exclusively to the selected callback once and restores the caller's access afterward.
// Expected exit: 0
use {omega}/language/core/reflect/reflect.omg;
data Subject [copy] { first: u64; second: u64; third: u64; }
machine increment<Kind>(count: @mutable u64, info: @|reflect|::FieldInfo, value: @mutable Kind)
requires Kind == u64
{
    $value = (($value as u64 +Wrapping) + (1u64 as u64 +Wrapping)) as u64;
    $count = (($count as u64 +Wrapping) + (1u64 as u64 +Wrapping)) as u64;
}
machine choose(first: bool) crashes Trap {
    let mutable value: Subject = Subject { first: 1u64, second: 2u64, third: 18446744073709551615u64 };
    let mutable count: u64 = 0u64;
    let mutable spare: Subject = Subject { first: 1u64, second: 2u64, third: 18446744073709551615u64 };
    let selected: @mutable Subject = match first { true -> @mutable value, false -> @mutable spare };
    |reflect|::visit_runtime_fields_mut::<Subject, increment>(selected, @mutable count);
    transition first {
        true -> verify(value, spare, count),
        false -> verify(spare, value, count)
    }
    machine verify(changed: Subject, unchanged: Subject, count: u64) crashes Trap {
        transition changed.first == 2u64 && changed.second == 3u64 && changed.third == 0u64 && count == 3u64 && unchanged.first == 1u64 && unchanged.second == 2u64 && unchanged.third == 18446744073709551615u64 {
            true -> done(),
            false -> bad()
        }
        machine done() {}
        machine bad() { crash Trap; }
    }
}
machine main() crashes Trap {
    choose(true);
    choose(false);
}
