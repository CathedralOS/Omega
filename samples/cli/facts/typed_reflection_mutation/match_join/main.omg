// Fact: authorized typed mutation lends each non-erased field exclusively to the selected callback once and restores the caller's access afterward.
// Expected exit: 0
use omega::language::core::reflect;
data Subject [copy] { first: u64; second: u64; third: u64; }
machine increment<Kind>(count: &mut u64, info: &reflect::FieldInfo, value: &mut Kind)
requires Kind == u64
{
    value = ((value as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
    count = ((count as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
}
machine choose(first: bool) crashes Trap {
    let mut value: Subject = Subject { first: 1u64, second: 2u64, third: 18446744073709551615u64 };
    let mut count: u64 = 0u64;
    let mut spare: Subject = Subject { first: 1u64, second: 2u64, third: 18446744073709551615u64 };
    let selected: &mut Subject = match first { true -> &mut value, false -> &mut spare };
    reflect::visit_runtime_fields_mut<Subject, increment>(selected, &mut count);
    transition first {
        true -> verify(value, spare, count)
        false -> verify(spare, value, count)
    }
    machine verify(changed: Subject, unchanged: Subject, count: u64) crashes Trap {
        transition changed.first == 2u64 && changed.second == 3u64 && changed.third == 0u64 && count == 3u64 && unchanged.first == 1u64 && unchanged.second == 2u64 && unchanged.third == 18446744073709551615u64 {
            true -> done()
            false -> bad()
        }
        machine done() {}
        machine bad() { crash Trap; }
    }
}
machine main() crashes Trap {
    choose(true);
    choose(false);
}
