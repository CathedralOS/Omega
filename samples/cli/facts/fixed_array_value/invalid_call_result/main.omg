// A fixed-extent array [u64; 2] preserves its in-bounds index contract index < 2 and independent element values across all nine places.
// Invalid: the helper call ensures result <= 2, so the returned index may exceed length 2.
// Expected exit: 0
machine supply_index(index: u64) -> u64
requires index <= 2
ensures result <= 2
{
    index
}

machine read_element(values: [u64; 2], index: u64) -> u64
requires index <= 2
{
    let picked_index: u64 = supply_index(index);
    values[picked_index]
}

machine main() crashes Trap {
    let values: [u64; 2] = [19, 42];
    transition values[0] == 19 && values[1] == 42 && read_element(values, 1) == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
