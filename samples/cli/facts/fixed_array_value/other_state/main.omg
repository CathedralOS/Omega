// A fixed-extent array [u64; 2] preserves its in-bounds index contract index < 2 and independent element values across all nine places.
// Place: another state. A transition to a successor state forwards the bounded index and array.
// Expected exit: 0
machine read_element(values: [u64; 2], index: u64) -> u64
requires index < 2
{
    transition { _ -> element(values, index) }
    machine element(passed_values: [u64; 2], passed_index: u64) -> u64
    requires passed_index < 2
    {
        passed_values[passed_index]
    }
}

machine main() crashes Trap {
    let values: [u64; 2] = [19, 42];
    transition values[0] == 19 && values[1] == 42 && read_element(values, 1) == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
