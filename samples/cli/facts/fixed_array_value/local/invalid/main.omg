// A fixed-extent array [u64; 2] preserves its in-bounds index contract index < 2 and independent element values across all nine places.
// Invalid: the index bound is weakened to index <= 2, so the index may exceed length 2.
// Expected exit: 0
machine read_element(values: [u64; 2], index: u64) -> u64
requires index <= 2
{
    let local_values: [u64; 2] = values;
    let local_index: u64 = index;
    local_values[local_index]
}

machine main() crashes Trap {
    let values: [u64; 2] = [19, 42];
    transition values[0] == 19 && values[1] == 42 && read_element(values, 1) == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
