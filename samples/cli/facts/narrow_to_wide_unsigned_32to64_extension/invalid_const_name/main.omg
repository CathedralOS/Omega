// Fact: zero-extending a bounded 32-bit unsigned u32 value (narrow >= 70000u32 && narrow <= 90000u32) to u64 (narrow as u64) preserves the exact interval (wide >= 70000u64 && wide <= 90000u64), discharging exact 64-bit subtractions 90000u64 - wide and wide - 70000u64 across all nine places.
// Expected exit: 0

const BASE_NARROW: u32 = 90001u32;

machine exercise() -> i32 {
    let narrow: u32 = BASE_NARROW;
    let wide: u64 = narrow as u64;
    let diff1: u64 = 90000u64 - wide;
    let diff2: u64 = wide - 70000u64;
    transition diff1 == 10000u64 && diff2 == 10000u64 {
        true -> 0i32
        _ -> 1i32
    }
}

machine main() crashes Trap {
    let exit_code: i32 = exercise();
    transition exit_code == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
