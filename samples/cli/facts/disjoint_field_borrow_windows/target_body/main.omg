// Fact: mutating or borrowing one field (pair.left) of a structural record (Pair { left: u64, right: u64 }) preserves the static bound on its provably disjoint sibling field (pair.right <= 75u64), discharging exact subtraction 75u64 - pair.right across all nine places.
// Expected exit: 0

data Pair {
    left: u64;
    right: u64;
}

machine touch_left(left: &mut u64) {
    left = 999u64;
}

machine verify(result: u64)
requires result <= 75u64
crashes Trap
{
    transition result == 50u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

linux_x86_64 machine exercise(pair: &mut Pair)
requires pair.right <= 75u64
crashes Trap
{
    touch_left(&mut pair.left);
    let diff: u64 = 75u64 - pair.right;
    verify(diff);
}

linux_arm64 machine exercise(pair: &mut Pair)
requires pair.right <= 75u64
crashes Trap
{
    touch_left(&mut pair.left);
    let diff: u64 = 75u64 - pair.right;
    verify(diff);
}

macos_arm64 machine exercise(pair: &mut Pair)
requires pair.right <= 75u64
crashes Trap
{
    touch_left(&mut pair.left);
    let diff: u64 = 75u64 - pair.right;
    verify(diff);
}

windows_x86_64 machine exercise(pair: &mut Pair)
requires pair.right <= 75u64
crashes Trap
{
    touch_left(&mut pair.left);
    let diff: u64 = 75u64 - pair.right;
    verify(diff);
}

machine main() crashes Trap {
    let mut pair: Pair = Pair { left: 10u64, right: 25u64 };
    exercise(&mut pair);
}
