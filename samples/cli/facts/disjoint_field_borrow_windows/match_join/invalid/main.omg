// Fact: mutating or borrowing one field (pair.left) of a structural record (Pair { left: u64, right: u64 }) preserves the static bound on its provably disjoint sibling field (pair.right <= 75u64), discharging exact subtraction 75u64 - pair.right across all nine places.
// Expected exit: 0

data Pair {
    left: u64;
    right: u64;
}

machine choose(flag: bool) -> Pair
ensures result.right <= 76u64
{
    match flag {
        true -> Pair { left: 10u64, right: 76u64 },
        false -> Pair { left: 20u64, right: 30u64 },
    }
}

machine touch_left(left: &mut u64) {
    left = 999u64;
}

machine exercise(flag: bool) -> u64
{
    let mut pair: Pair = choose(flag);
    touch_left(&mut pair.left);
    let diff: u64 = 75u64 - pair.right;
    diff
}

machine main() crashes Trap {
    let diff1: u64 = exercise(true);
    let diff2: u64 = exercise(false);
    transition diff1 == 50u64 && diff2 == 45u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
