// A checked asm block (or target-scoped checked assembly helper) with explicit register operand bindings and contract (result <= 96u64) establishes the post-assembly bound, discharging exact subtraction 96u64 - result.
// Expected exit: 0.
machine read_asm() -> u64 ensures result <= 96u64 {
    let mut val: u32 = 0;
    asm {
    entry:
        mov eax, 36;
        jmp done;
    done requires eax <= 96:
        mov val, eax
    }
    val as u64
}

machine main() crashes Trap {
    let val: u64 = read_asm();
    let diff: u64 = 96u64 - val;
    transition diff == 60u64 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
