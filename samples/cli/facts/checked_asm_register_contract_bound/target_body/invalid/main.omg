// A checked asm block (or target-scoped checked assembly helper) with explicit register operand bindings and contract (result <= 96u64) establishes the post-assembly bound, discharging exact subtraction 96u64 - result.
// Expected rejection: exact arithmetic in machine exercise state entry terminal expression may overflow `u64`.
linux_x86_64 machine exercise() -> u64 {
    let mut val: u32 = 0;
    asm {
    entry:
        mov eax, 97;
        jmp done;
    done requires eax <= 97:
        mov val, eax
    }
    96u64 - (val as u64)
}

windows_x86_64 machine exercise() -> u64 {
    let mut val: u32 = 0;
    asm {
    entry:
        mov eax, 97;
        jmp done;
    done requires eax <= 97:
        mov val, eax
    }
    96u64 - (val as u64)
}

linux_arm64 machine exercise() -> u64 {
    96u64 - 97u64
}

macos_arm64 machine exercise() -> u64 {
    96u64 - 97u64
}

machine main() crashes Trap {
    let diff: u64 = exercise();
    transition diff == 0u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
