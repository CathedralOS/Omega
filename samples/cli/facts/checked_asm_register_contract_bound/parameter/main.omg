// A checked asm block (or target-scoped checked assembly helper) with explicit register operand bindings and contract (result <= 96u64) establishes the post-assembly bound, discharging exact subtraction 96u64 - result.
// Expected exit: 0.
boundary trait SelectedReadAsm {
    machine read_asm() -> u64 reaches
ensures result <= 96u64;
}
LinuxX8664ReadAsm satisfies SelectedReadAsm {
    machine read_asm() -> u64 ensures result <= 96u64
{
    let mut val: u32 = 0;
    asm {
    entry:
        mov eax, 36;
        jmp done;
    done requires eax <= 96:
        mov val, eax
    }
    val as u64
}
}



LinuxArm64ReadAsm satisfies SelectedReadAsm {
    machine read_asm() -> u64 ensures result <= 96u64
{
    36u64
}
}



machine compute(val: u64) -> u64
requires val <= 96u64
{
    96u64 - val
}

machine main() crashes Trap {
    let diff: u64 = compute(SelectedReadAsm::read_asm());
    transition diff == 60u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
