// A checked asm block (or target-scoped checked assembly helper) with explicit register operand bindings and contract (result <= 96u64) establishes the post-assembly bound, discharging exact subtraction 96u64 - result.
// Expected exit: 0.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReadAsm {
    machine read_asm() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 96u64;
}

X86ReadAsm satisfies SelectedReadAsm {
    machine read_asm() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 96u64
    {
        SelectedBodyCheck::require_tag(17u64);
        let mut val: u32 = 0;
        asm {
        entry:
            mov eax, 36;
            jmp done;
        done requires eax <= 96:
            mov val, eax
        }
        val as u64
    }
}

ArmReadAsm satisfies SelectedReadAsm {
    machine read_asm() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 96u64
    {
        SelectedBodyCheck::require_tag(29u64);
        36u64
    }
}


machine forward() -> u64 {
    let val: u64 = SelectedReadAsm::read_asm();
    96u64 - val
}

machine main() crashes Trap {
    let diff: u64 = forward();
    transition diff == 60u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
