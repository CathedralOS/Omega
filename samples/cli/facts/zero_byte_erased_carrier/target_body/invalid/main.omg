// Fact: a record pairing a zero-byte token with a u64 value carries value >= 100u64 && value <= 100u64 with zero physical byte overhead across nine places, discharging exact subtraction value - 100u64 and size_of checks.
// Invalid control: the carrier value violates the contract bound value >= 100u64 && value <= 100u64.

data Token {
    empty: [u8; 0];
}

data Carrier {
    token: Token;
    value: u64;
}

machine verify_carrier(carrier: Carrier) -> u64
requires carrier.value >= 100u64 && carrier.value <= 100u64
{
    let token_size: u64 = size_of<Token>();
    let carrier_size: u64 = size_of<Carrier>();
    let diff: u64 = carrier.value - 100u64;
    transition token_size == 0 && carrier_size == 8 && diff == 0 {
        true -> 0
        _ -> 1
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(carrier: Carrier) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires carrier.value >= 100u64 && carrier.value <= 100u64;
}

X86Probe satisfies SelectedProbe {
    machine probe(carrier: Carrier) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires carrier.value >= 100u64 && carrier.value <= 100u64
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_carrier(carrier)
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(carrier: Carrier) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires carrier.value >= 100u64 && carrier.value <= 100u64
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_carrier(carrier)
    }
}

machine main() crashes Trap {
    let carrier: Carrier = Carrier { token: Token { empty: [] }, value: 99u64 };
    let exit_code: u64 = SelectedProbe::probe(carrier);
    transition exit_code == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
