// Fact: a record pairing a zero-byte token with a u64 value carries value >= 100u64 && value <= 100u64 with zero physical byte overhead across nine places, discharging exact subtraction value - 100u64 and size_of checks.
// Invalid control: the carrier value violates the contract bound value >= 100u64 && value <= 100u64.

data Token {
    empty: [u8; 0];
}

data Carrier {
    token: Token;
    value: u64;
}

machine verify_carrier(carrier: Carrier) -> u64
requires carrier.value >= 100u64 && carrier.value <= 100u64
{
    let token_size: u64 = size_of<Token>();
    let carrier_size: u64 = size_of<Carrier>();
    let diff: u64 = carrier.value - 100u64;
    transition token_size == 0 && carrier_size == 8 && diff == 0 {
        true -> 0
        _ -> 1
    }
}

machine choose(flag: bool) -> u64 {
    let carrier: Carrier = match flag {
        true -> Carrier { token: Token { empty: [] }, value: 100u64 },
        false -> Carrier { token: Token { empty: [] }, value: 99u64 }
    };
    verify_carrier(carrier)
}

machine main() crashes Trap {
    let first: u64 = choose(true);
    let second: u64 = choose(false);
    transition first == 0 && second == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
