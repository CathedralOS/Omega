machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "non_owning_reference_erasure" };
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider::<ErasedWrite, ErasedWriteCode>(builder, windows_x86_64);
    Build::select_provider::<ErasedWrite, ErasedWriteCode>(builder, linux_x86_64);
    Build::select_provider::<ErasedWrite, ErasedWriteCode>(builder, macos_arm64);
    Build::select_provider::<ErasedWrite, ErasedWriteCode>(builder, linux_arm64);
}
