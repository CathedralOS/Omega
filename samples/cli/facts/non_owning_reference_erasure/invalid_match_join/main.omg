// Expected exit: 0
// Fact: explicit non-owning reference erasure writes 73 to the original record without minting routed membership.
data Storage { left_canary: u32; value: u32; right_canary: u32; }
domain Storage::Issued established by issue;
domain Storage::Reissued established by reissue;
machine issue(value: u32) -> Storage in Issued { Storage { left_canary: 17, value: value, right_canary: 23 } }
machine reissue(value: u32) -> Storage in Reissued { Storage { left_canary: 17, value: value, right_canary: 23 } }
machine write(first: &write Storage in Issued, second: &write Storage in Issued, choose: bool) {
    let view: &write Storage in Reissued = match choose { true -> first as &write Storage in Reissued, false -> second as &write Storage in Reissued };
    view.value = 73;
}
machine main() crashes Trap {
    let mut storage: Storage in Issued = issue(0);
    let mut spare: Storage in Issued = issue(0);
    write(&write storage, &write spare, true);
    transition storage.value == 73 && storage.left_canary == 17 && storage.right_canary == 23 && spare.value == 0 && spare.left_canary == 17 && spare.right_canary == 23 { true -> second_round() _ -> bad() }
    machine second_round() {
        let mut other: Storage in Issued = issue(0);
        let mut second_spare: Storage in Issued = issue(0);
        write(&write second_spare, &write other, false);
        transition other.value == 73 && other.left_canary == 17 && other.right_canary == 23 && second_spare.value == 0 && second_spare.left_canary == 17 && second_spare.right_canary == 23 { true -> done() _ -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
