// Expected exit: 0
// Fact: explicit non-owning reference erasure writes 73 to the original record without minting routed membership.
data Storage { value: u32; }
domain Storage::Issued established by issue;
domain Storage::Reissued established by reissue;
machine issue(value: u32) -> Storage in Issued { Storage { value: value } }
machine reissue(value: u32) -> Storage in Reissued { Storage { value: value } }
const WRITTEN: u32 = 73;
machine write(storage: &write Storage in Issued) {
    let view: &write Storage in Reissued = storage as &write Storage in Reissued;
    view.value = WRITTEN;
}
machine main() crashes Trap {
    let mut storage: Storage in Issued = issue(0);
    write(&write storage);
    transition storage.value == 73 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
