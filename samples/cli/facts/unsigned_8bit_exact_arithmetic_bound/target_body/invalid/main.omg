// Fact: an 8-bit unsigned u8 exact addition of bounded inputs (lhs >= 30u8 && lhs <= 80u8, rhs >= 40u8 && rhs <= 100u8) establishes sum >= 70u8 && sum <= 180u8 so exact 8-bit subtractions 180u8 - sum and sum - 70u8 are proved overflow-free across all nine places.
// Invalid: target bodies compute 80 + 120 = 200u8, causing 180u8 - sum to underflow u8. Place: target_body.
// Expected diagnostic: may overflow `u8`

linux_x86_64 machine verify_target() -> i32 {
    let lhs: u8 = 80u8;
    let rhs: u8 = 120u8;
    let sum: u8 = lhs + rhs;
    let headroom: u8 = 180u8 - sum;
    let margin: u8 = sum - 70u8;
    let total: u8 = headroom + margin;
    match total == 110u8 {
        true -> 0i32,
        false -> 1i32,
    }
}

linux_arm64 machine verify_target() -> i32 {
    let lhs: u8 = 80u8;
    let rhs: u8 = 120u8;
    let sum: u8 = lhs + rhs;
    let headroom: u8 = 180u8 - sum;
    let margin: u8 = sum - 70u8;
    let total: u8 = headroom + margin;
    match total == 110u8 {
        true -> 0i32,
        false -> 1i32,
    }
}

macos_arm64 machine verify_target() -> i32 {
    let lhs: u8 = 80u8;
    let rhs: u8 = 120u8;
    let sum: u8 = lhs + rhs;
    let headroom: u8 = 180u8 - sum;
    let margin: u8 = sum - 70u8;
