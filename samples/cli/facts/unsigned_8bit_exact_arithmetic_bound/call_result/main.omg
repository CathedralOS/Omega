// Fact: an 8-bit unsigned u8 exact addition of bounded inputs (lhs >= 30u8 && lhs <= 80u8, rhs >= 40u8 && rhs <= 100u8) establishes sum >= 70u8 && sum <= 180u8 so exact 8-bit subtractions 180u8 - sum and sum - 70u8 are proved overflow-free across all nine places.
// Place: call_result. A machine call returns the 8-bit sum directly before discharging subtractions.
// Expected exit: 0

machine add(lhs: u8, rhs: u8) -> u8
requires lhs >= 30u8 && lhs <= 80u8 && rhs >= 40u8 && rhs <= 100u8
ensures result >= 70u8 && result <= 180u8
{
    lhs + rhs
}

machine compute_call(lhs: u8, rhs: u8) -> i32
requires lhs >= 30u8 && lhs <= 80u8 && rhs >= 40u8 && rhs <= 100u8
{
    let sum: u8 = add(lhs, rhs);
    let headroom: u8 = 180u8 - sum;
    let margin: u8 = sum - 70u8;
    let total: u8 = headroom + margin;
    match total == 110u8 {
        true -> 0i32,
        false -> 1i32,
    }
}

machine probe() -> i32 {
    compute_call(50u8, 70u8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
