// Expected exit: 0
domain i32::Selected(value) requires value == 1 || value == 38;
machine main() crashes Trap {
    let items: [i32 in Selected; 2] = [1, 38];
    let observed: i32 in Selected = items[1];
    transition observed == 38 && items[0] == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
