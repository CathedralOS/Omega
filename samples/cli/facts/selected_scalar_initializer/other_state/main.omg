// An explicitly initialized [i32 in Selected; 2] retains the nonzero disjunctive domain 1 or 38, and indexing its second element observes 38.
// Expected exit: 0
domain i32::Selected(value) requires value == 1 || value == 38;
machine verify(observed: i32, first: i32, flag: bool) crashes Trap {
    transition (flag && observed == 38 && first == 1) || (!flag && first == 1 && observed == 38) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine exercise(flag: bool) crashes Trap {
    let items: [i32 in Selected; 2] = [1, 38];
    transition flag { true -> ready(items, true) false -> ready(items, false) }
    machine ready(items: [i32 in Selected; 2], flag: bool) {
    let observed: i32 in Selected = items[1];
    verify(observed, items[0], flag);
    }
}
machine main() crashes Trap { exercise(true); exercise(false); }
