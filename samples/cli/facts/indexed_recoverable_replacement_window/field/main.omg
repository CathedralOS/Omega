// Expected exit: 0
// A consuming recoverable result restores its exact borrowed place and preserves disjoint storage.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Outcome { case Success(token: Token); case Failure(token: Token); }
data Holder { tokens: [Token; 2]; sibling: u64; }
machine first_slot() -> u64 ensures result == 0 { 0 }
machine attempt(token: Token, succeed: bool, observed: u64) -> Outcome {
    transition succeed {
        true -> success(token)
        _ -> Outcome::Failure { token: token }
    }
    state success(token: Token) -> Outcome {
        let value: u64 = token.value;
        drop(token);
        Outcome::Success { token: Token { value: ((value as u64 in Wrapping) + 1) as u64 } }
    }
}
machine recover(outcome: Outcome) -> Token {
    transition outcome {
        Outcome::Success { token } -> token
        Outcome::Failure { token } -> token
    }
}
machine observe(sibling: &mut u64) -> u64 { sibling = 19; sibling }
machine repair(holder: &mut Holder, succeed: bool) {
    let alias: &mut Token = &mut holder.tokens[first_slot()];
    let first: Outcome = attempt(alias, succeed, observe(&mut holder.sibling));
    alias = recover(first);
    let detached: Token = alias;
    let second: Outcome = attempt(detached, succeed, observe(&mut holder.sibling));
    holder.tokens[first_slot()] = recover(second);
}
data Envelope { prefix: u64; holder: Holder; }
machine main() crashes Trap {
    let mut envelope: Envelope = Envelope { prefix: 73, holder: Holder { tokens: [Token { value: 42 }, Token { value: 7 }], sibling: 7 } };
    repair(&mut envelope.holder, false);
    repair(&mut envelope.holder, true);
    let correct: bool = envelope.holder.tokens[first_slot()].value == 44 && envelope.holder.sibling == 19 && envelope.holder.tokens[1].value == 7 && envelope.prefix == 73;
    drop(envelope.holder.tokens[first_slot()]);
    drop(envelope.holder.tokens[1]);
    transition correct { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
