// Fact: indexed write-only reborrows update the original selected cells to -43 and 9 while preserving padding 11 and 23.
// Expected exit: 0
// Place: target_body.

data Cell [copy] { padding: i64; value: i64; }
data Storage { cells: [Cell; 2]; position: u64; }
machine replace(cell: &write Cell, value: i64) { cell.value = value; }
machine success() {}
machine failure() crashes Trap { crash Trap; }
machine verify(storage: &Storage) crashes Trap {
    transition storage.cells[0].value == -43 && storage.cells[1].value == 9
        && storage.cells[0].padding == 11 && storage.cells[1].padding == 23
        && storage.position == 0 {
        true -> success()
        _ -> failure()
    }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(storage: &mut Storage)
        reaches SelectedBodyCheck crashes Trap
        requires storage.position == 1;
}

X86Probe satisfies SelectedProbe {
    machine exercise(storage: &mut Storage)
        reaches SelectedBodyCheck crashes Trap
        requires storage.position == 1
    {
        SelectedBodyCheck::require_tag(17u64);
        let parent: &write [Cell; 2] = &write storage.cells;
        let child: &write [Cell; 2] = &write parent;
        replace(&write child[storage.position], 7);
        replace(&write child[storage.position], 9);
        storage.position = 0;
        replace(&write child[storage.position], -43);
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(storage: &mut Storage)
        reaches SelectedBodyCheck crashes Trap
        requires storage.position == 1
    {
        SelectedBodyCheck::require_tag(29u64);
        let parent: &write [Cell; 2] = &write storage.cells;
        let child: &write [Cell; 2] = &write parent;
        replace(&write child[storage.position], 7);
        replace(&write child[storage.position], 9);
        storage.position = 0;
        replace(&write child[storage.position], -43);
    }
}





machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let mut storage: Storage;
    storage.cells[0].padding = 11;
    storage.cells[0].value = 85;
    storage.cells[1].padding = 23;
    storage.cells[1].value = 29;
    storage.position = 1;
    SelectedProbe::exercise(&mut storage);
    verify(&storage);
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
