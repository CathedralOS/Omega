// Fact: A 32-bit unsigned u32 remainder operation (dividend % divisor where divisor >= 16u32 && divisor <= 16u32) establishes rem <= 15u32 so exact 32-bit subtraction 15u32 - rem is proved underflow-free across all nine places.
// Place: field. The bounded operands are stored within a nominal record field.
// Expected exit: 0

data Operands {
    dividend: u32;
    divisor: u32;
}

machine remainder_field(dividend: u32, divisor: u32) -> i32
    requires divisor >= 16u32 && divisor <= 16u32;
{
    let ops: Operands = Operands { dividend: dividend, divisor: divisor };
    let rem: u32 = ops.dividend % ops.divisor;
    let headroom: u32 = 15u32 - rem;
    transition rem == 11u32 && headroom == 4u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_field(43u32, 16u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
