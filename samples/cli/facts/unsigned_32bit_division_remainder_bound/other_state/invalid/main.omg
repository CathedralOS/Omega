// Fact: A 32-bit unsigned u32 remainder operation (dividend % divisor where divisor >= 16u32 && divisor <= 16u32) establishes rem <= 15u32 so exact 32-bit subtraction 15u32 - rem is proved underflow-free across all nine places.
// Place: another state. A successor state receives the remainder and verifies the arithmetic interval.
// Invalid control: divisor upper bound widened to 17u32, allowing rem as high as 16u32 and failing subtraction 15u32 - rem.
// Expected rejection: may overflow `u32`

machine remainder_other_state(dividend: u32, divisor: u32) -> i32
    requires divisor >= 16u32 && divisor <= 17u32;
{
    let rem: u32 = dividend % divisor;
    transition {
        _ -> check_state(rem)
    }
    machine check_state(r: u32) -> i32
        requires r <= 16u32;
    {
        let headroom: u32 = 15u32 - r;
        transition r == 11u32 && headroom == 4u32 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_other_state(43u32, 16u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
