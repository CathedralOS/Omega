// Fact: A 32-bit unsigned u32 remainder operation (dividend % divisor where divisor >= 16u32 && divisor <= 16u32) establishes rem <= 15u32 so exact 32-bit subtraction 15u32 - rem is proved underflow-free across all nine places.
// Place: call result. The remainder is received from a helper call returning the remainder result.
// Invalid control: divisor upper bound widened to 17u32, allowing rem as high as 16u32 and failing subtraction 15u32 - rem.
// Expected rejection: may overflow `u32`

machine compute_remainder(d: u32, s: u32) -> u32
    requires s >= 16u32 && s <= 17u32;
    ensures result <= 16u32;
{
    d % s
}

machine remainder_call_result(dividend: u32, divisor: u32) -> i32
    requires divisor >= 16u32 && divisor <= 17u32;
{
    let rem: u32 = compute_remainder(dividend, divisor);
    let headroom: u32 = 15u32 - rem;
    transition rem == 11u32 && headroom == 4u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_call_result(43u32, 16u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
