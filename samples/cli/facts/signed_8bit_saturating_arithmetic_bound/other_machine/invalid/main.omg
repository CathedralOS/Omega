// Fact: 8-bit signed saturating addition lhs +| rhs with bounded interval 50i8 <= sum <= 100i8 establishes 50i8 <= sum <= 100i8 across all nine places so exact subtractions 100i8 - sum and sum - 50i8 are safe.
// Invalid: widened inputs produce sum of 105i8, failing runner requires contract.

machine compute_sat(lhs: i8 in Saturating, rhs: i8 in Saturating) -> i8 in Saturating {
    lhs + rhs
}

machine verify_sum(sum: i8) -> i32
    requires sum >= 50 && sum <= 100
{
    let headroom: i8 = 100 - sum;
    let margin: i8 = sum - 50;
    let total: i8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

machine forward(val: i8) -> i32
    requires val >= 50 && val <= 100
{
    verify_sum(val)
}

machine runner(val: i8) -> i32
    requires val >= 50 && val <= 100
{
    forward(val)
}

machine main() crashes Trap {
    let lhs: i8 in Saturating = 85;
    let rhs: i8 in Saturating = 20;
    let sum_sat: i8 in Saturating = compute_sat(lhs, rhs);
    let sum: i8 = sum_sat as i8;
    let check: i32 = runner(sum);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
