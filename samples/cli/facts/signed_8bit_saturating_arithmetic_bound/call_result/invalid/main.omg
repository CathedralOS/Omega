// Fact: 8-bit signed saturating addition lhs +| rhs with bounded interval 50i8 <= sum <= 100i8 establishes 50i8 <= sum <= 100i8 across all nine places so exact subtractions 100i8 - sum and sum - 50i8 are safe.
// Invalid: widened inputs produce sum of 105i8, failing produce_sum ensures contract.

machine verify_sum(sum: i8) -> i32
    requires sum >= 50 && sum <= 100
{
    let headroom: i8 = 100 - sum;
    let margin: i8 = sum - 50;
    let total: i8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

machine produce_sum(lhs: i8 in Saturating, rhs: i8 in Saturating) -> i8
    requires lhs as i8 >= 40 && lhs as i8 <= 85, rhs as i8 >= 10 && rhs as i8 <= 20
    ensures result >= 50 && result <= 100
{
    let sat: i8 in Saturating = lhs + rhs;
    sat as i8
}

machine main() crashes Trap {
    let lhs: i8 in Saturating = 85;
    let rhs: i8 in Saturating = 20;
    let sum: i8 = produce_sum(lhs, rhs);
    let check: i32 = verify_sum(sum);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
