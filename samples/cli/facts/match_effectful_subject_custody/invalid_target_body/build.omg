use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "match_effectful_subject_custody_through_target_body_rejected" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedApply, |app|::X86Apply>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedApply, |app|::ArmApply>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedApply, |app|::ArmApply>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedApply, |app|::X86Apply>(builder, windows_x86_64);
}
