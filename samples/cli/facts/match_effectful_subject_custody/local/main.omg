// A match subject call installs a fresh token in the slot it borrows, the selected arm's branch-local call takes custody of that installed token or of the other token, and every token the arms leave behind is cleaned up exactly once.
// Place: local.
// Expected exit: 0
data Counter { count: u64 in Wrapping; }
data Token<'c> dropped by drop_token<'c> { counter: @'c mutable Counter; mark: u64; }

machine drop_token<'c>(token: @mutable Token<'c>) {
    token.counter.count = token.counter.count + (token.mark as u64 +Wrapping);
}

machine relay<'c>(token: Token<'c>) -> Token<'c> {
    let mutable kept: Token<'c> = token;
    kept.mark = 40;
    kept
}

machine refill<'c>(slot: @mutable Token<'c>, counter: @'c mutable Counter, flag: bool) -> bool {
    $slot = Token { counter: counter, mark: 5 };
    flag
}

machine exercise(a: @mutable Counter, b: @mutable Counter, c: @mutable Counter, flag: bool) -> u64 {
    let mutable slot: Token = Token { counter: a, mark: 11 };
    let other: Token = Token { counter: b, mark: 13 };
    let held: Token = match refill(@mutable slot, c, flag) {
        true -> relay(slot),
        false -> relay(other)
    };
    held.mark
}

machine main() crashes Trap {
    let mutable a1: Counter = Counter { count: 0 };
    let mutable b1: Counter = Counter { count: 0 };
    let mutable c1: Counter = Counter { count: 0 };
    let mutable a2: Counter = Counter { count: 0 };
    let mutable b2: Counter = Counter { count: 0 };
    let mutable c2: Counter = Counter { count: 0 };
    let m1: u64 = exercise(@mutable a1, @mutable b1, @mutable c1, true);
    let m2: u64 = exercise(@mutable a2, @mutable b2, @mutable c2, false);
    transition m1 == 40 && a1.count == 11 && b1.count == 13 && c1.count == 40
        && m2 == 40 && a2.count == 11 && b2.count == 40 && c2.count == 5 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
