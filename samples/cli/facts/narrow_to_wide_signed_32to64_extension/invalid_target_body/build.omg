machine build(builder: &mut Build) {
    Build::application(builder, "narrow_to_wide_signed_32to64_extension_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedExtTarget, X86ExtTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedExtTarget, ArmExtTarget>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedExtTarget, ArmExtTarget>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedExtTarget, X86ExtTarget>(builder, windows_x86_64);
}
