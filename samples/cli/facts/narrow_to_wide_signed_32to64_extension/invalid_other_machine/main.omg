// Fact: sign-extending a bounded 32-bit signed i32 value (narrow >= 70000i32 && narrow <= 90000i32) to i64 (narrow as i64) preserves the exact interval (wide >= 70000i64 && wide <= 90000i64), discharging exact 64-bit signed subtractions 90000i64 - wide and wide - 70000i64 across all nine places.
// Place: another machine (invalid twin). Narrow bound is widened to 90001i32, causing contract verification for forward_wide to fail closed.
// Expected diagnostic: cannot prove requires contract for call forward_wide

machine verify_wide(wide: i64) -> i32 requires wide >= 70000i64 && wide <= 90000i64 {
    let headroom: i64 = 90000i64 - wide;
    let margin: i64 = wide - 70000i64;
    let sum: i64 = headroom + margin;
    let check: i64 = sum - 20000i64;
    check as i32
}

machine forward_wide(wide: i64) -> i32
requires wide >= 70000 && wide <= 90000
{
    verify_wide(wide)
}

machine ext_machine(narrow: i32) -> i32
requires narrow >= 70000 && narrow <= 90001
{
    let wide: i64 = narrow as i64;
    forward_wide(wide)
}

machine probe() -> i32 {
    ext_machine(80000i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
