// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0
machine main() crashes Trap {
    let mut items: [u64; 2] = [7, 1];
    let saved: u64 = items[0];
    items[1] = 4;
    transition { _ -> check(saved, items[0]) }
    state check(observed: u64, current: u64)
    requires observed == current && observed == 7
    {
        transition observed == 7 { true -> done() _ -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}
