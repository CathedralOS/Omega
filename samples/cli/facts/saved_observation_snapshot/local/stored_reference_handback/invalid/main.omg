// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0

data Holder { before: u64; items: &mut [u64; 2]; after: u64; }
machine kept(values: &[u64; 2]) -> bool { values[0] == 7 }
machine preserve(holder: &mut Holder)
requires kept(&holder.items) == true
ensures kept(&holder.items) == true
{
    let mut copied: [u64; 2] = holder.items;
    copied[0] = 4;
    holder.items[0] = copied[0];
}
machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
ensures result == observed
{ observed }
machine main() crashes Trap {
    let mut items: [u64; 2] = [7, 1];
    let mut holder: Holder = Holder { before: 11, items: &mut items, after: 13 };
    let saved: u64 = holder.items[0];
    preserve(&mut holder);
    transition agree(saved, holder.items[0]) == 7 && holder.items[0] == 7 && holder.items[1] == 4 && holder.before == 11 && holder.after == 13 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
