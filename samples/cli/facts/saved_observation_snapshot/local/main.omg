// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0
machine capture<'source, View>(source: View, marker: @mutable u64, event: u64) -> View requires View == @'source u64 { $marker = event; source }

machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine main() crashes Trap {
    let mutable marker: u64 = 0;
    let mutable items: [u64; 2] = [7, 1];
    let saved: u64 = capture::<@u64>(@items[0], @mutable marker, 11);
    items[1] = 4;
    transition agree(saved, items[0]) == 7 && items[1] == 4 && marker == 11 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
