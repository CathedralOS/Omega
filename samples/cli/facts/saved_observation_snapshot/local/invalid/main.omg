// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// This twin writes the observed element, so the observation is no longer valid.
machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine main() crashes Trap {
    let mut items: [u64; 2] = [7, 1];
    let saved: u64 = items[0];
    items[0] = 4;
    transition agree(saved, items[0]) == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
