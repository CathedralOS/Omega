// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// This twin writes the observed element, so the observation is no longer valid.
machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

linux_x86_64 machine observe(items: &mut [u64; 2]) -> u64
requires items[0] == 7
{
    let saved: u64 = items[0];
    items[0] = 4;
    agree(saved, items[0])
}
linux_arm64 machine observe(items: &mut [u64; 2]) -> u64
requires items[0] == 7
{
    let saved: u64 = items[0];
    items[0] = 4;
    agree(saved, items[0])
}
macos_arm64 machine observe(items: &mut [u64; 2]) -> u64
requires items[0] == 7
{
    let saved: u64 = items[0];
    items[0] = 4;
    agree(saved, items[0])
}
windows_x86_64 machine observe(items: &mut [u64; 2]) -> u64
requires items[0] == 7
{
    let saved: u64 = items[0];
    items[0] = 4;
    agree(saved, items[0])
}

machine main() crashes Trap {
    let mut items: [u64; 2] = [7, 1];
    transition observe(&mut items) == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
