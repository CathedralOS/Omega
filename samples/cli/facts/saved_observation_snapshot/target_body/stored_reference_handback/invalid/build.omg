machine build(builder: &mut Build) {
    Build::application(builder, "saved_observation_snapshot_stored_reference_handback_target_body");
    Build::select_provider<HostedObservation, HostedObservationBody>(builder, linux_x86_64);
    Build::select_provider<HostedObservation, HostedObservationBody>(builder, linux_arm64);
    Build::select_provider<HostedObservation, HostedObservationBody>(builder, macos_arm64);
    Build::select_provider<HostedObservation, HostedObservationBody>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
