// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0
machine capture<'source, View>(source: View, marker: @mutable u64, event: u64) -> View requires View == @'source u64 { $marker = event; source }

machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine probe(select: bool, marker: @mutable u64) -> u64 {
    let mutable items: [u64; 2] = [7, 1];
    let saved: u64 = match select {
        true -> capture::<@u64>(@items[0], marker, 11),
        false -> capture::<@u64>(@items[0], marker, 13)
    };
    items[1] = 4;
    let result: u64 = agree(saved, items[0]);
    transition items[1] == 4 { true -> result, false -> 777 }
}
machine main() crashes Trap {
    let mutable marker: u64 = 0;
    let first: u64 = probe(true, @mutable marker);
    let first_trace: bool = marker == 11;
    let second: u64 = probe(false, @mutable marker);
    transition first == 7 && second == 7 && first_trace && marker == 13 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
