// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0
machine capture<'source>(source: &'source mut u64, marker: &mut u64, event: u64) -> &'source mut u64
ensures source == 7
{ source = 7; marker = event; source }

machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine probe(select: bool, marker: &mut u64) -> u64 {
    let mut items: [u64; 2] = [3, 1];
    let saved: u64 = match select {
        true -> capture(&mut items[0], marker, 11)
        false -> 7
    };
    items[1] = 4;
    let result: u64 = agree(saved, items[0]);
    transition items[1] == 4 { true -> result false -> 777 }
}
machine main() crashes Trap {
    let mut marker: u64 = 0;
    let first: u64 = probe(true, &mut marker);
    let first_trace: bool = marker == 11;
    let second: u64 = probe(false, &mut marker);
    transition first == 7 && second == 7 && first_trace && marker == 13 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
