// A case binding uses the checked type and live facts without a runtime branch.
// Expected exit: 0
data Sum [copy] { case Ready(payload: u64); }
machine inspect(value: Sum) -> bool  {
    let Sum::Ready { payload } = value;
    payload == 17
}
machine main() crashes Trap {
    transition inspect(Sum::Ready { payload: 17 }) { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
