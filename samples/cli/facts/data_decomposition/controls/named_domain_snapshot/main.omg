// A data binding retains the producer's equality between two u64 fields so subtracting the lower binding from the upper binding is exact.
// Expected exit: 0
data Pair [copy]
requires (self in Pair::Ready) || (self in Pair::Empty)
{ lower: u64; case Ready(upper: u64); case Empty; }
domain Pair::Equal requires (self in Pair::Ready && self.lower == self.upper) || (self in Pair::Empty && self.lower == 0);
machine bind_components(mut pair: Pair in Equal, expected: u64) -> bool {
    let Pair { lower as low, case as operation } = pair;
    pair = Pair::Ready { lower: 99, upper: 99 };
    match operation {
        Pair::Ready { upper as high } -> (high - low) == 0 && low == expected && high == expected && pair.lower == 99
        Pair::Empty -> false
    }
}
machine produce(value: u64) -> Pair in Equal { Pair::Ready { lower: value, upper: value } }
machine exercise(expected: u64) -> bool {
    let original: Pair in Equal = produce(expected);
    let pair: Pair in Equal = original;
    bind_components(pair, expected)
}
machine main() crashes Trap {
    transition exercise(17) && exercise(23) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
