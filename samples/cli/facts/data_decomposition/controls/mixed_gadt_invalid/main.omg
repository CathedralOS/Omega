// A mixed case view retains its exact generic subject and default-domain type equalities.
// Expected: reject after removing the type equality excluding Integer on Value<bool>.

data Value<T> [copy]
requires ((self in Value::Integer)) || ((self in Value::Boolean) && T == bool)
{ request: u64; enabled: bool; case Integer(value: i32); case Boolean(value: bool); }
machine extract<T>(formed: Value<T>) -> T {
    let Value { request as _, enabled as _, case as operation } = formed;
    match operation {
        Value::Integer { value } -> value
        Value::Boolean { value } -> value
    }
}
machine inspect(formed: &Value<bool>) -> bool {
    let Value { request as identifier, enabled as active, case as operation } = formed;
    match operation { Value::Boolean { value as answer } -> active && identifier == 17 && answer }
}
machine main() crashes Trap {
    let formed: Value<bool> = Value::Boolean { request: 17, enabled: true, value: true };
    let integer: Value<i32> = Value::Integer { request: 23, enabled: true, value: 42 };
    transition inspect(&formed) && extract<bool>(formed) && extract<i32>(integer) == 42 {
        true -> done() _ -> bad()
    }
    machine done() {} machine bad() { crash Trap; }
}
