// A data binding retains the producer's equality between two u64 fields so subtracting the lower binding from the upper binding is exact.
// Expected exit: 0
data Pair [copy] requires self.lower == self.upper { lower: u64; case Ready(upper: u64); }
machine produce(value: u64) -> Pair { Pair::Ready { lower: value, upper: value } }
machine carry(pair: Pair, expected: u64) -> bool {
    transition { _ -> consume(pair, expected) }
    machine consume(pair: Pair, expected: u64) -> bool {
        let Pair { lower as low, case as operation } = pair;
    let Pair::Ready { upper as high } = operation;
        let difference: u64 = high - low;
        difference == 0 && low == expected && high == expected
    }
}
machine exercise(expected: u64) -> bool { carry(produce(expected), expected) }
machine main() crashes Trap {
    transition exercise(17) && exercise(23) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
