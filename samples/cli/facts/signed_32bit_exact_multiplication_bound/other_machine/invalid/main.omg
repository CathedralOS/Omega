// Fact: a 32-bit signed i32 exact multiplication of bounded inputs (lhs >= 15i32 && lhs <= 25i32, rhs >= 10i32 && rhs <= 20i32) establishes prod >= 150i32 && prod <= 500i32 so exact 32-bit signed subtraction 500i32 - prod is proved overflow-free across all nine places.
// Place: another machine (invalid twin).

machine compute_prod(lhs: i32, rhs: i32) -> i32
requires lhs >= 15i32 && lhs <= 25i32
    && rhs >= 10i32 && rhs <= 21i32
ensures result >= 150i32 && result <= 525i32
{
    lhs * rhs
}

machine verify_prod(prod: i32) -> i32 crashes Trap
requires prod >= 150i32 && prod <= 500i32
ensures result == 0i32
{
    let headroom: i32 = 500i32 - prod;
    transition headroom == 200i32 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

machine forward(prod: i32) -> i32 crashes Trap
requires prod >= 150i32 && prod <= 500i32
ensures result == 0i32
{
    verify_prod(prod)
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    let prod: i32 = compute_prod(25, 21);
    forward(prod)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
