// Fact: a 32-bit signed i32 exact multiplication of bounded inputs (lhs >= 15i32 && lhs <= 25i32, rhs >= 10i32 && rhs <= 20i32) establishes prod >= 150i32 && prod <= 500i32 so exact 32-bit signed subtraction 500i32 - prod is proved overflow-free across all nine places.
// Place: another target body (invalid twin).

machine compute_prod(lhs: i32, rhs: i32) -> i32
requires lhs >= 15i32 && lhs <= 25i32
    && rhs >= 10i32 && rhs <= 21i32
ensures result >= 150i32 && result <= 525i32
{
    lhs * rhs
}

machine verify_prod(prod: i32) -> i32 crashes Trap
requires prod >= 150i32 && prod <= 500i32
ensures result == 0i32
{
    let headroom: i32 = 500i32 - prod;
    transition headroom == 200i32 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEvaluateProd {
    machine evaluate_prod() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 0i32;
}

X86EvaluateProd satisfies SelectedEvaluateProd {
    machine evaluate_prod() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 0i32
    {
        SelectedBodyCheck::require_tag(17u64);
        let prod: i32 = compute_prod(25, 21);
        verify_prod(prod)
    }
}

ArmEvaluateProd satisfies SelectedEvaluateProd {
    machine evaluate_prod() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 0i32
    {
        SelectedBodyCheck::require_tag(29u64);
        let prod: i32 = compute_prod(25, 21);
        verify_prod(prod)
    }
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    SelectedEvaluateProd::evaluate_prod()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
