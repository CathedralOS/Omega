// Replacing one input-carrier reference retains its new backing and the untouched sibling.
// Place: target_body.
// Expected exit: 0
data Cell { value: i64; }
data Views<'storage> { first: &'storage Cell; second: &'storage Cell; }
data Bundle<'storage> { entries: [Views<'storage>; 1]; }

machine observe<'storage>(bundle: &Bundle<'storage>) -> bool {
    bundle.entries[0].first.value == 41 && bundle.entries[0].second.value == 19
}

machine change<'storage>(bundle: &mut Bundle<'storage>, intermediate: &'storage Cell, incoming: &'storage Cell) -> &'storage Cell {
    bundle.entries[0].first = intermediate;
    incoming
}

machine replace<'storage>(mut bundle: Bundle<'storage>, intermediate: &'storage Cell, incoming: &'storage Cell) -> bool {
    bundle.entries[0].first = change(&mut bundle, intermediate, incoming);
    observe(&bundle)
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTransport {
    machine transport<'storage>(bundle: Bundle<'storage>) -> Bundle<'storage>
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Transport satisfies SelectedTransport {
    machine transport<'storage>(bundle: Bundle<'storage>) -> Bundle<'storage>
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     bundle 
    }
}

ArmTransport satisfies SelectedTransport {
    machine transport<'storage>(bundle: Bundle<'storage>) -> Bundle<'storage>
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     bundle 
    }
}

machine main() crashes Trap {
    let old: Cell = Cell { value: 17 };
    let intermediate: Cell = Cell { value: 31 };
    let new: Cell = Cell { value: 41 };
    let sibling: Cell = Cell { value: 19 };
    let bundle: Bundle = Bundle { entries: [Views { first: &old, second: &sibling }] };
    let selected: Bundle = SelectedTransport::transport(bundle);
    let replaced: bool = replace(selected, &intermediate, &new);
    transition replaced && old.value == 17 && sibling.value == 19 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
