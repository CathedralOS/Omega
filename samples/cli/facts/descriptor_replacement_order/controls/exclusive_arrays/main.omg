// Exclusive descriptor arrays retain access, not copy permission.
// Materialize both arrays; catalog inspection checks their copy authority.
// Expected exit: 0
data Cell { value: i64; }
machine main() crashes Trap {
    let mut backing: Cell = Cell { value: 17 };
    let references: [&mut Cell; 1] = [&mut backing];
    let mut bytes: [u8; 1] = [19];
    let windows: [&mut [u8]; 1] = [&mut bytes[..]];
    let observed: bool = references[0].value == 17;
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
