// Replacing one input-carrier reference retains its new backing and the untouched sibling.
// Expected exit: 0
data Cell { value: i64; }
data Views<'storage> [copy] { first: &'storage Cell; second: &'storage Cell; }
data Bundle<'storage> [copy] { entries: [Views<'storage>; 1]; }

machine observe<'storage>(bundle: &Bundle<'storage>) -> bool {
    bundle.entries[0].first.value == 41 && bundle.entries[0].second.value == 19
}

machine change<'storage>(bundle: &mut Bundle<'storage>, intermediate: &'storage Cell, incoming: &'storage Cell) -> &'storage Cell {
    bundle.entries[0].first = intermediate;
    incoming
}

machine replace<'storage>(mut bundle: Bundle<'storage>, intermediate: &'storage Cell, incoming: &'storage Cell) -> bool {
    let copied: Bundle = bundle;
    let old_descriptor: &Cell = bundle.entries[0].first;
    let middle_descriptor: &Cell = intermediate;
    bundle.entries[0].first = change(&mut bundle, intermediate, incoming);
    observe(&bundle) && copied.entries[0].first.value == 17 && old_descriptor.value == 17 && middle_descriptor.value == 31
}

machine inspect(owners: &[Bundle; 1]) -> i64 { owners[0].entries[0].first.value }
machine keep<'storage>(owners: [Bundle<'storage>; 1]) -> [Bundle<'storage>; 1] { owners }

machine main() crashes Trap {
    let old: Cell = Cell { value: 17 };
    let intermediate: Cell = Cell { value: 31 };
    let new: Cell = Cell { value: 41 };
    let sibling: Cell = Cell { value: 19 };
    let bundle: Bundle = Bundle { entries: [Views { first: &old, second: &sibling }] };
    let owners: [Bundle; 1] = keep([bundle]);
    let original: i64 = inspect(&owners);
    let supplied: Bundle = owners[0];
    let replaced: bool = replace(supplied, &intermediate, &new);
    transition replaced && original == 17 && owners[0].entries[0].first.value == 17 && old.value == 17 && sibling.value == 19 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
