// Expected exit: 0
data Cell { value: u32; }
data View<'a> { cell: &'a Cell in Controlled; }
domain Cell::Controlled(cell) requires cell.value >= 10;
machine inspect(cell: &Cell) -> u32 { cell.value }
machine authorized_read(cell: &Cell in Controlled) -> u32 { cell.value }
machine observed_exit() -> u32 {
    let storage: Cell = Cell { value: 73 };
    let replacement: Cell = Cell { value: 1 };
    let mut protected: View = View { cell: &storage };
    protected.cell = &replacement;
    let observed: u32 = inspect(&storage);
    let final_value: u32 = authorized_read(protected.cell);
    observed
}
machine main() crashes Trap {
    transition observed_exit() == 73 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
