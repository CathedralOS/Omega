// Fact: a 3-level nested structural record Outer { mid: Middle { inner: Inner { val: u64 } } } preserves the leaf field bound 40u64 <= outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: another target body (invalid twin). The target-scoped bodies widen leaf upper bound to 81u64 so res reaches 81u64, underflowing 80u64 - res.
// Expected diagnostic: may overflow `u64`

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedCheckTarget {
    machine check_target(outer: Outer) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires outer.mid.inner.val >= 40 && outer.mid.inner.val <= 81;
}

X86CheckTarget satisfies SelectedCheckTarget {
    machine check_target(outer: Outer) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires outer.mid.inner.val >= 40 && outer.mid.inner.val <= 81
    {
        SelectedBodyCheck::require_tag(17u64);
        let res: u64 = outer.mid.inner.val;
        let headroom: u64 = 80u64 - res;
        let margin: u64 = res - 40u64;
        headroom + margin
    }
}

ArmCheckTarget satisfies SelectedCheckTarget {
    machine check_target(outer: Outer) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires outer.mid.inner.val >= 40 && outer.mid.inner.val <= 81
    {
        SelectedBodyCheck::require_tag(29u64);
        let res: u64 = outer.mid.inner.val;
        let headroom: u64 = 80u64 - res;
        let margin: u64 = res - 40u64;
        headroom + margin
    }
}

machine probe() -> u64 {
    let outer: Outer = Outer {
        mid: Middle {
            inner: Inner {
                val: 60u64,
            },
        },
    };
    SelectedCheckTarget::check_target(outer)
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
