// Fact: an 8-bit unsigned u8 remainder operation (dividend % divisor where divisor >= 16u8 && divisor <= 16u8) establishes rem <= 15u8 so exact 8-bit subtraction 15u8 - rem is proved underflow-free across all nine places.

machine choose(flag: bool, first: u8, second: u8) -> u8
    requires first <= 15u8 && second <= 15u8
    ensures result <= 15u8
{
    transition flag {
        true -> first
        false -> second
    }
}

machine probe(flag: bool, dividend: u8, divisor: u8) -> u8
    requires divisor >= 16u8 && divisor <= 17u8
{
    let rem: u8 = dividend % divisor;
    let joined: u8 = choose(flag, rem, 10u8);
    let headroom: u8 = 15u8 - joined;
    headroom
}

machine main() crashes Trap {
    let headroom: u8 = probe(true, 43u8, 16u8);
    transition headroom == 4u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
