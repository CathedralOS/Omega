// Fact: an 8-bit unsigned u8 remainder operation (dividend % divisor where divisor >= 16u8 && divisor <= 16u8) establishes rem <= 15u8 so exact 8-bit subtraction 15u8 - rem is proved underflow-free across all nine places.
// Expected exit: 0

linux_x86_64 machine target_probe(dividend: u8, divisor: u8) -> u8
    requires divisor >= 16u8 && divisor <= 16u8
{
    let rem: u8 = dividend % divisor;
    let headroom: u8 = 15u8 - rem;
    headroom
}

linux_arm64 machine target_probe(dividend: u8, divisor: u8) -> u8
    requires divisor >= 16u8 && divisor <= 16u8
{
    let rem: u8 = dividend % divisor;
    let headroom: u8 = 15u8 - rem;
    headroom
}

macos_arm64 machine target_probe(dividend: u8, divisor: u8) -> u8
    requires divisor >= 16u8 && divisor <= 16u8
{
    let rem: u8 = dividend % divisor;
    let headroom: u8 = 15u8 - rem;
    headroom
}

windows_x86_64 machine target_probe(dividend: u8, divisor: u8) -> u8
    requires divisor >= 16u8 && divisor <= 16u8
{
    let rem: u8 = dividend % divisor;
    let headroom: u8 = 15u8 - rem;
    headroom
}

machine probe(dividend: u8, divisor: u8) -> u8
    requires divisor >= 16u8 && divisor <= 16u8
{
    target_probe(dividend, divisor)
}

machine main() crashes Trap {
    let headroom: u8 = probe(43u8, 16u8);
    transition headroom == 4u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
