// Fact: sign-extending a bounded 16-bit signed i16 value (narrow >= 300i16 && narrow <= 500i16) to i32 (narrow as i32) preserves the exact interval (wide >= 300i32 && wide <= 500i32), discharging exact 32-bit signed subtractions 500i32 - wide and wide - 300i32 across all nine places.
// Expected exit: 0

machine verify_wide(wide: i32) -> i32
requires wide >= 300i32 && wide <= 500i32
{
    let sub_hi: i32 = 500i32 - wide;
    let sub_lo: i32 = wide - 300i32;
    transition sub_hi == 100i32 && sub_lo == 100i32 {
        true -> 0i32
        _ -> 1i32
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(narrow: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires narrow >= 300i16 && narrow <= 500i16;
}

X86Probe satisfies SelectedProbe {
    machine exercise(narrow: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires narrow >= 300i16 && narrow <= 500i16
    {
        SelectedBodyCheck::require_tag(17u64);
        let wide: i32 = narrow as i32;
        verify_wide(wide)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(narrow: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires narrow >= 300i16 && narrow <= 500i16
    {
        SelectedBodyCheck::require_tag(29u64);
        let wide: i32 = narrow as i32;
        verify_wide(wide)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let exit_code: i32 = SelectedProbe::exercise(400i16);
    transition exit_code == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
