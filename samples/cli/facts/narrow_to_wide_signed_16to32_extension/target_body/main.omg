// Fact: sign-extending a bounded 16-bit signed i16 value (narrow >= 300i16 && narrow <= 500i16) to i32 (narrow as i32) preserves the exact interval (wide >= 300i32 && wide <= 500i32), discharging exact 32-bit signed subtractions 500i32 - wide and wide - 300i32 across all nine places.
// Expected exit: 0

machine verify_wide(wide: i32) -> i32
requires wide >= 300i32 && wide <= 500i32
{
    let sub_hi: i32 = 500i32 - wide;
    let sub_lo: i32 = wide - 300i32;
    transition sub_hi == 100i32 && sub_lo == 100i32 {
        true -> 0i32
        _ -> 1i32
    }
}

linux_x86_64 machine exercise(narrow: i16) -> i32
requires narrow >= 300i16 && narrow <= 500i16
{
    let wide: i32 = narrow as i32;
    verify_wide(wide)
}

linux_arm64 machine exercise(narrow: i16) -> i32
requires narrow >= 300i16 && narrow <= 500i16
{
    let wide: i32 = narrow as i32;
    verify_wide(wide)
}

macos_arm64 machine exercise(narrow: i16) -> i32
requires narrow >= 300i16 && narrow <= 500i16
{
    let wide: i32 = narrow as i32;
    verify_wide(wide)
}

windows_x86_64 machine exercise(narrow: i16) -> i32
requires narrow >= 300i16 && narrow <= 500i16
{
    let wide: i32 = narrow as i32;
    verify_wide(wide)
}

machine main() crashes Trap {
    let exit_code: i32 = exercise(400i16);
    transition exit_code == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
