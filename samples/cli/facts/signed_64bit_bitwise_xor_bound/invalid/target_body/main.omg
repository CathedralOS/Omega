// Fact: 64-bit signed bitwise XOR raw ^ 15i64 with bounded interval 40i64 <= xored <= 63i64 establishes 40i64 <= xored <= 63i64 across all nine places so exact subtractions 63i64 - xored and xored - 40i64 are safe.
// Place: target_body. Each hosted target body computes the 64-bit signed bitwise XOR and verifies the bounds.
// Expected exit: 0
machine verify_xored(res: i64) -> i32
    requires res >= 40 && res <= 63
{
    let head: i64 = 63 - res;
    let tail: i64 = res - 40;
    let sum: i64 = head + tail;
    let diff: i64 = sum - 23;
    diff as i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedComputeTargetBody {
    machine compute_target_body(raw: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 64 && raw <= 64;
}

X86ComputeTargetBody satisfies SelectedComputeTargetBody {
    machine compute_target_body(raw: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 64 && raw <= 64
    {
        SelectedBodyCheck::require_tag(17u64);
        let xored: i64 = raw ^ 15;
        verify_xored(xored)
    }
}

ArmComputeTargetBody satisfies SelectedComputeTargetBody {
    machine compute_target_body(raw: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 64 && raw <= 64
    {
        SelectedBodyCheck::require_tag(29u64);
        let xored: i64 = raw ^ 15;
        verify_xored(xored)
    }
}

machine evaluate() -> i32 {
    SelectedComputeTargetBody::compute_target_body(64)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
