// Expected exit: 0
// Checked semantic copy of a closed copyable Inert carrier preserves libc host 66051 on the retained original and on the component input, and preserves sibling host 513.
use producer::main;

machine main() reaches AddressParts, AddressBridge crashes Trap {
    transition { _ -> receive(AddressBridge::make(10, 66051)) }
    state receive(original: InternetAddress) {
        let sent: InternetAddress = original;
        let sibling: InternetAddress = AddressBridge::make(44048, 513);
        let original_host: u32 = AddressBridge::host(original);
        let sent_host: u32 = AddressBridge::host(sent);
        let sibling_host: u32 = AddressBridge::host(sibling);
        transition original_host == 66051 && sent_host == 66051 && sibling_host == 513 { true -> done() _ -> failed() }
    }
    state done() {}
    state failed() { crash Trap; }
}
