// Fact: an 8-bit signed i8 arithmetic right shift of a bounded input (val >= 100i8 && val <= 100i8) by 2u32 bits establishes shifted >= 25i8 && shifted <= 25i8 so exact 8-bit signed subtraction shifted - 25i8 is proved overflow-free across all nine places.
// Invalid: widening input val <= 104i8 allows forwarded 26i8, violating forward contract. Place: other_machine.
// Expected diagnostic: cannot prove requires contract for call forward

machine verify_shifted(shifted: i8) -> i32
requires shifted >= 25i8 && shifted <= 25i8
{
    let check: i8 = shifted - 25i8;
    0i32
}

machine forward(shifted: i8) -> i32
requires shifted >= 25i8 && shifted <= 25i8
{
    verify_shifted(shifted)
}

machine compute_forward(val: i8, shift: u32) -> i32
requires val >= 100i8 && val <= 104i8 && shift == 2u32
{
    forward(val >> shift)
}

machine probe() -> i32 {
    compute_forward(104i8, 2u32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
