// Fact: an 8-bit signed i8 arithmetic right shift of a bounded input (val >= 100i8 && val <= 100i8) by 2u32 bits establishes shifted >= 25i8 && shifted <= 25i8 so exact 8-bit signed subtraction shifted - 25i8 is proved overflow-free across all nine places.
// Place: parameter. The shifted result is passed as an explicit machine parameter.
// Expected exit: 0

machine verify_parameter(shifted: i8) -> i32
requires shifted >= 25i8 && shifted <= 25i8
{
    let check: i8 = shifted - 25i8;
    0i32
}

machine compute_param(val: i8, shift: u32) -> i32
requires val >= 100i8 && val <= 100i8 && shift == 2u32
{
    verify_parameter(val >> shift)
}

machine probe() -> i32 {
    compute_param(100i8, 2u32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
