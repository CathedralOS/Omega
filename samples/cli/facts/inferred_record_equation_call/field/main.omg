// Fact: an omitted Setting is inferred from the exact record-valued Token index and consumed as Setting.minimum.
// Expected exit: 0
data Configuration [copy] { minimum: u64; }
const SEVEN: Configuration = Configuration { minimum: 7 };
const EIGHT: Configuration = Configuration { minimum: 8 };
data Token<const Setting: Configuration> [copy] { marker: u8; }
data Packet { items: Token<SEVEN>; }
machine read<Item [copy], const Setting: Configuration>(items: Item) -> u64
where Item == Token<Setting>
{ Setting.minimum }
machine main() crashes Trap {
    let packet: Packet = Packet { items: Token { marker: 1 } };
    let observed: u64 = read(packet.items);
    transition observed == 7 { true -> done() _ -> bad() }
    state done() {} state bad() { crash Trap; }
}
