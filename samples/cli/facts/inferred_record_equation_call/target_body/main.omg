// Fact: an omitted Setting is inferred from the exact record-valued Token index and consumed as Setting.minimum.
// Expected exit: 0
data Configuration [copy] { minimum: u64; }
const SEVEN: Configuration = Configuration { minimum: 7 };
const EIGHT: Configuration = Configuration { minimum: 8 };
data Token<const Setting: Configuration> [copy] { marker: u8; }
machine read<Item [copy], const Setting: Configuration>(items: Item) -> u64
where Item == Token<Setting>
{ Setting.minimum }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedConsume {
    machine consume(items: Token<SEVEN>) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Consume satisfies SelectedConsume {
    machine consume(items: Token<SEVEN>) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     read(items) 
    }
}

ArmConsume satisfies SelectedConsume {
    machine consume(items: Token<SEVEN>) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     read(items) 
    }
}


machine main() crashes Trap {
    let items: Token<SEVEN> = Token { marker: 1 };
    let observed: u64 = SelectedConsume::consume(items);
    transition observed == 7 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
