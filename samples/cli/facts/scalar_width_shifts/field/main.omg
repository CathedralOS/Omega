// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: field. Bounded record fields carry the Wrapping u32 value and shift count into the shift.
// Expected exit: 0
data ShiftPayload where shift < 4 {
    val: u32 in Wrapping;
    shift: u32;
}

machine shift_round_trip(payload: ShiftPayload) -> u32 in Wrapping {
    let shifted: u32 in Wrapping = payload.val << payload.shift;
    shifted >> payload.shift
}

machine probe(val: u32 in Wrapping, shift: u32) -> u32 in Wrapping
    requires shift < 4
{
    let payload: ShiftPayload = ShiftPayload { val: val, shift: shift };
    shift_round_trip(payload)
}

machine main() crashes Trap {
    let val: u32 in Wrapping = 21 as u32 in Wrapping;
    let shift: u32 = 1;
    let recovered: u32 in Wrapping = probe(val, shift);
    let shifted: u32 in Wrapping = val << shift;
    transition (shifted as u32) == 42 && (recovered as u32) == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
