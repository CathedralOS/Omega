// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: match join (invalid twin). Plain u32 match arms without in Wrapping do not prove an exact shift.
machine shift_round_trip(val: u32, alt_val: u32, shift: u32, flag: bool) -> u32
    requires shift < 4
{
    let v: u32 = match flag { true -> val, false -> alt_val };
    let s: u32 = match flag { true -> shift, false -> shift };
    let shifted: u32 = v << s;
    shifted >> s
}

machine probe(val: u32, shift: u32) -> u32
    requires shift < 4
{
    shift_round_trip(val, val, shift, true)
}

machine main() crashes Trap {
    let val: u32 = 21;
    let shift: u32 = 1;
    let recovered: u32 = probe(val, shift);
    let shifted: u32 = val << shift;
    transition shifted == 42 && recovered == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
