// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: const name (invalid twin). Plain u32 value shifted by named constant without in Wrapping may overflow.
const SHIFT: u32 = 1;

machine shift_round_trip(val: u32) -> u32 {
    let shifted: u32 = val << SHIFT;
    shifted >> SHIFT
}

machine probe(val: u32) -> u32 {
    shift_round_trip(val)
}

machine main() crashes Trap {
    let val: u32 = 21;
    let recovered: u32 = probe(val);
    let shifted: u32 = val << SHIFT;
    transition shifted == 42 && recovered == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
