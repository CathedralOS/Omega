// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Expected exit: 0

machine shift_round_trip(val: u32 in Wrapping, shift: u32) -> u32 in Wrapping
    requires shift < 4
{
    let shifted: u32 in Wrapping = val << shift;
    shifted >> shift
}

data ShiftState where shift < 4 {
    val: u32 in Wrapping;
    shift: u32;
}

machine compute(val: u32 in Wrapping, shift: u32) -> u32 in Wrapping
    requires shift < 4
{
    let payload: ShiftState = ShiftState { val: val, shift: shift };
    let shifted: u32 in Wrapping = payload.val << payload.shift;
    let recovered: u32 in Wrapping = shift_round_trip(payload.val, payload.shift);
    transition (shifted as u32) == 42 && (recovered as u32) == 21 {
        true -> recovered
        _ -> 0 as u32 in Wrapping
    }
}

machine main() crashes Trap {
    let val: u32 in Wrapping = 21 as u32 in Wrapping;
    let shift: u32 = 1;
    let result: u32 in Wrapping = compute(val, shift);
    transition (result as u32) == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
