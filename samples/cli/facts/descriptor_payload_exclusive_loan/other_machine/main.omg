// A match on one evaluation of a copyable flag returns the exclusive loan of the selected case payload's descriptor, writes 41 through that loan, and leaves the unselected descriptor unchanged.
// Place: other_machine.
// Expected exit: 0
data Slot { case Absent; case Present(value: [i64; 2]); }

machine choose(counter: @mutable u64) -> bool
requires $counter == 0
{
    $counter = 1;
    true
}

machine apply(chosen: @mutable Slot, other: @mutable Slot, visits: @mutable u64) -> i64
requires chosen in Slot::Present, other in Slot::Present, $visits == 0
{
    let selected: @mutable [i64] = match choose(visits) {
        true -> @mutable chosen.value[..],
        false -> @mutable other.value[..]
    };
    selected[0] = 41;
    selected[0]
}

machine forward(chosen: @mutable Slot, other: @mutable Slot, visits: @mutable u64) -> i64
requires chosen in Slot::Present, other in Slot::Present, $visits == 0
{
    apply(chosen, other, visits)
}

machine main() crashes Trap {
    let mutable chosen: Slot = Slot::Present { value: [17, 0] };
    let mutable other: Slot = Slot::Present { value: [0, 0] };
    let mutable visits: u64 = 0;
    let observed: i64 = forward(@mutable chosen, @mutable other, @mutable visits);
    transition observed == 41 && visits == 1 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
