// Fact: 8-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 40u8 <= prod <= 150u8 establishes 40u8 <= prod <= 150u8 across all nine places so exact subtractions 150u8 - prod and prod - 40u8 are safe.
// Expected exit: 0

machine verify_prod(prod: u8) -> i32
    requires prod >= 40 && prod <= 150
{
    let headroom: u8 = 150 - prod;
    let margin: u8 = prod - 40;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 110;
    check
}

machine produce_prod(lhs: u8 in Wrapping, rhs: u8 in Wrapping) -> u8
    requires lhs as u8 >= 8 && lhs as u8 <= 15, rhs as u8 >= 5 && rhs as u8 <= 10
    ensures result >= 40 && result <= 150
{
    let wrapped: u8 in Wrapping = lhs * rhs;
    wrapped as u8
}

machine main() crashes Trap {
    let lhs: u8 in Wrapping = 12;
    let rhs: u8 in Wrapping = 8;
    let prod: u8 = produce_prod(lhs, rhs);
    let check: i32 = verify_prod(prod);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
