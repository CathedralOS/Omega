// Fact: 8-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 40u8 <= prod <= 150u8 establishes 40u8 <= prod <= 150u8 across all nine places so exact subtractions 150u8 - prod and prod - 40u8 are safe.
// Invalid: widened lhs produces product of 160u8, failing verify_prod requires contract.

machine compute_wrap(lhs: u8 in Wrapping, rhs: u8 in Wrapping) -> u8 in Wrapping {
    lhs * rhs
}

machine verify_prod(prod: u8) -> i32
    requires prod >= 40 && prod <= 150
{
    let headroom: u8 = 150 - prod;
    let margin: u8 = prod - 40;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 110;
    check
}

machine main() crashes Trap {
    let lhs: u8 in Wrapping = 16;
    let rhs: u8 in Wrapping = 10;
    let prod_wrapped: u8 in Wrapping = compute_wrap(lhs, rhs);
    let prod: u8 = prod_wrapped as u8;
    let local_prod: u8 = prod;
    let check: i32 = verify_prod(local_prod);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
