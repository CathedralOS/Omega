// A match join of two copies of a runtime window length still names the last byte.
// Expected exit: 0
machine last_byte(items: &[u8], count: u64, flag: bool) -> u8
requires count > 0 && count <= items.len
{
    let window: &[u8] = &items[0..count];
    let length: u64 = match flag { true -> window.len, false -> count };
    window[length - 1]
}
machine main() crashes Trap {
    let items: [u8; 4] = [4, 7, 8, 9];
    transition last_byte(&items[..], 3, true) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
