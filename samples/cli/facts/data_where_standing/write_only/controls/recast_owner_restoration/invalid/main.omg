// Reject a recast view that leaves its original owner outside the bound.
public data View [copy] { values: [i32; 3]; }
public data Outer [copy] requires self.values[1] <= 60 { values: [i32; 3]; }
public machine replace(outer: &mut Outer, replacement: i32)
requires replacement <= 60
{
    let view: &mut View = &mut outer.values as &mut View;
    view.values[1] = 61;
}
machine compute(outer: &Outer) -> i32 { 70 + outer.values[1] }
machine main() crashes Trap {
    let mut upper: Outer = Outer { values: [17, 0, 53] };
    let mut lower: Outer = Outer { values: [17, 0, 53] };
    replace(&mut upper, 60);
    replace(&mut lower, -2147483648);
    let high: i32 = compute(&upper);
    let low: i32 = compute(&lower);
    transition high == 130 && low == -2147483578 && upper.values[0] == 17 && upper.values[2] == 53 && lower.values[0] == 17 && lower.values[2] == 53 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
