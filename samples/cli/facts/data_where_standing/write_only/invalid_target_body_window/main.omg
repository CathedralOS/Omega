// Counter.cell.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected rejection: restore the record predicate before returning.
public data Cell [copy] { left: i32; value: i32; right: i32; }
public data Counter [copy] requires self.cell.value <= 60 && self.peer <= 60 { before: i32; cell: Cell; peer: i32; after: i32; }
public machine fill(counter: &write Counter, replacement: i32)
requires replacement <= 60
{
    counter.cell.value = 61;
}
machine produce(replacement: i32) -> Counter
requires replacement <= 60
{
    let mut counter: Counter = Counter { before: 31, cell: Cell { left: 17, value: 0, right: 53 }, peer: 13, after: 47 };
    let selected: &write Counter = &write counter;
    fill(&write selected, replacement);
    counter
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedCompute { machine compute(counter: &Counter) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap; }
X86Compute satisfies SelectedCompute { machine compute(counter: &Counter) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap { SelectedBodyCheck::require_tag(17u64); 70 + counter.cell.value } }
ArmCompute satisfies SelectedCompute { machine compute(counter: &Counter) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap { SelectedBodyCheck::require_tag(29u64); 70 + counter.cell.value } }
machine main() crashes Trap {
    let counter: Counter = produce(60);
    let low: Counter = produce(-2147483648);
    transition SelectedCompute::compute(&counter) == 130 && SelectedCompute::compute(&low) == -2147483578
        && counter.cell.left == 17 && counter.cell.right == 53 && counter.before == 31 && counter.peer == 13 && counter.after == 47
        && low.cell.left == 17 && low.cell.right == 53 && low.before == 31 && low.peer == 13 && low.after == 47 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap { SelectedBodyCheck::require_tag(17u64); main(); }
machine arm_entry() crashes Trap { SelectedBodyCheck::require_tag(29u64); main(); }
