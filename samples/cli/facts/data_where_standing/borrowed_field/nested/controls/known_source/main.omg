// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
public machine bounded(value: &i32) -> bool { value <= 60 }
public data Counter<'storage> [copy] requires bounded(self.value) == true { before: i32; value: &'storage i32; after: i32; marker: i32; }
machine read(value: &i32) -> i32 ensures result == value, { value }
public data Holder<'counter, 'storage> [copy] { prefix: i32; counter: &'counter Counter<'storage>; suffix: i32; }
public machine compute(backing: &i32) -> i32 requires backing <= 60, {
    let counter: Counter = Counter { before: 17, value: backing, after: 53, marker: 19 };
    let holder: Holder = Holder { prefix: 31, counter: &counter, suffix: 47 };
    let saved: &i32 = holder.counter.value;
    let value: i32 = read(saved);
    70 + value
}
machine main() crashes Trap {
    let high: i32 = 60;
    let low: i32 = -17;
    transition compute(&high) == 130 && compute(&low) == 53 && high == 60 && low == -17 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
