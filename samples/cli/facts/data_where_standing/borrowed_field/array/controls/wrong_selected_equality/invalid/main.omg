// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
public machine bounded(value: &i32) -> bool { value <= 60 }
public data Counter<'storage> [copy] requires bounded(self.value) == true { before: i32; value: &'storage i32; after: i32; marker: i32; }
machine read(value: &i32) -> i32 ensures result == value, { value }
public data Holder<'counter, 'storage> [copy] { prefix: i32; counters: [&'counter Counter<'storage>; 2]; suffix: i32; }
public machine selected_value(holder: &Holder, index: u64) -> i32
requires index < 2
ensures result == holder.counters[0].value
{
    let value: i32 = read(holder.counters[index].value);
    value
}
machine main() crashes Trap {
    let high: i32 = 60;
    let low: i32 = -17;
    let first: Counter = Counter { before: 17, value: &high, after: 53, marker: 19 };
    let second: Counter = Counter { before: 17, value: &low, after: 53, marker: 23 };
    let holder: Holder = Holder { prefix: 31, counters: [&first, &second], suffix: 47 };
    let observed: i32 = selected_value(&holder, 1);
    transition observed == -17 && high == 60 && low == -17
        && holder.prefix == 31 && holder.suffix == 47
        && first.before == 17 && first.after == 53 && first.marker == 19
        && second.before == 17 && second.after == 53 && second.marker == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
