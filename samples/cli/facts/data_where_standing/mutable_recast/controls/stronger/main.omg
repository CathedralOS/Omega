// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
machine bounded(value: i32) -> bool { value <= 60 && value != 13 }
data Storage [copy] where bounded(self.value) == true { before: i32; value: i32; after: i32; }
data Counter [copy] where self.value <= 60 { before: i32; value: i32; after: i32; }

machine compute(storage: &mut Storage) -> i32 {
    let counter: &mut Counter = storage as &mut Counter;
    let total: i32 = 70 + counter.value;
    let neighbors: bool = counter.before == 17 && counter.after == 53;
    counter.before = 23;
    transition neighbors { true -> total false -> -99 }
}
machine main() crashes Trap {
    let mut high: Storage = Storage { before: 17, value: 60, after: 53 };
    let mut low: Storage = Storage { before: 17, value: -2147483648, after: 53 };
    let upper: i32 = compute(&mut high);
    let lower: i32 = compute(&mut low);
    transition upper == 130 && lower == -2147483578 && high.before == 23 && low.before == 23 && high.after == 53 && low.after == 53 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
