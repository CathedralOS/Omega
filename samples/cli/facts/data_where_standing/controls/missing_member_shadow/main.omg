const missing: i32 = 0;
data Counter [copy] where self.value <= 60 && self.missing == 0 { value: i32; }
const NAMED: Counter = Counter { value: 60 };
public machine main() crashes Trap {
    transition NAMED.value == 60 { true -> done() false -> bad() }

    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
