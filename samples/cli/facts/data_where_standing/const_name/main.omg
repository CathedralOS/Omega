// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
data Counter [copy] requires self.value <= 60 { value: i32; }

machine replace(slot: @mutable i32, replacement: i32)
requires replacement <= 60
ensures $slot <= 60
{ $slot = replacement; }
machine produce(replacement: i32) -> Counter
requires replacement <= 60
{
    let mutable counter: Counter = Counter { value: 0 };
    replace(@mutable counter.value, replacement);
    counter
}

const LOW_COUNTER: Counter = produce(-2147483648);
const NAMED_COUNTER: Counter = produce(60);
machine compute<const COUNTER: Counter>() -> i32 { 70 + COUNTER.value }
machine main() crashes Trap {
    transition compute::<NAMED_COUNTER>() == 130 && compute::<LOW_COUNTER>() == -2147483578 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
