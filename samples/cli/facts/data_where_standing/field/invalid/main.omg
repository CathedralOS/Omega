// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
data Counter [copy] { value: i32; }

machine replace(slot: &mut i32, replacement: i32)
requires replacement <= 60
ensures slot <= 60
{ slot = replacement; }
machine produce(replacement: i32) -> Counter
requires replacement <= 60
{
    let mut counter: Counter = Counter { value: 0 };
    replace(&mut counter.value, replacement);
    counter
}

data Holder { counter: Counter; }
machine compute(holder: &Holder) -> i32 { 70 + holder.counter.value }
machine main() crashes Trap {
    let counter: Counter = produce(60);
    let holder: Holder = Holder { counter: counter };
    let low: Counter = produce(-2147483648);
    let low_holder: Holder = Holder { counter: low };
    transition compute(&holder) == 130 && compute(&low_holder) == -2147483578 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
