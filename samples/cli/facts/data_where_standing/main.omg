// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
//
//   * Where-clause on the `data` header itself.
//   * `Main::main(main: &mut Main)` reads the gated field.

data Counter
where
    value <= 60,
{
    value: i32;
}

data Main {
    counter: Counter;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    let total: i32 = 70 + main.counter.value;
    transition total <= 130 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { crash Trap; }
}


// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
