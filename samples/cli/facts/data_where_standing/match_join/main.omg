// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
data Counter [copy]
where value <= 60,
{ value: i32; }
machine compute(left: Counter, right: Counter, flag: bool) -> i32 {
    let value: i32 = match flag { true -> left.value, false -> right.value };
    70 + value
}
machine main() crashes Trap {
    let counter: Counter = Counter { value: 60 };
    let low: Counter = Counter { value: -2147483648 };
    transition compute(counter, low, true) == 130 && compute(counter, low, false) == -2147483578 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
