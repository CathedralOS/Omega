// Fact: sign-extending a bounded 8-bit signed i8 value (narrow >= 30i8 && narrow <= 100i8) to i64 (narrow as i64) preserves the exact interval (wide >= 30i64 && wide <= 100i64), discharging exact 64-bit signed subtractions 100i64 - wide and wide - 30i64 across all nine places.
// Place: target_body. Each hosted target body computes the 8-bit to 64-bit sign extension and verifies the bounds.
// Expected exit: 0
machine verify_wide(wide: i64) -> i32
    requires wide >= 30 && wide <= 100
{
    let headroom: i64 = 100 - wide;
    let margin: i64 = wide - 30;
    let diff: i64 = headroom - margin;
    (diff - 10) as i32
}

linux_x86_64 machine compute_target_body(narrow: i8) -> i32
    requires narrow >= 30 && narrow <= 100
{
    let wide: i64 = narrow as i64;
    verify_wide(wide)
}

linux_arm64 machine compute_target_body(narrow: i8) -> i32
    requires narrow >= 30 && narrow <= 100
{
    let wide: i64 = narrow as i64;
    verify_wide(wide)
}

macos_arm64 machine compute_target_body(narrow: i8) -> i32
    requires narrow >= 30 && narrow <= 100
{
    let wide: i64 = narrow as i64;
    verify_wide(wide)
}

windows_x86_64 machine compute_target_body(narrow: i8) -> i32
    requires narrow >= 30 && narrow <= 100
{
    let wide: i64 = narrow as i64;
    verify_wide(wide)
}

machine evaluate() -> i32 {
    compute_target_body(60)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
