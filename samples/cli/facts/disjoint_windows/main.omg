// Provably-disjoint mutable windows: items[0..2] ends where items[2..4] begins, so two live &mut subslices borrow at once.
// Expected exit: 0
//
//   * `let a: &mut [i32] = &mut items[0..2]` + `let b: &mut [i32] =
//     &mut items[2..4]` coexist; writes through both windows.
//   * `hits` records the reached arm.

data Main {
    entries: [i32; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    main.entries = [10, 20, 30, 40];
    let items: &mut [i32] = &mut main.entries[..];
    let a: &mut [i32] = &mut items[0..2];
    let b: &mut [i32] = &mut items[2..4];
    a[0] = 11;
    b[1] = 41;
    transition a.len == 2 && b.len == 2 && main.entries[0] == 11
        && main.entries[3] == 41 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { crash Trap; }
}


// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
