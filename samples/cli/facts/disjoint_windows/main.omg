// Provably-disjoint mutable windows: items[0..2] ends where items[2..4] begins, so two live &mutable subslices borrow at once.
// Expected exit: 0
//
//   * `let a: &mutable [i32] = &mutable items[0..2]` + `let b: &mutable [i32] =
//     &mutable items[2..4]` coexist; writes through both windows.
//   * `hits` records the reached arm.

data Main {
    entries: [i32; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) crashes Trap {
    main.hits = 0;
    main.entries = [10, 20, 30, 40];
    let items: @mutable [i32] = @mutable main.entries[..];
    let a: @mutable [i32] = @mutable items[0..2];
    let b: @mutable [i32] = @mutable items[2..4];
    a[0] = 11;
    b[1] = 41;
    transition a.length == 2 && b.length == 2 && main.entries[0] == 11
        && main.entries[3] == 41 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { crash Trap; }
}


// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
