// Expected exit: 0
// For an exclusive four-element base, split == 2 makes [0,2) and [split,4)
// disjoint, permitting simultaneous exclusive loans and writes a[0] = 11, b[1] = 41.
// Both loans remain live through the writes and readback.
machine exercise(items: @mutable [i32]) -> bool
requires items.length == 4
{
    transition { _ -> write_windows(items, 2) }
    machine write_windows(items: @mutable [i32], split: u64) -> bool
    requires items.length == 4 && split == 2
    {
        let a: @mutable [i32] = @mutable items[0..2];
        let b: @mutable [i32] = @mutable items[split..4];
        a[0] = 11;
        b[1] = 41;
        a[0] == 11 && b[1] == 41
    }
}
machine main() crashes Trap {
    let mutable entries: [i32; 4] = [10, 20, 30, 40];
    let written: bool = exercise(@mutable entries[..]);
    transition written && entries[0] == 11 && entries[1] == 20
        && entries[2] == 30 && entries[3] == 41 { true -> done(), false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
