// Fact: adding two bounded unsigned u64 values (lhs >= 15u64 && lhs <= 40u64 and rhs >= 25u64 && rhs <= 50u64) establishes sum >= 40u64 && sum <= 90u64, discharging both 90u64 - sum and sum - 40u64 across all nine places.
// Invalid: rhs upper bound 51 allows sum 91, so 90u64 - holder.sum underflows. Place: field.
// Expected diagnostic: may overflow `u64`

data SumHolder {
    sum: u64;
}

machine compute_field(lhs: u64, rhs: u64) -> i32
requires lhs >= 15 && lhs <= 40 && rhs >= 25 && rhs <= 51
{
    let holder: SumHolder = SumHolder { sum: lhs + rhs };
    let headroom: u64 = 90u64 - holder.sum;
    let margin: u64 = holder.sum - 40u64;
    0i32
}

machine probe() -> i32 {
    compute_field(25u64, 35u64)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
