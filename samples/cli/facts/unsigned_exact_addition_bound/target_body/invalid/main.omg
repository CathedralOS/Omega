windows_x86_64 machine verify_target() -> i32 {
    let lhs: u64 = 40u64;
    let rhs: u64 = 51u64;
    let sum: u64 = lhs + rhs;
    let headroom: u64 = 90u64 - sum;
    let margin: u64 = sum - 40u64;
    0i32
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
