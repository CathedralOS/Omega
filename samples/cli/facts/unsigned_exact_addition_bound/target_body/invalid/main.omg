// Fact: adding two bounded unsigned u64 values (lhs >= 15u64 && lhs <= 40u64 and rhs >= 25u64 && rhs <= 50u64) establishes sum >= 40u64 && sum <= 90u64, discharging both 90u64 - sum and sum - 40u64 across all nine places.
// Invalid: target bodies compute 40 + 51 = 91, causing 90u64 - sum to underflow. Place: target_body.
// Expected diagnostic: may overflow `u64`

linux_x86_64 machine verify_target() -> i32 {
    let lhs: u64 = 40u64;
    let rhs: u64 = 51u64;
    let sum: u64 = lhs + rhs;
    let headroom: u64 = 90u64 - sum;
    let margin: u64 = sum - 40u64;
    0i32
}

linux_arm64 machine verify_target() -> i32 {
    let lhs: u64 = 40u64;
    let rhs: u64 = 51u64;
    let sum: u64 = lhs + rhs;
    let headroom: u64 = 90u64 - sum;
    let margin: u64 = sum - 40u64;
    0i32
}

macos_arm64 machine verify_target() -> i32 {
    let lhs: u64 = 40u64;
    let rhs: u64 = 51u64;
    let sum: u64 = lhs + rhs;
    let headroom: u64 = 90u64 - sum;
    let margin: u64 = sum - 40u64;
