// Fact: adding two bounded unsigned u64 values (lhs >= 15u64 && lhs <= 40u64 and rhs >= 25u64 && rhs <= 50u64) establishes sum >= 40u64 && sum <= 90u64, discharging both 90u64 - sum and sum - 40u64 across all nine places.
// Invalid: parameter upper bound 91 allows underflow in 90u64 - sum. Place: parameter.
// Expected diagnostic: may overflow `u64`

machine verify_parameter(sum: u64) -> i32
requires sum >= 40 && sum <= 91
{
    let headroom: u64 = 90u64 - sum;
    let margin: u64 = sum - 40u64;
    0i32
}

machine compute_param(lhs: u64, rhs: u64) -> i32
requires lhs >= 15 && lhs <= 40 && rhs >= 25 && rhs <= 51
{
    verify_parameter(lhs + rhs)
}

machine probe() -> i32 {
    compute_param(25u64, 35u64)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
