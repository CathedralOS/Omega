// Fact: adding two bounded unsigned u64 values (lhs >= 15u64 && lhs <= 40u64 and rhs >= 25u64 && rhs <= 50u64) establishes sum >= 40u64 && sum <= 90u64, discharging both 90u64 - sum and sum - 40u64 across all nine places.
// Place: local. The sum is copied into a local before discharging the subtraction bounds.
// Expected exit: 0

machine compute_local(lhs: u64, rhs: u64) -> i32
requires lhs >= 15 && lhs <= 40 && rhs >= 25 && rhs <= 50
{
    let sum: u64 = lhs + rhs;
    let s: u64 = sum;
    let headroom: u64 = 90u64 - s;
    let margin: u64 = s - 40u64;
    0i32
}

machine probe() -> i32 {
    compute_local(25u64, 35u64)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
