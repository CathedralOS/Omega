// An owned payload in PositiveSmall preserves every active case payload when replacing one of 4096 frames.
// Expected exit: 0
domain u64::PositiveSmall requires self > 0 && self < 8;
data Frame [copy] {
    case Empty;
    case Ready(value: u64 in PositiveSmall);
}
machine replace(frames: &mut [Frame; 4096], position: u64,
    payload: u64 in PositiveSmall) -> u64
requires position < 4096 {
    frames[position] = Frame::Ready { value: payload };
    transition { _ -> read(frames, position) }
    machine read(frames: &mut [Frame; 4096], position: u64) -> u64
    requires position < 4096 {
        transition frames[position] {
            Frame::Empty -> 99
            Frame::Ready { value } -> (value - 1)
        }
    }
}
machine run(payload: u64 in PositiveSmall) -> u64 {
    let mut frames: [Frame; 4096];
    replace(&mut frames, 3, payload)
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedWitness {
    machine witness() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Witness satisfies SelectedWitness {
    machine witness() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let payload: u64 in PositiveSmall = 0;
        run(payload)
    }
}

ArmWitness satisfies SelectedWitness {
    machine witness() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let payload: u64 in PositiveSmall = 0;
        run(payload)
    }
}


machine main() crashes Trap {
    transition SelectedWitness::witness() == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
