// An owned payload in PositiveSmall preserves every active case payload when replacing one of 4096 frames.
// Expected exit: 0
domain u64::PositiveSmall(value) requires value > 0 && value < 8;
data Frame [copy] {
    case Empty;
    case Ready(value: u64 in PositiveSmall);
}
machine replace(frames: &mut [Frame; 4096], position: u64,
    payload: u64 in PositiveSmall) -> u64
requires position < 4096 {
    frames[position] = Frame::Ready { value: payload };
    transition { _ -> read(frames, position) }
    state read(frames: &mut [Frame; 4096], position: u64) -> u64
    requires position < 4096 {
        transition frames[position] {
            Frame::Empty -> 99
            Frame::Ready { value } -> (value - 1)
        }
    }
}
machine run(payload: u64 in PositiveSmall) -> u64 {
    let mut frames: [Frame; 4096];
    replace(&mut frames, 3, payload)
}
windows_x86_64 machine witness() -> u64 {
    let payload: u64 in PositiveSmall = 3;
    run(payload)
}
linux_x86_64 machine witness() -> u64 {
    let payload: u64 in PositiveSmall = 3;
    run(payload)
}
linux_arm64 machine witness() -> u64 {
    let payload: u64 in PositiveSmall = 3;
    run(payload)
}
macos_arm64 machine witness() -> u64 {
    let payload: u64 in PositiveSmall = 3;
    run(payload)
}
machine main() crashes Trap {
    transition witness() == 2 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
