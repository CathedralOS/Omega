// Fact: a checked subslice of an immutable byte-view literal preserves its exact window length of 10u64 when multiplied by 10u64 and subtracting 100u64.
// Place: another target body (invalid twin).
// Expected diagnostic: exact subtraction underflow

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEvaluateWindow {
    machine evaluate_window() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86EvaluateWindow satisfies SelectedEvaluateWindow {
    machine evaluate_window() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let bytes: &[u8] = "0123456789ABCD";
        let window: &[u8] = bytes[2u64..11u64];
        let total: u64 = window.len * 10u64;
        total - 100u64
    }
}

ArmEvaluateWindow satisfies SelectedEvaluateWindow {
    machine evaluate_window() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let bytes: &[u8] = "0123456789ABCD";
        let window: &[u8] = bytes[2u64..11u64];
        let total: u64 = window.len * 10u64;
        total - 100u64
    }
}

machine probe() -> u64 {
    SelectedEvaluateWindow::evaluate_window()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
