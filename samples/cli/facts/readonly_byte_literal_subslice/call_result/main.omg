// Fact: a checked subslice of an immutable byte-view literal preserves its exact window length of 10u64 when multiplied by 10u64 and subtracting 100u64.
// Place: call result. A callee evaluates the literal subslice and returns the measured window length.
// Expected exit: 0

machine window_len() -> u64
ensures result == 10u64
{
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..12u64];
    window.len
}

machine probe() -> u64
ensures result == 0u64
{
    let len: u64 = window_len();
    let total: u64 = len * 10u64;
    total - 100u64
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
