// Fact: a checked subslice of an immutable byte-view literal preserves its exact window length of 10u64 when multiplied by 10u64 and subtracting 100u64.
// Place: another state. A transition forwards the measured subslice length to a successor state.
// Expected exit: 0

machine probe() -> u64
ensures result == 0u64
{
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..12u64];
    transition {
        _ -> step(window.len)
    }
    machine step(window_len: u64) -> u64
    requires window_len == 10u64
    {
        let total: u64 = window_len * 10u64;
        total - 100u64
    }
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
