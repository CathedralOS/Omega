// Compatible references to a live Pair expose the same nonzero address without retaining a loan.
// Expected exit: 0.
data Pair [copy] { left: u64; right: u64; }
machine expose(value: &Pair) -> addr { address_of(value) }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine probe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let mut value: Pair = Pair { left: 7, right: 11 };
        let original: addr = address_of(value);
        let forwarded: addr = expose(&value);
        value.left = 13;
        let current: addr = address_of(value);
        original != 0 && original == forwarded && original == current && value.left == 13
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let mut value: Pair = Pair { left: 7, right: 11 };
        let original: addr = address_of(value);
        let forwarded: addr = expose(&value);
        value.left = 13;
        let current: addr = address_of(value);
        original != 0 && original == forwarded && original == current && value.left == 13
    }
}


machine main() crashes Trap {
    transition SelectedProbe::probe() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
