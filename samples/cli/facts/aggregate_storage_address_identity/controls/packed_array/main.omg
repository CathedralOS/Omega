// Compatible references to a live aggregate expose the same nonzero address without retaining a loan.
// Expected exit: 0.
machine expose(value: &[u64; 2]) -> addr { address_of(value) }
machine probe() -> bool {
    let mut value: [u64; 2] = [7, 11];
    let other: [u64; 2] = [7, 11];
    let original: addr = address_of(&value);
    let forwarded: addr = expose(&value);
    let distinct: addr = address_of(&other);
    value[0] = 13;
    let current: addr = address_of(&value);
    original != 0 && original == forwarded && original == current
        && original != distinct && value[0] == 13 && value[1] == 11
}
machine main() crashes Trap {
    transition probe() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
