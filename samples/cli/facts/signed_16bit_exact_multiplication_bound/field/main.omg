// Fact: a 16-bit signed i16 exact multiplication of bounded inputs (lhs >= 15i16 && lhs <= 25i16, rhs >= 10i16 && rhs <= 20i16) establishes prod >= 150i16 && prod <= 500i16 so exact 16-bit signed subtraction 500i16 - prod is proved overflow-free across all nine places.
// Expected exit: 0

machine compute_prod(lhs: i16, rhs: i16) -> i16
    requires lhs >= 15 && lhs <= 25, rhs >= 10 && rhs <= 20
{
    lhs * rhs
}

machine verify_prod(prod: i16) -> i32
    requires prod >= 150 && prod <= 500
{
    let headroom: i16 = 500 - prod;
    (headroom - 200) as i32
}

data ProdCarrier {
    prod: i16;
}

machine main() crashes Trap {
    let lhs: i16 = 20;
    let rhs: i16 = 15;
    let carrier: ProdCarrier = ProdCarrier { prod: compute_prod(lhs, rhs) };
    let check: i32 = verify_prod(carrier.prod);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
