        FortyFourChoice::V41 { v } -> v
        FortyFourChoice::V42 { v } -> v
        FortyFourChoice::V43 { v } -> v
        FortyFourChoice::V44 { v } -> v
    }
}

machine probe(flag: bool, choice: FortyFourChoice) -> u64 {
    let res: u64 = extract(choice);
    let joined: u64 = choose(flag, res, 60u64);
    verify_payload(joined)
}

machine main() crashes Trap {
    let p: FortyFourChoice = FortyFourChoice::V44 { v: 60u64 };
    let combined: u64 = probe(true, p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
