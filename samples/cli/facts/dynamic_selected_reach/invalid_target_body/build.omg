use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "dynamic_selected_reach_target_body_invalid" };
    Build::select_provider::<|app|::Journal, |app|::InlineJournal>(builder, linux_x86_64);
    Build::select_provider::<|app|::Journal, |app|::InlineJournal>(builder, linux_arm64);
    Build::select_provider::<|app|::Journal, |app|::InlineJournal>(builder, windows_x86_64);
    Build::select_provider::<|app|::Journal, |app|::InlineJournal>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedObserve, |app|::X86Observe>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedObserve, |app|::X86Observe>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedObserve, |app|::ArmObserve>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedObserve, |app|::ArmObserve>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
