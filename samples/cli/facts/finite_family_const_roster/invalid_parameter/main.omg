// A runtime-selected family calls its const-only method through the declared width list, retains its required target call, and returns the selected row's value.
// Expected exit: 0
// Place: parameter.
boundary trait WideRowTarget {
    machine preserve(value: u32) -> u32 reaches;
}
HostedWideRow satisfies WideRowTarget {
    machine preserve(value: u32) -> u32 reaches { value }
}
trait Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32 invokes WideRowTarget;
}
Selected satisfies Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32 invokes WideRowTarget {
        transition Width == 16 { true -> Width false -> WideRowTarget::preserve(Width) }
    }
}
Other satisfies Family {
    machine row<const Width: u32>() -> u32
    requires Width == 16 || Width == 32 invokes WideRowTarget {
        transition Width == 16 { true -> 17 false -> WideRowTarget::preserve(33u32) }
    }
}
trait RuntimeFamily {
    machine row<Width: u32>(selected: dyn Family) -> u32
    requires Width == 16 || Width == 32 invokes WideRowTarget;
}
BridgeToConst satisfies RuntimeFamily {
    machine row<Width: u32>(selected: dyn Family) -> u32
    requires Width == 16 || Width == 32 invokes WideRowTarget {
        Family::row<Width>(selected)
    }
}
machine selected_width(selection: dyn Family, width: u32) -> u32
requires width == 16 || width == 32 {
    Family::row<width>(selection)
}

machine forward(selected: dyn Family, width: u32) -> u32
requires width == 16 || width == 32 { selected_width(selected, width) }
machine main() crashes Trap {
    let first: u32 = forward(Selected as dyn Family, 16);
    let first_wide: u32 = forward(Selected as dyn Family, 32);
    let second: u32 = forward(Other as dyn Family, 16);
    let second_wide: u32 = forward(Other as dyn Family, 32);
    transition first == 16 && second == 17 && first_wide == 32 && second_wide == 33 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
