// A runtime-selected family calls its const-only method through the declared width list and returns the selected row's value.
// Expected exit: 0
// Place: other_machine.
trait Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32;
}
Selected satisfies Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32 { Width }
}
Other satisfies Family {
    machine row<const Width: u32>() -> u32
    requires Width == 16 || Width == 32 {
        transition Width == 16 { true -> 17 false -> 33 }
    }
}
trait RuntimeFamily {
    machine row<Width: u32>(selected: dyn Family) -> u32
    requires Width == 16 || Width == 32;
}
BridgeToConst satisfies RuntimeFamily {
    machine row<Width: u32>(selected: dyn Family) -> u32
    requires Width == 16 || Width == 32 {
        Family::row<Width>(selected)
    }
}
machine selected_width(selection: dyn Family, width: u32) -> u32
requires width == 16 || width == 32 {
    Family::row<width>(selection)
}

machine helper_forward(selected: dyn Family, width: u32) -> u32
requires width == 16 || width == 32 { selected_width(selected, width) }
machine main() crashes Trap {
    let first: u32 = helper_forward(Selected as dyn Family, 16);
    let first_wide: u32 = helper_forward(Selected as dyn Family, 32);
    let second: u32 = helper_forward(Other as dyn Family, 16);
    let second_wide: u32 = helper_forward(Other as dyn Family, 32);
    transition first == 16 && second == 17 && first_wide == 32 && second_wide == 33 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
