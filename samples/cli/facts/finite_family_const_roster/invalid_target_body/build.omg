use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "finite_const_roster_target_body" };
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::accept_boundary::<|app|::FamilyForward>(builder);
    Build::select_provider::<|app|::FamilyForward, |app|::HostedFamily>(builder, macos_x86_64);
    Build::select_provider::<|app|::FamilyForward, |app|::HostedFamily>(builder, windows_x86_64);
    Build::select_provider::<|app|::FamilyForward, |app|::HostedFamily>(builder, linux_x86_64);
    Build::select_provider::<|app|::FamilyForward, |app|::HostedFamily>(builder, macos_arm64);
    Build::select_provider::<|app|::FamilyForward, |app|::HostedFamily>(builder, linux_arm64);
    Build::select_provider::<|app|::WideRowTarget, |app|::HostedWideRow>(builder, linux_x86_64);
    Build::select_provider::<|app|::WideRowTarget, |app|::HostedWideRow>(builder, linux_arm64);
    Build::select_provider::<|app|::WideRowTarget, |app|::HostedWideRow>(builder, macos_arm64);
    Build::select_provider::<|app|::WideRowTarget, |app|::HostedWideRow>(builder, windows_x86_64);
    Build::select_provider::<|app|::WideRowTarget, |app|::HostedWideRow>(builder, macos_x86_64);
}
