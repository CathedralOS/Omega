// Nested domain Nested requires self in Small, and inherited domain Nested::Inherited establishes self < 5, so 5 - held is exact.
// Expected exit: 0.
domain u64::Small requires self < 5;
domain u64::Nested requires self in Small;
domain u64::Nested::Inherited;

machine pick(tag: bool) -> u64 in Nested::Inherited {
    transition tag {
        true -> 3
        _ -> 1
    }
}
machine consume(held: u64 in Nested::Inherited) -> u64 {
    5 - held
}
machine main() crashes Trap {
    let held: u64 in Nested::Inherited = pick(true);
    let other: u64 in Nested::Inherited = pick(false);
    transition consume(held) == 2 && consume(other) == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
