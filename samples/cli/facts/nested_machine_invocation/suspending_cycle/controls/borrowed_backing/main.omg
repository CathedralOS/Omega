// A ranked terminal cycle of nested machines whose every edge acknowledges `suspend` adds each parked step's answer and forwards the total to its ordinary caller.
// Control: the cycle also carries the caller's exclusive borrow across every parked step.
// Expected exit: 0
public boundary trait Scheduler {
    machine advance(value: u64) -> u64 reaches suspends;
}
InlineScheduler satisfies Scheduler {
    machine advance(value: u64) -> u64 { (value as u64 in Wrapping * 3) as u64 }
}
machine sum(counter: &mut u64, total: u64, remaining: u64) -> u64 reaches Scheduler suspends terminates by remaining {
    transition remaining == 0 {
        true -> total
        false -> suspend step(counter, total, remaining)
    }
    machine step(counter: &mut u64, total: u64, remaining: u64) -> u64 reaches Scheduler suspends
    requires remaining > 0
    {
        let seen: u64 = suspend Scheduler::advance(remaining);
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: u64 = ((total as u64 in Wrapping) + (seen as u64 in Wrapping)) as u64;
        transition { _ -> suspend sum(counter, next, remaining - 1) }
    }
}
data Counters { before: u64; steps: u64; after: u64; }
machine main() reaches Scheduler crashes Trap {
    let mut counters: Counters = Counters { before: 0x1111, steps: 0, after: 0x2222 };
    let full: u64 = suspend sum(&mut counters.steps, 0, 100000);
    let empty: u64 = suspend sum(&mut counters.steps, 7, 0);
    transition full == 15000150000 && empty == 7 && counters.steps == 100000
        && counters.before == 0x1111 && counters.after == 0x2222 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
