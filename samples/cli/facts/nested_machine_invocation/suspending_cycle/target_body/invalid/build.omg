machine build(builder: &mut Build) {
    Build::application(builder, "nested_suspending_cycle_target_body_invalid");
    Build::select_provider<Scheduler, InlineScheduler>(builder, windows_x86_64);
    Build::select_provider<SelectedCycle, X86Cycle>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<Scheduler, InlineScheduler>(builder, linux_x86_64);
    Build::select_provider<SelectedCycle, X86Cycle>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<Scheduler, InlineScheduler>(builder, macos_x86_64);
    Build::select_provider<SelectedCycle, X86Cycle>(builder, macos_x86_64);
    Build::bind(builder, macos_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<Scheduler, InlineScheduler>(builder, linux_arm64);
    Build::select_provider<SelectedCycle, ArmCycle>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::select_provider<Scheduler, InlineScheduler>(builder, macos_arm64);
    Build::select_provider<SelectedCycle, ArmCycle>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
}
