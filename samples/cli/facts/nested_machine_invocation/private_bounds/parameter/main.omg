// Every private arrival carries index < items.len, so the helper can read items[index].
// Expected exit: 0
machine probe(items: &[u8], index: u64, select: bool) -> u8 {
    transition index < items.len {
        true -> get(items, index)
        false -> (0)
    }
    machine get(items: &[u8], index: u64) -> u8 { items[index] }
}
machine main() crashes Trap {
    let items: [u8; 4] = [4, 7, 8, 9];
    let first: u8 = probe(&items[..], 2, true);
    let second: u8 = probe(&items[..], 3, false);
    let outside: u8 = probe(&items[..2], 2, true);
    let empty: u8 = probe(&items[..0], 0, false);
    transition first == 8 && second == 9 && outside == 0 && empty == 0 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
