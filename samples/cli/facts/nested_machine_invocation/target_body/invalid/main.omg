// A nested machine preserves its enclosing type when returning an explicitly supplied value.
// Rejected: a Boolean is not the enclosing arbitrary type T.
machine identity<T>(value: T) -> T {
    keep(value)
    machine keep(item: T) -> T { true }
}
windows_x86_64 machine compute() -> u64 { identity<u64>(42) }
linux_x86_64 machine compute() -> u64 { identity<u64>(42) }
linux_arm64 machine compute() -> u64 { identity<u64>(42) }
macos_arm64 machine compute() -> u64 { identity<u64>(42) }
machine main() crashes Trap {
    let result: u64 = compute();
    transition result == 42 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
