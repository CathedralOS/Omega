// Nested callable headers retain their own input and result contracts while each bodyless declaration consumes one terminator.
// Expected exit: 0
machine increment(value: u64) -> u64
requires value >= 4 && value <= 7
terminates
ensures result == value + 1
{ value + 1 }
machine apply<machine Step>(value: u64) -> u64
requires machine Step(item: u64) -> u64
    requires item >= 4 && item <= 7
    terminates
    ensures result == item + 1;
crashes Trap
requires value >= 4 && value <= 7
ensures result == value + 1
{ Step(value) }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedExercise {
    machine exercise(low: bool) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Exercise satisfies SelectedExercise {
    machine exercise(low: bool) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     let value: u64 = match low { true -> 4 false -> 7 }; apply<increment>(value) 
    }
}

ArmExercise satisfies SelectedExercise {
    machine exercise(low: bool) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     let value: u64 = match low { true -> 4 false -> 7 }; apply<increment>(value) 
    }
}


machine main() crashes Trap {
    let low: u64 = SelectedExercise::exercise(true);
    let high: u64 = SelectedExercise::exercise(false);
    transition low == 5 && high == 8 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
