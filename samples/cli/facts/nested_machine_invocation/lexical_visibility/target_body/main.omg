// A bare call names the machine visible from the call site: the private `hidden` inside `outer`, the free `hidden` anywhere else, and no callee once the free one is absent.
// Expected exit: 0
boundary trait SelectedProbe {
    machine exercise(value: u64) -> u64 reaches;
}
X86Probe satisfies SelectedProbe {
    machine exercise(value: u64) -> u64 {
        hidden(value)
        machine hidden(value: u64) -> u64 { value }
    }
}
ArmProbe satisfies SelectedProbe {
    machine exercise(value: u64) -> u64 {
        hidden(value)
        machine hidden(value: u64) -> u64 { value }
    }
}
machine hidden(value: u64) -> u64 { 107 }
machine main() reaches SelectedProbe crashes Trap {
    let inner: u64 = SelectedProbe::exercise(7);
    let free: u64 = hidden(7);
    transition inner == 7 && free == 107 { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
