// Expected exit: 0
// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
data Cell { value: u64; canary: u64; }
data View<'storage> { cell: &'storage mut Cell; stamp: u64; }
machine rebuild<'storage>(view: View<'storage>, remaining: u64) -> View<'storage> {
    transition { _ -> relay(view, remaining) }
    machine relay(view: View<'storage>, remaining: u64) -> View<'storage>
    terminates
    terminates by remaining
    {
        transition remaining > 0 {
            true -> step(view, remaining)
            false -> view
        }
        machine step(view: View<'storage>, pending: u64) -> View<'storage>
        requires pending > 0
        {
            view.cell.value = ((view.cell.value as u64 in Wrapping) + 1) as u64;
            transition { _ -> relay(view, pending - 1) }
        }
    }
}
machine repair<'storage>(slot: &mut View<'storage>, remaining: u64) {
    let removed: View<'storage> = slot;
    slot = rebuild(removed, remaining);
}
boundary trait HostedRestoration {
    machine perform<'storage>(view: &mut View<'storage>, select: bool) reaches;
}
HostedRestorationBody satisfies HostedRestoration {
    machine perform<'storage>(view: &mut View<'storage>, select: bool) {
        let remaining: u64 = match select { true -> 7 false -> 0 };
        repair(view, remaining);
    }
}
data Pair<'storage> { first: View<'storage>; second: View<'storage>; marker: u64; }
machine main() crashes Trap {
    let mut first: Cell = Cell { value: 3, canary: 7 };
    let mut second: Cell = Cell { value: 31, canary: 17 };
    let mut pair: Pair = Pair {
        first: View { cell: &mut first, stamp: 13 },
        second: View { cell: &mut second, stamp: 19 }, marker: 71
    };
    HostedRestoration::perform(&mut pair.first, true);
    HostedRestoration::perform(&mut pair.first, false);
    second.value = 99;
    let correct: bool = pair.first.cell.value == 10 && pair.first.cell.canary == 7 && pair.first.stamp == 13
        && pair.second.cell.value == 31 && pair.second.cell.canary == 17 && pair.second.stamp == 19 && pair.marker == 71;
    transition correct && first.value == 10 && second.value == 31 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
