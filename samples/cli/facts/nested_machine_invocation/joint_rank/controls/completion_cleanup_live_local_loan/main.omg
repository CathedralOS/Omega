// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Counter {
    canary: u64;
    drops: u64;
    steps: u64;
}
data Resource {
    counter: &mut Counter;
    valid: u64;
}
machine Resource::drop(resource: &mut Resource)
requires resource.valid == 1u64
{
    resource.counter.drops = ((resource.counter.drops as u64 in Wrapping) + 1) as u64;
    resource.valid = 0u64;
}
machine count(counter: &mut Counter, remaining: u64)
terminates by remaining
{
    transition remaining > 0 {
        true -> forward(counter, remaining)
        false -> done()
    }
    machine forward(counter: &mut Counter, pending: u64)
    requires pending > 0
    {
        let temporary: Resource = Resource { counter: counter, valid: 1u64 };
        transition { _ -> count(counter, pending - 1) }
    }
    machine done() {}
}
machine perform(counter: &mut Counter, select: bool) {
    let remaining: u64 = match select { true -> 7 false -> 0 };
    count(counter, remaining);
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { canary: 641u64, drops: 0u64, steps: 3u64 };
    perform(&mut counter, true);
    let matched: bool = counter.canary == 641u64 && counter.drops == 7u64;
    perform(&mut counter, false);
    transition matched && counter.canary == 641u64 && counter.drops == 7u64 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
