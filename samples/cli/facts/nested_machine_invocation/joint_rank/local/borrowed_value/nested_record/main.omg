// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Payload { count: u64; tag: u64; }
data Remaining { canary: u64; payload: Payload; }
machine count(counter: &mut u64, remaining: &mut Remaining) crashes Trap
terminates;
terminates by remaining.payload.count;
requires remaining.payload.count <= 7;
{
    transition remaining.payload.count > 0 {
        true -> forward(remaining, counter)
        false -> finish(remaining.canary, remaining.payload.tag)
    }
    machine forward(pending: &mut Remaining, counter: &mut u64) crashes Trap
    requires pending.payload.count > 0 && pending.payload.count <= 7;
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        pending.payload.count = pending.payload.count - 1;
        transition { _ -> count(counter, pending) }
    }
    machine finish(canary: u64, tag: u64) crashes Trap {
        transition canary == 641 && tag == 827 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool) crashes Trap {
    let mut remaining: Remaining = match select {
        true -> Remaining { canary: 641, payload: Payload { count: 7, tag: 827 } }
        false -> Remaining { canary: 641, payload: Payload { count: 0, tag: 827 } }
    };
    count(counter, &mut remaining);
    transition remaining.payload.count == 0 && remaining.canary == 641 && remaining.payload.tag == 827 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
