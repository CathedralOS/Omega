// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Remaining { canary: u64; count: u64; tail: u64; }
measure Remaining::Doubled(value: u64) -> u64 { value * 2 }
machine count(counter: &mut u64, remaining: Remaining) crashes Trap
terminates;
terminates by remaining.count -> Remaining::Doubled;
requires remaining.count <= 7;
{
    transition remaining.count > 0 {
        true -> forward(remaining.count, remaining.canary, remaining.tail, counter)
        false -> finish(remaining.count, remaining.canary, remaining.tail)
    }
    machine forward(pending: u64, canary: u64, tail: u64, counter: &mut u64) crashes Trap
    requires pending > 0 && pending <= 7;
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Remaining = Remaining { canary: canary, count: pending - 0, tail: tail };
        transition { _ -> count(counter, next) }
    }
    machine finish(value: u64, canary: u64, tail: u64) crashes Trap {
        transition value == 0 && canary == 641 && tail == 967 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool) crashes Trap {
    let remaining: Remaining = match select {
        true -> Remaining { canary: 641, count: 7, tail: 967 }
        false -> Remaining { canary: 641, count: 0, tail: 967 }
    };
    count(counter, remaining);
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
