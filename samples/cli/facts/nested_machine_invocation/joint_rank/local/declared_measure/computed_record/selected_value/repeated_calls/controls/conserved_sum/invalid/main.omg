// Distinct actual selector contexts must not collapse to one read.
data Progress [copy] { values: [u64; 2]; }
machine read_slot(input: &Progress, index: u64) -> u64
requires index < 2
ensures result == input.values[index]
terminates
{ input.values[index] }
measure Progress::Remaining(value: Progress) -> u64 { read_slot(&value, 0) + read_slot(&value, 1) }
machine count(remaining: Progress, counter: &mut u64) -> Progress
requires remaining.values[0] <= 7 && remaining.values[1] <= 7 && remaining.values[0] + remaining.values[1] == 7
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.values[0] > 0 {
        true -> forward(remaining, counter)
        false -> remaining
    }
    machine forward(pending: Progress, counter: &mut u64) -> Progress
    requires pending.values[0] > 0 && pending.values[0] <= 7 && pending.values[1] <= 7 && pending.values[0] + pending.values[1] == 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Progress = Progress { values: [pending.values[0] - 1, pending.values[1] + 1] };
        transition { _ -> count(next, counter) }
    }
}
machine main() {}
