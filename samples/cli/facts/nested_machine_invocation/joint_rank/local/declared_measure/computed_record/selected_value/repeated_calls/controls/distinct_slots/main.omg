// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Progress [copy] { values: [u64; 2]; canary: u64; }
machine read_slot(input: &Progress, index: u64) -> u64
requires index < 2
ensures result == input.values[index]
terminates
{ input.values[index] }
measure Progress::Remaining(value: Progress) -> u64 { read_slot(&value, 0) + read_slot(&value, 1) }
machine count(remaining: Progress, counter: &mut u64) -> Progress crashes Trap
requires remaining.values[0] <= 7 && remaining.values[1] == 919
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.values[0] > 0 {
        true -> forward(remaining, counter)
        false -> remaining
    }
    machine forward(pending: Progress, counter: &mut u64) -> Progress crashes Trap
    requires pending.values[0] > 0 && pending.values[0] <= 7 && pending.values[1] == 919
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Progress = Progress { values: [pending.values[0] - 1, pending.values[1]], canary: pending.canary };
        transition { _ -> count(next, counter) }
    }
}
machine perform(counter: &mut u64, active: bool) crashes Trap {
    let amount: u64 = match active { true -> 7 false -> 0 };
    let result: Progress = count(Progress { values: [amount, 919], canary: 641 }, counter);
    transition result.values[0] == 0 && result.values[1] == 919 && result.canary == 641 { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counter: u64 = 3;
    perform(&mut counter, true);
    let active: bool = counter == 10;
    perform(&mut counter, false);
    transition active && counter == 10 { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
