data Progress [copy] { values: [u64; 2]; }
machine read_rank(input: &Progress, index: u64) -> u64
requires index < 2
ensures result == input.values[index]
terminates { input.values[index] }
machine changed(mut input: Progress) -> u64
requires input.values[0] <= 7 && input.values[1] <= 919
ensures result == read_rank(&input, 0) + read_rank(&input, 1)
{
    input.values[0] = 18446744073709551615;
    input.values[1] = 1;
    0
}
machine main() { let result: u64 = changed(Progress { values: [7, 919] }); }
