// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Progress { lower: u64; upper: u64; canary: u64; guard: &mut u64; }
machine distance(value: &Progress) -> u64
requires value.lower <= value.upper
ensures result == value.upper - value.lower
terminates
{ value.upper - value.lower }
measure Progress::Remaining(value: Progress) -> u64 { distance(&value) }
machine count(counter: &mut u64, remaining: Progress) crashes Trap
requires remaining.lower <= remaining.upper && remaining.upper <= 7
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.lower < remaining.upper {
        true -> forward(remaining, counter)
        false -> finish(remaining.lower, remaining.upper, remaining.canary, remaining.guard)
    }
    machine forward(pending: Progress, counter: &mut u64) crashes Trap
    requires pending.lower < pending.upper && pending.upper <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Progress = Progress { lower: pending.lower + 1, upper: pending.upper, canary: pending.canary, guard: pending.guard };
        transition { _ -> count(counter, next) }
    }
    machine finish(lower: u64, upper: u64, canary: u64, guard: &mut u64) crashes Trap {
        transition lower == upper && canary == 641 && guard == 827 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool, alternative: bool) crashes Trap {
    let mut guard: u64 = 827;
    let mut other_guard: u64 = 827;
    let mut third_guard: u64 = 827;
    invoke(counter, match select { true -> Progress { lower: 0, upper: 7, canary: 641, guard: &mut guard } false -> Progress { lower: 7, upper: 7, canary: 641, guard: &mut other_guard } }, match alternative { true -> Progress { lower: 7, upper: 7, canary: 641, guard: &mut third_guard } false -> Progress { lower: 7, upper: 7, canary: 641, guard: &mut guard } });
    verify_guard(guard);
}
machine invoke(counter: &mut u64, received: Progress, other: Progress) crashes Trap
requires received.lower <= received.upper && received.upper <= 7
{ count(counter, received); }
machine verify_guard(value: u64) crashes Trap {
    transition value == 827 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counter: u64 = 3;
    perform(&mut counter, true, false);
    let active: bool = counter == 10;
    perform(&mut counter, false, true);
    transition active && counter == 10 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
