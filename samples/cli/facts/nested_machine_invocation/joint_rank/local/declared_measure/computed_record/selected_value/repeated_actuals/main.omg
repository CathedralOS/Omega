// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Progress [copy] { values: [u64; 2]; canary: u64; }
machine read_rank(input: &Progress, index: u64) -> u64
requires index < 2
ensures result == input.values[index]
terminates
{ input.values[index] }
measure Progress::Remaining(value: Progress) -> u64 { read_rank(&value, 0) + read_rank(&value, 1) }
machine count(counter: &mut u64, remaining: Progress) -> Progress crashes Trap
requires remaining.values[0] <= 7 && remaining.values[1] <= 919
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.values[0] > 0 {
        true -> forward(remaining, counter)
        false -> remaining
    }
    machine forward(pending: Progress, counter: &mut u64) -> Progress crashes Trap
    requires pending.values[0] > 0 && pending.values[0] <= 7 && pending.values[1] <= 919
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let mut next: Progress = pending;
        next.values[0] = pending.values[0] - 1;
        transition { _ -> count(counter, next) }
    }
}
machine perform(counter: &mut u64, active: bool, second: bool) crashes Trap {
    let amount: u64 = match active { true -> 7 false -> 0 };
    let values: [u64; 2] = match second { true -> [amount, 37] false -> [amount, 919] };
    let mut remaining: Progress = Progress { values: values, canary: 641 };
    remaining = count(counter, remaining);
    let preserved: bool = match second {
        true -> remaining.values[0] == 0 && remaining.values[1] == 37
        false -> remaining.values[0] == 0 && remaining.values[1] == 919
    };
    transition preserved && remaining.canary == 641 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true, false);
    let first: bool = counted == 10;
    perform(&mut counted, false, false);
    perform(&mut counted, true, true);
    let second: bool = counted == 17;
    perform(&mut counted, false, true);
    transition first && second && counted == 17 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
