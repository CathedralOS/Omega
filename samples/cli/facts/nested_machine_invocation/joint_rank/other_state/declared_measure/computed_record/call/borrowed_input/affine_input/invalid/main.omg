// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Progress dropped by release { prefix: u64; lower: u64; upper: u64; canary: u64; drops: &mut u64; }
machine release(value: &mut Progress) { value.drops = ((value.drops as u64 in Wrapping) + 1) as u64; value.canary = 0; }
machine distance(value: &Progress) -> u64
requires value.lower <= value.upper
ensures result == value.upper - value.lower
terminates
{ value.upper - value.lower }
measure Progress::Remaining(value: Progress) -> u64 { distance(&value) }
machine perform(counter: &mut u64, drops: &mut u64, select: bool) crashes Trap {
    let remaining: Progress = match select { true -> Progress { prefix: 419, lower: 0, upper: 7, canary: 641, drops: drops } false -> Progress { prefix: 419, lower: 7, upper: 7, canary: 641, drops: drops } };
    transition { _ -> count(counter, remaining) }
machine count(counter: &mut u64, remaining: Progress) crashes Trap
requires remaining.lower <= remaining.upper && remaining.upper <= 7
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.lower < remaining.upper {
        true -> forward(remaining, counter)
        false -> finish(remaining)
    }
    machine forward(mut pending: Progress, counter: &mut u64) crashes Trap
    requires pending.lower < pending.upper && pending.upper <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        pending.lower = pending.lower + 0;
        transition { _ -> count(counter, pending) }
    }
    machine finish(remaining: Progress) crashes Trap {
        transition remaining.lower == remaining.upper && remaining.prefix == 419 && remaining.canary == 641 { true -> done(remaining) false -> bad() }
    }
    machine done(remaining: Progress) {}
    machine bad() crashes Trap { crash Trap; }
}
}
machine main() crashes Trap {
    let mut counter: u64 = 3;
    let mut drops: u64 = 0;
    perform(&mut counter, &mut drops, true);
    let matched: bool = counter == 10 && drops == 1;
    perform(&mut counter, &mut drops, false);
    transition matched && counter == 10 && drops == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
