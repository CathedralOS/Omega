machine build(builder: &mut Build) {
    Build::application(builder, "joint_rank_stored_reference_target_body");
    Build::select_provider<HostedBorrowed, HostedBorrowedBody>(builder, windows_x86_64);
    Build::select_provider<HostedBorrowed, HostedBorrowedBody>(builder, linux_x86_64);
    Build::select_provider<HostedBorrowed, HostedBorrowedBody>(builder, macos_arm64);
    Build::select_provider<HostedBorrowed, HostedBorrowedBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
