machine build(builder: &mut Build) {
    Build::application(builder, "joint_rank_descriptor_indexed_value_target_body_invalid");
    Build::select_provider<HostedIndexed, HostedIndexedBody>(builder, windows_x86_64);
    Build::select_provider<HostedIndexed, HostedIndexedBody>(builder, linux_x86_64);
    Build::select_provider<HostedIndexed, HostedIndexedBody>(builder, macos_arm64);
    Build::select_provider<HostedIndexed, HostedIndexedBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
