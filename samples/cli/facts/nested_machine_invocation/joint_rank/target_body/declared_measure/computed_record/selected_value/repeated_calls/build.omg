machine build(builder: &mut Build) {
    Build::application(builder, "joint_rank_declared_selector_repeated_calls_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main_x86);
    Build::bind(builder, linux_x86_64::ProgramEntry, main_x86);
    Build::bind(builder, macos_arm64::ProgramEntry, main_arm);
    Build::bind(builder, linux_arm64::ProgramEntry, main_arm);
    Build::select_provider<HostedSelector, X86Selector>(builder, windows_x86_64);
    Build::select_provider<HostedSelector, X86Selector>(builder, linux_x86_64);
    Build::select_provider<HostedSelector, ArmSelector>(builder, macos_arm64);
    Build::select_provider<HostedSelector, ArmSelector>(builder, linux_arm64);
}
