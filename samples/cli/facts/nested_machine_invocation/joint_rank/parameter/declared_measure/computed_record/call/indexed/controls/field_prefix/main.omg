// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Progress [copy] { lower: u64; upper: u64; canary: u64; }
data Batch [copy] { values: [Progress; 2]; canary: u64; }
machine distance(value: Progress) -> u64
requires value.lower <= value.upper
ensures result == value.upper - value.lower
terminates
{ value.upper - value.lower }
measure Progress::Remaining(value: Progress) -> u64 { distance(value) }
machine count(counter: &mut u64, remaining: Batch, slot: u64, untouched: u64) crashes Trap
requires slot < 2 && remaining.values[slot].lower <= remaining.values[slot].upper && remaining.values[slot].upper <= 7
terminates
terminates by remaining.values[slot] -> Progress::Remaining
{
    transition remaining.values[slot].lower < remaining.values[slot].upper {
        true -> forward(remaining, slot, untouched, counter)
        false -> finish(remaining, slot, untouched)
    }
    machine forward(mut pending: Batch, selected: u64, untouched: u64, counter: &mut u64) crashes Trap
    requires selected < 2 && pending.values[selected].lower < pending.values[selected].upper && pending.values[selected].upper <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        pending.values[selected].lower = pending.values[selected].lower + 1;
        transition { _ -> count(counter, pending, selected, untouched) }
    }
    machine finish(remaining: Batch, slot: u64, untouched: u64) crashes Trap
    requires slot < 2
    {
        let neighbor: bool = match slot == 0 {
            true -> remaining.values[1].lower == untouched
            false -> remaining.values[0].lower == untouched
        };
        transition remaining.values[slot].lower == remaining.values[slot].upper && neighbor &&
            remaining.values[0].canary == 641 && remaining.values[1].canary == 643 &&
            remaining.canary == 647 && remaining.values[0].upper == 7 && remaining.values[1].upper == 7 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, active: bool, second: bool) crashes Trap {
    let lower: u64 = match active { true -> 0 false -> 7 };
    let other_lower: u64 = match active { true -> 2 false -> 7 };
    let slot: u64 = match second { true -> 1 false -> 0 };
    let untouched: u64 = match second { true -> lower false -> other_lower };
    invoke(counter, Batch { canary: 647, values: [Progress { lower: lower, upper: 7, canary: 641 }, Progress { lower: other_lower, upper: 7, canary: 643 }] }, slot, untouched);
}
machine invoke(counter: &mut u64, received: Batch, slot: u64, untouched: u64) crashes Trap
requires slot < 2 && received.values[slot].lower <= received.values[slot].upper && received.values[slot].upper <= 7
{ count(counter, received, slot, untouched); }
machine main() crashes Trap {
    let mut first: u64 = 3;
    perform(&mut first, true, false);
    let active: bool = first == 10;
    perform(&mut first, false, false);
    let mut second: u64 = 3;
    perform(&mut second, true, true);
    let selected: bool = second == 8;
    perform(&mut second, false, true);
    transition active && selected && first == 10 && second == 8 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
