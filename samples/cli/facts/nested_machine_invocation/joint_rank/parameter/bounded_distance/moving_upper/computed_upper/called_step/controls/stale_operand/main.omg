// Expected exit: 0
machine bump(value: &mut u64) -> u64
ensures value == 7 && result == 1
{ value = 7; 1 }
machine add(left: u64, right: u64) -> u64
requires left < 10 && right < 10
ensures result == left + right
{ left + right }
machine consume(result: u64) requires result == 4 {}
machine exercise(value: &mut u64) requires value == 3 {
    consume(add(bump(value), value as u64));
}
machine main() { let mut value: u64 = 3; exercise(&mut value); }
