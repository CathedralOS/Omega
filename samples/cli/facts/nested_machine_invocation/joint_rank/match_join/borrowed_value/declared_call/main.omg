// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Remaining { canary: u64; count: u64; suffix: u64; }
machine distance(value: &Remaining) -> u64
ensures result == value.count
terminates
{ value.count }
measure Remaining::Rank(value: Remaining) -> u64 { distance(&value) }
machine count(counter: &mut u64, remaining: &mut Remaining) crashes Trap
terminates
terminates by remaining -> Remaining::Rank
requires remaining.count <= 7
{
    transition remaining.count > 0 {
        true -> forward(remaining, counter)
        false -> finish(remaining.canary)
    }
    machine forward(pending: &mut Remaining, counter: &mut u64) crashes Trap
    requires pending.count > 0 && pending.count <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        pending.count = pending.count - 1;
        transition { _ -> count(counter, pending) }
    }
    machine finish(canary: u64) crashes Trap {
        transition canary == 641 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool) crashes Trap {
    let mut full: Remaining = Remaining { canary: 641, count: 7, suffix: 919 };
    let mut empty: Remaining = Remaining { canary: 641, count: 0, suffix: 919 };
    let selected: &mut Remaining = match select { true -> &mut full false -> &mut empty };
    count(counter, selected);
    let full_done: bool = match select { true -> full.count == 0 false -> full.count == 7 };
    transition full_done && empty.count == 0 && full.canary == 641 && full.suffix == 919 && empty.canary == 641 && empty.suffix == 919 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
