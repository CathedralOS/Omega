// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Guard { stamp: u64; canary: u64; }
data Payload<'storage> [copy] { case Pending(count: u64, guard: &'storage Guard); case Empty; }
machine input<'storage>(guard: &'storage Guard, select: bool) -> Payload<'storage>
ensures (result in Payload::Empty) || ((result in Payload::Pending) && result.count <= 7);
{
    match select {
        true -> Payload::Pending { count: 8, guard: guard }
        false -> Payload::Empty
    }
}
machine replace<'storage>(value: &mut Payload<'storage>, guard: &'storage Guard, select: bool) -> bool {
    value = match select {
        true -> Payload::Empty
        false -> Payload::Pending { count: 19, guard: guard }
    };
    true
}
machine dispatch(counter: &mut u64, value: Payload, ignored: bool) crashes Trap
requires (value in Payload::Empty) || ((value in Payload::Pending) && value.count <= 7);
{
    transition value {
        Payload::Pending { count, guard } -> walk(counter, count, guard)
        Payload::Empty -> done()
    }
    machine walk(counter: &mut u64, pending: u64, guard: &Guard) crashes Trap
    terminates;
    terminates by pending;
    requires pending <= 7;
    {
        transition pending > 0 {
            true -> forward(pending, guard, counter)
            false -> finish(guard)
        }
        machine forward(pending: u64, guard: &Guard, counter: &mut u64) crashes Trap
        requires pending > 0 && pending <= 7;
        {
            counter = ((counter as u64 in Wrapping) + 1) as u64;
            transition { _ -> walk(counter, pending - 1, guard) }
        }
        machine finish(guard: &Guard) crashes Trap {
            transition guard.stamp == 827 && guard.canary == 641 { true -> done() false -> bad() }
        }
        machine done() {}
        machine bad() crashes Trap { crash Trap; }
    }
    machine done() {}
}
machine relay(counter: &mut u64, received: Payload, original: &mut Payload, spare: &Guard, select: bool) crashes Trap
requires (received in Payload::Empty) || ((received in Payload::Pending) && received.count <= 7);
{ transition { _ -> dispatch(counter, received, replace(original, spare, select)) } }
machine perform(counter: &mut u64, select: bool) crashes Trap {
    let guard: Guard = Guard { stamp: 827, canary: 641 };
    let spare: Guard = Guard { stamp: 919, canary: 641 };
    let mut value: Payload = input(&guard, select);
    let snapshot: Payload = value;
    relay(counter, snapshot, &mut value, &spare, select);
    let replacement_ok: bool = match value {
        Payload::Pending { count, guard } -> !select && count == 19 && guard.stamp == 919
        Payload::Empty -> select
    };
    transition replacement_ok && guard.stamp == 827 && guard.canary == 641 && spare.stamp == 919 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
