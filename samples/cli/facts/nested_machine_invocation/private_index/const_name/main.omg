// Every private arrival carries an in-bounds index, so the helper can read bytes[index].
// Expected exit: 0.
data Note { value: u64; tag: u64; }
const FIRST: u64 = 0;
const SECOND: u64 = 2;
machine probe(bytes: &[u64], select: bool) -> Note {
    transition select { true -> first(bytes) _ -> second(bytes) }
    machine first(bytes: &[u64]) -> Note {
        transition FIRST < bytes.len { true -> element(bytes, FIRST, true) _ -> Note { value: 0, tag: 0 } }
    }
    machine second(bytes: &[u64]) -> Note {
        transition SECOND < bytes.len { true -> element(bytes, SECOND, false) _ -> Note { value: 0, tag: 0 } }
    }
    machine element(bytes: &[u64], index: u64, select: bool) -> Note {
        let value: u64 = bytes[index];
        let tag: u64 = match select { true -> 11, false -> 13 };
        Note { value: value, tag: tag }
    }
}
machine main() crashes Trap {
    let bytes: [u64; 3] = [17, 29, 41];
    let empty: [u64; 0];
    let first: Note = probe(&bytes, true);
    let last: Note = probe(&bytes, false);
    let outside: Note = probe(&empty, true);
    transition first.value == 17 && first.tag == 11 && last.value == 41 && last.tag == 13 && outside.value == 0 && outside.tag == 0 {
        true -> done() _ -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
