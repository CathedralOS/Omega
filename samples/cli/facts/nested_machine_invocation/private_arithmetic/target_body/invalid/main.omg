// Every private arrival carries a positive value, so the helper can form value - 1.
data Note { value: u64; tag: u64; }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(value: u64, select: bool) -> Note
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine probe(value: u64, select: bool) -> Note
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        transition value > 0 {
            true -> apply(0, select)
            false -> Note { value: 0, tag: 0 }
        }
        machine apply(value: u64, select: bool) -> Note {
            let result: u64 = value - 1;
            let tag: u64 = match select { true -> 11, false -> 13 };
            Note { value: result, tag: tag }
        }
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(value: u64, select: bool) -> Note
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        transition value > 0 {
            true -> apply(0, select)
            false -> Note { value: 0, tag: 0 }
        }
        machine apply(value: u64, select: bool) -> Note {
            let result: u64 = value - 1;
            let tag: u64 = match select { true -> 11, false -> 13 };
            Note { value: result, tag: tag }
        }
    }
}


machine main() crashes Trap {
    let first: Note = SelectedProbe::probe(7, true);
    let second: Note = SelectedProbe::probe(9, false);
    let zero: Note = SelectedProbe::probe(0, true);
    transition first.value == 6 && first.tag == 11 && second.value == 8 && second.tag == 13 && zero.value == 0 && zero.tag == 0 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
