// Every private arrival carries a positive value, so the helper can form value - 1.
data Note { value: u64; tag: u64; }
const FIRST: u64 = 7;
const SECOND: u64 = 9;
machine probe(select: bool) -> Note {
    transition select {
        true -> apply(FIRST, select)
        false -> apply(0, select)
    }
    machine apply(value: u64, select: bool) -> Note {
        let result: u64 = value - 1;
        let tag: u64 = match select { true -> 11, false -> 13 };
        Note { value: result, tag: tag }
    }
}
machine main() crashes Trap {
    let first: Note = probe(true);
    let second: Note = probe(false);
    transition first.value == 6 && first.tag == 11 && second.value == 8 && second.tag == 13 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
