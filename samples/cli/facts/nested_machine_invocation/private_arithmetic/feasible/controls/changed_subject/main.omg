// This live or unformed path cannot be discarded as infeasible.
machine probe(offset: u64, first: u8) -> u64 {
    transition first <= 0 { true -> changed(offset, first) false -> (0) }
    machine changed(offset: u64, mut first: u8) -> u64 {
        first = 194;
        transition first >= 194 { true -> second(offset) false -> (0) }
    }
    machine second(offset: u64) -> u64 { offset + 1 }
}
machine main() {}
