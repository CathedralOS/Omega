// Every feasible private arrival carries offset < limit, so the helper can form offset + 1.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(limit: u64, offset: u64, first: u8) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine probe(limit: u64, offset: u64, first: u8) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        transition offset < limit {
            true -> lead(limit, offset, first)
            false -> (0)
        }
        machine lead(limit: u64, offset: u64, first: u8) -> u64 {
            transition first > 0 && first < 128 {
                true -> (0)
                false -> multibyte(limit, offset, first)
            }
        }
        machine multibyte(limit: u64, offset: u64, first: u8) -> u64 {
            let next: u64 = offset + 1;
            transition first >= 194 && first <= 244 && next <= limit {
                true -> second(limit, next)
                false -> (0)
            }
        }
        machine second(limit: u64, offset: u64) -> u64 { offset + 1 }
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(limit: u64, offset: u64, first: u8) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        transition offset < limit {
            true -> lead(limit, offset, first)
            false -> (0)
        }
        machine lead(limit: u64, offset: u64, first: u8) -> u64 {
            transition first > 0 && first < 128 {
                true -> (0)
                false -> multibyte(limit, offset, first)
            }
        }
        machine multibyte(limit: u64, offset: u64, first: u8) -> u64 {
            let next: u64 = offset + 1;
            transition first >= 194 && first <= 244 && next <= limit {
                true -> second(limit, next)
                false -> (0)
            }
        }
        machine second(limit: u64, offset: u64) -> u64 { offset + 1 }
    }
}


machine main() crashes Trap {
    let first: u64 = SelectedProbe::probe(20, 4, 194);
    let second: u64 = SelectedProbe::probe(20, 8, 241);
    let ascii: u64 = SelectedProbe::probe(20, 3, 65);
    let nul: u64 = SelectedProbe::probe(20, 3, 0);
    let invalid: u64 = SelectedProbe::probe(20, 3, 255);
    let no_room: u64 = SelectedProbe::probe(20, 19, 194);
    let outside: u64 = SelectedProbe::probe(0, 0, 194);
    transition first == 6 && second == 10 && ascii == 0 && nul == 0 && invalid == 0 && no_room == 0 && outside == 0 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
