// Public inputs need their own bound, regardless of currently known callers.
public machine subtract(value: u64) -> u64 { value - 1 }
machine main() crashes Trap {
    let first: u64 = subtract(7);
    let second: u64 = subtract(9);
    transition first == 6 && second == 8 { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
