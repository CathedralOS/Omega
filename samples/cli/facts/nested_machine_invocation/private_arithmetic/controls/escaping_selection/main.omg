// An escaping helper cannot infer a bound from only its direct callers.
machine invoke<machine Transform>(value: u64) -> u64
where machine Transform(input: u64) -> u64;
{ Transform(value) }
machine probe(value: u64, select: bool) -> u64 {
    let ignored: u64 = invoke<apply>(0);
    transition value > 0 { true -> apply(value) false -> 0 }
    machine apply(value: u64) -> u64 { value - 1 }
}
machine main() crashes Trap {
    let first: u64 = probe(7, true);
    let second: u64 = probe(9, false);
    let zero: u64 = probe(0, true);
    transition first == 6 && second == 8 && zero == 0 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
