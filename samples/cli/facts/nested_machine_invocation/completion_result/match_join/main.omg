// Every normal completion supplies the declared u8 result, so transporting the selected result preserves its value.
// Expected exit: 0
machine select(ready: bool) -> u8 {
    transition ready { true -> 37u8 false -> 19u8 }
}
machine joined(first: bool) -> u8 {
    transition first { true -> select(false) false -> select(true) }
}
machine main() crashes Trap {
    let value: u8 = joined(true);
    let joined_alternate: u8 = joined(false);
    let alternate: u8 = select(true);
    transition value == 19 && alternate == 37 && joined_alternate == 37 { true -> {} false -> bad() }
    machine bad() crashes Trap { crash Trap; }
}
