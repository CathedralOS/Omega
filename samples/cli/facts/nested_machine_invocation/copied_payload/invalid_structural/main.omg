// A copied case payload ends its source observation before the helper mutates that source.
// The borrowed non-copy payload cannot transfer to an owned formal.
data Contents { first: u64; second: u64; }
data Choice { case Present(value: Contents); case Empty; }
data Holder { head: u64; choice: Choice; tail: u64; }
machine take(holder: &mut Holder) -> bool {
    transition holder.choice {
        Choice::Present { value } -> clear(holder, value)
        Choice::Empty -> false
    }
    machine clear(holder: &mut Holder, captured: Contents) -> bool {
        holder.choice = Choice::Empty;
        captured.first == 17 && captured.second == 25 && holder.head == 641 && holder.tail == 967
    }
}
machine main() crashes Trap {
    let mut holder: Holder = Holder { head: 641, choice: Choice::Present { value: Contents { first: 17, second: 25 } }, tail: 967 };
    let captured: bool = take(&mut holder);
    let empty: bool = take(&mut holder);
    transition captured && !empty && holder.head == 641 && holder.tail == 967 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
