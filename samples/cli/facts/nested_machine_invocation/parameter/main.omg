// A nested machine preserves its enclosing type when returning an explicitly supplied value.
// Expected exit: 0
machine identity<T>(value: T) -> T {
    keep(value)
    machine keep(item: T) -> T { item }
}
machine main() crashes Trap { check(42); }
machine check(value: u64) crashes Trap {
    let result: u64 = identity<u64>(value);
    transition result == 42 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
