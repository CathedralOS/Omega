machine build(builder: &mut Build) {
    Build::application(builder, "nested_unit_output_target_body");
    Build::depend(builder, Source::Path { location: "../../../../../../source/library/std" });
    Build::select_provider<HostedInstaller, HostedInstallerBody>(builder, windows_x86_64);
    Build::select_provider<HostedInstaller, HostedInstallerBody>(builder, linux_x86_64);
    Build::select_provider<HostedInstaller, HostedInstallerBody>(builder, macos_arm64);
    Build::select_provider<HostedInstaller, HostedInstallerBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
