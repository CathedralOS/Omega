// Expected exit: 0
// A returned view retains logical facts and invalidates possible backing.
machine lend(value: &mut u64) -> &mut u64
requires value == 5
ensures value == 5
ensures result == 5
{ value }
machine write(value: &mut u64)
ensures value == 9
{ value = 9; }
machine require_five(value: u64) requires value == 5 {}
machine main() crashes Trap {
    let mut value: u64 = 5;
    let alias: &mut u64 = lend(&mut value);
    let before: u64 = alias;
    alias = 9;
    let gap: u64 = alias - 9;
    require_five(before);
    transition before == 5 && gap == 0 && value == 9 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
