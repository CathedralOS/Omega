// An exact returned mutable view observes its current post-call value while earlier scalar observations stay unchanged.
// Expected exit: 0
machine lend(value: &mut u64) -> &mut u64
requires value == 5
ensures value == 5
ensures result == 5
{ value }
machine write(value: &mut u64)
ensures value == 9
{ value = 9; }
data Holder { pointer: &mut u64; }
machine main() crashes Trap {
    let mut value: u64 = 5;
    let holder: Holder = Holder { pointer: lend(&mut value) };
    let before: u64 = holder.pointer;
    write(holder.pointer);
    let gap: u64 = holder.pointer - 9;
    transition before == 5 && gap == 0 && value == 9 { true -> done() false -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
