// A terminal invocation forwards its normal value and explicit mutable backing without introducing a caller continuation.
// Expected exit: 0.
public machine tick() blocks {}
machine identity(value: u64) -> u64 ensures result == value { value }
machine cycle(counter: &mut u64, value: u64, remaining: u64, select: bool) -> u64 {
    transition remaining > 0 { true -> block step(counter, value, remaining, select) _ -> value }
}
machine step(counter: &mut u64, value: u64, remaining: u64, select: bool) -> u64
    requires remaining > 0 {
        counter = (counter as u64 in Wrapping + 1) as u64;
        block tick();
        transition { _ -> identity(block cycle(counter, value, remaining - 1, select)) }
    }
machine main() crashes Trap {
    let mut counter: u64 = 0;
    let first: u64 = block cycle(&mut counter, 17, 100000, true);
    let last: u64 = block cycle(&mut counter, 41, 100000, false);
    let empty: u64 = block cycle(&mut counter, 0, 0, true);
    transition first == 17 && last == 41 && empty == 0 && counter == 200000 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
