// Expected exit: 0
// Rebinding a shared byte-view parameter retains its declared descriptor identity and observes replacement backing without mutating either backing.
machine identity<'storage>(view: @'storage [u8]) -> @'storage [u8] requires view.length == 1 ensures result.length == 1 { view }
machine replace(mutable selected: @[u8], replacement: @[u8]) -> u8
requires selected.length == 1 && replacement.length == 1 {
    selected = replacement;
    selected = replacement;
    selected[0]
}
machine finish(observed: u8, original: @[u8], replacement: @[u8]) crashes Trap
requires original.length == 1 && replacement.length == 1 {
    transition observed == 29 && original[0] == 5 && replacement[0] == 29 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine from_parameter(selected: @[u8], replacement: @[u8]) -> u8
requires selected.length == 1 && replacement.length == 1 { replace(selected, replacement) }
machine main() crashes Trap {
    let original: [u8; 1] = [5];
    let replacement: [u8; 1] = [29];
    let observed: u8 = from_parameter(@original[..], @replacement[..]);
    finish(observed, @original[..], @replacement[..]);
}
