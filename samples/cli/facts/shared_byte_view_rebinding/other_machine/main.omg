// Expected exit: 0
// Rebinding a shared byte-view parameter retains its declared descriptor identity and observes replacement backing without mutating either backing.
machine identity<'storage>(view: &'storage [u8]) -> &'storage [u8] requires view.len == 1 ensures result.len == 1 { view }
machine replace(mut selected: &[u8], replacement: &[u8]) -> u8
requires selected.len == 1 && replacement.len == 1 {
    selected = replacement;
    selected = replacement;
    selected[0]
}
machine finish(observed: u8, original: &[u8], replacement: &[u8]) crashes Trap
requires original.len == 1 && replacement.len == 1 {
    transition observed == 29 && original[0] == 5 && replacement[0] == 29 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
machine forwarded<'storage>(view: &'storage [u8]) -> &'storage [u8] requires view.len == 1 ensures result.len == 1 { identity(view) }
machine main() crashes Trap {
    let original: [u8; 1] = [5];
    let replacement: [u8; 1] = [29];
    let selected: &[u8] = forwarded(&original[..]);
    let observed: u8 = replace(selected, &replacement[..]);
    finish(observed, &original[..], &replacement[..]);
}
