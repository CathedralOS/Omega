// A library Token retains its declaring owner when it reaches library::read.
// Expected exit: 0
use shared::copied::Token;
use shared::library::read;
machine transported() -> u8 { let token: Token = match true { true -> Token { value: 7 }, _ -> Token { value: 7 } }; read(token) }
machine main() crashes Trap {
    transition transported() == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
