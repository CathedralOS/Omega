// A library Token retains its declaring owner when it reaches |shared_library|::read.
// Expected exit: 0
use {shared}/library/library.omg as shared_library;
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches none crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReceive {
    machine receive(token: |shared_library|::Token) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Receive satisfies SelectedReceive {
    machine receive(token: |shared_library|::Token) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     |shared_library|::read(token)
    }
}

ArmReceive satisfies SelectedReceive {
    machine receive(token: |shared_library|::Token) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     |shared_library|::read(token)
    }
}


machine transported() -> u8 { SelectedReceive::receive(|shared_library|::Token { value: 7 }) }
machine main() crashes Trap {
    transition transported() == 7 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
