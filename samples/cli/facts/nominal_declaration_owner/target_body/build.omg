use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "owner_target_body" };
    let mutable shared_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../library" });
    |dependency|::with_alias(@mutable shared_dependency, "shared");
    let shared_registration: DependencyRegistration = Build::dependency(builder, shared_dependency);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::select_provider::<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider::<SelectedReceive, X86Receive>(builder, windows_x86_64);
    Build::select_provider::<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider::<SelectedReceive, X86Receive>(builder, linux_x86_64);
    Build::select_provider::<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider::<SelectedReceive, ArmReceive>(builder, macos_arm64);
    Build::select_provider::<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider::<SelectedReceive, ArmReceive>(builder, linux_arm64);
}
