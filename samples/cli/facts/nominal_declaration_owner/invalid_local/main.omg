// A library Token retains its declaring owner when it reaches |shared_library|::read.
// Expected exit: 0
use {shared}/copied/copied.omg;
use {shared}/library/library.omg as shared_library;
machine transported() -> u8 { let token: |copied|::Token = |copied|::Token { value: 7 }; |shared_library|::read(token) }
machine main() crashes Trap {
    transition transported() == 7 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
