// Fact: sign-extending -28i8 to i64 and adding zero-extended 128u8 as i64 yields 100u64 when subtracting 100u64.
// Place: parameter (invalid twin). Initial signed value is -29i8 resulting in 99u64, which underflows exact subtraction extended - 100u64.
// Expected diagnostic: exact subtraction underflow

machine pass_through(param: u64) -> u64
    ensures result == param
{
    param
}

machine evaluate() -> i32 {
    let s: i64 = ((-29i8 as i16) as i32) as i64;
    let u: i64 = (((128u8 as u16) as u32) as u64) as i64;
    let sum: i64 = s + u;
    let extended: u64 = pass_through(sum as u64);
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
