// Fact: sign-extending -28i8 to i64 and adding zero-extended 128u8 as i64 yields 100u64 when subtracting 100u64.
// Place: another machine. A forwarding machine transports the extended sum through an intermediate machine call.
// Expected exit: 0

machine target_machine(val: u64) -> u64
    ensures result == val
{
    val
}

machine forwarder(val: u64) -> u64
    ensures result == val
{
    target_machine(val)
}

machine evaluate() -> i32 {
    let s: i64 = ((-28i8 as i16) as i32) as i64;
    let u: i64 = (((128u8 as u16) as u32) as u64) as i64;
    let sum: i64 = s + u;
    let extended: u64 = forwarder(sum as u64);
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
