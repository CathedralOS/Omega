// A provider-settled boundary call whose contract establishes result >= 100u64 && result <= 100u64 discharges exact subtraction result - 100u64.
// Expected exit: 0.
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 100u64 && result <= 100u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 100u64 && result <= 100u64 {
        100
    }
}

machine compute(result: u64) -> u64
requires result >= 100u64 && result <= 100u64
{
    result - 100u64
}

machine main() reaches Provider crashes Trap {
    let diff: u64 = compute(Provider::get());
    transition diff == 0u64 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
