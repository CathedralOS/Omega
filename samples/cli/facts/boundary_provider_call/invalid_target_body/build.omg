machine build(builder: &mut Build) {
    Build::application(builder, "boundary_provider_call");
    Build::select_provider<Provider, Actual>(builder, linux_arm64);
    Build::select_provider<Provider, Actual>(builder, linux_x86_64);
    Build::select_provider<Provider, Actual>(builder, macos_arm64);
    Build::select_provider<Provider, Actual>(builder, macos_x86_64);
    Build::select_provider<Provider, Actual>(builder, windows_x86_64);
    Build::select_provider<Provider, Actual>(builder, uefi_x86_64);
    Build::select_provider<Provider, Actual>(builder, cross_platform_cli);
    Build::select_provider<Provider, Actual>(builder, local_unchecked);
    Build::select_provider<Provider, Actual>(builder, alpha_bootstrap);
    Build::bind(builder, macos_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider<SelectedCompute, X86Compute>(builder, macos_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedCompute, ArmCompute>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedCompute, X86Compute>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedCompute, ArmCompute>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedCompute, X86Compute>(builder, windows_x86_64);
}
