// A provider-settled boundary call whose contract establishes result >= 100u64 && result <= 100u64 discharges exact subtraction result - 100u64.
// Expected rejection: exact arithmetic in machine compute state entry terminal expression may overflow `u64`.
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 99u64 && result <= 99u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 99u64 && result <= 99u64 {
        99
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedCompute {
    machine compute() -> u64 reaches Provider reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Provider crashes Trap;
}
X86Compute satisfies SelectedCompute {
    machine compute() -> u64 reaches Provider reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Provider crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        Provider::get() - 100u64
    }
}
ArmCompute satisfies SelectedCompute {
    machine compute() -> u64 reaches Provider reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Provider crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        Provider::get() - 100u64
    }
}


machine main() reaches Provider, SelectedBodyCheck crashes Trap {
    let diff: u64 = SelectedCompute::compute();
    transition diff == 0u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
