// A provider-settled boundary call whose contract establishes result >= 100u64 && result <= 100u64 discharges exact subtraction result - 100u64.
// Expected rejection: exact arithmetic in machine compute state entry terminal expression may overflow `u64`.
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 99u64 && result <= 99u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 99u64 && result <= 99u64 {
        99
    }
}

linux_x86_64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

linux_arm64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

windows_x86_64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

macos_arm64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

machine main() reaches Provider crashes Trap {
    let diff: u64 = compute();
    transition diff == 0u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
