// Fact: a 32-bit unsigned u32 exact multiplication of bounded inputs (lhs >= 20u32 && lhs <= 30u32, rhs >= 15u32 && rhs <= 25u32) establishes prod >= 300u32 && prod <= 750u32 so exact 32-bit subtractions 750u32 - prod and prod - 300u32 are proved overflow-free across all nine places.
// Place: call result. The product is received from a helper call returning the multiplication result.
// Expected exit: 0

machine compute_prod(l: u32, r: u32) -> u32
    requires l >= 20u32 && l <= 30u32;
    requires r >= 15u32 && r <= 25u32;
    ensures result >= 300u32 && result <= 750u32;
{
    l * r
}

machine divide_call_result(lhs: u32, rhs: u32) -> i32
    requires lhs >= 20u32 && lhs <= 30u32;
    requires rhs >= 15u32 && rhs <= 25u32;
{
    let prod: u32 = compute_prod(lhs, rhs);
    let headroom: u32 = 750u32 - prod;
    let margin: u32 = prod - 300u32;
    transition prod == 500u32 && headroom + margin == 450u32 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_call_result(25u32, 20u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
