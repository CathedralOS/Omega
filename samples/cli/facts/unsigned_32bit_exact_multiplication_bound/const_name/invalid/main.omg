// Fact: a 32-bit unsigned u32 exact multiplication of bounded inputs (lhs >= 20u32 && lhs <= 30u32, rhs >= 15u32 && rhs <= 25u32) establishes prod >= 300u32 && prod <= 750u32 so exact 32-bit subtractions 750u32 - prod and prod - 300u32 are proved overflow-free across all nine places.
// Place: const name. The bounds and product limits reference declared symbolic constants.
// Invalid control: rhs upper bound widened to 26u32, allowing product up to 780u32 and failing subtraction 750u32 - prod.
// Expected rejection: may overflow `u32`

const LHS_MIN: u32 = 20u32;
const LHS_MAX: u32 = 30u32;
const RHS_MIN: u32 = 15u32;
const RHS_MAX: u32 = 26u32;
const PROD_MIN: u32 = 300u32;
const PROD_MAX: u32 = 750u32;

machine multiply_const(lhs: u32, rhs: u32) -> i32
    requires lhs >= LHS_MIN && lhs <= LHS_MAX;
    requires rhs >= RHS_MIN && rhs <= RHS_MAX;
{
    let prod: u32 = lhs * rhs;
    let headroom: u32 = PROD_MAX - prod;
    let margin: u32 = prod - PROD_MIN;
    transition prod == 500u32 && headroom + margin == 450u32 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_const(25u32, 20u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
