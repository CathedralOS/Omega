// The admitted Choice disjunction justifies select's complete entry contract, whose returned value <= 60 permits Counter construction and exact value + 195.
// Expected exit: 0
data Choice [copy] requires self.left <= 61 || self.right <= 60 { left: u8; right: u8; }
data Counter [copy] requires self.value <= 60 { value: u8; }
machine select(left: u8, right: u8) -> u8
requires left <= 60 || right <= 60
ensures result <= 60
{
    transition left <= 60 { true -> bounded(left) false -> bounded(right) }
    machine bounded(value: u8) -> u8
    requires value <= 60
    ensures result <= 60
    { value }
}
machine total(counter: Counter) -> u8 { counter.value + 195 }
data Envelope [copy] { before: u64; choice: Choice; after: u64; }
machine make(envelope: Envelope) -> Counter {
    let selected: u8 = select(envelope.choice.left, envelope.choice.right);
    Counter { value: selected }
}
machine main() crashes Trap {
    let left: Envelope = Envelope { before: 91, choice: Choice { left: 17, right: 200 }, after: 93 };
    let right: Envelope = Envelope { before: 95, choice: Choice { left: 200, right: 43 }, after: 97 };
    let first: Counter = make(left);
    let second: Counter = make(right);
    transition total(first) == 212 && total(second) == 238 && left.before == 91 && left.after == 93 && right.before == 95 && right.after == 97 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
