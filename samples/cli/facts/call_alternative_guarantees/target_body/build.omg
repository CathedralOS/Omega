machine build(builder: &mut Build) {
    Build::application(builder, "call_alternative_guarantees_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Choose, HostedChoose>(builder, windows_x86_64);
    Build::select_provider<Choose, HostedChoose>(builder, linux_x86_64);
    Build::select_provider<Choose, HostedChoose>(builder, macos_arm64);
    Build::select_provider<Choose, HostedChoose>(builder, linux_arm64);
}
