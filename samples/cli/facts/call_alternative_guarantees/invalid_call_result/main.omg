// The admitted Choice disjunction justifies select's complete entry contract, whose returned value <= 60 permits Counter construction and exact value + 195.
// Expected exit: 0
data Choice [copy] requires self.left <= 61 || self.right <= 60 { left: u8; right: u8; }
data Counter [copy] requires self.value <= 60 { value: u8; }
machine select(left: u8, right: u8) -> u8
requires left <= 60 || right <= 60
ensures result <= 60
{
    transition left <= 60 { true -> bounded(left) false -> bounded(right) }
    machine bounded(value: u8) -> u8
    requires value <= 60
    ensures result <= 60
    { value }
}
machine total(counter: Counter) -> u8 { counter.value + 195 }
machine forward(choice: Choice) -> Choice { choice }
machine make(choice: Choice) -> Counter {
    let selected: u8 = select(choice.left, choice.right);
    Counter { value: selected }
}
machine main() crashes Trap {

    let first: Counter = make(forward(Choice { left: 17, right: 200 }));
    let second: Counter = make(forward(Choice { left: 200, right: 43 }));
    transition first.value == 17 && second.value == 43 && total(first) == 212 && total(second) == 238 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
