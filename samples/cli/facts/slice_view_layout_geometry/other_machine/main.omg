// Fact: querying size_of and align_of on a 64-bit slice view (&[u64]) establishes its exact two-word (ptr, len) descriptor geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: another machine. An intermediate forwarding machine delegates the subtraction to the geometry query machine.
// Expected exit: 0

machine query_geometry() -> u64 {
    let s: u64 = size_of<&[u64]>();
    let a: u64 = align_of<&[u64]>();
    s - (a * 2u64)
}

machine runner() -> u64 {
    query_geometry()
}

machine main() crashes Trap {
    let diff: u64 = runner();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
