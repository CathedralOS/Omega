// Fact: querying size_of and align_of on a 64-bit slice view (&[u64]) establishes its exact two-word (ptr, len) descriptor geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Invalid: querying thin pointer &u64 (size == 8u64, align == 8u64), so size - (align * 2u64) in compute state underflows u64.
// Expected exit: 0

machine main() crashes Trap {
    let s: u64 = size_of<&u64>();
    let a: u64 = align_of<&u64>();
    transition true {
        true -> compute(s, a)
        _ -> bad()
    }
    machine compute(size: u64, align: u64) {
        let diff: u64 = size - (align * 2u64);
        transition diff == 0 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
