// Fact: querying size_of and align_of on a 64-bit slice view (&[u64]) establishes its exact two-word (ptr, len) descriptor geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: match join. Both match arms evaluate the size and alignment queries and join before subtracting.
// Expected exit: 0

machine main() crashes Trap {
    let s: u64 = size_of<&[u64]>();
    let a: u64 = align_of<&[u64]>();
    let joined_size: u64 = match s == 16 {
        true -> s
        _ -> s
    };
    let joined_align: u64 = match a == 8 {
        true -> a
        _ -> a
    };
    let diff: u64 = joined_size - (joined_align * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
