// Binding mutability does not change owned transfer or authorize a second read.
// Expected exit: 0
data Value { value: i64; }
machine overwrite(source: &mut Value) -> bool {
    source.value = 9;
    true
}
machine compare(mut first: Value, changed: bool) -> bool {
    let captured: bool = first.value == 7;
    first.value = 41;
    captured && changed && first.value == 41
}
machine probe(mut source: Value) -> bool {
    source = Value { value: 7 };
    compare(source, overwrite(&mut source))
}
machine main() crashes Trap {
    transition probe(Value { value: 17 }) {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
