// Replacing one input-carrier reference retains its new backing and the untouched sibling.
// Expected exit: 0
data Cell { value: i64; }
data Views<'storage> { first: &'storage Cell; second: &'storage Cell; }
data Bundle<'storage> { entries: [Views<'storage>; 1]; }

machine observe<'storage>(bundle: &Bundle<'storage>) -> bool {
    bundle.entries[0].first.value == 41 && bundle.entries[0].second.value == 19
}

machine replace<'storage>(mut bundle: Bundle<'storage>, incoming: &'storage Cell) -> bool {
    bundle.entries[0].first = incoming;
    observe(&bundle)
}

machine main() crashes Trap {
    let old: Cell = Cell { value: 17 };
    let new: Cell = Cell { value: 41 };
    let sibling: Cell = Cell { value: 19 };
    let bundle: Bundle = Bundle { entries: [Views { first: &old, second: &sibling }] };
    transition replace(bundle, &new) && old.value == 17 && sibling.value == 19 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
