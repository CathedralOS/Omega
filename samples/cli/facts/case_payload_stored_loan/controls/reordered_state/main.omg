// A returned variant carries the exclusive loan to its original backing; writing 41 through the active payload changes only that backing.
// Reordered state inputs must preserve both selected backing and absent payloads.
// Expected exit: 0
data Cell { value: i64; }
data Loan<'storage> { case Active(target: &'storage mut Cell); case Empty; }
machine lend<'storage>(source: &'storage mut Cell) -> Loan<'storage> {
    Loan::Active { target: source }
}
machine forward<'storage>(first: Loan<'storage>, second: Loan<'storage>) -> Loan<'storage> {
    transition { _ -> finish(second, first) }
    machine finish(selected: Loan<'storage>, unused: Loan<'storage>) -> Loan<'storage> { selected }
}
machine store(target: &mut Cell, value: i64) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine consume<'storage>(loan: Loan<'storage>, value: i64) -> bool requires value == 41 {
    transition loan {
        Loan::Active { target } -> (store(&mut target, value))
        Loan::Empty -> false
    }
}
machine main() crashes Trap {
    let mut backing: Cell = Cell { value: 17 };
    let mut sibling: Cell = Cell { value: 19 };
    let active: Loan = forward(Loan::Empty, lend(&mut backing));
    let written: bool = consume(active, 41);
    let absent: Loan = forward(lend(&mut sibling), Loan::Empty);
    let unwritten: bool = consume(absent, 41);
    transition written && !unwritten && backing.value == 41 && sibling.value == 19 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
