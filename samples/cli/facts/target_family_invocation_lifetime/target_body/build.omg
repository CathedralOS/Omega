use main.omg as app;
machine build(builder: @mutable BuildPlan) {
 Build::select_provider::<|app|::SelectedApply, |app|::LinuxArm64Apply>(builder, linux_arm64);
 Build::select_provider::<|app|::SelectedApply, |app|::LinuxX8664Apply>(builder, linux_x86_64);
 Build::select_provider::<|app|::SelectedApply, |app|::MacosArm64Apply>(builder, macos_arm64);
 Build::select_provider::<|app|::SelectedApply, |app|::WindowsX8664Apply>(builder, windows_x86_64);
 Build::select_provider::<|app|::SelectedVerify, |app|::WindowsX8664Verify>(builder, windows_x86_64);
 Build::select_provider::<|app|::SelectedVerify, |app|::WindowsX8664Verify>(builder, linux_x86_64);
 Build::select_provider::<|app|::SelectedVerify, |app|::WindowsX8664Verify>(builder, macos_arm64);
 Build::select_provider::<|app|::SelectedVerify, |app|::WindowsX8664Verify>(builder, linux_arm64);

    builder.product = BuildProduct::Application { name: "target_family_const_callback_guarantee" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
