// Every selected implementation retains a fresh invocation lifetime and the returned item reference independently of captured context storage.
// Expected exit: 0.
data Holder<'held> { reference: &'held u64; }
machine pick<'call, Context>(context: Context, item: &'call u64) -> &'call u64 { item }

boundary trait SelectedApply {
 machine apply<'item, 'held, Context, machine Selected>(context: Holder<'held>, item: &'item u64) -> &'item u64
requires machine Selected<'fresh>(environment: Holder<'held>, value: &'fresh u64) -> &'fresh u64;
 reaches;
}
LinuxArm64Apply satisfies SelectedApply {
 machine apply<'item, 'held, Context, machine Selected>(context: Holder<'held>, item: &'item u64) -> &'item u64
requires machine Selected<'fresh>(environment: Holder<'held>, value: &'fresh u64) -> &'held u64;
{ Selected(context, item) }
}

LinuxX8664Apply satisfies SelectedApply {
 machine apply<'borrow, 'capture, Environment, machine Callback>(context: Holder<'capture>, item: &'borrow u64) -> &'borrow u64
requires machine Callback<'call>(environment: Holder<'capture>, value: &'call u64) -> &'call u64;
{ Callback(context, item) }
}

MacosArm64Apply satisfies SelectedApply {
 machine apply<'scope, 'region, Capture, machine Operation>(context: Holder<'region>, item: &'scope u64) -> &'scope u64
requires machine Operation<'invocation>(environment: Holder<'region>, value: &'invocation u64) -> &'invocation u64;
{ Operation(context, item) }
}

WindowsX8664Apply satisfies SelectedApply {
 machine apply<'storage, 'environment, Captured, machine Action>(context: Holder<'environment>, item: &'storage u64) -> &'storage u64
requires machine Action<'use>(environment: Holder<'environment>, value: &'use u64) -> &'use u64;
{ Action(context, item) }
}

machine relay<'captured, 'value>(context: Holder<'captured>, item: &'value u64) -> &'value u64 {
    SelectedApply::apply<Holder<'captured>, pick<Holder<'captured>>>(context, item)
}
machine done() {}
machine wrong() crashes Trap { crash Trap; }
machine main() crashes Trap {
    let left: u64 = 17;
    let right: u64 = 42;
    let context: Holder = Holder { reference: &left };
    let result: &u64 = relay(context, &right);
    transition result == 42 { true -> done() false -> wrong() }
}
