// Fact: a 16-bit signed i16 left shift of a bounded input (val >= 30i16 && val <= 30i16) by 2u32 bits establishes shifted >= 120i16 && shifted <= 120i16 so exact 16-bit signed subtraction shifted - 120i16 is proved overflow-free across all nine places.
// Expected exit: 0

machine verify_shifted(shifted: i16) -> i32
    requires shifted >= 120 && shifted <= 120
{
    let check: i16 = shifted - 120;
    check as i32
}

machine produce_shifted(val: i16) -> i16
    requires val >= 30 && val <= 30
    ensures result >= 120 && result <= 120
{
    val << 2u32
}

machine main() crashes Trap {
    let val: i16 = 30;
    let shifted: i16 = produce_shifted(val);
    let check: i32 = verify_shifted(shifted);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
