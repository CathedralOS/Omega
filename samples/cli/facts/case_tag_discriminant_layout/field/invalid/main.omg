// Constructing and matching a multi-variant case value preserves its exact variant payload bound (payload <= 64u64) alongside its target layout geometry (size_of / align_of), discharging exact subtraction 64u64 - payload across all nine places.

data Packet [copy] {
    case Empty;
    case Bounded(payload: u64) where payload <= 80u64;
}

data Holder [copy] {
    packet: Packet;
}

machine eval(holder: Holder) -> u64
    ensures result <= 64u64
{
    let s: u64 = size_of<Packet>();
    let a: u64 = align_of<Packet>();
    let geometry_diff: u64 = (s + a) - 24u64;
    let packet: Packet = holder.packet;
    transition geometry_diff == 0 {
        true -> inspect(packet)
        _ -> 0u64
    }
    machine inspect(p: Packet) -> u64 {
        transition p {
            Packet::Bounded { payload } -> (64u64 - payload)
            Packet::Empty {} -> 0u64
        }
    }
}

machine main() crashes Trap {
    let a: Holder = Holder { packet: Packet::Bounded { payload: 24u64 } };
    let b: Holder = Holder { packet: Packet::Empty {} };
    transition eval(a) == 40u64 && eval(b) == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
