// Constructing and matching a multi-variant case value preserves its exact variant payload bound (payload <= 64u64) alongside its target layout geometry (size_of / align_of), discharging exact subtraction 64u64 - payload across all nine places.
// Expected exit: 0

data Packet [copy] {
    case Empty;
    case Bounded(payload: u64) where payload <= 64u64;
}

machine choose(flag: bool, first: Packet, second: Packet) -> Packet {
    transition flag {
        true -> first
        false -> second
    }
}

machine eval(packet: Packet) -> u64
    ensures result <= 64u64
{
    let s: u64 = size_of<Packet>();
    let a: u64 = align_of<Packet>();
    let geometry_diff: u64 = (s + a) - 24u64;
    transition geometry_diff == 0 {
        true -> inspect(packet)
        _ -> 0u64
    }
    machine inspect(p: Packet) -> u64 {
        transition p {
            Packet::Bounded { payload } -> (64u64 - payload)
            Packet::Empty {} -> 0u64
        }
    }
}

machine main() crashes Trap {
    let bounded: Packet = Packet::Bounded { payload: 24u64 };
    let empty: Packet = Packet::Empty {};
    let joined_bounded: Packet = choose(true, bounded, empty);
    let joined_empty: Packet = choose(false, bounded, empty);
    transition eval(joined_bounded) == 40u64 && eval(joined_empty) == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
