// Bounded u64 operands `a [0..=50]` and `b [0..=50]` make the exact product
// `a * b` fit `u64 [0..=2500]`; no Wrapping domain and no `as`.
// Place: match join. Both arms keep the operands inside their bounds, so the
// joined operands still multiply exactly.
// Expected exit: 0
machine mul(a: u64 [0..=50], b: u64 [0..=50], flag: bool) -> u64 [0..=2500] {
    let left: u64 = match flag { true -> a, false -> b };
    let right: u64 = match flag { true -> b, false -> a };
    left * right
}

machine probe(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=2500] {
    mul(a, b, true)
}

machine main() crashes Trap {
    transition probe(30, 40) == 1200 && probe(50, 50) == 2500 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
