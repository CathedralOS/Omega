// Bounded u64 factors a <= 50 and b <= 50 make a * b fit in result <= 2500 without a domain or widening.
// Place: match join. Both arms keep the operands inside their bounds, so the
// joined operands still multiply exactly.
// Expected exit: 0
machine mul(a: u64, b: u64, flag: bool) -> u64
requires a <= 50 && b <= 50
ensures result <= 2500
{
    let left: u64 = match flag { true -> a, false -> b };
    let right: u64 = match flag { true -> b, false -> a };
    left * right
}

machine probe(a: u64, b: u64) -> u64
requires a <= 50 && b <= 50
ensures result <= 2500
{
    mul(a, b, true)
}

machine main() crashes Trap {
    transition probe(30, 40) == 1200 && probe(50, 50) == 2500 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
