// Bounded u64 factors a <= 50 and b <= 50 make a * b fit in result <= 2500 without a domain or widening.
// Place: local. Both bounded operands are copied into locals before multiplying.
// Expected exit: 0
machine mul(a: u64, b: u64) -> u64
requires a <= 50 && b <= 50
ensures result <= 2500
{
    let left: u64 = a;
    let right: u64 = b;
    left * right
}

machine probe(a: u64, b: u64) -> u64
requires a <= 50 && b <= 50
ensures result <= 2500
{
    mul(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 1200 && probe(50, 50) == 2500 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
