machine build(builder: &mut Build) {
    Build::select_provider<SelectedMul, CheckedMul>(builder, linux_x86_64);
    Build::select_provider<SelectedMul, CheckedMul>(builder, linux_arm64);
    Build::select_provider<SelectedMul, CheckedMul>(builder, macos_arm64);
    Build::select_provider<SelectedMul, CheckedMul>(builder, windows_x86_64);

    Build::application(builder, "bounded_products_target_body_invalid");
}
