// Bounded u64 factors a <= 50 and b <= 50 make a * b fit in result <= 2500 without a domain or widening.
// Place: another target body. Every target body multiplies the bounded operands.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedMul {
    machine mul(a: u64, b: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires a <= 50 && b <= 50 ensures result <= 2500;
}

X86Mul satisfies SelectedMul {
    machine mul(a: u64, b: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires a <= 50 && b <= 50 ensures result <= 2500
    {
        SelectedBodyCheck::require_tag(17u64);
        a * b
    }
}

ArmMul satisfies SelectedMul {
    machine mul(a: u64, b: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires a <= 50 && b <= 50 ensures result <= 2500
    {
        SelectedBodyCheck::require_tag(29u64);
        a * b
    }
}


machine probe(a: u64, b: u64) -> u64
requires a <= 50 && b <= 50
{
    SelectedMul::mul(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 1200 && probe(50, 50) == 2500 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
