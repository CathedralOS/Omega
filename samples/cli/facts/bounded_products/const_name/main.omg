// Bounded u64 factors a <= 50 and b <= 50 make a * b fit in result <= 2500 without a domain or widening.
// Place: const name. The named ceiling bounds both operands.
// Expected exit: 0
const CEILING: u64 = 50;

machine mul(a: u64, b: u64) -> u64
requires a <= CEILING && b <= CEILING
ensures result <= 2500
{
    a * b
}

machine probe(a: u64, b: u64) -> u64
requires a <= CEILING && b <= CEILING
ensures result <= 2500
{
    mul(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 1200 && probe(50, 50) == 2500 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
