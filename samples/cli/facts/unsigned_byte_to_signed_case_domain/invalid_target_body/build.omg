use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "unsigned_byte_to_signed_case_domain_target_body_invalid" };
    Build::select_provider::<|app|::ByteSource, |app|::HostedByteSource>(builder, windows_x86_64);
    Build::select_provider::<|app|::ByteSource, |app|::HostedByteSource>(builder, linux_x86_64);
    Build::select_provider::<|app|::ByteSource, |app|::HostedByteSource>(builder, linux_arm64);
    Build::select_provider::<|app|::ByteSource, |app|::HostedByteSource>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
