// Fact: 32-bit unsigned saturating addition lhs +| rhs with bounded interval 50u32 <= sum <= 100u32 establishes 50u32 <= sum <= 100u32 across all nine places so exact subtractions 100u32 - sum and sum - 50u32 are safe.
// Place: match join. Both match arms yield bounded 32-bit operands and join before saturating addition and interval discharge.
// Expected exit: 0

machine choose_lhs(flag: bool) -> u32
ensures result >= 40 && result <= 80
{
    match flag {
        true -> 60u32,
        false -> 50u32,
    }
}

machine sat_match_join(rhs: u32) -> u32
requires rhs >= 10 && rhs <= 20
{
    let lhs: u32 = choose_lhs(true);
    let a: u32 in Saturating = lhs as u32 in Saturating;
    let b: u32 in Saturating = rhs as u32 in Saturating;
    let sat_sum: u32 in Saturating = a + b;
    let sum: u32 = sat_sum as u32;
    let headroom: u32 = 100u32 - sum;
    let margin: u32 = sum - 50u32;
    headroom + margin
}

machine probe() -> u32 {
    sat_match_join(15u32)
}

machine main() crashes Trap {
    transition probe() == 50 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
