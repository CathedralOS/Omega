// Fact: 32-bit unsigned saturating addition lhs +| rhs with bounded interval 50u32 <= sum <= 100u32 establishes 50u32 <= sum <= 100u32 across all nine places so exact subtractions 100u32 - sum and sum - 50u32 are safe.
// Place: field (invalid twin). The lhs upper bound is widened to 81u32 so sum reaches 101u32, underflowing 100u32 - sum.
// Expected diagnostic: may overflow `u32`

data SatPacket {
    lhs: u32;
    rhs: u32;
}

machine sat_field(packet: SatPacket) -> u32
requires packet.lhs >= 40 && packet.lhs <= 81 && packet.rhs >= 10 && packet.rhs <= 20
{
    let a: u32 in Saturating = packet.lhs as u32 in Saturating;
    let b: u32 in Saturating = packet.rhs as u32 in Saturating;
    let sat_sum: u32 in Saturating = a + b;
    let sum: u32 = sat_sum as u32;
    let headroom: u32 = 100u32 - sum;
    let margin: u32 = sum - 50u32;
    headroom + margin
}

machine probe() -> u32 {
    let packet: SatPacket = SatPacket { lhs: 60u32, rhs: 15u32 };
    sat_field(packet)
}

machine main() crashes Trap {
    transition probe() == 50 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
