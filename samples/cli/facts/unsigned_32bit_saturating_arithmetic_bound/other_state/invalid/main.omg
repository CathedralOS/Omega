// Fact: 32-bit unsigned saturating addition lhs +| rhs with bounded interval 50u32 <= sum <= 100u32 establishes 50u32 <= sum <= 100u32 across all nine places so exact subtractions 100u32 - sum and sum - 50u32 are safe.
// Place: another state (invalid twin). The state step lhs upper bound is widened to 81u32 so sum reaches 101u32, underflowing 100u32 - sum.
// Expected diagnostic: may overflow `u32`

machine sat_state(lhs: u32, rhs: u32) -> u32
requires lhs >= 40 && lhs <= 81 && rhs >= 10 && rhs <= 20
{
    transition {
        _ -> step(lhs, rhs)
    }
    machine step(l: u32, r: u32) -> u32
    requires l >= 40 && l <= 81 && r >= 10 && r <= 20
    {
        let a: u32 in Saturating = l as u32 in Saturating;
        let b: u32 in Saturating = r as u32 in Saturating;
        let sat_sum: u32 in Saturating = a + b;
        let sum: u32 = sat_sum as u32;
        let headroom: u32 = 100u32 - sum;
        let margin: u32 = sum - 50u32;
        headroom + margin
    }
}

machine probe() -> u32 {
    sat_state(60u32, 15u32)
}

machine main() crashes Trap {
    transition probe() == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
