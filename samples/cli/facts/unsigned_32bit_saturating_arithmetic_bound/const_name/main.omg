// Fact: 32-bit unsigned saturating addition lhs +| rhs with bounded interval 50u32 <= sum <= 100u32 establishes 50u32 <= sum <= 100u32 across all nine places so exact subtractions 100u32 - sum and sum - 50u32 are safe.
// Place: const name. Named constants supply bounded 32-bit operands before saturating addition and interval discharge.
// Expected exit: 0

const LHS_VAL: u32 = 60u32;
const RHS_VAL: u32 = 15u32;

machine sat_const() -> u32 {
    let a: u32 in Saturating = LHS_VAL as u32 in Saturating;
    let b: u32 in Saturating = RHS_VAL as u32 in Saturating;
    let sat_sum: u32 in Saturating = a + b;
    let sum: u32 = sat_sum as u32;
    let headroom: u32 = 100u32 - sum;
    let margin: u32 = sum - 50u32;
    headroom + margin
}

machine probe() -> u32 {
    sat_const()
}

machine main() crashes Trap {
    transition probe() == 50 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
