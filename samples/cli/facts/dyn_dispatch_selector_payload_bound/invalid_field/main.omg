// Dispatching a trait method through a dynamic trait carrier (dyn / trait conformance) whose contract establishes result <= 88u64 preserves the return bound across the selector and data lanes, discharging exact subtraction 88u64 - result.
// Expected exit: 0
trait PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 89u64;
}

ActualEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 89u64
    {
        transition base == 10u64 { true -> 38u64 _ -> 28u64 }
    }
}

machine alternate_value(base: u64) -> u64
ensures result <= 88u64
{
    transition base == 10u64 { true -> 48u64 _ -> 58u64 }
}

AlternateEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 89u64
    { alternate_value(base) }
}

data Carrier [copy] {
    before: u64;
    selector: dyn PayloadEvaluator;
    after: u64;
}

machine main() crashes Trap {
    let first: Carrier = Carrier { before: 17, selector: ActualEvaluator as dyn PayloadEvaluator, after: 23 };
    let second: Carrier = Carrier { before: 17, selector: AlternateEvaluator as dyn PayloadEvaluator, after: 23 };
    let first_at_ten: u64 = 88u64 - PayloadEvaluator::compute(first.selector, 10u64);
    let first_at_twenty: u64 = 88u64 - PayloadEvaluator::compute(first.selector, 20u64);
    let second_at_ten: u64 = 88u64 - PayloadEvaluator::compute(second.selector, 10u64);
    let second_at_twenty: u64 = 88u64 - PayloadEvaluator::compute(second.selector, 20u64);
    transition first_at_ten == 50u64 && first_at_twenty == 60u64
        && second_at_ten == 40u64 && second_at_twenty == 30u64
        && first.before == 17u64 && first.after == 23u64 && second.before == 17u64 && second.after == 23u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
