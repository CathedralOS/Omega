// Dispatching a trait method through a dynamic trait carrier (dyn / trait conformance) whose contract establishes result <= 88u64 preserves the return bound across the selector and data lanes, discharging exact subtraction 88u64 - result.
// Expected rejection: exact arithmetic in machine compute_target state entry terminal expression may overflow `u64`.
trait PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 89u64;
}

ActualEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 89u64
    {
        89u64
    }
}

linux_x86_64 machine compute_target(sel: dyn PayloadEvaluator, val: u64) -> u64 {
    let result: u64 = PayloadEvaluator::compute(sel, val);
    88u64 - result
}

linux_arm64 machine compute_target(sel: dyn PayloadEvaluator, val: u64) -> u64 {
    let result: u64 = PayloadEvaluator::compute(sel, val);
    88u64 - result
}

windows_x86_64 machine compute_target(sel: dyn PayloadEvaluator, val: u64) -> u64 {
    let result: u64 = PayloadEvaluator::compute(sel, val);
    88u64 - result
}

macos_arm64 machine compute_target(sel: dyn PayloadEvaluator, val: u64) -> u64 {
    let result: u64 = PayloadEvaluator::compute(sel, val);
    88u64 - result
}

machine main() crashes Trap {
    let selector: dyn PayloadEvaluator = ActualEvaluator as dyn PayloadEvaluator;
    let diff: u64 = compute_target(selector, 10u64);
    transition diff == 0u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
