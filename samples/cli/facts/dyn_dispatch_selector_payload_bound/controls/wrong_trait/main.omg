// Dispatching a trait method through a dynamic trait carrier (dyn / trait conformance) whose contract establishes result <= 88u64 preserves the return bound across the selector and data lanes, discharging exact subtraction 88u64 - result.
// Expected exit: 0
trait PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 88u64;
}

ActualEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 88u64
    {
        transition base == 10u64 { true -> 38u64 _ -> 28u64 }
    }
}

machine alternate_value(base: u64) -> u64
ensures result <= 88u64
{
    transition base == 10u64 { true -> 48u64 _ -> 58u64 }
}

AlternateEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 88u64
    { alternate_value(base) }
}

trait UnrelatedEvaluator {
    machine compute(base: u64) -> u64 ensures result <= 88u64;
}

machine main() crashes Trap {
    let selector: dyn PayloadEvaluator = ActualEvaluator as dyn PayloadEvaluator;
    let result: u64 = UnrelatedEvaluator::compute(selector, 10u64);
    let difference: u64 = 88u64 - result;
    transition difference == 50u64 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
