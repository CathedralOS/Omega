// Fact: 32-bit unsigned bitwise XOR raw ^ 15u32 with bounded interval 40u32 <= xored <= 63u32 establishes 40u32 <= xored <= 63u32 across all nine places so exact subtractions 63u32 - xored and xored - 40u32 are safe.
// Expected exit: 0

data Holder [copy] {
    val: u32;
}

machine verify_xored(v: u32) -> i32
    requires v >= 40u32 && v <= 63u32
{
    let headroom: u32 = 63u32 - v;
    let margin: u32 = v - 40u32;
    let sum: i32 = (headroom + margin) as i32;
    sum - 23i32
}

machine probe(raw: u32) -> i32
    requires raw >= 59u32 && raw <= 59u32
{
    let xored: u32 = raw ^ 15u32;
    transition xored >= 40u32 {
        true -> check(xored)
        false -> bad()
    }
    machine check(res: u32) -> i32 {
        let holder: Holder = Holder { val: res };
        verify_xored(holder.val)
    }
    machine bad() -> i32 { 1i32 }
}

machine main() crashes Trap {
    let res: i32 = probe(59u32);
    transition res == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
