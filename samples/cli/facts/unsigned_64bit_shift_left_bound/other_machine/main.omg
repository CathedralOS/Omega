// Fact: 64-bit unsigned left shift raw << 2u32 with bounded interval 40u64 <= shifted <= 80u64 establishes 40u64 <= shifted <= 80u64 across all nine places so exact subtractions 80u64 - shifted and shifted - 40u64 are safe.
// Place: other_machine. A forwarding machine transports the left-shifted result through an intermediate machine call.
// Expected exit: 0
machine verify_shifted(res: u64) -> i32
    requires res >= 40 && res <= 80
{
    let head: u64 = 80 - res;
    let tail: u64 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 40
}

machine target_machine(val: u64) -> u64
    ensures result == val
{
    val
}

machine forwarder(val: u64) -> u64
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(raw: u64) -> i32
    requires raw >= 15 && raw <= 15
{
    let shifted: u64 = forwarder(raw << 2u32);
    verify_shifted(shifted)
}

machine evaluate() -> i32 {
    compute_other_machine(15)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
