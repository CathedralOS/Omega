// Fact: 64-bit unsigned left shift raw << 2u32 with bounded interval 40u64 <= shifted <= 80u64 establishes 40u64 <= shifted <= 80u64 across all nine places so exact subtractions 80u64 - shifted and shifted - 40u64 are safe.
// Place: target_body. Each hosted target body computes the 64-bit unsigned left shift and verifies the bounds.
// Expected exit: 0
machine verify_shifted(res: u64) -> i32
    requires res >= 40 && res <= 80
{
    let head: u64 = 80 - res;
    let tail: u64 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 40
}

linux_x86_64 machine compute_target_body(raw: u64) -> i32
    requires raw >= 15 && raw <= 15
{
    let shifted: u64 = raw << 2u32;
    verify_shifted(shifted)
}

linux_arm64 machine compute_target_body(raw: u64) -> i32
    requires raw >= 15 && raw <= 15
{
    let shifted: u64 = raw << 2u32;
    verify_shifted(shifted)
}

macos_arm64 machine compute_target_body(raw: u64) -> i32
    requires raw >= 15 && raw <= 15
{
    let shifted: u64 = raw << 2u32;
    verify_shifted(shifted)
}

windows_x86_64 machine compute_target_body(raw: u64) -> i32
    requires raw >= 15 && raw <= 15
{
    let shifted: u64 = raw << 2u32;
    verify_shifted(shifted)
}

machine evaluate() -> i32 {
    compute_target_body(15)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
