// Fact: 64-bit unsigned left shift raw << 2u32 with bounded interval 40u64 <= shifted <= 80u64 establishes 40u64 <= shifted <= 80u64 across all nine places so exact subtractions 80u64 - shifted and shifted - 40u64 are safe.
// Place: target_body. Each hosted target body computes the 64-bit unsigned left shift and verifies the bounds.
// Expected exit: 0
machine verify_shifted(res: u64) -> i32
    requires res >= 40 && res <= 80
{
    let head: u64 = 80 - res;
    let tail: u64 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 40
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(raw: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires raw >= 21 && raw <= 21;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(raw: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires raw >= 21 && raw <= 21
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: u64 = raw << 2u32;
        verify_shifted(shifted)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(raw: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires raw >= 21 && raw <= 21
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: u64 = raw << 2u32;
        verify_shifted(shifted)
    }
}









machine evaluate() -> i32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(21)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
