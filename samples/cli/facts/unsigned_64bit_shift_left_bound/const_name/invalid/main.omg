// Fact: 64-bit unsigned left shift raw << 2u32 with bounded interval 40u64 <= shifted <= 80u64 establishes 40u64 <= shifted <= 80u64 across all nine places so exact subtractions 80u64 - shifted and shifted - 40u64 are safe.
// Place: const_name. A named constant operand is left-shifted by 2u32 bits.
// Expected exit: 0
machine verify_shifted(res: u64) -> i32
    requires res >= 40 && res <= 80
{
    let head: u64 = 80 - res;
    let tail: u64 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 40
}

const RAW: u64 = 21;

machine compute_const() -> i32 {
    let shifted: u64 = RAW << 2u32;
    verify_shifted(shifted)
}

machine evaluate() -> i32 {
    compute_const()
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
