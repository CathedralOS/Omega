// An element of a fixed array of two shared byte windows keeps its backing and one-byte extent when
// lent to a callee, so the callee reads byte 11 from the first window and byte 29 from the second.
// Place: target_body.
// Expected exit: 0
machine read(bytes: &[u8]) -> u8
requires bytes.len == 1
{
    bytes[0]
}

boundary trait Observe {
    machine observe(windows: [&[u8]; 2]) -> bool
    reaches
    requires windows[0].len == 1 && windows[1].len == 1;
}

LinuxX8664Observer satisfies Observe {
    machine observe(windows: [&[u8]; 2]) -> bool
    requires windows[0].len == 1 && windows[1].len == 1
    {
        let first: &[u8] = windows[0];
        let a: u8 = read(first);
        let b: u8 = read(windows[1]);
        a == 11 && b == 29
    }
}

LinuxArm64Observer satisfies Observe {
    machine observe(pair: [&[u8]; 2]) -> bool
    requires pair[0].len == 1 && pair[1].len == 1
    {
        let head: &[u8] = pair[0];
        let a: u8 = read(head);
        let b: u8 = read(pair[1]);
        a == 11 && b == 29
    }
}

MacosArm64Observer satisfies Observe {
    machine observe(slots: [&[u8]; 2]) -> bool
    requires slots[0].len == 1 && slots[1].len == 1
    {
        let lead: &[u8] = slots[0];
        let a: u8 = read(lead);
        let b: u8 = read(slots[1]);
        a == 11 && b == 29
    }
}

WindowsX8664Observer satisfies Observe {
    machine observe(frames: [&[u8]; 2]) -> bool
    requires frames[0].len == 1 && frames[1].len == 1
    {
        let top: &[u8] = frames[0];
        let a: u8 = read(top);
        let b: u8 = read(frames[1]);
        a == 11 && b == 29
    }
}

machine main() crashes Trap {
    let packet: [u8; 4] = [11, 23, 29, 31];
    let windows: [&[u8]; 2] = [&packet[0..2], &packet[2..3]];
    let observed: bool = Observe::observe(windows);
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
