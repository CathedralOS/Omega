use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "stored_shared_byte_view_element_lend_target_body" };
    Build::select_provider::<|app|::Observe, |app|::LinuxX8664Observer>(builder, linux_x86_64);
    Build::select_provider::<|app|::Observe, |app|::LinuxArm64Observer>(builder, linux_arm64);
    Build::select_provider::<|app|::Observe, |app|::MacosArm64Observer>(builder, macos_arm64);
    Build::select_provider::<|app|::Observe, |app|::WindowsX8664Observer>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
