// An AArch64 ldr destination, place reads the typed place, and the following Omega use reads that recorded value.
// Expected exit: 0.
boundary trait SelectedMain {
    machine run() reaches crashes Trap;
}

X86Main satisfies SelectedMain {
    machine run() crashes Trap {
        let source: u32 = 37;
        let mut loaded: u32 = 0;
        asm {
            mov loaded, source
        }
        transition loaded == 37 {
            true -> done()
            false -> bad()
        }
        machine done() {}
        machine bad() crashes Trap { crash Trap; }
    }
}

ArmMain satisfies SelectedMain {
    machine run() crashes Trap {
        let source: u32 = 37;
        let mut loaded: u32 = 0;
        asm {
            ldr loaded, source
        }
        transition loaded == 37 {
            true -> done()
            false -> bad()
        }
        machine done() {}
        machine bad() crashes Trap { crash Trap; }
    }
}
machine main() crashes Trap {
    SelectedMain::run();
}

