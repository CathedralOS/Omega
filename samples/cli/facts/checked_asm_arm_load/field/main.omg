// An AArch64 ldr destination, place reads the typed place, and the following Omega use reads that recorded value.
// Expected exit: 0.
data Cell { value: u32; }
machine ArmEntry() crashes Trap
{
    let cell: Cell = Cell { value: 37 };
    let mut loaded: u32 = 0;
    asm {
        ldr loaded, cell.value
    }
    transition loaded == 37 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

machine X86Entry() crashes Trap
{
    let cell: Cell = Cell { value: 37 };
    let mut loaded: u32 = 0;
    asm {
        mov loaded, cell.value
    }
    transition loaded == 37 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
