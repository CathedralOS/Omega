machine build(builder: &mut Build) {
    Build::application(builder, "checked_asm_arm_load_field_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, X86Entry);
    Build::bind(builder, linux_arm64::ProgramEntry, ArmEntry);
    Build::bind(builder, macos_arm64::ProgramEntry, ArmEntry);
    Build::bind(builder, windows_x86_64::ProgramEntry, X86Entry);
}
