// An AArch64 ldr destination, place reads the typed place, and the following Omega use reads that recorded value.
// Expected exit: 0.
boundary trait SelectedReadPlace {
    machine read_place(source: u32) reaches
crashes Trap;
}
LinuxArm64ReadPlace satisfies SelectedReadPlace {
    machine read_place(source: u32) crashes Trap
{
    let mut loaded: u32 = 0;
    asm {
        ldr loaded, source
    }
    transition loaded == 37 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
}



WindowsX8664ReadPlace satisfies SelectedReadPlace {
    machine read_place(source: u32) crashes Trap
{
    let mut loaded: u32 = 0;
    asm {
        mov loaded, source
    }
    transition loaded == 37 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
}


machine main() crashes Trap {
    SelectedReadPlace::read_place(37);
}
