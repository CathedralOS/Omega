linux_x86_64 machine Loader::read(source: u32) crashes Trap {
    let mut loaded: u32 = 0;
    asm {
        mov loaded, [source]
    }
    transition loaded == 37 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    Loader::read(37);
}
