// An AArch64 ldr destination, place reads the typed place, and the following Omega use reads that recorded value.
// Expected exit: 0.
data Loader {}
linux_arm64 machine Loader::read(source: u32) crashes Trap {
    let mut loaded: u32 = 0;
    asm {
        ldr loaded, [source]
    }
    transition loaded == 37 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

macos_arm64 machine Loader::read(source: u32) crashes Trap {
    let mut loaded: u32 = 0;
    asm {
        ldr loaded, [source]
    }
    transition loaded == 37 {
        true -> done()
        false -> bad()
