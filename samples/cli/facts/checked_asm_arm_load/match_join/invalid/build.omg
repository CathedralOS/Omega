machine build(builder: &mut Build) {
    Build::select_provider<SelectedChoose, LinuxArm64Choose>(builder, linux_arm64);
    Build::select_provider<SelectedChoose, LinuxArm64Choose>(builder, macos_arm64);
    Build::select_provider<SelectedChoose, WindowsX8664Choose>(builder, windows_x86_64);
    Build::select_provider<SelectedChoose, WindowsX8664Choose>(builder, linux_x86_64);

    Build::application(builder, "checked_asm_arm_load_match_join_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
