use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "foreign_byte_array_element_backing_local" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::start);
    Build::bind_native::<|app|::Text::length>(builder, windows_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::PeByName { library: "msvcrt.dll", export: "strlen" }
    });
    Build::bind_native::<|app|::Text::length>(builder, linux_x86_64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.2.5"
        }
    });
    Build::bind_native::<|app|::Text::length>(builder, linux_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.17"
        }
    });
    Build::bind_native::<|app|::Text::length>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_strlen"
        }
    });
}
