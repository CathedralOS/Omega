// A shared element loan into an owned byte array exports the whole original array through the thin foreign ABI, so the foreign reader sees every sibling byte and no byte changes.
// Expected exit: 0
public boundary trait Text {
    machine length(text: &u8) -> u64 reaches;
}
machine demand(result: bool) crashes Trap {
    transition result { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
data Envelope [copy] { before: u32; text: [u8; 8]; after: u32; }
machine start() crashes Trap {
    let envelope: Envelope = Envelope { before: 1701, text: "omega\0xy", after: 1801 };
    let mut text: [u8; 8] = envelope.text;
    let selected: &u8 = &text[0];
    text[0] = 0;
    let measured: u64 = Text::length(selected);
    let rest: u64 = Text::length(&text[2]);
    demand(measured == 5 && rest == 3 && text[0] == 111 && text[5] == 0 && text[6] == 120 && text[7] == 121);
    demand(envelope.before == 1701 && envelope.after == 1801);
}
