// Attribution control: the same descriptor replacement without match capture.
// Expected exit: 0
data Cell { value: i32; }
data Message<'storage> { body: &'storage mut Cell; }
machine replace<'storage>(message: &mut Message<'storage>, incoming: &'storage mut Cell) -> bool {
    message.body = incoming;
    true
}
machine store(target: &mut Cell, value: i32) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine touch(cell: &mut Cell) -> bool { cell.value = 31; true }
machine exercise(flag: bool) -> bool {
    let mut original: Cell = Cell { value: 17 };
    let mut incoming: Cell = Cell { value: 19 };
    let mut spare: Cell = Cell { value: 7 };
    let mut message: Message = Message { body: &mut original };
    let replaced: bool = replace(&mut message, &mut incoming);
    let step_0: bool = flag && touch(&mut spare);
    let step_1: bool = flag && touch(&mut spare);
    let step_2: bool = flag && touch(&mut spare);
    let step_3: bool = flag && touch(&mut spare);
    let step_4: bool = flag && touch(&mut spare);
    let step_5: bool = flag && touch(&mut spare);
    let step_6: bool = flag && touch(&mut spare);
    let step_7: bool = flag && touch(&mut spare);
    let step_8: bool = flag && touch(&mut spare);
    let step_9: bool = flag && touch(&mut spare);
    let step_10: bool = flag && touch(&mut spare);
    let step_11: bool = flag && touch(&mut spare);
    let step_12: bool = flag && touch(&mut spare);
    let step_13: bool = flag && touch(&mut spare);
    let step_14: bool = flag && touch(&mut spare);
    let step_15: bool = flag && touch(&mut spare);
    let step_16: bool = flag && touch(&mut spare);
    let step_17: bool = flag && touch(&mut spare);
    let step_18: bool = flag && touch(&mut spare);
    let step_19: bool = flag && touch(&mut spare);
    let written: bool = store(&mut message.body, 41);
    replaced && written && original.value == 17 && incoming.value == 41 && spare.value == 31
}
machine main() crashes Trap {
    transition exercise(true) { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
