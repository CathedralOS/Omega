// A guard can replace a pointed-to descriptor; the body loads the new slot.
// Expected exit: 0
data Cell { value: i32; }
data Message<'storage> { body: &'storage mut Cell; }
data Envelope<'carrier, 'storage> { case Active(message: &'carrier mut Message<'storage>); case Empty; }
machine replace<'storage>(message: &mut Message<'storage>, incoming: &'storage mut Cell) -> bool {
    message.body = incoming;
    true
}
machine store(target: &mut Cell, value: i32) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine exercise() -> bool {
    let mut original: Cell = Cell { value: 17 };
    let mut incoming: Cell = Cell { value: 19 };
    let spare: Cell = Cell { value: 7 };
    let mut message: Message = Message { body: &mut original };
    let envelope: Envelope = Envelope::Active { message: &mut message };
    let written: bool = match envelope {
        Envelope::Active { message } if replace(&mut message, &mut incoming) -> store(&mut message.body, 41)
        Envelope::Empty -> false
        _ -> false
    };
    written && original.value == 17 && incoming.value == 41 && spare.value == 7
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
