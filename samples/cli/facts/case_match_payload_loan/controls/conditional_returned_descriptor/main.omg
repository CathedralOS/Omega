// Expected exit: 0
data Cell { value: i32; }
data Message<'storage> { body: &'storage mut Cell; }
data Envelope<'storage> { case Active(cell: &'storage mut Cell); case Empty; }
machine store(cell: &mut Cell) -> bool { cell.value = 41; cell.value == 41 }
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
machine choose<'storage>(selected: bool, left: &'storage mut Cell, right: &'storage mut Cell) -> Envelope<'storage> {
    match selected {
        true -> Envelope::Active { cell: left }
        false -> Envelope::Active { cell: right }
    }
}
machine exercise() -> bool {
    let mut left: Cell = Cell { value: 17 };
    let mut right: Cell = Cell { value: 19 };
    let written: bool = match choose(false, &mut left, &mut right) {
        Envelope::Active { cell } -> store(&mut cell)
        Envelope::Empty -> false
    };
    written && left.value == 17 && right.value == 41
}
