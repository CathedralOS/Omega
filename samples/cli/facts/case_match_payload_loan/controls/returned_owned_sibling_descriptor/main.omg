// Expected exit: 0
data Pair [copy] { left: i32; right: i32; }
machine choose<'storage>(pair: &'storage Pair) -> &'storage i32 { &pair.right }
machine main() crashes Trap {
    let pair: Pair = Pair { left: 17, right: 19 };
    let returned: &i32 = choose(&pair);
    let observed: i32 = returned;
    transition observed == 19 && pair.left == 17 {
        true -> done() false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
