// A retained owned subject observes a guard-time descriptor replacement in its owned child.
// Expected exit: 0
data Cell { value: i32; }
data Message<'storage> { body: &'storage mut Cell; }
data Carrier<'storage> { message: Message<'storage>; }
machine replace<'storage>(message: &mut Message<'storage>, incoming: &'storage mut Cell) -> bool {
    message.body = incoming;
    true
}
machine store(target: &mut Cell, value: i32) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine exercise() -> bool {
    let mut original: Cell = Cell { value: 17 };
    let mut incoming: Cell = Cell { value: 19 };
    let sibling: Cell = Cell { value: 7 };
    let carrier: Carrier = Carrier { message: Message { body: &mut original } };
    let written: bool = match carrier {
        Carrier { message } if replace(&mut message, &mut incoming) -> store(&mut message.body, 41)
        _ -> false
    };
    written && original.value == 17 && incoming.value == 41 && sibling.value == 7
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
