// Nested selected transfers dispose the exact residual on each result edge.
// Expected exit: 0
use omega::language::core::drop;
data Counter { value: u32 in Wrapping; }
data Token { counter: &mut Counter; }
data Pair { left: Token; right: Token; }
machine Token::drop(token: &mut Token) { token.counter.value = token.counter.value + 1; }
machine selected(outer: bool, inner: bool) -> bool {
    let mut left: Counter = Counter { value: 0 };
    let mut right: Counter = Counter { value: 0 };
    let mut fallback: Counter = Counter { value: 0 };
    let token: Token = match (Pair {
        left: Token { counter: &mut left }, right: Token { counter: &mut right }
    }) {
        Pair { left, right as _ } if outer -> match inner {
            true -> left
            false -> Token { counter: &mut fallback }
        }
        _ -> Token { counter: &mut fallback }
    };
    drop(token);
    let fallback_count: u32 = match outer && inner { true -> 0 false -> 1 };
    (left.value as u32) == 1 && (right.value as u32) == 1
        && (fallback.value as u32) == fallback_count
}
machine main() crashes Trap {
    transition selected(true, true) && selected(true, false)
        && selected(false, true) && selected(false, false) {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
