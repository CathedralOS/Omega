// A copyable subject retains its observed value while a guard mutates the source.
// Expected exit: 0
data Snapshot [copy] { value: i32; }
machine mutate(target: &mut Snapshot) -> bool {
    target.value = 42;
    true
}
machine exercise() -> bool {
    let mut source: Snapshot = Snapshot { value: 41 };
    let observed: i32 = match source {
        Snapshot { value } if mutate(&mut source) -> value
        _ -> 0
    };
    observed == 41 && source.value == 42
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
