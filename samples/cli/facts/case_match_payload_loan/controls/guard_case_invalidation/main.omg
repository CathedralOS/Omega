// A guard write invalidates the earlier nested case observation.
// Expected: reject payload access after replacement, not a lowering failure.
data Details [copy] { mode: u32; }
data Outcome [copy] { case Error; case Ok(details: Details); }
data Envelope [copy] { outcome: Outcome; }
data Carrier<'storage> { envelope: &'storage mut Envelope; }
machine clear(envelope: &mut Envelope) -> bool {
    envelope.outcome = Outcome::Error;
    true
}
machine exercise() -> u32 {
    let mut envelope: Envelope = Envelope { outcome: Outcome::Ok { details: Details { mode: 41 } } };
    let carrier: Carrier = Carrier { envelope: &mut envelope };
    match carrier {
        Carrier { envelope } if (envelope.outcome in Outcome::Ok) && clear(&mut envelope) -> envelope.outcome.details.mode
        _ -> 0
    }
}
machine main() {
    _ = exercise();
}
