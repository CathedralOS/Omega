// Fact: `left == right` on `f64` selects the declared operator without importing `omega::language::core::float_operations`. A copy of an `f64` is not this fact. The values are 212.0 and 2.0, so the comparison is false.
// Invalid: the right operand is 212.0 instead of 2.0, so the comparison is true and the program crashes Trap.
machine equal_operands(left: f64, right: f64, flag: bool) -> bool {
    let equal: bool = match flag { true -> left == right, false -> left == right };
    equal
}
machine main() crashes Trap {
    transition equal_operands(212.0, 212.0, true) {
        true -> bad()
        _ -> second()
    }
    machine second() {
        transition equal_operands(212.0, 212.0, false) {
            true -> bad()
            _ -> done()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
