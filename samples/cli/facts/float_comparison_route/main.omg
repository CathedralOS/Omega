// A declared f64 comparison routes without importing float_operations.
// 212.0 is not equal to 2.0, so the comparison is false and the program exits 0.
// Expected exit: 0
machine main() crashes Trap {
    let mut left: f64 = 212.0;
    let mut right: f64 = 2.0;
    let mut equal: bool = left == right;
    transition equal { true -> bad() _ -> done() }
    state done() {}
    state bad() { crash Trap; }
}
