machine build(builder: &mut Build) {
    Build::select_provider<SelectedEqualOperands, CheckedEqualOperands>(builder, linux_x86_64);
    Build::select_provider<SelectedEqualOperands, CheckedEqualOperands>(builder, linux_arm64);
    Build::select_provider<SelectedEqualOperands, CheckedEqualOperands>(builder, macos_arm64);
    Build::select_provider<SelectedEqualOperands, CheckedEqualOperands>(builder, windows_x86_64);

    Build::package(builder, "float_comparison_route_target_body_mixed_format");
}
