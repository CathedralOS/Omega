// Fact: `left == right` on `f64` selects the declared operator without importing `omega::language::core::float_operations`. A copy of an `f64` is not this fact. The values are 212.0 and 2.0, so the comparison is false.
// Place: target_body. One comparison body per hosted target; the entry machine calls the selected body.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEqualOperands {
    machine equal_operands(left: f64, right: f64) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86EqualOperands satisfies SelectedEqualOperands {
    machine equal_operands(left: f64, right: f64) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     left == right 
    }
}

ArmEqualOperands satisfies SelectedEqualOperands {
    machine equal_operands(left: f64, right: f64) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     left == right 
    }
}


machine main() crashes Trap {
    let equal: bool = SelectedEqualOperands::equal_operands(212.0, 2.0);
    transition equal { true -> bad() _ -> done() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
