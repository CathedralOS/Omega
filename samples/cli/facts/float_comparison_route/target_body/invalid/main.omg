// Fact: `left == right` on `f64` selects the declared operator without importing `omega::language::core::float_operations`. A copy of an `f64` is not this fact. The values are 212.0 and 2.0, so the comparison is false.
// Invalid: the right operand is 212.0 instead of 2.0, so the comparison is true and the program crashes Trap.
linux_x86_64 machine equal_operands(left: f64, right: f64) -> bool { left == right }
linux_arm64 machine equal_operands(left: f64, right: f64) -> bool { left == right }
macos_arm64 machine equal_operands(left: f64, right: f64) -> bool { left == right }
windows_x86_64 machine equal_operands(left: f64, right: f64) -> bool { left == right }
machine main() crashes Trap {
    let equal: bool = equal_operands(212.0, 212.0);
    transition equal { true -> bad() _ -> done() }
    machine done() {}
    machine bad() { crash Trap; }
}
