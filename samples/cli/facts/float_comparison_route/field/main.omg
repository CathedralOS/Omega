// Fact: `left == right` on `f64` selects the declared operator without importing `omega::language::core::float_operations`. A copy of an `f64` is not this fact. The values are 212.0 and 2.0, so the comparison is false.
// Place: field. The two operands arrive as fields of a record and the comparison reads those fields.
// Expected exit: 0
data Operands { left: f64; right: f64; }
machine main() crashes Trap {
    let operands: Operands = Operands { left: 212.0, right: 2.0 };
    let equal: bool = operands.left == operands.right;
    transition equal { true -> bad() _ -> done() }
    machine done() {}
    machine bad() { crash Trap; }
}
