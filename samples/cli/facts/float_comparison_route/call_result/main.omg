// Fact: `left == right` on `f64` selects the declared operator without importing `omega::language::core::float_operations`. A copy of an `f64` is not this fact. The values are 212.0 and 2.0, so the comparison is false.
// Place: call_result. Both operands arrive as call results and the entry machine performs the comparison.
// Expected exit: 0
machine left_value() -> f64 { 212.0 }
machine right_value() -> f64 { 2.0 }
machine main() crashes Trap {
    let left: f64 = left_value();
    let right: f64 = right_value();
    let equal: bool = left == right;
    transition equal { true -> bad() _ -> done() }
    machine done() {}
    machine bad() { crash Trap; }
}
