// A nonnumeric boundary predicate over f64 supplies no IEEE comparison bound.
// Expected diagnostic: cannot prove requires contract for call bounded from select: value <= 1.0
boundary trait OtherComparison {
    machine less(left: f64, right: f64) -> bool reaches;
}
machine bounded(value: f64) -> f64 requires value <= 1.0 { value }
machine select(value: f64) -> f64 reaches OtherComparison {
    transition OtherComparison::less(value, 1.0) {
        true -> bounded(value)
        false -> 0.0
    }
}
machine main() reaches OtherComparison {
    let observed: f64 = select(2.0);
}
