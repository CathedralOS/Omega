// Fact: a 28-argument calling plan across register and stack slots on all four hosted targets preserves the 28th stack argument's static bound 40u64 <= a28 <= 80u64 across all nine places, so exact subtractions 80u64 - res and res - 40u64 are proved safe without underflow.
// Place: call result. Call results supply operands to the multi-argument call.
// Expected exit: 0

machine supply(val: u64) -> u64
ensures result == val
{
    val
}

machine pick28(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64,
    a11: u64,
    a12: u64,
    a13: u64,
    a14: u64,
    a15: u64,
    a16: u64,
    a17: u64,
    a18: u64,
    a19: u64,
    a20: u64,
    a21: u64,
    a22: u64,
    a23: u64,
    a24: u64,
    a25: u64,
    a26: u64,
    a27: u64,
    a28: u64
) -> u64
requires
    a1 == 1u64 &&
    a2 == 2u64 &&
    a3 == 3u64 &&
    a4 == 4u64 &&
    a5 == 5u64 &&
    a6 == 6u64 &&
    a7 == 7u64 &&
    a8 == 8u64 &&
    a9 == 9u64 &&
    a10 == 10u64 &&
    a11 == 11u64 &&
    a12 == 12u64 &&
    a13 == 13u64 &&
    a14 == 14u64 &&
    a15 == 15u64 &&
    a16 == 16u64 &&
    a17 == 17u64 &&
    a18 == 18u64 &&
    a19 == 19u64 &&
    a20 == 20u64 &&
    a21 == 21u64 &&
    a22 == 22u64 &&
    a23 == 23u64 &&
    a24 == 24u64 &&
    a25 == 25u64 &&
    a26 == 26u64 &&
    a27 == 27u64 &&
    a28 >= 40u64 && a28 <= 80u64
ensures
    result >= 40u64 && result <= 80u64 && result == a28
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23 + a24 + a25 + a26 + a27;
    (prefix - 378u64) + a28
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    let res: u64 = pick28(
        supply(1), supply(2), supply(3), supply(4), supply(5), supply(6), supply(7), supply(8), supply(9), supply(10), supply(11), supply(12), supply(13), supply(14), supply(15), supply(16), supply(17), supply(18), supply(19), supply(20), supply(21), supply(22), supply(23), supply(24), supply(25), supply(26), supply(27), supply(60)
    );
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    let diff: u64 = (headroom + margin) - 40u64;
    transition diff == 0u64 && headroom == 20u64 && margin == 20u64 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

machine main() crashes Trap {
    transition probe() == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
