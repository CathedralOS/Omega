// Fact: Completion consumes Pending and returns the original nested array Buffer with its declared ResidentValue and MarkerValue predicates restored, permitting exact subtraction; C writes the middle cell to 73 while marker 91, neighbors 305419896 and 1515863100, and the earlier copy 37 stay unchanged.
// Expected exit: 0. Completion updates the nested cell; marker and copied scalar retain their original values.
use omega::language::core::content;
use omega::language::core::drop;
use omega::language::core::external_binding;
public data ByteUnit {}
public domain u64::ResidentValue requires self >= 0 && self <= 2147483647 && self != 42;
public domain u64::MarkerValue requires self >= 0 && self <= 100;
public data Cell [copy] { value: u64 in ResidentValue; }
public data Buffer [linear] { marker: u64 in MarkerValue; cells: [Cell; 3]; }
machine Buffer::drop(buffer: &mut Buffer) {}
public domain Buffer::Owned;
machine Owned::content(buffer: &Buffer) -> CountedQuantity<ByteUnit>
satisfies Content<Buffer, CountedQuantity<ByteUnit>>::project {
    CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Pending<'source> [linear] { slot: u64; }
public domain Pending::Retained established by Writer::register;
machine Retained::content<'source>(pending: &Pending<'source>) -> CountedQuantity<ByteUnit>
satisfies Content<Pending<'source>, CountedQuantity<ByteUnit>>::project {
    CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Capacity [linear] { token: u64; }
public domain Capacity::Available established by Writer::acquire, Writer::complete;
public boundary trait Writer {
    machine acquire() -> Capacity reaches ensures result in Capacity::Available crashes Trap;
    machine register<'source>(capacity: Capacity in Capacity::Available, buffer: &'source mut Buffer in Buffer::Owned) -> Pending<'source>
    reaches
    ensures result in Pending::Retained, buffer in Buffer::Owned crashes Trap;
    machine complete<'source>(pending: Pending<'source> in Pending::Retained, observed: &mut u64) -> Capacity
    reaches
    ensures result in Capacity::Available crashes Trap;
    machine release(capacity: Capacity in Capacity::Available) reaches crashes Trap;
}


data Main {}
machine run_main(main: &mut Main) reaches Writer crashes Trap {
    let capacity: Capacity in Capacity::Available = Writer::acquire();
    let mut buffer: Buffer in Buffer::Owned = Buffer { marker: 91, cells: [Cell { value: 305419896 }, Cell { value: 37 }, Cell { value: 1515863100 }] };
    let original: u64 = buffer.cells[1].value;
    let pending: Pending = Writer::register(capacity, &mut buffer);
    let mut observed: u64 = 0;
    let returned: Capacity in Capacity::Available = Writer::complete(pending, &mut observed);
    Writer::release(returned);
    let remaining: u64 = 2147483647u64 - buffer.cells[1].value;
    let marker_remaining: u64 = 100u64 - buffer.marker;
    let value: u64 = buffer.cells[1].value;
    let marker: u64 = buffer.marker;
    let left_guard: u64 = buffer.cells[0].value;
    let right_guard: u64 = buffer.cells[2].value;
    drop(buffer);
    transition remaining == 2147483574 && marker_remaining == 9 && observed == 73 && value == 73 && original == 37 && marker == 91 && left_guard == 305419896 && right_guard == 1515863100 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Writer crashes Trap {
    let mut entry_storage: Main;
    run_main(&mut entry_storage);
}
