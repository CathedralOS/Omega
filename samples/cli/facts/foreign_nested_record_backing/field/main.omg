data Envelope<'a> { pending: Pending<'a> in Pending::Retained; }
data Main {}
machine run_main(main: &mut Main) reaches Writer crashes Trap {
    let capacity: Capacity in Capacity::Available = Writer::acquire();
    let mut buffer: Buffer in Buffer::Owned = Buffer { marker: 91, cell: Cell { value: 37 } };
    let original: u64 = buffer.cell.value;
    let pending: Pending = Writer::register(capacity, &mut buffer);
    let envelope: Envelope = Envelope { pending: pending };
    let routed: Pending in Pending::Retained = envelope.pending;
    let mut observed: u64 = 0;
    let returned: Capacity in Capacity::Available = Writer::complete(routed, &mut observed);
    Writer::release(returned);
    let value: u64 = buffer.cell.value;
    let marker: u64 = buffer.marker;
    drop(buffer);
    transition observed == 73 && value == 73 && original == 37 && marker == 91 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Writer crashes Trap {
    let mut entry_storage: Main;
    run_main(&mut entry_storage);
}
