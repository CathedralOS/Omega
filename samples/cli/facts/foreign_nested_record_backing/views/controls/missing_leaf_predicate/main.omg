// Expected rejection: a plain Cell field cannot supply ResidentValue to observed_gap.
public domain u64::ResidentValue(value)
requires value >= 0 && value <= 2147483647 && value != 42;
public data Cell { value: u64; }

machine observed_gap(value: u64 in ResidentValue) -> u64 {
    2147483647 - value
}
public machine use_unqualified(cells: &[Cell; 3]) -> u64 {
    observed_gap(cells[1].value)
}
machine entry_start() {}
