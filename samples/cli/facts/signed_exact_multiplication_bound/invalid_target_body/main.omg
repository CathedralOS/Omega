// Fact: multiplying two bounded signed i64 values (factor >= 10i64 && factor <= 15i64 and scale >= 4i64 && scale <= 6i64) establishes product >= 40i64 && product <= 90i64, discharging a downstream contract requiring product >= 40i64 && product <= 90i64 across all nine places.
// Invalid: target bodies compute 16 * 6 = 96, violating downstream contract product <= 90. Place: target_body.
// Expected diagnostic: cannot prove requires contract for call verify_product

machine verify_product(product: i64) -> i32
requires product >= 40 && product <= 90
{
    0i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86VerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let factor: i64 = 16i64;
        let scale: i64 = 6i64;
        let product: i64 = factor * scale;
        verify_product(product)
    }
}

ArmVerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let factor: i64 = 16i64;
        let scale: i64 = 6i64;
        let product: i64 = factor * scale;
        verify_product(product)
    }
}

machine probe() -> i32 {
    SelectedVerifyTarget::verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
