// Fact: multiplying two bounded signed i64 values (factor >= 10i64 && factor <= 15i64 and scale >= 4i64 && scale <= 6i64) establishes product >= 40i64 && product <= 90i64, discharging a downstream contract requiring product >= 40i64 && product <= 90i64 across all nine places.
// Invalid: factor upper bound 16 fails ensures contract result <= 90 in multiply. Place: call_result.
// Expected diagnostic: cannot prove ensures contract for exit from multiply

machine verify_product(product: i64) -> i32
requires product >= 40 && product <= 90
{
    0i32
}

machine multiply(factor: i64, scale: i64) -> i64
requires factor >= 10 && factor <= 16 && scale >= 4 && scale <= 6
ensures result >= 40 && result <= 90
{
    factor * scale
}

machine probe() -> i32 {
    let product: i64 = multiply(12i64, 5i64);
    verify_product(product)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
