// Fact: multiplying two bounded signed i64 values (factor >= 10i64 && factor <= 15i64 and scale >= 4i64 && scale <= 6i64) establishes product >= 40i64 && product <= 90i64, discharging a downstream contract requiring product >= 40i64 && product <= 90i64 across all nine places.
// Place: target_body. Each of four target bodies performs multiplication and verifies the product bound.
// Expected exit: 0

machine verify_product(product: i64) -> i32
requires product >= 40 && product <= 90
{
    0i32
}

linux_x86_64 machine verify_target() -> i32 {
    let factor: i64 = 12i64;
    let scale: i64 = 5i64;
    let product: i64 = factor * scale;
    verify_product(product)
}

linux_arm64 machine verify_target() -> i32 {
    let factor: i64 = 12i64;
    let scale: i64 = 5i64;
    let product: i64 = factor * scale;
    verify_product(product)
}

macos_arm64 machine verify_target() -> i32 {
    let factor: i64 = 12i64;
    let scale: i64 = 5i64;
    let product: i64 = factor * scale;
    verify_product(product)
}

windows_x86_64 machine verify_target() -> i32 {
    let factor: i64 = 12i64;
    let scale: i64 = 5i64;
    let product: i64 = factor * scale;
    verify_product(product)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
