// Fact: 32-bit signed bitwise OR base | 32i32 with bounded interval 40i32 <= combined <= 63i32 establishes 40i32 <= combined <= 63i32 across all nine places so exact subtractions 63i32 - combined and combined - 40i32 are safe.
// Place: another target body. Each of four target-scoped machine bodies performs 32-bit bitwise OR and discharges interval.
// Expected exit: 0

machine verify_combined(combined: i32) -> i32
requires combined >= 40 && combined <= 63
{
    let headroom: i32 = 63i32 - combined;
    let margin: i32 = combined - 40i32;
    headroom + margin
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedBitwiseOrTarget {
    machine bitwise_or_target(base: i32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires base >= 16 && base <= 31;
}

X86BitwiseOrTarget satisfies SelectedBitwiseOrTarget {
    machine bitwise_or_target(base: i32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires base >= 16 && base <= 31
    {
        SelectedBodyCheck::require_tag(17u64);
        let combined: i32 = base | 32i32;
        verify_combined(combined)
    }
}

ArmBitwiseOrTarget satisfies SelectedBitwiseOrTarget {
    machine bitwise_or_target(base: i32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires base >= 16 && base <= 31
    {
        SelectedBodyCheck::require_tag(29u64);
        let combined: i32 = base | 32i32;
        verify_combined(combined)
    }
}

machine probe() -> i32 {
    SelectedBitwiseOrTarget::bitwise_or_target(20i32)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
