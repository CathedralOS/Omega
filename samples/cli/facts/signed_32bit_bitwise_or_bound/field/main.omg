// Fact: 32-bit signed bitwise OR base | 32i32 with bounded interval 40i32 <= combined <= 63i32 establishes 40i32 <= combined <= 63i32 across all nine places so exact subtractions 63i32 - combined and combined - 40i32 are safe.
// Place: field. The 32-bit signed base operand and mask are stored in record fields before bitwise OR and interval discharge.
// Expected exit: 0

data OrPacket [copy] {
    base: i32;
    mask: i32;
}

machine verify_combined(combined: i32) -> i32
requires combined >= 40 && combined <= 63
{
    let headroom: i32 = 63i32 - combined;
    let margin: i32 = combined - 40i32;
    headroom + margin
}

machine bitwise_or_field(pkt: OrPacket) -> i32
requires pkt.base >= 16 && pkt.base <= 31 && pkt.mask == 32
{
    let combined: i32 = pkt.base | pkt.mask;
    verify_combined(combined)
}

machine probe() -> i32 {
    let pkt: OrPacket = OrPacket {
        base: 20i32,
        mask: 32i32,
    };
    bitwise_or_field(pkt)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
