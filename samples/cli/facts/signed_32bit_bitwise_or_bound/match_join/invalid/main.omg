// Fact: 32-bit signed bitwise OR base | 32i32 with bounded interval 40i32 <= combined <= 63i32 establishes 40i32 <= combined <= 63i32 across all nine places so exact subtractions 63i32 - combined and combined - 40i32 are safe.
// Place: match join (invalid twin). The false match arm yields 64i32 so joined result reaches 127 > 63, failing contract for verify_combined.
// Expected diagnostic: cannot prove requires contract for call

machine choose_base(flag: bool) -> i32
ensures result >= 16 && result <= 64
{
    match flag {
        true -> 20i32,
        false -> 64i32,
    }
}

machine verify_combined(combined: i32) -> i32
requires combined >= 40 && combined <= 63
{
    let headroom: i32 = 63i32 - combined;
    let margin: i32 = combined - 40i32;
    headroom + margin
}

machine bitwise_or_join() -> i32 {
    let base: i32 = choose_base(true);
    let combined: i32 = base | 32i32;
    verify_combined(combined)
}

machine probe() -> i32 {
    bitwise_or_join()
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
