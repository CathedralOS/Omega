// A free entry owns and cleans an ordinary local tally of 7, and the hosted contract supplies no provisioned ZII context.
// Place: target_body.
// Expected exit: 0
data Tally { total: u64; }
data Mark { slot: &mut Tally; code: u64; }
machine Mark::drop(mark: &mut Mark) requires mark.code == 7 {
    mark.slot.total = mark.code;
}
machine settle(mark: &Mark) {}
linux_x86_64 machine finish(tally: &mut Tally, code: u64) requires code == 7 crashes Trap {
    settle(&Mark { slot: tally, code: code });
    transition tally.total == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
linux_arm64 machine finish(tally: &mut Tally, code: u64) requires code == 7 crashes Trap {
    settle(&Mark { slot: tally, code: code });
    transition tally.total == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
macos_arm64 machine finish(tally: &mut Tally, code: u64) requires code == 7 crashes Trap {
    settle(&Mark { slot: tally, code: code });
    transition tally.total == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
windows_x86_64 machine finish(tally: &mut Tally, code: u64) requires code == 7 crashes Trap {
    settle(&Mark { slot: tally, code: code });
    transition tally.total == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
machine start() crashes Trap {
    let mut tally: Tally = Tally { total: 0 };
    finish(&mut tally, 7);
}

// A hosted shape alone cannot establish this ordinary mutable argument.
data Unprovided { byte: u8; }
