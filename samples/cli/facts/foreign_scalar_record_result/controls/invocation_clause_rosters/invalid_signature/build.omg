machine build(builder: &mut Build) {
 Build::application(builder, "invocation_roster_control");
 Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::select_provider<First, FirstReading>(builder, windows_x86_64);
 Build::select_provider<Second, SecondReading>(builder, windows_x86_64);
 Build::select_provider<Combined, CombinedReading>(builder, windows_x86_64);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::select_provider<First, FirstReading>(builder, linux_x86_64);
 Build::select_provider<Second, SecondReading>(builder, linux_x86_64);
 Build::select_provider<Combined, CombinedReading>(builder, linux_x86_64);
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::select_provider<First, FirstReading>(builder, macos_arm64);
 Build::select_provider<Second, SecondReading>(builder, macos_arm64);
 Build::select_provider<Combined, CombinedReading>(builder, macos_arm64);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::select_provider<First, FirstReading>(builder, linux_arm64);
 Build::select_provider<Second, SecondReading>(builder, linux_arm64);
 Build::select_provider<Combined, CombinedReading>(builder, linux_arm64);
}
