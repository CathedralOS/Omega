// Fact: a copyable C quotient/remainder record preserves both signed fields and independent earlier-call contents through transport and copying into the consuming operation.
// Expected exit: 0
use omega::language::core::external_binding;
public data Division [copy] { quotient: i64; remainder: i64; }
public boundary trait IntegerDivision {
 machine divide(numerator: i64, denominator: i64) -> Division reaches;
}
public macos_arm64 machine macos_arm64_division_binding() -> ForeignBinding<26, 6, 0> {
 ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_lldiv" } }
}
public linux_x86_64 machine linux_x86_64_division_binding() -> ForeignBinding<9, 5, 11> {
 ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "lldiv", version: "GLIBC_2.2.5" } }
}
public linux_arm64 machine linux_arm64_division_binding() -> ForeignBinding<9, 5, 10> {
 ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "lldiv", version: "GLIBC_2.17" } }
}
public windows_x86_64 machine windows_x86_64_division_binding() -> ForeignBinding<33, 5, 0> {
 ForeignBinding::DllImport { import: DllImport::PeByName { library: "api-ms-win-crt-utility-l1-1-0.dll", export: "lldiv" } }
}
macos_arm64 boundary machine divide(numerator: i64, denominator: i64) -> Division satisfies IntegerDivision::divide via macos_arm64_division_binding();
linux_x86_64 boundary machine divide(numerator: i64, denominator: i64) -> Division satisfies IntegerDivision::divide via linux_x86_64_division_binding();
linux_arm64 boundary machine divide(numerator: i64, denominator: i64) -> Division satisfies IntegerDivision::divide via linux_arm64_division_binding();
windows_x86_64 boundary machine divide(numerator: i64, denominator: i64) -> Division satisfies IntegerDivision::divide via windows_x86_64_division_binding();

machine consume(first: Division, copied: Division) -> bool reaches IntegerDivision {
 let second: Division = divide(70000000000, 9);
 first.quotient == -23333333333 && first.remainder == -1
 && copied.quotient == -23333333333 && copied.remainder == -1
 && second.quotient == 7777777777 && second.remainder == 7
}
machine receive(value: Division) -> bool reaches IntegerDivision { consume(value, value) }
machine produce() -> Division reaches IntegerDivision { divide(-70000000000, 3) }
machine observe() -> bool reaches IntegerDivision { receive(produce()) }

machine main() reaches IntegerDivision crashes Trap {
 transition observe() { true -> done() _ -> failed() }
 machine done() {}
 machine failed() crashes Trap { crash Trap; }
}
