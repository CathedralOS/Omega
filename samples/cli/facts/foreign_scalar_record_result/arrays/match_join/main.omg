// Fact: a copyable C quotient/remainder record preserves both signed fields and independent earlier-call contents through transport and copying into the consuming operation.
// Expected exit: 0
use omega::language::core::external_binding;
public data Word [copy] { value: i64; guard: [u8; 4]; }
public data Division [copy] { parts: [Word; 2]; }
public boundary trait IntegerDivision {
 machine divide(numerator: i64, denominator: i64) -> Division reaches;
 machine verify(first: Division, copied: Division) -> bool reaches;
}
public macos_arm64 machine macos_arm64_division_binding() -> ForeignBinding<31, 15, 0> {
 ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libomega_arraydiv_fixture.dylib", symbol: "_arraydiv_lldiv" } }
}
public linux_x86_64 machine linux_x86_64_division_binding() -> ForeignBinding<28, 14, 12> {
 ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libomega_arraydiv_fixture.so", symbol: "arraydiv_lldiv", version: "ARRAYDIV_1.0" } }
}
public linux_arm64 machine linux_arm64_division_binding() -> ForeignBinding<28, 14, 12> {
 ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libomega_arraydiv_fixture.so", symbol: "arraydiv_lldiv", version: "ARRAYDIV_1.0" } }
}
public windows_x86_64 machine windows_x86_64_division_binding() -> ForeignBinding<26, 14, 0> {
 ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_arraydiv_fixture.dll", export: "arraydiv_lldiv" } }
}
public macos_arm64 boundary machine divide(numerator: i64, denominator: i64) -> Division satisfies IntegerDivision::divide via macos_arm64_division_binding();
