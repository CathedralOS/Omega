public macos_arm64 boundary machine verify(first: Division, copied: Division) -> bool satisfies IntegerDivision::verify via macos_arm64_verify_binding();
public linux_x86_64 boundary machine verify(first: Division, copied: Division) -> bool satisfies IntegerDivision::verify via linux_x86_64_verify_binding();
public linux_arm64 boundary machine verify(first: Division, copied: Division) -> bool satisfies IntegerDivision::verify via linux_arm64_verify_binding();
public windows_x86_64 boundary machine verify(first: Division, copied: Division) -> bool satisfies IntegerDivision::verify via windows_x86_64_verify_binding();

machine consume(first: Division, copied: Division) -> bool reaches IntegerDivision {
 let second: Division = divide(70000000000, 9);
 first.parts[0].value == -23333333333 && first.parts[1].value == -1
 && copied.parts[0].value == -23333333333 && copied.parts[1].value == -1
 && second.parts[0].value == 7777777777 && second.parts[1].value == 7
 && first.parts[0].guard[0] == 17 && first.parts[0].guard[1] == 34 && first.parts[0].guard[2] == 51 && first.parts[0].guard[3] == 68
 && first.parts[1].guard[0] == 85 && first.parts[1].guard[1] == 102 && first.parts[1].guard[2] == 119 && first.parts[1].guard[3] == 136
 && copied.parts[0].guard[0] == 17 && copied.parts[0].guard[1] == 34 && copied.parts[0].guard[2] == 51 && copied.parts[0].guard[3] == 68
 && copied.parts[1].guard[0] == 85 && copied.parts[1].guard[1] == 102 && copied.parts[1].guard[2] == 119 && copied.parts[1].guard[3] == 136
 && second.parts[0].guard[0] == 18 && second.parts[0].guard[1] == 35 && second.parts[0].guard[2] == 52 && second.parts[0].guard[3] == 69
 && second.parts[1].guard[0] == 86 && second.parts[1].guard[1] == 103 && second.parts[1].guard[2] == 120 && second.parts[1].guard[3] == 137
 && verify(first, copied)
}
machine receive(value: Division) -> bool reaches IntegerDivision { consume(value, value) }
data Selection { division: Division; branch: bool; }
machine select(choice: bool) -> Selection reaches IntegerDivision {
 match choice {
  true -> Selection { division: divide(-70000000000, 3), branch: true }
  _ -> Selection { division: divide(-70000000000, 3), branch: false }
 }
}
machine observe() -> bool reaches IntegerDivision {
 let selected_true: Selection = select(true);
 let selected_false: Selection = select(false);
 selected_true.branch && !selected_false.branch
 && receive(selected_true.division) && receive(selected_false.division)
}

machine main() reaches IntegerDivision crashes Trap {
 transition observe() { true -> done() _ -> failed() }
 machine done() {}
 machine failed() crashes Trap { crash Trap; }
}
