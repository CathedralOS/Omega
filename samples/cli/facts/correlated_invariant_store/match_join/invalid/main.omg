// amount <= 320 - counter.total makes exact counter.total + amount preserve counter.total <= 320.
// Place: match_join.
// Expected exit: 0
data Counter where total <= 320 { total: u64; }
machine advance(counter: &mut Counter, amount: u64, choose_first: bool)
requires amount <= 1000 && amount <= 321 - counter.total
{
    let delivered: u64 = match choose_first { true -> amount, false -> 320 - counter.total };
    counter.total = counter.total + delivered;
}

machine main() crashes Trap {
    let mut interior: Counter = Counter { total: 30 };
    let mut endpoint: Counter = Counter { total: 300 };
    let mut unchanged: Counter = Counter { total: 320 };
    let mut alternate: Counter = Counter { total: 30 };
    let mut full: Counter = Counter { total: 0 };
    advance(&mut interior, 40, true);
    advance(&mut endpoint, 20, false);
    advance(&mut unchanged, 0, true);
    advance(&mut full, 320, false);
    advance(&mut alternate, 40, false);
    transition interior.total == 70 && endpoint.total == 320
        && unchanged.total == 320 && full.total == 320 && alternate.total == 320 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
