// amount <= 320 - counter.total makes exact counter.total + amount preserve counter.total <= 320.
// Place: match_join.
// Expected exit: 0
data Counter requires total <= 320 { total: u64; }
machine advance(counter: @mutable Counter, amount: u64, choose_first: bool)
requires amount <= 1000 && amount <= 320 - counter.total
{
    let delivered: u64 = match choose_first { true -> amount, false -> 320 - counter.total };
    counter.total = counter.total + delivered;
}

machine main() crashes Trap {
    let mutable interior: Counter = Counter { total: 30 };
    let mutable endpoint: Counter = Counter { total: 300 };
    let mutable unchanged: Counter = Counter { total: 320 };
    let mutable alternate: Counter = Counter { total: 30 };
    let mutable full: Counter = Counter { total: 0 };
    advance(@mutable interior, 40, true);
    advance(@mutable endpoint, 20, false);
    advance(@mutable unchanged, 0, true);
    advance(@mutable full, 320, false);
    advance(@mutable alternate, 40, false);
    transition interior.total == 70 && endpoint.total == 320
        && unchanged.total == 320 && full.total == 320 && alternate.total == 320 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
