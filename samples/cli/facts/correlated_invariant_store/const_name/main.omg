// amount <= 320 - counter.total makes exact counter.total + amount preserve counter.total <= 320.
// Place: const_name.
// Expected exit: 0
data Counter requires total <= 320 { total: u64; }
const LIMIT: u64 = 320;
machine advance(counter: @mutable Counter, amount: u64)
requires amount <= LIMIT - counter.total
{
    counter.total = counter.total + amount;
}

machine main() crashes Trap {
    let mutable interior: Counter = Counter { total: 30 };
    let mutable endpoint: Counter = Counter { total: 300 };
    let mutable unchanged: Counter = Counter { total: 320 };
    let mutable full: Counter = Counter { total: 0 };
    advance(@mutable interior, 40);
    advance(@mutable endpoint, 20);
    advance(@mutable unchanged, 0);
    advance(@mutable full, 320);
    transition interior.total == 70 && endpoint.total == 320
        && unchanged.total == 320 && full.total == 320 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
