machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "dynamic_suspension_const_name" };
    Build::select_provider::<Scheduler, InlineScheduler>(builder, linux_x86_64);
    Build::select_provider::<Scheduler, InlineScheduler>(builder, linux_arm64);
    Build::select_provider::<Scheduler, InlineScheduler>(builder, windows_x86_64);
    Build::select_provider::<Scheduler, InlineScheduler>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
