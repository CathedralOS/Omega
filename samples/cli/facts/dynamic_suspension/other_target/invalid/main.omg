// Fact: a suspension-capable dyn call preserves its selector, explicit operand, and public result bound when subtracting 100u64.
// Expected exit: 0

public boundary trait Scheduler {
    machine identity(value: u64) -> u64
    ensures result == value
    suspends reaches;
}

InlineScheduler satisfies Scheduler {
    machine identity(value: u64) -> u64 ensures result == value { value }
}

trait DeferredValue {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result == 100u64
    suspends;
}

InlineValue satisfies DeferredValue {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result == 100u64
    suspends
    {
        let returned: u64 = suspend Scheduler::identity(value);
        returned
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedInvoke {
    machine invoke(selected: dyn DeferredValue) -> u64
    ensures result == 100u64
    suspends reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86Invoke satisfies SelectedInvoke {
    machine invoke(selected: dyn DeferredValue) -> u64
    ensures result == 100u64
    suspends {
        SelectedBodyCheck::require_tag(17u64);
        let observed: u64 = suspend DeferredValue::get(selected, 99u64);
        observed
    }
}
ArmInvoke satisfies SelectedInvoke {
    machine invoke(selected: dyn DeferredValue) -> u64
    ensures result == 100u64
    suspends {
        SelectedBodyCheck::require_tag(29u64);
        let observed: u64 = suspend DeferredValue::get(selected, 99u64);
        observed
    }
}

machine main() crashes Trap {
    let selected: dyn DeferredValue = InlineValue as dyn DeferredValue;
    let observed: u64 = suspend SelectedInvoke::invoke(selected);
    let difference: u64 = observed - 100u64;
    transition difference == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    suspend main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    suspend main();
}
