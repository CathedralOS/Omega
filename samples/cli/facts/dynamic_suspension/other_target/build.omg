machine build(builder: &mut Build) {
    Build::application(builder, "dynamic_suspension_other_target");
    Build::select_provider<Scheduler, InlineScheduler>(builder, linux_x86_64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, linux_arm64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, windows_x86_64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedInvoke, X86Invoke>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedInvoke, X86Invoke>(builder, linux_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedInvoke, ArmInvoke>(builder, macos_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedInvoke, ArmInvoke>(builder, linux_arm64);
}
