// Fact: a suspension-capable dyn call preserves its selector, explicit operand, and public result bound when subtracting 100u64.
// Expected exit: 0

public boundary trait Scheduler {
    machine identity(value: u64) -> u64
    ensures result == value
    suspends; reaches;
}

InlineScheduler satisfies Scheduler {
    machine identity(value: u64) -> u64 ensures result == value { value }
}

trait DeferredValue {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result == 100u64
    suspends;
}

WaitingValue satisfies DeferredValue {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result == 100u64
    suspends;
    {
        let returned: u64 = suspend Scheduler::identity(value);
        returned
    }
}

PureValue satisfies DeferredValue {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result == 100u64
    { value }
}
data Holder [copy] { selected: dyn DeferredValue; }
machine main() crashes Trap {
    let mut selected: dyn DeferredValue = PureValue as dyn DeferredValue;
    let saved: Holder = Holder { selected: selected };
    let first: u64 = suspend DeferredValue::get(selected, 100u64);
    selected = WaitingValue as dyn DeferredValue;
    let second: u64 = suspend DeferredValue::get(selected, 100u64);
    let original: u64 = DeferredValue::get(saved.selected, 100u64);
    let first_difference: u64 = first - 100u64;
    let second_difference: u64 = second - 100u64;
    let original_difference: u64 = original - 100u64;
    transition first_difference == 0u64 && second_difference == 0u64 && original_difference == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
