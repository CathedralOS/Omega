use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "dynamic_suspension_parameter_invalid" };
    Build::select_provider::<|app|::Scheduler, |app|::InlineScheduler>(builder, linux_x86_64);
    Build::select_provider::<|app|::Scheduler, |app|::InlineScheduler>(builder, linux_arm64);
    Build::select_provider::<|app|::Scheduler, |app|::InlineScheduler>(builder, windows_x86_64);
    Build::select_provider::<|app|::Scheduler, |app|::InlineScheduler>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
