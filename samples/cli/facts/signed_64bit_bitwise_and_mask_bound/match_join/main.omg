// Fact: 64-bit signed bitwise AND mask raw & 63i64 with bounded interval 40i64 <= masked <= 63i64 establishes 40i64 <= masked <= 63i64 across all nine places so exact subtractions 63i64 - masked and masked - 40i64 are safe.
// Place: match join. Both match arms yield bounded 64-bit operands and join before bitwise AND and interval discharge.
// Expected exit: 0

machine choose_raw(flag: bool) -> i64
ensures result >= 112 && result <= 127
{
    match flag {
        true -> 116i64,
        false -> 120i64,
    }
}

machine verify_masked(masked: i64) -> i64
requires masked >= 40 && masked <= 63
{
    let headroom: i64 = 63i64 - masked;
    let margin: i64 = masked - 40i64;
    headroom + margin
}

machine bitwise_and_join() -> i64 {
    let raw: i64 = choose_raw(true);
    let masked: i64 = raw & 63i64;
    verify_masked(masked)
}

machine probe() -> i64 {
    bitwise_and_join()
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
