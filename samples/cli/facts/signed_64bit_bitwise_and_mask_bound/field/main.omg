// Fact: 64-bit signed bitwise AND mask raw & 63i64 with bounded interval 40i64 <= masked <= 63i64 establishes 40i64 <= masked <= 63i64 across all nine places so exact subtractions 63i64 - masked and masked - 40i64 are safe.
// Place: field. The 64-bit signed operand and mask are stored in record fields before bitwise AND and interval discharge.
// Expected exit: 0

data AndPacket [copy] {
    raw: i64;
    mask: i64;
}

machine verify_masked(masked: i64) -> i64
requires masked >= 40 && masked <= 63
{
    let headroom: i64 = 63i64 - masked;
    let margin: i64 = masked - 40i64;
    headroom + margin
}

machine bitwise_and_field(pkt: AndPacket) -> i64
requires pkt.raw >= 112 && pkt.raw <= 127 && pkt.mask == 63
{
    let masked: i64 = pkt.raw & pkt.mask;
    verify_masked(masked)
}

machine probe() -> i64 {
    let pkt: AndPacket = AndPacket {
        raw: 116i64,
        mask: 63i64,
    };
    bitwise_and_field(pkt)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
