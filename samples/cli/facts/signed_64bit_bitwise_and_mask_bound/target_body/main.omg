// Fact: 64-bit signed bitwise AND mask raw & 63i64 with bounded interval 40i64 <= masked <= 63i64 establishes 40i64 <= masked <= 63i64 across all nine places so exact subtractions 63i64 - masked and masked - 40i64 are safe.
// Place: another target body. Each of four target-scoped machine bodies performs 64-bit bitwise AND and discharges interval.
// Expected exit: 0

machine verify_masked(masked: i64) -> i64
requires masked >= 40 && masked <= 63
{
    let headroom: i64 = 63i64 - masked;
    let margin: i64 = masked - 40i64;
    headroom + margin
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedBitwiseAndTarget {
    machine bitwise_and_target(raw: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 112 && raw <= 127;
}

X86BitwiseAndTarget satisfies SelectedBitwiseAndTarget {
    machine bitwise_and_target(raw: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 112 && raw <= 127
    {
        SelectedBodyCheck::require_tag(17u64);
        let masked: i64 = raw & 63i64;
        verify_masked(masked)
    }
}

ArmBitwiseAndTarget satisfies SelectedBitwiseAndTarget {
    machine bitwise_and_target(raw: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 112 && raw <= 127
    {
        SelectedBodyCheck::require_tag(29u64);
        let masked: i64 = raw & 63i64;
        verify_masked(masked)
    }
}

machine probe() -> i64 {
    SelectedBitwiseAndTarget::bitwise_and_target(116i64)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
