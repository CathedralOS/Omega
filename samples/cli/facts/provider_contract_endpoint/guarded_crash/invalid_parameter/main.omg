// The selected provider makes limit() equal to 7; requires value <= limit() preserves the bound needed to prove 7 - value.
// Expected: reject an unhandled Trap route before constant execution
public boundary trait Endpoint {
    machine upper() -> u64 reaches terminates;
}
public Actual satisfies Endpoint {
    machine upper() -> u64 { 7 }
}
const DIVISOR: u64 = 0u64;

machine divide(numerator: u64, denominator: u64) -> u64
crashes Trap denominator == 0u64
{
    transition denominator == 0u64 {
        true -> bad()
        false -> (numerator / denominator)
    }
    machine bad() -> u64 crashes Trap { crash Trap; }
}

machine limit() -> u64
crashes Trap DIVISOR == 0u64
{
    divide(Endpoint::upper(), DIVISOR)
}
machine bounded(value: u64) -> u64
requires value <= limit()
ensures result <= limit()
{ value }
machine subtract(value: u64) -> u64
requires value <= limit()
{ 7u64 - value }
public machine main() invokes Endpoint crashes Trap {
    let produced: u64 = bounded(7);
    let difference: u64 = subtract(produced);
    transition difference == 0 && limit() == 7u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
