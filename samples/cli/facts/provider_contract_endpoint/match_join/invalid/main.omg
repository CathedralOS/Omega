// The selected provider makes limit() equal to 7; requires value <= limit() preserves the bound needed to prove 7 - value.
// Expected exit: 0
public boundary trait Endpoint {
    machine upper() -> u64 reaches terminates;
}
public Actual satisfies Endpoint {
    machine upper() -> u64 { 6 }
}
machine wrapping_endpoint(value: u8 in Wrapping) -> u64 { (value + 2) as u64 }
machine argument_result(flag: bool) -> u64 {
    wrapping_endpoint((match flag { true -> 254, false -> 0 }) + 1)
}
machine upper_bound<const N: u64>(value: u64) -> u64
requires value <= N
{ N }
machine match_wrapping_policy_bound(value: u64) -> u64
requires value <= wrapping_endpoint((match true { true -> 254, false -> 0 }) + 1)
{ upper_bound<257>(value) }
machine limit() -> u64 invokes Endpoint {
    let admitted: u64 = match_wrapping_policy_bound(1);
    transition argument_result(true) == 1 {
        true -> Endpoint::upper()
        _ -> (6u64)
    }
}
machine bounded(value: u64) -> u64 invokes Endpoint
requires value <= limit()
ensures result <= limit()
{ value }
machine choose(flag: bool) -> u64
ensures result <= limit()
{ match flag { true -> bounded(7), false -> bounded(7) } }
machine choose_distinct(flag: bool) -> u64
ensures result <= limit()
{ match flag { true -> bounded(7), false -> bounded(3) } }
public machine main() invokes Endpoint crashes Trap {
    let value: u64 = choose(true);
    let difference: u64 = 7u64 - value;
    let other: u64 = choose(false);
    let other_difference: u64 = 7u64 - other;
    let selected: u64 = choose_distinct(true);
    let fallback: u64 = choose_distinct(false);
    let selected_difference: u64 = 7u64 - selected;
    let fallback_difference: u64 = 7u64 - fallback;
    transition difference == 0 && other_difference == 0 && limit() == 7u64 && match_wrapping_policy_bound(1) == 257 && argument_result(true) == 1 && argument_result(false) == 3 && selected_difference == 0 && fallback_difference == 4 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
