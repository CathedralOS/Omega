use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "provider_contract_endpoint_probe" };
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, linux_arm64);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, linux_x86_64);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, macos_arm64);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, macos_x86_64);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, windows_x86_64);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, local_unchecked);
    Build::select_provider::<|app|::Endpoint, |app|::Actual>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
