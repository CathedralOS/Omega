// Fact: a checked Boolean view of an entry u8 equal to 1 discharges maybe_clear's value == false Trap crash guard without a caller crash ceiling.
machine maybe_clear(value: bool) -> bool
crashes Trap value == false
{
    transition value == false { true -> bad() false -> (value) }
    machine bad() -> bool { crash Trap; }
}
public data Byte where value >= 0 && value <= 1 { value: u8; }
windows_x86_64 machine forward(value: bool) -> bool
crashes Trap value == false
{
    maybe_clear(value)
}
linux_x86_64 machine forward(value: bool) -> bool
crashes Trap value == false
{
    maybe_clear(value)
}
macos_arm64 machine forward(value: bool) -> bool
crashes Trap value == false
{
    maybe_clear(value)
}
linux_arm64 machine forward(value: bool) -> bool
crashes Trap value == false
{
    maybe_clear(value)
}
public machine read_flag(byte: &Byte) -> bool
{
    let view: &bool = &byte.value as &bool;
    let observed: bool = view;
    forward(observed)
}
machine main() crashes Trap {
    let byte: Byte = Byte { value: 1 };
    let observed: bool = read_flag(&byte);
    transition observed == true { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
