// Fact: a checked Boolean view of an entry u8 equal to 1 discharges maybe_clear's value == false Trap crash guard without a caller crash ceiling.
machine maybe_clear(value: bool) -> bool
crashes Trap value == false
{
    transition value == false { true -> bad() false -> (value) }
    machine bad() -> bool { crash Trap; }
}
public data Byte requires value >= 0 && value <= 1 { value: u8; }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedForward {
    machine forward(value: bool) -> bool reaches crashes Trap value == false;
}
X86Forward satisfies SelectedForward {
    machine forward(value: bool) -> bool
    crashes Trap value == false
    {
        maybe_clear(value)
    }
}
ArmForward satisfies SelectedForward {
    machine forward(value: bool) -> bool
    crashes Trap value == false
    {
        maybe_clear(value)
    }
}
public machine read_flag(byte: &Byte) -> bool
reaches SelectedForward invokes SelectedForward
{
    let view: &bool = &byte.value as &bool;
    let observed: bool = view;
    SelectedForward::forward(observed)
}
machine main() crashes Trap {
    let byte: Byte = Byte { value: 1 };
    let observed: bool = read_flag(&byte);
    transition observed == true { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
