machine build(builder: &mut Build) {
    Build::application(builder, "build_target_provider_target_body_invalid");
    Build::depend(builder, Source::Path { location: "reading_provider" });
    Build::select_provider<Calculation, FirstCalculationBody>(builder, windows_x86_64);
    Build::select_provider<Calculation, FirstCalculationBody>(builder, macos_x86_64);
    Build::select_provider<Calculation, FirstCalculationBody>(builder, linux_x86_64);
    Build::select_provider<Calculation, SecondCalculationBody>(builder, macos_arm64);
    Build::select_provider<Calculation, SecondCalculationBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, second_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, second_entry);
}
