// A target-keyed provider call establishes total >= 1000, so exact subtraction total - 1000 preserves the selected provider result.
// Expected exit: 0
use reading_provider\main\Reading;
machine consume(total: u64) -> u64 requires total >= 1000u64 { total - 1000u64 }
machine journey(expected: u64) reaches Reading<17u64> crashes Trap {
    let difference: u64 = consume(Reading::<17u64>::total());
    transition difference == expected { true -> done(), false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine first_entry() reaches Reading<17u64> crashes Trap { journey(100u64); }
machine second_entry() reaches Reading<17u64> crashes Trap { journey(1100u64); }
