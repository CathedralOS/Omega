// A target-keyed provider call establishes total >= 1000, so exact subtraction total - 1000 preserves the selected provider result.
// Expected exit: 0
use {reading_provider}/main/provider.omg;
const SUBTRAHEND: u64 = 1000u64;
machine journey(expected: u64) reaches |provider|::Reading<17u64> crashes Trap {
    let difference: u64 = |provider|::Reading::<17u64>::total() - SUBTRAHEND;
    transition difference == expected { true -> done(), false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine first_entry() reaches |provider|::Reading<17u64> crashes Trap { journey(100u64); }
machine second_entry() reaches |provider|::Reading<17u64> crashes Trap { journey(1100u64); }
