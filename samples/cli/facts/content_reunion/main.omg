// Expected exit: 0. Numeric custody only, not physical storage or an allocator.
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { base: u64; length: u64; }
domain Region::Owned established by issue;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat }
}
machine issue() -> Region in Owned
ensures result.base == 10, result.length == 48
{ Region { base: 10, length: 48 } }
machine Region::drop(region: &mut Region) {}
data Holder { parts: Parts; }
data Parts { left: Region in Owned; right: Region in Owned; }
machine merge(left: Region in Owned, right: Region in Owned) -> Region in Owned
requires left.base <= 58 && left.length <= 58 - left.base
    && right.base == left.base + left.length && right.length <= 58 - right.base
ensures result.base == left.base, result.length == left.length + right.length,
    separate(Owned::content(old(&left)), Owned::content(old(&right))) == Owned::content(&result)
{
    let { base as left_base, length as left_length } = left;
    let { base as right_base, length as right_length } = right;
    Region { base: left_base, length: left_length + right_length }
}

machine partition(whole: Region in Owned, requested: u64) -> Parts
requires whole.base <= 58 && whole.length <= 58 - whole.base && requested <= whole.length
ensures
    result.left.base == whole.base,
    result.left.length == requested,
    result.right.length == whole.length - requested,
    result.right.base == whole.base + requested,
    Owned::content(old(&whole)) == separate(Owned::content(&result.left), Owned::content(&result.right))
{
    let { base, length } = whole;
    Parts { left: Region { base: base, length: requested },
        right: Region { base: base + requested, length: length - requested } }
}
machine rejoin_local(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let parts: Parts = partition(whole, requested);
    let joined: Region in Owned = merge(parts.left, parts.right);
    let { base, length } = joined;
    let reunited: Region = Region { base: base, length: length };
    reunited
}
machine rejoin_field(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let holder: Holder = Holder { parts: partition(whole, requested) };
    let joined: Region in Owned = merge(holder.parts.left, holder.parts.right);
    let { base, length } = joined;
    let reunited: Region = Region { base: base, length: length };
    reunited
}
machine rejoin_state(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    transition { _ -> complete(whole, requested) }
    state complete(whole: Region in Owned, requested: u64) -> Region
    requires whole.base == 10 && whole.length == 48 && requested <= whole.length
    {
    let parts: Parts = partition(whole, requested);
    let joined: Region in Owned = merge(parts.left, parts.right);
    let { base, length } = joined;
    let reunited: Region = Region { base: base, length: length };
    reunited
    }
}
machine rejoin_nested(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let parts: Parts = partition(whole, requested);
    let tail: Parts = partition(parts.right, 0);
    let reunited_tail: Region in Owned = merge(tail.left, tail.right);
    let joined: Region in Owned = merge(parts.left, reunited_tail);
    let { base, length } = joined;
    let reunited: Region = Region { base: base, length: length };
    reunited
}
machine rejoin_call_result(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let returned: Region in Owned = rejoin_state(whole, requested);
    let parts: Parts = partition(returned, requested);
    let joined: Region in Owned = merge(parts.left, parts.right);
    let { base, length } = joined;
    let reunited: Region = Region { base: base, length: length };
    reunited
}
machine rejoin_return_local(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let parts: Parts = partition(whole, requested);
    let joined: Region in Owned = merge(parts.left, parts.right);
    let { base, length } = joined;
    let result: Region = Region { base: base, length: length };
    result
}
machine rejoin_anonymous(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let parts: Parts = (Holder { parts: partition(whole, requested) }).parts;
    let left: Region in Owned = parts.left;
    let right: Region in Owned = parts.right;
    let joined: Region in Owned = merge(left, right);
    let { base, length } = joined;
    let reunited: Region = Region { base: base, length: length };
    reunited
}
machine exercise(requested: u64) -> bool
requires requested <= 48
{
    let local: Region in Owned = rejoin_local(issue(), requested);
    let field: Region in Owned = rejoin_field(issue(), requested);
    let state_result: Region in Owned = rejoin_state(issue(), requested);
    let nested: Region in Owned = rejoin_nested(issue(), requested);
    let composed: Region in Owned = rejoin_call_result(issue(), requested);
    let returned_local: Region in Owned = rejoin_return_local(issue(), requested);
    let anonymous: Region in Owned = rejoin_anonymous(issue(), requested);
    let correct: bool = local.base == 10 && local.length == 48 &&
        field.base == 10 && field.length == 48 &&
        state_result.base == 10 && state_result.length == 48 &&
        nested.base == 10 && nested.length == 48 &&
        composed.base == 10 && composed.length == 48 &&
        returned_local.base == 10 && returned_local.length == 48 &&
        anonymous.base == 10 && anonymous.length == 48;
    drop(local);
    drop(field);
    drop(state_result);
    drop(nested);
    drop(composed);
    drop(returned_local);
    drop(anonymous);
    correct
}
machine main() crashes Trap {
    let empty: bool = exercise(0);
    let interior: bool = exercise(16);
    let full: bool = exercise(48);
    transition empty && interior && full { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
