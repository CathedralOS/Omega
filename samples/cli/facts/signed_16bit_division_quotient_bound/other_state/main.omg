// Fact: a 16-bit signed i16 division of bounded inputs (dividend >= 400i16 && dividend <= 400i16, divisor >= 8i16 && divisor <= 8i16) establishes quotient >= 50i16 && quotient <= 50i16 so exact 16-bit signed subtraction quotient - 50i16 is proved overflow-free across all nine places.
// Expected exit: 0

machine verify_i16_quotient(q: i16) -> i32
requires q >= 50i16 && q <= 50i16
{
    let diff: i16 = q - 50i16;
    transition diff == 0i16 {
        true -> 0i32
        _ -> 1i32
    }
}

machine exercise(dividend: i16, divisor: i16) -> i32
requires dividend >= 400i16 && dividend <= 400i16
requires divisor >= 8i16 && divisor <= 8i16
{
    let quotient: i16 = dividend / divisor;
    transition { _ -> step(quotient) }
    machine step(q: i16) -> i32 requires q >= 50i16 && q <= 50i16 {
        verify_i16_quotient(q)
    }
}

machine main() crashes Trap {
    let exit_code: i32 = exercise(400i16, 8i16);
    transition exit_code == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
