// IEEE numeric equality does not establish exact representation equality.
// Expected: reject false ensures.
machine read_bits(value: f32) -> u32 {
    let view: &u32 = &value as &u32;
    let bits: u32 = view;
    bits
}
machine false_bits(left: f32, right: f32) -> u32
requires left == right
ensures result == read_bits(right)
{ read_bits(left) }
machine main() crashes Trap {
    let result: u32 = false_bits(0.0f32, -0.0f32);
    transition result == 0x8000_0000u32 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
