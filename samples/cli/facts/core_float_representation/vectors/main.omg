// Exact IEEE endpoint, format, sign, kind and payload vectors; expectations are literals.
// Expected exit: 0
use omega::language::core::float;
machine negative(sign: float::Sign) -> bool {
    match sign { float::Sign::Positive -> false, float::Sign::Negative -> true }
}
machine classify32(bits: u32, expected_negative: bool, expected_kind: u32, expected_payload: u32) -> bool {
    let value: f32 = float::from_bits(bits);
    let shape: bool = match float::classify<f32>(value) {
        float::Classification::Zero { sign } -> (expected_kind == 0u32 && negative(sign) == expected_negative),
        float::Classification::Subnormal { sign } -> (expected_kind == 1u32 && negative(sign) == expected_negative),
        float::Classification::Normal { sign } -> (expected_kind == 2u32 && negative(sign) == expected_negative),
        float::Classification::Infinity { sign } -> (expected_kind == 3u32 && negative(sign) == expected_negative),
        float::Classification::NaN { sign, kind, payload } -> (negative(sign) == expected_negative && payload == expected_payload && (match kind { float::NaNKind::Quiet -> (expected_kind == 4u32), float::NaNKind::Signaling -> (expected_kind == 5u32) }))
    };
    shape && negative(float::sign<f32>(value)) == expected_negative
        && float::is_nan<f32>(value) == (expected_kind >= 4u32)
        && float::is_signaling_nan<f32>(value) == (expected_kind == 5u32)
        && float::is_finite<f32>(value) == (expected_kind <= 2u32)
}
machine classify64(bits: u64, expected_negative: bool, expected_kind: u32, expected_payload: u64) -> bool {
    let value: f64 = float::from_bits(bits);
    let shape: bool = match float::classify<f64>(value) {
        float::Classification::Zero { sign } -> (expected_kind == 0u32 && negative(sign) == expected_negative),
        float::Classification::Subnormal { sign } -> (expected_kind == 1u32 && negative(sign) == expected_negative),
        float::Classification::Normal { sign } -> (expected_kind == 2u32 && negative(sign) == expected_negative),
        float::Classification::Infinity { sign } -> (expected_kind == 3u32 && negative(sign) == expected_negative),
        float::Classification::NaN { sign, kind, payload } -> (negative(sign) == expected_negative && payload == expected_payload && (match kind { float::NaNKind::Quiet -> (expected_kind == 4u32), float::NaNKind::Signaling -> (expected_kind == 5u32) }))
    };
    shape && negative(float::sign<f64>(value)) == expected_negative
        && float::is_nan<f64>(value) == (expected_kind >= 4u32)
        && float::is_signaling_nan<f64>(value) == (expected_kind == 5u32)
        && float::is_finite<f64>(value) == (expected_kind <= 2u32)
}
machine main() crashes Trap {
