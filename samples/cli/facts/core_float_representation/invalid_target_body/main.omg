// The ordinary float bit wrappers preserve a negative signaling NaN's exact sign and payload through transport, permitting subtraction of its presented bits.
// Place: target_body.
// Expected exit: 0
use omega::language::core::float;

machine consume(value: f32) -> u32
requires float::to_bits(value) == 0xFF80_0123u32
ensures result == 0u32
{ float::to_bits(value) - 0xFF80_0123u32 }

boundary trait FloatProbe {
    machine probe() -> u32 reaches ensures result == 0u32;
}

WindowsFloatProbe satisfies FloatProbe {
    machine probe() -> u32 ensures result == 0u32 { consume(float::from_bits(0xFF80_0124u32)) }
}
LinuxX86FloatProbe satisfies FloatProbe {
    machine probe() -> u32 ensures result == 0u32 { consume(float::from_bits(0xFF80_0124u32)) }
}
MacFloatProbe satisfies FloatProbe {
    machine probe() -> u32 ensures result == 0u32 { consume(float::from_bits(0xFF80_0124u32)) }
}
LinuxArmFloatProbe satisfies FloatProbe {
    machine probe() -> u32 ensures result == 0u32 { consume(float::from_bits(0xFF80_0124u32)) }
}

machine main() reaches FloatProbe crashes Trap {

    let presented: f32 = float::from_bits(0xFF80_0123u32);
    let quieted: u32 = float::to_bits(float::quiet<f32>(presented));
    transition FloatProbe::probe() == 0u32 && float::is_signaling_nan<f32>(presented) && quieted == 0xFFC0_0123u32 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
