use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "core_float_representation_target_body" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::FloatProbe, |app|::WindowsFloatProbe>(builder, windows_x86_64);
    Build::select_provider::<|app|::FloatProbe, |app|::LinuxX86FloatProbe>(builder, linux_x86_64);
    Build::select_provider::<|app|::FloatProbe, |app|::MacFloatProbe>(builder, macos_arm64);
    Build::select_provider::<|app|::FloatProbe, |app|::LinuxArmFloatProbe>(builder, linux_arm64);
}
