// Two contracted minima bound the exclusive end of a mutable subslice by the same view's length.
// Expected exit: 0
machine minimum(left: u64, right: u64) -> u64
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right)) {
    transition { left < right -> left _ -> right }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTrial {
    machine trial(buffer: &mut [u8], other: &[u8], count: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Trial satisfies SelectedTrial {
    machine trial(buffer: &mut [u8], other: &[u8], count: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let capacity: u64 = minimum(minimum(count, buffer.len), 2147483647);
        let prefix: &mut [u8] = &mut buffer[0..capacity];
        prefix.len
    }
}

ArmTrial satisfies SelectedTrial {
    machine trial(buffer: &mut [u8], other: &[u8], count: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let capacity: u64 = minimum(minimum(count, buffer.len), 2147483647);
        let prefix: &mut [u8] = &mut buffer[0..capacity];
        prefix.len
    }
}


machine main() crashes Trap {
    let mut bytes: [u8; 8];
    let other: [u8; 16];
    let first: u64 = SelectedTrial::trial(&mut bytes[..], &other[..], 13);
    let second: u64 = SelectedTrial::trial(&mut bytes[..], &other[..], 0);
    transition first == 8 && second == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
