// Two contracted minima bound the exclusive end of a mutable subslice by the same view's length.
// Expected exit: 0
machine minimum(left: u64, right: u64) -> u64
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right)) {
    transition { left < right -> left, _ -> right }
}
machine trial(buffer: @mutable [u8], other: @[u8], count: u64) -> u64 {
    let capacity: u64 = minimum(minimum(count, buffer.length), 2147483647);
    let prefix: @mutable [u8] = @mutable buffer[0..capacity];
    prefix.length
}
machine main() crashes Trap {
    let mutable bytes: [u8; 8];
    let other: [u8; 16];
    let first: u64 = trial(@mutable bytes[..], @other[..], 13);
    let second: u64 = trial(@mutable bytes[..], @other[..], 0);
    transition first == 8 && second == 0 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
