// Two contracted minima bound the exclusive end of a mutable subslice by the same view's length.
// Invalid control: another view's length cannot bound this view's subslice.
machine minimum(left: u64, right: u64) -> u64
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right)) {
    transition { left < right -> left _ -> right }
}
machine trial(buffer: &mut [u8], other: &[u8], count: u64) -> u64 {
    let capacity: u64 = minimum(minimum(count, other.len), 2147483647);
    transition { _ -> consume(buffer, capacity) }
    machine consume(buffer: &mut [u8], end: u64) -> u64
    requires end <= buffer.len;
    {
    let prefix: &mut [u8] = &mut buffer[0..end];
    prefix.len
    }
}
machine main() crashes Trap {
    let mut bytes: [u8; 8];
    let other: [u8; 16];
    let first: u64 = trial(&mut bytes[..], &other[..], 13);
    let second: u64 = trial(&mut bytes[..], &other[..], 0);
    transition first == 8 && second == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
