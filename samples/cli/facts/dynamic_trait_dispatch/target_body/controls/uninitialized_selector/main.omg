// Fact: a runtime dyn trait selector dispatches an inline conformance member over explicit data arguments to establish 100u64 when subtracting 100u64.
// Place: another target body. Each hosted target body dispatches combine through the dyn trait selector.
// Expected exit: 0

trait WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;
}

UnitCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        left + right
    }
}

linux_x86_64 machine probe(a: u64, b: u64) -> i32
requires a >= 60u64 && a <= 60u64
requires b >= 40u64 && b <= 40u64
{
    let selector: dyn WeightedCombine;
    let total: u64 = WeightedCombine::combine(selector, a, b);
    let diff: u64 = total - 100u64;
    diff as i32
}

linux_arm64 machine probe(a: u64, b: u64) -> i32
requires a >= 60u64 && a <= 60u64
requires b >= 40u64 && b <= 40u64
{
    let selector: dyn WeightedCombine;
    let total: u64 = WeightedCombine::combine(selector, a, b);
    let diff: u64 = total - 100u64;
    diff as i32
}

macos_arm64 machine probe(a: u64, b: u64) -> i32
requires a >= 60u64 && a <= 60u64
requires b >= 40u64 && b <= 40u64
{
    let selector: dyn WeightedCombine;
    let total: u64 = WeightedCombine::combine(selector, a, b);
    let diff: u64 = total - 100u64;
    diff as i32
}

windows_x86_64 machine probe(a: u64, b: u64) -> i32
requires a >= 60u64 && a <= 60u64
requires b >= 40u64 && b <= 40u64
{
    let selector: dyn WeightedCombine;
    let total: u64 = WeightedCombine::combine(selector, a, b);
    let diff: u64 = total - 100u64;
    diff as i32
}

machine main() crashes Trap {
    let result: i32 = probe(60u64, 40u64);
    transition result == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
