machine build(builder: &mut Build) {
    Build::application(builder, "dynamic_trait_dispatch_through_target_body");
    Build::accept_boundary<SelectedCombine>(builder);
    Build::select_provider<SelectedCombine, HostedCombine>(builder, macos_x86_64);
    Build::select_provider<SelectedCombine, HostedCombine>(builder, windows_x86_64);
    Build::select_provider<SelectedCombine, HostedCombine>(builder, linux_x86_64);
    Build::select_provider<SelectedCombine, HostedCombine>(builder, macos_arm64);
    Build::select_provider<SelectedCombine, HostedCombine>(builder, linux_arm64);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
