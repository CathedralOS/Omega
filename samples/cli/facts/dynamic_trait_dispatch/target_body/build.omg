use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "dynamic_trait_dispatch_through_target_body" };
    Build::accept_boundary::<|app|::HostedCombine>(builder);
    Build::select_provider::<|app|::SelectedCombine, |app|::HostedCombine>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedCombine, |app|::HostedCombine>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedCombine, |app|::HostedCombine>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedCombine, |app|::HostedCombine>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedCombine, |app|::HostedCombine>(builder, linux_arm64);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
