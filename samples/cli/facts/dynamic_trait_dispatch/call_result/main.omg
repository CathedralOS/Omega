// Fact: Calling a selected conformance member through a machine value preserves its guarantee of 100u64 for exact subtraction of 100u64.
// Place: call_result.
// Expected exit: 0

data CombineOperation = machine(left: u64, right: u64, observation: @mutable u64) -> u64
    reaches none crashes none
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;

trait WeightedCombine {
    machine combine(left: u64, right: u64, observation: @mutable u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;
}

UnitCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64, observation: @mutable u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        $observation = left;
        left + right
    }
}

OtherCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64, observation: @mutable u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        $observation = right;
        left + right
    }
}

machine get_selector(selected: CombineOperation) -> CombineOperation {
    let returned: CombineOperation = selected;
    returned
}

machine probe(selected: CombineOperation, a: u64, b: u64, observation: @mutable u64) -> u64
invokes selected
requires a >= 60u64 && a <= 60u64
requires b >= 40u64 && b <= 40u64
ensures result >= 100u64 && result <= 100u64
{
    let selector: CombineOperation = get_selector(selected);
    selector(a, b, observation)
}

machine main() crashes Trap {
    let first_selector: CombineOperation = UnitCombine::combine;
    let second_selector: CombineOperation = OtherCombine::combine;
    let mutable first_observation: u64 = 0;
    let mutable second_observation: u64 = 0;
    let first: u64 = probe(first_selector, 60u64, 40u64, @mutable first_observation);
    let second: u64 = probe(second_selector, 60u64, 40u64, @mutable second_observation);
    let first_difference: u64 = first - 100u64;
    let second_difference: u64 = second - 100u64;
    transition first_difference == 0u64 && second_difference == 0u64
        && first_observation == 60u64 && second_observation == 40u64 {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
