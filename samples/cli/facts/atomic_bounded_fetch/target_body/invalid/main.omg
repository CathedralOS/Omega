// Expected exit: 0.
// A shared atomic fetch preserves its resident bound and ordering, and a load carries that bound into Exact subtraction.
use omega::language::core::atomic;
data Cell requires value <= 100 { value: AtomicU32; }
machine mutate(cell: &Cell, mask: u32) -> u32 requires mask <= 127 {
    let prior: u32 = cell.value.fetch_and(mask, NoOrdering);
    prior
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserve {
    machine observe(cell: &Cell) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 100;
}

X86Observe satisfies SelectedObserve {
    machine observe(cell: &Cell) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
     cell.value.load(NoOrdering) 
    }
}

ArmObserve satisfies SelectedObserve {
    machine observe(cell: &Cell) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
     cell.value.load(NoOrdering) 
    }
}


machine main() crashes Trap {
    let cell: Cell;
    cell.value.store(99, NoOrdering);
    let prior: u32 = mutate(&cell, 63);
    let observed: u32 = SelectedObserve::observe(&cell);
    let remaining: u32 = 100 - observed;
    transition prior == 99 && observed == 35 && remaining == 65 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
