// Expected exit: 0.
// An admitted nominal length predicate fixes the selected value at seven and proves the assembly move stores seven.
data Counted<Count: u64> [copy] where length == Count { length: u64; }
machine snapshot(start: u64, end: u64) -> Counted<(end - start)>
requires start <= end { Counted { length: end - start } }
machine reset(cursor: &mut u64) -> u64
ensures cursor == 0 && result == 0 { cursor = 0; 0 }
machine finished() {}
machine failed() crashes Trap { crash Trap; }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedMoveSelected {
    machine move_selected<Count: u64>(selected: Counted<Count>, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires Count == 7 ensures result == 7;
}

X86MoveSelected satisfies SelectedMoveSelected {
    machine move_selected<Count: u64>(selected: Counted<Count>, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires Count == 7 ensures result == 7
    {
        SelectedBodyCheck::require_tag(17u64);
        let mut output: u64 = 99;
        asm where clobbers none {
        entry:
            mov output, selected.length;
        done requires output == 7 ensures output == selected.length && output == 7:
            nop
        }
        output
    }
}

ArmMoveSelected satisfies SelectedMoveSelected {
    machine move_selected<Count: u64>(selected: Counted<Count>, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires Count == 7 ensures result == 7
    {
        SelectedBodyCheck::require_tag(29u64);
        let mut output: u64 = 99;
        asm where clobbers none {
        entry:
            mov output, selected.length;
        done requires output == 7 ensures output == selected.length && output == 7:
            nop
        }
        output
    }
}


machine main() crashes Trap {
    let mut cursor: u64 = 2;
    let observed: u64 = SelectedMoveSelected::move_selected(snapshot(cursor, 9), reset(&mut cursor));
    transition observed == 7 && cursor == 0 { true -> finished() false -> failed() }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
