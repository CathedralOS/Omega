// Fact: a pure terminating boundary-trait provider selected per target closes the fixed-array extent of Main { values: [u8; limit()] } before layout observation (size_of<Main>() == 4u64 on Linux and 8u64 on Windows/macOS), discharging exact subtraction observed - 4u64 and runtime target-size agreement across all nine places.
boundary trait Answer { machine get() -> u64 reaches terminates; }
Small satisfies Answer { machine get() -> u64 { 2 } }
Large satisfies Answer { machine get() -> u64 { 2 } }
Same satisfies Answer { machine get() -> u64 { 2 } }
data TargetProviders {}
boundary trait SelectedTargetProvidersProviderDefaults {
    machine provider_defaults(defaults: &mut TargetProviders) reaches
;
}
LinuxX8664TargetProvidersProviderDefaults satisfies SelectedTargetProvidersProviderDefaults {
    machine provider_defaults(defaults: &mut TargetProviders)
{
    TargetProviders::select_provider<Answer, Small>(defaults);
}
}
WindowsX8664TargetProvidersProviderDefaults satisfies SelectedTargetProvidersProviderDefaults {
    machine provider_defaults(defaults: &mut TargetProviders)
{
    TargetProviders::select_provider<Answer, Large>(defaults);
}
}


machine limit() -> u64 { Answer::get() }
data Main { values: [u8; limit()]; }
data Inspector {}
machine Inspector::measure() -> u64 {
    size_of<Main>()
}
boundary trait SelectedExpected {
    machine expected() -> u64 reaches
;
}
LinuxX8664Expected satisfies SelectedExpected {
    machine expected() -> u64
{ 4 }
}
WindowsX8664Expected satisfies SelectedExpected {
    machine expected() -> u64
{ 8 }
}


machine main() crashes Trap {
    let observed: u64 = Inspector::measure();
    let slack: u64 = observed - 4u64;
    transition observed == SelectedExpected::expected() && slack == SelectedExpected::expected() - 4u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
