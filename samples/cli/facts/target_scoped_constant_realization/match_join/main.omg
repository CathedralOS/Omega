// Expected exit: 0.
// Fact: a pure terminating boundary-trait provider selected per target closes the fixed-array extent of Main { values: [u8; limit()] } before layout observation (size_of<Main>() == 4u64 on Linux and 8u64 on Windows/macOS), discharging exact subtraction observed - 4u64 and runtime target-size agreement across all nine places.
boundary trait Answer { machine get() -> u64 reaches terminates; }
Small satisfies Answer { machine get() -> u64 { 4 } }
Large satisfies Answer { machine get() -> u64 { 8 } }
Same satisfies Answer { machine get() -> u64 { 4 } }
machine limit() -> u64 { Answer::get() }
data Main { values: [u8; limit()]; }
boundary trait ExpectedExtent {
    machine expected() -> u64 reaches terminates
    ensures result == 4u64 || result == 8u64;
}
FourByteExpectation satisfies ExpectedExtent {
    machine expected() -> u64 ensures result == 4u64 || result == 8u64 { 4 }
}
EightByteExpectation satisfies ExpectedExtent {
    machine expected() -> u64 ensures result == 4u64 || result == 8u64 { 8 }
}
machine expected() -> u64 ensures result == 4u64 || result == 8u64 { ExpectedExtent::expected() }
machine mark_size(value: u64, caller_route: &mut u64, tag: u64) -> u64
ensures result == value {
    caller_route = tag;
    value
}
machine main() crashes Trap {
    let mut caller_route: u64 = 0;
    let observed: u64 = match true {
        true -> mark_size(size_of<Main>(), &mut caller_route, 17u64)
        _ -> mark_size(size_of<Main>(), &mut caller_route, 23u64)
    };
    let slack: u64 = observed - 4u64;
    let first_route: u64 = caller_route;
    let second_observed: u64 = match false {
        true -> mark_size(size_of<Main>(), &mut caller_route, 17u64)
        _ -> mark_size(size_of<Main>(), &mut caller_route, 23u64)
    };
    let second_slack: u64 = second_observed - 4u64;
    transition observed == expected() && slack == expected() - 4u64
        && second_observed == expected() && second_slack == expected() - 4u64
        && first_route == 17u64 && caller_route == 23u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
