// Fact: 8-bit unsigned saturating multiplication lhs *| rhs with bounded interval 40u8 <= prod <= 150u8 establishes 40u8 <= prod <= 150u8 across all nine places so exact subtractions 150u8 - prod and prod - 40u8 are safe.
// Expected exit: 0

machine compute_sat(lhs: u8 in Saturating, rhs: u8 in Saturating) -> u8 in Saturating {
    lhs * rhs
}

machine verify_prod(prod: u8) -> i32
    requires prod >= 40 && prod <= 150
{
    let headroom: u8 = 150 - prod;
    let margin: u8 = prod - 40;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 110;
    check
}

linux_x86_64 machine exercise(val: u8) -> i32
    requires val >= 40 && val <= 150
{
    verify_prod(val)
}

windows_x86_64 machine exercise(val: u8) -> i32
    requires val >= 40 && val <= 150
{
    verify_prod(val)
}

linux_arm64 machine exercise(val: u8) -> i32
    requires val >= 40 && val <= 150
{
    verify_prod(val)
}

macos_arm64 machine exercise(val: u8) -> i32
    requires val >= 40 && val <= 150
{
    verify_prod(val)
}

machine main() crashes Trap {
    let lhs: u8 in Saturating = 12;
    let rhs: u8 in Saturating = 8;
    let prod_sat: u8 in Saturating = compute_sat(lhs, rhs);
    let prod: u8 = prod_sat as u8;
    let check: i32 = exercise(prod);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
