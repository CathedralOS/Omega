// Fact: 16-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 200u16 <= diff <= 450u16 establishes 200u16 <= diff <= 450u16 across all nine places so exact subtractions 450u16 - diff and diff - 200u16 are safe.
// Place: target_body. Each hosted target body computes the 16-bit unsigned wrapping subtraction and verifies the bounds.
// Expected exit: 0
machine verify_diff(value: u16) -> u16
    requires value >= 200 && value <= 450
{
    let head: u16 = 450 - value;
    let tail: u16 = value - 200;
    head + tail
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires lhs >= 300 && lhs <= 520 && rhs >= 50 && rhs <= 100;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires lhs >= 300 && lhs <= 520 && rhs >= 50 && rhs <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: u16 in Wrapping = lhs as u16 in Wrapping;
        let b: u16 in Wrapping = rhs as u16 in Wrapping;
        let wrapped: u16 in Wrapping = a - b;
        let diff: u16 = wrapped as u16;
        verify_diff(diff)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires lhs >= 300 && lhs <= 520 && rhs >= 50 && rhs <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: u16 in Wrapping = lhs as u16 in Wrapping;
        let b: u16 in Wrapping = rhs as u16 in Wrapping;
        let wrapped: u16 in Wrapping = a - b;
        let diff: u16 = wrapped as u16;
        verify_diff(diff)
    }
}









machine evaluate() -> u16
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(400, 80)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: u16 = evaluate();
    transition res == 250 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
