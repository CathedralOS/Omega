// Copying a four-u16 array carries its checked zero tail, so exact addition to 65535 stays 65535.
// Reject: the tail is one, not zero.
domain [u16; 4]::ZeroTail(values) requires values[3] == 0;
machine initialize(values: &mut [u16; 4]) {
    values[0] = 37;
    values[3] = 9;
}
windows_x86_64 machine evaluate(values: [u16; 4]) -> u16
requires values[3] == 0
{
    let captured: [u16; 4] in ZeroTail = values;
    65535u16 + captured[3]
}
linux_x86_64 machine evaluate(values: [u16; 4]) -> u16
requires values[3] == 0
{
    let captured: [u16; 4] in ZeroTail = values;
    65535u16 + captured[3]
}
macos_arm64 machine evaluate(values: [u16; 4]) -> u16
requires values[3] == 0
{
    let captured: [u16; 4] in ZeroTail = values;
    65535u16 + captured[3]
}
linux_arm64 machine evaluate(values: [u16; 4]) -> u16
requires values[3] == 0
{
    let captured: [u16; 4] in ZeroTail = values;
    65535u16 + captured[3]
}
machine main() crashes Trap {
    let mut values: [u16; 4];
    initialize(&mut values);
    values[3] = 1;
    let answer: u16 = evaluate(values);
    transition answer == 65535u16 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
