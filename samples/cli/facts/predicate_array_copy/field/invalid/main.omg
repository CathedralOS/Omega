// Copying a four-u16 array carries its checked zero tail, so exact addition to 65535 stays 65535.
// Reject: the tail is one, not zero.
domain [u16; 4]::ZeroTail(values) requires values[3] == 0;
machine initialize(values: &mut [u16; 4]) {
    values[0] = 37;
    values[3] = 9;
}
data Envelope [copy] { values: [u16; 4] in ZeroTail; }
machine consume(values: [u16; 4] in ZeroTail) -> u16 {
    65535u16 + values[3]
}
machine main() crashes Trap {
    let mut values: [u16; 4];
    initialize(&mut values);
    values[3] = 1;
    let envelope: Envelope = Envelope { values: values };
    let answer: u16 = consume(envelope.values);
    transition answer == 65535u16 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
