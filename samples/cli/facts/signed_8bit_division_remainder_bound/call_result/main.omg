// Fact: an 8-bit signed i8 remainder operation (dividend % divisor where dividend >= 0i8 && dividend <= 100i8, divisor >= 16i8 && divisor <= 16i8) establishes rem >= 0i8 && rem <= 15i8 so exact 8-bit signed subtraction 15i8 - rem is proved overflow-free across all nine places.
// Place: call_result. The remainder result is returned from a callee invocation.
// Expected exit: 0
machine verify_rem(rem: i8) -> i32
    requires rem >= 0 && rem <= 15
{
    let headroom: i8 = 15 - rem;
    (headroom - 4) as i32
}

machine rem_helper(d: i8, s: i8) -> i8
    requires d >= 0 && d <= 100 && s >= 16 && s <= 16
    ensures result >= 0 && result <= 15
{
    d % s
}

machine compute_call_result(dividend: i8, divisor: i8) -> i32
    requires dividend >= 0 && dividend <= 100 && divisor >= 16 && divisor <= 16
{
    let rem: i8 = rem_helper(dividend, divisor);
    verify_rem(rem)
}

machine evaluate() -> i32 {
    compute_call_result(43, 16)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
