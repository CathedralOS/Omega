// Fact: an 8-bit signed i8 remainder operation (dividend % divisor where dividend >= 0i8 && dividend <= 100i8, divisor >= 16i8 && divisor <= 16i8) establishes rem >= 0i8 && rem <= 15i8 so exact 8-bit signed subtraction 15i8 - rem is proved overflow-free across all nine places.
// Place: const_name. A named constant divisor divides the bounded dividend.
// Expected exit: 0
machine verify_rem(rem: i8) -> i32
    requires rem >= 0 && rem <= 15
{
    let headroom: i8 = 15 - rem;
    (headroom - 4) as i32
}

const DIVISOR: i8 = 17;

machine compute_const(dividend: i8) -> i32
    requires dividend >= 0 && dividend <= 100
{
    let rem: i8 = dividend % DIVISOR;
    verify_rem(rem)
}

machine evaluate() -> i32 {
    compute_const(43)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
