// Fact: passing nine bounded integer arguments (`a1` through `a9` with `a9 <= 92u64`) across register and stack ABI slots on all four hosted targets (including AArch64 stack overflow past `X0–X7`) preserves the 9th argument's static bound (`a9 <= 92u64`), discharging exact subtraction `92u64 - a9` across all nine places.
// Place: match join. Branch arms join before invoking the call and subtracting.
// Expected exit: 0

machine calling_plan_nine(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 == 70u64 && a8 == 80u64 && a9 <= 92u64
ensures
    result <= 92u64 && result == a9
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8;
    (prefix - 360) + a9
}

machine probe(flag: bool) -> u64
ensures
    result == 0u64
{
    let val: u64 = match flag {
        true -> calling_plan_nine(10, 20, 30, 40, 50, 60, 70, 80, 92),
        false -> calling_plan_nine(10, 20, 30, 40, 50, 60, 70, 80, 92),
    };
    92u64 - val
}

machine main() crashes Trap {
    transition probe(true) == 0 && probe(false) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
