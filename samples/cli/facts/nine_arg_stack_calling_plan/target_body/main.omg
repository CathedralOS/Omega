// Fact: passing nine bounded integer arguments (`a1` through `a9` with `a9 <= 92u64`) across register and stack ABI slots on all four hosted targets (including AArch64 stack overflow past `X0–X7`) preserves the 9th argument's static bound (`a9 <= 92u64`), discharging exact subtraction `92u64 - a9` across all nine places.
// Place: another target body. Target-scoped machine bodies execute on each hosted target.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedCallingPlanNine {
    machine calling_plan_nine(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64
) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 && a6 == 60u64 && a7 == 70u64 && a8 == 80u64 && a9 <= 92u64;
}

X86CallingPlanNine satisfies SelectedCallingPlanNine {
    machine calling_plan_nine(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64
) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 && a6 == 60u64 && a7 == 70u64 && a8 == 80u64 && a9 <= 92u64
    {
        SelectedBodyCheck::require_tag(17u64);
        let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8;
        let val: u64 = (prefix - 360) + a9;
        92u64 - val
    }
}

ArmCallingPlanNine satisfies SelectedCallingPlanNine {
    machine calling_plan_nine(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64
) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 && a6 == 60u64 && a7 == 70u64 && a8 == 80u64 && a9 <= 92u64
    {
        SelectedBodyCheck::require_tag(29u64);
        let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8;
        let val: u64 = (prefix - 360) + a9;
        92u64 - val
    }
}

machine probe() -> u64 {
    SelectedCallingPlanNine::calling_plan_nine(10, 20, 30, 40, 50, 60, 70, 80, 92)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
