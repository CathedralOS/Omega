// A zeroed Gate<0> establishes its exact Number == 0 application before its code field is read.
// Expected exit: 0
// Place: target_body.
data Gate<const Number: u64> requires Number == 0 { code: u8; }
machine Gate::read<const Selected: u64>(gate: &Gate<Selected>) -> u8 { gate.code }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedRead {
    machine read(value: &Gate<2>) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Read satisfies SelectedRead {
    machine read(value: &Gate<2>) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     Gate::read(value) 
    }
}

ArmRead satisfies SelectedRead {
    machine read(value: &Gate<2>) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     Gate::read(value) 
    }
}


machine start() crashes Trap {
    let value: Gate<2>;
    let code: u8 = SelectedRead::read(&value);
    transition code == 0u8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    start();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    start();
}
