// A zeroed Gate<0> establishes its exact Number == 0 application before its code field is read.
// Expected exit: 0
// Place: field.
data Gate<const Number: u64> where Number == 0 { code: u8; }
machine Gate::read<const Selected: u64>(gate: &Gate<Selected>) -> u8 { gate.code }
data Carrier { value: Gate<0>; }
machine start() crashes Trap {
    let carrier: Carrier;
    let code: u8 = Gate::read(&carrier.value);
    transition code == 0u8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
