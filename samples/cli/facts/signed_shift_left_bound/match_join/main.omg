// Fact: left shift on a bounded signed i64 value value >= 25i64 && value <= 25i64 by 2 establishes shifted >= 100i64 && shifted <= 100i64 for exact subtraction shifted - 100i64.
// Place: match join. Both arms of a match expression produce the bounded signed operand.
// Expected exit: 0

machine shift_left(val: i64) -> i64
    requires val >= 25i64 && val <= 25i64
    ensures result >= 100i64 && result <= 100i64
{
    val << 2
}

machine select_base(cond: bool) -> i64
    ensures result >= 25i64 && result <= 25i64
{
    match cond {
        true -> 25i64
        false -> 25i64
    }
}

machine main() crashes Trap {
    let base: i64 = select_base(true);
    transition base >= 25i64 && base <= 25i64 {
        true -> shift_step(base)
        _ -> bad()
    }
    state shift_step(v: i64) {
        let shifted: i64 = shift_left(v);
        transition shifted >= 100i64 && shifted <= 100i64 {
            true -> done(shifted)
            _ -> bad()
        }
    }
    state done(s: i64) {
        let diff: i64 = s - 100i64;
    }
    state bad() {
        crash Trap;
    }
}
