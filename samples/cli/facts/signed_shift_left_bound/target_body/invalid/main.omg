// Fact: left shift on a bounded signed i64 value value >= 25i64 && value <= 25i64 by 2 establishes shifted >= 100i64 && shifted <= 100i64 for exact subtraction shifted - 100i64.
// Place: another target body (invalid twin). Target bodies without bounds may overflow exact shift left.
// Expected diagnostic: may overflow `i64`

linux_x86_64 machine shift_left(val: i64) -> i64
{
    val << 2
}

linux_arm64 machine shift_left(val: i64) -> i64
{
    val << 2
}

macos_arm64 machine shift_left(val: i64) -> i64
{
    val << 2
}

windows_x86_64 machine shift_left(val: i64) -> i64
{
    val << 2
}

machine main() crashes Trap {
    let val: i64 = 25i64;
    let shifted: i64 = shift_left(val);
    let diff: i64 = shifted - 100i64;
}
