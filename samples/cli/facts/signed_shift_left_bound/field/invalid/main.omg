// Fact: left shift on a bounded signed i64 value value >= 25i64 && value <= 25i64 by 2 establishes shifted >= 100i64 && shifted <= 100i64 for exact subtraction shifted - 100i64.
// Place: field (invalid twin). The shift's own operand bound is omitted, so exact left shift on `i64` may overflow.
// Expected diagnostic: may overflow `i64`

data Carrier {
    val: i64;
}

machine shift_left(val: i64) -> i64
{
    val << 2
}

machine main() crashes Trap {
    let val: i64 = 25i64;
    transition val >= 25i64 && val <= 25i64 {
        true -> shift_step(val)
        _ -> bad()
    }
    state shift_step(v: i64) {
        let carrier: Carrier = Carrier { val: v };
        let shifted: i64 = shift_left(carrier.val);
        transition shifted >= 100i64 && shifted <= 100i64 {
            true -> done(shifted)
            _ -> bad()
        }
    }
    state done(s: i64) {
        let diff: i64 = s - 100i64;
    }
    state bad() {
        crash Trap;
    }
}
