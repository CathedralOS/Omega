// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Invalid: quotient is 99, so subtracting 100u64 underflows. Place: target_body.
// Expected diagnostic: may overflow `u64`

linux_x86_64 machine verify_target() -> i32 {
    let q: u64 = 396u64 / 4u64;
    let quotient: u64 = q;
    let diff: u64 = quotient - 100u64;
    diff as i32
}

linux_arm64 machine verify_target() -> i32 {
    let q: u64 = 396u64 / 4u64;
    let quotient: u64 = q;
    let diff: u64 = quotient - 100u64;
    diff as i32
}

macos_arm64 machine verify_target() -> i32 {
    let q: u64 = 396u64 / 4u64;
    let quotient: u64 = q;
    let diff: u64 = quotient - 100u64;
    diff as i32
}

windows_x86_64 machine verify_target() -> i32 {
    let q: u64 = 396u64 / 4u64;
    let quotient: u64 = q;
    let diff: u64 = quotient - 100u64;
    diff as i32
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
