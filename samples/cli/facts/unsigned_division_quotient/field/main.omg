// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Place: field. A record field carries the quotient into the subtraction check.
// Expected exit: 0

data DivResult where quotient >= 100 && quotient <= 100 {
    quotient: u64;
}

machine verify_field(payload: DivResult) -> i32 {
    let diff: u64 = payload.quotient - 100u64;
    diff as i32
}

machine probe() -> i32 {
    let q: u64 = 400u64 / 4u64;
    let payload: DivResult = DivResult { quotient: q };
    verify_field(payload)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
