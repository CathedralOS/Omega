use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "unsigned_division_quotient_target_body_invalid" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::SelectedComputation, |app|::X86Computation>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedComputation, |app|::X86Computation>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedComputation, |app|::ArmComputation>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedComputation, |app|::ArmComputation>(builder, macos_arm64);
}
