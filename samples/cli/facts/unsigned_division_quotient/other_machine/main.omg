// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Place: other_machine. A forwarding machine forwards the quotient to the verifying machine.
// Expected exit: 0

machine verify_target(quotient: u64) -> i32
requires quotient >= 100 && quotient <= 100
{
    let diff: u64 = quotient - 100u64;
    diff as i32
}

machine forward(quotient: u64) -> i32
requires quotient >= 100 && quotient <= 100
{
    verify_target(quotient)
}

machine probe() -> i32 {
    let q: u64 = 400u64 / 4u64;
    forward(q)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
