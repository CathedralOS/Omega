// A const-generic scoped domain family proves a literal initializer against the exact instance it was declared with, and the consumed value is 3.
// Expected rejection: initializer out of domain BelowIndex.
domain<const Bound: u64> u64::BelowIndex<Bound> requires self < Bound;
// Place: another target body. Each of the four hosted targets establishes the scoped instance.
machine verify(observed: u64 in BelowIndex<4>, flag: bool) crashes Trap {
    transition (flag && (observed as u64) == 3) || (!flag && (observed as u64) == 3) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(flag: bool)
        reaches SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(flag: bool)
        reaches SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let scoped: u64 in BelowIndex<4> = 4;
        verify(scoped, flag);
    }
}

X86Probe2 satisfies SelectedProbe {
    machine exercise(flag: bool)
        reaches SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let scoped: u64 in BelowIndex<4> = 3;
        verify(scoped, flag);
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(flag: bool)
        reaches SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let scoped: u64 in BelowIndex<4> = 3;
        verify(scoped, flag);
    }
}





machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{ SelectedProbe::exercise(true); SelectedProbe::exercise(false); }

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
