// Library C layout preserves scalar values with C ABI field offsets, trailing padding and transparent alias identity.
// Expected exit: 0
use {omega}/language/core/c_layout.omg;
use {omega}/language/core/layout.omg;
data Record [copy] { first: u8; second: u64; last: u16; }
OtherPolicy satisfies |layout|::FixedLayout<Record> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none terminates {
        |c_layout|::CAbiPolicy::<Record>::plan(schema, target)
    }
}
machine explicit(value: |c_layout|::CLayout<Record>) -> |layout|::LayoutStorage<Record, |c_layout|::CAbiPolicy<Record>> { value }
machine make() -> |c_layout|::CLayout<Record> {
    let mutable record: |c_layout|::CLayout<Record>;
    record.first = 17u8;
    record.second = 42u64;
    record.last = 9u16;
    record
}
machine observe(record: |c_layout|::CLayout<Record>) -> bool {
    let value: |c_layout|::CLayout<Record> = record;
    let mutable words: [u64; 3];
    words[0] = 17u64;
    words[1] = 42u64;
    words[2] = 9u64;
    let mapped: @|c_layout|::CLayout<Record> = @words as @|c_layout|::CLayout<Record>;
    value.first == 17u8 && value.second == 42u64 && value.last == 9u16 && mapped.first == 17u8 && mapped.second == 42u64 && mapped.last == 9u16 && size_of::<|c_layout|::CLayout<Record>>() == 24u64 && align_of::<|c_layout|::CLayout<Record>>() == 8u64
}
machine main() crashes Trap {
    let observed: bool = observe(explicit(make()));
    transition observed { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
