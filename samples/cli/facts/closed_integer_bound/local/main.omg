// Fact: checked numeral order establishes value <= 5 for exact 5u64 - value.
// Expected exit: 0
domain u64::Small(value) requires value >= 0 && value <= 5;
machine main() crashes Trap {
    let mut value: u64 in Small = 0;
    value = 3;
    let remaining: u64 = 5u64 - value;
    transition remaining == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
