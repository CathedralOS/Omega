// Fact: checked numeral order establishes value <= 5 for exact 5u64 - value.
// Expected exit: 0
domain u64::Small requires self >= 0 && self <= 5;
const INITIAL: u64 = 3;
machine establish() -> u64 in Small {
    let mutable value: u64 in Small = 0u64 as +Small;
    value = INITIAL as +Small;
    value
}
machine probe() -> u64 { let value: u64 in Small = establish(); 5u64 - (value as -Small) }
machine main() crashes Trap {
    transition probe() == 2 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
