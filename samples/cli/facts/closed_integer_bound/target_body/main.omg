// Fact: checked numeral order establishes value <= 5 for exact 5u64 - value.
// Expected exit: 0
domain u64::Small(value) requires value >= 0 && value <= 5;
machine establish() -> u64 in Small {
    let mut value: u64 in Small = 0;
    value = 3;
    value
}
linux_x86_64 machine consume(value: u64 in Small) -> u64 { 5u64 - value }
linux_arm64 machine consume(value: u64 in Small) -> u64 { 5u64 - value }
macos_arm64 machine consume(value: u64 in Small) -> u64 { 5u64 - value }
windows_x86_64 machine consume(value: u64 in Small) -> u64 { 5u64 - value }
machine probe() -> u64 { consume(establish()) }
machine main() crashes Trap {
    transition probe() == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
