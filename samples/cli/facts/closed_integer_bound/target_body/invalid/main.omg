// Fact: checked numeral order establishes value <= 5 for exact 5u64 - value.
// Expected exit: 0
domain u64::Small requires self >= 0 && self <= 5;
machine establish() -> u64 in Small {
    let mut value: u64 in Small = 0;
    value = 6;
    value
}
boundary trait SelectedConsume {
    machine consume(value: u64 in Small) -> u64 reaches
;
}
CheckedConsume satisfies SelectedConsume {
    machine consume(value: u64 in Small) -> u64
{ 5u64 - value }
}



machine probe() -> u64 { SelectedConsume::consume(establish()) }
machine main() crashes Trap {
    transition probe() == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
