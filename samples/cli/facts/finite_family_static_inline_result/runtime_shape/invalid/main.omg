// A finite roster does not package a bare runtime-indexed inline result.
data Prepared<Width: u64> { bytes: [u8; Width]; }
trait Family {
    machine row<Width: u64>() -> Prepared<Width> where Width == 16 || Width == 32;
}
machine produce<Width: u64>() -> Prepared<Width> satisfies Family::row {
    Prepared { Width: Width }
}
Selected satisfies Family { Family::row = produce; }
machine escape(selected: dyn Family, width: u64) -> Prepared<width>
requires width == 16 || width == 32;
{ Family::row<width>(selected) }
machine main() { let result: Prepared<16> = escape(Selected as dyn Family, 16); }
