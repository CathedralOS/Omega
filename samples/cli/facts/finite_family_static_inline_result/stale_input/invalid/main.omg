// Expected exit: 0
// A finite-family result index follows the completed ordinary operand, not an earlier snapshot.
data Indexed<Limit: u32> { value: u32; }
machine change(slot: &mut u32) -> u32 { slot = 32; 0 }
trait Family { machine row<Width: u32>(first: u32, limit: u32) -> Indexed<limit> where Width == 16 || Width == 32; }
machine produce<Width: u32>(first: u32, limit: u32) -> Indexed<limit> satisfies Family::row { Indexed { value: first } }
Selected satisfies Family { Family::row = produce; }
machine main() crashes Trap {
 let mut limit: u32 = 16;
 let saved: u32 = limit;
 let item: Indexed<saved> = Family::row<16>(Selected as dyn Family, change(&mut limit), limit);
 transition item.value == 0 && limit == 16 { true -> done() false -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
