// Expected exit: 0
// A prepared finite-family call evaluates a nested operand once before binding its indexed result.
data Indexed<Limit: u32> { value: u32; }
machine change(slot: &mut u32) -> u32 { slot = 32; 7 }
trait Family { machine row<Width: u32>(value: u32) -> Indexed<Width> where Width == 16 || Width == 32; }
machine produce<Width: u32>(value: u32) -> Indexed<Width> satisfies Family::row { Indexed { value: value } }
Selected satisfies Family { Family::row = produce; }
machine main() crashes Trap {
    let mut limit: u32 = 16;
    let item: Indexed<16> = Family::row<16>(Selected as dyn Family, change(&mut limit));
    transition limit == 32 && item.value == 7 { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
