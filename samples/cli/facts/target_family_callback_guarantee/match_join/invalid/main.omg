// Fact: a selected callback satisfies the public callable guarantee, and its bounded result permits subtraction from 64u64.
machine identity(value: u64) -> u64 requires value <= 64 ensures result <= 64 { value }
boundary trait CallbackApply {
    machine apply<machine Selected>(value: u64) -> u64
        requires machine Selected(input: u64) -> u64
            requires input <= 64 ensures result <= 64 && result >= input;
        reaches requires value <= 64 ensures result <= 64;
}
SharedApply satisfies CallbackApply {
    machine apply<machine Action>(value: u64) -> u64
        requires machine Action(input: u64) -> u64
            requires input <= 64 ensures result <= 64 && result >= input;
        requires value <= 64 ensures result <= 64
    { Action(value) }
}
data BranchValue { value: u64; arm: u64; }
machine observe_arm(value: u64, arm: u64) -> BranchValue
    requires value <= 64 ensures result.value <= 64, result.arm == arm
{ BranchValue { value: value, arm: arm } }
machine main() reaches CallbackApply invokes CallbackApply; crashes Trap {
    let result: u64 = CallbackApply::apply<identity>(42);
    let joined: BranchValue = match true {
        true -> observe_arm(result, 17), false -> observe_arm(result, 29)
    };
    let remaining: u64 = 64u64 - joined.value;
    let fallback: BranchValue = match false {
        true -> observe_arm(result, 17), false -> observe_arm(result, 29)
    };
    let fallback_remaining: u64 = 64u64 - fallback.value;
    transition remaining == 22 && joined.arm == 17 && fallback_remaining == 22 && fallback.arm == 29 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
