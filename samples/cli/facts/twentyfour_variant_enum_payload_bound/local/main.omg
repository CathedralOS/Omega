machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine extract(choice: TwentyFourChoice) -> u64 {
    transition choice {
        TwentyFourChoice::V1 { v } -> v
        TwentyFourChoice::V2 { v } -> v
        TwentyFourChoice::V3 { v } -> v
        TwentyFourChoice::V4 { v } -> v
        TwentyFourChoice::V5 { v } -> v
