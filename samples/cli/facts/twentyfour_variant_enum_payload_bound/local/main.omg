        TwentyFourChoice::V21 { v } -> v
        TwentyFourChoice::V22 { v } -> v
        TwentyFourChoice::V23 { v } -> v
        TwentyFourChoice::V24 { v } -> v
    }
}

machine probe(choice: TwentyFourChoice) -> u64 {
    let res: u64 = extract(choice);
    let local_res: u64 = res;
    verify_payload(local_res)
}

machine main() crashes Trap {
    let p: TwentyFourChoice = TwentyFourChoice::V24 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
