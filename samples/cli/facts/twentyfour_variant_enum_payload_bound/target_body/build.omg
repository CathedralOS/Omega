machine build(builder: &mut Build) {
    Build::select_provider<SelectedTargetProbe, CheckedTargetProbe>(builder, linux_x86_64);
    Build::select_provider<SelectedTargetProbe, CheckedTargetProbe>(builder, linux_arm64);
    Build::select_provider<SelectedTargetProbe, CheckedTargetProbe>(builder, macos_arm64);
    Build::select_provider<SelectedTargetProbe, CheckedTargetProbe>(builder, windows_x86_64);

    Build::application(builder, "twentyfour_variant_enum_payload_bound_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
