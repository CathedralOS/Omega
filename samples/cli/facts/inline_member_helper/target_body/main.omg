// Selected satisfies Sum and its inline combine calls shared helper add, preserving result == left + right.
trait Sum<Value> {
    machine combine(left: Value, right: Value) -> Value
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures result == left + right
    blocks;
}

machine add(left: i32, right: i32) -> i32
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures result == left + right
{
    left + right
}

Selected satisfies Sum<i32> {
    machine combine(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures result == left + right
    blocks
    {
        add(left, right)
    }
}

machine apply<Operations satisfies Sum<i32>>(left: i32, right: i32) -> i32
blocks
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures result == left + right
{
    block Operations::combine(left, right)
}

// Place: another selected target implementation. Build supplies an ordinary checked body.
// Expected exit: 0
machine probe(a: i32, b: i32) -> i32
blocks
requires 0 <= a && a <= 50
requires 0 <= b && b <= 50
ensures (result as i64) == (a as i64) + (b as i64)
{
    block apply<Selected>(a, b)
}

boundary trait BodyTag {
    machine check(tag: u64) reaches crashes Trap;
}

X86Tag satisfies BodyTag {
    machine check(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> bad() }
        machine done() {}
        machine bad() crashes Trap { crash Trap; }
    }
}

ArmTag satisfies BodyTag {
    machine check(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> bad() }
        machine done() {}
        machine bad() crashes Trap { crash Trap; }
    }
}

boundary trait TargetProbe {
    machine evaluate(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures (result as i64) == (left as i64) + (right as i64)
    reaches BodyTag invokes BodyTag crashes Trap blocks;
}

X86Probe satisfies TargetProbe {
    machine evaluate(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures (result as i64) == (left as i64) + (right as i64)
    reaches BodyTag invokes BodyTag crashes Trap blocks
    {
        BodyTag::check(17u64);
        block probe(left, right)
    }
}

ArmProbe satisfies TargetProbe {
    machine evaluate(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures (result as i64) == (left as i64) + (right as i64)
    reaches BodyTag invokes BodyTag crashes Trap blocks
    {
        BodyTag::check(29u64);
        block probe(left, right)
    }
}

machine main() blocks crashes Trap {
    let wide: i32 = block TargetProbe::evaluate(20, 22);
    let narrow: i32 = block TargetProbe::evaluate(10, 12);
    transition wide == 42 && narrow == 22 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

machine x86_entry() blocks crashes Trap {
    BodyTag::check(17u64);
    block main();
}

machine arm_entry() blocks crashes Trap {
    BodyTag::check(29u64);
    block main();
}
