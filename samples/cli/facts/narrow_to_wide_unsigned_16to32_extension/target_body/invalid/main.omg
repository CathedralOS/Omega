// Fact: zero-extending a bounded 16-bit unsigned u16 value (narrow >= 300u16 && narrow <= 500u16) to u32 (narrow as u32) preserves the exact interval (wide >= 300u32 && wide <= 500u32), discharging exact 32-bit subtractions 500u32 - wide and wide - 300u32 across all nine places.
// Invalid: widened narrow upper bound produces wide up to 501u32, failing exercise requires contract.

machine extend_u16(narrow: u16) -> u32
    requires narrow >= 300 && narrow <= 501
{
    narrow as u32
}

machine verify_wide(wide: u32) -> i32
    requires wide >= 300 && wide <= 500
{
    let upper_headroom: u32 = 500 - wide;
    let lower_headroom: u32 = wide - 300;
    let diff: i32 = (upper_headroom as i32) - (lower_headroom as i32);
    diff
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 300 && val <= 500;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 300 && val <= 500
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_wide(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 300 && val <= 500
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_wide(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let narrow: u16 = 501;
    let wide: u32 = extend_u16(narrow);
    let check: i32 = SelectedProbe::exercise(wide);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
