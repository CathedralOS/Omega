// Fact: querying size_of and align_of on a mixed-width structural record (Padded { tag: u8, value: u64 }) establishes its exact 16-byte alignment-padded layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Invalid: Padded omits tag so size is 8u64 and align is 8u64, causing size - (align * 2u64) to underflow u64.
// Expected exit: 0

data Padded {
    value: u64;
}

machine query_size() -> u64 {
    size_of<Padded>()
}

machine query_align() -> u64 {
    align_of<Padded>()
}

machine main() crashes Trap {
    let s: u64 = query_size();
    let a: u64 = query_align();
    let diff: u64 = s - (a * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
