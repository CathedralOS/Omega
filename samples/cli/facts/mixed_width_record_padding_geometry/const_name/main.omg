// Fact: querying size_of and align_of on a mixed-width structural record (Padded { tag: u8, value: u64 }) establishes its exact 16-byte alignment-padded layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: const name. Named constants evaluate size_of and align_of before subtracting.
// Expected exit: 0

data Padded {
    tag: u8;
    value: u64;
}

const RECORD_SIZE: u64 = size_of<Padded>();
const RECORD_ALIGN: u64 = align_of<Padded>();

machine main() crashes Trap {
    let diff: u64 = RECORD_SIZE - (RECORD_ALIGN * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
