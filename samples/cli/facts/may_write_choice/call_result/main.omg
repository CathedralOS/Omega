// Choosing one of two mutable inputs and writing through that result preserves a disjoint index-bound fact on the other input.
// Expected exit: 0
// Place: call_result.

machine choose<'storage>(chosen: @'storage mutable u64, other: @'storage mutable u64, pick_chosen: bool) -> @'storage mutable u64 {
    transition pick_chosen {
        true -> chosen,
        _ -> other
    }
}

machine overwrite(slot: @mutable u64) -> u64 in Wrapping {
    $slot = 9;
    (1 as u64 +Wrapping)
}

machine add(first: u64 in Wrapping, second: u64 in Wrapping) -> u64 in Wrapping {
    first + second
}

machine kept_index(other: u64) -> u64
requires other < 4
ensures result < 4
{ other }

machine main() crashes Trap {
    let mutable chosen: u64 = 0;
    let mutable other: u64 = 1;
    let items: [u8; 4] = [4, 7, 8, 9];
    let zero: u64 in Wrapping = 0;
    let marker: u64 in Wrapping = add(overwrite(choose(@mutable chosen, @mutable other, true)), zero);
    let index: u64 = kept_index(other);
    transition (marker as u64) == 1 && chosen == 9 && items[index] == 7 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
