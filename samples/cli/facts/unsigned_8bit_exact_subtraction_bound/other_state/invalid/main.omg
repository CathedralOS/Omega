// Fact: 8-bit unsigned exact subtraction lhs - rhs with 100u8 <= lhs <= 180u8 and 20u8 <= rhs <= 40u8 establishes 60u8 <= diff <= 160u8 so 160u8 - diff and diff - 60u8 are safe.
// Place: another state (invalid twin). The state step lhs upper bound is widened to 181u8 so diff reaches 161u8, underflowing 160u8 - diff.
// Expected diagnostic: may overflow `u8`

machine sub_state(lhs: u8, rhs: u8) -> u8
requires lhs >= 100 && lhs <= 181 && rhs >= 20 && rhs <= 40
{
    transition {
        _ -> step(lhs, rhs)
    }
    state step(l: u8, r: u8) -> u8
    requires l >= 100 && l <= 181 && r >= 20 && r <= 40
    {
        let diff: u8 = l - r;
        let headroom: u8 = 160u8 - diff;
        let margin: u8 = diff - 60u8;
        headroom + margin
    }
}

machine probe() -> u8 {
    sub_state(140u8, 30u8)
}

machine main() crashes Trap {
    transition probe() == 100 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
