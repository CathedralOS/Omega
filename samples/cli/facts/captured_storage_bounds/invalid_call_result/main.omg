// Counter's declared 0..16 bounds survive a disjoint field write and captured scalar read, so an incoming pumped < 16 guard admits pumped + 1.
// Expected exit: 0
public data Counter [copy]
requires self.pumped >= 0 && self.pumped <= 16,
{
    before: u32;
    pumped: i32;
    after: u32;
    have: u32;
    marker: u32;
    origin: u32;
}
public machine update(counter: @mutable Counter, choose: bool) crashes Trap {
    transition { _ -> pump_loop(counter, choose) }
    machine pump_loop(counter: @mutable Counter, choose: bool) {
        counter.have = 1;
        transition choose { true -> left(counter, choose), _ -> right(counter, choose) }
    }
    machine left(counter: @mutable Counter, choose: bool) {
        counter.marker = 11;
        transition { _ -> pump_handle(counter, choose) }
    }
    machine right(counter: @mutable Counter, choose: bool) {
        counter.marker = 13;
        transition { _ -> pump_handle(counter, choose) }
    }
    machine pump_handle(counter: @mutable Counter, choose: bool) {
        transition counter.pumped <= 16 { true -> pump_next(counter, choose), _ -> finish(counter) }
    }
    machine pump_next(counter: @mutable Counter, choose: bool) {
        counter.pumped = counter.pumped + 1;
        transition { _ -> pump_loop(counter, choose) }
    }
    machine finish(counter: @mutable Counter) {
        transition counter.pumped == 16 { true -> done(), _ -> failed() }
    }
    machine done() {}
    machine failed() { crash Trap; }
}
machine intact(counter: @Counter, origin: u32, marker: u32) -> bool {
    counter.before == 0x13579BDF && counter.after == 0x2468ACE0
        && counter.pumped == 16 && counter.have == 1
        && counter.origin == origin && counter.marker == marker
}

machine produce(origin: u32) -> Counter {
    Counter { before: 0x13579BDF, pumped: 0, after: 0x2468ACE0, have: 0, marker: 0, origin: origin }
}

machine main() crashes Trap {
    let mutable first: Counter = produce(11);
    update(@mutable first, true);
    let mutable second: Counter = produce(13);
    update(@mutable second, false);
    transition intact(@first, 11, 11) && intact(@second, 13, 13) {
        true -> done(),
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
