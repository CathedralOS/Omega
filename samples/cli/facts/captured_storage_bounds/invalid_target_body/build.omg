machine build(builder: &mut Build) {
    Build::application(builder, "captured_storage_bounds_through_target_body");
    Build::select_provider<CounterSource, SelectedCounter>(builder, windows_x86_64);
    Build::select_provider<CounterSource, SelectedCounter>(builder, linux_x86_64);
    Build::select_provider<CounterSource, SelectedCounter>(builder, macos_arm64);
    Build::select_provider<CounterSource, SelectedCounter>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
