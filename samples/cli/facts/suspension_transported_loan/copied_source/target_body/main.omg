// Copy or select saved access, then keep reading the same data after a call that may pause.
// Fact: A loan transported into a record before a possible suspension keeps its original backing, so the record reads 73 after the call.
// Expected exit: 0
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
data Cell { value: i32; }
data Backing { left: i32; values: [i32; 1]; right: i32; }
data Sources { first: &[i32; 1]; second: &[i32; 1]; }
data Message { left: i32; body: &Cell; right: i32; }
machine read(message: Message) -> i32 {
    transition message.left == 5 && message.right == 9 { true -> message.body.value _ -> 0 }
}
boundary trait SelectedTransport { machine transport(flag: bool, tag: u64) -> i32 reaches Scheduler suspends; }
X86Transport satisfies SelectedTransport {
    machine transport(flag: bool, tag: u64) -> i32 suspends reaches Scheduler {
        let first: Backing = Backing { left: 101, values: [73], right: 103 };
        let second: Backing = Backing { left: 107, values: [11], right: 109 };
        let first_storage: &[i32; 1] = &first.values;
        let second_storage: &[i32; 1] = &second.values;
        let sources: Sources = Sources { first: first_storage, second: second_storage };
        let selected: &[i32; 1] = match flag { true -> sources.first _ -> sources.second };
        let copied: &[i32; 1] = selected;
        let reference: &Cell = copied as &Cell;
        let message: Message = Message { left: 5, body: reference, right: 9 };
        suspend Scheduler::park();
        let observed: i32 = read(message);
        transition first.left == 101 && first.right == 103 && second.left == 107 && second.right == 109 && tag == 17u64 { true -> observed _ -> 0 }
    }
}
ArmTransport satisfies SelectedTransport {
    machine transport(flag: bool, tag: u64) -> i32 suspends reaches Scheduler {
        let first: Backing = Backing { left: 101, values: [73], right: 103 };
        let second: Backing = Backing { left: 107, values: [11], right: 109 };
        let first_storage: &[i32; 1] = &first.values;
        let second_storage: &[i32; 1] = &second.values;
        let sources: Sources = Sources { first: first_storage, second: second_storage };
        let selected: &[i32; 1] = match flag { true -> sources.first _ -> sources.second };
        let copied: &[i32; 1] = selected;
        let reference: &Cell = copied as &Cell;
        let message: Message = Message { left: 5, body: reference, right: 9 };
        suspend Scheduler::park();
        let observed: i32 = read(message);
        transition first.left == 101 && first.right == 103 && second.left == 107 && second.right == 109 && tag == 29u64 { true -> observed _ -> 0 }
    }
}
machine x86_entry() reaches Scheduler crashes Trap {
    let observed: i32 = suspend SelectedTransport::transport(true, 17u64);
    let other: i32 = suspend SelectedTransport::transport(false, 17u64);
    transition observed == 73 && other == 11 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine arm_entry() reaches Scheduler crashes Trap {
    let observed: i32 = suspend SelectedTransport::transport(true, 29u64);
    let other: i32 = suspend SelectedTransport::transport(false, 29u64);
    transition observed == 73 && other == 11 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
