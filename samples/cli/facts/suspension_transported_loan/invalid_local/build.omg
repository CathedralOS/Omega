use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "suspension_transported_loan_local_invalid" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Scheduler, |app|::Immediate>(builder, linux_x86_64);
    Build::select_provider::<|app|::Scheduler, |app|::Immediate>(builder, linux_arm64);
    Build::select_provider::<|app|::Scheduler, |app|::Immediate>(builder, macos_arm64);
    Build::select_provider::<|app|::Scheduler, |app|::Immediate>(builder, windows_x86_64);
}
