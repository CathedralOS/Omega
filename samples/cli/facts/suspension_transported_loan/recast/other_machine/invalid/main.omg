// Invalid: the original backing forbids suspension; recasting its reference preserves that restriction.
// Fact: A loan transported into a record before a possible suspension keeps its original backing, so the record reads 73 after the call.
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
data Cell { value: i32; }
data Backing [carry(suspension: forbidden, cpu: any, thread: any, address: movable)] { values: [i32; 1]; }
data Message { left: i32; body: &Cell; right: i32; }
// The canaries beside the transported descriptor must survive with it.
machine read(message: Message) -> i32 {
    transition message.left == 5 && message.right == 9 { true -> message.body.value _ -> 0 }
}
machine transport() -> i32 suspends reaches Scheduler {
    let backing: Backing = Backing { values: [73] };
    let storage: &[i32; 1] = &backing.values;
    let reference: &Cell = storage as &Cell;
    let message: Message = Message { left: 5, body: reference, right: 9 };
    suspend Scheduler::park();
    read(message)
}
machine main() reaches Scheduler crashes Trap {
    let observed: i32 = suspend transport();
    transition observed == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
