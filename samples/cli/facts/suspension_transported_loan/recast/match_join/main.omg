// Keep access to the same data after a call that may pause; the final read must still be 73.
// Fact: A loan transported into a record before a possible suspension keeps its original backing, so the record reads 73 after the call.
// Expected exit: 0
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
data Cell { value: i32; }
data Backing { values: [i32; 1]; }
data Message { left: i32; body: &Cell; right: i32; }
// The canaries beside the transported descriptor must survive with it.
machine read(message: Message) -> i32 {
    transition message.left == 5 && message.right == 9 { true -> message.body.value _ -> 0 }
}
// Both arms run; each must keep its own backing across the call.
machine pick(flag: bool) -> i32 suspends reaches Scheduler {
    let first: Backing = Backing { values: [73] };
    let second: Backing = Backing { values: [11] };
    let first_storage: &[i32; 1] = &first.values;
    let second_storage: &[i32; 1] = &second.values;
    let first_view: &Cell = first_storage as &Cell;
    let second_view: &Cell = second_storage as &Cell;
    let reference: &Cell = match flag { true -> first_view _ -> second_view };
    let message: Message = Message { left: 5, body: reference, right: 9 };
    suspend Scheduler::park();
    read(message)
}
machine main() reaches Scheduler crashes Trap {
    let observed: i32 = suspend pick(true);
    let other: i32 = suspend pick(false);
    transition observed == 73 && other == 11 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
