machine build(builder: &mut Build) {
    Build::application(builder, "supplied_output_control_earlier_argument_original_forbidden");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<Installer, CheckedInstaller>(builder, linux_x86_64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Installer, CheckedInstaller>(builder, linux_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<Installer, CheckedInstaller>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Installer, CheckedInstaller>(builder, windows_x86_64);
}
