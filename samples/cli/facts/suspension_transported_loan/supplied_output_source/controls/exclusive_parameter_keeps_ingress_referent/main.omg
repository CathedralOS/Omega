// Expected exit: 0
data Cell { value: i32; }
machine replace<'storage>(replacement: &'storage mut Cell, destination: &mut &'storage mut Cell) {
    destination = replacement;
}
machine lend<'storage>(mut pointer: &'storage mut Cell, replacement: &'storage mut Cell) {
    replace(replacement, &mut pointer);
}
machine main() crashes Trap {
    let mut first: Cell = Cell { value: 73 };
    let mut second: Cell = Cell { value: 11 };
    lend(&mut first, &mut second);
}
