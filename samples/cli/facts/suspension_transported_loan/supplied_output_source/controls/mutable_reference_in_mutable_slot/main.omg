// Expected exit: 0
data Cell { value: i32; }
machine replace<'storage>(replacement: &'storage mut Cell, destination: &mut &'storage mut Cell) {
    destination = replacement;
}
machine main() crashes Trap {
    let mut first: Cell = Cell { value: 73 };
    let mut second: Cell = Cell { value: 11 };
    let mut output: &mut Cell = &mut first;
    replace(&mut second, &mut output);
    let observed: i32 = output.value;
    transition observed == 11 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
