// Have a checked provider install a reference, then read the original data after a call that may pause.
// Fact: A loan transported into a record before a possible suspension keeps its original backing, so the record reads 73 after the call.
// Expected exit: 0
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
public data Cell { value: i32; }
public data Backing { left: i32; cell: Cell; right: i32; }
public data Output<T> { body: T; }
data Sources { first: &Backing; second: &Backing; }
data Message { left: i32; body: &Cell; right: i32; }
public boundary trait Installer {
    machine install<'storage>(source: &'storage Backing, output: &mut Output<&'storage Cell>) reaches;
}
public CheckedInstaller satisfies Installer {
    machine install<'storage>(source: &'storage Backing, output: &mut Output<&'storage Cell>) {
        output = Output { body: &source.cell };
    }
}
machine read(message: Message) -> i32 {
    transition message.left == 5 && message.right == 9 { true -> message.body.value _ -> 0 }
}
machine main() reaches Scheduler + Installer crashes Trap {
    let observed: i32 = suspend exercise(true);
    let other: i32 = suspend exercise(false);
    transition observed == 73 && other == 11 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
    machine exercise(flag: bool) -> i32 suspends reaches Scheduler + Installer {
        let first: Backing = Backing { left: 101, cell: Cell { value: 73 }, right: 103 };
        let second: Backing = Backing { left: 107, cell: Cell { value: 11 }, right: 109 };
        let first_storage: &Backing = &first;
        let second_storage: &Backing = &second;
        let sources: Sources = Sources { first: first_storage, second: second_storage };
        let selected: &Backing = match flag { true -> sources.first _ -> sources.second };
        let source_canaries: bool = first.left == 101 && first.right == 103 && second.left == 107 && second.right == 109;
        let sentinel: Cell = Cell { value: 0 };
        let mut output: Output<&Cell> = Output { body: &sentinel };
        Installer::install(selected, &mut output);
        let saved: &Cell = output.body;
        let message: Message = Message { left: 5, body: saved, right: 9 };
        suspend Scheduler::park();
        let observed: i32 = read(message);
        transition source_canaries { true -> observed _ -> 0 }
    }
}
