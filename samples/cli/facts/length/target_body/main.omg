// Every target body uses a runtime window length to name the last byte.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReadAt {
    machine read_at(window: &[u8], length: u64) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires length == window.len && length > 0;
}

X86ReadAt satisfies SelectedReadAt {
    machine read_at(window: &[u8], length: u64) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires length == window.len && length > 0
    {
        SelectedBodyCheck::require_tag(17u64);
        window[length - 1]
    }
}

ArmReadAt satisfies SelectedReadAt {
    machine read_at(window: &[u8], length: u64) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires length == window.len && length > 0
    {
        SelectedBodyCheck::require_tag(29u64);
        window[length - 1]
    }
}


machine main() crashes Trap {
    let items: [u8; 4] = [4, 7, 8, 9];
    let window: &[u8] = &items[0..3];
    transition SelectedReadAt::read_at(window, window.len) == 8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
