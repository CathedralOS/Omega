// Invalid: the transported length names the backing view, not the runtime window,
// so the last-byte index is no longer proved.
// Expected exit: 0
machine measure(window: &[u8]) -> u64
requires window.len < 100
ensures result == window.len + 1
{ window.len + 1 }
machine last_byte(items: &[u8], count: u64) -> u8
requires count > 0 && count <= items.len && count < 100
{
    let window: &[u8] = &items[0..count];
    let length: u64 = measure(window);
    window[length - 1]
}
machine main() crashes Trap {
    let items: [u8; 4] = [4, 7, 8, 9];
    transition last_byte(&items[..], 3) == 8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
