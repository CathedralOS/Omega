// Another machine receives a runtime window length and still names the last byte.
// Expected exit: 0
machine measure(window: @[u8]) -> u64
ensures result == window.length && result > 0
requires window.length > 0
{ window.length }
machine read_at(window: @[u8], length: u64) -> u8
requires length == window.length && length > 0
{ window[length - 1] }
machine last_byte(items: @[u8], count: u64) -> u8
requires count > 0 && count <= items.length
{
    let window: @[u8] = @items[0..count];
    read_at(window, measure(window))
}
machine main() crashes Trap {
    let items: [u8; 4] = [4, 7, 8, 9];
    transition last_byte(@items[..], 3) == 8 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
