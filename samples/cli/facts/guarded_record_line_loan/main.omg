// A selected Complete or End edge retains the mutable Application record and shared 64-byte line loans, so storing count in application.ledger.count and reading line[0] observes 37 + 5 = 42.
// Place: root.
// Expected exit: 0.
data Sequence { bases: [u64 in Wrapping; 12]; length: u64 in Wrapping; }
data Variant { first: Sequence; second: Sequence; position: u64 in Wrapping; }
data Ledger { variants: [Variant; 32]; count: u64 in Wrapping; }
data Application { first: Sequence; second: Sequence; ledger: Ledger; }
data ReadOutcome {
    case Invalid;
    case Complete(count: u64);
    case End(count: u64);
    case Full(count: u64);
}
machine receive(line: @mutable [u8; 64], end: bool) -> ReadOutcome {
    line[0] = 37;
    match end { true -> ReadOutcome::End { count: 5 }, false -> ReadOutcome::Complete { count: 5 } }
}
machine exercise(application: @mutable Application, end: bool) -> bool {
    transition { _ -> read(application, end) }
    machine read(application: @mutable Application, end: bool) -> bool {
        let mutable line: [u8; 64];
        let result: ReadOutcome = receive(@mutable line, end);
        transition result {
            ReadOutcome::Complete { count } -> observe(application, @line, count),
            ReadOutcome::End { count } -> observe(application, @line, count),
            ReadOutcome::Full { count } -> (false),
            ReadOutcome::Invalid -> (false)
        }
    }
    machine observe(application: @mutable Application, line: @[u8; 64], count: u64) -> bool {
        application.ledger.count = count as u64 +Wrapping;
        ((line[0] as u64 +Wrapping) + application.ledger.count) == 42
    }
}
machine main() crashes Trap {
    let mutable application: Application;
    application.ledger.count = 99u64 as +Wrapping;
    let complete: bool = exercise(@mutable application, false);
    let completed_count: u64 in Wrapping = application.ledger.count;
    application.ledger.count = 99u64 as +Wrapping;
    let ended: bool = exercise(@mutable application, true);
    transition complete && completed_count == 5 && ended && application.ledger.count == 5 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
