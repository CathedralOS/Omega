machine build(builder: &mut Build) {
    Build::select_provider<SelectedInspect, CheckedInspect>(builder, linux_x86_64);
    Build::select_provider<SelectedInspect, CheckedInspect>(builder, linux_arm64);
    Build::select_provider<SelectedInspect, CheckedInspect>(builder, macos_arm64);
    Build::select_provider<SelectedInspect, CheckedInspect>(builder, windows_x86_64);

    Build::application(builder, "guarded_record_line_loan_target_body_shared_record");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
