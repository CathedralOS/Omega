// Fact: 64-bit signed wrapping subtraction lhs -% rhs with bounded interval 40i64 <= diff <= 100i64 establishes 40i64 <= diff <= 100i64 across all nine places so exact subtractions 100i64 - diff and diff - 40i64 are safe.
// Invalid: widened inputs produce diff of 105i64, failing produce_diff ensures contract.

machine verify_diff(diff: i64) -> i32
    requires diff >= 40 && diff <= 100
{
    let headroom: i64 = 100 - diff;
    let margin: i64 = diff - 40;
    let total: i64 = headroom + margin;
    let check: i64 = total - 60;
    check as i32
}

machine produce_diff(lhs: i64 in Wrapping, rhs: i64 in Wrapping) -> i64
    requires lhs as i64 >= 80 && lhs as i64 <= 125, rhs as i64 >= 20 && rhs as i64 <= 40
    ensures result >= 40 && result <= 100
{
    let wrapped: i64 in Wrapping = lhs - rhs;
    wrapped as i64
}

machine main() crashes Trap {
    let lhs: i64 in Wrapping = 125;
    let rhs: i64 in Wrapping = 20;
    let diff: i64 = produce_diff(lhs, rhs);
    let check: i32 = verify_diff(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
