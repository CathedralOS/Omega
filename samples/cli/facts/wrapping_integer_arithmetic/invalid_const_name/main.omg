// Masking an unsigned scalar with a constant bitmask (val & 63u64) establishes the upper bound (masked <= 63u64), discharging exact subtraction 63u64 - masked.
// Expected rejection: exact arithmetic in machine main state entry local diff may overflow `u64`.
const MASK: u64 = 64u64;

machine main() crashes Trap {
    let val: u64 = 100u64;
    let masked: u64 = val & MASK;
    let diff: u64 = 63u64 - masked;
    transition diff == 27u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
