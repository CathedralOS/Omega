// Masking an unsigned scalar with a constant bitmask (val & 63u64) establishes the upper bound (masked <= 63u64), discharging exact subtraction 63u64 - masked.
// Expected rejection: exact arithmetic in machine compute state entry terminal expression may overflow `u64`.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedCompute {
    machine compute(val: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Compute satisfies SelectedCompute {
    machine compute(val: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let masked: u64 = val & 64u64;
        63u64 - masked
    }
}

ArmCompute satisfies SelectedCompute {
    machine compute(val: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let masked: u64 = val & 64u64;
        63u64 - masked
    }
}


machine main() crashes Trap {
    let diff: u64 = SelectedCompute::compute(100u64);
    transition diff == 27u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
