// The bounded count and address ceiling justify an exact split with disjoint content equal to the original interval.
// Expected exit: 0. Address/count partition preserves exact disjoint interval content.
// Numeric interval partition only: this local carrier grants no storage rights.
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { base: addr; length: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet {
        start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat
    }
}
data Pieces { left: Region in Owned; right: Region in Owned; }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSplit {
    machine split(whole: Region in Owned, length: u64, ceiling: addr) -> Pieces
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires length <= whole.length && embed(whole.base) + embed(whole.length) <= embed(ceiling) ensures Owned::content(old(&whole)) == separate( Owned::content(&result.right), Owned::content(&result.left));
}

X86Split satisfies SelectedSplit {
    machine split(whole: Region in Owned, length: u64, ceiling: addr) -> Pieces
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires length <= whole.length && embed(whole.base) + embed(whole.length) <= embed(ceiling) ensures Owned::content(old(&whole)) == separate( Owned::content(&result.right), Owned::content(&result.left))
    {
        SelectedBodyCheck::require_tag(17u64);
        let left: Region in Owned = Region { base: whole.base, length: length };
        let right: Region in Owned = Region { base: whole.base + length, length: whole.length - length };
        drop(whole);
        Pieces { left: left, right: right }
    }
}

ArmSplit satisfies SelectedSplit {
    machine split(whole: Region in Owned, length: u64, ceiling: addr) -> Pieces
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires length <= whole.length && embed(whole.base) + embed(whole.length) <= embed(ceiling) ensures Owned::content(old(&whole)) == separate( Owned::content(&result.right), Owned::content(&result.left))
    {
        SelectedBodyCheck::require_tag(29u64);
        let left: Region in Owned = Region { base: whole.base, length: length };
        let right: Region in Owned = Region { base: whole.base + length, length: whole.length - length };
        drop(whole);
        Pieces { left: left, right: right }
    }
}


machine main() crashes Trap {
    let whole: Region in Owned = Region { base: 10, length: 80 };
    let pieces: Pieces = SelectedSplit::split(whole, 20, 100);
    let correct: bool = pieces.left.base == 10 && pieces.left.length == 20
        && pieces.right.base == 30 && pieces.right.length == 60;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
