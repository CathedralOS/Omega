// The bounded count and address ceiling justify an exact split with disjoint content equal to the original interval.
// Intended rejection. Address/count partition preserves exact disjoint interval content.
// Numeric interval partition only: this local carrier grants no storage rights.
use {omega}/language/core/content.omg;
use {omega}/language/core/foundation.omg as proof;
use {omega}/language/core/nat.omg;
data Region [linear] dropped by drop_region { base: address; length: u64; }
machine drop_region(region: @mutable Region) {}
domain Region::Owned;
machine Owned::content(region: @Region) -> |content|::IntervalSet<|nat|::Nat>
satisfies |content|::Content<Region, |content|::IntervalSet<|nat|::Nat>>::project {
    |content|::IntervalSet {
        start: embed(region.base) as |nat|::Nat,
        end: (embed(region.base) + embed(region.length)) as |nat|::Nat
    }
}
const LENGTH: u64 = 20;
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, ceiling: address) -> Pieces
requires embed(whole.base) + embed(whole.length) <= embed(ceiling)
ensures |proof|::Identity::<|content|::IntervalSet<|nat|::Nat>>(
    Owned::content(old(@whole)),
    separate(
        Owned::content(@result.right), Owned::content(@result.left))
)
{
    let left: Region in Owned = Region { base: whole.base, length: LENGTH };
    let right: Region in Owned = Region { base: whole.base + LENGTH, length: whole.length - LENGTH };
    drop(whole);
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let whole: Region in Owned = Region { base: 10, length: 80 };
    let pieces: Pieces = split(whole, 100);
    let correct: bool = pieces.left.base == 10 && pieces.left.length == 20
        && pieces.right.base == 30 && pieces.right.length == 60;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    transition correct { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
