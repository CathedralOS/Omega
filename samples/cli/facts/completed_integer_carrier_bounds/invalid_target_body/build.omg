machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "completed_integer_carrier_bounds_target_body" };
    Build::bind(builder, linux_x86_64::ProgramEntry, Actual::start);
    Build::bind(builder, windows_x86_64::ProgramEntry, Actual::start);
    Build::bind(builder, linux_arm64::ProgramEntry, Actual::start);
    Build::bind(builder, macos_arm64::ProgramEntry, Actual::start);
}
