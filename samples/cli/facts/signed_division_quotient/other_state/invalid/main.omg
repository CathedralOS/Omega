// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Invalid: quotient is 99, so subtracting 100u64 underflows. Place: other_state.
// Expected diagnostic: may overflow `u64`

machine verify_state(q: i64) -> i32
requires q >= 99 && q <= 99
{
    transition {
        _ -> step(q)
    }
    state step(quotient: i64) -> i32
    requires quotient >= 99 && quotient <= 99
    {
        let verified: u64 = quotient as u64;
        let diff: u64 = verified - 100u64;
        diff as i32
    }
}

machine probe() -> i32 {
    let q: i64 = (-297i64) / (-3i64);
    verify_state(q)
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
