// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Place: other_state. A successor state receives the quotient and performs the subtraction check.
// Expected exit: 0

machine verify_state(q: i64) -> i32
requires q >= 100 && q <= 100
{
    transition {
        _ -> step(q)
    }
    machine step(quotient: i64) -> i32
    requires quotient >= 100 && quotient <= 100
    {
        let verified: u64 = quotient as u64;
        let diff: u64 = verified - 100u64;
        diff as i32
    }
}

machine probe() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    verify_state(q)
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
