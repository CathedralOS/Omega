// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Place: field. A record field carries the quotient into the subtraction check.
// Expected exit: 0

data DivResult where quotient >= 100 && quotient <= 100 {
    quotient: i64;
}

machine verify_field(payload: DivResult) -> i32 {
    let verified: u64 = payload.quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}

machine probe() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    let payload: DivResult = DivResult { quotient: q };
    verify_field(payload)
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
