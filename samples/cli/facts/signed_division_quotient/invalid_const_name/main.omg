// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Invalid: quotient is 99, so subtracting 100u64 underflows. Place: const_name.
// Expected diagnostic: may overflow `u64`

const QUOTIENT: i64 = (-297i64) / (-3i64);

machine probe() -> i32 {
    let quotient: i64 = QUOTIENT;
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
