// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Place: match_join. Both match arms produce the quotient and join into the subtraction check.
// Expected exit: 0

machine choose_quotient(flag: bool) -> i64
ensures result >= 100 && result <= 100
{
    match flag {
        true -> (-300i64) / (-3i64),
        false -> (-300i64) / (-3i64),
    }
}

machine probe() -> i32 {
    let quotient: i64 = choose_quotient(true);
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
