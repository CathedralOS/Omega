// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Place: other_machine. A forwarding machine forwards the quotient to the verifying machine.
// Expected exit: 0

machine verify_target(quotient: i64) -> i32
requires quotient >= 100 && quotient <= 100
{
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}

machine forward(quotient: i64) -> i32
requires quotient >= 100 && quotient <= 100
{
    verify_target(quotient)
}

machine probe() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    forward(q)
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
