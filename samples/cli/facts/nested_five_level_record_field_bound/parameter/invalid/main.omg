// Fact: a 5-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { val: u64 } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: parameter (invalid twin). The leaf upper bound is widened to 81u64 so res reaches 81u64, underflowing 80u64 - res.
// Expected diagnostic: may overflow `u64`

data Level4 [copy] {
    val: u64;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

machine check_param(root: RootRec) -> u64
requires root.l1.l2.l3.l4.val >= 40 && root.l1.l2.l3.l4.val <= 81
{
    let res: u64 = root.l1.l2.l3.l4.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine probe() -> u64 {
    let root: RootRec = RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        val: 60u64,
                    },
                },
            },
        },
    };
    check_param(root)
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
