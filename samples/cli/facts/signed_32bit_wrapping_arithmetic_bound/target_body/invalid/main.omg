// Fact: 32-bit signed wrapping addition lhs +% rhs with bounded interval 50i32 <= sum <= 100i32 establishes 50i32 <= sum <= 100i32 across all nine places so exact subtractions 100i32 - sum and sum - 50i32 are safe.

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine target_probe(lhs: i32, rhs: i32) -> u32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 40i32 && lhs <= 80i32 && rhs >= 10i32 && rhs <= 21i32;
}

X86Probe satisfies SelectedProbe {
    machine target_probe(lhs: i32, rhs: i32) -> u32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 40i32 && lhs <= 80i32 && rhs >= 10i32 && rhs <= 21i32
    {
        SelectedBodyCheck::require_tag(17u64);
        let wl: i32 in Wrapping = lhs as i32 in Wrapping;
        let wr: i32 in Wrapping = rhs as i32 in Wrapping;
        let ws: i32 in Wrapping = wl + wr;
        let sum: i32 = ws as i32;
        let headroom: i32 = 100i32 - sum;
        let margin: i32 = sum - 50i32;
        (headroom as u32) + (margin as u32)
    }
}

ArmProbe satisfies SelectedProbe {
    machine target_probe(lhs: i32, rhs: i32) -> u32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 40i32 && lhs <= 80i32 && rhs >= 10i32 && rhs <= 21i32
    {
        SelectedBodyCheck::require_tag(29u64);
        let wl: i32 in Wrapping = lhs as i32 in Wrapping;
        let wr: i32 in Wrapping = rhs as i32 in Wrapping;
        let ws: i32 in Wrapping = wl + wr;
        let sum: i32 = ws as i32;
        let headroom: i32 = 100i32 - sum;
        let margin: i32 = sum - 50i32;
        (headroom as u32) + (margin as u32)
    }
}

machine probe(lhs: i32, rhs: i32) -> u32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
    requires lhs >= 40i32 && lhs <= 80i32 && rhs >= 10i32 && rhs <= 21i32
{
    SelectedProbe::target_probe(lhs, rhs)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let combined: u32 = probe(60i32, 15i32);
    transition combined == 50u32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
