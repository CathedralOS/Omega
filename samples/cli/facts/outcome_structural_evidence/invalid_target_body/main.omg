// Expected exit: 0.
// Selecting Success from pick(Gate{threshold:5}) transports exact above(gate.threshold) evidence and preserves threshold 5.
data Outcome [copy] { case Success; case Failure; }
data Gate [copy] { threshold: u32; }
trait Evidence {}
proposition above(limit: u32) evidence Evidence;
Fresh satisfies Evidence {}
machine pick(gate: Gate) -> Outcome
ensures Outcome::Success -> { selected: above(gate.threshold); }
{  Outcome::Success }
machine pick_failure(gate: Gate) -> Outcome
ensures Outcome::Success -> { selected: above(gate.threshold); }
{ Outcome::Failure }
machine failure_arm() -> bool {
 transition pick_failure(Gate { threshold: 5 }) {
  Outcome::Success { ; selected: proof } -> (false)
  _ -> (true)
 }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(gate: Gate) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine probe(gate: Gate) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     transition pick(gate) {
      Outcome::Success { ; selected: proof } -> (gate.threshold == 5)
      _ -> (false)
     }
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(gate: Gate) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     transition pick(gate) {
      Outcome::Success { ; selected: proof } -> (gate.threshold == 5)
      _ -> (false)
     }
    }
}


machine main() crashes Trap {
 transition (SelectedProbe::probe(Gate { threshold: 5 })) && failure_arm() { true -> done() _ -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
