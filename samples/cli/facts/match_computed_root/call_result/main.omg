// A match subject is one evaluation of a computed root, the selected exclusive loan records that root, and the consumer writes 41 through that recorded loan.
// Place: call_result.
// Expected exit: 0


machine compute(counter: @mutable u64) -> u64
requires $counter == 0
{
    $counter = $counter + 1;
    0
}

machine select<'a>(chosen: @'a mutable [i64; 2], other: @'a mutable [i64; 2], visits: @mutable u64) -> @'a mutable i64 {
    match chosen[compute(visits)] {
        17 -> @mutable chosen[0],
        _ -> @mutable other[0]
    }
}

machine main() crashes Trap {
    let mutable chosen: [i64; 2] = [17, 5];
    let mutable other: [i64; 2] = [0, 8];
    let mutable visits: u64 = 0;
    let selected: @mutable i64 = select(@mutable chosen, @mutable other, @mutable visits);
    $selected = 41;
    transition chosen[0] == 41 && chosen[1] == 5 && other[0] == 0 && visits == 1 {
        true -> done(),
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
