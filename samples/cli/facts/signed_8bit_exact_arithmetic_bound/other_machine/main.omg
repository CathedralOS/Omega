// Fact: an 8-bit signed i8 exact addition of bounded inputs (lhs >= 20i8 && lhs <= 45i8, rhs >= 15i8 && rhs <= 35i8) establishes sum >= 35i8 && sum <= 80i8 so exact 8-bit signed subtraction 80i8 - sum is proved overflow-free across all nine places.
// Place: other_machine. A forwarding machine transports the sum through an intermediate machine call.
// Expected exit: 0
machine target_machine(val: i8) -> i8
    ensures result == val
{
    val
}

machine forwarder(val: i8) -> i8
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(lhs: i8, rhs: i8) -> i8
    requires lhs >= 20 && lhs <= 45 && rhs >= 15 && rhs <= 35
{
    let sum: i8 = forwarder(lhs + rhs);
    let headroom: i8 = 80 - sum;
    headroom
}

machine evaluate() -> i32 {
    let h: i8 = compute_other_machine(30, 25);
    h as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 25 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
