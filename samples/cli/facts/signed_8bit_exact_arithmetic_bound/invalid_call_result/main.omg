// Fact: an 8-bit signed i8 exact addition of bounded inputs (lhs >= 20i8 && lhs <= 45i8, rhs >= 15i8 && rhs <= 35i8) establishes sum >= 35i8 && sum <= 80i8 so exact 8-bit signed subtraction 80i8 - sum is proved overflow-free across all nine places.
// Place: call_result. The sum of the 8-bit signed addition is returned from a callee invocation.
// Expected exit: 0
machine add_helper(l: i8, r: i8) -> i8
    requires l >= 20 && l <= 45 && r >= 15 && r <= 90
    ensures result >= 35 && result <= 80
{
    l + r
}

machine compute_call_result(lhs: i8, rhs: i8) -> i8
    requires lhs >= 20 && lhs <= 45 && rhs >= 15 && rhs <= 90
{
    let sum: i8 = add_helper(lhs, rhs);
    let headroom: i8 = 80 - sum;
    headroom
}

machine evaluate() -> i32 {
    let h: i8 = compute_call_result(30, 25);
    h as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
