// Fact: an 8-bit signed i8 exact addition of bounded inputs (lhs >= 20i8 && lhs <= 45i8, rhs >= 15i8 && rhs <= 35i8) establishes sum >= 35i8 && sum <= 80i8 so exact 8-bit signed subtraction 80i8 - sum is proved overflow-free across all nine places.
// Place: const_name. A named constant rhs adds to the bounded lhs.
// Expected exit: 0
const RHS: i8 = 90;

machine compute_const(lhs: i8) -> i8
    requires lhs >= 20 && lhs <= 45
{
    let sum: i8 = lhs + RHS;
    let headroom: i8 = 80 - sum;
    headroom
}

machine evaluate() -> i32 {
    let h: i8 = compute_const(30);
    h as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
