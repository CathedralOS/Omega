// Fact: an 8-bit signed i8 exact addition of bounded inputs (lhs >= 20i8 && lhs <= 45i8, rhs >= 15i8 && rhs <= 35i8) establishes sum >= 35i8 && sum <= 80i8 so exact 8-bit signed subtraction 80i8 - sum is proved overflow-free across all nine places.
// Place: parameter. The sum of the 8-bit signed addition is forwarded as a machine parameter.
// Expected exit: 0
machine forward_param(s: i8) -> i8
    ensures result == s
{
    s
}

machine compute_parameter(lhs: i8, rhs: i8) -> i8
    requires lhs >= 20 && lhs <= 45 && rhs >= 15 && rhs <= 90
{
    let sum: i8 = lhs + rhs;
    let transported: i8 = forward_param(sum);
    let headroom: i8 = 80 - transported;
    headroom
}

machine evaluate() -> i32 {
    let h: i8 = compute_parameter(30, 25);
    h as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
