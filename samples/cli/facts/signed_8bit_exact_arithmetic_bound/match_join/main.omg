// Fact: an 8-bit signed i8 exact addition of bounded inputs (lhs >= 20i8 && lhs <= 45i8, rhs >= 15i8 && rhs <= 35i8) establishes sum >= 35i8 && sum <= 80i8 so exact 8-bit signed subtraction 80i8 - sum is proved overflow-free across all nine places.
// Place: match_join. Both match arms yield the sum so the joined binding preserves the addition bounds.
// Expected exit: 0
machine compute_match_join(lhs: i8, rhs: i8, flag: bool) -> i8
    requires lhs >= 20 && lhs <= 45 && rhs >= 15 && rhs <= 35
{
    let sum: i8 = lhs + rhs;
    let joined: i8 = match flag {
        true -> sum
        false -> sum
    };
    let headroom: i8 = 80 - joined;
    headroom
}

machine evaluate() -> i32 {
    let h: i8 = compute_match_join(30, 25, true);
    h as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
