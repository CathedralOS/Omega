// Fact: 64-bit signed bitwise OR base | 32i64 with bounded interval 40i64 <= combined <= 63i64 establishes 40i64 <= combined <= 63i64 across all nine places so exact subtractions 63i64 - combined and combined - 40i64 are safe.
// Place: target_body. Each hosted target body computes the 64-bit signed bitwise OR and verifies the bounds.
// Expected exit: 0
machine verify_combined(res: i64) -> i32
    requires res >= 40 && res <= 63
{
    let head: i64 = 63 - res;
    let tail: i64 = res - 40;
    let sum: i64 = head + tail;
    let diff: i64 = sum - 23;
    diff as i32
}

linux_x86_64 machine compute_target_body(base: i64) -> i32
    requires base >= 64 && base <= 64
{
    let combined: i64 = base | 32;
    verify_combined(combined)
}

linux_arm64 machine compute_target_body(base: i64) -> i32
    requires base >= 64 && base <= 64
{
    let combined: i64 = base | 32;
    verify_combined(combined)
}

macos_arm64 machine compute_target_body(base: i64) -> i32
    requires base >= 64 && base <= 64
{
    let combined: i64 = base | 32;
    verify_combined(combined)
}

windows_x86_64 machine compute_target_body(base: i64) -> i32
    requires base >= 64 && base <= 64
{
    let combined: i64 = base | 32;
    verify_combined(combined)
}

machine evaluate() -> i32 {
    compute_target_body(64)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
