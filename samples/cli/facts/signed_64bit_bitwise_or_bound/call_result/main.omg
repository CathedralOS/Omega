// Fact: 64-bit signed bitwise OR base | 32i64 with bounded interval 40i64 <= combined <= 63i64 establishes 40i64 <= combined <= 63i64 across all nine places so exact subtractions 63i64 - combined and combined - 40i64 are safe.
// Place: call_result. The bitwise OR result is returned from a callee invocation.
// Expected exit: 0
machine verify_combined(res: i64) -> i32
    requires res >= 40 && res <= 63
{
    let head: i64 = 63 - res;
    let tail: i64 = res - 40;
    let sum: i64 = head + tail;
    let diff: i64 = sum - 23;
    diff as i32
}

machine or_helper(v: i64) -> i64
    requires v >= 20 && v <= 20
    ensures result >= 40 && result <= 63
{
    v | 32
}

machine compute_call_result(base: i64) -> i32
    requires base >= 20 && base <= 20
{
    let combined: i64 = or_helper(base);
    verify_combined(combined)
}

machine evaluate() -> i32 {
    compute_call_result(20)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
