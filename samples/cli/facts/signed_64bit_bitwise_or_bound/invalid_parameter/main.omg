// Fact: 64-bit signed bitwise OR base | 32i64 with bounded interval 40i64 <= combined <= 63i64 establishes 40i64 <= combined <= 63i64 across all nine places so exact subtractions 63i64 - combined and combined - 40i64 are safe.
// Place: parameter. The bitwise OR result is forwarded as a machine parameter.
// Expected exit: 0
machine verify_combined(res: i64) -> i32
    requires res >= 40 && res <= 63
{
    let head: i64 = 63 - res;
    let tail: i64 = res - 40;
    let sum: i64 = head + tail;
    let diff: i64 = sum - 23;
    diff as i32
}

machine forward_param(s: i64) -> i64
    ensures result == s
{
    s
}

machine compute_parameter(base: i64) -> i32
    requires base >= 64 && base <= 64
{
    let combined: i64 = base | 32;
    let transported: i64 = forward_param(combined);
    verify_combined(transported)
}

machine evaluate() -> i32 {
    compute_parameter(64)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
