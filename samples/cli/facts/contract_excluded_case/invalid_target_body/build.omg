use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "contract_excluded_case_target_body" };
    Build::select_provider::<|app|::Consume, |app|::Selected>(builder, windows_x86_64);
    Build::select_provider::<|app|::Consume, |app|::Selected>(builder, linux_x86_64);
    Build::select_provider::<|app|::Consume, |app|::Selected>(builder, macos_arm64);
    Build::select_provider::<|app|::Consume, |app|::Selected>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
