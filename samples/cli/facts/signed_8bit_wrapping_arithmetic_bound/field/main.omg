// Fact: 8-bit signed wrapping addition lhs +% rhs with bounded interval 50i8 <= sum <= 100i8 establishes 50i8 <= sum <= 100i8 across all nine places so exact subtractions 100i8 - sum and sum - 50i8 are safe.
// Place: field. The wrapping sum is carried in a record field before discharging subtraction bounds.
// Expected exit: 0

data SumContainer {
    sum: i8;
}

machine verify_sum(sum: i8) -> i32
requires sum >= 50i8 && sum <= 100i8
{
    let headroom: i8 = 100i8 - sum;
    let margin: i8 = sum - 50i8;
    0i32
}

machine compute_field(lhs: i8, rhs: i8) -> i32
requires lhs >= 40i8 && lhs <= 80i8 && rhs >= 10i8 && rhs <= 20i8
{
    let w_lhs: i8 in Wrapping = lhs as i8 in Wrapping;
    let w_rhs: i8 in Wrapping = rhs as i8 in Wrapping;
    let sum_wrap: i8 in Wrapping = w_lhs + w_rhs;
    let container: SumContainer = SumContainer { sum: sum_wrap as i8 };
    verify_sum(container.sum)
}

machine probe() -> i32 {
    compute_field(60i8, 15i8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
