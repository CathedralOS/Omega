// Fact: 8-bit signed wrapping addition lhs +% rhs with bounded interval 50i8 <= sum <= 100i8 establishes 50i8 <= sum <= 100i8 across all nine places so exact subtractions 100i8 - sum and sum - 50i8 are safe.
// Invalid: lhs upper bound 81 allows sum 101, violating verify_parameter contract. Place: parameter.
// Expected diagnostic: cannot prove requires contract for call verify_parameter

machine verify_parameter(sum: i8) -> i32
requires sum >= 50i8 && sum <= 100i8
{
    let headroom: i8 = 100i8 - sum;
    let margin: i8 = sum - 50i8;
    0i32
}

machine compute_param(lhs: i8, rhs: i8) -> i32
requires lhs >= 40i8 && lhs <= 81i8 && rhs >= 10i8 && rhs <= 20i8
{
    let w_lhs: i8 in Wrapping = lhs as i8 in Wrapping;
    let w_rhs: i8 in Wrapping = rhs as i8 in Wrapping;
    let sum_wrap: i8 in Wrapping = w_lhs + w_rhs;
    verify_parameter(sum_wrap as i8)
}

machine probe() -> i32 {
    compute_param(60i8, 15i8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
