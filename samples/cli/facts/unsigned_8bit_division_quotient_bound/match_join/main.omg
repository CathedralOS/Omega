// Fact: an 8-bit unsigned u8 division of bounded inputs (dividend >= 120u8 && dividend <= 120u8, divisor >= 4u8 && divisor <= 4u8) establishes quotient >= 30u8 && quotient <= 30u8 so exact 8-bit subtraction quotient - 30u8 is proved underflow-free across all nine places.
// Place: match join. The quotient is synthesized across conditional match branches.
// Expected exit: 0

machine divide_match_join(dividend: u8, divisor: u8, choose: bool) -> i32
    requires dividend >= 120u8 && dividend <= 120u8;
    requires divisor >= 4u8 && divisor <= 4u8;
{
    let quotient: u8 = match choose {
        true -> dividend / divisor,
        false -> dividend / divisor
    };
    let check: u8 = quotient - 30u8;
    transition quotient == 30u8 && check == 0u8 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = divide_match_join(120u8, 4u8, true);
    let res2: i32 = divide_match_join(120u8, 4u8, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
