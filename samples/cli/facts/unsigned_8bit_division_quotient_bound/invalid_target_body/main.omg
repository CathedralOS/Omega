// Fact: an 8-bit unsigned u8 division of bounded inputs (dividend >= 120u8 && dividend <= 120u8, divisor >= 4u8 && divisor <= 4u8) establishes quotient >= 30u8 && quotient <= 30u8 so exact 8-bit subtraction quotient - 30u8 is proved underflow-free across all nine places.
// Place: another target body. Target-scoped implementations across all four platforms verify the bounds.
// Invalid control: divisor upper bound widened to 5u8, allowing quotient as low as 24u8 and failing subtraction quotient - 30u8.
// Expected rejection: may overflow `u8`

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedDivideTarget {
    machine divide_target(dividend: u8, divisor: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 120u8 && dividend <= 120u8 requires divisor >= 4u8 && divisor <= 5u8;
}

X86DivideTarget satisfies SelectedDivideTarget {
    machine divide_target(dividend: u8, divisor: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 120u8 && dividend <= 120u8 requires divisor >= 4u8 && divisor <= 5u8
    {
        SelectedBodyCheck::require_tag(17u64);
        let quotient: u8 = dividend / divisor;
        let check: u8 = quotient - 30u8;
        transition quotient == 30u8 && check == 0u8 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

ArmDivideTarget satisfies SelectedDivideTarget {
    machine divide_target(dividend: u8, divisor: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 120u8 && dividend <= 120u8 requires divisor >= 4u8 && divisor <= 5u8
    {
        SelectedBodyCheck::require_tag(29u64);
        let quotient: u8 = dividend / divisor;
        let check: u8 = quotient - 30u8;
        transition quotient == 30u8 && check == 0u8 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

machine main() crashes Trap {
    let res: i32 = SelectedDivideTarget::divide_target(120u8, 4u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
