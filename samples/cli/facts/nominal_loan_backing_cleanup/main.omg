// Expected exit: 0
data Room { count: u32 in Wrapping; }
machine Room::drop(room: &mut Room) { room.count = 99; }
machine main() crashes Trap {
 let room: Room = Room { count: 10 };
 transition { _ -> observe(&mut room) }
 machine observe(room: &mut Room) { transition room.count == 10 { true -> done() false -> bad() } }
 machine done() {}
 machine bad() { crash Trap; }
}
