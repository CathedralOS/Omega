// Expected exit: 0
data Room dropped by drop_room { count: u32 in Wrapping; }
machine drop_room(room: @mutable Room) { room.count = 99; }
machine main() crashes Trap {
 let mutable room: Room = Room { count: 10 };
 transition { _ -> observe(@mutable room) }
 machine observe(room: @mutable Room) { transition room.count == 10 { true -> done(), false -> bad() } }
 machine done() {}
 machine bad() { crash Trap; }
}
