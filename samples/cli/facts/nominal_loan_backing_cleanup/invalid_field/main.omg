// An affine Room with count 10 and executable nominal cleanup retains original backing through a successor-state loan; successor observes 10, and owner cleans exactly once after loan closes.
// Expected error: contextual cleanup prerequisite

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen system\Console.
public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates crashes none;
}

boundary trait PosixConsoleIo {
    machine write(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    reaches Console
    terminates crashes none;
}

// All bound targets are little-endian: the low byte is the first byte.
boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    reaches Console
    terminates crashes none;
}

data Room dropped by drop_room { count: u32 in Wrapping; }
machine drop_room(room: @mutable Room)
requires room.count == 10
reaches Console
{
 Console::write_byte(68);
 room.count = 99;
}
data Holder { room: Room; }
machine scope() reaches Console crashes Trap {
 let mutable holder: Holder = Holder { room: Room { count: 11 } };
 transition { _ -> observe(@mutable holder.room) }
 machine observe(room: @mutable Room) {
  Console::write_byte(79);
  transition room.count == 11 { true -> seen(), false -> bad() }
 }
 machine seen() {}
 machine bad() { crash Trap; }

}
data Main {}
machine Main::main(main: @mutable Main) reaches Console crashes Trap { scope(); }

PosixConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mutable cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, @mutable cell, 1);
}
}

WindowsConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mutable cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, @mutable cell, 1);
}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
