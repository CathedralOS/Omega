use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
 builder.product = BuildProduct::Application { name: "nominal_loan_field" };
 Build::select_provider::<|app|::Console, |app|::PosixConsoleWrite>(builder, linux_arm64);
 Build::select_provider::<|app|::Console, |app|::PosixConsoleWrite>(builder, linux_x86_64);
 Build::select_provider::<|app|::Console, |app|::PosixConsoleWrite>(builder, macos_arm64);

 Build::select_provider::<|app|::Console, |app|::WindowsConsoleWrite>(builder, windows_x86_64);

 Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);

 Build::bind_native::<|app|::PosixConsoleIo::write>(builder, macos_arm64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });
 Build::bind_native::<|app|::WindowsConsoleIo::write>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
        library: "msvcrt.dll", export: "_write"
    } });

 Build::bind_native::<|app|::PosixConsoleIo::write>(builder, linux_x86_64, |native|::ForeignBinding::Syscall { number: 1 });
 Build::bind_native::<|app|::PosixConsoleIo::write>(builder, linux_arm64, |native|::ForeignBinding::Syscall { number: 64 });
}
