use omega\language\core\DllImport;
use omega\language\core\ForeignBinding;
machine build(builder: @mutable BuildPlan) {
 builder.product = BuildProduct::Application { name: "nominal_loan_field" };
 Build::select_provider::<Console, PosixConsoleWrite>(builder, linux_arm64);
 Build::select_provider::<Console, PosixConsoleWrite>(builder, linux_x86_64);
 Build::select_provider::<Console, PosixConsoleWrite>(builder, macos_arm64);

 Build::select_provider::<Console, WindowsConsoleWrite>(builder, windows_x86_64);

 Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);

 Build::bind_native::<PosixConsoleIo::write>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });
 Build::bind_native::<WindowsConsoleIo::write>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "_write"
    } });

 Build::bind_native::<PosixConsoleIo::write>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
 Build::bind_native::<PosixConsoleIo::write>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });
}
