// A matched window has length 2 across this place and write_pair writes its original backing.
// A match arm's integer pattern is that arm's value of the field.
// The window `holder.bytes[0..holder.which + 2]` in `holder.which == 0`
// has length 2.
// Expected exit: 0

data Holder {
    which: i64;
    bytes: [u8; 4];
}

machine from_field<'row>(holder: @'row mutable Holder) -> @'row mutable [u8]
    ensures result.length == 2
{
    match holder.which {
        0 -> @mutable holder.bytes[0..holder.which + 2],
        _ -> @mutable holder.bytes[2..4]
    }
}

machine write_pair(window: @mutable [u8])
    requires window.length >= 2
{
    window[0] = 9;
    window[1] = 8;
}

machine main() crashes Trap {
    let mutable holder: Holder = Holder { which: 0, bytes: [1, 2, 3, 4] };
    let window: @mutable [u8] = from_field(@mutable holder);
    write_pair(window);
    transition holder.bytes[0] == 9 && holder.bytes[1] == 8 && holder.bytes[2] == 3 {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
