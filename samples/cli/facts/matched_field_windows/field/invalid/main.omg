// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: the other arm selects `holder.bytes[2..3]`, so the arm that does not
// pin `holder.which` publishes length 1 and the arms disagree.
data Holder {
    which: i64;
    bytes: [u8; 4];
}

machine from_field<'row>(holder: &'row mut Holder) -> &'row mut [u8]
    ensures result.len == 2
{
    match holder.which {
        0 -> &mut holder.bytes[0..holder.which + 2]
        _ -> &mut holder.bytes[2..3]
    }
}

machine main() crashes Trap {
    let mut holder: Holder = Holder { which: 0, bytes: [1, 2, 3, 4] };
    let window: &mut [u8] = from_field(&mut holder);
    transition window.len == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
