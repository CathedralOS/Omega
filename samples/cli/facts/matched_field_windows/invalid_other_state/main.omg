// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: the successor state's other arm selects `items[2..3]`, so the arm
// that does not pin `which` publishes length 1.
machine from_state<'row>(items: @'row mutable [u8; 4], which: i64) -> @'row mutable [u8]
    ensures result.length == 2
{
    transition { _ -> pick(items, which) }
    machine pick(items: @'row mutable [u8; 4], which: i64) -> @'row mutable [u8] {
        match which {
            0 -> @mutable items[0..which + 2],
            _ -> @mutable items[2..3]
        }
    }
}
machine main() crashes Trap {
    let mutable bytes: [u8; 4] = [1, 2, 3, 4];
    let window: @mutable [u8] = from_state(@mutable bytes, 0);
    transition window.length == 2 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
