// Another state matches the integer. In the arm `which == 0`, the window
// `items[0..which + 2]` has length 2, the same as the other arm.
// Expected exit: 0

machine from_state<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    transition { _ -> pick(items, which) }
    state pick(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8] {
        match which {
            0 -> &mut items[0..which + 2]
            _ -> &mut items[2..4]
        }
    }
}

machine write_pair(window: &mut [u8])
    requires window.len >= 2
{
    window[0] = 9;
    window[1] = 8;
}

machine main() crashes Trap {
    let mut bytes: [u8; 4] = [1, 2, 3, 4];
    let window: &mut [u8] = from_state(&mut bytes, 0);
    write_pair(window);
    transition bytes[0] == 9 && bytes[1] == 8 && bytes[2] == 3 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
