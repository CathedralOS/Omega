// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: the const name SPAN is 3, so the arm `which == 0` window has
// length 3 and disagrees with the other arm's length 2.
const SPAN: i64 = 3;

machine from_const<'row>(items: @'row mutable [u8; 4], which: i64) -> @'row mutable [u8]
    ensures result.length == 2
{
    match which {
        0 -> @mutable items[0..which + SPAN],
        _ -> @mutable items[2..4]
    }
}
machine main() crashes Trap {
    let mutable bytes: [u8; 4] = [1, 2, 3, 4];
    let window: @mutable [u8] = from_const(@mutable bytes, 0);
    transition window.length == 2 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
