use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "atomic_operand_carrier_once_target_body" };
    Build::select_provider::<|app|::HostedExchange, |app|::HostedExchangeBody>(builder, windows_x86_64);
    Build::select_provider::<|app|::HostedExchange, |app|::HostedExchangeBody>(builder, linux_x86_64);
    Build::select_provider::<|app|::HostedExchange, |app|::HostedExchangeBody>(builder, macos_arm64);
    Build::select_provider::<|app|::HostedExchange, |app|::HostedExchangeBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
