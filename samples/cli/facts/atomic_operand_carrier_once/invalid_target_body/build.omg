machine build(builder: &mut Build) {
    Build::application(builder, "atomic_operand_carrier_once_target_body");
    Build::select_provider<HostedExchange, HostedExchangeBody>(builder, windows_x86_64);
    Build::select_provider<HostedExchange, HostedExchangeBody>(builder, linux_x86_64);
    Build::select_provider<HostedExchange, HostedExchangeBody>(builder, macos_arm64);
    Build::select_provider<HostedExchange, HostedExchangeBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
