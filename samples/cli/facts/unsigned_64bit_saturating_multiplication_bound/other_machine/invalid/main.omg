// Fact: 64-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u64 <= prod <= 200u64 establishes 50u64 <= prod <= 200u64 across all nine places so exact subtractions 200u64 - prod and prod - 50u64 are safe.
// Place: another machine. The product is forwarded to another machine for interval verification.
// Invalid control: lhs upper bound widened to 21u64, allowing prod up to 210u64 and failing exact headroom subtraction.
// Expected rejection: may overflow `u64`

machine forward_eval(p: u64) -> i32
    requires p >= 50u64 && p <= 210u64;
{
    let headroom: u64 = 200u64 - p;
    let margin: u64 = p - 50u64;
    transition p == 120u64 && headroom + margin == 150u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine multiply_other_machine(lhs: u64, rhs: u64) -> i32
    requires lhs >= 10u64 && lhs <= 21u64;
    requires rhs >= 5u64 && rhs <= 10u64;
{
    let a: u64 in Saturating = lhs as u64 in Saturating;
    let b: u64 in Saturating = rhs as u64 in Saturating;
    let p_sat: u64 in Saturating = a * b;
    let prod: u64 = p_sat as u64;
    forward_eval(prod)
}

machine main() crashes Trap {
    let res: i32 = multiply_other_machine(15u64, 8u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
