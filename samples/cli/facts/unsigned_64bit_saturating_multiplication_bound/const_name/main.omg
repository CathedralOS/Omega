// Fact: 64-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u64 <= prod <= 200u64 establishes 50u64 <= prod <= 200u64 across all nine places so exact subtractions 200u64 - prod and prod - 50u64 are safe.
// Place: const name. The bounds and product limits reference declared symbolic constants.
// Expected exit: 0

const LHS_MIN: u64 = 10u64;
const LHS_MAX: u64 = 20u64;
const RHS_MIN: u64 = 5u64;
const RHS_MAX: u64 = 10u64;
const PROD_MIN: u64 = 50u64;
const PROD_MAX: u64 = 200u64;

machine multiply_const(lhs: u64, rhs: u64) -> i32
    requires lhs >= LHS_MIN && lhs <= LHS_MAX;
    requires rhs >= RHS_MIN && rhs <= RHS_MAX;
{
    let a: u64 in Saturating = lhs as u64 in Saturating;
    let b: u64 in Saturating = rhs as u64 in Saturating;
    let p_sat: u64 in Saturating = a * b;
    let prod: u64 = p_sat as u64;
    let headroom: u64 = PROD_MAX - prod;
    let margin: u64 = prod - PROD_MIN;
    transition prod == 120u64 && headroom + margin == 150u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_const(15u64, 8u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
