// Fact: A copyable indirect C affine record preserves all six floating fields and independent earlier-call contents through transport and copying into the consuming operation.
// Expected exit: 0
use omega::language::core::external_binding;
public data Transform [copy] { a: f64; b: f64; c: f64; d: f64; tx: f64; ty: f64; }
public boundary trait AffineTransforms {
    machine make(a: f64, b: f64, c: f64, d: f64, tx: f64, ty: f64) -> Transform reaches;
}
macos_arm64 machine affine_binding() -> ForeignBinding<73, 22, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/System/Library/Frameworks/CoreGraphics.framework/Versions/A/CoreGraphics", symbol: "_CGAffineTransformMake"
    } }
}
macos_arm64 machine make(a: f64, b: f64, c: f64, d: f64, tx: f64, ty: f64) -> Transform
    satisfies AffineTransforms::make via affine_binding();

machine consume(first: Transform, copied: Transform) -> i32 reaches AffineTransforms {
    let second: Transform = AffineTransforms::make(-11.0, 12.5, -13.25, 14.75, -15.5, 16.0);
    transition first.a == 1.25
        && first.b == -2.5
        && first.c == 3.75
        && first.d == -4.0
        && first.tx == 5.5
        && first.ty == -6.25
        && copied.a == 1.25
        && copied.b == -2.5
        && copied.c == 3.75
        && copied.d == -4.0
        && copied.tx == 5.5
        && copied.ty == -6.25
        && second.a == -11.0
        && second.b == 12.5
        && second.c == -13.25
        && second.d == 14.75
        && second.tx == -15.5
        && second.ty == 16.0 {
        true -> passed()
        false -> failed()
    }
    machine passed() -> i32 { 0 }
    machine failed() -> i32 { 1 }
}

machine receive(value: Transform) -> bool reaches AffineTransforms { consume(value, value) == 0 }
const A: f64 = 1.25;
const B: f64 = -2.5;
const C: f64 = 3.75;
const D: f64 = -4.0;
const TX: f64 = 5.5;
const TY: f64 = -6.25;
machine observe() -> bool reaches AffineTransforms { receive(AffineTransforms::make(A, B, C, D, TX, TY)) }

machine main() reaches AffineTransforms crashes Trap {
    transition observe() { true -> done() false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
