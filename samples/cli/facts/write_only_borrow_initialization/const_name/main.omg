// Fact: a write-only borrow (&write) initializes a destination slot to 100u64 and restores owner readability across call completion when subtracting 100u64.
// Place: const name. A named constant supplies the exact subtrahend for the initialized slot value.
// Expected exit: 0

domain u64::SlotDomain(v)
requires
    v >= 100u64 && v <= 100u64;

data BoxedSlot {
    value: u64 in SlotDomain;
}

machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 100u64;
}

const EXPECTED_VALUE: u64 = 100u64;

machine probe() -> u64
ensures
    result == 0u64 {
    let mut slot: BoxedSlot = BoxedSlot { value: 100u64 };
    initialize_slot(&write slot);
    let current: u64 = slot.value;
    current - EXPECTED_VALUE
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
