// Fact: a write-only borrow (&write) initializes a destination slot to 100u64 and restores owner readability across call completion when subtracting 100u64.
// Place: local. The initialized slot value is bound to a local variable before exact subtraction.
// Expected diagnostic: exact subtraction underflow

domain u64::SlotDomain(v)
requires
    v >= 99u64 && v <= 100u64;

data BoxedSlot {
    value: u64 in SlotDomain;
}

machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 99u64;
}

machine probe() -> u64 {
    let mut slot: BoxedSlot = BoxedSlot { value: 99u64 };
    initialize_slot(&write slot);
    let current: u64 = slot.value;
    current - 100u64
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
