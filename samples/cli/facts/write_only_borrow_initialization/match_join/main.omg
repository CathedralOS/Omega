// Fact: a write-only borrow (&write) initializes a destination slot to 100u64 and restores owner readability across call completion when subtracting 100u64.
// Place: match join. The initialized slot value is unified across both match arms before exact subtraction.
// Expected exit: 0

data BoxedSlot {
    value: u64;
}

machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 100;
}

machine main() crashes Trap {
    let mut slot: BoxedSlot = BoxedSlot { value: 0 };
    initialize_slot(&write slot);
    let condition: bool = true;
    let joined: u64 = match condition {
        true -> slot.value
        false -> slot.value
    };
    transition joined == 100 {
        true -> check(joined)
        _ -> bad()
    }
    state check(v: u64) {
        let diff: u64 = v - 100;
        transition diff == 0 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
