// Fact: a write-only borrow (&write) initializes a destination slot to 100u64 and restores owner readability across call completion when subtracting 100u64.
// Place: match join. The initialized slot value is unified across reconverging match arms before exact subtraction.
// Expected diagnostic: exact subtraction underflow

domain u64::SlotDomain(v)
requires
    v >= 99u64 && v <= 100u64;

data BoxedSlot {
    value: u64 in SlotDomain;
}

machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 99u64;
}

machine probe(flag: bool) -> u64 {
    let mut left_slot: BoxedSlot = BoxedSlot { value: 99u64 };
    let mut right_slot: BoxedSlot = BoxedSlot { value: 99u64 };
    initialize_slot(&write left_slot);
    initialize_slot(&write right_slot);
    let joined: u64 = match flag {
        true -> left_slot.value
        false -> right_slot.value
    };
    joined - 100u64
}

machine main() crashes Trap {
    let diff: u64 = probe(true);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
