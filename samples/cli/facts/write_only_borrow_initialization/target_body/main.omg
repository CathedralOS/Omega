// Fact: a write-only borrow (&write) initializes a destination slot to 100u64 and restores owner readability across call completion when subtracting 100u64.
// Place: target body. Target-scoped machine bodies execute on each hosted target.
// Expected exit: 0

data BoxedSlot {
    value: u64;
}

linux_x86_64 machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 100;
}

linux_arm64 machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 100;
}

macos_arm64 machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 100;
}

windows_x86_64 machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 100;
}

machine main() crashes Trap {
    let mut slot: BoxedSlot = BoxedSlot { value: 0 };
    initialize_slot(&write slot);
    let current: u64 = slot.value;
    transition current == 100 {
        true -> check(current)
        _ -> bad()
    }
    state check(v: u64) {
        let diff: u64 = v - 100;
        transition diff == 0 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
