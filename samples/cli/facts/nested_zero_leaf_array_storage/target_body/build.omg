use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
 builder.product = BuildProduct::Application { name: "nested_zero_leaf_array_storage" };
 Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
 Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
 Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
 Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
 Build::bind_native::<|app|::ZeroLeafProvider::make>(builder, macos_arm64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libomega_zeroleaf_fixture.dylib", symbol: "_zero_leaf_make" } });
 Build::bind_native::<|app|::ZeroLeafProvider::make>(builder, linux_x86_64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_zeroleaf_fixture.so", symbol: "zero_leaf_make", version: "ZEROLEAF_1.0" } });
 Build::bind_native::<|app|::ZeroLeafProvider::make>(builder, linux_arm64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_zeroleaf_fixture.so", symbol: "zero_leaf_make", version: "ZEROLEAF_1.0" } });
 Build::bind_native::<|app|::ZeroLeafProvider::make>(builder, windows_x86_64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_zeroleaf_fixture.dll", export: "zero_leaf_make" } });
 Build::bind_native::<|app|::ZeroLeafProvider::shift>(builder, macos_arm64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol { install_name: "libomega_zeroleaf_fixture.dylib", symbol: "_zero_leaf_shift" } });
 Build::bind_native::<|app|::ZeroLeafProvider::shift>(builder, linux_x86_64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_zeroleaf_fixture.so", symbol: "zero_leaf_shift", version: "ZEROLEAF_1.0" } });
 Build::bind_native::<|app|::ZeroLeafProvider::shift>(builder, linux_arm64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libomega_zeroleaf_fixture.so", symbol: "zero_leaf_shift", version: "ZEROLEAF_1.0" } });
 Build::bind_native::<|app|::ZeroLeafProvider::shift>(builder, windows_x86_64,
  |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "omega_zeroleaf_fixture.dll", export: "zero_leaf_shift" } });
 Build::select_provider::<|app|::Observing, |app|::ObserverCode>(builder, macos_arm64);
 Build::select_provider::<|app|::Observing, |app|::ObserverCode>(builder, linux_x86_64);
 Build::select_provider::<|app|::Observing, |app|::ObserverCode>(builder, linux_arm64);
 Build::select_provider::<|app|::Observing, |app|::ObserverCode>(builder, windows_x86_64);
}
