// Fact: 32-bit unsigned saturating subtraction lhs -| rhs with bounded interval 40u32 <= diff <= 100u32 establishes 40u32 <= diff <= 100u32 across all nine places so exact subtractions 100u32 - diff and diff - 40u32 are safe.
// Place: call result (invalid twin). The helper ensures upper bound is widened to 125u32 so diff reaches 105u32 > 100u32, failing contract for verify_diff.
// Expected diagnostic: cannot prove requires contract for call

machine verify_diff(value: u32) -> u32 requires value >= 40u32 && value <= 100u32 {
    let headroom: u32 = 100u32 - value;
    let margin: u32 = value - 40u32;
    headroom + margin
}

machine get_lhs() -> u32 ensures result >= 80 && result <= 125 {
    125u32
}

machine get_rhs() -> u32 ensures result >= 20 && result <= 40 {
    20u32
}

machine sat_call_result() -> u32 {
    let lhs: u32 = get_lhs();
    let rhs: u32 = get_rhs();
    let a: u32 in Saturating = lhs as u32 in Saturating;
    let b: u32 in Saturating = rhs as u32 in Saturating;
    let sat_diff: u32 in Saturating = a - b;
    let diff: u32 = sat_diff as u32;
    verify_diff(diff)
}

machine probe() -> u32 {
    sat_call_result()
}

machine main() crashes Trap {
    transition probe() == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
