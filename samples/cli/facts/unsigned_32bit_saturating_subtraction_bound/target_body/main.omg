// Fact: 32-bit unsigned saturating subtraction lhs -| rhs with bounded interval 40u32 <= diff <= 100u32 establishes 40u32 <= diff <= 100u32 across all nine places so exact subtractions 100u32 - diff and diff - 40u32 are safe.
// Place: another target body. Each of four target-scoped machine bodies subtracts bounded 32-bit operands with saturation and discharges interval.
// Expected exit: 0

machine verify_diff(value: u32) -> u32 requires value >= 40u32 && value <= 100u32 {
    let headroom: u32 = 100u32 - value;
    let margin: u32 = value - 40u32;
    headroom + margin
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSatTarget {
    machine sat_target(lhs: u32, rhs: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40;
}

X86SatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: u32, rhs: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: u32 in Saturating = lhs as u32 in Saturating;
        let b: u32 in Saturating = rhs as u32 in Saturating;
        let sat_diff: u32 in Saturating = a - b;
        let diff: u32 = sat_diff as u32;
        verify_diff(diff)
    }
}

ArmSatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: u32, rhs: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: u32 in Saturating = lhs as u32 in Saturating;
        let b: u32 in Saturating = rhs as u32 in Saturating;
        let sat_diff: u32 in Saturating = a - b;
        let diff: u32 = sat_diff as u32;
        verify_diff(diff)
    }
}

machine probe() -> u32 {
    SelectedSatTarget::sat_target(100u32, 30u32)
}

machine main() crashes Trap {
    transition probe() == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
