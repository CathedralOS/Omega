// Fact: 16-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u16 <= prod <= 200u16 establishes 50u16 <= prod <= 200u16 across all nine places so exact subtractions 200u16 - prod and prod - 50u16 are safe.
// Place: local. The 16-bit operands are copied into locals before saturating multiplication and interval discharge.
// Expected exit: 0

machine verify_prod(value: u16) -> u16 requires value >= 50u16 && value <= 200u16 {
    let headroom: u16 = 200u16 - value;
    let margin: u16 = value - 50u16;
    headroom + margin
}

machine sat_local(lhs: u16, rhs: u16) -> u16
requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10
{
    let local_lhs: u16 = lhs;
    let local_rhs: u16 = rhs;
    let a: u16 in Saturating = local_lhs as u16 in Saturating;
    let b: u16 in Saturating = local_rhs as u16 in Saturating;
    let sat_prod: u16 in Saturating = a * b;
    let prod: u16 = sat_prod as u16;
    verify_prod(prod)
}

machine probe() -> u16 {
    sat_local(15u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
