// Fact: 16-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u16 <= prod <= 200u16 establishes 50u16 <= prod <= 200u16 across all nine places so exact subtractions 200u16 - prod and prod - 50u16 are safe.
// Place: field. The 16-bit operands are stored in record fields before saturating multiplication and interval discharge.
// Expected exit: 0

machine verify_prod(value: u16) -> u16 requires value >= 50u16 && value <= 200u16 {
    let headroom: u16 = 200u16 - value;
    let margin: u16 = value - 50u16;
    headroom + margin
}

data SatPacket {
    lhs: u16;
    rhs: u16;
}

machine sat_field(packet: SatPacket) -> u16
requires packet.lhs >= 10 && packet.lhs <= 20 && packet.rhs >= 5 && packet.rhs <= 10
{
    let a: u16 in Saturating = packet.lhs as u16 in Saturating;
    let b: u16 in Saturating = packet.rhs as u16 in Saturating;
    let sat_prod: u16 in Saturating = a * b;
    let prod: u16 = sat_prod as u16;
    verify_prod(prod)
}

machine probe() -> u16 {
    let packet: SatPacket = SatPacket { lhs: 15u16, rhs: 8u16 };
    sat_field(packet)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
