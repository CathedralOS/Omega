// Fact: 16-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u16 <= prod <= 200u16 establishes 50u16 <= prod <= 200u16 across all nine places so exact subtractions 200u16 - prod and prod - 50u16 are safe.
// Place: match join (invalid twin). The match arm upper bound is widened to 21u16 so prod reaches 210u16 > 200u16, failing contract for verify_prod.
// Expected diagnostic: cannot prove requires contract for call

machine verify_prod(value: u16) -> u16 requires value >= 50u16 && value <= 200u16 {
    let headroom: u16 = 200u16 - value;
    let margin: u16 = value - 50u16;
    headroom + margin
}

machine choose_lhs(flag: bool) -> u16
ensures result >= 10 && result <= 21
{
    match flag {
        true -> 21u16,
        false -> 12u16,
    }
}

machine sat_match_join(rhs: u16) -> u16
requires rhs >= 5 && rhs <= 10
{
    let lhs: u16 = choose_lhs(true);
    let a: u16 in Saturating = lhs as u16 in Saturating;
    let b: u16 in Saturating = rhs as u16 in Saturating;
    let sat_prod: u16 in Saturating = a * b;
    let prod: u16 = sat_prod as u16;
    verify_prod(prod)
}

machine probe() -> u16 {
    sat_match_join(10u16)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
