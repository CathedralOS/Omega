// A named constant supplies the open-Const length of a callable family, and the
// selected callback measures that exact length.
// Place: target_body.
// Expected exit: 0
const FOUR: u64 = 4;
const TWO: u64 = 2;

machine measure<'borrow, const Length: u64>(value: &'borrow [u8; Length]) -> u64 { Length }

machine apply<const Count: u64, machine Callback>(value: &[u8; Count]) -> u64
requires machine Callback(value: &[u8; Count]) -> u64;
{ Callback(value) }

machine hold(first: u64, second: u64) -> bool
requires first == 4
requires second == 2
{
    true
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserve {
    machine observe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Observe satisfies SelectedObserve {
    machine observe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let four: [u8; 4] = [1u8, 2u8, 3u8, 4u8];
        let two: [u8; 2] = [5u8, 6u8];
        let first: u64 = apply<FOUR, measure>(&four);
        let second: u64 = apply<TWO, measure>(&two);
        hold(first, second) && first == 4 && second == 2
    }
}

ArmObserve satisfies SelectedObserve {
    machine observe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let four: [u8; 4] = [1u8, 2u8, 3u8, 4u8];
        let two: [u8; 2] = [5u8, 6u8];
        let first: u64 = apply<FOUR, measure>(&four);
        let second: u64 = apply<TWO, measure>(&two);
        hold(first, second) && first == 4 && second == 2
    }
}

machine main() crashes Trap {
    transition SelectedObserve::observe() {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
