// A named constant supplies the open-Const length of a callable family, and the
// selected callback measures that exact length.
// Production: forwarded_family. A second family forwards its open Const and callback to the first.
// Expected exit: 0
const FOUR: u64 = 5;
const TWO: u64 = 2;

machine measure<'borrow, const Length: u64>(value: &'borrow [u8; Length]) -> u64 { Length }

machine apply<const Count: u64, machine Callback>(value: &[u8; Count]) -> u64
requires machine Callback(value: &[u8; Count]) -> u64;
{ Callback(value) }

machine hold(first: u64, second: u64) -> bool
requires first == 4
requires second == 2
{
    true
}

machine apply_again<const Total: u64, machine Inner>(value: &[u8; Total]) -> u64
requires machine Inner(value: &[u8; Total]) -> u64;
{ apply<Total, Inner>(value) }

machine main() crashes Trap {
    let four: [u8; 4] = [1u8, 2u8, 3u8, 4u8];
    let two: [u8; 2] = [5u8, 6u8];
    let first: u64 = apply_again<FOUR, measure>(&four);
    let second: u64 = apply_again<TWO, measure>(&two);
    transition hold(first, second) && first == 4 && second == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
