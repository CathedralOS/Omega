// Fact: an 8-bit signed i8 exact multiplication of bounded inputs (lhs >= 5i8 && lhs <= 10i8, rhs >= 6i8 && rhs <= 10i8) establishes prod >= 30i8 && prod <= 100i8 so exact 8-bit signed subtraction 100i8 - prod is proved overflow-free across all nine places.
// Place: target_body. Each hosted target body computes the 8-bit signed exact multiplication and verifies the bounds.
// Expected exit: 0
machine verify_prod(prod: i8) -> i32
    requires prod >= 30 && prod <= 100
{
    let headroom: i8 = 100 - prod;
    (headroom - 28) as i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(lhs: i8, rhs: i8) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 5 && lhs <= 10 && rhs >= 6 && rhs <= 11;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(lhs: i8, rhs: i8) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 5 && lhs <= 10 && rhs >= 6 && rhs <= 11
    {
        SelectedBodyCheck::require_tag(17u64);
        let prod: i8 = lhs * rhs;
        verify_prod(prod)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(lhs: i8, rhs: i8) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 5 && lhs <= 10 && rhs >= 6 && rhs <= 11
    {
        SelectedBodyCheck::require_tag(29u64);
        let prod: i8 = lhs * rhs;
        verify_prod(prod)
    }
}









machine evaluate() -> i32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(8, 9)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
