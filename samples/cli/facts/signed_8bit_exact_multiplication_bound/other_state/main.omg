// Fact: an 8-bit signed i8 exact multiplication of bounded inputs (lhs >= 5i8 && lhs <= 10i8, rhs >= 6i8 && rhs <= 10i8) establishes prod >= 30i8 && prod <= 100i8 so exact 8-bit signed subtraction 100i8 - prod is proved overflow-free across all nine places.
// Place: other_state. A state transition forwards the product result to a successor state.
// Expected exit: 0
machine verify_prod(prod: i8) -> i32
    requires prod >= 30 && prod <= 100
{
    let headroom: i8 = 100 - prod;
    (headroom - 28) as i32
}

machine compute_other_state(lhs: i8, rhs: i8) -> i32
    requires lhs >= 5 && lhs <= 10 && rhs >= 6 && rhs <= 10
{
    let prod: i8 = lhs * rhs;
    transition { _ -> step(prod) }
    machine step(p: i8) -> i32 {
        verify_prod(p)
    }
}

machine evaluate() -> i32 {
    compute_other_state(8, 9)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
