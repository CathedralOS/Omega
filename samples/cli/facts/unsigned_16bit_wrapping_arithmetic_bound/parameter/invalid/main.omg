// Fact: 16-bit unsigned wrapping addition lhs +% rhs with bounded interval 350u16 <= sum <= 600u16 establishes 350u16 <= sum <= 600u16 across all nine places so exact subtractions 600u16 - sum and sum - 350u16 are safe.
// Invalid: parameter upper bound 601 allows underflow in 600u16 - sum. Place: parameter.
// Expected diagnostic: may overflow `u16`

machine verify_parameter(sum: u16) -> i32
requires sum >= 350u16 && sum <= 601u16
{
    let headroom: u16 = 600u16 - sum;
    let margin: u16 = sum - 350u16;
    0i32
}

machine compute_param(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 501u16 && rhs >= 50u16 && rhs <= 100u16
{
    let w_lhs: u16 in Wrapping = lhs as u16 in Wrapping;
    let w_rhs: u16 in Wrapping = rhs as u16 in Wrapping;
    let sum_wrap: u16 in Wrapping = w_lhs + w_rhs;
    verify_parameter(sum_wrap as u16)
}

machine probe() -> i32 {
    compute_param(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
