// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark terminates;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
machine checked_mark() -> u64 terminates { Mark::read() }
machine first(count: u64) -> u64
terminates by count
{
    transition count > 0 { true -> second(count - 1) false -> checked_mark() }
}
machine second(count: u64) -> u64 terminates by count {
    transition count > 0 { true -> first(count - 1) false -> checked_mark() }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedReadMark {
    machine read_mark() -> u64
        reaches Mark, SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86ReadMark satisfies SelectedReadMark {
    machine read_mark() -> u64 {
        SelectedBodyCheck::require_tag(17u64);
        first(2)
    }
}
ArmReadMark satisfies SelectedReadMark {
    machine read_mark() -> u64 {
        SelectedBodyCheck::require_tag(29u64);
        first(2)
    }
}
machine main() crashes Trap {
    transition SelectedReadMark::read_mark() == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
