// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
public boundary trait Unused {}
public trait ReadContract { machine read() -> u64 reaches Mark + Unused invokes Mark; }
public machine read_service() -> u64 satisfies ReadContract::read reaches Mark + Unused invokes Mark; { Mark::read() }
machine call_mark<machine Read>() -> u64
where machine Read satisfies ReadContract::read;
{ Read() }

machine main() reaches Mark crashes Trap {
    let value: u64 = call_mark<read_service>();
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
