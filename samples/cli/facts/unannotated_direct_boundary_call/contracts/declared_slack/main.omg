// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark { machine read() -> u64 reaches Mark; }
public boundary trait Unused {}
MarkerMark satisfies Mark { machine read() -> u64 { 7 } }
public machine read_mark() -> u64 reaches Mark + Unused invokes Mark; { Mark::read() }
machine main() reaches Mark + Unused crashes Trap {
    let value: u64 = read_mark();
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
