// Expected exit: 0
public boundary trait Mark { machine read() -> u64 reaches Mark; }
public boundary trait Forbidden { machine read() -> u64 reaches Forbidden; }
public boundary trait Unused {}
MarkerMark satisfies Mark { machine read() -> u64 { 7 } }
ForbiddenMark satisfies Forbidden { machine read() -> u64 { 7 } }
boundary trait SelectedReadMark {
    machine read_mark() -> u64 reaches
;
}
MacosArm64ReadMark satisfies SelectedReadMark {
    machine read_mark() -> u64
{ Mark::read() }
}
WindowsX8664ReadMark satisfies SelectedReadMark {
    machine read_mark() -> u64
{ Forbidden::read() }
}


machine main() reaches Mark crashes Trap {
    let value: u64 = SelectedReadMark::read_mark();
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
