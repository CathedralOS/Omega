machine build(builder: &mut Build) {
    Build::select_provider<SelectedReadMark, MacosArm64ReadMark>(builder, macos_arm64);
    Build::select_provider<SelectedReadMark, WindowsX8664ReadMark>(builder, windows_x86_64);
    Build::select_provider<SelectedReadMark, MacosArm64ReadMark>(builder, linux_x86_64);
    Build::select_provider<SelectedReadMark, MacosArm64ReadMark>(builder, linux_arm64);

    Build::application(builder, "reach_target_union");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
