// An unannotated direct call of Mark::read returns 7.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
machine main() reaches crashes Trap {
    let value: u64 = Mark::read();
    transition value == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
