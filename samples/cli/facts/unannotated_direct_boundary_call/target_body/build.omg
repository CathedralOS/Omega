use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "unannotated_direct_boundary_call_through_target_body" };
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::x86_entry);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedReadMark, |app|::X86ReadMark>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedReadMark, |app|::ArmReadMark>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedReadMark, |app|::X86ReadMark>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedReadMark, |app|::ArmReadMark>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedReadMark, |app|::X86ReadMark>(builder, windows_x86_64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, macos_x86_64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, macos_arm64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, linux_x86_64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, linux_arm64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, windows_x86_64);
}
