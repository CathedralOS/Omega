machine build(builder: &mut Build) {
    Build::application(builder, "unannotated_direct_boundary_call_through_target_body_invalid");
    Build::bind(builder, macos_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider<SelectedReadMark, X86ReadMark>(builder, macos_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedReadMark, ArmReadMark>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedReadMark, X86ReadMark>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedReadMark, ArmReadMark>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedReadMark, X86ReadMark>(builder, windows_x86_64);
    Build::select_provider<Mark, MarkerMark>(builder, macos_x86_64);
    Build::select_provider<Mark, MarkerMark>(builder, macos_arm64);
    Build::select_provider<Mark, MarkerMark>(builder, linux_x86_64);
    Build::select_provider<Mark, MarkerMark>(builder, linux_arm64);
    Build::select_provider<Mark, MarkerMark>(builder, windows_x86_64);
}
