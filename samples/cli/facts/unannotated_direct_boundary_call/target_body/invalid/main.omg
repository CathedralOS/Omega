// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
linux_x86_64 machine read_mark() -> u64 reaches {
    Mark::read()
}
linux_arm64 machine read_mark() -> u64 reaches {
    Mark::read()
}
macos_arm64 machine read_mark() -> u64 reaches {
    Mark::read()
}
windows_x86_64 machine read_mark() -> u64 reaches {
    Mark::read()
}
machine main() crashes Trap {
    transition read_mark() == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
