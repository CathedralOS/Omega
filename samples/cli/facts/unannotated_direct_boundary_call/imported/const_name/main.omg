// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
const MARK_VALUE: u64 = 7;
use support::values;
MarkerMark satisfies Mark { machine read() -> u64 { MARK_VALUE } }
machine main() crashes Trap {
    let value: u64 = fetch_mark();
    transition value == MARK_VALUE { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
