// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
public machine read_service() -> u64 invokes Mark; { Mark::read() }
machine call_mark() -> u64 { read_service() }

machine take(flag: bool) -> u64 reaches {
    match flag { true -> call_mark(), false -> call_mark() }
}
machine main() crashes Trap {
    transition take(true) == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
