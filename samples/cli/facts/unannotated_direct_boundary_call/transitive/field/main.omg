// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
public machine read_service() -> u64 invokes Mark; { Mark::read() }
machine call_mark() -> u64 { read_service() }

data Hold { value: u64; }
machine main() crashes Trap {
    let hold: Hold = Hold { value: call_mark() };
    transition hold.value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
