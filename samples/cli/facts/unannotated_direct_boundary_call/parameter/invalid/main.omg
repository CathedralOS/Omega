// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
machine accept(value: u64) crashes Trap {
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() reaches crashes Trap {
    accept(Mark::read());
}
