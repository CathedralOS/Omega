// An unannotated direct call of Mark::read returns 7.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
data Hold { value: u64; }
machine main() crashes Trap {
    let hold: Hold = Hold { value: Mark::read() };
    transition hold.value == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
