// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
public trait ReadContract { machine read() -> u64 reaches Mark invokes Mark; }
public machine read_service() -> u64 satisfies ReadContract::read invokes Mark { Mark::read() }
machine call_mark<machine Read>() -> u64
requires machine Read satisfies ReadContract::read;
{ Read() }

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedReadMark {
    machine read_mark() -> u64
        reaches Mark, SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86ReadMark satisfies SelectedReadMark {
    machine read_mark() -> u64 reaches {
        SelectedBodyCheck::require_tag(17u64);
        call_mark<read_service>()
    }
}
ArmReadMark satisfies SelectedReadMark {
    machine read_mark() -> u64 reaches {
        SelectedBodyCheck::require_tag(29u64);
        call_mark<read_service>()
    }
}
machine main() crashes Trap {
    transition SelectedReadMark::read_mark() == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
