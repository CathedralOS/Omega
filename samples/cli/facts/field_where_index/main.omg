// A data `where` roster carries standing field facts.
// `0 <= k, k <= 3` holds for every `Main` value, so `arr[k + 1]` into an array
// of length 5 compiles with no guard.
//
// Expected exit: 0

data Main where 0 <= k, k <= 3 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine read(main: &Main) -> i32 in Wrapping {
    let index: u64 = main.k;
    main.arr[index + 1]
}

machine Main::main(main: &mut Main) crashes Trap {
    main.arr = [10, 20, 30, 40, 50];
    main.k = 2;
    let first: i32 in Wrapping = read(main);
    transition { _ -> successor(main, first) }
    machine successor(main: &mut Main, first: i32 in Wrapping) {
        main.k = 3;
        let second: i32 in Wrapping = read(main);
        transition first == 40 && second == 50 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
