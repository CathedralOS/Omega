// Every target body indexes through the standing field fact
// `k <= 3`, so `main.arr[main.k + 1]` compiles with no guard.
//
// Reject control: k <= 4 allows index + 1 == 5 out of bounds for length 5.

data Main where 0 <= k, k <= 4 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReadTarget {
    machine read_target(main: &Main) -> i32 in Wrapping
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86ReadTarget satisfies SelectedReadTarget {
    machine read_target(main: &Main) -> i32 in Wrapping
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        main.arr[main.k + 1]
    }
}

ArmReadTarget satisfies SelectedReadTarget {
    machine read_target(main: &Main) -> i32 in Wrapping
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        main.arr[main.k + 1]
    }
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = SelectedReadTarget::read_target(main);
    transition { _ -> successor(main) }
    machine successor(main: &mut Main) {
        main.r = SelectedReadTarget::read_target(main);
        main.hits = main.r;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    entry_start();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    entry_start();
}
