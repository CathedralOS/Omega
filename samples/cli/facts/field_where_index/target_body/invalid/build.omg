machine build(builder: &mut Build) {
    Build::select_provider<SelectedReadTarget, CheckedReadTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedReadTarget, CheckedReadTarget>(builder, linux_arm64);
    Build::select_provider<SelectedReadTarget, CheckedReadTarget>(builder, macos_arm64);
    Build::select_provider<SelectedReadTarget, CheckedReadTarget>(builder, windows_x86_64);

    Build::application(builder, "field_where_index_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
