// A match join of two copies of the standing field still discharges
// `arr[index + 1]`. Both arms carry `k <= 3`, so the joined local does.
//
// Reject control: k <= 4 allows index + 1 == 5 out of bounds for length 5.

data Main where 0 <= k, k <= 4 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine joined(main: &Main, flag: bool) -> i32 in Wrapping {
    let index: u64 = match flag { true -> main.k, false -> main.k };
    main.arr[index + 1]
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = joined(main, true);
    transition { _ -> successor(main) }
    machine successor(main: &mut Main) {
        main.r = joined(main, true);
        main.hits = main.r;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
