// A const name of the standing ceiling still discharges
// `arr[main.k + 1]`. `k <= LIMIT` is the where roster; `LIMIT` is 3.
//
// Reject control: k <= 4 allows index + 1 == 5 out of bounds for length 5.

const LIMIT: u64 = 4;

data Main where 0 <= k, k <= LIMIT {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine read(main: &Main) -> i32 in Wrapping {
    main.arr[main.k + 1]
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = read(main);
    transition { _ -> successor(main) }
    state successor(main: &mut Main) {
        main.r = read(main);
        main.hits = main.r;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
