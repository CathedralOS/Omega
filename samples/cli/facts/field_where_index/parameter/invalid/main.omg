// The standing field fact passed as a parameter still discharges
// `arr[index + 1]`. `use` proves `read_at`'s requires from `main.k`
// with no guard.
//
// Reject control: k <= 4 allows index + 1 == 5 out of bounds for length 5.

data Main where 0 <= k, k <= 4 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine read_at(main: &Main, index: u64) -> i32 in Wrapping
requires 0 <= index && index <= 4
{
    main.arr[index + 1]
}

machine use(main: &Main) -> i32 in Wrapping {
    read_at(main, main.k)
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = use(main);
    transition { _ -> successor(main) }
    machine successor(main: &mut Main) {
        main.r = use(main);
        main.hits = main.r;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
