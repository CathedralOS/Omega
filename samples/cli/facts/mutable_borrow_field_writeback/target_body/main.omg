// Updating a record field through an exclusive mutable borrow (&mut Counter) and retiring the loan establishes the updated field bound (counter.used <= 80u64) while preserving unrelated fields, discharging exact subtraction 80u64 - counter.used.
// Expected exit: 0.
data Counter [copy] where used <= 80u64 {
    used: u64;
    limit: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedCompute {
    machine compute(c: Counter) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Compute satisfies SelectedCompute {
    machine compute(c: Counter) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        80u64 - c.used
    }
}

ArmCompute satisfies SelectedCompute {
    machine compute(c: Counter) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        80u64 - c.used
    }
}

machine main() crashes Trap {
    let mut c: Counter = Counter { used: 0u64, limit: 80u64 };
    let r: &mut Counter = &mut c;
    r.used = 50u64;
    let diff: u64 = SelectedCompute::compute(c);
    transition diff == 30u64 && c.limit == 80u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
