// Updating a record field through an exclusive mutable borrow (&mut Counter) and retiring the loan establishes the updated field bound (counter.used <= 80u64) while preserving unrelated fields, discharging exact subtraction 80u64 - counter.used.
// Expected exit: 0.
data Counter [copy] where used <= 80u64 {
    used: u64;
    limit: u64;
}

machine main() crashes Trap {
    let mut c: Counter = Counter { used: 0u64, limit: 80u64 };
    let r: &mut Counter = &mut c;
    r.used = 50u64;
    transition { _ -> evaluate(c) }
    machine evaluate(c: Counter) {
        let diff: u64 = 80u64 - c.used;
        transition diff == 30u64 && c.limit == 80u64 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
