// Updating a record field through an exclusive mutable borrow (&mutable Counter) and retiring the loan establishes the updated field bound (counter.used <= 80u64) while preserving unrelated fields, discharging exact subtraction 80u64 - counter.used.
// Expected exit: 0.
data Counter [copy] requires used <= 80u64 {
    used: u64;
    limit: u64;
}

machine choose(flag: bool) -> Counter {
    let mutable c1: Counter = Counter { used: 0u64, limit: 80u64 };
    let r1: @mutable Counter = @mutable c1;
    r1.used = 50u64;
    let mutable c2: Counter = Counter { used: 0u64, limit: 80u64 };
    let r2: @mutable Counter = @mutable c2;
    r2.used = 50u64;
    match flag {
        true -> c1,
        false -> c2,
    }
}

machine main() crashes Trap {
    let c: Counter = choose(true);
    let diff: u64 = 80u64 - c.used;
    transition diff == 30u64 && c.limit == 80u64 {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
