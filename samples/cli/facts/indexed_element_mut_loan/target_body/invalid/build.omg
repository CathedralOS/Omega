machine build(builder: &mut Build) {
    Build::select_provider<SelectedApply, CheckedApply>(builder, linux_x86_64);
    Build::select_provider<SelectedApply, CheckedApply>(builder, linux_arm64);
    Build::select_provider<SelectedApply, CheckedApply>(builder, macos_arm64);
    Build::select_provider<SelectedApply, CheckedApply>(builder, windows_x86_64);

    Build::package(builder, "indexed_element_mut_loan_held");
}
