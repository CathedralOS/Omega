// Fact: an 8-bit unsigned u8 exact multiplication of bounded inputs (lhs >= 10u8 && lhs <= 15u8, rhs >= 8u8 && rhs <= 12u8) establishes prod >= 80u8 && prod <= 180u8 so exact 8-bit subtractions 180u8 - prod and prod - 80u8 are proved overflow-free across all nine places.

machine choose(flag: bool, first: u8, second: u8) -> u8
    requires first >= 80u8 && first <= 180u8 && second >= 80u8 && second <= 180u8
    ensures result >= 80u8 && result <= 180u8
{
    transition flag {
        true -> first
        false -> second
    }
}

machine probe(flag: bool, lhs: u8, rhs: u8) -> u8
    requires lhs >= 10u8 && lhs <= 15u8 && rhs >= 8u8 && rhs <= 13u8
{
    let prod: u8 = lhs * rhs;
    let joined: u8 = choose(flag, prod, 120u8);
    let headroom: u8 = 180u8 - joined;
    let margin: u8 = joined - 80u8;
    headroom + margin
}

machine main() crashes Trap {
    let combined: u8 = probe(true, 12u8, 10u8);
    transition combined == 100u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
