// Fact: a four-word structural aggregate returned and passed by value preserves field refinement bounds summing to 100u64 across indirect return homes when subtracting 100u64.
// Place: another target body (invalid twin).
// Expected diagnostic: exact subtraction underflow

data Quartet [copy] where
    first >= 10u64 && first <= 10u64,
    second >= 20u64 && second <= 20u64,
    third >= 30u64 && third <= 30u64,
    fourth >= 39u64 && fourth <= 39u64
{
    first: u64;
    second: u64;
    third: u64;
    fourth: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedMakeQuartet {
    machine make_quartet() -> Quartet
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86MakeQuartet satisfies SelectedMakeQuartet {
    machine make_quartet() -> Quartet
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        Quartet {
            first: 10,
            second: 20,
            third: 30,
            fourth: 39,
        }
    }
}

ArmMakeQuartet satisfies SelectedMakeQuartet {
    machine make_quartet() -> Quartet
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        Quartet {
            first: 10,
            second: 20,
            third: 30,
            fourth: 39,
        }
    }
}

machine probe() -> u64 {
    let q: Quartet = SelectedMakeQuartet::make_quartet();
    let total: u64 = q.first + q.second + q.third + q.fourth;
    total - 100
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
