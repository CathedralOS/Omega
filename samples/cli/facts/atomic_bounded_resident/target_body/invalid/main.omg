// Expected exit: 0.
// A shared atomic store preserves its resident bound and ordering, and a load carries that bound into Exact subtraction.
use omega::language::core::atomic;
data Cell requires value <= 100 { value: AtomicU32; }
machine publish(cell: &Cell, value: u32) requires value <= 101 { cell.value.store(value, Publish); }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserve {
    machine observe(cell: &Cell) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 100;
}

X86Observe satisfies SelectedObserve {
    machine observe(cell: &Cell) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
     cell.value.load(Receive) 
    }
}

ArmObserve satisfies SelectedObserve {
    machine observe(cell: &Cell) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
     cell.value.load(Receive) 
    }
}


machine main() crashes Trap {
    let cell: Cell;
    publish(&cell, 41);
    Atomic::fence(FenceOrdering::Receive);
    let observed: u32 = SelectedObserve::observe(&cell);
    let remaining: u32 = 100 - observed;
    transition remaining == 59 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
