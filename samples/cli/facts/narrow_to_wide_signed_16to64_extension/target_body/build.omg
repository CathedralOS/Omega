machine build(builder: &mut Build) {
    Build::select_provider<SelectedExtTarget, CheckedExtTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedExtTarget, CheckedExtTarget>(builder, linux_arm64);
    Build::select_provider<SelectedExtTarget, CheckedExtTarget>(builder, macos_arm64);
    Build::select_provider<SelectedExtTarget, CheckedExtTarget>(builder, windows_x86_64);

    Build::application(builder, "narrow_to_wide_signed_16to64_extension_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
