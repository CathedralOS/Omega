// Fact: matching a 19-variant tagged enum payload NineteenChoice { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64), V12(u64), V13(u64), V14(u64), V15(u64), V16(u64), V17(u64), V18(u64), V19(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.

data NineteenChoice [copy] {
    case V1(v: u64) where v >= 40u64 && v <= 80u64;
    case V2(v: u64) where v >= 40u64 && v <= 80u64;
    case V3(v: u64) where v >= 40u64 && v <= 80u64;
    case V4(v: u64) where v >= 40u64 && v <= 80u64;
    case V5(v: u64) where v >= 40u64 && v <= 80u64;
    case V6(v: u64) where v >= 40u64 && v <= 80u64;
    case V7(v: u64) where v >= 40u64 && v <= 80u64;
    case V8(v: u64) where v >= 40u64 && v <= 80u64;
    case V9(v: u64) where v >= 40u64 && v <= 80u64;
    case V10(v: u64) where v >= 40u64 && v <= 80u64;
    case V11(v: u64) where v >= 40u64 && v <= 80u64;
    case V12(v: u64) where v >= 40u64 && v <= 80u64;
    case V13(v: u64) where v >= 40u64 && v <= 80u64;
    case V14(v: u64) where v >= 40u64 && v <= 80u64;
    case V15(v: u64) where v >= 40u64 && v <= 80u64;
    case V16(v: u64) where v >= 40u64 && v <= 80u64;
    case V17(v: u64) where v >= 40u64 && v <= 80u64;
    case V18(v: u64) where v >= 40u64 && v <= 80u64;
    case V19(v: u64) where v >= 39u64 && v <= 80u64;
}

machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine extract(choice: NineteenChoice) -> u64 {
    transition choice {
        NineteenChoice::V1 { v } -> v
        NineteenChoice::V2 { v } -> v
        NineteenChoice::V3 { v } -> v
        NineteenChoice::V4 { v } -> v
        NineteenChoice::V5 { v } -> v
        NineteenChoice::V6 { v } -> v
        NineteenChoice::V7 { v } -> v
        NineteenChoice::V8 { v } -> v
        NineteenChoice::V9 { v } -> v
        NineteenChoice::V10 { v } -> v
        NineteenChoice::V11 { v } -> v
        NineteenChoice::V12 { v } -> v
        NineteenChoice::V13 { v } -> v
        NineteenChoice::V14 { v } -> v
        NineteenChoice::V15 { v } -> v
        NineteenChoice::V16 { v } -> v
        NineteenChoice::V17 { v } -> v
        NineteenChoice::V18 { v } -> v
        NineteenChoice::V19 { v } -> v
    }
}

machine probe(choice: NineteenChoice) -> u64 {
    let res: u64 = extract(choice);
    let local_res: u64 = res;
    verify_payload(local_res)
}

machine main() crashes Trap {
    let p: NineteenChoice = NineteenChoice::V19 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
