// Fact: Selected representation agreement preserves every semantic field through its exact fallible maps and rejects malformed frames.
// Expected exit: 0
use omega::language::core::Result;
use omega::language::core::TryFrom;
use omega::language::core::convert;
use omega::language::core::Representation;
use omega::language::core::RepresentationDecodeRequest;
use omega::language::core::RepresentationDecoding;
use omega::language::core::RepresentationEncoding;
use omega::language::core::RepresentationModel;
use omega::language::core::RepresentationRequest;

data Pair [copy] { first: u8; last: u8; }
data FirstFrame [copy] { tag: u8; first: u8; last: u8; }
data SecondFrame [copy] { tag: u8; first: u8; last: u8; }
data Failure [copy] { case InvalidTag; }

// A transparent mathematical wrapper carries the same exact identity value.
let same_result<u: core::Level, A: core::Type<u>>(left: A, right: A): core::Type<u> = core::Identity<A>(left, right);

// This refinement describes only the selected value maps used in this law.
// Base TryFrom remains available to resource-backed and effectful conversions.
trait ValueConversion<Source, Destination, Error> = TryFrom<Source, Destination, Error> {
    machine * reaches suspends false blocks false terminates;
}
trait FrameValidity<Frame> {
    machine valid(frame: Frame) -> bool reaches terminates;
}
trait PairAgreement<Frame,
    Encode satisfies ValueConversion<Pair, Frame, Failure>,
    Decode satisfies ValueConversion<Frame, Pair, Failure>,
    Validity satisfies FrameValidity<Frame>>
{
    machine encode_covers(value: Pair) reaches terminates
    ensures Encode::try_from(value) in Result::Ok;
    machine encode_valid(value: Pair, frame: Frame) reaches terminates
    requires core::Identity<Result<Frame, Failure>>(Encode::try_from(value), Result::Ok { value: frame })
    ensures Validity::valid(frame);
    machine decode_covers(frame: Frame) reaches terminates
    requires Validity::valid(frame)
    ensures Decode::try_from(frame) in Result::Ok;
    machine decode_rejects(frame: Frame) reaches terminates
    requires !Validity::valid(frame)
    ensures core::Identity<Result<Pair, Failure>>(Decode::try_from(frame), Result::Err { error: Failure::InvalidTag });
    machine round_trip(value: Pair, frame: Frame) reaches terminates
    requires core::Identity<Result<Frame, Failure>>(Encode::try_from(value), Result::Ok { value: frame })
    ensures core::Identity<Result<Pair, Failure>>(Decode::try_from(frame), Result::Ok { value: value });
}

WriteFirst satisfies TryFrom<Pair, FirstFrame, Failure> {
    machine try_from(source: Pair) -> Result<FirstFrame, Failure> reaches terminates {
        Result::Ok { value: FirstFrame { tag: 165u8, first: source.first, last: source.last } }
    }
}
ReadFirst satisfies TryFrom<FirstFrame, Pair, Failure> {
    machine try_from(source: FirstFrame) -> Result<Pair, Failure> reaches terminates {
        transition source.tag == 165u8 {
            true -> Result::Ok { value: Pair { first: source.first, last: source.last } }
            false -> Result::Err { error: Failure::InvalidTag }
        }
    }
}
FirstValidity satisfies FrameValidity<FirstFrame> {
    machine valid(frame: FirstFrame) -> bool reaches terminates { frame.tag == 165u8 }
}
WriteSecond satisfies TryFrom<Pair, SecondFrame, Failure> {
    machine try_from(source: Pair) -> Result<SecondFrame, Failure> reaches terminates {
        Result::Ok { value: SecondFrame { tag: 90u8, first: source.last, last: source.first } }
    }
}
ReadSecond satisfies TryFrom<SecondFrame, Pair, Failure> {
    machine try_from(source: SecondFrame) -> Result<Pair, Failure> reaches terminates {
        transition source.tag == 90u8 {
            true -> Result::Ok { value: Pair { first: source.last, last: source.first } }
            false -> Result::Err { error: Failure::InvalidTag }
        }
    }
}
SecondValidity satisfies FrameValidity<SecondFrame> {
    machine valid(frame: SecondFrame) -> bool reaches terminates { frame.tag == 90u8 }
}

FirstAgreement satisfies PairAgreement<FirstFrame, WriteFirst, ReadFirst, FirstValidity> {
    machine encode_covers(value: Pair) reaches terminates
    ensures WriteFirst::try_from(value) in Result::Ok { }
    machine encode_valid(value: Pair, frame: FirstFrame) reaches terminates
    requires core::Identity<Result<FirstFrame, Failure>>(WriteFirst::try_from(value), Result::Ok { value: frame })
    ensures FirstValidity::valid(frame) { }
    machine decode_covers(frame: FirstFrame) reaches terminates
    requires FirstValidity::valid(frame)
    ensures ReadFirst::try_from(frame) in Result::Ok { }
    machine decode_rejects(frame: FirstFrame) reaches terminates
    requires !FirstValidity::valid(frame)
    ensures core::Identity<Result<Pair, Failure>>(ReadFirst::try_from(frame), Result::Err { error: Failure::InvalidTag }) { }
    machine round_trip(value: Pair, frame: FirstFrame) reaches terminates
    requires core::Identity<Result<FirstFrame, Failure>>(WriteFirst::try_from(value), Result::Ok { value: frame })
    ensures core::Identity<Result<Pair, Failure>>(ReadFirst::try_from(frame), Result::Ok { value: value }) { }
}
SecondAgreement satisfies PairAgreement<SecondFrame, WriteSecond, ReadSecond, SecondValidity> {
    machine encode_covers(value: Pair) reaches terminates
    ensures WriteSecond::try_from(value) in Result::Ok { }
    machine encode_valid(value: Pair, frame: SecondFrame) reaches terminates
    requires core::Identity<Result<SecondFrame, Failure>>(WriteSecond::try_from(value), Result::Ok { value: frame })
    ensures SecondValidity::valid(frame) { }
    machine decode_covers(frame: SecondFrame) reaches terminates
    requires SecondValidity::valid(frame)
    ensures ReadSecond::try_from(frame) in Result::Ok { }
    machine decode_rejects(frame: SecondFrame) reaches terminates
    requires !SecondValidity::valid(frame)
    ensures core::Identity<Result<Pair, Failure>>(ReadSecond::try_from(frame), Result::Err { error: Failure::InvalidTag }) { }
    machine round_trip(value: Pair, frame: SecondFrame) reaches terminates
    requires core::Identity<Result<SecondFrame, Failure>>(WriteSecond::try_from(value), Result::Ok { value: frame })
    ensures core::Identity<Result<Pair, Failure>>(ReadSecond::try_from(frame), Result::Ok { value: value }) { }
}

machine require_round_trip<Frame,
    Encode satisfies ValueConversion<Pair, Frame, Failure>,
    Decode satisfies ValueConversion<Frame, Pair, Failure>>
    (value: Pair, frame: Frame)
requires same_result<Result<Pair, Failure>>(Decode::try_from(frame), Result::Ok { value: value })
{ }

machine use_agreement<Frame,
    Encode satisfies ValueConversion<Pair, Frame, Failure>,
    Decode satisfies ValueConversion<Frame, Pair, Failure>,
    Validity satisfies FrameValidity<Frame>,
    Agreement satisfies PairAgreement<Frame, Encode, Decode, Validity>>
    (value: Pair, frame: Frame, malformed: Frame)
requires core::Identity<Result<Frame, Failure>>(Encode::try_from(value), Result::Ok { value: frame })
requires !Validity::valid(malformed)
{
    Agreement::encode_covers(value);
    Agreement::encode_valid(value, frame);
    Agreement::decode_covers(frame);
    Agreement::decode_rejects(malformed);
    Agreement::round_trip(value, frame);
    require_round_trip<Frame, Encode, Decode>(value, frame);
}

// Runtime observation deliberately receives only the ordinary fallible maps,
// so the agreement theorem is not a premise of its executable verdict.
machine observe<Frame,
    Encode satisfies TryFrom<Pair, Frame, Failure>,
    Decode satisfies TryFrom<Frame, Pair, Failure>>
    (value: Pair, malformed: Frame) -> bool
{
    let encoded: Result<Frame, Failure> = convert<Pair, Frame, Failure, Encode>(value);
    transition encoded {
        Result::Err { error as failure } -> false
        Result::Ok { value as frame } -> inspect<Frame, Decode>(value, frame, malformed)
    }
}
machine inspect<Frame, Decode satisfies TryFrom<Frame, Pair, Failure>>
    (value: Pair, frame: Frame, malformed: Frame) -> bool
{
    let decoded: Result<Pair, Failure> = convert<Frame, Pair, Failure, Decode>(frame);
    transition decoded {
        Result::Err { error as failure } -> false
        Result::Ok { value as restored } -> reject_malformed<Frame, Decode>(value, restored, malformed)
    }
}
machine reject_malformed<Frame, Decode satisfies TryFrom<Frame, Pair, Failure>>
    (value: Pair, restored: Pair, malformed: Frame) -> bool
{
    let refused: Result<Pair, Failure> = convert<Frame, Pair, Failure, Decode>(malformed);
    transition refused {
        Result::Err { error as failure } -> (restored.first == value.first && restored.last == value.last)
        Result::Ok { value as unexpected } -> false
    }
}

// The standard interface selects adapters over the same maps proved above.
// Requests name their resources; these owned frames need no external resource.
data NoResources [copy] { }

// The checker proves that a record is its own fields rebuilt, and that equal
// fields rebuild equal records. Citing the first fact for both records gives
// identity from field equality.
machine pair_rebuilt<'value>(value: &'value Pair) reaches none terminates
ensures core::Identity<Pair>(value, Pair { first: value.first, last: value.last }) { }
machine pair_same<'left, 'right>(left: &'left Pair, right: &'right Pair) reaches none terminates
requires left.first == right.first
requires left.last == right.last
ensures core::Identity<Pair>(left, right) { pair_rebuilt(left); pair_rebuilt(right); }

FirstModel satisfies RepresentationModel<Pair, FirstFrame> {
    machine valid<'view>(frame: &'view FirstFrame) -> bool
    reaches none terminates { frame.tag == 165u8 }
    machine represents<'view, 'value>(frame: &'view FirstFrame, value: &'value Pair) -> bool
    reaches none terminates { frame.first == value.first && frame.last == value.last }
    machine unique<'view, 'left, 'right>(frame: &'view FirstFrame, left: &'left Pair, right: &'right Pair)
    reaches none terminates
    requires represents(frame, left)
    requires represents(frame, right)
    ensures core::Identity<Pair>(left, right) { pair_same(left, right); }
}
SecondModel satisfies RepresentationModel<Pair, SecondFrame> {
    machine valid<'view>(frame: &'view SecondFrame) -> bool
    reaches none terminates { frame.tag == 90u8 }
    machine represents<'view, 'value>(frame: &'view SecondFrame, value: &'value Pair) -> bool
    reaches none terminates { frame.first == value.last && frame.last == value.first }
    machine unique<'view, 'left, 'right>(frame: &'view SecondFrame, left: &'left Pair, right: &'right Pair)
    reaches none terminates
    requires represents(frame, left)
    requires represents(frame, right)
    ensures core::Identity<Pair>(left, right) { pair_same(left, right); }
}

// The original decoders publish no guarantee of their own, and a caller does
// not see into a callee's branches. For a valid frame, `*_decodes` states what
// the decoder returns and `read_*_valid` carries that statement onto the value
// the call actually returns. For an invalid frame the row's own
// `decode_rejects` law says the decoder fails. Each adapter picks its branch
// by the row's validity test and then forwards to the original decoder.
machine first_decodes(frame: FirstFrame) reaches none terminates
requires FirstValidity::valid(frame)
ensures core::Identity<Result<Pair, Failure>>(ReadFirst::try_from(frame), Result::Ok { value: Pair { first: frame.first, last: frame.last } }) { }
machine read_first_valid(frame: FirstFrame) -> Result<Pair, Failure>
reaches none terminates
requires FirstValidity::valid(frame)
ensures core::Identity<Result<Pair, Failure>>(result, Result::Ok { value: Pair { first: frame.first, last: frame.last } })
{
    first_decodes(frame);
    ReadFirst::try_from(frame)
}
machine decode_first_valid(frame: FirstFrame, resources: NoResources) -> Result<RepresentationRequest<Pair, NoResources>, Failure>
reaches none terminates
requires FirstValidity::valid(frame)
ensures result in Result::Ok
ensures result.value.value.first == frame.first
ensures result.value.value.last == frame.last
{
    let decoded: Result<Pair, Failure> = read_first_valid(frame);
    transition decoded {
        Result::Err { error as error } -> Result::Err { error: error }
        Result::Ok { value as restored } -> Result::Ok {
            value: RepresentationRequest { value: restored, resources: resources }
        }
    }
}
machine decode_first_invalid(frame: FirstFrame) -> Result<RepresentationRequest<Pair, NoResources>, Failure>
reaches none terminates
requires !FirstValidity::valid(frame)
ensures result in Result::Err
{
    FirstAgreement::decode_rejects(frame);
    let decoded: Result<Pair, Failure> = ReadFirst::try_from(frame);
    transition decoded {
        Result::Err { error as error } -> Result::Err { error: error }
        Result::Ok { value as restored } -> Result::Ok {
            value: RepresentationRequest { value: restored, resources: NoResources { } }
        }
    }
}
machine second_decodes(frame: SecondFrame) reaches none terminates
requires SecondValidity::valid(frame)
ensures core::Identity<Result<Pair, Failure>>(ReadSecond::try_from(frame), Result::Ok { value: Pair { first: frame.last, last: frame.first } }) { }
machine read_second_valid(frame: SecondFrame) -> Result<Pair, Failure>
reaches none terminates
requires SecondValidity::valid(frame)
ensures core::Identity<Result<Pair, Failure>>(result, Result::Ok { value: Pair { first: frame.last, last: frame.first } })
{
    second_decodes(frame);
    ReadSecond::try_from(frame)
}
machine decode_second_valid(frame: SecondFrame, resources: NoResources) -> Result<RepresentationRequest<Pair, NoResources>, Failure>
reaches none terminates
requires SecondValidity::valid(frame)
ensures result in Result::Ok
ensures result.value.value.first == frame.last
ensures result.value.value.last == frame.first
{
    let decoded: Result<Pair, Failure> = read_second_valid(frame);
    transition decoded {
        Result::Err { error as error } -> Result::Err { error: error }
        Result::Ok { value as restored } -> Result::Ok {
            value: RepresentationRequest { value: restored, resources: resources }
        }
    }
}
machine decode_second_invalid(frame: SecondFrame) -> Result<RepresentationRequest<Pair, NoResources>, Failure>
reaches none terminates
requires !SecondValidity::valid(frame)
ensures result in Result::Err
{
    SecondAgreement::decode_rejects(frame);
    let decoded: Result<Pair, Failure> = ReadSecond::try_from(frame);
    transition decoded {
        Result::Err { error as error } -> Result::Err { error: error }
        Result::Ok { value as restored } -> Result::Ok {
            value: RepresentationRequest { value: restored, resources: NoResources { } }
        }
    }
}
StandardWriteFirst<'value> satisfies TryFrom<RepresentationRequest<&'value Pair, NoResources>, FirstFrame, Failure> {
    machine try_from(source: RepresentationRequest<&'value Pair, NoResources>) -> Result<FirstFrame, Failure>
    reaches none terminates
    ensures result in Result::Ok
    ensures FirstModel::valid(&result.value)
    ensures FirstModel::represents(&result.value, source.value)
    { WriteFirst::try_from(Pair { first: source.value.first, last: source.value.last }) }
}
StandardReadFirst<'frame> satisfies TryFrom<RepresentationDecodeRequest<'frame, FirstFrame, NoResources>, RepresentationRequest<Pair, NoResources>, Failure> {
    machine try_from(source: RepresentationDecodeRequest<'frame, FirstFrame, NoResources>) -> Result<RepresentationRequest<Pair, NoResources>, Failure>
    reaches none terminates
    ensures FirstModel::valid(source.frame) == (result in Result::Ok)
    ensures (result in Result::Err) || FirstModel::represents(source.frame, &result.value.value)
    {
        let frame: FirstFrame = FirstFrame { tag: source.frame.tag, first: source.frame.first, last: source.frame.last };
        transition FirstValidity::valid(frame) {
            true -> decode_first_valid(frame, source.resources)
            false -> decode_first_invalid(frame)
        }
    }
}
StandardWriteSecond<'value> satisfies TryFrom<RepresentationRequest<&'value Pair, NoResources>, SecondFrame, Failure> {
    machine try_from(source: RepresentationRequest<&'value Pair, NoResources>) -> Result<SecondFrame, Failure>
    reaches none terminates
    ensures result in Result::Ok
    ensures SecondModel::valid(&result.value)
    ensures SecondModel::represents(&result.value, source.value)
    { WriteSecond::try_from(Pair { first: source.value.first, last: source.value.last }) }
}
StandardReadSecond<'frame> satisfies TryFrom<RepresentationDecodeRequest<'frame, SecondFrame, NoResources>, RepresentationRequest<Pair, NoResources>, Failure> {
    machine try_from(source: RepresentationDecodeRequest<'frame, SecondFrame, NoResources>) -> Result<RepresentationRequest<Pair, NoResources>, Failure>
    reaches none terminates
    ensures SecondModel::valid(source.frame) == (result in Result::Ok)
    ensures (result in Result::Err) || SecondModel::represents(source.frame, &result.value.value)
    {
        let frame: SecondFrame = SecondFrame { tag: source.frame.tag, first: source.frame.first, last: source.frame.last };
        transition SecondValidity::valid(frame) {
            true -> decode_second_valid(frame, source.resources)
            false -> decode_second_invalid(frame)
        }
    }
}
FirstRepresentation<'value, 'frame> satisfies Representation<'value, 'frame, Pair,
    NoResources, NoResources, FirstFrame, Failure, Failure,
    FirstModel, StandardWriteFirst<'value>, StandardReadFirst<'frame>> { }
SecondRepresentation<'value, 'frame> satisfies Representation<'value, 'frame, Pair,
    NoResources, NoResources, SecondFrame, Failure, Failure,
    SecondModel, StandardWriteSecond<'value>, StandardReadSecond<'frame>> { }

// The executable verdict uses weak TryFrom contracts. It does not assume the
// standard agreement guarantees it is testing.
machine standard_pair_matches(decoded: Result<Pair, Failure>, first: u8, last: u8) -> bool {
    transition decoded {
        Result::Err { error as error } -> false
        Result::Ok { value as restored } -> (restored.first == first && restored.last == last)
    }
}
machine standard_encoded_matches<Frame, Decode satisfies TryFrom<Frame, Pair, Failure>>
    (encoded: Result<Frame, Failure>, first: u8, last: u8) -> bool
{
    transition encoded {
        Result::Err { error as error } -> false
        Result::Ok { value as frame } -> standard_pair_matches(Decode::try_from(frame), first, last)
    }
}
machine standard_decoded_matches(decoded: Result<RepresentationRequest<Pair, NoResources>, Failure>, first: u8, last: u8) -> bool {
    transition decoded {
        Result::Err { error as error } -> false
        Result::Ok { value as restored } -> (restored.value.first == first && restored.value.last == last)
    }
}
machine standard_rejects(decoded: Result<RepresentationRequest<Pair, NoResources>, Failure>) -> bool {
    transition decoded {
        Result::Err { error as error } -> true
        Result::Ok { value as unexpected } -> false
    }
}
machine observe_standard<'value, 'frame, Frame,
    Encode satisfies TryFrom<RepresentationRequest<&'value Pair, NoResources>, Frame, Failure>,
    Decode satisfies TryFrom<RepresentationDecodeRequest<'frame, Frame, NoResources>, RepresentationRequest<Pair, NoResources>, Failure>,
    OriginalDecode satisfies TryFrom<Frame, Pair, Failure>>
    (value: &'value Pair, frame: &'frame Frame, malformed: &'frame Frame, first: u8, last: u8) -> bool
{
    let encoded: Result<Frame, Failure> = Encode::try_from(RepresentationRequest { value: value, resources: NoResources { } });
    let encoded_ok: bool = standard_encoded_matches<Frame, OriginalDecode>(encoded, first, last);
    let decoded: Result<RepresentationRequest<Pair, NoResources>, Failure> = Decode::try_from(RepresentationDecodeRequest { frame: frame, resources: NoResources { } });
    let decoded_ok: bool = standard_decoded_matches(decoded, first, last);
    let invalid: Result<RepresentationRequest<Pair, NoResources>, Failure> = Decode::try_from(RepresentationDecodeRequest { frame: malformed, resources: NoResources { } });
    let invalid_ok: bool = standard_rejects(invalid);
    encoded_ok && decoded_ok && invalid_ok
}
machine standard_agreement<'value, 'frame, Frame,
    Model satisfies RepresentationModel<Pair, Frame>,
    Encode satisfies RepresentationEncoding<'value, Pair, NoResources, Frame, Failure, Model>,
    Decode satisfies RepresentationDecoding<'frame, Pair, NoResources, Frame, Failure, Model>,
    Agreement satisfies Representation<'value, 'frame, Pair, NoResources, NoResources, Frame, Failure, Failure, Model, Encode, Decode>,
    OriginalDecode satisfies TryFrom<Frame, Pair, Failure>>
    (value: &'value Pair, frame: &'frame Frame, malformed: &'frame Frame, first: u8, last: u8) -> bool
requires Model::valid(frame)
requires Model::represents(frame, value)
requires !Model::valid(malformed)
{
    observe_standard<Frame, Encode, Decode, OriginalDecode>(value, frame, malformed, first, last)
}
machine standard_first<'value, 'frame>(value: &'value Pair, frame: &'frame FirstFrame,
    malformed: &'frame FirstFrame, first: u8, last: u8) -> bool
requires FirstModel::valid(frame)
requires FirstModel::represents(frame, value)
requires !FirstModel::valid(malformed)
{
    standard_agreement<FirstFrame, FirstModel, StandardWriteFirst<'value>, StandardReadFirst<'frame>,
        FirstRepresentation<'value, 'frame>, ReadFirst>(value, frame, malformed, first, last)
}
machine standard_second<'value, 'frame>(value: &'value Pair, frame: &'frame SecondFrame,
    malformed: &'frame SecondFrame, first: u8, last: u8) -> bool
requires SecondModel::valid(frame)
requires SecondModel::represents(frame, value)
requires !SecondModel::valid(malformed)
{
    standard_agreement<SecondFrame, SecondModel, StandardWriteSecond<'value>, StandardReadSecond<'frame>,
        SecondRepresentation<'value, 'frame>, ReadSecond>(value, frame, malformed, first, last)
}

machine consume(value: Pair, expected_first: u8, expected_last: u8) -> bool {
    let first: FirstFrame = FirstFrame { tag: 165u8, first: value.first, last: value.last };
    let second: SecondFrame = SecondFrame { tag: 90u8, first: value.last, last: value.first };
    let malformed_first: FirstFrame = FirstFrame { tag: 0u8, first: value.first, last: value.last };
    let malformed_second: SecondFrame = SecondFrame { tag: 0u8, first: value.last, last: value.first };
    use_agreement<FirstFrame, WriteFirst, ReadFirst, FirstValidity, FirstAgreement>(value, first, malformed_first);
    use_agreement<SecondFrame, WriteSecond, ReadSecond, SecondValidity, SecondAgreement>(value, second, malformed_second);
    let first_ok: bool = observe<FirstFrame, WriteFirst, ReadFirst>(value, malformed_first);
    let second_ok: bool = observe<SecondFrame, WriteSecond, ReadSecond>(value, malformed_second);
    let standard_first_ok: bool = standard_first(&value, &first, &malformed_first, expected_first, expected_last);
    let standard_second_ok: bool = standard_second(&value, &second, &malformed_second, expected_first, expected_last);
    first_ok && second_ok && standard_first_ok && standard_second_ok && value.first == expected_first && value.last == expected_last
}

boundary trait PairDelivery {
    machine semantic(edge: bool) -> Pair reaches terminates;
    machine marker() -> u64 reaches terminates;
}
FirstDelivery satisfies PairDelivery {
    machine semantic(edge: bool) -> Pair {
        transition edge {
            true -> Pair { first: 0u8, last: 255u8 }
            false -> Pair { first: 17u8, last: 42u8 }
        }
    }
    machine marker() -> u64 { 17u64 }
}
SecondDelivery satisfies PairDelivery {
    machine semantic(edge: bool) -> Pair {
        transition edge {
            true -> Pair { first: 0u8, last: 255u8 }
            false -> Pair { first: 17u8, last: 42u8 }
        }
    }
    machine marker() -> u64 { 29u64 }
}

machine verify(expected_marker: u64) reaches PairDelivery crashes Trap {
    let saved: Pair = PairDelivery::semantic(false);
    let edge: Pair = PairDelivery::semantic(true);
    let observed: bool = consume(saved, 17u8, 42u8);
    let endpoint: bool = consume(edge, 0u8, 255u8);
    let marker: u64 = PairDelivery::marker();
    transition marker == expected_marker && observed && endpoint {
        true -> done()
        false -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}

machine main_arm() reaches PairDelivery crashes Trap { verify(17u64); }
machine main_other() reaches PairDelivery crashes Trap { verify(29u64); }
