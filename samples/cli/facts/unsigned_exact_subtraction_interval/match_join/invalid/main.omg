// Fact: Subtracting two bounded unsigned u64 values (minuend >= 80u64 && minuend <= 100u64 and subtrahend >= 20u64 && subtrahend <= 30u64) establishes the exact post-subtraction interval (diff >= 50u64 && diff <= 80u64), discharging both diff - 50u64 and 80u64 - diff across all nine places.
// Place: match_join. Both match arms yield the difference so the joined binding preserves the post-subtraction interval.
// Expected exit: 0
machine subtract_match_join(minuend: u64, subtrahend: u64, flag: bool) -> i32
    requires minuend >= 79 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: u64 = minuend - subtrahend;
    let joined: u64 = match flag {
        true -> diff
        false -> diff
    };
    let lower: u64 = joined - 50;
    let upper: u64 = 80 - joined;
    let sum: u64 = lower + upper;
    sum as i32
}

machine evaluate() -> i32 {
    subtract_match_join(90, 25, true)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 30 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
