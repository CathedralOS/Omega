// Fact: Subtracting two bounded unsigned u64 values (minuend >= 80u64 && minuend <= 100u64 and subtrahend >= 20u64 && subtrahend <= 30u64) establishes the exact post-subtraction interval (diff >= 50u64 && diff <= 80u64), discharging both diff - 50u64 and 80u64 - diff across all nine places.
// Place: target_body. Each hosted target body computes the unsigned exact subtraction and discharges both differences.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSubtractTargetBody {
    machine subtract_target_body(minuend: u64, subtrahend: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30;
}

X86SubtractTargetBody satisfies SelectedSubtractTargetBody {
    machine subtract_target_body(minuend: u64, subtrahend: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
    {
        SelectedBodyCheck::require_tag(17u64);
        let diff: u64 = minuend - subtrahend;
        let lower: u64 = diff - 50;
        let upper: u64 = 80 - diff;
        let sum: u64 = lower + upper;
        sum as i32
    }
}

ArmSubtractTargetBody satisfies SelectedSubtractTargetBody {
    machine subtract_target_body(minuend: u64, subtrahend: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
    {
        SelectedBodyCheck::require_tag(29u64);
        let diff: u64 = minuend - subtrahend;
        let lower: u64 = diff - 50;
        let upper: u64 = 80 - diff;
        let sum: u64 = lower + upper;
        sum as i32
    }
}


machine evaluate() -> i32 {
    SelectedSubtractTargetBody::subtract_target_body(90, 25)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
