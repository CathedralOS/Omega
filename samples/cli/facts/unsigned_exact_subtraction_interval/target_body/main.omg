windows_x86_64 machine subtract_target_body(minuend: u64, subtrahend: u64) -> i32
    requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: u64 = minuend - subtrahend;
    let lower: u64 = diff - 50;
    let upper: u64 = 80 - diff;
    let sum: u64 = lower + upper;
    sum as i32
}

machine evaluate() -> i32 {
    subtract_target_body(90, 25)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 30 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
