// Every integer width with a proved bound 0 <= index <= 3 indexes a four-element array and XORs the selected u64 values.
// Expected exit: 0
data Indices
where 0 <= index_u8 && index_u8 <= 3
    && 0 <= index_u16 && index_u16 <= 3
    && 0 <= index_u32 && index_u32 <= 3
    && 0 <= index_u64 && index_u64 <= 3
    && 0 <= index_i8 && index_i8 <= 3
    && 0 <= index_i16 && index_i16 <= 3
    && 0 <= index_i32 && index_i32 <= 3
    && 0 <= index_i64 && index_i64 <= 3,
{
    index_u8: u8;
    index_u16: u16;
    index_u32: u32;
    index_u64: u64;
    index_i8: i8;
    index_i16: i16;
    index_i32: i32;
    index_i64: i64;
}
machine read_all(values: [u64; 4], indices: &Indices) -> u64
{
    values[indices.index_u8] ^ values[indices.index_u16] ^ values[indices.index_u32] ^ values[indices.index_u64]
        ^ values[indices.index_i8] ^ values[indices.index_i16] ^ values[indices.index_i32] ^ values[indices.index_i64]
}
machine main() crashes Trap {
    let values: [u64; 4] = [1, 2, 4, 8];
    let indices: Indices = Indices { index_u8: 0, index_u16: 1, index_u32: 2, index_u64: 3, index_i8: 0, index_i16: 1, index_i32: 2, index_i64: 2 };
    transition read_all(values, &indices) == 12 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
