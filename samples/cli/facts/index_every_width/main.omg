// Every integer width indexes builtin array geometry once its
// bounds are proved: `u8 [0..=3]` through `i64 [0..=3]` bounded
// scalar parameters each select an element — signed indices carry
// their own nonnegative range.
//
//   * `combine_fixed` takes one bounded parameter per width and
//     folds `values[...]` reads with `^`.
//   * `read_slice` indexes a `&[u64]` view by a signed bound +
//     `requires position < values.len`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine combine_fixed(
    values: [u64; 4],
    index_u8: u8 [0..=3],
    index_u16: u16 [0..=3],
    index_u32: u32 [0..=3],
    index_u64: u64 [0..=3],
    index_i8: i8 [0..=3],
    index_i16: i16 [0..=3],
    index_i32: i32 [0..=3],
    index_i64: i64 [0..=3]
) -> u64 {
    values[index_u8] ^ values[index_u16] ^ values[index_u32] ^ values[index_u64]
        ^ values[index_i8] ^ values[index_i16] ^ values[index_i32] ^ values[index_i64]
}

machine read_slice(values: &[u64], position: i32 [0..=3]) -> u64
requires position < values.len;
{
    values[position]
}

data Main {
    values: [u64; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.values = [1, 2, 4, 8];
    transition combine_fixed(main.values, 0, 1, 2, 3, 0, 1, 2, 3) == 15
        && read_slice(&main.values[..], 2) == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
