// Every integer width with a proved bound 0 <= index <= 3 indexes a four-element array and XORs the selected u64 values.
// Expected exit: 0
//
//   * `combine_fixed` takes one bounded parameter per width and
//     folds `values[...]` reads with `^`.
//   * `read_slice` indexes a `&[u64]` view by a signed bound +
//     `requires position < values.len`.
//   * `hits` records the reached arm.

machine combine_fixed(
    values: [u64; 4],
    index_u8: u8,
    index_u16: u16,
    index_u32: u32,
    index_u64: u64,
    index_i8: i8,
    index_i16: i16,
    index_i32: i32,
    index_i64: i64
) -> u64
requires 0 <= index_u8 && index_u8 <= 3
    && 0 <= index_u16 && index_u16 <= 3
    && 0 <= index_u32 && index_u32 <= 3
    && 0 <= index_u64 && index_u64 <= 3
    && 0 <= index_i8 && index_i8 <= 3
    && 0 <= index_i16 && index_i16 <= 3
    && 0 <= index_i32 && index_i32 <= 3
    && 0 <= index_i64 && index_i64 <= 3
{
    values[index_u8] ^ values[index_u16] ^ values[index_u32] ^ values[index_u64]
        ^ values[index_i8] ^ values[index_i16] ^ values[index_i32] ^ values[index_i64]
}

machine read_slice(values: &[u64], position: i32) -> u64
requires 0 <= position && position <= 3
    && position < values.len
{
    values[position]
}

data Main {
    values: [u64; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    main.values = [1, 2, 4, 8];
    transition combine_fixed(main.values, 0, 1, 2, 3, 0, 1, 2, 2) == 12
        && read_slice(&main.values[..], 2) == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { crash Trap; }
}


// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
