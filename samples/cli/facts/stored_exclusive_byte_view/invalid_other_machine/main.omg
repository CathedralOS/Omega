// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: other_machine.
// Expected rejection: the empty descriptor does not satisfy the read's live bound.
machine observe(windows: [@mutable [u8]; 1]) -> bool
requires windows[0].length == 1
{
    let length: u64 = windows[0].length;
    let observed: bool = windows[0][0] == 19 && length == 1;
    observed
}

machine forward(windows: [@mutable [u8]; 1]) -> bool
requires windows[0].length == 1
{
    observe(windows)
}

machine main() crashes Trap {
    let mutable backing: [u8; 1] = [19];
    let windows: [@mutable [u8]; 1] = [@mutable backing[0..0]];
    let observed: bool = forward(windows);
    transition observed {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
