// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: const_name.
// Expected exit: 0
const FIRST: u64 = 0;

machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let windows: [&mut [u8]; 1] = [&mut backing[..]];
    let length: u64 = windows[FIRST].len;
    let observed: bool = windows[FIRST][FIRST] == 19 && length == 1;
    transition observed {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
