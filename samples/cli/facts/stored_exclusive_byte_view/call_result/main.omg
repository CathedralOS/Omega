// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: call_result.
// Expected exit: 0
machine relay<'storage>(windows: [@'storage mutable [u8]; 1]) -> [@'storage mutable [u8]; 1]
ensures result[0].length == windows[0].length
{
    windows
}

machine main() crashes Trap {
    let mutable backing: [u8; 1] = [19];
    let windows: [@mutable [u8]; 1] = [@mutable backing[..]];
    let selected: [@mutable [u8]; 1] = relay(windows);
    let length: u64 = selected[0].length;
    let observed: bool = selected[0][0] == 19 && length == 1;
    transition observed {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
