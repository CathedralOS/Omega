// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: field.
// Expected exit: 0
data Bundle<'storage> { windows: [&'storage mut [u8]; 1]; }

machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let windows: [&mut [u8]; 1] = [&mut backing[..]];
    let bundle: Bundle = Bundle { windows: windows };
    let length: u64 = bundle.windows[0].len;
    let observed: bool = bundle.windows[0][0] == 19 && length == 1;
    transition observed {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
