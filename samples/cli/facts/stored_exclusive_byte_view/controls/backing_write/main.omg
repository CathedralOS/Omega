// Expected exit: 0
machine write(windows: [&mut [u8]; 1]) -> bool
requires windows[0].len == 1
{
    windows[0][0] = 23;
    windows[0].len == 1 && windows[0][0] == 23
}
machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let windows: [&mut [u8]; 1] = [&mut backing[..]];
    let written: bool = write(windows);
    transition written && backing[0] == 23 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
