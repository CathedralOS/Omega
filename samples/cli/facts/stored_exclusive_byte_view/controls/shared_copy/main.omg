// Expected exit: 0
machine main() crashes Trap {
    let backing: [u8; 1] = [19];
    let windows: [&[u8]; 1] = [&backing[..]];
    let copied: [&[u8]; 1] = windows;
    let observed: bool = copied[0].len == 1 && copied[0][0] == 19 && windows[0][0] == 19;
    transition observed { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
