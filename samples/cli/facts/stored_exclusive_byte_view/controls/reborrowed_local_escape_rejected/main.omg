// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Intended invalid: a reborrow cannot outlive its local backing.
data Bundle<'storage> { windows: [&'storage mut [u8]; 1]; }
data Wrapper<'bundle, 'storage> { bundle: &'bundle mut Bundle<'storage>; }
machine capture<'use, 'bundle, 'storage>(wrapper: &'use mut Wrapper<'bundle, 'storage>) -> &'use mut [u8]
requires wrapper.bundle.windows[0].len == 1
ensures result.len == 1
{
    &mut wrapper.bundle.windows[0][..]
}
machine observe(wrapper: &mut Wrapper) -> bool
requires wrapper.bundle.windows[0].len == 1
{
    let selected: &mut [u8] = capture(wrapper);
    selected.len == 1 && selected[0] == 19
}
machine escape() -> &mut [u8]
ensures result.len == 1
{
    let mut backing: [u8; 1] = [19];
    let mut bundle: Bundle = Bundle { windows: [&mut backing[..]] };
    let mut wrapper: Wrapper = Wrapper { bundle: &mut bundle };
    capture(&mut wrapper)
}
machine main() crashes Trap {
    let selected: &mut [u8] = escape();
    transition selected.len == 1 && selected[0] == 19 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
