// Expected exit: 0
use omega::language::core::drop;
data Token [linear] { code: u64; }
machine Token::drop(token: &mut Token) { token.code = 0; }
data Parcel { token: Token; marker: u64; }
machine relay(parcel: Parcel, choice: bool) -> Parcel {
    match choice { true -> parcel false -> parcel }
}
machine through(choice: bool) -> bool {
    let parcel: Parcel = Parcel { token: Token { code: 19 }, marker: 7 };
    let selected: Parcel = relay(parcel, choice);
    let observed: bool = selected.token.code == 19 && selected.marker == 7;
    drop(selected.token);
    observed
}
machine main() crashes Trap {
    transition through(true) && through(false) { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
