// Expected rejection: a projected claim cannot move twice on one arm.
data Counter { touched: bool; }
data Token [linear] { code: u64; }
data Guard { output: &mut Counter; }
data Triple { first: Token; second: Token; third: Guard; }
data Duo { left: Token; right: Token; }
machine Token::drop(token: &mut Token) requires token.code == 0 {}
machine retire(token: Token) requires token.code == 0 {}
machine Guard::drop(guard: &mut Guard) { guard.output.touched = !guard.output.touched; }
machine finish(mut pair: Duo, choose: bool) -> bool {
    let observed: bool = (choose && pair.left.code == 7 && pair.right.code == 11)
        || (!choose && pair.left.code == 11 && pair.right.code == 7);
    pair.left.code = 0;
    retire(pair.left);
    pair.right.code = 0;
    retire(pair.right);
    observed
}
machine select(output: &mut Counter, choose: bool) -> bool {
    let original: Triple = Triple {
        first: Token { code: 7 }, second: Token { code: 11 }, third: Guard { output: output }
    };
    let selected: Duo = match choose {
        true -> Duo { left: original.first, right: original.second }
        false -> Duo { left: original.second, right: original.second }
    };
    finish(selected, choose)
}
machine exercise(choose: bool) -> bool {
    let mut output: Counter = Counter { touched: false };
    let observed: bool = select(&mut output, choose);
    observed && output.touched
}
machine main() crashes Trap {
    transition exercise(true) && exercise(false) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
