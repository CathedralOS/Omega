// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Expected exit: 0
machine main() crashes Trap {
    let mut backing: [u8; 3] = [7, 19, 23];
    let mut sibling: [u8; 2] = [29, 41];
    let windows: [&mut [u8]; 2] = [&mut backing[1..2], &mut sibling[..]];
    let selected: [&mut [u8]; 2] = windows;
    let length: u64 = selected[0].len;
    let sibling_length: u64 = selected[1].len;
    let observed: bool = selected[0][0] == 19 && length == 1
        && selected[1][0] == 29 && sibling_length == 2;
    selected[0][0] = 31;
    let restored: bool = backing[0] == 7 && backing[1] == 31 && backing[2] == 23
        && sibling[0] == 29 && sibling[1] == 41;
    transition observed && restored {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
