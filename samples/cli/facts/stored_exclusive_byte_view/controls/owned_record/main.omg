// Expected exit: 0
data Bundle<'storage> { windows: [&'storage mut [u8]; 1]; }
machine observe(bundle: Bundle) -> bool
requires bundle.windows[0].len == 1
{
    bundle.windows[0].len == 1 && bundle.windows[0][0] == 19
}
machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let bundle: Bundle = Bundle { windows: [&mut backing[..]] };
    let observed: bool = observe(bundle);
    transition observed { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
