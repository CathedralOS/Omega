// Fact: A 32-bit unsigned u32 division of bounded inputs (dividend >= 200u32 && dividend <= 200u32, divisor >= 4u32 && divisor <= 4u32) establishes quotient >= 50u32 && quotient <= 50u32 so exact 32-bit subtraction quotient - 50u32 is proved underflow-free across all nine places.
// Place: call result. The quotient is received from a helper call returning the division result.
// Invalid control: divisor upper bound widened to 5u32, allowing quotient as low as 40u32 and failing subtraction quotient - 50u32.
// Expected rejection: may overflow `u32`

machine compute_quotient(d: u32, s: u32) -> u32
    requires d >= 200u32 && d <= 200u32;
    requires s >= 4u32 && s <= 5u32;
    ensures result >= 40u32 && result <= 50u32;
{
    d / s
}

machine divide_call_result(dividend: u32, divisor: u32) -> i32
    requires dividend >= 200u32 && dividend <= 200u32;
    requires divisor >= 4u32 && divisor <= 5u32;
{
    let quotient: u32 = compute_quotient(dividend, divisor);
    let check: u32 = quotient - 50u32;
    transition quotient == 50u32 && check == 0u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_call_result(200u32, 4u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
