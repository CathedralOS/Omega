// Fact: A 32-bit unsigned u32 division of bounded inputs (dividend >= 200u32 && dividend <= 200u32, divisor >= 4u32 && divisor <= 4u32) establishes quotient >= 50u32 && quotient <= 50u32 so exact 32-bit subtraction quotient - 50u32 is proved underflow-free across all nine places.
// Place: const name. The bounds and quotient limits reference declared symbolic constants.
// Expected exit: 0

const DIVIDEND_VAL: u32 = 200u32;
const DIVISOR_VAL: u32 = 4u32;
const QUOTIENT_BOUND: u32 = 50u32;

machine divide_const(dividend: u32, divisor: u32) -> i32
    requires dividend >= DIVIDEND_VAL && dividend <= DIVIDEND_VAL;
    requires divisor >= DIVISOR_VAL && divisor <= DIVISOR_VAL;
{
    let quotient: u32 = dividend / divisor;
    let check: u32 = quotient - QUOTIENT_BOUND;
    transition quotient == QUOTIENT_BOUND && check == 0u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_const(200u32, 4u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
