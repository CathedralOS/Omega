// A match on one evaluation of a copyable flag selects a write-only borrow of one slot, the join records that write-only loan, and the consumer stores 41 through the recorded loan, leaving the unselected slot and the neighbor canaries unchanged.
// Place: match_join.
// Invalid: the consumer reads the joined write-only loan before storing through it.
data Cell [copy] { before: i64; value: i64; after: i64; }
data Outcome [copy] { chosen: i64; other: i64; }

machine choose(counter: &mut u64, flag: bool) -> bool
requires counter == 0
{
    counter = 1;
    flag
}

machine store(flag: bool) -> Outcome crashes Trap {
    let mut chosen: Cell = match true {
        true -> Cell { before: 3, value: 17, after: 5 }
        false -> Cell { before: 0, value: 0, after: 0 }
    };
    let mut other: Cell = match true {
        true -> Cell { before: 7, value: 23, after: 9 }
        false -> Cell { before: 0, value: 0, after: 0 }
    };
    let mut visits: u64 = 0;
    let selected: &write i64 = match choose(&mut visits, flag) {
        true -> &write chosen.value
        false -> &write other.value
    };
    let previous: i64 = selected;
    selected = 41;
    transition visits == 1 && chosen.before == 3 && chosen.after == 5 && other.before == 7 && other.after == 9 {
        true -> report(Outcome { chosen: chosen.value, other: other.value })
        false -> wrong()
    }
    machine report(outcome: Outcome) -> Outcome { outcome }
    machine wrong() -> Outcome crashes Trap { crash Trap; }
}

machine main() crashes Trap {
    let taken: Outcome = store(true);
    let fallback: Outcome = store(false);
    transition taken.chosen == 41 && taken.other == 23 && fallback.chosen == 17 && fallback.other == 41 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
