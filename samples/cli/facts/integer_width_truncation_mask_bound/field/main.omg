// Fact: masking an unsigned 64-bit integer to its low byte (val & 255u64) establishes the exact byte-width upper bound (masked <= 255u64), discharging exact subtraction 255u64 - masked across all nine places.
// Expected exit: 0

data ByteCarrier {
    masked: u64;
}

machine exercise(val: u64) -> u64 {
    let carrier: ByteCarrier = ByteCarrier {
        masked: val & 255u64
    };
    let diff: u64 = 255u64 - carrier.masked;
    diff
}

machine main() crashes Trap {
    let diff: u64 = exercise(466u64);
    transition diff == 45u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
