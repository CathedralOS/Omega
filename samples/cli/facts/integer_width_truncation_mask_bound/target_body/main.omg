// Fact: masking an unsigned 64-bit integer to its low byte (val & 255u64) establishes the exact byte-width upper bound (masked <= 255u64), discharging exact subtraction 255u64 - masked across all nine places.
// Expected exit: 0

machine verify(diff: u64) crashes Trap {
    transition diff == 45u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

linux_x86_64 machine exercise(masked: u64) requires masked <= 255u64 crashes Trap {
    let diff: u64 = 255u64 - masked;
    verify(diff);
}

linux_arm64 machine exercise(masked: u64) requires masked <= 255u64 crashes Trap {
    let diff: u64 = 255u64 - masked;
    verify(diff);
}

macos_arm64 machine exercise(masked: u64) requires masked <= 255u64 crashes Trap {
    let diff: u64 = 255u64 - masked;
    verify(diff);
}

windows_x86_64 machine exercise(masked: u64) requires masked <= 255u64 crashes Trap {
    let diff: u64 = 255u64 - masked;
    verify(diff);
}

machine main() crashes Trap {
    let val: u64 = 466u64;
    exercise(val & 255u64);
}
