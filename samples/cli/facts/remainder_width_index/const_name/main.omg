// The remainder `value % width` is below `width`, so when `width` is proved
// equal to a view's length it indexes that view.
// Place: const name. A named width equals the view's length.
// Expected exit: 0
const WIDTH: u64 = 4;

machine pick(value: u64, buckets: &[u8]) -> u8
requires buckets.len > 0 && buckets.len as u64 == WIDTH
{
    buckets[value % WIDTH]
}

machine main() crashes Trap {
    let buckets: [u8; 4] = [7, 8, 9, 6];
    transition pick(10, &buckets[..]) == 9 && pick(15, &buckets[..]) == 6 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
