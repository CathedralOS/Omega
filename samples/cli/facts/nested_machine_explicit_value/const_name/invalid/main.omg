// A nested machine consumes explicit value 41 and establishes result 42 before exact result - 42.
// Expected exit: 0
machine produce<const Expected: u32>() -> u32 requires Expected == 41u32 ensures result == 42u32 {
    step(40u32)
    machine step(value: u32) -> u32
    requires Expected == 41u32 && value == 41u32
    ensures result == 42u32
    {
        value + 1u32
    }
}
const RESULT: u32 = produce<41u32>();
machine main() crashes Trap {
    let remainder: u32 = RESULT - 42u32;
    transition remainder == 0u32 { true -> done() false -> wrong() }
}
machine done() {}
machine wrong() crashes Trap { crash Trap; }
