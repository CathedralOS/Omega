// `count - used` under `used <= count` is exact and non-negative.
// Expected exit: 0
data Main where count <= 11 { count: u32; j: u32; out: i32; }

machine entry() crashes Trap {
    let mut a: Main = Main { count: 11, j: 4, out: 0 };
    let used_a: u32 = match true { true -> a.j, false -> a.count };
    a.out = subtracted(a.count, used_a);
    let mut b: Main = Main { count: 11, j: 11, out: 0 };
    let used_b: u32 = match false { true -> b.j, false -> b.count };
    b.out = subtracted(b.count, used_b);
    transition a.out == 7 && b.out == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() {
        crash Trap;
    }
}

machine subtracted(count: u32, used: u32) -> i32
requires used <= count && count <= 11
{
    let remaining: u32 = count - used;
    remaining as i32
}
