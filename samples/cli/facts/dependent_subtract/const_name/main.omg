// `count - used` under `used <= count` is non-negative in exact u32.
// `data where count <= 11` keeps that fact standing for `as i32`.
// Expected exit: 0
const USED: u32 = 4;
data Main where count <= 11 { count: u32; j: u32; out: i32; }

machine Main::main(main: &mut Main)
    requires USED <= main.count
{
    let remaining: u32 = main.count - USED;
    main.out = remaining as i32;
}

machine entry() crashes Trap {
    let mut a: Main = Main { count: 11, j: 4, out: 0 };
    Main::main(&mut a);
    let mut b: Main = Main { count: 4, j: 4, out: 0 };
    Main::main(&mut b);
    transition a.out == 7 && b.out == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() {
        crash Trap;
    }
}
