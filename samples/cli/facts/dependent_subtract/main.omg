// The relational SUBTRACTION rule: `main.count - main.j` under
// `requires main.j <= main.count` proves non-negative in EXACT u32 — the
// dependent atom gives `count - j >= 0`. A `data where` premise keeps the
// fact standing.
data Main where count <= 11 { count: u32; j: u32; out: i32; }
machine Main::main(main: &mut Main) {
    main.count = 8;
    main.j = 6;
    transition main.j <= main.count {
        true -> read(main)
        _ -> bad(main)
    }
    state read(main: &mut Main)
        requires main.j <= main.count
    {
        let remaining: u32 = main.count - main.j;
        main.out = remaining as i32;
    }
    state bad(main: &mut Main) { }
}
