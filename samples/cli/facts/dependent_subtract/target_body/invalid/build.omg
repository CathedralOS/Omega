machine build(builder: &mut Build) {
    Build::select_provider<SelectedGap, CheckedGap>(builder, linux_x86_64);
    Build::select_provider<SelectedGap, CheckedGap>(builder, linux_arm64);
    Build::select_provider<SelectedGap, CheckedGap>(builder, macos_arm64);
    Build::select_provider<SelectedGap, CheckedGap>(builder, windows_x86_64);

    Build::application(builder, "dependent_subtract_target_body_invalid");
}
