// `count - used` under `used <= count` is non-negative in exact u32.
// `data where count <= 11` keeps that fact standing for `as i32`.
// Expected exit: 0
data Main requires count <= 11 { count: u32; j: u32; out: i32; }

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedGap {
    machine gap(count: u32, used: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires used <= count && count <= 11;
}

X86Gap satisfies SelectedGap {
    machine gap(count: u32, used: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires used <= count && count <= 11
    {
        SelectedBodyCheck::require_tag(17u64);
        let remaining: u32 = count - used;
        remaining as i32
    }
}

ArmGap satisfies SelectedGap {
    machine gap(count: u32, used: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires used <= count && count <= 11
    {
        SelectedBodyCheck::require_tag(29u64);
        let remaining: u32 = count - used;
        remaining as i32
    }
}

machine Main::main(main: &mut Main)
    requires main.j <= main.count
{
    main.out = SelectedGap::gap(main.count, main.j);
}

machine entry() crashes Trap {
    let mut a: Main = Main { count: 11, j: 4, out: 0 };
    Main::main(&mut a);
    let mut b: Main = Main { count: 11, j: 11, out: 0 };
    Main::main(&mut b);
    transition a.out == 7 && b.out == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    entry();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    entry();
}
