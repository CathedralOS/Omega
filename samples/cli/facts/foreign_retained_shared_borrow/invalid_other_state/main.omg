// Fact: A shared foreign registration retains the exact original Buffer backing until completion consumes Pending; completion observes the original value 37.
// Expected exit: 0. Completion observes the original value 37 through the
// retained shared backing; a live registration excludes overlapping writes.
use {omega}/language/core/content.omg;
public data ByteUnit {}
public data Buffer [linear] dropped by drop_buffer { value: u64; }
machine drop_buffer(buffer: @mutable Buffer) {}
public domain Buffer::Owned;
machine Owned::content(buffer: @Buffer) -> |content|::CountedQuantity<ByteUnit>
satisfies |content|::Content<Buffer, |content|::CountedQuantity<ByteUnit>>::project {
    |content|::CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Pending<'source> [linear] { slot: u64; }
public domain Pending::Retained established by Reader::register;
machine Retained::content<'source>(pending: @Pending<'source>) -> |content|::CountedQuantity<ByteUnit>
satisfies |content|::Content<Pending<'source>, |content|::CountedQuantity<ByteUnit>>::project {
    |content|::CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Capacity [linear] { token: u64; }
public domain Capacity::Available established by Reader::acquire, Reader::complete;
public boundary trait Reader {
    machine acquire() -> Capacity reaches none ensures result in Capacity::Available crashes Trap;
    machine register<'source>(capacity: Capacity in Capacity::Available, buffer: @'source Buffer in Buffer::Owned) -> Pending<'source>
    reaches none
    ensures result in Pending::Retained crashes Trap;
    machine complete<'source>(pending: Pending<'source> in Pending::Retained, observed: @mutable u64) -> Capacity
    reaches none
    ensures result in Capacity::Available crashes Trap;
    machine release(capacity: Capacity in Capacity::Available) reaches none crashes Trap;
}
machine forward<'a>(pending: Pending<'a> in Pending::Retained) -> Pending<'a>
ensures result in Pending::Retained {
    transition { _ -> forwarded(pending) }
    machine forwarded(pending: Pending<'a> in Pending::Retained) -> Pending<'a>
    ensures result in Pending::Retained { pending }
}
data Main {}
machine run_main(main: @mutable Main) reaches Reader crashes Trap {
    let capacity: Capacity in Capacity::Available = Reader::acquire();
    let mutable buffer: Buffer in Buffer::Owned = Buffer { value: 37 };
    let pending: Pending = Reader::register(capacity, @buffer);
    let routed: Pending in Pending::Retained = forward(pending);
    buffer.value = 99;
    let mutable observed: u64 = 0;
    let returned: Capacity in Capacity::Available = Reader::complete(routed, @mutable observed);
    Reader::release(returned);
    let value: u64 = buffer.value;
    drop(buffer);
    transition observed == 37 && value == 37 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Reader crashes Trap {
    let mutable entry_storage: Main;
    run_main(@mutable entry_storage);
}
