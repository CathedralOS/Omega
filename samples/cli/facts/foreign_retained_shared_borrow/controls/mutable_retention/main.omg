data Main {}
machine Main::main(main: &mut Main) reaches Reader crashes Trap {
    let capacity: Capacity in Capacity::Available = Reader::acquire();
    let mut buffer: Buffer in Buffer::Owned = Buffer { value: 37 };
    let pending: Pending = Reader::register(capacity, &mut buffer);
    let mut observed: u64 = 0;
    let returned: Capacity in Capacity::Available = Reader::complete(pending, &mut observed);
    Reader::release(returned);
    let value: u64 = buffer.value;
    drop(buffer);
    transition observed == 37 && value == 37 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Reader crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
