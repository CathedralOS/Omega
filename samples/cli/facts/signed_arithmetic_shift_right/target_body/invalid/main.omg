// An arithmetic right shift (`>>`) on a bounded signed `i64` value (`value >= 400i64 && value <= 400i64`) by a bounded shift count (`shift >= 2u32 && shift <= 2u32`) preserves sign and establishes the exact post-shift interval (`shifted >= 100i64 && shifted <= 100i64`), discharging exact subtraction `shifted - 100i64` with exit code `0`.
// Place: another target body (invalid twin). The operand bound is weakened to val >= 300i64 in each body.

machine consume(diff: i64) -> i64
    requires diff >= 0i64 && diff <= 0i64
{
    diff
}

linux_x86_64 machine shift_right(val: i64, shift: u32) -> i64
    requires val >= 300i64 && val <= 400i64 && shift >= 2u32 && shift <= 2u32
{
    let shifted: i64 = val >> shift;
    let diff: i64 = shifted - 100i64;
    consume(diff)
}

linux_arm64 machine shift_right(val: i64, shift: u32) -> i64
    requires val >= 300i64 && val <= 400i64 && shift >= 2u32 && shift <= 2u32
{
    let shifted: i64 = val >> shift;
    let diff: i64 = shifted - 100i64;
    consume(diff)
}

macos_arm64 machine shift_right(val: i64, shift: u32) -> i64
    requires val >= 300i64 && val <= 400i64 && shift >= 2u32 && shift <= 2u32
{
    let shifted: i64 = val >> shift;
    let diff: i64 = shifted - 100i64;
    consume(diff)
}

windows_x86_64 machine shift_right(val: i64, shift: u32) -> i64
    requires val >= 300i64 && val <= 400i64 && shift >= 2u32 && shift <= 2u32
{
    let shifted: i64 = val >> shift;
    let diff: i64 = shifted - 100i64;
    consume(diff)
}

machine probe(val: i64, shift: u32) -> i64
    requires val >= 300i64 && val <= 400i64 && shift >= 2u32 && shift <= 2u32
{
    shift_right(val, shift)
}

machine main() {
    let res: i64 = probe(400i64, 2u32);
}
