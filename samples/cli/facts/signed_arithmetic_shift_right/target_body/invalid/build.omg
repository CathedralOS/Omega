machine build(builder: &mut Build) {
    Build::select_provider<SelectedShiftRight, CheckedShiftRight>(builder, linux_x86_64);
    Build::select_provider<SelectedShiftRight, CheckedShiftRight>(builder, linux_arm64);
    Build::select_provider<SelectedShiftRight, CheckedShiftRight>(builder, macos_arm64);
    Build::select_provider<SelectedShiftRight, CheckedShiftRight>(builder, windows_x86_64);

    Build::application(builder, "signed_arithmetic_shift_right_target_body_invalid");
}
