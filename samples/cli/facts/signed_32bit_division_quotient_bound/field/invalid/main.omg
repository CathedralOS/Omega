// Fact: a 32-bit signed i32 division of bounded inputs (dividend >= 200i32 && dividend <= 200i32, divisor >= 5i32 && divisor <= 5i32) establishes quotient >= 40i32 && quotient <= 40i32 so exact 32-bit signed subtraction quotient - 40i32 is proved overflow-free across all nine places.
// Invalid: widening divisor >= 4i32 allows quotient 50i32 in field, violating verify_quotient contract. Place: field.
// Expected diagnostic: cannot prove requires contract for call verify_quotient

data DivResult {
    quotient: i32;
}

machine verify_quotient(quotient: i32) -> i32
requires quotient >= 40i32 && quotient <= 40i32
{
    quotient - 40i32
}

machine compute_field(dividend: i32, divisor: i32) -> i32
requires dividend >= 200i32 && dividend <= 200i32 && divisor >= 4i32 && divisor <= 5i32
{
    let holder: DivResult = DivResult { quotient: dividend / divisor };
    verify_quotient(holder.quotient)
}

machine probe() -> i32 {
    compute_field(200i32, 5i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
