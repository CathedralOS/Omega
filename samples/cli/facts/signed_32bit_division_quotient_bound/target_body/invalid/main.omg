// Fact: a 32-bit signed i32 division of bounded inputs (dividend >= 200i32 && dividend <= 200i32, divisor >= 5i32 && divisor <= 5i32) establishes quotient >= 40i32 && quotient <= 40i32 so exact 32-bit signed subtraction quotient - 40i32 is proved overflow-free across all nine places.
// Invalid: target bodies compute 200 / 4 = 50i32, violating verify_quotient contract. Place: target_body.
// Expected diagnostic: cannot prove requires contract for call verify_quotient

machine verify_quotient(quotient: i32) -> i32
requires quotient >= 40i32 && quotient <= 40i32
{
    quotient - 40i32
}

linux_x86_64 machine verify_target() -> i32 {
    let dividend: i32 = 200i32;
    let divisor: i32 = 4i32;
    let quotient: i32 = dividend / divisor;
    verify_quotient(quotient)
}

linux_arm64 machine verify_target() -> i32 {
    let dividend: i32 = 200i32;
    let divisor: i32 = 4i32;
    let quotient: i32 = dividend / divisor;
    verify_quotient(quotient)
}

macos_arm64 machine verify_target() -> i32 {
    let dividend: i32 = 200i32;
    let divisor: i32 = 4i32;
    let quotient: i32 = dividend / divisor;
    verify_quotient(quotient)
}

windows_x86_64 machine verify_target() -> i32 {
    let dividend: i32 = 200i32;
    let divisor: i32 = 4i32;
    let quotient: i32 = dividend / divisor;
    verify_quotient(quotient)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
