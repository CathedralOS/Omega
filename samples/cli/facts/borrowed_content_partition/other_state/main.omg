// Expected exit: 0
// A brief exclusive borrow returns detached owned content and restores its source.
// Numeric custody only; this does not supply physical backing.
use borrowed_partition_support::main;

machine exercise(select: bool) -> bool {
    let mut strategy: Strategy = Strategy { tail: issue(), remaining: 48 };
    let first: Region in Owned = carve(&mut strategy, 48, 16);
    transition { _ -> next(strategy, first) }
    machine next(mut strategy: Strategy, first: Region in Owned) -> bool
    requires first.length == 16 && strategy.tail.length == 32 && strategy.remaining == 32
    {
        let second: Region in Owned = carve(&mut strategy, 32, 8);
        finish(strategy, first, second)
    }
}

machine main() crashes Trap {
    let first: bool = exercise(true);
    let second: bool = exercise(false);
    transition first && second { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
