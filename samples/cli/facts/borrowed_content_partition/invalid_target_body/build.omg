use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "borrowed_partition_target_body" };
    let borrowed_partition_support_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../../../support/fact_dependencies/borrowed_partition_support" }));
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::x86_entry);
    Build::select_provider::<|app|::SelectedProbe, |app|::ArmProbe2>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedProbe, |app|::X86Probe>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedProbe, |app|::ArmProbe>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedProbe, |app|::X86Probe>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedProbe, |app|::X86Probe>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, windows_x86_64);
}
