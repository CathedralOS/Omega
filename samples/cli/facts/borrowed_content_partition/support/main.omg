// Shared numeric-custody model for the transport witnesses. This package
// supplies no physical backing, placement permission or allocator reset.
use omega::language::core::content;
use omega::language::core::drop;

public data ByteUnit {}
public data Region [linear] { length: u64; }
public domain Region::Owned established by issue;
public machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project {
    CountedQuantity { magnitude: embed(region.length) as Nat }
}
public machine issue() -> Region in Owned ensures result.length == 48 {
    Region { length: 48 }
}
public machine Region::drop(region: &mut Region) {}
public data Parts { taken: Region in Owned; rest: Region in Owned; }
public data Strategy where remaining == tail.length {
    tail: Region in Owned;
    remaining: u64;
}
public machine partition(whole: Region in Owned, requested: u64) -> Parts
requires requested <= whole.length
ensures result.taken.length == requested,
    result.rest.length == whole.length - requested,
    Owned::content(old(&whole)) == separate(Owned::content(&result.taken), Owned::content(&result.rest))
{
    let { length } = whole;
    Parts { taken: Region { length: requested }, rest: Region { length: length - requested } }
}
public machine carve(strategy: &mut Strategy, remaining: u64, requested: u64) -> Region in Owned
requires remaining == strategy.tail.length && requested <= remaining
ensures result.length == requested,
    strategy.tail.length == remaining - requested,
    strategy.remaining == remaining - requested
{
    let tail: Region in Owned = strategy.tail;
    let parts: Parts = partition(tail, requested);
    strategy.tail = parts.rest;
    strategy.remaining = remaining - requested;
    parts.taken
}

// The caller must carry the facts into this consumption boundary, without a
// post-hoc guard. Runtime reads independently check the emitted representation.
public machine finish(strategy: Strategy, first: Region in Owned, second: Region in Owned) -> bool
requires first.length == 16 && second.length == 8 &&
    strategy.tail.length == 24 && strategy.remaining == 24
{
    let correct: bool = first.length == 16 && second.length == 8 &&
        strategy.tail.length == 24 && strategy.remaining == 24;
    drop(first);
    drop(second);
    drop(strategy.tail);
    correct
}
