// Expected exit: 0
// A brief exclusive borrow returns detached owned content and restores its source.
// Numeric custody only; this does not supply physical backing.
use borrowed_partition_support::main;

data Holder { strategy: Strategy; }
machine exercise(select: bool) -> bool {
    let mut holder: Holder = Holder { strategy: Strategy { tail: issue(), remaining: 48 } };
    let first: Region in Owned = carve(&mut holder.strategy, 48, 17);
    let second: Region in Owned = carve(&mut holder.strategy, 32, 8);
    finish(holder.strategy, first, second)
}

machine main() crashes Trap {
    let first: bool = exercise(true);
    let second: bool = exercise(false);
    transition first && second { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
