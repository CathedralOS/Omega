// Expected exit: 0
// A brief exclusive borrow returns detached owned content and restores its source.
// Numeric custody only; this does not supply physical backing.
use {borrowed_partition_support}/main.omg as borrowed_partition_support;

data Allocator {}
machine Allocator::take(strategy: @mutable |borrowed_partition_support|::Strategy, remaining: u64, requested: u64) -> |borrowed_partition_support|::Region in |borrowed_partition_support|::Region::Owned
requires remaining == strategy.tail.length && requested <= remaining
ensures result.length == requested,
    strategy.tail.length == remaining - requested,
    strategy.remaining == remaining - requested
{ |borrowed_partition_support|::carve(strategy, remaining, requested) }
machine exercise(select: bool) -> bool {
    let mutable strategy: |borrowed_partition_support|::Strategy = |borrowed_partition_support|::Strategy { tail: |borrowed_partition_support|::issue(), remaining: 48 };
    let first: |borrowed_partition_support|::Region in |borrowed_partition_support|::Region::Owned = Allocator::take(@mutable strategy, 48, 17);
    let second: |borrowed_partition_support|::Region in |borrowed_partition_support|::Region::Owned = Allocator::take(@mutable strategy, 32, 8);
    |borrowed_partition_support|::finish(strategy, first, second)
}

machine main() crashes Trap {
    let first: bool = exercise(true);
    let second: bool = exercise(false);
    transition first && second { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
