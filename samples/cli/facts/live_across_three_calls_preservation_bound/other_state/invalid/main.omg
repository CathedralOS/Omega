// Fact: a value live across three sequential machine calls preserves its static bound 40u64 <= saved <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: other_state. A state transition forwards the preserved value saved to a successor state.
// Expected exit: 0
machine step1(x: u64) -> u64
    requires x == 10
    ensures result == 11
{
    11
}

machine step2(x: u64) -> u64
    requires x == 11
    ensures result == 12
{
    12
}

machine step3(x: u64) -> u64
    requires x == 12
    ensures result == 13
{
    13
}

machine compute_other_state(saved: u64) -> i32
    requires saved >= 39 && saved <= 80
{
    let c1: u64 = step1(10);
    let c2: u64 = step2(c1);
    let c3: u64 = step3(c2);
    transition { _ -> step(saved, c3) }
    machine step(res: u64, c3: u64) -> i32
    requires res >= 39 && res <= 80
    {
        let head: u64 = 80 - res;
        let underflow: u64 = res - 40;
        transition head + underflow == 40 && c3 == 13 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() -> i32 { 0 }
    machine bad() -> i32 { 1 }
}

machine evaluate() -> i32 {
    compute_other_state(39)
}

machine main() crashes Trap {
    let outcome: i32 = evaluate();
    transition outcome == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
