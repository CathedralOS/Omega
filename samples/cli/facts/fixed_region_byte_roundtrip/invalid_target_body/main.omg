// Fact: A fixed interior typed region can be copied through byte views without changing its values or either neighboring word.
// Invalid: the transported region end is 5, so the 32-byte source region cannot license a 40-byte view.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedRegion {
    machine region_end() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 5u64;
}

X86Region satisfies SelectedRegion {
    machine region_end() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 5u64
    {
        SelectedBodyCheck::require_tag(17u64);
        5u64
    }
}

ArmRegion satisfies SelectedRegion {
    machine region_end() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 5u64
    {
        SelectedBodyCheck::require_tag(29u64);
        5u64
    }
}

machine copy_bytes(source: &[u8; 40], destination: &mut [u8; 40]) {
    destination = source;
}
machine main() crashes Trap {
    let source: [u64; 7] = [17u64, 23u64, 42u64, 9u64, 50u64, 61u64, 53u64];
    let mut destination: [u64; 7] = [29u64, 0u64, 0u64, 0u64, 0u64, 0u64, 71u64];
    let end: u64 = SelectedRegion::region_end();
    let bytes: &[u8; 40] = &source[1..end] as &[u8; 40];
    let output: &mut [u8; 40] = &mut destination[1..6] as &mut [u8; 40];
    copy_bytes(bytes, output);
    transition source[0] == 17u64 && source[1] == 23u64 && source[2] == 42u64 && source[3] == 9u64 && source[4] == 50u64 && source[5] == 61u64 && source[6] == 53u64 && destination[0] == 29u64 && destination[1] == 23u64 && destination[2] == 42u64 && destination[3] == 9u64 && destination[4] == 50u64 && destination[5] == 61u64 && destination[6] == 71u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
