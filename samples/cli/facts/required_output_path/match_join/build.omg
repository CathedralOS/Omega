// An issued required-output path survives ordinary byte-view transport, so Build seals that exact reserved member and selects the product from its observed bytes.
machine choose<'path>(path: @'path [u8], alternate: @'path [u8], first: bool) -> @'path [u8] {
    match first { true -> path, false -> alternate }
}
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "required_output_path_match_join" };
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "answer.dat");
    let path: @[u8] = choose(RequiredOutput::path(@obligation), "wrong.dat", true);
    let file: BuildPath = use_path(builder, path);
    let settled: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, file);
    settle(builder, settled);
}
machine use_path(builder: @mutable BuildPlan, path: @[u8]) -> BuildPath {
    let file: BuildPath = BuildOutput::resolve(@builder.output, path);
    let descriptor: i32 = BuildOutput::create(@mutable builder.output, file, 0);
    _ = BuildOutput::write(@mutable builder.output, descriptor, "forty-two");
    _ = BuildOutput::close(@mutable builder.output, descriptor);
    select_path(builder, path);
    file
}
machine select_entry(builder: @mutable BuildPlan, first: u8) {
    transition first == 97 { true -> correct(builder), false -> wrong(builder) }
}
machine correct(builder: @mutable BuildPlan) {
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
machine wrong(builder: @mutable BuildPlan) {
    Build::bind(builder, linux_x86_64::ProgramEntry, wrong_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, wrong_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, wrong_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, wrong_entry);
}
machine settle(builder: @mutable BuildPlan, settled: OutputCompletion) {
    transition settled {
        OutputCompletion::Sealed { receipt } -> done(),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine done() {}
    machine failed(builder: @mutable BuildPlan, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "output was not sealed");
    }
}

machine select_path(builder: @mutable BuildPlan, path: @[u8]) {
    transition path.length > 0 { true -> select_entry(builder, path[0]), false -> wrong(builder) }
}
