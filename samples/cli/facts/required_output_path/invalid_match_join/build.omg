// An issued required-output path survives ordinary byte-view transport, so Build seals that exact reserved member and selects the product from its observed bytes.
machine choose<'path>(path: &'path [u8], alternate: &'path [u8], first: bool) -> &'path [u8] {
    match first { true -> path, false -> alternate }
}
machine build(builder: &mut Build) {
    Build::application(builder, "required_output_path_match_join");
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "answer.dat");
    let path: &[u8] = choose(RequiredOutput::path(&obligation), "wrong.dat", true);
    let file: BuildPath = use_path(builder, path);
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, file);
    settle(builder, settled);
}
machine use_path(builder: &mut Build, path: &mut [u8]) -> BuildPath {
    let file: BuildPath = BuildOutput::resolve(&builder.output, path);
    let descriptor: i32 = BuildOutput::create(&mut builder.output, file, 0);
    _ = BuildOutput::write(&mut builder.output, descriptor, "forty-two");
    _ = BuildOutput::close(&mut builder.output, descriptor);
    select_path(builder, path);
    file
}
machine select_entry(builder: &mut Build, first: u8) {
    transition first == 97 { true -> correct(builder) false -> wrong(builder) }
}
machine correct(builder: &mut Build) {
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
machine wrong(builder: &mut Build) {
    Build::bind(builder, linux_x86_64::ProgramEntry, wrong_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, wrong_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, wrong_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, wrong_entry);
}
machine settle(builder: &mut Build, settled: OutputCompletion) {
    transition settled {
        OutputCompletion::Sealed { receipt } -> done()
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine done() {}
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "output was not sealed");
    }
}

machine select_path(builder: &mut Build, path: &[u8]) {
    transition path.len > 0 { true -> select_entry(builder, path[0]) false -> wrong(builder) }
}
