// An exclusive reference moves into another binding. Writing through the receiving binding changes the original backing; the following read must see 41.
// Expected exit: 0.
data Counter { value: u64; }
data Keeper { output: &mut Counter; code: u64; }
machine Keeper::drop(keeper: &mut Keeper) requires keeper.code == 41 {
    keeper.output.value = keeper.code;
}
machine observe(keeper: &Keeper) {}
machine exercise(pick: bool) crashes Trap {
    let mut output: Counter = Counter { value: 0 };
    let mut spare: Counter = Counter { value: 0 };
    let original: &mut Counter = &mut output;
    let alternate: &mut Counter = &mut spare;
    let selected: &mut Counter = match pick {
        true -> original
        false -> alternate
    };
    observe(&Keeper { output: selected, code: 41 });
    transition (pick && output.value == 41 && spare.value == 0)
        || (!pick && spare.value == 41 && output.value == 0) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap { exercise(true); exercise(false); }
