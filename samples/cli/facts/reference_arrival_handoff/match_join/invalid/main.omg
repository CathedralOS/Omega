// An exclusive reference moves into another binding. Writing through the receiving binding changes the original backing; the following read must see 41.
// Place: match join.
// Invalid: the backing is written while the joined loan may still alias it.
machine main() crashes Trap {
    let mut backing: i64 = 17;
    let mut spare: i64 = 0;
    let pick: bool = true;
    let original: &mut i64 = &mut backing;
    let alternate: &mut i64 = &mut spare;
    let child: &mut i64 = match pick {
        true -> original
        false -> alternate
    };
    backing = 7;
    child = 41;
    let observed: i64 = child;
    transition observed == 41 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
