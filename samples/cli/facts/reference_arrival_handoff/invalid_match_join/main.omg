// An exclusive reference moves into another binding. Writing through the receiving binding changes the original backing; the following read must see 41.
// Place: match join.
// Invalid: the backing is written while the joined loan may still alias it.
machine main() crashes Trap {
    let mutable backing: i64 = 17;
    let mutable spare: i64 = 0;
    let pick: bool = true;
    let original: @mutable i64 = @mutable backing;
    let alternate: @mutable i64 = @mutable spare;
    let child: @mutable i64 = match pick {
        true -> original,
        false -> alternate
    };
    backing = 7;
    $child = 41;
    let observed: i64 = $child;
    transition observed == 41 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
