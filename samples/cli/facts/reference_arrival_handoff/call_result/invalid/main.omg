// An exclusive reference moves into another binding. Writing through the receiving binding changes the original backing; the following read must see 41.
// Place: call result.
// Invalid: the moved-from binding is written while the returned loan is live.
machine hand<'owner>(source: &'owner mut i64) -> &'owner mut i64 { source }
machine main() crashes Trap {
    let mut backing: i64 = 17;
    let original: &mut i64 = &mut backing;
    let child: &mut i64 = hand(original);
    original = 7;
    child = 41;
    let observed: i64 = child;
    transition observed == 41 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
