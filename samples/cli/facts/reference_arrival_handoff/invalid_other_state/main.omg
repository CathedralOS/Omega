// An exclusive reference moves into another binding. Writing through the receiving binding changes the original backing; the following read must see 41.
// Place: another state.
// Invalid: the moved-from binding is written while the receiving state loan is live.
machine main() crashes Trap {
    let mutable backing: i64 = 17;
    let original: @mutable i64 = @mutable backing;
    let held: @mutable i64 = original;
    transition { _ -> write(original, held) }
    machine write(child: @mutable i64, kept: @mutable i64) {
        $child = 41;
        $kept = 7;
        transition { _ -> check(child) }
    }
    machine check(received: @mutable i64) {
        let observed: i64 = $received;
        transition observed == 41 {
            true -> done(),
            false -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
