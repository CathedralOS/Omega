// An exclusive reference moves into another binding. Writing through the receiving binding changes the original backing; the following read must see 41.
// Place: another target body.
// Invalid: the source binding is handed to the target body while a derived loan is live.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedWrite {
    machine write(child: &mut i64)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Write satisfies SelectedWrite {
    machine write(child: &mut i64)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     child = 41; 
    }
}

ArmWrite satisfies SelectedWrite {
    machine write(child: &mut i64)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     child = 41; 
    }
}


machine main() crashes Trap {
    let mut backing: i64 = 17;
    let original: &mut i64 = &mut backing;
    let held: &mut i64 = original;
    SelectedWrite::write(original);
    held = 7;
    let observed: i64 = backing;
    transition observed == 41 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
