// Fact: 64-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u64 <= prod <= 200u64 establishes 50u64 <= prod <= 200u64 across all nine places so exact subtractions 200u64 - prod and prod - 50u64 are safe.
// Place: target body (invalid twin).

machine compute_prod(lhs: u64, rhs: u64) -> u64
requires lhs >= 10u64 && lhs <= 21u64
    && rhs >= 5u64 && rhs <= 10u64
ensures result >= 50u64 && result <= 210u64
{
    let wrap_lhs: u64 in Wrapping = lhs as u64 in Wrapping;
    let wrap_rhs: u64 in Wrapping = rhs as u64 in Wrapping;
    let wrap_prod: u64 in Wrapping = wrap_lhs * wrap_rhs;
    wrap_prod as u64
}

machine verify_prod(prod: u64) -> u64 crashes Trap
requires prod >= 50u64 && prod <= 200u64
ensures result == 0u64
{
    let headroom: u64 = 200u64 - prod;
    let margin: u64 = prod - 50u64;
    transition headroom == 80u64 && margin == 70u64 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> u64 {
        0u64
    }
    machine bad() -> u64 {
        crash Trap;
    }
}

linux_x86_64 machine evaluate_prod() -> u64 crashes Trap
ensures result == 0u64
{
    let prod: u64 = compute_prod(21u64, 10u64);
    verify_prod(prod)
}

linux_arm64 machine evaluate_prod() -> u64 crashes Trap
ensures result == 0u64
{
    let prod: u64 = compute_prod(21u64, 10u64);
    verify_prod(prod)
}

macos_arm64 machine evaluate_prod() -> u64 crashes Trap
ensures result == 0u64
{
    let prod: u64 = compute_prod(21u64, 10u64);
    verify_prod(prod)
}

windows_x86_64 machine evaluate_prod() -> u64 crashes Trap
ensures result == 0u64
{
    let prod: u64 = compute_prod(21u64, 10u64);
    verify_prod(prod)
}

machine probe() -> u64 crashes Trap
ensures result == 0u64
{
    evaluate_prod()
}

machine main() crashes Trap {
    transition probe() == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
