machine build(builder: &mut Build) {
    Build::select_provider<SelectedWeightedTenSum, CheckedWeightedTenSum>(builder, linux_x86_64);
    Build::select_provider<SelectedWeightedTenSum, CheckedWeightedTenSum>(builder, linux_arm64);
    Build::select_provider<SelectedWeightedTenSum, CheckedWeightedTenSum>(builder, macos_arm64);
    Build::select_provider<SelectedWeightedTenSum, CheckedWeightedTenSum>(builder, windows_x86_64);

    Build::application(builder, "abi_multi_arg_spill_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
