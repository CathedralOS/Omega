// Another state's `requires` stays refuted when the closed result is 9.
machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine nine() -> u64 { 9u64 }

machine carry() -> u64 {
    let scale: u64 = nine();
    transition { _ -> hold(scale) }
    state hold(scale: u64) -> u64
    requires scale <= 5
    {
        echo(scale)
    }
}
data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;

    let r: u64 = carry();
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
