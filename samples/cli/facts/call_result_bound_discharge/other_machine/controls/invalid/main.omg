// Another machine's closed result of 9 does not discharge `consume`.
machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine nine() -> u64 { 9u64 }

machine produce() -> u64 {
    nine()
}
machine consume(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}
data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;

    let r: u64 = consume(produce());
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
