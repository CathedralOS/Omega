// A callee's `requires` discharges on a bound received as a parameter.
// `deliver` is called with `opaque()`'s closed result 4, so its
// `scale <= 5` proves, and that parameter still discharges `echo`.
//
// Compile-checked only: no standard-library dependency and no
// ProcessExit provider. The check is the oracle.

machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine opaque() -> u64 { 4u64 }

machine deliver(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;

    let s: u64 = opaque();
    let r: u64 = deliver(s);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
