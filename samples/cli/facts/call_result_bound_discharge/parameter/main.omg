// A callee's `requires` discharges on a bound received as a parameter.
// `deliver` is called with `opaque()`'s closed result 4, so its
// `scale <= 5` proves, and that parameter still discharges `echo`.
//
// Expected exit: 0

machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine opaque() -> u64 { 4u64 }

machine deliver(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) crashes Trap {
    main.hits = 0;

    let s: u64 = opaque();
    let r: u64 = deliver(s);
    transition r == 4 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
