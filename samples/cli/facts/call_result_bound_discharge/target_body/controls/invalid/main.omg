// A target body's `requires` stays refuted when the closed result is 9.
machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine nine() -> u64 { 9u64 }

boundary trait SelectedTake {
    machine take(scale: u64) -> u64 reaches
requires scale <= 5;
}
CheckedTake satisfies SelectedTake {
    machine take(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}
}



data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;

    let s: u64 = nine();
    let r: u64 = SelectedTake::take(s);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}
