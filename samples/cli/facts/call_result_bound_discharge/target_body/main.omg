// Every target body discharges a callee `requires` on a closed call
// result. `take` is the target-scoped callee; `opaque()`'s result 4
// proves `scale <= 5` in each body, which still discharges `echo`.
//
// Expected exit: 0

machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine opaque() -> u64 { 4u64 }

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTake {
    machine take(scale: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires scale <= 5;
}

X86Take satisfies SelectedTake {
    machine take(scale: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires scale <= 5
    {
        SelectedBodyCheck::require_tag(17u64);
        echo(scale)
    }
}

ArmTake satisfies SelectedTake {
    machine take(scale: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires scale <= 5
    {
        SelectedBodyCheck::require_tag(29u64);
        echo(scale)
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;

    let s: u64 = opaque();
    let r: u64 = SelectedTake::take(s);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    entry_start();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    entry_start();
}
