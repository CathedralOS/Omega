// A match join of two closed call results still discharges a callee
// `requires`. Both arms return `opaque()`'s 4, so the joined `scale`
// proves `scale <= 5` at `echo`.
//
// Expected exit: 0

machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine opaque() -> u64 { 4u64 }

machine choose(flag: bool) -> u64 {
    let scale: u64 = match flag { true -> opaque(), false -> opaque() };
    echo(scale)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;

    let r: u64 = choose(true);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
