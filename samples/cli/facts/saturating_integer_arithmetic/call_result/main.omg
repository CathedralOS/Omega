// Clamping or bounding an unsigned sum/value at a ceiling (`clamped >= 10u64 && clamped <= 100u64`) establishes both lower and upper interval bounds across all nine places, discharging exact subtraction `100u64 - clamped` and `clamped - 10u64` without overflow.
// Place: call result. Calls with declared bounds supply the clamped value.
// Expected exit: 0

machine clamp(val: u64) -> u64
    ensures result >= 10u64 && result <= 100u64
{
    transition val < 10u64 {
        true -> 10u64
        _ -> check_high(val)
    }
    state check_high(v: u64)
        requires v >= 10u64
    {
        transition v > 100u64 {
            true -> 100u64
            _ -> v
        }
    }
}

machine supply(c: u64) -> u64
    requires c >= 10u64 && c <= 100u64
    ensures result >= 10u64 && result <= 100u64
{
    c
}

machine compute(c: u64) -> u64
    requires c >= 10u64 && c <= 100u64
{
    let clamped: u64 = supply(c);
    let headroom: u64 = 100u64 - clamped;
    let above_floor: u64 = clamped - 10u64;
    headroom + above_floor
}

machine probe(val: u64) -> u64
    requires val >= 10u64 && val <= 100u64
{
    compute(val)
}

machine main() crashes Trap {
    let raw: u64 = 60u64;
    let clamped: u64 = clamp(raw);
    let total: u64 = probe(clamped);
    transition total == 90u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
