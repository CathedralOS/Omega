use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "coupled_requires_construction_target_body" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Advance, |app|::X86Advance>(builder, windows_x86_64);
    Build::select_provider::<|app|::Advance, |app|::X86Advance>(builder, linux_x86_64);
    Build::select_provider::<|app|::Advance, |app|::ArmAdvance>(builder, macos_arm64);
    Build::select_provider::<|app|::Advance, |app|::ArmAdvance>(builder, linux_arm64);
}
