// Invalid control for the const-name place. A const name of 1 does not
// prove operand order, so `REMAINING - 2` is not exact u64.
const REMAINING: u64 = 1;

machine walk() -> u64
requires
    REMAINING <= 5
{
    REMAINING - 2
}

data Main {
    hits: i32 in Wrapping;
}

machine check_subtraction(main: @mutable Main) {
    main.hits = 0i32 as +Wrapping;
    transition walk() == 2 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1i32 as +Wrapping; }
    machine fail(main: @mutable Main) { main.hits = (-1i32) as +Wrapping; }
}
