// Invalid control for the target-body place. `requires remaining <= 5` does not prove
// `remaining >= 2`, so `remaining - 2` is not exact u64. No domain, no `as`.

boundary trait SelectedDeduct {
    machine deduct(remaining: u64) -> u64 reaches
requires
    remaining <= 5;
}
CheckedDeduct satisfies SelectedDeduct {
    machine deduct(remaining: u64) -> u64
requires
    remaining <= 5;
{
    remaining - 2
}
}







machine walk(remaining: u64) -> u64
requires
    remaining <= 5;
{
    SelectedDeduct::deduct(remaining)
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition walk(4) == 2 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}
