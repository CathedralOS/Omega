// Exact subtraction discharged by requires + guard: `remaining - 2`
// is exact u64 arithmetic because the entry `requires remaining <= 5`
// bounds the value and the `remaining >= 2` transition guard proves
// the operand order. No domain, no `as`.
//
// Place: another target body.
// Compile-checked only: no ProcessExit provider.

linux_x86_64 machine deduct(remaining: u64) -> u64
requires
    remaining <= 5 && remaining >= 2;
{
    remaining - 2
}

linux_arm64 machine deduct(remaining: u64) -> u64
requires
    remaining <= 5 && remaining >= 2;
{
    remaining - 2
}

macos_arm64 machine deduct(remaining: u64) -> u64
requires
    remaining <= 5 && remaining >= 2;
{
    remaining - 2
}

windows_x86_64 machine deduct(remaining: u64) -> u64
requires
    remaining <= 5 && remaining >= 2;
{
    remaining - 2
}

machine walk(remaining: u64) -> u64
requires
    remaining <= 5;
{
    transition remaining >= 2 {
        true -> deduct(remaining)
        false -> remaining
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition walk(4) == 2 && walk(1) == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
