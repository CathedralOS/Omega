// Exact subtraction discharged by requires + guard: `remaining - 2`
// is exact u64 arithmetic because the entry `requires remaining <= 5`
// bounds the value and the `remaining >= 2` transition guard proves
// the operand order. No domain, no `as`.
//
// Place: another machine.
// Expected exit: 0

machine publish(remaining: u64) -> u64
requires
    remaining <= 5 && remaining >= 2;
ensures
    result == remaining;
{
    remaining
}

machine deduct(value: u64) -> u64
requires
    value <= 5 && value >= 2;
{
    value - 2
}

machine walk(remaining: u64) -> u64
requires
    remaining <= 5;
{
    transition remaining >= 2 {
        true -> deduct(publish(remaining))
        false -> remaining
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    transition walk(4) == 2 && walk(1) == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
