// Exact subtraction discharged by requires + guard: `remaining - 2`
// is exact u64 arithmetic because the entry `requires remaining <= 5`
// bounds the value and the `remaining >= 2` transition guard proves
// the operand order. No domain, no `as`.
//
// Place: call result.
// Expected exit: 0

machine supply(remaining: u64) -> u64
requires
    remaining <= 5 && remaining >= 2
ensures
    result == remaining
{
    remaining
}

machine walk(remaining: u64) -> u64
requires
    remaining <= 5
{
    transition remaining >= 2 {
        true -> finish(supply(remaining) - 2),
        false -> remaining
    }
    machine finish(value: u64) -> u64 { value }
}

data Main {
    hits: i32 in Wrapping;
}

machine check_subtraction(main: @mutable Main) crashes Trap {
    main.hits = 0i32 as +Wrapping;
    transition walk(4) == 2 && walk(1) == 1 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1i32 as +Wrapping; }
    machine fail(main: @mutable Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mutable entry_storage: Main = Main { hits: 0i32 as +Wrapping };
    check_subtraction(@mutable entry_storage);
}
