// Fact: subtracting two bounded signed i64 values establishes the exact post-subtraction interval, discharging a downstream contract requiring diff >= 50i64 && diff <= 80i64 across all nine places.
// Place: target_body (invalid twin). Minuend bound is weakened so the difference can fall below 50, failing the downstream contract.
// Expected diagnostic: cannot prove requires contract for call consume
machine consume(diff: i64) -> i32
    requires diff >= 50 && diff <= 80
{
    let u: u64 = diff as u64;
    let sub: u64 = u - 50u64;
    sub as i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSubtractSigned {
    machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires minuend >= 79 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30;
}

X86SubtractSigned satisfies SelectedSubtractSigned {
    machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires minuend >= 79 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
    {
        SelectedBodyCheck::require_tag(17u64);
        let diff: i64 = minuend - subtrahend;
        consume(diff)
    }
}

ArmSubtractSigned satisfies SelectedSubtractSigned {
    machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires minuend >= 79 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
    {
        SelectedBodyCheck::require_tag(29u64);
        let diff: i64 = minuend - subtrahend;
        consume(diff)
    }
}

machine evaluate() -> i32 {
    SelectedSubtractSigned::subtract_signed(79, 25)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 15 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
