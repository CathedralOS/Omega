// Fact: subtracting two bounded signed i64 values establishes the exact post-subtraction interval, discharging a downstream contract requiring diff >= 50i64 && diff <= 80i64 across all nine places.
// Place: other_state (invalid twin). Minuend bound is weakened so the difference can fall below 50, failing the downstream contract.
// Expected diagnostic: cannot prove requires contract for call consume
machine consume(diff: i64) -> i32
    requires diff >= 50 && diff <= 80
{
    let u: u64 = diff as u64;
    let sub: u64 = u - 50u64;
    sub as i32
}

machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
    requires minuend >= 79 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: i64 = minuend - subtrahend;
    transition { _ -> step(diff) }
    state step(d: i64) -> i32 {
        consume(d)
    }
}

machine evaluate() -> i32 {
    subtract_signed(79, 25)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 15 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
