machine build(builder: &mut Build) {
    Build::application(builder, "representation_conversion_target_body");
    Build::select_provider<FrameDelivery, SecondDelivery>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main_other);
    Build::select_provider<FrameDelivery, SecondDelivery>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main_other);
    Build::select_provider<FrameDelivery, FirstDelivery>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main_arm);
    Build::select_provider<FrameDelivery, SecondDelivery>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main_other);
}
