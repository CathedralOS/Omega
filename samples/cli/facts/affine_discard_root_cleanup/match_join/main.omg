// Fact: an unconsumed nominal resource whose drop contract requires valid == 1u64 executes deterministic affine scope-exit cleanup while preserving result <= 50u64 so 50u64 - result succeeds.
// Expected exit: 0

data Counter {
    value: u64;
}

data Resource {
    dropped: &mut Counter;
    valid: u64;
    value: u64;
}

machine Resource::drop(resource: &mut Resource)
requires resource.valid == 1u64
{
    resource.dropped.value = resource.valid;
    resource.valid = 0u64;
}

machine exercise(dropped: &mut Counter, flag: bool) -> u64
ensures result <= 50u64
{
    let res: Resource = match flag {
        true -> Resource { dropped: dropped, valid: 1u64, value: 30u64 },
        false -> Resource { dropped: dropped, valid: 1u64, value: 20u64 }
    };
    res.value
}

machine main() crashes Trap {
    let mut dropped_true: Counter = Counter { value: 0u64 };
    let mut dropped_false: Counter = Counter { value: 0u64 };
    let result_true: u64 = exercise(&mut dropped_true, true);
    let result_false: u64 = exercise(&mut dropped_false, false);
    let diff_true: u64 = 50u64 - result_true;
    let diff_false: u64 = 50u64 - result_false;
    transition diff_true == 20u64 && diff_false == 30u64 && dropped_true.value == 1u64 && dropped_false.value == 1u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
