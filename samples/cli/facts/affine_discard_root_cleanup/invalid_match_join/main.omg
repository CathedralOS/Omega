// Fact: an unconsumed nominal resource whose drop contract requires valid == 1u64 executes deterministic affine scope-exit cleanup while preserving result <= 50u64 so 50u64 - result succeeds.
// Expected exit: 0

data Counter {
    value: u64;
}

data Resource<'view> dropped by drop_resource {
    dropped: @'view mutable Counter;
    valid: u64;
    value: u64;
}

machine drop_resource(resource: Resource)
requires resource.valid == 1u64
{
    let { dropped, valid, value as _ } = move resource;
    dropped.value = valid;
}

machine exercise(dropped: @mutable Counter, flag: bool) -> u64
ensures result <= 50u64
{
    let counter: @mutable Counter = dropped;
    let res: Resource = match flag {
        true -> Resource { dropped: counter, valid: 0u64, value: 30u64 },
        false -> Resource { dropped: counter, valid: 0u64, value: 20u64 }
    };
    res.value
}

machine main() crashes Trap {
    let mutable dropped_true: Counter = Counter { value: 0u64 };
    let mutable dropped_false: Counter = Counter { value: 0u64 };
    let result_true: u64 = exercise(@mutable dropped_true, true);
    let result_false: u64 = exercise(@mutable dropped_false, false);
    let diff_true: u64 = 50u64 - result_true;
    let diff_false: u64 = 50u64 - result_false;
    transition diff_true == 20u64 && diff_false == 30u64 && dropped_true.value == 1u64 && dropped_false.value == 1u64 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
