// Fact: an unconsumed nominal resource whose drop contract requires valid == 1u64 executes deterministic affine scope-exit cleanup while preserving result <= 50u64 so 50u64 - result succeeds.
// Expected exit: 0

data Counter {
    value: u64;
}

data Resource {
    dropped: &mut Counter;
    valid: u64;
    value: u64;
}

machine Resource::drop(resource: &mut Resource)
requires resource.valid == 1u64
{
    resource.dropped.value = resource.valid;
    resource.valid = 0u64;
}

machine consume_param(res: Resource) -> u64
requires res.valid == 0u64 && res.value <= 50u64
ensures result <= 50u64
{
    res.value
}

machine exercise(dropped: &mut Counter) -> u64
ensures result <= 50u64
{
    let res: Resource = Resource { dropped: dropped, valid: 0u64, value: 30u64 };
    consume_param(res)
}

machine main() crashes Trap {
    let mut dropped: Counter = Counter { value: 0u64 };
    let result: u64 = exercise(&mut dropped);
    let diff: u64 = 50u64 - result;
    transition diff == 20u64 && dropped.value == 1u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
