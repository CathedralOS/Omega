// Fact: a 16-bit signed i16 remainder operation (dividend % divisor where dividend >= 0i16 && dividend <= 100i16, divisor >= 16i16 && divisor <= 16i16) establishes rem >= 0i16 && rem <= 15i16 so exact 16-bit signed subtraction 15i16 - rem is proved overflow-free across all nine places.
// Place: call_result. A function call returns the 16-bit remainder into subtraction verification.
// Expected exit: 0

machine verify_rem(rem: i16) -> i32
requires rem >= 0i16 && rem <= 15i16
{
    let headroom: i16 = 15i16 - rem;
    0i32
}

machine remainder(dividend: i16, divisor: i16) -> i16
requires dividend >= 0i16 && dividend <= 100i16 && divisor >= 16i16 && divisor <= 16i16
ensures result >= 0i16 && result <= 15i16
{
    dividend % divisor
}

machine compute_call(dividend: i16, divisor: i16) -> i32
requires dividend >= 0i16 && dividend <= 100i16 && divisor >= 16i16 && divisor <= 16i16
{
    verify_rem(remainder(dividend, divisor))
}

machine probe() -> i32 {
    compute_call(43i16, 16i16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
