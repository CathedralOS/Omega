// Fact: a 16-bit signed i16 remainder operation (dividend % divisor where dividend >= 0i16 && dividend <= 100i16, divisor >= 16i16 && divisor <= 16i16) establishes rem >= 0i16 && rem <= 15i16 so exact 16-bit signed subtraction 15i16 - rem is proved overflow-free across all nine places.
// Invalid: target bodies compute 16 % 17 = 16i16, violating verify_rem contract. Place: target_body.
// Expected diagnostic: cannot prove requires contract for call verify_rem

machine verify_rem(rem: i16) -> i32
requires rem >= 0i16 && rem <= 15i16
{
    let headroom: i16 = 15i16 - rem;
    0i32
}

linux_x86_64 machine verify_target() -> i32 {
    let dividend: i16 = 16i16;
    let divisor: i16 = 17i16;
    let rem: i16 = dividend % divisor;
    verify_rem(rem)
}

linux_arm64 machine verify_target() -> i32 {
    let dividend: i16 = 16i16;
    let divisor: i16 = 17i16;
    let rem: i16 = dividend % divisor;
    verify_rem(rem)
}

macos_arm64 machine verify_target() -> i32 {
    let dividend: i16 = 16i16;
    let divisor: i16 = 17i16;
    let rem: i16 = dividend % divisor;
    verify_rem(rem)
}

windows_x86_64 machine verify_target() -> i32 {
    let dividend: i16 = 16i16;
    let divisor: i16 = 17i16;
    let rem: i16 = dividend % divisor;
    verify_rem(rem)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
