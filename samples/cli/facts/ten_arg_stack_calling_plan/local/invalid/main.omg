// Fact: a 10-argument machine call across register and stack ABI lanes preserves the 10th stack-spilled argument bound 40u64 <= a10 <= 80u64 across all nine places so 80u64 - carried and carried - 40u64 are safe.
// Place: local. Both the 10-argument call inputs and the carried 10th argument are transported through local bindings.
// Expected exit: 0
machine verify_carried(carried: u64) -> u64
    requires carried >= 40 && carried <= 80
{
    let head: u64 = 80 - carried;
    let tail: u64 = carried - 40;
    head + tail
}

machine relay_ten(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64, a10: u64
) -> u64
    ensures result == a10
{
    a10
}

machine compute_local(v10: u64) -> u64
    requires v10 >= 40 && v10 <= 81
{
    let a1: u64 = 1;
    let a2: u64 = 2;
    let a3: u64 = 3;
    let a4: u64 = 4;
    let a5: u64 = 5;
    let a6: u64 = 6;
    let a7: u64 = 7;
    let a8: u64 = 8;
    let a9: u64 = 9;
    let a10: u64 = v10;
    let carried: u64 = relay_ten(a1, a2, a3, a4, a5, a6, a7, a8, a9, a10);
    let c: u64 = carried;
    let transported: u64 = c;
    verify_carried(transported)
}

machine evaluate() -> u64 {
    compute_local(60)
}

machine main() crashes Trap {
    let res: u64 = evaluate();
    transition res == 40 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
