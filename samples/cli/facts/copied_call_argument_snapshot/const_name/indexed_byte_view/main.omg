// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Place: const_name.
// Expected exit: 0
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
data Counted<'storage, Count: u64> [copy]
where view.bytes.len == Count
{ view: View<'storage>; }
machine snapshot<'storage>(source: View<'storage>) -> Counted<'storage, (source.bytes.len)>
{ Counted { view: source } }
trait Counting {
    machine snapshot<'storage>(source: View<'storage>) -> Counted<'storage, (source.bytes.len)>;
}
Direct satisfies Counting {
    machine snapshot<'storage>(source: View<'storage>) -> Counted<'storage, (source.bytes.len)>
    { Counted { view: source } }
}
machine overwrite<'storage>(slot: &mut View<'storage>) -> u64 { slot.bytes = "123456789"; 0 }
machine seven(value: u64) -> u64 requires value == 7 ensures result == 7 { value }
const REQUIRED_LENGTH: u64 = 7;
machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<'storage, REQUIRED_LENGTH> = selected; seven(saved.view.bytes.len) }
machine main() crashes Trap {
    let storage: [u8; 7] = [49, 50, 51, 52, 53, 54, 55];
    let mut direct: View = View { bytes: &storage[..], sibling: "tail" };
    let observed: u64 = receive(snapshot(direct), overwrite(&mut direct));
    let difference: u64 = observed - 7;
    let mut public: View = View { bytes: &storage[..], sibling: "tail" };
    let public_observed: u64 = receive(Counting::snapshot(Direct as dyn Counting, public), overwrite(&mut public));
    let public_difference: u64 = public_observed - 7;
    transition difference == 0 && public_difference == 0 && direct.bytes.len == 9 && public.bytes.len == 9 && direct.sibling.len == 4 && public.sibling.len == 4 {
        true -> done() false -> wrong()
    }
    state done() {} state wrong() { crash Trap; }
}
