// Expected rejection: cannot prove requires contract for call receive
// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Place: target_body.
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
const WINDOW_LENGTH: u64 = 9;
machine initial_snapshot<'storage>(source: View<'storage>) -> View<'storage>
requires source.bytes.len == 11 && source.sibling.len == 4
ensures result.bytes.len == WINDOW_LENGTH, result.sibling.len == 4
{ View { bytes: &source.bytes[2..2 + WINDOW_LENGTH], sibling: source.sibling } }
machine callback_keep<'storage>(selected: View<'storage>) -> View<'storage>
ensures result.bytes.len == selected.bytes.len, result.sibling.len == selected.sibling.len
{ selected }
machine retain_callback<'storage, machine Callback>(selected: View<'storage>) -> View<'storage>
where machine Callback<'invocation>(operand: View<'invocation>) -> View<'invocation>
ensures result.bytes.len == operand.bytes.len, result.sibling.len == operand.sibling.len;
ensures result.bytes.len == selected.bytes.len, result.sibling.len == selected.sibling.len
{ Callback(selected) }
trait Composing {
    machine compose<'storage>(bytes: &'storage [u8], sibling: &'storage [u8]) -> View<'storage>
    ensures result.bytes.len == bytes.len, result.sibling.len == sibling.len;
}
Joined satisfies Composing {
    machine compose<'storage>(bytes: &'storage [u8], sibling: &'storage [u8]) -> View<'storage>
    ensures result.bytes.len == bytes.len, result.sibling.len == sibling.len
    { View { bytes: bytes, sibling: sibling } }
}
JoinedCopy satisfies Composing {
    machine compose<'storage>(bytes: &'storage [u8], sibling: &'storage [u8]) -> View<'storage>
    ensures result.bytes.len == bytes.len, result.sibling.len == sibling.len
    { let held: View = View { bytes: bytes, sibling: sibling }; held }
}
machine select_composer(first: bool) -> dyn Composing {
    transition first { true -> (Joined as dyn Composing) false -> (JoinedCopy as dyn Composing) }
}
trait Preserving {
    machine retain<'storage>(selected: View<'storage>) -> View<'storage>
    ensures result.bytes.len == selected.bytes.len, result.sibling.len == selected.sibling.len;
}
Direct satisfies Preserving {
    machine retain<'storage>(selected: View<'storage>) -> View<'storage>
    ensures result.bytes.len == selected.bytes.len, result.sibling.len == selected.sibling.len
    { selected }
}
Copied satisfies Preserving {
    machine retain<'storage>(selected: View<'storage>) -> View<'storage>
    ensures result.bytes.len == selected.bytes.len, result.sibling.len == selected.sibling.len
    { let held: View = selected; held }
}
machine select_preserver(first: bool) -> dyn Preserving {
    transition first { true -> (Direct as dyn Preserving) false -> (Copied as dyn Preserving) }
}
machine overwrite<'storage>(slot: &mut View<'storage>, replacement: &'storage [u8]) -> u64 {
    slot.bytes = replacement;
    0
}
data Counter { called: bool; }
machine replacement<'storage>(source: &'storage [u8], destination: &mut [View<'storage>; 2], counter: &mut Counter) -> &'storage [u8]
requires source.len == 9
ensures result.len == 9
{
    counter.called = !counter.called;
    destination[0].bytes = source;
    let returned: &[u8] = destination[0].bytes;
    returned
}
machine install_selected<'storage>(slot: &mut View<'storage>, selected: View<'storage>, ignored: u64) -> u64 {
    slot.bytes = selected.bytes;
    0
}
machine install_view<'storage>(slot: &mut View<'storage>, selected: &'storage [u8], ignored: u64) -> u64 {
    slot.bytes = selected;
    0
}
machine choose<'storage>(selected: &'storage [u8], ignored: u64) -> &'storage [u8] { selected }
machine view_after<'storage>(ignored: u64, selected: &'storage [u8]) -> &'storage [u8] { selected }
machine tail_after(ignored: u64) -> &[u8] { "tail" }
machine pure_replacement() -> &[u8] ensures result.len == 9 { "123456789" }
machine seven(value: u64) -> u64
requires value == 7
ensures result == 7
{ value }
machine retain_view<'storage>(selected: View<'storage>, remaining: u64)
requires remaining <= 2
terminates by remaining -> Nat::Descending in 0..=2;
-> View<'storage>
ensures result.bytes.len == selected.bytes.len, result.sibling.len == selected.sibling.len
{
    transition remaining > 0 {
        true -> retain_view(selected, remaining - 1)
        false -> selected
    }
}
windows_x86_64 machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
requires selected.bytes.len == 7
ensures result == 7
{
    seven(selected.bytes.len)
}

linux_x86_64 machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
requires selected.bytes.len == 7
ensures result == 7
{
    seven(selected.bytes.len)
}

macos_arm64 machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
requires selected.bytes.len == 7
ensures result == 7
{
    seven(selected.bytes.len)
}

linux_arm64 machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
requires selected.bytes.len == 7
ensures result == 7
{
    seven(selected.bytes.len)
