// Expected rejection: cannot prove requires contract for call receive
// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Place: target_body.
data View<'storage> [copy] { bytes: &'storage [u8]; }
machine overwrite<'storage>(slot: &mut View<'storage>, replacement: &'storage [u8]) -> u64 {
    slot.bytes = replacement;
    0
}
machine seven(value: u64) -> u64
requires value == 7
ensures result == 7
{ value }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReceive {
    machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires selected.bytes.len == 7 ensures result == 7;
}

X86Receive satisfies SelectedReceive {
    machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires selected.bytes.len == 7 ensures result == 7
    {
        SelectedBodyCheck::require_tag(17u64);
        seven(selected.bytes.len)
    }
}

ArmReceive satisfies SelectedReceive {
    machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires selected.bytes.len == 7 ensures result == 7
    {
        SelectedBodyCheck::require_tag(29u64);
        seven(selected.bytes.len)
    }
}


machine main() crashes Trap {
    let first: &[u8] = "123456789";
    let second: &[u8] = "123456789";
    let mut original: View = View { bytes: first };
    let observed: u64 = SelectedReceive::receive(original, overwrite(&mut original, second));
    let difference: u64 = observed - 7;
    transition difference == 0 && original.bytes.len == 9 {
        true -> done() false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
