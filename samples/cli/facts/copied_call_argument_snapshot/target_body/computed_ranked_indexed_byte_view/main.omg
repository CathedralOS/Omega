// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Place: target_body.
// Expected exit: 0
data Counter { value: bool; }
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
data Counted<'storage, Count: u64> [copy]
where view.bytes.len == Count
{ view: View<'storage>; }
machine previous(value: u64) -> u64
requires value > 0
ensures result == value - 1
{ value - 1 }
machine retain_counted<'storage, Count: u64>(selected: Counted<'storage, Count>, remaining: u64)
requires remaining <= 2
terminates by remaining -> Nat::Descending in 0..=2;
-> Counted<'storage, Count>
{
    transition remaining > 0 {
        true -> retain_counted<Count>(selected, previous(remaining))
        false -> selected
    }
}
machine snapshot<'storage>(source: View<'storage>, counter: &mut Counter) -> Counted<'storage, (source.bytes.len)>
{ counter.value = !counter.value; retain_counted<(source.bytes.len)>(Counted { view: source }, 2) }
trait Counting {
    machine snapshot<'storage>(source: View<'storage>, counter: &mut Counter) -> Counted<'storage, (source.bytes.len)>;
}
Direct satisfies Counting {
    machine snapshot<'storage>(source: View<'storage>, counter: &mut Counter) -> Counted<'storage, (source.bytes.len)>
    { counter.value = !counter.value; retain_counted<(source.bytes.len)>(Counted { view: source }, 2) }
}
machine overwrite<'storage>(slot: &mut View<'storage>) -> u64 { slot.bytes = "123456789"; 0 }
machine seven(value: u64) -> u64 requires value == 7 ensures result == 7 { value }
windows_x86_64 machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<'storage, 7> = selected; seven(saved.view.bytes.len) }

linux_x86_64 machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<'storage, 7> = selected; seven(saved.view.bytes.len) }

macos_arm64 machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<'storage, 7> = selected; seven(saved.view.bytes.len) }

linux_arm64 machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<'storage, 7> = selected; seven(saved.view.bytes.len) }
machine receive_inferred<'storage, Count: u64>(selected: Counted<'storage, Count>, ignored: u64) -> u64
requires Count == 7
ensures result == 7
{ receive(selected, ignored) }
machine main() crashes Trap {
    let storage: [u8; 7] = [49, 50, 51, 52, 53, 54, 55];
    let mut direct_counter: Counter = Counter { value: false };
    let mut direct: View = View { bytes: &storage[..], sibling: "tail" };
    let observed: u64 = receive_inferred(snapshot(direct, &mut direct_counter), overwrite(&mut direct));
    let difference: u64 = observed - 7;
    let mut public_counter: Counter = Counter { value: false };
    let mut public: View = View { bytes: &storage[..], sibling: "tail" };
    let public_observed: u64 = receive_inferred(Counting::snapshot(Direct as dyn Counting, public, &mut public_counter), overwrite(&mut public));
    let public_difference: u64 = public_observed - 7;
    transition direct_counter.value && public_counter.value && difference == 0 && public_difference == 0 && direct.bytes.len == 9 && public.bytes.len == 9 && direct.sibling.len == 4 && public.sibling.len == 4 {
        true -> done() false -> wrong()
    }
    machine done() {} machine wrong() { crash Trap; }
}
