// A copied first argument equal to 7 stays 7 when the second argument overwrites its former home with 9.
// Place: target_body.
// The first copied operand is 9 and cannot establish the required 7.
machine overwrite(slot: &mut u64) -> u64
ensures slot == 9
{
    slot = 9;
    0
}
machine seven(value: u64) -> u64
requires value == 7
ensures result == 7
{
    value
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReceive {
    machine receive(first: u64, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires first == 7 ensures result == 7;
}

X86Receive satisfies SelectedReceive {
    machine receive(first: u64, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires first == 7 ensures result == 7
    {
        SelectedBodyCheck::require_tag(17u64);
        seven(first)
    }
}

ArmReceive satisfies SelectedReceive {
    machine receive(first: u64, ignored: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires first == 7 ensures result == 7
    {
        SelectedBodyCheck::require_tag(29u64);
        seven(first)
    }
}


machine main() crashes Trap {
    let mut source: u64 = 9;
    let observed: u64 = SelectedReceive::receive(source, overwrite(&mut source));
    let difference: u64 = observed - 7;
    transition difference == 0 && source == 9 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
