// Expected exit: 0

data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
machine selected<'storage>(source: View<'storage>, start: u64) -> View<'storage>
requires source.bytes.len == 9 && source.sibling.len == 4 && start <= 2
ensures result.bytes.len == 7, result.sibling.len == 4
{ View { bytes: &source.bytes[start..start + 7], sibling: source.sibling } }
machine inclusive<'storage>(source: View<'storage>) -> View<'storage>
requires source.bytes.len == 9 && source.sibling.len == 4
ensures result.bytes.len == 7
{ View { bytes: &source.bytes[2..=8], sibling: source.sibling } }
machine suffix<'storage>(source: View<'storage>) -> View<'storage>
requires source.bytes.len == 9 && source.sibling.len == 4
ensures result.bytes.len == 7
{ View { bytes: &source.bytes[2..], sibling: source.sibling } }
machine empty<'storage>(source: View<'storage>) -> View<'storage>
requires source.bytes.len == 9 && source.sibling.len == 4
ensures result.bytes.len == 0
{ View { bytes: &source.bytes[2..2], sibling: source.sibling } }
machine main() crashes Trap {
    let storage: [u8; 9] = [11, 2, 29, 4, 5, 6, 7, 8, 9];
    let source: View = View { bytes: &storage[..], sibling: "tail" };
    let first: View = selected(source, 0);
    let second: View = selected(source, 2);
    let third: View = inclusive(source);
    let fourth: View = suffix(source);
    let vacant: View = empty(source);
    let first_byte: u8 = first.bytes[0];
    let second_byte: u8 = second.bytes[0];
    let third_byte: u8 = third.bytes[0];
    let fourth_byte: u8 = fourth.bytes[0];
    let first_difference: u64 = first.bytes.len - 7;
    let second_difference: u64 = second.bytes.len - 7;
    let third_difference: u64 = third.bytes.len - 7;
    let fourth_difference: u64 = fourth.bytes.len - 7;
    transition first_difference == 0 && second_difference == 0 && third_difference == 0 && fourth_difference == 0
        && vacant.bytes.len == 0 && first_byte == 11 && second_byte == 29 && third_byte == 29 && fourth_byte == 29 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
