public data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
public trait Installing {
    machine install<'storage>(destination: &mut View<'storage>, source: &mut View<'storage>) -> u64
    ensures destination.bytes.len == source.sibling.len;
}
Installer satisfies Installing {
    machine install<'storage>(destination: &mut View<'storage>, source: &mut View<'storage>) -> u64
    ensures source.bytes.len == destination.sibling.len
    { source.bytes = destination.sibling; 0 }
}
machine main() {}
