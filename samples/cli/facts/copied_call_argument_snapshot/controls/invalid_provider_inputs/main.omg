public data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
public trait Installing {
    machine install<'storage>(destination: &mut View<'storage>, first: View<'storage>, second: View<'storage>) -> u64
    ensures destination.bytes.len == first.bytes.len;
}
Installer satisfies Installing {
    machine install<'storage>(destination: &mut View<'storage>, first: View<'storage>, second: View<'storage>) -> u64
    ensures destination.bytes.len == second.bytes.len
    { destination.bytes = second.bytes; 0 }
}
machine main() {}
