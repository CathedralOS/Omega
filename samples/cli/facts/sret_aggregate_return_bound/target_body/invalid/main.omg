// Fact: returning a 24-byte three-field structural record (Triple { a: u64, b: u64, c: u64 }) through an indirect sret aggregate return slot preserves its postcondition bound (result.c <= 90u64), discharging exact subtraction 90u64 - result.c across all nine places.
// Invalid: c field is 91u64 exceeding 90u64 bound, so 90u64 - c underflows. Place: target_body.
// Expected diagnostic: may overflow `u64`

data Triple [copy] where
    a >= 20u64 && a <= 20u64,
    b >= 30u64 && b <= 30u64,
    c >= 91u64 && c <= 91u64
{
    a: u64;
    b: u64;
    c: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedMakeTriple {
    machine make_triple() -> Triple
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result.c >= 91u64 && result.c <= 91u64;
}

X86MakeTriple satisfies SelectedMakeTriple {
    machine make_triple() -> Triple
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result.c >= 91u64 && result.c <= 91u64
    {
        SelectedBodyCheck::require_tag(17u64);
        Triple {
            a: 20,
            b: 30,
            c: 91,
        }
    }
}

ArmMakeTriple satisfies SelectedMakeTriple {
    machine make_triple() -> Triple
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result.c >= 91u64 && result.c <= 91u64
    {
        SelectedBodyCheck::require_tag(29u64);
        Triple {
            a: 20,
            b: 30,
            c: 91,
        }
    }
}

machine probe() -> u64
{
    let t: Triple = SelectedMakeTriple::make_triple();
    let remaining: u64 = 90u64 - t.c;
    let sum_ab: u64 = t.a + t.b;
    remaining - sum_ab
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
