// Fact: returning a 24-byte three-field structural record (Triple { a: u64, b: u64, c: u64 }) through an indirect sret aggregate return slot preserves its postcondition bound (result.c <= 90u64), discharging exact subtraction 90u64 - result.c across all nine places.
// Expected exit: 0

data Triple [copy] where
    a >= 20u64 && a <= 20u64,
    b >= 30u64 && b <= 30u64,
    c <= 90u64 && c >= 40u64 && c <= 40u64
{
    a: u64;
    b: u64;
    c: u64;
}

machine make_triple() -> Triple
ensures result.c <= 90u64 && result.c >= 40u64 && result.c <= 40u64
{
    Triple {
        a: 20,
        b: 30,
        c: 40,
    }
}

machine probe() -> u64
ensures result == 0u64
{
    let t: Triple = make_triple();
    let remaining: u64 = 90u64 - t.c;
    let sum_ab: u64 = t.a + t.b;
    remaining - sum_ab
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
