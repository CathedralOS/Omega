use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "float_result_equality_target_body_invalid" };
    Build::select_provider::<|app|::FloatObservation, |app|::SelectedFloatObservation>(builder, windows_x86_64);
    Build::select_provider::<|app|::FloatObservation, |app|::SelectedFloatObservation>(builder, linux_x86_64);
    Build::select_provider::<|app|::FloatObservation, |app|::SelectedFloatObservation>(builder, macos_arm64);
    Build::select_provider::<|app|::FloatObservation, |app|::SelectedFloatObservation>(builder, linux_arm64);
}
