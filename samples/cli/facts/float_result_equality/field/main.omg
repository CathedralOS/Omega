// A returned f64 equals the live field it came from.
// Expected exit: 0
data Ends { kept: f64; other: f64; }
data Holder { item: Ends; }

machine read_kept(holder: &Holder) -> f64
requires holder.item.kept == 7.0
ensures result == holder.item.kept && result == 7.0
{
    holder.item.kept
}

machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}

machine main() crashes Trap {
    let holder: Holder = Holder { item: Ends { kept: 7.0, other: 1.0 } };
    let saved: f64 = read_kept(&holder);
    transition agree(saved, holder.item.kept) == 7.0 { true -> done() _ -> bad() }

    machine done() {}
    machine bad() { crash Trap; }
}
