// Fact: 16-bit unsigned saturating subtraction lhs -| rhs with bounded interval 200u16 <= diff <= 450u16 establishes 200u16 <= diff <= 450u16 across all nine places so exact subtractions 450u16 - diff and diff - 200u16 are safe.
// Expected exit: 0

machine compute_sat(lhs: u16 in Saturating, rhs: u16 in Saturating) -> u16 in Saturating {
    lhs - rhs
}

machine verify_diff(diff: u16) -> i32
    requires diff >= 200 && diff <= 450
{
    let headroom: u16 = 450 - diff;
    let margin: u16 = diff - 200;
    let total: u16 = headroom + margin;
    let check: i32 = (total as i32) - 250;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: u16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 200 && val <= 450;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: u16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 200 && val <= 450
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_diff(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: u16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 200 && val <= 450
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_diff(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: u16 in Saturating = 400;
    let rhs: u16 in Saturating = 80;
    let diff_sat: u16 in Saturating = compute_sat(lhs, rhs);
    let diff: u16 = diff_sat as u16;
    let check: i32 = SelectedProbe::exercise(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
