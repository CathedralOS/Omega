// A const write of 41 at grid[1][2] becomes 42 after grid[i][j] = grid[i][j] + 1 with i == 1 and j == 2, and rows[2].data[1] becomes 42 after the same increment while rows[2].tag stays 7.
// The operation is that pair of read-modify-writes through borrowed caller storage.
// Expected exit: 0
const GRID_CELL: i32 = 41;
const ROW_CELL: i32 = 41;
const TAG: i32 = 7;
const I: u64 = 1;
const J: u64 = 2;
const RI: u64 = 2;
const RJ: u64 = 1;
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
machine main() crashes Trap {
    let mut grid: [[i32 in Wrapping; 4]; 3];
    let mut rows: [Row; 3];
    transition { _ -> rmw(&mut grid, &mut rows) }
    machine rmw(grid: &mut [[i32 in Wrapping; 4]; 3], rows: &mut [Row; 3]) {
        grid[I][J] = 40;
        grid[I][J] = grid[I][J] + 1;
        let grid_got: i32 in Wrapping = grid[I][J];
        rows[RI].data[RJ] = ROW_CELL;
        rows[RI].tag = TAG;
        rows[RI].data[RJ] = rows[RI].data[RJ] + 1;
        let rows_got: i32 in Wrapping = rows[RI].data[RJ] + rows[RI].tag;
        transition grid_got == GRID_CELL + 1 && rows_got == ROW_CELL + 1 + TAG
            { true -> done() _ -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
