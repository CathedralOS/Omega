// Explicit shared qualification erasure retains Issued and the same Ticket referent.
// Expected exit: 0
data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
domain Ticket::Label;
domain Ticket::Other established by issue_other;
domain Ticket::Observed = Ticket::Issued;
machine issue_other() -> Ticket in Ticket::Other { Ticket { number: 23 } }
domain Ticket::Labelled = Ticket::Issued & Ticket::Label;
machine issue() -> Ticket in Ticket::Labelled { Ticket { number: 17 } }
machine observe(ticket: &Ticket in Ticket::Observed) -> u64 { ticket.number }
machine main() crashes Trap {
    let ticket: Ticket in Ticket::Labelled = issue();
    let view: &Ticket in Ticket::Observed = (&ticket) as &Ticket in Ticket::Observed;
    let observed: u64 = observe(view);
    transition observed == 17 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
