// Fact: 16-bit signed wrapping subtraction lhs -% rhs with bounded interval 200i16 <= diff <= 450i16 establishes 200i16 <= diff <= 450i16 across all nine places so exact subtractions 450i16 - diff and diff - 200i16 are safe.
// Expected exit: 0

const MAX_DIFF: i16 = 450i16;
const MIN_DIFF: i16 = 200i16;

machine verify_diff(value: i16) -> i16
    requires value >= MIN_DIFF && value <= MAX_DIFF
{
    let headroom: i16 = MAX_DIFF - value;
    let margin: i16 = value - MIN_DIFF;
    headroom + margin
}

machine probe(lhs: i16, rhs: i16) -> i16
    requires lhs >= 300i16 && lhs <= 500i16 && rhs >= 50i16 && rhs <= 100i16
{
    let wl: i16 in Wrapping = lhs as i16 in Wrapping;
    let wr: i16 in Wrapping = rhs as i16 in Wrapping;
    let wd: i16 in Wrapping = wl - wr;
    let diff: i16 = wd as i16;
    verify_diff(diff)
}

machine main() crashes Trap {
    let combined: i16 = probe(400i16, 80i16);
    transition combined == 250i16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
