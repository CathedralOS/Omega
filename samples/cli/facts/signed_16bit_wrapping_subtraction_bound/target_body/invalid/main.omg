// Fact: 16-bit signed wrapping subtraction lhs -% rhs with bounded interval 200i16 <= diff <= 450i16 establishes 200i16 <= diff <= 450i16 across all nine places so exact subtractions 450i16 - diff and diff - 200i16 are safe.

machine verify_diff(value: i16) -> i16
    requires value >= 200i16 && value <= 450i16
{
    let headroom: i16 = 450i16 - value;
    let margin: i16 = value - 200i16;
    headroom + margin
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine target_probe(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 300i16 && lhs <= 520i16 && rhs >= 50i16 && rhs <= 100i16;
}

X86Probe satisfies SelectedProbe {
    machine target_probe(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 300i16 && lhs <= 520i16 && rhs >= 50i16 && rhs <= 100i16
    {
        SelectedBodyCheck::require_tag(17u64);
        let wl: i16 in Wrapping = lhs as i16 in Wrapping;
        let wr: i16 in Wrapping = rhs as i16 in Wrapping;
        let wd: i16 in Wrapping = wl - wr;
        let diff: i16 = wd as i16;
        verify_diff(diff)
    }
}

ArmProbe satisfies SelectedProbe {
    machine target_probe(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 300i16 && lhs <= 520i16 && rhs >= 50i16 && rhs <= 100i16
    {
        SelectedBodyCheck::require_tag(29u64);
        let wl: i16 in Wrapping = lhs as i16 in Wrapping;
        let wr: i16 in Wrapping = rhs as i16 in Wrapping;
        let wd: i16 in Wrapping = wl - wr;
        let diff: i16 = wd as i16;
        verify_diff(diff)
    }
}

machine probe(lhs: i16, rhs: i16) -> i16
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
    requires lhs >= 300i16 && lhs <= 520i16 && rhs >= 50i16 && rhs <= 100i16
{
    SelectedProbe::target_probe(lhs, rhs)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let combined: i16 = probe(400i16, 80i16);
    transition combined == 250i16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
