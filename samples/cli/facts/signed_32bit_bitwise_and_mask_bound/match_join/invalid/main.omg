// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Invalid: mask 127 produces masked 116, violating ensures contract. Place: match_join.
// Expected diagnostic: cannot prove ensures contract for exit from choose_mask

machine verify_masked(masked: i32) -> i32
requires masked >= 40i32 && masked <= 63i32
{
    let headroom: i32 = 63i32 - masked;
    let margin: i32 = masked - 40i32;
    0i32
}

machine choose_mask(flag: bool, raw: i32) -> i32
requires raw == 116i32
ensures result >= 40i32 && result <= 63i32
{
    let masked: i32 = raw & 127i32;
    match flag {
        true -> masked,
        false -> masked,
    }
}

machine compute_join(raw: i32) -> i32
requires raw == 116i32
{
    let res: i32 = choose_mask(true, raw);
    verify_masked(res)
}

machine probe() -> i32 {
    compute_join(116i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
