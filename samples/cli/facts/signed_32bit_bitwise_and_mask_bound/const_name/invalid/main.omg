// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Invalid: MASK 127 produces res 116, violating verify_masked contract. Place: const_name.
// Expected diagnostic: cannot prove requires contract for call verify_masked

machine verify_masked(masked: i32) -> i32
requires masked >= 40i32 && masked <= 63i32
{
    let headroom: i32 = 63i32 - masked;
    let margin: i32 = masked - 40i32;
    0i32
}

const RAW: i32 = 116i32;
const MASK: i32 = 127i32;

machine compute_const() -> i32 {
    let res: i32 = RAW & MASK;
    verify_masked(res)
}

machine probe() -> i32 {
    compute_const()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
