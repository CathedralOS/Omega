// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Place: other_state. A successor state receives the masked result and discharges subtraction bounds.
// Expected exit: 0

machine verify_state(raw: i32) -> i32
requires raw == 116i32
{
    let res: i32 = raw & 63i32;
    transition {
        _ -> step(res)
    }
    machine step(masked: i32) -> i32
    requires masked >= 40i32 && masked <= 63i32
    {
        let headroom: i32 = 63i32 - masked;
        let margin: i32 = masked - 40i32;
        0i32
    }
}

machine probe() -> i32 {
    verify_state(116i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
