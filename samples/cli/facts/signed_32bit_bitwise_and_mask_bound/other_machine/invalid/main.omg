// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Invalid: mask 127 produces masked 116, violating forward contract. Place: other_machine.
// Expected diagnostic: cannot prove requires contract for call forward

machine forward(masked: i32) -> i32
requires masked >= 40i32 && masked <= 63i32
{
    let headroom: i32 = 63i32 - masked;
    let margin: i32 = masked - 40i32;
    0i32
}

machine compute_forward(raw: i32) -> i32
requires raw == 116i32
{
    let res: i32 = raw & 127i32;
    forward(res)
}

machine probe() -> i32 {
    compute_forward(116i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
