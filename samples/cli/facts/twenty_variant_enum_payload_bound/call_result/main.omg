// Fact: matching a 20-variant tagged enum payload TwentyChoice { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64), V12(u64), V13(u64), V14(u64), V15(u64), V16(u64), V17(u64), V18(u64), V19(u64), V20(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Expected exit: 0

data TwentyChoice [copy] {
    case V1(v: u64) where v >= 40u64 && v <= 80u64;
    case V2(v: u64) where v >= 40u64 && v <= 80u64;
    case V3(v: u64) where v >= 40u64 && v <= 80u64;
    case V4(v: u64) where v >= 40u64 && v <= 80u64;
    case V5(v: u64) where v >= 40u64 && v <= 80u64;
    case V6(v: u64) where v >= 40u64 && v <= 80u64;
    case V7(v: u64) where v >= 40u64 && v <= 80u64;
    case V8(v: u64) where v >= 40u64 && v <= 80u64;
    case V9(v: u64) where v >= 40u64 && v <= 80u64;
    case V10(v: u64) where v >= 40u64 && v <= 80u64;
    case V11(v: u64) where v >= 40u64 && v <= 80u64;
    case V12(v: u64) where v >= 40u64 && v <= 80u64;
    case V13(v: u64) where v >= 40u64 && v <= 80u64;
    case V14(v: u64) where v >= 40u64 && v <= 80u64;
    case V15(v: u64) where v >= 40u64 && v <= 80u64;
    case V16(v: u64) where v >= 40u64 && v <= 80u64;
    case V17(v: u64) where v >= 40u64 && v <= 80u64;
    case V18(v: u64) where v >= 40u64 && v <= 80u64;
    case V19(v: u64) where v >= 40u64 && v <= 80u64;
    case V20(v: u64) where v >= 40u64 && v <= 80u64;
}

machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine extract_payload(choice: TwentyChoice) -> u64
    ensures result >= 40u64 && result <= 80u64
{
    transition choice {
        TwentyChoice::V1 { v } -> v
        TwentyChoice::V2 { v } -> v
        TwentyChoice::V3 { v } -> v
        TwentyChoice::V4 { v } -> v
        TwentyChoice::V5 { v } -> v
        TwentyChoice::V6 { v } -> v
        TwentyChoice::V7 { v } -> v
        TwentyChoice::V8 { v } -> v
        TwentyChoice::V9 { v } -> v
        TwentyChoice::V10 { v } -> v
        TwentyChoice::V11 { v } -> v
        TwentyChoice::V12 { v } -> v
        TwentyChoice::V13 { v } -> v
        TwentyChoice::V14 { v } -> v
        TwentyChoice::V15 { v } -> v
        TwentyChoice::V16 { v } -> v
        TwentyChoice::V17 { v } -> v
        TwentyChoice::V18 { v } -> v
        TwentyChoice::V19 { v } -> v
        TwentyChoice::V20 { v } -> v
    }
}

machine probe(choice: TwentyChoice) -> u64 {
    let res: u64 = extract_payload(choice);
    verify_payload(res)
}

machine main() crashes Trap {
    let p: TwentyChoice = TwentyChoice::V20 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
