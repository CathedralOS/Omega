// Expected exit: 0
// An additional Before input qualification permits writing 73 without promising Before on return.
data Cell { value: u32; }
domain Cell::Before(cell) requires cell.value == 0;
machine overwrite(cell: &write Cell in Before) {
    cell.value = 73;
}
data Holder { cell: Cell; }
machine observed_exit() -> u32 {
    let mut holder: Holder = Holder { cell: Cell { value: 0 } };
    overwrite(&write holder.cell);
    transition holder.cell.value == 73 { true -> 0 _ -> 1 }
}
machine main() crashes Trap {
    transition observed_exit() == 0 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
