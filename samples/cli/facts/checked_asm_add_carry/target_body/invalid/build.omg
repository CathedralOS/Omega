machine build(builder: &mut Build) {
    Build::select_provider<SelectedObserveTarget, CheckedObserveTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedObserveTarget, CheckedObserveTarget>(builder, windows_x86_64);

    Build::application(builder, "checked_asm_add_carry_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
