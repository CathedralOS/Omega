// Expected exit: 0.
// Adding one to the all-ones u32 establishes addition flags 85 under mask 2261; a structured snapshot carries that image to a label.
machine main() crashes Trap {
 SelectedObserveTarget::observe_target();
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserveTarget {
    machine observe_target()
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86ObserveTarget satisfies SelectedObserveTarget {
    machine observe_target()
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     let mut snapshot: u64 = 0;
     asm clobbers rax, rflags, r10, r15 {
     entry:
      mov eax, 4294967295;
      add eax, 1;
      pushfq snapshot;
      jmp observed;
     observed requires (snapshot & 2261u64) == 149u64:
      nop
     }
     transition (snapshot & 2261u64) == 85u64 { true -> done() false -> bad() }
     machine done() {}
     machine bad() { crash Trap; }
    }
}

ArmObserveTarget satisfies SelectedObserveTarget {
    machine observe_target()
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     let mut snapshot: u64 = 0;
     asm clobbers rax, rflags, r10, r15 {
     entry:
      mov eax, 4294967295;
      add eax, 1;
      pushfq snapshot;
      jmp observed;
     observed requires (snapshot & 2261u64) == 149u64:
      nop
     }
     transition (snapshot & 2261u64) == 85u64 { true -> done() false -> bad() }
     machine done() {}
     machine bad() { crash Trap; }
    }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
