machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "method_array_operand_inference_parameter" };
    Build::select_provider::<Bytes, SelectedBytes>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider::<Bytes, SelectedBytes>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider::<Bytes, SelectedBytes>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider::<Bytes, SelectedBytes>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
