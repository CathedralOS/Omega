// Fact: with Count supplied as 3, the omitted element T of Bytes::last is inferred as u8 from the actual &[u8; 3], and the selected implementation's [T; Count] carrier is the caller's copyable [u8; 3].
// Expected: rejected; the explicit Count 4 contradicts the actual [u8; 3] extent.
boundary trait Bytes {
    machine last<const Count: u64, T [copy]>(bytes: &[T; Count]) -> T reaches requires Count > 0;
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
X86Bytes satisfies Bytes {
    machine last<const Count: u64, T [copy]>(bytes: &[T; Count]) -> T requires Count > 0 { bytes[Count - 1] }
}
ArmBytes satisfies Bytes {
    machine last<const Count: u64, T [copy]>(bytes: &[T; Count]) -> T requires Count > 0 { bytes[Count - 1] }
}
machine main() crashes Trap {
    let bytes: [u8; 3] = [7, 11, 13];
    let observed: u8 = Bytes::last<4u64>(&bytes);
    transition observed == 13 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
