use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "method_array_operand_inference_other_machine" };
    Build::select_provider::<|app|::Bytes, |app|::SelectedBytes>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Bytes, |app|::SelectedBytes>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Bytes, |app|::SelectedBytes>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Bytes, |app|::SelectedBytes>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
