// The same Build selection serves both inferred element types and counts.
// Expected exit: 0
boundary trait Bytes {
    machine last<const Count: u64, T [copy]>(bytes: @[T; Count]) -> T reaches none requires Count > 0 crashes none;
}
SelectedBytes satisfies Bytes {
    machine last<const Count: u64, T [copy]>(bytes: @[T; Count]) -> T requires Count > 0 { bytes[Count - 1] }
}
machine main() crashes Trap {
    let bytes: [u8; 3] = [7, 11, 13];
    let observed: u8 = Bytes::last::<3u64>(@bytes);
    let words: [u16; 2] = [257, 513];
    let word: u16 = Bytes::last::<2u64>(@words);
    transition observed == 13 && word == 513 { true -> done(), _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
