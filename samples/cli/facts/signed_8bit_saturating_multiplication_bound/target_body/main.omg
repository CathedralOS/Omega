windows_x86_64 machine sat_target(lhs: i8, rhs: i8) -> i8
requires lhs >= 8 && lhs <= 12 && rhs >= 5 && rhs <= 8
{
    let a: i8 in Saturating = lhs as i8 in Saturating;
    let b: i8 in Saturating = rhs as i8 in Saturating;
    let sat_prod: i8 in Saturating = a * b;
    let prod: i8 = sat_prod as i8;
    verify_prod(prod)
}

machine probe() -> i8 {
    sat_target(10i8, 7i8)
}

machine main() crashes Trap {
    transition probe() == 56 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
