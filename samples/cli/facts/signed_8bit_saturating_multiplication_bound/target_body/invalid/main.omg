// Fact: 8-bit signed saturating multiplication lhs *| rhs with bounded interval 40i8 <= prod <= 96i8 establishes 40i8 <= prod <= 96i8 across all nine places so exact subtractions 96i8 - prod and prod - 40i8 are safe.
// Place: another target body (invalid twin). The target-scoped bodies widen lhs upper bound to 13i8 so prod reaches 104i8 > 96i8, failing contract for verify_prod.
// Expected diagnostic: cannot prove requires contract for call

machine verify_prod(value: i8) -> i8 requires value >= 40i8 && value <= 96i8 {
    let headroom: i8 = 96i8 - value;
    let margin: i8 = value - 40i8;
    headroom + margin
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSatTarget {
    machine sat_target(lhs: i8, rhs: i8) -> i8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 8 && lhs <= 13 && rhs >= 5 && rhs <= 8;
}

X86SatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: i8, rhs: i8) -> i8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 8 && lhs <= 13 && rhs >= 5 && rhs <= 8
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: i8 in Saturating = lhs as i8 in Saturating;
        let b: i8 in Saturating = rhs as i8 in Saturating;
        let sat_prod: i8 in Saturating = a * b;
        let prod: i8 = sat_prod as i8;
        verify_prod(prod)
    }
}

ArmSatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: i8, rhs: i8) -> i8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 8 && lhs <= 13 && rhs >= 5 && rhs <= 8
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: i8 in Saturating = lhs as i8 in Saturating;
        let b: i8 in Saturating = rhs as i8 in Saturating;
        let sat_prod: i8 in Saturating = a * b;
        let prod: i8 = sat_prod as i8;
        verify_prod(prod)
    }
}

machine probe() -> i8 {
    SelectedSatTarget::sat_target(10i8, 7i8)
}

machine main() crashes Trap {
    transition probe() == 56 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
