// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: const name. The bounds and remainder limits reference declared symbolic constants.
// Invalid control: divisor upper bound widened to 65u64, allowing rem as high as 64u64 and failing subtraction 63u64 - rem.
// Expected rejection: may overflow `u64`

const DIVISOR_EXACT: u64 = 64u64;
const DIVISOR_MAX: u64 = 65u64;
const MAX_REMAINDER: u64 = 63u64;

machine remainder_const(dividend: u64, divisor: u64) -> i32
    requires divisor >= DIVISOR_EXACT && divisor <= DIVISOR_MAX;
{
    let rem: u64 = dividend % divisor;
    let headroom: u64 = MAX_REMAINDER - rem;
    transition rem == 13u64 && headroom == 50u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_const(205u64, 64u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
