// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: local. The remainder is transported through intermediate local bindings.
// Expected exit: 0

machine remainder_local(dividend: u64, divisor: u64) -> i32
    requires divisor >= 64u64 && divisor <= 64u64;
{
    let d: u64 = dividend;
    let s: u64 = divisor;
    let r: u64 = d % s;
    let rem: u64 = r;
    let headroom: u64 = 63u64 - rem;
    transition rem == 13u64 && headroom == 50u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_local(205u64, 64u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
