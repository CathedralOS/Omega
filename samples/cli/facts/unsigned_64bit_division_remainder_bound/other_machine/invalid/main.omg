// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: another machine. The remainder is forwarded to another machine for interval verification.
// Invalid control: divisor upper bound widened to 65u64, allowing rem as high as 64u64 and failing subtraction 63u64 - rem.
// Expected rejection: may overflow `u64`

machine forward_eval(r: u64) -> i32
    requires r <= 64u64;
{
    let headroom: u64 = 63u64 - r;
    transition r == 13u64 && headroom == 50u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine remainder_other_machine(dividend: u64, divisor: u64) -> i32
    requires divisor >= 64u64 && divisor <= 65u64;
{
    let rem: u64 = dividend % divisor;
    forward_eval(rem)
}

machine main() crashes Trap {
    let res: i32 = remainder_other_machine(205u64, 64u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
