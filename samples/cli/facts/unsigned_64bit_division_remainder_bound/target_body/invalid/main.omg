// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: another target body. Target-scoped implementations across all four platforms verify the bounds.
// Invalid control: divisor upper bound widened to 65u64, allowing rem as high as 64u64 and failing subtraction 63u64 - rem.
// Expected rejection: may overflow `u64`

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedRemainderTarget {
    machine remainder_target(dividend: u64, divisor: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires divisor >= 64u64 && divisor <= 65u64;
}

X86RemainderTarget satisfies SelectedRemainderTarget {
    machine remainder_target(dividend: u64, divisor: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires divisor >= 64u64 && divisor <= 65u64
    {
        SelectedBodyCheck::require_tag(17u64);
        let rem: u64 = dividend % divisor;
        let headroom: u64 = 63u64 - rem;
        transition rem == 13u64 && headroom == 50u64 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

ArmRemainderTarget satisfies SelectedRemainderTarget {
    machine remainder_target(dividend: u64, divisor: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires divisor >= 64u64 && divisor <= 65u64
    {
        SelectedBodyCheck::require_tag(29u64);
        let rem: u64 = dividend % divisor;
        let headroom: u64 = 63u64 - rem;
        transition rem == 13u64 && headroom == 50u64 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

machine main() crashes Trap {
    let res: i32 = SelectedRemainderTarget::remainder_target(205u64, 64u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
