machine build(builder: &mut Build) {
    Build::select_provider<SelectedRemainderTarget, CheckedRemainderTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedRemainderTarget, CheckedRemainderTarget>(builder, linux_arm64);
    Build::select_provider<SelectedRemainderTarget, CheckedRemainderTarget>(builder, macos_arm64);
    Build::select_provider<SelectedRemainderTarget, CheckedRemainderTarget>(builder, windows_x86_64);

    Build::application(builder, "unsigned_64bit_division_remainder_bound_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
