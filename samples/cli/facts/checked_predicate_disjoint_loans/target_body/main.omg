// A checked distinct-index predicate authorizes two mutable element loans that write 17 and 53 to the original distinct caller elements.
// Expected exit: 0
data Cell { value: i32; }
machine distinct(first_index: u64, second_index: u64) -> bool { first_index != second_index }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReplace {
    machine replace(values: &mut [Cell], first_index: u64, second_index: u64)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires values.len == 2, first_index < values.len, second_index < values.len, distinct(first_index, second_index) == true;
}

X86Replace satisfies SelectedReplace {
    machine replace(values: &mut [Cell], first_index: u64, second_index: u64)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires values.len == 2, first_index < values.len, second_index < values.len, distinct(first_index, second_index) == true
    {
        SelectedBodyCheck::require_tag(17u64);
        let first: &mut Cell = &mut values[first_index];
        let second: &mut Cell = &mut values[second_index];
        first = Cell { value: 17 };
        second = Cell { value: 53 };
    }
}

ArmReplace satisfies SelectedReplace {
    machine replace(values: &mut [Cell], first_index: u64, second_index: u64)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires values.len == 2, first_index < values.len, second_index < values.len, distinct(first_index, second_index) == true
    {
        SelectedBodyCheck::require_tag(29u64);
        let first: &mut Cell = &mut values[first_index];
        let second: &mut Cell = &mut values[second_index];
        first = Cell { value: 17 };
        second = Cell { value: 53 };
    }
}


machine main() crashes Trap {
    let mut values: [Cell; 2] = [Cell { value: 1 }, Cell { value: 2 }];
    SelectedReplace::replace(&mut values[..], 0, 1);
    transition values[0].value == 17 && values[1].value == 53 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
