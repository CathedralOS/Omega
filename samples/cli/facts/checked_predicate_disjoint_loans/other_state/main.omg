// A checked distinct-index predicate authorizes two mutable element loans that write 17 and 53 to the original distinct caller elements.
// Expected exit: 0
data Cell { value: i32; }
machine distinct(first_index: u64, second_index: u64) -> bool { first_index != second_index }
machine forward(values: @mutable [Cell]) requires values.length == 2 {
    next(values, 0);
    machine next(values: @mutable [Cell], selected: u64)
    requires values.length == 2, selected == 0
    { apply(values, selected, 1); }
machine apply(values: @mutable [Cell], first_index: u64, second_index: u64)
requires values.length == 2, first_index < values.length, second_index < values.length,
    distinct(first_index, second_index) == true
{
    let first: @mutable Cell = @mutable values[first_index];
    let second: @mutable Cell = @mutable values[second_index];
    $first = Cell { value: 17 };
    $second = Cell { value: 53 };
}

}
machine main() crashes Trap {
    let mutable values: [Cell; 2] = [Cell { value: 1 }, Cell { value: 2 }];
    forward(@mutable values[..]);
    transition values[0].value == 17 && values[1].value == 53 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
