// A checked distinct-index predicate authorizes two mutable element loans that write 17 and 53 to the original distinct caller elements.
// Expected exit: 0
data Cell { value: i32; }
data Storage { before: i32; values: [Cell; 2]; after: i32; }
data Indices { enabled: bool; positions: [u64; 2]; first: u64; second: u64; }
machine ordered(left: u64, right: u64) -> bool { left < right || right < left }
machine distinct(indices: &Indices) -> bool {
    transition indices.enabled && indices.first < 2 && indices.second < 2 {
        true -> ordered(indices.positions[indices.first], indices.positions[indices.second])
        false -> false
    }
}
machine replace(values: &mut [Cell], indices: Indices, stamp: u64)
requires values.len == 2, indices.first < 2, indices.second < 2, indices.positions[indices.first] < values.len, indices.positions[indices.second] < values.len,
    distinct(&indices) == true
{
    let first: &mut Cell = &mut values[indices.positions[indices.first]];
    let second: &mut Cell = &mut values[indices.positions[indices.second]];
    first = Cell { value: 17 };
    second = Cell { value: 53 };
}
machine flip(indices: &mut Indices) -> u64 { indices.enabled = !indices.enabled; 0 }
machine main() crashes Trap {
    let mut values: [Cell; 2] = [Cell { value: 1 }, Cell { value: 2 }];
    let indices: Indices = Indices { enabled: false, positions: [0u64, 1u64], first: 0, second: 1 };
    replace(&mut values[..], Indices {
        enabled: indices.enabled, positions: [indices.positions[0], indices.positions[1]],
        first: indices.first, second: indices.second
    }, flip(&mut indices));
    transition values[0].value == 17 && values[1].value == 53 && !indices.enabled {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
