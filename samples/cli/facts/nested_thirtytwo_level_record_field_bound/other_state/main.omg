}

data Level5 [copy] {
    l6: Level6;
}

data Level4 [copy] {
    l5: Level5;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

machine check_state(root: RootRec) -> u64
requires root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.l23.l24.l25.l26.l27.l28.l29.l30.l31.val >= 40 && root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.l23.l24.l25.l26.l27.l28.l29.l30.l31.val <= 80
{
    transition {
        _ -> step(root)
    }
    state step(r: RootRec) -> u64
    requires r.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.l23.l24.l25.l26.l27.l28.l29.l30.l31.val >= 40 && r.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.l23.l24.l25.l26.l27.l28.l29.l30.l31.val <= 80
    {
        let res: u64 = r.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.l23.l24.l25.l26.l27.l28.l29.l30.l31.val;
        let headroom: u64 = 80u64 - res;
        let margin: u64 = res - 40u64;
        headroom + margin
    }
}

machine probe() -> u64 {
    let root: RootRec = RootRec {
                l1: Level1 {
                    l2: Level2 {
                        l3: Level3 {
                            l4: Level4 {
                                l5: Level5 {
                                    l6: Level6 {
                                        l7: Level7 {
                                            l8: Level8 {
                                                l9: Level9 {
                                                    l10: Level10 {
                                                        l11: Level11 {
                                                            l12: Level12 {
                                                                l13: Level13 {
                                                                    l14: Level14 {
                                                                        l15: Level15 {
                                                                            l16: Level16 {
                                                                                l17: Level17 {
                                                                                    l18: Level18 {
                                                                                        l19: Level19 {
                                                                                            l20: Level20 {
                                                                                                l21: Level21 {
                                                                                                    l22: Level22 {
                                                                                                        l23: Level23 {
                                                                                                            l24: Level24 {
                                                                                                                l25: Level25 {
                                                                                                                    l26: Level26 {
                                                                                                                        l27: Level27 {
                                                                                                                            l28: Level28 {
                                                                                                                                l29: Level29 {
                                                                                                                                    l30: Level30 {
                                                                                                                                        l31: Level31 {
                                                                                                                                            val: 60u64,
                                                                                                                                        },
                                                                                                                                    },
                                                                                                                                },
                                                                                                                            },
                                                                                                                        },
                                                                                                                    },
                                                                                                                },
                                                                                                            },
                                                                                                        },
                                                                                                    },
                                                                                                },
                                                                                            },
                                                                                        },
                                                                                    },
                                                                                },
                                                                            },
                                                                        },
                                                                    },
                                                                },
                                                            },
                                                        },
                                                    },
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            };
    check_state(root)
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
