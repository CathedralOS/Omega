// Fact: a 32-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { l5: Level5 { l6: Level6 { l7: Level7 { l8: Level8 { l9: Level9 { l10: Level10 { l11: Level11 { l12: Level12 { l13: Level13 { l14: Level14 { l15: Level15 { l16: Level16 { l17: Level17 { l18: Level18 { l19: Level19 { l20: Level20 { l21: Level21 { l22: Level22 { l23: Level23 { l24: Level24 { l25: Level25 { l26: Level26 { l27: Level27 { l28: Level28 { l29: Level29 { l30: Level30 { l31: Level31 { val: u64 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.l23.l24.l25.l26.l27.l28.l29.l30.l31.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: another state. A successor state receives the 32-level nested record before leaf projection and interval discharge.
// Expected exit: 0

data Level31 [copy] {
    val: u64;
}

data Level30 [copy] {
    l31: Level31;
}

data Level29 [copy] {
    l30: Level30;
}

