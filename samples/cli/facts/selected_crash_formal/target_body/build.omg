machine build(builder: &mut Build) {
    Build::application(builder, "selected_crash_formal");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::accept_boundary<SelectedForward>(builder);
    Build::select_provider<SelectedForward, WindowsForward>(builder, windows_x86_64);
    Build::select_provider<SelectedForward, LinuxX86Forward>(builder, linux_x86_64);
    Build::select_provider<SelectedForward, MacosForward>(builder, macos_arm64);
    Build::select_provider<SelectedForward, LinuxArmForward>(builder, linux_arm64);
}
