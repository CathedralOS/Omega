use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "selected_crash_formal" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::accept_boundary::<|app|::SelectedForward>(builder);
    Build::select_provider::<|app|::SelectedForward, |app|::WindowsForward>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedForward, |app|::LinuxX86Forward>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedForward, |app|::MacosForward>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedForward, |app|::LinuxArmForward>(builder, linux_arm64);
}
