// Expected exit: 0
// Fact: a generic selected Reader<Zero>::read call preserves the entry i32 >= 0 fact to discharge its authored value < Zero Trap route.
public const Zero: i32 = 0;
public trait Reader<const Limit: i32> {
    machine read(value: i32) -> i32 crashes Trap value <= Limit;
}
Provider<const Bound: i32> satisfies Reader<Bound> {
    machine read(value: i32) -> i32 { value }
}
public boundary trait SelectedForward {
    machine forward<Implementation satisfies Reader<Zero>>(value: i32) -> i32
    reaches
    crashes Trap value < Zero;
}
WindowsForward satisfies SelectedForward {
    machine forward<Implementation satisfies Reader<Zero>>(value: i32) -> i32
    crashes Trap value < Zero
    { Implementation::read(value) }
}
LinuxX86Forward satisfies SelectedForward {
    machine forward<Implementation satisfies Reader<Zero>>(value: i32) -> i32
    crashes Trap value < Zero
    { Implementation::read(value) }
}
MacosForward satisfies SelectedForward {
    machine forward<Implementation satisfies Reader<Zero>>(value: i32) -> i32
    crashes Trap value < Zero
    { Implementation::read(value) }
}
LinuxArmForward satisfies SelectedForward {
    machine forward<Implementation satisfies Reader<Zero>>(value: i32) -> i32
    crashes Trap value < Zero
    { Implementation::read(value) }
}
public machine safe<Implementation satisfies Reader<Zero>>(value: i32) -> i32
invokes SelectedForward
requires value >= 0
{ SelectedForward::forward<Implementation>(value) }
machine main() crashes Trap {
    let input: i32 = 7;
    let observed: i32 = safe<Provider<Zero>>(input);
    transition observed == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
