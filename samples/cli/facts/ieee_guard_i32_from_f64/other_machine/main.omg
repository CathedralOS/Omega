// Checked IEEE guard value == value && value >= 0.0 && value < 1000000000.0 proves I32::from_f64(value) is finite and in range.
// Expected exit: 0
use omega::language::core::float_operations;
machine convert(value: f64) -> i32
requires value == value && value >= 0.0 && value < 1000000000.0
{ I32::from_f64(value) }
machine bounded(value: f64) -> i32 {
    transition value == value && value >= 0.0 && value < 1000000000.0 {
        true -> convert(value)
        false -> zero()
    }
    machine zero() -> i32 { 0 }
}

machine main() crashes Trap {
    let inside: i32 = bounded(123.75);
    let above: i32 = bounded(2000000000.0);
    let below: i32 = bounded(-1.0);
    let zero_f64: f64 = 0.0;
    let unordered: i32 = bounded(zero_f64 / zero_f64);
    transition inside == 123 && above == 0 && below == 0 && unordered == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
