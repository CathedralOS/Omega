machine build(builder: &mut Build) {
    Build::select_provider<SelectedConvert, CheckedConvert>(builder, linux_x86_64);
    Build::select_provider<SelectedConvert, CheckedConvert>(builder, linux_arm64);
    Build::select_provider<SelectedConvert, CheckedConvert>(builder, macos_arm64);
    Build::select_provider<SelectedConvert, CheckedConvert>(builder, windows_x86_64);

    Build::application(builder, "ieee_repro_target_body_invalid");
}
