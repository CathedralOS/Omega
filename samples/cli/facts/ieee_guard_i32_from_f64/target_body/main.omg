// Checked IEEE guard value == value && value >= 0.0 && value < 1000000000.0 proves I32::from_f64(value) is finite and in range.
// Expected exit: 0
use omega::language::core::float_operations;
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedConvert {
    machine convert(value: f64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires value == value && value >= 0.0 && value < 1000000000.0;
}

X86Convert satisfies SelectedConvert {
    machine convert(value: f64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires value == value && value >= 0.0 && value < 1000000000.0
    {
        SelectedBodyCheck::require_tag(17u64);
     I32::from_f64(value) 
    }
}

ArmConvert satisfies SelectedConvert {
    machine convert(value: f64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires value == value && value >= 0.0 && value < 1000000000.0
    {
        SelectedBodyCheck::require_tag(29u64);
     I32::from_f64(value) 
    }
}


machine bounded(value: f64) -> i32 {
    transition value == value && value >= 0.0 && value < 1000000000.0 {
        true -> SelectedConvert::convert(value)
        false -> zero()
    }
    machine zero() -> i32 { 0 }
}

machine main() crashes Trap {
    let inside: i32 = bounded(123.75);
    let above: i32 = bounded(2000000000.0);
    let below: i32 = bounded(-1.0);
    let zero_f64: f64 = 0.0;
    let unordered: i32 = bounded(zero_f64 / zero_f64);
    transition inside == 123 && above == 0 && below == 0 && unordered == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
