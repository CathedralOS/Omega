use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "compound_index_guard_target_body" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);

    Build::select_provider::<|app|::CheckedIndexStore, |app|::IndexedStore>(builder, windows_x86_64);
    Build::select_provider::<|app|::CheckedIndexStore, |app|::IndexedStore>(builder, linux_x86_64);
    Build::select_provider::<|app|::CheckedIndexStore, |app|::IndexedStore>(builder, macos_arm64);
    Build::select_provider::<|app|::CheckedIndexStore, |app|::IndexedStore>(builder, linux_arm64);
}
