// Compound index guards: `main.b * 20 + main.a` is a two-variable
// index expression — `>= 0 && < 200` on the SAME expression
// discharges the `grid[...]` store unguarded by element type.
//
//   * Grid is `[i32; 200] in Wrapping` — element-domain array.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main {
    hits: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    grid: [i32; 200] in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.a = 1;
    main.b = 1;
    transition main.b * 20 + main.a >= 0 && main.b * 20 + main.a < 200 {
        true -> put(main)
        _ -> done(main)
    }

    state put(main: &mut Main) {
        main.grid[main.b * 20 + main.a] = 7;
        main.hits = 1;
    }
    state done(main: &mut Main) { main.hits = -1; }
}
