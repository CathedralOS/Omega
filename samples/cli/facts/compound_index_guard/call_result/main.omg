// The live fact 0 <= b * 20 + a < 200 permits storing 7 at grid[b * 20 + a].
// Expected exit: 0
data Main {
    hits: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    grid: [i32; 200] in Wrapping;
}
machine coordinate(a: i32 in Wrapping) -> i32 in Wrapping
ensures result == a
{ a }
machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    main.a = 15;
    main.b = 3;
    transition main.b * 20 + main.a >= 0 && main.b * 20 + main.a < 200 {
        true -> put(main)
        _ -> done(main)
    }
    machine put(main: &mut Main) {
        let a: i32 in Wrapping = coordinate(main.a);
        main.grid[main.b * 20 + a] = 7;
        main.hits = 1;
        transition main.hits == 1 && main.grid[75] == 7 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine done(main: &mut Main) {
        main.hits = -1;
        transition false {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) {}
    machine fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
