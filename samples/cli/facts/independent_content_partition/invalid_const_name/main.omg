// Fact: Two independent routed interval claims on one owned region remain independently conserved by one checked split.
// Expected exit: 0
// Numeric custody model only; no physical backing or access is granted.
use {omega}/language/core/content.omg;
use {omega}/language/core/foundation.omg as proof;
use {omega}/language/core/nat.omg;
data Region [linear] dropped by drop_region { base: u64; length: u64; }
domain Region::First established by issue;
domain Region::Second established by issue;
machine First::content(region: @Region) -> |content|::IntervalSet<|nat|::Nat>
satisfies |content|::Content<Region, |content|::IntervalSet<|nat|::Nat>>::project {
    |content|::IntervalSet { start: embed(region.base) as |nat|::Nat,
        end: (embed(region.base) + embed(region.length)) as |nat|::Nat }
}
machine Second::content(region: @Region) -> |content|::IntervalSet<|nat|::Nat>
satisfies |content|::Content<Region, |content|::IntervalSet<|nat|::Nat>>::project {
    |content|::IntervalSet { start: embed(region.base) as |nat|::Nat,
        end: (embed(region.base) + embed(region.length)) as |nat|::Nat }
}
machine issue() -> Region in First & Second
ensures result.base == 10, result.length == 48
{ Region { base: 10, length: 48 } as +First +Second }
machine drop_region(region: Region) {
    let { base as _, length as _ } = region;
}
data Parts { left: Region in First & Second; right: Region in First & Second; }
machine partition(whole: Region in First & Second, requested: u64) -> Parts
requires whole.base == 10 && whole.length == 48 && requested == 16
ensures
    |proof|::Identity::<|content|::IntervalSet<|nat|::Nat>>(
        First::content(old(@whole)),
        separate(First::content(@result.left), First::content(@result.right))
    )
{
    let { base, length } = whole;
    Parts { left: Region { base: base, length: requested } as +First +Second,
        right: Region { base: base + requested, length: length - requested } as +First +Second }
}
const requested: u64 = 16;
machine exercise(select: bool) -> Parts {
    let whole: Region in First & Second = issue();
    partition(whole, requested)
}

machine inspect(parts: Parts) -> bool {
    let correct: bool = parts.left.base == 10 && parts.left.length == 16
        && parts.right.base == 26 && parts.right.length == 32;
    let { left, right } = parts;
    drop(left);
    drop(right);
    correct
}
machine main() crashes Trap {
    let first: bool = inspect(exercise(true));
    let second: bool = inspect(exercise(false));
    transition first && second { true -> done(), _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
