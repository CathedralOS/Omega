// Fact: 8-bit unsigned wrapping addition lhs +% rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Expected exit: 0

machine compute_wrap(lhs: u8 in Wrapping, rhs: u8 in Wrapping) -> u8 in Wrapping {
    lhs + rhs
}

machine verify_sum(sum: u8) -> i32
    requires sum >= 50 && sum <= 100
{
    let headroom: u8 = 100 - sum;
    let margin: u8 = sum - 50;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 50 && val <= 100;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 50 && val <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_sum(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 50 && val <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_sum(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: u8 in Wrapping = 60;
    let rhs: u8 in Wrapping = 15;
    let sum_wrapped: u8 in Wrapping = compute_wrap(lhs, rhs);
    let sum: u8 = sum_wrapped as u8;
    let check: i32 = SelectedProbe::exercise(sum);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
