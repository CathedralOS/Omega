// A call precondition is a projection term. The call records that
// projection fact, and the caller reads the record.
// Place: target_body.
// Expected exit: 0
data Mark [copy] { kept: bool; }

machine project(mark: Mark) -> bool
requires mark.kept
{
    mark.kept
}

machine hold(direct: bool) -> bool
requires direct == true
{
    true
}

linux_x86_64 machine observe() -> bool {
    let mark: Mark = Mark { kept: false };
    let direct: bool = project(mark);
    hold(direct)
}

linux_arm64 machine observe() -> bool {
    let mark: Mark = Mark { kept: false };
    let direct: bool = project(mark);
    hold(direct)
}

macos_arm64 machine observe() -> bool {
    let mark: Mark = Mark { kept: false };
    let direct: bool = project(mark);
    hold(direct)
}

windows_x86_64 machine observe() -> bool {
    let mark: Mark = Mark { kept: false };
    let direct: bool = project(mark);
    hold(direct)
}

machine main() crashes Trap {
    transition observe() {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
