// Fact: 64-bit unsigned saturating subtraction lhs -| rhs with bounded interval 40u64 <= diff <= 100u64 establishes 40u64 <= diff <= 100u64 across all nine places so exact subtractions 100u64 - diff and diff - 40u64 are safe.
// Place: target_body. Each hosted target body computes the 64-bit unsigned saturating subtraction and verifies the bounds.
// Expected exit: 0
machine verify_diff(value: u64) -> u64
    requires value >= 40 && value <= 100
{
    let head: u64 = 100 - value;
    let tail: u64 = value - 40;
    head + tail
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(lhs: u64, rhs: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(lhs: u64, rhs: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: u64 in Saturating = lhs as u64 in Saturating;
        let b: u64 in Saturating = rhs as u64 in Saturating;
        let sat: u64 in Saturating = a - b;
        let diff: u64 = sat as u64;
        verify_diff(diff)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(lhs: u64, rhs: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: u64 in Saturating = lhs as u64 in Saturating;
        let b: u64 in Saturating = rhs as u64 in Saturating;
        let sat: u64 in Saturating = a - b;
        let diff: u64 = sat as u64;
        verify_diff(diff)
    }
}









machine evaluate() -> u64
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(100, 30)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: u64 = evaluate();
    transition res == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
