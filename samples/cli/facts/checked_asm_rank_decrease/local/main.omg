// Expected exit: 0.
// sub records the decreased register, and the backedge reads that record.
// The seed-2 mov/sub/jnz countdown is unchanged; this machine only adds the
// ranked-decrease witness the enclosing termination promise requires.
machine main() terminates by eax -> Nat::Descending; crashes Trap {
 let seed: u32 = 2;
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 0:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
