// Expected exit: 0.
// sub records the decreased register, and the backedge reads that record.
data Seed { value: u32; }
machine main() terminates by eax -> Nat::Descending; crashes Trap {
 let seed: Seed = Seed { value: 2 };
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed.value;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 0:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
