// Expected exit: 0.
// sub records the decreased register, and the backedge reads that record.
machine main() crashes Trap { SelectedCountdown::countdown(2); }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedCountdown {
    machine countdown(seed: u32)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed == 2 terminates;
}

X86Countdown satisfies SelectedCountdown {
    machine countdown(seed: u32)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed == 2 terminates by eax -> Nat::Descending
    {
        SelectedBodyCheck::require_tag(17u64);
     let mut output: u32 = 99;
     asm {
     entry:
      mov eax, seed;
      jmp loop;
     loop requires eax > 0:
      sub eax, 1;
      jnz loop;
     done requires eax == 0:
      mov output, eax
     }
     transition output == 0 { true -> done() false -> bad() }
     machine done() {}
     machine bad() { crash Trap; }
    }
}

ArmCountdown satisfies SelectedCountdown {
    machine countdown(seed: u32)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed == 2 terminates by eax -> Nat::Descending
    {
        SelectedBodyCheck::require_tag(29u64);
     let mut output: u32 = 99;
     asm {
     entry:
      mov eax, seed;
      jmp loop;
     loop requires eax > 0:
      sub eax, 1;
      jnz loop;
     done requires eax == 0:
      mov output, eax
     }
     transition output == 0 { true -> done() false -> bad() }
     machine done() {}
     machine bad() { crash Trap; }
    }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
