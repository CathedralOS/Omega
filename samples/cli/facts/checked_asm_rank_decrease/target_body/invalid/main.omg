// Expected exit: 0.
// sub records the decreased register, and the backedge reads that record.
machine main() crashes Trap { countdown(2); }
linux_x86_64 machine countdown(seed: u32) requires seed == 2 terminates by eax -> Nat::Descending; crashes Trap {
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 1:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}

