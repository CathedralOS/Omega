// Expected exit: 0.
// sub records the decreased register, and the backedge reads that record.
data Seed { value: u32; }
machine main() crashes Trap { countdown(true, Seed { value: 2 }, Seed { value: 2 }); countdown(false, Seed { value: 2 }, Seed { value: 2 }); }
machine countdown(branch: bool, left: Seed, right: Seed) requires left.value == 2 && right.value == 2 terminates by eax -> Nat::Descending; crashes Trap {
 let seed: u32 = match branch { true -> left.value, false -> right.value };
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 1:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
