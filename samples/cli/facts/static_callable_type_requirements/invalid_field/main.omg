// Fact: A supplied static callable retains its exact applied type requirements through mutable values and calls without runtime operands.
// Expected exit: 0
machine increment32(value: @mutable u32) { $value = (($value as u32 +Wrapping) + (1u32 as u32 +Wrapping)) as u32; }
machine increment64(value: @mutable u64) { $value = (($value as u64 +Wrapping) + (1u64 as u64 +Wrapping)) as u64; }
machine increment<Kind>(value: @mutable Kind)
requires Kind == u32
{
    transition { Kind == u32 -> increment32(value), _ -> increment64(value) }
}
machine mark<Kind>() requires Kind == u32 || Kind == u64 {}
machine operate<Value, machine Op>(value: @mutable Value)
requires machine Op(value: @mutable Value);
{ Op(value); }
machine zero<machine Op>() requires machine Op(); { Op(); }
machine apply<Kind>(value: @mutable Kind) requires Kind == u32 || Kind == u64 {
    zero::<mark<Kind>>();
    operate::<Kind, increment<Kind>>(value);
}
data Holder { value: u64; }
machine main() crashes Trap {
    let mutable holder: Holder = Holder { value: 4294967295u64 };
    apply(@mutable holder.value);
    transition holder.value == 4294967296u64 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
