use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "static_callable_type_requirements" };
    Build::select_provider::<|app|::Edit, |app|::WindowsEdit>(builder, windows_x86_64);
    Build::select_provider::<|app|::Edit, |app|::LinuxX86Edit>(builder, linux_x86_64);
    Build::select_provider::<|app|::Edit, |app|::MacEdit>(builder, macos_arm64);
    Build::select_provider::<|app|::Edit, |app|::LinuxArmEdit>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
