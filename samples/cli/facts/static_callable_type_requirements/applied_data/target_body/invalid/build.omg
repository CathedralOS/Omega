machine build(builder: &mut Build) {
    Build::application(builder, "static_callable_type_requirements_data");
    Build::select_provider<Edit, WindowsEdit>(builder, windows_x86_64);
    Build::select_provider<Edit, LinuxX86Edit>(builder, linux_x86_64);
    Build::select_provider<Edit, MacEdit>(builder, macos_arm64);
    Build::select_provider<Edit, LinuxArmEdit>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
