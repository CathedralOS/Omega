// Fact: 64-bit unsigned bitwise OR base | 32u64 with bounded interval 40u64 <= combined <= 63u64 establishes 40u64 <= combined <= 63u64 across all nine places so exact subtractions 63u64 - combined and combined - 40u64 are safe.
// Place: field (invalid twin). The base field upper bound is widened to 64u64 so combined reaches 127 > 63, failing contract for verify_combined.
// Expected diagnostic: cannot prove requires contract for call

data OrPacket [copy] {
    base: u64;
    mask: u64;
}

machine verify_combined(combined: u64) -> u64
requires combined >= 40 && combined <= 63
{
    let headroom: u64 = 63u64 - combined;
    let margin: u64 = combined - 40u64;
    headroom + margin
}

machine bitwise_or_field(pkt: OrPacket) -> u64
requires pkt.base >= 16 && pkt.base <= 64 && pkt.mask == 32
{
    let combined: u64 = pkt.base | pkt.mask;
    verify_combined(combined)
}

machine probe() -> u64 {
    let pkt: OrPacket = OrPacket {
        base: 20u64,
        mask: 32u64,
    };
    bitwise_or_field(pkt)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
