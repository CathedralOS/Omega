// Fact: 64-bit unsigned bitwise OR base | 32u64 with bounded interval 40u64 <= combined <= 63u64 establishes 40u64 <= combined <= 63u64 across all nine places so exact subtractions 63u64 - combined and combined - 40u64 are safe.
// Place: another target body. Each of four target-scoped machine bodies performs 64-bit bitwise OR and discharges interval.
// Expected exit: 0

machine verify_combined(combined: u64) -> u64
requires combined >= 40 && combined <= 63
{
    let headroom: u64 = 63u64 - combined;
    let margin: u64 = combined - 40u64;
    headroom + margin
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedBitwiseOrTarget {
    machine bitwise_or_target(base: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires base >= 16 && base <= 31;
}

X86BitwiseOrTarget satisfies SelectedBitwiseOrTarget {
    machine bitwise_or_target(base: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires base >= 16 && base <= 31
    {
        SelectedBodyCheck::require_tag(17u64);
        let combined: u64 = base | 32u64;
        verify_combined(combined)
    }
}

ArmBitwiseOrTarget satisfies SelectedBitwiseOrTarget {
    machine bitwise_or_target(base: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires base >= 16 && base <= 31
    {
        SelectedBodyCheck::require_tag(29u64);
        let combined: u64 = base | 32u64;
        verify_combined(combined)
    }
}

machine probe() -> u64 {
    SelectedBitwiseOrTarget::bitwise_or_target(20u64)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
