// Expected exit: 0.
// Structured popfq restores a saved u64 flags place; the following label reads that place.
use omega::language::core::assembly;

const FLAG_BIT: u64 = 64u64;

machine main() reaches MachineControl crashes Trap {
    let mut saved: u64 = 0;
    asm where clobbers rax, rflags, r10, r15 {
        entry:
            mov eax, 1;
            sub eax, 1;
            pushfq saved;
    }
    asm where clobbers r10, r15 {
        entry:
            popfq saved;
        observed requires (saved & FLAG_BIT) == FLAG_BIT:
            nop
    }
    transition (saved & FLAG_BIT) == FLAG_BIT {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
