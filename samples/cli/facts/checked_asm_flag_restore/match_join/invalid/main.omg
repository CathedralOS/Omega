// A literal is not a saved-flags place.
use omega::language::core::assembly;

machine main() reaches MachineControl crashes Trap {
    join(true);
    join(false);
}

machine join(branch: bool) reaches MachineControl crashes Trap {
    let mut left: u64 = 0;
    let mut right: u64 = 0;
    asm where clobbers rax, rflags, r10, r15 {
        entry:
            mov eax, 1;
            sub eax, 1;
            pushfq left;
    }
    asm where clobbers rax, rflags, r10, r15 {
        entry:
            mov eax, 1;
            sub eax, 1;
            pushfq right;
    }
    let saved: u64 = match branch { true -> left, false -> right };
    asm where clobbers r10, r15 {
        entry:
            popfq 0;
        observed requires (saved & 64u64) == 64u64:
            nop
    }
    transition (saved & 64u64) == 64u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
