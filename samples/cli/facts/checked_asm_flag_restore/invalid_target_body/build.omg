use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "checked_asm_flag_restore_target_body_invalid" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::SelectedRestore, |app|::X86Restore>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedRestore, |app|::X86Restore>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedRestore, |app|::X86Restore>(builder, macos_x86_64);
}
