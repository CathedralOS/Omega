// A literal is not a saved-flags place.

machine main() reaches MachineControl crashes Trap {
    SelectedRestore::restore();
}

boundary trait SelectedRestore {
    machine restore() reaches MachineControl crashes Trap;
}
X86Restore satisfies SelectedRestore {
    machine restore() reaches MachineControl crashes Trap {
        let mut saved: u64 = 0;
        asm clobbers rax, rflags, r10, r15 {
            entry:
                mov eax, 1;
                sub eax, 1;
                pushfq saved;
        }
        asm clobbers r10, r15 {
            entry:
                popfq 0;
            observed requires (saved & 64u64) == 64u64:
                nop
        }
        transition (saved & 64u64) == 64u64 {
            true -> done()
            false -> bad()
        }
        machine done() {}
        machine bad() { crash Trap; }
    }
}

