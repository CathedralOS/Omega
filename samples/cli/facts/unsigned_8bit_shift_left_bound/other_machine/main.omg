// Fact: an 8-bit unsigned u8 logical left shift of a bounded input (val >= 25u8 && val <= 25u8) by 2u32 bits establishes shifted >= 100u8 && shifted <= 100u8 so exact 8-bit subtraction shifted - 100u8 is proved underflow-free across all nine places.
// Place: another machine. An intermediate machine forwards the bounded 8-bit operand and shift count to the shift machine.
// Expected exit: 0

machine perform_shift(val: u8, shift: u32) -> u8
requires val >= 25 && val <= 25 && shift == 2
{
    let shifted: u8 = val << shift;
    shifted - 100u8
}

machine forward(val: u8, shift: u32) -> u8
requires val >= 25 && val <= 25 && shift == 2
{
    perform_shift(val, shift)
}

machine probe() -> u8 {
    forward(25u8, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
