// Fact: an 8-bit unsigned u8 logical left shift of a bounded input (val >= 25u8 && val <= 25u8) by 2u32 bits establishes shifted >= 100u8 && shifted <= 100u8 so exact 8-bit subtraction shifted - 100u8 is proved underflow-free across all nine places.
// Place: field. The 8-bit operand and shift count are stored in record fields before left shift and subtraction.
// Expected exit: 0

data ShiftPacket {
    val: u8;
    shift: u32;
}

machine shift_field(packet: ShiftPacket) -> u8
requires packet.val >= 25 && packet.val <= 25 && packet.shift == 2
{
    let shifted: u8 = packet.val << packet.shift;
    shifted - 100u8
}

machine probe() -> u8 {
    let packet: ShiftPacket = ShiftPacket { val: 25u8, shift: 2 };
    shift_field(packet)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
