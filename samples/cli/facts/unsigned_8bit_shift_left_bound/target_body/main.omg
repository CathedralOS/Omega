// Fact: an 8-bit unsigned u8 logical left shift of a bounded input (val >= 25u8 && val <= 25u8) by 2u32 bits establishes shifted >= 100u8 && shifted <= 100u8 so exact 8-bit subtraction shifted - 100u8 is proved underflow-free across all nine places.
// Place: another target body. Each of four target-scoped machine bodies shifts the bounded 8-bit operand and subtracts 100u8.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedShiftTarget {
    machine shift_target(val: u8, shift: u32) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 25 && val <= 25 && shift == 2;
}

X86ShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u8, shift: u32) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 25 && val <= 25 && shift == 2
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: u8 = val << shift;
        shifted - 100u8
    }
}

ArmShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u8, shift: u32) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 25 && val <= 25 && shift == 2
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: u8 = val << shift;
        shifted - 100u8
    }
}

machine probe() -> u8 {
    SelectedShiftTarget::shift_target(25u8, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
