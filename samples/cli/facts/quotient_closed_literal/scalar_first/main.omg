// Expected exit: 0
// Checked quotient operations over custody-free copy representatives.

use omega::language::core::relation;

data Representative [copy] { value: i32; }

proposition equivalent(a: Representative, b: Representative) = a == b;

machine equivalent_reflexive(a: Representative)
ensures a == a
{
}

machine equivalent_symmetric(a: Representative, b: Representative)
requires
    a == b
ensures b == a
{
}

machine equivalent_transitive(
    a: Representative,
    b: Representative,
    c: Representative
)
requires
    a == b
    b == c
ensures a == c
{
}

RepresentativeEquivalence satisfies Equivalence<Representative, equivalent> {
    Reflexive::reflexive = equivalent_reflexive;
    Symmetric::symmetric = equivalent_symmetric;
    Transitive::transitive = equivalent_transitive;
}

data EquivalenceClass [copy] = Representative % equivalent
where equivalent satisfies
    Equivalence<Representative, equivalent>
    as RepresentativeEquivalence;

machine representative(amount: i32, value: Representative) -> i32
requires amount == 3i32
{ amount }

machine representative_respects(amount: i32, left: Representative, right: Representative)
requires
    equivalent(left, right)
    amount == 3i32
    amount == 3i32
ensures representative(amount, left) == representative(amount, right)
{}

machine lifted(value: EquivalenceClass) -> i32 {
    Quotient::lift<representative, representative_respects>(3i32, value)
}

machine main() crashes Trap {
    let item: EquivalenceClass = Representative { value: 11 } as EquivalenceClass;
    transition lifted(item) == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
