// Fact: a 23-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { l5: Level5 { l6: Level6 { l7: Level7 { l8: Level8 { l9: Level9 { l10: Level10 { l11: Level11 { l12: Level12 { l13: Level13 { l14: Level14 { l15: Level15 { l16: Level16 { l17: Level17 { l18: Level18 { l19: Level19 { l20: Level20 { l21: Level21 { l22: Level22 { val: u64 } } } } } } } } } } } } } } } } } } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: field. The 23-level nested record is stored in a container record field before leaf projection and interval discharge.
// Expected exit: 0

data Level22 [copy] {
    val: u64;
}

data Level21 [copy] {
    l22: Level22;
}

data Level20 [copy] {
    l21: Level21;
}

data Level19 [copy] {
    l20: Level20;
}

data Level18 [copy] {
    l19: Level19;
}

data Level17 [copy] {
    l18: Level18;
}

data Level16 [copy] {
    l17: Level17;
}

data Level15 [copy] {
    l16: Level16;
}

data Level14 [copy] {
    l15: Level15;
}

data Level13 [copy] {
    l14: Level14;
}

data Level12 [copy] {
    l13: Level13;
}

data Level11 [copy] {
    l12: Level12;
}

data Level10 [copy] {
    l11: Level11;
}

data Level9 [copy] {
    l10: Level10;
}

data Level8 [copy] {
    l9: Level9;
}

data Level7 [copy] {
    l8: Level8;
}

data Level6 [copy] {
    l7: Level7;
}

data Level5 [copy] {
    l6: Level6;
}

data Level4 [copy] {
    l5: Level5;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}
data Holder [copy] {
    root: RootRec;
}

machine check_bound(root: RootRec) -> u64
requires root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.val >= 40 && root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.val <= 81
{
    let res: u64 = root.l1.l2.l3.l4.l5.l6.l7.l8.l9.l10.l11.l12.l13.l14.l15.l16.l17.l18.l19.l20.l21.l22.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine probe() -> u64 {
    let root: RootRec = RootRec {
            l1: Level1 {
                l2: Level2 {
                    l3: Level3 {
                        l4: Level4 {
                            l5: Level5 {
                                l6: Level6 {
                                    l7: Level7 {
                                        l8: Level8 {
                                            l9: Level9 {
                                                l10: Level10 {
                                                    l11: Level11 {
                                                        l12: Level12 {
                                                            l13: Level13 {
                                                                l14: Level14 {
                                                                    l15: Level15 {
                                                                        l16: Level16 {
                                                                            l17: Level17 {
                                                                                l18: Level18 {
                                                                                    l19: Level19 {
                                                                                        l20: Level20 {
                                                                                            l21: Level21 {
                                                                                                l22: Level22 {
                                                                                                    val: 60u64,
                                                                                                },
                                                                                            },
                                                                                        },
                                                                                    },
                                                                                },
                                                                            },
                                                                        },
                                                                    },
                                                                },
                                                            },
                                                        },
                                                    },
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            },
        };
    let h: Holder = Holder { root: root };
    check_bound(h.root)
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
