// Fact: A 16-bit unsigned u16 logical left shift of a bounded input (val >= 30u16 && val <= 30u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Place: call result. The shifted value is received from a helper call returning the shift result.
// Expected exit: 0

machine compute_shift(v: u16) -> u16
    requires v >= 30u16 && v <= 30u16;
    ensures result >= 120u16 && result <= 120u16;
{
    v << 2u16
}

machine shift_call_result(val: u16) -> i32
    requires val >= 30u16 && val <= 30u16;
{
    let shifted: u16 = compute_shift(val);
    let check: u16 = shifted - 120u16;
    transition shifted == 120u16 && check == 0u16 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = shift_call_result(30u16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
