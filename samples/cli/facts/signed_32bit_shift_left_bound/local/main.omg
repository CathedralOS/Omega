// Fact: a 32-bit signed i32 left shift of a bounded input (val >= 15i32 && val <= 15i32) by 2u32 bits establishes shifted >= 60i32 && shifted <= 60i32 so exact 32-bit signed subtraction shifted - 60i32 is proved overflow-free across all nine places.
// Place: local. Both the bounded signed i32 operand and its left-shifted result are transported through local bindings.
// Expected exit: 0
machine verify_shifted(shifted: i32) -> i32
    requires shifted >= 60 && shifted <= 60
{
    shifted - 60
}

machine compute_local(val: i32) -> i32
    requires val >= 15 && val <= 15
{
    let shifted: i32 = val << 2u32;
    let v: i32 = shifted;
    let transported: i32 = v;
    verify_shifted(transported)
}

machine evaluate() -> i32 {
    compute_local(15)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
