// Fact: 8-bit unsigned saturating addition lhs +| rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Place: call result. The sum is received from a helper call returning the saturating addition result.
// Expected exit: 0

machine compute_sat_sum(l: u8, r: u8) -> u8
    requires l >= 40u8 && l <= 80u8;
    requires r >= 10u8 && r <= 20u8;
    ensures result >= 50u8 && result <= 100u8;
{
    let a: u8 in Saturating = l as u8 in Saturating;
    let b: u8 in Saturating = r as u8 in Saturating;
    let s: u8 in Saturating = a + b;
    s as u8
}

machine add_call_result(lhs: u8, rhs: u8) -> i32
    requires lhs >= 40u8 && lhs <= 80u8;
    requires rhs >= 10u8 && rhs <= 20u8;
{
    let sum: u8 = compute_sat_sum(lhs, rhs);
    let headroom: u8 = 100u8 - sum;
    let margin: u8 = sum - 50u8;
    transition sum == 75u8 && headroom + margin == 50u8 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = add_call_result(60u8, 15u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
