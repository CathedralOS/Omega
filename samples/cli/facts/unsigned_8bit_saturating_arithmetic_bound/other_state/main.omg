// Fact: 8-bit unsigned saturating addition lhs +| rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Place: another state. A successor state receives the sum and verifies the arithmetic interval.
// Expected exit: 0

machine add_other_state(lhs: u8, rhs: u8) -> i32
    requires lhs >= 40u8 && lhs <= 80u8;
    requires rhs >= 10u8 && rhs <= 20u8;
{
    let a: u8 in Saturating = lhs as u8 in Saturating;
    let b: u8 in Saturating = rhs as u8 in Saturating;
    let s_sat: u8 in Saturating = a + b;
    let sum: u8 = s_sat as u8;
    transition {
        _ -> check_state(sum)
    }
    machine check_state(s: u8) -> i32
        requires s >= 50u8 && s <= 100u8;
    {
        let headroom: u8 = 100u8 - s;
        let margin: u8 = s - 50u8;
        transition s == 75u8 && headroom + margin == 50u8 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = add_other_state(60u8, 15u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
