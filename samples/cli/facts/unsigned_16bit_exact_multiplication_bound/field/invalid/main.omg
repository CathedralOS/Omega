// Fact: a 16-bit unsigned u16 exact multiplication of bounded inputs (lhs >= 20u16 && lhs <= 30u16, rhs >= 15u16 && rhs <= 25u16) establishes prod >= 300u16 && prod <= 750u16 so exact 16-bit subtractions 750u16 - prod and prod - 300u16 are proved overflow-free across all nine places.
// Invalid: packet.rhs upper bound widened to 26u16 so prod can reach 780u16, overflowing 750u16 - prod.
// Expected exit: 0

data MulPacket {
    lhs: u16;
    rhs: u16;
}

machine mul_field(packet: MulPacket) -> u16
requires packet.lhs >= 20 && packet.lhs <= 30 && packet.rhs >= 15 && packet.rhs <= 26
{
    let prod: u16 = packet.lhs * packet.rhs;
    let headroom: u16 = 750u16 - prod;
    let margin: u16 = prod - 300u16;
    headroom + margin
}

machine probe() -> u16 {
    let packet: MulPacket = MulPacket { lhs: 25u16, rhs: 20u16 };
    mul_field(packet)
}

machine main() crashes Trap {
    transition probe() == 450 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
