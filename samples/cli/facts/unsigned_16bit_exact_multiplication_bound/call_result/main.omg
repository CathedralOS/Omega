// Fact: a 16-bit unsigned u16 exact multiplication of bounded inputs (lhs >= 20u16 && lhs <= 30u16, rhs >= 15u16 && rhs <= 25u16) establishes prod >= 300u16 && prod <= 750u16 so exact 16-bit subtractions 750u16 - prod and prod - 300u16 are proved overflow-free across all nine places.
// Place: call result. Contracted helper calls return bounded 16-bit operands before multiplication and subtractions.
// Expected exit: 0

machine get_lhs() -> u16
ensures result >= 20 && result <= 30
{
    25u16
}

machine get_rhs() -> u16
ensures result >= 15 && result <= 25
{
    20u16
}

machine mul_call_result() -> u16 {
    let l: u16 = get_lhs();
    let r: u16 = get_rhs();
    let prod: u16 = l * r;
    let headroom: u16 = 750u16 - prod;
    let margin: u16 = prod - 300u16;
    headroom + margin
}

machine probe() -> u16 {
    mul_call_result()
}

machine main() crashes Trap {
    transition probe() == 450 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
