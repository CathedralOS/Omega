// Fact: align_of(value) observes the storage location of a live u64 place, the referent of a &u64, or the first element of a nonempty [u64] slice, and reports that location's guaranteed alignment, at least 8u64 on every hosted target, discharging exact subtraction alignment - 8u64 across all nine places.
// Invalid: the borrowed parameter refers to a u32, whose guaranteed alignment is only 4u64, so the unchanged subtraction alignment - 8u64 can underflow.

machine slack_of(value: &u32) -> u64 {
    let alignment: u64 = align_of(value);
    alignment - 8u64
}

machine referent_alignment(tag: &u8) -> u64 {
    align_of(tag)
}

machine main() crashes Trap {
    let cell: u32 = 41u32;
    let tag: u8 = 3u8;
    let slack: u64 = slack_of(&cell);
    let tag_alignment: u64 = referent_alignment(&tag);
    transition slack == 0u64 && tag_alignment == 1u64 && cell == 41u32 && tag == 3u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
