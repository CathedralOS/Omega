// Fact: align_of(value) observes the storage location of a live u64 place, the referent of a &u64, or the first element of a nonempty [u64] slice, and reports that location's guaranteed alignment, at least 8u64 on every hosted target, discharging exact subtraction alignment - 8u64 across all nine places.
// Invalid: the taken arm observes a u32 local, whose guaranteed alignment is only 4u64, so the joined subtraction alignment - 8u64 can underflow.

machine slack_after_join(flag: bool) -> u64 {
    let near: u32 = 41u32;
    let far: u64 = 43u64;
    let alignment: u64 = match flag {
        true -> align_of(near),
        false -> align_of(far) + align_of(far),
    };
    alignment - 8u64
}

machine main() crashes Trap {
    let taken: u64 = slack_after_join(true);
    let fallback: u64 = slack_after_join(false);
    transition taken == 0u64 && fallback == 8u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
