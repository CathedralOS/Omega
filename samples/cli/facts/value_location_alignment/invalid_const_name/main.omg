// Fact: align_of(value) observes the storage location of a live u64 place, the referent of a &u64, or the first element of a nonempty [u64] slice, and reports that location's guaranteed alignment, at least 8u64 on every hosted target, discharging exact subtraction alignment - 8u64 across all nine places.
// Invalid: the observed local is a u32, whose guaranteed alignment is only 4u64, so the unchanged subtraction against REQUIRED_ALIGNMENT can underflow.

const REQUIRED_ALIGNMENT: u64 = 8u64;

machine main() crashes Trap {
    let cell: u32 = 41u32;
    let tag: u8 = 3u8;
    let alignment: u64 = align_of(cell);
    let slack: u64 = alignment - REQUIRED_ALIGNMENT;
    let tag_alignment: u64 = align_of(tag);
    transition alignment == 8u64 && slack == 0u64 && tag_alignment == 1u64 && cell == 41u32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
