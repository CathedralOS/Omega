use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "foreign_package_service_reach_const_name");
    Build::bind(builder, windows_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_arm64::ProgramEntry, start);
    Build::bind(builder, macos_arm64::ProgramEntry, start);
    Build::bind<CharacterCase::upper>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "msvcrt.dll", export: "toupper" }
    });
    Build::bind<CharacterCase::upper>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "toupper", version: "GLIBC_2.2.5"
        }
    });
    Build::bind<CharacterCase::upper>(builder, linux_arm64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "toupper", version: "GLIBC_2.17"
        }
    });
    Build::bind<CharacterCase::upper>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_toupper"
        }
    });
}
