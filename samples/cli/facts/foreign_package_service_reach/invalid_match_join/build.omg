use {omega}/language/core/external_binding.omg as foreign;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "foreign_package_service_reach_match_join" };
    Build::bind(builder, windows_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_arm64::ProgramEntry, start);
    Build::bind(builder, macos_arm64::ProgramEntry, start);
    Build::bind_native::<CharacterCase::upper>(builder, windows_x86_64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::PeByName { library: "msvcrt.dll", export: "toupper" }
    });
    Build::bind_native::<CharacterCase::upper>(builder, linux_x86_64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "toupper", version: "GLIBC_2.2.5"
        }
    });
    Build::bind_native::<CharacterCase::upper>(builder, linux_arm64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "toupper", version: "GLIBC_2.17"
        }
    });
    Build::bind_native::<CharacterCase::upper>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_toupper"
        }
    });
}
