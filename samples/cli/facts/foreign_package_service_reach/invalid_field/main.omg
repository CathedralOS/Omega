// A Build-bound foreign requirement whose recorded reach names a package-declared service runs its selected native import in Terminal and native with the same exact result.
// Expected exit: 0
// A memberless package service: it names what the foreign leaf reaches and
// grants no capability.
public boundary trait Lettering {}
public boundary trait CharacterCase {
    machine upper(character: i32) -> i32 reaches Lettering;
}
machine demand(result: bool) crashes Trap {
    transition result { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
data Letters [copy] { before: i32; upper: i32; after: i32; }
machine start() reaches crashes Trap {
    let letters: Letters = Letters { before: 1701, upper: CharacterCase::upper(100), after: 1801 };
    demand(letters.before == 1701 && letters.upper == 68 && letters.after == 1801);
    let digits: Letters = Letters { before: 1702, upper: CharacterCase::upper(50), after: 1802 };
    demand(digits.before == 1702 && digits.upper == 50 && digits.after == 1802);
}
