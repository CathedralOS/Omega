// Fact: querying size_of and align_of on a nested structural record (Outer { inner: Inner, tag: u64 } with Inner { a: u64, b: u64 }) establishes its exact 24-byte composite layout geometry (size == 24u64 and align == 8u64), discharging exact subtraction size - (align * 3u64) across all nine places.
// Invalid: Inner is narrowed to a single u64 field so Outer has size == 16u64, align == 8u64, causing receive_size(s) - (receive_align(a) * 3u64) to underflow u64.
// Expected exit: 0

data Inner {
    a: u64;
}

data Outer {
    inner: Inner;
    tag: u64;
}

machine receive_size(s: u64) -> u64 {
    s
}

machine receive_align(a: u64) -> u64 {
    a
}

machine main() crashes Trap {
    let s: u64 = size_of<Outer>();
    let a: u64 = align_of<Outer>();
    let diff: u64 = receive_size(s) - (receive_align(a) * 3u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
