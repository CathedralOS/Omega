// Fact: querying size_of and align_of on a nested structural record (Outer { inner: Inner, tag: u64 } with Inner { a: u64, b: u64 }) establishes its exact 24-byte composite layout geometry (size == 24u64 and align == 8u64), discharging exact subtraction size - (align * 3u64) across all nine places.
// Place: const name. Named constants evaluate size_of and align_of before subtracting.
// Expected exit: 0

data Inner {
    a: u64;
    b: u64;
}

data Outer {
    inner: Inner;
    tag: u64;
}

const RECORD_SIZE: u64 = size_of<Outer>();
const RECORD_ALIGN: u64 = align_of<Outer>();

machine main() crashes Trap {
    let diff: u64 = RECORD_SIZE - (RECORD_ALIGN * 3u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
