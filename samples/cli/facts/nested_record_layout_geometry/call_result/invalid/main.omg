// Fact: querying size_of and align_of on a nested structural record (Outer { inner: Inner, tag: u64 } with Inner { a: u64, b: u64 }) establishes its exact 24-byte composite layout geometry (size == 24u64 and align == 8u64), discharging exact subtraction size - (align * 3u64) across all nine places.
// Invalid: Inner is narrowed to a single u64 field so Outer has size == 16u64, align == 8u64, causing query_size() - (query_align() * 3u64) to underflow u64.
// Expected exit: 0

data Inner {
    a: u64;
}

data Outer {
    inner: Inner;
    tag: u64;
}

machine query_size() -> u64 {
    size_of<Outer>()
}

machine query_align() -> u64 {
    align_of<Outer>()
}

machine main() crashes Trap {
    let s: u64 = query_size();
    let a: u64 = query_align();
    let diff: u64 = s - (a * 3u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
