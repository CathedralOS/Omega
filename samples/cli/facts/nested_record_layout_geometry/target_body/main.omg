// Fact: querying size_of and align_of on a nested structural record (Outer { inner: Inner, tag: u64 } with Inner { a: u64, b: u64 }) establishes its exact 24-byte composite layout geometry (size == 24u64 and align == 8u64), discharging exact subtraction size - (align * 3u64) across all nine places.
// Place: another target body. Each of four target bodies evaluates size_of and align_of and subtracts.
// Expected exit: 0

data Inner {
    a: u64;
    b: u64;
}

data Outer {
    inner: Inner;
    tag: u64;
}

linux_x86_64 machine compute_geometry() -> u64 {
    size_of<Outer>() - (align_of<Outer>() * 3u64)
}

linux_arm64 machine compute_geometry() -> u64 {
    size_of<Outer>() - (align_of<Outer>() * 3u64)
}

macos_arm64 machine compute_geometry() -> u64 {
    size_of<Outer>() - (align_of<Outer>() * 3u64)
}

windows_x86_64 machine compute_geometry() -> u64 {
    size_of<Outer>() - (align_of<Outer>() * 3u64)
}

machine probe() -> u64 {
    compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
