// Fact: querying size_of and align_of on a nested structural record (Outer { inner: Inner, tag: u64 } with Inner { a: u64, b: u64 }) establishes its exact 24-byte composite layout geometry (size == 24u64 and align == 8u64), discharging exact subtraction size - (align * 3u64) across all nine places.
// Place: another machine. An intermediate forwarding machine delegates the subtraction to the geometry query machine.
// Expected exit: 0

data Inner {
    a: u64;
    b: u64;
}

data Outer {
    inner: Inner;
    tag: u64;
}

machine query_geometry() -> u64 {
    let s: u64 = size_of<Outer>();
    let a: u64 = align_of<Outer>();
    s - (a * 3u64)
}

machine runner() -> u64 {
    query_geometry()
}

machine main() crashes Trap {
    let diff: u64 = runner();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
