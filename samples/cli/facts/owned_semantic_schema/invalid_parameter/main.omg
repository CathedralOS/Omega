// Fact: Owned semantic schemas retain complete numbered mixed-data descriptions and graph-local relationships under the query author's authority.
// Expected exit: 0
use omega::language::core::reflect;
use foreign;

domain u64::PayloadValue requires self <= 50;
data Reading [copy] {
    #8 header: u8;
    #3 sequence: u64;
    #90 case Sample(#1 value: u64 in PayloadValue, retired #2);
    #7 case Empty;
}
data ExpectedPayload { value: u64 in PayloadValue; }
data ExpectedPlain { value: u64; }
data Envelope [copy] { left: u64; graph: reflect::TypeSchema; right: u64; }

machine describe_here<T>() -> reflect::TypeSchema { reflect::schema<T>() }

machine equal_bytes(left: &[u8], right: &[u8]) -> bool {
    transition left.len == right.len {
        true -> scan(left, right)
        false -> false
    }
    machine scan(left: &[u8], right: &[u8]) -> bool
    requires left.len == right.len {
        transition left.len > 0u64 {
            true -> item(left, right)
            false -> true
        }
    }
    machine item(left: &[u8], right: &[u8]) -> bool
    requires left.len == right.len && left.len > 0u64 {
        transition left[0u64] == right[0u64] {
            true -> scan(&left[1u64..], &right[1u64..])
            false -> false
        }
    }
}
machine require_true(value: bool) crashes Trap {
    transition value { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine check_qualification<'graph, 'expected>(payload: &reflect::SchemaNode<'graph>, expected_graph: &'expected reflect::TypeSchema, same: bool) crashes Trap {
    let expected_fields: reflect::SchemaMembers<'expected> = reflect::schema_fields(expected_graph);
    let expected: reflect::SchemaNode<'expected> = reflect::members_get(&expected_fields, 0u64);
    let observed: bool = equal_bytes(reflect::node_qualified_type(payload), reflect::node_qualified_type(&expected));
    require_true(observed == same);
}

machine inspect<'graph>(graph: &'graph reflect::TypeSchema) crashes Trap {
    let root: reflect::SchemaNode<'graph> = reflect::schema_root(graph);
    let fields: reflect::SchemaMembers<'graph> = reflect::schema_fields(graph);
    let cases: reflect::SchemaMembers<'graph> = reflect::schema_cases(graph);
    let members: reflect::SchemaMembers<'graph> = reflect::node_members(&root);
    require_true(reflect::node_role(&root) == 1u64);
    require_true(reflect::node_shape(&root) == 3u64);
    require_true(reflect::node_identity_is_hermetic(&root));
    require_true(equal_bytes(reflect::node_name(&root), "Reading"));
    require_true(reflect::members_count(&members) == 4u64);
    require_true(reflect::members_count(&fields) == 2u64);
    require_true(reflect::members_count(&cases) == 2u64);
    let header: reflect::SchemaNode<'graph> = reflect::members_get(&fields, 0u64);
    let sequence: reflect::SchemaNode<'graph> = reflect::members_get(&fields, 1u64);
    let sample: reflect::SchemaNode<'graph> = reflect::members_get(&cases, 0u64);
    let empty: reflect::SchemaNode<'graph> = reflect::members_get(&cases, 1u64);
    require_true(equal_bytes(reflect::node_name(&header), "header"));
    require_true(equal_bytes(reflect::node_name(&sequence), "sequence"));
    require_true(equal_bytes(reflect::node_name(&sample), "Sample"));
    require_true(equal_bytes(reflect::node_name(&empty), "Empty"));
    require_true(reflect::node_declaration_position(&header) == 0u64);
    require_true(reflect::node_declaration_position(&sequence) == 1u64);
    require_true(reflect::node_declaration_position(&sample) == 2u64);
    require_true(reflect::node_declaration_position(&empty) == 3u64);
    require_true(reflect::node_has_stable_number(&header));
    require_true(reflect::node_has_stable_number(&sequence));
    require_true(reflect::node_has_stable_number(&sample));
    require_true(reflect::node_has_stable_number(&empty));
    require_true(reflect::node_stable_number(&header) == 8u64);
    require_true(reflect::node_stable_number(&sequence) == 3u64);
    require_true(reflect::node_stable_number(&sample) == 90u64);
    require_true(reflect::node_stable_number(&empty) == 7u64);
    let payloads: reflect::SchemaMembers<'graph> = reflect::node_members(&sample);
    let none: reflect::SchemaMembers<'graph> = reflect::node_members(&empty);
    require_true(reflect::members_count(&payloads) == 1u64);
    require_true(reflect::members_count(&none) == 0u64);
    let payload: reflect::SchemaNode<'graph> = reflect::members_get(&payloads, 0u64);
    let owner: reflect::SchemaNode<'graph> = reflect::node_owner_case(&payload);
    let common_owner: reflect::SchemaNode<'graph> = reflect::node_owner_case(&header);
    require_true(reflect::node_role(&common_owner) == 0u64);
    require_true(equal_bytes(reflect::node_identity(&owner), reflect::node_identity(&sample)));
    require_true(equal_bytes(reflect::node_name(&payload), "value"));
    require_true(reflect::node_stable_number(&payload) == 1u64);
    require_true(reflect::node_declaration_position(&payload) == 0u64);
    require_true(!reflect::node_is_erased(&payload));
    require_true(reflect::node_retired_count(&sample) == 1u64);
    require_true(reflect::node_retired_number(&sample, 0u64) == 2u64);
    // A separate owner with the same declared field type gives an exact
    // runtime oracle for the complete qualified type, without guessing its
    // package identity or parsing a display name into authority.
    let expected_graph: reflect::TypeSchema = reflect::schema<ExpectedPayload>();
    check_qualification(&payload, &expected_graph, true);
    let plain_graph: reflect::TypeSchema = reflect::schema<ExpectedPlain>();
    check_qualification(&payload, &plain_graph, false);
    let invalid: reflect::SchemaNode<'graph> = reflect::schema_node(graph, 18446744073709551615u64);
    require_true(reflect::node_role(&invalid) == 0u64);
}
machine consume(selected: reflect::TypeSchema) crashes Trap { inspect(&selected); }
machine main() crashes Trap {
    let produced: reflect::TypeSchema = foreign::describe<Reading>();
    consume(produced);
}
