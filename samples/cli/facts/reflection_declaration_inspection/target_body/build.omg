use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "reflection_declaration_inspection" };
    Build::select_provider::<|app|::Inspect, |app|::WindowsInspect>(builder, windows_x86_64);
    Build::select_provider::<|app|::Inspect, |app|::LinuxX86Inspect>(builder, linux_x86_64);
    Build::select_provider::<|app|::Inspect, |app|::MacInspect>(builder, macos_arm64);
    Build::select_provider::<|app|::Inspect, |app|::LinuxArmInspect>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
