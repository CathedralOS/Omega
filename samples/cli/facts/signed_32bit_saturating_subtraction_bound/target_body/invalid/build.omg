machine build(builder: &mut Build) {
    Build::select_provider<SelectedEvaluateDiff, CheckedEvaluateDiff>(builder, linux_x86_64);
    Build::select_provider<SelectedEvaluateDiff, CheckedEvaluateDiff>(builder, linux_arm64);
    Build::select_provider<SelectedEvaluateDiff, CheckedEvaluateDiff>(builder, macos_arm64);
    Build::select_provider<SelectedEvaluateDiff, CheckedEvaluateDiff>(builder, windows_x86_64);

    Build::application(builder, "signed_32bit_saturating_subtraction_bound_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
