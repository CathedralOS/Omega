// Fact: 32-bit signed saturating subtraction lhs -| rhs with bounded interval 40i32 <= diff <= 100i32 establishes 40i32 <= diff <= 100i32 across all nine places so exact subtractions 100i32 - diff and diff - 40i32 are safe.
// Place: target body (invalid twin).

machine compute_diff(lhs: i32, rhs: i32) -> i32
requires lhs >= 80i32 && lhs <= 125i32
    && rhs >= 20i32 && rhs <= 40i32
ensures result >= 40i32 && result <= 105i32
{
    let sat_lhs: i32 in Saturating = lhs as i32 in Saturating;
    let sat_rhs: i32 in Saturating = rhs as i32 in Saturating;
    let sat_diff: i32 in Saturating = sat_lhs - sat_rhs;
    sat_diff as i32
}

machine verify_diff(diff: i32) -> i32 crashes Trap
requires diff >= 40i32 && diff <= 100i32
ensures result == 0i32
{
    let headroom: i32 = 100i32 - diff;
    let margin: i32 = diff - 40i32;
    transition headroom == 30i32 && margin == 30i32 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

linux_x86_64 machine evaluate_diff() -> i32 crashes Trap
ensures result == 0i32
{
    let diff: i32 = compute_diff(125i32, 20i32);
    verify_diff(diff)
}

linux_arm64 machine evaluate_diff() -> i32 crashes Trap
ensures result == 0i32
{
    let diff: i32 = compute_diff(125i32, 20i32);
    verify_diff(diff)
}

macos_arm64 machine evaluate_diff() -> i32 crashes Trap
ensures result == 0i32
{
    let diff: i32 = compute_diff(125i32, 20i32);
    verify_diff(diff)
}

windows_x86_64 machine evaluate_diff() -> i32 crashes Trap
ensures result == 0i32
{
    let diff: i32 = compute_diff(125i32, 20i32);
    verify_diff(diff)
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    evaluate_diff()
}

machine main() crashes Trap {
    transition probe() == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
