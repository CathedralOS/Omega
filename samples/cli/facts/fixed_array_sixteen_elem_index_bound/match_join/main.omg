// Fact: a static index bound idx < 16u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 16].
// Place: match join. Both branches of a match expression produce in-bounds indices.
// Expected exit: 0

machine read_element(values: [u64; 16], idx: u64, flag: bool) -> u64
    requires idx < 16u64;
{
    let joined_index: u64 = match flag { true -> idx, false -> 0u64 };
    values[joined_index]
}

machine main() crashes Trap {
    let arr: [u64; 16] = [
        10u64, 20u64, 30u64, 40u64, 50u64, 60u64, 70u64, 80u64,
        90u64, 100u64, 110u64, 120u64, 130u64, 140u64, 150u64, 160u64
    ];
    let elem1: u64 = read_element(arr, 11u64, true);
    let elem2: u64 = read_element(arr, 11u64, false);
    transition elem1 == 120u64 && elem2 == 10u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
