// Fact: a static index bound idx < 16u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 16].
// Place: another state. A transition to a successor state forwards the bounded index and array.
// Invalid: the state transition contract is weakened to index <= 16u64, so the index may exceed length 16.
// Expected rejection: cannot prove index

machine read_element(values: [u64; 16], idx: u64) -> u64
    requires idx <= 16u64;
{
    transition { _ -> element(values, idx) }
    machine element(passed_values: [u64; 16], passed_index: u64) -> u64
        requires passed_index <= 16u64;
    {
        passed_values[passed_index]
    }
}

machine main() crashes Trap {
    let arr: [u64; 16] = [
        10u64, 20u64, 30u64, 40u64, 50u64, 60u64, 70u64, 80u64,
        90u64, 100u64, 110u64, 120u64, 130u64, 140u64, 150u64, 160u64
    ];
    let elem: u64 = read_element(arr, 11u64);
    transition elem == 120u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
