// Fact: a static index bound idx < 16u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 16].
// Place: call result. The index arrives from a helper call with an ensures result < 16u64 contract.
// Expected exit: 0

machine supply_index(idx: u64) -> u64
    requires idx < 16u64;
    ensures result < 16u64;
{
    idx
}

machine read_element(values: [u64; 16], idx: u64) -> u64
    requires idx < 16u64;
{
    let picked_index: u64 = supply_index(idx);
    values[picked_index]
}

machine main() crashes Trap {
    let arr: [u64; 16] = [
        10u64, 20u64, 30u64, 40u64, 50u64, 60u64, 70u64, 80u64,
        90u64, 100u64, 110u64, 120u64, 130u64, 140u64, 150u64, 160u64
    ];
    let elem: u64 = read_element(arr, 11u64);
    transition elem == 120u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
