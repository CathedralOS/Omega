// Fact: a static index bound idx < 16u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 16].
// Place: another target body. Each of four target bodies reads the array element using the bounded index.
// Invalid: all target bodies weaken the index bound to idx <= 16u64, so the index may exceed length 16.
// Expected rejection: cannot prove index

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReadElement {
    machine read_element(values: [u64; 16], idx: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires idx <= 16u64;
}

X86ReadElement satisfies SelectedReadElement {
    machine read_element(values: [u64; 16], idx: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires idx <= 16u64
    {
        SelectedBodyCheck::require_tag(17u64);
        values[idx]
    }
}

ArmReadElement satisfies SelectedReadElement {
    machine read_element(values: [u64; 16], idx: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires idx <= 16u64
    {
        SelectedBodyCheck::require_tag(29u64);
        values[idx]
    }
}

machine probe(values: [u64; 16], idx: u64) -> u64
    requires idx <= 16u64
{
    SelectedReadElement::read_element(values, idx)
}

machine main() crashes Trap {
    let arr: [u64; 16] = [
        10u64, 20u64, 30u64, 40u64, 50u64, 60u64, 70u64, 80u64,
        90u64, 100u64, 110u64, 120u64, 130u64, 140u64, 150u64, 160u64
    ];
    let elem: u64 = probe(arr, 11u64);
    transition elem == 120u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
