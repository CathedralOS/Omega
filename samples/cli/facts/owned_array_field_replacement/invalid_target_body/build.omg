machine build(builder: &mut Build) {
    Build::application(builder, "owned_array_field_replacement_target_body");
    Build::select_provider<HostedPacket, HostedPacketBody>(builder, linux_x86_64);
    Build::select_provider<HostedPacket, HostedPacketBody>(builder, linux_arm64);
    Build::select_provider<HostedPacket, HostedPacketBody>(builder, macos_arm64);
    Build::select_provider<HostedPacket, HostedPacketBody>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
