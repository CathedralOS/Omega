use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "owned_array_field_replacement_target_body" };
    Build::select_provider::<|app|::HostedPacket, |app|::HostedPacketBody>(builder, linux_x86_64);
    Build::select_provider::<|app|::HostedPacket, |app|::HostedPacketBody>(builder, linux_arm64);
    Build::select_provider::<|app|::HostedPacket, |app|::HostedPacketBody>(builder, macos_arm64);
    Build::select_provider::<|app|::HostedPacket, |app|::HostedPacketBody>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
