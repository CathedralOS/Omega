// Replacing the owned array field with [7, 4] establishes its current [7, 4] contents while the earlier owned copy remains [3, 1].
// Expected exit: 0

data Holder { before: u64; items: [u64; 2]; after: u64; }
data Packet { current: Holder; previous: [u64; 2]; marker: u64; }
machine installed(values: &[u64; 2]) -> bool { values[0] == 7 && values[1] == 4 }
machine install(holder: &mut Holder, incoming: [u64; 2])
requires holder.items[0] == 3 && holder.items[1] == 1 && installed(&incoming) == true
ensures installed(&holder.items) == true
{
    holder.items = incoming;
}
machine consume(packet: &Packet) -> u64
requires installed(&packet.current.items) == true && packet.previous[0] == 3 && packet.previous[1] == 1
ensures result == 3
{ packet.previous[0] }
machine produce(marker: u64) -> Packet
ensures installed(&result.current.items) == true && result.previous[0] == 3 && result.previous[1] == 1
{
    let mut holder: Holder = Holder { before: 11, items: [3, 1], after: 13 };
    let previous: [u64; 2] = holder.items;
    install(&mut holder, [7, 4]);
    Packet { current: holder, previous: previous, marker: marker }
}
machine selected_packet(select: bool) -> Packet
ensures installed(&result.current.items) == true && result.previous[0] == 3 && result.previous[1] == 1
{
    match select {
        true -> produce(11)
        false -> produce(13)
    }
}
machine main() crashes Trap {
    let first: Packet = selected_packet(true);
    let first_observed: u64 = consume(&first);
    let second: Packet = selected_packet(false);
    let second_observed: u64 = consume(&second);
    transition first_observed == 3 && second_observed == 3 && first.current.items[0] == 7 && first.current.items[1] == 4 && first.previous[0] == 3 && first.previous[1] == 1 && first.current.before == 11 && first.current.after == 13 && first.marker == 11 && second.current.items[0] == 7 && second.current.items[1] == 4 && second.previous[0] == 3 && second.previous[1] == 1 && second.current.before == 11 && second.current.after == 13 && second.marker == 13 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
