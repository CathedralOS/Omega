// Expected rejection: cannot prove index at the length-2 indexing operation.
public data Index [copy] { value: u32; }
domain Index::Bounded requires self.value <= 2;
public boundary trait Required { machine get(index: Index) -> u32 reaches none crashes none; }
public Actual satisfies Required {
    machine get(index: Index) -> u32 {
        transition index in Index::Bounded { true -> read(index), false -> 0u32 }
        machine read(index: Index) -> u32 requires index in Index::Bounded {
            let values: [u32; 2] = [7, 11];
            values[index.value]
        }
    }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches none crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedExercise {
    machine exercise() -> u32 reaches Required, SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap;
}
X86Exercise satisfies SelectedExercise {
    machine exercise() -> u32 reaches Required, SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        Required::get(Index { value: 1 })
    }
}
ArmExercise satisfies SelectedExercise {
    machine exercise() -> u32 reaches Required, SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        Required::get(Index { value: 1 })
    }
}

machine main() reaches Required, SelectedBodyCheck crashes Trap {
    let observed: u32 = SelectedExercise::exercise();
    transition observed == 11 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
