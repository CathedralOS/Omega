// Expected rejection: cannot prove index at the length-2 indexing operation.
data Index [copy] { value: u32; }
domain Index::Bounded requires self.value <= 2;
public boundary trait Required { machine get(index: Index) -> u32 reaches none crashes none; }
public Actual satisfies Required {
    machine get(index: Index) -> u32 {
        transition index in Index::Bounded { true -> read(index), false -> 0u32 }
        machine read(index: Index) -> u32 requires index in Index::Bounded {
            let values: [u32; 2] = [7, 11];
            values[index.value]
        }
    }
}
data Holder [copy] { index: Index; }
machine main() reaches Required crashes Trap {
    let holder: Holder = Holder { index: Index { value: 1 } };
    let observed: u32 = Required::get(holder.index);
    transition observed == 11 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
