// Complete target-neutral reproducer. Expected main result: 42.
// The local byte owner must remain live across the selected case edge.
// Expected exit: 0
data ReadOutcome {
    case Complete(count: u64);
    case End(count: u64);
    case Full(count: u64);
    case Invalid;
}
machine receive(line: &mut [u8; 64]) -> ReadOutcome {
    line[0] = 37;
    ReadOutcome::Complete { count: 5 }
}
machine main() crashes Trap {
    let mut line: [u8; 64];
    let result: ReadOutcome = receive(&mut line);
    transition result {
        ReadOutcome::Complete { count } -> observe(&line, count)
        ReadOutcome::End { count } -> observe(&line, count)
        ReadOutcome::Full { count } -> done()
        ReadOutcome::Invalid -> done()
    }
    machine observe(line: &[u8; 64], count: u64) {
        transition (line[0] as u64 in Wrapping + count as u64 in Wrapping) == 42 {
            true -> done()
            false -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
