// A linear Token [linear] carries its exact payload across the place and retires through its explicit consuming machine on every normal exit.
// Place: target body. Each target body retires the linear Token.
// Expected exit: 0
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
machine retire(token: Token) -> u64 {
    let v: u64 = token.value;
    drop(token);
    v
}

linux_x86_64 machine consume(token: Token) -> u64 {
    let first: u64 = retire(token);
    retire(token)
}

linux_arm64 machine consume(token: Token) -> u64 {
    let first: u64 = retire(token);
    retire(token)
}

macos_arm64 machine consume(token: Token) -> u64 {
    let first: u64 = retire(token);
    retire(token)
}

windows_x86_64 machine consume(token: Token) -> u64 {
    let first: u64 = retire(token);
    retire(token)
}

machine probe() -> u64 {
    let token: Token = Token { value: 42 };
    consume(token)
}

machine main() crashes Trap {
    transition probe() == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
