// A linear Token [linear] carries its exact payload across the place and retires through its explicit consuming machine on every normal exit.
// Place: target body. Each target body retires the linear Token.
// Expected exit: 0
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
machine retire(token: Token) -> u64 {
    let v: u64 = token.value;
    drop(token);
    v
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedConsume {
    machine consume(token: Token) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Consume satisfies SelectedConsume {
    machine consume(token: Token) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let first: u64 = retire(token);
        retire(token)
    }
}

ArmConsume satisfies SelectedConsume {
    machine consume(token: Token) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let first: u64 = retire(token);
        retire(token)
    }
}

machine probe() -> u64 {
    let token: Token = Token { value: 42 };
    SelectedConsume::consume(token)
}

machine main() crashes Trap {
    transition probe() == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
