// A linear Token [linear] carries its exact payload across the place and retires through its explicit consuming machine on every normal exit.
// Place: match join. Both branches yield the linear Token into retirement.
// Expected exit: 0
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
machine retire(token: Token) -> u64 {
    let v: u64 = token.value;
    drop(token);
    v
}

machine choose(flag: bool) -> Token {
    transition flag {
        true -> left()
        false -> right()
    }
    machine left() -> Token {
        Token { value: 42 }
    }
    machine right() -> Token {
        Token { value: 42 }
    }
}

machine probe(flag: bool) -> u64 {
    let token: Token = choose(flag);
    let first: u64 = retire(token);
    retire(token)
}

machine main() crashes Trap {
    transition probe(true) == 42 && probe(false) == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
