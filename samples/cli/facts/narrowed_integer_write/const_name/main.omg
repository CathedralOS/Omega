// A completed write of 70 through a signed eight-bit field retains its i64 meaning and leaves the adjacent byte unchanged.
// Place: const_name.
// Expected exit: 0
use {omega}/language/core/layout.omg;


SignedByte satisfies |layout|::FixedLayout<PortableByte> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none terminates {
    let mutable entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry {
        key: schema.fields[0].key,
        representation: |layout|::FieldPlan::IntegerAt {
            offset: 0, stored_width: 8, interpretation: |layout|::IntegerInterpretation::Signed,
        },
    };
    |layout|::LayoutPlan { entries: entries, entry_count: 1, size_fixed: 1, size_is_dynamic: false, align: 1 }
}
}
data PortableByte [copy] { value: i64; }
data Memory { bytes: [u8; 2]; }
machine store(destination: @mutable i64, value: i64) { $destination = value; }
const Written: i64 = 70;
machine main(memory: @mutable Memory) crashes Trap {
    memory.bytes[1] = 85;
    let packed: @mutable |layout|::LayoutStorage<PortableByte, SignedByte> = @mutable memory.bytes[0] as @mutable |layout|::LayoutStorage<PortableByte, SignedByte>;
    let value: i64 = Written;
    store(@mutable packed.value, value);
    transition memory.bytes[0] == 70 && memory.bytes[1] == 85 {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mutable entry_storage: Memory;
    main(@mutable entry_storage);
}
