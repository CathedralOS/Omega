use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "narrowed_integer_write_target_body" };
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::SelectedPerform, |app|::X86Perform>(builder, macos_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::SelectedPerform, |app|::X86Perform>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::SelectedPerform, |app|::X86Perform>(builder, linux_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::SelectedPerform, |app|::ArmPerform>(builder, macos_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::select_provider::<|app|::SelectedPerform, |app|::ArmPerform>(builder, linux_arm64);
}
