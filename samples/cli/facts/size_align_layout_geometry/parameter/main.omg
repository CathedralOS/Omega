// Fact: querying size_of and align_of on a two-field u64 structural record (Pair { lo: u64, hi: u64 }) establishes its exact layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: parameter. Helper machines receive the queried size and alignment directly as explicit parameters.
// Expected exit: 0

data Pair {
    lo: u64;
    hi: u64;
}

machine receive_size(s: u64) -> u64 {
    s
}

machine receive_align(a: u64) -> u64 {
    a
}

machine main() crashes Trap {
    let s: u64 = size_of<Pair>();
    let a: u64 = align_of<Pair>();
    let diff: u64 = receive_size(s) - (receive_align(a) * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
