// Fact: querying size_of and align_of on a two-field u64 structural record (Pair { lo: u64, hi: u64 }) establishes its exact layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: another target body. Each of four target bodies evaluates size_of and align_of and subtracts.
// Expected exit: 0

data Pair {
    lo: u64;
    hi: u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedComputeGeometry {
    machine compute_geometry() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86ComputeGeometry satisfies SelectedComputeGeometry {
    machine compute_geometry() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let size: u64 = size_of<Pair>();
        let align: u64 = align_of<Pair>();
        let diff: u64 = size - (align * 2u64);
        verify_geometry(size, align, diff);
        diff
    }
}

ArmComputeGeometry satisfies SelectedComputeGeometry {
    machine compute_geometry() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let size: u64 = size_of<Pair>();
        let align: u64 = align_of<Pair>();
        let diff: u64 = size - (align * 2u64);
        verify_geometry(size, align, diff);
        diff
    }
}

machine probe() -> u64 crashes Trap {
    SelectedComputeGeometry::compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// Runtime verification happens after exact arithmetic has formed; it cannot
// establish the static range obligation of the preceding subtraction.
machine verify_geometry(size: u64, align: u64, diff: u64) crashes Trap {
    transition size == 16u64 && align == 8u64 && diff == 0u64 {
        true -> {}
        _ -> bad()
    }
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
