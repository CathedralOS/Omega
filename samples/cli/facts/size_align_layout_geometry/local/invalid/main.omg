// Fact: querying size_of and align_of on a two-field u64 structural record (Pair { lo: u64, hi: u64 }) establishes its exact layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Invalid: Pair has a single field lo: u64 (size == 8u64, align == 8u64), so size - (align * 2u64) underflows u64.
// Expected exit: 0

data Pair {
    lo: u64;
}

machine main() crashes Trap {
    let s: u64 = size_of<Pair>();
    let a: u64 = align_of<Pair>();
    let local_size: u64 = s;
    let local_align: u64 = a;
    let diff: u64 = local_size - (local_align * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
