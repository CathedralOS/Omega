// Inline exact IEEE value 0.25 guarantee refines public inclusive f64 interval [0, 0.5]; the dyn call observes 0.25.
// Place: match_join.
// Expected exit: 0.
trait Fraction {
    machine get() -> f64 ensures result >= 0.0 && result <= 0.5;
}
Quarter satisfies Fraction {
    machine get() -> f64 ensures result >= 0.75 && result <= 0.75 { 0.75 }
}
OtherQuarter satisfies Fraction {
    machine get() -> f64 ensures result >= 0.25 && result <= 0.25 { 0.25 }
}
data Joined [copy] { selected: dyn Fraction; route: u64; }
machine probe(choice: bool) -> f64 {
    let joined: Joined = match choice {
        true -> Joined { selected: Quarter as dyn Fraction, route: 17 },
        false -> Joined { selected: OtherQuarter as dyn Fraction, route: 23 },
    };
    let selected: dyn Fraction = joined.selected;
    let observed: f64 = Fraction::get(selected);
    // Observe this invocation's chosen branch without widening its contract.
    transition (choice == true && joined.route == 17) || (choice == false && joined.route == 23) {
        true -> observed
        false -> 0.125
    }
}
machine main() crashes Trap {
    let first: f64 = probe(true);
    let second: f64 = probe(false);
    transition first == 0.25 && second == 0.25 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
