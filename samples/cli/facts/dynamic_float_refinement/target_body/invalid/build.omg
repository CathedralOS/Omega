machine build(builder: &mut Build) {
    Build::application(builder, "dynamic_float_refinement_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<FloatInvocation, SelectedFloatInvocation>(builder, windows_x86_64);
    Build::select_provider<FloatInvocation, SelectedFloatInvocation>(builder, linux_x86_64);
    Build::select_provider<FloatInvocation, SelectedFloatInvocation>(builder, macos_arm64);
    Build::select_provider<FloatInvocation, SelectedFloatInvocation>(builder, linux_arm64);
}
