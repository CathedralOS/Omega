// Inline exact IEEE value 0.25 guarantee refines public inclusive f64 interval [0, 0.5]; the dyn call observes 0.25.
// Place: call_result.
// Invalid: Quarter alone promises and returns 0.75 outside the public interval.
trait Fraction {
    machine get() -> f64 ensures result >= 0.0 && result <= 0.5;
}
Quarter satisfies Fraction {
    machine get() -> f64 ensures result >= 0.75 && result <= 0.75 { 0.75 }
}
machine choose() -> dyn Fraction { Quarter as dyn Fraction }
machine main() crashes Trap {
    let selected: dyn Fraction = choose();
    let observed: f64 = Fraction::get(selected);
    transition observed == 0.25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
