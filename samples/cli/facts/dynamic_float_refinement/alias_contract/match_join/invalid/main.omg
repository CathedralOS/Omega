// Inline exact IEEE value 0.25 guarantee refines public inclusive f64 interval [0, 0.5]; the dyn call preserves the public interval for a precondition and observes 0.25.
// Place: match_join.
// Invalid: Quarter alone promises and returns 0.75 outside the public interval.
public let public_interval(value: f64, lower: f64, upper: f64): core::Strict<0> = value >= lower && value <= upper;

trait Fraction {
    machine get() -> f64 ensures public_interval(result, 0.0, 0.5);
}
Quarter satisfies Fraction {
    machine get() -> f64 ensures result >= 0.75 && result <= 0.75 { 0.75 }
}
OtherQuarter satisfies Fraction {
    machine get() -> f64 ensures result >= 0.25 && result <= 0.25 { 0.25 }
}
machine probe(choice: bool) -> f64 ensures public_interval(result, 0.0, 0.5) {
    let selected: dyn Fraction = match choice {
        true -> Quarter as dyn Fraction,
        false -> OtherQuarter as dyn Fraction,
    };
    Fraction::get(selected)
}
machine accept(value: f64) requires public_interval(value, 0.0, 0.5) {}
machine main() crashes Trap {
    let first: f64 = probe(true);
    accept(first);
    let second: f64 = probe(false);
    accept(second);
    transition first == 0.25 && second == 0.25 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
