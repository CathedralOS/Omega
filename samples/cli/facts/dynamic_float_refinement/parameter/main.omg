// Inline exact IEEE value 0.25 guarantee refines public inclusive f64 interval [0, 0.5]; the dyn call observes 0.25.
// Place: parameter.
// Expected exit: 0.
trait Fraction {
    machine get() -> f64 ensures result >= 0.0 && result <= 0.5;
}
Quarter satisfies Fraction {
    machine get() -> f64 ensures result >= 0.25 && result <= 0.25 { 0.25 }
}
machine probe(selected: dyn Fraction) -> f64 { Fraction::get(selected) }
machine main() crashes Trap {
    let selected: dyn Fraction = Quarter as dyn Fraction;
    let observed: f64 = probe(selected);
    transition observed == 0.25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
