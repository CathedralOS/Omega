// The root-assumed input qualification value <= 1 indexes [7, 11] of length 2, observing 11; Supplied::get retains its own contract.
// Expected exit: 0.
data Index [copy] { value: u32; }
domain Index::Bounded(index) requires index.value <= 1;
boundary trait Required { machine get(index: Index) -> u32 reaches; }
boundary trait Supplied { machine get(index: Index) -> u32 reaches requires index in Bounded; }
Actual satisfies Supplied {
    machine get(index: Index) -> u32 requires index in Bounded {
        let values: [u32; 2] = [7, 11];
        values[index.value]
    }
}
machine pick(flag: bool) -> Index {
    match flag { true -> Index { value: 1 }, false -> Index { value: 1 } }
}
machine main() reaches Required crashes Trap {
    let first: u32 = Required::get(pick(true));
    let observed: u32 = Required::get(pick(false));
    transition first == 11 { true -> verify(observed) false -> bad() }
    state verify(observed: u32) {
    transition observed == 11 { true -> done() false -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}
