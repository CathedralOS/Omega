use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "discovery" };
    Build::select_provider::<Supplied, |app|::Actual>(builder, linux_arm64);
    Build::select_provider::<Supplied, |app|::Actual>(builder, linux_x86_64);
    Build::select_provider::<Supplied, |app|::Actual>(builder, macos_arm64);
    Build::select_provider::<Supplied, |app|::Actual>(builder, macos_x86_64);
    Build::select_provider::<Supplied, |app|::Actual>(builder, windows_x86_64);
    Build::select_provider::<Supplied, |app|::Actual>(builder, uefi_x86_64);
    Build::select_provider::<Supplied, |app|::Actual>(builder, cross_platform_cli);
    Build::select_provider::<Supplied, |app|::Actual>(builder, local_unchecked);
    Build::select_provider::<Supplied, |app|::Actual>(builder, alpha_bootstrap);
    Build::assume_binding_contract::<|app|::Required::get, Supplied::get>(builder);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::x86_entry);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedExercise, |app|::X86Exercise>(builder, macos_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedExercise, |app|::ArmExercise>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedExercise, |app|::X86Exercise>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedExercise, |app|::ArmExercise>(builder, linux_arm64);
    Build::select_provider::<|app|::SelectedBodyCheck, |app|::X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedExercise, |app|::X86Exercise>(builder, windows_x86_64);
}
