// The root-assumed input qualification value <= 1 indexes [7, 11] of length 2, observing 11; Supplied::get retains its own contract.
// Expected rejection: cannot prove index at the length-2 indexing operation.
data Index [copy] { value: u32; }
domain Index::Bounded requires self.value <= 2;
boundary trait Required { machine get(index: Index) -> u32 reaches; }
boundary trait Supplied { machine get(index: Index) -> u32 reaches requires index in Bounded; }
Actual satisfies Supplied {
    machine get(index: Index) -> u32 requires index in Bounded {
        let values: [u32; 2] = [7, 11];
        values[index.value]
    }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedExercise {
    machine exercise() -> u32 reaches Required reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap;
}
X86Exercise satisfies SelectedExercise {
    machine exercise() -> u32 reaches Required reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);     Required::get(Index { value: 1 })
    }
}
ArmExercise satisfies SelectedExercise {
    machine exercise() -> u32 reaches Required reaches SelectedBodyCheck invokes SelectedBodyCheck invokes Required crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);     Required::get(Index { value: 1 })
    }
}

machine main() reaches Required, SelectedBodyCheck crashes Trap {
    let observed: u32 = SelectedExercise::exercise();
    transition observed == 11 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
