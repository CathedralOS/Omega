// The root-assumed input qualification value <= 1 indexes [7, 11] of length 2, observing 11; Supplied::get retains its own contract.
// Expected rejection: a borrowed supplier parameter is a different passing mode.
data Index [copy] { value: u32; }
domain Index::Bounded(index) requires index.value <= 1;
boundary trait Required { machine get(index: Index) -> u32 reaches; }
boundary trait Supplied { machine get(index: &Index) -> u32 reaches requires index in Bounded; }
Actual satisfies Supplied {
    machine get(index: &Index) -> u32 requires index in Bounded { index.value }
}
machine main() reaches Required crashes Trap {
    let observed: u32 = Required::get(Index { value: 1 });
    transition observed == 1 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
