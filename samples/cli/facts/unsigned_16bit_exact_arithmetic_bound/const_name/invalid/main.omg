// Fact: adding two bounded 16-bit unsigned u16 values (lhs >= 100u16 && lhs <= 200u16 and rhs >= 150u16 && rhs <= 300u16) establishes the exact post-addition interval (sum >= 250u16 && sum <= 500u16), discharging both 500u16 - sum and sum - 250u16 across all nine places.
// Invalid: rhs upper bound widened to 301u16 so sum reaches 501u16, overflowing 500u16 - sum.
// Expected exit: 0

const LHS_VAL: u16 = 200u16;
const RHS_VAL: u16 = 301u16;

machine compute_const() -> u16 {
    let sum: u16 = LHS_VAL + RHS_VAL;
    let headroom: u16 = 500u16 - sum;
    let margin: u16 = sum - 250u16;
    headroom + margin
}

machine probe() -> u16 {
    compute_const()
}

machine main() crashes Trap {
    transition probe() == 250 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
