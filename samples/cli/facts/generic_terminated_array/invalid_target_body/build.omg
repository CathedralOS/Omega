use {omega}/language/core/external_binding.omg as foreign;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "generic_terminated_array" };
    Build::bind_native::<CText::length>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_strlen"
    } });
    Build::bind_native::<CText::length>(builder, linux_x86_64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.2.5"
    } });
    Build::bind_native::<CText::length>(builder, linux_arm64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.17"
    } });
    Build::bind_native::<CText::length>(builder, windows_x86_64, |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::PeByName {
        library: "msvcrt.dll", export: "strlen"
    } });
    Build::select_provider::<TargetText, WindowsText>(builder, windows_x86_64);
    Build::select_provider::<TargetText, LinuxX86Text>(builder, linux_x86_64);
    Build::select_provider::<TargetText, MacText>(builder, macos_arm64);
    Build::select_provider::<TargetText, LinuxArmText>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
