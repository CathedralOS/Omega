// Expected exit: 0.
// The checked seed-2 mov/sub/jz CFG takes its zero edge with eax == 0 and stores output == 0.
data Seed { value: u32; }
machine main() crashes Trap { countdown(true, Seed { value: 2 }, Seed { value: 2 }); countdown(false, Seed { value: 2 }, Seed { value: 2 }); }
machine countdown(branch: bool, left: Seed, right: Seed) requires left.value == 2 && right.value == 2 crashes Trap {
 let seed: u32 = match branch { true -> left.value, false -> right.value };
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jz done;
 repeat requires eax > 0:
  jmp loop;
 done requires eax == 0:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 state done() {}
 state bad() { crash Trap; }
}
