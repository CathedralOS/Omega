use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "fixed_layout_byte_roundtrip_target_body" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::arm_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::arm_entry);
    Build::select_provider::<|app|::SelectedDecode, |app|::X86Decode>(builder, windows_x86_64);
    Build::select_provider::<|app|::SelectedDecode, |app|::X86Decode>(builder, linux_x86_64);
    Build::select_provider::<|app|::SelectedDecode, |app|::ArmDecode>(builder, macos_arm64);
    Build::select_provider::<|app|::SelectedDecode, |app|::ArmDecode>(builder, linux_arm64);
}
