use omega::language::core::layout;
public data Auxiliary [copy] { value: u64; }
public AuxiliaryPolicy satisfies FixedLayout<Auxiliary> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
        Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 }
    }
}
public data Description { value: LayoutStorage<Auxiliary, AuxiliaryPolicy>; }
public machine extent() -> u64 { size_of<LayoutStorage<Auxiliary, AuxiliaryPolicy>>() }
