// A statement-position call of the generic boundary requirement `Mark::record<T>` from a generic
// caller applies the caller's open `T` to the requirement's formals, so the provider's write of
// `label` into `hits` is observed after the call.
// Place: match_join.
// Expected exit: 0
boundary trait Mark {
    machine record<T>(value: &T, label: u64, hits: &mut u64) reaches;
}

Counting satisfies Mark {
    machine record<T>(value: &T, label: u64, hits: &mut u64) { hits = label; }
}

machine notify<T>(left: &T, right: &T, pick: bool, hits: &mut u64) {
    let chosen: &T = match pick { true -> left, _ -> right };
    let label: u64 = match pick { true -> 9, _ -> 5 };
    Mark::record<T>(&label, label, hits);
}

machine main() crashes Trap {
    let left_i: i32 = 7;
    let right_i: i32 = 8;
    let left_b: u8 = 3;
    let right_b: u8 = 4;
    let mut first: u64 = 0;
    let mut second: u64 = 0;
    notify<i32>(&left_i, &right_i, true, &mut first);
    notify<u8>(&left_b, &right_b, false, &mut second);
    transition first == 9 && second == 5 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
