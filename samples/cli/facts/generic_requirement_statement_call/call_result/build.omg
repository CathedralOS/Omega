use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "generic_requirement_statement_call_call_result" };
    Build::select_provider::<|app|::Mark, |app|::Counting>(builder, linux_x86_64);
    Build::select_provider::<|app|::Mark, |app|::Counting>(builder, linux_arm64);
    Build::select_provider::<|app|::Mark, |app|::Counting>(builder, macos_arm64);
    Build::select_provider::<|app|::Mark, |app|::Counting>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
