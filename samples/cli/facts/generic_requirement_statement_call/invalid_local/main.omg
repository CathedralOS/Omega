// A statement-position call of the generic boundary requirement `Mark::record<T>` from a generic
// caller applies the caller's open `T` to the requirement's formals, so the provider's write of
// `label` into `hits` is observed after the call.
// Place: local.
// Expected exit: 0
boundary trait Mark {
    machine record<T>(value: @T, label: u64, hits: @mutable u64) reaches none crashes none;
}

Counting satisfies Mark {
    machine record<T>(value: @T, label: u64, hits: @mutable u64) { $hits = label; }
}

machine notify<T>(value: @T, label: u64, hits: @mutable u64) {
    let held: @T = value;
    Mark::record::<T>(@label, label, hits);
}

machine main() crashes Trap {
    let subject: i32 = 7;
    let other: u8 = 3;
    let mutable first: u64 = 0;
    let mutable second: u64 = 0;
    notify::<i32>(@subject, 9, @mutable first);
    notify::<u8>(@other, 5, @mutable second);
    transition first == 9 && second == 5 { true -> done(), false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
