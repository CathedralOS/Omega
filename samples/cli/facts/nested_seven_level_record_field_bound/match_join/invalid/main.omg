// Fact: a 7-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { l5: Level5 { l6: Level6 { val: u64 } } } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.l5.l6.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: match join (invalid twin). The leaf upper bound is widened to 81u64 so res reaches 81u64, underflowing 80u64 - res.
// Expected diagnostic: may overflow `u64`

data Level6 [copy] {
    val: u64;
}

data Level5 [copy] {
    l6: Level6;
}

data Level4 [copy] {
    l5: Level5;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

machine choose_root(first: RootRec, second: RootRec, flag: bool) -> RootRec
requires first.l1.l2.l3.l4.l5.l6.val >= 40 && first.l1.l2.l3.l4.l5.l6.val <= 81
    && second.l1.l2.l3.l4.l5.l6.val >= 40 && second.l1.l2.l3.l4.l5.l6.val <= 81
ensures result.l1.l2.l3.l4.l5.l6.val >= 40 && result.l1.l2.l3.l4.l5.l6.val <= 81
{
    match flag {
        true -> first
        false -> second
    }
}

machine probe(first: RootRec, second: RootRec, flag: bool) -> u64
requires first.l1.l2.l3.l4.l5.l6.val >= 40 && first.l1.l2.l3.l4.l5.l6.val <= 81
    && second.l1.l2.l3.l4.l5.l6.val >= 40 && second.l1.l2.l3.l4.l5.l6.val <= 81
{
    let root: RootRec = choose_root(first, second, flag);
    let res: u64 = root.l1.l2.l3.l4.l5.l6.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine main() crashes Trap {
    let r1: RootRec = RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        l5: Level5 {
                            l6: Level6 {
                                val: 60u64,
                            },
                        },
                    },
                },
            },
        },
    };
    let r2: RootRec = RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        l5: Level5 {
                            l6: Level6 {
                                val: 50u64,
                            },
                        },
                    },
                },
            },
        },
    };
    transition probe(r1, r2, true) == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}