// A match on one evaluation of a copyable flag returns the exclusive loan of the selected primitive, writes 41 through that loan, and leaves the unselected primitive unchanged.
// Place: field.
// Expected exit: 0
data Pair { left: i64; right: i64; }

machine choose(counter: @mutable u64) -> bool
requires $counter == 0
{
    $counter = 1;
    true
}

machine main() crashes Trap {
    let mutable pair: Pair = Pair { left: 17, right: 0 };
    let mutable visits: u64 = 0;
    let selected: @mutable i64 = match choose(@mutable visits) {
        true -> @mutable pair.left,
        false -> @mutable pair.right
    };
    $selected = 41;
    let observed: i64 = $selected;
    transition observed == 41 && pair.left == 41 && pair.right == 0 && visits == 1 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
