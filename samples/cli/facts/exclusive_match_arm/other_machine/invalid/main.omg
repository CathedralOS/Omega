// A match on one evaluation of a copyable flag returns the exclusive loan of the selected primitive, writes 41 through that loan, and leaves the unselected primitive unchanged.
// Place: other_machine. Reject twin: the source is used while that loan is live.
machine choose(counter: &mut u64) -> bool
requires counter == 0
{
    counter = 1;
    true
}

machine apply(chosen: &mut i64, other: &mut i64, visits: &mut u64) -> i64 {
    let selected: &mut i64 = match choose(visits) {
        true -> chosen
        false -> other
    };
    chosen = 7;
    selected = 41;
    selected
}

machine forward(chosen: &mut i64, other: &mut i64, visits: &mut u64) -> i64 {
    apply(chosen, other, visits)
}

machine main() crashes Trap {
    let mut chosen: i64 = 17;
    let mut other: i64 = 0;
    let mut visits: u64 = 0;
    let observed: i64 = forward(&mut chosen, &mut other, &mut visits);
    transition observed == 41 && chosen == 41 && other == 0 && visits == 1 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
