// A match on one evaluation of a copyable flag returns the exclusive loan of the selected primitive, writes 41 through that loan, and leaves the unselected primitive unchanged.
// Place: call_result. Reject twin: the source is used while that loan is live.
machine choose(counter: @mutable u64) -> bool
requires $counter == 0
{
    $counter = 1;
    true
}

machine select<'a>(chosen: @'a mutable i64, other: @'a mutable i64, visits: @mutable u64) -> @'a mutable i64 {
    match choose(visits) {
        true -> chosen,
        false -> other
    }
}

machine main() crashes Trap {
    let mutable chosen: i64 = 17;
    let mutable other: i64 = 0;
    let mutable visits: u64 = 0;
    let selected: @mutable i64 = select(@mutable chosen, @mutable other, @mutable visits);
    chosen = 7;
    $selected = 41;
    let observed: i64 = $selected;
    transition observed == 41 && chosen == 41 && other == 0 && visits == 1 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
