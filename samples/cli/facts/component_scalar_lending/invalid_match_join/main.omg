// Fact: A suspended independent component writes 73 to the caller's original scalar-backed record, preserving neighbor cells and storage addresses.
// Place: match_join.
// Expected exit: 0
use producer::Lending;
use producer::Observation;
use producer::Reading;
use producer::Token;
use producer::Word;
machine choose(token: &Token, first_selected: bool) -> u64 reaches Lending Reading Observation suspends crashes Trap {
    let mut first: Word = Word { before: 11, count: 0, after: 29 };
    let mut second: Word = Word { before: 11, count: 1, after: 29 };
    let selected: &mut Word = match first_selected { true -> &mut first, _ -> &mut second };
    let original: addr = address_of(selected);
    let member: addr = address_of(&selected.count);
    let reported: u64 = suspend Lending::write(&selected, token, original, member);
    let reused: u64 = suspend Reading::read(&selected, &selected, token, token, original, member);
    Observation::seen(token);
    let addresses: bool = address_of(selected) == original && address_of(&selected.count) == member;
    let observed: u64 = selected.count;
    let correct: bool = match first_selected { true -> first.count == 73 && second.count == 1, _ -> second.count == 73 && first.count == 0 };
    transition reused == 73 && addresses && correct && first.before == 11 && first.after == 29 && second.before == 11 && second.after == 29 {
        true -> observed
        _ -> bad()
    }
    machine bad() -> u64 { crash Trap; }
}
machine entry(token: Token) -> u64 reaches Lending Reading Observation suspends crashes Trap {
    let first: u64 = suspend choose(&token, true);
    let second: u64 = suspend choose(&token, false);
    transition first == 73 && second == 73 { true -> first _ -> bad() }
    machine bad() -> u64 { crash Trap; }
}
machine main() reaches Lending Reading Observation suspends crashes Trap {
    let result: u64 = suspend entry(Token {});
    transition result == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
