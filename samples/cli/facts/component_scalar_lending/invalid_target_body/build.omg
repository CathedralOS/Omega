machine build(builder: &mut Build) {
    Build::application(builder, "component_scalar_lending_target_body");
    let mut producer_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../../support/fact_dependencies/scalar_lending_producer" });
    dependency::with_alias(&mut producer_dependency, "producer");
    let producer_registration: DependencyRegistration = Build::dependency(builder, producer_dependency);
    Build::select_provider<producer::Lending, producer::Writer>(builder, linux_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, linux_x86_64);
    Build::select_provider<Selected, SelectedBody>(builder, linux_x86_64);
    Build::select_provider<producer::Reading, producer::Reader>(builder, linux_x86_64, CompositionMode::Independent);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<producer::Lending, producer::Writer>(builder, windows_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, windows_x86_64);
    Build::select_provider<Selected, SelectedBody>(builder, windows_x86_64);
    Build::select_provider<producer::Reading, producer::Reader>(builder, windows_x86_64, CompositionMode::Independent);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<producer::Lending, producer::Writer>(builder, macos_arm64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, macos_arm64);
    Build::select_provider<Selected, SelectedBody>(builder, macos_arm64);
    Build::select_provider<producer::Reading, producer::Reader>(builder, macos_arm64, CompositionMode::Independent);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<producer::Lending, producer::Writer>(builder, linux_arm64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, linux_arm64);
    Build::select_provider<Selected, SelectedBody>(builder, linux_arm64);
    Build::select_provider<producer::Reading, producer::Reader>(builder, linux_arm64, CompositionMode::Independent);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
