// Fact: A suspended independent component writes 73 to the caller's original scalar-backed record, preserving neighbor cells and storage addresses.
// Place: field.
// Expected exit: 0
use {producer}/main.omg as producer;
data Holder { left: u64; value: |producer|::Word; right: u64; }
machine entry(token: |producer|::Token) -> u64 reaches |producer|::Lending |producer|::Reading |producer|::Observation suspends crashes Trap {
    let mutable holder: Holder = Holder { left: 101, value: |producer|::Word { before: 11, count: 0, after: 29 }, right: 303 };
    let original: address = address_of(@holder.value);
    let member: address = address_of(@holder.value.count);
    let reported: u64 = suspend |producer|::Lending::write(@mutable holder.value, @token, original, member);
    let reused: u64 = suspend |producer|::Reading::read(@holder.value, @holder.value, @token, @token, original, member);
    |producer|::Observation::seen(@token);
    transition reused == 73 && holder.value.before == 11 && holder.value.after == 29 && address_of(@holder.value) == original && address_of(@holder.value.count) == member && holder.left == 101 && holder.right == 303 {
        true -> holder.value.count,
        _ -> bad()
    }
    machine bad() -> u64 { crash Trap; }
}
machine main() reaches |producer|::Lending |producer|::Reading |producer|::Observation suspends crashes Trap {
    let result: u64 = suspend entry(|producer|::Token {});
    transition result == 73 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
