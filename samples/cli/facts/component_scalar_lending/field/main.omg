// Fact: A suspended independent component writes 73 to the caller's original scalar-backed record, preserving neighbor cells and storage addresses.
// Place: field.
// Expected exit: 0
use producer::Lending;
use producer::Observation;
use producer::Reading;
use producer::Token;
use producer::Word;
data Holder { left: u64; value: Word; right: u64; }
machine entry(token: Token) -> u64 reaches Lending Reading Observation suspends crashes Trap {
    let mut holder: Holder = Holder { left: 101, value: Word { before: 11, count: 0, after: 29 }, right: 303 };
    let original: addr = address_of(&holder.value);
    let member: addr = address_of(&holder.value.count);
    let reported: u64 = suspend Lending::write(&mut holder.value, &token, original, member);
    let reused: u64 = suspend Reading::read(&holder.value, &holder.value, &token, &token, original, member);
    Observation::seen(&token);
    transition reused == 73 && holder.value.before == 11 && holder.value.after == 29 && address_of(&holder.value) == original && address_of(&holder.value.count) == member && holder.left == 101 && holder.right == 303 {
        true -> holder.value.count
        _ -> bad()
    }
    machine bad() -> u64 { crash Trap; }
}
machine main() reaches Lending Reading Observation suspends crashes Trap {
    let result: u64 = suspend entry(Token {});
    transition result == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
