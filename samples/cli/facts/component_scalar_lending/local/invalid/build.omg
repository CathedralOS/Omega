machine build(builder: &mut Build) {
    Build::application(builder, "component_scalar_lending_local");
    Build::depend_as(builder, "producer", Source::Path { location: "producer" });
    Build::select_provider<producer::Lending, producer::Writer>(builder, linux_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<producer::Lending, producer::Writer>(builder, windows_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<producer::Lending, producer::Writer>(builder, macos_arm64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<producer::Lending, producer::Writer>(builder, linux_arm64, CompositionMode::Independent);
    Build::select_provider<producer::Observation, producer::NoObservation>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
