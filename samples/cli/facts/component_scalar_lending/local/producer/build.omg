machine build(builder: &mut Build) {
    Build::package(builder, "component_scalar_lending_producer");
    Build::select_provider<Lending, Writer>(builder, linux_x86_64);
    Build::select_provider<Observation, NoObservation>(builder, linux_x86_64);
    Build::select_provider<Reading, Reader>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, component_entry);
    Build::select_provider<Lending, Writer>(builder, windows_x86_64);
    Build::select_provider<Observation, NoObservation>(builder, windows_x86_64);
    Build::select_provider<Reading, Reader>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, component_entry);
    Build::select_provider<Lending, Writer>(builder, macos_arm64);
    Build::select_provider<Observation, NoObservation>(builder, macos_arm64);
    Build::select_provider<Reading, Reader>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, component_entry);
    Build::select_provider<Lending, Writer>(builder, linux_arm64);
    Build::select_provider<Observation, NoObservation>(builder, linux_arm64);
    Build::select_provider<Reading, Reader>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, component_entry);
}
