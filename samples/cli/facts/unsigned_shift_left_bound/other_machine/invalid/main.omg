// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Invalid: operand is bounded to 24u64, so 24 << 2 is 96, underflowing subtraction by 100u64. Place: another machine.
// Expected exit: 0

machine perform_shift(val: u64, shift: u32) -> u64
requires val >= 24 && val <= 24 && shift == 2
{
    let shifted: u64 = val << shift;
    shifted - 100u64
}

machine forward(val: u64, shift: u32) -> u64
requires val >= 24 && val <= 24 && shift == 2
{
    perform_shift(val, shift)
}

machine probe() -> u64 {
    forward(24u64, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
