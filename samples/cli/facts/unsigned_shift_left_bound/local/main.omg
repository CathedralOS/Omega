// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Place: local. The operand and shift count are copied into locals before left shift and subtraction.
// Expected exit: 0

machine shift_local(val: u64, shift: u32) -> u64
requires val >= 25 && val <= 25 && shift == 2
{
    let local_val: u64 = val;
    let local_shift: u32 = shift;
    let shifted: u64 = local_val << local_shift;
    shifted - 100u64
}

machine probe() -> u64 {
    shift_local(25u64, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
