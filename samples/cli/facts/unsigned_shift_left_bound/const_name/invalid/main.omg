// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Invalid: named constant is 24u64, so 24 << 2 is 96, underflowing subtraction by 100u64. Place: const name.
// Expected exit: 0

const VAL: u64 = 24u64;

machine shift_const(shift: u32) -> u64
requires shift == 2
{
    let shifted: u64 = VAL << shift;
    shifted - 100u64
}

machine probe() -> u64 {
    shift_const(2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
