// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Place: call result. A contracted helper call returns the bounded operand before left shift and subtraction.
// Expected exit: 0

machine get_val() -> u64
ensures result >= 25 && result <= 25
{
    25u64
}

machine shift_call_result(shift: u32) -> u64
requires shift == 2
{
    let val: u64 = get_val();
    let shifted: u64 = val << shift;
    shifted - 100u64
}

machine probe() -> u64 {
    shift_call_result(2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
