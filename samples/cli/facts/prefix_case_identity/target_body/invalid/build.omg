machine build(builder: &mut Build) {
    Build::application(builder, "prefix_case_identity_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, SelectedEntry::start);
    Build::bind(builder, linux_arm64::ProgramEntry, SelectedEntry::start);
    Build::bind(builder, macos_arm64::ProgramEntry, SelectedEntry::start);
    Build::bind(builder, windows_x86_64::ProgramEntry, SelectedEntry::start);
}
