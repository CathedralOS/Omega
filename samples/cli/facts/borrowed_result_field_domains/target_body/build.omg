use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    Build::select_provider::<|app|::Probe, |app|::Selected>(builder, windows_x86_64);
    Build::select_provider::<|app|::Probe, |app|::Selected>(builder, linux_x86_64);
    Build::select_provider::<|app|::Probe, |app|::Selected>(builder, linux_arm64);
    Build::select_provider::<|app|::Probe, |app|::Selected>(builder, macos_arm64);
    builder.product = BuildProduct::Application { name: "borrowed_field_target_body" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
