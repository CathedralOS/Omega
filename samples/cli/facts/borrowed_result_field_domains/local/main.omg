// Borrowed results retain their checked field domains and selected element, so inspection reads that element.
// Expected exit: 0
public domain [u8; 4]::Ascii requires ascii_only(self);
public data Cell [copy] { storage: [u8; 4] in Ascii; }
public data Table [copy] { cells: [Cell; 2]; }
public machine choose(table: @mutable Table, index: u64) -> @mutable Cell
requires index < 2 {
    let cells: @mutable [Cell] = @mutable table.cells[..];
    @mutable cells[index]
}
public machine relay(table: @mutable Table, index: u64) -> @mutable Cell
requires index < 2 { choose(table, index) }
machine inspect(cell: @Cell) -> u8 { cell.storage[0] }
machine observe(table: @mutable Table, index: u64) -> u8
requires index < 2 {
    let selected: @mutable Cell = relay(table, index);
    inspect(selected)
}
machine main() crashes Trap {
    let mutable table: Table = Table { cells: [Cell { storage: [65u8, 0u8, 0u8, 0u8] as +Ascii }, Cell { storage: [66u8, 0u8, 0u8, 0u8] as +Ascii }] };
    let first: u8 = observe(@mutable table, 0);
    let second: u8 = observe(@mutable table, 1);
    transition first == 65 && second == 66
        && table.cells[0].storage[0] == 65 && table.cells[1].storage[0] == 66 {
        true -> {}, false -> bad()
    }
    machine bad() crashes Trap { crash Trap; }
}
