// An independent completed call guarantees value == 7, so exact value - 7 is safe.
// Expected exit: 0
boundary trait SelectedSource {
    machine source(input: u64) -> u64 reaches
ensures result == 7;
}
CheckedSource satisfies SelectedSource {
    machine source(input: u64) -> u64 ensures result == 7
{
    7
}
}



reserved_target machine source(input: u64) -> u64 ensures result == 7 {
    7
}
machine forwarded(input: u64) -> u64 ensures result == 7 { SelectedSource::source(input) }
machine choose(flag: bool) -> u64 ensures result == 0 {
    let value: u64 = match flag { true -> forwarded(3), false -> forwarded(6) };
    value - 7
}
machine evaluate() -> u64 { choose(true) + choose(false) }
machine main() crashes Trap {
    let difference: u64 = evaluate();
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
