machine build(builder: &mut Build) {
    Build::select_provider<SelectedSource, CheckedSource>(builder, windows_x86_64);
    Build::select_provider<SelectedSource, CheckedSource>(builder, linux_x86_64);
    Build::select_provider<SelectedSource, CheckedSource>(builder, macos_arm64);
    Build::select_provider<SelectedSource, CheckedSource>(builder, linux_arm64);

    Build::application(builder, "independent_call_result_bound");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
