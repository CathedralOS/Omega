// An independent completed call guarantees value == 7, so exact value - 7 is safe.
// Expected exit: 0
trait IndependentSource {
    machine source(input: u64) -> u64 ensures result == 7u64;
}
GoodSource satisfies IndependentSource {
    machine source(input: u64) -> u64 ensures result == 7u64 { 7u64 }
}
ReservedSource satisfies IndependentSource {
    machine source(input: u64) -> u64 ensures result == 7u64 {
        forwarded<GoodSource>(input)
    }
}
machine forwarded<S satisfies IndependentSource>(input: u64) -> u64 ensures result == 7 { S::source(input) }
boundary trait Evaluation {
    machine evaluate() -> u64 reaches;
}
WindowsEvaluation satisfies Evaluation {
    machine evaluate() -> u64 reaches { forwarded<GoodSource>(3) - 7 }
}
LinuxEvaluation satisfies Evaluation {
    machine evaluate() -> u64 reaches { forwarded<GoodSource>(3) - 7 }
}
MacosEvaluation satisfies Evaluation {
    machine evaluate() -> u64 reaches { forwarded<GoodSource>(3) - 7 }
}
LinuxArmEvaluation satisfies Evaluation {
    machine evaluate() -> u64 reaches { forwarded<GoodSource>(3) - 7 }
}
machine main() crashes Trap {
    let difference: u64 = Evaluation::evaluate();
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
