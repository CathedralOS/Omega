use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "independent_call_result_bound" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::IndependentSource, |app|::WindowsSource>(builder, windows_x86_64);
    Build::select_provider::<|app|::IndependentSource, |app|::LinuxSource>(builder, linux_x86_64);
    Build::select_provider::<|app|::IndependentSource, |app|::MacosSource>(builder, macos_arm64);
    Build::select_provider::<|app|::IndependentSource, |app|::LinuxArmSource>(builder, linux_arm64);
}
