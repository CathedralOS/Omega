// Expected exit: 0
// Selected<Configuration { minimum: Base + 4 }> at Base = 3 supplies at least seven before exact value - 7.
data Configuration [copy] { minimum: u64; }
trait Reading<const Required: Configuration> {
    machine read() -> u64 ensures result >= Required.minimum;
}
Selected<const Setting: Configuration> satisfies Reading<Setting> {
    machine read() -> u64 ensures result == Setting.minimum { Setting.minimum }
}
machine selected<const Required: Configuration, Implementation satisfies Reading<Required>>() -> u64
ensures result >= Required.minimum
{ Implementation::read() }
machine configuration() -> Configuration
ensures result.minimum == 7
{ Configuration { minimum: 3 + 4 } }
machine construct<const Base: u64>() -> u64
requires Base <= 100
ensures result >= Base + 4
{
    selected<(Configuration { minimum: Base + 4 }), Selected<(Configuration { minimum: Base + 4 })>>()
}
data Joined { value: u64; tag: u64; }
machine choose(left: bool) -> Joined
ensures result.value >= 7
{ match left {
    true -> Joined { value: selected<(configuration()), Selected<(Configuration { minimum: 3 + 3 })>>(), tag: 17 }
    false -> Joined { value: selected<(configuration()), Selected<(Configuration { minimum: 3 + 3 })>>(), tag: 29 }
} }
machine main() crashes Trap {
    let first: Joined = choose(true);
    let first_difference: u64 = first.value - 7;
    let second: Joined = choose(false);
    let second_difference: u64 = second.value - 7;
    transition first_difference == 0 && second_difference == 0 && first.tag == 17 && second.tag == 29 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
