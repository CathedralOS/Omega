// Expected exit: 0
// Selected<Configuration { minimum: Base + 4 }> at Base = 3 supplies at least seven before exact value - 7.
data Configuration [copy] { minimum: u64; }
trait Reading<const Required: Configuration> {
    machine read() -> u64 ensures result >= Required.minimum;
}
Selected<const Setting: Configuration> satisfies Reading<Setting> {
    machine read() -> u64 ensures result == Setting.minimum { Setting.minimum }
}
machine selected<const Required: Configuration, Implementation satisfies Reading<Required>>() -> u64
ensures result >= Required.minimum
{ Implementation::read() }
machine construct<const Base: u64>() -> u64
requires Base <= 100
ensures result >= Base + 4
{
    selected<(Configuration { minimum: Base + 4 }), Selected<(Configuration { minimum: Base + 3 })>>()
}
machine choose(left: bool) -> u64
ensures result >= 7
{ match left { true -> construct<3>(), false -> construct<3>() } }
machine main() crashes Trap {
    let value: u64 = choose(true);
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
