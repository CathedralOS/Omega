// Fact: a static index bound idx < 8u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 8].
// Place: other_state. A transition to a successor state forwards the bounded index and array.
// Expected exit: 0
machine read_element(values: [u64; 8], index: u64) -> u64
requires index < 8
{
    transition { _ -> element(values, index) }
    machine element(passed_values: [u64; 8], passed_index: u64) -> u64
    requires passed_index < 8
    {
        passed_values[passed_index]
    }
}

machine main() crashes Trap {
    let arr: [u64; 8] = [10, 20, 30, 40, 50, 60, 70, 80];
    let elem: u64 = read_element(arr, 5);
    transition elem == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
