// Fact: a static index bound idx < 8u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 8].
// Place: field. A record field carries the bounded index alongside the fixed-extent array.
// Expected exit: 0
data Container where index <= 8 {
    values: [u64; 8];
    index: u64;
}

machine read_element(container: Container) -> u64 {
    container.values[container.index]
}

machine main() crashes Trap {
    let container: Container = Container { values: [10, 20, 30, 40, 50, 60, 70, 80], index: 5 };
    let elem: u64 = read_element(container);
    transition elem == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
