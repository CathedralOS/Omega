// Fact: a static index bound idx < 8u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 8].
// Place: match_join. Both branches of a match expression produce in-bounds indices.
// Expected exit: 0
machine read_element(values: [u64; 8], index: u64, flag: bool) -> u64
requires index <= 8
{
    let joined_index: u64 = match flag { true -> index, false -> 0 };
    values[joined_index]
}

machine main() crashes Trap {
    let arr: [u64; 8] = [10, 20, 30, 40, 50, 60, 70, 80];
    let elem: u64 = read_element(arr, 5, true);
    transition elem == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
