// Fact: a static index bound idx < 8u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 8].
// Place: target_body. Each of four target bodies reads the array element using the bounded index.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReadElement {
    machine read_element(values: [u64; 8], index: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 8;
}

X86ReadElement satisfies SelectedReadElement {
    machine read_element(values: [u64; 8], index: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 8
    {
        SelectedBodyCheck::require_tag(17u64);
        values[index]
    }
}

ArmReadElement satisfies SelectedReadElement {
    machine read_element(values: [u64; 8], index: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires index < 8
    {
        SelectedBodyCheck::require_tag(29u64);
        values[index]
    }
}


machine probe(values: [u64; 8], index: u64) -> u64
requires index < 8
{
    SelectedReadElement::read_element(values, index)
}

machine main() crashes Trap {
    let arr: [u64; 8] = [10, 20, 30, 40, 50, 60, 70, 80];
    let elem: u64 = probe(arr, 5);
    transition elem == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
