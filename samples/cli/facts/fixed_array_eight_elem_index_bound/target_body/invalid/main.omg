// Fact: a static index bound idx < 8u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 8].
// Place: target_body. Each of four target bodies reads the array element using the bounded index.
// Expected exit: 0
linux_x86_64 machine read_element(values: [u64; 8], index: u64) -> u64
requires index <= 8
{
    values[index]
}

linux_arm64 machine read_element(values: [u64; 8], index: u64) -> u64
requires index <= 8
{
    values[index]
}

macos_arm64 machine read_element(values: [u64; 8], index: u64) -> u64
requires index <= 8
{
    values[index]
}

windows_x86_64 machine read_element(values: [u64; 8], index: u64) -> u64
requires index <= 8
{
    values[index]
}

machine probe(values: [u64; 8], index: u64) -> u64
requires index <= 8
{
    read_element(values, index)
}

machine main() crashes Trap {
    let arr: [u64; 8] = [10, 20, 30, 40, 50, 60, 70, 80];
    let elem: u64 = probe(arr, 5);
    transition elem == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
