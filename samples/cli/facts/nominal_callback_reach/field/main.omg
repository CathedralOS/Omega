// A nominal Step callback selection contributes its specialized reach row;
// its result is stored in a record field and read back.
// Place: field.
// Expected exit: 0
trait StepContract {
    machine step(value: u64) -> u64;
}

machine bump(value: u64) -> u64
satisfies StepContract::step
{
    42
}

machine walk<machine Step>(value: u64) -> u64
where machine Step satisfies StepContract::step;
{
    Step(value)
}

data Meter {
    observed: u64;
}

machine main() crashes Trap {
    let meter: Meter = Meter { observed: walk<bump>(35) };
    transition meter.observed == 42u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
