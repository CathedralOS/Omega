// Invalid: `noise` has no `satisfies StepContract::step`, so the selection
// cannot establish the binder contract. A nominal Step callback selection contributes its specialized reach row;
// its result names a const that bounds a runtime check.
// Place: const name.
// Expected exit: 0
trait StepContract {
    machine step(value: u64) -> u64;
}

machine noise(value: u64) -> u64
{
    7
}

machine bump(value: u64) -> u64
satisfies StepContract::step
{
    42
}

machine walk<machine Step>(value: u64) -> u64
where machine Step satisfies StepContract::step;
{
    Step(value)
}

machine measured() -> u64 {
    walk<noise>(7)
}

data Reading {
    bytes: [u8; measured()];
}

machine main() crashes Trap {
    transition Reading::SIZE == 42u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
