// Choosing one of two mutable inputs through a computed receiver and writing through that result preserves the disjoint index-bound fact on the other input.
// Expected exit: 0
// Place: parameter.

public data Cell { held: u64; }

public data CellPlacement {}

machine CellPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries,
            entry_count: 1,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 8,
        };
    let mut services: [u64; 32];
    services[0] = 7;
    AccessPlan::with_reach(
        AccessPlan::with(
            AccessPlan::inaccessible(layout),
            schema.fields[0].key,
            FieldAccess::External {
                read: ExternalRead::Read,
                write: true,
                exposure: Exposure::Exported,
            },
        ),
        BoundaryReach {
            services: services,
            service_count: 0,
        }
    )
}

machine choose<'storage>(
    chosen: &'storage mut Access<CellPlacement, Cell>,
    other: &'storage mut Access<CellPlacement, Cell>,
    pick_chosen: bool
) -> &'storage mut Access<CellPlacement, Cell> {
    transition pick_chosen {
        true -> chosen
        _ -> other
    }
}

machine probe(chosen: &mut Cell, other: &mut Cell, items: &[u8; 4]) -> u8
requires chosen.held < 4 && other.held < 4
{
    let chosen_view: &mut Access<CellPlacement, Cell> = Access::view_mut<CellPlacement, Cell>(chosen);
    let other_view: &mut Access<CellPlacement, Cell> = Access::view_mut<CellPlacement, Cell>(other);
    let selected: &mut Access<CellPlacement, Cell> = choose(chosen_view, other_view, false);
    selected.held.write(&mut selected.held, 9);
    let index: u64 = other.held;
    transition items[index] == 7 {
        true -> (items[index])
        _ -> 0
    }
}

machine main() crashes Trap {
    let mut chosen: Cell = Cell { held: 0 };
    let mut other: Cell = Cell { held: 1 };
    let items: [u8; 4] = [4, 7, 8, 9];
    let found: u8 = probe(&mut chosen, &mut other, &items);
    transition found == 7 && chosen.held == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
