machine main() crashes Trap {
    let mut chosen: Cell = Cell { held: 0 };
    let mut other: Cell = Cell { held: 1 };
    let items: [u8; 4] = [4, 7, 8, 9];
    let found: u8 = probe(&mut chosen, &mut other, &items);
    transition found == 7 && chosen.held == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
