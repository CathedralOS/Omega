// Choosing one of two mutable inputs through a computed receiver and writing through that result preserves the disjoint index-bound fact on the other input.
// Expected exit: 0
// Place: target_body.

public data Cell { held: u64; }

public data CellPlacement {}

machine CellPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let mut services: [u64; 32];
    services[0] = 7;
    PlacementPlan {
        layout: Plan {
            entries: entries,
            entry_count: 1,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 8,
        },
        access: AccessPlan::with(
            AccessPlan::inaccessible(&schema),
            schema.fields[0].key,
            FieldAccess::External {
                read: ExternalRead::Read,
                write: true,
                exposure: Exposure::Exported,
            },
        ),
        reach: BoundaryReach {
            services: services,
            service_count: 0,
        },
    }
}

machine choose<'storage>(
    chosen: &'storage mut Placed<CellPlacement, Cell>,
    other: &'storage mut Placed<CellPlacement, Cell>,
    pick_chosen: bool
) -> &'storage mut Placed<CellPlacement, Cell> {
    transition pick_chosen {
        true -> chosen
        _ -> other
    }
}

linux_x86_64 machine probe(chosen: &mut Cell, other: &mut Cell, items: &[u8; 4]) -> u8
requires chosen.held < 4 && other.held < 4
{
    let chosen_view: &mut Placed<CellPlacement, Cell> = Placed::view_mut<CellPlacement, Cell>(chosen);
    let other_view: &mut Placed<CellPlacement, Cell> = Placed::view_mut<CellPlacement, Cell>(other);
    let selected: &mut Placed<CellPlacement, Cell> = choose(chosen_view, other_view, true);
    selected.held.write(&mut selected.held, 9);
    let index: u64 = other.held;
    transition items[index] == 7 {
        true -> (items[index])
        _ -> 0
    }
}

linux_arm64 machine probe(chosen: &mut Cell, other: &mut Cell, items: &[u8; 4]) -> u8
requires chosen.held < 4 && other.held < 4
{
    let chosen_view: &mut Placed<CellPlacement, Cell> = Placed::view_mut<CellPlacement, Cell>(chosen);
