// Choosing one of two mutable inputs through a computed receiver and writing through that result preserves the disjoint index-bound fact on the other input.
// Expected exit: 0
// Place: target_body.

public data Cell { held: u64; }

public data CellPlacement {}

machine CellPlacement::plan(schema: Schema) -> AccessPlan {
    let mutable entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries,
            entry_count: 1,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 8,
        };
    let mutable services: [u64; 32];
    services[0] = 7;
    AccessPlan::with_reach(
        AccessPlan::with(
            AccessPlan::inaccessible(layout),
            schema.fields[0].key,
            FieldAccess::External {
                read: ExternalRead::Read,
                write: true,
                exposure: Exposure::Exported,
            },
        ),
        BoundaryReach {
            services: services,
            service_count: 0,
        }
    )
}

machine choose<'storage>(
    chosen: @'storage mutable Access<CellPlacement, Cell>,
    other: @'storage mutable Access<CellPlacement, Cell>,
    pick_chosen: bool
) -> @'storage mutable Access<CellPlacement, Cell> {
    transition pick_chosen {
        true -> chosen,
        _ -> other
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches none crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done(), false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(chosen: @mutable Cell, other: @mutable Cell, items: @[u8; 4]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires chosen.held < 4 && other.held < 4;
}

X86Probe satisfies SelectedProbe {
    machine probe(chosen: @mutable Cell, other: @mutable Cell, items: @[u8; 4]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires chosen.held < 4 && other.held < 4
    {
        SelectedBodyCheck::require_tag(17u64);
        let chosen_view: @mutable Access<CellPlacement, Cell> = Access::view_mut::<CellPlacement, Cell>(chosen);
        let other_view: @mutable Access<CellPlacement, Cell> = Access::view_mut::<CellPlacement, Cell>(other);
        let selected: @mutable Access<CellPlacement, Cell> = choose(chosen_view, other_view, true);
        selected.held.write(@mutable selected.held, 9);
        let index: u64 = other.held;
        transition items[index] == 7 {
            true -> (items[index]),
            _ -> 0
        }
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(chosen: @mutable Cell, other: @mutable Cell, items: @[u8; 4]) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires chosen.held < 4 && other.held < 4
    {
        SelectedBodyCheck::require_tag(29u64);
        let chosen_view: @mutable Access<CellPlacement, Cell> = Access::view_mut::<CellPlacement, Cell>(chosen);
        let other_view: @mutable Access<CellPlacement, Cell> = Access::view_mut::<CellPlacement, Cell>(other);
        let selected: @mutable Access<CellPlacement, Cell> = choose(chosen_view, other_view, true);
        selected.held.write(@mutable selected.held, 9);
        let index: u64 = other.held;
        transition items[index] == 7 {
            true -> (items[index]),
            _ -> 0
        }
    }
}

machine main() crashes Trap {
    let mutable chosen: Cell = Cell { held: 0 };
    let mutable other: Cell = Cell { held: 1 };
    let items: [u8; 4] = [4, 7, 8, 9];
    let found: u8 = SelectedProbe::probe(@mutable chosen, @mutable other, @items);
    transition found == 7 && chosen.held == 9 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
