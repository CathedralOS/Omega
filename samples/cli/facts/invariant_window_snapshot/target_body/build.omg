use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invariant_window_snapshot" };
    Build::select_provider::<|app|::SnapshotConsumer, |app|::SelectedSnapshot>(builder, windows_x86_64);
    Build::select_provider::<|app|::SnapshotConsumer, |app|::SelectedSnapshot>(builder, linux_x86_64);
    Build::select_provider::<|app|::SnapshotConsumer, |app|::SelectedSnapshot>(builder, macos_arm64);
    Build::select_provider::<|app|::SnapshotConsumer, |app|::SelectedSnapshot>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
