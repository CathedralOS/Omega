machine build(builder: &mut Build) {
    Build::application(builder, "invariant_window_snapshot");
    Build::select_provider<SnapshotConsumer, SelectedSnapshot>(builder, windows_x86_64);
    Build::select_provider<SnapshotConsumer, SelectedSnapshot>(builder, linux_x86_64);
    Build::select_provider<SnapshotConsumer, SelectedSnapshot>(builder, macos_arm64);
    Build::select_provider<SnapshotConsumer, SelectedSnapshot>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
