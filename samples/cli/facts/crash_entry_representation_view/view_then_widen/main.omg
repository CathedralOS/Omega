// Expected exit: 0
machine maybe_zero(value: i64) -> i64
crashes Trap value == 0
{
    transition value == 0 { true -> bad() false -> (value) }
    machine bad() -> i64 { crash Trap; }
}
public machine read_bits(value: u32) -> i64
requires value == 4294967295
{
    let view: &i32 = &value as &i32;
    let viewed: i32 = view;
    let observed: i64 = viewed as i64;
    maybe_zero(observed)
}
machine main() crashes Trap {
    let observed: i64 = read_bits(4294967295);
    transition observed == -1 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
