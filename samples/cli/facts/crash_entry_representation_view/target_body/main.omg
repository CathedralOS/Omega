// Fact: a checked equal-width integer view of an entry u64 equal to 7 discharges maybe_zero's value == 0 Trap crash guard without a caller crash ceiling.
// Expected exit: 0
machine maybe_zero(value: i64) -> i64
crashes Trap value == 0
{
    transition value == 0 { true -> bad() false -> (value) }
    machine bad() -> i64 { crash Trap; }
}
windows_x86_64 machine forward(value: i64) -> i64
crashes Trap value == 0
{
    maybe_zero(value)
}
linux_x86_64 machine forward(value: i64) -> i64
crashes Trap value == 0
{
    maybe_zero(value)
}
macos_arm64 machine forward(value: i64) -> i64
crashes Trap value == 0
{
    maybe_zero(value)
}
linux_arm64 machine forward(value: i64) -> i64
crashes Trap value == 0
{
    maybe_zero(value)
}
public machine read_bits(value: u64) -> i64
requires value == 7
{
    let view: &i64 = &value as &i64;
    let observed: i64 = view;
    forward(observed)
}
machine main() crashes Trap {
    let observed: i64 = read_bits(7);
    transition observed == 7 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
