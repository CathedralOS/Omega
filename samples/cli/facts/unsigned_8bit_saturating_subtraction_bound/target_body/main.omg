// Fact: 8-bit unsigned saturating subtraction lhs -| rhs with bounded interval 60u8 <= diff <= 160u8 establishes 60u8 <= diff <= 160u8 across all nine places so exact subtractions 160u8 - diff and diff - 60u8 are safe.
// Expected exit: 0

machine verify_diff(value: u8) -> u8
requires value >= 60u8 && value <= 160u8
{
    let headroom: u8 = 160u8 - value;
    let margin: u8 = value - 60u8;
    transition headroom == 50u8 && margin == 50u8 {
        true -> 0u8
        _ -> 1u8
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(lhs: u8 in Saturating, rhs: u8 in Saturating) -> u8
        reaches SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(lhs: u8 in Saturating, rhs: u8 in Saturating) -> u8
        reaches SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let diff_sat: u8 in Saturating = lhs - rhs;
        let diff: u8 = diff_sat as u8;
        transition diff >= 60u8 && diff <= 160u8 {
            true -> step(diff)
            _ -> bad()
        }
        machine step(d: u8) -> u8 {
            verify_diff(d)
        }
        machine bad() -> u8 { crash Trap; }
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(lhs: u8 in Saturating, rhs: u8 in Saturating) -> u8
        reaches SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let diff_sat: u8 in Saturating = lhs - rhs;
        let diff: u8 = diff_sat as u8;
        transition diff >= 60u8 && diff <= 160u8 {
            true -> step(diff)
            _ -> bad()
        }
        machine step(d: u8) -> u8 {
            verify_diff(d)
        }
        machine bad() -> u8 { crash Trap; }
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let rc: u8 = SelectedProbe::exercise(140u8, 30u8);
    transition rc == 0u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
