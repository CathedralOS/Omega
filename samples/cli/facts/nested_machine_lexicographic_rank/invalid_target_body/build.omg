use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "joint_lexicographic" };
    Build::select_provider::<|app|::Hosted, |app|::HostedBody>(builder, windows_x86_64);
    Build::select_provider::<|app|::Hosted, |app|::HostedBody>(builder, linux_x86_64);
    Build::select_provider::<|app|::Hosted, |app|::HostedBody>(builder, macos_arm64);
    Build::select_provider::<|app|::Hosted, |app|::HostedBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
