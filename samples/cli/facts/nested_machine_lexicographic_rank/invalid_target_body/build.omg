machine build(builder: &mut Build) {
    Build::application(builder, "joint_lexicographic");
    Build::select_provider<Hosted, HostedBody>(builder, windows_x86_64);
    Build::select_provider<Hosted, HostedBody>(builder, linux_x86_64);
    Build::select_provider<Hosted, HostedBody>(builder, macos_arm64);
    Build::select_provider<Hosted, HostedBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
