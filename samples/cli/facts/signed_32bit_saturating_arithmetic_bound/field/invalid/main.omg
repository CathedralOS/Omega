// Fact: 32-bit signed saturating addition lhs +| rhs with bounded interval 50i32 <= sum <= 100i32 establishes 50i32 <= sum <= 100i32 across all nine places so exact subtractions 100i32 - sum and sum - 50i32 are safe.
// Place: field (invalid twin). The lhs upper bound is widened to 81i32 so sum reaches 101i32, causing contract verification for verify_sum to fail closed.
// Expected diagnostic: cannot prove requires contract for call verify_sum

data SatPacket {
    lhs: i32;
    rhs: i32;
}

data SumBox {
    val: i32;
}

machine verify_sum(sum: i32) -> i32 requires sum >= 50i32 && sum <= 100i32 {
    let headroom: i32 = 100i32 - sum;
    let margin: i32 = sum - 50i32;
    let total: i32 = headroom + margin;
    let check: i32 = total - 50i32;
    check
}

machine sat_field(packet: SatPacket) -> i32
requires packet.lhs >= 40 && packet.lhs <= 81 && packet.rhs >= 10 && packet.rhs <= 20
{
    let a: i32 in Saturating = packet.lhs as i32 in Saturating;
    let b: i32 in Saturating = packet.rhs as i32 in Saturating;
    let sat_sum: i32 in Saturating = a + b;
    let sum: i32 = sat_sum as i32;
    let box: SumBox = SumBox { val: sum };
    verify_sum(box.val)
}

machine probe() -> i32 {
    let packet: SatPacket = SatPacket { lhs: 60i32, rhs: 15i32 };
    sat_field(packet)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
