// Fact: 32-bit signed saturating addition lhs +| rhs with bounded interval 50i32 <= sum <= 100i32 establishes 50i32 <= sum <= 100i32 across all nine places so exact subtractions 100i32 - sum and sum - 50i32 are safe.
// Place: root. Proves 32-bit signed saturating addition lhs +| rhs establishes bounded sum and discharges downstream exact subtractions.
// Expected exit: 0

machine verify_sum(sum: i32) -> i32 requires sum >= 50i32 && sum <= 100i32 {
    let headroom: i32 = 100i32 - sum;
    let margin: i32 = sum - 50i32;
    let total: i32 = headroom + margin;
    let check: i32 = total - 50i32;
    check
}

machine evaluate(lhs: i32, rhs: i32) -> i32
requires lhs >= 40 && lhs <= 80 && rhs >= 10 && rhs <= 20
{
    let a: i32 in Saturating = lhs as i32 in Saturating;
    let b: i32 in Saturating = rhs as i32 in Saturating;
    let sat_sum: i32 in Saturating = a + b;
    let sum: i32 = sat_sum as i32;
    verify_sum(sum)
}

machine main() crashes Trap {
    let res: i32 = evaluate(60i32, 15i32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
