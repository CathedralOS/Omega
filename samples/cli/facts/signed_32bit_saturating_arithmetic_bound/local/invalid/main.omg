// Fact: 32-bit signed saturating addition lhs +| rhs with bounded interval 50i32 <= sum <= 100i32 establishes 50i32 <= sum <= 100i32 across all nine places so exact subtractions 100i32 - sum and sum - 50i32 are safe.
// Place: local (invalid twin). The lhs upper bound is widened to 81i32 so sum reaches 101i32, causing contract verification for verify_sum to fail closed.
// Expected diagnostic: cannot prove requires contract for call verify_sum

machine verify_sum(sum: i32) -> i32 requires sum >= 50i32 && sum <= 100i32 {
    let headroom: i32 = 100i32 - sum;
    let margin: i32 = sum - 50i32;
    let total: i32 = headroom + margin;
    let check: i32 = total - 50i32;
    check
}

machine sat_local(lhs: i32, rhs: i32) -> i32
requires lhs >= 40 && lhs <= 81 && rhs >= 10 && rhs <= 20
{
    let local_lhs: i32 = lhs;
    let local_rhs: i32 = rhs;
    let a: i32 in Saturating = local_lhs as i32 in Saturating;
    let b: i32 in Saturating = local_rhs as i32 in Saturating;
    let sat_sum: i32 in Saturating = a + b;
    let sum: i32 = sat_sum as i32;
    let loc: i32 = sum;
    verify_sum(loc)
}

machine probe() -> i32 {
    sat_local(60i32, 15i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
