// A reference loaded from fixed-layout storage retains its selected representation policy and live referent while the adjacent integer field keeps its value.
// Expected exit: 0
use {omega}/language/core/layout.omg;
data Payload [copy] { value: u64; }
PayloadLayout<const Marker: u64> satisfies |layout|::FixedLayout<Payload> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        let extent: u64 = match Marker == 11u64 { true -> 16u64, _ -> 8u64 };
        |layout|::LayoutPlan { entries: entries, entry_count: 1, size_fixed: extent, size_is_dynamic: false, align: 8 }
    }
}
data Envelope<'view, T> [copy] { value: u64; pointer: @'view T; }
data Readback<'held, T> [copy] { value: u64; pointer: @'held T; selected_first: bool; }
EnvelopeLayout<T> satisfies |layout|::FixedLayout<Envelope<T> > {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::IntegerAt { offset: 0, stored_width: 8, interpretation: |layout|::IntegerInterpretation::Unsigned } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 8 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 2, size_fixed: 16, size_is_dynamic: false, align: 8 }
    }
}
machine update<'source, 'storage, const Marker: u64>(pointer: @'source |layout|::LayoutStorage<Payload, PayloadLayout<Marker> >, storage: @'storage u64, selected_first: bool) -> Readback<'source, |layout|::LayoutStorage<Payload, PayloadLayout<Marker> > > {
    let mutable record: |layout|::LayoutStorage<Envelope<|layout|::LayoutStorage<Payload, PayloadLayout<Marker> > >, EnvelopeLayout<|layout|::LayoutStorage<Payload, PayloadLayout<Marker> > > >;
    record.pointer = pointer;
    record.value = 7u64;
    let loaded: @'source |layout|::LayoutStorage<Payload, PayloadLayout<Marker> > = record.pointer;
    Readback { value: record.value, pointer: loaded, selected_first: selected_first }
}
// Place: match_join. The complete returned carrier crosses a match join; both arms execute.
machine observe<'source, 'storage>(pointer: @'source |layout|::LayoutStorage<Payload, PayloadLayout<7u64> >, storage: @'storage u64) -> bool {
    let choose_first: bool = $storage == 23u64;
    let result: Readback<'source, |layout|::LayoutStorage<Payload, PayloadLayout<7u64> > > = match choose_first {
        true -> update::<7u64>(pointer, storage, true),
        false -> update::<7u64>(pointer, storage, false)
    };
    result.value == 7u64 && result.pointer.value == 43u64 && result.selected_first == choose_first
}
machine main() crashes Trap {
    let mutable pointee: |layout|::LayoutStorage<Payload, PayloadLayout<7u64> >;
    pointee.value = 43u64;
    let storage: u64 = 23u64;
    let result: bool = observe(@pointee, @storage);
    let alternate_storage: u64 = 29u64;
    let alternate: bool = observe(@pointee, @alternate_storage);
    transition result && alternate && pointee.value == 43u64 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
