use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    Build::select_provider::<|app|::ReadbackInspect, |app|::LinuxX8664Readback>(builder, linux_x86_64);
    Build::select_provider::<|app|::ReadbackInspect, |app|::LinuxArm64Readback>(builder, linux_arm64);
    Build::select_provider::<|app|::ReadbackInspect, |app|::MacosArm64Readback>(builder, macos_arm64);
    Build::select_provider::<|app|::ReadbackInspect, |app|::WindowsX8664Readback>(builder, windows_x86_64);
    builder.product = BuildProduct::Application { name: "fixed_layout_reference_readback_target_body" };
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
