machine build(builder: &mut Build) {
    Build::select_provider<ReadbackInspect, LinuxX8664Readback>(builder, linux_x86_64);
    Build::select_provider<ReadbackInspect, LinuxArm64Readback>(builder, linux_arm64);
    Build::select_provider<ReadbackInspect, MacosArm64Readback>(builder, macos_arm64);
    Build::select_provider<ReadbackInspect, WindowsX8664Readback>(builder, windows_x86_64);
    Build::application(builder, "fixed_layout_reference_readback_target_body_rejected");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
