// A shared byte view formed inside a constructed call argument borrows the caller's exact backing array for that invocation, so the callee proves its extent requirement from the formation and reads the authored bytes.
// Place: A field of the caller's borrowed record backs the view.
// Reject twin: the backing array holds 3 bytes, so the formed view cannot establish the callee's 4-byte extent requirement.
data Input<'input> { tag: u8; bytes: &'input [u8]; tail: u8; }
machine read_third<'input>(packet: Input<'input>) -> u8
requires packet.bytes.len >= 4 {
    transition packet.tag == 5 && packet.tail == 9 {
        true -> third(packet.bytes)
        false -> zero()
    }
    machine third(bytes: &[u8]) -> u8 requires bytes.len >= 4 { bytes[2] }
    machine zero() -> u8 { 0 }
}
data Main { head: u64; packet: [u8; 3]; rest: u64; }
machine Main::main(main: &mut Main) crashes Trap {
    main.head = 3;
    main.rest = 4;
    main.packet[0] = 11;
    main.packet[2] = 29;
    let third: u8 = read_third(Input { tag: 5, bytes: &main.packet, tail: 9 });
    let other: u8 = read_third(Input { tag: 6, bytes: &main.packet, tail: 9 });
    transition third == 29 && other == 0 && main.head == 3 && main.rest == 4 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
