// Fact: 64-bit signed saturating multiplication lhs *| rhs with bounded interval 50i64 <= prod <= 200i64 establishes 50i64 <= prod <= 200i64 across all nine places so exact subtractions 200i64 - prod and prod - 50i64 are safe.
// Place: target_body. Each hosted target body computes the 64-bit signed saturating multiplication and verifies the bounds.
// Expected exit: 0
machine verify_prod(value: i64) -> i64
    requires value >= 50 && value <= 200
{
    let head: i64 = 200 - value;
    let tail: i64 = value - 50;
    head + tail
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedComputeTargetBody {
    machine compute_target_body(lhs: i64, rhs: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 10 && lhs <= 21 && rhs >= 5 && rhs <= 10;
}

X86ComputeTargetBody satisfies SelectedComputeTargetBody {
    machine compute_target_body(lhs: i64, rhs: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 10 && lhs <= 21 && rhs >= 5 && rhs <= 10
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: i64 in Saturating = lhs as i64 in Saturating;
        let b: i64 in Saturating = rhs as i64 in Saturating;
        let sat: i64 in Saturating = a * b;
        let prod: i64 = sat as i64;
        verify_prod(prod)
    }
}

ArmComputeTargetBody satisfies SelectedComputeTargetBody {
    machine compute_target_body(lhs: i64, rhs: i64) -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 10 && lhs <= 21 && rhs >= 5 && rhs <= 10
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: i64 in Saturating = lhs as i64 in Saturating;
        let b: i64 in Saturating = rhs as i64 in Saturating;
        let sat: i64 in Saturating = a * b;
        let prod: i64 = sat as i64;
        verify_prod(prod)
    }
}

machine evaluate() -> i64 {
    SelectedComputeTargetBody::compute_target_body(15, 8)
}

machine main() crashes Trap {
    let res: i64 = evaluate();
    transition res == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
