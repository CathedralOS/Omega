// Expected exit: 0
// A shadowed const binder carries the seven-unit upper bound before exact 7 - value.
data Units {}
domain u64::AtMostSeven requires self <= 7;
trait Bounded {
    machine value<const Units: u64>(input: u64) -> u64
    requires input <= Units
    ensures result <= Units;
}
Selected satisfies Bounded {
    machine value<const Units: u64>(input: u64) -> u64
    requires input <= Units
    ensures result <= Units
    { input }
}
machine selected<Implementation satisfies Bounded>() -> u64
ensures result <= 7
{ Implementation::value<7>(7) }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObtain {
    machine obtain() -> u64 in AtMostSeven
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Obtain satisfies SelectedObtain {
    machine obtain() -> u64 in AtMostSeven
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     selected<Selected>() 
    }
}

ArmObtain satisfies SelectedObtain {
    machine obtain() -> u64 in AtMostSeven
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     selected<Selected>() 
    }
}


machine main() crashes Trap {
    let observed: u64 = SelectedObtain::obtain();
    let difference: u64 = 7u64 - observed;
    transition difference == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
