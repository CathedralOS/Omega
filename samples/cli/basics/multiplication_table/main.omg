use {omega}/language/core/byte_observation/byte_observation.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// A 9x9 multiplication table -- the first sample that produces FORMATTED NUMERIC OUTPUT.
// Every other sample renders glyphs or animation frames; this one converts computed
// numbers to text (itoa: a two-digit field, space-padded) and lays them out in an aligned
// grid. Combines a nested i/j loop, per-cell `i*j`, digit extraction (tens = p/10, ones =
// p%10, + '0'), a computed column offset `(j-1)*3` formed into a field (a computed index
// is refused in a subscript), and carrier byte writes. Each row is cleared to spaces, the
// two digit chars written per cell, then printed. Pure compute + stdout, no new features.
// Expected exit: 0.
// Expected output contains: 81

domain [u8]::Utf8
requires
    |byte_observation|::valid_utf8(@self[..]);
domain [u8; 28]::Utf8
requires
    |byte_observation|::valid_utf8(@self[..]);
data Main {
    line: [u8; 28] in Utf8;
    i: i32 in Wrapping;   // row factor 1..9
    j: i32 in Wrapping;   // column factor 1..9
    k: i32 in Wrapping;   // clear index
    p: i32 in Wrapping;   // product i*j
    tens: i32 in Wrapping;
    ones: i32 in Wrapping;
    o0: i32 in Wrapping;  // column byte offset (j-1)*3
    o1: i32 in Wrapping;  // o0 + 1
    tc: u8;               // tens char (or space)
    oc: u8;               // ones char
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("multiplication_table: the 9x9 times table, space-padded numeric text");
    main.line = "                            " as +Utf8;
    main.i = 1 as +Wrapping;
    transition { _ -> block row_loop(main) }

    machine row_loop(main: @mutable Main) {
        transition main.i >= 1 && main.i <= 9 { true -> block clear_init(main), _ -> block finish(main) }
    }
    // clear the row buffer to spaces
    machine clear_init(main: @mutable Main) {
        main.k = 0 as +Wrapping;
        transition { _ -> block clear(main) }
    }
    machine clear(main: @mutable Main) {
        transition main.k >= 0 && main.k < 28 { true -> block clear_cell(main), _ -> block col_init(main) }
    }
    machine clear_cell(main: @mutable Main) {
        (@mutable main.line as -Utf8)[main.k as -Wrapping] = 32; // ' '
        main.k = main.k + 1;
        transition { _ -> block clear(main) }
    }
    machine col_init(main: @mutable Main) {
        main.j = 1 as +Wrapping;
        transition { _ -> block col_loop(main) }
    }
    machine col_loop(main: @mutable Main) {
        transition main.j >= 1 && main.j <= 9 { true -> block cell(main), _ -> block emit_row(main) }
    }
    machine cell(main: @mutable Main) {
        main.p = main.i * main.j;
        main.tens = main.p / 10;
        main.ones = main.p % 10;
        main.oc = |numeric_conversion|::narrow_i32_to_u8_trapping((main.ones + 48) as -Wrapping);
        transition main.tens > 0 { true -> block cell_tens(main), _ -> block cell_space(main) }
    }
    machine cell_tens(main: @mutable Main) {
        main.tc = |numeric_conversion|::narrow_i32_to_u8_trapping((main.tens + 48) as -Wrapping);
        transition { _ -> block cell_write(main) }
    }
    machine cell_space(main: @mutable Main) {
        main.tc = 32; // leading space for single-digit products
        transition { _ -> block cell_write(main) }
    }
    machine cell_write(main: @mutable Main) {
        main.o0 = (main.j - 1) * 3;
        main.o1 = main.o0 + 1;
        transition main.o0 >= 0 && main.o0 < 28 && main.o1 >= 0 && main.o1 < 28 {
            true -> block cell_store(main),
            _ -> block bad(main)
        }
    }
    machine cell_store(main: @mutable Main) {
        (@mutable main.line as -Utf8)[main.o0 as -Wrapping] = main.tc;
        (@mutable main.line as -Utf8)[main.o1 as -Wrapping] = main.oc;
        main.j = main.j + 1;
        transition { _ -> block col_loop(main) }
    }
    machine emit_row(main: @mutable Main) {
        |console|::Console::write_line((@main.line as -Utf8)[..]);
        main.i = main.i + 1;
        transition { _ -> block row_loop(main) }
    }

    machine finish(main: @mutable Main) {
        |console|::Console::write_line("PASS: 9 rows rendered (exit 0)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine bad(main: @mutable Main) {
        |console|::Console::write_line("FAIL: internal bounds check failed (exit 1)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
