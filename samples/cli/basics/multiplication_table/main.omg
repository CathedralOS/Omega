// A 9x9 multiplication table -- the first sample that produces FORMATTED NUMERIC OUTPUT.
// Every other sample renders glyphs or animation frames; this one converts computed
// numbers to text (itoa: a two-digit field, space-padded) and lays them out in an aligned
// grid. Combines a nested i/j loop, per-cell `i*j`, digit extraction (tens = p/10, ones =
// p%10, + '0'), a computed column offset `(j-1)*3` formed into a field (a computed index
// is refused in a subscript), and carrier byte writes. Each row is cleared to spaces, the
// two digit chars written per cell, then printed. Pure compute + stdout, no new features.
// Expected exit: 0.
// Expected output contains: 81
use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 28]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    line: [u8; 28] in Utf8;
    i: i32 in Wrapping;   // row factor 1..9
    j: i32 in Wrapping;   // column factor 1..9
    k: i32 in Wrapping;   // clear index
    p: i32 in Wrapping;   // product i*j
    tens: i32 in Wrapping;
    ones: i32 in Wrapping;
    o0: i32 in Wrapping;  // column byte offset (j-1)*3
    o1: i32 in Wrapping;  // o0 + 1
    tc: u8;               // tens char (or space)
    oc: u8;               // ones char
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("multiplication_table: the 9x9 times table, space-padded numeric text");
    main.line = "                            ";
    main.i = 1;
    transition { _ -> row_loop(main) }

    state row_loop(main: &mut Main) {
        transition main.i >= 1 && main.i <= 9 { true -> clear_init(main) _ -> finish(main) }
    }
    // clear the row buffer to spaces
    state clear_init(main: &mut Main) {
        main.k = 0;
        transition { _ -> clear(main) }
    }
    state clear(main: &mut Main) {
        transition main.k >= 0 && main.k < 28 { true -> clear_cell(main) _ -> col_init(main) }
    }
    state clear_cell(main: &mut Main) {
        main.line[main.k] = 32; // ' '
        main.k = main.k + 1;
        transition { _ -> clear(main) }
    }
    state col_init(main: &mut Main) {
        main.j = 1;
        transition { _ -> col_loop(main) }
    }
    state col_loop(main: &mut Main) {
        transition main.j >= 1 && main.j <= 9 { true -> cell(main) _ -> emit_row(main) }
    }
    state cell(main: &mut Main) {
        main.p = main.i * main.j;
        main.tens = main.p / 10;
        main.ones = main.p % 10;
        main.oc = narrow_i32_to_u8_trapping((main.ones + 48) as i32);
        transition main.tens > 0 { true -> cell_tens(main) _ -> cell_space(main) }
    }
    state cell_tens(main: &mut Main) {
        main.tc = narrow_i32_to_u8_trapping((main.tens + 48) as i32);
        transition { _ -> cell_write(main) }
    }
    state cell_space(main: &mut Main) {
        main.tc = 32; // leading space for single-digit products
        transition { _ -> cell_write(main) }
    }
    state cell_write(main: &mut Main) {
        main.o0 = (main.j - 1) * 3;
        main.o1 = main.o0 + 1;
        transition main.o0 >= 0 && main.o0 < 28 && main.o1 >= 0 && main.o1 < 28 {
            true -> cell_store(main)
            _ -> bad(main)
        }
    }
    state cell_store(main: &mut Main) {
        main.line[main.o0] = main.tc;
        main.line[main.o1] = main.oc;
        main.j = main.j + 1;
        transition { _ -> col_loop(main) }
    }
    state emit_row(main: &mut Main) {
        Console::write_line(main.line);
        main.i = main.i + 1;
        transition { _ -> row_loop(main) }
    }

    state finish(main: &mut Main) {
        Console::write_line("PASS: 9 rows rendered (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: internal bounds check failed (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
