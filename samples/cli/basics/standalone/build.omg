// Standalone benchmark subject: binds the hosted program-entry slots with no
// package dependency. The canonical ProcessExit provider lives in the standard
// library, so this artifact cannot terminate cleanly; it is a compile-scope
// subject measured with --no-run.

use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "standalone" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_x86_64::ProgramEntry, |app|::main);
}
