// Standalone benchmark subject: binds the hosted program-entry slots with no
// package dependency. The canonical ProcessExit provider lives in the standard
// library, so this artifact cannot terminate cleanly; it is a compile-scope
// subject measured with --no-run.

machine build(builder: &mut Build) {
    Build::application(builder, "standalone");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
}
