// Build and verify a greeting in an explicit fixed-capacity owner.
// Qualification preserves the storage array's exact 32-byte extent; used names the live prefix.
// Expected exit: 70.
// Expected output contains: Hello, Ada!

use omega_language_std::console;

domain [u8; 32]::Ascii(bytes) requires ascii_only(bytes);
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
data TextBuffer where used <= 32 { storage: [u8; 32] in Ascii; used: u64; }
machine live(buffer: &TextBuffer) -> &[u8] in Ascii { &buffer.storage[..buffer.used] }
machine copy(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64)
requires start <= 32; bytes.len <= 32 - start
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    state copying(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 32; index <= 32
    {
        transition index < bytes.len && start + index < 32 {
            true -> writing(buffer, bytes, start, index)
            _ -> done()
        }
    }
    state writing(buffer: &mut [u8; 32] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 32; index < 32; index < bytes.len; start + index < 32
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    state done() {}
}

domain [u8; 3]::Ascii(bytes) requires ascii_only(bytes);

data Main {
    name: [u8; 3] in Ascii;
    greeting: TextBuffer;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("text_greeting: builds Hello, Ada! in an explicit text buffer");
    main.name = "Ada";
    copy(&mut main.greeting.storage, "Hello, ", 0);
    copy(&mut main.greeting.storage, &main.name, 7);
    copy(&mut main.greeting.storage, "!", 10);
    main.greeting.used = 11;
    Console::write_line(live(&main.greeting));

    transition live(&main.greeting) == "Hello, Ada!" {
        true -> ok(main)
        _ -> mismatch(main)
    }

    state ok(main: &mut Main) {
        Console::write_line("PASS: the greeting matched Hello, Ada! exactly (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state mismatch(main: &mut Main) {
        Console::write_line("FAIL: the concatenated greeting did not match (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
