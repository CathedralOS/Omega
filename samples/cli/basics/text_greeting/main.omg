// Owned `[u8; N] in Utf8` text carriers: build a greeting by concatenation, print
// it, and verify it. Omega has no `String` keyword -- text is bytes refined by a
// `Utf8` domain, stored inline in a fixed-capacity carrier (`len` + `[u8; N]`).
// `main.greeting = "Hello, " + main.name + "!"` materializes the literal and the
// `name` carrier's content into greeting's inline bytes; `write_line` prints them;
// `==` compares content. Prints "Hello, Ada!" and exits 70 only if the carrier
// holds exactly that.
// Expected exit: 70.
// Expected output contains: Hello, Ada!

use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 32]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    console: Binding<Console>;
    name: [u8; 8] in Utf8;
    greeting: [u8; 32] in Utf8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    main.console.write_line("text_greeting: builds Hello, Ada! by carrier concatenation");
    main.name = "Ada";
    main.greeting = "Hello, " + main.name + "!";
    main.console.write_line(main.greeting);

    transition main.greeting == "Hello, Ada!" {
        true -> ok(main)
        _ -> mismatch(main)
    }

    state ok(main: &mut Main) {
        main.console.write_line("PASS: the greeting matched Hello, Ada! exactly (exit 70)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(70);
    }
    state mismatch(main: &mut Main) {
        main.console.write_line("FAIL: the concatenated greeting did not match (exit 71)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(71);
    }
}
