// Owned `[u8; N] in Utf8` text carriers: build a greeting by concatenation, print
// it, and verify it. Omega has no `String` keyword -- text is bytes refined by a
// `Utf8` domain, stored inline in a fixed-capacity carrier (`len` + `[u8; N]`).
// `let greeting = "Hello, " + name + "!"` materializes the literal and the
// `name` carrier's content into greeting's inline bytes; `write_line` prints them;
// `==` compares content. Prints "Hello, Ada!" and exits 70 only if the carrier
// holds exactly that.
// Expected exit: 70.
// Expected output contains: Hello, Ada!

use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 32]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main) reaches Console {
    context.console.write_line("text_greeting: builds Hello, Ada! by carrier concatenation");
    let name: [u8; 8] in Utf8 = "Ada";
    let greeting: [u8; 32] in Utf8 = "Hello, " + name + "!";
    context.console.write_line(greeting);

    transition greeting == "Hello, Ada!" {
        true -> ok(context)
        _ -> mismatch(context)
    }

    state ok(context: &mut Main) {
        context.console.write_line("PASS: the greeting matched Hello, Ada! exactly (exit 70)");
        context.console.write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block context.console.read_line(&mut pause);
        context.console.exit_process(70);
    }
    state mismatch(context: &mut Main) {
        context.console.write_line("FAIL: the concatenated greeting did not match (exit 71)");
        context.console.write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block context.console.read_line(&mut pause);
        context.console.exit_process(71);
    }
}
