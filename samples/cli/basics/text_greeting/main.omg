use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Build and verify a greeting in an explicit fixed-capacity owner.
// Qualification preserves the storage array's exact 32-byte extent; used names the live prefix.
// Expected exit: 70.
// Expected output contains: Hello, Ada!


domain [u8; 32]::Ascii requires ascii_only(self);
domain [u8]::Ascii requires ascii_only(self);
data TextBuffer requires used <= 32 { storage: [u8; 32] in Ascii; used: u64; }
machine live(buffer: @TextBuffer) -> @[u8] in Ascii { @buffer.storage[..buffer.used] }
machine copy(buffer: @mutable [u8; 32] in Ascii, bytes: @[u8] in Ascii, start: u64)
requires start <= 32, bytes.length <= 32 - start
ensures buffer in Ascii
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    machine copying(buffer: @mutable [u8; 32] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 32, index <= 32
    ensures buffer in Ascii
    {
        transition index < bytes.length && start + index < 32 {
            true -> writing(buffer, bytes, start, index),
            _ -> done()
        }
    }
    machine writing(buffer: @mutable [u8; 32] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 32, index < 32, index < bytes.length, start + index < 32
    ensures buffer in Ascii
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    machine done() {}
}

domain [u8; 3]::Ascii requires ascii_only(self);

data Main {
    name: [u8; 3] in Ascii;
    greeting: TextBuffer;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("text_greeting: builds Hello, Ada! in an explicit text buffer");
    main.name = "Ada";
    copy(@mutable main.greeting.storage, "Hello, ", 0);
    copy(@mutable main.greeting.storage, @main.name, 7);
    copy(@mutable main.greeting.storage, "!", 10);
    main.greeting.used = 11;
    |console|::Console::write_line(live(@main.greeting));

    transition live(@main.greeting) == "Hello, Ada!" {
        true -> block ok(main),
        _ -> block mismatch(main)
    }

    machine ok(main: @mutable Main) {
        |console|::Console::write_line("PASS: the greeting matched Hello, Ada! exactly (exit 70)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(70);
    }
    machine mismatch(main: @mutable Main) {
        |console|::Console::write_line("FAIL: the concatenated greeting did not match (exit 71)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
