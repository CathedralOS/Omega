use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data InnerChoice { case Empty; case Value(token: Token); }
data OuterChoice { case Absent; case Present(inner: InnerChoice); }
data Holder { marker: u64; choice: OuterChoice; }

machine clear(choice: &mut OuterChoice) {
    choice = OuterChoice::Absent {};
}

machine consume_inner(choice: InnerChoice) -> u64 {
    transition choice {
        InnerChoice::Empty {} -> 1
        InnerChoice::Value { token } -> consume_token(token)
    }
}

machine consume_token(token: Token) -> u64 {
    let value: u64 = token.value;
    drop(token);
    value
}

machine consume_outer(choice: OuterChoice) -> u64 {
    transition choice {
        OuterChoice::Absent {} -> 0
        OuterChoice::Present { inner } -> consume_inner(inner)
    }
}

machine main() crashes Trap {
    let mut absent: Holder = Holder { marker: 30, choice: OuterChoice::Absent {} };
    let mut empty: Holder = Holder {
        marker: 40,
        choice: OuterChoice::Present { inner: InnerChoice::Empty {} },
    };
    let mut populated: Holder = Holder {
        marker: 50,
        choice: OuterChoice::Present {
            inner: InnerChoice::Value { token: Token { value: 7 } },
        },
    };
    clear(&mut absent.choice);
    clear(&mut empty.choice);
    clear(&mut populated.choice);
    let first: u64 = consume_outer(absent.choice);
    let second: u64 = consume_outer(empty.choice);
    let third: u64 = consume_outer(populated.choice);
    transition first == 0 && second == 0 && third == 0 && absent.marker == 30 && empty.marker == 40 && populated.marker == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
