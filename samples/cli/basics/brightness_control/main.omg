// A brightness controller whose command cases publish ordinary predicates.
// Matching SetLevel supplies its level bounds; matching Dim supplies the
// amount bounds used by exact multiplication. Off supplies a literal zero.
// All three arms owe the same apply-state requirement, and its field write
// restores Main's brightness predicate without a range cast or nominal domain.
//
// main issues `SetLevel { level: 65 }`, so the controller settles at 65.
// Expected exit: 65.

use omega_language_std::console;

data Command {
    case SetLevel(level: i32) where level >= 0 && level <= 100;
    case Dim(amount: i32) where amount >= 0 && amount <= 10;
    case Off;
}

data Main where brightness >= 0 && brightness <= 100 {
    brightness: i32;
    command: Command;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("brightness_control: applying a bounded SetLevel command");
    main.brightness = 80;
    main.command = Command::SetLevel { level: 65 };

    transition main.command {
        Command::SetLevel { level } -> apply(main, level)
        Command::Dim { amount }     -> apply(main, amount * 10)
        Command::Off                -> apply(main, 0)
    }

    state apply(main: &mut Main, target: i32)
    requires target >= 0 && target <= 100;
    {
        main.brightness = target;
        transition { _ -> report(main) }
    }

    state report(main: &mut Main) {
        Console::write_line("brightness settled at the applied level (the exit code)");
        Console::exit_process(main.brightness);
    }
}
