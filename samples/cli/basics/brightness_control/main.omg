use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// A brightness controller whose command cases publish ordinary predicates.
// Matching SetLevel supplies its level bounds; matching Dim supplies the
// amount bounds used by exact multiplication. Off supplies a literal zero.
// All three arms owe the same apply-state requirement, and its field write
// restores Main's brightness predicate without a range cast or nominal domain.
//
// main issues `SetLevel { level: 65 }`, so the controller settles at 65.
// Expected exit: 65.


data Command 
    requires ((self in Command::SetLevel) && (self.level >= 0 && self.level <= 100)) || ((self in Command::Dim) && (self.amount >= 0 && self.amount <= 10)) || (self in Command::Off)
{
    case SetLevel(level: i32);
    case Dim(amount: i32);
    case Off;
}

data Main requires brightness >= 0 && brightness <= 100 {
    brightness: i32;
    command: Command;
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    |console|::Console::write_line("brightness_control: applying a bounded SetLevel command");
    main.brightness = 80;
    main.command = Command::SetLevel { level: 65 };

    transition main.command {
        Command::SetLevel { level } -> apply(main, level),
        Command::Dim { amount }     -> apply(main, amount * 10),
        Command::Off                -> apply(main, 0)
    }

    machine apply(main: @mutable Main, target: i32)
    requires target >= 0 && target <= 100
    {
        main.brightness = target;
        transition { _ -> report(main) }
    }

    machine report(main: @mutable Main) {
        |console|::Console::write_line("brightness settled at the applied level (the exit code)");
        |process_exit|::ProcessExit::exit_process(main.brightness);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
