data Token { value: u64; }
machine Token::drop(token: &mut Token) {}
data Choice { case Empty; case Value(token: Token); }

machine observe(choice: Choice) -> u64 { 42 }
machine peek(choice: &Choice) -> u64 { 31 }
machine choose_choice(populated: bool) -> Choice {
    transition populated {
        true -> (Choice::Value { token: Token { value: 7 } })
        _ -> (Choice::Empty {})
    }
}

data Envelope { marker: u64; choice: Choice; }
machine Envelope::drop(envelope: &mut Envelope) {
    envelope.marker = 99;
}
machine observe_envelope(envelope: Envelope) -> u64 { envelope.marker }

data Parcel { token: Token; choice: Choice; }
machine extract(parcel: Parcel) -> Token { parcel.token }
machine onward(parcel: Parcel) -> u64 {
    transition { _ -> carry(parcel.token) }
    machine carry(token: Token) -> u64 { token.value }
}

machine main() crashes Trap {
    let empty: u64 = observe(Choice::Empty {});
    let populated: u64 = observe(Choice::Value { token: Token { value: 7 } });
    let temporary: u64 = peek(&choose_choice(true));
    let temporary_empty: u64 = peek(&choose_choice(false));
    let parent_empty: u64 = observe_envelope(Envelope {
        marker: 11, choice: Choice::Empty {}
    });
    let parent_populated: u64 = observe_envelope(Envelope {
        marker: 13, choice: Choice::Value { token: Token { value: 7 } }
    });
    let captured: Token = extract(Parcel {
        token: Token { value: 23 },
        choice: Choice::Value { token: Token { value: 7 } }
    });
    let forwarded: u64 = onward(Parcel {
        token: Token { value: 29 },
        choice: Choice::Value { token: Token { value: 7 } }
    });
    transition empty == 42 && populated == 42 && temporary == 31 && temporary_empty == 31 && parent_empty == 11 && parent_populated == 13 && captured.value == 23 && forwarded == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
