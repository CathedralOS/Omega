// Print the squares 1..9 as DECIMAL TEXT, one per line -- the first sample to output
// computed NUMBERS (not just text or an exit code). Each square k*k is rendered to a
// 3-digit [u8;3] carrier by repeated divide/modulo (the itoa pattern) and printed.
// Proves numeric output, a basic serious-app need. Pure compute + stdout.
// Expected exit: 0.
// Expected output contains: 081
use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    out: [u8; 3] in Utf8;
    k: u32 in Wrapping;
    sq: u32 in Wrapping;
    place: u32 in Wrapping;
    d: u32 in Wrapping;
    ch: u32 in Wrapping;
    byte: u8 in Wrapping;
    p: u64;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("print_squares: the squares 1..9 printed as 3-digit decimal text");
    main.out = "XXX";
    main.k = 1;
    transition { _ -> outer(main) }

    state outer(main: &mut Main) {
        transition main.k <= 9 { true -> compute_sq(main) _ -> finish(main) }
    }
    state compute_sq(main: &mut Main) {
        main.sq = main.k * main.k;
        main.place = 100;
        main.p = 0;
        transition { _ -> itoa_loop(main) }
    }
    // `place` reaches 0 only after the third digit; the guard states that
    // nonzero divisor for `digit_div`'s Wrapping division.
    state itoa_loop(main: &mut Main) {
        transition main.p < 3 && main.place != 0 { true -> digit_div(main) _ -> print_row(main) }
    }
    state digit_div(main: &mut Main) {
        main.d = main.sq / main.place;
        transition { _ -> digit_mod(main) }
    }
    state digit_mod(main: &mut Main) {
        main.d = main.d % 10;
        transition { _ -> digit_write(main) }
    }
    state digit_write(main: &mut Main) {
        main.ch = main.d + 48;
        main.byte = narrow_u32_to_u8_wrapping(main.ch as u32) as u8 in Wrapping;
        main.out[main.p] = main.byte as u8;
        main.place = main.place / 10;
        main.p = main.p + 1;
        transition { _ -> itoa_loop(main) }
    }
    state print_row(main: &mut Main) {
        Console::write_line(main.out);
        main.k = main.k + 1;
        transition { _ -> outer(main) }
    }

    state finish(main: &mut Main) {
        Console::write_line("PASS: 9 squares printed, ending at 081 (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
}
