// Compute a value and PRINT it as text -- the read/compute/print pipeline a real
// CLI app needs. It sums an array with a runtime-indexed loop, then converts the
// total to decimal digits and writes them to stdout (a fixed-width 3-digit
// `itoa`: each digit char is `value % 10 + '0'`, written into a carrier whose
// bytes are then printed).
//
//   sum([10,20,30,40,50]) = 150  ->  prints "150"
//
// Building the output string overwrites a 3-char carrier's bytes with computed
// digit chars (constant-index carrier writes) and prints the carrier. Exits 0.
// Expected exit: 0.
// Expected output contains: 150

use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    // Wrapping DECLARED (nums/elem/sum/digit): the sum flows from array elements,
    // which carry no range facts yet, and Decision 17 forbids mixing domains in
    // one expression. The loop index stays Exact: its increment is guard-proven
    // by the `i < 5` edge into add().
    nums: [i32; 5] in Wrapping;
    i: i32;
    elem: i32 in Wrapping;
    sum: i32 in Wrapping;
    out: [u8; 4] in Utf8;
    digit: i32 in Wrapping;
    ch: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("print_number: summing [10..50] and printing the total as decimal text");
    main.nums[0] = 10;
    main.nums[1] = 20;
    main.nums[2] = 30;
    main.nums[3] = 40;
    main.nums[4] = 50;
    main.i = 0;
    main.sum = 0;

    transition {
        _ -> step(main)
    }

    state step(main: &mut Main) {
        transition main.i < 5 {
            true -> add(main)
            _ -> render(main)
        }
    }

    state add(main: &mut Main) {
        main.elem = main.nums[main.i];
        main.sum = main.sum + main.elem;
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }

    // Convert the total to three decimal-digit characters and print them.
    //
    // Each digit char is computed (`value % 10 + '0'`), so it arrives as a plain
    // `u8` carrying no range facts: `digit` is `in Wrapping`, which is a
    // write-side admission obligation and supplies no interval, and the trapping
    // narrowing yields all of `0..=255`. Writing such a byte into a carrier whose
    // domain `requires valid_utf8(bytes)` cannot re-establish that domain, so each
    // write is dominated by a guard proving the byte is ASCII. A literal write
    // (`main.out[0] = 49`) needs no guard -- the literal proves itself.
    state render(main: &mut Main) {
        main.out = "000";
        main.digit = main.sum / 100;
        main.digit = main.digit + 48;
        main.ch = narrow_i32_to_u8_trapping(main.digit as i32);
        transition main.ch < 128 { true -> hundreds(main) _ -> bad(main) }
    }
    state hundreds(main: &mut Main) {
        main.out[0] = main.ch;
        main.digit = main.sum / 10;
        main.digit = main.digit % 10;
        main.digit = main.digit + 48;
        main.ch = narrow_i32_to_u8_trapping(main.digit as i32);
        transition main.ch < 128 { true -> tens(main) _ -> bad(main) }
    }
    state tens(main: &mut Main) {
        main.out[1] = main.ch;
        main.digit = main.sum % 10;
        main.digit = main.digit + 48;
        main.ch = narrow_i32_to_u8_trapping(main.digit as i32);
        transition main.ch < 128 { true -> ones(main) _ -> bad(main) }
    }
    state ones(main: &mut Main) {
        main.out[2] = main.ch;
        Console::write_line(main.out);
        Console::write_line("PASS: the sum 150 printed above (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: a computed digit char left ASCII (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
