// Compute a value and PRINT it as text -- the read/compute/print pipeline a real
// CLI app needs. It sums an array with a runtime-indexed loop, then converts the
// total to decimal digits and writes them to stdout (a fixed-width 3-digit
// `itoa`: each digit char is `value % 10 + '0'`, written into a carrier whose
// bytes are then printed).
//
//   sum([10,20,30,40,50]) = 150  ->  prints "150"
//
// Building the output string overwrites a 3-char carrier's bytes with computed
// digit chars (constant-index carrier writes) and prints the carrier. Exits 0.
// Expected exit: 0.
// Expected output contains: 150

use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 4]::Utf8
requires
    valid_utf8(self);
data Main {
    console: Console;
    // Wrapping DECLARED (nums/elem/sum/digit): the sum flows from array elements,
    // which carry no range facts yet, and Decision 17 forbids mixing domains in
    // one expression. The loop index stays Exact: its increment is guard-proven
    // by the `i < 5` edge into add().
    nums: [i32; 5] in Wrapping;
    i: i32 [0..=5];
    elem: i32 in Wrapping;
    sum: i32 in Wrapping;
    out: [u8; 4] in Utf8;
    digit: i32 in Wrapping;
    ch: u8;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("print_number: summing [10..50] and printing the total as decimal text");
    self.nums[0] = 10;
    self.nums[1] = 20;
    self.nums[2] = 30;
    self.nums[3] = 40;
    self.nums[4] = 50;
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 5 {
            true -> add()
            _ -> render()
        }
    }

    state add(&mut self) {
        self.elem = self.nums[self.i];
        self.sum = self.sum + self.elem;
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    // Convert the total to three decimal-digit characters and print them.
    state render(&mut self) {
        self.out = "000";

        self.digit = self.sum / 100;
        self.digit = self.digit + 48;
        self.ch = narrow_i32_to_u8_trapping(self.digit as i32);
        self.out[0] = self.ch;

        self.digit = self.sum / 10;
        self.digit = self.digit % 10;
        self.digit = self.digit + 48;
        self.ch = narrow_i32_to_u8_trapping(self.digit as i32);
        self.out[1] = self.ch;

        self.digit = self.sum % 10;
        self.digit = self.digit + 48;
        self.ch = narrow_i32_to_u8_trapping(self.digit as i32);
        self.out[2] = self.ch;

        self.console.write_line(self.out);
        self.console.write_line("PASS: the sum 150 printed above (exit 0)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(0);
    }
}
