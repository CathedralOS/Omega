use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// The minimal Omega program -- "hello world". `main` prints a line through the system
// console boundary and exits cleanly. This is the simplest end-to-end smoke test
// (frontend + codegen + host console) and the runnable baseline behind every other
// sample. Annotated so the samples harness value-asserts it (runs + checks the
// exit), not just compiles it.
// Expected exit: 0.
// Expected output contains: Hello, Omega.

use system\Console;

data Main {
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("Hello, Omega.");
    Console::write_line("[press Enter to close]");
    _ = block Console::read_line(@mutable main.pause[..]);
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
