// The minimal Omega program -- "hello world". `main` prints a line through the std
// console boundary and exits cleanly. This is the simplest end-to-end smoke test
// (frontend + codegen + host console) and the runnable baseline behind every other
// sample. Annotated so the samples harness value-asserts it (runs + checks the
// exit), not just compiles it.
// Expected exit: 0.
// Expected output contains: Hello, Omega.

use omega_language_std::console;

data Main {
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("Hello, Omega.");
    Console::write_line("[press Enter to close]");
    _ = block Console::read_line(&mut main.pause);
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
