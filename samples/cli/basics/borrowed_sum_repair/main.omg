use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Choice { case Success(token: Token); case Failure(token: Token); }
data Holder { marker: u64; choice: Choice; }

machine change(token: Token, increment: bool) -> Choice {
    transition increment {
        true -> replace(token)
        _ -> Choice::Failure { token: token }
    }
    machine replace(token: Token) -> Choice {
        let value: u64 = token.value;
        drop(token);
        Choice::Success { token: Token { value: ((value as u64 in Wrapping) + 1) as u64 } }
    }
}

machine transform(choice: Choice, increment: bool) -> Choice {
    transition choice {
        Choice::Success { token } -> change(token, increment)
        Choice::Failure { token } -> change(token, increment)
    }
}

machine repair(choice: &mut Choice, increment: bool) {
    let detached: Choice = choice;
    choice = transform(detached, increment);
}

machine read_and_drop(token: Token) -> u64 {
    let value: u64 = token.value;
    drop(token);
    value
}

machine consume(choice: Choice) -> u64 {
    transition choice {
        Choice::Success { token } -> read_and_drop(token)
        Choice::Failure { token } -> read_and_drop(token)
    }
}

machine main() crashes Trap {
    let mut holder: Holder = Holder {
        marker: 19,
        choice: Choice::Failure { token: Token { value: 41 } },
    };
    repair(&mut holder.choice, false);
    repair(&mut holder.choice, true);
    let marker: u64 = holder.marker;
    let result: u64 = consume(holder.choice);
    transition marker == 19 && result == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
