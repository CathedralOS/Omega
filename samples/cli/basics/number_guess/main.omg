// Binary-search guessing game (scripted, no stdin).
//
// The secret number is 42. The game uses binary search over [1, 100] to
// find it. No user input: each guess is computed from the current [lo, hi]
// range via mid = (lo + hi) / 2. Guesses are unrolled since the number of
// steps (7) is known in advance.
//
// Binary search trace (target=42, range=[1,100]):
//   guess 1: mid=50  > 42 -> hi=49
//   guess 2: mid=25  < 42 -> lo=26
//   guess 3: mid=37  < 42 -> lo=38
//   guess 4: mid=43  > 42 -> hi=42
//   guess 5: mid=40  < 42 -> lo=41
//   guess 6: mid=41  < 42 -> lo=42
//   guess 7: mid=42 == 42 -> FOUND
//
// 7 guesses to find the number. Verification: guesses == 7 -> exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Search [copy] {
    lo: i32 in Saturating;
    hi: i32 in Saturating;
    mid: i32 in Saturating;
    guesses: i32 in Saturating;
    found: i32 in Saturating;   // 1 when the target has been located
}

data Main {
    search: Search;
    pause: [u8; 256];
}

// Perform one binary-search step: compute mid = (lo+hi)/2, compare to target.
// Updates lo or hi, increments guesses, sets found=1 if matched.
machine Main::step(main: &mut Main, target: i32 in Saturating) {
    let mid: i32 in Saturating = (main.search.lo + main.search.hi) / 2;
    main.search.mid = mid;
    main.search.guesses = main.search.guesses + 1;
    transition mid == target {
        true -> found(main)
        _ -> not_found(main, mid, target)
    }

    state found(main: &mut Main) {
        main.search.found = 1;
    }

    state not_found(main: &mut Main, mid: i32 in Saturating, target: i32 in Saturating) {
        transition mid < target {
            true -> move_lo(main, mid)
            _ -> move_hi(main, mid)
        }
    }

    state move_lo(main: &mut Main, mid: i32 in Saturating) {
        main.search.lo = mid + 1;
    }

    state move_hi(main: &mut Main, mid: i32 in Saturating) {
        main.search.hi = mid - 1;
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("number_guess: binary-searching [1,100] for the secret number 42");
    // Initialize search range [1, 100].
    main.search.lo = 1;
    main.search.hi = 100;

    // Secret number to find.
    let target: i32 in Saturating = 42;

    // Seven unrolled binary-search steps.
    Main::step(main, target);   // guess 1: mid=50 > 42, hi=49
    Main::step(main, target);   // guess 2: mid=25 < 42, lo=26
    Main::step(main, target);   // guess 3: mid=37 < 42, lo=38
    Main::step(main, target);   // guess 4: mid=43 > 42, hi=42
    Main::step(main, target);   // guess 5: mid=40 < 42, lo=41
    Main::step(main, target);   // guess 6: mid=41 < 42, lo=42
    Main::step(main, target);   // guess 7: mid=42 == 42, found!

    // Verify found within 7 guesses.
    transition main.search.found == 1 {
        true -> check_guesses(main)
        _ -> not_found_error(main)
    }

    state check_guesses(main: &mut Main) {
        // Exactly 7 guesses needed: 7 * 10 = 70.
        transition main.search.guesses == 7 {
            true -> good(main)
            _ -> bad_guesses(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: found 42 in exactly 7 guesses (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state not_found_error(main: &mut Main) {
        Console::write_line("FAIL: target never found (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state bad_guesses(main: &mut Main) {
        Console::write_line("FAIL: wrong guess count (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }
}
