// Unit converter. Exercises f64 scalar conversions:
// temperature (Celsius ↔ Fahrenheit ↔ Kelvin), distance (km ↔ miles),
// and mass (kg ↔ lbs). Stresses f64 parameter passing, arithmetic
// chains, and state-parameter tolerance checks.
//
// Conversion checks:
//   100°C  → 212.0°F           (should be 212.0 ± 0.1)
//   212°F  → 100.0°C           (should be 100.0 ± 0.1)
//   373.15K → 100.0°C          (should be 100.0 ± 0.1)
//   10 km  → 6.2137 miles      (should be > 6.1, < 6.3)
//   5.0 kg → 11.023 lbs        (should be > 11.0, < 11.1)
//
// All guard ladders exit 70 on success.
//
// Expected exit: 70.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
}

// Temperature conversions.
machine celsius_to_fahrenheit(c: f64) -> f64 {
    c * 1.8 + 32.0
}

machine fahrenheit_to_celsius(f: f64) -> f64 {
    let shifted: f64 = f - 32.0;
    shifted * 0.5555555555555556
}

machine kelvin_to_celsius(k: f64) -> f64 {
    k - 273.15
}

// Distance conversion.
machine km_to_miles(km: f64) -> f64 {
    km * 0.621371
}

// Mass conversion.
machine kg_to_lbs(kg: f64) -> f64 {
    kg * 2.20462
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("unit_converter: f64 temperature, distance, and mass conversions");
    // Check 1: 100°C → 212°F.
    let result: f64 = celsius_to_fahrenheit(100.0);
    transition result > 211.5 {
        true -> check_c2f_upper(context, result)
        _ -> bad_c2f_low(context)
    }
    state bad_c2f_low(context: &mut Main) {
        Console::write_line("FAIL: 100 C converted below 211.5 F (exit 71)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(71);
    }

    state check_c2f_upper(context: &mut Main, result: f64) {
        transition result < 212.5 {
            true -> check_f2c(context)
            _ -> bad_c2f_high(context)
        }
    }
    state bad_c2f_high(context: &mut Main) {
        Console::write_line("FAIL: 100 C converted above 212.5 F (exit 72)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(72);
    }

    // Check 2: 212°F → 100°C.
    state check_f2c(context: &mut Main) {
        let result: f64 = fahrenheit_to_celsius(212.0);
        transition result > 99.5 {
            true -> check_f2c_upper(context, result)
            _ -> bad_f2c_low(context)
        }
    }
    state bad_f2c_low(context: &mut Main) {
        Console::write_line("FAIL: 212 F converted below 99.5 C (exit 73)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(73);
    }

    state check_f2c_upper(context: &mut Main, result: f64) {
        transition result < 100.5 {
            true -> check_k2c(context)
            _ -> bad_f2c_high(context)
        }
    }
    state bad_f2c_high(context: &mut Main) {
        Console::write_line("FAIL: 212 F converted above 100.5 C (exit 74)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(74);
    }

    // Check 3: 373.15K → 100°C.
    state check_k2c(context: &mut Main) {
        let result: f64 = kelvin_to_celsius(373.15);
        transition result > 99.9 {
            true -> check_k2c_upper(context, result)
            _ -> bad_k2c_low(context)
        }
    }
    state bad_k2c_low(context: &mut Main) {
        Console::write_line("FAIL: 373.15 K converted below 99.9 C (exit 75)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(75);
    }

    state check_k2c_upper(context: &mut Main, result: f64) {
        transition result < 100.1 {
            true -> check_km(context)
            _ -> bad_k2c_high(context)
        }
    }
    state bad_k2c_high(context: &mut Main) {
        Console::write_line("FAIL: 373.15 K converted above 100.1 C (exit 76)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(76);
    }

    // Check 4: 10 km → ~6.21 miles.
    state check_km(context: &mut Main) {
        let result: f64 = km_to_miles(10.0);
        transition result > 6.1 {
            true -> check_km_upper(context, result)
            _ -> bad_km_low(context)
        }
    }
    state bad_km_low(context: &mut Main) {
        Console::write_line("FAIL: 10 km converted below 6.1 miles (exit 77)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(77);
    }

    state check_km_upper(context: &mut Main, result: f64) {
        transition result < 6.3 {
            true -> check_kg(context)
            _ -> bad_km_high(context)
        }
    }
    state bad_km_high(context: &mut Main) {
        Console::write_line("FAIL: 10 km converted above 6.3 miles (exit 78)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(78);
    }

    // Check 5: 5 kg → ~11.023 lbs.
    state check_kg(context: &mut Main) {
        let result: f64 = kg_to_lbs(5.0);
        transition result > 11.0 {
            true -> check_kg_upper(context, result)
            _ -> bad_kg_low(context)
        }
    }
    state bad_kg_low(context: &mut Main) {
        Console::write_line("FAIL: 5 kg converted below 11.0 lbs (exit 79)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(79);
    }

    state check_kg_upper(context: &mut Main, result: f64) {
        transition result < 11.1 {
            true -> good(context)
            _ -> bad_kg_high(context)
        }
    }
    state bad_kg_high(context: &mut Main) {
        Console::write_line("FAIL: 5 kg converted above 11.1 lbs (exit 80)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(80);
    }

    state good(context: &mut Main) {
        Console::write_line("PASS: all five conversions landed in tolerance (exit 70)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(70);
    }
}
