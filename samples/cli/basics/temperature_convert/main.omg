// Convert a Celsius temperature to Fahrenheit with f64 floating-point arithmetic --
// the first sample to exercise floats, the backbone of measurement/scientific code.
// `fahrenheit = celsius * 1.8 + 32.0` evaluates the standard formula (a multiply and
// an add over f64 fields and literals), then `as i32` truncates the result for the
// process exit code. 20 C -> 20*1.8 + 32 = 68 F.
// Expected exit: 68.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    console: Console;
    celsius: f64;
    fahrenheit: f64;
    result: i32;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("temperature_convert: 20 C to Fahrenheit with f64 arithmetic");
    self.celsius = 20.0;
    self.fahrenheit = self.celsius * 1.8 + 32.0;
    self.result = (self.fahrenheit as i32 in Saturating) as i32; // F4: proof-or-policy, then explicit policy erasure

    transition { _ -> done() }

    state done(&mut self) {
        self.console.write_line("result: the Fahrenheit value truncated, 68 for 20 C (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.result);
    }
}
