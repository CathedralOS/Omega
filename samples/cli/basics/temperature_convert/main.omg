// Convert a Celsius temperature to Fahrenheit with f64 floating-point arithmetic --
// the first sample to exercise floats, the backbone of measurement/scientific code.
// `fahrenheit = celsius * 1.8 + 32.0` evaluates the standard formula (a multiply and
// an add over f64 fields and literals), then `as i32` truncates the result for the
// process exit code. 20 C -> 20*1.8 + 32 = 68 F.
// Expected exit: 68.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    celsius: f64;
    fahrenheit: f64;
    result: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("temperature_convert: 20 C to Fahrenheit with f64 arithmetic");
    main.celsius = 20.0;
    main.fahrenheit = main.celsius * 1.8 + 32.0;
    // A named saturating conversion truncates the float, then the policy erases.
    let converted: i32 in Saturating = I32::from_f64(main.fahrenheit);
    main.result = converted as i32;

    transition { _ -> done(main) }

    state done(main: &mut Main) {
        Console::write_line("result: the Fahrenheit value truncated, 68 for 20 C (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.result);
    }
}
