// Device extent access vocabulary exercise. A DMA transfer is an external
// borrow of a `Granted` extent range by a device: the admitted provider
// reserves the range, lends it as the linear `DeviceLoan` proxy
// direction-qualified by domain, carries the ordering occurrences
// (publication, cache maintenance, notification, completion), and only
// `acquire` restores `Extent::Granted` custody after borrower release is
// proven.
//
// Checked-provider sample — `DeviceLoan` and `DeviceOrderingEvent` are
// provider-issued opaque data, so the concrete `LoopbackDeviceLoanProvider`
// supplies the crossings as target-scoped `via
// ForeignBinding::CompilerIntrinsic` leaves, selected for
// `DeviceLoanProvider` through its `provider_defaults` on macos_arm64. The
// leaves carry no source body: minting extents, loans, and ordering
// occurrences is provider admission work the toolchain realizes.
//
// The two drivers below check the full protocol — reserve, lend, publish,
// notify, settle, maintain_cache, complete, acquire, release — including
// Pending-retry custody. They are deliberately unreachable from the bound
// entry: the native product carries every accepted `DeviceLoanProvider`
// requirement plan and the ten intrinsic leaves as checked boundary plans
// (a requirement lending a linear opaque, `publish(loan: &DeviceLoan)`,
// included), but the toolchain's closed compiler-intrinsic inventory realizes
// no device crossing yet, so a reachable driver would stop at provider
// admission. Native realization of the ten crossings is the next edge; this
// sample pins the checked contract and the inert entry's native build.
//
// Expected exit: 0.

use omega::language::core::device;
use omega::language::core::extent;
use omega::language::core::representation;

// The byte representation `DeviceLoan` materializes across the provider
// boundary: a carrier the opaque proxy selects through
// `OpaqueRepresentation<DeviceLoan, DeviceLoanCarrier>` so the toolchain has a
// concrete layout to realize, while source still cannot construct, copy, or
// inspect one.
pub data DeviceLoanCarrier {
    token: u64;
}
pub DeviceLoanRepresentation satisfies OpaqueRepresentation<DeviceLoan, DeviceLoanCarrier> { }

// The same selected byte representation for the ordering occurrences.
pub data DeviceOrderingEventCarrier {
    token: u64;
}
pub DeviceOrderingEventRepresentation satisfies OpaqueRepresentation<
    DeviceOrderingEvent,
    DeviceOrderingEventCarrier
> { }

// The concrete provider the sample selects: a loopback device authority whose
// crossings are compiler-intrinsic leaves. Its eventual realization is a
// copy-and-validate device over its own process-memory pool — reserve mints
// pool ranges, lend revokes CPU access per direction and records the loan and
// its ordering state, complete proves borrower release, acquire validates,
// writes back, and restores `Granted` custody, and release returns the range.
pub data LoopbackDeviceLoanProvider {}

macos_arm64 machine LoopbackDeviceLoanProvider::provider_defaults(defaults: &mut LoopbackDeviceLoanProvider) {
    LoopbackDeviceLoanProvider::select_provider<DeviceLoanProvider, LoopbackDeviceLoanProvider>(defaults);
}

macos_arm64 machine LoopbackDeviceLoanProvider::reserve(length: u64) -> Extent
    satisfies DeviceLoanProvider::reserve
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::release(range: Extent in Granted)
    satisfies DeviceLoanProvider::release
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::lend_for_read(range: Extent in Granted) -> DeviceLoan
    satisfies DeviceLoanProvider::lend_for_read
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::lend_for_write(range: Extent in Granted) -> DeviceLoan
    satisfies DeviceLoanProvider::lend_for_write
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::publish(loan: &DeviceLoan) -> DeviceOrderingEvent
    satisfies DeviceLoanProvider::publish
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::maintain_cache(loan: &DeviceLoan) -> DeviceOrderingEvent
    satisfies DeviceLoanProvider::maintain_cache
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::notify(publication: DeviceOrderingEvent in DeviceOrderingEvent::Publication) -> DeviceOrderingEvent
    satisfies DeviceLoanProvider::notify
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::settle(event: DeviceOrderingEvent)
    satisfies DeviceLoanProvider::settle
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::complete(loan: DeviceLoan) -> DeviceCompletionAttempt
    satisfies DeviceLoanProvider::complete
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::acquire(completion: DeviceOrderingEvent in DeviceOrderingEvent::Completion) -> DeviceAcquisitionAttempt
    satisfies DeviceLoanProvider::acquire
    via ForeignBinding::CompilerIntrinsic;

data DmaHarness {
}

// The shared-borrow chain: reserve a pool range, lend it to the device for
// reads, run publication -> notification -> settlement and cache
// maintenance -> settlement, then complete -> acquire with Pending-retry
// custody, and release the restored range.
machine DmaHarness::stage_dma_read(dma_harness: &DmaHarness)
reaches DeviceLoanProvider
{
    let range: Extent = DeviceLoanProvider::reserve(4096);
    let loan: DeviceLoan = DeviceLoanProvider::lend_for_read(range);
    let publication: DeviceOrderingEvent = DeviceLoanProvider::publish(&loan);
    let notification: DeviceOrderingEvent = DeviceLoanProvider::notify(publication);
    DeviceLoanProvider::settle(notification);
    let maintenance: DeviceOrderingEvent = DeviceLoanProvider::maintain_cache(&loan);
    DeviceLoanProvider::settle(maintenance);
    let consumed: DeviceLoan = loan as DeviceLoan;
    let attempt: DeviceCompletionAttempt = DeviceLoanProvider::complete(consumed);
    transition attempt {
        DeviceCompletionAttempt::Completed { completion } -> acquire(dma_harness, completion)
        DeviceCompletionAttempt::Pending { loan } -> retry(dma_harness, loan)
    }

    state retry(dma_harness: &DmaHarness, pending: DeviceLoan) {
        let retry: DeviceCompletionAttempt = DeviceLoanProvider::complete(pending);
        transition retry {
            DeviceCompletionAttempt::Completed { completion } -> acquire(dma_harness, completion)
            DeviceCompletionAttempt::Pending { loan } -> retry(dma_harness, loan)
        }
    }
    state acquire(dma_harness: &DmaHarness, completion: DeviceOrderingEvent in DeviceOrderingEvent::Completion) {
        let acquired: DeviceAcquisitionAttempt = DeviceLoanProvider::acquire(completion);
        transition acquired {
            DeviceAcquisitionAttempt::Acquired { extent } -> release(dma_harness, extent)
            DeviceAcquisitionAttempt::Pending { completion } -> acquire(dma_harness, completion)
        }
    }
    state release(dma_harness: &DmaHarness, restored: Extent in Granted) {
        DeviceLoanProvider::release(restored);
    }
}

// The exclusive-borrow direction: the same ordering chain, minted under the
// `DeviceWrites` qualification.
machine DmaHarness::stage_dma_write(dma_harness: &DmaHarness)
reaches DeviceLoanProvider
{
    let range: Extent = DeviceLoanProvider::reserve(4096);
    let loan: DeviceLoan = DeviceLoanProvider::lend_for_write(range);
    let publication: DeviceOrderingEvent = DeviceLoanProvider::publish(&loan);
    let notification: DeviceOrderingEvent = DeviceLoanProvider::notify(publication);
    DeviceLoanProvider::settle(notification);
    let maintenance: DeviceOrderingEvent = DeviceLoanProvider::maintain_cache(&loan);
    DeviceLoanProvider::settle(maintenance);
    let consumed: DeviceLoan = loan as DeviceLoan;
    let attempt: DeviceCompletionAttempt = DeviceLoanProvider::complete(consumed);
    transition attempt {
        DeviceCompletionAttempt::Completed { completion } -> acquire(dma_harness, completion)
        DeviceCompletionAttempt::Pending { loan } -> retry(dma_harness, loan)
    }

    state retry(dma_harness: &DmaHarness, pending: DeviceLoan) {
        let retry: DeviceCompletionAttempt = DeviceLoanProvider::complete(pending);
        transition retry {
            DeviceCompletionAttempt::Completed { completion } -> acquire(dma_harness, completion)
            DeviceCompletionAttempt::Pending { loan } -> retry(dma_harness, loan)
        }
    }
    state acquire(dma_harness: &DmaHarness, completion: DeviceOrderingEvent in DeviceOrderingEvent::Completion) {
        let acquired: DeviceAcquisitionAttempt = DeviceLoanProvider::acquire(completion);
        transition acquired {
            DeviceAcquisitionAttempt::Acquired { extent } -> release(dma_harness, extent)
            DeviceAcquisitionAttempt::Pending { completion } -> acquire(dma_harness, completion)
        }
    }
    state release(dma_harness: &DmaHarness, restored: Extent in Granted) {
        DeviceLoanProvider::release(restored);
    }
}

data Main {}

machine Main::main() {}
