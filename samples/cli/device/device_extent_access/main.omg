// Device extent access vocabulary exercise. A DMA transfer is an external
// borrow of a `Granted` extent range by a device: the admitted provider lends
// the range as the linear `DeviceLoan` proxy, direction-qualified by domain,
// carries the ordering occurrences (publication, cache maintenance,
// notification, completion), and only `acquire` restores `Extent::Granted`
// custody after borrower release is proven.
//
// Checked-provider sample — `DeviceLoan` and `DeviceOrderingEvent` are
// provider-issued opaque data, so the concrete `LoopbackDeviceLoanProvider`
// supplies the crossings as target-scoped `via ForeignBinding::CompilerIntrinsic`
// leaves, selected for `DeviceLoanProvider` through its `provider_defaults` on
// macos_arm64. The leaves carry no source body: minting loans and ordering
// occurrences, completing the release, and restoring custody are provider
// admission work the toolchain realizes, mirroring the float/console intrinsic
// route. Native realization of the crossings remains the toolchain's next
// edge; this sample pins the checked contract — both loan directions through
// one selected provider, the ordering-role chain, retry custody, and restored
// `Extent::Granted` only at acquisition.

use omega::language::core::device;
use omega::language::core::extent;
use omega::language::core::binding;
use omega::language::core::representation;

// The byte representation `DeviceLoan` materializes across the provider
// boundary: a carrier the opaque proxy selects through
// `OpaqueRepresentation<DeviceLoan>` so the toolchain has a concrete layout to
// realize, while source still cannot construct, copy, or inspect one.
pub data DeviceLoanCarrier {
    token: u64;
}
pub DeviceLoanRepresentation:
    DeviceLoanCarrier satisfies OpaqueRepresentation<DeviceLoan>;

// The same selected byte representation for the ordering occurrences.
pub data DeviceOrderingEventCarrier {
    token: u64;
}
pub DeviceOrderingEventRepresentation:
    DeviceOrderingEventCarrier satisfies OpaqueRepresentation<DeviceOrderingEvent>;

// The concrete provider the sample selects: a loopback device authority whose
// crossings are compiler-intrinsic leaves. Its eventual realization is a
// copy-and-validate device over process memory — on lend the provider revokes
// CPU access to the range per direction and records the loan and its ordering
// state; on complete it proves borrower release; on acquire it validates,
// writes back, and restores `Granted` custody.
pub data LoopbackDeviceLoanProvider {}

macos_arm64 machine LoopbackDeviceLoanProvider::provider_defaults(defaults: &mut LoopbackDeviceLoanProvider) {
    defaults.select_provider<DeviceLoanProvider, LoopbackDeviceLoanProvider>();
}

macos_arm64 machine LoopbackDeviceLoanProvider::lend_for_read(range: Extent in Granted) -> DeviceLoan
    satisfies DeviceLoanProvider::lend_for_read
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::lend_for_write(range: Extent in Granted) -> DeviceLoan
    satisfies DeviceLoanProvider::lend_for_write
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::publish(loan: &DeviceLoan) -> DeviceOrderingEvent
    satisfies DeviceLoanProvider::publish
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::maintain_cache(loan: &DeviceLoan) -> DeviceOrderingEvent
    satisfies DeviceLoanProvider::maintain_cache
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::notify(publication: DeviceOrderingEvent in DeviceOrderingEvent::Publication) -> DeviceOrderingEvent
    satisfies DeviceLoanProvider::notify
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::settle(event: DeviceOrderingEvent)
    satisfies DeviceLoanProvider::settle
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::complete(loan: DeviceLoan) -> DeviceCompletionAttempt
    satisfies DeviceLoanProvider::complete
    via ForeignBinding::CompilerIntrinsic;
macos_arm64 machine LoopbackDeviceLoanProvider::acquire(completion: DeviceOrderingEvent in DeviceOrderingEvent::Completion) -> DeviceAcquisitionAttempt
    satisfies DeviceLoanProvider::acquire
    via ForeignBinding::CompilerIntrinsic;

// The checked root-grant adapter: an ordinary source body satisfies
// `ExtentRootProvider::grant`; the qualified lend argument comes only from the
// selected provider plan's admission receipt, not from this body.
pub data ExtentRootProviderImpl {}

macos_arm64 machine ExtentRootProviderImpl::provider_defaults(defaults: &mut ExtentRootProviderImpl) {
    defaults.select_provider<ExtentRootProvider, ExtentRootProviderImpl>();
}
machine ExtentRootProviderImpl::grant(root: Extent) -> Extent
satisfies ExtentRootProvider::grant
{
    root
}

machine consume_read_loan(loan: DeviceLoan in DeviceReads) -> DeviceLoan {
    loan as DeviceLoan
}

machine consume_write_loan(loan: DeviceLoan in DeviceWrites) -> DeviceLoan {
    loan as DeviceLoan
}

data DmaHarness {
    roots: Binding<ExtentRootProvider>;
    device: Binding<DeviceLoanProvider>;
}

// The shared-borrow direction: publication + notification cover the CPU
// writes the device must observe, cache maintenance covers the loan's
// target coherence facts, then complete -> acquire restores custody.
machine DmaHarness::stage_dma_read(dma_harness: &DmaHarness, root: Extent) -> Extent
reaches ExtentRootProvider, DeviceLoanProvider
{
    let granted: Extent = dma_harness.roots.grant(root);
    let loan: DeviceLoan = dma_harness.device.lend_for_read(granted);
    let publication: DeviceOrderingEvent = dma_harness.device.publish(&loan);
    let notification: DeviceOrderingEvent = dma_harness.device.notify(publication);
    dma_harness.device.settle(notification);
    let maintenance: DeviceOrderingEvent = dma_harness.device.maintain_cache(&loan);
    dma_harness.device.settle(maintenance);
    let consumed: DeviceLoan = consume_read_loan(loan);
    let attempt: DeviceCompletionAttempt = dma_harness.device.complete(consumed);
    transition attempt {
        DeviceCompletionAttempt::Completed { completion } -> acquire_read(dma_harness, completion)
        DeviceCompletionAttempt::Pending { loan } -> retry_read_completion(dma_harness, loan)
    }
    state retry_read_completion(dma_harness: &DmaHarness, pending: DeviceLoan) -> Extent {
        let retry: DeviceCompletionAttempt = dma_harness.device.complete(pending);
        transition retry {
            DeviceCompletionAttempt::Completed { completion } -> acquire_read(dma_harness, completion)
            DeviceCompletionAttempt::Pending { loan } -> retry_read_completion(dma_harness, loan)
        }
    }
    state acquire_read(dma_harness: &DmaHarness, completion: DeviceOrderingEvent in DeviceOrderingEvent::Completion) -> Extent {
        let acquired: DeviceAcquisitionAttempt = dma_harness.device.acquire(completion);
        transition acquired {
            DeviceAcquisitionAttempt::Acquired { extent } -> (extent as Extent)
            DeviceAcquisitionAttempt::Pending { completion } -> acquire_read(dma_harness, completion)
        }
    }
}

// The exclusive-borrow direction: the same ordering chain, minted under the
// `DeviceWrites` qualification by the lend crossing.
machine DmaHarness::stage_dma_write(dma_harness: &DmaHarness, root: Extent) -> Extent
reaches ExtentRootProvider, DeviceLoanProvider
{
    let granted: Extent = dma_harness.roots.grant(root);
    let loan: DeviceLoan = dma_harness.device.lend_for_write(granted);
    let publication: DeviceOrderingEvent = dma_harness.device.publish(&loan);
    let notification: DeviceOrderingEvent = dma_harness.device.notify(publication);
    dma_harness.device.settle(notification);
    let maintenance: DeviceOrderingEvent = dma_harness.device.maintain_cache(&loan);
    dma_harness.device.settle(maintenance);
    let consumed: DeviceLoan = consume_write_loan(loan);
    let attempt: DeviceCompletionAttempt = dma_harness.device.complete(consumed);
    transition attempt {
        DeviceCompletionAttempt::Completed { completion } -> acquire_write(dma_harness, completion)
        DeviceCompletionAttempt::Pending { loan } -> retry_write_completion(dma_harness, loan)
    }
    state retry_write_completion(dma_harness: &DmaHarness, pending: DeviceLoan) -> Extent {
        let retry: DeviceCompletionAttempt = dma_harness.device.complete(pending);
        transition retry {
            DeviceCompletionAttempt::Completed { completion } -> acquire_write(dma_harness, completion)
            DeviceCompletionAttempt::Pending { loan } -> retry_write_completion(dma_harness, loan)
        }
    }
    state acquire_write(dma_harness: &DmaHarness, completion: DeviceOrderingEvent in DeviceOrderingEvent::Completion) -> Extent {
        let acquired: DeviceAcquisitionAttempt = dma_harness.device.acquire(completion);
        transition acquired {
            DeviceAcquisitionAttempt::Acquired { extent } -> (extent as Extent)
            DeviceAcquisitionAttempt::Pending { completion } -> acquire_write(dma_harness, completion)
        }
    }
}

data Main {}

machine Main::main(&mut self) {}
