// Expected exit: 0.
// The first unconditional arm calls a factory and completes this invocation.
data Item { value: u64; }
machine issue(value: u64) -> Item { Item { value: value } }
machine forbidden() -> Item crashes Trap { crash Trap; }
machine choose(value: u64) -> Item crashes Trap {
    transition {
        _ -> issue(value)
        _ -> forbidden()
    }
}
machine main() crashes Trap {
    let result: Item = choose(37);
    transition result.value == 37 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
