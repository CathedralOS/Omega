// stack_vm: tiny stack-based bytecode evaluator.
//
// Opcodes (case type):
//   Push(value: i32)  -- push a constant onto the stack
//   Add               -- pop two, push sum
//   Sub               -- pop two, push difference (second - top)
//   Mul               -- pop two, push product
//   Dup               -- duplicate top of stack
//   Pop               -- discard top of stack
//
// VM state: fixed [i32 in Wrapping; 8] operand stack + sp (stack pointer, -1 = empty).
//
// Program (hand-verified, computes (3 + 4) * 2 - 1 = 13):
//   step 0: Push(3)  -> stack[0]=3,  sp=0
//   step 1: Push(4)  -> stack[1]=4,  sp=1
//   step 2: Add      -> pop 4,3; push 7; stack[0]=7, sp=0
//   step 3: Push(2)  -> stack[1]=2,  sp=1
//   step 4: Mul      -> pop 2,7; push 14; stack[0]=14, sp=0
//   step 5: Push(1)  -> stack[1]=1,  sp=1
//   step 6: Sub      -> pop 1,14; push 13; stack[0]=13, sp=0
//   step 7: Dup      -> stack[1]=13, sp=1
//   step 8: Pop      -> sp=0
//
// Final: sp=0, stack[0]=13. Exit = 13 + 57 = 70.
//
// (Formerly a documented miscompile -- native exited 71 instead of 70. FIXED:
// the cause was argument materialization inline-folding `let new_sp =
// main.vm.sp + 1` back into its initializer and re-evaluating it at the
// transition AFTER `main.vm.sp = new_sp` overwrote the field, so try_push1's
// guard `new_sp == 1` saw the doubly-incremented value and took the wrong arm.
// The fix keeps the captured `new_sp` slot instead of re-folding. Regression
// test: tests/omega/pass/control_flow/runtime_captured_local_remutated_field_exit.)
//
// Expected exit: 70.

use omega_language_std::console;

data Opcode {
    case Push(value: i32 in Wrapping);
    case Add;
    case Sub;
    case Mul;
    case Dup;
    case Pop;
}

data Vm [copy] {
    stack: [i32 in Wrapping; 8];
    sp: i32 in Wrapping;
}

data Main {
    vm: Vm;
    pause: [u8; 256];
}

// Initialize VM: sp = -1 (empty stack).
machine Main::init(main: &mut Main) {
    main.vm.sp = 0 - 1;
}

// Push a value onto the stack.
machine Main::push(main: &mut Main, value: i32 in Wrapping) {
    let new_sp: i32 in Wrapping = main.vm.sp + 1;
    main.vm.sp = new_sp;
    transition new_sp == 0 {
        true -> push0(main, value)
        _ -> try_push1(main, new_sp, value)
    }
    state push0(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[0] = value; }
    state try_push1(main: &mut Main, new_sp: i32 in Wrapping, value: i32 in Wrapping) {
        transition new_sp == 1 {
            true -> push1(main, value)
            _ -> try_push2(main, new_sp, value)
        }
    }
    state push1(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[1] = value; }
    state try_push2(main: &mut Main, new_sp: i32 in Wrapping, value: i32 in Wrapping) {
        transition new_sp == 2 {
            true -> push2(main, value)
            _ -> try_push3(main, new_sp, value)
        }
    }
    state push2(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[2] = value; }
    state try_push3(main: &mut Main, new_sp: i32 in Wrapping, value: i32 in Wrapping) {
        transition new_sp == 3 {
            true -> push3(main, value)
            _ -> push4(main, value)
        }
    }
    state push3(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[3] = value; }
    state push4(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[4] = value; }
}

// Read top of stack (sp slot) as a value-returning machine.
machine Main::top(main: &mut Main) -> i32 in Wrapping {
    let sp: i32 in Wrapping = main.vm.sp;
    transition sp == 0 {
        true -> (main.vm.stack[0])
        _ -> try1(main, sp)
    }
    state try1(main: &mut Main, sp: i32 in Wrapping) {
        transition sp == 1 {
            true -> (main.vm.stack[1])
            _ -> try2(main, sp)
        }
    }
    state try2(main: &mut Main, sp: i32 in Wrapping) {
        transition sp == 2 {
            true -> (main.vm.stack[2])
            _ -> try3(main, sp)
        }
    }
    state try3(main: &mut Main, sp: i32 in Wrapping) {
        transition sp == 3 {
            true -> (main.vm.stack[3])
            _ -> (main.vm.stack[4])
        }
    }
}

// Pop the top value off the stack (decrements sp, returns old top).
// THIS IS THE MISCOMPILE TRIGGER when called twice sequentially.
machine Main::pop_val(main: &mut Main) -> i32 in Wrapping {
    let v: i32 in Wrapping = Main::top(main);
    main.vm.sp = main.vm.sp - 1;
    transition {
        _ -> (v)
    }
}

// Execute one opcode: multi-arm case dispatch.
machine Main::step(main: &mut Main, op: Opcode) {
    transition op {
        Opcode::Push { value } -> do_push(main, value)
        Opcode::Add -> do_add(main)
        Opcode::Sub -> do_sub(main)
        Opcode::Mul -> do_mul(main)
        Opcode::Dup -> do_dup(main)
        Opcode::Pop -> do_pop(main)
        _ -> done(main)
    }

    state do_push(main: &mut Main, value: i32 in Wrapping) {
        Main::push(main, value);
    }

    state do_add(main: &mut Main) {
        let b: i32 in Wrapping = Main::pop_val(main);
        let a: i32 in Wrapping = Main::pop_val(main);
        let result: i32 in Wrapping = a + b;
        Main::push(main, result);
    }

    state do_sub(main: &mut Main) {
        // Sub: second - top (i.e. a - b where b was pushed last).
        let b: i32 in Wrapping = Main::pop_val(main);
        let a: i32 in Wrapping = Main::pop_val(main);
        let result: i32 in Wrapping = a - b;
        Main::push(main, result);
    }

    state do_mul(main: &mut Main) {
        let b: i32 in Wrapping = Main::pop_val(main);
        let a: i32 in Wrapping = Main::pop_val(main);
        let result: i32 in Wrapping = a * b;
        Main::push(main, result);
    }

    state do_dup(main: &mut Main) {
        let v: i32 in Wrapping = Main::top(main);
        Main::push(main, v);
    }

    state do_pop(main: &mut Main) {
        main.vm.sp = main.vm.sp - 1;
    }

    state done(main: &mut Main) {}
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("stack_vm: a tiny bytecode VM runs (3 + 4) * 2 - 1 on a fixed stack");
    // Initialize VM.
    Main::init(main);

    // Run program: (3 + 4) * 2 - 1 = 13.
    Main::step(main, Opcode::Push { value: 3 });
    Main::step(main, Opcode::Push { value: 4 });
    Main::step(main, Opcode::Add);
    Main::step(main, Opcode::Push { value: 2 });
    Main::step(main, Opcode::Mul);
    Main::step(main, Opcode::Push { value: 1 });
    Main::step(main, Opcode::Sub);
    Main::step(main, Opcode::Dup);
    Main::step(main, Opcode::Pop);

    // Read top-of-stack: should be 13.
    let result: i32 in Wrapping = Main::top(main);
    let code: i32 in Wrapping = result + 57;

    transition code == 70 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: program evaluated to 13, reported as 13 + 57 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: top of stack was not 13 after the program (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
