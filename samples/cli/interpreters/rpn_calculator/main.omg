// Expected exit: 35.
// RPN calculator: interpret an encoded postfix program with an operand stack -- a
// real little bytecode VM. Each token is either a number (push it) or an operator
// that pops two operands and pushes the result. Demonstrates TWO bounded mutable
// indices cooperating: a program counter `pc` walking the program and a stack
// pointer `sp` driving the operand stack, both fully-Exact `i32 [0..=16]` -- the
// explicit `0 <= idx < CAP` guards on the direct edges into every state that moves
// an index both discharge the bounds obligations and prove the +1/-1 steps stay in
// range (Omega's proof model). The token VALUES round-trip through array elements,
// which carry no range facts yet, so the value plumbing is declared Wrapping.
//
// Encoding: program[k] >= 0 pushes that value; negative codes are operators:
//   -1 = add, -2 = multiply, -3 = subtract.
//
//   program = [3, 4, -1, 5, -2]   // 3 4 + 5 *  ==  (3 + 4) * 5
// The program exits with the value it computed. Expected exit: 35.

use omega_language_std::console;

data Main {
    console: Console;
    // Wrapping DECLARED (program/stack/tok/a/b/acc): the operand values flow
    // through array elements, which carry no range facts yet.
    program: [i32; 16] in Wrapping;
    nprog: i32;
    stack: [i32; 16] in Wrapping;
    sp: i32 [0..=16];
    pc: i32 [0..=16];
    tok: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    acc: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("rpn_calculator: evaluates the postfix program 3 4 + 5 * on an operand stack");
    self.program[0] = 3;
    self.program[1] = 4;
    self.program[2] = 0 - 1;
    self.program[3] = 5;
    self.program[4] = 0 - 2;
    self.nprog = 5;

    self.sp = 0;
    self.pc = 0;

    transition {
        _ -> loop()
    }

    // Loop while there are tokens left.
    state loop(&mut self) {
        transition self.pc < self.nprog {
            true -> bound_check()
            _ -> finish()
        }
    }

    // Admit the program index only where it is provably in range.
    state bound_check(&mut self) {
        transition self.pc >= 0 && self.pc < 16 {
            true -> load_token()
            _ -> finish()
        }
    }

    state load_token(&mut self) {
        self.tok = self.program[self.pc];
        transition self.tok >= 0 {
            true -> push_bound()
            _ -> op_bound()
        }
    }

    // --- push a number ---
    state push_bound(&mut self) {
        transition self.sp >= 0 && self.sp < 16 {
            true -> push_token()
            _ -> finish()
        }
    }
    state push_token(&mut self) {
        self.stack[self.sp] = self.tok as i32;
        self.sp = self.sp + 1;
        transition {
            _ -> advance()
        }
    }

    // --- apply a binary operator: pop b, pop a, push (a OP b) ---
    state op_bound(&mut self) {
        transition self.sp >= 2 && self.sp <= 16 {
            true -> op_pop_b()
            _ -> finish()
        }
    }
    state op_pop_b(&mut self) {
        self.sp = self.sp - 1;
        transition self.sp >= 0 && self.sp < 16 { true -> op_read_b() _ -> finish() }
    }
    state op_read_b(&mut self) {
        self.b = self.stack[self.sp];
        transition self.sp >= 1 && self.sp <= 16 { true -> op_pop_a() _ -> finish() }
    }
    state op_pop_a(&mut self) {
        self.sp = self.sp - 1;
        transition self.sp >= 0 && self.sp < 16 { true -> op_read_a() _ -> finish() }
    }
    state op_read_a(&mut self) {
        self.a = self.stack[self.sp];
        transition {
            _ -> op_dispatch()
        }
    }

    // Decode the operator code and compute into `acc`.
    state op_dispatch(&mut self) {
        transition self.tok == 0 - 1 {
            true -> op_add()
            _ -> op_dispatch_mul()
        }
    }
    state op_dispatch_mul(&mut self) {
        transition self.tok == 0 - 2 {
            true -> op_mul()
            _ -> op_sub()
        }
    }
    state op_add(&mut self) {
        self.acc = self.a + self.b;
        transition { _ -> op_guard() }
    }
    state op_mul(&mut self) {
        self.acc = self.a * self.b;
        transition { _ -> op_guard() }
    }
    state op_sub(&mut self) {
        self.acc = self.a - self.b;
        transition { _ -> op_guard() }
    }

    // The add/mul/sub arms join here, then a single re-guard puts `sp < 16` on
    // the one DIRECT edge into op_push -- the dominating-guard keystone is what
    // proves the `sp = sp + 1` after the result push. (After two pops sp <= 14,
    // so the else arm is unreachable.)
    state op_guard(&mut self) {
        transition self.sp >= 0 && self.sp < 16 {
            true -> op_push()
            _ -> finish()
        }
    }

    // Push the result back (sp points at the freed slot after the two pops).
    state op_push(&mut self) {
        self.stack[self.sp] = self.acc as i32;
        self.sp = self.sp + 1;
        transition {
            _ -> advance()
        }
    }

    // Re-assert pc's headroom on the direct edge into the increment (pc < nprog
    // <= 16 always holds, so the else arm is unreachable).
    state advance(&mut self) {
        transition self.pc < 16 {
            true -> bump()
            _ -> finish()
        }
    }
    state bump(&mut self) {
        self.pc = self.pc + 1;
        transition {
            _ -> loop()
        }
    }

    state finish(&mut self) {
        // The result is the bottom of the stack.
        self.console.write_line("result: the RPN evaluation, 35 for this program (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.stack[0]);
    }
}
