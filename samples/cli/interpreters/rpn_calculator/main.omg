// Expected exit: 35.
// RPN calculator: interpret an encoded postfix program with an operand stack -- a
// real little bytecode VM. Each token is either a number (push it) or an operator
// that pops two operands and pushes the result. Demonstrates TWO bounded mutable
// indices cooperating: a program counter `pc` walking the program and a stack
// pointer `sp` driving the operand stack, both plain fully-Exact `i32` -- the
// explicit `0 <= idx < CAP` guards on the direct edges into every state that moves
// an index both discharge the bounds obligations and prove the +1/-1 steps exact
// (Omega's proof model). The token VALUES round-trip through array elements,
// which carry no range facts yet, so the value plumbing is declared Wrapping.
//
// Encoding: program[k] >= 0 pushes that value; negative codes are operators:
//   -1 = add, -2 = multiply, -3 = subtract.
//
//   program = [3, 4, -1, 5, -2]   // 3 4 + 5 *  ==  (3 + 4) * 5
// The program exits with the value it computed. Expected exit: 35.

use omega_language_std::console;

data Main {
    // Wrapping DECLARED (program/stack/tok/a/b/acc): the operand values flow
    // through array elements, which carry no range facts yet.
    program: [i32; 16] in Wrapping;
    nprog: i32;
    stack: [i32; 16] in Wrapping;
    sp: i32;
    pc: i32;
    tok: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    acc: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("rpn_calculator: evaluates the postfix program 3 4 + 5 * on an operand stack");
    main.program[0] = 3;
    main.program[1] = 4;
    main.program[2] = 0 - 1;
    main.program[3] = 5;
    main.program[4] = 0 - 2;
    main.nprog = 5;

    main.sp = 0;
    main.pc = 0;

    transition {
        _ -> loop(main)
    }

    // Loop while there are tokens left.
    state loop(main: &mut Main) {
        transition main.pc < main.nprog {
            true -> bound_check(main)
            _ -> finish(main)
        }
    }

    // Admit the program index only where it is provably in range.
    state bound_check(main: &mut Main) {
        transition main.pc >= 0 && main.pc < 16 {
            true -> load_token(main)
            _ -> finish(main)
        }
    }

    state load_token(main: &mut Main) {
        main.tok = main.program[main.pc];
        transition main.tok >= 0 {
            true -> push_bound(main)
            _ -> op_bound(main)
        }
    }

    // --- push a number ---
    state push_bound(main: &mut Main) {
        transition main.sp >= 0 && main.sp < 16 {
            true -> push_token(main)
            _ -> finish(main)
        }
    }
    state push_token(main: &mut Main) {
        main.stack[main.sp] = main.tok;
        main.sp = main.sp + 1;
        transition {
            _ -> advance(main)
        }
    }

    // --- apply a binary operator: pop b, pop a, push (a OP b) ---
    state op_bound(main: &mut Main) {
        transition main.sp >= 2 && main.sp <= 16 {
            true -> op_pop_b(main)
            _ -> finish(main)
        }
    }
    state op_pop_b(main: &mut Main) {
        main.sp = main.sp - 1;
        transition main.sp >= 0 && main.sp < 16 { true -> op_read_b(main) _ -> finish(main) }
    }
    state op_read_b(main: &mut Main) {
        main.b = main.stack[main.sp];
        transition main.sp >= 1 && main.sp <= 16 { true -> op_pop_a(main) _ -> finish(main) }
    }
    state op_pop_a(main: &mut Main) {
        main.sp = main.sp - 1;
        transition main.sp >= 0 && main.sp < 16 { true -> op_read_a(main) _ -> finish(main) }
    }
    state op_read_a(main: &mut Main) {
        main.a = main.stack[main.sp];
        transition {
            _ -> op_dispatch(main)
        }
    }

    // Decode the operator code and compute into `acc`.
    state op_dispatch(main: &mut Main) {
        transition main.tok == 0 - 1 {
            true -> op_add(main)
            _ -> op_dispatch_mul(main)
        }
    }
    state op_dispatch_mul(main: &mut Main) {
        transition main.tok == 0 - 2 {
            true -> op_mul(main)
            _ -> op_sub(main)
        }
    }
    state op_add(main: &mut Main) {
        main.acc = main.a + main.b;
        transition { _ -> op_guard(main) }
    }
    state op_mul(main: &mut Main) {
        main.acc = main.a * main.b;
        transition { _ -> op_guard(main) }
    }
    state op_sub(main: &mut Main) {
        main.acc = main.a - main.b;
        transition { _ -> op_guard(main) }
    }

    // The add/mul/sub arms join here, then a single re-guard puts `sp < 16` on
    // the one DIRECT edge into op_push -- the dominating-guard keystone is what
    // proves the `sp = sp + 1` after the result push. (After two pops sp <= 14,
    // so the else arm is unreachable.)
    state op_guard(main: &mut Main) {
        transition main.sp >= 0 && main.sp < 16 {
            true -> op_push(main)
            _ -> finish(main)
        }
    }

    // Push the result back (sp points at the freed slot after the two pops).
    state op_push(main: &mut Main) {
        main.stack[main.sp] = main.acc;
        main.sp = main.sp + 1;
        transition {
            _ -> advance(main)
        }
    }

    // Re-assert pc's headroom on the direct edge into the increment (pc < nprog
    // <= 16 always holds, so the else arm is unreachable).
    state advance(main: &mut Main) {
        transition main.pc < 16 {
            true -> bump(main)
            _ -> finish(main)
        }
    }
    state bump(main: &mut Main) {
        main.pc = main.pc + 1;
        transition {
            _ -> loop(main)
        }
    }

    state finish(main: &mut Main) {
        // The result is the bottom of the stack.
        Console::write_line("result: the RPN evaluation, 35 for this program (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.stack[0] as i32);
    }
}
