// A two-digit calculator -- a small but complete app that ties together everything
// needed to read and evaluate input. It parses the expression "12+34": the operands
// are read from the text through named widening, subtracting '0', and combining
// as tens*10+ones (the parse_number pattern); the operator is
// dispatched by indexing the operator byte in a guard (`text[2] == '+'` / `'-'`);
// and the result is computed with DECLARED Wrapping arithmetic (carrier byte
// reads carry no range facts yet, so a parse accumulator cannot prove its
// bounds -- decision 17 keeps the modular semantics honest). "12+34" -> 12 + 34 = 46.
// Supports '+' (exit a+b) and '-' (exit a-b); an unknown operator exits 0.
// Expected exit: 46.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    text: [u8; 8] in Utf8;
    // Wrapping DECLARED: parse accumulators over carrier bytes -- element reads
    // carry no range facts yet, so tens*10+ones cannot prove its bounds.
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    tmp: i32 in Wrapping;
    result: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("calculator: parse and evaluate the expression \"12+34\" from text bytes");
    main.text = "12+34";

    // First operand from text[0..1].
    main.a = widen_u8_to_i32(main.text[0]) as i32 in Wrapping;
    main.a = main.a - 48;
    main.a = main.a * 10;
    main.tmp = widen_u8_to_i32(main.text[1]) as i32 in Wrapping;
    main.tmp = main.tmp - 48;
    main.a = main.a + main.tmp;

    // Second operand from text[3..4].
    main.b = widen_u8_to_i32(main.text[3]) as i32 in Wrapping;
    main.b = main.b - 48;
    main.b = main.b * 10;
    main.tmp = widen_u8_to_i32(main.text[4]) as i32 in Wrapping;
    main.tmp = main.tmp - 48;
    main.b = main.b + main.tmp;

    // Dispatch on the operator byte text[2].
    transition main.text[2] == 43 {
        true -> do_add(main)
        _ -> check_sub(main)
    }

    state check_sub(main: &mut Main) {
        transition main.text[2] == 45 { true -> do_sub(main) _ -> unknown(main) }
    }

    state do_add(main: &mut Main) { main.result = main.a + main.b; transition { _ -> emit(main) } }
    state do_sub(main: &mut Main) { main.result = main.a - main.b; transition { _ -> emit(main) } }
    state unknown(main: &mut Main) {
        Console::write_line("FAIL: operator byte not '+' or '-' -- unknown operator (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state emit(main: &mut Main) {
        Console::write_line("result: the evaluated expression, 12+34 = 46 (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.result as i32);
    }
}
