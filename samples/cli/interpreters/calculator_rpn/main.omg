// Integer RPN (reverse-Polish notation) calculator over a fixed-capacity stack.
//
// Stack: [i32 in Saturating; 4], growing from index 0. `sp` is the next free index (0=empty).
// Supported operations: push(v), add, sub, mul.
//
// RPN expression: "32 4 + 2 * 2 -"
//   push 32     -> stack: [32],        sp=1
//   push 4      -> stack: [32,4],      sp=2
//   add         -> pop 4 and 32, push 36  -> stack: [36], sp=1
//   push 2      -> stack: [36,2],      sp=2
//   mul         -> pop 2 and 36, push 72  -> stack: [72], sp=1
//   push 2      -> stack: [72,2],      sp=2
//   sub         -> pop 2 and 72, push 70  -> stack: [70], sp=1
//   pop result  -> 70
//
// Design note: binary ops (add/sub/mul) dispatch on sp to read the top two
// stack elements directly via const-indexed reads, avoiding sub-machine calls
// between the reads and the subsequent write. This sidesteps the stale-static-
// fold shape where field reads after sub-machine calls may see cached values.
//
// Verification: result == 70 -> exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

data Stack [copy] {
    slots: [i32 in Saturating; 4];
    sp: i32 in Saturating;        // stack pointer: index of next free slot (0 = empty)
    result: i32 in Saturating;    // set by pop_result() to hold the final answer
}

data Main {
    console: Console;
    stack: Stack;
    pause: [u8; 256];
}

// ---------------------------------------------------------------------------
// push(value): write value at slots[sp], then sp++.
// Dispatches on sp so we can use const-indexed writes.
// ---------------------------------------------------------------------------
machine Main::push(&mut self, value: i32 in Saturating) {
    let s: i32 in Saturating = self.stack.sp;
    self.stack.sp = s + 1;
    self.write_slot(s, value);
}

machine Main::write_slot(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
    transition idx == 0 {
        true -> w0(value)
        _ -> try_w1(idx, value)
    }

    state w0(&mut self, value: i32 in Saturating) { self.stack.slots[0] = value; }

    state try_w1(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 1 {
            true -> w1(value)
            _ -> try_w2(idx, value)
        }
    }

    state w1(&mut self, value: i32 in Saturating) { self.stack.slots[1] = value; }

    state try_w2(&mut self, idx: i32 in Saturating, value: i32 in Saturating) {
        transition idx == 2 {
            true -> w2(value)
            _ -> w3(value)
        }
    }

    state w2(&mut self, value: i32 in Saturating) { self.stack.slots[2] = value; }
    state w3(&mut self, value: i32 in Saturating) { self.stack.slots[3] = value; }
}

// ---------------------------------------------------------------------------
// pop_result(): extract the single remaining value into self.stack.result.
// Only called when sp == 1 (one element on the stack).
// ---------------------------------------------------------------------------
machine Main::pop_result(&mut self) {
    self.stack.result = self.stack.slots[0];
    self.stack.sp = 0;
}

// ---------------------------------------------------------------------------
// add(): pop top two (b = slots[sp-1], a = slots[sp-2]), push a+b.
//
// We dispatch on sp so binary ops are expressed as const-indexed reads
// and direct writes with no intermediate sub-machine calls between the
// reads and the push computation. For this sample sp is always 2 when
// add/sub/mul is called, so only the sp==2 arm fires.
// ---------------------------------------------------------------------------
machine Main::add(&mut self) {
    transition self.stack.sp == 2 {
        true -> add_sp2()
        _ -> done()
    }

    state add_sp2(&mut self) {
        let a: i32 in Saturating = self.stack.slots[0];
        let b: i32 in Saturating = self.stack.slots[1];
        self.stack.sp = 1;
        self.stack.slots[0] = a + b;
    }

    state done(&mut self) {}
}

// ---------------------------------------------------------------------------
// sub(): a - b where a = slots[sp-2], b = slots[sp-1].
// ---------------------------------------------------------------------------
machine Main::sub(&mut self) {
    transition self.stack.sp == 2 {
        true -> sub_sp2()
        _ -> done()
    }

    state sub_sp2(&mut self) {
        let a: i32 in Saturating = self.stack.slots[0];
        let b: i32 in Saturating = self.stack.slots[1];
        self.stack.sp = 1;
        self.stack.slots[0] = a - b;
    }

    state done(&mut self) {}
}

// ---------------------------------------------------------------------------
// mul(): a * b where a = slots[sp-2], b = slots[sp-1].
// ---------------------------------------------------------------------------
machine Main::mul(&mut self) {
    transition self.stack.sp == 2 {
        true -> mul_sp2()
        _ -> done()
    }

    state mul_sp2(&mut self) {
        let a: i32 in Saturating = self.stack.slots[0];
        let b: i32 in Saturating = self.stack.slots[1];
        self.stack.sp = 1;
        self.stack.slots[0] = a * b;
    }

    state done(&mut self) {}
}

// ---------------------------------------------------------------------------
// main: evaluate "32 4 + 2 * 2 -" = 70.
// ---------------------------------------------------------------------------
machine Main::main(&mut self) {
    self.console.write_line("calculator_rpn: evaluate \"32 4 + 2 * 2 -\" on a fixed-capacity stack");
    self.push(32);
    self.push(4);
    self.add();       // stack: [36], sp=1

    self.push(2);
    self.mul();       // stack: [72], sp=1

    self.push(2);
    self.sub();       // stack: [70], sp=1

    // Extract result from slot 0.
    self.pop_result();

    // Verify the result is 70.
    transition self.stack.result == 70 {
        true -> check_sp()
        _ -> bad_result()
    }

    state check_sp(&mut self) {
        transition self.stack.sp == 0 {
            true -> good()
            _ -> bad_sp()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: (32+4)*2-2 == 70 and the stack drained to empty (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad_result(&mut self) {
        self.console.write_line("FAIL: RPN result != 70 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state bad_sp(&mut self) {
        self.console.write_line("FAIL: stack pointer != 0 after pop_result (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }
}
