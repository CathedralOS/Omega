// Stack calculator: evaluate (3 + 4) * 5 with an explicit operand stack -- the core
// of a bytecode VM / RPN evaluator. Demonstrates a bounded mutable stack pointer
// driving runtime-indexed reads and writes:
//
//   push v   ->  stack[sp] = v; sp = sp + 1     (guard sp < CAP first)
//   pop      ->  sp = sp - 1;   x = stack[sp]    (guard sp > 0 first)
//
// AUTHORING RECIPE: the stack pointer is `i32 [0..=8]`, fully Exact -- every
// push/pop step is guard-proven, because this sample already re-guards
// `sp >= 0 && sp < CAP` (or the pop-side `sp >= k && sp <= CAP`) on the DIRECT
// edge into each state that moves `sp`, which both discharges the index-bounds
// obligation and proves `sp + 1` / `sp - 1` land back inside the range. The
// operand VALUES flow through the stack array, and array elements carry no
// range facts yet, so the value plumbing (stack/a/b/acc) is declared Wrapping.
//
//   (3 + 4) * 5 = 35. The program exits with the value it computed.
// Expected exit: 35.

use omega_language_std::console;

data Main {
    console: Console;
    // Wrapping DECLARED (stack/a/b/acc): the operands round-trip through array
    // elements, which carry no range facts yet.
    stack: [i32; 8] in Wrapping;
    sp: i32 [0..=8];
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    acc: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("stack_calculator: evaluates (3 + 4) * 5 with an explicit operand stack");
    self.sp = 0;

    transition self.sp >= 0 && self.sp < 8 {
        true -> push_three()
        _ -> bad()
    }

    state push_three(&mut self) {
        self.stack[self.sp] = 3;
        self.sp = self.sp + 1;
        transition self.sp >= 0 && self.sp < 8 { true -> push_four() _ -> bad() }
    }

    state push_four(&mut self) {
        self.stack[self.sp] = 4;
        self.sp = self.sp + 1;
        transition self.sp >= 2 && self.sp <= 8 { true -> add_pop_b() _ -> bad() }
    }

    state add_pop_b(&mut self) {
        self.sp = self.sp - 1;
        transition self.sp >= 0 && self.sp < 8 { true -> add_read_b() _ -> bad() }
    }
    state add_read_b(&mut self) {
        self.b = self.stack[self.sp];
        transition self.sp >= 1 && self.sp <= 8 { true -> add_pop_a() _ -> bad() }
    }
    state add_pop_a(&mut self) {
        self.sp = self.sp - 1;
        transition self.sp >= 0 && self.sp < 8 { true -> add_read_a() _ -> bad() }
    }
    state add_read_a(&mut self) {
        self.a = self.stack[self.sp];
        self.acc = self.a + self.b;              // compute into a temp (a binary value
        self.stack[self.sp] = self.acc as i32;   // into an indexed target is unsupported)
        self.sp = self.sp + 1;
        transition self.sp >= 0 && self.sp < 8 { true -> push_five() _ -> bad() }
    }

    state push_five(&mut self) {
        self.stack[self.sp] = 5;
        self.sp = self.sp + 1;
        transition self.sp >= 2 && self.sp <= 8 { true -> mul_pop_b() _ -> bad() }
    }

    state mul_pop_b(&mut self) {
        self.sp = self.sp - 1;
        transition self.sp >= 0 && self.sp < 8 { true -> mul_read_b() _ -> bad() }
    }
    state mul_read_b(&mut self) {
        self.b = self.stack[self.sp];
        transition self.sp >= 1 && self.sp <= 8 { true -> mul_pop_a() _ -> bad() }
    }
    state mul_pop_a(&mut self) {
        self.sp = self.sp - 1;
        transition self.sp >= 0 && self.sp < 8 { true -> mul_read_a() _ -> bad() }
    }
    state mul_read_a(&mut self) {
        self.a = self.stack[self.sp];
        self.acc = self.a * self.b;              // compute into a temp, then push
        self.stack[self.sp] = self.acc as i32;
        transition self.sp >= 0 && self.sp < 8 { true -> done() _ -> bad() }
    }

    state done(&mut self) {
        self.console.write_line("result: (3 + 4) * 5 = 35 at the bottom of the stack (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.stack[0]);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: a stack-pointer bounds guard tripped (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
