// Stack calculator: evaluate (3 + 4) * 5 with an explicit operand stack -- the core
// of a bytecode VM / RPN evaluator. Demonstrates a bounded mutable stack pointer
// driving runtime-indexed reads and writes:
//
//   push v   ->  stack[sp] = v; sp = sp + 1     (guard sp < CAP first)
//   pop      ->  sp = sp - 1;   x = stack[sp]    (guard sp > 0 first)
//
// AUTHORING RECIPE: the stack pointer is a plain `i32`, fully Exact -- every
// push/pop step is guard-proven, because this sample already re-guards
// `sp >= 0 && sp < CAP` (or the pop-side `sp >= k && sp <= CAP`) on the DIRECT
// edge into each state that moves `sp`, which both discharges the index-bounds
// obligation and proves the `sp + 1` / `sp - 1` steps exact. The
// operand VALUES flow through the stack array, and array elements carry no
// range facts yet, so the value plumbing (stack/a/b/acc) is declared Wrapping.
//
//   (3 + 4) * 5 = 35. The program exits with the value it computed.
// Expected exit: 35.

use omega_language_std::console;

data Main {
    // Wrapping DECLARED (stack/a/b/acc): the operands round-trip through array
    // elements, which carry no range facts yet.
    stack: [i32; 8] in Wrapping;
    sp: i32;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    acc: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("stack_calculator: evaluates (3 + 4) * 5 with an explicit operand stack");
    main.sp = 0;

    transition main.sp >= 0 && main.sp < 8 {
        true -> push_three(main)
        _ -> bad(main)
    }

    state push_three(main: &mut Main) {
        main.stack[main.sp] = 3;
        main.sp = main.sp + 1;
        transition main.sp >= 0 && main.sp < 8 { true -> push_four(main) _ -> bad(main) }
    }

    state push_four(main: &mut Main) {
        main.stack[main.sp] = 4;
        main.sp = main.sp + 1;
        transition main.sp >= 2 && main.sp <= 8 { true -> add_pop_b(main) _ -> bad(main) }
    }

    state add_pop_b(main: &mut Main) {
        main.sp = main.sp - 1;
        transition main.sp >= 0 && main.sp < 8 { true -> add_read_b(main) _ -> bad(main) }
    }
    state add_read_b(main: &mut Main) {
        main.b = main.stack[main.sp];
        transition main.sp >= 1 && main.sp <= 8 { true -> add_pop_a(main) _ -> bad(main) }
    }
    state add_pop_a(main: &mut Main) {
        main.sp = main.sp - 1;
        transition main.sp >= 0 && main.sp < 8 { true -> add_read_a(main) _ -> bad(main) }
    }
    state add_read_a(main: &mut Main) {
        main.a = main.stack[main.sp];
        main.acc = main.a + main.b;              // compute into a temp (a binary value
        main.stack[main.sp] = main.acc;          // into an indexed target is unsupported)
        main.sp = main.sp + 1;
        transition main.sp >= 0 && main.sp < 8 { true -> push_five(main) _ -> bad(main) }
    }

    state push_five(main: &mut Main) {
        main.stack[main.sp] = 5;
        main.sp = main.sp + 1;
        transition main.sp >= 2 && main.sp <= 8 { true -> mul_pop_b(main) _ -> bad(main) }
    }

    state mul_pop_b(main: &mut Main) {
        main.sp = main.sp - 1;
        transition main.sp >= 0 && main.sp < 8 { true -> mul_read_b(main) _ -> bad(main) }
    }
    state mul_read_b(main: &mut Main) {
        main.b = main.stack[main.sp];
        transition main.sp >= 1 && main.sp <= 8 { true -> mul_pop_a(main) _ -> bad(main) }
    }
    state mul_pop_a(main: &mut Main) {
        main.sp = main.sp - 1;
        transition main.sp >= 0 && main.sp < 8 { true -> mul_read_a(main) _ -> bad(main) }
    }
    state mul_read_a(main: &mut Main) {
        main.a = main.stack[main.sp];
        main.acc = main.a * main.b;              // compute into a temp, then push
        main.stack[main.sp] = main.acc;
        transition main.sp >= 0 && main.sp < 8 { true -> done(main) _ -> bad(main) }
    }

    state done(main: &mut Main) {
        Console::write_line("result: (3 + 4) * 5 = 35 at the bottom of the stack (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.stack[0] as i32);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: a stack-pointer bounds guard tripped (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
