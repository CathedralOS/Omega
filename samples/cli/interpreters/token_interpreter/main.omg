// Token interpreter: a small state machine that mixes equality guards,
// range guards (> N), and case-payload guards in the same transitions.
//
// Exercises: three different guard shapes in one transition block --
// equality (== N), range (> N), and case-member dispatch -- plus a running
// accumulator that depends on which guard arm fires.
//
// Token type:
//   Literal(value: i32 in Saturating)  -- contributes `value` to accumulator
//   Add                  -- doubles the current accumulator
//   Clamp(max: i32 in Saturating)      -- caps accumulator at max if over
//
// A small "interpreter" processes a fixed sequence of tokens:
//   Literal(10)  -> acc = 10
//   Add          -> acc = 20
//   Literal(5)   -> acc = 25
//   Clamp(30)    -> acc stays 25 (25 <= 30, no clamp)
//   Add          -> acc = 50
//   Literal(20)  -> acc = 70
//
// Final check: acc == 70 -> exit 70.
// Per-token the dispatch mixes:
//   - case dispatch on the token type (case-payload guard)
//   - range guard on Add (acc > 0 picks one path, else another -- no-op here)
//   - equality guard on Clamp (acc == max -> exact match path vs over path)
//
// Expected exit: 70.

use omega_language_std::console;

data Token {
    case Literal(value: i32 in Saturating);
    case Add;
    case Clamp(max: i32 in Saturating);
}

data Interp [copy] {
    acc: i32 in Saturating;
}

data Main {
    interp: Interp;
    pause: [u8; 256];
}

// Execute one token on the interpreter state.
// Mixes: case-payload dispatch, equality guard (acc == max), range guard (acc > 0).
machine Main::exec(main: &mut Main, tok: Token) {
    transition tok {
        Token::Literal { value } -> do_literal(main, value)
        Token::Add -> do_add(main)
        Token::Clamp { max } -> do_clamp(main, max)
        _ -> done()
    }

    // Literal: add value to accumulator.
    state do_literal(main: &mut Main, value: i32 in Saturating) {
        main.interp.acc = main.interp.acc + value;
    }

    // Add: double the accumulator.
    // Uses a range guard: if acc > 0, we do a "real" double; otherwise no-op.
    state do_add(main: &mut Main) {
        transition main.interp.acc > 0 {
            true -> real_double(main)
            _ -> done()
        }
    }

    state real_double(main: &mut Main) {
        main.interp.acc = main.interp.acc * 2;
    }

    // Clamp: cap accumulator at max.
    // Uses an equality guard (exact match path) AND a range guard (over path).
    state do_clamp(main: &mut Main, max: i32 in Saturating) {
        transition main.interp.acc == max {
            true -> clamp_exact(main, max)
            _ -> check_over(main, max)
        }
    }

    state clamp_exact(main: &mut Main, max: i32 in Saturating) {
        // Already at the max; no change needed.
        main.interp.acc = max;
    }

    state check_over(main: &mut Main, max: i32 in Saturating) {
        transition main.interp.acc > max {
            true -> apply_clamp(main, max)
            _ -> done()
        }
    }

    state apply_clamp(main: &mut Main, max: i32 in Saturating) {
        main.interp.acc = max;
    }

    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("token_interpreter: mixed guard shapes run a literal/add/clamp token script");
    // Scripted token sequence:
    // Literal(10) -> acc=10; Add -> acc=20; Literal(5) -> acc=25;
    // Clamp(30) -> acc=25 (no clamp); Add -> acc=50; Literal(20) -> acc=70.
    Main::exec(main, Token::Literal { value: 10 });
    Main::exec(main, Token::Add);
    Main::exec(main, Token::Literal { value: 5 });
    Main::exec(main, Token::Clamp { max: 30 });
    Main::exec(main, Token::Add);
    Main::exec(main, Token::Literal { value: 20 });

    transition main.interp.acc == 70 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: the token script left the accumulator at 70 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::write_line("FAIL: the final accumulator was not 70 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
