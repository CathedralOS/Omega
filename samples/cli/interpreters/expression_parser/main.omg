// Expected exit: 9.
// An infix expression evaluator: "2*(3+4)-5" is parsed with operator
// precedence and parentheses and evaluated to 9, the exit code.
//
// Omega runs recursion only in tail position (runtime call cycles lower to
// constant-stack loops), so this is the explicit-stack form a recursive
// descent parser takes here: Dijkstra's shunting-yard with two fixed stacks.
// Digits push onto the value stack; '(' and operators push onto the operator
// stack; an operator first applies every stacked operator of equal or higher
// precedence; ')' applies back to its '('; the end applies the rest. One
// shared `apply` state pops two values and an operator and pushes the result,
// then returns to whichever loop asked for it. Malformed text exits 1.
//
// Bytes: '(' 40, ')' 41, '*' 42, '+' 43, '-' 45, '0'..'9' 48..57.

use omega_language_std::console;
use omega::language::core::binding;

// Where `apply` returns once it has reduced one operator.
data Resume {
    case Close;
    case Operator;
    case Drain;
}

data Main {
    console: Binding<Console>;
    text: [u8; 16];
    length: u64;
    position: u64;
    byte: u8;
    // Wrapping DECLARED: values round-trip through array elements, which
    // carry no range facts.
    values: [i32; 16] in Wrapping;
    value_count: u64;
    operators: [u8; 16];
    operator_count: u64;
    resume: Resume;
}

machine precedence(operator: u8) -> u64 {
    transition operator == 42 {
        true -> high()
        _ -> additive(operator)
    }
    state high() -> u64 { 2 }
    state additive(operator: u8) -> u64 {
        transition operator == 43 || operator == 45 {
            true -> low()
            _ -> none()
        }
    }
    state low() -> u64 { 1 }
    state none() -> u64 { 0 }
}

machine Main::main(main: &mut Main) reaches Console {
    // "2*(3+4)-5"
    main.text[0] = 50;
    main.text[1] = 42;
    main.text[2] = 40;
    main.text[3] = 51;
    main.text[4] = 43;
    main.text[5] = 52;
    main.text[6] = 41;
    main.text[7] = 45;
    main.text[8] = 53;
    main.length = 9;
    main.position = 0;
    main.value_count = 0;
    main.operator_count = 0;
    transition { _ -> scan(main) }

    state scan(main: &mut Main) {
        transition main.position < main.length && main.position < 16 {
            true -> read(main)
            _ -> drain(main)
        }
    }

    state read(main: &mut Main) {
        main.byte = main.text[main.position];
        transition main.byte >= 48 && main.byte <= 57 {
            true -> push_digit(main)
            _ -> punctuation(main)
        }
    }

    state punctuation(main: &mut Main) {
        transition main.byte == 40 {
            true -> push_open(main)
            _ -> close_or_operator(main)
        }
    }

    state close_or_operator(main: &mut Main) {
        transition main.byte == 41 {
            true -> close(main)
            _ -> operator(main)
        }
    }

    state push_digit(main: &mut Main) {
        transition main.value_count < 16 && main.position < 16 {
            true -> store_digit(main)
            _ -> malformed(&main.console)
        }
    }

    state store_digit(main: &mut Main) {
        let digit: i32 in Wrapping = main.byte as i32 in Wrapping;
        main.values[main.value_count] = digit - 48;
        main.value_count = main.value_count + 1;
        main.position = main.position + 1;
        transition { _ -> scan(main) }
    }

    state push_open(main: &mut Main) {
        transition main.operator_count < 16 && main.position < 16 {
            true -> store_open(main)
            _ -> malformed(&main.console)
        }
    }

    state store_open(main: &mut Main) {
        main.operators[main.operator_count] = 40;
        main.operator_count = main.operator_count + 1;
        main.position = main.position + 1;
        transition { _ -> scan(main) }
    }

    // ')' applies stacked operators back to the matching '('.
    state close(main: &mut Main) {
        transition main.operator_count >= 1 && main.operator_count <= 16 {
            true -> close_top(main)
            _ -> malformed(&main.console)
        }
    }

    state close_top(main: &mut Main) {
        transition main.operators[main.operator_count - 1] == 40 {
            true -> pop_open(main)
            _ -> close_apply(main)
        }
    }

    state close_apply(main: &mut Main) {
        main.resume = Resume::Close;
        transition { _ -> apply(main) }
    }

    state pop_open(main: &mut Main) {
        transition main.operator_count >= 1 && main.position < 16 {
            true -> after_open(main)
            _ -> malformed(&main.console)
        }
    }

    state after_open(main: &mut Main) {
        main.operator_count = main.operator_count - 1;
        main.position = main.position + 1;
        transition { _ -> scan(main) }
    }

    // An operator first applies every stacked operator that binds at least
    // as tightly, then stacks itself.
    state operator(main: &mut Main) {
        transition main.operator_count >= 1 && main.operator_count <= 16 {
            true -> operator_top(main)
            _ -> push_operator(main)
        }
    }

    state operator_top(main: &mut Main) {
        let top: u8 = main.operators[main.operator_count - 1];
        transition top != 40 && precedence(top) >= precedence(main.byte) {
            true -> operator_apply(main)
            _ -> push_operator(main)
        }
    }

    state operator_apply(main: &mut Main) {
        main.resume = Resume::Operator;
        transition { _ -> apply(main) }
    }

    state push_operator(main: &mut Main) {
        transition main.operator_count < 16 && main.position < 16 {
            true -> store_operator(main)
            _ -> malformed(&main.console)
        }
    }

    state store_operator(main: &mut Main) {
        main.operators[main.operator_count] = main.byte;
        main.operator_count = main.operator_count + 1;
        main.position = main.position + 1;
        transition { _ -> scan(main) }
    }

    // The end of the text applies every operator still stacked.
    state drain(main: &mut Main) {
        transition main.operator_count >= 1 {
            true -> drain_apply(main)
            _ -> finish(main)
        }
    }

    state drain_apply(main: &mut Main) {
        main.resume = Resume::Drain;
        transition { _ -> apply(main) }
    }

    // Pop two values and one operator, push the result, and return to the
    // loop that asked.
    state apply(main: &mut Main) {
        transition main.value_count >= 2 && main.value_count <= 16
            && main.operator_count >= 1 && main.operator_count <= 16 {
            true -> reduce(main)
            _ -> malformed(&main.console)
        }
    }

    state reduce(main: &mut Main) {
        let right: i32 in Wrapping = main.values[main.value_count - 1];
        let left: i32 in Wrapping = main.values[main.value_count - 2];
        let operator: u8 = main.operators[main.operator_count - 1];
        main.operator_count = main.operator_count - 1;
        main.value_count = main.value_count - 1;
        transition operator == 42 {
            true -> store_result(main, left * right)
            _ -> additive_result(main, operator, left, right)
        }
    }

    state additive_result(main: &mut Main, operator: u8, left: i32 in Wrapping, right: i32 in Wrapping) {
        transition operator == 43 {
            true -> store_result(main, left + right)
            _ -> store_result(main, left - right)
        }
    }

    state store_result(main: &mut Main, result: i32 in Wrapping) {
        transition main.value_count >= 1 && main.value_count <= 16 {
            true -> write_result(main, result)
            _ -> malformed(&main.console)
        }
    }

    state write_result(main: &mut Main, result: i32 in Wrapping) {
        main.values[main.value_count - 1] = result;
        transition main.resume {
            Resume::Close -> close(main)
            Resume::Operator -> operator(main)
            Resume::Drain -> drain(main)
        }
    }

    state finish(main: &mut Main) {
        transition main.value_count == 1 {
            true -> report(main)
            _ -> malformed(&main.console)
        }
    }

    state report(main: &mut Main) {
        main.console.write_line("expression_parser: 2*(3+4)-5");
        let result: i32 in Wrapping = main.values[0];
        main.console.exit_process(result as i32);
    }

    state malformed(console: &Binding<Console>) {
        Console::exit_process(console, 1);
    }
}
