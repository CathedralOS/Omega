use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Package { name: "scalar_lending_producer" };
    Build::select_provider::<|app|::Lending, |app|::Writer>(builder, linux_x86_64);
    Build::select_provider::<|app|::Observation, |app|::NoObservation>(builder, linux_x86_64);
    Build::select_provider::<|app|::Reading, |app|::Reader>(builder, linux_x86_64);
    Build::select_provider::<|app|::Lending, |app|::Writer>(builder, windows_x86_64);
    Build::select_provider::<|app|::Observation, |app|::NoObservation>(builder, windows_x86_64);
    Build::select_provider::<|app|::Reading, |app|::Reader>(builder, windows_x86_64);
    Build::select_provider::<|app|::Lending, |app|::Writer>(builder, macos_arm64);
    Build::select_provider::<|app|::Observation, |app|::NoObservation>(builder, macos_arm64);
    Build::select_provider::<|app|::Reading, |app|::Reader>(builder, macos_arm64);
    Build::select_provider::<|app|::Lending, |app|::Writer>(builder, linux_arm64);
    Build::select_provider::<|app|::Observation, |app|::NoObservation>(builder, linux_arm64);
    Build::select_provider::<|app|::Reading, |app|::Reader>(builder, linux_arm64);
}
