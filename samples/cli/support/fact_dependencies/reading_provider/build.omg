use main/provider.omg;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Package { name: "reading_provider" };
    configure::<true, (8u64 + 9u64)>(builder);
}
machine configure<const Flag: bool, const Tag: u64>(builder: @mutable BuildPlan) {
    Build::select_provider::<|provider|::Reading<Tag>, |provider|::FirstReading<[|provider|::Holder<u64>; 2], Tag>>(builder, windows_x86_64);
    Build::select_provider::<|provider|::Reading<Tag>, |provider|::FirstReading<[|provider|::Holder<u64>; 2], Tag>>(builder, macos_x86_64);
    Build::select_provider::<|provider|::Reading<Tag>, |provider|::FirstReading<[|provider|::Holder<u64>; 2], Tag>>(builder, linux_x86_64);
    Build::select_provider::<|provider|::Reading<Tag>, |provider|::SecondReading<[|provider|::Holder<u32>; 2], Tag>>(builder, macos_arm64);
    Build::select_provider::<|provider|::Reading<Tag>, |provider|::SecondReading<[|provider|::Holder<u32>; 2], Tag>>(builder, linux_arm64);
}
