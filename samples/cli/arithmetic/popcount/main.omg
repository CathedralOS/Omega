// Population count (Hamming weight) -- the number of set bits in a word, via the
// classic shift-and-mask loop. It composes three things this language now has:
// a bounded self-transition loop, the bitwise AND (`& 1` tests the low bit), and
// the LOGICAL right shift (`>> 1` over an unsigned word feeds the next bit in,
// never sign-extending). Counting 0xDEADBEEF yields 24 set bits.
//
//   while x != 0:
//       count += x & 1     // add the low bit
//       x >>= 1            // shift the next bit down
//
// `x` is `u32 in Wrapping` so the unsigned `>>` is logical and the loop always
// terminates (a signed/arithmetic `>>` on a high-bit value would spin forever).
// Expected exit: 24.

use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    pause: [u8; 256];
    x: u32 in Wrapping;
    bit: u32 in Wrapping;
    count: u32 in Wrapping;
    result: i32;
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("popcount: counting the set bits of 0xDEADBEEF by shift-and-mask");
    self.x = 3735928559; // 0xDEADBEEF
    self.count = 0;

    transition {
        _ -> step(&mut self)
    }

    // Loop head: stop once every bit has been shifted out.
    state step(main: &mut Main) {
        transition main.x == 0 {
            true -> done(main)
            _ -> count_bit(main)
        }
    }

    // Loop body: accumulate the low bit, then shift it away.
    state count_bit(main: &mut Main) {
        main.bit = main.x & 1;
        main.count = main.count + main.bit;
        main.x = main.x >> 1;
        transition {
            _ -> step(main)
        }
    }

    state done(main: &mut Main) {
        main.result = narrow_u32_to_i32_trapping(main.count as u32);
        main.console.write_line("result: the population count, 24 for 0xDEADBEEF (the exit code)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(main.result);
    }
}
