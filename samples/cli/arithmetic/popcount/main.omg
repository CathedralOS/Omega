// Population count (Hamming weight) -- the number of set bits in a word, via the
// classic shift-and-mask loop. It composes three things this language now has:
// a bounded state-transition loop, the bitwise AND (`& 1` tests the low bit), and
// the LOGICAL right shift (`>> 1` over an unsigned word feeds the next bit in,
// never sign-extending). Counting 0xDEADBEEF yields 24 set bits.
//
//   while x != 0:
//       count += x & 1     // add the low bit
//       x >>= 1            // shift the next bit down
//
// `word` is `u32 in Wrapping` so the unsigned `>>` is logical and the loop always
// terminates (a signed/arithmetic `>>` on a high-bit value would spin forever).
// Expected exit: 24.

use {system}/console.omg as console;
use {omega}/language/core/process_authority.omg as streams;
use {omega}/language/core/process_exit.omg as process;
use {omega}/language/core/numeric_conversion.omg as numeric;

public machine main()
reaches |process|::ProcessExit + |streams|::StandardInput + |streams|::StandardOutput
blocks
{
    |console|::Console::write_line("popcount: counting the set bits of 0xDEADBEEF by shift-and-mask");
    let count: u32 = population_count(3735928559);
    let result: i32 = |numeric|::narrow_u32_to_i32_trapping(count);
    |console|::Console::write_line("result: the population count, 24 for 0xDEADBEEF (the exit code)");
    |console|::Console::write_line("[press Enter to close]");
    let mutable pause: [u8; 256];
    _ = block |console|::Console::read_line(@mutable pause[..]);
    |process|::ProcessExit::exit_process(result);
}

machine population_count(word: u32) -> u32 {
    step(word as +Wrapping, 0 as +Wrapping)

    machine step(remaining: u32 in Wrapping, count: u32 in Wrapping) -> u32 {
        transition remaining == 0 {
            true -> count as -Wrapping,
            _ -> step(remaining >> 1, count + (remaining & 1))
        }
    }
}
