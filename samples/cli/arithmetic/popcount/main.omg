// Population count (Hamming weight) -- the number of set bits in a word, via the
// classic shift-and-mask loop. It composes three things this language now has:
// a bounded state-transition loop, the bitwise AND (`& 1` tests the low bit), and
// the LOGICAL right shift (`>> 1` over an unsigned word feeds the next bit in,
// never sign-extending). Counting 0xDEADBEEF yields 24 set bits.
//
//   while x != 0:
//       count += x & 1     // add the low bit
//       x >>= 1            // shift the next bit down
//
// `word` is `u32 in Wrapping` so the unsigned `>>` is logical and the loop always
// terminates (a signed/arithmetic `>>` on a high-bit value would spin forever).
// Expected exit: 24.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

machine main() reaches Console {
    Console::write_line("popcount: counting the set bits of 0xDEADBEEF by shift-and-mask");

    transition {
        _ -> step(3735928559, 0) // 0xDEADBEEF
    }

    // Loop head: stop once every bit has been shifted out.
    state step(word: u32 in Wrapping, count: u32 in Wrapping) {
        transition word == 0 {
            true -> done(count)
            _ -> count_bit(word, count)
        }
    }

    // Loop body: accumulate the low bit, then shift it away.
    state count_bit(word: u32 in Wrapping, count: u32 in Wrapping) {
        let bit: u32 in Wrapping = word & 1;
        let next_count: u32 in Wrapping = count + bit;
        let next_word: u32 in Wrapping = word >> 1;
        transition {
            _ -> step(next_word, next_count)
        }
    }

    state done(count: u32 in Wrapping) {
        let result: i32 = narrow_u32_to_i32_trapping(count as u32);
        Console::write_line("result: the population count, 24 for 0xDEADBEEF (the exit code)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(result);
    }
}
