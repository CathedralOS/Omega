// Population-count sample with console input, console output, and process exit.

use main.omg as app;
use {omega}/build/dependency.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "popcount" };
    let allowed: [BoundaryServiceReference; 3] = [
        Build::service::<|process_authority|::StandardInput>(builder),
        Build::service::<|process_authority|::StandardOutput>(builder),
        Build::service::<|process_exit|::ProcessExit>(builder)
    ];
    let adapter: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../../../source/library/system" });
    _ = |dependency|::add(builder, adapter, @allowed[..]);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
