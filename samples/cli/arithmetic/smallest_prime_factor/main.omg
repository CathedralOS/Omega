// Smallest prime factor by trial division. Walk d = 2, 3, 4, ... and return the
// first d that divides n; if d * d ever exceeds n with no divisor found, n is
// prime and is its own smallest factor. For n = 169 (= 13 * 13) the answer is 13:
// 2..12 leave a remainder, then 13 * 13 = 169 is not yet past n, and 169 % 13 == 0.
//
// The loop's two decisions both put ARITHMETIC directly in the transition guard:
// `d * d > n` (multiply) and `n % d == 0` (modulo). Modulo/division in a guard
// subject was wired in main 82822548 -- this sample exercises it in a real
// algorithm rather than a canary.
// Expected exit: 13.

use omega_language_std::console;

// The complete owner predicate bounds the square to 40000. Divisor-nonzero
// requirements belong to the invoked trial steps; zero remains a valid owner.
data Trial [copy]
requires self.n >= 0 && self.n <= 1000,
    self.d >= 0 && self.d <= 200
{
    n: i32;
    d: i32;
}

data Main {
    trial: Trial;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("smallest_prime_factor: trial division finds the smallest factor of 169");
    main.trial.n = 169;
    main.trial.d = 2;

    transition {
        _ -> block probe(main)
    }

    // The owner bounds the square; call admission independently proves d != 0.
    machine probe(main: &mut Main)
    requires main.trial.d > 0
    {
        transition main.trial.d * main.trial.d > main.trial.n {
            true -> block prime(main)
            _ -> block test_divisor(main)
        }
    }

    // Does the current d divide n? (modulo in the guard subject)
    machine test_divisor(main: &mut Main)
    requires main.trial.d > 0
    {
        transition main.trial.n % main.trial.d == 0 {
            true -> block found(main)
            _ -> block adv_guard(main)
        }
    }

    // Re-assert d's headroom right before the increment: the `d < 200` guard on
    // the direct edge into `advance` proves `d + 1` remains in 0..=200.
    // (d never nears 200 -- the probe stops at sqrt(n) -- so the else arm is
    // unreachable and routes to prime() as the give-up answer.)
    machine adv_guard(main: &mut Main) {
        transition main.trial.d < 200 {
            true -> block advance(main)
            _ -> block prime(main)
        }
    }

    machine advance(main: &mut Main) {
        main.trial.d = main.trial.d + 1;
        transition {
            _ -> block probe(main)
        }
    }

    machine found(main: &mut Main) {
        Console::write_line("PASS: smallest prime factor found, 13 for n=169 (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.trial.d);
    }

    machine prime(main: &mut Main) {
        Console::write_line("result: n has no divisor up to sqrt(n), so n is prime and exits as its own factor (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.trial.n);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
