// The canonical nested-boolean predicate, straight into a transition guard: a year
// is a leap year when it is divisible by 4 AND not by 100, OR it is divisible by 400.
//   (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
// This is a disjunction of conjunctions (DNF) with modulo comparisons -- exactly the
// boolean-guard-nesting + arithmetic-guard-subject shapes the compiler now lowers
// directly (no bool-field workaround). The guard build distributes any And-of-Or to
// DNF, and modulo/`&&`/`||` all evaluate as native guard operands.
//
// The sample classifies the year 2000 (divisible by 400 -> leap) and exits 1. Try
// editing `self.year` to 1900 (divisible by 100, not 400 -> common, exit 0), 2024
// (divisible by 4, not 100 -> leap, exit 1), or 2023 (-> common, exit 0).
// Expected exit: 1.

boundary trait Console {
    machine write_line(text: String);
    machine read_line(out_line: &mut String);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    year: i32 in Wrapping;
    pause: String;
}

machine Main::main(&mut self) {
    self.console.write_line("leap_year: is a year a leap year? (year%4==0 && year%100!=0) || year%400==0");
    self.year = 2000;

    // The leap-year test as ONE nested-boolean guard subject over modulo compares.
    transition (self.year % 4 == 0 && self.year % 100 != 0) || self.year % 400 == 0 {
        true -> leap()
        _ -> common()
    }

    state leap(&mut self) {
        self.console.write_line("result: LEAP year (exit 1)");
        transition { _ -> done_leap() }
    }
    state common(&mut self) {
        self.console.write_line("result: common year (exit 0)");
        transition { _ -> done_common() }
    }

    state done_leap(&mut self) {
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(1);
    }
    state done_common(&mut self) {
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(0);
    }
}
