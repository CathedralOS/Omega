use omega_language_std::math;

// Running min/max/range over a stream of float readings -- the everyday shape
// of sensor telemetry (thermostat, ADC, gauge). It exercises the numeric
// intrinsics that `vector_distance` does NOT drive directly: `min` and `max`
// applied straight to floats (there they only appear via the abs/clamp
// desugar), and `clamp` with FLOAT bounds (there it clamps an int). The running
// extremes fold the "is this bigger/smaller?" branch into the builtin, so the
// scan body has no per-element guard of its own.
//
//   lo = hi = nums[0]
//   for i in 1..N: lo = min(lo, nums[i]); hi = max(hi, nums[i])
//   range = hi - lo;  banded = clamp(hi, 0, 25)
//
// Over [20.5, 18.0, 24.5, 22.0, 19.5, 26.0]: lo = 18, hi = 26, range = 8, and
// clamp(26, 0, 25) pins the peak down to 25 (a real clamp, not an identity).
// The exit code sums both so a miscompile in EITHER the min/max fold or the
// float clamp changes it: range + banded = 8 + 25 = 33.
// Expected exit: 33.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    nums: [f64; 6];
    i: i32;
    cur: f64;
    lo: f64;
    hi: f64;
    range: f64;
    banded: f64;
    total: f64;
    result: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("sensor_min_max: track running min/max/range over [20.5, 18, 24.5, 22, 19.5, 26]");
    main.nums[0] = 20.5;
    main.nums[1] = 18.0;
    main.nums[2] = 24.5;
    main.nums[3] = 22.0;
    main.nums[4] = 19.5;
    main.nums[5] = 26.0;

    // Seed both extremes with the first reading, then fold in the rest.
    main.lo = main.nums[0];
    main.hi = main.nums[0];
    main.i = 1;

    transition {
        _ -> step(main)
    }

    // Loop head: fold readings until every element has been visited.
    state step(main: &mut Main) {
        transition main.i < 6 {
            true -> body(main)
            _ -> done(main)
        }
    }

    // The extremes update unconditionally: `min`/`max` ARE the branch, applied
    // straight to floats (the minsd/maxsd path, not an abs/clamp desugar).
    state body(main: &mut Main) {
        main.cur = main.nums[main.i];
        main.lo = min_f64(main.lo, main.cur);
        main.hi = max_f64(main.hi, main.cur);
        transition {
            _ -> advance(main)
        }
    }

    // Re-guard before the increment: the `i < 6` fact on the DIRECT edge into
    // `bump` proves `i + 1` cannot overflow -- fully Exact, no domain.
    state advance(main: &mut Main) {
        transition main.i < 6 {
            true -> bump(main)
            _ -> step(main)
        }
    }

    state bump(main: &mut Main) {
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }

    state done(main: &mut Main) {
        // range = hi - lo = 26 - 18 = 8.
        main.range = main.hi - main.lo;
        // A float clamp with float bounds: clamp(26, 0, 25) = 25 (clamps down).
        main.banded = clamp_f64(main.hi, 0.0, 25.0);
        // Sum both so the exit reflects the min/max fold AND the float clamp.
        main.total = main.range + main.banded;
        // A named saturating conversion truncates the float, then the policy erases.
        let converted: i32 in Saturating = I32::from_f64(main.total);
        main.result = converted as i32;

        Console::write_line("result: range(8) + clamp(peak,0,25)=25 -> 33 (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.result);
    }
}
