// LED channel mixer -- brightness math that cannot overflow. Decision-17
// SATURATING domains do the clamping in the TYPE, not in hand-written guards:
// two light sources sum onto a u8 channel and clamp at full brightness (255),
// a dim step underflows and clamps to fully-off (0), a gamma boost multiplies
// with the same clamp, and the frame counter is `in Wrapping` -- rolling over
// is its job. The plain-`u8` ambient reading joins the saturating math
// through a decision-17 S2 retag (`as u8 in Saturating`); the final guard
// computes fused saturating arithmetic directly in its comparison.
//
// Each stage re-establishes the values it measures, so nothing is live across
// a state edge and every reading is an ordinary local.
// Expected exit: 70.
use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    // Two bright sources: 180 + 140 = 320 -> clamps at full brightness.
    let source_a: u8 in Saturating = 180;
    let source_b: u8 in Saturating = 140;
    let channel: u8 in Saturating = source_a + source_b;
    transition channel == 255 { true -> dim() _ -> wrong_mix() }

    state dim() {
        // Dimming below zero stays off, never wraps to bright.
        let mut channel: u8 in Saturating = 40;
        channel = channel - 90;
        transition channel == 0 { true -> gamma() _ -> wrong_dim() }
    }
    state gamma() {
        // Gamma boost: 100 * 3 = 300 -> clamps at full brightness.
        let mut channel: u8 in Saturating = 100;
        channel = channel * 3;
        transition channel == 255 { true -> ambient_mix() _ -> wrong_gamma() }
    }
    state ambient_mix() {
        // A plain (exact) sensor reading joins saturating math via the S2
        // retag, and the arithmetic runs FUSED in the guard -- no stored
        // intermediate, the clamp happens at the operation itself.
        let channel: u8 in Saturating = 200;
        let ambient: u8 = 100;
        transition ((ambient as u8 in Saturating) + channel == 255) {
            true -> frame_roll()
            _ -> wrong_ambient()
        }
    }
    state frame_roll() {
        // The frame counter WRAPS by design: 250 + 10 rolls to 4.
        let mut frames: u8 in Wrapping = 250;
        frames = frames + 10;
        transition frames == 4 { true -> done() _ -> wrong_roll() }
    }

    state done() {
        Console::write_line("mix stable: channel clamps, counter rolls");
        Console::exit_process(70);
    }
    state wrong_mix() { Console::exit_process(71); }
    state wrong_dim() { Console::exit_process(72); }
    state wrong_gamma() { Console::exit_process(73); }
    state wrong_ambient() { Console::exit_process(74); }
    state wrong_roll() { Console::exit_process(75); }
}
