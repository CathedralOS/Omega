// Statistics compute kernel. Exercises f64 arithmetic end-to-end: mean,
// variance, and a weighted sum over a small fixed dataset.
//
// Dataset (5 samples):  2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0
//   (8 values, mean = 40.0/8 = 5.0, variance = sum((xi-mean)^2)/N = 4.0)
//
// To stay within the working float surface (avoid the known arr[i]+arr[j]
// binary bug) we accumulate using repeated machine calls that each add one
// value to a running total field, rather than summing array elements directly.
//
// Verification ladder:
//   mean  == 5.0  => mean - 5.0 == 0.0 within 0.01
//   variance == 4.0  => variance > 3.9 && variance < 4.1
//   weighted sum == 43.0 (weights: 1.0, 1.0, 1.5, 1.5, 2.0, 2.0, 2.5, 3.0)
//
// Each check narrows via guard ladder (cannot exit with float directly).
// Final exit: 70.
//
// Expected exit: 70.

use omega::language::core::float_operations;
use omega_language_std::console;

data Stats [copy] {
    // Running accumulator for sum and sum-of-squares.
    sum: f64;
    sum_sq_dev: f64;
    // Ranged + the modular-counter idiom at the increment: Exact-provable, no
    // overflow domain.
    count: i32 [0..=100];
    mean: f64;
    variance: f64;
    weighted_sum: f64;
}

data Main {
    console: Console;
    s: Stats;
    pause: [u8; 256];
}

// Add one value to the running sum.
machine Main::add(&mut self, x: f64) {
    self.s.sum = self.s.sum + x;
    self.s.count = (self.s.count + 1) % 101;
}

// Finalize mean = sum / count.
machine Main::finalize_mean(&mut self) {
    // count is 8; divide by storing quotient manually to avoid float/int division.
    // sum = 40.0; mean = 5.0
    self.s.mean = self.s.sum * 0.125;  // multiply by 1/8
}

// Add the squared deviation (xi - mean)^2 to sum_sq_dev.
machine Main::add_dev(&mut self, xi: f64) {
    let dev: f64 = xi - self.s.mean;
    let sq: f64 = dev * dev;
    self.s.sum_sq_dev = self.s.sum_sq_dev + sq;
}

// Finalize variance = sum_sq_dev / count.
machine Main::finalize_variance(&mut self) {
    // sum_sq_dev = 32.0; variance = 32.0 / 8 = 4.0
    self.s.variance = self.s.sum_sq_dev * 0.125;
}

// Add one weighted value to weighted_sum.
machine Main::add_weighted(&mut self, x: f64, w: f64) {
    self.s.weighted_sum = self.s.weighted_sum + x * w;
}

machine Main::main(&mut self) {
    self.console.write_line("stats_compute: f64 mean, variance, and weighted sum over 8 samples");
    // Phase 1: accumulate the 8 data values.
    self.add(2.0);
    self.add(4.0);
    self.add(4.0);
    self.add(4.0);
    self.add(5.0);
    self.add(5.0);
    self.add(7.0);
    self.add(9.0);

    // Finalize mean.
    self.finalize_mean();

    // Phase 2: compute squared deviations from the mean (mean = 5.0).
    // (2-5)^2 = 9, (4-5)^2=1 x3, (5-5)^2=0 x2, (7-5)^2=4, (9-5)^2=16
    // sum = 9+1+1+1+0+0+4+16 = 32; variance = 32/8 = 4.0
    self.add_dev(2.0);
    self.add_dev(4.0);
    self.add_dev(4.0);
    self.add_dev(4.0);
    self.add_dev(5.0);
    self.add_dev(5.0);
    self.add_dev(7.0);
    self.add_dev(9.0);

    self.finalize_variance();

    // Phase 3: weighted sum.
    // 2*1+4*1+4*1.5+4*1.5+5*2+5*2+7*2.5+9*3 = 2+4+6+6+10+10+17.5+27 = 82.5
    self.add_weighted(2.0, 1.0);
    self.add_weighted(4.0, 1.0);
    self.add_weighted(4.0, 1.5);
    self.add_weighted(4.0, 1.5);
    self.add_weighted(5.0, 2.0);
    self.add_weighted(5.0, 2.0);
    self.add_weighted(7.0, 2.5);
    self.add_weighted(9.0, 3.0);

    // Verify mean: should be 5.0.
    transition self.s.mean > 4.9 {
        true -> check_mean_upper()
        _ -> bad_mean_low()
    }

    state bad_mean_low(&mut self) {
        self.console.write_line("FAIL: mean fell below 4.9, expected 5.0 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state check_mean_upper(&mut self) {
        transition self.s.mean < 5.1 {
            true -> check_var_low()
            _ -> bad_mean_high()
        }
    }

    state bad_mean_high(&mut self) {
        self.console.write_line("FAIL: mean rose above 5.1, expected 5.0 (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    // Verify variance: should be 4.0.
    state check_var_low(&mut self) {
        transition self.s.variance > 3.9 {
            true -> check_var_high()
            _ -> bad_var_low()
        }
    }

    state bad_var_low(&mut self) {
        self.console.write_line("FAIL: variance fell below 3.9, expected 4.0 (exit 73)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }

    state check_var_high(&mut self) {
        transition self.s.variance < 4.1 {
            true -> check_weighted()
            _ -> bad_var_high()
        }
    }

    state bad_var_high(&mut self) {
        self.console.write_line("FAIL: variance rose above 4.1, expected 4.0 (exit 74)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(74);
    }

    // Verify weighted sum: should be 82.5.
    state check_weighted(&mut self) {
        transition self.s.weighted_sum > 82.0 {
            true -> check_weighted_high()
            _ -> bad_weighted_low()
        }
    }

    state bad_weighted_low(&mut self) {
        self.console.write_line("FAIL: weighted sum fell below 82.0, expected 82.5 (exit 75)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(75);
    }

    state check_weighted_high(&mut self) {
        transition self.s.weighted_sum < 83.0 {
            true -> good()
            _ -> bad_weighted_high()
        }
    }

    state bad_weighted_high(&mut self) {
        self.console.write_line("FAIL: weighted sum rose above 83.0, expected 82.5 (exit 76)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(76);
    }

    state good(&mut self) {
        self.console.write_line("PASS: mean=5.0, variance=4.0, weighted sum=82.5 all in tolerance (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
}
