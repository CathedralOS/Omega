// Statistics compute kernel. Exercises f64 arithmetic end-to-end: mean,
// variance, and a weighted sum over a small fixed dataset.
//
// Dataset (8 samples):  2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0
//   (8 values, mean = 40.0/8 = 5.0, variance = sum((xi-mean)^2)/N = 4.0)
//
// Each input arrives through a named machine call, exercising repeated
// mutation of the same floating-point fields.
//
// Verification ladder:
//   mean  == 5.0  => mean - 5.0 == 0.0 within 0.01
//   variance == 4.0  => variance > 3.9 && variance < 4.1
//   weighted sum == 82.5 (weights: 1.0, 1.0, 1.5, 1.5, 2.0, 2.0, 2.5, 3.0)
//
// Each check narrows via guard ladder (cannot exit with float directly).
// Final exit: 70.
//
// Expected exit: 70.
// Expected output contains: PASS: mean=5.0, variance=4.0, weighted sum=82.5 all in tolerance (exit 70)

use omega::language::core::float_operations;
use omega_language_std::console;

data Stats [copy] {
    // Running accumulator for sum and sum-of-squares.
    sum: f64;
    sum_sq_dev: f64;
    // The modular-counter idiom at the increment: reducing `% 101` before the
    // `+ 1` bounds the operand, so it is Exact-provable with no overflow domain.
    count: i32;
    mean: f64;
    variance: f64;
    weighted_sum: f64;
}

data Main {
    s: Stats;
    pause: [u8; 256];
}

// Add one value to the running sum.
machine Main::add(main: &mut Main, x: f64) {
    main.s.sum = main.s.sum + x;
    main.s.count = (main.s.count % 101 + 1) % 101;
}

// Finalize mean = sum / count.
machine Main::finalize_mean(main: &mut Main) {
    // count is 8; divide by storing quotient manually to avoid float/int division.
    // sum = 40.0; mean = 5.0
    main.s.mean = main.s.sum * 0.125;  // multiply by 1/8
}

// Add the squared deviation (xi - mean)^2 to sum_sq_dev.
machine Main::add_dev(main: &mut Main, xi: f64) {
    let dev: f64 = xi - main.s.mean;
    let sq: f64 = dev * dev;
    main.s.sum_sq_dev = main.s.sum_sq_dev + sq;
}

// Finalize variance = sum_sq_dev / count.
machine Main::finalize_variance(main: &mut Main) {
    // sum_sq_dev = 32.0; variance = 32.0 / 8 = 4.0
    main.s.variance = main.s.sum_sq_dev * 0.125;
}

// Add one weighted value to weighted_sum.
machine Main::add_weighted(main: &mut Main, x: f64, w: f64) {
    main.s.weighted_sum = main.s.weighted_sum + x * w;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("stats_compute: f64 mean, variance, and weighted sum over 8 samples");
    // Phase 1: accumulate the 8 data values.
    Main::add(main, 2.0);
    Main::add(main, 4.0);
    Main::add(main, 4.0);
    Main::add(main, 4.0);
    Main::add(main, 5.0);
    Main::add(main, 5.0);
    Main::add(main, 7.0);
    Main::add(main, 9.0);

    // Finalize mean.
    Main::finalize_mean(main);

    // Phase 2: compute squared deviations from the mean (mean = 5.0).
    // (2-5)^2 = 9, (4-5)^2=1 x3, (5-5)^2=0 x2, (7-5)^2=4, (9-5)^2=16
    // sum = 9+1+1+1+0+0+4+16 = 32; variance = 32/8 = 4.0
    Main::add_dev(main, 2.0);
    Main::add_dev(main, 4.0);
    Main::add_dev(main, 4.0);
    Main::add_dev(main, 4.0);
    Main::add_dev(main, 5.0);
    Main::add_dev(main, 5.0);
    Main::add_dev(main, 7.0);
    Main::add_dev(main, 9.0);

    Main::finalize_variance(main);

    // Phase 3: weighted sum.
    // 2*1+4*1+4*1.5+4*1.5+5*2+5*2+7*2.5+9*3 = 2+4+6+6+10+10+17.5+27 = 82.5
    Main::add_weighted(main, 2.0, 1.0);
    Main::add_weighted(main, 4.0, 1.0);
    Main::add_weighted(main, 4.0, 1.5);
    Main::add_weighted(main, 4.0, 1.5);
    Main::add_weighted(main, 5.0, 2.0);
    Main::add_weighted(main, 5.0, 2.0);
    Main::add_weighted(main, 7.0, 2.5);
    Main::add_weighted(main, 9.0, 3.0);

    // Verify mean: should be 5.0.
    transition main.s.mean > 4.9 {
        true -> check_mean_upper(main)
        _ -> bad_mean_low(main)
    }

    state bad_mean_low(main: &mut Main) {
        Console::write_line("FAIL: mean fell below 4.9, expected 5.0 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_mean_upper(main: &mut Main) {
        transition main.s.mean < 5.1 {
            true -> check_var_low(main)
            _ -> bad_mean_high(main)
        }
    }

    state bad_mean_high(main: &mut Main) {
        Console::write_line("FAIL: mean rose above 5.1, expected 5.0 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    // Verify variance: should be 4.0.
    state check_var_low(main: &mut Main) {
        transition main.s.variance > 3.9 {
            true -> check_var_high(main)
            _ -> bad_var_low(main)
        }
    }

    state bad_var_low(main: &mut Main) {
        Console::write_line("FAIL: variance fell below 3.9, expected 4.0 (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state check_var_high(main: &mut Main) {
        transition main.s.variance < 4.1 {
            true -> check_weighted(main)
            _ -> bad_var_high(main)
        }
    }

    state bad_var_high(main: &mut Main) {
        Console::write_line("FAIL: variance rose above 4.1, expected 4.0 (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    // Verify weighted sum: should be 82.5.
    state check_weighted(main: &mut Main) {
        transition main.s.weighted_sum > 82.0 {
            true -> check_weighted_high(main)
            _ -> bad_weighted_low(main)
        }
    }

    state bad_weighted_low(main: &mut Main) {
        Console::write_line("FAIL: weighted sum fell below 82.0, expected 82.5 (exit 75)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(75);
    }

    state check_weighted_high(main: &mut Main) {
        transition main.s.weighted_sum < 83.0 {
            true -> good(main)
            _ -> bad_weighted_high(main)
        }
    }

    state bad_weighted_high(main: &mut Main) {
        Console::write_line("FAIL: weighted sum rose above 83.0, expected 82.5 (exit 76)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(76);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: mean=5.0, variance=4.0, weighted sum=82.5 all in tolerance (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
