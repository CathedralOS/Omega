// Expected exit: 70.
// Recursive sum over a fixed-size integer array via a value-returning machine.
//
// Exercises: recursion + accumulator through a value-returning machine
// (`sum(s, 0)` where `sum` recurses via `s[1..]` and accumulates
// the head element `s[0]`), combined with a guard on the recursive result.
// The `terminates` annotation lets the prover accept the recursion.
//
// Also exercises two sequential value-returning recursive calls in one machine.
//
// Dataset: [5, 10, 15, 20] fixed array, expected sum = 50.
// count of elements (via separate recursive counter) = 4.
//
// We use the call results directly in transition guards (NOT stored to fields)
// to stay within the working native lowering surface.
//
// MISCOMPILE FOUND AND FIXED (2026-06-14). Now exits 70.
//
// `sum(s[1..], acc + s[0])`: argument materialization advanced the `s`
// descriptor (to s[1..]) BEFORE reading `s[0]` for the accumulator, so every
// step summed the next window's head -- an off-by-one that made [5,10,15,20]
// read as != 50 (native exit 71). `acc + 1` (count) was immune (no slice read).
//
// ROOT CAUSE: the argument-overlap detector's source-range probe did not look
// inside a binary accumulator, so it missed that `acc + s[0]` reads the `s`
// slot and never staged the call. FIX: argument_source_frame_range now recurses
// through binary/cast operands to report a nested slice-element read's
// descriptor slot, forcing staging. Guarded by the RUN canary
// slices/recursive_subslice_element_accumulator_exit (oracle-matched).

use omega_language_std::console;

data Main {
    arr: [i32 in Wrapping; 4];
    pause: [u8; 256];
}

// Recursive value-returning machine: sum all elements in slice s.
// The guard `s.len > 0` proves bounds for both s[0] and s[1..].
machine sum(s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> sum(s[1..], acc + s[0])
        false -> (acc as i32)
    }
}

// Recursive value-returning machine: count elements in slice s.
machine count(s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> count(s[1..], acc + 1)
        false -> (acc as i32)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("recursive_sum: recursive slice sum + count via value-returning machines");
    // Initialize the array elements.
    main.arr[0] = 5;
    main.arr[1] = 10;
    main.arr[2] = 15;
    main.arr[3] = 20;

    // Compute sum via recursive value-returning call.
    let s: &[i32 in Wrapping] = &main.arr[..];
    let sum_result: i32 = sum(s, 0);

    // Check sum == 50 directly on the local.
    transition sum_result == 50 {
        true -> check_count(main)
        _ -> bad_sum(main)
    }

    state bad_sum(main: &mut Main) {
        Console::write_line("FAIL: recursive sum did not equal 50 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_count(main: &mut Main) {
        // Compute count via recursive value-returning call.
        let s2: &[i32 in Wrapping] = &main.arr[..];
        let cnt: i32 = count(s2, 0);

        // Check element count == 4.
        transition cnt == 4 {
            true -> good(main)
            _ -> bad_count(main)
        }
    }

    state bad_count(main: &mut Main) {
        Console::write_line("FAIL: recursive count did not equal 4 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: sum=50 and count=4 both verified (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
