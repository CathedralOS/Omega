// Bit-shift scaling -- multiply and divide by powers of two with `<<` and `>>`,
// the cheap operators behind unit conversions and bit packing. `kibibytes << 10`
// scales by 1024 (KiB -> bytes), and `bytes >> 10` scales back (bytes -> KiB), so
// the round trip recovers the original: 64 -> 65536 -> 64. The values use a
// `Wrapping` domain (a shift is a wrapping operation). (Bitwise `&`/`|`/`^` are a
// separate feature still pending; `<<`/`>>` are fully supported.)
// Expected exit: 64.

use omega_language_std::console;

data Main {
    console: Console;
    kibibytes: i32 in Wrapping;
    bytes: i32 in Wrapping;
    recovered: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("bit_shift: KiB->bytes->KiB round trip -- 64 << 10 == 65536, then >> 10 back to 64");
    self.kibibytes = 64;
    self.bytes = self.kibibytes << 10;
    self.recovered = self.bytes >> 10;

    transition { _ -> done() }

    state done(&mut self) {
        self.console.write_line("result: the recovered KiB count, 64 for this round trip (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.recovered as i32);
    }
}
