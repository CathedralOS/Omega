// Dual float: f32 and f64 fields in the same data type.
//
// Exercises: a data struct with BOTH f32 and f64 fields, arithmetic on each,
// comparison guards, and a cross-width cast (f32 field -> f64 for comparison,
// then cast to i32 for the exit code).
//
// Data layout (tests that f32 and f64 can coexist in the same struct):
//   low: f32   -- 32-bit float
//   high: f64  -- 64-bit float
//   result: i32 -- integer result for the exit code check
//
// Computation:
//   low = 3.5    (f32)
//   high = 6.5   (f64)
//   sum_f32 = low + low = 7.0 (f32 arithmetic)
//   diff_f64 = high - 3.0 = 3.5 (f64 arithmetic)
//
//   We check:
//     sum_f32 > 6.9 && sum_f32 < 7.1   (f32 comparison)
//     diff_f64 > 3.4 && diff_f64 < 3.6 (f64 comparison)
//   Then compute result = 70 and exit.
//
// Expected exit: 70.

use omega::language::core::float_operations;
use omega_language_std::console;

data Floats [copy] {
    low: f32;
    high: f64;
    sum_f32: f32;
    diff_f64: f64;
    result: i32;
}

data Main {
    f: Floats;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("dual_float: f32 and f64 coexisting in one struct -- 3.5+3.5 (f32) and 6.5-3.0 (f64)");
    // Assign the mixed-width float fields.
    main.f.low = 3.5;
    main.f.high = 6.5;

    // f32 arithmetic: low + low = 7.0
    main.f.sum_f32 = main.f.low + main.f.low;

    // f64 arithmetic: high - 3.0 = 3.5
    main.f.diff_f64 = main.f.high - 3.0;

    // Check sum_f32 is ~7.0.
    transition main.f.sum_f32 > 6.9 {
        true -> check_sum_upper(main)
        _ -> bad_sum_low(main)
    }

    state bad_sum_low(main: &mut Main) {
        Console::write_line("FAIL: f32 sum <= 6.9 -- expected ~7.0 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_sum_upper(main: &mut Main) {
        transition main.f.sum_f32 < 7.1 {
            true -> check_diff_low(main)
            _ -> bad_sum_high(main)
        }
    }
    state bad_sum_high(main: &mut Main) {
        Console::write_line("FAIL: f32 sum >= 7.1 -- expected ~7.0 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    // Check diff_f64 is ~3.5.
    state check_diff_low(main: &mut Main) {
        transition main.f.diff_f64 > 3.4 {
            true -> check_diff_high(main)
            _ -> bad_diff_low(main)
        }
    }
    state bad_diff_low(main: &mut Main) {
        Console::write_line("FAIL: f64 diff <= 3.4 -- expected ~3.5 (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state check_diff_high(main: &mut Main) {
        transition main.f.diff_f64 < 3.6 {
            true -> store_result(main)
            _ -> bad_diff_high(main)
        }
    }
    state bad_diff_high(main: &mut Main) {
        Console::write_line("FAIL: f64 diff >= 3.6 -- expected ~3.5 (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    // All checks passed: encode exit 70.
    state store_result(main: &mut Main) {
        main.f.result = 70;
        transition main.f.result == 70 {
            true -> good(main)
            _ -> bad_result(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: both float widths computed and compared correctly (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad_result(main: &mut Main) {
        Console::write_line("FAIL: integer result field readback != 70 (exit 75)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(75);
    }
}
