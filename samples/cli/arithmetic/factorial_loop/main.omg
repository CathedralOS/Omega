use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_exit.omg;
// Accumulator factorial via a SELF-TRANSITION LOOP (`-> fact(n - 1, acc * n)`
// re-enters the entry state -- a jump with re-bound arguments; Omega has NO
// recursion). The loop-carried arguments stage through scratch so the multiply
// reads the PRE-decrement n (the parallel-assignment guarantee), proven
// terminating by `terminates by n;`.
//
//   fact(5, 1) = 120
//
// Expected exit: 120
machine fact(n: u64, acc: u64 in Wrapping) -> u64
terminates by n
{
    transition n > 0 {
        true -> fact(n - 1, acc * (n as +Wrapping)),
        false -> (acc as u64)
    }
}
data Main { }
machine main(main: @mutable Main) reaches |process_exit|::ProcessExit {
    let result: u64 = fact(5, 1 as +Wrapping);
    let code: i32 = |numeric_conversion|::narrow_u64_to_i32_trapping(result);
    |process_exit|::ProcessExit::exit_process(code);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
