// The Euclidean algorithm for the greatest common divisor: repeatedly replace
// (a, b) with (b, a % b) until b is zero; a is then the GCD. A data-dependent loop
// expressed as a small state machine -- `step` tests `b == 0`, `reduce` does one
// Euclidean step -- exercising modulo, a runtime-condition dispatch loop, and
// field mutation. (The loop terminates because `a % b < b`, so `b` strictly
// decreases each step; the compiler accepts the dispatch loop.)
//
// The sample computes gcd(1071, 462) = 21 and exits 21. Try editing the two
// starting values -- e.g. 48 & 36 (-> 12), 17 & 5 (coprime -> 1), 100 & 0 (-> 100).
// Expected exit: 21.

boundary trait Console {
    machine write_line(text: String);
    machine read_line(out_line: &mut String);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    scratch: i32 in Wrapping;
    pause: String;
}

machine Main::main(&mut self) {
    self.console.write_line("gcd: Euclidean algorithm -- (a, b) -> (b, a % b) until b == 0");
    self.a = 1071;
    self.b = 462;
    transition { _ -> step() }

    state step(&mut self) {
        // b == 0 -> a holds the GCD; otherwise take one Euclidean step.
        transition self.b == 0 { true -> done() _ -> reduce() }
    }
    state reduce(&mut self) {
        self.scratch = self.b;
        self.b = self.a % self.b;
        self.a = self.scratch;
        transition { _ -> step() }
    }

    state done(&mut self) {
        self.console.write_line("result: the GCD is the exit code (21 for 1071 and 462)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.a);
    }
}
