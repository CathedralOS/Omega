// Modular exponentiation by repeated squaring: compute (base ^ exponent) mod m.
// This is the workhorse of public-key crypto (RSA, Diffie-Hellman); doing it by
// squaring keeps every intermediate small instead of forming the astronomically
// large base^exponent. Here 3 ^ 7 mod 100 = 2187 mod 100 = 87.
//
// Each loop entry keeps the accumulator and base in 0..=99. Their product
// is at most 9801, so Exact multiplication fits i32. The constant divisors
// 100 and 2 are nonzero; the parity branch tests the exponent's low bit.
// Expected exit: 87.

use omega_language_std::Console;

// Each constant divisor is provably nonzero. The changing algorithm values
// are explicit state inputs; no application object retains scratch storage.
machine modular_power(base: i32, exponent: i32) -> i32
requires base >= 0
ensures result >= 0 && result <= 99
{
    transition {
        _ -> step(1, base % 100, exponent)
    }

    // Process the exponent bit by bit, lowest first; stop once it is exhausted.
    machine step(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        transition exponent == 0 {
            true -> (accumulator)
            _ -> classify(accumulator, base, exponent)
        }
    }

    // Fold the current squared base into the result only when this bit is set.
    machine classify(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        let bit: i32 = exponent % 2;
        transition bit == 1 {
            true -> accumulate(accumulator, base, exponent)
            _ -> square(accumulator, base, exponent)
        }
    }

    machine accumulate(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        let next_accumulator: i32 = (accumulator * base) % 100;
        transition {
            _ -> square(next_accumulator, base, exponent)
        }
    }

    // Square the base and halve the exponent for the next bit.
    machine square(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        let next_base: i32 = (base * base) % 100;
        let next_exponent: i32 = exponent / 2;
        transition {
            _ -> step(accumulator, next_base, next_exponent)
        }
    }

}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("modular_exponentiation: 3^7 mod 100 by repeated squaring, fully exact");
    let result: i32 = modular_power(3, 7);
    Console::write_line("result: 3^7 mod 100 = 87 (the exit code)");
    Console::write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block Console::read_line(&mut pause);
    Console::exit_process(result);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
