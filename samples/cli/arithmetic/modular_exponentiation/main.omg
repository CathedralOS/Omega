// Modular exponentiation by repeated squaring: compute (base ^ exponent) mod m.
// This is the workhorse of public-key crypto (RSA, Diffie-Hellman); doing it by
// squaring keeps every intermediate small instead of forming the astronomically
// large base^exponent. Here 3 ^ 7 mod 100 = 2187 mod 100 = 87.
//
// Showcases the full integer-arithmetic kit over a scalar state loop, FULLY
// EXACT -- no Trapping, no Wrapping: each factor is reduced `% 100` before it
// is multiplied, so every product is verifiably bounded (|result * base| <=
// 99*99 = 9801, far under i32::MAX) and every `% m` divisor is provably
// nonzero, so the decision-17 obligations discharge by proof. When arithmetic
// is verifiably bounded, no overflow domain is needed -- the avionics posture.
// `% 2` / `/ 2` are constant divisors; the parity branch reads the exponent's
// low bit.
// Expected exit: 87.

use omega_language_std::console;

// Each constant divisor is provably nonzero. The changing algorithm values
// are explicit state inputs; no application object retains scratch storage.
machine modular_power(base: i32, exponent: i32) -> i32 {
    transition {
        _ -> step(1, base % 100, exponent)
    }

    // Process the exponent bit by bit, lowest first; stop once it is exhausted.
    state step(result: i32, base: i32, exponent: i32) -> i32 {
        transition exponent == 0 {
            true -> (result)
            _ -> classify(result, base, exponent)
        }
    }

    // Fold the current squared base into the result only when this bit is set.
    state classify(result: i32, base: i32, exponent: i32) -> i32 {
        let bit: i32 = exponent % 2;
        transition bit == 1 {
            true -> accumulate(result, base, exponent)
            _ -> square(result, base, exponent)
        }
    }

    state accumulate(result: i32, base: i32, exponent: i32) -> i32 {
        let next_result: i32 = ((result % 100) * (base % 100)) % 100;
        transition {
            _ -> square(next_result, base, exponent)
        }
    }

    // Square the base and halve the exponent for the next bit.
    state square(result: i32, base: i32, exponent: i32) -> i32 {
        let next_base: i32 = ((base % 100) * (base % 100)) % 100;
        let next_exponent: i32 = exponent / 2;
        transition {
            _ -> step(result, next_base, next_exponent)
        }
    }

}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("modular_exponentiation: 3^7 mod 100 by repeated squaring, fully exact");
    let result: i32 = modular_power(3, 7);
    Console::write_line("result: 3^7 mod 100 = 87 (the exit code)");
    Console::write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block Console::read_line(&mut pause);
    Console::exit_process(result);
}
