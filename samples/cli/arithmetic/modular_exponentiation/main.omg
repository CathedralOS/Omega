// Modular exponentiation by repeated squaring: compute (base ^ exponent) mod m.
// This is the workhorse of public-key crypto (RSA, Diffie-Hellman); doing it by
// squaring keeps every intermediate small instead of forming the astronomically
// large base^exponent. Here 3 ^ 7 mod 100 = 2187 mod 100 = 87.
//
// Showcases the full integer-arithmetic kit over a self-transition loop, FULLY
// EXACT -- no Trapping, no Wrapping: the RANGE refinements make every product
// verifiably bounded ((result * base) <= 99*99 = 9801, far under i32::MAX) and
// every `% m` divisor provably nonzero, so the decision-17 obligations
// discharge by proof. When arithmetic is verifiably bounded, no overflow
// domain is needed -- the avionics posture. `% 2` / `/ 2` are constant
// divisors; the parity branch reads the exponent's low bit.
// Expected exit: 87.

use omega_language_std::console;

// The modulus is the CONSTANT 100 at each `%` site (a constant divisor is
// provably nonzero). A `modulus: i32 [1..=100]` FIELD would be rejected: this
// data is zero-initialized, and a range excluding 0 on a ZII field would let
// reads trust a bound the startup value violates.
data ModExp [copy] {
    result: i32 [0..=99];
    base: i32 [0..=99];
    exponent: i32;
}

data Main {
    console: Console;
    state: ModExp;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("modular_exponentiation: 3^7 mod 100 by repeated squaring, fully exact");
    self.state.base = 3;
    self.state.exponent = 7;
    
    self.state.result = 1;
    self.state.base = self.state.base % 100;

    transition {
        _ -> step()
    }

    // Process the exponent bit by bit, lowest first; stop once it is exhausted.
    state step(&mut self) {
        transition self.state.exponent == 0 {
            true -> done()
            _ -> classify()
        }
    }

    // Fold the current squared base into the result only when this bit is set.
    state classify(&mut self) {
        let bit: i32 = self.state.exponent % 2;
        transition bit == 1 {
            true -> accumulate()
            _ -> square()
        }
    }

    state accumulate(&mut self) {
        self.state.result = (self.state.result * self.state.base) % 100;
        transition {
            _ -> square()
        }
    }

    // Square the base and halve the exponent for the next bit.
    state square(&mut self) {
        self.state.base = (self.state.base * self.state.base) % 100;
        self.state.exponent = self.state.exponent / 2;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.write_line("result: 3^7 mod 100 = 87 (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.state.result);
    }
}
