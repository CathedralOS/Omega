// A corrected gravimetric mass is an f64 predicate, not only a runtime status.
// gross - tare is NonnegativeMass when both readings are finite and gross is
// at least tare. The caller observes that result as a local, a field, a
// parameter, and a call result, then divides it by an admissible total.
// Expected exit: 0
// Expected output contains: MASS 2
use omega_language_std::console;
use omega::language::core::float_operations;

domain f64::NonnegativeMass(value)
requires value >= 0.0;

domain f64::AdmissibleTotal(value)
requires value >= 0.01;

machine corrected(gross: f64, tare: f64) -> f64 in NonnegativeMass
requires F64::is_finite(gross) && F64::is_finite(tare) && gross >= tare
{
    gross - tare
}

machine carried(mass: f64 in NonnegativeMass) -> f64 in NonnegativeMass {
    mass
}

machine fraction(mass: f64 in NonnegativeMass, total: f64 in AdmissibleTotal) -> f64 {
    mass / total
}

data Reading {
    mass: f64 in NonnegativeMass;
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let literal_total: f64 in AdmissibleTotal = 6.0;
    let mass: f64 in NonnegativeMass = corrected(3.0, 1.0);
    let stored: Reading = Reading { mass: mass };
    let through_field: f64 = stored.mass;
    let through_parameter: f64 = fraction(stored.mass, literal_total);
    let through_call: f64 in NonnegativeMass = carried(mass);
    transition mass == 2.0 && through_field == 2.0 && through_parameter == 2.0 / 6.0
        && through_call == 2.0 {
        true -> ok(main)
        false -> bad(main)
    }
    state ok(main: &mut Main) {
        Console::write_line("MASS 2");
        Console::exit_process(0);
    }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
