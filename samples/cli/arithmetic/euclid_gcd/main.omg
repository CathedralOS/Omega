// Greatest common divisor by Euclid's algorithm: repeatedly replace (a, b) with
// (b, a mod b) until b is 0; a is then the GCD. gcd(48, 36) = 12. Two-and-a-half
// millennia old and still the standard way to reduce a fraction. Showcases the
// modulo operator over a self-transition loop (the divisor b is a live runtime
// value, not a constant). Each transition passes the next pair explicitly;
// the remainder is local to the reduction step, not persistent context state.
// Expected exit: 12.
// Expected output contains: result: the GCD, 12 for (48, 36) (the exit code)

use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("euclid_gcd: Euclid's algorithm on (48, 36) via the remainder loop");
    transition {
        _ -> step(context, 48, 36)
    }

    // Retain the sample's Wrapping arithmetic domain on the explicit operands.
    state step(context: &mut Main, left: i32 in Wrapping, right: i32 in Wrapping) {
        transition right == 0 {
            true -> done(context, left)
            _ -> reduce(context, left, right)
        }
    }

    state reduce(context: &mut Main, left: i32 in Wrapping, right: i32 in Wrapping) {
        let remainder: i32 in Wrapping = left % right;
        transition {
            _ -> step(context, right, remainder)
        }
    }

    state done(context: &mut Main, result: i32 in Wrapping) {
        Console::write_line("result: the GCD, 12 for (48, 36) (the exit code)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(result as i32);
    }
}
