// Expected exit: 161.
// Fibonacci numbers and the golden ratio. Compute consecutive Fibonacci terms (a, b) by the
// classic iterative loop -- tmp = a + b; a = b; b = tmp -- then the ratio b / a as a float, which
// converges to the golden ratio phi ~= 1.618. After 13 steps a = fib(14) = 377 and b = fib(15) =
// 610; 610 / 377 = 1.6180..., and (ratio * 100) truncated to an integer is 161.
//
// The loop carries its consecutive terms and counter as state arguments. Float
// conversion and input scratch are local to the final state; Main owns only I/O.

use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main) reaches Console {
    context.console.write_line("fibonacci_golden: iterating fibonacci pairs to approximate the golden ratio");
    transition {
        _ -> step(context, 1, 1, 0)
    }

    state step(
        context: &mut Main,
        first: i32 in Wrapping,
        second: i32 in Wrapping,
        iteration: i32 in Wrapping
    ) {
        transition iteration == 13 {
            true -> ratio_calc(context, first, second)
            _ -> advance(context, first, second, iteration)
        }
    }

    state advance(
        context: &mut Main,
        first: i32 in Wrapping,
        second: i32 in Wrapping,
        iteration: i32 in Wrapping
    ) {
        let next: i32 in Wrapping = first + second;
        transition {
            _ -> step(context, second, next, iteration + 1)
        }
    }

    state ratio_calc(context: &mut Main, first: i32 in Wrapping, second: i32 in Wrapping) {
        let first_float: f64 = F64::from_i32(first as i32);
        let second_float: f64 = F64::from_i32(second as i32);
        let ratio: f64 = second_float / first_float;
        let scaled: f64 = ratio * 100.0;
        let result: i32 in Saturating = I32::from_f64(scaled);
        context.console.write_line("result: floor(100 * fib(15)/fib(14)), 161 for this run (the exit code)");
        context.console.write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block context.console.read_line(&mut pause);
        context.console.exit_process(result as i32);
    }
}
