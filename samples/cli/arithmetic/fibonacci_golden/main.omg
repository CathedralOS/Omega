// Expected exit: 161.
// Fibonacci numbers and the golden ratio. Compute consecutive Fibonacci terms (a, b) by the
// classic iterative loop -- tmp = a + b; a = b; b = tmp -- then the ratio b / a as a float, which
// converges to the golden ratio phi ~= 1.618. After 13 steps a = fib(14) = 377 and b = fib(15) =
// 610; 610 / 377 = 1.6180..., and (ratio * 100) truncated to an integer is 161.
//
// Showcases an integer accumulation loop with explicit state arguments feeding an
// int -> float -> int computation: the consecutive terms are widened to f64, divided, scaled, and
// truncated back. Each iteration computes its next term locally and passes the
// next pair to the loop head. Float intermediates exist only in the final state.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("fibonacci_golden: iterating fibonacci pairs to approximate the golden ratio");

    transition {
        _ -> step(1, 1, 0)
    }

    state step(left: i32 in Wrapping, right: i32 in Wrapping, iteration: i32 in Wrapping) {
        transition iteration == 13 {
            true -> ratio_calc(left, right)
            _ -> advance(left, right, iteration)
        }
    }

    state advance(left: i32 in Wrapping, right: i32 in Wrapping, iteration: i32 in Wrapping) {
        let next: i32 in Wrapping = left + right;
        let next_iteration: i32 in Wrapping = iteration + 1;
        transition {
            _ -> step(right, next, next_iteration)
        }
    }

    state ratio_calc(left: i32 in Wrapping, right: i32 in Wrapping) {
        let left_float: f64 = F64::from_i32(left as i32);
        let right_float: f64 = F64::from_i32(right as i32);
        let ratio: f64 = right_float / left_float;
        let scaled: f64 = ratio * 100.0;
        let result: i32 in Saturating = I32::from_f64(scaled);
        Console::write_line("result: floor(100 * fib(15)/fib(14)), 161 for this run (the exit code)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(result as i32);
    }
}
