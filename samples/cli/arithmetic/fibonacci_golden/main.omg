// Expected exit: 161.
// Fibonacci numbers and the golden ratio. Compute consecutive Fibonacci terms (a, b) by the
// classic iterative loop -- tmp = a + b; a = b; b = tmp -- then the ratio b / a as a float, which
// converges to the golden ratio phi ~= 1.618. After 13 steps a = fib(14) = 377 and b = fib(15) =
// 610; 610 / 377 = 1.6180..., and (ratio * 100) truncated to an integer is 161.
//
// Showcases an integer accumulation loop (a self-transition over a counter field) feeding an
// int -> float -> int computation: the consecutive terms are widened to f64, divided, scaled, and
// truncated back. The swap goes through a `tmp` FIELD (read from its slot) rather than a `let`
// local, the same idiom euclid_gcd documents. Expected exit: 161.

use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

data Fib [copy] {
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    tmp: i32 in Wrapping;
    i: i32 in Wrapping;
}

data Main {
    console: Binding<Console>;
    fib: Fib;
    fa: f64;
    fb: f64;
    ratio: f64;
    result: i32 in Saturating;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    main.console.write_line("fibonacci_golden: iterating fibonacci pairs to approximate the golden ratio");
    main.fib.a = 1;
    main.fib.b = 1;
    main.fib.i = 0;

    transition {
        _ -> step(main)
    }

    state step(main: &mut Main) {
        transition main.fib.i == 13 {
            true -> ratio_calc(main)
            _ -> advance(main)
        }
    }

    state advance(main: &mut Main) {
        main.fib.tmp = main.fib.a + main.fib.b;
        main.fib.a = main.fib.b;
        main.fib.b = main.fib.tmp;
        main.fib.i = main.fib.i + 1;
        transition {
            _ -> step(main)
        }
    }

    state ratio_calc(main: &mut Main) {
        main.fa = F64::from_i32(main.fib.a as i32);
        main.fb = F64::from_i32(main.fib.b as i32);
        main.ratio = main.fb / main.fa;
        main.ratio = main.ratio * 100.0;
        main.result = I32::from_f64(main.ratio);
        main.console.write_line("result: floor(100 * fib(15)/fib(14)), 161 for this run (the exit code)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(main.result as i32);
    }
}
