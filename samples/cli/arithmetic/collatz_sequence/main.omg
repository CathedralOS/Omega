// Collatz ("hailstone") sequence length. Starting at 27, count the steps to
// reach 1: halve an even value, or compute 3n+1 for an odd value. This seed
// takes 111 steps and peaks at 9232. The reusable calculation deliberately
// retains Wrapping arithmetic for values and counts; it does not claim that
// arbitrary seeds terminate or that a modular orbit is an unbounded one.
// Expected exit: 111.

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main) reaches Console {
    context.console.write_line("collatz_sequence: count hailstone steps from 27 down to 1");
    let steps: i32 in Wrapping = count_hailstone_steps(27);
    context.console.write_line("result: the step count, 111 for seed 27 (the exit code)");
    context.console.write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block context.console.read_line(&mut pause);
    context.console.exit_process(steps as i32);
}

machine count_hailstone_steps(seed: i32 in Wrapping) -> i32 in Wrapping {
    transition { _ -> step(seed, 0) }

    state step(value: i32 in Wrapping, steps: i32 in Wrapping) -> i32 in Wrapping {
        transition value == 1 {
            true -> steps
            _ -> advance(value, steps)
        }
    }

    state advance(value: i32 in Wrapping, steps: i32 in Wrapping) -> i32 in Wrapping {
        let next_steps: i32 in Wrapping = steps + 1;
        let remainder: i32 = (value % 2) as i32;
        transition remainder == 0 {
            true -> halve(value, next_steps)
            _ -> climb(value, next_steps)
        }
    }

    state halve(value: i32 in Wrapping, steps: i32 in Wrapping) -> i32 in Wrapping {
        transition { _ -> step(value / 2, steps) }
    }

    state climb(value: i32 in Wrapping, steps: i32 in Wrapping) -> i32 in Wrapping {
        transition { _ -> step(value * 3 + 1, steps) }
    }
}
