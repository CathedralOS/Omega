// Collatz ("hailstone") sequence length. Starting at N = 27, count the steps to
// reach 1, where each step is `n/2` when n is even and `3n+1` when n is odd. 27
// is the famous small seed: it takes 111 steps and peaks at 9232 before falling
// to 1. The sample retains modular arithmetic with `in Wrapping`; it does not
// claim termination or an overflow bound for arbitrary seeds. Loop values are
// explicit state arguments, not persistent fields.
// Expected exit: 111.

use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line(&main.console, "collatz_sequence: count hailstone steps from 27 down to 1");

    transition {
        _ -> step(&main.console, 27, 0)
    }

    // One hailstone step, or stop once the sequence has collapsed to 1.
    state step(console: &Binding<Console>, value: i32 in Wrapping, steps: i32 in Wrapping) {
        transition value == 1 {
            true -> done(console, steps)
            _ -> advance(console, value, steps)
        }
    }

    // Count this step, then branch on parity.
    state advance(console: &Binding<Console>, value: i32 in Wrapping, steps: i32 in Wrapping) {
        let next_steps: i32 in Wrapping = steps + 1;
        let remainder: i32 = (value % 2) as i32;
        transition remainder == 0 {
            true -> halve(console, value, next_steps)
            _ -> climb(console, value, next_steps)
        }
    }

    state halve(console: &Binding<Console>, value: i32 in Wrapping, steps: i32 in Wrapping) {
        let next: i32 in Wrapping = value / 2;
        transition {
            _ -> step(console, next, steps)
        }
    }

    state climb(console: &Binding<Console>, value: i32 in Wrapping, steps: i32 in Wrapping) {
        let next: i32 in Wrapping = value * 3 + 1;
        transition {
            _ -> step(console, next, steps)
        }
    }

    state done(console: &Binding<Console>, steps: i32 in Wrapping) {
        Console::write_line(console, "result: the step count, 111 for seed 27 (the exit code)");
        Console::write_line(console, "[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(console, &mut pause);
        Console::exit_process(console, steps as i32);
    }
}
