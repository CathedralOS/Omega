// wrapping_collatz_max -- a dependency-free benchmark subject.
//
// Same shape as wrapping_square_sum: no depend() edges, so `omega update`
// settles with no dependency findings and the runtime leg observes a
// deterministic clean exit on any hosted target through the ordinary
// ProgramEntry completion. The work differs on purpose: a branchy nested
// Collatz loop instead of a straight-line accumulate, so the optimizer
// sees control-flow merging and a bounded inner iteration profile:
//
//   best = max over start in 1..=100_000 of steps until the sequence
//   hits 1, capped at 10_000 steps per start   (all mod 2^64)
//
// The per-start step cap gives the inner loop an explicit termination
// witness; high starts overflow `3 * n + 1` freely under Wrapping.
//
// The scan carries four values: the outer start, the best step count seen, and
// the inner value and its step counter. They are loop state, so they travel as
// state arguments and the program declares no data at all.

machine main() {
    transition { _ -> outer_(1, 0) }

    state outer_(start: u64 in Wrapping, best: u64 in Wrapping) {
        transition start <= 100000 { true -> begin_start(start, best) _ -> done() }
    }
    state begin_start(start: u64 in Wrapping, best: u64 in Wrapping) {
        transition { _ -> inner_(start, best, start, 0) }
    }
    state inner_(start: u64 in Wrapping, best: u64 in Wrapping, n: u64 in Wrapping, steps: u64 in Wrapping) {
        transition n != 1 && steps < 10000 {
            true -> even_or_odd(start, best, n, steps)
            _ -> settle(start, best, steps)
        }
    }
    state even_or_odd(start: u64 in Wrapping, best: u64 in Wrapping, n: u64 in Wrapping, steps: u64 in Wrapping) {
        transition n & 1 == 0 {
            true -> even(start, best, n, steps)
            _ -> odd(start, best, n, steps)
        }
    }
    state even(start: u64 in Wrapping, best: u64 in Wrapping, n: u64 in Wrapping, steps: u64 in Wrapping) {
        transition { _ -> inner_step(start, best, n >> 1, steps) }
    }
    state odd(start: u64 in Wrapping, best: u64 in Wrapping, n: u64 in Wrapping, steps: u64 in Wrapping) {
        transition { _ -> inner_step(start, best, n * 3 + 1, steps) }
    }
    state inner_step(start: u64 in Wrapping, best: u64 in Wrapping, n: u64 in Wrapping, steps: u64 in Wrapping) {
        transition { _ -> inner_(start, best, n, steps + 1) }
    }
    state settle(start: u64 in Wrapping, best: u64 in Wrapping, steps: u64 in Wrapping) {
        transition steps > best { true -> record(start, steps) _ -> advance(start, best) }
    }
    state record(start: u64 in Wrapping, steps: u64 in Wrapping) {
        transition { _ -> advance(start, steps) }
    }
    state advance(start: u64 in Wrapping, best: u64 in Wrapping) {
        transition { _ -> outer_(start + 1, best) }
    }
    state done() {}
}
