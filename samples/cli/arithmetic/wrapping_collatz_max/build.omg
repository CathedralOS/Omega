// Dependency-free measurable subject: no depend() edges at all, so
// `omega update` settles the review with no dependency findings and
// tools/benchmark can measure compile-time, peak-memory, code-size, and
// runtime rows on any hosted target without settling a dependency graph.

use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "wrapping_collatz_max" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
