// Count the primes up to 20 by trial division -- a real nested-loop computation:
// the OUTER loop walks n = 2..20; for each n the INNER loop tries divisors
// d = 2..n-1 and clears an `is_prime` flag on the first divisor found; primes are
// tallied. The inner loop's bound `d < n` is RELATIONAL (the outer counter is the
// limit), and `n % d` exercises runtime modulo. No arrays -- pure control flow and
// FULLY EXACT arithmetic: ranged counters with guard-proven increments (re-guard
// states put the bound on the increment's direct edge) and a modular tally.
//
//   primes <= 20: 2, 3, 5, 7, 11, 13, 17, 19  ->  8.
// The program exits with the count it computed.
// Expected exit: 8.

use omega_language_std::console;

data Main {
    console: Console;
    pause: [u8; 256];
    n: i32 [0..=21];
    d: i32 [0..=21];
    count: i32 [0..=21];
    is_prime: bool;
}

machine Main::main(&mut self) {
    self.console.write_line("prime_counter: counting primes up to 20 by trial division");
    self.n = 2;
    self.count = 0;

    transition {
        _ -> outer()
    }

    // Outer: walk candidate numbers n = 2..20.
    state outer(&mut self) {
        transition self.n < 21 {
            true -> check_init()
            _ -> done()
        }
    }

    state check_init(&mut self) {
        self.is_prime = true;
        self.d = 2;
        transition {
            _ -> inner()
        }
    }

    // Inner: try divisors d = 2..n-1 (bound is relational to the outer counter).
    // The `d >= 1` conjunct is always true (d starts at 2 and only grows) and
    // hands the edge into test_divisor the nonzero-divisor fact for `n % d`.
    state inner(&mut self) {
        transition self.d >= 1 && self.d < self.n {
            true -> test_divisor()
            _ -> tally()
        }
    }

    state test_divisor(&mut self) {
        transition self.n % self.d == 0 {
            true -> mark_composite()
            _ -> next_divisor()
        }
    }

    state mark_composite(&mut self) {
        self.is_prime = false;
        transition {
            _ -> next_divisor()
        }
    }

    // Re-guard so the increment's direct edge proves `d + 1` back into
    // [0..=21] -- d < n <= 20 here, so the guard is always true.
    state next_divisor(&mut self) {
        transition self.d >= 0 && self.d < 21 {
            true -> bump_divisor()
            _ -> tally()
        }
    }

    state bump_divisor(&mut self) {
        self.d = self.d + 1;
        transition {
            _ -> inner()
        }
    }

    state tally(&mut self) {
        transition self.is_prime {
            true -> increment()
            _ -> outer_next()
        }
    }

    // The modular-counter idiom: `% 22` lands the tally provably back inside
    // [0..=21] (there are at most 8 primes below 21, so the wrap never fires).
    state increment(&mut self) {
        self.count = (self.count + 1) % 22;
        transition {
            _ -> outer_next()
        }
    }

    // Re-guard so the increment's direct edge proves `n + 1` back into
    // [0..=21] -- the outer loop only re-enters with n < 21, so always true.
    state outer_next(&mut self) {
        transition self.n >= 0 && self.n < 21 {
            true -> bump_candidate()
            _ -> done()
        }
    }

    state bump_candidate(&mut self) {
        self.n = self.n + 1;
        transition {
            _ -> outer()
        }
    }

    state done(&mut self) {
        self.console.write_line("result: the prime count, 8 for the primes below 21 (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.count);
    }
}
