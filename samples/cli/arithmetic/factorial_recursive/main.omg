// Accumulator-style RECURSION as a real language feature: `fact` calls itself
// in a transition arm with a `terminates { decreases n; }` proof, and the
// loop-carried arguments (`n - 1`, `acc * n`) stage through scratch so the
// multiply reads the PRE-decrement n (the parallel-assignment guarantee).
// The combine rides the recursive call's ARGUMENT (accumulator style) because
// arm values are place/literal/call only -- `n * self.fact(..)` is not an arm.
//
//   fact(5, 1) = 120
//
// Expected exit: 120
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
}
machine Main::fact(&mut self, n: usize, acc: usize in Wrapping)
terminates {
    decreases n;
}
-> usize
{
    transition n > 0 {
        true -> self.fact(n - 1, acc * (n as usize in Wrapping))
        false -> acc
    }
}
machine Main::main(&mut self) {
    let result: usize = self.fact(5, 1);
    let code: i32 = result as i32;
    self.console.exit_process(code);
}
