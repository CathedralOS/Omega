// Sum an array by walking it BACKWARD -- a real data-processing loop whose
// index bound is a loop INVARIANT rather than the loop guard.
//
//   acc = 0
//   for i = N-1 down to 0: acc = acc + nums[i]
//
// The loop head's guard is `i >= 0` (the low side); the upper bound
// `i < N` that `nums[i]` needs is the inductive invariant established by the
// `i = N - 1` entry and preserved by each `i = i - 1` decrement. Over
// [5, 10, 15, 20, 25] the reverse sum is 75.
// Expected exit: 75.

use omega_language_std::console;

data Main {
    // Wrapping DECLARED: the elements feed the Wrapping accumulator, and Decision
    // 17 forbids mixing domains in one expression.
    nums: [i32; 5] in Wrapping;
    // The index walks 4 down to -1 (the exit value), guard-proven Exact: the
    // `i >= 0` edge into add() proves `i - 1` cannot overflow.
    i: i32;
    // Wrapping DECLARED: sums array elements, which carry no range facts yet.
    acc: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("reverse_sum: sums an array by walking it backward from the top index");
    main.nums[0] = 5;
    main.nums[1] = 10;
    main.nums[2] = 15;
    main.nums[3] = 20;
    main.nums[4] = 25;
    main.i = 4;
    main.acc = 0;

    transition {
        _ -> scan(main)
    }

    // Loop head: walk down until every element has been added.
    state scan(main: &mut Main) {
        transition main.i >= 0 {
            true -> add(main)
            _ -> done(main)
        }
    }

    // Add the current element, then step the index down by one.
    state add(main: &mut Main) {
        main.acc = main.acc + main.nums[main.i];
        main.i = main.i - 1;
        transition {
            _ -> scan(main)
        }
    }

    state done(main: &mut Main) {
        Console::write_line("PASS: reverse sum computed, 75 for this data (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.acc as i32);
    }
}
