// Dot product of two vectors: sum over i of a[i] * b[i]. This reads cleanly now
// that a runtime-indexed read works as a sub-expression operand -- two indexed
// reads inside a multiplication inside the running sum, written directly:
//
//   sum = sum + a[i] * b[i]
//
// Previously each `a[i]` had to be materialized into its own field first. The
// compiler hoists them into temps automatically. The accumulator and elements
// are `in Wrapping` (element reads carry no range facts, so the multiply-add
// cannot prove overflow-freedom); the counter is a guard-proven Exact range.
//
// [1,2,3] . [4,5,6] = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32.
// Expected exit: 32.

use omega_language_std::console;

data Main {
    console: Console;
    // Wrapping DECLARED: the products/sum consume array elements, which carry
    // no range facts yet, so the multiply-accumulate cannot prove its bounds.
    a: [i32; 3] in Wrapping;
    b: [i32; 3] in Wrapping;
    i: i32 [0..=3];
    sum: i32 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("dot_product: [1,2,3] . [4,5,6] via inline indexed multiply-accumulate");
    self.a[0] = 1;
    self.a[1] = 2;
    self.a[2] = 3;
    self.b[0] = 4;
    self.b[1] = 5;
    self.b[2] = 6;
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 3 {
            true -> accumulate()
            _ -> done()
        }
    }

    state accumulate(&mut self) {
        self.sum = self.sum + self.a[self.i] * self.b[self.i];
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.write_line("result: the dot product, 32 for these vectors (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.sum as i32);
    }
}
