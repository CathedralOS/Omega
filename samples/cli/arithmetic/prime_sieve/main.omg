// Sieve of Eratosthenes -> the primes below 50, printed as a formatted row. A "compute,
// then report" tool: it runs a real algorithm (cross out every multiple of each prime it
// finds) and then renders the results as NUMERIC TEXT (building on multiplication_table's
// itoa output). Sieve and collection share one pass: when index i is still unmarked it is
// prime, so we mark its multiples (j = i*i, +i, ... -- a computed index formed into a
// field) AND append i to the output line at a running offset. The `marked[i]` test reads
// the slot into a field first (a runtime-indexed array can't be a guard subject directly).
// `marked` relies on zero-init; `line` is explicitly spaced. Pure compute + stdout.
// Expected exit: 0.
// Expected output contains: 47
use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 48]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    marked: [i32; 50] in Wrapping; // 0 = prime candidate, 1 = composite (zero-init)
    line: [u8; 48] in Utf8;
    i: i32 in Wrapping;
    j: i32 in Wrapping;
    pos: i32 in Wrapping;  // running write offset into line
    mi: i32 in Wrapping;   // marked[i] read into a field
    tens: i32 in Wrapping;
    ones: i32 in Wrapping;
    p1: i32 in Wrapping;   // pos + 1 (a computed index must be a field, not inline)
    tc: u8;
    oc: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("prime_sieve: sieve of Eratosthenes printing the primes below 50");
    main.line = "                                                ";
    main.pos = 0;
    main.i = 2;
    transition { _ -> outer(main) }

    state outer(main: &mut Main) {
        transition main.i >= 2 && main.i < 50 { true -> read_marked(main) _ -> write_out(main) }
    }
    state read_marked(main: &mut Main) {
        main.mi = main.marked[main.i];
        transition main.mi == 0 { true -> mark_init(main) _ -> next_i(main) }
    }
    // i is prime: cross out its multiples starting at i*i
    state mark_init(main: &mut Main) {
        main.j = main.i * main.i;
        transition { _ -> mark_loop(main) }
    }
    state mark_loop(main: &mut Main) {
        transition main.j >= 0 && main.j < 50 { true -> mark_set(main) _ -> append(main) }
    }
    state mark_set(main: &mut Main) {
        main.marked[main.j] = 1;
        main.j = main.j + main.i;
        transition { _ -> mark_loop(main) }
    }
    // append the prime i to the output line as two space-padded digit chars
    state append(main: &mut Main) {
        main.tens = main.i / 10;
        main.ones = main.i % 10;
        main.oc = narrow_i32_to_u8_trapping((main.ones + 48) as i32);
        transition main.tens > 0 { true -> append_tens(main) _ -> append_space(main) }
    }
    state append_tens(main: &mut Main) {
        main.tc = narrow_i32_to_u8_trapping((main.tens + 48) as i32);
        transition { _ -> append_write(main) }
    }
    state append_space(main: &mut Main) {
        main.tc = 32;
        transition { _ -> append_write(main) }
    }
    state append_write(main: &mut Main) {
        main.p1 = main.pos + 1;
        transition main.pos >= 0 && main.pos < 48 && main.p1 >= 0 && main.p1 < 48 {
            true -> append_store(main)
            _ -> next_i(main)
        }
    }
    state append_store(main: &mut Main) {
        main.line[main.pos] = main.tc;
        main.line[main.p1] = main.oc;
        main.pos = main.pos + 3;
        transition { _ -> next_i(main) }
    }
    state next_i(main: &mut Main) {
        main.i = main.i + 1;
        transition { _ -> outer(main) }
    }

    state write_out(main: &mut Main) {
        Console::write_line(main.line);
        transition { _ -> finish(main) }
    }
    state finish(main: &mut Main) {
        Console::write_line("PASS: primes below 50 printed (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
}
