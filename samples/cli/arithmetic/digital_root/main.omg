// Digital root: repeatedly sum a number's decimal digits until a single digit
// remains. For 12345 -> 1+2+3+4+5 = 15 -> 1+5 = 6. (It equals 1 + (n-1) mod 9, the
// basis of casting out nines.) Showcases nested state-transition loops -- an outer
// loop that repeats while the value has more than one digit, and an inner loop
// that sums the digits via `% 10` (last digit) and `/ 10` (drop it). Each state
// receives only the values it needs; the intermediate digits are local values.
// Expected exit: 6.

use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("digital_root: collapse 12345 by repeated digit sums (15, then 6)");

    transition {
        _ -> collapse(12345)
    }

    // Outer loop: stop once the value is a single digit, else sum its digits.
    state collapse(value: i32 in Wrapping) {
        transition value < 10 {
            true -> done(value)
            _ -> digits(value, 0)
        }
    }

    // Inner loop: peel off decimal digits, adding each to the running sum.
    state digits(value: i32 in Wrapping, sum: i32 in Wrapping) {
        transition value == 0 {
            true -> collapse(sum)
            _ -> add_digit(value, sum)
        }
    }

    state add_digit(value: i32 in Wrapping, sum: i32 in Wrapping) {
        let next_sum: i32 in Wrapping = sum + value % 10;
        let remaining: i32 in Wrapping = value / 10;
        transition {
            _ -> digits(remaining, next_sum)
        }
    }

    state done(result: i32 in Wrapping) {
        Console::write_line("result: the digital root, 6 for 12345 (the exit code)");
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(result as i32);
    }
}
