// wrapping_square_sum -- a dependency-free benchmark subject.
//
// Every other hosted sample `depend()`s on omega-language-std for its
// console/exit services; this one intentionally declares no package edges so
// the benchmark harness measures a compile with no dependency settlement at
// all. The work is a self-transition loop summing squares under Wrapping:
//
//   acc += i * i   for i in 1..=2_000_000   (mod 2^64)
//
// The accumulator and the counter are loop state, not program state, so they
// travel as ordinary state arguments rather than fields of a persistent data
// instance.
//
// `main` returns through the ordinary ProgramEntry completion, so the
// runtime leg observes a deterministic clean exit on any hosted target
// without needing a ProcessExit or Console provider.
//
// Expected exit: 0

machine main() {
    transition { _ -> loop_(0, 1) }

    machine loop_(acc: u64 in Wrapping, i: u64 in Wrapping) {
        transition i <= 2000000 { true -> step(acc, i) _ -> done() }
    }
    machine step(acc: u64 in Wrapping, i: u64 in Wrapping) {
        transition { _ -> loop_(acc + i * i, i + 1) }
    }
    machine done() {}
}
