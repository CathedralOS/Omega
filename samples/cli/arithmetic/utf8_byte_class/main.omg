// Classify a UTF-8 byte by its high bits -- the natural home for shifts and casts
// used DIRECTLY in transition guards (both recently supported). A UTF-8 byte's
// shape is entirely in its leading bits:
//   0xxxxxxx  ASCII               (`b >> 7 == 0`)
//   10xxxxxx  continuation byte   (`b >> 6 == 0b10`)
//   110xxxxx  2-byte sequence lead(`b >> 5 == 0b110`)
//   1110xxxx  3-byte sequence lead(`b >> 4 == 0b1110`)
// Each classifier is an unsigned `>>` in a guard SUBJECT. A separate sanity check
// uses wrapping conversion in a guard subject: a byte with its high bit set is
// NEGATIVE when reinterpreted as `i8`, so it must NOT be ASCII.
//
// The sample classifies 0xE2 (11100010), the lead byte of a 3-byte sequence (e.g.
// the start of `€`), and exits with its class code 3.
// Expected exit: 3.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    byte: u8 in Wrapping;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("utf8_byte_class: classify a byte by its leading bits using shift/cast guards");
    main.byte = 226; // 0xE2 = 11100010, a 3-byte-sequence lead

    // High bit clear -> ASCII (0xxxxxxx). Unsigned `>>` in a guard subject.
    transition main.byte >> 7 == 0 { true -> ascii(main) _ -> high_bit_set(main) }

    // Every non-ASCII byte has its high bit set: as an i8 it is negative. A CAST
    // in a guard subject confirms the branch we are on before classifying further.
    state high_bit_set(main: &mut Main) {
        transition narrow_u8_to_i8_wrapping(main.byte as u8) < 0 {
            true -> multibyte(main)
            _ -> unreachable(main)
        }
    }

    // 10xxxxxx is a continuation byte; otherwise it is a sequence lead.
    state multibyte(main: &mut Main) {
        transition main.byte >> 6 == 2 { true -> continuation(main) _ -> lead(main) }
    }

    // 1110xxxx leads a 3-byte sequence; otherwise 110xxxxx leads a 2-byte one.
    state lead(main: &mut Main) {
        transition main.byte >> 4 == 14 { true -> lead3(main) _ -> lead2(main) }
    }

    state ascii(main: &mut Main) {
        Console::write_line("class: ASCII (0xxxxxxx) -- exit 1");
        transition { _ -> done1(main) }
    }
    state continuation(main: &mut Main) {
        Console::write_line("class: continuation byte (10xxxxxx) -- exit 4");
        transition { _ -> done4(main) }
    }
    state lead2(main: &mut Main) {
        Console::write_line("class: 2-byte sequence lead (110xxxxx) -- exit 2");
        transition { _ -> done2(main) }
    }
    state lead3(main: &mut Main) {
        Console::write_line("class: 3-byte sequence lead (1110xxxx) -- exit 3");
        transition { _ -> done3(main) }
    }
    state unreachable(main: &mut Main) {
        // A high-bit-set byte that is non-negative as i8 is impossible; guard the
        // dispatch anyway (no silent fall-through) and report the contradiction.
        Console::write_line("class: IMPOSSIBLE -- high bit set but non-negative as i8 -- exit 99");
        transition { _ -> done99(main) }
    }

    state done1(main: &mut Main) { transition { _ -> finish1(main) } }
    state done2(main: &mut Main) { transition { _ -> finish2(main) } }
    state done3(main: &mut Main) { transition { _ -> finish3(main) } }
    state done4(main: &mut Main) { transition { _ -> finish4(main) } }
    state done99(main: &mut Main) { transition { _ -> finish99(main) } }

    state finish1(main: &mut Main) { Console::write_line("[press Enter to close]"); _ = block Console::read_line(&mut main.pause); Console::exit_process(1); }
    state finish2(main: &mut Main) { Console::write_line("[press Enter to close]"); _ = block Console::read_line(&mut main.pause); Console::exit_process(2); }
    state finish3(main: &mut Main) { Console::write_line("[press Enter to close]"); _ = block Console::read_line(&mut main.pause); Console::exit_process(3); }
    state finish4(main: &mut Main) { Console::write_line("[press Enter to close]"); _ = block Console::read_line(&mut main.pause); Console::exit_process(4); }
    state finish99(main: &mut Main) { Console::write_line("[press Enter to close]"); _ = block Console::read_line(&mut main.pause); Console::exit_process(99); }
}
