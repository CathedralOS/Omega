use {omega}/language/core/float_operations.omg;
use {omega}/language/core/math.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Euclidean magnitude with ordinary standard-library math: for a classic
// 3-4-5 right triangle, |(3, 4)| = sqrt(3*3 + 4*4) = sqrt(25) = 5. The legs
// come from `abs` (distance is direction-agnostic, so a negative delta gives
// the same length), and the result is pinned into a display band with
// `clamp` -- so the sample composes imported numeric helpers with ordinary
// floating arithmetic and a named conversion in one realistic computation.
// Exits with the magnitude as its code.
// Expected exit: 5.


data Main {
    dx: f64;
    dy: f64;
    ax: f64;
    ay: f64;
    mag: f64;
    magi: i32;
    shown: i32;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("vector_distance: |(-3, 4)| = sqrt(dx*dx + dy*dy) = 5");

    // Direction-agnostic legs: |dx|, |dy| (a negative delta has the same length).
    main.dx = 0.0 - 3.0;
    main.dy = 4.0;
    main.ax = |math|::abs_f64(main.dx);
    main.ay = |math|::abs_f64(main.dy);

    // Magnitude = sqrt(ax*ax + ay*ay) = sqrt(9 + 16) = sqrt(25) = 5.
    main.mag = |math|::sqrt_f64(main.ax * main.ax + main.ay * main.ay);
    // A named saturating conversion truncates the float, then the policy erases.
    let converted: i32 in Saturating = |float_operations|::I32::from_f64(main.mag);
    main.magi = converted as i32;

    // A clamped display value (the magnitude pinned to a [0, 255] band, as a
    // colour or coordinate would be): clamp(5, 0, 255) = 5.
    main.shown = |math|::clamp_i32(main.magi, 0, 255);

    |console|::Console::write_line("result: the magnitude, 5 for a 3-4-5 triangle (the exit code)");
    |console|::Console::write_line("[press Enter to close]");
    _ = block |console|::Console::read_line(@mutable main.pause[..]);
    |process_exit|::ProcessExit::exit_process(main.shown);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
