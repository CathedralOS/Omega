// Transparent trait refinement: `trait LocalLogger<T>
// = Logger<T> { machine * suspends false; blocks
// false; terminates; machine Logger::flush
// terminates; }` — a structural bound over an existing
// conformance narrowed by operational axes only. A
// refinement is never a `satisfies` target; evidence
// binders (`B satisfies LocalLogger<Sink>`) consume
// it.
//
//   * `machine * suspends false; blocks false;
//     terminates;` — wildcard axis row applying to
//     every member.
//   * `machine Logger::flush terminates;` — member-
//     qualified narrowing on top of the wildcard.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Logger<T> {
    machine write(subject: &mut T) suspends; blocks;
    machine flush(subject: &mut T);
}

trait LocalLogger<T> = Logger<T> {
    machine * suspends false; blocks false; terminates;
    machine Logger::flush terminates;
}

data Sink {
    pending: i32;
}

machine Sink::write(sink: &mut Sink) satisfies Logger<Sink>::write {
    sink.pending = 0;
}

machine Sink::flush(sink: &mut Sink) satisfies Logger<Sink>::flush {
    sink.pending = 0;
}

data Main { sink: Sink; hits: i32 in Wrapping; }

SinkLogger satisfies Logger<Sink> {
    Logger::write = Sink::write;
    Logger::flush = Sink::flush;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.sink.pending = 9;
    transition main.sink.pending == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
