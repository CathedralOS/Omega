use omega::language::core::ProgramImage;

machine build(builder: &mut Build) suspends {
    Build::application(builder, "provider_readiness_product_dependency");
    let mut backing_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../provider_readiness/backing" });
    dependency::with_alias(&mut backing_dependency, "backing");
    let backing_registration: DependencyRegistration = Build::dependency(builder, backing_dependency);
    suspend Build::await_provider<ProgramImage, backing::TestImage>(builder);
}
