// A mutable recast may retain facts when both views carry
// the same normalized domain — `&mut main.value as &mut
// u32` on a `u32 in Small` field stays `&mut u32 in
// Small`; either view denotes the same established value
// set. The view suspends `main.value` until its last use,
// so the owner reads again after.
//
//   * `domain u32::Small(value) requires value <= 100`.
//   * `let view: &mut u32 in Small = ...` — domain-
//     qualified mutable view type.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain u32::Small(value)
requires
    value <= 100;

data Main {
    value: u32 in Small;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.value = 0;
    let view: &mut u32 in Small = &mut main.value as &mut u32;
    transition view == 0 && main.value == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
