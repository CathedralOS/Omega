use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
use omega::language::core::FunctionFieldBinding;
use omega::language::core::reflect;

machine build(builder: &mut Build) {
    Build::application(builder, "native_table_call_macos");
    let std_registration: DependencyRegistration = Build::dependency(builder,
        dependency::from_source(Source::Path { location: "../../../../source/library/std" }));
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind<Symbols::resolve>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_dlsym"
        }
    });
    Build::bind<TableFunctions::apply>(builder, macos_arm64, FunctionFieldBinding {
        table: reflect::parameter(TableFunctions::apply::table),
        field: reflect::field(FunctionTable::entry)
    });
    Build::bind<TextFunction::length>(builder, macos_arm64, FunctionFieldBinding {
        table: reflect::parameter(TextFunction::length::table),
        field: reflect::field(TextFunctions::entry)
    });
}
