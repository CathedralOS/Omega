// Cross-module const aliases keep nominal identity through the alias
// chain: `ALIAS`→`SELECTED`→`AGAIN` all denote `foreign::Token{value:7}`,
// so `Indexed<AGAIN>` and `Indexed<SELECTED>` are the same type.
use foreign::SELECTED;

data Token [copy] { value: u64; }
const ALIAS: foreign::Token = SELECTED;
const AGAIN: foreign::Token = ALIAS;
data Indexed<const N: foreign::Token> { value: u8; }

machine keep(v: Indexed<AGAIN>) -> Indexed<SELECTED> { v }

data Main { v: u8; }

machine Main::main(main: &mut Main) {
    let held: Indexed<AGAIN> = Indexed { value: 1 };
    let same: Indexed<SELECTED> = keep(held);
    main.v = same.value;
}
