// Fixed-token declaration heads: `operator +` names the builtin
// arithmetic surface, `boundary machine []` and `boundary machine [..]`
// bind fixture-owned collection operators — generic over `T`, with
// requires contracts that stay provider-agnostic.
operator + i32::add(left: i32, right: i32) -> i32;

data Table<T> {
    cells: [T; 8];
}

boundary machine [] Table::at<T>(items: &Table<T>, index: u64) -> T
requires
    index < 8;

boundary machine [..] Table::window<T>(items: &Table<T>, start: u64, end: u64) -> &Table<T>
requires
    start <= end && end <= 8;

data Main {}

machine Main::main(main: &mut Main) {
}
