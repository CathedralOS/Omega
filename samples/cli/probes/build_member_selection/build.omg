// Member selection across dependency occurrences: distinct machine
// names from two deps compose; controls pin ambiguous-name,
// private-member, and ghost-module rejections.

machine build(builder: &mut Build) {
    Build::application(builder, "build_member_selection");
    Build::depend_as(builder, "one", Source::Path { location: "dep_one" });
    Build::depend_as(builder, "two", Source::Path { location: "dep_two" });
    builder.freestanding = true;
}
