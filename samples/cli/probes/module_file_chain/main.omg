// module_file_chain: directory-module file imports as sample code — the
// first sample spanning multiple source files under one package.
//
//   * `chain/` is a directory module: each file is imported by its own
//     `use chain::<file>` spelling, and only `public` declarations cross the
//     file boundary.
//   * `chain/right.omg` imports `chain::left` for its field type; the
//     root imports both files for its own names. Visibility stays
//     file-scoped — nothing is re-exported implicitly.
//
// The machine builds Right { value: Left { value: 7 } } across the file
// boundary, reads through both levels, and accepts on 7. Compile-checked
// only: no standard-library dependency, no ProcessExit provider.
use chain::left;
use chain::right;

machine chain_depth(value: Right) -> i32 {
    value.value.value
}

machine module_file_chain() {
    let node: Right = Right { value: Left { value: 7 } };
    transition chain_depth(node) == 7 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
