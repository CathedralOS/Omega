// A `where` fact binds its own field names before module
// constants: `Holder`'s common fact and `Slot::Found`'s
// payload fact both name `value` beside `const value: u64 =
// 99` — reading the constant would make the fact
// `99 <= 5`, unsatisfiable at construction. Inside the
// state body the bare `value` still selects the constant.
//
//   * `data Holder where value <= 5`.
//   * `case Found(value: u64) where value <= 5` payload
//     where spelling.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

const value: u64 = 99;

data Holder where value <= 5 {
    value: u64;
}

data Slot {
    case Empty;
    case Found(value: u64) where value <= 5;
}

data Main {
    hits: i32 in Wrapping;
    shadow: u64;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let holder: Holder = Holder { value: 3 };
    let slot: Slot = Slot::Found { value: 4 };
    main.shadow = value;
    transition slot {
        Slot::Found { value } -> check(main, value)
        _ -> fail(main)
    }
    state check(main: &mut Main, found: u64) {
        transition found <= 5 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
