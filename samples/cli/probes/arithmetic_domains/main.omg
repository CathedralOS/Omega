// arithmetic_domains: the defined-overflow arithmetic domains as sample
// code — the first sample where the same operands observe three
// different answers chosen by the operand's domain.
//
//   * `i8 in Saturating` clamps: 100 + 100 = 200 overflows i8's signed
//     range [-128, 127], so the result is IMIN/IMAX-selected — 127.
//   * `i8 in Wrapping` wraps: the same 100 + 100 lands at -56.
//   * `u8 in Trapping` aborts on overflow, so the sample adds
//     100 + 50 = 150 — legal under u8, proving a trapping operand
//     participates in ordinary arithmetic without firing.
//
// The machine runs all three adds and accepts only on (127, -56, 150) —
// the domain is the observable difference, not the operands.
// Compile-checked only: no standard-library dependency.
machine arithmetic_domains() {
    let a: i8 in Saturating = 100;
    let b: i8 in Saturating = 100;
    let clamped: i8 in Saturating = a + b;
    let w1: i8 in Wrapping = 100;
    let w2: i8 in Wrapping = 100;
    let wrapped: i8 in Wrapping = w1 + w2;
    let t1: u8 in Trapping = 100;
    let t2: u8 in Trapping = 50;
    let trapped_free: u8 in Trapping = t1 + t2;
    transition clamped == 127 && wrapped == -56 && trapped_free == 150 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
