// Division selects its exact entry per operand carrier:
// `u64 / u64` realized-exact, `i32 / i32` truncating, `%`
// the paired remainder on the same operands — selection
// holds through every value position (let binding,
// transition argument, guard operand), so the quotient
// lands as an integer, not an anonymous rational.
//
//   * `(0i32 - 17) / 5i32 + (0i32 - 17) % 5i32` — signed
//     truncation composition -3 + -2 = -5.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let unsigned: u64 = 12u64 / 4u64;
    transition unsigned == 3u64 {
        true -> finish(main, (0i32 - 17) / 5i32 + (0i32 - 17) % 5i32)
        false -> fail(main)
    }
    state finish(main: &mut Main, value: i32) {
        transition value == (0i32 - 5) {
            true -> pass(main)
            false -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
