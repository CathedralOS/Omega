// Declarations without initializers: a bare
// `let point: Point;` may be filled member by member —
// `mut` controls whole-local rebinding, not establishment
// of record fields. A `let mut made: Point;` with no
// initializer owns its zeroed shape, so the scalar member
// read projects the declared `Trapping` field out of the
// established zero.
//
//   * `let point: Point;` member-fill local.
//   * `let mut made: Point;` zeroed member read through a
//     free machine result cast `read_x() as i32`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Point {
    x: i32 in Trapping;
    y: i32 in Trapping;
}

data Main { hits: i32 in Wrapping; }

machine read_x() -> i32 in Trapping {
    let mut made: Point;
    made.x
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let point: Point;
    point.x = 7;
    point.y = 12;
    let observed: i32 = read_x() as i32;
    transition point.x == 7 && point.y == 12 && observed == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
