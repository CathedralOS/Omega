// Cross-format float comparisons promote the narrower
// operand to the wider expression's format: an `f32`
// value at 2^24 compares UNEQUAL to the f64-computed
// `16777216.0 + 1.0` (2^24 + 1 exact in f64), while a
// widened `1.5f32` lands exactly.
//
//   * `identity(16777216.0f32) == 16777216.0 + 1.0` —
//     false: LHS is the f32 plateau value, RHS is exact.
//   * `widen(1.5f32) == 1.5` — f32→f64 widening is always
//     exact.
//   * `calls = ((calls as u64 in Wrapping) + 1) as u64`
//     — domain-cast + erase around an increment gives
//     wrapping count semantics through a `&mut` param.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::float_operations;

data Observations {
    widened: bool;
    rounded: bool;
}

machine widen(value: f32) -> f64 { value as f64 }

machine identity(value: f32) -> f32 { value }

machine compare(calls: &mut u64) -> Observations {
    calls = ((calls as u64 in Wrapping) + 1) as u64;
    Observations {
        widened: widen(1.5f32) == 1.5,
        rounded: identity(16777216.0f32) == 16777216.0 + 1.0
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut calls: u64 = 0;
    let seen: Observations = compare(&mut calls);
    transition seen.widened && !seen.rounded && calls == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
