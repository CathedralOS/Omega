// Expected exit: 0.
// Explicit static authority: the program sends 65 through a selected,
// checked local provider, stores it through an ordinary argument, and checks the
// returned value. The computed authority sets a separate phase counter to 1;
// its ordinary argument must observe 1 before advancing it to 2. A wrong result
// reaches `crash Trap`.
//
// The former `Binding<Character>` carrier lane is gone: the boundary trait is a
// static slot selected by build.omg, and each call is the requirement
// application `Character::echo(...)` / `Character::store(...)` with ordinary
// arguments. Statement, projected, forwarded-reference and computed authorities
// remain; the carrier receiver threads are what the migration removed.

public boundary trait Character {
    machine echo(value: i32) -> i32 reaches;
    machine store(output: &mut i32, value: i32) reaches;
}
CharacterImplementation satisfies Character {
    Character::echo = echo;
    Character::store = store;
}
machine echo(value: i32) -> i32 { value }
machine store(output: &mut i32, value: i32) { output = value; }

data Main { value: i32; phase: i32; }

machine letter() -> i32 { 65 }
machine write(output: &mut i32) reaches Character {
    Character::store(output, letter());
}
machine authority<'loan>(phase: &'loan mut i32) -> &'loan mut i32 {
    phase = 1;
    phase
}
machine ordinary_argument(phase: &mut i32) -> i32 {
    let previous: i32 = phase;
    phase = 2;
    transition previous == 1 { true -> 65 _ -> 0 }
}
machine Main::main(context: &mut Main) reaches Character crashes Trap {
    write(&mut context.value);
    let established: &mut i32 = authority(&mut context.phase);
    let value: i32 = Character::echo(ordinary_argument(&mut context.phase));
    let nested: i32 = Character::echo(Character::echo(context.value));
    _ = Character::echo(value);
    transition value == 65 && nested == 65 && context.phase == 2 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
