use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "static_binding_arguments" };
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, linux_arm64);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, linux_x86_64);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, macos_arm64);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, macos_x86_64);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, windows_x86_64);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, local_unchecked);
    Build::select_provider::<|app|::Character, |app|::CharacterImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
}
