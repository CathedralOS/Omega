// Const record field projection as a const-generic
// binder: `const PROJECTED: u64 = SOURCE.value` reads a
// record-typed const's field, then `Indexed<PROJECTED>`
// instantiates the data param — a machine returning
// `Indexed<7>` proves the projection and the literal
// arrive at the same binder.
//
//   * `const SOURCE: Source = Source { value: 7 }`.
//   * `data Indexed<const Choice: u64>`.
//   * `keep(value: Indexed<PROJECTED>) -> Indexed<7>` —
//     projection ≡ literal at the signature.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Source [copy] { value: u64; }
const SOURCE: Source = Source { value: 7 };
const PROJECTED: u64 = SOURCE.value;

data Indexed<const Choice: u64> { value: u8; }

machine keep(value: Indexed<PROJECTED>) -> Indexed<7> { value }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let held: Indexed<PROJECTED> = Indexed { value: 3 };
    let returned: Indexed<7> = keep(held);
    transition returned.value == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
