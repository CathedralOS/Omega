// Narrowed `&mut` slice views keep their own loan and element
// coordinates: `tail[0]` is the parent's element 1, not a
// spelling of element zero. Whole-element replacement and
// nested re-narrowing ride the same view.
//
//   * `fill(exits: &mut [Exit]) requires exits.len >= 4`.
//   * `let tail: &mut [Exit] = &mut exits[1..3]` then
//     `tail[1] = blank_exit(43)`.
//   * `let nested: &mut [Exit] = &mut tail[1..2]` re-narrow.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Exit [copy] { code: u64; open: bool; }

machine blank_exit(code: u64) -> Exit {
    Exit { code: code, open: true }
}

machine fill(exits: &mut [Exit])
requires exits.len >= 4
{
    let tail: &mut [Exit] = &mut exits[1..3];
    tail[0].code = 11;
    tail[1] = blank_exit(43);
    let nested: &mut [Exit] = &mut tail[1..2];
    nested[0].open = false;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut exits: [Exit; 4] = [Exit { code: 1, open: true }, Exit { code: 2, open: true }, Exit { code: 3, open: true }, Exit { code: 4, open: true }];
    let view: &mut [Exit] = &mut exits[..];
    fill(view);
    let outcome: bool = exits[1].code == 11
        && exits[2].code == 43
        && exits[2].open == false
        && exits[0].code == 1;
    transition outcome {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
