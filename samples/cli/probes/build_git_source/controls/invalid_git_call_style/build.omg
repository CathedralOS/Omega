use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_git_call_style" };
    let package_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Git("https://example.invalid/kit.git", "deadbeef", PackageSelection::Root {})));
}
