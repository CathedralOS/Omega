machine build(builder: &mut Build) {
    Build::application(builder, "invalid_git_unreachable");
    builder.freestanding = true;
    let kit_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Git { repository: "https://example.invalid/kit.git", revision: "deadbeef", selection: PackageSelection::Named { package: "kit" } }));
}
