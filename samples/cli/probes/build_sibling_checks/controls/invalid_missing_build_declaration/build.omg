// The dependency location holds product source but no build declaration at
// all, so the package row is malformed rather than merely unresolvable.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_missing_build_declaration");
    let mut dep_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "no_build" });
    dependency::with_alias(&mut dep_dependency, "dep");
    let dep_registration: DependencyRegistration = Build::dependency(builder, dep_dependency);
    builder.freestanding = true;
}
