// The self edge resolves to this package's own application declaration, so
// the product row still fails the package-purpose check rather than
// recursing into the requester.

use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_self_edge" };
    let mutable self_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "." });
    |dependency|::with_alias(@mutable self_dependency, "self");
    let self_registration: DependencyRegistration = Build::dependency(builder, self_dependency);
}
