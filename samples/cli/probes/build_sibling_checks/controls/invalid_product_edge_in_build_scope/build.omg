// `prod` is a Product scope edge: the request grants no Build scope row for
// it. Importing the alias into this build activation asks for an
// unrequested purpose row and must be rejected.

use {omega}/build/dependency.omg;
use {prod}/main.omg as prod;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_product_edge_in_build_scope" };
    let mutable prod_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../sibling_a" });
    |dependency|::with_alias(@mutable prod_dependency, "prod");
    let prod_registration: DependencyRegistration = Build::dependency(builder, prod_dependency);
}
