// `prod` is a Product scope edge: the request grants no Build scope row for
// it. Importing the alias into this build activation asks for an
// unrequested purpose row and must be rejected.

use prod::main;

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_product_edge_in_build_scope");
    let mut prod_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../sibling_a" });
    dependency::with_alias(&mut prod_dependency, "prod");
    let prod_registration: DependencyRegistration = Build::dependency(builder, prod_dependency);
    builder.freestanding = true;
    let observed: i32 = a_value();
    transition observed == 10 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
