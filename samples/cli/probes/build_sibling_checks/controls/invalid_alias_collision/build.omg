// Two product occurrences carry the same alias `x` on different packages:
// the second row collides with the first instead of shadowing it, and the
// malformed occurrence batch must be rejected.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_alias_collision");
    Build::depend_as(builder, "x", Source::Path { location: "dep" });
    Build::depend_as(builder, "x", Source::Path { location: "dep2" });
    builder.freestanding = true;
}
