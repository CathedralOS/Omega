// Two product occurrences carry the same alias `x` on different packages:
// the second row collides with the first instead of shadowing it, and the
// malformed occurrence batch must be rejected.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_alias_collision");
    let mut x_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dep" });
    dependency::with_alias(&mut x_dependency, "x");
    let x_registration: DependencyRegistration = Build::dependency(builder, x_dependency);
    let mut x_dependency_2: DependencyDescription = dependency::from_source(Source::Path { location: "dep2" });
    dependency::with_alias(&mut x_dependency_2, "x");
    let x_registration_2: DependencyRegistration = Build::dependency(builder, x_dependency_2);
    builder.freestanding = true;
}
