use {omega}/build/dependency.omg;
use main.omg as app;

machine build(plan: @mutable BuildPlan) {
    let mutable a: DependencyDescription = |dependency|::from_source(Source::Path { location: "sibling_a" });
    |dependency|::with_alias(@mutable a, "a");
    _ = |dependency|::add(plan, a);
    let mutable b: DependencyDescription = |dependency|::from_source(Source::Path { location: "sibling_b" });
    |dependency|::with_alias(@mutable b, "b");
    _ = |dependency|::add(plan, b);
    let mutable c: DependencyDescription = |dependency|::from_source(Source::Path { location: "sibling_c" });
    |dependency|::with_alias(@mutable c, "c");
    _ = |dependency|::add(plan, c);
    plan.product = BuildProduct::Application { name: "build_sibling_checks" };
    Build::bind(plan, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(plan, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(plan, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(plan, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(plan, windows_arm64::ProgramEntry, |app|::main);
}
