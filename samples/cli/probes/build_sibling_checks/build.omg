// Three sibling packages are checked as one occurrence batch, and every
// sibling's build consults the same shared package through a build edge.
// The shared build must evaluate once across the sibling batch and across
// every requested target; each sibling still stages its own generated
// product source through its own required output.

machine build(builder: &mut Build) {
    Build::application(builder, "build_sibling_checks");
    let mut a_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "sibling_a" });
    dependency::with_alias(&mut a_dependency, "a");
    let a_registration: DependencyRegistration = Build::dependency(builder, a_dependency);
    let mut b_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "sibling_b" });
    dependency::with_alias(&mut b_dependency, "b");
    let b_registration: DependencyRegistration = Build::dependency(builder, b_dependency);
    let mut c_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "sibling_c" });
    dependency::with_alias(&mut c_dependency, "c");
    let c_registration: DependencyRegistration = Build::dependency(builder, c_dependency);
    builder.freestanding = true;
}
