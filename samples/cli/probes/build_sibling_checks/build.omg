// Three sibling packages are checked as one occurrence batch, and every
// sibling's build consults the same shared package through a build edge.
// The shared build must evaluate once across the sibling batch and across
// every requested target. Each sibling publishes its own source bytes and
// settles its own promised output.

use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_sibling_checks" };
    let mutable a_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "sibling_a" });
    |dependency|::with_alias(@mutable a_dependency, "a");
    let a_registration: DependencyRegistration = Build::dependency(builder, a_dependency);
    let mutable b_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "sibling_b" });
    |dependency|::with_alias(@mutable b_dependency, "b");
    let b_registration: DependencyRegistration = Build::dependency(builder, b_dependency);
    let mutable c_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "sibling_c" });
    |dependency|::with_alias(@mutable c_dependency, "c");
    let c_registration: DependencyRegistration = Build::dependency(builder, c_dependency);
}
