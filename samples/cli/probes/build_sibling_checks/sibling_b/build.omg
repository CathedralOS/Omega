use {omega}/build/dependency.omg;

machine build(plan: @mutable BuildPlan) {
    let mutable package: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../build_sibling_checks_support" });
    |dependency|::with_alias(@mutable package, "shared");
    _ = |dependency|::add(plan, package);
    plan.product = BuildProduct::InterpretedBuild { entry: "generate.omg" };
}
