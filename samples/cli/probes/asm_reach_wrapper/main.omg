// Assembly service reach: a helper body `asm { hlt }` declares
// `reaches MachineControl` — the ordinary wrapper inherits the
// declared service without spelling it.
//
//   * `use omega::language::core::assembly` depend-free.
//   * `machine helper() reaches MachineControl`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::assembly;

machine helper() reaches MachineControl {
    asm { hlt }
}

machine main() {
    helper();
}
