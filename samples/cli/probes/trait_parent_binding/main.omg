// A child trait pins its parent's arguments:
// `trait IntSink<S>: Sink<S, i32>` inherits `put`
// already specialized to `i32`, so satisfying the
// child names the parent's member — `Sink::put =
// Counter::put` inside `satisfies IntSink<Counter>`.
//
//   * The implementing machine still carries
//     `satisfies Sink<Counter, i32>::put` — the
//     parent application, not the child.
//   * `Counter::put(&mut main.counter, 7)` calls the
//     satisfied member directly.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Sink<S, T> {
    machine put(sink: &mut S, value: T);
}

trait IntSink<S>: Sink<S, i32> {
}

data Counter {
    value: i32;
}

CounterIntSink satisfies IntSink<Counter> {
    Sink::put = Counter::put;
}

machine Counter::put(counter: &mut Counter, value: i32) satisfies Sink<Counter, i32>::put {
    counter.value = value;
}

data Main { counter: Counter; hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    Counter::put(&mut main.counter, 7);
    transition main.counter.value == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
