// `builder.optimizations` counters are at-most-once request
// markers: writing `= 1` directly selects the optimization/report;
// `Optimizations::enable` and `emit_report` increment the same
// counters. Any counter reaching 2 rejects at Build validation.
machine build(builder: &mut Build) {
    Build::application(builder, "build_optimization_requests");
    builder.freestanding = true;
    builder.optimizations.copy_propagation = 1;
    builder.optimizations.control_flow_cleanup = 1;
    builder.optimizations.human_report = 1;
}
