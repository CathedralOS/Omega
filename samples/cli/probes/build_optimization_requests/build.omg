// `builder.optimizations` counters are at-most-once request
// markers: writing `= 1` directly selects the optimization/report;
// `Optimizations::enable` and `emit_report` increment the same
// counters. Any counter reaching 2 rejects at Build validation.
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_optimization_requests" };
    builder.optimizations.selected[2] = 1 as +Saturating;
    builder.optimizations.selected[0] = 1 as +Saturating;
    builder.optimizations.human_report = 1 as +Saturating;
}
