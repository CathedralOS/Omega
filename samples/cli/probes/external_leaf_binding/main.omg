// `satisfies Trait::method via <binding>` — the direct
// external-leaf spelling: a target-scoped machine binds
// one boundary-trait method to one mechanism from the
// closed `ForeignBinding` sum — `Syscall(1)`, an
// evaluated typed `DllImport` locator, and a named
// `VtableField` — without a `provides` table.
//
//   * `macos_arm64 machine X satisfies Mixed::via_*
//     via ...` — the binding rides the satisfies clause.
//   * `machine import_binding() -> ForeignBinding<17,
//     5, 0>` — a machine call AS the via-target (the
//     evaluated locator).
//   * `NativeTable::vtable_leaf` — vtable field cited
//     member-wise.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider; core external_binding is
// depend-free.

use omega::language::core::external_binding;

boundary trait Mixed {
    machine via_syscall() reaches Mixed;
    machine via_import() reaches Mixed;
    machine via_vtable() reaches Mixed;
}

macos_arm64 machine syscall_leaf() satisfies Mixed::via_syscall via ForeignBinding::Syscall(1);
macos_arm64 machine import_binding() -> ForeignBinding<17, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_exit",
        },
    }
}
macos_arm64 machine import_leaf() satisfies Mixed::via_import via import_binding();
data NativeTable { reserved0: addr; reserved1: addr; via_vtable: addr; }
macos_arm64 machine NativeTable::vtable_leaf() satisfies Mixed::via_vtable via ForeignBinding::VtableField(via_vtable);

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
