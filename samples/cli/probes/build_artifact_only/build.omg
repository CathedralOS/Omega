// `Build::artifact_only(builder)` selects the artifact-only application
// mode: the build produces artifacts and performs no product compile.
// It still drives the full required-output custody loop.

machine build(builder: &mut Build) {
    Build::application(builder, "build_artifact_only");
    Build::artifact_only(builder);
    builder.freestanding = true;
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "blob.bin");
    let path: BuildPath = BuildOutput::resolve(&builder.output, "blob.bin");
    let writer: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, writer, "blobdata\n");
    let _sealed: i32 = BuildOutput::close(&mut builder.output, writer);
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, path);
    settle(builder, settled);
}

machine settle(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "require did not settle");
    }
}
