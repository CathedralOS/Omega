// A generic conditional returns one owner and cleans only the other:
// `pick` selects between two guards, and the unselected arm's owner is
// dropped at the return.
use omega::language::core::drop;

data Guard { handle: i32; }
machine Guard::drop(guard: &mut Guard) {
    guard.handle = 0;
}

machine pick(flag: bool, a: Guard, b: Guard) -> Guard {
    transition flag {
        true -> (a)
        _ -> (b)
    }
}

data Main { handle: i32; }

machine Main::main(main: &mut Main) {
    let kept: Guard = pick(true, Guard { handle: 7 }, Guard { handle: 9 });
    main.handle = kept.handle;
    drop(kept);
}
