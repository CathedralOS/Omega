// Case-store shapes: common fields beside payloads — a case
// replacement naming NO common field zeroes them all (zero
// satisfies their default domain); local-mediated stores
// (`let v: T = T::Case{..}; main.f = v`); an interval-domained
// payload member (`i32 in Ten`) discharges a requires through
// its domain alone.
//
//   * `main.slot = Slot::Ready { level: 5 }` (commons zeroed).
//   * `scale(level)` `requires level in Ten` discharged by the
//     dispatched payload.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain i32::Ten(value) requires value >= 0 && value <= 10;

data Slot {
    stamp: u32;
    case Idle;
    case Ready(level: i32 in Ten);
}

machine scale(level: i32) -> i32
requires level in Ten
{
    level
}

machine read(slot: &Slot) -> i32 in Wrapping {
    transition slot {
        Slot::Ready { stamp as _, level } -> value(scale(level) as i32 in Wrapping)
        Slot::Idle -> value(0)
    }
    state value(code: i32 in Wrapping) -> i32 in Wrapping { code }
}

data Main {
    slot: Slot;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.slot = Slot::Ready { level: 5, stamp: 9 };
    let fresh: Slot = Slot::Ready { level: 3 };
    main.slot = fresh;
    transition main.slot.stamp == 0 && read(&main.slot) == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
