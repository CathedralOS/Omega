// Expected exit: 0.
// Runtime implementation selection must preserve the borrowed result's backing.
use {omega}/language/core/option.omg;

trait Scan<T> {
    machine first(values: @[T], threshold: T) -> |option|::Optional<@T>;
}

machine at_least(value: @i32, threshold: i32) -> bool { $value >= threshold }
machine below(value: @i32, threshold: i32) -> bool { $value < threshold }

machine search<'input, machine Compare>(values: @'input [i32], threshold: i32)
    -> |option|::Optional<@'input i32>
requires machine Compare(value: @i32, threshold: i32) -> bool;
{
    transition { _ -> next(values, threshold, 0) }

    machine next(values: @'input [i32], threshold: i32, position: u64)
        -> |option|::Optional<@'input i32>
    requires position <= values.length {
        transition position < values.length {
            true -> inspect(values, threshold, position),
            false -> |option|::Optional::None
        }
    }

    machine inspect(values: @'input [i32], threshold: i32, position: u64)
        -> |option|::Optional<@'input i32>
    requires position < values.length {
        transition Compare(@values[position], threshold) {
            true -> |option|::Optional::Some { value: @values[position] },
            false -> next(values, threshold, position + 1)
        }
    }
}

AtLeast satisfies Scan<i32> {
    machine first(values: @[i32], threshold: i32) -> |option|::Optional<@i32> {
        search::<at_least>(values, threshold)
    }
}

Below satisfies Scan<i32> {
    machine first(values: @[i32], threshold: i32) -> |option|::Optional<@i32> {
        search::<below>(values, threshold)
    }
}

machine scan<'input>(selected: dyn Scan<i32>, values: @'input [i32], threshold: i32)
    -> |option|::Optional<@'input i32>
{
    Scan::first(selected, values, threshold)
}

machine observed(found: |option|::Optional<@i32>) -> i32 {
    transition found {
        |option|::Optional::Some { value } -> (value),
        |option|::Optional::None -> -100
    }
}

machine main() crashes Trap {
    let values: [i32; 5] = [-3, 7, 0, -1, 9];
    let mutable selected: dyn Scan<i32> = AtLeast as dyn Scan<i32>;
    let high: |option|::Optional<@i32> = scan(selected, @values, 6);
    selected = Below as dyn Scan<i32>;
    let low: |option|::Optional<@i32> = scan(selected, @values, 0);
    let empty: |option|::Optional<@i32> = scan(selected, values[..0], 0);
    let absent: |option|::Optional<@i32> = scan(selected, @values, -10);
    let suffix: |option|::Optional<@i32> = scan(selected, values[2..], 0);
    transition observed(high) == 7 && observed(low) == -3
        && observed(empty) == -100 && observed(absent) == -100
        && observed(suffix) == -1 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
