// Index 2 of a two-entry contact ledger is outside the array.

data Control { contacts: [u32; 2]; observed: u32; }

machine Control::main(control: &mut Control) {
    control.contacts = [7, 3];
    control.observed = control.contacts[2];
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Control;
    Control::main(&mut entry_storage);
}
