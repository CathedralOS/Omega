// Write-only loans project through members: `&write
// Pair` forwards into a state that re-lends `&write
// destination.left` — the attenuation composes member-
// wise while the sibling field stays untouched.
//
//   * `forward(&write pair, choose_left, value)` —
//     one write-only record loan, two member routes.
//   * `replace(&write destination.left, value)` —
//     member projection carries the qualifier.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Pair { left: i32; right: i32; }

machine replace(destination: &write i32, value: i32) {
    destination = value;
}

machine forward(destination: &write Pair, choose_left: bool, value: i32) {
    transition choose_left {
        true -> left(&write destination, value)
        false -> right(&write destination, value)
    }
    state left(destination: &write Pair, value: i32) {
        replace(&write destination.left, value);
    }
    state right(destination: &write Pair, value: i32) {
        replace(&write destination.right, value);
    }
}

data Main { pair: Pair; hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.pair.left = 7;
    main.pair.right = 19;
    forward(&write main.pair, true, 42);
    transition main.pair.left == 42 && main.pair.right == 19 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
