// affine_move_carry: affine values — the first sample where plain data
// (no [copy] marker) moves through calls and cycles exactly once.
//
//   * `route` moves `ticket` into `take` on the true arm only; the false
//     arm leaves the binding untouched and hands `take` a fresh Ticket —
//     each arm consumes exactly one value.
//   * `loop_until` carries `ticket` through the `spin` cycle on every
//     iteration and delivers it to `finish` on exit — the affine value
//     stays live across the loop without copying.
//   * `direct` reads a moved-into-call result (70) and `diverted` reads
//     the untouched arm's fresh construction (71).
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Ticket { value: i32; }

machine route(ticket: Ticket, selected: bool) -> i32 {
    transition selected {
        true -> take(ticket)
        _ -> take(Ticket { value: 71 })
    }

    machine take(ticket: Ticket) -> i32 { ticket.value }
}

machine loop_until(ticket: Ticket, n: u8) -> i32 {
    transition { _ -> spin(ticket, n) }

    machine spin(ticket: Ticket, n: u8) -> i32 {
        transition n < 2 {
            true -> spin(ticket, n + 1)
            _ -> finish(ticket)
        }
    }

    machine finish(ticket: Ticket) -> i32 { ticket.value }
}

machine affine_move_carry() {
    let direct: i32 = route(Ticket { value: 70 }, true);
    let diverted: i32 = route(Ticket { value: 12 }, false);
    let carried: i32 = loop_until(Ticket { value: 70 }, 0);
    transition direct == 70 && diverted == 71 && carried == 70 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
