// Sum-case and structured-payload identities carry explicit numbering:
// `case #1 Found(#1 value: T, retired #2)` numbers the case, its
// payload member, and a retired slot; `retired #3` retires a whole
// case position. These are stable data metadata — they do not select
// or alter the runtime discriminant.
data Lookup<T> {
    case #1 Found(#1 value: T, retired #2);
    case #2 Missing;
    retired #3;
}
machine pick<T>(query: T) -> Lookup<T> { Lookup::Found { value: query } }
data Main {
    entry: Lookup<u8>;
}
machine Main::main(main: &mut Main) {
    main.entry = pick(9u8);
    transition main.entry {
        Lookup::Found { value } -> found(value)
        Lookup::Missing -> missing()
    }
    state found(value: u8) { }
    state missing() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
