// Direct and mutual recursive data are legal to declare; the proof-only
// classification fences runtime consumption, not declaration.
data Nat { case Zero; case Succ(prev: Nat); }
data Tree { case Leaf; case Node(forest: Forest); }
data Forest { case Empty; case Grow(tree: Tree, rest: Forest); }
data Main { out: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.out = main.out + 70;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
