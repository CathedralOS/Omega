use omega::language::core::layout;
// A plan-laid value whose three logical fields share ONE byte: `code` is
// itself split across two `FieldPlan::Bits` fragments — masked RMW writes
// preserve siblings and reads reconstruct the scalar.
public domain u8::Mode(value) requires value <= 7;
public domain u8::Code(value) requires value <= 15;

public data PackedFlags { present: bool; mode: u8 in Mode; code: u8 in Code; }
data CompactBits {}
machine CompactBits::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 0,
            source_lsb: 0,
            width: 1,
        },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 1,
            source_lsb: 0,
            width: 3,
        },
    };
    entries[2] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 4,
            source_lsb: 0,
            width: 2,
        },
    };
    entries[3] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 6,
            source_lsb: 2,
            width: 2,
        },
    };
    Plan {
        entries: entries,
        entry_count: 4,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
data Main { packed: CompactBits<PackedFlags>; }
machine Main::main(main: &mut Main) {
    main.packed.present = true;
    main.packed.mode = 5;
    main.packed.code = 10;
    transition main.packed.present == true && main.packed.mode == 5
        && main.packed.code == 10 {
        true -> done()
        false -> bad()
    }
    state done() { }
    state bad() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
