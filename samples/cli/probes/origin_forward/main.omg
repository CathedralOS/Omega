// Immutable `let` keeps the entry origin: forwarding `held`
// into `last` preserves the exact incoming identity, so
// `ensures result == input` still proves — and a chained
// `a -> b` copy preserves it too. Mutability and unrelated
// bindings stay opaque (fail canaries).
//
//   * `machine held_local(input) -> i32 ensures
//     result == input`.
//   * `transition { _ -> last(held) }` origin edge.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine held_local(input: i32) -> i32
ensures result == input
{
    let held: i32 = input;
    transition { _ -> last(held) }
    machine last(carried: i32) -> i32 {
        carried
    }
}

machine held_chained(input: i32) -> i32
ensures result == input
{
    let a: i32 = input;
    let b: i32 = a;
    transition { _ -> last(b) }
    machine last(carried: i32) -> i32 {
        carried
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = (held_local(7) as i32 in Wrapping) + (held_chained(9) as i32 in Wrapping);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
