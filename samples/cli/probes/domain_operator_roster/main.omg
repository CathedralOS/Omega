// Domain-scoped operator declarations: `operator D::name(args) -> T;`
// registers an operator spelling on the domain's members, overloadable
// by operand type. These are declarations — the domain's requires
// decides which values the operator may see.
//
//   * `Quantity::Additive` — value-nonnegative domain.
//   * `operator Quantity::Additive::combine` on i32 and u64 operands.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Quantity {
    value: i32;
}

domain Quantity::Additive(quantity)
requires
    quantity.value >= 0;

operator Quantity::Additive::combine(left: i32, right: i32) -> i32;
operator Quantity::Additive::combine(left: u64, right: u64) -> u64;

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
