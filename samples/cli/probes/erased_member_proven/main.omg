// An `[erased]` payload member is supplied from its unique nullary
// constructor at construction — it takes no runtime position, so the
// dispatched payload keeps its value and `proof as _` waives it.
data Evidence { case Only; }
data Certified {
    case Proven(value: i32, proof [erased]: Evidence);
    case Void;
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let c: Certified = Certified::Proven { value: 5 };
    transition c {
        Certified::Proven { value, proof as _ } -> seen(main, value)
        Certified::Void -> bad(main)
    }
    state seen(main: &mut Main, value: i32) {
        main.hits = main.hits + (value as i32 in Wrapping);
    }
    state bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
