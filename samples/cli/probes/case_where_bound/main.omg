// Case-where ordering facts: `case Range(lo, hi) where
// lo <= hi` contributes a branch-local `lo <= hi` proposition
// on the destructured subject — the target state's
// `requires lo <= hi` proves at arrival with no other
// evidence (the subject isn't constructed here, so
// construction-fold evidence can't supply it — only the
// arm can).
//
//   * `transition main.interval` dispatch with `{ lo, hi }`
//     shorthand.
//   * State-level `requires` roster.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Interval {
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}

data Main { interval: Interval; }

machine Main::main(main: &mut Main) {
    main.interval = Interval::Range { lo: 3, hi: 7 };
    transition main.interval {
        Interval::Range { lo, hi } -> take(lo, hi)
        Interval::Empty -> done()
    }
    state take(lo: u64, hi: u64)
    requires
        lo <= hi
    {
    }
    state done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
