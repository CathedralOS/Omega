// Calls in every operand position: cast parent, comparison
// operand, either side of a binary, call argument, field store,
// transition guard subject — plus ordered evaluation
// (`tick() * 10 + tick()` runs once per operand) and short-circuit
// (`false && tick()` never runs the right operand).
//
//   * `twelve() as i64`, `twelve() == 12`, `0 - twelve()`,
//     `Main::add(main, twelve(), twelve())`, `main.total =
//     twelve() * 2`, `transition twelve() + 1 == 13`.
//   * `ticks` counts side effects to prove ordered single
//     evaluation and the skipped right operand.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine twelve() -> i32
ensures result == 12
{
    transition { _ -> (12) }
}

data Main {
    total: i32;
    ticks: u32 in Wrapping;
    hits: i32 in Wrapping;
}

machine Main::add(main: &mut Main, left: i32, right: i32) -> i32
requires 0 <= left && left <= 100 && 0 <= right && right <= 100
{
    left + right
}

machine Main::tick(main: &mut Main) -> i32 {
    main.ticks = main.ticks + 1;
    12
}

machine Main::main(main: &mut Main) {
    main.total = 0;
    main.ticks = 0;
    main.hits = 0;
    main.total = twelve() * 2;
    let casted: i64 = twelve() as i64;
    let cmp: bool = twelve() == 12;
    let neg: i32 = 0 - twelve();
    let summed: i32 = Main::add(main, twelve(), twelve());
    let ordered: i32 = Main::tick(main) * 10 + Main::tick(main);
    let skipped: bool = false && Main::tick(main) == 3;
    transition twelve() + 1 == 13
        && casted == 12 && cmp && neg == -12 && summed == 24
        && ordered == 132 && main.ticks == 2 && !skipped
        && main.total == 24 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
