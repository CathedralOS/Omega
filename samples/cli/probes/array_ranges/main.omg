// Direct array ranges `main.values[1..3]` spell bounds obligations
// discharged by the known-length proof — including the empty range
// `[3..3]` at the end — and `values[0]` indexing.
//
//   * `main.values[1..3]` exclusive + `main.values[3..3]` empty-end.
//   * `hits` records the reached arm.
//
// GAP filed: `use omega::language::core::slice` + `view[1..3]` on an
// existing slice (or `&xs[..]` view) selects a private
// `Slice::range$specialized$` machine — slice-of-slice ranges are
// unspellable from ordinary packages.
//   * `hits` records the reached arm.
//
// Compile-checked only: `core::slice` is a depend-free core import;
// no standard-library dependency, no ProcessExit provider.


data Main {
    values: [i32; 3];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let first: i32 = main.values[0];
    let middle: &[i32] = main.values[1..3];
    let empty: &[i32] = main.values[3..3];
    transition middle.len == 2 && empty.len == 0 && first == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
