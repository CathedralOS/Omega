// `use contracts::drawable;` imports a trait from a sibling
// directory file; a free machine satisfies it with
// `satisfies Drawable<Sprite, Canvas>::draw`.
//
//   * `Sprite::draw` attached machine satisfies the imported
//     trait requirement.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use contracts::drawable;

data Canvas {
    width: i32;
}

data Sprite {
    id: i32;
}

machine Sprite::draw(sprite: &Sprite, canvas: &mut Canvas) satisfies Drawable<Sprite, Canvas>::draw {
    canvas.width = 80;
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut canvas: Canvas;
    let sprite: Sprite;
    Sprite::draw(&sprite, &mut canvas);
    transition canvas.width == 80 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
