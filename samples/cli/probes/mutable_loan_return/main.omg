// Mutable-loan returns: a machine's `-> &mutable Room` selects the loan
// in a transition arm (`true -> &mutable level.rooms[0]`). The returned
// borrow covers all of `level`, so sibling fields are read BEFORE
// the loan forms; the disjoint-fields rule keeps the selected room
// a single-loan target.
//
//   * `choose(level, first) -> &mutable Room` — loan as arm result.
//   * `room.flag = ...` / `room.value = ...` — writes through the
//     returned borrow.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Room [copy] { value: u64; flag: bool; }
data Level [copy] { rooms: [Room; 3]; start: u64; counter: u64; }

machine choose(level: @mutable Level, first: bool) -> @mutable Room {
    transition first {
        true -> @mutable level.rooms[0],
        false -> @mutable level.rooms[1]
    }
}

machine update(level: @mutable Level, first: bool) {
    let counter: u64 = level.counter;
    let room: @mutable Room = choose(level, first);
    room.flag = first;
    room.value = counter;
}

data Main {
    level: Level;
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    main.level.counter = 37;
    update(@mutable main.level, true);
    update(@mutable main.level, false);
    transition main.level.rooms[0].value == 37
        && main.level.rooms[1].value == 37
        && main.level.rooms[0].flag
        && !main.level.rooms[1].flag {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
