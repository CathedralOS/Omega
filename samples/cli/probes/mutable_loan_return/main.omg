// Mutable-loan returns: a machine's `-> &mut Room` selects the loan
// in a transition arm (`true -> &mut level.rooms[0]`). The returned
// borrow covers all of `level`, so sibling fields are read BEFORE
// the loan forms; the disjoint-fields rule keeps the selected room
// a single-loan target.
//
//   * `choose(level, first) -> &mut Room` — loan as arm result.
//   * `room.flag = ...` / `room.value = ...` — writes through the
//     returned borrow.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Room [copy] { value: u64; flag: bool; }
data Level [copy] { rooms: [Room; 3]; start: u64; counter: u64; }

machine choose(level: &mut Level, first: bool) -> &mut Room {
    transition first {
        true -> &mut level.rooms[0]
        false -> &mut level.rooms[1]
    }
}

machine update(level: &mut Level, first: bool) {
    let counter: u64 = level.counter;
    let room: &mut Room = choose(level, first);
    room.flag = first;
    room.value = counter;
}

data Main {
    level: Level;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.level.counter = 37;
    update(&mut main.level, true);
    update(&mut main.level, false);
    transition main.level.rooms[0].value == 37
        && main.level.rooms[1].value == 37
        && main.level.rooms[0].flag
        && !main.level.rooms[1].flag {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
