// Expected exit: 0.
// Counts and addresses remain distinct. Each exact conversion proves fit from
// the values at that occurrence; no native-width equality or memory grant.
data Main { base: address; }
data Cell [copy] { value: u64; }
data Packet [copy] { cell: Cell; }

machine identity(value: u64) -> u64 ensures result == value { value }

machine from_field(packet: @Packet, witness: address) -> address
requires embed(packet.cell.value) + 1 <= embed(witness)
{ packet.cell.value as address }

machine from_result(value: u64, witness: address) -> address
requires embed(value) == embed(witness)
{ identity(value) as address }

machine in_state(value: u64, witness: address) -> address
requires embed(value) == embed(witness)
{
    transition { _ -> convert(value, witness) }
    machine convert(value: u64, witness: address) -> address
    requires embed(value) == embed(witness)
    { value as address }
}

machine to_count(address: address, witness: u64) -> u64
requires embed(address) == embed(witness)
{ address as u64 }

machine model_count(context: @Main) -> u64
requires address::Bound == 18446744073709551616
{ context.base as u64 }

machine from_snapshot(cell: @mutable Cell, witness: address) -> address
requires embed(cell.value) == embed(witness)
{
    let saved: u64 = cell.value;
    cell.value = 18446744073709551615;
    saved as address
}

machine Main::main(context: @mutable Main) crashes Trap
requires address::Bound == 18446744073709551616
{
    let witness: address = 4096;
    let packet: Packet = Packet { cell: Cell { value: 4095 } };
    let first: address = from_field(@packet, witness);
    let second: address = from_result(4096, witness);
    context.base = in_state(4096, witness);
    let restored: u64 = to_count(witness, 4096);
    let model_restored: u64 = model_count(context);
    let mutable snapshot: Cell = Cell { value: 4096 };
    let saved_address: address = from_snapshot(@mutable snapshot, witness);
    transition first == 4095 && second == witness &&
               context.base == witness && restored == 4096 && model_restored == 4096 &&
               saved_address == witness && snapshot.value == 18446744073709551615 {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap
requires address::Bound == 18446744073709551616
{
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
