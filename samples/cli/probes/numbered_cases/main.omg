// Numbered case identities: `#N` tags on cases and payload members
// are ordinary data metadata — stable identities that do not alter
// the runtime discriminant. `retired` members keep historical
// numbers reserved.
//
//   * `case #1 Found(#1 value: T, retired #2)` — numbered generic
//     case with a numbered payload member and a retired slot.
//   * `retired #3` — retired member on the data itself.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Lookup<T [copy]> [copy] {
    case #1 Found(#1 value: T, retired #2);
    case #2 Missing;
    retired #3;
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let found: Lookup<u64> = Lookup::Found { value: 41 };
    transition found {
        Lookup::Found { value } -> have(main, value)
        Lookup::Missing -> miss(main)
    }
    state have(main: &mut Main, value: u64) {
        transition value == 41 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state miss(main: &mut Main) {
        transition { _ -> fail(main) }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
