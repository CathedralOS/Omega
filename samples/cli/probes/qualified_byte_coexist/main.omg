// A plain `[u8; 4]` and a `[u8; 4] in Utf8` of the same
// extent coexist in one owner — each keeps its own
// structural plan, so lending and reading one never
// reaches the other's representation.
//
//   * `domain [u8; 4]::Utf8 requires valid_utf8` —
//     fixed-extent qualified byte owner.
//   * `bytes == "gate"` — whole-array equality against
//     a byte literal.
//   * `head(&[u8; 4])` lends the plain array as a
//     bounded view.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);

machine head(bytes: &[u8; 4]) -> u8 {
    transition { _ -> (bytes[0]) }
}

machine spells_gate(bytes: &[u8]) -> bool {
    transition { _ -> (bytes.len == 4 && bytes == "gate") }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut plain: [u8; 4] = "GATE";
    let text: [u8; 4] in Utf8 = "gate";
    let last: u8 = plain[3];
    let top: u8 = head(&plain);
    let gate: bool = spells_gate(&text[..]);
    transition last == 69 && top == 71 && gate {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
