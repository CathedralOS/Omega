// Transitive call frames preserve disjoint caller facts:
// `Main::middle` calls `Main::touch`, and neither writes
// `stable` — may-write summaries compose through sibling
// calls, so the caller's local facts survive the whole
// chain.
//
//   * Three-deep attached-machine call chain.
//   * Post-call `stable + 1` reads the preserved fact.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut stable: u32 = 5;
    Main::middle(main);
    let mut result: u32 = stable + 1;
    transition result == 6 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

machine Main::middle(main: &mut Main) {
    Main::touch(main);
}

machine Main::touch(main: &mut Main) {
    let mut touched: u32 = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
