data Flag<const Value: bool> { value: u8; }
machine keep(value: Flag<(1 / 3 < 1 / 2)>) -> Flag<true> { value }
data Main { flag: Flag<true>; }
machine Main::main(main: &mut Main) {
    main.flag = Flag { value: 3 };
    let odd: Flag<(0.1 + 0.2 == 0.3)> = keep(Flag { value: 1 });
    main.flag = odd;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
