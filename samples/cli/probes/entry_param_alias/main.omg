// A machine parameter aliases caller storage directly: `alias_write(health:
// &mut i32)` writes `health = 1` through the alias — the caller's local
// receives it.
machine alias_write(health: &mut i32) {
    health = 1;
}
data Main { hits: i32; }
machine Main::main(main: &mut Main) {
    alias_write(&mut main.hits);
    transition main.hits == 1 {
        true -> done()
        false -> bad()
    }
    machine done() { }
    machine bad() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
