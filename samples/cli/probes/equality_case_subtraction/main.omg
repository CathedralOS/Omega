// A case `where lo == hi` equality relates the two payload fields: under the
// `Point` arm `hi - lo` cannot underflow — the equality is contributed on the
// destructured bindings and survives the edge into `take`.
data Interval {
    case Empty;
    case Point(lo: u64, hi: u64) where lo == hi;
}
data Main { interval: Interval; width: u64; }
machine Main::main(main: &mut Main) {
    main.interval = Interval::Point { lo: 4, hi: 4 };
    transition main.interval {
        Interval::Point { lo, hi } -> take(lo, hi, main)
        Interval::Empty -> done()
    }
    machine take(lo: u64, hi: u64, main: &mut Main) {
        main.width = hi - lo;
    }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
