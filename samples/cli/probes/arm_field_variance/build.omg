use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "arm_field_variance");
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, linux_arm64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, linux_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, macos_arm64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, macos_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, windows_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, uefi_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, cross_platform_cli);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, local_unchecked);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);

 Build::bind<Acknowledgement::ack>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    });
 Build::bind<Acknowledgement::ack>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    });
 Build::bind<Acknowledgement::ack>(builder, linux_arm64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.17",
        },
    });
 Build::bind<Acknowledgement::ack>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_abs",
        },
    });
}
