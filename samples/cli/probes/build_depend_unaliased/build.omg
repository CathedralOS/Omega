// Unaliased row family: `Build::dependency` and `Build::build_dependency` select
// the same dependency without an alias. The question pinned: which name
// imports the dep's machines — its declared package name, its directory
// name, or an unqualified merge?

use custody_kernel::main;

machine build(builder: &mut Build) {
    Build::application(builder, "build_depend_unaliased");
    let dependency_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "dependency" }));
    let dependency_registration_2: DependencyRegistration = Build::build_dependency(builder, dependency::from_source(Source::Path { location: "dependency" }));
    builder.freestanding = true;
    let observed: i32 = seed();
    transition observed == 3 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
