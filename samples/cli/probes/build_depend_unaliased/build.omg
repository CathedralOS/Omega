// Unaliased row family: `Build::depend` and `Build::build_depend` select
// the same dependency without an alias. The question pinned: which name
// imports the dep's machines — its declared package name, its directory
// name, or an unqualified merge?

use custody_kernel::main;

machine build(builder: &mut Build) {
    Build::application(builder, "build_depend_unaliased");
    Build::depend(builder, Source::Path { location: "dependency" });
    Build::build_depend(builder, Source::Path { location: "dependency" });
    builder.freestanding = true;
    let observed: i32 = seed();
    transition observed == 3 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
