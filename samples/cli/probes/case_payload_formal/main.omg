// case_payload_formal: enum-of-enum payloads — the first sample where a
// case payload carries another case type and is built from a formal.
//
//   * `Res::Error` wraps a `Kind` — a case whose payload is itself a
//     two-case enum, built directly from the parameter `kind` (the
//     parameter-rooted consumption path, not a local).
//   * `Res::code` dispatches the nested shape: `Res::Error { kind }`
//     binds the inner enum for the caller to inspect again.
//   * `kind_of` unwraps one more level — `Kind::NotFound` vs
//     `Kind::Other` — proving the inner case survives construction,
//     return, and re-dispatch.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Kind { case Other; case NotFound; }
data Res { case Error(kind: Kind); case Empty; }

machine fail(kind: Kind) -> Res {
    Res::Error { kind: kind }
}

machine Res::code(res: Res) -> i32 {
    transition res {
        Res::Error { kind } -> (kind_of(kind) + 10)
        Res::Empty -> 0
    }
}

machine kind_of(kind: Kind) -> i32 {
    transition kind {
        Kind::NotFound -> 2
        Kind::Other -> 1
    }
}

machine case_payload_formal() {
    let err: Res = fail(Kind::NotFound);
    let empty: Res = Res::Empty;
    transition Res::code(err) == 12 && Res::code(empty) == 0 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
