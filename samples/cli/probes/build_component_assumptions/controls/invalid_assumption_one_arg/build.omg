// The harvester's required shape — one digest argument and nothing else —
// fails the arity check first: the declaration's signature is
// `(builder: &mut Build, digest: &[u8])`, so a one-argument spelling
// cannot even be typed.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_assumption_one_arg");
    builder.freestanding = true;
    Build::accept_component_assumption("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
}
