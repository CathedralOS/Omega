// `Finite` is a compiler-known core float domain — not a
// user-declared carrier. `f64 in Finite` fields and
// `f32 in Finite` params carry it, and the data's own
// `where` window tolerates transient violations (poison,
// out-of-range) that are repaired before the next
// transition consumes state.
//
//   * `main.direct = 0.0f64 / 0.0` then `= 2.5` — a NaN
//     intermediate on a Finite field is legal inside the
//     invariant window.
//   * `main.ranged = 2.0` then `= 0.5` — a where-clause
//     field takes the same transient excursion.
//   * `use omega::language::core::float_operations`
//     brings the float operation surface including the
//     domain.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::float_operations;

data Main where ranged >= 0.0 && ranged <= 1.0 {
    direct: f64 in Finite;
    ranged: f32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.direct = 0.0f64 / 0.0;
    main.direct = 2.5;
    main.ranged = 2.0;
    main.ranged = 0.5;
    transition { _ -> accepts(main, main.ranged) }
    machine accepts(main: &mut Main, value: f32 in Finite) {
        transition value == 0.5 && main.direct == 2.5 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
