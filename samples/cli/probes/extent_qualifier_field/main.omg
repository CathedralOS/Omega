// Placed-access custody surface: `Extent in Granted & Vacant`
// carries the dormant-content qualification into a
// Vacant-qualified field — only the qualifier-free source
// shape is an implicit strengthening. `held.e as Extent`
// erases both qualifications on exit.
//
//   * `use omega::language::core::extent` — depend-free
//     import of the linear `Extent` + `Granted`/`Vacant`
//     domains.
//   * `keep(whole: Extent in Granted & Vacant) -> Extent`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::extent;

data Held {
    e: Extent in Granted & Vacant;
}

machine keep(whole: Extent in Granted & Vacant) -> Extent
{
    let held: Held = Held { e: whole };
    held.e as Extent
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
