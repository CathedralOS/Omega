// Linear values consumed through `boundary requirement` — a named
// consuming sink with no provider — and decision-21 branch
// reconciliation: either transition arm may transfer the same linear
// receipt into a consuming state; the arms are alternatives, not
// sequential copies.
//
//   * `data Receipt [linear]` — must be consumed exactly once.
//   * `boundary requirement Receipt::ack(receipt: Receipt)` — the
//     sink; no provider body needed.
//   * `Main::run -> i32` — value-returning machine; the entry
//     (`ProgramEntry` can't return) reads the result into `hits`.
//   * Both arms `ack` the receipt; one returns 70, the other 71.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Receipt [linear] { code: i32; }
boundary requirement Receipt::ack(receipt: Receipt);

data Main { choose_first: bool; hits: i32 in Wrapping; }

machine Main::run(main: &mut Main) -> i32 {
    let receipt: Receipt = Receipt { code: 7 };
    transition main.choose_first {
        true -> consume_first(receipt)
        _ -> consume_second(receipt)
    }

    state consume_first(receipt: Receipt) -> i32 {
        Receipt::ack(receipt);
        70
    }

    state consume_second(receipt: Receipt) -> i32 {
        Receipt::ack(receipt);
        71
    }
}

machine Main::main(main: &mut Main) {
    main.choose_first = true;
    main.hits = (Main::run(main) == 70) as i32 in Wrapping;
}
