// operator_desugars: the ordinary operator surface as sample code — the
// first sample exercising compound assignment, bitwise, shift, and unary
// operators in one program.
//
//   * `v += 5; v -= 3; v *= 2; v /= 4; v %= 4` each desugars to
//     `v = v OP rhs`; chaining in one state forces every later read to
//     observe the prior write, not a stale entry-value fold.
//   * `&`, `|`, `^` produce integers (not booleans) and cannot overflow —
//     they carry no arithmetic domain obligation.
//   * `2u64 << 8` shifts on the annotated type; `-v` negates.
//
// The machine walks v through the compound chain to 2, checks all three
// bitwise results (8, 14, 6), the negation (-10), and the shift (512),
// and accepts only when every read agrees. Compile-checked only: no
// standard-library dependency, no ProcessExit provider.
machine operator_desugars() {
    let mut v: i32 = 10;
    v += 5;  // 15
    v -= 3;  // 12
    v *= 2;  // 24
    v /= 4;  // 6
    v %= 4;  // 2
    transition v == 2 {
        true -> check_bitwise()
        _ -> done(71)
    }

    machine check_bitwise() {
        let a: i32 = 12;
        let b: i32 = 10;
        transition a & b == 8 && a | b == 14 && a ^ b == 6 {
            true -> check_unary()
            _ -> done(72)
        }
    }

    machine check_unary() {
        let n: i32 = -10;
        let s: u64 = 2u64 << 8;
        transition n == -10 && s == 512 {
            true -> done(70)
            _ -> done(73)
        }
    }

    machine done(code: i32) {}
}
