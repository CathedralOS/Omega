// `&write` is a write-only projected borrow: the callee assigns
// `destination = value` with no deref spelling and can never read
// the pointee. A `&write` parameter forwards by re-projection —
// `&write destination` passes the same write loan deeper.
//
//   * `machine replace(destination: &write i32, value: i32)` —
//     write-only leaf.
//   * `forward` transitions through a state spelling
//     `&write destination` at each hop.
//   * `neighbor` untouched: the write loan sees only its target.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine replace(destination: &write i32, value: i32) {
    destination = value;
}

machine forward(destination: &write i32, value: i32) {
    transition { _ -> write_value(&write destination, value) }

    machine write_value(destination: &write i32, value: i32) {
        replace(&write destination, value);
    }
}

data Main {
    value: i32;
    neighbor: i32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.value = 7;
    main.neighbor = 19;
    forward(&write main.value, 42);
    transition main.value == 42 && main.neighbor == 19 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
