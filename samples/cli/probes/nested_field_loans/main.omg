// Nested-field loans through a borrowed receiver: `&outer.inner`
// lends the parameter's nested field — the path's head names the
// state's own binding even though the member symbol's parent is
// `Outer`. Works from the entry parameter and from a forwarded
// state parameter.
//
//   * `Inner::inspect(&outer.inner)` and `&outer.inner.value`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Inner {
    value: u64;
}

data Outer {
    inner: Inner;
    extra: u64;
}

machine Inner::inspect(inner: &Inner) -> u64 in Wrapping {
    inner.value as u64 in Wrapping
}

machine Inner::read_value(inner: &Inner) -> &u64 {
    &inner.value
}

machine probe(outer: &Outer) -> u64 {
    let via_machine: u64 in Wrapping = Inner::inspect(&outer.inner);
    let via_ref: &u64 = Inner::read_value(&outer.inner);
    transition (via_machine + (via_ref as u64 in Wrapping)) as u64 == 14 {
        true -> finish(outer)
        _ -> finish(outer)
    }
    machine finish(forwarded: &Outer) -> u64 {
        (Inner::inspect(&forwarded.inner) + (forwarded.extra as u64 in Wrapping)) as u64
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let outer: Outer = Outer { inner: Inner { value: 7 }, extra: 10 };
    let answer: u64 = probe(&outer);
    transition answer == 17 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
