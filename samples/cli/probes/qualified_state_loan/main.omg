// Expected exit: 0. A state borrows a qualified owner's original storage.
data Resource { identity: u64; }
domain Resource::Open requires self.identity != 0;

machine main() crashes Trap {
    let mutable resource: Resource in Open = Resource { identity: 73 };
    transition { _ -> inspect(@mutable resource) }

    machine inspect(resource: @mutable Resource in Open) {
        transition resource.identity == 73 { true -> done(), false -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
