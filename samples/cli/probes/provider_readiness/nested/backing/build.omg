use {backing}/main.omg as backing;
use {omega}/build/dependency.omg;
use {omega}/language/core/program_image.omg as image;

machine build(builder: @mutable BuildPlan) suspends
requires address::Bound == 18446744073709551616 {
    builder.product = BuildProduct::Package { name: "readiness_backing" };
    let mutable backing_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../helper" });
    |dependency|::with_alias(@mutable backing_dependency, "backing");
    let backing_registration: DependencyRegistration = Build::build_dependency(builder, backing_dependency);
    BuildLog::write_line(@mutable builder.log, "before readiness");
    suspend Build::await_provider::<|image|::ProgramImage, |backing|::TestImage>(builder);
    let observed: address = |image|::ProgramImage::retained_suffix_start();
    transition observed == 64 {
        true -> finish(builder),
        _ -> wrong_backing(builder)
    }
    machine finish(builder: @mutable BuildPlan) {
        BuildLog::write_line(@mutable builder.log, "after readiness");
    }
    machine wrong_backing(builder: @mutable BuildPlan) {
        builder.product = BuildProduct::Unselected;
    }
}
