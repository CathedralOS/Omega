// Union membership `x in A | B` as a bool subject, and an entry
// machine carrying its own `requires`: `main.password in Valid` is
// assumed at entry (the runtime binder discharges it like the corpus
// fixture), and the member expression `main.password.length`
// discharges `accept`'s scalar requires through the domain fact.
//
//   * `main.password in Valid | Secure` — union membership to bool.
//   * `machine Main::main requires main.password in Valid` — entry
//     machines may carry requires contracts.
//   * `accept(length) requires length > 0` satisfied by the domain
//     fact's member expression, no literal proof.
//   * `hits` records which union arm ran.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Password {
    length: i32;
    score: i32;
}

domain Password::Valid(password)
requires
    password.length > 0;

domain Password::Secure(password)
requires
    password.score >= 8;

data Main {
    password: Password;
    hits: i32 in Wrapping;
}

machine Main::accept(length: i32)
requires
    length > 0
{
}

machine Main::main(main: &mut Main)
requires
    main.password in Password::Valid
{
    main.hits = 0;
    Main::accept(main.password.length);
    transition (main.password in Password::Valid | Password::Secure) {
        (true) -> Main::good(main)
        _ -> Main::bad(main)
    }
    state good(main: &mut Main) { main.hits = 1; }
    state bad(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
