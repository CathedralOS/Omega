// An array borrow coerces to a slice parameter at the
// call site: `count(&main.buf)` passes `&[u8; 8]` where
// `bytes: &[u8]` is declared — the sized array view
// weakens to an unsized slice implicitly.
//
//   * `machine count(bytes: &[u8]) -> u64` — slice param.
//   * `count(&main.buf)` / `count(&owned)` — field array
//     and local array both coerce.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine count(bytes: &[u8]) -> u64 { bytes.len }

data Main {
    buf: [u8; 8];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let owned: [u8; 4] = [1u8, 2u8, 3u8, 4u8];
    let from_field: u64 = count(&main.buf);
    let from_local: u64 = count(&owned);
    transition from_field == 8 && from_local == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
