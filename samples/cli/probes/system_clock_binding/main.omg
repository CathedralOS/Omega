use omega\language\core\ProcessExit;
// The canonical system `Clock` provider: a `reaches ProcessExit + Clock`
// multi-service ceiling, and `block Clock::sleep(200)` waits through the
// selected provider.
//
// Expected exit: 70
use system\Clock;

machine entry_start() reaches ProcessExit + Clock {
    block Clock::sleep(200);
    ProcessExit::exit_process(70);
}
