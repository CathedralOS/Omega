// Module-qualified domain paths: `units` (sibling file) declares
// `u64::Distance` and the operator home `u64::Distance::add`; a
// broad `use units;` exposes the carrier-qualified spelling
// `u64 in units::u64::Distance` as a type constraint on
// parameters.
//
//   * `measure(a: u64 in units::u64::Distance, ...)` — the domain
//     is spelled through the module path, in the parameter type and
//     in the caller's explicit `as` qualification.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use units;

machine measure(a: u64 in units::u64::Distance, b: u64 in units::u64::Distance) -> bool {
    true
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition measure(3 as u64 in units::u64::Distance, 4) {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
