// `units/units.omg` declares `u64::Distance` and its addition operator.
// The caller selects that domain through `|units|::u64::Distance`.
//
//   * `measure(a: u64 in |units|::u64::Distance, ...)` — the domain
//     is spelled through the module path, in the parameter type and
//     in the caller's explicit `as` qualification.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use units/units.omg;

machine measure(a: u64 in |units|::u64::Distance, b: u64 in |units|::u64::Distance) -> bool {
    true
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    transition measure(3 as u64 + |units|::u64::Distance, 4) {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
