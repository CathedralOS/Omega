// seq_map_filter build file: depend-free compile-scope probe — no
// standard-library package, so no ProcessExit authority; compile-checked
// only (same posture as cli/basics/standalone).

machine build(builder: &mut Build) {
    Build::application(builder, "seq_map_filter");
    Build::bind(builder, windows_x86_64::ProgramEntry, seq_map_filter);
    Build::bind(builder, linux_x86_64::ProgramEntry, seq_map_filter);
    Build::bind(builder, linux_arm64::ProgramEntry, seq_map_filter);
    Build::bind(builder, macos_arm64::ProgramEntry, seq_map_filter);
}
