// Dependency aliases must spell a snake_case Omega identifier:
// `kit9` is legal; `KIT`, `kit-name`, `_kit`, `kit_`, `9lives`,
// `ki t`, and the empty string all reject with one diagnostic.
machine build(builder: &mut Build) {
    Build::application(builder, "build_alias_vocabulary");
    builder.freestanding = true;
    let mut kit9_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dep" });
    dependency::with_alias(&mut kit9_dependency, "kit9");
    let kit9_registration: DependencyRegistration = Build::dependency(builder, kit9_dependency);
}
