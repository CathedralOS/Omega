machine build(builder: &mut Build) {
    Build::application(builder, "invalid_alias_underscore_edge");
    builder.freestanding = true;
    let mut aliased_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dep" });
    dependency::with_alias(&mut aliased_dependency, "_kit");
    let aliased_registration: DependencyRegistration = Build::dependency(builder, aliased_dependency);
}
