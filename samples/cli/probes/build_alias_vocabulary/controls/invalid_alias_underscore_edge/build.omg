use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "invalid_alias_underscore_edge");
    let mutable aliased_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "dep" });
    |dependency|::with_alias(@mutable aliased_dependency, "_kit");
    let aliased_registration: DependencyRegistration = Build::dependency(builder, aliased_dependency);
}
