// `[copy]` bounds satisfied at the call: `copy_it(&main.l)` and
// `copy_it(&main.n)` instantiate `T [copy]` from argument types;
// `wrap<U [copy]>` forwards its own bound as the callee's
// requirement — nested generic bound forwarding.
//
//   * `copy_free<T [copy]>` free machine, `wrap<U [copy]>` calling
//     `copy_it(y)` under its own bound.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Light [copy] {
    weight: i32;
}

machine copy_free<T [copy]>(x: &T) {
}

machine copy_it<T [copy]>(x: &T) {
}

machine wrap<U [copy]>(y: &U) {
    copy_it(y);
}

data Main {
    l: Light;
    n: i32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.l = Light { weight: 4 };
    main.n = 9;
    copy_it(&main.l);
    copy_it(&main.n);
    wrap(&main.l);
    copy_free(&main.l);
    transition main.n == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
