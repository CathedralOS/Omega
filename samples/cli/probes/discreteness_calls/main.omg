// Kernel discreteness: `value <= 7` recovers strict `value < 8`
// across a literal bound — the callee's `requires value < bound`
// discharges at the call site from shared integer laws, not from
// an assumption of this result.
//
//   * Nested requires propagation through a two-machine chain.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine below(value: u64, bound: u64)
requires
    value < bound
{
}

machine below_eight(value: u64)
requires
    value <= 7
{
    below(value, 8);
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    below_eight(7);
    transition { _ -> done(main) }
    machine done(main: &mut Main) { main.hits = 1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
