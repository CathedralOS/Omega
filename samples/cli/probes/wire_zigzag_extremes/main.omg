// Signed zigzag at the carrier extremes: `i64::MIN`,
// `i64::MAX`, and an `[i32; 2]` array member round-trip
// bit-exact through the generated `Extremes::encode` /
// `Extremes::decode` codec — zigzag is a bit operation, not
// a range case.
//
//   * `#2 signed32: [i32; 2]` — fixed-array member wire
//     encoding.
//   * `-9223372036854775808i64` literal at the signed
//     minimum edge.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Extremes {
    #0 minimum: i64;
    #1 maximum: i64;
    #2 signed32: [i32; 2];
    #3 trailing: u32;
}

data ExtremeValues {
    minimum: i64;
    maximum: i64;
    signed32: [i32; 2];
    trailing: u32;
}

data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let value: ExtremeValues = ExtremeValues {
        minimum: -9223372036854775808i64,
        maximum: 9223372036854775807i64,
        signed32: [-2147483648i32, 2147483647i32],
        trailing: 7u32
    };
    let decoded: ExtremeValues = ExtremeValues {
        minimum: 0i64, maximum: 0i64, signed32: [0i32, 0i32], trailing: 0u32
    };
    Extremes::encode(&value, &mut main.buffer, &mut main.written);
    Extremes::decode(&mut decoded, &main.buffer, &mut main.read, &mut main.verdict);
    let matches: bool = main.verdict == WireVerdict::Sound
        && main.written == 37u64
        && main.read == 37u64
        && decoded.trailing == 7u32
        && decoded.minimum == -9223372036854775808i64
        && decoded.maximum == 9223372036854775807i64
        && decoded.signed32[0] == -2147483648i32
        && decoded.signed32[1] == 2147483647i32;
    transition matches {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
