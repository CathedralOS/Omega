machine build(builder: &mut Build) {
    Build::application(builder, "selected_provider_ranges");
    Build::select_provider<ByteObserver, Selected>(builder, linux_arm64);
    Build::select_provider<ByteObserver, Selected>(builder, linux_x86_64);
    Build::select_provider<ByteObserver, Selected>(builder, macos_arm64);
    Build::select_provider<ByteObserver, Selected>(builder, macos_x86_64);
    Build::select_provider<ByteObserver, Selected>(builder, windows_x86_64);
    Build::select_provider<ByteObserver, Selected>(builder, uefi_x86_64);
    Build::select_provider<ByteObserver, Selected>(builder, cross_platform_cli);
    Build::select_provider<ByteObserver, Selected>(builder, local_unchecked);
    Build::select_provider<ByteObserver, Selected>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
