// Explicit type arguments at call sites + declared type
// equations: `capacity<u64 in AtMost<257> >()` instantiates
// `where Length == u64::AtMost<Capacity>` — a type argument supplies
// declared structure and binds the const parameter by equation.
//
//   * `machine capacity<Length, const Capacity: u64>()` with
//     `where Length == u64::AtMost<Capacity>`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain<const Bound: u64> u64::AtMost<Bound>(value) requires value <= Bound;

machine capacity<Length, const Capacity: u64>() -> u64
where Length == u64::AtMost<Capacity>
{
    Capacity
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition capacity<u64 in AtMost<257> >() == 257 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
