// Explicit type arguments at call sites + declared type
// equations: `capacity<u64[0..257]>()` instantiates
// `where Length == u64[0..=Capacity]` — a type argument supplies
// declared structure and binds the const parameter by equation.
//
//   * `machine capacity<Length, const Capacity: u64>()` with
//     `where Length == u64[0..=Capacity]`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine capacity<Length, const Capacity: u64>() -> u64
where Length == u64[0..=Capacity]
{
    Capacity
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition capacity<u64[0..=257]>() == 257 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
