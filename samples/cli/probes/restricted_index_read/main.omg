// A nonconstant checked selector reads a constrained scalar field through a
// call: `data Byte where value >= 0 && value <= 1` + `&main.bytes[position]
// .value` element member borrow.
data Byte where value >= 0 && value <= 1 { value: u8; }
data Main { bytes: [Byte; 4]; }
machine take(value: &u8) -> u8 { value }
machine inspect(main: &Main, position: u64) -> u8 {
    transition position < 4 {
        true -> selected(main, position)
        _ -> 0
    }
    machine selected(main: &Main, position: u64) -> u8 {
        take(&main.bytes[position].value)
    }
}
machine Main::main(main: &mut Main) {
    main.bytes[2].value = 1;
    let chosen: u8 = inspect(main, 2);
    let neighbor: u8 = inspect(main, 1);
    transition chosen == 1 && neighbor == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
