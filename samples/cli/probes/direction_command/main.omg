// Parse a movement command by its first byte -- the classic game-input dispatch.
// `main.command[0]` indexes the first byte of a `[u8; N] in Utf8` carrier (content
// lives inline after the length word), and a chain of guards classifies it: 'n'
// (110) -> 1, 's' (115) -> 2, 'e' (101) -> 3, 'w' (119) -> 4, else 0. Carrier byte
// indexing in guard subjects is the text parsing/scanning workhorse. For "north"
// the first byte is 'n', so the program exits 1.
// Expected exit: 1.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    command: [u8; 8] in Utf8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    main.console.write_line("direction_command: dispatch the command \"north\" by its first byte");

    main.command = "north";

    transition main.command[0] == 110 {
        true -> go_north(main)
        _ -> try_south(main)
    }

    state try_south(main: &mut Main) {
        transition main.command[0] == 115 { true -> go_south(main) _ -> try_east(main) }
    }
    state try_east(main: &mut Main) {
        transition main.command[0] == 101 { true -> go_east(main) _ -> try_west(main) }
    }
    state try_west(main: &mut Main) {
        transition main.command[0] == 119 { true -> go_west(main) _ -> unknown(main) }
    }

    state go_north(main: &mut Main) {
        main.console.write_line("PASS: first byte 'n' classified as north (exit 1)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(1);
    }
    state go_south(main: &mut Main) {
        main.console.write_line("FAIL: classified as south -- expected north for \"north\" (exit 2)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(2);
    }
    state go_east(main: &mut Main) {
        main.console.write_line("FAIL: classified as east -- expected north for \"north\" (exit 3)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(3);
    }
    state go_west(main: &mut Main) {
        main.console.write_line("FAIL: classified as west -- expected north for \"north\" (exit 4)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(4);
    }
    state unknown(main: &mut Main) {
        main.console.write_line("FAIL: first byte matched no direction -- expected 'n' (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
}
