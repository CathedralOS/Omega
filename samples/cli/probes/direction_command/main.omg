// Parse a movement command by its first byte -- the classic game-input dispatch.
// `self.command[0]` indexes the first byte of a `[u8; N] in Utf8` carrier (content
// lives inline after the length word), and a chain of guards classifies it: 'n'
// (110) -> 1, 's' (115) -> 2, 'e' (101) -> 3, 'w' (119) -> 4, else 0. Carrier byte
// indexing in guard subjects is the text parsing/scanning workhorse. For "north"
// the first byte is 'n', so the program exits 1.
// Expected exit: 1.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Main {
    console: Console;
    command: [u8; 8] in Utf8;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("direction_command: dispatch the command \"north\" by its first byte");

    self.command = "north";

    transition self.command[0] == 110 {
        true -> go_north()
        _ -> try_south()
    }

    state try_south(&mut self) {
        transition self.command[0] == 115 { true -> go_south() _ -> try_east() }
    }
    state try_east(&mut self) {
        transition self.command[0] == 101 { true -> go_east() _ -> try_west() }
    }
    state try_west(&mut self) {
        transition self.command[0] == 119 { true -> go_west() _ -> unknown() }
    }

    state go_north(&mut self) {
        self.console.write_line("PASS: first byte 'n' classified as north (exit 1)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(1);
    }
    state go_south(&mut self) {
        self.console.write_line("FAIL: classified as south -- expected north for \"north\" (exit 2)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(2);
    }
    state go_east(&mut self) {
        self.console.write_line("FAIL: classified as east -- expected north for \"north\" (exit 3)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(3);
    }
    state go_west(&mut self) {
        self.console.write_line("FAIL: classified as west -- expected north for \"north\" (exit 4)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(4);
    }
    state unknown(&mut self) {
        self.console.write_line("FAIL: first byte matched no direction -- expected 'n' (exit 0)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(0);
    }
}
