use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Parse a movement command by its first byte -- the classic game-input dispatch.
// `main.command[0]` indexes the first of exactly five inline bytes. Utf8
// qualification adds no length word. A chain of guards classifies it: 'n'
// (110) -> 1, 's' (115) -> 2, 'e' (101) -> 3, 'w' (119) -> 4, else 0. Carrier byte
// indexing in guard subjects is the text parsing/scanning workhorse. For "north"
// the first byte is 'n', so the program exits 1.
// Expected exit: 1.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 5]::Utf8
requires
    valid_utf8(self);

data Main {
    command: [u8; 5] in Utf8;
    pause: [u8; 256];
}

machine Main::main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("direction_command: dispatch the command \"north\" by its first byte");

    main.command = "north";

    transition main.command[0] == 110 {
        true -> go_north(main),
        _ -> try_south(main)
    }

    machine try_south(main: @mutable Main) {
        transition main.command[0] == 115 { true -> go_south(main), _ -> try_east(main) }
    }
    machine try_east(main: @mutable Main) {
        transition main.command[0] == 101 { true -> go_east(main), _ -> try_west(main) }
    }
    machine try_west(main: @mutable Main) {
        transition main.command[0] == 119 { true -> go_west(main), _ -> unknown(main) }
    }

    machine go_north(main: @mutable Main) {
        |console|::Console::write_line("PASS: first byte 'n' classified as north (exit 1)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause);
        |process_exit|::ProcessExit::exit_process(1);
    }
    machine go_south(main: @mutable Main) {
        |console|::Console::write_line("FAIL: classified as south -- expected north for \"north\" (exit 2)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause);
        |process_exit|::ProcessExit::exit_process(2);
    }
    machine go_east(main: @mutable Main) {
        |console|::Console::write_line("FAIL: classified as east -- expected north for \"north\" (exit 3)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause);
        |process_exit|::ProcessExit::exit_process(3);
    }
    machine go_west(main: @mutable Main) {
        |console|::Console::write_line("FAIL: classified as west -- expected north for \"north\" (exit 4)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause);
        |process_exit|::ProcessExit::exit_process(4);
    }
    machine unknown(main: @mutable Main) {
        |console|::Console::write_line("FAIL: first byte matched no direction -- expected 'n' (exit 0)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause);
        |process_exit|::ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block Main::main(@mutable entry_storage);
}
