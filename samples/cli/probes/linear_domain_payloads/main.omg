// Domained linear payloads: `[linear]` receipts gated by domains —
// `domain R::Issued` bare, `domain R::Extra(r) requires r.code >= 0`
// predicate, `domain R::ExtraIssued = Issued & Extra` conjunction —
// then `Receipt in R::Issued` as field, array element, and sum
// payload. The boundary machine requires `receipt: Receipt in
// R::Issued` and `crashes Trap`.
//
//   * `satisfies Acknowledgement` impl consumes via `drop(receipt)`
//     after `verify_payload(&receipt)` — drop IS the discharge
//     when a drop plan exists.
//
// Compile-checked only: declaration surface, no standard-library
// dependency.

use omega::language::core::drop;

public data Receipt [linear] {
    code: i32;
    first: u64;
}

machine Receipt::drop(receipt: &mut Receipt) {}

public domain Receipt::Issued;

domain Receipt::Extra(receipt) requires receipt.code >= 0;

domain Receipt::ExtraIssued = Issued & Extra;

public boundary trait Acknowledgement {
    machine acknowledge(receipt: Receipt in Receipt::Issued) reaches crashes Trap;
}

machine verify_payload(receipt: &Receipt) {}

Acknowledged satisfies Acknowledgement {
    machine acknowledge(receipt: Receipt in Receipt::Issued) crashes Trap {
        verify_payload(&receipt);
        drop(receipt);
    }
}

data Slot { receipt: Receipt in Receipt::Issued; }
data ReceiptBox { receipts: [Receipt in Receipt::Issued; 2]; }
data SlotChoice { case Empty; case Present(slot: Slot); }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
