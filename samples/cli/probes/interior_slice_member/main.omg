// A borrowed scalar slice member encodes with its runtime element count:
// `readings: main.source[1..4]` — record construction takes the interior
// subslice without an `&` at the member value.
data Telemetry {
    #0 readings: &[i32];
}
data TelemetrySample {
    readings: &[i32];
}
data Main { source: [i32; 4]; buffer: [u8; 64]; written: u64; }
machine Main::main(main: &mut Main) {
    main.source[0] = 99;
    main.source[1] = -1;
    main.source[2] = 64;
    main.source[3] = -65;
    let sample: TelemetrySample =
        TelemetrySample { readings: main.source[1..4] };
    Telemetry::encode(&sample, &mut main.buffer, &mut main.written);
    transition main.written == 8 {
        true -> done(main)
        false -> bad(main)
    }
    state done(main: &mut Main) { }
    state bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
