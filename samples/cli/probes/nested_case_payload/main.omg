// Nested dispatch: outer case-payload dispatch feeds a sub-machine
// that performs a second (integer-keyed) dispatch from within a sub-state.
//
// FRESH COMBINATION:
//   1. Outer machine dispatches on a case type (Command variant) to extract
//      payload fields (op: i32 in Saturating, n: i32 in Saturating).
//   2. A sub-state of that machine invokes apply_op(op, n) which performs
//      a SECOND level of guard-based dispatch on the extracted payload fields.
//   This exercises case-payload extraction feeding a nested integer dispatch
//   across two machine call levels -- untested in prior samples.
//
// Op codes: 0=add, 1=sub, 2=scale
// Command:
//   case Run(op: i32 in Saturating, n: i32 in Saturating) -- run op with value n on accumulator
//   case Noop
//
// Sequence:
//   Run(0, 10) -> acc = 0 + 10 = 10
//   Noop       -> acc = 10
//   Run(2, 3)  -> acc = 10 * 3 = 30
//   Run(0, 15) -> acc = 30 + 15 = 45
//   Run(1, 45) -> acc = 45 - 45 = 0
//   Run(0, 5)  -> acc = 0 + 5 = 5
//   Run(2, 13) -> acc = 5 * 13 = 65
//   Run(0, 5)  -> acc = 65 + 5 = 70
//
// Final: acc == 70. Exit 70.
// Exit 71 = wrong acc.
//
// Fresh combination: case-payload dispatch on Command, then INNER dispatch
// on `op` integer (representing a nested variant), two-level dispatch from
// a sub-state that receives case payload fields.
//
// Expected exit: 70.

use omega_language_std::console;

data Command {
    case Run(op: i32 in Saturating, n: i32 in Saturating);
    case Noop;
}

data State [copy] {
    acc: i32 in Saturating;
}

data Main {
    console: Console;
    st: State;
    pause: [u8; 256];
}

// Inner dispatcher: interpret op code on accumulator with value n.
machine Main::apply_op(&mut self, op: i32 in Saturating, n: i32 in Saturating) {
    transition op == 0 {
        true -> do_add(n)
        _ -> try_sub(op, n)
    }

    state do_add(&mut self, n: i32 in Saturating) {
        self.st.acc = self.st.acc + n;
    }

    state try_sub(&mut self, op: i32 in Saturating, n: i32 in Saturating) {
        transition op == 1 {
            true -> do_sub(n)
            _ -> do_scale(n)
        }
    }

    state do_sub(&mut self, n: i32 in Saturating) {
        self.st.acc = self.st.acc - n;
    }

    state do_scale(&mut self, n: i32 in Saturating) {
        self.st.acc = self.st.acc * n;
    }
}

// Outer dispatcher: unwrap Command case, then invoke inner dispatch.
machine Main::apply_command(&mut self, cmd: Command) {
    transition cmd {
        Command::Run { op, n } -> do_run(op, n)
        Command::Noop -> done()
        _ -> done()
    }

    state do_run(&mut self, op: i32 in Saturating, n: i32 in Saturating) {
        // Second-level dispatch: interpret the operation.
        self.apply_op(op, n);
    }

    state done(&mut self) {}
}

machine Main::main(&mut self) {
    self.console.write_line("nested_case_payload: case-payload commands feeding a nested integer dispatch");
    self.apply_command(Command::Run { op: 0, n: 10 });
    self.apply_command(Command::Noop);
    self.apply_command(Command::Run { op: 2, n: 3 });
    self.apply_command(Command::Run { op: 0, n: 15 });
    self.apply_command(Command::Run { op: 1, n: 45 });
    self.apply_command(Command::Run { op: 0, n: 5 });
    self.apply_command(Command::Run { op: 2, n: 13 });
    self.apply_command(Command::Run { op: 0, n: 5 });

    transition self.st.acc == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.write_line("PASS: accumulator reached 70 after 8 commands (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.write_line("FAIL: wrong accumulator value (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
