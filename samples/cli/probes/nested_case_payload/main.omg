// Nested dispatch: outer case-payload dispatch feeds a sub-machine
// that performs a second (integer-keyed) dispatch from within a sub-state.
//
// FRESH COMBINATION:
//   1. Outer machine dispatches on a case type (Command variant) to extract
//      payload fields (op: i32 in Saturating, n: i32 in Saturating).
//   2. A sub-state of that machine invokes apply_op(op, n) which performs
//      a SECOND level of guard-based dispatch on the extracted payload fields.
//   This exercises case-payload extraction feeding a nested integer dispatch
//   across two machine call levels -- untested in prior samples.
//
// Op codes: 0=add, 1=sub, 2=scale
// Command:
//   case Run(op: i32 in Saturating, n: i32 in Saturating) -- run op with value n on accumulator
//   case Noop
//
// Sequence:
//   Run(0, 10) -> acc = 0 + 10 = 10
//   Noop       -> acc = 10
//   Run(2, 3)  -> acc = 10 * 3 = 30
//   Run(0, 15) -> acc = 30 + 15 = 45
//   Run(1, 45) -> acc = 45 - 45 = 0
//   Run(0, 5)  -> acc = 0 + 5 = 5
//   Run(2, 13) -> acc = 5 * 13 = 65
//   Run(0, 5)  -> acc = 65 + 5 = 70
//
// Final: acc == 70. Exit 70.
// Exit 71 = wrong acc.
//
// Fresh combination: case-payload dispatch on Command, then INNER dispatch
// on `op` integer (representing a nested variant), two-level dispatch from
// a sub-state that receives case payload fields.
//
// Expected exit: 70.

use omega_language_std::console;

data Command {
    case Run(op: i32 in Saturating, n: i32 in Saturating);
    case Noop;
}

data State [copy] {
    acc: i32 in Saturating;
}

data Main {
    st: State;
    pause: [u8; 256];
}

// Inner dispatcher: interpret op code on accumulator with value n.
machine Main::apply_op(main: &mut Main, op: i32 in Saturating, n: i32 in Saturating) {
    transition op == 0 {
        true -> do_add(main, n)
        _ -> try_sub(main, op, n)
    }

    state do_add(main: &mut Main, n: i32 in Saturating) {
        main.st.acc = main.st.acc + n;
    }

    state try_sub(main: &mut Main, op: i32 in Saturating, n: i32 in Saturating) {
        transition op == 1 {
            true -> do_sub(main, n)
            _ -> do_scale(main, n)
        }
    }

    state do_sub(main: &mut Main, n: i32 in Saturating) {
        main.st.acc = main.st.acc - n;
    }

    state do_scale(main: &mut Main, n: i32 in Saturating) {
        main.st.acc = main.st.acc * n;
    }
}

// Outer dispatcher: unwrap Command case, then invoke inner dispatch.
machine Main::apply_command(main: &mut Main, cmd: Command) {
    transition cmd {
        Command::Run { op, n } -> do_run(main, op, n)
        Command::Noop -> done(main)
        _ -> done(main)
    }

    state do_run(main: &mut Main, op: i32 in Saturating, n: i32 in Saturating) {
        // Second-level dispatch: interpret the operation.
        Main::apply_op(main, op, n);
    }

    state done(main: &mut Main) {}
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("nested_case_payload: case-payload commands feeding a nested integer dispatch");
    Main::apply_command(main, Command::Run { op: 0, n: 10 });
    Main::apply_command(main, Command::Noop);
    Main::apply_command(main, Command::Run { op: 2, n: 3 });
    Main::apply_command(main, Command::Run { op: 0, n: 15 });
    Main::apply_command(main, Command::Run { op: 1, n: 45 });
    Main::apply_command(main, Command::Run { op: 0, n: 5 });
    Main::apply_command(main, Command::Run { op: 2, n: 13 });
    Main::apply_command(main, Command::Run { op: 0, n: 5 });

    transition main.st.acc == 70 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: accumulator reached 70 after 8 commands (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::write_line("FAIL: wrong accumulator value (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}
