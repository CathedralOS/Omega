// A trait parameter bounded by `satisfies`:
// `trait Service<Policy satisfies Decider>` — the type
// argument must name a Decider implementation, declared by
// the `Impl satisfies Decider { Decider::member =
// Data::member; }` roster spelling.
//
//   * `trait Service<Policy satisfies Decider> { }` —
//     satisfies-bounded trait parameter.
//   * `RegistrarDecider satisfies Decider { Decider::pick =
//     Registrar::pick; }` — a named implementation (a map,
//     named apart from the data) wiring a trait member to an
//     existing machine.
//   * `HostService satisfies Service<RegistrarDecider> { }` —
//     the implementation used as the bounded argument.
//   * `Registrar::pick(6)` — one intended implementation is
//     called directly; `Decider::pick(6)` names no evidence.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Decider {
    machine pick(value: u64) -> u64;
}

data Registrar {}

RegistrarDecider satisfies Decider {
    Decider::pick = Registrar::pick;
}

machine Registrar::pick(value: u64) -> u64 { value }

trait Service<Policy satisfies Decider> { }

HostService satisfies Service<RegistrarDecider> { }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let picked: u64 = Registrar::pick(6);
    transition picked == 6 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
