// Record literals carrying array members: `[i32; 4]` and nested
// `[[i32; 2]; 2]` fields inside one literal, two `[u8; 2]` members
// in one record, and a negative-element operand `0 - 2` spelled
// inside the array literal.
//
//   * `Packet { samples: [9, 8, 7, 0 - 2] }` — array member with
//     computed element.
//   * `Grid { cells: [[1, 2], [3, 4]] }` — nested array member.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Packet { samples: [i32; 4]; }
data Pair { left: [u8; 2]; right: [u8; 2]; }
data Grid { cells: [[i32; 2]; 2]; }

data Main {
    packet: Packet;
    pair: Pair;
    grid: Grid;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.packet = Packet { samples: [9, 8, 7, 0 - 2] };
    main.pair = Pair { left: [1, 2], right: [3, 4] };
    main.grid = Grid { cells: [[1, 2], [3, 4]] };
    transition main.packet.samples[3] == -2
        && main.pair.right[1] == 4
        && main.grid.cells[1][0] == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
