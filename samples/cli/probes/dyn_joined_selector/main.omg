trait Step<T> { machine apply(counter: @mutable T); }
data Counter { value: i32 in Wrapping; }
Increment satisfies Step<Counter> {
    machine apply(counter: @mutable Counter) {
        counter.value = counter.value + 1;
    }
}
Double satisfies Step<Counter> {
    machine apply(counter: @mutable Counter) {
        counter.value = counter.value * 2;
    }
}
data Main { counter: Counter; double: bool; }
machine Main::main(main: @mutable Main) {
    main.counter.value = 5;
    main.double = true;
    transition main.double {
        (true) -> run(main, Double as dyn Step<Counter>),
        _ -> run(main, Increment as dyn Step<Counter>)
    }
    machine run(main: @mutable Main, step: dyn Step<Counter>) {
        Step::apply(step, @mutable main.counter);
        transition main.counter.value == 10 {
            (true) -> good(main),
            _ -> bad(main)
        }
    }
    machine good(main: @mutable Main) { let value: i32 = 70; }
    machine bad(main: @mutable Main) { let value: i32 = 71; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
