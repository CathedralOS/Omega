// linear_receipt_drop: linear data and explicit early disposal as sample
// code — the first sample declaring `[linear]` data with an authored
// owner-attached drop hook.
//
//   * `data Receipt [linear]` makes the value linear: it must reach a
//     checked cleanup edge — `drop(receipt)` here — rather than falling
//     out of scope unnoticed.
//   * `Receipt::drop` is the owner-attached hook the compiler selects at
//     that edge (never an authored call target); `observe` takes a shared
//     `&Receipt` before disposal.
//
// The machine issues a receipt at 70, observes its code through a shared
// borrow, drops it, then checks the observed value. Compile-checked only:
// no standard-library dependency, no ProcessExit provider.
use omega::language::core::drop;

data Receipt [linear] {
    code: i32;
}

machine Receipt::drop(receipt: &mut Receipt) {}

machine issue(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine observe(receipt: &Receipt) -> i32 {
    receipt.code
}

machine linear_receipt_drop() {
    let receipt: Receipt = issue(70);
    let observed: i32 = observe(&receipt);
    drop(receipt);
    transition observed == 70 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
