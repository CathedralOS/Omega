// A wholly anonymous constant tree stays an exact
// rational until its first typed destination — a
// transition parameter `got: f32` rounds it ONCE (here
// `1 + x` with x just above 2^-24 lands at 1 + 2^-23,
// rounding UP, unlike a per-op f32 tree).
//
//   * `check(main, 1.0 + 0.0000000596046483281043038005)`
//     — exact Rat → single rounding at argument landing.
//   * `(1.0 + 0.00000011920928955078125) as f32` — `as`
//     on a computed float IS accepted when the value is
//     exactly representable in the target format (refines
//     the per_op_f32_rounding gap: exact-representable
//     needs no named conversion).
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::float_operations;

data Main {
    expected: f32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.expected = 1.00000011920928955078125;
    main.hits = 0;
    transition { _ -> check(main, 1.0 + 0.0000000596046483281043038005) }
    state check(main: &mut Main, got: f32) {
        let cast: f32 = (1.0 + 0.00000011920928955078125) as f32;
        transition got == main.expected && cast == main.expected {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
