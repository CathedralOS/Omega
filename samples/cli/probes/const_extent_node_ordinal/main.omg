use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 0
// Expected output contains: 17
// A const-generic node table indexed by an ordinal whose declared range is
// the extent parameter. Clearance route planning hardcodes six nodes because
// a plain integer index is not a proof against `N`.

data Nodes<const N: u64> requires N >= 1 && N <= 8 {
    x: [i64 in Wrapping; N];
}

machine coordinate<const N: u64>(nodes: @Nodes<N>, index: u64) -> i64 in Wrapping
requires N >= 1 && N <= 8 && index < N
{
    let ordinal: u64 = index;
    nodes.x[ordinal]
}

machine origin<const N: u64>() -> u64
requires N >= 1 && N <= 8
ensures result < N
{
    0
}

machine from_call(nodes: @Nodes<4>, index: u64) -> i64 in Wrapping
requires index < 4
{
    nodes.x[index]
}

data Main { }

machine Main::main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let roadmap: Nodes<6> = Nodes { x: [0, 10, 3, 7, 3, 7] };
    let quad: Nodes<4> = Nodes { x: [1, 2, 3, 4] };
    let paired: i64 in Wrapping = coordinate(@roadmap, 1) + coordinate(@roadmap, 3);
    let start: u64 = origin::<4>();
    let roadmap_origin: u64 = origin::<6>();
    let opened: i64 in Wrapping = from_call(@quad, start) + coordinate(@quad, 2);
    transition paired == 17 && opened == 4 && roadmap_origin == 0 {
        true -> report(main, paired),
        false -> |process_exit|::ProcessExit::exit_process(1)
    }
    machine report(main: @mutable Main, paired: i64 in Wrapping) {
        number(main, paired);
        |console|::Console::write_line("");
        |process_exit|::ProcessExit::exit_process(0);
    }
}

machine number(main: @mutable Main, value: i64 in Wrapping) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    transition value >= 0 && value < 100 {
        true -> tens(main, value, value / 10),
        false -> |process_exit|::ProcessExit::exit_process(1)
    }
    machine tens(main: @mutable Main, value: i64 in Wrapping, ten: i64 in Wrapping) {
        transition ten > 0 {
            true -> emit(main, value, ten + 48),
            false -> ones(main, value)
        }
    }
    machine emit(main: @mutable Main, value: i64 in Wrapping, byte: i64 in Wrapping)
    requires byte >= 48 && byte <= 57
    {
        |console|::Console::write_byte(byte as i32);
        transition { _ -> ones(main, value) }
    }
    machine ones(main: @mutable Main, value: i64 in Wrapping) {
        let byte: i64 in Wrapping = value % 10 + 48;
        transition byte >= 48 && byte <= 57 {
            true -> finish(main, byte),
            false -> |process_exit|::ProcessExit::exit_process(1)
        }
    }
    machine finish(main: @mutable Main, byte: i64 in Wrapping)
    requires byte >= 48 && byte <= 57
    {
        |console|::Console::write_byte(byte as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
