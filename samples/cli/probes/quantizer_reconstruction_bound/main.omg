// Expected exit: 0.
// Nonnegative truncating division reconstructs within one remainder:
// (dividend / divisor) * divisor stays between dividend - (divisor - 1) and dividend.
// The sensor quantizer uses that window: step = 2*tolerance + 1, so the
// rounded sample is within tolerance of the observation.
data Main { }

data Reading where value >= 0 && value <= 20 {
    value: i32;
}

machine grid(value: i32, tolerance: i32) -> i32
requires value >= 0 && value <= 4095 && tolerance >= 0 && tolerance <= 7
ensures result >= value - tolerance && result <= value + tolerance
{
    let step: i32 = tolerance * 2 + 1;
    let sum: i32 = value + tolerance;
    (sum / step) * step
}

machine swapped(value: i32, tolerance: i32) -> i32
requires value >= 0 && value <= 4095 && tolerance >= 0 && tolerance <= 7
ensures result >= value - tolerance && result <= value + tolerance
{
    let step: i32 = tolerance * 2 + 1;
    transition { _ -> (step * ((value + tolerance) / step)) }
}

machine nearest(value: i32) -> i32
requires value >= 0 && value <= 20
ensures result >= value - 2 && result <= value + 2
{
    ((value + 2) / 5) * 5
}

machine through_call(value: i32, tolerance: i32) -> i32
requires value >= 0 && value <= 4095 && tolerance >= 0 && tolerance <= 7
ensures result >= value - tolerance && result <= value + tolerance
{
    grid(value, tolerance)
}

machine from_field(reading: &Reading) -> i32
ensures result >= reading.value - 2 && result <= reading.value + 2
{
    ((reading.value + 2) / 5) * 5
}

machine Main::main(main: &mut Main) crashes Trap {
    let reading: Reading = Reading { value: 7 };
    let rounded: i32 = grid(7, 2);
    let other: i32 = swapped(4, 2);
    let near: i32 = nearest(7);
    let called: i32 = through_call(0, 7);
    let field: i32 = from_field(&reading);
    transition rounded == 5 && other == 5 && near == 5 && called == 0 && field == 5 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
