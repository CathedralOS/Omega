// The package build machine's signature is enforced by shape:
// the first parameter must be spelled `builder: &mut Build` — the
// parameter name itself is part of the contract. A declared return
// type is accepted; the returned value is discarded.

machine build(builder: &mut Build) -> i32 {
    Build::application(builder, "build_machine_signature");
    builder.freestanding = true;
    0
}
