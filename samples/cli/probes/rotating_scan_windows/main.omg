// Expected exit: 0
// Replace one scan descriptor through a borrowed collection. The caller must
// observe the replacement's address and extent, retain the adjacent descriptor,
// and regain access to the displaced descriptor's original backing.

data Cell [copy] { value: u32; tag: u64; }
data Window<'input> { values: @'input mutable [Cell]; }

machine replace<'carrier, 'input>(windows: @'carrier mutable [Window<'input>], replacement: @'input mutable [Cell])
requires windows.length == 2 {
    windows[0].values = replacement;
}

machine replaced(values: @[Cell]) -> bool {
    transition values.length == 2 {
        true -> inspect(values),
        false -> false
    }
    machine inspect(values: @[Cell]) -> bool requires values.length == 2 {
        values[0].value == 42 && values[0].tag == 9223372036854775808
            && values[1].value == 19 && values[1].tag == 29
    }
}

machine unchanged(values: @[Cell]) -> bool {
    transition values.length == 1 {
        true -> inspect(values),
        false -> false
    }
    machine inspect(values: @[Cell]) -> bool requires values.length == 1 {
        values[0].value == 31 && values[0].tag == 41
    }
}

machine main() crashes Trap {
    let mutable original: [Cell; 1] = [Cell { value: 7, tag: 17 }];
    let mutable neighbor: [Cell; 1] = [Cell { value: 31, tag: 41 }];
    let mutable replacement: [Cell; 2] = [Cell { value: 42, tag: 9223372036854775808 }, Cell { value: 19, tag: 29 }];
    let mutable windows: [Window; 2] = [Window { values: @mutable original[..] }, Window { values: @mutable neighbor[..] }];
    replace(@mutable windows[..], @mutable replacement[..]);
    original[0].value = 9;
    let valid: bool = replaced(windows[0].values);
    let adjacent: bool = unchanged(windows[1].values);
    transition valid && adjacent && original[0].value == 9 && original[0].tag == 17 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
