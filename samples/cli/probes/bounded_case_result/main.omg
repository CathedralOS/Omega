// A bounded text local lends to a machine whose result is a case
// value: `leading` forwards the `&[u8; 2] in Utf8` loan through
// states, reads the fixed length, and returns the first byte as a
// case payload `(Leading::Byte { value })` vs `(Leading::Empty)`.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 2]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Leading {
    case Empty;
    case Byte(value: u64);
}
machine leading(text: &[u8; 2] in Utf8) -> Leading {
    transition {
        _ -> inspect(text)
    }
    machine inspect(text: &[u8; 2] in Utf8) -> Leading {
        transition 0 < text.len {
            true -> read(text)
            _ -> (Leading::Empty)
        }
    }
    machine read(text: &[u8; 2] in Utf8) -> Leading {
        let byte: u8 = text[0];
        transition {
            _ -> (Leading::Byte { value: byte as u64 })
        }
    }
}
data Main {}
machine Main::main(main: &mut Main) {
    let text: [u8; 2] in Utf8 = "OK";
    let first: Leading = leading(&text);
    transition first {
        Leading::Byte { value } -> seen(value)
        _ -> miss()
    }
    machine seen(value: u64) { }
    machine miss() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
