// State-arrival contract carrying a byte predicate:
// `transition valid_utf8(view)` mints the predicate fact
// on the canonical place, and the target state's
// `requires valid_utf8(view)` discharges it as a block
// invariant on that arriving edge (unguarded arrival
// rejects — fail sibling).
//
//   * `domain [u8]::Utf8(bytes) requires
//     valid_utf8(bytes)`.
//   * `view: &[u8] = main.buffer[0..1]` slice param.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    buffer: [u8; 8];
    result: u64;
}

machine Main::main(main: &mut Main) {
    main.buffer[0] = 65;
    main.result = 0;
    let view: &[u8] = main.buffer[0..1];
    transition valid_utf8(view) {
        true -> checked(main, view)
        false -> bad()
    }
    state checked(main: &mut Main, view: &[u8])
    requires
        valid_utf8(view)
    {
        main.result = view.len;
    }
    state bad() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
