// Short-circuit custody: `enabled && consume(Wrapped {
// token })` transfers the named owner only on the taken
// path; the skipped side settles its retained custody
// before reconverging. `||` mirrors it. A disjoint sibling
// stays available throughout.
//
//   * `consume` as right operand of `&&` and `||`.
//   * `Holder<Value>` generic wrapper inline.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Token { value: u64; }
data Wrapped { token: Token; }
data Holder<Value> { value: Value; }

machine consume(value: Wrapped) -> u64 { value.token.value }

machine and_transfer(enabled: bool) -> bool {
    let token: Token = Token { value: 9 };
    let survivor: Token = Token { value: 10 };
    let observed: bool = enabled && consume(Wrapped { token: token }) == 9;
    (observed == enabled) && survivor.value == 10
}

machine or_transfer(enabled: bool) -> bool {
    let token: Token = Token { value: 9 };
    let survivor: Token = Token { value: 10 };
    let observed: bool = enabled || consume(Wrapped { token: token }) == 9;
    observed && survivor.value == 10
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let a: bool = and_transfer(true);
    let b: bool = and_transfer(false);
    let c: bool = or_transfer(true);
    let d: bool = or_transfer(false);
    transition a && b && c && !d {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
