// Width mixer: mixed integer widths (i16, u8, i32) in arithmetic chains.
//
// Exercises: i16 and u8 fields in the same data struct as i32 fields,
// storing values of different widths, arithmetic between fields, and
// guarding on the result — all within one state machine.
//
// The scenario: a simple point-value accumulator that tracks counts
// at different bit widths.
//
// Data:
//   flags: u8        -- counts small events (0..255)
//   offset: i16      -- signed 16-bit offset (-32768..32767)
//   total: i32       -- 32-bit accumulator
//
// Operations:
//   flags = 5
//   offset = -300
//   total = widen(flags) * 10 + widen(offset) + 320
//         = 50 + (-300) + 320 = 70
//
// The widened flags * 10 = 50
// widened offset = -300
// 50 + (-300) + 320 = 70
//
// Expected exit: 70.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Readings [copy] {
    flags: u8;
    offset: i16;
    total: i32 in Saturating;
}

data Main {
    console: Console;
    data: Readings;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("width_mixer: u8, i16, and i32 fields combined through named widening");
    // Set up the sub-width fields.
    self.data.flags = 5;
    self.data.offset = 0 - 300;

    // Compute: flags*10 = 50, offset = -300, 50 + (-300) + 320 = 70.
    // Widen through visible calls, then qualify the Exact results for the
    // saturating arithmetic chain.
    let flags_i32: i32 in Saturating =
        widen_u8_to_i32(self.data.flags) as i32 in Saturating;
    let offset_i32: i32 in Saturating =
        widen_i16_to_i32(self.data.offset) as i32 in Saturating;
    let contrib: i32 in Saturating = flags_i32 * 10;
    self.data.total = contrib + offset_i32 + 320;

    transition self.data.total == 70 {
        true -> check_flags()
        _ -> bad_total()
    }

    state check_flags(&mut self) {
        // Verify u8 field stored correctly.
        transition self.data.flags == 5 {
            true -> check_offset()
            _ -> bad_flags()
        }
    }

    state check_offset(&mut self) {
        // Verify i16 field stored the signed value.
        transition self.data.offset == 0 - 300 {
            true -> good()
            _ -> bad_offset()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: 50 - 300 + 320 = 70 across three widths (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad_total(&mut self) {
        self.console.write_line("FAIL: the mixed-width total was not 70 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state bad_flags(&mut self) {
        self.console.write_line("FAIL: the u8 flags field did not read back 5 (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state bad_offset(&mut self) {
        self.console.write_line("FAIL: the i16 offset field did not read back -300 (exit 73)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }
}
