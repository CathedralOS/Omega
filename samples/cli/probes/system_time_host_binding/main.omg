use {omega}/language/core/process_exit.omg;
use {system}/time.omg;
use {system}/time_host.omg;
// Both native code and the CLI's Psi interpreter read the host clock.
// Exit 70 when sleep_for reports 50 ms and at least that much time has
// elapsed since instant_now.

data Main {
}

machine entry_start() reaches |process_exit|::ProcessExit + |time_host|::TimeHost {
    let mutable entry: Main;
    let start: |time|::Instant = |time|::instant_now();
    let pause: |time|::Duration = |time|::Duration { seconds: 0, subsecond_nanoseconds: 50000000 };
    let slept: u32 = block |time|::sleep_for(pause);
    let elapsed: |time|::Duration = |time|::elapsed_since(start);
    let long_enough: bool = elapsed.seconds > 0 || elapsed.subsecond_nanoseconds >= 50000000;
    transition slept == 50 && long_enough {
        true -> pass(),
        _ -> fail()
    }
    machine pass() { |process_exit|::ProcessExit::exit_process(70); }
    machine fail() { |process_exit|::ProcessExit::exit_process(1); }
}
