// Cross-width comparisons: `main.small == main.big` compares an
// i8 field against an i32 field — integer comparisons compose
// across carrier widths.
//
//   * `i8 == i32` (44 vs 300 → miss), `i16 < i64`, `u8 == i32`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Main {
    small: i8;
    big: i32;
    mid: i16;
    far: i64;
    tiny: u8;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.small = 44;
    main.big = 300;
    main.mid = -5;
    main.far = 1000;
    main.tiny = 44;
    transition main.small != main.big && main.mid < main.far
        && main.tiny == main.small {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
