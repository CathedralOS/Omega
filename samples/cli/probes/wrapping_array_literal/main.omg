// Expected exit: 0
// The fixed array, nested array, and record field retain Wrapping on each
// u32 element. Incrementing the maximum u32 produces zero.

data Holder { values: [u32 in Wrapping; 1]; }

machine entry_start() crashes Trap {
    let values: [u32 in Wrapping; 1] = [(4294967295u32 as u32 +Wrapping)];
    let nested: [[u32 in Wrapping; 1]; 1] = [[(1u32 as u32 +Wrapping)]];
    let holder: Holder = Holder { values: [(2u32 as u32 +Wrapping)] };
    let wrapped: u32 in Wrapping = values[0] + 1u32;
    let inner: u32 in Wrapping = nested[0][0];
    let member: u32 in Wrapping = holder.values[0];
    transition (wrapped as -Wrapping) == 0 && (inner as -Wrapping) == 1 && (member as -Wrapping) == 2 {
        true -> pass(),
        _ -> fail()
    }
    machine pass() {}
    machine fail() crashes Trap { crash Trap; }
}
