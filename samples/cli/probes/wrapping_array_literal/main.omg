// `[u32; 1] in Wrapping` — an array literal whose
// element domain is retained at the whole-array type:
// the annotation applies the policy to every element,
// nested arrays, record members, and their arithmetic.
//
//   * `[(4294967295u32 as u32 in Wrapping)]` — explicit
//     element grants inside the literal.
//   * `values[0] + 1u32` — wrapping arithmetic on a
//     projected element, `4294967295 + 1` folds to `0`.
//   * `crash Trap` — the unconditional failure state.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Holder { values: [u32; 1] in Wrapping; }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let values: [u32; 1] in Wrapping = [(4294967295u32 as u32 in Wrapping)];
    let nested: [[u32; 1]; 1] in Wrapping = [[(1u32 as u32 in Wrapping)]];
    let holder: Holder = Holder { values: [(2u32 as u32 in Wrapping)] };
    let wrapped: u32 in Wrapping = values[0] + 1u32;
    let inner: u32 in Wrapping = nested[0][0];
    let member: u32 in Wrapping = holder.values[0];
    transition wrapped == 0 && inner == 1 && member == 2 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
