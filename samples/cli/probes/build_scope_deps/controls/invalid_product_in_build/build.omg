use {scope_kernel}/main.omg as kit;
use main.omg as app;

machine build(plan: @mutable BuildPlan) {
    _ = |kit|::v();
    _ = Build::dependency(plan, Source::Path { location: "dep" });
    plan.product = BuildProduct::Application { name: "invalid_product_in_build" };
    Build::bind(plan, linux_x86_64::ProgramEntry, |app|::main);
}
