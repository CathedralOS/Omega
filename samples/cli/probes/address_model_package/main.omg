// Expected exit: 0.
// The selected 64-bit address-model premise crosses a reviewed package boundary.
use {model}/main.omg as model;
data Main {}

machine Main::main(context: @mutable Main) crashes Trap
requires address::Bound == 18446744073709551616
{
    let address: address = |model|::physical_address(4096);
    let echoed: u64 = |model|::echo(17);
    let declared: u64 = |model|::authored_bound();
    let bytes: [u8; 16] = [0, 0, 0, 0, 0, 0, 0, 0, 42, 0, 0, 0, 0, 0, 0, 0];
    let word: u64 = |model|::read_word(@bytes, 8);
    transition address == 4096 && echoed == 17 && declared == 17 && word == 42 {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap
requires address::Bound == 18446744073709551616
{
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
