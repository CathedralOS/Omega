// Scoped aggregate constants: `const Sizes::SIZE` binds through a
// data namespace and keeps its canonical identity even when a local
// binding shadows the scope name (`let Sizes: u64 = 0` — the
// `Indexed<Sizes::SIZE>` selection still resolves through the
// shadow). Const params may themselves be record-typed
// (`const Selected: Index`).
//
//   * `data Indexed<const Selected: Index>` — record-typed const
//     parameter.
//   * `before_local` shadows `Sizes` with a scalar local; the
//     scoped const is unaffected.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Index [copy] { value: u64; }
data Sizes {}
const Sizes::SIZE: Index = Index { value: 1 };

data Indexed<const Selected: Index> [copy] { value: u8; }

machine keep(value: Indexed<Sizes::SIZE>) -> Indexed<Sizes::SIZE> { value }
machine before_local(value: Indexed<Sizes::SIZE>) -> Indexed<Sizes::SIZE> {
    let Sizes: u64 = 0;
    value
}

data Main {
    item: Indexed<Sizes::SIZE>;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.item.value = 9;
    transition keep(main.item).value == 9 && before_local(main.item).value == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
