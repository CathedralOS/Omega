// Slice-length termination measure: `terminates by entries` takes the
// default order over the slice's length; each recursive call forwards
// `entries[1..]`, shortening the measure.
//
//   * `machine Main::walk(main: &Main, entries: &[Entry])
//      terminates by entries` — measure is the slice itself.
//   * Runtime recursion is TAIL-ONLY: the measured machine carries
//      its count in a `depth` accumulator — `walk(...) + 1` feeding
//      an operand is rejected as non-tail self-recursion.
//   * `&main.entries[..]` — whole-array shared slice view; the `&mut`
//      entry borrow weakens to `&` for the callee.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Entry { value: i32; }

machine Main::walk(main: &Main, entries: &[Entry], depth: u64 in Wrapping)
terminates by entries;
-> u64 in Wrapping
{
    transition entries.len > 0 {
        true -> Main::walk(main, entries[1..], depth + 1)
        false -> depth
    }
}

data Main {
    entries: [Entry; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition { _ -> start(main) }
    machine start(main: &mut Main) {
        let view: &[Entry] = &main.entries[..];
        transition Main::walk(main, view, 0) == 4 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
