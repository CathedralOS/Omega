// Invariant window: `data Main where start <= end` — the
// first field write transiently violates the bound, the
// second restores it, and the next call closes the derived
// window. The standing bound only needs to hold at state
// boundaries, not between statements.
//
//   * `main.start = 10; main.end = 20;` — write order
//     violates then restores.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main
where
    start <= end,
{
    start: i32;
    end: i32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.start = 10;
    main.end = 20;
    transition main.start <= main.end {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
