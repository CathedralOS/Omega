// Result-claim modes: `make` returns a receipt it established
// itself — the caller's result claim is fresh in its namespace;
// `pass` returns its input unchanged — the result claim
// continues the identity the call transferred in. Both bind the
// claim the callee's returning edge holds at the result root.
//
//   * Domain-qualified `Receipt in Receipt::Issued` continues
//     across produced and forwarded results alike.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Receipt [linear] { code: i32; }
domain Receipt::Issued;
machine Receipt::drop(receipt: &mut Receipt) {}

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine pass(receipt: Receipt) -> Receipt {
    receipt
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let made: Receipt = make(1);
    let moved: Receipt = make(2);
    let kept: Receipt = pass(moved);
    let a: i32 = consume(made);
    let b: i32 = consume(kept);
    transition a == 1 && b == 2 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
