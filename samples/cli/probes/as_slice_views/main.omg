// The `.as_slice()` view constructor: `main.entries
// .as_slice()` yields `&[Entry]` whose element/range
// operators carry `index < items.len` obligations — a
// proven closed bound, including an EMPTY range at the
// end (`view[4..4]`), discharges through the imported
// `Slice::index`/`Slice::range` contracts.
//
//   * `main.entries.as_slice()` — array → `&[Entry]`.
//   * `view.len` extent read on the view.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::slice;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let view: &[Entry] = main.entries.as_slice();
    let whole: u64 = view.len;
    transition whole == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
