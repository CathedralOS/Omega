// Generic invocations inside const evaluation:
// `const Observed: u64 = extent()` where `extent()`
// instantiates `identity<[u8; Count]>` — the substituted
// `T` row retains `Count`'s const-param origin even though
// the structural extent is already 3. `bytes.len` reads
// the extent of the evaluated literal.
//
//   * `const Count: u64 = count()` — machine call in
//     const.
//   * `identity<[u8; Count]>([1u8, 2u8, 3u8])` — const-
//     param type argument in evaluated position.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

const Observed: u64 = extent();
const Count: u64 = count();

machine count() -> u64 { 3 }

machine identity<T [copy]>(value: T) -> T { value }

machine extent() -> u64 {
    let bytes: [u8; Count] = identity<[u8; Count]>([1u8, 2u8, 3u8]);
    bytes.len
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition Observed == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
