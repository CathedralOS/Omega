// A plain `let` binding (no `mut`) still lends `&mut`
// into a callee's out-parameter: `mut` gates rebinding of
// the NAME, not the mutability of loans from the owned
// storage. `find(2, &mut found)` writes through the loan
// and the caller's binding observes both writes.
//
//   * `machine find(key: i32, out: &mut Item)` — whole-
//     place `&mut` out-param.
//   * `let found: Item = Item { key: 0, val: 0 }` then
//     `find(2, &mut found)` — no `mut` needed on the
//     binding.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Item {
    key: i32;
    val: i32;
}

machine find(key: i32, out: &mut Item) {
    out.key = key;
    out.val = 5;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let found: Item = Item { key: 0, val: 0 };
    find(2, &mut found);
    transition found.key == 2 && found.val == 5 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
