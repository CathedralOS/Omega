// Checked provider-contract sample. No package dependencies: the bound
// entry is inert and every declaration it checks comes from the bundled
// core vocabulary — the protocol drivers stay unreachable because
// BoundaryOpaque values cannot cross a reachable state signature until
// Terminal unit plans admit them, and native realization of the ten loan
// crossings is still the toolchain's next edge.

use main.omg as app;
use {omega}/language/core/device.omg;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "device_extent_access" };
    Build::accept_boundary::<|device|::DeviceLoanProvider>(builder);
    Build::select_representation::<|device|::DeviceLoan, |app|::DeviceLoanRepresentation>(builder);
    Build::select_representation::<|device|::DeviceOrderingEvent, |app|::DeviceOrderingEventRepresentation>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
