// An interval-domained payload member: `case Lit(amount: i32 in Ten)` — the
// construction proves the member's range obligation, and the dispatched
// payload discharges `scale`'s requires through its domain alone.
domain i32::Ten(value) requires 0 <= value && value <= 10;
data Command {
    case Off;
    case Lit(amount: i32 in Ten);
}
machine scale(amount: i32) -> i32 requires 0 <= amount && amount <= 10 {
    amount
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let cmd: Command = Command::Lit { amount: 7 };
    transition cmd {
        Command::Lit { amount } -> apply(main, amount)
        Command::Off -> bad(main)
    }
    machine apply(main: &mut Main, amount: i32 in Ten) {
        main.hits = main.hits + (scale(amount) as i32 in Wrapping);
    }
    machine bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
