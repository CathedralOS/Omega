// Case-field stores land on non-parameter roots too:
// `boxed.fmt = fresh` where `boxed` is an owned local writes through
// the local's home place — a leaf copy of the parameter value plus
// the window move/store pair.
//
//   * `machine reseat(fresh: Fmt)` — the argument flows into a field
//     of a locally-constructed record.
//   * `machine Main::make -> Point` — record literal as an arm
//     result after a side-effecting body.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Fmt [copy] {
    case Decimal;
    case Hex;
    case Octal;
}

data Box {
    fmt: Fmt;
    tag: u64;
}

data Point [copy] { x: i32; y: i32; }

machine reseat(fresh: Fmt) {
    let mut boxed: Box = Box { fmt: Fmt::Decimal, tag: 4 };
    boxed.fmt = fresh;
}

data Main {
    calls: u32 in Wrapping;
    hits: i32 in Wrapping;
}

machine Main::make(main: &mut Main, base: i32) -> Point {
    main.calls = main.calls + 1;
    transition { _ -> Point { x: base, y: 20 } }
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    reseat(Fmt::Octal);
    let point: Point = Main::make(main, 10);
    transition point.x == 10 && point.y == 20 && main.calls == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
