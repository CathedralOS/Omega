// A sized-array domain borrowed mutably: `domain
// [u8; 8]::Ascii(bytes) requires ascii_only(bytes)`
// declares a domain over the whole array type, and
// `&mut [u8; 8] in Ascii` lends a domained array — writes
// through the borrow must preserve the ASCII predicate.
//
//   * `ascii_only` — compiler-known byte predicate; no
//     import or machine needed (same family as
//     `valid_utf8`).
//   * `let mut bytes: [u8; 8] in Ascii = [97u8, 98u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]` — a string
//     literal folds the predicate at compile time to
//     establish the domain.
//   * Guard `value < 128` preserves ASCII across the
//     write; the failing arm keeps the domain without
//     touching bytes.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain [u8; 8]::Ascii(bytes) requires ascii_only(bytes);

machine replace(at: u64, bytes: &mut [u8; 8] in Ascii, value: u8) -> bool {
    transition at < bytes.len && value < 128 {
        true -> write(at, bytes, value, true)
        _ -> false
    }
    state write(at: u64, bytes: &mut [u8; 8] in Ascii, value: u8, repeat: bool) -> bool {
        bytes[at] = value;
        transition repeat {
            true -> write(at, bytes, value, false)
            _ -> true
        }
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut bytes: [u8; 8] in Ascii = [97u8, 98u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let first: bool = replace(0, &mut bytes, 65);
    let rejected: bool = replace(1, &mut bytes, 200);
    transition first && !rejected {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
