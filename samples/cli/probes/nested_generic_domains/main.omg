// Nested domain requires — a requires clause referencing another
// domain — plus domain-qualified top-level consts, and the two
// unverifiable corners found while probing (see README).
//
//   * `domain u64::Nested requires value in Small` — a requires clause
//     may reference another domain on the same carrier.
//   * `Packet::SmallCount requires packet.count in Nested` — nested
//     requires through a record field; literal construction proves it.
//   * `const ... : T in D = literal` — domain-qualified consts; values
//     re-prove their clauses at use (the const does not carry an opaque
//     qualification — see README).
//   * `domain u64::Below<Bound>` is const-generic: scalar `as`-grants
//     DO discharge it (`3 as u64 in Below<5>`), but plain value/const
//     arguments cannot — filed gap.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain u64::Small(value) requires value < 5;
domain u64::Nested(value) requires value in Small;
domain<const Bound: u64> u64::Below<Bound>(value) requires value < Bound;

data Packet [copy] {
    count: u64;
}

domain Packet::SmallCount(packet) requires packet.count in Nested;

const SCALAR: u64 in Nested = 3;
const RECORD: Packet in SmallCount = Packet { count: 3 };

data Main {
    hits: i32 in Wrapping;
}

machine Main::accept(scalar: u64 in Nested, bounded: u64 in Below<5>,
        record: Packet in SmallCount) {
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    // SCALAR/RECORD literals re-prove their nested requires; Below<5>
    // needs an explicit `as` grant (literal/const args can't prove it).
    Main::accept(SCALAR, 3 as u64 in Below<5>, RECORD);
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
