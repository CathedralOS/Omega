// Machine parameters with const-param schemas and reach bounds:
// `apply<machine Schema, machine Unused>` takes two machines, each
// bound by `where machine X<const Number: u64>(value: u64) -> u64
// reaches Console` — a generic callback constraint combining a
// const-generic signature AND a reach ceiling. Calls spell
// `Schema<2>(value)`.
//
//   * `machine selected<const Count: u64>` — const-generic machine
//     passed by name as the Schema argument.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

boundary trait Console { machine ping() reaches; }

machine apply<machine Schema, machine Unused>(value: u64) -> u64
where machine Schema<const Number: u64>(value: u64) -> u64 reaches Console;
where machine Unused<const Number: u64>(value: u64) -> u64 reaches Console;
{
    let first: u64 = Schema<2>(value);
    Schema<3>(first)
}

machine selected<const Count: u64>(value: u64) -> u64 reaches Console { Count }
machine unused<const Count: u64>(value: u64) -> u64 reaches Console { value }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition apply<selected, unused>(9) == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
