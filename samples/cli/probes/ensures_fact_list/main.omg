// Multi-clause ensures lists: a machine's `ensures` roster carries
// several facts at once — `count > 0; count <= slots.len` — and a
// `requires` roster quotes member expressions
// (`counter.slots.len`) as discharge vocabulary.
//
//   * `Counter::bump` requires+ensures a two-fact roster.
//   * `Counter::release` requires the invariant it preserves.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Counter {
    slots: [i32; 4];
    count: u64;
}

machine Counter::reset(counter: &mut Counter)
ensures
    counter.count < counter.slots.len
{
    counter.count = 0;
}

machine Counter::bump(counter: &mut Counter)
requires
    counter.count < counter.slots.len
ensures
    counter.count > 0;
    counter.count <= counter.slots.len
{
    counter.count = counter.count + 1;
}

machine Counter::release(counter: &mut Counter)
requires
    counter.count > 0;
    counter.count <= counter.slots.len
{
    counter.count = counter.count - 1;
}

data Main {
    counter: Counter;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    Counter::reset(&mut main.counter);
    Counter::bump(&mut main.counter);
    transition main.counter.count == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
