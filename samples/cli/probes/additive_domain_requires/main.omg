// additive_domain_requires: domain-constrained operator meanings as sample
// code — the first sample where `+` selection is gated by a `requires`
// domain fact.
//
//   * `Quantity::Additive` is a domain over the carrier `value` requiring
//     `value >= 0`; constructing `Quantity { value: 3 }` establishes the
//     domain fact for the literal.
//   * `machine + Quantity::Additive::add` implements `+` only when its
//     `requires right in Quantity::Additive` discharges — selection is
//     positive proof context, not a type rule.
//   * `combine`'s own `requires a in D, b in D` carries the caller's facts
//     into the `a + b` site, discharging both operand facts.
//
// The machine combines 3 + 4 = 7 under proof, reads it back, and accepts
// on 7. Compile-checked only: no standard-library dependency.
data Quantity {
    value: i32;
}

domain Quantity::Additive(quantity)
requires
    quantity.value >= 0;

machine + Quantity::Additive::add(left: Quantity, right: Quantity) -> Quantity
requires
    right in Quantity::Additive
{
    Quantity { value: ((left.value as i32 in Wrapping) + (right.value as i32 in Wrapping)) as i32 }
}

machine combine(a: Quantity, b: Quantity) -> Quantity
requires
    a in Quantity::Additive,
    b in Quantity::Additive
{
    let sum: Quantity = a + b;
    sum
}

machine additive_domain_requires() {
    let total: Quantity = combine(Quantity { value: 3 }, Quantity { value: 4 });
    transition total.value == 7 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
