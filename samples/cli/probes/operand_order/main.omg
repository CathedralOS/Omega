// Ordinary `machine +` operator overloading on user data, plus the
// argument-evaluation contract: operands evaluate in WRITTEN order, so
// side-effecting `tick` calls observe 1, 2, 3, 4 regardless of the
// destination field's declaration order.
//
//   * `machine + Score::add` — ordinary operator on `[copy]` data;
//     result carries a `u64 in Wrapping` domain (the overload's return
//     type need not be the operand type).
//   * `forward<Value>` — unconstrained generic identity by value.
//   * `in_order(tick, Ordered{second: tick, first: tick}, tick)` —
//     fields initialize in written order (second=2, first=3), not
//     declaration order; the counter reads 1,2,3,4.
//   * `hits == 1` proves every arm ran.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Score [copy] { value: u64; }
data Ordered [copy] { first: u64; second: u64; }

machine + Score::add(left: Score, right: Score) -> u64 in Wrapping {
    (left.value as u64 in Wrapping) + (right.value as u64 in Wrapping)
}

machine forward<Value>(value: Value) -> Value { value }

machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}

machine in_order(before: u64, pair: Ordered, after: u64) -> bool {
    before == 1 && pair.second == 2 && pair.first == 3 && after == 4
}

data Main {
    count: u64;
    total: u64 in Wrapping;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.count = 0;
    main.total = 0;
    main.hits = 0;
    let combined: u64 in Wrapping = Score { value: 40 } + Score { value: 30 };
    transition combined == 70 && in_order(tick(&mut main.count), Ordered {
        second: tick(&mut main.count),
        first: tick(&mut main.count),
    }, tick(&mut main.count)) {
        true -> Main::pass(main)
        _ -> Main::fail(main)
    }
    state pass(main: &mut Main) {
        main.total = forward<u64>(main.count) as u64 in Wrapping;
        main.hits = 1;
    }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
