use omega::language::core::ProcessExit;
// The raw time-host seams are boundary traits selected under `TimeHost`.
// `instant_now` reads the monotonic clock and `sleep_for` waits 50ms.
// The interpreter's virtual clock advances by exactly that wait; a host
// clock measures at least 50ms. Exit 70 when both observations hold.
//
// Expected exit: 70.
use omega_language_std::Console;
use omega_language_std::Duration;
use omega_language_std::Instant;
use omega_language_std::TimeHost;
use omega_language_std::elapsed_since;
use omega_language_std::instant_now;
use omega_language_std::sleep_for;

data Main {
}

machine entry_start() reaches ProcessExit + Console + TimeHost {
    let mut entry: Main;
    let start: Instant = instant_now();
    let pause: Duration = Duration { seconds: 0, subsecond_nanoseconds: 50000000 };
    let slept: u32 = block sleep_for(pause);
    let elapsed: Duration = elapsed_since(start);
    let long_enough: bool = elapsed.seconds > 0 || elapsed.subsecond_nanoseconds >= 50000000;
    transition slept == 50 && long_enough {
        true -> pass()
        _ -> fail()
    }
    machine pass() { ProcessExit::exit_process(70); }
    machine fail() { ProcessExit::exit_process(1); }
}
