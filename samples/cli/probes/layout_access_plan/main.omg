use {omega}/language/core/access/access.omg as access;
use {omega}/language/core/layout.omg as layout;
use {omega}/language/core/reflect/reflect.omg as reflect;

public data Pair {
    readable: u32;
    hidden: u32;
}
public domain Pair::Restricted access PairAccess;

PairAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan
    reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflect|::field(Pair::readable),
            |layout|::FieldAccess::Stable {
                read: true, take: false, write: false, swap: false,
                exposure: |layout|::Exposure::Exported
            });
        |access|::observe(@mutable plan, |reflect|::field(Pair::hidden), |layout|::FieldAccess::Inaccessible);
        plan
    }
}

data PairStorage = |layout|::LayoutStorage<Pair, PairLayout>;

PairLayout satisfies |layout|::FixedLayout<Pair> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan
    reaches none crashes none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 4 } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 2, size_fixed: 8, size_is_dynamic: false, align: 4 }
    }
}

const ObservedFields: u64 = described_fields();

machine described_fields() -> u64 {
    let policy: |layout|::AccessPlan = PairAccess::plan(|reflect|::schema::<Pair>());
    policy.field_count
}

machine entry_start() crashes Trap {
    let mutable pair: PairStorage;
    pair.readable = 3u32;
    pair.hidden = 17u32;
    let bytes: @[u8; 8] = @pair as @[u8; 8];
    transition ObservedFields == 2u64 && bytes[0] == 17u8 && bytes[4] == 3u8 {
        true -> done(), _ -> fail()
    }
    machine done() {}
    machine fail() { crash Trap; }
}
