// Layout access plans: `AccessPlan::inaccessible(layout)` seeds a deny-all
// plan per distinct layout field key; `AccessPlan::with(plan, key,
// FieldAccess::Stable { read, write, exposure })` functionally replaces
// only the permissions meant to be exposed.
//
//   * `use omega::language::core::layout` imports depend-free.
//   * `satisfies AccessPolicy::plan` binds a plan machine by name.
//   * the policy composes an ordinary layout helper by calling it.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::layout;

data Pair {
    readable: u32;
    hidden: u32;
}

data PairAccess {}

machine PairAccess::layout(schema: &Schema) -> LayoutPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 4 } };
    LayoutPlan { entries: entries, entry_count: 2, size_fixed: 8, size_is_dynamic: false, align: 4 }
}

machine PairAccess::plan(schema: Schema) -> AccessPlan
satisfies AccessPolicy::plan
{
    let plan: AccessPlan = AccessPlan::inaccessible(PairAccess::layout(&schema));
    transition { _ -> expose(schema, plan) }

    machine expose(schema: Schema, plan: AccessPlan) -> AccessPlan {
        AccessPlan::with(
            plan,
            schema.fields[0].key,
            FieldAccess::Stable {
                read: true,
                write: false,
                exposure: Exposure::Exported
            }
        )
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
