// Layout access plans: `AccessPlan::inaccessible(&schema)` seeds a
// deny-all plan per reflected field; `AccessPlan::with(plan, key,
// FieldAccess::Stable { read, write, exposure })` functionally
// replaces only the permissions meant to be exposed.
//
//   * `use omega::language::core::layout` imports depend-free.
//   * `satisfies Access::plan` binds a plan machine by name.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::layout;

data Pair {
    readable: u32;
    hidden: u32;
}

data PairAccess {}

machine PairAccess::plan(schema: Schema, layout: Plan) -> AccessPlan
satisfies Access::plan
{
    let plan: AccessPlan = AccessPlan::inaccessible(&schema);
    transition { _ -> expose(schema, plan) }

    state expose(schema: Schema, plan: AccessPlan) -> AccessPlan {
        AccessPlan::with(
            plan,
            schema.fields[0].key,
            FieldAccess::Stable {
                read: true,
                write: false,
                exposure: Exposure::Exported
            }
        )
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
