// Predicate-gated data: `data Grid where
// cells_valid(&board) == true` — the default domain is an
// ordinary predicate machine walking `&board` one state per
// element. Every cell zero satisfies the walk, so the
// zeroed `Grid` is established at boot and `main` may read
// `grid.board[2]` before any store.
//
//   * `data Grid where cells_valid(&board) == true` on the
//     data header.
//   * Per-element state chain `at_1`/`at_2`/`at_3`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    state at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    state at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    state at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
    seen: i32;
}

machine Main::main(main: &mut Main) {
    main.seen = main.grid.board[2];
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
