// Expected exit: 70.
// Minimal miscompile probe: 5-arm case dispatch with payload variants first,
// then no-payload variants. Tests that the no-payload Trigger arm (position 3)
// is reachable and increments a counter.
//
// Expected: fire_count = 2 after two Trigger dispatches -> exit 70.
// If Trigger arm is unreachable or silently dropped: exit 71.

use omega_language_std::console;

data AlarmEvent {
    case Set(hour: i32 in Saturating, minute: i32 in Saturating);
    case Snooze(minutes: i32 in Saturating);
    case Cancel;
    case Trigger;
    case Dismiss;
}

data Main {
    console: Console;
    fire_count: i32 in Saturating;
    pause: [u8; 256];
}

machine Main::dispatch(&mut self, event: AlarmEvent) {
    transition event {
        AlarmEvent::Set { hour, minute } -> do_set(hour, minute)
        AlarmEvent::Snooze { minutes } -> do_snooze(minutes)
        AlarmEvent::Cancel -> do_cancel()
        AlarmEvent::Trigger -> do_trigger()
        AlarmEvent::Dismiss -> do_dismiss()
        _ -> done()
    }

    state do_set(&mut self, hour: i32 in Saturating, minute: i32 in Saturating) {}
    state do_snooze(&mut self, minutes: i32 in Saturating) {}
    state do_cancel(&mut self) {}
    state do_trigger(&mut self) { self.fire_count = self.fire_count + 1; }
    state do_dismiss(&mut self) {}
    state done(&mut self) {}
}

machine Main::main(&mut self) {
    self.console.write_line("alarm_probe: no-payload case arm after payload arms -- Trigger must fire twice");
    self.dispatch(AlarmEvent::Trigger);
    self.dispatch(AlarmEvent::Trigger);

    transition self.fire_count == 2 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) {
        self.console.write_line("PASS: fire_count == 2 after two Trigger dispatches (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: fire_count != 2 -- Trigger arm dropped or unreachable (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }
}
