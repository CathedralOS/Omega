use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 70.
// Minimal miscompile probe: 5-arm case dispatch with payload variants first,
// then no-payload variants. Tests that the no-payload Trigger arm (position 3)
// is reachable and increments a counter.
//
// Expected: fire_count = 2 after two Trigger dispatches -> exit 70.
// If Trigger arm is unreachable or silently dropped: exit 71.


data AlarmEvent {
    case Set(hour: i32 in Saturating, minute: i32 in Saturating);
    case Snooze(minutes: i32 in Saturating);
    case Cancel;
    case Trigger;
    case Dismiss;
}

data Main {
    fire_count: i32 in Saturating;
    pause: [u8; 256];
}

machine Main::dispatch(main: @mutable Main, event: AlarmEvent) {
    transition event {
        AlarmEvent::Set { hour, minute } -> do_set(hour, minute),
        AlarmEvent::Snooze { minutes } -> do_snooze(minutes),
        AlarmEvent::Cancel -> do_cancel(),
        AlarmEvent::Trigger -> do_trigger(main),
        AlarmEvent::Dismiss -> do_dismiss(),
        _ -> done()
    }

    machine do_set(hour: i32 in Saturating, minute: i32 in Saturating) {}
    machine do_snooze(minutes: i32 in Saturating) {}
    machine do_cancel() {}
    machine do_trigger(main: @mutable Main) { main.fire_count = main.fire_count + 1; }
    machine do_dismiss() {}
    machine done() {}
}

machine Main::main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("alarm_probe: no-payload case arm after payload arms -- Trigger must fire twice");
    Main::dispatch(main, AlarmEvent::Trigger);
    Main::dispatch(main, AlarmEvent::Trigger);

    transition main.fire_count == 2 {
        true -> good(main),
        _ -> bad(main)
    }
    machine good(main: @mutable Main) {
        |console|::Console::write_line("PASS: fire_count == 2 after two Trigger dispatches (exit 70)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause);
        |process_exit|::ProcessExit::exit_process(70);
    }
    machine bad(main: @mutable Main) {
        |console|::Console::write_line("FAIL: fire_count != 2 -- Trigger arm dropped or unreachable (exit 71)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause);
        |process_exit|::ProcessExit::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block Main::main(@mutable entry_storage);
}
