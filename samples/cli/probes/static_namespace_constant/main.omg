// A carrier namespace contributes no field bindings to a static
// machine: `Counter::constant`/`Counter::generic_constant` read the
// module-level `value`, not `counter.value`; `[copy]` bounds the type
// param of the static generic.
const value: i32 = 70;
data Counter { value: i32; marker: bool; }
machine marker() -> i32 { value }
machine Counter::constant() -> i32 {
    marker()
}
machine Counter::generic_constant<T [copy]>(argument: T) -> i32 {
    marker()
}
machine main() {
    let direct: i32 = Counter::constant();
    let specialized: i32 = Counter::generic_constant(true);
    let counter: Counter = Counter { value: 9 };
}
