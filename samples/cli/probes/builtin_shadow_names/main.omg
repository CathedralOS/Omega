// Authored machines spelled like compiler builtins
// (`clamp`, `max`) shadow them: a bare call selects the
// declaration in this module with its own arity,
// `requires` and result — where the builtins would need
// different operand counts.
//
//   * `clamp(3)` selects the one-arg authored machine
//     (result 4), not the three-operand builtin.
//   * `max(3)` selects the one-arg authored machine
//     (result 43), not the two-operand builtin.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine clamp(value: u32) -> u32
    requires value <= 4;
{
    value + 1
}

machine max(value: u32) -> u32
    requires value <= 4;
{
    value + 40
}

machine forward(value: u32) -> u32
    requires value <= 4;
{
    max(value)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let clamped: u32 = clamp(3);
    let maxed: u32 = forward(3);
    transition clamped == 4 && maxed == 43 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
