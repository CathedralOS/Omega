// Shared + mutable borrows of the SAME data type as sibling
// parameters: `strike(attacker: &Player, defender: &mut Player,
// damage)` — reads from the shared borrow and writes through the
// unique one.
//
//   * Field arithmetic mixes `attacker.armor` reads and
//     `defender.health` writes.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Player {
    health: i32 in Wrapping;
    armor: i32 in Wrapping;
}

machine Combat::strike(attacker: &Player, defender: &mut Player, damage: i32 in Wrapping) {
    defender.health = defender.health - damage + attacker.armor;
}

data Combat {}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let knight: Player = Player { health: 100, armor: 5 };
    let mut dummy: Player = Player { health: 100, armor: 0 };
    Combat::strike(&knight, &mut dummy, 30);
    transition dummy.health == 75 && knight.health == 100 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
