// Local-alias domain transfer: an entry-level `requires` on
// `main.player` transfers through `let mut copy: Player` — the
// local alias carries the `Alive` fact into `inspect`'s requires.
//
//   * `Main::main(main) requires main.player in Player::Alive` —
//     entry contract gating on a field domain.
//   * `let mut copy: Player = main.player` — the alias inherits
//     the membership; `Main::inspect(copy)` discharges.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
    hits: i32 in Wrapping;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.player.health = 3;
    let mut copy: Player = main.player;
    Main::inspect(copy);
    transition copy.health == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
