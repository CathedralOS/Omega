// A case payload carrying a predicate domain: `By(amount: i32 in
// NonZero)` — `NonZero` excludes one value from the middle of i32, so
// no bounded carrier could represent it. Construction proves `7 != 0`;
// the dispatched payload carries the membership into `490 / amount`,
// discharging the divisor obligation with no guard.
//
//   * `domain i32::NonZero(value) requires value != 0` — predicate
//     domain, not an interval.
//   * `Divisor::By { amount }` — record-name case-payload destructure.
//   * `hits == 1` proves the division ran on the dispatched payload.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain i32::NonZero(value) requires value != 0;

data Divisor {
    case Unset;
    case By(amount: i32 in NonZero);
}

data Main {
    divisor: Divisor;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.divisor = Divisor::By { amount: 7 };
    transition main.divisor {
        Divisor::By { amount } -> Main::quotient(main, 490 / amount)
        Divisor::Unset -> Main::wrong(main)
    }
    state quotient(main: &mut Main, value: i32) {
        main.hits = (value == 70) as i32 in Wrapping;
    }
    state wrong(main: &mut Main) { main.hits = -1; }
}
