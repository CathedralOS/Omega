// An empty named implementation receives a synthesized
// structural `equals`: `PointEquality satisfies
// Equatable<Point> { }` makes `==`/`!=` legal on Point
// values, comparing field by field, and
// `PointEquality::equals` selects the same row. An
// authored `equals` member overrides synthesis, so `==`
// then calls it.
//
//   * Synthesized: equal points match, a differing
//     middle field misses.
//   * Override: `equals` returning `false` — `==`
//     calls it and compares unequal on identical
//     values.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Point {
    x: i32;
    y: i32;
    z: i32;
}

PointEquality satisfies Equatable<Point> { }

data OverridePoint {
    value: i32;
}

OverrideEquality satisfies Equatable<OverridePoint> {
    machine equals(left: &OverridePoint, right: &OverridePoint) -> bool {
        false
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let a: Point = Point { x: 1, y: 2, z: 3 };
    let b: Point = Point { x: 1, y: 9, z: 3 };
    let same: Point = Point { x: 1, y: 2, z: 3 };
    let named: bool = PointEquality::equals(&a, &same);
    let over: OverridePoint = OverridePoint { value: 5 };
    let twin: OverridePoint = OverridePoint { value: 5 };
    let forced: bool = over == twin;
    transition a == same && a != b && named && forced == false {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
