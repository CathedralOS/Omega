// Ranged const parameters on data: `data Buffer<const Capacity:
// u64> where Capacity >= 1 && Capacity <= 64` — the where-gate
// constrains the const argument at each instantiation.
//
//   * `Buffer<2>` and `Buffer<64>` sized storage fields.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Buffer<const Capacity: u64> where Capacity >= 1 && Capacity <= 64 {
    items: [i32; Capacity];
}

data Main {
    small: Buffer<2>;
    large: Buffer<64>;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.small.items[1] = 30;
    main.large.items[63] = 40;
    transition main.small.items[0] == 0 && main.large.items[62] == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
