// Static setters and getters specialize a generic container's type
// parameter; the shared counter field keeps its own Wrapping domain.
//
//   * `data Cell<T> { value: T; touched: i32 in Wrapping }` — generic
//     payload + independent domain field.
//   * `machine Cell::set<T>` / `Cell::touch_count<T>` — unbounded
//     generic attached machines.
//   * `machine Cell::get<T [copy]>` — the getter alone needs a copy
//     bound: returning the field through a shared borrow copies it.
//     The container and setter carry no such bound.
//   * `transition { _ -> (cell.value) }` — bare arm returning a field.
//   * Two `Cell` instantiations (i32, bool) coexist; `hits` records
//     the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Cell<T> {
    value: T;
    touched: i32 in Wrapping;
}

machine Cell::set<T>(cell: &mut Cell<T>, v: T) {
    cell.value = v;
    cell.touched = cell.touched + 1;
}

machine Cell::get<T [copy]>(cell: &Cell<T>) -> T {
    transition { _ -> (cell.value) }
}

machine Cell::touch_count<T>(cell: &Cell<T>) -> i32 in Wrapping {
    transition { _ -> (cell.touched) }
}

data Main {
    integer_cell: Cell<i32>;
    boolean_cell: Cell<bool>;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    Cell::set(&mut main.integer_cell, 41);
    Cell::set(&mut main.integer_cell, 42);
    Cell::set(&mut main.boolean_cell, true);
    transition Cell::get(&main.integer_cell) == 42
        && Cell::get(&main.boolean_cell)
        && Cell::touch_count(&main.integer_cell) == 2 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
