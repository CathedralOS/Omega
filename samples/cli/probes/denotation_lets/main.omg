// Denotation lets: `public let` names a formula at module level —
// scalar value lets (`byte_mask`), predicate lets returning
// `core::Strict<0>` (`reflexive`, `wrapping_reflexive`),
// schema lets returning arrow types (`predicate`), and generic
// lets bounded by `core::Type<0>` (`identity`). `module lets;`
// declares the sibling file's module identity.
//
//   * `requires lets::reflexive(x)` on `check` — requires
//     discharges proposition facts like any contract (the lets
//     are proof-only: not callable as executable values, and a
//     requires quoting them needs the fact established).
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use lets;

machine check(x: u8) -> u8
{
    x
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition check(9) == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
