data Command { case None; case Move(dx: i32); }
CommandEquality satisfies Equatable<Command> { }
data Main { cmd: Command; }
machine Main::main(main: @mutable Main) {
    main.cmd = Command::Move { dx: 7 };
    let mutable hit: bool = main.cmd == Command::None;
    transition (main.cmd != Command::None) {
        (true) -> held(main, hit),
        _ -> swapped(main)
    }
    machine held(main: @mutable Main, was_none: bool) {
        main.cmd = Command::None;
        let now_none: bool = main.cmd == Command::None;
        let value: i32 = match now_none {
            (true) -> 10,
            _ -> 20
        } + match was_none {
            (true) -> 3,
            _ -> 4
        };
    }
    machine swapped(main: @mutable Main) { let value: i32 = 0; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
