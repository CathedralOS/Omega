// A `@mutable` machine argument rebinds through an unranked cycle's
// block-parameter channel, then re-borrows whole into a unit machine call.
data Sink { value: u64 in Wrapping; }
machine Sink::bump(sink: @mutable Sink) {
    sink.value = sink.value + 1 as u64 +Wrapping;
}
data Driver { ticks: u64 in Wrapping; }
machine Driver::drive(driver: @mutable Driver, sink: @mutable Sink, more: bool) {
    transition { _ -> go(driver, sink, more) }
    machine go(driver: @mutable Driver, sink: @mutable Sink, more: bool) {
        transition more {
            true -> step(driver, sink),
            false -> done(driver)
        }
    }
    machine step(driver: @mutable Driver, sink: @mutable Sink) {
        Sink::bump(sink);
        driver.ticks = driver.ticks + 1 as u64 +Wrapping;
        transition driver.ticks > 4 {
            true -> go(driver, sink, false),
            false -> go(driver, sink, true)
        }
    }
    machine done(driver: @mutable Driver) { }
}
data Main { driver: Driver; sink: Sink; }
machine Main::main(main: @mutable Main) {
    main.driver = Driver { ticks: 0 };
    main.sink = Sink { value: 0 };
    Driver::drive(@mutable main.driver, @mutable main.sink, true);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
