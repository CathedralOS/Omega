// A `&mut` machine argument rebinds through an unranked cycle's
// block-parameter channel, then re-borrows whole into a unit machine call.
data Sink { value: u64 in Wrapping; }
machine Sink::bump(sink: &mut Sink) {
    sink.value = sink.value + 1 as u64 in Wrapping;
}
data Driver { ticks: u64 in Wrapping; }
machine Driver::drive(driver: &mut Driver, sink: &mut Sink, more: bool) {
    transition { _ -> go(driver, sink, more) }
    state go(driver: &mut Driver, sink: &mut Sink, more: bool) {
        transition more {
            true -> step(driver, sink)
            false -> done(driver)
        }
    }
    state step(driver: &mut Driver, sink: &mut Sink) {
        Sink::bump(sink);
        driver.ticks = driver.ticks + 1 as u64 in Wrapping;
        transition driver.ticks > 4 {
            true -> go(driver, sink, false)
            false -> go(driver, sink, true)
        }
    }
    state done(driver: &mut Driver) { }
}
data Main { driver: Driver; sink: Sink; }
machine Main::main(main: &mut Main) {
    main.driver = Driver { ticks: 0 };
    main.sink = Sink { value: 0 };
    Driver::drive(&mut main.driver, &mut main.sink, true);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
