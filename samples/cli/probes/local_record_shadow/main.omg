// Local names shadow through record construction:
// `let value: u64 = MAX;` then `Counter { value: value }` — the
// field binds the LOCAL `value`, and `counter.value` reads it
// back through the record. Two `value`s, one spelling.
//
//   * `machine main() crashes Trap` + `crash Trap;` state —
//     crash route on the failure arm only.
//   * `hits`-style verdict via Trap vs. fallthrough (compile
//     surface only).
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Counter { value: u64; }

machine Counter::inspect() -> bool {
    let value: u64 = 18446744073709551615;
    let counter: Counter = Counter { value: value };
    let observed: u64 = counter.value as u64;
    value == 18446744073709551615u64 && observed == value
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    let correct: bool = Counter::inspect();
    transition correct {
        true -> passed(main)
        false -> failed(main)
    }
    state passed(main: &mut Main) { main.hits = 1; }
    state failed(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
