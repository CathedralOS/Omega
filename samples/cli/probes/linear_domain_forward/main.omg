// A `Region in Owned` passes through a forwarding machine and back
// out as the declared owned result — linear data plus a marker
// domain survive the hop, including past an unused local and a
// dropped scratch value.
use omega::language::core::drop;
data ByteUnit {}
data CountedQuantity<Unit> {
    magnitude: u64;
}
trait Content<Owner, A> {
    machine project(subject: &Owner) -> A;
}
data Region [linear] {
    length: u64;
}
machine Region::drop(region: &mut Region) { }
data Scratch {
    marker: u64;
}
data EmptyScratch {}
domain Region::Owned;
machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
requires region in Owned
{
    CountedQuantity { magnitude: region.length }
}
machine forward(region: Region in Owned) -> Region in Owned {
    let scratch: Scratch = Scratch { marker: 0 };
    region
}
data Main {}
machine Main::main(main: &mut Main) {
    let region: Region in Owned = Region { length: 3 };
    let kept: Region in Owned = forward(region);
    consume(kept);
}
machine consume(region: Region in Owned) { drop(region); }

