// Rank-range termination measures across a two-machine descent
// cycle: `terminates by remaining in 0..=9` bounds the rank, and the
// matching `requires remaining <= 9` roster brings the bound into the
// body. A subordinate state may issue the cycle's component call —
// `hold -> step(pending)` is a weak edge (rank unchanged), and the
// strict `step -> count(n - 1)` edge completes every cycle's descent.
//
//   * `Main::count` and `Main::step` both carry `terminates by ...
//     in 0..=9` rank ranges + `requires` bounds.
//   * `state hold(...) requires pending <= 9` — a state's own
//     requires roster participates in the cycle.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine Main::count(main: &mut Main, remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition remaining > 0 {
        true -> hold(main, remaining)
        false -> remaining
    }
    state hold(main: &mut Main, pending: u32)
    requires pending <= 9
    {
        transition pending > 0 {
            true -> Main::step(main, pending)
            false -> pending
        }
    }
}

machine Main::step(main: &mut Main, n: u32)
terminates by n in 0..=9;
-> u32
requires n <= 9
{
    transition n > 0 {
        true -> Main::count(main, n - 1)
        false -> n
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition Main::count(main, 5) == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
