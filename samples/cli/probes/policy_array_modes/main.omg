// Policy arrays: `modes: [Mode; 4] in Trapping` — a collection's
// domain policy governs indexing (Trapping index arithmetic), and
// the structural enum element keeps its type through dispatch.
//
//   * `machine main() crashes Trap` — free entry spelling with a
//     crash route; `let mut table: Table;` deferred init.
//   * `Table::weigh(table, index) -> u64 crashes Trap` — guards the
//     index against `table.count` before element dispatch;
//     out-of-range falls to `absent`.
//   * `Table::weigh(&main.table, 1) as u64` — `as` cast on a call.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Mode [copy] {
    case Idle;
    case Busy;
}

data Table
where
    count <= 4,
{
    modes: [Mode; 4] in Trapping;
    count: u64;
}

machine Table::weigh(table: &Table, index: u64 in Trapping) -> u64
crashes Trap
{
    transition index < table.count {
        true -> classify(table, index)
        _ -> absent()
    }
    machine classify(table: &Table, index: u64 in Trapping) -> u64 {
        transition table.modes[index] {
            Mode::Idle -> idle()
            Mode::Busy -> occupied()
        }
    }
    machine idle() -> u64 { 1 }
    machine occupied() -> u64 { 2 }
    machine absent() -> u64 { 0 }
}

data Main {
    table: Table;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.table.count = 3;
    main.table.modes[1] = Mode::Busy;
    let busy: u64 = Table::weigh(&main.table, 1) as u64;
    let idle: u64 = Table::weigh(&main.table, 2) as u64;
    let absent: u64 = Table::weigh(&main.table, 3) as u64;
    transition busy == 2 && idle == 1 && absent == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
