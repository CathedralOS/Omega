// Expected exit: 0.
// Fill a record's buffer and a directly borrowed array with ranked recursion.
// Writing elements changes their contents, never either buffer's extent.
data Cells { bytes: [u8; 8]; }

machine fill_field(cells: @mutable Cells, position: u64) -> u64
terminates by position -> Nat::IncreasingTo(cells.bytes.length)
requires position < cells.bytes.length
{
    cells.bytes[position] = 7;
    transition position + 1 < cells.bytes.length {
        true -> fill_field(cells, position + 1),
        _ -> (position + 1)
    }
}

machine fill_array(bytes: @mutable [u8; 4], position: u64) -> u64
terminates by (position, bytes.length) -> Nat::BoundedDistance
requires position < bytes.length
{
    bytes[position] = 5;
    transition position + 1 < bytes.length {
        true -> fill_array(bytes, position + 1),
        _ -> (position + 1)
    }
}

machine main() crashes Trap {
    let mutable cells: Cells;
    let mutable bytes: [u8; 4];
    let field_count: u64 = fill_field(@mutable cells, 0);
    let array_count: u64 = fill_array(@mutable bytes, 0);
    let array_filled: bool = bytes[0] == 5 && bytes[3] == 5;
    let slice_count: u64 = fill_slice(@mutable bytes[..], 0);
    transition field_count == 8 && cells.bytes[0] == 7 && cells.bytes[7] == 7
        && array_count == 4 && array_filled && slice_count == 4 && bytes[0] == 3 && bytes[3] == 3 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine fill_slice(bytes: @mutable [u8], position: u64) -> u64
terminates by (position, bytes.length) -> Nat::BoundedDistance in 0..=bytes.length
requires position < bytes.length
{
    bytes[position] = 3;
    transition position + 1 < bytes.length {
        true -> fill_slice(bytes, position + 1),
        _ -> (position + 1)
    }
}
