// A qualified three-byte fixed array keeps its exact extent across states.
// `main.label = "abc"` replaces all three bytes; `main.label[0] = 66`
// preserves UTF-8 membership. Qualification adds no storage or live length.
//
//   * `domain [u8; 3]::Utf8(bytes) requires valid_utf8(bytes)` —
//     compiler-recognized predicate on the array carrier.
//   * Whole-replacement and indexed store both keep the domain.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    label: [u8; 3] in Utf8;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition { _ -> fill(main) }
    machine fill(main: &mut Main) {
        main.label = "abc";
        transition { _ -> stamp(main) }
    }
    machine stamp(main: &mut Main) {
        main.label[0] = 66;
        transition { _ -> read(main) }
    }
    machine read(main: &mut Main) {
        transition main.label.len == 3 && main.label[0] == 66
            && main.label[1] == 98 && main.label[2] == 99 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
