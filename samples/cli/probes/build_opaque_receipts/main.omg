// Two opaque carriers, satisfies declarations in reverse order across
// sibling modules. `entry` moves both carriers through relay machines so
// the representation admittance of each is exercised, not just declared.

use token;
use seal;

data Main {
    held: Token;
    sealed: Seal;
    hits: i32 in Wrapping;
}

machine Main::relay(input: Token) -> Token {
    input
}

machine Main::reseal(input: Seal) -> Seal {
    input
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let token_value: Token;
    main.held = Main::relay(token_value);
    let seal_value: Seal;
    main.sealed = Main::reseal(seal_value);
    main.hits = 1;
}
