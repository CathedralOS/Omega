// Inside a transition arm, the bound payload can be
// borrowed and forwarded into another machine's `&`
// parameter: `Payload::read_at(&p, position)` reads the
// arm-bound `p` without moving it.
//
//   * `Sum::Found { p } -> (Payload::read_at(&p,
//     position))` — `&p` borrows the destructured
//     payload inside the arm result.
//   * Nested sums: the inner `Payload` has its own
//     `transition payload` dispatching Leaf/Empty.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Payload {
    case Leaf(value: u64);
    case Empty;
}

machine Payload::read_at(payload: &Payload, at: u64) -> u64 {
    transition payload {
        Payload::Leaf { value } -> (value)
        Payload::Empty -> (at)
    }
}

data Sum {
    case Found(p: Payload);
    case Missing;
}

machine Sum::probe(sum: &Sum, position: u64) -> u64 {
    transition sum {
        Sum::Found { p } -> (Payload::read_at(&p, position))
        Sum::Missing -> (0)
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let leaf_read: u64 = Sum::probe(&Sum::Found { p: Payload::Leaf { value: 41 } }, 9);
    let empty_read: u64 = Sum::probe(&Sum::Found { p: Payload::Empty }, 9);
    let missing: u64 = Sum::probe(&Sum::Missing, 9);
    transition leaf_read == 41 && empty_read == 9 && missing == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
