use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "progress_provider" };
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::Scheduler, |app|::SchedulerProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
}
