// Progress-qualified providers: `domain
// SchedulerHandle::WeakFair satisfies ProgressProfile
// established by Scheduler::grant` — the trait's `grant`
// issues WeakFair-qualified handles, the entry machine
// publishes `requires main.scheduler in
// SchedulerHandle::WeakFair`, and per-target satisfies
// impls pick `ForeignBinding::Syscall` /
// `VtableField` backing.
//
//   * `Scheduler::notify` is the requirement application;
//     there is no carrier field, and no `binding` import.
//   * `domain ... satisfies ProgressProfile` — domain
//     declared as a progress profile.
//   * `Build::select_provider<Scheduler,
//     SchedulerProvider>` in build.omg.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

public data SchedulerHandle [copy] { identity: u64; }

public domain SchedulerHandle::WeakFair
satisfies ProgressProfile
established by Scheduler::grant;

public boundary trait Scheduler {
    machine notify(provider: &SchedulerProvider, value: i32)
    reaches
    terminates;

    machine grant(provider: &SchedulerProvider, handle: SchedulerHandle) -> SchedulerHandle in WeakFair reaches;
}

public data SchedulerProvider { grant: addr; notify: addr; }

linux_x86_64 machine SchedulerProvider::notify(provider: &SchedulerProvider, value: i32)
satisfies Scheduler::notify
via ForeignBinding::Syscall(1);

linux_arm64 machine SchedulerProvider::notify(provider: &SchedulerProvider, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

macos_arm64 machine SchedulerProvider::notify(provider: &SchedulerProvider, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

macos_x86_64 machine SchedulerProvider::notify(provider: &SchedulerProvider, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

windows_x86_64 machine SchedulerProvider::notify(provider: &SchedulerProvider, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

machine SchedulerProvider::grant(provider: &SchedulerProvider, handle: SchedulerHandle) -> SchedulerHandle in WeakFair
satisfies Scheduler::grant
via ForeignBinding::VtableField(grant);

data Main {
    provider: SchedulerProvider;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main)
reaches Scheduler
terminates;
{
    main.hits = 1;
    Scheduler::notify(&main.provider, 65);
}
