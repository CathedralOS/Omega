// Whole-owner extraction through `&mut`: `repair(&mut
// Inventory)` lifts the whole linear owner out of its place,
// feeds it through a conditional transform that may drop and
// rebuild, then stores the result back. The place is empty for
// exactly the transform's duration.
//
//   * `let removed: Inventory = inventory;` — affine take
//     through a `&mut` borrow.
//   * Conditional state machine rebuilds or preserves.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Inventory [linear] { slots: i32; }
machine Inventory::drop(inventory: &mut Inventory) {}

machine transform(inventory: Inventory) -> Inventory {
    transition inventory.slots == 41 {
        true -> increment(inventory)
        false -> preserve(inventory)
    }
    state increment(inventory: Inventory) -> Inventory {
        let slots: i32 = inventory.slots;
        drop(inventory);
        Inventory { slots: ((slots as i32 in Wrapping) + 1) as i32 }
    }
    state preserve(inventory: Inventory) -> Inventory { inventory }
}

machine repair(inventory: &mut Inventory) -> i32 {
    let removed: Inventory = inventory;
    inventory = transform(removed);
    inventory.slots
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut stock: Inventory = Inventory { slots: 41 };
    let observed: i32 = repair(&mut stock);
    let outcome: bool = observed == 42 && stock.slots == 42;
    drop(stock);
    transition outcome {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
