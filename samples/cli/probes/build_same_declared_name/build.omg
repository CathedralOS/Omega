// Two DIFFERENT source directories may declare the same package name:
// declared names are diagnostic identity, not uniqueness-keyed, and
// the alias is what selects each occurrence. Both declarations land
// as distinct dependency occurrences.

machine build(builder: &mut Build) {
    Build::application(builder, "build_same_declared_name");
    let mut k1_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dep_one" });
    dependency::with_alias(&mut k1_dependency, "k1");
    let k1_registration: DependencyRegistration = Build::dependency(builder, k1_dependency);
    let mut k2_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dep_two" });
    dependency::with_alias(&mut k2_dependency, "k2");
    let k2_registration: DependencyRegistration = Build::dependency(builder, k2_dependency);
    builder.freestanding = true;
}
