// Prover-backed construction: the machine's `requires 1 <=
// strength, strength <= 100` interval DECIDES the data's
// gate `health >= 1` — `Player { health: strength }`
// constructs from a runtime parameter with no spelled
// proof at the construction.
//
//   * `data Player where health >= 1,` gated record.
//   * `Main::recruit(strength) requires 1 <= strength,
//     strength <= 100`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Player
where
    health >= 1,
{
    health: i32;
}

data Main { hits: i32 in Wrapping; }

machine Main::recruit(strength: i32) -> i32
requires 1 <= strength, strength <= 100
{
    let champion: Player = Player { health: strength };
    champion.health
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let power: i32 = Main::recruit(50);
    transition power == 50 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
