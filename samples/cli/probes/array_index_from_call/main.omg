// Array lookup driven by a value-returning call result.
//
// FRESH COMBINATION: call a value-returning machine to get an index,
// then dispatch on that index to read a fixed-array slot at a const index.
// The key novelty: the INDEX comes from a value-call return value, not a
// literal -- testing that the call result correctly feeds the dispatch.
//
// Data:
//   table: [i32; 5] = [3, 7, 14, 30, 60]
//   pick(key) -> i32 : returns an index
//     key 0 -> 0 (table[0] = 3)
//     key 1 -> 2 (table[2] = 14)
//     key 2 -> 4 (table[4] = 60)
//
// Computation:
//   idx0 = pick(0) = 0   -> read_at(0) = 3   -> v0 = 3
//   idx1 = pick(1) = 2   -> read_at(2) = 14  -> v1 = 14
//   idx2 = pick(2) = 4   -> read_at(4) = 60  -> v2 = 60
//   result = v2 + v1 - v0 - 1 = 60 + 14 - 3 - 1 = 70
//
// Exit 71 = idx0 wrong, 72 = idx2 wrong, 73 = v0 wrong, 74 = result wrong.
//
// Expected exit: 70.

use omega_language_std::console;

data Picker {}

data Main {
    console: Console;
    table: [i32; 5];
    picker: Picker;
    pause: [u8; 256];
}

// Returns an array index for a given key (0->0, 1->2, 2->4).
machine Picker::pick(&mut self, key: i32) -> i32 {
    transition key == 0 {
        true -> (0)
        _ -> try1(key)
    }

    state try1(&mut self, key: i32) {
        transition key == 1 {
            true -> (2)
            _ -> (4)
        }
    }
}

// Read a table entry at index idx using const dispatch.
// idx must be 0..4.
machine Main::read_at(&mut self, idx: i32) -> i32 {
    transition idx == 0 {
        true -> (self.table[0])
        _ -> try1(idx)
    }

    state try1(&mut self, idx: i32) {
        transition idx == 1 {
            true -> (self.table[1])
            _ -> try2(idx)
        }
    }

    state try2(&mut self, idx: i32) {
        transition idx == 2 {
            true -> (self.table[2])
            _ -> try3(idx)
        }
    }

    state try3(&mut self, idx: i32) {
        transition idx == 3 {
            true -> (self.table[3])
            _ -> (self.table[4])
        }
    }
}

machine Main::main(&mut self) {
    self.console.write_line("array_index_from_call: value-call results drive array-index dispatch (pick -> read_at chains)");
    // Initialize the lookup table.
    self.table[0] = 3;
    self.table[1] = 7;
    self.table[2] = 14;
    self.table[3] = 30;
    self.table[4] = 60;

    // Call pick() to get indices, then read_at() to look up values.
    // Both picks chain: call result drives the dispatch in read_at.
    let idx0: i32 = self.picker.pick(0);
    let v0: i32 = self.read_at(idx0);

    let idx2: i32 = self.picker.pick(2);
    let v2: i32 = self.read_at(idx2);

    let idx1: i32 = self.picker.pick(1);
    let v1: i32 = self.read_at(idx1);

    // Verify idx0 == 0.
    transition idx0 == 0 {
        true -> check_idx2()
        _ -> bad_idx0()
    }

    state bad_idx0(&mut self) {
        self.console.write_line("FAIL: pick(0) returned wrong index -- expected 0 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state check_idx2(&mut self) {
        transition idx2 == 4 {
            true -> check_v0()
            _ -> bad_idx2()
        }
    }

    state bad_idx2(&mut self) {
        self.console.write_line("FAIL: pick(2) returned wrong index -- expected 4 (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state check_v0(&mut self) {
        transition v0 == 3 {
            true -> compute_result()
            _ -> bad_v0()
        }
    }

    state bad_v0(&mut self) {
        self.console.write_line("FAIL: read_at(idx0) returned wrong value -- expected table[0] == 3 (exit 73)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }

    state compute_result(&mut self) {
        // result = v2 + v1 - v0 - 1 = 60 + 14 - 3 - 1 = 70.
        let result: i32 = v2 + v1 - v0 - 1;
        transition result == 70 {
            true -> good()
            _ -> bad_result()
        }
    }

    state bad_result(&mut self) {
        self.console.write_line("FAIL: v2 + v1 - v0 - 1 != 70 -- lookup arithmetic wrong (exit 74)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(74);
    }

    state good(&mut self) {
        self.console.write_line("PASS: 60 + 14 - 3 - 1 == 70 from call-driven lookups (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
}
