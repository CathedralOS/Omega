// Array lookup driven by a value-returning call result.
//
// FRESH COMBINATION: call a value-returning machine to get an index,
// then dispatch on that index to read a fixed-array slot at a const index.
// The key novelty: the INDEX comes from a value-call return value, not a
// literal -- testing that the call result correctly feeds the dispatch.
//
// Data:
//   table: [i32; 5] = [3, 7, 14, 30, 60]
//   pick(key) -> i32 : returns an index
//     key 0 -> 0 (table[0] = 3)
//     key 1 -> 2 (table[2] = 14)
//     key 2 -> 4 (table[4] = 60)
//
// Computation:
//   idx0 = pick(0) = 0   -> read_at(0) = 3   -> v0 = 3
//   idx1 = pick(1) = 2   -> read_at(2) = 14  -> v1 = 14
//   idx2 = pick(2) = 4   -> read_at(4) = 60  -> v2 = 60
//   result = v2 + v1 - v0 - 1 = 60 + 14 - 3 - 1 = 70
//
// Exit 71 = idx0 wrong, 72 = idx2 wrong, 73 = v0 wrong, 74 = result wrong.
//
// Expected exit: 70.

use omega_language_std::console;

data Picker {}

data Main {
    table: [i32; 5];
    picker: Picker;
    pause: [u8; 256];
}

// Returns an array index for a given key (0->0, 1->2, 2->4).
machine Picker::pick(picker: &mut Picker, key: i32) -> i32 {
    transition key == 0 {
        true -> (0)
        _ -> try1(key)
    }

    state try1(key: i32) {
        transition key == 1 {
            true -> (2)
            _ -> (4)
        }
    }
}

// Read a table entry at index idx using const dispatch.
// idx must be 0..4.
machine Main::read_at(main: &mut Main, idx: i32) -> i32 {
    transition idx == 0 {
        true -> (main.table[0])
        _ -> try1(main, idx)
    }

    state try1(main: &mut Main, idx: i32) {
        transition idx == 1 {
            true -> (main.table[1])
            _ -> try2(main, idx)
        }
    }

    state try2(main: &mut Main, idx: i32) {
        transition idx == 2 {
            true -> (main.table[2])
            _ -> try3(main, idx)
        }
    }

    state try3(main: &mut Main, idx: i32) {
        transition idx == 3 {
            true -> (main.table[3])
            _ -> (main.table[4])
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("array_index_from_call: value-call results drive array-index dispatch (pick -> read_at chains)");
    // Initialize the lookup table.
    main.table[0] = 3;
    main.table[1] = 7;
    main.table[2] = 14;
    main.table[3] = 30;
    main.table[4] = 60;

    // Call pick() to get indices, then read_at() to look up values.
    // Both picks chain: call result drives the dispatch in read_at.
    let idx0: i32 = Picker::pick(&mut main.picker, 0);
    let v0: i32 = Main::read_at(main, idx0);

    let idx2: i32 = Picker::pick(&mut main.picker, 2);
    let v2: i32 = Main::read_at(main, idx2);

    let idx1: i32 = Picker::pick(&mut main.picker, 1);
    let v1: i32 = Main::read_at(main, idx1);

    // Verify idx0 == 0.
    transition idx0 == 0 {
        true -> check_idx2(main, idx2, v0, v2, v1)
        _ -> bad_idx0(main)
    }

    state bad_idx0(main: &mut Main) {
        Console::write_line("FAIL: pick(0) returned wrong index -- expected 0 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_idx2(main: &mut Main, idx2: i32, v0: i32, v2: i32, v1: i32) {
        transition idx2 == 4 {
            true -> check_v0(main, v0, v2, v1)
            _ -> bad_idx2(main)
        }
    }

    state bad_idx2(main: &mut Main) {
        Console::write_line("FAIL: pick(2) returned wrong index -- expected 4 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state check_v0(main: &mut Main, v0: i32, v2: i32, v1: i32) {
        transition v0 == 3 {
            true -> compute_result(main, v0, v2, v1)
            _ -> bad_v0(main)
        }
    }

    state bad_v0(main: &mut Main) {
        Console::write_line("FAIL: read_at(idx0) returned wrong value -- expected table[0] == 3 (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state compute_result(main: &mut Main, v0: i32, v2: i32, v1: i32) {
        // result = v2 + v1 - v0 - 1 = 60 + 14 - 3 - 1 = 70.
        // i64 operands: call results carry no range facts, so exact i32
        // arithmetic cannot be proven against overflow; widened operands
        // keep every intermediate result inside i64.
        let result: i64 = (v2 as i64) + (v1 as i64) - (v0 as i64) - 1;
        transition result == 70 {
            true -> good(main)
            _ -> bad_result(main)
        }
    }

    state bad_result(main: &mut Main) {
        Console::write_line("FAIL: v2 + v1 - v0 - 1 != 70 -- lookup arithmetic wrong (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: 60 + 14 - 3 - 1 == 70 from call-driven lookups (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
