// Domain-pattern dispatch and stacked domain refinement — the first
// sample where transition arms match on domain membership rather than
// data shape, plus a scalar interval domain on a record field.
//
//   * `Player::Alive`/`Player::Dead` refine `Player::Valid` — a domain
//     `requires` may itself be a domain membership (`in Player::Valid`).
//   * `transition main.player { Player::Alive -> ... }` — each arm
//     tests domain membership in order; `_` closes the dispatch.
//   * `domain i32::Ten` bounds a scalar by interval; `level: i32 in Ten`
//     is a record field whose literal construction proves the range.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain i32::Ten(value)
requires
    0 <= value && value <= 10;

data Gauge {
    level: i32 in Ten;
}

data Player {
    health: i32;
}

domain Player::Valid(player)
requires
    player.health >= 0;

domain Player::Alive(player)
requires
    player in Player::Valid;
    player.health > 0;

domain Player::Dead(player)
requires
    player in Player::Valid;
    player.health == 0;

data Main {
    player: Player;
    gauge: Gauge;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.player = Player { health: 5 };
    main.gauge = Gauge { level: 7 };
    transition main.player {
        Player::Alive -> Main::alive(main)
        Player::Dead -> Main::dead(main)
        _ -> Main::other(main)
    }
    // Gauge literals grant i32::Ten at construction (7 <= 10);
    // refusing 11 here is the negative twin of this probe.
    main.hits = main.hits + (main.gauge.level as i32 in Wrapping);
}

machine Main::alive(main: &mut Main) {
    main.hits = 1;
}

machine Main::dead(main: &mut Main) {
    main.hits = 2;
}

machine Main::other(main: &mut Main) {
    main.hits = 3;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
