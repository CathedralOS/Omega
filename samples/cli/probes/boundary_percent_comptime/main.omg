// A declared range endpoint whose const machine invokes a
// selected boundary machine runs the provider's ordinary
// checked body during const evaluation — `Provider::remainder`
// computes `left | right` = 7 where a builtin `%` would fold
// 1, so `take_bounded(7)` only checks when the provider body
// actually ran.
//
//   * `boundary machine % Math::remainder` — the operator
//     surface is boundary-declared.
//   * `satisfies Math::remainder` provider impl.
//   * `requires value <= bounded(256)` — range endpoint is a machine
//     call evaluated at check time.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Math {}

boundary machine % Math::remainder(left: u64, right: u64) -> u64;

data Provider {}

machine Provider::remainder(left: u64, right: u64) -> u64
satisfies Math::remainder
{
    transition { _ -> (left | right) }
}

machine bounded(value: u64) -> u64
requires value <= 512
{
    transition { _ -> (value) }
}

machine take_bounded(value: u64) -> u64
requires value <= bounded(256)
{ value }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let kept: u64 = take_bounded(7);
    transition kept == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
