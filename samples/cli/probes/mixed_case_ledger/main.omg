// mixed_case_ledger: mixed-shape case data and let-position record
// patterns as sample code — the first sample with common fields beside
// payload cases, and the first `let { ... as ... }` destructure.
//
//   * `Event` names common fields (`consumed`, `bonus`) beside payload
//     cases: `Event::Treasure { gold, consumed }` sets one common field
//     explicitly; `bonus` reads its unnamed-field default, zero — checked
//     from the `check_default` state's own parameter.
//   * `Point` is gated (x, y, z each 0..=100); `let { x, y as vertical,
//     z as _ }` destructures exhaustively with `as` renames and a waived
//     field — no case, so the pattern is total by law.
//
// The machine stores a Treasure event, checks the default common field,
// destructures a 30/40/5 point, and accepts on 30 + 40 == 70.
// Compile-checked only: no standard-library dependency.
data Event {
    consumed: bool;
    bonus: i32;
    case Nothing;
    case Treasure(gold: i32);
}

data Point
where
    0 <= x,
    x <= 100,
    0 <= y,
    y <= 100,
    0 <= z,
    z <= 100,
{
    x: i32;
    y: i32;
    z: i32;
}

machine mixed_case_ledger() {
    let event: Event = Event::Treasure { gold: 50, consumed: true };
    transition event.consumed {
        true -> check_default(event)
        _ -> done(71)
    }

    machine check_default(event: Event) {
        transition event.bonus == 0 {
            true -> destructure()
            _ -> done(72)
        }
    }

    machine destructure() {
        let point: Point = Point { x: 30, y: 40, z: 5 };
        let { x, y as vertical, z as _ } = point;
        transition x + vertical == 70 {
            true -> done(70)
            _ -> done(73)
        }
    }

    machine done(code: i32) {}
}
