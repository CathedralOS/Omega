// `established by` provenance on domains: `File::Writable` names
// the boundary machine that grants it (`Filesystem::open`);
// `Folder::Writable` names TWO establishers across trait and
// provider machines. The domain is ungrantable by ordinary code —
// only the named boundary routes mint it.
//
//   * `established by A::m, B::m` multi-route rosters.
//   * `pub boundary trait` + `pub data` + `pub domain` trio.
//
// Compile-checked only: declaration surface, no standard-library
// dependency.


pub domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);

pub data Folder {
}

pub data File {
}

pub domain File::Writable
established by Filesystem::open;

pub boundary trait Filesystem {
    machine open(folder: Folder, path: &[u8] in Utf8) -> File
    ensures
        result in File::Writable
    reaches
        Filesystem;
}

pub domain Folder::Writable
established by Desktop::choose_folder, DesktopProvider::choose_folder;

pub boundary trait Desktop {
    machine choose_folder(prompt: &[u8] in Utf8) -> Folder
    ensures
        result in Folder::Writable
    reaches
        Desktop;
}

data DesktopProvider {
}

machine DesktopProvider::choose_folder(prompt: &[u8] in Utf8) -> Folder
satisfies Desktop::choose_folder
ensures
    result in Folder::Writable
{
    Folder {}
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}
