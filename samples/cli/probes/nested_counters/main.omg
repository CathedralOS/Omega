// Nested data: a struct field that is itself a struct, with field updates
// through an explicit `&mut` subject across multiple sub-machine calls.
//
// Exercises: deep nested field access (main.state.inner.value), mutation of
// nested struct fields via separate sub-machines, and guards reading nested
// fields after multiple rounds of mutation.
//
// Data layout:
//   Inner [copy] { value: i32; bonus: i32; }
//   Outer [copy] { inner: Inner; count: i32; multiplier: i32; }
//   Main  { state: Outer; }
//
// Final state: value 40, bonus 20, count 2, multiplier 5.
// The result is 40 + 20 + 2 * 5 = 70. Distinct failures report incorrect
// value (71), bonus (72), count (73), result (74), or multiplier (75).
//
// Expected exit: 70.

use omega_language_std::console;

// The data predicates retain the original field bounds across construction
// and mutable sub-machine calls. Equality guards make the final exact sum
// observable; they do not establish the standing data invariants.
data Inner [copy]
requires value >= 0 && value <= 1000 && bonus >= 0 && bonus <= 1000
{
    value: i32;
    bonus: i32;
}

data Outer [copy]
requires count >= 0 && count <= 100 && multiplier >= 0 && multiplier <= 100
{
    inner: Inner;
    count: i32;
    multiplier: i32;
}

data Main {
    state: Outer;
    pause: [u8; 256];
}

machine Main::set_value(main: &mut Main, v: i32)
requires
    v >= 0 && v <= 1000
{
    main.state.inner.value = v;
}

machine Main::set_bonus(main: &mut Main, b: i32)
requires
    b >= 0 && b <= 1000
{
    main.state.inner.bonus = b;
}

// The MODULAR-COUNTER idiom -- the Exact-provable bounded counter: reducing
// the read `% 101` bounds it to [-100..=100], so `+ 1` stays within i32, and
// the outer `% 101` wraps to 0 at 101 exactly as before for a count in
// 0..=100. The boundary behavior is declared IN the arithmetic, not silently
// assumed -- nothing here can overflow, so no overflow domain is needed.
machine Main::increment_count(main: &mut Main) {
    main.state.count = (main.state.count % 101 + 1) % 101;
}

machine Main::set_multiplier(main: &mut Main, m: i32)
requires
    m >= 0 && m <= 100
{
    main.state.multiplier = m;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("nested_counters: mutating struct-in-struct fields across sub-machine calls");
    Main::set_value(main, 10);
    Main::set_bonus(main, 20);
    Main::increment_count(main);
    Main::set_multiplier(main, 5);
    Main::set_value(main, 40);
    Main::increment_count(main);

    // Verify nested field main.state.inner.value == 40.
    transition main.state.inner.value == 40 {
        true -> block check_bonus(main)
        _ -> block bad_value(main)
    }

    machine bad_value(main: &mut Main) {
        Console::write_line("FAIL: wrong nested value field (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    machine check_bonus(main: &mut Main) {
        transition main.state.inner.bonus == 20 {
            true -> block check_count(main)
            _ -> block bad_bonus(main)
        }
    }

    machine bad_bonus(main: &mut Main) {
        Console::write_line("FAIL: wrong nested bonus field (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    machine check_count(main: &mut Main) {
        transition main.state.count == 2 {
            true -> block check_multiplier(main)
            _ -> block bad_count(main)
        }
    }

    machine bad_count(main: &mut Main) {
        Console::write_line("FAIL: wrong counter value (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    machine check_multiplier(main: &mut Main) {
        transition main.state.multiplier == 5 {
            true -> block compute_result(main)
            _ -> block bad_multiplier(main)
        }
    }

    machine bad_multiplier(main: &mut Main) {
        Console::write_line("FAIL: wrong nested multiplier field (exit 75)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(75);
    }

    machine compute_result(main: &mut Main) {
        // result = inner.value + inner.bonus + count * multiplier
        //        = 40 + 20 + 2 * 5 = 70
        let result: i32 = main.state.inner.value + main.state.inner.bonus
                        + main.state.count * main.state.multiplier;
        transition result == 70 {
            true -> block good(main)
            _ -> block bad_result(main)
        }
    }

    machine bad_result(main: &mut Main) {
        Console::write_line("FAIL: wrong combined result (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    machine good(main: &mut Main) {
        Console::write_line("PASS: 40 + 20 + 2*5 = 70 from nested fields (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
