// Nested data: a struct field that is itself a struct, with field updates
// through &mut self across multiple sub-machine calls.
//
// Exercises: deep nested field access (self.state.inner.value), mutation of
// nested struct fields via separate sub-machines, and guards reading nested
// fields after multiple rounds of mutation.
//
// Data layout:
//   Inner [copy] { value: i32; bonus: i32; }
//   Outer [copy] { inner: Inner; count: i32; multiplier: i32; }
//   Main  { console: Binding<Console>; state: Outer; }
//
// Scripted operations (via sub-machines):
//   1. set_value(10)    -> state.inner.value = 10
//   2. set_bonus(5)     -> state.inner.bonus = 5
//   3. increment_count()-> state.count = 1
//   4. set_multiplier(3)-> state.multiplier = 3
//   5. increment_count()-> state.count = 2
//   6. set_value(20)    -> state.inner.value = 20
//   7. increment_count()-> state.count = 3
//
// Final verification:
//   result = (state.inner.value + state.inner.bonus) * state.multiplier
//          = (20 + 5) * 3 = 75
//   75 - state.count * 5 = 75 - 15 = 60
//   60 + state.count * (state.count + 1) / 2
//     = 60 + 3 * 4 / 2 = 60 + 6 = 66  ... wrong approach
//
// Simpler: let total = state.inner.value + state.inner.bonus = 25
//          let weighted = total * state.count = 25 * 3 = 75
//          75 - state.multiplier * state.count = 75 - 3*3 = 66 ... still off
//
// Use direct: (state.inner.value * 2) + state.inner.bonus + state.count
//   = 20*2 + 5 + 3 = 40 + 5 + 3 = 48 ... off
//
// Let's just compute: result = state.inner.value + state.inner.bonus
//                             + state.count * state.multiplier
//   = 20 + 5 + 3 * 3 = 20 + 5 + 9 = 34 -- not 70
//
// Adjust dataset to hit 70:
//   state.inner.value = 40, state.inner.bonus = 20,
//   state.count = 2, state.multiplier = 5
//   result = 40 + 20 + 2 * 5 = 60 + 10 = 70. Good!
//
// Scripted (revised):
//   set_value(10)     -> inner.value = 10
//   set_bonus(20)     -> inner.bonus = 20
//   increment_count() -> count = 1
//   set_multiplier(5) -> multiplier = 5
//   set_value(40)     -> inner.value = 40
//   increment_count() -> count = 2
//
// Final: inner.value + inner.bonus + count * multiplier = 40+20+2*5 = 70.
// Exit 71 = wrong value field, 72 = wrong bonus field, 73 = wrong count,
//           74 = wrong result, 75 = wrong multiplier field.
//
// Expected exit: 70.

use omega_language_std::console;
use omega::language::core::binding;

// FULLY EXACT -- no overflow domain anywhere: the verification ladder pins
// value, bonus, count and multiplier with `==` guards before the final
// `value + bonus + count * multiplier` runs, so that sum is verifiably
// bounded, and the counter increment is a modular counter reduced before its
// `+ 1`. The setters' `requires` contracts keep each caller within the
// intended 0..=1000 / 0..=100 bounds. When arithmetic is verifiably bounded,
// no domain is needed -- the avionics posture.
data Inner [copy] {
    value: i32;
    bonus: i32;
}

data Outer [copy] {
    inner: Inner;
    count: i32;
    multiplier: i32;
}

data Main {
    console: Binding<Console>;
    state: Outer;
    pause: [u8; 256];
}

machine Main::set_value(&mut self, v: i32)
requires
    v >= 0 && v <= 1000;
{
    self.state.inner.value = v;
}

machine Main::set_bonus(&mut self, b: i32)
requires
    b >= 0 && b <= 1000;
{
    self.state.inner.bonus = b;
}

// The MODULAR-COUNTER idiom -- the Exact-provable bounded counter: reducing
// the read `% 101` bounds it to [-100..=100], so `+ 1` stays within i32, and
// the outer `% 101` wraps to 0 at 101 exactly as before for a count in
// 0..=100. The boundary behavior is declared IN the arithmetic, not silently
// assumed -- nothing here can overflow, so no overflow domain is needed.
machine Main::increment_count(&mut self) {
    self.state.count = (self.state.count % 101 + 1) % 101;
}

machine Main::set_multiplier(&mut self, m: i32)
requires
    m >= 0 && m <= 100;
{
    self.state.multiplier = m;
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("nested_counters: mutating struct-in-struct fields across sub-machine calls");
    self.set_value(10);
    self.set_bonus(20);
    self.increment_count();
    self.set_multiplier(5);
    self.set_value(40);
    self.increment_count();

    // Verify nested field self.state.inner.value == 40.
    transition self.state.inner.value == 40 {
        true -> check_bonus()
        _ -> bad_value()
    }

    state bad_value(&mut self) {
        self.console.write_line("FAIL: wrong nested value field (exit 71)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state check_bonus(&mut self) {
        transition self.state.inner.bonus == 20 {
            true -> check_count()
            _ -> bad_bonus()
        }
    }

    state bad_bonus(&mut self) {
        self.console.write_line("FAIL: wrong nested bonus field (exit 72)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state check_count(&mut self) {
        transition self.state.count == 2 {
            true -> check_multiplier()
            _ -> bad_count()
        }
    }

    state bad_count(&mut self) {
        self.console.write_line("FAIL: wrong counter value (exit 73)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }

    state check_multiplier(&mut self) {
        transition self.state.multiplier == 5 {
            true -> compute_result()
            _ -> bad_multiplier()
        }
    }

    state bad_multiplier(&mut self) {
        self.console.write_line("FAIL: wrong nested multiplier field (exit 75)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(75);
    }

    state compute_result(&mut self) {
        // result = inner.value + inner.bonus + count * multiplier
        //        = 40 + 20 + 2 * 5 = 70
        let result: i32 = self.state.inner.value + self.state.inner.bonus
                        + self.state.count * self.state.multiplier;
        transition result == 70 {
            true -> good()
            _ -> bad_result()
        }
    }

    state bad_result(&mut self) {
        self.console.write_line("FAIL: wrong combined result (exit 74)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(74);
    }

    state good(&mut self) {
        self.console.write_line("PASS: 40 + 20 + 2*5 = 70 from nested fields (exit 70)");
        self.console.write_line("[press Enter to close]");
        _ = block self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
}
