// coordinate_domain: a USER-AUTHORED domain as sample code — the first
// sample to declare `domain<const Axis: u64> i64::Coordinate<Axis>` and to
// attach generic machines to it. Domain-typed values are erased to the
// carrier inside the operation body and re-qualified with the unit on the
// way out; there is no builtin arithmetic fallback — only the named
// machines homed in the domain serve `+` and `*` on `i64 in Coordinate`.
//
//   mark() casts a plain i64 into Coordinate<7> via `as i64 in Coordinate<7>`
//   `a + b` resolves to Coordinate::add over the shared axis
//   `v * k` resolves to Coordinate::scale (raw scalar factor stays Exact)
//   judge accepts only (40 + 2) * 2 - 42 ... == 42
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
domain<const Axis: u64> i64::Coordinate<Axis>;

// `+` on one axis: both operands erased to the carrier, wrapped arithmetic
// (no range premise needed), re-qualified with the SAME axis.
machine + Coordinate::add<const Axis: u64>(
    left: i64 in Coordinate<Axis>,
    right: i64 in Coordinate<Axis>
) -> i64 in Coordinate<Axis> {
    ((left as i64 in Wrapping) + (right as i64 in Wrapping)) as i64 in Coordinate<Axis>
}

// `*` scales by a raw factor: mixed domain/raw operands spell each side
// explicitly — the factor stays a plain i64, only the point carries Axis.
machine * Coordinate::scale<const Axis: u64>(
    point: i64 in Coordinate<Axis>,
    factor: i64
) -> i64 in Coordinate<Axis> {
    ((point as i64 in Wrapping) * (factor as i64 in Wrapping)) as i64 in Coordinate<Axis>
}

machine coordinate_domain() {
    let a: i64 in Coordinate<7> = 40 as i64 in Coordinate<7>;
    let b: i64 in Coordinate<7> = 2 as i64 in Coordinate<7>;
    let doubled: i64 in Coordinate<7> = (a + b) * 2;
    transition (doubled as i64) == 84 {
        true -> judge_wrong_axis()
        _ -> done(71)
    }

    // A different axis is a different type: Coordinate<3> values only
    // compose with Coordinate<3> machines.
    machine judge_wrong_axis {
        let c: i64 in Coordinate<3> = 20 as i64 in Coordinate<3>;
        let d: i64 in Coordinate<3> = 1 as i64 in Coordinate<3>;
        transition ((c + d) as i64) == 21 {
            true -> done(70)
            _ -> done(72)
        }
    }

    machine done(code: i32) {}
}
