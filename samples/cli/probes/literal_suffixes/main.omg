// Typed integer literal suffixes select the literal's primitive
// type: `100i64`, `7u32`, `9usize`. Each value round-trips through
// storage and compares equal to the same suffixed literal.
//
//   * `usize` is its own primitive — `9usize` lands in a `u64`
//     field.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Main {
    wide: i64;
    small: u32;
    size: u64;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.wide = 100i64;
    main.small = 7u32;
    main.size = 9usize;
    transition main.wide == 100i64 && main.small == 7u32
        && main.size == 9usize {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
