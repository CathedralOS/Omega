// Attached machines are namespaced statics: `machine Main::bump`
// lives on the Main carrier but takes whatever parameters the machine
// declares — the receiver need not be the carrier type at all.
//
//   * `machine Main::bump(reward: @mutable Reward)` — attached machine
//     whose only parameter is an unrelated data type.
//   * `machine count(bytes: @[u8])` — free machine with a structural
//     byte-view parameter called on `@main.buf` (ambient receiver:
//     the call's structural argument sits beside the forwarded
//     carrier).
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Reward { gold: i32 in Wrapping; }
data Probe { base: u64; }

machine count(bytes: @[u8]) -> u64 { (bytes.length) }

machine Main::bump(reward: @mutable Reward) {
    reward.gold = reward.gold + 1;
}

data Main {
    probe: Probe;
    reward: Reward;
    buf: [u8; 8];
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    main.buf[0] = 1;
    Main::bump(@mutable main.reward);
    transition count(@main.buf) == 8 && main.reward.gold == 1 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
