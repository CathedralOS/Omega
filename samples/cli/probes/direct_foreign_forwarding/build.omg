use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "direct_foreign_forwarding" };
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::ProcessProbe, |app|::ProcessProvider>(builder, alpha_bootstrap);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::UnusedWideCall, |app|::UnusedWideProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
