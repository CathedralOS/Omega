use main.omg as app;
use {omega}/build/dependency.omg;

machine build(build: @mutable BuildPlan) {
    build.product = BuildProduct::Application { name: "callback_slot_materialization" };
    let system: DependencyRegistration = Build::dependency(build, |dependency|::from_source(Source::Bundled { name: "system" }));
    Build::bind(build, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(build, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(build, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(build, macos_arm64::ProgramEntry, |app|::entry_start);
}
