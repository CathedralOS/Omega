// `PrivateCallbackSlot<Layout, Requirement>` is a
// compiler-known relationship whose second trait
// argument is a MACHINE — `WindowProcedure::call` cites
// the callback requirement directly. A named
// implementation is inert until a layout policy cites it
// through `layout_plan_place_private<Implementation>`.
//
//   * `trait PrivateCallbackSlot<Layout, machine
//     Requirement>` — machine-typed trait parameter.
//   * `Slot satisfies PrivateCallbackSlot<Spread,
//     WindowProcedure::call>` — named impl citing the
//     boundary machine by reference.
//   * `layout_plan_place_private<WndClassSlot>(plan, 8)` — the
//     policy machine cites the named impl as a static
//     argument; runtime code receives no slot identity.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use {omega}/language/core/layout.omg;

public boundary trait WindowProcedure {
    machine call(message: u64) reaches none crashes none;
}

data Spread {}

WndClassSlot satisfies |layout|::PrivateCallbackSlot<Spread, WindowProcedure::call> { }

SecondarySlot satisfies |layout|::PrivateCallbackSlot<Spread, WindowProcedure::call> { }

machine Spread::plan(schema: |layout|::Schema) -> |layout|::LayoutPlan {
    let mutable owned_entries: [|layout|::FieldEntry; 64];
    owned_entries[0] = |layout|::FieldEntry {
        key: schema.fields[0].key,
        representation: |layout|::FieldPlan::At { offset: 0 },
    };
    let plan: |layout|::LayoutPlan = |layout|::LayoutPlan {
        entries: owned_entries,
        entry_count: 1,
        size_fixed: 24,
        size_is_dynamic: false,
        align: 8,
    };
    let placed: |layout|::LayoutPlan = |layout|::layout_plan_place_private::<WndClassSlot>(plan, 8);
    |layout|::layout_plan_place_private::<SecondarySlot>(placed, 16)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) { main.hits = 1; }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
