use {omega}/language/core/layout.omg;

public boundary trait WindowProcedure {
    machine call(message: u64) reaches none crashes none;
}

data WindowClass { id: u64; }

WndClassSlot satisfies |layout|::PrivateCallbackSlot<WindowClass, Spread, WindowProcedure::call> {}
SecondarySlot satisfies |layout|::PrivateCallbackSlot<WindowClass, Spread, WindowProcedure::call> {}

Spread satisfies |layout|::FixedLayout<WindowClass> {
    public machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none terminates {
        let mutable owned_entries: [|layout|::FieldEntry; 64];
        owned_entries[0] = |layout|::FieldEntry {
            key: schema.fields[0].key,
            representation: |layout|::FieldPlan::At { offset: 0 },
        };
        let plan: |layout|::LayoutPlan = |layout|::LayoutPlan {
            entries: owned_entries,
            entry_count: 1,
            size_fixed: 24,
            size_is_dynamic: false,
            align: 8,
        };
        let placed: |layout|::LayoutPlan = |layout|::layout_plan_place_private::<WndClassSlot>(plan, 8);
        |layout|::layout_plan_place_private::<SecondarySlot>(placed, 16)
    }
}

data WindowClassStorage = |layout|::LayoutStorage<WindowClass, Spread>;

machine entry_start() crashes Trap {
    let mutable window: WindowClassStorage;
    window.id = 7u64;
    transition window.id == 7u64 {
        true -> done(), _ -> fail()
    }
    machine done() {}
    machine fail() { crash Trap; }
}
