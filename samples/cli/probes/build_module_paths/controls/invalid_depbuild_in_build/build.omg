use {omega}/build/dependency.omg;

machine build(plan: @mutable BuildPlan) {
    let mutable kit: DependencyDescription = |dependency|::from_source(Source::Path { location: "dep" });
    |dependency|::with_alias(@mutable kit, "kit");
    _ = |dependency|::add(plan, kit);
    plan.product = BuildProduct::InterpretedBuild { entry: "stage.omg" };
}
