// Facet assignment is legal but inert until an op runs: swapping a
// fabricated value over a compiler-issued facet compiles, and the
// FIRST operation on the replacement rejects — the evaluator knows
// the activation facet, not the field contents.
machine build(builder: &mut Build) {
    Build::application(builder, "build_facet_swap");
    builder.freestanding = true;
    builder.source = BuildSource {};
    builder.inputs = BuildInputs {};
    builder.log = BuildLog {};
    builder.product = BuildProduct {};
}
