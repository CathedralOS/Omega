// Builtin layout queries as first-class machines:
// `size_of<Pair>()` and `align_of<Pair>()` evaluate at
// compile time — usable in const context and inside
// machine bodies. `Pair{left:u64; right:u32}` lays out as
// size 16, alignment 8.
//
//   * `const BYTES: u64 = size_of<Pair>();` — const-
//     position query.
//   * `align_of<Pair>()` — value-position query.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Pair { left: u64; right: u32; }

const BYTES: u64 = size_of<Pair>();

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let alignment: u64 = align_of<Pair>();
    transition BYTES == 16 && alignment == 8 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
