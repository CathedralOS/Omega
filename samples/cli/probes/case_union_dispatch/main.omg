// Case-subset domains as transition arms: `Command::Interactive` is a
// pure case-union domain (`requires command in Command::Move |
// Command::Say`), so one arm covers both tags — the dispatch is
// exhaustive with no `_` arm ("Cases Are Domains").
//
//   * `domain Command::Interactive(command) requires command in
//     Command::Move | Command::Say` — the union admits both payloads.
//   * `transition main.cmd { None | Quit | Interactive }` — the union
//     arm classifies the held Say member at runtime AND counts toward
//     exhaustiveness.
//   * `hits` records which arm ran.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Command {
    case None;
    case Quit;
    case Move(dx: i32);
    case Say(volume: i32);
}

domain Command::Interactive(command)
requires
    command in Command::Move | Command::Say;

data Main {
    cmd: Command;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.cmd = Command::Say { volume: 3 };
    transition main.cmd {
        Command::None -> miss(main)
        Command::Quit -> miss(main)
        Command::Interactive -> hit(main)
    }
    machine hit(main: &mut Main) { main.hits = 1; }
    machine miss(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
