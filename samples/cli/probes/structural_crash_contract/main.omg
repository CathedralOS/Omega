use {omega}/language/core/process_exit.omg;
// Expected exit: 70
// A borrowed invocation keeps a record-equality crash ceiling, including
// all eight elements of each domain-qualified fixed array.

domain [u8; 8]::Utf8
requires valid_utf8(self);

data Message { active: bool; text: [u8; 8] in Utf8; }
data Main { left: Message; right: Message; }

machine Main::inspect(main: @Main)
crashes Abort
    main.left == main.right
{}

machine Main::main(main: @mutable Main) reaches |process_exit|::ProcessExit
crashes Abort
{
    Main::inspect(main);
    |process_exit|::ProcessExit::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit
crashes Abort
{
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
