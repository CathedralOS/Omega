// slice_borrow_tally: slices and shared borrows — the first sample
// passing `&mut [T; N]` borrowed arrays, `&T` shared borrows, and arrays
// by value through calls.
//
//   * `tally(&mut main.items, &main.filter)` lends the carrier's array
//     mutably and shares the filter — the callee writes `buf[2]` through
//     the borrow (fixed length keeps the index provable) and reads
//     `filter.keep` through the shared borrow in the same call.
//   * `let view: &[i32] = &main.items[..]` then takes a shared slice
//     view of the whole array — legal only after the mutable lend ends.
//   * `consume(main.items)` passes the array by value while `view` is
//     live — a copy-eligible fixed array copies rather than moves, so
//     the owner place and the live view both survive the call.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Filter { keep: i32; }
data Main { items: [i32; 3]; filter: Filter; }

machine tally(buf: &mut [i32; 3], filter: &Filter) -> i32 in Wrapping {
    buf[2] = filter.keep;
    let a: i32 in Wrapping = buf[0] as i32 in Wrapping;
    let b: i32 in Wrapping = buf[1] as i32 in Wrapping;
    let c: i32 in Wrapping = buf[2] as i32 in Wrapping;
    a + b + c
}

machine consume(items: [i32; 3]) -> i32 {
    items[0]
}

machine Main::main(main: &mut Main) crashes Trap {
    main.items = [10, 20, 20];
    main.filter.keep = 20;
    let sum: i32 in Wrapping = tally(&mut main.items, &main.filter);
    let view: &[i32] = &main.items[..];
    let copied_first: i32 = consume(main.items);
    let seen: i32 = view[0];
    transition sum == 70 && copied_first == 10 && seen == 10 {
        true -> done()
        _ -> bad()
    }

    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
