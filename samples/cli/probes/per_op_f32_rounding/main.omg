// binary32 arithmetic rounds EVERY operation: at 2^24,
// `+ 1.0f32` rounds back to 2^24, so two successive adds
// plateau at 16777216 — while computing the same tree in
// f64 and narrowing once lands at 16777218.
//
//   * `main.value == (16777216.0f32 + 1.0f32 + 1.0f32)` —
//     per-op rounding: both additions collapse.
//   * Learning: `(f64 expr) as f32` on a non-foldable
//     tree is an EXACT cast — the checker demands a named
//     conversion (`F32::from_f64`) for rounding/
//     truncation, it cannot prove representability
//     itself.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::float_operations;

data Main {
    value: f32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.value = 16777216.0;
    main.hits = 0;
    transition main.value == (16777216.0f32 + 1.0f32 + 1.0f32) {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
