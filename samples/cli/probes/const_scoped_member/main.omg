data Index [copy] { value: u64; }
data Sizes {}
const Sizes::SIZE: Index = Index { value: 1 };
const Sizes::WIDTH: Index = Index { value: 2 };
data Indexed<const Selected: Index> { value: u8; }
machine keep(value: Indexed<Sizes::SIZE>) -> Indexed<Sizes::SIZE> { value }
machine keep2(value: Indexed<Sizes::WIDTH>) -> Indexed<Sizes::WIDTH> {
    let Sizes: u64 = 0;
    value
}
data Main { probe: Indexed<Sizes::SIZE>; }
machine Main::main(main: &mut Main) {
    main.probe = Indexed { value: 7 };
    let kept: Indexed<Sizes::SIZE> = keep(Indexed { value: 9 });
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
