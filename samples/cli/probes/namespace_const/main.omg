// namespace_const: carrier namespaces and marked generic parameters —
// the first sample where a lowercase top-level const supplies the value
// a data carrier's machines return, plus a `[copy]` marker bound on a
// generic parameter.
//
//   * `const seed` is a plain module constant; free `marker()` reads it —
//     the carrier namespace contributes no field binding.
//   * `Counter::constant()` reaches the same free machine through the
//     carrier's name; `Counter::echo<T [copy]>` binds a parameter whose
//     marker makes returning `argument` by value legal.
//   * Inference spells generic calls without angle args:
//     `Counter::echo(17)` picks `T == i32`.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
const seed: i32 = 7;

data Counter { value: i32; }

machine marker() -> i32 { seed }

machine Counter::constant() -> i32 {
    marker()
}

machine Counter::echo<T [copy]>(argument: T) -> T {
    argument
}

machine namespace_const() {
    let direct: i32 = Counter::constant();
    let echoed: i32 = Counter::echo(17);
    let counter: Counter = Counter { value: direct };
    transition direct == seed && echoed == 17 && counter.value == 7 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
