// gated_data_bounds: gated (dependent) data as sample code — the first
// sample declaring `data ... where` field bounds, where literal
// construction IS the gate.
//
//   * `Player` carries `health >= 1 && health <= 100` — zero health is
//     not a Player, and `Player { health: 50 }` constructs because the
//     literal proves the bounds at the gate.
//   * `Gauge` narrows a level to 0..=3 the same way.
//   * `wound` mutates inside the gate under a dominating guard: the
//     `health > 30` transition arms the `health - 30` assignment so the
//     stored value still satisfies the bound (and discharges the exact
//     arithmetic obligation at the same time).
//
// The machine constructs a 50-health player and a 3-level gauge, wounds
// the player to 20, reads both, and accepts on 20 + 3 == 23.
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Player
where
    health >= 1,
    health <= 100,
{
    health: i32;
}

data Gauge
where
    level >= 0,
    level <= 3,
{
    level: i32;
}

machine wound(player: &mut Player) {
    transition player.health > 30 {
        true -> subtracted(player)
        _ -> done()
    }

    machine subtracted(player: &mut Player) {
        player.health = player.health - 30;
    }

    machine done() {}
}

machine gated_data_bounds() {
    let mut champion: Player = Player { health: 50 };
    let gauge: Gauge = Gauge { level: 3 };
    wound(&mut champion);
    let strength: i32 = champion.health;
    transition strength == 20 && gauge.level == 3 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
