// Case-call premises: `requires value in Tree::Empty` restricts a
// machine to one case; call sites inside `ensures` are statically
// discharged (concrete literals, symbolic subjects gated by the
// caller's own requires, aliased subjects via `requires v == alias`).
//
//   * Tag preconditions do NOT constrain common/payload fields.
//   * `requires value in Tree::Node` on a recursive payload case.
//   * `hits` records the reached arm.
//
// Compile-checked only: declaration surface (requires-bearing
// machines are callable only where the premise is provable), no
// standard-library dependency, no ProcessExit provider.

data Tree {
    marked: bool;
    case Empty;
    case Node(child: Tree);
}

machine empty_only(value: Tree) -> Tree
requires value in Tree::Empty;
terminates;
{ value }

machine node_only(value: Tree) -> Tree
requires value in Tree::Node;
terminates;
{ value }

machine concrete()
ensures empty_only(Tree::Empty { marked: true })
    == empty_only(Tree::Empty { marked: true });
ensures node_only(Tree::Node { marked: true, child: Tree::Empty })
    == node_only(Tree::Node { marked: true, child: Tree::Empty });
{}

machine symbolic(value: Tree)
requires value in Tree::Empty;
ensures empty_only(value) == empty_only(value);
{}

machine alias_subject(value: Tree, alias: Tree)
requires value == alias;
requires value in Tree::Empty;
ensures empty_only(alias) == empty_only(alias);
{}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}
