// Selector evaluates once: `tokens[select(&mut cursor)] =
// replacement(&mut cursor)` — the index computation runs
// before the replacement call, and the store consumes its
// saved coordinate rather than re-evaluating. `select`
// mutates `index` but the array store still hits slot 0.
//
//   * `machine select(cursor: &mut Cursor) -> u64 ensures
//     result == 0` contract on the selector.
//   * Element-wise array member writes.
//
use omega::language::core::drop;

// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Token { value: u64; }
data Cursor { index: u64; calls: u64 in Wrapping; }

machine Token::drop(token: &mut Token) { token.value = 0; }

machine select(cursor: &mut Cursor) -> u64 ensures result == 0 {
    cursor.calls += 1;
    cursor.index = 1;
    0
}

machine replacement(cursor: &mut Cursor) -> Token {
    cursor.index = 3;
    Token { value: 19 }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut tokens: [Token; 2] = [Token { value: 11 }, Token { value: 7 }];
    let mut cursor: Cursor = Cursor { index: 0, calls: 0 };
    tokens[select(&mut cursor)] = replacement(&mut cursor);
    let kept: u64 = tokens[0].value;
    let other: u64 = tokens[1].value;
    let outcome: bool = cursor.calls == 1 && cursor.index == 3 && kept == 19 && other == 7;
    drop(tokens[0]);
    drop(tokens[1]);
    transition outcome {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
