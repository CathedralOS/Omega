// Namespace float-to-int conversions carry a policy
// domain: `I32::from_f64(v)` / `U8::from_f64(v)` return
// `i32 in Trapping` / `u8 in Trapping` — a NaN or
// out-of-range operand admits a conversion trap instead
// of a normal result.
//
//   * `let converted: i32 in Trapping =
//     I32::from_f64(main.value)` — the Trapping result
//     admits the trap; `converted as i32` erases the
//     domain for ordinary consumers.
//   * `U8::from_f64(200.9)` — truncating conversion
//     yields 200 on a finite in-range operand.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::float_operations;

data Main {
    value: f64;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.value = 0.0f64 / 0.0f64;
    main.hits = 0;
    let converted: i32 in Trapping = I32::from_f64(main.value);
    let small: u8 in Trapping = U8::from_f64(200.9);
    transition (converted as i32) == 0 && small == 200u8 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
