// A machine parameter bound by a trait requirement
// dispatches statically: `machine step<T, machine
// Increment>(subject: &mut T) where machine Increment
// satisfies Incrementable<T>::increment` — the
// caller names the implementation and `Increment
// (subject)` calls it with no runtime dictionary.
//
//   * `CounterIncrementable satisfies
//     Incrementable<Counter>` provides the candidate
//     row.
//   * `step<Counter, Counter::increment>` — or the
//     implementation name bound to the requirement —
//     specializes the call.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(counter: &mut Counter) satisfies Incrementable<Counter>::increment {
    counter.value = counter.value + 1;
}
CounterIncrementable satisfies Incrementable<Counter> {
    Incrementable::increment = Counter::increment;
}

machine step<T, machine Increment>(subject: &mut T)
where machine Increment satisfies Incrementable<T>::increment;
{
    Increment(subject);
}

data Main { counter: Counter; hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.counter.value = 0;
    step<Counter, Counter::increment>(&mut main.counter);
    transition main.counter.value == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
