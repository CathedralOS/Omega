// `step<T, const Increment: Incrementable<T>::increment>` accepts a
// selected implementation of the named requirement. `Increment(subject)`
// calls that implementation with the explicit mutable subject.
//
//   * `CounterIncrementable satisfies
//     Incrementable<Counter>` provides the candidate
//     row.
//   * `step<Counter, Counter::increment>` — or the
//     implementation name bound to the requirement —
//     specializes the call.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Incrementable<T> {
    machine increment(counter: @mutable T);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(counter: @mutable Counter) satisfies Incrementable<Counter>::increment {
    counter.value = counter.value + 1;
}
CounterIncrementable satisfies Incrementable<Counter> {
    machine increment(counter: @mutable Counter) { Counter::increment(counter) }
}

machine step<T, const Increment: Incrementable<T>::increment>(subject: @mutable T)
{
    Increment(subject);
}

data Main { counter: Counter; hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    main.counter.value = 0;
    step::<Counter, Counter::increment>(@mutable main.counter);
    transition main.counter.value == 1 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
