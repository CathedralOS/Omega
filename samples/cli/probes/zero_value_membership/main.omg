// `zero_value<T>()` in contracts: a generic machine can ensure
// `zero_value<Maybe<T>>() in Maybe::None` — case membership of the
// zero value of a generic sum — and call it at concrete types.
//
//   * `proof [erased]` payload erased from runtime.
//   * `zero_is_none<T>()` ensures zero_value is in the None case
//     (declaration surface — a zero-arg generic call can't infer T,
//     and turbofish `::<i32>` doesn't parse; see README).
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Evidence {
    case Only;
}

data Maybe<T> {
    case None;
    case Some(value: T, proof [erased]: Evidence);
}

machine zero_is_none<T>()
ensures
    zero_value<Maybe<T>>() in Maybe::None
{}

machine inspect() -> i32 {
    let maybe: Maybe<i32> = Maybe::Some { value: 7 };
    transition maybe {
        Maybe::Some { value, proof as _ } -> value
        Maybe::None -> 0
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition inspect() == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
