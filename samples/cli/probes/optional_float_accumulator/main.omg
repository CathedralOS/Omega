// optional_float_accumulator: Optional<f64> presence-case dispatch inside an
// f64 accumulation loop — the first sample to exercise Optional as user data
// (its only prior uses are internal Option carriers inside std packages) and
// to run a float accumulator across a state-machine counter without the
// standard-library package.
//
// The machine folds the series 1/1 + 1/2 + 1/3 + ... + 1/8 = 2.717857... while
// reading each term through an Optional, then branches on the final sum.
// Compile-checked only: with no standard-library dependency there is no
// ProcessExit provider, so the artifact has no run behavior to pin.
//
// Checks (proved or rejected by the compiler's own evaluation):
//   terms 1..8 consumed via Optional::Some in order
//   sum lands in (2.71, 2.72)
//   an Optional::None term contributes 0.0
use omega::language::core::float_operations;
use omega::language::core::option;

machine term(n: i32) -> Optional<f64> {
    transition n {
        1 -> Optional::Some { value: 1.0 }
        2 -> Optional::Some { value: 0.5 }
        3 -> Optional::Some { value: 0.3333333333333333 }
        4 -> Optional::Some { value: 0.25 }
        5 -> Optional::Some { value: 0.2 }
        6 -> Optional::Some { value: 0.16666666666666666 }
        7 -> Optional::Some { value: 0.14285714285714285 }
        8 -> Optional::Some { value: 0.125 }
        _ -> Optional::None
    }
}

machine optional_float_accumulator() {
    transition { _ -> fold(1, 0.0) }

    machine fold(n: i32, sum: f64) {
        let t: Optional<f64> = term(n);
        transition t {
            Optional::Some { value } -> step(n, sum, value)
            Optional::None -> judge(sum)
        }
    }

    // n < 8 dominates the increment, so `n + 1` stays provably in range.
    machine step(n: i32, sum: f64, value: f64) {
        transition n < 8 {
            true -> fold(n + 1, sum + value)
            _ -> done(72)
        }
    }

    machine judge(sum: f64) {
        transition sum > 2.71 && sum < 2.72 {
            true -> done(70)
            _ -> done(71)
        }
    }

    machine done(code: i32) {}
}
