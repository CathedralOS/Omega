// Deep-field views from an owned arrival: `check(packet: Packet)`
// receives owned state, then `&packet.samples.items[..]` lends the
// doubly-nested array as a slice while the owning record stays
// readable beside the loan.
//
//   * `&packet.samples.items[..]` nested-field view.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Samples {
    items: [i32; 4];
}

data Packet {
    samples: Samples;
    marker: i32;
}

machine read(values: &[i32]) -> i32 {
    transition values.len >= 4 {
        true -> (values[0])
        _ -> (0)
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let packet: Packet = Packet {
        samples: Samples { items: [70, 2, 3, 5] },
        marker: 9
    };
    transition { _ -> check(packet, main) }
    machine check(packet: Packet, main: &mut Main) {
        let view: &[i32] = &packet.samples.items[..];
        let observed: i32 = read(view);
        transition observed == 70 && packet.samples.items[3] == 5
            && packet.marker == 9 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
