// Case-array literals: a whole array literal of payload-free cases
// stored into a fixed-array field in one assignment —
// `main.grid = [Cell::Wall, ..]` — then case dispatch reads an
// ELEMENT as transition subject (`transition main.grid[0]`). The
// second literal replaces occupied elements.
//
//   * `grid: [Cell; 4]` zero-fills to the first case, then two
//     whole-literal replacements.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Cell {
    case Wall;
    case Floor;
    case Door;
    case Water;
}

data Main {
    grid: [Cell; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.grid = [Cell::Wall, Cell::Wall, Cell::Wall, Cell::Wall];
    main.grid = [Cell::Water, Cell::Door, Cell::Floor, Cell::Wall];
    transition main.grid[0] {
        Cell::Water -> second(main)
        _ -> fail(main)
    }
    state second(main: &mut Main) {
        transition main.grid[1] {
            Cell::Door -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
