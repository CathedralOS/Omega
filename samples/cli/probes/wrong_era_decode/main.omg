// Decode only accepts the schema's CURRENT era: a hand-built buffer with era
// byte 5 where the schema's era is 0 must produce the sticky `Invalid`
// verdict — the decoder keeps scanning bounds-checked but nothing re-sets it.
data CounterMessage {
    #0 counter: u32;
    #1 delta: i32;
    #2 flag: bool;
}
data CounterSample {
    counter: u32;
    delta: i32;
    flag: bool;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main { read: u64; verdict: WireVerdict; }
machine Main::main(main: &mut Main) {
    let buffer: [u8; 8] = [5, 0, 0, 0, 0, 0, 0, 0];
    let decoded: CounterSample = CounterSample {
        counter: 0,
        delta: 0,
        flag: false
    };
    CounterMessage::decode(&mut decoded, &buffer, &mut main.read, &mut main.verdict);
    transition main.verdict {
        WireVerdict::Sound -> bad(main)
        WireVerdict::Invalid -> good(main)
    }
    machine good(main: &mut Main) { }
    machine bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
