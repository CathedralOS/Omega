// A Unit result promises the shape of a return, not that a return
// occurs: `wait_forever` is a valid Unit machine whose states only ever
// transition to themselves.
machine wait_forever() {
    transition { _ -> waiting() }
    state waiting() { transition { _ -> waiting() } }
}

data Main { wait: bool; }

machine Main::run(main: &mut Main) {
    transition main.wait {
        true -> wait()
        _ -> finish()
    }
    state wait() { wait_forever(); }
    state finish() {}
}
