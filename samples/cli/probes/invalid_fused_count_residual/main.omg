// The residual array has three differences. Index 3 is outside that length.

data Moment {
    differences: [f64; 3];
}

machine store_past_end(moment: @mutable Moment, value: f64) {
    moment.differences[3] = value;
}

machine entry_start() {
    let mutable moment: Moment;
    store_past_end(@mutable moment, 1.0);
}
