// Affine owners moved into the construction a computed call
// consumes, inside a machine with named states: the entry state
// moves a local into `Pair`; `holding` moves its parameter into
// another. Each move is the owner's one disposition.
//
//   * `settle(Pair { left: held, right: fresh })` inside a
//     state body.
//   * `transition { _ -> holding(carried) }` goto spelling.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Token { code: i32; }
data Pair { left: Token; right: Token; }

machine settle(pair: Pair) -> i32 {
    ((pair.left.code as i32 in Wrapping) + (pair.right.code as i32 in Wrapping)) as i32
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let left: Token = Token { code: 1 };
    let first: i32 = settle(Pair { left: left, right: Token { code: 2 } });
    let carried: Token = Token { code: first };
    transition { _ -> holding(main, carried) }

    state holding(main: &mut Main, held: Token) {
        let total: i32 = settle(Pair { left: held, right: Token { code: 4 } });
        transition total == 7 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
