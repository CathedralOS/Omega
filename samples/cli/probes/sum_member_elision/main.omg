// A record literal may elide a sum-typed member whose first
// case carries scalar payloads: zero establishment mints
// the first-case tag cell and the zero spelling of its
// scalar payload fields. `Snapshot {}` and
// `Snapshot { region_count: 4 }` both establish.
//
//   * `data RegionAlignment { case Unaligned(offset:u64);
//     case Aligned(boundary:u64); }` — first-case payloads
//     zero-establish.
//   * `padding: [u8; 8]` array member also elides.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data RegionAlignment {
    case Unaligned(offset: u64);
    case Aligned(boundary: u64);
}

data Snapshot {
    region_count: u32;
    padding: [u8; 8];
    alignment: RegionAlignment;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let snapshot: Snapshot = Snapshot {};
    let partial: Snapshot = Snapshot { region_count: 4 };
    let counted: u32 = partial.region_count;
    transition snapshot.alignment {
        RegionAlignment::Unaligned { offset } -> check(main, counted)
        _ -> fail(main)
    }
    machine check(main: &mut Main, counted: u32) {
        transition counted == 4 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
