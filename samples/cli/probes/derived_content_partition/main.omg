// Expected exit: 0
// A conservation theorem consumes one parent and qualifies its two children
// at their formation. These coordinates are not a physical memory grant.
use {omega}/language/core/content.omg;
use {omega}/language/core/foundation.omg as proof;
use {omega}/language/core/nat.omg;

data Region [linear] dropped by drop_region { start: u64; end: u64; }
machine drop_region(region: @mutable Region) {}
domain Region::Owned;
machine Owned::content(region: @Region) -> |content|::IntervalSet<|nat|::Nat>
satisfies |content|::Content<Region, |content|::IntervalSet<|nat|::Nat>>::project {
    |content|::IntervalSet { start: embed(region.start) as |nat|::Nat, end: embed(region.end) as |nat|::Nat }
}
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, cut: u64) -> Pieces
requires whole.start <= cut && cut <= whole.end
ensures |proof|::Identity::<|content|::IntervalSet<|nat|::Nat>>(
    Owned::content(old(@whole)),
    separate(
        Owned::content(@result.left), Owned::content(@result.right))
) {
    let left: Region = Region { start: whole.start, end: cut };
    let right: Region = Region { start: cut, end: whole.end };
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let whole: Region in Owned = Region { start: 10, end: 90 };
    let pieces: Pieces = split(whole, 30);
    let correct: bool = pieces.left.start == 10 && pieces.left.end == 30
        && pieces.right.start == 30 && pieces.right.end == 90;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    transition correct { true -> done(), false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
