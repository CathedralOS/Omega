// Expected exit: 0. Expected output contains: 41
// Run: omega run --both --keep --entry-ram 0=2900000003000000 main.omg
// The explicit runtime recipe constructs original Registers{status:41,transmit:3}
// before lending this direct entry parameter. Read32@0 yields41; write8@4 stores9.
// Native and captured Terminal streams must contain41 followed by LF. After
// normal return the runtime owner observes original bytes2900000009000000.
// Default entry supply is absent. No host address, MMIO, external lifetime,
// qualifications, compound storage, or unproved callback is admitted here.
use {omega}/language/core/access/access.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/reflect/reflect.omg;
use {system}/console.omg;
use {omega}/language/core/process_authority.omg;

public data Registers {
    status: u32;
    transmit: u8;
}

public domain Registers::Placed access RegisterAccess;
public data RegisterStorage = |layout|::LayoutStorage<Registers, RegisterLayout>;

public RegisterLayout satisfies |layout|::FixedLayout<Registers> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan
    reaches none crashes none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 4 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 2, size_fixed: 8, size_is_dynamic: false, align: 4 }
    }
}

public RegisterAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan
    reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflect|::field(Registers::status),
            |layout|::FieldAccess::External { read: |layout|::ExternalRead::Read, write: false, exposure: |layout|::Exposure::Exported });
        |access|::observe(@mutable plan, |reflect|::field(Registers::transmit),
            |layout|::FieldAccess::External { read: |layout|::ExternalRead::None, write: true, exposure: |layout|::Exposure::Exported });
        plan
    }
}

data Main { }
machine Main::main(main: @mutable Main, view: @mutable RegisterStorage in Registers::Placed) reaches |process_authority|::StandardOutput {
    let observed: u32 = |layout|::read::<|layout|::Accessor<u32>, u32>(@view.status);
    |console|::Console::write_byte((((observed / 10) % 10) as i32) + 48);
    |console|::Console::write_byte(((observed % 10) as i32) + 48);
    |console|::Console::write_byte(10);
    |layout|::write::<|layout|::Accessor<u8>, u8>(@mutable view.transmit, 9u8);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start(view: @mutable RegisterStorage in Registers::Placed) reaches |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage, view);
}
