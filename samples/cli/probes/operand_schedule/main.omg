// Transition subjects and edge operands are scheduled
// expressions: `false && clear(&mut flag)` skips the
// effect, `flag && demand(flag)` evaluates the operand
// once and discharges the callee's `requires`, and edge
// arguments evaluate in order before the transfer.
//
//   * `Main::skip_and`/`skip_or` — requires/ensures on a
//     machine whose whole body is one transition result;
//     the unreachable side effect never runs.
//   * `checked_transfer` — `done(false &&
//     clear(&mut flag), flag)` passes the still-true flag
//     observed before the skipped clear: the edge's second
//     operand sees the pre-schedule state, `requires
//     current` proves it.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main { flag: bool; }

machine clear(flag: &mut bool) -> bool { flag = false; true }

machine Main::skip_and(main: &mut Main) -> bool
requires main.flag
ensures main.flag
{
    transition { _ -> (false && clear(&mut main.flag)) }
}

machine checked_transfer() {
    let mut flag: bool = false;
    flag = true;
    transition { _ -> done(false && clear(&mut flag), flag) }
    machine done(ignored: bool, current: bool) requires current {}
}

machine demand(flag: bool) -> bool requires flag { true }

machine selected_operand(flag: bool) -> bool {
    transition { _ -> (flag && demand(flag)) }
}

machine Main::main(main: &mut Main) {
    main.flag = true;
    let kept: bool = Main::skip_and(main);
    let picked: bool = selected_operand(true);
    checked_transfer();
    transition kept && picked && main.flag {
        true -> done(main)
        _ -> done(main)
    }
    machine done(main: &mut Main) {}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
