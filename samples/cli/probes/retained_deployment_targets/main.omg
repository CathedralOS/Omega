// Deployment tags beyond the bound four: archive_target/reserved_target bodies
// are checked and retained without supplying execution demand. A target body
// may satisfy several requirements in one roster, and a same-target caller
// resolves its own family's body.
data Helper { seed: u32; }
trait Value<T> { machine unrealized(helper: &T) -> u32; }
data Unused {}
boundary requirement Unused::read(helper: &Helper) -> u32;

uefi_x86_64 machine Helper::internal(helper: &Helper) -> u32 { helper.seed }
uefi_x86_64 machine Helper::caller(helper: &Helper) -> u32 {
    transition { _ -> (Helper::internal(helper)) }
}

archive_target machine Helper::unrealized(helper: &Helper) -> u32
satisfies Value<Helper>::unrealized, Unused::read {
    transition { _ -> 19 }
}
reserved_target machine Helper::unrealized(helper: &Helper) -> u32
satisfies Value<Helper>::unrealized, Unused::read {
    transition { _ -> 23 }
}
archive_target machine Helper::cycle(helper: &Helper) -> u32 {
    transition { _ -> step(helper) }
    state step(helper: &Helper) -> u32 {
        transition { _ -> step(helper) }
    }
}

data Main { helper: Helper; hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.helper = Helper { seed: 7 };
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
