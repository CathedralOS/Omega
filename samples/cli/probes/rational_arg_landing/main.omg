// Anonymous comptime arithmetic is exact-rational; the
// same expression with a typed seed truncates at its
// carrier. The landing position decides which value the
// callee sees.
//
//   * `identity(7 / 2 * 2)` — anonymous rational: 7/2 is
//     exact 3.5, *2 lands at 7.
//   * `identity(7i32 / 2 * 2)` — typed i32: 7/2 truncates
//     to 3, *2 lands at 6.
//   * `(18446744073709551615 + 1) - 18446744073709551609`
//     — anonymous arithmetic wraps past u64::MAX exactly
//     and lands at 7.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine identity(value: i32) -> i32
ensures result == value
{
    value
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let anonymous: i32 = identity(7 / 2 * 2);
    let typed: i32 = identity(7i32 / 2 * 2);
    let wrapped: i32 = identity((18446744073709551615 + 1) - 18446744073709551609);
    transition anonymous == 7 && typed == 6 && wrapped == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
