// Const-generic data parameters: `data Buffer<const Size: u64>`,
// `data Flag<const Enabled: bool>`, and an ARRAY-typed const
// parameter `data Indexed<const Selected: [u64; 2]>`. Const
// initializers run full scalar evaluation — division, a `match`
// expression, comparisons.
//
//   * `const MATCH_SIZE = ((match true { true -> 7/2, ... }) * 2)`
//     — match inside a const initializer.
//   * `keep(value: Buffer<SIZE>) -> Buffer<7>` — identity across
//     two spellings of the same selected type.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

const SIZE: u64 = 7 / 2 * 2;
const MATCH_SIZE: u64 = ((match true { true -> 7 / 2, false -> 9 / 2 }) * 2) + 0u64;
const ENABLED: bool = SIZE == 7;
const SIZES: [u64; 2] = [SIZE, MATCH_SIZE];

data Buffer<const Size: u64> [copy] { value: [u8; Size]; }
data Flag<const Enabled: bool> [copy] { value: u8; }
data Indexed<const Selected: [u64; 2]> [copy] { value: u8; }

machine keep(value: Buffer<SIZE>) -> Buffer<7> { value }
machine selected(value: Flag<ENABLED>) -> Flag<true> { value }
machine read_match() -> u64 { MATCH_SIZE }

data Main {
    buf: Buffer<7>;
    flag: Flag<true>;
    indexed: Indexed<SIZES>;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.buf.value[0] = 65;
    main.flag.value = 2;
    main.indexed.value = 1;
    transition main.buf.value[0] == 65
        && keep(main.buf).value[0] == 65
        && selected(main.flag).value == 2
        && read_match() == 7
        && main.indexed.value == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
