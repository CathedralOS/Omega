// Wire `#N` tags combined with domain-qualified borrowed-slice
// members: `#1 label: &[u8] in Utf8` rides the referee slice, so the
// generated `encode` still emits the plain text-bytes frame — a
// length varint then the raw bytes. Members fill memberwise on a
// declared local: each store establishes its descriptor.
//
//   * `domain [u8]::Utf8 requires valid_utf8` — slice-carrier domain.
//   * `LabelMessage { #0 count: u32; #1 label: &[u8] in Utf8 }` —
//     wire tags beside a domain member.
//   * Frame for { count: 7, label: "hi" }: era 0x00, tag0 0x00,
//     0x07, tag1 0x01, len 0x02, 'h' 'i' — 7 bytes.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);

data LabelMessage {
    #0 count: u32;
    #1 label: &[u8] in Utf8;
}

data Main {
    buffer: [u8; 32];
    written: u64;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut msg: LabelMessage;
    msg.count = 7;
    msg.label = "hi";
    LabelMessage::encode(&msg, &mut main.buffer, &mut main.written);
    transition main.written == 7 && main.buffer[2] == 7 && main.buffer[4] == 2
        && main.buffer[5] == 104 && main.buffer[6] == 105 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
