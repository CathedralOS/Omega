// A sibling path dependency is resolved by its declared package name:
// `Build::dependency(builder, dependency::from_source(Source::Path { location: "dependency" }))`
// composes `query_dependency`; its machines import as
// `use query_dependency::value`.
machine build(builder: &mut Build) {
    Build::application(builder, "sibling_dep_queries");
    let dependency_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "dependency" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
