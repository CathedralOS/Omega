// The consumer imports the sibling package by declared name and
// checks its value contract from main.
use {query_dependency}/value.omg;
data Main {}
machine Main::main(main: @mutable Main) {
    _ = check();
}
machine check() -> u64 ensures result == 7 { |value|::value() }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
