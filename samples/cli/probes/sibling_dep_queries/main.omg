// The consumer imports the sibling package by declared name and
// checks its value contract from main.
use query_dependency::value;
data Main {}
machine Main::main(main: &mut Main) {
    _ = check();
}
machine check() -> u64 ensures result == 7 { value() }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
