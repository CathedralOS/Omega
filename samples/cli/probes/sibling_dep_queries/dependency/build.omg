// The dependency package's own build machine also runs: `choose`
// queries `BuildDeclarations::entry` for the windows entry spelling —
// entry inventory is a build-time observation, not a bound fact.
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Package { name: "query_dependency" };
    let entry: ProductEntryRef = choose(builder, "launch");
}
machine choose(builder: @mutable BuildPlan, path: @[u8]) -> ProductEntryRef {
    BuildDeclarations::entry(@builder.declarations, path, "windows_x86_64::ProgramEntry")
}
