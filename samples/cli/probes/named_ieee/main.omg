// Named IEEE operations on F32/F64: `negate` flips the sign of zero
// (1 / negate(0) is negative), `minimum`/`maximum` treat NaN
// asymmetrically (minimum(NaN, 1) is 1 but minimum(1, NaN) is NaN;
// minimum(0, -0) is -0 — the second operand of an equal pair), and
// `sqrt` rounds to nearest, ties to even.
//
//   * `F64::negate`, `F32::minimum`, `F64::maximum`, `F64::sqrt`,
//     `F32::sqrt` via core::float_operations (depend-free import).
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use omega::language::core::float_operations;

data Main {
    zero: f64;
    one: f64;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.zero = 0.0;
    main.one = 1.0;
    let neg_zero: f64 = F64::negate(0.0);
    let inv: f64 = 1.0 / neg_zero;
    let nan: f64 = main.zero / main.zero;
    let m1: f64 = F64::minimum(nan, main.one);
    let m2: f64 = F64::minimum(main.one, nan);
    let m3: f64 = F64::minimum(0.0, neg_zero);
    let x1: f64 = F64::maximum(neg_zero, 0.0);
    let r64: f64 = F64::square_root(2.0);
    let r32: f32 = F32::square_root(2.0f32);
    transition inv < 0.0 && m1 == 1.0 && m2 != m2 && m3 == neg_zero && x1 == 0.0
        && r64 > 1.4142135623730950 && r64 < 1.4142135623730952
        && r32 > 1.4142135f32 && r32 < 1.4142136f32 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
