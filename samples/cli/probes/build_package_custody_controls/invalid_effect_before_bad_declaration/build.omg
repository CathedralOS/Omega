// The Build stages a marker before requesting a missing package. Neither a
// successful Product nor the marker can be published by the failed Build.

use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_effect_before_bad_declaration" };
    mark(builder);
    let mutable missing_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "missing_package" });
    |dependency|::with_alias(@mutable missing_dependency, "missing");
    _ = |dependency|::add(builder, missing_dependency);
}

machine mark(builder: @mutable BuildPlan) {
    let path: BuildPath = BuildOutput::resolve(@builder.output, "must_not_exist.txt");
    let writer: i32 = BuildOutput::create(@mutable builder.output, path, 0);
    _ = BuildOutput::write(@mutable builder.output, writer, "this effect must never stage\n");
    _ = BuildOutput::close(@mutable builder.output, writer);
}
