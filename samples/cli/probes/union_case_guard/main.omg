data Command { case None; case Quit; case Move(dx: i32); case Say(volume: i32); }
data Main { cmd: Command; hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.cmd = Command::Move { dx: 2 };
    transition (main.cmd in Command::Quit | Command::Move) {
        (true) -> moving(main)
        _ -> silent(main)
    }
    state moving(main: &mut Main) {
        main.hits = main.hits + 1;
        transition (main.cmd in Command::None | Command::Say) {
            (true) -> silent(main)
            _ -> checked(main)
        }
    }
    state checked(main: &mut Main) { let value: i32 = (main.hits + 11) as i32; }
    state silent(main: &mut Main) { let value: i32 = 0; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
