// Expected exit: 0
use m/value-cell.omg as cell;
use m/b.omg;
use {omega}/language/core/numeric_conversion.omg as numeric;

data Read = machine(value: |cell|::A) -> i32 reaches none crashes none;
data Reader { read: Read; }

// Three distinct owners can share the name cell.
data cell { case Stored; case Supplied; }

machine select_read(cell: Reader, kind: cell) -> Read {
    transition kind {
        cell::Stored -> |cell|::read,
        cell::Supplied -> cell.read
    }
}

machine supplied(value: |cell|::A) -> i32 { 9 }

machine result() -> i32 {
    let item: |b|::B = |b|::B { value: |cell|::A { value: 7 } };
    let cell: Reader = Reader { read: supplied };
    let stored: Read = select_read(cell, cell::Stored);
    transition cell.read(item.value) == 9 && |numeric|::widen_u8_to_u32(7u8) == 7 {
        true -> stored(item.value),
        false -> 0
    }
}

machine main() crashes Trap {
    transition result() == 7 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
