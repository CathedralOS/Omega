// A data `where` roster carries STANDING field facts: `k <= 3` holds
// for every `main` value at every point, so `main.arr[main.k + 1]`
// compiles with no guard — the index is proven in-range from the
// declared bound alone (2 + 1 <= 3 < 5), and the fact survives the
// transition into `successor`.
//
//   * `data Main where 0 <= k, k <= 3 { ... }` — field fact roster.
//   * `main.arr[main.k + 1]` — computed index discharged by the
//     standing bound, twice (entry and a later state).
//   * `transition { _ -> successor(main) }` — bodyless transition =
//     unconditional goto.
//   * `[i32 in Wrapping; 5]` — element-domain array field.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Main where 0 <= k, k <= 3 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = main.arr[main.k + 1];
    transition { _ -> successor(main) }

    state successor(main: &mut Main) {
        main.r = main.arr[main.k + 1];
        main.hits = main.r;
    }
}
