// Gated type constructs through a proving literal:
// `Player { health: 50 }` satisfies the two-clause gate
// `health >= 1 && health <= 100` — construction is the
// gate, and the proven record's field reads open
// afterward. (A provisioned entry context must be valid at
// zero, so gated records can't be carrier fields — the
// Player is an ordinary local.)
//
//   * `data Player where health >= 1, health <= 100,`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Player
where
    health >= 1,
    health <= 100,
{
    health: i32;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let champion: Player = Player { health: 50 };
    let strength: i32 = champion.health;
    transition strength == 50 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
