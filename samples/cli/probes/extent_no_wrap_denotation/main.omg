// `core::extent` supplies `no_wrap(base, length)` — an
// address-arithmetic denotation usable directly as a
// machine `requires`. The caller must prove base + length
// does not wrap the address space.
//
//   * `machine geometry(base: addr, length: u64)
//     requires no_wrap(base, length)` — denotation
//     requires on raw address + extent params.
//   * `forwarded` carries the same requires and its call
//     discharges by contract forwarding.
//   * Learning: `no_wrap` is a proof-only mathematical
//     term — it cannot be a transition subject ("cannot
//     be used as executable values or statements") and
//     literal arguments cannot reach it at all (addr vs
//     u64 mathematical-application mismatch); only a
//     caller's own requires/domain guarantee discharges
//     the callee's clause.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::extent;

machine geometry(base: addr, length: u64)
requires no_wrap(base, length);
{}

machine forwarded(base: addr, length: u64)
requires no_wrap(base, length)
{
    geometry(base, length);
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) { main.hits = 1; }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
