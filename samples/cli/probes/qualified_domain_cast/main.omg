// Adding Marked preserves the underlying u32. Removing it exposes that
// scalar again for the comparison.

domain u32::Marked;

machine entry_start() crashes Trap {
    let value: u32 = 42u32;
    let marked: u32 in Marked = value as +Marked;
    transition (marked as -Marked) == 42u32 {
        true -> pass(),
        _ -> fail()
    }
    machine pass() {}
    machine fail() crashes Trap { crash Trap; }
}
