// Expected exit: 0
// Build selects one implementation of the same requirement for each hosted target.
boundary trait PlatformProbe {
    machine probe() -> i32 reaches none crashes none;
}

LinuxX86 satisfies PlatformProbe { machine probe() -> i32 { 86 } }
LinuxArm satisfies PlatformProbe { machine probe() -> i32 { 64 } }
MacArm satisfies PlatformProbe { machine probe() -> i32 { 14 } }
WindowsX86 satisfies PlatformProbe { machine probe() -> i32 { 32 } }

machine check_probe(expected: i32) crashes Trap {
    transition PlatformProbe::probe() == expected {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

machine entry_linux_x86_64() crashes Trap { check_probe(86); }
machine entry_linux_arm64() crashes Trap { check_probe(64); }
machine entry_macos_arm64() crashes Trap { check_probe(14); }
machine entry_windows_x86_64() crashes Trap { check_probe(32); }
