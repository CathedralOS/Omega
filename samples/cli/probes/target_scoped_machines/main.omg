// Target-scoped machine bodies: `linux_x86_64 machine` and friends
// prefix a machine body with a target identity — Psi checks every
// target-scoped body in every compilation; `--target` only narrows
// realization. An untargeted body exists beside the scoped ones.
//
//   * `linux_x86_64 machine probe() -> i32` — target-prefixed body.
//   * Sibling bodies for the other bundled targets.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

boundary trait SelectedProbe {
    machine probe() -> i32 reaches
;
}
LinuxX8664Probe satisfies SelectedProbe {
    machine probe() -> i32
{ 86 }
}
LinuxArm64Probe satisfies SelectedProbe {
    machine probe() -> i32
{ 64 }
}
MacosArm64Probe satisfies SelectedProbe {
    machine probe() -> i32
{ 14 }
}
WindowsX8664Probe satisfies SelectedProbe {
    machine probe() -> i32
{ 32 }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition SelectedProbe::probe() > 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
