machine build(builder: @mutable Build) {
    Build::application(builder, "target_scoped_machines");
    Build::select_provider::<PlatformProbe, LinuxX86>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_linux_x86_64);
    Build::select_provider::<PlatformProbe, LinuxArm>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_linux_arm64);
    Build::select_provider::<PlatformProbe, MacArm>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_macos_arm64);
    Build::select_provider::<PlatformProbe, WindowsX86>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_windows_x86_64);
}
