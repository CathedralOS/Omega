machine build(builder: &mut Build) {
    Build::select_provider<SelectedProbe, LinuxX8664Probe>(builder, linux_x86_64);
    Build::select_provider<SelectedProbe, LinuxArm64Probe>(builder, linux_arm64);
    Build::select_provider<SelectedProbe, MacosArm64Probe>(builder, macos_arm64);
    Build::select_provider<SelectedProbe, WindowsX8664Probe>(builder, windows_x86_64);

    Build::application(builder, "target_scoped_machines");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
