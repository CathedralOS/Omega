use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::select_provider<SelectedImportBinding, CheckedImportBinding>(builder, macos_arm64);

    Build::application(builder, "foreign_binding_forms");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);

 Build::bind<Mixed::via_syscall>(builder, macos_arm64, ForeignBinding::Syscall { number: 1 });
 Build::bind<Mixed::via_import>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_exit",
        },
    });

 Build::bind_vtable_field<Mixed::via_vtable, NativeTable::via_vtable>(builder, macos_arm64);
}
