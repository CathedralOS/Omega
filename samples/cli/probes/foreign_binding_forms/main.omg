// External leaf binding forms: each boundary-trait method
// binds one mechanism from the closed `ForeignBinding`
// sum — `Syscall(n)`, an evaluated typed `DllImport`
// locator returned by a provider machine
// (`ForeignBinding<17, 5, 0>` const-generic result), and a
// named `VtableField(field)` — target-scoped to
// macos_arm64, checked every compile.
//
//   * `satisfies Mixed::via_import via SelectedImportBinding::import_binding()`
//     — a machine call as the via-target (evaluated
//     binding, not a literal).
//   * `data NativeTable { reserved0: addr; ...;
//     via_vtable: addr; }` — addr-typed vtable layout.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::external_binding;

boundary trait Mixed {
    machine via_syscall() reaches Mixed;
    machine via_import() reaches Mixed;
    machine via_vtable() reaches Mixed;
}


boundary trait SelectedImportBinding {
    machine import_binding() -> ForeignBinding<17, 5, 0> reaches
;
}
CheckedImportBinding satisfies SelectedImportBinding {
    machine import_binding() -> ForeignBinding<17, 5, 0>
{
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_exit",
        },
    }
}
}


data NativeTable { reserved0: addr; reserved1: addr; via_vtable: addr; }


data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
