// Build behavior exclusions: `exclude_physical_authority` selects from
// the closed authority vocabulary and `exclude_crash` from the crash
// vocabulary. Repeating the same case is legal — exclusions are
// admission requirements over the selected composition, idempotent
// under repetition.

machine build(builder: &mut Build) {
    Build::application(builder, "build_exclusions");
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::FilesystemContentRead);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::FilesystemContentWrite);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::FilesystemMetadataQuery);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::DirectoryEnumeration);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::FilesystemNamespaceMutation);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::FilesystemMetadataMutation);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::ProcessOutput);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::ProcessTermination);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::MachineControl);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::PortIo);
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::exclude_crash(builder, CrashCause::Abort);
    Build::exclude_crash(builder, CrashCause::Trap);
    builder.freestanding = true;
}
