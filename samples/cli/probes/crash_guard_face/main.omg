// Crash-route guard faces: `crashes Trap <face>` declares the crash
// boundary on a member or scalar projection — the verifier reads the
// face as the route's terminal meaning.
//
//   * `machine member_guarded(flags: CrashFlags) -> bool ... crashes
//     Trap flags.dangerous` — member-expression crash face.
//   * `machine scalar_guarded(flag: bool) ... crashes Trap flag` —
//     scalar crash face.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data CrashFlags {
    dangerous: bool;
}

machine member_guarded(flags: CrashFlags) -> bool
requires true == true
crashes Trap
    flags.dangerous
{
    transition flags.dangerous {
        true -> member_fail()
        _ -> member_succeed()
    }
    machine member_fail() -> bool { crash Trap; }
    machine member_succeed() -> bool { false }
}

machine scalar_guarded(flag: bool) -> bool
crashes Trap
    flag
{
    transition flag {
        true -> scalar_fail()
        _ -> scalar_succeed()
    }
    machine scalar_fail() -> bool { crash Trap; }
    machine scalar_succeed() -> bool { false }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition member_guarded(CrashFlags { dangerous: false }) == false
        && scalar_guarded(false) == false {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
