// A lifetime-parametrized view selects which input the
// result retains: `select<'left, 'right>` returns
// `View<'left>` holding only `first`, so `second`
// stays independently usable after the call.
//
//   * `data View<'buf> { body: &'buf mut i32 }` —
//     erased lifetime argument on borrow-carrying data.
//   * `first: &'left mut i32` / `second: &'right mut
//     i32` — two sources, the result keeps `'left`.
//   * `second = 1` writes through the unretained loan
//     while `selected.body` is live.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data View<'buf> {
    body: &'buf mut i32;
}

machine select<'left, 'right>(
    first: &'left mut i32,
    second: &'right i32
) -> View<'left> {
    let selected: View<'left> = View { body: first };
    transition {
        _ -> selected
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut first: i32 = 0;
    let second: i32 = 9;
    let selected: View = select(&mut first, &second);
    selected.body = 7;
    let kept: i32 = second;
    transition first == 7 && kept == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
