// A lifetime-parametrized view selects which input the
// result retains: `select<'left, 'right>` returns
// `View<'left>` holding only `first`, so `second`
// stays independently usable after the call.
//
//   * `data View<'buf> { body: &'buf mutable i32 }` —
//     erased lifetime argument on borrow-carrying data.
//   * `first: &'left mutable i32` / `second: &'right mutable
//     i32` — two sources, the result keeps `'left`.
//   * `second = 1` writes through the unretained loan
//     while `selected.body` is live.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data View<'buf> {
    body: @'buf mutable i32;
}

machine select<'left, 'right>(
    first: @'left mutable i32,
    second: @'right i32
) -> View<'left> {
    let selected: View<'left> = View { body: first };
    transition {
        _ -> selected
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let mutable first: i32 = 0;
    let second: i32 = 9;
    let mutable selected: View = select(@mutable first, @second);
    selected.body = 7;
    let kept: i32 = second;
    transition first == 7 && kept == 9 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
