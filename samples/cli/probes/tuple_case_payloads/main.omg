// Tuple case patterns bind payloads from more than one subject and
// keep the names in scope for the arm target — two same-named
// payload fields destructure under distinct `as` aliases. The arms
// remain Cartesian-exhaustive without a `_`.
//
//   * `(Cell::Value { n as left_n }, Cell::Value { n as right_n })`
//     — per-subject payload destructuring with rename.
//   * The remaining three (Value,Empty / Empty,Value / Empty,Empty)
//     matrix cells spell out.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Cell {
    case Empty;
    case Value(n: i32);
}

data Main {
    left: Cell;
    right: Cell;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.left = Cell::Value { n: 30 };
    main.right = Cell::Value { n: 40 };
    transition (main.left, main.right) {
        (Cell::Value { n as left_n }, Cell::Value { n as right_n }) -> sum(main, left_n, right_n)
        (Cell::Value { n as left_n }, Cell::Empty) -> wrong(main)
        (Cell::Empty, Cell::Value { n as right_n }) -> wrong(main)
        (Cell::Empty, Cell::Empty) -> wrong(main)
    }
    state sum(main: &mut Main, left_n: i32, right_n: i32) {
        transition left_n == 30 && right_n == 40 {
            true -> pass(main)
            _ -> wrong(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state wrong(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
