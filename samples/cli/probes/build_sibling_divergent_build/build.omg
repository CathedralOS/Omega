// Convergent pool: three product siblings whose builds each edge-pool on
// the shared dep and call `shared::main`'s `seed()` in build scope.
// Controls beside this sample interleave divergent siblings into the pool.

machine build(builder: &mut Build) {
    Build::application(builder, "build_sibling_divergent_build");
    Build::depend_as(builder, "a", Source::Path { location: "sibling_a" });
    Build::depend_as(builder, "c", Source::Path { location: "sibling_c" });
    Build::depend_as(builder, "e", Source::Path { location: "sibling_e" });
    builder.freestanding = true;
}
