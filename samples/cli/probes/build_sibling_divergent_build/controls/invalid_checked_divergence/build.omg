// A divergent sibling interleaved into the pooled check: sibling_bad2's
// build source calls `ghost_machine()`, which does not exist. The
// question is whether the checked-compilation diagnostic inside a dep's
// build file names the dep or the requesting package.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_checked_divergence");
    Build::depend_as(builder, "a", Source::Path { location: "../../sibling_a" });
    Build::depend_as(builder, "bad2", Source::Path { location: "../../sibling_bad2" });
    Build::depend_as(builder, "c", Source::Path { location: "../../sibling_c" });
    builder.freestanding = true;
}
