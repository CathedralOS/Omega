// A divergent sibling interleaved into the pooled check: sibling_bad2's
// build source calls `ghost_machine()`, which does not exist. The
// question is whether the checked-compilation diagnostic inside a dep's
// build file names the dep or the requesting package.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_checked_divergence");
    let mut a_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../sibling_a" });
    dependency::with_alias(&mut a_dependency, "a");
    let a_registration: DependencyRegistration = Build::dependency(builder, a_dependency);
    let mut bad2_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../sibling_bad2" });
    dependency::with_alias(&mut bad2_dependency, "bad2");
    let bad2_registration: DependencyRegistration = Build::dependency(builder, bad2_dependency);
    let mut c_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../sibling_c" });
    dependency::with_alias(&mut c_dependency, "c");
    let c_registration: DependencyRegistration = Build::dependency(builder, c_dependency);
    builder.freestanding = true;
}
