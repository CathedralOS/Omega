use {omega}/build/dependency.omg;
use {shared}/main.omg as shared;

machine build(builder: @mutable BuildPlan)
suspends
{
    builder.product = BuildProduct::Package { name: "sibling_c" };
    let mutable shared_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../shared" });
    |dependency|::with_alias(@mutable shared_dependency, "shared");
    let shared_registration: DependencyRegistration = Build::build_dependency(builder, shared_dependency);
    suspend Build::prepare_dependency(builder, shared_registration);
    let observed: i32 = |shared|::seed();
    transition observed == 3 {
        true -> done(),
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
