// Declared-name-vs-occurrence probe: the directory and the requesting
// alias say `sibling_declared`, but the build declares `declared_else`
// and then retires its obligation with a sticky failure. Whichever name
// the diagnostic prints pins the attribution identity the evaluator uses.

machine build(builder: &mut Build) {
    Build::package(builder, "declared_else");
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "ghost.txt");
    BuildOutput::fail(&mut builder.output, obligation, "declared-name probe");
}
