use shared::main;

machine build(builder: &mut Build) {
    Build::package(builder, "sibling_a");
    Build::build_depend_as(builder, "shared", Source::Path { location: "../shared" });
    let observed: i32 = seed();
    transition observed == 3 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
