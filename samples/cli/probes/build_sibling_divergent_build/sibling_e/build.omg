use shared::main;

machine build(builder: &mut Build) {
    Build::package(builder, "sibling_e");
    let mut shared_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../shared" });
    dependency::with_alias(&mut shared_dependency, "shared");
    let shared_registration: DependencyRegistration = Build::build_dependency(builder, shared_dependency);
    let observed: i32 = seed();
    transition observed == 3 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
