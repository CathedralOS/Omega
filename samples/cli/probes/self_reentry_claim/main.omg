// Linear claims survive state-cycle backedges: `spin` reenters
// its own entry holding the receipt its caller passed in until
// its count runs out — each iteration's entry claim continues
// the claim the arriving backedge carries.
//
//   * `spin(receipt, left)` self-reentry with decremented count.
//   * Final edge hands the claim to `consume`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine spin(receipt: Receipt, left: i32) -> i32 {
    transition left > 0 {
        true -> spin(receipt, left - 1)
        _ -> finish(receipt)
    }

    state finish(receipt: Receipt) -> i32 {
        consume(receipt)
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let receipt: Receipt = Receipt { code: 7 };
    let total: i32 = spin(receipt, 3);
    transition total == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
