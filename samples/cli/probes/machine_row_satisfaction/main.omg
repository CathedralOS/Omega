// `register<const Selected: Handler::call>` accepts a machine that
// satisfies the named requirement. `register::<chosen>` selects one.
trait Handler {
    machine call(value: i32) -> i32;
}
machine chosen(value: i32) -> i32
satisfies Handler::call
{
    value
}
machine register<const Selected: Handler::call>(value: i32) -> i32
{
    Selected(value)
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: @mutable Main) {
    let v: i32 = register::<chosen>(4);
    main.hits = main.hits + (v as +Wrapping);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
