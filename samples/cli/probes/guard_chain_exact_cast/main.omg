// Exact narrowing proved by a two-hop guard chain: a
// `requires` interval discharges `value as u8` directly,
// and sequential transitions `value >= 0` then
// `value <= 255` accumulate the same proof across state
// hops.
//
//   * `machine narrow(value: i32) -> u8 requires
//     0 <= value && value <= 255 { value as u8 }` —
//     declared range proves the narrowing cast.
//   * `-> (0)` — parenthesized expression as a transition
//     arm result (not a state destination).
//   * `value as i32` widening from i8 is always exact.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine narrow(value: i32) -> u8
requires 0 <= value && value <= 255
{
    value as u8
}

machine widen(value: i8) -> i32 {
    value as i32
}

machine two_hop(value: i32) -> u8 {
    transition value >= 0 {
        true -> upper(value)
        _ -> (0)
    }
    state upper(value: i32) -> u8 {
        transition value <= 255 {
            true -> (value as u8)
            _ -> (0)
        }
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let narrowed: u8 = narrow(200);
    let chained: u8 = two_hop(200);
    let widened: i32 = widen(-5i8);
    transition narrowed == 200 && chained == 200 && widened == -5 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
