// Result ensures pinned to the selected arithmetic meaning:
// exact `3u8 + 4u8`, wrapped `255 + 2 = 1`, saturated `255 + 2 =
// 255`, and the chained wrapped-subtract-then-shift
// `((0 - 2) >> 1) = 127` — each `as` recast picks its carrier's
// policy into the ensures evaluation.
machine exact_sum() -> u8
ensures result == 7
{ 3u8 + 4u8 }
machine wrapped_sum() -> u8
ensures result == 1
{ ((255u8 as u8 in Wrapping) + 2) as u8 }
machine saturated_sum() -> u8
ensures result == 255
{ ((255u8 as u8 in Saturating) + 2) as u8 }
machine wrapped_operand() -> u8
ensures result == 127
{ (((0u8 as u8 in Wrapping) - 2) >> 1) as u8 }

data Main {}
machine Main::main(main: &mut Main) {
    let a: u8 = exact_sum();
    let b: u8 = wrapped_sum();
    let c: u8 = saturated_sum();
    let d: u8 = wrapped_operand();
}
