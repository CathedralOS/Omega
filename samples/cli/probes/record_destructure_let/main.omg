// Record patterns in let position:
// `let { x, y as vertical, z as _ } = main.point;` —
// exhaustive by law, `as` renames, `as _` waives a field.
// Ranged fields keep the exact-arithmetic discharge.
//
//   * `data Point where 0 <= x, x <= 100, ...` — standing
//     field bounds on a gate-guarded record.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Point
where
    0 <= x,
    x <= 100,
    0 <= y,
    y <= 100,
    0 <= z,
    z <= 100,
{
    x: i32;
    y: i32;
    z: i32;
}

data Main {
    point: Point;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.point = Point { x: 30, y: 40, z: 5 };
    let { x, y as vertical, z as _ } = main.point;
    let total: i32 = x + vertical;
    transition total == 70 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
