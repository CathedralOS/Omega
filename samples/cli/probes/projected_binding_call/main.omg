// Projected requirement receivers: `Settlement::settle(...)` is the
// static provider slot's requirement application; the two former
// carrier spellings — a nested field path and a machine-parameter
// reference — are both gone, and the same requirement roster
// (`reaches Settlement`) admits the call either way.
//
//   * `public boundary trait Settlement` + `Settler satisfies Settlement`
//     (impl consumes the linear receipt via `drop`).
//   * `reaches Settlement` on forwarding machines.
//
// Compile-checked only: no standard-library dependency.

use omega::language::core::drop;

public data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

public boundary trait Settlement {
    machine settle(prefix: i32, receipt: Receipt, suffix: i32) -> i32 reaches;
}

Settler satisfies Settlement {
    machine settle(prefix: i32, receipt: Receipt, suffix: i32) -> i32 {
        let code: i32 = receipt.code;
        drop(receipt);
        (((prefix as i32 in Wrapping) + (code as i32 in Wrapping)) + (suffix as i32 in Wrapping)) as i32
    }
}

machine forward(prefix: i32, receipt: Receipt, suffix: i32) -> i32 reaches Settlement {
    ((Settlement::settle(prefix, receipt, suffix) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32
}

machine direct(receipt: Receipt) -> i32 reaches Settlement {
    ((Settlement::settle(2, receipt, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}
