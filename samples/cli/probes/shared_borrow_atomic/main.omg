// Atomic ops mutate an AtomicU32 through a SHARED `&Cell` borrow — no
// ordinary-write grant on the enclosing record is needed.
data Cell { value: AtomicU32; }
machine Cell::publish(cell: &Cell, value: u32) {
    cell.value.store(value, Publish);
}
machine Cell::mark(cell: &Cell, bits: u32) -> u32 {
    let prior: u32 = cell.value.fetch_or(bits, ReceivePublish);
    transition { _ -> (prior) }
}
data Main { cell: Cell; }
machine Main::main(main: &mut Main) {
    Cell::publish(&main.cell, 10);
    let prior: u32 = Cell::mark(&main.cell, 5);
    transition prior == 10 {
        true -> done(main)
        false -> bad(main)
    }
    machine done(main: &mut Main) { }
    machine bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
