// projected_write: write-only projected receivers — the first sample
// passing `&write` borrows aimed INSIDE an aggregate through calls.
//
//   * `forward(&mut main.pair, -43)` takes a mutable receiver and
//     projects it: `&write pair.right` addresses the right Cell directly,
//     a write-only borrow of a field-of-field.
//   * The projected `&write cell` forwards through two relay states and
//     lands in `Cell::replace(cell: &write Cell, ...)` — each hop keeps
//     the write-only capability; reads of the borrowed cell never occur.
//   * `main.pair.left` is written directly through `main` — the mutable
//     entry carrier — and left untouched by the projection.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Cell [copy] { padding: i64; value: i64; }
data Pair [copy] { left: Cell; right: Cell; }
data Main { pair: Pair; }

machine Cell::replace(cell: &write Cell, value: i64) {
    cell.value = value;
}

machine forward(pair: &mut Pair, value: i64) {
    transition { _ -> relay(&write pair.right, value) }

    machine relay(cell: &write Cell, value: i64) {
        transition { _ -> store(&write cell, value) }
    }

    machine store(cell: &write Cell, value: i64) {
        Cell::replace(&write cell, value);
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.pair.left.padding = 11;
    main.pair.left.value = 17;
    main.pair.right.padding = 23;
    main.pair.right.value = 29;
    forward(&mut main.pair, -43);
    transition main.pair.left.value == 17 && main.pair.right.value == -43 {
        true -> done()
        _ -> bad()
    }

    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
