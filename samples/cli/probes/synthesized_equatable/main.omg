// synthesized_equatable: trait declarations and named implementations as
// sample code — the first sample declaring a `trait`, satisfying it with
// an EMPTY named implementation (which receives a synthesized structural
// `equals` row), and overriding synthesis with an authored body.
//
//   * `PointEquality satisfies Equatable<Point> { }` — the empty
//     implementation synthesizes field-by-field equality, so `==`/`!=`
//     on Point is legal and `PointEquality::equals` selects the same row.
//   * `OverrideEquality satisfies Equatable<Token> { machine equals ... }` —
//     the authored member overrides synthesis, so `==` on Token calls
//     the body (which always returns false, even for identical tokens).
//
// The machine verifies both faces on both types: equal points compare
// true and unequal ones false (operator AND callable), while two identical
// tokens compare false through the override. Compile-checked only: no
// standard-library dependency, no ProcessExit provider.
trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Point {
    x: i32;
    y: i32;
}

PointEquality satisfies Equatable<Point> { }

data Token {
    value: i32;
}

OverrideEquality satisfies Equatable<Token> {
    machine equals(left: &Token, right: &Token) -> bool {
        false
    }
}

machine synthesized_equatable() {
    let a: Point = Point { x: 3, y: 7 };
    let b: Point = Point { x: 3, y: 7 };
    let c: Point = Point { x: 3, y: 9 };
    transition a == b {
        true -> check_unequal(a, c)
        _ -> done(71)
    }

    machine check_unequal(a: Point, c: Point) {
        transition a != c {
            true -> check_callable(a, c)
            _ -> done(72)
        }
    }

    machine check_callable(a: Point, c: Point) {
        let callable: bool = PointEquality::equals(&a, &c);
        transition !callable {
            true -> check_override()
            _ -> done(73)
        }
    }

    machine check_override {
        let t1: Token = Token { value: 5 };
        let t2: Token = Token { value: 5 };
        transition t1 != t2 {
            true -> done(70)
            _ -> done(74)
        }
    }

    machine done(code: i32) {}
}
