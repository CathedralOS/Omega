use {omega}/build/dependency.omg;
use omega\language\core\ProgramImage;

machine build(builder: @mutable Build) suspends {
    Build::application(builder, "provider_readiness_replacement");
    let mutable backing_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../provider_readiness/backing" });
    |dependency|::with_alias(@mutable backing_dependency, "backing");
    let backing_registration: DependencyRegistration = Build::build_dependency(builder, backing_dependency);
    suspend Build::await_provider::<ProgramImage, backing\TestImage>(builder);
    suspend Build::await_provider::<ProgramImage, backing\OtherImage>(builder);
}
