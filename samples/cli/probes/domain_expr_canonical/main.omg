const SIZE: u64 = 1;
domain<T, const N: u64> T::Indexed<N>;
data Root {
    named: u64 in Indexed<SIZE>;
    same: u64 in Indexed<SIZE + 0>;
    next: u64 in Indexed<SIZE + 1>;
}
machine copy(named: u64 in Indexed<SIZE>) -> u64 in Indexed<SIZE + 0> { named }
machine forward(next: u64 in Indexed<SIZE + 1>) -> u64 in Indexed<2> { next }
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
