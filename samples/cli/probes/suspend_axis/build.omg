machine build(builder: &mut Build) {
    Build::application(builder, "suspend_axis");
    Build::select_provider<Scheduler, InlineScheduler>(builder, linux_arm64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, linux_x86_64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, macos_arm64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, macos_x86_64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, windows_x86_64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, uefi_x86_64);
    Build::select_provider<Scheduler, InlineScheduler>(builder, cross_platform_cli);
    Build::select_provider<Scheduler, InlineScheduler>(builder, local_unchecked);
    Build::select_provider<Scheduler, InlineScheduler>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
