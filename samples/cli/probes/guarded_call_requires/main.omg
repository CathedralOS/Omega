// Incoming-arm guards discharge callee `requires`: the
// dominating `transition main.a <= main.b { true -> go }`
// establishes the fact on every edge into `go`, so
// `helper`'s `requires main.a <= main.b` (a carrier-field
// read at the call site) AND `bounded(b)'s`
// `requires param <= 9`-style dependent argument prove at
// the call. Inside `helper` the same requires then proves
// the exact subtraction.
//
//   * `machine helper(main: &mut Main) requires
//     main.a <= main.b` — requires clause reading caller
//     fields.
//   * `machine bounded(param: u32) requires param <= 9` —
//     argument-side dependent requires.
//
// Guard-then-write before the call refuses; the unguarded
// caller refuses (fail siblings cover both).
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main {
    a: u32;
    b: u32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.a = 3;
    main.b = 9;
    transition main.a <= main.b {
        true -> go(main)
        _ -> bad(main)
    }
    state go(main: &mut Main) {
        let a_value: u32 = main.a;
        Main::helper(main, a_value);
        let diff: u32 = main.b - main.a;
        transition diff == 6 {
            true -> pass(main)
            _ -> bad(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state bad(main: &mut Main) { main.hits = -1; }
}

machine Main::helper(main: &mut Main, scalar: u32)
requires
    main.a <= main.b,
{
    let remainder: u32 = main.b - main.a;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
