use main/assertions.omg;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Package { name: "assert_kit" };
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, linux_arm64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, linux_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, macos_arm64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, macos_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, windows_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, uefi_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, cross_platform_cli);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, local_unchecked);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, alpha_bootstrap);
}
