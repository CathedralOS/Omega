// The entry keeps the requirement's public Trap allowance; the build
// decides whether the composed product may actually trap.
use {assert_kit}/main/assertions.omg;
data Main {
}
machine Main::main(main: @mutable Main)
reaches |assertions|::Assert
crashes Trap
{
    |assertions|::Assert::check(1 == 1);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches |assertions|::Assert
crashes Trap
{
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
