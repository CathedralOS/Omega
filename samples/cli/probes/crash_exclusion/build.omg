use main.omg as product;
// Trap is excluded from the product while the selected assertion
// provider is the no-op implementation, so no composed path can trap:
// `Build::select_provider::<|assertions|::Assert,
// |assertions|::NoOpAssert>` + `Optimizations::enable(...
// ControlFlowCleanup)` + `Build::exclude_crash(builder,
// CrashCause::Trap)` — the optional optimization does not decide the
// verdict.
use {assert_kit}/main/assertions.omg;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "crash_exclusion" };
    let assert_kit_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "assert-kit" }));
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, linux_arm64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, linux_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, macos_arm64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, macos_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, windows_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, uefi_x86_64);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, cross_platform_cli);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, local_unchecked);
    Build::select_provider::<|assertions|::Assert, |assertions|::NoOpAssert>(builder, alpha_bootstrap);
    Optimizations::enable(@mutable builder.optimizations, Optimization::ControlFlowCleanup);
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::bind(builder, linux_x86_64::ProgramEntry, |product|::entry_start);
}
