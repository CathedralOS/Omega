// Trap is excluded from the product while the selected assertion
// provider is the no-op implementation, so no composed path can trap:
// `Build::select_provider<assert_kit::main::Assert,
// assert_kit::main::NoOpAssert>` + `Optimizations::enable(...
// ControlFlowCleanup)` + `Build::exclude_crash(builder,
// CrashCause::Trap)` — the optional optimization does not decide the
// verdict.
machine build(builder: &mut Build) {
    Build::application(builder, "crash_exclusion");
    Build::depend(builder, Source::Path { location: "assert-kit" });
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssert>(builder);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
