// Boundary byte-extent requirement discharged against the
// caller's sized storage: `count <= buffer.length` on
// `ByteHost::read` proves at `&mutable main.control` — the
// `[u8; 64]` extent resolves through the caller's attached
// data, and `pump(buffer: &mutable [u8])` re-proves the same length
// across the second boundary.
//
//   * `public boundary trait ByteHost` with `reaches ByteHost`
//     + `requires count <= buffer.length` roster.
//
// Compile-checked only: no provider selection at --check.


public boundary trait ByteHost {
    machine read(fd: i32, buffer: @mutable [u8], count: u64) -> i64 reaches ByteHost
    requires
        count <= buffer.length crashes none;
}

data Main {
    control: [u8; 64];
}

machine pump(buffer: @mutable [u8])
    requires 64 <= buffer.length
    reaches ByteHost
{
    let count: i64 = ByteHost::read(0, buffer, 64);
}

machine main() {}
