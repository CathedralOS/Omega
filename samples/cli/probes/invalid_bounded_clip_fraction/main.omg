// A lower bound alone does not prove a closed float range. `difference >= 0.5`
// still admits values above 8, so the arrival requirement `difference <= 8.0`
// stays unproved.
machine open_upper(start_distance: f64, end_distance: f64) -> f64 {
    let difference: f64 = start_distance - end_distance;
    transition difference >= 0.5 {
        true -> admit(difference)
        _ -> 0.0
    }
    machine admit(difference: f64) -> f64
        requires difference >= 0.5 && difference <= 8.0
    { difference }
}

machine main() {
    _ = open_upper(1.0, -1.0);
}
