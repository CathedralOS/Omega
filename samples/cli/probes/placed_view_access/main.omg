use omega::language::core::layout;
public data Registers { status: u32; transmit: u8; }
public data RegPlacement {}
machine RegPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 4 },
    };
    let mut services: [u64; 32];
    services[0] = 7;
    PlacementPlan {
        layout: Plan {
            entries: entries,
            entry_count: 2,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 4,
        },
        access: AccessPlan::with(
            AccessPlan::with(
                AccessPlan::inaccessible(&schema),
                schema.fields[0].key,
                FieldAccess::External {
                    read: ExternalRead::Read,
                    write: false,
                    exposure: Exposure::Exported,
                },
            ),
            schema.fields[1].key,
            FieldAccess::External {
                read: ExternalRead::None,
                write: true,
                exposure: Exposure::Exported,
            },
        ),
        reach: BoundaryReach {
            services: services,
            service_count: 0,
        },
    }
}
machine inspect(view: &mut Placed<RegPlacement, Registers>) -> u32 {
    view.transmit.write(&mut view.transmit, 9);
    view.status.read(&view.status)
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
