machine build(builder: &mut Build) {
    Build::application(builder, "invalid_nested_output");
    Build::artifact_only(builder);
    builder.freestanding = true;
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "bin/app");
    let path: BuildPath = BuildOutput::resolve(&builder.output, "bin/app");
    let writer: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, writer, "x");
    _ = BuildOutput::close(&mut builder.output, writer);
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, path);
}
