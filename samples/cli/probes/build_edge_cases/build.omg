// Builder configuration fields are writable on a `package` kind too
// — application-scoped selections compose inertly when the declared
// kind is a library package.
machine build(builder: &mut Build) {
    Build::package(builder, "edge_case_kernel");
    builder.freestanding = true;
    builder.subsystem = Subsystem::Gui;
    builder.identifier = "com.example.edge";
}
