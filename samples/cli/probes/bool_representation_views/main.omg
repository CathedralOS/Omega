// `bool` is ordinary typed storage with representation
// set {0, 1}: a shared `&u8` view forgets that fact, a
// byte whose `data where` fact bounds it to {0, 1}
// establishes a shared `&bool` view, and the mutable alias
// is legal when both sides preserve the same set.
//
//   * `&main.flag as &u8` — bool → byte shared view.
//   * `&main.byte as &bool` — byte's `where byte >= 0 &&
//     byte <= 1` fact proves the {0,1} set.
//   * `&mutable main.byte as &mutable bool` — mutable alias under
//     set preservation.
//
// (The revoked spelling aliased `&mutable u8 [0..=1]` — a
// local reference can't spell a range; the fail sibling
// pins that rejection.)
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main
requires
    byte >= 0 && byte <= 1,
{
    flag: bool;
    byte: u8;
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    main.flag = true;
    main.byte = 1;
    let flag_bits: @u8 = @main.flag as @u8;
    let byte_flag: @bool = @main.byte as @bool;
    transition $flag_bits == 1 && $byte_flag {
        true -> mutate(main),
        _ -> fail(main)
    }
    machine mutate(main: @mutable Main) {
        let byte_alias: @mutable bool = @mutable main.byte as @mutable bool;
        $byte_alias = false;
        transition main.byte == 0 {
            true -> pass(main),
            _ -> fail(main)
        }
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
