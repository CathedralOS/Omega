use {omega}/build/dependency.omg;
use omega\language\core\ProgramImage;

machine build(builder: @mutable BuildPlan) suspends {
    builder.product = BuildProduct::Application { name: "readiness_unadmitted" };
    let mutable backing_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "backing" });
    |dependency|::with_alias(@mutable backing_dependency, "backing");
    let backing_registration: DependencyRegistration = Build::build_dependency(builder, backing_dependency);
    suspend Build::await_provider::<ProgramImage, backing\Selected>(builder);
    let observed: addr = ProgramImage::retained_suffix_start();
}
