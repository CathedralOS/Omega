// The build program is an ordinary machine: transition arms inside
// `machine build` pick WHICH entry gets bound — the unselected arm's
// references never resolve (`missing` names no real machine).
machine build(builder: &mut Build) {
    Build::application(builder, "build_conditional_bind");
    choose_entry(builder, true);
}
machine choose_entry(options: &mut Build, enabled: bool) {
    transition {
        enabled -> selected(options)
        _ -> ignored(options)
    }
    state selected(options: &mut Build) {
        Build::bind(options, linux_x86_64::ProgramEntry, launch);
    }
    state ignored(options: &mut Build) {
        Build::bind(options, linux_x86_64::ProgramEntry, missing);
    }
}
