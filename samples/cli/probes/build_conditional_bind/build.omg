// The build program is an ordinary machine: transition arms inside
// `machine build` pick WHICH entry gets bound — the unselected arm's
// references never resolve (`missing` names no real machine).
use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_conditional_bind" };
    choose_entry(builder, true);
}
machine choose_entry(options: @mutable BuildPlan, enabled: bool) {
    transition {
        enabled -> selected(options),
        _ -> ignored(options)
    }
    machine selected(options: @mutable BuildPlan) {
        Build::bind(options, linux_x86_64::ProgramEntry, |app|::launch);
    }
    machine ignored(options: @mutable BuildPlan) {
        Build::bind(options, linux_x86_64::ProgramEntry, missing);
    }
}
