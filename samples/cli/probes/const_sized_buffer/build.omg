// const_sized_buffer build file: depend-free compile-scope probe — no
// standard-library package, so no ProcessExit authority; compile-checked
// only (same posture as cli/basics/standalone).

machine build(builder: &mut Build) {
    Build::application(builder, "const_sized_buffer");
    Build::bind(builder, windows_x86_64::ProgramEntry, const_sized_buffer);
    Build::bind(builder, linux_x86_64::ProgramEntry, const_sized_buffer);
    Build::bind(builder, linux_arm64::ProgramEntry, const_sized_buffer);
    Build::bind(builder, macos_arm64::ProgramEntry, const_sized_buffer);
}
