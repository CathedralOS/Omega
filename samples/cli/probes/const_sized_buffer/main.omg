// const_sized_buffer: compile-time machine evaluation as sample code —
// the first sample with a machine call in array-length position.
//
//   * `triangle` is a measured tail-recursive free machine: its requires
//     roster is the arrival invariant (independent bounds on n and acc
//     would admit a violating call), `terminates by n` proves the loop.
//   * `table_size()` const-evaluates `triangle(4, 0) == 10`; the call sits
//     in `[u8; table_size()]` — the array's length is the machine's
//     compile-time result.
//   * `Ledger {}` omits the array field: zero-fill supplies it, so
//     `ledger.buf[9] = 7` is the first legal write to the last slot.
//
// The machine writes slot 9, reads it back, and accepts when the slot is
// 7 and the table still measures 10. Compile-checked only: no
// standard-library dependency.
machine triangle(n: u64, acc: u64) -> u64
requires n <= 100, acc <= 5050,
    2 * acc + n * (n + 1) <= 10100;
terminates by n;
{
    transition n == 0 {
        true -> acc
        false -> triangle(n - 1, acc + n)
    }
}

machine table_size() -> u64 {
    let size: u64 = triangle(4, 0);
    transition { _ -> (size) }
}

data Ledger {
    buf: [u8; table_size()];
}

machine const_sized_buffer() {
    let mut ledger: Ledger = Ledger {};
    ledger.buf[9] = 7;
    transition ledger.buf[9] == 7 && table_size() == 10 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
