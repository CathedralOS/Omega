// Index 2 is outside the length-2 complex window.

data Complex [copy] { real: f64; imaginary: f64; }
data Held<'row> { cells: @'row mutable [Complex]; }

machine half<'row>(row: @'row mutable [Complex; 4], which: i64) -> @'row mutable [Complex]
ensures result.length == 2
{
    match which {
        0 -> @mutable row[0..2],
        _ -> @mutable row[2..4]
    }
}

machine main() {
    let mutable row: [Complex; 4] = [
        Complex { real: 1.0, imaginary: 0.5 },
        Complex { real: -1.0, imaginary: 0.25 },
        Complex { real: 3.0, imaginary: -2.0 },
        Complex { real: 4.0, imaginary: 8.0 }
    ];
    let view: @mutable [Complex] = half(@mutable row, 0);
    let mutable held: Held = Held { cells: view };
    transition held.cells.length == 2 {
        true -> observe(@mutable held),
        false -> done()
    }
    machine observe(held: @mutable Held) requires held.cells.length == 2 {
        let _past: Complex = held.cells[2];
    }
    machine done() {}
}
