// A domain-qualified leaf through a `&write` loan owes
// the membership check on the stored value: `&write
// [u8; 8] in Utf8` admits a whole-array store whose
// bytes discharge `valid_utf8` — the same check a
// `&mut` store performs, on a loan that cannot read.
//
//   * `domain [u8; 8]::Utf8 requires valid_utf8` — the
//     declared-membership predicate.
//   * `label: [u8; 8] in Utf8` field stored whole
//     through the write-only loan.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Tagged {
    label: [u8; 8] in Utf8;
}

machine retag(tagged: &write Tagged, label: [u8; 8] in Utf8) {
    tagged.label = label;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut tagged: Tagged;
    retag(&write tagged, "omega600");
    let copy: [u8; 8] = tagged.label;
    transition copy[0] == 111 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
