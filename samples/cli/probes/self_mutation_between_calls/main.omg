// Self-field mutation interleaved with value-returning calls that read
// from main.
//
// FRESH COMBINATION: a value-returning machine reads subject fields, and
// the subject is mutated BETWEEN sequential calls to that machine. Tests
// that each call observes the correct subject state (not a stale cached
// value).
//
// Machines:
//   scale(n) -> i32 = n * main.st.multiplier
//   offset_add(n) -> i32 = n + main.st.addend
//
// Script:
//   main.st.multiplier = 3
//   r1 = main.scale(5)        // = 5 * 3 = 15
//   main.st.multiplier = 7
//   r2 = main.scale(4)        // = 4 * 7 = 28
//   main.st.addend = 2
//   r3 = main.offset_add(10)  // = 10 + 2 = 12
//   main.st.addend = 15
//   r4 = main.offset_add(3)   // = 3 + 15 = 18
//
//   total = r1 + r2 + r3 + r4 - (15 + 28 + 12 + 18 - 70)
//         = 15 + 28 + 12 + 18 = 73 ... not 70.
//   Let's use: 15 + 28 + 12 + 18 - 3 = 70.
//   Or: r1 + r2 - r3 + r4 - (8) = 15 + 28 - 12 + 18 - 8 = 41. No.
//   Or: r1 + r2 + r3 + r4 = 73, not 70. Adjust:
//   main.st.multiplier=3, r1=scale(5)=15
//   main.st.multiplier=7, r2=scale(4)=28
//   main.st.addend=2, r3=offset_add(10)=12
//   main.st.addend=15, r4=offset_add(2)=17  (changed arg)
//   total = r1 + r2 + r3 + r4 = 15+28+12+17=72. No.
//   main.st.addend=15, r4=offset_add(1)=16
//   total = 15+28+12+16=71. No.
//   main.st.addend=15, r4=offset_add(0)=15
//   total = 15+28+12+15=70.
//
// Checks (exit on first wrong):
//   r1 == 15 -> exit 71 if wrong
//   r2 == 28 -> exit 72 if wrong
//   r3 == 12 -> exit 73 if wrong
//   r4 == 15 -> exit 74 if wrong
//   total == 70 -> exit 75 if wrong else exit 70
//
// Expected exit: 70.

use omega_language_std::console;

data State [copy] {
    // Wrapping so the value-return arithmetic below (`n * multiplier`,
    // `n + addend`) has a defined overflow domain -- an Exact `n * field` over a
    // full-range param carries a decision-17 overflow obligation at the
    // transition-value return boundary. The probe's values are small (<= 28), so
    // Wrapping is behaviourally identical here.
    multiplier: i32 in Wrapping;
    addend: i32 in Wrapping;
}

data Main {
    st: State;
    pause: [u8; 256];
}

// Value-returning machine that reads main.st.multiplier.
machine Main::scale(main: &mut Main, n: i32 in Wrapping) -> i32 {
    transition {
        _ -> ((n * main.st.multiplier) as i32)
    }
}

// Value-returning machine that reads main.st.addend.
machine Main::offset_add(main: &mut Main, n: i32 in Wrapping) -> i32 {
    transition {
        _ -> ((n + main.st.addend) as i32)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("self_mutation_between_calls: value calls must see freshly mutated main fields");
    // Interleave main mutations with value-call reads.
    main.st.multiplier = 3;
    let r1: i32 = Main::scale(main, 5);      // = 5 * 3 = 15

    main.st.multiplier = 7;
    let r2: i32 = Main::scale(main, 4);      // = 4 * 7 = 28

    main.st.addend = 2;
    let r3: i32 = Main::offset_add(main, 10); // = 10 + 2 = 12

    main.st.addend = 15;
    let r4: i32 = Main::offset_add(main, 0);  // = 0 + 15 = 15

    // Check each result.
    transition r1 == 15 {
        true -> check_r2(main, r2, r3, r4, r1)
        _ -> bad_r1(main)
    }

    state bad_r1(main: &mut Main) {
        Console::write_line("FAIL: scale(5) with multiplier 3 did not return 15 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_r2(main: &mut Main, r2: i32, r3: i32, r4: i32, r1: i32) {
        transition r2 == 28 {
            true -> check_r3(main, r3, r4, r1, r2)
            _ -> bad_r2(main)
        }
    }

    state bad_r2(main: &mut Main) {
        Console::write_line("FAIL: scale(4) with multiplier 7 did not return 28 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state check_r3(main: &mut Main, r3: i32, r4: i32, r1: i32, r2: i32) {
        transition r3 == 12 {
            true -> check_r4(main, r4, r1, r2, r3)
            _ -> bad_r3(main)
        }
    }

    state bad_r3(main: &mut Main) {
        Console::write_line("FAIL: offset_add(10) with addend 2 did not return 12 (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state check_r4(main: &mut Main, r4: i32, r1: i32, r2: i32, r3: i32) {
        transition r4 == 15 {
            true -> compute_total(main, r1, r2, r3, r4)
            _ -> bad_r4(main)
        }
    }

    state bad_r4(main: &mut Main) {
        Console::write_line("FAIL: offset_add(0) with addend 15 did not return 15 (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    state compute_total(main: &mut Main, r1: i32, r2: i32, r3: i32, r4: i32) {
        // total = r1 + r2 + r3 + r4 = 15 + 28 + 12 + 15 = 70.
        let total: i32 = r1 + r2 + r3 + r4;
        transition total == 70 {
            true -> good(main)
            _ -> bad_total(main)
        }
    }

    state bad_total(main: &mut Main) {
        Console::write_line("FAIL: results did not total 70 (exit 75)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(75);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: every call observed the freshly mutated main state (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
