// Self-field mutation interleaved with value-returning calls that read
// from self.
//
// FRESH COMBINATION: a value-returning machine reads self fields, and
// self is mutated BETWEEN sequential calls to that machine. Tests that
// each call observes the correct self state (not a stale cached value).
//
// Machines:
//   scale(n) -> i32 = n * self.st.multiplier
//   offset_add(n) -> i32 = n + self.st.addend
//
// Script:
//   self.st.multiplier = 3
//   r1 = self.scale(5)        // = 5 * 3 = 15
//   self.st.multiplier = 7
//   r2 = self.scale(4)        // = 4 * 7 = 28
//   self.st.addend = 2
//   r3 = self.offset_add(10)  // = 10 + 2 = 12
//   self.st.addend = 15
//   r4 = self.offset_add(3)   // = 3 + 15 = 18
//
//   total = r1 + r2 + r3 + r4 - (15 + 28 + 12 + 18 - 70)
//         = 15 + 28 + 12 + 18 = 73 ... not 70.
//   Let's use: 15 + 28 + 12 + 18 - 3 = 70.
//   Or: r1 + r2 - r3 + r4 - (8) = 15 + 28 - 12 + 18 - 8 = 41. No.
//   Or: r1 + r2 + r3 + r4 = 73, not 70. Adjust:
//   self.st.multiplier=3, r1=scale(5)=15
//   self.st.multiplier=7, r2=scale(4)=28
//   self.st.addend=2, r3=offset_add(10)=12
//   self.st.addend=15, r4=offset_add(2)=17  (changed arg)
//   total = r1 + r2 + r3 + r4 = 15+28+12+17=72. No.
//   self.st.addend=15, r4=offset_add(1)=16
//   total = 15+28+12+16=71. No.
//   self.st.addend=15, r4=offset_add(0)=15
//   total = 15+28+12+15=70.
//
// Checks (exit on first wrong):
//   r1 == 15 -> exit 71 if wrong
//   r2 == 28 -> exit 72 if wrong
//   r3 == 12 -> exit 73 if wrong
//   r4 == 15 -> exit 74 if wrong
//   total == 70 -> exit 75 if wrong else exit 70
//
// Expected exit: 70.

use omega_language_std::console;

data State [copy] {
    // Wrapping so the value-return arithmetic below (`n * multiplier`,
    // `n + addend`) has a defined overflow domain -- an Exact `n * field` over a
    // full-range param carries a decision-17 overflow obligation at the
    // transition-value return boundary. The probe's values are small (<= 28), so
    // Wrapping is behaviourally identical here.
    multiplier: i32 in Wrapping;
    addend: i32 in Wrapping;
}

data Main {
    console: Console;
    st: State;
    pause: [u8; 256];
}

// Value-returning machine that reads self.st.multiplier.
machine Main::scale(&mut self, n: i32 in Wrapping) -> i32 {
    transition {
        _ -> (n * self.st.multiplier)
    }
}

// Value-returning machine that reads self.st.addend.
machine Main::offset_add(&mut self, n: i32 in Wrapping) -> i32 {
    transition {
        _ -> (n + self.st.addend)
    }
}

machine Main::main(&mut self) {
    self.console.write_line("self_mutation_between_calls: value calls must see freshly mutated self fields");
    // Interleave self mutations with value-call reads.
    self.st.multiplier = 3;
    let r1: i32 = self.scale(5);      // = 5 * 3 = 15

    self.st.multiplier = 7;
    let r2: i32 = self.scale(4);      // = 4 * 7 = 28

    self.st.addend = 2;
    let r3: i32 = self.offset_add(10); // = 10 + 2 = 12

    self.st.addend = 15;
    let r4: i32 = self.offset_add(0);  // = 0 + 15 = 15

    // Check each result.
    transition r1 == 15 {
        true -> check_r2(r2, r3, r4, r1)
        _ -> bad_r1()
    }

    state bad_r1(&mut self) {
        self.console.write_line("FAIL: scale(5) with multiplier 3 did not return 15 (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state check_r2(&mut self, r2: i32, r3: i32, r4: i32, r1: i32) {
        transition r2 == 28 {
            true -> check_r3(r3, r4, r1, r2)
            _ -> bad_r2()
        }
    }

    state bad_r2(&mut self) {
        self.console.write_line("FAIL: scale(4) with multiplier 7 did not return 28 (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }

    state check_r3(&mut self, r3: i32, r4: i32, r1: i32, r2: i32) {
        transition r3 == 12 {
            true -> check_r4(r4, r1, r2, r3)
            _ -> bad_r3()
        }
    }

    state bad_r3(&mut self) {
        self.console.write_line("FAIL: offset_add(10) with addend 2 did not return 12 (exit 73)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(73);
    }

    state check_r4(&mut self, r4: i32, r1: i32, r2: i32, r3: i32) {
        transition r4 == 15 {
            true -> compute_total(r1, r2, r3, r4)
            _ -> bad_r4()
        }
    }

    state bad_r4(&mut self) {
        self.console.write_line("FAIL: offset_add(0) with addend 15 did not return 15 (exit 74)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(74);
    }

    state compute_total(&mut self, r1: i32, r2: i32, r3: i32, r4: i32) {
        // total = r1 + r2 + r3 + r4 = 15 + 28 + 12 + 15 = 70.
        let total: i32 = r1 + r2 + r3 + r4;
        transition total == 70 {
            true -> good()
            _ -> bad_total()
        }
    }

    state bad_total(&mut self) {
        self.console.write_line("FAIL: results did not total 70 (exit 75)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(75);
    }

    state good(&mut self) {
        self.console.write_line("PASS: every call observed the freshly mutated self state (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }
}
