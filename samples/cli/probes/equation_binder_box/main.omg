// Structural type-equation binders in `where` clauses: a generic
// parameter constrained to equal a const-parameterized shape.
//
//   * `data Mode<const Inner: u32>` — const-generic data.
//   * `Box<Payload [copy], const Count: u32> where Payload ==
//     Mode<Count>` — the equation links the two parameters; the
//     record's Payload slot must be exactly Mode<Count>.
//   * `capacity<Payload, const Count>() where Payload == Mode<Count>`
//     — the same equation on a machine exposes Count at the call;
//     `capacity<Mode<4>>()` and `recovered<4>()` both partial-apply.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Mode<const Inner: u32> [copy] { value: u32; }

data Box<Payload [copy], const Count: u32> [copy]
where Payload == Mode<Count>
{ value: Payload; }

machine capacity<Payload, const Count: u32>() -> u32
where Payload == Mode<Count>
{ Count }

machine recovered<const Count: u32, Payload>() -> u32
where Payload == Mode<Count>
{ Count }

data Main {
    box: Box<Mode<4> >;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.box.value.value = 11;
    transition capacity<Mode<4>>() == 4 && recovered<4>() == 4
        && main.box.value.value == 11 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
