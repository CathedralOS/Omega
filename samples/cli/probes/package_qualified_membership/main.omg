// Package-qualified paths: `leaf` is a depend package; `use
// leaf::outcomes` imports its module, and
// `leaf::outcomes::Outcome::Empty` is a case membership /
// constructor spelling through the package path —
// `Value::Empty` and `Value::Empty {}` select the same
// payload-free case.
//
//   * `value in leaf::outcomes::Outcome::Empty` membership.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use leaf::outcomes;

machine is_empty(value: &leaf::outcomes::Outcome) -> bool {
    value in leaf::outcomes::Outcome::Empty
}

machine has_value(value: &leaf::outcomes::Outcome) -> bool {
    value in leaf::outcomes::Outcome::Value
}

machine bare() -> leaf::outcomes::Outcome { leaf::outcomes::Outcome::Empty }
machine braces() -> leaf::outcomes::Outcome { leaf::outcomes::Outcome::Empty {} }

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let b: leaf::outcomes::Outcome = bare();
    let br: leaf::outcomes::Outcome = braces();
    transition is_empty(&b) && is_empty(&br) && !has_value(&b) {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
