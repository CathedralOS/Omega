// Package-qualified paths: `leaf` is a depend package; `use
// {leaf}/outcomes/outcomes.omg` imports its module, and
// `|outcomes|::Outcome::Empty` is a case membership /
// constructor spelling through the package path —
// `Value::Empty` and `Value::Empty {}` select the same
// payload-free case.
//
//   * `value in |outcomes|::Outcome::Empty` membership.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use {leaf}/outcomes/outcomes.omg;

machine is_empty(value: @|outcomes|::Outcome) -> bool {
    value in |outcomes|::Outcome::Empty
}

machine has_value(value: @|outcomes|::Outcome) -> bool {
    value in |outcomes|::Outcome::Value
}

machine bare() -> |outcomes|::Outcome { |outcomes|::Outcome::Empty }
machine braces() -> |outcomes|::Outcome { |outcomes|::Outcome::Empty {} }

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let b: |outcomes|::Outcome = bare();
    let br: |outcomes|::Outcome = braces();
    transition is_empty(@b) && is_empty(@br) && !has_value(@b) {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
