// Three siblings are checked as one batch; the middle one fails checked
// compilation. The diagnostic must name bad_sibling — the divergent
// occurrence — and not contaminate the convergent siblings around it.

use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_divergent_sibling" };
    let mutable a_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../build_sibling_checks/sibling_a" });
    |dependency|::with_alias(@mutable a_dependency, "a");
    _ = |dependency|::add(builder, a_dependency);
    let mutable bad_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "bad_sibling" });
    |dependency|::with_alias(@mutable bad_dependency, "bad");
    _ = |dependency|::add(builder, bad_dependency);
    let mutable c_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../build_sibling_checks/sibling_c" });
    |dependency|::with_alias(@mutable c_dependency, "c");
    _ = |dependency|::add(builder, c_dependency);
}
