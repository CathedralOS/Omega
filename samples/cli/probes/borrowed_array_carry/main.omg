// A `&mutable [u8; 17]` borrowed closed array is a bounded-view carrier:
// the referent stays caller-owned while a state graph forwards the
// same borrow on every re-entry edge, storing each element through
// it.
//
//   * `write_bytes(out: &mutable [u8; 17], value, width)` — sized-array
//     borrow parameter (not a slice).
//   * `out[position] = value` through the borrow; `out.length` known.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine write_bytes(out: @mutable [u8; 17], value: u8, width: u64) -> u64 {
    transition {
        _ -> fill(out, value, width, 0)
    }
    machine fill(out: @mutable [u8; 17], value: u8, width: u64, position: u64) -> u64 {
        transition (position < width && position < out.length) {
            true -> write_digit(out, value, width, position),
            false -> (width)
        }
    }
    machine write_digit(out: @mutable [u8; 17], value: u8, width: u64, position: u64) -> u64 {
        out[position] = value;
        transition {
            _ -> fill(out, value, width, ((position as +Wrapping) + 1) as u64)
        }
    }
}

data Main {
    buf: [u8; 17];
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    transition write_bytes(@mutable main.buf, 65, 3) == 3
        && main.buf[0] == 65 && main.buf[2] == 65 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
