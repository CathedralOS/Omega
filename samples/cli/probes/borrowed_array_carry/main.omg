// A `&mut [u8; 17]` borrowed closed array is a bounded-view carrier:
// the referent stays caller-owned while a state graph forwards the
// same borrow on every re-entry edge, storing each element through
// it.
//
//   * `write_bytes(out: &mut [u8; 17], value, width)` — sized-array
//     borrow parameter (not a slice).
//   * `out[position] = value` through the borrow; `out.len` known.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine write_bytes(out: &mut [u8; 17], value: u8, width: u64) -> u64 {
    transition {
        _ -> fill(out, value, width, 0)
    }
    state fill(out: &mut [u8; 17], value: u8, width: u64, position: u64) -> u64 {
        transition (position < width && position < out.len) {
            true -> write_digit(out, value, width, position)
            false -> (width)
        }
    }
    state write_digit(out: &mut [u8; 17], value: u8, width: u64, position: u64) -> u64 {
        out[position] = value;
        transition {
            _ -> fill(out, value, width, ((position as u64 in Wrapping) + 1) as u64)
        }
    }
}

data Main {
    buf: [u8; 17];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition write_bytes(&mut main.buf, 65, 3) == 3
        && main.buf[0] == 65 && main.buf[2] == 65 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
