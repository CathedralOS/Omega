// Explicit buffer construction preserves Room A1 and live length 7.
// Compile-checked probe; hit remains 1 on success.
domain [u8; 16]::Ascii(bytes) requires ascii_only(bytes);
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
data TextBuffer where used <= 16 { storage: [u8; 16] in Ascii; used: u64; }
machine live(buffer: &TextBuffer) -> &[u8] in Ascii { &buffer.storage[..buffer.used] }
machine copy(buffer: &mut [u8; 16] in Ascii, bytes: &[u8] in Ascii, start: u64)
requires start <= 16; bytes.len <= 16 - start
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    state copying(buffer: &mut [u8; 16] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 16; index <= 16
    {
        transition index < bytes.len && start + index < 16 {
            true -> writing(buffer, bytes, start, index)
            _ -> done()
        }
    }
    state writing(buffer: &mut [u8; 16] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 16; index < 16; index < bytes.len; start + index < 16
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    state done() {}
}

domain [u8; 4]::Ascii(bytes) requires ascii_only(bytes);
data Label where used <= 4 { storage: [u8; 4] in Ascii; used: u64; }
machine label_live(label: &Label) -> &[u8] in Ascii
ensures result.len == label.used && result.len <= 4
{ &label.storage[..label.used] }
data Main {
    label: Label;
    text: TextBuffer;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.label = Label { storage: [65u8, 49u8, 0u8, 0u8], used: 2 };
    copy(&mut main.text.storage, "Room ", 0);
    copy(&mut main.text.storage, label_live(&main.label), 5);
    main.text.used = 7;
    let view: &[u8] in Ascii = live(&main.text);
    transition view == "Room A1" && view.len == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
