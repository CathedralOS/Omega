use {omega}/language/core/byte_observation/byte_observation.omg;
// Explicit buffer construction preserves Room A1 and live length 7.
// Expected exit: 0. The entry checks the selected success result.
domain [u8; 16]::Ascii requires |byte_observation|::ascii_only(@self[..]);
domain [u8]::Ascii requires |byte_observation|::ascii_only(@self[..]);
data TextBuffer requires used <= 16 { storage: [u8; 16] in Ascii; used: u64; }
machine live(buffer: @TextBuffer) -> @[u8] in Ascii {
    let prefix: @[u8] = @(@buffer.storage as -Ascii)[..buffer.used];
    prefix as +Ascii
}
machine copy(buffer: @mutable [u8; 16] in Ascii, bytes: @[u8] in Ascii, start: u64)
requires start <= 16, bytes.length <= 16 - start
ensures buffer in Ascii
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    machine copying(buffer: @mutable [u8; 16] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 16, index <= 16
    ensures buffer in Ascii
    {
        transition index < bytes.length && start + index < 16 {
            true -> writing(buffer, bytes, start, index),
            _ -> done()
        }
    }
    machine writing(buffer: @mutable [u8; 16] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 16, index < 16, index < bytes.length, start + index < 16
    ensures buffer in Ascii
    {
        (@mutable buffer as -Ascii)[start + index] = (bytes as -Ascii)[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    machine done() {}
}

domain [u8; 4]::Ascii requires |byte_observation|::ascii_only(@self[..]);
data Label requires used <= 4 { storage: [u8; 4] in Ascii; used: u64; }
machine label_live(label: @Label) -> @[u8] in Ascii
ensures result.length == label.used && result.length <= 4
{
    let prefix: @[u8] = @(@label.storage as -Ascii)[..label.used];
    prefix as +Ascii
}
data Main {
    label: Label;
    text: TextBuffer;
    hits: i32 in Wrapping;
}

machine exercise(main: @mutable Main) {
    main.hits = 0 as +Wrapping;
    main.label = Label { storage: [65u8, 49u8, 0u8, 0u8] as +Ascii, used: 2 };
    copy(@mutable main.text.storage, "Room " as +Ascii, 0);
    copy(@mutable main.text.storage, label_live(@main.label), 5);
    main.text.used = 7;
    let view: @[u8] in Ascii = live(@main.text);
    transition (view as -Ascii) == "Room A1" && view.length == 7 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1 as +Wrapping; }
    machine fail(main: @mutable Main) { main.hits = (-1) as +Wrapping; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mutable entry_storage: Main;
    exercise(@mutable entry_storage);
    transition entry_storage.hits == 1 { true -> {}, false -> bad() }
    machine bad() crashes Trap { crash Trap; }
}
