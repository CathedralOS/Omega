// A cast inside a contract term: `ensures (value as u8
// in Wrapping) == 3u8` — the postcondition is itself a
// cast expression evaluated over the parameter, carrying
// a policy domain.
//
//   * `trait ExactInteger` — abstract contract declared
//     without a body: the ensures is a PRIOR fact callers
//     cite, not a proof the trait owes operationally.
//   * `machine concrete_form` — the same f64→u8 shape
//     done operationally with an explicit `in Wrapping`
//     policy result.
//   * Learning: `value as u8` (unqualified cast) cannot
//     be proved even under `requires value == 3.0` —
//     "cannot prove unqualified `U8::from_f64` operand is
//     finite and truncates into u8". The abstract ensures
//     is the only route that claims the fact.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::float_operations;

trait ExactInteger {
    machine form(value: f64) -> u8
    requires value == 3.0
    ensures (value as u8 in Wrapping) == 3u8;
}

machine concrete_form(value: f64) -> u8 in Wrapping
requires value == 3.0
{
    value as u8 in Wrapping
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let narrowed: u8 in Wrapping = concrete_form(3.0);
    transition narrowed == 3u8 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
