use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::package(builder, "pkgb");
    let mutable a2_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../a" });
    |dependency|::with_alias(@mutable a2_dependency, "a2");
    let a2_registration: DependencyRegistration = Build::dependency(builder, a2_dependency);
}
