// Dependency-closure validation on a trivial single-dep graph: a
// straight path resolves; controls pin the two closure-resolution
// rejections — a dependency cycle and an unresolvable source path.

machine build(builder: &mut Build) {
    Build::application(builder, "build_dep_graph");
    let mut kit_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut kit_dependency, "kit");
    let kit_registration: DependencyRegistration = Build::dependency(builder, kit_dependency);
    builder.freestanding = true;
}
