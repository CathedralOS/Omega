// Domain conjunctions, transparent aliases, and `in` membership as a
// first-class value — the first sample where a `transition` subject is
// a tuple and its pattern a literal tuple of bools.
//
//   * `domain Socket::Usable = Connected & Authenticated` is a
//     transparent alias: `forward` declares the two atomic requirements
//     separately and that satisfies `consume`'s `socket in Usable`.
//   * `Socket { connected: true, authenticated: true }` — record
//     literal construction is the gate: it grants both field domains.
//   * `(a in Usable, b in Usable, b in Connected)` is a tuple subject;
//     `(true, false, true)` is the matching literal pattern.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Socket [copy] {
    connected: bool;
    authenticated: bool;
}

domain Socket::Connected(socket)
requires
    socket.connected;

domain Socket::Authenticated(socket)
requires
    socket.authenticated;

domain Socket::Usable = Socket::Connected & Socket::Authenticated;

machine consume(socket: Socket)
requires
    socket in Socket::Usable;
{
}

// Two atomic requires discharge the conjunction alias transparently.
machine forward(socket: Socket)
requires
    socket in Socket::Connected;
    socket in Socket::Authenticated;
{
    consume(socket)
}

machine Main::good(main: &mut Main) {
    main.hits = 3;
}

machine Main::bad(main: &mut Main) {
    main.hits = 0;
}

data Main {
    socket: Socket;
    other: Socket;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    // Literal construction grants every satisfied field domain.
    main.socket = Socket { connected: true, authenticated: true };
    main.other = Socket { connected: true, authenticated: false };
    // atomic-pair requires -> Usable conjunction at consume.
    forward(main.socket);
    transition (main.socket in Socket::Usable,
        main.other in Socket::Usable, main.other in Socket::Connected) {
        (true, false, true) -> Main::good(main)
        _ -> Main::bad(main)
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
