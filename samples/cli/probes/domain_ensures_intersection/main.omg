// Domain establishment through `ensures` on ordinary machines, and the
// intersection requires `password in Valid & Secure`.
//
//   * `mark_valid`/`mark_secure` each carry `ensures password in D` —
//     the checker proves the body's field writes satisfy the domain's
//     requires clause, so the fact is established for the caller.
//   * `touch_salt` mutates an unrelated Wrapping field in between —
//     established domain facts survive unrelated writes.
//   * `accept` requires the INTERSECTION: both established facts must
//     still hold at the call.
//   * `hits` counts each reached arm; 3 proves all three ran in order.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Password [copy] {
    length: i32;
    score: i32;
    salt: i32 in Wrapping;
}

domain Password::Valid(password)
requires
    password.length > 0;

domain Password::Secure(password)
requires
    password.score >= 8;

machine mark_valid(password: &mut Password)
ensures
    password in Password::Valid
{
    password.length = 12;
}

machine mark_secure(password: &mut Password)
ensures
    password in Password::Secure
{
    password.score = 10;
}

machine touch_salt(password: &mut Password) {
    password.salt = password.salt + 1;
}

machine Main::accept(password: Password)
requires
    password in Password::Valid & Password::Secure
{
}

data Main {
    password: Password;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    mark_valid(&mut main.password);
    mark_secure(&mut main.password);
    touch_salt(&mut main.password);
    main.hits = 0;
    transition main.password.length > 0 {
        true -> one(main)
        _ -> other(main)
    }
    machine one(main: &mut Main) {
        main.hits = 1;
        transition main.password.score >= 8 {
            true -> two(main)
            _ -> other(main)
        }
    }
    machine two(main: &mut Main) {
        main.hits = 2;
        Main::accept(main.password);
        main.hits = 3;
    }
    machine other(main: &mut Main) {
        main.hits = -1;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
