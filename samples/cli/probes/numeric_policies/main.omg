// Numeric conversion policies: `core::numeric_conversion` exposes
// `narrow_<S>_to_<T>_{exact,wrapping,saturating,trapping}` and
// `widen_<S>_to_<T>` — the policy is part of the machine name.
// exact traps on out-of-range (unchecked spelling), wrapping
// takes the low bits, saturating clamps.
//
//   * `narrow_i16_to_i8_wrapping(128)` → -128 (bit pattern);
//     `narrow_i16_to_i8_saturating(128)` → 127 (clamp);
//     `narrow_i16_to_i8_exact(127)` → 127 (in-range).
//   * `widen_i8_to_i64(-5)` → -5 signed extension.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use omega::language::core::numeric_conversion;

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let wrapped: i8 = narrow_i16_to_i8_wrapping(128);
    let clamped: i8 = narrow_i16_to_i8_saturating(128);
    let exact: i8 = narrow_i16_to_i8_exact(127);
    let wide: i64 = widen_i8_to_i64(-5);
    transition wrapped == -128 && clamped == 127 && exact == 127 && wide == -5 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
