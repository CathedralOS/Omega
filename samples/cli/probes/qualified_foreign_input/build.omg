use {omega}/language/core/external_binding.omg as foreign;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "qualified_foreign_input" };
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind_native::<Magnitude::absolute>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs" },
    });
}
