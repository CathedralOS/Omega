use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "qualified_foreign_input" };
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::bind_native::<|app|::Magnitude::absolute>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs" },
    });
}
