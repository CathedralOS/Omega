// The extent surface's runtime geometry: `embed` maps an `addr` and a
// length into the same mathematical domain so `embed(base) +
// embed(length) <= addr::Bound` is a checked ensures — `no_wrap` is
// stated as a requires denotation beside it.
use omega::language::core::extent;
machine no_wrap_is_geometry(base: addr, length: u64)
requires no_wrap(base, length)
ensures embed(base) + embed(length) <= addr::Bound
{}
data Main {}
machine Main::main(main: &mut Main) { }
