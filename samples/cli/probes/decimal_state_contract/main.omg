// Expected exit: 0.
// Repeated subtraction preserves a mathematical decimal-state invariant.
machine digit(value: u64 in Trapping)
requires 48 <= value && value <= 57
{ }

machine decimal(value: u64 in Trapping) -> i32 {
    transition value <= 999 {
        true -> hundreds(value, 0)
        _ -> 2
    }
    machine hundreds(rest: u64 in Trapping, count: u64 in Trapping) -> i32
    requires count <= 9 && embed(rest) + embed(count) * 100 <= 999
    {
        transition rest >= 100 {
            true -> hundreds(rest - 100, count + 1)
            _ -> hundreds_emit(rest, count)
        }
    }
    machine hundreds_emit(rest: u64 in Trapping, count: u64 in Trapping) -> i32 {
        transition count == 0 {
            true -> loop(rest, 0)
            _ -> hundreds_digit(rest, 48 + count)
        }
    }
    machine hundreds_digit(rest: u64 in Trapping, code: u64 in Trapping) -> i32 {
        digit(code);
        transition { _ -> loop(rest, 0) }
    }
    machine loop(rest: u64 in Trapping, count: u64 in Trapping) -> i32
    requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
    {
        transition rest >= 10 {
            true -> loop(rest - 10, count + 1)
            _ -> emit(rest, count)
        }
    }
    machine emit(rest: u64 in Trapping, count: u64 in Trapping) -> i32 {
        digit(48 + count);
        digit(48 + rest);
        transition rest == 9 && count == 9 {
            true -> 0
            _ -> 1
        }
    }
}

machine main() crashes Trap {
    let status: i32 = decimal(999);
    transition status == 0 {
        true -> done()
        _ -> wrong()
    }
    machine done() { }
    machine wrong() { crash Trap; }
}
