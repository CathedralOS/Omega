// Named proposition rosters in trait contracts:
// `requires first: first_ready()` — proposition instances carry
// NAMES (`first:`/`first_out:`) inside a boundary trait's
// contract, `evidence Evidence` binds each proposition to its
// witness data.
//
//   * `proposition first_ready() evidence Evidence;`
//   * trait Producer<T>::produce with named requires/ensures
//     proposition rosters.
//
// Compile-checked only: declaration surface (proposition
// contracts aren't callable), no standard-library dependency.

trait Evidence {
}

proposition first_ready() evidence Evidence;
proposition second_ready() evidence Evidence;
proposition third_ready() evidence Evidence;

trait Producer<T> {
    machine produce(subject: &T)
    requires first: first_ready()
    requires second: second_ready()
    requires third: third_ready()
    ensures first_out: first_ready()
    ensures second_out: second_ready()
    ensures third_out: third_ready();
}

data Token {
}

TokenProducer satisfies Producer<Token> {
    machine produce(subject: &Token)
    requires local_first: first_ready()
    requires local_second: second_ready()
    requires local_third: third_ready()
    ensures first_out: first_ready()
    ensures second_out: second_ready()
    ensures third_out: third_ready()
    {
        first_out = local_first;
        second_out = local_second;
        third_out = local_third;
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
