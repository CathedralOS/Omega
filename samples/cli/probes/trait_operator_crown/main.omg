// Trait-crowned operator tokens: a trait crowns the fixed `<` token
// on a named requirement (`operator < before`), a generic caller
// resolves the token through its evidence binder's selected
// implementation, the requirement stays callable by name
// (`Ascending::before`), and a concrete `machine <` crowns the
// canonical token for its operand signature.
//
//   * `choose<Element, Order satisfies Ranked<Element>>` —
//     `left < right` resolves via the binder.
//   * `crowned_less` resolves via the concrete `machine <`
//     `Card::less_by_rank`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

trait Ranked<T> {
    operator < before(left: T, right: T) -> bool;
}

data Card [copy] { rank: i32; }

Ascending satisfies Ranked<Card> {
    machine before(left: Card, right: Card) -> bool {
        left.rank < right.rank
    }
}

machine choose<Element, Order satisfies Ranked<Element>>(
    left: Element,
    right: Element
) -> bool {
    left < right
}

machine < Card::less_by_rank(left: Card, right: Card) -> bool {
    left.rank < right.rank
}

machine crowned_less(left: Card, right: Card) -> bool {
    left < right
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let low: Card = Card { rank: 3 };
    let high: Card = Card { rank: 9 };
    transition choose<Card, Ascending>(low, high)
        && Ascending::before(low, high)
        && crowned_less(low, high)
        && !choose<Card, Ascending>(high, low) {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
