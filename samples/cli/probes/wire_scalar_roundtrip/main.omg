// Wire field tags and the generated codec pair: `#N name: T` on a data
// declaration synthesizes `T::encode(&value, &mut buffer, &mut written)`
// and `T::decode(&mut value, &buffer, &mut read, &mut verdict)` —
// no imports beyond the depend-free core set.
//
//   * `data Frame { #0 code: u32; #1 level: i32; }` — numbered fields
//     are the wire order; `FrameValue` is the un-tagged mirror data.
//   * `data WireVerdict { case Invalid; case Sound; }` — decode verdict
//     enum; `Invalid` is the ZII zero case so an untouched verdict
//     reads as failure.
//   * Roundtrip: encode -> decode -> verdict == Sound and the decoded
//     fields read back; `written`/`read` count codec bytes.
//   * `hits` counts each reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Frame {
    #0 code: u32;
    #1 level: i32;
}

data FrameValue {
    code: u32;
    level: i32;
}

data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let value: FrameValue = FrameValue { code: 42, level: -7 };
    Frame::encode(&value, &mut main.buffer, &mut main.written);

    let decoded: FrameValue = FrameValue { code: 0, level: 0 };
    Frame::decode(&mut decoded, &main.buffer, &mut main.read, &mut main.verdict);

    transition main.verdict == WireVerdict::Sound
        && decoded.code == 42 && decoded.level == -7 {
        true -> Main::pass(main)
        _ -> Main::fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
