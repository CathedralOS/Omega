// crash_route_exits build file: depend-free compile-scope probe — no
// standard-library package, so no ProcessExit authority; compile-checked
// only (same posture as cli/basics/standalone).

use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "crash_route_exits" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::crash_route_exits);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::crash_route_exits);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::crash_route_exits);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::crash_route_exits);
}
