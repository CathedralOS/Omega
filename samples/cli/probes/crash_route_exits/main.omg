// crash_route_exits: explicit crash routes as sample code — the first
// sample declaring `crashes Trap` on ordinary machines.
//
//   * `inspect` declares its unrecoverable route: the `n < 0` arm reaches
//     `crash Trap;`, an unwind-free terminal outcome; the other arm
//     returns true.
//   * `probe` covers the callee's route by declaration — `crashes Trap`
//     on its own signature propagates `inspect`'s route to callers
//     without discharging it.
//   * The entry likewise declares `crashes Trap` and calls `probe(5)` on
//     the dormant path — every route exists in the checked program while
//     none fires in this run.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
machine inspect(n: i32) -> bool
crashes Trap {
    transition n < 0 {
        true -> bad()
        _ -> good()
    }

    machine good() -> bool {
        transition { _ -> true }
    }

    machine bad() -> bool {
        crash Trap;
    }
}

machine probe(n: i32) -> bool
crashes Trap {
    inspect(n)
}

machine crash_route_exits() crashes Trap {
    let flagged: bool = probe(5);
    transition flagged {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
