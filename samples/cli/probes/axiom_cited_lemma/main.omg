use omega::language::core::nat;
// An axiom about an unproven shape, cited by a lemma: the citation delivers
// the accepted fact into the lemma's hypothesis base.
boundary machine mul_comm_axiom(a: Nat, b: Nat) -> Nat
ensures
    (mul(a, b)) == (mul(b, a));
machine uses_axiom(a: Nat, b: Nat) -> Nat
ensures
    (mul(a, b)) == (mul(b, a))
{
    transition {
        _ -> body(a, b)
    }
    machine body(a: Nat, b: Nat) -> Nat {
        mul_comm_axiom(a, b);
        transition { _ -> Nat::Zero }
    }
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
