use {omega}/language/core/nat.omg;
// An axiom about an unproven shape, cited by a lemma: the citation delivers
// the accepted fact into the lemma's hypothesis base.
boundary machine mul_comm_axiom(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
ensures
    (|nat|::mul(a, b)) == (|nat|::mul(b, a));
machine uses_axiom(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
ensures
    (|nat|::mul(a, b)) == (|nat|::mul(b, a))
{
    transition {
        _ -> body(a, b)
    }
    machine body(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
        mul_comm_axiom(a, b);
        transition { _ -> |nat|::Nat::Zero }
    }
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: @mutable Main) {
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
