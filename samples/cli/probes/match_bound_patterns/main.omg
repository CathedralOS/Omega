// Runtime values as match patterns: `first` and `second` are
// parameters used AS patterns — `match pair.left { first -> 7,
// second -> 9, _ -> 11 }` compares the subject against bound
// values, not literals. Subjects include field projections and
// computed float expressions, on f32 and f64.
//
//   * `match pair.left { first -> .., second -> .., _ -> .. }`.
//   * `match a + b { .. }` computed subject.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use omega::language::core::float_operations;

data Narrow { left: f32; right: f32; }
data Wide { left: f64; right: f64; }

machine choose_projected32(pair: Narrow, first: f32, second: f32) -> i64 {
    match pair.left { first -> 7, second -> 9, _ -> 11 }
}
machine choose_projected64(pair: Wide, first: f64, second: f64) -> i64 {
    match pair.right { first -> 7, second -> 9, _ -> 11 }
}
machine choose_computed32(a: f32, b: f32, first: f32, second: f32) -> i64 {
    match a + b { first -> 7, second -> 9, _ -> 11 }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let pair: Narrow = Narrow { left: 2.0f32, right: 1.0f32 };
    let wide: Wide = Wide { left: 1.0f64, right: 2.0f64 };
    let p32: i64 = choose_projected32(pair, 1.0f32, 2.0f32);
    let p64: i64 = choose_projected64(wide, 1.0f64, 2.0f64);
    let c32: i64 = choose_computed32(0.5f32, 0.5f32, 1.0f32, 2.0f32);
    let fall: i64 = choose_projected32(Narrow { left: 3.0f32, right: 0.0f32 }, 1.0f32, 2.0f32);
    transition p32 == 9 && p64 == 9 && c32 == 7 && fall == 11 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
