// Expected exit: 70.
// Probe 2: Trigger FIRST (position 0, ZII = no-payload), then payload variants.
// If the bug is positional (arm 3+), this should work.
// If the bug is mixing payload + no-payload in any order, this will also fail.

use omega_language_std::console;
use omega::language::core::binding;

data AlarmEvent {
    case Trigger;
    case Dismiss;
    case Cancel;
    case Set(hour: i32 in Saturating, minute: i32 in Saturating);
    case Snooze(minutes: i32 in Saturating);
}

data Main {
    console: Binding<Console>;
    fire_count: i32 in Saturating;
    pause: [u8; 256];
}

machine Main::dispatch(main: &mut Main, event: AlarmEvent) {
    transition event {
        AlarmEvent::Trigger -> do_trigger(main)
        AlarmEvent::Dismiss -> do_dismiss()
        AlarmEvent::Cancel -> do_cancel()
        AlarmEvent::Set { hour, minute } -> do_set(hour, minute)
        AlarmEvent::Snooze { minutes } -> do_snooze(minutes)
        _ -> done()
    }

    state do_trigger(main: &mut Main) { main.fire_count = main.fire_count + 1; }
    state do_dismiss() {}
    state do_cancel() {}
    state do_set(hour: i32 in Saturating, minute: i32 in Saturating) {}
    state do_snooze(minutes: i32 in Saturating) {}
    state done() {}
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("alarm_probe2: no-payload Trigger arm at position 0 -- must fire twice");
    Main::dispatch(&mut self, AlarmEvent::Trigger);
    Main::dispatch(&mut self, AlarmEvent::Trigger);

    transition self.fire_count == 2 {
        true -> good(&mut self)
        _ -> bad(&mut self)
    }
    state good(main: &mut Main) {
        main.console.write_line("PASS: fire_count == 2 after two Trigger dispatches (exit 70)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(70);
    }
    state bad(main: &mut Main) {
        main.console.write_line("FAIL: fire_count != 2 -- Trigger arm dropped or unreachable (exit 71)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(71);
    }
}
