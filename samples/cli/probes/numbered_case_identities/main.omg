// Stable sum-case and structured payload identities are data metadata:
// `#N` on cases and payload members plus `retired #N` reservations at both
// levels. They do not select or alter the runtime discriminant.
data Lookup<T> {
    case #1 Found(#1 value: T, retired #2);
    case #2 Missing;
    retired #3;
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let hit: Lookup<u64> = Lookup::Found { value: 3 };
    transition hit {
        Lookup::Found { value } -> good(main, value)
        Lookup::Missing -> bad(main)
    }
    state good(main: &mut Main, value: u64) {
        main.hits = main.hits + (value as i32 in Wrapping);
    }
    state bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
