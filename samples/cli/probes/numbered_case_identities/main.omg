// Stable sum-case and structured payload identities are data metadata:
// `#N` on cases and payload members plus `retired #N` reservations at both
// levels. They do not select or alter the runtime discriminant.
data Lookup<T> {
    #1 case Found(#1 value: T, retired #2);
    #2 case Missing;
    retired #3;
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: @mutable Main) {
    let hit: Lookup<u64> = Lookup::Found { value: 3 };
    transition hit {
        Lookup::Found { value } -> good(main, value),
        Lookup::Missing -> bad(main)
    }
    machine good(main: @mutable Main, value: u64) {
        main.hits = main.hits + (value as i32 +Wrapping);
    }
    machine bad(main: @mutable Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
