data Command { case None; case Quit; case Move(dx: i32); case Say(volume: i32); }
domain Command::Interactive(command)
requires
    command in Command::Move | Command::Say;
data Main { cmd: Command; }
machine Main::main(main: &mut Main) {
    main.cmd = Command::Say { volume: 9 };
    transition {
        _ -> route(main)
    }
    machine route(main: &mut Main) {
        transition main.cmd {
            Command::None -> missed(main)
            Command::Quit -> missed(main)
            Command::Interactive -> matched(main)
        }
    }
    machine matched(main: &mut Main) { let value: i32 = 40; }
    machine missed(main: &mut Main) { let value: i32 = 0; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
