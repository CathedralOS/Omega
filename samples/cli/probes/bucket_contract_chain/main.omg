// bucket_contract_chain: proof-obligated mutation as user code — the first
// sample whose calls are gated by `requires` and chained by `ensures`.
// A concrete fixed-capacity bucket (the core `FixedVec<T, const N>` pattern
// hand-instantiated: generic machine instantiation is not wired yet, so the
// concrete data + attached machines carry the contracts).
//
// The discharge chain is pure contract chaining, no runtime checks:
//   clear ESTABLISHES spare room (ensures length < items.len),
//   push CONSUMES it and GUARANTEES non-emptiness + the predecessor bound,
//   get  CONSUMES push's length > index fact through the whole-window
//        view `&bucket.items[..]`, which names the array's own storage,
//   pop  CONSUMES non-emptiness + the predecessor bound.
// Mutating calls invalidate carried facts, so each proof-obligated call is
// fed by the guarantee of the call before it.
//
// The machine pushes 7 into a 3-slot bucket, reads slot 0 back, pops it,
// and accepts only when first == 7 and popped == 7. Compile-checked only:
// no standard-library dependency, no ProcessExit provider.
data Bucket {
    items: [u8; 3];
    length: u64 in Wrapping;
}

// Empty the bucket and ESTABLISH the has-room fact for the next push. The
// strict `<` is justified by this concrete capacity (3 > 0).
machine Bucket::clear(bucket: &mut Bucket)
ensures
    bucket.length < bucket.items.len
{
    bucket.length = 0;
}

// Append: requires provable spare room, guarantees non-emptiness plus the
// popped slot's bound for the call after it.
machine Bucket::push(bucket: &mut Bucket, value: u8 in Wrapping)
requires
    bucket.length < bucket.items.len
ensures
    bucket.length > 0;
    bucket.length - 1 < bucket.items.len
{
    let slots: &mut [u8] = &mut bucket.items[..];
    let index: u64 in Wrapping = bucket.length;
    slots[index] = value as u8;
    bucket.length = bucket.length + 1;
}

// Read within the live length through the slice view.
machine Bucket::get(bucket: &Bucket, index: u64 in Wrapping) -> u8
requires
    bucket.length > index;
    index < bucket.items.len
{
    let slots: &[u8] = &bucket.items[..];
    slots[index]
}

// Pop the top: capture the value BEFORE the length write (the trailing
// local return spelling).
machine Bucket::pop(bucket: &mut Bucket) -> u8
requires
    bucket.length > 0;
    bucket.length - 1 < bucket.items.len
{
    let slots: &[u8] = &bucket.items[..];
    let index: u64 in Wrapping = bucket.length - 1;
    let value: u8 = slots[index];
    bucket.length = index;
    value
}

machine bucket_contract_chain() {
    let mut bucket: Bucket = Bucket { items: [0, 0, 0], length: 0 };
    Bucket::clear(&mut bucket);
    Bucket::push(&mut bucket, 7);
    let first: u8 = Bucket::get(&bucket, 0);
    let popped: u8 = Bucket::pop(&mut bucket);
    transition first == 7 {
        true -> judge(popped)
        _ -> done(71)
    }

    state judge(popped: u8) {
        transition popped == 7 {
            true -> done(70)
            _ -> done(72)
        }
    }

    state done(code: i32) {}
}
