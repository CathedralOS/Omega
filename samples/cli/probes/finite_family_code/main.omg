// finite_family_code: const-generic requirement families as sample code —
// the first sample with a trait requirement bounded by a finite `where`
// disjunction over a const parameter, an authored machine that declares
// its satisfaction in the signature, and a generic forwarder carrying the
// same bound.
//
//   * `Shape<T>::code<Width: u32>` is a finite generic family: exactly the
//     tuples `Width == 16 || Width == 32` admit; every other Width is
//     unsatisfiable by construction.
//   * `Item::code<Width>` declares `satisfies Shape<Item>::code` in its own
//     signature — the row IS the conformance, and `Primary`'s roster binds
//     it with `Shape::code = Item::code`.
//     (note: `where` disjunctions admit only on trait requirements — a
//     free machine carrying the same clause is rejected at admission).
//
// The machine calls Width 16 and Width 32 of the bound family directly, and
// accepts when both rows return the item's 7. Compile-checked only: no
// standard-library dependency, no ProcessExit provider.
trait Shape<T> {
    machine code<Width: u32>(subject: &T) -> i32 where Width == 16 || Width == 32;
}

data Item {
    value: i32;
}

machine Item::code<Width: u32>(item: &Item) -> i32 satisfies Shape<Item>::code {
    transition {
        _ -> item.value
    }
}

Primary satisfies Shape<Item> {
    Shape::code = Item::code;
}

machine finite_family_code() {
    let mut item: Item = Item { value: 7 };
    let half: i32 = Item::code<16>(&item);
    let full: i32 = Item::code<32>(&item);
    transition half == 7 && full == 7 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
