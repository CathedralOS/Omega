// A checked conformance may establish a routed qualification only
// through the exact trait requirement named by the domain:
// `domain Token::Issued established by TokenIssuer::issue` — the
// call-result fact follows the returned value into the local so the
// next call can consume it. A constrained bodyless parameter
// (`token: Token in Issued`) is an implicit call requirement and an
// entry fact in the callee.
data Token {
    value: u64;
}
domain Token::Issued
established by TokenIssuer::issue;
trait TokenIssuer {
    machine issue(value: u64) -> Token
    ensures
        result in Token::Issued;
}
machine Token::issue(value: u64) -> Token
satisfies TokenIssuer::issue
ensures
    result in Token::Issued
{
    Token { value: value }
}
machine consume(token: Token in Issued) {
}
machine forward(token: Token in Issued) {
    consume(token);
}

data Main {}
machine Main::main(main: &mut Main) {
    let token: Token = Token::issue(7);
    forward(token);
}
