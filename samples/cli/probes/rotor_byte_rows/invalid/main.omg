// The wiring table has three rotor rows. Column 26 is outside a 26-byte row.

data Wiring {
    rows: [[u8; 26]; 3];
}

machine read_past_alphabet(wiring: &Wiring, rotor: i32) -> u8
    requires rotor >= 0 && rotor < 3
{
    wiring.rows[rotor][26]
}

data Main {
    wiring: Wiring;
}

machine Main::main(main: &mut Main) {
    let byte: u8 = read_past_alphabet(&main.wiring, 0);
    main.wiring.rows[0][0] = byte;
}
