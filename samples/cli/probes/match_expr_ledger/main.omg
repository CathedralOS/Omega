// match_expr_ledger: match expressions — the first sample producing
// values from `match` instead of dispatching transitions.
//
//   * Literal patterns pick a case: `match code { 2 -> Missing, _ ->
//     Other }` yields the expression's value directly.
//   * A nested match fills a record field — `category: match code
//     { ... }` inside the `_` arm's construction.
//   * Duplicate value patterns keep authored first-match order: in
//     `choose`, `0 -> 7` shadows `0 -> 99`.
//   * Match results bind through `let`, through fields on `&mut`
//     carriers, and feed straight into `accept`.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Category { case Other; case Missing; }
data Record { category: Category; number: u64; }
data Holder { category: Category; }

machine classify(code: u64) -> Category {
    match code { 2 -> Category::Missing, _ -> Category::Other }
}

machine record(code: u64) -> Record {
    match code {
        2 -> Record { category: Category::Missing, number: 7 },
        _ -> Record {
            category: match code { 3 -> Category::Missing, _ -> Category::Other },
            number: code
        }
    }
}

machine choose(subject: u64) -> u64 {
    match subject {
        0 -> 7,
        0 -> 99,
        _ -> 9
    }
}

machine Holder::replace(holder: &mut Holder, code: u64) {
    holder.category = match code { 2 -> Category::Missing, _ -> Category::Other };
}

machine match_expr_ledger() {
    let chosen: Category = classify(2);
    let r: Record = record(5);
    let first: u64 = choose(0);
    let holder: Holder = Holder { category: Category::Other };
    transition chosen {
        Category::Missing -> verify(first, r)
        Category::Other -> done(71)
    }

    machine verify(first: u64, r: Record) {
        transition first == 7 && r.number == 5 && choose(9) == 9 {
            true -> done(70)
            _ -> done(71)
        }
    }

    machine done(code: i32) {}
}
