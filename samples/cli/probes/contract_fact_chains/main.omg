// Contract fact chains: requires/ensures pairs on borrowed parameters
// and named-result contracts that forward through tail calls.
//
//   * `arm` carries `requires start < 8` and a TWO-clause ensures list
//     (`remaining > 0; remaining - 1 < 8`); the body's `start + 1`
//     establishes both.
//   * `tick` requires both facts — `remaining - 1` is provable because
//     `remaining > 0` rules out wraparound, and `< 8` bounds the sum.
//   * `answer`/`forward` carry `ensures result == 70` — a named-result
//     contract; `forward`'s tail `transition { _ -> answer() }`
//     forwards the callee's result obligation.
//   * `hits` records the reached arm; `crashes Trap` declares the
//     failure route like the corpus spelling.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Countdown { remaining: u32 in Wrapping; }

machine Countdown::arm(timer: &mut Countdown, start: u32 in Wrapping)
requires start < 8
ensures
    timer.remaining > 0;
    timer.remaining - 1 < 8
{
    timer.remaining = start + 1;
}

machine Countdown::tick(countdown: &mut Countdown) -> u32 in Wrapping
requires
    countdown.remaining > 0;
    countdown.remaining - 1 < 8
{
    countdown.remaining = countdown.remaining - 1;
    countdown.remaining
}

machine answer() -> i32
ensures result == 70
{ 70 }

machine forward() -> i32
ensures result == 70
{ transition { _ -> answer() } }

data Main {
    timer: Countdown;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;
    Countdown::arm(&mut main.timer, 4);
    let remaining: u32 in Wrapping = Countdown::tick(&mut main.timer);
    transition remaining == 4 && forward() == 70 {
        true -> done(main)
        _ -> bad(main)
    }
    state done(main: &mut Main) { main.hits = 1; }
    state bad(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
