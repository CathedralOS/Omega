// `data FixedBuffer<T, const N: u64>` — a const value parameter
// usable as a symbolic fixed-array length inside the data body.
data FixedBuffer<T, const N: u64> {
    items: [T; N];
}
data Main {
    small: FixedBuffer<u8, 4>;
    wide: FixedBuffer<u16, 8>;
}
machine Main::main(main: &mut Main) {
    main.small.items[0] = 9;
    main.wide.items[7] = 1;
}
