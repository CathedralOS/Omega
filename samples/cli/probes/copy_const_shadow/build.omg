// copy_const_shadow build file: depend-free compile-scope probe — no
// standard-library package, so no ProcessExit authority; compile-checked
// only (same posture as cli/basics/standalone).

machine build(builder: &mut Build) {
    Build::application(builder, "copy_const_shadow");
    Build::bind(builder, windows_x86_64::ProgramEntry, copy_const_shadow);
    Build::bind(builder, linux_x86_64::ProgramEntry, copy_const_shadow);
    Build::bind(builder, linux_arm64::ProgramEntry, copy_const_shadow);
    Build::bind(builder, macos_arm64::ProgramEntry, copy_const_shadow);
}
