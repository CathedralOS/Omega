// copy_const_shadow: `[copy]` data, top-level constants, and name
// shadowing as sample code — the first sample declaring all three.
//
//   * `data Key [copy]` is copyable data: it moves by copy, so `KEY`
//     reads keep working after earlier reads and after the name is
//     shadowed in local scopes.
//   * `const KEY: Key` is a top-level constant of user data — not a
//     scalar literal — read directly, read as a machine parameter name,
//     and shadowed by `let KEY`.
//   * `local_key` shadows the constant in one let (the parameter wins the
//     spelling afterwards), `later_key` reads it BEFORE shadowing.
//
// The machine reads the constant twice, shadows it twice, and accepts
// when every read agrees on value 1 (constant) or 9 (parameter).
// Compile-checked only: no standard-library dependency.
data Key [copy] {
    value: u64;
}

const KEY: Key = Key { value: 1 };

machine root_key() -> Key {
    KEY
}

machine keep(KEY: Key) -> Key {
    KEY
}

machine local_key(input: Key) -> Key {
    let KEY: Key = input;
    KEY
}

machine later_key(input: Key) -> Key {
    let selected: Key = KEY;
    let KEY: Key = input;
    selected
}

machine copy_const_shadow() {
    let first: Key = root_key();
    let shadowed: Key = local_key(Key { value: 9 });
    let earlier: Key = later_key(Key { value: 9 });
    transition first.value == 1 && shadowed.value == 9 && earlier.value == 1 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
