// `dyn Trait<T>` — a named implementation erased to a
// dynamic selector: `Primary as dyn Shape<Item>` then
// `Shape::code<16>(selected, &item)` routes through the
// dyn value. A requirement whose `where` clause is a
// finite disjunction of complete binder tuples
// (`Width == 16 || Width == 32`) materializes every
// tuple's realization on selection alone — both
// `code<16>` and `code<32>` resolve with no static
// call demanding either.
//
//   * `machine code<Width: u32>(subject: &T) -> i32
//     where Width == 16 || Width == 32` — finite
//     generic family.
//   * `satisfies Shape<Item>::code` on the
//     implementing machine + `Primary satisfies
//     Shape<Item>` roster.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Shape<T> {
    machine code<Width: u32>(subject: &T) -> i32 where Width == 16 || Width == 32;
}

data Item {
    value: i32;
}

machine Item::code<Width: u32>(item: &Item) -> i32 satisfies Shape<Item>::code {
    transition { _ -> item.value }
}

Primary satisfies Shape<Item> {
    Shape::code = Item::code;
}

data Main {
    item: Item;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.item.value = 7;
    let selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let half: i32 = Shape::code<16>(selected, &main.item);
    let full: i32 = Shape::code<32>(selected, &main.item);
    transition half == 7 && full == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
