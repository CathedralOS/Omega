// dyn_selector_dispatch: runtime implementation selection as sample code —
// the first sample passing `Impl as dyn Trait<Data>` through an ordinary
// parameter. The selector names an implementation and carries no data.
//
//   * `pick` receives `shape: dyn Shape<Item>` and calls
//     `Shape::code(shape, item)` — the requirement runs through whichever
//     implementation the call site selected.
//   * CircleShape reports 9; SquareShape reads the item's 4 sides, so
//     9 * 10 + 4 == 94 proves both selections reached their own rows.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

trait Shape<T> {
    machine code(subject: &mut T) -> i32;
}

data Item {
    sides: i32;
}

CircleShape satisfies Shape<Item> {
    machine code(subject: &mut Item) -> i32 {
        transition {
            _ -> 9
        }
    }
}

SquareShape satisfies Shape<Item> {
    machine code(subject: &mut Item) -> i32 {
        transition {
            _ -> subject.sides
        }
    }
}

machine pick(shape: dyn Shape<Item>, item: &mut Item) -> i32 {
    Shape::code(shape, item)
}

machine dyn_selector_dispatch() {
    let mut item: Item = Item { sides: 4 };
    let a: i32 = pick(CircleShape as dyn Shape<Item>, &mut item);
    let b: i32 = pick(SquareShape as dyn Shape<Item>, &mut item);
    let n: i32 in Wrapping = (a as i32 in Wrapping) * 10 + (b as i32 in Wrapping);
    transition n == 94 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
