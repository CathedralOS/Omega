// Tag equality on enum members: a named empty `satisfies` conformance
// supplies structural `==`/`!=`, and a payload-LESS case member is a
// legal equality value even when a sibling case carries a payload —
// tag identity is total equality for the payload-free case.
//
//   * `CommandEquality satisfies Equatable<Command> { }` — the empty
//     block synthesizes structural equality.
//   * `main.cmd == Command::None` — comparing a member against a
//     constructed payload-free case.
//   * `!=` on the same conformance; `hits` counts arms.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Command {
    case None;
    case Move(dx: i32);
}

CommandEquality satisfies Equatable<Command> { }

data Main {
    cmd: Command;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut equal: bool = main.cmd == Command::None;
    main.cmd = Command::Move { dx: 3 };
    equal = main.cmd != Command::None;
    transition equal {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
