// Records holding slice views: `Sample.readings: &[i32]` built from a
// local array's subrange, read inside a callee through a record
// borrow. A `state` may carry its own `requires` roster after the
// signature — the callee's guard proves the bound the state's
// requires restates.
//
//   * `let sample = Sample { readings: backing[1..3] }` — slice field
//     initialized from an exclusive subrange.
//   * `inspect_values` transitions on `values.len`, the `read` state
//     restates the bound as a requires clause.
//   * `Counts::clone(&mut merged)` — `&mut` reborrow weakens to the
//     callee's shared loan.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Sample { readings: &[i32]; }
data Counts { tally: u64; }

machine Counts::clone(source: &Counts) -> Counts {
    Counts { tally: source.tally }
}

machine inspect_values(values: &[i32]) -> bool {
    transition 1 < values.len {
        true -> read(values)
        false -> (false)
    }
    machine read(values: &[i32]) -> bool
        requires 1 < values.len;
    {
        values.len == 2 && values[0] == 11 && values[1] == 13
    }
}

machine collect(merged: &mut Counts) -> u64 {
    let copy: Counts = Counts::clone(&mut merged);
    copy.tally
}

data Main { counts: Counts; hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.counts.tally = 9;
    let backing: [i32; 4] = [7, 11, 13, 17];
    let sample: Sample = Sample { readings: backing[1..3] };
    transition inspect_values(sample.readings) && collect(&mut main.counts) == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
