// An arm-bound record member moves to a state parameter, and a nested leaf of
// it loans onward as `&inner.leaf` to another state parameter.
data Leaf [copy] { v: i32 in Wrapping; }
data Inner [copy] { leaf: Leaf; other: i32 in Wrapping; }
data Shape {
    case Point;
    case Line(inner: Inner, tag: i32 in Wrapping);
}
data Main { shape: Shape; }
machine Main::main(main: &mut Main) {
    main.shape = Shape::Line {
        inner: Inner { leaf: Leaf { v: 7 }, other: 3 },
        tag: 9,
    };
    transition main.shape {
        Shape::Line { inner, tag } -> use_inner(main, inner)
        _ -> bad(main)
    }
    state use_inner(main: &mut Main, inner: Inner) {
        transition { _ -> read_leaf(main, &inner.leaf) }
    }
    state read_leaf(main: &mut Main, leaf: &Leaf) {
        transition leaf.v == 7 {
            true -> done(main)
            false -> bad(main)
        }
    }
    state done(main: &mut Main) { }
    state bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
