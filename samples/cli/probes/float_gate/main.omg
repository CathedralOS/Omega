// Float where-gates: `data Main where meter_value >= 0.0 &&
// meter_value <= 1.0` — the gate rides the carrier (zero-init
// satisfies it); mid-body field stores aren't construction, so
// `main.meter_value = 2.0` writes out-of-gate and `= 0.25`
// restores. Literal construction `Meter{value: 0.5}` FAILS to
// establish the same gate — see README.
//
//   * float `where` gate on a data field.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use omega::language::core::float_operations;

data Main
where
    meter_value >= 0.0 && meter_value <= 1.0,
{
    meter_value: f32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.meter_value = 2.0;
    main.meter_value = 0.25;
    transition main.meter_value == 0.25 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
