use omega\language\core\DllImport;
use omega\language\core\ForeignBinding;
machine build(builder: @mutable Build) {
    Build::application(builder, "adjacent_foreign_contracts");
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind_native::<Magnitude::absolute>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs" },
    });
    Build::bind_native::<Magnitude::alternate>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs" },
    });
}
