// Canonical `ProcessExit::exit_process` behind console output:
// direct `Console` and `ProcessExit` calls name separate provider
// slots from the same entry; `reaches Console +
// ProcessExit` grants output authority and the terminal outcome
// through the exact canonical requirement with its i32 status.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega_language_std::console;
machine dbl(x: i32) -> i32
requires
    0 <= x && x <= 1000;
{
    transition { _ -> (x + x) }
}
machine pick(x: i32) -> i32
requires
    0 <= x && x <= 1000;
{
    transition x > 50 {
        true -> (dbl(x))
        _ -> (x)
    }
}
data Main {
}
machine Main::main(context: &mut Main) reaches Console + ProcessExit {
    Console::write_line("before");
    ProcessExit::exit_process(pick(35));
}
