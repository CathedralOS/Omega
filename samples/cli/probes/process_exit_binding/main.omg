// Canonical `ProcessExit::exit_process` behind console output:
// direct `Console` and `ProcessExit` calls name separate provider
// slots from the same entry; `reaches StandardOutput +
// ProcessExit` grants output authority and the terminal outcome
// through the exact canonical requirement with its i32 status.
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
use system\Console;
machine dbl(x: i32) -> i32
requires
    0 <= x && x <= 1000
{
    transition { _ -> (x + x) }
}
machine pick(x: i32) -> i32
requires
    0 <= x && x <= 1000
{
    transition x > 50 {
        true -> (dbl(x)),
        _ -> (x)
    }
}
data Main {
}
machine Main::main(context: @mutable Main) reaches StandardOutput + ProcessExit {
    Console::write_line("before");
    ProcessExit::exit_process(pick(35));
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches StandardOutput + ProcessExit {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
