// Three-way name independence: the application's declared name
// (`app_declared`) differs from its directory; the dep lives in `depdir`,
// declares `dep_declared`, and imports under the requesting alias
// `depkit`. Declared names are diagnostic identity; the alias is the
// import name; the directory is on-disk reality — none needs to match.

use depkit::main;

machine build(builder: &mut Build) {
    Build::application(builder, "app_declared");
    Build::build_depend_as(builder, "depkit", Source::Path { location: "depdir" });
    Build::depend_as(builder, "depkit", Source::Path { location: "depdir" });
    builder.freestanding = true;
    let observed: i32 = value();
    transition observed == 9 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
