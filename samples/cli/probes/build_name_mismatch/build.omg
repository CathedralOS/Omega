use {omega}/build/dependency.omg;

machine build(plan: @mutable BuildPlan) {
    let mutable package: DependencyDescription = |dependency|::from_source(Source::Path { location: "depdir" });
    |dependency|::with_alias(@mutable package, "depkit");
    _ = |dependency|::add(plan, package);
    plan.product = BuildProduct::InterpretedBuild { entry: "configure.omg" };
}
