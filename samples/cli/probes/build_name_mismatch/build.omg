// Three-way name independence: the application's declared name
// (`app_declared`) differs from its directory; the dep lives in `depdir`,
// declares `dep_declared`, and imports under the requesting alias
// `depkit`. Declared names are diagnostic identity; the alias is the
// import name; the directory is on-disk reality — none needs to match.

use depkit::main;

machine build(builder: &mut Build) {
    Build::application(builder, "app_declared");
    let mut depkit_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "depdir" });
    dependency::with_alias(&mut depkit_dependency, "depkit");
    let depkit_registration: DependencyRegistration = Build::build_dependency(builder, depkit_dependency);
    let mut depkit_dependency_2: DependencyDescription = dependency::from_source(Source::Path { location: "depdir" });
    dependency::with_alias(&mut depkit_dependency_2, "depkit");
    let depkit_registration_2: DependencyRegistration = Build::dependency(builder, depkit_dependency_2);
    builder.freestanding = true;
    let observed: i32 = value();
    transition observed == 9 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
