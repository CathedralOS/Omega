// An effectful call may sit as the argument of a requires-bearing call: the
// writes to `counter` complete before `accept`'s requires is judged.
data Counter { hits: u32 in Wrapping; }
machine produce(value: u32, counter: &mut Counter) -> u32
requires value <= 20
ensures result <= 20 {
    counter.hits = counter.hits + 1;
    value
}
machine accept(value: u32) -> u32
requires value <= 20 {
    value
}
data Main { counter: Counter; }
machine Main::main(main: &mut Main) {
    main.counter = Counter { hits: 0 };
    let observed: u32 = accept(produce(7, &mut main.counter));
    transition observed == 7 && main.counter.hits == 1 {
        true -> done()
        false -> done()
    }
    machine done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
