use omega::language::core::ProcessExit;
// The canonical std `Clock` provider: a `reaches Console + Clock`
// multi-service ceiling, and `block Clock::sleep(200)` waits through the
// selected provider.
//
// Expected exit: 70
use omega_language_std::Console;
use omega_language_std::Clock;

machine entry_start() reaches ProcessExit + Console + Clock {
    block Clock::sleep(200);
    ProcessExit::exit_process(70);
}
