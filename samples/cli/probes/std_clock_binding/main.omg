// The canonical std `Clock` provider: a `reaches Console + Clock`
// multi-service ceiling, and `Clock::sleep(200)` blocks through the
// selected provider.
//
// Expected exit: 70
use omega_language_std::console;
use omega_language_std::clock;

machine entry_start() reaches Console + Clock {
    Clock::sleep(200);
    Console::exit_process(70);
}
