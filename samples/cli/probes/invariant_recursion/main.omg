// Measured tail-recursion with a multi-clause requires roster: the
// nonlinear arrival invariant `2 * acc + n * (n + 1) <= 10100`
// relates BOTH parameters — independent bounds would admit
// `triangle(100, 5050)` whose next step violates the bound; the
// recursive step preserves the total exactly. `terminates by n`
// measures the descent.
//
//   * `requires n <= 100, acc <= 5050, 2*acc + n*(n+1) <= 10100;` —
//     comma-separated clause roster, one nonlinear.
//   * One-arm `transition n == 0 { true -> acc }` then a bare
//     `triangle(n - 1, acc + n)` tail call as the body tail.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine triangle(n: u64, acc: u64) -> u64
requires n <= 100, acc <= 5050,
    2 * acc + n * (n + 1) <= 10100;
terminates by n;
{
    transition n == 0 {
        true -> acc
        false -> triangle(n - 1, acc + n)
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition triangle(4, 0) == 10 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
