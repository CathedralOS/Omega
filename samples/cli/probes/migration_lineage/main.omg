// A format package selects checked migration machines
// through a nominal lineage parameter: `satisfies
// FormatMigration<CounterDisk, CounterV1,
// Counter>::migrate` binds this machine to the disk
// lineage's migrate requirement while the same
// old/new pair under `CounterNetwork` gets its own
// non-aliased requirement identity.
//
//   * `{omega}/language/core/format_lineage.omg` declares the core lineage trait.
//   * Two `satisfies` rows differing only in the
//     lineage marker type.
//
// Compile-check this probe with its bundled system dependency.

use {omega}/language/core/format_lineage.omg;

data CounterDisk {
}

data CounterNetwork {
}

data CounterV1 {
    counter: i32;
}

data Counter {
    counter: i32;
    timestamp: i32;
}

machine counter_v1_to_current(
    old: CounterV1,
    out: @mutable Counter
) satisfies |format_lineage|::FormatMigration<CounterDisk, CounterV1, Counter>::migrate {
    out.counter = old.counter;
    out.timestamp = 0;
}

machine network_counter_v1_to_current(
    old: CounterV1,
    out: @mutable Counter
) satisfies |format_lineage|::FormatMigration<CounterNetwork, CounterV1, Counter>::migrate {
    out.counter = old.counter;
    out.timestamp = 1;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let old: CounterV1 = CounterV1 { counter: 9 };
    let mutable migrated: Counter;
    counter_v1_to_current(old, @mutable migrated);
    transition migrated.counter == 9 && migrated.timestamp == 0 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
