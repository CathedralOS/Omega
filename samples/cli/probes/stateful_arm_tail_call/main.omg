// A guarded arm's terminal call invokes a multi-state machine that keeps the
// borrowed receiver and takes a field read as an ordinary argument.
data Main { k: u64; }
machine Main::main(main: &mut Main) {
    main.k = 5;
    transition { _ -> Main::check(main, 7) }
}
machine Main::check(main: &mut Main, limit: u64) {
    let k_value: u64 = main.k;
    transition main.k < limit {
        true -> Main::verify(main, k_value)
        false -> bad(main)
    }
    machine bad(main: &mut Main) { }
}
machine Main::verify(main: &mut Main, received: u64) {
    transition received == main.k {
        true -> done(main)
        false -> bad(main)
    }
    machine done(main: &mut Main) { }
    machine bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
