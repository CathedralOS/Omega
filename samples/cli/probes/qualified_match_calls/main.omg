// Domain-qualified results through match composition: each arm of
// the match calls `mark(..)` producing `i64 in Coordinate<7>`; the
// match result feeds `relay(value: i64 in Coordinate<7>)` — the
// domain type flows out of the arm expressions. `as i64` on the
// whole match erases the qualification for an unqualified caller.
//
//   * `relay(match .. { true -> mark(l), false -> mark(r) })`.
//   * `relay(match ..) as i64` — `as` erasure on a match result.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain<const Axis: u64> i64::Coordinate<Axis>;

machine mark(value: i64) -> i64 in Coordinate<7> {
    value as i64 in Coordinate<7>
}

machine relay(value: i64 in Coordinate<7>) -> i64 in Coordinate<7> {
    value
}

machine choose(select_left: bool, left: i64, right: i64) -> i64 in Coordinate<7> {
    relay(match select_left {
        true -> mark(left),
        false -> mark(right)
    })
}

machine choose_plain(select_left: bool, left: i64, right: i64) -> i64 {
    relay(match select_left {
        true -> mark(left),
        false -> mark(right)
    }) as i64
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let tagged: i64 in Coordinate<7> = choose(true, 40, 41);
    let plain: i64 = choose_plain(false, 40, 41);
    transition tagged as i64 == 40 && plain == 41 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
