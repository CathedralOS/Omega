// Two build edges with different aliases select the same dependency
// directory once each. Two product aliases on one package already compile;
// this probes whether the build-purpose row family behaves the same way.

use k1::main;

machine build(builder: &mut Build) {
    Build::application(builder, "build_dup_build_edge");
    Build::build_depend_as(builder, "k1", Source::Path { location: "dependency" });
    Build::build_depend_as(builder, "k2", Source::Path { location: "dependency" });
    builder.freestanding = true;
    let observed: i32 = seed();
    transition observed == 3 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
