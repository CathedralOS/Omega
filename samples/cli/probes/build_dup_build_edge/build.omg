// Two build edges with different aliases select the same dependency
// directory once each. Two product aliases on one package already compile;
// this probes whether the build-purpose row family behaves the same way.

use k1::main;

machine build(builder: &mut Build) {
    Build::application(builder, "build_dup_build_edge");
    let mut k1_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut k1_dependency, "k1");
    let k1_registration: DependencyRegistration = Build::build_dependency(builder, k1_dependency);
    let mut k2_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut k2_dependency, "k2");
    let k2_registration: DependencyRegistration = Build::build_dependency(builder, k2_dependency);
    builder.freestanding = true;
    let observed: i32 = seed();
    transition observed == 3 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
