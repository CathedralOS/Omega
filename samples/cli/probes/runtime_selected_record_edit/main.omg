// Expected exit: 0.
// Runtime-selected record references edit caller storage without copying it.
data Event [copy] {
    identifier: u64;
    score: i32;
    enabled: bool;
}

trait Select<T> {
    machine pick(values: @mutable [T]) -> @mutable T requires values.length > 0;
}

First satisfies Select<Event> {
    machine pick(values: @mutable [Event]) -> @mutable Event
        requires values.length > 0
    { @mutable values[0] }
}

Last satisfies Select<Event> {
    machine pick(values: @mutable [Event]) -> @mutable Event
        requires values.length > 0
    { @mutable values[values.length - 1] }
}

machine selected<'input>(strategy: dyn Select<Event>, values: @'input mutable [Event])
    -> @'input mutable Event
    requires values.length > 0
{
    Select::pick(strategy, values)
}

machine main() crashes Trap {
    let mutable events: [Event; 3] = [
        Event { identifier: 18446744073709551615, score: 0, enabled: false },
        Event { identifier: 31, score: 5, enabled: false },
        Event { identifier: 9223372036854775808, score: 0, enabled: false }
    ];
    let mutable strategy: dyn Select<Event> = First as dyn Select<Event>;
    let first: @mutable Event = selected(strategy, @mutable events);
    first.score = 17;
    first.enabled = true;
    strategy = Last as dyn Select<Event>;
    let last: @mutable Event = selected(strategy, @mutable events);
    last.score = 23;
    last.enabled = true;
    transition events[0].score == 17 && events[2].score == 23
        && events[1].score == 5
        && events[0].enabled && !events[1].enabled && events[2].enabled
        && events[0].identifier == 18446744073709551615
        && events[1].identifier == 31
        && events[2].identifier == 9223372036854775808 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
