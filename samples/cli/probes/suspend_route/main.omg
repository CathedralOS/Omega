// Suspension surface: `boundary data` declares a provider-owned
// carrier; `boundary machine Sleeper::park(...) suspends;` declares
// a suspending boundary operation; `suspend <call>` parks the
// machine until the provider completes it. `suspends` is the
// machine's declared effect — ordinary callers must declare it
// too (or themselves be boundary reach).
//
//   * `public boundary data Sleeper;` — boundary-owned data.
//   * `boundary machine Sleeper::park(token: i32) suspends;` —
//     bodyless suspending boundary decl.
//   * `machine Worker::run(...) -> Token suspends` — declared
//     suspending machine; `suspend Sleeper::park(7)` inside.
//   * `token: Token in Carry::AcrossSuspend` — domain member on a
//     param: suspend-crossing carry qualification.
//   * `suspend block Task::finish(task)` shape is a boundary
//     requirement in core::task — kept to the plain-call form here.
//   * `hits` records the reached arm.
//
// Compile-checked only: suspending machines never run here — the
// probe exercises declaration and reach accounting.

use omega::language::core::task;

public boundary data Sleeper;

boundary machine Sleeper::park(token: i32) suspends;

public domain Token::AcrossSuspend(token)
requires
    token.id > 0;

public data Token {
    id: u64;
}

machine Worker::run(token: Token in AcrossSuspend) -> Token
suspends;
{
    suspend Sleeper::park(7);
    token
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
