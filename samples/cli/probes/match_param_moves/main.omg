// Owned match over PARAMETERS: `match selected { true -> left,
// false -> right }` — parameters are once-evaluated owned roots;
// the moved child owns the result slot. `match selected_u64`
// mixes literal arms and a `_ -> fallback` local.
//
//   * `result in Choice::Some` membership on a param-moved match.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Choice {
    case Empty;
    case Some(value: u32);
}

machine pick(selected: bool, left: Choice, right: Choice) -> Choice {
    match selected {
        true -> left,
        false -> right
    }
}

machine choose(selected: u64, left: Choice, right: Choice) -> bool {
    let fallback: Choice = Choice::Empty;
    let result: Choice = match selected {
        0 -> left,
        1 -> right,
        _ -> fallback
    };
    result in Choice::Some
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let a: Choice = pick(true, Choice::Some { value: 7 }, Choice::Empty);
    let seen: bool = choose(1, Choice::Empty, Choice::Some { value: 9 });
    transition a in Choice::Some && seen {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
