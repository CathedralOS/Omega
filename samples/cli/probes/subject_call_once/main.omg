// A transition's guard subject evaluates exactly ONCE per evaluation.
// `transition Main::roll(&mutable t) { false -> ... }` lowers to one guard
// per arm each holding the subject call; the callee must run a single
// time with every arm's comparison reusing that result. The callee
// counts invocations through `&mutable Tally` and returns false, so the
// second arm runs — the tally proves the subject fired exactly once.
//
//   * `transition Main::roll(&mutable main.tally)` — call subject with a
//     mutable borrow, both arms comparing the same evaluation.
//   * `Main::roll -> bool` — value machine whose side channel counts.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Tally { calls: u64; }

machine Main::roll(tally: @mutable Tally) -> bool {
    tally.calls = ((tally.calls as u64 +Wrapping) + 1) as u64;
    transition { _ -> false }
}

data Main { tally: Tally; hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    main.tally.calls = 40;
    transition Main::roll(@mutable main.tally) {
        true -> first(main),
        false -> second(main)
    }
    machine first(main: @mutable Main) { main.hits = 1; }
    machine second(main: @mutable Main) {
        transition main.tally.calls == 41 {
            true -> good(main),
            _ -> bad(main)
        }
    }
    machine good(main: @mutable Main) { main.hits = 2; }
    machine bad(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
