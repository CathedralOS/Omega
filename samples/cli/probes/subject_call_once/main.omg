// A transition's guard subject evaluates exactly ONCE per evaluation.
// `transition Main::roll(&mut t) { false -> ... }` lowers to one guard
// per arm each holding the subject call; the callee must run a single
// time with every arm's comparison reusing that result. The callee
// counts invocations through `&mut Tally` and returns false, so the
// second arm runs — the tally proves the subject fired exactly once.
//
//   * `transition Main::roll(&mut main.tally)` — call subject with a
//     mutable borrow, both arms comparing the same evaluation.
//   * `Main::roll -> bool` — value machine whose side channel counts.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Tally { calls: u64; }

machine Main::roll(tally: &mut Tally) -> bool {
    tally.calls = ((tally.calls as u64 in Wrapping) + 1) as u64;
    transition { _ -> false }
}

data Main { tally: Tally; hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.tally.calls = 40;
    transition Main::roll(&mut main.tally) {
        true -> first(main)
        false -> second(main)
    }
    state first(main: &mut Main) { main.hits = 1; }
    state second(main: &mut Main) {
        transition main.tally.calls == 41 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { main.hits = 2; }
    state bad(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
