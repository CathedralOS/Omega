use omega\language\core\ProcessExit;
// Overlapping mutable windows of one row. The checker must reject this
// before any native run.

data Main { }

machine Main::main(main: @mutable Main) reaches ProcessExit {
    let mutable row: [i32 in Wrapping; 4] = [0, 0, 0, 0];
    transition { _ -> overlap(main, @mutable row[0..3], @mutable row[2..4]) }
    machine overlap(main: @mutable Main, left: @mutable [i32 in Wrapping], right: @mutable [i32 in Wrapping]) {
        left[0] = 1;
        right[0] = 2;
        ProcessExit::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
