// Slice reborrow: `&mut [u64]` received as a param re-projects as
// `&mut buf` into a second machine — the borrow of a borrow keeps
// the unsized element surface. Unconditional `transition { _ -> }`
// routes are plain jumps.
//
//   * `drain(buf: &mut [u64], ...)` → `probe(&mut buf, ...)` —
//     reborrow of a mutable slice param.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Filter { threshold: u64; }

machine probe(buf: &mut [u64], filter: &Filter, index: u64)
requires index < buf.len;
{
    transition buf[index] > filter.threshold {
        true -> bump(buf, index)
        _ -> done()
    }
    machine bump(buf: &mut [u64], index: u64)
    requires index < buf.len;
    { buf[index] = 99; }
    machine done() { }
}

machine drain(buf: &mut [u64], filter: &Filter, index: u64)
requires index < buf.len;
{
    transition { _ -> probe(&mut buf, filter, index) }
}

data Main {
    items: [u64; 3];
    filter: Filter;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.items = [10, 50, 80];
    main.filter.threshold = 40;
    drain(&mut main.items[..], &main.filter, 1);
    transition main.items[1] == 99 && main.items[0] == 10 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
