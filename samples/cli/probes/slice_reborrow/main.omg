// Slice reborrow: `&mutable [u64]` received as a param re-projects as
// `&mutable buf` into a second machine — the borrow of a borrow keeps
// the unsized element surface. Unconditional `transition { _ -> }`
// routes are plain jumps.
//
//   * `drain(buf: &mutable [u64], ...)` → `probe(&mutable buf, ...)` —
//     reborrow of a mutable slice param.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Filter { threshold: u64; }

machine probe(buf: @mutable [u64], filter: @Filter, index: u64)
requires index < buf.length
{
    transition buf[index] > filter.threshold {
        true -> bump(buf, index),
        _ -> done()
    }
    machine bump(buf: @mutable [u64], index: u64)
    requires index < buf.length
    { buf[index] = 99; }
    machine done() { }
}

machine drain(buf: @mutable [u64], filter: @Filter, index: u64)
requires index < buf.length
{
    transition { _ -> probe(@mutable buf, filter, index) }
}

data Main {
    items: [u64; 3];
    filter: Filter;
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    main.items = [10, 50, 80];
    main.filter.threshold = 40;
    drain(@mutable main.items[..], @main.filter, 1);
    transition main.items[1] == 99 && main.items[0] == 10 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
