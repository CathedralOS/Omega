// Exact subtraction discharged by requires + guard: `remaining - 2`
// is exact-u64 arithmetic — legal here ONLY because the entry
// `requires remaining <= 5` bounds the value and the `remaining >= 2`
// transition guard proves the operand order. No domain, no `as`.
//
//   * requires + transition-guard facts compose into the exact-arith
//     obligation.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine walk(remaining: u64) -> u64
requires
    remaining <= 5;
{
    transition remaining >= 2 {
        true -> finish(remaining - 2)
        false -> remaining
    }
    state finish(value: u64) -> u64 { value }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition walk(4) == 2 && walk(1) == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
