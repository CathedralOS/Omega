// Bare float literals (no `f32`/`f64` suffix) land at the
// format of the computed operand they compare against —
// every comparison direction and operator works.
//
//   * `F32::square_root(64.0f32) == 8.0` and
//     `8.0 == F64::square_root(64.0f64)` — forward and
//     reversed operands.
//   * `<`, `<=`, `>=`, `!=` all fold against the bare
//     literal.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::float_operations;

machine f32_result() -> bool {
    F32::square_root(64.0f32) == 8.0
}

machine f64_result() -> bool {
    F64::square_root(64.0f64) == 8.0
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition f32_result() && f64_result()
        && 8.0 == F64::square_root(64.0f64)
        && F32::square_root(64.0f32) < 9.0
        && 7.0 < F64::square_root(64.0f64)
        && F32::square_root(64.0f32) != 7.0 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
