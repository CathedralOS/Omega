// Opaque representations: `boundary data Token [copy]`
// declares an opaque carrier; `TokenRepresentation
// satisfies OpaqueRepresentation<Token, TokenBytes>` names
// its authorized byte-level view in a sibling module. The
// opaque type travels as data while the representation
// shape stays an implementation choice.
//
//   * `use token;` sibling-file module import.
//   * `Token` as a machine param + field.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use token;

data Main {
    held: Token;
    hits: i32 in Wrapping;
}

machine Main::relay(input: Token) -> Token {
    input
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let token_value: Token;
    main.held = Main::relay(token_value);
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
