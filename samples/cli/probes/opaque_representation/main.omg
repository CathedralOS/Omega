// Opaque representations: `boundary data Token [copy]`
// declares an opaque carrier; `TokenRepresentation
// satisfies OpaqueRepresentation<Token, TokenBytes>` names
// its authorized byte-level view in a sibling module. The
// opaque type travels as data while the representation
// shape stays an implementation choice.
//
//   * `use token.omg;` selects the file declaring `Token`.
//   * `|token|::Token` is a machine parameter and field type.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use token.omg;

data Main {
    held: |token|::Token;
    hits: i32 in Wrapping;
}

machine Main::relay(input: |token|::Token) -> |token|::Token {
    input
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let token_value: |token|::Token;
    main.held = Main::relay(token_value);
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
