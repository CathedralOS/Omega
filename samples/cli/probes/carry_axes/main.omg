// Explicit carry axes: `[carry(suspension: allowed, cpu: any,
// thread: any, address: movable)]` — the closed property spelled
// with per-axis values on a case-data aggregate and its nested
// envelope.
//
//   * `Packet` carries a case payload; `Envelope` nests it.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Packet [carry(
    suspension: allowed,
    cpu: any,
    thread: any,
    address: movable,
)] {
    id: i32;
    case Empty;
    case Burst(count: i32, priority: u8);
}

data Envelope [carry(
    suspension: allowed,
    cpu: any,
    thread: any,
    address: movable,
)] {
    inner: Packet;
    stamp: i64;
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let envelope: Envelope = Envelope {
        inner: Packet::Burst { count: 2, priority: 9, id: 4 },
        stamp: 7
    };
    transition envelope.inner {
        Packet::Burst { count, .. } -> burst(count, main)
        Packet::Empty -> fail(main)
    }
    machine burst(count: i32, main: &mut Main) {
        transition count == 2 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
