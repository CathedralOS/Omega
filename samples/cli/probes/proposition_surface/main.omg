// User-authored propositions: named predicates with generic,
// const, and machine parameters, plus proposition ALIASES —
// `requires`/`ensures` quote them by spelling.
//
//   * `proposition terminal_relation<T, const Limit: u32, machine
//     Generator>(value: T);` — full paramaterized predicate.
//   * `proposition alias<T, ...>(v) = terminal_relation<T, ...>(v);`
//     — alias forwards its parameters.
//   * `requires terminal_relation_alias<i32, 7, terminal_constant>(7i32)`
//     — proposition instance spelling a contract; typed literal
//     argument `7i32`. Declaration-surface only: proposition facts
//     are evidence-borne — `forwarded` stays uncalled.
//   * `127u64 as u8` — literal `as` narrowing inside a machine.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

proposition terminal_relation<T, const Limit: u32, machine Generator>(value: T);

proposition terminal_relation_alias<T, const Limit: u32, machine Generator>(value: T) =
    terminal_relation<T, Limit, Generator>(value);

machine terminal_constant() -> i32
requires 7i32 == 7i32
ensures 7i32 == 7i32
{
    7i32
}

machine forwarded() -> i32
requires terminal_relation_alias<i32, 7, terminal_constant>(7i32)
ensures terminal_relation_alias<i32, 7, terminal_constant>(7i32)
{
    7i32
}

machine narrow_literal() -> u8 {
    127u64 as u8
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition terminal_constant() == 7 && narrow_literal() == 127 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
