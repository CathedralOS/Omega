// Two `&mut` arguments from sibling fields of the same
// owner in one call: `Sink::fill(&mut main.sink,
// &mut main.buf[..])` — the receiver and a whole-array
// mutable byte slice are disjoint loans coexisting for
// the call's duration.
//
//   * `&mut main.buf[..]` — `[..]` projects a fixed byte
//     array as a `&mut [u8]` argument rooted at a field
//     path.
//   * The callee mutates both sides: `bytes[0] = 9`
//     through the slice, `sink.filled` on the receiver.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Sink {
    filled: u64;
}

machine Sink::fill(sink: &mut Sink, bytes: &mut [u8]) {
    transition bytes.len >= 1 {
        true -> filled(sink, bytes)
        _ -> skipped(sink)
    }
    state filled(sink: &mut Sink, bytes: &mut [u8]) {
        bytes[0] = 9;
        sink.filled = bytes.len;
    }
    state skipped(sink: &mut Sink) {
        sink.filled = 0;
    }
}

data Main {
    sink: Sink;
    buf: [u8; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    Sink::fill(&mut main.sink, &mut main.buf[..]);
    transition main.sink.filled == 4 && main.buf[0] == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
