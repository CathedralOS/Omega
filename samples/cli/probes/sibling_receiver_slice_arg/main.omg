// Two `&mutable` arguments from sibling fields of the same
// owner in one call: `Sink::fill(&mutable main.sink,
// &mutable main.buf[..])` — the receiver and a whole-array
// mutable byte slice are disjoint loans coexisting for
// the call's duration.
//
//   * `&mutable main.buf[..]` — `[..]` projects a fixed byte
//     array as a `&mutable [u8]` argument rooted at a field
//     path.
//   * The callee mutates both sides: `bytes[0] = 9`
//     through the slice, `sink.filled` on the receiver.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Sink {
    filled: u64;
}

machine Sink::fill(sink: @mutable Sink, bytes: @mutable [u8]) {
    transition bytes.length >= 1 {
        true -> filled(sink, bytes),
        _ -> skipped(sink)
    }
    machine filled(sink: @mutable Sink, bytes: @mutable [u8]) {
        bytes[0] = 9;
        sink.filled = bytes.length;
    }
    machine skipped(sink: @mutable Sink) {
        sink.filled = 0;
    }
}

data Main {
    sink: Sink;
    buf: [u8; 4];
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    Sink::fill(@mutable main.sink, @mutable main.buf[..]);
    transition main.sink.filled == 4 && main.buf[0] == 9 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
