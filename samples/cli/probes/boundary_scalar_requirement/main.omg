// A `boundary requirement` publishes a scalar result:
// `boundary requirement TimedWait::poll(descriptors,
// count, timeout) -> i32` — a bodyless consuming
// contract whose call returns `i32`, and a later state
// of a receiverless machine produces the machine's
// result from it. Provider selection happens through
// ForeignBinding machines (target-scoped) — see
// foreign_binding_forms.
//
//   * The declaration alone carries `reaches Clock` —
//     its callers inherit the service requirement.
//   * `at_once` is the later state that performs the
//     wait and forwards the code.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

boundary trait Clock { machine tick() reaches; }

data TimedWait { }

boundary requirement TimedWait::poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32) -> i32
reaches
    Clock;

machine TimedWait::wait() -> i32 reaches Clock {
    transition {
        _ -> at_once()
    }
    machine at_once() -> i32 {
        TimedWait::poll(0, 0, 20)
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition true {
        true -> done(main)
        _ -> done(main)
    }
    machine done(main: &mut Main) { main.hits = 1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
