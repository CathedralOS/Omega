machine build(builder: &mut Build) {
    Build::application(builder, "boundary_scalar_requirement");
    Build::select_provider<TimedWait, TimedWaitPoll>(builder, linux_arm64);
    Build::select_provider<TimedWait, TimedWaitPoll>(builder, linux_x86_64);
    Build::select_provider<TimedWait, TimedWaitPoll>(builder, macos_arm64);
    Build::select_provider<TimedWait, TimedWaitPoll>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
