// A case `where T == i32` refutes on `Value<bool>`: `Integer` is impossible
// on this instance, so a transition covering only `Boolean` is already
// exhaustive — no `_` arm needed.
data Value<T> {
    case Integer(value: T) where T == i32;
    case Boolean(value: T) where T == bool;
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let v: Value<bool> = Value::Boolean { value: true };
    transition v {
        Value::Boolean { value } -> done(main, value)
    }
    state done(main: &mut Main, value: bool) {
        transition value == true {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) {
        main.hits = main.hits + 1;
    }
    state bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
