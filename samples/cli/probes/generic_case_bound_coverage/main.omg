// A case `where T == i32` refutes on `Value<bool>`: `Integer` is impossible
// on this instance, so a transition covering only `Boolean` is already
// exhaustive — no `_` arm needed.
data Value<T> 
    requires ((self in Value::Integer) && (T == i32)) || ((self in Value::Boolean) && (T == bool))
{
    case Integer(value: T);
    case Boolean(value: T);
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: @mutable Main) {
    let v: Value<bool> = Value::Boolean { value: true };
    transition v {
        Value::Boolean { value } -> done(main, value)
    }
    machine done(main: @mutable Main, value: bool) {
        transition value == true {
            true -> good(main),
            _ -> bad(main)
        }
    }
    machine good(main: @mutable Main) {
        main.hits = main.hits + 1;
    }
    machine bad(main: @mutable Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
