// A where-gated record constructed in both field
// orders: `Pair { left: 1, right: 2 }` and `Pair
// { right: 2, left: 1 }` are the same value — the
// `left <= right` premise evaluates over the named
// fields, not the literal's order, and a first↔second
// state cycle walks the storage between seeds.
//
//   * `data Pair where left <= right, { left: u64;
//     right: u64; }` — comma before the field block
//     binds the where clause.
//   * Unconditional `transition true` edges form the
//     first↔second cycle.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Pair where left <= right, { left: u64; right: u64; }
data Storage { pair: Pair; }

machine Storage::walk(storage: &mut Storage, choose_left: bool) {
    transition choose_left {
        true -> seed_left(storage)
        false -> seed_right(storage)
    }
    state first(storage: &mut Storage) {
        transition true { true -> second(storage) false -> done(storage) }
    }
    state second(storage: &mut Storage) {
        transition true { true -> first(storage) false -> done(storage) }
    }
    state seed_left(storage: &mut Storage) {
        storage.pair = Pair { left: 1, right: 2 };
        transition true { true -> first(storage) false -> first(storage) }
    }
    state seed_right(storage: &mut Storage) {
        storage.pair = Pair { right: 2, left: 1 };
        transition true { true -> second(storage) false -> second(storage) }
    }
    state done(storage: &mut Storage) {
        storage.pair.left = 2;
    }
}

data Main { storage: Storage; hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    Storage::walk(&mut main.storage, true);
    transition main.storage.pair.left == 2 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
