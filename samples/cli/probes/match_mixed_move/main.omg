// Mixed match arms: one arm moves a named local (`left`), the other
// constructs the result inline (`Choice::Empty`). Ownership splits
// per-arm — only the moved arm consumes a root.
//
//   * `result in Choice::Some` membership on a mixed-source match.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Choice {
    case Empty;
    case Some(value: u32);
}

machine choose(selected: bool) -> bool {
    let left: Choice = Choice::Some { value: 37 };
    let result: Choice = match selected {
        true -> left,
        false -> Choice::Empty
    };
    result in Choice::Some
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition choose(true) && !choose(false) {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
