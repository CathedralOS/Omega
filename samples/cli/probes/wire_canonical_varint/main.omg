// Canonical LEB128 establishment: the generated decoder
// rejects overlong encodings (extra zero group) and
// payload bits beyond u64, while the canonical ten-group
// `u64::MAX` frame stays valid — each rejected stream
// returns `WireVerdict::Invalid` without partial writes
// past the checked prefix.
//
//   * `Scalar::decode(&mut overlong, &payload, &mut
//     read, &mut verdict)` — the same decoder accepts
//     malformed and canonical inputs, reporting per call.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Scalar {
    #0 value: u64;
}

data ScalarValue {
    value: u64;
}

data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    overlong_read: u64;
    overlong_verdict: WireVerdict;
    overflow_read: u64;
    overflow_verdict: WireVerdict;
    good_read: u64;
    good_verdict: WireVerdict;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    // Era 0, tag 0, then zero encoded with two groups
    // instead of one.
    let overlong_payload: [u8; 4] = [0, 0, 128, 0];
    let overlong: ScalarValue = ScalarValue { value: 7 };
    Scalar::decode(
        &mut overlong,
        &overlong_payload,
        &mut main.overlong_read,
        &mut main.overlong_verdict,
    );
    // Payload bits beyond u64's range in the tenth group.
    let overflow_payload: [u8; 12] = [0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 3, 0];
    let overflow: ScalarValue = ScalarValue { value: 7 };
    Scalar::decode(
        &mut overflow,
        &overflow_payload,
        &mut main.overflow_read,
        &mut main.overflow_verdict,
    );
    // Canonical u64::MAX: ten 7-bit groups, MSB group 1.
    let good_payload: [u8; 12] = [0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 1, 0];
    let good: ScalarValue = ScalarValue { value: 7 };
    Scalar::decode(
        &mut good,
        &good_payload,
        &mut main.good_read,
        &mut main.good_verdict,
    );
    let matches: bool = main.overlong_verdict == WireVerdict::Invalid
        && main.overflow_verdict == WireVerdict::Invalid
        && main.good_verdict == WireVerdict::Sound
        && good.value == 18446744073709551615u64;
    transition matches {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
