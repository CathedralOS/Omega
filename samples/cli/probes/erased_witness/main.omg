// `[erased]` marks proof-side positions that take no runtime slot.
//
//   * `case Proven(value: i32, proof [erased]: Evidence)` — the
//     erased payload fills itself from its unique nullary
//     constructor at `Certified::Proven { value: 70 }`; destructuring
//     discards it `proof as _`.
//   * `bound [erased]: i32` — an erased machine parameter used only
//     by `requires n < bound`; it forwards to the state's own erased
//     parameter as that binding's initializer, not a runtime read.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Evidence { case Only; }
data Certified {
    case Pending;
    case Proven(value: i32, proof [erased]: Evidence);
}

machine Main::record(n: i32, bound [erased]: i32)
requires
    n < bound
{
    transition { _ -> store(n, bound) }
    machine store(n: i32, bound [erased]: i32)
    requires
        n < bound
    {
        let mut total: i32 = n;
    }
}

data Main {
    record: Certified;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    Main::record(3, 10);
    main.record = Certified::Proven { value: 70 };
    transition main.record {
        Certified::Proven { value, proof as _ } -> good(main, value)
        Certified::Pending -> bad(main)
    }
    machine good(main: &mut Main, value: i32) {
        transition value == 70 {
            true -> pass(main)
            _ -> bad(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine bad(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
