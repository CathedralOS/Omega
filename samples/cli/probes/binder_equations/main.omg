// Domain-index binder equations: `data TinyBytes<Length, const
// Capacity: u64> where Length == u64::AtMost<Capacity>` — instantiations
// satisfy the equation exactly: omitted binder (`TinyBytes<u64 in AtMost<256> >`
// and `TinyBytes<u64 in AtMost<257> >`), explicit pair (`TinyBytes<u64 in AtMost<256>, 256>`),
// and domain equation `Length == u64::AtMost<Capacity>`.
//
//   * Four instantiation spellings on one generic data.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain<const Bound: u64> u64::AtMost<Bound>(value) requires value <= Bound;

data TinyBytes<Length, const Capacity: u64>
where
    Length == u64::AtMost<Capacity>
{
    storage: [u8; Capacity];
    length: Length;
}

data Domained<Length, const Capacity: u64>
where
    Length == u64::AtMost<Capacity>
{
    storage: [u8; Capacity];
    length: Length;
}

data Shapes {
    inclusive: TinyBytes<u64 in AtMost<256> >;
    exclusive: TinyBytes<u64 in AtMost<257> >;
    explicit: TinyBytes<u64 in AtMost<256>, 256>;
    domained: Domained<u64 in AtMost<256>, 256>;
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let shapes: Shapes = Shapes {};
    transition shapes.inclusive.storage.len == 256
        && shapes.exclusive.storage.len == 257
        && shapes.domained.storage.len == 256 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
