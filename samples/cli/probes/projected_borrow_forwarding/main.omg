// Expected exit: 0
// The returned view retains the supplied element, not its outer container.
// Aliasing and forwarding keep its captured selector when the cursor changes.
data Cell { value: i32; spare: i32; }
data Envelope requires cursor <= 1 { cells: [Cell; 2]; cursor: u64; marker: i32; }

machine pick(cell: @mutable Cell) -> @mutable i32 { @mutable cell.value }
machine forward(value: @mutable i32) -> @mutable i32 { value }

machine exercise(envelope: @mutable Envelope) -> bool {
    envelope.cursor = 1;
    let cell: @mutable Cell = @mutable envelope.cells[envelope.cursor];
    let selected: @mutable i32 = forward(pick(cell));
    envelope.cursor = 0;
    envelope.marker = 7;
    $selected = 29;
    envelope.cells[1].value == 29 && envelope.marker == 7 && envelope.cursor == 0
}

machine exercise_composed(envelope: @mutable Envelope) -> bool {
    transition { _ -> nested(envelope) }
    machine nested(envelope: @mutable Envelope) -> bool {
        envelope.cursor = 1;
        let cell: @mutable Cell = @mutable envelope.cells[envelope.cursor];
        let selected: @mutable i32 = forward(forward(pick(cell)));
        envelope.cursor = 0;
        envelope.marker = 7;
        $selected = 29;
        envelope.cells[1].value == 29 && envelope.marker == 7 && envelope.cursor == 0
    }
}

data Pair { first: Cell; second: Cell; }
machine collect(source: @mutable Pair) -> [@mutable Cell; 2] {
    [@mutable source.first, @mutable source.second]
}
machine exercise_pair() -> bool {
    let mutable pair: Pair;
    let messages: [@mutable Cell; 2] = collect(@mutable pair);
    let first: @mutable Cell = messages[0];
    let second: @mutable Cell = messages[1];
    first.value = 11;
    second.value = 70;
    pair.first.value == 11 && pair.second.value == 70
}

machine main() crashes Trap {
    let mutable envelope: Envelope;
    transition exercise(@mutable envelope) && exercise_composed(@mutable envelope) && exercise_pair() {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
