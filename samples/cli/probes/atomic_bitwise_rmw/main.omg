// Bitwise read-modify-write on both atomic widths: fetch_or/fetch_and/
// fetch_xor each return the committed PRIOR value; NoOrdering is the weakest
// ordering atom.
data Main { cell32: AtomicU32; cell64: AtomicU64; }
machine Main::main(main: &mut Main) {
    main.cell32.store(2147483658, GlobalOrder);
    let prior: u32 = main.cell32.fetch_or(5, ReceivePublish);
    transition prior == 2147483658 {
        true -> and32(main)
        false -> bad(main)
    }
    machine and32(main: &mut Main) {
        let prior: u32 = main.cell32.fetch_and(4294967287, ReceivePublish);
        transition prior == 2147483663 {
            true -> xor32(main)
            false -> bad(main)
        }
    }
    machine xor32(main: &mut Main) {
        let prior: u32 = main.cell32.fetch_xor(15, ReceivePublish);
        transition prior == 2147483658 {
            true -> wide(main)
            false -> bad(main)
        }
    }
    machine wide(main: &mut Main) {
        main.cell64.store(18446744073709551615, GlobalOrder);
        let prior: u64 = main.cell64.fetch_and(18446744073709551608, NoOrdering);
        transition prior == 18446744073709551615 {
            true -> done(main)
            false -> bad(main)
        }
    }
    machine done(main: &mut Main) { }
    machine bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
