// Expected exit: 0.
// The package boundary retains read capability for one method, an empty reach
// for the other, and the separately declared synchronous interface for both.
use {reviewed_service}/operations.omg;
Reader satisfies |operations|::Operations {
    machine read(value: i32) -> i32 { read_value_provider(value) }
    machine identity(value: i32) -> i32 { identity_provider(value) }
}
machine read_value_provider(value: i32) -> i32 { value }
machine identity_provider(value: i32) -> i32 { value }
data Main { }
machine check_reviewed_operations(main: @mutable Main) reaches |operations|::ReadCapability crashes Trap {
    let read: i32 = |operations|::read_value(17);
    let pure: i32 = |operations|::pure_value(39);
    transition read == 17 && pure == 39 { true -> good(), false -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |operations|::ReadCapability crashes Trap {
    let mutable entry_storage: Main;
    check_reviewed_operations(@mutable entry_storage);
}
