machine build(builder: &mut Build) {
    Build::application(builder, "reviewed_service_rows");
    let mut reviewed_service_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../../../tests/omega/pass/effects/reviewed_service_rows_exit/library" });
    dependency::with_alias(&mut reviewed_service_dependency, "reviewed_service");
    let reviewed_service_registration: DependencyRegistration = Build::dependency(builder, reviewed_service_dependency);
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../source/library/std" }));
    Build::select_provider<reviewed_service::Operations, Reader>(builder, linux_arm64);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, linux_x86_64);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, macos_arm64);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, macos_x86_64);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, windows_x86_64);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, uefi_x86_64);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, cross_platform_cli);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, local_unchecked);
    Build::select_provider<reviewed_service::Operations, Reader>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
