// boundary_crash_route: boundary machines and conditional crash routes —
// the first sample declaring a `boundary machine` and satisfying it.
//
//   * `boundary machine == Comparison::equal` overloads `==` for i32
//     through the Comparison carrier and declares a conditional crash
//     route: `crashes Trap !(right >= 0)` — any `==` whose right operand
//     can't be proven non-negative propagates the Trap route.
//   * `ComparisonProvider::equal` satisfies the boundary machine — the
//     provider IS an ordinary machine bound by `satisfies`.
//   * `safe` discharges the route with its own `requires value >= 0`
//     (the call's context covers the boundary's `right >= 0` fact);
//     `may_crash` propagates it and `wrapper` covers by declaration.
//   * The entry calls both on the dormant path (right = 0 ≥ 0).
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
boundary machine == Comparison::equal(left: i32, right: i32) -> bool
crashes Trap !(right >= 0);

data Comparison { }
data ComparisonProvider { }

machine ComparisonProvider::equal(left: i32, right: i32) -> bool
    satisfies Comparison::equal
{
    transition left < right {
        true -> false
        _ -> !(right < left)
    }
}

public machine safe(value: i32) -> bool
requires value >= 0 {
    1 == value
}

machine may_crash(left: i32, right: i32) -> bool {
    left == right
}

public machine wrapper(left: i32, right: i32) -> bool
crashes Trap {
    may_crash(left, right)
}

machine boundary_crash_route() crashes Trap {
    let discharged: bool = safe(1);
    let covered: bool = wrapper(2, 2);
    transition discharged && covered {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
