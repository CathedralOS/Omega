// The dependency package is the custody subject: the root reaches it through
// a Build edge and a Product edge in one request. Its own build consults a
// generator package through a nested build edge, reads an authored template
// through the captured source inventory, and stages a generated product
// source through the required-output obligation flow — require the name,
// write and seal the staged file, then complete the obligation against it.

use generator::main;

machine build(builder: &mut Build) {
    Build::package(builder, "custody_kernel");
    Build::build_depend_as(builder, "generator", Source::Path { location: "../generator" });
    let answer: i32 = generation_value();
    transition answer == 7 {
        true -> generate(builder)
        _ -> wrong()
    }
    machine generate(builder: &mut Build) {
        let template: BuildPath = BuildSource::resolve(&builder.source, "template.txt");
        let reader: i32 = BuildSource::open(&builder.source, template, 0);
        let mut bytes: [u8; 38];
        _ = BuildSource::read(&builder.source, reader, &mut bytes, 38);
        let _closed_reader: i32 = BuildSource::close(&builder.source, reader);
        let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "generated.omg");
        let generated: BuildPath = BuildOutput::resolve(&builder.output, "generated.omg");
        let writer: i32 = BuildOutput::create(&mut builder.output, generated, 0);
        _ = BuildOutput::write(&mut builder.output, writer, &bytes);
        let _sealed: i32 = BuildOutput::close(&mut builder.output, writer);
        BuildOutput::include_source(&mut builder.output, generated);
        let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, generated);
        settle(builder, settled);
    }
    machine wrong() {
    }
}

machine settle(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "generated source did not seal");
    }
}
