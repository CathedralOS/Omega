// `complete` accepts only a sealed staged file: this build retires no
// writer before completing its required output, so `complete` must hand
// the obligation and file custody back as `OutputCompletion::Retry`, and
// the only remaining disposition — an authored sticky failure — keeps the
// required-output demand unmet.

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_unsealed_output_retry" };
    Build::artifact_only(builder);
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "manifest.txt");
    let path: BuildPath = BuildOutput::resolve(@builder.output, "manifest.txt");
    let writer: i32 = BuildOutput::create(@mutable builder.output, path, 0);
    _ = BuildOutput::write(@mutable builder.output, writer, "omega artifact\n");
    let settled: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, path);
    settle(builder, settled);
}

machine settle(builder: @mutable BuildPlan, settled: OutputCompletion) {
    transition settled {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> unsealed(builder, obligation)
    }
    machine sealed(builder: @mutable BuildPlan) {
    }
    machine unsealed(builder: @mutable BuildPlan, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "staged output never sealed");
    }
}
