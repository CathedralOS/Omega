// A RequiredOutput obligation is a linear value only the evaluator's
// private table may issue. Constructing `RequiredOutput {}` in source
// forges custody of a name the activation never reserved; completing
// against the forged obligation must be rejected.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_forged_obligation");
    Build::artifact_only(builder);
    let forged: RequiredOutput = RequiredOutput {};
    let path: BuildPath = BuildOutput::resolve(&builder.output, "artifact.txt");
    let writer: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, writer, "forged\n");
    _ = BuildOutput::close(&mut builder.output, writer);
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, forged, path);
    settle(builder, settled);
}

machine settle(builder: &mut Build, settled: OutputCompletion) {
    transition settled {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> unsealed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    machine unsealed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "staged output never sealed");
    }
}
