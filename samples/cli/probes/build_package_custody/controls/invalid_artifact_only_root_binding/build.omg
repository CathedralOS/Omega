// An artifact-only application publishes companion files and binds no
// executable route, so a ProgramEntry binding names a row the mode never
// requests. The declaration must be rejected even though the required
// output below would otherwise settle.

machine build(builder: &mut Build) {
    Build::application(builder, "invalid_artifact_only_root_binding");
    Build::artifact_only(builder);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "companion.txt");
    let path: BuildPath = BuildOutput::resolve(&builder.output, "companion.txt");
    let writer: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, writer, "omega artifact\n");
    _ = BuildOutput::close(&mut builder.output, writer);
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, path);
    settle(builder, settled);
}

machine settle(builder: &mut Build, settled: OutputCompletion) {
    transition settled {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> unsealed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    machine unsealed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "staged output never sealed");
    }
}
