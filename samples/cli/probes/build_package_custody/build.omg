// One dependency package serves this root through both scopes in a single
// request: the Build scope alias `kit` (an aliased `Build::build_dependency`) and the Product
// scope alias `product_kit` (an aliased `Build::dependency`). The request therefore carries two
// purpose slots on one package, and the dependency's own build — a
// generator-backed source producer — must evaluate once to serve both.
//
// The root's own build calls the dependency's product machine through the
// kit edge, and `main.omg` calls the same machine through the product edge;
// both routes must see the generated source the dependency staged.

use kit::main;

machine build(builder: &mut Build) {
    Build::application(builder, "build_package_custody");
    let mut kit_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut kit_dependency, "kit");
    let kit_registration: DependencyRegistration = Build::build_dependency(builder, kit_dependency);
    let mut product_kit_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut product_kit_dependency, "product_kit");
    let product_kit_registration: DependencyRegistration = Build::dependency(builder, product_kit_dependency);
    builder.freestanding = true;
    let observed: i32 = value();
    transition observed == 7 {
        true -> done()
        _ -> wrong()
    }
    machine done() {
    }
    machine wrong() {
    }
}
