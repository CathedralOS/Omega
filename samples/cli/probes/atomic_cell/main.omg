// Atomic cells: `AtomicU32` field with value-method operations —
// `store`, `fetch_add`, `compare_exchange` — each spelling the
// ordering (`NoOrdering`, `ReceivePublish`, `Receive`). `fetch_add`
// returns the PRIOR value; `compare_exchange` returns the observed
// prior either way. The cell compares directly against a scalar.
//
//   * `main.counter.store(10, NoOrdering)` — plain store.
//   * `fetch_add(5, NoOrdering)` → prior 10, cell 15.
//   * `compare_exchange(15, 99, ReceivePublish, Receive)` → prior 15,
//     cell 99.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Main {
    counter: AtomicU32;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.counter.store(10, NoOrdering);
    let old1: u32 in Wrapping = main.counter.fetch_add(5, NoOrdering);
    transition old1 == 10 && main.counter == 15 {
        true -> second(main)
        _ -> fail(main)
    }
    machine second(main: &mut Main) {
        let prior: u32 in Wrapping =
            main.counter.compare_exchange(15, 99, ReceivePublish, Receive);
        transition prior == 15 && main.counter == 99 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
