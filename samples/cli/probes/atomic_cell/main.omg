// A successful exchange installs 99. On mismatch its result carries the
// value observed by the instruction.
use {omega}/language/core/layout.omg;

data Main {
    counter: AtomicU32;
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    main.counter.store(10, NoOrdering);
    let prior: u32 = main.counter.fetch_add(5, NoOrdering);
    transition prior == 10 && main.counter.load(Receive) == 15 {
        true -> second(main),
        _ -> fail(main)
    }
    machine second(main: @mutable Main) {
        let outcome: |layout|::AtomicCompareExchangeOutcome<u32> =
            main.counter.compare_exchange(15, 99, ReceivePublish, Receive);
        transition outcome {
            |layout|::AtomicCompareExchangeOutcome::Exchanged -> verify(main),
            |layout|::AtomicCompareExchangeOutcome::Mismatched { observed } -> fail(main)
        }
    }
    machine verify(main: @mutable Main) {
        transition main.counter.load(Receive) == 99 {
            true -> pass(main),
            _ -> fail(main)
        }
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
