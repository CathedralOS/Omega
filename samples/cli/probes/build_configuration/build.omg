// Writable Build configuration fields compose freely on a
// freestanding application: subsystem (all four cases), authored
// identifier, ELF interpreter selection, granular privileged-service
// admissions, x86 deployment features, and the optimization counter
// roster via Optimizations::enable / emit_report.
machine build(builder: &mut Build) {
    Build::application(builder, "build_configuration");
    builder.freestanding = true;
    builder.subsystem = Subsystem::Gui;
    builder.subsystem = Subsystem::EfiApplication;
    builder.subsystem = Subsystem::Console;
    builder.subsystem = Subsystem::Unspecified { value: 7 };
    builder.identifier = "com.example.build-configuration";
    builder.elf_interpreter.linux_x86_64 = "/lib64/ld-linux-x86-64.so.2";
    builder.privileged_services.port_io = true;
    builder.privileged_services.interrupt_table = true;
    builder.x86_deployment_features = X86DeploymentFeatures::AvxFma3;
    Optimizations::enable(&mut builder.optimizations, Optimization::CopyPropagation);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Optimizations::emit_report(&mut builder.optimizations);
}
