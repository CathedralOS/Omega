// Module-qualified machine calls as const contract
// endpoints: `const GOOD: u64 = 2;` checked by
// `requires GOOD <= |selected|::limit()` — the bound is a call into a sibling module's
// `limit()`, evaluated in const context. Two sibling
// files each define their own `limit()`; the qualified
// spelling keeps them distinct.
//
//   * `use selected/selected.omg;` selects the sibling file owning the called limit.
//   * `requires GOOD <= |selected|::limit()` — module-qualified
//     call endpoint.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use selected/selected.omg;

const GOOD: u64 = 2;

machine limit() -> u64 { 0 }

machine check_good() requires GOOD <= |selected|::limit() {}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    check_good();
    main.hits = 0;
    transition GOOD == 2 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
