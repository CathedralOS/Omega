// Read through an owner before consumption and after
// re-establishment: `let snapshot: i32 = g.handle;` copies a
// scalar out before `drop(g)`; `g = Guard { handle: snapshot }`
// RE-ESTABLISHES the owner so reads after observe the new value.
//
//   * `drop_guard(&mut Guard)` `dropped by` hook.
//   * Whole-record replacement re-establishes a dropped owner.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.


data Guard dropped by drop_guard {
    handle: i32;
}

machine drop_guard(guard: &mut Guard) {
}

machine consume(value: Guard) {
}

machine work() -> i32 {
    let mut g: Guard = Guard { handle: 7 };
    let snapshot: i32 = g.handle;
    drop(g);
    g = Guard { handle: snapshot };
    let restored: i32 = g.handle;
    consume(g);
    restored
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = work() as i32 in Wrapping;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
