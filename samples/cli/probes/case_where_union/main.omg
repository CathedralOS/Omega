// case_where_union: per-case `where` clauses on generic enum data as
// sample code — the first sample declaring `case ... where` bounds.
//
//   * `Value<T>` gates each case on the type parameter: `Integer` admits
//     only `T == i32`, `Boolean` only `T == bool`. On `Value<i32>` the
//     Boolean case is refuted — the same data declaration is a different
//     union per instantiation.
//   * Construction is the gate again: `Value::Integer { value: 7 }` at
//     `Value<i32>` proves `T == i32`.
//   * The transition destructures the active case's payload; the refuted
//     case never needs an arm — the compiler knows `Boolean` cannot be
//     active under `i32`.
//
// The machine stores Integer(7) and Boolean(true) values at their own
// instantiations, reads each payload, and accepts on 7 == 7 && flag.
// Compile-checked only: no standard-library dependency.
data Value<T> {
    case Integer(value: T) where T == i32;
    case Boolean(value: T) where T == bool;
}

machine case_where_union() {
    let numeric: Value<i32> = Value::Integer { value: 7 };
    let flag: Value<bool> = Value::Boolean { value: true };
    transition numeric {
        Value::Integer { value } -> check_flag(flag, value)
        _ -> done(71)
    }

    machine check_flag(flag: Value<bool>, num: i32) {
        transition flag {
            Value::Boolean { value } -> judge(num, value)
            _ -> done(72)
        }
    }

    machine judge(num: i32, truth: bool) {
        transition num == 7 && truth {
            true -> done(70)
            _ -> done(73)
        }
    }

    machine done(code: i32) {}
}
