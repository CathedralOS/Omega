// The compiler-owned build log facet takes an explicit operand:
// `BuildLog::write_line(@mutable builder.log, text)` — the line is
// retained in the build observation summary and emitted with the
// compile's other output.
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_log_write" };
    BuildLog::write_line(@mutable builder.log, "omega build log witness");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
