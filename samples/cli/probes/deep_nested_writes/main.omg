// Deep write paths: struct-in-struct field write, a sum constructed into a
// struct field destructured back through the nested path, and an
// array-of-struct element field write (indexed + member combined).
data Msg { case Ping(x: i32); case Pong(y: i32, z: i32); }
data Inner { a: u32; b: u32; }
data Outer { first: Inner; second: Inner; }
data Holder { tag: u32; msg: Msg; }
data Main { nested: Outer; holder: Holder; pair: [Inner; 2]; }
machine Main::main(main: &mut Main) {
    main.nested.second.b = 5;
    main.holder.msg = Msg::Pong { y: 3, z: 8 };
    main.pair[1].a = 9;
    transition { _ -> read_nested(main) }
    state read_nested(main: &mut Main) {
        transition main.nested.second.b == 5 && main.pair[1].a == 9 {
            true -> read_sum(main)
            false -> bad(main)
        }
    }
    state read_sum(main: &mut Main) {
        transition main.holder.msg {
            Msg::Pong { y, z } -> done(main, y)
            Msg::Ping { x } -> bad(main)
        }
    }
    state done(main: &mut Main, y: i32) { }
    state bad(main: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
