// trait_default_chain: trait inheritance and default requirement bodies as
// sample code — the first sample with a parent-trait bound
// (`Resettable<T>: Settable<T>`), default bodies that call requirements by
// bare spelling in the trait's scope, and a named implementation that
// binds a requirement to a data-attached machine
// (`Settable::set = Counter::set`).
//
//   * `reset` is a DEFAULT body: it calls `prepare` and `set`, each run
//     through the conforming implementation's own rows.
//   * `Counter::set` is the bound row: value 10 marks `prepared`, anything
//     else just stores — so reset() leaves value 30 AND prepared true.
//   * `Store<Container, Item>` is a two-parameter trait whose `put_twice`
//     default calls `put` under the conformance's Item.
//
// The machine resets a counter (30, prepared) and put_twice-appends 7 to a
// ledger (count 2, sum 14). Compile-checked only: no standard-library
// dependency, no ProcessExit provider.
trait Settable<T> {
    machine set(subject: &mut T, value: i32);
}

trait Resettable<T>: Settable<T> {
    machine prepare(subject: &mut T) {
        set(subject, 10);
    }

    machine reset(subject: &mut T) {
        prepare(subject);
        set(subject, 30);
    }
}

trait Store<Container, Item> {
    machine put(subject: &mut Container, item: Item);

    machine put_twice(subject: &mut Container, item: Item) {
        put(subject, item);
        put(subject, item);
    }
}

data Counter {
    value: i32;
    prepared: bool;
}

CounterResettable satisfies Resettable<Counter> {
    Settable::set = Counter::set;
}

machine Counter::set(counter: &mut Counter, value: i32) {
    transition value == 10 {
        true -> prepared(counter)
        _ -> assigned(counter, value)
    }

    machine prepared(counter: &mut Counter) {
        counter.prepared = true;
        counter.value = 10;
    }

    machine assigned(counter: &mut Counter, value: i32) {
        counter.value = value;
    }
}

data Ledger {
    total: i32 in Wrapping;
    count: i32 in Wrapping;
}

LedgerStore satisfies Store<Ledger, i32> {
    Store::put = Ledger::put;
}

machine Ledger::put(ledger: &mut Ledger, item: i32) {
    ledger.total = ledger.total + (item as i32 in Wrapping);
    ledger.count = ledger.count + 1;
}

machine trait_default_chain() {
    let mut counter: Counter = Counter { value: 0, prepared: false };
    CounterResettable::reset(&mut counter);
    transition counter.value == 30 && counter.prepared {
        true -> check_ledger()
        _ -> done(71)
    }

    machine check_ledger {
        let mut ledger: Ledger = Ledger { total: 0, count: 0 };
        LedgerStore::put_twice(&mut ledger, 7);
        transition ledger.count == 2 && ledger.total == 14 {
            true -> done(70)
            _ -> done(72)
        }
    }

    machine done(code: i32) {}
}
