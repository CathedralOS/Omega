// Module-qualified generics: `first::Envelope<u64>` and
// `second::Envelope<u64>` instantiate two same-name generic data
// from sibling module files; `first::Envelope::read<u64>` /
// `second::Envelope::read<u64>` are module-qualified generic
// machine calls.
//
//   * `read_first`/`read_second`/`read_again`/`read_boolean`
//     cross-module instantiation spellings.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

use first;
use second;

machine read_first(value: &first::Envelope<u64>) -> u64 { first::Envelope::read<u64>(value) }
machine read_second(value: &second::Envelope<u64>) -> u64 { second::Envelope::read<u64>(value) }
machine read_again(value: &first::Envelope<u64>) -> u64 { first::Envelope::read<u64>(value) }
machine read_boolean(value: &first::Envelope<bool>) -> bool { first::Envelope::read<bool>(value) }

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let one: first::Envelope<u64> = first::Envelope { value: 7 };
    let two: second::Envelope<u64> = second::Envelope { other: 9 };
    let flag: first::Envelope<bool> = first::Envelope { value: true };
    transition read_first(&one) == 7 && read_second(&two) == 9
        && read_again(&one) == 7 && read_boolean(&flag) {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
