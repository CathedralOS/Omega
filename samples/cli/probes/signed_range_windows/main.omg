// Requires rosters on free machines carrying `&&` chains and `.len`
// bounds, exclusive and inclusive range subslices, a subslice view of a
// view, and a slice domain granted through a bounded window.
//
//   * `head` and `window_len` are ordinary free machines whose
//     `requires` rosters mention `items.len` — signed `i64` index and
//     range bounds the checker discharges from literals.
//   * `items[start..end]` is an exclusive-range subslice; `view[0..=1]`
//     is an inclusive-range view OF a view.
//   * `narrow_u64_to_i32_wrapping`/`widen_u8_to_i32` are the named
//     conversion machines from `core::numeric_conversion` — `as T in D`
//     only re-qualifies a value inside the same carrier width.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider — one core import (`numeric_conversion`) supplies the named
// narrow/widen machines used to cross u64/u8 -> i32.
use omega::language::core::numeric_conversion;

machine head(items: &[u8], index: i64) -> u8
requires
    0 <= index && index < items.len;
{
    items[index]
}

machine window_len(items: &[u8], start: i64, end: i64) -> u64
requires
    0 <= start && start <= end && end <= items.len;
{
    let view: &[u8] = items[start..end];
    view.len
}

machine Main::stamp(main: &mut Main) {
}

data Main {
    slots: [u8; 5];
    total: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.slots = [10, 20, 30, 40, 50];
    let all: &[u8] = &main.slots[..];
    // window_len(&all[..], 1, 4) -> 3; head(&all[..], 4) -> 50.
    main.total = (narrow_u64_to_i32_wrapping(window_len(all, 1, 4)) as i32 in Wrapping)
        + (widen_u8_to_i32(head(all, 4)) as i32 in Wrapping);
    // Inclusive range on a view of a view: prefix[0..=1] has len 2.
    let window: &[u8] = all[1..4];
    let prefix: &[u8] = window[0..=1];
    main.total = main.total + (narrow_u64_to_i32_wrapping(prefix.len) as i32 in Wrapping);
    transition main.total == 55 {
        true -> Main::stamp(main)
        false -> Main::stamp(main)
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
