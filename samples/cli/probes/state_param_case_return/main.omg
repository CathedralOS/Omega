// A returned case payload taken from an owned structural STATE PARAMETER:
// `pc_err` carries `kind: Kind` as a formal and returns
// `Res::Error { kind: kind }`.
data Kind { case Other; case NotFound; }
data Res { case Error(kind: Kind); case Empty; }
data Probe { seen: i32; }
machine Probe::classify(probe: @mutable Probe, flag: bool) -> Res {
    probe.seen = 1;
    transition flag {
        true -> pc_empty(probe),
        _ -> pc_err(probe, Kind::NotFound)
    }
    machine pc_empty(probe: @mutable Probe) -> Res { Res::Empty }
    machine pc_err(probe: @mutable Probe, kind: Kind) -> Res { Res::Error { kind: kind } }
}
data Main { probe: Probe; result: Res; }
machine Main::main(main: @mutable Main) {
    main.result = Probe::classify(@mutable main.probe, false);
    transition main.result {
        Res::Empty -> bad(main),
        _ -> good(main)
    }
    machine good(main: @mutable Main) { }
    machine bad(main: @mutable Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
