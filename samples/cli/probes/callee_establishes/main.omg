// Cross-machine establishment: `recruit` returns a gated
// `Player` on every path — establishment is globally
// monotone, so the call's result joins the caller's
// tracking and the read AFTER the call passes the access
// gate. The gated record arrives as a result, not a
// carrier field (entry contexts must be valid at zero).
//
//   * `Main::recruit(strength) -> Player requires 1 <=
//     strength, strength <= 100`.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Player
where
    health >= 1,
{
    health: i32;
}

data Main { hits: i32 in Wrapping; }

machine Main::recruit(strength: i32) -> Player
requires 1 <= strength, strength <= 100
{
    Player { health: strength }
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let champion: Player = Main::recruit(50);
    let power: i32 = champion.health;
    transition power == 50 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
