// Domain-qualified match inside a call argument:
// `relay(match sel { true -> mark(l), false -> mark(r) })` — the
// match types `i64 in Coordinate<7>` because both arms produce the
// qualified type, and it feeds `relay`'s `i64 in Coordinate<7>`
// parameter position directly.
//
//   * `domain<const Axis: u64> i64::Coordinate<Axis>` const
//     parameter domain.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain<const Axis: u64> i64::Coordinate<Axis>;

machine mark(value: i64) -> i64 in Coordinate<7> {
    value as i64 in Coordinate<7>
}

machine relay(value: i64 in Coordinate<7>) -> i64 in Coordinate<7> {
    value
}

machine choose(select_left: bool, left: i64, right: i64) -> i64 in Coordinate<7> {
    relay(match select_left {
        true -> mark(left),
        false -> mark(right)
    })
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let chosen: i64 in Coordinate<7> = choose(true, 3, 4);
    transition chosen as i64 == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
