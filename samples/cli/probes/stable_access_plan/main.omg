use {omega}/language/core/access/access.omg as access;
use {omega}/language/core/layout.omg as layout;
use {omega}/language/core/reflect/reflect.omg as reflect;

public data Pair {
    readable: u32;
    hidden: u32;
}
public domain Pair::Restricted access PairAccess;

PairAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan
    reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflect|::field(Pair::readable),
            |layout|::FieldAccess::Stable {
                read: true, take: false, write: false, swap: false,
                exposure: |layout|::Exposure::Exported
            });
        |access|::observe(@mutable plan, |reflect|::field(Pair::hidden), |layout|::FieldAccess::Inaccessible);
        plan
    }
}

machine read_only(field: @|layout|::FieldAccess) -> bool reaches none crashes none terminates {
    match field {
        |layout|::FieldAccess::Stable { read, take, write, swap, exposure as _ } ->
            read && take == false && write == false && swap == false,
        _ -> false
    }
}

machine inaccessible(field: @|layout|::FieldAccess) -> bool reaches none crashes none terminates {
    match field { |layout|::FieldAccess::Inaccessible -> true, _ -> false }
}

const PolicyIsReadOnly: bool = check_policy();

machine check_policy() -> bool {
    let plan: |layout|::AccessPlan = PairAccess::plan(|reflect|::schema::<Pair>());
    plan.field_count == 2u64 && read_only(@plan.fields[0].access) && inaccessible(@plan.fields[1].access)
}

machine entry_start() crashes Trap {
    transition PolicyIsReadOnly {
        true -> done(), _ -> fail()
    }
    machine done() {}
    machine fail() { crash Trap; }
}
