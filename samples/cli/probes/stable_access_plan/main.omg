use omega::language::core::layout;
// `FieldAccess::Stable { read, write, exposure }` — a plain bool-grant
// access row beside the External materialization kind.
public data Pair { readable: u32; hidden: u32; }
data PairAccess {}
machine PairAccess::plan(schema: Schema, layout: Plan) -> AccessPlan
satisfies Access::plan
{
    let plan: AccessPlan = AccessPlan::inaccessible(&schema);
    transition { _ -> expose(schema, plan) }
    machine expose(schema: Schema, plan: AccessPlan) -> AccessPlan {
        AccessPlan::with(
            plan,
            schema.fields[0].key,
            FieldAccess::Stable {
                read: true,
                write: false,
                exposure: Exposure::Exported
            }
        )
    }
}
data Main { pair: Pair; hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.pair.readable = 3;
    main.hits = main.hits + (main.pair.readable as i32 in Wrapping);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
