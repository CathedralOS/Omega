// A cyclic machine takes a SHARED borrow of a plain fixed
// array: `scan`'s step ↔ body cycle goes through the
// unranked-cycle eligibility gate — a shared loan freezes
// its referent so every arrival observes the same
// storage. `body`'s own `index < 3` requirement makes
// `index + 1` exact, no re-guard states needed.
//
//   * `machine scan(numbers: &[i32; 3]) -> i32` — borrowed
//     whole-array param riding a state cycle.
//   * `requires index >= 0` + `transition index < 3` —
//     range arithmetic inside the cycle.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine scan(numbers: &[i32; 3]) -> i32 {
    transition {
        _ -> step(numbers, 0, 0)
    }

    machine step(numbers: &[i32; 3], index: i32, best: i32) -> i32
    requires index >= 0 {
        transition index < 3 {
            true -> body(numbers, index, best)
            _ -> done(best)
        }
    }

    machine body(numbers: &[i32; 3], index: i32, best: i32) -> i32
    requires index >= 0 && index < 3 {
        let candidate: i32 = numbers[index];
        transition candidate > best {
            true -> step(numbers, index + 1, candidate)
            _ -> step(numbers, index + 1, best)
        }
    }

    machine done(best: i32) -> i32 { best }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let numbers: [i32; 3] = [4, 42, 23];
    let found: i32 = scan(&numbers);
    transition found == 42 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
