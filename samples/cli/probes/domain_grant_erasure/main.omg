// Domain grants and erasure: four grant routes and two erasure routes.
//
//   * `Token::Issued established by TokenIssuer::issue` — provenance-
//     locked: only a machine carrying `ensures result in Issued` may
//     produce the qualification; `satisfies` binds the impl.
//   * `5 as i32 in Positive` — `as` grants a REQUIRES-carrying scalar
//     domain when the literal proves the clause (contrast: requires
//     clauses over slices/machines have no working grant — filed gap).
//   * `90 as i32 in Degrees` — vacuous domains grant freely.
//   * `x as i32` and `let plain: i32 = qualified` — bare-`as` erases the
//     domain (semantic + arithmetic policy); a plain-type let forgets
//     predicate qualifications implicitly.
//   * `issued as Token` — provenance erases like predicates.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Token [copy] {
    value: u64;
}

domain Token::Issued
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue(value: u64) -> Token
    ensures
        result in Token::Issued;
}

machine Token::issue(value: u64) -> Token
satisfies TokenIssuer::issue
ensures
    result in Token::Issued
{
    Token { value: value }
}

domain i32::Positive(value)
requires
    value >= 0;

domain i32::Degrees;

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;

    // Grants.
    let positive: i32 in Positive = 5 as i32 in Positive;
    let degrees: i32 in Degrees = 90 as i32 in Degrees;
    let issued: Token in Issued = Token::issue(70);

    // Erasures — every route leaves a provable plain value behind.
    let forgotten: i32 = positive;
    let stripped: i32 = degrees as i32;
    let plain: Token = issued as Token;

    transition forgotten + stripped == 95 && plain.value == 70 {
        true -> Main::ok(main)
        _ -> Main::bad(main)
    }
    state ok(main: &mut Main) { main.hits = 1; }
    state bad(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
