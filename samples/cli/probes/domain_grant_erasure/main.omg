// The issuer returns a qualified token. The scalar grants below establish
// their own predicates. Each removal names the domain its value gives up.

data Token [copy] {
    value: u64;
}

domain Token::Issued
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue(value: u64) -> Token in Issued
    ensures
        result in Token::Issued;
}

machine issue(value: u64) -> Token in Issued
satisfies TokenIssuer::issue
ensures
    result in Token::Issued
{
    Token { value: value } as +Issued
}

domain i32::Positive
requires
    self >= 0;

domain i32::Degrees;

machine entry_start() crashes Trap {
    // Grants.
    let positive: i32 in Positive = 5 as i32 +Positive;
    let degrees: i32 in Degrees = 90 as i32 +Degrees;
    let issued: Token in Issued = issue(70);

    // Erasures — every route leaves a provable plain value behind.
    let forgotten: i32 = positive as -Positive;
    let stripped: i32 = degrees as -Degrees;
    let plain: Token = issued as -Issued;

    transition forgotten + stripped == 95 && plain.value == 70 {
        true -> ok(),
        _ -> bad()
    }
    machine ok() {}
    machine bad() crashes Trap { crash Trap; }
}
