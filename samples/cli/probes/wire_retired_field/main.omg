// Retired wire field identities: `retired #3;` inside the data
// body permanently withdraws a published field number so a later
// edit cannot accidentally reuse it for a different meaning.
//
//   * `#N` field tags coexist with `retired #M;` markers.
//   * `hits` records the reached arm.
//
// Compile-checked only: declaration surface, no standard-library
// dependency, no ProcessExit provider.

data CounterMessage {
    #0 counter: i32;
    #1 timestamp_millis: i64;

    retired #3;
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}
