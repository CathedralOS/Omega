// Proof-Nat import surface: `use omega\language\core\nat`
// brings Nat into a depend-free package and Nat values flow through
// ordinary machines.
//
// Nat's `-` and `<=` are core's public operator machines `subtract`
// and `less_or_equal`. A package selects them by their tokens after
// importing both machines, as the stage 06 `nat_order` fixtures do.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega\language\core\Nat;

machine relay(total: Nat, used: Nat) -> Nat {
    transition { _ -> (total) }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
