// Proof-Nat import surface: `use omega::language::core::nat`
// brings Nat into a depend-free package and Nat values flow through
// ordinary machines.
//
// GAP filed (probe-found): EVERY Nat operator is private to
// core::nat's own package — `total - used` selects private
// `Nat::subtract`, `used <= total` selects private
// `Nat::less_or_equal`, and `Nat::saturating_sub` does not resolve
// as a callable entry. The corpus fixture
// proofs/nat_exact_subtraction_compile compiles under hermetic
// compiler provenance, not package provenance, so Nat arithmetic
// is effectively unreachable from user packages today.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::nat;

machine relay(total: Nat, used: Nat) -> Nat {
    transition { _ -> (total) }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
