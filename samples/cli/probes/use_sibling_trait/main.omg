// `use contracts/drawable.omg` brings a sibling file's trait into scope;
// `Sprite::draw` satisfies it with the unqualified trait name.
use contracts/drawable.omg;

data Canvas {
    width: i32;
}
data Sprite {
    id: i32;
}
data Main {}
machine Sprite::draw(sprite: @Sprite, canvas: @mutable Canvas) satisfies |drawable|::Drawable<Sprite, Canvas>::draw {
    canvas.width = 80;
}
machine Main::main(main: @mutable Main) {
    let sprite: Sprite;
    let mutable canvas: Canvas;
    Sprite::draw(@sprite, @mutable canvas);
}
