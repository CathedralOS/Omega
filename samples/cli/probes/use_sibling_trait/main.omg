// `use contracts::drawable` brings a sibling file's trait into scope;
// `Sprite::draw` satisfies it with the unqualified trait name.
use contracts::drawable;

data Canvas {
    width: i32;
}
data Sprite {
    id: i32;
}
data Main {}
machine Sprite::draw(sprite: &Sprite, canvas: &mut Canvas) satisfies Drawable<Sprite, Canvas>::draw {
    canvas.width = 80;
}
machine Main::main(main: &mut Main) {
    let sprite: Sprite;
    let mut canvas: Canvas;
    Sprite::draw(&sprite, &mut canvas);
}
