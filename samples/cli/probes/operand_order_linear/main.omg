// Operand order with a linear member move: `holder.token =
// transform(holder.token.value, holder.token)` — the scalar
// read evaluates BEFORE the move extracts the member, even
// though both appear in one statement.
//
//   * `drop_token` hook writes `token.value = 0` (mutating
//     disposition).
//   * `repair(&mutable Holder)` forwards the field place.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.


data Token [linear] dropped by drop_token { value: u64; }
machine drop_token(token: @mutable Token) { token.value = 0; }

data Holder { marker: u64; token: Token; }

machine transform(value: u64, token: Token) -> Token {
    drop(token);
    Token { value: value }
}

machine repair(holder: @mutable Holder) {
    holder.token = transform(holder.token.value, holder.token);
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let mutable holder: Holder = Holder { marker: 19, token: Token { value: 41 } };
    repair(@mutable holder);
    let value: u64 = holder.token.value;
    let outcome: bool = holder.marker == 19 && value == 41;
    drop(holder.token);
    transition outcome {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
