// Operand order with a linear member move: `holder.token =
// transform(holder.token.value, holder.token)` — the scalar
// read evaluates BEFORE the move extracts the member, even
// though both appear in one statement.
//
//   * `Token::drop` hook writes `token.value = 0` (mutating
//     disposition).
//   * `repair(&mut Holder)` forwards the field place.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) { token.value = 0; }

data Holder { marker: u64; token: Token; }

machine transform(value: u64, token: Token) -> Token {
    drop(token);
    Token { value: value }
}

machine repair(holder: &mut Holder) {
    holder.token = transform(holder.token.value, holder.token);
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut holder: Holder = Holder { marker: 19, token: Token { value: 41 } };
    repair(&mut holder);
    let value: u64 = holder.token.value;
    let outcome: bool = holder.marker == 19 && value == 41;
    drop(holder.token);
    transition outcome {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
