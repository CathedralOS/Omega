// Expected exit: 0. Placed accessor writes affect their original RAM backing.
use {omega}/language/core/access/access.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/reflect/reflect.omg;

public data Registers requires transmit <= 10 {
    status: u32;
    transmit: u8;
}

public domain Registers::Placed access RegisterAccess;
public data RegisterStorage = |layout|::LayoutStorage<Registers, RegisterLayout>;

public RegisterLayout satisfies |layout|::FixedLayout<Registers> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan
    reaches none crashes none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 4 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 2, size_fixed: 8, size_is_dynamic: false, align: 4 }
    }
}

public RegisterAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan
    reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflect|::field(Registers::status),
            |layout|::FieldAccess::External { read: |layout|::ExternalRead::Read, write: false, exposure: |layout|::Exposure::Exported });
        |access|::observe(@mutable plan, |reflect|::field(Registers::transmit),
            |layout|::FieldAccess::External { read: |layout|::ExternalRead::None, write: true, exposure: |layout|::Exposure::Exported });
        plan
    }
}

machine mutate(view: @mutable RegisterStorage in Registers::Placed) -> u32 {
    transition { _ -> access(view) }
    machine access(view: @mutable RegisterStorage in Registers::Placed) -> u32 {
        |layout|::write::<|layout|::Accessor<u8>, u8>(@mutable view.transmit, 9u8);
        |layout|::read::<|layout|::Accessor<u32>, u32>(@view.status)
    }
}
machine choose<'a>(left: @'a mutable RegisterStorage in Registers::Placed,
                   right: @'a mutable RegisterStorage in Registers::Placed,
                   first: bool) -> @'a mutable RegisterStorage in Registers::Placed {
    transition first {
        true -> left,
        _ -> right
    }
}

machine exercise(first: bool) crashes Trap {
    let mutable left: Registers = Registers { status: 41, transmit: 3 };
    let mutable right: Registers = Registers { status: 73, transmit: 5 };
    let left_view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable left);
    let right_view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable right);
    let selected: @mutable RegisterStorage in Registers::Placed = choose(left_view, right_view, first);
    let observed: u32 = mutate(selected);
    transition first {
        true -> check(observed == 41 && left.transmit == 9 && right.transmit == 5),
        _ -> check(observed == 73 && left.transmit == 3 && right.transmit == 9)
    }
    machine check(correct: bool) {
        transition correct { true -> done(), _ -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

machine main() crashes Trap {
    exercise(true);
    exercise(false);
    let mutable registers: Registers = Registers { status: 41, transmit: 3 };
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable registers);
    let observed: u32 = mutate(view);
    transition observed == 41 && registers.transmit == 9 {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
