// Expected exit: 0.
// Publish whole match records through borrowed partitions without flattening them.
data Match [copy] { position: u64; value: i32; }
data Partition<'storage> { records: @'storage mutable [Match]; count: u64; }

machine capture(position: u64, value: i32) -> Match { Match { position: position, value: value } }

machine emit<'storage>(partitions: @mutable [Partition<'storage>], selected: u64, record: Match) -> bool {
    transition selected < partitions.length {
        true -> capacity(partitions, selected, record),
        false -> false
    }
    machine capacity(partitions: @mutable [Partition<'storage>], selected: u64, record: Match) -> bool
    requires selected < partitions.length {
        transition partitions[selected].count < partitions[selected].records.length {
            true -> store(partitions, selected, record),
            false -> false
        }
    }
    machine store(partitions: @mutable [Partition<'storage>], selected: u64, record: Match) -> bool
    requires selected < partitions.length
        && partitions[selected].count < partitions[selected].records.length {
        let position: u64 = partitions[selected].count;
        partitions[selected].records[position] = record;
        partitions[selected].count = partitions[selected].count + 1;
        true
    }
}

machine main() crashes Trap {
    let mutable first: [Match; 3] = [
        Match { position: 91, value: -1 }, Match { position: 92, value: -2 },
        Match { position: 93, value: -3 }
    ];
    let mutable second: [Match; 2] = [Match { position: 81, value: -4 }, Match { position: 82, value: -5 }];
    let mutable partitions: [Partition; 2] = [
        Partition { records: @mutable first[1..2], count: 0 },
        Partition { records: @mutable second[1..2], count: 0 }
    ];
    let record: Match = capture(9223372036854775808, 17);
    let appended: bool = emit(@mutable partitions[..], 1, record);
    let other: bool = emit(@mutable partitions[..], 0, capture(23, 31));
    let full: bool = emit(@mutable partitions[..], 1, capture(47, 53));
    let missing: bool = emit(@mutable partitions[..0], 0, capture(59, 61));
    transition appended && other && !full && !missing
        && partitions[0].count == 1 && partitions[1].count == 1
        && first[0].position == 91 && first[0].value == -1
        && first[1].position == 23 && first[1].value == 31
        && first[2].position == 93 && first[2].value == -3
        && second[0].position == 81 && second[0].value == -4
        && second[1].position == 9223372036854775808 && second[1].value == 17 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
