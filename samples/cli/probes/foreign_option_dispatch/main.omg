// Foreign generic sums with user payloads:
// `Optional<First>` / `Optional<Second>` instantiate the
// core `option` package's closed sum over local data —
// construction, `@Optional<T>` borrowed dispatch, and
// `Optional::Some { value }` payload destructure all work
// through the ordinary sum machinery.
//
//   * `use {omega}/language/core/option.omg` — depend-free
//     core import.
//   * `Optional::Some { value: First { value: 1 } }`
//     nested record payload construction.
//   * `let empty: Optional<Second> = Optional::None;`
//     typed nullary case.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use {omega}/language/core/option.omg;

data First { value: i32; }
data Second { padding: u64; value: i32; }

machine first(subject: @|option|::Optional<First>) -> i32 {
    transition subject {
        |option|::Optional::Some { value } -> (value.value),
        |option|::Optional::None -> (0)
    }
}

machine second(subject: @|option|::Optional<Second>) -> i32 {
    transition subject {
        |option|::Optional::Some { value } -> (2),
        |option|::Optional::None -> (0)
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let left: |option|::Optional<First> = |option|::Optional::Some { value: First { value: 1 } };
    let right: |option|::Optional<Second> = |option|::Optional::Some { value: Second { padding: 41, value: 2 } };
    let empty: |option|::Optional<Second> = |option|::Optional::None;
    let left_result: i32 = first(@left);
    let right_result: i32 = second(@right);
    let empty_result: i32 = second(@empty);
    transition left_result == 1 && right_result == 2 && empty_result == 0 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
