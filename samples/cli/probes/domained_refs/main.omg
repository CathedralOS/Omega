// Domain-qualified references and linear fields:
// `counter: &Counter in Counter::Ready` — a borrowed parameter
// that must carry the domain — plus `domain X::Alias = X::Ready`
// transparent alias, `[Receipt in Issued; 2]` array-of-domained
// linear values, and `Slot { receipt: Receipt in Issued }`
// domain'd linear field.
//
//   * `is_zero(&Counter in Counter::Ready)` domained borrow.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Counter [copy] {
    code: i32;
}

domain Counter::Ready;
domain Counter::ReadyAlias = Ready;

public data Receipt [linear] {
    code: u64;
}

machine Receipt::drop(receipt: &mut Receipt) {}

public domain Receipt::Issued;

data ReceiptBox {
    receipts: [Receipt in Receipt::Issued; 2];
}

data Slot {
    receipt: Receipt in Receipt::Issued;
}

machine is_zero(counter: &Counter in Counter::Ready) -> bool {
    counter.code == 0
}

machine is_ready(counter: &Counter in Counter::ReadyAlias) -> bool {
    is_zero(counter)
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let counter: Counter in Ready = (Counter { code: 0 } as Counter in Ready);
    transition is_ready(&counter) {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
