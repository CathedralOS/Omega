// A by-value pass of a copy-eligible fixed array does
// not move the owner place: `[u32; 2]` derives
// Unrestricted multiplicity from its scalar element
// type, so `consume(main.items)` copies while the live
// shared view stays valid and reads afterward.
//
//   * `let view: &[u32] = &main.items[..]` — live view
//     across the value pass.
//   * `consume(main.items)` copies — the owner place
//     keeps its establishment.
//   * `view[0]` reads through the surviving view.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Main {
    items: [u32; 2];
    hits: i32 in Wrapping;
}

machine consume(items: [u32; 2]) {
    let first: u32 = items[0];
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.items = [3, 4];
    let view: &[u32] = &main.items[..];
    consume(main.items);
    let first: u32 = view[0];
    transition first == 3 && main.items[1] == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
