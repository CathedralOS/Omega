// The worker keeps its token across a suspending call. The separate settle
// machine consumes a linear task through the selected lifecycle operation.

use {omega}/language/core/task.omg;

public boundary trait Sleeper {
    machine park(token: i32) reaches none suspends crashes none;
}

public data Token {
    id: u64;
}

machine run(token: Token) -> Token
reaches Sleeper invokes Sleeper suspends
{
    let carried: Token = token;
    suspend Sleeper::park(7);
    carried
}

machine settle<T>(task: |task|::Task<T>) -> |task|::TaskOutcome<T>
reaches |task|::TaskLifecycle invokes |task|::TaskLifecycle suspends blocks crashes Trap crashes Abort
{
    suspend block |task|::TaskLifecycle::finish::<T>(task)
}

data Main { hits: i32 in Wrapping; }

machine mark(main: @mutable Main) {
    main.hits = 1i32 as +Wrapping;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main = Main { hits: 0i32 as +Wrapping };
    mark(@mutable entry_storage);
}
