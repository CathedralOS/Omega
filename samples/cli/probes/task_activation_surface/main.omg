// Task-runtime surface (declaration probe): `suspend
// Sleeper::park(7)` inside a `suspends;` machine,
// `suspend block Task::finish(task)` block-suspend on the
// public requirement, and `Token in Carry::AcrossSuspend`
// domain-qualified task payloads.
//
//   * `pub boundary requirement Task::finish<T>` — the sole
//     public task-disposition requirement.
//   * `Task<T> [linear]` / `TaskOutcome<T>` pub data.
//
// GAP (filed): `TaskRuntime::start`/`try_start` traits are
// package-private — the satisfies-impl activation route is
// unreachable from ordinary packages; only finish/cancel
// requirements are public.
//
// Compile-checked only: `use omega::language::core::task`
// and `core::binding` are depend-free imports.

use omega::language::core::task;
use omega::language::core::binding;

pub boundary data Sleeper;
boundary machine Sleeper::park(token: i32) suspends;

pub data Token {
    id: u64;
}

machine Worker::run(token: Token in Carry::AcrossSuspend) -> Token suspends; {
    let carried: Token = token;
    suspend Sleeper::park(7);
    carried
}

data Worker {}

machine Task::settle<T>(task: Task<T>) -> TaskOutcome<T> {
    suspend block Task::finish(task)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 1;
}
