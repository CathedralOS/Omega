// descent_measures: termination measures and inductive ensures as user
// code — the first sample with `terminates by` outside a shipped module.
//
//   * `countdown` recurses on a single scalar measure (`terminates by n`)
//     and carries a self-referential ensures: the recursive arm assumes the
//     machine's own guarantee at (n - 1, acc + n), so the checker proves
//     2 * countdown(n, acc) == 2*acc + n*(n+1) inductively.
//   * `climb` recurses UPWARD on a two-argument distance measure
//     (`terminates by (index, limit) -> Nat::BoundedDistance`) with a
//     requires roster bounding every input — the ensures is an integer
//     inequality over `embed`, which neither Wrapping nor Saturating could
//     stand in for.
//
// The entry calls both machines on literals and accepts only when
// countdown(4, 0) == 10 and climb(4, 0, 0) == 4. Compile-checked only:
// no standard-library dependency, no ProcessExit provider.

machine countdown(n: u64 in Wrapping, acc: u64 in Wrapping) -> u64 in Wrapping
terminates by n;
ensures
    result * 2 == acc * 2 + n * (n + 1)
{
    transition n > 0 {
        true -> countdown(n - 1, acc + n)
        false -> acc
    }
}

machine climb(limit: u64, index: u64, acc: u64) -> u64
requires
    limit <= 1000,
    acc <= index,
    acc <= 1000
terminates by (index, limit) -> Nat::BoundedDistance;
ensures
    embed(result) >= embed(acc) + embed(limit) - embed(index)
{
    transition index < limit {
        true -> climb(limit, index + 1, acc + 1)
        false -> acc
    }
}

machine descent_measures() {
    let down: u64 in Wrapping = countdown(4, 0);
    transition down == 10 {
        true -> check_climb()
        _ -> done(71)
    }

    machine check_climb {
        let up: u64 = climb(4, 0, 0);
        transition up == 4 {
            true -> done(70)
            _ -> done(72)
        }
    }

    machine done(code: i32) {}
}
