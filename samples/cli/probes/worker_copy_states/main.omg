// Record cloning through states: `Worker::clone` accumulates into
// `&mutable copied` across a count-bounded state cycle, then returns a
// FRESH record — mutating the source afterward cannot bleed into
// the copy.
//
//   * `Cell { values: source.values, count: source.count }`
//     whole-array-field copy in one literal.
//   * `state ... requires position < 2` bounded state params.
//   * `-> (Worker::copy(copied))` call result as state value.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Cell { values: [i32; 2]; count: u64; }

data Worker {}

machine Worker::new() -> Cell { Cell { count: 0 } }

machine Worker::copy(source: @Cell) -> Cell {
    Cell { values: source.values, count: source.count }
}

machine Worker::clone(source: @Cell) -> Cell {
    let mutable copied: Cell = Worker::new();
    copied.count = source.count;
    transition { _ -> each(@mutable copied, source, 0) }

    machine each(copied: @mutable Cell, source: @Cell, position: u64) -> Cell {
        transition position < 2 {
            true -> store(copied, source, position),
            false -> (Worker::copy(copied))
        }
    }

    machine store(copied: @mutable Cell, source: @Cell, position: u64) -> Cell
        requires position < 2
    {
        copied.values[position] = source.values[position];
        transition { _ -> each(copied, source, position + 1) }
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: @mutable Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
