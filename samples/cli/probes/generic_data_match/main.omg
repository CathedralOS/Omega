// generic_data_match: user-declared generic data and match expressions as
// sample code — the first sample to declare a multi-parameter `data`, to
// instantiate a generic machine across two type parameters, and to branch
// with `match` producing fresh enum/record values.
//
//   * `Pair<A, B>` is ordinary generic data; field reads on a concrete
//     instance erase to the selected types.
//   * `swap<A, B>` is a generic machine — each call site specializes it.
//   * `match` yields values: enum constructors in the arms, a nested match
//     inside the record arm.
//   * transitions on an enum value destructure its payload case.
//
// The machine swaps Pair<20u64, 1i32> into Pair<1i32, 20u64>, classifies
// code 7 to Verdict::Fresh(7), and accepts only when the swapped fields and
// the fresh payload agree. Compile-checked only: no standard-library
// dependency, no ProcessExit provider.
data Pair<A, B> {
    first: A;
    second: B;
}

data Verdict {
    case Fresh(value: u64);
    case Stale;
}

machine swap<A, B>(pair: Pair<A, B>) -> Pair<B, A> {
    Pair { first: pair.second, second: pair.first }
}

machine classify(code: u64) -> Verdict {
    match code {
        7 -> Verdict::Fresh { value: 7 },
        _ -> Verdict::Stale
    }
}

machine generic_data_match() {
    let p: Pair<u64, i32> = Pair { first: 20, second: 1 };
    let q: Pair<i32, u64> = swap(p);
    transition q.second == 20 {
        true -> check_match(q.first)
        _ -> done(71)
    }

    machine check_match(n: i32) {
        let v: Verdict = classify(7);
        transition v {
            Verdict::Fresh { value } -> judge(n, value)
            Verdict::Stale -> done(72)
        }
    }

    machine judge(n: i32, value: u64) {
        transition n == 1 && value == 7 {
            true -> done(70)
            _ -> done(73)
        }
    }

    machine done(code: i32) {}
}
