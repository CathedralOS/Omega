// Composite state-edge operands: field paths, record literals,
// machine-call results, affine results and views all ride a
// transition edge — and ONLY the selected edge evaluates its call
// operand (`made` counts every `make`, so the unselected arm leaves
// no effect).
//
//   * `take_field(main.pair)`, `take_call(make(&mut c, 5), 6)`,
//     `take_owned(settle(3))`, `take_view(&main.pair)` edges.
//   * `main.made == 1` proves the losing arm never ran `make`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Pair [copy] {
    a: i32 in Wrapping;
    b: i32 in Wrapping;
}

data Owned {
    value: i32 in Wrapping;
}

machine make(counter: &mut i32 in Wrapping, seed: i32 in Wrapping) -> Pair {
    counter = counter + 1;
    Pair { a: seed, b: seed + 50 }
}

machine settle(n: i32 in Wrapping) -> Owned {
    Owned { value: n }
}

data Main {
    pair: Pair;
    made: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.pair = Pair { a: 10, b: 20 };
    main.made = 0;
    main.hits = 0;
    transition main.pair.a == 10 {
        true -> take_field(main.pair, main)
        _ -> take_call(make(&mut main.made, 5), 6, main)
    }

    machine take_field(pair: Pair, main: &mut Main) {
        transition pair.a + pair.b == 30 {
            true -> owned(main)
            _ -> fail(main)
        }
    }
    machine owned(main: &mut Main) {
        transition { _ -> take_owned(settle(3), main) }
    }
    machine take_owned(o: Owned, main: &mut Main) {
        transition o.value == 3 {
            true -> view(main)
            _ -> fail(main)
        }
    }
    machine view(main: &mut Main) {
        transition { _ -> take_view(&main.pair, main) }
    }
    machine take_view(view: &Pair, main: &mut Main) {
        transition view.b == 20 && main.made == 0 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine take_call(pair: Pair, extra: i32 in Wrapping, main: &mut Main) {
        main.hits = -7;
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
