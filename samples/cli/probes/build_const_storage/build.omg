// Const evaluation inside build.omg: `Buffer<leaf()>` instantiates
// the const-generic data type through a machine call, and the build
// program inspects `result.buffer.slots.len` to decide which
// transition arm binds the entry.
data Buffer<const Capacity: u64> { slots: [u8; Capacity]; }
data ComputedStorage { buffer: Buffer<outer()>; }

machine leaf() -> u64 { 4 }
machine outer() -> u64 {
    let buffer: Buffer<leaf()> = Buffer {};
    buffer.slots.len
}
machine build(builder: &mut Build) {
    Build::application(builder, "build_const_storage");
    let result: ComputedStorage = ComputedStorage {};
    transition result.buffer.slots.len == 4 {
        true -> good(builder)
        _ -> bad(builder)
    }
    machine good(builder: &mut Build) {
        Build::bind(builder, linux_x86_64::ProgramEntry, main);
    }
    machine bad(builder: &mut Build) {
        _ = BuildProduct::entry(&builder.product, "wrong_const_dependency", "linux_x86_64::ProgramEntry");
    }
}
