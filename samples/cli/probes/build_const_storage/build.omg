// Const evaluation inside build.omg: `Buffer<leaf()>` instantiates
// the const-generic data type through a machine call, and the build
// program inspects `result.buffer.slots.length` to decide which
// transition arm binds the entry.
use main.omg as app;
data Buffer<const Capacity: u64> { slots: [u8; Capacity]; }
data ComputedStorage { buffer: Buffer<outer()>; }

machine leaf() -> u64 { 4 }
machine outer() -> u64 {
    let buffer: Buffer<leaf()>;
    buffer.slots.length
}
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_const_storage" };
    let result: ComputedStorage;
    transition result.buffer.slots.length == 4 {
        true -> good(builder),
        _ -> bad(builder)
    }
    machine good(builder: @mutable BuildPlan) {
        Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    }
    machine bad(builder: @mutable BuildPlan) {
        _ = BuildDeclarations::entry(@builder.declarations, "wrong_const_dependency", "linux_x86_64::ProgramEntry");
    }
}
