// Expected exit: 0.
// A borrowed stream identity accompanies a bounded mutable byte window through
// state arrivals. The stream identity does not participate in the window bound.
data Stream { identity: u64; }
data StreamView<'owner> { identity: @'owner u64; }
domain StreamView::Borrowed established by borrow_stream;

machine borrow_stream<'owner>(stream: @'owner Stream) -> StreamView<'owner> in Borrowed {
    StreamView { identity: @stream.identity }
}

machine receive<'owner>(stream: StreamView<'owner> in Borrowed, buffer: @mutable [u8], count: u64) -> u64 {
    let identity: u64 = $stream.identity;
    let capacity: u64 = buffer.length;
    transition count <= capacity {
        true -> bounded(identity, buffer, count),
        false -> bounded(identity, buffer, capacity)
    }
    machine bounded(identity: u64, buffer: @mutable [u8], count: u64) -> u64
    requires count <= buffer.length {
        transition count <= 4 {
            true -> received(identity, @mutable buffer[0..count]),
            false -> received(identity, @mutable buffer[0..4])
        }
    }
    machine received(identity: u64, bytes: @mutable [u8]) -> u64
    requires bytes.length <= 4 {
        bytes.length
    }
}

machine main() crashes Trap {
    let stream: Stream = Stream { identity: 41 };
    let mutable bytes: [u8; 8];
    let short_count: u64 = receive(borrow_stream(@stream), @mutable bytes, 3);
    let clamped_count: u64 = receive(borrow_stream(@stream), @mutable bytes, 9);
    transition short_count == 3 && clamped_count == 4 && stream.identity == 41 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
