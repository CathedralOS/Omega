// Domain-tagged call results compose through a match,
// relay through a qualified parameter, then erase with
// `as i64`: `relay(match ... -> mark(...)) as i64`
// feeds an `i64 in Coordinate<7>` parameter and discards
// the tag at the caller's declared result type.
//
//   * `mark(left)` returns `i64 in Coordinate<7>` — the
//     match result lands already domain-qualified.
//   * `relay(value: i64 in Coordinate<7>)` — the
//     qualified match result needs no re-cast.
//   * `as i64` on the call erases the tag for the
//     unqualified result.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain<const Axis: u64> i64::Coordinate<Axis>;

machine mark(value: i64) -> i64 in Coordinate<7> {
    value as i64 in Coordinate<7>
}

machine relay(value: i64 in Coordinate<7>) -> i64 in Coordinate<7> { value }

machine choose(select_left: bool, left: i64, right: i64) -> i64 {
    relay(match select_left {
        true -> mark(left),
        false -> mark(right)
    }) as i64
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let seen: i64 = choose(true, 4, 9);
    transition seen == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
