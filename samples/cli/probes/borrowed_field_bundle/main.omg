// Expected exit: 0
// Returned record fields retain separate borrowed backing across construction,
// nested forwarding, field permutation and a consuming helper call.
data Cell { value: i32; }
data Pair { first: Cell; second: Cell; marker: i32; }
data Bundle<'storage> { first: @'storage mutable Cell; second: @'storage mutable Cell; marker: i32; }

machine forward(cell: @mutable Cell) -> @mutable Cell { cell }

machine gather<'storage>(pair: @'storage mutable Pair) -> Bundle<'storage> {
    Bundle {
        first: forward(forward(@mutable pair.first)),
        second: forward(@mutable pair.second),
        marker: pair.marker
    }
}

machine reverse<'storage>(bundle: Bundle<'storage>) -> Bundle<'storage> {
    Bundle { first: bundle.second, second: bundle.first, marker: bundle.marker }
}

machine apply<'storage>(bundle: Bundle<'storage>) -> bool {
    bundle.first.value = 31;
    bundle.second.value = 47;
    bundle.marker == 9
}

machine exercise<'storage>(pair: @'storage mutable Pair) -> bool {
    pair.first.value = 11;
    pair.second.value = 23;
    pair.marker = 9;
    let bundle: Bundle<'storage> = reverse(gather(pair));
    let captured: bool = apply(bundle);
    pair.marker = 42;
    captured && pair.first.value == 47 && pair.second.value == 31 && pair.marker == 42
}

machine main() crashes Trap {
    let mutable pair: Pair;
    transition exercise(@mutable pair) {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
