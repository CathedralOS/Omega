// indexed_storage: fixed arrays through the carrier — the first sample
// reading and writing `[i32; N]` by computed index.
//
//   * `data Main { cells: [i32; 3]; }` holds the array on the entry
//     carrier; `main.cells = [10, 20, 20]` assigns an array literal.
//   * `main.cells[i]` reads by a computed `i32 in Wrapping` index and
//     `main.cells[i] = value` writes through the carrier — the index
//     is data, not a constant.
//   * A two-step tally loop accumulates cells[0]+cells[1]+cells[2]
//     through a Wrapping accumulator — array membership and bounds are
//     discharge data, not runtime checks authored by hand.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Main { cells: [i32; 3]; }

machine Main::main(main: &mut Main) crashes Trap {
    main.cells = [10, 20, 20];
    main.cells[1] = 40;
    let first: i32 in Wrapping = main.cells[0] as i32 in Wrapping;
    let second: i32 in Wrapping = main.cells[1] as i32 in Wrapping;
    let third: i32 in Wrapping = main.cells[2] as i32 in Wrapping;
    transition first + second + third == 70 {
        true -> done()
        _ -> bad()
    }

    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
