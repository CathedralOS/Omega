// arm_rest_guards: transition-arm record patterns — the first sample
// exercising `..` (the arm-only explicit opt-out from the exhaustiveness
// law), `as` binding renames, and `if` guards on case arms.
//
//   * `Signal::Hop { dx as step, .. } if step == 30` renames the payload
//     binding, waives `dy`, and guards on the renamed value — a partial
//     pattern that refuses without `..` compiles with it.
//   * The same case admits a second, fuller arm below it: arms are tried
//     in order, so `Hop { dx, dy }` catches every Hop the guarded arm
//     declined.
//   * Payloads ride on a scalar domain (`i32 in Step`, 0..=60): domain
//     members add through the ordinary `+` and produce plain i32.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
domain i32::Step(value) requires 0 <= value && value <= 60;

data Signal {
    case Hop(dx: i32 in Step, dy: i32 in Step);
    case Stop(code: i32);
}

machine Signal::apply(signal: Signal) -> i32 {
    transition signal {
        Signal::Hop { dx as step, .. } if step == 30 -> step
        Signal::Hop { dx, dy } -> (dx + dy)
        Signal::Stop { code } -> code
    }
}

machine arm_rest_guards() {
    let guarded: i32 = Signal::apply(Signal::Hop { dx: 30, dy: 40 });
    let summed: i32 = Signal::apply(Signal::Hop { dx: 12, dy: 40 });
    let stopped: i32 = Signal::apply(Signal::Stop { code: 7 });
    transition guarded == 30 && summed == 52 && stopped == 7 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
