// arm_rest_guards build file: depend-free compile-scope probe — no
// standard-library package, so no ProcessExit authority; compile-checked
// only (same posture as cli/basics/standalone).

machine build(builder: &mut Build) {
    Build::application(builder, "arm_rest_guards");
    Build::bind(builder, windows_x86_64::ProgramEntry, arm_rest_guards);
    Build::bind(builder, linux_x86_64::ProgramEntry, arm_rest_guards);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_rest_guards);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_rest_guards);
}
