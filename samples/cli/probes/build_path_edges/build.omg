// `Source::Path` locations resolve against the filesystem — both
// absolute paths and `..` traversal into a sibling sample's dep
// directory are legal local sources.
use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "build_path_edges");
    let mutable inside_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "dep_inside" });
    |dependency|::with_alias(@mutable inside_dependency, "inside");
    let inside_registration: DependencyRegistration = Build::dependency(builder, inside_dependency);
    let mutable escape_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../build_dep_diamond/dep_c" });
    |dependency|::with_alias(@mutable escape_dependency, "escape");
    let escape_registration: DependencyRegistration = Build::dependency(builder, escape_dependency);
}
