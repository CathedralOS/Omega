use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "static_provider_closure" };
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::PortableSource, |app|::PortableProvider>(builder, alpha_bootstrap);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::RawSource, |app|::OtherRawProvider>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
}
