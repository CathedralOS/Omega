use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
    Build::bind_native::<|app|::NativeFill::fill>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memset"
        }
    });
    Build::bind_native::<|app|::NativeFill::check>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp"
        }
    });

    builder.product = BuildProduct::Application { name: "native_array_window" };
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
