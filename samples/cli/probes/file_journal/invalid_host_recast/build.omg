use {omega}/language/core/external_binding.omg as foreign;
machine build(builder: @mutable BuildPlan) {
    Build::bind_native::<NativeFill::fill>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memset"
        }
    });
    Build::bind_native::<NativeFill::check>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp"
        }
    });

    builder.product = BuildProduct::Application { name: "native_array_window" };
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
