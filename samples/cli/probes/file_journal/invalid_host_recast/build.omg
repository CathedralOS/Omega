use omega\language\core\DllImport;
use omega\language\core\ForeignBinding;
machine build(builder: @mutable Build) {
    Build::bind_native::<NativeFill::fill>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memset"
        }
    });
    Build::bind_native::<NativeFill::check>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp"
        }
    });

    Build::application(builder, "native_array_window");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
