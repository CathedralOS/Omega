// Claims cross named-state edges: a receipt established in the
// entry state moves into an inline construction, crosses a
// conditional edge into one of two states, and each state's
// entry claim continues whichever claim its arriving edge
// carried. Claims live on edges, not just call boundaries.
//
//   * `Pair` inline construction inside a state body.
//   * Conditional edge selects the consuming state.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let receipt: Receipt = Receipt { code: 1 };
    let pair: Pair = Pair { left: receipt, right: Receipt { code: 2 } };
    transition pair.left.code == 1 {
        true -> chosen(main, pair)
        _ -> other(main, pair)
    }
    state chosen(main: &mut Main, pair: Pair) {
        main.hits = (consume(pair.left) as i32 in Wrapping) + (consume(pair.right) as i32 in Wrapping);
    }
    state other(main: &mut Main, pair: Pair) {
        main.hits = -1;
        drop(pair.left);
        drop(pair.right);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
