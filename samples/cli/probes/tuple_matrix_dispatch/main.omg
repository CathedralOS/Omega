// Multi-subject case exhaustiveness is a CARTESIAN proof: these arms
// cover every (Direction, Outcome, bool) triple without a `_` arm. A
// pure case-union domain is a finite subset on one axis —
// `Direction::Horizontal` refines the tuple's first member.
//
//   * `transition (main.direction, main.result, approved)` — tuple
//     subject; arms spell the remaining (Up, Hit/Miss, true/false)
//     matrix after the domain arm.
//   * `domain Direction::Horizontal requires direction in Left |
//     Right` — case-union domain on one axis.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Direction {
    case Left;
    case Right;
    case Up;
}

domain Direction::Horizontal(direction)
requires
    direction in Direction::Left | Direction::Right;

data Outcome {
    case Miss;
    case Hit;
}

data Main {
    direction: Direction;
    result: Outcome;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.direction = Direction::Right;
    main.result = Outcome::Hit;
    let mut approved: bool = false;
    transition (main.direction, main.result, approved) {
        (Direction::Horizontal, _, _) -> right(main)
        (Direction::Up, Outcome::Hit, true) -> wrong(main)
        (Direction::Up, Outcome::Hit, false) -> wrong(main)
        (Direction::Up, Outcome::Miss, true) -> wrong(main)
        (Direction::Up, Outcome::Miss, false) -> wrong(main)
    }
    state right(main: &mut Main) { main.hits = 1; }
    state wrong(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
