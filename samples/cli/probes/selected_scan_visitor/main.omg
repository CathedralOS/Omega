// Expected exit: 0.
// A runtime-selected visitor writes matching values into caller-owned storage.
// The scan stops when that supplied output fills; it does not allocate results.
data Matches<'output> { values: @'output mutable [i32]; count: u64; }

trait Visitor<Output> {
    machine emit(output: @mutable Output, value: i32) -> bool;
}

machine append<'storage>(output: @mutable Matches<'storage>, value: i32) -> bool {
    transition output.count < output.values.length {
        true -> store(output, value),
        false -> false
    }
    machine store(output: @mutable Matches<'storage>, value: i32) -> bool
    requires output.count < output.values.length {
        output.values[output.count] = value;
        output.count = output.count + 1;
        true
    }
}

Exact<'storage> satisfies Visitor<Matches<'storage>> {
    machine emit(output: @mutable Matches<'storage>, value: i32) -> bool {
        append(output, value)
    }
}

Tagged<'storage> satisfies Visitor<Matches<'storage>> {
    machine emit(output: @mutable Matches<'storage>, value: i32) -> bool {
        append(output, value ^ 1)
    }
}

machine scan<'storage>(visitor: dyn Visitor<Matches<'storage>>, input: @[i32], output: @mutable Matches<'storage>) -> u64 {
    transition { _ -> next(visitor, input, output, 0) }
    machine next(visitor: dyn Visitor<Matches<'storage>>, input: @[i32], output: @mutable Matches<'storage>, position: u64) -> u64
    requires position <= input.length {
        transition position < input.length {
            true -> inspect(visitor, input, output, position),
            false -> output.count
        }
    }
    machine inspect(visitor: dyn Visitor<Matches<'storage>>, input: @[i32], output: @mutable Matches<'storage>, position: u64) -> u64
    requires position < input.length {
        transition input[position] > 0 {
            true -> emit(visitor, input, output, position),
            false -> next(visitor, input, output, position + 1)
        }
    }
    machine emit(visitor: dyn Visitor<Matches<'storage>>, input: @[i32], output: @mutable Matches<'storage>, position: u64) -> u64
    requires position < input.length {
        let accepted: bool = Visitor::emit(visitor, output, input[position]);
        transition accepted {
            true -> next(visitor, input, output, position + 1),
            false -> output.count
        }
    }
}

machine main() crashes Trap {
    let input: [i32; 5] = [-3, 7, 0, -1, 9];
    let mutable exact: [i32; 3] = [-1, -1, -1];
    let mutable tagged: [i32; 3] = [-1, -1, -1];
    let mutable short: [i32; 1] = [-1];
    let mutable selected: dyn Visitor<Matches> = Exact as dyn Visitor<Matches>;
    let mutable exact_output: Matches = Matches { values: @mutable exact[..], count: 0 };
    let count: u64 = scan(selected, @input, @mutable exact_output);
    selected = Tagged as dyn Visitor<Matches>;
    let mutable tagged_output: Matches = Matches { values: @mutable tagged[..], count: 0 };
    let tagged_count: u64 = scan(selected, @input, @mutable tagged_output);
    let mutable short_output: Matches = Matches { values: @mutable short[..], count: 0 };
    let short_count: u64 = scan(selected, @input, @mutable short_output);
    let empty_count: u64 = scan(selected, input[..0], @mutable short_output);
    transition count == 2 && exact[0] == 7 && exact[1] == 9 && exact[2] == -1
        && tagged_count == 2 && tagged[0] == 6 && tagged[1] == 8 && tagged[2] == -1
        && short_count == 1 && short[0] == 6 && empty_count == 1 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
