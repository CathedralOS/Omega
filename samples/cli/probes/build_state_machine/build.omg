// The build machine is an ordinary multi-state machine: explicit
// `state` blocks inside `machine build` are legal and run the
// activation like any other machine.
machine build {
    state entry(builder: &mut Build) {
        Build::application(builder, "build_state_machine");
        builder.freestanding = true;
    }
    state exclusions(builder: &mut Build) {
        Build::exclude_crash(builder, CrashCause::Abort);
    }
}
