// `ensures result ==` on folded policy arithmetic: exact
// `3u8 + 4u8`, `255u8 as u8 in Wrapping) + 2`, the same
// operands `in Saturating`, and a wrapped-shift mix —
// each `ensures` pins the folded policy result.
//
//   * `machine Main::main()` parameterless entry.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine exact_sum() -> u8
ensures result == 7
{ 3u8 + 4u8 }

machine wrapped_sum() -> u8
ensures result == 1
{ ((255u8 as u8 in Wrapping) + 2) as u8 }

machine saturated_sum() -> u8
ensures result == 255
{ ((255u8 as u8 in Saturating) + 2) as u8 }

machine wrapped_operand() -> u8
ensures result == 127
{ (((0u8 as u8 in Wrapping) - 2) >> 1) as u8 }

data Main {
}

machine Main::main() {
}
