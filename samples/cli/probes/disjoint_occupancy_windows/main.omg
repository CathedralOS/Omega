use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// Two resource windows of one occupancy row, lent across a state edge.
// The field pair leaves main; the later state builds its own row and lends
// that too. Writes through either window are the row's own cells.
// Expected exit: 0
// Expected output contains: 3 9 5 7
use system\Console;

data Occupancy { cells: [i32 in Wrapping; 4]; }
data Main { }

machine Main::main(main: @mutable Main) reaches ProcessExit + StandardOutput {
    let mutable occupancy: Occupancy;
    occupancy.cells = [0, 0, 0, 0];
    let ready: bool = true;
    transition ready {
        true -> field_windows(main, @mutable occupancy.cells[0..2], @mutable occupancy.cells[2..4]),
        _ -> bad(main)
    }
    machine field_windows(main: @mutable Main, left: @mutable [i32 in Wrapping], right: @mutable [i32 in Wrapping])
    requires left.length >= 1 && right.length >= 1
    {
        left[0] = 3;
        right[0] = 9;
        Console::write_byte((48 + left[0]) as i32);
        Console::write(" ");
        Console::write_byte((48 + right[0]) as i32);
        Console::write(" ");
        transition { _ -> build(main) }
    }
    machine build(main: @mutable Main) {
        let mutable row: [i32 in Wrapping; 4] = [0, 0, 0, 0];
        transition { _ -> local_windows(main, @mutable row[0..2], @mutable row[2..4]) }
    }
    machine local_windows(main: @mutable Main, left: @mutable [i32 in Wrapping], right: @mutable [i32 in Wrapping])
    requires left.length >= 1 && right.length >= 1
    {
        left[0] = 5;
        right[0] = 7;
        Console::write_byte((48 + left[0]) as i32);
        Console::write(" ");
        Console::write_byte((48 + right[0]) as i32);
        Console::write_line("");
        ProcessExit::exit_process(0);
    }
    machine bad(main: @mutable Main) {
        Console::write_line("BAD");
        ProcessExit::exit_process(2);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardOutput {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
