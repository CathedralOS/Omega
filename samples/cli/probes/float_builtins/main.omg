// Builtin float extrema and roots: `min`, `max`, `sqrt` are builtin
// machines on `f32`/`f64` — no import. Explicit operands select
// their format; anonymous literals land at the annotation's format.
//
//   * `min`/`max`/`sqrt` on stored f32 and f64 fields.
//   * `min(4.0, 9.0)` / `sqrt(4.0)` — anonymous operands selecting
//     f32 at the annotation.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Main {
    left32: f32;
    right32: f32;
    left64: f64;
    right64: f64;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.left32 = 9.0f32;
    main.right32 = 4.0f32;
    main.left64 = 9.0;
    main.right64 = 4.0;
    let low32: f32 = min(main.left32, main.right32);
    let high32: f32 = max(main.left32, main.right32);
    let root32: f32 = sqrt(low32);
    let root64: f64 = sqrt(min(main.left64, main.right64));
    let anon: f32 = min(4.0, 9.0);
    transition low32 == 4.0f32 && high32 == 9.0f32 && root32 == 2.0f32
        && root64 == 2.0 && anon == 4.0f32 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
