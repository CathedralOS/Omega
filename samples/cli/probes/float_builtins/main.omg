use omega_language_std::math;
use omega::language::core::float_operations;

// Ordinary float extrema and roots imported from std math. Carrier-specific
// declarations select f32 or f64, including for anonymous literal operands.
//
//   * `min`/`max`/`sqrt` on stored f32 and f64 fields.
//   * `min(4.0, 9.0)` / `sqrt(4.0)` — anonymous operands selecting
//     f32 at the annotation.
//   * `hits` records the reached arm.
//
// The state field records the reached arm; no ProcessExit provider is used.
// The float comparisons in the guard resolve through the imported
// `float_operations` selection; a primitive spelling has no fallback meaning.

data Main {
    left32: f32;
    right32: f32;
    left64: f64;
    right64: f64;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.left32 = 9.0f32;
    main.right32 = 4.0f32;
    main.left64 = 9.0;
    main.right64 = 4.0;
    let low32: f32 = min_f32(main.left32, main.right32);
    let high32: f32 = max_f32(main.left32, main.right32);
    let root32: f32 = sqrt_f32(low32);
    let root64: f64 = sqrt_f64(min_f64(main.left64, main.right64));
    let anon: f32 = min_f32(4.0, 9.0);
    transition low32 == 4.0f32 && high32 == 9.0f32 && root32 == 2.0f32
        && root64 == 2.0 && anon == 4.0f32 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
