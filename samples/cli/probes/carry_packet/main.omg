// carry_packet: explicit Carry property declarations as sample code — the
// first sample marking aggregates with the closed `[carry(...)]`
// property.
//
//   * `Packet` declares all four mandatory axes (suspension/cpu/thread/
//     address) beside common fields and payload cases; `Envelope` nests a
//     `Packet` through the same declared property — nested and
//     case-payload structural validation both run.
//   * Carry is a closed compiler property: transparent aggregates derive
//     it structurally, while the explicit declaration pins the authored
//     spelling a provider can later rely on.
//
// The machine builds a Burst packet inside an envelope, matches the
// active case's payload, and accepts on 3 == 3 && 2 == 2. Compile-checked
// only: no standard-library dependency, no ProcessExit provider.
data Packet [carry(
    suspension: allowed,
    cpu: any,
    thread: any,
    address: movable,
)] {
    id: i32;
    case Empty;
    case Burst(count: i32, priority: u8);
}

data Envelope [carry(
    suspension: allowed,
    cpu: any,
    thread: any,
    address: movable,
)] {
    inner: Packet;
    stamp: i64;
}

machine carry_packet() {
    let letter: Envelope = Envelope { inner: Packet::Burst { count: 3, priority: 2, id: 9 }, stamp: 7 };
    transition letter.inner {
        Packet::Burst { id as _, count, priority } -> judge(count, priority)
        Packet::Empty -> done(71)
    }

    state judge(count: i32, priority: u8) {
        transition count == 3 && priority == 2 {
            true -> done(70)
            _ -> done(72)
        }
    }

    state done(code: i32) {}
}
