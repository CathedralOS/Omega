use omega::language::core::extent;
// `Extent in Granted & Vacant` — intersected qualifiers carry the
// dormant-content qualification into a `Vacant`-qualified field; the
// construction is admitted. `held.e as Extent` strips the qualifier set
// on read.
data Held {
    e: Extent in Granted & Vacant;
}
machine keep(whole: Extent in Granted & Vacant) -> Extent {
    let held: Held = Held { e: whole };
    held.e as Extent
}
machine main() {
}
