// Repeated invocations of one producer are distinct live
// claims: `combine` issues `right` then `left`, and the
// record's establishment order is the reverse of its field
// order. `capture` forwards the result whole — both
// invocation lineages survive, never collapsed to the shared
// declaration.
//
//   * Two `issue(...)` calls inside one machine.
//   * `capture` returns the captured `Pair` unchanged.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

machine issue(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine combine(first: i32, second: i32) -> Pair {
    let right: Receipt = issue(second);
    let left: Receipt = issue(first);
    Pair { left: left, right: right }
}

machine capture(first: i32, second: i32) -> Pair {
    let captured: Pair = combine(first, second);
    captured
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let pair: Pair = capture(1, 2);
    let a: i32 = consume(pair.left);
    let b: i32 = consume(pair.right);
    transition a == 1 && b == 2 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
