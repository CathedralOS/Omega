// Register the same local source in Product scope under distinct aliases.

use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_dup_product_edge" };
    let mutable k1_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "dependency" });
    |dependency|::with_alias(@mutable k1_dependency, "k1");
    let k1_registration: DependencyRegistration = Build::dependency(builder, k1_dependency);
    let mutable k2_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "dependency" });
    |dependency|::with_alias(@mutable k2_dependency, "k2");
    let k2_registration: DependencyRegistration = Build::dependency(builder, k2_dependency);
}
