// Two aliased `Build::dependency` product edges on the same dependency directory are
// legal: each edge is a distinct dependency occurrence under its own
// alias, so `k1::main` and `k2::main` both import the same package and
// agree on its declarations — the product-side mirror of
// `build_dup_build_edge`.

machine build(builder: &mut Build) {
    Build::application(builder, "build_dup_product_edge");
    let mut k1_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut k1_dependency, "k1");
    let k1_registration: DependencyRegistration = Build::dependency(builder, k1_dependency);
    let mut k2_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut k2_dependency, "k2");
    let k2_registration: DependencyRegistration = Build::dependency(builder, k2_dependency);
    builder.freestanding = true;
}
