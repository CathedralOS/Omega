// Claim-bearing constructions inline at call args: a
// construction passed by value is an anonymous owner — nested
// `Envelope { pair: Pair { ... } }` mints fresh claims while a
// moved member continues its claim into the field position.
//
//   * `settle(Pair { left: moved, right: fresh })`.
//   * `inspect(Envelope { pair: Pair { ... } })` nested.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }
data Envelope { pair: Pair; }

machine settle(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let total: i32 = ((left.code as i32 in Wrapping) + (right.code as i32 in Wrapping)) as i32;
    drop(left);
    drop(right);
    total
}

machine inspect(envelope: Envelope) -> i32 {
    settle(envelope.pair)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let moved: Receipt = Receipt { code: 1 };
    let a: i32 = settle(Pair { left: moved, right: Receipt { code: 2 } });
    let b: i32 = inspect(Envelope { pair: Pair { left: Receipt { code: 3 }, right: Receipt { code: 4 } } });
    transition a == 3 && b == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
