// Core relation traits parameterized by PROPOSITIONS:
// `use omega::language::core::relation` (depend-free) imports
// Reflexive/Symmetric/Transitive/Antisymmetric — each
// `trait X<C, proposition Relation>` carries one law; a user
// `proposition` binds the parameter through `satisfies`.
//
//   * `related` is a defined proposition (code equality), so every
//     realizer proves its law from the requirement's own premises.
//
// Compile-checked only: declaration surface (proposition
// contracts aren't callable), no standard-library dependency.

use omega::language::core::relation;

data Carrier {
    code: u32;
}

// `related` is defined, so each realizer proves its law from exactly the
// premises the trait requirement grants; a realizer may not add premises
// the requirement does not imply.
proposition related(left: Carrier, right: Carrier) = left.code == right.code;

machine related_reflexive(value: Carrier)
satisfies Reflexive<Carrier, related>::reflexive
ensures related(value, value)
{
}

machine related_symmetric(left: Carrier, right: Carrier)
satisfies Symmetric<Carrier, related>::symmetric
requires related(left, right)
ensures related(right, left)
{
}

machine related_transitive(left: Carrier, middle: Carrier, right: Carrier)
satisfies Transitive<Carrier, related>::transitive
requires
    related(left, middle)
    related(middle, right)
ensures related(left, right)
{
}

machine related_antisymmetric(left: Carrier, right: Carrier)
satisfies Antisymmetric<Carrier, related>::antisymmetric
requires
    related(left, right)
    related(right, left)
ensures left == right
{
}
