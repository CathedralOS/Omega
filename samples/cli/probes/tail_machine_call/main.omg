// Tail calls to machines: a transition arm's destination can be a
// MACHINE name (`-> Main::with_argument(main, 7)`) — a cross-machine
// tail call that replaces the current frame instead of pushing a
// call. Ordinary calls inside the destination still compose.
//
//   * `transition { _ -> Main::with_argument(main, 7) }` —
//     unconditional machine tail call.
//   * `true -> Main::finish(main)` — guarded arm tail call.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Main {
    stored: i32;
    marks: u32 in Wrapping;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.marks = 0;
    main.stored = 5;
    transition { _ -> Main::with_argument(main, 7) }
}

machine Main::with_argument(main: &mut Main, value: i32)
requires 0 <= value && value <= 100
{
    transition value == 7 && main.stored == 5 {
        true -> again(main)
        _ -> Main::finish(main)
    }
    machine again(main: &mut Main) {
        main.marks = main.marks + 1;
        transition { _ -> Main::finish(main) }
    }
}

machine Main::finish(main: &mut Main) {
    transition main.marks == 1 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
