// A [copy] type whose first case carries a float is zero-constructible:
// all-zero bytes are +0.0, so omitting the field mints Reading{value: +0.0}.
data Sample [copy] {
    case Reading(value: f64);
    case Missing;
}
data Holder [copy] { sample: Sample; ready: bool; }
data Main { holder: Holder; hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.holder = Holder { ready: true };
    transition main.holder.sample {
        Sample::Reading { value } -> ready(main, main.holder.ready)
        _ -> bad(main)
    }
    machine ready(main: &mut Main, was_ready: bool) {
        main.holder.sample = Sample::Missing;
        transition main.holder.sample {
            Sample::Missing -> absent(main, was_ready)
            _ -> bad(main)
        }
    }
    machine absent(main: &mut Main, kept: bool) {
        let value: i32 = match kept {
            (true) -> 70
            _ -> 71
        };
    }
    machine bad(main: &mut Main) { let value: i32 = 0; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
