// Branch reconciliation of a linear obligation: transition arms
// are ALTERNATIVES — both paths transfer the same obligation into
// a consuming state; the checker joins them as one live claim,
// not two sequential copies.
//
//   * `true -> consume_first(main, receipt)` /
//     `_ -> consume_second(main, receipt)` — same obligation, two
//     destinations.
//   * `Acknowledgement::ack` is a one-member boundary trait requirement
//     with a consuming contract. `Receipt` declares no `Receipt::drop`
//     plan, so no edge cleanup may retire the claim: each arm must hand
//     the receipt to the requirement.
//   * The selected provider is an external sink: each bound target's C
//     library `abs` takes one 32-bit integer, which is exactly how SysV
//     x86-64, AAPCS64 and Windows x64 pass a one-field `i32` record by
//     value, and returns its magnitude — the receipt's code.
//   * `choose_first` picks the first arm, which checks the acknowledged
//     code; reaching the second arm traps.
//
// No standard-library dependency.
//
// Expected exit: 0.
use omega::language::core::external_binding;

public data Receipt [linear] { code: i32; }

public boundary trait Acknowledgement {
    machine ack(receipt: Receipt) -> i32 reaches;
}

public data ReceiptSink {}


data Main { hits: i32 in Wrapping; choose_first: bool; }

machine verify(correct: bool) crashes Trap {
    transition correct {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine Main::main(main: &mut Main) reaches Acknowledgement crashes Trap {
    main.hits = 0;
    main.choose_first = true;
    let receipt: Receipt = Receipt { code: 7 };
    transition main.choose_first {
        true -> consume_first(main, receipt)
        _ -> consume_second(main, receipt)
    }

    machine consume_first(main: &mut Main, receipt: Receipt) {
        let code: i32 = Acknowledgement::ack(receipt);
        main.hits = 1;
        verify(code == 7);
    }

    machine consume_second(main: &mut Main, receipt: Receipt) {
        let code: i32 = Acknowledgement::ack(receipt);
        main.hits = 2;
        verify(false);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Acknowledgement crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
