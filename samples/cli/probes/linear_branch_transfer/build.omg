machine build(builder: &mut Build) {
    Build::application(builder, "linear_branch_transfer");
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, linux_arm64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, linux_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, macos_arm64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, macos_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, windows_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, uefi_x86_64);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, cross_platform_cli);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, local_unchecked);
    Build::select_provider<Acknowledgement, ReceiptSink>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
