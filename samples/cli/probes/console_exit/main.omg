use omega\language\core\ProcessExit;
// system console exit: a direct `ProcessExit::exit_process` call + `use
// system\console` path dependency — the first
// probe family that RUNS, not just compiles. `exit_process(70)`
// is the corpus's universal canary.

data Main {
}

machine Main::main(main: @mutable Main) reaches ProcessExit {
    ProcessExit::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
