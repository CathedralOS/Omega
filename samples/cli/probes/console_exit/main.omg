// std console exit: a direct `Console::exit_process` call + `use
// omega_language_std::console` path dependency — the first
// probe family that RUNS, not just compiles. `exit_process(70)`
// is the corpus's universal canary.
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(70);
}
