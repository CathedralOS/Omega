// Encoded references through `as` recasts: a layout view
// type shares a scalar's original storage, and the view
// itself recasts to a foreign byte-level view for
// physical writes — `physical.value = 127` lands on the
// same byte the canonical view reads as -128.
//
//   * `data SignedByte { }` layout-typed record;
//     `SignedByte<PortableByte>` instantiates it over a
//     logical field type.
//   * `&mut main.bytes[0] as &mut RawView` — encoded view
//     recast over borrowed element storage.
//   * `value as &mut ForeignByte` — second recast through
//     the view down to raw bytes.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data FieldKind { case Scalar; case Text; case Nested; case Repeated; }

data SchemaField
where
    size <= 4096,
    1 <= align,
    align <= 16,
{
    key: u64;
    size: u64;
    align: u64;
    number: i64;
    kind: FieldKind;
}

data Schema
where
    field_count <= 32,
{
    fields: [SchemaField; 32];
    field_count: u64;
}

data IntegerInterpretation { case Signed; case Unsigned; }

data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}

data FieldEntry { key: u64; placement: FieldPlan; }

data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data SignedByte { }

machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}

data PortableByte [copy] { value: i64; }

data RawView { value: SignedByte<PortableByte>; }

data ForeignByte { value: i8; }

machine update(value: &mut RawView) -> i64 {
    let previous: i64 = value.value.value;
    value.value.value = 127;
    previous
}

data Main {
    bytes: [u8; 2];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.bytes[0] = 128;
    main.bytes[1] = 85;
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let previous: i64 = update(view);
    transition previous == -128 && view.value.value == 127 && main.bytes[0] == 127 && main.bytes[1] == 85 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
