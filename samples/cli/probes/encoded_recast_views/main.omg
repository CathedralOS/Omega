use omega::language::core::layout;
// The selected signed-byte layout shares the original scalar storage. Writes
// through the view must preserve the neighboring byte and the same backing.
// This remains a checking probe; it has no process-exit oracle.
SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan
    reaches none terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry {
            key: schema.fields[0].key,
            representation: FieldPlan::IntegerAt {
                offset: 0,
                stored_width: 8,
                interpretation: IntegerInterpretation::Signed,
            },
        };
        LayoutPlan {
            entries: entries,
            entry_count: 1,
            size_fixed: 1,
            size_is_dynamic: false,
            align: 1,
        }
    }
}

data PortableByte [copy] { value: i64; }

data RawView { value: LayoutStorage<PortableByte, SignedByte>; }

data ForeignByte { value: i8; }

machine update(value: &mut RawView) -> i64 {
    let previous: i64 = value.value.value;
    value.value.value = 127;
    previous
}

data Main {
    bytes: [u8; 2];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.bytes[0] = 128;
    main.bytes[1] = 85;
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let previous: i64 = update(view);
    transition previous == -128 && view.value.value == 127 && main.bytes[0] == 127 && main.bytes[1] == 85 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
