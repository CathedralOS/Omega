// deferred_init_gated: deferred locals and gated nested records — the
// first sample declaring a primitive local without an initializer.
//
//   * `let mut total: i32 in Wrapping;` binds storage first and assigns
//     later; the local keeps its own storage through assignment and
//     observation, then takes a compound `+=` step.
//   * `Session` is a gated record (`retries <= 3`) nested inside
//     `Registry`; `Registry {}` zero-fills it, and the zero value itself
//     satisfies the gate — the `where` fact constrains the scalar field
//     without hiding the record from establishment.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.
data Session where retries <= 3 {
    retries: u64;
    score: i32;
}

data Registry { session: Session; }

machine deferred_init_gated() {
    let registry: Registry = Registry {};
    let mut total: i32 in Wrapping;
    total = 10;
    total += 60;
    transition total == 70 && registry.session.retries == 0 && registry.session.score == 0 {
        true -> done(70)
        _ -> done(71)
    }

    machine done(code: i32) {}
}
