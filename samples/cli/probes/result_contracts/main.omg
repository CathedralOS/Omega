// Result contracts: `ensures result == ...` names the return value
// and lets the checker prove the body's value; disjunctions admit
// several outcomes; a scalar `requires` discharges at the call by
// the literal or the declared bounds.
//
//   * `exact_sum() -> u8 ensures result == 7` — the body's
//     `3u8 + 4u8` discharges the equation statically.
//   * `bounded(...) requires input <= 255u16 ensures result ==
//     input || result < input` — guarded parameter + disjunctive
//     result contract; call passes `input % 256u16`.
//   * `Main::accept(5)` — literal discharges `requires value > 0`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine exact_sum() -> u8
ensures result == 7
{ 3u8 + 4u8 }

machine bounded(ignored: bool, input: u16) -> u16
requires input <= 255u16
ensures result == input || result < input
{
    transition { _ -> finish(input) }
    state finish(saved: u16) -> u16 { saved }
}

data Main { hits: i32 in Wrapping; }

machine Main::accept(value: i32)
requires
    value > 0
{
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    Main::accept(5);
    transition exact_sum() == 7 && bounded(true, 200u16) == 200
        && bounded(false, 200u16 % 256u16) <= 200 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
