machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "invalid_product_provider" };
    let provider: ProductProviderRef = BuildDeclarations::provider(@builder.declarations, "omega::language::system");
    let ppath: @[u8] = ProductProviderRef::path(@provider);
    BuildLog::write_line(@mutable builder.log, ppath);
}
