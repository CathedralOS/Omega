// BuildProduct marker queries: entry/schema/provider answer by lexical
// lookup under the call occurrence's package and issue opaque markers.
// Every query on a row this package never declares must reject — the
// three unrequested-row rejections are pinned under controls/.

machine build(builder: &mut Build) {
    Build::application(builder, "build_product_queries");
    let mut kit_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut kit_dependency, "kit");
    let kit_registration: DependencyRegistration = Build::dependency(builder, kit_dependency);
    builder.freestanding = true;
}
