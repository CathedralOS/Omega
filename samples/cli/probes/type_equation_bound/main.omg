// A where-clause type equation binds a generic type parameter to declared
// structure: `Length == u64[0..=Capacity]` — the caller supplies the concrete
// range instantiation; no runtime value supplies layout.
machine capacity<Length, const Capacity: u64>() -> u64
where Length == u64[0..=Capacity]
{ Capacity }
machine recovered() -> u64 { capacity<u64[0..=257]>() }
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let n: u64 = recovered();
    transition n == 257 {
        true -> done(main)
        _ -> done(main)
    }
    state done(main: &mut Main) {
        main.hits = main.hits + 1;
    }
}
