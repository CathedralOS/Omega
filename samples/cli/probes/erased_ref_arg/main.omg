// Unused and erased static arguments keep their authored lexical scope:
// `&Element` as a type argument inside a machine-call bound proposition, and an
// unused `const Tag` forwarded through a relay.
machine ceiling<Element>() -> u64 { 70 }
data Bounded<Element> where value <= ceiling<&Element>() { value: u64; }
machine unused<Element, const Tag: u8>() -> u64 { 70 }
machine relay<Element>() -> u64 { unused<&Element, 7>() }
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.hits = 0;
    let bounded: Bounded<u8> = Bounded { value: 0 };
    transition relay<u8>() == 70 && bounded.value == 0 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
