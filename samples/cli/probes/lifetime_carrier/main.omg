// Lifetime-parameterized data: `Carrier<'storage>` holds a
// `&'storage i32`; `transform<'storage>` passes the lifetime
// through its signature so a carried loan round-trips unchanged
// while a sibling field is rebuilt.
//
//   * `data Carrier<'storage>` + `Holder<'storage>` nesting.
//   * `holder.carrier.reference` deref of a carried loan.
//   * Whole-value extract `let removed = holder.carrier` then
//     `holder.carrier = removed` no-op repair.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Carrier<'storage> {
    marker: i32;
    reference: &'storage i32;
}

data Holder<'storage> { carrier: Carrier<'storage>; }

machine transform<'storage>(carrier: Carrier<'storage>) -> Carrier<'storage> {
    transition carrier.marker == 41 {
        true -> increment(carrier)
        false -> preserve(carrier)
    }
    state increment(carrier: Carrier<'storage>) -> Carrier<'storage> {
        Carrier { marker: ((carrier.marker as i32 in Wrapping) + 1) as i32, reference: carrier.reference }
    }
    state preserve(carrier: Carrier<'storage>) -> Carrier<'storage> { carrier }
}

machine repair<'storage>(holder: &mut Holder<'storage>) -> i32 {
    let removed: Carrier<'storage> = holder.carrier;
    holder.carrier = removed;
    holder.carrier.reference
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    run(main);
}

machine run<'storage>(main: &mut Main) {
    let storage: i32 = 7;
    let mut holder: Holder<'storage> = Holder { carrier: Carrier { marker: 41, reference: &storage } };
    holder.carrier = transform(holder.carrier);
    let observed: i32 = repair(&mut holder);
    transition observed == 7 && holder.carrier.marker == 42 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
