// An indexed write through a qualified byte owner
// re-discharges membership: `bytes[at] = value` on
// `@mutable [u8; 8] in Ascii` succeeds because the
// dominating `value < 128` guard proves the stored
// byte preserves `ascii_only`.
//
//   * `at < bytes.length && value < 128` — one guard
//     covers bounds and membership.
//   * A named state holds `-> bool` — named states
//     declare results like machines.
//   * `repeat` self-edge: the state re-enters itself
//     with narrowed args.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain [u8; 8]::Ascii requires ascii_only(self);

machine replace(at: u64, bytes: @mutable [u8; 8] in Ascii, value: u8) -> bool {
    transition at < bytes.length && value < 128 {
        true -> write(at, bytes, value, true),
        _ -> false
    }
    machine write(at: u64, bytes: @mutable [u8; 8] in Ascii, value: u8, repeat: bool) -> bool {
        bytes[at] = value;
        transition repeat {
            true -> write(at, bytes, value, false),
            _ -> true
        }
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let mutable bytes: [u8; 8] in Ascii = [97u8, 98u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let wrote: bool = replace(2, @mutable bytes, 99);
    let plain: [u8; 8] = bytes;
    transition wrote && plain[2] == 99 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
