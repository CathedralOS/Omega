// An indexed write through a qualified byte owner
// re-discharges membership: `bytes[at] = value` on
// `&mut [u8; 8] in Ascii` succeeds because the
// dominating `value < 128` guard proves the stored
// byte preserves `ascii_only`.
//
//   * `at < bytes.len && value < 128` — one guard
//     covers bounds and membership.
//   * A named state holds `-> bool` — named states
//     declare results like machines.
//   * `repeat` self-edge: the state re-enters itself
//     with narrowed args.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

domain [u8; 8]::Ascii(bytes) requires ascii_only(bytes);

machine replace(at: u64, bytes: &mut [u8; 8] in Ascii, value: u8) -> bool {
    transition at < bytes.len && value < 128 {
        true -> write(at, bytes, value, true)
        _ -> false
    }
    state write(at: u64, bytes: &mut [u8; 8] in Ascii, value: u8, repeat: bool) -> bool {
        bytes[at] = value;
        transition repeat {
            true -> write(at, bytes, value, false)
            _ -> true
        }
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut bytes: [u8; 8] in Ascii = [97u8, 98u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let wrote: bool = replace(2, &mut bytes, 99);
    let plain: [u8; 8] = bytes;
    transition wrote && plain[2] == 99 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
