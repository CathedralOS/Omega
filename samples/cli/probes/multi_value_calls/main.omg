// Multiple sequential value-returning calls: exercises slot isolation for
// three sequential value-position calls with varying arities, then uses
// all three results in arithmetic to produce a final value.
//
// Exercises: 3 sequential value-returning calls in the same machine scope,
// all results used together in a final arithmetic expression, with an
// intermediate mutation of the subject that tests that the call results survive.
//
// Value-returning machines:
//   double(n) = n * 2               (1 arg, simple)
//   add3(a, b, c) = a + b + c       (3 args, wider arity)
//   clamp_low(n, min) -> n if n>=min, else min  (2 args, uses guard)
//
// Scripted:
//   r1 = main.double(15)     = 30
//   r2 = add3(5, 10, 7) = 22
//   r3 = clamp_low(18, 20) = 20   (18 < 20, so clamped to 20)
//   total = r1 + r2 - r3 + main.offset
//         = 30 + 22 - 20 + 38 = 70
//
// main.offset is set to 38 before the calls, then the calls complete.
// Verifies: results survive a field write between calls.
//
// Expected exit: 70.

use omega_language_std::console;

data Main {
    offset: i32 in Saturating;
    pause: [u8; 256];
}

machine double_val(n: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (n * 2)
    }
}

machine add3(a: i32 in Saturating, b: i32 in Saturating, c: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (a + b + c)
    }
}

machine clamp_low(n: i32 in Saturating, min_val: i32 in Saturating) -> i32 in Saturating {
    transition n < min_val {
        true -> min_val
        _ -> n
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("multi_value_calls: three value-returning calls combined into one total");
    // Set up a field to test that it doesn't interfere with call results.
    main.offset = 38;

    // Three sequential value-returning calls with different arities.
    let r1: i32 in Saturating = double_val(15);    // r1 = 30
    let r2: i32 in Saturating = add3(5, 10, 7);   // r2 = 22
    let r3: i32 in Saturating = clamp_low(18, 20); // r3 = 20

    // Use all three results together with main.offset.
    let total: i32 in Saturating = r1 + r2 - r3 + main.offset;

    transition total == 70 {
        true -> check_r1(main, r1, r2, r3)
        _ -> bad_total(main)
    }

    state bad_total(main: &mut Main) {
        Console::write_line("FAIL: wrong combined total (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check_r1(main: &mut Main, r1: i32 in Saturating, r2: i32 in Saturating, r3: i32 in Saturating) {
        transition r1 == 30 {
            true -> check_r2(main, r2, r3)
            _ -> bad_r1(main)
        }
    }

    state bad_r1(main: &mut Main) {
        Console::write_line("FAIL: double_val(15) != 30 (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state check_r2(main: &mut Main, r2: i32 in Saturating, r3: i32 in Saturating) {
        transition r2 == 22 {
            true -> check_r3(main, r3)
            _ -> bad_r2(main)
        }
    }

    state bad_r2(main: &mut Main) {
        Console::write_line("FAIL: add3(5,10,7) != 22 (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state check_r3(main: &mut Main, r3: i32 in Saturating) {
        transition r3 == 20 {
            true -> good(main)
            _ -> bad_r3(main)
        }
    }

    state bad_r3(main: &mut Main) {
        Console::write_line("FAIL: clamp_low(18,20) != 20 (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: 30 + 22 - 20 + 38 = 70, all results intact (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
