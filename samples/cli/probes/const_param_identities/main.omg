public const SIZE: u64 = 7 / 2 * 2;
public const MATCH_SIZE: u64 = ((match true { true -> 7 / 2, false -> 9 / 2 }) * 2) + 0u64;
public const ENABLED: bool = SIZE == 7;
public const SIZES: [u64; 2] = [SIZE * 2, 3];
data Buffer<const Size: u64> { value: [u8; Size]; }
data Flag<const Enabled: bool> { value: u8; }
data Indexed<const Selected: [u64; 2]> { value: u8; }
machine keep(value: Buffer<SIZE>) -> Buffer<7> { value }
machine keep_match(value: Buffer<MATCH_SIZE>) -> Buffer<7> { value }
machine selected(value: Flag<ENABLED>) -> Flag<true> { value }
machine keep_sizes(value: Indexed<SIZES>) -> Indexed<SIZES> { value }
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
