// Inclusive range literals slice a view: `view[0..=2]` is a 3-element
// prefix and `view[1..=3]` a 3-element middle — the `..=` upper bound
// is part of the slice language.
data Entry {
    value: i32;
}
data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) -> u64 {
    let view: &[Entry] = &main.entries[..];
    let inclusive_prefix: &[Entry] = view[0..=2];
    let inclusive_middle: &[Entry] = view[1..=3];
    inclusive_prefix.len + inclusive_middle.len
}
