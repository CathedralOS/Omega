machine build(builder: @mutable Build) {
    Build::application(builder, "target_scoped_family");
    Build::select_provider::<Picker, SharedPick>(builder, linux_x86_64);
    Build::select_provider::<Picker, SharedPick>(builder, linux_arm64);
    Build::select_provider::<Picker, SharedPick>(builder, macos_arm64);
    Build::select_provider::<Picker, SharedPick>(builder, windows_x86_64);
    Build::select_provider::<Delta, SharedDelta>(builder, windows_x86_64);
    Build::select_provider::<Delta, SharedDelta>(builder, linux_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
