data Helper { seed: i32; }

boundary trait Picker {
    machine pick(helper: @Helper) -> i32 reaches none crashes none;
}

boundary trait Delta {
    machine delta(helper: @Helper) -> i32 reaches none crashes none;
}

SharedPick satisfies Picker { machine pick(helper: @Helper) -> i32 { 63 } }
SharedDelta satisfies Delta { machine delta(helper: @Helper) -> i32 { 7 } }

data Main { helper: Helper; }
machine run(main: @mutable Main) {
    main.helper = Helper { seed: 1 };
    let picked: i32 = Picker::pick(@main.helper);
    let delta: i32 = Delta::delta(@main.helper);
    transition picked == 63 && delta == 7 {
        (true) -> good(main, picked),
        _ -> bad(main)
    }
    machine good(main: @mutable Main, kept: i32) { let value: i32 = kept; }
    machine bad(main: @mutable Main) { let value: i32 = 0; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    run(@mutable entry_storage);
}
