// `scale <= 254` on a u8 is NOT vacuous (the carrier reaches 255),
// but the argument is a call whose result constant-folds, so the
// instantiated premise `4 <= 254` is decided-true and the call
// discharges.
machine echo(scale: u8) -> u8
requires scale <= 254u8
{
    transition { _ -> (scale) }
}
machine opaque() -> u8 {
    transition { _ -> (4u8) }
}

data Main {}
machine Main::main(main: &mut Main) {
    let s: u8 = opaque();
    let r: u8 = echo(s);
}
