// Expected exit: 0.
// Stored array references keep the original home through calls and projections.
data Buffer<'storage> { values: @'storage mutable [u64; 2]; }
data Matrix<'storage> { rows: @'storage mutable [[u64; 2]; 2]; }
data SharedBuffer<'storage> { values: @'storage [u64; 2]; }
data EmptyBuffer<'storage> { values: @'storage [u64; 0]; }

machine update<'storage>(incoming: @'storage mutable [u64; 2]) {
    let mutable buffer: Buffer = Buffer { values: incoming };
    buffer.values[1] = 66;
}

machine original<'storage>(incoming: @'storage mutable [u64; 2]) -> @'storage mutable [u64; 2] {
    incoming
}

machine original_child<'storage>(first: @'storage mutable [u64; 2], second: @'storage mutable [u64; 2]) -> @'storage mutable [u64; 2] {
    let mutable buffer: Buffer = Buffer { values: first };
    let child: @mutable [u64; 2] = @mutable buffer.values;
    buffer.values = second;
    child
}

machine observe(incoming: @[u64; 2]) -> u64 {
    let buffer: SharedBuffer = SharedBuffer { values: incoming };
    buffer.values[1]
}

machine initialize(incoming: @write [u64; 2]) {
    incoming[0] = 81;
    incoming[1] = 82;
}

machine inspect_empty(incoming: @[u64; 0]) {
    let buffer: EmptyBuffer = EmptyBuffer { values: incoming };
    let held: @[u64; 0] = buffer.values;
}

machine retained_child() crashes Trap {
    let mutable first: [u64; 2] = [11, 12];
    let mutable second: [u64; 2] = [21, 22];
    let mutable buffer: Buffer = Buffer { values: @mutable first };
    let child: @mutable [u64; 2] = @mutable buffer.values;
    buffer.values = @mutable second;
    child[0] = 65;
    transition first[0] == 65 && second[0] == 21 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let mutable values: [u64; 2] = [11, 12];
    let mutable buffer: Buffer = Buffer { values: @mutable values };
    buffer.values[0] = 65;
    update(@mutable values);
    let mutable cells: [[u64; 2]; 2] = [[21, 22], [31, 32]];
    let mutable matrix: Matrix = Matrix { rows: @mutable cells };
    matrix.rows[1][0] = 77;
    let returned: @mutable [u64; 2] = original(@mutable values);
    returned[0] = 67;
    let observed: u64 = observe(@values);
    let mutable output: [u64; 2] = [0, 0];
    initialize(@write output);
    let empty: [u64; 0] = [];
    inspect_empty(@empty);
    retained_child();
    let mutable original_values: [u64; 2] = [41, 42];
    let mutable replacement: [u64; 2] = [51, 52];
    let returned_child: @mutable [u64; 2] = original_child(@mutable original_values, @mutable replacement);
    returned_child[1] = 91;
    transition values[0] == 67 && observed == 66 && cells[1][0] == 77 && cells[0][0] == 21 && output[0] == 81 && output[1] == 82 && original_values[1] == 91 && replacement[1] == 52 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
