// Machine parameters bound by an authored signature
// schema — `where machine Schema<const Number: u64>
// (value: u64) -> u64 reaches Console` — carry a const
// binder AND an effect requirement; `Schema<2>(value)`
// calls the bound machine with its static argument.
//
//   * Two schemas in one param list: `Schema` and
//     `Unused` share the shape; the second is bound
//     but never called.
//   * `apply<selected, unused>(value)` — machine
//     names as call arguments.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

boundary trait Console { machine ping() reaches; }

machine apply<machine Schema, machine Unused>(value: u64) -> u64
where machine Schema<const Number: u64>(value: u64) -> u64 reaches Console;
where machine Unused<const Number: u64>(value: u64) -> u64 reaches Console;
{
    let first: u64 = Schema<2>(value);
    Schema<3>(first)
}

machine selected<const Count: u64>(value: u64) -> u64 reaches Console { Count }
machine unused<const Count: u64>(value: u64) -> u64 reaches Console { value }

machine enter(value: u64) -> u64 { apply<selected, unused>(value) }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let result: u64 = enter(5);
    transition result == 3 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
