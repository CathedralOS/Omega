// An &-receiver's indexed field element loans into a &T call argument:
// `&main.list.items[i]` under a `requires i < 4` guard.
public data Elem { value: u64; }
machine Elem::clone_of(source: &Elem) -> Elem {
    Elem { value: source.value }
}
public data List { items: [Elem; 4]; }
machine List::get(list: &List, position: u64) -> Elem requires position < 4 {
    (Elem::clone_of(&list.items[position]))
}
data Main { list: List; }
machine Main::probe(main: &Main, i: u64) -> Elem requires i < 4 {
    (Elem::clone_of(&main.list.items[i]))
}
machine Main::probe_get(main: &Main, i: u64) -> Elem requires i < 4 {
    (List::get(&main.list, i))
}
machine Main::main(main: &mut Main) {
    main.list = List { items: [Elem{value:1},Elem{value:2},Elem{value:3},Elem{value:4}] };
    _ = Main::probe(main, 2);
    _ = Main::probe_get(main, 3);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
