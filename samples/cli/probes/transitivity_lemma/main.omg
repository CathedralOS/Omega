// Transitivity lemma on machine scalars: `requires a < b  b < c`
// `ensures a < c` — one entailment hop past direct fact matching,
// discharged by the proof kernel with an EMPTY body.
//
//   * Requires rosters are comma-free adjacent clauses.
//   * `hits` records the reached arm.
//
// Compile-checked only: declaration surface, no standard-library
// dependency, no ProcessExit provider.

machine less_than_transitive(a: u64, b: u64, c: u64)
requires
    a < b
    b < c
ensures
    a < c
{
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}
