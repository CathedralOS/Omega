trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}
data Coin { value: i32; year: i32; }
CoinStructural satisfies Equatable<Coin> { }
CoinByValue satisfies Equatable<Coin> {
    machine equals(left: &Coin, right: &Coin) -> bool {
        left.value == right.value
    }
}
machine equal<T, Equality satisfies Equatable<T>>(left: &T, right: &T) -> bool {
    Equality::equals(left, right)
}
data Pos { x: i32; y: i32; }
PosEquality satisfies Equatable<Pos> { }
data Player { pos: Pos; health: i32; }
PlayerEquality satisfies Equatable<Player> { }
data Mark { x: i32; y: i32; }
machine marks_share_x(left: &Mark, right: &Mark) -> bool {
    left.x == right.x
}
MarkByX satisfies Equatable<Mark> {
    Equatable::equals = marks_share_x;
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let penny: Coin = Coin { value: 1, year: 2001 };
    let cent: Coin = Coin { value: 1, year: 1999 };
    let by_value: bool = CoinByValue::equals(&penny, &cent);
    let by_structure: bool = CoinStructural::equals(&penny, &cent);
    let generic: bool = equal<Coin, CoinByValue>(&penny, &cent);
    let a: Player = Player { pos: Pos { x: 1, y: 2 }, health: 5 };
    let b: Player = Player { pos: Pos { x: 1, y: 2 }, health: 5 };
    let players: bool = PlayerEquality::equals(&a, &b);
    let m1: Mark = Mark { x: 3, y: 4 };
    let m2: Mark = Mark { x: 3, y: 9 };
    let marked: bool = MarkByX::equals(&m1, &m2);
    transition by_value && !by_structure && generic && players && marked {
        (true) -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { let value: i32 = 1; }
    state bad(main: &mut Main) { let value: i32 = 0; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
