// A package may depend on a subdirectory of its own source tree:
// the edge resolves `sub` as an independent package — only a
// direct self-edge on the root directory itself conflicts.
machine build(builder: &mut Build) {
    Build::application(builder, "build_subdir_edge");
    builder.freestanding = true;
    let mut selfsub_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "sub" });
    dependency::with_alias(&mut selfsub_dependency, "selfsub");
    let selfsub_registration: DependencyRegistration = Build::dependency(builder, selfsub_dependency);
}
