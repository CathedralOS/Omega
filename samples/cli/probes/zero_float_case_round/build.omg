use zero_float_case_round/rounding.omg;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "zero_float_case_round" };
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled { name: "system" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, |rounding|::Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |rounding|::Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |rounding|::Main::main);
    Build::bind(builder, macos_x86_64::ProgramEntry, |rounding|::Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |rounding|::Main::main);
}
