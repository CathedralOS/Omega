machine build(builder: &mut Build) {
    Build::application(builder, "zero_float_case_round");
    Build::depend(builder, Source::Path { location: "../../../../source/library/std" });
    Build::bind(builder, linux_x86_64::ProgramEntry, zero_float_case_round::Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, zero_float_case_round::Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, zero_float_case_round::Main::main);
    Build::bind(builder, macos_x86_64::ProgramEntry, zero_float_case_round::Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, zero_float_case_round::Main::main);
}
