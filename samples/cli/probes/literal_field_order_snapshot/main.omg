// Record literal fields evaluate in order: `samples` snapshots the array
// before `stamp(context)` mutates it — the packet keeps [30, 40] while the
// source lands at 90.
data Packet { samples: [i32; 2]; stamp: i32; }
data Main { packet: Packet; samples: [i32; 2]; }
machine stamp(context: &mut Main) -> i32 {
    context.samples[0] = 90;
    7
}
machine Main::main(context: &mut Main) {
    context.samples = [30, 40];
    context.packet = Packet { samples: context.samples, stamp: stamp(context) };
    transition context.packet.samples[0] == 30 && context.packet.samples[1] == 40
        && context.packet.stamp == 7 && context.samples[0] == 90 {
        true -> finish(context)
        false -> bad(context)
    }
    machine finish(context: &mut Main) { }
    machine bad(context: &mut Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
