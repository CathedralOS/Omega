// Package aliases select the same exact payload-free case as braces:
// `Value::Empty` and `Value::Empty {}` denote one constructor.
use {leaf}/settings/settings.omg;

machine bare() -> |settings|::Value { |settings|::Value::Empty }
machine braces() -> |settings|::Value { |settings|::Value::Empty {} }

data Main {}

machine Main::main(main: @mutable Main) {
    let a: |settings|::Value = bare();
    let b: |settings|::Value = braces();
}
