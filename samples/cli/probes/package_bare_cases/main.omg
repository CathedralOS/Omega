// Package aliases select the same exact payload-free case as braces:
// `Value::Empty` and `Value::Empty {}` denote one constructor.
use leaf::settings;

machine bare() -> leaf::settings::Value { leaf::settings::Value::Empty }
machine braces() -> leaf::settings::Value { leaf::settings::Value::Empty {} }

data Main {}

machine Main::main(main: &mut Main) {
    let a: leaf::settings::Value = bare();
    let b: leaf::settings::Value = braces();
}
