// Theorem machines whose `ensures` obligations are discharged by
// shipped certificates: `equal_symmetric` proves `b == a` from
// `a == b`, `equal_transitive` proves `a == c` from `a == b` and
// `b == c`. Empty bodies — the certificate travels the proof-bundle
// wire and is checked by the kernel at admission. Citations at
// closed arguments lower as ordinary Unit calls carrying their
// discharged obligation identities as proof metadata.
machine equal_symmetric(a: u64, b: u64)
requires
    a == b
ensures
    b == a
{
}
machine equal_transitive(a: u64, b: u64, c: u64)
requires
    a == b
    b == c
ensures
    a == c
{
}
data Main {}
machine Main::main(main: &mut Main) {
    equal_symmetric(3, 3);
    equal_transitive(3, 3, 3);
}
