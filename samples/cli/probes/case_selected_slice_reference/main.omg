// Case selection returns a child of an established mutable slice.
// Expected exit: 0.
data Selection [copy] { case First; case Second; case Last; }
data Cell { value: u64; }
data Storage { cells: [Cell; 3]; alternate: [Cell; 3]; }

machine select(storage: @mutable Storage, selection: Selection) -> @mutable Cell {
    let cells: @mutable [Cell] = @mutable storage.cells[..];
    transition selection {
        Selection::First -> @mutable cells[0],
        Selection::Second -> @mutable cells[1],
        _ -> @mutable cells[2]
    }
}

machine select_rebound(storage: @mutable Storage, selection: Selection) -> @mutable Cell {
    let mutable cells: @mutable [Cell] = @mutable storage.cells[..];
    cells = @mutable storage.alternate[..];
    transition selection {
        Selection::First -> @mutable cells[0],
        Selection::Second -> @mutable cells[1],
        _ -> @mutable cells[2]
    }
}

machine main() crashes Trap {
    let mutable storage: Storage = Storage { cells: [
        Cell { value: 3 }, Cell { value: 5 }, Cell { value: 7 }
    ], alternate: [
        Cell { value: 11 }, Cell { value: 13 }, Cell { value: 17 }
    ] };
    let selected: @mutable Cell = select(@mutable storage, Selection::Second);
    selected.value = 19;
    let first: @mutable Cell = select(@mutable storage, Selection::First);
    first.value = 23;
    let last: @mutable Cell = select(@mutable storage, Selection::Last);
    last.value = 29;
    let rebound: @mutable Cell = select_rebound(@mutable storage, Selection::Second);
    rebound.value = 31;
    transition storage.cells[0].value == 23 && storage.cells[1].value == 19
        && storage.cells[2].value == 29 && storage.alternate[0].value == 11
        && storage.alternate[1].value == 31 && storage.alternate[2].value == 17 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
