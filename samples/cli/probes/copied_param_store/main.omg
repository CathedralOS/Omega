// By-value param copies: `let mut copy: Item = item;` is fresh
// storage the caller cannot observe — storing a case-valued field
// or a count writes only the copy. `[copy]` data + `u64 in
// Trapping` domain field.
//
//   * `Kind::tag(kind) -> u64 in Trapping` case dispatch on a
//     copy enum.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Kind [copy] {
    case First;
    case Second;
}

data Item [copy] {
    kind: Kind;
    count: u64 in Trapping;
}

machine Kind::tag(kind: Kind) -> u64 in Trapping {
    transition kind {
        Kind::First -> one()
        _ -> two()
    }

    state one() -> u64 in Trapping { 1 }
    state two() -> u64 in Trapping { 2 }
}

machine Item::promoted(item: Item) -> Item {
    let mut copy: Item = item;
    copy.kind = Kind::Second;
    copy.count = copy.count + 7;
    copy
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let original: Item = Item { kind: Kind::First, count: 2 };
    let lifted: Item = Item::promoted(original);
    transition original.kind == Kind::First
        && lifted.kind == Kind::Second
        && lifted.count == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
