// `&write` attenuates an exclusive place to a write-only
// loan: the callee may store but never read, and the
// loan forwards through ordinary call parameters.
//
//   * `&write i32` parameter + `&write destination`
//     argument — write-only loan spelled at both ends.
//   * `forward` re-lends `&write destination` — the
//     attenuation composes through forwarding.
//   * The caller's local is mutated by the whole-scalar
//     replacement even though nothing read it.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

machine replace(destination: &write i32, value: i32) {
    destination = value;
}

machine forward(destination: &write i32, value: i32) {
    replace(&write destination, value);
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut destination: i32 = 0;
    forward(&write destination, 42);
    transition destination == 42 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
