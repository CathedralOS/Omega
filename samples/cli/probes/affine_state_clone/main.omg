// Element-by-element clone through a cycle of `-> Cell` states: `each`
// walks `position`, `store` writes one indexed member under
// `requires position < 2`, and the false arm returns the finished copy.
data Cell { values: [i32; 2]; count: u64; }
data Worker {}
machine Worker::new() -> Cell { Cell { count: 0 } }
machine Worker::copy(source: &Cell) -> Cell {
    Cell { values: source.values, count: source.count }
}
machine Worker::clone(source: &Cell) -> Cell {
    let mut copied: Cell = Worker::new();
    copied.count = source.count;
    transition { _ -> each(&mut copied, source, 0) }
    state each(copied: &mut Cell, source: &Cell, position: u64) -> Cell {
        transition position < 2 {
            true -> store(copied, source, position)
            false -> (Worker::copy(copied))
        }
    }
    state store(copied: &mut Cell, source: &Cell, position: u64) -> Cell
        requires position < 2;
    {
        copied.values[position] = source.values[position];
        transition { _ -> each(copied, source, position + 1) }
    }
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let c: Cell = Cell { values: [4, 9], count: 7 };
    let d: Cell = Worker::clone(&c);
    main.hits = main.hits + (d.values[1] as i32 in Wrapping);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
