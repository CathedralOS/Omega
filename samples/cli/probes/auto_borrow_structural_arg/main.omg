// A value argument auto-borrows at the call site when the
// callee takes `&T`: `Payload::clone(payload)` passes the
// arm-bound value where `source: &Payload` is declared —
// the call loans the binding, the original stays readable
// for a later `Payload::read(payload)` on the same value.
//
//   * `Payload::clone(payload)` / `Payload::read(payload)`
//     — auto-borrow into `&Payload` params.
//   * `Selection::Found { payload: Payload::clone
//     (payload) }` — structural result owns fresh
//     contents, source payload unaffected.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Payload { value: u64 in Wrapping; }

machine Payload::clone(source: &Payload) -> Payload {
    Payload { value: source.value + 1 }
}

machine Payload::read(source: &Payload) -> u64 { source.value as u64 }

data Selection {
    case Found(payload: Payload);
    case Empty;
}

machine Selection::clone(source: &Selection) -> Selection {
    transition source {
        Selection::Found { payload } -> (Selection::Found {
            payload: Payload::clone(payload)
        })
        Selection::Empty -> (Selection::Empty)
    }
}

machine Selection::read(source: &Selection) -> u64 {
    transition source {
        Selection::Found { payload } -> (Payload::read(payload))
        Selection::Empty -> (0)
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let original: Selection = Selection::Found { payload: Payload { value: 41 } };
    let copied: Selection = Selection::clone(&original);
    transition Selection::read(&copied) == 42 && Selection::read(&original) == 41 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
