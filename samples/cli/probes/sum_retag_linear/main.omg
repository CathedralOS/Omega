// Sum retag with linear payloads, repaired through `&mut`:
// `repair(&mut holder.choice, inc)` transitions the sum in
// place — `transition choice` extracts the `token` payload
// per case and rebuilds under the opposite tag when the
// increment fires. A whole `choice = transform(choice)`
// result-assignment is rejected (no unique conserved claim
// mapping); in-place repair is the spellable route.
//
//   * `Choice::Success { token } -> change(token, inc)`.
//   * `consume(holder.choice)` dispatch on the retagged sum.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}

data Choice { case Success(token: Token); case Failure(token: Token); }
data Holder { marker: u64; choice: Choice; }

machine change(token: Token, increment: bool) -> Choice {
    transition increment {
        true -> replace(token)
        _ -> Choice::Failure { token: token }
    }
    machine replace(token: Token) -> Choice {
        let value: u64 = token.value;
        drop(token);
        Choice::Success { token: Token { value: ((value as u64 in Wrapping) + 1) as u64 } }
    }
}

machine transform(choice: Choice, increment: bool) -> Choice {
    transition choice {
        Choice::Success { token } -> change(token, increment)
        Choice::Failure { token } -> change(token, increment)
    }
}

machine repair(choice: &mut Choice, increment: bool) {
    choice = transform(choice, increment);
}

machine consume(choice: Choice) -> u64 {
    transition choice {
        Choice::Success { token } -> read_and_drop(token)
        Choice::Failure { token } -> read_and_drop(token)
    }
    machine read_and_drop(token: Token) -> u64 {
        let value: u64 = token.value;
        drop(token);
        value
    }
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut holder: Holder = Holder {
        marker: 19,
        choice: Choice::Failure { token: Token { value: 41 } },
    };
    repair(&mut holder.choice, false);
    repair(&mut holder.choice, true);
    let result: u64 = consume(holder.choice);
    transition holder.marker == 19 && result == 42 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
