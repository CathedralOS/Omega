// Expected exit: 0.
// The portable binding pins an explicitly selected raw implementation map.
// An unrelated Build selection for RawSource must not retarget that map.
public data Observation { value: i32; }

public boundary trait RawSource {
    machine read() -> i32 reaches none crashes none;
    machine fill(destination: @mutable Observation) reaches none crashes none;
}
public boundary trait PortableSource {
    machine read() -> i32 reaches none invokes RawSource crashes none;
}
data RawProvider {}
data OtherRawProvider {}
data PortableProvider {}
machine RawProvider::read() -> i32 satisfies RawSource::read { 41 }
machine RawProvider::fill(destination: @mutable Observation) satisfies RawSource::fill {
    destination.value = 41;
}
machine OtherRawProvider::read() -> i32 satisfies RawSource::read { 99 }
machine OtherRawProvider::fill(destination: @mutable Observation) satisfies RawSource::fill {
    destination.value = 99;
}
RawImplementation satisfies RawSource {
    machine read() -> i32 reaches none {
        RawProvider::read()
    }
    machine fill(destination: @mutable Observation) reaches none {
        RawProvider::fill(destination)
    }
}
machine through_evidence<Selected satisfies RawSource>() -> i32 {
    RawSource::read::<Selected>()
}
machine fill_through_evidence<Selected satisfies RawSource>(destination: @mutable Observation) {
    RawSource::fill::<Selected>(destination);
}
machine PortableProvider::read() -> i32 satisfies PortableSource::read {
    let mutable observed: Observation;
    RawSource::fill::<RawImplementation>(@mutable observed);
    let mutable qualified_observation: Observation;
    RawImplementation::fill(@mutable qualified_observation);
    let mutable forwarded_observation: Observation;
    fill_through_evidence::<RawImplementation>(@mutable forwarded_observation);
    let direct: i32 = RawSource::read::<RawImplementation>();
    let qualified: i32 = RawImplementation::read();
    let forwarded: i32 = through_evidence::<RawImplementation>();
    transition observed.value == 41 && qualified_observation.value == 41 && forwarded_observation.value == 41 && direct == 41 && qualified == 41 && forwarded == 41 {
        true -> (41),
        false -> (0)
    }
}
data Main { }
machine Main::main(context: @mutable Main) crashes Trap {
    let answer: i32 = PortableSource::read();
    transition answer == 41 { true -> done(), false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
