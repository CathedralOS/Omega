// Fully qualified case membership tests across a package dependency:
// `value in |outcomes|::Outcome::Empty` names the case through the
// package alias and its module.
use {leaf}/outcomes/outcomes.omg;

machine is_empty(value: @|outcomes|::Outcome) -> bool {
    value in |outcomes|::Outcome::Empty
}
machine has_value(value: @|outcomes|::Outcome) -> bool {
    value in |outcomes|::Outcome::Value
}

data Main {}

machine Main::main(main: @mutable Main) {
    let v: |outcomes|::Outcome = |outcomes|::Outcome::Value { item: 3, common: 1 };
    let yes: bool = has_value(@v);
    let no: bool = is_empty(@v);
}
