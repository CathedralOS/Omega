// Fully qualified case membership tests across a package dependency:
// `value in leaf::outcomes::Outcome::Empty` names the case through the
// package alias and its module.
use leaf::outcomes;

machine is_empty(value: &leaf::outcomes::Outcome) -> bool {
    value in leaf::outcomes::Outcome::Empty
}
machine has_value(value: &leaf::outcomes::Outcome) -> bool {
    value in leaf::outcomes::Outcome::Value
}

data Main {}

machine Main::main(main: &mut Main) {
    let v: leaf::outcomes::Outcome = leaf::outcomes::Outcome::Value { item: 3, common: 1 };
    let yes: bool = has_value(&v);
    let no: bool = is_empty(&v);
}
