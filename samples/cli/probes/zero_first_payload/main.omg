// Payload-bearing FIRST case: the all-zero representation selects
// `Number(0)` — a zero-initialized `Token` IS `Token::Number`
// with a zeroed, established payload. Payload-free cases have no
// privileged relationship to zero.
//
//   * `let token: Token;` zero-init → `token in Token::Number`
//     and `token.value == 0`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Token {
    case Number(value: i32);
    case End;
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let token: Token;
    transition token {
        Token::Number { value } -> number(value, main)
        Token::End -> fail(main)
    }
    state number(value: i32, main: &mut Main) {
        transition value == 0 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
