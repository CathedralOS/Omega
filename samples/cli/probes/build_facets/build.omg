// `builder.source` is a compiler-issued BuildSource facet usable in
// place by borrow: resolve/open/read/close all evaluate against the
// activation source root.
machine build(builder: &mut Build) {
    Build::application(builder, "build_facets");
    builder.freestanding = true;
    let p: BuildPath = BuildSource::resolve(&builder.source, "main.omg");
    let d: i32 = BuildSource::open(&builder.source, p, 0);
    let bytes: [u8] = [0,0,0,0,0,0,0,0];
    let n: i64 = BuildSource::read(&builder.source, d, &mut bytes, 8);
    let c: i32 = BuildSource::close(&builder.source, d);
}
