// Const names participate in ordinary lexical scoping: a
// parameter or `let` named `KEY` shadows the const from
// its binding point onward, while reads before the
// shadowing still see the const.
//
//   * `machine keep(KEY: Key)` — the const name as a
//     parameter: the body reads the argument, not the
//     const.
//   * `let KEY: Key = input;` — a local shadowing the
//     const.
//   * `let selected: Key = KEY;` then `let KEY: Key =
//     input;` — `selected` snapshots the const before the
//     shadow lands.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Key [copy] { value: u64; }
const KEY: Key = Key { value: 1 };

machine keep(KEY: Key) -> Key { KEY }

machine local_key(input: Key) -> Key {
    let KEY: Key = input;
    KEY
}

machine later_key(input: Key) -> Key {
    let selected: Key = KEY;
    let KEY: Key = input;
    selected
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let shadowed_param: Key = keep(Key { value: 2 });
    transition shadowed_param.value == 2 {
        true -> more(main)
        _ -> fail(main)
    }
    state more(main: &mut Main) {
        let shadowed_local: Key = local_key(Key { value: 3 });
        let early_snapshot: Key = later_key(Key { value: 4 });
        transition shadowed_local.value == 3 && early_snapshot.value == 1 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
