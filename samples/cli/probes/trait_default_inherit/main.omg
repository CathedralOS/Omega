// Trait requirements carry default bodies:
// `machine reset(subject: &mutable T) { set(&mutable
// subject, 30); }` inside a trait — a named
// implementation of the child alone receives the
// inherited machine. Two parents contributing
// conflicting defaults settle through an authored
// override.
//
//   * `trait RequiredCounter<T>: Resettable<T>` —
//     the default flows through header-parent
//     composition; `satisfies RequiredCounter` needs
//     only `set`.
//   * `satisfies Resettable<Dual>` on both parents:
//     the impl names `reset` itself to arbitrate.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

trait Resettable<T> {
    machine set(subject: @mutable T, value: i32);

    machine reset(subject: @mutable T) {
        set(@mutable subject, 30);
    }
}

trait RequiredCounter<T>: Resettable<T> {
}

data Counter {
    value: i32;
}

machine Counter::set(counter: @mutable Counter, value: i32) satisfies Resettable<Counter>::set {
    counter.value = value;
}
machine Counter::reset(counter: @mutable Counter) satisfies Resettable<Counter>::reset {
    counter.value = 30;
}

CounterImpl satisfies RequiredCounter<Counter> {
    machine set(subject: @mutable Counter, value: i32) { Counter::set(subject, value) }
    machine reset(subject: @mutable Counter) { Counter::reset(subject) }
}

data Main { counter: Counter; hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    Counter::reset(@mutable main.counter);
    transition main.counter.value == 30 {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
