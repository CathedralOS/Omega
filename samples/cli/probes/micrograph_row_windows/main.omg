// A label image lends one row as a mutable window. Both halves of the
// first strip have length 2. The caller writes that window straight from
// the lending call, then again through a local stored in a record field.
// Expected exit: 0
data Image { labels: [i32; 4]; }
data Held<'row> { values: @'row mutable [i32]; }

machine half<'row>(image: @'row mutable Image, which: i64) -> @'row mutable [i32]
ensures result.length == 2
{
    match which {
        0 -> @mutable image.labels[0..2],
        _ -> @mutable image.labels[2..4]
    }
}

machine write_pair(window: @mutable [i32])
requires window.length >= 2 {
    window[0] = 9;
    window[1] = 8;
}

machine main() crashes Trap {
    let mutable image: Image;
    image.labels[0] = 1;
    image.labels[1] = 2;
    image.labels[2] = 3;
    image.labels[3] = 4;
    transition { _ -> paint(@mutable image) }
    machine paint(image: @mutable Image) {
        write_pair(half(image, 0));
        let view: @mutable [i32] = half(image, 0);
        let held: Held = Held { values: view };
        write_pair(held.values);
        transition image.labels[0] == 9 && image.labels[1] == 8 && image.labels[2] == 3 && image.labels[3] == 4 {
            true -> done(),
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
