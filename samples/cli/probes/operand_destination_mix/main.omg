// Operand destinations: anonymous comptime arithmetic folds into
// bitwise operands at every destination — direct `(x / x) | 8`,
// match arms `(match flag { 2^64/2^64, 7/2*2 }) | (8 | 16)`,
// qualified `(match ..) + 1) as u64` casts on match results.
//
//   * `18446744073709551616` — a literal ONE PAST u64 max folds
//     exactly (comptime rationals are unbounded).
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine direct() -> u64 {
    (18446744073709551616 / 18446744073709551616) | 8u64
}

machine composed(flag: bool) -> u64 {
    (match flag {
        true -> 18446744073709551616 / 18446744073709551616
        false -> 7 / 2 * 2
    }) | (8u64 | 16u64)
}

machine qualified(flag: bool, value: u64 in Wrapping) -> u64 {
    ((match flag {
        true -> value + 1
        false -> 18446744073709551616 / 18446744073709551616
    }) + 1) as u64
}

machine combine(flag: bool) -> u64 {
    qualified(flag, 9 as u64 in Wrapping)
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition combine(true) | composed(false) == 17 && direct() == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
