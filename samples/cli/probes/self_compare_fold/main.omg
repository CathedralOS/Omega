// Self-compare folding: `transition value < value` is a real
// selected compare whose flag state is always false — the
// terminator folds to the untaken jump and `decide(7)` returns
// 43, while `decided == 43` beside it stays a runtime compare.
//
//   * `value < value` self-comparison.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

machine decide(value: i64) -> i64 {
    transition value < value {
        true -> taken()
        _ -> untaken()
    }

    machine taken() -> i64 { 41 }
    machine untaken() -> i64 { 43 }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let decided: i64 = decide(7);
    transition decided == 43 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
