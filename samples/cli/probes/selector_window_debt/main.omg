// Selector mutation during an open element window: the
// element move pins the coordinate it opened at — mutating
// `at` afterward creates no debt, and the restore lands on
// the saved coordinate, not the mutated one.
//
//   * `let first: Token = tokens[at]` extract.
//   * `reset(@mutable unrelated)` + `at = 2` mutation mid-window.
//   * `tokens[1] = first` store at the literal coordinate.
//

// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Token dropped by drop_token { byte: i32; }
machine drop_token(token: @mutable Token) { token.byte = 0; }

machine reset(index: @mutable u64) { $index = 0; }

machine rotate(tokens: @mutable [Token], initial: u64)
requires tokens.length >= 2, initial < 2
{
    let mutable at: u64 = initial;
    let mutable unrelated: u64 = initial;
    let first: Token = tokens[at];
    reset(@mutable unrelated);
    tokens[at] = Token { byte: 19 };
    tokens[1] = first;
    at = 2;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: @mutable Main) {
    main.hits = 0;
    let mutable tokens: [Token; 3] = [Token { byte: 7 }, Token { byte: 8 }, Token { byte: 9 }];
    let view: @mutable [Token] = @mutable tokens[..];
    rotate(view, 1);
    let a: i32 = tokens[0].byte;
    let b: i32 = tokens[1].byte;
    let outcome: bool = a == 19 && b == 8;
    drop(tokens[0]);
    drop(tokens[1]);
    drop(tokens[2]);
    transition outcome {
        true -> pass(main),
        _ -> fail(main)
    }
    machine pass(main: @mutable Main) { main.hits = 1; }
    machine fail(main: @mutable Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
