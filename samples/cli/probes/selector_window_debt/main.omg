// Selector mutation during an open element window: the
// element move pins the coordinate it opened at — mutating
// `at` afterward creates no debt, and the restore lands on
// the saved coordinate, not the mutated one.
//
//   * `let first: Token = tokens[at]` extract.
//   * `reset(&mut unrelated)` + `at = 2` mutation mid-window.
//   * `tokens[1] = first` store at the literal coordinate.
//
use omega::language::core::drop;

// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }

machine reset(index: &mut u64) { index = 0; }

machine rotate(tokens: &mut [Token], initial: u64)
requires tokens.len >= 2, initial < 2
{
    let mut at: u64 = initial;
    let mut unrelated: u64 = initial;
    let first: Token = tokens[at];
    reset(&mut unrelated);
    tokens[at] = Token { byte: 19 };
    tokens[1] = first;
    at = 2;
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut tokens: [Token; 3] = [Token { byte: 7 }, Token { byte: 8 }, Token { byte: 9 }];
    let view: &mut [Token] = &mut tokens[..];
    rotate(view, 1);
    let a: i32 = tokens[0].byte;
    let b: i32 = tokens[1].byte;
    let outcome: bool = a == 19 && b == 8;
    drop(tokens[0]);
    drop(tokens[1]);
    drop(tokens[2]);
    transition outcome {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
