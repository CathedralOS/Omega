// ReceiptSettlement consumes the linear receipt carried by ReceiptState::Live.
// The caller matches the sum. Empty has no claim. Live moves the receipt into
// the trait, and the selected abs provider returns its absolute code.
// Expected exit: 0.

data Receipt [linear] {
    code: i32;
}

data ReceiptState {
    case Empty;
    case Live(receipt: Receipt);
}

boundary trait ReceiptSettlement {
    machine settle(receipt: Receipt) -> i32
    reaches;
}

machine entry_start() crashes Trap {
    let empty: ReceiptState = ReceiptState::Empty;
    let live: ReceiptState = ReceiptState::Live { receipt: Receipt { code: -4 } };
    transition empty {
        ReceiptState::Empty -> settle_live(live)
        _ -> bad()
    }
    machine settle_live(state: ReceiptState) crashes Trap {
        transition state {
            ReceiptState::Live { receipt } -> finish(receipt)
            _ -> bad()
        }
    }
    machine finish(receipt: Receipt) crashes Trap {
        let code: i32 = ReceiptSettlement::settle(receipt);
        transition code == 4 { true -> done() _ -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
