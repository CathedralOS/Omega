// `boundary requirement` declarations: a bodyless boundary
// contract on data — the consuming contract other machines (or a
// provider) must satisfy. Three shapes sit side by side:
// `boundary trait` (named service), `boundary machine` (named
// operation), `boundary requirement` (attached obligation).
//
//   * `boundary requirement ReceiptState::settle(state)` —
//     consuming-contract decl on an affine sum carrying a linear
//     payload (`Live(receipt: Receipt)` with `Receipt [linear]`).
//   * `hits` records the reached arm.
//
// Compile-checked only: requirement decls are provider-satisfiable
// contracts — no provider is realized here.

data Receipt [linear] {
    code: i32;
}

data ReceiptState {
    case Empty;
    case Live(receipt: Receipt);
}

boundary requirement ReceiptState::settle(state: ReceiptState);

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
