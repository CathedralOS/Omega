use {omega}/language/core/external_binding.omg as foreign;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "boundary_requirement" };
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind_native::<ReceiptSettlement::settle>(builder, linux_x86_64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    });
    Build::bind_native::<ReceiptSettlement::settle>(builder, linux_arm64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.17",
        },
    });
    Build::bind_native::<ReceiptSettlement::settle>(builder, macos_arm64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_abs",
        },
    });
    Build::bind_native::<ReceiptSettlement::settle>(builder, windows_x86_64, |foreign|::ForeignBinding::DllImport {
        import: |foreign|::DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    });
}
