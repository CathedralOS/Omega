machine build(builder: &mut Build) {
    Build::application(builder, "boundary_requirement");
    Build::select_provider<ReceiptSettlement, ReceiptSink>(builder, linux_arm64);
    Build::select_provider<ReceiptSettlement, ReceiptSink>(builder, linux_x86_64);
    Build::select_provider<ReceiptSettlement, ReceiptSink>(builder, macos_arm64);
    Build::select_provider<ReceiptSettlement, ReceiptSink>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
