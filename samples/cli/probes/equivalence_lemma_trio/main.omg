// Equivalence lemma trio: `proposition equivalent(a, b) = a == b`
// declares a proposition WITH a definitional body; reflexive/
// symmetric/transitive lemma machines give it the equivalence
// structure core::relation traits consume.
//
//   * `proposition p(a, b) = <expr>` — body, not just a signature.
//   * Three machines whose ensures spell the equivalence laws.
//
// Compile-checked only: declaration surface (lemma bodies are
// proof objects), no standard-library dependency.

data Representative {
    case Zero;
    case Next(previous: Representative);
}

proposition equivalent(a: Representative, b: Representative) = a == b;

machine equivalent_reflexive(a: Representative)
ensures a == a
{
}

machine equivalent_symmetric(a: Representative, b: Representative)
requires
    a == b
ensures b == a
{
}

machine equivalent_transitive(
    a: Representative,
    b: Representative,
    c: Representative
)
requires
    a == b
    b == c
ensures a == c
{
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
