// Match expressions in const initializers: `const ALIAS:
// Outer = match true { true -> Outer { inner: SOURCE },
// false -> Outer { inner: Token { value: 7 } } }` — the
// arms evaluate at compile time, and the taken arm's
// record literal may reference earlier consts.
//
//   * `const SOURCE: Token = Token { value: 7 }` — const
//     record feeding the match arm.
//   * `data Outer { inner: Token }` — nested record const
//     target.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Token [copy] { value: u64; }
data Outer [copy] { inner: Token; }

const SOURCE: Token = Token { value: 7 };
const ALIAS: Outer = match true {
    true -> Outer { inner: SOURCE },
    false -> Outer { inner: Token { value: 7 } }
};

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition ALIAS.inner.value == 7 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
