// Case identities as domains: `Choice::Cell` is a domain — a
// machine can `ensures result in Choice::Cell` and later machines
// can `requires choice in Choice::Cell`. A saved call result
// keeps the guarantee: `choice` discharges the requires on
// reference AND by-value calls after intervening work.
//
//   * `machine make() -> Choice ensures result in Choice::Cell`.
//   * `observe(&Choice) requires choice in Choice::Cell` /
//     `take(Choice) requires choice in Choice::Cell`.
//   * The caller is a free `machine main()` — see README: the
//     identical calls inside a carrier entry
//     `Main::main(main: &mut Main)` FAIL to inherit the saved
//     guarantee ('cannot prove requires contract').
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Choice {
    case Cell(counter: u32);
    case Empty;
}

machine make() -> Choice
ensures result in Choice::Cell
{
    Choice::Cell { counter: 3 }
}

machine observe(choice: &Choice, amount: u32) -> u32
requires choice in Choice::Cell
{
    amount
}

machine take(choice: Choice, amount: u32) -> u32
requires choice in Choice::Cell
{
    transition choice {
        Choice::Cell { counter } -> (((counter as u32 in Wrapping) + (amount as u32 in Wrapping)) as u32)
        Choice::Empty -> (0)
    }
}

machine main() {
    let choice: Choice = make();
    let first: u32 = observe(&choice, 3);
    let second: u32 = observe(&choice, 4);
    let third: u32 = take(choice, 5);
    transition first == 3 && second == 4 && third == 8 {
        true -> done()
        _ -> done()
    }
    machine done() {}
}
