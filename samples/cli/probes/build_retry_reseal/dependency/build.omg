// Complete once with the writer open. The Retry branch closes the writer,
// settles the promised file, and hands the complete package to its consumer.

machine build(builder: @mutable BuildPlan) {
    let template: BuildPath = BuildSource::resolve(@builder.source, "template.txt");
    let reader: i32 = BuildSource::open(@builder.source, template, 0);
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "generated.omg");
    let generated: BuildPath = BuildOutput::resolve(@builder.output, "generated.omg");
    let writer: i32 = BuildOutput::create(@mutable builder.output, generated, 0);
    transfer(builder, reader, writer);
    _ = BuildSource::close(@builder.source, reader);
    let first: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, generated);
    settle_first(builder, first, writer);
}

machine settle_first(builder: @mutable BuildPlan, completion: OutputCompletion, writer: i32) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> reseal(builder, obligation, file, writer)
    }
    machine sealed(builder: @mutable BuildPlan) {
    }
    machine reseal(builder: @mutable BuildPlan, obligation: RequiredOutput, file: BuildPath, writer: i32) {
        let _sealed: i32 = BuildOutput::close(@mutable builder.output, writer);
        let second: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, file);
        settle_second(builder, second);
    }
}

machine settle_second(builder: @mutable BuildPlan, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable BuildPlan) {
        copy(builder, "main.omg");
        copy(builder, "seed.omg");
        let next: BuildPath = BuildOutput::resolve(@builder.output, "next.omg");
        let writer: i32 = BuildOutput::create(@mutable builder.output, next, 0);
        _ = BuildOutput::write(@mutable builder.output, writer,
            "machine build(plan: @mutable BuildPlan) { plan.product = BuildProduct::Package { name: \"retry_kernel\" }; }");
        _ = BuildOutput::close(@mutable builder.output, writer);
        let directory: BuildPath = BuildOutput::resolve(@builder.output, "");
        builder.package_root = BuildPackageRoot::Directory { path: directory };
        builder.product = BuildProduct::InterpretedBuild { entry: "next.omg" };
    }
    machine failed(builder: @mutable BuildPlan, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "resealed output did not settle");
    }
}

// Copy the two short handwritten files verbatim, including their line endings.
machine copy(plan: @mutable BuildPlan, name: @[u8]) crashes Trap {
    let source: BuildPath = BuildSource::resolve(@plan.source, name);
    let reader: i32 = BuildSource::open(@plan.source, source, 0);
    let destination: BuildPath = BuildOutput::resolve(@plan.output, name);
    let writer: i32 = BuildOutput::create(@mutable plan.output, destination, 0);
    transfer(plan, reader, writer);
    _ = BuildSource::close(@plan.source, reader);
    _ = BuildOutput::close(@mutable plan.output, writer);
}

machine transfer(plan: @mutable BuildPlan, reader: i32, writer: i32) crashes Trap {
    let mutable byte: [u8; 1];
    let count: i64 = BuildSource::read(@plan.source, reader, @mutable byte[..], 1u64);
    transition count {
        0i64 -> done(),
        1i64 -> write_byte(plan, reader, writer, byte),
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
    machine write_byte(plan: @mutable BuildPlan, reader: i32, writer: i32, byte: [u8; 1]) {
        let written: i64 = BuildOutput::write(@mutable plan.output, writer, @byte[..]);
        transition written == 1i64 {
            true -> transfer(plan, reader, writer),
            false -> failed()
        }
    }
}
