use {omega}/build/dependency.omg;
use main.omg as consumer;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_retry_reseal" };
    let mutable kit_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "dependency" });
    |dependency|::with_alias(@mutable kit_dependency, "kit");
    _ = |dependency|::add(builder, kit_dependency);
    Build::bind(builder, linux_x86_64::ProgramEntry, |consumer|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |consumer|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |consumer|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |consumer|::main);
    Build::bind(builder, windows_arm64::ProgramEntry, |consumer|::main);
}
