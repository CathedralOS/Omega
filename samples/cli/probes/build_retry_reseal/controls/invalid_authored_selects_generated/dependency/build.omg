// Required-output retry recovery: the first `complete` runs while the
// writer is still live, so the evaluator hands the obligation and file
// custody back as `OutputCompletion::Retry`. The retry path then seals the
// writer, includes the staged source, and completes for real — the
// success direction of the custody loop, not the pinned failure.

machine build(builder: @mutable Build) {
    Build::package(builder, "stratum_kernel");
    let template: BuildPath = BuildSource::resolve(@builder.source, "template.txt");
    let reader: i32 = BuildSource::open(@builder.source, template, 0);
    let mutable bytes: [u8; 43];
    _ = BuildSource::read(@builder.source, reader, @mutable bytes[..], 43);
    let _closed_reader: i32 = BuildSource::close(@builder.source, reader);
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "generated.omg");
    let generated: BuildPath = BuildOutput::resolve(@builder.output, "generated.omg");
    let writer: i32 = BuildOutput::create(@mutable builder.output, generated, 0);
    _ = BuildOutput::write(@mutable builder.output, writer, @bytes[..]);
    let first: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, generated);
    settle_first(builder, first, writer, generated);
}

machine settle_first(builder: @mutable Build, completion: OutputCompletion, writer: i32, generated: BuildPath) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> reseal(builder, obligation, file, writer)
    }
    machine sealed(builder: @mutable Build) {
    }
    machine reseal(builder: @mutable Build, obligation: RequiredOutput, file: BuildPath, writer: i32) {
        let _sealed: i32 = BuildOutput::close(@mutable builder.output, writer);
        BuildOutput::include_source(@mutable builder.output, file);
        let second: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, file);
        settle_second(builder, second);
    }
}

machine settle_second(builder: @mutable Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable Build) {
    }
    machine failed(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "resealed output did not settle");
    }
}
