// Required-output retry recovery: the first `complete` runs while the
// writer is still live, so the evaluator hands the obligation and file
// custody back as `OutputCompletion::Retry`. The retry path then seals the
// writer, includes the staged source, and completes for real — the
// success direction of the custody loop, not the pinned failure.

machine build(builder: &mut Build) {
    Build::package(builder, "stratum_kernel");
    let template: BuildPath = BuildSource::resolve(&builder.source, "template.txt");
    let reader: i32 = BuildSource::open(&builder.source, template, 0);
    let mut bytes: [u8; 43];
    _ = BuildSource::read(&builder.source, reader, &mut bytes, 43);
    let _closed_reader: i32 = BuildSource::close(&builder.source, reader);
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "generated.omg");
    let generated: BuildPath = BuildOutput::resolve(&builder.output, "generated.omg");
    let writer: i32 = BuildOutput::create(&mut builder.output, generated, 0);
    _ = BuildOutput::write(&mut builder.output, writer, &bytes);
    let first: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, generated);
    settle_first(builder, first, writer, generated);
}

machine settle_first(builder: &mut Build, completion: OutputCompletion, writer: i32, generated: BuildPath) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> reseal(builder, obligation, file, writer)
    }
    machine sealed(builder: &mut Build) {
    }
    machine reseal(builder: &mut Build, obligation: RequiredOutput, file: BuildPath, writer: i32) {
        let _sealed: i32 = BuildOutput::close(&mut builder.output, writer);
        BuildOutput::include_source(&mut builder.output, file);
        let second: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, file);
        settle_second(builder, second);
    }
}

machine settle_second(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "resealed output did not settle");
    }
}
