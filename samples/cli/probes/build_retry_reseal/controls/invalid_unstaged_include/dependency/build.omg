// include_source on an Output-rooted path that was resolved but never
// created or written: the path is inside custody but stages nothing.

machine build(builder: @mutable Build) {
    Build::package(builder, "custody_ghost");
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "generated.omg");
    let ghost: BuildPath = BuildOutput::resolve(@builder.output, "generated.omg");
    BuildOutput::include_source(@mutable builder.output, ghost);
    let settled: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, ghost);
    settle(builder, settled);
}

machine settle(builder: @mutable Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable Build) {
    }
    machine failed(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "unstaged include rejected");
    }
}
