// include_source on an Output-rooted path that was resolved but never
// created or written: the path is inside custody but stages nothing.

machine build(builder: &mut Build) {
    Build::package(builder, "custody_ghost");
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "generated.omg");
    let ghost: BuildPath = BuildOutput::resolve(&builder.output, "generated.omg");
    BuildOutput::include_source(&mut builder.output, ghost);
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, ghost);
    settle(builder, settled);
}

machine settle(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "unstaged include rejected");
    }
}
