// include_source outside staged custody: the path handed to
// `include_source` is rooted in this activation's Source root, not its
// Output root — the evaluator must reject it as a custody violation.

machine build(builder: &mut Build) {
    Build::package(builder, "custody_break");
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "generated.omg");
    let foreign: BuildPath = BuildSource::resolve(&builder.source, "template.txt");
    BuildOutput::include_source(&mut builder.output, foreign);
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, foreign);
    settle(builder, settled);
}

machine settle(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "foreign include rejected");
    }
}
