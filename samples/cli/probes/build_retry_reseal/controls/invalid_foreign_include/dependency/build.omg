// include_source outside staged custody: the path handed to
// `include_source` is rooted in this activation's Source root, not its
// Output root — the evaluator must reject it as a custody violation.

machine build(builder: @mutable Build) {
    Build::package(builder, "custody_break");
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "generated.omg");
    let foreign: BuildPath = BuildSource::resolve(@builder.source, "template.txt");
    BuildOutput::include_source(@mutable builder.output, foreign);
    let settled: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, foreign);
    settle(builder, settled);
}

machine settle(builder: @mutable Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable Build) {
    }
    machine failed(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "foreign include rejected");
    }
}
