// Explicit Result-style error handling: a two-case enum produced
// conditionally, then matched, with a state loop accumulating
// successes and counting errors. Safe-dividing 10/2, 7/0, 20/4
// yields Ok(5), Err, Ok(5) — the Ok values sum to 10, one Err is
// counted. The quotient computes only in the divisor-nonzero arm:
// the error is data, not a trap.
//
//   * `DivResult { Ok(value), Err(code) }` — sum-type idiom.
//   * `state loop/load/compute` chain: `main.i` counter walks
//     `main.aa`/`main.bb` element-wise.
//   * `main.b != 0` arm discharges the `a / b` divisor obligation.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data DivResult {
    case Ok(value: i32 in Wrapping);
    case Err(code: i32 in Wrapping);
}

data Main {
    aa: [i32; 3];
    bb: [i32; 3];
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    result: DivResult;
    i: i32 in Wrapping;
    acc: i32 in Wrapping;
    errs: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.aa = [10, 7, 20];
    main.bb = [2, 0, 4];
    transition { _ -> loop(main) }

    state loop(main: &mut Main) {
        transition main.i >= 0 && main.i < 3 {
            true -> compute(main)
            _ -> verify(main)
        }
    }
    state compute(main: &mut Main) {
        main.a = main.aa[main.i] as i32 in Wrapping;
        main.b = main.bb[main.i] as i32 in Wrapping;
        transition main.b != 0 {
            true -> ok(main)
            _ -> err(main)
        }
    }
    state ok(main: &mut Main) {
        main.result = DivResult::Ok { value: main.a / main.b };
        transition { _ -> handle(main) }
    }
    state err(main: &mut Main) {
        main.result = DivResult::Err { code: 1 };
        transition { _ -> handle(main) }
    }
    state handle(main: &mut Main) {
        transition main.result {
            DivResult::Ok { value } -> h_ok(main, value)
            DivResult::Err { code } -> h_err(main)
        }
    }
    state h_ok(main: &mut Main, v: i32 in Wrapping) {
        main.acc = main.acc + v;
        main.i = main.i + 1;
        transition { _ -> loop(main) }
    }
    state h_err(main: &mut Main) {
        main.errs = main.errs + 1;
        main.i = main.i + 1;
        transition { _ -> loop(main) }
    }
    state verify(main: &mut Main) {
        transition main.acc == 10 && main.errs == 1 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
