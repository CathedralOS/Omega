use first;
use second;
machine make() -> first::Choice<u64> { first::Choice::Full { value: 7 } }
machine make_boolean() -> first::Choice<bool> { first::Choice::Full { value: true } }
machine other() -> second::Choice<u64> { second::Choice::Full { value: 9 } }
machine packet() -> first::Packet<u64> { first::Packet::Full { value: 11, stamp: 2 } }
data Main { kept: first::Choice<u64>; }
machine Main::main(main: &mut Main) {
    main.kept = make();
    let p: first::Packet<u64> = packet();
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
