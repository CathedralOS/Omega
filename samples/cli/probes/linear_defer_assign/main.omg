// Deferred establishment of a [linear]: `let mut receipt: Receipt;`
// owns only zeroed storage — the explicit assignment ESTABLISHES
// the value and its obligation. Receipt declares no `drop` plan,
// so the consuming contract `ReceiptAck::ack` is the only authorized
// terminal disposition: the call edge transfers custody.
//
//   * `boundary trait` requirement `m(t: T)` — bodyless consuming
//     contract.
//   * `machine Main::main() -> i32` — non-carrier entry spelling
//     on Main data.
//
// Compile-checked only: declaration surface (requirement has no
// provider here), no standard-library dependency.

data Receipt [linear] { code: i32; }

boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}

data Main { hits: i32 in Wrapping; }

machine work() -> i32 {
    let mut receipt: Receipt;
    receipt = Receipt { code: 7 };
    ReceiptAck::ack(receipt);
    0
}

machine Main::main(main: &mut Main) {
    main.hits = work() as i32 in Wrapping;
}
