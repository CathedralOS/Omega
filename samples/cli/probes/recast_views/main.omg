// Recasts: `as` applied to borrows re-carriers the viewed bytes without
// moving the value, for shared AND mutable views.
//
//   * `&main.value as &u32` — scalar bit reinterpret (-2 as i32 reads
//     4294967294 as u32); `&main.small as &u8` reads -56 as 200.
//   * `&main.bytes[3] as &i16` — a byte pair re-viewed as little-endian
//     i16 (254, 255 -> -2).
//   * `&mut main.tail[3] as &mut [u8]` — a mutable ELEMENT viewed as the
//     slice tail from that index (len 5 of [u8;8]); writes through the
//     view land in the backing array (tail[4] = 9 -> tail[7]).
//   * Borrows forward through states with their established facts:
//     `tail.len > 4` in the caller proves `tail[4]` in the callee.
//   * `hits` counts reached arms.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Main {
    value: i32;
    small: i8;
    bytes: [u8; 6];
    tail: [u8; 8];
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.value = -2;
    main.small = -56;
    main.bytes[3] = 254;
    main.bytes[4] = 255;
    let bits: &u32 = &main.value as &u32;
    transition bits == 4294967294 && (&main.small as &u8) == 200
        && (&main.bytes[3] as &i16) == -2 {
        true -> tail_view(main)
        _ -> fail(main)
    }
    machine tail_view(main: &mut Main) {
        let tail: &mut [u8] = &mut main.tail[3] as &mut [u8];
        transition tail.len > 4 {
            true -> write(main, tail)
            _ -> fail(main)
        }
    }
    machine write(main: &mut Main, tail: &mut [u8]) {
        tail[4] = 9;
        transition tail.len == 5 {
            true -> check(main)
            _ -> fail(main)
        }
    }
    machine check(main: &mut Main) {
        transition main.tail[7] == 9 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
