// Established-by domains and explicit erasure: `domain
// Token::Issued established by TokenIssuer::issue` grants the
// membership only through the trait's `ensures result in Issued`
// route — literal construction can't mint it. Reading a qualified
// value into a plain `let` drops the predicate (explicit erasure).
//
//   * `domain i32::Degrees` + `machine + i32::Degrees::add`
//     declaration (operator-roster member — decl surface only;
//     calling it drops the domain implicitly, which is rejected).
//   * `Token::issue satisfies TokenIssuer::issue ensures result in
//     Token::Issued` — satisfaction as the grant route.
//   * `let plain: i32 = qualified` / `(x as i32 in Degrees) as
//     i32` — let-annotation and `as`-target erasure (call args
//     never weaken a domain implicitly — must `as` explicitly).
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain i32::Degrees;

machine + i32::Degrees::add(left: i32, right: i32) -> i32 {
    ((left as i32 in Wrapping) + (right as i32 in Wrapping)) as i32
}

data Token {
    value: u64;
}

domain Token::Issued
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue(value: u64) -> Token
    ensures
        result in Token::Issued;
}

machine Token::issue(value: u64) -> Token
satisfies TokenIssuer::issue
ensures
    result in Token::Issued
{
    Token { value: value }
}

machine consume(issued: Token in Token::Issued) -> u64 {
    issued.value
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let token: Token = Token::issue(41);
    let degrees: i32 = (9 as i32 in Degrees) as i32;
    transition consume(token) == 41 && degrees == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
