// The issuer supplies the Issued membership that consume requires.
// Degrees is established and removed explicitly on a separate scalar.

domain i32::Degrees;

machine + Degrees::add(left: i32 in Degrees, right: i32 in Degrees) -> i32 in Degrees {
    let total: i32 in Wrapping = (left as -Degrees +Wrapping) + (right as -Degrees +Wrapping);
    total as -Wrapping +Degrees
}

data Token {
    value: u64;
}

domain Token::Issued
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue(value: u64) -> Token in Issued
    ensures
        result in Token::Issued;
}

machine issue(value: u64) -> Token in Issued
satisfies TokenIssuer::issue
ensures
    result in Token::Issued
{
    Token { value: value } as +Issued
}

machine consume(issued: Token in Token::Issued) -> u64 {
    issued.value
}

machine entry_start() crashes Trap {
    let token: Token in Issued = issue(41);
    let degrees: i32 = (9 as i32 +Degrees) as -Degrees;
    transition consume(token) == 41 && degrees == 9 {
        true -> pass(),
        _ -> fail()
    }
    machine pass() {}
    machine fail() crashes Trap { crash Trap; }
}
