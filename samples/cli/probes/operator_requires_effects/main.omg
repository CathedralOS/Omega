// A boundary operator with an operand `requires` clause:
// `boundary machine == Integer::equal(left, right)`
// declares `right >= 0`, and the caller's effect-bearing
// operand discharges it — `prepare(&mut value)` carries
// `ensures value >= 0`, so `prepare(&mut value) == value`
// proves the right operand after the effect lands.
//
//   * Boundary operator decl + `requires right >= 0`.
//   * `prepare` mutates through `&mut` while returning —
//     operand evaluation order: effect first, then `value`
//     read.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

boundary machine == Integer::equal(left: i32, right: i32) -> bool
requires right >= 0;

machine prepare(value: &mut i32) -> i32
ensures value >= 0 {
    value = 1;
    0
}

machine compare(mut value: i32) -> bool {
    prepare(&mut value) == value
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let flag: bool = compare(5);
    transition flag {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
