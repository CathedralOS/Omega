// A trait of free-machine requirements over an explicit
// carrier: `machine add(a: T, b: T) -> T` has no
// subject parameter, and a law requirement `machine
// add_comm(a: T, b: T) ensures add(a, b) == add(b, a)`
// carries its own contract. Satisfiers bind per
// requirement — `satisfies RingOps<i32 in Wrapping>::add`
// — and `as Standard` names the satisfier for plural
// algebras on one carrier.
//
//   * `terminates by a` — structural recursion measure
//     on the Peano satisfier.
//   * `i32 in Wrapping` as trait carrier — Self binds a
//     domain-qualified primitive, not just a data type.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

trait RingOps<T> {
    machine add(a: T, b: T) -> T;
    machine mul(a: T, b: T) -> T;
}

machine add(a: Peano, b: Peano) -> Peano
satisfies RingOps<Peano>::add
terminates by a;
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { pred } -> Peano::Succ { pred: add(pred, b) }
    }
}

machine mul(a: Peano, b: Peano) -> Peano
satisfies RingOps<Peano>::mul as Standard
terminates by a;
{
    transition a {
        Peano::Zero -> Peano::Zero
        Peano::Succ { pred } -> (add(b, mul(pred, b)))
    }
}

machine add32(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping
satisfies RingOps<i32 in Wrapping>::add
{
    a + b
}

machine mul32(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping
satisfies RingOps<i32 in Wrapping>::mul as Standard32
{
    a * b
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let s: i32 in Wrapping = add32(2, 1);
    let p: i32 in Wrapping = mul32(s, 2);
    transition p == 6 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
