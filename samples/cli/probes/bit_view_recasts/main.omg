// Equal-width integer re-views read the viewed place's
// two's-complement bits on the view carrier: a negative
// `i32` through `&u32` is its modular image, an inline
// `&u8` view of an `i8` guard operand likewise, and a
// `u8` byte region at a runtime offset re-viewed as
// `&i16` assembles little-endian before the signed image.
//
//   * `&main.value as &u32`, `&main.small as &u8`,
//     `&main.bytes[offset] as &i16`.
//   * Nested operand recasts inside a binary expression —
//     `((bits.x & 0xffff) as u32) & (&bits.x as &u32)` and
//     the `&mut` spelling in expression position (no
//     reference-typed let binding needed).
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Bits { x: i32; y: u32; }

machine Bits::go(bits: &mut Bits) {
    bits.y = ((bits.x & 0xffff) as u32) & (&bits.x as &u32);
    bits.y = bits.y & (&mut bits.x as &mut u32);
}

data Main {
    value: i32;
    small: i8;
    bytes: [u8; 6];
    k: u32;
    bits: Bits;
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    main.value = -2;
    main.small = -56;
    main.bytes[3] = 254;
    main.bytes[4] = 255;
    main.k = 3;
    main.bits = Bits { x: -1, y: 0 };
    Bits::go(&mut main.bits);
    let bits: &u32 = &main.value as &u32;
    transition bits == 4294967294 && (&main.small as &u8) == 200 && main.k <= 4 && main.bits.y == 65535 {
        true -> region(main, main.k)
        _ -> fail(main)
    }
    state region(main: &mut Main, offset: u32) {
        let pair: &i16 = &main.bytes[offset] as &i16;
        transition pair == -2 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
