// An indexed member write reads back through a slice view:
// `main.rooms[index].exit_count = 7` then `&main.rooms[..]` —
// `room_slice[index].exit_count` — plus `&Main` immutable receiver states.
data Room { exit_count: i32; }
data Main { rooms: [Room; 2]; }
machine Main::main(main: &mut Main) {
    let index: u64 = 1;
    main.rooms[index].exit_count = 7;
    let room_slice: &[Room] = &main.rooms[..];
    transition room_slice[index].exit_count == 7 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &Main) { }
    state bad(main: &Main) { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
