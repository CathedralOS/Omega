// Claim-bearing call results assigned to an existing place (not
// bound by `let`): `pair.left = make(5)` continues `make`'s
// claim at `left`; the place was vacated first so no live
// obligation is overwritten.
//
//   * `move` a member out before overwriting its place.
//   * `held = make(9)` continues the claim at the whole local.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let mut pair: Pair = Pair { left: make(1), right: make(2) };
    let old: Receipt = pair.left;
    pair.left = make(5);
    let mut held: Receipt = make(3);
    let spare: Receipt = held;
    held = make(9);
    let a: i32 = consume(old);
    let b: i32 = consume(pair.left);
    let c: i32 = consume(pair.right);
    let d: i32 = consume(spare);
    let e: i32 = consume(held);
    transition a == 1 && b == 5 && c == 2 && d == 3 && e == 9 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
