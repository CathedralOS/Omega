use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "service_slice_entry" };
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, macos_x86_64);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, uefi_x86_64);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, cross_platform_cli);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, local_unchecked);
    Build::select_provider::<|app|::Ping, |app|::PingProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
}
