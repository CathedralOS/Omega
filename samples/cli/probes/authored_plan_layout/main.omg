use omega::language::core::layout;
// The selected policy stores a signed semantic value in one byte. Plain byte
// storage remains independently checked beside that explicit representation.
SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan
    reaches none terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry {
            key: schema.fields[0].key,
            representation: FieldPlan::IntegerAt {
                offset: 0,
                stored_width: 8,
                interpretation: IntegerInterpretation::Signed,
            },
        };
        LayoutPlan {
            entries: entries,
            entry_count: 1,
            size_fixed: 1,
            size_is_dynamic: false,
            align: 1,
        }
    }
}
data PortableByte [copy] { value: i64; }
data RawView { value: LayoutStorage<PortableByte, SignedByte>; }
data Instant { seconds: i64; nanoseconds: i64; }
machine fill(instant: &mut Instant, seconds: i64) -> i64 {
    instant.seconds = seconds;
    0
}
data Main { bytes: [u8; 2]; }
machine Main::main(main: &mut Main) {
    main.bytes[0] = 100;
    main.bytes[1] = 85;
    let mut instant: Instant = Instant { seconds: 0, nanoseconds: 0 };
    let status: i64 = fill(&mut instant, 7);
    transition status == 0 && instant.seconds == 7 && main.bytes[0] == 100 {
        (true) -> done(main)
        _ -> bad(main)
    }
    machine done(main: &mut Main) { let value: i32 = 70; }
    machine bad(main: &mut Main) { let value: i32 = 71; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
