use omega::language::core::nat;
// Citing a REQUIRES-bearing lemma works when the citer's own hypotheses
// establish the instantiated requires verbatim.
machine minus(a: Nat, b: Nat) -> Nat {
    transition { _ -> (a) }
}
machine cancel(a: Nat, b: Nat) -> Nat
requires
    core::Identity<Nat>(a, b)
ensures
    core::Identity<Nat>(minus(a, b), minus(a, b))
{
    transition { _ -> (minus(a, b)) }
}
machine cite_with_requires(x: Nat, y: Nat) -> Nat
requires
    core::Identity<Nat>(x, y)
ensures
    core::Identity<Nat>(minus(x, x), minus(x, y))
{
    _ = cancel(x, y);
    transition { _ -> (minus(x, x)) }
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
