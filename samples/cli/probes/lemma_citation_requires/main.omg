use {omega}/language/core/foundation.omg as proof;
use {omega}/language/core/nat.omg;
// Citing a REQUIRES-bearing lemma works when the citer's own hypotheses
// establish the instantiated requires verbatim.
machine minus(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
    transition { _ -> (a) }
}
machine cancel(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
requires
    |proof|::Identity::<|nat|::Nat>(a, b)
ensures
    |proof|::Identity::<|nat|::Nat>(minus(a, b), minus(a, b))
{
    transition { _ -> (minus(a, b)) }
}
machine cite_with_requires(x: |nat|::Nat, y: |nat|::Nat) -> |nat|::Nat
requires
    |proof|::Identity::<|nat|::Nat>(x, y)
ensures
    |proof|::Identity::<|nat|::Nat>(minus(x, x), minus(x, y))
{
    _ = cancel(x, y);
    transition { _ -> (minus(x, x)) }
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: @mutable Main) {
    main.hits = main.hits + 1;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mutable entry_storage: Main;
    Main::main(@mutable entry_storage);
}
