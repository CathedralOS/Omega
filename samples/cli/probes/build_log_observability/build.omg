// Build-log observability through the CLI: `BuildLog::write_line` needs
// `&mut builder.log` and each activation's lines surface in `--check`
// output in evaluation order — the requesting activation first, then the
// dep's own activation.

machine build(builder: &mut Build) {
    Build::application(builder, "build_log_observability");
    let mut kit_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "dependency" });
    dependency::with_alias(&mut kit_dependency, "kit");
    let kit_registration: DependencyRegistration = Build::dependency(builder, kit_dependency);
    builder.freestanding = true;
    BuildLog::write_line(&mut builder.log, "requester: activation observed");
}
