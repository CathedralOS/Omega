// Build-log observability through the CLI: `BuildLog::write_line` needs
// `@mutable builder.log` and each activation's lines surface in `--check`
// output in evaluation order — the requesting activation first, then the
// dep's own activation.

use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "build_log_observability");
    let mutable kit_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "dependency" });
    |dependency|::with_alias(@mutable kit_dependency, "kit");
    let kit_registration: DependencyRegistration = Build::dependency(builder, kit_dependency);
    BuildLog::write_line(@mutable builder.log, "requester: activation observed");
}
