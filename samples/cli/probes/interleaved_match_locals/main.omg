// Interleaved match locals: a match moves two of three interleaved
// locals (`left`/`right`) while `marker` — declared BETWEEN them —
// survives untouched. Ownership is per-root, not per-scope.
//
//   * `marker.tag == tag && observed` reads a survivor after the
//     match moved its neighbors.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Choice {
    case Empty;
    case Some(value: u32);
}

data Marker { tag: u64; }

machine choose(selected: bool, tag: u64) -> bool {
    let left: Choice = Choice::Some { value: 37 };
    let marker: Marker = Marker { tag: tag };
    let right: Choice = Choice::Empty;
    let result: Choice = match selected {
        true -> left,
        false -> right
    };
    let observed: bool = result in Choice::Some;
    marker.tag == tag && observed
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition choose(true, 5) {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
