// Path-indexed linear claims: `consume(first.left)` projects one
// linear member out of a record — the claim beneath that path
// transfers while the sibling `first.right` keeps its own
// obligation until separately moved.
//
//   * `Pair { left: Receipt, right: Receipt }` two independent
//     claims per result.
//   * `drop(receipt)` discharge inside a by-value consumer.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

machine issue(first: i32, second: i32) -> Pair {
    let left: Receipt = Receipt { code: first };
    let right: Receipt = Receipt { code: second };
    Pair { left: left, right: right }
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let first: Pair = issue(1, 2);
    let second: Pair = issue(3, 4);
    let a: i32 = consume(first.left);
    let b: i32 = consume(first.right);
    let c: i32 = consume(second.left);
    let d: i32 = consume(second.right);
    transition a == 1 && b == 2 && c == 3 && d == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
