// Borrowed case dispatch: `transition duo` on `&Duo` and `&mut Duo`
// receivers — the subject is borrowed, the arms still read payload
// fields and fold them into the result.
//
//   * `Duo::code(&Duo)` / `Duo::code_mutable(&mut Duo)` borrowed
//     dispatch, payload reads `a` / `b + c`.
//   * `hits` records the reached arm.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

data Duo {
    case Left(a: u64 in Wrapping);
    case Right(b: u64 in Wrapping, c: u64 in Wrapping);
}

machine Duo::code(duo: &Duo) -> u64 in Wrapping {
    transition duo {
        Duo::Left { a } -> value(a)
        Duo::Right { b, c } -> value(b + c)
    }

    state value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

machine Duo::code_mutable(duo: &mut Duo) -> u64 in Wrapping {
    transition duo {
        Duo::Left { a } -> value(a)
        Duo::Right { b, c } -> value(b + c)
    }

    state value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let left: Duo = Duo::Left { a: 30 };
    let mut right: Duo = Duo::Right { b: 10, c: 4 };
    let a: u64 in Wrapping = Duo::code(&left);
    let bc: u64 in Wrapping = Duo::code_mutable(&mut right);
    transition (a + bc) as u64 == 44 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
