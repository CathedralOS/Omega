// The compiler-recognized `valid_utf8` predicate: string literals grant
// `&[u8] in Utf8` directly (contrast: user-defined requires over slices
// have no grant path — filed gap), and `==` between a Utf8 view and a
// literal is CONTENT equality, not descriptor-word compare.
//
//   * `domain [u8]::Utf8(bytes) requires valid_utf8(bytes)` — built-in
//     predicate, so `classify("quit")` admits without an `as` cast.
//   * `transition text == "quit"` — same TextEquals leaf String uses.
//   * `hits` counts arms; 2 proves the literal matched on content.
//
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);

machine Main::classify(text: &[u8] in Utf8) -> u64 in Wrapping {
    transition text == "quit" {
        true -> Main::matched(text)
        _ -> Main::other(text)
    }
    machine matched(text: &[u8] in Utf8) -> u64 in Wrapping {
        70
    }
    machine other(text: &[u8] in Utf8) -> u64 in Wrapping {
        71
    }
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition Main::classify("quit") == 70 {
        true -> Main::pass(main)
        _ -> Main::fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
