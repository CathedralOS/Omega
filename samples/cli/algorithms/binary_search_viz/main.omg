// A visual binary search: each step prints one row of a 31-cell strip, so the search's
// history builds downward as a scrolling trace. A row shows the active `[lo, hi]` range
// as '-', the goal cell as '*', and the current midpoint probe as '#'. Watching the rows,
// the '-' band halves each step and '#' marches toward '*' -- the logarithmic narrowing
// made visible. The array holds arr[i] = i (so the value `target` lives at index `target`);
// the search itself reads arr[mid] for real. Pure compute + stdout + Clock.sleep.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 31]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }

// Declared-host Clock wiring, the pattern `samples/gui/window_app` carries: a
// provider data, a target-scoped `provider_defaults` that selects it, and a
// `satisfies Clock::sleep` machine over the `darwin_poll` leaf. The provider
// holds no state: each call keeps its timeout and poll status in locals, where
// the static-machine contract places invocation scratch.
data PacingClockProvider { }
macos_arm64 machine PacingClockProvider::provider_defaults(defaults: &mut PacingClockProvider) {
    defaults.select_provider<Clock, PacingClockProvider>();
}
macos_arm64 machine PacingClockProvider::sleep(milliseconds: u32) satisfies Clock::sleep
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    arr: [i32; 31];
    line: [u8; 31] in Utf8;   // render buffer
    chars: [u8; 4] in Utf8;   // " -*#"  excluded / range / target / mid
    target: i32;              // only compared, never fed to arithmetic
    lo: i32;                  // in [0, 31]; each write is clamp-proven Exact
    hi: i32;                  // in [-1, 30]; each write is clamp-proven Exact
    mid: i32;                 // in [0, 30]; guards re-prove it before each index use
    vmid: i32;                // probe value; only compared
    x: i32;                   // guard-proven Exact render counter
    kind: i32;                // 0..3 glyph selector; guard-proven before the lookup
    glyph: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console + DarwinClock {
    main.line = "                               ";
    main.chars = " -*#";
    main.x = 0;
    transition { _ -> init_loop(main) }

    // arr[i] = i, so the value `target` sits at index `target`
    state init_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 31 { true -> init_cell(main) _ -> setup(main) }
    }
    state init_cell(main: &mut Main) {
        main.arr[main.x] = main.x;
        main.x = main.x + 1;
        transition { _ -> init_loop(main) }
    }
    state setup(main: &mut Main) {
        main.lo = 0;
        main.hi = 30;
        main.target = 20;
        transition { _ -> search(main) }
    }

    state search(main: &mut Main) {
        transition main.lo <= main.hi { true -> mid_calc(main) _ -> not_found(main) }
    }
    state mid_calc(main: &mut Main) {
        // The min/max clamps are the identity for the search's real values
        // (lo in [0,31], hi in [-1,30] whenever this state runs) while giving
        // the fold provable bounds, so the midpoint math is Exact -- no domain.
        main.mid = (min(max(main.lo, 0), 31) + min(max(main.hi, 0 - 1), 30)) / 2;
        transition main.mid >= 0 && main.mid < 31 { true -> render_init(main) _ -> bad(main) }
    }

    // --- render one row: priority mid '#' > target '*' > range '-' > excluded ' ' ---
    state render_init(main: &mut Main) {
        main.x = 0;
        transition { _ -> render_loop(main) }
    }
    state render_loop(main: &mut Main) {
        transition main.x >= 0 && main.x < 31 { true -> cell(main) _ -> emit(main) }
    }
    state cell(main: &mut Main) {
        transition main.x == main.mid { true -> kind_mid(main) _ -> chk_target(main) }
    }
    state chk_target(main: &mut Main) {
        transition main.x == main.target { true -> kind_target(main) _ -> chk_range(main) }
    }
    state chk_range(main: &mut Main) {
        transition main.lo <= main.x && main.x <= main.hi { true -> kind_range(main) _ -> kind_none(main) }
    }
    state kind_mid(main: &mut Main) { main.kind = 3; transition { _ -> put_cell(main) } }
    state kind_target(main: &mut Main) { main.kind = 2; transition { _ -> put_cell(main) } }
    state kind_range(main: &mut Main) { main.kind = 1; transition { _ -> put_cell(main) } }
    state kind_none(main: &mut Main) { main.kind = 0; transition { _ -> put_cell(main) } }
    state put_cell(main: &mut Main) {
        transition main.kind >= 0 && main.kind < 4 { true -> glyph_lookup(main) _ -> bad(main) }
    }
    state glyph_lookup(main: &mut Main) {
        main.glyph = main.chars[main.kind];
        transition main.x >= 0 && main.x < 31 { true -> emit_cell(main) _ -> bad(main) }
    }
    state emit_cell(main: &mut Main) {
        main.line[main.x] = main.glyph;
        main.x = main.x + 1;
        transition { _ -> render_loop(main) }
    }
    state emit(main: &mut Main) {
        main.console.write_line(main.line);
        main.clock.sleep(250);
        transition { _ -> probe(main) }
    }

    // --- the actual binary search step (reads arr[mid]) ---
    state probe(main: &mut Main) {
        transition main.mid >= 0 && main.mid < 31 { true -> probe_read(main) _ -> bad(main) }
    }
    state probe_read(main: &mut Main) {
        main.vmid = main.arr[main.mid];
        transition main.vmid == main.target { true -> finish(main) _ -> narrow(main) }
    }
    state narrow(main: &mut Main) {
        transition main.vmid < main.target { true -> go_right(main) _ -> go_left(main) }
    }
    // The clamp on `mid` is the identity (mid is always in [0,30] here) and
    // bounds the +1 / -1 folds, keeping the narrowing steps Exact.
    state go_right(main: &mut Main) {
        main.lo = min(max(main.mid, 0), 30) + 1;
        transition { _ -> search(main) }
    }
    state go_left(main: &mut Main) {
        main.hi = min(max(main.mid, 0), 30) - 1;
        transition { _ -> search(main) }
    }

    state finish(main: &mut Main) {
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
    state not_found(main: &mut Main) {
        main.console.exit_process(1);
    }
    state bad(main: &mut Main) {
        main.console.exit_process(1);
    }
}
