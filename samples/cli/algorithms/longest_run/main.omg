// Longest run of equal bytes, the measure behind run-length encoding.
// The input belongs to the invocation. States carry the cursor, previous byte,
// current run length and maximum; the current byte is an iteration-local value.
// For "aaabbbbccdaa", the longest run is 4 (the "bbbb").
// Expected exit: 4.

domain [u8]::Utf8(text)
requires
    valid_utf8(text);
domain [u8; 12]::Utf8(text)
requires
    valid_utf8(text);
use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("longest_run: finding the longest run of equal bytes in aaabbbbccdaa");
    let text: [u8; 12] in Utf8 = "aaabbbbccdaa";
    let maximum: i32 in Wrapping = longest_run(&text);
    Console::write_line("result: the longest run length, 4 (the bbbb) for this text (the exit code)");
    Console::write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block Console::read_line(&mut pause);
    Console::exit_process(maximum as i32);
}

machine longest_run(text: &[u8; 12] in Utf8) -> i32 in Wrapping {
    transition { _ -> step(text, 0, 0, 0, 0) }

    state step(text: &[u8; 12] in Utf8, index: i32, previous: u8,
               current: i32 in Wrapping, maximum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0 {
        transition index < text.len {
            true -> read(text, index, previous, current, maximum)
            _ -> maximum
        }
    }

    state read(text: &[u8; 12] in Utf8, index: i32, previous: u8,
               current: i32 in Wrapping, maximum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0 {
        let byte: u8 = text[index];
        transition byte == previous {
            true -> update(text, index, byte, current + 1, maximum)
            _ -> update(text, index, byte, 1, maximum)
        }
    }

    state update(text: &[u8; 12] in Utf8, index: i32, previous: u8,
                 current: i32 in Wrapping, maximum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0 {
        transition current > maximum {
            true -> advance(text, index, previous, current, current)
            _ -> advance(text, index, previous, current, maximum)
        }
    }

    // Retain the capacity guard immediately before the Exact cursor increment.
    state advance(text: &[u8; 12] in Utf8, index: i32, previous: u8,
                  current: i32 in Wrapping, maximum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0 {
        transition index < 16 {
            true -> bump(text, index, previous, current, maximum)
            _ -> maximum
        }
    }

    state bump(text: &[u8; 12] in Utf8, index: i32, previous: u8,
               current: i32 in Wrapping, maximum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0
    requires index < 16 {
        transition { _ -> step(text, index + 1, previous, current, maximum) }
    }
}
