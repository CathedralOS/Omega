// Longest run of equal bytes in a string -- the core measure behind run-length encoding (RLE).
// Scan the bytes left to right tracking the CURRENT run length and the MAXIMUM seen: each byte
// either extends the current run (== previous) or starts a new one. For "aaabbbbccdaa" the longest
// run is 4 (the "bbbb"). Showcases carrier `.len`-bounded iteration, per-byte reads into a u8
// field, and run tracking over a state loop -- all on the working surface (no value-calls).
// Expected exit: 4.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 16]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Main {
    console: Console;
    pause: [u8; 256];
    text: [u8; 16] in Utf8;
    i: i32 [0..=16];
    cur: i32 in Wrapping;
    max: i32 in Wrapping;
    prev: u8 in Wrapping;
    b: u8 in Wrapping;
}

machine Main::main(&mut self) {
    self.console.write_line("longest_run: finding the longest run of equal bytes in aaabbbbccdaa");
    self.text = "aaabbbbccdaa";
    self.i = 0;
    self.cur = 0;
    self.max = 0;
    self.prev = 0;
    transition { _ -> step() }

    // Walk the bytes, bounded by the carrier's runtime length.
    state step(&mut self) {
        transition self.i < self.text.len {
            true -> read()
            _ -> done()
        }
    }
    state read(&mut self) {
        self.b = self.text[self.i];
        transition self.b == self.prev {
            true -> extend()
            false -> reset()
        }
    }
    state extend(&mut self) {
        self.cur = self.cur + 1;
        transition { _ -> update() }
    }
    state reset(&mut self) {
        self.cur = 1;
        self.prev = self.b;
        transition { _ -> update() }
    }
    state update(&mut self) {
        transition self.cur > self.max {
            true -> set_max()
            false -> advance()
        }
    }
    state set_max(&mut self) {
        self.max = self.cur;
        transition { _ -> advance() }
    }
    // Re-guard against the carrier CAPACITY (16) so the increment's direct edge
    // proves `i + 1` back into [0..=16] -- len <= 16, so this is always true.
    state advance(&mut self) {
        transition self.i >= 0 && self.i < 16 {
            true -> bump()
            _ -> done()
        }
    }
    state bump(&mut self) {
        self.i = self.i + 1;
        transition { _ -> step() }
    }
    state done(&mut self) {
        self.console.write_line("result: the longest run length, 4 (the bbbb) for this text (the exit code)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(self.max as i32);
    }
}
