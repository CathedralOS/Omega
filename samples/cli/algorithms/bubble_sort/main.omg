// Bubble sort -- the first IN-PLACE mutation algorithm Omega can express, and a
// milestone: it needs every piece of runtime array indexing working together.
//
//   for i in 0..N:
//     for j in 0..N-1:
//       if nums[j] > nums[j+1]: swap(nums[j], nums[j+1])
//
// Three capabilities compose here:
//   * the DERIVED index `nums[j+1]` (the `j < N-1` bound carried across `jp=j+1`),
//   * the loop bound carried TRANSITIVELY into the `swap` state -- reached only
//     via `compare`'s `a > b` arm, yet still proving `j < N-1` (because no state
//     between rewrites `j`), so the swap's indexed accesses are in bounds,
//   * the runtime-indexed WRITE `nums[j] = value` with a runtime value source.
//
// Sorting [29, 10, 14, 37, 13] ascending puts the minimum, 10, at index 0.
// Expected exit: 10.

use omega_language_std::console;

data Main {
    nums: [i32; 5];
    i: u64;          // guard-proven Exact counters: the loop-head bound
    j: u64;          // dominates each re-guarded increment
    jp: u64;         // j + 1 folds bounded from the `j < 4` guard -- plain Exact
    a: i32;
    b: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("bubble_sort: in-place sort of [29, 10, 14, 37, 13] with runtime-indexed swaps");
    main.nums[0] = 29;
    main.nums[1] = 10;
    main.nums[2] = 14;
    main.nums[3] = 37;
    main.nums[4] = 13;
    main.i = 0;

    transition {
        _ -> outer(main)
    }

    // Outer pass: N passes settle every element into place.
    machine outer(main: &mut Main) {
        transition main.i < 5 {
            true -> inner_init(main)
            _ -> done(main)
        }
    }

    machine inner_init(main: &mut Main) {
        main.j = 0;
        transition {
            _ -> inner(main)
        }
    }

    // Inner loop head: compare adjacent pairs up to N-1.
    machine inner(main: &mut Main) {
        transition main.j < 4 {
            true -> compare(main)
            _ -> outer_next(main)
        }
    }

    machine compare(main: &mut Main) {
        main.jp = main.j + 1;
        main.a = main.nums[main.j];
        main.b = main.nums[main.jp];
        transition main.a > main.b {
            true -> swap(main)
            _ -> advance(main)
        }
    }

    // Reached only via `a > b`; the inner bound `j < 4` carries here
    // transitively, so both indexed writes prove in bounds.
    machine swap(main: &mut Main) {
        main.jp = main.j + 1;
        main.nums[main.j] = main.b;
        main.nums[main.jp] = main.a;
        transition {
            _ -> advance(main)
        }
    }

    // Re-guard before each increment: the bound on the DIRECT edge proves the
    // `+ 1` cannot overflow -- fully Exact, no domain.
    machine advance(main: &mut Main) {
        transition main.j < 4 {
            true -> j_bump(main)
            _ -> inner(main)
        }
    }

    machine j_bump(main: &mut Main) {
        main.j = main.j + 1;
        transition {
            _ -> inner(main)
        }
    }

    machine outer_next(main: &mut Main) {
        transition main.i < 5 {
            true -> i_bump(main)
            _ -> outer(main)
        }
    }

    machine i_bump(main: &mut Main) {
        main.i = main.i + 1;
        transition {
            _ -> outer(main)
        }
    }

    machine done(main: &mut Main) {
        Console::write_line("result: nums[0] after sorting -- the minimum, 10 for this dataset (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(main.nums[0]);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
