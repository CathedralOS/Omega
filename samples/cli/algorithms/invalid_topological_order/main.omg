// Intended-invalid control for topological_order: marking a node outside the
// 0..=7 node domain as emitted must be rejected at compile time.

use omega_language_std::console;

data Topo {
    emitted: [u64 in Wrapping; 8];
}

machine Topo::mark_emitted(t: &mut Topo, node: u64)
requires node < 8 {
    t.emitted[node] = 1;
}

data Main {
    topo: Topo;
}

machine Main::main(main: &mut Main) reaches Console {
    Topo::mark_emitted(&mut main.topo, 8);
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
