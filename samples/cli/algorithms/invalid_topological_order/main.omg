use omega\language\core\ProcessExit;
// Intended-invalid control for topological_order: marking a node outside the
// 0..=7 node domain as emitted must be rejected at compile time.


data Topo {
    emitted: [u64 in Wrapping; 8];
}

machine mark_emitted(t: @mutable Topo, node: u64)
requires node < 8 {
    t.emitted[node] = 1u64 as +Wrapping;
}

data Main {
    topo: Topo;
}

machine main(main: @mutable Main) reaches ProcessExit {
    mark_emitted(@mutable main.topo, 8);
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
