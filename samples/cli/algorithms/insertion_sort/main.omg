// Bubble sort on a fixed [i32; 6] array via compare-and-swap dispatch chains.
//
// Exercises: fixed-array element SWAPS (reading one slot, writing two slots) +
// multi-pass adjacent comparison chains + per-pair sub-machines that use
// const-indexed dispatch states for the conditional write-back.
//
// This is a DETERMINISTIC sort: the input is fully hardcoded, every swap
// decision is a compile-time-known branch that exercises the runtime
// array-write path for each const index 0..5.
//
// Input array: [5, 2, 8, 1, 3, 7]
//
// Bubble sort passes (hand-verified):
//   Pass 1 (5 adjacent compares):
//     cmp(0,1): 5>2 -> swap -> [2,5,8,1,3,7]
//     cmp(1,2): 5<8 -> no swap
//     cmp(2,3): 8>1 -> swap -> [2,5,1,8,3,7]
//     cmp(3,4): 8>3 -> swap -> [2,5,1,3,8,7]
//     cmp(4,5): 8>7 -> swap -> [2,5,1,3,7,8]
//   Pass 2 (4 compares; pos 5 settled):
//     cmp(0,1): 2<5 -> no swap
//     cmp(1,2): 5>1 -> swap -> [2,1,5,3,7,8]
//     cmp(2,3): 5>3 -> swap -> [2,1,3,5,7,8]
//     cmp(3,4): 5<7 -> no swap
//   Pass 3 (3 compares; pos 4,5 settled):
//     cmp(0,1): 2>1 -> swap -> [1,2,3,5,7,8]
//     cmp(1,2): 2<3 -> no swap
//     cmp(2,3): 3<5 -> no swap
//   Pass 4 (2 compares; pos 3,4,5 settled):
//     cmp(0,1): 1<2 -> no swap
//     cmp(1,2): 2<3 -> no swap
//   Pass 5 (1 compare; pos 2,3,4,5 settled):
//     cmp(0,1): 1<2 -> no swap
//
// Final array: [1, 2, 3, 5, 7, 8]
//
// Verification: check each position matches expected value.
// Exit 70  = all correct (sorted)
// Exit 71  = arr[0] != 1
// Exit 72  = arr[1] != 2
// Exit 73  = arr[2] != 3
// Exit 74  = arr[3] != 5
// Exit 75  = arr[4] != 7
// Exit 76  = arr[5] != 8
//
// Expected exit: 70.

use omega_language_std::console;

data Sorter [copy] {
    arr: [i32; 6];
}

data Main {
    s: Sorter;
    pause: [u8; 256];
}

// ---- Per-pair compare-and-swap machines ----
// Each reads arr[i] and arr[i+1]; if arr[i] > arr[i+1], writes them swapped.

machine Main::cmp_swap_01(main: &mut Main) {
    let a: i32 = main.s.arr[0];
    let b: i32 = main.s.arr[1];
    transition a > b {
        true -> do_swap_01(main, a, b)
        _ -> done_01()
    }
    state do_swap_01(main: &mut Main, a: i32, b: i32) {
        main.s.arr[0] = b;
        main.s.arr[1] = a;
    }
    state done_01() {}
}

machine Main::cmp_swap_12(main: &mut Main) {
    let a: i32 = main.s.arr[1];
    let b: i32 = main.s.arr[2];
    transition a > b {
        true -> do_swap_12(main, a, b)
        _ -> done_12()
    }
    state do_swap_12(main: &mut Main, a: i32, b: i32) {
        main.s.arr[1] = b;
        main.s.arr[2] = a;
    }
    state done_12() {}
}

machine Main::cmp_swap_23(main: &mut Main) {
    let a: i32 = main.s.arr[2];
    let b: i32 = main.s.arr[3];
    transition a > b {
        true -> do_swap_23(main, a, b)
        _ -> done_23()
    }
    state do_swap_23(main: &mut Main, a: i32, b: i32) {
        main.s.arr[2] = b;
        main.s.arr[3] = a;
    }
    state done_23() {}
}

machine Main::cmp_swap_34(main: &mut Main) {
    let a: i32 = main.s.arr[3];
    let b: i32 = main.s.arr[4];
    transition a > b {
        true -> do_swap_34(main, a, b)
        _ -> done_34()
    }
    state do_swap_34(main: &mut Main, a: i32, b: i32) {
        main.s.arr[3] = b;
        main.s.arr[4] = a;
    }
    state done_34() {}
}

machine Main::cmp_swap_45(main: &mut Main) {
    let a: i32 = main.s.arr[4];
    let b: i32 = main.s.arr[5];
    transition a > b {
        true -> do_swap_45(main, a, b)
        _ -> done_45()
    }
    state do_swap_45(main: &mut Main, a: i32, b: i32) {
        main.s.arr[4] = b;
        main.s.arr[5] = a;
    }
    state done_45() {}
}

// ---- Bubble sort passes ----
// Pass 1: all 5 adjacent pairs; the largest element bubbles to position 5.
machine Main::pass1(main: &mut Main) {
    Main::cmp_swap_01(main);
    Main::cmp_swap_12(main);
    Main::cmp_swap_23(main);
    Main::cmp_swap_34(main);
    Main::cmp_swap_45(main);
}

// Pass 2: pairs 0..3; position 5 already settled.
machine Main::pass2(main: &mut Main) {
    Main::cmp_swap_01(main);
    Main::cmp_swap_12(main);
    Main::cmp_swap_23(main);
    Main::cmp_swap_34(main);
}

// Pass 3: pairs 0..2; positions 4,5 settled.
machine Main::pass3(main: &mut Main) {
    Main::cmp_swap_01(main);
    Main::cmp_swap_12(main);
    Main::cmp_swap_23(main);
}

// Pass 4: pairs 0..1; positions 3,4,5 settled.
machine Main::pass4(main: &mut Main) {
    Main::cmp_swap_01(main);
    Main::cmp_swap_12(main);
}

// Pass 5: pair 0; positions 2,3,4,5 settled.
machine Main::pass5(main: &mut Main) {
    Main::cmp_swap_01(main);
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("insertion_sort: bubble-sorting [5,2,8,1,3,7] with compare-and-swap passes");
    // Initialize array: [5, 2, 8, 1, 3, 7].
    main.s.arr[0] = 5;
    main.s.arr[1] = 2;
    main.s.arr[2] = 8;
    main.s.arr[3] = 1;
    main.s.arr[4] = 3;
    main.s.arr[5] = 7;

    // Bubble sort: 5 passes for n=6.
    Main::pass1(main);
    Main::pass2(main);
    Main::pass3(main);
    Main::pass4(main);
    Main::pass5(main);

    // Verify sorted order: [1, 2, 3, 5, 7, 8].
    let v0: i32 = main.s.arr[0];
    transition v0 == 1 {
        true -> check1(main)
        _ -> bad0(main)
    }

    state bad0(main: &mut Main) {
        Console::write_line("FAIL: arr[0] != 1 after sorting (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state check1(main: &mut Main) {
        let v1: i32 = main.s.arr[1];
        transition v1 == 2 {
            true -> check2(main)
            _ -> bad1(main)
        }
    }

    state bad1(main: &mut Main) {
        Console::write_line("FAIL: arr[1] != 2 after sorting (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }

    state check2(main: &mut Main) {
        let v2: i32 = main.s.arr[2];
        transition v2 == 3 {
            true -> check3(main)
            _ -> bad2(main)
        }
    }

    state bad2(main: &mut Main) {
        Console::write_line("FAIL: arr[2] != 3 after sorting (exit 73)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(73);
    }

    state check3(main: &mut Main) {
        let v3: i32 = main.s.arr[3];
        transition v3 == 5 {
            true -> check4(main)
            _ -> bad3(main)
        }
    }

    state bad3(main: &mut Main) {
        Console::write_line("FAIL: arr[3] != 5 after sorting (exit 74)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(74);
    }

    state check4(main: &mut Main) {
        let v4: i32 = main.s.arr[4];
        transition v4 == 7 {
            true -> check5(main)
            _ -> bad4(main)
        }
    }

    state bad4(main: &mut Main) {
        Console::write_line("FAIL: arr[4] != 7 after sorting (exit 75)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(75);
    }

    state check5(main: &mut Main) {
        let v5: i32 = main.s.arr[5];
        transition v5 == 8 {
            true -> good(main)
            _ -> bad5(main)
        }
    }

    state bad5(main: &mut Main) {
        Console::write_line("FAIL: arr[5] != 8 after sorting (exit 76)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(76);
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: array sorted to [1,2,3,5,7,8] (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }
}
