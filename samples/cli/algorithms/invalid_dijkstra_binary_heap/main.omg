use omega\language\core\ProcessExit;
// Intended-invalid control for dijkstra_binary_heap: `pop_heap`'s
// `requires h.length >= 1` must reject a caller that never established the
// heap is non-empty — `main.heap.length` is 0 here, so the pop is unproven.
use omega_language_std\Console;

data Heap<T> { items: [T; 16]; length: u64; }
data Popped<T [copy]> [copy] { value: T; }

machine ent_less(left: @u64, right: @u64) -> bool {
    $left < $right
}

data Main { heap: Heap<u64>; }

machine pop_heap<T [copy], machine Less>(h: @mut Heap<T>, root: @mut Popped<T>)
requires machine Less(left: @T, right: @T) -> bool;
    requires h.length >= 1
    requires h.length <= 16
{
    let top: T = h.items[0];
    root.value = top;
    h.length = 0;
}

machine main(main: @mut Main) reaches ProcessExit + Console crashes Trap {
    main.heap.length = 0;
    let mut popped: Popped<u64> = Popped { value: 0 };
    pop_heap::<ent_less>(@mut main.heap, @mut popped);
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console crashes Trap {
    let mut entry_storage: Main;
    main(@mut entry_storage);
}
