use {omega}/language/core/process_exit.omg;
// Intended-invalid control for dijkstra_binary_heap: `pop_heap`'s
// `requires h.length >= 1` must reject a caller that never established the
// heap is non-empty — `main.heap.length` is 0 here, so the pop is unproven.

data Heap<T> { items: [T; 16]; length: u64; }
data Popped<T [copy]> [copy] { value: T; }

machine ent_less(left: @u64, right: @u64) -> bool {
    $left < $right
}

data Main { heap: Heap<u64>; }

machine pop_heap<T [copy], machine Less>(h: @mutable Heap<T>, root: @mutable Popped<T>)
requires machine Less(left: @T, right: @T) -> bool;
    requires h.length >= 1
    requires h.length <= 16
{
    let top: T = h.items[0];
    root.value = top;
    h.length = 0;
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit crashes Trap {
    main.heap.length = 0;
    let mutable popped: Popped<u64> = Popped { value: 0 };
    pop_heap::<ent_less>(@mutable main.heap, @mutable popped);
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit crashes Trap {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
