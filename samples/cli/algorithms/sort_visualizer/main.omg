// A bubble-sort VISUALIZER: eight values drawn as horizontal bars (a row of '#' whose
// length is the value), re-rendered in place after every pass so you watch the array
// settle from jumbled into an ascending staircase. The first ALGORITHM-in-motion sample
// that mutates a data array on screen (binary_search_viz only narrows a range; this
// actually reorders storage). Sort logic is the proven bubble_sort canary: the adjacent
// index `j+1` computed into a field `jp` (a computed index is refused in a subscript),
// the two elements read into fields and compared (a direct `arr[j] > arr[j+1]` guard is
// the two-runtime-operand gap), the swap writing the read values back. Pure compute +
// stdout + Clock.sleep; no new compiler features.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega_language_std::macos_gui;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
pub boundary trait Clock { machine sleep(milliseconds: u32) invokes DarwinClock; }

// Declared-host Clock wiring, the pattern `samples/gui/window_app` carries: a
// provider data, a target-scoped `provider_defaults` that selects it, and a
// `satisfies Clock::sleep` machine over the `darwin_poll` leaf. The provider
// holds no state: each call keeps its timeout and poll status in locals, where
// the static-machine contract places invocation scratch.
data PacingClockProvider { }
macos_arm64 machine PacingClockProvider::provider_defaults(defaults: &mut PacingClockProvider) {
    defaults.select_provider<Clock, PacingClockProvider>();
}
macos_arm64 machine PacingClockProvider::sleep(milliseconds: u32) satisfies Clock::sleep
{
    let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
    let rc: i32 = darwin_poll(0, 0, timeout);
}

// FULLY EXACT -- no overflow domain anywhere: the counters are plain i32 and
// every increment is guard-proven on its DIRECT incoming edge (re-guard hops added
// where the loop-head guard sits several states upstream). The element values
// (vj/vk/val) are plain i32: they are only copied and compared, never used in
// arithmetic, so they carry no obligation.
data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    arr: [i32; 8];
    home: [u8; 3] in Utf8;
    line: [u8; 8] in Utf8;
    i: i32;            // outer pass
    j: i32;            // inner index
    lim: i32;          // inner bound (shrinks each pass; folds bounded from step's guard on i)
    jp: i32;           // j + 1 (folds bounded from the `j < lim` guard)
    vj: i32;           // arr[j]
    vk: i32;           // arr[jp]
    ry: i32;           // render row
    cx: i32;           // render column
    val: i32;          // bar length for the current row
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Clock + Console + DarwinClock {
    main.console.write_line("sort_visualizer: bubble sort animated as bars settling into a staircase");
    main.arr = [5, 2, 8, 1, 7, 3, 6, 4];
    main.home = "XXX";
    main.home[0] = 27;
    main.home[1] = 91;
    main.home[2] = 72;
    main.line = "        ";
    main.i = 0;
    transition { _ -> show(main) }

    // --- render the array as bars, in place ---
    state show(main: &mut Main) {
        main.console.write(main.home);
        main.ry = 0;
        transition { _ -> show_row(main) }
    }
    state show_row(main: &mut Main) {
        transition main.ry >= 0 && main.ry < 8 { true -> show_col_init(main) _ -> show_done(main) }
    }
    state show_col_init(main: &mut Main) {
        main.val = main.arr[main.ry];
        main.cx = 0;
        transition { _ -> show_col(main) }
    }
    state show_col(main: &mut Main) {
        transition main.cx >= 0 && main.cx < 8 { true -> show_cell(main) _ -> emit_row(main) }
    }
    state show_cell(main: &mut Main) {
        transition main.cx < main.val { true -> cell_bar(main) _ -> cell_gap(main) }
    }
    // The two cell arms join in cell_next, whose single re-guarded edge proves the
    // increment (cx < 8 always holds here -- the show_col guard admitted it -- so
    // the else arm is unreachable).
    state cell_bar(main: &mut Main) {
        main.line[main.cx] = 35; // '#'
        transition { _ -> cell_next(main) }
    }
    state cell_gap(main: &mut Main) {
        main.line[main.cx] = 32; // ' '
        transition { _ -> cell_next(main) }
    }
    state cell_next(main: &mut Main) {
        transition main.cx < 8 { true -> cell_bump(main) _ -> emit_row(main) }
    }
    state cell_bump(main: &mut Main) {
        main.cx = main.cx + 1;
        transition { _ -> show_col(main) }
    }
    // write_line is a CALL, so re-guard `ry < 8` afterwards to carry the bound on
    // the direct edge into the increment (ry < 8 always holds inside the row loop).
    state emit_row(main: &mut Main) {
        main.console.write_line(main.line);
        transition main.ry < 8 { true -> row_bump(main) _ -> show_done(main) }
    }
    state row_bump(main: &mut Main) {
        main.ry = main.ry + 1;
        transition { _ -> show_row(main) }
    }
    state show_done(main: &mut Main) {
        main.clock.sleep(180);
        transition { _ -> step(main) }
    }

    // --- one bubble-sort pass, then loop back to re-render ---
    // Both bounds of `i` sit on the edge into inner_init, so `7 - i` folds
    // into [1..=7] (i only grows from 0, so the lower conjunct always holds).
    state step(main: &mut Main) {
        transition main.i >= 0 && main.i < 7 { true -> inner_init(main) _ -> finish(main) }
    }
    state inner_init(main: &mut Main) {
        main.lim = 7 - main.i;
        main.j = 0;
        transition { _ -> inner(main) }
    }
    state inner(main: &mut Main) {
        transition main.j >= 0 && main.j < main.lim { true -> compare(main) _ -> outer_next(main) }
    }
    state compare(main: &mut Main) {
        main.jp = main.j + 1;
        transition main.j >= 0 && main.j < 8 && main.jp >= 0 && main.jp < 8 {
            true -> read(main)
            _ -> finish(main)
        }
    }
    state read(main: &mut Main) {
        main.vj = main.arr[main.j];
        main.vk = main.arr[main.jp];
        transition main.vj > main.vk { true -> swap(main) _ -> inner_next(main) }
    }
    state swap(main: &mut Main) {
        main.arr[main.j] = main.vk;
        main.arr[main.jp] = main.vj;
        transition { _ -> inner_next(main) }
    }
    // Re-guard hops: the increments' direct edges must carry the bound (j < lim
    // <= 7 and i < 7 always hold here, so the else arms are unreachable).
    state inner_next(main: &mut Main) {
        transition main.j < 7 { true -> inner_bump(main) _ -> finish(main) }
    }
    state inner_bump(main: &mut Main) {
        main.j = main.j + 1;
        transition { _ -> inner(main) }
    }
    state outer_next(main: &mut Main) {
        transition main.i < 7 { true -> outer_bump(main) _ -> finish(main) }
    }
    state outer_bump(main: &mut Main) {
        main.i = main.i + 1;
        transition { _ -> show(main) }
    }

    state finish(main: &mut Main) {
        main.console.write_line("PASS: 7 bubble-sort passes rendered, array sorted (exit 0)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(0);
    }
}
