// Dijkstra's Dutch national flag -- the classic three-pointer in-place
// partition, over a real enum array: everything below `w` is Red, everything
// from `b` up is Blue, and the White cursor walks the unknown middle until it
// meets the fence.
//
//   [White, Blue, Red]  ->  [Red, White, Blue]
//
// Written in the field-counter idiom (see bubble_sort): plain Exact
// counters + literal re-guard states dominating every runtime-indexed
// access. The `confused(9x)` arms are the loop invariants a Dafny port would
// write as `invariant 0 <= r <= w <= b <= 3` -- relational facts today's
// prover doesn't carry around the loop, so they stand as honest runtime
// checks that never fire. The verified north star (design record, NOT yet
// shipped syntax) replaces them entirely:
//
//     machine dutch_flag(before: &[Color], items: &mut [Color])
//     requires Bag(items) == Bag(before)              // Dafny: old(multiset)
//     ensures  Seq(items) in Sorted<Color::FlagRank>  // Dafny: forall i,j
//              Bag(items) == Bag(before)
//
// (Bag/Seq are the proof-only roster, Sorted rides a named rank satisfier,
// and the guard states become provably-dead arms once relational window
// facts land -- the N4/R2 ladders.)
//
// ZII footnote: Color's first case is Red, so the zero-initialized array is
// already a sorted flag.
// Expected exit: 70.

use omega_language_std::console;

// Swaps copy these payload-free values out of borrowed array storage.
data Color [copy] {
    case Red;
    case White;
    case Blue;
}

data Partition {
    items: [Color; 3];
    r: u64;   // red prefix end: items[0..r] are Red
    w: u64;   // white cursor: items[r..w] are White
    b: u64;   // blue fence: items[b..3] are Blue
    bp: u64;  // b - 1: the b > 0 guard rules out underflow, a re-guard bounds it
    t: Color;
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut context: Partition;
    block Partition::sort(&mut context);
}

machine Partition::sort(context: &mut Partition) reaches Console {
    Console::write_line("dutch_flag: partitioning [White, Blue, Red] into [Red, White, Blue]");
    context.items[0] = Color::White;
    context.items[1] = Color::Blue;
    context.items[2] = Color::Red;
    context.r = 0;
    context.w = 0;
    context.b = 3;
    transition {
        _ -> head(context)
    }

    // Loop head: partition until the white cursor meets the blue fence.
    state head(context: &mut Partition) {
        transition context.w < context.b {
            true -> w_guard(context)
            _ -> check0(context)
        }
    }

    // Literal re-guard: dominates every items[context.w] access downstream
    // (classify and both swaps -- no state between rewrites w).
    state w_guard(context: &mut Partition) {
        transition context.w < 3 {
            true -> classify(context)
            _ -> confused(96)
        }
    }

    state classify(context: &mut Partition) {
        transition context.items[context.w] {
            Color::Red -> r_guard(context)
            Color::White -> w_bump_guard(context)
            _ -> b_guard(context)
        }
    }

    state r_guard(context: &mut Partition) {
        transition context.r < 3 {
            true -> red_swap(context)
            _ -> confused(97)
        }
    }

    // Red at the cursor: swap it into the red prefix, grow the prefix
    // (`r + 1` proves on the DIRECT edge from r_guard), then join the
    // white path to bump the cursor.
    state red_swap(context: &mut Partition) {
        context.t = context.items[context.r];
        context.items[context.r] = context.items[context.w];
        context.items[context.w] = context.t;
        context.r = context.r + 1;
        transition {
            _ -> w_bump_guard(context)
        }
    }

    // Re-guard before the increment: the bound must sit on the DIRECT edge
    // for the `+ 1` to prove (the bubble_sort `advance` idiom). The red and
    // white arms both join here.
    state w_bump_guard(context: &mut Partition) {
        transition context.w < 3 {
            true -> w_bump(context)
            _ -> confused(95)
        }
    }

    state w_bump(context: &mut Partition) {
        context.w = context.w + 1;
        transition {
            _ -> head(context)
        }
    }

    state b_guard(context: &mut Partition) {
        transition context.b > 0 {
            true -> blue_swap(context)
            _ -> confused(98)
        }
    }

    // Blue at the cursor: shrink the blue fence, swap the blue out to it.
    // The decremented fence lands in `bp`; nothing bounds the stored `b`
    // from above, so the literal re-guard `bp < 3` carries the index proof
    // into blue_put (b <= 3 always holds, so the else arm never fires).
    state blue_swap(context: &mut Partition) {
        context.bp = context.b - 1;
        transition context.bp < 3 {
            true -> blue_put(context)
            _ -> confused(99)
        }
    }

    state blue_put(context: &mut Partition) {
        context.t = context.items[context.w];
        context.items[context.w] = context.items[context.bp];
        context.items[context.bp] = context.t;
        context.b = context.bp;
        transition {
            _ -> head(context)
        }
    }

    // Verify [Red, White, Blue] element by element via case dispatch.
    state check0(context: &mut Partition) {
        transition context.items[0] {
            Color::Red -> check1(context)
            _ -> bad(71)
        }
    }
    state check1(context: &mut Partition) {
        transition context.items[1] {
            Color::White -> check2(context)
            _ -> bad(72)
        }
    }
    state check2(context: &mut Partition) {
        transition context.items[2] {
            Color::Blue -> good()
            _ -> bad(73)
        }
    }
    state good() {
        Console::write_line("PASS: the flag reads [Red, White, Blue] (exit 70)");
        transition {
            _ -> report(70)
        }
    }
    state bad(code: i32) {
        Console::write_line("FAIL: an element ended up out of order");
        transition {
            _ -> report_bad(code)
        }
    }
    state confused(code: i32) {
        Console::write_line("FAIL: a loop-invariant re-guard tripped");
        transition {
            _ -> report_bad(code)
        }
    }
    state report(code: i32) {
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(code);
    }
    state report_bad(code: i32) {
        Console::write_line("[press Enter to close]");
        let mut pause: [u8; 256];
        _ = block Console::read_line(&mut pause);
        Console::exit_process(code);
    }
}
