// Lower and upper bounds over an ordered record slice, without fixed-size
// clamps. Duplicate keys delimit a contiguous range of candidate records.
// Expected exit: 0.
data Record { key: u64; address: u64; }

machine bound(records: &[Record], key: u64, after_equal: bool) -> u64 {
    transition { _ -> search(records, key, after_equal, 0, records.len) }
    machine search(records: &[Record], key: u64, after_equal: bool,
                 lower: u64, upper: u64) -> u64
    requires lower <= upper && upper <= records.len
    {
        transition lower < upper {
            true -> probe(records, key, after_equal, lower, upper)
            false -> (lower)
        }
    }
    machine probe(records: &[Record], key: u64, after_equal: bool,
                lower: u64, upper: u64) -> u64
    requires lower < upper && upper <= records.len
    {
        let middle: u64 = lower + (upper - lower) / 2;
        let current: u64 = records[middle].key;
        transition current < key || (after_equal && current == key) {
            true -> search(records, key, after_equal, middle + 1, upper)
            false -> search(records, key, after_equal, lower, middle)
        }
    }
}

machine main() crashes Trap {
    let records: [Record; 6] = [
        Record { key: 0, address: 100 },
        Record { key: 7, address: 200 },
        Record { key: 7, address: 300 },
        Record { key: 7, address: 400 },
        Record { key: 12, address: 500 },
        Record { key: 18446744073709551615, address: 600 }
    ];
    let first: u64 = bound(&records, 7, false);
    let past: u64 = bound(&records, 7, true);
    let absent: u64 = bound(&records, 8, false);
    let maximum: u64 = bound(&records, 18446744073709551615, false);
    let maximum_end: u64 = bound(&records, 18446744073709551615, true);
    let empty: u64 = bound(records[..0], 7, false);
    let suffix: u64 = bound(records[2..], 7, true);
    let first_key: u64 = bound(&records, 0, false);
    transition first == 1 && past == 4 && absent == 4 && maximum == 5
        && maximum_end == 6 && empty == 0 && suffix == 2 && first_key == 0 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
