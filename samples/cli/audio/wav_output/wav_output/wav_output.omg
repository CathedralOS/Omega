// One portable byte-file sink over separately selected raw service families.
// Whole-trait providers are named implementations, not data-owned groups of
// exact satisfaction edges. The same POSIX body serves all POSIX targets;
// target defaults choose the implementation and its raw closure, not a source
// routing value or a different portable reach row.
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/numeric_conversion.omg as numeric;
use {system}/filesystem_host.omg as paths;
use {system}/posix_filesystem_host.omg as posix;
use {system}/windows_filesystem_host.omg as windows;

public boundary trait WavOutput {
    machine write_wav(path: @[u8] in |paths|::Path, bytes: @[u8]) -> i64
        reaches WavOutput + |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
        blocks
        invokes |posix|::PosixFilesystemHost
        invokes |windows|::WindowsFilesystemHost crashes none;
}

PosixWavOutput satisfies WavOutput {
    machine write_wav(path: @[u8] in |paths|::Path, bytes: @[u8]) -> i64
    reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
    invokes |posix|::PosixFilesystemHost
    {
        let fd: i32 = |posix|::PosixFilesystemHost::create(path, 420);
        transition fd >= 0 { true -> write(fd, bytes), _ -> (|numeric|::widen_i32_to_i64(fd)) }

        machine write(fd: i32, bytes: @[u8]) -> i64 {
            let n: i64 = |posix|::PosixFilesystemHost::write(fd, bytes);
            let rc: i32 = |posix|::PosixFilesystemHost::close(fd);
            transition { _ -> (n) }
        }
    }
}

WindowsWavOutput satisfies WavOutput {
    // GENERIC_WRITE, share 0, CREATE_ALWAYS and FILE_ATTRIBUTE_NORMAL.
    // A failed create reports the same negated Win32 error as the raw family.
    machine write_wav(path: @[u8] in |paths|::Path, bytes: @[u8]) -> i64
    reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
    invokes |windows|::WindowsFilesystemHost
    {
        let handle: u64 = block |windows|::WindowsFilesystemHost::create_file(path, 1073741824, 0, 2, 128);
        transition handle != 0 { true -> block write(handle, bytes), _ -> failed() }

        machine write(handle: u64, bytes: @[u8]) -> i64 {
            let n: i64 = block |windows|::WindowsFilesystemHost::write_file(handle, bytes);
            let rc: i32 = block |windows|::WindowsFilesystemHost::close_handle(handle);
            transition { _ -> (n) }
        }
        machine failed() -> i64 {
            let code: u32 = |windows|::WindowsFilesystemHost::last_error();
            transition { _ -> (0 - |numeric|::widen_u32_to_i64(code)) }
        }
    }
}
