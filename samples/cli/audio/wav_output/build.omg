// wav_output: the portable write-a-buffer-to-a-file boundary shared by the
// audio samples.

machine build(builder: &mut Build) {
    Build::package(builder, "wav_output");
    Build::depend(builder, Source::Path {
        location: "../../../../source/library/std"
    });
    Build::select_provider<WavOutput, WindowsWavOutput>(builder, windows_x86_64);
    Build::select_provider<WavOutput, PosixWavOutput>(builder, linux_x86_64);
    Build::select_provider<WavOutput, PosixWavOutput>(builder, linux_arm64);
    Build::select_provider<WavOutput, PosixWavOutput>(builder, macos_arm64);
}
