// wav_output: the portable write-a-buffer-to-a-file boundary shared by the
// audio samples.

machine build(builder: &mut Build) {
    Build::package(builder, "wav_output");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../source/library/std"
    }));

    Build::select_provider<wav_output::WavOutput, wav_output::WindowsWavOutput>(builder, windows_x86_64);
    Build::select_provider<wav_output::WavOutput, wav_output::PosixWavOutput>(builder, linux_x86_64);
    Build::select_provider<wav_output::WavOutput, wav_output::PosixWavOutput>(builder, linux_arm64);
    Build::select_provider<wav_output::WavOutput, wav_output::PosixWavOutput>(builder, macos_arm64);
}
