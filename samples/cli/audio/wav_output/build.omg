// wav_output: the portable write-a-buffer-to-a-file boundary shared by the
// audio samples.

use {omega}/build/dependency.omg;
use wav_output/wav_output.omg as output;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Package { name: "wav_output" };
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Bundled {
        name: "system"
    }));

    Build::select_provider::<|output|::WavOutput, |output|::WindowsWavOutput>(builder, windows_x86_64);
    Build::select_provider::<|output|::WavOutput, |output|::WindowsWavOutput>(builder, windows_arm64);
    Build::select_provider::<|output|::WavOutput, |output|::PosixWavOutput>(builder, linux_x86_64);
    Build::select_provider::<|output|::WavOutput, |output|::PosixWavOutput>(builder, linux_arm64);
    Build::select_provider::<|output|::WavOutput, |output|::PosixWavOutput>(builder, macos_arm64);
}
