// AudioPlayback: the portable speaker the audio samples play through.
// An application holds only `Binding<AudioPlayback>`; each target's named
// implementation satisfies the trait and reaches its own platform audio
// mechanism — winmm `PlaySoundW` on windows_x86_64, ALSA
// (`snd_pcm_*`, libasound.so.2) on linux_x86_64 and linux_arm64 — so
// provider selection sees exactly one realizable provider per target.
//
// `play` accepts the complete RIFF/WAV image (`image` points at its first
// byte, `image_length` its byte count) plus a direct PCM view (`pcm` points
// at the first sample byte, `frames` the sample-frame count). The format
// contract is the samples' fixed 8-bit unsigned mono PCM at 8000 Hz. The
// call blocks until playback finishes; 0 reports completion and a negative
// result is the provider's failure code — no error state. Providers that
// cannot play the PCM view may use the whole image instead.
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

pub boundary trait AudioPlayback {
    machine play(image: &u8, image_length: u32, pcm: &u8, frames: u32) -> i32
        reaches AudioPlayback
        blocks;
}

data WindowsAudioPlayback { }
data LinuxAudioPlayback { }
data MacosAudioPlayback { }

data WindowsAudioPlaybackIo { }
data WindowsAudioPlaybackImports { }
data LinuxAudioPlaybackIo { }
data LinuxAudioPlaybackImports { }
data LinuxArm64AudioPlaybackImports { }

// ---- windows_x86_64: winmm PlaySoundW over the in-memory WAV image ----
// BOOL PlaySoundW(LPCWSTR pszSound, HMODULE hmod, DWORD fdwSound); with
// SND_MEMORY|SND_NODEFAULT (0x0006) pszSound is a pointer to the WAV image
// and the call is synchronous until the sound ends. A nonzero BOOL is
// success; 0 reports -1 (winmm returns BOOL, not an error code).
boundary requirement WindowsAudioPlaybackIo::c_play_sound(image: &u8, hmod: u64, flags: u32) -> i32
reaches AudioPlayback
blocks;

windows_x86_64 machine windows_play_sound_binding() -> ForeignBinding<9, 10, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "winmm.dll",
            export: "PlaySoundW",
        },
    }
}
windows_x86_64 machine WindowsAudioPlaybackImports::c_play_sound(image: &u8, hmod: u64, flags: u32) -> i32
    satisfies WindowsAudioPlaybackIo::c_play_sound
    via windows_play_sound_binding();

windows_x86_64 machine WindowsAudioPlayback::play(image: &u8, image_length: u32, pcm: &u8, frames: u32) -> i32
    satisfies AudioPlayback::play
reaches AudioPlayback
{
    let ok: i32 = block WindowsAudioPlaybackIo::c_play_sound(image, 0, 6);
    transition ok != 0 { true -> (0) _ -> (0 - 1) }
}
windows_x86_64 machine WindowsAudioPlayback::provider_defaults(defaults: &mut WindowsAudioPlayback) {
    WindowsAudioPlayback::select_provider<AudioPlayback, WindowsAudioPlayback>(defaults);
}

// ---- linux_x86_64 / linux_arm64: ALSA simple PCM over libasound.so.2 ----
// int  snd_pcm_open(snd_pcm_t**, const char*, stream, mode)
// int  snd_pcm_set_params(snd_pcm_t*, format, access, channels, rate,
//                         soft_resample, latency_us)
// long snd_pcm_writei(snd_pcm_t*, const void*, snd_pcm_uframes_t)
// int  snd_pcm_drain(snd_pcm_t*) / snd_pcm_close(snd_pcm_t*)
// ALSA answers -errno on failure; the first negative status is the result.
// format 1 = U8, access 3 = RW_INTERLEAVED, stream 0 = PLAYBACK.
boundary requirement LinuxAudioPlaybackIo::c_open(pcm: &mut u64, name: &u8, stream: i32, mode: i32) -> i32
reaches AudioPlayback;
boundary requirement LinuxAudioPlaybackIo::c_set_params(pcm: u64, format: i32, access: i32, channels: u32, rate: u32, soft_resample: i32, latency_us: u32) -> i32
reaches AudioPlayback;
boundary requirement LinuxAudioPlaybackIo::c_writei(pcm: u64, buffer: &u8, frames: u64) -> i64
reaches AudioPlayback
blocks;
boundary requirement LinuxAudioPlaybackIo::c_drain(pcm: u64) -> i32
reaches AudioPlayback
blocks;
boundary requirement LinuxAudioPlaybackIo::c_close(pcm: u64) -> i32
reaches AudioPlayback;

linux_x86_64 machine linux_open_binding() -> ForeignBinding<14, 12, 8> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libasound.so.2", symbol: "snd_pcm_open", version: "ALSA_0.9",
        },
    }
}
linux_x86_64 machine linux_set_params_binding() -> ForeignBinding<14, 18, 8> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libasound.so.2", symbol: "snd_pcm_set_params", version: "ALSA_0.9",
        },
    }
}
linux_x86_64 machine linux_writei_binding() -> ForeignBinding<14, 14, 8> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libasound.so.2", symbol: "snd_pcm_writei", version: "ALSA_0.9",
        },
    }
}
linux_x86_64 machine linux_drain_binding() -> ForeignBinding<14, 13, 8> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libasound.so.2", symbol: "snd_pcm_drain", version: "ALSA_0.9",
        },
    }
}
linux_x86_64 machine linux_close_binding() -> ForeignBinding<14, 13, 8> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libasound.so.2", symbol: "snd_pcm_close", version: "ALSA_0.9",
        },
    }
}
linux_x86_64 machine LinuxAudioPlaybackImports::c_open(pcm: &mut u64, name: &u8, stream: i32, mode: i32) -> i32
    satisfies LinuxAudioPlaybackIo::c_open via linux_open_binding();
linux_x86_64 machine LinuxAudioPlaybackImports::c_set_params(pcm: u64, format: i32, access: i32, channels: u32, rate: u32, soft_resample: i32, latency_us: u32) -> i32
    satisfies LinuxAudioPlaybackIo::c_set_params via linux_set_params_binding();
linux_x86_64 machine LinuxAudioPlaybackImports::c_writei(pcm: u64, buffer: &u8, frames: u64) -> i64
    satisfies LinuxAudioPlaybackIo::c_writei via linux_writei_binding();
linux_x86_64 machine LinuxAudioPlaybackImports::c_drain(pcm: u64) -> i32
    satisfies LinuxAudioPlaybackIo::c_drain via linux_drain_binding();
linux_x86_64 machine LinuxAudioPlaybackImports::c_close(pcm: u64) -> i32
    satisfies LinuxAudioPlaybackIo::c_close via linux_close_binding();

linux_x86_64 machine LinuxAudioPlayback::play(image: &u8, image_length: u32, pcm: &u8, frames: u32) -> i32
    satisfies AudioPlayback::play
reaches AudioPlayback
{
    transition { _ -> open(pcm, frames) }

    state open(pcm: &u8, frames: u32) -> i32 {
        let name: [u8; 8] = "default\0";
        let mut handle: u64 = 0;
        let rc: i32 = LinuxAudioPlaybackIo::c_open(&mut handle, &name[0], 0, 0);
        transition rc >= 0 { true -> params(handle, pcm, frames) _ -> (rc) }
    }
    state params(handle: u64, pcm: &u8, frames: u32) -> i32 {
        let rc: i32 = LinuxAudioPlaybackIo::c_set_params(handle, 1, 3, 1, 8000, 1, 500000);
        transition rc >= 0 { true -> play_frames(handle, pcm, frames) _ -> close_fail(handle, rc) }
    }
    state play_frames(handle: u64, pcm: &u8, frames: u32) -> i32 {
        let total: u64 = widen_u32_to_u64(frames);
        let done: i64 = block LinuxAudioPlaybackIo::c_writei(handle, pcm, total);
        transition done >= 0 { true -> drain(handle) _ -> close_i64(handle, done) }
    }
    state drain(handle: u64) -> i32 {
        let rc: i32 = block LinuxAudioPlaybackIo::c_drain(handle);
        transition { _ -> close_i32(handle, rc) }
    }
    state close_i32(handle: u64, rc: i32) -> i32 {
        let c: i32 = LinuxAudioPlaybackIo::c_close(handle);
        transition { _ -> (rc) }
    }
    state close_fail(handle: u64, rc: i32) -> i32 {
        let c: i32 = LinuxAudioPlaybackIo::c_close(handle);
        transition { _ -> (rc) }
    }
    state close_i64(handle: u64, code: i64) -> i32 {
        let rc: i32 = narrow_i64_to_i32_wrapping(code);
        let c: i32 = LinuxAudioPlaybackIo::c_close(handle);
        transition { _ -> (rc) }
    }
}
linux_x86_64 machine LinuxAudioPlayback::provider_defaults(defaults: &mut LinuxAudioPlayback) {
    LinuxAudioPlayback::select_provider<AudioPlayback, LinuxAudioPlayback>(defaults);
}

linux_arm64 machine linux_arm64_open_binding() -> ForeignBinding<14, 12, 8> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libasound.so.2", symbol: "snd_pcm_open", version: "ALSA_0.9",
        },
    }
}
