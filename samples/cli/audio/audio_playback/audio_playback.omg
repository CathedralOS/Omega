// ---- macos_arm64: AudioToolbox AudioQueue over the PCM view ----
// OSStatus AudioQueueNewOutput(const AudioStreamBasicDescription*, callback,
//                              userData, runLoop, runLoopMode, flags, AudioQueueRef*)
// OSStatus AudioQueueAllocateBuffer(AudioQueueRef, byteSize, AudioQueueBufferRef*)
// OSStatus AudioQueueEnqueueBuffer(AudioQueueRef, AudioQueueBufferRef,
//                                  packetCount, packetDescriptions)
// OSStatus AudioQueueStart / AudioQueueStop / AudioQueueDispose
// The 8-bit unsigned mono stream at 8000 Hz is constant bit rate — one byte
// per frame — so a single queue buffer carries the whole PCM view and the
// enqueue takes no packet descriptions. `play` then sleeps the authored
// duration plus margin and stops and disposes the queue.
//
// AudioQueueNewOutput rejects a NULL buffer-completion callback (-50), but
// this single-shot playback needs no callback work. The callback handed over
// is libSystem's `usleep`, resolved through `dlsym(RTLD_DEFAULT, "usleep")` —
// AudioToolbox invokes it as usleep(user_data) with user_data 0, a documented
// no-op that keeps this provider free of native-callback machinery.
//
// The queue owns its buffer memory. `AudioQueueBuffer` fields are reached
// only through libSystem copies by raw address — never an Omega dereference:
// `_memmove` writes mAudioDataByteSize (offset 16) and copies the PCM into
// mAudioData; `_bcopy` reads the mAudioData pointer (offset 8) back as a u64
// local — eight bytes wide by the stated count. `_memcpy` is not bound here —
// one Mach-O locator may serve only one import symbol and std's posix
// provider already imports it.
//
// OSStatus answers 0 on success. A negative status passes through while the
// samples' three-digit failure printer can hold its magnitude; a larger
// magnitude clamps to -999 and a positive status reports -998.
boundary requirement MacosAudioPlaybackIo::c_dlsym(handle: u64, name: &u8) -> u64
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_new_output(format: &u8, callback: u64, user_data: u64, callback_run_loop: u64, callback_mode: u64, flags: u32, queue: &mut u64) -> i32
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_allocate_buffer(queue: u64, byte_size: u32, buffer: &mut u64) -> i32
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_enqueue_buffer(queue: u64, buffer: u64, packet_count: u32, packet_descriptions: u64) -> i32
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_start(queue: u64, start_time: u64) -> i32
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_stop(queue: u64, immediate: u32) -> i32
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_dispose(queue: u64, immediate: u32) -> i32
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_copy_to_address(destination: u64, source: &u8, count: u64) -> u64
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_load_pointer(source: u64, destination: &mut u64, count: u64)
reaches AudioPlayback;
boundary requirement MacosAudioPlaybackIo::c_usleep(microseconds: u32) -> i32
reaches AudioPlayback
blocks;

