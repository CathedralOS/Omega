    satisfies MacosAudioPlaybackIo::c_usleep via macos_usleep_binding()
    blocks;

// A nonzero OSStatus becomes the provider's failure code within the samples'
// three-digit printer: negatives pass through to magnitude 999, larger
// magnitudes clamp to -999 and positive statuses report -998.
machine macos_status(code: i32) -> i32 {
    transition code < 0 { true -> negative(code) _ -> nonnegative(code) }

    state negative(code: i32) -> i32 {
        transition code >= 0 - 999 { true -> (code) _ -> (0 - 999) }
    }
    state nonnegative(code: i32) -> i32 {
        transition code > 0 { true -> (0 - 998) _ -> (0 - 1) }
    }
}

macos_arm64 machine MacosAudioPlayback::play(image: &u8, image_length: u32, pcm: &u8, frames: u32) -> i32
    satisfies AudioPlayback::play
reaches AudioPlayback
{
    transition frames == 0 { true -> (0) _ -> resolve(pcm, frames) }

    // dlsym(RTLD_DEFAULT, "usleep"); RTLD_DEFAULT is the (void*)-2 handle.
    state resolve(pcm: &u8, frames: u32) -> i32 {
        let name: [u8; 7] = "usleep\0";
        let callback: u64 = MacosAudioPlaybackIo::c_dlsym(18446744073709551614, &name[0]);
        transition callback != 0 { true -> create(pcm, frames, callback) _ -> (0 - 1) }
    }

    state create(pcm: &u8, frames: u32, callback: u64) -> i32 {
        // AudioStreamBasicDescription, 40 bytes of little-endian fields:
        // 8000.0 Float64, 'lpcm', kAudioFormatFlagIsPacked, 1 byte per
        // packet, 1 frame per packet, 1 byte per frame, 1 channel, 8 bits.
        let mut format: [u8; 40] = "                                        ";
        format[0] = 0; format[1] = 0; format[2] = 0; format[3] = 0;
        format[4] = 0; format[5] = 64; format[6] = 191; format[7] = 64;
        format[8] = 109; format[9] = 99; format[10] = 112; format[11] = 108;
        format[12] = 8; format[13] = 0; format[14] = 0; format[15] = 0;
        format[16] = 1; format[17] = 0; format[18] = 0; format[19] = 0;
        format[20] = 1; format[21] = 0; format[22] = 0; format[23] = 0;
        format[24] = 1; format[25] = 0; format[26] = 0; format[27] = 0;
        format[28] = 1; format[29] = 0; format[30] = 0; format[31] = 0;
        format[32] = 8; format[33] = 0; format[34] = 0; format[35] = 0;
        format[36] = 0; format[37] = 0; format[38] = 0; format[39] = 0;
        let mut queue: u64 = 0;
        let rc: i32 = MacosAudioPlaybackIo::c_new_output(&format[0], callback, 0, 0, 0, 0, &mut queue);
        transition rc == 0 { true -> allocate(queue, pcm, frames) _ -> (macos_status(rc)) }
    }

    state allocate(queue: u64, pcm: &u8, frames: u32) -> i32 {
        let mut buffer: u64 = 0;
        let rc: i32 = MacosAudioPlaybackIo::c_allocate_buffer(queue, frames, &mut buffer);
        transition rc == 0 { true -> fill(queue, buffer, pcm, frames) _ -> teardown(queue, rc) }
    }

    state fill(queue: u64, buffer: u64, pcm: &u8, frames: u32) -> i32 {
        // Read the queue-owned mAudioData pointer out of the AudioQueueBuffer.
        // Foreign addresses are wrapping arithmetic: an AudioToolbox-owned
        // pointer has no provable headroom for exact `+`.
        let pointer_field: u64 = ((buffer as u64 in Wrapping) + 8) as u64;
        let mut data: u64 = 0;
        MacosAudioPlaybackIo::c_load_pointer(pointer_field, &mut data, 8);
        // mAudioDataByteSize (offset 16) is the frame count; then copy PCM.
        let size_field: u64 = ((buffer as u64 in Wrapping) + 16) as u64;
        let mut bytes: [u8; 4] = [0, 0, 0, 0];
        bytes[0] = narrow_u32_to_u8_wrapping(frames);
        bytes[1] = narrow_u32_to_u8_wrapping(frames / 256);
        bytes[2] = narrow_u32_to_u8_wrapping(frames / 65536);
        bytes[3] = narrow_u32_to_u8_wrapping(frames / 16777216);
        let sized: u64 = MacosAudioPlaybackIo::c_copy_to_address(size_field, &bytes[0], 4);
        let copied: u64 = MacosAudioPlaybackIo::c_copy_to_address(data, pcm, widen_u32_to_u64(frames));
        transition { _ -> enqueue(queue, buffer, frames) }
    }

    state enqueue(queue: u64, buffer: u64, frames: u32) -> i32 {
        let rc: i32 = MacosAudioPlaybackIo::c_enqueue_buffer(queue, buffer, 0, 0);
        transition rc == 0 { true -> start(queue, frames) _ -> teardown(queue, rc) }
    }

    state start(queue: u64, frames: u32) -> i32 {
        let rc: i32 = MacosAudioPlaybackIo::c_start(queue, 0);
        transition rc == 0 {
            true -> rest(queue, (frames as u32 in Wrapping) / 400 + 5)
            _ -> teardown(queue, rc)
        }
    }

    // Sleep the authored duration in ~50 ms chunks: each chunk covers 400
    // frames at 8000 Hz and five extra chunks give a 250 ms start-up margin.
    state rest(queue: u64, chunks: u32 in Wrapping) -> i32 {
        transition chunks > 0 { true -> chunk(queue, chunks) _ -> stop(queue) }
    }
    state chunk(queue: u64, chunks: u32 in Wrapping) -> i32 {
        let rc: i32 = block MacosAudioPlaybackIo::c_usleep(50000);
        transition { _ -> rest(queue, chunks - 1) }
    }

    state stop(queue: u64) -> i32 {
        let rc: i32 = MacosAudioPlaybackIo::c_stop(queue, 1);
        transition { _ -> dispose(queue) }
    }
    state dispose(queue: u64) -> i32 {
        let rc: i32 = MacosAudioPlaybackIo::c_dispose(queue, 1);
        transition { _ -> (0) }
    }
    state teardown(queue: u64, code: i32) -> i32 {
        let stopped: i32 = MacosAudioPlaybackIo::c_stop(queue, 1);
        let disposed: i32 = MacosAudioPlaybackIo::c_dispose(queue, 1);
        transition { _ -> (macos_status(code)) }
    }
}
macos_arm64 machine MacosAudioPlayback::provider_defaults(defaults: &mut MacosAudioPlayback) {
    MacosAudioPlayback::select_provider<AudioPlayback, MacosAudioPlayback>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_dlsym, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_new_output, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_allocate_buffer, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_enqueue_buffer, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_start, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_stop, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_dispose, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_copy_to_address, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_load_pointer, MacosAudioPlaybackImports>(defaults);
    MacosAudioPlayback::select_provider<MacosAudioPlaybackIo::c_usleep, MacosAudioPlaybackImports>(defaults);
}
