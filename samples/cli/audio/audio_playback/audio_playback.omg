}
linux_arm64 machine LinuxArm64AudioPlaybackImports::c_open(pcm: &mut u64, name: &u8, stream: i32, mode: i32) -> i32
    satisfies LinuxAudioPlaybackIo::c_open via linux_arm64_open_binding();
linux_arm64 machine LinuxArm64AudioPlaybackImports::c_set_params(pcm: u64, format: i32, access: i32, channels: u32, rate: u32, soft_resample: i32, latency_us: u32) -> i32
    satisfies LinuxAudioPlaybackIo::c_set_params via linux_arm64_set_params_binding();
linux_arm64 machine LinuxArm64AudioPlaybackImports::c_writei(pcm: u64, buffer: &u8, frames: u64) -> i64
    satisfies LinuxAudioPlaybackIo::c_writei via linux_arm64_writei_binding();
linux_arm64 machine LinuxArm64AudioPlaybackImports::c_drain(pcm: u64) -> i32
    satisfies LinuxAudioPlaybackIo::c_drain via linux_arm64_drain_binding();
linux_arm64 machine LinuxArm64AudioPlaybackImports::c_close(pcm: u64) -> i32
    satisfies LinuxAudioPlaybackIo::c_close via linux_arm64_close_binding();

linux_arm64 machine LinuxAudioPlayback::play(image: &u8, image_length: u32, pcm: &u8, frames: u32) -> i32
    satisfies AudioPlayback::play
reaches AudioPlayback
{
    transition { _ -> open(pcm, frames) }

    state open(pcm: &u8, frames: u32) -> i32 {
        let name: [u8; 8] = "default\0";
        let mut handle: u64 = 0;
        let rc: i32 = LinuxAudioPlaybackIo::c_open(&mut handle, &name[0], 0, 0);
        transition rc >= 0 { true -> params(handle, pcm, frames) _ -> (rc) }
    }
    state params(handle: u64, pcm: &u8, frames: u32) -> i32 {
        let rc: i32 = LinuxAudioPlaybackIo::c_set_params(handle, 1, 3, 1, 8000, 1, 500000);
        transition rc >= 0 { true -> play_frames(handle, pcm, frames) _ -> close_fail(handle, rc) }
    }
    state play_frames(handle: u64, pcm: &u8, frames: u32) -> i32 {
        let total: u64 = widen_u32_to_u64(frames);
        let done: i64 = block LinuxAudioPlaybackIo::c_writei(handle, pcm, total);
        transition done >= 0 { true -> drain(handle) _ -> close_i64(handle, done) }
    }
    state drain(handle: u64) -> i32 {
        let rc: i32 = block LinuxAudioPlaybackIo::c_drain(handle);
        transition { _ -> close_i32(handle, rc) }
    }
    state close_i32(handle: u64, rc: i32) -> i32 {
        let c: i32 = LinuxAudioPlaybackIo::c_close(handle);
        transition { _ -> (rc) }
    }
    state close_fail(handle: u64, rc: i32) -> i32 {
        let c: i32 = LinuxAudioPlaybackIo::c_close(handle);
        transition { _ -> (rc) }
    }
    state close_i64(handle: u64, code: i64) -> i32 {
        let rc: i32 = narrow_i64_to_i32_wrapping(code);
        let c: i32 = LinuxAudioPlaybackIo::c_close(handle);
        transition { _ -> (rc) }
    }
}
linux_arm64 machine LinuxAudioPlayback::provider_defaults(defaults: &mut LinuxAudioPlayback) {
    LinuxAudioPlayback::select_provider<AudioPlayback, LinuxAudioPlayback>(defaults);
}

// ---- macos_arm64: no CoreAudio provider yet; honest -1 stub ----
// The WAV is still written through WavOutput; playback reports failure.
macos_arm64 machine MacosAudioPlayback::play(image: &u8, image_length: u32, pcm: &u8, frames: u32) -> i32
    satisfies AudioPlayback::play
reaches AudioPlayback
{
    0 - 1
}
macos_arm64 machine MacosAudioPlayback::provider_defaults(defaults: &mut MacosAudioPlayback) {
    MacosAudioPlayback::select_provider<AudioPlayback, MacosAudioPlayback>(defaults);
}
