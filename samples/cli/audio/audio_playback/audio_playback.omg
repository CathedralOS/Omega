    satisfies MacosAudioPlaybackIo::c_copy_to_address via macos_memmove_binding();
macos_arm64 machine MacosAudioPlaybackImports::c_load_pointer(source: u64, destination: &mut u64, count: u64)
    satisfies MacosAudioPlaybackIo::c_load_pointer via macos_bcopy_binding();
