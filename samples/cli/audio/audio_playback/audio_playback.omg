linux_arm64 machine linux_arm64_drain_binding() -> ForeignBinding<14, 13, 8> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libasound.so.2", symbol: "snd_pcm_drain", version: "ALSA_0.9",
