use main.omg as app;

machine build(builder: @mutable Build) {
    Build::application(builder, "wave_file");
    let wav_registration: DependencyRegistration = Build::dependency(builder, dependency\from_source(Source::Path {
        location: "../wav_output"
    }));
    let system_registration: DependencyRegistration = Build::dependency(builder, dependency\from_source(Source::Path {
        location: "../../../../source/library/system"
    }));
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}
