use omega::language::core::filesystem_authority;
// A two-second C-major scale as a canonical 8-bit WAV file: eight square-wave
// notes of 2000 samples (0.25 s) each, rendered into one fixed [u8; 16044]
// buffer — the 44-byte RIFF header followed by 16000 unsigned PCM samples
// (silence 128, high 192, low 64) — and written through the portable
// WavOutput binding to a CWD-relative path on every hosted target. Note
// periods are samples per cycle at 8000 Hz
// (8000/frequency rounded); the period is picked with a value-position match
// on the note index.
// Expected exit: 0 after writing and playback; 1 on write failure, 2 on playback failure.
// Expected output contains: scale_melody: played scale_melody.wav

use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega_language_std::posix_filesystem_host;
use omega_language_std::windows_filesystem_host;
use wav_output::wav_output;
use audio_playback::audio_playback;
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    n: i64;
    rc: i32;
    magnitude: i64;
    digit: i32;
    buffer: [u8; 16044];
    i: i32 in Wrapping;      // sample index 0..16000
    note: i32 in Wrapping;   // note index 0..7
    period: i32 in Wrapping;
    phase: i32 in Wrapping;
    half: i32 in Wrapping;
    byte: u8;
}

machine Main::main(main: &mut Main) reaches Console + WavOutput + AudioPlayback + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + WindowsFilesystemHost + ProcessExit {
    Console::write_line("scale_melody: C-major scale, square wave, 8-bit unsigned mono PCM at 8000 Hz, 2 s");

    // Canonical 44-byte WAV header, little-endian fields.
    main.buffer[0] = 82;  // R
    main.buffer[1] = 73;  // I
    main.buffer[2] = 70;  // F
    main.buffer[3] = 70;  // F
    main.buffer[4] = 164; // 36 + 16000 = 16036 little-endian
    main.buffer[5] = 62;
    main.buffer[6] = 0;
    main.buffer[7] = 0;
    main.buffer[8] = 87;  // W
    main.buffer[9] = 65;  // A
    main.buffer[10] = 86; // V
    main.buffer[11] = 69; // E
    main.buffer[12] = 102; // f
    main.buffer[13] = 109; // m
    main.buffer[14] = 116; // t
    main.buffer[15] = 32;  // <space>
    main.buffer[16] = 16; // fmt chunk size 16
    main.buffer[17] = 0;
    main.buffer[18] = 0;
    main.buffer[19] = 0;
    main.buffer[20] = 1;  // PCM format
    main.buffer[21] = 0;
    main.buffer[22] = 1;  // mono
    main.buffer[23] = 0;
    main.buffer[24] = 64; // sample rate 8000 little-endian
    main.buffer[25] = 31;
    main.buffer[26] = 0;
    main.buffer[27] = 0;
    main.buffer[28] = 64; // byte rate 8000 (mono 8-bit)
    main.buffer[29] = 31;
    main.buffer[30] = 0;
    main.buffer[31] = 0;
    main.buffer[32] = 1;  // block align
    main.buffer[33] = 0;
    main.buffer[34] = 8;  // bits per sample
    main.buffer[35] = 0;
    main.buffer[36] = 100; // d
    main.buffer[37] = 97;  // a
    main.buffer[38] = 116; // t
    main.buffer[39] = 97;  // a
    main.buffer[40] = 128; // data size 16000 little-endian
    main.buffer[41] = 62;
    main.buffer[42] = 0;
    main.buffer[43] = 0;

    main.note = 0;
    transition { _ -> notes(main) }

    state notes(main: &mut Main) {
        transition main.note >= 0 && main.note < 8 { true -> pick(main) _ -> write_file(main) }
    }
    state pick(main: &mut Main) {
        // Samples per cycle for C4..C5 at 8000 Hz.
        main.period = match main.note {
            0 -> 31
            1 -> 27
            2 -> 24
            3 -> 23
            4 -> 20
            5 -> 18
            6 -> 16
            _ -> 15
        };
        main.half = main.period / 2;
        main.i = main.note * 2000;
        transition { _ -> within(main) }
    }
    state within(main: &mut Main) {
        // Note index 0..7 narrows i to 0..15999 one product step at a time.
        transition main.i >= 0 && main.i < 16000 { true -> position(main) _ -> next_note(main) }
    }
    state position(main: &mut Main) {
        // End of the current 2000-sample block for this note.
        main.phase = main.i - main.note * 2000;
        transition main.phase < 2000 && main.period > 0 { true -> sample(main) _ -> next_note(main) }
    }
    state sample(main: &mut Main) {
        main.phase = main.phase % main.period;
        main.byte = match main.phase < main.half { true -> 192 _ -> 64 };
        main.buffer[main.i + 44] = main.byte;
        main.i = main.i + 1;
        transition { _ -> within(main) }
    }
    state next_note(main: &mut Main) {
        main.note = main.note + 1;
        transition { _ -> notes(main) }
    }

    state write_file(main: &mut Main) {
        main.n = WavOutput::write_wav("scale_melody.wav", &main.buffer);
        transition main.n == 16044 { true -> play_it(main) _ -> bad(main) }
    }
    state play_it(main: &mut Main) {
        main.rc = block AudioPlayback::play(&main.buffer[0], 16044, &main.buffer[44], 16000);
        transition main.rc == 0 { true -> good(main) _ -> play_failed(main) }
    }
    state good(main: &mut Main) {
        Console::write_line("scale_melody: wrote scale_melody.wav (16000 frames)");
        Console::write_line("scale_melody: played scale_melody.wav");
        ProcessExit::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("scale_melody: write failed");
        ProcessExit::exit_process(1);
    }
    state play_failed(main: &mut Main) {
        Console::write("scale_melody: playback failed (-");
        main.magnitude = 0 - widen_i32_to_i64(main.rc);
        transition main.magnitude >= 100 { true -> hundreds(main) _ -> tens(main) }
    }
    state hundreds(main: &mut Main) {
        main.digit = narrow_i64_to_i32_wrapping(48 + main.magnitude / 100);
        Console::write_byte(main.digit);
        main.magnitude = main.magnitude % 100;
        transition { _ -> tens_after_hundreds(main) }
    }
    state tens_after_hundreds(main: &mut Main) {
        main.digit = narrow_i64_to_i32_wrapping(48 + main.magnitude / 10);
        Console::write_byte(main.digit);
        transition { _ -> ones(main) }
    }
    state tens(main: &mut Main) {
        transition main.magnitude >= 10 { true -> tens_print(main) _ -> ones(main) }
    }
    state tens_print(main: &mut Main) {
        main.digit = narrow_i64_to_i32_wrapping(48 + main.magnitude / 10);
        Console::write_byte(main.digit);
        transition { _ -> ones(main) }
    }
    state ones(main: &mut Main) {
        main.digit = narrow_i64_to_i32_wrapping(48 + main.magnitude % 10);
        Console::write_byte(main.digit);
        Console::write_line(")");
        ProcessExit::exit_process(2);
    }
}
