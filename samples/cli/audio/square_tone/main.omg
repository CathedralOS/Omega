use {audio_playback}/audio_playback/audio_playback.omg;
use {omega}/language/core/filesystem_authority.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// A 444 Hz square wave rendered as a canonical 8-bit WAV file: one fixed
// [u8; 8044] buffer holds the 44-byte RIFF header followed by 8000 unsigned
// PCM samples (silence 128, high 192, low 64), written once through the
// portable WavOutput binding to a CWD-relative path. The binding routes to
// the target's raw filesystem family (PosixFilesystemHost on linux/macos,
// WindowsFilesystemHost on windows_x86_64), so the sample runs identically
// on every hosted target.
// Expected exit: 0 after writing and playback; 1 on write failure, 2 on playback failure.
// Expected output contains: square_tone: played square_tone.wav

use {system}/filesystem_host.omg as paths;
use {wav_output}/wav_output/wav_output.omg as output;

data Main {
    n: i64;
    rc: i32;
    magnitude: i64;
    digit: i32;
    buffer: [u8; 8044];
    i: i32 in Wrapping;    // sample index 0..8000
    byte: u8;
}

machine render(main: @mutable Main) reaches |process_authority|::StandardOutput + |output|::WavOutput + |audio_playback|::AudioPlayback + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::FilesystemNamespaceMutation + |process_exit|::ProcessExit {
    |console|::Console::write_line("square_tone: 444 Hz square wave, 8-bit unsigned mono PCM at 8000 Hz, 1 s");

    // Canonical 44-byte WAV header, little-endian fields.
    main.buffer[0] = 82;  // R
    main.buffer[1] = 73;  // I
    main.buffer[2] = 70;  // F
    main.buffer[3] = 70;  // F
    main.buffer[4] = 100; // 36 + 8000 = 8036 little-endian
    main.buffer[5] = 31;
    main.buffer[6] = 0;
    main.buffer[7] = 0;
    main.buffer[8] = 87;  // W
    main.buffer[9] = 65;  // A
    main.buffer[10] = 86; // V
    main.buffer[11] = 69; // E
    main.buffer[12] = 102; // f
    main.buffer[13] = 109; // m
    main.buffer[14] = 116; // t
    main.buffer[15] = 32;  // <space>
    main.buffer[16] = 16; // fmt chunk size 16
    main.buffer[17] = 0;
    main.buffer[18] = 0;
    main.buffer[19] = 0;
    main.buffer[20] = 1;  // PCM format
    main.buffer[21] = 0;
    main.buffer[22] = 1;  // mono
    main.buffer[23] = 0;
    main.buffer[24] = 64; // sample rate 8000 little-endian
    main.buffer[25] = 31;
    main.buffer[26] = 0;
    main.buffer[27] = 0;
    main.buffer[28] = 64; // byte rate 8000 (mono 8-bit)
    main.buffer[29] = 31;
    main.buffer[30] = 0;
    main.buffer[31] = 0;
    main.buffer[32] = 1;  // block align
    main.buffer[33] = 0;
    main.buffer[34] = 8;  // bits per sample
    main.buffer[35] = 0;
    main.buffer[36] = 100; // d
    main.buffer[37] = 97;  // a
    main.buffer[38] = 116; // t
    main.buffer[39] = 97;  // a
    main.buffer[40] = 64; // data size 8000 little-endian
    main.buffer[41] = 31;
    main.buffer[42] = 0;
    main.buffer[43] = 0;

    main.i = 0;
    transition { _ -> block fill(main) }

    machine fill(main: @mutable Main) {
        transition main.i >= 0 && main.i < 8000 { true -> block sample(main), _ -> block write_file(main) }
    }
    machine sample(main: @mutable Main) {
        main.byte = match (main.i % 18) < 9 { true -> 192, _ -> 64 };
        main.buffer[main.i + 44] = main.byte;
        main.i = main.i + 1;
        transition { _ -> block fill(main) }
    }

    machine write_file(main: @mutable Main) {
        main.n = block |output|::WavOutput::write_wav("square_tone.wav" as + |paths|::Path, @main.buffer[..]);
        transition main.n == 8044 { true -> block play_it(main), _ -> bad(main) }
    }
    machine play_it(main: @mutable Main) {
        main.rc = block |audio_playback|::AudioPlayback::play(@main.buffer[0], 8044, @main.buffer[44], 8000);
        transition main.rc == 0 { true -> good(main), _ -> play_failed(main) }
    }
    machine good(main: @mutable Main) {
        |console|::Console::write_line("square_tone: wrote square_tone.wav (8000 frames)");
        |console|::Console::write_line("square_tone: played square_tone.wav");
        |process_exit|::ProcessExit::exit_process(0);
    }
    machine bad(main: @mutable Main) {
        |console|::Console::write_line("square_tone: write failed");
        |process_exit|::ProcessExit::exit_process(1);
    }
    // Bounded decimal printer for small negative provider codes (< 1000 in
    // magnitude): prints `playback failed (-NN)` then exits 2. The negate
    // and digits run in widened i64 so i32::MIN cannot overflow.
    machine play_failed(main: @mutable Main) {
        |console|::Console::write("square_tone: playback failed (-");
        main.magnitude = 0 - |numeric_conversion|::widen_i32_to_i64(main.rc);
        transition main.magnitude >= 100 { true -> hundreds(main), _ -> tens(main) }
    }
    machine hundreds(main: @mutable Main) {
        main.digit = |numeric_conversion|::narrow_i64_to_i32_wrapping(48 + main.magnitude / 100);
        |console|::Console::write_byte(main.digit);
        main.magnitude = main.magnitude % 100;
        transition { _ -> tens_after_hundreds(main) }
    }
    machine tens_after_hundreds(main: @mutable Main) {
        main.digit = |numeric_conversion|::narrow_i64_to_i32_wrapping(48 + main.magnitude / 10);
        |console|::Console::write_byte(main.digit);
        transition { _ -> ones(main) }
    }
    machine tens(main: @mutable Main) {
        transition main.magnitude >= 10 { true -> tens_print(main), _ -> ones(main) }
    }
    machine tens_print(main: @mutable Main) {
        main.digit = |numeric_conversion|::narrow_i64_to_i32_wrapping(48 + main.magnitude / 10);
        |console|::Console::write_byte(main.digit);
        transition { _ -> ones(main) }
    }
    machine ones(main: @mutable Main) {
        main.digit = |numeric_conversion|::narrow_i64_to_i32_wrapping(48 + main.magnitude % 10);
        |console|::Console::write_byte(main.digit);
        |console|::Console::write_line(")");
        |process_exit|::ProcessExit::exit_process(2);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_authority|::StandardOutput + |output|::WavOutput + |audio_playback|::AudioPlayback + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::FilesystemNamespaceMutation + |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    block render(@mutable entry_storage);
}
