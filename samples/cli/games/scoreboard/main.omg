// A fixed-capacity table of records: `players: [Player; 3]`, each a struct with an
// `id` and a `score`. Demonstrates array-of-structs storage -- the building block
// for records/tables in serious apps -- via constant-index field writes
// (`main.players[k].score = ...`) and a multi-field read in arithmetic
// (`players[0].score + players[1].score + players[2].score`). The scores 30 + 25 +
// 15 total 70 -- fully Exact: `Player`'s `where` clause bounds `score` to 0..=100,
// so the three-way sum is verifiably bounded (<= 300) and needs no overflow
// domain. (Runtime-index access into such a table needs a bounds proof and is
// exercised elsewhere; this sample uses constant indices.)
// Expected exit: 70.

use omega_language_std::console;
use omega::language::core::binding;

data Player where 0 <= score, score <= 100 {
    id: i32;
    score: i32;
}

data Main {
    console: Binding<Console>;
    players: [Player; 3];
    total: i32;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    main.console.write_line("scoreboard: sums three player records stored in an array of structs");
    main.players[0].id = 1;
    main.players[0].score = 30;
    main.players[1].id = 2;
    main.players[1].score = 25;
    main.players[2].id = 3;
    main.players[2].score = 15;

    main.total = main.players[0].score + main.players[1].score + main.players[2].score;

    transition { _ -> done(main) }

    state done(main: &mut Main) {
        main.console.write_line("PASS: scores 30+25+15 total 70 (the exit code)");
        main.console.write_line("[press Enter to close]");
        _ = block main.console.read_line(&mut main.pause);
        main.console.exit_process(main.total);
    }
}
