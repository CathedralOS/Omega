use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// A fixed-capacity table of records: `players: [Player; 3]`, each a struct with an
// `id` and a `score`. Demonstrates array-of-structs storage -- the building block
// for records/tables in serious apps -- via constant-index field writes
// (`main.players[k].score = ...`) and a multi-field read in arithmetic
// (`players[0].score + players[1].score + players[2].score`). The scores 30 + 25 +
// 15 total 70 -- fully Exact: `Player`'s `where` clause bounds `score` to 0..=100,
// so the three-way sum is verifiably bounded (<= 300) and needs no overflow
// domain. (Runtime-index access into such a table needs a bounds proof and is
// exercised elsewhere; this sample uses constant indices.)
// Expected exit: 70.

use system\Console;

data Player requires 0 <= score, score <= 100 {
    id: i32;
    score: i32;
}

data Main {
    players: [Player; 3];
    total: i32;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("scoreboard: sums three player records stored in an array of structs");
    main.players[0].id = 1;
    main.players[0].score = 30;
    main.players[1].id = 2;
    main.players[1].score = 25;
    main.players[2].id = 3;
    main.players[2].score = 15;

    main.total = main.players[0].score + main.players[1].score + main.players[2].score;

    transition { _ -> block done(main) }

    machine done(main: @mutable Main) {
        Console::write_line("PASS: scores 30+25+15 total 70 (the exit code)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(main.total);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
