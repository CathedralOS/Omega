use main.omg as app;
use {omega}/build/dependency.omg;
use {omega}/language/core/process_authority.omg as streams;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "fixed_timestep" };
    let system: DependencyDescription = |dependency|::from_source(Source::Path {
        location: "../../../../source/library/system"
    });
    let allowed: [BoundaryServiceReference; 1] = [Build::service::<|streams|::StandardOutput>(builder)];
    _ = |dependency|::add(builder, system, @allowed[..]);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_arm64::ProgramEntry, |app|::main);
}
