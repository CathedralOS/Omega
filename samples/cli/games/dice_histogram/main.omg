// A dice-roll frequency chart -- a data-analytics output: roll 60 dice from the xorshift32
// PRNG, tally how often each face 1..6 comes up, and render the distribution as a labeled
// bar chart. Distinct from samples/histogram (which only counts and exits a number) and
// from sort_visualizer (which bars array values): this RENDERS a frequency distribution of
// random data, the kind of chart a real analytics tool emits. Composes the PRNG, a direct
// runtime-indexed read-modify-write tally (`counts[v] = counts[v] + 1`), and the bar-drawing
// render. Deterministic from the seed: the faces tally to 8,13,6,11,11,11.
// Pure compute + stdout, no new features.
// Expected exit: 0.
// Expected output contains: #
use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 24]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    counts: [i32; 6] in Wrapping;
    line: [u8; 24] in Utf8;
    st: u32 in Wrapping;   // xorshift state
    sc: u32 in Wrapping;
    n: i32 in Wrapping;    // roll index
    v: i32 in Wrapping;    // face 0..5
    // render
    val: i32 in Wrapping;  // face 0..5 being drawn
    cnt: i32 in Wrapping;
    k: i32 in Wrapping;
    bo: i32 in Wrapping;   // bar offset
    lab: u8;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("dice_histogram: 60 xorshift32 dice rolls tallied into a labeled bar chart");
    main.counts = [0, 0, 0, 0, 0, 0];
    main.line = "                        ";
    main.st = 1;
    main.n = 0;
    transition { _ -> roll_loop(main) }

    // --- roll 60 dice, tally each face ---
    state roll_loop(main: &mut Main) {
        transition main.n >= 0 && main.n < 60 { true -> roll(main) _ -> draw_init(main) }
    }
    state roll(main: &mut Main) {
        main.sc = main.st << 13;
        main.st = main.st ^ main.sc;
        main.sc = main.st >> 17;
        main.st = main.st ^ main.sc;
        main.sc = main.st << 5;
        main.st = main.st ^ main.sc;
        main.v = (main.st % 6) as i32 in Wrapping;
        transition main.v >= 0 && main.v < 6 { true -> tally(main) _ -> bad(main) }
    }
    state tally(main: &mut Main) {
        // Read-modify-write straight into the runtime-indexed element (`counts[v] += 1`).
        // The face `v` is proven `>= 0 && < 6` by the guard that reaches this state.
        main.counts[main.v] = main.counts[main.v] + 1;
        main.n = main.n + 1;
        transition { _ -> roll_loop(main) }
    }

    // --- render the bar chart, one row per face ---
    state draw_init(main: &mut Main) {
        main.val = 0;
        transition { _ -> draw_loop(main) }
    }
    state draw_loop(main: &mut Main) {
        transition main.val >= 0 && main.val < 6 { true -> draw_row(main) _ -> finish(main) }
    }
    state draw_row(main: &mut Main) {
        // clear, then label "v: " at the start
        main.lab = narrow_i32_to_u8_trapping((main.val + 49) as i32); // '1'..'6'
        main.line = "                        ";
        main.line[0] = main.lab;
        main.line[1] = 58; // ':'
        main.cnt = main.counts[main.val];
        main.k = 0;
        transition { _ -> bar_loop(main) }
    }
    state bar_loop(main: &mut Main) {
        transition main.k >= 0 && main.k < main.cnt { true -> bar_cell(main) _ -> emit_row(main) }
    }
    state bar_cell(main: &mut Main) {
        main.bo = main.k + 3;
        transition main.bo >= 0 && main.bo < 24 { true -> bar_write(main) _ -> emit_row(main) }
    }
    state bar_write(main: &mut Main) {
        main.line[main.bo] = 35; // '#'
        main.k = main.k + 1;
        transition { _ -> bar_loop(main) }
    }
    state emit_row(main: &mut Main) {
        Console::write_line(main.line);
        main.val = main.val + 1;
        transition { _ -> draw_loop(main) }
    }

    state finish(main: &mut Main) {
        Console::write_line("done: all 6 face frequencies charted (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(0);
    }
    state bad(main: &mut Main) {
        Console::write_line("FAIL: a rolled face left the 0..5 range (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(1);
    }
}
