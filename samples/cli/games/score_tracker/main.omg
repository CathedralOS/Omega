// Score tracker. Combines case-payload events, fixed arrays, scalar
// accumulation, [copy] property, and multi-arm case dispatch.
//
// Two players compete. Events: Score(player, points) adds to a player's
// total; Bonus(player) doubles their current score; Reset(player) zeroes it.
//
// Sequence:
//   Score(0, 30)   -> player[0] = 30
//   Score(1, 20)   -> player[1] = 20
//   Bonus(0)       -> player[0] = 60
//   Score(1, 10)   -> player[1] = 30
//   Reset(1)       -> player[1] = 0
//   Score(1, 10)   -> player[1] = 10
//
// Final: player[0]=60, player[1]=10, total=70. Exit 70.
//
// Expected exit: 70.

use omega_language_std::console;

// Events that change player scores.
data Event {
    case Score(player: i32 in Saturating, points: i32 in Saturating);
    case Bonus(player: i32 in Saturating);
    case Reset(player: i32 in Saturating);
}

data Tracker [copy] {
    total: i32 in Saturating;
}

data Main {
    scores: [i32 in Saturating; 2];
    tracker: Tracker;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("score_tracker: replays score/bonus/reset events for two players");
    Main::apply(main, Event::Score { player: 0, points: 30 });
    Main::apply(main, Event::Score { player: 1, points: 20 });
    Main::apply(main, Event::Bonus { player: 0 });
    Main::apply(main, Event::Score { player: 1, points: 10 });
    Main::apply(main, Event::Reset { player: 1 });
    Main::apply(main, Event::Score { player: 1, points: 10 });

    // player[0] = 60, player[1] = 10, total = 70
    main.tracker.total = main.scores[0] + main.scores[1];

    transition main.tracker.total == 70 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: final scores 60 + 10 total 70 (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::write_line("FAIL: event replay total did not equal 70 (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }
}

// Apply one event to the scores array.
machine Main::apply(main: &mut Main, event: Event) {
    transition event {
        Event::Score { player, points } -> add_score(main, player, points)
        Event::Bonus { player } -> double_score(main, player)
        Event::Reset { player } -> reset_score(main, player)
        _ -> done(main)
    }

    state add_score(main: &mut Main, player: i32 in Saturating, points: i32 in Saturating) {
        transition player == 0 {
            true -> add_p0(main, points)
            _ -> add_p1(main, points)
        }
    }

    state add_p0(main: &mut Main, points: i32 in Saturating) {
        main.scores[0] = main.scores[0] + points;
    }

    state add_p1(main: &mut Main, points: i32 in Saturating) {
        main.scores[1] = main.scores[1] + points;
    }

    state double_score(main: &mut Main, player: i32 in Saturating) {
        transition player == 0 {
            true -> double_p0(main)
            _ -> double_p1(main)
        }
    }

    state double_p0(main: &mut Main) {
        main.scores[0] = main.scores[0] * 2;
    }

    state double_p1(main: &mut Main) {
        main.scores[1] = main.scores[1] * 2;
    }

    state reset_score(main: &mut Main, player: i32 in Saturating) {
        transition player == 0 {
            true -> reset_p0(main)
            _ -> reset_p1(main)
        }
    }

    state reset_p0(main: &mut Main) {
        main.scores[0] = 0;
    }

    state reset_p1(main: &mut Main) {
        main.scores[1] = 0;
    }

    state done(main: &mut Main) {
    }
}
