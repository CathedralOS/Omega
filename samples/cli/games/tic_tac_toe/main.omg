// Tic-tac-toe with a scripted move sequence and win detection.
//
// Stresses: [i32; 9] fixed-array indexed read/write with const indices,
// multi-state FSM dispatch, comparison chains over array elements.
//
// Board cells (row-major):
//   0 1 2
//   3 4 5
//   6 7 8
//
// Values: 0 = empty, 1 = X, 2 = O.
//
// Scripted game (X wins top row):
//   X plays 0  -> board[0]=1
//   O plays 3  -> board[3]=2
//   X plays 1  -> board[1]=1
//   O plays 4  -> board[4]=2
//   X plays 2  -> board[2]=1  <- X wins (top row: 0,1,2 all == 1)
//
// Win check: board[0]==1 && board[1]==1 && board[2]==1 -> X wins.
// Encode: winner==1 (X) and move_count==5. exit (1 + 4 + 5)*5 = 10*7 = 70.
// Actually: exit 70 directly.
//
// Expected exit: 70.

use omega_language_std::console;

// A board has at most 9 moves: the `where` bound plus the modular-counter idiom
// keeps the increment Exact-provable with no overflow domain.
data Board [copy] where 0 <= move_count, move_count <= 9 {
    cells: [i32; 9];
    move_count: i32;
    winner: i32;
}

data Main {
    board: Board;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("tic_tac_toe: replays a scripted game where X wins the top row");
    // Scripted moves.
    Main::play(main, 0, 1);  // X plays cell 0
    Main::play(main, 3, 2);  // O plays cell 3
    Main::play(main, 1, 1);  // X plays cell 1
    Main::play(main, 4, 2);  // O plays cell 4
    Main::play(main, 2, 1);  // X plays cell 2 -> X wins

    // Verify move count is 5.
    transition main.board.move_count == 5 {
        true -> check_winner(main)
        _ -> bad_count(main)
    }

    state check_winner(main: &mut Main) {
        // Check top row: cells 0, 1, 2 all == 1 means X won.
        transition main.board.cells[0] == 1 {
            true -> check_row_mid(main)
            _ -> bad_winner(main)
        }
    }

    state check_row_mid(main: &mut Main) {
        transition main.board.cells[1] == 1 {
            true -> check_row_right(main)
            _ -> bad_winner(main)
        }
    }

    state check_row_right(main: &mut Main) {
        transition main.board.cells[2] == 1 {
            true -> check_o_did_not_win(main)
            _ -> bad_winner(main)
        }
    }

    state check_o_did_not_win(main: &mut Main) {
        // Verify O did not somehow win: board[3] and board[4] are O's but
        // board[5] is empty (0), so O's middle row is incomplete.
        transition main.board.cells[5] == 0 {
            true -> good(main)
            _ -> bad_winner(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line("PASS: X owns the top row after 5 moves (exit 70)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(70);
    }

    state bad_count(main: &mut Main) {
        Console::write_line("FAIL: move count was not 5 after the script (exit 71)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(71);
    }

    state bad_winner(main: &mut Main) {
        Console::write_line("FAIL: the board did not show X winning the top row (exit 72)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(72);
    }
}

// Place a piece on the board: cell=which cell, player=1 for X, 2 for O.
machine Main::play(main: &mut Main, cell: i32, player: i32) {
    main.board.move_count = (main.board.move_count + 1) % 10;
    transition cell == 0 {
        true -> set0(main, player)
        _ -> try_cell1(main, cell, player)
    }

    state set0(main: &mut Main, player: i32) {
        main.board.cells[0] = player;
    }

    state try_cell1(main: &mut Main, cell: i32, player: i32) {
        transition cell == 1 {
            true -> set1(main, player)
            _ -> try_cell2(main, cell, player)
        }
    }

    state set1(main: &mut Main, player: i32) {
        main.board.cells[1] = player;
    }

    state try_cell2(main: &mut Main, cell: i32, player: i32) {
        transition cell == 2 {
            true -> set2(main, player)
            _ -> try_cell3(main, cell, player)
        }
    }

    state set2(main: &mut Main, player: i32) {
        main.board.cells[2] = player;
    }

    state try_cell3(main: &mut Main, cell: i32, player: i32) {
        transition cell == 3 {
            true -> set3(main, player)
            _ -> try_cell4(main, cell, player)
        }
    }

    state set3(main: &mut Main, player: i32) {
        main.board.cells[3] = player;
    }

    state try_cell4(main: &mut Main, cell: i32, player: i32) {
        transition cell == 4 {
            true -> set4(main, player)
            _ -> done(main)
        }
    }

    state set4(main: &mut Main, player: i32) {
        main.board.cells[4] = player;
    }

    state done(main: &mut Main) {
    }
}
