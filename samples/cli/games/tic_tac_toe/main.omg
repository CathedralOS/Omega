// Tic-tac-toe with a scripted move sequence and win detection.
//
// Stresses: [i32; 9] fixed-array indexed read/write with const indices,
// multi-state FSM dispatch, comparison chains over array elements.
//
// Board cells (row-major):
//   0 1 2
//   3 4 5
//   6 7 8
//
// Values: 0 = empty, 1 = X, 2 = O.
//
// Scripted game (X wins top row):
//   X plays 0  -> board[0]=1
//   O plays 3  -> board[3]=2
//   X plays 1  -> board[1]=1
//   O plays 4  -> board[4]=2
//   X plays 2  -> board[2]=1  <- X wins (top row: 0,1,2 all == 1)
//
// Win check: board[0]==1 && board[1]==1 && board[2]==1 -> X wins.
// Encode: winner==1 (X) and move_count==5. exit (1 + 4 + 5)*5 = 10*7 = 70.
// Actually: exit 70 directly.
//
// Expected exit: 70.

use omega_language_std::console;

data Board [copy] {
    cells: [i32; 9];
    // A board has at most 9 moves: ranged + the modular-counter idiom keeps the
    // increment Exact-provable with no overflow domain.
    move_count: i32 [0..=9];
    winner: i32;
}

data Main {
    console: Console;
    board: Board;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("tic_tac_toe: replays a scripted game where X wins the top row");
    // Scripted moves.
    self.play(0, 1);  // X plays cell 0
    self.play(3, 2);  // O plays cell 3
    self.play(1, 1);  // X plays cell 1
    self.play(4, 2);  // O plays cell 4
    self.play(2, 1);  // X plays cell 2 -> X wins

    // Verify move count is 5.
    transition self.board.move_count == 5 {
        true -> check_winner()
        _ -> bad_count()
    }

    state check_winner(&mut self) {
        // Check top row: cells 0, 1, 2 all == 1 means X won.
        transition self.board.cells[0] == 1 {
            true -> check_row_mid()
            _ -> bad_winner()
        }
    }

    state check_row_mid(&mut self) {
        transition self.board.cells[1] == 1 {
            true -> check_row_right()
            _ -> bad_winner()
        }
    }

    state check_row_right(&mut self) {
        transition self.board.cells[2] == 1 {
            true -> check_o_did_not_win()
            _ -> bad_winner()
        }
    }

    state check_o_did_not_win(&mut self) {
        // Verify O did not somehow win: board[3] and board[4] are O's but
        // board[5] is empty (0), so O's middle row is incomplete.
        transition self.board.cells[5] == 0 {
            true -> good()
            _ -> bad_winner()
        }
    }

    state good(&mut self) {
        self.console.write_line("PASS: X owns the top row after 5 moves (exit 70)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(70);
    }

    state bad_count(&mut self) {
        self.console.write_line("FAIL: move count was not 5 after the script (exit 71)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(71);
    }

    state bad_winner(&mut self) {
        self.console.write_line("FAIL: the board did not show X winning the top row (exit 72)");
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(72);
    }
}

// Place a piece on the board: cell=which cell, player=1 for X, 2 for O.
machine Main::play(&mut self, cell: i32, player: i32) {
    self.board.move_count = (self.board.move_count + 1) % 10;
    transition cell == 0 {
        true -> set0(player)
        _ -> try_cell1(cell, player)
    }

    state set0(&mut self, player: i32) {
        self.board.cells[0] = player;
    }

    state try_cell1(&mut self, cell: i32, player: i32) {
        transition cell == 1 {
            true -> set1(player)
            _ -> try_cell2(cell, player)
        }
    }

    state set1(&mut self, player: i32) {
        self.board.cells[1] = player;
    }

    state try_cell2(&mut self, cell: i32, player: i32) {
        transition cell == 2 {
            true -> set2(player)
            _ -> try_cell3(cell, player)
        }
    }

    state set2(&mut self, player: i32) {
        self.board.cells[2] = player;
    }

    state try_cell3(&mut self, cell: i32, player: i32) {
        transition cell == 3 {
            true -> set3(player)
            _ -> try_cell4(cell, player)
        }
    }

    state set3(&mut self, player: i32) {
        self.board.cells[3] = player;
    }

    state try_cell4(&mut self, cell: i32, player: i32) {
        transition cell == 4 {
            true -> set4(player)
            _ -> done()
        }
    }

    state set4(&mut self, player: i32) {
        self.board.cells[4] = player;
    }

    state done(&mut self) {
    }
}
