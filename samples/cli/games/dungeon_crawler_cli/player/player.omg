use text::buffer;
use omega_language_std::math;

use inventory::inventory;
use player::player_state;
use rewards::rewards;

data PlayerSystem {
    inventory: InventorySystem;
}

machine PlayerSystem::create(
    player_system: &mut PlayerSystem,
    name: &[u8] in Ascii,
    player: &mut Player
)
requires name.len <= 16
{
    PlayerName::set(&mut player.name, name);
    player.level = 1;
    player.xp = 0;
    player.max_health = 30;
    player.health = player.max_health;
    player.attack = 4;
    player.defense = 1;
    InventorySystem::clear(&mut player.inventory);
}

machine PlayerSystem::heal(player: &mut Player,
    amount: i32 in Wrapping) {
    player.health = min_i32(player.max_health as i32, (player.health + amount) as i32) as i32 in Wrapping;
}

machine PlayerSystem::take_damage(player: &mut Player,
    amount: i32 in Wrapping) {
    let prevented: i32 in Wrapping = min_i32(amount as i32, player.defense as i32) as i32 in Wrapping;
    let actual: i32 in Wrapping = amount - prevented;
    player.health = max_i32(0, (player.health - actual) as i32) as i32 in Wrapping;
}

machine PlayerSystem::grant_reward(
    player_system: &mut PlayerSystem,
    player: &mut Player,
    reward: Reward
) {
    InventorySystem::add_reward(&mut player_system.inventory, &mut player.inventory, reward);
}

machine PlayerSystem::grant_xp(
    player_system: &mut PlayerSystem,
    player: &mut Player,
    amount: u32 in Wrapping
) {
    player.xp = player.xp + amount;

    transition player.xp >= PlayerSystem::xp_required(player.level) {
        true -> level_up(player_system, player)
        false -> {}
    }


    state level_up(
        player_system: &mut PlayerSystem,
        player: &mut Player
    ) {
        player.xp = max_u32(0, (player.xp - (PlayerSystem::xp_required(player.level) as u32 in Wrapping)) as u32) as u32 in Wrapping;
        player.level = player.level + 1;
        player.max_health = player.max_health + 5;
        player.attack = player.attack + 1;
        player.health = player.max_health;

        transition player.xp >= PlayerSystem::xp_required(player.level) {
            true -> level_up(player_system, player)
            false -> {}
        }
    }
}

machine PlayerSystem::xp_required(level: u32 in Wrapping) -> u32 {
    transition {
        _ -> ((10 + level * 5) as u32)
    }
}

machine PlayerName::copy(buffer: &mut [u8; 16] in Ascii, bytes: &[u8] in Ascii, start: u64)
requires start <= 16; bytes.len <= 16 - start
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    state copying(buffer: &mut [u8; 16] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 16; index <= 16
    {
        transition index < bytes.len && start + index < 16 {
            true -> writing(buffer, bytes, start, index)
            _ -> done()
        }
    }
    state writing(buffer: &mut [u8; 16] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 16; index < 16; index < bytes.len; start + index < 16
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    state done() {}
}

machine PlayerName::set(buffer: &mut PlayerName, bytes: &[u8] in Ascii)
requires bytes.len <= 16
{
    PlayerName::copy(&mut buffer.storage, bytes, 0);
    buffer.used = bytes.len;
}
