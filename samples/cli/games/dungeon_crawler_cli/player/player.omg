use text;
use inventory\InventorySystem;
use inventory\add_reward;
use inventory\clear;
use rewards\Reward;
use omega\language\core\max_i32;
use omega\language\core\max_u32;
use omega\language\core\min_i32;


data PlayerSystem {
    inventory: InventorySystem;
}

machine create(
    player_system: @mutable PlayerSystem,
    name: @[u8] in Ascii,
    player: @mutable Player
)
requires name.length <= 16
{
    player_name_set(@mutable player.name, name);
    player.level = 1u32 as +Wrapping;
    player.xp = 0u32 as +Wrapping;
    player.max_health = 30i32 as +Wrapping;
    player.health = player.max_health;
    player.attack = 4i32 as +Wrapping;
    player.defense = 1i32 as +Wrapping;
    clear(@mutable player.inventory);
}

machine heal(player: @mutable Player,
    amount: i32 in Wrapping) {
    player.health = min_i32(player.max_health as i32, (player.health + amount) as i32) as i32 +Wrapping;
}

machine take_damage(player: @mutable Player,
    amount: i32 in Wrapping) {
    let prevented: i32 in Wrapping = min_i32(amount as i32, player.defense as i32) as i32 +Wrapping;
    let actual: i32 in Wrapping = amount - prevented;
    player.health = max_i32(0, (player.health - actual) as i32) as i32 +Wrapping;
}

machine grant_reward(
    player_system: @mutable PlayerSystem,
    player: @mutable Player,
    reward: Reward
) {
    add_reward(@mutable player_system.inventory, @mutable player.inventory, reward);
}

machine grant_xp(
    player_system: @mutable PlayerSystem,
    player: @mutable Player,
    amount: u32 in Wrapping
) {
    player.xp = player.xp + amount;

    transition player.xp >= xp_required(player.level) {
        true -> level_up(player_system, player),
        false -> {}
    }


    machine level_up(
        player_system: @mutable PlayerSystem,
        player: @mutable Player
    ) {
        player.xp = max_u32(0, (player.xp - (xp_required(player.level) as u32 +Wrapping)) as u32) as u32 +Wrapping;
        player.level = player.level + 1;
        player.max_health = player.max_health + 5;
        player.attack = player.attack + 1;
        player.health = player.max_health;

        transition player.xp >= xp_required(player.level) {
            true -> level_up(player_system, player),
            false -> {}
        }
    }
}

machine xp_required(level: u32 in Wrapping) -> u32 {
    transition {
        _ -> ((10 + level * 5) as u32)
    }
}

machine player_name_copy(buffer: @mutable [u8; 16] in Ascii, bytes: @[u8] in Ascii, start: u64)
requires start <= 16, bytes.length <= 16 - start
ensures buffer in Ascii
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    machine copying(buffer: @mutable [u8; 16] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 16, index <= 16
    ensures buffer in Ascii
    {
        transition index < bytes.length && start + index < 16 {
            true -> writing(buffer, bytes, start, index),
            _ -> done()
        }
    }
    machine writing(buffer: @mutable [u8; 16] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 16, index < 16, index < bytes.length, start + index < 16
    ensures buffer in Ascii
    {
        (@mutable buffer as -Ascii)[start + index] = (bytes as -Ascii)[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    machine done() {}
}

machine player_name_set(buffer: @mutable PlayerName, bytes: @[u8] in Ascii)
requires bytes.length <= 16
{
    player_name_copy(@mutable buffer.storage, bytes, 0);
    buffer.used = bytes.length;
}
