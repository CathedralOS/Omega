use inventory/inventory.omg;
use player/player_state.omg;
use rewards/rewards.omg;
use text/buffer.omg;
use {omega}/language/core/math.omg;

data PlayerSystem {
    inventory: |inventory|::InventorySystem;
}

machine create(
    player_system: @mutable PlayerSystem,
    name: @[u8] in |buffer|::Ascii,
    player: @mutable |player_state|::Player
)
requires name.length <= 16
{
    player_name_set(@mutable player.name, name);
    player.level = 1u32 as +Wrapping;
    player.xp = 0u32 as +Wrapping;
    player.max_health = 30i32 as +Wrapping;
    player.health = player.max_health;
    player.attack = 4i32 as +Wrapping;
    player.defense = 1i32 as +Wrapping;
    |inventory|::clear(@mutable player.inventory);
}

machine heal(player: @mutable |player_state|::Player,
    amount: i32 in Wrapping) {
    player.health = |math|::min_i32(player.max_health as i32, (player.health + amount) as i32) as i32 +Wrapping;
}

machine take_damage(player: @mutable |player_state|::Player,
    amount: i32 in Wrapping) {
    let prevented: i32 in Wrapping = |math|::min_i32(amount as i32, player.defense as i32) as i32 +Wrapping;
    let actual: i32 in Wrapping = amount - prevented;
    player.health = |math|::max_i32(0, (player.health - actual) as i32) as i32 +Wrapping;
}

machine grant_reward(
    player_system: @mutable PlayerSystem,
    player: @mutable |player_state|::Player,
    reward: |rewards|::Reward
) {
    |inventory|::add_reward(@mutable player_system.inventory, @mutable player.inventory, reward);
}

machine grant_xp(
    player_system: @mutable PlayerSystem,
    player: @mutable |player_state|::Player,
    amount: u32 in Wrapping
) {
    player.xp = player.xp + amount;

    transition player.xp >= xp_required(player.level) {
        true -> level_up(player_system, player),
        false -> {}
    }


    machine level_up(
        player_system: @mutable PlayerSystem,
        player: @mutable |player_state|::Player
    ) {
        player.xp = |math|::max_u32(0, (player.xp - (xp_required(player.level) as u32 +Wrapping)) as u32) as u32 +Wrapping;
        player.level = player.level + 1;
        player.max_health = player.max_health + 5;
        player.attack = player.attack + 1;
        player.health = player.max_health;

        transition player.xp >= xp_required(player.level) {
            true -> level_up(player_system, player),
            false -> {}
        }
    }
}

machine xp_required(level: u32 in Wrapping) -> u32 {
    transition {
        _ -> ((10 + level * 5) as u32)
    }
}

machine player_name_copy(buffer: @mutable [u8; 16] in |buffer|::Ascii, bytes: @[u8] in |buffer|::Ascii, start: u64)
requires start <= 16, bytes.length <= 16 - start
ensures buffer in |buffer|::Ascii
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    machine copying(buffer: @mutable [u8; 16] in |buffer|::Ascii, bytes: @[u8] in |buffer|::Ascii, start: u64, index: u64)
    requires start <= 16, index <= 16
    ensures buffer in |buffer|::Ascii
    {
        transition index < bytes.length && start + index < 16 {
            true -> writing(buffer, bytes, start, index),
            _ -> done()
        }
    }
    machine writing(buffer: @mutable [u8; 16] in |buffer|::Ascii, bytes: @[u8] in |buffer|::Ascii, start: u64, index: u64)
    requires start <= 16, index < 16, index < bytes.length, start + index < 16
    ensures buffer in |buffer|::Ascii
    {
        (@mutable buffer as - |buffer|::Ascii)[start + index] = (bytes as - |buffer|::Ascii)[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    machine done() {}
}

machine player_name_set(buffer: @mutable |player_state|::PlayerName, bytes: @[u8] in |buffer|::Ascii)
requires bytes.length <= 16
{
    player_name_copy(@mutable buffer.storage, bytes, 0);
    buffer.used = bytes.length;
}
