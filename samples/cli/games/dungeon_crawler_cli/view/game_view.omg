use omega\language\core\StandardOutput;
use text;
use player\Player;
use rooms\CellId;
use rooms\Level;
use rooms\RoomFormatter;
use rooms\write_character;
use rooms\write_current_cell;
use rooms\write_inventory;
use rooms\write_room_info;
use text\TextBuffer;
use text\text_buffer_live;
use text\text_buffer_set;
use system\Console;

data GameView {
    formatter: RoomFormatter;
}

machine render_title() reaches StandardOutput {
    Console::write_line("###########################");
    Console::write_line("#     Dungeon Crawler     #");
    Console::write_line("###########################");
    Console::write_line("");
    Console::write_line("A tiny generated crawl for compiler stress.");
    Console::write_line("Type help if you need a command reminder.");
    Console::write_line("");
}

machine render_commands() reaches StandardOutput {
    Console::write_line("[Commands] look | help | inv | char | use | fight | exit");
}

machine render_room(
    game_view: @mutable GameView,
    level: Level,
    cell: CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    line: @mutable TextBuffer
)
reaches StandardOutput
{
    write_current_cell(level, cell, line);
    render_line(line);
    write_room_info(@mutable game_view.formatter, level, cell, line);
    render_line(line);
    write_cell_event(cell, treasure_taken, gold_taken, fountain_used, enemy_defeated, line);
    render_line(line);
    write_cell_paths(cell, line);
    render_line(line);
}

machine render_look(
    game_view: @mutable GameView,
    level: Level,
    cell: CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    line: @mutable TextBuffer
)
reaches StandardOutput
{
    write_room_info(@mutable game_view.formatter, level, cell, line);
    render_line(line);
    write_cell_event(cell, treasure_taken, gold_taken, fountain_used, enemy_defeated, line);
    render_line(line);
}

machine render_exits(
    game_view: @mutable GameView,
    level: Level,
    cell: CellId,
    line: @mutable TextBuffer
)
reaches StandardOutput
{
    write_cell_paths(cell, line);
    render_line(line);
}

// Output writers retain the caller's Utf8 invariant while replacing the
// whole buffer.
machine write_cell_event(cell: CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    out_line: @mutable TextBuffer)
{
    transition cell {
        CellId::R02 -> maybe_treasure_event(treasure_taken, out_line),
        CellId::R03 -> maybe_enemy_event(enemy_defeated, out_line),
        CellId::R04 -> maybe_fountain_event(fountain_used, out_line),
        CellId::R05 -> maybe_gold_event(gold_taken, out_line),
        _ -> quiet_event(out_line)
    }

    machine maybe_treasure_event(treasure_taken: bool,
        out_line: @mutable TextBuffer) {
        transition treasure_taken {
            false -> treasure_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine maybe_enemy_event(enemy_defeated: bool,
        out_line: @mutable TextBuffer) {
        transition enemy_defeated {
            false -> enemy_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine maybe_fountain_event(fountain_used: bool,
        out_line: @mutable TextBuffer) {
        transition fountain_used {
            false -> fountain_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine maybe_gold_event(gold_taken: bool,
        out_line: @mutable TextBuffer) {
        transition gold_taken {
            false -> gold_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine treasure_event(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "A treasure cache rests against the wall. Type use to claim it." as +Ascii);
    }

    machine enemy_event(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "A dungeon bat blocks the way. Type fight." as +Ascii);
    }

    machine fountain_event(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "A fountain of life glows here. Type use to drink." as +Ascii);
    }

    machine gold_event(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "Loose gold glitters in the dust. Type use to collect it." as +Ascii);
    }

    machine quiet_event(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "The room is quiet." as +Ascii);
    }
}

machine write_cell_paths(cell: CellId,
    out_line: @mutable TextBuffer)
{
    transition cell {
        CellId::R00 -> gate_paths(out_line),
        CellId::R01 -> room_one_paths(out_line),
        CellId::R02 -> room_two_paths(out_line),
        CellId::R03 -> room_three_paths(out_line),
        CellId::R04 -> room_four_paths(out_line),
        CellId::R05 -> side_west_paths(out_line),
        CellId::R06 -> side_east_paths(out_line),
        CellId::R07 -> side_west_paths(out_line),
        _ -> no_paths(out_line)
    }

    machine gate_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] north" as +Ascii);
    }

    machine room_one_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] south | north | east" as +Ascii);
    }

    machine room_two_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] south | north | west" as +Ascii);
    }

    machine room_three_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] south | north | east" as +Ascii);
    }

    machine room_four_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] south" as +Ascii);
    }

    machine side_west_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] west" as +Ascii);
    }

    machine side_east_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] east" as +Ascii);
    }

    machine no_paths(out_line: @mutable TextBuffer) {
        text_buffer_set(out_line, "[Paths] none" as +Ascii);
    }
}

machine render_inventory(
    game_view: @mutable GameView,
    player: Player,
    line: @mutable TextBuffer
)
reaches StandardOutput
{
    write_inventory(player, line);
    render_line(line);
}

machine render_character(
    game_view: @mutable GameView,
    player: Player,
    line: @mutable TextBuffer
)
reaches StandardOutput
{
    write_character(player, line);
    render_line(line);
}

machine render_prompt() reaches StandardOutput {
    Console::write("> ");
}

machine render_line(line: @TextBuffer) reaches StandardOutput {
    let bytes: @[u8] in Ascii = text_buffer_live(line);
    Console::write_line(bytes as -Ascii);
}

machine render_invalid_command() reaches StandardOutput {
    Console::write_line("[Input] That action is not available right now.");
}

machine render_game_over() reaches StandardOutput {
    Console::write_line("Game over.");
}

machine render_goodbye() reaches StandardOutput {
    Console::write_line("Goodbye.");
}
