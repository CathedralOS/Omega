use platform::console;
use player::player_state;
use rooms::map;
use rooms::rooms;
use rooms::room_formatter;

data GameView {
    formatter: RoomFormatter;
}

machine GameView::render_title(
    &mut self,
    console: &mut Console
) {
    console.write_line("###########################");
    console.write_line("#     Dungeon Crawler     #");
    console.write_line("###########################");
    console.write_line("");
    console.write_line("A tiny generated crawl for compiler stress.");
    console.write_line("Type help if you need a command reminder.");
    console.write_line("");
}

machine GameView::render_commands(
    &mut self,
    console: &mut Console
) {
    console.write_line("[Commands] look | help | inv | char | use | fight | exit");
}

machine GameView::render_room(
    &mut self,
    level: Level,
    cell: CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    console: &mut Console,
    line: &mut [u8; 128]
)
ensures line in Utf8
{
    self.formatter.write_current_cell(level, cell, line);
    console.write_line(line);
    self.formatter.write_room_info(level, cell, line);
    console.write_line(line);
    self.write_cell_event(cell, treasure_taken, gold_taken, fountain_used, enemy_defeated, line);
    console.write_line(line);
    self.write_cell_paths(cell, line);
    console.write_line(line);
}

machine GameView::render_look(
    &mut self,
    level: Level,
    cell: CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    console: &mut Console,
    line: &mut [u8; 128]
)
ensures line in Utf8
{
    self.formatter.write_room_info(level, cell, line);
    console.write_line(line);
    self.write_cell_event(cell, treasure_taken, gold_taken, fountain_used, enemy_defeated, line);
    console.write_line(line);
}

machine GameView::render_exits(
    &mut self,
    level: Level,
    cell: CellId,
    console: &mut Console,
    line: &mut [u8; 128]
)
ensures line in Utf8
{
    self.write_cell_paths(cell, line);
    console.write_line(line);
}

// Output writers establish Utf8 after replacement without requiring the old
// buffer contents to satisfy it.
machine GameView::write_cell_event(
    &mut self,
    cell: CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    out_line: &mut [u8; 128]
)
ensures out_line in Utf8
{
    transition cell {
        CellId::R02 -> maybe_treasure_event(treasure_taken, out_line)
        CellId::R03 -> maybe_enemy_event(enemy_defeated, out_line)
        CellId::R04 -> maybe_fountain_event(fountain_used, out_line)
        CellId::R05 -> maybe_gold_event(gold_taken, out_line)
        _ -> quiet_event(out_line)
    }

    state maybe_treasure_event(
        &mut self,
        treasure_taken: bool,
        out_line: &mut [u8; 128]
    ) {
        transition treasure_taken {
            false -> treasure_event(out_line)
            true -> quiet_event(out_line)
        }
    }

    state maybe_enemy_event(
        &mut self,
        enemy_defeated: bool,
        out_line: &mut [u8; 128]
    ) {
        transition enemy_defeated {
            false -> enemy_event(out_line)
            true -> quiet_event(out_line)
        }
    }

    state maybe_fountain_event(
        &mut self,
        fountain_used: bool,
        out_line: &mut [u8; 128]
    ) {
        transition fountain_used {
            false -> fountain_event(out_line)
            true -> quiet_event(out_line)
        }
    }

    state maybe_gold_event(
        &mut self,
        gold_taken: bool,
        out_line: &mut [u8; 128]
    ) {
        transition gold_taken {
            false -> gold_event(out_line)
            true -> quiet_event(out_line)
        }
    }

    state treasure_event(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "A treasure cache rests against the wall. Type use to claim it.";
    }

    state enemy_event(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "A dungeon bat blocks the way. Type fight.";
    }

    state fountain_event(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "A fountain of life glows here. Type use to drink.";
    }

    state gold_event(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "Loose gold glitters in the dust. Type use to collect it.";
    }

    state quiet_event(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "The room is quiet.";
    }
}

machine GameView::write_cell_paths(
    &mut self,
    cell: CellId,
    out_line: &mut [u8; 128]
)
ensures out_line in Utf8
{
    transition cell {
        CellId::R00 -> gate_paths(out_line)
        CellId::R01 -> room_one_paths(out_line)
        CellId::R02 -> room_two_paths(out_line)
        CellId::R03 -> room_three_paths(out_line)
        CellId::R04 -> room_four_paths(out_line)
        CellId::R05 -> side_west_paths(out_line)
        CellId::R06 -> side_east_paths(out_line)
        CellId::R07 -> side_west_paths(out_line)
        _ -> no_paths(out_line)
    }

    state gate_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] north";
    }

    state room_one_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] south | north | east";
    }

    state room_two_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] south | north | west";
    }

    state room_three_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] south | north | east";
    }

    state room_four_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] south";
    }

    state side_west_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] west";
    }

    state side_east_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] east";
    }

    state no_paths(
        &mut self,
        out_line: &mut [u8; 128]
    ) {
        out_line = "[Paths] none";
    }
}

machine GameView::render_inventory(
    &mut self,
    player: Player,
    console: &mut Console,
    line: &mut [u8; 128]
)
ensures line in Utf8
{
    self.formatter.write_inventory(player, line);
    console.write_line(line);
}

machine GameView::render_character(
    &mut self,
    player: Player,
    console: &mut Console,
    line: &mut [u8; 128]
)
ensures line in Utf8
{
    self.formatter.write_character(player, line);
    console.write_line(line);
}

machine GameView::render_prompt(
    &mut self,
    console: &mut Console
) {
    console.write("> ");
}

machine GameView::render_line(
    &mut self,
    line: [u8; 128] in Utf8,
    console: &mut Console
) {
    console.write_line(line);
}

machine GameView::render_invalid_command(
    &mut self,
    console: &mut Console
) {
    console.write_line("[Input] That action is not available right now.");
}

machine GameView::render_game_over(
    &mut self,
    console: &mut Console
) {
    console.write_line("Game over.");
}

machine GameView::render_goodbye(
    &mut self,
    console: &mut Console
) {
    console.write_line("Goodbye.");
}
