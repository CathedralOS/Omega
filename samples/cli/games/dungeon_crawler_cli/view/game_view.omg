use player/player_state.omg;
use rooms/map.omg;
use rooms/room_formatter.omg;
use rooms/rooms.omg;
use text/buffer.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

data GameView {
    formatter: |room_formatter|::RoomFormatter;
}

machine render_title() reaches |process_authority|::StandardOutput {
    |console|::Console::write_line("###########################");
    |console|::Console::write_line("#     Dungeon Crawler     #");
    |console|::Console::write_line("###########################");
    |console|::Console::write_line("");
    |console|::Console::write_line("A tiny generated crawl for compiler stress.");
    |console|::Console::write_line("Type help if you need a command reminder.");
    |console|::Console::write_line("");
}

machine render_commands() reaches |process_authority|::StandardOutput {
    |console|::Console::write_line("[Commands] look | help | inv | char | use | fight | exit");
}

machine render_room(
    game_view: @mutable GameView,
    level: |rooms|::Level,
    cell: |map|::CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    line: @mutable |buffer|::TextBuffer
)
reaches |process_authority|::StandardOutput
{
    |room_formatter|::write_current_cell(level, cell, line);
    render_line(line);
    |room_formatter|::write_room_info(@mutable game_view.formatter, level, cell, line);
    render_line(line);
    write_cell_event(cell, treasure_taken, gold_taken, fountain_used, enemy_defeated, line);
    render_line(line);
    write_cell_paths(cell, line);
    render_line(line);
}

machine render_look(
    game_view: @mutable GameView,
    level: |rooms|::Level,
    cell: |map|::CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    line: @mutable |buffer|::TextBuffer
)
reaches |process_authority|::StandardOutput
{
    |room_formatter|::write_room_info(@mutable game_view.formatter, level, cell, line);
    render_line(line);
    write_cell_event(cell, treasure_taken, gold_taken, fountain_used, enemy_defeated, line);
    render_line(line);
}

machine render_exits(
    game_view: @mutable GameView,
    level: |rooms|::Level,
    cell: |map|::CellId,
    line: @mutable |buffer|::TextBuffer
)
reaches |process_authority|::StandardOutput
{
    write_cell_paths(cell, line);
    render_line(line);
}

// Output writers retain the caller's Utf8 invariant while replacing the
// whole buffer.
machine write_cell_event(cell: |map|::CellId,
    treasure_taken: bool,
    gold_taken: bool,
    fountain_used: bool,
    enemy_defeated: bool,
    out_line: @mutable |buffer|::TextBuffer)
{
    transition cell {
        |map|::CellId::R02 -> maybe_treasure_event(treasure_taken, out_line),
        |map|::CellId::R03 -> maybe_enemy_event(enemy_defeated, out_line),
        |map|::CellId::R04 -> maybe_fountain_event(fountain_used, out_line),
        |map|::CellId::R05 -> maybe_gold_event(gold_taken, out_line),
        _ -> quiet_event(out_line)
    }

    machine maybe_treasure_event(treasure_taken: bool,
        out_line: @mutable |buffer|::TextBuffer) {
        transition treasure_taken {
            false -> treasure_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine maybe_enemy_event(enemy_defeated: bool,
        out_line: @mutable |buffer|::TextBuffer) {
        transition enemy_defeated {
            false -> enemy_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine maybe_fountain_event(fountain_used: bool,
        out_line: @mutable |buffer|::TextBuffer) {
        transition fountain_used {
            false -> fountain_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine maybe_gold_event(gold_taken: bool,
        out_line: @mutable |buffer|::TextBuffer) {
        transition gold_taken {
            false -> gold_event(out_line),
            true -> quiet_event(out_line)
        }
    }

    machine treasure_event(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "A treasure cache rests against the wall. Type use to claim it." as + |buffer|::Ascii);
    }

    machine enemy_event(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "A dungeon bat blocks the way. Type fight." as + |buffer|::Ascii);
    }

    machine fountain_event(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "A fountain of life glows here. Type use to drink." as + |buffer|::Ascii);
    }

    machine gold_event(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "Loose gold glitters in the dust. Type use to collect it." as + |buffer|::Ascii);
    }

    machine quiet_event(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "The room is quiet." as + |buffer|::Ascii);
    }
}

machine write_cell_paths(cell: |map|::CellId,
    out_line: @mutable |buffer|::TextBuffer)
{
    transition cell {
        |map|::CellId::R00 -> gate_paths(out_line),
        |map|::CellId::R01 -> room_one_paths(out_line),
        |map|::CellId::R02 -> room_two_paths(out_line),
        |map|::CellId::R03 -> room_three_paths(out_line),
        |map|::CellId::R04 -> room_four_paths(out_line),
        |map|::CellId::R05 -> side_west_paths(out_line),
        |map|::CellId::R06 -> side_east_paths(out_line),
        |map|::CellId::R07 -> side_west_paths(out_line),
        _ -> no_paths(out_line)
    }

    machine gate_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] north" as + |buffer|::Ascii);
    }

    machine room_one_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] south | north | east" as + |buffer|::Ascii);
    }

    machine room_two_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] south | north | west" as + |buffer|::Ascii);
    }

    machine room_three_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] south | north | east" as + |buffer|::Ascii);
    }

    machine room_four_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] south" as + |buffer|::Ascii);
    }

    machine side_west_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] west" as + |buffer|::Ascii);
    }

    machine side_east_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] east" as + |buffer|::Ascii);
    }

    machine no_paths(out_line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(out_line, "[Paths] none" as + |buffer|::Ascii);
    }
}

machine render_inventory(
    game_view: @mutable GameView,
    player: |player_state|::Player,
    line: @mutable |buffer|::TextBuffer
)
reaches |process_authority|::StandardOutput
{
    |room_formatter|::write_inventory(player, line);
    render_line(line);
}

machine render_character(
    game_view: @mutable GameView,
    player: |player_state|::Player,
    line: @mutable |buffer|::TextBuffer
)
reaches |process_authority|::StandardOutput
{
    |room_formatter|::write_character(player, line);
    render_line(line);
}

machine render_prompt() reaches |process_authority|::StandardOutput {
    |console|::Console::write("> ");
}

machine render_line(line: @|buffer|::TextBuffer) reaches |process_authority|::StandardOutput {
    let bytes: @[u8] in |buffer|::Ascii = |buffer|::text_buffer_live(line);
    |console|::Console::write_line(bytes as - |buffer|::Ascii);
}

machine render_invalid_command() reaches |process_authority|::StandardOutput {
    |console|::Console::write_line("[Input] That action is not available right now.");
}

machine render_game_over() reaches |process_authority|::StandardOutput {
    |console|::Console::write_line("Game over.");
}

machine render_goodbye() reaches |process_authority|::StandardOutput {
    |console|::Console::write_line("Goodbye.");
}
