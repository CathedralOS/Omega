use omega::language::core::max_i32;

use combat::combat_round;
use events::events;
use player::player;
use player::player_state;
use rewards::reward_tables;
use rewards::rewards;
use rng::random;
use rng::random_state;

data CombatSystem {
    player_system: PlayerSystem;
    rewards: RewardTables;
    rng: Random;
}

machine combat_system_fight(
    combat_system: &mut CombatSystem,
    player: &mut Player,
    event: &mut RoomEvent,
    random: &mut RandomState,
    round: &mut CombatRound
) {
    round.player_damage = max_i32(0, (player.attack - event.enemy.defense + ((range(&mut combat_system.rng, random, 3) as i32) as i32 in Wrapping)) as i32) as i32 in Wrapping;
    event.enemy.health = max_i32(0, (event.enemy.health - round.player_damage) as i32) as i32 in Wrapping;
    round.enemy_defeated = event.enemy.health == 0;

    transition round.enemy_defeated {
        true -> defeated_enemy(combat_system, player, event, random, round)
        false -> enemy_retaliates(combat_system, player, event, random, round)
    }


    machine defeated_enemy(
        combat_system: &mut CombatSystem,
        player: &mut Player,
        event: &mut RoomEvent,
        random: &mut RandomState,
        round: &mut CombatRound
    ) {
        let mut reward: Reward;
        roll_enemy_reward(&mut combat_system.rewards, event.enemy, random, &mut reward);
        grant_reward(&mut combat_system.player_system, player, reward);
        grant_xp(&mut combat_system.player_system, player, event.enemy.xp_reward);

        event.reward = reward;
        event.consumed = true;
        round.enemy_damage = 0;
        round.player_defeated = false;
    }

    machine enemy_retaliates(
        combat_system: &mut CombatSystem,
        player: &mut Player,
        event: &mut RoomEvent,
        random: &mut RandomState,
        round: &mut CombatRound
    ) {
        round.enemy_damage = max_i32(0, (event.enemy.attack - player.defense + ((range(&mut combat_system.rng, random, 3) as i32) as i32 in Wrapping)) as i32) as i32 in Wrapping;
        take_damage(player, round.enemy_damage);
        round.player_defeated = player.health == 0;
    }
}
