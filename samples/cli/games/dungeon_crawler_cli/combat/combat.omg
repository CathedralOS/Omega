use combat::combat_round;
use events::events;
use player::player;
use player::player_state;
use rewards::reward_tables;
use rewards::rewards;
use rng::random;
use rng::random_state;

data CombatSystem {
    player_system: PlayerSystem;
    rewards: RewardTables;
    rng: Random;
}

machine CombatSystem::fight(
    combat_system: &mut CombatSystem,
    player: &mut Player,
    event: &mut RoomEvent,
    random: &mut RandomState,
    round: &mut CombatRound
) {
    round.player_damage = max(0, player.attack - event.enemy.defense + ((Random::range(&mut combat_system.rng, random, 3) as i32) as i32 in Wrapping));
    event.enemy.health = max(0, event.enemy.health - round.player_damage);
    round.enemy_defeated = event.enemy.health == 0;

    transition round.enemy_defeated {
        true -> defeated_enemy(combat_system, player, event, random, round)
        false -> enemy_retaliates(combat_system, player, event, random, round)
    }


    state defeated_enemy(
        combat_system: &mut CombatSystem,
        player: &mut Player,
        event: &mut RoomEvent,
        random: &mut RandomState,
        round: &mut CombatRound
    ) {
        let reward: Reward;
        RewardTables::roll_enemy_reward(&mut combat_system.rewards, event.enemy, random, &mut reward);
        PlayerSystem::grant_reward(&mut combat_system.player_system, player, reward);
        PlayerSystem::grant_xp(&mut combat_system.player_system, player, event.enemy.xp_reward);

        event.reward = reward;
        event.consumed = true;
        round.enemy_damage = 0;
        round.player_defeated = false;
    }

    state enemy_retaliates(
        combat_system: &mut CombatSystem,
        player: &mut Player,
        event: &mut RoomEvent,
        random: &mut RandomState,
        round: &mut CombatRound
    ) {
        round.enemy_damage = max(0, event.enemy.attack - player.defense + ((Random::range(&mut combat_system.rng, random, 3) as i32) as i32 in Wrapping));
        PlayerSystem::take_damage(player, round.enemy_damage);
        round.player_defeated = player.health == 0;
    }
}
