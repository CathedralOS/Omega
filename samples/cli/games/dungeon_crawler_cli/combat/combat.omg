use events\RoomEvent;
use player\Player;
use player\PlayerSystem;
use player\grant_reward;
use player\grant_xp;
use player\take_damage;
use rewards\Reward;
use rewards\RewardTables;
use rewards\roll_enemy_reward;
use rng\Random;
use rng\RandomState;
use rng\range;
use omega\language\core\max_i32;


data CombatSystem {
    player_system: PlayerSystem;
    rewards: RewardTables;
    rng: Random;
}

machine combat_system_fight(
    combat_system: @mutable CombatSystem,
    player: @mutable Player,
    event: @mutable RoomEvent,
    random: @mutable RandomState,
    round: @mutable CombatRound
) {
    round.player_damage = max_i32(0, (player.attack - event.enemy.defense + ((range(@mutable combat_system.rng, random, 3u32 as +Wrapping) as i32) as i32 +Wrapping)) as i32) as i32 +Wrapping;
    event.enemy.health = max_i32(0, (event.enemy.health - round.player_damage) as i32) as i32 +Wrapping;
    round.enemy_defeated = event.enemy.health == 0;

    transition round.enemy_defeated {
        true -> defeated_enemy(combat_system, player, event, random, round),
        false -> enemy_retaliates(combat_system, player, event, random, round)
    }


    machine defeated_enemy(
        combat_system: @mutable CombatSystem,
        player: @mutable Player,
        event: @mutable RoomEvent,
        random: @mutable RandomState,
        round: @mutable CombatRound
    ) {
        let mutable reward: Reward;
        roll_enemy_reward(@mutable combat_system.rewards, event.enemy, random, @mutable reward);
        grant_reward(@mutable combat_system.player_system, player, reward);
        grant_xp(@mutable combat_system.player_system, player, event.enemy.xp_reward);

        event.reward = reward;
        event.consumed = true;
        round.enemy_damage = 0i32 as +Wrapping;
        round.player_defeated = false;
    }

    machine enemy_retaliates(
        combat_system: @mutable CombatSystem,
        player: @mutable Player,
        event: @mutable RoomEvent,
        random: @mutable RandomState,
        round: @mutable CombatRound
    ) {
        round.enemy_damage = max_i32(0, (event.enemy.attack - player.defense + ((range(@mutable combat_system.rng, random, 3u32 as +Wrapping) as i32) as i32 +Wrapping)) as i32) as i32 +Wrapping;
        take_damage(player, round.enemy_damage);
        round.player_defeated = player.health == 0;
    }
}
