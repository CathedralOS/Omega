use combat/combat_round.omg;
use events/events.omg;
use player/player.omg;
use player/player_state.omg;
use rewards/reward_tables.omg;
use rewards/rewards.omg;
use rng/random.omg;
use rng/random_state.omg;
use {omega}/language/core/math.omg;

data CombatSystem {
    player_system: |player|::PlayerSystem;
    rewards: |reward_tables|::RewardTables;
    rng: |random|::Random;
}

machine combat_system_fight(
    combat_system: @mutable CombatSystem,
    player: @mutable |player_state|::Player,
    event: @mutable |events|::RoomEvent,
    random: @mutable |random_state|::RandomState,
    round: @mutable |combat_round|::CombatRound
) {
    round.player_damage = |math|::max_i32(0, (player.attack - event.enemy.defense + ((|random|::range(@mutable combat_system.rng, random, 3u32 as +Wrapping) as i32) as i32 +Wrapping)) as i32) as i32 +Wrapping;
    event.enemy.health = |math|::max_i32(0, (event.enemy.health - round.player_damage) as i32) as i32 +Wrapping;
    round.enemy_defeated = event.enemy.health == 0;

    transition round.enemy_defeated {
        true -> defeated_enemy(combat_system, player, event, random, round),
        false -> enemy_retaliates(combat_system, player, event, random, round)
    }


    machine defeated_enemy(
        combat_system: @mutable CombatSystem,
        player: @mutable |player_state|::Player,
        event: @mutable |events|::RoomEvent,
        random: @mutable |random_state|::RandomState,
        round: @mutable |combat_round|::CombatRound
    ) {
        let mutable reward: |rewards|::Reward;
        |reward_tables|::roll_enemy_reward(@mutable combat_system.rewards, event.enemy, random, @mutable reward);
        |player|::grant_reward(@mutable combat_system.player_system, player, reward);
        |player|::grant_xp(@mutable combat_system.player_system, player, event.enemy.xp_reward);

        event.reward = reward;
        event.consumed = true;
        round.enemy_damage = 0i32 as +Wrapping;
        round.player_defeated = false;
    }

    machine enemy_retaliates(
        combat_system: @mutable CombatSystem,
        player: @mutable |player_state|::Player,
        event: @mutable |events|::RoomEvent,
        random: @mutable |random_state|::RandomState,
        round: @mutable |combat_round|::CombatRound
    ) {
        round.enemy_damage = |math|::max_i32(0, (event.enemy.attack - player.defense + ((|random|::range(@mutable combat_system.rng, random, 3u32 as +Wrapping) as i32) as i32 +Wrapping)) as i32) as i32 +Wrapping;
        |player|::take_damage(player, round.enemy_damage);
        round.player_defeated = player.health == 0;
    }
}
