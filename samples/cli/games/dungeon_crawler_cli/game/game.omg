use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use text;
use commands\CommandParser;
use dungeon\Dungeon;
use dungeon\can_travel_to;
use dungeon\dungeon_enter_room;
use dungeon\dungeon_fight;
use dungeon\dungeon_game_over;
use dungeon\dungeon_initialize;
use dungeon\dungeon_use_event;
use dungeon\move_to;
use rooms\CellId;
use text\TextBuffer;
use text\text_buffer_set;
use view\GameView;
use view\render_character;
use view\render_commands;
use view\render_exits;
use view\render_game_over;
use view\render_invalid_command;
use view\render_inventory;
use view\render_line;
use view\render_look;
use view\render_prompt;
use view\render_room;
use view\render_title;
use omega\language\core\ProcessExit;
use system\Console;
use system\LineReadResult;

data Game {
    dungeon: Dungeon;
    parser: CommandParser;
    view: GameView;
    input: [u8; 256];
    output: TextBuffer;
    pause: [u8; 256];
}

machine game_initialize(
    game: @mutable Game,
    seed: u64 in Wrapping
)
{
    dungeon_initialize(@mutable game.dungeon, seed);
    text_buffer_set(@mutable game.output, "" as +Ascii);
}

machine run_game_loop(game: @mutable Game) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("dungeon_crawler_cli: an interactive dungeon crawl -- type commands to explore");
    render_title();

    transition {
        _ -> block enter_room(game)
    }


    machine enter_room(game: @mutable Game) {
        let cell: CellId = game.dungeon.current_cell;
        dungeon_enter_room(cell);
        text_buffer_set(@mutable game.output, "" as +Ascii);
        render_room(@mutable game.view, game.dungeon.level,
            game.dungeon.current_cell,
            game.dungeon.treasure_taken,
            game.dungeon.gold_taken,
            game.dungeon.fountain_used,
            game.dungeon.enemy_defeated,
            @mutable game.output
        );
        render_commands();

        transition {
            _ -> block prompt(game)
        }
    }

    machine prompt(game: @mutable Game) {
        transition game.dungeon.player.health == 0 {
            true -> block game_over(game),
            false -> block read_command(game)
        }
    }

    machine read_command(game: @mutable Game) {
        render_prompt();
        transition block Console::read_line(@mutable game.input[..]) {
            LineReadResult::Error { count } -> ProcessExit::exit_process(74),
            LineReadResult::LineComplete { count } -> block received_command(game, count),
            LineReadResult::EndOfInput { count } -> block received_command(game, count),
            // Full and Invalid do not establish a completed command.
            _ -> block invalid_command(game)
        }
    }

    machine received_command(game: @mutable Game, count: u64) {
        transition count <= 256 && count <= game.input.length {
            true -> block bounded_command(game, count),
            false -> block invalid_command(game)
        }
    }

    machine bounded_command(game: @mutable Game, count: u64) requires count <= 256 {
        transition count > 0 {
            true -> block inspect_line_end(game, count),
            false -> block finished(game)
        }
    }

    // Every command length stays within the 256-byte input, and the last
    // written byte sits at `count - 1`. The guard's first conjunct always
    // holds under the contract; it bounds that computed index for the read and
    // admits it as the shorter length into the next state's contract.
    machine inspect_line_end(game: @mutable Game, count: u64) requires count > 0 requires count <= 256 {
        let last_index: u64 = count - 1;
        transition last_index <= 255 && game.input[last_index] == 10 {
            true -> block without_line_feed(game, last_index),
            false -> block dispatch_command(game, count)
        }
    }

    machine without_line_feed(game: @mutable Game, count: u64) requires count <= 255 {
        transition count > 0 {
            true -> block inspect_carriage_return(game, count),
            false -> block finished(game)
        }
    }

    machine inspect_carriage_return(game: @mutable Game, count: u64) requires count > 0 requires count <= 255 {
        let last_index: u64 = count - 1;
        transition last_index <= 254 && game.input[last_index] == 13 {
            true -> block without_carriage_return(game, last_index),
            false -> block dispatch_command(game, count)
        }
    }

    machine without_carriage_return(game: @mutable Game, count: u64) requires count <= 254 {
        transition {
            _ -> block dispatch_command(game, count)
        }
    }

    machine dispatch_command(game: @mutable Game, count: u64) requires count <= 256 {
        // ASCII commands compare against only the written prefix.
        let command: @[u8] = game.input[0..count];

        transition {
            command == "" -> block finished(game),
            command == "quit" -> block finished(game),
            command == "exit" -> block finished(game),
            command == "look" -> block look(game),
            command == "info" -> block look(game),
            command == "paths" -> block exits(game),
            command == "help" -> block exits(game),
            command == "inventory" -> block inventory(game),
            command == "inv" -> block inventory(game),
            command == "char" -> block character(game),
            command == "character" -> block character(game),
            command == "stats" -> block character(game),
            command == "use" -> block use_event(game),
            command == "fight" -> block fight(game),
            game.dungeon.current_cell == CellId::R00 && command == "north" -> block move_r01(game),
            game.dungeon.current_cell == CellId::R01 && command == "south" -> block move_r00(game),
            game.dungeon.current_cell == CellId::R01 && command == "north" -> block move_r02(game),
            game.dungeon.current_cell == CellId::R01 && command == "east" -> block move_r05(game),
            game.dungeon.current_cell == CellId::R02 && command == "south" -> block move_r01(game),
            game.dungeon.current_cell == CellId::R02 && command == "north" -> block move_r03(game),
            game.dungeon.current_cell == CellId::R02 && command == "west" -> block move_r06(game),
            game.dungeon.current_cell == CellId::R03 && command == "south" -> block move_r02(game),
            game.dungeon.current_cell == CellId::R03 && command == "north" -> block move_r04(game),
            game.dungeon.current_cell == CellId::R03 && command == "east" -> block move_r07(game),
            game.dungeon.current_cell == CellId::R04 && command == "south" -> block move_r03(game),
            game.dungeon.current_cell == CellId::R05 && command == "west" -> block move_r01(game),
            game.dungeon.current_cell == CellId::R06 && command == "east" -> block move_r02(game),
            game.dungeon.current_cell == CellId::R07 && command == "west" -> block move_r03(game),
            _ -> block invalid_command(game)
        }
    }

    machine look(game: @mutable Game) {
        render_look(
            @mutable game.view,
            game.dungeon.level,
            game.dungeon.current_cell,
            game.dungeon.treasure_taken,
            game.dungeon.gold_taken,
            game.dungeon.fountain_used,
            game.dungeon.enemy_defeated,
            @mutable game.output
        );

        transition {
            _ -> block prompt(game)
        }
    }

    machine exits(game: @mutable Game) {
        render_exits(
            @mutable game.view,
            game.dungeon.level,
            game.dungeon.current_cell,
            @mutable game.output
        );
        render_commands();

        transition {
            _ -> block prompt(game)
        }
    }

    machine inventory(game: @mutable Game) {
        render_inventory(@mutable game.view, game.dungeon.player, @mutable game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine character(game: @mutable Game) {
        render_character(@mutable game.view, game.dungeon.player, @mutable game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine use_event(game: @mutable Game) {
        let cell: CellId = game.dungeon.current_cell;
        dungeon_use_event(@mutable game.dungeon, cell, @mutable game.output);
        render_line(@game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine fight(game: @mutable Game) {
        let cell: CellId = game.dungeon.current_cell;
        dungeon_fight(@mutable game.dungeon, cell, @mutable game.output);
        render_line(@game.output);

        transition game.dungeon.player.health == 0 {
            true -> block game_over(game),
            false -> block prompt(game)
        }
    }

    machine attempt_move(game: @mutable Game) {
        let destination: CellId = game.dungeon.navigation.destination;

        transition can_travel_to(destination) {
            true -> block move_player(game),
            false -> block blocked_by_enemy(game)
        }
    }

    machine move_player(game: @mutable Game) {
        let destination: CellId = game.dungeon.navigation.destination;
        move_to(@mutable game.dungeon, destination);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r00(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R00);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r01(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R01);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r02(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R02);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r03(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R03);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r04(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R04);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r05(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R05);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r06(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R06);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r07(game: @mutable Game) {
        move_to(@mutable game.dungeon, CellId::R07);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine blocked_by_enemy(game: @mutable Game) {
        text_buffer_set(@mutable game.output, "[Blocked] A hostile presence bars the deeper path. Fight or fall back." as +Ascii);
        render_line(@game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine invalid_command(game: @mutable Game) {
        render_invalid_command();

        transition {
            _ -> block prompt(game)
        }
    }

    machine game_over(game: @mutable Game) {
        dungeon_game_over(@mutable game.dungeon);
        render_game_over();

        transition {
            _ -> block finished(game)
        }
    }

    machine finished(game: @mutable Game) {
        Console::write_line("the crawl has ended -- goodbye (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable game.pause[..]);
        ProcessExit::exit_process(0);
    }
}
