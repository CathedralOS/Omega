use commands/command_parser.omg;
use dungeon/dungeon.omg;
use rooms/map.omg;
use text/buffer.omg;
use view/game_view.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;

data Game {
    dungeon: |dungeon|::Dungeon;
    parser: |command_parser|::CommandParser;
    view: |game_view|::GameView;
    input: [u8; 256];
    output: |buffer|::TextBuffer;
}

machine game_initialize(
    game: @mutable Game,
    seed: u64 in Wrapping
)
{
    |dungeon|::dungeon_initialize(@mutable game.dungeon, seed);
    |buffer|::text_buffer_set(@mutable game.output, "" as + |buffer|::Ascii);
}

machine run_game_loop(game: @mutable Game) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("dungeon_crawler_cli: an interactive dungeon crawl -- type commands to explore");
    |game_view|::render_title();

    transition {
        _ -> block enter_room(game)
    }


    machine enter_room(game: @mutable Game) {
        let cell: |map|::CellId = game.dungeon.current_cell;
        |dungeon|::dungeon_enter_room(cell);
        |buffer|::text_buffer_set(@mutable game.output, "" as + |buffer|::Ascii);
        |game_view|::render_room(@mutable game.view, game.dungeon.level,
            game.dungeon.current_cell,
            game.dungeon.treasure_taken,
            game.dungeon.gold_taken,
            game.dungeon.fountain_used,
            game.dungeon.enemy_defeated,
            @mutable game.output
        );
        |game_view|::render_commands();

        transition {
            _ -> block prompt(game)
        }
    }

    machine prompt(game: @mutable Game) {
        transition game.dungeon.player.health == 0 {
            true -> block game_over(game),
            false -> block read_command(game)
        }
    }

    machine read_command(game: @mutable Game) {
        |game_view|::render_prompt();
        transition block |console|::Console::read_line(@mutable game.input[..]) {
            |console|::LineReadResult::Error { count } -> |process_exit|::ProcessExit::exit_process(74),
            |console|::LineReadResult::LineComplete { count } -> block received_command(game, count),
            |console|::LineReadResult::EndOfInput { count } -> block received_command(game, count),
            // Full and Invalid do not establish a completed command.
            _ -> block invalid_command(game)
        }
    }

    machine received_command(game: @mutable Game, count: u64) {
        transition count <= 256 && count <= game.input.length {
            true -> block bounded_command(game, count),
            false -> block invalid_command(game)
        }
    }

    machine bounded_command(game: @mutable Game, count: u64) requires count <= 256 {
        transition count > 0 {
            true -> block inspect_line_end(game, count),
            false -> block finished()
        }
    }

    // Every command length stays within the 256-byte input, and the last
    // written byte sits at `count - 1`. The guard's first conjunct always
    // holds under the contract; it bounds that computed index for the read and
    // admits it as the shorter length into the next state's contract.
    machine inspect_line_end(game: @mutable Game, count: u64) requires count > 0 requires count <= 256 {
        let last_index: u64 = count - 1;
        transition last_index <= 255 && game.input[last_index] == 10 {
            true -> block without_line_feed(game, last_index),
            false -> block dispatch_command(game, count)
        }
    }

    machine without_line_feed(game: @mutable Game, count: u64) requires count <= 255 {
        transition count > 0 {
            true -> block inspect_carriage_return(game, count),
            false -> block finished()
        }
    }

    machine inspect_carriage_return(game: @mutable Game, count: u64) requires count > 0 requires count <= 255 {
        let last_index: u64 = count - 1;
        transition last_index <= 254 && game.input[last_index] == 13 {
            true -> block without_carriage_return(game, last_index),
            false -> block dispatch_command(game, count)
        }
    }

    machine without_carriage_return(game: @mutable Game, count: u64) requires count <= 254 {
        transition {
            _ -> block dispatch_command(game, count)
        }
    }

    machine dispatch_command(game: @mutable Game, count: u64) requires count <= 256 {
        // ASCII commands compare against only the written prefix.
        let command: @[u8] = game.input[0..count];

        transition {
            command == "" -> block finished(),
            command == "quit" -> block finished(),
            command == "exit" -> block finished(),
            command == "look" -> block look(game),
            command == "info" -> block look(game),
            command == "paths" -> block exits(game),
            command == "help" -> block exits(game),
            command == "inventory" -> block inventory(game),
            command == "inv" -> block inventory(game),
            command == "char" -> block character(game),
            command == "character" -> block character(game),
            command == "stats" -> block character(game),
            command == "use" -> block use_event(game),
            command == "fight" -> block fight(game),
            game.dungeon.current_cell == |map|::CellId::R00 && command == "north" -> block move_r01(game),
            game.dungeon.current_cell == |map|::CellId::R01 && command == "south" -> block move_r00(game),
            game.dungeon.current_cell == |map|::CellId::R01 && command == "north" -> block move_r02(game),
            game.dungeon.current_cell == |map|::CellId::R01 && command == "east" -> block move_r05(game),
            game.dungeon.current_cell == |map|::CellId::R02 && command == "south" -> block move_r01(game),
            game.dungeon.current_cell == |map|::CellId::R02 && command == "north" -> block move_r03(game),
            game.dungeon.current_cell == |map|::CellId::R02 && command == "west" -> block move_r06(game),
            game.dungeon.current_cell == |map|::CellId::R03 && command == "south" -> block move_r02(game),
            game.dungeon.current_cell == |map|::CellId::R03 && command == "north" -> block move_r04(game),
            game.dungeon.current_cell == |map|::CellId::R03 && command == "east" -> block move_r07(game),
            game.dungeon.current_cell == |map|::CellId::R04 && command == "south" -> block move_r03(game),
            game.dungeon.current_cell == |map|::CellId::R05 && command == "west" -> block move_r01(game),
            game.dungeon.current_cell == |map|::CellId::R06 && command == "east" -> block move_r02(game),
            game.dungeon.current_cell == |map|::CellId::R07 && command == "west" -> block move_r03(game),
            _ -> block invalid_command(game)
        }
    }

    machine look(game: @mutable Game) {
        |game_view|::render_look(
            @mutable game.view,
            game.dungeon.level,
            game.dungeon.current_cell,
            game.dungeon.treasure_taken,
            game.dungeon.gold_taken,
            game.dungeon.fountain_used,
            game.dungeon.enemy_defeated,
            @mutable game.output
        );

        transition {
            _ -> block prompt(game)
        }
    }

    machine exits(game: @mutable Game) {
        |game_view|::render_exits(
            @mutable game.view,
            game.dungeon.level,
            game.dungeon.current_cell,
            @mutable game.output
        );
        |game_view|::render_commands();

        transition {
            _ -> block prompt(game)
        }
    }

    machine inventory(game: @mutable Game) {
        |game_view|::render_inventory(@mutable game.view, game.dungeon.player, @mutable game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine character(game: @mutable Game) {
        |game_view|::render_character(@mutable game.view, game.dungeon.player, @mutable game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine use_event(game: @mutable Game) {
        let cell: |map|::CellId = game.dungeon.current_cell;
        |dungeon|::dungeon_use_event(@mutable game.dungeon, cell, @mutable game.output);
        |game_view|::render_line(@game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine fight(game: @mutable Game) {
        let cell: |map|::CellId = game.dungeon.current_cell;
        |dungeon|::dungeon_fight(@mutable game.dungeon, cell, @mutable game.output);
        |game_view|::render_line(@game.output);

        transition game.dungeon.player.health == 0 {
            true -> block game_over(game),
            false -> block prompt(game)
        }
    }

    machine attempt_move(game: @mutable Game) {
        let destination: |map|::CellId = game.dungeon.navigation.destination;

        transition |dungeon|::can_travel_to(destination) {
            true -> block move_player(game),
            false -> block blocked_by_enemy(game)
        }
    }

    machine move_player(game: @mutable Game) {
        let destination: |map|::CellId = game.dungeon.navigation.destination;
        |dungeon|::move_to(@mutable game.dungeon, destination);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r00(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R00);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r01(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R01);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r02(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R02);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r03(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R03);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r04(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R04);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r05(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R05);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r06(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R06);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine move_r07(game: @mutable Game) {
        |dungeon|::move_to(@mutable game.dungeon, |map|::CellId::R07);

        transition {
            _ -> block enter_room(game)
        }
    }

    machine blocked_by_enemy(game: @mutable Game) {
        |buffer|::text_buffer_set(@mutable game.output, "[Blocked] A hostile presence bars the deeper path. Fight or fall back." as + |buffer|::Ascii);
        |game_view|::render_line(@game.output);

        transition {
            _ -> block prompt(game)
        }
    }

    machine invalid_command(game: @mutable Game) {
        |game_view|::render_invalid_command();

        transition {
            _ -> block prompt(game)
        }
    }

    machine game_over(game: @mutable Game) {
        |dungeon|::dungeon_game_over(@mutable game.dungeon);
        |game_view|::render_game_over();

        transition {
            _ -> block finished()
        }
    }

    machine finished() {
        let mutable pause: [u8; 256];
        |console|::Console::write_line("the crawl has ended -- goodbye (exit 0)");
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable pause[..]);
        |process_exit|::ProcessExit::exit_process(0);
    }
}
