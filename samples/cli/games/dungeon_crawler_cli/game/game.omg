use commands::command_parser;
use dungeon::dungeon;
use omega_language_std::console;
use rooms::map;
use view::game_view;

data Game {
    dungeon: Dungeon;
    parser: CommandParser;
    view: GameView;
    input: [u8; 256];
    output: [u8; 128] in Utf8;
    pause: [u8; 256];
}

machine Game::initialize(
    game: &mut Game,
    seed: u64 in Wrapping
)
ensures
    game.output in Utf8
{
    Dungeon::initialize(&mut game.dungeon, seed);
    game.output = "";
}

machine Game::run_game_loop(game: &mut Game) reaches Console {
    Console::write_line("dungeon_crawler_cli: an interactive dungeon crawl -- type commands to explore");
    GameView::render_title();

    transition {
        _ -> enter_room(game)
    }


    state enter_room(game: &mut Game) {
        let cell: CellId = game.dungeon.current_cell;
        Dungeon::enter_room(cell);
        game.output = "";
        GameView::render_room(
            &mut game.view,
            game.dungeon.level,
            game.dungeon.current_cell,
            game.dungeon.treasure_taken,
            game.dungeon.gold_taken,
            game.dungeon.fountain_used,
            game.dungeon.enemy_defeated,
            &mut game.output
        );
        GameView::render_commands();

        transition {
            _ -> prompt(game)
        }
    }

    state prompt(game: &mut Game) {
        transition game.dungeon.player.health == 0 {
            true -> game_over(game)
            false -> read_command(game)
        }
    }

    state read_command(game: &mut Game) {
        GameView::render_prompt();
        transition block Console::read_line(&mut game.input) {
            LineReadResult::LineComplete { count } -> received_command(game, count)
            LineReadResult::EndOfInput { count } -> received_command(game, count)
            // Full and Invalid do not establish a completed command.
            _ -> invalid_command(game)
        }
    }

    state received_command(game: &mut Game, count: u64) {
        transition count <= 256 && count <= game.input.len {
            true -> bounded_command(game, count)
            false -> invalid_command(game)
        }
    }

    state bounded_command(game: &mut Game, count: u64) requires count <= 256 {
        transition count > 0 {
            true -> inspect_line_end(game, count)
            false -> finished(game)
        }
    }

    // Every command length stays within the 256-byte input, and the last
    // written byte sits at `count - 1`. The guard's first conjunct always
    // holds under the contract; it bounds that computed index for the read and
    // admits it as the shorter length into the next state's contract.
    state inspect_line_end(game: &mut Game, count: u64) requires count > 0 requires count <= 256 {
        let last_index: u64 = count - 1;
        transition last_index <= 255 && game.input[last_index] == 10 {
            true -> without_line_feed(game, last_index)
            false -> dispatch_command(game, count)
        }
    }

    state without_line_feed(game: &mut Game, count: u64) requires count <= 255 {
        transition count > 0 {
            true -> inspect_carriage_return(game, count)
            false -> finished(game)
        }
    }

    state inspect_carriage_return(game: &mut Game, count: u64) requires count > 0 requires count <= 255 {
        let last_index: u64 = count - 1;
        transition last_index <= 254 && game.input[last_index] == 13 {
            true -> without_carriage_return(game, last_index)
            false -> dispatch_command(game, count)
        }
    }

    state without_carriage_return(game: &mut Game, count: u64) requires count <= 254 {
        transition {
            _ -> dispatch_command(game, count)
        }
    }

    state dispatch_command(game: &mut Game, count: u64) requires count <= 256 {
        // ASCII commands compare against only the written prefix.
        let command: &[u8] = game.input[0..count];

        transition {
            command == "" -> finished(game)
            command == "quit" -> finished(game)
            command == "exit" -> finished(game)
            command == "look" -> look(game)
            command == "info" -> look(game)
            command == "paths" -> exits(game)
            command == "help" -> exits(game)
            command == "inventory" -> inventory(game)
            command == "inv" -> inventory(game)
            command == "char" -> character(game)
            command == "character" -> character(game)
            command == "stats" -> character(game)
            command == "use" -> use_event(game)
            command == "fight" -> fight(game)
            game.dungeon.current_cell == CellId::R00 && command == "north" -> move_r01(game)
            game.dungeon.current_cell == CellId::R01 && command == "south" -> move_r00(game)
            game.dungeon.current_cell == CellId::R01 && command == "north" -> move_r02(game)
            game.dungeon.current_cell == CellId::R01 && command == "east" -> move_r05(game)
            game.dungeon.current_cell == CellId::R02 && command == "south" -> move_r01(game)
            game.dungeon.current_cell == CellId::R02 && command == "north" -> move_r03(game)
            game.dungeon.current_cell == CellId::R02 && command == "west" -> move_r06(game)
            game.dungeon.current_cell == CellId::R03 && command == "south" -> move_r02(game)
            game.dungeon.current_cell == CellId::R03 && command == "north" -> move_r04(game)
            game.dungeon.current_cell == CellId::R03 && command == "east" -> move_r07(game)
            game.dungeon.current_cell == CellId::R04 && command == "south" -> move_r03(game)
            game.dungeon.current_cell == CellId::R05 && command == "west" -> move_r01(game)
            game.dungeon.current_cell == CellId::R06 && command == "east" -> move_r02(game)
            game.dungeon.current_cell == CellId::R07 && command == "west" -> move_r03(game)
            _ -> invalid_command(game)
        }
    }

    state look(game: &mut Game) {
        GameView::render_look(
            &mut game.view,
            game.dungeon.level,
            game.dungeon.current_cell,
            game.dungeon.treasure_taken,
            game.dungeon.gold_taken,
            game.dungeon.fountain_used,
            game.dungeon.enemy_defeated,
            &mut game.output
        );

        transition {
            _ -> prompt(game)
        }
    }

    state exits(game: &mut Game) {
        GameView::render_exits(
            &mut game.view,
            game.dungeon.level,
            game.dungeon.current_cell,
            &mut game.output
        );
        GameView::render_commands();

        transition {
            _ -> prompt(game)
        }
    }

    state inventory(game: &mut Game) {
        GameView::render_inventory(&mut game.view, game.dungeon.player, &mut game.output);

        transition {
            _ -> prompt(game)
        }
    }

    state character(game: &mut Game) {
        GameView::render_character(&mut game.view, game.dungeon.player, &mut game.output);

        transition {
            _ -> prompt(game)
        }
    }

    state use_event(game: &mut Game) {
        let cell: CellId = game.dungeon.current_cell;
        Dungeon::use_event(&mut game.dungeon, cell, &mut game.output);
        GameView::render_line(game.output);

        transition {
            _ -> prompt(game)
        }
    }

    state fight(game: &mut Game) {
        let cell: CellId = game.dungeon.current_cell;
        Dungeon::fight(&mut game.dungeon, cell, &mut game.output);
        GameView::render_line(game.output);

        transition game.dungeon.player.health == 0 {
            true -> game_over(game)
            false -> prompt(game)
        }
    }

    state attempt_move(game: &mut Game) {
        let destination: CellId = game.dungeon.navigation.destination;

        transition Dungeon::can_travel_to(destination) {
            true -> move_player(game)
            false -> blocked_by_enemy(game)
        }
    }

    state move_player(game: &mut Game) {
        let destination: CellId = game.dungeon.navigation.destination;
        Dungeon::move_to(&mut game.dungeon, destination);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r00(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R00);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r01(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R01);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r02(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R02);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r03(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R03);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r04(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R04);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r05(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R05);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r06(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R06);

        transition {
            _ -> enter_room(game)
        }
    }

    state move_r07(game: &mut Game) {
        Dungeon::move_to(&mut game.dungeon, CellId::R07);

        transition {
            _ -> enter_room(game)
        }
    }

    state blocked_by_enemy(game: &mut Game) {
        game.output = "[Blocked] A hostile presence bars the deeper path. Fight or fall back.";
        GameView::render_line(game.output);

        transition {
            _ -> prompt(game)
        }
    }

    state invalid_command(game: &mut Game) {
        GameView::render_invalid_command();

        transition {
            _ -> prompt(game)
        }
    }

    state game_over(game: &mut Game) {
        Dungeon::game_over(&mut game.dungeon);
        GameView::render_game_over();

        transition {
            _ -> finished(game)
        }
    }

    state finished(game: &mut Game) {
        Console::write_line("the crawl has ended -- goodbye (exit 0)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut game.pause);
        Console::exit_process(0);
    }
}
