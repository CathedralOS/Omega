use rewards\Reward;
use rewards\RewardKind;

data InventorySystem {
}

machine clear(inventory: @mutable Inventory) {
    inventory.item_count = 0u64 as +Wrapping;
    inventory.gold = 0u32 as +Wrapping;
}

machine add_reward(
    inventory_system: @mutable InventorySystem,
    inventory: @mutable Inventory,
    reward: Reward
) {
    transition reward.kind {
        RewardKind::None -> {},
        RewardKind::Gold -> add_gold(inventory_system, inventory, reward.gold),
        RewardKind::Item -> add_item(inventory_system, inventory, reward.item),
        RewardKind::GoldAndItem -> add_gold_and_item(inventory_system, inventory, reward)
    }


    machine add_gold(
        inventory_system: @mutable InventorySystem,
        inventory: @mutable Inventory,
        amount: u32 in Wrapping
    ) {
        inventory_system_add_gold(inventory, amount);
    }

    machine add_item(
        inventory_system: @mutable InventorySystem,
        inventory: @mutable Inventory,
        kind: ItemKind
    ) {
        inventory_system_add_item(inventory_system, inventory, kind);
    }

    machine add_gold_and_item(
        inventory_system: @mutable InventorySystem,
        inventory: @mutable Inventory,
        reward: Reward
    ) {
        inventory_system_add_gold(inventory, reward.gold);
        inventory_system_add_item(inventory_system, inventory, reward.item);
    }
}

machine inventory_system_add_gold(inventory: @mutable Inventory,
    amount: u32 in Wrapping) {
    inventory.gold = inventory.gold + amount;
}

machine inventory_system_add_item(
    inventory_system: @mutable InventorySystem,
    inventory: @mutable Inventory,
    kind: ItemKind
) {
    // Sentinel search: an index past the 32-slot capacity means "not found".
    // (Optional<T> case payloads are not used here yet; the old
    // `Optional<u64>` + `is_some()`/`unwrap()` spelling resolved to NOTHING and
    // silently bound 0 -- every pickup appended a fresh stack.)
    let existing_index: u64 = find_item(inventory_system, inventory, kind);

    transition existing_index < 32 {
        true -> increment_existing(inventory_system, inventory, kind, existing_index as +Wrapping),
        false -> append_item(inventory_system, inventory, kind)
    }


    machine increment_existing(
        inventory_system: @mutable InventorySystem,
        inventory: @mutable Inventory,
        kind: ItemKind,
        index: u64 in Wrapping
    ) {
        transition index < 32 {
            true -> increment_item(inventory_system, @mutable inventory.items[index as -Wrapping], 1u32 as +Wrapping),
            false -> append_item(inventory_system, inventory, kind)
        }
    }

    machine append_item(
        inventory_system: @mutable InventorySystem,
        inventory: @mutable Inventory,
        kind: ItemKind
    ) {
        inventory_system_append_item(inventory, kind);
    }

    machine increment_item(
        inventory_system: @mutable InventorySystem,
        item: @mutable InventoryItem,
        amount: u32 in Wrapping
    ) {
        inventory_system_increment_item(item, amount);
    }
}

machine inventory_system_append_item(inventory: @mutable Inventory,
    kind: ItemKind) {
    let index: u64 in Wrapping = inventory.item_count;

    transition index < 32 {
        true -> append_item_at(inventory, kind, index),
        false -> {}
    }


    machine append_item_at(inventory: @mutable Inventory,
        kind: ItemKind,
        index: u64 in Wrapping) {
        inventory.items[index as -Wrapping] = InventoryItem { kind: kind, count: 1u32 as +Wrapping };
        inventory.item_count = inventory.item_count + 1;
    }
}

machine find_item(
    inventory_system: @mutable InventorySystem,
    inventory: @Inventory,
    kind: ItemKind
    ) -> u64 {
    let items: @[InventoryItem] = @inventory.items[..];

    match inventory.item_count > 0 {
        true -> find_item_at(items, kind, 0u64 as +Wrapping),
        false -> (32)
    }
}

machine find_item_at(items: @[InventoryItem],
    kind: ItemKind,
    index: u64 in Wrapping) -> u64 {
    transition index < items.length {
        true -> inspect_item(items, kind, index),
        false -> (32)
    }


    machine inspect_item(items: @[InventoryItem],
        kind: ItemKind,
        index: u64 in Wrapping) -> u64
    requires index < items.length {
        let found: bool = items[index as -Wrapping].kind == kind;
        let next_index: u64 in Wrapping = index + 1;

        transition found {
            true -> (index as u64),
            false -> scan_next(items, kind, next_index)
        }
    }

    // Both nested invocations forward completion. The explicit index contract
    // admits each read; terminal cycle lowering preserves constant stack use.
    machine scan_next(items: @[InventoryItem],
        kind: ItemKind,
        next_index: u64 in Wrapping) -> u64 {
        transition next_index < items.length {
            true -> inspect_item(items, kind, next_index),
            false -> (32)
        }
    }
}

machine inventory_system_increment_item(item: @mutable InventoryItem,
    amount: u32 in Wrapping) {
    item.count = item.count + amount;
}
