use inventory::items;
use rewards::rewards;

data InventorySystem {
}

machine InventorySystem::clear(inventory: &mut Inventory) {
    inventory.item_count = 0;
    inventory.gold = 0;
}

machine InventorySystem::add_reward(
    inventory_system: &mut InventorySystem,
    inventory: &mut Inventory,
    reward: Reward
) {
    transition reward.kind {
        RewardKind::None -> {}
        RewardKind::Gold -> add_gold(inventory_system, inventory, reward.gold)
        RewardKind::Item -> add_item(inventory_system, inventory, reward.item)
        RewardKind::GoldAndItem -> add_gold_and_item(inventory_system, inventory, reward)
    }


    state add_gold(
        inventory_system: &mut InventorySystem,
        inventory: &mut Inventory,
        amount: u32 in Wrapping
    ) {
        InventorySystem::add_gold(inventory, amount);
    }

    state add_item(
        inventory_system: &mut InventorySystem,
        inventory: &mut Inventory,
        kind: ItemKind
    ) {
        InventorySystem::add_item(inventory_system, inventory, kind);
    }

    state add_gold_and_item(
        inventory_system: &mut InventorySystem,
        inventory: &mut Inventory,
        reward: Reward
    ) {
        InventorySystem::add_gold(inventory, reward.gold);
        InventorySystem::add_item(inventory_system, inventory, reward.item);
    }
}

machine InventorySystem::add_gold(inventory: &mut Inventory,
    amount: u32 in Wrapping) {
    inventory.gold = inventory.gold + amount;
}

machine InventorySystem::add_item(
    inventory_system: &mut InventorySystem,
    inventory: &mut Inventory,
    kind: ItemKind
) {
    // Sentinel search: an index past the 32-slot capacity means "not found".
    // (Optional<T> case payloads are not used here yet; the old
    // `Optional<u64>` + `is_some()`/`unwrap()` spelling resolved to NOTHING and
    // silently bound 0 -- every pickup appended a fresh stack.)
    let existing_index: u64 = InventorySystem::find_item(inventory_system, inventory, kind);

    transition existing_index < 32 {
        true -> increment_existing(inventory_system, inventory, kind, existing_index as u64 in Wrapping)
        false -> append_item(inventory_system, inventory, kind)
    }


    state increment_existing(
        inventory_system: &mut InventorySystem,
        inventory: &mut Inventory,
        kind: ItemKind,
        index: u64 in Wrapping
    ) {
        transition index < 32 {
            true -> increment_item(inventory_system, &mut inventory.items[index], 1)
            false -> append_item(inventory_system, inventory, kind)
        }
    }

    state append_item(
        inventory_system: &mut InventorySystem,
        inventory: &mut Inventory,
        kind: ItemKind
    ) {
        InventorySystem::append_item(inventory, kind);
    }

    state increment_item(
        inventory_system: &mut InventorySystem,
        item: &mut InventoryItem,
        amount: u32 in Wrapping
    ) {
        InventorySystem::increment_item(item, amount);
    }
}

machine InventorySystem::append_item(inventory: &mut Inventory,
    kind: ItemKind) {
    let index: u64 in Wrapping = inventory.item_count;

    transition index < 32 {
        true -> append_item_at(inventory, kind, index)
        false -> {}
    }


    state append_item_at(inventory: &mut Inventory,
        kind: ItemKind,
        index: u64 in Wrapping) {
        inventory.items[index] = InventoryItem { kind: kind, count: 1 };
        inventory.item_count = inventory.item_count + 1;
    }
}

machine InventorySystem::find_item(
    inventory_system: &mut InventorySystem,
    inventory: &Inventory,
    kind: ItemKind
    ) -> u64 {
    let items: &[InventoryItem] = inventory.items.as_slice();

    match inventory.item_count > 0 {
        true -> InventorySystem::find_item_at(items, kind, 0)
        false -> (32)
    }
}

machine InventorySystem::find_item_at(items: &[InventoryItem],
    kind: ItemKind,
    index: u64 in Wrapping) -> u64 {
    transition index < items.len {
        true -> inspect_item(items, kind, index)
        false -> (32)
    }


    state inspect_item(items: &[InventoryItem],
        kind: ItemKind,
        index: u64 in Wrapping) {
        let found: bool = items[index].kind == kind;
        let next_index: u64 in Wrapping = index + 1;

        transition found {
            true -> (index as u64)
            false -> scan_next(items, kind, next_index)
        }
    }

    // Was a SIBLING MACHINE (find_item_after) forming an A -> B -> A
    // machine-call cycle with this one -- banned by the chapter 3 runtime-cycle
    // ruling (machine call cycles require tail admission; states are loops).
    // The same scan is now an in-machine state pair: inspect_item <-> scan_next is a
    // state-transition LOOP (constant stack), the blessed spelling.
    state scan_next(items: &[InventoryItem],
        kind: ItemKind,
        next_index: u64 in Wrapping) {
        transition next_index < items.len {
            true -> inspect_item(items, kind, next_index)
            false -> (32)
        }
    }
}

machine InventorySystem::increment_item(item: &mut InventoryItem,
    amount: u32 in Wrapping) {
    item.count = item.count + amount;
}
