use events::events;
use rooms::map;

data Exit {
    command: String;
    direction: Direction;
    destination: CellId;
}

data Room {
    cell: CellId;
    depth: u32 in Wrapping;
    branch: u32 in Wrapping;
    label: String;
    description: String;
    exits: [Exit; 4];
    exit_count: u64 in Wrapping;
    event: RoomEvent;
    discovered: bool;
}

data Level {
    rooms: [Room; 16];
    room_count: u64 in Wrapping;
    start_cell: CellId;
    deepest_depth: u32 in Wrapping;
}
