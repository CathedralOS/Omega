use rooms::map;
use rooms::rooms;

data RoomLookup {
}

machine RoomLookup::find_room(
    &mut self,
    level: Level,
    cell: CellId,
    out_room: &mut Room
)
ensures
    out_room.label in Utf8,
    out_room.description in Utf8,
    out_room.event.enemy.name in Utf8
{
    let rooms: &[Room] = level.rooms.as_slice();

    transition level.room_count > 0 {
        true -> find_room_at(rooms, level.room_count, cell, out_room, 0)
        false -> {}
    }


    state find_room_at(
        &mut self,
        rooms: &[Room],
        room_count: u64 in Wrapping,
        cell: CellId,
        out_room: &mut Room,
        index: u64 in Wrapping
    ) {
        let found: bool = rooms[index].cell == cell;
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < room_count;

        transition {
            found -> apply_room(rooms[index], out_room)
            has_next -> find_room_at(rooms, room_count, cell, out_room, next_index)
            _ -> {}
        }
    }

    state apply_room(
        &mut self,
        room: Room,
        out_room: &mut Room
    ) {
        out_room.cell = room.cell;
        out_room.depth = room.depth;
        out_room.branch = room.branch;
        out_room.label = room.label;
        out_room.description = room.description;
        out_room.exit_count = room.exit_count;
        out_room.discovered = room.discovered;

        let out_exits: &mut [Exit] = out_room.exits.as_mut_slice();
        let room_exits: &[Exit] = room.exits.as_slice();
        out_exits[0] = room_exits[0];
        out_exits[1] = room_exits[1];
        out_exits[2] = room_exits[2];
        out_exits[3] = room_exits[3];

        out_room.event.kind = room.event.kind;
        out_room.event.consumed = room.event.consumed;
        out_room.event.enemy = room.event.enemy;
        out_room.event.reward = room.event.reward;
    }
}

machine RoomLookup::find_room_mut(
    &mut self,
    level: &mut Level,
    cell: CellId
    ) -> &mut Room {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();

    transition level.room_count > 0 {
        true -> find_room_mut_at(rooms, level.room_count, cell, 0)
        false -> &mut rooms[0]
    }


    state find_room_mut_at(
        &mut self,
        rooms: &mut [Room],
        room_count: u64 in Wrapping,
        cell: CellId,
        index: u64 in Wrapping
    ) {
        let found: bool = rooms[index].cell == cell;
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < room_count;

        transition {
            found -> &mut rooms[index]
            has_next -> find_room_mut_at(rooms, room_count, cell, next_index)
            _ -> &mut rooms[0]
        }
    }
}
