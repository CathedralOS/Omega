use rooms/map.omg;
use rooms/rooms.omg;
use text/buffer.omg;

data RoomLookup {
}

machine find_room(level: |rooms|::Level,
    cell: |map|::CellId,
    out_room: @mutable |rooms|::Room)
ensures
    out_room.label.storage in |buffer|::Utf8,
    out_room.event.enemy.name.storage in |buffer|::Utf8
{
    let rooms: @[|rooms|::Room] = @level.rooms[..];

    transition level.room_count > 0 {
        true -> find_room_at(rooms, level.room_count, cell, out_room, 0u64 as +Wrapping),
        false -> {}
    }


    machine find_room_at(rooms: @[|rooms|::Room],
        room_count: u64,
        cell: |map|::CellId,
        out_room: @mutable |rooms|::Room,
        index: u64 in Wrapping)
    requires room_count <= 16, index < 16, rooms.length == 16
    {
        let found: bool = rooms[index as -Wrapping].cell == cell;
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < room_count;

        // A level holds at most 16 rooms, so `next_index < 16` whenever
        // has_next holds; the conjunct admits it into the index contract.
        transition {
            found -> apply_room(rooms[index as -Wrapping], out_room),
            has_next && next_index < 16 -> find_room_at(rooms, room_count, cell, out_room, next_index),
            _ -> {}
        }
    }

    machine apply_room(room: |rooms|::Room,
        out_room: @mutable |rooms|::Room) {
        out_room.cell = room.cell;
        out_room.depth = room.depth;
        out_room.branch = room.branch;
        out_room.label = room.label;
        out_room.description = room.description;
        out_room.exit_count = room.exit_count;
        out_room.discovered = room.discovered;

        let out_exits: @mutable [|rooms|::Exit] = @mutable out_room.exits[..];
        let room_exits: @[|rooms|::Exit] = @room.exits[..];
        out_exits[0] = room_exits[0];
        out_exits[1] = room_exits[1];
        out_exits[2] = room_exits[2];
        out_exits[3] = room_exits[3];

        out_room.event.kind = room.event.kind;
        out_room.event.consumed = room.event.consumed;
        out_room.event.enemy = room.event.enemy;
        out_room.event.reward = room.event.reward;
    }
}

machine find_room_mut(level: @mutable |rooms|::Level,
    cell: |map|::CellId) -> @mutable |rooms|::Room {
    let rooms: @mutable [|rooms|::Room] = @mutable level.rooms[..];

    transition level.room_count > 0 {
        true -> find_room_mut_at(rooms, level.room_count, cell, 0u64 as +Wrapping),
        false -> @mutable rooms[0]
    }


    machine find_room_mut_at(rooms: @mutable [|rooms|::Room],
        room_count: u64,
        cell: |map|::CellId,
        index: u64 in Wrapping) -> @mutable |rooms|::Room
    requires room_count <= 16, index < 16, rooms.length == 16
    {
        let found: bool = rooms[index as -Wrapping].cell == cell;
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < room_count;

        transition {
            found -> @mutable rooms[index as -Wrapping],
            has_next && next_index < 16 -> find_room_mut_at(rooms, room_count, cell, next_index),
            _ -> @mutable rooms[0]
        }
    }
}
