use generation::maze_builder;
use rooms::rooms;

data DungeonGenerator {
    maze: MazeBuilder;
}

machine DungeonGenerator::generate(
    dungeon_generator: &mut DungeonGenerator,
    seed: u64 in Wrapping,
    out_level: &mut Level
) {
    MazeBuilder::build(&mut dungeon_generator.maze, seed, out_level);
}
