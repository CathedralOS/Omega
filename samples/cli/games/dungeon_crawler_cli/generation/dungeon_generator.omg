use generation/maze_builder.omg;
use rooms/rooms.omg;

data DungeonGenerator {
    maze: |maze_builder|::MazeBuilder;
}

machine generate(
    dungeon_generator: @mutable DungeonGenerator,
    seed: u64 in Wrapping,
    out_level: @mutable |rooms|::Level
) {
    |maze_builder|::build(@mutable dungeon_generator.maze, seed, out_level);
}
