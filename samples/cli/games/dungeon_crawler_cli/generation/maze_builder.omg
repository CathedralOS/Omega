use omega\language\core\max_u32;
use omega\language\core\max_u64;


data MazeBuilder {
    events: RoomEvents;
    rng: Random;
}

machine build(
    maze_builder: @mutable MazeBuilder,
    seed: u64 in Wrapping,
    level: @mutable Level
) {
    let mutable random: RandomState;
    seed(seed, @mutable random);
    clear_level(maze_builder, level);

    level.start_cell = CellId::R00;
    level.room_count = 0;
    level.deepest_depth = 0;

    // The crawl begins at the bottom of the dungeon, in the bottomless dark
    // room near the dungeon heart; the maze climbs outward toward the surface.
    carve_room(maze_builder, level, @mutable random, CellId::R00, 9, 0);
    force_quiet_room(maze_builder, level, CellId::R00);
    transition {
        _ -> build_main_hall_1(maze_builder, level, @mutable random)
    }


    machine build_main_hall_1(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        build_segment(maze_builder, level, random, CellId::R00, CellId::R01, 1, 0, Direction::North);

        transition {
            _ -> maybe_side_room_1(maze_builder, level, random)
        }
    }

    machine maybe_side_room_1(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        transition should_carve(maze_builder, random, 2) {
            true -> build_side_room_1(maze_builder, level, random),
            false -> build_main_hall_2(maze_builder, level, random)
        }
    }

    machine build_side_room_1(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        build_segment(maze_builder, level, random, CellId::R01, CellId::R05, 2, 10, Direction::East);

        transition {
            _ -> build_main_hall_2(maze_builder, level, random)
        }
    }

    machine build_main_hall_2(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        build_segment(maze_builder, level, random, CellId::R01, CellId::R02, 2, 0, Direction::North);

        transition {
            _ -> maybe_side_room_2(maze_builder, level, random)
        }
    }

    machine maybe_side_room_2(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        transition should_carve(maze_builder, random, 3) {
            true -> build_side_room_2(maze_builder, level, random),
            false -> build_main_hall_3(maze_builder, level, random)
        }
    }

    machine build_side_room_2(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        build_segment(maze_builder, level, random, CellId::R02, CellId::R06, 3, 11, Direction::West);

        transition {
            _ -> build_main_hall_3(maze_builder, level, random)
        }
    }

    machine build_main_hall_3(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        build_segment(maze_builder, level, random, CellId::R02, CellId::R03, 3, 0, Direction::North);

        transition {
            _ -> maybe_side_room_3(maze_builder, level, random)
        }
    }

    machine maybe_side_room_3(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        transition should_carve(maze_builder, random, 4) {
            true -> build_side_room_3(maze_builder, level, random),
            false -> build_main_hall_4(maze_builder, level, random)
        }
    }

    machine build_side_room_3(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        build_segment(maze_builder, level, random, CellId::R03, CellId::R07, 4, 12, Direction::East);

        transition {
            _ -> build_main_hall_4(maze_builder, level, random)
        }
    }

    machine build_main_hall_4(
        maze_builder: @mutable MazeBuilder,
        level: @mutable Level,
        random: @mutable RandomState
    ) {
        build_segment(maze_builder, level, random, CellId::R03, CellId::R04, 4, 0, Direction::North);
        level.room_count = 8;
        level.deepest_depth = max_u32(level.deepest_depth as u32, 4) as u32 +Wrapping;
    }
}

machine build_segment(
    maze_builder: @mutable MazeBuilder,
    level: @mutable Level,
    random: @mutable RandomState,
    from: CellId,
    target: CellId,
    depth: u32 in Wrapping,
    branch_id: u32 in Wrapping,
    direction: Direction
) {
    carve_room(maze_builder, level, random, target, depth, branch_id);
    connect(maze_builder, level, from, target, direction);
}

machine force_quiet_room(
    maze_builder: @mutable MazeBuilder,
    level: @mutable Level,
    cell: CellId
) {
    let room: @mutable Room = room_mut(level, cell);
    clear_event(maze_builder, @mutable room.event);
}

machine clear_level(
    maze_builder: @mutable MazeBuilder,
    level: @mutable Level
) {
    let rooms: @mutable [Room] = @mutable level.rooms[..];
    clear_room(maze_builder, @mutable rooms[0], CellId::R00);
    clear_room(maze_builder, @mutable rooms[1], CellId::R01);
    clear_room(maze_builder, @mutable rooms[2], CellId::R02);
    clear_room(maze_builder, @mutable rooms[3], CellId::R03);
    clear_room(maze_builder, @mutable rooms[4], CellId::R04);
    clear_room(maze_builder, @mutable rooms[5], CellId::R05);
    clear_room(maze_builder, @mutable rooms[6], CellId::R06);
    clear_room(maze_builder, @mutable rooms[7], CellId::R07);
    clear_room(maze_builder, @mutable rooms[8], CellId::R08);
    clear_room(maze_builder, @mutable rooms[9], CellId::R09);
    clear_room(maze_builder, @mutable rooms[10], CellId::R10);
    clear_room(maze_builder, @mutable rooms[11], CellId::R11);
    clear_room(maze_builder, @mutable rooms[12], CellId::R12);
    clear_room(maze_builder, @mutable rooms[13], CellId::R13);
    clear_room(maze_builder, @mutable rooms[14], CellId::R14);
    clear_room(maze_builder, @mutable rooms[15], CellId::R15);
}

machine clear_room(
    maze_builder: @mutable MazeBuilder,
    room: @mutable Room,
    cell: CellId
) {
    room.cell = cell;
    room.depth = 0;
    room.branch = 0;
    room_label_set(@mutable room.label, "");
    room_description_set(@mutable room.description, "");
    room.exit_count = 0;
    room.discovered = false;
    clear_exits(maze_builder, room);
    clear_event(maze_builder, @mutable room.event);
}

machine clear_exits(
    maze_builder: @mutable MazeBuilder,
    room: @mutable Room
) {
    let exits: @mutable [Exit] = @mutable room.exits[..];
    exits[0] = blank_exit();
    exits[1] = blank_exit();
    exits[2] = blank_exit();
    exits[3] = blank_exit();
}

machine clear_event(
    maze_builder: @mutable MazeBuilder,
    event: @mutable RoomEvent
) {
    event.kind = RoomEventKind::Nothing;
    event.enemy = empty_enemy();
    event.reward = maze_builder_empty_reward();
    event.consumed = true;
}

machine blank_exit() -> Exit {
    Exit {
        command: ExitCommand { used: 0 },
        direction: Direction::North,
        destination: CellId::Empty
    }
}

machine empty_enemy() -> Enemy {
    let mutable enemy: Enemy;
    enemy.kind = EnemyKind::Bat;
    enemy_name_set(@mutable enemy.name, "");
    enemy.max_health = 1;
    enemy.health = 1;
    enemy.attack = 1;
    enemy.defense = 0;
    enemy.xp_reward = 0;
    enemy.depth = 0;

    transition {
        _ -> enemy
    }
}

machine maze_builder_empty_reward() -> Reward {
    Reward {
        kind: RewardKind::None,
        gold: 0,
        item: ItemKind::RustedDagger
    }
}

machine should_carve(
    maze_builder: @mutable MazeBuilder,
    random: @mutable RandomState,
    depth: u32 in Wrapping
    ) -> bool {
    let chance: u32 in Wrapping = max_u32(15, (80 - depth * 6) as u32) as u32 +Wrapping;
    let rolled: bool = chance(@mutable maze_builder.rng, random, chance, 100);

    transition {
        _ -> rolled
    }
}

machine carve_room(
    maze_builder: @mutable MazeBuilder,
    level: @mutable Level,
    random: @mutable RandomState,
    cell: CellId,
    depth: u32 in Wrapping,
    branch_id: u32 in Wrapping
) {
    // `room` borrows all of `level` until its last use, so the start cell is
    // read before it forms.
    let start_cell: CellId = level.start_cell;
    let room: @mutable Room = room_mut(level, cell);
    let index: u64 = cell_index(cell); // <= 15 by cell_index's ensures
    room.cell = cell;
    room.depth = depth;
    room.branch = branch_id;
    room_label_set(@mutable room.label, room_label(cell));
    room_description_set(@mutable room.description, room_description(depth, branch_id));
    room.exit_count = 0;
    room.discovered = cell == start_cell;
    roll_event(@mutable maze_builder.events, depth, random, @mutable room.event);
    level.room_count = max_u64(level.room_count, index + 1);
    level.deepest_depth = max_u32(level.deepest_depth as u32, depth as u32) as u32 +Wrapping;
}

machine connect(
    maze_builder: @mutable MazeBuilder,
    level: @mutable Level,
    from: CellId,
    to: CellId,
    direction: Direction
) {
    let from_room: @mutable Room = room_mut(level, from);
    append_exit(from_room, direction_command(direction), direction, to);

    let back_direction: Direction = opposite(direction);
    let to_room: @mutable Room = room_mut(level, to);
    append_exit(to_room, direction_command(back_direction), back_direction, from);
}

machine next_unused_cell(level: Level) -> CellId {
    transition {
        level.room_count == 1 -> CellId::R01,
        level.room_count == 2 -> CellId::R02,
        level.room_count == 3 -> CellId::R03,
        level.room_count == 4 -> CellId::R04,
        level.room_count == 5 -> CellId::R05,
        level.room_count == 6 -> CellId::R06,
        level.room_count == 7 -> CellId::R07,
        level.room_count == 8 -> CellId::R08,
        level.room_count == 9 -> CellId::R09,
        level.room_count == 10 -> CellId::R10,
        level.room_count == 11 -> CellId::R11,
        level.room_count == 12 -> CellId::R12,
        level.room_count == 13 -> CellId::R13,
        level.room_count == 14 -> CellId::R14,
        _ -> CellId::R15
    }
}

machine cell_index(cell: CellId) -> u64
ensures
    result <= 15
{
    transition {
        cell == CellId::R00 -> 0,
        cell == CellId::R01 -> 1,
        cell == CellId::R02 -> 2,
        cell == CellId::R03 -> 3,
        cell == CellId::R04 -> 4,
        cell == CellId::R05 -> 5,
        cell == CellId::R06 -> 6,
        cell == CellId::R07 -> 7,
        cell == CellId::R08 -> 8,
        cell == CellId::R09 -> 9,
        cell == CellId::R10 -> 10,
        cell == CellId::R11 -> 11,
        cell == CellId::R12 -> 12,
        cell == CellId::R13 -> 13,
        cell == CellId::R14 -> 14,
        _ -> 15
    }
}

machine room_label(cell: CellId) -> @[u8] in Ascii
ensures result.length <= 16
{
    transition {
        cell == CellId::R00 -> "Gate",
        _ -> "Branch Room"
    }
}

machine room_description(depth: u32 in Wrapping,
    branch_id: u32 in Wrapping) -> @[u8] in Ascii
ensures result.length <= 64
{
    transition {
        depth == 0 -> "The old gate room breathes cold air from below.",
        depth <= 2 -> "A shallow limestone room with fresh claw marks.",
        depth <= 5 -> "A winding branch room where the walls sweat mineral dust.",
        depth <= 8 -> "A deep chamber with old bones underfoot.",
        _ -> "A bottomless dark room near the dungeon heart."
    }
}

machine direction_command(direction: Direction) -> @[u8] in Ascii
ensures result.length <= 8
{
    transition {
        direction == Direction::North -> "north",
        direction == Direction::South -> "south",
        direction == Direction::East -> "east",
        _ -> "west"
    }
}

machine opposite(direction: Direction) -> Direction {
    transition {
        direction == Direction::North -> Direction::South,
        direction == Direction::South -> Direction::North,
        direction == Direction::East -> Direction::West,
        _ -> Direction::East
    }
}
