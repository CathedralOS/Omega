use enemies::enemies;
use events::room_events;
use events::events;
use inventory::items;
use rng::random;
use rng::random_state;
use rewards::rewards;
use rooms::map;
use rooms::rooms;

data MazeBuilder {
    events: RoomEvents;
    rng: Random;
}

machine MazeBuilder::build(
    maze_builder: &mut MazeBuilder,
    seed: u64 in Wrapping,
    level: &mut Level
) {
    let random: RandomState;
    Random::seed(seed, &mut random);
    MazeBuilder::clear_level(maze_builder, level);

    level.start_cell = CellId::R00;
    level.room_count = 0;
    level.deepest_depth = 0;

    // The crawl begins at the bottom of the dungeon, in the bottomless dark
    // room near the dungeon heart; the maze climbs outward toward the surface.
    MazeBuilder::carve_room(maze_builder, level, &mut random, CellId::R00, 9, 0);
    MazeBuilder::force_quiet_room(maze_builder, level, CellId::R00);
    transition {
        _ -> build_main_hall_1(maze_builder, level, &mut random)
    }


    state build_main_hall_1(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        MazeBuilder::build_segment(maze_builder, level, random, CellId::R00, CellId::R01, 1, 0, Direction::North);

        transition {
            _ -> maybe_side_room_1(maze_builder, level, random)
        }
    }

    state maybe_side_room_1(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition MazeBuilder::should_carve(maze_builder, random, 2) {
            true -> build_side_room_1(maze_builder, level, random)
            false -> build_main_hall_2(maze_builder, level, random)
        }
    }

    state build_side_room_1(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        MazeBuilder::build_segment(maze_builder, level, random, CellId::R01, CellId::R05, 2, 10, Direction::East);

        transition {
            _ -> build_main_hall_2(maze_builder, level, random)
        }
    }

    state build_main_hall_2(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        MazeBuilder::build_segment(maze_builder, level, random, CellId::R01, CellId::R02, 2, 0, Direction::North);

        transition {
            _ -> maybe_side_room_2(maze_builder, level, random)
        }
    }

    state maybe_side_room_2(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition MazeBuilder::should_carve(maze_builder, random, 3) {
            true -> build_side_room_2(maze_builder, level, random)
            false -> build_main_hall_3(maze_builder, level, random)
        }
    }

    state build_side_room_2(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        MazeBuilder::build_segment(maze_builder, level, random, CellId::R02, CellId::R06, 3, 11, Direction::West);

        transition {
            _ -> build_main_hall_3(maze_builder, level, random)
        }
    }

    state build_main_hall_3(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        MazeBuilder::build_segment(maze_builder, level, random, CellId::R02, CellId::R03, 3, 0, Direction::North);

        transition {
            _ -> maybe_side_room_3(maze_builder, level, random)
        }
    }

    state maybe_side_room_3(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition MazeBuilder::should_carve(maze_builder, random, 4) {
            true -> build_side_room_3(maze_builder, level, random)
            false -> build_main_hall_4(maze_builder, level, random)
        }
    }

    state build_side_room_3(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        MazeBuilder::build_segment(maze_builder, level, random, CellId::R03, CellId::R07, 4, 12, Direction::East);

        transition {
            _ -> build_main_hall_4(maze_builder, level, random)
        }
    }

    state build_main_hall_4(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        MazeBuilder::build_segment(maze_builder, level, random, CellId::R03, CellId::R04, 4, 0, Direction::North);
        level.room_count = 8;
        level.deepest_depth = max(level.deepest_depth, 4);
    }
}

machine MazeBuilder::build_segment(
    maze_builder: &mut MazeBuilder,
    level: &mut Level,
    random: &mut RandomState,
    from: CellId,
    target: CellId,
    depth: u32 in Wrapping,
    branch_id: u32 in Wrapping,
    direction: Direction
) {
    MazeBuilder::carve_room(maze_builder, level, random, target, depth, branch_id);
    MazeBuilder::connect(maze_builder, level, from, target, direction);
}

machine MazeBuilder::force_quiet_room(
    maze_builder: &mut MazeBuilder,
    level: &mut Level,
    cell: CellId
) {
    let room: &mut Room = Level::room_mut(level, cell);
    MazeBuilder::clear_event(maze_builder, &mut room.event);
}

machine MazeBuilder::clear_level(
    maze_builder: &mut MazeBuilder,
    level: &mut Level
) {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();
    MazeBuilder::clear_room(maze_builder, &mut rooms[0], CellId::R00);
    MazeBuilder::clear_room(maze_builder, &mut rooms[1], CellId::R01);
    MazeBuilder::clear_room(maze_builder, &mut rooms[2], CellId::R02);
    MazeBuilder::clear_room(maze_builder, &mut rooms[3], CellId::R03);
    MazeBuilder::clear_room(maze_builder, &mut rooms[4], CellId::R04);
    MazeBuilder::clear_room(maze_builder, &mut rooms[5], CellId::R05);
    MazeBuilder::clear_room(maze_builder, &mut rooms[6], CellId::R06);
    MazeBuilder::clear_room(maze_builder, &mut rooms[7], CellId::R07);
    MazeBuilder::clear_room(maze_builder, &mut rooms[8], CellId::R08);
    MazeBuilder::clear_room(maze_builder, &mut rooms[9], CellId::R09);
    MazeBuilder::clear_room(maze_builder, &mut rooms[10], CellId::R10);
    MazeBuilder::clear_room(maze_builder, &mut rooms[11], CellId::R11);
    MazeBuilder::clear_room(maze_builder, &mut rooms[12], CellId::R12);
    MazeBuilder::clear_room(maze_builder, &mut rooms[13], CellId::R13);
    MazeBuilder::clear_room(maze_builder, &mut rooms[14], CellId::R14);
    MazeBuilder::clear_room(maze_builder, &mut rooms[15], CellId::R15);
}

machine MazeBuilder::clear_room(
    maze_builder: &mut MazeBuilder,
    room: &mut Room,
    cell: CellId
) {
    room.cell = cell;
    room.depth = 0;
    room.branch = 0;
    room.label = "";
    room.description = "";
    room.exit_count = 0;
    room.discovered = false;
    MazeBuilder::clear_exits(maze_builder, room);
    MazeBuilder::clear_event(maze_builder, &mut room.event);
}

machine MazeBuilder::clear_exits(
    maze_builder: &mut MazeBuilder,
    room: &mut Room
) {
    let exits: &mut [Exit] = room.exits.as_mut_slice();
    exits[0] = MazeBuilder::blank_exit();
    exits[1] = MazeBuilder::blank_exit();
    exits[2] = MazeBuilder::blank_exit();
    exits[3] = MazeBuilder::blank_exit();
}

machine MazeBuilder::clear_event(
    maze_builder: &mut MazeBuilder,
    event: &mut RoomEvent
) {
    event.kind = RoomEventKind::Nothing;
    event.enemy = MazeBuilder::empty_enemy();
    event.reward = MazeBuilder::empty_reward();
    event.consumed = true;
}

machine MazeBuilder::blank_exit() -> Exit {
    Exit {
        command: "",
        direction: Direction::North,
        destination: CellId::Empty
    }
}

machine MazeBuilder::empty_enemy() -> Enemy {
    let enemy: Enemy;
    enemy.kind = EnemyKind::Bat;
    enemy.name = "";
    enemy.max_health = 1;
    enemy.health = 1;
    enemy.attack = 1;
    enemy.defense = 0;
    enemy.xp_reward = 0;
    enemy.depth = 0;

    transition {
        _ -> enemy
    }
}

machine MazeBuilder::empty_reward() -> Reward {
    Reward {
        kind: RewardKind::None,
        gold: 0,
        item: ItemKind::RustedDagger
    }
}

machine MazeBuilder::should_carve(
    maze_builder: &mut MazeBuilder,
    random: &mut RandomState,
    depth: u32 in Wrapping
    ) -> bool {
    let chance: u32 in Wrapping = max(15, 80 - depth * 6);
    let rolled: bool = Random::chance(&mut maze_builder.rng, random, chance, 100);

    transition {
        _ -> rolled
    }
}

machine MazeBuilder::carve_room(
    maze_builder: &mut MazeBuilder,
    level: &mut Level,
    random: &mut RandomState,
    cell: CellId,
    depth: u32 in Wrapping,
    branch_id: u32 in Wrapping
) {
    let room: &mut Room = Level::room_mut(level, cell);
    let index: u64 = MazeBuilder::cell_index(cell); // <= 15 by cell_index's ensures
    room.cell = cell;
    room.depth = depth;
    room.branch = branch_id;
    room.label = MazeBuilder::room_label(cell);
    room.description = MazeBuilder::room_description(depth, branch_id);
    room.exit_count = 0;
    room.discovered = cell == level.start_cell;
    RoomEvents::roll_event(&mut maze_builder.events, depth, random, &mut room.event);
    level.room_count = max(level.room_count, index + 1);
    level.deepest_depth = max(level.deepest_depth, depth);
}

machine MazeBuilder::connect(
    maze_builder: &mut MazeBuilder,
    level: &mut Level,
    from: CellId,
    to: CellId,
    direction: Direction
) {
    let from_room: &mut Room = Level::room_mut(level, from);
    Room::append_exit(from_room, MazeBuilder::direction_command(direction), direction, to);

    let back_direction: Direction = MazeBuilder::opposite(direction);
    let to_room: &mut Room = Level::room_mut(level, to);
    Room::append_exit(to_room, MazeBuilder::direction_command(back_direction), back_direction, from);
}

machine MazeBuilder::next_unused_cell(level: Level) -> CellId {
    transition {
        level.room_count == 1 -> CellId::R01
        level.room_count == 2 -> CellId::R02
        level.room_count == 3 -> CellId::R03
        level.room_count == 4 -> CellId::R04
        level.room_count == 5 -> CellId::R05
        level.room_count == 6 -> CellId::R06
        level.room_count == 7 -> CellId::R07
        level.room_count == 8 -> CellId::R08
        level.room_count == 9 -> CellId::R09
        level.room_count == 10 -> CellId::R10
        level.room_count == 11 -> CellId::R11
        level.room_count == 12 -> CellId::R12
        level.room_count == 13 -> CellId::R13
        level.room_count == 14 -> CellId::R14
        _ -> CellId::R15
    }
}

machine MazeBuilder::cell_index(cell: CellId) -> u64
ensures
    result <= 15
{
    transition {
        cell == CellId::R00 -> 0
        cell == CellId::R01 -> 1
        cell == CellId::R02 -> 2
        cell == CellId::R03 -> 3
        cell == CellId::R04 -> 4
        cell == CellId::R05 -> 5
        cell == CellId::R06 -> 6
        cell == CellId::R07 -> 7
        cell == CellId::R08 -> 8
        cell == CellId::R09 -> 9
        cell == CellId::R10 -> 10
        cell == CellId::R11 -> 11
        cell == CellId::R12 -> 12
        cell == CellId::R13 -> 13
        cell == CellId::R14 -> 14
        _ -> 15
    }
}

machine MazeBuilder::room_label(cell: CellId) -> [u8; 16] in Utf8 {
    transition {
        cell == CellId::R00 -> "Gate"
        _ -> "Branch Room"
    }
}

machine MazeBuilder::room_description(depth: u32 in Wrapping,
    branch_id: u32 in Wrapping) -> [u8; 64] in Utf8 {
    transition {
        depth == 0 -> "The old gate room breathes cold air from below."
        depth <= 2 -> "A shallow limestone room with fresh claw marks."
        depth <= 5 -> "A winding branch room where the walls sweat mineral dust."
        depth <= 8 -> "A deep chamber with old bones underfoot."
        _ -> "A bottomless dark room near the dungeon heart."
    }
}

machine MazeBuilder::direction_command(direction: Direction) -> [u8; 8] in Utf8 {
    transition {
        direction == Direction::North -> "north"
        direction == Direction::South -> "south"
        direction == Direction::East -> "east"
        _ -> "west"
    }
}

machine MazeBuilder::opposite(direction: Direction) -> Direction {
    transition {
        direction == Direction::North -> Direction::South
        direction == Direction::South -> Direction::North
        direction == Direction::East -> Direction::West
        _ -> Direction::East
    }
}
