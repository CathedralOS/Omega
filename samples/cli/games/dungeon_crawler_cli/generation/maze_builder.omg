use enemies::enemies;
use events::room_events;
use events::events;
use inventory::items;
use rng::random;
use rng::random_state;
use rewards::rewards;
use rooms::map;
use rooms::rooms;

data MazeBuilder {
    events: RoomEvents;
    rng: Random;
}

machine MazeBuilder::build(
    &mut self,
    seed: u64 in Wrapping,
    level: &mut Level
) {
    let random: RandomState;
    self.rng.seed(seed, &mut random);
    self.clear_level(level);

    level.start_cell = CellId::R00;
    level.room_count = 0;
    level.deepest_depth = 0;

    // The crawl begins at the bottom of the dungeon, in the bottomless dark
    // room near the dungeon heart; the maze climbs outward toward the surface.
    self.carve_room(level, &mut random, CellId::R00, 9, 0);
    self.force_quiet_room(level, CellId::R00);
    transition {
        _ -> build_main_hall_1(level, &mut random)
    }


    state build_main_hall_1(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R00, CellId::R01, 1, 0, Direction::North);

        transition {
            _ -> maybe_side_room_1(level, random)
        }
    }

    state maybe_side_room_1(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition self.should_carve(random, 2) {
            true -> build_side_room_1(level, random)
            false -> build_main_hall_2(level, random)
        }
    }

    state build_side_room_1(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R01, CellId::R05, 2, 10, Direction::East);

        transition {
            _ -> build_main_hall_2(level, random)
        }
    }

    state build_main_hall_2(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R01, CellId::R02, 2, 0, Direction::North);

        transition {
            _ -> maybe_side_room_2(level, random)
        }
    }

    state maybe_side_room_2(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition self.should_carve(random, 3) {
            true -> build_side_room_2(level, random)
            false -> build_main_hall_3(level, random)
        }
    }

    state build_side_room_2(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R02, CellId::R06, 3, 11, Direction::West);

        transition {
            _ -> build_main_hall_3(level, random)
        }
    }

    state build_main_hall_3(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R02, CellId::R03, 3, 0, Direction::North);

        transition {
            _ -> maybe_side_room_3(level, random)
        }
    }

    state maybe_side_room_3(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition self.should_carve(random, 4) {
            true -> build_side_room_3(level, random)
            false -> build_main_hall_4(level, random)
        }
    }

    state build_side_room_3(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R03, CellId::R07, 4, 12, Direction::East);

        transition {
            _ -> build_main_hall_4(level, random)
        }
    }

    state build_main_hall_4(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R03, CellId::R04, 4, 0, Direction::North);
        level.room_count = 8;
        level.deepest_depth = max(level.deepest_depth, 4);
    }
}

machine MazeBuilder::build_segment(
    &mut self,
    level: &mut Level,
    random: &mut RandomState,
    from: CellId,
    target: CellId,
    depth: u32 in Wrapping,
    branch_id: u32 in Wrapping,
    direction: Direction
) {
    self.carve_room(level, random, target, depth, branch_id);
    self.connect(level, from, target, direction);
}

machine MazeBuilder::force_quiet_room(
    &mut self,
    level: &mut Level,
    cell: CellId
) {
    let room: &mut Room = level.room_mut(cell);
    self.clear_event(&mut room.event);
}

machine MazeBuilder::clear_level(
    &mut self,
    level: &mut Level
) {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();
    self.clear_room(&mut rooms[0], CellId::R00);
    self.clear_room(&mut rooms[1], CellId::R01);
    self.clear_room(&mut rooms[2], CellId::R02);
    self.clear_room(&mut rooms[3], CellId::R03);
    self.clear_room(&mut rooms[4], CellId::R04);
    self.clear_room(&mut rooms[5], CellId::R05);
    self.clear_room(&mut rooms[6], CellId::R06);
    self.clear_room(&mut rooms[7], CellId::R07);
    self.clear_room(&mut rooms[8], CellId::R08);
    self.clear_room(&mut rooms[9], CellId::R09);
    self.clear_room(&mut rooms[10], CellId::R10);
    self.clear_room(&mut rooms[11], CellId::R11);
    self.clear_room(&mut rooms[12], CellId::R12);
    self.clear_room(&mut rooms[13], CellId::R13);
    self.clear_room(&mut rooms[14], CellId::R14);
    self.clear_room(&mut rooms[15], CellId::R15);
}

machine MazeBuilder::clear_room(
    &mut self,
    room: &mut Room,
    cell: CellId
) {
    room.cell = cell;
    room.depth = 0;
    room.branch = 0;
    room.label = "";
    room.description = "";
    room.exit_count = 0;
    room.discovered = false;
    self.clear_exits(room);
    self.clear_event(&mut room.event);
}

machine MazeBuilder::clear_exits(
    &mut self,
    room: &mut Room
) {
    let exits: &mut [Exit] = room.exits.as_mut_slice();
    exits[0] = self.blank_exit();
    exits[1] = self.blank_exit();
    exits[2] = self.blank_exit();
    exits[3] = self.blank_exit();
}

machine MazeBuilder::clear_event(
    &mut self,
    event: &mut RoomEvent
) {
    event.kind = RoomEventKind::Nothing;
    event.enemy = self.empty_enemy();
    event.reward = self.empty_reward();
    event.consumed = true;
}

machine MazeBuilder::blank_exit(&mut self) -> Exit {
    Exit {
        command: "",
        direction: Direction::North,
        destination: CellId::Empty
    }
}

machine MazeBuilder::empty_enemy(&mut self) -> Enemy {
    let enemy: Enemy;
    enemy.kind = EnemyKind::Bat;
    enemy.name = "";
    enemy.max_health = 1;
    enemy.health = 1;
    enemy.attack = 1;
    enemy.defense = 0;
    enemy.xp_reward = 0;
    enemy.depth = 0;

    transition {
        _ -> enemy
    }
}

machine MazeBuilder::empty_reward(&mut self) -> Reward {
    Reward {
        kind: RewardKind::None,
        gold: 0,
        item: ItemKind::RustedDagger
    }
}

machine MazeBuilder::should_carve(
    &mut self,
    random: &mut RandomState,
    depth: u32 in Wrapping
    ) -> bool {
    let chance: u32 in Wrapping = max(15, 80 - depth * 6);
    let rolled: bool = self.rng.chance(random, chance, 100);

    transition {
        _ -> rolled
    }
}

machine MazeBuilder::carve_room(
    &mut self,
    level: &mut Level,
    random: &mut RandomState,
    cell: CellId,
    depth: u32 in Wrapping,
    branch_id: u32 in Wrapping
) {
    let room: &mut Room = level.room_mut(cell);
    let index: u64 in Wrapping = self.cell_index(cell);
    room.cell = cell;
    room.depth = depth;
    room.branch = branch_id;
    room.label = self.room_label(cell);
    room.description = self.room_description(depth, branch_id);
    room.exit_count = 0;
    room.discovered = cell == level.start_cell;
    self.events.roll_event(depth, random, &mut room.event);
    level.room_count = max(level.room_count, index + 1);
    level.deepest_depth = max(level.deepest_depth, depth);
}

machine MazeBuilder::connect(
    &mut self,
    level: &mut Level,
    from: CellId,
    to: CellId,
    direction: Direction
) {
    let from_room: &mut Room = level.room_mut(from);
    from_room.append_exit(self.direction_command(direction), direction, to);

    let back_direction: Direction = self.opposite(direction);
    let to_room: &mut Room = level.room_mut(to);
    to_room.append_exit(self.direction_command(back_direction), back_direction, from);
}

machine MazeBuilder::next_unused_cell(
    &mut self,
    level: Level
    ) -> CellId {
    transition {
        level.room_count == 1 -> CellId::R01
        level.room_count == 2 -> CellId::R02
        level.room_count == 3 -> CellId::R03
        level.room_count == 4 -> CellId::R04
        level.room_count == 5 -> CellId::R05
        level.room_count == 6 -> CellId::R06
        level.room_count == 7 -> CellId::R07
        level.room_count == 8 -> CellId::R08
        level.room_count == 9 -> CellId::R09
        level.room_count == 10 -> CellId::R10
        level.room_count == 11 -> CellId::R11
        level.room_count == 12 -> CellId::R12
        level.room_count == 13 -> CellId::R13
        level.room_count == 14 -> CellId::R14
        _ -> CellId::R15
    }
}

machine MazeBuilder::cell_index(
    &mut self,
    cell: CellId
    ) -> u64 {
    transition {
        cell == CellId::R00 -> 0
        cell == CellId::R01 -> 1
        cell == CellId::R02 -> 2
        cell == CellId::R03 -> 3
        cell == CellId::R04 -> 4
        cell == CellId::R05 -> 5
        cell == CellId::R06 -> 6
        cell == CellId::R07 -> 7
        cell == CellId::R08 -> 8
        cell == CellId::R09 -> 9
        cell == CellId::R10 -> 10
        cell == CellId::R11 -> 11
        cell == CellId::R12 -> 12
        cell == CellId::R13 -> 13
        cell == CellId::R14 -> 14
        _ -> 15
    }
}

machine MazeBuilder::room_label(
    &mut self,
    cell: CellId
    ) -> [u8; 16] in Utf8 {
    transition {
        cell == CellId::R00 -> "Gate"
        _ -> "Branch Room"
    }
}

machine MazeBuilder::room_description(
    &mut self,
    depth: u32 in Wrapping,
    branch_id: u32 in Wrapping
    ) -> [u8; 64] in Utf8 {
    transition {
        depth == 0 -> "The old gate room breathes cold air from below."
        depth <= 2 -> "A shallow limestone room with fresh claw marks."
        depth <= 5 -> "A winding branch room where the walls sweat mineral dust."
        depth <= 8 -> "A deep chamber with old bones underfoot."
        _ -> "A bottomless dark room near the dungeon heart."
    }
}

machine MazeBuilder::direction_command(
    &mut self,
    direction: Direction
    ) -> [u8; 8] in Utf8 {
    transition {
        direction == Direction::North -> "north"
        direction == Direction::South -> "south"
        direction == Direction::East -> "east"
        _ -> "west"
    }
}

machine MazeBuilder::opposite(
    &mut self,
    direction: Direction
    ) -> Direction {
    transition {
        direction == Direction::North -> Direction::South
        direction == Direction::South -> Direction::North
        direction == Direction::East -> Direction::West
        _ -> Direction::East
    }
}
