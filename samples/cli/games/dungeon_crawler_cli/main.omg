// Interactive dungeon crawler. With closed stdin (the runtime harness, EOF on the
// first prompt) the game loop reads an empty command and exits cleanly via
// `finished()`. Native lookup must preserve the generated room description.
// Expected exit: 0.
// Expected output contains: A bottomless dark room near the dungeon heart.
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 24]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 64]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 128]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 256]::Utf8(bytes)
requires
    valid_utf8(bytes);
use game::game;

data Main {
    game: Game;
}

machine Main::main(main: &mut Main) {
    Game::initialize(&mut main.game, 7);

    transition {
        _ -> running(main)
    }


    state running(main: &mut Main) {
        block Game::run_game_loop(&mut main.game);

        transition {
            _ -> shutdown(main)
        }
    }

    state shutdown(main: &mut Main) {
    }
}
