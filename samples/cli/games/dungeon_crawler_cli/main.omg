use game/game.omg;
use {omega}/language/core/process_authority.omg as streams;
use {omega}/language/core/process_exit.omg as process;

// Interactive dungeon crawler. With closed stdin (the runtime harness, EOF on the
// first prompt) the game loop reads an empty command and exits cleanly via
// `finished()`. Native lookup must preserve the generated room description.
// Expected exit: 0.
// Expected output contains: A bottomless dark room near the dungeon heart.

data Main {
    game: |game|::Game;
}

machine main(main: @mutable Main) {
    |game|::game_initialize(@mutable main.game, 7u64 as +Wrapping);

    transition {
        _ -> block running(main)
    }


    machine running(main: @mutable Main) {
        block |game|::run_game_loop(@mutable main.game);

        transition {
            _ -> shutdown(main)
        }
    }

    machine shutdown(main: @mutable Main) {
    }
}

// The entry owns ordinary local state; selection supplies no context.
public machine entry_start() {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
