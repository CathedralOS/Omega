use enemies/enemies.omg;
use inventory/items.omg;
use rewards/rewards.omg;
use rng/random.omg;
use rng/random_state.omg;

data RewardTables {
    rng: |random|::Random;
}

machine roll_room_treasure(
    reward_tables: @mutable RewardTables,
    depth: u32 in Wrapping,
    random: @mutable |random_state|::RandomState,
    reward: @mutable |rewards|::Reward
) {
    reward.kind = |rewards|::RewardKind::GoldAndItem;
    reward.gold = 20 + depth * 8 + (|random|::range(@mutable reward_tables.rng, random, 15u32 as +Wrapping) as +Wrapping);
    reward.item = roll_item(reward_tables, depth, random);
}

machine roll_gold_cache(
    reward_tables: @mutable RewardTables,
    depth: u32 in Wrapping,
    random: @mutable |random_state|::RandomState,
    reward: @mutable |rewards|::Reward
) {
    reward.kind = |rewards|::RewardKind::Gold;
    reward.gold = 8 + depth * 5 + (|random|::range(@mutable reward_tables.rng, random, 12u32 as +Wrapping) as +Wrapping);
    reward.item = |items|::ItemKind::RustedDagger;
}

machine roll_enemy_reward(
    reward_tables: @mutable RewardTables,
    enemy: |enemies|::Enemy,
    random: @mutable |random_state|::RandomState,
    reward: @mutable |rewards|::Reward
) {
    transition |random|::chance(@mutable reward_tables.rng, random, 1u32 as +Wrapping, 4u32 as +Wrapping) {
        true -> enemy_item(reward_tables, enemy, random, reward),
        false -> enemy_gold(reward_tables, enemy, random, reward)
    }


    machine enemy_item(
        reward_tables: @mutable RewardTables,
        enemy: |enemies|::Enemy,
        random: @mutable |random_state|::RandomState,
        reward: @mutable |rewards|::Reward
    ) {
        reward.kind = |rewards|::RewardKind::GoldAndItem;
        reward.gold = 1 + enemy.depth + (|random|::range(@mutable reward_tables.rng, random, 5u32 as +Wrapping) as +Wrapping);
        reward.item = roll_item(reward_tables, enemy.depth, random);
    }

    machine enemy_gold(
        reward_tables: @mutable RewardTables,
        enemy: |enemies|::Enemy,
        random: @mutable |random_state|::RandomState,
        reward: @mutable |rewards|::Reward
    ) {
        reward.kind = |rewards|::RewardKind::Gold;
        reward.gold = 2 + enemy.depth * 2 + (|random|::range(@mutable reward_tables.rng, random, 6u32 as +Wrapping) as +Wrapping);
        reward.item = |items|::ItemKind::RustedDagger;
    }
}

machine roll_item(
    reward_tables: @mutable RewardTables,
    depth: u32 in Wrapping,
    random: @mutable |random_state|::RandomState
    ) -> |items|::ItemKind {
    let roll: u32 in Wrapping = |random|::range(@mutable reward_tables.rng, random, 100u32 as +Wrapping) as +Wrapping;

    let is_early_dagger: bool = depth <= 2 && roll < 50;
    let is_early_buckler: bool = depth <= 3 && roll < 75;
    let is_healing_charm: bool = roll < 85;
    let is_ember_blade: bool = depth >= 5 && roll < 96;
    let is_deep_key: bool = depth >= 8;

    transition {
        is_early_dagger -> |items|::ItemKind::RustedDagger,
        is_early_buckler -> |items|::ItemKind::CrackedBuckler,
        is_healing_charm -> |items|::ItemKind::HealingCharm,
        is_ember_blade -> |items|::ItemKind::EmberBlade,
        is_deep_key -> |items|::ItemKind::DeepKey,
        _ -> |items|::ItemKind::RustedDagger
    }
}
