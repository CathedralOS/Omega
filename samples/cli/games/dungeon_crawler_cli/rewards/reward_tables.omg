use enemies::enemies;
use inventory::items;
use rewards::rewards;
use rng::random;
use rng::random_state;

data RewardTables {
    rng: Random;
}

machine RewardTables::roll_room_treasure(
    reward_tables: &mut RewardTables,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.kind = RewardKind::GoldAndItem;
    reward.gold = 20 + depth * 8 + (Random::range(&mut reward_tables.rng, random, 15) as u32 in Wrapping);
    reward.item = RewardTables::roll_item(reward_tables, depth, random);
}

machine RewardTables::roll_gold_cache(
    reward_tables: &mut RewardTables,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.kind = RewardKind::Gold;
    reward.gold = 8 + depth * 5 + (Random::range(&mut reward_tables.rng, random, 12) as u32 in Wrapping);
    reward.item = ItemKind::RustedDagger;
}

machine RewardTables::roll_enemy_reward(
    reward_tables: &mut RewardTables,
    enemy: Enemy,
    random: &mut RandomState,
    reward: &mut Reward
) {
    transition Random::chance(&mut reward_tables.rng, random, 1, 4) {
        true -> enemy_item(reward_tables, enemy, random, reward)
        false -> enemy_gold(reward_tables, enemy, random, reward)
    }


    state enemy_item(
        reward_tables: &mut RewardTables,
        enemy: Enemy,
        random: &mut RandomState,
        reward: &mut Reward
    ) {
        reward.kind = RewardKind::GoldAndItem;
        reward.gold = 1 + enemy.depth + (Random::range(&mut reward_tables.rng, random, 5) as u32 in Wrapping);
        reward.item = RewardTables::roll_item(reward_tables, enemy.depth, random);
    }

    state enemy_gold(
        reward_tables: &mut RewardTables,
        enemy: Enemy,
        random: &mut RandomState,
        reward: &mut Reward
    ) {
        reward.kind = RewardKind::Gold;
        reward.gold = 2 + enemy.depth * 2 + (Random::range(&mut reward_tables.rng, random, 6) as u32 in Wrapping);
        reward.item = ItemKind::RustedDagger;
    }
}

machine RewardTables::roll_item(
    reward_tables: &mut RewardTables,
    depth: u32 in Wrapping,
    random: &mut RandomState
    ) -> ItemKind {
    let roll: u32 in Wrapping = Random::range(&mut reward_tables.rng, random, 100) as u32 in Wrapping;

    let is_early_dagger: bool = depth <= 2 && roll < 50;
    let is_early_buckler: bool = depth <= 3 && roll < 75;
    let is_healing_charm: bool = roll < 85;
    let is_ember_blade: bool = depth >= 5 && roll < 96;
    let is_deep_key: bool = depth >= 8;

    transition {
        is_early_dagger -> ItemKind::RustedDagger
        is_early_buckler -> ItemKind::CrackedBuckler
        is_healing_charm -> ItemKind::HealingCharm
        is_ember_blade -> ItemKind::EmberBlade
        is_deep_key -> ItemKind::DeepKey
        _ -> ItemKind::RustedDagger
    }
}
