use enemies::enemies;
use rng::random;
use rng::random_state;

data EnemyTables {
    rng: Random;
}

machine EnemyTables::roll_enemy(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    enemy: &mut Enemy
) {
    self.roll_enemy_kind(depth, random, enemy);

}

machine EnemyTables::tier_for_depth(
    &mut self,
    depth: u32 in Wrapping
    ) -> EnemyTier {
    let is_bat_depth: bool = depth <= 1;
    let is_spider_depth: bool = depth <= 2;
    let is_skeleton_depth: bool = depth <= 4;
    let is_cultist_depth: bool = depth <= 6;
    let is_hellhound_depth: bool = depth <= 8;

    transition {
        is_bat_depth -> EnemyTier::Bat
        is_spider_depth -> EnemyTier::Spider
        is_skeleton_depth -> EnemyTier::Skeleton
        is_cultist_depth -> EnemyTier::Cultist
        is_hellhound_depth -> EnemyTier::Hellhound
        _ -> EnemyTier::PitFiend
    }
}

machine EnemyTables::roll_enemy_kind(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    enemy: &mut Enemy
) {
    transition self.tier_for_depth(depth) {
        EnemyTier::Bat -> bat(random, enemy)
        EnemyTier::Spider -> spider(random, enemy)
        EnemyTier::Skeleton -> skeleton(random, enemy)
        EnemyTier::Cultist -> cultist(random, enemy)
        EnemyTier::Hellhound -> hellhound(random, enemy)
        EnemyTier::PitFiend -> pit_fiend(random, enemy)
    }


    state bat(
        &mut self,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Bat;
        enemy.name = "Cave Bat";
        enemy.depth = 0;
        enemy.max_health = 6 + self.rng.range(random, 3);
        enemy.health = enemy.max_health;
        enemy.attack = 2;
        enemy.defense = 0;
        enemy.xp_reward = 3;
    }

    state spider(
        &mut self,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Spider;
        enemy.name = "Gloom Spider";
        enemy.depth = 2;
        enemy.max_health = 10 + self.rng.range(random, 5);
        enemy.health = enemy.max_health;
        enemy.attack = 4;
        enemy.defense = 1;
        enemy.xp_reward = 6;
    }

    state skeleton(
        &mut self,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Skeleton;
        enemy.name = "Restless Skeleton";
        enemy.depth = 4;
        enemy.max_health = 18 + self.rng.range(random, 8);
        enemy.health = enemy.max_health;
        enemy.attack = 6;
        enemy.defense = 2;
        enemy.xp_reward = 12;
    }

    state cultist(
        &mut self,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Cultist;
        enemy.name = "Ashen Cultist";
        enemy.depth = 6;
        enemy.max_health = 26 + self.rng.range(random, 12);
        enemy.health = enemy.max_health;
        enemy.attack = 9;
        enemy.defense = 3;
        enemy.xp_reward = 20;
    }

    state hellhound(
        &mut self,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Hellhound;
        enemy.name = "Hellhound";
        enemy.depth = 8;
        enemy.max_health = 42 + self.rng.range(random, 20);
        enemy.health = enemy.max_health;
        enemy.attack = 14;
        enemy.defense = 5;
        enemy.xp_reward = 36;
    }

    state pit_fiend(
        &mut self,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::PitFiend;
        enemy.name = "Pit Fiend";
        enemy.depth = 10;
        enemy.max_health = 80 + self.rng.range(random, 40);
        enemy.health = enemy.max_health;
        enemy.attack = 24;
        enemy.defense = 8;
        enemy.xp_reward = 80;
    }
}
