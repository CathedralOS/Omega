use enemies/enemies.omg;
use rng/random.omg;
use rng/random_state.omg;
use text/buffer.omg;

data EnemyTables {
    rng: |random|::Random;
}

machine roll_enemy(
    enemy_tables: @mutable EnemyTables,
    depth: u32 in Wrapping,
    random: @mutable |random_state|::RandomState,
    enemy: @mutable |enemies|::Enemy
) {
    roll_enemy_kind(enemy_tables, depth, random, enemy);

}

machine tier_for_depth(depth: u32 in Wrapping) -> |enemies|::EnemyTier {
    let is_bat_depth: bool = depth <= 1;
    let is_spider_depth: bool = depth <= 2;
    let is_skeleton_depth: bool = depth <= 4;
    let is_cultist_depth: bool = depth <= 6;
    let is_hellhound_depth: bool = depth <= 8;

    transition {
        is_bat_depth -> |enemies|::EnemyTier::Bat,
        is_spider_depth -> |enemies|::EnemyTier::Spider,
        is_skeleton_depth -> |enemies|::EnemyTier::Skeleton,
        is_cultist_depth -> |enemies|::EnemyTier::Cultist,
        is_hellhound_depth -> |enemies|::EnemyTier::Hellhound,
        _ -> |enemies|::EnemyTier::PitFiend
    }
}

machine roll_enemy_kind(
    enemy_tables: @mutable EnemyTables,
    depth: u32 in Wrapping,
    random: @mutable |random_state|::RandomState,
    enemy: @mutable |enemies|::Enemy
) {
    transition tier_for_depth(depth) {
        |enemies|::EnemyTier::Bat -> bat(enemy_tables, random, enemy),
        |enemies|::EnemyTier::Spider -> spider(enemy_tables, random, enemy),
        |enemies|::EnemyTier::Skeleton -> skeleton(enemy_tables, random, enemy),
        |enemies|::EnemyTier::Cultist -> cultist(enemy_tables, random, enemy),
        |enemies|::EnemyTier::Hellhound -> hellhound(enemy_tables, random, enemy),
        |enemies|::EnemyTier::PitFiend -> pit_fiend(enemy_tables, random, enemy)
    }


    machine bat(
        enemy_tables: @mutable EnemyTables,
        random: @mutable |random_state|::RandomState,
        enemy: @mutable |enemies|::Enemy
    ) {
        enemy.kind = |enemies|::EnemyKind::Bat;
        |buffer|::enemy_name_set(@mutable enemy.name, "Cave Bat" as + |buffer|::Ascii);
        enemy.depth = 0u32 as +Wrapping;
        enemy.max_health = 6 + (|random|::range(@mutable enemy_tables.rng, random, 3u32 as +Wrapping) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 2i32 as +Wrapping;
        enemy.defense = 0i32 as +Wrapping;
        enemy.xp_reward = 3u32 as +Wrapping;
    }

    machine spider(
        enemy_tables: @mutable EnemyTables,
        random: @mutable |random_state|::RandomState,
        enemy: @mutable |enemies|::Enemy
    ) {
        enemy.kind = |enemies|::EnemyKind::Spider;
        |buffer|::enemy_name_set(@mutable enemy.name, "Gloom Spider" as + |buffer|::Ascii);
        enemy.depth = 2u32 as +Wrapping;
        enemy.max_health = 10 + (|random|::range(@mutable enemy_tables.rng, random, 5u32 as +Wrapping) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 4i32 as +Wrapping;
        enemy.defense = 1i32 as +Wrapping;
        enemy.xp_reward = 6u32 as +Wrapping;
    }

    machine skeleton(
        enemy_tables: @mutable EnemyTables,
        random: @mutable |random_state|::RandomState,
        enemy: @mutable |enemies|::Enemy
    ) {
        enemy.kind = |enemies|::EnemyKind::Skeleton;
        |buffer|::enemy_name_set(@mutable enemy.name, "Restless Skeleton" as + |buffer|::Ascii);
        enemy.depth = 4u32 as +Wrapping;
        enemy.max_health = 18 + (|random|::range(@mutable enemy_tables.rng, random, 8u32 as +Wrapping) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 6i32 as +Wrapping;
        enemy.defense = 2i32 as +Wrapping;
        enemy.xp_reward = 12u32 as +Wrapping;
    }

    machine cultist(
        enemy_tables: @mutable EnemyTables,
        random: @mutable |random_state|::RandomState,
        enemy: @mutable |enemies|::Enemy
    ) {
        enemy.kind = |enemies|::EnemyKind::Cultist;
        |buffer|::enemy_name_set(@mutable enemy.name, "Ashen Cultist" as + |buffer|::Ascii);
        enemy.depth = 6u32 as +Wrapping;
        enemy.max_health = 26 + (|random|::range(@mutable enemy_tables.rng, random, 12u32 as +Wrapping) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 9i32 as +Wrapping;
        enemy.defense = 3i32 as +Wrapping;
        enemy.xp_reward = 20u32 as +Wrapping;
    }

    machine hellhound(
        enemy_tables: @mutable EnemyTables,
        random: @mutable |random_state|::RandomState,
        enemy: @mutable |enemies|::Enemy
    ) {
        enemy.kind = |enemies|::EnemyKind::Hellhound;
        |buffer|::enemy_name_set(@mutable enemy.name, "Hellhound" as + |buffer|::Ascii);
        enemy.depth = 8u32 as +Wrapping;
        enemy.max_health = 42 + (|random|::range(@mutable enemy_tables.rng, random, 20u32 as +Wrapping) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 14i32 as +Wrapping;
        enemy.defense = 5i32 as +Wrapping;
        enemy.xp_reward = 36u32 as +Wrapping;
    }

    machine pit_fiend(
        enemy_tables: @mutable EnemyTables,
        random: @mutable |random_state|::RandomState,
        enemy: @mutable |enemies|::Enemy
    ) {
        enemy.kind = |enemies|::EnemyKind::PitFiend;
        |buffer|::enemy_name_set(@mutable enemy.name, "Pit Fiend" as + |buffer|::Ascii);
        enemy.depth = 10u32 as +Wrapping;
        enemy.max_health = 80 + (|random|::range(@mutable enemy_tables.rng, random, 40u32 as +Wrapping) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 24i32 as +Wrapping;
        enemy.defense = 8i32 as +Wrapping;
        enemy.xp_reward = 80u32 as +Wrapping;
    }
}
