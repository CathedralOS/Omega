use text;
use rng\Random;
use rng\RandomState;
use rng\range;
use text\enemy_name_set;

data EnemyTables {
    rng: Random;
}

machine roll_enemy(
    enemy_tables: @mutable EnemyTables,
    depth: u32 in Wrapping,
    random: @mutable RandomState,
    enemy: @mutable Enemy
) {
    roll_enemy_kind(enemy_tables, depth, random, enemy);

}

machine tier_for_depth(depth: u32 in Wrapping) -> EnemyTier {
    let is_bat_depth: bool = depth <= 1;
    let is_spider_depth: bool = depth <= 2;
    let is_skeleton_depth: bool = depth <= 4;
    let is_cultist_depth: bool = depth <= 6;
    let is_hellhound_depth: bool = depth <= 8;

    transition {
        is_bat_depth -> EnemyTier::Bat,
        is_spider_depth -> EnemyTier::Spider,
        is_skeleton_depth -> EnemyTier::Skeleton,
        is_cultist_depth -> EnemyTier::Cultist,
        is_hellhound_depth -> EnemyTier::Hellhound,
        _ -> EnemyTier::PitFiend
    }
}

machine roll_enemy_kind(
    enemy_tables: @mutable EnemyTables,
    depth: u32 in Wrapping,
    random: @mutable RandomState,
    enemy: @mutable Enemy
) {
    transition tier_for_depth(depth) {
        EnemyTier::Bat -> bat(enemy_tables, random, enemy),
        EnemyTier::Spider -> spider(enemy_tables, random, enemy),
        EnemyTier::Skeleton -> skeleton(enemy_tables, random, enemy),
        EnemyTier::Cultist -> cultist(enemy_tables, random, enemy),
        EnemyTier::Hellhound -> hellhound(enemy_tables, random, enemy),
        EnemyTier::PitFiend -> pit_fiend(enemy_tables, random, enemy)
    }


    machine bat(
        enemy_tables: @mutable EnemyTables,
        random: @mutable RandomState,
        enemy: @mutable Enemy
    ) {
        enemy.kind = EnemyKind::Bat;
        enemy_name_set(@mutable enemy.name, "Cave Bat" as +Ascii);
        enemy.depth = 0u32 as +Wrapping;
        enemy.max_health = 6 + ((range(@mutable enemy_tables.rng, random, 3u32 as +Wrapping) as i32) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 2i32 as +Wrapping;
        enemy.defense = 0i32 as +Wrapping;
        enemy.xp_reward = 3u32 as +Wrapping;
    }

    machine spider(
        enemy_tables: @mutable EnemyTables,
        random: @mutable RandomState,
        enemy: @mutable Enemy
    ) {
        enemy.kind = EnemyKind::Spider;
        enemy_name_set(@mutable enemy.name, "Gloom Spider" as +Ascii);
        enemy.depth = 2u32 as +Wrapping;
        enemy.max_health = 10 + ((range(@mutable enemy_tables.rng, random, 5u32 as +Wrapping) as i32) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 4i32 as +Wrapping;
        enemy.defense = 1i32 as +Wrapping;
        enemy.xp_reward = 6u32 as +Wrapping;
    }

    machine skeleton(
        enemy_tables: @mutable EnemyTables,
        random: @mutable RandomState,
        enemy: @mutable Enemy
    ) {
        enemy.kind = EnemyKind::Skeleton;
        enemy_name_set(@mutable enemy.name, "Restless Skeleton" as +Ascii);
        enemy.depth = 4u32 as +Wrapping;
        enemy.max_health = 18 + ((range(@mutable enemy_tables.rng, random, 8u32 as +Wrapping) as i32) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 6i32 as +Wrapping;
        enemy.defense = 2i32 as +Wrapping;
        enemy.xp_reward = 12u32 as +Wrapping;
    }

    machine cultist(
        enemy_tables: @mutable EnemyTables,
        random: @mutable RandomState,
        enemy: @mutable Enemy
    ) {
        enemy.kind = EnemyKind::Cultist;
        enemy_name_set(@mutable enemy.name, "Ashen Cultist" as +Ascii);
        enemy.depth = 6u32 as +Wrapping;
        enemy.max_health = 26 + ((range(@mutable enemy_tables.rng, random, 12u32 as +Wrapping) as i32) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 9i32 as +Wrapping;
        enemy.defense = 3i32 as +Wrapping;
        enemy.xp_reward = 20u32 as +Wrapping;
    }

    machine hellhound(
        enemy_tables: @mutable EnemyTables,
        random: @mutable RandomState,
        enemy: @mutable Enemy
    ) {
        enemy.kind = EnemyKind::Hellhound;
        enemy_name_set(@mutable enemy.name, "Hellhound" as +Ascii);
        enemy.depth = 8u32 as +Wrapping;
        enemy.max_health = 42 + ((range(@mutable enemy_tables.rng, random, 20u32 as +Wrapping) as i32) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 14i32 as +Wrapping;
        enemy.defense = 5i32 as +Wrapping;
        enemy.xp_reward = 36u32 as +Wrapping;
    }

    machine pit_fiend(
        enemy_tables: @mutable EnemyTables,
        random: @mutable RandomState,
        enemy: @mutable Enemy
    ) {
        enemy.kind = EnemyKind::PitFiend;
        enemy_name_set(@mutable enemy.name, "Pit Fiend" as +Ascii);
        enemy.depth = 10u32 as +Wrapping;
        enemy.max_health = 80 + ((range(@mutable enemy_tables.rng, random, 40u32 as +Wrapping) as i32) as i32 +Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 24i32 as +Wrapping;
        enemy.defense = 8i32 as +Wrapping;
        enemy.xp_reward = 80u32 as +Wrapping;
    }
}
