use text::buffer;
use enemies::enemies;
use rng::random;
use rng::random_state;

data EnemyTables {
    rng: Random;
}

machine EnemyTables::roll_enemy(
    enemy_tables: &mut EnemyTables,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    enemy: &mut Enemy
) {
    EnemyTables::roll_enemy_kind(enemy_tables, depth, random, enemy);

}

machine EnemyTables::tier_for_depth(depth: u32 in Wrapping) -> EnemyTier {
    let is_bat_depth: bool = depth <= 1;
    let is_spider_depth: bool = depth <= 2;
    let is_skeleton_depth: bool = depth <= 4;
    let is_cultist_depth: bool = depth <= 6;
    let is_hellhound_depth: bool = depth <= 8;

    transition {
        is_bat_depth -> EnemyTier::Bat
        is_spider_depth -> EnemyTier::Spider
        is_skeleton_depth -> EnemyTier::Skeleton
        is_cultist_depth -> EnemyTier::Cultist
        is_hellhound_depth -> EnemyTier::Hellhound
        _ -> EnemyTier::PitFiend
    }
}

machine EnemyTables::roll_enemy_kind(
    enemy_tables: &mut EnemyTables,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    enemy: &mut Enemy
) {
    transition EnemyTables::tier_for_depth(depth) {
        EnemyTier::Bat -> bat(enemy_tables, random, enemy)
        EnemyTier::Spider -> spider(enemy_tables, random, enemy)
        EnemyTier::Skeleton -> skeleton(enemy_tables, random, enemy)
        EnemyTier::Cultist -> cultist(enemy_tables, random, enemy)
        EnemyTier::Hellhound -> hellhound(enemy_tables, random, enemy)
        EnemyTier::PitFiend -> pit_fiend(enemy_tables, random, enemy)
    }


    state bat(
        enemy_tables: &mut EnemyTables,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Bat;
        EnemyName::set(&mut enemy.name, "Cave Bat");
        enemy.depth = 0;
        enemy.max_health = 6 + ((Random::range(&mut enemy_tables.rng, random, 3) as i32) as i32 in Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 2;
        enemy.defense = 0;
        enemy.xp_reward = 3;
    }

    state spider(
        enemy_tables: &mut EnemyTables,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Spider;
        EnemyName::set(&mut enemy.name, "Gloom Spider");
        enemy.depth = 2;
        enemy.max_health = 10 + ((Random::range(&mut enemy_tables.rng, random, 5) as i32) as i32 in Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 4;
        enemy.defense = 1;
        enemy.xp_reward = 6;
    }

    state skeleton(
        enemy_tables: &mut EnemyTables,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Skeleton;
        EnemyName::set(&mut enemy.name, "Restless Skeleton");
        enemy.depth = 4;
        enemy.max_health = 18 + ((Random::range(&mut enemy_tables.rng, random, 8) as i32) as i32 in Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 6;
        enemy.defense = 2;
        enemy.xp_reward = 12;
    }

    state cultist(
        enemy_tables: &mut EnemyTables,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Cultist;
        EnemyName::set(&mut enemy.name, "Ashen Cultist");
        enemy.depth = 6;
        enemy.max_health = 26 + ((Random::range(&mut enemy_tables.rng, random, 12) as i32) as i32 in Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 9;
        enemy.defense = 3;
        enemy.xp_reward = 20;
    }

    state hellhound(
        enemy_tables: &mut EnemyTables,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::Hellhound;
        EnemyName::set(&mut enemy.name, "Hellhound");
        enemy.depth = 8;
        enemy.max_health = 42 + ((Random::range(&mut enemy_tables.rng, random, 20) as i32) as i32 in Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 14;
        enemy.defense = 5;
        enemy.xp_reward = 36;
    }

    state pit_fiend(
        enemy_tables: &mut EnemyTables,
        random: &mut RandomState,
        enemy: &mut Enemy
    ) {
        enemy.kind = EnemyKind::PitFiend;
        EnemyName::set(&mut enemy.name, "Pit Fiend");
        enemy.depth = 10;
        enemy.max_health = 80 + ((Random::range(&mut enemy_tables.rng, random, 40) as i32) as i32 in Wrapping);
        enemy.health = enemy.max_health;
        enemy.attack = 24;
        enemy.defense = 8;
        enemy.xp_reward = 80;
    }
}
