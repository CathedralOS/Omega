use rooms::room_lookup;
use rooms::map;
use rooms::rooms;

data CommandParser {
    lookup: RoomLookup;
}

machine CommandParser::resolve_navigation(
    &mut self,
    level: Level,
    cell: CellId,
    line: &[u8; 256] in Utf8
    ) -> Navigation {
    let choice: NavigationChoice = self.resolve_command(line);

    transition {
        choice == NavigationChoice::Invalid -> self.resolve_exit(level, cell, line)
        choice != NavigationChoice::Invalid -> self.navigation(choice, CellId::Empty)
    }
}

machine CommandParser::resolve_command(
    &mut self,
    line: &[u8; 256] in Utf8
    ) -> NavigationChoice {
    transition {
        line == "quit" -> NavigationChoice::Quit
        line == "exit" -> NavigationChoice::Quit
        line == "look" -> NavigationChoice::Look
        line == "info" -> NavigationChoice::Look
        line == "paths" -> NavigationChoice::Exits
        line == "help" -> NavigationChoice::Exits
        line == "inventory" -> NavigationChoice::Inventory
        line == "inv" -> NavigationChoice::Inventory
        line == "char" -> NavigationChoice::Character
        line == "character" -> NavigationChoice::Character
        line == "stats" -> NavigationChoice::Character
        line == "use" -> NavigationChoice::UseEvent
        line == "fight" -> NavigationChoice::Fight
        _ -> NavigationChoice::Invalid
    }
}

machine CommandParser::resolve_exit(
    &mut self,
    level: Level,
    cell: CellId,
    line: &[u8; 256] in Utf8
    ) -> Navigation {
    transition {
        cell == CellId::R00 && line == "north" -> self.navigation(NavigationChoice::Move, CellId::R01)
        cell == CellId::R01 && line == "south" -> self.navigation(NavigationChoice::Move, CellId::R00)
        cell == CellId::R01 && line == "north" -> self.navigation(NavigationChoice::Move, CellId::R02)
        cell == CellId::R01 && line == "east" -> self.navigation(NavigationChoice::Move, CellId::R05)
        cell == CellId::R02 && line == "south" -> self.navigation(NavigationChoice::Move, CellId::R01)
        cell == CellId::R02 && line == "north" -> self.navigation(NavigationChoice::Move, CellId::R03)
        cell == CellId::R02 && line == "west" -> self.navigation(NavigationChoice::Move, CellId::R06)
        cell == CellId::R03 && line == "south" -> self.navigation(NavigationChoice::Move, CellId::R02)
        cell == CellId::R03 && line == "north" -> self.navigation(NavigationChoice::Move, CellId::R04)
        cell == CellId::R03 && line == "east" -> self.navigation(NavigationChoice::Move, CellId::R07)
        cell == CellId::R04 && line == "south" -> self.navigation(NavigationChoice::Move, CellId::R03)
        cell == CellId::R05 && line == "west" -> self.navigation(NavigationChoice::Move, CellId::R01)
        cell == CellId::R06 && line == "east" -> self.navigation(NavigationChoice::Move, CellId::R02)
        cell == CellId::R07 && line == "west" -> self.navigation(NavigationChoice::Move, CellId::R03)
        _ -> self.invalid_navigation()
    }
}

machine CommandParser::find_exit(
    &mut self,
    room: Room,
    command: &[u8; 256] in Utf8
    ) -> Navigation {
    let exits: &[Exit] = room.exits.as_slice();

    transition room.exit_count > 0 {
        true -> self.find_exit_at(exits, room.exit_count, command, 0)
        false -> self.invalid_navigation()
    }
}

machine CommandParser::find_exit_at(
    &mut self,
    exits: &[Exit],
    exit_count: u64 in Wrapping,
    command: &[u8; 256] in Utf8,
    index: u64 in Wrapping
    ) -> Navigation {
    transition index < exits.len {
        true -> inspect_exit(exits, exit_count, command, index)
        false -> self.invalid_navigation()
    }


    state inspect_exit(
        &mut self,
        exits: &[Exit],
        exit_count: u64 in Wrapping,
        command: &[u8; 256] in Utf8,
        index: u64 in Wrapping
    ) {
        let found: bool = self.direction_matches(exits[index].direction, command);
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < exit_count && next_index < exits.len;

        transition {
            found -> self.navigation(NavigationChoice::Move, exits[index].destination)
            has_next -> find_exit_at(exits, exit_count, command, next_index)
            _ -> self.invalid_navigation()
        }
    }
}

machine CommandParser::invalid_navigation(&mut self) -> Navigation {
    transition {
        _ -> self.navigation(NavigationChoice::Invalid, CellId::Empty)
    }
}

machine CommandParser::direction_matches(
    &mut self,
    direction: Direction,
    command: &[u8; 256] in Utf8
    ) -> bool {
    transition {
        direction == Direction::North && command == "north" -> true
        direction == Direction::South && command == "south" -> true
        direction == Direction::East && command == "east" -> true
        direction == Direction::West && command == "west" -> true
        _ -> false
    }
}

machine CommandParser::navigation(
    &mut self,
    choice: NavigationChoice,
    destination: CellId
    ) -> Navigation {
    Navigation { choice: choice, destination: destination }
}
