use system;
use rooms\CellId;
use rooms\Direction;
use rooms\Exit;
use rooms\Level;
use rooms\Navigation;
use rooms\NavigationChoice;
use rooms\Room;
use rooms\RoomLookup;

data CommandParser {
    lookup: RoomLookup;
}

machine resolve_navigation(
    command_parser: @mutable CommandParser,
    level: Level,
    cell: CellId,
    line: @[u8] in Utf8
    ) -> Navigation {
    let choice: NavigationChoice = resolve_command(line);

    transition choice == NavigationChoice::Invalid {
        true -> resolve_exit(command_parser, level, cell, line),
        false -> navigation(choice, CellId::Empty)
    }
}

machine resolve_command(line: @[u8] in Utf8) -> NavigationChoice {
    let bytes: @[u8] = line as -Utf8;
    transition {
        bytes == "quit" -> NavigationChoice::Quit,
        bytes == "exit" -> NavigationChoice::Quit,
        bytes == "look" -> NavigationChoice::Look,
        bytes == "info" -> NavigationChoice::Look,
        bytes == "paths" -> NavigationChoice::Exits,
        bytes == "help" -> NavigationChoice::Exits,
        bytes == "inventory" -> NavigationChoice::Inventory,
        bytes == "inv" -> NavigationChoice::Inventory,
        bytes == "char" -> NavigationChoice::Character,
        bytes == "character" -> NavigationChoice::Character,
        bytes == "stats" -> NavigationChoice::Character,
        bytes == "use" -> NavigationChoice::UseEvent,
        bytes == "fight" -> NavigationChoice::Fight,
        _ -> NavigationChoice::Invalid
    }
}

machine resolve_exit(
    command_parser: @mutable CommandParser,
    level: Level,
    cell: CellId,
    line: @[u8] in Utf8
    ) -> Navigation {
    let bytes: @[u8] = line as -Utf8;
    transition {
        cell == CellId::R00 && bytes == "north" -> navigation(NavigationChoice::Move, CellId::R01),
        cell == CellId::R01 && bytes == "south" -> navigation(NavigationChoice::Move, CellId::R00),
        cell == CellId::R01 && bytes == "north" -> navigation(NavigationChoice::Move, CellId::R02),
        cell == CellId::R01 && bytes == "east" -> navigation(NavigationChoice::Move, CellId::R05),
        cell == CellId::R02 && bytes == "south" -> navigation(NavigationChoice::Move, CellId::R01),
        cell == CellId::R02 && bytes == "north" -> navigation(NavigationChoice::Move, CellId::R03),
        cell == CellId::R02 && bytes == "west" -> navigation(NavigationChoice::Move, CellId::R06),
        cell == CellId::R03 && bytes == "south" -> navigation(NavigationChoice::Move, CellId::R02),
        cell == CellId::R03 && bytes == "north" -> navigation(NavigationChoice::Move, CellId::R04),
        cell == CellId::R03 && bytes == "east" -> navigation(NavigationChoice::Move, CellId::R07),
        cell == CellId::R04 && bytes == "south" -> navigation(NavigationChoice::Move, CellId::R03),
        cell == CellId::R05 && bytes == "west" -> navigation(NavigationChoice::Move, CellId::R01),
        cell == CellId::R06 && bytes == "east" -> navigation(NavigationChoice::Move, CellId::R02),
        cell == CellId::R07 && bytes == "west" -> navigation(NavigationChoice::Move, CellId::R03),
        _ -> invalid_navigation(command_parser)
    }
}

machine find_exit(
    command_parser: @mutable CommandParser,
    room: Room,
    command: @[u8] in Utf8
    ) -> Navigation {
    let exits: @[Exit] = @room.exits[..];

    transition room.exit_count > 0 {
        true -> find_exit_at(command_parser, exits, room.exit_count, command, 0u64 as +Wrapping),
        false -> invalid_navigation(command_parser)
    }
}

machine find_exit_at(
    command_parser: @mutable CommandParser,
    exits: @[Exit],
    exit_count: u64 in Wrapping,
    command: @[u8] in Utf8,
    index: u64 in Wrapping
    ) -> Navigation {
    transition index < exits.length {
        true -> inspect_exit(command_parser, exits, exit_count, command, index),
        false -> invalid_navigation(command_parser)
    }


    machine inspect_exit(
        command_parser: @mutable CommandParser,
        exits: @[Exit],
        exit_count: u64 in Wrapping,
        command: @[u8] in Utf8,
        index: u64 in Wrapping
    ) -> Navigation {
        let found: bool = direction_matches(exits[index as -Wrapping].direction, command);
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < exit_count && next_index < exits.length;

        transition {
            found -> navigation(NavigationChoice::Move, exits[index as -Wrapping].destination),
            has_next -> find_exit_at(command_parser, exits, exit_count, command, next_index),
            _ -> invalid_navigation(command_parser)
        }
    }
}

machine invalid_navigation(command_parser: @mutable CommandParser) -> Navigation {
    transition {
        _ -> navigation(NavigationChoice::Invalid, CellId::Empty)
    }
}

machine direction_matches(direction: Direction,
    command: @[u8] in Utf8) -> bool {
    let bytes: @[u8] = command as -Utf8;
    transition {
        direction == Direction::North && bytes == "north" -> true,
        direction == Direction::South && bytes == "south" -> true,
        direction == Direction::East && bytes == "east" -> true,
        direction == Direction::West && bytes == "west" -> true,
        _ -> false
    }
}

machine navigation(choice: NavigationChoice,
    destination: CellId) -> Navigation {
    Navigation { choice: choice, destination: destination }
}
