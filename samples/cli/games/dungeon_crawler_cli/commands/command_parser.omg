use rooms/map.omg;
use rooms/room_lookup.omg;
use rooms/rooms.omg;
use {system}/calling.omg;

data CommandParser {
    lookup: |room_lookup|::RoomLookup;
}

machine resolve_navigation(
    command_parser: @mutable CommandParser,
    level: |rooms|::Level,
    cell: |map|::CellId,
    line: @[u8] in |calling|::Utf8
    ) -> |map|::Navigation {
    let choice: |map|::NavigationChoice = resolve_command(line);

    transition choice == |map|::NavigationChoice::Invalid {
        true -> resolve_exit(command_parser, level, cell, line),
        false -> navigation(choice, |map|::CellId::Empty)
    }
}

machine resolve_command(line: @[u8] in |calling|::Utf8) -> |map|::NavigationChoice {
    let bytes: @[u8] = line as - |calling|::Utf8;
    transition {
        bytes == "quit" -> |map|::NavigationChoice::Quit,
        bytes == "exit" -> |map|::NavigationChoice::Quit,
        bytes == "look" -> |map|::NavigationChoice::Look,
        bytes == "info" -> |map|::NavigationChoice::Look,
        bytes == "paths" -> |map|::NavigationChoice::Exits,
        bytes == "help" -> |map|::NavigationChoice::Exits,
        bytes == "inventory" -> |map|::NavigationChoice::Inventory,
        bytes == "inv" -> |map|::NavigationChoice::Inventory,
        bytes == "char" -> |map|::NavigationChoice::Character,
        bytes == "character" -> |map|::NavigationChoice::Character,
        bytes == "stats" -> |map|::NavigationChoice::Character,
        bytes == "use" -> |map|::NavigationChoice::UseEvent,
        bytes == "fight" -> |map|::NavigationChoice::Fight,
        _ -> |map|::NavigationChoice::Invalid
    }
}

machine resolve_exit(
    command_parser: @mutable CommandParser,
    level: |rooms|::Level,
    cell: |map|::CellId,
    line: @[u8] in |calling|::Utf8
    ) -> |map|::Navigation {
    let bytes: @[u8] = line as - |calling|::Utf8;
    transition {
        cell == |map|::CellId::R00 && bytes == "north" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R01),
        cell == |map|::CellId::R01 && bytes == "south" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R00),
        cell == |map|::CellId::R01 && bytes == "north" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R02),
        cell == |map|::CellId::R01 && bytes == "east" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R05),
        cell == |map|::CellId::R02 && bytes == "south" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R01),
        cell == |map|::CellId::R02 && bytes == "north" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R03),
        cell == |map|::CellId::R02 && bytes == "west" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R06),
        cell == |map|::CellId::R03 && bytes == "south" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R02),
        cell == |map|::CellId::R03 && bytes == "north" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R04),
        cell == |map|::CellId::R03 && bytes == "east" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R07),
        cell == |map|::CellId::R04 && bytes == "south" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R03),
        cell == |map|::CellId::R05 && bytes == "west" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R01),
        cell == |map|::CellId::R06 && bytes == "east" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R02),
        cell == |map|::CellId::R07 && bytes == "west" -> navigation(|map|::NavigationChoice::Move, |map|::CellId::R03),
        _ -> invalid_navigation(command_parser)
    }
}

machine find_exit(
    command_parser: @mutable CommandParser,
    room: |rooms|::Room,
    command: @[u8] in |calling|::Utf8
    ) -> |map|::Navigation {
    let exits: @[|rooms|::Exit] = @room.exits[..];

    transition room.exit_count > 0 {
        true -> find_exit_at(command_parser, exits, room.exit_count, command, 0u64 as +Wrapping),
        false -> invalid_navigation(command_parser)
    }
}

machine find_exit_at(
    command_parser: @mutable CommandParser,
    exits: @[|rooms|::Exit],
    exit_count: u64 in Wrapping,
    command: @[u8] in |calling|::Utf8,
    index: u64 in Wrapping
    ) -> |map|::Navigation {
    transition index < exits.length {
        true -> inspect_exit(command_parser, exits, exit_count, command, index),
        false -> invalid_navigation(command_parser)
    }


    machine inspect_exit(
        command_parser: @mutable CommandParser,
        exits: @[|rooms|::Exit],
        exit_count: u64 in Wrapping,
        command: @[u8] in |calling|::Utf8,
        index: u64 in Wrapping
    ) -> |map|::Navigation {
        let found: bool = direction_matches(exits[index as -Wrapping].direction, command);
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < exit_count && next_index < exits.length;

        transition {
            found -> navigation(|map|::NavigationChoice::Move, exits[index as -Wrapping].destination),
            has_next -> find_exit_at(command_parser, exits, exit_count, command, next_index),
            _ -> invalid_navigation(command_parser)
        }
    }
}

machine invalid_navigation(command_parser: @mutable CommandParser) -> |map|::Navigation {
    transition {
        _ -> navigation(|map|::NavigationChoice::Invalid, |map|::CellId::Empty)
    }
}

machine direction_matches(direction: |map|::Direction,
    command: @[u8] in |calling|::Utf8) -> bool {
    let bytes: @[u8] = command as - |calling|::Utf8;
    transition {
        direction == |map|::Direction::North && bytes == "north" -> true,
        direction == |map|::Direction::South && bytes == "south" -> true,
        direction == |map|::Direction::East && bytes == "east" -> true,
        direction == |map|::Direction::West && bytes == "west" -> true,
        _ -> false
    }
}

machine navigation(choice: |map|::NavigationChoice,
    destination: |map|::CellId) -> |map|::Navigation {
    |map|::Navigation { choice: choice, destination: destination }
}
