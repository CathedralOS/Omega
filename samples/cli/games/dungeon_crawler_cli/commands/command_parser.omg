use rooms::room_lookup;
use rooms::map;
use rooms::rooms;

data CommandParser {
    lookup: RoomLookup;
}

machine CommandParser::resolve_navigation(
    command_parser: &mut CommandParser,
    level: Level,
    cell: CellId,
    line: &[u8; 256] in Utf8
    ) -> Navigation {
    let choice: NavigationChoice = CommandParser::resolve_command(line);

    transition choice == NavigationChoice::Invalid {
        true -> CommandParser::resolve_exit(command_parser, level, cell, line)
        false -> CommandParser::navigation(choice, CellId::Empty)
    }
}

machine CommandParser::resolve_command(line: &[u8; 256] in Utf8) -> NavigationChoice {
    transition {
        line == "quit" -> NavigationChoice::Quit
        line == "exit" -> NavigationChoice::Quit
        line == "look" -> NavigationChoice::Look
        line == "info" -> NavigationChoice::Look
        line == "paths" -> NavigationChoice::Exits
        line == "help" -> NavigationChoice::Exits
        line == "inventory" -> NavigationChoice::Inventory
        line == "inv" -> NavigationChoice::Inventory
        line == "char" -> NavigationChoice::Character
        line == "character" -> NavigationChoice::Character
        line == "stats" -> NavigationChoice::Character
        line == "use" -> NavigationChoice::UseEvent
        line == "fight" -> NavigationChoice::Fight
        _ -> NavigationChoice::Invalid
    }
}

machine CommandParser::resolve_exit(
    command_parser: &mut CommandParser,
    level: Level,
    cell: CellId,
    line: &[u8; 256] in Utf8
    ) -> Navigation {
    transition {
        cell == CellId::R00 && line == "north" -> CommandParser::navigation(NavigationChoice::Move, CellId::R01)
        cell == CellId::R01 && line == "south" -> CommandParser::navigation(NavigationChoice::Move, CellId::R00)
        cell == CellId::R01 && line == "north" -> CommandParser::navigation(NavigationChoice::Move, CellId::R02)
        cell == CellId::R01 && line == "east" -> CommandParser::navigation(NavigationChoice::Move, CellId::R05)
        cell == CellId::R02 && line == "south" -> CommandParser::navigation(NavigationChoice::Move, CellId::R01)
        cell == CellId::R02 && line == "north" -> CommandParser::navigation(NavigationChoice::Move, CellId::R03)
        cell == CellId::R02 && line == "west" -> CommandParser::navigation(NavigationChoice::Move, CellId::R06)
        cell == CellId::R03 && line == "south" -> CommandParser::navigation(NavigationChoice::Move, CellId::R02)
        cell == CellId::R03 && line == "north" -> CommandParser::navigation(NavigationChoice::Move, CellId::R04)
        cell == CellId::R03 && line == "east" -> CommandParser::navigation(NavigationChoice::Move, CellId::R07)
        cell == CellId::R04 && line == "south" -> CommandParser::navigation(NavigationChoice::Move, CellId::R03)
        cell == CellId::R05 && line == "west" -> CommandParser::navigation(NavigationChoice::Move, CellId::R01)
        cell == CellId::R06 && line == "east" -> CommandParser::navigation(NavigationChoice::Move, CellId::R02)
        cell == CellId::R07 && line == "west" -> CommandParser::navigation(NavigationChoice::Move, CellId::R03)
        _ -> CommandParser::invalid_navigation(command_parser)
    }
}

machine CommandParser::find_exit(
    command_parser: &mut CommandParser,
    room: Room,
    command: &[u8; 256] in Utf8
    ) -> Navigation {
    let exits: &[Exit] = &room.exits[..];

    transition room.exit_count > 0 {
        true -> CommandParser::find_exit_at(command_parser, exits, room.exit_count, command, 0)
        false -> CommandParser::invalid_navigation(command_parser)
    }
}

machine CommandParser::find_exit_at(
    command_parser: &mut CommandParser,
    exits: &[Exit],
    exit_count: u64 in Wrapping,
    command: &[u8; 256] in Utf8,
    index: u64 in Wrapping
    ) -> Navigation {
    transition index < exits.len {
        true -> inspect_exit(command_parser, exits, exit_count, command, index)
        false -> CommandParser::invalid_navigation(command_parser)
    }


    state inspect_exit(
        command_parser: &mut CommandParser,
        exits: &[Exit],
        exit_count: u64 in Wrapping,
        command: &[u8; 256] in Utf8,
        index: u64 in Wrapping
    ) {
        let found: bool = CommandParser::direction_matches(exits[index].direction, command);
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < exit_count && next_index < exits.len;

        transition {
            found -> CommandParser::navigation(NavigationChoice::Move, exits[index].destination)
            has_next -> find_exit_at(command_parser, exits, exit_count, command, next_index)
            _ -> CommandParser::invalid_navigation(command_parser)
        }
    }
}

machine CommandParser::invalid_navigation(command_parser: &mut CommandParser) -> Navigation {
    transition {
        _ -> CommandParser::navigation(NavigationChoice::Invalid, CellId::Empty)
    }
}

machine CommandParser::direction_matches(direction: Direction,
    command: &[u8; 256] in Utf8) -> bool {
    transition {
        direction == Direction::North && command == "north" -> true
        direction == Direction::South && command == "south" -> true
        direction == Direction::East && command == "east" -> true
        direction == Direction::West && command == "west" -> true
        _ -> false
    }
}

machine CommandParser::navigation(choice: NavigationChoice,
    destination: CellId) -> Navigation {
    Navigation { choice: choice, destination: destination }
}
