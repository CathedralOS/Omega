use enemies/enemies.omg;
use rewards/rewards.omg;

data RoomEventKind [copy] {
    case Nothing;
    case FountainOfLife;
    case Treasure;
    case GoldCache;
    case Enemy;
}

data RoomEventAction [copy] {
    case Quiet;
    case Fountain;
    case Reward;
    case Enemy;
}

data RoomEvent [copy] {
    kind: RoomEventKind;
    enemy: |enemies|::Enemy;
    reward: |rewards|::Reward;
    consumed: bool;
}
