use enemies\EnemyTables;
use enemies\roll_enemy;
use rewards\RewardKind;
use rewards\RewardTables;
use rewards\roll_gold_cache;
use rewards\roll_room_treasure;
use rng\Random;
use rng\RandomState;
use rng\range;

data RoomEvents {
    enemies: EnemyTables;
    rewards: RewardTables;
    rng: Random;
}

machine roll_event(
    room_events: @mutable RoomEvents,
    depth: u32 in Wrapping,
    random: @mutable RandomState,
    event: @mutable RoomEvent
) {
    let roll: u32 in Wrapping = range(@mutable room_events.rng, random, 100u32 as +Wrapping) as u32 +Wrapping;
    apply_event(room_events, depth, random, event, roll);

}

machine event_action(roll: u32 in Wrapping) -> RoomEventAction {
    let is_quiet: bool = roll < 20;
    let is_fountain: bool = roll < 30;
    let is_reward: bool = roll < 60;

    transition {
        is_quiet -> RoomEventAction::Quiet,
        is_fountain -> RoomEventAction::Fountain,
        is_reward -> RoomEventAction::Reward,
        _ -> RoomEventAction::Enemy
    }
}

machine apply_event(
    room_events: @mutable RoomEvents,
    depth: u32 in Wrapping,
    random: @mutable RandomState,
    event: @mutable RoomEvent,
    roll: u32 in Wrapping
) {
    transition event_action(roll) {
        RoomEventAction::Quiet -> no_event(event),
        RoomEventAction::Fountain -> fountain(event),
        RoomEventAction::Reward -> reward_event(room_events, depth, random, event, roll),
        RoomEventAction::Enemy -> enemy(room_events, depth, random, event)
    }


    machine reward_event(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable RandomState,
        event: @mutable RoomEvent,
        roll: u32 in Wrapping
    ) {
        transition roll < 45 {
            true -> treasure(room_events, depth, random, event),
            false -> gold_cache(room_events, depth, random, event)
        }
    }

    machine no_event(event: @mutable RoomEvent) {
        event.kind = RoomEventKind::Nothing;
        event.consumed = true;
        event.reward.kind = RewardKind::None;
    }

    machine fountain(event: @mutable RoomEvent) {
        event.kind = RoomEventKind::FountainOfLife;
        event.consumed = false;
        event.reward.kind = RewardKind::None;
    }

    machine treasure(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable RandomState,
        event: @mutable RoomEvent
    ) {
        event.kind = RoomEventKind::Treasure;
        event.consumed = false;
        roll_room_treasure(@mutable room_events.rewards, depth, random, @mutable event.reward);
    }

    machine gold_cache(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable RandomState,
        event: @mutable RoomEvent
    ) {
        event.kind = RoomEventKind::GoldCache;
        event.consumed = false;
        roll_gold_cache(@mutable room_events.rewards, depth, random, @mutable event.reward);
    }

    machine enemy(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable RandomState,
        event: @mutable RoomEvent
    ) {
        event.kind = RoomEventKind::Enemy;
        event.consumed = false;
        roll_enemy(@mutable room_events.enemies, depth, random, @mutable event.enemy);
    }
}
