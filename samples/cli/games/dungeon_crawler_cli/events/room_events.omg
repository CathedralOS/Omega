use enemies/enemy_tables.omg;
use events/events.omg;
use rewards/reward_tables.omg;
use rewards/rewards.omg;
use rng/random.omg;
use rng/random_state.omg;

data RoomEvents {
    enemies: |enemy_tables|::EnemyTables;
    rewards: |reward_tables|::RewardTables;
    rng: |random|::Random;
}

machine roll_event(
    room_events: @mutable RoomEvents,
    depth: u32 in Wrapping,
    random: @mutable |random_state|::RandomState,
    event: @mutable |events|::RoomEvent
) {
    let roll: u32 in Wrapping = |random|::range(@mutable room_events.rng, random, 100u32 as +Wrapping) as +Wrapping;
    apply_event(room_events, depth, random, event, roll);

}

machine event_action(roll: u32 in Wrapping) -> |events|::RoomEventAction {
    let is_quiet: bool = roll < 20;
    let is_fountain: bool = roll < 30;
    let is_reward: bool = roll < 60;

    transition {
        is_quiet -> |events|::RoomEventAction::Quiet,
        is_fountain -> |events|::RoomEventAction::Fountain,
        is_reward -> |events|::RoomEventAction::Reward,
        _ -> |events|::RoomEventAction::Enemy
    }
}

machine apply_event(
    room_events: @mutable RoomEvents,
    depth: u32 in Wrapping,
    random: @mutable |random_state|::RandomState,
    event: @mutable |events|::RoomEvent,
    roll: u32 in Wrapping
) {
    transition event_action(roll) {
        |events|::RoomEventAction::Quiet -> no_event(event),
        |events|::RoomEventAction::Fountain -> fountain(event),
        |events|::RoomEventAction::Reward -> reward_event(room_events, depth, random, event, roll),
        |events|::RoomEventAction::Enemy -> enemy(room_events, depth, random, event)
    }


    machine reward_event(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable |random_state|::RandomState,
        event: @mutable |events|::RoomEvent,
        roll: u32 in Wrapping
    ) {
        transition roll < 45 {
            true -> treasure(room_events, depth, random, event),
            false -> gold_cache(room_events, depth, random, event)
        }
    }

    machine no_event(event: @mutable |events|::RoomEvent) {
        event.kind = |events|::RoomEventKind::Nothing;
        event.consumed = true;
        event.reward.kind = |rewards|::RewardKind::None;
    }

    machine fountain(event: @mutable |events|::RoomEvent) {
        event.kind = |events|::RoomEventKind::FountainOfLife;
        event.consumed = false;
        event.reward.kind = |rewards|::RewardKind::None;
    }

    machine treasure(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable |random_state|::RandomState,
        event: @mutable |events|::RoomEvent
    ) {
        event.kind = |events|::RoomEventKind::Treasure;
        event.consumed = false;
        |reward_tables|::roll_room_treasure(@mutable room_events.rewards, depth, random, @mutable event.reward);
    }

    machine gold_cache(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable |random_state|::RandomState,
        event: @mutable |events|::RoomEvent
    ) {
        event.kind = |events|::RoomEventKind::GoldCache;
        event.consumed = false;
        |reward_tables|::roll_gold_cache(@mutable room_events.rewards, depth, random, @mutable event.reward);
    }

    machine enemy(
        room_events: @mutable RoomEvents,
        depth: u32 in Wrapping,
        random: @mutable |random_state|::RandomState,
        event: @mutable |events|::RoomEvent
    ) {
        event.kind = |events|::RoomEventKind::Enemy;
        event.consumed = false;
        |enemy_tables|::roll_enemy(@mutable room_events.enemies, depth, random, @mutable event.enemy);
    }
}
