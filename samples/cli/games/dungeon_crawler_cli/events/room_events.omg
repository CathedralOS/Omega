use events::events;
use enemies::enemy_tables;
use rewards::reward_tables;
use rewards::rewards;
use rng::random;
use rng::random_state;

data RoomEvents {
    enemies: EnemyTables;
    rewards: RewardTables;
    rng: Random;
}

machine RoomEvents::roll_event(
    room_events: &mut RoomEvents,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    event: &mut RoomEvent
) {
    let roll: u32 in Wrapping = Random::range(&mut room_events.rng, random, 100) as u32 in Wrapping;
    RoomEvents::apply_event(room_events, depth, random, event, roll);

}

machine RoomEvents::event_action(roll: u32 in Wrapping) -> RoomEventAction {
    let is_quiet: bool = roll < 20;
    let is_fountain: bool = roll < 30;
    let is_reward: bool = roll < 60;

    transition {
        is_quiet -> RoomEventAction::Quiet
        is_fountain -> RoomEventAction::Fountain
        is_reward -> RoomEventAction::Reward
        _ -> RoomEventAction::Enemy
    }
}

machine RoomEvents::apply_event(
    room_events: &mut RoomEvents,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    event: &mut RoomEvent,
    roll: u32 in Wrapping
) {
    transition RoomEvents::event_action(roll) {
        RoomEventAction::Quiet -> no_event(event)
        RoomEventAction::Fountain -> fountain(event)
        RoomEventAction::Reward -> reward_event(room_events, depth, random, event, roll)
        RoomEventAction::Enemy -> enemy(room_events, depth, random, event)
    }


    machine reward_event(
        room_events: &mut RoomEvents,
        depth: u32 in Wrapping,
        random: &mut RandomState,
        event: &mut RoomEvent,
        roll: u32 in Wrapping
    ) {
        transition roll < 45 {
            true -> treasure(room_events, depth, random, event)
            false -> gold_cache(room_events, depth, random, event)
        }
    }

    machine no_event(event: &mut RoomEvent) {
        event.kind = RoomEventKind::Nothing;
        event.consumed = true;
        event.reward.kind = RewardKind::None;
    }

    machine fountain(event: &mut RoomEvent) {
        event.kind = RoomEventKind::FountainOfLife;
        event.consumed = false;
        event.reward.kind = RewardKind::None;
    }

    machine treasure(
        room_events: &mut RoomEvents,
        depth: u32 in Wrapping,
        random: &mut RandomState,
        event: &mut RoomEvent
    ) {
        event.kind = RoomEventKind::Treasure;
        event.consumed = false;
        RewardTables::roll_room_treasure(&mut room_events.rewards, depth, random, &mut event.reward);
    }

    machine gold_cache(
        room_events: &mut RoomEvents,
        depth: u32 in Wrapping,
        random: &mut RandomState,
        event: &mut RoomEvent
    ) {
        event.kind = RoomEventKind::GoldCache;
        event.consumed = false;
        RewardTables::roll_gold_cache(&mut room_events.rewards, depth, random, &mut event.reward);
    }

    machine enemy(
        room_events: &mut RoomEvents,
        depth: u32 in Wrapping,
        random: &mut RandomState,
        event: &mut RoomEvent
    ) {
        event.kind = RoomEventKind::Enemy;
        event.consumed = false;
        EnemyTables::roll_enemy(&mut room_events.enemies, depth, random, &mut event.enemy);
    }
}
