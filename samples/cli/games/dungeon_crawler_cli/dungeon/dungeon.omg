use text::buffer;
use omega_language_std::math;

use enemies::enemies;
use events::event_runtime;
use events::events;
use generation::dungeon_generator;
use inventory::items;
use combat::combat_round;
use player::player;
use player::player_state;
use rewards::rewards;
use rng::random;
use rng::random_state;
use rooms::map;
use rooms::room_lookup;
use rooms::rooms;

data Dungeon {
    generator: DungeonGenerator;
    events: EventRuntime;
    player_system: PlayerSystem;
    lookup: RoomLookup;
    rng: Random;

    current_cell: CellId;
    level: Level;
    navigation: Navigation;
    player: Player;
    random: RandomState;
    combat_round: CombatRound;
    mode: GameMode;
    treasure_taken: bool;
    gold_taken: bool;
    fountain_used: bool;
    enemy_defeated: bool;
}

machine Dungeon::enter_room(cell: CellId) {
    // Discovery is currently presentation-only for the generated sample. Avoid
    // dynamic room lookup here until slice-returned mutable references are solid.
}

machine Dungeon::use_event(
    dungeon: &mut Dungeon,
    cell: CellId,
    line: &mut TextBuffer
)
{
    transition cell {
        CellId::R02 -> try_take_treasure(dungeon, line)
        CellId::R04 -> try_use_fountain(dungeon, line)
        CellId::R05 -> try_take_gold(dungeon, line)
        _ -> no_usable_event(line)
    }

    state try_take_treasure(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.treasure_taken {
            false -> take_treasure(dungeon, line)
            true -> no_usable_event(line)
        }
    }

    state take_treasure(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 24;
        dungeon.treasure_taken = true;
        TextBuffer::set(line, "You take the treasure.");
    }

    state try_use_fountain(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.fountain_used {
            false -> use_fountain(dungeon, line)
            true -> no_usable_event(line)
        }
    }

    state use_fountain(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.health = min_i32(dungeon.player.max_health as i32, (dungeon.player.health + 12) as i32) as i32 in Wrapping;
        dungeon.fountain_used = true;
        TextBuffer::set(line, "The fountain heals your wounds.");
    }

    state try_take_gold(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.gold_taken {
            false -> take_gold(dungeon, line)
            true -> no_usable_event(line)
        }
    }

    state take_gold(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 6;
        dungeon.gold_taken = true;
        TextBuffer::set(line, "You collect the loose gold.");
    }

    state no_usable_event(line: &mut TextBuffer) {
        TextBuffer::set(line, "There is nothing here to use.");
    }
}

machine Dungeon::fight(
    dungeon: &mut Dungeon,
    cell: CellId,
    line: &mut TextBuffer
)
{
    transition cell {
        CellId::R03 -> try_defeat_enemy(dungeon, line)
        _ -> no_enemy(line)
    }

    state try_defeat_enemy(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.enemy_defeated {
            false -> defeat_enemy(dungeon, line)
            true -> no_enemy(line)
        }
    }

    state defeat_enemy(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 6;
        dungeon.player.xp = dungeon.player.xp + 5;
        dungeon.enemy_defeated = true;
        TextBuffer::set(line, "The enemy collapses. You find a little gold.");
    }

    state no_enemy(line: &mut TextBuffer) {
        TextBuffer::set(line, "There is no enemy here.");
    }
}

machine Dungeon::move(dungeon: &mut Dungeon) {
    dungeon.current_cell = dungeon.navigation.destination;
}

machine Dungeon::move_to(
    dungeon: &mut Dungeon,
    destination: CellId
) {
    dungeon.current_cell = destination;
}

machine Dungeon::current_room_index(dungeon: &mut Dungeon) -> u64 {
    Dungeon::room_index(dungeon.current_cell)
}

machine Dungeon::can_travel_to(destination: CellId) -> bool {
    transition {
        destination == CellId::Empty -> false
        _ -> true
    }
}

machine Dungeon::evaluate_travel_block(
    dungeon: &mut Dungeon,
    current_room: Room,
    destination_room: Room
) -> bool {
    transition {
        current_room.event.kind == RoomEventKind::Enemy && current_room.event.consumed == false -> Dungeon::gated_enemy_travel(current_room, destination_room)
        _ -> true
    }
}

machine Dungeon::gated_enemy_travel(current_room: Room,
    destination_room: Room) -> bool {
    transition {
        _ -> (destination_room.depth <= current_room.depth)
    }
}

machine Dungeon::game_over(dungeon: &mut Dungeon) {
    dungeon.mode = GameMode::GameOver;
}

machine Dungeon::initialize(
    dungeon: &mut Dungeon,
    seed: u64 in Wrapping
) {
    PlayerSystem::create(&mut dungeon.player_system, "Wanderer", &mut dungeon.player);
    Random::seed(seed, &mut dungeon.random);
    DungeonGenerator::generate(&mut dungeon.generator, seed, &mut dungeon.level);
    dungeon.current_cell = dungeon.level.start_cell;
    dungeon.mode = GameMode::Exploring;
    dungeon.treasure_taken = false;
    dungeon.gold_taken = false;
    dungeon.fountain_used = false;
    dungeon.enemy_defeated = false;
}

machine Dungeon::room_index(cell: CellId) -> u64 {
    transition {
        cell == CellId::R00 -> 0
        cell == CellId::R01 -> 1
        cell == CellId::R02 -> 2
        cell == CellId::R03 -> 3
        cell == CellId::R04 -> 4
        cell == CellId::R05 -> 5
        cell == CellId::R06 -> 6
        cell == CellId::R07 -> 7
        cell == CellId::R08 -> 8
        cell == CellId::R09 -> 9
        cell == CellId::R10 -> 10
        cell == CellId::R11 -> 11
        cell == CellId::R12 -> 12
        cell == CellId::R13 -> 13
        cell == CellId::R14 -> 14
        _ -> 15
    }
}
