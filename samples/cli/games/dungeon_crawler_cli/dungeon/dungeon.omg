use combat/combat_round.omg;
use events/event_runtime.omg;
use events/events.omg;
use generation/dungeon_generator.omg;
use player/player.omg;
use player/player_state.omg;
use rng/random.omg;
use rng/random_state.omg;
use rooms/map.omg;
use rooms/room_lookup.omg;
use rooms/rooms.omg;
use text/buffer.omg;
use {omega}/language/core/math.omg;

data Dungeon {
    generator: |dungeon_generator|::DungeonGenerator;
    events: |event_runtime|::EventRuntime;
    player_system: |player|::PlayerSystem;
    lookup: |room_lookup|::RoomLookup;
    rng: |random|::Random;

    current_cell: |map|::CellId;
    level: |rooms|::Level;
    navigation: |map|::Navigation;
    player: |player_state|::Player;
    random: |random_state|::RandomState;
    combat_round: |combat_round|::CombatRound;
    mode: |map|::GameMode;
    treasure_taken: bool;
    gold_taken: bool;
    fountain_used: bool;
    enemy_defeated: bool;
}

machine dungeon_enter_room(cell: |map|::CellId) {
    // Discovery is currently presentation-only for the generated sample. Avoid
    // dynamic room lookup here until slice-returned mutable references are solid.
}

machine dungeon_use_event(
    dungeon: @mutable Dungeon,
    cell: |map|::CellId,
    line: @mutable |buffer|::TextBuffer
)
{
    transition cell {
        |map|::CellId::R02 -> try_take_treasure(dungeon, line),
        |map|::CellId::R04 -> try_use_fountain(dungeon, line),
        |map|::CellId::R05 -> try_take_gold(dungeon, line),
        _ -> no_usable_event(line)
    }

    machine try_take_treasure(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        transition dungeon.treasure_taken {
            false -> take_treasure(dungeon, line),
            true -> no_usable_event(line)
        }
    }

    machine take_treasure(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 24;
        dungeon.treasure_taken = true;
        |buffer|::text_buffer_set(line, "You take the treasure." as + |buffer|::Ascii);
    }

    machine try_use_fountain(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        transition dungeon.fountain_used {
            false -> use_fountain(dungeon, line),
            true -> no_usable_event(line)
        }
    }

    machine use_fountain(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        dungeon.player.health = |math|::min_i32(dungeon.player.max_health as -Wrapping, (dungeon.player.health + 12) as -Wrapping) as +Wrapping;
        dungeon.fountain_used = true;
        |buffer|::text_buffer_set(line, "The fountain heals your wounds." as + |buffer|::Ascii);
    }

    machine try_take_gold(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        transition dungeon.gold_taken {
            false -> take_gold(dungeon, line),
            true -> no_usable_event(line)
        }
    }

    machine take_gold(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 6;
        dungeon.gold_taken = true;
        |buffer|::text_buffer_set(line, "You collect the loose gold." as + |buffer|::Ascii);
    }

    machine no_usable_event(line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(line, "There is nothing here to use." as + |buffer|::Ascii);
    }
}

machine dungeon_fight(
    dungeon: @mutable Dungeon,
    cell: |map|::CellId,
    line: @mutable |buffer|::TextBuffer
)
{
    transition cell {
        |map|::CellId::R03 -> try_defeat_enemy(dungeon, line),
        _ -> no_enemy(line)
    }

    machine try_defeat_enemy(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        transition dungeon.enemy_defeated {
            false -> defeat_enemy(dungeon, line),
            true -> no_enemy(line)
        }
    }

    machine defeat_enemy(
        dungeon: @mutable Dungeon,
        line: @mutable |buffer|::TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 6;
        dungeon.player.xp = dungeon.player.xp + 5;
        dungeon.enemy_defeated = true;
        |buffer|::text_buffer_set(line, "The enemy collapses. You find a little gold." as + |buffer|::Ascii);
    }

    machine no_enemy(line: @mutable |buffer|::TextBuffer) {
        |buffer|::text_buffer_set(line, "There is no enemy here." as + |buffer|::Ascii);
    }
}

machine move(dungeon: @mutable Dungeon) {
    dungeon.current_cell = dungeon.navigation.destination;
}

machine move_to(
    dungeon: @mutable Dungeon,
    destination: |map|::CellId
) {
    dungeon.current_cell = destination;
}

machine current_room_index(dungeon: @mutable Dungeon) -> u64 {
    room_index(dungeon.current_cell)
}

machine can_travel_to(destination: |map|::CellId) -> bool {
    transition {
        destination == |map|::CellId::Empty -> false,
        _ -> true
    }
}

machine evaluate_travel_block(
    dungeon: @mutable Dungeon,
    current_room: |rooms|::Room,
    destination_room: |rooms|::Room
) -> bool {
    transition {
        current_room.event.kind == |events|::RoomEventKind::Enemy && current_room.event.consumed == false -> gated_enemy_travel(current_room, destination_room),
        _ -> true
    }
}

machine gated_enemy_travel(current_room: |rooms|::Room,
    destination_room: |rooms|::Room) -> bool {
    transition {
        _ -> (destination_room.depth <= current_room.depth)
    }
}

machine dungeon_game_over(dungeon: @mutable Dungeon) {
    dungeon.mode = |map|::GameMode::GameOver;
}

machine dungeon_initialize(
    dungeon: @mutable Dungeon,
    seed: u64 in Wrapping
) {
    |player|::create(@mutable dungeon.player_system, "Wanderer" as + |buffer|::Ascii, @mutable dungeon.player);
    |random|::seed(seed, @mutable dungeon.random);
    |dungeon_generator|::generate(@mutable dungeon.generator, seed, @mutable dungeon.level);
    dungeon.current_cell = dungeon.level.start_cell;
    dungeon.mode = |map|::GameMode::Exploring;
    dungeon.treasure_taken = false;
    dungeon.gold_taken = false;
    dungeon.fountain_used = false;
    dungeon.enemy_defeated = false;
}

machine room_index(cell: |map|::CellId) -> u64 {
    transition {
        cell == |map|::CellId::R00 -> 0,
        cell == |map|::CellId::R01 -> 1,
        cell == |map|::CellId::R02 -> 2,
        cell == |map|::CellId::R03 -> 3,
        cell == |map|::CellId::R04 -> 4,
        cell == |map|::CellId::R05 -> 5,
        cell == |map|::CellId::R06 -> 6,
        cell == |map|::CellId::R07 -> 7,
        cell == |map|::CellId::R08 -> 8,
        cell == |map|::CellId::R09 -> 9,
        cell == |map|::CellId::R10 -> 10,
        cell == |map|::CellId::R11 -> 11,
        cell == |map|::CellId::R12 -> 12,
        cell == |map|::CellId::R13 -> 13,
        cell == |map|::CellId::R14 -> 14,
        _ -> 15
    }
}
