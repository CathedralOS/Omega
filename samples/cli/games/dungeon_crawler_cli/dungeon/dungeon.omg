use omega::language::core::min_i32;


data Dungeon {
    generator: DungeonGenerator;
    events: EventRuntime;
    player_system: PlayerSystem;
    lookup: RoomLookup;
    rng: Random;

    current_cell: CellId;
    level: Level;
    navigation: Navigation;
    player: Player;
    random: RandomState;
    combat_round: CombatRound;
    mode: GameMode;
    treasure_taken: bool;
    gold_taken: bool;
    fountain_used: bool;
    enemy_defeated: bool;
}

machine dungeon_enter_room(cell: CellId) {
    // Discovery is currently presentation-only for the generated sample. Avoid
    // dynamic room lookup here until slice-returned mutable references are solid.
}

machine dungeon_use_event(
    dungeon: &mut Dungeon,
    cell: CellId,
    line: &mut TextBuffer
)
{
    transition cell {
        CellId::R02 -> try_take_treasure(dungeon, line)
        CellId::R04 -> try_use_fountain(dungeon, line)
        CellId::R05 -> try_take_gold(dungeon, line)
        _ -> no_usable_event(line)
    }

    machine try_take_treasure(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.treasure_taken {
            false -> take_treasure(dungeon, line)
            true -> no_usable_event(line)
        }
    }

    machine take_treasure(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 24;
        dungeon.treasure_taken = true;
        text_buffer_set(line, "You take the treasure.");
    }

    machine try_use_fountain(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.fountain_used {
            false -> use_fountain(dungeon, line)
            true -> no_usable_event(line)
        }
    }

    machine use_fountain(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.health = min_i32(dungeon.player.max_health as i32, (dungeon.player.health + 12) as i32) as i32 in Wrapping;
        dungeon.fountain_used = true;
        text_buffer_set(line, "The fountain heals your wounds.");
    }

    machine try_take_gold(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.gold_taken {
            false -> take_gold(dungeon, line)
            true -> no_usable_event(line)
        }
    }

    machine take_gold(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 6;
        dungeon.gold_taken = true;
        text_buffer_set(line, "You collect the loose gold.");
    }

    machine no_usable_event(line: &mut TextBuffer) {
        text_buffer_set(line, "There is nothing here to use.");
    }
}

machine dungeon_fight(
    dungeon: &mut Dungeon,
    cell: CellId,
    line: &mut TextBuffer
)
{
    transition cell {
        CellId::R03 -> try_defeat_enemy(dungeon, line)
        _ -> no_enemy(line)
    }

    machine try_defeat_enemy(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        transition dungeon.enemy_defeated {
            false -> defeat_enemy(dungeon, line)
            true -> no_enemy(line)
        }
    }

    machine defeat_enemy(
        dungeon: &mut Dungeon,
        line: &mut TextBuffer
    ) {
        dungeon.player.inventory.gold = dungeon.player.inventory.gold + 6;
        dungeon.player.xp = dungeon.player.xp + 5;
        dungeon.enemy_defeated = true;
        text_buffer_set(line, "The enemy collapses. You find a little gold.");
    }

    machine no_enemy(line: &mut TextBuffer) {
        text_buffer_set(line, "There is no enemy here.");
    }
}

machine move(dungeon: &mut Dungeon) {
    dungeon.current_cell = dungeon.navigation.destination;
}

machine move_to(
    dungeon: &mut Dungeon,
    destination: CellId
) {
    dungeon.current_cell = destination;
}

machine current_room_index(dungeon: &mut Dungeon) -> u64 {
    room_index(dungeon.current_cell)
}

machine can_travel_to(destination: CellId) -> bool {
    transition {
        destination == CellId::Empty -> false
        _ -> true
    }
}

machine evaluate_travel_block(
    dungeon: &mut Dungeon,
    current_room: Room,
    destination_room: Room
) -> bool {
    transition {
        current_room.event.kind == RoomEventKind::Enemy && current_room.event.consumed == false -> gated_enemy_travel(current_room, destination_room)
        _ -> true
    }
}

machine gated_enemy_travel(current_room: Room,
    destination_room: Room) -> bool {
    transition {
        _ -> (destination_room.depth <= current_room.depth)
    }
}

machine dungeon_game_over(dungeon: &mut Dungeon) {
    dungeon.mode = GameMode::GameOver;
}

machine dungeon_initialize(
    dungeon: &mut Dungeon,
    start_seed: u64 in Wrapping
) {
    create(&mut dungeon.player_system, "Wanderer", &mut dungeon.player);
    seed(start_seed, &mut dungeon.random);
    generate(&mut dungeon.generator, start_seed, &mut dungeon.level);
    dungeon.current_cell = dungeon.level.start_cell;
    dungeon.mode = GameMode::Exploring;
    dungeon.treasure_taken = false;
    dungeon.gold_taken = false;
    dungeon.fountain_used = false;
    dungeon.enemy_defeated = false;
}

machine room_index(cell: CellId) -> u64 {
    transition {
        cell == CellId::R00 -> 0
        cell == CellId::R01 -> 1
        cell == CellId::R02 -> 2
        cell == CellId::R03 -> 3
        cell == CellId::R04 -> 4
        cell == CellId::R05 -> 5
        cell == CellId::R06 -> 6
        cell == CellId::R07 -> 7
        cell == CellId::R08 -> 8
        cell == CellId::R09 -> 9
        cell == CellId::R10 -> 10
        cell == CellId::R11 -> 11
        cell == CellId::R12 -> 12
        cell == CellId::R13 -> 13
        cell == CellId::R14 -> 14
        _ -> 15
    }
}
