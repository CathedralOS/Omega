use {omega}/language/core/byte_observation/byte_observation.omg;

// Explicit text storage; domains never supply a length word.
public domain [u8; 128]::Ascii requires |byte_observation|::ascii_only(@self[..]);
public domain [u8]::Ascii requires |byte_observation|::ascii_only(@self[..]);
data TextBuffer [copy] requires used <= 128 { storage: [u8; 128] in Ascii; used: u64; }
machine text_buffer_live(buffer: @TextBuffer) -> @[u8] in Ascii {
    let prefix: @[u8] = @(@buffer.storage as -Ascii)[..buffer.used];
    prefix as +Ascii
}
machine text_buffer_copy(buffer: @mutable [u8; 128] in Ascii, bytes: @[u8] in Ascii, start: u64)
requires start <= 128, bytes.length <= 128 - start
ensures buffer in Ascii
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    machine copying(buffer: @mutable [u8; 128] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 128, index <= 128
    ensures buffer in Ascii
    {
        transition index < bytes.length && start + index < 128 {
            true -> writing(buffer, bytes, start, index),
            _ -> done()
        }
    }
    machine writing(buffer: @mutable [u8; 128] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 128, index < 128, index < bytes.length, start + index < 128
    ensures buffer in Ascii
    {
        (@mutable buffer as -Ascii)[start + index] = (bytes as -Ascii)[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    machine done() {}
}

machine text_buffer_set(buffer: @mutable TextBuffer, bytes: @[u8] in Ascii)
requires bytes.length <= 128
{
    text_buffer_copy(@mutable buffer.storage, bytes, 0);
    buffer.used = bytes.length;
}
machine join(buffer: @mutable TextBuffer, left: @[u8] in Ascii, right: @[u8] in Ascii)
requires left.length <= 24, right.length <= 100
{
    text_buffer_copy(@mutable buffer.storage, left, 0);
    text_buffer_copy(@mutable buffer.storage, right, left.length);
    buffer.used = left.length + right.length;
}

// Explicit owner retains its original 8-byte capacity.
public domain [u8; 8]::Ascii requires |byte_observation|::ascii_only(@self[..]);
data ExitCommand [copy] requires used <= 8 { storage: [u8; 8] in Ascii; used: u64; }
machine exit_command_live(buffer: @ExitCommand) -> @[u8] in Ascii
ensures result.length == buffer.used && result.length <= 8
{
    let prefix: @[u8] = @(@buffer.storage as -Ascii)[..buffer.used];
    prefix as +Ascii
}
machine exit_command_copy(buffer: @mutable [u8; 8] in Ascii, bytes: @[u8] in Ascii, start: u64)
requires start <= 8, bytes.length <= 8 - start
ensures buffer in Ascii
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    machine copying(buffer: @mutable [u8; 8] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 8, index <= 8
    ensures buffer in Ascii
    {
        transition index < bytes.length && start + index < 8 {
            true -> writing(buffer, bytes, start, index),
            _ -> done()
        }
    }
    machine writing(buffer: @mutable [u8; 8] in Ascii, bytes: @[u8] in Ascii, start: u64, index: u64)
    requires start <= 8, index < 8, index < bytes.length, start + index < 8
    ensures buffer in Ascii
    {
        (@mutable buffer as -Ascii)[start + index] = (bytes as -Ascii)[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    machine done() {}
}

machine exit_command_set(buffer: @mutable ExitCommand, bytes: @[u8] in Ascii)
requires bytes.length <= 8
{
    exit_command_copy(@mutable buffer.storage, bytes, 0);
    buffer.used = bytes.length;
}

