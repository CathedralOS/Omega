// Explicit text storage; domains never supply a length word.
domain [u8; 128]::Ascii(bytes) requires ascii_only(bytes);
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
data TextBuffer [copy] where used <= 128 { storage: [u8; 128] in Ascii; used: u64; }
machine TextBuffer::live(buffer: &TextBuffer) -> &[u8] in Ascii { &buffer.storage[..buffer.used] }
machine TextBuffer::copy(buffer: &mut [u8; 128] in Ascii, bytes: &[u8] in Ascii, start: u64)
requires start <= 128; bytes.len <= 128 - start
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    state copying(buffer: &mut [u8; 128] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 128; index <= 128
    {
        transition index < bytes.len && start + index < 128 {
            true -> writing(buffer, bytes, start, index)
            _ -> done()
        }
    }
    state writing(buffer: &mut [u8; 128] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 128; index < 128; index < bytes.len; start + index < 128
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    state done() {}
}

machine TextBuffer::set(buffer: &mut TextBuffer, bytes: &[u8] in Ascii)
requires bytes.len <= 128
{
    TextBuffer::copy(&mut buffer.storage, bytes, 0);
    buffer.used = bytes.len;
}
machine TextBuffer::join(buffer: &mut TextBuffer, left: &[u8] in Ascii, right: &[u8] in Ascii)
requires left.len <= 24; right.len <= 100
{
    TextBuffer::copy(&mut buffer.storage, left, 0);
    TextBuffer::copy(&mut buffer.storage, right, left.len);
    buffer.used = left.len + right.len;
}

// Explicit owner retains its original 8-byte capacity.
domain [u8; 8]::Ascii(bytes) requires ascii_only(bytes);
data ExitCommand [copy] where used <= 8 { storage: [u8; 8] in Ascii; used: u64; }
machine ExitCommand::live(buffer: &ExitCommand) -> &[u8] in Ascii
ensures result.len == buffer.used && result.len <= 8
{ &buffer.storage[..buffer.used] }
machine ExitCommand::copy(buffer: &mut [u8; 8] in Ascii, bytes: &[u8] in Ascii, start: u64)
requires start <= 8; bytes.len <= 8 - start
{
    transition { _ -> copying(buffer, bytes, start, 0) }
    state copying(buffer: &mut [u8; 8] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 8; index <= 8
    {
        transition index < bytes.len && start + index < 8 {
            true -> writing(buffer, bytes, start, index)
            _ -> done()
        }
    }
    state writing(buffer: &mut [u8; 8] in Ascii, bytes: &[u8] in Ascii, start: u64, index: u64)
    requires start <= 8; index < 8; index < bytes.len; start + index < 8
    {
        buffer[start + index] = bytes[index];
        transition { _ -> copying(buffer, bytes, start, index + 1) }
    }
    state done() {}
}

machine ExitCommand::set(buffer: &mut ExitCommand, bytes: &[u8] in Ascii)
requires bytes.len <= 8
{
    ExitCommand::copy(&mut buffer.storage, bytes, 0);
    buffer.used = bytes.len;
}

