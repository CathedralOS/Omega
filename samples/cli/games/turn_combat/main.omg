use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use omega\language\core\ProcessExit;
// A turn-based combat simulator -- a small but complete app that stresses how the
// pieces compose: two `Fighter` records (hp + attack), damage ARITHMETIC
// (`hp = (hp - attacker.attack) % 101`, fully Exact via the modular idiom: the
// `% 101` lands the result provably back inside hp's -100..=100 bound, and for
// every value these fights can produce, `x % 101 == x`, so the fold is exact and
// no overflow domain is needed), and a genuine state-machine LOOP where
// `hero_attacks` and `monster_attacks` transition back and forth until one
// combatant's hp drops to 0 or below. The hero (30 hp, 7 atk) out-damages the
// monster (25 hp, 5 atk) and wins. Exits 1 if the hero wins, 2 if the monster wins.
// Expected exit: 1.

use system\Console;

data Fighter requires -100 <= hp, hp <= 100, 0 <= attack, attack <= 10 {
    hp: i32;
    attack: i32;
}

data Main {
    hero: Fighter;
    monster: Fighter;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches ProcessExit + StandardInput + StandardOutput {
    Console::write_line("turn_combat: hero (30hp/7atk) and monster (25hp/5atk) trade blows");
    main.hero.hp = 30;
    main.hero.attack = 7;
    main.monster.hp = 25;
    main.monster.attack = 5;

    transition { _ -> block hero_attacks(main) }

    machine hero_attacks(main: @mutable Main) {
        main.monster.hp = (main.monster.hp - main.hero.attack) % 101;
        transition main.monster.hp <= 0 {
            true -> block hero_wins(main),
            _ -> block monster_attacks(main)
        }
    }

    machine monster_attacks(main: @mutable Main) {
        main.hero.hp = (main.hero.hp - main.monster.attack) % 101;
        transition main.hero.hp <= 0 {
            true -> block monster_wins(main),
            _ -> block hero_attacks(main)
        }
    }

    machine hero_wins(main: @mutable Main) {
        Console::write_line("PASS: the hero out-damaged the monster and won (exit 1)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(1);
    }
    machine monster_wins(main: @mutable Main) {
        Console::write_line("result: the monster won this fight (exit 2)");
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(@mutable main.pause[..]);
        ProcessExit::exit_process(2);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + StandardInput + StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
