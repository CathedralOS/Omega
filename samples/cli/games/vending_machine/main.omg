// Expected exit: 70.
// A vending machine driven by a stream of case-payload events.
//
// Showcases features landed in the 2026-06 waves working together in one
// program: `case` members with named payloads, type properties on plain
// data, payload binding in transition arms, and value-position machine
// calls. The exit code reports the final dispensed total so the run is
// verifiable end to end (expected: 70).

use omega_language_std::console;

// A coin or a button press. `Insert` carries how many cents arrived; `Press`
// carries which slot was chosen. Tag zero selects the first case, so a zeroed
// Event has the `Idle` representation.
data Event {
    case Idle;
    case Insert(cents: i32 in Saturating);
    case Press(slot: i32 in Saturating);
}

// The running register. `[copy]` is a verified declared property:
// every field is a scalar (copy holds) and zero is the empty machine (no
// balance, nothing dispensed).
data Register [copy] {
    balance: i32 in Saturating;
    dispensed: i32 in Saturating;
}

data Main {
    console: Console;
    register: Register;
    pause: [u8; 256];
}

machine Main::main(&mut self) {
    self.console.write_line("vending_machine: folds insert/insert/press events through a coin register");
    // Three events: insert 50c, insert 25c, press slot 1 (price 75c).
    self.apply(Event::Insert { cents: 50 });
    self.apply(Event::Insert { cents: 25 });
    self.apply(Event::Press { slot: 1 });

    // After the press the balance should be spent and 75c of product
    // dispensed; encode "balance 0 and dispensed 75" as exit 70.
    transition self.register.balance == 0 {
        true -> check_dispensed()
        false -> bad_balance()
    }

    state check_dispensed(&mut self) {
        transition self.register.dispensed == 75 {
            true -> good_verdict()
            false -> bad_dispensed()
        }
    }

    state good_verdict(&mut self) {
        self.console.write_line("PASS: balance spent and 75c dispensed (exit 70)");
        transition { _ -> report(70) }
    }

    state bad_balance(&mut self) {
        self.console.write_line("FAIL: the balance was not fully spent (exit 71)");
        transition { _ -> report(71) }
    }

    state bad_dispensed(&mut self) {
        self.console.write_line("FAIL: dispensed total was not 75 cents (exit 72)");
        transition { _ -> report(72) }
    }

    state report(&mut self, code: i32 in Saturating) {
        self.console.write_line("[press Enter to close]");
        self.console.read_line(&mut self.pause);
        self.console.exit_process(code as i32);
    }
}

// Fold one event into the register. Coins add to the balance; a press that
// the balance covers dispenses the price and spends the balance.
machine Main::apply(&mut self, event: Event) {
    transition event {
        Event::Insert { cents } -> add_balance(cents)
        Event::Press { slot } -> try_dispense(slot)
        _ -> idle()
    }

    state add_balance(&mut self, cents: i32 in Saturating) {
        self.register.balance = self.register.balance + cents;
    }

    state try_dispense(&mut self, slot: i32 in Saturating) {
        let price: i32 in Saturating = self.price_of(slot);
        transition self.register.balance >= price {
            true -> dispense(price)
            false -> idle()
        }
    }

    state dispense(&mut self, price: i32 in Saturating) {
        self.register.dispensed = self.register.dispensed + price;
        self.register.balance = 0;
    }

    state idle(&mut self) {
    }
}

// Slot 1 costs 75 cents; everything else is free (price 0) for this demo.
machine Main::price_of(&mut self, slot: i32 in Saturating) -> i32 in Saturating {
    transition slot == 1 {
        true -> seventy_five()
        _ -> zero()
    }

    state seventy_five(&mut self) -> i32 in Saturating {
        transition {
            _ -> 75
        }
    }

    state zero(&mut self) -> i32 in Saturating {
        transition {
            _ -> 0
        }
    }
}
