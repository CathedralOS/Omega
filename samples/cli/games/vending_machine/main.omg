use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
// Expected exit: 70.
// A vending machine driven by a stream of case-payload events.
//
// Showcases features landed in the 2026-06 waves working together in one
// program: `case` members with named payloads, type properties on plain
// data, payload binding in transition arms, and value-position machine
// calls. The exit code reports the final dispensed total so the run is
// verifiable end to end (expected: 70).


// A coin or a button press. `Insert` carries how many cents arrived; `Press`
// carries which slot was chosen. Tag zero selects the first case, so a zeroed
// Event has the `Idle` representation.
data Event {
    case Idle;
    case Insert(cents: i32 in Saturating);
    case Press(slot: i32 in Saturating);
}

// The running register. `[copy]` is a verified declared property:
// every field is a scalar (copy holds) and zero is the empty machine (no
// balance, nothing dispensed).
data Register [copy] {
    balance: i32 in Saturating;
    dispensed: i32 in Saturating;
}

data Main {
    register: Register;
    pause: [u8; 256];
}

machine main(main: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    |console|::Console::write_line("vending_machine: folds insert/insert/press events through a coin register");
    // Three events: insert 50c, insert 25c, press slot 1 (price 75c).
    apply(main, Event::Insert { cents: 50 as +Saturating });
    apply(main, Event::Insert { cents: 25 as +Saturating });
    apply(main, Event::Press { slot: 1 as +Saturating });

    // After the press the balance should be spent and 75c of product
    // dispensed; encode "balance 0 and dispensed 75" as exit 70.
    transition main.register.balance == 0 {
        true -> block check_dispensed(main),
        false -> block bad_balance(main)
    }

    machine check_dispensed(main: @mutable Main) {
        transition main.register.dispensed == 75 {
            true -> block good_verdict(main),
            false -> block bad_dispensed(main)
        }
    }

    machine good_verdict(main: @mutable Main) {
        |console|::Console::write_line("PASS: balance spent and 75c dispensed (exit 70)");
        transition { _ -> block report(main, 70 as +Saturating) }
    }

    machine bad_balance(main: @mutable Main) {
        |console|::Console::write_line("FAIL: the balance was not fully spent (exit 71)");
        transition { _ -> block report(main, 71 as +Saturating) }
    }

    machine bad_dispensed(main: @mutable Main) {
        |console|::Console::write_line("FAIL: dispensed total was not 75 cents (exit 72)");
        transition { _ -> block report(main, 72 as +Saturating) }
    }

    machine report(main: @mutable Main, code: i32 in Saturating) {
        |console|::Console::write_line("[press Enter to close]");
        _ = block |console|::Console::read_line(@mutable main.pause[..]);
        |process_exit|::ProcessExit::exit_process(code as i32);
    }
}

// Fold one event into the register. Coins add to the balance; a press that
// the balance covers dispenses the price and spends the balance.
machine apply(main: @mutable Main, event: Event) {
    transition event {
        Event::Insert { cents } -> add_balance(main, cents),
        Event::Press { slot } -> try_dispense(main, slot),
        _ -> idle()
    }

    machine add_balance(main: @mutable Main, cents: i32 in Saturating) {
        main.register.balance = main.register.balance + cents;
    }

    machine try_dispense(main: @mutable Main, slot: i32 in Saturating) {
        let price: i32 in Saturating = price_of(slot);
        transition main.register.balance >= price {
            true -> dispense(main, price),
            false -> idle()
        }
    }

    machine dispense(main: @mutable Main, price: i32 in Saturating) {
        main.register.dispensed = main.register.dispensed + price;
        main.register.balance = 0 as +Saturating;
    }

    machine idle() {
    }
}

// Slot 1 costs 75 cents; everything else is free (price 0) for this demo.
machine price_of(slot: i32 in Saturating) -> i32 in Saturating {
    transition slot == 1 {
        true -> seventy_five(),
        _ -> zero()
    }

    machine seventy_five() -> i32 in Saturating {
        transition {
            _ -> 75 as +Saturating
        }
    }

    machine zero() -> i32 in Saturating {
        transition {
            _ -> 0 as +Saturating
        }
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
