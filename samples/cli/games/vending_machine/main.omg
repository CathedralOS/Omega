// Expected exit: 70.
// A vending machine driven by a stream of case-payload events.
//
// Showcases features landed in the 2026-06 waves working together in one
// program: `case` members with named payloads, type properties on plain
// data, payload binding in transition arms, and value-position machine
// calls. The exit code reports the final dispensed total so the run is
// verifiable end to end (expected: 70).

use omega_language_std::console;

// A coin or a button press. `Insert` carries how many cents arrived; `Press`
// carries which slot was chosen. Tag zero selects the first case, so a zeroed
// Event has the `Idle` representation.
data Event {
    case Idle;
    case Insert(cents: i32 in Saturating);
    case Press(slot: i32 in Saturating);
}

// The running register. `[copy]` is a verified declared property:
// every field is a scalar (copy holds) and zero is the empty machine (no
// balance, nothing dispensed).
data Register [copy] {
    balance: i32 in Saturating;
    dispensed: i32 in Saturating;
}

data Main {
    register: Register;
    pause: [u8; 256];
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("vending_machine: folds insert/insert/press events through a coin register");
    // Three events: insert 50c, insert 25c, press slot 1 (price 75c).
    Main::apply(main, Event::Insert { cents: 50 });
    Main::apply(main, Event::Insert { cents: 25 });
    Main::apply(main, Event::Press { slot: 1 });

    // After the press the balance should be spent and 75c of product
    // dispensed; encode "balance 0 and dispensed 75" as exit 70.
    transition main.register.balance == 0 {
        true -> check_dispensed(main)
        false -> bad_balance(main)
    }

    state check_dispensed(main: &mut Main) {
        transition main.register.dispensed == 75 {
            true -> good_verdict(main)
            false -> bad_dispensed(main)
        }
    }

    state good_verdict(main: &mut Main) {
        Console::write_line("PASS: balance spent and 75c dispensed (exit 70)");
        transition { _ -> report(main, 70) }
    }

    state bad_balance(main: &mut Main) {
        Console::write_line("FAIL: the balance was not fully spent (exit 71)");
        transition { _ -> report(main, 71) }
    }

    state bad_dispensed(main: &mut Main) {
        Console::write_line("FAIL: dispensed total was not 75 cents (exit 72)");
        transition { _ -> report(main, 72) }
    }

    state report(main: &mut Main, code: i32 in Saturating) {
        Console::write_line("[press Enter to close]");
        _ = block Console::read_line(&mut main.pause);
        Console::exit_process(code as i32);
    }
}

// Fold one event into the register. Coins add to the balance; a press that
// the balance covers dispenses the price and spends the balance.
machine Main::apply(main: &mut Main, event: Event) {
    transition event {
        Event::Insert { cents } -> add_balance(main, cents)
        Event::Press { slot } -> try_dispense(main, slot)
        _ -> idle()
    }

    state add_balance(main: &mut Main, cents: i32 in Saturating) {
        main.register.balance = main.register.balance + cents;
    }

    state try_dispense(main: &mut Main, slot: i32 in Saturating) {
        let price: i32 in Saturating = Main::price_of(slot);
        transition main.register.balance >= price {
            true -> dispense(main, price)
            false -> idle()
        }
    }

    state dispense(main: &mut Main, price: i32 in Saturating) {
        main.register.dispensed = main.register.dispensed + price;
        main.register.balance = 0;
    }

    state idle() {
    }
}

// Slot 1 costs 75 cents; everything else is free (price 0) for this demo.
machine Main::price_of(slot: i32 in Saturating) -> i32 in Saturating {
    transition slot == 1 {
        true -> seventy_five()
        _ -> zero()
    }

    state seventy_five() -> i32 in Saturating {
        transition {
            _ -> 75
        }
    }

    state zero() -> i32 in Saturating {
        transition {
            _ -> 0
        }
    }
}
