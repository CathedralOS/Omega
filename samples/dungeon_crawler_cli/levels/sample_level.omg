use data::dungeon_types;

machine SampleLevel {
    state write(mut out_level: Level) {
        out_level.start_cell = CellId::A1;
        out_level.room_count = 4;
        write_room_a1(mut out_level.rooms[0]);
        write_room_a2(mut out_level.rooms[1]);
        write_room_b1(mut out_level.rooms[2]);
        write_room_b2(mut out_level.rooms[3]);
    }

    state write_room_a1(mut room: Room) {
        room.cell = CellId::A1;
        room.label = "A1";
        room.description = "A1: a cold stone entry with a faded map on the wall.";
        room.exit_count = 2;
        room.exits[0] = Exit { command: "north", destination: CellId::A2 };
        room.exits[1] = Exit { command: "east", destination: CellId::B1 };
        room.exits[2] = Exit { command: "", destination: CellId::Empty };
        room.exits[3] = Exit { command: "", destination: CellId::Empty };
    }

    state write_room_a2(mut room: Room) {
        room.cell = CellId::A2;
        room.label = "A2";
        room.description = "A2: a narrow chamber where dust falls from the ceiling.";
        room.exit_count = 2;
        room.exits[0] = Exit { command: "south", destination: CellId::A1 };
        room.exits[1] = Exit { command: "east", destination: CellId::B2 };
        room.exits[2] = Exit { command: "", destination: CellId::Empty };
        room.exits[3] = Exit { command: "", destination: CellId::Empty };
    }

    state write_room_b1(mut room: Room) {
        room.cell = CellId::B1;
        room.label = "B1";
        room.description = "B1: a torchlit room with claw marks near the western door.";
        room.exit_count = 2;
        room.exits[0] = Exit { command: "north", destination: CellId::B2 };
        room.exits[1] = Exit { command: "west", destination: CellId::A1 };
        room.exits[2] = Exit { command: "", destination: CellId::Empty };
        room.exits[3] = Exit { command: "", destination: CellId::Empty };
    }

    state write_room_b2(mut room: Room) {
        room.cell = CellId::B2;
        room.label = "B2";
        room.description = "B2: the final cell, quiet except for water below the floor.";
        room.exit_count = 2;
        room.exits[0] = Exit { command: "south", destination: CellId::B1 };
        room.exits[1] = Exit { command: "west", destination: CellId::A2 };
        room.exits[2] = Exit { command: "", destination: CellId::Empty };
        room.exits[3] = Exit { command: "", destination: CellId::Empty };
    }
}
