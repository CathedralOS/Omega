use platform::console;

data TitleScreen {
    console: ConsolePlatform;
}

machine for TitleScreen {
    fn show(&mut self) {
        self.console.write_line("Omega Dungeon");
        self.console.write_line("A tiny generated crawl for compiler stress.");
        self.console.write_line("Type look, exits, a direction, or quit.");
    }
}
