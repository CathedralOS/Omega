use data::dungeon_types;
use events::event_runtime;
use rooms::room_lookup;

machine RoomFormatter {
    contains events: EventRuntime;

    fn write_current_cell(level: Level, cell: CellId, out_line: &mut ConsoleLine) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        out_line.text = "Room " + room.label + " depth " + room.depth.to_string();
    }

    fn write_room_info(level: Level, cell: CellId, out_line: &mut ConsoleLine) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        out_line.text = room.description;
    }

    fn write_room_event(level: Level, cell: CellId, out_line: &mut ConsoleLine) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        events.describe(room, out_line);
    }

    fn write_adjacent_rooms(level: Level, cell: CellId, out_line: &mut ConsoleLine) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        format_exits(room, out_line);
    }

    fn write_inventory(player: Player, out_line: &mut ConsoleLine) {
        out_line.text = "Gold: " + player.inventory.gold.to_string() + " | items: " + player.inventory.items.len().to_string();
    }

    fn write_character(player: Player, out_line: &mut ConsoleLine) {
        out_line.text = player.name + " level " + player.level.to_string() + " hp " + player.health.to_string() + "/" + player.max_health.to_string() + " xp " + player.xp.to_string();
    }

    fn format_exits(room: Room, out_line: &mut ConsoleLine) {
        out_line.text = "Commands: look | info | exits | inventory | character | use | fight | quit";

        let index: usize = 0;
        loop index < room.exit_count {
            out_line.text = out_line.text + " | " + room.exits[index].command;
            index = index + 1;
        }
    }
}
