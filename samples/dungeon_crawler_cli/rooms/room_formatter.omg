use data::dungeon_types;
use rooms::room_lookup;

machine RoomFormatter {
    fn write_current_cell(level: Level, cell: CellId, out_line: &mut ConsoleLine) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        out_line.text = "Room " + room.label;
    }

    fn write_room_info(level: Level, cell: CellId, out_line: &mut ConsoleLine) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        out_line.text = room.description;
    }

    fn write_adjacent_rooms(level: Level, cell: CellId, out_line: &mut ConsoleLine) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        format_exits(room, mut out_line);
    }

    fn format_exits(room: Room, out_line: &mut ConsoleLine) {
        out_line.text = "Commands: look | info | exits | help | quit";
        append_exit(room.exits[0], mut out_line);
        append_exit(room.exits[1], mut out_line);
        append_exit(room.exits[2], mut out_line);
        append_exit(room.exits[3], mut out_line);
    }

    fn append_exit(exit: Exit, out_line: &mut ConsoleLine) {
        -> append_open_exit(exit, mut out_line) when exit.destination != CellId::Empty;
        ->
    }

    state append_open_exit(exit: Exit, out_line: &mut ConsoleLine) {
        out_line.text = out_line.text + " | " + exit.command;
    }
}
