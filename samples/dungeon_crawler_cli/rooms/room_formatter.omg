use events::event_runtime;
use platform::console_types;
use player::player_state;
use rooms::map;
use rooms::room_lookup;
use rooms::rooms;

data RoomFormatter {
    events: EventRuntime;
    lookup: RoomLookup;
}

machine RoomFormatter::write_current_cell {
    pub entry(
        &mut self,
        level: Level,
        cell: CellId,
        out_line: &mut ConsoleLine
    ) {
        let room: Room;
        self.lookup.find_room(level, cell, &mut room);
        out_line.text = "Room " + room.label + " depth " + room.depth.to_string();
    }
}

machine RoomFormatter::write_room_info {
    pub entry(
        &mut self,
        level: Level,
        cell: CellId,
        out_line: &mut ConsoleLine
    ) {
        let room: Room;
        self.lookup.find_room(level, cell, &mut room);
        out_line.text = room.description;
    }
}

machine RoomFormatter::write_room_event {
    pub entry(
        &mut self,
        level: Level,
        cell: CellId,
        out_line: &mut ConsoleLine
    ) {
        let room: Room;
        self.lookup.find_room(level, cell, &mut room);
        self.events.describe(room, out_line);
    }
}

machine RoomFormatter::write_adjacent_rooms {
    pub entry(
        &mut self,
        level: Level,
        cell: CellId,
        out_line: &mut ConsoleLine
    ) {
        let room: Room;
        self.lookup.find_room(level, cell, &mut room);
        self.format_exits(room, out_line);
    }

    entry format_exits(
        &mut self,
        room: Room,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "Commands: look | info | exits | inventory | character | use | fight | quit";
        let exits: &[Exit] = room.exits.as_slice();

        transition room.exit_count > 0 {
            true -> append_exit(exits, room.exit_count, out_line, 0)
            false -> {}
        }
    }

    state append_exit(
        &mut self,
        exits: &[Exit],
        exit_count: usize[positive],
        out_line: &mut ConsoleLine,
        index: usize
    ) {
        out_line.text = out_line.text + " | " + exits[index].command;
        let next_index: usize = index + 1;

        transition next_index < exit_count {
            true -> append_exit(exits, exit_count, out_line, next_index)
            false -> {}
        }
    }
}

machine RoomFormatter::write_inventory {
    pub entry(
        &mut self,
        player: Player,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "Gold: " + player.inventory.gold.to_string() + " | items: " + player.inventory.item_count.to_string();
    }
}

machine RoomFormatter::write_character {
    pub entry(
        &mut self,
        player: Player,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = player.name + " level " + player.level.to_string() + " hp " + player.health.to_string() + "/" + player.max_health.to_string() + " xp " + player.xp.to_string();
    }
}
