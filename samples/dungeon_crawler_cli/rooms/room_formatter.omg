use events::events;
use player::player_state;
use rooms::map;
use rooms::room_lookup;
use rooms::rooms;

data RoomFormatter {
    lookup: RoomLookup;
}

machine RoomFormatter::write_current_cell(
    &mut self,
    level: Level,
    cell: CellId,
    out_line: &mut String
) {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);
    out_line = "== " + room.label + " ==";
}

machine RoomFormatter::write_room_info(
    &mut self,
    level: Level,
    cell: CellId,
    out_line: &mut String
) {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);
    out_line = room.description;
}

machine RoomFormatter::write_room_event(
    &mut self,
    level: Level,
    cell: CellId,
    out_line: &mut String
) {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);

    transition {
        room.event.kind == RoomEventKind::FountainOfLife && room.event.consumed == false -> describe_fountain(out_line)
        room.event.kind == RoomEventKind::Treasure && room.event.consumed == false -> describe_treasure(out_line)
        room.event.kind == RoomEventKind::GoldCache && room.event.consumed == false -> describe_gold(out_line)
        room.event.kind == RoomEventKind::Enemy && room.event.consumed == false -> describe_enemy(room.event.enemy.name, out_line)
        _ -> quiet_room(out_line)
    }


    state describe_fountain(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "A fountain of life glows here. Type use to drink.";
    }

    state describe_treasure(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "A treasure cache rests against the wall. Type use to claim it.";
    }

    state describe_gold(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Loose gold glitters in the dust. Type use to collect it.";
    }

    state describe_enemy(
        &mut self,
        enemy_name: String,
        out_line: &mut String
    ) {
        out_line = enemy_name + " blocks the way. Type fight.";
    }

    state quiet_room(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "The room is quiet.";
    }
}

machine RoomFormatter::write_adjacent_rooms(
    &mut self,
    level: Level,
    cell: CellId,
    out_line: &mut String
) {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);
    let exits: &[Exit] = room.exits.as_slice();

    transition room.exit_count {
        0 -> no_paths(out_line)
        1 -> one_path(exits[0].command, out_line)
        2 -> two_paths(exits[0].command, exits[1].command, out_line)
        3 -> three_paths(exits[0].command, exits[1].command, exits[2].command, out_line)
        _ -> four_paths(exits[0].command, exits[1].command, exits[2].command, exits[3].command, out_line)
    }


    state no_paths(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "[Paths] none";
    }

    state one_path(
        &mut self,
        one: String,
        out_line: &mut String
    ) {
        out_line = "[Paths] " + one;
    }

    state two_paths(
        &mut self,
        one: String,
        two: String,
        out_line: &mut String
    ) {
        out_line = "[Paths] " + one + " | " + two;
    }

    state three_paths(
        &mut self,
        one: String,
        two: String,
        three: String,
        out_line: &mut String
    ) {
        out_line = "[Paths] " + one + " | " + two + " | " + three;
    }

    state four_paths(
        &mut self,
        one: String,
        two: String,
        three: String,
        four: String,
        out_line: &mut String
    ) {
        out_line = "[Paths] " + one + " | " + two + " | " + three + " | " + four;
    }
}

machine RoomFormatter::write_inventory(
    &mut self,
    player: Player,
    out_line: &mut String
) {
    transition player.inventory.gold >= 30 {
        true -> inventory_thirty(out_line)
        false -> inventory_twenty_four_check(player, out_line)
    }

    state inventory_twenty_four_check(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.inventory.gold >= 24 {
            true -> inventory_twenty_four(player, out_line)
            false -> inventory_six_check(player, out_line)
        }
    }

    state inventory_six_check(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.inventory.gold >= 6 {
            true -> inventory_six(player, out_line)
            false -> inventory_zero(player, out_line)
        }
    }

    state inventory_zero(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.inventory.item_count > 0 {
            true -> inventory_zero_with_item(out_line)
            false -> inventory_zero_empty(out_line)
        }
    }

    state inventory_zero_empty(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: 0 gold. Pack empty.";
    }

    state inventory_zero_with_item(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: 0 gold. Pack holds a charm.";
    }

    state inventory_six(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.inventory.item_count > 0 {
            true -> inventory_six_with_item(out_line)
            false -> inventory_six_only(out_line)
        }
    }

    state inventory_six_only(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: 6 gold. A few scavenged coins.";
    }

    state inventory_six_with_item(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: 6 gold. A few coins and a charm.";
    }

    state inventory_twenty_four(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.inventory.item_count > 0 {
            true -> inventory_twenty_four_with_item(out_line)
            false -> inventory_twenty_four_only(out_line)
        }
    }

    state inventory_twenty_four_only(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: 24 gold. A rich little haul.";
    }

    state inventory_twenty_four_with_item(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: 24 gold. A rich haul and a charm.";
    }

    state inventory_thirty(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: 30 gold. Purse heavy, charm secured.";
    }

    state inventory_items(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.inventory.item_count > 0 {
            true -> stocked_inventory(out_line)
            false -> light_inventory(out_line)
        }
    }

    state wealthy_inventory(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: purse heavy and gear secured.";
    }

    state stocked_inventory(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: a few coins and some gear.";
    }

    state light_inventory(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inv: nearly empty.";
    }
}

machine RoomFormatter::write_character(
    &mut self,
    player: Player,
    out_line: &mut String
) {
    transition player.health * 2 <= player.max_health {
        true -> wounded_character(out_line)
        false -> character_experience(player, out_line)
    }


    state character_experience(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.level >= 3 {
            true -> seasoned_character(out_line)
            false -> ready_character(out_line)
        }
    }

    state wounded_character(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Character: wounded, stubborn, still standing.";
    }

    state seasoned_character(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Character: seasoned enough to worry the dungeon.";
    }

    state ready_character(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Character: ready for trouble.";
    }
}
