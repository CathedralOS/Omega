use events::events;
use player::player_state;
use rooms::map;
use rooms::rooms;

data RoomFormatter {
}

machine RoomFormatter::write_current_cell(
    &mut self,
    level: Level,
    room_index: usize,
    out_line: &mut String
) {
    -> gate_label(out_line) when room_index == 0;
    -> fountain_label(out_line) when room_index == 1;
    -> ambush_label(out_line) when room_index == 2;
    -> vault_label(out_line) when room_index == 3;
    -> unknown_label(out_line);


    state gate_label(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Room Gate";
    }

    state fountain_label(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Room Fountain Room";
    }

    state ambush_label(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Room Ambush Hall";
    }

    state vault_label(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Room Treasure Vault";
    }

    state unknown_label(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Room Unknown";
    }
}

machine RoomFormatter::write_room_info(
    &mut self,
    level: Level,
    room_index: usize,
    out_line: &mut String
) {
    -> gate_info(out_line) when room_index == 0;
    -> fountain_info(out_line) when room_index == 1;
    -> ambush_info(out_line) when room_index == 2;
    -> vault_info(out_line) when room_index == 3;
    -> unknown_info(out_line);


    state gate_info(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "The old gate room breathes cold air from below.";
    }

    state fountain_info(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "A quiet shrine chamber hums with pale water-light.";
    }

    state ambush_info(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "A narrow hall where loose stone crunches underfoot.";
    }

    state vault_info(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "A cracked vault glitters with coins trapped under dust.";
    }

    state unknown_info(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Stone closes in from every side.";
    }
}

machine RoomFormatter::write_room_event(
    &mut self,
    level: Level,
    room_index: usize,
    out_line: &mut String
) {
    let rooms: &[Room] = level.rooms.as_slice();
    let room: Room = rooms[room_index];

    -> describe_fountain(out_line) when room.event.kind == RoomEventKind::FountainOfLife && room.event.consumed == false;
    -> describe_treasure(out_line) when room.event.kind == RoomEventKind::Treasure && room.event.consumed == false;
    -> describe_gold(out_line) when room.event.kind == RoomEventKind::GoldCache && room.event.consumed == false;
    -> describe_enemy(room.event.enemy.name, out_line) when room.event.kind == RoomEventKind::Enemy && room.event.consumed == false;
    -> quiet_room(out_line);


    state describe_fountain(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "A fountain of life glows here. Type use to drink.";
    }

    state describe_treasure(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "A treasure cache rests against the wall. Type use to claim it.";
    }

    state describe_gold(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Loose gold glitters in the dust. Type use to collect it.";
    }

    state describe_enemy(
        &mut self,
        enemy_name: String,
        out_line: &mut String
    ) {
        out_line = enemy_name + " blocks the way. Type fight.";
    }

    state quiet_room(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "The room is quiet.";
    }
}

machine RoomFormatter::write_adjacent_rooms(
    &mut self,
    level: Level,
    room_index: usize,
    out_line: &mut String
) {
    -> gate_paths(out_line) when room_index == 0;
    -> fountain_paths(out_line) when room_index == 1;
    -> ambush_paths(out_line) when room_index == 2;
    -> vault_paths(out_line) when room_index == 3;
    -> no_paths(out_line);


    state gate_paths(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Paths: north, east. Commands: look | inventory | character | use | fight | quit";
    }

    state fountain_paths(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Paths: south, north. Commands: look | inventory | character | use | fight | quit";
    }

    state ambush_paths(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Paths: west, east. Commands: look | inventory | character | use | fight | quit";
    }

    state vault_paths(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Paths: south, west. Commands: look | inventory | character | use | fight | quit";
    }

    state no_paths(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "No paths are open here. Commands: look | inventory | character | use | fight | quit";
    }
}

machine RoomFormatter::write_inventory(
    &mut self,
    player: Player,
    out_line: &mut String
) {
    transition player.inventory.gold >= 20 {
        true -> wealthy_inventory(out_line)
        false -> inventory_items(player, out_line)
    }


    state inventory_items(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.inventory.item_count > 0 {
            true -> stocked_inventory(out_line)
            false -> light_inventory(out_line)
        }
    }

    state wealthy_inventory(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inventory: a heavy purse and useful gear.";
    }

    state stocked_inventory(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inventory: a few coins and some gear.";
    }

    state light_inventory(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Inventory: nearly empty.";
    }
}

machine RoomFormatter::write_character(
    &mut self,
    player: Player,
    out_line: &mut String
) {
    transition player.health * 2 <= player.max_health {
        true -> wounded_character(out_line)
        false -> character_experience(player, out_line)
    }


    state character_experience(
        &mut self,
        player: Player,
        out_line: &mut String
    ) {
        transition player.level >= 3 {
            true -> seasoned_character(out_line)
            false -> ready_character(out_line)
        }
    }

    state wounded_character(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Character: wounded, stubborn, still standing.";
    }

    state seasoned_character(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Character: seasoned enough to worry the dungeon.";
    }

    state ready_character(
        &mut self,
        out_line: &mut String
    ) {
        out_line = "Character: ready for trouble.";
    }
}
