use rooms::map;
use rooms::rooms;

data RoomLookup {
}

machine RoomLookup::find_room {
    pub entry(
        &mut self,
        level: Level,
        cell: CellId,
        out_room: &mut Room
    ) {
        let rooms: &[Room] = level.rooms.as_slice();

        transition level.room_count > 0 {
            true -> find_room_at(rooms, level.room_count, cell, out_room, 0)
            false -> {}
        }
    }

    state find_room_at(
        &mut self,
        rooms: &[Room],
        room_count: usize[positive],
        cell: CellId,
        out_room: &mut Room,
        index: IndexOf<rooms>
    ) {
        let found: bool = rooms[index].cell == cell;
        let next_index: usize = index + 1;
        let has_next: bool = next_index < room_count;

        transition (found, has_next) {
            (true, _) -> apply_room(rooms[index], out_room)
            (false, true) -> find_room_at(rooms, room_count, cell, out_room, next_index)
            (false, false) -> {}
        }
    }

    state apply_room(
        &mut self,
        room: Room,
        out_room: &mut Room
    ) {
        out_room = room;
    }
}

machine RoomLookup::find_room_mut -> &mut Room {
    pub entry(
        &mut self,
        level: &mut Level,
        cell: CellId
    ) {
        let rooms: &mut [Room] = level.rooms.as_mut_slice();

        -> self.find_room_mut_at(rooms, level.room_count, cell, 0);
    }

    fn find_room_mut_at(
        &mut self,
        rooms: &mut [Room],
        room_count: usize[positive],
        cell: CellId,
        index: IndexOf<rooms>
    ) -> &mut Room {
        let found: bool = rooms[index].cell == cell;
        let next_index: usize = index + 1;
        let has_next: bool = next_index < room_count;

        match (found, has_next) {
            (true, _) -> &mut rooms[index]
            (false, true) -> self.find_room_mut_at(rooms, room_count, cell, next_index)
            (false, false) -> &mut rooms[0]
        }
    }
}
