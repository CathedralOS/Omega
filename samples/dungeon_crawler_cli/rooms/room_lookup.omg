use rooms::map;
use rooms::rooms;

machine RoomLookup {
    fn find_room(level: Level, cell: CellId, out_room: &mut Room) {
        transition level.room_count > 0 {
            true -> find_room_at(level, cell, out_room, 0)
            false -> {}
        }
    }

    fn find_room_mut(level: &mut Level, cell: CellId) -> &mut Room {
        -> find_room_mut_at(level, cell, 0);
    }

    state find_room_at(level: Level, cell: CellId, out_room: &mut Room, index: usize) {
        let found: bool = level.rooms[index].cell == cell;
        let has_next: bool = index + 1 < level.room_count;

        transition (found, has_next) {
            (true, _) -> apply_room(level.rooms[index], out_room)
            (false, true) -> find_room_at(level, cell, out_room, index + 1)
            (false, false) -> {}
        }
    }

    fn find_room_mut_at(level: &mut Level, cell: CellId, index: usize) -> &mut Room {
        let found: bool = level.rooms[index].cell == cell;
        let has_next: bool = index + 1 < level.room_count;

        match (found, has_next) {
            (true, _) -> &mut level.rooms[index]
            (false, true) -> find_room_mut_at(level, cell, index + 1)
            (false, false) -> &mut level.rooms[0]
        }
    }

    state apply_room(room: Room, out_room: &mut Room) {
        out_room = room;
    }
}
