use data::dungeon_types;

machine RoomLookup {
    fn find_room(level: Level, cell: CellId, out_room: &mut Room) {
        let index: usize = 0;

        loop index < level.room_count {
            -> apply_room(level.rooms[index], out_room) when level.rooms[index].cell == cell;
            index = index + 1;
        }
    }

    fn find_room_mut(level: &mut Level, cell: CellId) -> &mut Room {
        let index: usize = 0;

        loop index < level.room_count {
            -> &mut level.rooms[index] when level.rooms[index].cell == cell;
            index = index + 1;
        }

        -> &mut level.rooms[0];
    }

    state apply_room(room: Room, out_room: &mut Room) {
        out_room = room;
    }
}
