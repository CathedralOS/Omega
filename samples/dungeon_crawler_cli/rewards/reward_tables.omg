use data::enemies;
use data::items;
use data::random_state;
use data::rewards;
use rng::random;

machine RewardTables {
    contains rng: Random;

    fn roll_room_treasure(depth: u32[exact, non_negative], random: &mut RandomState, reward: &mut Reward) {
        reward.kind = RewardKind::GoldAndItem;
        reward.gold = 20 + depth * 8 + rng.range(random, 15);
        reward.item = roll_item(depth, random);
    }

    fn roll_gold_cache(depth: u32[exact, non_negative], random: &mut RandomState, reward: &mut Reward) {
        reward.kind = RewardKind::Gold;
        reward.gold = 8 + depth * 5 + rng.range(random, 12);
        reward.item = ItemKind::RustedDagger;
    }

    fn roll_enemy_reward(enemy: Enemy, random: &mut RandomState, reward: &mut Reward) {
        match {
            rng.chance(random, 1, 4) -> enemy_item(enemy, random, reward)
            _ -> enemy_gold(enemy, random, reward)
        }
    }

    state enemy_item(enemy: Enemy, random: &mut RandomState, reward: &mut Reward) {
        reward.kind = RewardKind::GoldAndItem;
        reward.gold = 1 + enemy.depth + rng.range(random, 5);
        reward.item = roll_item(enemy.depth, random);
    }

    state enemy_gold(enemy: Enemy, random: &mut RandomState, reward: &mut Reward) {
        reward.kind = RewardKind::Gold;
        reward.gold = 2 + enemy.depth * 2 + rng.range(random, 6);
        reward.item = ItemKind::RustedDagger;
    }

    fn roll_item(depth: u32[exact, non_negative], random: &mut RandomState) -> ItemKind {
        let roll: u32[exact, range<0, 100>] = rng.range(random, 100);

        match {
            depth <= 2 && roll < 50 -> ItemKind::RustedDagger
            depth <= 3 && roll < 75 -> ItemKind::CrackedBuckler
            roll < 85 -> ItemKind::HealingCharm
            depth >= 5 && roll < 96 -> ItemKind::EmberBlade
            depth >= 8 -> ItemKind::DeepKey
            _ -> ItemKind::RustedDagger
        }
    }
}
