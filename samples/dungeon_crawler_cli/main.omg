use game::game;

data main {
    game: Game = Game::new();
}

machine for main {
    pub entry(&mut self) -> i32 {
        transition {
            _ -> running()
        }
    }

    state running(&mut self) -> i32 {
        self.game.run_game_loop();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) -> i32 {
        0
    }
}
