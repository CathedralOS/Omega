use dungeon::dungeon;
use screens::title_screen;

machine main {
    contains dungeon: Dungeon;
    contains title: TitleScreen;

    owns return_code: i32 = 0;

    fn entry() {
        self.title.show();
        self.dungeon.start();

        transition {
            _ -> running()
        }
    }

    state running() {
        self.dungeon.entry();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown() {
        self.return_code = 0;
        self.dungeon.exit(self.return_code);
    }
}
