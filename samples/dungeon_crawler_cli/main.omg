use game::game;

data main {
    game: Game;
    return_code: i32 = 0;
}

machine for main {
    pub fn entry(&mut self) {
        self.game.start();

        transition {
            _ -> running()
        }
    }

    state running(&mut self) {
        self.game.entry();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        self.return_code = 0;
        self.game.exit(self.return_code);
    }
}
