use game::game;

data Main {
    game: Game;
}

machine Main::main(&mut self) -> i32 {
    self.game.initialize(7);

    transition {
        _ -> running()
    }


    state running(&mut self) {
        self.game.run_game_loop();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        0
    }
}
