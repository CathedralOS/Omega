use data::dungeon_types;
use dungeon::dungeon;

machine main {
    contains dungeon: Dungeon;

    owns return_code: i32 = 0;

    state entry {
        dungeon.start();

        -> running;
    }

    state running {
        -> dungeon.entry -> shutdown;
    }

    state shutdown {
        return_code = 0;
        dungeon.exit(return_code);
    }
}
