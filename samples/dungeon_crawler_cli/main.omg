use dungeon::dungeon;
use screens::title_screen;

data main {
    dungeon: Dungeon;
    title: TitleScreen;
    return_code: i32 = 0;
}

machine for main {
    fn entry(&mut self) {
        self.title.show();
        self.dungeon.start();

        transition {
            _ -> running()
        }
    }

    state running(&mut self) {
        self.dungeon.entry();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        self.return_code = 0;
        self.dungeon.exit(self.return_code);
    }
}
