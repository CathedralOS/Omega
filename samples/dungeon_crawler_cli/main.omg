use game::game;

data main {
    game: Game;
}

machine main -> i32 {
    pub entry(&mut self) {
        transition {
            _ -> running()
        }
    }

    state running(&mut self) {
        self.game.run_game_loop();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        0
    }
}
