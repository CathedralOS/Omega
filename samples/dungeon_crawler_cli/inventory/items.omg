data ItemKind {
    case RustedDagger;
    case CrackedBuckler;
    case HealingCharm;
    case EmberBlade;
    case DeepKey;
}

data InventoryItem {
    kind: ItemKind;
    count: u32 in Wrapping;
}

data Inventory {
    items: [InventoryItem; 32];
    item_count: usize in Wrapping;
    gold: u32 in Wrapping;
}
