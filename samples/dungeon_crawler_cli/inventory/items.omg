enum ItemKind {
    RustedDagger,
    CrackedBuckler,
    HealingCharm,
    EmberBlade,
    DeepKey,
}

data InventoryItem {
    kind: ItemKind;
    count: u32[exact, positive];
}

data Inventory {
    items: [InventoryItem; 32];
    item_count: usize[exact, non_negative];
    gold: u32[exact, non_negative];
}
