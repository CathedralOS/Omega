use data::dungeon_types;

machine InventorySystem {
    fn clear(inventory: &mut Inventory) {
        inventory.items.clear();
        inventory.gold = 0;
    }

    fn add_gold(inventory: &mut Inventory, amount: u32[exact, non_negative]) {
        inventory.gold = inventory.gold + amount;
    }

    fn add_item(inventory: &mut Inventory, kind: ItemKind) {
        let existing_index: Option<usize> = find_item(inventory, kind);

        -> increment_item(mut inventory.items[existing_index.unwrap()], 1) when existing_index.is_some();

        inventory.items.push(InventoryItem { kind: kind, count: 1 });
    }

    fn add_reward(inventory: &mut Inventory, reward: Reward) {
        -> add_gold(inventory, reward.gold) when reward.kind == RewardKind::Gold;
        -> add_item(inventory, reward.item) when reward.kind == RewardKind::Item;
        -> add_gold_and_item(inventory, reward) when reward.kind == RewardKind::GoldAndItem;
        ->
    }

    state add_gold_and_item(inventory: &mut Inventory, reward: Reward) {
        add_gold(inventory, reward.gold);
        add_item(inventory, reward.item);
    }

    fn find_item(inventory: &Inventory, kind: ItemKind) -> Option<usize> {
        let index: usize = 0;

        loop index < inventory.items.len() {
            -> index when inventory.items[index].kind == kind;
            index = index + 1;
        }

        -> None;
    }

    fn increment_item(item: &mut InventoryItem, amount: u32[exact, positive]) {
        item.count = item.count + amount;
    }
}
