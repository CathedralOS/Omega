use inventory::items;
use rewards::rewards;

data InventorySystem {
}

machine for InventorySystem {
    fn clear(&mut self, inventory: &mut Inventory) {
        inventory.items.clear();
        inventory.gold = 0;
    }

    fn add_gold(&mut self, inventory: &mut Inventory, amount: u32[exact, non_negative]) {
        inventory.gold = inventory.gold + amount;
    }

    fn add_item(&mut self, inventory: &mut Inventory, kind: ItemKind) {
        let existing_index: Option<usize> = self.find_item(inventory, kind);

        transition existing_index.is_some() {
            true -> increment_item(mut inventory.items[existing_index.unwrap()], 1)
            false -> inventory.items.push(InventoryItem { kind: kind, count: 1 })
        }
    }

    fn add_reward(&mut self, inventory: &mut Inventory, reward: Reward) {
        transition reward.kind {
            RewardKind::None -> {}
            RewardKind::Gold -> add_gold(inventory, reward.gold)
            RewardKind::Item -> add_item(inventory, reward.item)
            RewardKind::GoldAndItem -> add_gold_and_item(inventory, reward)
        }
    }

    state add_gold_and_item(&mut self, inventory: &mut Inventory, reward: Reward) {
        self.add_gold(inventory, reward.gold);
        self.add_item(inventory, reward.item);
    }

    fn find_item(&mut self, inventory: &Inventory, kind: ItemKind) -> Option<usize> {
        let items: &[InventoryItem] = inventory.items.as_slice();

        match items.len > 0 {
            true -> self.find_item_at(items, kind, 0)
            false -> None
        }
    }

    fn find_item_at(
        &mut self,
        items: &[InventoryItem],
        kind: ItemKind,
        index: IndexOf<items>,
    ) -> Option<usize> {
        let found: bool = items[index].kind == kind;
        let next_index: usize = index + 1;

        match found {
            true -> index
            false -> self.find_item_after(items, kind, next_index)
        }
    }

    fn find_item_after(
        &mut self,
        items: &[InventoryItem],
        kind: ItemKind,
        next_index: usize,
    ) -> Option<usize> {
        let has_next: bool = next_index < items.len;

        match has_next {
            true -> self.find_item_at(items, kind, next_index)
            false -> None
        }
    }

    fn increment_item(&mut self, item: &mut InventoryItem, amount: u32[exact, positive]) {
        item.count = item.count + amount;
    }
}
