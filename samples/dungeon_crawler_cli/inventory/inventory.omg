use inventory::items;
use rewards::rewards;

machine InventorySystem {
    fn clear(inventory: &mut Inventory) {
        inventory.items.clear();
        inventory.gold = 0;
    }

    fn add_gold(inventory: &mut Inventory, amount: u32[exact, non_negative]) {
        inventory.gold = inventory.gold + amount;
    }

    fn add_item(inventory: &mut Inventory, kind: ItemKind) {
        let existing_index: Option<usize> = find_item(inventory, kind);

        transition existing_index.is_some() {
            true -> increment_item(mut inventory.items[existing_index.unwrap()], 1)
            false -> inventory.items.push(InventoryItem { kind: kind, count: 1 })
        }
    }

    fn add_reward(inventory: &mut Inventory, reward: Reward) {
        transition reward.kind {
            RewardKind::None -> {}
            RewardKind::Gold -> add_gold(inventory, reward.gold)
            RewardKind::Item -> add_item(inventory, reward.item)
            RewardKind::GoldAndItem -> add_gold_and_item(inventory, reward)
        }
    }

    state add_gold_and_item(inventory: &mut Inventory, reward: Reward) {
        add_gold(inventory, reward.gold);
        add_item(inventory, reward.item);
    }

    fn find_item(inventory: &Inventory, kind: ItemKind) -> Option<usize> {
        let item_count: usize = inventory.items.len();

        match item_count > 0 {
            true -> find_item_at(inventory, kind, item_count, 0)
            false -> None
        }
    }

    fn find_item_at(
        inventory: &Inventory,
        kind: ItemKind,
        item_count: usize[positive],
        index: usize[range<0, item_count>],
    ) -> Option<usize> {
        let found: bool = inventory.items[index].kind == kind;
        let next_index: usize = index + 1;

        match found {
            true -> index
            false -> find_item_after(inventory, kind, next_index, item_count)
        }
    }

    fn find_item_after(
        inventory: &Inventory,
        kind: ItemKind,
        item_count: usize[positive],
        next_index: usize,
    ) -> Option<usize> {
        let has_next: bool = next_index < item_count;

        match has_next {
            true -> find_item_at(inventory, kind, item_count, next_index)
            false -> None
        }
    }

    fn increment_item(item: &mut InventoryItem, amount: u32[exact, positive]) {
        item.count = item.count + amount;
    }
}
