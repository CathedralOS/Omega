use commands::command_parser;
use dungeon::dungeon;
use platform::console;
use rooms::map;
use view::game_view;

data Game {
    console: Console;
    dungeon: Dungeon;
    parser: CommandParser;
    view: GameView;
    input: String;
    output: String;
}

machine Game::initialize(
    &mut self,
    seed: u64[wrapping]
) {
    self.dungeon.initialize(seed);
}

machine Game::run_game_loop(&mut self) {
    self.view.render_title(&mut self.console);

    transition {
        _ -> enter_room()
    }


    state enter_room(&mut self) {
        self.dungeon.enter_room();
        self.view.render_room(self.dungeon, &mut self.console, &mut self.output);

        transition {
            _ -> prompt()
        }
    }

    state prompt(&mut self) {
        transition self.dungeon.player.health == 0 {
            true -> game_over()
            false -> read_command()
        }
    }

    state read_command(&mut self) {
        self.view.render_prompt(&mut self.console);
        self.console.read_line(&mut self.input);

        -> finished() when self.input == "";

        transition self.input {
            "quit" -> finished()
            "look" -> look()
            "info" -> look()
            "exits" -> exits()
            "help" -> exits()
            "inventory" -> inventory()
            "inv" -> inventory()
            "character" -> character()
            "stats" -> character()
            "use" -> use_event()
            "fight" -> fight()
            "north" -> move_north()
            "south" -> move_south()
            _ -> invalid_command()
        }
    }

    state look(&mut self) {
        self.view.render_look(self.dungeon, &mut self.console, &mut self.output);

        transition {
            _ -> prompt()
        }
    }

    state exits(&mut self) {
        self.view.render_exits(self.dungeon, &mut self.console, &mut self.output);

        transition {
            _ -> prompt()
        }
    }

    state inventory(&mut self) {
        self.view.render_inventory(self.dungeon, &mut self.console, &mut self.output);

        transition {
            _ -> prompt()
        }
    }

    state character(&mut self) {
        self.view.render_character(self.dungeon, &mut self.console, &mut self.output);

        transition {
            _ -> prompt()
        }
    }

    state use_event(&mut self) {
        self.output = "You search the room, but there is nothing useful to claim.";
        self.view.render_line(self.output, &mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state fight(&mut self) {
        self.output = "You strike into the dark. The dungeon answers with steel.";
        self.view.render_line(self.output, &mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state move_north(&mut self) {
        transition self.dungeon.current_cell {
            CellId::R00 -> enter_north()
            _ -> invalid_command()
        }
    }

    state enter_north(&mut self) {
        self.dungeon.current_cell = CellId::R01;

        transition {
            _ -> enter_room()
        }
    }

    state move_south(&mut self) {
        transition self.dungeon.current_cell {
            CellId::R01 -> enter_south()
            _ -> invalid_command()
        }
    }

    state enter_south(&mut self) {
        self.dungeon.current_cell = CellId::R00;

        transition {
            _ -> enter_room()
        }
    }

    state invalid_command(&mut self) {
        self.view.render_invalid_command(&mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state game_over(&mut self) {
        self.dungeon.game_over();
        self.view.render_game_over(&mut self.console);

        transition {
            _ -> finished()
        }
    }

    state finished(&mut self) {
        self.console.exit_process(0);
    }
}
