use inventory::inventory;
use player::player_state;
use rewards::rewards;

data PlayerSystem {
    inventory: InventorySystem;
}

machine PlayerSystem::create {
    pub entry(
        &mut self,
        name: String,
        player: &mut Player
    ) {
        player.name = name;
        player.level = 1;
        player.xp = 0;
        player.max_health = 30;
        player.health = player.max_health;
        player.attack = 4;
        player.defense = 1;
        self.inventory.clear(&mut player.inventory);
    }
}

machine PlayerSystem::heal {
    pub entry(
        &mut self,
        player: &mut Player,
        amount: i32[exact, positive]
    ) {
        player.health = min(player.max_health, player.health + amount);
    }
}

machine PlayerSystem::take_damage {
    pub entry(
        &mut self,
        player: &mut Player,
        amount: i32[exact, non_negative]
    ) {
        let prevented: i32[exact, non_negative] = min(amount, player.defense);
        let actual: i32[exact, non_negative] = amount - prevented;
        player.health = max(0, player.health - actual);
    }
}

machine PlayerSystem::grant_reward {
    pub entry(
        &mut self,
        player: &mut Player,
        reward: Reward
    ) {
        self.inventory.add_reward(&mut player.inventory, reward);
    }
}

machine PlayerSystem::grant_xp {
    pub entry(
        &mut self,
        player: &mut Player,
        amount: u32[exact, non_negative]
    ) {
        player.xp = player.xp + amount;

        transition player.xp >= self.xp_required(player.level) {
            true -> level_up(player)
            false -> {}
        }
    }

    state level_up(
        &mut self,
        player: &mut Player
    ) {
        player.xp = player.xp - self.xp_required(player.level);
        player.level = player.level + 1;
        player.max_health = player.max_health + 5;
        player.attack = player.attack + 1;
        player.health = player.max_health;

        transition player.xp >= self.xp_required(player.level) {
            true -> level_up(player)
            false -> {}
        }
    }

    entry xp_required(
        &mut self,
        level: u32[exact, positive]
    ) -> u32[exact, positive] {
        -> 10 + level * 5;
    }
}
