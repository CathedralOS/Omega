use data::enemies;
use data::random_state;
use rng::random;

machine EnemyTables {
    contains rng: Random;

    fn roll_enemy(depth: u32[exact, non_negative], random: &mut RandomState, enemy: &mut Enemy) {
        -> bat(random, enemy) when depth <= 1;
        -> spider(random, enemy) when depth <= 2;
        -> skeleton(random, enemy) when depth <= 4;
        -> cultist(random, enemy) when depth <= 6;
        -> hellhound(random, enemy) when depth <= 8;
        -> pit_fiend(random, enemy);
    }

    state bat(random: &mut RandomState, enemy: &mut Enemy) {
        enemy.kind = EnemyKind::Bat;
        enemy.name = "Cave Bat";
        enemy.depth = 0;
        enemy.max_health = 6 + rng.range(random, 3);
        enemy.health = enemy.max_health;
        enemy.attack = 2;
        enemy.defense = 0;
        enemy.xp_reward = 3;
    }

    state spider(random: &mut RandomState, enemy: &mut Enemy) {
        enemy.kind = EnemyKind::Spider;
        enemy.name = "Gloom Spider";
        enemy.depth = 2;
        enemy.max_health = 10 + rng.range(random, 5);
        enemy.health = enemy.max_health;
        enemy.attack = 4;
        enemy.defense = 1;
        enemy.xp_reward = 6;
    }

    state skeleton(random: &mut RandomState, enemy: &mut Enemy) {
        enemy.kind = EnemyKind::Skeleton;
        enemy.name = "Restless Skeleton";
        enemy.depth = 4;
        enemy.max_health = 18 + rng.range(random, 8);
        enemy.health = enemy.max_health;
        enemy.attack = 6;
        enemy.defense = 2;
        enemy.xp_reward = 12;
    }

    state cultist(random: &mut RandomState, enemy: &mut Enemy) {
        enemy.kind = EnemyKind::Cultist;
        enemy.name = "Ashen Cultist";
        enemy.depth = 6;
        enemy.max_health = 26 + rng.range(random, 12);
        enemy.health = enemy.max_health;
        enemy.attack = 9;
        enemy.defense = 3;
        enemy.xp_reward = 20;
    }

    state hellhound(random: &mut RandomState, enemy: &mut Enemy) {
        enemy.kind = EnemyKind::Hellhound;
        enemy.name = "Hellhound";
        enemy.depth = 8;
        enemy.max_health = 42 + rng.range(random, 20);
        enemy.health = enemy.max_health;
        enemy.attack = 14;
        enemy.defense = 5;
        enemy.xp_reward = 36;
    }

    state pit_fiend(random: &mut RandomState, enemy: &mut Enemy) {
        enemy.kind = EnemyKind::PitFiend;
        enemy.name = "Pit Fiend";
        enemy.depth = 10;
        enemy.max_health = 80 + rng.range(random, 40);
        enemy.health = enemy.max_health;
        enemy.attack = 24;
        enemy.defense = 8;
        enemy.xp_reward = 80;
    }
}
