enum EnemyKind {
    Bat,
    Spider,
    Skeleton,
    Cultist,
    Hellhound,
    PitFiend,
}

enum EnemyTier {
    Bat,
    Spider,
    Skeleton,
    Cultist,
    Hellhound,
    PitFiend,
}

data Enemy {
    kind: EnemyKind;
    name: String;
    max_health: i32;
    health: i32;
    attack: i32;
    defense: i32;
    xp_reward: u32;
    depth: u32;
}
