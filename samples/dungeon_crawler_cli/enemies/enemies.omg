data EnemyKind {
    case Bat;
    case Spider;
    case Skeleton;
    case Cultist;
    case Hellhound;
    case PitFiend;
}

data EnemyTier {
    case Bat;
    case Spider;
    case Skeleton;
    case Cultist;
    case Hellhound;
    case PitFiend;
}

data Enemy {
    kind: EnemyKind;
    name: String;
    max_health: i32;
    health: i32;
    attack: i32;
    defense: i32;
    xp_reward: u32;
    depth: u32;
}
