enum EnemyKind {
    Bat,
    Spider,
    Skeleton,
    Cultist,
    Hellhound,
    PitFiend,
}

enum EnemyTier {
    Bat,
    Spider,
    Skeleton,
    Cultist,
    Hellhound,
    PitFiend,
}

data Enemy {
    kind: EnemyKind;
    name: String;
    max_health: i32[exact, positive];
    health: i32[exact, range<0, max_health>];
    attack: i32[exact, positive];
    defense: i32[exact, non_negative];
    xp_reward: u32[exact];
    depth: u32[exact];
}
