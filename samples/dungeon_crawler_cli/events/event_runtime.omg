use combat::combat;
use combat::combat_round;
use enemies::enemies;
use events::events;
use inventory::inventory;
use platform::console_types;
use player::player;
use player::player_state;
use rewards::rewards;
use rng::random;
use rng::random_state;
use rooms::rooms;

data EventRuntime {
    combat: CombatSystem;
    inventory: InventorySystem;
    player_system: PlayerSystem;
}

machine EventRuntime::describe {
    pub entry(
        &mut self,
        room: Room,
        out_line: &mut ConsoleLine
    ) {
        -> describe_fountain(out_line) when room.event.kind == RoomEventKind::FountainOfLife && room.event.consumed == false;
        -> describe_treasure(out_line) when room.event.kind == RoomEventKind::Treasure && room.event.consumed == false;
        -> describe_gold(out_line) when room.event.kind == RoomEventKind::GoldCache && room.event.consumed == false;
        -> describe_enemy(room.event.enemy, out_line) when room.event.kind == RoomEventKind::Enemy && room.event.consumed == false;
        -> quiet_room(out_line);
    }

    state describe_fountain(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "A fountain of life glows here. Type use to drink.";
    }

    state describe_treasure(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "A treasure cache rests against the wall. Type use to claim it.";
    }

    state describe_gold(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "Loose gold glitters in the dust. Type use to collect it.";
    }

    state describe_enemy(
        &mut self,
        enemy: Enemy,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = enemy.name + " blocks the way. Type fight.";
    }

    state quiet_room(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "The room is quiet.";
    }
}

machine EventRuntime::use_event {
    pub entry(
        &mut self,
        player: &mut Player,
        room: &mut Room,
        out_line: &mut ConsoleLine
    ) {
        -> use_fountain(player, &mut room.event, out_line) when room.event.kind == RoomEventKind::FountainOfLife && room.event.consumed == false;
        -> use_reward(player, &mut room.event, out_line) when room.event.kind == RoomEventKind::Treasure && room.event.consumed == false;
        -> use_reward(player, &mut room.event, out_line) when room.event.kind == RoomEventKind::GoldCache && room.event.consumed == false;
        -> no_usable_event(out_line);
    }

    state use_fountain(
        &mut self,
        player: &mut Player,
        event: &mut RoomEvent,
        out_line: &mut ConsoleLine
    ) {
        self.player_system.heal(player, 12);
        event.consumed = true;
        out_line.text = "The fountain heals your wounds.";
    }

    state use_reward(
        &mut self,
        player: &mut Player,
        event: &mut RoomEvent,
        out_line: &mut ConsoleLine
    ) {
        self.player_system.grant_reward(player, event.reward);
        event.consumed = true;
        out_line.text = "You take the treasure.";
    }

    state no_usable_event(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "There is nothing here to use.";
    }
}

machine EventRuntime::fight_event {
    pub entry(
        &mut self,
        player: &mut Player,
        room: &mut Room,
        random: &mut RandomState,
        round: &mut CombatRound,
        out_line: &mut ConsoleLine
    ) {
        -> fight_enemy_event(player, room, random, round, out_line) when room.event.kind == RoomEventKind::Enemy && room.event.consumed == false;
        -> no_enemy(out_line);
    }

    state fight_enemy_event(
        &mut self,
        player: &mut Player,
        room: &mut Room,
        random: &mut RandomState,
        round: &mut CombatRound,
        out_line: &mut ConsoleLine
    ) {
        self.combat.fight(player, &mut room.event, random, round);
        out_line.text = "You trade blows with the monster.";

        -> player_died(out_line) when round.player_defeated;
        -> enemy_died(room.event.reward, out_line) when round.enemy_defeated;
        -> exchange_blows(round, out_line);
    }

    state no_enemy(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "There is no enemy here.";
    }

    state player_died(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "You fall in the dark.";
    }

    state enemy_died(
        &mut self,
        reward: Reward,
        out_line: &mut ConsoleLine
    ) {
        -> rich_reward(out_line) when reward.gold >= 20;
        -> small_reward(out_line) when reward.gold > 0;
        -> empty_reward(out_line);
    }

    state rich_reward(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "The enemy collapses. You scoop up a serious pile of gold.";
    }

    state small_reward(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "The enemy collapses. You find a little gold.";
    }

    state empty_reward(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "The enemy collapses. Nothing useful remains.";
    }

    state exchange_blows(
        &mut self,
        round: CombatRound,
        out_line: &mut ConsoleLine
    ) {
        -> heavy_exchange(out_line) when round.player_damage > 10;
        -> clean_hit(out_line) when round.enemy_damage == 0;
        -> painful_exchange(out_line) when round.enemy_damage >= 5;
        -> glancing_exchange(out_line);
    }

    state heavy_exchange(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "You deal more than 10 damage, but the enemy keeps moving.";
    }

    state clean_hit(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "You hit cleanly and avoid the counterattack.";
    }

    state painful_exchange(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "You trade blows and take 5 or more damage.";
    }

    state glancing_exchange(
        &mut self,
        out_line: &mut ConsoleLine
    ) {
        out_line.text = "Steel scrapes in the dark as you exchange blows.";
    }
}
