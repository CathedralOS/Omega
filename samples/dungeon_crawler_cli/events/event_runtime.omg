use combat::combat;
use combat::combat_round;
use enemies::enemies;
use events::events;
use inventory::inventory;
use platform::console_types;
use player::player;
use player::player_state;
use rewards::rewards;
use rng::random;
use rng::random_state;
use rooms::rooms;

machine EventRuntime {
    contains combat: CombatSystem;
    contains inventory: InventorySystem;
    contains player_system: PlayerSystem;

    fn describe(&mut self, room: Room, out_line: &mut ConsoleLine) {
        transition (room.event.kind, room.event.consumed) {
            (RoomEventKind::FountainOfLife, false) -> describe_fountain(out_line)
            (RoomEventKind::Treasure, false) -> describe_treasure(out_line)
            (RoomEventKind::GoldCache, false) -> describe_gold(out_line)
            (RoomEventKind::Enemy, false) -> describe_enemy(room.event.enemy, out_line)
            _ -> quiet_room(out_line)
        }
    }

    state describe_fountain(&mut self, out_line: &mut ConsoleLine) {
        out_line.text = "A fountain of life glows here. Type use to drink.";
    }

    state describe_treasure(&mut self, out_line: &mut ConsoleLine) {
        out_line.text = "A treasure cache rests against the wall. Type use to claim it.";
    }

    state describe_gold(&mut self, out_line: &mut ConsoleLine) {
        out_line.text = "Loose gold glitters in the dust. Type use to collect it.";
    }

    state describe_enemy(&mut self, enemy: Enemy, out_line: &mut ConsoleLine) {
        out_line.text = enemy.name + " blocks the way. Type fight.";
    }

    state quiet_room(&mut self, out_line: &mut ConsoleLine) {
        out_line.text = "The room is quiet.";
    }

    fn use_event(&mut self, player: &mut Player, room: &mut Room, out_line: &mut ConsoleLine) {
        transition (room.event.kind, room.event.consumed) {
            (RoomEventKind::FountainOfLife, false) -> use_fountain(player, mut room.event, out_line)
            (RoomEventKind::Treasure, false) -> use_reward(player, mut room.event, out_line)
            (RoomEventKind::GoldCache, false) -> use_reward(player, mut room.event, out_line)
            _ -> no_usable_event(out_line)
        }
    }

    state use_fountain(&mut self, player: &mut Player, event: &mut RoomEvent, out_line: &mut ConsoleLine) {
        self.player_system.heal(player, 12);
        event.consumed = true;
        out_line.text = "The fountain heals your wounds.";
    }

    state use_reward(&mut self, player: &mut Player, event: &mut RoomEvent, out_line: &mut ConsoleLine) {
        self.player_system.grant_reward(player, event.reward);
        event.consumed = true;
        out_line.text = "You take the treasure.";
    }

    state no_usable_event(&mut self, out_line: &mut ConsoleLine) {
        out_line.text = "There is nothing here to use.";
    }

    fn fight_event(&mut self, player: &mut Player, room: &mut Room, random: &mut RandomState, round: &mut CombatRound, out_line: &mut ConsoleLine) {
        transition (room.event.kind, room.event.consumed) {
            (RoomEventKind::Enemy, false) -> fight_enemy_event(player, room, random, round, out_line)
            _ -> no_enemy(out_line)
        }
    }

    state fight_enemy_event(&mut self, player: &mut Player, room: &mut Room, random: &mut RandomState, round: &mut CombatRound, out_line: &mut ConsoleLine) {

        self.combat.fight(player, mut room.event, random, round);

        transition (round.player_defeated, round.enemy_defeated) {
            (true, _) -> player_died(out_line)
            (false, true) -> enemy_died(room.event.reward, out_line)
            (false, false) -> exchange_blows(round, out_line)
        }
    }

    state no_enemy(&mut self, out_line: &mut ConsoleLine) {
        out_line.text = "There is no enemy here.";
    }

    state player_died(&mut self, out_line: &mut ConsoleLine) {
        out_line.text = "You fall in the dark.";
    }

    state enemy_died(&mut self, reward: Reward, out_line: &mut ConsoleLine) {
        out_line.text = "The enemy collapses. You gain " + reward.gold.to_string() + " gold.";
    }

    state exchange_blows(&mut self, round: CombatRound, out_line: &mut ConsoleLine) {
        out_line.text = "You strike for " + round.player_damage.to_string() + ", then take " + round.enemy_damage.to_string() + ".";
    }
}
