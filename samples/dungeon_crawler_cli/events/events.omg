use enemies::enemies;
use rewards::rewards;

enum RoomEventKind {
    Nothing,
    FountainOfLife,
    Treasure,
    GoldCache,
    Enemy,
}

enum RoomEventAction {
    Quiet,
    Fountain,
    Reward,
    Enemy,
}

data RoomEvent {
    kind: RoomEventKind;
    enemy: Enemy;
    reward: Reward;
    consumed: bool;
}
