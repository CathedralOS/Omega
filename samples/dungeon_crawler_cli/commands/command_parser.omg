use rooms::room_lookup;
use rooms::map;
use rooms::rooms;

data CommandParser {
    lookup: RoomLookup;
}

machine CommandParser::resolve_navigation(
    &mut self,
    level: Level,
    cell: CellId,
    line: &String
    ) -> Navigation {
    let choice: NavigationChoice = self.resolve_command(line);

    transition {
        choice == NavigationChoice::Invalid -> self.resolve_exit(level, cell, line)
        choice != NavigationChoice::Invalid -> self.navigation(choice, CellId::Empty)
    }
}

machine CommandParser::resolve_command(
    &mut self,
    line: &String
    ) -> NavigationChoice {
    transition {
        line == "quit" -> NavigationChoice::Quit
        line == "exit" -> NavigationChoice::Quit
        line == "look" -> NavigationChoice::Look
        line == "info" -> NavigationChoice::Look
        line == "paths" -> NavigationChoice::Exits
        line == "help" -> NavigationChoice::Exits
        line == "inventory" -> NavigationChoice::Inventory
        line == "inv" -> NavigationChoice::Inventory
        line == "char" -> NavigationChoice::Character
        line == "character" -> NavigationChoice::Character
        line == "stats" -> NavigationChoice::Character
        line == "use" -> NavigationChoice::UseEvent
        line == "fight" -> NavigationChoice::Fight
        _ -> NavigationChoice::Invalid
    }
}

machine CommandParser::resolve_exit(
    &mut self,
    level: Level,
    cell: CellId,
    line: &String
    ) -> Navigation {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);
    self.find_exit(room, line);
}

machine CommandParser::find_exit(
    &mut self,
    room: Room,
    command: &String
    ) -> Navigation {
    let exits: &[Exit] = room.exits.as_slice();

    transition room.exit_count > 0 {
        true -> self.find_exit_at(exits, room.exit_count, command, 0)
        false -> self.invalid_navigation()
    }
}

machine CommandParser::find_exit_at(
    &mut self,
    exits: &[Exit],
    exit_count: usize,
    command: &String,
    index: usize
    ) -> Navigation {
    let found: bool = exits[index].command == command;
    let next_index: usize = index + 1;
    let has_next: bool = next_index < exit_count;

    transition {
        found -> self.navigation(NavigationChoice::Move, exits[index].destination)
        has_next -> self.find_exit_at(exits, exit_count, command, next_index)
        _ -> self.invalid_navigation()
    }
}

machine CommandParser::invalid_navigation(&mut self) -> Navigation {
    transition {
        _ -> self.navigation(NavigationChoice::Invalid, CellId::Empty)
    }
}

machine CommandParser::navigation(
    &mut self,
    choice: NavigationChoice,
    destination: CellId
    ) -> Navigation {
    Navigation { choice: choice, destination: destination }
}
