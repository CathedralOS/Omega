use platform::console_types;
use rooms::room_lookup;
use rooms::map;
use rooms::rooms;

data CommandParser {
    lookup: RoomLookup;
}

machine for CommandParser {
    pub fn resolve_navigation(&mut self, level: Level, cell: CellId, line: &ConsoleLine) -> Navigation {
        let choice: NavigationChoice = self.resolve_command(line);

        match choice {
            NavigationChoice::Invalid -> self.resolve_exit(level, cell, line)
            _ -> self.navigation(choice, CellId::Empty)
        }
    }

    fn resolve_command(&mut self, line: &ConsoleLine) -> NavigationChoice {
        match line.text {
            "quit" -> NavigationChoice::Quit
            "look" -> NavigationChoice::Look
            "info" -> NavigationChoice::Look
            "exits" -> NavigationChoice::Exits
            "help" -> NavigationChoice::Exits
            "inventory" -> NavigationChoice::Inventory
            "inv" -> NavigationChoice::Inventory
            "character" -> NavigationChoice::Character
            "stats" -> NavigationChoice::Character
            "use" -> NavigationChoice::UseFountain
            "fight" -> NavigationChoice::Fight
            _ -> NavigationChoice::Invalid
        }
    }

    fn resolve_exit(&mut self, level: Level, cell: CellId, line: &ConsoleLine) -> Navigation {
        let room: Room;
        self.lookup.find_room(level, cell, &mut room);
        -> self.find_exit(room, &line.text);
    }

    fn find_exit(&mut self, room: Room, command: &String) -> Navigation {
        let exits: &[Exit] = room.exits.as_slice();

        match room.exit_count > 0 {
            true -> self.find_exit_at(exits, room.exit_count, command, 0)
            false -> self.invalid_navigation()
        }
    }

    fn find_exit_at(
        &mut self,
        exits: &[Exit],
        exit_count: usize[positive],
        command: &String,
        index: IndexOf<exits>,
    ) -> Navigation {
        let found: bool = exits[index].command == command;
        let next_index: usize = index + 1;
        let has_next: bool = next_index < exit_count;

        match (found, has_next) {
            (true, _) -> self.navigation(NavigationChoice::Move, exits[index].destination)
            (false, true) -> self.find_exit_at(exits, exit_count, command, next_index)
            (false, false) -> self.invalid_navigation()
        }
    }

    fn invalid_navigation(&mut self) -> Navigation {
        -> self.navigation(NavigationChoice::Invalid, CellId::Empty);
    }

    fn navigation(&mut self, choice: NavigationChoice, destination: CellId) -> Navigation {
        -> Navigation { choice: choice, destination: destination };
    }
}
