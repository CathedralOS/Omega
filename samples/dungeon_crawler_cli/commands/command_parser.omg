use platform::console_types;
use rooms::room_lookup;
use rooms::map;
use rooms::rooms;

machine CommandParser {
    fn resolve_command(line: ConsoleLine, out_navigation: &mut Navigation) {
        transition line.text {
            "quit" -> resolve_quit(out_navigation)
            "look" -> resolve_look(out_navigation)
            "info" -> resolve_look(out_navigation)
            "exits" -> resolve_exits(out_navigation)
            "help" -> resolve_exits(out_navigation)
            "inventory" -> resolve_inventory(out_navigation)
            "inv" -> resolve_inventory(out_navigation)
            "character" -> resolve_character(out_navigation)
            "stats" -> resolve_character(out_navigation)
            "use" -> resolve_use(out_navigation)
            "fight" -> resolve_fight(out_navigation)
            _ -> {}
        }
    }

    state resolve_quit(out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::Quit;
    }

    state resolve_look(out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::Look;
    }

    state resolve_exits(out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::Exits;
    }

    state resolve_inventory(out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::Inventory;
    }

    state resolve_character(out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::Character;
    }

    state resolve_use(out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::UseFountain;
    }

    state resolve_fight(out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::Fight;
    }

    state resolve_move(destination: CellId, out_navigation: &mut Navigation) {
        out_navigation.choice = NavigationChoice::Move;
        out_navigation.destination = destination;
    }

    fn resolve_exit(level: Level, cell: CellId, line: ConsoleLine, out_navigation: &mut Navigation) {
        let room: Room;
        RoomLookup.find_room(level, cell, mut room);
        find_exit(room, line.text, out_navigation);
    }

    fn find_exit(room: Room, command: String, out_navigation: &mut Navigation) {
        let exits: &[Exit] = room.exits.as_slice();

        transition room.exit_count > 0 {
            true -> find_exit_at(exits, room.exit_count, command, out_navigation, 0)
            false -> {}
        }
    }

    state find_exit_at(
        exits: &[Exit],
        exit_count: usize[positive],
        command: String,
        out_navigation: &mut Navigation,
        index: IndexOf<exits>,
    ) {
        let found: bool = exits[index].command == command;
        let next_index: usize = index + 1;
        let has_next: bool = next_index < exit_count;

        transition (found, has_next) {
            (true, _) -> resolve_move(exits[index].destination, out_navigation)
            (false, true) -> find_exit_at(exits, exit_count, command, out_navigation, next_index)
            (false, false) -> {}
        }
    }
}
