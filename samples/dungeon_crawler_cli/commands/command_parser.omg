use platform::console_types;
use rooms::room_lookup;
use rooms::map;
use rooms::rooms;

data CommandParser {
    lookup: RoomLookup;
}

machine CommandParser::resolve_navigation -> Navigation {
    pub entry(
        &mut self,
        level: Level,
        cell: CellId,
        line: &ConsoleLine
    ) {
        let choice: NavigationChoice = self.resolve_command(line);

        -> self.resolve_exit(level, cell, line) when choice == NavigationChoice::Invalid;
        -> self.navigation(choice, CellId::Empty);
    }

    entry resolve_command(
        &mut self,
        line: &ConsoleLine
    ) -> NavigationChoice {
        -> NavigationChoice::Quit when line.text == "quit";
        -> NavigationChoice::Look when line.text == "look";
        -> NavigationChoice::Look when line.text == "info";
        -> NavigationChoice::Exits when line.text == "exits";
        -> NavigationChoice::Exits when line.text == "help";
        -> NavigationChoice::Inventory when line.text == "inventory";
        -> NavigationChoice::Inventory when line.text == "inv";
        -> NavigationChoice::Character when line.text == "character";
        -> NavigationChoice::Character when line.text == "stats";
        -> NavigationChoice::UseFountain when line.text == "use";
        -> NavigationChoice::Fight when line.text == "fight";
        -> NavigationChoice::Invalid;
    }

    entry resolve_exit(
        &mut self,
        level: Level,
        cell: CellId,
        line: &ConsoleLine
    ) -> Navigation {
        let room: Room;
        self.lookup.find_room(level, cell, &mut room);
        -> self.find_exit(room, &line.text);
    }

    entry find_exit(
        &mut self,
        room: Room,
        command: &String
    ) -> Navigation {
        let exits: &[Exit] = room.exits.as_slice();

        match room.exit_count > 0 {
            true -> self.find_exit_at(exits, room.exit_count, command, 0)
            false -> self.invalid_navigation()
        }
    }

    entry find_exit_at(
        &mut self,
        exits: &[Exit],
        exit_count: usize[positive],
        command: &String,
        index: IndexOf<exits>
    ) -> Navigation {
        let found: bool = exits[index].command == command;
        let next_index: usize = index + 1;
        let has_next: bool = next_index < exit_count;

        -> self.navigation(NavigationChoice::Move, exits[index].destination) when found;
        -> self.find_exit_at(exits, exit_count, command, next_index) when has_next;
        -> self.invalid_navigation();
    }

    entry invalid_navigation(&mut self) -> Navigation {
        -> self.navigation(NavigationChoice::Invalid, CellId::Empty);
    }

    entry navigation(
        &mut self,
        choice: NavigationChoice,
        destination: CellId
    ) -> Navigation {
        Navigation { choice: choice, destination: destination }
    }
}
