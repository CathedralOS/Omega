use rooms::room_lookup;
use rooms::map;
use rooms::rooms;

data CommandParser {
    lookup: RoomLookup;
}

machine CommandParser::resolve_navigation(
    &mut self,
    level: Level,
    cell: CellId,
    line: &String
    ) -> Navigation {
    let choice: NavigationChoice = self.resolve_command(line);

    -> self.resolve_exit(level, cell, line) when choice == NavigationChoice::Invalid;
    -> self.navigation(choice, CellId::Empty) when choice != NavigationChoice::Invalid;
}

machine CommandParser::resolve_command(
    &mut self,
    line: &String
    ) -> NavigationChoice {
    -> NavigationChoice::Quit when line == "quit";
    -> NavigationChoice::Quit when line == "exit";
    -> NavigationChoice::Look when line == "look";
    -> NavigationChoice::Look when line == "info";
    -> NavigationChoice::Exits when line == "paths";
    -> NavigationChoice::Exits when line == "help";
    -> NavigationChoice::Inventory when line == "inventory";
    -> NavigationChoice::Inventory when line == "inv";
    -> NavigationChoice::Character when line == "character";
    -> NavigationChoice::Character when line == "stats";
    -> NavigationChoice::UseFountain when line == "use";
    -> NavigationChoice::Fight when line == "fight";
    -> NavigationChoice::Invalid;
}

machine CommandParser::resolve_exit(
    &mut self,
    level: Level,
    cell: CellId,
    line: &String
    ) -> Navigation {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);
    self.find_exit(room, line);
}

machine CommandParser::find_exit(
    &mut self,
    room: Room,
    command: &String
    ) -> Navigation {
    let exits: &[Exit] = room.exits.as_slice();

    match room.exit_count > 0 {
        true -> self.find_exit_at(exits, room.exit_count, command, 0)
        false -> self.invalid_navigation()
    }
}

machine CommandParser::find_exit_at(
    &mut self,
    exits: &[Exit],
    exit_count: usize[positive],
    command: &String,
    index: usize
    ) -> Navigation {
    let found: bool = exits[index].command == command;
    let next_index: usize = index + 1;
    let has_next: bool = next_index < exit_count;

    -> self.navigation(NavigationChoice::Move, exits[index].destination) when found;
    -> self.find_exit_at(exits, exit_count, command, next_index) when has_next;
    -> self.invalid_navigation();
}

machine CommandParser::invalid_navigation(&mut self) -> Navigation {
    -> self.navigation(NavigationChoice::Invalid, CellId::Empty);
}

machine CommandParser::navigation(
    &mut self,
    choice: NavigationChoice,
    destination: CellId
    ) -> Navigation {
    Navigation { choice: choice, destination: destination }
}
