use platform::console;
use player::player_state;
use rooms::rooms;
use rooms::room_formatter;

data GameView {
    formatter: RoomFormatter;
}

machine GameView::render_title(
    &mut self,
    console: &mut Console
) {
    console.write_line("Omega Dungeon");
    console.write_line("A tiny generated crawl for compiler stress.");
    console.write_line("Type look, paths, inv, character, use, fight, or exit.");
}

machine GameView::render_room(
    &mut self,
    level: Level,
    room_index: usize,
    console: &mut Console,
    line: &mut String
) {
    self.formatter.write_current_cell(level, room_index, line);
    console.write_line(line);
    self.formatter.write_room_info(level, room_index, line);
    console.write_line(line);
    self.formatter.write_room_event(level, room_index, line);
    console.write_line(line);
    self.formatter.write_adjacent_rooms(level, room_index, line);
    console.write_line(line);
}

machine GameView::render_look(
    &mut self,
    level: Level,
    room_index: usize,
    console: &mut Console,
    line: &mut String
) {
    self.formatter.write_room_info(level, room_index, line);
    console.write_line(line);
    self.formatter.write_room_event(level, room_index, line);
    console.write_line(line);
}

machine GameView::render_exits(
    &mut self,
    level: Level,
    room_index: usize,
    console: &mut Console,
    line: &mut String
) {
    self.formatter.write_adjacent_rooms(level, room_index, line);
    console.write_line(line);
}

machine GameView::render_inventory(
    &mut self,
    player: Player,
    console: &mut Console,
    line: &mut String
) {
    self.formatter.write_inventory(player, line);
    console.write_line(line);
}

machine GameView::render_character(
    &mut self,
    player: Player,
    console: &mut Console,
    line: &mut String
) {
    self.formatter.write_character(player, line);
    console.write_line(line);
}

machine GameView::render_prompt(
    &mut self,
    console: &mut Console
) {
    console.write("> ");
}

machine GameView::render_line(
    &mut self,
    line: String,
    console: &mut Console
) {
    console.write_line(line);
}

machine GameView::render_invalid_command(
    &mut self,
    console: &mut Console
) {
    console.write_line("That path is not open.");
}

machine GameView::render_game_over(
    &mut self,
    console: &mut Console
) {
    console.write_line("Game over.");
}

machine GameView::render_goodbye(
    &mut self,
    console: &mut Console
) {
    console.write_line("Goodbye.");
}
