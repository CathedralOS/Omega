use dungeon::dungeon;
use platform::console;
use platform::console_types;
use rooms::room_formatter;

data GameView {
    formatter: RoomFormatter;
}

machine for GameView {
    fn render_title(&mut self, console: &mut ConsolePlatform) {
        console.write_line("Omega Dungeon");
        console.write_line("A tiny generated crawl for compiler stress.");
        console.write_line("Type look, exits, a direction, or quit.");
    }

    fn render_room(&mut self, dungeon: Dungeon, console: &mut ConsolePlatform, line: &mut ConsoleLine) {
        self.formatter.write_current_cell(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_room_info(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_room_event(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_adjacent_rooms(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
    }

    fn render_look(&mut self, dungeon: Dungeon, console: &mut ConsolePlatform, line: &mut ConsoleLine) {
        self.formatter.write_room_info(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_room_event(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
    }

    fn render_exits(&mut self, dungeon: Dungeon, console: &mut ConsolePlatform, line: &mut ConsoleLine) {
        self.formatter.write_adjacent_rooms(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
    }

    fn render_inventory(&mut self, dungeon: Dungeon, console: &mut ConsolePlatform, line: &mut ConsoleLine) {
        self.formatter.write_inventory(dungeon.player, line);
        console.write_line(line.text);
    }

    fn render_character(&mut self, dungeon: Dungeon, console: &mut ConsolePlatform, line: &mut ConsoleLine) {
        self.formatter.write_character(dungeon.player, line);
        console.write_line(line.text);
    }

    fn render_prompt(&mut self, console: &mut ConsolePlatform) {
        console.write("> ");
    }

    fn render_line(&mut self, line: ConsoleLine, console: &mut ConsolePlatform) {
        console.write_line(line.text);
    }

    fn render_invalid_command(&mut self, console: &mut ConsolePlatform) {
        console.write_line("That path is not open.");
    }

    fn render_game_over(&mut self, console: &mut ConsolePlatform) {
        console.write_line("Game over.");
    }

    fn render_goodbye(&mut self, console: &mut ConsolePlatform) {
        console.write_line("Goodbye.");
    }
}
