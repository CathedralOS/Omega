use dungeon::dungeon;
use platform::console;
use platform::console_types;
use rooms::room_formatter;

data GameView {
    formatter: RoomFormatter;
}

machine for GameView {
    pub entry render_title(
        &mut self,
        console: &mut ConsolePlatform
    ) {
        console.write_line("Omega Dungeon");
        console.write_line("A tiny generated crawl for compiler stress.");
        console.write_line("Type look, exits, a direction, or quit.");
    }
}

machine for GameView {
    pub entry render_room(
        &mut self,
        dungeon: Dungeon,
        console: &mut ConsolePlatform,
        line: &mut ConsoleLine
    ) {
        self.formatter.write_current_cell(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_room_info(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_room_event(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_adjacent_rooms(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
    }
}

machine for GameView {
    pub entry render_look(
        &mut self,
        dungeon: Dungeon,
        console: &mut ConsolePlatform,
        line: &mut ConsoleLine
    ) {
        self.formatter.write_room_info(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
        self.formatter.write_room_event(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
    }
}

machine for GameView {
    pub entry render_exits(
        &mut self,
        dungeon: Dungeon,
        console: &mut ConsolePlatform,
        line: &mut ConsoleLine
    ) {
        self.formatter.write_adjacent_rooms(dungeon.level, dungeon.current_cell, line);
        console.write_line(line.text);
    }
}

machine for GameView {
    pub entry render_inventory(
        &mut self,
        dungeon: Dungeon,
        console: &mut ConsolePlatform,
        line: &mut ConsoleLine
    ) {
        self.formatter.write_inventory(dungeon.player, line);
        console.write_line(line.text);
    }
}

machine for GameView {
    pub entry render_character(
        &mut self,
        dungeon: Dungeon,
        console: &mut ConsolePlatform,
        line: &mut ConsoleLine
    ) {
        self.formatter.write_character(dungeon.player, line);
        console.write_line(line.text);
    }
}

machine for GameView {
    pub entry render_prompt(
        &mut self,
        console: &mut ConsolePlatform
    ) {
        console.write("> ");
    }
}

machine for GameView {
    pub entry render_line(
        &mut self,
        line: ConsoleLine,
        console: &mut ConsolePlatform
    ) {
        console.write_line(line.text);
    }
}

machine for GameView {
    pub entry render_invalid_command(
        &mut self,
        console: &mut ConsolePlatform
    ) {
        console.write_line("That path is not open.");
    }
}

machine for GameView {
    pub entry render_game_over(
        &mut self,
        console: &mut ConsolePlatform
    ) {
        console.write_line("Game over.");
    }
}

machine for GameView {
    pub entry render_goodbye(
        &mut self,
        console: &mut ConsolePlatform
    ) {
        console.write_line("Goodbye.");
    }
}
