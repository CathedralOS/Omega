use events::room_events;
use rng::random;
use rng::random_state;
use rooms::map;
use rooms::rooms;

data MazeBuilder {
    events: RoomEvents;
    rng: Random;
}

machine MazeBuilder::build {
    pub entry(
        &mut self,
        seed: u64[wrapping],
        level: &mut Level
    ) {
        let random: RandomState;
        self.rng.seed(seed, &mut random);

        level.start_cell = CellId::R00;
        level.room_count = 0;
        level.deepest_depth = 0;

        self.carve_room(level, &mut random, CellId::R00, 0, 0);
        self.branch(level, &mut random, CellId::R00, 0, 0);
    }

    fn branch(
        &mut self,
        level: &mut Level,
        random: &mut RandomState,
        from: CellId,
        depth: u32[exact, non_negative],
        branch_id: u32[exact, non_negative]
    ) {
        let next_depth: u32[exact, non_negative] = depth + 1;
        let carve_north_path: bool = self.should_carve(random, next_depth);
        let carve_east_path: bool = self.should_carve(random, next_depth);
        let carve_west_path: bool = self.should_carve(random, next_depth);

        -> carve_north(level, random, from, next_depth, branch_id) when carve_north_path;
        -> carve_east(level, random, from, next_depth, branch_id + 1) when carve_east_path;
        -> carve_west(level, random, from, next_depth, branch_id + 2) when carve_west_path;
    }

    state carve_north(
        &mut self,
        level: &mut Level,
        random: &mut RandomState,
        from: CellId,
        depth: u32[exact, non_negative],
        branch_id: u32[exact, non_negative]
    ) {
        let target: CellId = self.next_unused_cell(level);
        self.carve_room(level, random, target, depth, branch_id);
        self.connect(level, from, target, Direction::North);

        transition depth < 10 {
            true -> branch(level, random, target, depth, branch_id)
            false -> {}
        }
    }

    state carve_east(
        &mut self,
        level: &mut Level,
        random: &mut RandomState,
        from: CellId,
        depth: u32[exact, non_negative],
        branch_id: u32[exact, non_negative]
    ) {
        let target: CellId = self.next_unused_cell(level);
        self.carve_room(level, random, target, depth, branch_id);
        self.connect(level, from, target, Direction::East);

        transition depth < 10 {
            true -> branch(level, random, target, depth, branch_id)
            false -> {}
        }
    }

    state carve_west(
        &mut self,
        level: &mut Level,
        random: &mut RandomState,
        from: CellId,
        depth: u32[exact, non_negative],
        branch_id: u32[exact, non_negative]
    ) {
        let target: CellId = self.next_unused_cell(level);
        self.carve_room(level, random, target, depth, branch_id);
        self.connect(level, from, target, Direction::West);

        transition depth < 10 {
            true -> branch(level, random, target, depth, branch_id)
            false -> {}
        }
    }

    fn should_carve(
        &mut self,
        random: &mut RandomState,
        depth: u32[exact, non_negative]
    ) -> bool {
        let chance: u32[exact, range<0, 100>] = max(15, 80 - depth * 6);

        -> self.rng.chance(random, chance, 100);
    }

    fn carve_room(
        &mut self,
        level: &mut Level,
        random: &mut RandomState,
        cell: CellId,
        depth: u32[exact, non_negative],
        branch_id: u32[exact, non_negative]
    ) {
        let rooms: &mut [Room] = level.rooms.as_mut_slice();
        let index: IndexOf<rooms> = self.cell_index(cell);
        rooms[index].cell = cell;
        rooms[index].depth = depth;
        rooms[index].branch = branch_id;
        rooms[index].label = self.room_label(cell);
        rooms[index].description = self.room_description(depth, branch_id);
        rooms[index].exit_count = 0;
        rooms[index].discovered = cell == level.start_cell;
        self.events.roll_event(depth, random, &mut rooms[index].event);
        level.room_count = max(level.room_count, index + 1);
        level.deepest_depth = max(level.deepest_depth, depth);
    }

    fn connect(
        &mut self,
        level: &mut Level,
        from: CellId,
        to: CellId,
        direction: Direction
    ) {
        let rooms: &mut [Room] = level.rooms.as_mut_slice();
        let from_index: IndexOf<rooms> = self.cell_index(from);
        let to_index: IndexOf<rooms> = self.cell_index(to);

        self.append_exit(&mut rooms[from_index], self.direction_command(direction), direction, to);
        self.append_exit(&mut rooms[to_index], self.direction_command(self.opposite(direction)), self.opposite(direction), from);
    }

    fn append_exit(
        &mut self,
        room: &mut Room,
        command: String,
        direction: Direction,
        destination: CellId
    ) {
        let exits: &mut [Exit] = room.exits.as_mut_slice();
        let index: IndexOf<exits> = room.exit_count;
        exits[index] = Exit { command: command, direction: direction, destination: destination };
        room.exit_count = room.exit_count + 1;
    }

    fn next_unused_cell(
        &mut self,
        level: Level
    ) -> CellId {
        -> CellId::R01 when level.room_count == 1;
        -> CellId::R02 when level.room_count == 2;
        -> CellId::R03 when level.room_count == 3;
        -> CellId::R04 when level.room_count == 4;
        -> CellId::R05 when level.room_count == 5;
        -> CellId::R06 when level.room_count == 6;
        -> CellId::R07 when level.room_count == 7;
        -> CellId::R08 when level.room_count == 8;
        -> CellId::R09 when level.room_count == 9;
        -> CellId::R10 when level.room_count == 10;
        -> CellId::R11 when level.room_count == 11;
        -> CellId::R12 when level.room_count == 12;
        -> CellId::R13 when level.room_count == 13;
        -> CellId::R14 when level.room_count == 14;
        -> CellId::R15;
    }

    fn cell_index(
        &mut self,
        cell: CellId
    ) -> usize {
        -> 0 when cell == CellId::R00;
        -> 1 when cell == CellId::R01;
        -> 2 when cell == CellId::R02;
        -> 3 when cell == CellId::R03;
        -> 4 when cell == CellId::R04;
        -> 5 when cell == CellId::R05;
        -> 6 when cell == CellId::R06;
        -> 7 when cell == CellId::R07;
        -> 8 when cell == CellId::R08;
        -> 9 when cell == CellId::R09;
        -> 10 when cell == CellId::R10;
        -> 11 when cell == CellId::R11;
        -> 12 when cell == CellId::R12;
        -> 13 when cell == CellId::R13;
        -> 14 when cell == CellId::R14;
        -> 15;
    }

    fn room_label(
        &mut self,
        cell: CellId
    ) -> String {
        -> "Gate" when cell == CellId::R00;
        -> "Branch Room";
    }

    fn room_description(
        &mut self,
        depth: u32[exact, non_negative],
        branch_id: u32[exact, non_negative]
    ) -> String {
        -> "A cracked limestone room at depth " + depth.to_string() + ", branch " + branch_id.to_string() + ".";
    }

    fn direction_command(
        &mut self,
        direction: Direction
    ) -> String {
        -> "north" when direction == Direction::North;
        -> "south" when direction == Direction::South;
        -> "east" when direction == Direction::East;
        -> "west";
    }

    fn opposite(
        &mut self,
        direction: Direction
    ) -> Direction {
        -> Direction::South when direction == Direction::North;
        -> Direction::North when direction == Direction::South;
        -> Direction::West when direction == Direction::East;
        -> Direction::East;
    }
}
