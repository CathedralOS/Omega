use events::room_events;
use rng::random;
use rng::random_state;
use rooms::map;
use rooms::rooms;

machine MazeBuilder {
    contains events: RoomEvents;
    contains rng: Random;

    fn build(seed: u64[wrapping], level: &mut Level) {
        let random: RandomState;
        self.rng.seed(seed, mut random);

        level.start_cell = CellId::R00;
        level.room_count = 0;
        level.deepest_depth = 0;

        self.carve_room(level, mut random, CellId::R00, 0, 0);
        self.branch(level, mut random, CellId::R00, 0, 0);
    }

    fn branch(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let next_depth: u32[exact, non_negative] = depth + 1;

        transition (
            self.should_carve(random, next_depth),
            self.should_carve(random, next_depth),
            self.should_carve(random, next_depth)
        ) {
            (true, _, _) -> carve_north(level, random, from, next_depth, branch_id)
            (false, true, _) -> carve_east(level, random, from, next_depth, branch_id + 1)
            (false, false, true) -> carve_west(level, random, from, next_depth, branch_id + 2)
            _ -> {}
        }
    }

    state carve_north(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let target: CellId = self.next_unused_cell(level);
        self.carve_room(level, random, target, depth, branch_id);
        self.connect(level, from, target, Direction::North);

        transition depth < 10 {
            true -> branch(level, random, target, depth, branch_id)
            false -> {}
        }
    }

    state carve_east(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let target: CellId = self.next_unused_cell(level);
        self.carve_room(level, random, target, depth, branch_id);
        self.connect(level, from, target, Direction::East);

        transition depth < 10 {
            true -> branch(level, random, target, depth, branch_id)
            false -> {}
        }
    }

    state carve_west(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let target: CellId = self.next_unused_cell(level);
        self.carve_room(level, random, target, depth, branch_id);
        self.connect(level, from, target, Direction::West);

        transition depth < 10 {
            true -> branch(level, random, target, depth, branch_id)
            false -> {}
        }
    }

    fn should_carve(random: &mut RandomState, depth: u32[exact, non_negative]) -> bool {
        let chance: u32[exact, range<0, 100>] = max(15, 80 - depth * 6);

        -> self.rng.chance(random, chance, 100);
    }

    fn carve_room(level: &mut Level, random: &mut RandomState, cell: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let rooms: &mut [Room] = level.rooms.as_mut_slice();
        let index: IndexOf<rooms> = self.cell_index(cell);
        rooms[index].cell = cell;
        rooms[index].depth = depth;
        rooms[index].branch = branch_id;
        rooms[index].label = self.room_label(cell);
        rooms[index].description = self.room_description(depth, branch_id);
        rooms[index].exit_count = 0;
        rooms[index].discovered = cell == level.start_cell;
        self.events.roll_event(depth, random, mut rooms[index].event);
        level.room_count = max(level.room_count, index + 1);
        level.deepest_depth = max(level.deepest_depth, depth);
    }

    fn connect(level: &mut Level, from: CellId, to: CellId, direction: Direction) {
        let rooms: &mut [Room] = level.rooms.as_mut_slice();
        let from_index: IndexOf<rooms> = self.cell_index(from);
        let to_index: IndexOf<rooms> = self.cell_index(to);

        self.append_exit(mut rooms[from_index], self.direction_command(direction), direction, to);
        self.append_exit(mut rooms[to_index], self.direction_command(self.opposite(direction)), self.opposite(direction), from);
    }

    fn append_exit(room: &mut Room, command: String, direction: Direction, destination: CellId) {
        let exits: &mut [Exit] = room.exits.as_mut_slice();
        let index: IndexOf<exits> = room.exit_count;
        exits[index] = Exit { command: command, direction: direction, destination: destination };
        room.exit_count = room.exit_count + 1;
    }

    fn next_unused_cell(level: Level) -> CellId {
        match level.room_count {
            1 -> CellId::R01
            2 -> CellId::R02
            3 -> CellId::R03
            4 -> CellId::R04
            5 -> CellId::R05
            6 -> CellId::R06
            7 -> CellId::R07
            8 -> CellId::R08
            9 -> CellId::R09
            10 -> CellId::R10
            11 -> CellId::R11
            12 -> CellId::R12
            13 -> CellId::R13
            14 -> CellId::R14
            _ -> CellId::R15
        }
    }

    fn cell_index(cell: CellId) -> usize {
        match cell {
            CellId::R00 -> 0
            CellId::R01 -> 1
            CellId::R02 -> 2
            CellId::R03 -> 3
            CellId::R04 -> 4
            CellId::R05 -> 5
            CellId::R06 -> 6
            CellId::R07 -> 7
            CellId::R08 -> 8
            CellId::R09 -> 9
            CellId::R10 -> 10
            CellId::R11 -> 11
            CellId::R12 -> 12
            CellId::R13 -> 13
            CellId::R14 -> 14
            _ -> 15
        }
    }

    fn room_label(cell: CellId) -> String {
        match cell {
            CellId::R00 -> "Gate"
            _ -> "Branch Room"
        }
    }

    fn room_description(depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) -> String {
        -> "A cracked limestone room at depth " + depth.to_string() + ", branch " + branch_id.to_string() + ".";
    }

    fn direction_command(direction: Direction) -> String {
        match direction {
            Direction::North -> "north"
            Direction::South -> "south"
            Direction::East -> "east"
            Direction::West -> "west"
        }
    }

    fn opposite(direction: Direction) -> Direction {
        match direction {
            Direction::North -> Direction::South
            Direction::South -> Direction::North
            Direction::East -> Direction::West
            Direction::West -> Direction::East
        }
    }
}
