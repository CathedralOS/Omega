use enemies::enemies;
use events::room_events;
use events::events;
use inventory::items;
use rng::random;
use rng::random_state;
use rewards::rewards;
use rooms::map;
use rooms::rooms;

data MazeBuilder {
    events: RoomEvents;
    rng: Random;
}

machine MazeBuilder::build(
    &mut self,
    seed: u64,
    level: &mut Level
) {
    let random: RandomState;
    self.rng.seed(seed, &mut random);
    self.clear_level(level);

    level.start_cell = CellId::R00;
    level.room_count = 0;
    level.deepest_depth = 0;

    self.carve_room(level, &mut random, CellId::R00, 0, 0);
    self.force_quiet_room(level, CellId::R00);
    transition {
        _ -> build_main_hall_1(level, &mut random)
    }


    state build_main_hall_1(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R00, CellId::R01, 1, 0, Direction::North);

        transition {
            _ -> maybe_side_room_1(level, random)
        }
    }

    state maybe_side_room_1(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition self.should_carve(random, 2) {
            true -> build_side_room_1(level, random)
            false -> build_main_hall_2(level, random)
        }
    }

    state build_side_room_1(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R01, CellId::R05, 2, 10, Direction::East);

        transition {
            _ -> build_main_hall_2(level, random)
        }
    }

    state build_main_hall_2(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R01, CellId::R02, 2, 0, Direction::North);

        transition {
            _ -> maybe_side_room_2(level, random)
        }
    }

    state maybe_side_room_2(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition self.should_carve(random, 3) {
            true -> build_side_room_2(level, random)
            false -> build_main_hall_3(level, random)
        }
    }

    state build_side_room_2(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R02, CellId::R06, 3, 11, Direction::West);

        transition {
            _ -> build_main_hall_3(level, random)
        }
    }

    state build_main_hall_3(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R02, CellId::R03, 3, 0, Direction::North);

        transition {
            _ -> maybe_side_room_3(level, random)
        }
    }

    state maybe_side_room_3(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition self.should_carve(random, 4) {
            true -> build_side_room_3(level, random)
            false -> build_main_hall_4(level, random)
        }
    }

    state build_side_room_3(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R03, CellId::R07, 4, 12, Direction::East);

        transition {
            _ -> build_main_hall_4(level, random)
        }
    }

    state build_main_hall_4(
        &mut self,
        level: &mut Level,
        random: &mut RandomState
    ) {
        self.build_segment(level, random, CellId::R03, CellId::R04, 4, 0, Direction::North);
        level.room_count = 8;
        level.deepest_depth = max(level.deepest_depth, 4);
    }
}

machine MazeBuilder::build_segment(
    &mut self,
    level: &mut Level,
    random: &mut RandomState,
    from: CellId,
    target: CellId,
    depth: u32,
    branch_id: u32,
    direction: Direction
) {
    self.carve_room(level, random, target, depth, branch_id);
    self.connect(level, from, target, direction);
}

machine MazeBuilder::force_quiet_room(
    &mut self,
    level: &mut Level,
    cell: CellId
) {
    let room: &mut Room = self.room_mut(level, cell);
    self.clear_event(&mut room.event);
}

machine MazeBuilder::clear_level(
    &mut self,
    level: &mut Level
) {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();
    self.clear_room(&mut rooms[0], CellId::R00);
    self.clear_room(&mut rooms[1], CellId::R01);
    self.clear_room(&mut rooms[2], CellId::R02);
    self.clear_room(&mut rooms[3], CellId::R03);
    self.clear_room(&mut rooms[4], CellId::R04);
    self.clear_room(&mut rooms[5], CellId::R05);
    self.clear_room(&mut rooms[6], CellId::R06);
    self.clear_room(&mut rooms[7], CellId::R07);
    self.clear_room(&mut rooms[8], CellId::R08);
    self.clear_room(&mut rooms[9], CellId::R09);
    self.clear_room(&mut rooms[10], CellId::R10);
    self.clear_room(&mut rooms[11], CellId::R11);
    self.clear_room(&mut rooms[12], CellId::R12);
    self.clear_room(&mut rooms[13], CellId::R13);
    self.clear_room(&mut rooms[14], CellId::R14);
    self.clear_room(&mut rooms[15], CellId::R15);
}

machine MazeBuilder::clear_room(
    &mut self,
    room: &mut Room,
    cell: CellId
) {
    room.cell = cell;
    room.depth = 0;
    room.branch = 0;
    room.label = "";
    room.description = "";
    room.exit_count = 0;
    room.discovered = false;
    self.clear_exits(room);
    self.clear_event(&mut room.event);
}

machine MazeBuilder::clear_exits(
    &mut self,
    room: &mut Room
) {
    let exits: &mut [Exit] = room.exits.as_mut_slice();
    exits[0] = self.blank_exit();
    exits[1] = self.blank_exit();
    exits[2] = self.blank_exit();
    exits[3] = self.blank_exit();
}

machine MazeBuilder::clear_event(
    &mut self,
    event: &mut RoomEvent
) {
    event.kind = RoomEventKind::Nothing;
    event.enemy = self.empty_enemy();
    event.reward = self.empty_reward();
    event.consumed = true;
}

machine MazeBuilder::blank_exit(&mut self) -> Exit {
    Exit {
        command: "",
        direction: Direction::North,
        destination: CellId::Empty
    }
}

machine MazeBuilder::empty_enemy(&mut self) -> Enemy {
    Enemy {
        kind: EnemyKind::Bat,
        name: "",
        max_health: 1,
        health: 1,
        attack: 1,
        defense: 0,
        xp_reward: 0,
        depth: 0
    }
}

machine MazeBuilder::empty_reward(&mut self) -> Reward {
    Reward {
        kind: RewardKind::None,
        gold: 0,
        item: ItemKind::RustedDagger
    }
}

machine MazeBuilder::should_carve(
    &mut self,
    random: &mut RandomState,
    depth: u32
    ) -> bool {
    let chance: u32 = max(15, 80 - depth * 6);
    let rolled: bool = self.rng.chance(random, chance, 100);

    -> rolled;
}

machine MazeBuilder::carve_room(
    &mut self,
    level: &mut Level,
    random: &mut RandomState,
    cell: CellId,
    depth: u32,
    branch_id: u32
) {
    let room: &mut Room = self.room_mut(level, cell);
    let index: usize = self.cell_index(cell);
    room.cell = cell;
    room.depth = depth;
    room.branch = branch_id;
    room.label = self.room_label(cell);
    room.description = self.room_description(depth, branch_id);
    room.exit_count = 0;
    room.discovered = cell == level.start_cell;
    self.events.roll_event(depth, random, &mut room.event);
    level.room_count = max(level.room_count, index + 1);
    level.deepest_depth = max(level.deepest_depth, depth);
}

machine MazeBuilder::connect(
    &mut self,
    level: &mut Level,
    from: CellId,
    to: CellId,
    direction: Direction
) {
    let from_room: &mut Room = self.room_mut(level, from);
    self.append_exit(from_room, self.direction_command(direction), direction, to);

    let to_room: &mut Room = self.room_mut(level, to);
    self.append_exit(to_room, self.direction_command(self.opposite(direction)), self.opposite(direction), from);
}

machine MazeBuilder::room_mut(
    &mut self,
    level: &mut Level,
    cell: CellId
) -> &mut Room {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();

    transition cell {
        CellId::R00 -> &mut rooms[0]
        CellId::R01 -> &mut rooms[1]
        CellId::R02 -> &mut rooms[2]
        CellId::R03 -> &mut rooms[3]
        CellId::R04 -> &mut rooms[4]
        CellId::R05 -> &mut rooms[5]
        CellId::R06 -> &mut rooms[6]
        CellId::R07 -> &mut rooms[7]
        CellId::R08 -> &mut rooms[8]
        CellId::R09 -> &mut rooms[9]
        CellId::R10 -> &mut rooms[10]
        CellId::R11 -> &mut rooms[11]
        CellId::R12 -> &mut rooms[12]
        CellId::R13 -> &mut rooms[13]
        CellId::R14 -> &mut rooms[14]
        CellId::R15 -> &mut rooms[15]
        _ -> &mut rooms[0]
    }
}

machine MazeBuilder::append_exit(
    &mut self,
    room: &mut Room,
    command: String,
    direction: Direction,
    destination: CellId
) {
    transition room.exit_count {
        0 -> append_exit_slot_0(room, command, direction, destination)
        1 -> append_exit_slot_1(room, command, direction, destination)
        2 -> append_exit_slot_2(room, command, direction, destination)
        3 -> append_exit_slot_3(room, command, direction, destination)
        _ -> {}
    }


    state append_exit_slot_0(
        &mut self,
        room: &mut Room,
        command: String,
        direction: Direction,
        destination: CellId
    ) {
        let exits: &mut [Exit] = room.exits.as_mut_slice();
        exits[0] = Exit { command: command, direction: direction, destination: destination };
        room.exit_count = 1;
    }

    state append_exit_slot_1(
        &mut self,
        room: &mut Room,
        command: String,
        direction: Direction,
        destination: CellId
    ) {
        let exits: &mut [Exit] = room.exits.as_mut_slice();
        exits[1] = Exit { command: command, direction: direction, destination: destination };
        room.exit_count = 2;
    }

    state append_exit_slot_2(
        &mut self,
        room: &mut Room,
        command: String,
        direction: Direction,
        destination: CellId
    ) {
        let exits: &mut [Exit] = room.exits.as_mut_slice();
        exits[2] = Exit { command: command, direction: direction, destination: destination };
        room.exit_count = 3;
    }

    state append_exit_slot_3(
        &mut self,
        room: &mut Room,
        command: String,
        direction: Direction,
        destination: CellId
    ) {
        let exits: &mut [Exit] = room.exits.as_mut_slice();
        exits[3] = Exit { command: command, direction: direction, destination: destination };
        room.exit_count = 4;
    }
}

machine MazeBuilder::next_unused_cell(
    &mut self,
    level: Level
    ) -> CellId {
    -> CellId::R01 when level.room_count == 1;
    -> CellId::R02 when level.room_count == 2;
    -> CellId::R03 when level.room_count == 3;
    -> CellId::R04 when level.room_count == 4;
    -> CellId::R05 when level.room_count == 5;
    -> CellId::R06 when level.room_count == 6;
    -> CellId::R07 when level.room_count == 7;
    -> CellId::R08 when level.room_count == 8;
    -> CellId::R09 when level.room_count == 9;
    -> CellId::R10 when level.room_count == 10;
    -> CellId::R11 when level.room_count == 11;
    -> CellId::R12 when level.room_count == 12;
    -> CellId::R13 when level.room_count == 13;
    -> CellId::R14 when level.room_count == 14;
    -> CellId::R15;
}

machine MazeBuilder::cell_index(
    &mut self,
    cell: CellId
    ) -> usize {
    -> 0 when cell == CellId::R00;
    -> 1 when cell == CellId::R01;
    -> 2 when cell == CellId::R02;
    -> 3 when cell == CellId::R03;
    -> 4 when cell == CellId::R04;
    -> 5 when cell == CellId::R05;
    -> 6 when cell == CellId::R06;
    -> 7 when cell == CellId::R07;
    -> 8 when cell == CellId::R08;
    -> 9 when cell == CellId::R09;
    -> 10 when cell == CellId::R10;
    -> 11 when cell == CellId::R11;
    -> 12 when cell == CellId::R12;
    -> 13 when cell == CellId::R13;
    -> 14 when cell == CellId::R14;
    -> 15;
}

machine MazeBuilder::room_label(
    &mut self,
    cell: CellId
    ) -> String {
    -> "Gate" when cell == CellId::R00;
    -> "Branch Room";
}

machine MazeBuilder::room_description(
    &mut self,
    depth: u32,
    branch_id: u32
    ) -> String {
    -> "The old gate room breathes cold air from below." when depth == 0;
    -> "A shallow limestone room with fresh claw marks." when depth <= 2;
    -> "A winding branch room where the walls sweat mineral dust." when depth <= 5;
    -> "A deep chamber with old bones underfoot." when depth <= 8;
    -> "A bottomless dark room near the dungeon heart.";
}

machine MazeBuilder::direction_command(
    &mut self,
    direction: Direction
    ) -> String {
    -> "north" when direction == Direction::North;
    -> "south" when direction == Direction::South;
    -> "east" when direction == Direction::East;
    -> "west";
}

machine MazeBuilder::opposite(
    &mut self,
    direction: Direction
    ) -> Direction {
    -> Direction::South when direction == Direction::North;
    -> Direction::North when direction == Direction::South;
    -> Direction::West when direction == Direction::East;
    -> Direction::East;
}
