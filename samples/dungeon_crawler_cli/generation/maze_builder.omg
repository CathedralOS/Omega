use data::events;
use data::map;
use data::random_state;
use data::rooms;
use events::room_events;
use rng::random;

machine MazeBuilder {
    contains events: RoomEvents;
    contains rng: Random;

    fn build(seed: u64[wrapping], level: &mut Level) {
        let random: RandomState;
        rng.seed(seed, mut random);

        level.start_cell = CellId::R00;
        level.room_count = 0;
        level.deepest_depth = 0;

        carve_room(level, mut random, CellId::R00, 0, 0);
        branch(level, mut random, CellId::R00, 0, 0);
    }

    fn branch(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let next_depth: u32[exact, non_negative] = depth + 1;

        -> carve_north(level, random, from, next_depth, branch_id) when should_carve(random, next_depth);
        -> carve_east(level, random, from, next_depth, branch_id + 1) when should_carve(random, next_depth);
        -> carve_west(level, random, from, next_depth, branch_id + 2) when should_carve(random, next_depth);
        ->
    }

    state carve_north(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let target: CellId = next_unused_cell(level);
        carve_room(level, random, target, depth, branch_id);
        connect(level, from, target, Direction::North);

        -> branch(level, random, target, depth, branch_id) when depth < 10;
        ->
    }

    state carve_east(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let target: CellId = next_unused_cell(level);
        carve_room(level, random, target, depth, branch_id);
        connect(level, from, target, Direction::East);

        -> branch(level, random, target, depth, branch_id) when depth < 10;
        ->
    }

    state carve_west(level: &mut Level, random: &mut RandomState, from: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let target: CellId = next_unused_cell(level);
        carve_room(level, random, target, depth, branch_id);
        connect(level, from, target, Direction::West);

        -> branch(level, random, target, depth, branch_id) when depth < 10;
        ->
    }

    fn should_carve(random: &mut RandomState, depth: u32[exact, non_negative]) -> bool {
        let chance: u32[exact, range<0, 100>] = max(15, 80 - depth * 6);

        -> rng.chance(random, chance, 100);
    }

    fn carve_room(level: &mut Level, random: &mut RandomState, cell: CellId, depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) {
        let index: usize = cell_index(cell);
        level.rooms[index].cell = cell;
        level.rooms[index].depth = depth;
        level.rooms[index].branch = branch_id;
        level.rooms[index].label = room_label(cell);
        level.rooms[index].description = room_description(depth, branch_id);
        level.rooms[index].exit_count = 0;
        level.rooms[index].discovered = cell == level.start_cell;
        events.roll_event(depth, random, mut level.rooms[index].event);
        level.room_count = max(level.room_count, index + 1);
        level.deepest_depth = max(level.deepest_depth, depth);
    }

    fn connect(level: &mut Level, from: CellId, to: CellId, direction: Direction) {
        let from_index: usize = cell_index(from);
        let to_index: usize = cell_index(to);

        append_exit(mut level.rooms[from_index], direction_command(direction), direction, to);
        append_exit(mut level.rooms[to_index], direction_command(opposite(direction)), opposite(direction), from);
    }

    fn append_exit(room: &mut Room, command: String, direction: Direction, destination: CellId) {
        let index: usize = room.exit_count;
        room.exits[index] = Exit { command: command, direction: direction, destination: destination };
        room.exit_count = room.exit_count + 1;
    }

    fn next_unused_cell(level: Level) -> CellId {
        -> CellId::R01 when level.room_count == 1;
        -> CellId::R02 when level.room_count == 2;
        -> CellId::R03 when level.room_count == 3;
        -> CellId::R04 when level.room_count == 4;
        -> CellId::R05 when level.room_count == 5;
        -> CellId::R06 when level.room_count == 6;
        -> CellId::R07 when level.room_count == 7;
        -> CellId::R08 when level.room_count == 8;
        -> CellId::R09 when level.room_count == 9;
        -> CellId::R10 when level.room_count == 10;
        -> CellId::R11 when level.room_count == 11;
        -> CellId::R12 when level.room_count == 12;
        -> CellId::R13 when level.room_count == 13;
        -> CellId::R14 when level.room_count == 14;
        -> CellId::R15;
    }

    fn cell_index(cell: CellId) -> usize {
        -> 0 when cell == CellId::R00;
        -> 1 when cell == CellId::R01;
        -> 2 when cell == CellId::R02;
        -> 3 when cell == CellId::R03;
        -> 4 when cell == CellId::R04;
        -> 5 when cell == CellId::R05;
        -> 6 when cell == CellId::R06;
        -> 7 when cell == CellId::R07;
        -> 8 when cell == CellId::R08;
        -> 9 when cell == CellId::R09;
        -> 10 when cell == CellId::R10;
        -> 11 when cell == CellId::R11;
        -> 12 when cell == CellId::R12;
        -> 13 when cell == CellId::R13;
        -> 14 when cell == CellId::R14;
        -> 15;
    }

    fn room_label(cell: CellId) -> String {
        -> "Gate" when cell == CellId::R00;
        -> "Branch Room";
    }

    fn room_description(depth: u32[exact, non_negative], branch_id: u32[exact, non_negative]) -> String {
        -> "A cracked limestone room at depth " + depth.to_string() + ", branch " + branch_id.to_string() + ".";
    }

    fn direction_command(direction: Direction) -> String {
        -> "north" when direction == Direction::North;
        -> "south" when direction == Direction::South;
        -> "east" when direction == Direction::East;
        -> "west";
    }

    fn opposite(direction: Direction) -> Direction {
        -> Direction::South when direction == Direction::North;
        -> Direction::North when direction == Direction::South;
        -> Direction::West when direction == Direction::East;
        -> Direction::East;
    }
}
