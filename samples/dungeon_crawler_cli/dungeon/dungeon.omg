use events::event_runtime;
use generation::dungeon_generator;
use combat::combat_round;
use platform::console_types;
use player::player;
use player::player_state;
use rng::random;
use rng::random_state;
use rooms::map;
use rooms::room_lookup;
use rooms::rooms;

data Dungeon {
    generator: DungeonGenerator;
    events: EventRuntime;
    player_system: PlayerSystem;
    lookup: RoomLookup;
    rng: Random;

    current_cell: CellId = CellId::Empty;
    level: Level;
    navigation: Navigation;
    player: Player;
    random: RandomState;
    combat_round: CombatRound;
    mode: GameMode = GameMode::Title;
}

machine Dungeon::enter_room(&mut self) {
    transition {
        _ -> mark_current_room_discovered()
    }

    state mark_current_room_discovered(&mut self) {
        let room: Room;
        self.lookup.find_room(self.level, self.current_cell, &mut room);
        room.discovered = true;
    }
}

machine Dungeon::use_event(
    &mut self,
    line: &mut ConsoleLine
) {
    let room: Room;
    self.lookup.find_room(self.level, self.current_cell, &mut room);
    self.events.use_event(&mut self.player, &mut room, line);
}

machine Dungeon::fight(
    &mut self,
    line: &mut ConsoleLine
) {
    let room: Room;
    self.lookup.find_room(self.level, self.current_cell, &mut room);
    self.events.fight_event(&mut self.player, &mut room, &mut self.random, &mut self.combat_round, line);
}

machine Dungeon::move(&mut self) {
    self.current_cell = self.navigation.destination;
}

machine Dungeon::game_over(&mut self) {
    self.mode = GameMode::GameOver;
}

machine Dungeon::initialize(
    &mut self,
    seed: u64[wrapping]
) {
    self.rng.seed(seed, &mut self.random);
    self.player_system.create("Wanderer", &mut self.player);
    self.level.start_cell = CellId::R00;
    self.level.room_count = 2;
    self.level.deepest_depth = 1;

    let rooms: &mut [Room] = self.level.rooms.as_mut_slice();
    rooms[0].cell = CellId::R00;
    rooms[0].depth = 0;
    rooms[0].branch = 0;
    rooms[0].label = "Gate";
    rooms[0].description = "The old gate room breathes cold air from below.";
    rooms[0].exit_count = 1;
    rooms[0].discovered = true;

    let gate_exits: &mut [Exit] = rooms[0].exits.as_mut_slice();
    gate_exits[0] = Exit { command: "north", direction: Direction::North, destination: CellId::R01 };

    rooms[1].cell = CellId::R01;
    rooms[1].depth = 1;
    rooms[1].branch = 0;
    rooms[1].label = "Branch Room";
    rooms[1].description = "A shallow limestone room with fresh claw marks.";
    rooms[1].exit_count = 1;
    rooms[1].discovered = false;

    let branch_exits: &mut [Exit] = rooms[1].exits.as_mut_slice();
    branch_exits[0] = Exit { command: "south", direction: Direction::South, destination: CellId::R00 };

    self.current_cell = CellId::R00;
    self.mode = GameMode::Exploring;
}
