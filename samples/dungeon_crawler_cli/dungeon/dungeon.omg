use commands::command_parser;
use events::event_runtime;
use generation::dungeon_generator;
use combat::combat_round;
use platform::console;
use platform::console_types;
use player::player;
use player::player_state;
use rng::random;
use rng::random_state;
use rooms::map;
use rooms::room_formatter;
use rooms::room_lookup;
use rooms::rooms;

machine Dungeon {
    contains console: ConsolePlatform;
    contains generator: DungeonGenerator;
    contains parser: CommandParser;
    contains formatter: RoomFormatter;
    contains events: EventRuntime;
    contains player_system: PlayerSystem;
    contains rng: Random;

    owns command_line: ConsoleLine;
    owns current_cell: CellId = CellId::Empty;
    owns level: Level;
    owns navigation: Navigation;
    owns player: Player;
    owns random: RandomState;
    owns combat_round: CombatRound;
    owns mode: GameMode = GameMode::Title;

    state entry() {
        transition {
            _ -> enter_room()
        }
    }

    state enter_room() {
        self.mark_current_room_discovered();

        self.formatter.write_current_cell(self.level, self.current_cell, mut self.command_line);
        self.console.write_line(self.command_line.text);
        self.formatter.write_room_info(self.level, self.current_cell, mut self.command_line);
        self.console.write_line(self.command_line.text);
        self.formatter.write_room_event(self.level, self.current_cell, mut self.command_line);
        self.console.write_line(self.command_line.text);
        self.formatter.write_adjacent_rooms(self.level, self.current_cell, mut self.command_line);
        self.console.write_line(self.command_line.text);

        transition {
            _ -> prompt()
        }
    }

    state prompt() {
        transition self.player.health == 0 {
            true -> game_over()
            false -> {}
        }

        self.console.write("> ");
        self.console.read_line(mut self.command_line);
        self.navigation.choice = NavigationChoice::Invalid;
        self.navigation.destination = CellId::Empty;

        self.parser.resolve_command(self.command_line, mut self.navigation);
        self.parser.resolve_exit(self.level, self.current_cell, self.command_line, mut self.navigation);

        transition self.navigation.choice {
            NavigationChoice::Quit -> finished()
            NavigationChoice::Look -> look()
            NavigationChoice::Exits -> exits()
            NavigationChoice::Inventory -> inventory()
            NavigationChoice::Character -> character()
            NavigationChoice::UseFountain -> use_event()
            NavigationChoice::Fight -> fight()
            NavigationChoice::Move -> move()
            NavigationChoice::Invalid -> invalid_command()
        }
    }

    state look() {
        self.formatter.write_room_info(self.level, self.current_cell, mut self.command_line);
        self.console.write_line(self.command_line.text);
        self.formatter.write_room_event(self.level, self.current_cell, mut self.command_line);
        self.console.write_line(self.command_line.text);

        transition {
            _ -> prompt()
        }
    }

    state exits() {
        self.formatter.write_adjacent_rooms(self.level, self.current_cell, mut self.command_line);
        self.console.write_line(self.command_line.text);

        transition {
            _ -> prompt()
        }
    }

    state inventory() {
        self.formatter.write_inventory(self.player, mut self.command_line);
        self.console.write_line(self.command_line.text);

        transition {
            _ -> prompt()
        }
    }

    state character() {
        self.formatter.write_character(self.player, mut self.command_line);
        self.console.write_line(self.command_line.text);

        transition {
            _ -> prompt()
        }
    }

    state use_event() {
        let room: Room;
        RoomLookup.find_room(self.level, self.current_cell, mut room);
        self.events.use_event(mut self.player, mut room, mut self.command_line);
        self.console.write_line(self.command_line.text);

        transition {
            _ -> prompt()
        }
    }

    state fight() {
        let room: Room;
        RoomLookup.find_room(self.level, self.current_cell, mut room);
        self.events.fight_event(mut self.player, mut room, mut self.random, mut self.combat_round, mut self.command_line);
        self.console.write_line(self.command_line.text);

        transition self.combat_round.player_defeated {
            true -> game_over()
            false -> prompt()
        }
    }

    state move() {
        self.current_cell = self.navigation.destination;

        transition {
            _ -> enter_room()
        }
    }

    state invalid_command() {
        self.console.write_line("That path is not open.");

        transition {
            _ -> prompt()
        }
    }

    state game_over() {
        self.mode = GameMode::GameOver;
        self.console.write_line("Game over.");

        transition {
            _ -> finished()
        }
    }

    state finished() {
    }

    fn start() {
        self.rng.seed(1337, mut self.random);
        self.player_system.create("Wanderer", mut self.player);
        self.generator.generate(1337, mut self.level);
        self.current_cell = self.level.start_cell;
        self.mode = GameMode::Exploring;
    }

    fn exit(return_code: i32) {
        self.console.write_line("Goodbye.");
        self.console.exit_process(return_code);
    }

    fn mark_current_room_discovered() {
        let room: Room;
        RoomLookup.find_room(self.level, self.current_cell, mut room);
        room.discovered = true;
    }
}
