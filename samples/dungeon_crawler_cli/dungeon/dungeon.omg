use events::event_runtime;
use generation::dungeon_generator;
use combat::combat_round;
use platform::console_types;
use player::player;
use player::player_state;
use rng::random;
use rng::random_state;
use rooms::map;
use rooms::room_lookup;
use rooms::rooms;

data Dungeon {
    generator: DungeonGenerator;
    events: EventRuntime;
    player_system: PlayerSystem;
    lookup: RoomLookup;
    rng: Random;

    current_cell: CellId = CellId::Empty;
    level: Level;
    navigation: Navigation;
    player: Player;
    random: RandomState;
    combat_round: CombatRound;
    mode: GameMode = GameMode::Title;
}

machine for Dungeon {
    pub entry enter_room(&mut self) {
        self.mark_current_room_discovered();
    }

    fn mark_current_room_discovered(&mut self) {
        let room: Room;
        self.lookup.find_room(self.level, self.current_cell, &mut room);
        room.discovered = true;
    }
}

machine for Dungeon {
    pub entry use_event(
        &mut self,
        line: &mut ConsoleLine
    ) {
        let room: Room;
        self.lookup.find_room(self.level, self.current_cell, &mut room);
        self.events.use_event(&mut self.player, &mut room, line);
    }
}

machine for Dungeon {
    pub entry fight(
        &mut self,
        line: &mut ConsoleLine
    ) {
        let room: Room;
        self.lookup.find_room(self.level, self.current_cell, &mut room);
        self.events.fight_event(&mut self.player, &mut room, &mut self.random, &mut self.combat_round, line);
    }
}

machine for Dungeon {
    pub entry move(&mut self) {
        self.current_cell = self.navigation.destination;
    }
}

machine for Dungeon {
    pub entry game_over(&mut self) {
        self.mode = GameMode::GameOver;
    }
}

machine for Dungeon {
    pub entry new(seed: u64[wrapping]) -> Dungeon {
        let dungeon: Dungeon;

        dungeon.rng.seed(seed, &mut dungeon.random);
        dungeon.player_system.create("Wanderer", &mut dungeon.player);
        dungeon.generator.generate(seed, &mut dungeon.level);
        dungeon.current_cell = dungeon.level.start_cell;
        dungeon.mode = GameMode::Exploring;

        -> dungeon;
    }
}
