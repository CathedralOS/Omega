// Roman numeral -> integer. Scan the characters left to right accumulating each symbol's value; when
// a symbol is larger than the one before it (a subtractive pair like IV or CM), undo the previous
// addition twice, because that smaller symbol should have been subtracted. For "MCMXCIV" this yields
// 1994 (M=1000, CM=900, XC=90, IV=4). A real parsing algorithm: `.len`-bounded carrier iteration, a
// per-byte value lookup (comparison chain), and the look-back subtraction rule -- all on the working
// surface. Expected exit: 70 (checks the parse equals 1994).

domain [u8]::Utf8 when valid_utf8(self) {
}
domain [u8; 16]::Utf8 when valid_utf8(self) {
}

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    text: [u8; 16] in Utf8;
    i: i32 in Trapping;
    b: u8;
    v: i32 in Wrapping;
    prev: i32 in Wrapping;
    total: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.text = "MCMXCIV";
    self.i = 0;
    self.prev = 0;
    self.total = 0;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.i < self.text.len { true -> read() _ -> done() }
    }
    state read(&mut self) {
        self.b = self.text[self.i];
        transition { _ -> value() }
    }
    // Byte -> symbol value (M=77 D=68 C=67 L=76 X=88 V=86 I=73).
    state value(&mut self) { transition self.b == 77 { true -> set1000() _ -> chk_d() } }
    state chk_d(&mut self) { transition self.b == 68 { true -> set500() _ -> chk_c() } }
    state chk_c(&mut self) { transition self.b == 67 { true -> set100() _ -> chk_l() } }
    state chk_l(&mut self) { transition self.b == 76 { true -> set50() _ -> chk_x() } }
    state chk_x(&mut self) { transition self.b == 88 { true -> set10() _ -> chk_v() } }
    state chk_v(&mut self) { transition self.b == 86 { true -> set5() _ -> chk_i() } }
    state chk_i(&mut self) { transition self.b == 73 { true -> set1() _ -> bad() } }
    state set1000(&mut self) { self.v = 1000; transition { _ -> accum() } }
    state set500(&mut self) { self.v = 500; transition { _ -> accum() } }
    state set100(&mut self) { self.v = 100; transition { _ -> accum() } }
    state set50(&mut self) { self.v = 50; transition { _ -> accum() } }
    state set10(&mut self) { self.v = 10; transition { _ -> accum() } }
    state set5(&mut self) { self.v = 5; transition { _ -> accum() } }
    state set1(&mut self) { self.v = 1; transition { _ -> accum() } }

    state accum(&mut self) {
        self.total = self.total + self.v;
        transition self.prev < self.v { true -> correct() _ -> advance() }
    }
    state correct(&mut self) {
        self.total = self.total - self.prev;
        self.total = self.total - self.prev;
        transition { _ -> advance() }
    }
    state advance(&mut self) {
        self.prev = self.v;
        self.i = self.i + 1;
        transition { _ -> step() }
    }
    state done(&mut self) {
        transition self.total == 1994 { true -> ok() _ -> mismatch() }
    }
    state ok(&mut self) { self.console.exit_process(70); }
    state mismatch(&mut self) { self.console.exit_process(71); }
    state bad(&mut self) { self.console.exit_process(99); }
}
