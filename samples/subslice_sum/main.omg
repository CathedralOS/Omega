// Subslice sum: subslices + indexing combined with a loop-like dispatch chain.
//
// Exercises: passing subslices to helper machines, shrinking-window iteration
// (the `s[1..]` pattern) combined with a running total accumulated via a
// dispatch-chain loop (value-returning recursive machine), and a final
// equality check.
//
// Dataset: [3, 7, 12, 18, 5, 25] (6 elements), sum = 70.
//
// The helper machine Adder::walk shrinks the slice on each call:
//   walk(s, acc) loops until s is empty, accumulating acc + s[0] each time.
//
// MISCOMPILE FOUND (2026-06-14):
//   Expected exit: 70  (sum [3,7,12,18,5,25] == 70)
//   Actual exit:   71  (wrong sum)
//
// This is the same miscompile shape as recursive_sum: `acc + s[0]` as an
// argument in a value-returning tail-recursive machine call. The binary
// expression `acc + s[0]` is miscompiled on the native x64 path.
//
// Expected exit: 70 (ACTUAL: 71 -- miscompile).

use omega::language::std::console;

data Adder {}

data Main {
    console: Console;
    arr: [i32; 6];
    adder: Adder;
}

// Looping value-returning machine: acc + s[0] at each step, recurse on s[1..].
machine Adder::walk(&mut self, s: &[i32], acc: i32) -> i32
terminates {
    decreases s -> Slice::Length;
}
{
    transition s.len > 0 {
        true -> walk(s[1..], acc + s[0])
        false -> acc
    }
}

machine Main::main(&mut self) {
    // Initialize the array.
    self.arr[0] = 3;
    self.arr[1] = 7;
    self.arr[2] = 12;
    self.arr[3] = 18;
    self.arr[4] = 5;
    self.arr[5] = 25;

    // Sum all 6 elements via shrinking-window recursion: 3+7+12+18+5+25 = 70.
    let s: &[i32] = self.arr.as_slice();
    let t: i32 = self.adder.walk(s, 0);

    transition t == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
