// Maximum of a slice by tail recursion over a shrinking window. find_max walks
// the slice, carrying the largest value seen so far; for [3, 7, 2, 9, 4] the answer
// is 9. Showcases three things: the `max` builtin, slice iteration via the
// shrinking-window idiom (`s[1..]`), and the bounds proof -- `s[0]` is read in the
// `s.len > 0` guard's TRUE ARM, so the guard discharges the index in the same
// transition (a read in a separate state would not carry the `len > 0` fact).
// Expected exit: 9.

use omega::language::std::console;

data Finder {
    values: [i32; 5];
}

machine Finder::find_max(&mut self, s: &[i32], current: i32) -> i32 {
    transition s.len > 0 {
        true -> find_max(s[1..], max(current, s[0]))
        false -> (current)
    }
}

data Main {
    console: Console;
    finder: Finder;
}

machine Main::main(&mut self) {
    self.finder.values[0] = 3;
    self.finder.values[1] = 7;
    self.finder.values[2] = 2;
    self.finder.values[3] = 9;
    self.finder.values[4] = 4;

    let s: &[i32] = self.finder.values.as_slice();
    let m: i32 = self.finder.find_max(s, 0);
    self.console.exit_process(m);
}
