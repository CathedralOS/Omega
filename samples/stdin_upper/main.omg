// stdin_upper: an input-taking FILTER — reads bytes until a '.' terminator,
// uppercases a..z, writes every byte through, exits with the byte count.
// Exercises input and dual-channel output TOGETHER: per input vector the gate
// proves the exit in the kernel AND pins the full stdout to the interpreter's
// printed pair (the render check). The '.'-terminator protocol (rather than
// EOF) keeps the loop shape guard-driven; end-of-input still lands on
// `ByteRead::Eof` (ordinal 0, the ZII zero case) and exits like the '.'.
//
// Expected exit: 0.
// INPUT-GRID:
//   "." -> 0
//   "a." -> 1
//   "hi." -> 2
//   "Mix." -> 3
//   "a z." -> 3
//
// The running totals are the values live across the read loop, so they travel
// as state arguments rather than fields.

use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> rd(&main.console, 0) }

    state rd(console: &Binding<Console>, n: i32 in Wrapping) {
        let r: ByteRead = block Console::read_byte(console);
        transition r {
            ByteRead::Byte { value } -> chk(console, n, value)
            _ -> fin(console, n)
        }
    }

    state chk(console: &Binding<Console>, n: i32 in Wrapping, value: i32) {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        transition b == 46 {
            true -> fin(console, n)
            _ -> wr(console, n, b)
        }
    }

    state wr(console: &Binding<Console>, n: i32 in Wrapping, b: i32 in Wrapping) {
        transition b >= 97 && b <= 122 {
            true -> up(console, n + 1, b)
            _ -> keep(console, n + 1, b)
        }
    }

    state up(console: &Binding<Console>, n: i32 in Wrapping, b: i32 in Wrapping) {
        let upped: i32 in Wrapping = b - 32;
        let output: i32 = upped as i32;
        Console::write_byte(console, output);
        transition { _ -> rd(console, n) }
    }

    state keep(console: &Binding<Console>, n: i32 in Wrapping, b: i32 in Wrapping) {
        let output: i32 = b as i32;
        Console::write_byte(console, output);
        transition { _ -> rd(console, n) }
    }

    state fin(console: &Binding<Console>, n: i32 in Wrapping) {
        Console::exit_process(console, n as i32);
    }
}
