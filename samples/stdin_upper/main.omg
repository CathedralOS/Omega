// stdin_upper: an input-taking FILTER — reads bytes until a '.' terminator,
// uppercases a..z, writes every byte through, exits with the byte count.
// Exercises input and dual-channel output TOGETHER: per input vector the gate
// proves the exit in the kernel AND pins the full stdout to the interpreter's
// printed pair (the render check). The '.'-terminator protocol (rather than
// EOF) keeps the loop shape guard-driven; end-of-input still lands on
// `ByteRead::Eof` (ordinal 0, the ZII zero case) and exits like the '.'.
//
// Expected exit: 0.
// INPUT-GRID:
//   "." -> 0
//   "a." -> 1
//   "hi." -> 2
//   "Mix." -> 3
//   "a z." -> 3

use omega_language_std::console;

data Main {
    console: Console;
    n: i32 in Wrapping;
}

machine Main::main(&mut self) {
    transition { _ -> rd() }

    state rd(&mut self) {
        let r: ByteRead = self.console.read_byte();
        transition r {
            ByteRead::Byte { value } -> chk(value)
            _ -> fin()
        }
    }

    state chk(&mut self, value: i32 [0..=255]) {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        transition b == 46 {
            true -> fin()
            _ -> wr(b)
        }
    }

    state wr(&mut self, b: i32 in Wrapping) {
        self.n = self.n + 1;
        transition b >= 97 && b <= 122 {
            true -> up(b)
            _ -> keep(b)
        }
    }

    state up(&mut self, b: i32 in Wrapping) {
        let upped: i32 in Wrapping = b - 32;
        let output: i32 = upped as i32;
        self.console.write_byte(output);
        transition { _ -> rd() }
    }

    state keep(&mut self, b: i32 in Wrapping) {
        let output: i32 = b as i32;
        self.console.write_byte(output);
        transition { _ -> rd() }
    }

    state fin(&mut self) {
        self.console.exit_process(self.n as i32);
    }
}
