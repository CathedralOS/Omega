// Uppercase ASCII a..z until a dot or EOF, and exit with the emitted byte count.
// ByteRead::Eof is distinct from a zero-valued Byte payload.
// Expected exit: 0.
// INPUT-GRID:
//   "." -> 0
//   "a." -> 1
//   "hi." -> 2
//   "Mix." -> 3
//   "a z." -> 3
// The default input is empty; cases.json pins finite input/output vectors.

use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> block rd(0) }

    machine rd(n: i32 in Wrapping) {
        let r: ByteRead = block Console::read_byte();
        transition r {
            ByteRead::Byte { value } -> block chk(n, value)
            _ -> fin(n)
        }
    }

    machine chk(n: i32 in Wrapping, value: i32)
    requires value >= 0 && value <= 0xFF {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        transition b == 0x2E {
            true -> fin(n)
            _ -> block wr(n, b)
        }
    }

    machine wr(n: i32 in Wrapping, b: i32 in Wrapping) {
        transition b >= 0x61 && b <= 0x7A {
            true -> block up(n + 1, b)
            _ -> block keep(n + 1, b)
        }
    }

    machine up(n: i32 in Wrapping, b: i32 in Wrapping) {
        let upped: i32 in Wrapping = b - 0x20;
        let output: i32 = upped as i32;
        Console::write_byte(output);
        transition { _ -> block rd(n) }
    }

    machine keep(n: i32 in Wrapping, b: i32 in Wrapping) {
        let output: i32 = b as i32;
        Console::write_byte(output);
        transition { _ -> block rd(n) }
    }

    machine fin(n: i32 in Wrapping) {
        Console::exit_process(n as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
