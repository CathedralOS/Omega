// Alarm scheduler: 5-arm case dispatch stress test.
//
// Exercises: case members with 5 named variants (2 payload-bearing, 3 no-payload),
// multi-arm middle-arm dispatch (arms 0-4), accumulating scalar self-writes across
// repeated sub-machine calls, and payload binding in multiple arm positions.
//
// Event variants:
//   Set(hour, minute)  -- set alarm to given hour/minute      [PAYLOAD]
//   Snooze(minutes)    -- delay current alarm by N minutes     [PAYLOAD]
//   Cancel             -- cancel the alarm (sets active=0)     [NO PAYLOAD]
//   Trigger            -- fire the alarm (increments count)    [NO PAYLOAD]
//   Dismiss            -- dismiss a fired alarm                [NO PAYLOAD]
//
// Scripted sequence:
//   Set(6, 30)     -> hour=6, minute=30, active=1
//   Snooze(5)      -> minute=35, active=1
//   Snooze(5)      -> minute=40, active=1
//   Trigger        -> fire_count=1, active=1
//   Dismiss        -> active=0
//   Set(7, 0)      -> hour=7, minute=0, active=1
//   Trigger        -> fire_count=2, active=1
//   Cancel         -> active=0
//
// Final: hour=7, minute=0, active=0, fire_count=2.
// Check: fire_count*35 = 70. Exit 70.
//
// ====================================================================
// MISCOMPILE FOUND — native codegen bug:
//
// Expected exit: 70   (fire_count=2, 2*35=70)
// Actual exit:   71   (bad_score, fire_count*35 != 70)
//
// Minimal trigger confirmed via alarm_probe sample:
//   A no-payload case variant that appears AFTER a payload-bearing variant
//   in a case data type is unreachable in native dispatch.
//   Specifically: Cancel (arm 2), Trigger (arm 3), and Dismiss (arm 4) are
//   all unreachable when Set (arm 0, payload) and Snooze (arm 1, payload)
//   appear first.
//
//   alarm_probe2 (no-payload Trigger at position 0, ZII) works correctly.
//   alarm_probe  (no-payload Trigger at position 3, after two payload arms) fails.
//   alarm_probe3 (no-payload Cancel at position 2, after two payload arms) fails.
//
// Root cause hypothesis: the native case-dispatch equality comparison for no-payload
// variants uses the wrong tag value (or wrong width) when the variant comes after
// payload-bearing variants in the case definition order. The interpreter handles
// this correctly; it is a native-codegen-only bug.
// ====================================================================

use omega::language::std::console;

data AlarmEvent {
    case Set(hour: i32, minute: i32);
    case Snooze(minutes: i32);
    case Cancel;
    case Trigger;
    case Dismiss;
}

data Alarm [copy, zero_init] {
    hour: i32;
    minute: i32;
    active: i32;
    fire_count: i32;
}

data Main {
    console: Console;
    alarm: Alarm;
}

machine Main::dispatch(&mut self, event: AlarmEvent) {
    transition event {
        AlarmEvent::Set { hour, minute } -> do_set(hour, minute)
        AlarmEvent::Snooze { minutes } -> do_snooze(minutes)
        AlarmEvent::Cancel -> do_cancel()
        AlarmEvent::Trigger -> do_trigger()
        AlarmEvent::Dismiss -> do_dismiss()
        _ -> done()
    }

    state do_set(&mut self, hour: i32, minute: i32) {
        self.alarm.hour = hour;
        self.alarm.minute = minute;
        self.alarm.active = 1;
    }

    state do_snooze(&mut self, minutes: i32) {
        self.alarm.minute = self.alarm.minute + minutes;
    }

    state do_cancel(&mut self) {
        self.alarm.active = 0;
    }

    state do_trigger(&mut self) {
        self.alarm.fire_count = self.alarm.fire_count + 1;
    }

    state do_dismiss(&mut self) {
        self.alarm.active = 0;
    }

    state done(&mut self) {}
}

machine Main::main(&mut self) {
    self.dispatch(AlarmEvent::Set { hour: 6, minute: 30 });
    self.dispatch(AlarmEvent::Snooze { minutes: 5 });
    self.dispatch(AlarmEvent::Snooze { minutes: 5 });
    self.dispatch(AlarmEvent::Trigger);
    self.dispatch(AlarmEvent::Dismiss);
    self.dispatch(AlarmEvent::Set { hour: 7, minute: 0 });
    self.dispatch(AlarmEvent::Trigger);
    self.dispatch(AlarmEvent::Cancel);

    // fire_count == 2, active == 0, hour == 7, minute == 0
    // Verification: fire_count * 35 == 70
    let score: i32 = self.alarm.fire_count * 35;

    transition score == 70 {
        true -> check_active()
        _ -> bad_score()
    }

    state check_active(&mut self) {
        transition self.alarm.active == 0 {
            true -> check_hour()
            _ -> bad_active()
        }
    }

    state check_hour(&mut self) {
        transition self.alarm.hour == 7 {
            true -> check_minute()
            _ -> bad_hour()
        }
    }

    state check_minute(&mut self) {
        transition self.alarm.minute == 0 {
            true -> good()
            _ -> bad_minute()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad_score(&mut self) {
        // Exits 71 due to miscompile: fire_count is wrong because Trigger
        // and other no-payload variants after payload variants are unreachable.
        self.console.exit_process(71);
    }

    state bad_active(&mut self) {
        self.console.exit_process(72);
    }

    state bad_hour(&mut self) {
        self.console.exit_process(73);
    }

    state bad_minute(&mut self) {
        self.console.exit_process(74);
    }
}
