// A turn-based combat simulator -- a small but complete app that stresses how the
// pieces compose: two `Fighter` records (hp + attack), damage ARITHMETIC
// (`hp = hp - attacker.attack` in a Trapping domain), and a genuine state-machine
// LOOP where `hero_attacks` and `monster_attacks` transition back and forth until
// one combatant's hp drops to 0 or below. The hero (30 hp, 7 atk) out-damages the
// monster (25 hp, 5 atk) and wins. Exits 1 if the hero wins, 2 if the monster wins.
// Expected exit: 1.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Fighter {
    hp: i32 in Trapping;
    attack: i32 in Trapping;
}

data Main {
    console: Console;
    hero: Fighter;
    monster: Fighter;
}

machine Main::main(&mut self) {
    self.hero.hp = 30;
    self.hero.attack = 7;
    self.monster.hp = 25;
    self.monster.attack = 5;

    transition { _ -> hero_attacks() }

    state hero_attacks(&mut self) {
        self.monster.hp = self.monster.hp - self.hero.attack;
        transition self.monster.hp <= 0 {
            true -> hero_wins()
            _ -> monster_attacks()
        }
    }

    state monster_attacks(&mut self) {
        self.hero.hp = self.hero.hp - self.monster.attack;
        transition self.hero.hp <= 0 {
            true -> monster_wins()
            _ -> hero_attacks()
        }
    }

    state hero_wins(&mut self) { self.console.exit_process(1); }
    state monster_wins(&mut self) { self.console.exit_process(2); }
}
