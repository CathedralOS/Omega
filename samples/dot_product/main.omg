// Dot product of two vectors: sum over i of a[i] * b[i]. This reads cleanly now
// that a runtime-indexed read works as a sub-expression operand -- two indexed
// reads inside a multiplication inside the running sum, written directly:
//
//   sum = sum + a[i] * b[i]
//
// Previously each `a[i]` had to be materialized into its own field first. The
// compiler hoists them into temps automatically.
//
// [1,2,3] . [4,5,6] = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32.
// Expected exit: 32.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    a: [i32; 3] in Trapping;
    b: [i32; 3] in Trapping;
    i: i32 in Trapping;
    sum: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.a[0] = 1;
    self.a[1] = 2;
    self.a[2] = 3;
    self.b[0] = 4;
    self.b[1] = 5;
    self.b[2] = 6;
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 3 {
            true -> accumulate()
            _ -> done()
        }
    }

    state accumulate(&mut self) {
        self.sum = self.sum + self.a[self.i] * self.b[self.i];
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.exit_process(self.sum);
    }
}
