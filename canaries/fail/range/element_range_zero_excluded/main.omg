// A zero-excluding ELEMENT range gates the containing array and therefore the
// machine data. Consuming Main before establishing its cells is rejected.
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    cells: [i32 [1..=7]; 4];
}

machine Main::main(&mut self) {
    self.console.exit_process(1);
}
