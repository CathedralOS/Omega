// The guarded element increment's soundness twin: a `< 17` guard admits 16,
// and 16 + 1 = 17 exceeds the element range [0..=16] -- must reject.
use omega::language::std::console;
data Main {
    console: Console;
    tallies: [i32 [0..=16]; 4];
}
machine Main::main(&mut self) {
    transition self.tallies[1] < 17 {
        true -> bump()
        false -> full()
    }
    state bump(&mut self) {
        self.tallies[1] = self.tallies[1] + 1;
        transition self.tallies[1] == 1 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(1); }
    state unmatched(&mut self) { self.console.exit_process(9); }
    state full(&mut self) { self.console.exit_process(8); }
}
