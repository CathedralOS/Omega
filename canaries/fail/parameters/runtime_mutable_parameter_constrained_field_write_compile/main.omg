data Player {
    level: u32;
    xp: u32;
    max_health: i32;
    health: i32;
    attack: i32;
    defense: i32;
}

data Main {
    player: Player;
}

machine Main::main(&mut self) {
    self.create(&mut self.player);
}

machine Main::create(&mut self, player: &mut Player) {
    player.level = 1;
    player.xp = 0;
    player.max_health = 30;
    player.health = player.max_health;
    player.attack = 4;
    player.defense = 1;
}
