// The empty-dispatch overload selected without an expected result retains its
// Exact proof obligation even when the value is explicitly discarded.
use omega::language::core::float_operations;

data Main { value: f64; }

machine Main::main(&mut self) {
    self.value = 100000000000000000000.0;
    _ = I32::from_f64(self.value);
    let marker: i32 = 0;
}
