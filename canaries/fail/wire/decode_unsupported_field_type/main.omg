// Wire stage 2b: the compact_binary v0 decoder covers primitive integer
// scalars only (i32/i64/u32/u64/bool). Decoding an OWNED `String` is gated on
// a missing PREREQUISITE, not a missing wire feature: it must copy the bytes
// out of the buffer into owned storage, and Omega has no runtime allocator yet.
// The decode call rejects with a diagnostic that names that dependency (and the
// allocator-free zero-copy `&'buf string` alternative) instead of mis-decoding.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data LabelMessage {
    0: count: u32;
    1: label: String;
}

data LabelSample {
    count: u32;
    label: String;
}

data Main {
    console: Console;
    buffer: [u8; 64];
    read: usize;
    ok: bool;
}

machine Main::main(&mut self) {
    let value: LabelSample = LabelSample { count: 0, label: "x" };

    LabelMessage::decode(&mut value, &self.buffer, &mut self.read, &mut self.ok);

    self.console.exit_process(70);
}
