// Wire stage 2a: the compact_binary v0 encoder covers primitive integer
// scalars (i32/i64/u32/u64/bool) plus String. A schema field outside that
// set -- here an f64 -- rejects the encode call with a clear diagnostic
// instead of silently mis-encoding.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data SampleMessage {
    0: count: u32;
    1: ratio: f64;
}

data SampleValue {
    count: u32;
    ratio: f64;
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: usize;
}

machine Main::main(&mut self) {
    let msg: SampleValue = SampleValue { count: 1, ratio: 0.5 };

    SampleMessage::encode_wire(&msg, &mut self.buffer, &mut self.written);

    self.console.exit_process(70);
}
