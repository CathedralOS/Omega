// Wire nested message fields: a schema that reaches ITSELF through nested
// message fields (here through a sibling) can never have a finite worst-case
// encoding, so the cycle is rejected at the declaration -- loudly, not at
// some later encode call site.

use omega::language::std::console;

data PacketHeader {
    #0 parent: Packet;
}

data Packet {
    #0 header: PacketHeader;
    #1 depth: i32;
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
