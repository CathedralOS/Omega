// Chapter 20 (Wire Protocols): "Changing a field type requires an explicit
// compatibility rule." No compatibility rules exist yet, so a field number
// that keeps its number but changes type between a version era and the
// current schema is rejected.

wire data CounterMessage {
    version v1 {
        0: counter: i32;
    }

    0: counter: i64;
    1: timestamp_millis: i64;
}

data Main {
}

machine Main::main(&mut self) {
}
