// Wire REPEATED fields: only stage 2 scalar elements (i32/i64/u32/u64/bool)
// have an honest packed encoding today. A repeated NESTED MESSAGE would need
// per-element length framing and per-element staging, so `[Schema; N]`
// rejects the encode call loudly instead of half-supporting it.

use omega::language::std::console;

data Point {
    #0 x: i32;
    #1 y: i32;
}

data Polygon {
    #0 points: [Point; 3];
}

data PointValue {
    x: i32;
    y: i32;
}

data PolygonValue {
    points: [PointValue; 3];
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(&mut self) {
    let msg: PolygonValue = PolygonValue {
        points: [
            PointValue { x: 0, y: 0 },
            PointValue { x: 1, y: 0 },
            PointValue { x: 0, y: 1 }
        ]
    };

    Polygon::encode(&msg, &mut self.buffer, &mut self.written);

    self.console.exit_process(70);
}
