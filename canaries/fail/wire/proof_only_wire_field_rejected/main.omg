// N1 wire face: wire schemas serialize runtime bytes; a proof-only
// mention has no encoding.
boundary trait Console { machine exit_process(return_code: i32); }
data Nat { case Zero; case Succ(prev: Nat); }
data Msg {
    0: n: Nat;
}
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(0); }
