// LAYOUTS L5, the agreement check: the out buffer is refined to ANOTHER
// schema's layout domain. Writing CounterMessage bytes into a carrier
// declared `in OmegaLayout<OtherMessage>` is the exact confusion the
// refinement exists to reject.
boundary trait Console {
    machine exit_process(return_code: i32);
}

data CounterMessage {
    0: counter: u32;
}
data OtherMessage {
    0: other: u32;
}
data CounterSample {
    counter: u32;
}

data Main {
    console: Console;
    buffer: [u8; 64] in OmegaLayout<OtherMessage>;
    written: usize;
}

machine Main::main(&mut self) {
    let msg: CounterSample = CounterSample { counter: 5 };
    CounterMessage::encode_wire(&msg, &mut self.buffer, &mut self.written);
    self.console.exit_process(0);
}
