// Chapter 20 (Wire Protocols): wire versions name distinct protocol eras, so
// declaring the same version twice in one schema is rejected.

data CounterMessage {
    version v1 {
        #0 counter: i32;
    }

    version v1 {
        #0 counter: i64;
    }

    retired #0;
    #1 counter: i64;
}

data Main {
}

machine Main::main(&mut self) {
}
