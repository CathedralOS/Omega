// General borrowed scalar slices are part of the settled carrier model, but
// the current generated compact_binary encode requirement cannot yet retain
// their runtime length, work, and output-capacity obligations. It rejects
// clearly instead of pretending the slice has a static maximum.

use omega::language::std::console;

data Telemetry {
    #0 readings: [u32];
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
