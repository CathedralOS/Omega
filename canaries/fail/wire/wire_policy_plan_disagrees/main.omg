// FAIL canary (mint arc rung 2b): the authored plan is LOAD-BEARING -- a
// `CompactBinary::plan` that frames every field LengthPrefixed (the schema's
// scalars must be Varint) is a COMPILE ERROR naming both sides, never a
// silent re-framing of the bytes.
data Message {
    #0 counter: u32;
    #1 flag: bool;
}

data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField { size: u64 [0..=4096]; align: u64 [1..=16]; number: i64; kind: FieldKind; }
data Schema { fields: [SchemaField; 32]; field_count: u64 [0..=32]; }
data FieldPlan {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data Plan { fields: [FieldPlan; 32]; entry_count: u64; size_fixed: u64; size_is_dynamic: bool; align: u64; }

data CompactBinary {
    plans: [FieldPlan; 32];
    index: u64 in Wrapping;
    tag: u64;
}
machine CompactBinary::plan(&mut self, schema: Schema) -> Plan {
    self.evaluate(schema, 96)
}

machine CompactBinary::evaluate(&mut self, schema: Schema, fuel: u64 [1..=96]) -> Plan
terminates by fuel;
{
    self.index = 0;
    transition { _ -> fill(schema, fuel) }

    state fill(&mut self, schema: Schema, fuel: u64 [1..=96]) {
        transition fuel > 1 && self.index < 32 && self.index < schema.field_count {
            true -> put_wrong(schema, fuel - 1)
            _ -> done(schema)
        }
    }
    state put_wrong(&mut self, schema: Schema, fuel: u64 [1..=96]) {
        self.tag = schema.fields[self.index].number as u64 in Wrapping;
        // WRONG on purpose: scalars must be Varint.
        self.plans[self.index] = FieldPlan::LengthPrefixed { tag: self.tag };
        self.index = self.index + 1;
        transition fuel > 1 { true -> fill(schema, fuel - 1) _ -> done(schema) }
    }
    state done(&mut self, schema: Schema) -> Plan {
        Plan {
            fields: self.plans,
            entry_count: schema.field_count,
            size_fixed: 0,
            size_is_dynamic: true,
            align: 1,
        }
    }
}

data Main { }
machine Main::main(&mut self) { }
