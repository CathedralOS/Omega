// Wire stage 2a: a borrowed text field's byte count is runtime-sized, so the
// compact_binary v0 encoder requires it to carry the schema's HIGHEST field
// number (it must encode last). Every append before the trailing byte-copy
// stays covered by the compile-time worst-case out-buffer budget; a field
// AFTER the text would write with that guarantee already spent. Here text
// holds field 0 and a u32 follows at field 1 -- rejected.

use omega::language::std::console;

domain [u8]::Utf8
requires
    valid_utf8(self);

data LabelMessage {
    #0 label: &[u8] in Utf8;
    #1 count: u32;
}

data LabelSample {
    label: &[u8] in Utf8;
    count: u32;
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(&mut self) {
    let msg: LabelSample = LabelSample { label: "x", count: 1 };

    LabelMessage::encode(&msg, &mut self.buffer, &mut self.written);

    self.console.exit_process(70);
}
