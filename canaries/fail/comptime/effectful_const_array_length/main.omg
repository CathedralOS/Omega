// COMPTIME STAGE 1 -- CONTRACT GATE: a machine evaluated in a constant
// position must have empty normalized service reach and may neither suspend
// nor block. `loud_size` publishes `Console` reach, so
// `[i64; loud_size()]` must reject naming the machine and service -- never
// silently evaluate or fall back.
use omega::language::std::console;

data Main {
    console: Console;
    slots: [i64; loud_size()];
}

machine loud_size() -> u64
reaches
    Console
{
    transition {
        _ -> (12 + 4)
    }
}

machine Main::main(&mut self) {
    self.console.exit_process(0);
}
