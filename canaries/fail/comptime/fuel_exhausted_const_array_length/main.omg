// COMPTIME STAGE 1, FUEL BACKSTOP: a const-position callee that is legal by
// the termination discipline (tail self-loop with a ranking witness) but
// takes ten million steps must hit the step-budget defense-in-depth limit
// and produce an ERROR -- the compiler must never hang inside const
// evaluation. (M3: termination is the language's existing discipline; fuel
// exists only as a backstop, and this pins that the backstop actually
// fires -- observed at ~0.07s, no hang.)
//
// NOTE the `(burn(...) + 0)` spelling: kept as the arithmetic-wrapped form
// so this canary stays pointed at the fuel limit alone. The parenthesized
// BARE-call arm spelling is covered separately by
// pass/comptime/runtime_const_array_length_bare_call_arm_exit.

use omega::language::std::console;

data Main {
    console: Console;
    slots: [i64; table_size()];
}

machine burn(remaining: u64, acc: u64)
terminates by remaining;
-> u64
{
    transition remaining > 0 {
        true -> burn(remaining - 1, acc + 1)
        false -> acc
    }
}

machine table_size() -> u64 {
    transition {
        _ -> (burn(10000000, 16) + 0)
    }
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
