// Chapter 22 (Inline Assembly): an assembly block with an arbitrary label and a
// `jmp label` back-edge is suspect because it creates a control-flow loop that
// does not correspond to Omega states and transitions. The only currently
// accepted control-flow asm form is `asm { jmp state(...) }`; free labels are
// rejected instead of being smuggled into the Omega control-flow graph.

data Main {
    value: i32;
}

machine Main::main(&mut self) {
    asm {
    label:
        jmp label
    }
}
