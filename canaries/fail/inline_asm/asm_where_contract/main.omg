// Contract-heavy assembly carries explicit proof conditions through
// `asm where requires ... ensures ... { ... }`. Exact clobber contracts are
// parsed already; proof facts remain fenced until they have a lossless typed
// carrier and cannot be mistaken for trusted instruction guarantees.

data Main {
    value: i32;
}

machine Main::main(&mut self) {
    asm where
        requires self.value
        ensures self.value
    {
        nop
    }
}
