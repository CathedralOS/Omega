data main {
    value: i32;
}

machine main -> i32 {
    pub entry(&mut self) {
        transition {
            _ -> overwrite(self.value)
        }
    }

    state overwrite(&mut self, input_value: i32) {
        input_value = 2;

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        0
    }
}
