// FAIL canary: a u64 literal above i64::MAX is rejected with a CLEAR diagnostic that names
// the real limitation, not the misleading "invalid integer literal". Since D14 (anonymous
// literals, TASKS_TIME.md) the literal PARSES -- it is an uninterpreted payload with no
// magnitude ceiling -- and the rejection moved from the parser to the validation gate
// (omega-validation/src/literals.rs): no position ACCEPTS a u64-magnitude value yet,
// because every consumer reads literals through the i64 value window. (Rescope this canary
// when the typed u64 lowering lands -- the next D14 rung -- to pin whatever positions still
// must reject. u64 ARITHMETIC already works; only literal ACCEPTANCE is the gap.)
boundary trait Console { machine exit_process(return_code: i32); }

data Main {
    console: Console;
    mask: u64 in Wrapping;
}

machine Main::main(&mut self) {
    self.mask = 18446744073709551615; // u64::MAX -- above i64::MAX, rejected
    self.console.exit_process(0);
}
