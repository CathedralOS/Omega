// FAIL canary (#40 boundary guard): a CAST in a guard subject (`transition self.x as u8 == c`)
// is not yet lowerable, and the dispatch-guard blocker rejects it CLEANLY rather than silently
// miscompiling. The sound workaround is to cast into a field/local first, then guard the
// place: `self.small = self.big as u8 in Wrapping; transition self.small == 44` (verified to
// discriminate correctly).
//
// This pins the #40 boundary. It matters: a SIBLING guard-subject shape -- a scalar/bool
// value-call directly in a guard -- DOES slip past this same blocker and silently always takes
// the true arm (see memory value-call-in-guard-always-true). So if cast-in-guard ever COMPILES
// instead of erroring (the same silent-miscompile failure mode), this test -- which expects
// rejection -- fails and surfaces it. Remove/repurpose when casts in guard subjects are
// supported.
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    big: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.big = 300;
    transition self.big as u8 in Wrapping == 44 { true -> g() _ -> b() }
    state g(&mut self) { self.console.exit_process(70); }
    state b(&mut self) { self.console.exit_process(71); }
}
