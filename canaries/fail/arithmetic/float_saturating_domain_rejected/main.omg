// FAIL canary (float semantics F1, 2026-07-18): a `Saturating` (or `Trapping`)
// policy on a float is a RECOGNIZED real policy but does not lower yet (float
// `Trapping`/`Saturating` = the F5 rung), so it refuses LOUDLY here rather than
// silently no-opping. Saturating on floats is overflow-only by design (clamp to
// ±MAX_FINITE); until F5 emits that, the honest answer is to reject. The
// sibling float_wrapping_domain_rejected pins the hard-error leg (Wrapping has
// no float meaning at all).
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
    tex: f64 in Saturating;
}
machine Main::main(&mut self) {
    self.console.exit_process(0);
}
