data Main {
}

machine Main::main(
    &mut self,
    level: u32,
    xp: u32
) {
    transition xp >= cost(level) {
        true -> spend(level, xp)
        false -> {}
    }

    state spend(
        &mut self,
        level: u32,
        xp: u32
    ) -> u32 {
        xp - cost(level)
    }
}

machine Main::cost(
    &mut self,
    level: u32
) -> u32 {
    10 + level * 5
}
