// FAIL canary: array-literal element narrowing at the LET-INITIALIZER position.
// `let a: [i8; 3] = [300, 0, 0]` -- element 300 does not fit i8. This locks the
// let-init wiring of the shared array-element check (a distinct call site from the
// assignment one in array_literal_element_narrowing_rejected); the same helper
// also guards struct-field and call-argument array literals.

use omega::language::std::console;

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let a: [i8 in Wrapping; 3] = [300, 0, 0]; // element 300 does not fit i8
    let code: i32 = a[0] as i32;
    self.console.exit_process(code);
}
