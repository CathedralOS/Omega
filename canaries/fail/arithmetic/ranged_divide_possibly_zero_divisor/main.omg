// A POSSIBLY-ZERO divisor must keep the divide unfolded: `d: [0..=26]`
// includes 0, so `c / d` has no provable range and the ranged store rejects
// (the fold requires a divisor interval that provably excludes zero).
use omega::language::std::console;

data Main {
    console: Console;
    c: i32 [0..=259];
    d: i32 [0..=26];
    y: i32 [0..=259];
}

machine Main::main(&mut self) {
    self.y = self.c / self.d;
    self.console.exit_process(1);
}
