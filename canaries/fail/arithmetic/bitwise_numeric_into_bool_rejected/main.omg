// Bitwise `& | ^` over NUMERIC operands yields an integer that can leave {0,1}:
// `2 & 3` is 2. Storing that into a `bool` used to compile and silently produce a
// bool holding 2 (native exit 2). Rejected now as a cross-class store. (Bitwise
// over BOOL operands stays allowed -- `b & b` keeps {0,1}.)
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { let x: bool = 2 & 3; let r: i32 = x as i32; self.console.exit_process(r); }
