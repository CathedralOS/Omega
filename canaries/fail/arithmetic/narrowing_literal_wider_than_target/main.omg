// FAIL canary: an integer literal that cannot fit its destination type is a
// SILENT NARROWING (truncation) -- rejected under decision 17 (a narrowing
// store is a proof obligation, like exact arithmetic). `3000000123` exceeds
// i32::MAX, so storing it into an i32 field would truncate to a different value.
// The fix is an explicit `as i32` cast (accepting the truncation) or a wider type.
use omega::language::std::console;
data Main { console: Console; r: i32; }
machine Main::main(&mut self) {
    self.r = 3000000123;
    self.console.exit_process(self.r);
}
