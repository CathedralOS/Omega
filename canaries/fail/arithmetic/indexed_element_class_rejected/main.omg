// A cross-class value stored into a runtime-INDEXED array element used to compile
// silently: `self.xs[i] = true` wrote the bool as `1` into an `[i32; N]` slot with
// NO error at any phase (verified: exit 1 -- the element read back as 1). The
// element-write position was exempt because `declared_place_type` stops at an
// `Indexed` node and returned None, skipping the cross-class store check. Now the
// indexed element's `[T; N]`/`[T]` element type is resolved and checked -- the
// runtime-indexed complement of the `self.i32 = true` field store and the
// `self.a = [true, ..]` array-literal element checks.

use omega::language::std::console;

data Main { console: Console; xs: [i32; 4]; i: i32 [0..=3]; }

machine Main::main(&mut self) {
    self.i = 2;
    self.xs[self.i] = true; // bool into an i32 element -- must be rejected
    self.console.exit_process(0);
}
