// FAIL canary: a DISJUNCTION (`||`) nested INSIDE a conjunction (`&&`) in a guard
// subject -- `a && (b || c)`, i.e. And-of-Or -- is not yet lowerable. The guard
// model lowers a conjunction of comparison clauses, optionally within a top-level
// disjunction (DNF: `(a && b) || c` WORKS), but does not distribute an And over a
// nested Or. The dispatch-guard blocker rejects it CLEANLY (naming the nested-`||`
// case) rather than miscompiling. Workaround: bind the disjunction to a bool field
// first (`self.d = self.b > 0 || self.c > 0; transition self.a > 0 && self.d`), or
// rewrite to DNF by hand (`(a && b) || (a && c)`). Remove/repurpose when And-of-Or
// guard lowering (DNF normalization) lands -- Or-of-And already lowers.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    c: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.a = 5;
    self.b = 3;
    self.c = 1;
    transition self.a > 0 && (self.b > 0 || self.c > 0) { true -> g() _ -> b() }
    state g(&mut self) { self.console.exit_process(70); }
    state b(&mut self) { self.console.exit_process(71); }
}
