// FAIL canary: arithmetic on an UNCONSTRAINED case-payload binding carries the
// decision-17 exact-arith obligation (the payload-binding hole is closed). With
// no range refinement on `index`, `index + 1` is not provably in range.
use omega::language::std::console;
data Slot { case Found(index: i32); case Full; }
data Main { console: Console; }
machine Main::run(&mut self, s: Slot) {
    transition s { Slot::Found { index } -> use_it(index + 1) Slot::Full -> done() }
    state use_it(&mut self, n: i32) { self.console.exit_process(n); }
    state done(&mut self) { self.console.exit_process(0); }
}
machine Main::main(&mut self) { self.run(Slot::Found { index: 5 }); }
