// Settled ambiguity rule: the same fixed token with overlapping
// receiver/operand types is a compile error. Both operators spell `+` over the
// same `(i32, i32)` operand types, so they are ambiguous.

operator + i32::add(left: i32, right: i32) -> i32;

operator + i32::plus(left: i32, right: i32) -> i32;

data Main {
}

machine Main::main(&mut self) {
