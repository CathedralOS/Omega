// FAIL CANARY: a numeric float range may compose with another interval on the
// same float carrier, but it is not an integer bit-pattern set. In particular,
// it cannot justify a writable alias through an equal-width integer carrier.
data Main {
    value: f32 [0..=1];
}

machine Main::main(&mut self) {
    let bits: &mut u32 = &mut self.value as &mut u32;
}
