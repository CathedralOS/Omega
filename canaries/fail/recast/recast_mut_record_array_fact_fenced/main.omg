// FAIL CANARY: fact-free array tiling is structural. A constrained element
// inside a mutable record view still owes implication in both directions.
domain u16::Small
requires
    self <= 10;

data FactedArray {
    values: [u16 in Small; 2];
}

data Main {
    bytes: [u8; 4];
}

machine Main::main(&mut self) {
    let view: &mut FactedArray = &mut self.bytes[0] as &mut FactedArray;
    view.values[0] = 1;
}
