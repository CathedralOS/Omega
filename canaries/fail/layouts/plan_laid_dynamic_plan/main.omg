// PLAN-LAID VALUE TYPES, the value-type gate: a policy whose plan is DYNAMIC
// cannot appear in type position -- values need offsets, bytes need mints
// (programmable_layouts.md section 5). The rejection must name the policy.
boundary trait Console {
    machine exit_process(return_code: i32);
}

data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField {
    size: i64 [0..=4096];
    align: i64 [1..=16];
    number: i64;
    kind: FieldKind;
}
data Schema {
    fields: [SchemaField; 32];
    field_count: i64 [0..=32];
}
data FieldPlan {
    case At(offset: i64);
    case Bits(container: i64, container_width: i64, lsb: i64, width: i64);
    case Varint(tag: i64);
    case LengthPrefixed(tag: i64);
}
data Plan {
    fields: [FieldPlan; 32];
    entry_count: i64;
    size_fixed: i64;
    size_is_dynamic: bool;
    align: i64;
}

data Streamy {
    plans: [FieldPlan; 32];
}
machine Streamy::plan(&mut self, schema: Schema) -> Plan {
    // Distinct offsets so placement VALIDATION passes; the plan is rejected
    // in type position purely for being dynamic.
    self.plans[1] = FieldPlan::At { offset: 4 };
    transition { _ -> done(schema) }

    state done(&mut self, schema: Schema) -> Plan {
        Plan {
            fields: self.plans,
            entry_count: schema.field_count as i64,
            size_fixed: 0,
            size_is_dynamic: true,
            align: 1,
        }
    }
}

data Pairish {
    a: i32;
    b: i32;
}

data Main {
    console: Console;
    payload: Streamy<Pairish>;
}

machine Main::main(&mut self) {
    self.console.exit_process(0);
}
