// FAIL CANARY. A cited private callback slot must be declared for the exact
// layout policy whose plan is currently being evaluated.
use omega::language::core::layout;

boundary trait Callback {
    machine call(value: u64) -> u64;
}

data OtherLayout {
}

WrongLayoutSlot:
    OtherLayout satisfies PrivateCallbackSlot<Callback::call>;

data Spread {
    entries: [FieldEntry; 64];
}

machine Spread::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let plan: Plan = Plan {
        entries: self.entries,
        entry_count: 1,
        size_fixed: 16,
        size_is_dynamic: false,
        align: 8,
    };
    Plan::place_private<WrongLayoutSlot>(plan, 8)
}

data ForeignRecord { payload: u64; }
data Main { value: Spread<ForeignRecord>; }
machine Main::main(&mut self) { }
