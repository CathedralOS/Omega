// MUST be rejected. The loop guard `j < 4` bounds `j` at the body's ENTRY, but
// the body reads `nums[j]` AGAIN after `j = j + 1` -- when `j` entered at 3 that
// second read is `nums[4]`, out of bounds. A reassignment loosens (here, breaks)
// the counter's bound, so the index upper bound from the guard is stale after the
// increment and must not carry to the post-mutation read. Regression guard for
// the forget-index-bound-on-reassignment fix.

use omega::language::std::console;

data Main {
    console: Console;
    nums: [i32; 4] in Trapping;
    j: i32 in Trapping;
    a: i32;
    b: i32;
}

machine Main::main(&mut self) {
    self.nums[0] = 1;
    self.nums[1] = 2;
    self.nums[2] = 3;
    self.nums[3] = 4;
    self.j = 0;

    transition {
        _ -> loop_()
    }

    state loop_(&mut self) {
        transition self.j < 4 {
            true -> body()
            _ -> done()
        }
    }

    state body(&mut self) {
        self.a = self.nums[self.j];
        self.j = self.j + 1;
        self.b = self.nums[self.j];
        transition {
            _ -> loop_()
        }
    }

    state done(&mut self) {
        self.console.exit_process(0);
    }
}
