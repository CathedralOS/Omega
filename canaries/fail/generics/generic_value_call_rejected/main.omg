// A VALUE-position call to a generic machine is rejected cleanly: the monomorphized result slot
// is never materialized natively (it silently yielded 0 while the interpreter returned the real
// value -- a silent miscompile until this fence).
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::id<T>(&self, x: T) -> T { transition { _ -> x } }
machine Main::main(&mut self) {
    let v: i32 in Wrapping = self.id(70);
    self.console.exit_process(v);
}
