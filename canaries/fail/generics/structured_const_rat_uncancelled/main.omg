use omega::language::core::rat;

data RatIndices {}

const RatIndices::INVALID: Rat = Rat {
    num: IntPair {
        neg: Nat::Succ { prev: Nat::Zero },
        pos: Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } }
    },
    den: Nat::Succ { prev: Nat::Zero }
};

data RatIndexed<const R: Rat> {
    marker: u8;
}

data Main {
    invalid: RatIndexed<RatIndices::INVALID>;
}

machine Main::main(&mut self) {
}
