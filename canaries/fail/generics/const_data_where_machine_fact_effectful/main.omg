// Build-time domain facts use the normalized build-time contract gate. A
// service-reaching machine may not decide const-generic membership.
boundary trait Console { machine exit_process(return_code: i32); }

machine is_buffer_size(value: u64) -> bool
reaches
    Console
{
    value > 0 && value <= 8
}

domain u64::BufferSize
requires
    is_buffer_size(self);
data FixedBuffer<const N: u64>
where
    N in BufferSize,
{
    values: [u8; N];
}

data Main {
    buffer: FixedBuffer<4>;
}

machine Main::main(&mut self) {}
