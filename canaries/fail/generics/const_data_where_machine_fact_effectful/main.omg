// Build-time domain facts use the inferred transitive-effect gate. An
// effectful machine may not decide const-generic membership.
machine is_buffer_size(value: u64) -> bool
effects
    process_exit
{
    value > 0 && value <= 8
}

domain u64::BufferSize {
    is_buffer_size(self);
}
data FixedBuffer<const N: u64>
where
    N in BufferSize,
{
    values: [u8; N];
}

data Main {
    buffer: FixedBuffer<4>;
}

machine Main::main(&mut self) {}
