// Nested domain memberships compose with a true machine-backed fact.
// The nested domain rejects this concrete const value.
machine is_positive(value: u64) -> bool {
    value > 0
}

machine is_at_most_eight(value: u64) -> bool {
    value <= 8
}

domain u64::AtMostEight
requires
    is_at_most_eight(self);
domain u64::BufferSize
requires
    is_positive(self);
    self in AtMostEight

data FixedBuffer<const N: u64>
where
    N in BufferSize,
{
    values: [u8; N];
}

data Main {
    buffer: FixedBuffer<9>;
}

machine Main::main(&mut self) {}
