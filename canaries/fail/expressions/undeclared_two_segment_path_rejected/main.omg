// An unresolved TWO-segment path in value position (`Nowhere::NOPE`) must be
// a clean compile error, not a silent ZII read. It is the multi-segment sibling
// of the closed bare-name existence check (undeclared_bare_name_rejected): a
// legitimate qualified case (`Signal::Green`) or scoped const resolves to a
// valid symbol before validation, so a path whose head AND leaf symbols both
// stay unresolved names nothing and would read 0 (native and interpreter agree
// -- differential-invisible).
// `Signal::Blue` (a bogus case of a real enum) is the same shape and is
// caught too; the positive twin (a REAL qualified case in value position)
// is pinned by runtime_qualified_case_value_exit.
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) {
    let code: i32 = Nowhere::NOPE + 7;
    transition code == 70 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code2: i32) { self.console.exit_process(code2); }
}
