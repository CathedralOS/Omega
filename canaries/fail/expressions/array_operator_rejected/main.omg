// Ordering/arithmetic/bitwise operators on an ARRAY operand (`xs < ys`) used to
// compile silently (a garbage byte op). Arrays cannot carry domain operators, so
// these are always meaningless. Rejected now. Text-view operations have their
// own semantics and do not justify array arithmetic.
use omega::language::std::console;
data Main { console: Console; xs: [i32; 3]; ys: [i32; 3]; }
machine Main::main(&mut self) { let r: bool = self.xs < self.ys; self.console.exit_process(0); }
