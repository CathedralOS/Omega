// Bitwise ops between two integer places of DIFFERENT widths silently truncated
// the wider operand: `self.big | self.small` (u32 | u8) compiled at u8 width, so
// u32 256 became (256 & 0xFF) == 0 and `0 | 1` gave 1 not 257 -- a confirmed
// miscompile. The bitwise sibling of the mismatched-width comparison hole (shift
// is unaffected -- its right operand is a bit count). Rejected at check now.
use omega::language::std::console;
data Main { console: Console; small: u8; big: u32; result: u32; }
machine Main::main(&mut self) {
    self.small = 1;
    self.big = 256;
    let combined: u32 = self.big | self.small;
    self.console.exit_process(0);
}
