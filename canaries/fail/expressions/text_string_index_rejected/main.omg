// Indexing a `String` value (`s[0]`) silently read a ZII 0 -- the text carrier is
// a `{len, bytes}` structure, not a flat array, and byte indexing on it is not
// implemented, so the backend produced 0 with no diagnostic. Rejected at check now.
// Byte access via a `[u8; N] in Utf8` array (which resolves to a non-primitive type)
// is the supported path and stays valid. (`s.len` MEMBER access stays valid too.)
use omega::language::std::console;
data Main { console: Console; s: String; }
machine Main::main(&mut self) {
    self.s = "ABC";
    let first: u8 = self.s[0];
    let code: i32 = first as i32;
    self.console.exit_process(code);
}
