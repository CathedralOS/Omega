// FAIL CANARY: a case-literal payload field whose VALUE has no operand
// lowering (text equality here -- the branch resolver has no TextEquals arm)
// must be REJECTED loudly, not dropped. Before the UnloweredCaseLiteralField
// poison, the construction cascade OR'd per-field success: the tag and the
// sibling `y` landed, `z` was silently skipped, and the program took the
// wrong arm at runtime (native 72 vs interp 70 -- the second instance of the
// hole after the cast-in-payload face, which is now served and pinned by
// pass/control_flow/sum_payload_cast_operand_field_exit). The bind-first
// spelling (`let ok: bool = self.name == "omega"; .. z: ok`) serves and is
// what the diagnostic prescribes. UPDATE: texteq now LOWERS in value/write
// position (TextEqualsLiteral literal-RHS arm) -- the FIELD-STORE sibling was
// promoted to pass/text/case_literal_texteq_field_store_exit. This TERMINAL
// position stays rejected: the naive place-write attempt MISCOMPILED (wrong
// offset/timing, native 73, reverted 2026-07-12) -- serving it needs the leaf
// expansion's write plumbing. If that lands, promote this too.
boundary trait Console { machine exit_process(return_code: i32); }
data Msg { case Ping(x: i32); case Pong(y: i32, z: bool); }
data Main { console: Console; name: String; }
machine Main::mk(&mut self) -> Msg {
    transition true { true -> Msg::Pong { y: 5, z: self.name == "omega" } }
}
machine Main::main(&mut self) {
    self.name = "omega";
    self.build();
}
machine Main::build(&mut self) {
    let m: Msg = self.mk();
    transition m {
        Msg::Pong { y, z } -> chk(y, z)
        _ -> bad()
    }
    state chk(&mut self, y: i32, z: bool) {
        transition z {
            true -> good()
            _ -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(73); }
}
