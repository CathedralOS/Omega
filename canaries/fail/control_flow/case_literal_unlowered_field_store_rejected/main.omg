// FAIL CANARY: the FIELD-STORE position of the case-literal unlowerable-field
// poison (`self.stored = Msg::Pong { y: 5, z: self.name == "omega" }`). The
// mod.rs struct-literal decomposition ORs per-member success, so the tag and
// `y` landed while `z` silently stayed ZII (native 72 / interp 70) -- the
// same hole as the branch-side construction cascade, on a separate path. The
// poison fires on PARTIAL constructions only (a fully-unserved literal still
// falls through to whole-value strategies). Note: text equality has NO value/
// store-position lowering at all natively (the bound `let` spelling folds
// back and poisons too; `self.ok = self.name == "x"` hits the mutation
// blocker), so every spelling of this shape is loud -- restructure by
// guarding on the comparison (`transition self.name == "x" { ... }`) and
// storing per-arm constants. If text equality gains value-position lowering,
// this flips loudly: promote it rather than weakening the poison.
boundary trait Console { machine exit_process(return_code: i32); }
data Msg { case Ping(x: i32); case Pong(y: i32, z: bool); }
data Main { console: Console; name: String; stored: Msg; }
machine Main::main(&mut self) {
    self.name = "omega";
    self.build();
}
machine Main::build(&mut self) {
    self.stored = Msg::Pong { y: 5, z: self.name == "omega" };
    transition self.stored {
        Msg::Pong { y, z } -> chk(y, z)
        _ -> bad()
    }
    state chk(&mut self, y: i32, z: bool) {
        transition z {
            true -> good()
            _ -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(73); }
}
