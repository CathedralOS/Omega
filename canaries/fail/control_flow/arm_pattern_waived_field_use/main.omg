// `dx as _` waives the field: it is spelled (satisfying any future
// exhaustiveness law) but introduces NO binding -- a guard that then uses
// `dx` refuses at symbol resolution like any unknown name.
use omega::language::std::console;
data Msg {
    case Move(dx: i32 [0..=50], dy: i32 [0..=50]);
    case Stop(code: i32);
}
data Main { console: Console; }
machine Main::main(&mut self) {
    self.apply(Msg::Move { dx: 30, dy: 40 });
}
machine Main::apply(&mut self, m: Msg) {
    transition m {
        Msg::Move { dx as _, dy } if dx == 30 -> good(dy)
        _ -> bad()
    }
    state good(&mut self, step: i32 [0..=50]) { let code: i32 = step + 40; self.console.exit_process(code); }
    state bad(&mut self) { self.console.exit_process(1); }
}
