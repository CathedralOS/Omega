data Main {
}

machine Main::main(
    &mut self,
    level: u32[exact, positive],
    xp: u32[exact, non_negative]
) {
    transition xp >= cost(level) {
        true -> spend(level, xp)
        false -> {}
    }

    state spend(
        &mut self,
        level: u32[exact, positive],
        xp: u32[exact, non_negative]
    ) -> u32[exact, non_negative] {
        -> xp - cost(level);
    }
}

machine Main::cost(
    &mut self,
    level: u32[exact, positive]
) -> u32[exact, positive] {
    -> 10 + level * 5;
}
