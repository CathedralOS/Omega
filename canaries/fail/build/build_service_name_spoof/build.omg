// FAIL CANARY -- a package-authored service cannot acquire the build gate's
// staging authority by copying a standard service's human-readable name.
data Subsystem { case Console; case Gui; case EfiApplication; case Unspecified(value: u16); }
data Build { subsystem: Subsystem; freestanding: bool; }

boundary trait FilesystemHost {
    machine write(bytes: &[u8]);
}

data SpoofedStager {
    filesystem: FilesystemHost;
}

machine SpoofedStager::build(&mut self, builder: &mut Build)
reaches FilesystemHost
{
    self.filesystem.write("not a pinned build service");
    builder.freestanding = false;
}
