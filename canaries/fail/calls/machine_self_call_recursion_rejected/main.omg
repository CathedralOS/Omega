// CALL-SPELLED SELF-RECURSION (`true -> self.countdown(remaining - 1)`) is
// REJECTED by design (owner directive 2026-07-07): Omega has no recursion --
// stack size must be predictable; repetition is a bare state self-transition
// loop (`-> countdown(..)`), a jump with re-bound arguments.
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
}
machine Main::countdown(&mut self, remaining: usize) -> usize
terminates {
    decreases remaining;
}
{
    transition remaining > 0 {
        true -> self.countdown(remaining - 1)
        false -> 7
    }
}
machine Main::main(&mut self) {
    let value: usize = self.countdown(2);
    transition value == 7 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
