// Frozen decision 23 requires EVERY edge inside a cyclic component to
// strictly decrease the selected rank. The entry -> step edge forwards `n`
// unchanged, so the later strict step -> entry edge cannot rescue it.
use omega::language::std::console;
data Main { console: Console; }
machine Main::sum(&mut self, n: u64 [0..=100], acc: u64 [0..=5050])
terminates by n;
-> u64
{
    transition n > 0 && acc <= 4950 { true -> step(n, acc) _ -> leaf(acc) }
    state step(&mut self, n: u64 [1..=100], acc: u64 [0..=4950]) -> u64 { self.sum(n - 1, acc + n) }
    state leaf(&mut self, total: u64) -> u64 { total }
}
machine Main::main(&mut self) {
    let s: u64 = self.sum(4, 0);
    transition s == 10 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(70); }
    state no(&mut self)  { self.console.exit_process(71); }
}
