// THE MR2 PROVING FRONTIER (pinned 2026-07-11): a MEASURED machine's
// terminal tail self-call rewrites onto the bare loop-back edge at parse
// (identical trees to the hand-spelled bare loop -- verified by twin),
// so the REAL obligations surface instead of a blanket refusal. This
// shape still refuses at the DECREASES proof: the rewritten edge is the
// UNGUARDED fall-through, and the ranking cannot yet use the dominating
// base-case complement (`n == 0 -> exit` implies n >= 1 here). The
// unlock is fall-through complement narrowing (recorded in TASKS under
// MR2); when it lands, recast this into a run twin. The shape that
// proves TODAY is the guarded arm:
// pass/calls/runtime_measured_tail_recursion_exit.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::countdown(&mut self, n: u64 in Trapping) -> u64
terminates { decreases n; }
{
    transition n == 0 { true -> 7 }
    self.countdown(n - 1)
}
machine Main::main(&mut self) {
    let s: u64 = self.countdown(4);
    transition s == 7 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(70); }
    state no(&mut self)  { self.console.exit_process(71); }
}
