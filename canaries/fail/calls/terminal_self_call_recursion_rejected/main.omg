// TERMINAL-position call-spelled self-recursion (`{ self.sum(n - 1, acc +
// n) }` as a state's value terminal) is TAIL in shape -- under the
// measured-recursion ruling (2026-07-18) it becomes legal when rung MR2
// lands its loop-back rewrite (the same rewrite once tried 2026-07-09/10
// and retracted under the old NO-RECURSION directive, which the ruling
// AMENDS). Until MR2, the refusal points at the rung and the transition
// spellings that work today. This canary pins that the position cannot
// SILENTLY start compiling: when MR2 lands, recast this into its run twin.
// The transition-arm measured spelling already runs:
// pass/calls/runtime_measured_tail_recursion_exit.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::sum(&mut self, n: i32, acc: i32)
terminates { decreases n; }
-> i32
{
    transition n > 0 { true -> step(n, acc) false -> leaf(acc) }
    state step(&mut self, n: i32, acc: i32) -> i32 { self.sum(n - 1, acc + n) }
    state leaf(&mut self, acc: i32) -> i32 { acc }
}
machine Main::main(&mut self) {
    let s: i32 = self.sum(4, 0);
    transition s == 10 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
