// TERMINAL-position tail self-recursion on an UNMEASURED machine is
// REJECTED (measured-recursion ruling 2026-07-18): recursive call
// spellings are legal only when measured. On a MEASURED machine the
// parser rewrites this exact shape onto the bare loop-back edge (MR2,
// landed 2026-07-11) and the REAL obligations surface (see
// fail/calls/terminal_tail_rewrite_obligation_frontier for the current
// proving frontier). This canary pins the unmeasured refusal, naming
// the measure and the bare-loop alternative.
use omega::language::std::console;
data Main { console: Console; }
machine Main::sum(&mut self, n: i32, acc: i32)
-> i32
{
    transition n > 0 { true -> step(n, acc) false -> leaf(acc) }
    state step(&mut self, n: i32, acc: i32) -> i32 { self.sum(n - 1, acc + n) }
    state leaf(&mut self, acc: i32) -> i32 { acc }
}
machine Main::main(&mut self) {
    let s: i32 = self.sum(4, 0);
    transition s == 10 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
