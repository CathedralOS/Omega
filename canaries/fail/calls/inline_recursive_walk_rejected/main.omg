// A value call to a machine whose ARM targets an EFFECTFUL RECURSIVE
// (`terminates`) machine must be a clean compile error (the
// reentrant-value-call blocker's arm-target face): the inline-branching
// route cannot loop, so the walk's per-iteration `self.bump(..)` silently
// never executes (native counted 0 separators; the interpreter counted 2
// -- the 2026-07-07c trap). The fence landed TOGETHER with the
// leaf-binding guard folds that made this composition compile at all;
// neither piece may ship without the other. Siblings pin the DIRECT and
// STATEMENT faces (value_call_direct/-statement_recursive_walk_rejected);
// pure loop-carried recursion stays accepted
// (calls/runtime_loop_accumulator_exit). The real fix is dispatch
// specialization (call-with-return), which would replace this fence.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; n: i32 in Wrapping; }
machine Main::walk(&mut self, path: &[u8], i: usize, acc: i32)
terminates {
    decreases (i, path.len) -> Nat::BoundedDistance;
}
-> i32
{
    self.bump(path, i);
    transition i < path.len {
        true -> walk(path, i + 1, acc)
        false -> done(acc)
    }
    state done(&mut self, acc: i32) -> i32 { self.n }
}
machine Main::bump(&mut self, path: &[u8], i: usize) {
    transition i < path.len {
        true -> look(path, i)
        false -> skip()
    }
    state look(&mut self, path: &[u8], i: usize) {
        transition path[i] == 47 {
            true -> hit()
            false -> skip()
        }
    }
    state hit(&mut self) {
        self.n = self.n + 1;
        transition { _ -> skip() }
    }
    state skip(&mut self) { }
}
machine Main::count(&mut self, path: &[u8]) -> i32 {
    transition path.len > 0 {
        true -> self.walk(path, 0, 0)
        false -> zero()
    }
    state zero(&mut self) -> i32 { 0 }
}
machine Main::main(&mut self) {
    self.n = 0;
    let c: i32 = self.count("a/b/c");
    transition c == 2 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
