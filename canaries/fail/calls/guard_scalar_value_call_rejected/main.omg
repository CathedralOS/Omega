// SILENT MISCOMPILE FENCE (#40 face a): a scalar value-machine call used
// DIRECTLY as a guard subject is never materialized -- the guard lowers to
// NeedsRuntimeExpression carrying a real comparison operator, the emitter
// drops the comparison entirely, and the arm is entered UNCONDITIONALLY
// (dbl(5) == 11 took the true arm; designed-false probe 2026-07-07).
// The emission blocker rejects exactly that shape: NeedsRuntimeExpression +
// a real operator. Operator-None fallthrough edges (`_` arms) stay accepted,
// as do string/view call guards (TextEquals path) and bind-to-let guards.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::dbl(&self, x: i32 in Wrapping) -> i32 in Wrapping {
    let r: i32 in Wrapping = x * 2;
    transition { _ -> r }
}
machine Main::main(&mut self) {
    transition self.dbl(5) == 11 { true -> bad(71) _ -> good() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
