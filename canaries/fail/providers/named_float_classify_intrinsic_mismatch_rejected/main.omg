// Equal provider schemas do not authorize relabeling enum classification as a
// bool-valued intrinsic.
pub data FloatClass [copy] {
    case NaN;
    case Normal(negative: bool);
}

data F32 { }

boundary operator F32::classify(value: f32) -> FloatClass;

data BadFloatProvider { }

machine BadFloatProvider::classify32(value: f32) -> FloatClass
    satisfies F32::classify
    via Binding::CompilerIntrinsic("F32::is_normal.f32");

data Main {
    result: FloatClass;
}

machine Main::main(&mut self) {
    self.result = F32::classify(1.0f32);
}
