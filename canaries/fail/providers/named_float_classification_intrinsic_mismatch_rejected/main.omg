// Equal unary bool signatures do not let a target relabel one IEEE
// classification requirement as another.
data F32 { }

boundary operator F32::is_finite(value: f32) -> bool;

data BadFloatProvider { }

machine BadFloatProvider::is_finite32(value: f32) -> bool
    satisfies F32::is_finite
    via Binding::CompilerIntrinsic("F32::is_nan.f32");

data Main {
    result: bool;
}

machine Main::main(&mut self) {
    self.result = F32::is_finite(1.0f32);
}
