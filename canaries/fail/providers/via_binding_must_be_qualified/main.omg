// Binding cases are compiler vocabulary, not package-local constructors. The
// explicit sum path keeps the supply slot unambiguous while legacy `provides`
// compatibility rows retain their old bare spelling until PRV4f.
boundary trait Process {
    machine exit(code: i32);
}

machine exit_leaf(code: i32) satisfies Process::exit via Syscall(60);

data Main { }
machine Main::main(&mut self) { }
