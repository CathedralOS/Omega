// A named float requirement cannot select another compiler-known operation
// merely because its carrier and signature happen to match.
data F32 { }

boundary operator F32::minimum(left: f32, right: f32) -> f32;

data BadFloatProvider { }

machine BadFloatProvider::minimum32(left: f32, right: f32) -> f32
    satisfies F32::minimum
    via Binding::CompilerIntrinsic("F32::maximum.f32");

data Main {
    result: f32;
}

machine Main::main(&mut self) {
    self.result = F32::minimum(1.0f32, 2.0f32);
}
