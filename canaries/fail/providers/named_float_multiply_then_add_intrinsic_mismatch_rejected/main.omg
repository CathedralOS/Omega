// A fused binding cannot satisfy the distinct two-rounding requirement.
data F32 { }

boundary operator F32::multiply_then_add(
    left: f32,
    right: f32,
    addend: f32
) -> f32;

data BadFloatProvider { }

machine BadFloatProvider::multiply_then_add32(
    left: f32,
    right: f32,
    addend: f32
) -> f32
    satisfies F32::multiply_then_add
    via Binding::CompilerIntrinsic("F32::fused_multiply_add.f32");

data Main {
    result: f32;
}

machine Main::main(&mut self) {
    self.result = F32::multiply_then_add(1.0f32, 2.0f32, 3.0f32);
}
