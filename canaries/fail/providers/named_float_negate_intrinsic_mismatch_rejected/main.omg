// Equal carrier signatures do not let a target relabel square root as negate.
data F32 { }

boundary operator F32::negate(value: f32) -> f32;

data BadFloatProvider { }

machine BadFloatProvider::negate32(value: f32) -> f32
    satisfies F32::negate
    via Binding::CompilerIntrinsic("F32::square_root.f32");

data Main {
    result: f32;
}

machine Main::main(&mut self) {
    self.result = F32::negate(1.0f32);
}
