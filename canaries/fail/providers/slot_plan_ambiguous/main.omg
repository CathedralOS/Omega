// PRV4 step (2) selection v1: two FULLY COVERING plans for one slot on the
// SELECTED target -- an authored provides block (cross_platform_cli
// resolves to the host) and a PORTABLE satisfies leaf -- are ambiguous and
// refuse loudly naming both plans. Implicit selection is only ever unique;
// non-selected targets' plans stay inert (the host-portability convention).
boundary trait Pick {
    machine choose() -> i32;
}
cross_platform_cli provides Pick {
    choose -> 7
}
machine choose_leaf() -> i32 satisfies Pick::choose via VtableSlot(2);
data Main { }
machine Main::main(&mut self) {
}
