// A declared range that does NOT fit the array: `i: u64 [0..=5]` indexing
// `[i32; 5]` (high == length) must still reject -- the range only discharges
// the upper bound when high < length.
use omega::language::std::console;

data Main {
    console: Console;
    arr: [i32; 5];
    i: u64 [0..=5];
}

machine Main::main(&mut self) {
    transition { _ -> read() }
    state read(&mut self) {
        let v: i32 = self.arr[self.i];
        transition v == 0 { true -> m() false -> m() }
    }
    state m(&mut self) { self.console.exit_process(1); }
}
