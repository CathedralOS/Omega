// The array-of-structs sibling of nested_runtime_indexed_read_rejected: reading a
// field ARRAY of an array-of-structs element with a RUNTIME index -- `self.rows[c]
// .data[j]` -- silently read 0 (rows[2].data[1] with j==1 returned 0, not 6). The
// collection `rows[c].data` is a Member whose receiver is Indexed, so the base is
// reached through an array index; the backend cannot compute the nested runtime
// offset. Fenced. `self.row.data[j]` (a plain struct field, no array element) and a
// const index (`rows[i].data[0]`) lower fine and stay valid.
boundary trait Console { machine exit_process(return_code: i32); }
data Row { data: [i32; 2]; }
data Main { console: Console; rows: [Row; 3]; j: i32; }
machine Main::main(&mut self) {
    self.rows[0] = Row { data: [1, 2] };
    self.rows[2] = Row { data: [5, 6] };
    self.j = 1;
    let n: i32 = self.rows[2].data[self.j];
    self.console.exit_process(n);
}
