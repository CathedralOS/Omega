// The WRITE sibling of nested_runtime_indexed_struct_field_read_rejected:
// writing a field array through a RUNTIME element index with a RUNTIME leaf
// (`rows[i].data[j] = v`, BOTH runtime) must stay a CLEAN ERROR ("needs
// mutation lowering") -- the classifier refuses the static-assignment fast
// path and the backend's one-runtime-index op cannot address it. (The
// CONST-element face `rows[2].data[j] = v` lowers since 2026-07-07 and is
// pinned by pass/collections/runtime_nested_const_row_struct_field_write_exit.)
boundary trait Console { machine exit_process(return_code: i32); }
data Row { data: [i32; 2]; }
data Main { console: Console; rows: [Row; 3]; i: usize [0..=2]; j: usize [0..=1]; }
machine Main::main(&mut self) {
    self.rows[0] = Row { data: [1, 2] };
    self.rows[2] = Row { data: [5, 6] };
    self.i = 2;
    self.j = 1;
    self.rows[self.i].data[self.j] = 77;
    self.console.exit_process(0);
}
