// The WRITE sibling of nested_runtime_indexed_struct_field_read_rejected: writing a
// field ARRAY of an array-of-structs element with a RUNTIME index -- `self.rows[c]
// .data[j] = v` -- silently NO-OPPED (the element never updated; `rows[2].data[j=1]
// = 77` then reading [1] gave 6, not 77). The collection `rows[c].data` is
// `Member(Indexed(rows,c), data)`, reached through an array index; the static-
// assignment fast path drops it. The classifier `target_is_nested_runtime_indexed`
// now walks the collection chain, refuses the fast path, and it is reported cleanly.
boundary trait Console { machine exit_process(return_code: i32); }
data Row { data: [i32; 2]; }
data Main { console: Console; rows: [Row; 3]; j: i32; }
machine Main::main(&mut self) {
    self.rows[0] = Row { data: [1, 2] };
    self.rows[2] = Row { data: [5, 6] };
    self.j = 1;
    self.rows[2].data[self.j] = 77;
    self.console.exit_process(0);
}
