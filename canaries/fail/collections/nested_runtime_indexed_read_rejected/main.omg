// Reading a nested array element with a RUNTIME COLUMN index (`grid[..][j]`, j a
// runtime value) silently read 0 instead of the element: `self.grid[2][self.j]`
// with j==1 returned 0, not the correct 6 (confirmed native). The backend cannot
// lower nested runtime-column access yet; the sibling WRITE was already fenced, so
// this fences the READ to match. A CONST column (`grid[i][0]`) and a single index
// (`arr[i]`) are lowerable and stay valid. Workaround: const column, or a flat array.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; grid: [[i32; 2]; 3]; j: i32; }
machine Main::main(&mut self) {
    self.grid = [[1, 2], [3, 4], [5, 6]];
    self.j = 1;
    let n: i32 = self.grid[2][self.j];
    self.console.exit_process(n);
}
