// BOTH-RUNTIME nested read (`grid[i][j]`, i AND j runtime) must stay a CLEAN
// ERROR: the lowering op carries ONE runtime index, so a runtime index above
// another runtime index has no computable offset -- unfenced it silently
// reads 0. (The CONST-outer face `grid[2][j]` lowers since 2026-07-07 and is
// pinned by pass/collections/runtime_nested_const_row_indexed_read_exit.)
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; grid: [[i32; 2]; 3]; i: usize [0..=2]; j: usize [0..=1]; }
machine Main::main(&mut self) {
    self.grid = [[1, 2], [3, 4], [5, 6]];
    self.i = 2;
    self.j = 1;
    let n: i32 = self.grid[self.i][self.j];
    self.console.exit_process(n);
}
