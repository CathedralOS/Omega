// `String` fields block Equatable for now: text equality is CONTENT
// equality, and the native backend has no value-position string comparison
// path yet -- silently comparing descriptors would be wrong, so the
// conformance item errors loudly instead.

trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

data Tag {
    label: String;
    weight: i32;
}

Tag satisfies Equatable;

data Main {
    value: i32 = 0;
}

machine Main::main(&mut self) {
}
