data Room {
    exit_count: u32[exact, range<0, 4>];
}

data Main {
}

machine Main::main(
    &mut self,
    room: Room
) {
    match room.exit_count > 0 {
        true -> append(room.exit_count)
        false -> {}
    }
    

    state append(
        &mut self,
        exit_count: usize[positive]
    ) {
    }
}
