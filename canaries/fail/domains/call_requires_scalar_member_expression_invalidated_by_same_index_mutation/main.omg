data Entry {
    value: i32;
    other: i32;
}

domain Entry::Positive
requires
    self.value > 0;

data Main {
    entries: [Entry; 2];
}

machine Main::accept(value: i32)
requires
    value > 0
{
}

machine Main::main(&mut self)
requires
    self.entries[0] in Entry::Positive
{
    self.entries[0].value = 0;
    self.accept(self.entries[0].value);
}
