// P1b: an exact authorized route establishes provenance, not its predicates.
// The checked conformer must still prove `self.value > 0` on the result.

data Token {
    value: u64;
}

domain Token::Positive
requires
    self.value > 0
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue() -> Token
    ensures
        result in Token::Positive;
}

machine Token::zero() -> Token
satisfies TokenIssuer::issue
ensures
    result in Token::Positive
{
    Token { value: 0 }
}

data Main {
}

machine Main::main(&mut self) {
}
