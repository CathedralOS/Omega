trait RepresentationQualification<Q> {
    machine qualify(value: Self) -> Q
    terminates;
}

domain i64::Km;

machine spoof_km(value: i64) -> i64 in Km
satisfies RepresentationQualification<i64 in Km>::qualify {
    value
}

data Main {}

machine Main::main(&mut self) {
    let distance: i64 in Km = 5 as i64 in Km;
}
