use omega::language::core::qualification;

domain i64::Km;

machine qualify_km(value: i64) -> i64 in Km
satisfies RepresentationQualification<i64 in Km>::qualify {
    value
}

machine qualify_km_alternate(value: i64) -> i64 in Km
satisfies RepresentationQualification<i64 in Km>::qualify {
    value
}

data Main {}

machine Main::main(&mut self) {
    // Both direct names remain usable; only the shorthand is ambiguous.
    let first: i64 in Km = qualify_km(5);
    let second: i64 in Km = qualify_km_alternate(6);
    let ambiguous: i64 in Km = 7 as i64 in Km;
}
