data Token {
    value: u64;
}

domain Token::Issued
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue(value: u64) -> Token
    ensures
        result in Token::Issued;
}

machine Token::issue(value: u64) -> Token
satisfies TokenIssuer::issue
ensures
    result in Token::Issued
{
    Token { value: value }
}

data Main {
}

machine Main::main(&mut self) {
    let issued: Token in Issued = Token::issue(7);
    let raw: Token = issued;
}
