// Chapter 8: competing *participating* domain meanings for one use are a
// compile error. Both semantic facets are selected on the `left` binding, and
// both bind `+` over the same `(Quantity, Quantity)` operand tuple, so this use
// is ambiguous. Merely declaring both domains is legal; see the matching pass
// canary `domain_operator_inactive_same_carrier_coexists`.

data Quantity {
    value: i32;
}

domain Quantity::Linear
requires
    self.value >= 0;
{
    operator add(left: Quantity, right: Quantity) -> Quantity spelling +;
}

domain Quantity::Cyclic
requires
    self.value >= 0;
{
    operator add(left: Quantity, right: Quantity) -> Quantity spelling +;
}

data Main {}

machine Main::combine(
    &self,
    left: Quantity in Linear & Cyclic,
    right: Quantity
) {
    let sum: Quantity = left + right;
}

machine Main::main(&mut self) {}
