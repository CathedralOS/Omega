data Item {
    value: i32;
    tag: i32;
}

domain Item::Valid {
    self.value > 0;
}

data Main {
    items: [Item; 2];
}

machine Main::mark_valid(&mut self, item: &mut Item)
ensures
    item in Item::Valid
{
    item.value = 1;
}

machine Main::accept(item: Item)
requires
    item in Item::Valid
{
}

machine Main::identity_index(&mut self, index: usize) -> usize {
    index
}

machine Main::main(&mut self) {
    let index: usize = self.identity_index(1);
    self.mark_valid(&mut self.items[0]);
    self.items[index].value = 0;
    self.accept(self.items[0]);
}
