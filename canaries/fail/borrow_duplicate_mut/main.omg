data main {
    value: i32;
}

machine main -> i32 {
    pub entry(&mut self) {
        transition {
            _ -> swap(&mut self.value, &mut self.value)
        }
    }

    state swap(&mut self, left: &mut i32, right: &mut i32) {
        left = right;

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        0
    }
}
