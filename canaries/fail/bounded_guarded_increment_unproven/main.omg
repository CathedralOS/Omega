data Main {
}

machine Main::main(
    &mut self,
    exit_count: u32[exact, range<0, 4>]
) {
    transition exit_count < 4 {
        true -> append(exit_count)
        false -> {}
    }

    state append(
        &mut self,
        exit_count: u32[exact, range<0, 4>]
    ) -> u32[exact, range<0, 4>] {
        -> exit_count + 1;
    }
}
