// Chapter 21 (Versioned Data): code receiving unknown-version state should branch
// by version, e.g. `match counter { Counter::v1(old) -> migrate old to Counter
// ...}`. Stage-2 ruling: values carry NO era tag, so every value has the
// current shape and a `Type::vN(binding)` arm can never be selected -- the
// arm is rejected as unreachable rather than lowered with fake runtime
// semantics. Version matching becomes expressible when era-tagged containers
// (stage 3) give a subject that can actually hold multiple eras.

data Counter {
    counter: i32;
}

data Main {
}

machine Main::main(&mut self) {
    match counter {
        Counter::v1(old) -> migrate old to Counter
        Counter(current) -> current
    }
}
