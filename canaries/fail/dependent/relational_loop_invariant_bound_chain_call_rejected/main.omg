// SOUNDNESS BOUNDARY: the arrival contract carries `i <= outer <= limit <
// items.len`, but a sibling call may replace the intermediate `limit` before
// the indexed read. Its overlapping frame invalidates the whole chain.
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);

data Main {
    items: [u8; 8] in Utf8;
    i: u64;
    outer: u64;
    limit: u64;
    value: u8;
}

machine Main::main(&mut self) { }

machine Main::scan(&mut self)
requires
    self.outer <= self.limit && self.limit < self.items.len
{
    self.i = 0;
    transition self.i <= self.outer {
        true -> loop_()
        false -> done()
    }

    state loop_(&mut self) {
        self.clear_limit();
        self.value = self.items[self.i];
        self.i = self.i + 1;
        transition self.i <= self.outer {
            true -> loop_()
            false -> done()
        }
    }

    state done(&mut self) { }
}

machine Main::clear_limit(&mut self) {
    self.limit = 0;
}
