// R2 rung 2b: a literal whose valuation FAILS a default-domain fact
// refuses -- health omitted reads the ZII zero, and zero health is not a
// Player (ch12: construction is the gate).
use omega::language::std::console;
data Player
where
    health >= 1,
{
    health: i32;
    name_tag: u32;
}
data Main { console: Console; champion: Player; }
machine Main::main(&mut self) {
    self.champion = Player { name_tag: 7 };
    self.console.exit_process(70);
}
