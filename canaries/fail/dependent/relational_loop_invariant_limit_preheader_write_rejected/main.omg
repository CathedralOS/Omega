// SOUNDNESS BOUNDARY: the machine arrival contract initially relates limit to
// collection length, but the preheader overwrites limit before the loop-entry
// guard. Even though the natural loop preserves limit, the arrival fact is
// stale and cannot bridge `i < limit` to the indexed collection.
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);

data Main {
    items: [u8; 8] in Utf8;
    i: u64;
    limit: u64;
    value: u8;
}

machine Main::main(&mut self) { }

machine Main::scan(&mut self)
requires
    self.limit < self.items.len
{
    self.limit = 100;
    self.i = 0;
    transition self.i < self.limit {
        true -> loop_()
        false -> done()
    }

    state loop_(&mut self) {
        self.value = self.items[self.i];
        self.i = self.i + 1;
        transition self.i < self.limit {
            true -> loop_()
            false -> done()
        }
    }

    state done(&mut self) { }
}
