// R2 rung 3 slices 4+5 (SOUNDNESS, then PRECISION): folding the untracked
// len as the born zero would wrongly ACCEPT `count != len` for count = 3
// (3 != 0). Slice 4 poisoned the fold; slice 5's valuation transport now
// carries len = 3 across the transition, so the fold sees the REAL
// violation (3 != 3 is FALSE) and refuses precisely.
use omega::language::std::console;
data Tally
where
    count != len,
{
    len: u32;
    count: u32;
}
data Main { console: Console; tally: Tally; }
machine Main::main(&mut self) {
    self.tally.len = 3;
    transition {
        _ -> fill()
    }
    state fill(&mut self) {
        self.tally.count = 3;
        self.console.exit_process(70);
    }
}
