// R5 fail-closed boundary: a reachable state cycle keeps the inferred frame
// opaque. This concrete path writes only `self.touched` and exits, but the
// caller may not preserve `self.stable` from one observed execution path.
data Main {
    stable: u32;
    touched: u32;
    result: u32;
}

machine Main::main(&mut self) {
    self.stable = 5;
    self.cycle_touch();
    self.result = self.stable + 1;
}

machine Main::cycle_touch(&mut self) {
    transition { _ -> loop_() }

    state loop_(&mut self) {
        self.touched = 1;
        transition self.touched == 0 {
            true -> loop_()
            false -> done()
        }
    }

    state done(&mut self) { }
}
