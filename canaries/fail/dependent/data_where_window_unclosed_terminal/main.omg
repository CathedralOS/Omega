// WINDOW TRANSPORT negative twin: the window opened in the entry state is
// carried to `broken`, which never restores the facts -- the exit call
// (and the terminal exit) are consumption points and refuse.
boundary trait Console { machine exit_process(return_code: i32); }
data MemoryMap
where
    count <= len,
{
    len: u32;
    count: u32;
}
data Main { console: Console; map: MemoryMap; }
machine Main::main(&mut self) {
    self.map.len = 8;
    self.map.count = 3;
    self.map.len = 2;
    transition {
        _ -> broken()
    }
    state broken(&mut self) {
        self.console.exit_process(70);
    }
}
