// FAIL CANARY (R1a scope fence): a dependent maximum on a data FIELD
// keeps the generic non-constant-bound refusal -- field ranges are
// store-enforced at every write and ZII-gated, which needs the
// relational store proof (a later rung); R1a serves STATE PARAMETERS
// (entry-proved by the caller, immutable in the state).
use omega::language::std::console;
data Main { console: Console; count: u32 [0..=11]; cursor: u32 [0..=self.count]; }
machine Main::main(&mut self) {
    self.console.exit_process(70);
}
