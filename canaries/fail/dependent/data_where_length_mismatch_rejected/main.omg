// FAIL CANARY. The literal payload has length five, so a declared length four
// cannot establish the Packet default domain.
data Packet
where
    length == payload.len,
{
    length: u64;
    payload: &[u8];
}

data Main {
}

machine Main::main(&mut self) {
    let packet: Packet = Packet { length: 4, payload: "omega" };
}
