// FAIL CANARY (R5 value-call frame): the value-position sibling call writes
// self.count, so i's entry-time dependent atom cannot justify forwarding i.
data Main {
    count: u32;
    input: u32;
}

machine Main::main(&mut self) {
    transition self.input <= self.count { true -> forward(self.input) _ -> done() }

    state forward(&mut self, i: u32 [0..=self.count]) {
        let marker: u32 = self.replace_count();
        self.consume(i);
    }

    state done(&mut self) { }
}

machine Main::replace_count(&mut self) -> u32 {
    self.count = 0;
    self.count
}

machine Main::consume(&mut self, value: u32 [0..=self.count]) { }
