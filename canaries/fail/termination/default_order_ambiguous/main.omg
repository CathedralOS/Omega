data Main {}

machine Main::main(&mut self) -> i32 {
    transition {
        _ -> self.countdown(2)
    }
}

machine Main::countdown(&mut self, remaining: i32)
terminates {
    decreases remaining;
}
-> i32
{
    transition remaining > 0 {
        true -> self.countdown(remaining - 1)
        false -> remaining
    }
}
