data Card {
    power: u64;
}

operator Card::PowerOrder(power: u64) -> u64;

data Main {
}

machine Main::main(&mut self) {
    let value: u64 = self.weaken(Card { power: 3 });
}

machine Main::weaken(&mut self, card: Card)
terminates by card.power -> Card::PowerOrder;
-> u64
{
    transition card.power > 0 {
        true -> weaken(Card { power: card.power })
        false -> card.power
    }
}
