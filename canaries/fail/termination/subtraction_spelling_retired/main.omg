// The use-site subtraction spelling `decreases limit - index` is RETIRED
// (maintainer decision 2026-06-12): the ranked subjects are spelled as the
// argumented tuple `decreases (index, limit) -> Nat::BoundedDistance`, where
// the arrow's left side is uniformly the ranked subjects and the named view
// receives them as arguments in order. The diagnostic spells the exact
// replacement, with the subtraction's operands reordered into the view's
// (lower, upper) parameter order.

data Main {}

machine Main::main(&mut self) -> u64 {
    transition {
        _ -> self.walk(4, 0)
    }
}

machine Main::walk(&mut self, limit: u64, index: u64)
terminates by limit - index;
-> u64
{
    transition index < limit {
        true -> walk(limit, index + 1)
        false -> index
    }
}
