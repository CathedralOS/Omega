data Card {
    power: u64;
}

operator Card::PowerOrder(left: u64, right: u64) -> u64;

data Main {
}

machine Main::main(&mut self) {
    let value: u64 = self.weaken(3);
}

machine Main::weaken(&mut self, power: u64)
terminates by power -> Card::PowerOrder;
-> u64
{
    transition power > 0 {
        true -> weaken(power - 1)
        false -> power
    }
}
