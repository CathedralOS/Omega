// RETIRED-BUILTIN FENCE. `String` is now an ordinary available source name,
// not a builtin with hidden zero semantics. A user data declaration named
// `String` must therefore earn `[zero_init]` exactly like any other data type;
// its spelling cannot grant the property to an enclosing aggregate.

data String {
    value: i32;
}

data Envelope [zero_init] {
    text: String;
}

data Main {
    value: i32;
}

machine Main::main(&mut self) {
}
