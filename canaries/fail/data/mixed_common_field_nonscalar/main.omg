// Mixed data shapes (common fields + cases) restrict COMMON fields to scalar
// primitives for now: case construction zero-initializes every common field
// the literal does not name, and a scalar zero is one storage write in both
// backends. A non-scalar `&[u8]` common field is rejected loudly instead of
// half-zeroing.

data RoomEvent {
    label: &[u8];
    case Nothing;
    case Treasure(gold: i32);
}

data Main {
    value: i32;
}

machine Main::main(&mut self) {
}
