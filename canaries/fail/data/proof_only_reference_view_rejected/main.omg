// N1 borrow face: a reference field to proof-only data is refused --
// indirection breaks CONTAINMENT cycles (`next: &Node` of runtime data
// stays legal), but a proof-only pointee never materializes, so there
// is nothing to point at.
boundary trait Console { machine exit_process(return_code: i32); }
data Nat { case Zero; case Succ(prev: Nat); }
data Main { console: Console; view: &Nat; }
machine Main::main(&mut self) { self.console.exit_process(0); }
