// Zero-means-empty is the opt-in `[zero_init]` property (frozen decision 8):
// under it the FIRST case is the zero-initialized empty value, so it may not
// require payload fields. Without the property this declaration is legal.

data Token [zero_init] {
    case Number(value: i32);
    case End;
}

data Main {
    value: i32 = 0;
}

machine Main::main(&mut self) {
}
