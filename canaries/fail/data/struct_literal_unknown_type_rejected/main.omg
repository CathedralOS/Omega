// A struct literal naming an UNDEFINED type (`Nonexistent { a: 1 }`) used to
// compile silently. Rejected now as an unknown data type.
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { let x: i32 = Nonexistent { a: 1 }; self.console.exit_process(0); }
