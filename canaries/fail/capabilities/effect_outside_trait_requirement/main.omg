// Chapter 18 "Standard Effects": declared effects are ceilings; a concrete
// machine "may not declare a new effect outside the trait requirement." The trait
// requires only `stdout_io`, but the implementation declares `filesystem_io` too,
// which is outside the trait ceiling and is rejected.

boundary trait Console {
    machine write_line(text: String)
    effects
        stdout_io;
}

data MyConsole {
    id: i32;
}

machine MyConsole::write_line(text: String) satisfies Console
effects
    stdout_io
    filesystem_io
{
}

data Main {
    console: MyConsole;
}

machine Main::main(&mut self) {
    self.console.write_line("x");
}
