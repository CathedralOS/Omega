// RECAST 2026-07-11 (M2 blocker 1): distinct authored rows now COEXIST --
// names outside the closed catalog intern to stable Custom keys, so the
// old two-unknown-rows collision this canary pinned is the FEATURE now
// (pass/targets/efi_two_table_function_leaves). What survives is the additive-only
// rule: the SAME (trait, method) pair bound twice collides loudly.
boundary trait Beeper {
    machine beep(value: i32) -> i32;
    machine boop(value: i32) -> i32;
}
use omega::language::std::console;
data Main { console: Console; beeper: Beeper; }
local_unchecked provides Beeper {
    beep -> DllImport("msvcrt.dll", "abs");
    beep -> DllImport("msvcrt.dll", "labs")
}
machine Main::main(&mut self) {
    let a: i32 = self.beeper.beep(1);
    let b: i32 = self.beeper.boop(2);
    transition a == b { true -> same() _ -> differ() }
    state same(&mut self) { self.console.exit_process(70); }
    state differ(&mut self) { self.console.exit_process(71); }
}
