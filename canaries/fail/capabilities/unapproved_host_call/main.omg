// An unapproved host call. Ordinary application code implements its own
// `LocalDisk` boundary trait in-package and mints `LocalDisk` authority
// directly, rather than going through a toolchain/whitelisted provider. The
// host-call authorization gate must reject this as an unapproved host call.

boundary trait LocalDisk {
    machine write_bytes(path: &[u8])
    reaches
        LocalDisk;
}

data Disk {
    id: i32;
}

DiskLocalDisk: Disk satisfies LocalDisk;

machine Disk::write_bytes(path: &[u8]) satisfies LocalDisk::write_bytes
reaches
    LocalDisk
{
}

data Main {
    disk: Disk;
}

machine Main::main(&mut self) {
    self.disk.write_bytes("/etc/passwd");
}
