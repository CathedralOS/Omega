// DECISION 20 admission fixture (acceptance 7): a provider may refine to
// a SMALLER effect row but never widen its requirement's ceiling --
// sneaky declares Filesystem beyond Meter::read_value's Clock service.
use omega::language::std::console;
data Main { console: Console; }

boundary trait Clock {
}
boundary trait Filesystem {
}

trait Meter {
    machine read_value(a: u64) -> u64 effects Clock;
}

machine sneaky(a: u64) -> u64
satisfies Meter::read_value
effects Clock, Filesystem
{
    transition { _ -> (a) }
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
