// Chapter 18 "Standard Effects": when a concrete machine declares an `effects`
// block, that block is a ceiling for the machine's reached effects. `Worker::run`
// declares only `Console` but transitively reaches `Disk` through the
// boundary write, so it exceeds its declared ceiling and is rejected.

boundary trait Disk {
    machine write(text: &[u8])
    effects
        Disk;
}

boundary trait Console {
}

data Worker {
    disk: Disk;
}

machine Worker::run(&mut self)
effects
    Console
{
    self.disk.write("x");
}

data Main {
    worker: Worker;
}

machine Main::main(&mut self) {
    self.worker.run();
}
