// When a concrete machine declares a `reaches` row, that row is a ceiling for
// the machine's reached services. `Worker::run`
// declares only `Console` but transitively reaches `Disk` through the
// boundary write, so it exceeds its declared ceiling and is rejected.

boundary trait Disk {
    machine write(text: &[u8])
    reaches
        Disk;
}

boundary trait Console {
}

data Worker {
    disk: Disk;
}

machine Worker::run(&mut self)
reaches
    Console
{
    self.disk.write("x");
}

data Main {
    worker: Worker;
}

machine Main::main(&mut self) {
    self.worker.run();
}
