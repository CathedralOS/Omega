data Main {
    value: i32;
}

machine Main::main(&mut self) -> i32 {
    transition {
        _ -> overwrite(self.value)
    }
    

    state overwrite(&mut self, input_value: i32) {
        input_value = 2;

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        0
    }
}
