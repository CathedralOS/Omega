// FAIL canary (ch17 intro / concurrency stage 1): a spawn block may run
// arbitrary statements in the full design, but stage 1 (the synchronous-spawn
// desugar) supports EXACTLY ONE machine call inside the braces. An assignment
// statement body is rejected loudly rather than half-lowered.

data Main {
    counter: i32;
}

machine Main::main(&mut self) {
    spawn {
        self.counter = self.counter + 1;
    }
}
