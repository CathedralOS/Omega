data Cell {
    value: i32;
}

data Message {
    body: &Cell;
}

boundary trait Scheduler {
    machine park(message: Message) suspends;
}

data Main {
    scheduler: Scheduler;
    cell: Cell;
}

machine Main::main(&mut self) {
    let message: Message = Message { body: &self.cell };
    self.scheduler.park(message);
}
