// FAIL canary (ch17 / concurrency stage 1): calling a method on `self` inside
// a spawn block captures the parent machine by IMPLICIT borrow (the method
// receiver). Stage 1 rejects every borrow into a spawn -- including this
// implicit one -- captured values must be moved or copied.

data Main {
    counter: i32;
}

machine Main::main(&mut self) {
    spawn {
        self.bump();
    }
}

machine Main::bump(&mut self) {
    self.counter = self.counter + 1;
}
