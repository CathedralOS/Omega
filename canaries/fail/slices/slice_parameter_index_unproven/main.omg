data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
    index: u64;
}

machine Main::main(&mut self) -> i32 {
    let view: &[Entry] = self.entries.as_slice();
    transition {
        _ -> choose(view, self.index)
    }

    state choose(&mut self, entries: &[Entry], index: u64) -> i32 {
        let chosen: Entry = entries[index];
        chosen.value
    }
}
