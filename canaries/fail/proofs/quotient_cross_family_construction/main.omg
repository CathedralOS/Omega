data Index {
    case Zero;
    case Next(previous: Index);
}

data Stream<machine S>
where machine S(index: Index) -> Index;
{
    case Empty;
    case More(sample: Index, tail: Stream<S>);
}

data OtherStream<machine S>
where machine S(index: Index) -> Index;
{
    case Empty;
    case More(sample: Index, tail: OtherStream<S>);
}

boundary machine source(index: Index) -> Index;

machine equivalent(a: Stream, b: Stream) -> bool {
    transition { _ -> (true) }
}

machine equivalent_reflexive(a: Stream)
ensures equivalent(a, a)
{
}

machine equivalent_symmetric(a: Stream, b: Stream)
requires equivalent(a, b)
ensures equivalent(b, a)
{
}

machine equivalent_transitive(a: Stream, b: Stream, c: Stream)
requires
    equivalent(a, b)
    equivalent(b, c)
ensures equivalent(a, c)
{
}

data EquivalenceClass = Stream % equivalent;

machine bad(value: OtherStream<source>) -> EquivalenceClass {
    value as EquivalenceClass
}

data Main {
}

machine Main::main(&mut self) {
}
