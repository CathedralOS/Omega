data Representative {
    case Zero;
    case Next(previous: Representative);
}

machine equivalent(a: Representative, b: Representative) -> bool {
    transition { _ -> (true) }
}

machine equivalent_reflexive(a: Representative)
ensures equivalent(a, a)
{
}

machine equivalent_symmetric(a: Representative, b: Representative)
requires equivalent(a, b)
ensures equivalent(b, a)
{
}

machine equivalent_transitive(
    a: Representative,
    b: Representative,
    c: Representative
)
requires
    equivalent(a, b)
    equivalent(b, c)
ensures equivalent(a, c)
{
}

data EquivalenceClass = Representative % equivalent;

machine advance(value: Representative) -> Representative {
    Representative::Next { previous: value }
}

// This structural theorem no longer grants implicit lift authority.
machine advance_respects(a: Representative, b: Representative)
requires equivalent(a, b)
ensures equivalent(advance(a), advance(b))
{
}

machine rejected_implicit_lift(value: EquivalenceClass) -> EquivalenceClass {
    advance(value)
}

data Main {
}

machine Main::main(&mut self) {
}
