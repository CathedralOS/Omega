// NEGATIVE 3: the law mentions the `add` slot, but NO machine conforms it
// for this carrier -> the missing-slot diagnostic.
boundary trait Console { machine exit_process(return_code: i32); }
data Peano { case Zero; case Succ(pred: Peano); }
trait RingOps2 {
    machine add(a: Self, b: Self) -> Self;
    machine add_assoc(a: Self, b: Self, c: Self) -> Self
    ensures add(add(a, b), c) == add(a, add(b, c));
}
machine plus(a: Peano, b: Peano) -> Peano
terminates by a;
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { pred } -> Peano::Succ { pred: plus(pred, b) }
    }
}
machine plus_assoc(a: Peano, b: Peano, c: Peano) -> Peano
satisfies RingOps2::add_assoc
terminates by a;
ensures
    (plus(plus(a, b), c)) == (plus(a, plus(b, c)))
{
    transition a {
        Peano::Zero -> Peano::Zero
        Peano::Succ { pred } -> Peano::Succ { pred: plus_assoc(pred, b, c) }
    }
}
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }
