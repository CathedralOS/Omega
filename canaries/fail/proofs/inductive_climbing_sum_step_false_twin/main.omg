// Step-false twin of proofs/proof_inductive_climbing_sum. The base case holds
// (the negated guard makes the remaining distance non-positive), but the
// recursive arm STALLS the accumulator while the theorem claims one unit per
// remaining unit of distance. The induction hypothesis still enters -- the
// named bounded-distance measure (`limit - index -> Nat::BoundedDistance`)
// discharges at the call site -- but the instantiated hypothesis misses the
// goal by one, so the recursive arm's obligation is unprovable and the engine
// rejects rather than standing down. Pins that the bounded distance gates
// hypotheses in: a closed gate would suppress rejection and this false
// theorem would compile.

data Main {
}

machine Main::main(&mut self) {
    let total: usize = self.climb(4, 0, 0);
}

machine Main::climb(&mut self, limit: usize, index: usize, acc: usize) -> usize
terminates {
    decreases limit - index -> Nat::BoundedDistance;
}
ensures
    result >= acc + limit - index
{
    transition index < limit {
        true -> self.climb(limit, index + 1, acc)
        false -> acc
    }
}
