// FAIL CANARY: a consumer cites core add_zero_right (proven `result ==
// a`) but claims its result is Zero. Ensures-consumption instantiates
// the lemma to `a`, and `a == Nat::Zero` does not hold for a symbolic a,
// so the judge fences -- a cited FACT cannot launder a false conclusion.
use omega::language::core::nat;
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }
machine bogus(a: Nat) -> Nat
ensures
    result == Nat::Zero
{
    transition { _ -> (add_zero_right(a)) }
}
