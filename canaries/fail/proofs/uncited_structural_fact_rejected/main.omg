// The CITATION discipline's negative space (ch10 "Citing Proofs"; the
// OWNER_QUESTIONS #14 answer): core add_zero_right PROVES the law
// `add(a, Zero) == a`, and pass/proofs/proof_nat_structural_lemmas'
// cite_zero discharges this exact goal by CITING it -- but nothing is
// global and nothing applies silently, so the same goal WITHOUT the
// citation statement must fence. If this ever compiles, a lemma applied
// itself without being cited (ambient rewriting -- the parked extension).
use omega::language::core::nat;

boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }

machine uncited_zero(b: Nat)
ensures
    (add(b, Nat::Zero)) == b
{
}
