// FAIL CANARY. A live semiring license proves equality only when the complete
// natural-coefficient polynomial matches. This drops the b*d term, so the
// judge must remain fenced rather than treating distributivity as a wildcard.
use omega::language::core::nat;
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }
machine missing_term(a: Nat, b: Nat, c: Nat, d: Nat)
ensures
    (mul(add(a, b), add(c, d)))
        == (add(add(mul(a, c), mul(a, d)), mul(b, c)))
{
}
