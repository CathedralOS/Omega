// FALSE TWIN for the IH-enriched citation base (N4 order rung): sub_le's
// exact machine shape -- induction on b, pred_le_left citation, inductive
// self-call -- but the CLAIM is false (saturating_sub(saturating_sub(a,b), a) == Succ Zero). The
// two-pass citation instantiation must not let the machinery certify it.
use omega::language::core::nat;

use omega::language::std::console;
data Main { console: Console; }

machine bogus_sub_le(a: Nat, b: Nat) -> Nat
terminates by b;
ensures
    (saturating_sub((saturating_sub(a, b)), a)) == (Nat::Succ { prev: Nat::Zero })
{
    transition b {
        Nat::Zero -> bsl_zero(a)
        Nat::Succ { prev as q } -> bsl_step(a, q)
    }

    state bsl_zero(a: Nat) -> Nat {
        sub_self(a);
        transition { _ -> Nat::Zero }
    }

    state bsl_step(a: Nat, q: Nat) -> Nat {
        pred_le_left((saturating_sub(a, q)), a);
        transition { _ -> (bogus_sub_le(a, q)) }
    }
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
