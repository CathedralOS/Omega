use omega::language::core::content;

data ByteUnit {}

data Region [linear] {
    remaining: u64;
}

domain Region::Owned;

machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.remaining) }
}

trait RetiredEntryContentForm {
    machine retain(whole: Region in Owned)
    ensures
        Owned::content(entry(&whole)) == Owned::content(&whole);
}
