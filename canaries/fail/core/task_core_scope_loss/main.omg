use omega::language::core::task;

// A Task<T> linear value cannot disappear through ordinary scope cleanup.
machine leak(task: Task<i32>) {
    // The state-parameter claim remains live and must be consumed or
    // transferred.
}

machine lose_task_claim() {
    let task: Task<i32> = Task { provider: 1, activation: 7 };
    leak(task);
}
