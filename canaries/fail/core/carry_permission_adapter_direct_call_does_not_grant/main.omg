data Token [linear] {
    id: u64;
}

domain Token::SuspensionSafe = Carry::AcrossSuspend;

boundary trait ClaimProvider {
    machine grant(token: Token) -> Token
    ensures
        result in Token::SuspensionSafe;
}

data ClaimProviderImpl {}

machine ClaimProviderImpl::grant_claim(token: Token) -> Token
satisfies ClaimProvider::grant
{
    token
}

machine consume_claim(token: Token in Token::SuspensionSafe) -> Token {
    token
}

machine direct_adapter_call_does_not_grant(raw: Token) -> Token {
    let unqualified: Token = ClaimProviderImpl::grant_claim(raw);
    transition { _ -> (consume_claim(unqualified)) }
}
