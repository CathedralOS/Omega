use omega::language::core::extent;

machine consume_granted(extent: Extent in Granted) -> Extent {
    extent as Extent
}

machine reconstructed_extent_is_unqualified() {
    let reconstructed: Extent = Extent {
        base: 0 as addr,
        length: 4096,
    };
    let returned: Extent = consume_granted(reconstructed);
}
