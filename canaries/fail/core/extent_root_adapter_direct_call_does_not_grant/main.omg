use omega::language::core::extent;

data ExtentRootProviderImpl {}

machine ExtentRootProviderImpl::grant_root(root: Extent) -> Extent
satisfies ExtentRootProvider::grant
{
    root
}

machine consume_granted(root: Extent in Granted) -> Extent {
    root as Extent
}

machine direct_adapter_call_does_not_grant(root: Extent) -> Extent {
    let unqualified: Extent = ExtentRootProviderImpl::grant_root(root);
    transition { _ -> (consume_granted(unqualified)) }
}
