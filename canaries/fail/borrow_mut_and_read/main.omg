data Main {
    value: i32;
}

machine Main::main(&mut self) -> i32 {
    transition {
        _ -> copy(&mut self.value, self.value)
    }
    

    state copy(&mut self, out_value: &mut i32, input_value: i32) {
        out_value = input_value;

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        0
    }
}
