platform Console {
    entry write_line(text: String);
    entry read_line(out_line: &mut ConsoleLine);
    entry exit_process(return_code: i32);
}

data ConsoleLine {
    text: String;
}

machine main {
    contains console: Console;

    owns line: ConsoleLine;

    pub entry() {
        console.read_line(mut line);
        console.write_line(line.text);
        console.read_line(mut line);
        console.write_line(line.text);
        console.exit_process(0);
    }
}
