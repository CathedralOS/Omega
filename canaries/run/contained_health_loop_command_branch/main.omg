boundary trait Console {
    machine write_line(text: String);
    machine read_line(out_line: &mut String);
    machine exit_process(return_code: i32);
}

enum Command {
    Look,
    Quit,
    Invalid,
}

data Navigation {
    choice: Command;
    destination: i32;
}

data Parser {
}

machine Parser::resolve_navigation(&mut self, line: &String) -> Navigation {
    let choice: Command = self.resolve_command(line);
    self.navigation(choice, 0)
}

machine Parser::resolve_command(&mut self, line: &String) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

machine Parser::navigation(&mut self, choice: Command, destination: i32) -> Navigation {
    Navigation { choice: choice, destination: destination }
    
}

data Game {
    console: Console;
    line: String;
    parser: Parser;
    navigation: Navigation;
    health: i32;
}

machine Game::run(&mut self) {
    self.health = 10;
    transition { _ -> prompt() }
    

    state prompt(&mut self) {
        transition self.health == 0 {
            true -> dead()
            false -> read_command()
        }
    }

    state read_command(&mut self) {
        self.console.read_line(&mut self.line);
        self.navigation = self.parser.resolve_navigation(&self.line);

        transition self.navigation.choice {
            Command::Look -> look()
            Command::Quit -> finished()
            Command::Invalid -> invalid()
        }
    }

    state dead(&mut self) {
        self.console.write_line("dead");
        self.console.exit_process(2);
    }

    state look(&mut self) {
        self.console.write_line("look");
        transition { _ -> prompt() }
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        transition { _ -> prompt() }
    }

    state finished(&mut self) {
    }
}

data Main {
    game: Game;
}

machine Main::main(&mut self) -> i32 {
    transition { _ -> running() }
    

    state running(&mut self) {
        self.game.run();
        transition { _ -> shutdown() }
    }

    state shutdown(&mut self) {
        0
    }
}
