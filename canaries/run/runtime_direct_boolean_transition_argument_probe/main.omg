boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    flag: bool;
}

machine Main::main(&mut self) {
    self.flag = false;

    -> check(self.flag == false);

    state check(&mut self, flag_ok: bool) {
        transition flag_ok {
            (true) -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(211);
    }

    state bad(&mut self) {
        self.console.exit_process(212);
    }
}
