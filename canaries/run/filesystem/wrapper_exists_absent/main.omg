// PARKED — a native VALUE-CALL result-observation bug, revealed once the encoder
// large-offset fix let the STAT-based wrappers COMPILE. `Filesystem::exists`
// (`let rc = self.host.read_metadata(path, &mut self.stat_buf); transition rc == 0
// { present -> true; absent -> false }`) ALWAYS returns true natively, even for a
// definitely-absent path (stat returns -1 / ENOENT). So the `transition rc == 0`
// guard reads `rc` as 0 — the read_metadata RESULT is not observed by the guard in
// the inlined through-field value-call; `rc` stays at its ZII zero. write_all/
// read_all (whose `n >= 0` guard on the write/read result DOES work) pass, so this
// is specific to this shape (a metadata op, or the result-store-vs-guard-read slot
// for this callee). The byte-I/O ergonomic wrappers are native
// (native_wrapper_write_all); the STAT wrappers (exists/try_exists/metadata_path/
// read_dir) now COMPILE but need this result-observation fix. TASKS_FS.md step 14 /
// "STAT wrapper rc not observed".

use omega::language::std::filesystem;
use omega::language::std::filesystem_host;

data Main {
    fs: Filesystem;
    raw: FilesystemHost;
    n: i64;
    here: bool;
}

machine Main::main(&mut self) {
    self.here = self.fs.exists("/tmp/omega_never_exists_zzz.txt");
    transition self.here { true -> bad() _ -> good() }
    state good(&mut self) { self.n = self.raw.write(1, "PASS: absent file -> exists false\n"); }
    state bad(&mut self)  { self.n = self.raw.write(1, "FAIL: absent file -> exists TRUE (rc not observed)\n"); }
}
