// PARKED (step 14). Exercises the SHIPPED ergonomic `Filesystem::write_all`/
// `read_all`/`remove` natively. Layers 1-4 are done (aliased-literal operand
// resolution + LocalData host-call collection + LocalStorage emission +
// boundary-call-result LOCAL slots), so the full `let`-bound host-call chain
// `let fd=create; let w=write(fd,bytes); let rc=close(fd)` works for a SAME-data-
// type callee (canaries/pass/filesystem/native_value_call_let_chain).
//
// This canary still FAILS TO COMPILE for ONE remaining reason: the wrapper's
// scalar/slice PARAMS forwarded through the value-call don't resolve. `read_all(
// path, buffer, count)` -> `self.host.read(fd, buffer, count)`: `count` (a scalar
// param aliased to the caller's arg) resolves to NO place because
// `scalar_argument_operand_at` (and `address_argument_operand_at` for `buffer`)
// are NOT alias-aware, unlike the literal path (fix #1). THE REMAINING FIX: thread
// `alias_context` into those two arg resolvers and follow the alias to the caller's
// arg place -- the scalar/address analog of fix #1's `aliased_literal_data_object`.
// Until then, native programs use the RAW FilesystemHost seam (fully native, 48
// canaries); the ergonomic wrapper stays interpreter-only. TASKS_FS.md step 14.

use omega::language::std::filesystem;
use omega::language::std::filesystem_host;

data Main {
    fs: Filesystem;
    out: FilesystemHost;
    wrote: UnitResult;
    got: IoResult;
    gone: UnitResult;
    cap: usize;
    n: i64;
    first: u8;
    buffer: [u8; 16];
}

machine Main::main(&mut self) {
    self.cap = 16;
    self.wrote = self.fs.write_all("/tmp/omega_wrapper.txt", "hello");
    self.got = self.fs.read_all("/tmp/omega_wrapper.txt", &mut self.buffer, self.cap);
    self.gone = self.fs.remove("/tmp/omega_wrapper.txt");
    self.first = self.buffer[0];
    transition self.first == 104 { true -> good() _ -> fail() }
    state good(&mut self) { self.n = self.out.write(1, "PASS: ergonomic Filesystem::write_all + read_all round-trip\n"); }
    state fail(&mut self) { self.n = self.out.write(1, "FAIL: ergonomic wrapper round-trip\n"); }
}
