// PARKED REPRO — the ENUM-transition-leaf delivery bug (TASKS_FS.md follow-up #1).
// A value-call whose callee transitions to leaf states returning a DATA-ENUM
// (`PairResult::Err` vs `PairResult::Ok { pair: Pair{...} }`). The result is
// assigned to a field and matched. Expected: the `_`/false arm (mk_ok) is taken ->
// Ok, pair.a == 42 (PASS). Observed: "result tag not Ok" — the wrong arm's value
// reaches the field.
//
// Isolated (2026-07-11): a value-call TERMINAL that returns the enum works
// (payload delivered); a bool-returning transition works (native_value_call_guard).
// The break is specific to a value-call whose callee TRANSITIONS to enum leaves.
// Instruction dump: the 2-arm transition emits TWO `frame -> self.res` copies of
// the full 24-byte enum — one BEFORE the selected arm's field writes (copies ZII)
// and one after — and the nullary `Err` arm writes its tag to the wrong region
// (the machine's own base, not the call-result slot). Distinct from the value-call
// guard deep fix (that was scalar/bool); needs a focused leaf-delivery fix. The
// wrappers reach this via `metadata_path -> Ok{meta}` (meta ZII) and `open ->
// Ok{file}`; `try_exists` sidesteps it (field-guarded Yes/No, no enum leaf copy).

use omega::language::std::filesystem_host;

data Pair [copy, zero_init] {
    a: i64;
    b: i64;
}

data PairResult {
    case Err;
    case Ok(pair: Pair);
}

data Probe {
    host: FilesystemHost;
    flag: bool;
}

machine Probe::make(&mut self) -> PairResult {
    self.flag = false;
    transition self.flag { true -> mk_err() _ -> mk_ok() }
    state mk_err(&mut self) -> PairResult { PairResult::Err }
    state mk_ok(&mut self) -> PairResult { PairResult::Ok { pair: Pair { a: 42, b: 99 } } }
}

data Main {
    probe: Probe;
    raw: FilesystemHost;
    n: i64;
    res: PairResult;
}

machine Main::main(&mut self) {
    self.res = self.probe.make();
    transition self.res {
        PairResult::Ok { pair } -> check(pair)
        PairResult::Err -> bad_tag()
    }
    state check(&mut self, pair: Pair) {
        transition pair.a == 42 { true -> good() _ -> bad_payload() }
    }
    state good(&mut self)        { self.n = self.raw.write(1, "PASS: struct payload delivered (a==42)\n"); }
    state bad_tag(&mut self)     { self.n = self.raw.write(1, "FAIL: result tag not Ok\n"); }
    state bad_payload(&mut self) { self.n = self.raw.write(1, "FAIL: struct payload lost (a != 42)\n"); }
}
