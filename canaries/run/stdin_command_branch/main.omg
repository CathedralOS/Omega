boundary trait Console {
    machine write_line(text: String);
    machine read_line(out_line: &mut String);
    machine exit_process(return_code: i32);
}

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Parser {
}

machine Parser::resolve(&mut self, line: &String) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

data Main {
    console: Console;
    line: String;
    parser: Parser;
    command: Command;
}

machine Main::main(&mut self) {
    self.console.read_line(&mut self.line);
    self.command = self.parser.resolve(&self.line);

    transition self.command {
        Command::Look -> look()
        Command::Quit -> quit()
        Command::Invalid -> invalid()
    }
    

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
    }
}
