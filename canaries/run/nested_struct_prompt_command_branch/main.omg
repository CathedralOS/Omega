use omega::language::std::console;

domain [u8; 256]::Utf8
requires
    valid_utf8(self);

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Navigation {
    choice: Command;
    destination: i32;
}

data Parser {
}

machine Parser::resolve_navigation(&mut self, line: &[u8; 256] in Utf8) -> Navigation {
    let choice: Command = self.resolve_command(line);

    transition {
        choice == Command::Invalid -> self.resolve_exit()
        _ -> self.navigation(choice, 0)
    }
}

machine Parser::resolve_command(&mut self, line: &[u8; 256] in Utf8) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

machine Parser::resolve_exit(&mut self) -> Navigation {
    let navigation: Navigation = self.navigation(Command::Invalid, 99);
    navigation
}

machine Parser::navigation(&mut self, choice: Command, destination: i32) -> Navigation {
    Navigation { choice: choice, destination: destination }
    
}

data Main {
    console: Console;
    line: [u8; 256] in Utf8;
    parser: Parser;
    navigation: Navigation;
    health: i32;
}

machine Main::main(&mut self) {
    self.health = 10;

    transition self.health == 0 {
        true -> dead()
        false -> prompt()
    }
    

    state prompt(&mut self) {
        self.console.read_line(&mut self.line);
        self.navigation = self.parser.resolve_navigation(&self.line);

        transition self.navigation.choice {
            Command::Look -> look()
            Command::Quit -> quit()
            Command::Invalid -> invalid()
        }
    }

    state dead(&mut self) {
        self.console.write_line("dead");
        self.console.exit_process(2);
    }

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
    }
}
