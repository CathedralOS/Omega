// #66: a contained command-loop over an owned `[u8; N] in Utf8` carrier (no
// `String`). Each prompt reads a line into the carrier, borrows it as a
// `&[u8] in Utf8` view to resolve a Command, and loops until `quit`. The parser
// returns the Command enum directly (the value-call splices its enum result into
// the caller's branch each iteration).
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 16]::Utf8
requires
    valid_utf8(self);
boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
    machine read_line(out_line: &mut [u8; 16] in Utf8);
    machine exit_process(return_code: i32);
}

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Parser {
}

machine Parser::resolve(&mut self, line: &[u8] in Utf8) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

data Game {
    console: Console;
    line: [u8; 16] in Utf8;
    parser: Parser;
    command: Command;
    health: i32;
}

machine Game::run(&mut self) {
    self.health = 10;
    transition { _ -> prompt() }


    state prompt(&mut self) {
        self.console.read_line(&mut self.line);
        self.command = self.parser.resolve(&self.line);

        transition self.command {
            Command::Look -> look()
            Command::Quit -> finished()
            Command::Invalid -> invalid()
        }
    }

    state look(&mut self) {
        self.console.write_line("look");
        transition { _ -> prompt() }
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        transition { _ -> prompt() }
    }

    state finished(&mut self) {
    }
}

data Main {
    game: Game;
}

machine Main::main(&mut self) -> i32 {
    transition { _ -> running() }


    state running(&mut self) {
        self.game.run();
        transition { _ -> shutdown() }
    }

    state shutdown(&mut self) {
        0
    }
}
