boundary trait Console {
    machine write_line(text: String);
    machine read_line(out_line: &mut String);
    machine exit_process(return_code: i32);
}

enum Command {
    Look,
    Quit,
    Invalid,
}

data Navigation {
    choice: Command;
    destination: i32;
}

data Parser {
}

machine Parser::resolve_navigation(&mut self, line: &String) -> Navigation {
    let choice: Command = self.resolve_command(line);

    transition {
        choice == Command::Invalid -> self.resolve_exit()
        _ -> self.navigation(choice, 0)
    }
}

machine Parser::resolve_command(&mut self, line: &String) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

machine Parser::resolve_exit(&mut self) -> Navigation {
    self.navigation(Command::Invalid, 99)
}

machine Parser::navigation(&mut self, choice: Command, destination: i32) -> Navigation {
    Navigation { choice: choice, destination: destination }
    
}

data Main {
    console: Console;
    line: String;
    parser: Parser;
    navigation: Navigation;
}

machine Main::main(&mut self) {
    self.console.read_line(&mut self.line);
    self.navigation = self.parser.resolve_navigation(&self.line);

    transition self.navigation.choice {
        Command::Look -> look()
        Command::Quit -> quit()
        Command::Invalid -> invalid()
    }
    

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
    }
}
