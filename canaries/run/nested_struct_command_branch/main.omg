platform Console {
    entry write_line(text: String);
    entry read_line(out_line: &mut ConsoleLine);
    entry exit_process(return_code: i32);
}

data ConsoleLine {
    text: String;
}

enum Command {
    Look,
    Quit,
    Invalid,
}

data Navigation {
    choice: Command;
    destination: i32;
}

data Parser {
}

machine Parser::resolve_navigation(&mut self, line: &ConsoleLine) -> Navigation {
    let choice: Command = self.resolve_command(line);

    -> self.resolve_exit() when choice == Command::Invalid;
    -> self.navigation(choice, 0);
    


}

machine Parser::resolve_command(&mut self, line: &ConsoleLine) -> Command {
    -> Command::Look when line.text == "look";
    -> Command::Quit when line.text == "quit";
    -> Command::Invalid;
    
}

machine Parser::resolve_exit(&mut self) -> Navigation {
    -> self.navigation(Command::Invalid, 99);
    
}

machine Parser::navigation(&mut self, choice: Command, destination: i32) -> Navigation {
    Navigation { choice: choice, destination: destination }
    
}

data Main {
    console: Console;
    line: ConsoleLine;
    parser: Parser;
    navigation: Navigation;
}

machine Main::main(&mut self) {
    self.console.read_line(&mut self.line);
    self.navigation = self.parser.resolve_navigation(&self.line);

    transition self.navigation.choice {
        Command::Look -> look()
        Command::Quit -> quit()
        Command::Invalid -> invalid()
    }
    

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
    }
}
