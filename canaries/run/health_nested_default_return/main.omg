platform Console {
    entry write_line(text: String);
}

enum Command {
    Look,
    Quit,
    Invalid,
}

data Navigation {
    choice: Command;
    destination: i32;
}

data Parser {
}

machine Parser::resolve_navigation -> Navigation {
    pub entry(&mut self) {
        let choice: Command = self.resolve_command();
        -> self.navigation(choice, 0);
    }

    entry resolve_command(&mut self) -> Command {
        -> Command::Invalid;
    }

    entry navigation(&mut self, choice: Command, destination: i32) -> Navigation {
        Navigation { choice: choice, destination: destination }
    }
}

data main {
    console: Console;
    parser: Parser;
    navigation: Navigation;
    health: i32;
}

machine main {
    pub entry(&mut self) {
        self.health = 10;

        transition self.health == 0 {
            true -> dead()
            false -> prompt()
        }
    }

    state prompt(&mut self) {
        self.navigation = self.parser.resolve_navigation();

        transition self.navigation.choice {
            Command::Look -> look()
            Command::Quit -> quit()
            Command::Invalid -> invalid()
        }
    }

    state dead(&mut self) {
        self.console.write_line("dead");
    }

    state look(&mut self) {
        self.console.write_line("look");
    }

    state quit(&mut self) {
        self.console.write_line("quit");
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
    }
}
