// x64 codegen probe (NOT a contract canary): copying a local struct's String
// field out through a `&mut String` parameter yields an EMPTY string at runtime,
// even though it compiles cleanly. The dungeon crawler's data-driven room view
// (RoomFormatter::write_room_info: `out_line = room.description`) hits this class
// of bug; the sample currently works around it with hardcoded per-cell text.
//
// Expected: prints "FROM_LOCAL_FIELD" then "LIT", exits 70.
// Actual (x64): prints "" (empty) then "LIT", exits 70 -- the field copy is lost,
// the subsequent literal write is fine.

boundary trait Console {
    machine write_line(text: String);
    machine exit_process(return_code: i32);
}

data Holder {
    stored: String;
}

data Main {
    console: Console;
    line: String;
}

machine Main::main(&mut self) {
    self.set_from_local_field(&mut self.line);
    self.console.write_line(self.line);

    self.set_from_literal(&mut self.line);
    self.console.write_line(self.line);

    transition self.line == "FROM_LOCAL_FIELD" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}

machine Main::set_from_local_field(&mut self, out_line: &mut String) {
    let local: Holder;
    local.stored = "FROM_LOCAL_FIELD";
    out_line = local.stored;
}

machine Main::set_from_literal(&mut self, out_line: &mut String) {
    out_line = "LIT";
}
