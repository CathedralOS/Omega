use omega::language::core::float_operations;

// Source-to-ELF pin for normalized SysV AMD64 indirect field dispatch. The
// ordinary receiver is the first wire argument (rdi), while a MEMORY-class
// result takes hidden rdi and shifts the receiver to rsi. Layout resolves the
// nine functions from +8 through +72 behind the leading field.
data Triple { first: u64; second: u64; third: u64; }
data FloatPair { first: f64; second: f64; }
data FloatTriple { first: f32; second: f32; third: f32; }
data MixedPair { integer: u64; floating: f64; }
data SplitFloatPair { wide: f64; narrow: f32; }
data NestedFloat { value: f64; }
data NestedMixedPair { integer: u64; floating: NestedFloat; }
data ArrayMixedPair { integers: [u32; 2]; floats: [f32; 2]; }
data FloatLeaf { value: f64; }
data WrappedFloat { leaf: FloatLeaf; }
boundary trait FieldDispatch {
    machine invoke(this: addr, value: u64);
    machine transform(this: addr, value: Triple) -> Triple;
    machine blend(this: addr, value: FloatPair) -> FloatPair;
    machine pack(this: addr, value: FloatTriple) -> FloatTriple;
    machine mix(this: addr, value: MixedPair) -> MixedPair;
    machine split(this: addr, value: SplitFloatPair) -> SplitFloatPair;
    machine nest(this: addr, value: NestedMixedPair) -> NestedMixedPair;
    machine array_mix(this: addr, value: ArrayMixedPair) -> ArrayMixedPair;
    machine wrap(this: addr, value: WrappedFloat) -> WrappedFloat;
}
data NativeVtable {
    header: addr;
    invoke: addr;
    transform: addr;
    blend: addr;
    pack: addr;
    mix: addr;
    split: addr;
    nest: addr;
    array_mix: addr;
    wrap: addr;
}
linux_x64 machine NativeVtable::invoke_leaf(this: addr, value: u64) satisfies FieldDispatch::invoke via Binding::VtableField(invoke);
linux_x64 machine NativeVtable::transform_leaf(this: addr, value: Triple) -> Triple satisfies FieldDispatch::transform via Binding::VtableField(transform);
linux_x64 machine NativeVtable::blend_leaf(this: addr, value: FloatPair) -> FloatPair satisfies FieldDispatch::blend via Binding::VtableField(blend);
linux_x64 machine NativeVtable::pack_leaf(this: addr, value: FloatTriple) -> FloatTriple satisfies FieldDispatch::pack via Binding::VtableField(pack);
linux_x64 machine NativeVtable::mix_leaf(this: addr, value: MixedPair) -> MixedPair satisfies FieldDispatch::mix via Binding::VtableField(mix);
linux_x64 machine NativeVtable::split_leaf(this: addr, value: SplitFloatPair) -> SplitFloatPair satisfies FieldDispatch::split via Binding::VtableField(split);
linux_x64 machine NativeVtable::nest_leaf(this: addr, value: NestedMixedPair) -> NestedMixedPair satisfies FieldDispatch::nest via Binding::VtableField(nest);
linux_x64 machine NativeVtable::array_mix_leaf(this: addr, value: ArrayMixedPair) -> ArrayMixedPair satisfies FieldDispatch::array_mix via Binding::VtableField(array_mix);
linux_x64 machine NativeVtable::wrap_leaf(this: addr, value: WrappedFloat) -> WrappedFloat satisfies FieldDispatch::wrap via Binding::VtableField(wrap);
data Main {
    dispatch: FieldDispatch; receiver: addr;
    input: Triple; output: Triple;
    float_input: FloatPair; float_output: FloatPair;
    packed_input: FloatTriple; packed_output: FloatTriple;
    mixed_input: MixedPair; mixed_output: MixedPair;
    split_input: SplitFloatPair; split_output: SplitFloatPair;
    nested_input: NestedMixedPair; nested_output: NestedMixedPair;
    array_input: ArrayMixedPair; array_output: ArrayMixedPair;
    wrapped_input: WrappedFloat; wrapped_output: WrappedFloat;
}
boundary machine Main::main(&self) -> i32
reaches FieldDispatch
invokes FieldDispatch;
{
    self.dispatch.invoke(self.receiver, 7);
    self.output = self.dispatch.transform(self.receiver, self.input);
    self.float_output = self.dispatch.blend(self.receiver, self.float_input);
    self.packed_output = self.dispatch.pack(self.receiver, self.packed_input);
    self.mixed_output = self.dispatch.mix(self.receiver, self.mixed_input);
    self.split_output = self.dispatch.split(self.receiver, self.split_input);
    self.nested_output = self.dispatch.nest(self.receiver, self.nested_input);
    self.array_output = self.dispatch.array_mix(self.receiver, self.array_input);
    self.wrapped_output = self.dispatch.wrap(self.receiver, self.wrapped_input);
    transition { _ -> (0) }
}
