// *** THE GREETING -- MILESTONE 1: an Omega UEFI application prints "Hello from
// Omega" through the firmware's SimpleTextOutput protocol. BOOT-VERIFIED under
// QEMU/OVMF (2026-07-04): serial console shows "Hello from Omega",
// Image Return Status = Success. No C, no host runtime, no hand asm.
//
// The full chain, all Omega: build.omg sets efi_application+freestanding; the
// boundary entry receives the SystemTable (RDX) as a vouched &EfiSystemTable;
// `table.con_out` DEREFERENCES it at the plan offset (+64); the provides table
// binds output_string -> VtableSlot(1), which lowers to `mov rax,[rcx+8];
// call rax` -- read OutputString from the protocol struct and dispatch. The
// greeting text is a utf16"..." literal (CHAR16 code units).

boundary trait TextOutput { machine output_string(this: addr, text: addr); }
uefi_x64 provides TextOutput { output_string -> VtableSlot(1); }
data EfiSystemTable {
    hdr_signature: u64; hdr_revision: u32; hdr_header_size: u32; hdr_crc: u32; hdr_reserved: u32;
    firmware_vendor: addr; firmware_revision: u32; fw_pad: u32;
    console_in_handle: addr; con_in: addr; console_out_handle: addr; con_out: addr;
}
data Main { out: TextOutput; msg: [u16; 19]; }
boundary machine Main::run(&self, handle: addr, table: &EfiSystemTable) -> i32 {
    self.msg = utf16"Hello from Omega\r\n\0";
    let con_out: addr = table.con_out;
    self.out.output_string(con_out, &self.msg);
    transition { _ -> (0) }
}
