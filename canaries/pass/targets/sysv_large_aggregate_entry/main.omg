// A pure-integer record above two eightbytes is SysV MEMORY class and arrives
// by value in the incoming stack-argument area.
data Triple {
    first: u64;
    second: u64;
    third: u64;
}

data Main { observed: u64; }

boundary machine Main::main(&mut self, triple: Triple) -> i32 {
    self.observed = triple.first + triple.second + triple.third;
    transition { _ -> (0) }
}

target linux_x64 {
}
