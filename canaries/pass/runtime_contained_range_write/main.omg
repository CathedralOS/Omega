data Random {
}

data RandomState {
    seed: u64[wrapping];
    calls: UInt;
}

data Reward {
    gold: i32;
}

data Main {
    rng: Random;
}

machine Random::next_u32(
    &mut self,
    state: &mut RandomState
    ) -> u32[wrapping] {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;
    -> ((state.seed >> 32) as u32);
}

machine Random::range(
    &mut self,
    state: &mut RandomState,
    exclusive_max: u32[exact, positive]
    ) -> u32[exact, range<0, exclusive_max>] {
    let raw: u32[wrapping] = self.next_u32(state);
    -> raw % exclusive_max;
}

machine Main::main(
    &mut self,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.gold = 1 + self.rng.range(random, 5);
}
