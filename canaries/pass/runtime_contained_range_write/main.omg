data Random {
}

data RandomState {
    seed: u64[wrapping];
    calls: UInt;
}

data Reward {
    gold: i32;
}

data main {
    rng: Random;
}

machine Random::next_u32 -> u32[wrapping] {
    pub entry(
        &mut self,
        state: &mut RandomState
    ) {
        state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
        state.calls = state.calls + 1;
        -> ((state.seed >> 32) as u32);
    }
}

machine Random::range -> u32[exact, range<0, exclusive_max>] {
    pub entry(
        &mut self,
        state: &mut RandomState,
        exclusive_max: u32[exact, positive]
    ) {
        let raw: u32[wrapping] = self.next_u32(state);
        -> raw % exclusive_max;
    }
}

machine main {
    pub entry(
        &mut self,
        random: &mut RandomState,
        reward: &mut Reward
    ) {
        reward.gold = 1 + self.rng.range(random, 5);
    }
}
