boundary trait Console {
    machine exit_process(return_code: i32);
}

data Item {
    value: i32;
}

data Main {
    console: Console;
    items: [Item; 2];
    copy: Item;
}

machine Main::main(&mut self) {
    let index: usize = 1;
    self.items[index].value = 23;
    self.copy = self.items[index];

    transition self.copy.value == 23 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(85);
    }

    state bad(&mut self) {
        self.console.exit_process(86);
    }
}
