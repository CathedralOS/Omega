use omega::language::std::console;

data Room {
    exit_count: u32;
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let rooms: [Room; 1] = [Room { exit_count: 0 }];
    let index: u64 = 0;

    rooms[index].exit_count = rooms[index].exit_count + 1;

    transition rooms[0].exit_count == 1 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(191);
    }

    state bad(&mut self) {
        self.console.exit_process(192);
    }
}
