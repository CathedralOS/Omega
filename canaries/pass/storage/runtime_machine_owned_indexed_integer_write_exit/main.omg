boundary trait Console {
    machine exit_process(return_code: i32);
}

data Room {
    exit_count: i32;
}

data Main {
    console: Console;
    rooms: [Room; 2];
}

machine Main::main(&mut self) {
    let index: usize = 1;
    self.rooms[index].exit_count = 7;

    let room_slice: &[Room] = self.rooms.as_slice();
    transition room_slice[index].exit_count == 7 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(79);
    }

    state bad(&mut self) {
        self.console.exit_process(80);
    }
}
