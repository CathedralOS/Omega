// COMPILE CANARY: exact arithmetic through a local slice alias writes an
// indexed record and then updates a sibling field through the mutable record
// parameter. The precondition supplies both the index and increment bounds.
data Exit {
    destination: u32;
}

data Room {
    exits: [Exit; 4];
    exit_count: u32;
}

data Main {
}

machine Main::main(&mut self) {
    let rooms: [Room; 1] = [Room {
        exits: [
            Exit { destination: 0 },
            Exit { destination: 0 },
            Exit { destination: 0 },
            Exit { destination: 0 }
        ],
        exit_count: 0
    }];
    let from_index: u64 = 0;

    self.append_exit(&mut rooms[from_index], 1);
    transition {
        true -> main()
    }
}

machine Main::append_exit(
    &mut self,
    room: &mut Room,
    destination: u32
)
requires room.exit_count < 4
{
    let exits: &mut [Exit] = room.exits.as_mut_slice();
    let index: u32 [0..=3] = room.exit_count;

    exits[index] = Exit { destination: destination };
    room.exit_count = index + 1;
}
