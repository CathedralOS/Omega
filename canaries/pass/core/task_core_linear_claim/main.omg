use omega::language::core::task;

// Task<T> is ordinary generic [linear] data. Moving the claim through a binding
// transfers one obligation; an ordinary by-value-self consumer settles it.
// These explicit bootstrap values exercise multiplicity only and do not claim
// provider establishment or custody.
machine Task::settle<T>(self) {}

data WorkerState {
    case Idle;
    case Running(task: Task<i32>);
}

machine check_task_claims() {
    let started: Task<i32> = Task { provider: 1, activation: 7 };
    let forwarded: Task<i32> = started;
    Task::settle(forwarded);

    let pending: Task<i32> = Task { provider: 1, activation: 8 };
    let state: WorkerState = WorkerState::Running { task: pending };
    let extracted: Task<i32> = state.task;
    Task::settle(extracted);
}
