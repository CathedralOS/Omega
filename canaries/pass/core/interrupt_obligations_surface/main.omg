use omega::language::core::interrupt;

// Provider code supplies the opaque values. Checked handlers can only settle
// them through the consuming operations whose reaches remain explicit.
data Main {}

machine Main::settle(
    guard: InterruptMaskGuard,
    acknowledgement: InterruptAcknowledgement
)
effects machine_control, device_io
{
    guard.restore();
    acknowledgement.complete();
}

machine Main::main(&mut self) {}
