use omega::language::core::array;

// Confirms the fixed-array surface is browsable: native fixed arrays are spelled
// `[T; N]` (owned contiguous storage with a compile-time length), and importing
// the core `array` module brings in the length measure and the slice-view
// contracts (`Array::as_slice`, `Array::as_mut_slice`) with their requires/
// ensures on the provider-agnostic boundary requirements. The program type-checks
// cleanly with a fixed-array field present.

data Main {
    cells: [i32; 3];
}

machine Main::main(&mut self) {
}
