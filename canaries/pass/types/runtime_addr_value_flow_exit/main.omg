// RUN CANARY (exit 70) + interpreter differential. `addr` as a first-class
// VALUE: machine parameter, return through a value call, local binding,
// equality -- and `addr + u64`, the index/count/address model's blessed
// mixed operation (address + count -> address; the axes stay distinct but
// compose). These are exactly the shapes Region::allocate implies now that
// its signature is honest (allocate(size: u64, align: u64) -> addr;
// deallocate(address: addr, ...) -- the usize-retirement follow-up that
// moved the trait off "addresses as u64").
// exits: 71 = bump result wrong.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; base: addr; }
machine Main::bump(&mut self, a: addr, by: u64) -> addr { a + by }
machine Main::main(&mut self) {
    self.base = 4096;
    let p: addr = self.bump(self.base, 16);
    transition p == 4112 {
        true  -> good()
        false -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
