// RUN CANARY (exit 70). Frozen decision 17, stage S1b: SIGNED `Saturating`.
//
// i8 range is [-128, 127]. 100 + 100 = 200 overflows POSITIVE, so `i8 in
// Saturating` clamps to the signed max 127 (not the wrapped -56). This exercises
// the signed clamp path: a width-correct add, then `cmovs`/`cmovo` selecting
// IMIN/IMAX by the result's sign bit on overflow. The interpreter clamps to the
// same range so the differential oracle agrees.

use omega::language::std::console;

data Main {
    console: Console;
    a: i8 in Saturating;
    b: i8 in Saturating;
}

machine Main::main(&mut self) {
    self.a = 100;
    self.b = 100;
    // Operand-driven: a/b carry the Saturating domain, so the add saturates.
    let c: i8 in Saturating = self.a + self.b;   // 200 saturates to 127 (i8)
    transition c == 127 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
