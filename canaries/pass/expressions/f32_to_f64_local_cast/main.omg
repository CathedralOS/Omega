use omega::language::core::float_operations;

// RUN CANARY (exit 70). Guards the nested-cast width fix (same width axis as
// the f32 binary fixes). `let wide: f64 = self.src as f64; let n: i32 = wide
// as i32` folds `wide` into the outer cast, giving `(self.src as f64) as i32`
// -- a cast whose SOURCE is itself a cast. classify_scalar_value_type_in_table
// returned None for a Cast source, so the outer cast could not size its source
// and the whole write was SILENTLY DROPPED (n stayed ZII 0, guard 0==7 failed).
// Fixed by classifying a Cast expression as its TARGET type, so the convert
// chain builds (cvtss2sd then cvttsd2si).
//
// Before the fix: native exited 71 (n never written); interpreter exited 70.

use omega::language::std::console;

data Main {
    console: Console;
    src: f32;
}

machine Main::main(&mut self) {
    self.src = 7.0;

    // f32->f64 cast stored in local, then cast local to i32
    let wide: f64 = self.src as f64;  // Should be 7.0
    let n: i32 = (wide as i32 in Saturating) as i32; // Should be 7 (F4: proof-or-policy)

    transition n == 7 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
