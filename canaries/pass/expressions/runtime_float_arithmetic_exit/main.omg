use omega::language::core::float_operations;

// Runtime floating-point arithmetic on an f64 field. Each `+ - * /` lowers to an
// SSE scalar-double op: the operand bit patterns (loaded from the field, or the
// IEEE-754 immediate of a float literal) are moved into xmm0/xmm1, the op runs
// (addsd/subsd/mulsd/divsd), and the result bits are stored back. Both float
// literal operands and a second float field operand are exercised, and the
// chain reads the updated value at each step. Exits 70 to confirm the SSE
// sequence executes without faulting and codegen is clean (no stub/NoOp).

use omega::language::std::console;

data Main {
    console: Console;
    accumulator: f64;
    addend: f64;
}

machine Main::main(&mut self) {
    self.accumulator = 10.0;
    self.addend = 4.0;
    self.accumulator = self.accumulator + 2.0; // 12.0
    self.accumulator = self.accumulator - 1.0; // 11.0
    self.accumulator = self.accumulator * 3.0; // 33.0
    self.accumulator = self.accumulator / 2.0; // 16.5
    self.accumulator = self.accumulator + self.addend; // 20.5 (field operand)
    self.console.exit_process(70);
}
