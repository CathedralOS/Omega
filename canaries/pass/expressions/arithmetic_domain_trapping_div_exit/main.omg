// RUN CANARY (exit 70). Decision 17: Trapping divide. Integer division only
// overflows at TYPE_MIN / -1 (and divide-by-zero), both of which the hardware
// `idiv` already traps on -- exactly Trapping semantics -- so Trapping div/mod
// route to the normal division path. In range, 140 / 2 = 70.

use omega::language::std::console;

data Main {
    console: Console;
    a: i32 in Trapping;
    b: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.a = 140;
    self.b = 2;
    let c: i32 in Trapping = self.a / self.b;   // 70, no overflow
    transition c == 70 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
