// RUN CANARY (exit 70). Frozen decision 17, stage S1b: the `Trapping` arithmetic
// domain runs normally when the result is IN RANGE (it only aborts on overflow).
//
// 100 + 50 = 150, which fits in u8, so `u8 in Trapping` produces 150 and the
// program exits 70. The overflow case (which aborts via `ud2`) is exercised
// separately by a native-only test, since a trap is not a clean exit the
// differential oracle can compare.

use omega::language::std::console;

data Main {
    console: Console;
    a: u8 in Trapping;
    b: u8 in Trapping;
}

machine Main::main(&mut self) {
    self.a = 100;
    self.b = 50;
    // Operand-driven: a/b carry the Trapping domain.
    let c: u8 in Trapping = self.a + self.b;   // 150 fits in u8, no trap
    transition c == 150 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
