// Frozen decision 17, stage S1b: the `Trapping` arithmetic domain ABORTS the
// process on overflow (the native backend emits `ud2` after a width-correct add
// when the carry/overflow flag is set).
//
// 200 + 100 = 300 overflows u8, so `u8 in Trapping` traps -- the program never
// reaches the transition and never exits 70. This compiles cleanly (the trap is
// a runtime event); the abort is asserted by the native-only test
// `arithmetic_domain_trapping_overflow_aborts` (a trap is not a clean exit the
// differential oracle can compare).

boundary trait Console { machine exit_process(return_code: i32); }

data Main {
    console: Console;
    a: u8;
    b: u8;
}

machine Main::main(&mut self) {
    self.a = 200;
    self.b = 100;
    let c: u8 in Trapping = self.a + self.b;   // 300 overflows u8 -> trap (ud2)
    transition c == 44 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
