platform Console {
    entry write_line(text: String);
    entry exit_process(return_code: i32);
}

data main {
    console: Console;
}

machine main(&mut self) {
    self.console.write_line("first");

    -> second();


    state second() {
        self.console.write_line("second");
        self.console.exit_process(0);
    }
}
