data Main {
    current_room: u32;
    fountain_used: bool;
}

machine Main::main(&mut self) {
    self.current_room = 1;
    self.fountain_used = false;

    transition {
        _ -> enter_room()
    }

    state enter_room(&mut self) {
        transition (self.current_room, self.fountain_used) {
            (1, true) -> show_spent_fountain()
            (1, false) -> show_fountain()
            _ -> done()
        }
    }

    state show_fountain(&mut self) {
        self.fountain_used = true;
        transition {
            _ -> enter_room()
        }
    }

    state show_spent_fountain(&mut self) {}

    state done(&mut self) {}
}
