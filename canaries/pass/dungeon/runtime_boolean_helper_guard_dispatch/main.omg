data Main {
    room: u32;
    cleared: bool;
}

machine Main::main(&mut self) {
    self.room = 1;
    self.cleared = false;

    transition {
        _ -> enter_room()
    }

    state enter_room(&mut self) {
        transition self.room {
            1 -> enter_room_view()
            _ -> done()
        }
    }

    state enter_room_view(&mut self) {
        transition self.cleared == true {
            true -> show_cleared()
            false -> show_blocked()
        }
    }

    state show_cleared(&mut self) {}

    state show_blocked(&mut self) {
        self.cleared = true;
        transition {
            _ -> enter_room()
        }
    }

    state done(&mut self) {}
}
