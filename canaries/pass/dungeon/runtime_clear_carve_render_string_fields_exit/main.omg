boundary trait Console {
    machine exit_process(return_code: i32);
}

data CellId {
    case R00;
    case R01;
    case Empty;
}

data Room {
    cell: CellId;
    depth: u32;
    branch: u32;
    label: String;
    description: String;
}

data Level {
    rooms: [Room; 2];
    room_count: usize;
    start_cell: CellId;
}

data Builder {
}

data Lookup {
}

data Formatter {
    lookup: Lookup;
}

data Main {
    console: Console;
    builder: Builder;
    formatter: Formatter;
    level: Level;
    line: String;
}

machine Main::main(&mut self) {
    self.builder.build(&mut self.level);
    self.formatter.write_current_cell(self.level, self.level.start_cell, &mut self.line);

    transition self.line == "== Gate ==" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(198);
    }

    state bad(&mut self) {
        self.console.exit_process(199);
    }
}

machine Builder::build(&mut self, level: &mut Level) {
    self.clear_level(level);
    level.start_cell = CellId::R00;
    level.room_count = 0;
    self.carve_room(level, CellId::R00, 9, 0);
}

machine Builder::clear_level(&mut self, level: &mut Level) {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();
    self.clear_room(&mut rooms[0], CellId::R00);
    self.clear_room(&mut rooms[1], CellId::R01);
}

machine Builder::clear_room(&mut self, room: &mut Room, cell: CellId) {
    room.cell = cell;
    room.depth = 0;
    room.branch = 0;
    room.label = "";
    room.description = "";
}

machine Builder::carve_room(
    &mut self,
    level: &mut Level,
    cell: CellId,
    depth: u32,
    branch_id: u32
) {
    let room: &mut Room = self.room_mut(level, cell);
    room.cell = cell;
    room.depth = depth;
    room.branch = branch_id;
    room.label = self.room_label(cell);
    room.description = self.room_description(depth, branch_id);
    level.room_count = 1;
}

machine Builder::room_mut(&mut self, level: &mut Level, cell: CellId) -> &mut Room {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();

    transition cell {
        CellId::R00 -> &mut rooms[0]
        _ -> &mut rooms[1]
    }
}

machine Builder::room_label(&mut self, cell: CellId) -> String {
    transition {
        cell == CellId::R00 -> "Gate"
        _ -> "Branch Room"
    }
}

machine Builder::room_description(&mut self, depth: u32, branch_id: u32) -> String {
    transition {
        depth == 0 -> "Surface"
        _ -> "A bottomless dark room near the dungeon heart."
    }
}

machine Formatter::write_current_cell(
    &mut self,
    level: Level,
    cell: CellId,
    out_line: &mut String
) {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);
    out_line = "== " + room.label + " ==";
}

machine Lookup::find_room(
    &mut self,
    level: Level,
    cell: CellId,
    out_room: &mut Room
) {
    let rooms: &[Room] = level.rooms.as_slice();

    transition level.room_count > 0 {
        true -> find_room_at(rooms, level.room_count, cell, out_room, 0)
        false -> {}
    }

    state find_room_at(
        &mut self,
        rooms: &[Room],
        room_count: usize,
        cell: CellId,
        out_room: &mut Room,
        index: usize
    ) {
        let found: bool = rooms[index].cell == cell;
        let next_index: usize = index + 1;
        let has_next: bool = next_index < room_count;

        transition {
            found -> apply_room(rooms[index], out_room)
            has_next -> find_room_at(rooms, room_count, cell, out_room, next_index)
            _ -> {}
        }
    }

    state apply_room(&mut self, room: Room, out_room: &mut Room) {
        out_room.cell = room.cell;
        out_room.depth = room.depth;
        out_room.branch = room.branch;
        out_room.label = room.label;
        out_room.description = room.description;
    }
}
