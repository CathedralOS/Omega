use platform::console;

data CommandParser {}

data GameView {}

machine GameView::render_title(
    &mut self,
    console: &mut Console
) {
    console.write_line("###########################");
    console.write_line("#     Dungeon Crawler     #");
    console.write_line("###########################");
    console.write_line("");
}

machine GameView::render_prompt(
    &mut self,
    console: &mut Console
) {
    console.write("> ");
}

machine GameView::render_commands(
    &mut self,
    console: &mut Console
) {
    console.write_line("[Commands] look | help | inv | char | use | fight | exit");
}

data Dungeon {
    room_zero_seen: bool;
    room_one_seen: bool;
    room_two_seen: bool;
    room_three_seen: bool;
}

machine Dungeon::enter_room(
    &mut self,
    room_index: usize
) {
    transition {
        _ -> mark_current_room()
    }

    state mark_current_room(&mut self) {
        -> mark_zero() when room_index == 0;
        -> mark_one() when room_index == 1;
        -> mark_two() when room_index == 2;
        -> mark_three();
    }

    state mark_zero(&mut self) {
        self.room_zero_seen = true;
    }

    state mark_one(&mut self) {
        self.room_one_seen = true;
    }

    state mark_two(&mut self) {
        self.room_two_seen = true;
    }

    state mark_three(&mut self) {
        self.room_three_seen = true;
    }
}

data Main {
    console: Console;
    dungeon: Dungeon;
    parser: CommandParser;
    view: GameView;
    input: String;
    output: String;
    current_room_index: usize;
    fountain_used: bool;
    bat_defeated: bool;
    treasure_taken: bool;
}

machine Main::main(&mut self) {
    self.input = "";
    self.output = "";
    self.current_room_index = 0;
    self.fountain_used = false;
    self.bat_defeated = false;
    self.treasure_taken = false;

    self.view.render_title(&mut self.console);

    transition {
        _ -> enter_room()
    }

    state enter_room(&mut self) {
        self.dungeon.enter_room(self.current_room_index);

        -> show_gate_room() when self.current_room_index == 0;
        -> show_spent_fountain_room() when self.current_room_index == 1 && self.fountain_used == true;
        -> show_fountain_room() when self.current_room_index == 1;
        -> show_ambush_room() when self.current_room_index == 2 && self.bat_defeated == true;
        -> show_ambush_encounter() when self.current_room_index == 2;
        -> show_looted_vault_room() when self.current_room_index == 3 && self.treasure_taken == true;
        -> show_vault_room();
    }

    state prompt(&mut self) {
        self.view.render_prompt(&mut self.console);
        self.console.read_line(&mut self.input);

        -> move_east() when self.input == "east";
        -> finished();
    }

    state move_east(&mut self) {
        -> enter_ambush_room() when self.current_room_index == 0;
        -> invalid_command();
    }

    state enter_ambush_room(&mut self) {
        self.current_room_index = 2;

        transition {
            _ -> enter_room()
        }
    }

    state show_gate_room(&mut self) {
        self.console.write_line("");
        self.console.write_line("== Gate ==");
        self.console.write_line("The old gate room breathes cold air from below.");
        self.console.write_line("[Event] The room is quiet.");
        self.console.write_line("[Paths] north | east");
        self.view.render_commands(&mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state show_fountain_room(&mut self) {
        self.console.write_line("");
        self.console.write_line("== Fountain Room ==");
        self.console.write_line("A quiet shrine chamber hums with pale water-light.");
        self.console.write_line("[Event] A fountain of life glows here. Type use to drink.");
        self.console.write_line("[Paths] south");
        self.view.render_commands(&mut self.console);

        self.console.exit_process(142);
    }

    state show_spent_fountain_room(&mut self) {
        self.console.write_line("");
        self.console.write_line("== Fountain Room ==");
        self.console.write_line("A quiet shrine chamber hums with pale water-light.");
        self.console.write_line("[Event] The fountain is drained. There is nothing left to use.");
        self.console.write_line("[Paths] south");
        self.view.render_commands(&mut self.console);

        self.console.exit_process(143);
    }

    state show_ambush_room(&mut self) {
        self.console.write_line("");
        self.console.write_line("== Ambush Hall ==");
        self.console.write_line("A narrow hall where loose stone crunches underfoot.");
        self.console.write_line("[Event] The bat lies still. The hall is clear.");
        self.console.write_line("[Paths] west | east");
        self.view.render_commands(&mut self.console);

        self.console.exit_process(144);
    }

    state show_ambush_encounter(&mut self) {
        self.console.write_line("");
        self.console.write_line("== Ambush Hall ==");
        self.console.write_line("A narrow hall where loose stone crunches underfoot.");
        self.console.write_line("[Enemy] A Cave Bat circles in the eastern passage.");
        self.console.write_line("[Paths] west");
        self.view.render_commands(&mut self.console);

        self.console.exit_process(145);
    }

    state show_vault_room(&mut self) {
        self.console.write_line("");
        self.console.write_line("== Treasure Vault ==");
        self.console.write_line("A cracked vault glitters with coins trapped under dust.");
        self.console.write_line("[Event] A treasure cache rests against the wall. Type use to claim it.");
        self.console.write_line("[Paths] west");
        self.view.render_commands(&mut self.console);

        self.console.exit_process(146);
    }

    state show_looted_vault_room(&mut self) {
        self.console.write_line("");
        self.console.write_line("== Treasure Vault ==");
        self.console.write_line("A cracked vault glitters with coins trapped under dust.");
        self.console.write_line("[Event] Empty chests and scattered dust show the treasure is gone.");
        self.console.write_line("[Paths] west");
        self.view.render_commands(&mut self.console);

        self.console.exit_process(147);
    }

    state invalid_command(&mut self) {
        self.console.exit_process(148);
    }

    state finished(&mut self) {
        self.console.exit_process(149);
    }
}
