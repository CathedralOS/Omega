use platform::console;

data Main {
    console: Console;
    current_room: u64;
    fountain_used: bool;
    bat_defeated: bool;
    treasure_taken: bool;
}

machine Main::main(&mut self) {
    self.current_room = 2;
    self.fountain_used = false;
    self.bat_defeated = true;
    self.treasure_taken = false;

    transition (
        self.current_room,
        self.fountain_used,
        self.bat_defeated,
        self.treasure_taken
    ) {
        (0, _, _, _) -> gate()
        (1, true, _, _) -> spent()
        (1, false, _, _) -> fountain()
        (2, _, true, _) -> ambush_clear()
        (2, _, false, _) -> ambush()
        (3, _, _, true) -> looted()
        _ -> vault()
    }

    state gate(&mut self) {
        self.console.exit_process(70);
    }

    state spent(&mut self) {
        self.console.exit_process(71);
    }

    state fountain(&mut self) {
        self.console.exit_process(72);
    }

    state ambush_clear(&mut self) {
        self.console.exit_process(73);
    }

    state ambush(&mut self) {
        self.console.exit_process(74);
    }

    state looted(&mut self) {
        self.console.exit_process(75);
    }

    state vault(&mut self) {
        self.console.exit_process(76);
    }
}
