use platform::console;

data Main {
    console: Console;
    current_room: u32;
    fountain_used: bool;
    bat_defeated: bool;
    treasure_taken: bool;
}

machine Main::main(&mut self) {
    self.current_room = 2;
    self.fountain_used = false;
    self.bat_defeated = false;
    self.treasure_taken = false;

    transition {
        _ -> defeat_bat()
    }

    state defeat_bat(&mut self) {
        self.bat_defeated = true;
        transition {
            _ -> take_treasure()
        }
    }

    state take_treasure(&mut self) {
        self.current_room = 3;
        self.treasure_taken = true;
        transition {
            _ -> use_fountain()
        }
    }

    state use_fountain(&mut self) {
        self.current_room = 1;
        self.fountain_used = true;
        transition {
            _ -> revisit_ambush()
        }
    }

    state revisit_ambush(&mut self) {
        self.current_room = 2;
        transition {
            _ -> route_after_ambush()
        }
    }

    state route_after_ambush(&mut self) {
        transition (self.current_room, self.bat_defeated) {
            (2, true) -> ambush_clear()
            _ -> fail(60)
        }
    }

    state ambush_clear(&mut self) {
        self.current_room = 1;
        transition {
            _ -> route_after_fountain()
        }
    }

    state route_after_fountain(&mut self) {
        transition (self.current_room, self.fountain_used) {
            (1, true) -> spent_fountain()
            _ -> fail(61)
        }
    }

    state spent_fountain(&mut self) {
        self.current_room = 3;
        transition {
            _ -> route_after_vault()
        }
    }

    state route_after_vault(&mut self) {
        transition (self.current_room, self.treasure_taken) {
            (3, true) -> looted_vault()
            _ -> fail(62)
        }
    }

    state looted_vault(&mut self) {
        self.console.exit_process(63);
    }

    state fail(&mut self, code: i32) {
        self.console.exit_process(code);
    }
}
