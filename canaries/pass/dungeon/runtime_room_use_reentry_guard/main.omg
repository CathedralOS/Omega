data Main {
    current_room: u32;
    fountain_used: bool;
}

machine Main::main(&mut self) {
    self.current_room = 1;
    self.fountain_used = false;

    transition {
        _ -> use_fountain()
    }

    state use_fountain(&mut self) {
        self.fountain_used = true;
        transition {
            _ -> leave_room()
        }
    }

    state leave_room(&mut self) {
        self.current_room = 0;
        transition {
            _ -> reenter_fountain()
        }
    }

    state reenter_fountain(&mut self) {
        self.current_room = 1;
        transition (self.current_room, self.fountain_used) {
            (1, true) -> show_spent_fountain()
            _ -> show_live_fountain()
        }
    }

    state show_spent_fountain(&mut self) {}

    state show_live_fountain(&mut self) {}
}
