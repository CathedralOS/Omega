use platform::console;

data Main {
    console: Console;
    current_room: u32;
    bat_defeated: bool;
}

machine Main::main(&mut self) {
    self.current_room = 2;
    self.bat_defeated = false;

    transition {
        _ -> defeat_bat()
    }

    state defeat_bat(&mut self) {
        self.bat_defeated = true;
        transition {
            _ -> retreat_to_gate()
        }
    }

    state retreat_to_gate(&mut self) {
        self.current_room = 0;
        transition {
            _ -> reenter_ambush()
        }
    }

    state reenter_ambush(&mut self) {
        self.current_room = 2;
        transition (self.current_room, self.bat_defeated) {
            (2, true) -> show_cleared_hall()
            _ -> show_blocked_hall()
        }
    }

    state show_cleared_hall(&mut self) {
        self.console.exit_process(51);
    }

    state show_blocked_hall(&mut self) {
        self.console.exit_process(52);
    }
}
