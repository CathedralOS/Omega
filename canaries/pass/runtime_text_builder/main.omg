data Room {
    label: String;
}

data Line {
    text: String;
}

platform Console {
    entry write_line(text: String);
    entry exit_process(return_code: i32);
}

data Main {
    console: Console;
    room: Room;
    line: Line;
}

machine Main::main(&mut self) -> i32 {
    self.room.label = "A1";
    self.line.text = "Room " + self.room.label;

    transition {
        _ -> shutdown()
    }
    

    state shutdown(&mut self) {
        self.console.write_line(self.line.text);
        self.console.exit_process(0);
        0
    }
}
