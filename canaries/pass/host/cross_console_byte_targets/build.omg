// Cross-compile pins for every hosted Console provider closure. The suite
// inspects the windows_x64 (GetStdHandle + ReadFile/WriteFile import flavor)
// and linux_x64 (read/write syscall flavor) encoder fragments and compiles
// both AArch64 closures structurally. Native confirmation needs those hosts.
target windows_x64 {
}

target linux_x64 {
}

target macos_arm64 {
}

target linux_arm64 {
}

machine build(b: &mut Build) {
    b.roots.bind(windows_x86_64::ProgramEntry, Main::main);
    b.roots.bind(linux_x86_64::ProgramEntry, Main::main);
    b.roots.bind(macos_arm64::ProgramEntry, Main::main);
    b.roots.bind(linux_arm64::ProgramEntry, Main::main);
}
