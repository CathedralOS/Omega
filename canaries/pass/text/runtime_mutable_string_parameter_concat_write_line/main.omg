use omega::language::std::console;

domain [u8; 16]::Utf8
requires
    valid_utf8(self);

domain [u8; 32]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Console;
    line: [u8; 32] in Utf8;
    suffix: [u8; 16] in Utf8;
}

machine Main::main(&mut self) {
    self.line = "";
    self.suffix = "omega";

    transition self.suffix {
        _ -> write_line(&mut self.line, self.suffix)
    }

    state write_line(
        &mut self,
        out_line: &mut [u8; 32] in Utf8,
        suffix: [u8; 16] in Utf8
    ) {
        out_line = "prefix " + suffix;
        self.console.write_line(out_line);

        transition self.line == "prefix omega" {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(77);
    }

    state bad(&mut self) {
        self.console.exit_process(78);
    }
}
