// A carrier (`[u8;N] in Utf8`) indexed read used as a sub-expression OPERAND --
// `self.sum + self.text[self.i] as u32` -- the inline string-processing shape
// (e.g. a hash fold). The hoist normalization materializes `text[i]` into a temp;
// the temp must be typed `u8` (NOT `u8 in Utf8`): the `Utf8` domain is bound to
// the carrier's `[u8]` storage, not to a single byte. Summing the bytes of
// "ABCD" (65+66+67+68) gives 266 (a Wrapping u32). Exits 70.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 4]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Main {
    console: Console;
    text: [u8; 4] in Utf8;
    i: i32 in Trapping;
    sum: u32 in Wrapping;
}

machine Main::main(&mut self) {
    self.text = "ABCD";
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 4 {
            true -> accumulate()
            _ -> done()
        }
    }

    state accumulate(&mut self) {
        self.sum = self.sum + self.text[self.i] as u32 in Wrapping;
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        transition self.sum == 266 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
