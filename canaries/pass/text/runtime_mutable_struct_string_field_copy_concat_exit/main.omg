use omega::language::std::console;

domain [u8; 8]::Utf8
requires
    valid_utf8(self);

domain [u8; 16]::Utf8
requires
    valid_utf8(self);

data Room {
    label: [u8; 8] in Utf8;
}

data Main {
    console: Console;
    source: Room;
    copied: Room;
    line: [u8; 16] in Utf8;
}

machine Main::main(&mut self) {
    self.source.label = "omega";

    transition self.source.label {
        _ -> apply_room(self.source, &mut self.copied)
    }

    state apply_room(&mut self, room: Room, out_room: &mut Room) {
        out_room.label = room.label;

        transition out_room.label {
            _ -> write_line(out_room.label, &mut self.line)
        }
    }

    state write_line(
        &mut self,
        label: [u8; 8] in Utf8,
        out_line: &mut [u8; 16] in Utf8
    ) {
        out_line = "prefix " + label;

        transition self.line == "prefix omega" {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(77);
    }

    state bad(&mut self) {
        self.console.exit_process(78);
    }
}
