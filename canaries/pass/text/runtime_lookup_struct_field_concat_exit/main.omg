use omega::language::std::console;

domain [u8; 16]::Utf8
requires
    valid_utf8(self);

domain [u8; 32]::Utf8
requires
    valid_utf8(self);

data CellId {
    case C0;
    case C1;
}

data Room {
    cell: CellId;
    label: [u8; 16] in Utf8;
}

data Level {
    rooms: [Room; 2];
    room_count: u64;
}

data Lookup {
}

data Formatter {
    lookup: Lookup;
}

data Main {
    console: Console;
    formatter: Formatter;
    level: Level;
    line: [u8; 32] in Utf8;
}

machine Main::main(&mut self) {
    let rooms: &mut [Room] = self.level.rooms.as_mut_slice();
    rooms[0].cell = CellId::C0;
    rooms[0].label = "Gate";
    self.level.room_count = 1;

    self.formatter.write_current_cell(self.level, CellId::C0, &mut self.line);

    transition self.line == "== Gate ==" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(190);
    }

    state bad(&mut self) {
        self.console.exit_process(191);
    }
}

machine Formatter::write_current_cell(
    &mut self,
    level: Level,
    cell: CellId,
    out_line: &mut [u8; 32] in Utf8
) {
    let room: Room;
    self.lookup.find_room(level, cell, &mut room);
    out_line = "== " + room.label + " ==";
}

machine Lookup::find_room(
    &mut self,
    level: Level,
    cell: CellId,
    out_room: &mut Room
)
ensures
    out_room.label in Utf8
{
    let rooms: &[Room] = level.rooms.as_slice();

    transition level.room_count > 0 {
        true -> find_room_at(rooms, level.room_count, cell, out_room, 0)
        false -> {}
    }

    state find_room_at(
        &mut self,
        rooms: &[Room],
        room_count: u64,
        cell: CellId,
        out_room: &mut Room,
        index: u64
    ) {
        let found: bool = rooms[index].cell == cell;
        let next_index: u64 = index + 1;
        let has_next: bool = next_index < room_count;

        transition {
            found -> apply_room(rooms[index], out_room)
            has_next -> find_room_at(rooms, room_count, cell, out_room, next_index)
            _ -> {}
        }
    }

    state apply_room(
        &mut self,
        room: Room,
        out_room: &mut Room
    ) {
        out_room.cell = room.cell;
        out_room.label = room.label;
    }
}
