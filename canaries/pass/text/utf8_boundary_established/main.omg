// Exercises a boundary-established text domain on its ordinary byte-view
// carrier. The validator scans once and establishes the domain membership on
// the caller's mutable operand; the fact is then carried rather than re-proved.

domain [u8]::Utf8
requires
    valid_utf8(self);

boundary operator Text::validate_utf8(text: &mut [u8]) -> ()
ensures
    text in Utf8;

data Main {
    text: &mut [u8];
}

machine Main::consume(&self, text: &[u8])
requires
    text in Utf8
{
}

machine Main::main(&mut self) {
    Text::validate_utf8(self.text);
    // Consumed downstream as a carried fact, with no byte re-scan.
    self.consume(self.text);
}
