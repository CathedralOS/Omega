// Building a string from a NUMBER (`itoa`) by overwriting a carrier's bytes with
// computed digit chars (constant-index carrier writes of computed values), then
// reading the bytes back to self-check. Converts 150 to the three chars
// '1'(49) '5'(53) '0'(48) and verifies each. This is the write half of
// number<->text round-tripping (the read half is parse_int). The runtime
// arithmetic does not yet prove each digit's range, so narrowing selects the
// explicit trapping operation rather than relying on compatibility `as`.
// Exits 70.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 4]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    out: [u8; 4] in Utf8;
    n: i32 in Trapping;
    digit: i32 in Trapping;
    ch: u8;
}

machine Main::main(&mut self) {
    self.n = 150;
    self.out = "000";

    self.digit = self.n / 100;
    self.digit = self.digit + 48;
    self.ch = narrow_i32_to_u8_trapping(self.digit as i32);
    self.out[0] = self.ch;

    self.digit = self.n / 10;
    self.digit = self.digit % 10;
    self.digit = self.digit + 48;
    self.ch = narrow_i32_to_u8_trapping(self.digit as i32);
    self.out[1] = self.ch;

    self.digit = self.n % 10;
    self.digit = self.digit + 48;
    self.ch = narrow_i32_to_u8_trapping(self.digit as i32);
    self.out[2] = self.ch;

    // Read the digits back and confirm "150".
    transition self.out[0] == 49 {
        true -> check_tens()
        _ -> bad()
    }

    state check_tens(&mut self) {
        transition self.out[1] == 53 {
            true -> check_ones()
            _ -> bad()
        }
    }

    state check_ones(&mut self) {
        transition self.out[2] == 48 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
