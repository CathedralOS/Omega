domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Room {
    label: [u8; 8] in Utf8;
}

data Main {
    console: Console;
    rooms: [[Room; 2]; 2];
    outer: u64 [0..=1];
    inner: u64 [0..=1];
}

machine Main::main(&mut self) {
    self.outer = 1;
    self.inner = 1;
    self.rooms[self.outer][self.inner].label = "Ga";
    self.rooms[self.outer][self.inner].label =
        self.rooms[self.outer][self.inner].label + "te";

    let actual: [u8; 8] in Utf8 = self.rooms[1][1].label;
    transition actual == "Gate" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(87);
    }

    state bad(&mut self) {
        self.console.exit_process(88);
    }
}
