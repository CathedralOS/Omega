// #66: a stdin command parser over an owned `[u8; N] in Utf8` carrier. The line is
// read straight into the carrier's inline bytes, borrowed as a `&[u8] in Utf8`
// view, and matched against literals to resolve a command -- no `String`.
domain [u8]::Utf8 when valid_utf8(self) {
}

domain [u8; 32]::Utf8 when valid_utf8(self) {
}

boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
    machine read_line(out_line: &mut [u8; 32] in Utf8);
    machine exit_process(return_code: i32);
}

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Parser {
}

machine Parser::resolve(&mut self, line: &[u8] in Utf8) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

data Main {
    console: Console;
    line: [u8; 32] in Utf8;
    parser: Parser;
    command: Command;
}

machine Main::main(&mut self) {
    self.console.read_line(&mut self.line);
    self.command = self.parser.resolve(&self.line);

    transition self.command {
        Command::Look -> look()
        Command::Quit -> quit()
        Command::Invalid -> invalid()
    }

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
    }
}
