// Recoverable failure is ordinary returned sum data. The caller handles every
// outcome explicitly; no hidden exception path or result out-parameter exists.

data IOError {
    code: i32;
}

data Buffer {
    len: u64;
}

data ReadResult {
    case Read(bytes: u64);
    case Closed;
    case Failed(error: IOError);
}

data File {
    handle: i32;
}

machine File::read(&mut self, out: &mut Buffer) -> ReadResult {
    transition {
        _ -> ReadResult::Read { bytes: 0 }
    }
}

data Main {
    file: File;
    buffer: Buffer;
}

machine Main::main(&mut self) {
    transition self.file.read(&mut self.buffer) {
        ReadResult::Read { bytes } -> done()
        ReadResult::Closed -> done()
        ReadResult::Failed { error } -> done()
    }

    state done(&mut self) {
    }
}
