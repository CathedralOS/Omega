// Bounds-from-operator integration: importing the core slice surface brings the
// `operator [] Slice::index ... requires index < items.len` boundary
// operator into scope. The `self.values[0]` access below has its bounds
// obligation sourced from that operator's `requires` contract (see the
// validation seam in checks/ranges/indexes/validation.rs) and discharged by the
// known-length bounds proof. Index 0 is within length 3, so it compiles.

use omega::language::core::slice;

data Main {
    values: [i32; 3];
}

machine Main::main(&mut self) {
    let first: i32 = self.values[0];
}
