// A plain two-subject tuple `decreases (index, limit)` infers the named
// bounded distance: Nat::BoundedDistance is the only builtin two-subject
// ranking, so the view may be omitted. The subjects bind in order to the
// view's (lower, upper) parameters.

data Main {}

machine Main::main(&mut self) -> usize {
    transition {
        _ -> self.walk(4, 0)
    }
}

machine Main::walk(&mut self, limit: usize, index: usize)
terminates {
    decreases (index, limit);
}
-> usize
{
    transition index < limit {
        true -> self.walk(limit, index + 1)
        false -> index
    }
}
