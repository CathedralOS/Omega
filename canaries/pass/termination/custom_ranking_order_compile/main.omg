data Card {
    power: usize;
}

measure Card::PowerOrder(power: usize) -> usize { power }

data Main {
}

machine Main::main(&mut self) {
    let value: usize = self.weaken(3);
}

machine Main::weaken(&mut self, power: usize)
terminates {
    decreases power -> Card::PowerOrder;
}
-> usize
{
    transition power > 0 {
        true -> self.weaken(power - 1)
        false -> power
    }
}
