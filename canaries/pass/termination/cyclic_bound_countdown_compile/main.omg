data Main {
}

machine Main::main(&mut self) -> u64 {
    transition {
        _ -> self.step_a(6)
    }
}

machine Main::step_a(&mut self, remaining: u64)
terminates by remaining -> Nat::Descending;
-> u64
{
    transition remaining > 0 {
        true -> step_b(remaining - 1)
        false -> 0
    }

    state step_b(&mut self, remaining: u64) -> u64 {
        transition remaining > 0 {
            true -> step_c(remaining - 1)
            false -> 0
        }
    }

    state step_c(&mut self, remaining: u64) -> u64 {
        transition remaining > 0 {
            true -> step_a(remaining - 1)
            false -> 0
        }
    }
}
