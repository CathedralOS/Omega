data Card {
    power: usize;
}

measure Card::PowerOrder(power: usize) -> usize { power }

data Main {
}

machine Main::main(&mut self) {
    let value: usize = self.weaken(Card { power: 3 });
}

machine Main::weaken(&mut self, card: Card)
terminates {
    decreases card.power -> Card::PowerOrder;
}
-> usize
{
    transition card.power > 0 {
        true -> self.weaken(Card { power: card.power - 1 })
        false -> card.power
    }
}
