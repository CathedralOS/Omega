// Ladder rung L5 (nonlinear ranges): interval multiplication of a variable by
// itself. If a lies in 0..=10 then a * a lies in 0..=100. Lean analog:
// `Nat.mul_le_mul`. Needs interval products, the first nonlinear step.

machine square_bounded(a: u64)
requires
    a in 0..=10
ensures
    a * a in 0..=100
{
}

