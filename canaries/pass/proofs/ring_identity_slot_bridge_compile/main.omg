// COMPILE CANARY. The semiring constant slots are ordinary nullary machines;
// compute-mode must bridge their applications to Nat's constructor constants.
// Citations name the concrete satisfying proof machines; `satisfies` records
// which abstract law slot each contract discharges, but does not mint a local
// callable alias under the requirement's name.
use omega::language::core::nat;
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }

machine constant_slot_bridge(a: Nat)
ensures
    zero() == Nat::Zero;
    one() == (Nat::Succ { prev: Nat::Zero });
    add(a, zero()) == a;
    mul(a, one()) == a
{
    add_zero_right(a);
    mul_identity(a);
}
