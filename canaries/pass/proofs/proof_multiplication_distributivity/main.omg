// Ladder rung L6 (ring normalization): multiplication distributes over
// addition with no hypotheses. Lean analog: `Nat.add_mul` (also reachable via
// `ring`). The fixed-width inputs embed into proof `Int`, so normalization is
// over unbounded mathematics rather than unproved Exact `u64` arithmetic.

machine multiply_distributes(a: u64, b: u64, c: u64)
ensures
    (embed(a) + embed(b)) * embed(c) == embed(a) * embed(c) + embed(b) * embed(c)
{
}

data Main {
}

machine Main::main(&mut self) {
