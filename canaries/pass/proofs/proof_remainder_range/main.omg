// Ladder rung L6 (euclidean facts): a remainder is bounded by its modulus.
// Lean analog: `Nat.mod_lt`. Needs a built-in lemma about `%`, not interval
// propagation of the operands.

machine remainder_bounded(a: u64)
ensures
    a % 2 in 0..=1
{
}

