// Induction over a climbing index (extends ladder rung L7): the counting loop
// walks `index` up to `limit`, adding one per step, so the result covers the
// starting accumulator plus the remaining bounded distance. The induction
// hypothesis enters on the recursive arm because the argumented
// bounded-distance measure `(index, limit) -> Nat::BoundedDistance` is
// discharged at the call site: under the `index < limit` guard the distance
// is strictly smaller at (limit, index + 1) and still non-negative -- the
// same strict-decrease + non-negativity polynomial gate the plain
// descending-naturals measure uses. The instantiated hypothesis for
// (limit, index + 1, acc + 1) is exactly the goal; the base arm closes
// because the negated guard makes the remaining distance non-positive. (The
// inequality form is used because it holds without a `requires index <= limit`
// precondition.)

data Main {
}

machine Main::main(&mut self) {
    let total: usize = self.climb(4, 0, 0);
}

machine Main::climb(&mut self, limit: usize, index: usize, acc: usize) -> usize
terminates {
    decreases (index, limit) -> Nat::BoundedDistance;
}
ensures
    result >= acc + limit - index
{
    transition index < limit {
        true -> self.climb(limit, index + 1, acc + 1)
        false -> acc
    }
}
