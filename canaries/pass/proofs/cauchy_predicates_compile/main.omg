// N8 Cauchy predicates quantify through ordinary symbolic machine inputs and
// take their generator/modulus identities as static machine parameters.
use omega::language::core::cauchy;

machine unit_sample(index: Nat) -> Rat {
    Rat {
        num: Nat::Succ { prev: Nat::Zero },
        den: Nat::Succ { prev: Nat::Zero }
    }
}

machine immediate_modulus(precision: Nat) -> Nat {
    Nat::Zero
}

machine valid_cauchy_point() -> Nat {
    cauchy_at<unit_sample, immediate_modulus>(
        Nat::Succ { prev: Nat::Zero },
        Nat::Zero,
        Nat::Zero
    )
}

machine valid_convergence_point() -> Nat {
    converges_together_at<
        unit_sample,
        unit_sample,
        immediate_modulus
    >(
        Nat::Succ { prev: Nat::Zero },
        Nat::Zero,
        Nat::Zero
    )
}

machine unit_sequence_is_reflexive(precision: Nat, index: Nat)
requires
    (sub(Nat::Succ { prev: Nat::Zero }, precision)) == Nat::Zero;
    (sub(immediate_modulus(precision), index)) == Nat::Zero
ensures
    (cauchy_at<unit_sample, immediate_modulus>(
        precision,
        index,
        index
    )) == Nat::Zero
{
    cauchy_at_reflexive<unit_sample, immediate_modulus>(precision, index);
}

machine unit_sequences_are_symmetric(
    precision: Nat,
    left_index: Nat,
    right_index: Nat
)
requires
    (sub(Nat::Succ { prev: Nat::Zero }, precision)) == Nat::Zero;
    (sub(immediate_modulus(precision), left_index)) == Nat::Zero;
    (sub(immediate_modulus(precision), right_index)) == Nat::Zero;
    (converges_together_at<unit_sample, unit_sample, immediate_modulus>(
        precision,
        left_index,
        right_index
    )) == Nat::Zero
ensures
    (converges_together_at<unit_sample, unit_sample, immediate_modulus>(
        precision,
        right_index,
        left_index
    )) == Nat::Zero
{
    converges_together_at_symmetric<
        unit_sample,
        unit_sample,
        immediate_modulus
    >(precision, left_index, right_index);
}

data Main {
}

machine Main::main(&mut self) {
}
