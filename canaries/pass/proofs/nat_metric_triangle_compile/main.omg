// N8's denominator-scaling prerequisite: Nat absolute difference is checked
// reflexive/symmetric and satisfies the triangle inequality in monus order.
use omega::language::core::nat_metric;

machine triangle_available(a: Nat, b: Nat, c: Nat)
ensures
    (saturating_sub(nat_gap(a, c), add(nat_gap(a, b), nat_gap(b, c)))) == Nat::Zero
{
    nat_gap_triangle(a, b, c);
}

machine scaled_gap_available(a: Nat, b: Nat, factor: Nat)
ensures
    (nat_gap(mul(a, factor), mul(b, factor))) == (mul(nat_gap(a, b), factor))
{
    nat_gap_mul_right(a, b, factor);
}

machine multiplication_preserves_order(a: Nat, b: Nat, factor: Nat)
requires
    (saturating_sub(a, b)) == Nat::Zero
ensures
    (saturating_sub(mul(a, factor), mul(b, factor))) == Nat::Zero
{
    mul_le_mul_right(a, b, factor);
}

machine positive_multiplication_reflects_order(a: Nat, b: Nat, factor: Nat)
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, factor)) == Nat::Zero;
    (saturating_sub(mul(a, factor), mul(b, factor))) == Nat::Zero
ensures
    (saturating_sub(a, b)) == Nat::Zero
{
    mul_le_cancel_right(a, b, factor);
}

data Main {
}

machine Main::main(&mut self) {
}
