use omega::language::core::numeric_conversion;

data RandomState {
    seed: u64 in Wrapping;
    calls: UInt;
}

data Random {
}

machine Random::next_u32(&mut self, state: &mut RandomState) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;
    narrow_u64_to_u32_wrapping(state.seed >> 32)
}

machine Random::range(&mut self, state: &mut RandomState, exclusive_max: u32 in Wrapping) -> u32 {
    let raw: u32 in Wrapping = self.next_u32(state);
    raw % exclusive_max
}

data ItemKind {
    case RustedDagger;
    case EarlyBuckler;
    case HealingCharm;
    case EmberBlade;
    case DeepKey;
}

data RewardKind {
    case GoldAndItem;
}

data Reward {
    kind: RewardKind;
    gold: u32 in Wrapping;
    item: ItemKind;
}

data Main {
    rng: Random;
}

machine Main::main(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.kind = RewardKind::GoldAndItem;
    reward.gold = 20 + depth * 8 + self.rng.range(random, 15);
    reward.item = self.pick(depth, random);
    
}

machine Main::pick(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState
    ) -> ItemKind {
    let roll: u32 in Wrapping = self.rng.range(random, 100);
    let is_early_dagger: bool = depth <= 2 && roll < 50;
    let is_early_buckler: bool = depth <= 3 && roll < 75;
    let is_healing_charm: bool = roll < 85;
    let is_ember_blade: bool = depth >= 5 && roll < 96;
    let is_deep_key: bool = depth >= 8;

    transition {
        is_early_dagger -> ItemKind::RustedDagger
        is_early_buckler -> ItemKind::EarlyBuckler
        is_healing_charm -> ItemKind::HealingCharm
        is_ember_blade -> ItemKind::EmberBlade
        is_deep_key -> ItemKind::DeepKey
        _ -> ItemKind::RustedDagger
    }
}
