use omega::language::core::float_operations;

// PASS canary (F5), abort-style: Trapping float division by zero must trap.
// exits: 7 = SAILED PAST the trap.
use omega::language::std::console;
data Main { console: Console; a: f64 in Trapping; z: f64 in Trapping; r: f64 in Trapping; }
machine Main::main(&mut self) {
    self.a = 5.0;
    self.r = self.a / self.z;
    self.console.exit_process(7);
}
