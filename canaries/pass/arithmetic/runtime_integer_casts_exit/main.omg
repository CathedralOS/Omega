// Named integer width/sign conversions -- a classic codegen bug source
// (sign-extend vs zero-extend vs truncate). Locks all four behaviors:
//   - i8(-5)  -> i32  = -5      (SIGN-extend: negative preserved)
//   - u8(200) -> i32  = 200     (ZERO-extend: no spurious sign)
//   - i32(300) -> wrapping u8 = 44 (NARROW: truncate to low 8 bits)
//   - i32(-7) -> i64  = -7      (WIDEN signed)
//   - i16(-1) -> wrapping u16 -> u32 = 65535
// Exits 70.

use omega::language::std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let a8: i8 = -5;
    let aw: i32 in Trapping =
        widen_i8_to_i32(a8) as i32 in Trapping;
    let b8: u8 = 200;
    let bw: i32 in Trapping =
        widen_u8_to_i32(b8) as i32 in Trapping;
    let c32: i32 in Wrapping = 300;
    let cn: u8 = narrow_i32_to_u8_wrapping(c32);
    let d32: i32 in Trapping = -7;
    let dw: i64 in Trapping =
        widen_i32_to_i64(d32) as i64 in Trapping;
    let e16: i16 = -1;
    let eu: u16 = narrow_i16_to_u16_wrapping(e16);
    let ew: u32 in Trapping =
        widen_u16_to_u32(eu) as u32 in Trapping;

    transition aw == -5 { true -> ck2(bw, cn, dw, ew) _ -> bad() }

    state ck2(&mut self, bw: i32 in Trapping, cn: u8, dw: i64 in Trapping, ew: u32 in Trapping) {
        transition bw == 200 { true -> ck3(cn, dw, ew) _ -> bad() }
    }
    state ck3(&mut self, cn: u8, dw: i64 in Trapping, ew: u32 in Trapping) {
        transition cn == 44 { true -> ck4(dw, ew) _ -> bad() }
    }
    state ck4(&mut self, dw: i64 in Trapping, ew: u32 in Trapping) {
        transition dw == -7 { true -> ck5(ew) _ -> bad() }
    }
    state ck5(&mut self, ew: u32 in Trapping) {
        transition ew == 65535 { true -> good() _ -> bad() }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
