// RUN canary (exit 70). #62: constructing a range-refined field from a PROVABLE
// non-literal value (a same-range field) is accepted -- not just integer
// literals. `src.v` has type `i32 [0..=100]`, so `Box { v: src.v }` proves the
// [0..=100] field invariant without a literal. copy_box(Box{v:70}) -> 70.
use omega::language::std::console;
data Box { v: i32 [0..=100]; }
data Main { console: Console; }
machine Main::copy_box(&mut self, src: Box) {
    let copy: Box = Box { v: src.v };
    self.console.exit_process(copy.v);
}
machine Main::main(&mut self) { self.copy_box(Box { v: 70 }); }
