// RUN CANARY (must trap). A Trapping shift checks the count before executing
// the operation, including when the left value is zero.
use omega::language::std::console;
data Main { console: Console; count: u32; }
machine Main::main(&mut self) {
    self.count = 32;
    let value: u32 in Trapping = (0 as u32 in Trapping);
    let shifted: u32 in Trapping = value << self.count;
    let code: i32 = shifted as i32;
    self.console.exit_process(code);
}
