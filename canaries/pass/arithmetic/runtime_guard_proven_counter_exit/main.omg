// THE GUARD-PROVEN COUNTER (the de-Trapping keystone): a state entered only
// through `count < 5` proves `count = count + 1` into the [0..=100] field --
// fully Exact, no overflow domain, no modular idiom. The checker inverts the
// value's folded range to the place's bound, narrows it by the incoming-edge
// guard (all incoming edges must agree), and refolds. The disjoint write to
// `scratch` BEFORE the increment must NOT kill the fact (the render-loop
// shape: `arr[i] = px; i = i + 1`); a prior write to the counter itself or an
// opaque call WOULD (see the fail canary guard_invalidated_by_prior_write).
// Loops 5 times, then asserts the count. Exit 70. Differential.
use omega::language::std::console;
data Main { console: Console; count: i32 [0..=100]; scratch: i32; }
machine Main::main(&mut self) {
    transition { _ -> head() }
    state head(&mut self) {
        transition self.count < 5 { true -> bump() _ -> done() }
    }
    state bump(&mut self) {
        self.scratch = self.count;
        self.count = self.count + 1;
        transition { _ -> head() }
    }
    state done(&mut self) {
        transition self.count == 5 { true -> ok() _ -> bad() }
    }
    state ok(&mut self)  { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
