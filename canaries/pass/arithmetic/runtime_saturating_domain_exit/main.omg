// Saturating arithmetic (decision-17 domain) CLAMPS at the type bounds instead of wrapping --
// the core of Omega's arithmetic-safety model. Checks all four directions and both signednesses:
// u8 add-overflow -> 255, u8 sub-underflow -> 0, u8 mul-overflow -> 255, i8 signed positive
// overflow -> 127, i8 signed negative underflow -> -128 (verified as +128 == 0 to keep the
// observable positive). All self-checked via chained guards. Differential: native == interp.
use omega::language::std::console;
data Main {
    console: Console;
    a: u8 in Saturating;
    b: u8 in Saturating;
    e: u8 in Saturating;
    p: i8 in Saturating;
    n: i8 in Saturating;
    chk: i32 in Wrapping;
}
machine Main::main(&mut self) {
    self.a = 250; self.a = self.a + 10;
    self.b = 5;   self.b = self.b - 10;
    self.e = 200; self.e = self.e * 2;
    self.p = 120; self.p = self.p + 10;
    self.n = 0 - 100; self.n = self.n - 100;
    transition self.a == 255 { true -> cb() _ -> bad() }
    state cb(&mut self) { transition self.b == 0 { true -> ce() _ -> bad() } }
    state ce(&mut self) { transition self.e == 255 { true -> cp() _ -> bad() } }
    state cp(&mut self) { transition self.p == 127 { true -> cn() _ -> bad() } }
    state cn(&mut self) {
        self.chk = self.n as i32;
        self.chk = self.chk + 128;
        transition self.chk == 0 { true -> ok() _ -> bad() }
    }
    state ok(&mut self)  { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
