// Integer width conversions must pick the right extension -- the classic movsx-vs-movzx trap:
//   -1 as i8 then as i32  -> SIGN-extend, stays -1        (a signed narrowing round-trips)
//   -1 as u8 then as i32  -> ZERO-extend, 255            (0xFF read as an unsigned byte)
//   200 as i8 then as i32 -> truncate to -56, sign-extend (200 doesn't fit i8; 0xC8 = -56)
// A wrong extension (zero where sign is needed, or vice versa) would silently corrupt the value.
// Each is chained; exits 70 iff all hold.
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    x: i32 in Wrapping;
    y8: i8 in Wrapping;
    yu8: u8 in Wrapping;
    z: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.x = 0 - 1;
    self.y8 = self.x as i8 in Wrapping;
    self.z = self.y8 as i32 in Wrapping;
    transition self.z == 0 - 1 {
        true -> zero_ext()
        _ -> bad()
    }
    state zero_ext(&mut self) {
        self.x = 0 - 1;
        self.yu8 = self.x as u8 in Wrapping;
        self.z = self.yu8 as i32 in Wrapping;
        transition self.z == 255 {
            true -> trunc()
            _ -> bad()
        }
    }
    state trunc(&mut self) {
        self.x = 200;
        self.y8 = self.x as i8 in Wrapping;
        self.z = self.y8 as i32 in Wrapping;
        transition self.z == 0 - 56 {
            true -> ok()
            _ -> bad()
        }
    }
    state ok(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(self.z); }
}
