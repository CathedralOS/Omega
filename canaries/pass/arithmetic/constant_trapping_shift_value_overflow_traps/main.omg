// RUN CANARY (must trap). Constant folding must preserve the Trapping
// domain's value-overflow behavior: u8 200 << 1 is 400, not wrapped 144.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; value: u8 in Trapping; }

machine Main::main(&mut self) {
    let left: u8 in Trapping = 200;
    self.value = left << 1;
    self.console.exit_process(70);
}
