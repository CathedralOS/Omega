use omega::language::core::numeric_conversion;

data Random {
}

data RandomState {
    seed: u64 in Wrapping;
    calls: UInt;
}

data Reward {
    gold: i32 in Wrapping;
}

data Main {
    rng: Random;
}

machine Random::next_u32(
    &mut self,
    state: &mut RandomState
) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;
    narrow_u64_to_u32_wrapping(state.seed >> 32)
}

machine Random::range(
    &mut self,
    state: &mut RandomState,
    exclusive_max: u32
) -> u32 {
    let raw: u32 = self.next_u32(state);
    raw % exclusive_max
}

machine Main::main(
    &mut self,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.gold = 1 + self.rng.range(random, 5);
}
