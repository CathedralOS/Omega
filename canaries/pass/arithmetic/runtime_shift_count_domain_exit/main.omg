// RUN CANARY (exit 70) + interpreter differential. SHIFT-COUNT domain
// exemption (owner ruling 2026-07-13: "shift overflow is defined by the
// domain on which the operator is happening... lhs domain governs, rhs
// doesn't matter"): a Wrapping lhs shifted by an EXACT count resolves with
// the LHS's domain -- previously the mixed-domain check rejected
// `wrapped << self.k` outright. Legs: << and >> with a runtime Exact count.
// Wrapping counts are masked by the language operand width on every target.
// exits: 71 = << wrong; 72 = >> wrong; 73/74 = masked 32/64 leg wrong.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; k: u32; }
machine Main::main(&mut self) {
    self.k = 3;
    self.build();
}
machine Main::build(&mut self) {
    let a: u32 in Wrapping = (1 as u32 in Wrapping);
    let r: u32 in Wrapping = a << self.k;
    transition r == 8 {
        true -> leg2()
        _ -> wrong_shl()
    }
    state leg2(&mut self) {
        let b: u32 in Wrapping = (64 as u32 in Wrapping);
        let s: u32 in Wrapping = b >> self.k;
        transition s == 8 {
            true -> atwidth32()
            _ -> wrong_shr()
        }
    }
    // Counts are masked at the language width: 40 & 31 = 8 and 70 & 63 = 6.
    state atwidth32(&mut self) {
        let a: u32 in Wrapping = (1 as u32 in Wrapping);
        let c: u32 in Wrapping = (40 as u32 in Wrapping);
        let r: u32 in Wrapping = a << c;
        transition r == 256 {
            true -> atwidth64()
            _ -> wrong_atwidth32()
        }
    }
    state atwidth64(&mut self) {
        let a: u64 in Wrapping = (1 as u64 in Wrapping);
        let c: u64 in Wrapping = (70 as u64 in Wrapping);
        let r: u64 in Wrapping = a << c;
        transition r == 64 {
            true -> good()
            _ -> wrong_atwidth64()
        }
    }
    state good(&mut self)           { self.console.exit_process(70); }
    state wrong_shl(&mut self)      { self.console.exit_process(71); }
    state wrong_shr(&mut self)      { self.console.exit_process(72); }
    state wrong_atwidth32(&mut self){ self.console.exit_process(73); }
    state wrong_atwidth64(&mut self){ self.console.exit_process(74); }
}
