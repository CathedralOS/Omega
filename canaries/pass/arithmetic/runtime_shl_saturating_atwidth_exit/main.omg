// RUN CANARY (exit 70) + interpreter differential. Saturating `<<` by an
// at/above-width count clamps every nonzero x to the saturation bound
// (3u32 << 40 -> u32::MAX) -- the count cap (narrow) / explicit count
// compare (64-bit) on both ISAs, wide-i128 on the interp. Promoted with
// the x86_64 sequences (shift slice C closes).
// exits: 71 = wrapped to 0 (the old native behavior); 72 = neither.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: u32 in Saturating = (3 as u32 in Saturating);
    let c: u32 in Saturating = (40 as u32 in Saturating);
    let s: u32 in Saturating = a << c;
    transition s == 4294967295 {
        true  -> clamped()
        false -> chk_zero()
    }
    state chk_zero(&mut self) {
        transition s == 0 {
            true  -> wrapped()
            false -> bad()
        }
    }
    state clamped(&mut self) { self.console.exit_process(70); }
    state wrapped(&mut self) { self.console.exit_process(71); }
    state bad(&mut self)     { self.console.exit_process(72); }
}
