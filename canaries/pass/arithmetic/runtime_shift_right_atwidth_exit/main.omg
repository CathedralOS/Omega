// RUN CANARY (exit 70) + interpreter differential. Wrapping `>>` masks the
// count by the language operand width. These write and nested-operand legs
// distinguish the rule from the superseded zero/sign-fill behavior and from
// accidentally using the host register width for u32/i32 operations.
//
// The i64 leg uses -(2^62), where the count-masked shift (>> 6 = -(2^56))
// differs from the sign-fill (-1) -- small negatives like -7 mask to -1 by
// coincidence and hide the bug. Operand-position legs nest `(n >> c) + 5`
// so the shift runs on the operand path (node-width op + fix + extension).
// exits: 71 = u32 write; 72 = i32 negative write; 73 = i32 positive write;
// 74 = i64 negative write; 75 = u64 write; 76 = u32 operand; 77 = i32
// negative operand.

boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: u32 in Wrapping = (3000000000 as u32 in Wrapping);
    let c: u32 in Wrapping = (40 as u32 in Wrapping);
    let r: u32 in Wrapping = a >> c;
        transition r == 11718750 {
        true  -> neg32()
        false -> bad_u32_write()
    }
    state neg32(&mut self) {
        let n: i32 in Wrapping = (0 as i32 in Wrapping) - 2;
        let c2: i32 in Wrapping = (40 as i32 in Wrapping);
        let s: i32 in Wrapping = n >> c2;
        transition s == (0 as i32 in Wrapping) - 1 {
            true  -> pos32()
            false -> bad_i32_neg_write()
        }
    }
    state pos32(&mut self) {
        let p: i32 in Wrapping = (2 as i32 in Wrapping);
        let c3: i32 in Wrapping = (40 as i32 in Wrapping);
        let s: i32 in Wrapping = p >> c3;
        transition s == 0 {
            true  -> neg64()
            false -> bad_i32_pos_write()
        }
    }
    state neg64(&mut self) {
        let n: i64 in Wrapping = (0 as i64 in Wrapping) - 4611686018427387904;
        let c4: i64 in Wrapping = (70 as i64 in Wrapping);
        let s: i64 in Wrapping = n >> c4;
        transition s == (0 as i64 in Wrapping) - 72057594037927936 {
            true  -> u64leg()
            false -> bad_i64_neg_write()
        }
    }
    state u64leg(&mut self) {
        let w: u64 in Wrapping = (12345678901 as u64 in Wrapping);
        let c5: u64 in Wrapping = (70 as u64 in Wrapping);
        let q: u64 in Wrapping = w >> c5;
        transition q == 192901232 {
            true  -> operand_u32()
            false -> bad_u64_write()
        }
    }
    state operand_u32(&mut self) {
        let b: u32 in Wrapping = (3000000000 as u32 in Wrapping);
        let c6: u32 in Wrapping = (40 as u32 in Wrapping);
        let r2: u32 in Wrapping = (b >> c6) + 5;
        transition r2 == 11718755 {
            true  -> operand_i32()
            false -> bad_u32_operand()
        }
    }
    state operand_i32(&mut self) {
        let n: i32 in Wrapping = (0 as i32 in Wrapping) - 2;
        let c7: i32 in Wrapping = (40 as i32 in Wrapping);
        let r3: i32 in Wrapping = (n >> c7) + 5;
        transition r3 == 4 {
            true  -> good()
            false -> bad_i32_operand()
        }
    }
    state good(&mut self)              { self.console.exit_process(70); }
    state bad_u32_write(&mut self)     { self.console.exit_process(71); }
    state bad_i32_neg_write(&mut self) { self.console.exit_process(72); }
    state bad_i32_pos_write(&mut self) { self.console.exit_process(73); }
    state bad_i64_neg_write(&mut self) { self.console.exit_process(74); }
    state bad_u64_write(&mut self)     { self.console.exit_process(75); }
    state bad_u32_operand(&mut self)   { self.console.exit_process(76); }
    state bad_i32_operand(&mut self)   { self.console.exit_process(77); }
}
