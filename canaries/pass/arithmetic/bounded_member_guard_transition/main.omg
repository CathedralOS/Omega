data Room {
    exit_count: u32;
}

data Main {
}

machine Main::main(
    &mut self
) {
    let room: Room = Room { exit_count: 1 };

    transition {
        room.exit_count > 0 -> append(room.exit_count)
        _ -> {}
    }

    state append(
        &mut self,
        exit_count: u32
    ) {
    }
}
