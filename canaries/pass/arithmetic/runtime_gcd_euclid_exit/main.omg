// The iterative Euclidean algorithm for the greatest common divisor -- a fundamental
// numeric algorithm, self-checking. Repeatedly `(a, b) = (b, a % b)` until b is 0; the
// remaining a is the gcd. gcd(1071, 462) = 21 (1071,462 -> 462,147 -> 147,21 -> 21,0).
// A two-variable loop with a runtime modulo; no arrays. Exits 70.
use omega::language::std::console;

data Main {
    console: Console;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    t: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.a = 1071;
    self.b = 462;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.b != 0 { true -> reduce() _ -> done() }
    }
    state reduce(&mut self) {
        self.t = self.b;
        self.b = self.a % self.b; // remainder uses the current b (non-zero by the guard)
        self.a = self.t;
        transition { _ -> step() }
    }
    state done(&mut self) {
        transition self.a == 21 { true -> good() _ -> wrong() }
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state wrong(&mut self) {
        self.console.exit_process(self.a as i32); // explicitly erase Wrapping at the host boundary
    }
}
