// Saturating arithmetic applied at the OPERATION node (decision 17): the
// domain rides the operand's DECLARED type, so `a + b` must clamp even when
// the result never lands in a Saturating slot -- here each result feeds its
// COMPARISON directly, so there is no landing-seam coercion at all (the
// sibling runtime_saturating_narrow_add_sub_exit stores results into
// Saturating fields first, which a wide-compute-then-coerce-at-landing model
// also gets right; this canary is what tells the two models apart). Operands
// are FIELDS so the fold never sees them. Natively this exercises the
// OPERAND-POSITION clamp lowering (the register-parametric write-path
// sequences reused under the fused guard compare); the differential oracle
// pins the interpreter's node-level domain application to the same 70.
// (History: parked 2026-07-09c while native fused the plain op -- all four
// overflow directions read unclamped wide values -- behind the
// operand-domain fence; promoted when the lowering landed in both ISAs.)
// Directions: i8 add up (100+50 -> 127), i8 sub down (-100-70 -> -128),
// i8 mul up (64*4 -> 127), 64-bit signed add up (i64::MAX-7 + 100 ->
// i64::MAX -- the flag-based clamp), and an IN-RANGE add stays exact
// (40+2 = 42, no clamp). Exit 70.
use omega::language::std::console;

data Main {
    console: Console;
    a8: i8 in Saturating;
    b8: i8 in Saturating;
    big: i64 in Saturating;
    inc: i64 in Saturating;
}

machine Main::main(&mut self) {
    // i8 add overflow, compared directly: 100 + 50 = 150 -> clamp to 127.
    self.a8 = 100;
    self.b8 = 50;
    transition (self.a8 + self.b8 == 127) { true -> sub_down() _ -> bad() }

    state sub_down(&mut self) {
        // i8 sub underflow: -100 - 70 = -170 -> clamp to -128.
        self.a8 = 0 - 100;
        self.b8 = 70;
        transition (self.a8 - self.b8 == 0 - 128) { true -> mul_up() _ -> bad() }
    }
    state mul_up(&mut self) {
        // i8 mul overflow: 64 * 4 = 256 -> clamp to 127.
        self.a8 = 64;
        self.b8 = 4;
        transition (self.a8 * self.b8 == 127) { true -> wide_up() _ -> bad() }
    }
    state wide_up(&mut self) {
        // i64 add overflow at the real boundary: (MAX-7) + 100 -> MAX.
        self.big = 9223372036854775800;
        self.inc = 100;
        transition (self.big + self.inc == 9223372036854775807) { true -> in_range() _ -> bad() }
    }
    state in_range(&mut self) {
        // An IN-RANGE saturating add stays exact: 40 + 2 = 42 (no clamp).
        self.a8 = 40;
        self.b8 = 2;
        transition (self.a8 + self.b8 == 42) { true -> good() _ -> bad() }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
