library TestHost = "TestHost.dylib" calling_convention c {
    fn host_write(fd: i32, count: usize) -> i32
        symbol "_host_write"
        trust omega_test_host_write
}

library "AnonymousHost.dylib" calling_convention c {
    fn host_tick() -> i32
        trust host
}

trust omega_test_host_write {
    owner test
}

machine main {
    pub entry() {
    }
}
