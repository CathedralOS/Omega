platform Console {
    entry write_line(text: String);
    entry exit_process(return_code: i32);
}

data main {
    console: Console;
    return_code: i32 = 1;
}

machine main(&mut self) {
    self.console.write_line("assign");
    self.return_code = 0;
    self.console.exit_process(self.return_code);
}
