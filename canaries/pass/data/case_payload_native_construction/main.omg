// Case payload CONSTRUCTION lowers natively: `Command::Move { steps: 70 }`
// writes the i32 case tag at offset 0 and the payload field at its packed
// offset, the transition arm compares ONLY the 4-byte tag (tag-only equality,
// so payload bytes never affect the match), and the destructured `steps`
// binding reads the payload member back out as the target state's argument.
// Exits 70 when construction, tag dispatch, and the payload read all work.

use omega::language::std::console;

data Command {
    case None;
    case Quit;
    case Move(steps: i32);
}

data Main {
    console: Console;
    cmd: Command;
}

machine Main::main(&mut self) {
    self.cmd = Command::Move { steps: 70 };

    transition self.cmd {
        Command::Move { steps } -> done(steps)
        _ -> bad()
    }

    state done(&mut self, steps: i32) {
        self.console.exit_process(steps);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
