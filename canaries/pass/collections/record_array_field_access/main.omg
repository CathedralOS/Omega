domain [u8]::Utf8 when valid_utf8(self) {
}

data CellId {
    case Empty;
    case A1;
    case A2;
}

data Exit {
    command: &[u8] in Utf8;
    destination: CellId;
}

data Room {
    cell: CellId;
    label: &[u8] in Utf8;
    description: &[u8] in Utf8;
    exits: [Exit; 2];
}

boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    room: Room;
    selected_exit: Exit;
}

machine Main::main(&mut self) -> i32 {
    self.room.cell = CellId::A1;
    self.room.label = "A1";
    self.room.description = "A1: a stone entry.";
    self.room.exits[0] = Exit { command: "north", destination: CellId::A2 };
    self.room.exits[1] = Exit { command: "wait", destination: CellId::Empty };
    self.selected_exit = self.room.exits[0];

    self.console.write_line(self.room.label);
    self.console.write_line(self.room.description);
    self.console.write_line(self.selected_exit.command);
    self.console.exit_process(0);
    0
}