// Inline LOCAL array writes at a machine-field runtime index with 8-byte
// elements. The target frame base stays distinct while a copied source can
// reuse the index's machine base; immediate, binary, and conversion writes use
// that same index relocation independently. A string-descriptor field write
// exercises the same cross-region address shape with a data-object relocation;
// owned-carrier write plus direct-source and literal appends cover the carrier
// mutation family at that target too, and a mutable reference materializes the
// exact element address through the same cross-region index before updating it.
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;
data Room {
    description: &[u8] in Utf8;
}
data Label {
    text: [u8; 8] in Utf8;
}
data Main {
    console: Console;
    index: u64 [0..=2];
    value: i64;
    left: i64 [0..=50];
    right: i64 [0..=50];
    source: i64 [0..=100];
    prefix: [u8; 8] in Utf8;
}
machine Main::main(&mut self) {
    self.index = 2;
    self.value = 44;
    self.left = 20;
    self.right = 30;
    self.source = 61;
    self.prefix = "ome";
    transition { _ -> self.pick() }
}
machine Main::pick(&mut self) {
    let a: [i64; 3] = [11, 22, 33];
    a[self.index] = self.value;
    let b: [i64; 3] = [1, 2, 3];
    b[self.index] = 55;
    let c: [i64; 3] = [4, 5, 6];
    c[self.index] = self.left + self.right;
    let d: [i32; 3] = [7, 8, 9];
    d[self.index] = self.source as i32;
    let rooms: [Room; 3] = [
        Room { description: "first" },
        Room { description: "second" },
        Room { description: "old" }
    ];
    rooms[self.index].description = "omega";
    let labels: [Label; 3] = [
        Label { text: "one" },
        Label { text: "two" },
        Label { text: "old" }
    ];
    labels[self.index].text = "omega";
    labels[self.index].text = self.prefix + "ga";
    let v: i64 = a[2];
    let w: i64 = b[2];
    let x: i64 = c[2];
    let y: i32 = d[2];
    let selected: &mut Label = &mut labels[self.index];
    selected.text = "proof";
    transition v == 44 && w == 55 && x == 50 && y == 61 && rooms[2].description == "omega" && labels[2].text == "proof" {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
