// Inline LOCAL array read at a runtime (param) index with 8-byte elements
// (`let a: [i64; 3] = [...]; a[k]`). a=[11,22,33], k=2 -> 33 -> exit 1.
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
}
machine Main::main(&mut self) {
    transition { _ -> self.pick(2) }
}
machine Main::pick(&mut self, k: u64 [0..=2]) {
    let a: [i64; 3] = [11, 22, 33];
    let v: i64 = a[k];
    transition v == 33 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
