// BOTH-RUNTIME double-indexed WRITES (`grid[i][j] = v`, both indices
// runtime): CopyRuntimeStorageToRuntimeMachineDoubleIndexed (place source,
// the value loaded into r14 BEFORE the base register is biased) +
// WriteRuntimeMachineDoubleIndexedInteger (const value). Faces: const value,
// machine-place source, frame-place source with frame indices, and a
// double-indexed read-back -- neighbor-clobber validated throughout.
// Direct RMW (`grid[i][j] = grid[i][j] + 1`) stays a LOUD error (binary
// value into a double-indexed target); the let-temp idiom works.
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
    grid: [[i32; 4]; 3];
    i: u64 [0..=2];
    j: u64 [0..=3];
    v: i32;
    got: i32;
}
machine Main::main(&mut self) {
    self.grid[1][3] = 9;
    self.i = 1;
    self.j = 2;
    self.grid[self.i][self.j] = 70;
    self.got = self.grid[1][2];
    transition self.got == 70 {
        true -> neighbor()
        false -> no()
    }
    state neighbor(&mut self) {
        self.got = self.grid[1][3];
        transition self.got == 9 {
            true -> place_source()
            false -> no()
        }
    }
    state place_source(&mut self) {
        self.v = 55;
        self.grid[self.i][self.j] = self.v;
        self.got = self.grid[1][2];
        transition self.got == 55 {
            true -> frame_source(33, 2, 0)
            false -> no()
        }
    }
    state frame_source(&mut self, fv: i32, fi: u64 [0..=2], fj: u64 [0..=3]) {
        self.grid[fi][fj] = fv;
        self.got = self.grid[2][0];
        transition self.got == 33 {
            true -> read_back()
            false -> no()
        }
    }
    state read_back(&mut self) {
        self.got = self.grid[self.i][self.j];
        transition self.got == 55 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
