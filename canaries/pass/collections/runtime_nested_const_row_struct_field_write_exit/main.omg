// CONST-element + RUNTIME-leaf struct-field array WRITE
// (`rows[2].data[j] = 77`, j runtime): used to be fenced (and before that a
// silent no-op / wrong-element write -- the root element index was applied
// AFTER the suffix walk at the LEAF's scale, so rows[2].data resolved to
// rows+2*4 instead of rows+2*8). Validates the written element AND both
// neighbors AND another row (adjacent-clobber check). Exit 1 on success.
use omega::language::std::console;
data Row {
    data: [i32; 2];
}
data Main {
    console: Console;
    rows: [Row; 3];
    j: u64 [0..=1];
    got: i32;
}
machine Main::main(&mut self) {
    self.rows[0].data[0] = 10;
    self.rows[0].data[1] = 11;
    self.rows[2].data[0] = 50;
    self.rows[2].data[1] = 60;
    self.j = 1;
    self.rows[2].data[self.j] = 77;
    self.got = self.rows[2].data[1];
    transition self.got == 77 {
        true -> check_neighbor()
        false -> no()
    }
    state check_neighbor(&mut self) {
        self.got = self.rows[2].data[0];
        transition self.got == 50 {
            true -> check_other_row()
            false -> no()
        }
    }
    state check_other_row(&mut self) {
        self.got = self.rows[0].data[1];
        transition self.got == 11 {
            true -> read_back()
            false -> no()
        }
    }
    state read_back(&mut self) {
        let picked: i32 = self.rows[2].data[self.j];
        transition picked == 77 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
