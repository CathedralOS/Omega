// Array REDUCTION with a runtime index: `self.sum = self.sum + self.arr[self.i]` in a loop --
// an indexed read as an accumulation operand (a value operand, enabled by gap #2's machine-indexed
// operand support). The fundamental sum/reduce primitive. Sums [5,10,15,20,8,12] = 70. The index
// bound is proven by the loop guard. Differential: native == interp.
use omega::language::std::console;
data Main { console: Console; arr: [i32 in Wrapping; 6]; i: i32 in Wrapping; sum: i32 in Wrapping; }
machine Main::main(&mut self) {
    self.arr[0] = 5; self.arr[1] = 10; self.arr[2] = 15; self.arr[3] = 20; self.arr[4] = 8; self.arr[5] = 12;
    self.sum = 0;
    self.i = 0;
    transition { _ -> loop() }
    state loop(&mut self) {
        transition self.i < 6 { true -> add() _ -> done() }
    }
    state add(&mut self) {
        self.sum = self.sum + self.arr[self.i];
        self.i = self.i + 1;
        transition { _ -> loop() }
    }
    state done(&mut self) { self.console.exit_process(self.sum as i32); }
}
