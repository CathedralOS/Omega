// PROBE (uncharacterized): a guard comparing runtime-indexed reads from TWO
// DIFFERENT arrays -- `a[i] < b[j]`. The same-array shape is verified
// (runtime_dual_indexed_guard_compare_exit); cross-array puts TWO distinct
// machine bases plus two runtime indices into one guard, which the same-array
// case does not stress. Whether that is correct, fenced, or silent was unknown.
// a = [10, 20, 30, 40], b = [1, 2, 3, 4], i = 1 (a[i] = 20), j = 3 (b[j] = 4).
// a[i] < b[j] is 20 < 4 = FALSE; the reverse b[j] < a[i] is 4 < 20 = TRUE.
// Both directions correct -> exit 70; any base/index confusion -> exit 71.
use omega::language::std::console;
data Main {
    console: Console;
    a: [i32; 4];
    b: [i32; 4];
    i: i32 [0..=3];
    j: i32 [0..=3];
}
machine Main::main(&mut self) {
    self.a[0] = 10;
    self.a[1] = 20;
    self.a[2] = 30;
    self.a[3] = 40;
    self.b[0] = 1;
    self.b[1] = 2;
    self.b[2] = 3;
    self.b[3] = 4;
    self.i = 1;
    self.j = 3;

    // Forward: a[i]=20 < b[j]=4 must be FALSE.
    transition self.a[self.i] < self.b[self.j] {
        true -> bad()
        false -> check_reverse()
    }

    // Reverse: b[j]=4 < a[i]=20 must be TRUE (re-establish flow constants so the
    // sub-state proves the index bounds).
    state check_reverse(&mut self) {
        self.i = 1;
        self.j = 3;
        transition self.b[self.j] < self.a[self.i] {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
