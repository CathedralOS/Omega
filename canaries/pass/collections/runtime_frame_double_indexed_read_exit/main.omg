// FRAME-resident 2D arrays, both-runtime reads and binary writes
// (CopyRuntimeFrameBaseDoubleIndexedToRuntimeStorage and the canonical
// all-frame double-indexed CopyPlaces target + WritePlaceConvert +
// WritePlaceInteger + WritePlaceBinary + WritePlaceAddress):
// local arrays in entry
// and PARAM states via LET consumers, the MACHINE-FIELD target face
// (`self.got = g2[a][b]` -- the tree route, which needs the aggregate slot
// kept for assignment-value consumers AND the selection-layer alias guard:
// an aggregate-literal alias must not substitute into an indexed collection
// position, the third fold layer), and a by-value param array through a
// value machine. An all-frame nested record array also writes a string
// descriptor through both runtime indices. All value-validated.
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;
data Room { description: &[u8] in Utf8; }
data Label { text: [u8; 8] in Utf8; }
data Triple { first: i32; second: i32; third: i32; }
data Main { console: Console; got: i32; }
machine Main::pick(&self, m: [[i32; 3]; 2], i: u64 [0..=1], j: u64 [0..=2]) -> i32 {
    transition { _ -> (m[i][j]) }
}
machine Main::main(&mut self) {
    transition { _ -> let_face(1, 2, 70) }
    state let_face(&mut self, i: u64 [0..=1], j: u64 [0..=2], wide: i64) {
        let g: [[i32 in Wrapping; 3]; 2] = [[1, 2, 3], [4, 5, 6]];
        self.got = 5;
        g[i][j] = self.got;
        g[i][j] = wide as i32 in Wrapping;
        g[i][j] = 6;
        g[i][j] = g[i][j] + 1;
        let selected: &mut i32 in Wrapping = &mut g[i][j];
        selected = 8;
        let picked: i32 in Wrapping = g[i][j];
        let rooms: [[Room; 3]; 2] = [
            [Room { description: "a" }, Room { description: "b" }, Room { description: "c" }],
            [Room { description: "d" }, Room { description: "e" }, Room { description: "old" }]
        ];
        let suffix_room: Room;
        suffix_room.description = "meg";
        rooms[i][j].description = "o" + suffix_room.description + "a";
        let labels: [[Label; 3]; 2] = [
            [Label { text: "a" }, Label { text: "b" }, Label { text: "c" }],
            [Label { text: "d" }, Label { text: "e" }, Label { text: "old" }]
        ];
        let suffix: Label;
        suffix.text = "ga";
        labels[i][j].text = "o";
        labels[i][j].text = labels[i][j].text + "me";
        labels[i][j].text = labels[i][j].text + suffix.text;
        let triples: [[Triple; 3]; 2] = [
            [Triple { first: 1, second: 2, third: 3 }, Triple { first: 4, second: 5, third: 6 }, Triple { first: 7, second: 8, third: 9 }],
            [Triple { first: 11, second: 12, third: 13 }, Triple { first: 14, second: 15, third: 16 }, Triple { first: 17, second: 18, third: 19 }]
        ];
        let replacement: Triple = Triple { first: 10, second: 20, third: 30 };
        triples[i][j] = replacement;
        let copied: Triple = triples[i][j];
        transition picked == 8 && rooms[1][2].description == "omega" && labels[1][2].text == "omega" && copied.first == 10 && copied.second == 20 && copied.third == 30 {
            true -> machine_target()
            false -> no()
        }
    }
    state machine_target(&mut self) {
        transition { _ -> machine_target_go(0, 1) }
    }
    state machine_target_go(&mut self, a: u64 [0..=1], b: u64 [0..=2]) {
        let g2: [[i32; 3]; 2] = [[9, 8, 7], [6, 5, 4]];
        self.got = g2[a][b];
        transition self.got == 8 {
            true -> param_face()
            false -> no()
        }
    }
    state param_face(&mut self) {
        let m: [[i32; 3]; 2] = [[10, 20, 30], [40, 50, 60]];
        let pv: i32 = self.pick(m, 1, 0);
        transition pv == 40 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
