// Binary search over a sorted array -- a fundamental algorithm, self-checking. Searching
// for 50 in [10,20,30,40,50,60,70] narrows in BOTH directions: mid=3 (arr=40<50 -> lo=4),
// mid=5 (arr=60>50 -> hi=4), mid=4 (arr=50, found). It exercises the computed midpoint
// `(lo+hi)/2` (into a field, then a plain-index read), the indexed read into a field (a
// direct `arr[mid]==target` guard is the separate indexed-guard gap), and both pointer
// updates (`lo=mid+1`, `hi=mid-1`). Exits 70 only when 50 is found at exactly index 4.
use omega::language::std::console;

data Main {
    console: Console;
    arr: [i32; 7] in Trapping;
    target: i32 in Trapping;
    lo: i32 in Trapping;
    hi: i32 in Trapping;
    mid: i32 in Trapping;
    v: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.arr = [10, 20, 30, 40, 50, 60, 70];
    self.target = 50;
    self.lo = 0;
    self.hi = 6;
    transition { _ -> search() }

    state search(&mut self) {
        transition self.lo <= self.hi { true -> mid_calc() _ -> not_found() }
    }
    state mid_calc(&mut self) {
        self.mid = (self.lo + self.hi) / 2;
        transition self.mid >= 0 && self.mid < 7 { true -> read_mid() _ -> bad() }
    }
    state read_mid(&mut self) {
        self.v = self.arr[self.mid];
        transition self.v == self.target { true -> found() _ -> compare() }
    }
    state compare(&mut self) {
        transition self.v < self.target { true -> go_right() _ -> go_left() }
    }
    state go_right(&mut self) {
        self.lo = self.mid + 1;
        transition { _ -> search() }
    }
    state go_left(&mut self) {
        self.hi = self.mid - 1;
        transition { _ -> search() }
    }

    state found(&mut self) {
        transition self.mid == 4 { true -> good() _ -> wrong() }
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state wrong(&mut self) {
        self.console.exit_process(71); // found, but at the wrong index
    }
    state not_found(&mut self) {
        self.console.exit_process(72); // failed to find a present element
    }
    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
