// DUAL-indexed copies with BOTH indices FRAME-resident params. The machine
// array (`self.arr[k] = self.arr[j]`) retains its independent machine roots;
// the local aggregate array shares one frame root across both array walks and
// every frame-held index, plus one machine root when either index is
// `self.index`. Whole-Triple values also cross
// a frame-held pointee in both directions while the array, index, and pointer
// slot retain that one frame root, then repeat with the index in machine
// storage and its exact second root.
use omega::language::std::console;
data Triple { first: i32; second: i32; third: i32; }
data Main {
    console: Console;
    arr: [i32; 4];
    index: u64 [0..=3];
}
machine Main::main(&mut self) {
    self.arr[1] = 77;
    self.index = 2;
    transition { _ -> self.copy_elem(3, 1) }
}
machine Main::copy_elem(&mut self, k: u64 [0..=3], j: u64 [0..=3]) {
    let local: [Triple; 4] = [
        Triple { first: 1, second: 2, third: 3 },
        Triple { first: 10, second: 20, third: 30 },
        Triple { first: 4, second: 5, third: 6 },
        Triple { first: 7, second: 8, third: 9 }
    ];
    let source: [Triple; 4] = [
        Triple { first: 31, second: 32, third: 33 },
        Triple { first: 40, second: 50, third: 60 },
        Triple { first: 34, second: 35, third: 36 },
        Triple { first: 37, second: 38, third: 39 }
    ];
    let target: [Triple; 4] = [
        Triple { first: 71, second: 72, third: 73 },
        Triple { first: 74, second: 75, third: 76 },
        Triple { first: 77, second: 78, third: 79 },
        Triple { first: 80, second: 81, third: 82 }
    ];
    local[k] = local[j];
    local[self.index] = local[j];
    local[k] = local[self.index];
    let selected: &mut Triple = &mut target[k];
    selected = source[j];
    let reverse: &mut Triple = &mut source[k];
    reverse = Triple { first: 90, second: 91, third: 92 };
    target[j] = reverse;
    let cross_selected: &mut Triple = &mut target[k];
    cross_selected = source[self.index];
    let cross_reverse: &mut Triple = &mut source[k];
    cross_reverse = Triple { first: 100, second: 101, third: 102 };
    target[self.index] = cross_reverse;
    self.arr[k] = self.arr[j];
    transition self.arr[3] == 77 && local[2].first == 10 && local[2].second == 20 && local[2].third == 30 && local[3].first == 10 && local[3].second == 20 && local[3].third == 30 && target[3].first == 34 && target[3].second == 35 && target[3].third == 36 && target[1].first == 90 && target[1].second == 91 && target[1].third == 92 && target[2].first == 100 && target[2].second == 101 && target[2].third == 102 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
