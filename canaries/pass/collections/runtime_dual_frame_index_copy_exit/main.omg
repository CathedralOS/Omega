// DUAL-indexed copy with BOTH indices FRAME-resident params
// (`self.arr[k] = self.arr[j]`): used to be a clean encoder error. Each side
// now loads its index off its own frame-base relocation. arr[3]=arr[1]=77 -> 1.
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
    arr: [i32; 4];
}
machine Main::main(&mut self) {
    self.arr[1] = 77;
    transition { _ -> self.copy_elem(3, 1) }
}
machine Main::copy_elem(&mut self, k: u64 [0..=3], j: u64 [0..=3]) {
    self.arr[k] = self.arr[j];
    transition self.arr[3] == 77 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
