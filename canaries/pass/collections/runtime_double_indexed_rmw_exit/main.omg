// DIRECT RMW on both-runtime nested targets: `grid[i][j] = grid[i][j] + 1`
// (WriteRuntimeMachineDoubleIndexedBinary -- the assignment-value hoist slots
// the RHS read, so left/right ride the ordinary operand machinery) and the
// member-between flavor `rows[i].data[j] += 1`. Also pins the STALE-FOLD fix:
// the const write `grid[1][2] = 41` used to keep its fold PAST the RMW (the
// invalidation key embedded the runtime index -- "grid[self.i]" never
// prefixes "grid[1][2]"), so the final read folded to 41; nested_place_key
// now stops the prefix BELOW the outermost runtime-indexed level. And the
// hoist-temp typing walks interleaved Indexed/Member chains (rows[i].data[j]
// minted an untypeable Unit temp before).
use omega::language::std::console;
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
data Main {
    console: Console;
    grid: [[i32 in Wrapping; 4]; 3];
    rows: [Row; 3];
    i: u64 [0..=2];
    j: u64 [0..=3];
    rj: u64 [0..=1];
    got: i32 in Wrapping;
}
machine Main::main(&mut self) {
    self.grid[1][2] = 41;
    self.i = 1;
    self.j = 2;
    self.grid[self.i][self.j] = self.grid[self.i][self.j] + 1;
    self.got = self.grid[1][2];
    transition self.got == 42 {
        true -> member_rmw()
        false -> no()
    }
    state member_rmw(&mut self) {
        self.rows[2].data[1] = 41;
        self.rows[2].tag = 7;
        self.i = 2;
        self.rj = 1;
        self.rows[self.i].data[self.rj] = self.rows[self.i].data[self.rj] + 1;
        self.got = self.rows[2].data[1] + self.rows[2].tag;
        transition self.got == 49 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
