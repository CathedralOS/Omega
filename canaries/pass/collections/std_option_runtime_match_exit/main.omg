// The std `Optional<T>` works at runtime for presence/absence matching and
// payload extraction. `b` is never written: its all-zero home representation
// must dispatch as None.
use omega::language::core::option;
use omega::language::std::console;

data Main {
    console: Console;
    a: Optional<i32>;
    b: Optional<i32>;
}

machine Main::main(&mut self) {
    self.a = Optional::Some { value: 70 };
    transition self.a {
        Optional::Some { value } -> check_b(value)
        Optional::None -> bad()
    }
    state check_b(&mut self, value: i32) {
        transition self.b {
            Optional::Some { value } -> bad()
            Optional::None -> ok(value)
        }
    }
    state ok(&mut self, value: i32) { self.console.exit_process(value); }
    state bad(&mut self) { self.console.exit_process(71); }
}
