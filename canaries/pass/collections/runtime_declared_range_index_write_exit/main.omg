// The WRITE face of the declared-range index proof: `self.arr[self.i] = 30`
// with `i: u64 [0..=4]` and no dominating guard. The ZII i=0 writes arr[0];
// the read-back confirms -> exit 30.
use omega::language::std::console;

data Main {
    console: Console;
    arr: [i32; 5];
    i: u64 [0..=4];
}

machine Main::main(&mut self) {
    transition { _ -> write() }

    state write(&mut self) {
        self.arr[self.i] = 30;
        transition self.arr[0] == 30 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(30); }
    state unmatched(&mut self) { self.console.exit_process(0); }
}
