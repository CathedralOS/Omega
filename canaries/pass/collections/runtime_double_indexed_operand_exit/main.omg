// A both-runtime nested read as a BINARY OPERAND (`grid[i][j] + 5`): the
// operand hoist mints the temp and infer_hoist_temp_type descends one
// element level per Indexed layer (nested collections used to yield an
// untypeable Unit temp). 37 + 5 = 42 -> exit 1.
use omega::language::std::console;
data Main {
    console: Console;
    grid: [[i32 in Wrapping; 4]; 3];
    i: u64 [0..=2];
    j: u64 [0..=3];
    got: i32 in Wrapping;
}
machine Main::main(&mut self) {
    self.grid[1][2] = 37;
    self.i = 1;
    self.j = 2;
    self.got = self.grid[self.i][self.j] + 5;
    transition self.got == 42 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
