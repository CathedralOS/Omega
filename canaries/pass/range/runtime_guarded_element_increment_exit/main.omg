// The accumulate-into-array keystone: `tallies: [i32 [0..=16]; 4]` with the
// dominating guard `tallies[1] < 16` proves the element increment
// `tallies[1] = tallies[1] + 1` (guard fact + element range + the write
// obligation compose). Needed the structural matcher to compare INDEXED
// places (collection + index, literal leaves by value). The stability gate
// carries: an intervening write into the collection drops the fact (fail
// twin). RUNTIME-index increments stay conservatively rejected for now -- the
// operand hoist renames the element read (`__hoist_N`), so the guard cannot
// match it (documented follow-up). ZII tallies[1]=0 -> +1 -> exit 1.
use omega::language::std::console;
data Main {
    console: Console;
    tallies: [i32 [0..=16]; 4];
}
machine Main::main(&mut self) {
    transition self.tallies[1] < 16 {
        true -> bump()
        false -> full()
    }
    state bump(&mut self) {
        self.tallies[1] = self.tallies[1] + 1;
        transition self.tallies[1] == 1 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(1); }
    state unmatched(&mut self) { self.console.exit_process(9); }
    state full(&mut self) { self.console.exit_process(8); }
}
