domain [u8]::Utf8 when valid_utf8(self) {
}

boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    return_code: i32 = 1;
}

machine Main::main(&mut self) {
    self.console.write_line("assign");
    self.return_code = 0;
    self.console.exit_process(self.return_code);
}