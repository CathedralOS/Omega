// Closed-artifact dyn dispatch via devirtualization. This call site has one
// statically known realization, so it does not need to materialize the runtime
// descriptor/table used by pass-through or escaping dynamic values. Here only
// Circle satisfies Shape, so `s.code()` through `&mut dyn Shape` dispatches to
// Circle::code() == 99, the guard takes `good`, and it exits 70. (Previously dyn
// dispatch returned 0.)
use omega::language::std::console;

trait Shape {
    machine code(&mut self) -> i32;
}

data Circle {}

machine Circle::code(&mut self) -> i32 {
    transition {
        _ -> 99
    }
}

Circle satisfies Shape;

data Main {
    console: Console;
    c: Circle;
}

machine Main::main(&mut self) {
    let n: i32 = self.dispatch(&mut self.c);
    transition n == 99 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::dispatch(&mut self, s: &mut dyn Shape) -> i32 {
    s.code()
}
