// The two-impl dyn dispatch with the CALL ORDER swapped: Square (4) first, then
// Circle (9), so n == 4 * 10 + 9 == 49 -> exit 70. A dispatcher that always
// picks the lexically-first impl scores 99 on this program and 99 on the
// unswapped one -- it cannot pass both. Mirrors the interpreter coverage test
// dyn_two_impl_dispatch_swapped_order.
use omega::language::std::console;

trait Shape {
    machine code(&mut self) -> i32;
}

data Circle {}

machine Circle::code(&mut self) -> i32 {
    transition {
        _ -> 9
    }
}

data Square {}

machine Square::code(&mut self) -> i32 {
    transition {
        _ -> 4
    }
}

CircleShape: Circle satisfies Shape {
    Shape::code = Circle::code;
}
SquareShape: Square satisfies Shape {
    Shape::code = Square::code;
}

data Main {
    console: Console;
    c: Circle;
    q: Square;
}

machine Main::main(&mut self) {
    let a: i32 in Wrapping = self.dispatch(&mut self.q);
    let b: i32 in Wrapping = self.dispatch(&mut self.c);
    let n: i32 in Wrapping = a * 10 + b;
    transition n == 49 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::dispatch(&mut self, s: &mut dyn Shape) -> i32 {
    s.code()
}
