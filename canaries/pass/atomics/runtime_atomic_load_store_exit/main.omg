// RUN canary (ch17 "Atomics" / concurrency stage 1, M2): AtomicU32 store then
// load round-trips correctly. `store(value, Relaxed)` writes the value;
// `load(Relaxed)` reads it back. On x86_64 this Relaxed pair lowers to plain
// aligned `mov`; the ordering validator separately rejects operation/order
// combinations that have no meaning. Exact SeqCst store realization remains a
// documented lowering frontier (`xchg` or an equivalent sequence).
//
// Guard ladder: load result matches stored value (exit 70), or exits 71
// on mismatch (should never fire on a correct implementation).

use omega::language::std::console;

data Main {
    console: Console;
    counter: AtomicU32;
}

machine Main::main(&mut self) {
    self.counter.store(42, Relaxed);
    let v: u32 = self.counter.load(Relaxed);

    transition v == 42 {
        true -> good()
        false -> bad()
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
