// R5 multi-state inferred transition frame: a cycle that forwards every state
// parameter at the same ordinal writes only `self.touched`. The caller
// therefore retains its exact fact for disjoint `self.stable`.
data Main {
    stable: u32;
    touched: u32;
    result: u32;
}

machine Main::main(&mut self) {
    self.stable = 5;
    self.cycle_touch(self.stable);
    self.result = self.stable + 1;
}

machine Main::cycle_touch(&mut self, carried: u32) {
    transition { _ -> first(carried) }

    state first(&mut self, carried: u32) {
        self.touched = 1;
        transition { _ -> second(carried) }
    }

    state second(&mut self, carried: u32) {
        transition self.touched == 0 {
            true -> first(carried)
            false -> done()
        }
    }

    state done(&mut self) { }
}
