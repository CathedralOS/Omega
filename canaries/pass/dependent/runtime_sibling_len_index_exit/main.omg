// RUN CANARY (exit 7) + interpreter differential. Chapter 12's headline
// Buffer::get shape: `state read(&mut self, items: &[u8], index: u64
// [0..items.len])` -- the bound names a SIBLING parameter's slice length.
// The caller proves each entry on its arm (`self.j < view.len`; the
// sibling-length proof atom resolves the sibling's ARGUMENT at plan-build
// time and the guard route matches `<arg> < <sibling-arg>.len` by display
// spelling); inside the callee the STRICT bound mints the
// unknown-length prover's prove_index fact, so `items[index]` indexes
// with NO guard. Unguarded callers and unknown/non-slice sibling names
// refuse (fail siblings). Slice views are immutable, so the length
// needs no write fence.
use omega::language::std::console;
data Main { console: Console; buf: [u8; 8]; j: u64; out: i32; }
machine Main::main(&mut self) {
    self.buf[5] = 7;
    self.j = 5;
    let view: &[u8] = self.buf.as_slice();
    transition self.j < view.len { true -> read(view, self.j) _ -> bad() }
    state read(&mut self, items: &[u8], index: u64 [0..items.len]) {
        self.out = items[index] as i32;
        self.console.exit_process(self.out);
    }
    state bad(&mut self) { self.console.exit_process(9); }
}
