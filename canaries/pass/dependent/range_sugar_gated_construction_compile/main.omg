// COMPILE CANARY. A field range is default-domain sugar: excluding zero gates
// the record, and an explicit in-range initializer establishes it.
boundary trait Console { machine exit_process(return_code: i32); }
data Player { health: i32 [1..=100]; score: i32; }
data Main { console: Console; }
machine Main::run(&mut self) {
    let player: Player = Player { health: 50 };
    self.console.exit_process(70);
}
