// R5 value-rebinding boundary: a reachable multi-state cycle may rebind a
// by-value scalar parameter because that value cannot redirect caller-visible
// writes. The exact inferred frame still contains only `self.touched`, so the
// caller retains its disjoint fact for `self.stable`.
data Main {
    stable: u32;
    touched: u32;
    result: u32;
}

machine Main::main(&mut self) {
    self.stable = 5;
    self.cycle_touch(self.stable);
    self.result = self.stable + 1;
}

machine Main::cycle_touch(&mut self, carried: u32) {
    transition { _ -> first(carried) }

    state first(&mut self, carried: u32) {
        self.touched = 1;
        transition { _ -> second(carried) }
    }

    state second(&mut self, carried: u32) {
        transition self.touched == 0 {
            true -> first(self.touched)
            false -> done()
        }
    }

    state done(&mut self) { }
}
