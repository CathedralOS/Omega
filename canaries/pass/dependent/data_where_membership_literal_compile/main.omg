// COMPILE CANARY. A byte-predicate membership fact participates in a data
// default domain: the literal's bytes establish the otherwise zero-invalid
// NonEmpty gate at construction.
domain [u8]::NonEmpty
requires
    non_empty(self);
data Message
where
    text in NonEmpty,
{
    text: &[u8];
}

data Main {
}

machine Main::main(&mut self) {
    let message: Message = Message { text: "omega" };
}
