// R5 shared proof frame: i's dependent atom speaks of self.count at this
// state's entry. A known sibling call writes only self.other, so forwarding i
// into the same dependent parameter remains sound.
data Main {
    count: u32;
    other: u32;
    input: u32;
}

machine Main::main(&mut self) {
    transition self.input <= self.count { true -> forward(self.input) _ -> done() }

    state forward(&mut self, i: u32 [0..=self.count]) {
        self.touch_other();
        self.consume(i);
    }

    state done(&mut self) { }
}

machine Main::touch_other(&mut self) {
    self.other = 1;
}

machine Main::consume(&mut self, value: u32 [0..=self.count]) { }
