// RUN CANARY (exit 70). Machine-owned gated data starts as inaccessible zeroed
// storage; assigning the witness establishes it before the boundary call.
use omega::language::std::console;
data Main
where
    health >= 1,
{
    console: Console;
    health: i32;
}
machine Main::main(&mut self) {
    self.health = 70;
    self.console.exit_process(self.health);
}
