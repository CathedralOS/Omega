// RUN CANARY (exit 70). A zero-valid default-domain bound is standing in every
// state of the attached machine and discharges exact arithmetic on its field.
use omega::language::std::console;
data Main
where
    value <= 60,
{
    console: Console;
    value: i32;
}
machine Main::main(&mut self) {
    let return_code: i32 = 70 + self.value;
    self.console.exit_process(return_code);
}
