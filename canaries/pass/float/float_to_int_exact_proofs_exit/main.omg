use omega::language::core::float_operations;

// F4: Exact float-to-int accepts a declared finite range and a sole incoming
// guard that proves non-NaN plus both range bounds.
use omega::language::std::console;
data Main {
    console: Console;
    bounded: f64 [0.0..=100.0];
    unbounded: f64;
    a: i32;
    b: i32;
}
machine Main::main(&mut self) {
    self.bounded = 77.9;
    self.a = self.bounded as i32;
    self.unbounded = 42.5;
    transition self.unbounded == self.unbounded
        && self.unbounded >= 0.0 && self.unbounded <= 100.0 {
        true -> guarded()
        _ -> bad()
    }
    state guarded(&mut self) {
        self.b = self.unbounded as i32;
        transition self.a == 77 && self.b == 42 { true -> good() _ -> bad() }
    }
    state good(&mut self) { self.console.exit_process(78); }
    state bad(&mut self) { self.console.exit_process(71); }
}
machine Main::run(&mut self) { self.main(); }
