use omega::language::core::float_operations;

// F3a: `Finite` is a compiler-known core value domain, not a user-declared
// carrier domain. A finite literal discharges it directly, while a float range
// carries Finite implicitly into a bounded transition argument.
use omega::language::std::console;

data Main {
    console: Console;
    direct: f64 in Finite;
    ranged: f32 [0.0..=1.0];
}

machine Main::main(&mut self) {
    // Writes are an invariant window: transient poison and an out-of-range
    // intermediate are legal because both places are repaired before the
    // transition consumes state.
    self.direct = 0.0 / 0.0;
    self.direct = 2.5;
    self.ranged = 2.0;
    self.ranged = 0.5;
    transition { _ -> accepts_range(self.ranged) }

    state accepts_range(&self, value: f32 in Finite) {
        transition value == 0.5 { true -> good() _ -> bad() }
    }

    state good(&self) { self.console.exit_process(77); }
    state bad(&self) { self.console.exit_process(78); }
}
