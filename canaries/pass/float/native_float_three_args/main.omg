// THREE f64 arguments reach v2 and the result remains genuinely FUSED.
// With a = b = 1 + 2^-52 and c = -(1 + 2^-51), exact a*b+c is 2^-104.
// FMA therefore returns a positive subnormal-sized value, while a separately
// rounded multiply-then-add returns zero. Besides preserving the original
// AArch64 v0/v1/v2 ABI proof, this is the runtime half of the executable
// FloatSemantics FMA edge: native libm and the interpreter's shared semantic
// engine must both take the positive arm.

use omega::language::std::console;

boundary trait Math {
    machine fused_multiply_add(x: f64, y: f64, z: f64) -> f64;
}

data Main {
    console: Console;
    math: Math;
    a: f64;
    b: f64;
    c: f64;
    result: f64;
}

machine Main::main(&mut self) {
    self.a = 1.0000000000000002220446049250313080847263336181640625;
    self.b = 1.0000000000000002220446049250313080847263336181640625;
    self.c = 0.0 - 1.000000000000000444089209850062616169452667236328125;
    self.result = self.math.fused_multiply_add(self.a, self.b, self.c);
    transition self.result > 0.0 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
