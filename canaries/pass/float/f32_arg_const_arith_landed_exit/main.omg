use omega::language::core::float_operations;

// F2c ARG face, reconciled with the exact-anonymous-constant law: a wholly
// anonymous constant tree stays exact Rat until the transition parameter is
// its first typed destination, then rounds ONCE to f32. Here x is just above
// 2^-24, so exact `1 + x` rounds UP to 1 + 2^-23. This deliberately differs
// from an explicitly f32-landed/runtime tree, whose operations round per-op.
// Guards the validation argument landing (target params zipped with args).
use omega::language::std::console;
data Main { console: Console; expected: f32; }
machine Main::main(&mut self) {
    self.expected = 1.00000011920928955078125;
    transition { _ -> check(1.0 + 0.0000000596046483281043038005) }
    state check(&mut self, got: f32) {
        transition got == self.expected { true -> good() _ -> bad() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
