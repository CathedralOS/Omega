data RandomState {
    seed: u64[wrapping];
    calls: UInt;
}

data Random {
}

machine Random::next_u32(&mut self, state: &mut RandomState) -> u32[wrapping] {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;
    -> ((state.seed >> 32) as u32);
}

machine Random::range(&mut self, state: &mut RandomState, exclusive_max: u32[exact, positive]) -> u32[exact, range<0, exclusive_max>] {
    let raw: u32[wrapping] = self.next_u32(state);
    -> raw % exclusive_max;
}

enum ItemKind {
    RustedDagger,
    EarlyBuckler,
    HealingCharm,
    EmberBlade,
    DeepKey,
}

data Reward {
    item: ItemKind;
}

data Main {
    rng: Random;
}

machine Main::main(
    &mut self,
    depth: u32[exact, non_negative],
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.item = self.pick(depth, random);
    
}

machine Main::pick(
    &mut self,
    depth: u32[exact, non_negative],
    random: &mut RandomState
    ) -> ItemKind {
    let roll: u32[exact, range<0, 100>] = self.rng.range(random, 100);
    let is_early_dagger: bool = depth <= 2 && roll < 50;
    let is_early_buckler: bool = depth <= 3 && roll < 75;
    let is_healing_charm: bool = roll < 85;
    let is_ember_blade: bool = depth >= 5 && roll < 96;
    let is_deep_key: bool = depth >= 8;

    -> ItemKind::RustedDagger when is_early_dagger;
    -> ItemKind::EarlyBuckler when is_early_buckler;
    -> ItemKind::HealingCharm when is_healing_charm;
    -> ItemKind::EmberBlade when is_ember_blade;
    -> ItemKind::DeepKey when is_deep_key;
    -> ItemKind::RustedDagger;
    
}
