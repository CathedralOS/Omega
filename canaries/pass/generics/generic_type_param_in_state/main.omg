// Chapter 12 "Generic Machines": the `Inventory::find<T>` example threads the
// type parameter `T` into internal states (`state find_at(items: &[T], ...)`).
// Machine type parameters stay in scope for implicit entry states and explicit
// internal states.

data Main {
}

machine Main::walk<T>(x: &T)
{
    transition true {
        true -> done(x)
        false -> done(x)
    }

    state done(x: &T) {
    }
}

machine Main::main(&mut self) {
}
