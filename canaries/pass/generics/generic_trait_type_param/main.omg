// Chapter 12 "Associated Types": traits are intended to carry explicit type
// parameters (`trait WireReadable<Message, Value>`). Generic trait parameter
// lists are accepted, and trait machine signatures may refer to those type
// parameters.

data Main {
}

trait Equatable<T> {
    machine T::equals(&self, other: &T) -> bool;
}

machine Main::main(&mut self) {
}
