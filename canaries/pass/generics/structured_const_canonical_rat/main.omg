// PDI1: current core Rat values are eligible structured indices only in their
// canonical representative form. Both signs are admitted after cancellation
// and gcd reduction.

use omega::language::core::rat;

data RatIndices {}

const RatIndices::POSITIVE_HALF: Rat = Rat {
    num: IntPair {
        neg: Nat::Zero,
        pos: Nat::Succ { prev: Nat::Zero }
    },
    den: Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } }
};

const RatIndices::NEGATIVE_HALF: Rat = Rat {
    den: Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } },
    num: IntPair {
        pos: Nat::Zero,
        neg: Nat::Succ { prev: Nat::Zero }
    }
};

data RatIndexed<const R: Rat> {
    marker: u8;
}

data Main {
    positive: RatIndexed<RatIndices::POSITIVE_HALF>;
    negative: RatIndexed<RatIndices::NEGATIVE_HALF>;
}

machine Main::main(&mut self) {
}
