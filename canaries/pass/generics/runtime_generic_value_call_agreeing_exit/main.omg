// TWO value calls to the same generic machine with AGREEING instantiations: both lets bind
// T := i32 in Wrapping, so the monomorphization pass sees consistent proposals (the conflict
// detector must NOT fire), substitutes once, and both results materialize. The results are
// let-bound and combined in an expression (the safe eager-capture pattern; see the shared-
// result-slot fence). id(30) + id(40) = 70. Differential (native must match the interpreter).
use omega::language::std::console;
data Main { console: Console; }
machine Main::id<T>(&self, x: T) -> T { transition { _ -> x } }
machine Main::main(&mut self) {
    let a: i32 in Wrapping = self.id(30);
    let b: i32 in Wrapping = self.id(40);
    let total: i32 in Wrapping = a + b;
    self.console.exit_process(total as i32);
}
