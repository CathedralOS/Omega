// Frozen decision 13 residue (value-position complement of
// machine_bound_satisfied_at_call): machine-call type-parameter bounds are
// now also enforced for VALUE-position calls (`let r = self.pick(&self.l)`).
// A `[copy]` data type and a scalar primitive satisfy the bound; the compiler
// must accept both through the attached-method and free-machine paths.

data Light [copy] {
    weight: i32;
}

data Main {
    l: Light;
    n: i32;
    result: i32;
}

machine Main::pick<T [copy]>(&self, x: &T) -> i32 {
    7
}

machine pick_free<T [copy]>(x: &T) -> i32 {
    42
}

machine Main::main(&mut self) {
    // Value-position call with a [copy] data type -- must compile.
    let a: i32 = self.pick(&self.l);
    // Value-position call with a scalar primitive -- must compile.
    let b: i32 = self.pick(&self.n);
    // Value-position call to a free machine -- must compile.
    let c: i32 = pick_free(&self.l);
    self.result = a;
}
