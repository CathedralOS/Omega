// A direct effect-free `machine(self)` integer-domain classifier is evaluated
// at build time for the concrete const-generic instance.
use omega::language::std::console;

machine is_positive(value: u64) -> bool {
    value > 0
}

domain u64::BufferSize when is_positive(self) {
    self <= 8
}

data FixedBuffer<const N: u64>
where
    N in BufferSize,
{
    values: [u8; N];
}

data Main {
    console: Console;
    buffer: FixedBuffer<4>;
}

machine Main::main(&mut self) {
    self.buffer.values[0] = 66;
    self.console.exit_process(self.buffer.values[0] as i32 + 4);
}
