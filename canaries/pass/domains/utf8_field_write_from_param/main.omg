// #66 GAP (field write from a `&[u8] in Utf8` PARAM): a domained-slice-view param
// stored into a `&[u8] in Utf8` field lowers to the same 16-byte descriptor
// `CopyRuntimeStorage` the String field copy uses. Relies on the data-field layout
// sizing a `Reference { Constrained { Slice } }` field as the fat `{ptr, len}`
// descriptor (16 bytes) so the param's descriptor copies whole; before the layout
// fix the field was a thin 8-byte pointer and the copy silently dropped.
domain [u8]::Utf8 when valid_utf8(self) {
}

data Main {
    out: &[u8] in Utf8;
}

machine Main::store(&mut self, text: &[u8] in Utf8) {
    self.out = text;
}

machine Main::main(&mut self) {
    self.store("Gate");
}
