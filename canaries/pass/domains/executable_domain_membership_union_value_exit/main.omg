use platform::console;

data Password {
    length: i32;
    score: i32;
}

domain Password::Valid
requires
    self.length > 0;

domain Password::Secure
requires
    self.score >= 8;

data Main {
    console: Console;
    password: Password;
}

machine Main::main(&mut self) {
    self.password.length = 12;
    self.password.score = 2;

    let ok: bool = self.password in Password::Valid | Password::Secure;

    transition ok {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(205);
    }

    state bad(&mut self) {
        self.console.exit_process(206);
    }
}
