use platform::console;

data Password {
    length: i32;
    score: i32;
}

domain Password::Valid
requires
    self.length > 0;

domain Password::Secure
requires
    self.score >= 8;

data Main {
    console: Console;
    password: Password;
}

machine Main::main(&mut self) {
    self.password.length = 12;
    self.password.score = 10;

    transition (self.password in Password::Valid & Password::Secure) {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(231);
    }

    state bad(&mut self) {
        self.console.exit_process(232);
    }
}
