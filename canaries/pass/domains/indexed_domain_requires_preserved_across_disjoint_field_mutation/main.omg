data Item {
    value: i32;
    tag: i32;
}

domain Item::Valid
requires
    self.value > 0;

data Main {
    items: [Item; 2];
}

machine Main::mark_valid(&mut self, item: &mut Item)
ensures
    item in Item::Valid
{
    item.value = 1;
}

machine Main::accept(item: Item)
requires
    item in Item::Valid
{
}

machine Main::main(&mut self) {
    let index: u64 = 1;
    self.mark_valid(&mut self.items[0]);
    self.items[index].tag = 9;
    self.accept(self.items[0]);
}
