// Chapter 8: a domain MEMBERSHIP test (`x in Type::Domain`) is
// a full executable check in guard position when the domain is
// runtime-checkable. (Historically this canary used the bare `if x in ...`
// statement; a bare `if` has no else and no continuation, so its dispatch can
// FALL THROUGH -- which is a compile error since the no-silent-fall-through
// ruling of 2026-07-02. The membership-in-guard-position surface it pins is
// unchanged.)

data Player {
    health: i32;
}

domain Player::Valid
requires
    self.health >= 0;

domain Player::Dead
requires
    self in Player::Valid;
    self.health == 0;

data Main {
    player: Player;
}

machine Main::main(&mut self) {
    transition {
        self.player in Player::Dead -> done()
        _ -> done()
    }

    state done() { }
}
