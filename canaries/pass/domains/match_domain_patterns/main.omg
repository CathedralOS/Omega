// Chapter 8 "Domain Patterns": a value can be matched against type-qualified
// domain patterns. Each arm checks whether the value is in that domain and
// dispatches to a distinct state. The trailing `_` makes the match exhaustive.

data Player {
    health: i32;
}

domain Player::Valid
requires
    self.health >= 0;

domain Player::Alive
requires
    self in Player::Valid;
    self.health > 0;

domain Player::Dead
requires
    self in Player::Valid;
    self.health == 0;

data Main {
    player: Player;
}

machine Main::main(&mut self) {
    match self.player {
        Player::Alive -> alive()
        Player::Dead -> dead()
        _ -> other()
    }

    state alive() { }
    state dead() { }
    state other() { }
}
