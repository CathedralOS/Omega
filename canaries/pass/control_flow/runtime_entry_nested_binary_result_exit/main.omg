// Nested runtime arithmetic at an entry terminal is represented as recursive
// value operands before the final result-scratch write.
data Main { a: i32; b: i32; c: i32; }

machine Main::main(&mut self) -> i32 {
    self.a = 10;
    self.b = 20;
    self.c = 30;
    transition { _ -> (self.a + ((self.b * self.c) / 10)) }
}
