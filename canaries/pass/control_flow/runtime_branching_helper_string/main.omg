domain [u8]::Utf8
requires
    valid_utf8(self);
data Main {
    out: &[u8] in Utf8;
}

machine Main::main(&mut self) {
    let flag: bool = true;
    self.out = self.pick(flag);
}

machine Main::pick(&mut self, flag: bool) -> &[u8] in Utf8 {
    transition flag {
        true -> "Gate"
        false -> "Branch Room"
    }
}
