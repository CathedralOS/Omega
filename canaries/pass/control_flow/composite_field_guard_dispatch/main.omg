data EventKind {
    case Quiet;
    case Treasure;
}

data Event {
    kind: EventKind;
    consumed: bool;
}

boundary trait Console {
    machine write_line(text: String);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    event: Event;
}

machine Main::main(&mut self) {
    self.event.kind = EventKind::Treasure;
    self.event.consumed = false;

    transition {
        self.event.kind == EventKind::Treasure && self.event.consumed == false -> describe_reward()
        _ -> describe_quiet()
    }
    

    state describe_reward(&mut self) {
        self.console.write_line("reward");
        self.console.exit_process(0);
    }

    state describe_quiet(&mut self) {
        self.console.write_line("quiet");
        self.console.exit_process(1);
    }
}
