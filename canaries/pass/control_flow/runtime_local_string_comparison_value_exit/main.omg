domain [u8]::Utf8 when valid_utf8(self) {
}

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    text: &[u8] in Utf8;
}

machine Main::main(&mut self) {
    self.text = "deep room";

    let text_ok: bool = self.text == "deep room";

    transition text_ok {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(78);
    }

    state bad(&mut self) {
        self.console.exit_process(79);
    }
}