// The Euclid-swap capture shape -- the canonical FIELD-WRITE face of the
// stale-fold family (samples/euclid_gcd used a field temp to dodge it):
//   let r = self.a % self.b;  self.a = self.b;  self.b = r;
// At `self.b = r`, folding r back to `a % b` re-reads a AFTER `a = b`, giving
// b % b = 0 and collapsing the loop. The capture-aware binding skip keeps r in
// its slot, so the swap is correct and gcd(48, 36) = 12 -> exit 70 (the old
// fold exits 36 after one bogus step).
use omega::language::std::console;
data Main {
    console: Console;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
}
machine Main::main(&mut self) {
    self.a = 48;
    self.b = 36;
    transition {
        _ -> step()
    }
    state step(&mut self) {
        transition self.b == 0 {
            true -> done()
            false -> reduce()
        }
    }
    state reduce(&mut self) {
        let r: i32 in Wrapping = self.a % self.b;
        self.a = self.b;
        self.b = r;
        transition {
            _ -> step()
        }
    }
    state done(&mut self) {
        transition self.a == 12 {
            true -> good()
            false -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
