domain [u8]::Utf8 when valid_utf8(self) {
}

data CellId {
    case Empty;
    case A1;
    case A2;
}

data Cell {
    id: CellId;
    label: &[u8] in Utf8;
}

data CellLine {
    text: &[u8] in Utf8;
}

boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
}

data Main {
    console: Console;
    selected: Cell;
    line: CellLine;
    first: Cell = Cell { id: CellId::A1, label: "A1" };
    second: Cell = Cell { id: CellId::A2, label: "A2" };
}

machine Main::main(&mut self) {
    scan(self.first, CellId::A2, mut self.selected);
    scan(self.second, CellId::A2, mut self.selected);
    self.line.text = self.selected.label;
    self.console.write_line(self.line.text);

    transition {
        _ -> self()
    }


    state scan(cell: Cell, id: CellId, out_cell: &mut Cell) {
        transition {
            cell.id == id -> apply(cell, mut out_cell)
            _ -> {}
        }
    }

    state apply(cell: Cell, out_cell: &mut Cell) {
        out_cell = cell;
    }
}