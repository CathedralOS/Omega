// COMPILE CANARY: a nested OWNED field's declared ZII-admitting domain remains
// a valid write source after the enclosing record crosses a mutable
// out-parameter call. Alias invalidation may discard transient facts, but it
// must not discard the enforced declared-domain invariant of `Cell::label`.
// Persistent room/line text uses bounded ownership; a borrowed view would need
// an explicit outlives relation and retained loan, which this canary does not
// exercise.
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
data CellId {
    case Empty;
    case A1;
    case A2;
}

data Cell {
    id: CellId;
    label: [u8; 8] in Utf8;
}

data CellLine {
    text: [u8; 8] in Utf8;
}

boundary trait Console {
    machine write_line(text: [u8; 8] in Utf8);
}

data Main {
    console: Console;
    selected: Cell;
    line: CellLine;
    first: Cell;
    second: Cell;
}

machine Main::main(&mut self) {
    self.first.id = CellId::A1;
    self.first.label = "A1";
    self.second.id = CellId::A2;
    self.second.label = "A2";
    scan(self.first, CellId::A2, &mut self.selected);
    scan(self.second, CellId::A2, &mut self.selected);
    self.line.text = self.selected.label;
    self.console.write_line(self.line.text);

    transition {
        _ -> self
    }


    state scan(cell: Cell, id: CellId, out_cell: &mut Cell) {
        transition {
            cell.id == id -> apply(cell, &mut out_cell)
            _ -> {}
        }
    }

    state apply(cell: Cell, out_cell: &mut Cell) {
        out_cell = cell;
    }
}
