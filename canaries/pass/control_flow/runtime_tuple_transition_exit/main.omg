use omega::language::std::console;

data Main {
    console: Console;
}

machine Main::run(&mut self) -> i32 {
    transition {
        _ -> classify(false, true)
    }

    state classify(left: bool, right: bool) -> i32 {
        transition (left, right) {
            (true, _) -> done_11()
            (false, true) -> done_22()
            // The final arm is the (false, false) case, spelled `_` so the
            // dispatch provably closes (tuple-conjunction coverage is not
            // counted by the exhaustiveness pass).
            _ -> done_33()
        }
    }

    state done_11(&mut self) -> i32 {
        11
    }

    state done_22(&mut self) -> i32 {
        22
    }

    state done_33(&mut self) -> i32 {
        33
    }
}

machine Main::main(&mut self) {
    let result: i32 = self.run();
    self.console.exit_process(result);
}
