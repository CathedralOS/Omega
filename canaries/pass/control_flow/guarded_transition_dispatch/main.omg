domain [u8]::Utf8 when valid_utf8(self) {
}

data CommandKind {
    case Quit;
    case Look;
    case Invalid;
}

data Command {
    kind: CommandKind;
}

boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    command: Command;
}

machine Main::main(&mut self) -> i32 {
    self.command.kind = CommandKind::Look;

    transition self.command.kind {
        CommandKind::Look -> look()
        CommandKind::Quit -> quit()
        _ -> invalid()
    }
    

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
        0
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
        0
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
        1
    }
}