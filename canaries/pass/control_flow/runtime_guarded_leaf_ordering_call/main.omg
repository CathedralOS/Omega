data RandomState {}

enum ItemKind { RustedDagger; DeepKey; }

data Reward { item: ItemKind; }

data Main {
}

machine Main::main(&mut self, depth: u32, random: &mut RandomState, reward: &mut Reward) {
    reward.item = self.roll_item(depth, random);
    
}

machine Main::roll_item(&mut self, depth: u32, random: &mut RandomState) -> ItemKind {
    -> ItemKind::DeepKey when depth > 0;
    -> ItemKind::RustedDagger;
    
}
