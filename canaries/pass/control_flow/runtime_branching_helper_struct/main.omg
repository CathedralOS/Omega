enum RewardItem {
    None
    Gold
}

data Main {
}

machine Main::main(&mut self, flag: bool, out: &mut RewardItem) {
    out = self.pick(flag);
    
}

machine Main::pick(&mut self, flag: bool) -> RewardItem {
    transition flag {
        true -> RewardItem::Gold
        false -> RewardItem::None
    }
    
}
