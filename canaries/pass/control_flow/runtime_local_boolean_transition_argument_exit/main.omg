use omega::language::std::console;

data Main {
    console: Console;
    flag: bool;
}

machine Main::main(&mut self) {
    self.flag = false;

    let flag_ok: bool = self.flag == false;

    transition {
        _ -> check(flag_ok)
    }

    state check(&mut self, flag_ok: bool) {
        transition flag_ok {
            (true) -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(201);
    }

    state bad(&mut self) {
        self.console.exit_process(202);
    }
}
