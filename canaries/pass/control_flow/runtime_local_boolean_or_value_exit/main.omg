boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    left: bool;
    right: bool;
}

machine Main::main(&mut self) {
    self.left = true;
    self.right = false;

    transition {
        _ -> check()
    }

    state check(&mut self) {
        let ok: bool = self.left || self.right;

        transition ok {
            (true) -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(251);
    }

    state bad(&mut self) {
        self.console.exit_process(252);
    }
}
