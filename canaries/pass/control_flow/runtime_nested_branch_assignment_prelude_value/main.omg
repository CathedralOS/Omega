data Main {
    out: u32;
}

machine Main::main(&mut self) {
    let flag: bool = true;
    self.out = self.pick(flag);
}

machine Main::pick(&mut self, flag: bool) -> u32 {
    let choice: bool = self.identity(flag);
    transition {
        choice -> self.branch(choice)
        _ -> 0
    }
}

machine Main::identity(&mut self, flag: bool) -> bool {
    flag
}

machine Main::branch(&mut self, flag: bool) -> u32 {
    transition {
        flag -> 1
        _ -> 2
    }
}
