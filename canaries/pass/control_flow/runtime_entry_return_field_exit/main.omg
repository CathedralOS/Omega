// An entry `main -> i32` returns its exit code via its terminal value (no
// exit_process needed) -- the return->exit mechanism dungeon_crawler_cli relies
// on. A raw COMPUTED terminal must pass through the entry's normalized result
// placement rather than silently leaving the return register untouched.
// Exit = 200, native==interp.
data Main { a: i32; }
machine Main::main(&mut self) -> i32 {
    self.a = 100;
    transition { _ -> (self.a + 100) }
}
