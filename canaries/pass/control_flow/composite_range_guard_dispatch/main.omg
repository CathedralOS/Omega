domain [u8]::Utf8 when valid_utf8(self) {
}

boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    roll: i32;
}

machine Main::main(&mut self) {
    self.roll = 24;
    transition {
        self.roll >= 20 && self.roll < 30 -> reward()
        _ -> quiet()
    }
    

    state reward(&mut self) {
        self.console.write_line("reward");
        self.console.exit_process(0);
    }

    state quiet(&mut self) {
        self.console.write_line("quiet");
        self.console.exit_process(1);
    }
}