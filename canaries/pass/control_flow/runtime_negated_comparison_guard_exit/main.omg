use omega::language::std::console;

data Main {
    console: Console;
    roll: i32;
}

machine Main::main(&mut self) {
    self.roll = 3;

    transition ((self.roll >= 5) == false) {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(75);
    }

    state bad(&mut self) {
        self.console.exit_process(76);
    }
}
