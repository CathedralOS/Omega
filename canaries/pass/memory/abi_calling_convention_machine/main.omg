// Chapter 19 "Calling Conventions": host and exported ABI machines must declare a
// calling convention via an `abi "<triple>"` modifier plus `boundary host`. This
// canary proves the syntax is parsed and carried through the compiler pipeline.

abi "aarch64-darwin"
machine Host::write(fd: i32, buffer: &[u8]) -> i32
boundary host
{
}

data Main {
}

machine Main::main(&mut self) {
}
