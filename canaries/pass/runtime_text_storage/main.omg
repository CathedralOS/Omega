data ConsoleLine {
    text: String;
}

platform Console {
    entry write(text: String);
    entry write_line(text: String);
    entry read_line(out_line: &mut ConsoleLine);
    entry exit_process(return_code: i32);
}

data Main {
    console: Console;
    line: ConsoleLine;
}

machine Main::main(&mut self) {
    self.console.write("> ");
    self.console.read_line(&mut self.line);
    self.console.write_line(self.line.text);
    self.console.exit_process(0);
}
