// Chapter 7 "Contracts And Flow Facts": the documented contract surface allows
// Rust-style range membership such as `requires mass in 1..=100`. The parser
// lowers it to ordinary boolean proof facts over the range bounds.

data Body {
    mass: i32;
}

machine Body::set_mass(&mut self, mass: i32)
requires
    mass in 1..=100
{
    self.mass = mass;
}

data Main {
    body: Body;
}

machine Main::main(&mut self) {
}
