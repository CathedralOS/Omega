// Chapter 10 "Typed Facts": `3nat * 3nat` is math over `Nat` (proof arithmetic),
// distinct from machine arithmetic like `3i32 * 3i32`. The closed `pythagorean`
// equality is meant to reduce both sides to the same `Nat` and close by
// reflexivity.

machine pythagorean_3_4_5()
ensures
    3nat * 3nat + 4nat * 4nat == 5nat * 5nat
{
}

data Main {
}

machine Main::main(&mut self) {
}
