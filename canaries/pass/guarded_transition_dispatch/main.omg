enum CommandKind {
    Quit,
    Look,
    Invalid,
}

data Command {
    kind: CommandKind;
}

platform Console {
    entry write_line(text: String);
    entry exit_process(return_code: i32);
}

data main {
    console: Console;
    command: Command;
}

machine main -> i32 {
    pub entry(&mut self) {
        self.command.kind = CommandKind::Look;

        transition self.command.kind {
            CommandKind::Look -> look()
            CommandKind::Quit -> quit()
            _ -> invalid()
        }
    }

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
        0
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
        0
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
        1
    }
}
