// Provably-disjoint mutable windows of the same base: `[0..2)` ends where
// `[2..4)` begins, so the literal window bounds prove the two `&mut` views
// never alias and both borrows may live at once (chapter 2: disjoint windows
// are allowed when provable).

data Main {
    entries: [i32; 4];
}

machine Main::main(&mut self) -> u64 {
    let items: &mut [i32] = self.entries.as_mut_slice();
    let a: &mut [i32] = items[0..2];
    let b: &mut [i32] = items[2..4];
    a.len + b.len
}
