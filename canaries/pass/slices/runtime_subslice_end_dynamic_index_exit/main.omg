use platform::console;

data Entry {
    value: i32;
}

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::main(&mut self) {
    self.entries[0].value = 11;
    self.entries[1].value = 29;
    self.entries[2].value = 37;

    let view: &[Entry] = self.entries.as_slice();
    let prefix: &[Entry] = view[..2];

    choose(prefix, 1);

    state choose(&mut self, entries: &[Entry], index: u64) {
        transition entries[index].value == 29 {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(211);
    }

    state bad(&mut self) {
        self.console.exit_process(212);
    }
}
