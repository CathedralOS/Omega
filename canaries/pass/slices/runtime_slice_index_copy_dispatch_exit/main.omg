use platform::console;

data Entry {
    value: i32;
}

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::main(&mut self) {
    transition true {
        true -> copy_alias()
    }

    state copy_alias(&mut self) {
        self.entries[0].value = 7;

        let entry_view: &[Entry] = self.entries.as_slice();
        let index: u64 = 0;
        let chosen: Entry = entry_view[index];

        transition chosen.value == 7 {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(61);
    }

    state bad(&mut self) {
        self.console.exit_process(62);
    }
}
