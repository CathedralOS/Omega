// A MACHINE array's runtime-indexed element inside a FUSED value-call arg
// (`self.pick(self.k + self.arr[i])`). Before 2026-07-10l the canonical
// ValueOperand enum had NO MachineIndexed variant: the write selection for
// the substituted callee computation BAILED, the state-granular call-result
// fence let the drop through SILENTLY (its fix is with the fs lane), and the
// result slot read ZII/garbage (native 71 vs interp 70). Served now by the
// MachineIndexed operand variant on both ISAs: machine base relocated at the
// operand start, a frame-resident index materializing the frame base at the
// architecture's pinned second offset, index/scale scratch from the operand
// scratch list (the hardcoded-x17 clobber lesson). Exit 70; differential-
// pinned; the frame twin is runtime_local_array_element_value_operand_exit.
use omega::language::std::console;
data Main { console: Console; arr: [i32; 3]; idx: u64; k: i32; }
machine Main::pick(&mut self, v: i32 [0..=100]) -> i32 { v + 1 }
machine Main::main(&mut self) {
    self.arr = [10, 20, 30];
    self.idx = 1;
    self.k = 7;
    transition self.idx < 3 { true -> go(self.idx) _ -> bad() }
    state go(&mut self, i: u64 [0..=2]) {
        let d: i32 = self.pick(self.k + self.arr[i]);
        transition d == 28 { true -> good() _ -> bad() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
