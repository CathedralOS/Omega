// Subslice with a RUNTIME end over a slice parameter (`sub[..end]` where
// `end: u64` is only known at runtime). The pointer copies unchanged and the
// length is the runtime end value (end - 0), read from `end`'s frame slot.

use platform::console;

data Entry { value: i32; }

data Main {
    console: Console;
    entries: [Entry; 5];
}

machine Main::main(&mut self) {
    let view: &[Entry] = self.entries.as_slice();
    transition {
        _ -> self.check(view, 3)
    }
}

machine Main::check(&mut self, sub: &[Entry], end: u64) {
    transition end < sub.len {
        true -> self.verify(sub[..end])
        false -> bad()
    }
    state bad(&mut self) { self.console.exit_process(71); }
}

machine Main::verify(&mut self, sub: &[Entry]) {
    transition sub.len == 3 {
        true -> good()
        false -> wrong()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state wrong(&mut self) { self.console.exit_process(72); }
}
