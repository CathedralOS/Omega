use platform::console;

data Entry {
    value: i32 in Wrapping;
}

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::main(&mut self) {
    let entry_view: &[Entry] = self.entries.as_slice();

    transition entry_view.len > 0 {
        true -> sum_entries(entry_view, 0, 0)
        false -> bad()
    }

    state sum_entries(
        &mut self,
        entries: &[Entry],
        index: u64 in Wrapping,
        total: i32 in Wrapping
    ) {
        let current: Entry = entries[index];
        let next_total: i32 in Wrapping = total + 1;
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < entries.len;

        transition has_next {
            true -> sum_entries(entries, next_index, next_total)
            false -> check_total(next_total)
        }
    }

    state check_total(&mut self, total: i32 in Wrapping) {
        transition total == 4 {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(91);
    }

    state bad(&mut self) {
        self.console.exit_process(92);
    }
}
