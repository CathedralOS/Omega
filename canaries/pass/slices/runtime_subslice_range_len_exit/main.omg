use platform::console;

data Entry {
    value: i32;
}

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::main(&mut self) {
    let view: &[Entry] = self.entries.as_slice();
    let tail: &[Entry] = view[1..];

    transition tail.len == 3 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(203);
    }

    state bad(&mut self) {
        self.console.exit_process(204);
    }
}
