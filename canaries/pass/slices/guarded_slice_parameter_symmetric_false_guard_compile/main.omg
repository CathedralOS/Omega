data Entry {
    value: i32;
}

data Main {
}

machine Main::main(&mut self) -> usize {
    transition {
        _ -> 0
    }

    state choose(&mut self, entries: &[Entry]) -> usize {
        transition false == (entries.len == 0) {
            true -> length(entries[1..])
            false -> 0
        }
    }

    state length(&mut self, entries: &[Entry]) -> usize {
        transition {
            _ -> entries.len
        }
    }
}
