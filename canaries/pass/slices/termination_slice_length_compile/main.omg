data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[Entry] = self.entries.as_slice();

    transition {
        _ -> self.walk(view)
    }
}

machine Main::walk(&mut self, entries: &[Entry])
terminates by entries -> Slice::Length;
-> u64
{
    transition entries.len > 0 {
        true -> walk(entries[1..])
        false -> 0
    }
}
