// A frame-held slice descriptor indexed by a MACHINE field exercises the
// AArch64 cross-region binary-write address recipe and its second relocation.
use omega::language::std::console;
data Main {
    console: Console;
    arr: [i32 in Wrapping; 4];
    i: u64 [0..=3];
    value: i32 in Wrapping;
}
machine Main::main(&mut self) {
    self.arr[2] = 40;
    self.i = 2;
    self.value = 40;
    let s: &mut [i32 in Wrapping] = self.arr.as_mut_slice();
    transition self.i < s.len {
        true -> work(s)
        false -> no()
    }
    state work(&mut self, s: &mut [i32 in Wrapping]) {
        s[self.i] = self.value + 2;
        transition self.arr[2] == 42 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
