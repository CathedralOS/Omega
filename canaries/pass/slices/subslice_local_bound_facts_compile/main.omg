data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> usize {
    let view: &[Entry] = self.entries.as_slice();
    let start: usize = 1;
    let end: usize = 3;
    let tail: &[Entry] = view[start..];
    let prefix: &[Entry] = view[..end];
    let middle: &[Entry] = view[start..end];
    tail.len + prefix.len + middle.len
}
