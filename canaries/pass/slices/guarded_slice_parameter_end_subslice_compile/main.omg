data Entry {
    value: i32;
}

data Main {
}

machine Main::main(&mut self) -> usize {
    transition {
        _ -> 0
    }

    state choose(&mut self, entries: &[Entry], end: usize) -> usize {
        transition end < entries.len {
            true -> length(entries[..end])
            false -> 0
        }
    }

    state length(&mut self, entries: &[Entry]) -> usize {
        transition {
            _ -> entries.len
        }
    }
}
