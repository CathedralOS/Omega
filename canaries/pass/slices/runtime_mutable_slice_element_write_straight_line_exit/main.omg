use omega::language::std::console;

data Entry {
    value: i32;
}

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::result_code(&mut self) -> i32 {
    let entry_slice: &mut [Entry] = self.entries.as_mut_slice();
    entry_slice[0].value = 70;
    self.entries[0].value
}

machine Main::main(&mut self) {
    let result: i32 = self.result_code();
    self.console.exit_process(result);
}
