data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[Entry] = self.entries.as_slice();
    let inclusive_prefix: &[Entry] = view[0..=2];
    let inclusive_middle: &[Entry] = view[1..=3];
    inclusive_prefix.len + inclusive_middle.len
}
