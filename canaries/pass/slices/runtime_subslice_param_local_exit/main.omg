// Subslice of a runtime slice PARAMETER assigned to a slice LOCAL
// (`let tail = sub[1..]` in a state body). Unlike the argument-position shape
// (runtime_subslice_of_slice_param_exit), this exercises the local-initializer
// descriptor write path: the local's frame slot must receive
// ptr = sub.ptr + 1*elem, len = sub.len - 1. The regression this pins: the
// local write fell back to a whole-descriptor copy that ignored the range, so
// `tail.len` stayed 4.

use platform::console;

data Entry { value: i32; }

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::main(&mut self) {
    self.entries[2].value = 37;
    let view: &[Entry] = self.entries.as_slice();
    transition {
        _ -> self.check(view)
    }
}

machine Main::check(&mut self, sub: &[Entry]) {
    transition sub.len > 2 {
        true -> work()
        false -> bad()
    }
    state work(&mut self) {
        let tail: &[Entry] = sub[1..];
        transition tail.len == 3 {
            true -> good()
            false -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
