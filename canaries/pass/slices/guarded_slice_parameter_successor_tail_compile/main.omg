data Entry {
    value: i32;
}

data Main {
}

machine Main::main(&mut self) -> usize {
    transition {
        _ -> 0
    }

    state choose(&mut self, entries: &[Entry], index: usize) -> usize {
        transition entries.len >= index + 1 {
            true -> length(entries[index..])
            false -> 0
        }
    }

    state length(&mut self, entries: &[Entry]) -> usize {
        transition {
            _ -> entries.len
        }
    }
}
