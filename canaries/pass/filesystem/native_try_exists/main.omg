// NATIVE fs try_exists logic (Rust Path::try_exists) via STAT + errno. The
// three-way existence check on real macOS syscalls: a present file stats OK (Yes);
// a missing path fails with ENOENT (2 = No); a chmod-0 (unreadable) file STILL
// stats OK (Yes) -- stat needs no read permission, so a present-but-unreadable file
// is Yes, not an error (matching Rust and the Filesystem::try_exists wrapper).
// Error is reserved for a genuine non-ENOENT stat failure (e.g. an unsearchable
// ancestor). Prints PASS iff Yes/No/Yes all match.

use omega::language::std::filesystem_host;

data Main {
    fs: FilesystemHost;
    mode: i32;
    noaccess: u32;
    fd: i32;
    rc: i32;
    code: i32;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(&mut self) {
    self.mode = 420;
    self.noaccess = 0;
    self.fd = self.fs.create("/tmp/omega_te.txt", self.mode);
    self.n = self.fs.close(self.fd);
    // present -> stat succeeds (Yes)
    self.rc = self.fs.read_metadata("/tmp/omega_te.txt", &mut self.buffer);
    transition self.rc == 0 { true -> checkmissing() _ -> fail() }
    state checkmissing(&mut self) {
        self.rc = self.fs.read_metadata("/tmp/omega_missing_xyz.txt", &mut self.buffer);
        transition self.rc == 0 { true -> fail() _ -> confirmnoent() }
    }
    state confirmnoent(&mut self) {
        self.code = self.fs.errno();
        transition self.code == 2 { true -> lockit() _ -> fail() }
    }
    state lockit(&mut self) {
        // chmod 0: stat STILL succeeds (Yes) -- no read permission needed
        self.n = self.fs.set_permissions("/tmp/omega_te.txt", self.noaccess);
        self.rc = self.fs.read_metadata("/tmp/omega_te.txt", &mut self.buffer);
        self.n = self.fs.remove("/tmp/omega_te.txt");
        transition self.rc == 0 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: try_exists Yes/No/Yes (chmod-0 present -> Yes via stat)\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: try_exists\n"); }
}
