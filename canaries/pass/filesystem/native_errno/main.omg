// NATIVE fs errno (typed error model). Opens a path that does not exist; the
// raw open returns a negative fd, and errno() (darwin ___error() dereferenced)
// reports ENOENT (2). Proves the value-returning-with-pointer-deref host call
// works end-to-end. Prints PASS iff errno == 2.

use omega::language::std::filesystem_host;

data Main {
    fs: FilesystemHost;
    rdonly: i32;
    fd: i32;
    code: i32;
    n: i64;
}

machine Main::main(&mut self) {
    self.rdonly = 0;
    self.fd = self.fs.open("/tmp/omega_definitely_absent_xyzzy.txt", self.rdonly);
    transition self.fd < 0 { true -> classify() _ -> fail() }
    state classify(&mut self) {
        self.code = self.fs.errno();
        transition self.code == 2 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: errno == ENOENT (2) for a missing open\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: errno\n"); }
}
