// NATIVE value-returning std::fs op: `rc = close(fd)`. Proves the aarch64
// value-returning host-call primitive (value-returning host calls did not exist
// on aarch64 before this).
//
// Verified by disassembly of the emitted mach-o:
//   ldr x0,[fd_in] ; bl _close ; adrp/add x16 ; str w0,[x16,#rc]
// (fd marshalled into x0, `_close` called, its 32-bit return stored into rc).
//
// The raw boundary is `FilesystemHost` with HUMAN method names (the ugly libc
// spelling `_close` lives only in the darwin binding table). NOT registered in
// ACTIVE_PASS_CANARIES yet (canary_suite.rs is hot with other work).

use omega::language::std::filesystem_host;

data Main {
    fs: FilesystemHost;
    fd_in: i32;
    rc: i32;
}

machine Main::main(&mut self) {
    self.fd_in = 5;
    self.rc = self.fs.close(self.fd_in);
}
