// NATIVE forwarded slice-literal argument (TASKS_FS.md step 14 fix). A string
// literal "hello" is passed as a TRANSITION-target argument to a state whose
// parameter is `&[u8]`, then written to a file. Before the fix the descriptor's
// length materialized as 0 (empty write); now the full {ptr -> rodata, len}
// descriptor lands, so the write is 5 bytes. Verified via seek-to-end == 5.

domain [u8]::Path when no_nul(self) {
}

boundary trait FilesystemHost {
    machine create(path: &[u8] in Path, mode: i32) -> i32;
    machine write(fd: i32, bytes: &[u8]) -> i64;
    machine close(fd: i32) -> i32;
    machine seek(fd: i32, offset: i64, whence: i32) -> i64;
    machine remove(path: &[u8] in Path) -> i32;
}

data Main {
    fs: FilesystemHost;
    mode: i32;
    fd: i32;
    n: i64;
    size: i64;
}

machine Main::main(&mut self) {
    self.mode = 420;
    self.fd = self.fs.create("/tmp/omega_fwd_lit.txt", self.mode);
    transition self.fd >= 0 { true -> forward("hello") _ -> fail() }
    state forward(&mut self, bytes: &[u8]) {
        self.n = self.fs.write(self.fd, bytes);
        self.size = self.fs.seek(self.fd, 0, 2);
        self.n = self.fs.close(self.fd);
        self.n = self.fs.remove("/tmp/omega_fwd_lit.txt");
        transition self.size == 5 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: transition-forwarded slice literal wrote 5 bytes\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: forwarded slice literal\n"); }
}
