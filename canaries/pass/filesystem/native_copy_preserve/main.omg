// NATIVE faithful `fs::copy` with PERMISSION PRESERVATION (Rust `fs::copy` copies
// the source's mode) on real macOS. Combines the runtime-subslice write (fire 20)
// with a stat-decode + chmod to carry the mode across. The scenario:
//   1. create src, write "hello world" (11 bytes), chmod src to 0o640 (distinctive)
//   2. stat src -> decode the permission bits (== 0o640)
//   3. read src into a buffer (n bytes), create dst, write buffer[0..n] (faithful)
//   4. chmod dst to the source's mode (preserve)
//   5. stat dst -> assert perm bits == 0o640 AND st_size == 11
// Prints PASS iff the destination is byte-exact AND mode-exact.

use omega::language::std::filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    fs: FilesystemHost;
    mode: i32;
    rdonly: i32;
    cap: u64;
    srcperm: u32;
    fd: i32;
    rc: i32;
    got: u64;
    srcmode: u32;
    dstmode: i32;
    size: i32;
    discard: i32;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(&mut self) {
    self.mode = 420;      // 0o644
    self.rdonly = 0;
    self.cap = 64;
    self.srcperm = 416;   // 0o640 -- distinctive source mode
    self.fd = self.fs.create("/tmp/omega_cp_src.txt", self.mode);
    self.n = self.fs.write(self.fd, "hello world");
    self.discard = self.fs.close(self.fd);
    self.discard = self.fs.set_permissions("/tmp/omega_cp_src.txt", self.srcperm);
    // stat the source, capture its permission bits
    self.rc = self.fs.read_metadata("/tmp/omega_cp_src.txt", &mut self.buffer);
    self.srcmode =
        (widen_u8_to_u32(self.buffer[4]) | (widen_u8_to_u32(self.buffer[5]) << 8)) & 511;
    // read the source bytes
    self.fd = self.fs.open("/tmp/omega_cp_src.txt", self.rdonly);
    self.n = self.fs.read(self.fd, &mut self.buffer, self.cap);
    self.got = narrow_i64_to_u64_wrapping(self.n);
    self.discard = self.fs.close(self.fd);
    transition self.got <= 144 { true -> writeit() _ -> fail() }
    state writeit(&mut self) {
        // faithful byte copy: write exactly buffer[0..got]
        self.fd = self.fs.create("/tmp/omega_cp_dst.txt", self.mode);
        self.n = self.fs.write(self.fd, self.buffer[0..self.got]);
        self.discard = self.fs.close(self.fd);
        // preserve the source's mode on the destination
        self.discard = self.fs.set_permissions("/tmp/omega_cp_dst.txt", self.srcmode);
        self.discard = self.fs.remove("/tmp/omega_cp_src.txt");
        // verify the destination: size 11 and mode 0o640
        self.rc = self.fs.read_metadata("/tmp/omega_cp_dst.txt", &mut self.buffer);
        self.discard = self.fs.remove("/tmp/omega_cp_dst.txt");
        self.dstmode =
            (widen_u8_to_i32(self.buffer[4]) | (widen_u8_to_i32(self.buffer[5]) << 8))
                & 511;
        self.size = widen_u8_to_i32(self.buffer[96]);
        transition self.dstmode == 416 { true -> checksize() _ -> fail() }
    }
    state checksize(&mut self) {
        transition self.size == 11 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: faithful copy preserves bytes (11) + mode (0o640)\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: native copy_preserve\n"); }
}
