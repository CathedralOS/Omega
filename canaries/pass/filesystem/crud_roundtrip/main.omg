// Filesystem CRUD round-trip over the std::fs surface (omega/language/std/
// filesystem.omg). Exercises: create -> write -> close -> open_read -> read ->
// close -> remove. Paths are `&[u8] in Path` (nul-free bytes), outcomes are
// bespoke ZII sum types (no Result<T>), and the file handle is a ZII `File`.
//
// CHECK-ONLY for now: native execution needs the per-target open/read/write/
// close lowering (TASKS_FILESYSTEM.md step 1e/2). Under `--check` this pins the
// surface's shape and the caller's data/ownership/flow.

use omega::language::std::filesystem;

data Main {
    fs: Filesystem;
    open_out: OpenOutcome;
    write_out: WriteOutcome;
    read_out: ReadOutcome;
    remove_out: RemoveOutcome;
    buffer: [u8; 64];
}

machine Main::main(&mut self) {
    // CREATE the file for writing.
    self.fs.create("/tmp/omega_fs_canary.txt", &mut self.open_out);
    transition self.open_out {
        OpenOutcome::Opened { file } -> update(file)
        _ -> done()
    }

    // UPDATE: write bytes into the created file, then release the handle.
    state update(&mut self, file: File) {
        self.fs.write(file, "omega filesystem crud", &mut self.write_out);
        self.fs.close(file);
        transition self.write_out {
            WriteOutcome::Wrote { count } -> reopen()
            _ -> done()
        }
    }

    // READ: reopen the same path for reading.
    state reopen(&mut self) {
        self.fs.open_read("/tmp/omega_fs_canary.txt", &mut self.open_out);
        transition self.open_out {
            OpenOutcome::Opened { file } -> consume(file)
            _ -> done()
        }
    }

    state consume(&mut self, file: File) {
        self.fs.read(file, &mut self.buffer, &mut self.read_out);
        self.fs.close(file);
        transition self.read_out {
            ReadOutcome::Read { count } -> cleanup()
            _ -> done()
        }
    }

    // DELETE the file.
    state cleanup(&mut self) {
        self.fs.remove("/tmp/omega_fs_canary.txt", &mut self.remove_out);
    }

    state done(&mut self) {
    }
}
