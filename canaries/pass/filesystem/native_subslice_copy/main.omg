// NATIVE faithful file copy via a RUNTIME-LENGTH subslice write `buffer[0..n]`
// (the step-12 faithful-copy idiom, now closed end-to-end). Reads the source into
// a [u8; 64] buffer, learns the byte count `n` from the read result, then writes
// EXACTLY `buffer[0..n]` to the destination -- no write-whole-then-truncate dance
// (native_buffer_copy's set_len idiom); the destination is the right size on the
// first write. Exercises two new capabilities together on real macOS syscalls:
//   1. the checker proving a runtime subslice end-bound (`n <= 64`) from a
//      dominating `transition n <= 64` guard, and
//   2. the backend marshalling `buffer[0..n]` as {base address, runtime length}.
// Confirms the destination is exactly the 5 source bytes ("hello", first byte 'h').

use omega::language::std::filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    fs: FilesystemHost;
    mode: i32;
    rdonly: i32;
    cap: u64;
    fd: i32;
    n: i64;
    got: u64;
    size: i64;
    first: u8;
    buffer: [u8; 64];
}

machine Main::main(&mut self) {
    self.mode = 420;
    self.rdonly = 0;
    self.cap = 64;
    self.fd = self.fs.create("/tmp/omega_ssc_src.txt", self.mode);
    self.n = self.fs.write(self.fd, "hello");
    self.n = self.fs.close(self.fd);
    self.fd = self.fs.open("/tmp/omega_ssc_src.txt", self.rdonly);
    self.n = self.fs.read(self.fd, &mut self.buffer, self.cap);
    self.got = narrow_i64_to_u64_wrapping(self.n);
    self.n = self.fs.close(self.fd);
    // faithful copy: write EXACTLY the bytes read, `buffer[0..got]`, no truncate.
    transition self.got <= 64 { true -> writeit() _ -> fail() }
    state writeit(&mut self) {
        self.fd = self.fs.create("/tmp/omega_ssc_dst.txt", self.mode);
        self.n = self.fs.write(self.fd, self.buffer[0..self.got]);
        self.n = self.fs.close(self.fd);
        self.n = self.fs.remove("/tmp/omega_ssc_src.txt");
        // verify dst: size == 5 and first byte == 'h'
        self.fd = self.fs.open("/tmp/omega_ssc_dst.txt", self.rdonly);
        self.size = self.fs.seek(self.fd, 0, 2);
        self.n = self.fs.seek(self.fd, 0, 0);
        self.n = self.fs.read(self.fd, &mut self.buffer, self.cap);
        self.n = self.fs.close(self.fd);
        self.n = self.fs.remove("/tmp/omega_ssc_dst.txt");
        self.first = self.buffer[0];
        transition self.size == 5 { true -> checkbyte() _ -> fail() }
    }
    state checkbyte(&mut self) {
        transition self.first == 104 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: native faithful copy via runtime subslice write buffer[0..n] (5 bytes, 'h')\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: native subslice copy\n"); }
}
