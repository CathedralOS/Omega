// NATIVE fs sync (Rust File::sync_all) via _fsync. Creates a file, writes 17
// bytes, flushes with sync (rc must be 0), then confirms the bytes survived by
// seeking to the end (size == 17). Prints PASS. Exercises the value-returning
// `sync` op end-to-end on real macOS syscalls.

use omega::language::std::filesystem_host;

data Main {
    fs: FilesystemHost;
    mode: i32;
    zero_off: i64;
    seek_end: i32;
    fd: i32;
    n: i64;
    rc: i32;
    size: i64;
}

machine Main::main(&mut self) {
    self.mode = 420;
    self.zero_off = 0;
    self.seek_end = 2;
    self.fd = self.fs.create("/tmp/omega_sync.txt", self.mode);
    transition self.fd >= 0 { true -> wrote() _ -> fail() }
    state wrote(&mut self) {
        self.n = self.fs.write(self.fd, "durable payload!!");
        self.rc = self.fs.sync(self.fd);
        self.size = self.fs.seek(self.fd, self.zero_off, self.seek_end);
        self.n = self.fs.close(self.fd);
        self.n = self.fs.remove("/tmp/omega_sync.txt");
        transition self.rc == 0 { true -> checksize() _ -> fail() }
    }
    state checksize(&mut self) {
        transition self.size == 17 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: sync flushes 17 bytes (rc=0, size=17)\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: sync\n"); }
}
