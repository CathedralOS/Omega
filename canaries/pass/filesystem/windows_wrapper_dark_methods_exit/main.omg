// RUN CANARY (exit 70) -- previously-untested ergonomic wrapper methods on
// windows_x64: create (writable File), sync (fsync/_commit), try_clone
// (dup -- a File payload round-tripped through a value call and closed
// separately), set_permissions (chmod), remove. The interpreter's virtual
// fs is the differential oracle.
//
// FOUND + FIXED here: `set_permissions`/`set_file_permissions` passed
// `perms.mode` (a member of a by-value struct param) DIRECTLY as the chmod
// arg, which fails to resolve under some dispatch contexts (the exact
// hazard the wrapper's `file_fd` field documents for `file.fd`). They now
// capture `perms.mode` into a `perm_mode` scratch field in the entry first,
// matching the established idiom. The deeper backend gap -- a struct-param
// MEMBER as a host-call arg under a duplicate dispatch context -- is parked
// (pending/host/member_arg_dup_dispatch).
//
// exits: 70 ok; 71 create not Ok; 73 sync not Ok; 74 try_clone not Ok;
// 75 clone close nonzero; 76 set_permissions not Ok; 77 remove not Ok.
use omega::language::std::filesystem;
use omega::language::std::filesystem_host;

use omega::language::std::console;

data Main {
    console: Console;
    fs: Filesystem;
    open_result: OpenResult;
    unit_result: UnitResult;
    rc: i32;
    rc2: i32;
}

machine Main::main(&mut self) {
    self.open_result = self.fs.create("omega_dark_probe.txt");
    transition self.open_result {
        OpenResult::Ok { file } -> sync_it(file)
        _ -> bad(71)
    }
    state sync_it(&mut self, file: File) {
        self.unit_result = self.fs.sync(file);
        transition self.unit_result { UnitResult::Ok -> clone_it(file) _ -> bad(73) }
    }
    state clone_it(&mut self, file: File) {
        self.open_result = self.fs.try_clone(file);
        self.rc = self.fs.close(file);
        transition self.open_result {
            OpenResult::Ok { file } -> close_clone(file)
            _ -> bad(74)
        }
    }
    state close_clone(&mut self, file: File) {
        self.rc2 = self.fs.close(file);
        transition self.rc2 == 0 { true -> perm_it() _ -> bad(75) }
    }
    state perm_it(&mut self) {
        self.unit_result =
            self.fs.set_permissions("omega_dark_probe.txt", Permissions { mode: 420 });
        transition self.unit_result { UnitResult::Ok -> remove_it() _ -> bad(76) }
    }
    state remove_it(&mut self) {
        self.unit_result = self.fs.remove("omega_dark_probe.txt");
        transition self.unit_result { UnitResult::Ok -> good() _ -> bad(77) }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
