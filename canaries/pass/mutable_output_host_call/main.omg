data ConsoleLine {
    text: String;
}

platform Console {
    fn write(text: String);
    fn write_line(text: String);
    fn read_line(out_line: &mut ConsoleLine);
    fn exit_process(return_code: i32);
}

data main {
    console: Console;
    line: ConsoleLine;
}

machine main {
    pub entry(&mut self) {
        self.console.write("> ");
        self.console.read_line(&mut self.line);
        self.console.write_line("read");
        self.console.exit_process(0);
    }
}
