data ConsoleLine {
    text: String;
}

platform Console {
    fn write(text: String);
    fn write_line(text: String);
    fn read_line(out_line: &mut ConsoleLine);
    fn exit_process(return_code: i32);
}

machine main {
    contains console: Console;

    owns line: ConsoleLine;

    pub entry() {
        console.write("> ");
        console.read_line(mut line);
        console.write_line("read");
        console.exit_process(0);
    }
}
