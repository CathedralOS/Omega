enum ItemKind {
    RustedDagger
    DeepKey
}

data Reward {
    item: ItemKind
}

data Counter {
    value: u32
}

machine main(
    &mut self,
    counter: &mut Counter,
    reward: &mut Reward
) {
    reward.item = self.pick(counter);
    
}

machine main::pick(
    &mut self,
    counter: &mut Counter
    ) -> ItemKind {
    transition counter.value > 3 {
        true -> ItemKind::DeepKey
        false -> ItemKind::RustedDagger
    }
    
}
