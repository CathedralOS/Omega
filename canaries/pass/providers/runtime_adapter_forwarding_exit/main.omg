// PRV4 standard SELF-FORWARDING checked adapter. The imported Console package
// implements write/write_line as ordinary Omega machines over write_byte. Exercise both
// runtime-place and literal String sources; both must travel through the honest
// as_view().bytes() borrow and measured byte walk.
use omega::language::std::console;

data Main {
    console: Console;
    text: String;
}

machine Main::main(&mut self) {
    self.text = "Field";
    self.console.write(self.text);
    self.console.write_line("");
    self.console.write_line("Literal");
    self.console.exit_process(70);
}
