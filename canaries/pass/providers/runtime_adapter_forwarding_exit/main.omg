// PRV4 standard SELF-FORWARDING checked adapter. The imported Console package
// implements write/write_line as ordinary Omega machines over write_byte. Exercise both
// runtime-place and literal byte-carrier sources; both must travel through the
// honest borrowed byte-view path and measured byte walk.
use omega::language::std::console;

domain [u8; 16]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Console;
    text: [u8; 16] in Utf8;
}

machine Main::main(&mut self) {
    self.text = "Field";
    self.console.write(self.text);
    self.console.write_line("");
    self.console.write_line("Literal");
    self.console.exit_process(70);
}
