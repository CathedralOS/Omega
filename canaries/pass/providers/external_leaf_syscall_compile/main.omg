// PRV4d: a target-scoped external leaf using Binding::Syscall reaches the
// ordinary host-ABI syscall mechanism. The x86 structural test pins the final
// number and instruction; this source also joins the general pass corpus.
boundary trait RawProcess {
    machine exit(code: i32);
}

linux_x64 machine exit_leaf(code: i32)
    satisfies RawProcess::exit
    via Binding::Syscall(60);

linux_arm64 machine exit_leaf(code: i32)
    satisfies RawProcess::exit
    via Binding::Syscall(93);

data Main { process: RawProcess; }
machine Main::main(&mut self) {
    self.process.exit(70);
}
