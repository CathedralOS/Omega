// PRV4c: two complete provider-type candidates remain separate. The build
// root's explicit type-per-slot selection resolves the otherwise-loud
// ambiguity without selecting or reconstructing individual rows. Dispatch
// must consume the exact selected rows from SecondProvider.
use omega::language::std::console;

boundary trait Pick {
    machine choose() -> i32;
    machine mark(value: &mut i32);
}

data FirstProvider { }
machine FirstProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (34) }
}
machine FirstProvider::mark(value: &mut i32) satisfies Pick::mark {
    value = 34;
}

data SecondProvider { }
machine SecondProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (35) }
}
machine SecondProvider::mark(value: &mut i32) satisfies Pick::mark {
    value = 35;
}

data Main {
    console: Console;
    pick: Pick;
    selected: i32;
}

machine Main::main(&mut self) {
    self.pick.mark(&mut self.selected);
    let chosen: i32 = self.pick.choose();
    self.console.exit_process(self.selected + chosen);
}
