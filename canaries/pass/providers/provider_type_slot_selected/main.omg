// PRV4c: two complete provider-type candidates remain separate. The build
// root's explicit type-per-slot selection resolves the otherwise-loud
// ambiguity without selecting or reconstructing individual rows.
boundary trait Pick {
    machine choose() -> i32;
}

data FirstProvider { }
machine FirstProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (1) }
}

data SecondProvider { }
machine SecondProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (2) }
}

data Main { }
machine Main::main(&mut self) { }
