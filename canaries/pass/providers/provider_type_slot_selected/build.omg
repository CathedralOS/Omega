// Deployable native provider-selection canary: every hosted target selects its
// exact entry while the authored type-per-slot choice remains target-independent.
target windows_x64 { }
target linux_x64 { }
target linux_arm64 { }
target macos_arm64 { }

machine build(b: &mut Build) {
    b.select_provider<Pick, SecondProvider>();
    b.roots.bind(windows_x86_64::ProgramEntry, Main::main);
    b.roots.bind(linux_x86_64::ProgramEntry, Main::main);
    b.roots.bind(linux_arm64::ProgramEntry, Main::main);
    b.roots.bind(macos_arm64::ProgramEntry, Main::main);
}
