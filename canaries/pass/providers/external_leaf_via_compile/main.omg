// PRV4 step 1: the EXTERNAL LEAF surface. A bodyless machine whose
// realization is a compile-time Binding expression -- `satisfies
// Requirement via <Binding>;` -- parses, lowers, and carries the
// ExternalRealization supply mode (the interned normalized rendering is
// its identity). Inert here (never called); the merge-time consumption is
// the next rung.
boundary trait Console { machine exit_process(return_code: i32); }
boundary trait Shutdown {
    machine halt(code: i32);
}

machine halt_leaf(code: i32) satisfies Shutdown::halt via DllImport("kernel32.dll", "ExitProcess");

data Main { console: Console; }
machine Main::main(&mut self) {
    self.console.exit_process(70);
}
