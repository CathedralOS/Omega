domain [u8]::Utf8
requires
    valid_utf8(self);
// Wire REPEATED + STRING-LAST in ONE message: a packed repeated field
// (runtime-sized payload via FixedVec's intrinsic length) followed by the &[u8] in Utf8
// field carrying the highest field number (the &[u8] in Utf8 must encode last --
// fail/wire/encode_string_field_not_last pins the rejection). Two
// runtime-sized appends in sequence is the edge: the &[u8] in Utf8's cursor must
// start wherever the packed payload actually ended, not at a
// statically-precomputed offset. Borrowed byte-slice decode is pinned
// separately by the zero-copy wire canaries.
//
// Encoded bytes for { samples: FixedVec([150, -2], len 2), label: "hi" }:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00        (samples)
//   length 3       -> 0x03        (packed elements below)
//     150          -> 0xAC 0x02   (zigzag(150) = 300)
//     -2           -> 0x03        (zigzag(-2) = 3)
//   tag 1          -> 0x01        (label)
//   len 2          -> 0x02        ("hi" is two UTF-8 bytes)
//   'h'            -> 0x68 (104)
//   'i'            -> 0x69 (105)
// written = 10.

use omega::language::core::fixed_vec;
use omega::language::std::console;

data Report {
    #0 samples: FixedVec<i32, 4>;
    #1 label: &[u8] in Utf8;
}

data ReportValue {
    samples: FixedVec<i32, 4>;
    label: &[u8] in Utf8;
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(&mut self) {
    // Field-assignment form for the &[u8] in Utf8 (struct-literal &[u8] in Utf8 fields and
    // assignments both lower; assignment keeps parity with the other
    // encode-&[u8] in Utf8 canary).
    let msg: ReportValue;
    msg.samples = FixedVec { items: [150, 0 - 2, 0, 0], length: 2 };
    msg.label = "hi";

    Report::encode(&msg, &mut self.buffer, &mut self.written);

    transition self.written == 10 {
        true -> check_bytes()
        false -> bad()
    }

    state check_bytes(&mut self) {
        let ok: bool = self.buffer[0] == 0
            && self.buffer[1] == 0
            && self.buffer[2] == 3
            && self.buffer[3] == 172
            && self.buffer[4] == 2
            && self.buffer[5] == 3
            && self.buffer[6] == 1
            && self.buffer[7] == 2
            && self.buffer[8] == 104
            && self.buffer[9] == 105;
        transition ok {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
