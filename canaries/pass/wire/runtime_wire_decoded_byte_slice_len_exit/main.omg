// Reading `.len` of a `&[u8]` that lives as a struct FIELD must resolve to the
// descriptor's runtime length slot -- not silently fail to resolve (which left
// the read uninitialized) nor read the descriptor's pointer bytes.
//
// The length here is genuinely RUNTIME: `decode` reads a byte-length
// varint and stores a fat `{ptr, len}` descriptor viewing the buffer, so
// `decoded.bytes.len` can only be correct if the read targets the len slot
// (offset + len_offset) of the field descriptor. The motivating bug: the place
// resolver dropped a `<struct>.<descriptor-field>.len` path because the `.len`
// step had no data layout to resolve against, so `let n = decoded.bytes.len`
// emitted no write and `n` held uninitialized garbage. Exits 70 when n == 2.

use omega::language::std::console;

data Blob {
    #0 bytes: &[u8];
}

data BlobSample {
    bytes: &[u8];
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    console: Console;
    source: [u8; 4];
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(&mut self) {
    self.source[0] = 72;
    self.source[1] = 105;
    let sample: BlobSample = BlobSample { bytes: self.source[0..2] };

    Blob::encode(&sample, &mut self.buffer, &mut self.written);

    let decoded: BlobSample = BlobSample { bytes: self.source[0..2] };
    Blob::decode(&mut decoded, &self.buffer, &mut self.read, &mut self.verdict);

    let n: u64 = decoded.bytes.len;

    let matches: bool = self.verdict == WireVerdict::Sound && self.read == 5 && n == 2;

    transition matches {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
