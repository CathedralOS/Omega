// A fixed array contributes exactly N repeated elements. No synthetic
// `<name>_count` sibling is required or consulted.

use omega::language::std::console;

data Telemetry {
    #0 readings: [u32; 4];
}

data TelemetryValue {
    readings: [u32; 4];
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(&mut self) {
    let msg: TelemetryValue = TelemetryValue {
        readings: [1, 2, 3, 4]
    };

    Telemetry::encode(&msg, &mut self.buffer, &mut self.written);

    self.console.exit_process(70);
}
