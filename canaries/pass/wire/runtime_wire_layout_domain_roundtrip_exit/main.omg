// LAYOUTS L5, the carrier spelling (ch20 "grammars are layout policies"):
// the encode buffer is REFINED `in OmegaLayout<CounterMessage>` -- encoding
// is chosen where the bytes live. The refinement records what the bytes
// hold; it never changes what they are: the carrier stays a plain [u8; 64]
// (NOT the {len, bytes} text carrier), the derived tagged grammar is
// compact_binary v0 unchanged, and this canary pins BYTE IDENTITY -- the
// same hand-computed 8-byte framing as the unrefined round-trip canary
// (era 0x00; tag 0x00, 300 -> 0xAC 0x02; tag 0x01, zigzag(-2) -> 0x03;
// tag 0x02, true -> 0x01). Validation additionally checks the refinement
// AGREES with the schema at every encode/decode call site.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data CounterMessage {
    0: counter: u32;
    1: delta: i32;
    2: flag: bool;
}

data CounterSample {
    counter: u32;
    delta: i32;
    flag: bool;
}

data Main {
    console: Console;
    buffer: [u8; 64] in OmegaLayout<CounterMessage>;
    written: usize;
    read: usize;
    ok: bool;
}

machine Main::main(&mut self) {
    let msg: CounterSample = CounterSample {
        counter: 300,
        delta: 0 - 2,
        flag: true
    };

    CounterMessage::encode_wire(&msg, &mut self.buffer, &mut self.written);

    let decoded: CounterSample = CounterSample {
        counter: 0,
        delta: 0,
        flag: false
    };

    CounterMessage::decode_wire(&mut decoded, &self.buffer, &mut self.read, &mut self.ok);

    let matches: bool = self.ok
        && self.written == 8
        && self.read == 8
        && decoded.counter == 300
        && decoded.delta == 0 - 2
        && decoded.flag;
    transition matches {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
