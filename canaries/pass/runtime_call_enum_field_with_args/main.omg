enum ItemKind {
    RustedDagger
    DeepKey
}

data Reward {
    item: ItemKind
}

machine main(
    &mut self,
    depth: u32,
    reward: &mut Reward
) {
    reward.item = self.pick(depth);
    
}

machine main::pick(
    &mut self,
    depth: u32
    ) -> ItemKind {
    transition depth > 3 {
        true -> ItemKind::DeepKey
        false -> ItemKind::RustedDagger
    }
    
}
