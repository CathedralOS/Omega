domain [u8]::Utf8
requires
    valid_utf8(self);
// Chapter 18 "Capabilities And Authority Flow" (Acquires, nested): a helper
// machine ACQUIRES fresh host authority at the `Desktop` boundary and hands it
// onward through its capability-typed return. `Backup::stage` and `Main::main`
// never touch the boundary directly — they receive the minted `Folder` through
// nested helper returns, so the authority-flow report must propagate `acquires`
// up the call graph with the helper recorded as provenance
// (`Backup::stage acquires via Vault::pick`).

data Folder {
}

domain Folder::Writable
established by Desktop::choose_folder;

boundary trait Desktop {
    machine choose_folder(prompt: &[u8] in Utf8) -> Folder
    ensures
        result in Folder::Writable
    reaches
        Desktop;
}

data Vault {
    desktop: Desktop;
}

machine Vault::pick(&mut self) -> Folder
reaches
    Desktop
{
    self.desktop.choose_folder("choose a backup folder")
}

data Backup {
    vault: Vault;
}

machine Backup::stage(&mut self) -> Folder
reaches
    Desktop
{
    self.vault.pick()
}

data Main {
    backup: Backup;
}

machine Main::main(&mut self) {
    let staged: Folder = self.backup.stage();
}
