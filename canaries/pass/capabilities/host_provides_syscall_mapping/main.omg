domain [u8]::Utf8 when valid_utf8(self) {
}

// Chapter 18 "Host Providers": a target maps a boundary trait's machines to a
// mechanism via `host <target> provides <Trait> { method -> <Binding> }`. The RHS
// is a case construction of the compiler-known, closed `Binding` sum (extern
// brief §12.1): `Syscall(n)`, `DllImport("module", "symbol")`, or `VtableSlot(n)`.

boundary trait Console {
    machine write_line(text: &[u8] in Utf8)
    effects
        stdout_io;
}

host linux_aarch64 provides Console {
    write_line -> Syscall(64);
}

data Main {
}

machine Main::main(&mut self) {
}