// ENT2c: the ninth scalar AAPCS64 argument is stack-resident. This authored
// import need only link into a cross-emitted ELF; the byte-level compiler test
// checks the planned reserve/store/restore sequence around its call.
boundary trait WideImport {
    machine call(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64;
}

machine wide_import(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64 satisfies WideImport::call via Binding::DllImport("libSystem.B.dylib", "omega_nine_argument_probe");

data Main { wide: WideImport; ninth: i64; result: i64; }
machine Main::main(&mut self) {
    self.ninth = 9;
    self.result = self.wide.call(1, 2, 3, 4, 5, 6, 7, 8, self.ninth);
}
