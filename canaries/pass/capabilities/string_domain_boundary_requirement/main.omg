// Chapter 18 "Standard Effects" (CConsole example): instead of growing surface
// types such as CString, a boundary asks for the byte-view domains it needs.
// This keeps interop encoding requirements inside Omega's ordinary domain
// system without a builtin String carrier.

domain [u8]::Utf8
requires
    valid_utf8(self);

domain [u8]::NoNul
requires
    no_nul(self);

boundary trait CConsole {
    machine write(text: &[u8])
    requires
        text in Utf8 & NoNul
    reaches
        CConsole;
}

data Main {
}

machine Main::main(&mut self) {
}
