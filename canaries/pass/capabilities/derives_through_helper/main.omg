domain [u8]::Utf8
requires
    valid_utf8(self);
// Chapter 18 "Capabilities And Authority Flow" (Derives, nested): a helper
// machine DERIVES a narrower `File` authority from a caller-provided `Folder`
// at the `Filesystem` boundary and returns it. The outer `Worker::open_main_log`
// only forwards its folder to the helper, so the authority-flow report must
// propagate `derives` up the call graph with the helper recorded as provenance
// (`Worker::open_main_log derives via Worker::open_log`).

data Folder {
}

data File {
}

domain File::Writable
established by Filesystem::open;

boundary trait Filesystem {
    machine open(folder: Folder, path: &[u8] in Utf8) -> File
    ensures
        result in File::Writable
    reaches
        Filesystem;
}

data Worker {
    fs: Filesystem;
}

machine Worker::open_log(&mut self, folder: Folder) -> File
reaches
    Filesystem
{
    self.fs.open(folder, "log.txt")
}

machine Worker::open_main_log(&mut self, folder: Folder) -> File
reaches
    Filesystem
{
    self.open_log(folder)
}

data Main {
}

machine Main::main(&mut self) {
}
