domain [u8]::Utf8
requires
    valid_utf8(self);
// Chapter 18 "Capabilities And Authority Flow": authority is modeled as ordinary
// values plus domains. A boundary `write_bytes` requires `folder in
// Folder::Writable`; the caller accepts a `Folder` under the same domain and
// forwards it across the boundary, so the requirement is discharged from the
// caller-provided fact rather than from minted host power.

data Folder {
}

domain Folder::Writable;

boundary trait Filesystem {
    machine write_bytes(folder: Folder, path: &[u8] in Utf8)
    requires
        folder in Folder::Writable
    reaches
        Filesystem;
}

data Thumbnailer {
    fs: Filesystem;
}

machine Thumbnailer::write_cache(&mut self, cache: Folder)
requires
    cache in Folder::Writable
reaches
    Filesystem
{
    self.fs.write_bytes(cache, "thumb.bin");
}

data Main {
}

machine Main::main(&mut self) {
}