domain [u8]::Utf8
requires
    valid_utf8(self);
// Chapter 18 "Capabilities And Authority Flow" (Derives): opening a file inside a
// caller-provided folder produces a narrower authority. The boundary `open`
// requires `folder in Folder::Writable` and guarantees `result in File::Writable`,
// modeling a `Folder::Writable -> File::Writable` derivation rather than a fresh
// host acquisition.

data Folder {
}

domain Folder::Writable;

data File {
}

domain File::Writable
established by Filesystem::open;

boundary trait Filesystem {
    machine open(folder: Folder, path: &[u8] in Utf8) -> File
    requires
        folder in Folder::Writable
    ensures
        result in File::Writable
    reaches
        Filesystem;
}

data Worker {
    fs: Filesystem;
}

machine Worker::run(&mut self, folder: Folder)
requires
    folder in Folder::Writable
reaches
    Filesystem
{
    let opened: File = self.fs.open(folder, "a.txt");
}

data Main {
}

machine Main::main(&mut self) {
}
