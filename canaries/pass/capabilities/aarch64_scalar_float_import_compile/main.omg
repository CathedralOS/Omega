use omega::language::core::float_operations;

// An authored scalar-float signature must retain its float class through
// selection: the argument travels in d0 and the result returns in d0.
boundary trait ScalarFloatImport {
    machine call(value: f64) -> f64;
}

machine scalar_float_import(value: f64) -> f64 satisfies ScalarFloatImport::call via Binding::DllImport("libSystem.B.dylib", "omega_scalar_float_probe");

data Main { foreign: ScalarFloatImport; value: f64; result: f64; }
machine Main::main(&mut self) {
    self.result = self.foreign.call(self.value);
}
