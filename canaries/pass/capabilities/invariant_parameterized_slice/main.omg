// Chapter 18 "Invariant Parameters": imported signatures lean on invariant-
// parameterized slice types such as `&mut [u8, [writable, initialized]]`. The
// bracketed invariant-parameter list on a slice type is parsed and retained in
// the boundary requirement.

boundary trait WindowsFile {
    machine read(buffer: &mut [u8, [writable, initialized]], n: u64) -> bool
    reaches
        WindowsFile;
}

data Main {
}

machine Main::main(&mut self) {
}
