// External leaves bind each boundary-trait method to one mechanism from the
// compiler-known, closed `Binding` sum. This target-filtered declaration set
// exercises Syscall, DllImport, and VtableSlot without retaining the retired
// authored `provides` table surface. Provider constants are ordinary format or
// layout facts and are tested independently while Binding::Value retires.
boundary trait Mixed {
    machine via_syscall() effects stdout_io;
    machine via_import() effects stdout_io;
    machine via_vtable() effects stdout_io;
}

demo_target machine syscall_leaf() satisfies Mixed::via_syscall via Binding::Syscall(1);
demo_target machine import_leaf() satisfies Mixed::via_import via Binding::DllImport("kernel32", "WriteFile");
demo_target machine vtable_leaf() satisfies Mixed::via_vtable via Binding::VtableSlot(2);

data Main {}
machine Main::main(&mut self) {}
