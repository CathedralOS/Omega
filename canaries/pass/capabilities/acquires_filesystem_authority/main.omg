domain [u8]::Utf8
requires
    valid_utf8(self);
// A library that ACQUIRES filesystem authority. The `Disk` boundary is held in a
// machine-owned field and the package exercises `Disk` directly through
// it, rather than receiving the authority from a caller. That makes the call an
// acquisition of host authority. `Disk` has no in-package implementation, so it
// is an approved (toolchain) provider edge.

boundary trait Disk {
    machine write_line(text: &[u8] in Utf8)
    reaches
        Disk;
}

data Archiver {
    disk: Disk;
}

machine Archiver::flush(&mut self) {
    self.disk.write_line("flush log");
}

data Main {
    archiver: Archiver;
}

machine Main::main(&mut self) {
    self.archiver.flush();
}