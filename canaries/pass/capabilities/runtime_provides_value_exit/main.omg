// RUN CANARY (exit 70, differential): provides VALUE consumption (portable-
// values rung V2). `Trait::NAME` paths substitute the SELECTED target's
// number before symbol resolution (const-v0 discipline: each use IS the
// literal; the interpreter sees the same substituted program, so the
// differential contract holds by construction). `local_unchecked` resolves
// to the HOST target on every machine, so this canary exercises the
// substitution everywhere. Discriminating: 63 + 7 must reach 70 through TWO
// distinct rows; a missed substitution is an unresolved-name compile error,
// never a wrong value. The wrong-target sibling is
// fail/capabilities/provides_value_wrong_target_rejected.
boundary trait Console { machine exit_process(return_code: i32); }
boundary trait Beeper { machine noop(); }
data Main { console: Console; }
local_unchecked provides Beeper {
    MAGIC -> 63;
    DELTA -> 7;
}
machine Main::main(&mut self) {
    let code: i32 = Beeper::MAGIC + Beeper::DELTA;
    transition code == 70 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code2: i32) { self.console.exit_process(code2); }
}
