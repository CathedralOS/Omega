// RUN CANARY (exit 70, differential) -- BOOL-returning value calls DELIVER,
// three faces that were once suspected in the is_file/is_finite class:
// (1) an ATTACHED bool machine bound to a let, guard on the local;
// (2) a FREE bool machine bound to a let, guard on the local;
// (3) an attached bool machine called DIRECTLY in the guard.
// (Verified 2026-07-18: the 07-08-era "bool value-call mis-delivery" no
// longer reproduces in any face -- the surviving is_finite blocker is the
// INLINED callee's float-local guard resolution, tracked in TASKS F3, not
// bool delivery.)
use omega::language::std::console;

data Probe { flag: u8; }
machine Probe::is_set(&self) -> bool {
    transition self.flag == 1 { true -> yes() _ -> no() }
    state yes(&self) -> bool { true }
    state no(&self) -> bool { false }
}

machine truthy(x: i32) -> bool {
    transition x > 2 { true -> yes() _ -> no() }
    state yes() -> bool { true }
    state no() -> bool { false }
}

data Main { console: Console; probe: Probe; }
machine Main::main(&mut self) {
    self.probe.flag = 1;
    let a: bool = self.probe.is_set();
    transition a == true { true -> face_b() _ -> bad() }

    state face_b(&mut self) {
        let b: bool = truthy(3);
        transition b == true { true -> face_c() _ -> bad() }
    }

    state face_c(&mut self) {
        transition self.probe.is_set() == true { true -> good() _ -> bad() }
    }

    state good(&self) { self.console.exit_process(70); }
    state bad(&self) { self.console.exit_process(71); }
}
