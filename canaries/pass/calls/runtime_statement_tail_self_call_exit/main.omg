// RUN CANARY (exit 70) -- STATEMENT-position tail self-call (the
// mkall_copy class), pinned 2026-07-10i when the probe showed it ALREADY
// SERVES: a trailing statement self-call in an arm state lowers as a
// NESTED-transition cycle upstream of the state-call plan entirely (the
// backend report shows `step -> drip always [cycle]` as a flow transition
// with NO StateCall entry), so the tail-call-to-loop transform never sees
// it. The prior mutation must run every iteration: total = 4+3+2+1 = 10.
// This pin keeps the Nested route honest -- if it ever regresses to a
// call-plan route, the cycle rejection or a wrong total fires here.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; total: i64 in Saturating; }
machine Main::drip(&mut self, n: i32)
terminates { decreases n; }
{
    transition n > 0 { true -> step(n) false -> done() }
    state step(&mut self, n: i32) {
        self.total = self.total + (n as i64 in Saturating);
        self.drip(n - 1);
    }
    state done(&mut self) { }
}
machine Main::main(&mut self) {
    self.drip(4);
    transition self.total == 10 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
