boundary trait Console {
    machine exit_process(return_code: i32);
}

data Item {
    value: i32;
    tag: i32;
}

data Main {
    console: Console;
    items: [Item; 2] = [Item { value: 1, tag: 1 }, Item { value: 2, tag: 2 }];
    index: usize = 0;
}

machine Main::touch_tag(&mut self, item: &mut Item) {
    item.tag = 0;
}

machine Main::main(&mut self) {
    self.touch_tag(&mut self.items[self.index]);

    transition self.items[0].tag == 0 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(175);
    }

    state bad(&mut self) {
        self.console.exit_process(176);
    }
}
