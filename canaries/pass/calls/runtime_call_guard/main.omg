data Counter {
    calls: u32 in Wrapping;
}

data Random {
}

machine Random::chance(
    &mut self,
    state: &mut Counter
    ) -> bool {
    state.calls = state.calls + 1;
    state.calls > 0
}

data Main {
    rng: Random;
    counter: Counter;
}

machine Main::main(&mut self) {
    transition {
        self.rng.chance(&mut self.counter) == true -> success()
        _ -> failure()
    }

    state success(&mut self) {}

    state failure(&mut self) {}
}
