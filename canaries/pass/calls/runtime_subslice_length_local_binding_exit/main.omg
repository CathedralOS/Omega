// A literal-bounded SUBSLICE `.len` read into a LOCAL binding in a value position
// (`let sub = self.arr[1..4]; let n = sub.len`). The subslice binding folds to the
// inline `(self.arr[1..4]).len`, which has no runtime descriptor slot -- so the
// value-write resolver used to DROP it and the local read 0 (a silent miscompile;
// the direct guard `sub.len == 3` and `.len` as an operand always worked, and the
// interpreter always read the true window length). The window length `4 - 1 = 3` is
// a compile-time constant, now folded in the value-write path too. `n == 3` matches
// -> exit 3.
use omega::language::std::console;

data Main {
    console: Console;
    arr: [i32; 5];
}

machine Main::main(&mut self) {
    let sub: &[i32] = self.arr[1..4];
    let n: u64 = sub.len;
    transition n == 3 {
        true -> matched()
        false -> unmatched()
    }

    state matched(&mut self) { self.console.exit_process(3); }
    state unmatched(&mut self) { self.console.exit_process(0); }
}
