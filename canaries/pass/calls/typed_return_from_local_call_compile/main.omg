// An ordinary call produces a typed value. The result may be bound to a local
// and used as the terminal value of another typed machine.

machine add_i32(left: i32 in Wrapping, right: i32 in Wrapping) -> i32 {
    left + right
}

machine return_local_call() -> i32 {
    let sum: i32 in Wrapping = add_i32(3, 4);
    sum as i32
}
