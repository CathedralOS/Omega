// The bind-first pairing: a RECURSIVE value-call result whose ONLY use is
// an INLINE call's argument (`let r = self.countdown(..); let d =
// self.plus1(r);`), inside a multi-call composition (guard-subject and
// transition-arg recursive calls in earlier states). Two heuristics
// collide on `r`: the liveness scan elides its LocalStorage slot (a
// later-`let` value is "covered by the alias fold") while the alias
// binding refuses to fold call-initialized locals (they "resolve to their
// call-result slot") -- so the serve sweep's let-bound gate must ask the
// AST (is the statement a bare-call `let`?), not scan the elided
// state_storage.locals. When the gate scanned locals, `r` had NO storage:
// the return edge wrote nothing, and the inline `v + 1` either
// name-captured the CALLER-scope `v` (fwd's param -- plus1's param shares
// its name deliberately, pinning the hygiene face; exit 73 silently) or,
// with distinct names, dropped the add outright. Exit 70 proves r's slot
// is allocated by the AST-gated sweep, written by the return edge, and
// read by name into the inline arg.
use omega::language::std::console;
data Main { console: Console; }
data Cnt { n: u64; }
measure Cnt::Order(n: u64) -> u64 { n }
machine Main::countdown(&mut self, c: Cnt)
terminates by c.n -> Cnt::Order;
-> u64
{
    transition c.n > 0 { true -> countdown(Cnt { n: c.n - 1 }) false -> 5 }
}
machine Main::plus1(&mut self, v: u64 [0..=100]) -> u64 { v + 1 }
machine Main::main(&mut self) {
    // TransitionArgument role: recursive result forwarded as an arg.
    transition self.countdown(Cnt { n: 3 }) == 5 { true -> fwd(self.countdown(Cnt { n: 2 })) _ -> bad_guard() }
    state fwd(&mut self, v: u64) {
        transition v == 5 { true -> callarg() _ -> bad_fwd() }
    }
    state callarg(&mut self) {
        let r: u64 = self.countdown(Cnt { n: 1 });
        let d: u64 = self.plus1(r);
        transition d == 6 { true -> good() _ -> bad_callarg() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad_guard(&mut self) { self.console.exit_process(71); }
    state bad_fwd(&mut self) { self.console.exit_process(72); }
    state bad_callarg(&mut self) { self.console.exit_process(73); }
}
