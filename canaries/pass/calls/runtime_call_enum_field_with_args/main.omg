data ItemKind {
    case RustedDagger;
    case DeepKey;
}

data Reward {
    item: ItemKind
}

data Main {
}

machine Main::main(
    &mut self,
    depth: u32,
    reward: &mut Reward
) {
    reward.item = self.pick(depth);
    
}

machine Main::pick(
    &mut self,
    depth: u32
    ) -> ItemKind {
    transition depth > 3 {
        true -> ItemKind::DeepKey
        false -> ItemKind::RustedDagger
    }
    
}
