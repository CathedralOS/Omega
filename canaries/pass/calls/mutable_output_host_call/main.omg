use omega::language::std::console;

domain [u8; 64]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Console;
    line: [u8; 64] in Utf8;
}

machine Main::main(&mut self) {
    self.console.write("> ");
    self.console.read_line(&mut self.line);
    self.console.write_line("read");
    self.console.exit_process(0);
}
