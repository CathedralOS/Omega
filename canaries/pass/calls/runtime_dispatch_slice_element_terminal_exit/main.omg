// RUN CANARY (exit 70) -- the DIRECT slice-element terminal (`-> s[j]`)
// from a dispatched value call, PROMOTED 2026-07-09k2 when the serve
// landed: the call-result return-write picks the indexed-copy kind BY
// TARGET REGION (a frame result slot rides
// CopyRuntimeFrameIndexedToRuntimeFrame; a machine place rides
// ...ToRuntimeStorage), exactly as the mutation path pairs them. The
// first probe emitted the machine-region kind against a frame slot and
// crashed (2026-07-09l, reverted) -- the region split IS the fix; no
// region-parametric encoder was needed. The FIELD-CARRIER idiom stays
// pinned by calls/runtime_dispatch_machine_array_slice_arg_exit.
use omega::language::std::console;
data Main { console: Console; nums: [i32; 4]; }
machine Main::pick(&mut self, s: &[i32], i: u64, j: u64)
terminates by (j, i) -> Nat::BoundedDistance;
-> i32
{
    transition j < i {
        true -> pick(s, i, j + 1)
        false -> leaf(s, j)
    }
    state leaf(&mut self, s: &[i32], j: u64) -> i32 {
        transition j < s.len { true -> leaf_go(s, j) _ -> leaf_zero() }
    }
    state leaf_go(&mut self, s: &[i32], j: u64) -> i32 { s[j] }
    state leaf_zero(&mut self) -> i32 { 0 }
}
machine Main::main(&mut self) {
    self.nums[0] = 5;
    self.nums[1] = 6;
    self.nums[2] = 7;
    self.nums[3] = 8;
    // Loop to j == 2, then return s[2] == 7.
    let n: i32 = self.pick(self.nums, 2, 0);
    transition n == 7 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
