// RUN CANARY (exit 70) -- PARAM-BINDING SERVE (landed 2026-07-11i,
// flipped from fail/calls/param_receiver_multi_instance_rejected): a
// spliced helper takes `&mut Tally` and calls through the param while
// TWO Tally instances exist; the caller passes the SECOND. The receiver
// chain walk binds `t := &mut self.second` at the descent (param
// environment) and resolves the param-receiver hop to second's storage
// -- the by-type walk read FIRST (silent-wrong 7-for-9 before the
// fence, then fenced, now SERVED). t.get() = 9 -> exit 70.
use omega::language::std::console;
data Tally { count: i32 in Wrapping; }
machine Tally::get(&mut self) -> i32 in Wrapping {
    transition true { true -> done(self.count) }
    state done(&mut self, value: i32 in Wrapping) -> i32 in Wrapping { value }
}
data Holder { first: Tally; second: Tally; }
machine Holder::probe(&mut self, t: &mut Tally) -> i32 in Wrapping {
    let v: i32 in Wrapping = t.get();
    transition true { true -> done(v) }
    state done(&mut self, v: i32 in Wrapping) -> i32 in Wrapping { v }
}
machine Holder::run(&mut self) -> i32 in Wrapping {
    self.first.count = 7;
    self.second.count = 9;
    let v: i32 in Wrapping = self.probe(&mut self.second);
    transition true { true -> done(v) }
    state done(&mut self, v: i32 in Wrapping) -> i32 in Wrapping { v }
}
data Main { console: Console; holder: Holder; flag: i32 in Wrapping; }
machine Main::main(&mut self) {
    self.flag = self.holder.run();
    transition self.flag == 9 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
