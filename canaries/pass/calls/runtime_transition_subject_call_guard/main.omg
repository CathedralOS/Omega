data Flag {
    value: bool;
}

data Main {
}

machine Main::main(&mut self, flag: Flag) {
    transition self.pick(flag) {
        true -> yes()
        false -> no()
    }
    

    state yes(&mut self) {}

    state no(&mut self) {}
}

machine Main::pick(&mut self, flag: Flag) -> bool {
    flag.value
}
