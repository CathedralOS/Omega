// RUN CANARY (exit 70) -- a dispatched value call (looping callee) whose
// TERMINAL returns a FIELD read (`state leaf ... { self.base }`). The
// return-write's copy hardcoded source_region RuntimeFrame, so a
// machine-region source offset read the FRAME at that offset and delivered
// garbage (native 71 vs interp 70 -- a live unfenced silent-wrong found by
// the open-work #7 return-write matrix, 2026-07-08o). Fixed: the copy uses
// the resolved place's REGION. Differential.
use omega::language::std::console;
data Main { console: Console; base: i32 in Wrapping; }
machine Main::count(&mut self, i: u64, j: u64)
terminates by (j, i) -> Nat::BoundedDistance;
-> i32 in Wrapping
{
    transition j < i {
        true -> count(i, j + 1)
        false -> leaf()
    }
    // Terminal returns a FIELD read (self.base), not a param.
    state leaf(&mut self) -> i32 in Wrapping { self.base }
}
machine Main::main(&mut self) {
    self.base = 42;
    let n: i32 in Wrapping = self.count(3, 0);
    transition n == 42 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
