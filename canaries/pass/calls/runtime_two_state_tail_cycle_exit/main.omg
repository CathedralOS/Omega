// RUN CANARY (exit 70) + interpreter differential. MR4's in-machine
// sub-rung: a TWO-STATE cycle (entry -> step -> entry) where the entry
// edge FORWARDS the measure unchanged (`step(n, acc)`, non-increasing)
// and the step edge strictly decreases (`self.sum(n - 1, ...)`, the MR2
// terminal-tail rewrite; positivity from step's DECLARED `[1..=100]`
// floor under the Exact domain). The ranking now classifies every
// in-cycle edge strict-or-non-increasing and requires the NON-STRICT
// subgraph be acyclic -- every cycle traversal then crosses a strict
// decrease. The all-forwarding twin refuses
// (fail/calls/forwarding_cycle_no_decrease_rejected).
use omega::language::std::console;
data Main { console: Console; }
machine Main::sum(&mut self, n: u64 [0..=100], acc: u64 [0..=5050])
terminates by n;
-> u64
{
    transition n > 0 && acc <= 4950 { true -> step(n, acc) _ -> leaf(acc) }
    state step(&mut self, n: u64 [1..=100], acc: u64 [0..=4950]) -> u64 { self.sum(n - 1, acc + n) }
    state leaf(&mut self, total: u64) -> u64 { total }
}
machine Main::main(&mut self) {
    let s: u64 = self.sum(4, 0);
    transition s == 10 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(70); }
    state no(&mut self)  { self.console.exit_process(71); }
}
