// RUN CANARY (exit 70) -- GENUINE tail self-call recursion, the natural
// accumulator spelling: an arm state whose terminal is a value call back
// into its own machine (`self.sum(n - 1, acc + n)`). PROMOTED 2026-07-10h
// when the TAIL-CALL-TO-LOOP transform landed end to end:
// (1) the state-call plan stamps qualified calls
//     StateCallLowering::DispatchLoop (self receiver + same machine + no
//     operations + single unguarded bare-call Terminal), so every INLINE
//     path skips them (the branching expansion previously consumed the
//     cyclic structure and overflowed selection's leaf-binding
//     substitution);
// (2) the runtime-flow builder rewrites the call edge as the
//     entry-transition LOOP (same context; the state's own dead terminal
//     is not emitted -- the loop's leaf terminal delivers the result to
//     the caller's slot);
// (3) statement_call_arguments descends into the terminal's TARGET_VALUE
//     (a terminal-embedded call has no operation and no transition
//     arguments), without which the loop carried NO rebinds and spun
//     forever (n stayed 4).
// Soundness pivots pinned: the receiver must be `self` (a contained
// same-machine receiver keeps the loud recursion rejection -- wrong
// instance), and plan/flow predicate drift is a loud error.
// Interp agrees via ordinary fresh-frame call semantics: 70 == 70.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::sum(&mut self, n: i32, acc: i32)
terminates { decreases n; }
-> i32
{
    transition n > 0 { true -> step(n, acc) false -> leaf(acc) }
    state step(&mut self, n: i32, acc: i32) -> i32 { self.sum(n - 1, acc + n) }
    state leaf(&mut self, acc: i32) -> i32 { acc }
}
machine Main::main(&mut self) {
    let s: i32 = self.sum(4, 0);
    transition s == 10 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
