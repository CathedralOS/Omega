// RECURSIVE value machine spelled with a `self.` receiver
// (`true -> self.countdown(remaining - 1)`): used to plan as a NESTED
// (contained-machine) transition whose inline-branching value path silently
// materialized 0 (native != interp). Now routed to the machine's own entry
// segment -- the same dispatch self-loop the bare-name spelling always took.
// countdown(2) -> base case 7 -> exit 1.
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
}
machine Main::countdown(&mut self, remaining: usize) -> usize
terminates {
    decreases remaining;
}
{
    transition remaining > 0 {
        true -> self.countdown(remaining - 1)
        false -> 7
    }
}
machine Main::main(&mut self) {
    let value: usize = self.countdown(2);
    transition value == 7 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
