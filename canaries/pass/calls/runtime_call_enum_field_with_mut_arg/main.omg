data ItemKind {
    case RustedDagger;
    case DeepKey;
}

data Reward {
    item: ItemKind
}

data Counter {
    value: u32
}

data Main {
}

machine Main::main(
    &mut self,
    counter: &mut Counter,
    reward: &mut Reward
) {
    reward.item = self.pick(counter);
    
}

machine Main::pick(
    &mut self,
    counter: &mut Counter
    ) -> ItemKind {
    transition counter.value > 3 {
        true -> ItemKind::DeepKey
        false -> ItemKind::RustedDagger
    }
    
}
