// RUN CANARY (exit 70, promoted 2026-07-19): a machine receives a threaded
// `&mut Rng`, forwards it through two mutating calls, evaluates a guard, then
// enters a trailing state that mutates and guards the same receiver again.
// Native formerly flattened the descendant guard with its inherited guard
// and re-evaluated `calls == 2` after the trailing bump made it 3 (exit 71).
// Exact transition scopes now evaluate each guard at its authored phase;
// exits 71/72 distinguish the outer/trailing stale-phase failures.
use omega::language::std::console;
data Rng { seed: u64 in Wrapping; calls: u32 in Wrapping; }
data Main { console: Console; rng: Rng; }
machine Main::bump(&mut self, r: &mut Rng) {
    r.seed = r.seed + 7;
    r.calls = r.calls + 1;
}
machine Main::build(&mut self, random: &mut Rng) -> u32 {
    self.bump(random);
    self.bump(random);
    transition random.calls == 2 {
        true -> after()
        _ -> (71)
    }
    state after(&mut self) -> u32 {
        self.bump(random);
        transition random.calls == 3 {
            true -> (70)
            _ -> (72)
        }
    }
}
machine Main::main(&mut self) {
    // `&mut self.rng` spelled explicitly (2026-07-18): the borrow-mutability
    // check now rejects a bare field lend for a `&mut` param -- the backend
    // phase divergence this canary pins is unchanged.
    let r: u32 = self.build(&mut self.rng);
    transition r == 70 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
