use omega::language::core::numeric_conversion;

data RandomState {
    seed: u64 in Wrapping;
    calls: UInt;
}

data Random {
}

machine Random::next_u32(&mut self, state: &mut RandomState) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;
    narrow_u64_to_u32_wrapping(state.seed >> 32)
}

machine Random::range(&mut self, state: &mut RandomState, exclusive_max: u32 in Wrapping) -> u32 {
    let raw: u32 in Wrapping = self.next_u32(state);
    raw % exclusive_max
}

data ItemKind {
    case RustedDagger;
    case DeepKey;
}

data RewardKind {
    case Gold;
    case GoldAndItem;
}

data Reward {
    kind: RewardKind;
    gold: u32 in Wrapping;
    item: ItemKind;
}

data Main {
    rng: Random;
}

machine Main::main(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState,
    reward: &mut Reward
) {
    reward.kind = RewardKind::GoldAndItem;
    reward.gold = 20 + depth * 8 + self.rng.range(random, 15);
    reward.item = self.pick(depth, random);
    
}

machine Main::pick(
    &mut self,
    depth: u32 in Wrapping,
    random: &mut RandomState
    ) -> ItemKind {
    let roll: u32 in Wrapping = self.rng.range(random, 100);

    transition {
        depth >= 8 && roll < 96 -> ItemKind::DeepKey
        _ -> ItemKind::RustedDagger
    }
}
