// RUN CANARY (exit 70) -- the tail-call-to-loop transform's PRIOR-OPS leg
// (relaxed 2026-07-10i): a value-spelling tail self-call preceded by real
// work in the same state. The prior op is dispatch-case work that runs
// BEFORE the loop edge, so it executes EVERY iteration: hits must equal 4
// (the effect count) AND the accumulator must deliver 10 (the result).
// Both together catch the two failure directions: a skipped case op
// (hits < 4) and a broken rebind/return (s != 10).
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; hits: i64 in Saturating; }
machine Main::sum(&mut self, n: i32, acc: i32)
terminates { decreases n; }
-> i32
{
    transition n > 0 { true -> step(n, acc) false -> leaf(acc) }
    state step(&mut self, n: i32, acc: i32) -> i32 {
        self.hits = self.hits + (1 as i64 in Saturating);
        self.sum(n - 1, acc + n)
    }
    state leaf(&mut self, acc: i32) -> i32 { acc }
}
machine Main::main(&mut self) {
    let s: i32 = self.sum(4, 0);
    transition s == 10 { true -> ck() _ -> bad(71) }
    state ck(&mut self) {
        transition self.hits == 4 { true -> good() _ -> bad(72) }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
