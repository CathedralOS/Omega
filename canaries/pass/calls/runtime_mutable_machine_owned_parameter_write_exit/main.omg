use omega::language::std::console;

data Room {
    exit_count: u32;
}

data Main {
    console: Console;
    room: Room;
}

machine Main::main(&mut self) {
    self.bump(&mut self.room);

    transition self.room.exit_count == 1 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(141);
    }

    state bad(&mut self) {
        self.console.exit_process(142);
    }
}

machine Main::bump(&mut self, room: &mut Room) {
    room.exit_count = 1;
}
