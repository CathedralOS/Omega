data Flag {
    value: bool;
}

machine main {
    pub entry(&mut self, flag: Flag) {
        transition self.pick(flag) {
            true -> yes()
            false -> no()
        }
    }

    state yes(&mut self) {}

    state no(&mut self) {}

    entry pick(&mut self, flag: Flag) -> bool {
        -> flag.value;
    }
}
