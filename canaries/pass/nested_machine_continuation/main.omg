platform Console {
    entry write_line(text: String);
    entry exit_process(return_code: i32);
}

data Banner {
    console: Console;
}

machine Banner::entry(&mut self) {
    self.console.write_line("nested");
}

data Main {
    banner: Banner;
    console: Console;
}

machine Main::main(&mut self) {
    self.banner.entry();
    self.console.write_line("continued");
    self.console.exit_process(0);
}
