platform Console {
    fn write_line(text: String);
    fn exit_process(return_code: i32);
}

data Banner {
    console: Console;
}

machine Banner::entry {
    pub entry(&mut self) {
        self.console.write_line("nested");
    }
}

data main {
    banner: Banner;
    console: Console;
}

machine main {
    pub entry(&mut self) {
        self.banner.entry();
        self.console.write_line("continued");
        self.console.exit_process(0);
    }
}
