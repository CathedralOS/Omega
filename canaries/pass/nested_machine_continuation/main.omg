platform Console {
    fn write_line(text: String);
    fn exit_process(return_code: i32);
}

machine Banner {
    contains console: Console;

    fn entry() {
        console.write_line("nested");
    }
}

machine main {
    contains banner: Banner;
    contains console: Console;

    fn entry() {
        -> banner.entry() -> shutdown();
    }

    state shutdown() {
        console.write_line("continued");
        console.exit_process(0);
    }
}
