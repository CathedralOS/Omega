// RUN CANARY (exit 70) + interpreter differential. M2 blocker 4:
// FREE-FLOATING consts are legal behind the SHADOWING WALK (landed
// 2026-07-11) -- a bare `PAGE_SIZE` reference substitutes a fresh copy
// of the literal initializer exactly like the `Type::NAME` form, and
// the walk guarantees no local/param/field/case/machine anywhere in the
// program spells the same name (collisions refuse at the const naming
// both sites: fail/constants/free_const_{local,field}_collision).
use omega::language::std::console;
const PAGE_SIZE: u32 = 64;
data Main { console: Console; }
machine Main::main(&mut self) {
    transition PAGE_SIZE == 64 { true -> yes() _ -> no() }
    state yes(&mut self) { self.console.exit_process(70); }
    state no(&mut self)  { self.console.exit_process(71); }
}
