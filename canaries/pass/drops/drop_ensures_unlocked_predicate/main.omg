// Chapter 17 spells a drop guarantee as `ensures self.mutex unlocked`: a named
// state predicate after a place. The proof-fact grammar accepts this predicate
// form and retains it as part of the cleanup contract.

data Mutex {
    locked: bool;
}

data MutexGuard {
    mutex: i32;
}

machine MutexGuard::drop(&mut self)
    ensures self.mutex unlocked
{
}

data Main {
}

machine Main::main(&mut self) {
}
