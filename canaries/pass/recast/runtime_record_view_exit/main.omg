// RUN CANARY (exit 70) + interpreter differential. RUNG C2 -- the
// Cathedral M2 shape: a RECORD re-viewed over a byte region at a RUNTIME
// offset (`&self.buf[off] as &Desc`), member reads through the view on
// BOTH engines. The view MATERIALIZES as a SNAPSHOT: the reference
// local's slot is sized by the REFEREE record (runtime-storage layout),
// the initializer byte-copies size_of(record) from base+offset (the C1
// indexed copy at the record's width), and member reads are ordinary
// frame-resident record reads. Legs pin the ALIGNMENT LOCKSTEP across
// the three sizing implementations (validation's footprint gate, the
// layout plan, the interp's field decode): Desc { a: u32; b: u64 } has
// b at natural offset 8 (4 bytes padding), so buf[off+8..] must read as
// d.b everywhere -- a drift in any copy reads garbage and this canary
// goes loud. Footprint refusals:
// fail/recast/record_view_footprint_rejected.
boundary trait Console { machine exit_process(return_code: i32); }
data Desc { a: u32; b: u64; }
data Main { console: Console; buf: [u8; 24]; k: u32 [0..=8]; out: i32; }
machine Main::main(&mut self) {
    self.buf[8] = 7;
    self.buf[16] = 9;
    self.k = 8;
    transition self.k == 8 { true -> read(self.k) _ -> bad() }
    state read(&mut self, off: u32 [0..=8]) {
        let d: &Desc = &self.buf[off] as &Desc;
        transition d.a == 7 && d.b == 9 {
            true -> good()
            _ -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
