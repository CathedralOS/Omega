// RUN CANARY (exit 70) + interpreter differential. M2 gap 4a -- the
// PER-EDGE MEET: `read` has TWO incoming edges (the guarded arm passing
// `self.k` under `k <= 6`, and `seed`'s constant `read(0)`), and the
// recast offset bound is their MAX (6): every edge must prove, the
// weakest bound wins, 6 + size(u32) <= 12 discharges. One edge widened
// past the footprint refuses (fail/recast/multi_edge_offset_meet_rejected).
use omega::language::std::console;
data Main { console: Console; buf: [u8; 12]; k: u32; }
machine Main::main(&mut self) {
    self.k = 4;
    transition self.k <= 6 { true -> read(self.k) _ -> seed() }
    state seed(&mut self) {
        transition { _ -> read(0) }
    }
    state read(&mut self, off: u32) {
        let v: &u32 = &self.buf[off] as &u32;
        transition v == 67305985 { true -> good() _ -> good() }
    }
    state good(&mut self) { self.console.exit_process(70); }
}
