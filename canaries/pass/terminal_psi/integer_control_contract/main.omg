// Source-to-terminal-Psi canary. The Psi-owned producer lowers these checked
// machines to self-contained semantic modules plus proofs; verification and
// execution then proceed after all frontend trees are dropped.
machine terminal_constant() -> i32
requires 7i32 == 7i32
ensures 7i32 == 7i32
{
    transition { _ -> pass(7i32) }
    state pass(value: i32) -> i32 { 7i32 }
}

machine terminal_wrapping_add() -> u8 in Wrapping
requires 44u8 == 44u8
ensures 44u8 == 44u8
{
    transition { _ -> calculate(200u8) }
    state calculate(value: u8 in Wrapping) -> u8 in Wrapping { value + 100u8 }
}

machine terminal_saturating_add() -> u8 in Saturating
requires 255u8 == 255u8
ensures 255u8 == 255u8
{
    transition { _ -> calculate(200u8) }
    state calculate(value: u8 in Saturating) -> u8 in Saturating { value + 100u8 }
}

machine terminal_wrapping_subtract() -> u8 in Wrapping
requires 251u8 == 251u8
ensures 251u8 == 251u8
{
    transition { _ -> calculate(5u8) }
    state calculate(value: u8 in Wrapping) -> u8 in Wrapping { value - 10u8 }
}

machine terminal_saturating_subtract() -> u8 in Saturating
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition { _ -> calculate(5u8) }
    state calculate(value: u8 in Saturating) -> u8 in Saturating { value - 10u8 }
}

machine terminal_wrapping_multiply() -> u8 in Wrapping
requires 4u8 == 4u8
ensures 4u8 == 4u8
{
    transition { _ -> calculate(20u8) }
    state calculate(value: u8 in Wrapping) -> u8 in Wrapping { value * 13u8 }
}

machine terminal_saturating_multiply() -> u8 in Saturating
requires 255u8 == 255u8
ensures 255u8 == 255u8
{
    transition { _ -> calculate(20u8) }
    state calculate(value: u8 in Saturating) -> u8 in Saturating { value * 13u8 }
}

machine terminal_ninth_parameter(
    first: u8,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8
) -> u8
requires 77u8 == 77u8
ensures 77u8 == 77u8
{
    ninth
}

machine terminal_runtime_wrapping_add(
    first: u8 in Wrapping,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 44u8 == 44u8
ensures 44u8 == 44u8
{
    ninth + first
}

machine terminal_runtime_nested_wrapping(
    first: u8 in Wrapping,
    second: u8 in Wrapping,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 132u8 == 132u8
ensures 132u8 == 132u8
{
    (ninth + first) * second
}

machine terminal_runtime_jump_wrapping(
    first: u8 in Wrapping,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 135u8 == 135u8
ensures 135u8 == 135u8
{
    transition { _ -> finish(ninth + first) }
    state finish(value: u8 in Wrapping) -> u8 in Wrapping { value * 3u8 }
}

machine terminal_runtime_chain_wrapping(
    first: u8 in Wrapping,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 134u8 == 134u8
ensures 134u8 == 134u8
{
    transition { _ -> multiply(ninth + first) }
    state multiply(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(value * 3u8) }
    }
    state finish(value: u8 in Wrapping) -> u8 in Wrapping { value - 1u8 }
}

machine terminal_runtime_saturating_add(value: u8 in Saturating) -> u8 in Saturating
requires 255u8 == 255u8
ensures 255u8 == 255u8
{
    value + 100u8
}

machine terminal_runtime_wrapping_subtract(value: u8 in Wrapping) -> u8 in Wrapping
requires 251u8 == 251u8
ensures 251u8 == 251u8
{
    value - 10u8
}

machine terminal_runtime_saturating_subtract(value: u8 in Saturating) -> u8 in Saturating
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    value - 10u8
}

machine terminal_runtime_wrapping_multiply(value: u8 in Wrapping) -> u8 in Wrapping
requires 4u8 == 4u8
ensures 4u8 == 4u8
{
    value * 13u8
}

machine terminal_runtime_saturating_multiply(value: u8 in Saturating) -> u8 in Saturating
requires 255u8 == 255u8
ensures 255u8 == 255u8
{
    value * 13u8
}

machine terminal_boolean_constant() -> bool
requires true == true
ensures true == true
{
    true
}

machine terminal_ninth_boolean(
    first: bool,
    second: bool,
    third: bool,
    fourth: bool,
    fifth: bool,
    sixth: bool,
    seventh: bool,
    eighth: bool,
    ninth: bool
) -> bool
requires true == true
ensures true == true
{
    ninth
}

machine terminal_boolean_chain(
    first: bool,
    second: bool,
    third: bool,
    fourth: bool,
    fifth: bool,
    sixth: bool,
    seventh: bool,
    eighth: bool,
    ninth: bool
) -> bool
requires true == true
ensures true == true
{
    transition { _ -> carry(ninth) }
    state carry(value: bool) -> bool {
        transition { _ -> finish(value) }
    }
    state finish(value: bool) -> bool { value }
}

data Main {}
machine Main::main(&mut self) {}
