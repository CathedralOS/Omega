machine terminal_boolean_constant() -> bool
requires true == true
ensures true == true
{
    true
}

machine terminal_boolean_not(value: bool) -> bool
requires false == false
ensures false == false
{
    !value
}

machine terminal_boolean_equal_false(value: bool) -> bool
requires false == false
ensures false == false
{
    value == false
}

machine terminal_boolean_equal_runtime(left: bool, right: bool) -> bool
requires true == true
ensures true == true
{
    left == right
}

machine terminal_integer_equal_runtime(left: u64, right: u64) -> bool
requires true == true
ensures true == true
{
    left == right
}

machine terminal_unsigned_less_runtime(left: u64, right: u64) -> bool
requires true == true
ensures true == true
{
    left < right
}

machine terminal_signed_less_or_equal_runtime(left: i64, right: i64) -> bool
requires true == true
ensures true == true
{
    left <= right
}

machine terminal_computed_greater_runtime(
    left: u64 in Wrapping,
    right: u64 in Wrapping
) -> bool
requires true == true
ensures true == true
{
    left + 1u64 > right * 2u64
}

