requires 0u32 == 0u32
ensures 0u32 == 0u32
{
    transition 1u32 <= divisor {
        true -> finish_wrapping_remainder_guarded_right(value % divisor)
        _ -> finish_wrapping_remainder_guarded_right(0u32)
    }

    state finish_wrapping_remainder_guarded_right(value: u32 in Wrapping) -> u32 in Wrapping {
        value
    }
}

machine terminal_saturating_divide_guarded_right(
