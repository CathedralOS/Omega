// Migration is ordinary typed machine code between separately declared era
// shapes. Historical identity is explicit and carries no compiler magic.

data CounterV1 {
    counter: i32;
}

data Counter {
    count: i32;
    timestamp: i32;
}

data Main {
}

machine Counter::from_v1(old: CounterV1, out: &mut Counter) {
    out.count = old.counter;
    out.timestamp = 7;
}

machine Main::main(&mut self) {
}
