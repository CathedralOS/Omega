// Regression test: a version block with MORE fields than the current body must
// still expose the synthesized historical type `Counter::v2` at the use sites.
// Bug (2026-06-12): when the version block had more fields than the current
// body, the synthesized `Counter::v2` definition lost its symbol assignment
// (positional desyncing), causing every `Counter::v2` reference to error.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Counter {
    version v2 {
        count: i64;
        extra: i64;
    }

    count: i64;
}

data Main {
    console: Console;
    raw: Versioned<Counter>;
}

machine Main::main(&mut self) {
    transition self.raw {
        Counter(current) -> new_era(current.count)
        Counter::v2(old) -> old_era(old.count)
    }
    state old_era(&mut self, count: i64) {
        self.console.exit_process(71);
    }
    state new_era(&mut self, count: i64) {
        self.console.exit_process(70);
    }
}
