// End-to-end migration between ordinary immutable era data. The migrated
// current value drives the exit: count becomes 7 and timestamp becomes 7.

use omega::language::std::console;
use omega::language::std::format_lineage;

data CounterDisk {
}

data CounterV1 {
    counter: i32 in Wrapping;
}

data Counter {
    count: i32;
    timestamp: i32;
}

data Main {
    console: Console;
}

machine Counter::from_v1(old: CounterV1, out: &mut Counter)
satisfies FormatMigration<CounterDisk, CounterV1, Counter>::migrate
{
    out.count = old.counter + 4;
    out.timestamp = 7;
}

machine Main::main(&mut self) {
    let old: CounterV1 = CounterV1 { counter: 3 };
    let current: Counter = Counter { count: 0, timestamp: 0 };
    Counter::from_v1(old, &mut current);
    transition current.count * 10 + current.timestamp == 77 {
        true -> good()
        false -> bad()
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
