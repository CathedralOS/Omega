// Historical formats are ordinary immutable era shapes plus an ordinary sum.
// There is no first-class data-version block or builtin container.

data CounterV1 {
    counter: i32 in Wrapping;
}

data Counter {
    counter: i32 in Wrapping;
    timestamp: i32 in Wrapping;
}

data CounterHistory {
    case Invalid;
    case V1(v1: CounterV1);
    case Current(current: Counter);
}

data Main {
}

machine Counter::tick(&mut self) {
    self.counter = self.counter + 1;
    self.timestamp = self.timestamp + 1;
}

machine CounterV1::tick(&mut self) {
    self.counter = self.counter + 1;
}

machine Main::main(&mut self) {
}
