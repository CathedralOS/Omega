// Chapter 22: a format package selects checked migration machines through a
// nominal lineage parameter. The historical shapes remain ordinary data.

use omega::language::std::format_lineage;

data CounterDisk {
}

data CounterNetwork {
}

data CounterV1 {
    counter: i32;
}

data Counter {
    counter: i32;
    timestamp: i32;
}

machine counter_v1_to_current(
    old: CounterV1,
    out: &mut Counter
) satisfies FormatMigration<CounterDisk, CounterV1, Counter>::migrate {
    out.counter = old.counter;
    out.timestamp = 0;
}

// The same carrier pair may belong to another independent history without
// aliasing the disk migration's nominal requirement identity.
machine network_counter_v1_to_current(
    old: CounterV1,
    out: &mut Counter
) satisfies FormatMigration<CounterNetwork, CounterV1, Counter>::migrate {
    out.counter = old.counter;
    out.timestamp = 1;
}

data Main {
}

machine Main::main(&mut self) {
}
