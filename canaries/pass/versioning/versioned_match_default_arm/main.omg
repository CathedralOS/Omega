// Version-match EXHAUSTIVENESS, default side: a `_` arm catches every
// fallthrough, so a version match handling only the historical v1 era closes
// the dispatch with `_` instead of naming the current era -- the version
// analogue of the `_`-closed case dispatches.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Counter {
    version v1 {
        counter: i32;
    }

    count: i32;
}

data Main {
    console: Console;
    raw: Versioned<Counter>;
}

machine Main::main(&mut self) {
    transition self.raw {
        Counter::v1(old) -> old_era(old.counter)
        _ -> other_era()
    }
    state old_era(&mut self, counter: i32) {
        self.console.exit_process(70);
    }
    state other_era(&mut self) {
        self.console.exit_process(71);
    }
}
