// An ordinary lineage sum may deliberately use a default route when policy
// does not require an explicit route per era.

data CounterV1 { counter: i32; }
data Counter { count: i32; }
data CounterHistory {
    case Invalid;
    case V1(v1: CounterV1);
    case Current(current: Counter);
}
data Main { raw: CounterHistory; }

machine Main::main(&mut self) {
    transition self.raw {
        CounterHistory::V1 { v1 as _ } -> done()
        _ -> done()
    }
    state done(&mut self) { }
}
