// Chapter 21 (Versioned Data): a version-scoped machine `Counter::increment::v1`
// type-checks `self` against the historical `Counter::v1` shape declared by the
// data's `version v1 { ... }` block, while the unqualified machine targets the
// current shape. Both bodies mutate fields that only exist in their own era.

data Counter {
    version v1 {
        counter: i32;
    }

    count: i32;
    timestamp: i32;
}

data Main {
}

machine Counter::increment::v1(&mut self) {
    self.counter = self.counter + 1;
}

machine Counter::increment(&mut self) {
    self.count = self.count + 1;
}

machine Main::main(&mut self) {
}
