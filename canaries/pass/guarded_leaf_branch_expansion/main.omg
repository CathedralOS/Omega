enum CellId {
    Empty,
    A1,
    A2,
}

data Cell {
    id: CellId;
    label: String;
}

data CellLine {
    text: String;
}

platform Console {
    entry write_line(text: String);
}

data Main {
    console: Console;
    selected: Cell;
    line: CellLine;
    first: Cell = Cell { id: CellId::A1, label: "A1" };
    second: Cell = Cell { id: CellId::A2, label: "A2" };
}

machine Main::main(&mut self) {
    scan(self.first, CellId::A2, mut self.selected);
    scan(self.second, CellId::A2, mut self.selected);
    self.line.text = self.selected.label;
    self.console.write_line(self.line.text);

    -> self();


    state scan(cell: Cell, id: CellId, out_cell: &mut Cell) {
        -> apply(cell, mut out_cell) when cell.id == id;
        ->
    }

    state apply(cell: Cell, out_cell: &mut Cell) {
        out_cell = cell;
    }
}
