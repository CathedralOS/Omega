// A fixed array of fixed records remains one aggregate `Repeated` schema
// field. Its whole extent follows the policy's `At` placement, while each
// element uses compiler-derived record padding and field offsets.
use omega::language::std::console;
use omega::language::core::layout;

data SpreadRecordArray { entries: [FieldEntry; 64]; }

machine SpreadRecordArray::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    self.entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 24 },
    };
    Plan {
        entries: self.entries,
        entry_count: 2,
        size_fixed: 32,
        size_is_dynamic: false,
        align: 8,
    }
}

data Pair {
    low: u16;
    high: u32;
}

data RecordArray {
    pairs: [Pair; 2];
    marker: u8;
}

data RecordArrayView { value: SpreadRecordArray<RecordArray>; }

data Main {
    console: Console;
    bytes: [u8; 32];
}

machine Main::main(&mut self) {
    let view: &mut RecordArrayView = &mut self.bytes[0] as &mut RecordArrayView;
    view.value.pairs[0].low = 0x0201;
    view.value.pairs[0].high = 0x06050403;
    view.value.pairs[1].low = 0x0807;
    view.value.pairs[1].high = 0x0c0b0a09;
    view.value.marker = 13;
    transition self.bytes[8] == 1 && self.bytes[9] == 2
        && self.bytes[12] == 3 && self.bytes[13] == 4
        && self.bytes[14] == 5 && self.bytes[15] == 6
        && self.bytes[16] == 7 && self.bytes[17] == 8
        && self.bytes[20] == 9 && self.bytes[21] == 10
        && self.bytes[22] == 11 && self.bytes[23] == 12
        && self.bytes[24] == 13
        && view.value.pairs[0].low == 0x0201
        && view.value.pairs[0].high == 0x06050403
        && view.value.pairs[1].low == 0x0807
        && view.value.pairs[1].high == 0x0c0b0a09
        && view.value.marker == 13 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
