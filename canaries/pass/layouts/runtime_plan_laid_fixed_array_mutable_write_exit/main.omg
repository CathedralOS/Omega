// A mutable byte-region view reaches a fixed primitive array through one
// validated aggregate `At` placement. Element writes must use the plan offset
// and element stride in both the interpreter and native lowering.
use omega::language::std::console;
use omega::language::core::layout;

data SpreadArray {
    entries: [FieldEntry; 64];
}

machine SpreadArray::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    self.entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 24 },
    };
    Plan {
        entries: self.entries,
        entry_count: 2,
        size_fixed: 32,
        size_is_dynamic: false,
        align: 8,
    }
}

data ArrayRecord {
    values: [u16; 3];
    marker: u8;
}

data ArrayView {
    value: SpreadArray<ArrayRecord>;
}

data Main {
    console: Console;
    bytes: [u8; 32];
}

machine Main::main(&mut self) {
    let view: &mut ArrayView = &mut self.bytes[0] as &mut ArrayView;
    view.value.values[0] = 0x0201;
    view.value.values[1] = 0x0403;
    view.value.values[2] = 0x0605;
    view.value.marker = 7;
    transition self.bytes[8] == 1 && self.bytes[9] == 2
        && self.bytes[10] == 3 && self.bytes[11] == 4
        && self.bytes[12] == 5 && self.bytes[13] == 6
        && self.bytes[24] == 7
        && view.value.values[0] == 0x0201
        && view.value.values[1] == 0x0403
        && view.value.values[2] == 0x0605
        && view.value.marker == 7 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
