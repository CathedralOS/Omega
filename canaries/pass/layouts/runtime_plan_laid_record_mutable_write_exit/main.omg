// RUN CANARY (exit 70) + interpreter differential. A mutable byte-region
// recast may project through a recursively fact-free wrapper into a plan-laid
// record. Writes use the policy's deliberately non-native offsets and reads
// observe the same live bytes on both engines.
use omega::language::std::console;
use omega::language::core::layout;

data Spread {
    entries: [FieldEntry; 64];
}

machine Spread::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    self.entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 24 },
    };
    Plan {
        entries: self.entries,
        entry_count: 2,
        size_fixed: 32,
        size_is_dynamic: false,
        align: 8,
    }
}

data ForeignRecord {
    low: u16;
    high: u64;
}

data ForeignView {
    value: Spread<ForeignRecord>;
}

data Main {
    console: Console;
    bytes: [u8; 32];
}

machine Main::main(&mut self) {
    let view: &mut ForeignView = &mut self.bytes[0] as &mut ForeignView;
    view.value.low = 0x0201;
    view.value.high = 0x0807060504030201;
    transition self.bytes[8] == 1 && self.bytes[9] == 2
        && self.bytes[24] == 1 && self.bytes[25] == 2
        && self.bytes[26] == 3 && self.bytes[27] == 4
        && self.bytes[28] == 5 && self.bytes[29] == 6
        && self.bytes[30] == 7 && self.bytes[31] == 8
        && view.value.low == 0x0201
        && view.value.high == 0x0807060504030201 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
