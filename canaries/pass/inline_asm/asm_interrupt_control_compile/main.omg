// COMPILE CANARY (linux_x64 freestanding): CLI/STI carry MachineControl reach,
// require the boot-root machine-owner discharge, record their distinct IF
// transitions, and emit exact x86 opcodes. The suite also selects linux_arm64
// for this source and pins the target-specific refusal.
use omega::language::core::assembly;

data Main {}

machine Main::main(&mut self) reaches MachineControl {
    asm where clobbers none {
        cli;
        sti
    }
}

target linux_x64 {
}

target linux_arm64 {
}
