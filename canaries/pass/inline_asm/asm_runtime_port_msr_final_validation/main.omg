// COMPILE CANARY (linux_x64 freestanding): runtime port and MSR operands keep
// their exact operand boundaries around independently validated privileged
// opcode envelopes. Reads also retain their compiler-owned destination
// relocations.
use omega::language::core::assembly;

data Main {
    port: u16;
    byte: u8;
    index: u32;
    value: u64;
    result: u64;
}

machine Main::main(&mut self)
reaches MachineControl + PortIo
{
    asm where clobbers rax, rcx, rdx, r10, r11, r15 {
        out self.port, self.byte;
        in self.byte, self.port;
        rdmsr self.result, self.index;
        wrmsr self.index, self.value
    }
}

target linux_x64 {
}
