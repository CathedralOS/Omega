// PENDING: Vec mutation/reallocation must reject while borrowed slice views are
// still active, mirroring the array/slice owner-write rule. This depends on the
// Vec runtime/lowering being ready and on `Vec<T>` being usable as machine-owned
// storage with a borrow-producing `as_slice`. Until then this canary is parked
// here unregistered (see ACTIVE_PENDING_CANARIES) so the intended rule is
// recorded without asserting a current diagnostic.

use omega::language::core::vec;

data Main {
    items: Vec<u8>;
}

machine Main::main(&mut self) {
    let view: &[u8] = self.items.as_slice();
    self.items.push(7);
    let probe: u8 = view[0];
}
