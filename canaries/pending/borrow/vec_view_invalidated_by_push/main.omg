// PENDING: Vec mutation/reallocation must reject while borrowed slice views are
// still active, mirroring the array/slice owner-write rule.
//
// STATUS: the borrow-conflict RULE is implemented. `Vec::push` is a `&mut self`
// mutating call on the owner; the owner-mutation-through-a-call rule in
// checks/borrows/statements.rs (`check_call_mutation_borrows`) rejects such a
// call when its mutated places overlap a live borrowed view. That rule is
// exercised today by the registered fail canary
// `borrow/slice_view_invalidated_by_owner_call`, the array-form analogue of
// this Vec case.
//
// WHY STILL PENDING: this exact spelling does not yet type-check. `Vec<T>` is
// not a usable machine-owned data type -- symbol resolution reports
// `data `Main` field `items` references unknown generic type `Vec``, so the
// program is rejected at name/type resolution before borrow checking runs. Once
// `Vec<T>` lowers as machine-owned storage with a borrow-producing `as_slice`
// and a `&mut self` `push`, promote this to a registered fail canary asserting
// the borrow-conflict diagnostic at the `push` call. Until then it stays parked
// here unregistered (see ACTIVE_PENDING_CANARIES).

use omega::language::core::vec;

data Main {
    items: Vec<u8>;
}

machine Main::main(&mut self) {
    let view: &[u8] = self.items.as_slice();
    self.items.push(7);
    let probe: u8 = view[0];
}
