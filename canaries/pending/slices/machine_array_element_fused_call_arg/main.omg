// PENDING (2026-07-10j, NATIVE silent-wrong + a MISSING-BLOCKER hole; found
// sweeping the register-clobber fix's blast radius): a MACHINE array's
// runtime-indexed element inside a FUSED value-call arg
// (`self.pick(self.k + self.arr[i])`). The backend report shows the
// substituted callee computation is ENTIRELY ABSENT -- the dispatch case
// holds only the result copy + guard compare; the result slot reads
// whatever ZII/garbage is there (native 71, interp 70). TWO facets:
// (a) the canonical ValueOperand enum has NO MachineIndexed variant, so a
//     machine-region indexed read is unresolvable in operand position and
//     the binary write selection bails;
// (b) that bail was SILENT -- the call-result blockers (which fire loudly
//     for the termination canaries' unserved shapes) did not fire here.
//     Facet (b) is the dangerous one: find WHY the unlowered result write
//     escaped emission planning, fence it, THEN decide whether to add the
//     MachineIndexed operand variant or hoist machine-indexed args.
// The LOCAL-array twin (frame region) works
// (pass/slices/runtime_local_array_element_value_operand_exit); the plain
// non-fused machine-array arg presumably rides the arg-hoist path.
// PROMOTE (pass/slices + differential, expected 70/70) when the shape is
// served; expect an intermediate LOUD state once facet (b) is fenced.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; arr: [i32; 3]; idx: usize; k: i32; }
machine Main::pick(&mut self, v: i32 [0..=100]) -> i32 { v + 1 }
machine Main::main(&mut self) {
    self.arr = [10, 20, 30];
    self.idx = 1;
    self.k = 7;
    transition self.idx < 3 { true -> go(self.idx) _ -> bad() }
    state go(&mut self, i: usize [0..=2]) {
        let d: i32 = self.pick(self.k + self.arr[i]);
        transition d == 28 { true -> good() _ -> bad() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
