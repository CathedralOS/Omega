// PENDING canary (ch17 "Fire And Forget"): `spawn { ... }` runs a block
// concurrently. The concurrency primitive is unimplemented -- `spawn` is not a
// keyword, so the block body (a `Logger::write(...)` call statement) fails to
// parse. Captures the real parser diagnostic for the gap.

data Logger {
}

machine Logger::write(line: String) {
}

data App {
}

machine App::run(&mut self, message: String) {
    spawn {
        Logger::write(message);
    }
}

data Main {
}

machine Main::main(&mut self) {
}
