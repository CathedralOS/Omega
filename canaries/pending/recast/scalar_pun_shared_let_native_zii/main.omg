// PENDING PIN (2026-07-09, the rung-A landing's known native gap): the
// JUDGED shared scalar recast -- `let v: &f32 = &self.bits as &f32` with
// equal widths -- serves on the INTERPRETER (eval_recast bit-reinterprets:
// 0x40490FDB reads as pi, u32 0xFFFFFFFF reads as i32 -1) but natively
// the let's initializer WRITE vanishes: reference locals materialize by
// copying the pointee VALUE into a pointer-sized frame slot, and the
// write-planning value resolution has no arm for a recast Cast node, so
// the slot stays ZII zero and the guard compares 0 (exit 71 at the first
// leg). Note the guard operand layout ALSO reads the slot 8-bytes-wide
// against an f64 literal for a stated &f32 -- the next rung must land
// BOTH: (a) the let write byte-copies the source place's bytes, (b) reads
// through the view use the STATED type's width/kind. Fixing (a) alone
// leaves a 4-byte pattern under an 8-byte f64 compare (still 71).
// hold: (71, Exit(70)) -- interp puns correctly, native reads ZII.
boundary trait Console { machine exit_process(return_code: i32); }
data Main {
    console: Console;
    bits: i32;
    wide: u32;
}
machine Main::main(&mut self) {
    // 0x40490FDB = the f32 bit pattern of pi.
    self.bits = 1078530011;
    let v: &f32 = &self.bits as &f32;
    transition v > 3.14 && v < 3.15 {
        true -> sign_pun()
        _ -> bad_float()
    }
    state sign_pun(&mut self) {
        self.wide = 4294967295;
        let s: &i32 = &self.wide as &i32;
        transition s == -1 {
            true -> good()
            _ -> bad_sign()
        }
    }
    state good(&mut self)      { self.console.exit_process(70); }
    state bad_float(&mut self) { self.console.exit_process(71); }
    state bad_sign(&mut self)  { self.console.exit_process(72); }
}
