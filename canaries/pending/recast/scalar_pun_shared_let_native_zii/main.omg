// PENDING PIN (2026-07-09, the rung-A landing's known native gap): the
// JUDGED shared scalar recast -- `let v: &f32 = &self.bits as &f32` with
// equal widths -- serves on the INTERPRETER (eval_recast bit-reinterprets:
// 0x40490FDB reads as pi, u32 0xFFFFFFFF reads as i32 -1) but natively
// the divergence is READ-side only now: fix (a) LANDED (2026-07-09) --
// the recast strips to its source place at the initializer write
// (strip_recast_initializer, runtime_dispatch.rs) and the slot receives
// the source's bit pattern (report: write runtime_frame_storage@0
// bytes 8 value 1078530011); en route, EIGHT backend cast-rebuild sites
// that hardcoded CastForm::Value now forward the source form (the
// recast-ness was silently erased in the alias/binding rebuilds).
// REMAINING fix (b): reads through the view must use the STATED type's
// width/kind -- the guards operand layout presents the SLOT width
// (bytes 8) and float literals always encode as f64 bits (state-guards
// operands/values.rs), so a &f32 guard compares 8 bytes via comisd
// against f64 3.14 (still 71). The (b) legs: Reference-to-scalar slots
// present the REFEREE width in operands/layout.rs; the literal encodes
// f32 bits when the other operand is f32-stated; and the compare
// emission needs a 4-byte float leg (comiss / fcmp s-regs) on BOTH ISAs.
// hold: (71, Exit(70)) -- interp puns correctly, native reads ZII.
boundary trait Console { machine exit_process(return_code: i32); }
data Main {
    console: Console;
    bits: i32;
    wide: u32;
}
machine Main::main(&mut self) {
    // 0x40490FDB = the f32 bit pattern of pi.
    self.bits = 1078530011;
    let v: &f32 = &self.bits as &f32;
    transition v > 3.14 && v < 3.15 {
        true -> sign_pun()
        _ -> bad_float()
    }
    state sign_pun(&mut self) {
        self.wide = 4294967295;
        let s: &i32 = &self.wide as &i32;
        transition s == -1 {
            true -> good()
            _ -> bad_sign()
        }
    }
    state good(&mut self)      { self.console.exit_process(70); }
    state bad_float(&mut self) { self.console.exit_process(71); }
    state bad_sign(&mut self)  { self.console.exit_process(72); }
}
