// PENDING only for x86_64. Saturating `<<` by an at/above-width count
// clamps every nonzero x to the saturation bound (3u32 << 40 -> u32::MAX);
// the interp node arm and the aarch64 sequences conform (70/70 on the
// arm64 host). x86_64 still wraps; PROMOTE to pass/ with its sequences.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: u32 in Saturating = (3 as u32 in Saturating);
    let c: u32 in Saturating = (40 as u32 in Saturating);
    let s: u32 in Saturating = a << c;
    transition s == 4294967295 {
        true  -> clamped()
        false -> chk_zero()
    }
    state chk_zero(&mut self) {
        transition s == 0 {
            true  -> wrapped()
            false -> bad()
        }
    }
    state clamped(&mut self) { self.console.exit_process(70); }
    state wrapped(&mut self) { self.console.exit_process(71); }
    state bad(&mut self)     { self.console.exit_process(72); }
}
