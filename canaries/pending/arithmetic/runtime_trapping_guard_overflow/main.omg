// PENDING (2026-07-09c, NATIVE silent missed trap -- waiting on
// OPERAND-POSITION domain lowering): Trapping arithmetic FUSED into a guard
// operand compiles to the PLAIN add, so 200 + 100 in `u8 in Trapping` never
// traps -- it computes 300 wide, the byte-width compare truncates to 44, and
// the program exits 70 having sailed past its overflow check. The INTERPRETER
// traps here (exit: trap) since the expression-domain fix. Trapping is
// deliberately NOT fenced by the operand-domain blocker (unlike Saturating,
// where the fused op reads WRONG VALUES): for every non-overflowing input the
// plain op is value-identical, and the corpus uses `in Trapping` pervasively
// as checked-arithmetic style -- fencing it rejects green programs wholesale
// (binary_search, mandelbrot, ...). The store-position trap works
// (pass/arithmetic/runtime_trapping_overflow_traps).
// PROMOTE (as a native-traps canary, no exit-70 leg) when the
// operand-position trap sequence lands in both ISAs.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; au: u8 in Trapping; bu: u8 in Trapping; }
machine Main::main(&mut self) {
    self.au = 200;
    self.bu = 100;
    // Should TRAP at the guard's fused add; natively exits 70 today.
    transition (self.au + self.bu == 44) { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
