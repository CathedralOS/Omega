// PARKED REPRO (probe 2026-07-04; FIRST FACE FIXED 2026-07-18): const-folded
// unsigned right-shift miscompiles. TWO faces, one repro:
//
// FACE 1 (the FOLDER -- FIXED, CM2 first rung): the state-values folder held
// integers as bare i64, so `0u32 - 2` folded to `-2` and `-2 >> 1` folded
// ARITHMETIC to `-1`. Now fold_binary_expression takes a LANDED type -- the
// DESTINATION landing (the let/assignment target's declared
// width/signedness/domain) threads through the simplifier's value spine --
// and folds at u32: `0 - 2` -> 4294967294, `4294967294 >> 1` LOGICAL ->
// 2147483647. VERIFIED: backend_report shows `y`'s own slot written with
// 2147483647.
//
// FACE 2 (the ARG DELIVERY -- STILL OPEN, keeps this repro diverging, native
// 71 vs interp 70): the transition arg `report(y)` does NOT copy y's
// correctly-written slot. Selection's alias layer substitutes y's INITIALIZER
// TREE and lowers it as a typeless nested runtime binary --
// `(0 Subtract/8 2) ShiftRight 1` -- whose shift defaults SIGNED: the
// constant local `a` was substituted away (no slot), so
// classify_scalar_value_type cannot recover u32; the only remaining type
// truth is the WRITE TARGET (report's u32 param). Fix directions:
// (i) stop re-deriving -- a slot-backed local arg should COPY its slot (the
// CopyRuntimeStorage arm in frame_slots.rs fires if the arg stays `Name(y)`;
// needs the alias-substitution layer + storage slotting twin to agree), or
// (ii) resolve the binary write's signedness/width from the write TARGET when
// the operands are typeless. Selection files -- coordinate with the RECAST
// lane.
//
// Runtime (field-held) unsigned shifts are CORRECT (locked by
// canaries/pass/arithmetic/runtime_shift_right_signedness).

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let a: u32 in Wrapping = 0;
    let b: u32 in Wrapping = a - 2;   // folds to i64 -2 (should be u32 4294967294)
    let y: u32 in Wrapping = b >> 1;  // folds to i64 -1 => u32 0xFFFFFFFF (WRONG)

    // native takes `false` (0xFFFFFFFF != 2147483647) and exits 71;
    // interpreter takes `true` and exits 70.
    transition y == 2147483647 {
        _ -> report(y)
    }

    state report(&mut self, y: u32 in Wrapping) {
        transition y == 2147483647 {
            true -> good()
            false -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
