// PARKED REPRO (silent miscompile -- decision-17 narrowing not enforced at the
// CALL-ARGUMENT boundary). `self.big` is an i64 holding 300; it is passed to a
// parameter `x: i8`. The assignment boundary rejects this (`let z: i8 = self.big`
// => "narrowing assignment ... not provably in range"), but the call-argument
// boundary does NOT: this compiles clean at --check and --build-dir and RUNS,
// silently truncating 300 to i8 (300 & 0xFF = 44) -> exit 44.
//
// Decision-17 treats a narrowing store as a proof obligation and enforces it at
// the assignment / let-initializer / transition-value / return boundaries, but
// NOT at call args (a 5th boundary). The class check (cross_class_conflict) folds
// all numerics into ONE class, so it deliberately does not catch numeric width
// narrowing here -- that is this range check's job.
//
// FIX SKETCH: thread `&ValueEnv` into validate_call_node / the transition path /
// validate_call_arguments_handles, and for each primitive-typed parameter run
// arithmetic_domains::validate_value_range(arg, env, Some(param_primitive)) +
// check_narrowing_assignment, exactly as the assignment path does (honors
// dominating guards, so no false positive on guarded args). VALUE-position calls
// are the wrinkle: they run in a separate post-pass (lib.rs ~137) with the env in
// its final, not per-statement, state -- that sub-case needs the value-position
// arg-narrowing to move inside the per-statement loop first. Watch for NEW
// overflow diagnostics on existing samples (args were never range-checked before).

boundary trait Console {
    machine exit_process(code: i32)
    effects
        process_exit;
}

data Main {
    console: Console;
    big: i64 in Wrapping;
}

machine Main::take_i8(&mut self, x: i8) -> i32 {
    transition { _ -> (x as i32) }
}

machine Main::main(&mut self) -> i32 {
    self.big = 300;
    let r: i32 = self.take_i8(self.big); // i64 300 -> i8 param, silently truncates to 44

    transition { _ -> done(r) }
    state done(&mut self, code: i32) { self.console.exit_process(code); }
}
