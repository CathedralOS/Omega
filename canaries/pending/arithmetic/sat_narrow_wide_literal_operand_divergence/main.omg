// PENDING only for x86_64 (aarch64 + interp FIXED 2026-07-16). The MIN
// idiom `0 - 2147483648` (Omega has no negative literals) computes MIN on
// the interp (wide i128 at the node) and now on aarch64: the sat/trap
// narrow paths sign-extend only NON-IMMEDIATE operands (an immediate is
// loaded at its true wide value; re-extending it from the target width
// corrupted 2147483648 into -2^31 and saturated the subtraction to MAX).
// Per-side is-immediate flags thread from the write/operand callers with
// the width twin in lockstep; the saturating-shl value extension shares
// the skip. x86_64 REMAINS WRONG two ways: its multiply prologue movsx
// needs the same per-side skip, and its flag-width add/sub cannot hold a
// wide immediate at all -- migrate them to the wide 64-bit op + the shared
// narrow_range_clamp_or_trap tail (with the same per-side extension skip),
// then PROMOTE this to pass/ with a linux_x64 byte pin.
// exits: 70 = MIN (correct); 71 = MAX (the corruption); 99 = other.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 in Saturating = (0 as i32 in Saturating) - 2147483648;
    transition a == (0 as i32 in Saturating) - 2147483647 - 1 {
        true  -> is_min()
        false -> chk_max()
    }
    state chk_max(&mut self) {
        transition a == 2147483647 {
            true  -> is_max()
            false -> other()
        }
    }
    state is_min(&mut self) { self.console.exit_process(70); }
    state is_max(&mut self) { self.console.exit_process(71); }
    state other(&mut self)  { self.console.exit_process(99); }
}
