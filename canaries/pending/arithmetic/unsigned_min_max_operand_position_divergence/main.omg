// PENDING (native-vs-interp divergence, pinned 2026-07-18). The
// OPERAND-POSITION twin of the fixed unsigned_min_max_wrapping_local_exit:
// `max(big, 5) + 0` nests the builtin call inside a binary, so no WRITE
// TARGET exists for the max itself and the target-signedness fallback cannot
// serve -- native compares SIGNED (picks 5, exit 78) while the interpreter
// takes the unsigned witness u64::MAX (exit 77).
//
// ROOT (carrier CR3, traced 2026-07-18): the constant flows through
// selection's static-value table (RuntimeStaticValues, PlaceKey -> i64),
// which STRIPS the landing the state-values folder stamps on fold results
// (carrier CR2) -- every literal reaching the signedness resolver traces
// landing=None. The landing-aware resolver arm is ALREADY IN PLACE
// (resolve_runtime_storage_is_signed_in_table); the fix rung is the static
// table carrying the landing (store the stamped literal or (i64, landing)
// and re-stamp on substitution). Promote when that rung lands.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let z: u64 in Wrapping = 0;
    let big: u64 in Wrapping = z - 1;
    let m: u64 in Wrapping = max(big, 5) + 0;
    transition m == big {
        true -> good()
        false -> bad()
    }
    state good(&self) { self.console.exit_process(77); }
    state bad(&self) { self.console.exit_process(78); }
}
