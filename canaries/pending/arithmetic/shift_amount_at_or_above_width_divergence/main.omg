// PARKED: x86 wrapping-shl count-clamp tracker (was: undecided divergence).
//
// RULED (Zach, 2026-07-13, shift-domain ruling): Wrapping `<<` is MODULAR --
// x * 2^n (mod 2^w) -- so a count >= the operand width yields 0. The lhs
// domain defines shift semantics; the count carries no domain weight.
//
// CONFORMING (this canary exits 72/72 = the modular-0 path on both):
//   interp   -- uniformly modular at every width (was count-masked at 64).
//   aarch64  -- CMP count,#width + CSEL XZR clamp in the domain-aware
//               binary-op wrapper (LSLV alone masks the count mod 64).
// PENDING -- x86: `shl` masks the count to the register width in hardware
// (40 & 31 = 8), so native x86 gives 1 << 8 = 256 and exits 70. This canary
// stays parked until the x86 count-clamp lands; then rework exits so the
// modular-0 path is 70 and promote to pass/ alongside the at-width legs in
// pass/arithmetic/runtime_shift_count_domain_exit (u32/u64; this one pins
// signed i32).
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; n: i32 in Wrapping; }
machine Main::main(&mut self) {
    self.n = 40;
    let a: i32 in Wrapping = 1;
    let y: i32 in Wrapping = a << self.n;
    transition y == 256 {
        true  -> masked_to_width()   // native (40 & 31 = 8 -> 256)
        false -> other()
    }
    state masked_to_width(&mut self) { self.console.exit_process(70); }
    state other(&mut self) {
        transition y == 0 {
            true  -> shifted_in_i64()  // interp (1 << 40 truncated -> 0)
            false -> weird()
        }
    }
    state shifted_in_i64(&mut self) { self.console.exit_process(72); }
    state weird(&mut self)          { self.console.exit_process(99); }
}
