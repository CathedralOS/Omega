// PARKED REPRO (probe 2026-07-04): const-folded Trapping overflow BYPASSES the trap.
// The decision-17 const-fold DOMAIN hole (memory decision-17-const-fold-domain-hole)
// -- a fresh Trapping i32 face of the same metadata-erasure root as the signedness
// class (memory shift-right-signedness-const-fold, repros const_fold_unsigned_*).
//
// `a` is a Trapping i32 const; `a + a` = 4000000000 overflows i32 and MUST trap.
// But `a` inlines to a DOMAINLESS integer literal, so combine(Exact,Exact)=Exact
// and the ud2 trap check never lowers -> native runs PAST the overflow to exit 70.
// The interpreter (oracle) TRAPS (InterpretOutcome::error). RUNTIME trapping is
// correct and locked by arithmetic/runtime_trapping_overflow_traps; only
// fully-const operands slip past.
//
// FIX = domain-aware constant folding (bare constants carry an optional domain;
// fold applies Saturating-clamp / Trapping-trap; literal-store paths clamp/trap an
// out-of-range domained constant). Semantic question for Zach flagged in memory.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let a: i32 in Trapping = 2000000000;
    let b: i32 in Trapping = a + a;   // 4000000000 overflows i32 -> MUST trap; native does not
    transition { _ -> reached(b) }
    // reaching here at all is the bug: a correct Trapping overflow aborts before this.
    state reached(&mut self, b: i32 in Trapping) { self.console.exit_process(70); }
}
