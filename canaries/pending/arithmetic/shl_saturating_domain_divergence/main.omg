// PENDING only for x86_64 (was: design-undecided divergence). Shifts are
// domain-governed (shift-domain ruling): Saturating `<<` clamps when the
// TRUE value x * 2^n leaves the type's range. The INTERPRETER node arm and
// the AARCH64 sequences (count capped at the width + exact 64-bit shift +
// range-check tail; recovery-compare at 64-bit) both conform -- this canary
// runs 70/70 on the arm64 host. x86_64 still lowers the plain shl (wraps);
// PROMOTE to pass/ when its clamp/trap sequences land.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; a: u8 in Saturating; b: u8 in Saturating; r: u8 in Saturating; }
machine Main::main(&mut self) {
    self.a = 17;
    self.b = 4;
    self.r = self.a << self.b;
    transition self.r == 255 { true -> clamped() _ -> chk16() }
    state chk16(&mut self) {
        transition self.r == 16 { true -> wrapped() _ -> bad() }
    }
    state clamped(&mut self) { self.console.exit_process(70); }
    state wrapped(&mut self) { self.console.exit_process(72); }
    state bad(&mut self) { self.console.exit_process(71); }
}
