// PARKED REPRO (probe 2026-07-04; FOLDER FACE FIXED 2026-07-18): const-folded
// unsigned DIVISION miscompiles -- same two-face split as
// const_fold_unsigned_shift_right_miscompile (READ ITS HEADER for the full
// diagnosis).
//
// b = 0xFFFFFFFE (4294967294).  b / 3 for u32 = 1431655764.
// FOLDER face FIXED (CM2 first rung): the destination-landed fold computes
// `0 - 2` at u32 -> 4294967294 and `4294967294 / 3` UNSIGNED -> 1431655764;
// modulo folds to 2. ARG-DELIVERY face still open: `report(y)` re-derives the
// value as a typeless runtime binary whose division defaults SIGNED --
// native 71 vs interp 70 until the selection-side face is fixed (see the
// shift repro's header for the two fix directions).
//
// Shift, divide, modulo are the sign-sensitive ops; +,-,*,&,|,^,<< agree mod
// 2^width under truncation. RUNTIME (field-held) unsigned division is correct
// and locked by arithmetic/runtime_unsigned_division_exit.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let a: u32 in Wrapping = 0;
    let b: u32 in Wrapping = a - 2;   // folds to i64 -2 (true u32 value 4294967294)
    let y: u32 in Wrapping = b / 3;   // folds to i64 0 (should be 1431655764)

    transition y == 1431655764 {
        _ -> report(y)
    }

    state report(&mut self, y: u32 in Wrapping) {
        transition y == 1431655764 {
            true  -> good()
            false -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
