// PENDING (2026-07-10, parked by the arithmetic thread -- UNMASKED by the
// collect-all pass_canaries_compile umbrella): authored 2026-05-27 as a
// termination-proof compile pin and GREEN for six weeks, then loudly
// regressed by the 2026-07-09 return-write fence (936fc62c1, fs lane): the
// dispatched value call's terminal is a PARAM-STRUCT-FIELD read
// (`card.power`), a shape the return-write matrix does not serve yet --
// running it would silently leave the caller's result as ZII, so the fence
// is CORRECT to refuse. The efi-first umbrella panic hid the regression
// until the umbrella went collect-all.
// PROMOTE (back to pass/termination) when the fs lane's return-write matrix
// serves the param-field terminal row; the termination proof itself still
// checks (that was this canary's purpose).
data Card {
    power: usize;
}

measure Card::PowerOrder(power: usize) -> usize { power }

data Main {
}

machine Main::main(&mut self) {
    let value: usize = self.weaken(Card { power: 3 });
}

machine Main::weaken(&mut self, card: Card)
terminates {
    decreases card.power -> Card::PowerOrder;
}
-> usize
{
    transition card.power > 0 {
        true -> weaken(Card { power: card.power - 1 })
        false -> card.power
    }
}
