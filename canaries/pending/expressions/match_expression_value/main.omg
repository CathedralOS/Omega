// Chapter 6 "Match Expressions": expression-level `match` chooses a
// value-producing arm. Omega does not yet parse `match` in expression position.
enum Command {
    Quit,
    Look,
    Invalid,
}

data Main {
}

machine Main::main(
    &mut self,
    out: &mut i32
) {
    let command: Command = Command::Look;

    let code: i32 = match command {
        Command::Quit -> 1
        Command::Look -> 2
        Command::Invalid -> 3
    };

    out = code;
}
