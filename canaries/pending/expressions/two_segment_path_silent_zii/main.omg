// PENDING repro (2026-07-08, found while probing provides-value V2): an
// UNRESOLVED two-segment path in value position (`Nowhere::NOPE + 7`)
// compiles with NO errors and reads ZII 0 -- native exit 71 here (0+7=7,
// guard falls to bad) and the interpreter agrees, so the differential
// cannot catch it. The BARE-name existence check is CLOSED
// (undeclared_bare_name_rejected); this is its multi-segment sibling:
// a path that names no const, no case, no provides value, and no known
// scope should be a compile error at resolution.
boundary trait Console { machine exit_process(return_code: i32); }
boundary trait Beeper { machine noop(); }
data Main { console: Console; }
local_unchecked provides Beeper {
    MAGIC -> 63;
    DELTA -> 7;
}
machine Main::main(&mut self) {
    let code: i32 = Nowhere::NOPE + 7;
    transition code == 70 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code2: i32) { self.console.exit_process(code2); }
}
