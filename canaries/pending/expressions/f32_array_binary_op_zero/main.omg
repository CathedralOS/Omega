// PENDING CANARY -- currently miscompiles on native (exits 71 instead of 70).
//
// Bug: same as float_array_binary_op_zero but for f32.
// When both operands of a float binary arithmetic expression are f32 fixed-array
// elements, the result is 0.0 (exits 71 instead of 70).
//
// This is the f32 instance of the same root-cause bug as
// `float_array_binary_op_zero` (f64 variant). Both f32 and f64 array binary ops
// are broken.
//
// Interpreter: exits 70 (vals[0]=3.0f32, vals[1]=4.0f32, sum=7.0f32 > 6.0 -> good).
// Native x64:  exits 71 (sum evaluates to 0.0f32).
//
// Not registered in canary_suite.rs -- add to the registry when fixing.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    vals: [f32; 2];
}

machine Main::main(&mut self) {
    self.vals[0] = 3.0;
    self.vals[1] = 4.0;

    // arr[0] + arr[1] should be 7.0f32
    let s: f32 = self.vals[0] + self.vals[1];
    transition s > 6.0 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
