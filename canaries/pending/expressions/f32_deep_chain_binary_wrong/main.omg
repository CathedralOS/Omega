// PENDING CANARY -- currently miscompiles on native (exits 71 instead of 70).
//
// Bug: a left-associative chain of 4+ f32 field reads in a single binary
// expression `a + b + c + d` (parsed as `((a+b)+c)+d`) produces the wrong float
// result — even the GUARD COMPARISON fails (so the XMM register is wrong, not
// just the frame slot). With only 3 operands (`a+b+c`) the result IS correct.
//
// NOT the same as f32_field_binary_to_local_cast_wrong (which affects 2-operand
// chains too, in the cast path). This is a distinct bug affecting depth >= 3
// nested binary expressions where the outer addss result ends up in a wrong
// XMM register or gets the wrong operands.
//
// What WORKS:
//   - `a + b + c` (3-field left-chain, depth 2) → correct float result
//   - `(a + b) + (c + d)` (balanced tree, depth 2) → correct float result
//   - f64 `a + b + c + d` (4-field left-chain) → correct result
//
// What FAILS:
//   - `a + b + c + d` (4-field left-chain, depth 3) → wrong float result
//   - `a + b + c + d + e` (5-field left-chain, depth 4) → wrong float result
//   - Affects GUARD COMPARISON (not just i32 cast), so the XMM result is wrong
//
// Interpreter: exits 70 (1+2+3+4 = 10 > 9.5 -> good).
// Native x64:  exits 71 (result is not > 9.5).
//
// Not registered in canary_suite.rs -- add to the registry when fixing.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    a: f32;
    b: f32;
    c: f32;
    d: f32;
}

machine Main::main(&mut self) {
    self.a = 1.0;
    self.b = 2.0;
    self.c = 3.0;
    self.d = 4.0;

    // Left-chain: ((a+b)+c)+d = 10.0
    let s: f32 = self.a + self.b + self.c + self.d;
    transition s > 9.5 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
