// Chapter 7 "Contracts And Flow Facts": the documented contract surface allows
// Rust-style range membership such as `requires mass in 1..=100`, where the
// interval is the proof fact. This range-in-contract surface is documented but
// not yet implemented: after `in`, the parser expects an identifier (a domain
// name) and rejects the numeric range start `1`.

data Body {
    mass: i32;
}

machine Body::set_mass(&mut self, mass: i32)
requires
    mass in 1..=100
{
    self.mass = mass;
}

data Main {
    body: Body;
}

machine Main::main(&mut self) {
}
