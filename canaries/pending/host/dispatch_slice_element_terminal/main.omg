// PENDING: the DIRECT slice-element terminal (`-> s[j]`) from a dispatched
// value call is refused LOUDLY by the call-result blocker (correct).
// Serving it needs CopyRuntimeFrameIndexedToRuntimeStorage made
// region-parametric (its encoder/relocation ignore `target_region` --
// machine-field mutation targets only; a probe emitting it for a frame
// result slot stored into machine memory and crashed, reverted). The
// FIELD-CARRIER idiom (`self.picked = s[j]`, field-read terminal) WORKS and
// is pinned by calls/runtime_dispatch_machine_array_slice_arg_exit (whose
// machine-array-as-slice descriptor bug -- raw array bytes as the pointer,
// native SIGSEGV -- was fixed 2026-07-09m in slice_descriptors.rs).
// PROMOTE when the direct terminal serves; expected native+interp 70.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; nums: [i32; 4]; }
machine Main::pick(&mut self, s: &[i32], i: usize, j: usize)
terminates { decreases (j, i) -> Nat::BoundedDistance; }
-> i32
{
    transition j < i {
        true -> pick(s, i, j + 1)
        false -> leaf(s, j)
    }
    state leaf(&mut self, s: &[i32], j: usize) -> i32 {
        transition j < s.len { true -> leaf_go(s, j) _ -> leaf_zero() }
    }
    state leaf_go(&mut self, s: &[i32], j: usize) -> i32 { s[j] }
    state leaf_zero(&mut self) -> i32 { 0 }
}
machine Main::main(&mut self) {
    self.nums[0] = 5;
    self.nums[1] = 6;
    self.nums[2] = 7;
    self.nums[3] = 8;
    // Loop to j == 2, then return s[2] == 7.
    let n: i32 = self.pick(self.nums, 2, 0);
    transition n == 7 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
