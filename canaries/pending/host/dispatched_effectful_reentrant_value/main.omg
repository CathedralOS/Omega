// PENDING (2026-07-08n) -- the ACCEPTANCE TEST for exempting dispatch-routed
// value calls from the splice fences (TASKS_FS open-work #7), and the
// COUNTEREXAMPLE that retracted the first attempt: with the fences exempting
// dispatch-routed calls, this program COMPILED and silently MISDELIVERED
// (native 71: total != 5; interp 70) -- the callee routed to dispatch (its
// SelfTarget re-entry makes state_call_target_loops true) but the dispatch
// RETURN-WRITE does not serve this shape (effectful entry + terminal
// returning a field via an arm leaf; the recorded ~13-canary regression
// class). The fences refuse it again; the shape stays interp-only.
// PROMOTE (to pass/calls, differential) when the dispatch return-write
// covers it AND the fence exemption is re-added for exactly this shape.
// Expected: native+interp 70 (total == 5 AND hits == 5 -- both the looped
// RESULT and the per-entry EFFECT COUNT must deliver).
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; hits: i32 in Wrapping; total: i32 in Wrapping; }
machine Main::count(&mut self, i: usize, j: usize)
terminates {
    decreases (j, i) -> Nat::BoundedDistance;
}
-> i32
{
    self.hits = self.hits + 1;
    transition j < i {
        true -> count(i, j + 1)
        false -> done_leaf()
    }
    state done_leaf(&mut self) -> i32 { self.hits }
}
machine Main::main(&mut self) {
    // i = 4: entries at j = 0,1,2,3,4 -> hits == 5; result returns hits (5).
    self.total = self.count(4, 0);
    transition self.total == 5 { true -> ck_hits() _ -> bad(71) }
    state ck_hits(&mut self) {
        transition self.hits == 5 { true -> good() _ -> bad(72) }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
