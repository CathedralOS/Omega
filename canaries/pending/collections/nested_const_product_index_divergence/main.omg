// PENDING repro -- SILENT MISCOMPILE (found 2026-07-18 probing dependent-types
// drivers). A NESTED computed index with a CONST operand -- the row-major
// idiom `pixels[y * 4 + x]` -- compiles WITHOUT the computed-index fence and
// silently delivers ZII natively, in BOTH read and write positions:
//   READ  (this file): pixels[11]=7; out = pixels[y*4+x]  -> native 0, interp 7
//   WRITE flavor:      pixels[y*4+x]=7; out = pixels[11]  -> native 0, interp 7
// The ALL-RUNTIME sibling (`pixels[y * self.w + x]`) is correctly REJECTED by
// the computed-index fence ("compute it into a field first"); the const
// multiplier makes the nested binary slip past the fence -- likely the
// partial-fold path classifies `y*4` as foldable/hoistable, then the
// two-level shape drops out of the write/read cascade (the known
// one-fence-per-fire computed-index family; single-level `pixels[y*4]` and
// `pixels[y+8]` both work correctly native==interp).
// WORKAROUND (verified, runs =7 native==interp): compute into a RANGED field
// first -- `self.idx = self.y * 4 + self.x;` with `idx: u32 [0..=11]` -- the
// interval product PROVES and the single-field index lowers correctly.
// Exits 7 when fixed (or the fence must fire -- either outcome un-pends this).
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; pixels: [u8; 12]; x: u32 [0..=3]; y: u32 [0..=2]; out: i32; }
machine Main::main(&mut self) {
    self.x = 3;
    self.y = 2;
    self.pixels[11] = 7;
    self.out = self.pixels[self.y * 4 + self.x] as i32;
    self.console.exit_process(self.out);
}
machine Main::run(&mut self) { self.main(); }
