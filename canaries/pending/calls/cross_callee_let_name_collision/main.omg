// PROBE: two DIFFERENT callees with SAME-NAMED lets (freq) spliced into ONE
// caller state -- does the second callee's let read the first's slot?
// exits: 70 ok; 2 = second callee's chain zeroed/miscomputed; crash = #DE.
use omega::language::std::time_host;

boundary trait Console { machine exit_process(return_code: i32); }

data Wrapper { host: TimeHost; }

machine Wrapper::first_read(&mut self) -> u64 {
    let freq: u64 = self.host.monotonic_ticks_per_second();
    let shifted: u64 = freq + 1;
    shifted
}

machine Wrapper::second_read(&mut self) -> u64 {
    let freq: u64 = self.host.monotonic_ticks();
    let shifted: u64 = freq + 1;
    shifted
}

data Main {
    console: Console;
    wrapper: Wrapper;
    a: u64;
    b: u64;
}

machine Main::main(&mut self) {
    self.a = self.wrapper.first_read();
    self.b = self.wrapper.second_read();
    transition self.a > 1 {
        true -> check_b()
        false -> fail_a()
    }
    state check_b(&mut self) {
        transition self.b > 1 {
            true -> good()
            false -> fail_b()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state fail_a(&mut self) { self.console.exit_process(1); }
    state fail_b(&mut self) { self.console.exit_process(2); }
}
