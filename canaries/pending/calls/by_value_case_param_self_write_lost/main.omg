// PENDING — native miscompile (found 2026-06-12 by the vending_machine
// sample). A `&mut self` machine that takes a BY-VALUE CASE-BEARING
// parameter and writes `self.<field>` in a dispatched substate loses the
// write: the caller observes the pre-call value.
//
// Minimal repro: after one `self.apply(Event::Insert { cents: 50 })`,
// `self.register.balance` should be 50, but native reads 0 (the substate's
// `self.register.balance = ... + cents` write-back is dropped). Exits 80
// (write lost) natively; should exit 70.
//
// NARROWED: the trigger is the by-value CASE param. The identical shape with
// a SCALAR argument (probe F in the sample dir) persists the write correctly
// (exit 70). So this is the &mut-self write-back leg of the by-value
// aggregate-parameter family fixed in c8519251 (by-value struct ARG) and
// 04bf00d9 (by-value struct RETURN) -- those covered the arg/return VALUE,
// not the self write-back when an aggregate value param is also present.
//
// Expected once fixed: promote to pass/calls/, exit 70, register in both
// canary_suite.rs and differential.rs.

use omega::language::std::console;

data Event {
    case Idle;
    case Insert(cents: i32);
}

data Register [copy, zero_init] {
    balance: i32;
}

data Main {
    console: Console;
    register: Register;
}

machine Main::main(&mut self) {
    self.apply(Event::Insert { cents: 50 });
    transition self.register.balance == 50 {
        true -> report(70)
        _ -> not_fifty()
    }
    state not_fifty(&mut self) {
        transition self.register.balance == 0 {
            true -> report(80)
            _ -> report(81)
        }
    }
    state report(&mut self, code: i32) {
        self.console.exit_process(code);
    }
}

machine Main::apply(&mut self, event: Event) {
    transition event {
        Event::Insert { cents } -> add_balance(cents)
        _ -> idle()
    }
    state add_balance(&mut self, cents: i32) {
        self.register.balance = self.register.balance + cents;
    }
    state idle(&mut self) {
    }
}
