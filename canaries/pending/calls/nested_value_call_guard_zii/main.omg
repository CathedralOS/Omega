// PROBE 9 (control): Duration::saturating_subtract, same shape as probe 8.
use omega::language::std::time;

boundary trait Console { machine exit_process(return_code: i32); }

data Main {
    console: Console;
    a: Duration;
    b: Duration;
    elapsed: Duration;
}

machine Main::main(&mut self) {
    self.a = Duration { seconds: 5, subsecond_nanoseconds: 400000000 };
    self.b = Duration { seconds: 2, subsecond_nanoseconds: 100000000 };
    self.elapsed = self.a.saturating_subtract(self.b);
    transition self.elapsed.seconds == 3 {
        true -> check_nanos()
        false -> fail_seconds()
    }
    state check_nanos(&mut self) {
        transition self.elapsed.subsecond_nanoseconds == 300000000 {
            true -> good()
            false -> fail_nanos()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state fail_seconds(&mut self) { self.console.exit_process(1); }
    state fail_nanos(&mut self) { self.console.exit_process(2); }
}
