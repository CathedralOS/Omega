// PENDING repro (2026-07-07): a host-call RESULT let in a callee reached via
// an ARM transition-target value call (`-> self.e1()`) has no frame slot in
// the INLINING dispatch case -- probed place=None at the caller's case while
// the slot exists under the callee's own case. Root:
// branch_transition_target_key (omega-runtime-storage body.rs) resolves only
// CONTAINED-object Nested receivers; self/sibling targets return None, so
// the callee's locals are never storage-walked for the inlining case. This
// is the real windows blocker behind deep create_dir_all (mkall_issue's rc).
// A straight mirror of state-calls' self/sibling resolution FIXED the shapes
// here but DESTABILIZED the suite (intermittent wrong-exit failures vs a
// clean 692/0 baseline -- suspected frame-slot overlap from double-walking
// callees that already own dispatch cases). The landable fix must scope the
// walk to avoid double allocation (or key slots per inlining site) -- a
// focused session with the frame-layout model in hand.
// Shape ladder: (A) host-result let in a callee reached via an ARM
// transition-target value call; (B) same via a decreases/terminates walk.
use omega::language::std::filesystem_host;
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; host: FilesystemHost; a: i32; b: i32; }
machine Main::e1(&mut self) -> i32 {
    let rc: i32 = self.host.errno();
    rc
}
machine Main::e2(&mut self, k: i32) -> i32 {
    transition k > 0 {
        true -> self.e1()
        false -> zero()
    }
    state zero(&mut self) -> i32 { 0 }
}
machine Main::walk(&mut self, n: usize)
terminates {
    decreases n;
}
-> i32
{
    transition n > 0 {
        true -> walk(n - 1)
        false -> self.e1()
    }
}
machine Main::main(&mut self) {
    self.a = self.e2(1);
    self.b = self.walk(2);
    transition self.a == 0 { true -> chk_b() _ -> bad(71) }
    state chk_b(&mut self) {
        transition self.b == 0 { true -> good() _ -> bad(72) }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
