// PENDING repro, REMAINING FLAVOR ONLY (2026-07-07b): the ARM-target result
// place is FIXED and pinned (calls/runtime_arm_target_host_result_exit; the
// earlier "destabilization" was attributed to the recorded parallel race by
// three clean suite re-runs + a byte-identical emitted-code diff). What
// STILL fails here is the `walk` leg: the same host-result callee reached
// from a DECREASES/terminating machine's false arm -- the dispatched-walk
// route resolves the result place differently (clean error). mkall_walk's
// guard-lowering errors at inline depth are the second remaining frontier.
// Shape ladder: (A) host-result let in a callee reached via an ARM
// transition-target value call; (B) same via a decreases/terminates walk.
use omega::language::std::filesystem_host;
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; host: FilesystemHost; a: i32; b: i32; }
machine Main::e1(&mut self) -> i32 {
    let rc: i32 = self.host.errno();
    rc
}
machine Main::e2(&mut self, k: i32) -> i32 {
    transition k > 0 {
        true -> self.e1()
        false -> zero()
    }
    state zero(&mut self) -> i32 { 0 }
}
machine Main::walk(&mut self, n: usize)
terminates {
    decreases n;
}
-> i32
{
    transition n > 0 {
        true -> walk(n - 1)
        false -> self.e1()
    }
}
machine Main::main(&mut self) {
    self.a = self.e2(1);
    self.b = self.walk(2);
    transition self.a == 0 { true -> chk_b() _ -> bad(71) }
    state chk_b(&mut self) {
        transition self.b == 0 { true -> good() _ -> bad(72) }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
