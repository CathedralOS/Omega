// PENDING CANARY — do not register in canary_suite.rs yet.
//
// BUG: when a value-position call to a machine that has an internal `let`
// binding is followed by a second value-position call with MORE args than the
// first, the prior call's return-value slot is clobbered by the second call's
// parameter materialization.
//
// Repro:
//   let a1 = self.f(3)     -- f has `let rr = r * r` internally; returns 9
//   let a2 = self.g(5, 8)  -- g takes two args, returns 40
//   self.v = a1 + 61       -- should be 70 but native reads wrong a1
//
// Native exits 71 (a1 is neither 9 nor 40). Interpreter exits 70.
//
// Root cause hypothesis: the dispatch frame-slot allocator assigns `a2`'s
// result (or g's parameter slots) to the same frame offset as `a1`'s result,
// because the slot allocator counts the extra `let rr` slot in f's frame but
// the CALLER's frame layout does not account for it, shifting the base for
// g's parameters into the slot that holds a1's result.
//
// Found: 2026-06-12 while authoring samples/shapes_area.
// Surfaces when: callee has >=1 internal `let` AND subsequent callee has
// MORE args (>=2) than the first callee had.

use omega::language::std::console;

data Main {
    console: Console;
    v: i32;
}

machine Main::main(&mut self) {
    let a1: i32 = self.f(3);
    let a2: i32 = self.g(5, 8);
    // a1 should be 9 (f returns rr = 3*3); a1 + 61 should be 70
    self.v = a1 + 61;

    transition self.v == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

// f has an internal let binding: rr = r * r.
machine Main::f(&mut self, r: i32) -> i32 {
    let rr: i32 = r * r;
    transition {
        _ -> rr
    }
}

// g has two parameters (more than f's one parameter).
machine Main::g(&mut self, w: i32, h: i32) -> i32 {
    transition {
        _ -> (w * h)
    }
}
