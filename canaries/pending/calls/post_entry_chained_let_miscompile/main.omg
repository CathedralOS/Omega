// PENDING (native-vs-interp miscompile, distilled 2026-07-08). A value callee
// `proc` whose POST-ENTRY state `work` computes a CHAINED let -- `rem` reads a
// PRIOR let `scaled` (which reads `q`) in the same state. That chained let is
// miscomputed natively: proc(100,7) should give rem = 100 - (100/7)*7 = 2, but
// native returns 0; the interpreter (oracle) returns 2.
//
// PRECISELY CHARACTERIZED (variants, same session):
//   * ENTRY-state version of the identical chain delivers 2 (correct).
//   * Direct `total % freq` (no `scaled` intermediate) in the post-entry state
//     delivers correctly.
//   * Only the POST-ENTRY chained let -- a let referencing a PRIOR post-entry
//     let -- miscomputes. So the prior-let value is not materialized before the
//     dependent let reads it in a non-entry state.
// ROOT (backend_report): `q`/`scaled` get NO frame slot (only `rem` does);
// local_data_requires_storage elides them because the liveness scan ignores
// LocalData initializer VALUES, and the fold that would inline them does not run
// for a spliced post-entry state. Fix belongs on the FOLDING side -- keeping the
// slot instead shifts offsets and regresses unrelated canaries (tried+reverted).
// Promote to a passing RUN canary (exit 2) when the fix lands.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::proc(&self, total: i32 [0..=1000], freq: i32 [0..=1000]) -> i32 {
    transition freq > 0 {
        true -> work(total, freq)
        false -> 0
    }
    state work(&self, total: i32 [0..=1000], freq: i32 [1..=1000]) -> i32 {
        let q: i32 [0..=1000] = total / freq;
        let scaled: i32 [0..=1000000] = q * freq;
        let rem: i32 [0..=1000] = total - scaled;
        transition {
            _ -> (rem)
        }
    }
}
machine Main::run(&mut self) {
    let a: i32 = self.proc(100, 7);
    self.console.exit_process(a);
}
machine Main::main(&mut self) { self.run(); }
