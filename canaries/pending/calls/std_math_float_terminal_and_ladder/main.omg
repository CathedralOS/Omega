// PENDING (2026-07-11): value-call TERMINALS expanding a multi-state
// callee. Of the std sin/cos draft's two original blockers, (a) FLOAT
// binary/literal terminal return-writes LANDED (the dispatch
// binary-terminal path classifies float operands and emits
// WriteRuntimeStorageBinary { is_float } -- exercised by
// pass/calls/runtime_std_math_sin_cos_exit), and (b) the compile-thread
// STACK OVERFLOW on this file's shape was tamed by
// MAX_BINDING_SUBSTITUTION_DEPTH (selection/bindings.rs): a cyclic
// callee's self-referential binding set (reduce's `x` bound over the same
// `x`) has no finite substitution, and the capped walk now falls through
// to a LOUD refusal (scratch-pool exhaustion on the capped tree, or the
// unlowered-terminal fences) instead of crashing.
//
// What remains unserved -- and what this canary pins: a value-CALL
// terminal whose callee is a genuine multi-state machine has no dispatch
// return route (acyclic callees poison as "a host-boundary call is the
// TERMINAL value"; cyclic ones refuse as above). The interpreter runs this
// file fine (exit 70). PROMOTE to a pass/ run canary when the terminal
// call shape is served -- e.g. desugared to the let-bound form (`let r =
// sin(..); -> (r)`), which is the supported spelling std math's cos uses
// today.
use omega::language::std::math;
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine cos_via_terminal(x: f64) -> f64 {
    transition { _ -> (sin(x + 1.57079632679489656)) }
}
machine Main::main(&mut self) {
    let c: f64 = cos_via_terminal(1.0);
    transition c > 0.54030230586 && c < 0.54030230587 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
