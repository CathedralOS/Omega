// PENDING (native 71, found 2026-07-18 wiring the indexed element write): a
// STRUCT-LITERAL transition argument does not deliver natively -- the entry
// case materializes ONLY the scalar sibling arg (the u64 lands via
// RuntimeMachineIntegerWrite) while the struct arg's field writes are absent
// from the plan entirely, so the callee's param slot stays ZII {0,0} and the
// readback sums 0. Scalar args deliver; a struct built IN-STATE from scalar
// params delivers (see pass/slices/runtime_indexed_element_copy_write_exit).
// Argument-materialization face (writes planning), pre-existing -- observed
// against the 1c-ii probe with no slice ops involved at all.
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Exit {
    destination: u32;
    weight: u32;
}

data Main {
    console: Console;
    got_d: u32;
    got_w: u32;
}

machine Main::main(&mut self) {
    transition { _ -> put(Exit { destination: 9, weight: 4 }) }

    state put(&mut self, e: Exit) {
        self.got_d = e.destination;
        self.got_w = e.weight;
        transition self.got_d + self.got_w == 13 {
            true -> good()
            false -> bad()
        }
    }

    state good(&self) { self.console.exit_process(70); }
    state bad(&self) { self.console.exit_process(71); }
}
