// PENDING CANARY -- currently miscompiles on native (exits 72 instead of 70).
//
// Bug: when a machine reads a field into a `let`-bound local, then dispatches
// to a nested state passing that local as an argument, the nested state
// receives the WRONG value for the local on repeated calls.
//
// Specifically: on the second call to `put`, `slot` is 1 (self.s.count was 1
// before the increment), but inside `try1`, `slot` compares as != 1, so the
// dispatch falls through to `set2` instead of `set1`.
//
// The symptom: s.arr[1] stays 0 and s.arr[2] is set to 200 after the second
// call, when s.arr[1] should be 200 and s.arr[2] should stay 0.
//
// Interpreter: exits 70 (correct behavior -- slot==1 in try1 is true).
// Native x64: exits 72 (arr[1] != 200; the set2 branch was taken).
//
// Workaround: read self.s.count again from the field inside nested states
// instead of forwarding the let-bound local through state argument chains.
//
// Not registered in canary_suite.rs -- add to the registry when fixing.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data S [copy, zero_init] {
    arr: [i32; 4];
    count: i32;
}

data Main {
    console: Console;
    s: S;
}

machine Main::main(&mut self) {
    self.put(500);  // slot=0 -> arr[0]=500
    self.put(200);  // slot=1; native bug: dispatches to set2 -> arr[2]=200

    // Correct: arr[0]==500 AND arr[1]==200.
    transition self.s.arr[0] == 500 {
        true -> check1()
        _ -> bad()
    }

    state check1(&mut self) {
        transition self.s.arr[1] == 200 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(72); }
}

machine Main::put(&mut self, val: i32) {
    let slot: i32 = self.s.count;       // capture count BEFORE increment
    self.s.count = self.s.count + 1;    // increment
    transition slot == 0 {
        true -> set0(val)
        _ -> try1(slot, val)            // pass let-local to nested state
    }

    state set0(&mut self, val: i32) { self.s.arr[0] = val; }

    state try1(&mut self, slot: i32, val: i32) {
        // BUG: `slot` is received as wrong value on second call (slot != 1).
        transition slot == 1 {
            true -> set1(val)
            _ -> set2(val)   // BUG: this arm is wrongly taken
        }
    }
    state set1(&mut self, val: i32) { self.s.arr[1] = val; }
    state set2(&mut self, val: i32) { self.s.arr[2] = val; }
}
