// PENDING (2026-07-13, NATIVE silent-wrong on the scoped-leaf-key surface):
// a MULTI-ARM inline callee whose same-named arm locals hold TEXT-EQUALITY
// results (`let b: bool = self.name == "omega"` per arm) delivers ZII 0
// natively (exit 71; interp 70). The backend report shows NO
// `compare runtime text storage` instructions and NO writes into the arm
// locals' slots -- the frame-slot text-comparison writer is not reachable
// from the LEAF-EXPANSION route, so the arms' terminal copies deliver
// unwritten slots. The scalar flavor (`let b = self.x`) works (pinned by
// calls/runtime_multiarm_same_named_locals_exit, the account_ledger fix);
// only the texteq-initializer flavor drops. Neither the case-literal poison
// (fields only) nor any blocker guards arm-local initializers on this route.
// FIX surface: the leaf-expansion emitters (branches/leaf.rs) need either
// the text-comparison write or a loud poison for unserved arm-local
// initializers. PROMOTE (pass/calls + differential, 70/70) when served.
boundary trait Console { machine exit_process(return_code: i32); }
data Store { name: String; alt: String; }
machine Store::check(&mut self, idx: i32) -> bool {
    transition idx == 0 {
        true -> arm_name()
        _ -> arm_alt()
    }
    state arm_name(&mut self) -> bool {
        let b: bool = self.name == "omega";
        transition { _ -> (b) }
    }
    state arm_alt(&mut self) -> bool {
        let b: bool = self.alt == "delta";
        transition { _ -> (b) }
    }
}
data Main { console: Console; s: Store; }
machine Main::main(&mut self) {
    self.s.name = "omega";
    self.s.alt = "other";
    self.build();
}
machine Main::build(&mut self) {
    let hit: bool = self.s.check(0);
    let miss: bool = self.s.check(1);
    transition hit {
        true -> chk2(miss)
        _ -> wrong_arm0()
    }
    state chk2(&mut self, m: bool) {
        transition m {
            true -> wrong_arm1()
            _ -> good()
        }
    }
    state good(&mut self)      { self.console.exit_process(70); }
    state wrong_arm0(&mut self){ self.console.exit_process(71); }
    state wrong_arm1(&mut self){ self.console.exit_process(72); }
}
