// PENDING (found 2026-07-15; sibling of texteq_local_guard_read_divergence
// -- same root): a texteq ARM-LOCAL forwarded as a transition ARGUMENT to a
// deeper sub-state delivers ZII natively (native 71 / interp 70). The
// terminal-expansion-attached initializer collection never fires for
// non-terminal sub-state bodies. FS-LANE machinery; pinned for their
// follow-through.
boundary trait Console { machine exit_process(return_code: i32); }
data Store { name: String; }
machine Store::check(&mut self, idx: i32) -> bool {
    transition idx == 0 {
        true -> arm_a()
        _ -> arm_b()
    }
    state arm_a(&mut self) -> bool {
        let x: bool = self.name == "omega";
        transition idx == 0 {
            true -> fwd(x)
            _ -> (false)
        }
    }
    state fwd(&mut self, v: bool) -> bool { transition { _ -> (v) } }
    state arm_b(&mut self) -> bool { transition { _ -> (false) } }
}
data Main { console: Console; s: Store; }
machine Main::main(&mut self) {
    self.s.name = "omega";
    let r: bool = self.s.check(0);
    transition r {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
