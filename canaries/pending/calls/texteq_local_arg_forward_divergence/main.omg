// PENDING (root-caused 2026-07-17 -- same chicken-and-egg as the
// guard-read sibling, see texteq_local_guard_read_divergence for the full
// analysis): a texteq ARM-LOCAL forwarded as a transition ARGUMENT
// evaluates at edge-taking time, BEFORE any expansion's write region --
// per-expansion initializer collection cannot feed it. Fix shape: the
// per-branch-state PRE-GUARD region. Hold: (71, Exit(70)).
boundary trait Console { machine exit_process(return_code: i32); }
data Store { name: String; }
machine Store::check(&mut self, idx: i32) -> bool {
    transition idx == 0 {
        true -> arm_a()
        _ -> arm_b()
    }
    state arm_a(&mut self) -> bool {
        let x: bool = self.name == "omega";
        transition idx == 0 {
            true -> fwd(x)
            _ -> (false)
        }
    }
    state fwd(&mut self, v: bool) -> bool { transition { _ -> (v) } }
    state arm_b(&mut self) -> bool { transition { _ -> (false) } }
}
data Main { console: Console; s: Store; }
machine Main::main(&mut self) {
    self.s.name = "omega";
    let r: bool = self.s.check(0);
    transition r {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
