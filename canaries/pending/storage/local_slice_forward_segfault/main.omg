// PENDING (native SEGFAULT vs interp 70, found 2026-07-18 authoring the
// mut-ref forward canary). A `&mut [T]` LOCAL derived from a LOCAL struct's
// array field (`room.exits.as_mut_slice()`) forwarded as a transition arg
// into a state param, then indexed-RMW'd through the param: native crashes
// 0xC0000005; the interpreter exits 70.
//
// The known-good siblings differ in exactly one respect each:
// - same-state use of the local slice (no forward) WORKS
//   (storage/runtime_slice_alias_indexed_field_write_exit);
// - forwarding a slice derived from a `&mut` PARAM works (inventory.omg's
//   items shape).
// The crashing face is the frame-LOCAL-backed descriptor crossing a state
// boundary: the descriptor's data pointer targets the entry frame's `room`,
// and the forwarded copy appears to go stale/wild in the callee state.
// Backend (storage/argument-materialization) work; unrelated to the
// borrow-mutability validation landed the same day (this shape was equally
// accepted before it).
boundary trait Console { machine exit_process(return_code: i32); }
data Counter { n: i32 in Wrapping; }
data Room { exits: [Counter; 2]; }
data Main { console: Console; }
machine Main::main(&mut self) {
    let room: Room = Room {
        exits: [ Counter { n: 10 }, Counter { n: 20 } ]
    };
    let exits: &mut [Counter] = room.exits.as_mut_slice();
    transition { _ -> bump_first(exits) }

    state bump_first(&mut self, exits: &mut [Counter]) {
        let index: u64 = 0;
        exits[index].n = exits[index].n + 1;
        transition exits[index].n == 11 { true -> good() _ -> bad() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
