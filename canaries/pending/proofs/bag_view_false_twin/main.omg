// False twin of proofs/proof_bag_view_reflexivity (ladder rung L6, proof
// views). The requires fact asserts the Bag views are equal; the ensures
// asserts they are not. Accepted today because Bag(...) is contract surface
// without lowering; once proof views carry semantics, the direct
// contradiction must be rejected.

machine false_bag_distinct(before: &[u64], items: &[u64])
requires
    Bag(items) == Bag(before)
ensures
    Bag(items) != Bag(before)
{
}

data Main {
}

machine Main::main(&mut self) {
}
