// PARKED REPRO (2026-07-16, found growing the N4 Seq zoo): compiling
// `length_reverse` (`length(reverse(s)) == length(s)` over the generic
// core Seq<u64>) OVERFLOWS THE COMPILE-THREAD STACK. LLDB LOCATES THE
// CRASH in the STATE-VALUES SIMPLIFIER, NOT the entailment judge:
// `omega_state_values::simplify::folding::boolean_or` recursing without
// bound (the judge's own unfolder is depth-capped at 32 and its
// OMEGA_STRUCT_TRACE shows a normal, finite 315-unfold discharge before
// the crash). Same family as the earlier value-call cyclic-callee
// expansion overflow (tamed separately for that shape): the simplifier
// expands a tree -- likely through the citation sub-state's machine
// applications -- that is cyclic or exponentially deep. A NON-generic
// inline copy is rejected cleanly BEFORE reaching the simplifier; the
// crash needs the full compile (check-only bails earlier). The reverse
// machine alone (no lemma) compiles fine. FIX SHAPE: cycle detection /
// a depth budget in the state-values simplify recursion turning
// divergence into a loud diagnostic -- a compiler must never crash on
// any input. The lemma itself is true (Lean: List.length_reverse); its
// intended proof cites length_append + add_succ_law + add_zero_right in
// the step sub-state.
use omega::language::core::nat;
use omega::language::core::seq;

machine length_reverse(s: Seq<u64>) -> Nat
terminates {
    decreases s;
}
ensures
    (length(reverse(s))) == (length(s))
{
    transition s {
        Seq::Empty -> Nat::Zero
        Seq::Cons { head, tail } -> lr_step(head, tail)
    }

    state lr_step(head: u64, tail: Seq<u64>) -> Nat {
        length_append(reverse(tail), Seq::Cons { head: head, tail: Seq::Empty });
        add_succ_law(length(tail), Nat::Zero);
        add_zero_right(length(tail));
        transition { _ -> Nat::Succ { prev: length_reverse(tail) } }
    }
}

boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::run(&mut self) { self.console.exit_process(70); }
