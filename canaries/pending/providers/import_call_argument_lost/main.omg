// PENDING (pre-existing, surfaced 2026-07-20 by the external-leaf work):
// a CALL through a provides-authored (or via-leaf) DllImport row on the
// HOSTED path loses its argument -- `exit(70)` reaches libSystem exit as 0
// (native exit 0, expected 70). Same behavior for an authored provides row
// and a `satisfies ... via` leaf, so the defect lives in the general-import
// call lowering's argument marshaling, not the row source. The windows
// session verified ITS import forms; this hosted darwin shape never had a
// runtime argument canary. Hold: (0, Exit(70))-shaped divergence.
boundary trait Leaf {
    machine exit(code: i32) -> i32;
}
cross_platform_cli provides Leaf {
    exit -> DllImport("libSystem.B.dylib", "_exit")
}
data Main { p: Leaf; }
machine Main::main(&mut self) {
    let rc: i32 = self.p.exit(70);
    let keep: i32 = rc;
}
