// Chapter 20 (Wire Protocols): `wire data` declares an external schema with
// explicit field numbers. The `wire` declaration keyword is not yet a
// recognized top-level construct, so this is a documented-but-unimplemented gap.

wire data CounterMessage {
    0: counter: i32;
    1: timestamp_millis: i64;
}

data Main {
}

machine Main::main(&mut self) {
}
