// PENDING (found 2026-07-17 landing schemas-as-program-types): DECODE into
// a value OF THE SCHEMA'S OWN TYPE reports verdict Sound natively but the
// decoded values never land in the local's fields (d.x reads 0; the
// interp roundtrips 3/4). Encode-FROM-self and plain value use are green
// (pass/wire/runtime_wire_schema_as_value_type_exit); Sample-twin decode
// into ordinary-data locals is green corpus-wide -- the gap is specific
// to the value type being the NUMBERED definition itself, i.e. the decode
// value-argument's member-place resolution with TWO same-named
// definitions (wire schema + the dual-registered DataDefinition) in
// scope. LIKELY: the place resolution walks the schema-symbol side, whose
// members carry no layout, instead of the data definition the local was
// laid out by. Hold: (73, Exit(70)).
// RUN CANARY (exit 70) + interpreter differential. Chapter 20's "numbers
// are inert schema facts" made REAL: a NUMBERED data is a plain program
// type -- locals, field writes, guard arithmetic, ZII -- and its schema
// machines encode/decode values OF THE TYPE ITSELF. The corpus-wide
// Message/Sample twin pattern was FORCED (numbered datas never entered the
// type namespace: "references unknown data type") until the wire lowering
// gained dual registration (a numbered declaration lowers BOTH the wire
// schema and a regular DataDefinition sharing the lowered type
// references; Reserved/Version members are wire history, not fields).
// Legs: value-type use; encode-from-self; decode-into-self roundtrip.
// exits: 71 = value use wrong; 72 = encode wrong; 73 = roundtrip wrong.
boundary trait Console { machine exit_process(return_code: i32); }
data Point {
    0: x: u32;
    1: y: u32;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    console: Console;
    buffer: [u8; 32];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}
machine Main::main(&mut self) {
    let p: Point;
    p.x = 3;
    p.y = 4;
    transition p.x + p.y == 7 {
        true -> enc()
        _ -> bad_value_use()
    }
    state enc(&mut self) {
        let q: Point;
        q.x = 3;
        q.y = 4;
        Point::encode(&q, &mut self.buffer, &mut self.written);
        transition self.written == 5 {
            true -> roundtrip()
            _ -> bad_encode()
        }
    }
    state roundtrip(&mut self) {
        let d: Point;
        d.x = 0;
        d.y = 0;
        Point::decode(&mut d, &self.buffer, &mut self.read, &mut self.verdict);
        let matches: bool = d.x == 3;
        transition matches {
            true -> good()
            _ -> bad_roundtrip()
        }
    }
    state good(&mut self)         { self.console.exit_process(70); }
    state bad_value_use(&mut self){ self.console.exit_process(71); }
    state bad_encode(&mut self)   { self.console.exit_process(72); }
    state bad_roundtrip(&mut self){ self.console.exit_process(73); }
}
