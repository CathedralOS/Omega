// PENDING (analysis v3, 2026-07-17 -- each revision narrowed by probes):
// a LET-BOUND comparison of a member AFTER a WIRE DECODE folds the member
// to its PRE-DECODE constant. The full empirical boundary:
//   decode + DIRECT guard on d.x            -> OK (reads the frame place)
//   decode + `let m = d.x == 3` + guard m   -> FOLDS STALE (this pin);
//     TWIN-typed values reproduce identically -- NOT self-type-specific
//     (the canary name predates this; the header rules)
//   plain &mut machine call + let-compare   -> OK (mutation recognized)
//   decode with NO pre-init + let-compare   -> OK (nothing to fold)
// So: the state-values plan captures `d.x = 0` as a static entry (the
// backend report shows `d.x = '0'` planned AND `aliases mut d` recorded
// for the decode statement), and the LET's value computation consults the
// static entry without honoring the intervening SYNTHESIZED wire call's
// mutation -- plain machine calls invalidate, synthesized decode calls do
// not. The emitted compare carries `mov #0` as its left operand. FIX SITE:
// wherever the state-values/static machinery classifies calls as opaque
// mutators (plain calls pass; the wire-synthesized call shape misses) --
// selection itself never walks statements, so it is upstream in the plan
// production. This affects EVERY decode-then-let-compare, wire-wide; the
// corpus never noticed because decode canaries re-encode instead of
// comparing decoded fields. Hold: (73, Exit(70)).
boundary trait Console { machine exit_process(return_code: i32); }
data Point {
    0: x: u32;
    1: y: u32;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    console: Console;
    buffer: [u8; 32];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}
machine Main::main(&mut self) {
    let p: Point;
    p.x = 3;
    p.y = 4;
    transition p.x + p.y == 7 {
        true -> enc()
        _ -> bad_value_use()
    }
    state enc(&mut self) {
        let q: Point;
        q.x = 3;
        q.y = 4;
        Point::encode(&q, &mut self.buffer, &mut self.written);
        transition self.written == 5 {
            true -> roundtrip()
            _ -> bad_encode()
        }
    }
    state roundtrip(&mut self) {
        let d: Point;
        d.x = 0;
        d.y = 0;
        Point::decode(&mut d, &self.buffer, &mut self.read, &mut self.verdict);
        let matches: bool = d.x == 3;
        transition matches {
            true -> good()
            _ -> bad_roundtrip()
        }
    }
    state good(&mut self)         { self.console.exit_process(70); }
    state bad_value_use(&mut self){ self.console.exit_process(71); }
    state bad_encode(&mut self)   { self.console.exit_process(72); }
    state bad_roundtrip(&mut self){ self.console.exit_process(73); }
}
