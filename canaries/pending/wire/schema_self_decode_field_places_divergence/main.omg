// PENDING (root-cause CORRECTED 2026-07-17 by disassembly -- the first
// place-resolution hypothesis was WRONG): decode into a value of the
// schema's own type is fine at the PLACE level; the compare after it is
// what breaks. `transition d.x == 3` lowers with a CONSTANT left operand
// (`mov x17, #0` in the emitted guard) -- the member-value tracking
// carried the PRE-DECODE initialization `d.x = 0` ACROSS the decode call,
// which it does not recognize as mutating `d` WHEN THE CALL'S TYPE
// QUALIFIER EQUALS THE VALUE'S OWN TYPE (`Point::decode(&mut d)` with
// `d: Point`). Exonerating probes: the SAMPLE-TWIN spelling
// (PointMsg::decode with d: PointSample) invalidates correctly and its
// field guard reads 3; the self-typed decode WITHOUT pre-init writes also
// works (nothing stale to fold). The corpus never caught this because no
// existing canary guard-reads a decoded field -- they all re-encode.
// FIX: whatever tracker substitutes member values into guard operands must
// invalidate the decode value argument's members (likely classifying
// `Point::decode` as an attached-machine-ish call of Point and missing the
// wire-schema mutation); the stale-fold capture family in
// omega-state-values/simplify is adjacent but binds LOCALS, not members.
// Hold: (73, Exit(70)).
boundary trait Console { machine exit_process(return_code: i32); }
data Point {
    0: x: u32;
    1: y: u32;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    console: Console;
    buffer: [u8; 32];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}
machine Main::main(&mut self) {
    let p: Point;
    p.x = 3;
    p.y = 4;
    transition p.x + p.y == 7 {
        true -> enc()
        _ -> bad_value_use()
    }
    state enc(&mut self) {
        let q: Point;
        q.x = 3;
        q.y = 4;
        Point::encode(&q, &mut self.buffer, &mut self.written);
        transition self.written == 5 {
            true -> roundtrip()
            _ -> bad_encode()
        }
    }
    state roundtrip(&mut self) {
        let d: Point;
        d.x = 0;
        d.y = 0;
        Point::decode(&mut d, &self.buffer, &mut self.read, &mut self.verdict);
        let matches: bool = d.x == 3;
        transition matches {
            true -> good()
            _ -> bad_roundtrip()
        }
    }
    state good(&mut self)         { self.console.exit_process(70); }
    state bad_value_use(&mut self){ self.console.exit_process(71); }
    state bad_encode(&mut self)   { self.console.exit_process(72); }
    state bad_roundtrip(&mut self){ self.console.exit_process(73); }
}
