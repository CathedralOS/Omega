// PENDING only for x86_64 (aarch64 + interp both REFUSE, 2026-07-16):
// adversarial wire bytes 0xFF 0xFF decode into a `&[u8] in Utf8` field
// with verdict INVALID. The interp evaluates the shared
// ByteSequencePredicate; aarch64 emits validation blocks over the decoded
// content (utf8 = a 77-instruction compare/branch walk, label-resolved;
// edge classes pinned by pass/wire/runtime_wire_utf8_edge_verdicts_exit).
// x86_64 carries the threaded predicate mask but its validation sequences
// are not emitted yet -- promote this to a refuses-canary when they land.
// Hold: (70, Exit(70)) on the arm64 host.
domain [u8]::Utf8 when valid_utf8(self) {
}
boundary trait Console { machine exit_process(return_code: i32); }
data LabelMessage {
    0: count: u32;
    1: label: &[u8] in Utf8;
}
data LabelSample {
    count: u32;
    label: &[u8] in Utf8;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    console: Console;
    buffer: [u8; 64];
    read: u64;
    verdict: WireVerdict;
}
machine Main::main(&mut self) {
    self.buffer[0] = 0;
    self.buffer[1] = 0;
    self.buffer[2] = 7;
    self.buffer[3] = 1;
    self.buffer[4] = 2;
    self.buffer[5] = 255;
    self.buffer[6] = 255;

    let decoded: LabelSample;
    decoded.count = 0;
    decoded.label = "";
    LabelMessage::decode(&mut decoded, &self.buffer, &mut self.read, &mut self.verdict);

    transition self.verdict == WireVerdict::Invalid {
        true -> refused()
        false -> accepted_invalid_utf8()
    }
    state refused(&mut self)              { self.console.exit_process(70); }
    state accepted_invalid_utf8(&mut self){ self.console.exit_process(71); }
}
