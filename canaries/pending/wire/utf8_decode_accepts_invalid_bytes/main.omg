// PENDING only for NATIVE (interp FIXED 2026-07-16): adversarial wire
// bytes 0xFF 0xFF must decode into a `&[u8] in Utf8` field with verdict
// INVALID. The interpreter now evaluates the slice's declared byte-domain
// predicates over the untrusted bytes at the decode boundary (the shared
// ByteSequencePredicate vocabulary, lifted from the checker's
// field_domain.rs into omega-typed-trees::byte_predicates so compile-time
// proof and runtime validation share ONE definition; unrecognized domain
// classifiers refuse loudly instead of silently skipping). NATIVE still
// accepts -- its decode byte-copy needs the validation loop (utf8/no_nul/
// ascii_only/non_empty over the copied range, verdict Invalid on failure);
// promote to a refuses-canary when it lands. Hold: (71, Exit(70)).
domain [u8]::Utf8 when valid_utf8(self) {
}
boundary trait Console { machine exit_process(return_code: i32); }
data LabelMessage {
    0: count: u32;
    1: label: &[u8] in Utf8;
}
data LabelSample {
    count: u32;
    label: &[u8] in Utf8;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    console: Console;
    buffer: [u8; 64];
    read: u64;
    verdict: WireVerdict;
}
machine Main::main(&mut self) {
    self.buffer[0] = 0;
    self.buffer[1] = 0;
    self.buffer[2] = 7;
    self.buffer[3] = 1;
    self.buffer[4] = 2;
    self.buffer[5] = 255;
    self.buffer[6] = 255;

    let decoded: LabelSample;
    decoded.count = 0;
    decoded.label = "";
    LabelMessage::decode(&mut decoded, &self.buffer, &mut self.read, &mut self.verdict);

    transition self.verdict == WireVerdict::Invalid {
        true -> refused()
        false -> accepted_invalid_utf8()
    }
    state refused(&mut self)              { self.console.exit_process(70); }
    state accepted_invalid_utf8(&mut self){ self.console.exit_process(71); }
}
