// PENDING (CurrentlyAccepts) -- NATIVE MISCOMPILE, interpreter divergence.
//
// `!=` over an Equatable record with a String field DROPS THE STRING TERM
// natively in value position: `self.left != self.right` evaluates false here
// even though the `name` fields differ ("gold" vs "iron"; the scalar `id`
// fields are equal). The reference interpreter returns the CORRECT result
// (exit 70); the native binary exits 71. `==` over the same record is right
// both natively and interpreted (the existing
// pass/traits/equatable_string_field_equality_exit), and scalar-only `!=` is
// right too (pass/traits/runtime_equatable_scalar_not_equals_guard_exit) --
// the negated expansion specifically loses the String content compare.
// Construction form does not matter (struct literal and field assignment
// both reproduce).
//
// When the negated String term lowers correctly, promote this to a RUN
// canary asserting exit 70 (suite + differential).

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Tag {
    name: String;
    id: i32;
}

trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

Tag satisfies Equatable;

data Main {
    console: Console;
    left: Tag;
    right: Tag;
}

machine Main::main(&mut self) {
    self.left = Tag { name: "gold", id: 5 };
    self.right = Tag { name: "iron", id: 5 };

    let differ: bool = self.left != self.right;
    transition differ {
        false -> bad()
        true -> good()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
