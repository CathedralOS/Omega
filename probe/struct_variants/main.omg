// PROBE: struct-arg variants -- 2 fields, move spelling, attached machine.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Pair {
    a: i32;
    b: i32;
}

machine combine(pair: Pair) -> i32 {
    pair.a + pair.b
}

data Worker {
}

machine Worker::run(pair: Pair) -> i32 {
    pair.b - pair.a
}

data Main {
    console: Console;
    v: i32;
}

machine Main::main(&mut self) {
    self.v = 40;
    self.v = self.v + 2; // runtime 42
    let pair: Pair = Pair { a: self.v, b: 28 };
    let total: i32 = combine(pair);

    let moved: Pair = Pair { a: 3, b: self.v };
    let diff: i32 = Worker::run(move moved);

    transition total == 70 {
        true -> check_diff()
        _ -> bad_total()
    }

    state check_diff(&mut self) {
        transition diff == 39 {
            true -> good()
            _ -> bad_diff()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad_total(&mut self) {
        self.console.exit_process(71);
    }

    state bad_diff(&mut self) {
        self.console.exit_process(72);
    }
}
