// PROBE: by-value scalar arg to a free machine, runtime (non-foldable) value.

boundary trait Console {
    machine exit_process(return_code: i32);
}

machine work(x: i32) -> i32 {
    x + 1
}

data Main {
    console: Console;
    v: i32;
}

machine Main::main(&mut self) {
    self.v = 60;
    self.v = self.v + 9; // runtime 69
    let x: i32 = self.v;
    let n: i32 = work(x);

    transition n == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
