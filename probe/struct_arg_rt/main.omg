// PROBE: by-value struct arg to a free machine, runtime (non-foldable) field value.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Job {
    id: i32;
}

machine work(job: Job) -> i32 {
    job.id + 1
}

data Main {
    console: Console;
    v: i32;
}

machine Main::main(&mut self) {
    self.v = 60;
    self.v = self.v + 9; // runtime 69
    let job: Job = Job { id: self.v };
    let n: i32 = work(job);

    transition n == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
