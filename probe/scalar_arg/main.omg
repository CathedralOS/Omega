// PROBE: by-value scalar arg to a free machine (working comparison).

boundary trait Console {
    machine exit_process(return_code: i32);
}

machine work(x: i32) -> i32 {
    x + 1
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let x: i32 = 69;
    let n: i32 = work(x);

    transition n == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
