enum GameMode {
    Title,
    Exploring,
    Combat,
    GameOver,
}

enum Direction {
    North,
    South,
    East,
    West,
}

struct Vec2 {
    x: i32;
    y: i32;
}

struct Stats {
    health: i32[range<0, 100>];
    stamina: i32[range<0, 100>];
}

struct Item {
    id: i32;
    count: i32[range<0, 99>];
}

struct Inventory {
    gold: i32[range<0, 9999>];
    potion_count: i32[range<0, 20>];
    slots: [Item; 4];
}

struct Player {
    position: Vec2;
    stats: Stats;
    inventory: Inventory;
}

struct Room {
    id: i32;
    label: String;
    danger: i32[range<0, 100>];
}

struct MoveResult {
    position: Vec2;
    entered_combat: bool;
}

machine main {
    contains game: Game;
    contains console: Console;

    owns return_code: i32 = 0;

    fn entry() -> i32 {
        console.write_line("Omega Scratch Dungeon");
        game.run();
        return_code = 0;

        -> shutdown()
    }

    state shutdown() -> i32 {
        -> return_code
    }
}

machine Game {
    contains world: World;
    contains combat: CombatSystem;
    contains ui: Ui;

    owns mode: GameMode = GameMode::Title;
    owns player: Player;
    owns current_room: Room;

    fn run() {
        setup_default_player(&mut player);
        world.load_start_room(&mut current_room);
        ui.show_title();

        -> title_loop()
    }

    state title_loop() {
        mode = GameMode::Exploring;

        -> exploring()
    }

    state exploring() {
        turn_result: MoveResult;
        chosen_direction: Direction = ui.ask_direction();

        turn_result = world.try_move(player.position, chosen_direction);
        player.position = turn_result.position;
        world.lookup_room(player.position, &mut current_room);

        -> enter_combat() when turn_result.entered_combat
        -> describe_room()
    }

    state describe_room() {
        ui.describe_room(current_room);

        -> exploring()
    }

    state enter_combat() {
        mode = GameMode::Combat;

        -> combat_round()
    }

    state combat_round() {
        survived: bool = combat.fight_rat(&mut player);

        -> game_over() when !survived

        mode = GameMode::Exploring;
        -> describe_room()
    }

    state game_over() {
        mode = GameMode::GameOver;
        ui.show_game_over();

        ->
    }

    fn setup_default_player(player: &mut Player) {
        default_inventory: Inventory;
        starter_potion: Item = Item { id: 1, count: 2 };

        default_inventory.gold = 10;
        default_inventory.potion_count = 2;
        default_inventory.slots[0] = starter_potion;
        default_inventory.slots[1] = Item { id: 0, count: 0 };
        default_inventory.slots[2] = Item { id: 0, count: 0 };
        default_inventory.slots[3] = Item { id: 0, count: 0 };

        player.position = Vec2 { x: 0, y: 0 };
        player.stats = Stats { health: 100, stamina: 100 };
        player.inventory = move default_inventory;
    }
}

machine World {
    fn load_start_room(out_room: &mut Room) {
        out_room.id = 0;
        out_room.label = "Entry Hall";
        out_room.danger = 0;
    }

    fn try_move(position: Vec2, direction: Direction) -> MoveResult {
        next_position: Vec2 = position;

        -> move_north(next_position) when direction == Direction::North
        -> move_south(next_position) when direction == Direction::South
        -> move_east(next_position) when direction == Direction::East
        -> move_west(next_position)
    }

    state move_north(position: Vec2) -> MoveResult {
        position.y = position.y - 1;

        -> finish_move(move position)
    }

    state move_south(position: Vec2) -> MoveResult {
        position.y = position.y + 1;

        -> finish_move(move position)
    }

    state move_east(position: Vec2) -> MoveResult {
        position.x = position.x + 1;

        -> finish_move(move position)
    }

    state move_west(position: Vec2) -> MoveResult {
        position.x = position.x - 1;

        -> finish_move(move position)
    }

    state finish_move(position: Vec2) -> MoveResult {
        combat_tile: bool = position.x == 1 && position.y == 0;

        -> MoveResult {
            position: position,
            entered_combat: combat_tile,
        }
    }

    fn lookup_room(position: Vec2, out_room: &mut Room) {
        -> write_rat_room(out_room) when position.x == 1 && position.y == 0
        -> write_empty_room(out_room)
    }

    state write_rat_room(out_room: &mut Room) {
        out_room.id = 1;
        out_room.label = "Rat Nest";
        out_room.danger = 40;

        ->
    }

    state write_empty_room(out_room: &mut Room) {
        out_room.id = 2;
        out_room.label = "Quiet Hall";
        out_room.danger = 5;

        ->
    }
}

machine CombatSystem {
    fn fight_rat(player: &mut Player) -> bool {
        scratch_damage: i32 = damage_roll(7, 3);

        player.stats.health = saturating_sub(player.stats.health, scratch_damage);

        -> defeated() when player.stats.health == 0
        -> survived()
    }

    fn damage_roll(base: i32, variance: i32) -> i32 {
        raw: i32 = base + variance;
        clamped: i32 = clamp(raw, 0, 100);

        -> clamped
    }

    fn clamp(value: i32, min: i32, max: i32) -> i32 {
        -> clamp_low(min) when value < min
        -> clamp_high(max) when value > max

        -> value
    }

    state clamp_low(min: i32) -> i32 {
        -> min
    }

    state clamp_high(max: i32) -> i32 {
        -> max
    }

    state defeated() -> bool {
        -> false
    }

    state survived() -> bool {
        -> true
    }
}

machine Ui {
    contains console: Console;

    fn show_title() {
        console.write_line("A very small dungeon, currently made of language questions.");
    }

    fn ask_direction() -> Direction {
        command_line: ConsoleLine;

        console.write("> ");
        console.read_line(&mut command_line);

        -> north() when command_line.text == "north"
        -> south() when command_line.text == "south"
        -> east() when command_line.text == "east"
        -> west()
    }

    state north() -> Direction {
        -> Direction::North
    }

    state south() -> Direction {
        -> Direction::South
    }

    state east() -> Direction {
        -> Direction::East
    }

    state west() -> Direction {
        -> Direction::West
    }

    fn describe_room(room: Room) {
        line: ConsoleLine;

        line.text = "You enter " + room.label;
        console.write_line(line.text);
    }

    fn show_game_over() {
        console.write_line("You died.");
    }
}

foreign machine Console {
    fn write(text: String);
    fn write_line(text: String);
    fn read_line(out_line: &mut ConsoleLine);
}

struct ConsoleLine {
    text: String;
}
