use omega::language::core::ProcessExit;
// Complete valid-source control. A local fixed array is borrowed as a slice
// on a state edge. The source checker admits this ordinary view presentation;
// native lowering must form the slice descriptor rather than reject the loan.
// Expected exit: 0.
// Expected output contains: 3456
use omega_language_std::Console;

data Main { }
machine main(main: &mut Main) reaches ProcessExit + Console {
    let bytes: [u8; 4] = [51, 52, 53, 54];
    transition true {
        true -> emit(&bytes)
        false -> failed()
    }
    machine emit(bytes: &[u8]) {
        Console::write_line(bytes);
        ProcessExit::exit_process(0);
    }
    machine failed() { ProcessExit::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
