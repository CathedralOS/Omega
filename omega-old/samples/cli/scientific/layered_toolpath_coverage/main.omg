use omega::language::core::ProcessExit;
// EOF oracle for the generic sample harness. Supplied valid fixtures exit 0.
// Expected exit: 64.
// Expected output contains: ERROR input
use domain::model;
use domain::model::Job;
use domain::input;
use domain::input::load;
use domain::paths;
use domain::paths::paths;
use domain::report;
use domain::report::audit;
use omega_language_std::Console;
data Main { }
machine main(main: &mut Main) reaches ProcessExit + Console {
    let mut job: Job;
    let valid: bool = block load(&mut job);
    transition valid {
        true -> generate(main, &mut job)
        _ -> invalid(main)
    }
    machine generate(main: &mut Main, job: &mut Job) {
        let complete: bool = paths(job);
        transition complete {
            true -> success(main, job)
            _ -> internal(main)
        }
    }
    machine success(main: &mut Main, job: &Job) {
        audit(job);
        ProcessExit::exit_process(0);
    }
    machine invalid(main: &mut Main) {
        Console::write_line("ERROR input");
        ProcessExit::exit_process(64);
    }
    machine internal(main: &mut Main) {
        Console::write_line("ERROR internal bounds");
        ProcessExit::exit_process(70);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    block main(&mut entry_storage);
}
