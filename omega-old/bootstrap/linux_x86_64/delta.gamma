; Existing edges extend the counted zipper. An absent edge leaves its parent
; focused so a successful provision can prepend exactly one fresh child.
(def identity_cursor_descend
  ((focus Int) (depth Int) (ancestors Int) (start Int) (end Int)) Int
  (if (eq (first focus) 0)
    (identity_cursor depth start focus ancestors)
    (let index Int (+ start depth)
      (if (eq index end)
        (identity_cursor depth start focus ancestors)
        (let child Int (name_trie_child focus (source_read index))
          (if (first child)
            (identity_cursor_descend child (+ depth 1)
              (pair focus ancestors) start end)
            (identity_cursor depth start focus ancestors)))))))
; Phase outcomes preserve owned failures; no emitter runs before full checking.
; The bound support members are validated before any Delta-source phase so
; a missing or corrupt section refuses atomically with its own DCOUT space.
(def compile_admitted_source ((profile Int)) Int
  (let support Int (validate_support_members)
    (if (eq (first support) 0)
      (let prepared Int (prepare_admitted_source profile)
        (if (eq (first prepared) 0)
          (let normalized Int (normalize_program (second prepared))
            (publish_checked_program profile normalized))
          prepared))
      support)))

(def prepare_admitted_source ((profile Int)) Int
  (let envelope Int (validate_source_envelope 0)
    (if (eq (first envelope) 0)
      (let tokens Int (validate_source_tokens 0)
        (if (eq (first tokens) 0)
          (let syntax Int (parse_source_syntax)
            (if (eq (first syntax) 0)
              (prepare_parsed_source profile (second syntax))
              syntax))
          tokens))
      envelope)))

(def prepare_parsed_source ((profile Int) (parsed Int)) Int
  (let grammar Int (validate_program_syntax (first parsed) (second parsed))
    (if (eq (first grammar) 0)
      (let collected Int (collect_global_identities (second grammar))
        (if (eq (first collected) 0)
          (prepare_collected_source profile (second grammar) (second collected))
          collected))
      grammar)))

(def prepare_collected_source
  ((profile Int) (program Int) (collected Int)) Int
  (let resolution Int
    (resolve_collected_declarations program collected)
    (if (eq (first resolution) 0)
      (let ((checked Int (second resolution))
            (bodies Int (check_program_types program checked)))
        (if (eq (first bodies) 0)
          (let schema Int (validate_application_profile profile checked)
            (if (eq (first schema) 0)
              (lower_program program checked)
              schema))
          bodies))
      resolution)))

(def publish_checked_program ((profile Int) (program Int)) Int
  ; Both entries own the final LF: canonical main writes Complete's byte;
  ; the development transformer returns it through Gamma's scalar convention.
  (let requested Int (emit_advance (emit_checked_program profile program 0) 1)
    (if (lt requested 0)
      (compiler_emission_metadata_contradiction)
      (if (lt 16777212 requested)
        (compiler_failure 2 2 12 16777212 16777212 requested)
        (let published Int (+ (emit_checked_program profile program 1) 1)
          (if (eq published requested)
            (compiler_complete 10)
            (fail)))))))

(def emit_checked_program ((profile Int) (program Int) (publish Int)) Int
  ; Members 0 (byte runtime), 1 (conformance runtime), and 2 (adapter) are
  ; the bound support closure members in manifest order. The byte runtime
  ; is admitted for every profile-one program and for scalar programs whose
  ; source uses a Bytes builtin.
  (let ((marker Int (if (eq profile 0) 0 (emit_application_marker publish 0)))
        (runtime Int (if (if (eq profile 1) 1 (source_uses_bytes_builtin 0))
            (emit_support_member 0 publish marker)
            marker))
        (profile_runtime Int (if (eq profile 1)
            (emit_support_member 1 publish runtime)
            runtime)))
    (emit_program program publish profile_runtime)))
; Bodies lower left to right. Reversed rows retain (pair declaration-tag body),
; so finishing can construct the original right-nested authored-order if chain.
(def lowering_match_arms
  ((context Int) (remaining Int) (arms Int) (locals Int) (total Int)
   (reversed Int) (depth Int) (frames Int) (globals Int)) Int
  (if (eq remaining 0)
    (let chain Int
      (lowering_match_chain (- total 1) (second reversed)
        (first (second context)) (second (first reversed)))
      (lowering_resume (lowering_match_wrap context chain) depth frames globals))
    (let ((arm Int (first arms))
          (pattern Int (syntax_child arm 0))
          (constructor Int (lowering_match_constructor pattern))
          (metadata Int (require_constructor_metadata
              (syntax_start constructor) (syntax_after constructor) globals))
          (arity Int (constructor_metadata_arity metadata))
          (bound Int (lowering_match_bindings arity
              (if (eq arity 0) 0 (second (syntax_children pattern)))
              locals (first (second (second context))))))
      (lowering_visit (syntax_child arm 1) (first bound) (+ depth 1)
        (lowering_frame 6
          (pair
            (lowering_match_state context (- remaining 1)
              (second arms) locals total reversed)
            (pair (constructor_metadata_tag metadata)
              (pair arity (second bound)))) frames)
        globals))))

; State is context, remaining arm count/spine, outer locals, total, reversed.
; Kind 6 payload is (pair state (pair tag (pair binder-count reversed-bindings))).
(def lowering_match_state
  ((context Int) (remaining Int) (arms Int) (locals Int) (total Int)
   (reversed Int)) Int
  (pair context (pair remaining (pair arms (pair locals (pair total reversed))))))

(def lowering_match_arm_done
  ((value Int) (payload Int) (depth Int) (frames Int) (globals Int)) Int
  (let ((state Int (first payload))
        (tag_and_bindings Int (second payload))
        (bindings Int (second tag_and_bindings))
        (body Int (lowering_match_wrap_bindings (first bindings) (second bindings) value))
        (remaining Int (second state))
        (arms Int (second remaining))
        (locals Int (second arms))
        (accumulated Int (second locals)))
    (lowering_match_arms (first state) (first remaining)
      (first arms) (first locals) (first accumulated)
      (pair (pair (first tag_and_bindings) body) (second accumulated))
      depth frames globals)))

(def lowering_match_chain
  ((remaining Int) (reversed Int) (tag Int) (body Int)) Int
  (if (eq remaining 0)
    body
    (let arm Int (first reversed)
      (lowering_match_chain (- remaining 1) (second reversed) tag
        (gamma_if (gamma_eq tag (gamma_integer (- (first arm) 1)))
          (second arm) body)))))
; A name cursor is (pair focus (pair depth (pair source-start ancestors))).
; Focus uses the ordinary name trie. Each counted ancestor is an existing
; complete parent trie, including its tag, followed by older ancestors.
; The source prefix identifies the edges from the root to this focus exactly.
(def identity_cursor
  ((depth Int) (source Int) (focus Int) (ancestors Int)) Int
  (pair focus (pair depth (pair source ancestors))))

(def empty_identity_cursor () Int
  (identity_cursor 0 0 (empty_name_trie) 0))

(def identity_cursor_depth ((cursor Int)) Int
  (first (second cursor)))

(def identity_cursor_source ((cursor Int)) Int
  (first (second (second cursor))))

(def identity_cursor_focus ((cursor Int)) Int
  (first cursor))

(def identity_cursor_ancestors ((cursor Int)) Int
  (second (second (second cursor))))

; Seek stops at the complete name or the parent of its first absent edge.
; Prefix presence is not terminal presence, including shorter/longer names.
(def identity_cursor_present ((cursor Int) (end Int)) Int
  (if (eq (+ (identity_cursor_source cursor) (identity_cursor_depth cursor)) end)
    (let focus Int (identity_cursor_focus cursor)
      (if (first focus)
        (first (name_trie_terminal focus))
        0))
    0))

; A completed builder materializes a root for ordinary name lookup.
; Existing immutable cursor snapshots remain independently finishable.
(def identity_cursor_finish ((cursor Int)) Int
  (name_trie_rebuild (identity_cursor_focus cursor)
    (+ (identity_cursor_source cursor) (identity_cursor_depth cursor))
    (identity_cursor_depth cursor) (identity_cursor_ancestors cursor)))
; D30/D33: complete header, first wrong header byte, profile, provision, body.
; Complete admission is (pair 0 profile); all other results are failure values.
(def request_u32 ((index Int)) Int
  (+ (read index)
    (+ (* (read (+ index 1)) 256)
      (+ (* (read (+ index 2)) 65536)
        (* (read (+ index 3)) 16777216)))))

(def request_header_difference ((index Int) (packed Int)) Int
  (if (eq index 8)
    8
    (if (eq (read index) (% packed 256))
      (request_header_difference (+ index 1) (/ packed 256))
      index)))

(def request_malformed ((coordinate Int)) Int
  (compiler_failure 1 4 1 coordinate 0 0))

(def request_unknown_profile () Int
  (compiler_failure 1 4 2 8 0 0))

(def request_source_incomplete ((requested Int)) Int
  (compiler_failure 2 4 1 12 4194304 requested))

; The sealed input is the DCREQ request followed by the bound support
; section (bootstrap/3_delta/support/support.gamma.sources packed bytes).
; A body shorter than its declared extent is malformed inside the request;
; a missing or short support section is space 5; bytes after the complete
; frame are malformed at the first trailing offset.
(def request_admit_body ((length Int) (profile Int)) Int
  (let ((body_end Int (+ 16 length))
        (expected Int (+ (+ 16 length) (support_packed_extent))))
    (if (lt (input) body_end)
      (request_malformed (input))
      (if (lt expected (input))
        (request_malformed expected)
        (if (lt (input) expected)
          (support_section_incomplete)
          (pair 0 profile))))))

(def request_admit_profile () Int
  (let profile Int (request_u32 8)
    (if (eq profile 1)
      (let length Int (request_u32 12)
        (if (lt 4194304 length)
          (request_source_incomplete length)
          (request_admit_body length profile)))
      (request_unknown_profile))))

(def validate_compilation_request () Int
  (if (lt (input) 16)
    (request_malformed (input))
    ; Little-endian bytes D C R E Q 01 00 00.
    (let difference Int (request_header_difference 0 1448566997828)
      (if (eq difference 8)
        (request_admit_profile)
        (request_malformed difference)))))
; Entry existence is an option, not a declaration-collection requirement.
; Only an accepted ordinary frontend reaches this profile-specific phase.
(def find_main_metadata ((globals Int)) Int
  ; Little-endian bytes m a i n.
  (name_trie_find_packed_option (global_functions globals) 4 1852399981))

(def reject_entry_schema ((metadata Int)) Int
  (let ((declaration Int (- (function_metadata_owner metadata) 1))
        (name Int (skip (form_head_end declaration))))
    (compiler_source_rejection 20 name)))

(def validate_conformance_profile ((metadata Int)) Int
  (if (eq (function_metadata_arity metadata) 1)
    (if (eq (function_metadata_result_type metadata) (bytes_type))
      (if (eq (first (function_metadata_parameter_types metadata)) (bytes_type))
        (compiler_complete 0)
        (reject_entry_schema metadata))
      (reject_entry_schema metadata))
    (reject_entry_schema metadata)))

(def validate_application_profile ((profile Int) (globals Int)) Int
  (let entry Int (find_main_metadata globals)
    (if (eq (first entry) 0)
      (compiler_failure 1 0 19 0 0 0)
      (if (eq profile 0)
        (compiler_complete 0)
        (if (eq profile 1)
          (validate_conformance_profile (second entry))
          (fail))))))
; Subject and arm bodies use the shared lowering machine. The result is the
; complete expanded Gamma match, with one shared atom per generated binding.
(def lowering_match
  ((node Int) (locals Int) (depth Int) (frames Int) (globals Int)) Int
  (lowering_visit (syntax_child node 1) locals (+ depth 1)
    (lowering_frame 5 (pair node locals) frames) globals))

; Kind 5 payload is (pair match-node outer-locals).
(def lowering_match_subject_done
  ((value Int) (payload Int) (depth Int) (frames Int) (globals Int)) Int
  (let ((node Int (first payload))
        (constructor Int (lowering_match_constructor (syntax_child (syntax_child node 2) 0)))
        (metadata Int (require_constructor_metadata
            (syntax_start constructor) (syntax_after constructor) globals))
        (context Int (lowering_match_context value (syntax_start node)
            (type_metadata_has_payload (constructor_metadata_type metadata))))
        (count Int (- (syntax_count node) 2)))
    (lowering_match_arms context count
      (second (second (syntax_children node))) (second payload)
      count 0 depth frames globals)))

(def lowering_match_constructor ((pattern Int)) Int
  (if (eq (syntax_count pattern) -1) pattern (syntax_child pattern 0)))

; Context is subject, tag atom, payload atom, complete-value atom, payload flag.
; Unused payload atoms are zero only for an all-nullary nominal representation.
(def lowering_match_context
  ((subject Int) (coordinate Int) (has_payload Int)) Int
  (pair subject
    (pair (gamma_generated 109 coordinate)
      (pair (if has_payload (gamma_generated 112 coordinate) 0)
        (pair (if has_payload (gamma_generated 118 coordinate) 0) has_payload)))))

(def lowering_match_wrap ((context Int) (body Int)) Int
  (let ((bindings Int (second context))
        (payload_and_value Int (second bindings))
        (complete Int (second payload_and_value)))
    (if (second complete)
      (gamma_let (first complete) (first context)
        (gamma_let (first bindings) (gamma_first (first complete))
          (gamma_let (first payload_and_value)
            (gamma_second (first complete)) body)))
      (gamma_let (first bindings) (first context) body))))
