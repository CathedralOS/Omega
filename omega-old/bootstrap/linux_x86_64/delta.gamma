(def $application () Int 1)

; Canonical DCREQ entry. Admission precedes every Delta-source observation.
(def main () Int
  (let admission Int (validate_compilation_request)
    (if (eq (first admission) 0)
      (let compilation Int (compile_admitted_source (second admission))
        (if (eq (first compilation) 0)
          (let published Int (write (second compilation))
            (pair 0 1))
          (publish_compiler_failure compilation)))
      (publish_compiler_failure admission))))

(def source_length () Int
  ; Exact-end admission established this immutable body extent: the sealed
  ; input ends with the bound support section after the declared source.
  (- (input) (+ 16 (support_packed_extent))))

(def source_read ((index Int)) Int
  (read (+ 16 index)))

(def compilation_profile () Int 1)
; The existing exact-name trie retains already-established source binding atoms.
; This phase recovers binding custody for the Gamma plan; it does not validate
; names/types or choose among conflicting declarations after static checking.
(def lowering_bind ((locals Int) (binding Int)) Int
  (let declaration Int (gamma_payload binding)
    (name_trie_insert locals (syntax_after declaration) (syntax_start declaration) binding)))

(def lowering_local ((node Int) (locals Int)) Int
  (let found Int (name_trie_find_option locals (syntax_after node) (syntax_start node))
    (if (first found) (second found) (fail))))

(def lowering_let
  ((node Int) (locals Int) (depth Int) (frames Int) (globals Int)) Int
  (let binder Int (gamma_binding (syntax_child node 1))
    (lowering_visit (syntax_child node 3) locals (+ depth 1)
      (lowering_frame 2
        (pair binder (pair (syntax_child node 4) (lowering_bind locals binder)))
        frames) globals)))

(def lowering_initializer_done
  ((value Int) (payload Int) (depth Int) (frames Int) (globals Int)) Int
  (lowering_visit (first (second payload)) (second (second payload)) (+ depth 1)
    (lowering_frame 3 (pair (first payload) value) frames) globals))

(def lowering_let_done
  ((value Int) (payload Int) (depth Int) (frames Int) (globals Int)) Int
  (lowering_resume (gamma_let (first payload) (second payload) value)
    depth frames globals))
; Byte literals are source data, never identifier spellings or executable forms.
; A closing quote belongs to the token; delimiters inside the literal are bytes.
; Zero reports a malformed/unclosed token because every successful end is positive.
(def byte_literal_escape_marker ((byte Int)) Int (eq byte 92))

; The small escape alphabet serves readable compiler source templates. Unknown
; escapes and raw control bytes are refused rather than silently normalized.
(def byte_literal_escape_value ((byte Int)) Int
  (if (eq byte 'n') 10
    (if (eq byte 'r') 13
      (if (eq byte 't') 9
        (if (eq byte '"') '"'
          (if (byte_literal_escape_marker byte) 92 -1))))))

(def byte_literal_scan ((index Int)) Int
  (if (eq index (source_length)) 0
    (let byte Int (source_read index)
      (if (eq byte '"') (+ index 1)
        (if (byte_literal_escape_marker byte)
          (if (lt (+ index 1) (source_length))
            (if (lt (byte_literal_escape_value (source_read (+ index 1))) 0)
              0
              (byte_literal_scan (+ index 2)))
            0)
          (if (lt byte 32) 0 (byte_literal_scan (+ index 1))))))))

(def byte_literal_boundary ((after Int)) Int
  (if (eq after (source_length)) 1
    (let byte Int (source_read after)
      (if (is_space byte) 1
        (if (eq byte '(') 1
          (if (eq byte ')') 1 (eq byte ';')))))))

(def byte_literal_valid ((start Int) (after Int)) Int
  (let end Int (byte_literal_scan (+ start 1))
    (if end
      (if (eq end after) (byte_literal_boundary after) 0)
      0)))
; The caller has sought this exact name, proved absence, and admitted its row.
; Prefix ancestors remain deferred. A new edge prepends; an existing endpoint
; receives only its absent terminal, preserving all children and payload types.
; Commit changes only focus, sharing the unchanged depth/source/ancestor tail.
(def identity_cursor_commit ((cursor Int) (end Int) (payload Int)) Int
  (let ((depth Int (identity_cursor_depth cursor))
        (start Int (identity_cursor_source cursor))
        (focus Int (identity_cursor_focus cursor))
        (index Int (+ start depth))
        (updated Int (if (eq (first focus) 0)
            (name_trie_new_path end index payload focus)
            (if (eq index end)
              (if (first (name_trie_terminal focus))
                (fail)
                (name_trie_with_terminal focus payload))
              (name_trie_with_child focus (source_read index)
                (name_trie_new_path end (+ index 1) payload
                  (empty_name_children)))))))
    (pair updated (second cursor))))

; Resolution updates an existing admitted identity, never inserts a new row.
; Preserve child edges and every earlier immutable root. The caller retains
; the original catalog for declaration custody checks throughout resolution.
(def identity_cursor_replace ((cursor Int) (end Int) (payload Int)) Int
  (if (identity_cursor_present cursor end)
    (pair (name_trie_with_terminal (identity_cursor_focus cursor) payload)
      (second cursor))
    (fail)))
(def grammar_arm ((node Int) (depth Int) (count Int) (work Int) (used Int)) Int
  (let shape Int (grammar_exact_count node 2)
    (if (eq shape -1)
      (let ((children Int (syntax_children node))
            (pattern Int (first children))
            (pattern_count Int (syntax_count pattern)))
        (if (eq pattern_count -1)
          (grammar_arm_after_name pattern (first (second children))
            depth count work used)
          (if (eq pattern_count 1)
            (grammar_arm_after_name (syntax_child pattern 0)
              (first (second children)) depth count work used)
            (let requested Int (syntax_storage_requested used 4)
              (if (syntax_storage_fits requested)
                (grammar_pattern pattern (+ count 1)
                  (grammar_pending 1 (+ depth 1) 1 (second children) work)
                  requested)
                (syntax_storage_refusal (syntax_start node) requested))))))
      (compiler_source_rejection 4 shape))))

; A binder-free pattern has one complete atom-role judgment, so its body can
; follow directly. The ordinary expression dispatcher still enforces depth.
(def grammar_arm_after_name
  ((name Int) (body Int) (depth Int) (count Int) (work Int) (used Int)) Int
  (let error Int (grammar_atom_role_error 3 name)
    (if (eq error -1)
      (grammar_check_role 1 body (+ depth 1) count work used)
      (compiler_source_rejection 4 error))))

; Nullary spelling and parenthesized payload spelling retain their authored
; shape. Constructor identity, binder conflicts, and payload arity are later.
(def grammar_pattern ((node Int) (count Int) (work Int) (used Int)) Int
  (if (eq (syntax_count node) -1)
    (grammar_atom_role 3 node count work used)
    (let shape Int (grammar_minimum_count node 1)
      (if (eq shape -1)
        (let children Int (syntax_children node)
          (if (eq (syntax_count node) 1)
            (grammar_atom_role 3 (first children) count work used)
            (let requested Int (syntax_storage_requested used 4)
              (if (syntax_storage_fits requested)
                (grammar_atom_role 3 (first children) (+ count 1)
                  (grammar_pending 2 0 (- (syntax_count node) 1)
                    (second children) work) requested)
                (syntax_storage_refusal (syntax_start node) requested)))))
        (compiler_source_rejection 4 shape)))))
; The initializer and body remain in their original positions. Capture analysis
; separately respects the binder's absence from its own initializer.
(def normalization_initializer_done
  ((value Int) (payload Int) (depth Int) (frames Int) (state Int)) Int
  (let pending Int (second payload)
    (normalization_visit (first pending) (second pending) (+ depth 1)
      (normalization_frame 3 (pair (first payload) value) frames) state)))
; Height is Gamma expression-list height, independent of this work stack.
; Fitting nodes retain their exact structure. Oversized fragments at budget1
; become calls with atom arguments; helper bodies restart at the profile255.
(def normalization_frame ((kind Int) (payload Int) (previous Int)) Int
  (pair kind (pair payload previous)))

(def normalization_visit
  ((node Int) (budget Int) (depth Int) (frames Int) (state Int)) Int
  (if (lt budget (gamma_height node))
    (if (eq budget 1)
      (normalization_extract node depth frames state)
      (let payload Int (gamma_payload node)
        (if (eq (gamma_kind node) 7)
          (normalization_arguments (first payload) (first (second payload))
            (first (second payload)) (second (second payload)) 0
            (- budget 1) depth frames state)
          (if (eq (gamma_kind node) 8)
            (normalization_visit (first (second payload)) (- budget 1) (+ depth 1)
              (normalization_frame 2
                (pair (first payload) (pair (second (second payload)) (- budget 1)))
                frames) state)
            (fail)))))
    (normalization_resume node depth frames state)))

; 1 remaining arguments, 2 let body, 3 completed let initializer, 4 helper.
; Resume pops exactly once, then forwards the decreased depth and prior stack.
(def normalization_resume
  ((value Int) (depth Int) (frames Int) (state Int)) Int
  (if (eq depth 0)
    (pair value state)
    (let ((kind Int (first frames))
          (retained Int (second frames))
          (payload Int (first retained))
          (previous Int (second retained))
          (next_depth Int (- depth 1)))
      (if (eq kind 1)
        (normalization_argument_done value payload next_depth previous state)
        (if (eq kind 2)
          (normalization_initializer_done value payload next_depth previous state)
          (if (eq kind 3)
            (normalization_resume
              (gamma_let (first payload) (second payload) value)
              next_depth previous state)
            (if (eq kind 4)
              (normalization_helper_done value payload next_depth previous state)
              (fail))))))))
; Existing checker and emitter callers consume this scalar custody lookup.
; Missing retained constructor rows are not an authored declaration-type error.
(def require_constructor_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (let found Int
    (name_trie_find_option (global_constructors globals) name_end name)
    (if (first found) (second found) (fail))))

(def resolve_collected_data
  ((form Int) (globals Int) (resolved_constructor_rows Int)) Int
  (let ((name Int (syntax_child form 1))
        (found Int (name_trie_find_option (global_types globals)
            (syntax_after name) (syntax_start name))))
    (if (first found)
      (let metadata Int (second found)
        (if (eq (type_metadata_owner metadata) (+ (syntax_start form) 1))
          (if (eq (type_metadata_constructor_count metadata)
                  (- (syntax_count form) 2))
            (resolve_collected_constructors
              (- (syntax_count form) 2)
              (syntax_drop_children (syntax_children form) 2)
              metadata globals 1 resolved_constructor_rows)
            (fail))
          (fail)))
      (fail))))

(def resolve_constructor_fields
  ((remaining Int) (fields Int) (type_rows Int) (reversed_types Int)) Int
  (if (eq remaining 0)
    (compiler_complete reversed_types)
    (let resolved Int (resolve_declaration_type (first fields) type_rows)
      (if (eq (first resolved) 0)
        (resolve_constructor_fields
          (- remaining 1) (second fields) type_rows
          (parameter_types_prepend (second resolved) reversed_types))
        resolved))))

; Owner, tag, payload count, and name boundary are retained custody assertions.
; Constructors and their payload annotations resolve in declaration order.
(def resolve_collected_constructors
  ((remaining Int) (constructors Int) (type_metadata Int)
   (globals Int) (tag Int) (resolved_constructor_rows Int)) Int
  (if (eq remaining 0)
    (compiler_complete resolved_constructor_rows)
    (let ((constructor Int (first constructors))
          (name Int (syntax_child constructor 0))
          (metadata Int (require_constructor_metadata
              (syntax_start name) (syntax_after name) globals)))
      (if (eq (constructor_metadata_owner metadata)
              (type_metadata_owner type_metadata))
        (if (eq (constructor_metadata_tag metadata) tag)
          (if (eq (constructor_metadata_declaration_end metadata)
                  (syntax_after name))
            (if (eq (constructor_metadata_arity metadata)
                    (- (syntax_count constructor) 1))
              (if (eq (constructor_metadata_arity metadata) 0)
                ; The checked raw row already has the final empty type spine.
                (resolve_collected_constructors
                  (- remaining 1) (second constructors)
                  type_metadata globals (+ tag 1) resolved_constructor_rows)
                (let checked Int
                  (resolve_constructor_fields
                    (- (syntax_count constructor) 1)
                    (syntax_drop_children (syntax_children constructor) 1)
                    (global_types globals) (empty_parameter_types))
                  (if (eq (first checked) 0)
                    (let ((field_types Int (reverse_parameter_types (second checked)
                              (constructor_metadata_arity metadata)
                              (empty_parameter_types)))
                          (resolved Int (pair type_metadata
                              (pair tag
                                (pair (constructor_metadata_arity metadata)
                                  (pair (syntax_after name) field_types))))))
                      (resolve_collected_constructors
                        (- remaining 1) (second constructors)
                        type_metadata globals (+ tag 1)
                        (identity_cursor_replace
                          (identity_cursor_seek resolved_constructor_rows
                            (syntax_start name) (syntax_after name))
                          (syntax_after name) resolved)))
                    checked)))
              (fail))
            (fail))
          (fail))
        (fail)))))
; Lexical admission has completed. This parser retains only balanced forms and
; exact token spans; declaration and expression grammar belong to later phases.
(def parse_source_syntax () Int
  (parse_syntax_nodes 0 0 0 0 0 0))

; Each explicit stack frame is
; (pair open (pair parent-count (pair parent-reversed previous-stack))).
; Depth and counts govern every projection. Nesting consumes immutable storage,
; not Gamma return contexts. Used counts cumulative syntax bytes, including
; superseded spines and popped frames; it is never restored with parent scope.
(def parse_syntax_nodes
  ((index Int) (depth Int) (count Int) (reversed Int) (stack Int)
   (used Int)) Int
  (let start Int (skip index)
    (if (eq start (source_length))
      (if (eq depth 0)
        (parse_syntax_finish count reversed used start)
        (compiler_source_rejection 4 start))
      (let ((byte Int (source_read start))
            (after Int (token_end start)))
        (if (eq byte 40)
          (let requested Int (syntax_storage_requested used 3)
            (if (syntax_storage_fits requested)
              (parse_syntax_nodes after (+ depth 1) 0 0
                (pair start (pair count (pair reversed stack))) requested)
              (syntax_storage_refusal start requested)))
          (if (eq byte 41)
            (if (eq depth 0)
              (compiler_source_rejection 4 start)
              (parse_syntax_close after depth count reversed stack used))
            (let requested Int (syntax_storage_requested used 4)
              (if (syntax_storage_fits requested)
                (parse_syntax_nodes after depth (+ count 1)
                  (pair (syntax_node start after -1 0) reversed) stack requested)
                (syntax_storage_refusal start requested)))))))))

(def parse_syntax_close
  ((after Int) (depth Int) (count Int) (reversed Int) (stack Int)
   (used Int)) Int
  (let requested Int (syntax_storage_requested used (+ count 4))
    (if (syntax_storage_fits requested)
      (let ((parent Int (second stack))
            (retained Int (second parent))
            (node Int (syntax_node (first stack) after count
                (syntax_reverse_nodes count reversed 0))))
        (parse_syntax_nodes after (- depth 1) (+ (first parent) 1)
          (pair node (first retained)) (second retained) requested))
      (syntax_storage_refusal (first stack) requested))))

; Ordered top-level spine and program root are syntax; the returned private
; (program, used) custody pair is a phase carrier, consumed before census.
(def parse_syntax_finish
  ((count Int) (reversed Int) (used Int) (coordinate Int)) Int
  (let requested Int (syntax_storage_requested used (+ count 1))
    (if (syntax_storage_fits requested)
      (compiler_complete
        (pair (pair count (syntax_reverse_nodes count reversed 0)) requested))
      (syntax_storage_refusal coordinate requested))))
(def empty_name_trie () Int
  (pair 0 0))

(def empty_name_children () Int
  (pair 0 0))

; A child row is (pair byte (pair child rest)). The outer option keeps empty
; distinct from a pair reference without using pair provenance in a condition.
; Empty children and an absent trie share the same immutable absence carrier.
(def name_child ((children Int) (byte Int)) Int
  (if (eq (first children) 0)
    children
    (let ((row Int (second children))
          (child_and_rest Int (second row)))
      (if (eq (first row) byte)
        (first child_and_rest)
        (name_child (second child_and_rest) byte)))))

(def name_children_prepend
  ((children Int) (byte Int) (child Int)) Int
  (pair 1 (pair byte (pair child children))))

; Replacing an edge prepends its fresh row rather than copying every younger
; sibling over the retained row. Exact-byte lookup stops at the first matching
; row, so an earlier row for the same byte is unreachable in this version and
; in every older immutable snapshot that shares it. Callers replace only an
; existing edge; absence remains a contradiction, proved by the same scan.
(def name_children_replace
  ((children Int) (byte Int) (child Int)) Int
  (if (first (name_child children byte))
    (name_children_prepend children byte child)
    (fail)))

; Trie tags: 0 is absent; 1 carries terminal option and child rows; byte+2
; carries one child directly and has no terminal. Long unbranched names need
; one pair per byte, including when immutable ancestors are rebuilt.
(def name_trie_terminal ((trie Int)) Int
  (if (lt 1 (first trie)) (pair 0 0) (first (second trie))))

; Expand a unary node only when inserting a terminal or a different edge.
(def name_trie_children ((trie Int)) Int
  (if (lt 1 (first trie))
    (name_children_prepend (empty_name_children) (- (first trie) 2) (second trie))
    (second (second trie))))

(def name_trie_child ((trie Int) (byte Int)) Int
  (if (lt 1 (first trie))
    (if (eq (- (first trie) 2) byte) (second trie) (pair 0 0))
    (name_child (second (second trie)) byte)))

(def name_trie_with_terminal ((trie Int) (payload Int)) Int
  (pair 1 (pair (pair 1 payload) (name_trie_children trie))))

(def name_trie_with_child ((trie Int) (byte Int) (child Int)) Int
  (pair 1 (pair (name_trie_terminal trie)
    (name_children_prepend (name_trie_children trie) byte child))))

(def name_trie_replace_child ((trie Int) (byte Int) (child Int)) Int
  (if (lt 1 (first trie))
    (if (eq (- (first trie) 2) byte) (pair (first trie) child) (fail))
    (let node Int (second trie)
      (pair 1 (pair (first node)
        (name_children_replace (second node) byte child))))))

(def name_trie_new_path
  ((end Int) (index Int) (payload Int) (empty Int)) Int
  (name_trie_build_path index end
    (pair 1 (pair (pair 1 payload) empty))))

; Build a fresh suffix from its terminal backward without one Gamma return
; context or temporary frame per name byte.
(def name_trie_build_path
  ((start Int) (end Int) (child Int)) Int
  (if (eq start end)
    child
    (let index Int (- end 1)
      (name_trie_build_path start index
        (pair (+ (source_read index) 2) child)))))

(def name_trie_insert
  ((trie Int) (end Int) (index Int) (payload Int)) Int
  (name_trie_descend trie end index payload 0 0))

; Ancestors are a counted spine of (pair trie previous), containing only
; existing-edge parents. First missing edges are prepended before rebuilding;
; every saved ancestor therefore replaces an existing edge in its old position.
(def name_trie_descend
  ((trie Int) (end Int) (index Int) (payload Int)
   (depth Int) (ancestors Int)) Int
  (if (eq (first trie) 0)
    (let inserted Int (name_trie_new_path end index payload trie)
      (name_trie_rebuild inserted index depth ancestors))
    (if (eq index end)
      (if (first (name_trie_terminal trie))
        (fail)
        (name_trie_rebuild (name_trie_with_terminal trie payload)
          index depth ancestors))
      (let ((byte Int (source_read index))
            (child Int (name_trie_child trie byte)))
        (if (first child)
          (name_trie_descend child end (+ index 1) payload
            (+ depth 1) (pair trie ancestors))
          (let inserted Int
            (name_trie_new_path end (+ index 1) payload child)
            (name_trie_rebuild (name_trie_with_child trie byte inserted)
              index depth ancestors)))))))

(def name_trie_rebuild
  ((child Int) (index Int) (depth Int) (ancestors Int)) Int
  (if (eq depth 0)
    child
    (let ((parent Int (first ancestors))
          (previous_index Int (- index 1)))
      (name_trie_rebuild
        (name_trie_replace_child parent (source_read previous_index) child)
        previous_index (- depth 1) (second ancestors)))))

(def name_trie_find_option ((trie Int) (end Int) (index Int)) Int
  (if (eq (first trie) 0)
    trie
    (if (eq index end)
      (name_trie_terminal trie)
      (name_trie_find_option
        (name_trie_child trie (source_read index))
        end (+ index 1)))))

; Fixed compiler-owned names use the same byte edges and terminal option as
; source spans. The explicit length preserves exact-name, not prefix, lookup.
(def name_trie_find_packed_option
  ((trie Int) (remaining Int) (packed Int)) Int
  (if (eq (first trie) 0)
    (pair 0 0)
    (if (eq remaining 0)
      (name_trie_terminal trie)
      (name_trie_find_packed_option
        (name_trie_child trie (% packed 256))
        (- remaining 1) (/ packed 256)))))

; Type metadata is (pair owner (pair constructor-count has-payload)).
; Constructor metadata is
; (pair type-metadata
;   (pair tag-plus-one (pair arity (pair declaration-end field-types)))).
; Raw census rows have field-types 0. Resolved rows carry an ordered type spine
; governed by arity, so applications and patterns never rescan annotations.
(def type_metadata_owner ((metadata Int)) Int
  (first metadata))

(def type_metadata_constructor_count ((metadata Int)) Int
  (first (second metadata)))

(def type_metadata_has_payload ((metadata Int)) Int
  (second (second metadata)))

(def constructor_metadata_type ((metadata Int)) Int
  (first metadata))

(def constructor_metadata_owner ((metadata Int)) Int
  (type_metadata_owner (constructor_metadata_type metadata)))

(def constructor_metadata_tag ((metadata Int)) Int
  (first (second metadata)))

(def constructor_metadata_arity ((metadata Int)) Int
  (first (second (second metadata))))

(def constructor_metadata_declaration_end ((metadata Int)) Int
  (first (second (second (second metadata)))))

(def constructor_metadata_field_types ((metadata Int)) Int
  (second (second (second (second metadata)))))

(def global_types ((globals Int)) Int
  (first globals))

(def global_constructors ((globals Int)) Int
  (first (second globals)))

(def global_functions ((globals Int)) Int
  (second (second globals)))

; Parameter types form a raw right-nested pair list. Cached arity governs every
; traversal, so no condition or comparison observes the pair reference.
; Function metadata is
; (pair owner (pair arity (pair result-type
;   (pair parameter-types (pair parameter-locals body-start))))).
(def empty_parameter_types () Int
  0)

(def parameter_types_prepend ((type Int) (rest Int)) Int
  (pair type rest))

(def reverse_parameter_types
  ((input Int) (remaining Int) (output Int)) Int
  (if (eq remaining 0)
    output
    (reverse_parameter_types
      (second input) (- remaining 1)
      (parameter_types_prepend (first input) output))))

(def function_metadata_owner ((metadata Int)) Int
  (first metadata))

(def function_metadata_arity ((metadata Int)) Int
  (first (second metadata)))

(def function_metadata_result_type ((metadata Int)) Int
  (first (second (second metadata))))

(def function_metadata_parameter_types ((metadata Int)) Int
  (first (second (second (second metadata)))))

; The complete parameter environment retains its active count beside its trie.
(def function_metadata_parameter_locals ((metadata Int)) Int
  (first (second (second (second (second metadata))))))

(def function_metadata_body_start ((metadata Int)) Int
  (second (second (second (second (second metadata))))))

(def find_function_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (name_trie_find_option (global_functions globals) name_end name))

(def require_function_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (let found Int (find_function_metadata name name_end globals)
    (if (first found) (second found) (fail))))
; Bound support-member custody. Every sealed compiler input ends with the
; exact packed bytes of bootstrap/3_delta/support/support.gamma.sources:
; the byte-rope runtime, the ConformanceBytesV1 runtime, and the generated
; main adapter, concatenated in manifest order. The table below binds each
; member's extent, frame offset, and byte sum so that only the audited
; closure selects program meaning; no host path or filename is consulted.
; Admission proves the section is present; compile_admitted_source checks
; each member's contents before any Delta source observation.

; Support-member indexes match the manifest's packed order.
(def support_member_count () Int 3)

(def support_packed_extent () Int 2998)

(def support_member_extent ((member Int)) Int
  (if (eq member 0)
    1464
    (if (eq member 1)
      1071
      463)))

(def support_member_offset ((member Int)) Int
  (if (eq member 0)
    0
    (if (eq member 1)
      1464
      2535)))

; Byte sums accumulate (h * 257 + byte) with wrapping 64-bit words, seeded
; at zero over each member's exact extent.
(def support_member_sum ((member Int)) Int
  (if (eq member 0)
    2838127974949508143
    (if (eq member 1)
      12190257483807601720
      17850154272413477696)))

; The support section occupies the sealed input's final packed extent.
; Coordinates in space 5 are absolute sealed-input offsets like space 4.
(def support_frame_start () Int
  (- (input) (support_packed_extent)))

; DCOUT space 5 (support section): code 1 reports an input that ends
; before the bound frame is complete; code 2 reports a member whose byte
; sum disagrees with the bound table at the member's absolute offset.
(def support_section_incomplete () Int
  (compiler_failure 1 5 1 (input) 0 0))

(def support_member_failure ((coordinate Int)) Int
  (compiler_failure 1 5 2 coordinate 0 0))

(def support_sum_region ((index Int) (remaining Int) (hash Int)) Int
  (if (eq remaining 0)
    hash
    (support_sum_region (+ index 1) (- remaining 1)
      (+ (* hash 257) (read index)))))

