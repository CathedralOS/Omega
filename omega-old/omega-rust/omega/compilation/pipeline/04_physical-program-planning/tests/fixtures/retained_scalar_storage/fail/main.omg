// The declared bound permits an index outside the two-element storage.
// Expected: operation-safety proof rejection.
data Cell { value: i64; }
machine select(cells: &mut [Cell; 2], index: u64) -> i64
requires index < 3
{
    cells[index].value = 4294967339;
    cells[index].value
}
machine main() crashes Trap {
