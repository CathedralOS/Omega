data Windows<'buffer> { observed: &'buffer [u32]; }
machine pick(windows: &Windows) -> u32 {
    transition windows.observed.len >= 1 { true -> windows.observed[1] _ -> 0 }
}
machine main() crashes Trap {
    let numbers: [u32; 1] = [11u32];
    let windows: Windows = Windows { observed: &numbers[..] };
    let value: u32 = pick(&windows);
    transition value == 11 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
