machine build(builder: &mut Build) {
    Build::application(builder, "qualified_boundary_input");
    Build::select_provider<ByteCount, CountBytes>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<ByteCount, CountBytes>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<ByteCount, CountBytes>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<ByteCount, CountBytes>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
