// Inclusive f64 0.0 <= value <= 0.25 entails admit's 0.0 <= value <= 0.5.
// Reject: Reading no longer guarantees the upper bound needed by admit.
data Reading [copy] requires value >= 0.0 { value: f64; }
machine admit(value: f64) -> f64
requires value >= 0.0 && value <= 0.5
{ value }
machine probe(reading: Reading) -> f64
requires true
{
    let value: f64 = reading.value;
    admit(value)
}
machine main() crashes Trap {
    let low: Reading = Reading { value: 0.125 };
    let high: Reading = Reading { value: 0.25 };
    transition probe(low) == 0.125 && probe(high) == 0.25 { true -> done() _ -> bad() }
    machine done() { }
    machine bad() { crash Trap; }
}
