// The source argument fixes the trailing type without changing the selected callback.
machine picked(value: u64) -> u64 {
    transition value == 7u64 { true -> 42u64 false -> 99u64 }
}

machine other(value: u64) -> u64 { value }

machine apply<const Callback: machine(value: u64) -> u64, Kind>(value: u64, marker: Kind) -> u64 {
    Callback(value)
}

const EXPECTED: u64 = apply<picked>(7u64, true);

machine main() crashes Trap {
    let marker: bool = false;
    let explicit: u64 = apply<picked, bool>(7u64, marker);
    let inferred: u64 = apply<picked>(7u64, marker);
    let different: u64 = apply<other>(7u64, marker);
    transition EXPECTED == 42u64 && explicit == 42u64 && inferred == 42u64 && different == 7u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
