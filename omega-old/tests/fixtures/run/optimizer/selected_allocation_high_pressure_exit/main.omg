// Expected exit: 0
// Twenty-two values are live at once, more than allocation has registers,
// so allocation must spill some of them.
machine main() crashes Trap {
    let seed: u64 in Wrapping = 0u64 as u64 in Wrapping;
    let v1: u64 in Wrapping = seed + 1;
    let v2: u64 in Wrapping = v1 + 1;
    let v3: u64 in Wrapping = v2 + 1;
    let v4: u64 in Wrapping = v3 + 1;
    let v5: u64 in Wrapping = v4 + 1;
    let v6: u64 in Wrapping = v5 + 1;
    let v7: u64 in Wrapping = v6 + 1;
    let v8: u64 in Wrapping = v7 + 1;
    let v9: u64 in Wrapping = v8 + 1;
    let v10: u64 in Wrapping = v9 + 1;
    let v11: u64 in Wrapping = v10 + 1;
    let v12: u64 in Wrapping = v11 + 1;
    let v13: u64 in Wrapping = v12 + 1;
    let v14: u64 in Wrapping = v13 + 1;
    let v15: u64 in Wrapping = v14 + 1;
    let v16: u64 in Wrapping = v15 + 1;
    let v17: u64 in Wrapping = v16 + 1;
    let v18: u64 in Wrapping = v17 + 1;
    let v19: u64 in Wrapping = v18 + 1;
    let v20: u64 in Wrapping = v19 + 1;
    let v21: u64 in Wrapping = v20 + 1;
    let v22: u64 in Wrapping = v21 + 1;
    let total: u64 in Wrapping = v22 + v21 + v20 + v19 + v18 + v17 + v16 + v15 + v14 + v13 + v12 + v11 + v10 + v9 + v8 + v7 + v6 + v5 + v4 + v3 + v2 + v1 + 0;
    transition total == 253 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
