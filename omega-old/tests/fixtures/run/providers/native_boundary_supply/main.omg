// Expected exit: 0.
// The native and Psi processes may have different IDs; both must receive
// a positive ID from the exact boundary binding.
boundary trait HostProcessId {
    machine get() -> i32 reaches none crashes none;
}
machine main() {
    let process: i32 = HostProcessId::get();
    transition process > 0 {
        true -> done()
        false -> failed()
    }
    machine done() { }
    machine failed() { crash Trap; }
}
