// Expected exit: 0.
// `reflect::inspect_record_fields<Reading, note>` calls `note` once per field
// of `Reading`, in declared order, at that field's type: `note<u64>` for
// `value`, then `note<bool>` for `flag`. So `first_seen` records the call at
// position 0 and `last` ends at 1, the position of `flag`. `note` admits only
// the two field types; that restricts its applications, not its inputs, so the
// published callback binder is still met. The fail twin
// `fail/reflection/inspect_record_fields_input_precondition` differs only in
// a precondition on `note`'s inputs.
use omega::language::core::reflect;
data Reading { value: u64; flag: bool; }
data Notes { last: u64; first_seen: bool; }
machine note<Kind>(notes: &mut Notes, field: &reflect::FieldInfo)
requires Kind == u64 || Kind == bool
{
    notes.first_seen = notes.first_seen || field.declaration_position == 0u64;
    notes.last = field.declaration_position;
}
machine described() -> bool {
    let mut notes: Notes;
    notes.last = 7u64;
    notes.first_seen = false;
    reflect::inspect_record_fields<Reading, note>(&mut notes);
    notes.first_seen && notes.last == 1u64
}
machine main() crashes Trap {
    transition described() { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
