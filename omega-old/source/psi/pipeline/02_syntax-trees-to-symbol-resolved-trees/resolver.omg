// Resolve one complete source set. This file owns pass order and the first
// rejection. Each step below calls the machine that owns its part of the IR.
// declaration_names.omg checks namespace collisions; type_reference_owners.omg
// supplies the lexical scope for each type in a declaration or a body.
// type_names.omg binds its name using generic_scopes.omg. machine_signatures.omg
// checks overload signatures; overloads.omg publishes visible candidates
// after body, fact and clause names have been bound.
public data Resolver {
    output: NameResolution;
    // Name-resolution scratch: what each expression's position lets it name.
    name_roles: [NameRole; 131072];
    overload_heads: [OverloadLinks; 10240];
}

public machine resolver_initialize(resolver: &mut Resolver) {
    name_resolution_clear(&mut resolver.output, SourceId { value: 0 });
}

public machine resolve(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    name_resolution_clear(&mut resolver.output, SourceId { value: 0 });
    place_machines(resolver, syntax);
    check_declaration_forms(resolver, syntax);
    transition resolver.output.accepted {
        true -> imports(resolver, sources, syntax)
        _ -> done()
    }

    machine imports(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        check_imports(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> declarations(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine declarations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        declare_roots(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> members(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine members(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        check_members(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> measures(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine measures(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        check_measures(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> declaration_generics(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine declaration_generics(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        check_declaration_namespaces(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> contracts(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine contracts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_machine_contracts(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> identities(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine identities(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        check_stable_identities(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> domain_carriers(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine domain_carriers(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_domain_carriers(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> domains(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine domains(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        check_domains(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> references(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> declaration_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine declaration_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_declaration_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> machine_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine machine_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_machine_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> body_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine body_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_body_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> machines(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine machines(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        check_machines(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> operators(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine operators(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_operator_homes(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> domain_paths(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine domain_paths(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_domain_paths(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> names(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_body_names(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> facts(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine facts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_fact_names(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> clauses(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine clauses(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_clause_names(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> publish(resolver, sources, syntax)
            _ -> done()
        }
    }

    machine publish(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        bind_visible_overloads(resolver, sources, syntax);
        resolver.output.binding_count = syntax.type_reference_count;
        resolver.output.value_binding_count = syntax.expression_count;
        resolver.output.path_binding_count = syntax.name_path_count;
        resolver.output.requirement_count = syntax.clause_count;
    }

    machine done() {}
}
