{
  "permissions": {
    "allow": [
      "Bash(mbx build:*)",
      "Bash(mbx check:*)",
      "Bash(mbx clippy:*)",
      "Bash(mbx fetch:*)",
      "Bash(mbx nextest:*)",
      "Bash(mbx run -p omega:*)",
      "Bash(mbx test:*)",
      "Bash(mbx --version)",
      "Bash(mbx doctor)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fetch:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo test:*)",
      "Bash(python3 tools/doctor.py:*)",
      "Bash(python3 tools/check_rules.py:*)",
      "Bash(python3 tools/fmt.py:*)",
      "Bash(python3 tools/corpus_gate.py:*)",
      "Bash(python3 tools/sample_native_gate.py:*)",
      "Bash(python3 tools/test_affected.py:*)",
      "Bash(bash tools/warm_build.sh restore:*)",
      "Bash(bash tools/agent_setup.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/tools/warm_build.sh session-start",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
